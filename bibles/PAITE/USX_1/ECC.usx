<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ECC" style="id">Eklisiasti</book>
  <para style="h">Eklisiasti</para>
  <para style="toc1">Eklisiasti</para>
  <para style="toc2">Eklisiasti</para>
  <para style="mt">Eklisiasti</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thugenpa, David tapa, Jerusalem kumpipa thute.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bangmah loute bangmahlou, bangmah loute bangmahlou, bangteng bangmahlou ahi, Thugenpa’n a chi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A sepgimna tengteng ni nuai a a sepgim a kipan mihing in bang phattuamna a nei a?
  </para>
  <para style="p">
    <verse number="4" style="v" />Khang khat a pai a, khang dang a hongtung a; tangtawn in lei a om gige.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ni leng a suakzel a, ni a tum zel; huchi in a suahna a mun lam ah a kiknawn pah hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Simlam ah huih a pai a, mallam ah a kilehhei a; a lampi ah a kivialhei gige, huan huih a lam zuih ah a kiknawn zel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Luite tengteng tuipi ah a luanglut ua, himahleh tuipi a dim tuankei hi: luite paina mun lam ah, huailam ah a pai nawn uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thil tengteng gimna in a dim a; mihing in a gen theikei: muh in mit a lungkim kei a, zak in bil leng a lungkim sam kei.
  </para>
  <para style="p">
    <verse number="9" style="v" />A omkhinsa a hongom ding ahi a; hihkhitsa hih a om ding ahi a; huchi in ni nuai ah thil thak a omkei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />En dih, hiai a thak? chi a mite’n a gen uh thil a om hia? I ma ua hunte ua a om khinsa ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khang masate theihgigena a omkei a; a nung a hongom dingte lak ah hongom ding khang nanung lam theihgigena leng a omsam kei ding.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei Thugenpa Jerusalem ah Israel tung ah kumpipa ka hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Van nuai a hih a omte tengteng tungtang pilna a zong ding leh zongkhe ding a ka lungtang suah ka hi: huai a kisuk ding a mite tapate kiang a Pathian in a piak nakpitak a gimna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ni nuai a hih a om nasepte tengteng ka muta a; ngai in, bangteng bangmahlou ahi a, huih nungdelh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A kawisa bawl tang theih ahi kei: huan a kimlou sim theih ahi kei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keimah lungtang ka houlimpih a, Ngai in, Jerusalem a ka ma a omte tengteng sang in pilna thupi k’on muhsak a; ahi, ka lungtang in pilna a neita, chi in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in pilna thei ding leh, haina haitatna thei ding in ka lungtang ka suk a: hiai leng huih nungdelh ahi chih ka thei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pil mahmahna ah lungkham mahmahna a om a: kuapeuh theihna khangsak in lungkhamna a khangsak hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka lungtang in, “Kisa in, vualnopna in k’on entel dia; huaiziak in nopbawlna ah bual in” ngai in, hiai leng bangmahlou ahi, ka chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nuihzatna thu ah, “Haina ahi”: vualnopna thu ah, “Bang a hih a?” ka chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A damsung ua mite tapate’n a hih ding uh bang ahia hoih ka muhtheih matan, ka lungtang in pilna kei honpi kawm in, uain a ka sa kipahsakdan leh, haina let chinten dan ka lungtang in ka zong hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nasepna thupi ka bawl a; innte ka kilam a;
  </para>
  <para style="p">
    <verse number="5" style="v" />Grephuante ka kibawla; huante leh gamsitte ka kibawla, huaite ah thei chichih ka suan hi:
  </para>
  <para style="p">
    <verse number="6" style="v" />Gammang singte khoinate hihkawt ding in, tui lite ka kibawl hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pasal sikhate leh numei sikhate ka lei a, ka inn sung ah sikhate a piang ua; belamhon leh bawnghon ka hau a, Jerusalem a ka ma a omte tengteng sang in:
  </para>
  <para style="p">
    <verse number="8" style="v" />Dangka leh dangkaeng leng, bialte a kipan leh kumpipate a kipan gou lamdang ka kilakkhawm a: pasal lasamite leh numei lasamite, mite tapa kipahna, a tam a tam meite ka kineih hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Jerusalem a ka ma a om tengteng sang in ka thupi in, ka pung zaw a: ka pilna leng ka kiang ah a om gige hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan, bangpeuh ka mit in a lunggulh amau ka it kei hi: nuamsakna himhim a kipan in ka lungtang ka len kei, ka sepgimnate tengteng ziak in ka lungtang lah a kipak ngal a; huan hiai tuh ka sepgimna tengteng a kipan ka tantuan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in ka khutte’n a bawl uh nasep tengteng ka vel a, semgim a ka hih nasep gimna tengteng: huan, ngai in, bangteng bangmahlou leh huih nungdelh ahi a, ni nuai ah bangmah phattuamna a omkei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan pilna leh lungsim kimlouhna leh haina en ding in ka kihei a: kumpipa nung a hongpai mihing in bang hihthei ding ahia? A kihih khinsa mahmah leng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in, khovak in khomial a khen dandan in, pilna in haina a kheng ahi chih ka muta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi pil mitte a lutang ah a om, mihai khomial ah a vak hi: huchi hinapi in lah thu khat mi tengteng kiang ah a tung a;
  </para>
  <para style="p">
    <verse number="15" style="v" />Huailai in ka lungtang in, “Mihaite kiang a a hongom bang in, huchibang in kei kiang ah leng a hongom ding; ahihleh bangding a kei pilzaw ka hia?” ka chi hi. Huan, ka lungtang in hiai mah leng bangmahlou ahi, ka chita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi pil, mihai bangmah a, theihgigena lah tangtawn in a om ngal kei a: tunung chiang in avek ua mangngilh khit ahi ding uh chih thei in. Huan bangchi a mihai bang a mi pil si ahia?
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in hinna ka hua a; ni nuai a bawl thilhih kei ading a a haksat ziak in: bangteng lah bangmahlou leh huih nungdelh ahi ngal a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan, ni nuai a ka sepgim ka sepgimna tengteng ka hua a: ka nung a hongom ding mi kiang a ka nutsiat ngei ding ahi chih thei in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kuan ahia mi pil hia ahihkeileh mihai a hong hih ding thei? Ka sepgimna tengteng a ka sepgimna tung ah thu a nei ding a, ni nuai a pilna ka etsakna ah. Hiai leng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaiziak in ni nuai a sepgimna tengteng ka na bawltak tungtang thu a ka lungtang lungdong sak ding in ka kipumhei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi a sepgimna pilna leh, theihna leh, kivakna toh om lah a om ngal a: himahleh huai a semgim lou mi kiang ah a tantuan ding a nutsiah in a om ding hi. Hiai leng bangmahlou leh gilou lianpi ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ni nuai a a sepgimna tengteng a kipan leh, a lungtang a a kisukna tengteng a kipan mihing in bang a nei a leh?
  </para>
  <para style="p">
    <verse number="23" style="v" />A nite tengteng ahi lungkhamna lel ahi ngal a, a thuakna dahna; ahi, zan nangawn in a lungtang a khawl kei hi. Hiai leng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing ading a a nek a a dawn a, a sepgimna a thil hoih a a kha a bualsak val a hoihzaw bangmah a omkei hi. Hiai leng ka thei a, Pathian khut a kipan om ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kei sang in, kuan ahia ne thei a, ahihkeileh kuan ahia nuamsakna nei zaw?
  </para>
  <para style="p">
    <verse number="26" style="v" />Amah hih lungkim mi kiang ah Pathian in pilna leh, theihna leh nuamsakna a pe ngal a: himahleh mikhial kiang ah, gimthuakna a pia hi, lakhawm ding leh khawlkhawm ding in, huchi a kuapeuh Pathian hih lungkim kiang a a piak theihna ding in, Hiai leng bangmahlou leh huih nungdelh ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bang chiteng a ding in hunbi a om, van nuai a thiltup chiteng a ding in hun:
  </para>
  <para style="p">
    <verse number="2" style="v" />Pian hun leh sih hun; suan hun leh suansa boh khiak hun:
  </para>
  <para style="p">
    <verse number="3" style="v" />Thah hun leh hihdam hun; phel hun leh lam nawn hun;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kah hun leh nuih hun; sun hun leh lam hun;
  </para>
  <para style="p">
    <verse number="5" style="v" />Suangte paihmang hun leh suangte lak khawm hun; kawi hun leh kawi kidek hun;
  </para>
  <para style="p">
    <verse number="6" style="v" />Zon hun leh mansuah hun; vom hun leh paihmang hun;
  </para>
  <para style="p">
    <verse number="7" style="v" />Bohkek hun leh khui hun; pau louh hun leh thugen hun;
  </para>
  <para style="p">
    <verse number="8" style="v" />It hun leh muhdah hun; kidou hun leh kilep hun.
  </para>
  <para style="p">
    <verse number="9" style="v" />A sepgimna na sempan bang phattuamna a nei a?
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai a kisawizoina ding a Pathian in mite tapate kiang a a piak haksatna ka muta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thil chiteng a hun a kilawm in a bawl a: a lungtang uah khovel leng a koihta a, hinapi in mihing in Pathian nasep a bul a kipan a a tawppha a hihsa a mukhe theikei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A damsung teng un kipah leh hoih hih sang a amau adia hoihzaw bangmah a omkei chih ka thei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Michih in a nek a a dawn a, a sepgimna tengteng a hoih nuam a sakpih Pathian thilpiak ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bangpeuh Pathian in a hih, tangtawn in a om ding chih ka thei a: huai ah bangmah a kikoih theikei ding a, huai a kipan in bangmah mah a ki lakhe thei sam kei ding: Pathian in a hihkhinta a, huchi in a ma ah mite’n a lau ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A omkhinsa pen; a om ding a omkhinsa ahi: huan Pathian in a paimangsa a zong hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in ni nuai ah, vaihawmna mun ah, gitlouhna a om chih leng ka mu hi; huan diktatna mun ah, gitlouhna huai ah a om hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka lungtang in, Pathian in midiktat leh migilou a ngaihtuah ding: thiltup chiteng leh nasep chiteng a ding in hun a om a, ka chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka lungtang in, mite tapate ziak in ahi, Pathian in amau a ettel sin a, amau mahmah gamsa banglel a hihdan uh a kitheih theihna ding un.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mite tapate tung a tung peuhmah lah gamsate tung ah a tung ngal a; thil khat ngei a tung uah a tung a: khat a sih bang in, huchi mah bang in a dangdang a sia; ahi, hu khat a neikhawm ua: huan mihing in gamsate sang a masak zawkna a neikei: bangteng bangmahlou ahi ngal a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bangteng mun khat ah a pai ua; bangteng leivui a kipan ahi ua, bangteng leivui ah a kiknawn uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing kha tunglam a a pai touh leh, gamsa kha nuailam a lei a a paisuk kua ahia thei?
  </para>
  <para style="p">
    <verse number="22" style="v" />Huaiziak in mihing a nasepte a a kipah ding sang a hoihzaw bangmah a omkei chih ka thei hi; huai a tantuan ahi ngal a: amah nung in bang ahi dia chih mu ding in amah kuan honpi nawn ahia leh?
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in ka kihei a ni nuai a nuaisiahna hih a om tengteng ka mu a: huan ngai in, huchibang a nuaisiah a omte, lungmuanpa neiloute; huan amau nuaisiahte lam ah thilhihtheihna a om a, himahleh lungmuanpa a neikei uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huaiziak in misite a sikhinsate a damlai dam a omlaite sang in ka phat zaw:
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahi, a om ngei nailou, ni nuai a nasep gilou hih a om mu ngei nailou mi amau sang in ka ngaithupi zaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in sepgimna leh nasep siamna tengteng, hiai ziak a mihing invengte hazat a omna ka muta hi. Hiai leng bangmahlou leh huih nungdelh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihai in a bante khepkhawm in amah sa a ne hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khut dim nih sepgimna leh huih nungdelhna sang in, lungmuanna toh khut dim khat a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in ka kihei a ni nuai a bangmahlou ka mu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah kia a om khat ka mu a, nihna a neikei a; ahi, tapa a neikei, sanggampa leng a neikei; hinapi in lah a sepgim tawpna a omkei a, hauhsakna in a mitte leng a lungkim tuankei hi. “Kua adia semgim a, ka kha hoih tansak ka hia?” a chi a. Hiai leng bangmahlou ahi, ahi, nakpi a gimthuakna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khat sang in nih a hoihzaw; a sepgimna ua ding a kipahman hoih a neih ziak un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Puk le uh, khat in a lawm phong ding a hih ziak in: himahleh a puk chiang a amah kia a om a, amah phong ding midang neilou tung a gik hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huailou in, nih a lupkhawm un, lumna a thei uh: himahleh khat kia bangchi’n a lum thei dia?
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan, mi khat in amah kia a om pen zou leh, nih in amah a dou ding ua; khau zang guk a hek a kitat mengmeng kei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kumpipa tek leh hai, thuhilhna sangthei nawnlou sang in tuailai genthei leh pil a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Suangkulh a kipan a kumpipa hi ding a hong paikhia lah a hingal a; ahi, amah gam mahmah a genthei sa a piang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni nuai a vak a hing tengteng, tuailaite toh a om uh ahihleh, a nihna, a mun ah ading chih ka muta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi tengteng, a amaute tung a a omna mahmah, bei chih a omkei a: hinapi in lah tunung chia hongom dingte amah ah a kipak kei ding uh. Chihtaktak in hiai leng bangmahlou leh huih nungdelh ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian inn a na hoh chiang in na khepek kem in; ngaikhe ding a pai mihaite kithoihna piak sang in a hoihzaw ngal a: gilou a hih uh chih a kithei kei uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kamlawp kenla, Pathian ma a thil himhim gen ding in na lungtang lawptawp kei hen; Pathian lah van ah a om a, nang lah leitung ah na om ngal a: huaiziak in na thute tawmsak in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mang lah thu leh la tampi toh a hongom a; huan mihai aw thu tampi toh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian kiang a thuchiam na chiam chiang in, peding in hal ken; mihaite tung ah kipahna a nei ngal kei a: na thuchiam pen pia in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na chiam a na piaklouh sang in, na chiamlouh a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na kam in na sa thil a hihkhelh sak phal ken: angel ma ah leng, a dik kei chi sam ken: bangding in na aw ah Pathian in a heh in, na khut nasep a hihse dia?
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchibang in mangte tamna ah bangmah loute a tam thu tampite ziak in siatna hongom ngal nak a: himahleh nang zaw Pathian kihta in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gentheite nuaisiahna leh, hiamgamna in bialsung ah vaihawmna leh diktatna a lamang chih na muh leh, huai thu lamdang sa ken: thuneitu sangte’n thuneihna neite a enkai ua; huan amau tung ah a sangzaw a om hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huailou in lei a punna bangteng ading ahi: kumpipa ngei leng louma in a na a sepsak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kuapeuh dangka deihta dangka in a lungkim kei ding; kuapeuh hauhsakna punna deihta leng: hiai leng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Van a kibehlap chiang in, amau nete a khang uh; huan huai neimi ading in bang phattuamna a om a, a mitte a huaite et chih ngallouh?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ne tawm in ne tam leh, semgim mi ihmut a lim a; himahleh mihausa vahna in amah a ihmu sak kei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ni nuai a gilou hoih hetlou ka muh a om a, huai tuh, hauhsakna a neipa’n amah siatna dia a kep:
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh huai hauhsaknate thuakna gilou in a mangthang hi; tapa a suan leh, a khut ah bangmah a omkei.
  </para>
  <para style="p">
    <verse number="15" style="v" />A nu gil a kipan a hongpai leh, vuaktang in a painawn ding a hongpai bang in, a sepgimna, a khut a a puak mang theih, ading in bangmah a lakei ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan hiai leng gilou hoih hetlou ahi, a hongpai dan tengteng in, hichibang in a pai ding a: huih ading a a sepgimna ah bang punna a nei a?
  </para>
  <para style="p">
    <verse number="17" style="v" />A damsung teng in khomial ah an a ne a, huan nakpitak a hihbuai in a om a, chinatna leh thangpaihna a nei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai in, hoih leh kilawm hi a ka muh min Pathian in amah a piak a damsung teng a a nek a, a dawn a, ni nuai a a sepgimna a sepgimna tengteng a hoih nuam a sakpiha, huai ahi: hiai lah a tantuan ahi ngal a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi chiteng leng amah kiang a Pathian in hauhsakna leh neihzohna a piak, huai a nek theihna a piak a, a tantuan la ding leh a sepgimna a kipak ding in; hiai Pathian thilpiak ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A damlai nite lah a theigige kei ding a; a lungtang kipahna a Pathian in amah a dawn ziak in.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni nuai a ka muh gilou a om a, mite tung ah a gik hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi Pathian in hauhsakna leh neihzohna leh, zahna a piak a, huchi a a deihpeuh a kha adia bangmah taksap nei hetlou a, a hihhang a huai a ne ding a Pathian in thilhihtheihna a piak louh a, mikhual in a nek zawkna: hiai bangmahlou ahi a, gilou natna ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing in ta za khat suang henla, kum tampi dam in a kumte nite tampi pha leh, a kha lah hoih in dim kei ngal in, kivuina neikei ngal leh; amah ading in a hun lou a pian a hoihzaw ka chi ahi:
  </para>
  <para style="p">
    <verse number="4" style="v" />Bangmahlou lah a honghi a, khomial ah a paimang a, huai a min khomial in a khuh hi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Huailou in ni a mu kei a theih leng a theikei; hiai in a dang sang in a khawlna a nei a:
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahi, kum sang khat gentuan dam mahleh, hoih nuam a sak pih tuankei: bang teng mun khat ah a pai kei umaw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing sepgimna tengteng a kam a ding ahi a, himahleh a gilkialna a dim tuankei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihai sang in mi pil in bang phattuamna a nei a leh? Ahihkeileh, mihing ma a omdan thei, mi genthei in bang a nei a?
  </para>
  <para style="p">
    <verse number="9" style="v" />Lunggulhna tam vak sang in mitte muh a hoihzaw hi: hiai leng bangmahlou leh huih nungdelh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A na omkhinsa bangpeuh, sawtpi a huai a min piaksa ahi, huan mihing ahi chih theih ahi: amah sang a hatzaw amah toh leng a kisual theikei ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thil tampi bangmahlou pungsak a om ding chih thei in, mihing bang a hoih tuan a?
  </para>
  <para style="p">
    <verse number="12" style="v" />A damsung bangmahlou limliap bang a a sukbei tengteng, a damsung in mihing ading a hoih kuan a thei a leh? Ni nuai ah amah nung in bang a om dia chih kuan mihing a hilh thei a ahia?
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nuhtheih mantam sang in min hoih a hoihzaw; mi pianni sang in sihni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ankuangluina inn a hoh sang in, sunna inn a hoh a hoihzaw: huai mi tengteng tawpna ahi a; huan mihing in a lungtang a a ngaihtuah ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nuih sang in lungkham a hoihzaw: mel lungkhamna ah lungtang kipahsak in lah a om ngal a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi pil lungtang sunna inn ah a om; himahleh mihaite lungtang vualnopna inn ah a om hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi ading in mihaite lasak zak sang in, mi pil taina zak a hoih zaw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bel nuai a lingte puak vengvung bang in, mihai nuihna huchibang in a om ngal a: hiai leng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Simmohna in mi pil a haisak mahmah a; thilpiak in theihsiamna a susia hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A kipatna sang in thil tawpna a hoihzaw: lungsim a kisaktheih sang in lungsim a dohtheih a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Heh ding in na lungsim in man gang ken; hehna lah mihaite awm ah a khawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nidanglaite hiaite sang a a hoihzawkna a ziak bang ahia? chi ken; hiai thu lah pilhuaitakin na dong kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pilna gouluah bang in a hoih a; ahi, amau ni mute ading in a hoihzaw tham hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dangka sum kihumna ahi bang in, pilna lah kihumna ahi ngal a: himahleh theihna hoihzawkna bel, pilna in a neimi hinna a hawi sak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian nasep ngaihtuah in: aman a kawisak sa, kua ahia bawl tang thei ding leh?
  </para>
  <para style="p">
    <verse number="14" style="v" />Hauhsak ni’n nuamsa inla, huan vangtahni in ngaihtuah in: mihing in a nung a thil om ding a muhkhiak louhna ding in, Pathian in khat lah a dang kiang ah kihiang helhel in a bawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka bangmahlou ni’n hiai tengteng ka muta hi: mi diktat a diktatna a mangthang a om a, huan migilou a gilou bawlna a a hinna hihsau a om hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ki diktatsak lawzen ken; kipilsak lawzen sam ken: bangdia nang kihihse ding na hia?
  </para>
  <para style="p">
    <verse number="17" style="v" />Gilou lawzen kenla, hai sam ken: na hun tun ma a bangdia si ding na hia?
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiai na let chinten a hoih hi; ahi huai a kipan in leng na khut kai ken: kuapeuh Pathian kihta lah a mute tengteng a kipan hong paikhe ding uh ahi ngal a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khopi a om vaihawmmi sawm sang in mi pil ading in pilna a thupizaw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hoih hih a, khiallou, leitung ah mi diktatna a om mahmah kei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thu kigen tengteng leng limsak khol dah in; huchilou in zaw na sikha in nang a hon hamsiat naza kha ding hi:
  </para>
  <para style="p">
    <verse number="22" style="v" />Na lungtang in lah huchi mah bang in nang leng midangte na hamsiat munchih a thei ngal a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiai tengteng pilna in ka enchian vek a: Ka pil ding ka chi a; himahleh kei a kipan a gamla hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gamla tak a thilte leh a thuk petpet a; kuan a mu khe thei dia?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka kipumhei a, thei ding leh zongkhe ding, pilna zong ding leh, thilte ziak zong ding, gitlouhna haina ahi chih thei ding, haina lungsim kimlouhna ahi chih thei ding in ka lungtang koih kip in a om hi:
  </para>
  <para style="p">
    <verse number="26" style="v" />Sihna sang a khazaw tuh numei, a lungtang thangte leh lente hi a, a khut henna khau hi ahi chih ka muta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngai in, hiai ka mu khia, thugentu in a chi: thil a omdan tak mukhe ding in thil a khat a khat ka buk hi,
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuin leng ka zonglai a ka mu kei: pasal sang khat lak a mitang khat ka mu, himahleh numei tengteng lak ah mitang ka mu kei hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai in, Pathian in mihing hoihtak in a bawl chih, hiai kia ka mu a; himahleh bawltawm tampi a zongkhia uhi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi pil bang a om kua ahia? Huan thil hilhchetna kua ahia thei? Mihing pilna in a mai a vaksak a, a mai takna a kikheng hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />K’on thuhilh, Pathian thuchiam lam thu ah, kumpipa thupiak zui in.
  </para>
  <para style="p">
    <verse number="3" style="v" />A omna mun a kipan paikhe ding in man gang ken; thil gilou ah engtat ken: aman lah a utut a hihsek ngal a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kumpipa thu in thilhihtheihna a neih ziak in; “Bang ahia na hih?” Kuan ahia a kiang a chi thei ding?
  </para>
  <para style="p">
    <verse number="5" style="v" />Thupiak zuite’n thil gilou a theikei ding uh; huan mi pil lungtang in hun leh vaihawmna a theikhen zel:
  </para>
  <para style="p">
    <verse number="6" style="v" />Thiltup chiteng ah lah hun leh vaihawmna a om ngal a; mihing haksatna lah a tung ah a thupi ngal a:
  </para>
  <para style="p">
    <verse number="7" style="v" />A hongom ding lah a thei ngal kei a; bangchi in a om dia chih amah kuan a hilh thei dia leh?
  </para>
  <para style="p">
    <verse number="8" style="v" />Kha lentang ding in kha tung a thilhihtheihna neimi a omkei; sihna ni tung ah leng thilhihtheihna a neisam kei: Huan huai kidouna ah panna a omkei: piak a om gitlouhna in amah a hunkhe sam kei ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiai tengteng ka mu a, nasep chiteng ni nuai a hih ah ka lungtang ka pia a: a siatna ding in mi khat in midang tung a thil hihtheihna a neih louh hun a om hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan giloute vui a om ka mulai a, huan han ah a hong ua; huchi in hihdikte Mun Siangthou a kipan a paimang ua, khopi ah mangngilh in a om uhi: hiai leng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gilou nasep kintak a gawtna a kibawl louh ziak in, huaiziak in mite tapate lungtang gilou hih ding in huai ah koih kip in a om hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mikhial in gilou za vei hih in, a nite susau mahleh, Pathian kihtamite amau ading in a hoih ding chih ka thei mahmah hi, a ma a laudan siamte:
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh giloute ading in a hoih kei ding, a nite leng a sausak kei ding a, huai lah limliap bang ahi; Pathian ma a laudan a siamlouh ziak in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bangmahlou leitung a hih a om a om a; mi diktat omta bang hileh leng, amah tung a migilou nasep dungzui in a hongom nak hi; huailou in migiloute omta bang hileh leng, mi diktatte nasep dungzui in a tung uah a hongom hi: hiai leng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nek leh dawn a vualnuam a om kan a ni nuai a mihing in thil hoihzaw a neih louh ziak in, vualnopna ka phat hi: Pathian in amah ni nuai a a piak a damsung ni tengteng a a sepgimna ah amah toh a om gige ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pilna thei ding leh, leitung a hih a om thulehla mu ding a ka lungtang ka suklai in: sun hiam zan hiam a mit a ihmut muhlouh lah a om ngal a:
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Pathian thilhih tengteng ka mu a, huchi in ni nuai a thilhih mihing in a mukhe theikei hi: zong khe ding in mihing nakpitak in pang lezong, a muhlouh ding ziak in; huailou in, mi pil in thei kisa mahleh, a mukhe theikei ding hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiai tengteng ka lungtang in ka vei ngal a, hiai tengteng zongkhe ding in; midiktatte, leh mipilte leh a thilhihte uh Pathian khut ah a om ahi chih: itna ahi hia, muhdahna, mihing in a theikei; a ma uah avek in a om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil tengteng kibang in avek ua kiang ah a hongom a: mi diktatte leh migiloute tung ah tanchin khat a om hi; mi hoih kiang a leh mi siang kiang a leh mi sianglou kiang ah; kithoih mi kiang leh kithoihlou mi kiang ah: mi hoih a om bang in, mikhial a om a; a kichiampa, thuchiam kihtapa bang in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni nuai ah hih a om tengteng ah hiai gilou ahi, bangteng tung a tanchin khat om: ahi nalai a, mite tapate lungtang gilou in a dim a, a damlai uh a lungtang uah lungsim kimlouhna a om, huai nung in misite kiang ah a pai uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah hing lai tengteng toh kizom a om ding in lah lametna a om ngal a: humpinelkai sisa sang in ui hinglai lah a hoihzaw ngal a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihingte’n a si ding uh chih lah a thei ngal ua: himahleh misi in thil himhim a theikei, kipahman leng a neita kei uhi; amaute theihgigena lah a kimangngilh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A itna uh bang in, a muhdahna uleh a enna uh tuin a mangta a; ni nuai a hih a om thil himhim ah tangtawn in tantuan a nei nawnta kei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pai inla, nuamsakna toh na tanghou ne inla, lungtang kipak toh in na uain dawn in: Pathian in lah na thilhihte a sangkhinta ngal a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na puansilhte ngou gige in om hen; huan na lu in nilhtheih tasam kei hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na bangmahlou damsung ni tengteng a na it zi kiang ah kipaktak in om inla, huai aman ni nuai a a honpiak, na bangmahlou ni tengteng in: huai lah damsung in na tantuan ahi ngal a, ni nuai a na sepgimna a na sepgimna ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na khut in hih ding bangpeuh a muh na theihtawp in sem in; na paina lam han sung ah, nasep hiam, thilngaihtuah hiam, theihna hiam, pilna hiam a omlou ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka kihei a, kitaitehna kinte ading ahi kei a, galdouna hatte ading ahi tuankei chih ka mu hi, tanghou leng pilte ading, hauhsakna leng theisiam mite ading, deihsakna khutsiamte ading hi tuanlou; himahleh hun leh phat amaute tengteng tung ah a hongom zel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihing in a hun a thei kei hi: ngasate len gilou a a kiman bang leh, vasate thang a a awk uh bang in, huchibang in mite tapate, amau tung a thakhat a a hong tunguih lai in, hun gilou a mat in a om uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichibang in pilna leng ni nuai ah ka mu a, ka kiang ah thupi in a kilang hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khopi lianlou a om a, asung ah mi tawmchik; huan kumpipa thupi in a hong sim a, a la a, a douna ding in sepaih nasep thupitak a bawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in huai ah mi pil genthei khat a om, a pilna in khopi a hunkhia a; himahleh kuamah in huai migentheipa a theigige kei uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan, ken, “Hatna sang in pilna a hoihzaw; mi genthei pilna muhsit in a om a, a thute ngaihkhiak sak in a omkei ” ka chi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihaite lak a vaihawmmi kikou sang in awl a mi pil thugente a kiza zaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kidouna galvante sang in pilna a hoihzaw; himahleh mikhial khat in hoih tampi a hihsia hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thou sisa in gimlim bawlpa nuhtheihna uihgim a sawlkhe sak a: huchi mah bang in haina neu chik in pilna leh zahna a bukzou nak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi pil lungtang a khut taklam ah a om a; himahleh mihai lungtang a khut veilam ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahi, huaiban ah, lampi a mihai a vaklai in, a theihsiamna in a zuausan a, mi chiteng kiang ah hai a hihdan a gen hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vaihawmmi lungsim nang dou ding a a thoh leh, na mun taisan ken; kipiak in tatkhelhna thupite a lungkimsak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gilou ni nuai a ka muh, vaihawmmi a kipan a diklouhna hong kipan khia bang in a om hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Haina nakpi a zahtakhuai in a kibawla, mun niam ah hauhsakna a tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sikhate sakol tung a tuang leh, lalte leitung a sikhate bang a khe a pai ka mu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kuapeuh kawkhuk tou huai sung ah a ke ding; kuapeuh dai phuvang; gulpi in a kei ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kuapeuh suang hemkhia huai in a kihihna ding a; kuapeuh sing a belh huai ah lauhuai in a kibawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sik a mol a, min a ma a tat hiam kei leh, hatna tamsem a koih ding ahi: himahleh pilna thuzoh a phatuam hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khim a om ma a gulpi in a keih leh, khimmi ah phattuamna a omta kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi pil kam a thute hehpihthei in a om a; himahleh mihai mukte’n amah mah a nawmvalh ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />A kam a thute kipatna haina ahi: huan a houlimna tawpna lungsim kimlouhna gilou ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihai in leng thu a khangsak a: himahleh mihing in bang a om dia chih a theikei; huan amah nung a hongom ding, amah kuan a hilh thei dia?
  </para>
  <para style="p">
    <verse number="15" style="v" />Khopi a hohna dan a theihlouh ziak in, mihaite sepgimna in amaute lak a michih a gimsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw gam, na tung a gik hi, na kumpipa naupang a hihlai in na lalte’n zingsang in a ne uh!
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw gam, na kumpipa miliante tapa a hih a, na lalte’n, kham ding hilou a, hatna ding a a huntak a a neklai un, nuam na sa hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thadahna ziak in intung a chim a; khut zawntatna ziak in inn a keh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nuihna ding in Ankuang a kilui a, uain in hinna a kipaksak; sum thil tengteng awnghukna ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kumpipa, na ngaihtuahna in hamsiat ken, na lupna dantan sung ah mihausate hamsiat ken: huih khua a vasate’n na aw paw ding ua, kha neite’n a thu gen ding uh a hih ziak in.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuite tung ah na tanghou pai in: ni tampi nung a mukhe ding na hi ngal a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sagih kiang ah tantuan pia in, ahi, giat ngei kiang ah; leitung a bang gilou hongom ding ahia chih lah na thei ngal kei a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Meipite vuah a a dim leh, leitung ah a kihih awngthawl uh: huan simlam a sing a puk leh, hiam mallam ah, a pukna mun ah, huai ah a om ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huih ngeingaih mi in a tuh kei ding a; meipi limsakmi in a at kei ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huih lampi hiam, amah nau toh omna gil sung a guhte bang hong chi khan uh ahia chih na theihlouh bang in; bangteng hihpa Pathian thilhih na theikei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zingsang in na chi tuh inla, nitakin na khut ton maimah ken: koipen hong lohching ding ahia, hiai hia huai hia, ahihkeileh hong hoih tuaktuak ding uhia chih lah na thei ngal kei a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Diktakin khovak a nuam a, mitte adia ni muh thil nuam tak ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahi, mi kum tampi a dam a leh, huaite tengteng ah kipak hen; himahleh khomial hunte theigige hen, tampi pha ding uh lah ahi ngal a. A hongom tengteng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw tangval, na tuailai in kipak in: na tuailai nite ah na lungtang in hon kipaksak hen, na lungtang lampite ah leh, na mitte muh in om in: himahleh hiai thilte tengteng ziak in Pathian in nang vaihawmna a honpi ding ahi chih thei in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huaiziak in na lungtang a kipan lungkhamna suankhia inla, na sa a kipan gilou koihmang in: tuailaina leh khan lutlai lah bangmahlou ahi ngal a.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na tuailai nite in nang honsiampa theigige in, ni hoihloute a hongtun ua kumte a hongnai ua, Amaute ah kipahna ka neikei, na chih hun a hongtun nailouh lai in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni hiam, khovak leh, kha leh, aksite, hihmial a om a, meipite vuahzuk khit a a kiknawn ma un:
  </para>
  <para style="p">
    <verse number="3" style="v" />inn ngakte a kivuan ua, mi hatte a hong kun ua, a tawm tak ziak ua ansute a khawl ua, tawlet a dakkhete hihmial a a om ua,
  </para>
  <para style="p">
    <verse number="4" style="v" />Kong zing a kongkhakte khak a hih nailouh lai un; ansuk ging a ngaihlouh a, vasa aw a mi a thoh a, tumging theih tanute tengteng sukniam a a om nailouh lai un;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahi, tung sang a om a kihta ding ua, a lampi ah launa a om ding; vaisuaklu sing a paklun ding a, huan khaukhup tunggikna ahi dia, lingmin thuk a zuau ding; mihing a inn sau a pai a, sunmite kongzing kim a a pai ziak un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dangka khau kiphel a, dangkaeng noubem suktap a a om a, tuibel tuikhuk a hihkek a a om a, tuibem a kangtalai khe hihtan a a om nailouh lai in;
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan, a om bang in leivui lei ah a kiknawn a, kha bel a pepa Pathian kiang ah a kik hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bangmah loute bangmahlou, thugenmi’n a chi; bangteng bangmahlou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huaiban ah, Thugenpa a pil ziak in, mite theihna a sinsak lailai a; ahi, paunak tampi kizom zom in a ngaihtuah a, a zongkhia a, a koih hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thugenpa thu pomtakte mukhe ding in a zong a, diktak a gelhkhiak a omte, thutak thute ngei.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi pil thute sutna zum bang ahi a, hoihtak a khetkip sikilhnate bang tuh Belamchingpa khat thugen lakkhawm piakte ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan huailou leng, ka tapa, hilh in om in: laibu tampi bawl ahihleh tawp chih ni a omkei hi; huan zil tamna zaw sa bahna ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai thu leh la tawpna ahi; avek in zak in a omta: Pathian laudan siam inla, a thupiakte zui in; hiai lah mihing hih ding pumpi ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian in thilhih chiteng, thil selguk chiteng, a hoih hia ahihkeileh a hoihlou toh vaihawmna a la lut ding ahi.
  </para>
</usx>
