<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="3JN" style="id">၃ ယော</book>
  <para style="h">၃ ယော</para>
  <para style="toc1">၃ ယော</para>
  <para style="toc2">၃ ယော</para>
  <para style="mt">၃ ယော</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />အသက်ကြီးသူထံမှအမှန်ပင်သမ္မာတရား တော်အားဖြင့် ငါချစ်မြတ်နိုးသူဂါယုထံ သို့စာရေးလိုက်သည်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ချစ်ဆွေ၊ သင်သည်အစစအရာရာတွင် ကြီးပွားတိုးတက်၍ကျန်းမာရွှင်လန်းစေ ရန်ငါဆုတောင်း၏။ သင်၏ဝိညာဉ်ပါရမီ တိုးတက်လျက်ရှိကြောင်းငါသိ၏။-
  </para>
  <para style="p">
    <verse number="3" style="v" />သင်သည်သမ္မာတရားကိုအမြဲလိုက်နာခဲ့ သည့်အတိုင်း ယခုလည်းသစ္စာနှင့်လိုက်နာကျင့် သုံးလျက်ရှိကြောင်းကို ညီအစ်ကိုအချို့တို့ လာရောက်ပြောပြ၍ကြားရသဖြင့်ငါ သည်အလွန်ဝမ်းမြောက်၏။-
  </para>
  <para style="p">
    <verse number="4" style="v" />ငါ့အားဝမ်းအမြောက်ဆုံးဖြစ်စေသည့်အရာ မှာ သမ္မာတရားကိုငါ့သားသမီးများလိုက် နာကျင့်သုံးကြကြောင်းသတင်းကိုကြားရ ခြင်းပင်ဖြစ်သည်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ချစ်ဆွေ၊ သင်သည်မိမိမသိမကျွမ်းသူညီ အစ်ကိုများကိုပင်လျှင် သင်ပြုရမည့်ဝတ်ကို သစ္စာနှင့်ဆောင်ရွက်ပေသည်။-
  </para>
  <para style="p">
    <verse number="6" style="v" />ထိုသူတို့သည်သင်၏မေတ္တာအကြောင်းကို ဤ အသင်းတော်ရှေ့၌သက်သေခံကြလေပြီ။ သူ တို့သည်ရှေ့သို့ခရီးဆက်နိုင်ကြစေရန်သူ တို့အားဘုရားသခင်နှစ်သက်တော်မူသည့် အတိုင်းကူညီမစပါလော့။-
  </para>
  <para style="p">
    <verse number="7" style="v" />သူတို့သည်ယုံကြည်သူမဟုတ်သူများထံမှ အကူအညီကိုမယူဘဲ နာမတော်အကြောင်း ဟောပြောရန်ခရီးထွက်ကြသူများဖြစ်ပေ သည်။-
  </para>
  <para style="p">
    <verse number="8" style="v" />သို့ဖြစ်၍ငါတို့များသည်သမ္မာတရားပြန့် ပွားရေးလုပ်ငန်းတွင် ထိုသူတို့၏လုပ်ဖော် ဆောင်ဘက်များဖြစ်နိုင်ရန်သူတို့အားကူညီ မစရမည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ငါသည်အသင်းတော်သို့စာရေးခဲ့သော် လည်း အသင်းတော်၏ခေါင်းဆောင်ဖြစ်လို သူဒယောတရပ်ကငါ့စကားကိုမနာ ခံ။-
  </para>
  <para style="p">
    <verse number="10" style="v" />သို့ဖြစ်၍ငါလာသောအခါမှသူပြုသမျှ သောအမှုတို့ကိုထုတ်ဖော်ပြောဆိုမည်။ သူ သည်ငါတို့အားမလိုမုန်းထားစွပ်စွဲပြော ဆို၏။ ဤမျှနှင့်မကျေနပ်သေးဘဲသူကိုယ် တိုင်ပင်လျှင် ညီအစ်ကိုများကိုလက်မခံ၊ လက်ခံလိုသူများအားလည်းတားမြစ် လျက်အသင်းတော်မှနှင်ထုတ်ရန်ကြိုး စား၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ချစ်ဆွေ၊ စံနမူနာကောင်းကိုအတုယူပါ။ စံနမူနာဆိုးကိုအတုမယူနှင့်။ အကျင့် ကောင်းကိုပြုကျင့်သူသည်ဘုရားသခင်၏ ဘက်တော်သားဖြစ်၏။ အကျင့်ဆိုးကိုပြု ကျင့်သူကားဘုရားသခင်ကိုမသိမြင် သေးသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဒေမေတရိကို လူတိုင်းချီးမွမ်းပြောဆို ကြပေသည်။ သမ္မာတရားသည်သူ့ဘက်၌ သက်သေခံ၏။ ငါတို့သည်ထပ်လောင်း၍ ထောက်ခံ၏။ ငါတို့ထောက်ခံချက်သည် ခိုင်လုံကြောင်းသင်သိ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သင်တို့အားပြောစရာအကြောင်းအရာ များစွာရှိသော်လည်းငါသည်စာအားဖြင့် မရေးဘဲ၊-
  </para>
  <para style="p">
    <verse number="14" style="v" />ငါသည်သင့်ထံသို့မကြာမီရောက်၍သင်နှင့် မျက်နှာစုံညီတွေ့ဆုံပြောဆိုနိုင်လိမ့်မည်ဟု မျှော်လင့်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သင်၌ငြိမ်သက်ခြင်းရှိပါစေသော။ ဤအရပ်ရှိမိတ်ဆွေများကသင့်အားနှုတ် ဆက်ကြ၏။ ငါတို့၏မိတ်ဆွေတစ်ဦးစီအား နှုတ်ဆက်ပါလော့။ ရှင်ယောဟန်သြဝါဒစာတတိယစောင်ပြီး၏။
  </para>
</usx>
