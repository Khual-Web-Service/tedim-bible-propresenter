<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1JN" style="id">၁ ယော</book>
  <para style="h">၁ ယော</para>
  <para style="toc1">၁ ယော</para>
  <para style="toc2">၁ ယော</para>
  <para style="mt">၁ ယော</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />အသက်တော်တည်းဟူသောနှုတ်ကပတ်တော် အကြောင်းကိုငါတို့စာရေးလိုက်၏။ ထိုနှုတ် ကပတ်တော်သည်အစမူလကတည်းကပင် ရှိနေတော်မူခဲ့၏။ ထိုနှုတ်ကပတ်တော်ကို ငါတို့ကြားခဲ့ကြ၏။ ငါတို့ကိုယ်တိုင်မျက်စိ ဖြင့်မြင်ခဲ့ကြ၏။ ငါတို့လက်ဖြင့်စမ်းသပ် ကြည့်ရှုခဲ့ကြ၏။-
  </para>
  <para style="p">
    <verse number="2" style="v" />ထိုအသက်တော်ပေါ်လွင်ထင်ရှားခဲ့စဉ်က ငါတို့မြင်ရကြ၏။ သို့ဖြစ်၍ယင်း၏အကြောင်း ကိုငါတို့ဟောပြောကြ၏။ ခမည်းတော်နှင့် အတူရှိတော်မူခဲ့သည့်အသက်တော်သည် ငါတို့တွင်ပေါ်လွင်ထင်ရှားခဲ့သဖြင့် ငါတို့ သည်ထိုအသက်တော်အကြောင်းကိုသင်တို့ အားဖော်ပြကြေညာကြ၏။-
  </para>
  <para style="p">
    <verse number="3" style="v" />ငါတို့သည်ခမည်းတော်နှင့်လည်းကောင်း၊ ကိုယ်တော်၏သားတော်ယေရှုခရစ်နှင့်လည်း ကောင်း၊ မိတ်သဟာယဖွဲ့ရကြသည်ဖြစ်ရာ သင်တို့သည်လည်း ငါတို့နှင့်အတူထိုမိတ် သဟာယတွင်ပါဝင်ခွင့်ကိုရရှိကြစေရန် ငါတို့တွေ့မြင်ကြားသိခဲ့ရသည့်အမှု အရာကိုသင်တို့အားဖော်ပြ၏။-
  </para>
  <para style="p">
    <verse number="4" style="v" />ငါတို့သည်ရွှင်လန်းဝမ်းမြောက်မှုကိုအပြည့် အဝခံစားနိုင်ကြစေရန် ဤအကြောင်း အရာများကိုစာရေးလိုက်သည်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဘုရားသခင်သည်အလင်းဖြစ်တော်မူ၏။ ကိုယ်တော်၌အမှောင်လုံးဝမရှိဟူသော တရားစကားကို ငါတို့သည်ကိုယ်တော်၏ သားတော်ထံမှကြားသိရသဖြင့်သင်တို့ အားကြေညာ၏။-
  </para>
  <para style="p">
    <verse number="6" style="v" />သို့ဖြစ်၍ငါတို့သည်ကိုယ်တော်နှင့်မိတ်သဟာ ယဖွဲ့ရကြလေပြီဟုဆိုလျက် အမှောင်တွင် ကျင်လည်နေကြပါမူနှုတ်အားဖြင့်လည်း ကောင်း၊ အကျင့်အားဖြင့်လည်းကောင်းလိမ်လည် သူများဖြစ်ကြ၏။-
  </para>
  <para style="p">
    <verse number="7" style="v" />သို့ရာတွင်ကိုယ်တော်သည်အလင်းတွင်ရှိတော် မူသကဲ့သို့ ငါတို့သည်အလင်းတွင်ကျင်လည် ကြပါမူ အချင်းချင်းတစ်ယောက်နှင့်တစ်ယောက် မိတ်သဟာယဖွဲ့ခြင်းရှိကြ၏။ ဘုရားသခင် ၏သားတော်သခင်ယေရှု၏သွေးတော်သည် လည်းငါတို့၏အပြစ်ရှိသမျှကိုဆေးကြော စင်ကြယ်စေတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ငါတို့သည်အပြစ်သားများမဟုတ်ဟုဆို ပါမူ ငါတို့သည်မိမိတို့ကိုယ်ကိုလှည့်စား ကြ၏။ ငါတို့၌သစ္စာတရားမရှိ။-
  </para>
  <para style="p">
    <verse number="9" style="v" />သို့ရာတွင်အပြစ်ဝန်ချကြလျှင်ဘုရား သခင်သည်ကတိတည်တော်မူ၍တရားမျှတ တော်မူသောအရှင်ဖြစ်တော်မူသဖြင့် ငါတို့ ၏အြုပစ်များကိုဖြေလွှတ်၍ငါတို့အား ဒုစရိုက်အညစ်အကြေးအပေါင်းတို့နှင့် ကင်းစင်စေတော်မူလိမ့်မည်။-
  </para>
  <para style="p">
    <verse number="10" style="v" />အကယ်၍မိမိတို့သည်အပြစ်ကူးသူများ မဟုတ်ဟုငါတို့ဆိုပါမူ ဘုရားသခင်အား မုသားသုံးတော်မူသောအရှင်ဟုစွပ်စွဲပြော ဆိုရာရောက်လျက်နှုတ်ကပတ်တော်သည်ငါတို့ ၌မရှိ။
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါ၏သားသမီးတို့၊ သင်တို့သည်အပြစ် မကူးကြစေရန်ဤစာကိုငါရေးလိုက်၏။ သို့ရာတွင်အကယ်၍တစ်စုံတစ်ယောက်သော သူသည်အပြစ်ကူးမိပါမူ ခမည်းတော် ထံတွင်ငါတို့အတွက်အသနားခံသည့်ဖြောင့် မတ်တော်မူသောအရှင်ယေရှုခရစ်ရှိပေ သည်။-
  </para>
  <para style="p">
    <verse number="2" style="v" />ကိုယ်တော်သည်ငါတို့၏အပြစ်များသာမက ကမ္ဘာသူကမ္ဘာသားအပေါင်းတို့၏အြုပစ်ပြေ ရာပြေကြောင်းပူဇော်ဆက်ကပ်တော်မူသော အရှင်ဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဘုရားသခင်၏ပညတ်တော်တို့ကိုစောင့်ထိန်း မှသာလျှင်ငါတို့သည်ကိုယ်တော်ကိုသိကျွမ်း သူများဖြစ်ကြောင်းအသေအချာသိရှိ နိုင်မည်။-
  </para>
  <para style="p">
    <verse number="4" style="v" />ကိုယ်တော်ကိုသိပါသည်ဟုဆိုပြီးလျှင် ပညတ်တော်တို့ကိုမစောင့်ထိန်းသူသည် လူလိမ်ဖြစ်၍ထိုသူ၌သစ္စာတရားမရှိ။-
  </para>
  <para style="p">
    <verse number="5" style="v" />သို့ရာတွင်ကိုယ်တော်၏စကားတော်ကိုနား ထောင်သူသည် အကယ်ပင်ဘုရားသခင်၏ ချစ်ခြင်းမေတ္တာနှင့်ပြည့်ဝစုံလင်၏။ သို့မှ သာကျွန်ုပ်တို့သည်ဘုရားသခင်နှင့်တစ် လုံးတစ်ဝတည်းဖြစ်ကြောင်းသေချာသိ ပေသည်။ ဘုရားသခင်နှင့်တစ်လုံးတစ်ဝ တည်းဖြစ်ကြောင်းသေချာသိသူသည် သခင်ယေရှုခရစ်၏ခြေတော်ရာကို လိုက်လျှောက်သူဖြစ်မည်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ချစ်ဆွေတို့၊ သင်တို့ထံသို့ငါစာရေးသား ဖော်ပြနေသည့်ပညတ်သည်အသစ်မဟုတ်။ အစမူလကတည်းကသင်တို့ရရှိထား ကြသည့်ပညတ်ဟောင်းဖြစ်၏။ ထိုပညတ် ဟောင်းကား သင်တို့ကြားနာခဲ့ရသည့် တရားတော်ပင်ဖြစ်ပေသည်။-
  </para>
  <para style="p">
    <verse number="8" style="v" />သို့သော်သင်တို့အားယခုငါရေးသား ဖော်ပြသည့်ပညတ်သည်အသစ်ဖြစ်၏။ ယင်း သို့အမှန်ပင်အသစ်ဖြစ်ကြောင်းခရစ်တော် ၌လည်းကောင်း၊ သင်တို့၌လည်းကောင်းဖော်ပြ လျက်ရှိ၏။ အဘယ်ကြောင့်ဆိုသော်အမှောင် သည်ရွေ့လျားလျက်အလင်းစစ်အလင်းမှန် ပေါ်ထွန်းလာပြီဖြစ်သောကြောင့်တည်း။
  </para>
  <para style="p">
    <verse number="9" style="v" />အလင်းတွင်ကျင်လည်ပါသည်ဟုဆိုလျက် မိမိ၏ညီအစ်ကိုကိုမုန်းသောသူသည် ယခု တိုင်အောင်အမှောင်တွင်ကျင်လည်နေသေးသူ ဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="10" style="v" />ညီအစ်ကိုကိုချစ်သောသူသည်အလင်းတွင် ကျင်လည်သောသူဖြစ်၏။ သူသည်အဘယ်သို့ မျှသူတစ်ပါးတို့အားအပြစ်ကူးလွန်စေ လိမ့်မည်မဟုတ်။-
  </para>
  <para style="p">
    <verse number="11" style="v" />သို့ရာတွင်ညီအစ်ကိုကိုမုန်းသောသူသည် ကားအမှောင်တွင်ကျင်လည်သူဖြစ်၏။ အမှောင် တွင်ကျင်လည်၍မျက်စိမမြင်နိုင်သဖြင့်သူ သည်မိမိအဘယ်အရပ်သို့သွားသည်ကိုမသိ။
  </para>
  <para style="p">
    <verse number="12" style="v" />သားသမီးတို့၊ သင်တို့သည်ခရစ်တော်အတွက် ကြောင့်အပြစ်လွတ်ပြီဖြစ်၍သင်တို့ထံငါ စာရေးလိုက်၏။-
  </para>
  <para style="p">
    <verse number="13" style="v" />အဖတို့၊ သင်တို့သည်အစကပင်ရှိတော်မူ သောအရှင်ကိုသိသူများဖြစ်သောကြောင့် သင်တို့ထံသို့ငါစာရေးလိုက်၏။ လူငယ် လူရွယ်တို့၊ သင်တို့သည်မာရ်နတ်ကိုအောင် သောကြောင့်သင်တို့ထံသို့ငါစာရေးလိုက်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />သားသမီးတို့၊ သင်တို့သည်ခမည်းတော် ကိုသိသူများဖြစ်သောကြောင့်သင်တို့ထံသို့ ငါစာရေးလိုက်၏။ သင်တို့သည်အစကပင် ရှိတော်မူသောအရှင်ကိုသိသူများဖြစ် သောကြောင့် သင်တို့ထံသို့ငါစာရေးလိုက် ၏။ လူငယ်လူရွယ်တို့၊ သင်တို့သည်ခွန်အား ရှိ၍ ဘုရားသခင်၏နှုတ်ကပတ်တော်သည် သင်တို့တွင်ကိန်းအောင်းလျက်၊ မာရ်နတ်ကို အောင်သောကြောင့်သင်တို့ထံသို့ငါစာရေး လိုက်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သင်တို့သည်လောကကိုသော်လည်းကောင်း၊ လော ကီအရာများကိုသော်လည်းကောင်းမချစ်ကြ နှင့်။ လောကကိုချစ်သောသူသည်ခမည်းတော် ကိုမချစ်။-
  </para>
  <para style="p">
    <verse number="16" style="v" />ကာယတပ်မက်စွဲလန်းသောအရာများ၊ မျက်စိ ဖြင့်မြင်၍လိုချင်တပ်မက်သောအရာများ၊ ဂုဏ် ယူဝါကြွားစရာများအစရှိသောလောကီ အရာရှိသမျှတို့သည်ခမည်းတော်နှင့် မသက်ဆိုင်။ လောကနှင့်သာသက်ဆိုင်၏။-
  </para>
  <para style="p">
    <verse number="17" style="v" />လောကနှင့်တကွလူတို့တပ်မက်သောအရာ များသည်ရွေ့လျားကွယ်ပျောက်လျက်နေလေပြီ။ သို့ရာတွင်ဘုရားသခင်အလိုတော်ကိုဆောင် ရွက်သူမူကား ကာလအစဉ်အမြဲတည်လိမ့် မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />သားသမီးတို့၊ အဆုံးစွန်သောကာလသည် ယခုနီးလာလေပြီ။ ခရစ်တော်၏ရန်သူပေါ် ပေါက်လာမည်ဖြစ်ကြောင်းကိုသင်တို့ကြားသိ ခဲ့ကြ၏။ ယခုပင်လျှင်ခရစ်တော်၏ရန်သူ အများအပြားပေါ်ပေါက်လျက်ရှိလေပြီ။ ဤ အချက်ကိုထောက်၍အဆုံးစွန်သောကာလ ရောက်လာကြောင်းကိုငါတို့သိရကြ၏။-
  </para>
  <para style="p">
    <verse number="19" style="v" />ထိုသူတို့သည်အမှန်စင်စစ်အဘယ်အခါကမျှ ငါတို့မိတ်သဟာယတွင်မပါဝင်ခဲ့ကြသဖြင့် ငါတို့ထံမှထွက်ခွာသွားကြ၏။ အကယ်၍သူ တို့သည်ငါတို့မိတ်သဟာယတွင်ပါဝင်ခဲ့ပါမူ ငါတို့နှင့်အတူရှိနေကြမည်ဖြစ်၏။ သူတို့ သည်အမှန်ပင်ငါတို့မိတ်သဟာယတွင်မပါ ဝင်ကြောင်းသိသာထင်ရှားစေရန် သူတို့သည် ငါတို့ထံမှထွက်ခွာသွားကြ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />သို့ရာတွင်ခရစ်တော်သည်သင်တို့အပေါ်သန့် ရှင်းသောဝိညာဉ်တော်ကိုသွန်းလောင်းတော်မူ သည်ဖြစ်၍ သင်တို့အပေါင်းသည်သမ္မာတရား ကိုသိကြပေသည်။-
  </para>
  <para style="p">
    <verse number="21" style="v" />သင်တို့ထံငါစာရေးရခြင်းအကြောင်းမှာ သမ္မာတရားကိုသင်တို့မသိကြ၍မဟုတ်။ သမ္မာတရားကိုလည်းကောင်း၊ မုသားစကား သည် သမ္မာတရားနှင့်မည်သို့မျှမသက်ဆိုင် သည်ကိုလည်းကောင်းသင်တို့သိကြသော ကြောင့်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ထို့ကြောင့်အဘယ်သူသည်မုသားစကားကို ပြောသနည်း။ သခင်ယေရှုသည်မေရှိယ မဟုတ်ဟုပြောဆိုသူသည်မုသားစကား ကိုပြော၏။ ထိုကဲ့သို့သောသူသည်ခရစ်တော် ၏ရန်သူဖြစ်၏။ သူသည်ခမည်းတော်နှင့် သားတော်ကိုပစ်ပယ်သူဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="23" style="v" />သားတော်ကိုပစ်ပယ်သူသည်ခမည်းတော်ကို လည်းပစ်ပယ်သူဖြစ်၏။ သားတော်ကိုလက်ခံ သူသည်ခမည်းတော်ကိုလည်းလက်ခံသူ ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />သို့ဖြစ်၍သင်တို့သည်အစကပင်ကြားနာခဲ့ ကြသည့်တရားတော်ကိုမိမိတို့၏စိတ်နှလုံး တွင်ထိန်းသိမ်းထားကြလော့။ ယင်းသို့ပြုပါမူ သင်တို့သည်သားတော်နှင့်လည်းကောင်း၊ ခမည်း တော်နှင့်လည်းကောင်းထာဝစဉ်တစ်လုံးတစ်ဝ တည်းတည်ရှိကြလိမ့်မည်။-
  </para>
  <para style="p">
    <verse number="25" style="v" />ဤကားငါတို့အားခရစ်တော်ကိုယ်တော်တိုင် ကတိထားတော်မူသောထာဝရအသက် ပေတည်း။
  </para>
  <para style="p">
    <verse number="26" style="v" />သင်တို့အားမှောက်မှားလမ်းလွဲစေရန်ကြိုးစား သူတို့၏အကြောင်းနှင့်ပတ်သက်၍ ဤအကြောင်း အရာများကိုငါစာရေးလိုက်၏။-
  </para>
  <para style="p">
    <verse number="27" style="v" />သင်တို့မူကားခရစ်တော်သည်မိမိ၏ဝိညာဉ် တော်ကိုသင်တို့အပေါ်သို့သွန်းလောင်းတော်မူ ပြီ။ ဝိညာဉ်တော်သည်သင်တို့စိတ်နှလုံးတွင် ကိန်းအောင်းလျက်နေတော်မူသမျှကာလ ပတ်လုံးသင်တို့အားအခြားအဘယ်အရာမျှ သွန်သင်ပေးစရာမလို။ အဘယ်ကြောင့်ဆို သော်ကိုယ်တော်၏ဝိညာဉ်တော်သည်သင်တို့အား ခပ်သိမ်းသောအမှုအရာတို့ကိုသွန်သင်ပေး တော်မူသောကြောင့်ဖြစ်၏။ ဝိညာဉ်တော်သွန်သင် တော်မူသောအရာတို့သည်မှန်ကန်၍အမှား မရှိ။ ထို့ကြောင့်သင်တို့သည်ဝိညာဉ်တော်သွန် သင်သည့်အတိုင်းလိုက်နာဆောင်ရွက်ကြလော့။ ခရစ်တော်နှင့်တစ်လုံးတစ်ဝတည်းတည်ကြ လော့။
  </para>
  <para style="p">
    <verse number="28" style="v" />သားသမီးတို့၊ ကိုယ်တော်ကြွလာတော်မူသော နေ့၌ငါတို့သည်ရှက်ကြောက်၍ ပုန်းအောင်းနေ ကြရန်မလိုဘဲ ရှေ့တော်၌ရဲရင့်ခွင့်ရရှိစေ ခြင်းငှာ၊ ကိုယ်တော်နှင့်တစ်လုံးတစ်ဝတည်း တည်ရှိနေကြလော့။-
  </para>
  <para style="p">
    <verse number="29" style="v" />ခရစ်တော်သည်ဖြောင့်မတ်တော်မူသည်ကို သင်တို့သိကြ၏။ သို့ဖြစ်၍အမှန်တရား ကိုကျင့်သုံးသူသည်ဘုရားသခင်၏သား သမီးဖြစ်ကြောင်းကိုသင်တို့သိကြ၏။
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါတို့သည်ဘုရားသခင်၏သားသမီးများ ဟုအခေါ်ခံရကြသောအခွင့်ကိုရကြသဖြင့် ငါတို့အားခမည်းတော်ဘုရားသည်မည်မျှ ချစ်တော်မူသည်ကိုဆင်ခြင်ကြလော့။ ငါတို့ သည်အကယ်ပင်ဘုရားသခင်၏သားသမီး များဖြစ်ကြ၏။ ဤအကြောင်းကြောင့်ဤလောက သားတို့ကငါတို့ကိုမသိ။ သူတို့သည်ခမည်း တော်ကိုလည်းမသိ။-
  </para>
  <para style="p">
    <verse number="2" style="v" />ချစ်ဆွေတို့၊ ယခုအခါငါတို့သည်ဘုရား သခင်၏သားသမီးများဖြစ်ကြ၏။ သို့ရာ တွင်နောင်အခါအဘယ်သို့သောသူများဖြစ် မည်ကိုသေချာစွာမသိရကြသော်လည်း ခရစ်တော်ကြွလာတော်မူသောအခါကိုယ် တော်ဖြစ်တော်မူသည်အတိုင်းဖူးမြင်ရကြ မည်ဖြစ်၍ ငါတို့သည်ကိုယ်တော်နှင့်တူကြ မည်ကိုသိကြ၏။-
  </para>
  <para style="p">
    <verse number="3" style="v" />ခရစ်တော်ကိုအမှီပြု၍ထိုသို့မျှော်လင့် တောင့်တသူသည် ခရစ်တော်သန့်ရှင်းဖြူစင် တော်မူသကဲ့သို့မိမိကိုယ်ကိုသန့်ရှင်းဖြူ စင်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />အပြစ်ကူးခြင်းသည်ပညတ်တော်ကိုချိုး ဖောက်ခြင်းဖြစ်သဖြင့် အပြစ်ကူးသူမှန် သမျှသည်ပညတ်တော်ကိုချိုးဖောက်သူဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="5" style="v" />ခရစ်တော်သည်လူတို့၏အပြစ်များကိုဖြေလွှတ် တော်မူရန်ကြွလာတော်မူကြောင်းကိုသင်တို့သိ ကြ၏။ ကိုယ်တော်သည်အပြစ်ကင်းတော်မူသော အရှင်ဖြစ်တော်မူ၏။-
  </para>
  <para style="p">
    <verse number="6" style="v" />ကိုယ်တော်နှင့်တစ်လုံးတစ်ဝတည်းတည်နေသူ သည်အပြစ်မကူးတတ်။ အပြစ်ကူးတတ်သူ မူကားကိုယ်တော်ကိုမသိမမြင်ဘူးသူ ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />သားသမီးတို့၊ အဘယ်သူမျှသင်တို့အား မှောက်မှားလမ်းလွဲအောင်မပြုစေနှင့်။ ခရစ်တော် သည်ဖြောင့်မတ်တော်မူသကဲ့သို့ အမှန်တရားကို ကျင့်သုံးသူသည်လည်းဖြောင့်မတ်သူဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="8" style="v" />အြုပစ်တရားကိုကျင့်သုံးသူသည်မာရ်နတ် ၏ဘက်သားဖြစ်၏။ အဘယ်ကြောင့်ဆိုသော် မာရ်နတ်သည် မူလအစကတည်းကပင်လျှင် အပြစ်ကူးသူဖြစ်သောကြောင့်တည်း။ ဘုရား သခင်၏သားတော်ပေါ်ထွန်းတော်မူသည့် အကြောင်းမှာ မာရ်နတ်ပြုခဲ့သည့်အမှုကို ချေဖျက်ရန်ပင်ဖြစ်ပေသည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဘုရားသခင်၏သားသမီးဖြစ်လာသူသည် အပြစ်မကူးတတ်။ အဘယ်ကြောင့်ဆိုသော်ထို သူ၌ဘုရားသခင်၏ဇာတိသဘောပါရှိ သောကြောင့်ဖြစ်၏။ သူသည်ဘုရားသခင်၏ သားသမီးဖြစ်သဖြင့်အပြစ်ဒုစရိုက် မပြုနိုင်။-
  </para>
  <para style="p">
    <verse number="10" style="v" />ဤနည်းအားဖြင့်ဘုရားသခင်၏သားသမီး များနှင့်မာရ်နတ်၏သားသမီးကွာခြားပုံကို သိရ၏။ အမှန်တရားကိုမကျင့်သုံးသူ၊ ညီ အစ်ကိုကိုမချစ်သူသည်ဘုရားသခင်၏ သားသမီးမဟုတ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />``ငါတို့သည်အချင်းချင်းချစ်ရကြမည်'' ဟူ သောတရားတော်ကိုရှေးမဆွကပင်လျှင် သင်တို့ကြားနာခဲ့ရကြ၏။-
  </para>
  <para style="p">
    <verse number="12" style="v" />မာရ်နတ်၏ဘက်သားဖြစ်၍မိမိ၏ညီအာဗေလ ကိုသတ်သူကာဣနကဲ့သို့ ငါတို့မဖြစ်စေကြ နှင့်။ ကာဣနသည်မိမိ၏ညီကိုအဘယ်ကြောင့် သတ်သနည်း။ သူ၏အကျင့်သည်ဆိုးယုတ်၍ သူ့ ညီ၏အကျင့်မူကားဖြောင့်မှန်သောကြောင့် ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သို့ဖြစ်၍ညီအစ်ကိုတို့၊ လောကသားတို့သည် သင်တို့ကိုမုန်းကြလျှင်မအံ့သြကြနှင့်။-
  </para>
  <para style="p">
    <verse number="14" style="v" />ငါတို့သည်မိမိတို့၏ညီအစ်ကိုများကိုချစ် သည့်အတွက်ကြောင့် သေခြင်းမှအသက်ရှင်ခြင်း သို့ကူးမြောက်ခဲ့ရကြကြောင်းကိုငါတို့သိ ကြ၏။ မိမိ၏ညီအစ်ကိုကိုမချစ်သောသူ သည်သူသေဘဝ၌ပင်ရှိနေသေး၏။-
  </para>
  <para style="p">
    <verse number="15" style="v" />မိမိ၏ညီအစ်ကိုကိုမုန်းသောသူသည်သူ သတ်သမားဖြစ်၏။ သူသတ်သမားသည် ထာဝရအသက်ကိုမရကြောင်းသင်တို့ သိကြ၏။-
  </para>
  <para style="p">
    <verse number="16" style="v" />ခရစ်တော်သည်ငါတို့အတွက်အသက်တော် ကိုစွန့်တော်မူသောကြောင့်မေတ္တာအကြောင်း ကိုငါတို့သိရကြ၏။ ငါတို့သည်လည်းမိမိ တို့၏ညီအစ်ကိုများအတွက်အသက်စွန့် သင့်ကြပေသည်။-
  </para>
  <para style="p">
    <verse number="17" style="v" />လောကီစည်းစိမ်ဥစ္စာကြွယ်ဝသူဖြစ်ပါလျက် မိမိ၏ညီအစ်ကိုတစ်စုံတစ်ယောက်ချို့တဲ့မှု ကိုမြင်သောအခါ ကရုဏာစိတ်မရှိသူတွင် အဘယ်သို့လျှင်ဘုရားသခင်၏မေတ္တာတော် ကိန်းအောင်းနိုင်မည်နည်း။-
  </para>
  <para style="p">
    <verse number="18" style="v" />သားသမီးတို့၊ ငါတို့၏မေတ္တာသည်နှုတ်ဖျား ၌သာတည်သောမေတ္တာမဖြစ်သင့်။ လက်တွေ့အား ဖြင့်ဖော်ပြထားသောမေတ္တာစစ်မေတ္တာမှန်ဖြစ် ရမည်။
  </para>
  <para style="p">
    <verse number="19" style="v" />သို့ဖြစ်၍ဤနည်းအားဖြင့်ငါတို့သည်သမ္မာ တရားနှင့်ဆိုင်သူများဖြစ်ကြောင်းသိရှိနိုင် မည်။ ဘုရားသခင်၏ရှေ့တော်မှောက်တွင်လည်း စိတ်ချခွင့်ကိုရရှိကြလိမ့်မည်။-
  </para>
  <para style="p">
    <verse number="20" style="v" />မိမိတို့သြတ္တပ္ပစိတ်၏ပြစ်တင်ရှုတ်ချမှုကို ခံရသောအခါ၌လည်း ဘုရားသခင်သည် ငါတို့သြတ္တပ္ပစိတ်ထက်ကြီးမြတ်တော်မူ ကြောင်း၊ ကိုယ်တော်သည်အမှုအရာခပ်သိမ်း ကိုသိတော်မူကြောင်းငါတို့သိကြ၏။-
  </para>
  <para style="p">
    <verse number="21" style="v" />သို့ဖြစ်၍ချစ်ဆွေတို့၊ ငါတို့၏သြတ္တပ္ပစိတ် ကငါတို့အားပြစ်တင်ရှုတ်ချမှုမပြုလျှင် ငါတို့သည်ဘုရားသခင်ထံတော်၌ရဲဝံ့ ခွင့်ရရှိကြ၏။-
  </para>
  <para style="p">
    <verse number="22" style="v" />ငါတို့သည်ကိုယ်တော်၏ပညတ်တော်တို့ကို စောင့်ထိန်းသူများ၊ ကိုယ်တော်နှစ်သက်တော် မူသောအမှုတို့ကိုပြုသူများဖြစ်သဖြင့် ငါတို့တောင်းလျှောက်သမျှသောအရာတို့ ကိုအထံတော်မှရရှိကြ၏။-
  </para>
  <para style="p">
    <verse number="23" style="v" />ကိုယ်တော်၏ပညတ်တော်ဟူမူကားငါတို့ သည်ဘုရားသခင်၏သားတော်ယေရှုခရစ် ကိုယုံကြည်ရကြမည်။ ထိုအရှင်မိန့်တော်မူ သည်အတိုင်း အချင်းချင်းတစ်ယောက်ကို တစ်ယောက်ချစ်ရကြမည်ဟူ၍ဖြစ်ပေသည်။-
  </para>
  <para style="p">
    <verse number="24" style="v" />ဘုရားသခင်၏ပညတ်တော်တို့ကိုစောင့်ထိန်း သူသည် ဘုရားသခင်နှင့်တစ်လုံးတစ်ဝတည်း ဖြစ်၍ ဘုရားသခင်သည်လည်းထိုသူနှင့်တစ်လုံး တစ်ဝတည်းဖြစ်တော်မူ၏။ ယင်းသို့ဖြစ်တော်မူ ကြောင်းကို ကိုယ်တော်ပေးသနားတော်မူသော ဝိညာဉ်တော်အားဖြင့်ငါတို့သိရကြ၏။
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />ချစ်ဆွေတို့၊ ဝိညာဉ်တော်ခံယူရရှိသည်ဟု ဆိုသူတိုင်းကိုမယုံကြနှင့်။ သူတို့ခံယူရရှိ သည်ဆိုသောဝိညာဉ်တော်သည် ဘုရားသခင် ၏ထံတော်မှဆင်းသက်လာသည့်ဝိညာဉ်တော် ဟုတ်မဟုတ်စစ်ဆေးကြည့်ရှုကြလော့။ အဘယ် ကြောင့်ဆိုသော်မိစ္ဆာပရောဖက်များသည် နေရာ တကာသို့ရောက်ရှိနေကြသောကြောင့်ဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="2" style="v" />ဘုရားသခင်၏ဝိညာဉ်တော်ဟုတ်မဟုတ် သင် တို့သိရှိနိုင်မည့်နည်းကားဤသို့တည်း။ သခင် ယေရှုသည်လူ့ဇာတိကိုခံယူကာကြွလာ တော်မူသည်ဟုဝန်ခံသူသည် ဘုရားသခင် ထံတော်မှဆင်းသက်လာသည့်ဝိညာဉ်တော် ကိုခံယူရရှိသူဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="3" style="v" />ယင်းသို့ဝန်မခံသူသည်ကား ဘုရားသခင် ထံတော်မှဆင်းသက်လာသည့်ဝိညာဉ်တော်ကို ခံယူရရှိသူမဟုတ်။ ထိုသူတွင်ကိန်းအောင်း သည့်ဝိညာဉ်မှာ ခရစ်တော်၏ရန်သူဖြစ်၏။ ခရစ်တော်၏ရန်သူဝိညာဉ်သည် ဤလောက သို့ရောက်ရှိလာမည်ဖြစ်ကြောင်း၊ သင်တို့ကြား သိခဲ့ကြ၏။ သူသည်ယခုပင်လျှင်ရောက်ရှိ လျက်နေလေပြီ။
  </para>
  <para style="p">
    <verse number="4" style="v" />သားသမီးတို့၊ သင်တို့သည်ဘုရားသခင် ၏ဘက်တော်သားများဖြစ်၍မိစ္ဆာပရောဖက် များကိုအနိုင်ရခဲ့ကြ၏။ အဘယ်ကြောင့် ဆိုသော်သင်တို့တွင်ကျိန်းဝပ်တော်မူသော ဝိညာဉ်တော်သည်လောကသားတို့တွင်ကိန်း ဝပ်သောဝိညာဉ်ထက်ကြီးမြတ်တော်မူသော ကြောင့်တည်း။-
  </para>
  <para style="p">
    <verse number="5" style="v" />မိစ္ဆာပရောဖက်တို့သည်လောကနှင့်ဆိုင်သော သူများဖြစ်ကြ၏။ သို့ဖြစ်၍လောကီအကြောင်း အရာများကိုပြောဆိုကြ၏။ လောကသား တို့သည်လည်းသူတို့၏စကားကိုနားထောင် ကြ၏။-
  </para>
  <para style="p">
    <verse number="6" style="v" />သို့ရာတွင်ငါတို့သည်ဘုရားသခင်၏ဘက် တော်သားများဖြစ်ကြ၏။ ဘုရားသခင်ကိုသိ သောသူသည်ငါတို့စကားကိုနားထောင်တတ်၏။ ဘုရားသခင်၏ဘက်တော်သားမဟုတ်သူမူ ကားငါတို့စကားကိုနားမထောင်တတ်။ ဤ သို့လျှင်ငါတို့သည်သမ္မာဝိညာဉ်နှင့်မိစ္ဆာ ဝိညာဉ်ကိုခွဲခြား၍သိရှိနိုင်ကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ချစ်ဆွေတို့၊ ချစ်ခြင်းမေတ္တာသည်ဘုရားသခင်ထံ တော်မှသက်ရောက်လာသည်ဖြစ်ရာ ငါတို့သည် အချင်းချင်းတစ်ယောက်ကိုတစ်ယောက်ချစ်ကြ ကုန်အံ့။ ချစ်တတ်သောသူသည်ဘုရားသခင်၏ သားသမီးဖြစ်၏။ ကိုယ်တော်ကိုသိကျွမ်း သောသူလည်းဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="8" style="v" />ဘုရားသခင်သည်ချစ်ခြင်းမေတ္တာဖြစ်တော် မူ၏။ သို့ဖြစ်၍မေတ္တာကင်းမဲ့သူသည်ဘုရား သခင်ကိုမသိ။-
  </para>
  <para style="p">
    <verse number="9" style="v" />ငါတို့သည်သားတော်အားဖြင့်အသက်ကို ရရှိကြစေရန်ဘုရားသခင်သည် မိမိ၏ တစ်ပါးတည်းသောသားတော်ကိုဤလောက သို့စေလွှတ်တော်မူခြင်းအားဖြင့် ငါတို့အပေါ် ၌မိမိထားရှိသောမေတ္တာတော်ကိုပေါ်လွင် ထင်ရှားစေတော်မူ၏။-
  </para>
  <para style="p">
    <verse number="10" style="v" />မေတ္တာဟုဆိုရာ၌ဘုရားသခင်အတွက်ငါ တို့ထားရှိသည့်မေတ္တာကိုမဆိုလို။ ငါတို့သည် အပြစ်များမှပြေလွတ်ခွင့်ရရှိ၍ ပူဇော်ဆက် ကပ်တော်မူသောသားတော်ကိုစေလွှတ်တော် မူခြင်းအားဖြင့် ငါတို့အားဘုရားသခင်ပြ တော်မူသောမေတ္တာတော်ကိုဆိုလိုပေသည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ချစ်ဆွေတို့၊ ဘုရားသခင်သည်ငါတို့အား ဤမျှချစ်တော်မူလျှင်ငါတို့သည်အချင်း ချင်းချစ်သင့်ကြ၏။-
  </para>
  <para style="p">
    <verse number="12" style="v" />အဘယ်သူမျှဘုရားသခင်ကိုမတွေ့မမြင် စဖူး။ သို့ရာတွင်ငါတို့သည်အချင်းချင်းချစ် ကြပါမူ ဘုရားသခင်သည်ငါတို့နှင့်တစ်လုံး တစ်ဝတည်းဖြစ်တော်မူလျက် ကိုယ်တော်၏ မေတ္တာတော်သည်ငါတို့၌ပြည့်ဝစုံလင်ပြီ။
  </para>
  <para style="p">
    <verse number="13" style="v" />ကိုယ်တော်သည်ငါတို့အားဝိညာဉ်တော်ကို ပေးတော်မူသောကြောင့် ငါတို့သည်ကိုယ်တော်နှင့် တစ်လုံးတစ်ဝတည်းရှိ၍ကိုယ်တော်သည်လည်း ငါတို့နှင့်တစ်လုံးတစ်ဝတည်းရှိတော်မူ ကြောင်းငါတို့သေချာစွာသိကြ၏။-
  </para>
  <para style="p">
    <verse number="14" style="v" />ခမည်းတော်သည်သားတော်အားလောကကို ကယ်တင်ရန်စေလွှတ်တော်မူကြောင်းကို ငါ တို့တွေ့မြင်ရ၍သက်သေခံကြ၏။-
  </para>
  <para style="p">
    <verse number="15" style="v" />သခင်ယေရှုသည်ဘုရားသခင်၏သားတော် ဖြစ်ကြောင်းဝန်ခံသောသူသည် ဘုရားသခင် နှင့်တစ်လုံးတစ်ဝတည်းရှိ၏။ ဘုရားသခင် သည်လည်းသူနှင့်တစ်လုံးတစ်ဝတည်းရှိ တော်မူ၏။-
  </para>
  <para style="p">
    <verse number="16" style="v" />ငါတို့အပေါ်ဘုရားသခင်မေတ္တာထားရှိ တော်မူကြောင်းငါတို့ကိုယ်တိုင်သိ၍ယုံ ကြည်ကြ၏။ ဘုရားသခင်သည်ချစ်ခြင်းမေတ္တာဖြစ်တော် မူ၏။ ချစ်တတ်သောသူသည်ဘုရားသခင်နှင့် တစ်လုံးတစ်ဝတည်းရှိ၏။ ဘုရားသခင်သည် လည်းထိုသူနှင့်တစ်လုံးတစ်ဝတည်းရှိတော် မူ၏။-
  </para>
  <para style="p">
    <verse number="17" style="v" />ငါတို့၌ကိုယ်တော်၏မေတ္တာတော်ပြည့်ဝစုံ လင်ခြင်းအားဖြင့် တရားစီရင်တော်မူရာနေ့ ၌ငါတို့သည်ရဲရင့်တည်ကြည်မှုကိုရရှိနိုင် ကြလိမ့်မည်။ အဘယ်ကြောင့်ဆိုသော်လောက ၌ငါတို့သည်ခရစ်တော်နည်းတူအသက် ရှင်ကြသောကြောင့်ဖြစ်၏။-
  </para>
  <para style="p">
    <verse number="18" style="v" />ချစ်ခြင်းမေတ္တာ၌ကြောက်စိတ်မရှိနိုင်။ ပြည့်ဝ စုံလင်သည့်မေတ္တာသည်ကြောက်စိတ်ကိုပယ်ရှား တတ်၏။ ကြောက်စိတ်သည်အပြစ်ဒဏ်ခံရမှုကို စောင့်မျှော်တတ်သဖြင့်ကြောက်စိတ်ရှိသူ၌ မေတ္တာပြည့်ဝစုံလင်ခြင်းမရှိပေ။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဘုရားသခင်သည်ငါတို့အားရှေးဦးစွာချစ် တော်မူသောကြောင့်ငါတို့သည်ကိုယ်တော်ကို ချစ်ကြ၏။-
  </para>
  <para style="p">
    <verse number="20" style="v" />ဘုရားသခင်ကိုချစ်ပါသည်ဟုဆိုလျက် ညီအစ်ကိုကိုမုန်းသောသူသည်လူလိမ်ဖြစ် ၏။ အဘယ်ကြောင့်ဆိုသော်မျက်စိဖြင့်မြင်ရသူ ညီအစ်ကိုကိုမချစ်နိုင်သောသူသည် မျက်စိ ဖြင့်မမြင်ရသည့်ဘုရားသခင်ကိုချစ်နိုင် မည်မဟုတ်သောကြောင့်တည်း။-
  </para>
  <para style="p">
    <verse number="21" style="v" />ငါတို့အားခရစ်တော်ပေးတော်မူသောပညတ် တော်ကား``ဘုရားသခင်ကိုချစ်သောသူသည် ညီအစ်ကိုကိုလည်းချစ်ရမည်'' ဟူ၍ဖြစ် သတည်း။
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />သခင်ယေရှုသည်မေရှိယဖြစ်တော်မူကြောင်းကို ယုံကြည်သောသူသည် ဘုရားသခင်၏သားသမီး ဖြစ်၏။ ဖခင်ကိုချစ်သောသူသည်ထိုဖခင်၏သား ကိုလည်းချစ်တတ်၏။-
  </para>
  <para style="p">
    <verse number="2" style="v" />ငါတို့သည်ဘုရားသခင်ကိုချစ်၍ပညတ် တော်ကိုစောင့်ထိန်းခြင်းအားဖြင့် ဘုရားသခင် ၏သားသမီးများကိုငါတို့ချစ်ကြောင်း ငါတို့သိကြရ၏။-
  </para>
  <para style="p">
    <verse number="3" style="v" />အဘယ်ကြောင့်ဆိုသော်ဘုရားသခင်ကို ချစ်ခြင်းသည် ကိုယ်တော်၏ပညတ်တော်တို့ ကိုစောင့်ထိန်းခြင်းပင်ဖြစ်သည်။ ကိုယ်တော်၏ ပညတ်တော်တို့ကိုစောင့်ထိန်းရန်ငါတို့ အတွက်ဝန်မလေးပေ။-
  </para>
  <para style="p">
    <verse number="4" style="v" />အဘယ်ကြောင့်ဆိုသော်ဘုရားသခင်၏သား သမီးဖြစ်သူသည် လောကကိုအောင်နိုင်သော ကြောင့်ဖြစ်၏။ ငါတို့သည်ယုံကြည်ခြင်းအား ဖြင့်လောကကိုအောင်ခြင်းဖြစ်ပေသည်။-
  </para>
  <para style="p">
    <verse number="5" style="v" />သခင်ယေရှုသည်ဘုရားသခင်၏သား တော်ဖြစ်ကြောင်းခံယူယုံကြည်သူမှတစ်ပါး အဘယ်သူသည်လောကကိုအောင်နိုင်သနည်း။
  </para>
  <para style="p">
    <verse number="6" style="v" />ယေရှုခရစ်သည်ရေအားဖြင့်ဗတ္တိဇံကိုခံ တော်မူလျက်သွေးတော်ကိုသွန်း၍ အသေခံ တော်မူလျက်ကြွလာတော်မူသောအရှင်ပေ တည်း။ ကိုယ်တော်သည်ရေအားဖြင့်သာကြွလာ တော်မူသည်မဟုတ်။ ရေအားဖြင့်လည်းကောင်း၊ သွေးအားဖြင့်လည်းကောင်းကြွလာတော်မူပေ သည်။ ဝိညာဉ်တော်သည်သမ္မာတရားဖြစ်၍ကြွ လာတော်မူကြောင်းကိုသက်သေခံတော်မူ၏။-
  </para>
  <para style="p">
    <verse number="7" style="v" />သက်သေသုံးပါးရှိလေသည်။-
  </para>
  <para style="p">
    <verse number="8" style="v" />ယင်းတို့ကားဝိညာဉ်တော်၊ ရေနှင့်သွေးတို့ဖြစ် ကြ၏။ ထိုသုံးပါးတို့သည်တညီတညွတ် တည်းသက်သေခံကြ၏။-
  </para>
  <para style="p">
    <verse number="9" style="v" />ငါတို့သည်လူတို့၏သက်သေခံချက်ကို လက်ခံတတ်ကြ၏။ ဘုရားသခင်၏သက်သေ ခံတော်မူချက်မှာ လူတို့၏သက်သေခံချက် ထက်ပို၍ပင်ခိုင်လုံ၏။ ကိုယ်တော်သည်သား တော်၏အကြောင်းသက်သေခံတော်မူပြီ။-
  </para>
  <para style="p">
    <verse number="10" style="v" />ဘုရားသခင်၏သားတော်ကိုယုံကြည်သူသည် ထိုသက်သေခံချက်ကိုစိတ်နှလုံးထဲတွင်မှတ် ကျုံးထား၏။ ဘုရားသခင်ကိုမယုံကြည်သူ သည်ကား သားတော်အကြောင်းကိုယ်တော်သက် သေခံတော်မူသည်ကိုမယုံကြည်သဖြင့် ဘုရားသခင်အားမုသားသုံးသည်ဟုဆို ရာရောက်၏။-
  </para>
  <para style="p">
    <verse number="11" style="v" />ဘုရားသခင်သည်ငါတို့အား ထာဝရအသက် ကိုပေးသနားတော်မူကြောင်း၊ ထိုအသက်ကို သားတော်အားဖြင့်ရရှိကြောင်းဘုရားသခင် သက်သေခံတော်မူ၏။-
  </para>
  <para style="p">
    <verse number="12" style="v" />သားတော်ကိုရရှိသူသည်ထိုအသက်ကို ရ၏။ ဘုရားသခင်၏သားတော်ကိုမရ ရှိသူမူကားထိုအသက်ကိုမရ။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဘုရားသခင်၏သားတော်ကိုယုံကြည်သူသင် တို့သည် ထာဝရအသက်ကိုရရှိကြောင်းသိ ကြစေရန် ဤအကြောင်းအရာများကိုငါ ရေးလိုက်၏။-
  </para>
  <para style="p">
    <verse number="14" style="v" />ကိုယ်တော်သည်မိမိ၏အလိုတော်နှင့်အညီ တောင်းလျှောက်သောပတ္ထနာကိုနားညောင်းတော် မူကြောင်းစိတ်ချယုံကြည်နိုင်သဖြင့် ငါတို့ သည်ရှေ့တော်သို့ရဲဝံ့စွာချဉ်းကပ်ကြပေသည်။-
  </para>
  <para style="p">
    <verse number="15" style="v" />ယင်းသို့ကိုယ်တော်နားညောင်းတော်မူသည်ကို သိကြသဖြင့် ငါတို့သည်မိမိတို့တောင်းလျှောက် သည့်ဆုများကိုချပေးတော်မူသည်ကိုလည်း သိကြ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ညီအစ်ကိုတစ်စုံတစ်ယောက်သည်အသက် ဝိညာဉ်ဆုံးရှုံးမည့်အြုပစ်မှလွဲ၍ အခြားအပြစ် တစ်စုံတစ်ရာကိုကူးလွန်ပါမူသူ့အတွက် ဘုရားသခင်ထံဆုတောင်းလော့။ ကိုယ်တော် သည်သူ့အားအသက်ကိုပေးတော်မူလိမ့်မည်။ အသက်ဝိညာဉ်ဆုံးရှုံးမည့်အြုပစ်ကိုမကူး သူများအတွက်သာ ဤသို့ဆုတောင်းပေးရန် ဖြစ်သည်။ သို့ရာတွင်အသက်ဝိညာဉ်ဆုံးရှုံး မည့်အပြစ်ဟူ၍ရှိသည်။ ထိုအပြစ်မျိုးကို ကူးသူအတွက်ဆုတောင်းရမည်ဟုငါမဆို။-
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒုစရိုက်ဟူသမျှသည်အပြစ်ဖြစ်၏။ သို့ရာ တွင်အပြစ်ဟူသမျှသည် အသက်ဝိညာဉ် ဆုံးရှုံးမည့်အပြစ်များမဟုတ်ပေ။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဘုရားသခင်၏သားသမီးဖြစ်သူသည် ဆက်လက်၍ အပြစ်မကူးတတ်ကြောင်းကိုငါ တို့သိကြ၏။ သူ့အားဘုရားသခင်၏သား တော်စောင့်ထိန်းတော်မူသည်ဖြစ်၍ မာရ်နတ် သည်ထိုသူကိုမထိမခိုက်နိုင်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ကမ္ဘာလောကတစ်ခုလုံးတွင်မာရ်နတ်၏တန်ခိုး လွှမ်းမိုးလျက်ရှိနေသော်လည်း ငါတို့သည် ဘုရားသခင်၏ဘက်တော်သားများဖြစ် ကြောင်းကိုငါတို့သိကြ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဘုရားသခင်၏သားတော်သည်လောကသို့ကြွ လာတော်မူ၍ ငါတို့အားဘုရားစစ်ဘုရားမှန် ကိုသိရှိနိုင်သည့်ဉာဏ်ကိုပေးတော်မူကြောင်း ငါတို့သိကြ၏။ ငါတို့သည်ကိုယ်တော်၏သားတော် ယေရှုခရစ်နှင့်လည်းကောင်း၊ ဘုရားစစ်ဘုရားမှန် ဖြစ်တော်မူသောဘုရားသခင်နှင့်လည်းကောင်း တစ်လုံးတစ်ဝတည်းရှိကြ၏။ ကိုယ်တော်သည် ဘုရားစစ်ဘုရားမှန်ဖြစ်တော်မူ၏။ ထာဝရ အသက်လည်းဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />သားသမီးတို့၊ သင်တို့သည်ဘုရားအတု အယောင် များကိုရှောင်ကြလော့။ ရှင်ယောဟန်သြဝါဒစာပထမစောင်ပြီး၏။
  </para>
</usx>
