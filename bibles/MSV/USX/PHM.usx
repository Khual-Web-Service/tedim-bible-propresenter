<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PHM" style="id">ဖိလေမုန်</book>
  <para style="h">ဖိလေမုန်</para>
  <para style="toc1">ဖိလေမုန်</para>
  <para style="toc2">ဖိလေမုန်</para>
  <para style="mt">ဖိလေမုန်</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />ခရစ်တော်ယေရှု၏အမှုတော်ကိုထမ်းရွက် သည့်အတွက်ကြောင့် အကျဉ်းခံနေရသူငါ ပေါလုနှင့်ငါတို့၏ညီတိမောသေထံမှ ငါ တို့ချစ်သောလုပ်ဖော်ဆောင်ဘက်ဖိလေမုန်ထံ သို့လည်းကောင်း၊-
  </para>
  <para style="p">
    <verse number="2" style="v" />ငါတို့နှမအပ္ပိ၊ ငါတို့၏ရဲဘော်စစ်သည်တော် အာခိပ္ပုနှင့် သင်၏အိမ်တွင်စုဝေးသည့်အသင်း တော်ဝင်တို့ထံသို့လည်းကောင်းစာရေးလိုက် ပါသည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ငါတို့အဖဘုရားသခင်နှင့်သခင်ယေရှု ခရစ်၏ထံတော်မှ ကျေးဇူးတော်နှင့်ငြိမ်သက် ခြင်းကို သင်တို့အားလုံးခံစားရကြပါစေ သော။
  </para>
  <para style="p">
    <verse number="4" style="v" />ငါ့ညီဖိလေမုန်၊ ဘုရားသခင်၏လူစုတော်ဝင် အပေါင်းတို့အားသင်ချစ်ခင်ပုံ၊ သခင်ယေရှုကို သင်ယုံကြည်ပုံကိုကြားသိရသဖြင့် ငါသည် ဆုတောင်းပတ္ထနာပြုသည့်အခါတိုင်း သင့်ကို အကြောင်းပြု၍ဘုရားသခင်၏ကျေးဇူး တော်ကိုချီးမွမ်း၏။-
  </para>
  <para style="p">
    <verse number="6" style="v" />ယုံကြည်သူများဖြစ်ကြသောသင်နှင့်ငါတို့ သည် အချင်းချင်းမိတ်သဟာယဖွဲ့ခြင်းအား ဖြင့် ခရစ်တော်နှင့်တစ်လုံးတစ်ဝတည်းဖြစ်လျက် ငါတို့ခံစားရသည့်ကောင်းချီးမင်္ဂလာအပေါင်း ကိုပိုမိုနက်နဲစွာသိရှိနားလည်နိုင်ကြရန် ငါဆုတောင်း၏။-
  </para>
  <para style="p">
    <verse number="7" style="v" />ငါ့ညီ၊ သင်၏မေတ္တာသည်ငါ့အားအလွန်ဝမ်း မြောက်စေ၍များစွာအားတက်စေ၏။ သင်သည် ဘုရားသခင်၏လူစုတော်ဝင်အပေါင်းတို့ အားစိတ်ရွှင်လန်းစေလေပြီ။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဤအကြောင်းကြောင့်ငါသည်ခရစ်တော်၌ညီ အစ်ကိုချင်းအနေဖြင့် သင်ပြုသင့်သည့်အမှု အရာကိုပြုရန်အမိန့်ပေးနိုင်ခွင့်ရှိသည်ဟု ယုံကြည်သော်လည်း ငါသည်သင့်ကိုချစ်သော ကြောင့်သင့်အားမေတ္တာရပ်ခံပါ၏။ ခရစ်တော် ယေရှု၏သံတမန်ဖြစ်သူ၊ ယခုအခါခရစ် တော်ယေရှုအတွက်အကျဉ်းခံနေရသူငါ ပေါလုသည်သင့်အားမေတ္တာရပ်ခံပါ၏။-
  </para>
  <para style="p">
    <verse number="10" style="v" />ငါအကျဉ်းခံလျက်နေရစဉ်အခါ၌ခရစ် တော်၌ ငါ၏သားဖြစ်လာသူသြနေသိမ်အတွက် မေတ္တာရပ်ခံပါ၏။-
  </para>
  <para style="p">
    <verse number="11" style="v" />သူသည်ယခင်ကသင့်အတွက်အသုံးမဝင်ခဲ့ သော်လည်း ယခုအခါသင်၏အတွက်နှင့်ငါ၏ အတွက်ပါအသုံးဝင်လာလေပြီ။-
  </para>
  <para style="p">
    <verse number="12" style="v" />ငါသည်ငါ၏ရင်သွေးကိုသင်၏ထံသို့ပြန်၍ စေလွှတ်လိုက်ပါ၏။-
  </para>
  <para style="p">
    <verse number="13" style="v" />ငါသည်သတင်းကောင်းကိုဟောပြောကြေညာ မှုကြောင့် အကျဉ်းခံလျက်နေရစဉ်အခါတွင် သင်၏ကိုယ်စားငါ့အားကူညီစေရန်သူ့ကို ခေါ်ထားလိုပါသည်။-
  </para>
  <para style="p">
    <verse number="14" style="v" />သို့ရာတွင်သင်၏သဘောတူညီချက်မရရှိ ဘဲအဘယ်အမှုကိုမျှငါမပြုလိုပါ။ ငါ့ကို ကူညီမစစေရန်သင့်အားအနိုင်အထက် မပြုလိုပါ။ သင်၏စေတနာအလျောက်သာ လျှင်မစစေလိုပါ၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သြနေသိမ်သည်သင်နှင့်အစဉ်ပြန်လည်နေထိုင် နိုင်ရန် သင်နှင့်ခေတ္တမျှခွဲခွာရခြင်းဖြစ်တန်ရာ၏။-
  </para>
  <para style="p">
    <verse number="16" style="v" />ယခုအခါသူသည်ကျွန်မျှသာမဟုတ်တော့ဘဲ ခရစ်တော်၌ချစ်သောညီအစ်ကိုဖြစ်လာပေပြီ။ သူသည်ငါ၏အတွက်အလွန်တန်ဖိုးရှိပေသည်။ သို့ရာတွင်သင်၏အတွက်ကျွန်အနေနှင့်လည်း ကောင်း၊ သခင်ဘုရား၌ညီအစ်ကိုအနေနှင့် လည်းကောင်းများစွာပို၍ပင်တန်ဖိုးရှိမည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />သို့ဖြစ်၍သင်သည်ငါ့အားမိမိ၏လုပ်ဖော် ဆောင်ဘက်အနေဖြင့် ကြိုဆိုလက်ခံသကဲ့ သို့သူ့အားကြိုဆိုလက်ခံပါလော့။-
  </para>
  <para style="p">
    <verse number="18" style="v" />အကယ်၍သူသည်သင့်အားတစ်စုံတစ်ရာ ပြစ်မှားမိခဲ့သော်လည်းကောင်း၊ တစ်စုံတစ်ရာ ပေးဆပ်စရာရှိခဲ့သော်လည်းကောင်း ငါ တာဝန်ယူပါမည်။-
  </para>
  <para style="p">
    <verse number="19" style="v" />``ငါပေါလုသည်ထိုအကြွေးကို ပေးဆပ်ပါ မည်'' ဟူ၍ ငါကိုယ်တိုင်လက်မှတ်ရေးထိုးပါ၏။ (သင့်ကိုယ်တိုင်ပင်လျှင် သင်၏ဘဝသစ်အတွက် ငါ့အားပေးဆပ်စရာရှိကြောင်း ဖော်ပြရန် မလိုပါ။-)
  </para>
  <para style="p">
    <verse number="20" style="v" />သို့ဖြစ်၍ငါ့ညီ၊ သခင်ဘုရား၏မျက်နှာတော် ကိုထောက်၍ငါ့အားကျေးဇူးပြုပါလော့။ ခရစ် တော်၌ညီအစ်ကိုအနေဖြင့်ငါ့အားစိတ်ရွှင် လန်းစေပါလော့။
  </para>
  <para style="p">
    <verse number="21" style="v" />သင်သည်ငါမေတ္တာရပ်ခံသည့်အတိုင်းပြုလုပ် လိမ့်မည်ဟုစိတ်ချယုံကြည်လျက် ဤစာကိုရေး လိုက်၏။ အမှန်စင်စစ်ထိုထက်ပင်ပို၍ပြုလုပ် လိမ့်မည်ကိုငါသိပါ၏။-
  </para>
  <para style="p">
    <verse number="22" style="v" />ထို့အပြင်ငါတည်းခိုရန်အခန်းတစ်ခုကို အသင့်ပြင်ထားပါလော့။ အဘယ်ကြောင့်ဆို သော်ဘုရားသခင်သည်သင်တို့အပေါင်း၏ ဆုတောင်းပတ္ထနာကိုနားညောင်းတော်မူ၍ ငါ့ အားသင်တို့ထံသို့ပြန်လည်ရောက်ရှိစေတော် မူလိမ့်မည်ဟုငါမျှော်လင့်သောကြောင့်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ခရစ်တော်ယေရှုအတွက်ကြောင့်ငါနှင့်အတူ အကျဉ်းခံရသူဧပဖြကလည်းကောင်း၊-
  </para>
  <para style="p">
    <verse number="24" style="v" />ငါ၏လုပ်ဖော်ဆောင်ဘက်များဖြစ်ကြသည့် မာကု၊ အာရိတ္တခု၊ ဒေမနှင့်လုကာတို့က လည်းကောင်းသင့်ကိုနှုတ်ဆက်ကြ၏။-
  </para>
  <para style="p">
    <verse number="25" style="v" />သခင်ယေရှုခရစ်၏ကျေးဇူးတော်ကိုသင် တို့အားလုံးခံစားရကြပါစေသော။ ဖိလေမုန်သြဝါဒစာပြီး၏။
  </para>
</usx>
