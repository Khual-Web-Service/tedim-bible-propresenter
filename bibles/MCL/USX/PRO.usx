<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">သုတ္တံကျမ်း</book>
  <para style="h">သုတ္တံကျမ်း</para>
  <para style="toc1">သုတ္တံကျမ်း</para>
  <para style="toc2">သုတ္တံကျမ်း</para>
  <para style="mt">သုတ္တံကျမ်း</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်၏သားတော်၊ အစ္စရေးဘုရင်၊ ရှောလမုန်၏သုတ္တံစကားများ။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဤစကားတို့သည် ဉာဏ်ပညာနှင့်ဆုံးမပဲ့ပြင်ခြင်းကို သိရှိစေရန်အတွက်လည်းကောင်း၊ အသိဉာဏ်နှင့်ဆိုင်သောစကားတို့ကို နားလည်စေရန်အတွက်လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="3" style="v" />ပညာသတိနှင့်ဆိုင်သောဆုံးမပဲ့ပြင်ခြင်း၊ ဖြောင့်မတ်ခြင်း၊ တရားမျှတခြင်းနှင့် သမာသမတ်ရှိခြင်းကို ရရှိစေရန်အတွက်လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="4" style="v" />အသိဉာဏ်နည်းပါးသောသူတို့အား ဆင်ခြင်ဉာဏ်ကိုပေး၍ လူငယ်တို့အား အသိပညာနှင့်အလိမ္မာဉာဏ်ကို ပေးရန်အတွက်လည်းကောင်း ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ပညာရှိသောသူသည် နားထောင်၍ ပညာတိုးပွားပါစေ။ အသိဉာဏ်ရှိသောသူသည်လည်း လမ်းညွှန်မှုများရရှိပါစေ။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဤသည်ကား သုတ္တံစကား၊ ဥပစာစကားမှစ၍ ပညာရှိတို့၏စကားများနှင့် သူတို့၏ပဟေဠိများကို နားလည်စေရန်အတွက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် အသိပညာ၏အရင်းအမြစ်ဖြစ်၏။ ဆိုးမိုက်သောသူတို့သည် ဉာဏ်ပညာနှင့် ဆုံးမပဲ့ပြင်ခြင်းကို မထီမဲ့မြင်ပြုတတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ငါ့သား၊ သင့်ဖခင်၏ဆုံးမပဲ့ပြင်ခြင်းကို နားထောင်လော့။ သင့်မိခင်၏သွန်သင်ချက်ကိုလည်း မပစ်ပယ်နှင့်။
  </para>
  <para style="p">
    <verse number="9" style="v" />အကြောင်းမူကား ထိုအရာတို့သည် သင်၏ဦးခေါင်းအတွက် တင့်တယ်သောပန်းဦးရစ်၊ သင်၏လည်ပင်းအတွက် လည်ဆွဲဖြစ်ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ငါ့သား၊ အပြစ်သားတို့သည် သင့်ကိုသွေးဆောင်လျှင် မလိုက်လျောနှင့်။
  </para>
  <para style="p">
    <verse number="11" style="v" />အကယ်၍ သူတို့က “ငါတို့နှင့်အတူလိုက်ခဲ့လော့။ တစ်စုံတစ်ယောက်ကိုသတ်ဖြတ်ရန် ငါတို့ချောင်းမြောင်းကြစို့။ အကြောင်းမရှိဘဲ အပြစ်ကင်းသောသူကို ပုန်းအောင်းတိုက်ခိုက်ကြစို့။
  </para>
  <para style="p">
    <verse number="12" style="v" />မရဏာနိုင်ငံကဲ့သို့ သူတို့ကို အရှင်လတ်လတ်ဝါးမျိုလျက် သေတွင်းထဲသို့ တစ်ကိုယ်လုံးဆင်းသွားရသူများကဲ့သို့ ဖြစ်စေကြစို့။
  </para>
  <para style="p">
    <verse number="13" style="v" />ငါတို့သည် အဖိုးတန်သောစည်းစိမ်ဥစ္စာမျိုးစုံကို တွေ့ရှိ၍ လုယက်ပစ္စည်းများဖြင့် ငါတို့အိမ်ကိုပြည့်စေကြမည်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ငါတို့နှင့် ဆိုးတူကောင်းဖက်ပူးပေါင်းလော့။ ငါတို့အားလုံး ပိုက်ဆံအိတ်တစ်အိတ်တည်းထဲမှ ဝေမျှသုံးစွဲကြစို့”ဟု ဆိုလျှင်လည်း
  </para>
  <para style="p">
    <verse number="15" style="v" />ငါ့သား၊ သူတို့နှင့်အတူ ထိုလမ်းကိုမလိုက်နှင့်။ သူတို့သွားရာလမ်းသို့မလိုက်မိစေရန် သင်၏ခြေကိုထိန်းချုပ်လော့။
  </para>
  <para style="p">
    <verse number="16" style="v" />အကြောင်းမူကား သူတို့၏ခြေသည် မကောင်းမှုပြုရာသို့ပြေးသွား၍ သူတို့သည် လူကိုသတ်ဖြတ်ရန် လျင်မြန်ကြ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />အမှန်စင်စစ် မည်သည့်ကျေးငှက်၏မျက်စိရှေ့၌မဆို ပိုက်ကွန်ကိုထောင်လျှင် အလဟဿဖြစ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ထိုသူတို့သည် ကိုယ့်ကိုယ်ကိုယ်သတ်ဖြတ်ရန် ချောင်းမြောင်း၍ ကိုယ့်အသက်ကိုကိုယ် ပုန်းအောင်းတိုက်ခိုက်နေကြခြင်းသာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />မတရားသောအကျိုးစီးပွားကို တပ်မက်သောသူတိုင်း၏လမ်းတို့သည် ထိုကဲ့သို့ဖြစ်ကြ၏။ ထိုသို့သောအကျိုးစီးပွားသည် ၎င်းကိုပိုင်ဆိုင်သောသူတို့၏အသက်ကို နုတ်ယူတတ်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဉာဏ်ပညာသည် လမ်းပေါ်၌ကြွေးကြော်၍ လမ်းဆုံများ၌ မိမိအသံကိုလွှင့်တတ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဆူညံသောလမ်းထိပ်မှ ဟစ်ခေါ်၍ မြို့တံခါးအဝင်ဝတို့၌မြွက်ဆိုသောစကားဟူမူကား
  </para>
  <para style="p">
    <verse number="22" style="v" />“အသိဉာဏ်နည်းပါးသောသူတို့သည် အသိဉာဏ်နည်းပါးခြင်းကိုနှစ်သက်လျက်၊ ပြက်ရယ်ပြုတတ်သောသူတို့သည် မိမိတို့၏ပြက်ရယ်ပြုခြင်း၌မွေ့လျော်လျက်၊ မိုက်မဲသောသူတို့သည် အသိပညာကိုမုန်းတီးလျက် မည်မျှကြာအောင်နေကြဦးမည်နည်း။
  </para>
  <para style="p">
    <verse number="23" style="v" />ငါဆိုဆုံးမသောစကားကို လိုက်နာကြလော့။ ကြည့်ရှုလော့။ ငါသည် ငါ၏ဝိညာဉ်ကို သင်တို့အပေါ်သို့သွန်းလောင်းမည်။ ငါ၏စကားများကို သင်တို့အား သိစေမည်။
  </para>
  <para style="p">
    <verse number="24" style="v" />သို့သော် ငါခေါ်သောအခါ သင်တို့သည် ငြင်းပယ်ကြ၏။ ငါ့လက်ကိုဆန့်တန်းသောအခါ မည်သူမျှ အလေးမထားကြ။
  </para>
  <para style="p">
    <verse number="25" style="v" />သင်တို့သည် ငါပေးသောအကြံဉာဏ်အားလုံးကို လျစ်လျူရှုကြပြီး ငါ၏ဆိုဆုံးမခြင်းကိုလည်း အလိုမရှိကြ။
  </para>
  <para style="p">
    <verse number="26" style="v" />ထို့ကြောင့် သင်တို့ဘေးဒုက္ခရောက်သောအခါ ငါရယ်မောမည်။ ကြောက်မက်ဖွယ်ဘေးသည် သင်တို့ထံသို့ရောက်သောအခါ ငါပြက်ရယ်ပြုမည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ကြောက်မက်ဖွယ်ဘေးသည် လေပြင်းမုန်တိုင်းကဲ့သို့ သင်တို့အပေါ်သက်ရောက်သောအခါ၌လည်းကောင်း၊ ဘေးဒုက္ခသည် လေပွေကဲ့သို့ သင်တို့ထံရောက်လာသောအခါ၌လည်းကောင်း၊ ဆင်းရဲဒုက္ခနှင့်ဘေးဥပဒ်သည် သင်တို့အပေါ်သက်ရောက်သောအခါ၌လည်းကောင်း
  </para>
  <para style="p">
    <verse number="28" style="v" />သူတို့သည် ငါ့ကိုခေါ်ကြလိမ့်မည်။ သို့သော် ငါသည် ထူးမည်မဟုတ်။ သူတို့သည် ငါ့ကိုကြိုးစား၍ရှာကြလိမ့်မည်။ သို့သော် ငါ့ကိုတွေ့ရကြမည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />အကြောင်းမူကား သူတို့သည် အသိပညာကိုမုန်း၍ ထာဝရဘုရားအား ကြောက်ရွံ့ခြင်းကို မရွေးချယ်ကြ။
  </para>
  <para style="p">
    <verse number="30" style="v" />ငါ၏အကြံဉာဏ်ကိုအလိုမရှိကြ။ ငါ၏ဆိုဆုံးမစကားအားလုံးကိုလည်း မထီလေးစားပြုခဲ့ကြ၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />ထို့ကြောင့် သူတို့သည် မိမိတို့ပြုမူကျင့်ကြံသောအမှုအရာ၏အသီးကိုစား၍ မိမိတို့၏အကျင့်အကြံများနှင့် ဝအီကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="32" style="v" />အကြောင်းမူကား အသိဉာဏ်နည်းပါးသောသူတို့သည် မိမိ၏လမ်းလွဲဖောက်ပြန်မှုကြောင့် သေကြရ၏။ မိုက်မဲသောသူတို့သည်လည်း မိမိကိုယ်မိမိအားရကျေနပ်မှုကြောင့် ပျက်စီးကြရ၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />သို့သော် ငါ့စကားကိုနားထောင်သောသူသည် ဘေးကင်းလုံခြုံစွာနေရ၍ ဘေးအန္တရာယ်ကို မကြောက်ဘဲ အေးချမ်းစွာနေရလိမ့်မည်။”
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါ့သား၊ သင်သည် ငါ့စကားတို့ကိုခံယူ၍ ငါ၏ပညတ်ချက်တို့ကို သင့်အထဲ၌သိုမှီးထားကာ
  </para>
  <para style="p">
    <verse number="2" style="v" />ဉာဏ်ပညာကို အာရုံစိုက်နားထောင်လျက် ထိုးထွင်းဉာဏ်ဘက်သို့ သင်၏စိတ်နှလုံးကို တိမ်းညွတ်စေလျှင်လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="3" style="v" />အသိဉာဏ်ကိုခေါ်၍ ထိုးထွင်းဉာဏ်ဘက်သို့ သင်၏အသံကိုလွှင့်လျှင်လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="4" style="v" />ငွေကိုရှာသကဲ့သို့ ဉာဏ်ပညာကိုရှာ၍ ဝှက်ထားသောဘဏ္ဍာကိုရှာဖွေသကဲ့သို့ ထိုဉာဏ်ပညာကိုရှာဖွေလျှင်လည်းကောင်း
  </para>
  <para style="p">
    <verse number="5" style="v" />သင်သည် ထာဝရဘုရားအားကြောက်ရွံ့ခြင်းကို နားလည်၍ ဘုရားသခင်အားသိသောဉာဏ်ကို ရရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />အကြောင်းမူကား ထာဝရဘုရားသည် ဉာဏ်ပညာကိုပေးတော်မူ၏။ အသိပညာနှင့် ထိုးထွင်းဉာဏ်သည် ကိုယ်တော်၏နှုတ်တော်မှလာ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ကိုယ်တော်သည် ဖြောင့်မှန်သောသူတို့အတွက် မှန်ကန်ပြည့်စုံသောဉာဏ်ကိုသိုမှီးထား၍ တည်ကြည်စွာလျှောက်လှမ်းသောသူတို့အတွက် ဒိုင်းလွှားဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />တရားမျှတခြင်းလမ်းစဉ်တို့ကိုလည်း ကာကွယ်၍ မိမိသန့်ရှင်းသူတို့၏လမ်းကို စောင့်ရှောက်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ထိုအခါ သင်သည် ဖြောင့်မတ်ခြင်း၊ တရားမျှတခြင်း၊ သမာသမတ်ရှိခြင်းနှင့် ကောင်းမြတ်သောလမ်းရှိသမျှတို့ကို နားလည်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဉာဏ်ပညာသည် သင်၏စိတ်နှလုံးထဲသို့ဝင်၍ အသိပညာသည် သင်၏စိတ်ဝိညာဉ်ကို ရွှင်လန်းဝမ်းမြောက်စေသောအခါ
  </para>
  <para style="p">
    <verse number="11" style="v" />အလိမ္မာဉာဏ်သည် သင့်ကိုစောင့်ရှောက်၍ ထိုးထွင်းဉာဏ်သည် သင့်ကိုကာကွယ်သဖြင့်
  </para>
  <para style="p">
    <verse number="12" style="v" />မကောင်းသောလမ်းမှလည်းကောင်း၊ ဖောက်ပြန်လွဲမှားသောအရာတို့ကို ပြောဆိုတတ်သောသူတို့၏လက်မှလည်းကောင်း သင့်ကိုကယ်နုတ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူတို့သည် ဖြောင့်မှန်သောလမ်းစဉ်တို့ကိုစွန့်ပယ်၍ မှောင်မိုက်သောလမ်းတို့၌ လျှောက်လှမ်းသောသူများ၊
  </para>
  <para style="p">
    <verse number="14" style="v" />မကောင်းမှုပြုခြင်း၌ဝမ်းမြောက်၍ ဖောက်ပြန်လွဲမှားသောမကောင်းမှု၌ ပျော်မွေ့သောသူများ၊
  </para>
  <para style="p">
    <verse number="15" style="v" />ကွေ့ကောက်သောလမ်းစဉ်နှင့် သွေဖည်လွဲမှားသောလမ်းတို့ကိုလိုက်သောသူများဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />အကျင့်ဖောက်ပြားသောမိန်းမနှင့် စကားတို့ဖြင့်မြှူဆွယ်တတ်သော ကိုယ်ကျင့်တရားပျက်ပြားသည့်မိန်းမ၏လက်မှလည်း သင့်ကိုကယ်နုတ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ထိုမိန်းမသည် မိမိပျိုရွယ်စဉ်ကတည်းက ပေါင်းဖော်ခဲ့သောသူကိုစွန့်ပစ်၍ မိမိဘုရားသခင်၏ပဋိညာဉ်ကို မေ့လျော့သူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />သူ၏အိမ်သည် သေခြင်းသို့လည်းကောင်း၊ သူ၏လမ်းတို့သည် သေသူ၏ ဝိညာဉ်များ ရှိရာသို့လည်းကောင်း ဆင်းသွား၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />သူ့ထံသို့သွားသောသူတစ်စုံတစ်ဦးမျှ ပြန်မလာတော့ပေ။ အသက်ရှင်ခြင်းလမ်းသို့လည်း မရောက်နိုင်တော့ပေ။
  </para>
  <para style="p">
    <verse number="20" style="v" />သို့ဖြစ်၍ သင်သည် သူတော်ကောင်းတို့၏လမ်းကိုလိုက်၍ ဖြောင့်မတ်သောသူတို့၏လမ်းစဉ်တို့ကို စောင့်ထိန်းရမည်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဖြောင့်မှန်သောသူတို့သည် ပြည်တော်၌နေထိုင်ရ၍ အပြစ်တင်စရာမရှိသောသူတို့သည် ထိုပြည်၌မြဲကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဆိုးယုတ်သောသူတို့မူကား ပြည်တော်မှ ဖယ်ရှားခြင်းခံရ၍ သစ္စာမဲ့သောသူတို့သည် ထိုပြည်မှနုတ်ပယ်ခြင်းခံရလိမ့်မည်။
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါ့သား၊ ငါ၏သွန်သင်ချက်ကို မမေ့လျော့နှင့်။ ငါ၏ပညတ်ချက်တို့ကိုလည်း သင်၏စိတ်နှလုံးသည် ထိန်းသိမ်းစောင့်ရှောက်ပါစေ။
  </para>
  <para style="p">
    <verse number="2" style="v" />အကြောင်းမူကား ၎င်းတို့သည် အသက်ရှည်ခြင်း၊ အသက်တာ၏နှစ်ကာလနှင့် ငြိမ်းချမ်းမှုကို သင်၌ ထပ်ဖြည့်ပေးလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />မေတ္တာကရုဏာနှင့်သမ္မာတရားကို သင့်ထံမှစွန့်ခွာမသွားစေနှင့်။ ၎င်းတို့ကို သင်၏လည်ပင်း၌ဆွဲထား၍ သင့်နှလုံးသားပြင်၌ ရေးထားလော့။
  </para>
  <para style="p">
    <verse number="4" style="v" />ထိုသို့ပြုလျှင် သင်သည် ဘုရားသခင်ရှေ့၊ လူတို့ရှေ့၌မျက်နှာရ၍ ကောင်းသောဉာဏ်စွမ်းနှင့်ပြည့်စုံလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ထာဝရဘုရားကို စိတ်နှလုံးအကြွင်းမဲ့ ယုံကြည်ကိုးစားလော့။ မိမိ၏အသိဉာဏ်ကို အမှီမပြုနှင့်။
  </para>
  <para style="p">
    <verse number="6" style="v" />သင်ပြုမူကျင့်ကြံသမျှသောအမှုအရာတို့၌ ကိုယ်တော်ကို မျက်မှောက်ပြုလော့။ သို့ပြုလျှင် ကိုယ်တော်သည် သင်၏လမ်းခရီးတို့ကို ဖြောင့်တန်းစေတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ကိုယ့်ကိုယ်ကိုယ် ပညာရှိဟု မထင်မြင်နှင့်။ ထာဝရဘုရားကိုကြောက်ရွံ့၍ မကောင်းမှုမှဖယ်ခွာလော့။
  </para>
  <para style="p">
    <verse number="8" style="v" />ထိုသို့ပြုခြင်းသည် သင်၏ကိုယ်ခန္ဓာ ကို ကျန်းမာစေ၍ သင်၏အရိုးတို့ကို သန်စွမ်းစေလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />သင်၏စည်းစိမ်ဥစ္စာနှင့် သင်ရရှိသမျှသောအသီးအနှံ၏အသီးဦးဖြင့် ထာဝရဘုရားကိုဂုဏ်ပြုချီးမွမ်းလော့။
  </para>
  <para style="p">
    <verse number="10" style="v" />သို့ပြုလျှင် သင်၏ကျီတို့သည် ပြည့်နှက်လျှံကျလျက် သင်၏စပျစ်သီးနယ်ရာကျင်းတို့သည်လည်း စပျစ်ဝိုင်အသစ်နှင့် ပြည့်လျှံလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ငါ့သား၊ ထာဝရဘုရား၏ဆုံးမပဲ့ပြင်တော်မူခြင်းကို အလေးမထားဘဲမနေနှင့်။ ကိုယ်တော်၏ဆိုဆုံးမခြင်းကိုခံရသောအခါ၌လည်း စိတ်မပျက်နှင့်။
  </para>
  <para style="p">
    <verse number="12" style="v" />အကြောင်းမူကား ဖခင်သည် နှစ်သက်သောသားကို ဆုံးမတတ်သကဲ့သို့ ထာဝရဘုရားသည် ချစ်တော်မူသောသူကို ဆုံးမတော်မူ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဉာဏ်ပညာကိုတွေ့ရှိသောသူနှင့် ထိုးထွင်းဉာဏ်ကိုရရှိသောသူသည် မင်္ဂလာရှိ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />အကြောင်းမူကား ဉာဏ်ပညာမှရရှိသောအကျိုးအမြတ်သည် ငွေမှရရှိသောအကျိုးအမြတ်ထက် ပို၍ကောင်း၏။ ၎င်း၏အမြတ်အစွန်းသည်လည်း ရွှေထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဉာဏ်ပညာသည် ပတ္တမြားထက်အဖိုးတန်၍ သင်နှစ်သက်သောမည်သည့်အရာနှင့်မျှ နှိုင်းယှဉ်၍မရနိုင်။
  </para>
  <para style="p">
    <verse number="16" style="v" />၎င်း၏လက်ယာလက်၌ အသက်ရှည်ခြင်း၊ လက်ဝဲလက်၌ ဓနဥစ္စာနှင့် ဂုဏ်သရေရှိ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဉာဏ်ပညာ၏လမ်းများသည် နှစ်လိုဖွယ်သောလမ်းများဖြစ်ကြပြီး ၎င်း၏လမ်းခရီးရှိသမျှတို့သည် ငြိမ်းချမ်းကြ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဉာဏ်ပညာသည် ၎င်းကိုဆုပ်ကိုင်ထားသော သူတို့အတွက် အသက်ပင်သဖွယ်ဖြစ်၏။ ၎င်းကိုစွဲကိုင်ထားသောသူတို့သည် မင်္ဂလာရှိကြ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ထာဝရဘုရားသည် ဉာဏ်ပညာအားဖြင့် မြေကြီးကိုတည်၍ ထိုးထွင်းဉာဏ်အားဖြင့် ကောင်းကင်ကို မြဲမြံစေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ကိုယ်တော်၏အသိပညာဖြင့် နက်ရှိုင်းရာအရပ်တို့သည် ပေါက်ထွက် ၍ မိုးတိမ်တို့သည် နှင်းကိုတဖွဲဖွဲကျစေ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ငါ့သား၊ မှန်ကန်ပြည့်စုံသောဉာဏ်နှင့် အလိမ္မာဉာဏ်ကိုထိန်းသိမ်းစောင့်ရှောက်လော့။ ၎င်းတို့ကို သင်၏မျက်မှောက်မှ မကွာစေနှင့်။
  </para>
  <para style="p">
    <verse number="22" style="v" />သို့ပြုလျှင် ၎င်းတို့သည် သင်၏စိတ်ဝိညာဉ်အတွက် အသက်ဖြစ်ပြီး သင်၏လည်ပင်းအတွက် တင့်တယ်သောတန်ဆာဖြစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="23" style="v" />ထိုအခါ သင်သည် သင်၏လမ်းခရီးတွင် ဘေးကင်းလုံခြုံစွာသွားလာရ၍ သင်၏ခြေသည် ခလုတ်တိုက်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />သင်အိပ်သောအခါ ကြောက်ရွံ့ခြင်းမရှိရ။ သင်အိပ်သောအခါ နှစ်ခြိုက်စွာအိပ်စက်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="25" style="v" />ရုတ်တရက်ကျရောက်တတ်သော ကြောက်မက်ဖွယ်ဘေးကိုလည်းကောင်း၊ ဆိုးယုတ်သောသူတို့အပေါ်ကျရောက်တတ်သော ဖျက်ဆီးခြင်းဘေးကိုလည်းကောင်း ကြောက်ရွံ့ခြင်းမရှိနှင့်။
  </para>
  <para style="p">
    <verse number="26" style="v" />အကြောင်းမူကား ထာဝရဘုရားသည် သင်ယုံကြည်အားထားရာဖြစ်၍ သင်၏ခြေကို ကျော့ကွင်း၌မမိစေရန် စောင့်ထိန်းတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />သင့်လက်ထဲ၌ ကောင်းကျိုးပြုနိုင်စွမ်းရှိလျက်နှင့် ထိုကောင်းကျိုးကိုခံထိုက်သောသူတို့အား မပြုပေးဘဲမနေနှင့်။
  </para>
  <para style="p">
    <verse number="28" style="v" />သင်၌အဆင်သင့်ရှိလျက်နှင့် သင်၏အိမ်နီးချင်းအား “သွားလော့။ နောက်တစ်ဖန်ပြန်လာလော့။ မနက်ဖြန်မှ ငါပေးမည်”ဟု မပြောနှင့်။
  </para>
  <para style="p">
    <verse number="29" style="v" />သင့်အနီးတွင် ဘေးကင်းလုံခြုံစွာနေထိုင်သော သင်၏အိမ်နီးချင်းအပေါ် မကောင်းမှုပြုရန် တွေးတောကြံစည်ခြင်းမရှိနှင့်။
  </para>
  <para style="p">
    <verse number="30" style="v" />သင့်အပေါ် မကောင်းမှုမပြုသောသူကို အကြောင်းမဲ့ရန်မတွေ့နှင့်။
  </para>
  <para style="p">
    <verse number="31" style="v" />ရက်စက်ကြမ်းကြုတ်သောသူကိုမငြူစူနှင့်။ သူပြုမူကျင့်ကြံသောအမှုအရာတစ်စုံတစ်ခုကိုမျှ မရွေးချယ်နှင့်။
  </para>
  <para style="p">
    <verse number="32" style="v" />အကြောင်းမူကား သွေဖည်လွဲမှားသောသူတို့ကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ ဖြောင့်မှန်သောသူတို့နှင့်ကား ရင်းနှီးကျွမ်းဝင်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />ထာဝရဘုရား၏ကျိန်ခြင်းသည် ဆိုးယုတ်သောသူ၏အိမ်ပေါ်သို့သက်ရောက်၏။ သို့သော် ကိုယ်တော်သည် ဖြောင့်မတ်သောသူတို့၏အိမ်ကို ကောင်းချီးပေးတော်မူ၏။
  </para>
  <para style="p">
    <verse number="34" style="v" />ကိုယ်တော်သည် ပြက်ရယ်ပြုတတ်သောသူတို့ကို ပြက်ရယ်ပြုတော်မူ၏။ စိတ်နှိမ့်ချသောသူတို့ကိုကား ကျေးဇူးတော်ခံစားစေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="35" style="v" />ပညာရှိသောသူတို့သည် ဂုဏ်သရေကို အမွေဆက်ခံရကြလိမ့်မည်။ မိုက်မဲသောသူတို့မူကား အရှက်ကွဲကြရလိမ့်မည်။
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />သားသမီးတို့၊ ဖခင်၏ဆုံးမပဲ့ပြင်ခြင်းကိုနားထောင်ကြလော့။ အသိဉာဏ်ကိုရရှိရန် အာရုံစိုက်ကြလော့။
  </para>
  <para style="p">
    <verse number="2" style="v" />အကြောင်းမူကား ငါသည် သင်တို့အား ကောင်းမြတ်သောပညာကို ပေး၏။ ငါ၏သွန်သင်ချက်ကို မစွန့်ပယ်ကြနှင့်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ငါသည် ငါ့ဖခင်အတွက် သားတစ်ဦးဖြစ်ပြီး ငါ့မိခင်ရှေ့၌ နုနယ်သည့်တစ်ဦးတည်းသောသားဖြစ်စဉ်က
  </para>
  <para style="p">
    <verse number="4" style="v" />ငါ၏ဖခင်သည် ငါ့ကိုသွန်သင်လျက် မြွက်ဆိုသည်မှာ “ငါ့စကားတို့ကို သင်၏စိတ်နှလုံးထဲ၌ စွဲမှတ်ထားလော့။ ငါ၏ပညတ်ချက်တို့ကိုစောင့်ထိန်း၍ အသက်ရှင်လော့။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဉာဏ်ပညာကိုဆည်းပူးလော့။ အသိဉာဏ်ကိုဆည်းပူးလော့။ ငါ၏နှုတ်ထွက်စကားတို့ကို မမေ့လျော့နှင့်။ ၎င်းတို့မှသွေဖည်မသွားနှင့်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဉာဏ်ပညာကို မစွန့်ပယ်နှင့်။ ၎င်းသည် သင့်ကိုစောင့်ထိန်းလိမ့်မည်။ ဉာဏ်ပညာကိုချစ်လော့။ ၎င်းသည် သင့်ကို ကာကွယ်စောင့်ရှောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဉာဏ်ပညာသည် အထွတ်အမြတ်ဖြစ်၏ ။ ဉာဏ်ပညာကိုဆည်းပူးလော့။ သင်ပိုင်ဆိုင်သောအရာရှိသမျှဖြင့် အသိဉာဏ်ကိုဆည်းပူးလော့။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဉာဏ်ပညာကိုမြတ်နိုးလော့။ ၎င်းသည် သင့်ကို ချီးမြှောက်လိမ့်မည်။ ဉာဏ်ပညာကိုပွေ့ဖက်လျှင် ၎င်းသည် သင့်ကိုဂုဏ်ပြုချီးမွမ်းလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />၎င်းသည် တင့်တယ်သောပန်းဦးရစ်ကို သင်၏ခေါင်းပေါ်၌တင်ပေး၍ ဂုဏ်ကျက်သရေရှိသောသရဖူကို သင့်အား အပ်နှင်းလိမ့်မည်။”
  </para>
  <para style="p">
    <verse number="10" style="v" />ငါ့သား၊ နားထောင်လော့။ ငါ့စကားကိုခံယူလော့။ သို့ပြုလျှင် သင့်အသက်တာ၏နှစ်ကာလတို့သည် များပြားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ငါသည် သင့်အား ဉာဏ်ပညာလမ်းကို သွန်သင်ပြသ၍ ဖြောင့်မှန်သောလမ်းများထဲ၌ သင့်ကိုဦးဆောင်လမ်းပြခဲ့ပြီ။
  </para>
  <para style="p">
    <verse number="12" style="v" />သင်လမ်းလျှောက်သောအခါ သင်၏ခြေလှမ်းသည် တားဆီးနှောင့်ယှက်ခြင်းခံရလိမ့်မည်မဟုတ်။ သင်ပြေးသောအခါလည်း ခလုတ်တိုက်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဆုံးမပဲ့ပြင်ခြင်းကိုဆုပ်ကိုင်ထားလော့။ လွတ်မသွားစေနှင့်။ ၎င်းကိုထိန်းသိမ်းစောင့်ရှောက်လော့။ အကြောင်းမူကား ၎င်းသည် သင်၏အသက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဆိုးယုတ်သောသူတို့၏လမ်းထဲသို့ မဝင်နှင့်။ မကောင်းမှုပြုသောသူတို့သွားရာလမ်းကိုလည်း မလိုက်နှင့်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ထိုလမ်းကိုရှောင်လော့။ ဖြတ်မသွားနှင့်။ ထိုလမ်းမှဖယ်ခွာ၍ဆက်သွားလော့။
  </para>
  <para style="p">
    <verse number="16" style="v" />အကြောင်းမူကား သူတို့သည် ဆိုးညစ်သောအမှုကိုမပြုရလျှင် အိပ်မပျော်နိုင်ကြ။ တစ်စုံတစ်ဦးကိုခလုတ်တိုက်အောင်မပြုရလျှင် မအိပ်စက်နိုင်ကြ။
  </para>
  <para style="p">
    <verse number="17" style="v" />အကယ်စင်စစ် သူတို့သည် ဆိုးယုတ်ခြင်းမုန့်ကိုစား၍ ရက်စက်ကြမ်းကြုတ်ခြင်းစပျစ်ဝိုင်ကို သောက်ကြ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />သို့သော် ဖြောင့်မတ်သောသူတို့၏လမ်းသည် မိုးစင်စင်လင်းသည့်တိုင်အောင် ပို၍ပို၍ထွန်းလင်းလာသည့် အရုဏ်ဦး၏အလင်းရောင်ကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဆိုးယုတ်သောသူတို့၏လမ်းသည် မှောင်မိုက်ကဲ့သို့ဖြစ်၍ သူတို့သည် မည်သည့်အရာနှင့်ခလုတ်တိုက်မိသည်ကို မသိကြ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ငါ့သား၊ ငါပြောဆိုသောအရာတို့ကို အာရုံစိုက်နားထောင်လော့။ ငါ့စကားတို့ကို နားစွင့်လော့။
  </para>
  <para style="p">
    <verse number="21" style="v" />ထိုစကားတို့ကို သင်၏မျက်မှောက်မှ မကွာစေနှင့်။ သင်၏စိတ်နှလုံးအတွင်း၌ ထိန်းသိမ်းထားလော့။
  </para>
  <para style="p">
    <verse number="22" style="v" />အကြောင်းမူကား ထိုစကားတို့သည် ၎င်းတို့ကိုတွေ့ရှိသောသူတို့အတွက် အသက်ဖြစ်ပြီး သူတို့၏ကိုယ်ခန္ဓာတစ်ခုလုံးကို ကျန်းမာစေတတ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />သင်၏စိတ်နှလုံးကို သတိဝီရိယရှိသမျှနှင့် ထိန်းသိမ်းစောင့်ရှောက်လော့။ အကြောင်းမူကား ၎င်းသည် အသက်၏အရင်းအမြစ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ကောက်ကျစ်သောနှုတ်ကို သင့်ထံမှဖယ်ရှားလော့။ စဉ်းလဲသောနှုတ်ခမ်းကိုလည်း သင်နှင့်ဝေးကွာစေလော့။
  </para>
  <para style="p">
    <verse number="25" style="v" />သင်၏မျက်စိသည် ရှေ့သို့စေ့စေ့ကြည့်ပါစေ။ သင်၏မျက်လွှာသည်လည်း သင့်ရှေ့တည့်တည့်အာရုံပြုပါစေ။
  </para>
  <para style="p">
    <verse number="26" style="v" />သင်လျှောက်ရာလမ်း ကိုချင့်ချိန်သုံးသပ်လော့။ သို့ပြုလျှင် သင်၏လမ်းခရီးရှိသမျှတို့သည် တည်မြဲလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />လက်ယာဘက်၊ လက်ဝဲဘက်သို့ မလှည့်နှင့်။ သင်၏ခြေကို မကောင်းမှုမှ ဖယ်ခွာစေလော့။
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါ့သား၊ ငါ၏ဉာဏ်ပညာကို အာရုံစိုက်နားထောင်၍ ငါ၏ထိုးထွင်းဉာဏ်ကိုနားစွင့်လော့။
  </para>
  <para style="p">
    <verse number="2" style="v" />သို့ပြုလျှင် သင်သည် အလိမ္မာဉာဏ်ကိုစောင့်ထိန်းနိုင်၍ သင်၏နှုတ်ခမ်းသည် အသိပညာကို ထိန်းသိမ်းစောင့်ရှောက်နိုင်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />အကြောင်းမူကား အကျင့်ဖောက်ပြားသောမိန်းမ၏နှုတ်ခမ်းမှ ပျားရည်ယိုစီး၍ သူ၏နှုတ်သည် ဆီထက်ချောမွေ့၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />သို့သော် နောက်ဆုံး၌ သူသည် ဒေါနကဲ့သို့ခါး၍ အသွားနှစ်ဖက်ပါသောသန်လျက်ကဲ့သို့ ထက်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />သူ၏ခြေသည် သေခြင်းသို့ဆင်းသွား၍ သူ၏ခြေလှမ်းတို့သည် မရဏာနိုင်ငံသို့ ဦးတည်လျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />သူသည် အသက်ရှင်ခြင်းလမ်းကို ချင့်ချိန်သုံးသပ်ခြင်းမရှိ။ သူ၏လမ်းတို့သည် ဦးတည်ရာမဲ့ဖြစ်နေသည်ကို သူမသိ။
  </para>
  <para style="p">
    <verse number="7" style="v" />သို့ဖြစ်၍ ငါ့သားတို့၊ ငါ့စကားကိုနားထောင်ကြလော့။ ငါ၏နှုတ်ထွက်စကားတို့မှလည်း ဖယ်ခွာမသွားကြနှင့်။
  </para>
  <para style="p">
    <verse number="8" style="v" />သင်၏လမ်းကို ထိုသို့သောမိန်းမနှင့် ဝေးကွာစေလော့။ သူ၏အိမ်တံခါးအနီးသို့လည်း မချဉ်းကပ်နှင့်။
  </para>
  <para style="p">
    <verse number="9" style="v" />သို့မဟုတ်လျှင် သင်သည် သင်၏ဂုဏ်သိက္ခာကို သူတစ်ပါးတို့အားလည်းကောင်း၊ သင်၏နှစ်ကာလများကို ရက်စက်သောသူအားလည်းကောင်း ပေးအပ်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />သူစိမ်းတို့သည် သင်၏စည်းစိမ်များနှင့် ပြည့်စုံကြွယ်ဝကြ၍ သင်ခက်ခဲပင်ပန်းစွာရှာထားသောအရာတို့သည် တစ်ပါးအမျိုးသား၏အိမ်သို့ ရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />နောက်ဆုံး၌ သင်၏အသွေးအသားနှင့် သင်၏ကိုယ်ခန္ဓာသည် ပျက်စီးသောအခါ သင်သည် ညည်းတွားလျက်
  </para>
  <para style="p">
    <verse number="12" style="v" />“ငါသည် ဆုံးမပဲ့ပြင်ခြင်းကိုမုန်း၍ ငါ၏စိတ်နှလုံးသည် ဆိုဆုံးမစကားကို မထီလေးစားပြုခဲ့၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ငါ့ဆရာတို့၏စကားကိုလည်း နားမထောင်၊ ငါ့ကိုသင်ကြားပေးသောသူတို့ကိုလည်း နားစွင့်ခြင်းမရှိခဲ့ပေ။
  </para>
  <para style="p">
    <verse number="14" style="v" />ငါသည် လူအစုအဝေးနှင့်လူထုပရိသတ်အလယ်၌ လုံးလုံးပျက်စီးသောသူဖြစ်လုနီးပြီတကား”ဟု ဆိုလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />သင်၏ရေလှောင်တွင်းထဲမှရေ၊ သင်၏ရေတွင်းထဲမှထွက်သောရေကို သောက်လော့။
  </para>
  <para style="p">
    <verse number="16" style="v" />သင်၏စမ်းရေများကို လမ်းပေါ်သို့လျှံထွက်စေ၍ လမ်းမများကို ရေစီးသောချောင်းများဖြစ်စေရသလော။
  </para>
  <para style="p">
    <verse number="17" style="v" />၎င်းတို့ကို သင်တစ်ဦးတည်းအတွက်သာ ဖြစ်စေလော့။ သင့်ထံ၌ရှိသောသူစိမ်းများအတွက် မဖြစ်စေနှင့်။
  </para>
  <para style="p">
    <verse number="18" style="v" />သင်၏စမ်းရေတွင်းသည် မင်္ဂလာရှိပါစေ။ သင်ပျိုရွယ်စဉ်ကတည်းကပေါင်းဖက်ခဲ့သောမယား၌ ဝမ်းမြောက်ပါစေ။
  </para>
  <para style="p">
    <verse number="19" style="v" />သူသည် ချစ်ဖွယ်ကောင်းသောသမင်မ၊ တင့်တယ်သောဒရယ်မကဲ့သို့ဖြစ်၏။ သူ၏သားမြတ်သည် သင့်ကိုအစဉ်အမြဲ ကျေနပ်အားရစေ၍ သူ၏အချစ်၌ သင်သည် အစဉ်မပြတ်ယစ်မူးပါစေ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ငါ့သား၊ သင်သည် အဘယ်ကြောင့် အကျင့်ဖောက်ပြားသောမိန်းမနှင့်ယစ်မူး၍ ကိုယ်ကျင့်တရားပျက်ပြားသောမိန်းမ၏ရင်ကို ပွေ့ဖက်ရသနည်း။
  </para>
  <para style="p">
    <verse number="21" style="v" />အကယ်စင်စစ် လူသွားရာလမ်းတို့သည် ထာဝရဘုရား၏မျက်မှောက်တော်၌ရှိ၍ ကိုယ်တော်သည် သူ၏လမ်းရှိသမျှတို့ကို ချင့်ချိန်သုံးသပ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဆိုးယုတ်သောသူသည် မိမိဒုစရိုက်များဖြင့် ဖမ်းဆီးခြင်းခံရ၍ မိမိအပြစ်ကြိုးများဖြင့် ချည်နှောင်ခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သူသည် ဆုံးမပဲ့ပြင်ခြင်းမခံရသောကြောင့် သေရလိမ့်မည်။ သူ၏ကြီးမားသောမိုက်မဲမှုကြောင့် လမ်းလွဲသွားရလိမ့်မည်။
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါ့သား၊ သင်သည် သင်၏အိမ်နီးချင်းအတွက် အာမခံမိ၍ သူစိမ်းအတွက် တာဝန်ခံမိလျှင်
  </para>
  <para style="p">
    <verse number="2" style="v" />ကိုယ့်နှုတ်ထွက်စကားနှင့်ကိုယ်ကျော့မိ၍ ကိုယ့်နှုတ်ထွက်စကားနှင့်ကိုယ် အဖမ်းခံရလေပြီ။
  </para>
  <para style="p">
    <verse number="3" style="v" />ယခုသင်သည် သင်၏အိမ်နီးချင်းလက်သို့ ကျရောက်လေပြီ။ ထို့ကြောင့် ငါ့သား၊ ဤသို့ပြု၍ ကိုယ့်ကိုယ်ကိုယ်ကယ်နုတ်လော့။ သင်၏အိမ်နီးချင်းထံသွား၍ ကိုယ့်ကိုယ်ကိုယ် နှိမ့်ချလျက် ကြပ်ကြပ်တောင်းပန်လော့။
  </para>
  <para style="p">
    <verse number="4" style="v" />သင့်မျက်စိကို အိပ်စက်ခွင့်မပြုနှင့်။ သင့်မျက်လွှာကိုလည်း ပိတ်ခွင့်မပြုနှင့်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဒရယ်သည် အမဲလိုက်သူလက်မှလည်းကောင်း၊ ငှက်သည် ငှက်မုဆိုးလက်မှလည်းကောင်း လွတ်မြောက်သကဲ့သို့ ကိုယ့်ကိုယ်ကိုယ်လွတ်မြောက်အောင်ပြုလော့။
  </para>
  <para style="p">
    <verse number="6" style="v" />အချင်းလူပျင်း၊ ပုရွက်ဆိတ်ထံသို့သွား၍ ၎င်း၏လုပ်ဆောင်မှုတို့ကိုကြည့်ရှုဆင်ခြင်လျက် ဉာဏ်ပညာရှိလော့။
  </para>
  <para style="p">
    <verse number="7" style="v" />ပုရွက်ဆိတ်သည် ဦးစီးဦးဆောင်သူမရှိ၊ ကြီးကြပ်သူမရှိ၊ အုပ်စိုးသူလည်းမရှိဘဲလျက်
  </para>
  <para style="p">
    <verse number="8" style="v" />နွေရာသီ၌ မိမိအစားအစာကိုပြင်ဆင်၍ ရိတ်သိမ်းချိန်၌ မိမိစားစရာကို ရှာဖွေစုဆောင်းတတ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />အချင်းလူပျင်း၊ သင်သည် မည်မျှကြာအောင် အိပ်လျက်နေမည်နည်း။ မည်သည့်အချိန်မှ အိပ်ရာထမည်နည်း။
  </para>
  <para style="p">
    <verse number="10" style="v" />ခဏအိပ်လျက်၊ ခဏငိုက်လျက်၊ ခဏလက်ပိုက်အနားယူလျက်နေစဉ်
  </para>
  <para style="p">
    <verse number="11" style="v" />ဆင်းရဲခြင်းသည် သူခိုးဓားပြကဲ့သို့လည်းကောင်း၊ ချို့တဲ့နွမ်းပါးခြင်းသည် လက်နက်ကိုင်ဆောင်သူကဲ့သို့လည်းကောင်း သင့်ထံသို့ရောက်လာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဆိုးညစ်သောသူနှင့် ယုတ်ညံ့သောသူသည် ကောက်ကျစ်သောနှုတ်ဖြင့်လှည့်လည်သွားလာကာ
  </para>
  <para style="p">
    <verse number="13" style="v" />မျက်စိကိုမှိတ်ပြလျက်၊ ခြေဖြင့်အမှတ်ပြုလျက်၊ လက်ချောင်းတို့ဖြင့်အချက်ပေးလျက်၊
  </para>
  <para style="p">
    <verse number="14" style="v" />ဖောက်ပြန်လွဲမှားသောစိတ်နှလုံးဖြင့် မကောင်းမှုကိုတွေးတောကြံစည်လျက် ငြင်းခုံရန်တွေ့ခြင်းကို အစဉ်အမြဲဖြစ်ပွားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ထို့ကြောင့် ဘေးဒုက္ခသည် သူ့အပေါ်ရုတ်တရက်ကျရောက်သဖြင့် သူသည် ချမ်းသာရာမရဘဲ ချက်ချင်းပျက်စီးရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ထာဝရဘုရားမုန်းတော်မူသောအရာခြောက်ပါးမက ကိုယ်တော်၏စိတ်ဝိညာဉ် စက်ဆုပ်ရွံရှာတော်မူသောအရာခုနစ်ပါးမှာ
  </para>
  <para style="p">
    <verse number="17" style="v" />ထောင်လွှားသောမျက်နှာ၊ မုသားသုံးသောလျှာ၊ အပြစ်ကင်းသောသူကိုသတ်ဖြတ်သောလက်၊
  </para>
  <para style="p">
    <verse number="18" style="v" />ယုတ်ညံ့သောအကြံအစည်များကို တွေးတောကြံစည်သောစိတ်နှလုံး၊ မကောင်းမှုပြုရာသို့ အလျင်အမြန်ပြေးသောခြေ၊
  </para>
  <para style="p">
    <verse number="19" style="v" />လိမ်လည်ထွက်ဆိုသောမုသားသက်သေနှင့် ညီအစ်ကိုတို့ကြား၌ အငြင်းပွားမှုများဖြစ်ပွားစေသော သူတို့ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ငါ့သား၊ သင့်ဖခင်၏ပညတ်ချက်ကို လိုက်နာကျင့်သုံးလော့။ သင့်မိခင်၏သွန်သင်ချက်ကို မပစ်ပယ်နှင့်။
  </para>
  <para style="p">
    <verse number="21" style="v" />၎င်းတို့ကို သင်၏စိတ်နှလုံးတွင် အစဉ်မပြတ်ချည်ထား၍ သင်၏လည်ပင်း၌ဆွဲထားလော့။
  </para>
  <para style="p">
    <verse number="22" style="v" />၎င်းတို့သည် သင်သွားလာသောအခါ သင့်ကိုပို့ဆောင်လိမ့်မည်။ သင်အိပ်သောအခါ သင့်ကိုစောင့်ရှောက်လိမ့်မည်။ သင်နိုးသောအခါ သင့်ကိုစကားပြောလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="23" style="v" />အကြောင်းမူကား ပညတ်ချက်သည် မီးခွက်ဖြစ်၍ သွန်သင်ချက်သည် အလင်းဖြစ်၏။ ဆုံးမပဲ့ပြင်ပေးသောဆိုဆုံးမစကားတို့သည်လည်း အသက်လမ်းဖြစ်၍
  </para>
  <para style="p">
    <verse number="24" style="v" />မကောင်းသောမိန်းမ၏ဘေးရန်မှလည်းကောင်း၊ ကိုယ်ကျင့်တရားပျက်ပြားသောမိန်းမ၏ချော့မြှူသောစကားမှလည်းကောင်း သင့်ကိုစောင့်ရှောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="25" style="v" />သင်၏စိတ်နှလုံးထဲတွင် ထိုမိန်းမ၏အလှကို မတပ်မက်နှင့်။ သူ့မျက်လွှာဖြင့် ညှို့ယူဖမ်းစားခြင်းကိုမခံနှင့်။
  </para>
  <para style="p">
    <verse number="26" style="v" />အကြောင်းမူကား ပြည့်တန်ဆာမတစ်ယောက်ကို မုန့်တစ်လုံးဖြင့်ရနိုင်၏။ လင်ရှိမယားမူကား အဖိုးတန်သောအသက်ကို လိုက်ဖမ်းတတ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />လူသည် မိမိအဝတ်ကို မလောင်စေဘဲ မိမိရင်ခွင်၌ မီးကိုပွေ့ပိုက်နိုင်မည်လော။
  </para>
  <para style="p">
    <verse number="28" style="v" />သို့မဟုတ် သူသည် မိမိခြေကို မလောင်မြိုက်စေဘဲ မီးခဲပေါ်တွင် လမ်းလျှောက်နိုင်မည်လော။
  </para>
  <para style="p">
    <verse number="29" style="v" />မိမိအိမ်နီးချင်း၏မယားထံသို့ ဝင်သောသူသည်လည်း ထိုနည်းတူဖြစ်၏။ ထိုမိန်းမနှင့်ထိတွေ့သောသူမှန်သမျှ အပြစ်ဒဏ်နှင့်ကင်းလွတ်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />သူခိုးသည် ဆာလောင်မွတ်သိပ်သောကြောင့် အငတ်ပြေစေရန် ခိုးယူခဲ့လျှင် လူတို့သည် သူ့ကိုမထီမဲ့မြင်ပြုကြမည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />သို့သော် သူသည် အဖမ်းခံရလျှင် ခုနစ်ဆပြန်လျော်ရမည်။ မိမိအိမ်၌ရှိသောစည်းစိမ်ဥစ္စာအားလုံးကိုပင် ပေးရမည်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />သူတစ်ပါး၏မယားနှင့် အိမ်ထောင်ရေးဖောက်ပြန်သောသူသည် အသိစိတ်မရှိ။ ထိုအမှုကိုပြုသောသူသည် ကိုယ့်ကိုယ်ကိုယ်ဖျက်ဆီးသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />ထိုသူသည် ရိုက်နှက်ခြင်းနှင့် အရှက်ခွဲခြင်းကိုခံရလိမ့်မည်။ သူခံရသောကဲ့ရဲ့ပြစ်တင်ခြင်းသည်လည်း မည်သည့်အခါမျှပျောက်ပျက်သွားမည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="34" style="v" />အကြောင်းမူကား သဝန်တိုမှုသည် ခင်ပွန်းသည်ကို အမျက်ဒေါသထွက်စေသဖြင့် သူသည် လက်စားချေသောနေ့၌ ညှာတာလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="35" style="v" />မည်သည့်လျော်ကြေးကိုမျှ လက်ခံလိမ့်မည်မဟုတ်။ များစွာသောတံစိုးလက်ဆောင်ကိုလည်း အလိုရှိလိမ့်မည်မဟုတ်။
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါ့သား၊ ငါ့စကားတို့ကိုစောင့်ထိန်း၍ ငါ၏ပညတ်ချက်တို့ကို သင့်အထဲ၌သိုမှီးထားလော့။
  </para>
  <para style="p">
    <verse number="2" style="v" />ငါ၏ပညတ်ချက်တို့ကိုစောင့်ထိန်း၍ အသက်ရှင်လော့။ ငါ၏သွန်သင်ချက်ကို သင်၏မျက်စိသူငယ်အိမ်ကဲ့သို့ စောင့်ထိန်းလော့။
  </para>
  <para style="p">
    <verse number="3" style="v" />၎င်းတို့ကို သင်၏လက်ချောင်းတို့တွင်ချည်ထား၍ သင်၏နှလုံးသားပြင်၌ ရေးထားလော့။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဉာဏ်ပညာအား “သင်သည် ငါ၏အစ်မဖြစ်သည်”ဟု ဆို၍ အသိဉာဏ်အား “ဆွေမျိုးသားချင်း”ဟု ခေါ်လော့။
  </para>
  <para style="p">
    <verse number="5" style="v" />သို့ပြုလျှင် ၎င်းတို့သည် အကျင့်ဖောက်ပြားသောမိန်းမ၏ ဘေးရန်မှလည်းကောင်း၊ စကားများဖြင့်မြှူဆွယ်တတ်သည့် ကိုယ်ကျင့်တရားပျက်ပြားသောမိန်းမ၏ ဘေးရန်မှလည်းကောင်း သင့်ကိုစောင့်ရှောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ငါသည် ငါ၏အိမ်ပြတင်းပေါက်ရာဇမတ်ကွက်ကြားမှ မျှော်ကြည့်သောအခါ
  </para>
  <para style="p">
    <verse number="7" style="v" />အသိဉာဏ်နည်းပါးသောသူများကြားတွင် အသိစိတ်မရှိသောလုလင်တစ်ဦးကို ငါမြင်၍ လူငယ်များအလယ်တွင် သူ့ကိုသတိပြုမိ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ထိုသူသည် မိန်းမတစ်ဦးနေထိုင်ရာ လမ်းထောင့်နားမှဖြတ်သွား၍ ထိုမိန်းမ၏အိမ်ရှိရာလမ်းသို့လျှောက်သွားလေ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />အချိန်ကား မှောင်ရီပျိုးချိန်၊ နေဝင်ချိန်၊ ညသန်းခေါင်အချိန်နှင့် မှောင်မိုက်သောအချိန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ထိုအခါ ပြည့်တန်ဆာအဝတ်ကိုဝတ်၍ စိတ်နှလုံးထဲ၌ လျှို့ဝှက်သောအကြံရှိသည့်မိန်းမသည် သူ့ကိုကြိုဆိုလေ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ထိုမိန်းမသည် အာကျယ်၍ခေါင်းမာ၏။ ခြေမငြိမ်၊ အိမ်မကပ်၊
  </para>
  <para style="p">
    <verse number="12" style="v" />ယခုပင် အပြင်၌၊ ယခုပင် လမ်းဆုံ၌ရှိလျက် လမ်းထောင့်ရှိသမျှတို့၌ ချောင်းမြောင်းနေတတ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူသည် ထိုလုလင်ကိုဆွဲ၍ နမ်းပြီးလျှင်
  </para>
  <para style="p">
    <verse number="14" style="v" />“ကျွန်မသည် မိတ်သဟာယယဇ်များပူဇော်ရန်ရှိ၍ ယနေ့ပင် ကျွန်မ၏ကတိသစ္စာတို့ကို ပြည့်စုံစေပါပြီ။
  </para>
  <para style="p">
    <verse number="15" style="v" />ထို့ကြောင့် သင့်ကိုကြိုဆိုရန် ထွက်လာ၏။ သင့်ကိုကြိုးစားရှာ၍ ယခုတွေ့ပါပြီ။
  </para>
  <para style="p">
    <verse number="16" style="v" />ကျွန်မ၏ခုတင်ကို အီဂျစ်ပြည်ဖြစ် ရောင်စုံပိတ်ချောအိပ်ရာခင်းဖြင့်ခင်းထား၍
  </para>
  <para style="p">
    <verse number="17" style="v" />ကျွန်မ၏အိပ်ရာကို မုရန်၊ သစ်မွှေးနှင့် သစ်ကြံပိုးနံ့သာတို့ဖြင့် ထုံသင်းမွှေးကြိုင်စေပါပြီ။
  </para>
  <para style="p">
    <verse number="18" style="v" />လာပါ။ မိုးလင်းသည်အထိ ချစ်တင်းနှော၍ ချစ်ကြိုက်ပျော်ပါးကြစို့။
  </para>
  <para style="p">
    <verse number="19" style="v" />အကြောင်းမူကား ကျွန်မ၏ခင်ပွန်းသည် အိမ်မှာမရှိ။ ရပ်ဝေးသို့ ခရီးသွားနေ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ငွေအိတ်ကိုပါ ယူဆောင်သွား၏။ လပြည့်နေ့မှ အိမ်သို့ပြန်လာမည်”ဟု ထိုလုလင်အား မျက်နှာပြောင်တိုက်ပြောဆို၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ထိုမိန်းမသည် ဆွဲဆောင်သောစကားများစွာတို့ဖြင့် သူ့ကိုမြှူဆွယ်၍ မိမိနှုတ်ခမ်းမှ ချိုသာသောစကားဖြင့် သူ့ကိုသွေးဆောင်လေရာ
  </para>
  <para style="p">
    <verse number="22" style="v" />နွားသည် အသတ်ခံရမည့်နေရာသို့ လိုက်သွားသကဲ့သို့လည်းကောင်း၊ ဆိုးမိုက်သောသူသည် မိမိအသည်းကို မြားစူးဝင်သည့်တိုင်အောင် အပြစ်ဒဏ်ခံရာသို့ ခြေချင်းခတ်ခံရလျက်သွား သကဲ့သို့လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="23" style="v" />ငှက်သည် ကျော့ကွင်းထဲသို့ အလျင်အမြန်ဝင်သွားသကဲ့သို့လည်းကောင်း သူသည် ထိုမိန်းမနောက်သို့ ချက်ချင်းလိုက်သွားလေ၏။ ထိုအမှုသည် သူ့အသက်ကိုဆုံးရှုံးစေနိုင်ကြောင်းကို သူမသိပေ။
  </para>
  <para style="p">
    <verse number="24" style="v" />သို့ဖြစ်၍ ငါ့သားတို့၊ ငါ့စကားကိုနားထောင်ကြလော့။ ငါ၏နှုတ်ထွက်စကားတို့ကိုလည်း အာရုံစိုက်နားထောင်ကြလော့။
  </para>
  <para style="p">
    <verse number="25" style="v" />သင်၏စိတ်နှလုံးကို ထိုမိန်းမ၏လမ်းများဘက်သို့ မလှည့်စေနှင့်။ လမ်းလွဲ၍ သူသွားရာလမ်းများထဲသို့ မသွားနှင့်။
  </para>
  <para style="p">
    <verse number="26" style="v" />အကြောင်းမူကား သူသည် များစွာသောသူတို့ကိုဒဏ်ရာရစေ၍ လဲကျစေခဲ့၏။ သူ၏သတ်ဖြတ်ခြင်းခံရသောသူအားလုံးသည် အင်အားကြီးသောသူများဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />သူ၏အိမ်သည် သေခြင်း၏အတွင်းခန်းများသို့ ဆင်းသွားသည့် မရဏာနိုင်ငံသို့သွားရာလမ်းများဖြစ်၏။
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဉာဏ်ပညာသည် ဟစ်ခေါ်၍ ထိုးထွင်းဉာဏ်သည် မိမိ၏အသံကိုလွှင့်သည်မဟုတ်လော။
  </para>
  <para style="p">
    <verse number="2" style="v" />၎င်းသည် မြင့်သောအရပ်၏ထိပ်၊ လမ်းဘေး၊ လမ်းဆုံလမ်းခွတို့၌ရပ်လျက်
  </para>
  <para style="p">
    <verse number="3" style="v" />မြို့တံခါးတို့အနား၊ မြို့အဝင်ဝ၊ တံခါးတို့၏အပေါက်ဝ၌ ကြွေးကြော်သည်မှာ
  </para>
  <para style="p">
    <verse number="4" style="v" />အချင်းလူတို့၊ သင်တို့ကိုငါခေါ်၏။ ငါ့အသံကို လူသားတို့ထံသို့ ငါလွှင့်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />အသိဉာဏ်နည်းပါးသောသူတို့၊ ဆင်ခြင်ဉာဏ်ကို ရယူကြလော့။ မိုက်မဲသောသူတို့၊ အသိဉာဏ်ကို ရယူကြလော့။
  </para>
  <para style="p">
    <verse number="6" style="v" />နားထောင်ကြလော့။ အကြောင်းမူကား ငါသည် ကောင်းမြတ်သောအရာများကို ပြောဆိုမည်။ ငါ့နှုတ်မြွက်ဟသောအရာသည်လည်း ဟုတ်မှန်သောအရာများဖြစ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />အဘယ်ကြောင့်ဆိုသော် ငါ၏နှုတ်သည် သမ္မာတရားကိုပြောဆို၍ ငါ၏နှုတ်ခမ်းသည် ဆိုးယုတ်မှုကိုစက်ဆုပ်ရွံရှာ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ငါ၏နှုတ်ထွက်စကားရှိသမျှသည် ဖြောင့်မတ်၍ ၎င်းတို့တွင် ဉာဏ်များသောသဘော၊ ကောက်ကျစ်သောသဘောမရှိ။
  </para>
  <para style="p">
    <verse number="9" style="v" />ထိုစကားအားလုံးတို့သည် အသိဉာဏ်ရှိသောသူအတွက် မှန်ကန်၍ အသိပညာကိုတွေ့ရှိသောသူတို့အတွက် ဖြောင့်မှန်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ငွေအစား ငါ၏ဆုံးမပဲ့ပြင်ခြင်းကိုရယူကြလော့။ ရွှေစင်အစား အသိပညာကို ရယူကြလော့။
  </para>
  <para style="p">
    <verse number="11" style="v" />အကြောင်းမူကား ဉာဏ်ပညာသည် ပတ္တမြားတို့ထက်ကောင်းမြတ်၍ မည်သည့်နှစ်သက်ဖွယ်သောအရာနှင့်မျှ နှိုင်းယှဉ်၍မရနိုင်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ငါ ဉာဏ်ပညာသည် ဆင်ခြင်ဉာဏ်နှင့်အတူနေ၍ အလိမ္မာဉာဏ်နှင့်ဆိုင်သောအသိပညာကို ငါတွေ့၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် မကောင်းမှုကိုမုန်းတီးခြင်းဖြစ်၏။ မောက်မာထောင်လွှားခြင်းနှင့် မာနကြီးခြင်း၊ မကောင်းသောလမ်းနှင့် ဖောက်ပြန်လွဲမှားသောစကားကို ငါမုန်း၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ငါ၌ အကြံဉာဏ်နှင့် မှန်ကန်ပြည့်စုံသောဉာဏ်ရှိ၏။ ငါသည် အသိဉာဏ်ဖြစ်ပြီး ငါ၌အစွမ်းတန်ခိုးရှိ၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ငါ့အားဖြင့် ရှင်ဘုရင်တို့သည် စိုးစံရ၍ အုပ်ချုပ်သူတို့သည် ဖြောင့်မတ်သောလမ်းစဉ်ကို ပြဋ္ဌာန်းနိုင်ကြ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />အကြီးအကဲများ၊ မင်းအရာရှိများနှင့် ဖြောင့်မတ်စွာတရားစီရင်သောသူအားလုံးတို့သည် ငါ့အားဖြင့် အုပ်စိုးရကြ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ငါ့ကိုချစ်သောသူတို့ကို ငါချစ်၏။ ငါ့ကိုကြိုးစား၍ရှာသောသူတို့သည် ငါ့ကိုတွေ့ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဓနဥစ္စာနှင့်ဂုဏ်သရေ၊ တည်မြဲသောစည်းစိမ်ဥစ္စာနှင့် ဖြောင့်မတ်ခြင်းသည် ငါနှင့်အတူရှိ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ငါ၏အသီးအပွင့်သည် ရွှေထက်မက ရွှေစင်ထက်ပင် ပို၍ကောင်း၏။ ငါ့အားဖြင့်ရသောအမြတ်အစွန်းသည်လည်း ငွေစင်ထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ငါသည် ဖြောင့်မတ်ခြင်းလမ်း၊ တရားမျှတခြင်းလမ်း၏အလယ်၌ လျှောက်သွား၍
  </para>
  <para style="p">
    <verse number="21" style="v" />ငါ့ကိုချစ်သောသူတို့အား စည်းစိမ်ချမ်းသာကိုအမွေဆက်ခံစေလျက် သူတို့၏ဘဏ္ဍာတိုက်များကို ပြည့်စေ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ထာဝရဘုရားသည် ရှေးယခင် မိမိ၏အမှုတော်များကိုမစတင်မီ၊ မိမိလုပ်ဆောင်မှု၏အစအဦးကပင် ငါ့ကိုပိုင်သတော်မူ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ထာဝရကာလ၊ ကနဦးကာလ၊ မြေကြီးကိုမဖန်ဆင်းမီကာလကပင် ငါသည် ခန့်အပ်ထားခြင်းခံရပြီ။
  </para>
  <para style="p">
    <verse number="24" style="v" />နက်ရှိုင်းသောရေထုများမရှိမီ၊ ရေနှင့်ပြည့်လျှံသောစမ်းရေတွင်းများမဖြစ်ပေါ်မီ ငါ့ကိုဖြစ်တည်စေတော်မူပြီ။
  </para>
  <para style="p">
    <verse number="25" style="v" />တောင်များကိုမဖြစ်ပေါ်စေမီ၊ တောင်ကုန်းများမရှိမီ၊
  </para>
  <para style="p">
    <verse number="26" style="v" />မြေကြီး၊ ကွင်းပြင်များနှင့် ကမ္ဘာကြီး၏အဦးဆုံးသောမြေမှုန့်များကို ဖန်ဆင်းတော်မမူမီ ငါ့ကိုဖြစ်တည်စေတော်မူပြီ။
  </para>
  <para style="p">
    <verse number="27" style="v" />မိုးကောင်းကင်ကို ကိုယ်တော်တည်တော်မူသောအခါ ငါသည် ထိုအရပ်၌ရှိ၏။ နက်ရှိုင်းသောရေထု၏မျက်နှာပြင်ပေါ်တွင် မိုးကုပ်စက်ဝိုင်းကို အမှတ်အသားပြုတော်မူသောအခါ၌လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="28" style="v" />အထက်မိုးတိမ်တို့ကိုတည်စေတော်မူပြီး နက်ရှိုင်းသောရေထုထွက်လာရာအပေါက်များကို ခိုင်ခံ့စေတော်မူသောအခါ၌လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="29" style="v" />ရေသည် ကိုယ်တော်၏အမိန့်ကို မကျူးလွန်မည့်အကြောင်း ပင်လယ်၏နယ်နိမိတ်ကို သတ်မှတ်တော်မူသောအခါ၌လည်းကောင်း၊ ကမ္ဘာမြေကြီး၏အခြေအမြစ်တို့ကို အမှတ်အသားပြုတော်မူသောအခါ၌လည်းကောင်း
  </para>
  <para style="p">
    <verse number="30" style="v" />ငါသည် လက်မှုပညာရှင်ကဲ့သို့ ကိုယ်တော်၏အနားတွင်ရှိ၍ နေ့စဉ်နေ့တိုင်း ကိုယ်တော်၏ကြည်နူးတော်မူရာဖြစ်ခဲ့ပြီး ရှေ့တော်၌ အစဉ်အမြဲပျော်မြူး၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />ငါသည် ကိုယ်တော်၏ကမ္ဘာမြေကြီးတစ်ခုလုံးအတွက် ပျော်မြူး၍ လူသားတို့၌ ကြည်နူးလျက်နေ၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />သို့ဖြစ်၍ သားသမီးတို့၊ ငါ့စကားကိုနားထောင်ကြလော့။ ငါ၏လမ်းများကိုစောင့်ထိန်းသောသူတို့သည် မင်္ဂလာရှိကြ၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />ဆုံးမပဲ့ပြင်ခြင်းကိုနားထောင်၍ ဉာဏ်ပညာရှိကြလော့။ ၎င်းကိုလျစ်လျူမရှုကြနှင့်။
  </para>
  <para style="p">
    <verse number="34" style="v" />ငါ့စကားကိုနားထောင်၍ ငါ့တံခါးတို့အနားတွင် နေ့စဉ်နေ့တိုင်းစောင့်ကြည့်လျက် ငါ့တံခါးတိုင်တို့အနားတွင် စောင့်မျှော်လျက်နေသောသူသည် မင်္ဂလာရှိ၏။
  </para>
  <para style="p">
    <verse number="35" style="v" />အကြောင်းမူကား ငါ့ကိုတွေ့သောသူသည် အသက်ကိုတွေ့၍ ထာဝရဘုရားထံတော်မှ ကျေးဇူးတော်ကိုခံစားရ၏။
  </para>
  <para style="p">
    <verse number="36" style="v" />ငါနှင့်လွဲသွားသောသူမူကား ကိုယ့်ကိုယ်ကိုယ်အကျိုးနည်းစေ၏။ ငါ့ကိုမုန်းသောသူရှိသမျှတို့သည် သေခြင်းကိုချစ်ကြ၏။
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဉာဏ်ပညာသည် မိမိအိမ်ကို တည်ဆောက်လေပြီ။ တိုင်ခုနစ်တိုင်ကိုစိုက်ထူလေပြီ။
  </para>
  <para style="p">
    <verse number="2" style="v" />မိမိတိရစ္ဆာန်ကိုသတ်လေပြီ။ စပျစ်ဝိုင်ကိုရောစပ်၍ စားပွဲကိုတည်ခင်းလေပြီ။
  </para>
  <para style="p">
    <verse number="3" style="v" />မိမိအစေခံမိန်းကလေးများကိုစေလွှတ်ပြီး မြို့၏အမြင့်ဆုံးနေရာများမှနေ၍
  </para>
  <para style="p">
    <verse number="4" style="v" />“အသိဉာဏ်နည်းပါးသောသူမည်သူမဆို ဤနေရာသို့လှည့်လာပါစေ”ဟု ဟစ်ခေါ်၏။ အသိစိတ်မရှိသောသူအားလည်း
  </para>
  <para style="p">
    <verse number="5" style="v" />“လာလော့။ ငါ့မုန့်ကိုစား၍ ငါရောစပ်ထားသောစပျစ်ဝိုင်ကို သောက်လော့။
  </para>
  <para style="p">
    <verse number="6" style="v" />အသိဉာဏ်နည်းပါးခြင်းကိုစွန့်ပယ်၍ အသက်ရှင်လော့။ အသိဉာဏ်လမ်းကိုလိုက်လော့”ဟု ဆို၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ပြက်ရယ်ပြုတတ်သောသူကို ပဲ့ပြင်သောသူသည် အရှက်ခွဲခြင်းကိုခံရ၍ ဆိုးယုတ်သောသူကို ဆုံးမသောသူသည် ကိုယ်တိုင် အနာတရဖြစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ပြက်ရယ်ပြုတတ်သောသူကို မဆုံးမနှင့်။ ဆုံးမလျှင် သူသည် သင့်ကိုမုန်းလိမ့်မည်။ ပညာရှိသောသူကို ဆုံးမလော့။ သို့ပြုလျှင် သူသည် သင့်ကိုချစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ပညာရှိသောသူအား ပညာကိုပေးလော့။ သို့ပြုလျှင် သူသည် ပို၍ပညာရှိလာလိမ့်မည်။ ဖြောင့်မတ်သောသူကို သွန်သင်လော့။ သို့ပြုလျှင် သူသည် ပညာတိုးပွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် ဉာဏ်ပညာ၏မူလအစဖြစ်၏။ သန့်ရှင်းသောအရှင်ကိုသိသောဉာဏ်သည် အသိဉာဏ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />အကြောင်းမူကား ဉာဏ်ပညာအားဖြင့် သင်၏နေ့ရက်တို့သည် များပြား၍ သင့်အသက်တာ၏နှစ်ကာလတို့သည် ထပ်တိုးလာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />သင်သည် ဉာဏ်ပညာရှိလျှင် ထိုဉာဏ်ပညာရှိခြင်းသည် သင့်အတွက်ဖြစ်၏။ သင်သည် ပြက်ရယ်ပြုလျှင် သင်သာ ခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="13" style="v" />မိုက်မဲသောမိန်းမသည် အာကျယ်၍ ဉာဏ်တိမ်ပြီး မည်သည့်အရာကိုမျှမသိတတ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />သူသည် မိမိ၏အိမ်တံခါးဝ၌လည်းကောင်း၊ မြို့၏မြင့်သောအရပ်ရှိထိုင်ခုံပေါ်၌လည်းကောင်း ထိုင်လျက်
  </para>
  <para style="p">
    <verse number="15" style="v" />လမ်း၌ဖြတ်သန်းသွားလာသောသူများ၊ မိမိတို့လမ်းခရီးကို ဖြောင့်တန်းစွာသွားနေသောသူများအား
  </para>
  <para style="p">
    <verse number="16" style="v" />“အသိဉာဏ်နည်းပါးသောသူမည်သူမဆို ဤနေရာသို့လှည့်လာပါစေ”ဟု ဟစ်ခေါ်၏။ အသိစိတ်မရှိသောသူအားလည်း
  </para>
  <para style="p">
    <verse number="17" style="v" />“ခိုးသောက်သောရေသည် ချို၍ ဝှက်စားသောမုန့်သည် အရသာရှိ၏”ဟု ဆို၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />သို့ရာတွင် ထိုအရပ်၌ သေသူ၏ဝိညာဉ်များရှိကြသည်ကိုလည်းကောင်း၊ ထိုမိန်းမ၏ဧည့်သည်များသည် မရဏာနိုင်ငံ၏နက်ရာအရပ်များ၌ ရှိကြသည်ကိုလည်းကောင်း ထိုသူမသိချေ။
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />ရှောလမုန်၏သုတ္တံစကားများ။ ပညာရှိသောသားသည် ဖခင်ကိုဝမ်းမြောက်စေ၏။ မိုက်မဲသောသားမူကား သူ၏မိခင်အတွက် ပူဆွေးစရာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />မတရားသဖြင့်ရသောဥစ္စာဘဏ္ဍာသည် အကျိုးမရှိ။ ဖြောင့်မတ်ခြင်းမူကား သေခြင်းမှလွတ်မြောက်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ထာဝရဘုရားသည် ဖြောင့်မတ်သောသူကို ဆာလောင်မွတ်သိပ်စေတော်မမူ။ ဆိုးယုတ်သောသူတို့၏အလိုရမ္မက်ကိုကား ပယ်ချတော်မူ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />လုံ့လနည်းသောလက်သည် ဆင်းရဲခြင်းကိုဖြစ်စေ၏။ ဝီရိယရှိသောလက်မူကား ချမ်းသာကြွယ်ဝစေ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />နွေရာသီ၌ ရှာဖွေစုဆောင်းသောသူသည် ပညာသတိရှိသောသားဖြစ်၏။ ရိတ်သိမ်းချိန်၌ အိပ်မောကျနေသောသူမူကား အရှက်ကွဲစေသောသားဖြစ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဖြောင့်မတ်သောသူ၏ဦးခေါင်းပေါ်၌ ကောင်းချီးမင်္ဂလာများရှိ၏။ ဆိုးယုတ်သောသူတို့၏နှုတ်သည် ရက်စက်ကြမ်းကြုတ်မှုကိုဖုံးကွယ်တတ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဖြောင့်မတ်သောသူနှင့်ဆိုင်သောအောက်မေ့စရာသည် ကောင်းချီးမင်္ဂလာဖြစ်၏။ ဆိုးယုတ်သောသူ၏အမည်မူကား ပျောက်ပျက်သွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="8" style="v" />စိတ်နှလုံး၌ပညာရှိသောသူသည် ပညတ်ချက်တို့ကို လက်ခံတတ်၏။ နှုတ်ဖွာသည့် ဆိုးမိုက်သောသူကား ပျက်စီးခြင်းသို့ ရောက်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />တည်ကြည်စွာလျှောက်လှမ်းသောသူသည် ဘေးကင်းလုံခြုံစွာလျှောက်လှမ်းရလိမ့်မည်။ မိမိလမ်းတို့ကိုကွေ့ကောက်စေသောသူ၏ သဘောမူကား သိသာထင်ရှားလာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />မျက်စိမှိတ်ပြသောသူသည် ဝမ်းနည်းပူဆွေးမှုကိုဖြစ်ပေါ်စေတတ်၏။ နှုတ်ဖွာသည့် ဆိုးမိုက်သောသူကား ပျက်စီးခြင်းသို့ရောက်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဖြောင့်မတ်သောသူ၏နှုတ်သည် အသက်စမ်းရေတွင်းဖြစ်၏။ ဆိုးယုတ်သောသူ၏နှုတ်မူကား ရက်စက်ကြမ်းကြုတ်မှုကို ဖုံးကွယ်တတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />မုန်းတီးခြင်းသည် အငြင်းပွားမှုများဖြစ်စေရန် လှုံ့ဆော်တတ်၏။ ချစ်ခြင်းမေတ္တာမူကား ကျူးလွန်သောအပြစ်ရှိသမျှကို ဖုံးအုပ်တတ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />အသိဉာဏ်ရှိသောသူ၏နှုတ်ခမ်းတွင် ဉာဏ်ပညာကိုတွေ့ရ၏။ အသိစိတ်မရှိသောသူ၏ကျောကုန်းအတွက်မူကား ကြိမ်လုံးရှိ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ပညာရှိသောသူသည် အသိပညာကိုသိုမှီးတတ်၏။ ဆိုးမိုက်သောသူ၏နှုတ်မူကား ပျက်စီးခြင်းနှင့်နီးကပ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ချမ်းသာသောသူ၏စည်းစိမ်ဥစ္စာသည် သူ၏ခိုင်ခံ့သောမြို့ဖြစ်၏။ ဆင်းရဲသောသူတို့၏ပျက်စီးခြင်းအကြောင်းသည် သူတို့၏ဆင်းရဲခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဖြောင့်မတ်သောသူရရှိသောအဖိုးအခသည် အသက်ဖြစ်၏။ ဆိုးယုတ်သောသူရရှိသောအမြတ်အစွန်းသည် အပြစ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဆုံးမပဲ့ပြင်ခြင်းကို စောင့်ထိန်းသောသူသည် အသက်ရှင်ခြင်းလမ်း၌ရှိ၏။ ဆိုဆုံးမစကားကိုငြင်းပယ်သောသူမူကား လမ်းလွဲတတ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />မုန်းတီးခြင်းကိုဖုံးကွယ်ထားသောသူ၌ မုသားနှုတ်ခမ်းရှိ၏။ အသရေပျက်စေသောစကားကို ဖြန့်သူသည် မိုက်မဲသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />စကားများစွာပြောဆိုသောအခါ အပြစ်ပါလာတတ်၏။ မိမိ၏နှုတ်ကိုချုပ်တည်းသောသူမူကား ပညာသတိရှိ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဖြောင့်မတ်သောသူ၏လျှာသည် ငွေစင်နှင့်တူ၏။ ဆိုးယုတ်သောသူ၏စိတ်နှလုံးမူကား တန်ဖိုးနည်းလှ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဖြောင့်မတ်သောသူ၏နှုတ်ခမ်းသည် များစွာသောသူတို့ကို ကျွေးမွေးတတ်၏။ ဆိုးမိုက်သောသူတို့မူကား အသိစိတ်မရှိသောကြောင့် သေကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />ထာဝရဘုရား၏ကောင်းချီးမင်္ဂလာသည် လူကိုချမ်းသာကြွယ်ဝစေ၏။ ကိုယ်တော်သည် ထိုချမ်းသာကြွယ်ဝမှု၌ မည်သည့်ခက်ခဲပင်ပန်းမှုကိုမျှ ထပ်ပေါင်းတော်မမူ။
  </para>
  <para style="p">
    <verse number="23" style="v" />မိုက်မဲသောသူသည် ညစ်ညမ်းသောအမှုကိုပြုခြင်း၌ ပျော်မွေ့တတ်၏။ ထိုးထွင်းဉာဏ်ရှိသောသူမူကား ဉာဏ်ပညာ၌ ပျော်မွေ့တတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဆိုးယုတ်သောသူကြောက်လန့်သောအမှုသည် သူ့အပေါ်သို့သက်ရောက်လိမ့်မည်။ ဖြောင့်မတ်သောသူတို့၏အလိုဆန္ဒကိုကား ကိုယ်တော်ဖြည့်ဆည်းပေးတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="25" style="v" />လေပွေတိုက်ခတ်သွားသောအခါ ဆိုးယုတ်သောသူသည် ပျောက်ကွယ်သွား၏။ ဖြောင့်မတ်သောသူ၌ကား အစဉ်အမြဲတည်သောအုတ်မြစ်ရှိ၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ပျင်းရိသောသူသည် သူ့ကိုစေလွှတ်သောသူအတွက် သွားကိုထိသောရှာလကာရည်ကဲ့သို့လည်းကောင်း၊ မျက်စိထဲဝင်သောမီးခိုးကဲ့သို့လည်းကောင်း ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် အသက်ကိုရှည်စေတတ်၏။ ဆိုးယုတ်သောသူတို့၏နှစ်ကာလမူကား တိုတတ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဖြောင့်မတ်သောသူတို့မျှော်မှန်းသောအရာသည် ဝမ်းမြောက်ခြင်းဖြစ်၏။ ဆိုးယုတ်သောသူတို့၏မျှော်လင့်ချက်မူကား ပျက်စီးသွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="29" style="v" />ထာဝရဘုရား၏လမ်းတော်သည် တည်ကြည်သောသူအတွက် မှီခိုရာဖြစ်၏။ အပြစ်ဒုစရိုက်ကိုပြုကျင့်သောသူတို့အတွက်မူကား ပျက်စီးခြင်းအကြောင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />ဖြောင့်မတ်သောသူသည် မည်သည့်အခါမျှမရွေ့ရာ။ ဆိုးယုတ်သောသူတို့မူကား ပြည်တော်၌ နေထိုင်ရလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />ဖြောင့်မတ်သောသူ၏နှုတ်သည် ဉာဏ်ပညာကိုတိုးပွားစေ၏။ ဖောက်ပြန်လွဲမှားသောလျှာမူကား အဖြတ်ခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="32" style="v" />ဖြောင့်မတ်သောသူ၏နှုတ်ခမ်းသည် နှစ်သက်ဖွယ်သောအရာကို သိ၏။ ဆိုးယုတ်သောသူ၏နှုတ်မူကား ဖောက်ပြန်လွဲမှားသောအရာများကိုသာ သိ၏။
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />မမှန်ကန်သောချိန်ခွင်ကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ မှန်သောအလေးကိုကား ကိုယ်တော်နှစ်သက်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />မာနထောင်လွှားခြင်းလာသောအခါ အရှက်ကွဲခြင်းလိုက်လာတတ်၏။ ဉာဏ်ပညာကား စိတ်နှိမ့်ချသောသူတို့နှင့်အတူ လိုက်လာ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဖြောင့်မှန်သောသူတို့၏သမာဓိသည် သူတို့ကိုဦးဆောင်လမ်းပြတတ်၏။ သစ္စာမဲ့သောသူတို့၏ကောက်ကျစ်စဉ်းလဲခြင်းမူကား သူတို့ကိုဖျက်ဆီးတတ်၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />အမျက်တော်ထင်ရှားရာနေ့၌ စည်းစိမ်ဥစ္စာသည် အကျိုးမရှိ။ ဖြောင့်မတ်ခြင်းမူကား သေခြင်းမှကယ်နုတ်တတ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />အပြစ်တင်စရာမရှိသောသူ၏ဖြောင့်မတ်ခြင်းသည် သူ၏လမ်းကိုဖြောင့်တန်းစေတတ်၏။ ဆိုးယုတ်သောသူမူကား မိမိ၏ဆိုးယုတ်မှုကြောင့် ကျဆုံးတတ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဖြောင့်မှန်သောသူတို့၏ဖြောင့်မတ်ခြင်းသည် သူတို့ကိုကယ်နုတ်တတ်၏။ သစ္စာမဲ့သောသူတို့မူကား မိမိတို့၏အလိုရမ္မက်အားဖြင့် ဖမ်းဆီးခြင်းခံရတတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဆိုးယုတ်သောသူသေသောအခါ သူ၏မျှော်လင့်ချက်သည် ပျက်စီးတတ်၏။ ဓနဥစ္စာတို့အပေါ်ထားသော သူ၏မျှော်မှန်းချက်သည်လည်း ပျက်စီးတတ်၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဖြောင့်မတ်သောသူသည် ဆင်းရဲဒုက္ခထဲမှလွတ်မြောက်၍ ဆိုးယုတ်သောသူသည် သူ့အစားဝင်ရ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဘုရားတရားမဲ့သောသူသည် နှုတ်ဖြင့် မိမိ၏အိမ်နီးချင်းကို ဖျက်ဆီးတတ်၏။ ဖြောင့်မတ်သောသူတို့မူကား အသိပညာအားဖြင့် လွတ်မြောက်ခြင်းသို့ရောက်ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဖြောင့်မတ်သောသူတို့ကောင်းစားသောအခါ တစ်မြို့လုံး ရွှင်လန်းကြ၏။ ဆိုးယုတ်သောသူတို့ပျက်စီးသောအခါ၌လည်း ရွှင်လန်းစွာကြွေးကြော်ကြ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />မြို့သည် ဖြောင့်မှန်သောသူတို့၏ ကောင်းချီးမင်္ဂလာအားဖြင့် ချီးမြှောက်ခြင်းခံရတတ်၏။ သို့သော် ဆိုးယုတ်သောသူတို့၏နှုတ်အားဖြင့် ဖြိုဖျက်ခြင်းခံရတတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />အသိစိတ်မရှိသောသူသည် မိမိ၏အိမ်နီးချင်းကို မထီမဲ့မြင်ပြုတတ်၏။ ထိုးထွင်းဉာဏ်ရှိသောသူမူကား တိတ်ဆိတ်စွာနေတတ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />အတင်းအဖျင်းလိုက်ပြောသောသူသည် လျှို့ဝှက်ချက်ကိုပေါက်ကြားစေတတ်၏။ ယုံကြည်စိတ်ချရသောစိတ်သဘောရှိသူမူကား အမှုကိစ္စကို ဖုံးကွယ်ထားတတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />လမ်းညွှန်မှုမရှိလျှင် လူမျိုးတစ်မျိုးသည် ကျဆုံးတတ်၏။ အကြံပေးသူများစွာရှိလျှင်မူကား အောင်မြင်တတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သူစိမ်းအတွက်အာမခံသောသူသည် အမှန်တကယ်ဒုက္ခရောက်လိမ့်မည်။ တာဝန်ခံပေးရသည်ကိုမုန်းသောသူမူကား ဘေးကင်းလုံခြုံစွာနေရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ယဉ်ကျေးသိမ်မွေ့သောမိန်းမသည် ဂုဏ်သရေကိုရတတ်၏။ ကြမ်းကြုတ်သောယောက်ျားတို့မူကား ဓနဥစ္စာကိုရတတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />မေတ္တာကရုဏာထားတတ်သောသူသည် ကိုယ့်ကိုယ်ကိုယ်အကျိုးပြုတတ်၏။ ရက်စက်သောသူမူကား ကိုယ့်ကိုယ်ကိုယ်ဒုက္ခပေးတတ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဆိုးယုတ်သောသူသည် လှည့်ဖြားသောအဖိုးအခကိုရတတ်၏။ ဖြောင့်မတ်ခြင်းမျိုးစေ့ကိုကြဲသောသူမူကား မှန်ကန်သောအကျိုးကိုရတတ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဖြောင့်မတ်ခြင်း၌တည်မြဲသောသူသည် အသက်ရှင်ခြင်းသို့ရောက်လိမ့်မည်။ မကောင်းမှုနောက်သို့လိုက်သောသူမူကား သေခြင်းသို့ရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="20" style="v" />စိတ်နှလုံးကောက်ကျစ်သောသူတို့ကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ ပြည့်ဝစုံလင်သောလမ်းကို လိုက်သောသူတို့ကိုကား ကိုယ်တော်နှစ်သက်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />မကောင်းမှုပြုသောသူသည် အပြစ်ဒဏ်နှင့်မည်သို့မျှကင်းလွတ်လိမ့်မည်မဟုတ်။ ဖြောင့်မတ်သောသူတို့၏သားမြေးတို့မူကား မုချကင်းလွတ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />အဆင်းလှသော်လည်း ဆင်ခြင်တုံတရားကင်းမဲ့သောမိန်းမသည် ဝက်နှာခေါင်း၌တပ်ထားသော ရွှေနှာဆွဲနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ဖြောင့်မတ်သောသူတို့၏အလိုဆန္ဒသည် ကောင်းကျိုးကိုသာဖြစ်စေတတ်၏။ ဆိုးယုတ်သောသူတို့၏မျှော်လင့်ချက်မူကား အမျက်ကိုဖြစ်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />စွန့်ကြဲသော်လည်း ဥစ္စာပို၍တိုးပွားသူရှိ၏။ ပေးသင့်သည့်အရာကိုပင် ဆုပ်ကိုင်ထားသော်လည်း ချို့တဲ့နွမ်းပါးခြင်းသို့ရောက်သူလည်းရှိ၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />စိတ်စေတနာကောင်းသောသူသည် ကြွယ်ဝ၍ ရေလောင်းပေးသောသူသည် ကိုယ်တိုင်လည်း ရေလောင်းပေးခြင်းကိုခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဂျုံစပါးသိုလှောင်ထားသောသူကို တိုင်းသူပြည်သားတို့ ကျိန်ဆဲကြလိမ့်မည်။ ရောင်းချပေးသောသူ၏ဦးခေါင်းအပေါ်၌မူကား ကောင်းချီးမင်္ဂလာရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ကောင်းမြတ်သောအရာကိုကြိုးစား၍ရှာသောသူသည် ကျေးဇူးကိုရှာတွေ့လိမ့်မည်။ မကောင်းမှုကိုရှာသောသူမူကား သူ့ထံသို့ မကောင်းမှုရောက်လာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="28" style="v" />မိမိ၏ဓနဥစ္စာကို ကိုးစားသောသူသည် ကျဆုံးလိမ့်မည်။ ဖြောင့်မတ်သောသူမူကား သစ်ရွက်ကဲ့သို့ ပွင့်လန်းဝေဆာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="29" style="v" />မိမိအိမ်သူအိမ်သားတို့ကိုဒုက္ခပေးသောသူသည် လေကိုအမွေဆက်ခံရလိမ့်မည်။ ဆိုးမိုက်သောသူသည်လည်း စိတ်နှလုံး၌ ပညာရှိသောသူ၏အစေအပါးဖြစ်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ဖြောင့်မတ်သောသူ၏အသီးအပွင့်သည် အသက်ပင်သဖွယ်ဖြစ်၏။ စိတ်ဝိညာဉ်များကိုဆွဲဆောင်စည်းရုံးနိုင်သောသူသည် ပညာရှိဖြစ်၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />ကမ္ဘာမြေကြီးပေါ်တွင် ဖြောင့်မတ်သောသူပင် အကျိုးအပြစ်ကိုခံစားရသည်ဆိုလျှင် ဆိုးယုတ်သောသူနှင့် အပြစ်ပြုသောသူမူကား အဘယ်ဆိုဖွယ်ရှိသနည်း။
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဆုံးမပဲ့ပြင်ခြင်းကိုနှစ်သက်သောသူသည် အသိပညာကိုနှစ်သက်သောသူဖြစ်၏။ ဆိုဆုံးမခြင်းကိုမုန်းသောသူမူကား အသိတရားမဲ့သောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />သူတော်ကောင်းသည် ထာဝရဘုရားထံတော်မှ ကျေးဇူးတော်ကိုခံစားရလိမ့်မည်။ ကောက်ကျစ်သောဉာဏ်ရှိသောသူမူကား အပြစ်စီရင်ခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />လူသည် ဆိုးယုတ်မှုအားဖြင့် မတည်မြဲနိုင်ရာ။ ဖြောင့်မတ်သောသူတို့၏အမြစ်မူကား မရွေ့ရာ။
  </para>
  <para style="p">
    <verse number="4" style="v" />စွမ်းရည်နှင့်ပြည့်စုံသောမယားသည် မိမိခင်ပွန်း၏သရဖူဖြစ်၏။ အရှက်ကွဲစေသောမယားမူကား ခင်ပွန်း၏အရိုးထဲမှ ဆွေးမြည့်သောအရာကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဖြောင့်မတ်သောသူတို့၏အကြံအစည်တို့သည် တရားမျှတ၏။ ဆိုးယုတ်သောသူတို့၏လမ်းညွှန်မှုတို့သည် လိမ်လည်လှည့်ဖြားခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဆိုးယုတ်သောသူတို့၏စကားသည် လူကိုသတ်ဖြတ်ရန် ချောင်းမြောင်းတတ်၏။ ဖြောင့်မှန်သောသူတို့၏နှုတ်မူကား လူတို့ကိုကယ်နုတ်တတ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဆိုးယုတ်သောသူတို့သည် ဖြိုလှဲခြင်းခံရ၍ ပျောက်ကွယ်သွားကြ၏။ ဖြောင့်မတ်သောသူတို့၏အိမ်မူကား တည်မြဲလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="8" style="v" />လူသည် မိမိ၏ဉာဏ်စွမ်းနှင့်အညီ ချီးမွမ်းခြင်းခံရလိမ့်မည်။ ကောက်သောစိတ်သဘောရှိသူမူကား မထီမဲ့မြင်ပြုခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဂုဏ်နိမ့်သော်လည်း အစေအပါးရှိသောသူသည် ဂုဏ်ဖော်ဝါကြွားသော်လည်း စားစရာမရှိသောသူထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဖြောင့်မတ်သောသူသည် မိမိတိရစ္ဆာန်၏အသက်ကို ဂရုစိုက်တတ်၏။ ဆိုးယုတ်သောသူတို့၏သနားစုံမက်ခြင်းမူကား ရက်စက်မှုဖြစ်၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />မိမိမြေကိုထွန်ယက်လုပ်ကိုင်သောသူသည် အစားအစာနှင့်ပြည့်စုံကြွယ်ဝလိမ့်မည်။ အချည်းနှီးသောအရာများနောက်သို့ လိုက်သောသူမူကား အသိစိတ်မရှိ။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဆိုးယုတ်သောသူသည် မကောင်းမှုပြုသောသူတို့ သုံးသောထောင်ပိုက်ကို တပ်မက်ကြ၏။ ဖြောင့်မတ်သောသူတို့၏အမြစ်မူကား ရှင်သန်သီးပွင့်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="13" style="v" />မကောင်းမှုပြုသောသူသည် မိမိနှုတ်ကျူးလွန်သောအပြစ်အားဖြင့် ထောင်ချောက်မိတတ်၏။ ဖြောင့်မတ်သောသူမူကား ဆင်းရဲဒုက္ခထဲမှ လွတ်မြောက်တတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />လူသည် မိမိနှုတ်၏အသီးအပွင့်အားဖြင့် ကောင်းသောအရာနှင့်ပြည့်စုံကြွယ်ဝလိမ့်မည်။ သူ့လက်၏လုပ်ဆောင်မှုသည်လည်း သူ့ထံသို့ပြန်လာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆိုးမိုက်သောသူသည် မိမိပြုမူကျင့်ကြံသောအမှုအရာကို မှန်သည်ဟု ထင်မြင်တတ်၏။ ပညာရှိသောသူမူကား အကြံဉာဏ်ကိုနားထောင်တတ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဆိုးမိုက်သောသူသည် မိမိ၏အမျက်ဒေါသကို ချက်ချင်းထင်ရှားစေတတ်၏။ ဆင်ခြင်ဉာဏ်ရှိသောသူမူကား အရှက်ခွဲခံရခြင်းကိုပင် ဥပေက္ခာပြု၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဖြောင့်မတ်စွာပြောဆိုသောသူသည် သစ္စာစကားကိုထွက်ဆိုတတ်၏။ မုသားသက်သေမူကား လိမ်လည်လှည့်ဖြားသောစကားကိုထွက်ဆိုတတ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဓားနှင့်ထိုးသကဲ့သို့ မဆင်မခြင်ပြောဆိုတတ်သောသူရှိ၏။ ပညာရှိသောသူတို့၏စကားမူကား ဒဏ်ရာဒဏ်ချက်ကို ပျောက်ကင်းစေတတ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />မှန်ကန်သောနှုတ်ခမ်းသည် ထာဝစဉ်တည်မြဲ၏။ မုသားသုံးသောလျှာမူကား တစ်ခဏမျှသာတည်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />မကောင်းမှုကို တွေးတောကြံစည်သောသူတို့၏ စိတ်နှလုံးထဲ၌ လိမ်လည်လှည့်ဖြားခြင်းရှိ၏။ ငြိမ်းချမ်းရေးအတွက် အားပေးလှုံ့ဆော်သောသူတို့၌ကား ဝမ်းမြောက်ခြင်းရှိ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဖြောင့်မတ်သောသူအပေါ် မည်သည့်အမင်္ဂလာမျှကျရောက်လိမ့်မည်မဟုတ်။ ဆိုးယုတ်သောသူတို့မူကား ဒုက္ခနှင့်ပြည့်ဝကြ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />မုသားနှုတ်ခမ်းကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ သစ္စာရှိစွာပြုကျင့်သောသူတို့ကိုကား ကိုယ်တော်နှစ်သက်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ဆင်ခြင်ဉာဏ်ရှိသောသူသည် အသိပညာကို ဖုံးကွယ်ထားတတ်၏။ မိုက်မဲသောသူတို့၏စိတ်နှလုံးမူကား မိုက်မဲမှုကိုကြေညာတတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဝီရိယရှိသောသူ၏လက်သည် အုပ်စိုးရလိမ့်မည်။ လုံ့လနည်းသောသူမူကား အတင်းအကျပ်စေခိုင်းခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="25" style="v" />လူ၏စိတ်နှလုံးတွင်ရှိသောစိုးရိမ်ပူပန်ခြင်းသည် သူ့ကိုညှိုးငယ်စေတတ်၏။ ကောင်းသောစကားမူကား သူ့ကိုဝမ်းမြောက်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဖြောင့်မတ်သောသူသည် မိမိ၏အိမ်နီးချင်းကို လမ်းပြတတ်၏။ ဆိုးယုတ်သောသူတို့၏လမ်းမူကား သူတို့ကိုပင် မှားယွင်းစေတတ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />လုံ့လနည်းသောသူသည် မိမိလိုက်သောသားကောင်ကို ကင်၍မစားရ။ ဝီရိယရှိသောသူမူကား အဖိုးတန်သောစည်းစိမ်ဥစ္စာကိုရတတ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဖြောင့်မတ်သောလမ်း၌အသက်ရှင်ခြင်းရှိ၍ ထိုလမ်းခရီးတစ်လျှောက်၌ သေခြင်းမရှိ။
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />ပညာရှိသောသားသည် ဖခင်၏ဆုံးမပဲ့ပြင်ခြင်းကို နားထောင်တတ်၏။ ပြက်ရယ်ပြုသောသားမူကား ဆုံးမစကားကို နားမထောင်တတ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />လူသည် မိမိနှုတ်၏အသီးအပွင့်မှ ကောင်းသောအရာကိုစားရ၏။ သစ္စာမဲ့သောသူတို့၏စိတ်ဆန္ဒကား ရက်စက်ကြမ်းကြုတ်မှုဖြစ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />မိမိနှုတ်ကိုစောင့်စည်းသောသူသည် မိမိအသက်ကိုစောင့်ရှောက်၏။ နှုတ်ဖွာသောသူသည် ပျက်စီးခြင်းသို့ရောက်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ပျင်းရိသောသူ၏စိတ်ဝိညာဉ်သည် တောင့်တသော်လည်း မည်သည့်အရာကိုမျှမရနိုင်။ ဝီရိယရှိသောသူတို့၏စိတ်ဝိညာဉ်မူကား ကြွယ်ဝလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဖြောင့်မတ်သောသူသည် မုသားစကားကို မုန်း၏။ ဆိုးယုတ်သောသူမူကား စက်ဆုပ်ရွံရှာဖွယ်ဖြစ်၍ မျက်နှာပျက်ရတတ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဖြောင့်မတ်ခြင်းသည် တည်ကြည်သောလမ်းသို့လိုက်သောသူကို ကာကွယ်စောင့်ရှောက်တတ်၏။ ဆိုးယုတ်ခြင်းမူကား အပြစ်သားကို မှားယွင်းချွတ်ချော်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဘာမျှမရှိဘဲလျက် ချမ်းသာဟန်ဆောင်သောသူရှိ၏။ စည်းစိမ်ဥစ္စာများစွာရှိလျက်နှင့် ဆင်းရဲဟန်ဆောင်သောသူရှိ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />လူ၏ဓနဥစ္စာသည် သူ့အသက်ကိုပြန်ရွေးသော အဖိုးအခဖြစ်၏။ ဆင်းရဲသောသူမူကား မည်သည့်ခြိမ်းခြောက်သံကိုမျှ မကြားရပေ။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဖြောင့်မတ်သောသူတို့၏အလင်းသည် ထွန်းလင်းတောက်ပလိမ့်မည် ။ ဆိုးယုတ်သောသူတို့၏မီးခွက်မူကား ငြိမ်းလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />မာနထောင်လွှားခြင်းသည် ခိုက်ရန်ကိုသာဖြစ်ပွားစေတတ်၏။ အကြံပေးခြင်းကိုလက်ခံသောသူ၌ကား ဉာဏ်ပညာရှိ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />လွယ်လွယ်ရသောစည်းစိမ်ဥစ္စာသည် လျော့နည်းသွားတတ်၏။ နည်းနည်းချင်းစုဆောင်းသောသူမူကား စည်းစိမ်ဥစ္စာကိုတိုးပွားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />မျှော်မှန်းသောအရာကြန့်ကြာနေပါက စိတ်မသာမယာဖြစ်တတ်၏။ အလိုဆန္ဒပြည့်ဝခြင်းမူကား အသက်ပင်သဖွယ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />နှုတ်ကပတ်တော်ကိုမထီမဲ့မြင်ပြုသောသူသည် မိမိအပေါ်မိမိ ပျက်စီးခြင်းကိုသက်ရောက်စေလိမ့်မည်။ ပညတ်တော်ကိုရိုသေသောသူမူကား ဆုလာဘ်ကိုရရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ပညာရှိသောသူ၏သွန်သင်ချက်သည် အသက်စမ်းရေတွင်းဖြစ်၍ သေခြင်း၏ထောင်ချောက်များမှဖယ်ခွာစေတတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ကောင်းသောဉာဏ်စွမ်းသည် မျက်နှာရစေတတ်၏။ သစ္စာမဲ့သောသူ၏လမ်းခရီးကား ကြမ်းတမ်း၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဆင်ခြင်ဉာဏ်ရှိသောသူတိုင်းသည် အသိပညာရှိစွာပြုကျင့်တတ်၏။ မိုက်မဲသောသူမူကား မိမိ၏မိုက်မဲမှုကို ပေါ်လွင်ထင်ရှားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဆိုးယုတ်သောစေတမန်သည် ဒုက္ခတွင်းထဲသို့ကျရောက်တတ်၏။ သစ္စာရှိသောသံတမန်မူကား ဒဏ်ရာဒဏ်ချက်ကို ပျောက်ကင်းစေတတ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဆင်းရဲခြင်းနှင့်အရှက်ကွဲခြင်းသည် ဆုံးမပဲ့ပြင်ခြင်းကိုလျစ်လျူရှုသောသူထံသို့ ရောက်လာလိမ့်မည်။ ဆိုဆုံးမစကားကိုစောင့်ထိန်းသောသူမူကား ဂုဏ်ပြုချီးမွမ်းခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="19" style="v" />အလိုဆန္ဒပြည့်ဝခြင်းသည် စိတ်ဝိညာဉ်အတွက် နှစ်သက်ဖွယ်ဖြစ်၏။ သို့သော် မကောင်းမှုမှဖယ်ခွာခြင်းသည် မိုက်မဲသောသူတို့အတွက် စက်ဆုပ်ရွံရှာဖွယ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ပညာရှိသောသူတို့နှင့်အတူ လျှောက်လှမ်းသောသူသည် ပညာရှိလာလိမ့်မည်။ မိုက်မဲသောသူတို့နှင့်အတူပေါင်းဖော်သောသူမူကား ဒုက္ခရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဒုက္ခသည် အပြစ်သားတို့၏နောက်သို့ လိုက်တတ်၏။ ဖြောင့်မတ်သောသူတို့မူကား ကောင်းသောဆုလာဘ်ကိုရရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />သူတော်ကောင်းသည် သားမြေးတို့အတွက် အမွေကိုချန်ထားတတ်၏။ အပြစ်ပြုသောသူ၏ဥစ္စာပစ္စည်းမူကား ဖြောင့်မတ်သောသူအတွက် သိုမှီးထားခြင်းခံရ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ဆင်းရဲသောသူတီသောလယ်မြေသည် များစွာသောအစားအစာကို ဖြစ်ထွန်းစေတတ်၏။ သို့သော် မတရားမှုကြောင့် ဖျက်ဆီးခြင်းခံရတတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ကြိမ်လုံးကိုမသုံးသောသူသည် မိမိသားကိုမုန်းသောသူဖြစ်၏။ သားကိုချစ်သောသူမူကား သူ့ကိုကြိုးစား၍ဆုံးမပဲ့ပြင်တတ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဖြောင့်မတ်သောသူသည် မိမိစိတ်ဆန္ဒ ပြည့်စုံကြွယ်ဝသည့်တိုင်အောင် စားရ၏။ ဆိုးယုတ်သောသူတို့၏ဝမ်းမူကား ဟာနေလိမ့်မည်။
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />ပညာရှိသောမိန်းမသည် မိမိအိမ်ကိုတည်ဆောက်တတ်၏။ မိုက်မဲသောမိန်းမမူကား ၎င်းကို မိမိလက်ဖြင့် ဖြိုဖျက်တတ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဖြောင့်မှန်စွာလျှောက်လှမ်းသောသူသည် ထာဝရဘုရားကိုကြောက်ရွံ့တတ်၏။ သွေဖည်လွဲမှားသောလမ်းတို့ကိုလိုက်သောသူမူကား ကိုယ်တော်ကိုမထီမဲ့မြင်ပြုတတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဆိုးမိုက်သောသူ၏နှုတ်တွင် မာန်မာနအတက်ပေါက်လျက်ရှိ၏။ ပညာရှိသောသူတို့၏နှုတ်ခမ်းမူကား သူတို့ကိုစောင့်ရှောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="4" style="v" />နွားမရှိလျှင် တင်းကုပ်သည် သန့်ရှင်း၏။ သို့သော် နွား၏ခွန်အားဖြင့် များစွာသောအသီးအနှံတို့ကိုရရှိ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />သစ္စာရှိသောသက်သေသည် လိမ်လည်ခြင်းမပြု။ မုသားသက်သေမူကား လိမ်လည်ထွက်ဆိုတတ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ပြက်ရယ်ပြုတတ်သောသူသည် ဉာဏ်ပညာကိုရှာဖွေသော်လည်း မတွေ့ပေ။ အသိဉာဏ်ရှိသောသူမူကား အသိပညာကိုရလွယ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />မိုက်မဲသောသူ၏ရှေ့မှောက်မှ ထွက်သွားလော့။ အကြောင်းမူကား သူ့ထံမှ အသိပညာစကားကို သင်ရရှိမည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဆင်ခြင်ဉာဏ်ရှိသောသူ၏ဉာဏ်ပညာမှာ မိမိလမ်းကိုသိရှိနားလည်ခြင်းဖြစ်၏။ မိုက်မဲသောသူတို့၏မိုက်မဲခြင်းမူကား လိမ်လည်လှည့်ဖြားခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဆိုးမိုက်သောသူတို့သည် ဒုစရိုက်ဖြေရာယဇ်ကို ပြက်ရယ်ပြုတတ်ကြ၏။ ဖြောင့်မှန်သောသူတို့ကြား၌ကား နှစ်သက်လက်ခံခြင်းရှိ၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />စိတ်နှလုံးသည် မိမိ၏နာကြည်းခြင်းကို မိမိသိ၏။ မိမိ၏ဝမ်းမြောက်ခြင်းကိုလည်း အခြားမည်သူကမျှ ဝင်ရောက်ခံစား၍မရပေ။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဆိုးယုတ်သောသူတို့၏အိမ်သည် ဖျက်ဆီးခြင်းခံရလိမ့်မည်။ ဖြောင့်မှန်သောသူတို့၏တဲမူကား ပွင့်လန်းဝေဆာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />လူ့အမြင်၌ မှန်သောလမ်းဖြစ်သော်လည်း အဆုံး၌ သေခြင်းသို့ရောက်စေသောလမ်းရှိ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ရယ်မောလျက်နေစဉ်ပင် စိတ်နှလုံးသည် နာကျင်နေတတ်၏။ ဝမ်းမြောက်ခြင်း၏အဆုံး၌လည်း ပူဆွေးခြင်းရှိတတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />စိတ်သဘောဖောက်ပြန်သောသူသည် မိမိပြုမူကျင့်ကြံသောအမှုအရာများနှင့် ဝအီလိမ့်မည်။ သူတော်ကောင်းမူကား မိမိပြုမူကျင့်ကြံသောအမှုအရာများနှင့် ပြည့်စုံကြွယ်ဝလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />အသိဉာဏ်နည်းပါးသောသူသည် အရာအားလုံးကိုယုံတတ်၏။ ဆင်ခြင်ဉာဏ်ရှိသောသူမူကား မိမိ၏ခြေလှမ်းကို ဆင်ခြင်သုံးသပ်တတ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ပညာရှိသောသူသည် ကြောက်ရွံ့၍ မကောင်းမှုမှဖယ်ခွာတတ်၏။ မိုက်မဲသောသူမူကား ချုပ်တည်းမှုကင်းမဲ့၍ အတင့်ရဲတတ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />စိတ်တိုသောသူသည် မိုက်မဲသောအမှုကိုပြုတတ်၏။ ကောက်ကျစ်သောဉာဏ်ရှိသောသူသည်လည်း အမုန်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အသိဉာဏ်နည်းပါးသောသူတို့သည် မိုက်မဲမှုကိုအမွေဆက်ခံရကြ၏။ ဆင်ခြင်ဉာဏ်ရှိသောသူတို့မူကား အသိပညာသရဖူကိုဆောင်းရကြ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />မကောင်းမှုပြုသောသူတို့သည် သူတော်ကောင်းတို့၏ရှေ့၌လည်းကောင်း၊ ဆိုးယုတ်သောသူတို့သည် ဖြောင့်မတ်သောသူ၏ တံခါးဝ၌လည်းကောင်း ဦးညွှတ်ကြရ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဆင်းရဲသောသူသည် မိမိအိမ်နီးချင်း၏မုန်းတီးခြင်းကိုပင်ခံရ၏။ ချမ်းသာသောသူမူကား ချစ်ခင်သူများ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />မိမိ၏အိမ်နီးချင်းကို မထီမဲ့မြင်ပြုသောသူသည် အပြစ်ပြုသောသူဖြစ်၏။ ဆင်းရဲချို့တဲ့သောသူတို့ကို သနားသောသူမူကား မင်္ဂလာရှိ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />မကောင်းမှုကို တွေးတောကြံစည်သောသူတို့သည် လမ်းလွဲသွားကြသည်မဟုတ်လော။ ကောင်းသောအမှုကို တွေးတောကြံစည်သောသူတို့မူကား မေတ္တာကရုဏာနှင့်သမ္မာတရားကို တွေ့ရှိကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="23" style="v" />ခက်ခဲပင်ပန်းသောအလုပ်ရှိသမျှတို့၌ အကျိုးအမြတ်ရှိ၏။ အပြောသက်သက်မူကား ချို့တဲ့နွမ်းပါးခြင်းကိုသာဖြစ်စေ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ပညာရှိသောသူတို့၏သရဖူသည် သူတို့၏ဓနဥစ္စာဖြစ်၏။ မိုက်မဲသောသူတို့၏မိုက်မဲခြင်းမူကား မိုက်မဲမှုဖြစ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />မှန်ကန်သောသက်သေသည် အသက်ကိုကယ်နုတ်တတ်၏။ လိမ်လည်ထွက်ဆိုသောသူမူကား လိမ်လည်လှည့်ဖြားတတ်၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့သောသူ၌ တန်ခိုးကြီးသောကိုးစားရာရှိ၍ ၎င်းသည် သူ၏သားသမီးတို့အတွက် ခိုလှုံရာဖြစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် အသက်စမ်းရေတွင်းဖြစ်၍ သေခြင်း၏ထောင်ချောက်များမှ ဖယ်ခွာစေတတ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ပြည်သူပြည်သားများပြားခြင်းသည် ရှင်ဘုရင်အတွက် အသရေဖြစ်၏။ တိုင်းသူပြည်သားမရှိခြင်းမူကား အုပ်ချုပ်သူအတွက် ပျက်စီးခြင်းအကြောင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />စိတ်ရှည်သောသူ၌ ကြီးမားသောထိုးထွင်းဉာဏ်ရှိ၏။ စိတ်တိုသောသူမူကား မိုက်မဲမှုကိုချီးမြှောက်တတ်၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />တည်ငြိမ်သောစိတ်နှလုံးသည် ကိုယ်ခန္ဓာ၏အသက်ဖြစ်၏။ မနာလိုဝန်တိုခြင်းမူကား အရိုးတို့ကိုဆွေးမြည့်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />ဆင်းရဲသောသူကို နှိပ်စက်သောသူသည် သူ၏ဖန်ဆင်းရှင်ကို စော်ကားသောသူဖြစ်၏။ နွမ်းပါးသောသူကို သနားသောသူမူကား ကိုယ်တော်ကို ရိုသေလေးမြတ်သောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />ဆိုးယုတ်သောသူသည် မိမိပြုသောမကောင်းမှုထဲ၌ လဲကျလိမ့်မည်။ ဖြောင့်မတ်သောသူမူကား သူ၏သေခြင်းထဲ၌ပင် ခိုလှုံရာကိုတွေ့လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="33" style="v" />ဉာဏ်ပညာသည် အသိဉာဏ်ရှိသောသူ၏ စိတ်နှလုံးထဲ၌ ကိန်းဝပ်၍ မိုက်မဲသောသူတို့၏အလယ်၌ပင် ကိုယ့်ကိုယ်ကိုယ်ဖော်ပြတတ်၏။
  </para>
  <para style="p">
    <verse number="34" style="v" />ဖြောင့်မတ်ခြင်းသည် တိုင်းပြည်ကိုချီးမြှောက်တတ်၏။ အပြစ်မူကား တိုင်းသူပြည်သားတို့ကို အရှက်ကွဲစေတတ်၏။
  </para>
  <para style="p">
    <verse number="35" style="v" />ပညာသတိရှိသောအစေအပါးကို ရှင်ဘုရင်နှစ်သက်တတ်၏။ အရှက်ကွဲစေသောသူအပေါ်၌မူကား အမျက်တော်သက်ရောက်တတ်၏။
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />ညင်သာစွာဖြေကြားသောစကားသည် အမျက်ဒေါသကိုပြေစေတတ်၏။ ကြမ်းတမ်းသောစကားမူကား အမျက်ကိုလှုံ့ဆော်တတ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ပညာရှိသောသူတို့၏လျှာသည် အသိပညာကိုထုတ်ဖော်တတ်၏။ မိုက်မဲသောသူတို့၏နှုတ်မူကား မိုက်မဲခြင်းကိုသွန်ထုတ်တတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ထာဝရဘုရား၏မျက်စိတော်သည် နေရာတိုင်း၌ရှိ၍ မကောင်းမှုပြုသောသူတို့နှင့် သူတော်ကောင်းတို့ကို စောင့်ကြည့်နေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ညင်သာသော လျှာသည် အသက်ပင်သဖွယ်ဖြစ်၏။ ကောက်ကျစ်စဉ်းလဲသောလျှာမူကား စိတ်ကိုကြေကွဲစေတတ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဆိုးမိုက်သောသူသည် မိမိဖခင်၏ဆုံးမပဲ့ပြင်ခြင်းကို မထီလေးစားပြုတတ်၏။ ဆိုဆုံးမစကားကိုစောင့်ထိန်းသောသူမူကား နှိုင်းချင့်မျှော်ခေါ်တတ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဖြောင့်မတ်သောသူ၏အိမ်၌ စည်းစိမ်များစွာရှိ၏။ ဆိုးယုတ်သောသူ၏အမြတ်အစွန်းမူကား ဒုက္ခပေးတတ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ပညာရှိသောသူတို့၏နှုတ်ခမ်းသည် အသိပညာကိုပြန့်ပွားစေတတ်၏။ မိုက်မဲသောသူတို့၏စိတ်နှလုံးမူကား ထိုသို့မဟုတ်ပေ။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဆိုးယုတ်သောသူတို့၏ယဇ်ကောင်ကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ ဖြောင့်မှန်သောသူတို့၏ဆုတောင်းချက်ကိုကား ကိုယ်တော်နှစ်သက်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဆိုးယုတ်သောသူ၏လမ်းကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ ဖြောင့်မတ်ခြင်းကိုလက်ကိုင်ပြုသောသူကိုကား ကိုယ်တော်ချစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />လမ်းမှန်ကိုစွန့်ပယ်သောသူအတွက် ပြင်းထန်သောဆုံးမပဲ့ပြင်ခြင်းရှိ၏။ ဆိုဆုံးမစကားကိုမုန်းသောသူသည် သေရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />မရဏာနိုင်ငံနှင့် ပျက်စီးခြင်းနိုင်ငံသည် ထာဝရဘုရား၏ရှေ့တော်၌ ထင်ရှားလျက်ရှိ၏။ ထို့ထက်မက လူသားတို့၏စိတ်နှလုံးသည် ပို၍ပင်ထင်ရှားလျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ပြက်ရယ်ပြုတတ်သောသူသည် မိမိအားဆုံးမသောသူကိုချစ်လိမ့်မည်မဟုတ်။ ပညာရှိသောသူတို့ထံသို့လည်း သွားလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဝမ်းမြောက်သောစိတ်နှလုံးသည် မျက်နှာကိုရွှင်လန်းစေတတ်၏။ သို့သော် ဝမ်းနည်းပူဆွေးသောစိတ်နှလုံးကြောင့် စိတ်ထိခိုက်နာကျင်ရတတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />အသိဉာဏ်ရှိသောသူ၏စိတ်နှလုံးသည် အသိပညာကိုရှာဖွေတတ်၏။ မိုက်မဲသောသူတို့၏နှုတ်မူကား မိုက်မဲခြင်း၌ကျက်စားတတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />အဖိနှိပ်ခံရသောသူ၏နေ့ရက်ရှိသမျှတို့သည် ဆိုးရွား၏။ ကြည်ရွှင်သောစိတ်နှလုံး၌မူကား အစဉ်မပြတ်ကျင်းပသောစားသောက်ပွဲရှိ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဥစ္စာဘဏ္ဍာအနည်းငယ်သာရှိပြီး ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် ဥစ္စာဘဏ္ဍာများစွာရှိပြီး ရှုပ်ထွေးသောပြဿနာနှင့်ကြုံရခြင်းထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ချစ်ခြင်းမေတ္တာရှိရာအရပ်၌ ဟင်းသီးဟင်းရွက်ကိုစားရခြင်းသည် မုန်းတီးခြင်းရှိရာအရပ်၌ ဆူဖြိုးသောနွားကိုစားရခြင်းထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဒေါသကြီးသောသူသည် အငြင်းပွားမှုဖြစ်ရန်လှုံ့ဆော်တတ်၏။ စိတ်ရှည်သောသူမူကား ခိုက်ရန်ဖြစ်ပွားခြင်းကိုငြိမ်းစေတတ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ပျင်းရိသောသူ၏လမ်းသည် ဆူးစည်းရိုးသဖွယ်ဖြစ်၏။ ဖြောင့်မှန်သောသူတို့၏လမ်းခရီးမူကား ပြန့်ပြူး၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ပညာရှိသောသားသည် ဖခင်ကိုဝမ်းမြောက်စေတတ်၏။ မိုက်မဲသောသားမူကား မိမိ၏မိခင်ကိုမထီမဲ့မြင်ပြုတတ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />အသိစိတ်မရှိသောသူသည် မိုက်မဲခြင်း၌ဝမ်းမြောက်တတ်၏။ ထိုးထွင်းဉာဏ်ရှိသောသူမူကား ဖြောင့်မှန်စွာလျှောက်လှမ်းတတ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဆွေးနွေးတိုင်ပင်ခြင်းမရှိလျှင် အကြံအစည်များပျက်တတ်၏။ အကြံပေးသူများစွာရှိလျှင်မူကား အကြံအစည်ထမြောက်တတ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />လူသည် မိမိနှုတ်၏တုံ့ပြန်စကားအားဖြင့် ဝမ်းမြောက်ခြင်းကိုခံစားရ၏။ သင့်လျော်သောအချိန်၌ ပြောဆိုသောစကားသည်လည်း ကောင်းမြတ်လှပေ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />အသက်ရှင်ခြင်းလမ်းသည် ပညာသတိရှိသောသူကို အထက်အရပ်သို့ပို့ဆောင်ပေး၏။ ထိုသို့အားဖြင့် သူသည် အောက်မရဏာနိုင်ငံမှဖယ်ခွာနိုင်မည်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />ထာဝရဘုရားသည် မောက်မာသောသူ၏အိမ်ကို ဖြိုဖျက်တော်မူလိမ့်မည်။ မုဆိုးမ၏နယ်နိမိတ်ကိုကား တည်စေတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />မကောင်းမှုပြုသောသူ၏အကြံအစည်များကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ သို့သော် နှစ်လိုဖွယ်စကားတို့သည် စင်ကြယ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />မတရားသောအကျိုးစီးပွားကိုတပ်မက်သောသူသည် မိမိအိမ်သူအိမ်သားတို့ကို ဒုက္ခပေးတတ်၏။ တံစိုးလက်ဆောင်ကိုမုန်းသောသူမူကား အသက်ရှင်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဖြောင့်မတ်သောသူ၏စိတ်နှလုံးသည် မည်သို့ဖြေကြားရမည်ကို တွေးဆတတ်၏။ ဆိုးယုတ်သောသူတို့၏နှုတ်မူကား မကောင်းသောအရာများကို သွန်ထုတ်တတ်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />ထာဝရဘုရားသည် ဆိုးယုတ်သောသူတို့နှင့် ဝေးကွာတော်မူ၏။ ဖြောင့်မတ်သောသူတို့၏ဆုတောင်းချက်ကိုကား နားညောင်းတော်မူ၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />မျက်စိအလင်းသည် စိတ်နှလုံးကိုဝမ်းမြောက်စေတတ်၏။ ကောင်းသောသတင်းစကားသည်လည်း အရိုးကိုကျန်းမာစေတတ်၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />အသက်ရှင်ခြင်းနှင့်ဆိုင်သောဆိုဆုံးမစကားကို နားထောင်သောသူသည် ပညာရှိသောသူတို့အလယ်၌ နေရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="32" style="v" />ဆုံးမပဲ့ပြင်ခြင်းကိုလျစ်လျူရှုသောသူသည် ကိုယ့်ကိုယ်ကိုယ်အလေးမထားတတ်။ ဆိုဆုံးမစကားကိုနားထောင်သောသူမူကား အသိဉာဏ်ကိုရတတ်၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် ဉာဏ်ပညာနှင့်ဆိုင်သောဆုံးမပဲ့ပြင်ခြင်းဖြစ်၏။ ဂုဏ်သရေ၏ရှေ့ပြေးကား စိတ်နှိမ့်ချခြင်းဖြစ်၏။
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />စိတ်နှလုံး၏တွေးတောကြံစည်မှုတို့သည် လူနှင့်ဆိုင်၏။ လျှာဖြေကြားသောစကားမူကား ထာဝရဘုရားထံတော်မှလာ၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />လူသည် မိမိပြုမူကျင့်ကြံသမျှသောအမှုအရာတို့ကို သန့်ရှင်းစင်ကြယ်သည်ဟု ထင်မြင်တတ်၏။ သို့သော် ထာဝရဘုရားသည် စိတ်သဘောကိုချိန်တွယ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />သင်ပြုသောအမှုတို့ကို ထာဝရဘုရားထံအပ်နှံလော့။ သို့ပြုလျှင် သင်၏အကြံအစည်တို့သည် တည်ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ထာဝရဘုရားသည် ခပ်သိမ်းသောအရာတို့ကို မိမိရည်ရွယ်ချက်အတွက် ပြင်ဆင်တော်မူ၏။ ဆိုးယုတ်သောသူကိုပင်လျှင် ဒုက္ခခံရာနေ့ရက်အတွက် ပြင်ဆင်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဘဝင်မြင့်သောသူအပေါင်းတို့ကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ သူတို့သည် မည်သို့မျှ အပြစ်ဒဏ်နှင့်ကင်းလွတ်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />မေတ္တာကရုဏာနှင့်သမ္မာတရားအားဖြင့် အပြစ်ဖြေလွှတ်ခြင်းခံရ၍ ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းအားဖြင့် မကောင်းမှုမှဖယ်ခွာနိုင်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />လူတစ်ဦးပြုမူကျင့်ကြံသောအမှုအရာကို ထာဝရဘုရားနှစ်သက်တော်မူသောအခါ ထိုသူ၏ရန်သူများကိုပင် သူနှင့်သင့်မြတ်စေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />တရားသဖြင့်ရသော အမြတ်အစွန်းအနည်းငယ်သည် မတရားသဖြင့်ရသော အမြတ်အစွန်းများစွာထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />လူ၏စိတ်နှလုံးသည် မိမိသွားရာလမ်းကို ကြံစည်တတ်၏။ သို့သော် ထာဝရဘုရားသည် သူ၏ခြေလှမ်းများကို တည့်မတ်စေတော်မူမည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ရှင်ဘုရင်၏နှုတ်ခမ်းတွင် နိမိတ်စကားရှိ၏။ တရားစီရင်ရာ၌ သူ၏နှုတ်သည် မှားယွင်းမည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />မှန်ကန်သောကတ္တားနှင့်ချိန်ခွင်ကို ထာဝရဘုရားပိုင်တော်မူ၏။ အိတ်ထဲ၌ရှိသောအလေးအားလုံးကိုလည်း ကိုယ်တော်ပြုလုပ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ရာဇပလ္လင်သည် ဖြောင့်မတ်ခြင်းအားဖြင့် တည်မြဲသည်ဖြစ်၍ ရှင်ဘုရင်တို့သည် ဆိုးယုတ်သောအမှုပြုရမည်ကို စက်ဆုပ်ရွံရှာကြ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ရှင်ဘုရင်တို့သည် ဖြောင့်မတ်သောနှုတ်ခမ်းကိုနှစ်သက်၍ ဖြောင့်မှန်စွာပြောဆိုသောသူကို ချစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ရှင်ဘုရင်၏အမျက်ဒေါသသည် သေခြင်း၏စေတမန်ဖြစ်၏။ သို့သော် ပညာရှိသောသူသည် ၎င်းကိုပြေစေတတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ရှင်ဘုရင်၏မျက်နှာတော်ကြည်လင်တောက်ပရာ၌ အသက်ရှင်ခြင်းရှိ၏။ သူ၏ကျေးဇူးပြုခြင်းသည် နွေဦးမိုးကိုရွာစေသည့် တိမ်တိုက်ကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ရွှေကိုရရှိခြင်းထက် ဉာဏ်ပညာကိုရရှိခြင်းသည် အလွန်ကောင်း၏။ ငွေကိုရရှိခြင်းထက် အသိဉာဏ်ရရှိခြင်းကို ရွေးချယ်ရန်ကောင်း၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဖြောင့်မှန်သောသူတို့၏လမ်းသည် မကောင်းမှုမှဖယ်ခွာခြင်းဖြစ်၏။ မိမိသွားရာလမ်းကို ထိန်းသိမ်းစောင့်ရှောက်သောသူသည် မိမိအသက်ကိုစောင့်ထိန်းသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ပျက်စီးခြင်း၏ရှေ့ပြေးသည် မာနကြီးခြင်းဖြစ်၏။ ပြိုလဲခြင်း၏ရှေ့ပြေးကား ဘဝင်မြင့်ခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဖိစီးနှိပ်စက်ခြင်းခံရသောသူတို့နှင့်အတူ စိတ်နှိမ့်ချလျက်နေခြင်းသည် မောက်မာသောသူတို့နှင့်အတူ လုယက်ပစ္စည်းကို ခွဲဝေရခြင်းထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />နှုတ်ကပတ်တော်ကို ဂရုပြုသောသူသည် ကောင်းကျိုးချမ်းသာကိုခံစားရလိမ့်မည်။ ထာဝရဘုရားကို ယုံကြည်ကိုးစားသောသူသည်လည်း မင်္ဂလာရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="21" style="v" />စိတ်နှလုံး၌ပညာရှိသောသူသည် အသိဉာဏ်ရှိသောသူဟု ခေါ်ဝေါ်ခြင်းခံရလိမ့်မည်။ နှစ်လိုဖွယ်စကားတို့သည် ပညာကိုတိုးပွားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဉာဏ်စွမ်းကိုပိုင်ဆိုင်သောသူအတွက် ထိုဉာဏ်စွမ်းသည် အသက်စမ်းရေတွင်းဖြစ်၏။ မိုက်မဲခြင်းမူကား ဆိုးမိုက်သောသူတို့ခံရသော အပြစ်ဒဏ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ပညာရှိသောသူ၏စိတ်နှလုံးသည် မိမိနှုတ်ကိုပညာသတိရှိစေ၍ မိမိနှုတ်ခမ်းတွင် ပညာကိုတိုးပွားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />နှစ်လိုဖွယ်စကားတို့သည် ပျားလပို့မှပျားရည်ကဲ့သို့ စိတ်ဝိညာဉ်၌ချိုမြိန်၍ အရိုးကိုကျန်းမာစေတတ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />လူ့အမြင်၌ မှန်သောလမ်းဖြစ်သော်လည်း အဆုံး၌ သေခြင်းသို့ရောက်စေသောလမ်းရှိ၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />အလုပ်လုပ်သောသူ၏ပါးစပ်သည် သူ့ကိုတွန်းအားပေးသောကြောင့် သူ၏စိတ်ဆန္ဒသည် သူ့အတွက် ကြိုးပမ်းအားထုတ်တတ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဆိုးညစ်သောသူသည် မကောင်းမှုကိုတူးဆွတတ်၏။ သူ၏စကားသည်လည်း တောက်လောင်နေသော မီးကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဖောက်ပြန်လွဲမှားသောသူသည် အငြင်းပွားမှုကိုဖြစ်ပွားစေတတ်၏။ အတင်းအဖျင်းပြောဆိုသောသူသည်လည်း အပေါင်းအဖော်ကိုကွဲပြားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />ရက်စက်ကြမ်းကြုတ်သောသူသည် မိမိ၏အိမ်နီးချင်းကိုသွေးဆောင်၍ မကောင်းသောလမ်းသို့ လိုက်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />မျက်စိမှိတ်ပြသောသူသည် ဖောက်ပြန်လွဲမှားသောအရာများကို ကြံစည်နေခြင်းဖြစ်၏။ မိမိ၏နှုတ်ခမ်းကိုဖိပိတ်ထားသောသူသည်လည်း မကောင်းမှုကိုပြီးမြောက်စေသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />ဖြူသောဆံပင်သည် အသရေရှိသောသရဖူဖြစ်၍ ဖြောင့်မတ်စွာပြုမူကျင့်ကြံခြင်းအားဖြင့် ၎င်းကိုရရှိနိုင်၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />စိတ်ရှည်သောသူသည် သူရဲကောင်းထက် ပို၍ကောင်း၏။ မိမိ၏စိတ်ကို ထိန်းချုပ်နိုင်သောသူသည်လည်း မြို့ကိုသိမ်းပိုက်နိုင်သောသူထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />မဲကို ပေါင်ခွင်၌ချတတ်ကြ၏။ သို့သော် စီရင်ဆုံးဖြတ်ချက်အားလုံးသည် ထာဝရဘုရားထံတော်မှလာ၏။
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငြိမ်းချမ်းမှုနှင့်ယှဉ်တွဲလျက်ရှိသော မုန့်ခြောက်အနည်းငယ်သည် ခိုက်ရန်ဖြစ်ပွားခြင်းနှင့်ယှဉ်တွဲလျက်ရှိသည့် စားသောက်ဖွယ်အပြည့်ရှိသောအိမ်ထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ပညာသတိရှိသောအစေအပါးသည် အရှက်ကွဲစေသောသားကိုအုပ်စိုး၍ ညီအစ်ကိုတို့နှင့်အတူ အမွေဝေစုကိုရရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ငွေကိုမိုက်ဖြင့်လည်းကောင်း၊ ရွှေကိုမီးပြင်းဖိုဖြင့်လည်းကောင်း စစ်တတ်၏။ စိတ်နှလုံးကိုကား ထာဝရဘုရားစစ်ဆေးတော်မူ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဆိုးညစ်သောအမှုကိုပြုသောသူသည် ယုတ်ညံ့သောစကားကို အာရုံစိုက်နားထောင်တတ်၏။ မုသားပြောဆိုသောသူသည်လည်း ယုတ်မာစဉ်းလဲသောစကားကို စူးစိုက်နားထောင်တတ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဆင်းရဲသောသူကိုပြက်ရယ်ပြုသောသူသည် သူ၏ဖန်ဆင်းရှင်ကို စော်ကားသောသူဖြစ်၏။ သူတစ်ပါးဘေးဒုက္ခရောက်သည်ကို ဝမ်းမြောက်သောသူသည် အပြစ်ဒဏ်နှင့်ကင်းလွတ်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />မြေးတို့သည် အသက်ကြီးသောသူတို့၏သရဖူဖြစ်၏။ သားသမီးတို့၏ဂုဏ်ကျက်သရေကား သူတို့၏မိဘဘိုးဘွားဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />မွန်မြတ်သောနှုတ်ခမ်းသည် မိုက်မဲသောသူနှင့်မသင့်လျော်ပေ။ ထို့ထက်မက မုသားနှုတ်ခမ်းသည် မင်းအရာရှိနှင့် ပို၍ပင်မသင့်လျော်ပေ။
  </para>
  <para style="p">
    <verse number="8" style="v" />တံစိုးလက်ဆောင်သည် ပေးသူ၏အမြင်တွင် တင့်တယ်သောကျောက်မျက်ဖြစ်၍ မျက်နှာမူရာအရပ်ရပ်၌ အောင်မြင်တတ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />သူတစ်ပါးကျူးလွန်သောအပြစ်ကို ဖုံးအုပ်ပေးသောသူသည် ချစ်ခြင်းမေတ္တာကိုပြုစု၏။ အမှုအရာကိုထပ်တလဲလဲပြောဆိုသောသူမူကား အပေါင်းအဖော်ကို ကွဲပြားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />အသိဉာဏ်ရှိသောသူကို တစ်ကြိမ်ဆုံးမခြင်းသည် မိုက်မဲသောသူကို အကြိမ်တစ်ရာရိုက်ခြင်းထက် ပို၍အရာရောက်၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဆိုးညစ်သောသူသည် ပုန်ကန်မှုကိုသာရှာကြံတတ်သည်ဖြစ်၍ ရက်စက်သောစေတမန်သည် သူ့ထံသို့စေလွှတ်ခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />မိုက်မဲစိတ်မွှန်နေသော လူမိုက်နှင့်တွေ့ရခြင်းထက် သားငယ်ဆုံးရှုံးသောဝက်ဝံမနှင့်တွေ့ရခြင်းသည် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />တစ်စုံတစ်ဦးသည် ကောင်းမှုကို မကောင်းမှုဖြင့်တုံ့ပြန်လျှင် မကောင်းမှုသည် သူ့အိမ်မှ ထွက်ခွာလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />အငြင်းပွားမှု၏အစသည် ရေပေါက်ထွက်ခါစကဲ့သို့ဖြစ်သောကြောင့် ခိုက်ရန်မဖြစ်ပွားမီ အငြင်းပွားမှုကိုရပ်စဲလော့။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆိုးယုတ်သောသူကို ဖြောင့်မတ်သည်ဟုသတ်မှတ်သောသူနှင့် ဖြောင့်မတ်သောသူကို အပြစ်ရှိသည်ဟုစီရင်သောသူနှစ်ဦးစလုံးကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />မိုက်မဲသောသူသည် ဉာဏ်မရှိဘဲလျက် ဉာဏ်ပညာကိုဝယ်ယူရန် လက်ထဲ၌ငွေကိုင်ထားသည်မှာ အဘယ်ကြောင့်နည်း။
  </para>
  <para style="p">
    <verse number="17" style="v" />မိတ်ဆွေသည် အစဉ်အမြဲ ချစ်ခင်တတ်၏။ ညီအစ်ကိုသည်လည်း ဆင်းရဲဒုက္ခရောက်ချိန်အတွက် မွေးဖွားလာ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />အသိဉာဏ်မရှိသောသူသည် သူတစ်ပါးအတွက် တာဝန်ခံပေး၍ မိမိ၏အိမ်နီးချင်းအတွက် အာမခံပေးတတ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />အပြစ်ကျူးလွန်ခြင်းကိုနှစ်သက်သောသူသည် ခိုက်ရန်ပြုခြင်းကိုနှစ်သက်တတ်၏။ မိမိ၏တံခါးကိုမြှင့်သောသူသည် ပျက်စီးခြင်းကိုရှာကြံသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />စိတ်နှလုံးကောက်ကျစ်သောသူသည် ကောင်းသောအရာကိုတွေ့ရမည်မဟုတ်။ လိမ်လည်ပြောဆိုသောသူသည်လည်း ဒုက္ခတွင်းထဲသို့ကျရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="21" style="v" />မိုက်မဲသောသားကိုရသောသူ၌ ပူဆွေးခြင်းရှိ၏။ မိုက်မဲသောသူ၏ဖခင်၌လည်း ဝမ်းမြောက်ခြင်းမရှိ။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဝမ်းမြောက်သောစိတ်နှလုံးသည် ဆေးကောင်းတစ်လက်ဖြစ်၏။ စိတ်ထိခိုက်နာကျင်ခြင်းမူကား အရိုးကိုခြောက်သွေ့စေတတ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ဆိုးယုတ်သောသူသည် တရားမျှတခြင်းလမ်းစဉ်တို့ကိုဖျက်ရန် တံစိုးလက်ဆောင်ကို လျှို့ဝှက်စွာယူတတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />အသိဉာဏ်ရှိသောသူ၏မျက်နှာသည် ဉာဏ်ပညာဘက်သို့ရှေးရှုတတ်၏။ မိုက်မဲသောသူ၏မျက်စိမူကား ကမ္ဘာမြေကြီးအစွန်းသို့ရှေးရှုတတ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />မိုက်မဲသောသားသည် သူ၏ဖခင်အတွက် ပူဆွေးစရာဖြစ်၍ သူ့ကိုမွေးဖွားသောသူအတွက် ခါးသီးစရာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဖြောင့်မတ်သောသူကို အပြစ်ဒဏ်ပေးခြင်း၊ မင်းအရာရှိတို့ကို ဖြောင့်မှန်မှုအတွက်ရိုက်ခြင်းသည် မကောင်းပေ။
  </para>
  <para style="p">
    <verse number="27" style="v" />မိမိစကားကိုထိန်းချုပ်သောသူသည် အသိပညာရှိ၏။ စိတ်အေးဆေးတည်ငြိမ်သောသူသည် ထိုးထွင်းဉာဏ်ရှိသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဆိုးမိုက်သောသူပင် တိတ်ဆိတ်စွာနေလျှင် ပညာရှိဟူ၍လည်းကောင်း၊ မိမိ၏နှုတ်ကိုပိတ်ထားလျှင် အသိဉာဏ်ရှိသောသူဟူ၍လည်းကောင်း မှတ်ယူခြင်းခံရတတ်၏။
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />သူတစ်ပါးနှင့်မရောနှောသောသူသည် မိမိအလိုဆန္ဒကိုသာရှာကြံ၍ မှန်ကန်ပြည့်စုံသောဉာဏ်ပညာရှိသမျှကို ဆန့်ကျင်တတ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />မိုက်မဲသောသူသည် ထိုးထွင်းဉာဏ်ကိုအလိုမရှိဘဲ မိမိစိတ်သဘောကိုသာ ဖော်ပြတတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဆိုးယုတ်သောသူရောက်လာသောအခါ မထီမဲ့မြင်ပြုခြင်းလည်း ရောက်လာတတ်၏။ ကဲ့ရဲ့ပြစ်တင်ခြင်းသည်လည်း အရှက်ကွဲခြင်းနှင့်အတူရောက်လာတတ်၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />လူ၏နှုတ်မှထွက်သောစကားတို့သည် နက်သောရေကဲ့သို့ဖြစ်၏။ ဉာဏ်ပညာ၏စမ်းရေတွင်းသည် စီးဆင်းနေသောစမ်းချောင်းကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဆိုးယုတ်သောသူကိုမျက်နှာလိုက်ခြင်း၊ ဖြောင့်မတ်သောသူကို မတရားသဖြင့်စီရင်ခြင်းသည် မကောင်းပေ။
  </para>
  <para style="p">
    <verse number="6" style="v" />မိုက်မဲသောသူ၏နှုတ်ခမ်းသည် ခိုက်ရန်ဖြစ်ပွားမှုထဲဝင်ပါတတ်၏။ သူ၏နှုတ်သည်လည်း ကြိမ်ဒဏ်ကိုဖိတ်ခေါ်တတ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />မိုက်မဲသောသူ၏နှုတ်သည် သူ့အတွက် ပျက်စီးခြင်းအကြောင်းဖြစ်၏။ သူ၏နှုတ်ခမ်းသည်လည်း သူ၏စိတ်ဝိညာဉ်ကိုဖမ်းမိသောထောင်ချောက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />အတင်းအဖျင်းပြောဆိုသောသူ၏စကားတို့သည် စားကောင်းသောက်ဖွယ်များကဲ့သို့ဖြစ်၍ အတွင်းအကျဆုံးနေရာများသို့ဆင်းသွားတတ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />မိမိ၏အလုပ်၌ပျင်းရိသောသူသည် အဖျက်သမားနှင့်ညီအစ်ကိုတော်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ထာဝရဘုရား၏နာမတော်သည် ခိုင်ခံ့သောရဲတိုက်ဖြစ်၏။ ဖြောင့်မတ်သောသူသည် ထိုရဲတိုက်သို့ပြေးဝင်၍ လုံခြုံစွာနေရ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ချမ်းသာသောသူ၏စည်းစိမ်ဥစ္စာသည် သူ၏ခိုင်ခံ့သောမြို့ဖြစ်၏။ ၎င်းကို မြင့်မားသောတံတိုင်းနှင့်တူသည်ဟု သူထင်မှတ်တတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ပျက်စီးခြင်း၏ရှေ့ပြေးသည် လူ၏ဘဝင်မြင့်ခြင်းဖြစ်၏။ ဂုဏ်သရေ၏ရှေ့ပြေးကား စိတ်နှိမ့်ချခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ကောင်းစွာနားမထောင်မီ ဖြေဆိုခြင်းသည် ထိုသို့ဖြေဆိုသောသူအတွက် မိုက်မဲခြင်းနှင့် အသရေပျက်ခြင်းဖြစ်တတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />လူ၏စိတ်သည် သူ၏ရောဂါဝေဒနာကို ခံရပ်နိုင်၏။ သို့သော် စိတ်ထိခိုက်နာကျင်ခြင်းကိုကား မည်သူခံနိုင်မည်နည်း။
  </para>
  <para style="p">
    <verse number="15" style="v" />အသိဉာဏ်ရှိသောသူ၏စိတ်နှလုံးသည် အသိပညာကိုဆည်းပူးတတ်၏။ ပညာရှိသောသူတို့၏နားသည်လည်း အသိပညာကိုရှာဖွေတတ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />လူနှင့်ပါလာသောလက်ဆောင်သည် သူ့ကိုလမ်းဖွင့်ပေး၍ ကြီးမြတ်သောသူတို့၏ရှေ့မှောက်သို့ သူ့ကိုပို့ဆောင်ပေးတတ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />မိမိအမှုကိုဦးစွာတင်ပြသောသူသည် အခြားသူရောက်လာ၍ ထိုအမှုကို မစစ်ကြောမီအထိ ဖြောင့်မတ်ဟန်ရှိ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />မဲချခြင်းသည် ငြင်းခုံရန်တွေ့ခြင်းကိုအဆုံးသတ်စေ၍ အင်အားကြီးသောသူတို့အကြား ဖျန်ဖြေပေးတတ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />စော်ကားပြစ်မှားခြင်းခံရသောညီအစ်ကိုသည် ခိုင်ခံ့သောမြို့ထက် ပို၍မာကျော၏။ ငြင်းခုံရန်တွေ့ခြင်းသည်လည်း ခံတပ်၏ကန့်လန့်ကျင်ကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />လူသည် မိမိနှုတ်၏အသီးအပွင့်ဖြင့် မိမိဝမ်းကိုပြည့်စေ၍ မိမိနှုတ်ခမ်း၏အမြတ်အစွန်းဖြင့် အလိုပြည့်စုံတတ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />သေခြင်းနှင့်အသက်ရှင်ခြင်းသည် လျှာ၏တန်ခိုးအောက်၌ရှိသည်ဖြစ်၍ လျှာကိုချစ်ခင်သောသူသည် ၎င်း၏အသီးကိုစားရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />မယားကိုရသောသူသည် ကောင်းသောအရာကိုရ၍ ထာဝရဘုရားထံတော်မှ ကျေးဇူးတော်ကိုခံစားရ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ဆင်းရဲသောသူသည် အသနားခံပြောဆိုတတ်၏။ ချမ်းသာသောသူမူကား ကြမ်းတမ်းစွာတုံ့ပြန်ပြောဆိုတတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />အပေါင်းအသင်းများသောသူသည် ပျက်စီးတတ်၏။ သို့ရာတွင် ညီအစ်ကိုထက် ပို၍ခင်တွယ်တတ်သောမိတ်ဆွေလည်း ရှိ၏။
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />တည်ကြည်စွာလျှောက်လှမ်းသော ဆင်းရဲသားသည် ကောက်ကျစ်သောစကားကိုပြောဆိုသည့် လူမိုက်ထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />အသိပညာကင်းမဲ့သောစိတ်ဆန္ဒသည် မကောင်းပေ။ အလျင်စလိုခြေလှမ်းသောသူသည် လွဲချော်တတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />လူသည် မိမိ၏မိုက်မဲမှုကြောင့် မိမိလမ်းခရီးမှားယွင်းချွတ်ချော်သောအခါပင် သူ၏စိတ်နှလုံးတွင် ထာဝရဘုရားကိုစိတ်ဆိုးတတ်၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />စည်းစိမ်ဥစ္စာသည် အပေါင်းအသင်းများစွာတိုးပွားစေတတ်၏။ ဆင်းရဲသောသူမူကား သူ့မိတ်ဆွေ၏စွန့်ခွာခြင်းကိုခံရတတ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />မုသားသက်သေသည် အပြစ်ဒဏ်နှင့်ကင်းလွတ်လိမ့်မည်မဟုတ်။ လိမ်လည်ထွက်ဆိုသောသူသည်လည်း လွတ်မြောက်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />များစွာသောသူတို့သည် မင်းအရာရှိထံမှမျက်နှာရရန်ကြိုးစားတတ်ကြ၏။ လူတိုင်းသည်လည်း လက်ဆောင်ပေးသောသူနှင့်မိတ်ဆွေဖြစ်တတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဆင်းရဲသောသူကို သူ၏ညီအစ်ကိုအားလုံးကပင် မုန်းတတ်ကြ၏။ သူ၏မိတ်ဆွေတို့သည် သူ့ကိုဝေးဝေးရှောင်ကြသည်မှာ အဘယ်ဆိုဖွယ်ရှိသနည်း။ သူသည် သူတို့နောက်သို့လိုက်၍ စကားပြောသော်လည်း မည်သူမျှ သူနှင့်စကားမပြောကြပေ။
  </para>
  <para style="p">
    <verse number="8" style="v" />အသိဉာဏ်ကိုရရှိသောသူသည် မိမိ၏စိတ်ဝိညာဉ်ကိုချစ်၏။ ထိုးထွင်းဉာဏ်ကိုစောင့်ထိန်းသောသူသည် ကောင်းသောအရာကိုတွေ့ရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />မုသားသက်သေသည် အပြစ်ဒဏ်နှင့်ကင်းလွတ်လိမ့်မည်မဟုတ်။ လိမ်လည်ထွက်ဆိုသောသူသည်လည်း ပျက်စီးရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />မိုက်မဲသောသူသည် ပျော်ရွှင်ကြည်နူးရန်မသင့်လျော်ပေ။ ထို့ထက်မက ကျွန်သည် အကြီးအကဲတို့ကိုအုပ်စိုးရန် ပို၍ပင်မသင့်လျော်ပေ။
  </para>
  <para style="p">
    <verse number="11" style="v" />ပညာသတိရှိသောသူသည် မိမိ၏ဒေါသကိုချုပ်တည်းတတ်၏။ သူ၏ဂုဏ်ကျက်သရေကား သူတစ်ပါးကျူးလွန်သောအပြစ်ကို ဖြေလွှတ်ခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ရှင်ဘုရင်၏အမျက်ဒေါသသည် ခြင်္သေ့ပျိုဟောက်သကဲ့သို့ဖြစ်၏။ သူ၏ကျေးဇူးပြုခြင်းမူကား မြက်ပင်ပေါ်မှနှင်းစက်ကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />မိုက်မဲသောသားသည် သူ့ဖခင်အတွက် ပျက်စီးခြင်းအကြောင်းဖြစ်၏။ ငြင်းခုံရန်တွေ့တတ်သောမယားသည်လည်း အဆက်မပြတ် တစက်စက်ယိုကျသောမိုးရေနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />အိမ်ရာနှင့်စည်းစိမ်ဥစ္စာသည် မိဘဘိုးဘွားတို့ပေးသောအမွေဖြစ်၏။ ပညာသတိရှိသောမယားမူကား ထာဝရဘုရားပေးသနားတော်မူရာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ပျင်းရိခြင်းသည် အအိပ်ကြီးစေတတ်၏။ လုံ့လနည်းသောသူသည်လည်း ငတ်မွတ်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ပညတ်တော်ကိုစောင့်ထိန်းသောသူသည် မိမိ၏စိတ်ဝိညာဉ်ကိုစောင့်ထိန်းသောသူဖြစ်၏။ ကိုယ်တော်၏လမ်းတော်တို့ကို မထီမဲ့မြင်ပြုသောသူမူကား သေရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဆင်းရဲသောသူကိုသနားသောသူသည် ထာဝရဘုရားအား ချေးငှားခြင်းဖြစ်၍ ကိုယ်တော်သည် သူ၏လုပ်ဆောင်မှုအတွက် သူ့အား ဆုလာဘ်ကိုပေးတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />မျှော်လင့်ခြင်းရှိစဉ်အခါ သင်၏သားကိုပဲ့ပြင်လော့။ သူ့ကိုသေခြင်းသို့ရောက်စေလိုသည့် စိတ်ထားမျိုးမရှိစေနှင့်။
  </para>
  <para style="p">
    <verse number="19" style="v" />အမျက်ဒေါသကြီးမားသောသူသည် အပြစ်ဒဏ်ခံရလိမ့်မည်။ သူ့ကိုကယ်နုတ်လျှင်လည်း နောက်တစ်ဖန်ထပ်၍ ကယ်နုတ်ရဦးမည်။
  </para>
  <para style="p">
    <verse number="20" style="v" />အကြံဉာဏ်ကိုနားထောင်၍ ဆုံးမပဲ့ပြင်ခြင်းကိုလက်ခံလော့။ သို့ပြုလျှင် နောက်ဆုံး၌ သင်သည် ဉာဏ်ပညာကိုရရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="21" style="v" />လူ၏စိတ်နှလုံးထဲ၌ အကြံအစည်များစွာရှိ၏။ သို့ရာတွင် ထာဝရဘုရား၏အကြံဉာဏ်သည်သာ တည်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />လူ့ထံမှအလိုရှိအပ်သောအရာကား သူ၏မေတ္တာကရုဏာဖြစ်၏။ ဆင်းရဲသောသူသည် လိမ်လည်သောသူထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းသည် အသက်ရှင်ခြင်းသို့ပို့ဆောင်ပေးသည်ဖြစ်၍ ထိုစိတ်သဘောရှိသောသူသည် ပြည့်စုံစွာနေရလျက် ဘေးအန္တရာယ်နှင့်ကြုံတွေ့ရလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ပျင်းရိသောသူသည် မိမိ၏လက်ကိုပန်းကန်ထဲသို့နှိုက်သော်လည်း ၎င်းကို မိမိပါးစပ်ထဲသို့ ပြန်၍မသွင်းလို။
  </para>
  <para style="p">
    <verse number="25" style="v" />ပြက်ရယ်ပြုတတ်သောသူကိုရိုက်လော့။ သို့ပြုလျှင် အသိဉာဏ်နည်းပါးသောသူသည် နှိုင်းချင့်မျှော်ခေါ်တတ်လာလိမ့်မည်။ အသိဉာဏ်ရှိသောသူကိုဆုံးမလော့။ သို့ပြုလျှင် သူသည် အသိပညာကိုရရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဖခင်အပေါ်ကြမ်းကြုတ်စွာပြုမူပြီး မိခင်ကိုနှင်ထုတ်သောသားသည် အရှက်ကွဲစေသောသား၊ မျက်နှာပျက်စေသောသားဖြစ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ငါ့သား၊ သင်သည် ဆုံးမပဲ့ပြင်ခြင်းကိုနားမထောင်တော့လျှင် အသိပညာစကားတို့မှ လမ်းလွဲသွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဆိုးညစ်သောသက်သေသည် တရားမျှတမှုကို ပြက်ရယ်ပြုတတ်၏။ ဆိုးယုတ်သောသူတို့၏နှုတ်သည်လည်း အပြစ်ဒုစရိုက်ကို ဝါးမျိုတတ်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />ပြက်ရယ်ပြုတတ်သောသူတို့အတွက် အပြစ်ဒဏ်သည်လည်းကောင်း၊ မိုက်မဲသောသူတို့၏ကျောကုန်းအတွက် ကြိမ်ဒဏ်သည်လည်းကောင်း အဆင်သင့်ရှိ၏။
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />စပျစ်ဝိုင်သည် ပြက်ရယ်ပြုစေတတ်၏။ သေရည်သေရက်သည်လည်း ဆူပူသောင်းကျန်းစေတတ်၏။ ၎င်းတို့ကြောင့် လမ်းလွဲသောသူရှိသမျှသည် ဉာဏ်ပညာမရှိ။
  </para>
  <para style="p">
    <verse number="2" style="v" />ရှင်ဘုရင်နှင့်ဆိုင်သော ကြောက်ရွံ့ထိတ်လန့်ဖွယ်သောအရာသည် ခြင်္သေ့ပျိုဟောက်သကဲ့သို့ဖြစ်၏။ သူ့ကိုအမျက်ထွက်စေသောသူသည် မိမိအသက်ကိုဆုံးရှုံးရ တတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ခိုက်ရန်ဖြစ်ပွားခြင်းကိုရှောင်ရှားသောသူသည် ဂုဏ်သရေရှိ၏။ ဆိုးမိုက်သောသူတိုင်းကား ခိုက်ရန်ဖြစ်တတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ပျင်းရိသောသူသည် စိုက်ပျိုးရာသီ၌ ထွန်ယက်စိုက်ပျိုးခြင်းမပြုသောကြောင့် ရိတ်သိမ်းချိန်၌ တောင်းရမ်းသော်လည်း ဘာမျှမရချေ။
  </para>
  <para style="p">
    <verse number="5" style="v" />လူ၏စိတ်နှလုံး၌ရှိသောအကြံဉာဏ်သည် နက်သောရေနှင့်တူ၏။ သို့သော် ထိုးထွင်းဉာဏ်ရှိသောသူသည် ၎င်းကိုခပ်ယူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />များစွာသောလူတို့သည် မိမိတို့၏မေတ္တာကရုဏာကို ထုတ်ဖော်ပြောဆိုတတ်ကြ၏။ သို့သော် သစ္စာရှိသောသူကို မည်သူရှာတွေ့နိုင်သနည်း။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဖြောင့်မတ်သောသူသည် တည်ကြည်စွာလျှောက်လှမ်းတတ်၏။ နောင်လာမည့် သူ၏သားမြေးတို့သည် မင်္ဂလာရှိကြ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />တရားစီရင်ရာပလ္လင်ပေါ်တွင်ထိုင်သော ရှင်ဘုရင်သည် မကောင်းမှုရှိသမျှကို မိမိ၏မျက်စိဖြင့် လွင့်သွားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />“ငါသည် ငါ၏စိတ်နှလုံးကို သန့်ရှင်းစင်ကြယ်စေပြီ၊ ငါသည် အပြစ်မှစင်ကြယ်ပြီ”ဟု မည်သူပြောဆိုနိုင်သနည်း။
  </para>
  <para style="p">
    <verse number="10" style="v" />အချိန်ချင်းမတူသောအလေး၊ အဝင်ချင်းမတူသောခြင်တောင်း၊ ထိုနှစ်မျိုးစလုံးကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ကလေးသူငယ်ပင်လျှင် သူ၏လုပ်ဆောင်ချက်သည် သန့်ရှင်းစင်ကြယ်ခြင်းရှိ၊ မရှိ၊ ဖြောင့်မှန်ခြင်းရှိ၊ မရှိ သူ၏အပြုအမူအားဖြင့် ထင်ရှားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ကြားတတ်သောနား၊ မြင်တတ်သောမျက်စိ၊ ဤအရာနှစ်ပါးစလုံးကို ထာဝရဘုရားဖန်ဆင်းတော်မူ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />အအိပ်မမက်နှင့်။ အအိပ်မက်လျှင် ဆင်းရဲသွားလိမ့်မည်။ သင်၏မျက်စိကို ဖွင့်ထားလော့။ သို့ပြုလျှင် အစားအစာနှင့်ပြည့်စုံကြွယ်ဝလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဝယ်သောသူသည် “မကောင်းဘူး၊ မကောင်းဘူး”ဟု ဆိုတတ်၏။ သို့သော် ဝယ်၍ထွက်သွားပြီးမှ ဝါကြွားတတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ရွှေရှိ၏။ ပတ္တမြားလည်းများစွာရှိ၏။ သို့သော် အသိပညာရှိသောနှုတ်ခမ်းသည် အဖိုးတန်သောရတနာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />သူစိမ်းအတွက် အာမခံသောသူ၏အဝတ်ကိုယူထားလော့။ ကိုယ်ကျင့်တရားပျက်ပြားသောမိန်းမအတွက် အာမခံသောသူထံမှ အပေါင်ပစ္စည်းကိုယူထားလော့။
  </para>
  <para style="p">
    <verse number="17" style="v" />လှည့်ဖြား၍ရသောအစားအစာသည် စားသူအတွက်ချိုမြိန်သော်လည်း နောက်မှ သူ၏နှုတ်သည် ကျောက်စရစ်များနှင့်ပြည့်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အကြံဉာဏ်ယူခြင်းအားဖြင့် အကြံအစည်များ တည်တတ်၏။ လမ်းညွှန်မှုများကိုခံယူ၍ စစ်ပွဲကိုဆင်နွှဲလော့။
  </para>
  <para style="p">
    <verse number="19" style="v" />အတင်းအဖျင်းလိုက်ပြောသောသူသည် လျှို့ဝှက်ချက်ကို ပေါက်ကြားစေတတ်၏။ သို့ဖြစ်၍ နှုတ်ဖွာသောသူနှင့် ရောနှောဆက်ဆံခြင်းမပြုနှင့်။
  </para>
  <para style="p">
    <verse number="20" style="v" />မိမိ၏မိခင်နှင့်ဖခင်တို့ကို ကျိန်ဆဲသောသူ၏မီးခွက်သည် မှောင်မည်းသောအမှောင်ထဲတွင် ငြိမ်းသွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="21" style="v" />အစ၌ အလျင်စလိုရယူသောအမွေသည် အဆုံး၌ ကောင်းချီးမင်္ဂလာ မဖြစ်ပေ။
  </para>
  <para style="p">
    <verse number="22" style="v" />“မကောင်းမှုကိုငါတုံ့ပြန်မည်”ဟု မဆိုနှင့်။ ထာဝရဘုရားကိုသာ စောင့်မျှော်လော့။ သို့ပြုလျှင် ကိုယ်တော်သည် သင့်ကို ကယ်တင်တော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="23" style="v" />အချိန်ချင်းမတူသောအလေးကို ထာဝရဘုရားစက်ဆုပ်ရွံရှာတော်မူ၏။ မမှန်ကန်သောချိန်ခွင်သည်လည်း မကောင်းပေ။
  </para>
  <para style="p">
    <verse number="24" style="v" />လူ၏ခြေလှမ်းတို့ကို ထာဝရဘုရားစီရင်တော်မူ၏။ သို့ဖြစ်၍ လူသည် မိမိသွားရာလမ်းကို မည်သို့သိရှိနားလည်နိုင်မည်နည်း။
  </para>
  <para style="p">
    <verse number="25" style="v" />တစ်စုံတစ်ခုကို သန့်ရှင်းသောအရာအဖြစ် အလျင်စလိုဆက်ကပ်၍ ကတိသစ္စာပေးပြီးမှ ထောက်ရှုဆင်ခြင်ခြင်းသည် လူတစ်ဦးအတွက် ထောင်ချောက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ပညာရှိသောရှင်ဘုရင်သည် ဆိုးယုတ်သောသူတို့ကို လှေ့၍ သူတို့အပေါ်၌ စပါးခြွေသောဘီးကိုလှိမ့်တတ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />လူ၏ဝိညာဉ်သည် အတွင်းအကျဆုံးနေရာရှိသမျှတို့ကို ရှာဖွေတတ်သော ထာဝရဘုရား၏မီးခွက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />မေတ္တာကရုဏာနှင့်သမ္မာတရားသည် ရှင်ဘုရင်ကိုကာကွယ်စောင့်ရှောက်တတ်၏။ ရာဇပလ္လင်သည်လည်း မေတ္တာကရုဏာအားဖြင့် မြဲမြံတတ်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />လူပျိုတို့၏ဂုဏ်ကျက်သရေသည် သူတို့၏ခွန်အားဖြစ်၏။ အသက်ကြီးသောသူတို့၏ခန့်ညားထည်ဝါမှုကား ဖြူသောဆံပင်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />ဒဏ်ရာဒဏ်ချက်သည် မကောင်းမှုကိုလည်းကောင်း၊ ရိုက်နှက်ခြင်းသည် အတွင်းအကျဆုံးနေရာများကိုလည်းကောင်း ဆေးကြောသန့်စင်ပေး၏။
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />ရှင်ဘုရင်၏စိတ်နှလုံးသည် ထာဝရဘုရား၏လက်တော်၌ရှိ၍ ရေစီးသောချောင်းများကဲ့သို့ဖြစ်၏။ ကိုယ်တော်သည် ၎င်းကို အလိုတော်ရှိသည့် နေရာတိုင်းသို့ လှည့်စေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />လူသည် မိမိပြုမူကျင့်ကြံသမျှသောအမှုအရာတို့ကို မှန်သည်ဟု ထင်မြင်တတ်၏။ သို့သော် ထာဝရဘုရားသည် စိတ်နှလုံးကိုချိန်တွယ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ထာဝရဘုရားသည် ယဇ်ပူဇော်ခြင်းထက် ဖြောင့်မတ်ခြင်းနှင့် တရားမျှတခြင်းကို ပို၍နှစ်သက်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဆိုးယုတ်သောသူတို့၏မီးခွက်တည်းဟူသော ထောင်လွှားသောမျက်နှာနှင့် မော်ကြွားသောစိတ်နှလုံးတို့သည် အပြစ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဝီရိယရှိသောသူ၏အကြံအစည်တို့သည် အကျိုးအမြတ်ကို ဧကန်ဖြစ်စေ၏။ အလျင်စလိုပြုမူသောသူတိုင်းကား ချို့တဲ့နွမ်းပါးခြင်းသို့သာရောက်တတ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />မုသားသုံးသောလျှာဖြင့် ဥစ္စာဘဏ္ဍာများကိုဆည်းပူးခြင်းသည် လွင့်သွားသောအခိုးအငွေ့ဖြစ်ပြီး သေခြင်းကိုရှာဖွေခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဆိုးယုတ်သောသူတို့သည် တရားသောအမှုကိုမပြုလိုကြသောကြောင့် သူတို့၏အကြမ်းဖက်မှုသည် သူတို့ကိုသုတ်သင်ရှင်းလင်းလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="8" style="v" />အပြစ်ရှိသောသူ၏လမ်းသည် ကွေ့ကောက်၏။ သန့်ရှင်းစင်ကြယ်သောသူ၏လုပ်ဆောင်ချက်မူကား ဖြောင့်မှန်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ငြင်းခုံရန်တွေ့တတ်သောမယားနှင့် တစ်အိမ်တည်းအတူနေရခြင်းထက် ခေါင်မိုးပြင်ထောင့်၌နေရခြင်းသည် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဆိုးယုတ်သောသူ၏စိတ်ဝိညာဉ်သည် မကောင်းမှုကို တောင့်တတတ်၏။ သူ၏အိမ်နီးချင်းသည် သူ့မျက်ဝန်း၌ သနားတတ်သောသဘောကိုရှာမတွေ့။
  </para>
  <para style="p">
    <verse number="11" style="v" />ပြက်ရယ်ပြုတတ်သောသူ အပြစ်ဒဏ်ခံရသောအခါ အသိဉာဏ်နည်းပါးသောသူသည် ဉာဏ်ပညာရှိလာတတ်၏။ ပညာရှိသောသူသည် သွန်သင်ခြင်းခံရသောအခါ အသိပညာတိုးပွားတတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဖြောင့်မတ်တော်မူသောအရှင်သည် ဆိုးယုတ်သောသူ၏အိမ်ကိုမှတ်၍ ထိုဆိုးယုတ်သောသူတို့ကို ပျက်စီးခြင်းထဲသို့ ပစ်ချတော်မူ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဆင်းရဲသောသူ၏ငိုကြွေးသံကိုမကြားလို၍ မိမိနားကိုပိတ်ထားသောသူသည် ကိုယ်တိုင်ဟစ်ခေါ်သောအခါ မည်သူမျှ သူ့ကိုထူးလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />တိတ်တဆိတ်ပေးသောလက်ဆောင်သည် အမျက်ကိုလည်းကောင်း၊ လျှို့ဝှက်စွာပေးသောတံစိုးလက်ဆောင်သည် ပြင်းထန်သောအမျက်ဒေါသကိုလည်းကောင်း ပြေစေတတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />တရားသောအမှုကိုပြုခြင်းသည် ဖြောင့်မတ်သောသူတို့အတွက် ဝမ်းမြောက်ခြင်းဖြစ်၍ အပြစ်ဒုစရိုက်ပြုသောသူတို့အတွက် ထိတ်လန့်ခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ပညာသတိလမ်းမှလွဲသွားသောသူသည် သေသူ၏ဝိညာဉ်အစုအဝေးထဲ၌ နေရာကျလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />အပျော်အပါးကိုနှစ်သက်သောသူသည် ချို့တဲ့နွမ်းပါးသောသူဖြစ်သွားလိမ့်မည်။ စပျစ်ဝိုင်နှင့်ဆီကိုနှစ်သက်သောသူသည်လည်း ချမ်းသာကြွယ်ဝလာလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဆိုးယုတ်သောသူသည် ဖြောင့်မတ်သောသူအတွက်လည်းကောင်း၊ သစ္စာမဲ့သောသူသည် ဖြောင့်မှန်သောသူအတွက်လည်းကောင်း ရွေးနုတ်စရာအဖိုးအခဖြစ်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="19" style="v" />စိတ်ဆတ်၍ ငြင်းခုံရန်တွေ့တတ်သောမယားနှင့် နေရခြင်းထက် တောကန္တာရအရပ်၌နေရခြင်းသည် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ပညာရှိသောသူ၏အိမ်၌ နှစ်လိုဖွယ်ကောင်းသောဥစ္စာဘဏ္ဍာနှင့် ဆီရှိ၏။ မိုက်မဲသောသူကား ထိုအရာတို့ကို သုံးဖြုန်းတတ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဖြောင့်မတ်ခြင်းနှင့် မေတ္တာကရုဏာကို လက်ကိုင်ပြုသောသူသည် အသက်ရှင်ခြင်း၊ ဖြောင့်မတ်ခြင်းနှင့် ဂုဏ်သရေကို တွေ့ရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />ပညာရှိသောသူသည် သူရဲကောင်းတို့၏မြို့သို့ ချီတက်၍ သူတို့ကိုးစားသော ခိုင်ခံ့သည့်နေရာကို ဖြိုချတတ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />မိမိနှုတ်နှင့် လျှာကို စောင့်ထိန်းသောသူသည် မိမိအသက်ကို ဆင်းရဲဒုက္ခမှ စောင့်ထိန်းသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />မာနထောင်လွှားလျက် ခက်ထန်မောက်မာသောသူ၏အမည်မှာ “ပြက်ရယ်ပြုတတ်သောသူ” ဟူ၍ဖြစ်၏။ သူသည် အလွန်မာနထောင်လွှားသောစိတ်နှင့် ပြုမူတတ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />ပျင်းရိသောသူ၏လက်သည် အလုပ်လုပ်ရန်ငြင်းဆန်သောကြောင့် သူ၏အလိုဆန္ဒသည် သူ့ကိုသေစေတတ်၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />သူသည် အလိုရှိသည့်အရာကို တစ်နေ့လုံး တောင့်တနေတတ်၏။ ဖြောင့်မတ်သောသူမူကား တွန့်တိုခြင်းမရှိဘဲ ပေးကမ်းတတ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဆိုးယုတ်သောသူ၏ယဇ်ကောင်သည် စက်ဆုပ်ရွံရှာဖွယ်ဖြစ်၏။ ထို့ထက်မက ၎င်းကို ဆိုးညစ်သောအကြံဖြင့် ယူဆောင်လာလျှင် ပို၍ပင် စက်ဆုပ်ရွံရှာဖွယ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />လိမ်လည်သောသက်သေသည် ပျက်စီးသွားလိမ့်မည်။ ကိုယ်တိုင်ကြားရသောသူမူကား အစဉ်ပြောဆိုနေလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="29" style="v" />ဆိုးယုတ်သောသူသည် မျက်နှာပြောင်တိုက်တတ်၏။ ဖြောင့်မှန်သောသူမူကား မိမိသွားရာလမ်းကို သိရှိနားလည်၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />မည်သည့်ဉာဏ်ပညာ၊ ထိုးထွင်းဉာဏ်၊ အကြံဉာဏ်မျှ ထာဝရဘုရားကိုဆန့်ကျင်၍ မတည်နိုင်။
  </para>
  <para style="p">
    <verse number="31" style="v" />စစ်တိုက်ရမည့်နေ့အတွက် မြင်းကိုပြင်ဆင်ထားသော်လည်း အောင်ပွဲသည် ထာဝရဘုရားနှင့်ဆိုင်၏။
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />များစွာသောဓနဥစ္စာထက် ဂုဏ်သတင်းကျော်စောခြင်းကို ရွေးချယ်သင့်၏။ မျက်နှာရခြင်းသည် ရွှေ၊ ငွေတို့ထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ချမ်းသာသောသူနှင့် ဆင်းရဲသောသူတို့၏ တူညီသောအချက်မှာ သူတို့အားလုံးကို ထာဝရဘုရားဖန်ဆင်းတော်မူခြင်းပင်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဆင်ခြင်ဉာဏ်ရှိသောသူသည် ဘေးအန္တရာယ်ကိုမြင်၍ ပုန်းရှောင်တတ်၏။ အသိပညာနည်းပါးသောသူမူကား ဆက်သွား၍ အပြစ်ဒဏ်ခံရတတ်၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />စိတ်နှိမ့်ချခြင်းနှင့် ထာဝရဘုရားကိုကြောက်ရွံ့ခြင်းအကျိုးကား ဓနဥစ္စာ၊ ဂုဏ်သရေနှင့် အသက်ရှင်ခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ကောက်ကျစ်သောသူ၏လမ်း၌ ဆူးပင်များနှင့် ကျော့ကွင်းများရှိကြ၏။ မိမိ၏စိတ်ဝိညာဉ်ကိုစောင့်ထိန်းသောသူသည် ထိုအရာတို့ကို ဝေးဝေးရှောင်တတ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ကလေးသူငယ်ကိုသွန်သင်၍ သူသွားရမည့်လမ်းသို့ဦးတည့်ပေးလော့။ သို့ပြုလျှင် သူသည်အသက်ကြီးသောအခါ ထိုလမ်းမှမဖယ်ခွာဘဲနေလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ချမ်းသာသောသူသည် ဆင်းရဲသောသူကို အုပ်စိုးရ၏။ ချေးယူသောသူသည်လည်း ချေးပေးသောသူ၏ ကျွန်ဖြစ်ရ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />မတရားမှုမျိုးစေ့ကိုကြဲသောသူသည် ဆင်းရဲဒုက္ခကိုရိတ်သိမ်းရ၍ သူ၏ဒေါသကြိမ်လုံးသည် ပျက်စီးသွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />စေတနာစိတ်ရှိသောသူသည် မိမိ၏အစားအစာကို ဆင်းရဲသောသူအား ပေးကမ်းသောကြောင့် ကောင်းချီးမင်္ဂလာခံစားရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ပြက်ရယ်ပြုတတ်သောသူကို နှင်ထုတ်လော့။ သို့ပြုလျှင် အငြင်းပွားမှုသည် ထွက်သွား၍ ခိုက်ရန်ဖြစ်ခြင်းနှင့်အရှက်ကွဲခြင်းသည်လည်း အဆုံးသတ်သွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />စိတ်နှလုံးစင်ကြယ်ခြင်းကိုနှစ်သက်၍ ယဉ်ကျေးသိမ်မွေ့စွာပြောဆိုတတ်သောသူသည် ရှင်ဘုရင်၏မိတ်ဆွေဖြစ်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ထာဝရဘုရား၏မျက်စိတော်သည် အသိပညာကို ထိန်းသိမ်းစောင့်ရှောက်တော်မူ၏။ သစ္စာမဲ့သောသူ၏စကားတို့ကိုကား မှားယွင်းချွတ်ချော်စေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ပျင်းရိသောသူက “အပြင်ဘက်၌ ခြင်္သေ့ရှိ၏။ ငါသည် လမ်းမပေါ်တွင် ကိုက်သတ်ခံရလိမ့်မည်”ဟု ဆိုတတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />အကျင့်ဖောက်ပြားသောမိန်းမတို့၏နှုတ်သည် နက်သောတွင်းဖြစ်၏။ ထာဝရဘုရား၏အမျက်တော်သင့်သောသူသည် ထိုတွင်းထဲသို့ကျရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />မိုက်မဲခြင်းသည် ကလေးသူငယ်၏စိတ်နှလုံးတွင် နှောင်ဖွဲ့လျက်ရှိ၏။ သို့သော် ဆုံးမပဲ့ပြင်သောကြိမ်လုံးသည် ၎င်းကို သူနှင့်ဝေးကွာစေလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="16" style="v" />မိမိဥစ္စာတိုးပွားစေရန် ဆင်းရဲသောသူကိုနှိပ်စက်သောသူ၊ သို့မဟုတ် ချမ်းသာသောသူကို ပေးကမ်းသောသူသည် အမှန်ပင် ချို့တဲ့နွမ်းပါးခြင်းသို့ရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />သင့်နားကိုစွင့်၍ ပညာရှိတို့၏စကားများကို နားထောင်လော့။ သင့်စိတ်နှလုံး၌ ငါ၏အသိပညာကို သွင်းထားလော့။
  </para>
  <para style="p">
    <verse number="18" style="v" />အကြောင်းမူကား ထိုအရာတို့ကို သင့်အထဲ၌ စောင့်ထိန်းထား၍ ထိုအရာရှိသမျှတို့ကို သင်၏နှုတ်၌အသင့်ရှိစေလျှင် နှစ်လိုဖွယ်ကောင်းသောအရာဖြစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="19" style="v" />သင်သည် ထာဝရဘုရားကိုကိုးစားမည့်အကြောင်း သင့်ကို အထူးသဖြင့်သင့်ကို ယနေ့ ငါသွန်သင်လေပြီ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ငါသည် အကြံပြုချက်နှင့်အသိပညာဆိုင်ရာ စကားအခွန်းသုံးဆယ်ကို သင့်အတွက် ရေးထားပြီမဟုတ်လော။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဤသည်ကား သင်သည် မှန်ကန်သောစကားစစ်စစ်တို့ကို သိစေရန်နှင့် သင့်ကိုစေလွှတ်သောသူများအား မှန်ကန်သောစကားတို့ဖြင့် ဖြေကြားနိုင်ရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဆင်းရဲသောသူကို ဆင်းရဲသည်ဆို၍ ခေါင်းပုံမဖြတ်နှင့်။ အဖိနှိပ်ခံရသောသူကိုလည်း မြို့တံခါး၌ မညှဉ်းဆဲနှင့်။
  </para>
  <para style="p">
    <verse number="23" style="v" />အကြောင်းမူကား ထာဝရဘုရားသည် သူတို့၏အမှုကိစ္စကို ရင်ဆိုင်ဖြေရှင်းပေး၍ သူတို့ထံမှလုယူသောသူတို့၏အသက်ကို လုယူတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="24" style="v" />စိတ်တိုသောသူနှင့် မပေါင်းဖော်နှင့်။ ဒေါသကြီးသောသူနှင့်အတူ မလိုက်နှင့်။
  </para>
  <para style="p">
    <verse number="25" style="v" />လိုက်လျှင် သင်သည် သူ၏လမ်းစဉ်တို့ကိုသင်ယူ၍ သင်ကိုယ်တိုင် ထောင်ချောက်မိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ကတိခံဝန်ချက်ပေးသောသူများနှင့် ကြွေးမြီများအတွက် အာမခံသောသူများထဲတွင် မပါနှင့်။
  </para>
  <para style="p">
    <verse number="27" style="v" />သင်၌ပေးလျော်ရန်မရှိသောအခါ သင့်ကိုယ်အောက်မှ သင့်အိပ်ရာကိုယူသွားလျှင် မည်သို့နည်း။
  </para>
  <para style="p">
    <verse number="28" style="v" />သင်၏ဘိုးဘေးများစိုက်ထူခဲ့သော ရှေးယခင်နယ်နိမိတ်ကို မရွှေ့နှင့်။
  </para>
  <para style="p">
    <verse number="29" style="v" />မိမိအလုပ်တွင် ကျွမ်းကျင်သောသူကို သင်မြင်သလော။ ထိုသူသည် ရှင်ဘုရင်တို့ရှေ့မှောက်၌ ခစားရလိမ့်မည်။ သာမန်လူတို့ရှေ့၌ ခစားရလိမ့်မည်မဟုတ်။
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />သင်သည် အုပ်စိုးသူမင်းနှင့်အတူ စားသောက်ရန် ထိုင်သောအခါ သင်၏ရှေ့၌ရှိသောအရာတို့ကို သတိနှင့်ဆင်ခြင်သုံးသပ်လော့။
  </para>
  <para style="p">
    <verse number="2" style="v" />သင်သည် အစားကြီးသောသူဖြစ်ပါက သင်၏လည်ပင်းကို ဓားနှင့်ရွယ်ထားလော့။
  </para>
  <para style="p">
    <verse number="3" style="v" />သူ၏စားကောင်းသောက်ဖွယ်များကို မတောင့်တနှင့်။ အကြောင်းမူကား ၎င်းသည် လိမ်လည်မှုနှင့်ဆိုင်သောအစားအစာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ချမ်းသာကြွယ်ဝစေရန် ပင်ပန်းကြီးစွာမပြုနှင့်။ သင်၏အသိဉာဏ်အားဖြင့် ထိုသို့ပြုခြင်းကိုရပ်တန့်လော့။
  </para>
  <para style="p">
    <verse number="5" style="v" />ထိုချမ်းသာကြွယ်ဝမှုကို သင်၏မျက်စိဖြင့် ဝေ့ကြည့်လိုက်သောအခါ ၎င်းသည် ရှိတော့မည်မဟုတ်။ အကြောင်းမူကား ၎င်းသည် ရုတ်တရက်အတောင်ပေါက်၍ လင်းယုန်ကဲ့သို့ ကောင်းကင်သို့ပျံသန်းသွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />စေးနှဲသောသူ၏အစားအစာကိုမစားနှင့်။ သူ၏စားကောင်းသောက်ဖွယ်များကိုလည်း မတောင့်တနှင့်။
  </para>
  <para style="p">
    <verse number="7" style="v" />အကြောင်းမူကား သူသည် မိမိစိတ်ထဲ၌ တွက်ချက်တတ်သောသူမျိုးဖြစ်၏။ သူသည် သင့်အား “စားလော့။ သောက်လော့”ဟု ဆိုသော်လည်း သင့်အပေါ် စေတနာစိတ်မရှိ။
  </para>
  <para style="p">
    <verse number="8" style="v" />သင်စားပြီးသော တစ်လုတ်စာကို အန်ထုတ်ရလိမ့်မည်။ သင်၏နှစ်လိုဖွယ်ကောင်းသောစကားတို့သည်လည်း အလဟဿဖြစ်သွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />မိုက်မဲသောသူ၏ရှေ့တွင် စကားမပြောနှင့်။ အကြောင်းမူကား သူသည် သင်၏စကားများ၌ပါသောဉာဏ်စွမ်းကို မထီမဲ့မြင်ပြုလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ရှေးယခင်နယ်နိမိတ်အမှတ်အသားကို မရွှေ့နှင့်။ ဖတဆိုးတို့၏လယ်ယာများကို မကျူးကျော်နှင့်။
  </para>
  <para style="p">
    <verse number="11" style="v" />သူတို့ကိုရွေးနုတ်သောအရှင်သည် တန်ခိုးကြီးတော်မူသောကြောင့် သင့်ကိုဆန့်ကျင်လျက် သူတို့၏အမှုကိစ္စကို ရင်ဆိုင်ဖြေရှင်းပေးတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဆုံးမပဲ့ပြင်ခြင်းကို နှလုံးသွင်း၍ အသိပညာစကားတို့ကို နားစွင့်လော့။
  </para>
  <para style="p">
    <verse number="13" style="v" />ကလေးသူငယ်ကို ဆုံးမပဲ့ပြင်ခြင်းမပြုဘဲမနေနှင့်။ သူ့ကိုကြိမ်လုံးနှင့်ရိုက်သော်လည်း သူမသေနိုင်။
  </para>
  <para style="p">
    <verse number="14" style="v" />သင်သည် သူ့ကိုကြိမ်လုံးနှင့်ရိုက်၍ သူ၏စိတ်ဝိညာဉ်ကို မရဏာနိုင်ငံမှကယ်နုတ်ရမည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ငါ့သား၊ သင်၏စိတ်နှလုံးသည် ဉာဏ်ပညာရှိလျှင် ငါ၏စိတ်နှလုံးသည်လည်း အမှန်ပင်ဝမ်းမြောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="16" style="v" />သင်၏နှုတ်ခမ်းသည် ဟုတ်မှန်သောအရာများကိုပြောဆိုသောအခါ ငါ၏အတွင်းသဘောသည် ရွှင်မြူးလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />သင်၏စိတ်နှလုံးသည် အပြစ်သားတို့ကို မငြူစူနှင့်။ တစ်နေ့လုံး ထာဝရဘုရားကို ကြောက်ရွံ့၍သာနေလော့။
  </para>
  <para style="p">
    <verse number="18" style="v" />သို့ပြုလျှင် သင့်အတွက် အနာဂတ် မုချရှိလိမ့်မည်။ သင်၏မျှော်လင့်ခြင်းသည်လည်း ဖျက်ဆီးခြင်းခံရလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ငါ့သား၊ သင်သည်နားထောင်၍ ဉာဏ်ပညာရှိလော့။ သင်၏စိတ်နှလုံးကိုလည်း လမ်းတော်သို့ လိုက်စေလော့။
  </para>
  <para style="p">
    <verse number="20" style="v" />စပျစ်ဝိုင်သောက်ကြူးသောသူများ၊ အသားစားကြူးသောသူများနှင့် မပေါင်းဖော်နှင့်။
  </para>
  <para style="p">
    <verse number="21" style="v" />အကြောင်းမူကား အသောက်ကြူးသောသူနှင့် အစားကြူးသောသူသည် ဆင်းရဲသွားလိမ့်မည်။ ငိုက်မျဉ်းခြင်းသည်လည်း လူကိုအဝတ်စုတ်များဝတ်စေလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />သင့်ကိုမွေးဖွားလာစေသော သင့်ဖခင်၏စကားကို နားထောင်လော့။ သင့်မိခင်အိုမင်းသောအခါလည်း မထီမဲ့မြင်မပြုနှင့်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သမ္မာတရားကိုဝယ်ယူလော့။ မရောင်းနှင့်။ ဉာဏ်ပညာ၊ ဆုံးမပဲ့ပြင်ခြင်းနှင့် အသိဉာဏ်ကိုလည်း ထိုနည်းတူပြုလော့။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဖြောင့်မတ်သောသူ၏ဖခင်သည် အလွန်ရွှင်လန်းလိမ့်မည်။ ပညာရှိသောသားကိုရသောသူသည်လည်း ထိုသားအတွက် ဝမ်းမြောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="25" style="v" />သင်၏မိခင်နှင့်ဖခင်တို့သည် ဝမ်းမြောက်ကြပါစေ။ သင့်ကိုမွေးဖွားသောသူသည် ရွှင်လန်းပါစေ။
  </para>
  <para style="p">
    <verse number="26" style="v" />ငါ့သား၊ သင်၏စိတ်နှလုံးကို ငါ့အားပေးလော့။ သင်၏မျက်စိသည်လည်း ငါ၏လမ်းတို့ကို ထိန်းသိမ်းစောင့်ရှောက်ပါစေ။
  </para>
  <para style="p">
    <verse number="27" style="v" />အကြောင်းမူကား ပြည့်တန်ဆာသည် နက်သောတွင်းဖြစ်၏။ ကိုယ်ကျင့်တရားပျက်ပြားသောမိန်းမသည်လည်း ကျဉ်းသောရေတွင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ထိုမိန်းမသည် ဓားပြကဲ့သို့ချောင်းမြောင်း၍ ယောက်ျားတို့ထဲတွင် သစ္စာမဲ့သောသူကိုများပြားစေတတ်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />မည်သူသည် အမင်္ဂလာရှိသနည်း။ မည်သူသည် စိတ်ပျက်ဝမ်းနည်းတတ်သနည်း။ မည်သူသည် ငြင်းခုံရန်တွေ့တတ်သနည်း။ မည်သူသည် ညည်းတွားတတ်သနည်း။ မည်သူသည် အကြောင်းမဲ့ဒဏ်ရာများရတတ်သနည်း။ မည်သူသည် မျက်စိနီရဲနေတတ်သနည်း။
  </para>
  <para style="p">
    <verse number="30" style="v" />ထိုသို့ဖြစ်သူများမှာ စပျစ်ဝိုင်ကိုအချိန်ကြာမြင့်စွာ သောက်တတ်သူများ၊ ရောစပ်ထားသောစပျစ်ဝိုင်ကို သွား၍ရှာတတ်သူများပင်ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />အရောင်နီလျက်၊ ခွက်ဖလားထဲ၌အရောင်တောက်လျက် ချိုမြိန်စွာစီးဝင်သွားသောစပျစ်ဝိုင်ကိုမကြည့်နှင့်။
  </para>
  <para style="p">
    <verse number="32" style="v" />ထိုအရာသည် အဆုံး၌ မြွေကဲ့သို့ကိုက်၍ မြွေပွေးကဲ့သို့အဆိပ်သင့်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />သင်၏မျက်စိသည် ထူးဆန်းသောအရာတို့ကိုမြင်၍ သင်၏စိတ်နှလုံးသည် ဖောက်ပြန်လွဲမှားသောစကားတို့ကိုပြောဆိုလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="34" style="v" />သင်သည် ပင်လယ်အလယ်ဗဟို၌ လဲလျောင်းနေသောသူကဲ့သို့လည်းကောင်း၊ သင်္ဘောရွက်တိုင်၏ထိပ်ဖျား၌ လဲလျောင်းနေသောသူကဲ့သို့လည်းကောင်း ဖြစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="35" style="v" />“သူတို့သည် ငါ့ကိုရိုက်ကြသော်လည်း ငါမနာ။ ငါ့ကိုထုရိုက်ကြသော်လည်း ငါမသိ။ မည်သည့်အချိန်မှ ငါနိုးမည်နည်း။ နောက်ထပ်သောက်ရန် ငါရှာဦးမည်”ဟု သင်ပြောဆိုလိမ့်မည်။
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />မကောင်းမှုပြုသောသူတို့ကိုမငြူစူနှင့်။ သူတို့နှင့်ပေါင်းဖော်ရန်လည်း အလိုမရှိနှင့်။
  </para>
  <para style="p">
    <verse number="2" style="v" />အကြောင်းမူကား သူတို့၏စိတ်နှလုံးသည် အကြမ်းဖက်မှုကို ကြံစည်တတ်၏။ သူတို့၏နှုတ်ခမ်းသည်လည်း ပြဿနာဖြစ်စေသောစကားကို ပြောဆိုတတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဉာဏ်ပညာအားဖြင့် အိမ်ကိုတည်ဆောက်၍ ထိုးထွင်းဉာဏ်အားဖြင့် ၎င်းကိုမြဲမြံစေရ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />အသိပညာအားဖြင့် အခန်းများသည် အဖိုးတန်၍ နှစ်လိုဖွယ်ကောင်းသောစည်းစိမ်ဥစ္စာအပေါင်းတို့နှင့် ပြည့်ရ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ပညာရှိသောသူသည် အစွမ်းသတ္တိရှိ၏။ အသိပညာရှိသောသူသည်လည်း ခွန်အားတိုးပွားတတ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />အကယ်စင်စစ် သင်သည် လမ်းညွှန်မှုခံယူခြင်းအားဖြင့် သင်၏စစ်ပွဲကိုဆင်နွှဲရမည်။ အကြံပေးသူများစွာရှိခြင်းအားဖြင့် အောင်ပွဲရတတ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဆိုးမိုက်သောသူအတွက် ဉာဏ်ပညာသည် မြင့်မားလွန်း၏။ သူသည် မြို့တံခါး၌ မိမိနှုတ်ကိုမဖွင့်ပေ။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဆိုးညစ်သောအမှုပြုရန်ကြံစည်သောသူကို အကြံသမားဟုခေါ်ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />မိုက်မဲဆိုးညစ်သောအကြံသည် အပြစ်ဖြစ်၏။ ပြက်ရယ်ပြုတတ်သောသူသည်လည်း လူတို့အတွက်စက်ဆုပ်ရွံရှာဖွယ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />သင်သည် ဆင်းရဲဒုက္ခရောက်သောကာလ၌ စိတ်အားလျော့လျှင် သင်၏ခွန်အားသည် နည်းလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />သေရာသို့ခေါ်ဆောင်သွားခြင်းခံရသောသူတို့နှင့် ကွပ်မျက်ရာသို့ဒယိမ်းဒယိုင်သွားနေသောသူတို့ကို ကယ်နုတ်လော့။ အကယ်၍ ထိုသို့မပြုဘဲ
  </para>
  <para style="p">
    <verse number="12" style="v" />“ထိုအမှုကို ငါတို့မသိခဲ့ပါ”ဟု သင်ဆိုလျှင်လည်း စိတ်နှလုံးတို့ကိုချိန်တွယ်တော်မူသောအရှင်သည် ထိုအရာကိုမသိနားမလည်ဘဲနေမည်လော။ သင်၏စိတ်ဝိညာဉ်ကို ထိန်းသိမ်းစောင့်ရှောက်တော်မူသောအရှင်သည် မသိဘဲနေမည်လော။ ကိုယ်တော်သည် လူတို့အား မိမိလုပ်ဆောင်မှုနှင့်အညီ မဆပ်ပေးဘဲနေမည်လော။
  </para>
  <para style="p">
    <verse number="13" style="v" />ငါ့သား၊ ပျားရည်သည် ကောင်းသောကြောင့် စားသုံးလော့။ ပျားလပို့မှပျားရည်သည် သင်၏လျှာ၌ချိုမြိန်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ထိုနည်းတူ ဉာဏ်ပညာသည် သင်၏စိတ်ဝိညာဉ်အတွက် ချိုမြိန်ကြောင်းသိမှတ်လော့။ ဉာဏ်ပညာကို သင်တွေ့ရှိပါက သင့်အတွက် အနာဂတ်ရှိလိမ့်မည်။ သင်၏မျှော်လင့်ခြင်းသည်လည်း ဖျက်ဆီးခြင်း ခံရလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />အချင်းဆိုးယုတ်သောသူ၊ ဖြောင့်မတ်သောသူ၏အိမ်ကို မချောင်းမြောင်းနှင့်။ သူအနားယူရာအရပ်ကို မဖျက်ဆီးနှင့်။
  </para>
  <para style="p">
    <verse number="16" style="v" />အကြောင်းမူကား ဖြောင့်မတ်သောသူသည် ခုနစ်ကြိမ်လဲကျသော်လည်း ပြန်ထလိမ့်မည်။ ဆိုးယုတ်သောသူတို့မူကား ဘေးအန္တရာယ်ကြောင့် ကျရှုံးရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />သင်၏ရန်သူလဲကျသောအခါ ဝမ်းမြောက်ခြင်းမရှိနှင့်။ သူခလုတ်တိုက်သောအခါ၌လည်း သင်၏စိတ်နှလုံးရွှင်လန်းခြင်းမရှိစေနှင့်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ရှိလျှင်မူကား ထာဝရဘုရားသည်မြင်၍ မနှစ်မြို့သဖြင့် မိမိ၏အမျက်တော်ကို သူ့ထံမှလွှဲဖယ်တော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဆိုးညစ်သောအမှုကိုပြုသောသူတို့ကြောင့် စိတ်အနှောင့်အယှက်မဖြစ်နှင့်။ ဆိုးယုတ်သောသူတို့ကိုမငြူစူနှင့်။
  </para>
  <para style="p">
    <verse number="20" style="v" />အကြောင်းမူကား ဆိုးညစ်သောသူတို့အတွက် အနာဂတ်မရှိ။ ဆိုးယုတ်သောသူတို့၏မီးခွက်သည် ငြိမ်းသွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ငါ့သား၊ ထာဝရဘုရားနှင့်ရှင်ဘုရင်ကို ကြောက်ရွံ့လော့။ ဖောက်ပြန်ပြောင်းလဲသောသူတို့နှင့် ရောနှောဆက်ဆံခြင်းမပြုနှင့်။
  </para>
  <para style="p">
    <verse number="22" style="v" />အကြောင်းမူကား ဘေးဒုက္ခသည် သူတို့ထံမှရုတ်တရက်ရောက်လာတတ်၏။ ထိုအရှင်နှစ်ပါးထံမှရောက်လာမည့်ဘေးဆိုးကို မည်သူသိနိုင်မည်နည်း။
  </para>
  <para style="p">
    <verse number="23" style="v" />ထို့ပြင် ဤအရာများကား ပညာရှိတို့၏စကားဖြစ်၏။ တရားစီရင်ရာ၌ မျက်နှာလိုက်ခြင်းသည် မကောင်းပေ။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဆိုးယုတ်သောသူအား “သင်သည် ဖြောင့်မတ်သည်”ဟု ပြောဆိုသောသူကို လူတို့သည် ကျိန်ဆဲ၍ တိုင်းသူပြည်သားတို့သည် ရှုတ်ချကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="25" style="v" />သို့သော် ထိုဆိုးယုတ်သောသူကို ဆုံးမသောသူတို့သည် ရွှင်လန်းဝမ်းမြောက်ကြလိမ့်မည်။ ကြွယ်ဝသောကောင်းချီးမင်္ဂလာသည်လည်း သူတို့အပေါ်သို့သက်ရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />မှန်ကန်စွာဖြေကြားသောသူသည် နှုတ်ခမ်းကိုနမ်းသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />အပြင်၌ သင်၏အလုပ်ကို ပြင်ဆင်၍ လယ်ယာ၌ အရာရာကို သင့်အတွက်အဆင်သင့်ပြင်ထားလော့။ ထို့နောက်မှ သင့်အိမ်ကိုဆောက်လော့။
  </para>
  <para style="p">
    <verse number="28" style="v" />အကြောင်းမရှိဘဲ သင်၏အိမ်နီးချင်းကိုဆန့်ကျင်၍ သက်သေမထွက်ဆိုနှင့်။ သင်၏နှုတ်ခမ်းဖြင့် မလှည့်စားနှင့်။
  </para>
  <para style="p">
    <verse number="29" style="v" />“ငါ့အပေါ်သူပြုခဲ့သည့်အတိုင်း သူ့အပေါ်ငါပြုမည်။ သူ၏လုပ်ဆောင်မှုနှင့်အညီ သူ့ကို ငါတုံ့ပြန်မည်”ဟု မဆိုနှင့်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ငါသည် ပျင်းရိသောသူ၏လယ်ယာနား၊ အသိစိတ်မရှိသောသူ၏စပျစ်ခြံနားမှ ဖြတ်သွားရာ
  </para>
  <para style="p">
    <verse number="31" style="v" />ကြည့်ရှုလော့။ ဆူးပင်များအပြည့်ပေါက်လျက် တစ်ပြင်လုံးပေါင်းပင်များဖုံးလွှမ်းကာ ၎င်း၏ကျောက်တံတိုင်းလည်း ပြိုပျက်လျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />ငါသည် ထိုအဖြစ်ကိုမြင်သောအခါ နှလုံးသွင်း၍ ငါတွေ့မြင်သောအရာကို သင်ခန်းစာယူ၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />ခဏအိပ်လျက်၊ ခဏငိုက်လျက်၊ ခဏလက်ပိုက်အနားယူလျက်နေစဉ်
  </para>
  <para style="p">
    <verse number="34" style="v" />ဆင်းရဲခြင်းသည် သူခိုးဓားပြကဲ့သို့လည်းကောင်း၊ ချို့တဲ့နွမ်းပါးခြင်းသည် လက်နက်ကိုင်ဆောင်သူကဲ့သို့လည်းကောင်း သင့်ထံသို့ရောက်လာလိမ့်မည်။
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဤစကားတို့သည်လည်း ယုဒရှင်ဘုရင်ဟေဇကိ၏လူတို့ ကူးရေးထားသော ရှောလမုန်၏ သုတ္တံစကားများဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဘုရားသခင်၏ဘုန်းအသရေကား အမှုကိစ္စကိုဝှက်ထားခြင်းဖြစ်၏။ ရှင်ဘုရင်တို့၏ဘုန်းအသရေကား အမှုကိစ္စကိုစူးစမ်းခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />မိုးကောင်းကင်၏အမြင့်နှင့်မြေကြီး၏အနက်ကို စူးစမ်း၍မရသကဲ့သို့ ရှင်ဘုရင်တို့၏စိတ်နှလုံးကို စူးစမ်း၍မရနိုင်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ငွေထဲမှ ချော်ကိုဖယ်ထုတ်လျှင် ပန်းထိမ်သမားအတွက် အသုံးအဆောင်ပစ္စည်းထွက်လာမည်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ရှင်ဘုရင်၏ရှေ့မှောက်မှ ဆိုးယုတ်သောသူကိုဖယ်ထုတ်လျှင် သူ၏ရာဇပလ္လင်သည် ဖြောင့်မတ်ခြင်း၌ တည်မြဲလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ရှင်ဘုရင်၏ရှေ့မှောက်၌ သင့်ကိုယ်သင် အမွှမ်းမတင်နှင့်။ ကြီးမြတ်သောသူတို့၏နေရာ၌လည်း မရပ်နှင့်။
  </para>
  <para style="p">
    <verse number="7" style="v" />အကြောင်းမူကား မြင့်မြတ်သောသူ၏ရှေ့တွင် နှိမ့်ချခြင်းခံရသည်ထက် “ဤနေရာသို့တက်လာပါ”ဟု ဖိတ်ခေါ်ခြင်းခံရသည်က ပို၍ကောင်း၏။ သင့်မျက်စိဖြင့်တွေ့မြင်သောအရာကို
  </para>
  <para style="p">
    <verse number="8" style="v" />အလျင်စလိုသွား၍ မတိုင်တန်းနှင့်။ နောက်ဆုံး၌ သင်၏အိမ်နီးချင်းသည် သင့်ကိုအရှက်ရစေလျှင် သင်မည်သို့ပြုမည်နည်း။
  </para>
  <para style="p">
    <verse number="9" style="v" />သင်၏အမှုကိစ္စကို သင်၏အိမ်နီးချင်းနှင့် ရင်ဆိုင်ဖြေရှင်းလော့။ အခြားသောသူ၏လျှို့ဝှက်ချက်ကိုလည်း မဖော်ပြနှင့်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဖော်ပြလျှင် ကြားသောသူသည် သင့်ကိုအရှက်ခွဲသဖြင့် သင်၏မကောင်းသတင်းသည် မည်သည့်အခါမျှ ပျောက်ကွယ်သွားမည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />သင့်လျော်သောအချိန်၌ ပြောဆိုသောစကားသည် အပြောက်အမွမ်းခြယ်မှုန်းထားသောငွေထည်ပေါ်မှ ရွှေပန်းသီးများနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ပညာရှိ၏အဆုံးအမသည် နားထောင်တတ်သောသူ၏နားအတွက် ရွှေနားကွင်း၊ သို့မဟုတ် ရွှေစင်ဖြင့်ပြုလုပ်ထားသောအဆင်တန်ဆာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သစ္စာရှိသောစေတမန်သည် သူ့ကိုစေလွှတ်သောသူအတွက် ရိတ်သိမ်းရာကာလ၌ကျသော အေးမြသည့်နှင်းပွင့်ကဲ့သို့ဖြစ်၍ သူ့သခင်တို့၏စိတ်ဝိညာဉ်ကို လန်းဆန်းစေတတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />လက်ဆောင်မပေးဘဲ ပေးသည်ဟု ဝါကြွားသောသူသည် မိုးရေမပါသော မိုးတိမ်များနှင့်လေကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />စိတ်ရှည်ခြင်းအားဖြင့် ဦးစီးဦးဆောင်သူကို ဖျောင်းဖျနိုင်၏။ နူးညံ့သိမ်မွေ့သောစကားသည်လည်း အရိုးကိုကျိုးစေနိုင်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ပျားရည်ကိုတွေ့လျှင် သင့်အတွက် လုံလောက်ရုံမျှသာစားလော့။ ထိုသို့မစားဘဲ ဝအီအောင်စားလျှင် ၎င်းကိုအန်ထုတ်ရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />သင်၏အိမ်နီးချင်းအိမ်သို့ တစ်ခါတစ်ရံသာ ခြေဦးလှည့်လော့။ သို့မဟုတ်လျှင် သူသည် သင့်ကိုငြီးငွေ့၍ မုန်းလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />မိမိ၏အိမ်နီးချင်းတစ်ဖက်၌ မုသားသက်သေထွက်ဆိုသောသူသည် တင်းပုတ်၊ ဓား၊ ချွန်ထက်သောမြားနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဆင်းရဲဒုက္ခရောက်သောကာလ၌ သစ္စာမဲ့သောသူကိုအားထားခြင်းသည် ကျိုးပဲ့သောသွား၊ တုန်ချည့်နေသောခြေနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />စိတ်ဒုက္ခရောက်နေသောသူအား သီချင်းဆိုပြသောသူသည် ချမ်းအေးသောနေ့တွင် အဝတ်ကိုချွတ်သောသူနှင့်လည်းကောင်း၊ ချွတ်ဆေးပေါ်မှာ ရှာလကာရည်ကို လောင်းသောသူနှင့်လည်းကောင်း တူ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />သင့်ရန်သူ ဆာလောင်မွတ်သိပ်လျှင် သူ့ကိုစားစရာပေးလော့။ ရေငတ်လျှင် သူ့ကိုရေတိုက်လော့။
  </para>
  <para style="p">
    <verse number="22" style="v" />ထိုသို့ပြုလျှင် သင်သည် သူ၏ခေါင်းပေါ်၌ မီးခဲများကိုပုံထားလိမ့်မည်။ ထာဝရဘုရားသည်လည်း သင့်ကို ဆုလာဘ်ပေးတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="23" style="v" />မြောက်လေသည် မိုးကိုဖြစ်ပေါ်စေတတ်၏။ အတင်းပြောသောလျှာသည်လည်း ဒေါသမျက်နှာထားကို ဖြစ်ပေါ်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ငြင်းခုံရန်တွေ့တတ်သောမယားနှင့် တစ်အိမ်တည်းအတူနေရခြင်းထက် ခေါင်မိုးပြင်ထောင့်၌နေရခြင်းသည် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဝေးလံသောပြည်မှ ရောက်လာသောသတင်းကောင်းသည် မောပန်းသောစိတ်ဝိညာဉ်အတွက် အေးမြသောရေကဲ့သို့ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဆိုးယုတ်သောသူကို အလျှော့ပေးလိုက်လျောသည့် ဖြောင့်မတ်သောသူသည် နောက်ကျိသောစမ်းရေတွင်း၊ သို့မဟုတ် ညစ်ညမ်းသောရေတွင်းနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ပျားရည်ကို များစွာစားသုံးခြင်းသည်မကောင်းပေ။ ဂုဏ်သရေပေါ် ဂုဏ်သရေထပ်၍ရှာခြင်းသည်လည်း ထိုနည်းတူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />မိမိ၏စိတ်ကိုမချုပ်တည်းနိုင်သောသူသည် ပြိုပျက်၍တံတိုင်းမရှိသောမြို့နှင့်တူ၏။
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />နွေရာသီ၌ကျသော နှင်းပွင့်ကဲ့သို့လည်းကောင်း၊ ရိတ်သိမ်းချိန်၌ ရွာသောမိုးကဲ့သို့လည်းကောင်း ဂုဏ်သရေသည် မိုက်မဲသောသူနှင့်မသင့်လျော်ပေ။
  </para>
  <para style="p">
    <verse number="2" style="v" />လူးလာပျံဝဲသည့် စာငှက်ကဲ့သို့လည်းကောင်း၊ ပျံသန်းသွားလာသည့် ပျံလွှားငှက်ကဲ့သို့လည်းကောင်း အကြောင်းမဲ့ကျိန်ဆဲခြင်းသည် လာရောက်ရပ်နားခြင်းမရှိတတ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />မြင်းအတွက်ကျာပွတ်၊ မြည်းအတွက်ဇက်ကြိုးရှိ၏။ မိုက်မဲသောသူ၏ကျောကုန်းအတွက်ကား ကြိမ်လုံးရှိ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />မိုက်မဲသောသူကို သူ၏မိုက်မဲမှုနှင့်အညီ မဖြေကြားနှင့်။ ဖြေကြားလျှင် သင်သည်လည်း သူနှင့်တူသွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="5" style="v" />မိုက်မဲသောသူကို သူ၏မိုက်မဲမှုနှင့်အညီ ဖြေကြားလော့။ သို့မဟုတ်လျှင် သူသည် မိမိကိုယ်ကိုပညာရှိဟု ထင်မြင်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />မိုက်မဲသောသူ၏လက်ဖြင့် သတင်းပေးပို့သောသူသည် မိမိ၏ခြေကိုဖြတ်၍ ရက်စက်ကြမ်းကြုတ်မှုကို သောက်သုံးသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />မိုက်မဲသောသူတို့၏နှုတ်မှသုတ္တံစကားသည် ခြေမသန်စွမ်းသောသူ၏တွဲလျားကျနေသည့် ခြေတို့နှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />မိုက်မဲသောသူကို ဂုဏ်ပြုခြင်းသည် လောက်လွှဲတွင် ကျောက်ခဲကိုချည်ထားခြင်းနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />မိုက်မဲသောသူတို့၏နှုတ်မှသုတ္တံစကားသည် ယစ်မူးသူ၏လက်ထဲရောက်သွားသော ဆူးပင်နှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />မိုက်မဲသောသူကို ငှားရမ်းသောသူသည်လည်းကောင်း၊ ဖြတ်သန်းသွားလာသောသူတို့ကို ငှားရမ်းသောသူသည်လည်းကောင်း လူတိုင်းကိုထိခိုက်ဒဏ်ရာရစေသော လေးသမားနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ခွေးသည် မိမိအန်ဖတ်ကိုပြန်စားတတ်သကဲ့သို့ မိုက်မဲသောသူသည် မိမိပြုသောမိုက်မဲမှုကို ထပ်တလဲလဲပြုတတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />မိမိကိုယ်ကို ပညာရှိဟု ထင်မြင်သောသူကို သင်တွေ့မြင်သလော။ ထိုသူထက် မိုက်မဲသောသူ၌ ပို၍မျှော်လင့်ချက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ပျင်းရိသောသူက “လမ်းပေါ်၌ ခြင်္သေ့ကြီးရှိ၏။ လမ်းမ၌ ခြင်္သေ့ရှိ၏”ဟု ဆိုတတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />တံခါးရွက်သည် ပတ္တာတွင်လည်သကဲ့သို့ ပျင်းရိသောသူသည် မိမိ၏အိပ်ရာပေါ်တွင် လူးလိမ့်တတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ပျင်းရိသောသူသည် မိမိ၏လက်ကိုပန်းကန်ထဲသို့ နှိုက်သော်လည်း ၎င်းကိုမိမိပါးစပ်ထဲသို့ ပြန်သွင်းရမည်ကို ပင်ပန်းနေတတ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ပျင်းရိသောသူသည် ဆင်ခြင်တုံတရားဖြင့် ဖြေကြားနိုင်သူခုနစ်ဦးထက် ပညာရှိသည်ဟု ကိုယ့်ကိုယ်ကိုယ်ထင်မြင်တတ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />မိမိနှင့်မဆိုင်သောခိုက်ရန်ဖြစ်ပွားမှုကို ဝင်စွက်သောသူသည် ခွေးလေခွေးလွင့်၏နားရွက်ကို ဖမ်းဆွဲသောသူနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />မိမိ၏အိမ်နီးချင်းကို လှည့်စားပြီး “ငါသည် ကျီစားရုံသာဖြစ်၏”ဟု ပြောဆိုသောသူသည် သေစေတတ်သောမီးတုတ်နှင့် မြားကို ပစ်ခတ်တတ်သောအရူးနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ထင်းမရှိလျှင် မီးသည်ငြိမ်းသွားတတ်၏။ အတင်းအဖျင်းပြောဆိုသောသူမရှိလျှင်လည်း အငြင်းပွားမှုသည် ငြိမ်သက်သွားတတ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />မီးသွေးသည် မီးခဲရှိန်ကိုလည်းကောင်း၊ ထင်းသည် မီးရှိန်ကိုလည်းကောင်း လှုံ့ဆော်သကဲ့သို့ ငြင်းခုံရန်တွေ့တတ်သောသူသည် ခိုက်ရန်ဖြစ်ပွားခြင်းကို လှုံ့ဆော်တတ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />အတင်းအဖျင်းပြောဆိုသောသူ၏စကားတို့သည် စားကောင်းသောက်ဖွယ်များကဲ့သို့ဖြစ်၍ အတွင်းအကျဆုံးနေရာများသို့ ဆင်းသွားတတ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />မကောင်းသောစိတ်နှလုံးမှလာသည့် ချိုသာသောစကားတို့သည် ငွေချော်ဖြင့်မံထားသော မြေအိုးနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />အမုန်းထားသောသူသည် မိမိ၏နှုတ်ဖြင့် ဟန်ဆောင်ပြောဆိုသော်လည်း သူ၏စိတ်နှလုံးထဲ၌ လိမ်လည်လှည့်ဖြားသောသဘောကို ဆောင်ထားတတ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />သူ၏စကားသည် ချိုသော်လည်း သူ့ကိုမယုံနှင့်။ အကြောင်းမူကား သူ၏စိတ်နှလုံးထဲ၌ စက်ဆုပ်ရွံရှာဖွယ်ရာ ခုနစ်ပါးရှိ၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />သူသည် အမုန်းထားခြင်းကို ပရိယာယ်ဖြင့်ဖုံးကွယ်ထားသော်လည်း သူ၏မကောင်းမှုသည် လူပုံအလယ်တွင် ထင်ရှားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />တွင်းတူးသောသူသည် ထိုတွင်းထဲသို့ ကျလိမ့်မည်။ ကျောက်တုံးကိုလှိမ့်သောသူသည် သူ့အပေါ်သို့ ထိုကျောက်တုံး ပြန်လိမ့်လာလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="28" style="v" />မုသားသုံးသောလျှာသည် မိမိကြောင့် ထိခိုက်နာကျင်ရသောသူတို့ကိုမုန်းတတ်၏။ မြှောက်ပင့်တတ်သောနှုတ်သည်လည်း ပျက်စီးခြင်းကို ဖြစ်စေတတ်၏။
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />မနက်ဖြန်အတွက် မဝါကြွားနှင့်။ အကြောင်းမူကား တစ်ရက်အတွင်း မည်သို့ဖြစ်မည်ကို သင်မသိ။
  </para>
  <para style="p">
    <verse number="2" style="v" />သင့်နှုတ်မဟုတ်ဘဲ အခြားသောသူကလည်းကောင်း၊ သင့်နှုတ်ခမ်းမဟုတ်ဘဲ သူတစ်ပါးကလည်းကောင်း သင့်ကိုချီးမွမ်းပါစေ။
  </para>
  <para style="p">
    <verse number="3" style="v" />ကျောက်ခဲသည်လေး၍ သဲသည်အချိန်စီး၏။ သို့သော် ဆိုးမိုက်သောသူ၏အမျက်ဒေါသသည် ထိုအရာနှစ်ပါးထက် ပို၍လေး၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />အမျက်ဒေါသသည် ရက်စက်၍ အမျက်သည် လွှမ်းမိုးတတ်၏။ သို့သော် မနာလိုဝန်တိုမှုရှေ့၌ မည်သူခံရပ်နိုင်မည်နည်း။
  </para>
  <para style="p">
    <verse number="5" style="v" />ပွင့်လင်းစွာဆိုဆုံးမခြင်းသည် လျှို့ဝှက်စွာချစ်ခြင်းထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />မိတ်ဆွေပေးသောဒဏ်ရာများသည် သစ္စာနှင့်ယှဉ်၏။ ရန်သူပေးသောအနမ်းများမူကား လှည့်စားခြင်းနှင့်ယှဉ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />အစာဝသောသူသည် ပျားလပို့မှပျားရည်ကိုပင် နင်းချေတတ်၏။ ဆာလောင်မွတ်သိပ်သောသူအတွက်မူကား ခါးသောအရာရှိသမျှသည် ချိုမြိန်နေတတ်၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />မိမိအိမ်မှထွက်သွား၍ လှည့်လည်သွားလာသောသူသည် မိမိ၏အသိုက်မှထွက်သွား၍ လှည့်လည်သွားလာသောငှက်နှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />နံ့သာဆီနှင့်နံ့သာပေါင်းသည် စိတ်နှလုံးကိုဝမ်းမြောက်စေတတ်၏။ မိတ်ဆွေထံမှနှစ်လိုဖွယ်ကောင်းသောအရာကား စေတနာစိတ်ဖြင့် သူပေးသောအကြံဉာဏ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />သင်၏မိတ်ဆွေနှင့် သင့်ဖခင်၏မိတ်ဆွေကို မစွန့်ပယ်နှင့်။ သင်ဘေးဒုက္ခရောက်ချိန်၌ သင်၏ညီအစ်ကိုအိမ်သို့မသွားနှင့်။ အနီး၌ရှိသောအိမ်နီးချင်းသည် အဝေး၌ရှိသောညီအစ်ကိုထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ငါ့သား၊ ဉာဏ်ပညာရှိလော့။ ငါ၏စိတ်နှလုံးကိုလည်း ဝမ်းမြောက်စေလော့။ သို့ပြုလျှင် ငါ့ကိုကဲ့ရဲ့ပြစ်တင်သောသူအား တုံ့ပြန်ပြောဆိုနိုင်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဆင်ခြင်ဉာဏ်ရှိသောသူသည် ဘေးအန္တရာယ်ကိုမြင်၍ ပုန်းရှောင်တတ်၏။ အသိဉာဏ်နည်းပါးသောသူသည် ဆက်သွား၍ အပြစ်ဒဏ်ခံရတတ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူစိမ်းအတွက် အာမခံသောသူ၏အဝတ်ကို ယူထားလော့။ ကိုယ်ကျင့်တရားပျက်ပြားသောမိန်းမအတွက် အာမခံသောသူထံမှ အပေါင်ပစ္စည်းကိုယူထားလော့။
  </para>
  <para style="p">
    <verse number="14" style="v" />နံနက်စောစောထ၍ မိမိ၏အိမ်နီးချင်းကို ကျယ်လောင်သောအသံနှင့် ကောင်းချီးပေးသောသူသည် ကျိန်ဆဲနေသည်ဟု မှတ်ယူခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ငြင်းခုံရန်တွေ့တတ်သောမယားသည် မိုးရွာသောနေ့တွင် အဆက်မပြတ် တစက်စက်ယိုကျသောမိုးရေနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />သူ့ကိုထိန်းချုပ်ရခြင်းသည် လေကိုထိန်းချုပ်ခြင်း၊ သို့မဟုတ် ဆီကိုလက်ယာလက်ဖြင့် ဆုပ်ထားခြင်းနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />သံသည် သံကိုထက်စေသကဲ့သို့ လူသည်လည်း အခြားသောသူကိုထက်မြက်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />သဖန်းပင်ကိုထိန်းသိမ်းစောင့်ရှောက်သောသူသည် သဖန်းသီးကိုစားရလိမ့်မည်။ မိမိ၏သခင်ကို စောင့်ရှောက်သောသူသည် ဂုဏ်ပြုချီးမွမ်းခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ရေမျက်နှာပြင်သည် လူ၏မျက်နှာကိုထင်ဟပ်စေသကဲ့သို့ လူ၏စိတ်နှလုံးသည်လည်း လူကိုထင်ဟပ်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />မရဏာနိုင်ငံနှင့် ပျက်စီးခြင်းနိုင်ငံသည် မည်သည့်အခါမျှအလိုမပြည့်စုံသကဲ့သို့ လူ၏မျက်စိသည်လည်း မည်သည့်အခါမျှအလိုမပြည့်စုံတတ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ငွေကိုမိုက်ဖြင့်လည်းကောင်း၊ ရွှေကိုမီးပြင်းဖိုဖြင့်လည်းကောင်း စစ်ရ၏။ လူကိုကား သူခံရသောချီးမွမ်းစကားဖြင့် စစ်ရ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဆိုးမိုက်သောသူကို ဂျုံစေ့နှင့်အတူ ဆုံထဲထည့်၍ ကျည်ပွေ့နှင့်ထောင်းသော်လည်း သူ၏မိုက်မဲမှုသည် သူ့ထံမှဖယ်ခွာလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သင့်သိုးစု၏အခြေအနေတို့ကို ကောင်းစွာသိရှိပြီး သင်၏စိတ်ကိုတိရစ္ဆာန်အုပ်အပေါ် စူးစိုက်ထားလော့။
  </para>
  <para style="p">
    <verse number="24" style="v" />အကြောင်းမူကား စည်းစိမ်သည် အစဉ်အမြဲတည်သည်မဟုတ်။ ရာဇသရဖူသည်လည်း မျိုးဆက်အစဉ်အဆက် တည်သည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="25" style="v" />မြက်ပင်ကိုရှင်းပြီးနောက် မြက်နုများပေါက်လာတတ်၏။ တောင်များပေါ်မှ အပင်တို့ကို စုသိမ်းပြီးသောအခါတွင်
  </para>
  <para style="p">
    <verse number="26" style="v" />သိုးငယ်တို့သည် သင်၏အဝတ်တန်ဆာအတွက်ဖြစ်ပြီး ဆိတ်ထီးတို့သည် လယ်ယာအတွက်အဖိုးအခဖြစ်ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဆိတ်နို့သည်လည်း သင်စားဖို့၊ သင့်အိမ်သူအိမ်သားများစားဖို့နှင့် သင့်အစေခံမိန်းကလေးများကိုကျွေးဖို့ အလုံအလောက်ရှိလိမ့်မည်။
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဆိုးယုတ်သောသူသည် လိုက်သောသူမရှိဘဲလျက် ထွက်ပြေးတတ်၏။ ဖြောင့်မတ်သောသူမူကား ခြင်္သေ့ပျိုကဲ့သို့ရဲရင့်တည်ကြည်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />တိုင်းပြည်၌အပြစ်ကျူးလွန်ခြင်းရှိသောအခါ အုပ်ချုပ်သူများပြားလာတတ်၏။ သို့သော် သိမြင်နားလည်တတ်သောသူအားဖြင့် တိုင်းပြည်သည် ကြာရှည်တည်တံ့လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဆင်းရဲသောသူတို့ကိုနှိပ်စက်သော ဆင်းရဲသားသည် မည်သည့်အစားအစာမျှမကျန်အောင် တိုက်ချသွားသောမိုးရေနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ပညတ်တရားကိုစွန့်ပယ်သောသူတို့သည် ဆိုးယုတ်သောသူကိုချီးမွမ်းတတ်၏။ ပညတ်တရားကိုစောင့်ထိန်းသောသူတို့မူကား ဆိုးယုတ်သောသူတို့ကိုဆန့်ကျင်တတ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />မကောင်းမှုပြုသောသူတို့သည် တရားမျှတမှုကိုနားမလည်ကြ။ ထာဝရဘုရားကိုရှာသောသူတို့မူကား အပြည့်အဝနားလည်ကြ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />တည်ကြည်စွာလျှောက်လှမ်းသော ဆင်းရဲသောသူသည် ကွေ့ကောက်သောလမ်းကိုလိုက်သည့် ချမ်းသာသောသူထက် ပို၍ကောင်း၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ပညတ်တရားကိုလိုက်နာကျင့်သုံးသောသူသည် အသိဉာဏ်ရှိသောသားဖြစ်၏။ အစားကြူးသောသူများနှင့်ပေါင်းဖော်သောသူကား မိမိဖခင်ကိုအရှက်ရစေတတ်၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />အတိုးချခြင်းနှင့် အမြတ်ကြီးစားခြင်းဖြင့် မိမိ၏စည်းစိမ်ဥစ္စာကိုတိုးပွားစေသောသူသည် ဆင်းရဲသောသူတို့ကိုသနားတတ်သောသူအတွက် စုဆောင်းနေခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />တစ်စုံတစ်ဦးသည် ပညတ်တရားကိုနာယူနာခံခြင်းမရှိလျှင် သူ၏ဆုတောင်းချက်သည်ပင် စက်ဆုပ်ရွံရှာဖွယ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဖြောင့်မှန်သောသူကို မကောင်းသောလမ်းထဲသို့ လမ်းလွဲစေသောသူသည် မိမိ၏တွင်းထဲသို့ မိမိကိုယ်တိုင်ကျလိမ့်မည်။ အပြစ်တင်စရာမရှိသောသူတို့မူကား ကောင်းသောအရာကို အမွေဆက်ခံရကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ချမ်းသာသောသူသည် ကိုယ့်ကိုယ်ကိုယ် ပညာရှိဟု ထင်မြင်တတ်၏။ သို့သော် အသိဉာဏ်ရှိသောဆင်းရဲသားသည် သူ့ကိုစစ်ကြောလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဖြောင့်မတ်သောသူတို့ အောင်ပွဲခံကြသောအခါ ကြီးစွာသောဂုဏ်ကျက်သရေရှိ၏။ ဆိုးယုတ်သောသူတို့ ခေါင်းထောင်လာသောအခါ၌မူကား လူတို့သည် ပုန်းရှောင်တတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />မိမိကျူးလွန်သောအပြစ်များကို ဖုံးကွယ်ထားသောသူသည် ကြီးပွားမည်မဟုတ်။ ထိုအပြစ်များကိုဖော်ပြဝန်ခံ၍ စွန့်ပယ်သောသူမူကား ကရုဏာတော်ကိုခံစားရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဩတ္တပ္ပစိတ်အစဉ်အမြဲရှိသောသူသည် မင်္ဂလာရှိ၏။ မိမိ၏စိတ်နှလုံးကိုမာကျောစေသောသူမူကား ဒုက္ခတွင်းထဲသို့ကျရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆင်းရဲသောပြည်သူပြည်သားတို့ကို အုပ်စိုးသည့်ဆိုးယုတ်သောမင်းသည် ဟောက်သောခြင်္သေ့၊ သို့မဟုတ် တစ်ဟုန်ထိုးတိုက်ခိုက်သောဝက်ဝံနှင့်တူ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ထိုးထွင်းဉာဏ်ကင်းမဲ့သောအုပ်ချုပ်သူမင်းသည် အလွန်ဖိနှိပ်ညှဉ်းပန်းတတ်၏။ မတရားသောအကျိုးစီးပွားကိုရွံမုန်းသောသူသည် အသက်ရှည်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />လူ့အသက်သတ်ခြင်းအပြစ်ဝန်ကို ထမ်းသောသူသည် သေတွင်းထဲရောက်သည့်တိုင်အောင် ထွက်ပြေးတိမ်းရှောင်နေရလိမ့်မည်။ မည်သူမျှသူ့ကိုမထောက်မစေနှင့်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အပြစ်တင်စရာမရှိအောင်လျှောက်လှမ်းသောသူသည် ကယ်တင်ခြင်းခံရလိမ့်မည်။ ကွေ့ကောက်သောလမ်းသို့လိုက်သောသူမူကား ရုတ်တရက်လဲကျလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="19" style="v" />မိမိမြေကိုထွန်ယက်လုပ်ကိုင်သောသူသည် အစားအစာနှင့်ပြည့်စုံကြွယ်ဝလိမ့်မည်။ အချည်းနှီးသောအရာများနောက်သို့ လိုက်သောသူမူကား ဆင်းရဲခြင်းနှင့်ပြည့်ဝလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="20" style="v" />သစ္စာရှိသောသူသည် ကောင်းချီးမင်္ဂလာများစွာခံစားရလိမ့်မည်။ အလျင်စလိုချမ်းသာကြွယ်ဝလိုသောသူမူကား အပြစ်ဒဏ်နှင့်ကင်းလွတ်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />မျက်နှာလိုက်ခြင်းသည် မကောင်းပေ။ သို့သော် လူသည် မုန့်တစ်လုတ်စာအတွက် အပြစ်ကျူးလွန်တတ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />စေးနှဲသောသူသည် စည်းစိမ်ဥစ္စာရရန် အလျင်စလိုလုပ်ဆောင်သော်လည်း ဆင်းရဲခြင်းသည် သူ့ထံသို့ရောက်လာမည်ကို သူမသိချေ။
  </para>
  <para style="p">
    <verse number="23" style="v" />လူကိုဆုံးမသောသူသည် နောက်ဆုံးတွင် မြှောက်ပင့်ပြောဆိုသောသူထက် ပို၍မျက်နှာရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="24" style="v" />မိမိ၏ဖခင်၊ သို့မဟုတ် မိခင်၏ဥစ္စာကိုလုယူပြီးမှ ငါအပြစ်ကျူးလွန်သည်မဟုတ်ဟု ပြောဆိုသောသူသည် အဖျက်သမား၏အပေါင်းအဖော်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />လောဘကြီးသောသူသည် အငြင်းပွားမှုဖြစ်ရန်လှုံ့ဆော်တတ်၏။ ထာဝရဘုရားကိုယုံကြည်ကိုးစားသောသူမူကား ပြည့်စုံကြွယ်ဝလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />မိမိစိတ်နှလုံးကို ကိုးစားသောသူသည် မိုက်မဲသောသူဖြစ်၏။ ဉာဏ်ပညာအားဖြင့်လျှောက်လှမ်းသောသူမူကား ဘေးလွတ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဆင်းရဲသောသူတို့အား ပေးကမ်းသောသူသည် ချို့တဲ့နွမ်းပါးလိမ့်မည်မဟုတ်။ မျက်ကွယ်ပြုသောသူမူကား များစွာသောကျိန်ဆဲခြင်းကိုခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဆိုးယုတ်သောသူတို့ခေါင်းထောင်လာသောအခါ လူတို့သည် ပုန်းရှောင်တတ်ကြ၏။ သူတို့ပျက်စီးသွားသောအခါ၌မူကား ဖြောင့်မတ်သောသူတို့သည် တိုးပွားကြလိမ့်မည်။
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဆိုဆုံးမခြင်းကိုအကြိမ်ကြိမ်ခံရသော်လည်း ခေါင်းမာ လျက်နေသောသူသည် ချမ်းသာရာမရဘဲ ချက်ချင်းပျက်စီးရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဖြောင့်မတ်သောသူတို့တိုးပွားသောအခါ လူတို့သည် ဝမ်းမြောက်ကြ၏။ ဆိုးယုတ်သောသူအုပ်စိုးသောအခါ၌မူကား လူတို့သည် ညည်းတွားကြ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဉာဏ်ပညာကိုချစ်သောသူသည် မိမိ၏ဖခင်ကိုဝမ်းမြောက်စေ၏။ ပြည့်တန်ဆာတို့နှင့်ပေါင်းဖော်သောသူမူကား စည်းစိမ်ဥစ္စာကိုဆုံးရှုံးစေ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ရှင်ဘုရင်သည် တရားမျှတမှုအားဖြင့် တိုင်းပြည်ကိုတည်မြဲစေတတ်၏။ အခွန်မတရားကောက်ခံသောသူမူကား တိုင်းပြည်ကိုပြိုပျက်စေတတ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />မိမိ၏အိမ်နီးချင်းကိုမြှောက်ပင့်ပြောဆိုသောသူသည် မိမိခြေလှမ်းမည့်နေရာတွင် ပိုက်ကွန်ဖြန့်ထားသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />မကောင်းမှုပြုသောသူသည် အပြစ်ကျူးလွန်ခြင်းထဲ၌ ထောင်ချောက်မိတတ်၏။ ဖြောင့်မတ်သောသူမူကား ရွှင်လန်းစွာသီချင်းဆိုလျက် ဝမ်းမြောက်တတ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဖြောင့်မတ်သောသူသည် ဆင်းရဲသောသူတို့၏အမှုအခင်းကို သိမြင်တတ်၏။ ဆိုးယုတ်သောသူသည် ထိုသို့သောအသိမျိုးကို နားမလည်တတ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ပြက်ရယ်ပြုတတ်သောသူတို့သည် မြို့ကိုဆူပူအုံကြွစေတတ်၏။ ပညာရှိတို့မူကား အမျက်ကိုပြေစေတတ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ပညာရှိသောသူသည် ဆိုးမိုက်သောသူနှင့်အမှုဖြစ်သောအခါ ဆိုးမိုက်သောသူသည် အမျက်ထွက်လျက်၊ ပြောင်လှောင်လျက်နေသဖြင့် အေးချမ်းမှုမရနိုင်။
  </para>
  <para style="p">
    <verse number="10" style="v" />သွေးဆာသောသူတို့သည် အပြစ်တင်စရာမရှိသောသူကိုမုန်း၍ ဖြောင့်မှန်သောသူ၏အသက်ကိုသတ်ရန် ရှာကြံတတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />မိုက်မဲသောသူသည် မိမိ၏စိတ်ခံစားချက်ရှိသမျှကို ထုတ်ဖော်တတ်၏။ ပညာရှိသောသူမူကား ၎င်းကို ပြန်၍ထိန်းထားတတ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />အုပ်စိုးသူမင်းသည် မုသားစကားကိုအာရုံစိုက်လျှင် သူ၏အမှုထမ်းအပေါင်းတို့သည် ဆိုးယုတ်သောသူများဖြစ်လာကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဆင်းရဲသောသူနှင့် ဖိနှိပ်ခြယ်လှယ်သောသူတို့၏တူညီသောအချက်မှာ သူတို့နှစ်ဦးလုံး၏မျက်စိတွင် ထာဝရဘုရားအလင်းပေးတော်မူခြင်းပင်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဆင်းရဲသောသူတို့ကို မှန်ကန်စွာတရားစီရင်သောရှင်ဘုရင်၏ ရာဇပလ္လင်သည် ထာဝစဉ်တည်မြဲလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ကြိမ်လုံးနှင့်ဆိုဆုံးမစကားသည် ဉာဏ်ပညာကိုပေး၏။ လွှတ်ထားသောကလေးသူငယ်မူကား သူ၏မိခင်ကိုအရှက်ကွဲစေတတ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဆိုးယုတ်သောသူတို့များပြားလာသောအခါ အပြစ်ကျူးလွန်ခြင်းသည်လည်း များပြားလာ၏။ သို့သော် သူတို့၏ပြိုလဲခြင်းကို ဖြောင့်မတ်သောသူတို့သည် တွေ့မြင်ရကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />သင်၏သားကိုပဲ့ပြင်လော့။ သို့ပြုလျှင် သူသည် သင့်ကိုငြိမ်းချမ်းမှုပေး၍ သင်၏စိတ်ဝိညာဉ်ကို ကြည်နူးစေလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဗျာဒိတ်နိမိတ်မရှိလျှင် လူတို့သည် စည်းလွတ်ဝါးလွတ်ပြုမူတတ်ကြ၏။ ပညတ်တရားကိုစောင့်ထိန်းသောသူမူကား မင်္ဂလာရှိ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />အစေအပါးကို စကားအားဖြင့်သာ ပဲ့ပြင်၍မရနိုင်။ သူသည် နားလည်သော်လည်း တုံ့ပြန်လိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />အလျင်စလိုစကားပြောဆိုတတ်သောသူကို သင်မြင်သလော။ ထိုသူထက် မိုက်မဲသောသူ၌ ပို၍မျှော်လင့်ချက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />မိမိ၏အစေအပါးကို ငယ်ရွယ်စဉ်မှစ၍ အလိုလိုက်လျှင် နောက်ဆုံးတွင် သူသည် မိုက်ရိုင်းစော်ကားတတ်သူဖြစ်သွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="22" style="v" />စိတ်တိုသောသူသည် အငြင်းပွားမှုဖြစ်ရန် လှုံ့ဆော်တတ်၏။ ဒေါသကြီးသောသူသည်လည်း အပြစ်များစွာကျူးလွန်တတ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />လူ၏မာန်မာနသည် သူ့ကိုနိမ့်ကျစေတတ်၏။ စိတ်နှိမ့်ချသောသူမူကား ဂုဏ်သရေကိုရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="24" style="v" />သူခိုးနှင့်ဝေစုခွဲဝေသောသူသည် မိမိအသက်ကိုမုန်းသောသူဖြစ်၏။ သူသည် ကျိန်ခြင်းကိုကြားသော်လည်း မည်သည့်အရာကိုမျှ ထုတ်ဖော်ပြောဆိုခြင်းမရှိ။
  </para>
  <para style="p">
    <verse number="25" style="v" />လူကိုကြောက်ရွံ့ခြင်းသည် ထောင်ချောက်ဖြစ်၏။ ထာဝရဘုရားကိုယုံကြည်ကိုးစားသောသူမူကား လုံခြုံစွာနေရ၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />များစွာသောလူတို့သည် အုပ်စိုးသူမင်းထံမှ မျက်နှာရရန်ရှာကြံတတ်ကြ၏။ သို့ရာတွင် လူသည် တရားမျှတမှုကို ထာဝရဘုရားထံတော်မှရ၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဖြောင့်မတ်သောသူသည် မတရားသောသူကို စက်ဆုပ်ရွံရှာတတ်၏။ ဆိုးယုတ်သောသူမူကား ဖြောင့်မှန်စွာပြုမူကျင့်ကြံသောသူကို စက်ဆုပ်ရွံရှာတတ်၏။
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />ယာကေ၏သားအာဂုရ၏ဩဝါဒစကားများ။ အာဂုရသည် ဣသေလအား၊ ဣသေလနှင့်ဥကလတို့အား မိန့်ကြားသည်ကား
  </para>
  <para style="p">
    <verse number="2" style="v" />အကယ်စင်စစ် ငါသည် လူတကာတို့ထက် အသိတရားမဲ့၍ ငါ၌လူ့အသိဉာဏ်မရှိ။
  </para>
  <para style="p">
    <verse number="3" style="v" />ငါသည် ဉာဏ်ပညာကိုမသင်ယူ။ သန့်ရှင်းသောအရှင်ကိုသိသောဉာဏ်လည်း ငါ၌မရှိ။
  </para>
  <para style="p">
    <verse number="4" style="v" />မည်သူသည် ကောင်းကင်သို့တက်ပြီး ပြန်ဆင်းလာသနည်း။ မည်သူသည် လေကို မိမိလက်ခုပ်ထဲ ထည့်ထားသနည်း။ မည်သူသည် ရေကို မိမိ၏အဝတ်ဖြင့် ထုပ်ထားသနည်း။ မည်သူသည် ကမ္ဘာမြေအစွန်းရှိသမျှကို တည်ထားသနည်း။ ထိုသူ၏အမည်ကား မည်သို့နည်း။ သူ့သား၏အမည်ကား မည်သို့နည်း။ သင်သိသလော။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဘုရားသခင်၏မိန့်တော်မူချက်ရှိသမျှသည် ခိုင်လုံမှန်ကန်၏။ ကိုယ်တော်ကိုခိုလှုံသောသူတို့အတွက် ကိုယ်တော်သည် ဒိုင်းလွှားဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ကိုယ်တော်၏နှုတ်ကပတ်တော်တို့အပေါ် ထပ်မံ၍မဖြည့်စွက်နှင့်။ ဖြည့်စွက်လျှင် ကိုယ်တော်သည် သင့်ကိုဆုံးမသဖြင့် သင်သည် လိမ်လည်သောသူဖြစ်သွားလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ကိုယ်တော်ထံမှဆုနှစ်ပါးကို အကျွန်ုပ်တောင်းလျှောက်ပါ၏။ အကျွန်ုပ်မသေမီ ထိုအရာတို့ကို အကျွန်ုပ်အားမပေးဘဲနေတော်မမူပါနှင့်။
  </para>
  <para style="p">
    <verse number="8" style="v" />မဟုတ်မမှန်သောအရာနှင့် လိမ်လည်သောစကားကို အကျွန်ုပ်နှင့်ဝေးကွာစေတော်မူပါ။ ဆင်းရဲခြင်းကိုလည်းကောင်း၊ ကြွယ်ဝချမ်းသာခြင်းကိုလည်းကောင်း အကျွန်ုပ်အား ပေးတော်မမူပါနှင့်။ အကျွန်ုပ်အတွက်လိုအပ်သောအစာကိုသာ အကျွန်ုပ်အား ပေးတော်မူပါ။
  </para>
  <para style="p">
    <verse number="9" style="v" />သို့မဟုတ်လျှင် အကျွန်ုပ်သည် ပြည့်စုံကြွယ်ဝ၍ “ထာဝရဘုရားသည် မည်သူနည်း”ဟု ဆိုလျက် ကိုယ်တော်ကိုငြင်းပယ်မိပါလိမ့်မည်။ သို့တည်းမဟုတ် အကျွန်ုပ်သည် ဆင်းရဲ၍ခိုးယူကာ အကျွန်ုပ်ဘုရားသခင်၏နာမတော်ကို ထိခိုက်မိစေပါလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အစေအပါးအကြောင်းကို သူ့သခင်ထံ မတရားစွပ်စွဲပြောဆိုခြင်းမပြုနှင့်။ ထိုသို့ပြုလျှင် ထိုအစေအပါးသည် သင့်ကိုကျိန်ဆဲ၍ သင်၌အပြစ်သင့်ရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />မိမိ၏ဖခင်ကိုကျိန်ဆဲ၍ မိမိ၏မိခင်ကို ကောင်းချီးမပေးသောသူများရှိ၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />မိမိ၏အညစ်အကြေးကို မဆေးကြောဘဲ ကိုယ့်ကိုယ်ကိုယ်စင်ကြယ်သည်ဟု ထင်မြင်သောသူများရှိ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />မျက်နှာအလွန်ထောင်လွှား၍ မိမိမျက်လွှာကို ပင့်ထားသောသူများရှိ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />အဖိနှိပ်ခံရသောသူတို့ကို မြေကြီးပေါ်မှလည်းကောင်း၊ နွမ်းပါးသောသူတို့ကို လူထုထဲမှလည်းကောင်း ဝါးမျိုပစ်ရန် သန်လျက်ကဲ့သို့သောသွားနှင့် ဓားကဲ့သို့သောအစွယ်ရှိသောသူများရှိ၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />မျှော့၌ “ပေးပါ၊ ပေးပါ”ဟု ဆိုသောသမီးနှစ်ယောက်ရှိ၏။ အလိုမပြည့်စုံနိုင်သောအရာသုံးပါးမက “တော်ပါပြီ”ဟု မဆိုတတ်သောအရာလေးပါးမှာ
  </para>
  <para style="p">
    <verse number="16" style="v" />မရဏာနိုင်ငံ၊ မြုံသောဝမ်း၊ ရေမဝနိုင်သောမြေကြီးနှင့် “တော်ပါပြီ”ဟု မဆိုတတ်သောမီးတို့ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဖခင်ကိုပြက်ရယ်ပြု၍ မိခင်အားနာခံခြင်းကို မထီမဲ့မြင်ပြုတတ်သောမျက်စိကို လျှိုမြောင်၌ရှိသောကျီးကန်းတို့သည် ဖောက်ထုတ်၍ လင်းတ၏သားပေါက်တို့သည် စားကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ငါအံ့မခန်းဖြစ်ရသောအရာသုံးပါးမက ငါနားမလည်နိုင်သောအရာလေးပါးမှာ
  </para>
  <para style="p">
    <verse number="19" style="v" />မိုးကောင်းကင်၌လင်းယုန်သွားရာလမ်း၊ ကျောက်ဆောင်ပေါ်၌မြွေသွားရာလမ်း၊ ပင်လယ်အလယ်၌သင်္ဘောသွားရာလမ်းနှင့် မိန်းမပျိုနှင့်အတူယောက်ျားသွားရာလမ်းတို့ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />အိမ်ထောင်ရေးဖောက်ပြန်သော မိန်းမ၏လမ်းသည်လည်း ထိုနည်းတူဖြစ်၏။ သူသည် စားသောက်ပြီးမှ မိမိ၏ပါးစပ်ကိုသုတ်ပြီး “မည်သည့်အပြစ်ဒုစရိုက်ကိုမျှ ငါမပြု”ဟု ဆိုတတ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />မြေကြီးလှုပ်ခတ်ရသောအကြောင်းခြင်းရာသုံးပါးမက မြေကြီးမခံနိုင်သောအကြောင်းခြင်းရာလေးပါးမှာ
  </para>
  <para style="p">
    <verse number="22" style="v" />ကျွန်က မင်းပြုခြင်း၊ မိုက်မဲသောသူက အစာဝခြင်း၊
  </para>
  <para style="p">
    <verse number="23" style="v" />မုန်းစရာကောင်းသောမိန်းမက လက်ထပ်ရခြင်းနှင့် ကျွန်မက သူ့သခင်မ၏အမွေကိုဆက်ခံရခြင်းတို့ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ကမ္ဘာမြေကြီးပေါ်မှာ သေးငယ်သော်လည်း အလွန်ပညာရှိသည့် အရာလေးပါးမှာ
  </para>
  <para style="p">
    <verse number="25" style="v" />ခွန်အားကြီးသောအမျိုးမဟုတ်သော်လည်း နွေရာသီ၌ မိမိတို့၏အစားအစာကို ပြင်ဆင်တတ်သောပုရွက်ဆိတ်များ၊
  </para>
  <para style="p">
    <verse number="26" style="v" />အင်အားကြီးသောအမျိုးမဟုတ်သော်လည်း မိမိတို့အိမ်ကို ကျောက်ထဲတွင်တည်တတ်သော ရှာဖန်ယုန်များ၊
  </para>
  <para style="p">
    <verse number="27" style="v" />ဘုရင်မရှိသော်လည်း တစ်စုတစ်ပေါင်းတည်း စီတန်းသွားလာတတ်သောကျိုင်းကောင်များနှင့်
  </para>
  <para style="p">
    <verse number="28" style="v" />လက်ဖြင့်ပင်ဖမ်းယူနိုင်သော်လည်း ဘုရင့်နန်းတော်တို့တွင်နေတတ်သောအိမ်မြှောင်တို့ ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />ခံ့ညားစွာခြေလှမ်းလှမ်းတတ်သောအရာသုံးပါးမက ခံ့ညားစွာလှမ်းလျှောက်တတ်သောအရာလေးပါးမှာ
  </para>
  <para style="p">
    <verse number="30" style="v" />တိရစ္ဆာန်ထဲတွင်ခွန်အားကြီး၍ မည်သည့်အရာ၏ရှေ့ကမျှ နောက်ပြန်မလှည့်တတ်သောခြင်္သေ့၊
  </para>
  <para style="p">
    <verse number="31" style="v" />ဟန်ပါမာန်ပါလျှောက်တတ်သောကြက်ဖ ၊ သို့မဟုတ် ဆိတ်ထီး၊ စစ်သည်အလုံးအရင်းခြံရံထားသော ရှင်ဘုရင်တို့ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />သင်သည် မိမိကိုယ်ကိုချီးမြှောက်လျက် မိုက်မဲစွာပြုမူခဲ့လျှင်၊ သို့မဟုတ် မကောင်းကြံစည်ခဲ့လျှင် သင်၏နှုတ်ကိုလက်နှင့်ပိတ်ထားလော့။
  </para>
  <para style="p">
    <verse number="33" style="v" />အကြောင်းမူကား နို့ကိုမွှေလျှင် ထောပတ်ကိုရ၍ နှာခေါင်းကိုဆွဲလိမ်လျှင် သွေးထွက်တတ်သကဲ့သို့ ဒေါသကိုမွှေလျှင် ခိုက်ရန်ဖြစ်ပွားတတ်၏။
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />လေမွေလမင်းကြီး၏စကားများ။ သူ၏မယ်တော်က သူ့ကိုသွန်သင်သောဩဝါဒစကားမှာ
  </para>
  <para style="p">
    <verse number="2" style="v" />ငါ့သား၊ ငါမည်သို့ပြောရမည်နည်း။ ငါ့ဝမ်းမှဖွားသောသား၊ ငါမည်သို့ပြောရမည်နည်း။ ငါ၏ကတိသစ္စာနှင့်ဆိုင်သောသား၊ ငါမည်သို့ပြောရမည်နည်း။
  </para>
  <para style="p">
    <verse number="3" style="v" />သင်၏ခွန်အားကို မိန်းမတို့အားလည်းကောင်း၊ သင်၏အားမာန်တို့ကို ရှင်ဘုရင်တို့ကိုဖျက်ဆီးတတ်သောသူတို့အားလည်းကောင်း မပေးနှင့်။
  </para>
  <para style="p">
    <verse number="4" style="v" />အို လေမွေလ၊ စပျစ်ဝိုင်သောက်ခြင်းသည် ရှင်ဘုရင်တို့နှင့်မသင့်လျော်ပေ။ ရှင်ဘုရင်တို့နှင့်မသင့်လျော်ပေ။ သေရည်သေရက်ကိုတောင့်တခြင်းသည်လည်း အုပ်ချုပ်သူတို့အတွက် မသင့်လျော်ပေ။
  </para>
  <para style="p">
    <verse number="5" style="v" />သူတို့သည် သောက်သောအခါ ပြဋ္ဌာန်းထားသောအရာကိုမေ့လျော့၍ ဖိစီးနှိပ်စက်မှုခံရသောသူအပေါင်းတို့၏ အမှုအခင်းကို လွဲမှားစွာစီရင်မည်ကို စိုးရိမ်ရ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဆုံးပါးတော့မည့်သူအား သေရည်သေရက်ကိုလည်းကောင်း၊ စိတ်ဒုက္ခရောက်နေသောသူအား စပျစ်ဝိုင်ကိုလည်းကောင်း ပေးလော့။
  </para>
  <para style="p">
    <verse number="7" style="v" />သူတို့သည် သောက်သောအခါ မိမိတို့၏ဆင်းရဲခြင်းကိုမေ့လျော့သွားလိမ့်မည်။ မိမိတို့၏အခက်အခဲပြဿနာကိုလည်း သတိရတော့မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />သင်သည် ပြောဆိုနိုင်စွမ်းမရှိသူအတွက်လည်းကောင်း၊ မှီခိုရာမဲ့သောသူအားလုံး၏ အမှုအခင်းအတွက်လည်းကောင်း သင်၏နှုတ်ကိုဖွင့်လော့။
  </para>
  <para style="p">
    <verse number="9" style="v" />သင်၏နှုတ်ကိုဖွင့်လျက် ဖြောင့်မတ်စွာတရားစီရင်လော့။ အဖိနှိပ်ခံရသောသူနှင့် နွမ်းပါးသောသူ၏အခွင့်အရေးကို ကာကွယ်စောင့်ရှောက်ပေးလော့။
  </para>
  <para style="p">
    <verse number="10" style="v" />စွမ်းရည်နှင့်ပြည့်စုံသောမယားကို မည်သူတွေ့နိုင်သနည်း။ ထိုသို့သောမယားသည် ပတ္တမြားထက်များစွာအဖိုးထိုက်၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />သူ့ခင်ပွန်းသည် စိတ်နှလုံးထဲ၌ သူ့ကိုယုံကြည်စိတ်ချသဖြင့် စည်းစိမ်ဥစ္စာချို့တဲ့သည်ဟူ၍မရှိ။
  </para>
  <para style="p">
    <verse number="12" style="v" />ထိုမယားသည် မိမိအသက်ရှင်သမျှကာလပတ်လုံး ခင်ပွန်းသည်အား ဆိုးကျိုးမပြု၊ ကောင်းကျိုးကိုသာပြုတတ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူသည် သိုးမွေးနှင့်ဗီသွာလျှော်ကိုရှာပြီးလျှင် မိမိ၏လက်ဖြင့် စိတ်ပါလက်ပါလုပ်ဆောင်တတ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ကုန်သွယ်သင်္ဘောများကဲ့သို့ မိမိ၏အစားအစာကို ဝေးလံသောအရပ်မှသယ်ဆောင်လာတတ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />မိုးမလင်းမီထပြီး မိမိအိမ်သူအိမ်သားများအတွက် စားစရာကိုပြင်ဆင်၍ အစေခံမိန်းကလေးများကို အလုပ်ခွဲဝေသတ်မှတ်ပေးတတ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />လယ်ယာကိုကြည့်ရှုသုံးသပ်ပြီးမှ ၎င်းကိုဝယ်ယူ၍ မိမိလက်နှင့် လုပ်ကိုင်ရရှိသောအကျိုးအမြတ်ဖြင့် စပျစ်ခြံကိုစိုက်ပျိုးတတ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />မိမိခါးကို အစွမ်းသတ္တိနှင့်စည်း၍ မိမိလက်မောင်းတို့ကို သန်မာစေတတ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />မိမိ၏ကုန်ပစ္စည်းသည် အကျိုးအမြတ်ရှိကြောင်းကို သိမြင်တတ်၏။ သူ၏မီးခွက်သည် ညအချိန်၌ မငြိမ်းတတ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />သူသည် မိမိ၏လက်တွင် ဗိုင်းလိပ်တံကိုကိုင်ထားလျက် မိမိ၏လက်ထဲ၌ ရစ်လုံးကိုဆုပ်ကိုင်ထားတတ်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />အဖိနှိပ်ခံရသောသူတို့အတွက် မိမိလက်ကိုဖြန့်ပေး၍ နွမ်းပါးသောသူတို့အတွက် မိမိလက်တို့ကိုကမ်းပေးတတ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />သူ၏အိမ်သူအိမ်သားအားလုံးသည် ကတ္တီပါနီကိုဝတ်ဆင်ထားသည်ဖြစ်၍ နှင်းပွင့်ကျသော်လည်း သူသည် မိမိအိမ်သူအိမ်သားများအတွက် မစိုးရိမ်ရပေ။
  </para>
  <para style="p">
    <verse number="22" style="v" />သူသည် မိမိအတွက် အိပ်ရာခင်းများကိုပြုလုပ်၍ သူ၏အဝတ်တန်ဆာသည် ဗီသွာချည်ထည်နှင့် ခရမ်းရောင်အထည်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />သူ၏ခင်ပွန်းသည် အရပ်လူကြီးတို့နှင့်အတူ မြို့တံခါး၌ထိုင်လေ့ရှိ၍ လူသိများသောသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />သူသည် ပိတ်ချောဝတ်ရုံများကိုပြုလုပ်ရောင်းချကာ ခါးဝတ်တန်ဆာများကိုလည်း ကုန်သည်များထံသွင်းတတ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />အစွမ်းသတ္တိနှင့်ခန့်ညားထည်ဝါမှုသည် သူ၏အဝတ်တန်ဆာဖြစ်၍ သူသည် လာမည့်နေ့ရက်များအတွက် ရယ်မောနိုင်၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />သူသည် ဉာဏ်ပညာဖြင့် မိမိနှုတ်ကိုဖွင့်တတ်၏။ သူ၏လျှာပေါ်၌ မေတ္တာကရုဏာနှင့်ပြည့်စုံသော သွန်သင်ချက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />မိမိအိမ်သူအိမ်သားတို့၏အရေးကိစ္စများကို သေချာစွာကြည့်ရှုတတ်၏။ ပျင်းရိခြင်းအစာကို မစားတတ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />သူ၏သားသမီးတို့သည်ထ၍ သူ့ကို မင်္ဂလာရှိသူဟု ခေါ်တတ်ကြ၏။ သူ၏ခင်ပွန်းသည်လည်း
  </para>
  <para style="p">
    <verse number="29" style="v" />“စွမ်းရည်ရှိရှိလုပ်ဆောင်တတ်သောအမျိုးသမီးများစွာရှိသော်လည်း သင်သည် ထိုသူအားလုံးထက်သာလွန်၏”ဟု သူ့ကိုချီးမွမ်းတတ်၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />တင့်တယ်ခြင်းသည် လှည့်ဖြားတတ်၏။ လှပခြင်းသည်လည်း အချည်းနှီးဖြစ်၏။ သို့သော် ထာဝရဘုရားကိုကြောက်ရွံ့သော မိန်းမသည် ချီးမွမ်းခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="31" style="v" />ထိုသို့သောမိန်းမအား သူ့လက်ဖြင့် လုပ်ကိုင်ရရှိသောအကျိုးအမြတ်ကိုပေးလော့။ သူပြုသောအမှုအတွက် မြို့တံခါးတို့၌ သူ့ကိုချီးမွမ်းကြပါစေ။
  </para>
</usx>
