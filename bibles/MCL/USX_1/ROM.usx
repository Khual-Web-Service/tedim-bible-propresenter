<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ROM" style="id">ရောမဩဝါဒစာ</book>
  <para style="h">ရောမဩဝါဒစာ</para>
  <para style="toc1">ရောမဩဝါဒစာ</para>
  <para style="toc2">ရောမဩဝါဒစာ</para>
  <para style="mt">ရောမဩဝါဒစာ</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဘုရားသခင်၏ကောင်းမြတ်သောသတင်းအတွက် သီးသန့်ရွေးချယ်ထားခြင်းခံရ၍ တမန်တော်အဖြစ်ခေါ်ယူတော်မူခြင်းခံရသော ခရစ်တော်ယေရှု၏အစေအပါးငါပေါလုသည် စာရေးလိုက်ပါ၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဤကောင်းမြတ်သောသတင်းသည် မိမိ၏ပရောဖက်များအားဖြင့် သန့်ရှင်းသောကျမ်းစာ၌ ရှေးမဆွကပင် ဘုရားသခင်ကတိပေးထားတော်မူသောအရာဖြစ်ပြီး
  </para>
  <para style="p">
    <verse number="3" style="v" />ဘုရားသခင်၏သားတော်အကြောင်းဖြစ်၏။ သားတော်သည် လူသားအနေဖြင့် ဒါဝိဒ်၏အမျိုးအနွယ်မှ ပေါ်ထွန်းတော်မူ၍
  </para>
  <para style="p">
    <verse number="4" style="v" />မြင့်မြတ်သန့်ရှင်းခြင်း၏ဝိညာဉ်တော်အနေဖြင့်ဆိုလျှင် သေသောသူတို့ထဲမှ ရှင်ပြန်ထမြောက်ခြင်းဖြင့် တန်ခိုးနှင့်တကွ ဘုရားသခင်၏သားတော်အရာ၌ ခန့်အပ်ထားခြင်းခံရသော ငါတို့၏သခင်ယေရှုခရစ်တော်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ထိုသခင်၏နာမတော်အတွက် လူမျိုးအပေါင်းတို့ထဲတွင် ယုံကြည်ခြင်းနှင့်ဆိုင်သောနာခံမှုရှိစေရန် ကျေးဇူးတော်ကိုလည်းကောင်း၊ တမန်တော်ဖြစ်ခြင်းအခွင့်ကိုလည်းကောင်း ကိုယ်တော်အားဖြင့် ငါတို့ရရှိကြ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />သင်တို့သည်လည်း ထိုလူမျိုးတို့ထဲတွင်ပါဝင်၍ ယေရှုခရစ်တော်နှင့်သက်ဆိုင်မည့်အကြောင်း ခေါ်ယူတော်မူခြင်းခံရသူများဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ထိုသို့ ဘုရားသခင်ချစ်တော်မူ၍ သန့်ရှင်းသူများအဖြစ်ခေါ်ယူတော်မူသော ရောမမြို့သူမြို့သားအပေါင်းတို့ထံသို့ ဤစာကို ငါရေးလိုက်ပါ၏။ ငါတို့အဖဘုရားသခင်နှင့် သခင်ယေရှုခရစ်တော်ထံမှ ကျေးဇူးတော်နှင့်ငြိမ်သက်ခြင်းသည် သင်တို့၌ရှိပါစေသော။
  </para>
  <para style="p">
    <verse number="8" style="v" />သင်တို့၏ယုံကြည်ခြင်းသည် ကမ္ဘာတစ်ဝန်းလုံးတွင် ကျော်ကြားလျက်ရှိသည်ဖြစ်၍ ငါသည် သင်တို့အားလုံးအတွက် ငါ၏ဘုရားသခင်ကို ယေရှုခရစ်တော်အားဖြင့် ပထမဦးစွာကျေးဇူးတင်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ငါသည်ဆုတောင်းသောအခါ သင်တို့ကိုအမြဲမပြတ်သတိရလျက် ဘုရားသခင်၏အလိုတော်ရှိလျှင် တစ်ချိန်ချိန်တွင် တစ်နည်းနည်းဖြင့် သင်တို့ထံသို့လာရသောအခွင့်ရှိပါမည့်အကြောင်း အစဉ်တောင်းလျှောက်နေ၏။ ဤအကြောင်းအရာနှင့်ပတ်သက်၍ ငါ့အတွက်သက်သေခံပေးသောသူမှာ သားတော်၏ကောင်းမြတ်သောသတင်းကို ငါဟောပြောလျက် ငါ၏ဝိညာဉ်အားဖြင့် ဝတ်ပြုသောဘုရားသခင်ဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />သင်တို့ကို ငါအလွန်တွေ့မြင်လိုသည်မှာ သင်တို့အား ဝိညာဉ်ဆုကျေးဇူးအချို့ကိုဝေမျှပေး၍ သင်တို့ကိုခိုင်ခံ့မြဲမြံစေရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ထိုသို့ဆိုသော် သင်တို့နှင့်အတူရှိစဉ် ငါနှင့်သင်တို့နှစ်ဦးနှစ်ဖက်၏ယုံကြည်ခြင်းအားဖြင့် နှစ်သိမ့်မှုကို အတူတကွခံစားနိုင်ရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ညီအစ်ကိုတို့၊ ငါသည် အခြားသောလူမျိုးခြားတို့တွင် အသီးအပွင့်ရရှိသကဲ့သို့ သင်တို့တွင်လည်း အသီးအပွင့်တစ်စုံတစ်ခုရရှိရန် သင်တို့ထံသို့လာမည်ဟု အကြိမ်ကြိမ်စီစဉ်ခဲ့သော်လည်း ယခုတိုင်အောင် တားဆီးခြင်းခံရကြောင်းကို သင်တို့မသိဘဲမနေစေလိုပါ။
  </para>
  <para style="p">
    <verse number="14" style="v" />ငါသည် ဂရိလူမျိုးနှင့်လူရိုင်းတို့အပေါ်၌ဖြစ်စေ၊ ပညာရှိနှင့်ပညာမဲ့တို့အပေါ်၌ဖြစ်စေ အကြွေးတင်သူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ထို့ကြောင့် ငါ့အနေဖြင့် ရောမမြို့၌ရှိသော သင်တို့အားလည်း ဤကောင်းမြတ်သောသတင်းကိုဟောပြောရန် စိတ်အားထက်သန်လျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ငါသည် ကောင်းမြတ်သောသတင်းအတွက် ရှက်ကြောက်ခြင်းမရှိ။ အကြောင်းမူကား ဤသတင်းသည် ဦးစွာဂျူးလူမျိုး ထို့နောက် ဂရိလူမျိုးအပါအဝင် ယုံကြည်သောသူအပေါင်းတို့အား ကယ်တင်ခြင်းရရှိစေသော ဘုရားသခင်၏တန်ခိုးတော်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />အဘယ်ကြောင့်ဆိုသော် “ဖြောင့်မတ်သောသူသည် ယုံကြည်ခြင်းအားဖြင့် အသက်ရှင်လိမ့်မည်” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်း ယုံကြည်ခြင်းအပေါ်အခြေခံလျက် ယုံကြည်ခြင်းသို့ပို့ဆောင်သည့်ဘုရားသခင်၏ဖြောင့်မတ်ခြင်းတရားသည် ဤကောင်းမြတ်သောသတင်း၌ထင်ရှားလျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဘုရားသခင်၏အမျက်တော်သည် ကောင်းကင်မှထင်ရှားလျက် သမ္မာတရားကို မတရားမှုဖြင့်တားဆီးပိတ်ပင်သောသူတို့၏ဘုရားတရားမဲ့ခြင်းနှင့် မတရားမှုအလုံးစုံတို့အပေါ်သို့ သက်ရောက်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />အဘယ်ကြောင့်ဆိုသော် ဘုရားသခင်သည် မိမိနှင့်ပတ်သက်၍ သိအပ်သောအရာတို့ကို သူတို့အားထင်ရှားစေတော်မူပြီဖြစ်၍ ထိုအရာတို့သည် သူတို့၌ ထင်ရှားလျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />တစ်နည်းအားဖြင့် ကမ္ဘာလောကကိုဖန်ဆင်းတော်မူချိန်မှစ၍ ဘုရားသခင်၏မမြင်ရသောဂုဏ်အင်္ဂါများတည်းဟူသော ကိုယ်တော်၏ထာဝရတန်ခိုးတော်နှင့် ဘုရားဖြစ်တော်မူခြင်းတို့သည် ဖန်ဆင်းတော်မူသောအရာများအားဖြင့် ရှင်းလင်းစွာသိနိုင်သည်ဖြစ်၍ သူတို့သည် ဆင်ခြေပေး၍မရနိုင်ကြ။
  </para>
  <para style="p">
    <verse number="21" style="v" />အကြောင်းမူကား သူတို့သည် ဘုရားသခင်ကိုသိလျက်နှင့်ပင် ဘုရားအဖြစ်ဘုန်းတော်ကိုမချီးမွမ်း၊ ကျေးဇူးလည်းမတင်ကြပေ။ သူတို့၏တွေးတောကြံစည်မှုများသည် အချည်းနှီးဖြစ်သွား၍ သူတို့၏အသိတရားကင်းမဲ့သောစိတ်နှလုံးကိုလည်း အမှောင်ဖုံးလွှမ်းလေ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />သူတို့သည် မိမိတို့ကိုယ်ကိုပညာရှိများဖြစ်သည်ဟုဆိုလျက်နှင့် မိုက်မဲသောသူများဖြစ်လာကြပြီး
  </para>
  <para style="p">
    <verse number="23" style="v" />ဖောက်ပြန်ပျက်စီးခြင်းနှင့်ကင်းသော ဘုရားသခင်၏ဘုန်းအသရေတော်ကို ဖောက်ပြန်ပျက်စီးတတ်သော လူ၊ ကျေးငှက်၊ ခြေလေးချောင်းသတ္တဝါနှင့် တွားသွားသတ္တဝါတို့၏သဏ္ဌာန်နှင့်တူသော ရုပ်တုဖြင့် လဲလှယ်ကြ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ထို့ကြောင့် ဘုရားသခင်သည် သူတို့အချင်းချင်း မိမိတို့ကိုယ်ခန္ဓာအသရေကိုဖျက်ဆီးစေရန် သူတို့ကို မိမိတို့စိတ်နှလုံးတပ်မက်သည့်အတိုင်း ညစ်ညူးခြင်းလက်သို့ အပ်လိုက်လေ၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />သူတို့သည် ဘုရားသခင်၏သမ္မာတရားကို မုသားနှင့်လဲလှယ်၍ ဖန်ဆင်းတော်မူသောအရှင်အစား ဖန်ဆင်းတော်မူသောအရာကို ကိုးကွယ်ဝတ်ပြုကြ၏။ ဖန်ဆင်းတော်မူသောအရှင်သည် ကာလအစဉ်အဆက် မင်္ဂလာရှိတော်မူ၏။ အာမင်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ထို့ကြောင့် ဘုရားသခင်သည် သူတို့ကို ရှက်ဖွယ်ကောင်းသောကိလေသာလက်သို့ အပ်လိုက်သဖြင့် သူတို့ထဲမှ မိန်းမတို့ပင်လျှင် သဘာဝနှင့်လျော်ညီသောဆက်ဆံမှုကို သဘာဝနှင့်ဆန့်ကျင်သောဆက်ဆံမှုဖြင့် လဲလှယ်ကြ၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ထိုနည်းတူ ယောက်ျားတို့သည်လည်း မိန်းမနှင့်သဘာဝနှင့်လျော်ညီသောဆက်ဆံမှုကိုစွန့်၍ သူတို့အချင်းချင်းရာဂမီးတောက်လောင်စေလျက် ရှက်ဖွယ်ကောင်းသောအမှုကို ယောက်ျားအချင်းချင်းပြုကြသဖြင့် သူတို့၏မှားယွင်းခြင်းနှင့်ထိုက်သင့်သောအပြစ်ဒဏ်ကို သူတို့ကိုယ်တိုင်ခံရကြ၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ထိုမှတစ်ပါး သူတို့သည် ဘုရားသခင်ကိုမသိမမှတ်လိုသောကြောင့် ဘုရားသခင်သည် သူတို့ကို ယုတ်ညံ့သောစိတ်ထံသို့ အပ်လိုက်တော်မူသဖြင့် သူတို့သည် မပြုအပ်သောအရာများကို ပြုကြကုန်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />သူတို့သည် အလုံးစုံသော မတရားမှု၊ ဆိုးညစ်မှု၊ လောဘလွန်ကျူးမှုနှင့် မကောင်းမှုတို့ဖြင့် ပြည့်ဝလျက်ရှိကြပြီး မလိုမုန်းထားခြင်း၊ လူသတ်ခြင်း၊ ပဋိပက္ခဖြစ်ခြင်း၊ စဉ်းလဲခြင်း၊ ရန်ငြိုးဖွဲ့ခြင်းတို့ဖြင့် ပြည့်နှက်ကြကာ အတင်းအဖျင်းပြောဆိုသောသူ၊
  </para>
  <para style="p">
    <verse number="30" style="v" />ပုတ်ခတ်ပြောဆိုသောသူ၊ ဘုရားသခင်ကိုမုန်းသောသူ၊ မိုက်ရိုင်းသောသူ၊ မာနထောင်လွှားသောသူ၊ ကြွားဝါသောသူ၊ မကောင်းသောအမှုများကို တီထွင်ကြံစည်သောသူ၊ မိဘစကားကိုနားမထောင်သောသူ၊
  </para>
  <para style="p">
    <verse number="31" style="v" />အသိတရားကင်းမဲ့သောသူ၊ ကတိမတည်သောသူ၊ ကြင်နာစိတ်ကင်းမဲ့သောသူ၊ သနားခြင်းစိတ်မရှိသောသူများဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />ဤအရာများကိုပြုကျင့်သောသူတို့သည် သေဒဏ်ခံထိုက်၏ဟူသောဘုရားသခင်၏ပြဋ္ဌာန်းချက်ကို သူတို့သိလျက်နှင့်ပင် သူတို့ကိုယ်တိုင်ပြုကြသည်သာမက ထိုသို့ပြုကျင့်သောသူများကိုလည်း သဘောတူထောက်ခံကြ၏။
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />ထို့ကြောင့် သူတစ်ပါးကိုစီရင်တတ်သောအချင်းလူ၊ သင်သည် ဆင်ခြေပေး၍မရ။ အဘယ်ကြောင့်ဆိုသော် စီရင်နေသောသင်သည်လည်း တူညီသောအမှုများကိုပြုကျင့်နေသည်ဖြစ်၍ သူတစ်ပါးကိုစီရင်ရာတွင် သင့်ကိုယ်သင်ပြစ်ဒဏ်စီရင်ရာရောက်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ထိုသို့သောအမှုများကို ပြုကျင့်သောသူတို့အပေါ်၌ ဘုရားသခင်၏တရားစီရင်ခြင်းသည် သမ္မာတရားနှင့်အညီသက်ရောက်သည်ကို ငါတို့သိကြ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />သို့ဖြစ်၍ ထိုသို့သောအမှုများကိုပြုကျင့်သောသူတို့အား စီရင်လျက်နှင့် ထိုအမှုတို့ကို ကိုယ်တိုင်ပြုသောအချင်းလူ၊ သင်သည် ဘုရားသခင်၏ပြစ်ဒဏ်စီရင်ခြင်းမှလွတ်မည်ဟု ထင်မှတ်သလော။
  </para>
  <para style="p">
    <verse number="4" style="v" />သို့မဟုတ် ဘုရားသခင်၏ကျေးဇူးပြုတော်မူခြင်းသည် သင့်ကို နောင်တသို့ပို့ဆောင်သည်ကိုမသိမမှတ်ဘဲ ကိုယ်တော်၏ကြွယ်ဝသောကျေးဇူးပြုတော်မူခြင်း၊ သည်းခံတော်မူခြင်းနှင့် စိတ်ရှည်တော်မူခြင်းတို့ကို မထီမဲ့မြင်ပြုသလော။
  </para>
  <para style="p">
    <verse number="5" style="v" />သို့သော် သင်၏မာကျောခက်ထန်မှုနှင့်နောင်တမရသောစိတ်နှလုံးတို့ကြောင့် သင်သည် အမျက်တော်နေ့တည်းဟူသော ဘုရားသခင်၏ဖြောင့်မတ်သည့် တရားစီရင်ခြင်းထင်ရှားရာနေ့အတွက် အမျက်တော်ကို မိမိအဖို့သိုမှီးလျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဘုရားသခင်သည် လူအသီးသီးတို့အား မိမိတို့ပြုသောအမှုနှင့်အညီ အကျိုးအပြစ်ကိုပေးတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ကောင်းသောအမှုကို ဇွဲလုံ့လဖြင့်ပြုလျက် ဘုန်းတော်၊ ဂုဏ်တော်နှင့် ဖောက်ပြန်ပျက်စီးခြင်းနှင့်ကင်းသောအရာတို့ကိုရှာဖွေသောသူတို့အား ထာဝရအသက်ကို ပေးတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="8" style="v" />တစ်ကိုယ်ကောင်းဆန်၍ သမ္မာတရားကိုမနာခံဘဲ မတရားမှုနောက်သို့လိုက်သောသူတို့အပေါ်၌မူကား ပြင်းစွာသောဒေါသနှင့်အမျက်တော်ကို သက်ရောက်စေတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဆင်းရဲဒုက္ခနှင့်နာကျင်ခြင်းဝေဒနာတို့သည် ဦးစွာဂျူးလူမျိုး ထို့နောက် ဂရိလူမျိုးအပါအဝင် မကောင်းသောအမှုကိုပြုသည့် သက်ရှိလူသားအပေါင်းတို့အပေါ်သို့ ကျရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဘုန်းတော်၊ ဂုဏ်တော်နှင့် ငြိမ်သက်ခြင်းတို့မူကား ဦးစွာဂျူးလူမျိုး ထို့နောက် ဂရိလူမျိုးအပါအဝင် ကောင်းသောအမှုကိုပြုသောသူအပေါင်းတို့အပေါ်သို့ သက်ရောက်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />အကြောင်းမူကား ဘုရားသခင်၌ မျက်နှာလိုက်ခြင်းမရှိ။
  </para>
  <para style="p">
    <verse number="12" style="v" />ပညတ်တရားမပါဘဲ အပြစ်ပြုသောသူရှိသမျှသည် ပညတ်တရားမပါဘဲ ပျက်စီးကြလိမ့်မည်။ ပညတ်တရားအောက်၌ရှိလျက် အပြစ်ပြုသောသူရှိသမျှသည်လည်း ပညတ်တရားအားဖြင့် စီရင်ခြင်းခံရကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="13" style="v" />အကြောင်းမူကား ပညတ်တရားကိုကြားနာသောသူတို့သည် ဘုရားသခင်ရှေ့တော်၌ ဖြောင့်မတ်ကြသည်မဟုတ်။ ပညတ်တရားကိုလိုက်နာကျင့်သုံးသောသူတို့သာလျှင် ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရကြ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ပညတ်တရားမရှိသောလူမျိုးခြားတို့သည် ပညတ်တရား၏ပြဋ္ဌာန်းချက်များကို အလိုအလျောက်လိုက်နာကျင့်သုံးကြသောအခါ သူတို့၌ပညတ်တရားမရှိသော်လည်း သူတို့ကိုယ်တိုင်သည် မိမိတို့အတွက် ပညတ်တရားဖြစ်ကြပြီး
  </para>
  <para style="p">
    <verse number="15" style="v" />မိမိတို့စိတ်နှလုံးထဲ၌ရေးထားသည့် ပညတ်တရားနှင့်ဆိုင်သောအကျင့်ကို ပြသလျက်ရှိကြ၏။ သူတို့၏အသိစိတ်သည်လည်း အတူတကွသက်သေခံ၍ သူတို့၏စဉ်းစားဆင်ခြင်မှုတို့သည် အချင်းချင်းစွပ်စွဲတစ်ခါ ကာကွယ်တစ်လှည့်ပြုနေကြ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဤအမှုအရာများသည် ငါဟောပြောသည့်ကောင်းမြတ်သောသတင်းအရ လူတို့၏လျှို့ဝှက်သောအကျင့်အကြံတို့ကို ခရစ်တော်ယေရှုအားဖြင့် ဘုရားသခင်စစ်ဆေးစီရင်တော်မူသောနေ့၌ ဖြစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="17" style="v" />အကယ်၍ သင်သည် မိမိကိုယ်ကိုဂျူးလူမျိုးဟုခေါ်လျက်၊ ပညတ်တရားကိုကိုးစားလျက်၊ ဘုရားသခင်၌ဝါကြွားလျက်၊
  </para>
  <para style="p">
    <verse number="18" style="v" />အလိုတော်ကိုသိလျက်၊ ပညတ်တရား၏သွန်သင်မှုကို ခံယူပြီးဖြစ်သောကြောင့် မြင့်မြတ်သောအရာများကို ပိုင်းခြားသိရှိလျက်
  </para>
  <para style="p">
    <verse number="19" style="v" />ပညတ်တရားအားဖြင့် အသိပညာနှင့်သမ္မာတရားတို့၏အနှစ်သာရကို ရရှိထားသည်ဖြစ်၍ မိမိကိုယ်ကို မျက်မမြင်တို့၏လမ်းပြ၊ အမှောင်ထဲ၌နေသောသူတို့အတွက်အလင်း၊
  </para>
  <para style="p">
    <verse number="20" style="v" />မိုက်မဲသောသူတို့ကိုဆုံးမပဲ့ပြင်သူ၊ ကလေးသူငယ်များ၏ဆရာဖြစ်သည်ဟု ယုံကြည်စိတ်ချလျှင်
  </para>
  <para style="p">
    <verse number="21" style="v" />သူတစ်ပါးကိုသွန်သင်လျက်ပင် သင့်ကိုယ်သင်မသွန်သင်သလော။ မခိုးယူရဟုဟောပြောလျက်ပင် သင်ကိုယ်တိုင်ခိုးယူရသလော။
  </para>
  <para style="p">
    <verse number="22" style="v" />အိမ်ထောင်ရေးဖောက်ပြန်မှုကို မကျူးလွန်ရဟုဆိုလျက်ပင် သင်ကိုယ်တိုင်ကျူးလွန်ရသလော။ ရုပ်တုများကိုရွံရှာလျက်ပင် ၎င်းတို့၏ဗိမာန်များကို သင်ကိုယ်တိုင်ဖောက်ထွင်းလုယူရသလော။
  </para>
  <para style="p">
    <verse number="23" style="v" />ပညတ်တရား၌ဝါကြွားလျက်ပင် သင်ကိုယ်တိုင်ပညတ်တရားကိုဖောက်ဖျက်ကျူးလွန်ခြင်းဖြင့် ဘုရားသခင်ကိုမထီလေးစားပြုရသလော။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဤသည်ကား “ဘုရားသခင်၏နာမတော်သည် သင်တို့ကြောင့် လူမျိုးခြားတို့တွင် စော်ကားပြောဆိုခြင်းကိုခံရလျက်ရှိ၏” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />သင်သည် ပညတ်တရားကိုကျင့်သုံးလျှင် အရေဖျားလှီးခြင်းသည် အမှန်ပင်အကျိုးရှိ၏။ သို့သော် သင်သည် ပညတ်တရားကိုဖောက်ဖျက်ကျူးလွန်သူဖြစ်ပါက သင်၏အရေဖျားလှီးခြင်းသည် အရေဖျားမလှီးခြင်းဖြစ်သွား၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ထို့ကြောင့် အရေဖျားမလှီးသောသူသည် ပညတ်တရား၏ပြဋ္ဌာန်းချက်များကို စောင့်ထိန်းလျှင် သူ၏အရေဖျားမလှီးခြင်းသည် အရေဖျားလှီးခြင်းအဖြစ် သတ်မှတ်ခြင်းခံရမည်မဟုတ်လော။
  </para>
  <para style="p">
    <verse number="27" style="v" />ထိုအခါ ကိုယ်ခန္ဓာတွင် အရေဖျားမလှီးထားသော်လည်း ပညတ်တရားကို အပြည့်အဝစောင့်ထိန်းသောသူသည် အက္ခရာတင်ထားသောတရားနှင့် အရေဖျားလှီးခြင်းရှိလျက်ပင် ပညတ်တရားကိုဖောက်ဖျက်ကျူးလွန်သောသင့်ကို စီရင်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="28" style="v" />တစ်နည်းဆိုသော် အပြင်ပန်းအားဖြင့် ဂျူးလူမျိုးဖြစ်သောသူသည် ဂျူးလူမျိုးအစစ်အမှန်မဟုတ်။ အပြင်ပန်းအားဖြင့် ကိုယ်ကာယ၌ခံယူသောအရေဖျားလှီးခြင်းသည်လည်း အရေဖျားလှီးခြင်းအစစ်အမှန်မဟုတ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />အတွင်းသဘောအားဖြင့် ဂျူးလူမျိုးဖြစ်သောသူသာလျှင် ဂျူးလူမျိုးအစစ်အမှန်ဖြစ်ပြီး အက္ခရာတင်ထားသောတရားအားဖြင့်မဟုတ်ဘဲ ဝိညာဉ်တော်အားဖြင့်ဖြစ်သော စိတ်နှလုံး၏အရေဖျားလှီးခြင်းပင် အရေဖျားလှီးခြင်းအစစ်အမှန်ဖြစ်၏။ ထိုသို့သောသူသည် လူတို့ထံမှမဟုတ်ဘဲ ဘုရားသခင်ထံတော်မှချီးမွမ်းခြင်းကိုခံရ၏။
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />သို့ဖြစ်လျှင် ဂျူးလူမျိုး၌ မည်သည့်သာလွန်ထူးခြားမှုရှိသနည်း။ အရေဖျားလှီးခြင်း၌ မည်သည့်အကျိုးရှိသနည်း။
  </para>
  <para style="p">
    <verse number="2" style="v" />အဘက်ဘက်၌ အကျိုးများစွာရှိ၏။ ပထမဦးစွာ သူတို့၌ ဘုရားသခင်၏နှုတ်ကပတ်တရားတော်များကို ယုံကြည်အပ်နှံထားတော်မူ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ထိုသို့ဆိုလျှင် သူတို့တွင် မယုံကြည်သောသူအချို့ရှိပါက မည်သို့ဖြစ်မည်နည်း။ ဘုရားသခင်၏သစ္စာတော်သည် သူတို့၏မယုံကြည်မှုကြောင့် ပျက်ပြယ်သွားမည်လော။
  </para>
  <para style="p">
    <verse number="4" style="v" />လုံးဝမပျက်ပြယ်နိုင်ရာ။ “ကိုယ်တော်သည် မိမိမိန့်တော်မူသောစကားအားဖြင့် ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရ၍ တရားဆိုင်တော်မူသောအခါ အောင်မြင်မည့်အကြောင်းတည်း” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်း လူခပ်သိမ်းသည် လိမ်လည်သောသူဖြစ်သော်လည်း ဘုရားသခင်သည် ဖြောင့်မှန်တော်မူသောအရှင်ဖြစ်ပါစေသော။
  </para>
  <para style="p">
    <verse number="5" style="v" />သို့ရာတွင် ငါတို့၏မတရားမှုသည် ဘုရားသခင်၏ဖြောင့်မတ်ခြင်းကို ထင်ရှားစေလျှင် မည်သို့ဆိုရမည်နည်း။ လူသားတစ်ဦးအနေဖြင့်ငါဆိုသော် အမျက်တော်ကိုသက်ရောက်စေတော်မူသောဘုရားသခင်သည် မဖြောင့်မတ်သောအရှင်ဖြစ်သလော။
  </para>
  <para style="p">
    <verse number="6" style="v" />လုံးဝမဟုတ်ပေ။ ဟုတ်လျှင်မူကား ဘုရားသခင်သည် ဤလောကကို မည်သို့တရားစီရင်တော်မူမည်နည်း။
  </para>
  <para style="p">
    <verse number="7" style="v" />သို့သော် ငါ၏လိမ်လည်ခြင်းအားဖြင့် ဘုရားသခင်၏သမ္မာတရားသည် ကိုယ်တော်၏ဘုန်းအသရေတော်အဖြစ်သို့ တိုးပွားလျှင် ငါသည် အဘယ်ကြောင့် အပြစ်သားတစ်ဦးအဖြစ် စီရင်ခြင်းကိုခံရသေးသနည်း။
  </para>
  <para style="p">
    <verse number="8" style="v" />“ကောင်းကျိုးသက်ရောက်စေရန် မကောင်းသောအမှုကို ပြုကြကုန်စို့”ဟု ဆို၍မရနိုင်သလော။ လူအချို့တို့က ထိုကဲ့သို့ငါတို့ပြောဆိုနေသည်ဟုဆိုလျက် ငါတို့ကို စော်ကားပြောဆိုကြ၏။ ထိုသူတို့သည် ပြစ်ဒဏ်စီရင်ခြင်းကို ခံထိုက်ကြ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />သို့ဖြစ်လျှင် မည်သို့နည်း။ ငါတို့သည် သာ၍ကောင်းမြတ်သလော။ လုံးဝမဟုတ်ပေ။ အကြောင်းမူကား ဂျူးလူမျိုးဖြစ်စေ၊ ဂရိလူမျိုးဖြစ်စေ လူအပေါင်းတို့သည် အပြစ်တရားအောက်၌ရှိကြောင်း အထက်က ငါတို့ထောက်ပြခဲ့ပြီ။
  </para>
  <para style="p">
    <verse number="10" style="v" />ဤသည်ကား “ဖြောင့်မတ်သောသူမရှိ၊ တစ်ယောက်မျှမရှိ။
  </para>
  <para style="p">
    <verse number="11" style="v" />တတ်သိနားလည်သောသူမရှိ၊ ဘုရားသခင်ကိုရှာသောသူမရှိ။
  </para>
  <para style="p">
    <verse number="12" style="v" />လူအပေါင်းတို့သည် လမ်းလွဲကြ၍ တညီတညွတ်တည်းအသုံးမကျသောသူများဖြစ်ကြပြီ။ ကောင်းသောအမှုကိုပြုသောသူမရှိ၊ တစ်ယောက်မျှမရှိ။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူတို့၏လည်ချောင်းသည် ဖွင့်ထားသောသင်္ချိုင်းတွင်းဖြစ်ကြ၏။ သူတို့သည် မိမိတို့လျှာဖြင့် လိမ်လည်ပြောဆိုတတ်ကြ၏။ သူတို့၏နှုတ်ခမ်းအောက်၌ မြွေဆိုး၏အဆိပ်အတောက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />သူတို့၏နှုတ်သည် ကျိန်ဆဲသောစကား၊ ခါးသီးသောစကားတို့ဖြင့် ပြည့်ဝလျက်ရှိကြ၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သူတို့၏ခြေသည် လူကိုသတ်ဖြတ်ရန်လျင်မြန်ကြ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />သူတို့သွားရာလမ်း၌ ပျက်စီးခြင်းနှင့်ဒုက္ခဆင်းရဲခြင်းရှိ၍
  </para>
  <para style="p">
    <verse number="17" style="v" />သူတို့သည် ငြိမ်းချမ်းရာလမ်းကိုမသိကြ။
  </para>
  <para style="p">
    <verse number="18" style="v" />သူတို့၏မျက်စိရှေ့တွင် ဘုရားသခင်ကိုကြောက်ရွံ့ခြင်းမရှိ” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ပညတ်တရားဆိုထားသမျှတို့သည် ပညတ်တရားအောက်၌ရှိသောသူများအတွက်ဆိုထားကြောင်း ငါတို့သိကြ၏။ ဤသည်ကား နှုတ်ရှိသမျှသည် ပိတ်ထားခြင်းခံရ၍ လောကီသားအပေါင်းတို့သည် ဘုရားသခင်၏တရားစီရင်ခြင်းလက်အောက်သို့ ကျရောက်ကြရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />သို့ဖြစ်၍ ပညတ်တရားနှင့်ဆိုင်သောအကျင့်အားဖြင့် မည်သူမျှ ဘုရားသခင်ရှေ့တော်၌ ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရမည်မဟုတ်။ အကြောင်းမူကား ပညတ်တရားအားဖြင့် အပြစ်အကြောင်းကိုသိရှိရုံမျှသာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />သို့ရာတွင် ယခုအခါ၌ ပညတ်တရားနှင့်ပရောဖက်များသက်သေခံသော ဘုရားသခင်၏ဖြောင့်မတ်ခြင်းသည် ပညတ်တရားမပါဘဲ ထင်ရှားလေပြီ။
  </para>
  <para style="p">
    <verse number="22" style="v" />၎င်းမှာ ယေရှုခရစ်တော်ကိုယုံကြည်ခြင်းအားဖြင့် ယုံကြည်သူအပေါင်းတို့အပေါ်သက်ရောက်သော ဘုရားသခင်၏ဖြောင့်မတ်ခြင်းဖြစ်၏။ ဤတွင် မည်သည့်ခြားနားမှုမျှမရှိ။
  </para>
  <para style="p">
    <verse number="23" style="v" />အကြောင်းမူကား လူအပေါင်းတို့သည် အပြစ်ပြု၍ ဘုရားသခင်၏ဘုန်းအသရေတော်နှင့် အလှမ်းဝေးကြပြီ။
  </para>
  <para style="p">
    <verse number="24" style="v" />သူတို့သည် ဘုရားသခင်၏ကျေးဇူးတော်ကြောင့် ခရစ်တော်ယေရှု၏ရွေးနုတ်ခြင်းအားဖြင့် အဖိုးအခမပေးရဘဲ ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရကြ၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဘုရားသခင်သည် မိမိ၏ဖြောင့်မတ်ခြင်းကိုထင်ရှားစေရန် ခရစ်တော်ကိုခန့်ထား၍ ယုံကြည်ခြင်းအတွက် ခရစ်တော်၏သွေးတော်ကို အသနားခံခြင်းပူဇော်သက္ကာဖြစ်စေတော်မူ၏။ တစ်နည်းဆိုသော် ဘုရားသခင်သည် သည်းခံတော်မူခြင်းအားဖြင့် လွန်ခဲ့ပြီးသောအပြစ်များအတွက် အပြစ်မယူဘဲနေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဤသည်ကား ယခုအချိန်အခါ၌ မိမိ၏ဖြောင့်မတ်ခြင်းကို ထင်ရှားစေရန်နှင့် ဘုရားသခင်ကိုယ်တော်တိုင် ဖြောင့်မတ်သောအရှင်ဖြစ်တော်မူပြီး ယေရှုကိုယုံကြည်သောသူအား ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုတော်မူရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />သို့ဖြစ်လျှင် ဝါကြွားစရာအဘယ်မှာရှိသနည်း။ ၎င်းသည် ဖယ်ရှားခြင်းခံရလေပြီ။ မည်သည့်တရားအားဖြင့် ဖယ်ရှားသနည်း။ အကျင့်တရားအားဖြင့်လော။ မဟုတ်ပေ။ ယုံကြည်ခြင်းတရားအားဖြင့် ဖယ်ရှား၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />အကြောင်းမူကား လူသည် ပညတ်တရားနှင့်ဆိုင်သောအကျင့်အားဖြင့်မဟုတ်ဘဲ ယုံကြည်ခြင်းအားဖြင့် ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရ၏ဟု ငါတို့မှတ်ယူကြ၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />သို့မဟုတ် ဘုရားသခင်သည် ဂျူးလူမျိုးတို့၏ဘုရားသာ ဖြစ်တော်မူသလော။ လူမျိုးခြားတို့၏ဘုရားလည်း ဖြစ်တော်မူသည်မဟုတ်လော။ ဟုတ်ပေ၏။ လူမျိုးခြားတို့၏ဘုရားလည်း ဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />ယုံကြည်ခြင်းအားဖြင့် အရေဖျားလှီးထားသောသူကို ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုတော်မူ၍ အရေဖျားမလှီးသောသူကိုလည်း ယုံကြည်ခြင်းအားဖြင့် ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုတော်မူသောဘုရားသခင်သည် အမှန်ပင် တစ်ဆူတည်းဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />သို့ဖြစ်လျှင် ငါတို့သည် ယုံကြည်ခြင်းကြောင့် ပညတ်တရားကို ပယ်ဖျက်ကြသလော။ လုံးဝမပယ်ဖျက်ကြ။ ပညတ်တရားကို တည်မြဲတည်စေကြ၏။
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />ထိုသို့ဖြစ်လျှင် သွေးသားဇာတိအားဖြင့် ငါတို့အဖအာဗြဟံ ခံစားရရှိသည့်အရာနှင့်ပတ်သက်၍ မည်သို့ဆိုရမည်နည်း။
  </para>
  <para style="p">
    <verse number="2" style="v" />အာဗြဟံသည် အကျင့်အားဖြင့် ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရသည်မှန်လျှင် သူ၌ဝါကြွားစရာအကြောင်းရှိ၏။ သို့ရာတွင် ဘုရားသခင်ရှေ့တော်၌ ထိုသို့မဟုတ်ပေ။
  </para>
  <para style="p">
    <verse number="3" style="v" />ကျမ်းစာက မည်သို့ဆိုထားသနည်း။ “အာဗြဟံသည် ဘုရားသခင်ကိုယုံကြည်သဖြင့် ထိုယုံကြည်ခြင်းကို သူ၏ဖြောင့်မတ်ခြင်းအဖြစ် သတ်မှတ်တော်မူ၏” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />အလုပ်လုပ်ဆောင်သောသူအတွက် လုပ်အားခသည် ကျေးဇူးပြုခြင်းအဖြစ်မဟုတ်ဘဲ သူရသင့်ရထိုက်သောအရာအဖြစ် မှတ်ယူရ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />သို့ရာတွင် လုပ်ဆောင်မှုမရှိသော်လည်း ဘုရားတရားမဲ့သောသူအား ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုတော်မူသောအရှင်ကို ယုံကြည်သောသူအတွက်မူကား ထိုယုံကြည်ခြင်းကို သူ၏ဖြောင့်မတ်ခြင်းအဖြစ် သတ်မှတ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ထို့အတူ ဒါဝိဒ်သည်လည်း ဘုရားသခင်က အကျင့်ကိုမထောက်ဘဲ ဖြောင့်မတ်သည်ဟုသတ်မှတ်တော်မူသောသူ၏မင်္ဂလာကို ပြောဆိုရာတွင်
  </para>
  <para style="p">
    <verse number="7" style="v" />“တရားမဲ့သောအမှုများကို ခွင့်လွှတ်ခြင်းခံရသောသူ၊ အပြစ်များကို ဖုံးအုပ်ခြင်းခံရသောသူတို့သည် မင်္ဂလာရှိကြ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ထာဝရဘုရားအပြစ်မယူသောသူသည် မင်္ဂလာရှိ၏” ဟု ဆို၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />သို့ဖြစ်လျှင် ဤမင်္ဂလာသည် အရေဖျားလှီးထားသောသူအတွက်သာ ဖြစ်သလော၊ သို့မဟုတ် အရေဖျားမလှီးသောသူအတွက်လည်း ဖြစ်သလော။ “အာဗြဟံအတွက် သူ၏ယုံကြည်ခြင်းကို ဖြောင့်မတ်ခြင်းအဖြစ် သတ်မှတ်တော်မူ၏”ဟု ငါတို့ဆိုကြသောအခါ
  </para>
  <para style="p">
    <verse number="10" style="v" />မည်သည့်အခြေအနေ၌ ထိုသို့သတ်မှတ်တော်မူသနည်း။ အရေဖျားလှီးထားသည့်အခြေအနေ၌လော၊ သို့မဟုတ် အရေဖျားမလှီးထားသည့်အခြေအနေ၌လော။ အရေဖျားလှီးထားသည့်အခြေအနေ၌မဟုတ်ဘဲ အရေဖျားမလှီးထားသည့်အခြေအနေ၌ ထိုသို့သတ်မှတ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဤသို့ဖြင့် အာဗြဟံသည် အရေဖျားမလှီးမီ ယုံကြည်ခြင်းအားဖြင့်ရရှိသော ဖြောင့်မတ်ခြင်း၏တံဆိပ်အဖြစ် အရေဖျားလှီးခြင်း၏အမှတ်လက္ခဏာကိုခံယူ၏။ ဤသည်ကား အာဗြဟံအား အရေဖျားမလှီးဘဲယုံကြည်သောသူအပေါင်းတို့၏အဖဖြစ်စေရန်နှင့် ထိုသူတို့သည်လည်း ဖြောင့်မတ်ခြင်းကိုရရှိကြစေရန်အတွက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ထို့ပြင် အာဗြဟံအား အရေဖျားလှီးထားသောသူတို့၏အဖဖြစ်စေရန်နှင့် အရေဖျားလှီးထားသောသူသာမကဘဲ အရေဖျားမလှီးမီကပင် ငါတို့အဖအာဗြဟံ၌ရှိသော ယုံကြည်ခြင်းခြေရာကို လိုက်လျှောက်သောသူတို့၏အဖလည်း ဖြစ်စေရန်အတွက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ကမ္ဘာလောကကိုအမွေဆက်ခံသူဖြစ်မည်ဟု အာဗြဟံ၊ သို့မဟုတ် သူ၏အမျိုးအနွယ်အား ပေးတော်မူသောကတိတော်သည် ပညတ်တရားကိုထောက်၍ ပေးတော်မူသည်မဟုတ်ဘဲ ယုံကြည်ခြင်းနှင့်ဆိုင်သောဖြောင့်မတ်ခြင်းကိုထောက်၍ ပေးတော်မူ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />အကြောင်းမူကား ပညတ်တရားနှင့်ဆိုင်သောသူတို့သည် အမွေခံများဖြစ်ကြလျှင် ယုံကြည်ခြင်းသည် အချည်းနှီးဖြစ်သွား၍ ကတိတော်သည်လည်း ပျက်ပြယ်သွားလေပြီ။
  </para>
  <para style="p">
    <verse number="15" style="v" />ပညတ်တရားသည် အမျက်တော်ကိုဖြစ်ပေါ်စေ၏။ သို့သော် ပညတ်တရားမရှိသောနေရာ၌ ဖောက်ဖျက်ကျူးလွန်မှုလည်းမရှိ။
  </para>
  <para style="p">
    <verse number="16" style="v" />ထို့ကြောင့် ကတိတော်သည် ယုံကြည်ခြင်းနှင့်ဆိုင်၏။ ဤသည်ကား ထိုကတိတော်ကို ကျေးဇူးတော်အားဖြင့်ဖြစ်စေ၍ ပညတ်တရားနှင့်ဆိုင်သောအမျိုးအနွယ်အတွက်သာမကဘဲ အာဗြဟံ၏ယုံကြည်ခြင်းနှင့်ဆိုင်သည့်အမျိုးအနွယ်အပါအဝင် အမျိုးအနွယ်ရှိသမျှတို့အတွက် တည်မြဲစေရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />“ငါသည် သင့်ကို များစွာသောလူမျိုးတို့၏ဖခင်ဖြစ်စေပြီ” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်း အာဗြဟံသည် မိမိယုံကြည်သောဘုရားသခင်တည်းဟူသော သေလွန်သောသူတို့ကိုအသက်ရှင်စေ၍ ဖြစ်တည်ခြင်းမရှိသည့်အရာများကိုဖြစ်ပေါ်လာစေရန် အမိန့်ပေးနိုင်သောဘုရားသခင်ရှေ့တော်၌ ငါတို့အားလုံး၏ဖခင်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />သူသည် မျှော်လင့်စရာမရှိသောအခြေအနေ၌ မျှော်လင့်၍ယုံကြည်သဖြင့် “သင်၏အမျိုးအနွယ်သည် ဤသို့ဖြစ်လိမ့်မည်” ဟု မိန့်မှာခြင်းခံခဲ့ရသည့်အတိုင်း များစွာသောလူမျိုးတို့၏ဖခင်ဖြစ်လာ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />သူသည် အသက်တစ်ရာခန့်ရှိ၍ မိမိကိုယ်ခန္ဓာသည် သေသူကဲ့သို့ဖြစ်နေကြောင်းကိုလည်းကောင်း၊ စာရာ၏ဝမ်းသည် သေနေကြောင်းကိုလည်းကောင်း ဆင်ခြင်အောက်မေ့သော်လည်း ယုံကြည်ခြင်း၌ အားနည်းခြင်းမရှိ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဘုရားသခင်၏ကတိတော်အပေါ်၌ ယုံမှားသံသယမရှိဘဲ ယုံကြည်ခြင်းအားကြီးလျက် ဘုရားသခင်၏ဘုန်းတော်ကိုချီးမွမ်းကာ
  </para>
  <para style="p">
    <verse number="21" style="v" />ဘုရားသခင်သည် ကတိပေးတော်မူသောအရာကို ဆောင်ရွက်နိုင်စွမ်းလည်းရှိသည်ဟု အပြည့်အဝယုံကြည်လေ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ထို့ကြောင့် ဤယုံကြည်ခြင်းကို သူ၏ဖြောင့်မတ်ခြင်းအဖြစ် သတ်မှတ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />သို့သော် “သူ့ကိုသတ်မှတ်တော်မူ၏”ဟု ကျမ်းစာ၌ရေးထားသည်မှာ အာဗြဟံတစ်ဦးတည်းအတွက်သာမဟုတ်ဘဲ
  </para>
  <para style="p">
    <verse number="24" style="v" />ငါတို့အတွက်ပါ ရေးထားခြင်းဖြစ်၏။ တစ်နည်းဆိုသော် ငါတို့၏သခင်ယေရှုအား သေသောသူတို့ထဲမှ ထမြောက်စေတော်မူသောအရှင်ကို ယုံကြည်သည့် ငါတို့ကိုလည်း ဖြောင့်မတ်သည်ဟု သတ်မှတ်တော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="25" style="v" />သခင်ယေရှုသည် ငါတို့ကျူးလွန်သောအပြစ်များအတွက် အပ်နှံခြင်းကိုခံရပြီး ငါတို့ဖြောင့်မတ်သည်ဟု အသိအမှတ်ပြုခြင်းခံရရန်အတွက် ထမြောက်တော်မူ၏။
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />ထို့ကြောင့် ယုံကြည်ခြင်းအားဖြင့် ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရသောငါတို့သည် ငါတို့၏သခင်ယေရှုခရစ်တော်အားဖြင့် ဘုရားသခင်နှင့် ငြိမ်းချမ်းမှုကိုရရှိကြ၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ယခု ငါတို့ရပ်တည်နေသော ဤကျေးဇူးတော်ထဲသို့ ယုံကြည်ခြင်းကြောင့် ခရစ်တော်အားဖြင့် တိုးဝင်ခွင့်ကိုလည်း ငါတို့ရရှိကြသည်ဖြစ်၍ ဘုရားသခင်၏ဘုန်းအသရေတော်နှင့်ဆိုင်သောမျှော်လင့်ခြင်း၌ ဂုဏ်ယူဝမ်းမြောက်ကြ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ထိုမျှမက ဆင်းရဲဒုက္ခများ၌လည်း ဂုဏ်ယူဝမ်းမြောက်ကြ၏။ အကြောင်းမူကား ဆင်းရဲဒုက္ခသည် သည်းခံခြင်းကိုလည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="4" style="v" />သည်းခံခြင်းသည် ပါရမီရင့်ကျက်ခြင်းကိုလည်းကောင်း၊ ပါရမီရင့်ကျက်ခြင်းသည် မျှော်လင့်ခြင်းကိုလည်းကောင်း ဖြစ်ပေါ်စေသည်ကို ငါတို့သိကြ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ထိုမျှော်လင့်ခြင်းသည်လည်း ငါတို့ကိုအရှက်ရစေမည်မဟုတ်။ အကြောင်းမူကား ဘုရားသခင်၏ချစ်ခြင်းမေတ္တာတော်သည် ငါတို့ကိုပေးတော်မူသောသန့်ရှင်းသောဝိညာဉ်တော်အားဖြင့် ငါတို့၏စိတ်နှလုံးထဲ၌ သွန်းလောင်းခြင်းခံရပြီဖြစ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ငါတို့အားနည်းလျက်ရှိနေကြစဉ် ခရစ်တော်သည် အချိန်တန်သည်နှင့် ဘုရားတရားမဲ့သောသူများအတွက် အသေခံတော်မူ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />အကြောင်းမှာ ဖြောင့်မတ်သောသူအတွက် အသေခံမည့်သူရှိခဲ၏။ သူတော်ကောင်းအတွက်ကား အသေခံဝံ့သူရှိကောင်းရှိလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="8" style="v" />သို့သော် ငါတို့သည် အပြစ်သားများဖြစ်ကြစဉ်ပင် ခရစ်တော်သည် ငါတို့အတွက် အသေခံတော်မူခြင်းအားဖြင့် ဘုရားသခင်သည် ငါတို့အပေါ်ထားရှိသော မိမိ၏ချစ်ခြင်းမေတ္တာတော်ကို ထင်ရှားစေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />သို့ဖြစ်၍ ယခုအခါ ခရစ်တော်၏သွေးတော်အားဖြင့် ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရသောငါတို့သည် ကိုယ်တော်အားဖြင့် အမျက်တော်မှ ပို၍ပင် ကယ်တင်ခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အကြောင်းမူကား ရန်သူဖြစ်လျက်ပင် သားတော်၏အသေခံတော်မူခြင်းအားဖြင့် ဘုရားသခင်နှင့်ပြန်လည်သင့်မြတ်ခြင်းအခွင့်ကိုရရှိခဲ့လျှင် ပြန်လည်သင့်မြတ်ခြင်းအခွင့်ကိုရရှိပြီးသောငါတို့သည် သားတော်၏အသက်တော်အားဖြင့် ပို၍ပင် ကယ်တင်ခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ထိုမျှမက ယခု ငါတို့အား ပြန်လည်သင့်မြတ်ခြင်းအခွင့်ကိုရရှိစေသော ငါတို့၏သခင်ယေရှုခရစ်တော်အားဖြင့် ငါတို့သည် ဘုရားသခင်၌ ဂုဏ်ယူဝမ်းမြောက်လျက်ရှိကြ၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ထို့ကြောင့် တစ်ယောက်သောသူအားဖြင့် အပြစ်တရားသည် ဤလောကထဲသို့ဝင်လာ၍ အပြစ်တရားအားဖြင့် သေခြင်းတရားဝင်လာသည်နှင့်အညီ လူအပေါင်းတို့သည် အပြစ်ပြုသဖြင့် လူသားအားလုံးအပေါ်၌ သေခြင်းတရားသက်ရောက်ခဲ့၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />တစ်နည်းကား ပညတ်တရားကိုမပေးမီကပင် အပြစ်သည် ဤလောက၌ရှိ၏။ သို့သော် ပညတ်တရားမရှိလျှင် အပြစ်ကို အပြစ်ဟု မှတ်ယူ၍မရ။
  </para>
  <para style="p">
    <verse number="14" style="v" />မည်သို့ပင်ဖြစ်စေ အာဒံလက်ထက်မှစ၍ မောရှေလက်ထက်တိုင်အောင် သေခြင်းတရားသည် အာဒံ၏ဖောက်ဖျက်ကျူးလွန်မှုနှင့်တူညီသောအပြစ်မျိုးကို မပြုသောသူတို့ကိုပင် စိုးမိုးခဲ့၏။ အာဒံသည် ကြွလာရန်ရှိသောသူ၏ပုံပမာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သို့ရာတွင် ဆုကျေးဇူးသည် ကျူးလွန်သောအပြစ်ကဲ့သို့မဟုတ်ပေ။ အကြောင်းမူကား တစ်ယောက်သောသူကျူးလွန်သည့်အပြစ်ကြောင့် များစွာသောသူတို့သည် သေခဲ့လျှင် ဘုရားသခင်၏ကျေးဇူးတော်နှင့် ယေရှုခရစ်တော်တည်းဟူသော တစ်ယောက်သောသူ၏ကျေးဇူးတော်အားဖြင့် သက်ရောက်သောကောင်းချီးလက်ဆောင်သည် များစွာသောလူတို့၌ ပို၍ပင် ကြွယ်ဝပြည့်စုံမည်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ထို့ပြင် ဆုကျေးဇူးသည် တစ်ယောက်သောသူက အပြစ်ပြုသောကြောင့် ဖြစ်လာသည့်အရာကဲ့သို့မဟုတ်ပေ။ အကြောင်းမူကား ကျူးလွန်သောအပြစ်တစ်ခုကြောင့်ဖြစ်လာသည့် တရားစီရင်ခြင်းသည် ပြစ်ဒဏ်စီရင်ခြင်းသို့ရောက်စေ၏။ သို့သော် ကျူးလွန်သောအပြစ်များစွာကြောင့်ဖြစ်လာသည့် ဆုကျေးဇူးမူကား ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းသို့ရောက်စေ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />အကြောင်းမူကား တစ်ယောက်သောသူကျူးလွန်သည့်အပြစ်ကြောင့် သေခြင်းသည် ထိုသူတစ်ယောက်အားဖြင့် စိုးမိုးခဲ့လျှင် ကျေးဇူးတော်နှင့်ဖြောင့်မတ်ခြင်း၏ကောင်းချီးလက်ဆောင်ကို ကြွယ်ဝစွာခံစားရသောသူတို့သည် တစ်ယောက်သောသူတည်းဟူသော ယေရှုခရစ်တော်အားဖြင့် အသက်ရှင်ခြင်း၌ ပို၍ပင် စိုးမိုးရကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="18" style="v" />သို့ဖြစ်၍ ကျူးလွန်သောအပြစ်တစ်ခုကြောင့် ပြစ်ဒဏ်စီရင်ခြင်းသည် လူအပေါင်းတို့ထံသို့ ရောက်လာသကဲ့သို့ ဖြောင့်မတ်သောအကျင့်တစ်ခုကြောင့် အသက်နှင့်ဆိုင်သောဖြောင့်မတ်ခြင်းသည် လူအပေါင်းတို့ထံသို့ ရောက်လာ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />တစ်နည်းဆိုသော် လူတစ်ယောက်၏မနာခံမှုကြောင့် များစွာသောလူတို့သည် အပြစ်သားအဖြစ် သတ်မှတ်ခြင်းခံရကြသည့်နည်းတူ တစ်ယောက်သောသူ၏နာခံမှုကြောင့် များစွာသောလူတို့သည် ဖြောင့်မတ်သောသူအဖြစ် သတ်မှတ်ခြင်းခံရကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ပညတ်တရားမူကား ကျူးလွန်သောအပြစ်ကို များပြားစေရန်ဝင်ရောက်ခဲ့၏။ သို့သော် အပြစ်များပြားလာသည့်နေရာ၌ ကျေးဇူးတော်သည် ပို၍ပြည့်စုံကြွယ်ဝလေ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဤသည်ကား အပြစ်သည် သေခြင်းအားဖြင့် စိုးမိုးခဲ့သည့်နည်းတူ ကျေးဇူးတော်သည်လည်း ဖြောင့်မတ်ခြင်းအားဖြင့် စိုးမိုးလျက် ငါတို့၏သခင်ယေရှုခရစ်တော်အားဖြင့် ထာဝရအသက်ကိုရရှိစေရန်ဖြစ်၏။
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />သို့ဖြစ်လျှင် မည်သို့ဆိုရမည်နည်း။ ကျေးဇူးတော်များပြားစေရန် ငါတို့သည် အပြစ်ထဲ၌ဆက်၍တည်ရမည်လော။
  </para>
  <para style="p">
    <verse number="2" style="v" />လုံးဝမတည်ရ။ အပြစ်အရာ၌ သေဆုံးသောငါတို့သည် ၎င်းတွင် မည်သို့အသက်ရှင်နိုင်ဦးမည်နည်း။
  </para>
  <para style="p">
    <verse number="3" style="v" />သို့မဟုတ် ခရစ်တော်ယေရှု၌ ဗတ္တိဇံခံခဲ့သောငါတို့သည် ကိုယ်တော်၏အသေခံတော်မူခြင်း၌ ဗတ္တိဇံခံခဲ့ကြောင်း သင်တို့မသိကြသလော။
  </para>
  <para style="p">
    <verse number="4" style="v" />ထိုသို့ ငါတို့သည် အသေခံတော်မူခြင်း၌ ဗတ္တိဇံခံသောအားဖြင့် ကိုယ်တော်နှင့်အတူသင်္ဂြိုဟ်ခြင်းကိုခံကြ၏။ ဤသည်ကား ခရစ်တော်သည် ခမည်းတော်၏ဘုန်းအသရေတော်အားဖြင့် သေသောသူတို့ထဲမှ ထမြောက်တော်မူသည့်နည်းတူ ငါတို့သည်လည်း အသက်တာသစ်၌ အသက်ရှင်လျှောက်လှမ်းကြရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />အကြောင်းမူကား ငါတို့သည် ခရစ်တော်၏အသေခံတော်မူခြင်းနှင့်တူညီသောသဏ္ဌာန်၌ ကိုယ်တော်နှင့်အတူပေါင်းစည်းကြသည်ဆိုလျှင် ကိုယ်တော်၏ရှင်ပြန်ထမြောက်ခြင်းသဏ္ဌာန်ကိုလည်း ဧကန်အမှန်ဆောင်ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ငါတို့၏လူဟောင်းသည် ခရစ်တော်နှင့်အတူ လက်ဝါးကပ်တိုင်ပေါ်၌တင်ထားခြင်းခံရသည်မှာ အပြစ်နှင့်ဆိုင်သောကိုယ်ခန္ဓာသည် ဖျက်ဆီးခြင်းခံရလျက် ငါတို့သည် နောက်ထပ် အပြစ်ထံ၌ ကျွန်မခံရရန်အတွက်ဖြစ်ကြောင်း ငါတို့သိကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />အဘယ်ကြောင့်ဆိုသော် သေလွန်သောသူသည် အပြစ်၏လက်မှ လွတ်မြောက်ပြီဖြစ်၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ငါတို့သည် ခရစ်တော်နှင့်အတူသေလျှင် ကိုယ်တော်နှင့်အတူအသက်ရှင်မည်ဟူ၍လည်း ယုံကြည်ကြ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />သေသောသူတို့ထဲမှ ထမြောက်တော်မူသောခရစ်တော်သည် နောက်တစ်ဖန်သေတော့မည်မဟုတ်ကြောင်း ငါတို့သိကြ၏။ သေခြင်းသည် ကိုယ်တော်ကို အစိုးတရပြုတော့မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အကြောင်းမူကား ခရစ်တော်အသေခံတော်မူသည်မှာ အပြစ်အရာ၌ တစ်ကြိမ်တည်းနှင့်အပြီးအသေခံတော်မူသည်ဖြစ်၍ ယခုအသက်ရှင်တော်မူသည်မှာ ဘုရားသခင်၌ အသက်ရှင်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ထိုနည်းတူ သင်တို့သည်လည်း အပြစ်အရာ၌ သေသောသူဖြစ်ပြီး ဘုရားသခင်၌ ခရစ်တော်ယေရှုအားဖြင့် အသက်ရှင်နေသည်ဟု ကိုယ့်ကိုယ်ကိုယ်မှတ်ယူကြလော့။
  </para>
  <para style="p">
    <verse number="12" style="v" />ထို့ကြောင့် ကိုယ်ခန္ဓာ၏တပ်မက်ခြင်းအလိုသို့လိုက်ရန် သင်တို့၏သေတတ်သောကိုယ်ခန္ဓာကို အပြစ်အား မစိုးမိုးစေကြနှင့်။
  </para>
  <para style="p">
    <verse number="13" style="v" />သင်တို့၏ကိုယ်အင်္ဂါများကိုလည်း မတရားမှု၏လက်နက်များအဖြစ် အပြစ်အား မဆက်သကြနှင့်။ ထိုသို့ပြုမည့်အစား သေသောသူတို့ထဲမှ အသက်ရှင်လာသူကဲ့သို့ မိမိကိုယ်ကို ဘုရားသခင်အား ဆက်သ၍ သင်တို့၏ကိုယ်အင်္ဂါများကို ဖြောင့်မတ်ခြင်း၏လက်နက်များအဖြစ် ဘုရားသခင်အား ဆက်သကြလော့။
  </para>
  <para style="p">
    <verse number="14" style="v" />အဘယ်ကြောင့်ဆိုသော် သင်တို့သည် ပညတ်တရားလက်အောက်၌မရှိဘဲ ကျေးဇူးတော်လက်အောက်၌ရှိကြသည်ဖြစ်၍ အပြစ်တရားသည် သင်တို့ကို အစိုးတရပြုလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />သို့ဖြစ်လျှင် မည်သို့နည်း။ ငါတို့သည် ပညတ်တရားလက်အောက်၌မရှိဘဲ ကျေးဇူးတော်လက်အောက်၌ရှိကြသောကြောင့် အပြစ်ပြုရမည်လော။ လုံးဝမပြုရ။
  </para>
  <para style="p">
    <verse number="16" style="v" />သင်တို့သည် တစ်စုံတစ်ဦးအား မိမိကိုယ်ကိုဆက်သ၍ ကျွန်အဖြစ်နာခံလျှင် သင်တို့သည် သင်တို့နာခံသောသူ၏ကျွန်ဖြစ်ကြပြီး သေခြင်းသို့ရောက်စေသည့် အပြစ်၏ကျွန်၊ သို့မဟုတ် ဖြောင့်မတ်ခြင်းသို့ရောက်စေသည့် နာခံမှု၏ကျွန်ဖြစ်တတ်သည်ကို သင်တို့မသိကြသလော။
  </para>
  <para style="p">
    <verse number="17" style="v" />သင်တို့သည် အပြစ်၏ကျွန်ဖြစ်ခဲ့ကြသော်လည်း သင်တို့ခံယူရရှိသော သွန်သင်ချက်၏နည်းဥပဒေသကို စိတ်နှလုံးနှင့်တကွနာခံကြသဖြင့်
  </para>
  <para style="p">
    <verse number="18" style="v" />အပြစ်၏လက်မှ လွတ်မြောက်ခွင့်ရပြီး ဖြောင့်မတ်ခြင်း၏ကျွန်ဖြစ်လာကြသောကြောင့် ဘုရားသခင်၏ကျေးဇူးတော်ကိုချီးမွမ်း၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />သင်တို့၏သွေးသားဇာတိအားနည်းသောကြောင့် ငါသည် လောကီဝေါဟာရအားဖြင့် ပြောဆို၏။ ယခင်က သင်တို့သည် မိမိတို့၏ကိုယ်အင်္ဂါများကို ညစ်ညူးခြင်းနှင့်တရားမဲ့ခြင်းတို့၏ကျွန်အဖြစ် ဆက်သ၍ တရားမဲ့ခြင်းထဲသို့ ရောက်ခဲ့ကြသည့်နည်းတူ ယခု မိမိတို့၏ကိုယ်အင်္ဂါများကို ဖြောင့်မတ်ခြင်း၏ကျွန်အဖြစ် ဆက်သ၍ သန့်ရှင်းခြင်းသို့ရောက်ကြလော့။
  </para>
  <para style="p">
    <verse number="20" style="v" />သင်တို့သည် အပြစ်၏ကျွန်ဖြစ်ခဲ့စဉ်က ဖြောင့်မတ်ခြင်းနှင့်ကင်းဝေးသောသူများဖြစ်ခဲ့ကြ၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ထိုစဉ်က ယခု သင်တို့ရှက်ကြောက်လျက်ရှိသောအရာတို့မှ မည်သည့်အကျိုးကျေးဇူးကို ရရှိခဲ့ကြသနည်း။ ထိုအရာတို့၏ရလဒ်သည် သေခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />သို့သော် ယခုအခါ သင်တို့သည် အပြစ်၏လက်မှလွတ်မြောက်ခွင့်ရ၍ ဘုရားသခင်၏ကျွန်ဖြစ်လာကြပြီး သန့်ရှင်းခြင်းသို့ရောက်စေသည့်အကျိုးကျေးဇူးကို ခံစားရကြ၏။ ၎င်း၏ရလဒ်မူကား ထာဝရအသက်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />အကြောင်းမှာ အပြစ်၏အခသည် သေခြင်းဖြစ်၏။ ဘုရားသခင်ပေးတော်မူသောဆုကျေးဇူးမူကား ငါတို့၏သခင်ခရစ်တော်ယေရှုအားဖြင့် ထာဝရအသက်ဖြစ်၏။
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />ညီအစ်ကိုတို့၊ ပညတ်တရားကိုသိထားသောသူတို့အား ငါဆိုသည်ကား ပညတ်တရားသည် လူတစ်ဦးကို သူအသက်ရှင်နေသမျှကာလ၌သာ ချုပ်ကိုင်ထားသည်ကို သင်တို့မသိကြသလော။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဥပမာဆိုသော် ကာမပိုင်ရှိသောအမျိုးသမီးတစ်ဦးသည် ပညတ်တရားအရ အသက်ရှင်နေသောခင်ပွန်းနှင့်အနှောင်အဖွဲ့ရှိ၏။ ခင်ပွန်းသေလျှင်မူကား ခင်ပွန်းနှင့်ပတ်သက်သောပညတ်တရားမှ ကင်းလွတ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />သို့ဖြစ်၍ ခင်ပွန်းအသက်ရှင်နေစဉ် အခြားသောယောက်ျားနှင့်ပေါင်းလျှင် ဖောက်ပြန်သောမိန်းမဟု အခေါ်ခံရလိမ့်မည်။ ခင်ပွန်းသေဆုံးလျှင်မူကား ထိုပညတ်တရားမှ ကင်းလွတ်သည်ဖြစ်၍ အခြားသောယောက်ျားနှင့်ပေါင်းသော်လည်း ဖောက်ပြန်သောမိန်းမမဟုတ်ပေ။
  </para>
  <para style="p">
    <verse number="4" style="v" />ထိုနည်းတူ ငါ့ညီအစ်ကိုတို့၊ သင်တို့သည်လည်း ခရစ်တော်၏ကိုယ်ခန္ဓာအားဖြင့် ပညတ်တရားအရာ၌ သေဆုံးခဲ့ကြပြီ။ ဤသည်ကား သင်တို့သည် အခြားသူတည်းဟူသော သေသောသူတို့ထဲမှ ထမြောက်တော်မူသောအရှင်နှင့် သက်ဆိုင်သောသူများဖြစ်လာကြပြီး ဘုရားသခင်အတွက် အသီးများဖြစ်ထွန်းစေရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />အကြောင်းမူကား ငါတို့သည် သွေးသားဇာတိ၌တည်လျက်ရှိစဉ်က ပညတ်တရားကြောင့်ဖြစ်ပေါ်လာသည့် ပြင်းပြသောအပြစ်ပြုလိုစိတ်သည် ငါတို့၏ကိုယ်အင်္ဂါများ၌ သက်ဝင်လှုပ်ရှားနေသဖြင့် သေခြင်းအတွက် အသီးများဖြစ်ထွန်းစေ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />သို့သော် ယခုအခါ ငါတို့သည် ငါတို့ကိုချုပ်နှောင်ထားသောပညတ်တရားအရာ၌ သေဆုံးခဲ့ပြီး ပညတ်တရားမှ ကင်းလွတ်ခွင့်ရကြပြီဖြစ်၍ အက္ခရာတင်ထားသောတရား၏နည်းလမ်းဟောင်းအားဖြင့်မဟုတ်ဘဲ ဝိညာဉ်တော်၏နည်းလမ်းသစ်အားဖြင့် အစေခံလျက်ရှိကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />သို့ဖြစ်လျှင် မည်သို့ဆိုရမည်နည်း။ ပညတ်တရားသည် အပြစ်လော။ လုံးဝမဟုတ်ပေ။ သို့သော် ပညတ်တရားအားဖြင့်မဟုတ်လျှင် အပြစ်ကို ငါသိခဲ့မည်မဟုတ်။ အဘယ်ကြောင့်ဆိုသော် “တပ်မက်သောစိတ်မရှိရ” ဟု ပညတ်တရားက မဆိုထားလျှင် တပ်မက်ခြင်းကို ငါသိခဲ့မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />သို့သော် အပြစ်သည် ပညတ်တော်အားဖြင့် အခွင့်ရကာ ငါ၌ တပ်မက်ခြင်းမျိုးစုံကို ဖြစ်ပေါ်စေ၏။ တစ်နည်းဆိုသော် ပညတ်တရားမရှိလျှင် အပြစ်သည် အသေဖြစ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ငါသည် တစ်ချိန်က ပညတ်တရားမပါဘဲ အသက်ရှင်ခဲ့၏။ သို့သော် ပညတ်တော်ရောက်လာသောအခါ အပြစ်သည် ပြန်လည်ရှင်သန်လာပြီး ငါမူကား သေဆုံးခဲ့သဖြင့်
  </para>
  <para style="p">
    <verse number="10" style="v" />အသက်ရှင်ခြင်းသို့ရောက်စေရမည့် ဤပညတ်တော်သည် သေခြင်းသို့ရောက်စေသည်ကို ငါတွေ့၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />အကြောင်းမူကား အပြစ်သည် ပညတ်တော်အားဖြင့် အခွင့်ရကာ ငါ့ကိုလှည့်ဖြား၍ ထိုပညတ်တော်အားဖြင့် ငါ့ကိုသတ်လေ၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ထို့ကြောင့် ပညတ်တရားသည် သန့်ရှင်း၏။ ပညတ်တော်သည်လည်း သန့်ရှင်းဖြောင့်မတ်၍ ကောင်းမြတ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သို့ဖြစ်လျှင် ဤကောင်းမြတ်သောအရာသည် ငါ့အတွက် သေခြင်းအကြောင်းဖြစ်သလော။ လုံးဝမဟုတ်ပေ။ ငါ့အတွက် သေခြင်းအကြောင်းဖြစ်သောအရာမှာ အပြစ်ပင်ဖြစ်၍ အပြစ်သည် အပြစ်ဖြစ်ကြောင်း ထင်ရှားစေရန် ဤကောင်းမြတ်သောအရာအားဖြင့် ငါ၌ သေခြင်းကိုဖြစ်ပေါ်စေ၏။ ဤသို့ဖြင့် အပြစ်သည် ပညတ်တော်အားဖြင့် အတိုင်းထက်အလွန် အပြစ်များသောအရာဖြစ်လာ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />ပညတ်တရားသည် ဝိညာဉ်ရေးနှင့်ဆိုင်ကြောင်း ငါတို့သိကြ၏။ သို့ရာတွင် ငါသည် သွေးသားဇာတိ၌ရှိသူဖြစ်ပြီး အပြစ်တရား၏လက်အောက်တွင် ရောင်းစားခြင်းခံရသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />ငါသည် မိမိပြုနေသည့်အမှုကိုပင် ကိုယ်တိုင်နားမလည်ပေ။ အဘယ်ကြောင့်ဆိုသော် ငါသည် ကိုယ်ပြုလိုသောအရာကို မပြုဘဲ ကိုယ်မုန်းသောအရာကို ပြုနေ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ထိုသို့ ငါသည် ကိုယ်မပြုလိုသောအရာကို ပြုနေသည်ဆိုလျှင် ပညတ်တရားကောင်းမြတ်ကြောင်းကို ဝန်ခံခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />သို့ဖြစ်လျှင် ထိုအရာကိုပြုသောသူမှာ ငါမဟုတ်တော့ဘဲ ငါ့အထဲ၌ကိန်းအောင်းနေသော အပြစ်ပင်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ငါ့အထဲ၌ တစ်နည်းအားဖြင့် ငါ၏သွေးသားဇာတိထဲ၌ ကောင်းသောအရာတစ်စုံတစ်ခုမျှ ကိန်းအောင်းနေခြင်းမရှိကြောင်း ငါသိ၏။ အဘယ်ကြောင့်ဆိုသော် ကောင်းသောအမှုကိုပြုလိုသောဆန္ဒသည် ငါ၌ရှိသော်လည်း ၎င်းကို ပြုနိုင်စွမ်းမရှိ။
  </para>
  <para style="p">
    <verse number="19" style="v" />အကြောင်းမူကား ငါသည် ကိုယ်ပြုလိုသည့် ကောင်းသောအမှုကိုမပြုဘဲ မပြုလိုသည့် မကောင်းသောအမှုကို ပြုနေ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />သို့သော် ကိုယ်မပြုလိုသောအရာကို ငါပြုနေသည်ဆိုလျှင် ၎င်းကို ငါကိုယ်တိုင်ပြုသည်မဟုတ်တော့ဘဲ ငါ့အထဲ၌ကိန်းအောင်းနေသောအပြစ်က ပြုခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />သို့ဖြစ်၍ ကောင်းသောအမှုကိုပြုလိုသောငါ၌ မကောင်းသောအမှုရှိနေသည်ဟူသောသဘောတရားကို ငါတွေ့၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />တစ်နည်းဆိုသော် ငါသည် အတွင်းဝိညာဉ်လူအားဖြင့် ဘုရားသခင်၏တရားတော်၌ နှစ်သက်ဝမ်းမြောက်လျက်ရှိသော်လည်း
  </para>
  <para style="p">
    <verse number="23" style="v" />ငါ၏ကိုယ်အင်္ဂါများ၌ အခြားသောတရားရှိ၍ ၎င်းတို့သည် ငါ့စိတ်နှလုံး၏တရားနှင့် တိုက်ခိုက်လျက်နေသဖြင့် ငါ၏ကိုယ်အင်္ဂါများ၌ရှိသည့် အပြစ်နှင့်ဆိုင်သောတရားအားဖြင့် ငါ့ကိုဖမ်းဆီးချုပ်နှောင်ထားသည်ကို ငါမြင်၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ငါသည် အလွန်စိတ်ပျက်ဖွယ်ကောင်းသောသူဖြစ်ပေ၏။ မည်သူသည် သေခြင်းနှင့်ဆိုင်သော ဤကိုယ်ခန္ဓာမှ ငါ့ကို ကယ်နုတ်မည်နည်း။
  </para>
  <para style="p">
    <verse number="25" style="v" />သို့သော် ငါတို့၏သခင်ယေရှုခရစ်တော်အားဖြင့် ဘုရားသခင်၏ကျေးဇူးတော်ကိုချီးမွမ်း၏။ ဤသို့ဖြင့် ငါသည် မိမိစိတ်နှလုံးအားဖြင့် ဘုရားသခင်၏တရားတော်ကို အစေခံလျက်ရှိသော်လည်း သွေးသားဇာတိအားဖြင့် အပြစ်နှင့်ဆိုင်သောတရားကို အစေခံလျက်ရှိ၏။
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />ထို့ကြောင့် ယခုအခါ ခရစ်တော်ယေရှု၌ရှိသောသူတို့သည် ပြစ်ဒဏ်စီရင်ခြင်းမခံရ။
  </para>
  <para style="p">
    <verse number="2" style="v" />အကြောင်းမူကား ခရစ်တော်ယေရှု၌ရှိသည့် အသက်ရှင်ခြင်း၏ဝိညာဉ်တော်နှင့်ဆိုင်သောတရားသည် အပြစ်နှင့်သေခြင်းတို့နှင့်ဆိုင်သောတရားမှ သင့်ကိုလွတ်မြောက်စေပြီဖြစ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဘုရားသခင်သည် မိမိ၏သားတော်ကို အပြစ်နှင့်ပြည့်ဝသည့် သွေးသားဇာတိနှင့်တူညီသောသဏ္ဌာန်၌ အပြစ်အတွက်စေလွှတ်တော်မူ၍ သွေးသားဇာတိ၌ရှိသောအပြစ်ကို ဒဏ်ခတ်တော်မူပြီး သွေးသားဇာတိကြောင့် အားနည်း၍ ပညတ်တရားမဆောင်ရွက်နိုင်သောအမှုကို ဆောင်ရွက်ပေးတော်မူ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဤသည်ကား သွေးသားဇာတိအလိုအတိုင်းမဟုတ်ဘဲ ဝိညာဉ်တော်အလိုအတိုင်း အသက်ရှင်လျှောက်လှမ်းနေကြသောငါတို့၌ ပညတ်တရား၏ပြဋ္ဌာန်းချက်များ ပြည့်စုံစေရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />သွေးသားဇာတိအလိုအတိုင်း အသက်ရှင်သောသူတို့သည် သွေးသားဇာတိနှင့်ဆိုင်သောအရာများကို စွဲလမ်းကြ၏။ ဝိညာဉ်တော်အလိုအတိုင်း အသက်ရှင်သောသူတို့မူကား ဝိညာဉ်တော်နှင့်ဆိုင်သောအရာများကို စွဲလမ်းကြ၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />သွေးသားဇာတိနှင့်ဆိုင်သောစိတ်သဘောသည် သေခြင်းဖြစ်၏။ ဝိညာဉ်တော်နှင့်ဆိုင်သောစိတ်သဘောမူကား အသက်ရှင်ခြင်းနှင့်ငြိမ်သက်ခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />အဘယ်ကြောင့်ဆိုသော် သွေးသားဇာတိနှင့်ဆိုင်သောစိတ်သဘောသည် ဘုရားသခင်နှင့် ရန်ဘက်ဖြစ်၏။ အကြောင်းမူကား ထိုစိတ်သဘောသည် ဘုရားသခင်၏ပညတ်တရားကို နာခံခြင်းမရှိ။ အမှန်စင်စစ် နာခံ၍လည်းမရနိုင်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ထို့ကြောင့် သွေးသားဇာတိအားဖြင့်အသက်ရှင်သောသူတို့သည် ဘုရားသခင်ကိုမနှစ်သက်စေနိုင်ကြ။
  </para>
  <para style="p">
    <verse number="9" style="v" />သို့သော် ဘုရားသခင်၏ဝိညာဉ်တော်သည် သင်တို့အထဲ၌ကိန်းဝပ်တော်မူလျှင် သင်တို့သည် သွေးသားဇာတိ၌မဟုတ်ဘဲ ဝိညာဉ်တော်၌ရှိကြ၏။ ခရစ်တော်၏ဝိညာဉ်တော်ကိုမရသောသူသည် ခရစ်တော်နှင့်မဆိုင်။
  </para>
  <para style="p">
    <verse number="10" style="v" />သို့ရာတွင် ခရစ်တော်သည် သင်တို့အထဲ၌ရှိတော်မူလျှင် ကိုယ်ခန္ဓာသည် အပြစ်ကြောင့် သေနေသော်လည်း ဝိညာဉ်သည် ဖြောင့်မတ်ခြင်းကြောင့် အသက်ရှင်လျက်ရှိ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ထိုမျှမက ယေရှုကို သေသောသူတို့ထဲမှ ထမြောက်စေတော်မူသောဘုရားရှင်၏ဝိညာဉ်တော်သည် သင်တို့အထဲ၌ကိန်းဝပ်တော်မူလျှင် ခရစ်တော်ကို သေသောသူတို့ထဲမှထမြောက်စေတော်မူသောဘုရားရှင်သည် သင်တို့အထဲ၌တည်နေသော မိမိ၏ဝိညာဉ်တော်အားဖြင့် သေတတ်သော သင်တို့၏ကိုယ်ခန္ဓာကိုလည်း အသက်ရှင်စေတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="12" style="v" />သို့ဖြစ်၍ ညီအစ်ကိုတို့၊ ငါတို့သည် သွေးသားဇာတိအလိုအတိုင်းအသက်ရှင်ရန် သွေးသားဇာတိအပေါ် တာဝန်ရှိသည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />အဘယ်ကြောင့်ဆိုသော် သင်တို့သည် သွေးသားဇာတိအလိုအတိုင်းအသက်ရှင်လျှင် သေကြရမည်။ သို့သော် ဝိညာဉ်တော်အားဖြင့် ကိုယ်ခန္ဓာ၏လုပ်ဆောင်မှုများကိုသေစေလျှင် သင်တို့သည် အသက်ရှင်ကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="14" style="v" />အကြောင်းမူကား ဘုရားသခင်၏ဝိညာဉ်တော်ရှေ့ဆောင်လမ်းပြမှုကို ခံယူသမျှသောသူတို့သည် ဘုရားသခင်၏သားများဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သင်တို့သည် ကြောက်ရွံ့ခြင်းသို့ တစ်ဖန်ရောက်စေသော ကျွန်၏ဝိညာဉ်ကိုခံယူရရှိကြသည်မဟုတ်ဘဲ သားသမီးအရာကိုပေးသောဝိညာဉ်တော်ကို ခံယူရရှိကြ၏။ ထိုဝိညာဉ်တော်အားဖြင့် “အဗ္ဗ၊ အဖ”ဟု ငါတို့ခေါ်ကြ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ငါတို့သည် ဘုရားသခင်၏သားသမီးများဖြစ်ကြောင်းကို ဝိညာဉ်တော်ကိုယ်တိုင် ငါတို့၏ဝိညာဉ်နှင့်အတူသက်သေခံတော်မူ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ထိုသို့ သားသမီးများဖြစ်ကြလျှင် အမွေခံများလည်း ဖြစ်ကြ၏။ ငါတို့သည် ခရစ်တော်နှင့်အတူဘုန်းတော်ချီးမြှောက်ခြင်းခံရရန် ဒုက္ခဆင်းရဲခြင်းကိုလည်း ကိုယ်တော်နှင့်အတူခံရကြလျှင် ဘုရားသခင်၏အမွေခံများဖြစ်ကြပြီး ခရစ်တော်နှင့်အတူအမွေဆက်ခံသူများလည်း ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ယခုမျက်မှောက်ကာလ၌ ခံရသောဒုက္ခဝေဒနာများသည် ငါတို့၌ထင်ရှားမည့်ဘုန်းအသရေနှင့်နှိုင်းလျှင် မပြောပလောက်ဟု ငါမှတ်ယူ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဖန်ဆင်းခံလောကသည် ဘုရားသခင့်သားများ၏ထင်ရှားခြင်းကို အလွန်တောင့်တသောစိတ်ဖြင့် စောင့်မျှော်လျက်နေ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />အဘယ်ကြောင့်ဆိုသော် ဖန်ဆင်းခံလောကသည် အချည်းနှီးအဖြစ်သို့ချထားခြင်းခံရသည်မှာ မိမိဆန္ဒအလျောက်မဟုတ်ဘဲ ချထားတော်မူသောအရှင်ကြောင့်သာဖြစ်ပြီး
  </para>
  <para style="p">
    <verse number="21" style="v" />ဖန်ဆင်းခံလောကကိုယ်တိုင် ပျက်စီးခြင်း၏အနှောင်အဖွဲ့မှ လွတ်မြောက်၍ ဘုရားသခင့်သားသမီးများ၏ဘုန်းအသရေနှင့်ပြည့်စုံသော လွတ်လပ်ခြင်းသို့ဝင်စားခွင့်ရမည်ဟူသည့် မျှော်လင့်ခြင်းရှိသောကြောင့်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဖန်ဆင်းခံလောကတစ်ခုလုံးသည် ယခုတိုင်အောင် အတူတကွညည်းတွားလျက် အတူတကွသားဖွားခြင်းဝေဒနာကိုခံစားလျက်ရှိကြောင်း ငါတို့သိကြ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ထိုမျှမက ဝိညာဉ်တော်၏အသီးဦးကိုရရှိသော ငါတို့ကိုယ်တိုင်သည်လည်း သားသမီးအရာကိုရခြင်းတည်းဟူသော ငါတို့၏ကိုယ်ခန္ဓာရွေးနုတ်ခံရခြင်းကို စောင့်မျှော်လျက် စိတ်နှလုံးထဲ၌ ညည်းတွားနေကြ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />ငါတို့သည် ဤမျှော်လင့်ခြင်းအားဖြင့် ကယ်တင်ခြင်းခံရကြ၏။ သို့သော် မြင်နေရသောမျှော်လင့်ခြင်းသည် မျှော်လင့်ခြင်းမဟုတ်။ အကြောင်းမှာ မည်သူသည် မြင်နေသောအရာကို ဆက်၍မျှော်လင့်မည်နည်း။
  </para>
  <para style="p">
    <verse number="25" style="v" />မမြင်သေးသောအရာကို ငါတို့မျှော်လင့်ကြလျှင်မူကား ထိုအရာကို သည်းခံသောစိတ်နှင့်စောင့်မျှော်ကြ၏။
  </para>
  <para style="p">
    <verse number="26" style="v" />ထိုနည်းတူ ဝိညာဉ်တော်သည်လည်း ငါတို့၏အားနည်းခြင်းကို ဖေးမကူညီပေးတော်မူ၏။ ငါတို့သည် ဆုတောင်းသင့်သည့်အတိုင်း မည်သို့ဆုတောင်းရမည်ကို မသိကြ။ သို့သော် ဝိညာဉ်တော်ကိုယ်တော်တိုင် စကားဖြင့်ဖော်ပြ၍မရနိုင်သော ညည်းတွားသံများဖြင့် ငါတို့အတွက် အသနားခံပေးတော်မူ၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />စိတ်နှလုံးတို့ကိုစူးစမ်းတော်မူသောအရှင်သည်လည်း ဝိညာဉ်တော်၏စိတ်သဘောကို သိတော်မူ၏။ အကြောင်းမူကား ဝိညာဉ်တော်သည် ဘုရားသခင်၏အလိုတော်နှင့်အညီ သန့်ရှင်းသူများအတွက် အသနားခံပေးတော်မူ၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဘုရားသခင်ကိုချစ်သောသူများတည်းဟူသော အကြံအစည်တော်အတိုင်း ခေါ်ယူတော်မူခြင်းခံရသောသူများအတွက် ဘုရားသခင်သည် ခပ်သိမ်းသောအမှုအရာတို့ကို ပူးပေါင်းလုပ်ဆောင်စေ၍ ကောင်းကျိုးဖြစ်စေတော်မူကြောင်းကို ငါတို့သိကြ၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />အကြောင်းမူကား ဘုရားသခင်သည် သိထားနှင့်တော်မူသောသူတို့ကို မိမိသားတော်၏ပုံသဏ္ဌာန်နှင့်တူညီစေရန် ကြိုတင်သတ်မှတ်ထားတော်မူ၏။ ဤသည်ကား သားတော်သည် များစွာသောညီအစ်ကိုတို့တွင် သားဦးဖြစ်မည့်အကြောင်းတည်း။
  </para>
  <para style="p">
    <verse number="30" style="v" />ထိုသို့ကြိုတင်သတ်မှတ်ထားတော်မူသောသူတို့ကို ဘုရားသခင်သည် ခေါ်ယူတော်မူပြီး ခေါ်ယူတော်မူသောသူတို့ကို ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုတော်မူ၍ ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုတော်မူသောသူတို့ကို ချီးမြှောက်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />သို့ဖြစ်လျှင် ဤအရာများကိုထောက်၍ မည်သို့ဆိုရမည်နည်း။ ဘုရားသခင်သည် ငါတို့ဘက်၌ရှိတော်မူလျှင် မည်သူသည် ငါတို့ကို ဆန့်ကျင်နိုင်မည်နည်း။
  </para>
  <para style="p">
    <verse number="32" style="v" />မိမိသားတော်ရင်းကိုပင် ချန်လှပ်မထားဘဲ ငါတို့အားလုံးအတွက် စွန့်တော်မူသောအရှင်သည် သားတော်နှင့်တကွ အရာခပ်သိမ်းတို့ကိုလည်း ငါတို့အားမပေးဘဲနေတော်မူမည်လော။
  </para>
  <para style="p">
    <verse number="33" style="v" />မည်သူသည် ဘုရားသခင်ရွေးကောက်တော်မူသောသူတို့ကို ပြစ်တင်စွဲဆိုမည်နည်း။ ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုတော်မူသောအရှင်ကား ဘုရားသခင်ပေတည်း။
  </para>
  <para style="p">
    <verse number="34" style="v" />မည်သူသည် ပြစ်ဒဏ်စီရင်မည်နည်း။ အသေခံတော်မူသည်သာမက ထမြောက်တော်မူသော ခရစ်တော်ယေရှုသည် ဘုရားသခင်၏လက်ယာတော်ဘက်၌နေ၍ ငါတို့အတွက် အသနားခံပေးတော်မူ၏။
  </para>
  <para style="p">
    <verse number="35" style="v" />မည်သူသည် ငါတို့ကို ခရစ်တော်၏ချစ်ခြင်းမေတ္တာတော်နှင့် ကွဲကွာစေမည်နည်း။ ဆင်းရဲဒုက္ခ၊ နာကျင်ခြင်းဝေဒနာ၊ ညှဉ်းဆဲခြင်း၊ ငတ်မွတ်ခေါင်းပါးခြင်း၊ အဝတ်အချည်းစည်းရှိခြင်း၊ ဘေးအန္တရာယ်နှင့် ဓားဘေးစသည်တို့လော။
  </para>
  <para style="p">
    <verse number="36" style="v" />“အကျွန်ုပ်တို့သည် ကိုယ်တော်အတွက် တစ်နေ့လုံးသေခြင်းနှင့်ရင်ဆိုင်နေကြရပါ၏။ အကျွန်ုပ်တို့သည် သတ်ရန်လျာထားသောသိုးများကဲ့သို့ မှတ်ယူခြင်းခံရကြပါ၏” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="37" style="v" />သို့သော် ငါတို့သည် ငါတို့ကိုချစ်တော်မူသောအရှင်အားဖြင့် ထိုအမှုခပ်သိမ်းတို့ကိုခံရစဉ်၌ပင် လုံးလုံးလျားလျားအောင်မြင်လျက်ရှိကြ၏။
  </para>
  <para style="p">
    <verse number="38" style="v" />အကြောင်းမူကား သေခြင်းဖြစ်စေ၊ အသက်ရှင်ခြင်းဖြစ်စေ၊ ကောင်းကင်တမန်များဖြစ်စေ၊ အုပ်ချုပ်သူများဖြစ်စေ၊ မျက်မှောက်အရာများဖြစ်စေ၊ နောင်လာမည့်အရာများဖြစ်စေ၊ တန်ခိုးများဖြစ်စေ၊
  </para>
  <para style="p">
    <verse number="39" style="v" />အထက်အရာဖြစ်စေ၊ အောက်အရာဖြစ်စေ၊ ဖန်ဆင်းတော်မူသောအခြားမည်သည့်အရာပင်ဖြစ်စေ ငါတို့၏သခင်ခရစ်တော်ယေရှု၌ရှိသော ဘုရားသခင်၏ချစ်ခြင်းမေတ္တာတော်နှင့် ငါတို့ကို မကွဲကွာစေနိုင်ဟု ငါသည် ယုံကြည်စိတ်ချ၏။
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />ငါသည် ခရစ်တော်၌ မုသားမပါ ဟုတ်မှန်ရာကိုပြောမည်။ ငါ၏အသိစိတ်သည် သန့်ရှင်းသောဝိညာဉ်တော်အားဖြင့် ငါနှင့်အတူသက်သေခံလျက်နေသည့်အကြောင်းကား
  </para>
  <para style="p">
    <verse number="2" style="v" />ငါ၌အလွန်ဝမ်းနည်းခြင်းရှိ၍ ငါ၏စိတ်နှလုံးထဲတွင် အမြဲမပြတ်ပူပန်ခြင်းဝေဒနာရှိ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />အမှန်စင်စစ် သွေးသားဇာတိအားဖြင့် ငါ၏အမျိုးသားချင်းများဖြစ်ကြသော ငါ့ညီအစ်ကိုတို့အတွက် ငါကိုယ်တိုင် ခရစ်တော်နှင့်ကွဲကွာလျက် ကျိန်ခြင်းကိုပင် ခံလိုသောဆန္ဒရှိ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />သူတို့သည် အစ္စရေးအမျိုးသားများဖြစ်ကြပြီး သားသမီးအရာဖြစ်စေ၊ ဘုန်းအသရေဖြစ်စေ၊ ပဋိညာဉ်များဖြစ်စေ၊ ပညတ်တရားပေးအပ်ခြင်းဖြစ်စေ၊ ဝတ်ပြုခြင်းဖြစ်စေ၊ ကတိတော်များဖြစ်စေ ထိုသူတို့နှင့်ဆိုင်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ရှေးဘိုးဘေးတို့သည် သူတို့နှင့်ဆက်နွှယ်ကြ၍ ခရစ်တော်သည်လည်း လူသားအနေဖြင့် သူတို့ထဲမှပေါ်ထွန်းတော်မူ၏။ ထိုအရှင်သည် အရာခပ်သိမ်းတို့အထက်၌ရှိ၍ ကာလအစဉ်အဆက်မင်္ဂလာရှိတော်မူသော ဘုရားသခင်ဖြစ်တော်မူ၏။ အာမင်။
  </para>
  <para style="p">
    <verse number="6" style="v" />မည်သို့ပင်ဖြစ်စေ ဘုရားသခင်၏နှုတ်ကပတ်တော်သည် ပျက်ပြယ်သွားသည်မဟုတ်။ အဘယ်ကြောင့်ဆိုသော် အစ္စရေးအနွယ်ဝင်အားလုံးသည် အစ္စရေးလူမျိုးမဟုတ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />အာဗြဟံ၏အမျိုးအနွယ်ဖြစ်သောကြောင့် အားလုံးသည် သားသမီးများဖြစ်ကြသည်မဟုတ်။ “ဣဇက်မှဆင်းသက်သောသူသည် သင်၏အမျိုးအနွယ်ဟူ၍ ခေါ်ဝေါ်ခြင်းခံရလိမ့်မည်” ဟု အမိန့်တော်ရှိ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဆိုလိုသည်ကား သွေးသားနှင့်ဆိုင်သောသားသမီးများသည် ဘုရားသခင်၏သားသမီးများမဟုတ်ဘဲ ကတိတော်နှင့်ဆိုင်သောသားသမီးများသာလျှင် အမျိုးအနွယ်အဖြစ်သတ်မှတ်ခြင်းခံရ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />အဘယ်ကြောင့်ဆိုသော် ကတိတော်စကားမှာ “ဤသို့သောအချိန်အခါတွင် ငါလာခဲ့ဦးမည်။ စာရာသည်လည်း သားတစ်ဦးကိုရရှိလိမ့်မည်” ဟူ၍ ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ထိုမျှမက ရေဗက္ကာသည်လည်း ငါတို့၏ရှေးဘိုးဘေးဣဇက်တစ်ဦးတည်းနှင့်ပင်စုံဖက်၍ ကိုယ်ဝန်ရရှိသောအခါ
  </para>
  <para style="p">
    <verse number="11" style="v" />သားတို့မမွေးဖွားမီ၊ ထိုသားတို့သည် အကောင်းအဆိုးကိုမပြုကျင့်မီကပင် ဘုရားသခင်၏ရွေးကောက်ခြင်းနှင့်ဆိုင်သော အကြံအစည်တော်သည် အကျင့်အားဖြင့်မဟုတ်ဘဲ ခေါ်ယူတော်မူသောသူအားဖြင့် တည်စေရန်
  </para>
  <para style="p">
    <verse number="12" style="v" />“အကြီးသည် အငယ်ကို အစေခံရလိမ့်မည်” ဟု ရေဗက္ကာအား မိန့်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />“ယာကုပ်ကို ငါချစ်၏။ ဧသောကိုမူကား ငါမုန်း၏” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />သို့ဖြစ်လျှင် ငါတို့သည် မည်သို့ဆိုရမည်နည်း။ ဘုရားသခင်၌ မတရားမှုရှိသလော။ လုံးဝမရှိပေ။
  </para>
  <para style="p">
    <verse number="15" style="v" />အဘယ်ကြောင့်ဆိုသော် ဘုရားသခင်သည် မောရှေအား “ငါသည် သနားလိုသောသူကိုသနား၍ သက်ညှာလိုသောသူကို သက်ညှာမည်” ဟု မိန့်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />ထို့ကြောင့် ဤအရာသည် လူ၏အလိုဆန္ဒအပေါ်၌လည်းကောင်း၊ ကြိုးစားအားထုတ်မှုအပေါ်၌လည်းကောင်း မမူတည်ဘဲ ကရုဏာထားတော်မူသောဘုရားသခင်အပေါ်၌သာ မူတည်၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />အကြောင်းမူကား ကျမ်းစာ၌ ဖာရောဘုရင်အား “သင့်ကို ငါချီးမြှောက်ခြင်းမှာ သင်၌ ငါ့တန်ခိုးကိုပြသ၍ ကမ္ဘာမြေတစ်ဝန်းလုံးတွင် ငါ၏နာမကို ကျော်ကြားစေရန်ဖြစ်၏” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ထို့ကြောင့် ဘုရားသခင်သည် သနားလိုသောသူကို သနားတော်မူ၍ ခေါင်းမာစေလိုသောသူကို ခေါင်းမာစေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ထိုအခါ သင်က “သို့ဖြစ်လျှင် ဘုရားသခင်သည် လူတို့ကို အဘယ်ကြောင့် အပြစ်တင်တော်မူသေးသနည်း။ မည်သူသည် ဘုရားသခင်၏အလိုတော်ကို ဆန့်ကျင်နိုင်မည်နည်း”ဟု ငါ့အား မေးမြန်းလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="20" style="v" />သို့သော် အချင်းလူ၊ သင်သည် မည်သူဖြစ်၍ ဘုရားသခင်ကို ပြန်ခံပြောဆိုသနည်း။ ပုံသွင်းခံရသောအရာသည် ပုံသွင်းပေးသောသူအား “အဘယ်ကြောင့် ငါ့ကို ဤသို့ပြုလုပ်ခဲ့သနည်း”ဟု ပြောဆိုနိုင်ပါမည်လော။
  </para>
  <para style="p">
    <verse number="21" style="v" />အိုးထိန်းသည်သည် ရွှံ့စေးတစ်ပုံတည်းထဲမှ အသရေရှိသောအရာအတွက်သုံးရန် အိုးခွက်ကိုလည်းကောင်း၊ အသရေမရှိသောအရာအတွက်သုံးရန် အိုးခွက်ကိုလည်းကောင်း လုပ်ပိုင်ခွင့်ရှိသည်မဟုတ်လော။
  </para>
  <para style="p">
    <verse number="22" style="v" />သို့ရာတွင် ဘုရားသခင်သည် အမျက်တော်ကိုပြသရန်နှင့် မိမိ၏တန်ခိုးတော်ကိုသိစေရန် အလိုတော်ရှိလျက်နှင့်ပင် ဖျက်ဆီးရန်ပြင်ဆင်ထားသော အမျက်တော်ဆိုင်ရာအိုးခွက်များကို အလွန်စိတ်ရှည်စွာသည်းခံတော်မူလျှင် မည်သို့နည်း။
  </para>
  <para style="p">
    <verse number="23" style="v" />ထို့ပြင် ဘုန်းအသရေအတွက်ကြိုတင်ပြင်ဆင်ထားသော ကရုဏာတော်ဆိုင်ရာအိုးခွက်များ၌ မိမိဘုန်းအသရေတော်၏ကြွယ်ဝမှုကို သိစေရန်ပြုတော်မူလျှင် မည်သို့နည်း။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဘုရားသခင်သည် ငါတို့ကို ထိုကရုဏာတော်ဆိုင်ရာအိုးခွက်များအဖြစ် ဂျူးလူမျိုးတို့ထဲမှသာမကဘဲ လူမျိုးခြားတို့ထဲမှလည်း ခေါ်ယူထားတော်မူ၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဟောရှေကျမ်း၌ “ငါ၏လူမျိုးမဟုတ်သောသူကို ‘ငါ၏လူမျိုး’ဟူ၍လည်းကောင်း၊ မချစ်သောသူကို ‘ချစ်သောသူ’ဟူ၍လည်းကောင်း ငါခေါ်မည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />‘သင်တို့သည် ငါ၏လူမျိုးမဟုတ်’ဟု သူတို့အားမိန့်ဆိုထားသော ထိုအရပ်၌ပင် သူတို့သည် ‘အသက်ရှင်တော်မူသော ဘုရားသခင်၏သားများ’ဟူ၍ ခေါ်ဝေါ်ခြင်းခံရကြလိမ့်မည်” ဟု မိန့်တော်မူသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဟေရှာယကလည်း အစ္စရေးလူမျိုးနှင့်ပတ်သက်၍ “အစ္စရေးအမျိုးသားတို့၏အရေအတွက်သည် ပင်လယ်သဲပွင့်များနှင့်အမျှရှိသော်လည်း ကျန်ရစ်သောသူမျှသာ ကယ်တင်ခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="28" style="v" />အကြောင်းမူကား ထာဝရဘုရားသည် မိန့်တော်မူသောအရာကို မြေကြီးပေါ်၌ပြည့်စုံစေ၍ မဆိုင်းမတွ ပြုလုပ်တော်မူလိမ့်မည်” ဟု ကြွေးကြော်၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />ထို့ပြင် ဟေရှာယက “ကောင်းကင်ဗိုလ်ခြေအရှင်ထာဝရဘုရားသည် ငါတို့အတွက် အမျိုးအနွယ်ကိုချန်ထားတော်မမူလျှင် ငါတို့သည် သောဒုံမြို့ကဲ့သို့ဖြစ်ခဲ့၍ ဂေါမောရမြို့နှင့်တူခဲ့ကြပေလိမ့်မည်” ဟု ကြိုတင်ပြောထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />သို့ဖြစ်လျှင် ငါတို့သည် မည်သို့ဆိုရမည်နည်း။ ဖြောင့်မတ်ခြင်းကိုရရှိရန် မကြိုးစားသောလူမျိုးခြားတို့သည် ဖြောင့်မတ်ခြင်းကိုခံယူရရှိကြ၏။ တစ်နည်းဆိုသော် ယုံကြည်ခြင်းအားဖြင့်ရရှိသော ဖြောင့်မတ်ခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="31" style="v" />သို့ရာတွင် ဖြောင့်မတ်ခြင်းနှင့်ဆိုင်သည့်တရားကို ရရှိရန်ကြိုးစားသောအစ္စရေးလူမျိုးတို့သည် ထိုတရားသို့မပေါက်ရောက်ကြ။
  </para>
  <para style="p">
    <verse number="32" style="v" />အဘယ်ကြောင့် မပေါက်ရောက်သနည်း။ ယုံကြည်ခြင်းအားဖြင့်မဟုတ်ဘဲ အကျင့်အားဖြင့်ရရှိနိုင်သကဲ့သို့ ကြိုးစားသောကြောင့်ဖြစ်၏။ သူတို့သည် ခလုတ်တံသင်းဖြစ်သောကျောက်ကို တိုက်မိကြပြီ။
  </para>
  <para style="p">
    <verse number="33" style="v" />ဤသည်ကား “ကြည့်ရှုလော့။ ခလုတ်တံသင်းဖြစ်သောကျောက်၊ မှားယွင်းစေသောကျောက်ကို ဇိအုန်၌ ငါချထား၏။ ထိုကျောက်ကိုယုံကြည်သောသူသည် အရှက်ရလိမ့်မည်မဟုတ်” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />ညီအစ်ကိုတို့၊ ငါ့စိတ်နှလုံး၏လိုအင်ဆန္ဒနှင့် အစ္စရေးလူမျိုးတို့အတွက် ဘုရားသခင်ထံ ငါဆုတောင်းသောအရာမှာ သူတို့ကယ်တင်ခြင်းရရှိရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />သူတို့သည် ဘုရားသခင်အတွက် ထက်သန်သောစိတ်ရှိကြောင်း ငါသက်သေခံ၏။ သို့သော် ထိုထက်သန်သောစိတ်သည် စစ်မှန်သောအသိပညာအားဖြင့်မဟုတ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />အကြောင်းမှာ သူတို့သည် ဘုရားသခင်၏ဖြောင့်မတ်ခြင်းကိုမသိဘဲ မိမိ၏ဖြောင့်မတ်ခြင်းကိုတည်စေရန် ရှာကြံလျက် ဘုရားသခင်၏ဖြောင့်မတ်ခြင်းကို မနာခံသောကြောင့်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />ခရစ်တော်သည် ယုံကြည်သောသူတိုင်း ဖြောင့်မတ်ခြင်းကိုရရှိရန် ပညတ်တရား၏အဆုံးသတ်ရာဖြစ်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />မောရှေကလည်း ပညတ်တရားနှင့်ဆိုင်သော ဖြောင့်မတ်ခြင်းနှင့်ပတ်သက်၍ “ဤအရာများကိုလိုက်နာကျင့်သုံးသောသူသည် ၎င်းတို့အားဖြင့် အသက်ရှင်လိမ့်မည်” ဟု ရေးထား၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ယုံကြည်ခြင်းအားဖြင့်ရရှိသောဖြောင့်မတ်ခြင်းမူကား “သင်၏စိတ်နှလုံးထဲ၌ ကောင်းကင်သို့ မည်သူတက်မည်နည်းဟု မပြောနှင့်။ (ဤသည်ကား ခရစ်တော်ကို အောက်သို့ခေါ်ဆောင်လာခြင်းဖြစ်၏။)
  </para>
  <para style="p">
    <verse number="7" style="v" />သို့မဟုတ် အတိုင်းမသိနက်ရှိုင်းရာအရပ်ထဲသို့ မည်သူဆင်းမည်နည်းဟူ၍လည်း မပြောနှင့် (ဤသည်ကား ခရစ်တော်ကို သေသောသူတို့ထဲမှ ခေါ်ထုတ်ခြင်းဖြစ်၏)”ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ထို့ပြင် မည်သို့ဆိုထားသနည်း။ “တရားစကားသည် သင်၏အနီး၌ရှိ၏။ သင်၏နှုတ်၌လည်းကောင်း၊ သင်၏စိတ်နှလုံး၌လည်းကောင်း ရှိ၏” ဟု ဆိုထား၏။ ဤသည်ကား ငါတို့ဟောပြောသည့် ယုံကြည်ခြင်းနှင့်ဆိုင်သော တရားစကားဖြစ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />သင်သည် မိမိနှုတ်ဖြင့် ယေရှုသည် အရှင်သခင်ဖြစ်ကြောင်းဝန်ခံ၍ သင်၏စိတ်နှလုံးထဲ၌ ဘုရားသခင်သည် သူ့ကို သေသောသူတို့ထဲမှ ထမြောက်စေတော်မူပြီဟု ယုံကြည်လျှင် ကယ်တင်ခြင်းခံရမည်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အကြောင်းမူကား လူသည် စိတ်နှလုံးဖြင့်ယုံကြည်၍ ဖြောင့်မတ်သည်ဟုအသိအမှတ်ပြုခြင်းခံရပြီး နှုတ်ဖြင့်ဝန်ခံ၍ ကယ်တင်ခြင်းခံရ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />အဘယ်ကြောင့်ဆိုသော် ကျမ်းစာက “ထိုကျောက်ကိုယုံကြည်သမျှသောသူသည် အရှက်ရလိမ့်မည်မဟုတ်” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဤတွင် ဂျူးလူမျိုးနှင့်ဂရိလူမျိုးတို့ကြား၌ ခြားနားမှုမရှိ။ အကြောင်းမူကား တစ်ပါးတည်းသောအရှင်သည် လူအပေါင်းတို့၏အရှင်ဖြစ်တော်မူပြီး ကိုယ်တော်ကိုပတ္ထနာပြုသောသူအပေါင်းတို့အား ကြွယ်ဝစေတော်မူ၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />“ထာဝရဘုရား၏နာမတော်ကိုပတ္ထနာပြုသောသူတိုင်း ကယ်တင်ခြင်းခံရမည်” ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />သို့ရာတွင် မိမိမယုံကြည်သောအရှင်ထံ မည်သို့ပတ္ထနာပြုနိုင်မည်နည်း။ မိမိမကြားဖူးသောအရှင်ကို မည်သို့ယုံကြည်နိုင်မည်နည်း။ ဟောပြောသောသူမရှိလျှင် မည်သို့ကြားနိုင်မည်နည်း။
  </para>
  <para style="p">
    <verse number="15" style="v" />စေလွှတ်ခြင်းမခံရလျှင် မည်သို့ဟောပြောနိုင်မည်နည်း။ “ကောင်းမြတ်ခြင်းနှင့်ဆိုင်သည့် ဝမ်းမြောက်ဖွယ်သတင်းကိုဟောပြောသောသူများ၏ခြေတို့သည် အလွန်တင့်တယ်စွတကား” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="16" style="v" />သို့သော် ဤကောင်းမြတ်သောသတင်းကို သူတို့အားလုံးနာခံကြသည်မဟုတ်။ ပရောဖက်ဟေရှာယက “အို ထာဝရဘုရား၊ အကျွန်ုပ်တို့၏သတင်းစကားကို မည်သူယုံကြည်ပါသနည်း” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />သို့ဖြစ်၍ ယုံကြည်ခြင်းသည် ကြားနာခြင်းအားဖြင့်ဖြစ်ပြီး ကြားနာခြင်းသည် ခရစ်တော်၏စကားတော်အားဖြင့်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />သို့သော် ငါမေးလိုသည်မှာ ထိုသူတို့မကြားခဲ့ရသလော။ အမှန်ပင်ကြားခဲ့ရ၏။ “သူတို့၏အသံသည် မြေကြီးတစ်ပြင်လုံးသို့ ပျံ့နှံ့သွား၍ သူတို့၏စကားသည် ကမ္ဘာလောကအစွန်အဖျားတိုင်အောင် ရောက်လေ၏။ ”
  </para>
  <para style="p">
    <verse number="19" style="v" />တစ်ဖန် ငါမေးလိုသည်မှာ အစ္စရေးလူမျိုးတို့သည် မသိကြသလော။ ပထမဦးစွာ မောရှေက “ငါသည် မပြောပလောက်သောလူမျိုးအားဖြင့် သင်တို့၌ မနာလိုစိတ်ဖြစ်ပေါ်စေ၍ အသိတရားကင်းမဲ့သောလူမျိုးအားဖြင့် သင်တို့ကို မခံမရပ်နိုင်ဖြစ်စေမည်” ဟု ဆို၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ပရောဖက်ဟေရှာယကလည်း “ငါ့ကိုမရှာသောသူတို့သည် ငါ့ကိုတွေ့ရှိကြ၏။ ငါ့အကြောင်းကိုမမေးမြန်းသောသူတို့ထံ ငါ့ကိုယ်ငါထင်ရှားပြ၏” ဟု ရဲရင့်စွာဆိုထား၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />အစ္စရေးလူမျိုးနှင့်ပတ်သက်၍မူကား “နာခံခြင်းမရှိ၊ ဆန့်ကျင်ပုန်ကန်တတ်သောလူမျိုးထံသို့ တစ်နေ့လုံး ငါ့လက်ကို ကမ်းလျက်နေခဲ့၏” ဟု ဆို၏။
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />သို့ဖြစ်လျှင် ငါမေးလိုသည်မှာ ဘုရားသခင်သည် မိမိ၏လူမျိုးတော်ကို ပစ်ပယ်တော်မူပြီလော။ လုံးဝပစ်ပယ်တော်မမူ။ ငါကိုယ်တိုင်လည်း အစ္စရေးလူမျိုး၊ အာဗြဟံမှဆင်းသက်လာသူ၊ ဗင်္ယာမိန်အနွယ်ဝင်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဘုရားသခင်သည် သိထားနှင့်တော်မူသော မိမိ၏လူမျိုးတော်ကို ပစ်ပယ်တော်မမူ။ ပရောဖက်ဧလိယက အစ္စရေးလူမျိုးကို ဘုရားသခင်ထံ တိုင်ကြားသောအခါ ကျမ်းစာ၌ ထိုအကြောင်းနှင့်ပတ်သက်၍ မည်သို့ဆိုထားသည်ကို သင်တို့မသိကြသလော။
  </para>
  <para style="p">
    <verse number="3" style="v" />သူက “အို ထာဝရဘုရား၊ သူတို့သည် ကိုယ်တော်၏ပရောဖက်များကိုသတ်လျက် ကိုယ်တော်၏ယဇ်ပလ္လင်များကိုဖြိုဖျက်ကြပါပြီ။ အကျွန်ုပ်တစ်ဦးတည်းကျန်ရစ်ခဲ့၍ အကျွန်ုပ်၏အသက်ကိုလည်း ရန်ရှာနေကြပါ၏” ဟု လျှောက်လေ၏။
  </para>
  <para style="p">
    <verse number="4" style="v" />သို့ရာတွင် ဘုရားသခင်သည် သူ့ကို မည်သို့ ပြန်၍မိန့်တော်မူသနည်း။ “ငါသည် ဗာလရှေ့၌ဒူးမထောက်သော လူခုနစ်ထောင်ကို ငါ့အတွက်ချန်ထား၏” ဟု မိန့်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />ထိုနည်းတူ ယခုအချိန်အခါ၌လည်း ကျေးဇူးတော်အားဖြင့် ရွေးကောက်ခံရသည့်ကြွင်းကျန်သောသူရှိသေး၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />သို့သော် ကျေးဇူးတော်အားဖြင့်ဖြစ်လျှင် အကျင့်အားဖြင့်မဟုတ်တော့ပေ။ သို့မဟုတ်လျှင် ကျေးဇူးတော်သည် ကျေးဇူးတော်ဖြစ်တော့မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />သို့ဖြစ်လျှင် မည်သို့နည်း။ အစ္စရေးလူမျိုးတို့သည် မိမိတို့ကြိုးစားရှာဖွေသောအရာကို မရရှိကြ။ ရွေးကောက်တော်မူသောသူတို့သာ ရရှိကြပြီး ကျန်သောသူတို့သည် မာကျောခက်ထန်သောသဘောရှိကြ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />“ဘုရားသခင်သည် သူတို့အား ယနေ့ထိတိုင်အောင် ထိုင်းမှိုင်းသောစိတ်သဘောကိုလည်းကောင်း၊ မမြင်နိုင်သောမျက်စိကိုလည်းကောင်း၊ မကြားနိုင်သောနားကိုလည်းကောင်း ပေးတော်မူ၏” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဒါဝိဒ်ကလည်း “သူတို့၏စားပွဲသည် သူတို့အတွက် ကျော့ကွင်းသော်လည်းကောင်း၊ ထောင်ချောက်သော်လည်းကောင်း၊ မှားယွင်းစေသောအရာသော်လည်းကောင်း၊ လက်တုံ့ပြန်စရာသော်လည်းကောင်း ဖြစ်ပါစေ။
  </para>
  <para style="p">
    <verse number="10" style="v" />သူတို့၏မျက်စိသည် မမြင်နိုင်အောင်ကွယ်ပါစေ။ သူတို့၏ကျောသည်လည်း အစဉ်ကုန်းပါစေ” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />သို့ဖြစ်လျှင် သူတို့ခလုတ်တိုက်ကြသည်မှာ သူတို့လဲကျစေရန်လောဟု ငါမေး၏။ လုံးဝမဟုတ်ပေ။ အမှန်အားဖြင့် သူတို့ကျူးလွန်သောအပြစ်ကြောင့် လူမျိုးခြားတို့ထံ ကယ်တင်ခြင်းကျေးဇူးသက်ရောက်၍ ဤအမှုအားဖြင့် အစ္စရေးလူမျိုးတို့၌ မနာလိုစိတ်ဖြစ်ပေါ်စေရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />သို့သော် သူတို့ကျူးလွန်သောအပြစ်သည် လောကီသားတို့၏ကြွယ်ဝမှုဖြစ်ခဲ့ပြီး သူတို့၏ရှုံးနိမ့်ခြင်းသည် လူမျိုးခြားတို့၏ကြွယ်ဝခြင်းဖြစ်ခဲ့လျှင် သူတို့၏ပြည့်စုံခြင်းသည် မည်မျှပို၍များသောအကျိုးကို ဖြစ်စေလိမ့်မည်နည်း။
  </para>
  <para style="p">
    <verse number="13" style="v" />ထို့ကြောင့် လူမျိုးခြားဖြစ်သောသင်တို့အား ငါပြောလိုသည်မှာ ငါသည် လူမျိုးခြားနှင့်ဆိုင်သော တမန်တော်ဖြစ်သည့်အလျောက် ငါ၏အမှုတော်လုပ်ငန်းကို ဂုဏ်ယူလျက်
  </para>
  <para style="p">
    <verse number="14" style="v" />တစ်နည်းနည်းဖြင့် ငါ၏အမျိုးသားချင်းတို့၌ မနာလိုစိတ်ဖြစ်ပေါ်စေ၍ သူတို့ထဲမှ အချို့တို့ကိုကယ်တင်နိုင်ရန် ငါမျှော်လင့်နေ၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />အကြောင်းမူကား သူတို့ပစ်ပယ်ခံရခြင်းသည် လောကီသားတို့အတွက် ပြန်လည်သင့်မြတ်ခြင်းအခွင့်ဖြစ်လျှင် သူတို့ကို ပြန်၍လက်ခံခြင်းသည် သေလွန်သောသူတို့အသက်ပြန်ရှင်ခြင်းဖြစ်လိမ့်မည်မဟုတ်လော။
  </para>
  <para style="p">
    <verse number="16" style="v" />အသီးဦးအဖြစ်ပူဇော်သောမုန့်ညက်သည် သန့်ရှင်းလျှင် မုန့်ညက်တစ်ပုံလုံးသည်လည်း သန့်ရှင်း၏။ အမြစ်သည် သန့်ရှင်းလျှင် အကိုင်းအခက်များသည်လည်း သန့်ရှင်းကြ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />သို့သော် အကိုင်းအခက်အချို့တို့သည် ခုတ်ဖြတ်ခြင်းခံရ၍ သံလွင်ပင်အရိုင်းဖြစ်သောသင်သည် ထိုအကိုင်းအခက်များကြား၌ ကိုင်းဆက်ကူးခံရပြီး သံလွင်ပင်အမြစ်မှအဆီအနှစ်ကို မျှဝေခံစားသူဖြစ်လာလျှင်
  </para>
  <para style="p">
    <verse number="18" style="v" />ထိုအကိုင်းအခက်များအပေါ် ဝါကြွားသောစိတ်မရှိနှင့်။ ဝါကြွားလျှင်လည်း သင်သည် အမြစ်ကိုထောက်မသည်မဟုတ်။ အမြစ်ကသာ သင့်ကိုထောက်မ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />ထိုအခါ သင်က “ငါ့ကို ကိုင်းဆက်ကူးရန်အတွက် အကိုင်းအခက်များသည် ခုတ်ဖြတ်ခြင်းခံရကြသည်”ဟု ဆိုလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="20" style="v" />မှန်ပေ၏။ သူတို့သည် မယုံကြည်မှုကြောင့် ခုတ်ဖြတ်ခြင်းခံရပြီး သင်မူကား ယုံကြည်ခြင်းကြောင့်တည်နေ၏။ ထောင်လွှားသောသဘောမရှိဘဲ ကြောက်ရွံ့ခြင်းရှိလော့။
  </para>
  <para style="p">
    <verse number="21" style="v" />အကြောင်းမူကား ဘုရားသခင်သည် မူလအကိုင်းအခက်များကို ညှာတာတော်မမူခဲ့လျှင် သင့်ကိုလည်း ညှာတာတော်မူလိမ့်မည်မဟုတ်။
  </para>
  <para style="p">
    <verse number="22" style="v" />ထို့ကြောင့် ဘုရားသခင်၏ပြင်းထန်သောစီရင်တော်မူခြင်းနှင့်ကျေးဇူးပြုတော်မူခြင်းတို့ကို ကြည့်ကြလော့။ ပြင်းထန်သောစီရင်တော်မူခြင်းသည် လဲကျသောသူတို့ပေါ်၌ရှိ၍ ဘုရားသခင်၏ကျေးဇူးပြုတော်မူခြင်းမူကား သင်သည် ထိုကျေးဇူးပြုတော်မူခြင်း၌ ဆက်၍တည်နေလျှင် သင့်အပေါ်၌ရှိ၏။ ဆက်၍မတည်လျှင် သင်သည်လည်း ခုတ်ဖြတ်ခြင်းခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သူတို့သည်လည်း မယုံကြည်မှုကိုစွန့်ပယ်လျှင် ကိုင်းဆက်ကူးခြင်းခံရကြလိမ့်မည်။ အကြောင်းမူကား သူတို့ကို နောက်တစ်ဖန်ကိုင်းဆက်ကူးရန် ဘုရားသခင်တတ်နိုင်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />အဘယ်ကြောင့်ဆိုသော် သင်သည် သဘာဝအတိုင်း ရိုင်းသည့်သံလွင်ပင်မှ ခုတ်ဖြတ်ခံရ၍ ကောင်းသည့်သံလွင်ပင်၌ သဘာဝနှင့်ဆန့်ကျင်လျက် ကိုင်းဆက်ကူးခြင်းခံရသည်မှန်လျှင် သဘာဝအတိုင်း ကောင်းသည့်သံလွင်ပင်၏အကိုင်းများကိုမူကား မူရင်းသံလွင်ပင်၌ မည်မျှပို၍လွယ်ကူစွာ ကိုင်းဆက်ကူးနိုင်လိမ့်မည်နည်း။
  </para>
  <para style="p">
    <verse number="25" style="v" />ညီအစ်ကိုတို့၊ သင်တို့သည် မိမိတို့ကိုယ်ကိုပညာသတိရှိသောသူဟူ၍မထင်မှတ်ကြစေရန် ဤလျှို့ဝှက်နက်နဲသောအရာကို မသိဘဲမနေစေလိုပါ။ လျှို့ဝှက်နက်နဲသောအရာဟူမူကား အစ္စရေးလူမျိုး၌ မာကျောခက်ထန်သူအချို့ရှိခြင်းမှာ လူမျိုးခြားတို့စုံလင်စွာဝင်ရောက်သည်အထိဖြစ်ပြီး
  </para>
  <para style="p">
    <verse number="26" style="v" />ဤသို့ဖြင့် အစ္စရေးလူမျိုးတစ်မျိုးလုံးသည် ကယ်တင်ခြင်းခံရမည်ဟူ၍ဖြစ်၏။ “ကယ်နုတ်သောအရှင်သည် ဇိအုန်မှကြွလာပြီး ယာကုပ်၏အမျိုးအနွယ်ထဲမှ ဘုရားတရားမဲ့ခြင်းများကို ဖယ်ရှားတော်မူလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဤသည်ကား သူတို့၏အပြစ်များကို ငါဖယ်ရှားသောအခါ သူတို့အား ငါပေးမည့်ပဋိညာဉ်ပေတည်း” ဟု ကျမ်းစာ၌ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ကောင်းမြတ်သောသတင်းအရ သူတို့သည် သင်တို့အတွက်ကြောင့် ရန်သူများဖြစ်ကြသော်လည်း ရွေးကောက်တော်မူခြင်းအရ ရှေးဘိုးဘေးများအတွက်ကြောင့် ချစ်တော်မူသောသူများဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="29" style="v" />အကြောင်းမူကား ဘုရားသခင်၏ဆုကျေးဇူးများနှင့်ခေါ်ယူတော်မူခြင်းသည် ပြောင်းလဲခြင်းမရှိ။
  </para>
  <para style="p">
    <verse number="30" style="v" />သင်တို့သည် တစ်ချိန်က ဘုရားသခင်ကိုမနာခံခဲ့ကြသော်လည်း ယခုအခါ ထိုသူတို့၏မနာခံမှုကြောင့် ကရုဏာတော်ကိုခံစားရကြသကဲ့သို့
  </para>
  <para style="p">
    <verse number="31" style="v" />သူတို့သည်လည်း ထိုနည်းတူ ယခုနာခံခြင်းမရှိကြပေ။ ဤသည်ကား သင်တို့ခံရသောကရုဏာတော်အားဖြင့် ယခုအခါ သူတို့သည်လည်း ကရုဏာတော်ကိုခံစားရကြစေရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="32" style="v" />ဘုရားသခင်သည် လူအပေါင်းတို့အပေါ်ကရုဏာထားတော်မူရန် လူအပေါင်းတို့ကို မနာခံမှုအဖြစ်၌ချုပ်ထားတော်မူ၏။
  </para>
  <para style="p">
    <verse number="33" style="v" />ဘုရားသခင်၏အသိပညာနှင့်ဉာဏ်ပညာတော်တို့၏ကြွယ်ဝမှုသည် နက်နဲလှပါတကား။ စီရင်တော်မူချက်တို့ကို စူးစမ်းလေ့လာ၍မကုန်နိုင်။ လမ်းတော်တို့ကိုလည်း ချင့်မျှော်တွေးဆ၍မရနိုင်။
  </para>
  <para style="p">
    <verse number="34" style="v" />“မည်သူသည် ထာဝရဘုရား၏စိတ်တော်ကိုသိသနည်း။ မည်သူသည် ကိုယ်တော်၏အတိုင်ပင်ခံဖြစ်ဖူးသနည်း။
  </para>
  <para style="p">
    <verse number="35" style="v" />မိမိအပေါ် ကိုယ်တော်ကျေးဇူးတုံ့ပြန်ရလေအောင် မည်သူသည် ကိုယ်တော်အား ဦးစွာကျေးဇူးပြုဖူးသနည်း။”
  </para>
  <para style="p">
    <verse number="36" style="v" />အကြောင်းမူကား အရာခပ်သိမ်းတို့သည် ကိုယ်တော်ထံမှလည်းကောင်း၊ ကိုယ်တော်အားဖြင့်လည်းကောင်း၊ ကိုယ်တော်အတွက်လည်းကောင်း ဖြစ်တည်ကြ၏။ ကိုယ်တော်ရှင်၌ ကာလအစဉ်အဆက် ဘုန်းအသရေတော်တည်ရှိပါစေသော။ အာမင်။
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />သို့ဖြစ်၍ ညီအစ်ကိုတို့၊ ဘုရားသခင်၏ကရုဏာတော်အားဖြင့် သင်တို့အား ငါတိုက်တွန်းနှိုးဆော်လိုသည်မှာ သင်တို့၏ကိုယ်ခန္ဓာကို ဘုရားသခင်နှစ်သက်တော်မူသည့် သန့်ရှင်း၍အသက်ရှင်သောယဇ်အဖြစ် ပူဇော်ကြလော့။ ဤသည်ကား သင်တို့ပြုအပ်သော ဝိညာဉ်ရေးဆိုင်ရာဝတ်ပြုခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />သင်တို့သည် ဤလောက၏ပုံသဏ္ဌာန်ကို မဆောင်ကြနှင့်။ ကောင်းမြတ်သောအရာ၊ နှစ်သက်ဖွယ်သောအရာ၊ စုံလင်သောအရာတည်းဟူသော ဘုရားသခင်အလိုတော်ရှိသောအရာသည် မည်သည့်အရာဖြစ်သည်ကို ပိုင်းခြားသိရှိနိုင်ရန် စိတ်နှလုံးကို အသစ်ပြုပြင်ခြင်းဖြင့် ပုံသဏ္ဌာန်ပြောင်းလဲခြင်းရှိကြလော့။
  </para>
  <para style="p">
    <verse number="3" style="v" />ငါ့အားပေးအပ်တော်မူသော ကျေးဇူးတော်အားဖြင့် သင်တို့ထဲတွင်ရှိသောသူအားလုံးကို ငါမှာကြားလိုသည်မှာ သင်တို့သည် မိမိကိုယ်ကို ထင်သင့်သည်ထက် ပို၍အထင်မကြီးကြဘဲ သင်တို့အသီးသီးအား ဘုရားသခင်ခွဲဝေပေးတော်မူသော ယုံကြည်ခြင်းအတိုင်းအတာနှင့်အညီ သင့်တင့်လျောက်ပတ်စွာ ထင်မြင်ကြလော့။
  </para>
  <para style="p">
    <verse number="4" style="v" />အကြောင်းမူကား ကိုယ်ခန္ဓာတစ်ခု၌ အင်္ဂါအစိတ်အပိုင်းများစွာရှိ၍ ထိုအင်္ဂါအစိတ်အပိုင်းအားလုံးသည် တူညီသောလုပ်ဆောင်မှုကို လုပ်ဆောင်ကြသည်မဟုတ်သကဲ့သို့
  </para>
  <para style="p">
    <verse number="5" style="v" />အရေအတွက်များသောငါတို့သည်လည်း ခရစ်တော်၌ ကိုယ်ခန္ဓာတစ်ခုတည်းဖြစ်ကြပြီး အသီးသီးသည် အင်္ဂါအစိတ်အပိုင်းအချင်းချင်းဖြစ်ကြကာ
  </para>
  <para style="p">
    <verse number="6" style="v" />ငါတို့၌ပေးအပ်တော်မူသော ကျေးဇူးတော်အတိုင်း အထူးထူးအပြားပြားသောဆုကျေးဇူးများကို ရရှိကြ၏။ သို့ဖြစ်၍ ထိုဆုကျေးဇူးသည် ပရောဖက်ပြုဟောပြောခြင်းဖြစ်လျှင် ယုံကြည်ခြင်း၏ပမာဏအတိုင်း ပရောဖက်ပြုဟောပြောစေ။
  </para>
  <para style="p">
    <verse number="7" style="v" />အမှုတော်ဆောင်ဖြစ်လျှင် အမှုတော်ကိုဆောင်ရွက်စေ။ သွန်သင်သောသူဖြစ်လျှင် သွန်သင်ခြင်းကိုပြုစေ။
  </para>
  <para style="p">
    <verse number="8" style="v" />တိုက်တွန်းနှိုးဆော်သူဖြစ်လျှင် တိုက်တွန်းနှိုးဆော်ခြင်းကိုပြုစေ။ ပေးကမ်းဝေမျှသောသူသည် ရက်ရောစွာပေးကမ်းဝေမျှစေ။ စီမံအုပ်ချုပ်သောသူသည် လုံ့လဝီရိယဖြင့်စီမံအုပ်ချုပ်စေ။ မစသနားခြင်းအမှုကိုပြုသောသူသည် ကြည်ဖြူသောစိတ်နှင့်ပြုစေ။
  </para>
  <para style="p">
    <verse number="9" style="v" />ချစ်ခြင်းမေတ္တာသည် ဟန်ဆောင်မှုနှင့်ကင်းရမည်။ မကောင်းသောအရာကိုရွံမုန်း၍ ကောင်းသောအရာကိုတွယ်တာကြလော့။
  </para>
  <para style="p">
    <verse number="10" style="v" />ညီအစ်ကိုချင်းချစ်သောမေတ္တာအားဖြင့် အချင်းချင်းချစ်ခင်ကြင်နာကြ၍ ရိုသေသမှုပြုခြင်း၌ သူတစ်ပါးသည် မိမိထက်သာလွန်သည်ဟု မှတ်ယူကြလော့။
  </para>
  <para style="p">
    <verse number="11" style="v" />လုံ့လဝီရိယစိုက်ထုတ်ရာတွင် ပျင်းရိခြင်းမရှိဘဲ ဝိညာဉ်ရေး၌ထက်သန်လျက် သခင်ဘုရားကိုအစေခံကြလော့။
  </para>
  <para style="p">
    <verse number="12" style="v" />မျှော်လင့်ခြင်း၌ဝမ်းမြောက်လျက် ဆင်းရဲဒုက္ခကိုသည်းခံကာ ဆုတောင်းခြင်းအမှုကို အစဉ်တစိုက်ပြုကြလော့။
  </para>
  <para style="p">
    <verse number="13" style="v" />သန့်ရှင်းသူတို့၏လိုအပ်ချက်များကို ပါဝင်ဖြည့်ဆည်းလျက် ဧည့်ဝတ်ကို ကြိုးစားပြုကြလော့။
  </para>
  <para style="p">
    <verse number="14" style="v" />သင်တို့အားညှဉ်းဆဲသောသူတို့ကို ကောင်းချီးပေးကြလော့။ ကောင်းချီးကိုသာပေး၍ ကျိန်ဆဲခြင်းကိုမပြုကြနှင့်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဝမ်းမြောက်သောသူတို့နှင့်အတူဝမ်းမြောက်၍ ငိုကြွေးသောသူတို့နှင့်အတူငိုကြွေးကြလော့။
  </para>
  <para style="p">
    <verse number="16" style="v" />အချင်းချင်းတစ်စိတ်တစ်သဘောတည်းရှိကြလော့။ ထောင်လွှားသောသဘောမရှိဘဲ အခြေအနေနိမ့်ပါးသောသူတို့နှင့် ပေါင်းသင်းဆက်ဆံကြလော့။ မိမိတို့ကိုယ်ကိုပညာသတိရှိသောသူဟူ၍ မထင်မှတ်ကြနှင့်။
  </para>
  <para style="p">
    <verse number="17" style="v" />မည်သူ့ကိုမျှ အဆိုးကို အဆိုးဖြင့် မတုံ့ပြန်ကြနှင့်။ လူအပေါင်းတို့ရှေ့၌ တင့်တယ်လျောက်ပတ်သောအမှုကို ပြုမူကျင့်ကြံကြလော့။
  </para>
  <para style="p">
    <verse number="18" style="v" />သင်တို့ဘက်မှ တတ်နိုင်သမျှ လူအပေါင်းတို့နှင့် သင့်မြတ်စွာနေကြလော့။
  </para>
  <para style="p">
    <verse number="19" style="v" />ချစ်ရသောသူတို့၊ ကိုယ်တိုင်လက်တုံ့မပြန်ဘဲ အမျက်တော်လက်သို့ အပ်နှံထားကြလော့။ အကြောင်းမူကား “ထာဝရဘုရားမိန့်တော်မူသည်မှာ လက်တုံ့ပြန်ခြင်းသည် ငါနှင့်ဆိုင်၏။ ငါကိုယ်တိုင်တုံ့ပြန်မည်” ဟု ကျမ်းစာ၌ရေးထား၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ထို့ကြောင့် လက်တုံ့မပြန်ဘဲ “သင့်ရန်သူဆာလောင်လျှင် ကျွေးမွေးလော့။ ရေငတ်လျှင် သောက်စရာပေးလော့။ ထိုသို့ပြုခြင်းအားဖြင့် သင်သည် သူ၏ခေါင်းပေါ်၌ မီးခဲကိုပုံထားလိမ့်မည်။”
  </para>
  <para style="p">
    <verse number="21" style="v" />အဆိုး၏အနိုင်ယူခြင်းကိုမခံဘဲ အကောင်းအားဖြင့် အဆိုးကိုအနိုင်ယူလော့။
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />အထက်အာဏာပိုင်များကို လူတိုင်းနာခံစေ။ အကြောင်းမူကား ဘုရားသခင်ထံမှမဟုတ်သောအာဏာဟူ၍မရှိ။ တည်လျက်ရှိသောအာဏာများသည် ဘုရားသခင်ခန့်အပ်တော်မူရာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ထို့ကြောင့် အာဏာပိုင်ကိုဆန့်ကျင်သောသူသည် ဘုရားသခင်၏ပြဋ္ဌာန်းတော်မူချက်ကို ဆန့်ကျင်ရာရောက်၏။ ထိုသို့ဆန့်ကျင်သောသူတို့သည် ပြစ်ဒဏ်စီရင်ခြင်းကို ကိုယ်တိုင်ခံရကြလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />အဘယ်ကြောင့်ဆိုသော် အုပ်ချုပ်သူများသည် ကောင်းသောအမှုကိုပြုသောသူအတွက် ကြောက်စရာမဟုတ်ဘဲ မကောင်းသောအမှုကိုပြုသောသူအတွက်သာ ကြောက်စရာဖြစ်၏။ သင်သည် အာဏာပိုင်ကိုမကြောက်ဘဲနေလိုလျှင် ကောင်းသောအမှုကိုပြုလော့။ ထိုသို့ပြုလျှင် သူ၏ချီးမွမ်းခြင်းကိုခံရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="4" style="v" />အကြောင်းမူကား သူသည် သင့်အား ကောင်းကျိုးပြုသော ဘုရားသခင်၏အစေခံဖြစ်၏။ သို့ရာတွင် မကောင်းသောအမှုကိုသင်ပြုလျှင် ကြောက်ရွံ့ခြင်းရှိလော့။ သူသည် ဓားကို အကြောင်းမဲ့ဆောင်ထားသည်မဟုတ်။ သူသည် မကောင်းသောအမှုကိုပြုကျင့်သောသူအား အမျက်တော်အတွက် အပြစ်ဒဏ်ပေးသည့် ဘုရားသခင်၏အစေခံဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />သို့ဖြစ်၍ အမျက်တော်ကြောင့်သာမဟုတ်ဘဲ အသိစိတ်အတွက်ကြောင့်လည်း နာခံရမည်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဤအကြောင်းကြောင့် အခွန်များကိုလည်း သင်တို့ပေးဆောင်ကြ၏။ အကြောင်းမူကား သူတို့သည် ဘုရားသခင်၏အမှုကိုထမ်းဆောင်သူများဖြစ်ကြပြီး ထိုအမှုကို အစဉ်တစိုက်ဆောင်ရွက်နေကြ၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />သို့ဖြစ်၍ လူအသီးသီးတို့အား ပေးသင့်သည်ကို ပေးဆောင်ကြလော့။ အခွန်ပေးသင့်သောသူအား အခွန်ကိုလည်းကောင်း၊ အကောက်ပေးသင့်သောသူအား အကောက်ကိုလည်းကောင်း ပေးဆောင်ကြလော့။ ကြောက်ရွံ့သင့်သောသူကိုကြောက်ရွံ့၍ ရိုသေသင့်သောသူကိုရိုသေကြလော့။
  </para>
  <para style="p">
    <verse number="8" style="v" />အချင်းချင်းချစ်ခြင်းမှတစ်ပါး မည်သည့်အကြွေးမျှ မတင်စေကြနှင့်။ သူတစ်ပါးကိုချစ်သောသူသည် ပညတ်တရားကိုပြည့်စုံစေပြီ။
  </para>
  <para style="p">
    <verse number="9" style="v" />အကြောင်းမူကား “အိမ်ထောင်ရေးဖောက်ပြန်မှုကို မကျူးလွန်ရ၊ လူမသတ်ရ၊ မခိုးယူရ၊ တပ်မက်သောစိတ်မရှိရ” ဟူသောပညတ်ချက်များမှစ၍ အခြားမည်သည့်ပညတ်ချက်မဆို “ကိုယ့်ဝန်းကျင်၌ရှိသောသူကို ကိုယ်နှင့်အမျှချစ်ရမည်”ဟူသော ဤမိန့်တော်မူချက်၌ ပေါင်းခြုံထား၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />ချစ်ခြင်းမေတ္တာသည် ကိုယ့်ဝန်းကျင်၌ရှိသောသူအပေါ် မကောင်းသောအမှုကိုမပြုတတ်။ ထို့ကြောင့် ချစ်ခြင်းမေတ္တာသည် ပညတ်တရား၏ပြည့်စုံရာဖြစ်၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />သင်တို့သည် အချိန်အခါကိုသိကြ၏။ သင်တို့အိပ်ပျော်ရာမှ နိုးထရမည့်အချိန်နာရီရောက်လေပြီ။ အဘယ်ကြောင့်ဆိုသော် ယခုအခါ ငါတို့၏ကယ်တင်ခြင်းသည် ငါတို့စတင်ယုံကြည်ချိန်ကထက် ပို၍နီးကပ်လာပြီဖြစ်၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />ညအချိန်ကုန်လု၍ နေ့အချိန်ရောက်တော့မည်။ ထို့ကြောင့် ငါတို့သည် မှောင်မိုက်ခြင်း၏အကျင့်များကို ဖယ်ရှားလျက် အလင်း၏လက်နက်များကို ဆောင်ယူဝတ်ဆင်ကြကုန်စို့။
  </para>
  <para style="p">
    <verse number="13" style="v" />အပျော်ကြူးခြင်းနှင့်သောက်စားမူးယစ်ခြင်းတို့၌လည်းကောင်း၊ ကိလေသာရှုပ်ထွေးခြင်းနှင့်ကာမဂုဏ်လိုက်စားခြင်းတို့၌လည်းကောင်း၊ ပဋိပက္ခဖြစ်ခြင်းနှင့်မနာလိုခြင်းတို့၌လည်းကောင်း မကျင်လည်ကြဘဲ နေ့အချိန်၌လျှောက်လှမ်းသကဲ့သို့ တင့်တယ်လျောက်ပတ်စွာ အသက်ရှင်လျှောက်လှမ်းကြကုန်စို့။
  </para>
  <para style="p">
    <verse number="14" style="v" />သခင်ယေရှုခရစ်တော်ကို ဝတ်ဆင်ကြလော့။ သွေးသားဇာတိ၏တပ်မက်ခြင်းကိုဖြည့်ဆည်းရန် မကြံစည်ကြနှင့်။
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />ယုံကြည်ခြင်းအားနည်းသောသူကို လက်ခံကြလော့။ သူ၏တွေးတောကြံစည်မှုများကို မဝေဖန်ကြနှင့်။
  </para>
  <para style="p">
    <verse number="2" style="v" />အချို့သောသူသည် အစားအစာအားလုံးကိုစား၍ရသည်ဟု ယုံကြည်၏။ အားနည်းသောသူမူကား ဟင်းသီးဟင်းရွက်ကိုသာစား၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />စားသောသူသည် မစားသောသူကိုမထီမဲ့မြင်မပြုနှင့်။ မစားသောသူသည်လည်း စားသောသူကို မစီရင်နှင့်။ အကြောင်းမူကား ဘုရားသခင်သည် သူ့ကိုလက်ခံတော်မူပြီ။
  </para>
  <para style="p">
    <verse number="4" style="v" />သင်သည် မည်သူဖြစ်၍ သူတစ်ပါး၏အစေခံကို စီရင်သနည်း။ ထိုသူရပ်သည်ဖြစ်စေ၊ လဲသည်ဖြစ်စေ သူ့သခင်နှင့်ဆိုင်၏။ သို့ရာတွင် သူသည်ရပ်လိမ့်မည်။ အကြောင်းမူကား သခင်ဘုရားသည် သူ့ကိုရပ်စေနိုင်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />အချို့သောသူသည် နေ့ရက်တစ်ရက်ကို အခြားနေ့ရက်ထက် ပို၍မြတ်သည်ဟုယူဆ၏။ အချို့မူကား နေ့ရက်အားလုံးအတူတူဖြစ်သည်ဟုယူဆ၏။ လူတိုင်း မိမိတို့ယူဆထားသောအရာအပေါ် စိတ်နှလုံးထဲ၌ အပြည့်အဝယုံကြည်ပါစေ။
  </para>
  <para style="p">
    <verse number="6" style="v" />နေ့ရက်ကိုစောင့်ထိန်းသောသူသည် သခင်ဘုရားအတွက်စောင့်ထိန်း၏။ စားသောသူသည်လည်း သခင်ဘုရားအတွက်စား၏။ အကြောင်းမူကား သူသည် ဘုရားသခင်ကိုကျေးဇူးတင်၏။ မစားသောသူသည်လည်း သခင်ဘုရားအတွက်မစားဘဲနေ၍ ဘုရားသခင်ကိုကျေးဇူးတင်၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ငါတို့တွင် ကိုယ့်အတွက်အသက်ရှင်သောသူ တစ်ယောက်မျှမရှိ။ ကိုယ့်အတွက်သေသောသူလည်း တစ်ယောက်မျှမရှိ။
  </para>
  <para style="p">
    <verse number="8" style="v" />အကြောင်းမူကား ငါတို့သည် အသက်ရှင်လျှင် သခင်ဘုရားအတွက်အသက်ရှင်၍ သေလျှင် သခင်ဘုရားအတွက်သေ၏။ ထို့ကြောင့် ငါတို့သည် အသက်ရှင်သည်ဖြစ်စေ၊ သေသည်ဖြစ်စေ သခင်ဘုရားပိုင်ဆိုင်တော်မူရာဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="9" style="v" />အဘယ်ကြောင့်ဆိုသော် ခရစ်တော်သည် သေလွန်သောသူတို့နှင့်အသက်ရှင်သောသူတို့၏အရှင်သခင်ဖြစ်ရန်အတွက် အသေခံတော်မူပြီးနောက် အသက်ပြန်ရှင်တော်မူ၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />သို့ဖြစ်လျှင် သင်သည် အဘယ်ကြောင့် သင့်ညီအစ်ကိုကို စီရင်သနည်း။ အဘယ်ကြောင့် သင့်ညီအစ်ကိုကို မထီမဲ့မြင်ပြုသနည်း။ ငါတို့အားလုံးသည် ဘုရားသခင်၏တရားပလ္လင်တော်ရှေ့၌ ရပ်ကြရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="11" style="v" />အကြောင်းမူကား “ထာဝရဘုရားမိန့်တော်မူသည်မှာ ငါသည် အသက်ရှင်သည်ဖြစ်၍ လူတိုင်း ငါ့ရှေ့၌ ဒူးထောက်လိမ့်မည်။ လူတိုင်း၏နှုတ်သည်လည်း ဘုရားသခင်ကိုချီးမွမ်းလိမ့်မည်” ဟု ကျမ်းစာ၌ရေးထား၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />သို့ဖြစ်၍ ငါတို့တစ်ဦးစီသည် ဘုရားသခင်ရှေ့တော်၌ မိမိအကြောင်းကို မိမိဖြေရှင်းရလိမ့်မည်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ထို့ကြောင့် ငါတို့သည် နောက်ထပ် အချင်းချင်းမစီရင်ဘဲနေကြကုန်စို့။ ထိုမျှမက ညီအစ်ကိုအတွက် ခလုတ်တံသင်း၊ သို့မဟုတ် မှားယွင်းစေသောအရာကိုမထားရန် စီရင်ကြလော့။
  </para>
  <para style="p">
    <verse number="14" style="v" />ပကတိအလျောက် မစင်ကြယ်သောအရာတစ်စုံတစ်ခုမျှမရှိဟု သခင်ယေရှု၌ ငါအမှန်သိလျက် ယုံကြည်စိတ်ချ၏။ သို့သော် တစ်စုံတစ်ရာကိုမစင်ကြယ်ဟု မှတ်ယူသောသူအတွက် ထိုအရာသည်မစင်ကြယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />အစားအစာကြောင့် သင်၏ညီအစ်ကိုကို ဝမ်းနည်းစေလျှင် သင်သည် မေတ္တာဖြင့် အသက်ရှင်လျှောက်လှမ်းသည်မဟုတ်တော့ပေ။ ခရစ်တော်က ကိုယ်စားအသေခံပေးတော်မူသော သင့်ညီအစ်ကိုကို သင်၏အစားအစာကြောင့် မပျက်စီးစေနှင့်။
  </para>
  <para style="p">
    <verse number="16" style="v" />သင်တို့အတွက်ကောင်းသောအရာကိုလည်း ပြစ်တင်ပြောဆိုစရာမဖြစ်စေကြနှင့်။
  </para>
  <para style="p">
    <verse number="17" style="v" />အကြောင်းမူကား ဘုရားသခင်၏နိုင်ငံတော်သည် စားခြင်း၊ သောက်ခြင်းမဟုတ်ဘဲ သန့်ရှင်းသောဝိညာဉ်တော်အားဖြင့်ခံစားရသော ငြိမ်သက်ခြင်း၊ ဖြောင့်မတ်ခြင်းနှင့် ဝမ်းမြောက်ခြင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />ထို့ကြောင့် ဤနည်းဖြင့် ခရစ်တော်ကိုအစေခံသောသူသည် ဘုရားသခင်ရှေ့တော်၌ နှစ်သက်ဖွယ်ဖြစ်ပြီး လူတို့ရှေ့၌ ယုံကြည်စိတ်ချရသူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />သို့ဖြစ်၍ ငြိမ်သက်ခြင်းကိုဖြစ်စေသောအမှုအရာများနှင့် အချင်းချင်းတည်ဆောက်မြှင့်တင်ပေးသောအမှုအရာများကို ကြိုးစားပြုကြကုန်စို့။
  </para>
  <para style="p">
    <verse number="20" style="v" />အစားအစာကြောင့် ဘုရားသခင်၏အမှုတော်ကို မဖျက်ဆီးနှင့်။ အမှန်စင်စစ် အရာခပ်သိမ်းတို့သည် စင်ကြယ်၏။ သို့သော် တစ်စုံတစ်ဦး၏စားသုံးခြင်းသည် သူတစ်ပါးအတွက်ခလုတ်တံသင်းဖြစ်လျှင် ထိုအမှုအရာသည် အပြစ်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />အသားကိုမစား၊ စပျစ်ဝိုင်ကိုမသောက်၊ သင့်ညီအစ်ကိုအား ခလုတ်တိုက်စေသောအရာကိုလည်း မပြုဘဲနေလျှင် ကောင်း၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />သင်သည် မိမိ၌ရှိသောယုံကြည်ခြင်းကို ဘုရားသခင်၏ရှေ့တော်၌သာရှိစေလော့။ မှန်သည်ဟုလက်ခံထားသောအမှုအရာ၌ မိမိ၏ဩတ္တပ္ပစိတ်ကြည်လင်သောသူသည် မင်္ဂလာရှိ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />သို့သော် သံသယရှိသောစိတ်နှင့်စားလျှင် ယုံကြည်ခြင်းအားဖြင့်မဟုတ်သောကြောင့် ပြစ်ဒဏ်စီရင်ခြင်းကိုခံရ၏။ ယုံကြည်ခြင်းအားဖြင့်မဟုတ်သော အမှုအရာအားလုံးသည် အပြစ်ဖြစ်၏။
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />သို့ဖြစ်၍ ခွန်အားရှိသောငါတို့သည် မိမိတို့နှစ်သက်သည့်အတိုင်းမပြုဘဲ အားနည်းသောသူတို့၏အားနည်းချက်တို့ကို ထောက်မပေးသင့်၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />ငါတို့အသီးသီးသည် မိမိဝန်းကျင်၌ရှိသောသူကိုတည်ဆောက်မြှင့်တင်ပေးရန် သူ၏ကောင်းကျိုးကိုထောက်၍ သူ့ကိုနှစ်သက်စေရမည်။
  </para>
  <para style="p">
    <verse number="3" style="v" />အဘယ်ကြောင့်ဆိုသော် “ကိုယ်တော်ကိုကဲ့ရဲ့ပြစ်တင်သောသူတို့၏ကဲ့ရဲ့ပြစ်တင်သောစကားသည် အကျွန်ုပ်အပေါ်သို့ ကျရောက်ပါ၏” ဟု ကျမ်းစာ၌ရေးထားသည်နှင့်အညီ ခရစ်တော်ပင်လျှင် မိမိနှစ်သက်သည့်အတိုင်းပြုတော်မမူခဲ့ပေ။
  </para>
  <para style="p">
    <verse number="4" style="v" />အကြောင်းမူကား ရှေးအခါကရေးထားသမျှသောအရာသည် ငါတို့ကိုသွန်သင်ရန်ရေးထားခြင်းဖြစ်ပြီး ကျမ်းစာ၌ပါသော သည်းခံခြင်းနှင့် နှစ်သိမ့်ခြင်းအားဖြင့် ငါတို့၌ မျှော်လင့်ခြင်းရှိစေရန်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />သင်တို့သည် ငါတို့သခင်ယေရှုခရစ်တော်၏ခမည်းတော်တည်းဟူသော ဘုရားသခင်၏ဘုန်းတော်ကို တစ်သံတည်းဖြင့် တညီတညွတ်တည်းချီးမွမ်းနိုင်ရန် သည်းခံခြင်းနှင့်နှစ်သိမ့်ခြင်းတို့၏အရှင်ဘုရားသခင်သည် သင်တို့အား ခရစ်တော်ယေရှု၏အလိုတော်အတိုင်း အချင်းချင်းတစ်စိတ်တစ်သဘောတည်းရှိနိုင်သောအခွင့်ကို ပေးတော်မူပါစေသော။
  </para>
  <para style="p">
    <verse number="7" style="v" />ခရစ်တော်သည် ဘုရားသခင်၏ဘုန်းအသရေတော်အတွက် သင်တို့ကိုလက်ခံသကဲ့သို့ သင်တို့သည်လည်း တစ်ဦးကိုတစ်ဦးလက်ခံကြလော့။
  </para>
  <para style="p">
    <verse number="8" style="v" />တစ်ဖန် ငါဆိုသည်ကား ခရစ်တော်သည် ဘုရားသခင်၏သမ္မာတရားကိုထင်ရှားစေရန် အရေဖျားလှီးထားသောသူတို့၏အစေခံဖြစ်တော်မူ၏။ ထိုသို့ဖြစ်တော်မူခြင်းမှာ ရှေးဘိုးဘေးတို့အား ပေးထားသောကတိတော်တို့ကို တည်မြဲစေရန်နှင့်
  </para>
  <para style="p">
    <verse number="9" style="v" />လူမျိုးခြားတို့သည်လည်း ကရုဏာတော်ကြောင့် ဘုရားသခင်၏ဘုန်းတော်ကိုချီးမွမ်းကြရန်ဖြစ်၏။ ဤသည်ကား ကျမ်းစာ၌ “ထို့ကြောင့် အကျွန်ုပ်သည် လူမျိုးခြားတို့အထဲတွင် ကိုယ်တော်ကိုထောမနာပြု၍ ကိုယ်တော်၏နာမတော်ကို ချီးမွမ်းသီဆိုပါမည်” ဟု ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="10" style="v" />တစ်ဖန် “လူမျိုးခြားတို့၊ ဘုရားသခင်၏လူမျိုးတော်နှင့်အတူ ဝမ်းမြောက်ကြလော့” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />ထို့နောက် တစ်ဖန် “လူမျိုးခြားအပေါင်းတို့၊ ထာဝရဘုရားကိုချီးမွမ်းကြလော့။ လူမျိုးအပေါင်းတို့၊ ကိုယ်တော်ကိုချီးမွမ်းကြလော့” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />တစ်ဖန် ဟေရှာယကလည်း “ယေရှဲ၏အမြစ်ပေါက်လိမ့်မည်။ ထိုသူသည် လူမျိုးခြားတို့ကိုအုပ်ချုပ်ရန် ပေါ်ထွန်းသောသူဖြစ်၏။ လူမျိုးခြားတို့သည် သူ့ကိုမျှော်လင့်အားထားကြလိမ့်မည်” ဟု ဆိုထား၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />သင်တို့သည် သန့်ရှင်းသောဝိညာဉ်တော်၏တန်ခိုးအားဖြင့် မျှော်လင့်ခြင်းနှင့်ကြွယ်ဝမည့်အကြောင်း မျှော်လင့်ခြင်း၏အရှင်ဘုရားသခင်သည် ယုံကြည်ခြင်းမှလာသော ဝမ်းမြောက်ခြင်းနှင့်ငြိမ်သက်ခြင်းအလုံးစုံတို့ဖြင့် သင်တို့ကိုပြည့်စုံစေတော်မူပါစေသော။
  </para>
  <para style="p">
    <verse number="14" style="v" />ငါ့ညီအစ်ကိုတို့၊ သင်တို့ကိုယ်တိုင် ကောင်းမြတ်ခြင်းနှင့်ပြည့်ဝလျက် အသိပညာအမျိုးမျိုးနှင့်ပြည့်စုံကာ အချင်းချင်းကိုသတိပေးဆုံးမနိုင်ကြသည်ဟု သင်တို့နှင့်ပတ်သက်၍ ငါယုံကြည်စိတ်ချ၏။
  </para>
  <para style="p">
    <verse number="15" style="v" />သို့သော် လူမျိုးခြားတို့အတွက် ငါ့ကိုခရစ်တော်ယေရှု၏အမှုတော်ကိုထမ်းဆောင်သူဖြစ်စေ၍ ဘုရားသခင်၏ကောင်းမြတ်သောသတင်းနှင့်ဆိုင်သည့်ယဇ်ပုရောဟိတ်အမှုကိုဆောင်ရွက်စေပြီး ထိုလူမျိုးခြားတို့ကိုသန့်ရှင်းသောဝိညာဉ်တော်အားဖြင့် သန့်ရှင်းစေခြင်းခံရသည့်နှစ်သက်လက်ခံဖွယ်ပူဇော်သက္ကာဖြစ်စေရန် ငါ့အား ဘုရားသခင်ပေးတော်မူသော ကျေးဇူးတော်အားဖြင့် သင်တို့ကို တစ်ဖန်သတိပေးရန် တချို့အပိုင်း၌ ငါရဲဝံ့စွာ ရေးခဲ့၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />သို့ဖြစ်၍ ငါသည် ဘုရားသခင်နှင့်စပ်ဆိုင်သောအရာတို့၌ ခရစ်တော်ယေရှုအားဖြင့် ဝါကြွားစရာအကြောင်းရှိ၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />အကြောင်းမူကား လူမျိုးခြားတို့နာခံမှုရှိစေရန် ခရစ်တော်သည် ငါ့ကိုအသုံးပြု၍ တရားစကားနှင့်လုပ်ဆောင်မှုအားဖြင့်လည်းကောင်း၊
  </para>
  <para style="p">
    <verse number="19" style="v" />နိမိတ်လက္ခဏာများနှင့်အံ့ဩဖွယ်ရာများ၏တန်ခိုးအားဖြင့်လည်းကောင်း၊ ဘုရားသခင်၏ဝိညာဉ်တော်တန်ခိုးအားဖြင့်လည်းကောင်း ပြုတော်မူသောအမှုအရာတို့မှအပ ငါသည် မည်သည့်အရာကိုမျှ အရဲစွန့်၍မပြောလိုပေ။ ဤသို့ဖြင့် ငါသည် ဂျေရုဆလင်မြို့မှစ၍ ဣလုရိတ်ပြည်တိုင်အောင် ပတ်သွားကာ ခရစ်တော်၏ကောင်းမြတ်သောသတင်းကို စုံလင်စွာဟောပြောခဲ့၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ထိုသို့ဟောပြောရာ၌ ငါသည် သူတစ်ပါး၏အုတ်မြစ်ပေါ်တွင် တည်ဆောက်ခြင်းမပြုမည့်အကြောင်း ခရစ်တော်၏အမည်နာမကို ကြားသိခြင်းမရှိသေးသောအရပ်၌ ကောင်းမြတ်သောသတင်းကိုဟောပြောရန် ရည်မှန်းကြိုးစားလာခဲ့၏။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဤသည်ကား “ကိုယ်တော်၏အကြောင်းကိုဖော်ပြခြင်းမခံရဖူးသောသူတို့သည် မြင်ကြ၍ မကြားဖူးသောသူတို့သည် နားလည်ကြလိမ့်မည်” ဟု ကျမ်းစာ၌ ရေးထားသည့်အတိုင်းဖြစ်၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဤအကြောင်းကြောင့် ငါသည် သင်တို့ထံသို့မလာရန် အဖန်ဖန်တားဆီးခြင်းကို ခံခဲ့ရသော်လည်း
  </para>
  <para style="p">
    <verse number="23" style="v" />ယခုအခါ ဤအရပ်တို့၌ ငါလုပ်ဆောင်ရမည့်နေရာမရှိတော့သည့်အပြင် သင်တို့ထံသို့လာရန် နှစ်ပေါင်းများစွာကပင် ဆန္ဒရှိခဲ့သည်နှင့်အညီ
  </para>
  <para style="p">
    <verse number="24" style="v" />စပိန်ပြည်သို့ ငါသွားသောအခါ သင်တို့ကို လမ်းကြုံဝင်တွေ့၍ အတော်အတန်အလိုဆန္ဒပြည့်စုံအောင် သင်တို့နှင့်အတူနေပြီးမှ သင်တို့၏ပို့ဆောင်ပေးခြင်းအားဖြင့် ထိုပြည်သို့သွားမည်ဟု ငါမျှော်လင့်ထား၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />သို့သော် ယခု ငါသည် သန့်ရှင်းသူများ၏အမှုကိုဆောင်ရွက်ရန် ဂျေရုဆလင်မြို့သို့ သွားရမည်။
  </para>
  <para style="p">
    <verse number="26" style="v" />အဘယ်ကြောင့်ဆိုသော် မာကေဒေါနိပြည်သားနှင့် အခါယပြည်သားတို့သည် ဂျေရုဆလင်မြို့၌ရှိသော သန့်ရှင်းသူများထဲမှ ဆင်းရဲသောသူတို့ကို ကူညီပံ့ပိုးပေးရန် စေတနာစိတ်ရှိကြ၏။
  </para>
  <para style="p">
    <verse number="27" style="v" />သူတို့သည် စေတနာစိတ်ရှိကြသည်မှန်သကဲ့သို့ ထိုသူတို့အပေါ် အကြွေးတင်သူများလည်းဖြစ်ကြ၏။ အကြောင်းမူကား လူမျိုးခြားတို့သည် ထိုသူတို့၏ဝိညာဉ်ရေးနှင့်ဆိုင်သောအရာများကို မျှဝေခံယူရကြသည်ဆိုလျှင် ရုပ်ဝတ္ထုနှင့်ဆိုင်သောအရာများအားဖြင့် သူတို့၏အမှုကို ဆောင်ရွက်ပေးသင့်၏။
  </para>
  <para style="p">
    <verse number="28" style="v" />ထို့ကြောင့် ငါသည် ဤအမှုကိစ္စကို ပြီးစီးအောင်ဆောင်ရွက်၍ ဤအလှူပစ္စည်းကို သူတို့အား သေချာစွာအပ်နှင်းပြီးမှ သင်တို့နေရာကိုဖြတ်လျက် စပိန်ပြည်သို့သွားမည်။
  </para>
  <para style="p">
    <verse number="29" style="v" />သင်တို့ထံသို့ ငါလာသောအခါ ခရစ်တော်၏ကောင်းချီးမင်္ဂလာအပြည့်အစုံနှင့်လာမည်ကို ငါသိ၏။
  </para>
  <para style="p">
    <verse number="30" style="v" />ညီအစ်ကိုတို့၊ ငါတို့၏သခင်ယေရှုခရစ်တော်နှင့် ဝိညာဉ်တော်၏ချစ်ခြင်းမေတ္တာအားဖြင့် သင်တို့အား ငါတောင်းပန်လိုသည်မှာ
  </para>
  <para style="p">
    <verse number="31" style="v" />ငါသည် ယုဒပြည်ရှိ မယုံကြည်သူတို့၏လက်မှ ကယ်နုတ်ခြင်းခံရပြီး ဂျေရုဆလင်မြို့အတွက် ငါဆောင်ရွက်သောအမှုသည် သန့်ရှင်းသူများရှေ့တွင် နှစ်သက်လက်ခံဖွယ်ဖြစ်သဖြင့်
  </para>
  <para style="p">
    <verse number="32" style="v" />ဘုရားသခင်၏အလိုတော်အားဖြင့် ဝမ်းမြောက်သောစိတ်နှင့် သင်တို့ထံသို့ငါလာ၍ သင်တို့နှင့်အတူ နှစ်သိမ့်သက်သာခြင်းကိုခံစားနိုင်မည့်အကြောင်း ငါနှင့်အတူကြိုးစားအားထုတ်၍ ငါ့အတွက် ဘုရားသခင်ထံဆုတောင်းကြလော့။
  </para>
  <para style="p">
    <verse number="33" style="v" />ငြိမ်သက်ခြင်း၏အရှင်ဘုရားသခင်သည် သင်တို့အားလုံးနှင့်အတူရှိပါစေသော။ အာမင်။
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />ကင်ခြေမြို့ရှိအသင်းတော်၏အမှုကိုဆောင်ရွက်သူဖြစ်သော ငါတို့၏နှမ ဖိဗေကို သင်တို့ထံ မိတ်ဆက်အပ်နှံလိုပါ၏။
  </para>
  <para style="p">
    <verse number="2" style="v" />သန့်ရှင်းသူများပြုသင့်သည့်အတိုင်း သခင်ဘုရား၌ သူ့ကိုလက်ခံ၍ သင်တို့ထံမှ သူလိုအပ်သမျှသောအရာကို ကူညီဆောင်ရွက်ပေးကြလော့။ အမှန်စင်စစ် သူသည် ငါကိုယ်တိုင်မှစ၍ များစွာသောသူတို့ကို ကူညီခဲ့သူဖြစ်၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ခရစ်တော်ယေရှု၌ ငါ၏လုပ်ဖော်ဆောင်ဖက်များဖြစ်ကြသည့် ပြစ်ကိလနှင့်အာကုလတို့ကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="4" style="v" />သူတို့သည် ငါ့အသက်ကို လည်စင်းခံ၍စောင့်ရှောက်ပေးသူများဖြစ်ကြ၏။ ငါတစ်ဦးတည်းသာမက လူမျိုးခြားတို့၏အသင်းတော်အပေါင်းတို့သည်လည်း သူတို့ကို ကျေးဇူးတင်လျက်ရှိကြ၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />သူတို့အိမ်၌ရှိသောအသင်းတော်ကိုလည်း နှုတ်ဆက်ပေးကြလော့။ အာရှပြည်တွင် ခရစ်တော်အတွက်အသီးဦးဖြစ်သူ ငါချစ်သောဧပဲနက်ကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="6" style="v" />သင်တို့အတွက် အလွန်ကြိုးစားလုပ်ဆောင်ခဲ့သူ မာရိကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="7" style="v" />ငါ၏အမျိုးသားချင်းဖြစ်ပြီး ငါနှင့်အတူအကျဉ်းချခံရသူ အန္ဒြောနိတ်နှင့်ယုနိတို့ကို နှုတ်ဆက်ပေးကြလော့။ သူတို့သည် တမန်တော်များကြားတွင် ထင်ပေါ်ကျော်ကြားသောသူများဖြစ်ကြ၍ ငါ့ထက်အလျင်ဦးစွာ ခရစ်တော်ကိုယုံကြည်သောသူများလည်း ဖြစ်ကြ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />သခင်ဘုရား၌ ငါချစ်သောအမ္ပလိကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="9" style="v" />ခရစ်တော်၌ ငါတို့၏လုပ်ဖော်ဆောင်ဖက်ဥရဗန်နှင့် ငါချစ်သောသတာခုတို့ကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="10" style="v" />ခရစ်တော်၌ ယုံကြည်စိတ်ချရသူ အပေလေကို နှုတ်ဆက်ပေးကြလော့။ အာရိတ္တောဗုလု၏အိမ်သူအိမ်သားတို့ကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="11" style="v" />ငါ၏အမျိုးသားချင်းဟေရောဒီအုံကို နှုတ်ဆက်ပေးကြလော့။ သခင်ဘုရား၌ရှိသော နာကိသု၏အိမ်သူအိမ်သားတို့ကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="12" style="v" />သခင်ဘုရား၌ကြိုးစားလုပ်ဆောင်နေသူ တရုဖဲနနှင့်တရုဖောသတို့ကို နှုတ်ဆက်ပေးကြလော့။ သခင်ဘုရား၌အလွန်ကြိုးစားလုပ်ဆောင်သူ ငါချစ်သောပေရသိကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="13" style="v" />သခင်ဘုရား၌ရွေးကောက်ခံရသောသူ ရုဖုနှင့် ငါ၏မိခင်လည်းဖြစ်သော သူ့မိခင်ကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="14" style="v" />အသုံကရိတ်၊ ဖလေကုန်၊ ဟေရမေ၊ ပတ်ရောဘ၊ ဟေရမမှစ၍ သူတို့နှင့်အတူရှိသော ညီအစ်ကိုများကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဖိလောလုပ်၊ ယုလိ၊ နေရု၊ နေရု၏နှမနှင့် ဩလုမ္ပမှစ၍ သူတို့နှင့်အတူရှိသော သန့်ရှင်းသူအပေါင်းတို့ကို နှုတ်ဆက်ပေးကြလော့။
  </para>
  <para style="p">
    <verse number="16" style="v" />အချင်းချင်းသန့်ရှင်းသောအနမ်းဖြင့် နှုတ်ဆက်ကြလော့။ ခရစ်တော်၏အသင်းတော်အပေါင်းတို့သည် သင်တို့ကိုနှုတ်ဆက်ကြ၏။
  </para>
  <para style="p">
    <verse number="17" style="v" />ညီအစ်ကိုတို့၊ သင်တို့ခံယူပြီးသောသွန်သင်ချက်ကိုဆန့်ကျင်၍ ကွဲပြားခြင်းနှင့်မှားယွင်းခြင်းတို့ကို ဖြစ်ပွားစေသောသူတို့ကိုသတိပြုလျက် ရှောင်ရှားကြရန်သင်တို့အား ငါတိုက်တွန်းနှိုးဆော်၏။
  </para>
  <para style="p">
    <verse number="18" style="v" />အကြောင်းမူကား ထိုသို့သောသူတို့သည် ငါတို့၏သခင်ခရစ်တော်ကို အစေမခံဘဲ မိမိတို့၏ဝမ်းဗိုက်ကိုသာ အစေခံ၍ ချိုသာသောစကားနှင့် မြှောက်ပင့်သောစကားတို့ဖြင့် ရိုးစင်းသောသူတို့၏စိတ်နှလုံးကို လှည့်ဖြားတတ်ကြ၏။
  </para>
  <para style="p">
    <verse number="19" style="v" />သင်တို့၏နာခံမှုသည် လူအပေါင်းတို့တွင် ကျော်စောသည်ဖြစ်၍ သင်တို့အတွက် ငါဝမ်းမြောက်၏။ သို့ရာတွင် သင်တို့သည် ကောင်းသောအမှု၌ ပညာရှိဖြစ်ကြပြီး မကောင်းသောအမှု၌ အပြစ်ကင်းစင်သောသူဖြစ်ကြရန် ငါအလိုရှိ၏။
  </para>
  <para style="p">
    <verse number="20" style="v" />ငြိမ်သက်ခြင်း၏အရှင်ဘုရားသခင်သည် မကြာမီအတွင်း စာတန်ကို သင်တို့၏ခြေအောက်၌ ကြေမွစေတော်မူလိမ့်မည်။ ငါတို့သခင်ယေရှု၏ကျေးဇူးတော်သည် သင်တို့နှင့်အတူရှိပါစေသော။
  </para>
  <para style="p">
    <verse number="21" style="v" />ငါ၏လုပ်ဖော်ဆောင်ဖက်တိမောသေ၊ ငါ့အမျိုးသားချင်း လုကိ၊ ယာသုန်နှင့် သောသိပါတရုတို့သည် သင်တို့ကိုနှုတ်ဆက်ကြ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဤစာကိုရေးပေးသူ အကျွန်ုပ်တေရတိသည် သခင်ဘုရား၌ သင်တို့ကိုနှုတ်ဆက်ပါ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ငါမှစ၍ အသင်းတော်တစ်ခုလုံးကိုလက်ခံသောအိမ်ရှင်ဂါယုသည် သင်တို့ကိုနှုတ်ဆက်၏။ မြို့တော်ဘဏ္ဍာထိန်းဧရတ္တုနှင့် ငါတို့၏ညီအစ်ကိုကွာတုတို့သည် သင်တို့ကိုနှုတ်ဆက်ကြ၏။
  </para>
  <para style="p">
    <verse number="24" style="v" />[ငါတို့သခင်ယေရှုခရစ်တော်၏ကျေးဇူးတော်သည် သင်တို့အားလုံးနှင့်အတူရှိပါစေသော။ အာမင်။]
  </para>
  <para style="p">
    <verse number="25" style="v" />ငါဟောပြောသည့်ကောင်းမြတ်သောသတင်းနှင့် ယေရှုခရစ်တော်အကြောင်းကိုဟောပြောခြင်းအားဖြင့်လည်းကောင်း၊ ရှေးကာလပတ်လုံး ဝှက်ထားခြင်းခံရသော်လည်း ယခုအခါ ထာဝရဘုရားသခင်၏အမိန့်တော်အတိုင်း ပရောဖက်ကျမ်းများ၌ထင်ရှားပြီး ယုံကြည်ခြင်းနှင့်ဆိုင်သောနာခံမှုရှိစေရန် လူမျိုးအပေါင်းတို့အားသိစေသည့် လျှို့ဝှက်နက်နဲသောအရာကို ဖွင့်ပြခြင်းအားဖြင့်လည်းကောင်း သင်တို့ကို ခိုင်ခံ့မြဲမြံစေနိုင်သောအရှင်၊
  </para>
  <para style="p">
    <verse number="27" style="v" />ပညာနှင့်ပြည့်စုံတော်မူသည့် တစ်ဆူတည်းသောဘုရားသခင်၌ ယေရှုခရစ်တော်အားဖြင့် ကာလအစဉ်အဆက် ဘုန်းအသရေတော်ရှိပါစေသော။ အာမင်။
  </para>
</usx>
