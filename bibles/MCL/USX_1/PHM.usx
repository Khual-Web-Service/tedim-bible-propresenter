<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PHM" style="id">ဖိလေမုန်ဩဝါဒစာ</book>
  <para style="h">ဖိလေမုန်ဩဝါဒစာ</para>
  <para style="toc1">ဖိလေမုန်ဩဝါဒစာ</para>
  <para style="toc2">ဖိလေမုန်ဩဝါဒစာ</para>
  <para style="mt">ဖိလေမုန်ဩဝါဒစာ</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />ခရစ်တော်ယေရှုနှင့်ဆိုင်သောအကျဉ်းသားငါပေါလုနှင့် ငါ့ညီတိမောသေတို့သည် ချစ်ရသောငါတို့၏လုပ်ဖော်ဆောင်ဖက် ဖိလေမုန်မှစ၍
  </para>
  <para style="p">
    <verse number="2" style="v" />ငါတို့နှမအပ္ပိ၊ ငါတို့၏ရဲဘော်ရဲဘက်အာခိပ္ပုနှင့် သင်၏အိမ်၌စုဝေးသောအသင်းတော်ထံသို့ စာရေးလိုက်ပါ၏။
  </para>
  <para style="p">
    <verse number="3" style="v" />ငါတို့အဖဘုရားသခင်နှင့် သခင်ယေရှုခရစ်တော်ထံမှ ကျေးဇူးတော်နှင့်ငြိမ်သက်ခြင်းသည် သင်တို့၌ရှိပါစေသော။
  </para>
  <para style="p">
    <verse number="4" style="v" />ငါသည် ငါ၏ဆုတောင်းချက်များထဲတွင် သင့်ကိုအစဉ်သတိရလျက် ငါ၏ဘုရားသခင်ကို ကျေးဇူးတင်၏။
  </para>
  <para style="p">
    <verse number="5" style="v" />အဘယ်ကြောင့်ဆိုသော် သခင်ယေရှုနှင့် သန့်ရှင်းသူအပေါင်းတို့အပေါ်၌ သင်ထားရှိသော သင်၏ချစ်ခြင်းမေတ္တာနှင့်ယုံကြည်ခြင်းအကြောင်းကို ငါတို့ကြားရသောကြောင့်ဖြစ်၏။
  </para>
  <para style="p">
    <verse number="6" style="v" />ထို့ကြောင့် ခရစ်တော်အတွက် ငါတို့၌ရှိသည့် ကောင်းသောအရာအားလုံးတို့ကို သိခြင်းအားဖြင့် သင်၏ယုံကြည်ခြင်းနှင့်ဆိုင်သောမိတ်သဟာယဖွဲ့ခြင်းသည် ထိရောက်မှုရှိသောအရာဖြစ်လာရန် ငါဆုတောင်း၏။
  </para>
  <para style="p">
    <verse number="7" style="v" />ငါ့ညီ၊ သန့်ရှင်းသူတို့၏စိတ်နှလုံးသည် သင့်အားဖြင့် ငြိမ်သက်ချမ်းသာမှုကိုခံစားရပြီဖြစ်၍ သင်၏ချစ်ခြင်းမေတ္တာကြောင့် ကြီးစွာသောဝမ်းမြောက်ခြင်းနှင့် တိုက်တွန်းအားပေးခြင်းတို့ကို ငါခံစားရ၏။
  </para>
  <para style="p">
    <verse number="8" style="v" />ထို့ကြောင့် ငါသည် သင်ပြုသင့်သည့်အရာကိုပြုရန် အမိန့်ပေးနိုင်သည်ဟု ခရစ်တော်အားဖြင့် ယုံကြည်စိတ်ချမှုအပြည့်အဝရှိသော်လည်း
  </para>
  <para style="p">
    <verse number="9" style="v" />ချစ်ခြင်းမေတ္တာအားဖြင့် သင့်အား တောင်းပန်ခြင်းအမှုကိုသာပြုပါ၏။ ဤသို့ အိုမင်းသူဖြစ်ပြီး ယခုမူကား ခရစ်တော်ယေရှုနှင့်ဆိုင်သောအကျဉ်းသားလည်းဖြစ်သည့် ငါပေါလုသည်
  </para>
  <para style="p">
    <verse number="10" style="v" />အချုပ်အနှောင်ခံရစဉ် ငါ့သားဖြစ်လာသောဩနေသိမ်အတွက် သင့်ကိုတောင်းပန်ပါ၏။
  </para>
  <para style="p">
    <verse number="11" style="v" />သူသည် ယခင်က သင့်အတွက် အသုံးမဝင်သူဖြစ်ခဲ့သော်လည်း ယခုမူကား သင့်အတွက်ရော ငါ့အတွက်ပါ အသုံးဝင်သူဖြစ်လာ၏။
  </para>
  <para style="p">
    <verse number="12" style="v" />သူ့ကို သင့်ထံသို့ ငါပြန်ပို့လိုက်၏။ သူသည် ငါ၏အသည်းနှလုံးဖြစ်၏။
  </para>
  <para style="p">
    <verse number="13" style="v" />ငါသည် ကောင်းမြတ်သောသတင်းအတွက် အချုပ်အနှောင်ခံရစဉ် သင့်ကိုယ်စား ငါ့ကိုကူညီဆောင်ရွက်ပေးနိုင်ရန် သူ့ကို ငါ့ထံ၌ ခေါ်ထားလိုပါ၏။
  </para>
  <para style="p">
    <verse number="14" style="v" />သို့သော် သင်ပြုသောကောင်းမှုသည် မလွှဲမရှောင်သာ၍ပြုရခြင်းမျိုးမဟုတ်ဘဲ မိမိဆန္ဒအလျောက်ဖြစ်စေရန် သင်၏သဘောတူညီချက်မပါလျှင် မည်သည့်အရာကိုမျှ ငါမပြုလိုပါ။
  </para>
  <para style="p">
    <verse number="15" style="v" />သူသည် သင်နှင့် ခေတ္တခဏကွဲကွာခဲ့ခြင်းမှာ သင်သည် သူ့ကို ထာဝစဉ်ရရှိနိုင်ရန်အတွက် ဖြစ်ကောင်းဖြစ်လိမ့်မည်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ထိုသို့ဆိုရာ၌ ကျွန်တစ်ဦးကဲ့သို့မဟုတ်တော့ဘဲ ကျွန်ထက် ပို၍မြတ်သည့် ချစ်သောညီအစ်ကိုအဖြစ် ရရှိခြင်းကိုဆိုလို၏။ အထူးသဖြင့် ငါ့အတွက် ထိုသို့ဖြစ်လေပြီ။ သင့်အတွက်မူကား သွေးသား၌လည်းကောင်း၊ သခင်ဘုရား၌လည်းကောင်း မည်မျှပို၍ ထိုကဲ့သို့ဖြစ်လိမ့်မည်နည်း။
  </para>
  <para style="p">
    <verse number="17" style="v" />သို့ဖြစ်၍ သင်သည် ငါ့ကို လုပ်ဖော်ဆောင်ဖက်အဖြစ်မှတ်ယူလျှင် ငါ့ကိုလက်ခံသကဲ့သို့ သူ့ကိုလက်ခံပါလော့။
  </para>
  <para style="p">
    <verse number="18" style="v" />အကယ်၍ သူသည် သင့်အပေါ်၌ ပြစ်မှားခြင်း၊ အကြွေးတင်ခြင်း တစ်စုံတစ်ခုရှိလျှင် ထိုအရာကို ငါ့တာဝန်ထားလော့။
  </para>
  <para style="p">
    <verse number="19" style="v" />ငါပေါလုသည် ပြန်လည်ပေးဆပ်ပါမည်ဟု ငါ့လက်ဖြင့်ရေးလိုက်ပါ၏။ သင်ကိုယ်တိုင်လည်း ငါ့အား အကြွေးတင်နေကြောင်းကို ငါမပြောလိုပါ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဟုတ်ပေ၏။ ငါ့ညီ၊ ငါသည် သခင်ဘုရား၌ သင့်ထံမှ အကျိုးကျေးဇူးကိုရရှိလိုပါ၏။ ခရစ်တော်အားဖြင့် ငါ၏စိတ်နှလုံးကို ငြိမ်သက်ချမ်းသာစေပါလော့။
  </para>
  <para style="p">
    <verse number="21" style="v" />သင်၏နာခံခြင်းကို ယုံကြည်စိတ်ချ၍ ငါပြောသောအရာထက်ပင် သင်ပို၍ပြုမည်ကို သိလျက် သင့်ထံသို့ ငါစာရေးလိုက်ပါ၏။
  </para>
  <para style="p">
    <verse number="22" style="v" />တစ်ချိန်တည်းမှာပင် ငါ့အတွက် တည်းခိုစရာနေရာကိုလည်း ပြင်ဆင်ထားပါလော့။ အကြောင်းမူကား သင်တို့၏ဆုတောင်းခြင်းအားဖြင့် သင်တို့ထံသို့ရောက်ရှိရသောအခွင့်ကို ပေးတော်မူလိမ့်မည်ဟု ငါမျှော်လင့်နေ၏။
  </para>
  <para style="p">
    <verse number="23" style="v" />ခရစ်တော်ယေရှု၌ ငါနှင့်အတူအကျဉ်းချခံရသူ ဧပဖြမှစ၍
  </para>
  <para style="p">
    <verse number="24" style="v" />ငါ၏လုပ်ဖော်ဆောင်ဖက်များဖြစ်ကြသည့် မာကု၊ အာရိတ္တာခု၊ ဒေမနှင့် လုကာတို့သည် သင့်ကိုနှုတ်ဆက်ကြပါ၏။
  </para>
  <para style="p">
    <verse number="25" style="v" />သခင်ယေရှုခရစ်တော်၏ကျေးဇူးတော်သည် သင်တို့၏စိတ်ဝိညာဉ်နှင့်အတူရှိပါစေသော။
  </para>
</usx>
