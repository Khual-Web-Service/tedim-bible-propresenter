<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LEV" style="id">Siempudan</book>
  <para style="h">Siempudan</para>
  <para style="toc1">Siempudan</para>
  <para style="toc2">Siempudan</para>
  <para style="mt">Siempudan</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuin Mangpa’n Mosi ahan a, kimutuona puon inn apat in ahoupi a;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mipite houpi inlen akung uah tambangin gen in: Na lah ua mi koipou in Mangpa kunga sillat na hing tawi chiengun ganta sillat ahileh; bawnghon lah leh belamhonte lah apat a nalat ding uh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“A sillat khu bawnghonte lah apat halmang sillat ahileh atal nuolnabei alat ding ahi; ama Mangpa mai a pom ahitheina dingin kimutuona puonbuh kotbul ah alan ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh aman halmang sillat ding lutungah akhut akoi dinga; tuachi’n ama adinga kilemna sillat dinga pompieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mangpa masangah bawngtal khu athat dinga; Aaron tapa siemputen khum sillat sisan ala ding ua, kimutuona puonbuh kot bul a maitam tungah a the kawikawi ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh ahalmang sillat khu avun alem dinga asa asemnen ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Aaron tapa siemputen maitam tungah mei ataw ding ua, mei tungah sing achieng khawm ding uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Aaron tapate siemputen sa kisemnente, alu leh athau maitam a mei tungah kituptahin akoi ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh a sung sate leh akengte tuiin a sawp dinga, Mangpa dinga gimnamtuitah mei a sillat halmang kithoina dingin maitam tungah siempu’n ahaltum ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Tualeh halmang kithoina dinga lat ding khu belam hon lah apat ahiei, kelhonte lah apat ahiei, ahileh atal nuolna bei alat ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh khum khu maitam mallam pangah Mangpa masangah agou dinga, Aaron tapate siemputen maitam kimvel ah sisan athe ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh asa asemnen dinga, alu leh athaute siempu in maitam tunga, mei tunga singtungah kituptahin akoi ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh asungsa leh akengte tui in asawp dinga, siempuin ahing tawi dinga, maitam tungah ahaltum dinga, tami Mangpa dinga gimnamtuitah mei a lat, halmang sillat ahi ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Tualeh Mangpa kunga sillat ding halmang kithoina sillat va lampang ahileh palva alat ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuakhu siempu’n maitam ah ahing tawi dinga angawng ahehtan dinga, asisan khu maitam gei ah aluongkang sah dinga, tuachi’n maitam tungah ahal ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh atangkhai khu amultoh abotkhe dinga, maitam gei suolam panga vutkholna munah apai ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh ahate abotkieu dinga, asate bottan louin; tualeh siempu’n maitam a meitunga singah ahal ding hi; tuakhu Mangpa dinga gimnamtuitah mei alat halmang sillat ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Mi koipou in ann sillat Mangpa kunga alat chiengin, a sillat khu tangbuong nel ngingei ahi ding hi, tualeh atungah sathau abuoh dinga, gimnamtui akoi ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuakhu Aaron tapate siempute kungah ahing tawi dinga, tangbuong nel ngingei sipdim khat sathau leh gimnamtui teng toh alakhe dinga, tuakhu siempu in maitam tungah theizingna dingin, Mangpa dinga gimnamtuitah mei a sillat hi dingin ahal ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh ann sillat a kizangmawhte khu Aaron leh atapate ading ahi ding; tuakhu Mangpa adinga mei a sillatte lah a asiengthou pen ahi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Tualeh ann sillat lungthu tunga em minsa lat dinga na hing tawi leh tangbuong nel sathau toh kipawi tolsawlou ahiei, ahisihleh sathau kinu tanghou tolsawlou tanghoupheng pan ahi ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh na sillat khu khangbel a kikang ann sillat ahileh, tolsawlou sathau toh kimeh tangbuong nel ngingei ahi ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na atnen dinga sathau na buoh ding ahi; tam khu ann sillat ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh na sillat khu khangbel a kikang ann sillat ahileh, tangbuong nel nginngei sathau a kimeh ahi ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh tamte a kibawl ann sillat khu Mangpa kungah na hing tawi dinga, siempu kungah pieh ahizou chiengin, aman maitam ah ahing tawi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n siempu in ann sillat apat theizingna tanvou alakhe dinga, maitam tungah ahal ding hi. Tam khu Mangpa a dinga gimnamtuitah mei a sillat ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh ann sillata kizangmawhte khu Aaron leh atapate ading ahi ding hi. Tam khu Mangpa a dinga mei a sillatte lah a, asiengthou pen ahi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Mangpa kunga na lat ding ann sillat mawngmawng tol kisaw ahilou ding ahi, aziehpen Mangpa a dinga mei a sillat lah ah tol leh khuoizu na hal lou ding uh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gamasa sillat ding ahileh pen Mangpa kungah na lan ding hi; hinanleh tuate khu gimnamtui dingin maitam ah akihal sih ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh na ann sillat chintengah chi nasaw dinga, na Pasian thuhunna chi khu na ann sillatte a na kisapsah louding ahi. Na sillat zousie chi toh na latkhawm ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na ga masa ann sillatte Mangpa kunga na lat chiengun, na ga masate ann sillat dingin buvui tha mei a kihanggawsa kidengpheng na lan ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Atungah sathau na buoh dinga gimnamtui na koi ding hi; tam khu ann sillat ahi ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh siempu in tua bu kidengpheng themkhat leh sathau themkhat tualeh gimnamtui zousie, theizingna tanvou toh ahal ding ahi; khumkhu Mangpa dinga mei a sillat ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tualeh asillat khu lemna sillat kithoina ahi a, ganhon lah a alat leh atal ahiei anu ahiei ahilezong Mangpa mai a nuolnabei alan ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh asillat tungah akhut akoi dinga, kimutuona biehbuh kotbul ah athat dinga, tualeh Aaron tapate siemputen maitam tung kimvel ah sisan athe ding uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n aman lemna sillat kithoina mei a sillat Mangpa kungah alan ding hi; a sungthau leh a gilbom tunga athau um zousie leh;
  </para>
  <para style="p">
    <verse number="4" style="v" />kal nite leh atunga tuomtu a thaute leh asin tunga um athaute leh akalte alakhe ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Aaron tapaten maitam tunga mei kitaw tunga sing kichieng tungah ahal ding uhi, tuakhu Mangpa a dinga mei a sillat gimnamtui tah ahi ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mangpa a dinga lemna sillat kithoina a asillat belam hon lah a ahileh atal hiin anu hitaleh nuolnabei alat ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A sillat dinga belamnou alat leh Mangpa masang ah alan ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh a sillat tungah akhut angam dinga kimutuona biehbuh maiah athat dinga, Aaron tapaten sisan khu maitam kimvel ah athe ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh lemna sillat kithoinate apat Mangpa adinga mei a sillat alat ding ahileh amei a um athaute achinggu tanin ala dinga, a sungthaute agilbom thaute leh;
  </para>
  <para style="p">
    <verse number="10" style="v" />Akal nite tunga athau umte, athepnem a athaute leh asin tuomtu alap leh akalte nangawn alakhe ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tamte siempu in maitam tungah ahal dinga; tam khu Mangpa dinga mei a sillat ann ahi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh asillat khu kel ahileh Mangpa mai ah alan ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh aman asillat lutung ah akhut angam dinga kimutuona biehbuh mai ah athat dinga tualeh Aaron tapaten asisan khu maitam kimvel ah athe ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh khunah asillat pen alan dinga, Mangpa ading a, mei-a sillat bangin; agilzam tuom athaute leh gilzam thaute leh,
  </para>
  <para style="p">
    <verse number="15" style="v" />a kal nite leh atunga thaute, athepnem kawma um alapte leh asin leh akalte tuomtu athaute nangawn alakhe ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh khum khu siempuin maitam tungah ahal ding ahi, tuakhu gimnamtui tah dinga mei a sillat ann ahi dinga, athau zousie Mangpa a ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sathau ahiei, sisan ahiei naneh dinguh ahisih chi nahah nasuonte ua dingin zong na tenna mun phot uah, thupieh ahi ding hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate kungah tambangin genin, bawllou dinga Mangpa’n thu apiehte bangkhat poupou mi’n abawla ana suhkhiel khah a, abangpou zong ana bawltah leh,
  </para>
  <para style="p">
    <verse number="3" style="v" />Sathau kinusa siempu in mipite tunga mawna tungsah a, khelna abawl leh asil bawlkhiel thoina dingin, Mangpa kungah bawngtal tuoi nuolnabei khat, khelna sillat dingin hing tawi heh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khum bawngtal khu kimutuona biehbuh kotpi bulah, Mangpa masangah ahing kai dinga, bawngtal lutungah akhut angam dinga, Mangpa mai ah bawngtal athat ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n thaunusa siempu in bawngtal sisan themkhat ala dinga, kimutuona biehbuh ah ahing tawi dinga;
  </para>
  <para style="p">
    <verse number="6" style="v" />Siempu’n sisan lah ah akhutmete adie lut dinga, sisan themkhat mun siengthou puonzah Bul a, Mangpa maiah sagi vei athe ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh siempu’n kimutuona biehbuh sunga Mangpa masanga gimnamtui halna maitam kii te ah khum sisan ataat dinga, tualeh bawngtal sisan kimutuona biehbuh kotpi bula halmang sillatna maitam bulah asung ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh khiel kithoina bawngtal thau zousie ala dinga, agilzam tuomtu leh agilzama um athaute zousie;
  </para>
  <para style="p">
    <verse number="9" style="v" />Akal nite leh athepnem kawma alapte leh akal tunga um asin tuom thaute alakhe ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lemna sillat kithoina bawngtal apat kila bangin; siempu’n halmang sillatna maitam tungah ahal ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh bawngtal vun leh asatel zousie, alutang, akengte, agilzamte, a eeh toh,
  </para>
  <para style="p">
    <verse number="12" style="v" />a bawngtal luong khu giehphuol pulam a vut buohna mun siengthou khat ah apodoh dinga, sing tungah mei in ahal dinga, vut buohna mun ah ahal ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Tualeh Israel mipi kikhawmten tupmawng hilou a sil abawlkhiel khah ua, mipi mitmu a phuol ahi a; Mangpa’n bawllou dinga thu apiehte lah a khat poupou abawl zieh ua, siemmaw tang ahing ahita ua,
  </para>
  <para style="p">
    <verse number="14" style="v" />a sil gilou bawl uh theikhieh ahing hileh mipi umkhawmten khiel kithoina dingin bawngtal tuoi khat alan ding ua, kimutuona biehbuh kotbul ah ahing kai ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh mipi umkhawmte upaten Mangpa mai ah bawngtal lutung ah angam ding ua, bawngtal khu Mangpa mai a thalup ahi ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh thaunusa siempu in bawngtal sisan khu kimutuona biehbuh ah ahing tawi dinga:
  </para>
  <para style="p">
    <verse number="17" style="v" />Siempu in akhutme sisan ah adie dinga, Mangpa mai a puonzah masangah sagi vei athe ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh sisan themkhat kimutuona biehbuh a Mangpa mai a um maitam kii te ah ataat dinga, sisan khu halmang sillatna maitam tungah asung ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh athau zousie aladoh dinga maitam tungah ahal ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh tam bawngtal khu khelna sillat dinga abawl bangin abawl dinga; tualeh siempuin amaute dingin lemna abawlpieh dinga, tuachi’n ngaidam ahi ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh khum bawngtal khu giephuol pulam ah a po dinga, bawngtal masa ahal bangin ahal ding hi, tam khu mipi kikhawm te dinga khelna sillat ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Vaihawmtu khat in Mangpa Pasian in bawllou dinga a thupiehte lah a khat poupou theisiemlou zieh a abawlkhiel khah a, siemmaw ahing tan a;
  </para>
  <para style="p">
    <verse number="23" style="v" />a hisihleh, asilbawl khiel ahing theidoh a ahileh, a sillat dingin keltal nou nuolnabei khat ahing kai ding;
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua kel lutungah akhut angam dinga; Mangpa mai a halmang sillat athana mun uah athat dinga, tam khu khelna sillat ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh siempu’n khelna sillat sisan themkhat akhutme in ala dinga, halmang sillatna maitam kii te ah ataat ding hi. Tualeh sisan valteng khu halmang sillatna maitam phungah asung bo ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh lemna sillat kithoina thaute bangin, athau zousie maitam tungah ahal ding hi. Tuachi’n akhelna ziehin siempu in lemna abawlpieh dinga, ngaidam ahita ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Tualeh mi nautang lah a koi ahiei khat in theisiemlou zieh a, Mangpa’n bawllou ding a athupiehte lah a khat poupou abawla siemmaw atanleh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Abawlkhiel na ahing theidoh chiengin, asillat dingin kelnou anu nuolnabei khat ahing kai ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tua khelna sillat lutungah akhut angam dinga tuachi’n halmang sillat thana mun ah athat ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh siempu in asisan themkhat akhutme in ala dinga, halmang sillatna maitam kii te ah ataat dinga, sisan valteng maitam zungah a sung bo ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh athau zousie lemna sillat kithoina thaute alah bangun ala sieng ding a tualeh siempu’n Mangpa ading gimnamtui dingin maitam ah ahal ding ahi. Tualeh siempu’n lemna abawlpieh dinga, ngaidam ahi ding.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Tualeh khelna kithoina sillat dinga belamnou ahing tawi leh anu nuolnabei ahing tawi ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman khelna sillat lutungah akhut angam dinga, halmang sillat athana mun uah athat ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh siempu’n khelna sillat sisan themkhat akhutme in ala dinga, halmang sillatna maitam kii te ah ataat dinga, sisan valteng khu maitam phungah asungbo ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh lemna kithoina sillat apat belamnou thaute akilahdoh bangin, athau zousie aladoh dinga, siempu in Mangpa a dinga mei a sillat bangin maitam tungah ahal ding hi. Tualeh siempu’n asilbawl khelna a dingin kilemna abawlpieh dinga, ngaidam ahi ding hi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Mi koipou in asil mu ahiei, a thuzah ahiei a, theipitu hinapi a, thukhenna masanga gendoh dinga phut ahi nua azong gennuomlou a, khelna abawl leh, agitlouna maw aman akipuoh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahisihleh koipouin gamsa sienglou shi luong ahiei, ganta sienglou luong ahiei, ahisihleh bohkhup a vah ganhing sienglou luong ahiei, atheilou kaala athamkhah leh ama zong sienglou ahi dinga, siemmaw tang ahi ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahisihleh, mihinga sienlouna, mi subuathei bangchibang sienlouna hitaleh theikhollou a, athamkhah leh akitheidoh hun chiengin siemmawtang ahi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahisihleh mi koipouin silhoi hiin sil hoilou hitaleh ngaituona umloukei a, akama akimawh chiema, theipha nawnlou a aumleh atheidoh hun chiengin tam silte lah a khat penpen ah siemmawtang ahi ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh tambang ahi ding hi, tam silte lah a khat penpen a siemmaw atan chiengin, asil bawlkhiel aphuong ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh khiel kithoina dingin belamhon lah a anu ahiei, kelnoute lah anu ahiei, asil bawlkhiel zieh a Mangpa kunga lat dingin ahing tawi dinga, tuachi’n siempu in akhelna zieh a tatna abawlpieh ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Tualeh akhelna thoina dinga belamnou ahing tawi zou sihleh vakhu ni ahisihleh palva nou ni Mangpa kunga lat dingin ahing tawi dinga, khatpen khelna sillat dingin, khat pen halmang sillat in alan ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khumte siempu kungah ahing tawi dinga, khelna sillat pen alan masa dinga, angawng apat alutang ahehtan dinga hinanleh akikhen sah sih ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh aman khelna sillat sisan themkhat maitam pangah athe dinga; sisan umnalai teng khu maitam zungah aluongkang sah ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh halmang sillat ni na pen khu, dan dungzuiin alan dinga; siempu in asilbawl khelsa tungah kilemna abawlpieh dinga, tuachi’n ngaidam ahita ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Hinanleh vakhu ni ahiei, palva ni ahiei, ahing tawi zou sihleh, silbawl khieltu in asillat dingin tangbuong nel ephah sesawm suo sekhat khelna sillat dingin ahing tawi ding hi; sathau abuohkhum sih dinga, atungah gimnamtui zong akoi sih ding hi, tam khu khelna sillat ahi ziehin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n siempu kungah ahing tawi dinga, siempu in theizingna dingin asipdim khat aham dinga, mei a sillat bangin, Mangpa mai ah maitam tungah ahal ding hi, tami khelna sillat ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh siempuin tam silte lah a akhelna pen a dingin kilemna abawl pieh dinga, tuachi’n ngaidam ahi ding hi; avalteng khu ann sillat bangin siempu a ding ahi” ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="15" style="v" />“Mi koipouin Mangpa sil siengthoute tunga, theimasa loua abawl khiel khahleh, abawl khelna sillat dingin belamhon lah a belamtal nuolnabei khat, mun siengthou a shekel bangin dangka shekel bangza ahiei guun a na ngai, suhkhelna sillat dingin Mangpa kungah ahing tawi ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh sil siengthou tunga ana bawlkhiel khahte asangkia dinga, se nga suo sekhat abelap dinga, siempu kungah ape ding hi, tualeh abawlkhelna sillat dingin kilemna abawlpieh dinga, ngaidam ahi ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Tualeh mi koipouin, Mangpa’n bawllou dinga athupieh silte khat poupou theilou in bawlkhata leh thei sih nanleh zong maw apo thouthou ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh belamhon lah a belamtal nuolnabei, nangma ngai a kilawm hun nasah khat, siempu kungah bawlkhelna sillat dingin ahing tawi ding hi; tuachi’n theilou a sil ana bawlkhelna tung thu ah siempu in ama a dingin kilemna abawl pieh dinga, ngaidam ahi ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tami bawlkhelna sillat ahi, Mangpa tungah abawlkhiel a siemmaw atang hi,” achi hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mi koipouin sil abawlkhiel a, Mangpa thupiehte abawsiet a, sum kikep sah thu ahiei, solbawla lepguhna ahiei, guhpieh thu ahiei a, a innvengte sola azuou bawl leh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahisihleh van kimangsah mu in, ka mu sih chiin zuou genin dihloutahin kichiem taleh zong, tam silte zousie khat poupou abawl khiel leh:
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichi ahi ding hi: sil bawlkhiel ngel ahi a, siemmaw atan ziehin avan guhte, zuouthu a asil lahte, akunga sum kikem sahte leh van mang a mute;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahisihleh dihloutah a akichiemna zousiete, asan kia ding ahi; akim keiin asangkia sieng dinga, senga suo sekhat abelap ding hi, tualeh asil bawlkhelna sillat abawl niin aneitu kungah apeding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh akhelna sillat dingin belamhon lah a, belamtal nuolnabei, kilawmhun nasah khat khelna kithoina sillat dingin siempu kungah ahing tawi ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n siempu in Mangpa mai ah ama a dingin kilemna abawlpieh dinga, akhelna zousie ngaidam ahita ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Mangpa’n Mosi ahoupia, akungah;
  </para>
  <para style="p">
    <verse number="9" style="v" />“Aaron leh atapate kungah, Tami halmang sillat dan ding ahi: halmang sillat pen maitam tunga ahalna ah zan tungtawn in, zingmawng dongin a um dinga, tualeh maitam a mei khu akuong ngitnget ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh siempu in apuonmalngat puonsil asil dinga, asatung khuna dingin apuonmalngat tawka ateng ding hi, tualeh maitam a halmang sillat kangvamte ala dinga, maitam pangah akoi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua apuonsilte asutkhe dinga, puonsil dangte asil dinga, avamte giehphuol pulam a mun sieng khat ah ava sungbo ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh maitam tunga mei khu akuongsah ngitnget dinga, amitsah ngai sih ding hi. Tuachi’n siempu in zingmawng chinin sing avang zel dinga, halmang sillat hoitahin akoi dinga, khunah lemna sillatte sathau ahal ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maitam tungah mei akuong ngitnget dinga, amit ngai sih ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Tualeh tam khu ann sillat danding ahi: Aaron tapaten Mangpa mai a maitam tungah alan ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman tangbuong leh sathau sipdim khat leh ann sillat tunga gimnamtui um zousie aladoh dinga, Mangpa a dinga gimnamtuitah, theizingna dingin maitam tungah ahal ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh avalteng Aaron leh atapaten aneh ding uh ahi: tanghou tolsawlou toh mun siengthou ah ane ding ua, kimutuona biehbuh huongsungah ane ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tol toh mehkhawm a kan ding ahi sih hi, tam mei a ka sillatte khu, atanvou ding ua ka pieh ahita, khelna sillat bang leh bawlkhelna sillat banga siengthou pen ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aaron hahlesuon pasal zousie’n aneh ding uh ahi. Tam pen Mangpa dinga mei a sillat tung thu a, na khang tungtawn ua, kumtawna dinga thugousie ahi dinga, koi zong tami tham pouma asiengthou ahi ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="20" style="v" />“Tami Aaron leh atapaten sathau nu a aum ni chieng ua, Mangpa kunga alat dinguh sillat ahi; ann sillat dinga latzom ngitnget ding tangbuong nel ephah sesawm suo sekhat zingmawng in akimkhat, nitahin akimkhat.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khumte sathau toh mehkhawm in khangbel sunga na kan zou chiengin na hing lalut dinga, ann sillat apheng neu nou nou a kikang Mangpa a dinga gimnamtui dingin na lan ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Atapate lah a Aaron taanga pang ding mi, sathaunu siempu in alan dinga, kumtawn dan ahi a, haltum sieng ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Siempu in alat ann sillat pouma haltum sieng ding ahia, koiman aneh louding ahi.”
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="25" style="v" />“Aaron leh atapate kungah tambangin gen in, Tam khu khelna kithoina sillat ding dan ahi; halmang sillat kithazelna munah, khelna sillat zong Mangpa mai a tha ahi ding hi, tuakhu sil siengthou pen ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khelna kithoina sillat lantu siempu in tami ane dinga, kimutuona biehbuh huongsung mun siengthou ah ane ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koipou tua sa thamkha pouma asiengthou ding uhi. Tualeh asisan in bang puon hitaleh zong athekhah leh sisan banna puon pouma mun siengthou ah na sawp ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hinanleh akihuonna leibel khu satkeh ahi dinga, sum-eng bel a kihuon ahileh nawt sienga tui a khuo sieng ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Siempute lah a pasal zousie’n tami ane thei ding ua, tam khu asiengthou pen ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hinanleh mun siengthou pen sunga kilemna, sillat dinga, kimutuona biehbuh a hing kitawi sisan khu neh ding ahisih a, haltum ding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tuachimabangin tam khu tatkhelna sillat dan ahia; a siengthou pen ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Halmang sillat athana mun ma uah, tatkhelna sillat zong athat ding uhi, tualeh asisan khu maitam kimvel ah athe ding uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh athau zousie alan ding ua, amei thau leh asung thaute,
  </para>
  <para style="p">
    <verse number="4" style="v" />a kal nite leh atunga a thau umte leh athepnem a alap umte leh asin tuomtu athau leh akalte toh alakhe sieng ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Siempuin tuate khu Mangpa a dinga mei a sillat dingin maitam tungah ahal ding hi. Tam khu tatkhelna sillat ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siempute lah a pasal pouma in tam khu ane ding ua, mun siengthou a neh ahi ding hi, tami asiengthou pen ahi ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tatkhielna kithoina khu khelna kithoina sillat bang ahi a, ani ua dingin dan khat ahi; tuabang kithoina lantu siempu in atang ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh siempu koizong halmang sillat lat piehtu tua siempu ngeiin halmang sillat alat vunte atang ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh akan a kanthaw ann sillat leh khangbel leh kuonga kan zousie alantu siempu a ahi ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh ann sillat sathau toh kimehkhawm ahisihleh akigawsah zousie Aaron tapaten kibang chiet in atang ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Tam khu min Mangpa kunga alat ding lemna kithoina sillat dan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kipahthugenna dinga lat ahileh, kipahthugenna kithoina dingin sathau toh kihal tolsawlou tanghou toh kimehkhawm, sathau kinu tanghou pheng toh, sa toh kimehkhawm tangbuong nel kikang toh alat khawm ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tanghou phengte chilou zong, kipah thugenna kithoina dinga lemna sillat kithoina ah tol kisaw tanghou zong alat tel ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh tam sillatte apat, Mangpa a dinga sillat dingin, khat chiet alan dinga, tuakhu lemna sillatte sisan thetu siempu’n atang ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kipahthugenna dinga lemna sillat kithoina sa pen, sillat alat ni ma a nehbei ding ahia, azingmawng donga bangma themkhat zong koi lou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinanleh kithoina sillat khu, kichiemna ahiei, ahisihleh ama ut thu a sillat ahileh akithoina lat ni mama a neh zou ding ahi a, avalteng khu azingni chienga neh thei ahi ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivang in kithoina sa nithum donga um nalai teng khu mei a haltum ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lemna sillat kithoina sa anithum donga neh ahileh, pompieh ahisih dinga, alantu zong alan a sim ahisih ding hi: Tam khu sil sienglou ahi dinga, koizong ane pouma in amaw akipuoh ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Tualeh sa silsienglou toh kisukha mawngmawng neh louding ahi, mei a haltum ding ahi. Tualeh sa sieng pouma asiengthou tengin aneh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh Mangpa tantuom lemna sillat kithoina sa netu khu, amite lah apat tuom koi ahi ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuathamlouin koipouin sil sienglou mawngmawng, mi sienglou ahiei, ganta sienglou ahiei, sil sienglou kidah huoi ahiei, akhoi khah a, lemna sillat kithoina sa Mangpa tantuom aneh leh tuabang mi khu amite lah a pat tuom koi ahi ding hi, chiin gen in achi hi.”
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Mangpa’n Mosi ahoupi a akungah;
  </para>
  <para style="p">
    <verse number="23" style="v" />“Israel tate kungah Bawngtal ahiei, belam ahiei, kel ahiei, thau na neh lou ding uh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh gamsa ama thu a shite thau leh gamsa in athalup thau khu sil dangah zahthei ahi dinga, hinanleh naneh hetlou dinguh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aziehpen koipouin Mangpa adinga mei a sillat alat uh sathau ne mihing pouma amite lah a pat koituom ahi ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuathamlouin na umna pou uah sisan mawngmawng va sisan hiin sa sisan hitaleh na neh votlou ding uh ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koipou sisan ne pouma, tua mihing khu amite lah apat tuom koi ding ahi,” chi’n genin achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Mangpa’n Mosi ahoupi a akungah;
  </para>
  <para style="p">
    <verse number="29" style="v" />“Israel tate kungah: Koipou Mangpa kunga lemna kithoina sillat lanten, Mangpa kungah alemna sillat ahing tawi ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama khut ngel in Mangpa adinga mei a sillat ahing tawi dinga, athau leh a awm ahing tawi ding hi, tua pen Mangpa mai a vei sillat ding a vei ahitheina dingin.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh athaupen siempu in maitam tungah ahal dinga: a awm pen ahileh Aaron leh atapate tanvou ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amal zietlam pen lemna kithoina sillat apat sillat dingin siempu kunga na pieh ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aaron tapate lah a lemna sillat sisan leh sathau lan penpen in samal zietlam atan ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aziehpen a awm leh amal veilam pen, Israel tate lah a lemna kithoina sillat akipat ka lata a, siempu Aaron leh atapate kungah Israel tate kumtawn dan thupieh dingin ka peta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tami ahi amaute siempu nasem dinga sathau akinu ni ua, Israel taten apieh ding ua, Mangpa’n thu apieh mei a sillat apat Aaron tanvou leh atapate tanvou ding khu.
  </para>
  <para style="p">
    <verse number="36" style="v" />Israel taten apieh dinguh chia, amaute sathau anu ni a, akhangtan ua kumtawn dan thupieh dinga thu apieh khu ahi.”
  </para>
  <para style="p">
    <verse number="37" style="v" />Tami khu halmang sillat, ann sillat, khelna thoina sillat, bawlkhelna sillat, kisuhsiengna sillat leh lemna kithoina sillat, kithoina dan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Sinai gamdai a Mangpa’n Israel taten akithoina uh Mangpa kunga lan dinga thu apieh nia, Sinai tanga Mangpa’n Mosi thu apieh khu ahi, chiin genin achi hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aaron leh atapate zawpi inlen, puonsilte toh, kisiensuona a nu ding sathau toh, khelna sillat ding bawngtal toh belamtal ni leh tolsawlou tanghou tawi inlen;
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh mi zousie kimutuona biehbuh kotbul ah han khawm in chiin agen hi.”
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Mosi in Mangpa thupieh bangin abawl a, mipi zousie kimutuona biehbuh kotbul ah ahing kikhawmta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Mosi in mipi hing peikhawmte kungah; “Tami Mangpa’n bawl dinga thu ahing pieh khu ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuazouin Mosi in Aaron leh atapate ahing zawpi a, tui in asil hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh puonah asilsah a, kawnggah in agah a, puonah tuol asilsah a, siempu puonah in atuom a, siemtah a kigan siempu puonah gahna in agah a akhita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n siempu awmphaw abel pieh a, a awmphaw tungah Urim leh thumim akoi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh siempu diel alu ah akhipsah a Mangpa’n Mosi kunga thu apieh bangin dielkhip tungah amailam zawn ah sana peh, lallukhu sieng akhai pieh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Mosi in kinuthaw sathau ala a, biehbuh leh asunga um zousie sathau anu a, asusiengthou tahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh maitam tungah sagi vei athe a, maitam leh umlebel zousie, tui kuong leh atunna siensuona dingin sathau anu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh siensuona sathau khu Aaron lutungah asunga, asiensuona dingin sathau anu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuazouin Mosi in Aaron tapate ahing zawpi a puonah tungsil asilsah a, kawnggah in agah a, lukhu akhuhsah chiet hi, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh khelna kithoina sillat bawngtal ahing kai a, Aaron leh atapaten khelna sillat bawngtal lutungah akhut uh angam ua:
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Mosi in athat a, tuachi’n asisan ala a, akhutmete in maitam kiite ah ataat a, maitam asusieng thou a, tualeh sisan khu maitam phungah abuo a kilemna bawlna dingin asiensuota hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n agilzam tunga athau zousie leh asin tuomtu alap leh akalte gel a athau umte aladoh a, Mosi in khumte maitam tungah ahal hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinanleh bawngtal khu avun leh asa tualeh a eeh toh giehphuol pulam ah ahal hi, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh halmang sillat belamtal ahing kai a, Aaron leh atapaten belamtal lutungah akhut uh angam ua;
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Mosi in athat a, asisan maitam kimvel ah athe hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh belamtal khu asem a, alutang leh asa tualeh athaute Mosi in ahaltum hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh agilzamte leh akengte tuiin asawpa; Mosi in belamtal pumpi maitam tungah ahal hi; tami halmang sillat leh Mangpa adinga gimnamtui dinga mei a sillat ahi; Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh aman belamtal nina kisuhsiengthouna belamtal khu ahing kai a; tuachi’n Aaron leh atapaten belamtal lutungah akhut uh angam ua.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Mosi in athat a, asisan themkhat ala a, Aaron zietlam bildawn, azietlam khutpi dawn, azietlam kengpi dawn, ah anu pieh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Aaron tapate ahing zawpi a, Mosi in sisan themkhat azietlam bil dawn u’leh azietlam khutpi dawn u’leh azietlam kengpi dawn uah anu pieh chiet hi. Tualeh sisan khu maitam tung kimvel ah athe hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh aman athaute, amei thaute, asung thau zousie, asin tuom athaute, akal tegel leh athaute leh azietlam mal a la a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mangpa mai a um tolsawlou tanghou bawm apat tanghou pheng khat leh sathau a kimeh tanghou pheng khat leh tanghou pheng pan khat aladoh a, maitam tungah akoi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh aman tamte zousie Aaron leh atapate khut sungah akoi a, Mangpa mai a sillat in alan hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Mosi in akhut ua pat ala khie a, maitam a halmang sillat tungah ahal hi: Tamte khu gimnam tui dinga Mangpa mai a kisuhsiengthouna ahi, tami Mangpa dinga mei a sillat ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Mosi in a awm ala a, Mangpa maiah vei sillat dingin avei a, kisuhsiengthouna belamtal ahileh Mosi tantuom ahi; Mangpa’n Mosi kunga thu apieh bangin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n Mosi in kisiensuona sathau themkhat leh maitam tunga um sisan ala a, Aaron leh apuonsilte leh atapate leh apuonsilte uh tungah athe hi; tuachi’n Aaron leh apuonsilte leh atapate leh apuonsilte uh asiensuota hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Mosi in Aaron leh atapate kungah, “Kimutuona biehbuh kotbulah asa huon unlen, tua mun ah Aaron leh atapaten aneh ding uh ahi chia ka hing thupieh bangin, tuakhu kisiensuona bawma tanghou toh ne un.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh asa leh tanghou valteng khu meiin na haltum ding uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh na kisiansuoni uh abei masangsien ni sagi sung kimutuona biehbuh kot pulam a na pawt lou ding uh ahi. Aziehpen aman ni sagi sung ahing siensuo ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tunia abawltah bangin, nou dinga kilemna bawl ding, Mangpa’n thu apeta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuaziehin kimutuona biehbuh kotpi bul ah ni sagi sung sunlezan na um ding ua, na shi louna dingun Mangpa thupieh na zui ding uhi; aziehpen tuabanga bawl ding thu ka hing pie ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuachi’n Aaron leh atapaten, Mangpa’n Mosi zanga athupieh zousie abawl uhi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh hichi ahing hia, ani gietni in Mosi in Aaron leh atapate leh Israel upate ahankhawm a;
  </para>
  <para style="p">
    <verse number="2" style="v" />Aaron kungah, “Khelna sillat dingin bawngtal guol khat; halmang sillat a dingin belamtal nuolnabei khat la inlen, Mangpa mai ah lan in, a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Israel tate kungah, thu na gen dinga, khelna sillat dingin kelnou khat, halmang sillat dingin bawngnou khat leh belamnou kumkhat tuoh nuolnabei ahi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lemna sillat dingin bawngtal khat leh belam khat, Mangpa mai a kithoina dingin hingkai unlen, tualeh sathau a kimeh ann sillat toh: tuni’n na kung uah Mangpa hing kilang ding ahi chi’n hil in,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mosi in thu apieh bangin kimutuona biehbuh mai ah ahing kai ua, mipi kikhawmte zousien ahing nai khawm ua, Mangpa mai ah ading uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mosi in, “Tami Mangpa’n na bawl ding ua, ahing thupieh ahi, tuachi’n Mangpa thupina na kung uah akilang ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Mosi in Aaron kungah “Maitam ah pei inlen na khelna sillat leh na halmang sillat va lan inlen, nang a ding leh mipite a dingin kilemna bawlin, tualeh mipite sillat lan inlen ama ua dingin kilemna bawlpieh in, Mangpa thupieh bangin,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaziehin Aaron in maitam avazuon a khelna sillat bawngnou khu ama a dingin athat a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aaron tapaten asisan akungah ahing tawi ua, tualeh aman akhutmete sisan ah adie a, maitam kii te anu a, sisan khu maitam zungah a sung hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hinanleh khelna sillat thau leh akal nite leh a sin tuomtu alapte khu maitam tung ah ahal a, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Asa leh avun khu giehphuol pulam ah meiin ahal hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh aman halmang sillat khu athat a, Aaron tapaten asisan akungah ahing tawi ua, aman khumte maitam tung kimvel ah athe hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh amauten halmang sillat khu abat bat in asem ua, alu tawh akungah ahing tawi ua, aman tuate khu maitam ah ana hal hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh aman agilzamte leh akengte tuiin asawp a, maitam ah halmang sillat tungah ahal hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n aman mipite sillat ahing tawi a, mipite dinga khelna sillat kel ala a, athat a, amasa bangin khelna thoina dingin alan hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh halmang sillat ahing tawi a, dan dungzuiin alan hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh tangbuong sillat ahing tawi a, sipdim khat aham a, zingmawng halmang kithoina chilou zong maitam ah ahal hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh mipite adinga lemna sillat kithoina dingin bawngtal leh belamtal zong athat a, Aaron tapaten asisan kuongah ahing tawi ua, tuakhu aman maitam tung kimvel ah athe hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bawngtal leh belamtal thaute leh amei thaute leh asung thaute, akal nite leh asin tuomtu alapte zong apie ua;
  </para>
  <para style="p">
    <verse number="20" style="v" />Athaute khu a awm tungah akoi ua, aman athaute khu maitam ah ahal hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A awmte leh azietlam mal khu Aaron in Mangpa mai ah vei sillat in avei hi, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aaron in mipite lam ah aban azah a, amaute a guolzawl a, khelna sillat, halmang sillat leh lemna sillatte alat zouin ahing kum suh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosi leh Aaron khu kimutuona biehbuh sungah alut ua, tualeh ahing pawtdoh kia ua, mipite aguolzawl ua, tualeh Mangpa thupina khu mi zousie kungah ahing kilang hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Mangpa mai a kipan in mei ahing pawtdoh a, maitam tunga halmang sillat leh sathaute akatumta hi, khum khu mipi zousie’n amu ua, akikou ua, amai ua tuolsu in akhupbohta uhi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Aaron tapate Nadab leh Abihu in amei bawm uh ala tuoh ua, asungah mei akoi ua, atung ah gimnamtui abuoh ua, Mangpa mai ah, Aman thu apiehlou mei tuom dang alanta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Mangpa a kipat in mei ahing pawtdoh a, amaute a katum a, Mangpa mai ah ashita uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Mosi in Aaron kungah, “Mangpa’n ka kungnai a hing pei poumate ah suh siengthou in ka um dinga, tualeh mi zousie masangah pahtawi in ka um ding, chia a gen khu tami ahi achia, tuachi’n Aaron hamlou keiin a um hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Mosi in Aaron pa neu Uzziel tapate Mishael leh Elzaphan ahan a, akung uah, “Hing nai unlen, mun siengthou mai a kipat in na unaute uh luong giephuol pulam ah paw doh un,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n ava zuon ua, apuon tungsilte ua man in amaute giephuol pulam ah azawngdoh ta uhi, Mosi genbangin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mosi in Aaron leh atapate Eleazar leh Ithamar kungah, “Na lu uh hawhdoh sih unlen, na puonte u’zong botkeh sih un: tuachilouin vang shi khava uchin, mipite zousie tungah alungthahna ahing tungkha ding hi. Hinanleh na unaute uh, Mangpa akipat mei in akahtumte, Israel innkuon zousie in suun uheh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kimutuona biehbuh kot pulam a na pawtdohlou ding uh ahi, tuachilouin na shi kha ding uhi, aziehpen Mangpa namdetna sathaunu khu na tung uah um ahi” achia, tuachi’n amauten Mosi gen bangin abawlta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Mangpa’n Aaron ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nang na hiei, na tapate ahiei in zong kimutuona biehbuh sunga na lut chiengun zu leh zuchia dawn sih un, tuachilouin na shikha ding uhi; tami na khangtungtawn ua kumtawn a dinga thugousie ahi ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuatekhu nouten sil siengthou leh siengthoulou, tualeh a sieng leh sienglou nakhen theina ding u’leh;
  </para>
  <para style="p">
    <verse number="11" style="v" />Mangpa’n Mosi zanga akung ua agen thupieh zousie Israel tate na zilsah theina uh ahi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Mosi in Aaron leh atapa um nalaite Eleazar leh Ithamar kungah, “Mangpa a dinga mei a sillatte a, ann sillat valte la unlen maitam pang ah tanghou tolsawlou toh ne un, tuakhu sil siengthou pen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tam khu mun siengthou khat a na neh ding uh ahi; aziehpen tami Mangpa a dinga mei a sillat kithoina apat nangleh na tapate tanvou ahi, tuabanga bawl dingin thupieh in ka um hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh sillat a awm leh azietlam mal pen nang leh na tapate leh na tanuten mun sieng khat a na neh ding uh ahi; aziehpen tuate khu, Israel tate lemna sillat kithoina apat hing kipie nang leh na tapate tanvou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vei sillat mal leh vei sillat awm khu Mangpa mai a vei sillat dingin, mei a sillat sathau toh ahing tawi ding uhi, tami nang leh na kunga um na tapate tanvou dinga kumtawn thugousie ahi, Mangpa’n thu ahing pieh bangin, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Mosi in khelna sillat kel pen pilvang tahin a suichiena, hinanleh ana haltumta uhi. Tuachi’n Aaron tapa dam a um nalai Eleazar leh Ithamar tungah alungthah mama hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Bangdinga khelna kithoina sillat sa mun siengthou khat a nelou nahi uoi? Tami sil siengthou pen ahi ngal a, tualeh Pasian in mipite gitlouna paw dinga, Mangpa mai a lemna bawlpiehna dinga noute ahing pieh ahi thuoi a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Envawi un tami sisan mun siengthou sunga ki tawilut lou ahi; thu ka hing pieh banga mun siengthou a na neh ding uh ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Aaron in Mosi kungah, “Ngaivawi tuni’n amauten a khelna sillat u’leh ahalmang sillat uh Mangpa mai ah alanta uhi; tambang sil ka tungah ahing tungta mawh hi; tuni’n khelna kithoina sillat anane hitaleng Mangpa mitmu ah pomtah ahina diei” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Mosi in khum khu azahin alungkimta hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi leh Aaron ahoupi a, akung uah
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate kungah gen unlen Leitunga gamsa zousie lah a naneh dinguh sate khu tamte ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sate lah a kengchin kaa peisuoh tualeh annkia hai pouma na neh thei ding uh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh annkia hai a achinkaate lah ah tamte nane thei sih ding uhi; sangawngsau bang annkia hai hinanleh achin akaalou ziehin nou a dingin a sienglou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh kawl zupi zong khahai nanleh achin akaalou ziehin nou a dingin asienglou ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh bilpi kha hai nanleh achin kaalou ahi ziehin nou a dingin a sienglou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh voh achin kaa peisuoh nanleh annkia hailou ahi ziehin nou a dingin a sienglou ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asa uh naneh lou dinguh aluong uh zong na khoilou ding uh ahi, nou a dingin asienglou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tui sunga um zousie lah ah tamte na neh thei dingte uh ahi: Tuipite, luite leh tui sunga um hanei leh lip neite na nethei ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hinanleh tui sunga um ganhing ha leh lip neiloute nou a dinga sienglou ahi ziehin na ne thei sih ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaute nou a dingin sil kidahhuoi ahi ding ua, asa u’zong na nehlou dinguh ahia, ashi luongte u’zong sil kidahhuoi a na ngai dinguh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tui sunga um ha leh lip neilou zousie nou a dinga sienglou ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Tualeh tungleeng vate lah a kidahhuoi a na ngai ding u’leh asa na neh lou dinguh tamte ahi: Langta, muvanlai, tuivapi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mukhau leh muvompi leh mu poupou,
  </para>
  <para style="p">
    <verse number="15" style="v" />Va ah chi zousie
  </para>
  <para style="p">
    <verse number="16" style="v" />Simbu, vabah, va ngawngsau, tuiva kaang leh musi chi zousie.
  </para>
  <para style="p">
    <verse number="17" style="v" />Simbu tanglit, kaikuonggal, tui simbupi
  </para>
  <para style="p">
    <verse number="18" style="v" />Tui vatawt, va bungah leh simbu kaang,
  </para>
  <para style="p">
    <verse number="19" style="v" />Inntung va leh tuiva kengsang chi pouma, suongpal leh baah ahi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Ha nei a leng ganhing kengli a lampei pouma nou a dinga kidahhuoi ahi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh hanei a kengli a lampei ganhingte lah a, leitunga kitawmna dinga akengpeh tung ua keng kituona neite nane thei ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuate lah a naneh theiding uh tamte ahi, khaukhup chi pouma leh khaukhup mul neilou pouma, khuomkhit chi pouma leh khuongbai chi chinteng,
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh ganhing hanei a, keng li nei dang zousie nou a dingin sil kidahhuoi ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Tualeh tamte ziehin sienglou nahi ding uh: Koipou khumte shi luong thamkha pouma nitah dongin sienglou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh koipou tamte shi luong pokha pouma in apuonte asawp dinga, nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ganta achin kaa peisuohlou, kha zong hailou pouma nou a dingin a sienglou ahi, koipou tuabangte thamkha pouma asienglou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kengli apei ganhing zousie lah ah akengchinte pansan a vah pouma nou adingin asienglou ahi, khumte shi luong thamkha pouma nitah dongin asienglou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh koipou ashi luonguh pokha pouma in apuonte uh asawp ding ua, nitah dongin asienglou ahi ding uhi. Amaute khu nou a dinga sienglou ahi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Leitunga a awm a kithol a bohvah te lah a, nou a dinga siengloute khu Bui, chiapi chi pouma,
  </para>
  <para style="p">
    <verse number="30" style="v" />Innhih, talmam, tang, thangkhit, senel thangkhit.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aboh a vahte lah ah tamte nou a dinga sienglou ahi; koipou tam ganhingte a shisa thamkha khu nitah dongin asienglou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh koipou tamte lah a, ashisa in akhiehkhum khah pouma asienglou ahi dinga; singa kibawl umlebel ahiei, puonsil ahiei, savun ahiei, sai ip ahiei hinanleh akizang silkhat poupou ahileh tui a dia ding ahia, nitah donga sienglou ahi ding hi, tuachi’n ahing siengta ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh lei a kibawl umlebel tam ganhingte kiehlutna pouma khu, asunga um pouma sienglou ahi dinga, satguoi ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh khum umlebelte a nehledawn umpouma khum tuiin abuoh khah zousie a sienglou ahi dinga, tualeh dawn ding sil khat poupou khum umlebelte a kikoi zousie a sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh bangchibang sil hitaleh tam ganhing shisa luongin akhiehkhum leh anet khahna pouma abua ahi dinga, tanghou kanna khangbel ahiei, akanlumna ahiei zong satsiet ding ahia, nou adingin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hinanleh tuikhuh ahiei, tuibem ahiei, tuitampi umna tuikulte asieng dinga, hinanleh aluonguh khoikha pouma asienglou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh haichi tu dinga kikoi, tam ganhing shisa luong heisung lai pou in akhiehkhum leh abua ahi ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hinanleh tui a kidiesa haichi tunga aluong uh atuh khah leh zong nou a dingin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Tualeh asa na neh thei uh ganta zong ashisa luong koipouin athamkhah leh nitah dongin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tualeh koipou ashisa sa nekha pouma in apuonte asawp dinga, nitah dongin asienglou ahi dinga, koipou ashisa luong puo in zong a puonte a sawp dinga, nitah dongin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />“Leitunga khupboh a vah ganhing pouma sil kidahhuoi ahi ua, na neh ding uh ahi sih hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Agil a kithol leh keng li a vah pouma ahiei, ahisihleh leitunga bohvahte lah a keng tampi nei pouma na nehlou ding uh ahi, aziehpen sil kidahhuoi ahi uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Akhupboh a vah ganhing mawngmawnga na kisuhbua lou ding uh ahi; na kisuhthanghuoi louna dingun, khumte a na kisuhbua ding uh ahi sih.
  </para>
  <para style="p">
    <verse number="44" style="v" />Aziehpen kei Mangpa na Pasian uh ka hi, tuaziehin na kisusieng ding ua na sienthou ding uh ahi, aziehpen kei ka siengthou hi: leitunga khupboh a vah ganhing bangma a, na kisuhbua lou ding uh ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na Pasian uh hidinga Izipt gam a kipat a hing puidoh Mangpa khu ka hi, tuaziehin kei ka sienthou banga noute zong na sienthou ding uh ahi.”
  </para>
  <para style="p">
    <verse number="46" style="v" />Tami khu gamsate, vate tualeh tui lah a um ganhing chinteng leh leitunga khupboh a vah ganhing chinteng toh kisai a dante ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Sienglou leh sieng khenna ding leh sa nehthei chi leh neitheilou chi khenna dingin chiin, achi hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a akungah:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate kungah genin, Numei in nau apai a, tapasal anei leh ni sagi sung asienglou ahi dinga, aniin nei hunlai banga sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh ani giet ni in atep atanpieh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n amanu’n sisan apat kisiensuona dingin ni sawmthumle thum sung zia atang ding hi, akisiensuoni atun masangsie sil sieng mawngmawng atham sih dinga, mun siengthou ah zong apei sih ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hinanleh tanumei anei leh aniin neilai bangin hapta ni sung sienglou ahi dinga, tualeh amanu sisan apat akisiensuona dingin ni sawm guh leh guh sung zia atang ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Tualeh akisiensuona nite abuchin chiengin tapasal ahiei, tanumei ahiei a dingin halmang sillat a dingin belamnou kum khat a upa khat leh khelna kithoina sillat a dingin vakhu ni ahiei, palva ni ahiei, siempu kungah, kimutuona biehbuh ah ahing tawi ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khum khu aman Mangpa maiah alan dinga, amanu dingin lemna abawl pieh dinga, tuachi’n asisan pawtna apat siensuo ahita ding hi; tami pasal ahiei, numei ahiei, neinu adinga dan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh amanu’n belamnou ahing tawi zou sih leh vakhu ni ahiei, palvanou ni ahiei ahing tawi dinga, khat halmang sillat dingin adang khat pen khelna sillat dingin; tualeh siempu in amanu dingin kilemna abawl pieh dinga asiengthouta ding hi,” chiin achi hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi leh Aaron ahoupi a, akung uah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mi khat in achitunga apawm ahiei, akhem ahiei, aphol ahiei, anei a phah natna hileh kilawm atahsa vun tunga a umleh, siempu Aaron kung ahiei, siempu a pang atapate khat penpen kunga pui ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh siempu in tahsa tunga natna khu a en dinga, anatna umna mun a amul akan a, anatna pen avun sanga thuhzaw a akimu leh phah natna ahi, siempu in ama a en dinga, sienglou chi’n aphuong ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Atahsa tunga pholte akaan a hinanleh avun sanga thuhzaw a akimulou a, amulte akanlou leh siempu in natna nei mi khu nisagi sung atuom koi ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh siempu in nisagi ni in ama a endinga, anatna angai ngai ahi a, avun tunga abantawn sihleh nisagi sungma atuom koi kia ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh siempu in nisagi ni in ama a en kia dinga, anatna avun tunga abantawn sihleh siempu in ama pen asiengthou chiin aphuong ding hi, tami akhem mai mai ahia apuonte asawp dinga, a siengta ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh siempu in a etchien nua a, ahima avun tunga abantawn leh siempu aki ensah kia ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Siempu in a et a, ahima khu avun tunga ana bantawn leh siempuin asienglou chi’n a phuong dinga, tami khu phah natna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Mi’n phah natna avom leh ama khu siempu kunga pui ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Siempu in a en dinga, ngaiin avun pawm khu akan a, amul zong akan sah a ahima khu adup deldul leh,
  </para>
  <para style="p">
    <verse number="11" style="v" />Tami khu atahsa vun tunga phah kumlui um ahia, siempu in ama khu sienglou chi’n aphuong dinga, a tuom koi sih ding hi, aziehpen sienglou ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh aphah pen avun tunga azam zah a, phah natna neipa vun zousie alutang apat akengphang tan siempu etna zousie atuom suohleh;
  </para>
  <para style="p">
    <verse number="13" style="v" />Siempu in angaituo dinga, ngaiin, phah in asatung zousie atuom suoh leh siempu in natna neipa khu asieng chi’n aphuong ding hi, akaang siengta a, ama khu asiengthou ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinanleh asa adup deldul leh ama khu asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh siempu in asa dup deldul khu a en dinga, ama khu sienglou chin a phuong ding hi, aziehpen adup deldul pen asienglou ahia, tam khu phah ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahisihleh asa dup deldul khu akihena, ahing kandoh leh siempu kungah apei ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Siempu in ana en dinga, ngaiin anatna ana kan tah a ahileh siempuin natna nei mi khu asieng chi’n aphuong dinga, asieng ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Tualeh atahsa vun tunga uilut um khu ana dam a;
  </para>
  <para style="p">
    <verse number="19" style="v" />Uilut umna mun a akaang pawm ahiei akaang sansim ahiei ahing um leh siempu kunga etsah ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh siempu in a et chienga avun sanga thuhzaw a amu a, amul zong ana kantah leh siempu in ama khu asienglou chi’n aphuong ding hi. Tami khu uilut umna nua a phah hing umdoh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh siempu in a et a, ngaivawi, mul kaang ana umlou a, vun sanga athuhzawh sih a, adup maimai ahileh, siempu in nisagi atuom koi ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh avun a azamthang leh siempu in ama asienglou chi’n aphuong dinga, tami phah natna tahtah ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh adup maimai pen a umna ngai a aum den a azamthang sihleh uilut khem maimai ahi a, siempu in asiengthou chi’n a phuong ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Ahisihleh atahsa vun mei kahna hing duo doh dup ahiei, kaang ahiei ahileh;
  </para>
  <para style="p">
    <verse number="25" style="v" />Siempuin ana en dinga, ahing duo dohna mun a amul akan a, avun sanga thuhzaw a akilat leh mei kahna apat hing umdoh phah ahi, tuaziehin siempu in ama khu sienglou chi’n aphuong ding hi, tam khu phah natna ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hinanleh siempu in ana et a, aduona muna amul kaang aumlou a, avun sanga athuhzawh sih a, adup maimai ahileh siempu in ama nisagi sung atuom koi ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Siempuin anisagi niin a en kia dinga, avun lah a ana zam nasat tahleh siempu in ama asienglou chi’n aphuong dinga, tami phah natna ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh a duo pen amun ngai a auma, avun lah a azam thang sih a, adup giap ahileh, mei kahna pawn giap ahia, siempu in ama asiengthou chi’n aphuong ding hi, aziehpen tami mei kahna pawn ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Tualeh pasal ahiei, numei ahiei khat in, alutang ahiei, akhamul ahiei a natna anei leh;
  </para>
  <para style="p">
    <verse number="30" style="v" />Siempu in ahima a en dinga, avun sanga thuhzaw a, akimu a, mul eng ngat ngiungeu aum leh siempu in ama sienglou chi’n a phuong ding hi; tam khu himasunglut ahia, lutang leh khamul lah a um phah ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh siempuin himasunglut khu a et a, avun sanga thuhzaw a akimu lou a, mul vom zong a um sih leh siempuin himasunglut natna neipa khu ni sagi atuom khum ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ni sagi ni in siempu in anatna a en kia dinga, himasunglut khu azamthang lou a amul eng zong akimu sihleh, tualeh hima sunglut khu avun sanga athuhlut sihleh;
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama leh ama akiheukieu dinga, hinanleh, himasunglut umna mun aheukieu sih ding hi, tuachi’n siempu in himasunglut nei mi khu ni sagi sung atuom koi ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ni sagi ni in siempu in hima sunglut khu a en kia dinga, hima khu avun lah a ana zamthang loua, avun sanga thuhzaw a akimu sihleh, siempu in ama khu asiengin a phuong ding hi, apuonte a sawp dinga a sieng ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hinanleh ahima sunglut khu akisiensuo zou a avun lah a ana zamthang leh;
  </para>
  <para style="p">
    <verse number="36" style="v" />Siempuin a en dinga, ahimasunglut khu avun lah a ana zamthang leh siempu in amul eng asui nalai angai sih dinga, asienglou a aphuon ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hinanleh ahimasunglut khu a umna ngai a, auma amul vom apou a, himasunglut khu adam ahitahleh ama khu asieng ahi, tuachi’n siempu in asiengin aphuong ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />“Tualeh pasal ahiei, numei ahiei in asatung ua chipol ngou kilkel anei u’leh;
  </para>
  <para style="p">
    <verse number="39" style="v" />Siempuin a enchien dinga, tualeh ngaiin, atahsa vun pol pen adup ngou sim giap ahileh, vun a kipat hing piengdoh chipol maimai ahia, ama a sieng ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />“Tualeh mi alutanga pat asam apul bei leh lukieu ahia, hinanleh asieng ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mi a lutanga pat amailam samteng apul leh talkoh ahia, hinanleh asieng ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hinanleh lu kieuna mun leh tal kolna mun a hima sansim a ngou ahing umleh, alu kieu ahiei, atal kol ahiei a kipat a pha natna hing umdoh ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Siempu in a enchien dinga, ngaiin ahima pawn khu alukieu ahiei atal kol ahiei a, san sima angou tahsa vuna phah banga alat leh,
  </para>
  <para style="p">
    <verse number="44" style="v" />Ama khu aphah ahia, sienglou ahi, Siempu in amapen sienglou phah natna vei ahi chi’n aphuong ding hi, anatna khu alutanga um ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />“Tuachi’n phah natna neimi puonsilte khu bawkeh ahi dinga, asamte akaikhe sah dinga, anephu atuom dinga sienglou sienglou chiin akikou ding hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Phahin abop laisie abua ahi dinga, ama khu asienglou ahi; ama tangin ateng dinga, giehphuol pulam khu ama tenna ahi ding hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />“Phah natna hih umna Samul puon ahiei, puon malngat ahiei;
  </para>
  <para style="p">
    <verse number="48" style="v" />A kigatthaw hiin, akiphanthaw hitaleh puonmalngat ahiei, samul puon ahiei, ahisihleh savun a kibawl sil khat poupou;
  </para>
  <para style="p">
    <verse number="49" style="v" />Tualeh khum natna khu aengsim ahiei, asansim ahiei, a puon tung ahiei savun tunga atuh khah leh; puon malngat hiin samul puon hiin tualeh savun akibawl sil khat pou pou hitaleh, tua phah natna bang ahia, siempu etsah ding ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Siempu in natna khu a en dinga, tuabang natna neimi khu ni sagi sung atuom koi ding hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tualeh ni sagi niin natna hihte aen dinga, natna hih pen puonsil gatthaw ah ahiei, phanthaw ah ahiei, savun a kibawl sil pouma tunga ana ban khah leh phah natna huoisetah ahia, tami asienglou ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tualeh siempu in a en dinga, ngaiin natna hit khu puonsil akigatthaw ahiei, aki phanthaw ahiei a, ahisihleh savun akibawl sil poupou a, a kithethang sihleh;
  </para>
  <para style="p">
    <verse number="53" style="v" />“Aman khum puonsil khu akigatthaw hiin, akiphanthaw hitaleh, samulpuon hiin puon malngat hitaleh, savun a kibawl sil khat poupou hitaleh ahaltum ding ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Siempuin natna umna silte sawp dingin thu ape dinga, tuazou chiengin nisagi sung atuom koi ding hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tualeh akisawpzou chiengin siempu in natnapi a en kia dinga, ngaiin natnapi kilatdan akikhel tuom lou a, natnapi kithethang sihnanleh asienglou ahia, mei a haltum ding ahi; apulam ahiei asunglam ahiei anase thei chi ahiziehin.
  </para>
  <para style="p">
    <verse number="56" style="v" />“Tualeh siempu in a et a, tualeh ngaiin akisawp zoua natna khu adup sim maimai ahileh, puon apat ahiei savun apat ahiei, gatthaw puon apat ahiei, phanthaw apat ahiei khu abawtkeh ding hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tualeh puonsil gatthaw ahiei, phanthaw ahiei, tualeh savun a kibawl sil khat poupou ahiei a, akilat nahlai leh natna dalzah thei chi ahia, natna kilawtheina neitah pouma mei a haltum ding ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tualeh apuonsil gatthaw ahiei, phanthaw ahiei ahisihleh savun a kibawl neitah khat poupou hilezong asawpa, natnapi in anuasie leh sawp kia ding ahia,” tuachi’n asieng ding hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Tami puonsil samul hiin, puon malngat hiin, gatthaw ahiei, phanthaw ahiei, savun a kibawl neitah ahiei a, phah natna asienthou leh sienthoulou phuondohna dan khu ahi, achi hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah tam bangin agen hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Tami phah natna veite kisiensuo ni chienga bawl dan ding ahi; siempu kunga pui ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh siempu khu giephuol pulam ah apawtdoh dinga, ama ava en chien dinga, tualeh ngaiin ama phah natna apat ana dam tahleh;
  </para>
  <para style="p">
    <verse number="4" style="v" />Siempu in siensuo a um ding mi khu va hing siengthou ni leh sidar sing leh vaukhau san tualeh Hissop hing tawi dingin thu ape dinga;
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh siempuin khat pen leibel sunga, tuiluonglai tunga tha dingin thu ape ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Va hing nalai pen sidar sing, vaukhau sandup leh Hissop toh atawi dinga, lui tuiluong tunga leibel sunga va kithatsa sisan lah ah adie ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh phah natna apata siensuo ding mi tungah sagi vei athe dinga, asiengthouta chi’n aphuong dinga, tualeh va hing nalai pen gamlah ah aha ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh siensuo a um ding mi in apuonten a sawp dinga, asam zousie aheu kieu ding hi, asienthou theina dingin, tuazou chiengin giehphuol ah alut dinga, hinanleh biehbuh pulam ah ni sagi aum ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh ni sagi niin hichi ahi dinga, alu apat asam zousie leh akhamul zousie leh amitmulte aheukieu dinga, amul zousie aheukieu dinga, tualeh apuonte asawp dinga akisilsieng ding ahi, tuachi’n ahing siengthouta ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Tualeh ni giet niin belamtal nuolnabei ni leh belamnou nuolnabei kumkhat a upa khat leh ann sillat ding tangbuongnel ngingei Ephah se sawmsuo sethum sathau toh kimehkhawm leh sathau log khat atawi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n asiensuo ding siempupa’n ama leh asillat zousie kimutuona biehbuh kotbul a Mangpa mai ah akoi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh siempupan belamnou tal khat ala dinga tatkhelna sillat dingin alan dinga, tualeh sathau log khat khu sillat dingin Mangpa maiah anei ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh aman khelna kithoina sillat leh halmang sillat atha zelna mun uh, mun siengthou ah belamnou tal pen athat ding hi, khelna thoina sillat khu siempu tanvou ahi bangin khelna sillat zong siempu tanvou ahi, tami sil siengthou penpen ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Siempuin tatkhelna sillat sisan themkhat ala dinga, akisiensuo ding mi bildawn zietlam leh khutpi zietlam, tualeh kengpi zietlam ah anu ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Siempuin sathau log akipat them khat ala dinga, ama veilam khutphang sungah asung ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh siempuin akhutphang veilam a um sathau ah azietlam khutme adie dinga, tua sisan khu Mangpa mai ah sagi vei athe ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh akhut sunga sathau um nalaiteng khu siempuin siensuo ding mi bildawn leh akhutpi zietlam dawn tualeh akengpi zietlam dawn ah tatkhelna sillat sisan tungah anu ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Siempu khut sunga sathau aval um nalai teng khu siensuo ding mi lutungah asung dinga, siempuin Mangpa mai ah a ma dingin kilemna abawl pieh ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh siempuin khelna thoina sillat alan dinga asienthoulou zieh a siensah ding mi adingin kilemna abawl pieh ding hi, tuazou chiengin halmang sillat athat ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh siempuin halmang sillat leh ann sillat khu maitam tungah alan dinga, siempuin ama dingin lemna abawl pieh ding a asiengthouta ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hinanleh mi genthei ahi a, khumzapi aneizou sihleh tatkhelna sillat a dingin belamnou tal khat, tualeh tangbuong nel ngingei ephah se sawmsuo sekhat, sathau toh kimehsa ann sillat dingin sathau log khat toh atawi dinga;
  </para>
  <para style="p">
    <verse number="22" style="v" />Vakhu ni ahiei, palva ni ahiei anei zou dandan atawi dinga, khut khelna kithoina sillat dingin adang khat pen halmang sillat dingin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ni giet niin akisiensuona dingin siempu kungah kimutuona biehbuh kotpi bul ah, Mangpa mai ah ahing tawi ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh siempuin tatkhelna thoina sillat belamnou leh sathau log khat atawi dinga, tualeh sillat dingin Mangpa mai ah siempuin alan ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh tatkhelna thoina belamnou pen, athat dinga siempuin tatkhelna, thoina sisan themkhat ala dinga, akisiensuo ding mi zietlam bil dawn, azietlam khutpi dawn leh azietlam kengpi dawnte ah anu ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh siempuin sathau khu ama veilam khutphang sungah asung dinga;
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh siempuin azietlam khutme in aveilam khutphang sunga um sathau themkhat, Mangpa mai ah sagivei athe ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh siempuin akhut a sathau um khu asiensuo ding mi zietlam bildawn leh azietlam khutpi dawn tualeh azietlam kengpi dawn a tatkhelna kithoina sisan umna mun ah anu ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh siempu khut a sathau um nalai teng Mangpa mai a kilemna bawlpiehna dingin akisiensuo ding mi lutungah anu pieh ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh aman anei zou bangbang vakhu ahiei, palva nou khat ahiei alan ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anei zou bang bangin khatpen khelna thoina sillat dingin, adang khat pen halmang sillat dingin, ann sillat toh, siempuin siensuo ding mi a dingin Mangpa maiah kilemna abawl pieh ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tam khu phah natna vei, kisiensuona ding dan, anei zouloute dinga dan ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Mangpa’n Mosi leh Aaron ahoupi a, akung uah;
  </para>
  <para style="p">
    <verse number="34" style="v" />“Na luoding ua ka hing pieh Kanaan gam nalut chiengun, naluona gam ua inn khat poupou a, phah natna ka koi leh,
  </para>
  <para style="p">
    <verse number="35" style="v" />Khum inn neipa’n, Tami innah natna hileh kilawmtah um in ka thei hi, chiin siempu kungah ahing hil ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh siempu natna en dinga alut masangin innsunga um zousie abualouna dingin innpen su awng dingin siempu in thu apeding hi; tuazou chiengin siempu inn en dingin alut ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh siempuin natna a endinga, ngaivawi natnapi umna munte a eng ahiei, asan sim ahiei a, inn bang aneh kuoh a, innbang sanga akuoh thuh zawh leh;
  </para>
  <para style="p">
    <verse number="38" style="v" />Siempupa inn sunga pat kotpi ah apawtdoh dinga, tua inn khu ni sagi akhah ding hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh siempupa ni sagi niin ahing pei kia dinga, a en dinga, tualeh ngaivawi natnapi khu inn banga ana dalzah leh;
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuachi’n siempuin natnapi umna suongte ladoh dingin thu ape dinga, khopi pulam a mun sienglou khat ah apai ding uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh inn sunglam akietsieng sah dinga, akiet khietna vuite uh khopi pulama mun sienglou khat ah abo ding uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tualeh suong dang ala ding ua, tua suongte mun ah akoi ding uhi, Tualeh suong zutmatna dang ala ding ua, suongte azutmat kia ding uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />“Tualeh suong alahdoh nua a, in akiet siengsah zou a, akizutbit nua azong natnapi ahing kilat kia leh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Siempupa ava lut kia dinga, a en dinga, tualeh ngaivawi natnapi inn a ana dalzah leh phah natna hat chi ahia, tami asienglou ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tuachi’n inn khu aphetdoh dinga, asuongte, asingte leh inn zutmatna zousie tawh, khopi pulam a mun sienglou khat ah anawndoh ding uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tuathamlouin khum inn kikhah sung mawngmawnga koipou khum inn sunga lut pouma nitah dongin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh koipou khum inn a lum pouma in a puonte a sawp dinga, tualeh koipou khum inn a ann ne pouma in apuonte asawp ding ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />“Hinanleh siempu ahing pei a, a et kimvel a, ngaivawi, inn zutbit ahi nua a, natnapi ana dalzah sihleh, tua inn khu asiengthou chiin siempuin a phuong ding hi, natna adam tah ziehin.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tualeh aman inn siensuona dingin va ni sidar sing leh vaukhau sandup tualeh hissop atawi dinga;
  </para>
  <para style="p">
    <verse number="50" style="v" />Tuachi’n va khatpen leibel sungah luitui luonglai tungah athat dinga,
  </para>
  <para style="p">
    <verse number="51" style="v" />Tualeh Sidar sing leh vaukhau sandup leh va hing nalaipen ala dinga, va kithatsa sisan leh luitui luonglai ah adie ding hi, tualeh inn ah sagivei athe ding hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tualeh aman inn khu va sisan leh tui luonglai leh va hing nalai pen leh sidar sing leh vaukhau sandup in asiensuo ding hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Hinanleh va hing nalai pen khopi apat gamlah ah aleengdoh sah dinga, tuachi’n inn a dingin kilemna abawlpieh dinga, tuachi’n ahing siengthou ta ding hi.”
  </para>
  <para style="p">
    <verse number="54" style="v" />Tamkhu phah natna leh hima sunglut chinteng;
  </para>
  <para style="p">
    <verse number="55" style="v" />Puon a phah natnapi um leh inn a umte,
  </para>
  <para style="p">
    <verse number="56" style="v" />Apawmthawte akhem neite leh anai umte dinga dan ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Asienlou lai hun leh asienthou hun hilna ding, phah natna tungtanga dan ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi leh Aaron ahoupi a, akung uah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate houpi unlen, akung uah, mi koizong atahsa apat aneitah tui apawt leh, aneitah tui pawt ziehin ama asienglou ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh aneitah tui pawt sungteng abua ahia, neitah tui pawt ngitnget ahiei, apawt tawpta nanlezong, abua mawngmawng ahita a;
  </para>
  <para style="p">
    <verse number="4" style="v" />Aneitah tui pawtpa lupkhahna pouma abua ahi a, atoukhahna pouma zong a sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh koipou alupna thamkha poumain apuonte uh asawp ding ua, tuiin aki sil ding ua, nitah dong in sienglou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aneitah tui pawtpa touna tunga toukha pouma in apuonte asawp dinga, tuiin akisil dinga, nitah dongin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh aneitah tui pawtpa tahsa thamkha pouma in apuonte asawp dinga, tuiin akisil dinga nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh aneitah tui pawtpa’n mi sieng khat achil asietkhum khahleh, apuonte asawp dinga, tuiin akisil dinga, nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Neitah tui pawtpa tuonna sil khat poupou a sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh koipou aneitah apat tui pawtpa nuoia sil um khat poupou thamkha pouma nitah dongin abua ahi dinga, tualeh koipou khum silte po pouma in apuonte asawp dinga, tuiin akisil dinga, nitah dongin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh neitah tui pawtpa’n akhut tui a sillou a, atham khah pouma in apuonte asawp dinga, tuiin akisil dinga nitah dongin asienglou ahi ding.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh neitah tui pawtpa’n athamkhah leibel pouma satsiet ding ahi, singa kibawl umlebelte tui a sawp siengding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Tualeh neitah tuipawt mi khu, suhsieng ahi chiengin, akisiensuona dingin ni sagi angah nalai dinga, tualeh apuonte asawp dinga, tui luonglai in atahsa asil sieng dinga, asiengta ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nigiet niin vakhu ni ahiei, palvanou ni ahiei ahingtawi dinga, kimutuona biehbuh kotpi bul ah, Mangpa mai ah ahing pei dinga, siempu kungah apeding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh siempuin khat khu khelna sillat in alan dinga akhatpen halmang sillat in alan ding hi; tualeh siempu in aneitah tui pawt ziehin Mangpa mai ah kilemna abawlpieh ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Tualeh pasal khat poupou bawtui pawtkha aumleh tuiin akipumsil dinga, nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh amapa bawtui tuhkhahna puonsil leh savun pouma tui a sawp sieng ahi dinga, nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh numei pasal tawh alupkhawma abawtui apawt leh ani un tuiin akisil sieng ding ua, nitah dongin sienglou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Tualeh numei khat poupouin a neitah apat tuipawt anei a, atui pawt khu sisan ahileh amanu ni sagi sung tuomkoi ahi dinga, koipou amanu thamkha khu nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asienlou hun sunga amanu’n alupkhum khah pouma asienglou ahi dinga, tualeh atoukhum khah sil pouma zong asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koipou alupna thamkha in apuonte asawp sieng dinga, tuiin akisil dinga, nitah dongin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh koipou amanu’n atoukhumkhah sil khoikha pouma in apuonte asawp dinga, nitah dongin asienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh amanu lupna tung ahiei atouna tung ahiei a, sil um khat poupou thamkha pouma nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi koipouin amanu aluppi a, asienlouna abankhah leh amapa ni sagi sung abua ahi dinga, amapa lup khahna pouma sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Tualeh numei koi ahiei in nitampi sipawt aneia, aniin nei hunsung sanga sawtzaw sipawt anei leh, aniin nei buadan ngaina sunga aumbang bangin, asipawt sienlou sungteng a um dinga; sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A sipawt sung tenga alupna pouma aniin nei hunlai a abua bangin abua dinga, atouna taphot zong aniin nei bua hunlai a abua bang abua ahi ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh koizong tam silte thamkha pouma sienglou ahi dinga, apuonte asawp dinga, tuiin akisil dinga, nitah dongin sienglou ahi ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hinanleh asipawtna apat ahing sien chiengin, nisagi angah nalai dinga, tuazou chiengin asiengta ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh nigiet niin vakhu ni ahiei, palvanou ni ahiei, kimutuona biehbuh a, siempu kungah ahing tawi ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Siempu in khumte khat khu khelna kithoina sillat in alan dinga, akhat pen halmang sillat in alan ding hi; siempu in asipawtna sienlouna ziehin Mangpa maiah kilemna abawlpieh ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Tuachibangin Israel tate asienlouna ua kipat na khentuom ding uh ahi, alah ua um ka biehbuh abua sah khah chieng ua zong, asienthou lou zieh ua ashi louna dingun.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tami neitah tuipawt neite leh bawtui pawtte dinga dan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh asienlouna zieh a numei china nu leh neitah tuipawt nei numei, tualeh numei aniin nei lai a luppi zieh a siengloute zui ding zong ahi, achi hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Aaron tapa nite’n Mangpa mai a mei sienglou alat zieh ua, ashi nua un Mangpa’n Mosi ahoupi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mangpa’n Mosi kungah, “Na sanggampa Aaron kungah, ashi louna dingin, bawm tunga um hepina toupha mai a puonzah sunga mun siengthou ah hun chintengin hing lutsih heh chiin genin; aziehpen hepina toupha tungah meilum a hing kilah ding ka hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tambangin Aaron mun siengthou ah ahinglut ding hi, khelna sillat dingin bawngtal tuoi khat tualeh halmang sillat dingin belamtal khat ahing kai ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Puon malngat puon ah siengthou asil dinga, puonmalngat pheituom ateng dinga, puon malngat kawnggah in akigah dinga, puon malngat diel kop akop ding hi, tamte khu puonsil siengthou ahi; tuaziehin tui in akisil masa dinga, tuazou chiengin asil ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Israel mipi kikhawmte lah apat in khelna kithoina sillat dingin kelnou ni, tualeh halmang sillat dingin belamtal khat, ahing kai ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Tualeh Aaron in khelna kithoina sillat bawngtal khu ama a dingin alan dinga, ama ading leh a innkuonpite a dingin kilemna abawl ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh aman kelte gel akai dinga, kimutuona puonbuh kotpi bul ah Mangpa mai ah akhi ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Aaron in kelte gel tungthu ah ai asan dinga, khat Mangpa adingin, adang khat pen Azazel a, ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Aaron in a-aiphatna pen khu Mangpa ape dinga, ahing kai dinga khelna kithoina sillat dingin alan ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hinanleh Azazel adinga guot kel pen ahing in Mangpa mai ah Ama toh kilemna bawlna dingin ahing kai dinga, tuazou in Azazel a dingin gamdai ah ahing in aha ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Tualeh Aaron in ama a tuom khelna kithoina bawngtal khu ahing kai dinga, ama ding leh a innkuonpi te adingin kilemna abawl dinga, ama a tuom khelna thoina bawngtal khu athat ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n aman Mangpa mai a maitam akipat mei aam adim gimnamtui halna meibawm khat ala dinga, gimnamtui kigawt buong ngi ngei asipdim atawi dinga, puonzah sung lam ah alutpi ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Bawngtal sisan bangza ahieikhat ala dinga, akhutmete in hepina toupha suolampangah athe dinga; tualeh sisan bangza ahieikhat akhutmete in hepina toupha mai ah sagi vei athe ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Bawngtal sisan bangza ahieikhat ala dinga, akhutme te in hepina toupha suolampangah athe dinga; tualeh sisan bangza ahieikhat akhutme te in hepina toupha mai ah sagi vei athe ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Tuachi’n aman mipite adinga khelna thoina kel khu athat dinga, asisan puonzah sungah ahing tawi dinga, tuo sisan khu bawngtal sisan abawl bangin abawl dinga, khotuona toupha tung leh mai ah athe ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Israel tate sienlouna zieh leh agitlouna zieh ua akhelnate zousie uh ziehin, mun siengthoua dingin kilemna abawl ding hi. Tuamabangin assienlouna lah ua um kimutuona puonbuh adingin zong abawl ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mun siengthoua kilemna bawl dinga alut chiengin ama a ding leh a innkuonpi te ading leh Israel mipi pungkhawmte zousie a dinga, kilemna abawl zoua ahing pawtkhieh masang sie, kimutuona biehbuh sungah koima aum dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mangpa mai a um maitam lamah apawtdoh dinga; khummi adingin kilemna abawl ding hi; tualeh bawngtal sisan leh kel sisan ala dinga maitam kii te ah ataat ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh atungah akhutme in sisan sagi vei athe dinga, asusieng dinga, Israel tate sienlouna apat asusiengthou ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Tualeh aman kimutuona biehbuh leh maitam a dinga kilemna abawlzou chiengin, kel hing pen ahing kai dinga.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aaron in akhutte gel kel hing tungah angam ding a, Israel tate gitlouna zousie leh akhelna zousie zieh ua abawsietna zousiete uh kel tunga koiin atung ah aphuong dinga, guot a um mi khat in gamdai lam ah apuimang ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n kel in atungah agitlouna zousie uh mi tenlouna gamlah ah apawta dinga; aman kel khu gamdai ah ahata ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Tualeh kimutuona puonbuh sungah Aaron ahing lut dinga, mun siengthou a alut lai a apuonsil siengthoute a sut dinga, tuanah a nuasie ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh mun siengthou ah tuiin aki pumsil sieng dinga, apuonte silin ahing pawtdoh dinga, halmang sillat alan dinga, ama a ding leh mipite a dingin kilemna abawl ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh khelna sillat sathau khu maitam tungah ahal ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh gamdai a kel hing vahadohpa khu tuiin akipum sil dinga, tuazou chiengin giehphuol ah ahing lut thei ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh khel thoina sillat ding bawngtal leh khel thoina sillat ding kel sisante mun siengthou a kilemna bawlna dinga hing kitawite khu, giehphuol pulam ah akipodoh dinga, avun u’leh asa u’leh a eeh uh mei ah ahal ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh khumte halpan apuonte asawp dinga, tui in akipumsil dinga, tuazou chiengin giehphuol ah ahing lut ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Tami khu na kumtawn thugousie ding uh ahi. Ha sagina ani sawm niin, na lungsim uh na gimsah ding ua, na gamsung mi uh hiin, na lah ua um gamdang mi hitaleh, nna mawngmawng nasep lou dinguh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aziehpen khum niin Mangpa mai a na khelna zousie ua pat na sienthou theina dingun, siempu in nou a ding in kilemna ahing bawlpieh ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua khu nou a dinga khawldamna, khawlni ahi ding hi, na lungsim uh na sugim dinguh, tuakhu nou a dingin kumtawn thugousie ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh siempu aman, apa tanga siempu nasem dinga sathau anu leh akoituompen in, kilemna abawl dinga, puonmalngat puonsil siengthoute a sil ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n aman mun siengthou a dingin kilemna abawl dinga, kimutuona biehbuh a dingin kilemna abawl dinga tualeh maitam adingin leh siempute a dingin, tualeh mipi kikhawmte adingin kilemna abawl ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tami khu Israel tate khelna zousie a dinga kilemna kum khat a khatvei abawl ding ahia; kumtawn thugousie ahi ding hi a chi hi.” Tuachi’n ama’n Mangpa’n Mosi thu apieh bangin abawl hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aaron leh atapate leh Israel tate zousie houpi inlen akung uah, Tami Mangpa thupieh ahi chiin genin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Koipou Israel innkuon mikhat in bawngtal ahiei, belamnou ahiei, ahisihleh kel ahiei, giehphuol sunga ahisihleh giehphuol pulam a atha a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mangpa biehbuh mai a, Mangpa adinga, kimutuona biehbuh kotpi bul a hing tawilou pouma sisan suo a ngai ahi dinga, sisan suo ngei ahia, tuabang mi khu amite lah apat tuomkoi in a um ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tua khu Israel taten gamlah a alat uh akithoinate uh ahing tawi ua, Mangpa a dinga kimu tuona biehbuh kotpi bul a siempu kunga ahing tawi ua, Mangpa adinga kilemna sillalte a dinga alat theina dinguh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh siempuin asisan khu kimutuona biehbuh kotpi bula Mangpa maitam tungah athe dinga, athau khu Mangpa a dinga gimnam tuitah dingin ahal ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A angkawm zelna uh dawite kungah akithoi dinguh ahi nawn sih hi, tami akhang tungtawn ua dinga kumtawn thupieh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Tualeh akung uah, Israel innkuon mi ahiei, ahisihleh gamdang mi nalah ua tengte koipou in halmang sillat ahiei, kithoina sillat ahiei,
  </para>
  <para style="p">
    <verse number="9" style="v" />Mangpa kunga lat dinga kimutuona puonbuh kotpi bul a hing tawilou pouma, amite lah a pat tuomkoi in aum ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Tualeh Israel innsung mite lah ahiei ahisihleh alah ua gamdang mi umte ahiei in sisan aneh u’leh, khum sisan nemi tungah ka mai ka khausah dinga, amite lah apat satkhieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aziehpen tahsa hinna khu sisan a um ahi a, khum khu na hinna ding ua kilemna bawlna dingin maitam ah noute ka hing peta hi, aziehpen hinna dinga kilemna bawlna khu sisan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuaziehin Israel tate kungah, na lah ua koima’n sisan naneh dinguh ahisih a, gamdang mi na lah ua teng pouma in zong sisan aneh dinguh ahi sih hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Israel tate lah ahiei, ahisihleh gamdang mi na lah ua teng koipou gam avah a, sa ahiei, va ahiei, neh sieng chi amat leh asisan aluongdoh sah dinga, leivui avua ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Aziehpen tahsa zousie hinna ahia, asisan leh ahinna kibang lien ahi, tuaziehin Israelte kungah bangsa bangsa hitaleh asisan mawngmawng na nehlou dinguh ahi chiin ka gen hi, aziehpen tahsa zousie hinna khu asisan a um ahi, koi zong ane pouma satkhiehin a um ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh koipou gamsunga teng mi ahiei, gamdang mi na lah ua teng mi ahiei in gan puul sa ahiei ahisihleh gamsa in athalup sa aneh leh apuonte asawp dinga, tuiin akisil dinga, nitah dongin asienglou ahi ding hi, tuazou chiengin asiengta ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinanleh apuonte asawplou a, akipumsil sihleh amaw akipuoh ding ahi, chi’n gen in achi hi.”
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate houpi inlen akung uah, Kei Mangpa na Pasian uh Ka hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na tenna uh Izipt gam mite bawl bangin bawl sih unlen, ka hing puilutna ding Kanaan gam mite bawl bangin zong bawl sih unlen, athugousiete u’zong na zuilou dinguh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka vaihawmna dante na nit ding ua, ka dan thupiehte na zuiin na mang ding uhi, Kei Mangpa na Pasian uh Ka hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuaziehin ka thupiehte leh ka thugousiete na zui dinguh ahi, khumte min azui u’leh ahing ding uhi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Noute koima’n na sanggam kinaipi numeite uh saguohna hawhkhe dinga nava nai mawngmawng lou dinguh ahi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Napa saguohna ahiei, nanu saguohna ahiei na hawh pieh ding ahi sih, ama nanu ahia, asaguohna na hawh lou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Napa zi saguohna na hawh ding ahi sih, tami napa saguohna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na sanggamnu napa tanu ahiei, nanu tanu ahiei, na pienpi hi in, na pienpilou hitaleh asaguohna uh nahawh pieh lou ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na tapa tanu ahiei, na tanu ahiei, saguohna na hawh lou ding ahi, aziehpen amauh saguohna khu nangma saguohna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na pa zi tanu, napa hinkhieh, saguohna na hawh lou ding ahi, ama khu na sanggamnu ahia, asaguohna na hawh lou ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na pa sanggamnu saguohna na hawh ding ahisih, ama napa sanggam kinaipi ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanu sanggamnu saguohna na hawh ding ahisih, ama nanu sanggam kinaipi ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Napa sanggampa saguohna na hawh lou ding ahi, azi zong na zuan ding ahisih, ama na nuneu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na mounu saguohna na hawh ding ahi sih, hi, ama natapa zi ahi, asaguohna na hawh lou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na sanggampa zi saguohna na hawh lou ding ahi, tam khu na sanggampa saguohna ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Numei khat atanu toh asaguohna uh na hawh lou ding ahi, atapa tanu ahiei ahisihleh atanu tanu ahiei zong a saguohna hawh dinga na puilou ding ahi, amanu khu tanau kinaipi ahi ua, khum banga bawl khu gitlouna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na zi lungkhamna dingin asanggamnu saguohna dingin napui ding ahisih a, na zi dam sungin na neikop ding ahi sih hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Tualeh numei khat aniin nei hun sunga asaguohna dinga nava zotlou ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuathamlouin nangma kisubua dingin na innvengpa zi toh na lumkhawm ding ahisih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Molek mei ah na hahlesuonte koima na peisuoh sah ding ahi sih hi, na Pasian min zong nasuh thanghuoi ding ahi sih hi; kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Numei toh kipawl banga pasal toh na kipawl lou ding ahi, tuakhu sil kidahhuoi ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ki suhbuana dingin ganta mawngmawng na luppi ding ahi sih hi, tualeh numei mawng mawng zong kipawlsah dingin ganta mai a adin ding ahi sih hi, tami gitlouna tungtuong ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Tam silte khat poupou ah nouma leh nouma kisubua sih un, aziehpen tamsilte in, na masang ua kana nawdoh namte ana kisuthanghuoi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tam silte ziehin gam suhbua in aumta hi, tuabanga a gitlouna uh atung uah ka tung sah a, tualeh gam in asunga tengte alawkhe siengta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuaziehin nouten ka thupiehte leh ka thugousiete na zui ding ua, tam sil kidahhuoite a na kisuhbua lou dinguh ahi, na nam sung ua mi mawngmawng hiin, na lah ua um gamdang mi in zong.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aziehpen tam sil kidahhuoite gam sunga umten ana bawl ua, gam sung ana thanghuoi sahta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na masang ua um namte aluohkhieh ma banga nasuh bua ua gam in ahing luohkhiet louna dingin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Koi zong tam sil kidahhuoite khat poupou bawl pouma amite lah ua pat satkhieh in a um ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuaziehin nouten vang na masang ua ana bawl uh tam tawndan kidahhuoite na bawllouna ding u’leh tamte a na kisuhbua louna dingun ka thugousiete na zui ding uh ahi, Kei khu Mangpa na Pasian uh Ka hi,” achi hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate mipi kikhawmte zousie houpi inlen akung uah, Na sienthou dinguh ahi, Kei Mangpa na Pasian uh ka siengthou hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Michin in na nu leh na pate uh zaudan na siem ding ua, ka khawl nite na nit dinguh ahi, Kei Mangpa na Pasian uh Ka hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Milimte lam ah kihei sih unlen, nou a dingin pasiente bawlthu sih un, Kei Mangpa na Pasian uh Ka hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Mangpa kunga kilemna kithoina sillat na lat ding u’leh nouma kiphal na a nalat dinguh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tami na lat ni mama u’leh a zingni a na neh paiding uh ahi; ani thumni donga um nalaite mei a haltum ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ani thum ni a neh ahi pouma leh sil kidahhuoi ahia, pom pieh ahi sih ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaziehin koizong ane poumain Mangpa sil siengthou asuh bua zieh in agitlouna maw akipuoh dinga, amite lah a pat tuom koi ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tualeh nagam ua bu na at chiengun, na lou gei ningkawi donga na at sieng lou dinguh ahi, abu sangte zong na khop sienglou dinguh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na grep huon ua asangte na sui dinguh ahisih a, na grep ga tuol kie zong na tom ding ahi sih hi, tagate leh mikhuolte dinga na nuasie dinguh ahi; Kei Mangpa na Pasian uh Ka hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Na guhtat dinguh ahi sih a, dihloutah a na bawl ding uh zong ahi sih, tualeh zuou na kihiltuo dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dihloutaha ka min a na kichiem ding uh ahi sih, na Pasian min u’zong thanghuoi taha na gen lou ding uh ahi; Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Na innvengte na solbawl ding ahi sih a, na guhpieh ding zong ahi sih hi, kilaw mi thaman zankhuo a azing mawng donga na kep ding ahisih hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bilbingte na hamsiet ding ahi sih a, mittote lampi a’zong akipalpuana ding na koipieh lou ding ahi, na Pasian na giin ding ahi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Vaihawmna ah dihlou tah a na hawmding ahisih, mizawngte na khentuom lou ding, mi thupite zong na zatat tuomlou ding ahi, hinanleh dihtatna in na innvengte vai na hawmpieh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na mite lah a thuse gen a na vah kawi ding ahi sih a, na innvengpa hinna thu a’zong ahiloulam a na pan ding ahi sih, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Na lungsim a na sanggampa na muda ding ahisih a, na innvengte phawh kawma na hil ngeingei ding ahi, ama zieh a khelna na puahlou na dingin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Phuba na lah ding ahisih a, na chipite hahlesuonte huotna lungtang na pai ding ahi sih hi; Nangma na ki it bangin na innvengte na it ding ahi zaw hi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Ka thupiehte na zui dinguh ahi, Na gantate ganta chi tuom tuom tawh chihah na nei sah louding ahi, na lou a zong haichi tuom tuom na chiin lou ding ahi, vaukhau leh samul kigankhawm puon zong na silding ahi sih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Koi zong suoh numei, pasal nei dinga kikhamlai, tatdoh hinailou, zalenna zong pieh hinailou toh lum khawm khu vuoh ahi dinga, tha ding vang ahisih hi, amanu zalen ahilou ziehin,
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh amapa’n atatkhelna kithoina sillat dingin, kimutuona biehbuh kotpi bul ah Mangpa kunga lat dingin belamtal khat ahing kai ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh siempu in tatkhelna kithoina belamtal in atatkhelnate ziehin Mangpa maiah kilemna abawl pieh dinga, atatkhelna khu ngaidam ahita ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Tualeh gam na valuo ua, neh ding theikung chi chinteng na suon chiengun, kum thum sung nou adinga sienglou ahi dinga, aga na nehlou ding uh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hinanleh akum li na ahvang aga zousie Mangpa phatna dingin asiengthou siengta ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh akum nga na ah nou a dinga, aga tam sem theina dingin, na neta ding uhi; Kei Mangpa na Pasian uh ka hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“A sisan nangawn toh bangma na neh ding uh ahisih a, mitphieldawi leh aisan zong na chiin dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na humsam ua kipat in nalu uh akimkot a na heu dinguh ahisih a, na khamul gei tuoh zong na heu dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mishi ziehin na satung uh na at pop ding uh ahisih a, na satung u’zong na gelpawl dinguh ahi tuom sih hi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Na tanu kizua dingin pe sinlen, gam sung khu kizuana ahing suoh kha ding a, gam sung gitlouna in adim kha ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nouten ka khawl nite na nit ding ua, Ka munsiengthou na zatat dinguh ahi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Na kibuasah louna dingun aisan siemte leh dawithu siemte mawngmawng zuon sih un, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Tehsie samkangte mai ah na dingdoh dinga, Putehte na zatat ding ahi; Na Pasian giindan na siem ding ahi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Tualeh na gamsunga gamdang mi na tenkhawmpi a umleh dihlou taha na bawl lou ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hinanleh gamdang mi na lah ua tengte khu, na lah ua pieng bang ahi ding ua, nouma banga na it dinguh ahi, aziehpen noute zong Izipt gam ah mikhuol nana hi uhi; Kei Mangpa na Pasian uh Ka hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Thukhennate ah, tena chiengte ah, agihdan tenate ah, tualeh atamlam tenate ah, dihtatlou taha na bawl dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Buhna dihtah, gihna dihtah, ephah dihtah leh hin dihtah, na nei dinguh ahi, Kei Mangpa na Pasian uh Izipt gam a kipata noute hing puidohpa ka hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuaziehin ka thupieh zousiete leh ka vaihawmnate zousie na pom ding ua, tualeh na zui ding uh ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate kungah genkia inlen, koipou Israel tate lah a mi ahiei, Israel gam a teng gamdang mi ahiei in zong atate Molek kunga pe pouma thalup ngei ngei ding ahi; gamsung miten ama khu suonga a selup dinguh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khumpa tungah ka mai ka khausah dinga, amite lah a pat ka satkhe ding hi, aman ka munsiengthou suthanghuoi ding leh ka min siengthou suthanghuoi dinga, ata Molek kunga apieh ziehin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh gamsung miten bangchi ahiei a, atate uh Molek kunga apieh uh, akimumaw bawl ua atha sih u’leh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Khumpa tung leh a innkuonpite tungah ka mai ka khausah dinga, ama leh anua a Molek toh angkawm dinga kizua zousiete amite lah a kipat ka satkhe ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Tualeh a angkawmpi ding ua, aisan siemte leh dawithu siemte kung zuon mite tungah ka mai ka gum sah dinga, amite lah a kipat ka satkhe ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuaziehin kisusiengthou unlen, siengthou in um un, Kei Mangpa na Pasian uh Ka hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka thupiehte na pom ding ua, na zui dinguh ahi, Kei khu noute hing susiengthoupa, Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koipou apa ahiei, anu ahiei, hamselaw khum khu thalup teitei ding ahi. Aman anu leh pa hamsie alaw khum ahia, asisan maw atungah aum ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Midang zi toh angkawm a, a innvengpa zi toh angkawm mi khu, angkawmpa leh angkawmnu thalup teitei ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Apa zi toh lumkhawm mi khu apa saguohna hawhpieh ahia, ani ua thalup teitei ding ahi uhi, asisan maw uh atung uah aum ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi’n amounu aluppi leh ani ua thalup ding ahi uh, gitlouna tung tuong bawl ahi ua, asisan maw uh atung uah aum ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi khat in numei aluppi banga pasal aluppi leh ani un sil kidahhuoi bawl ahi ua, thalup teitei ding ahi, asisan maw uh atung uah aum ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pasal khat in nuta zi a aneikop leh gitlouna ahia, amaute mei a hallup ahi ding uhi, na lah ua gitlouna a um nawnlouna dingin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh mi khat in ganta aluppi leh thalup teitei ding ahia, ganta zong thalup ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Numei khat in ki pawlpi dinga ganta ava nai a akibawlsah leh anumei leh aganta na thalup ding uh ahi; amaute thalup teitei ding ahi ua, asisan maw uh atung uah a um ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Tualeh mi’n asanggamnu, apa tanu ahiei, anu tanu ahiei, akitenpi a, amanu saguohna amu a, amanu’n zong amapa saguohna amu leh tami silgiloutah ahia, amite uh mitmu ah, satkhiehin aum ding uhi, asanggamnu saguohna hawhpieh ahia, agitloutatna apo ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh mi’n numei aniin nei laitah a, aluppi a, asaguohna ahawh pieh leh asi pawtna hawhkhiet pieh ahia, tualeh amanu’n zong asi pawtna hohkhie ahi a, ani un amite lah ua pat satkhieh ahi ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na nu sanggamnu ahiei, na pa sanggamnu ahiei, saguohna zong na hawh pieh ding ahisih a, asanggam kinaipi saguohna hawh pieh ahia, agitlouna uh maw akipuoh dinguh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi’n apaneu zi aluppi leh apaneu saguohna hawhpieh ahia; akhelna maw uh akipuoh ding ua, ta neilou in ashi ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi’n asanggampa zi akitenpi leh sil siengloutah ahi, asanggampa saguohna hawh pieh ahia, taneilouin a um ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Tuaziehin ka thupiehte zousie leh ka thugousiete zousie na zui ding ua, na bawl ding uhi, teng dinga ka hing puilutna gamin ahing setkhieh louna dingin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na masang ua ka nawdoh namte umdan in na um ding uh ahisih hi, aziehpen amauten tam silte abawl ua, tuaziehin amaute ka kidahta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hinanleh na kung ua ka gentah bangin, agam uh nawitui leh khuoizu luonna gam na luo ding un ka hing peding hi; Kei Mangpa na Pasian uh, namdangte akipat noute hing khentuompa khu ka hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuaziehin nouten gamsa siengleh sienglou, va siengleh sienglou, na khen tuom dinguh ahi; sa ahiei, va ahiei, ahisihleh leitunga bohvah ganhingte, nou apat asienglou chia ka khentuom sate a na hinna uh kidahhuoi a na kibawllou dinguh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Noute na sienthou ding uh ahi, aziehpen Kei Mangpa na Pasian uh Ka siengthou a, midangte apat noute keima adingin ka hing khentuom ta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Pasal hiin, numei hitaleh, aisan siem leh dawithu siem mi khu thalup teitei ding ahi, suongin aseplum ding ua, asisan maw uh atung uah aum ding hi ka chita hi,” chiin achi hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a, “Aaron tapate, siempute kungah thu gen inlen, akung uah, amite lah a koima mishi zieha akisuhbua lou ding uh ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hinanleh atanau kinaipi mama, anu, apa, atapa leh atanu, tualeh asanggampa ziehin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh asanggamnu nungah siengthou akunga um pasal nei nailou ziehin akisubua thei ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh zileh ta a, kineina thu a, akinaipi pouma shiluong uop ziehin akisubua in akisuthanghuoi ding ahi sih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Siempu koiman alu aheu kieu dinguh ahi sih a, akhamul gei tuoh uh zong aheu dinguh ahisih a, tualeh atahsa tung uh a at pop ding u’zong ahi sih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A Pasian a dingin mi siengthou ahi ding ua, a Pasian uh min asuthanghuoi sih ding uhi, Pasian kunga mei a sillatte lantu leh Pasian tanghou siengthou lantu ahizieh un, asienthou dinguh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Numei kizua ahiei, kisuthanghuoisa ahiei, ahisihleh apasal in akhulsa ahiei, akitenpi dinguh ahisih hi, aziehpen siempute khu a Pasian ua dingin mi siengthou ahi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaziehin ama khu na suhsiengthou ding ahi, aman na Pasian tanghou alan zel ahi, nanga dingin mi siengthou ahi ding hi, aziehpen kei Mangpa noute hing susiengthoupa khu ka siengthou hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh siempu koipou tanu kizua a, akisuhthanghuoi leh apa suthanghuoi ahia, mei a hallup ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“A unaute lah a siempu lienpen, alutunga sathau kinusa, siempu puon sil dinga namdetsa in asam akaisah nel nul ding ahisih a, apuon zong abawtkeh ding ahisih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mishi luong umna a alut ding ahisih a, anu ahiei, apa ahiei, luong zieh a zong akisuhbua ding ahisih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Munsiengthou apawtsan ding ahisih a, a Pasian munsiengthou zong a suhthanghuoi ding ahisih hi, aziehpen a Pasian siensuona sathau kinu khu alutung ah a um hi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh zi dingin nungah siengthou akitenpi ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meithai ahiei akikhulsa ahiei, suhthanghuoisa ahiei, tualeh numei kizua ahiei, akitenpi ding ahisih a, hinanleh achipite lah a nungah siengthou zi in anei ding ahizaw hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh achipite lah a, thanghuoi tah a, hahlesuon anei ding ahi sih hi, aziehpen Kei Mangpa’n ama Ka suhsiengthou ahita hi.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Aaron kungah, na khang tungtawn ua na hahlesuonte lah a koipou suonlam ding nei aum leh a Pasian tanghou lan dingin hing zuon sih heh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh koipou atahsa tunga bukimlouna nei mitto ahiei, kengbai ahiei, nahkawpheng ahiei, khut leh keng sau sengte ahiei;
  </para>
  <para style="p">
    <verse number="19" style="v" />khut tawng kengtawngte ahiei;
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngumbaw ahiei, mi neu ahiei, sietna nei ahiei leh chitung kehna nei leh chithah veite leh chiltang kehte leh;
  </para>
  <para style="p">
    <verse number="21" style="v" />Siempu Aaron hahlesuonte lah a, atahsa tunga nuolna nei poumain, Mangpa adinga mei a sillat lan dinga ka kung nai a ahing peilou ding uh ahi, mitmawna nei ahi ua, Pasian tanghou lan dingin ka kung nai a ahing pei vawtlou ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A Pasian in tanghou ane ding a asiengthou pen leh asiengthou zong ani in ane thei ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh amitmawna ziehin puonzah sunglama lut in maitam azuon thei sih ding hi, ka mun siengthoute asuthanghuoi kha ding hi; Kei Mangpa’n amaute susiengthoupa ka hi,” chi’n gen in achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Mosi in tam thu Aaron leh atapate leh Israel tate zousie kungah ahilta hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aaron leh atapate kungah, Israel tate sil siengthou kei dinga alatte u’leh, ka min siengthou asuhthanghuoi louna dingun, ka kunga ahing lat uh silte lah a kituomkoi dingin thu genin, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kung uah gen in; Na khang tungtawn ua, nahah nasuonte zousie lah ua, koipou atunga sienlouna nei a, Israel taten Mangpa dinga alat uh sil siengthoute kung nai a hing pei pouma, Kei a pat satkhiehin a um ding ahi; Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aaron hahlesuonte lah a phah ahiei, neitah tui pawt ahiei pouma asienthou masangsie ua sil siengthoute anehlou ding uh ahi, tualeh mishi suhbua ahiei, abawtui pawt ahiei pouma,
  </para>
  <para style="p">
    <verse number="5" style="v" />a awm a kithol a bohvah ganhing thamkhah zieh a bua pouma leh ama akipata sil pawt bua theina bang ahiei leh sienthou louna khat poupou thamkha pouma;
  </para>
  <para style="p">
    <verse number="6" style="v" />Khumbang thamkha mi khu nitah dongin sienglou ahi dinga, atahsa tui a asil sieng sihleh, sil kilan siengthoute aneh lou ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh ni atum chiengin asiengthouta dinga, tuazou chiengin sil kilan siengthoute ane theita ding hi, aneh ding ahi ziehin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi ngaina a shi sa ahiei, gamsa in akeilia sa ne in ama leh ama kisuhbuana dingin ane ding ahisih hi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuaziehin amauten ka thugousiete azui ding uh ahi, tuachilouin vang akisuhthanghuoina uah akhelna maw uh apo ding ua ashilaw kha ding uhi, Kei Mangpa amaute susiengthoupa khu Ka hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Gamdang mi mawngmawngin sil siengthou aneh ding uh ahi sih hi, siempu kunga nasem ahiei, a inna a zin te ahiei in zong sil siengthou aneh ding uh ahi sih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh siempuin koi ahiei mi khat a sum a alei miin ane thei dinga, tualeh a inn a piengten zong ane thei ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Siempu tanu in gamdang mi akitenpi leh silsiengthou sillat ane thei sih ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh siempu tanu meithai ahiei, akikhul ahiei, ta neilou ahiei ahi a, apa inn a ahing phungkia kialeh anungah lai bangin apa neh bangbang ane thei ding hi, hinanleh pulam mi mawngmawngin aneh louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh mi koi ahiei in thei masa loua, sillat siengthou ava nehkhah leh senga suo sekhat abelap dinga, tuakhu sil siengthou tawh siempu kungah ava pekia ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amauten Israel tate sil siengthou Mangpa kunga alatte uh athanhuoi sah lou ding uh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahisihleh asil siengthou latte uh ne in bawsietna maw apuoh dinguh aphal ding uh a hisih hi, Kei Mangpa amaute susiengthoupa khu Ka hi, chi’n gen in achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Aaron leh atapate leh Israel tate zousie houpi inlen, akung uah, Israel innkuonte lah ahiei, Israel gamsunga um gamdang mi koipouin halmang sillat dinga, Mangpa kunga alat dinguh, athuchiemna uh ahiei, akiphalna silpieh lan pouma in;
  </para>
  <para style="p">
    <verse number="19" style="v" />Nouma kiphalna bangin, ganhon lah a kipat atal nuolnabei, belamtal ahiei keltal ahiei na lan ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh nuolna um pouma lan sih un, ahing kipom pieh sih ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh koipou athuchiem suhtangtunna ding ahiei, akiphalna banga sillat ding ahiei, lemna kithoina sillat, ganhon lah a, belam ahiei, kel ahiei, lan pouma in pomtah ahi theina dingin ahoi bukim ahi ding a, nuolna bei ahi ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amittaw ahiei, akengbai ahiei, hima nei ahiei, chipaat vei ahiei te khu Mangpa kunga na lat dinguh ahisih a, Mangpa adinga maitam tunga mei a sillat azong na latlou dinguh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bawngtal ahiei, belamnou ahiei, asa meeng sautuom ahiei, tom tuom ahiei khu kiphalna sillat dingin na lan thei ding ua, hinanleh thuchiemna sillat dingin vang akipom sih ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ganta achiltang sidup ahiei, kisukeh ahiei, ahisih leh achiltang liem kha pouma Mangpa kunga na lat ding uh ahisih hi, na gamsung uah khum bang mawngmawng kithoina dinga nalat ding u’zong ahisih hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh gamdang mi khut a kipat a la in tamte lah a mawngmawng na Pasian tanghou dingin na lan ding uh ahisih hi, aziehpen ama uah sietna leh nuolna banna a um a, pom pieh thei ahisih ding uhi, chi’n gen in achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Bawngtal ahiei, belam ahiei, kel ahiei, apien chiengin api kungah ni sagi sung aum ding ahi, tualeh anigietni akipat khum nua chiengin Mangpa dinga mei a sillat dingin pom pieh thei ahi ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bawngpi ahiei, belampi ahiei, anoutoh ni khat in na goukhawm ding uh ahisih hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mangpa kunga kipah thugenna kithoina a na lat chiengun nouma kiphalna banga na lat dinguh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khummi ni mama a na neh bei dinguh ahi a, azingni dongin, bangma na um sah sih ding uhi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Tuaziehin ka thupiehte na zui ding ua, na bawl ding uh ahi, Kei Mangpa khu Ka hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka min siengthou na suthanghuoi dinguh ahi sih a, hinanleh Israel tate lah a pahtawi a ka um ding ahi, Kei noute hing pahtawipa khu Ka hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Izipt gam a kipata na Pasian uh hidinga noute hing puidohpa Mangpa khu Ka hi, Kei Mangpa khu Ka hi, chi in,” achi hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate kungah, Mangpa pawi hunbisete kikhopna siengthoua man dinga na phuon dinguh pawite khu tamte ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Niguh sung nna nasep ding uh ahia, hinanleh ni sagi ni pen khawldamna ni siengthou, kikhopna ni siengthou ahi; tam ni in nna mawngmawng na sepding uh ahisih, tam nipen na tenna mun zousie uah Mangpa khawlni ahi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Tamte khu Mangpa pawi, kikhopna siengthou hunbi nei a na phuondoh dingte uh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ha masapen ni sawm leh li ni nitah khu Mangpa peikan pawi ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh tuami ha ani sawm leh nga ni khu tanghou tolsawlou pawi ahia, ni sagi sung tanghou tolsawlou na neh ding uh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ani khat ni in kikhopna siengthou na bawl ding ua, nna mawngmawng na sep ding uh ahisih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hinanleh mei a sillat Mangpa kungah ni sagi sung nalan ding ua, ani sagi ni khu kikhopna siengthou ahi ding hi; nna mawngmawng nasep ding uh ahisih chi’n gen in” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Mangpa’n Mosi ahoupia,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel tate houpi inlen akung uah, ka hing pieh ding gam a nava tun ua, khum gam a bute na laah chiengun, na bu tha gamasate uh buphai khat siempu kunga na hing tawi ding uh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noute pom na hitheina dingun, noute thahengin siempu in buphai khu, Mangpa mai ah avei dinga, khawlni zing niin, siempuin tuakhu avei ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh khum buphai na vei ni un belamnou atal, nuolnabei, kumkhat a upa halmang sillat in Mangpa kungah na lan ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh khum ann sillat khu, tangbuong neel ngi ngei ephah se sawm suo se ni, sathau toh kihalsa Mangpa dinga gimnamtuitah mei a sillat ahi dinga; tualeh dawn sillat khu uoin nou khat se li suo sekhat ahi ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na Pasian ua dinga sillat na hing tawi masang un tanghouin ahiei, akan in ahiei, avui in ahiei a zong, naneh dinguh ahisih hi, tami na umna mun zousie ua, na khang tungtawn ua, kumtawna dinga thugousie ahi ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Tualeh khawlni zingni vei sillat buphai na hing tawi ni ua kipat in na sim ding ua, khawlni sagivei aching ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh khawlni sagi veina zing mawng akipat ni sawmnga nasim ding ua, Mangpa kungah ann tha sillat na lan ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tenna mun ua pat in ephah se sawmsuo seni a kibawl tanghou beu ni vei dingin na hing tawi ding uhi, tuate khu tangbuong neel a bawl ahi dinga, tol kisaw a kanthaw ahi ding hi, tuate khu Mangpa a dinga gamasate ahi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh tanghou lat toh kituoh in, belamnou nuolnabei kumkhat a upa sagi leh bawngtal guol khat tualeh belamtal ni na lan ding uhi; tuate khu a ann sillat u’leh adawn sillatte u’tawh Mangpa dinga halmang sillat, Mangpa dinga gimnamtuitah mei a sillat ahi ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuazou chiengin khelna sillat ding kelnou khat tualeh lemna kithoina sillat dingin kum khat a upa belamnou ni na lan ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh siempuin tuate khu ga masa tanghou toh Mangpa mai a vei sillat dingin belamnou nite toh avei dinga, siempu tanvou, Mangpa a dinga siengthou ahi ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh khumi ni main na phuong ding ua, khawmpi siengthou ahi ding hi, nna mawngmawng na sep ding uh ahisih hi, tuapen na khangtung tawn ua, na umna mun zousie ua, kumtawn a dinga thupieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Tualeh na lou ua bu na lah hun chiengun, na loupam gei ua nangawn zong na lah sieng ding ahisih a, na busang zong na tom sieng ding ahi sih hi, mi gentheite leh gamdang mite dingin na nua sie ding uhi, kei Mangpa na Pasian uh Ka hi,” chiin genin achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Israel tate houpi inlen, akung uah, Ha sagina, khummi ha ani khat ni nou a dingin khawldamna khawlni ahi ding, pengkul mut a theizingna khawmpi siengthou ahi ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nna mawngmawng na sep dinguh ahi sih a, Mangpa dinga mei a sillat na lan ding uhi” chiin achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Ha sagina ni sawmni khu Lemnani ahi ding hi, tami khu noute adinga khawmpi siengthou ahi dinga; na lungsimte uh na gimsah ding ua, Mangpa kungah mei a sillatte na lan ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khumi niin nna mawngmawng nasep ding uh ahisih hi; aziehpen khum ni khu Mangpa na Pasian uh mai a kilemna bawlna dinga, kilemna ni ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Koi hinanleh khumi ni a lungsim gimsahlou khu amite lah a pat satkhiehin aum ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh koi hinanleh khummi ni a nna khat poupou sem a umleh amite lah apat ka sumang ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bangma mawngmawng nasep dinguh ahisih a, na khang tungtawn ua, na tenna zousie ua, khantawn dan thupieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tami ni khu nou a dingin tawldamna khawlni ahi dinga, na lungsimte uh na suhgim ding uh ahi, khummi ha ni kuo ni nitahlam, apat, nitah lam kia dongin khawlni in na mang ding uhi.”
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Israel tate houpi inlen akung uah, Tam ha sagina ni sawm leni khu Mangpa a dinga ni sagi sung Biehbuh pawi ahi ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ani khat ni khu kikhopna siengthou ahi dinga, nna mawngmawng na sep dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ni sagi sungteng mei a sillat Mangpa kungah na lan ding uhi; Ani giet ni in kikhopna siengthou ahi dinga; mei a sillat Mangpa kungah na lan ding uhi; Tami kikhopna siengthou ahia, nna mawngmawng na seplou dinguh ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Tamte khu ahi Mangpa pawi hunbi sesate, Mangpa a dinga mei a sillatte, halmang sillalte, ann sillatte, dawn sillatte, ani hunbise chiet ua lan dinga kikhopna siengthou a na man dingte uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mangpa khawlnite, na silpiehte uh, na thuchiemte uh, na kiphalna dungzui ua nasilpiehte uh, Mangpa kunga na piehte uh chilou in ah.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Tualeh ha sagina ni sawm leh nga niin, gamsunga haichi ga na lahkhawm zou chiengun, Mangpa a dingin ni sagi sung pawi na mang ding uhi. Ni khatni khu khawlni ahi dinga, ni gietni zong khawlni ahi ding hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tualeh ni khatni in singkung kilawm mama gate, tum sing bawhte, singna bawhphate, lui a muisum bawhte na tawi ding ua, Mangpa na Pasian uh masangah nuomsa tahin ni sagi sung na um ding uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tami pawi khu kumchin in Mangpa dingin ni sagi sung naman dinguh ahi. Tami na khang tungtawn ua khantawn a na dan zui dinguh ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ni sagi sung sawlbuh ah na um ding ua, Israel mi a pieng pouma sawlbuh ah a um ding uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Izipt gam a kipat a amaute ka puidoh laiin, Israel tate sawl buh ah ka umsah hi, chi atheina dingun, Keima Mangpa na Pasian uh ka hi, chiin” achi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tuachi’n Mosi in Israel tate kungah, Mangpa Pawi hunbisete apuong dohta hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate kungah olive thau kisuh chiimtah, meivah kuonsah ngitngetna dingin, na kunga hing tawi dingin thu pie in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kimutuona biehbuh a theipina puonzah pulamah, nitahlam akipat zingmawng donga dingin, Mangpa mai ah Aaron in akoi zel dinga, tuakhu na khang tungtawn ua dinga khantawn thupieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman thaumei khu sana siengset a kibawl thaumei tunna tungah akoi ngitnget ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Tualeh tangbuong neel ngingei na la dinga, tanghou sawmle ni na bawl dinga, tanghou khat ah ephah khat sesawm suo seni ahi ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuate khu Mangpa mai a dawkan siengthou tungah guol niin, guol khat ah guh tuoh tuoh in na chieng ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tanghou guolni tegel tungah gimnamtui siengthoutah na koi dinga, theizingna Mangpa a dinga mei a sillat banga tanghou tunga aum theina dingin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khawlni chinin Mangpa mai ah akoi zel ding ahi; kumtawn thuhun Israel tate ading ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tami Aaron leh atapate tanvou ahi dinga, munsiengthou ah ane ding uhi, aziehpen tami kumtawn thugousie dinga, Mangpa a dinga mei a sillatte lah a ama dinga sil siengthou pen ahi,” chiin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Israel numei tapa, apa Izipt mi khat, Israel tate lah ah ava pawtdoh a, tam Israel numei tapa leh Israel mi khat giephuol sungah akihauta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel numei tapa in Mangpa min gensie in awsie alawkhum hi. Tuachi’n ama khu Mosi kungah ahing pui ua (anu min khu Shelomith Dan nam ami Debri tanu ahi.)
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Mangpa akipat theisahna thu ngahnain ama khu suongkul ah akhumta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Awse suopa khu giehphuol pulam ah hing puidoh unlen, a awse suo za zousie in atungah khut ngam uhenlen, mipi kikhawmte zousien suongin sep u’heh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel tate houpi inlen, akung uah, koipou a Pasian awsie lawkhum pouma’n akhelna maw akipuoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Mangpa min gense pouma pellou a thalia ding ahi, mipi kikhawmte zousie in suonga aselia ngeingei dinguh ahi, gamdang mi hiin gamsunga pieng hitaleh, Mangpa min agensiet leh thalia ahiding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koipou mi that pouma pellou a thalia ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ganta that pouma in asankia ding ahi, ganta taangin ganta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Min ainnvengpa amel sietsah leh, aman abawl bangin ama tungah zong akibawlding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gutawng taangin gutawng, mit taangin mit, ha taangin ha, mi amelsiet sah bangbanga ama zong bawl ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koizong ganta thatin asan ding ahi, tuolthat pouma thalia ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Gamdang mite ading leh tamgam mite adingin dan kibang na nei dinguh ahi. Aziehpen Kei Mangpa na Pasian uh Ka hi” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n Mosi in Israel tate ahoupi a, awse suopa khu giehphuol pulam ah a puidoh ua, suongin asepta uhi. Mangpa’n agen bangin Israel taten abawlta uhi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Sinai tangah Mosi ahoupi a.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate houpi inlen akung uah, na kung ua ka hing pieh gam na hing tunhun chiengun, gamin Mangpa a dingin, khawl ni amang ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kum guh sung na lou uah haichi na chiing ding ua, kum guh sung na grephuon uh na hou sieng ding ua, agate na la ding uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh akum sagi kum khu gam khawldam khinkhienna kum, Mangpa a dinga khawldamna kum ahi ding hi, na lou uah haichi na chiing sih ding ua, na grephuon u’zong na housieng sih ding uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama thua a hing pou na bute na at lou ding ahi, na hawlou na grep huon a grep ga zong na lawlou ding ahi, aziehpen gam khawldam kum ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gam khawldam kuma piengte khu na ann neh dinguh ahi dinga, nangleh na suohpa dingin, na suohnu leh na suoh kilaw mi adingin, tualeh na kung ua um gamdang mi adingin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na ganhonte ading leh na gam sunga um gantate dingin, apieng zousie aneh ding uh ann ahi ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Tualeh khawldamna kum, kum sagi na simdinga, kum sagi mun sagi khawldam kum, kum sagite sung khu kum sawmli leh kuo ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n aha sagina ani sawm niin Jubili pengkul na mutsah dinga, Kilemna niin na gamsung pumpi uah pengkul na mut ging sah ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh kum sawmngana kum khu na susiengthou ding ua; gamsung pumpia teng zousiete adingin Jalenna thu na phuong ding uhi. Noute adingin Jubili ahi dinga, mi chin in aneilelamte atang kia ding ua, michin a innkuonpite kungah akile kia ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuami kum sawmngana khu nou a dingin Jubili ahi dinga, bangma na tu sih ding ua, ama thu a hing poudohte zong na at sih ding uhi; na hawlou uh grep huon a grep gate zong na lousih ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aziehpen Jubili ahia, nou a dingin asiengthou ahi dinga, na lou ua haichi gate na ne ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Tam Jubili kum in michin in aneilelam chiet uh anei kia ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh na innvengte kunga bang ahiei silkhat na zua a, ahisihleh na innveng khuta kipat bang ahiei sil khat na lei leh khat leh khat na kisol tuolou ding uh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jubili nua a kum phaza dungzuiin na innveng sil na lei dinga, bulebal pieng dan dungzuiin na kungah azua ding uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kum tamdan dungzuiin aman na khangsah ding ua, tualeh akum tawmdan dungzuiin aman na ngiemsah ding uhi; aziehpen haichi ga kum tam dan dungzui a na kunga zua ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuaziehin khat leh khat na kisol dinguh ahi sih hi; na Pasian giindan na siem dinguh ahi zawhi; Kei Mangpa na Pasian uh ka hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Tuachi’n ka thupiehte na zui ding ua, ka vaihawmnate na pom dinguh ahi; tuachi’n gamsungah bittahin na teng ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n gamin aga asuong dinga, nieng le tai tahin na ne ding ua, bittahin na teng ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh akum sagina a bang ne ding it adiei? Ngaivawi haichi lah tulou ding ihi ua, loua silpieng bangma lakhawmlou ding ihi ngal ua, na chi ua ahileh;
  </para>
  <para style="p">
    <verse number="21" style="v" />Akum guhna kumin ka guolzawlna na tung uah ka tung sah dinga, kumthum sunga ding ga asuo ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n akumgietna kumin bulebal na chiing ding ua, akum kuona tandongin bulebal luite na ne ding uhi; haichi tha hing tun masangsien na nei luite uh na ne ding uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gam khu kumtawna dinga zuaden ahi sih dinga gam pen kei a ahia, noute pen ka kunga khuolzin tam bang giap na hibou uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na luona gam zousie uah gam tatdoh zel na phal ding uh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Na unau khat ahing genthei a, anei lelam azua a, a unau kinaipi koi ahieikhat atan dinga ahing kuon leh; a unaupa nei lelam zuasate atan ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahisihleh tua mi pan atan ding mi khatbeeh anei lou a, ama mama in atatzou ding leh,
  </para>
  <para style="p">
    <verse number="27" style="v" />Azua khiet kum tuot henlen, azuanapa kungah aval teng pekia heh, tuachia anei lelam teng atan kia theina ding in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hinanleh atatkia zou sihleh Jubili kum dong aleipa khut ah aum dinga, Jubili kum chiengin hakhiet ahi dinga, tuachi’n aman anei lelamte atangkia ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Tualeh min kho kulbang nei sunga teng pasal khat in a inn azua leh, azua nua kum khat sungin atankia thei ding hi, kum khat sung a tatdoh kiana hun anei hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kum khat sunga atatdoh theisihleh, khum kulbaang nei sunga inn khu aleipa khutah kumtawn in ahahlesuonte tandongin aumden dinga Jubili kum chiengin zong apawtdoh nawn sih ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinanleh khoneu kulbaang neilou a innte pen gam sunga loute banga sim ahi dinga tatkia thei ahi ding hi, Jubili chiengin apawtdoh thei ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hinanleh Levimite khopite leh agoutan khopite uh sunga innte pen Levimiten bangchih laipouin atan thei ding uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh mi koi ahiei in Levimite apat alei leh, inn kizuapen leh akhopi khu Jubili chiengin apawtdoh ding hi. Aziehpen Levimite khopi a innte khu Israel tate lah a agoutan uh ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hinanleh akhopi kimvel ua loute khu zuathei ahisih ding hi. Aziehpen tamte khu akumtawn goutan uh ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Tualeh na lah ua khat ahing gentheia, nang ahing bel leh nana panpi ding ahi, mikhuol leh khuolzin mi banga na umpi ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ama apat summet ahiei, silpung ahiei, la sinlen, na Pasian khu ging zaw in, na unaupa na kunga aum theina dingin.
  </para>
  <para style="p">
    <verse number="37" style="v" />Apung deina in na sum na leitawi sah ding ahisih a, amet um dingin nehletah zong na palah sah ding ahi sih hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Keima Mangpa na Pasian uh Kanaan gam hing pe ding leh na Pasian uh hi dinga Izipt gam a kipat hing puidohpa khu ka hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Na tenpi na unau khat ahing gentheia, na kunga ahing kizua vawt tahleh, suoh leh sal banga na bawl ding ahisih hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hinanleh nasem a kithalaw mi bang leh mikhuol bangin na kungah aum dinga, Jubili tandong na nna ahing seppieh ding hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Khumzou chiengin na kunga pat in atate tawh apawtdoh ding a, tualeh a innkuonpite tawh ateng khawm kia dinga, apu leh pate inn leh lou aluo kia ding hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Azieh pen amaute khu Izipt gam a kipata ka hing puidoh ka suohte ahi ua, henta, suohle sal banga zua ding ahisih uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Khautaha atunga vai na hawm ding ahisih a, na Pasian na giin zawh ding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Suohnu leh suohpa a na nei dingte khu na kim na vel ua um namte lah a mi ahi ding ua; amau’lah a mi suohnu leh suohpa dingin na lei ding uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tuathamlouin gamdang mi na kung ua mikhuol a umte leh na gam ua pieng a innkuonpi te lah ua mite zong na lei thei ding uhi, tuate khu nami nasa uh ahi ding uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tualeh na nua chieng ua na tate uh goutan dingin, ami asa ua anei den dingun amaute na la ding ua, kumtawnin na suoh un a umden ding uhi, hinanleh na unau Israel tate khat leh khat khautah a naki vaihawm khumlou ding uh ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />“Tualeh na kunga teng gamdang mi ahiei, mikhuol khat ahiei, ahing hausat a, tualeh akunga um na unaupa khat ahing gentheia, na kunga gamdang mipa ahiei, mikhuolpa ahiei kunga, ahisihleh gamdang mipa innkuonpite khat poupou kunga akizua leh;
  </para>
  <para style="p">
    <verse number="48" style="v" />Akizua nuain tatdoh kia thei ahi dinga, aunaute khat in atan thei ding hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Apaneu ahiei, apaneu tapa ahiei in atandoh thei ding hi, ahisihleh a innkuonpite lah a akinaipi khat in atan thei ding hi, ahisihleh aman azaw leh ama leh ama akitan thei ding hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ama leipa tawh akunga akizua akipata Jubili kum tandong atuot ding ua, akizuana man khu akum tam dan dungzuiin akunga suoh nasem a kilawte hunsung dungzuiin ahi ding hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Kum tampi a um nahlai leh atatna man khu akilei hunsung dungzuiin ape kia ding hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tualeh Jubili kum tunna ding kum tomnoukhat aum tahleh, atuot khawm ding ua, aum nalai kum tamdan dungzuiin atatna man apekia ding hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kum khatbi zela kiguoi suoh nasemte bangin a kungah aum dinga, na mit muin atungah khautahin vai ahawm khum ding ahisih hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tualeh tami kumte sunga tat ahisihleh, Jubili kum chiengin ama leh atate tawh ha khiet ahi ding uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Aziehpen Israel tate khu kei a dingin suoh ahi ua, amaute khu Izipt gam akipat ka puidoh ka suohte ahi uhi; Kei Mangpa na Pasian uh ka hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Nouten milim khenthu na bawl dinguh ahisih a, milim bawlthu ahiei, suongphu ahiei, na dinsah ding uh ahisih hi, bieh dingin na gamsung uah suong milim zong na phut ding uh ahisih hi, aziehpen kei Mangpa na Pasian uh ka hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka khawlnite na tang ding ua, ka mun siengthoute na zatat dinguh ahi, Kei Mangpa khu ka hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ka danthute na zui ua, ka thupiehte na pom ua na bawl u’leh,
  </para>
  <para style="p">
    <verse number="4" style="v" />Guotuite ahuntahin ka hing zusah dinga, leiin aga ahing piengsah dinga, gam a singten ga ahing suong ding uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na phuol ua bu in grep lawhun abanpha dinga, na grep lawun haichi chiin hun abanpha ding hi, na tanghou uh nieng leh tai in na ne ding ua, na gam uah lungmuong tahin na teng ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gamsung hamuong tahin ka umsah dinga, na lum hit hiet ding uhi, Koiman ahing zausah sih dinga, tualeh gamsa giloute gamsung akipat in ka delmang dinga, na gamsung uh atuonsuoh sih ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na galte uh na del ding ua, na masang uah namsau in apua ding uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi nga in mi zakhat na del ding ua, zakhat in mi tulsawm na delzah ding ua, na galte uh na masang uah namsau a thalupin aum ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aziehpen noute ka hing deisah dinga, gatampi ka hing suongsah dinga, ka hing pungsah dinga, ka thuhun noute tawh ka sudet ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bu lui leh bu tha na kipha ding ua, bu tha koina dingin bu luite na hemsieng ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na lah uah ka biehbuh ka phutdet dinga, ka hinna in noute ahing elngatsan sih ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na lah uah ka teng dinga, na Pasian uh ka hi dinga, noute ka mite na hi ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei Mangpa na Pasian uh, sila henta na hilouna ding ua, Izipt gam a kipata noute hing puidohpa ka hi, na hahkolte uh ka hing suhtanpiehta a, tangtah in ka hing vah sahta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Hinanleh ka thu na man lou ua, ka thupiehte zousie na zui sih ua;
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh ka danthute na simmaw ua, ahisihleh na hinna un ka vaihawmnate ahuot a, ka thupieh zousie bawl nuomlou a, ka thuhun na bawsiet u’leh;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ken zong tami na tung uah ka tungsah ding hi: Na tung uah sil zauhuoi mama na hinna uh netum leh na mitte uh susie ding leh kumzawnnate tualeh khosih natnate ka tungsah ding hi, na haichi tute uh amawhna ahi dinga, na galte un aga ane zel ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tung uah ka mai ka gumsah dinga, na galte uh masangah na guollel ding uhi, nou hing mudaten na tung uah vai ahawm ding ua, koima dellou in na tai ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh tamte zousie zieh a ka thu na ngaikhieh tuomlou u’leh, na khelnate ziehun ale sagi in kahing gawt ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na kiletsahpi uh na thahhatna uh ka hiehtawng ding a, na van uh sia ka bangsah dinga, na leitung uh sum-eng ka bangsah ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh na thahatna uh athawnin na mangbei ding uhi: aziehpen na gam un haichi apiengsah sih dinga, singten zong ga aneisih ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Tualeh kei toh kilengat a na gamtat ua, ka thu na ngailou u’leh, na khelna utoh kituoh gawtna ale sagi in ka tungsah ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na lah uah gamsa hang ka hing sawl dinga, na tate uh ahing tawmangpieh dinga, na gantate uh ahing thapieh ding ua, na tawm deudeu ding ua, tualeh na lampite uh atulta ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Tualeh tam silte a zong na kisiemphat tuomlou ua, ka deidan kal a na gamtat nalai u’leh;
  </para>
  <para style="p">
    <verse number="24" style="v" />Kei zong noute kal in ka gamta dinga, na khelna ziehun ale sagi in ka hing gawt ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na tung uah namsau ka leengsah dinga, tuamin ka thuhun phuba ala dinga, tualeh na khopi sungte ua na kikhopkhawm chiengun, na lah uah natna hii ka leengsah dinga, na galte uh khuta piehlut in na um ding uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na kingahna bulpi pen uh na tanghou uh ka khahtan hun chiengin, numei sawm in lungthu khat ah tanghou akang ding ua, na tanghou ding uh te detdet in ahing pe ding uhi; nane ding ua hinanleh na khamsih ding uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Hichi tan chienga zong ka thu na zui tuomlou ua, ka deidan kal a na namtat nalai u’leh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Kei zong na tung uah lungthah pumin na gamtatna uh kal in ka gamta dinga, keima ngelin na khelnate ziehun sagivei ka hing gawt ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na tapate uh sa na ne ding ua, tualeh na tanute uh sa na ne ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na mun sangte uh ka suse dinga, na gimnamtui halna maitamte uh ka satpua dinga, na luongte uh hinna neilou milim luongte tungah ka sepkhawm dinga; ka hinna in noute ahing muda ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Na khopite uh bangmalou ka suohsah dinga, na munsiengthoute uh nuasie in ka umsah dinga, tualeh na gimnamtui halte uh ka nam nawnsih ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh na gam uh ka hawmsuohsah dinga, khuna teng na melmate un lamdang asa ding uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Namdangte lah ah ka hing thethang dinga, nou hing delzui ding namsau ka dohkhe dinga, tuachi’n na gam uh ahawmsuoh dinga, na khopite uh nuasie in aumta ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Tuachi’n gam nuasie a aum sung leh na melmate uh gam a na um sungsie un, gamsung akhawl dinga, tuachi’n akhawlnite ah nuom asa ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nuasie a um sungteng gam akhawl dinga, a sunga na ten lai ua, na khawlnite ua akhawl khahlou ziehin.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh nuasie a um adam sunte, a melmate uh gamah, lungtang zawnkhalna ka pe dinga, singna kiloh gingin zong azausah dinga, namsau a kidel banga zauin atai ding ua, koima dellou in apua ding uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Koima dellou in namsau masanga pua bangin, khatlekhat akipalpua ding ua, tualeh na galte uh dalna dingin thahatna mawngmawng na neisih ding uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Namdangte lah ah na mangthai ding ua, na melmate uh gamin nou ahing ne gam ding hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh na lah ua adam um sunte na melmate uh gamah athulimlounate ziehun abeimang deu deu ding ua, apu le pate uh gitlouna ziehin zong a mautoh abeimang khawm ding uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />“Hinanleh agitlounate u’leh apulepate uh gitlounate leh kei douna a agamtatnate uh, akisia ua,
  </para>
  <para style="p">
    <verse number="41" style="v" />Kei zong amauh kal a kana gamtatnate, amelmate uh gam a kana puilutdan akitheimaw bawllou ua, alungtang teptan lou uh akingaingiem ua, agitlouna zieh ua gawtnate apom u’leh;
  </para>
  <para style="p">
    <verse number="42" style="v" />Tuachi’n Ken zong Jakob kunga ka thuhun ka thei ngitnget dinga, Isak leh Abraham toh ka thuhunte zong ka thei zing dinga, gam zong ka thei zing ding hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh gam zong amaute nuasie in a um dinga, amaute umlou a ahawma nuasie a aum sungin nuomtahin a khawlnite amang ding hi, tualeh agitlouna zieh ua gawtna khu apom ding uhi; aziehpen ka vaihawmnate asimmaw ua, Ka danthupiehte ahinna un amu nuom sih uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Khuchi pumpumin zong, amelmate gamsunga aum sungun, amaute sumang ding leh, akung ua ka thuhun suse dingin ama uh ka paimang sih dinga, ka muda sam sih ding hi; Kei Mangpa na Pasian uh ka hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hinanleh a Pasian uh ka hi theina dinga, nam zousie mitmu a, Izipt gam a kipata ka puidoh apulepate uh thuhun ama u’ziehin ka thei zing ding hi, Kei Mangpa khu ka hi, chiin achi hi.”
  </para>
  <para style="p">
    <verse number="46" style="v" />Tamte khu Sinai taanga Mosi khut zanga Mangpa’n ama leh Israel tate kikaal a abawl thupiehte leh vaihawmnate leh dante ahi hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate houpi inlen akung uah; Mi koiin zong Mangpa kunga poimawna vilvel tungtanga thu achiem leh a mihing man dinga na tuot khu Mangpa tanvou ahi ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na tuot danding khu pasal ahileh, kum sawmni apat kum sawm guh tan mi ahileh mun siengthou shekel a tuot in dangka sawmnga ahi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Numei ahileh na tuotdan ding khu shekel sawmthum ahi ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh kumnga apat kum sawmnitan mite khu pasal ahileh shekel sawmni ahidinga, numei ahileh shekel sawm khat ahi ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh ha khat apat kum nga tan mite khu pasal ahileh dangka shekel nga ahi dinga, numei ahileh dangka shekel thum ahi ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh kum sawm guh apat atunglam mite pasal ahileh dangka shekel sawm leh nga ahidinga, numei ahileh shekel sawm khat ahi ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hinanleh na tuotna sanga gentheizaw ana hi a pe zoulou ding ahileh, siempu mai ah ahing kipelut dinga, tuachi’n siempu in aman ding ana tuot pieh ding hi, athuchiempa zaw thei ding hun giap siempu in ana bihieh pieh ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tualeh sillat Mangpa kunga alat dinguh ganta ahileh koipouin Mangpa kunga khumbanga apieh pouma uh sil siengthou ahi ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Silpieh ding khu ahen lamdang ding ahisih hi, ahoi taanga asie, ase taanga ahoi a ahending ahi sih a, ganta ganta mama a hen teitei ding ahileh aniin, ahenna toh asianthou dinguh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Mangpa kunga kithoina a alat ngailou uh ganta sienglou ahileh, siempu kungah aganta khu ahing pe ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n siempu in aman ana bihieh pieh dinga ahoi hiin asie hitaleh: nang, siempu in na bihieh dan bang bang ahi ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh asillatte anua tatkia ut pouma leh aman ding kibihieh sa senga suo sekhat belapin atan ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Tualeh mi’n a inn Mangpa kunga siengthou dinga alat leh, ahoile hoilou dungzuiin siempu in aman ding abihiehpieh dinga, siempu in a bihieh pieh dan bang bang ahi ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A inn lanpa’n anuatat ut kia leh aman dinga kibihiehsa se nga suo sekhat abelap dinga, atan kia dinga, tuachi’n ama a ahi kia ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Mi khat in aneisa alougam bangchia ahieikhat Mangpa dinga alat ding leh na bihieh pieh ding dan khu alou a haichi achiin dan dungzui ahi ding hi. Barli-bu homer khat mun khu dangka shekel sawmnga a tuot ahi ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Alou khu Jubili kum apat alat ahileh, na bihieh pieh bang bang ahitoupeh ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hinanleh alou Jubili nualam a alat ahileh pen, siempu in Jubili tunkiana ding kum umnalai dungzui in aman atuot dinga, na tuot dan akipata kiemsah ahi ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Alou lanpan anua tatkia ut leh aman kituotsa apat se nga suo sekhat abelap dinga atan kia ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh alou pen atatkia utlou ahiei, ahisihleh midang kunga ana zuasawn ahileh, akiitankia thei nawn sih ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin alou Jubili kuma apawtdoh kia hun chiengin lou pen akipieh khiet dungzuiin, Mangpa a dinga siengthou ama tanvou ahia, siempu in atang ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh mikhat in ama neisa hilou, lou khat alei a, Mangpa kunga alat leh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Siempu in Jubili kum tan adinga na tuotsa bangin aman ding abihiehpieh dinga, na tuot bangin Mangpa adinga sil siengthou dingin khumni mama in ape ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jubili kumin lou khu aleinapa, agamneipa kungah ahing tung kia ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh na tuotdan zousie khu mun siengthou shekel dungzui in ahi dinga, gerah sawmni in shekel khat ahi ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Hinanleh ganta lah a piangmasapen, Mangpa ganta masapen hidingte khu koiman alat ding uh ahisih hi; bawngtal hiin belam hitaleh, tami Mangpa tanvou ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ganta sienglou ahileh, na tuot dan dungzuia tat ding ahiding hi, se nga suo sekhat abelap ding hi, akitat sihleh a man na bihieh dungzuiin zua ahiding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Ahivang in sil lat dohsa, mikhat in aneisa laha sil khat poupou, mihing hiin, ganta hiin, aneisa lou hitaleh Mangpa kunga alatsa zuading ahisih a, tatding zong ahi sih hi, tuabang sil pouma Mangpa dingin asiengthou pen ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mikoipou shi dinga thutankhum sa khu tatdoh kia ding ahisih a, ama khu shisah teitei ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Gamsunga sawma khat zousie, haichi hiin, sing ga hitaleh Mangpa a ahia, Mangpa adinga siengthou ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh min asawm akhat anuatat utkia leh, se nga suo sekhat abelap in atan ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bawnghon, belamhon, sawm a khat thu ah gan chingmi chieng nuoi a peisuoh pouma asawmna khu Mangpa adinga siengthou ahi ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Gantate ahoi leh hoilou aenchien ding ahisiha, ahen ding zong ahisih hi, ahentah leh zong ahenna pen leh ahen pen zong ani un asiengthou ding ahi; tat ding ahishi hi.”
  </para>
  <para style="p">
    <verse number="34" style="v" />Tamte khu Sinai taanga Mangpa’n Israel tate dinga Mosi kunga thupieh apiehte ahi.
  </para>
</usx>
