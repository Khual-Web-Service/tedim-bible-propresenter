<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MRK" style="id">Mak</book>
  <para style="h">Mak</para>
  <para style="toc1">Mak</para>
  <para style="toc2">Mak</para>
  <para style="mt">Mak</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pasian Tapa Jesu Khrist khantanhoi kipatna;
  </para>
  <para style="p">
    <verse number="2" style="v" />Guolnei Isai laibu ah: “Ngai vawi, ka sawltah na masang ah ka sawl a, aman na lampi asiel ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamdai a mi kikou aw in, Mangpa lamlien siel unlen, alampite sutang un,” achi chia kigiel bangin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan in gamdai ah abaptis a, khelnate ngaidamna dingin kisiana baptis thu gen in ahing pei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Judia gam a mi zousie leh Jerusalem a umte zousie apawt ua, akung ah ava pei ua, akhelnate uh thupha tawi in Jordan lui ah baptisma atang chiet uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Johan khu Sangawngsau mul puon silin, akawng savun kawnggah in agah a, tualeh a ann khu khaukhup leh gam khuoizu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Tualeh ka nua ah, kei sanga thupizaw ahing pei a, Kei pen kun a akedap khau sut taah zong ka hi sih hi.”
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei pen in tui in ka hing baptis a, hinanleh Aman Hagau siengthou in ahing baptis ding hi, chiin agen hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua hun lai in, Galili gam a Nazareth khuo akipat in Jesu ahing pei a, Jordan lui ah, Johan in baptisma atangsahta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh tui akipat ahing pawtdoh tahin, vante kihonga, Hagau vakhu banga atunga hing kumsuh amu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n, “Nang ka Tapa ittah na hi a, Na tungah ka lungdam mama hi, chiin van akipat in aw khat ahing pawt hi.”
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Hagau in Jesu gamdai ah asawldoh pai hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama gamdai ah ni sawmli Setan sol in a um a, tualeh gamsate toh a um khawm a, vansawlsiengten ana aseppieh uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Johan amat ua suongkul a akhum nua un, Jesu Pasian gam khantanhoi gen in Galili gamah ahing pei hi,
  </para>
  <para style="p">
    <verse number="15" style="v" />ahun atungta a, “Tualeh Pasian gam anaita hi, kisia unlen, khantanhoi gingta un,” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Galili tuipi gei a avah lai in, Simon leh asanggampa Andru tuipi a lensep amu a, amauh nga man mi mawng ahi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Jesu’n akung uah, “Hing zui un, mihing man dingin ka hing bawl ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh amaun alente uh nuasie in azui paita uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khuna pat a themkhat apei gamlat deu leh Zebedi tapate Jakob leh asanggampa Johan amu a; amaute alen uh phaw a kuong sung a um ahi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Aman amauh a han pai a, tuachi’n amaun apa uh Zebedi leh suoh athalahte utoh kuong ah anuasie ua, Ama azuita uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n amaute Kapernaum khuo ah alut ua, tualeh khawlni in kikhopna inn ah alut pai a, thu ahilta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Athu hil khu lamdang asa mama ua, Aman laigiel mite banglou a, thuneitah banga thu ahil ziehin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh akikhopna inn uah hagau bua nei mi khat a um a, aman,
  </para>
  <para style="p">
    <verse number="24" style="v" />Kouma tangin hing um sah in; “Nazareth Jesu nang leh kouten bang ahiei kizopna inei? Koute sumang dinga hing pei na hiei mah? Nang koi na hiei chi ka hing thei uhi; Pasian Misiengthoupa na hi, chiin akikoukhie hi.”
  </para>
  <para style="p">
    <verse number="25" style="v" />Hinanleh Jesu’n ama aphawh a, “Sip inlen asunga pat in hing pawt in,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh dawi buain tua mipa abawlgenthei a, ngaitah a kikou in asung apat in ahing pawtdohta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh a unpi un lamdang asa mama ua, tuachi’n “Tami bang avalong eile? Bang thuhilna tha khat ata ei le? Aman thuneitah in dawi buate nangawn thu apie a, Athu amang uhi, chiin akidongtuo uhi.”
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Galili gam kimvel zousie ah, gam chinteng ah aminthang paita hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh kikhopna inn akipat apawtdoh tahun, Simon leh Andru inn ah Jakob leh Johan toh alut pai uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuanah Simon sungnu chithuo a damlou in ana lum a, tualeh amanu tanchin ana hil pai ua,
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Ama ahing pei a, amanu khut a vatuin aphong a; tuachi’n achithuo in a nuasie pai a, tualeh amanu’n ana uh aseppiehta hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh nitahlam ni tum zouin, damlou zousie leh dawi matte akungah ahing zawpi ua,
  </para>
  <para style="p">
    <verse number="33" style="v" />khopi sunga mi zousie kotphung ah ahing kikhawm uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n Aman mi tampi natna chi tuomtuom a nate ana sudam a, dawi tampi anotdoh a, tualeh dawiten Ama atheizieh un, aham ding uh aphal sih hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zingmawng khovah masangin athou a, apawtdoh a mun sip khat ah apei a, thungetna ava nei hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh Simon leh akunga umten Ama asuita uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n amu tah un, akungah mi zousie’n “Nang ahing sui uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman akung uah, “Aban a khuote ah zong pei vai khuna thu ka gen theina dingin, tuami ding mawnga hing pei ka hi ziehin.”
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh Aman Galili gam pumpi a a kikhopna innte uah thute gen in, dawite a notdoh zel hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuachi’n mipha khat akungah ahing pei a, amasang ah akhupdin a, “Na ut leh na hing siengsah thei hi chiin angen va ngua hi.”
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh Jesu’n ahepi mama a, akhutin azam a, akhoi a, “Ka ut hi, siengthou tain,” achi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Agenzou tahin, aphahna in anuasie pai a, ahing siengthouta hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh Jesu’n ama khautahin akham a, asawlkhe paita hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tualeh akungah, “Koima kunga bangma genlou dingin pilvangin, hinanleh pei inlen siempu kungah va kilah inlen, na kisiensuona dingin Mosi thupieh silte valaanin, na dam siengta chi atheina dingun,” achi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hinanleh ama apawt a, tua thu nasatah a tangkoupi in aphuongzah panta. A, tuachi’n Jesu alangtang in khopi sungah alut theita sih a, gamdai munte ah a umzawta hi, tualeh mun chin a kipat in akung ah mite ahing pei uhi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh ni bangza ahiei nuain Kapernaum khuo ah ahing lut kia a, inn ah a um chi thu akithangta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Innsung leh kotkha kim nangawn ah umna ding umlou khopin mi tampi ahing kikhawm pai ua, tualeh Aman akung uah thu agen hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n mi li in mi zeng khat ahing zawng ua akung ah ahing pui uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mipi atam seng zieh a, akung nai a ahing pei theilou tahun, a umna inntung aphetvang ua, aphevang zou un, mi zeng khu alupna toh akhaikhe suh uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu’n aginna uh amu tahin, mi zengpa kungah, “Tapa na khelnate ngaidam ahita,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh laigielmite pawlkhat khum mun ah atou ua, alungsim un,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Bangdinga tam mipa’n Pasian gensie a, tambang thu agen ahiei? Pasian chi loungal koi ahiei khelnate ngaidam thei?” chiin angaituo uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Jesu’n alungtang un tambangin angaituo uh chi alungsim in ana thei pai a akung uah, “Bangdinga tam thute na lungtang ua ngaituo na hi uoi?
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi zengpa kunga, na khelnate ngaidam ahita chi leh Thou inlen, na lupna la inlen, kengin peitain chi koizaw agen nuomzaw ei?
  </para>
  <para style="p">
    <verse number="10" style="v" />Hinanleh Mihing Tapa in leitung ah khelnate ngaidam theina anei hi, chi na theina dingun,” mi zengpa kung ah,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Thou inlen, na lupna la inlen, na innlam ah pei in, ka hing chi ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh ama khu adingtou pai a, amaute zousie mitmu ah alupna ala a, apeita hi, tuachi’n a unpi un lamdang asa mama uhi. “Tambang sil mawng mawng imu ngai sih uhi,” chi’n Pasian aphat uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n apawtdoh a, tuipi gei ah apei kiata hi, tualeh mipite akungah ava pei ua, tualeh Aman thu ana hil hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh apei kawmin Alphai tapa Levi, sie donna muna tou amu a, akungah, “Hing zui in,” achi hi. Tualeh adingdoh a Ama azuita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Jesu’n Levi inn a annkuong a im laiin, siedongmite leh mikhiel tampiin Jesu leh anuazuite a impi ua, mi tampiin, anua azui uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh laigielmite leh Pharisaiten Jesu siedong mite leh mikhielte toh ann nekhawm amu tahun anuazuite kungah, bangchidan ahiei? “Siedongte leh mikhielte toh aneh a adawn?” achi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu’n tuakhu azah tahin, akung uah, “Mi chidamten daktorpa atulmaw sih ua, mi damlouten atulmaw zaw uhi, midihtatte han ding a hing pei ka hisih a, mikhielte han dinga hing pei ka hizaw hi” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Johan nuazuite leh Pharisaiten ann angawl zel uhi. Tualeh mite ahing pei ua akungah, “Bangdinga Johan nuazuite leh Pharisaite nuazuiten ann angawl ua, Nang nuazuiten angawllou uh ahiei?” achi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu’n akung uah, “Moupuite kunga mouneipa aum laisie moupuiten ann angawl thei ngai uh amah? Mouneipa akung ua aum laisie ann angawl thei sih ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh mouneipa akung ua kipat a puimang nite ahing tung dinga, tua ni chiengin ann angawl ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koiman puonlui puon tha them in aphaw ngai sih hi, phawta uleh, aphawna pen in aluipen aluoi keh dinga, asuse zaw sem ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Koima’n uoin tha, savun thawl lui ah athun ngai sih hi; thunta uleh uoin tha in savun thawl aphukeh dinga, uoin akibo dinga, tualeh savun thawl zong aseta ding hi; uoin tha khu savun thawl tha a thun ding ahi zaw hi, achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh khawlni in bulei lai kantan in apei ua, tualeh anuazuiten apei kawm un, buvuite azut panta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Pharisaiten akungah, “En vawi, bangdinga amaun khawlni a bawl sienglou abawl uh ahiei?” achi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Aman akung uah, “David leh alawmte atahsap ua, agilkiel lai ua, asil bawl uh na simkha ngai sih uh amah?
  </para>
  <para style="p">
    <verse number="26" style="v" />Abiathar siempu lienpen ahilai a, Pasian inn a alut a, siempute loungal in aneh sienglou tanghou siengthou kikoi aneh a, alawmte zong apieh thu,” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Aman “Khawlni khu mihing a dinga bawl ahi a, mihing khu khawlni a dinga bawl ahi sih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuaziehin Mihing Tapa khu Khawlni Mangpa zong ahi,” achi hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Jesu kikhopna inn ah alut kia a; tuanah mi khutzaw khat ana um hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Ama amawsiet theina dingun, khawlni a asuhdam leh suhdamlou a sim-et uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Aman khutzawpa kungah, na mailam ah “Hing pei vawi,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Aman akung uah, “Khawlni in silhoi bawl ahiei sieng, ahisihleh sil hoilou bawl?” hundam ahiei sieng ahisihleh thalup, achi hi. Hinanleh amaute asip dide uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n alungtang uh khau zieha lunggim mama leh lungthah puma, amaute a etvel nuain, Aman tua mipa kungah, “Na khut zahdoh vawi,” achi hi. Tualeh aman azahdoh a, alangkhat bangin adamta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Pharisaite apawtkhie ua, Ama athalup theina dan ding uh ngaituoin Herod pawla mite toh akithukum pai uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh Jesu khu anuazuite toh tuipi langah apeita ua, tualeh Galili gam a kipat mi tampiin Ama azuita uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh asil bawl thupi dante azah un, Judia gam a kipat, Jerusalem akipat, Idumea akipat bangin, Jordan gal akipat bangin; Tai-ar leh Sidon khokim a kipat bangin, mipi thupitah akungah ahing pei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh mipite ziehin, Ama dinga kuong neu khat mansa a na koi dingin anuazuite ahil a, tuachilouin Ama atuonchil kha ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aziehpen mi tampi asudamta a; tuachi’n natna nei poumain Ama akhoikhah theina ding un abaw valuoi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n dawibuate’n Ama amutah chiengun amasang ah akhupboh ua, “Nang Pasian Tapa na hi” chiin akikou uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Aman atanchin gendoh vawtlou dingin khautah in thu apie hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama muol tung ah apeitou a, adeituomte akungah ahan a, tualeh amaute akungah ahing pei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Akunga um ding leh thugen a asawlkhieh theina dingin sawm leh nite aguot a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Damloute suhdam theina leh dawite deldoh theina thu nei dingin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman Peter chia amin aphuopiehpa Simon,
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebedi tapa Jakob leh Jakob sanggampa Johan; amaute min Boanerges aphuo a, tua khu vanging tapate china ahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Andru, Philip, Batholomai, Mathiu, Thomas, Alphai tapa Jakob, Thaddai, Kanaan mi Simon,
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh amansahpa Juda Iskariot zong ahi uhi. Tualeh amaute inn sung ah alutta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh mipi tampi ahing peikhawm kia ua, tuachi’n ann nangawn zong ane thei sih uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh ama mite mamain tam thu azah tahun, amaw ahita, chiin “Ama mat tum in apawtdohta uhi.”
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh laigielmite “Jerusalem khuo a kipat a hing peisuhten Belzabub toh kizawl ahi, tualeh dawimangpa zieh a dawite anawdoh ahi,” achi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n Aman amaute akung ah ahan a, akung uah, gente thuin thu agen a, “Bangchin Setan in Setan anawtdoh thei diei?”
  </para>
  <para style="p">
    <verse number="24" style="v" />Gam khat kilangkhen in kidouta leh tua gam khu adingdoh thei sih ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh innkuon khat kilangkhenin kidouta leh tua innkuon zong adingdoh thei sih ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Setan zong ama leh ama kidou in, kilangkhen leh adingdoh zou sih dinga, amangthaizaw ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi Koiman mihatpa kaantom masa louin mi hatpa inna lut in aneitahte alahpieh thei sih a, akaantom nua chiengin aneitahte alahpieh thei ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Adihtahin ka hing hil ahi, Mihing tate a khelna zousie uleh, Pasian agensietna lam ua, bangpou agente uh ngaidam ahi ding ua,
  </para>
  <para style="p">
    <verse number="29" style="v" />hinanleh Hagau Siengthou gense poumain bangchih tan in ngaidamna amu sih dinga, kumtawn mawpaina ah a um zaw ding hi.”
  </para>
  <para style="p">
    <verse number="30" style="v" />Amaun dawibua nei ahi achi zieh ua, “Tam thu agen ahi.”
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n a nu leh asanggamte ahing pei ua, inn pulam ah a ding ua, Ama han ding in mi asawl uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh akim ah mipi tampi atou ua, amaun akungah, “En vawi, inn pulam ah na nu leh na sanggamten ahing sui uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hinanleh Aman adawnga akung uah, “Kanu leh ka sanggamte koite ahi uoi?” achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n akim a toute a en kuol a, “En un ka nu leh ka sanggamte!
  </para>
  <para style="p">
    <verse number="35" style="v" />Koipou Pasian deilam bawl poumate ka sanggampate, ka sanggamnute leh ka nute ahi uh,” achi hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh tuipi pieu ah thu ahil pan kiata a; tualeh mipihon tampi akungah ahing kikhawm ua, tuachi’n tuipi tunga kuong sungah alut a, atouta a, tualeh mipi zousie lui pieu a leitungah, tuipi lam ngain a um uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh amaute gentena thu in sil tampi ahil a, athuhilna ah akung uah;
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ngaikhie unlen en vawi un, buchithepa khat buchithe dingin akuon a;
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh hichi ahing hi a, athe laiin, kimkhat lam gei ah akie a, tualeh tungleeng vate ahing pei a, ane khawngta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kimkhatte suongsilei lah ah akie a, lei asalou ziehin apou pai hi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh ni ahing sat in emvuoi in a um a, hui ahahlou ziehin a gogawp siengta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh kimkhatte loulingnei lah ah akia a, loulingnei khu ahing khang a, adepmangta a, ga aneita sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh kimkhatte lei hoi ah akie a, apou a, ahing khanglien pai a, agata a, ale sawmthum bang, ale sawmguh bang, ale zakhat bangin ahing pungta hi, achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Aman akung uah, “Koipou zahna ding bil nei in za heh,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amatanga a um laiin akima sawm leh nite toh umten gentena thu adongta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Aman akung uah, “Pasian gam thuguh khu noute kung a na thei ding ua pieh ahi, hinanleh pulam mite a dingin pen sil zousie gentena thu a hil ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachia, Mu pen amu thei na ua, atheisiem sih ding uh, zah pen aza ding ua, atheisiem tuom sih ding uh; tuachilou in pen, ahing kihei kia ding ua, akhelnate uh ngaidam ahi kha ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Aman akung uah, “Tam gentena thu na theisiem sih uh maw? Tuachi ahileh bangchi’n gentena thu dangte zousie na theisiemta ding uoi?
  </para>
  <para style="p">
    <verse number="14" style="v" />Buchithepa in thu athe ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh lam gei a thu thenate khu tambang ahi uh, thu khu azah tah un, Setan ahing pei a, alungtang ua thu kithe khu alamang pai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tambangma in suongsi lei a kithe khu tamte ahi uh, amauten thu azah tahun kipahtahin apom pai ua;
  </para>
  <para style="p">
    <verse number="17" style="v" />hinanleh amauah thahui anei sih ua, hun tomnou khat a um ua, tuami nua a thu zieh a gimthuohna ahiei ahisihleh suhgentheina ahing um chieng in apua pai uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh loulingnei lah a kithete khu tamte ahi uh, amauten thu aza ua;
  </para>
  <para style="p">
    <verse number="19" style="v" />leitung hinkhuo ngaituonate, hausat utna solnate leh sil dangdang deigawnate, ahing lut chiengin, thu khu a deep a galouin a umta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh lei hoi a kithete tamte ahi uh; thu aza ua apom ua, ale sawmthum bang, ale sawmguh bang, ale zakhat bangin aga uh,” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman akung uah, “Meivah akoina koilou a, law nuoi ahiei, ahisihleh lupna nuoi ahiei a koi dingin ahing la ngai uh amah? Meivah tunna ah akitungzaw hilou amah? achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aziehpen phuonzah lou ding a im bangma a um sih a, langlou ding a phuol zong bangma a um sih hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Koipouin zahna ding bil anei leh za heh,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman akung uah, “Na zah uh bang ahiei pilvang un, na tena mama uah ahing te pieh ding ua, tualeh nou angaikhete kungah, ahing pieh belap ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aziehpen koipou anei kungah, piehbe ahi dinga, tualeh koipou aneilou khu anei sun zong lapieh ahiding,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Aman “Pasian gam khu, tambang ahi, mi’n lei ah haichi tu henlen;
  </para>
  <para style="p">
    <verse number="27" style="v" />Zan chiengin a imu a, sun chiengin athou zel a, haichi khu ana pouin, ana khanglien a, bangchidan a poua, bangchidan a khanglien ahiei chi, athei sih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aziehpen leiin amain ga ahing suong zel a, amasapen in ana, tuachi’n avui, tuazou chiengin avuiah atangpiching.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hinanleh aga khu ahing mintah chiengin, bu lah ahun taah ziehin kawite in a at paita hi.”
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Aman “Pasian gam khu bangtoh itekah ta diei? ahisihleh bang toh gente a gen ding i ta uoi?
  </para>
  <para style="p">
    <verse number="31" style="v" />Tami ankam chi tang khat lei a akitu chiengin, haichi zousie sangin neupen nanleh,
  </para>
  <para style="p">
    <verse number="32" style="v" />Atu nua un ahing pou a, loupa zousie sangin ahing lienzaw a, bazam lien tahtah ahing nei a, tuachi’n tung leeng vaten aliim nuoi ah bu asep uhi, tuabang ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh tambang gentena thu tampiin, amauh theisiem thei dandan in thu agen hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hinanleh gentena thu louin akung uah, thu agen ngai sih hi; tualeh nuazuite toh amauh ngen a a um chieng un, nuazuite kung ah sil zousie ahilchien zel hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuami ni mama in nitahlam ahing hitah in, Aman akung uah, “Galkhat lam ah igalkai ding uh” achi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amaun mipite apeisan nua un, Ama aum ngai bangbangin kuong ah apeipi paita uhi. Tualeh akungah kuong neute zong a um hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n khopi hui thupitah ahing laangta a, tualeh tui kihawt khu akuong sung uah, ahing lut vazung ta a, tuachi’n ahing dim phielta hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hinanleh Ama pen kuong meilam ah taangkhap khap in imuin a um a, tuachi’n aphong ua, akungah, “Siepa ka manthai uh khoh salou na hiei mah?” achi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuachi’n Ama ahing thou a, huipi aphawh a, tuipi kungah “Sip inlen um khinkhian in” achi hi. Tuachi’n hui khu atawpta a, ahing sip dideta hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Aman akung uah, “Bangding a hichi zau na hi uoi? Ginna mawngmawng na neilou uh bangchidan ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh zau chitahin azau ua, khat leh khat akihou ua, “Tam mipa koi ahia, huipi leh tuipi nangawn in athu ahichi man uh,” achi uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n tuipi gal langkhat Gadara mite gam ahing tungta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kuonga kipat ahing pawtdoh tahin, dawi nin pai mi khat han akipat a hing pawt in Ama ana lamtuo pai hi,
  </para>
  <para style="p">
    <verse number="3" style="v" />ama pen han lah ngen a teng ahi a, koiman siakhainieng nangawn in akaan thei sih uhi;
  </para>
  <para style="p">
    <verse number="4" style="v" />kolbul in sia khainieng bangin ana kan ngaita ua, hinanleh siakhainiengte abottan a, kolte bang asutan a, mi koiman athunun zou sih uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sun leh zan in muol leh taangte leh hante ah a um a akikou a, suong in ama leh ama aki at zel hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh aman gamla tah a pat Jesu amu tahin atai a ava beta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh aw ngaitahin akikoukhie a, Jesu Pasian Tungnungpen Tapa, “Nang kei bang hing law sawm na hiei? Hing sugim lou dingin Pasian min in ka hing ngen ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu’n akungah, “Nang dawibuapa tua mipa sung akipat in hing pawt in,” achita hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Jesu’n “Na min bang ahiei?” chi’n adong a, tualeh aman “Ka min Ligion ahi, aziehpen tampi ka hi uh,” chi’n adawng hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh tua gam akipat amauh sawl khe lou dingin Jesu kungah hatang nget in angen hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh khuna muol pangah voh hon tampi ata uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh “Dawibuate zousiein voh sungah hing sawl in, a sung ua ka lut theina dingun,” chi’n akungah angen uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Jesu’n phalna ape pai hi. Tuachi’n dawibuate khu apawtdoh ua, voh sungah alut ua, voh hon tul ni phiel ahi ua, ken ah tuipi lam ah hatai in atai suhta ua, tuachi’n tui sung ah ashita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n voh chingte atai ua, khopi sung leh gam sungah tam thu ava hil ua, tuachi’n tua sil hing um khu bang ahiei chi en dingin mite ahing pei uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Jesu kung ahing tung ua, dawi pai, nuoi matpa khu puonsil a, lungsim ngaina puo a, na tou ahing mu ua, azauta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh tua sil umdan na muten, dawi matpa tunga sil tun dan leh vohte um dante amauh ana hil uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Ama khu agam ua kipat a pawtkhe dingin angenta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh kuonga tuong ding a akisah laitah in dawimat pa’n Jesu kunga um ding angen hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivang in Jesu’n aphal sih a, akung ah, “Na inn ah na lawmte kungah pei inlen, Mangpa’n nanga dinga sil thupi ahing bawlpieh dante leh nang ahing hepi dante va hil in,” achi zawta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n apei a, Jesu’n ama dinga sil thupi abawlpieh dante, Dekapolis khuo ah ataangkoupita a; tualeh mizousie in lamdang asa mama uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu kuonga galkhat lam a ahing galkai kia tahin, mipi tampi akungah ahing peikhawm ua, tualeh Ama pen tuipi pieu ah a um hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh En un, kikhopna inna vaihawmte laha mi khat amin Jairas ahing pei a, Jesu amutahin akengbul ah abohkhup a,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Katanu naupang neunou shi dihdih in alum a, ahing dam a, ahing hin kia na dingin, hing pei a atunga na khut koi dingin ka hing ngen hi; chiin hatang nget in angen hi.”
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Jesu ama toh azawh a, mipi tampi in azui ua, atuom valuoi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh numei khat kum sawm leh kum ni si luonga china a um a,
  </para>
  <para style="p">
    <verse number="26" style="v" />Zatou tampi akipat in sil tampi ana thuohta a, anei zousie ana zang siengta a, phattuom nahsang in ase zaw sem sem hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanu’n Jesu tanchin azah tahin, anua ah mipi lah ah ahing pei a apuon akhoi a;
  </para>
  <para style="p">
    <verse number="28" style="v" />Aziehpen alungsim in, “Apuon bep khoi leng zong suhdam in ka um mai ding hi,” chiin angaituo hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n asi luong khu akang paita a, anatna adamta chi atahsa ah akitheita hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Jesu’n asunga kipat in silbawl theina apawt chi athei pai a, mipi lah ah akihei kawikawi a, “Koi ahiei ka puon khoi?” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh anuazuiten akungah, “Mipi in ahing tuom valuoi chi na mu a, Koi ahiei ahing khoi?” nachi, achi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Aman tua sil bawlnu mu tumin a en kawikawi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hinanleh tua numei in atunga sil kibawl athei a, zau leh chitun pumin ahing pei a, amasangah abohkhup a, akungah thudih zousie ahilta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n Aman numei kungah, “Tanu na ginna in ahing damsahta hi, hamuong tahin pei inlen, na natna akipat in damta in” achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman thu agen laitah in kikhopna inn a vaihawmpa inn akipat in mi ahing pei ua, “Na tanu ashita hi, bang dinga Siepa subuoi nalai ding na hiei mah?” ahing chi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jesu’n thu kigen azah tahin, kikhopna inn a vaihawmpa kung ah, “Zau sin gingta mai in,” achi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh Aman Peter leh Jakob tualeh Jakob sanggampa Johan chilou mi dang koiman Ama azui uh aphal sih hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tuachi’n kikhopna inn a vaihawmpa inn ah ahing tunga, Jesu’n ana buoi vengvung u’leh, ngaitah a, kap leh mau a, na umte amuta hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ava lut tahin, akung uah, “Bangding a buoi vengvung a kap na hi uoi? Naupangnu ashi sih a, imu ahi bou hi,” achi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuachi’n amauten tahsanglou seng in anuisan uhi. Hinanleh Aman a unpi un anotdoh a, naupangnu nu leh pa leh azawpite apui a, naupangnu umna ah alutta uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tuachi’n Aman naupangnu khut atu a, akungah “Talitha kumi,” achi a, tua khu “Naupangnu aw thouin ka hing chi hi” china ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tuachi’n naupangnu khu athou a, apei pai ngal hi; amanu khu kum sawm leh kum ni mi ahita hi. Tualeh amaute lamdang sahnain adim uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hinanleh Aman akung uah, tam thu koima’n thei sih heh, chi’n khautah in thu apie hi; tualeh amanu khu aneh ding bang ahiei khat pie un achi hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n khuna kipat in a pawt a, Ama umna gam lam ah ahing tungta a, tualeh anuazuiten Ama azui uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh khawlni ahing hiin kikhopna inn ah thu ahil panta hi. Tualeh mitampi athuhil zaten lamdang asa mama ua, “Tam mipa’n tam thute hei a kipat a amu hiei? Akunga pilna kipie bang pilna ahi a, akhutin hichi va-ia a sillamdang abawl bangchidan ahiei? achi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama khu Mari tapa, Jakob, Jose, Judas leh Simon sanggampa sing bawl siempa khu hilou amah? Asanggam numeite zong tana ikung ua um hilou uh i?” achi uhi. Tuachi’n atungah alungkimta sih uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh Jesu’n akung uah, “Guolnei khu ama gam sung leh ama hienglesante lah leh ama innkuonte lah chiloungal ah pahtawi lou in a um ngai sih,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n mi damlou tawmnou khatte tunga khut koi a asuhdamte chiloungal khunah sil thupi mawngmawng abawl theita sih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Agintat lou zieh un lamdang asa mama hi. Tuachi’n khoneute ah thuhil in avah kuol zel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman sawm leh nite akungah ahan a, ni niin asawldoh a, dawibuate tunga thuneina zong apie hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman akhuolzinna dingun chiengkhut chiloungal bangma, thungpi zong, tanghou zong, akawnggahna uh asum ip ua sum zong kenglou dingin, amaute thu apie hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh kedappen but unlen, puon ah ni sil sih un achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman akung uah agenbe nalai a, “Heisung mun ah na tunna inn phot uah, khuna kipat na pawtdoh masangsie un umden un.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh koi hinanleh ahing tunsahlou ua, na thu u’zong angai nuom sih u’leh, khuna kipata na pawtdoh chieng un, amaute theipitu hiding in na kengtaw ua leivui thingkhie un. Chitahtahin ka hing hil ahi, vaihawm ni chiengin tua khopi thuoh ding sangin Sodom leh Gomorrah thuoh khu adan a um zaw ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n akuondoh ua, mite akisia ding uh ahi, chi thu agenta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh dawi tampi anotdoh ua, damlou tampi sathau nu in asudam zel uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuin leengpa Herod in Jesu tanchin ana zata a, (Amin athan tah ziehin), “Baptispa Johan mishi lah akipat ahing thou kiata a, tuazieh in tam silbawltheinate’n ama ah sem ahi ve,” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi dangten “Elijah ahi” achi ua, midangten “Guolnei ahi, ahisihleh guolneite lah a khat ahi,” achi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinanleh Herod in, “A lu katan piehpa Johan ngel ahi; mishi lah akipat hing thou kia ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Herod in asanggampa Philip zi Herodia akitenpi taah zieh in, Herodia ziehin mi asawl a Johan amansah a, kaan in suongkul ah ana khumta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aziehpen Johan in Herod kungah, “Na sanggampa zi na kitenpi ngaina dan ahi sih,” ana chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuaziehin Herodia in ama amuda a, thalup a ut a, hinanleh athat thei sih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aziehpen Herod in Johan khu midihtat leh siengthou tah ahi chi athei zieh in agiinga ama ana humbit zel hi. Tualeh athugen azah chiengin lungdong zel nanleh kipah tahin a ngaikhe zel hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Herod in apien niin, ami thupite, galkap lamkai liente leh Galili gam a miliente adinga annkuong alui lai in, hun lemtang ahing umta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Herodia tanu ahing lut a, alam a, Herod leh akunga toute akipah sahta a, tuachi’n leengpa’n naupangnu kung ah, “Na dei dei ngen in ka hing pe ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amanu kungah, “Na nget pouma, Ka gam kimkhat nangawn zong ka hing pe ding,” chiin akichiem nalai hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n amanu apawtdoh a, anu kungah “Bang ka ngen diei?” ava chi hi. Tualeh “Anuin Baptispa Johan lutang”, ana chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n amanu kintah in leengpa kung ah ahing lut pai a, “Baptispa Johan lutang tu mamain kuong khat ah hing pe lachin ka ut hi,” chiin angen hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n leengpa alunggim mama ta a, hinanleh akichiemnate leh a kunga toute ziehin ana niel nuom sih hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh leengpa’n ama vengte lah a galkap khat asawl pai a, Johan lutang hing tawi dingin thu apeta hi; tualeh amapa ava pei a suongkul sungah alutang ava tanta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Alutang khu kuong khat in ahing tawi a, naupangnu apie a, tualeh naupangnu’n anu kungah apeta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anuazuiten azah tahun, ahing pei ua, aluong ahing la ua, han ah asielta uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n sawltahte Jesu kungah ahing kikhawm ua, asil bawlte zousie uleh, athuhilnate uh ahing hil uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh aman akung uah, “Nouma tangin gam sip mun ah hing pei unlen khawldam tadi un” achi hi. Aziehpen mi tampi ahing kuon leh apei lam akiphamat den ua, ann nangawn zong ane man sih uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n amaute kuongin mun sip ah atuom peita uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hinanleh mipi tampi in apei lai uh amu ua, tualeh mitampi in athei ua, khopi chintenga kipat in kengin ahing tai ua, amauh ana makhel ua, akung uah ahing pei khawmta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Jesu ahing pawtdoh tahin mipi tampitah amuta a, chingding neilou belamte bang ahizieh un ahepi sengseng ta a, thu tampi ahil panta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n ni ahing ngiem seng tah ziehin anuazuite akungah ahing pei ua, “Tam gamsip mun ahi a, hun lah avaigeita a,
  </para>
  <para style="p">
    <verse number="36" style="v" />amauten ikim vel a loute leh khuote a ava pei ua aneh ding uh bang ahiei khat beh, alei theina ding un, sawlkhie in, neh ding bangma anei sih uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman adawng a akung uah, “Nouten neh ding bang ahiei pie un,” achi hi. Tuachi’n amaun akungah “Tanghou makhai zani man valeiin neh ding peding ka hi uoi?” achi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman akung uah “Tanghou pheng bangza na nei uoi? hing en vawi un,” achi hi. Tuachi’n amaun anei za uh athei tah un, “Tanghou pheng nga leh nga ni,” achi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuachi’n Aman abawn un loupa hing tungah apawl pawl a tousah dingin thu apie hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuachi’n amauh aguol in zakhat bang, sawmnga bangin atouta uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh Aman tanghou pheng nga leh nga nite ala a, vanlam en in aguolzawl a, tualeh tanghoute aphalsuo a, amasang ua luipieh dingin nuazuite kungah apie a, tualeh nga nite zong amaute zousie lah ah ahawmsah suohta hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tualeh abawn un ane ua, agilva chiet uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh aneh mawh uh tanghou nengte leh nga nengte seu sawm leh ni dim in aluoh uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tualeh tanghou nete khu pasal ngen tul nga vel ahi uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Aman mipite akikhensah sungin, nuazuite khu galkhat lam a Bethsaida khuo a na pei masa dingin kuong ah atuongsah pai hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tualeh mipite akikhensah nua in, thungen dingin muol ah apeita hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh nitahlam ahing hi tahin, kuong khu tuipi lai ah a umta a, Ama pen atangin tuol ah a umta hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tuachi’n Aman amauh khu huiin alelam lam a asem zieh a, kuong zap a, lungdong leh chimaw ahi uh amuta hi. Tuachi’n khovah kuon lamin tui tunga akenga peiin amauh lam hing zuon in, amauh peisuohsan atum hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Hinanleh Ama tui tunga keng a pei amu un, shiha khat hiva chi’n akikoukhie uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Abawn un Ama amu chiet ua, abuoita uhi. Tuachi’n amauh ahoupi pai a, “Hamuong tahin um un, Keima ka hibou hi, zau sih un,” achi hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tuachi’n kuong sungah akung uah atuong a, huipi atawpta hi. Tuachi’n amauten gen theiguollouin lamdang asa mama uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Amauten tanghou thute atheisiem nawn sih uhi, alungtang uh ana akhau taah zieh in.
  </para>
  <para style="p">
    <verse number="53" style="v" />Galkhat lam agalkai tah un, Genesaret gam ahing tung ua, khunah kuong akhi uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tualeh kuong akipat a ahing pawtdoh tah un, mipiten Ama ana theipai ua,
  </para>
  <para style="p">
    <verse number="55" style="v" />Khum gam kimvel a mite ahing tai khawm ua, Ama a um chi atheiphahna tan uah, damloute alupna pum in ahing zawng uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Heisung hinanleh, Khoneute leh kholiente, tualeh khopam lam ah zong alutna phot ah, damloute, vanzuona mun lah ah alumsah ua, Apuon mong beeh khoi theina angen vanguo ua, tualeh Ama khoi pouma adam zel uhi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Pharisaite leh laigiel mite lawikhat Jerusalem a kipat in akungah ahing hawkhawm uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh amaun anuazuite lawikhat in, khut bua pum a, chipen khut sillou a ann aneh uh amu tah un, dih asa sih uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aziehpen Pharisaite leh Judate zousiein upate thugousie azui chinten zieh un akhut uh hoitah a sillou in ann ane ngai sih uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh van zuana muna kipat a ahing pei chiengun kisil masa louin ann ane ngai sih uhi. Tualeh thugousie dang tampi azui uh a uma; tuate khu noute, belte leh taubelte silsieng bang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Pharisaite leh laigiel miten, “Bangdinga na nuazuite’n upate thugousie banga umlou a, khut sillou a, ann ne ahi uoi?” chi’n Ama adong uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Aman adawnga akung uah, “Isai in nou milepchiete thu ana genlawh khu adih ahi: Tam miten akam un ahing pahtawi ua, Hinanleh alungtang un kei ahing gamlat uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Kei ahing bieh ukhu amawhna ahi, mihing thupiehte thugin dan a ahilzieh un, chia gel bangin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aziehpen nouten Pasian thupieh na pampai ua, mihing thugousie na tudet chinten uhi; belte leh noute silsieng bang leh sil dang tampi tambang in na bawl uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Aman akung uah, “Na thugousie uh na zui theina dingun, Pasian thupieh tangtah in na pampai uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aziehpen Mosi in, Na nu leh na pa zatat in; koipou anu ahiei apa ahiei hamselaw khu shi teitei heh, achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh nouten mi khat in anu ahiei, apa ahiei kunga, Keima vang a na phattuomna ding uh “Korban” ahita tuakhu Pasian kunga (pieh ahita) achi uleh amapen azalen ding na chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh ama’n anu ahiei, apa ahiei, a dingin bangma abawlpieh ding na phal nawn sih ua;
  </para>
  <para style="p">
    <verse number="13" style="v" />na thugousie uh mi na piehsawn zieh un Pasian thu bangmalou na suohsahta uhi. Tualeh tambang sil tampi na bawl uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Aman mipi zousie akungah ahan a, akung uah, “Michin in ka thu ngaikhie unlen, theisiem un;
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihing pulam akipat a asunga lut a ama subua thei bangma a um sih hi; hinanleh ama a kipat a hing pawtdoh silte, tuate ngel khu mihing subua ahi zaw hi.”
  </para>
  <para style="p">
    <verse number="16" style="v" />“Mi koipou zahna ding bil nei in za heh,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh mipite inn sunga alutsan nua in, anuazuiten tua gente thu adong chienta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Aman akung uah, “Noute zong hichi va-ia a theisiemna neilou hi uchie izaw? Bangteng pulam akipata mihing sunga lut in, ama abuasah thei sih chi theilou na hi uoi mah?
  </para>
  <para style="p">
    <verse number="19" style="v" />Aziehpen lungtang sunga lut lou a, agil sunga alut zawh zieh in leh adailenna a pawtkhe mai ahi ziehin” achi hi. (Tua khu ann chinteng asieng achina ahi)
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Aman “Mihing sung a kipata hing pawt tuami ngelngelin mihing abuasah hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aziehpen sunglam a, mihing lungtanga kipat in, ngaituona giloute, angkawmnate, numei leh pasal zinei nailoute thangtatnate, tuolthanate;
  </para>
  <para style="p">
    <verse number="22" style="v" />guhtatnate, ennate, gitlounate, lepchienate, teletnate, kimitsipnate, kigensietnate, kiletsahnate leh mottatnate, bang ahing pawtdoh zel hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tam silgiloute zousie sunglam akipat hing pawt in mihingte asubua leng hi,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n adingdoh a, khuna kipat in Tai-ar leh Sidon gam sung ah apeita a, inn khat ah alut a koima thei ding adei sih a, hinanleh akiphuol zou sih hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n numei khat, atanu naupang nou dawi bua nei khat in atanchin ana za pai a, ahing pei a, akengbul ah abohkhupta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Numei khu Greek mi ahi a, piendan thu ah Siro-Phoinikia mi ahi, amanu’n atanu sunga dawi nawdoh pieh dingin angen hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hinanleh Jesu’n adawng a akungah, “Tate hing gilva phot uheh, tate tanghou lah pieh a uite kunga pieh akilawm sih hi,” achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh amanu’n adawng a, akungah, “Adih hi Mangpa, hinanleh dawkan nuoi a uiten zong tate ann-neng kia ane zel sam uh hilou i,” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Aman akungah, “Na thugen zieh in peita ve leh, dawi khu na tanu sunga kipat apawtta hi, achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh amanu apei a, inn ahing tuntahin, atanu dawiin apawt khietsan, lupna tunga lum a muta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Tai-ar gam akipat in apawt kia a, Sidon khuo, tawn in Dekapolis gam kantan zel in Galili tuipi ahing tungta hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n mi bilbing, ham zong ham chien theilou khat, akung ah ahing zawpi ua, atung a akhut koi dingin angen uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Aman mipi lah akipat in ama atuom in apeipi a, akhutmein abilsung akhoi pieh a, tualeh achil asiet a, alei akhoi a;
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n vanlam en in anahkhe huoi-a, akungah “Ephphatha” achi hi, tua khu “Kihongin” china ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n abilte ahing kihong pai a, alei akiham a, chientahin aham theita hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuachi’n Aman koima hillou dingin amauh thu apie a, hinanleh anah kham pou leh agenzah zaw sem sem uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh genthei guollou in lamdang asa ua, “Aman sil zousie abawl hoita hi, bilbingte khuo azasah a, ham theiloute aham sahta,” achi uhi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua hun lai in mipi atam mama ua, neh ding bangma anei sih ua, Jesu’n anuazuite akungah ahan a akung uah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mipite tuin ka kungah ni thum neh neilou a um ahi tahzieh un ka hepi mama hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh amaute a inn lang uah peisahta leng lamkaal ah abasam kha ding uhi; pawlkhatte gamla tah akipata hing pei ahi ngal ua,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n anuazuiten adawng ua, “Koiin tam gamdai ah mihing hizapi tanghou in avazou diei?” achi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n “Aman tanghou pheng bangza na nei uoi?” chiin adonga; tualeh amaun, “Sagi” achi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Aman mipite tuol a tou dingin thu apie a; tanghou beu sagi ala a, kipahthu agen a, aphalsuo a, tuachi’n amasang ua lui dingin anuazuite kungah apie a, tualeh amaun mipite masangah aluita uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh nga tawmnoukhat zong anei ua, Aman tuate aguolzawl a, tuate zong amasang ua lui dingin thu apie hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n ane ua, agilva chietta uhi; tualeh akham val nengte uh akhop u’leh seu sagi adim nalai hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anete khu mi tul li vel ahi ua; tuachi’n Aman amauh apeisah ta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Ama khu anuazuite toh kuong sungah atuong pai a, Dalmanutha gam atung ta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Pharisaite ahing pei ua, Ama ze etna dingin Ama akipat chiemtena ngen in Ama akinielpita uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hinanleh Ama khu alungsim in anah huoi a, “Bangding a tulai khangthaten chiemtena sui ahi uoi? Chitahtah in ka hing hil ahi, tulai khangthate kungah chiemtena mawngmawng akipesih ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh amaute nuasie in kuong ah atuong kia a, galkhat lam ah apeisanta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anuazuiten tanghou akeng manghil ua, tanghou pheng khat chilou kuong ah tanghou dang mawngmawng a nei sih uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Aman akung uah, “Pilvang unlen, Pharisaite leh Herod tol lah ah kiveng un,” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n amaun tanghou “I nei lou zieh ahi chiin akingaituo uhi.”
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Jesu’n atheitah in akung uah, “Bang dinga tanghou na neilou zieh ua kingaituo na hi uoi? Tutan a thei nailou leh theisiem nailou na hi uoi mah? Na lungtang uh tutan a tahsah nalai nahi uh maw?
  </para>
  <para style="p">
    <verse number="18" style="v" />Mit nei napi a mulou na hi uoi mah? Bil nei napi a za lou na hi uoi mah? Tualeh thei ngitnget lou na hi uoi mah?
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi tul nga lah a tanghou pheng nga ka phalsuo lai in aneng seu bangza ahiei na luoh dim uh?” achi hi. Amaun akung ah, “Sawm leh ni” achi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Tualeh mi tul li lah a sagi ka phalsuo lai in aneng seu bangza ahiei na luoh dim uh?” achi hi. Amaun “Sagi” achi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Aman akung uah, “Tu nangawn in na theisiem nalai sih uh maw?” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Bethsaida ah ahing tunga, akungah mitto khat ahing zawpi ua, Ama khoi dingin angen uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n Aman mittopa khut atu a, kho pulam ah apuidoh a, tualeh amit ah chil asieta, atunga khut akoi zouin, “Khuo na mu thei ei?” chi’n adong hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n amapa ahing dahkhie a, “Mite sing pei bangin ka mu hi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n amit ah akhut akoi kia a, amit ahahsah kia a, tuachi’n ahing damta a, mi chinteng chientah in amu theita hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Aman khosungah lut sinlen, “Khosung a mi koima zong hil sin, chiin a inn lam ah asawlta hi.”
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesu leh anuazuite apawtdoh ua, Kaisaria Philippi khuote ah apei ua, tualeh lampi ah anuazuite kungah, “Miten kei koi hi ahing chi uoi?” chiin adong hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh amaun, “Baptispa Johan ahi, ahing chi uhi, hinanleh kimkhatten, Elijah ahi, ahing chi uh, tualeh mi dangten, Guolneite lah a khat ahi, ahing chi uhi,” chiin adawng uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Aman akung uah, “Ahileh nouten kei koi hi na hing chi uoi?” achi hi. Tuachi’n Peter in adawnga, akung ah, “Khrist na hi,” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n Aman atanchin koima hil lou ding in amauh akhap chinten hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Aman akung uah, Mihing Tapa in sil tampi athuoh dingte upate, siempu liente leh laigiel mite, deilou a a um ding bang, leh tha a aum ding bang, tualeh ni thum nia a athaw kia dingte amauh ahil panta hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman tam thute kichien tahtahin agen hi. Tuachi’n Peter in Ama apui tuom a, aphawhta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hinanleh Ama akihei a, anuazuite a en a, Peter a phawh a, “Setan, ka nua ah pei in, Nang Pasian silte ngaituo louin, mihing silte na ngaituo zaw hi,” achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Aman mipite leh anuazuite ahan a, akung uah, “Mi koipou in ahing zui ut leh ama gimthuoh khohsa louin, a kros puain hing zui heh,
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi koipou ahinna humbit ut in ataan dinga, hinanleh mi koipou keima leh khantanhoi zieh a ahinna taanin ahumbit ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aziehpen mi’n leitung apum in nei henlen, ahinna tanta leh bang aphatuom diei?
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahisihleh, mi’n ahinna taangin bang ape diei?
  </para>
  <para style="p">
    <verse number="38" style="v" />Mi koipou tulai khangtha angkawm hat leh giloute lah a keima leh ka thu zumpi khu, Mihing Tapa in zong vansawlsiengthoute toh a Pa thupina a kivon a ahing pei chiengin tua mi khu azumpi ding hi” achi hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Aman akung uah, “Adihtah in ka hing hil ahi, Tamna ding lawikhatte, Pasian gam silbawltheina toh hing tung amu masangsie uh, shina chiem vawt lou ding a um uhi.”
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni guh nua in Jesu’n Peter, Jakob leh Johan azawpi a, atuom in muol sang tung khat ah amauh apei toupi a, tualeh amasang uah amel ahing kiheng lamdangta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n apuonsilte leitunga puonsawpmi koima’n tuabanga asawp ngou theilou ding khopin, vua bang mai in angouin ahing ngouta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Elijah leh Mosi akung ah ahing kilangta ua, Jesu toh akihou uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Peter in ahoupi a, akung ah “Rabbi, ei a ding in tana um ahoi hi; buh thum ibawl ding a, nanga ding khat, Mosi adingin khat, tualeh Elijah adingin khat,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Azau mama zieh un gen ding pen zong athei sih hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n meilum lom khat in amauh ahing lie a, tualeh meilum lah akipat in, aw ahing ging a, “Tami ka Tapa deitah ahi, ama thu ngai un,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thakhat in akimvel uh a et u’leh, Jesu chilou akung uah midang koima amuta sih uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Muol apat a ahing kumsuh lai un, Mihing Tapa shina lah a kipata athawkia masangsie asil mute uh koima kunga hillou dingin thu apie hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n tua thu khu alungsim uah avom chinten ua, Mishi laha kipat thoukia achipen bang achina adiei? Chi’n akidong uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh amaun, “Bangdinga laigielmiten Elijah hing pei masa ding ahi achi uh adiei?” chi’n, Ama adong uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Aman adawnga akung uah, “Elijah pen ahing pei masa a, sil zousie abawl hoi mawng ahi, ahileh Mihing tapa in sil tampi, athuoh dinga muda-a bawlsiet a um ding ahi chia, atungtang thu bangchi dan a kigiel adiei? achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh ka hing hil ahi, Elijah ahing pei zou thamta a, tualeh atanchin agel bang ngei un atung ah a ut ut un abawl zouta uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Ama anuazuite kunga ahing tuntah in akim ua mipi tampitah leh laigiel miten amauh ana kinielpi uh amu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh mipi zousie in Ama amu tah un, lamdang asa mama ua, akungah atai pai ua, chibai abuh uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Aman laigielmite kungah, “Amau’toh bang thu a kiniel na hi uoi?” chi’n adong hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n mipite lah a khat in ahing dawnga, “Siepa aw, Ka tapa dawi hamtheilou nei na kungah ka hing zawpi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amatna mun pou ah tuol satna’n akinei sah a, tuachi’n achilphuon abuo a, aha agawt a, agawng deu deu hi; tuachi’n na nuazuite kunga hing nawdoh pieh un ka chi leh, abawl thei sih uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Aman adawng a, akungah, “Ginna neilou khangthate aw, na kung ua bangtan ahiei ka um ding a, bangtan ahiei ka hing thuohpi nahlai ding? ama khu ka kungah hing pui in,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n ama khu Jesu kung ah ahing zawpi ua, tualeh dawiin Ama amu tahin napitahin asugenthei pai a, tuachi’n tuol ah apua a, chilphuon kai niainuai in akilumlet kawi kawi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Aman apa kungah, “Tambanga ahing umna bangtan ahi tai?” chi’n a dong hi. Tuachi’n apa’n “Anaupan lai a kipan ahita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh sumangthai dingin tamveipi mei ah leh tui ah asawnpua a; hinanleh Nangman bang ahiei khat beh na bawl thei leh hing hepi inlen, hing panpi in,” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n akung ah, “Na gintat pou leh agingtate a dingin sil zousie bawl thei ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n naupangpa pa khu akikoukhe pai a, mit hi luong pum in, Mangpa “Ka gingta hi, ka ginlana hing panpi in,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu’n mipi hing taikhawmte amu tahin dawi bua khu aphawh a, akungah, “Nang hamtheilou leh bilbing, thu ka hing pie hi, asung apat hing pawt inlen lutkia nawn sin,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n dawi khu akikoukhie a, hatangpiin abawlgenthei a, tuazou in apawtta hi. Tualeh naupang khu mishi bangin a um a, mitampiten “Ashi ahi” achi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hinanleh Jesu’n ama khu akhut in atu a, aphonga, tuachi’n ahing thouta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Jesu inn sunga ahing lut tah in, anuazuiten “Bangdinga kouten notdoh theilou ka hi uoi leh?” Chiin simthamin a dong uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Aman akung uah, “Tambangte pen thungetna leh ann ngawlna loungal in apawt thei sih hi,” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n khuna kipat in apeidoh ua, Galili gam akantan ua, tualeh koima thei ding a ut sih hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aziehpen anuazuite thu ahil a, akung uah, “Mihing Tapa khu mihingte khut a matsah ahi ding a, tuachi’n athat ding ua, atha nua uh ni thum ni in athoukia ding,” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hinanleh amaun athugen atheisiem sih ua, Ama lah a dong ngam sih uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n Ama khu Kapernaum khuo ahing tunga, inn sunga a um lai in, anuazuite kungah, “Lampi a na kinielna uh bang thu ahiei?” chiin adong hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hinanleh amauh hamlouin a um ua, aziehpen lampi ah koi ahiei alien pen ding chiin ahing kiniel malamta uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Ama atou a, sawm leh nite ahan khawm a, akung uah, “Mi koipou amasa pen a ut leh anukhiapen ahi ding a, tualeh mi zousie nasem in a um ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuachi’n Aman naupang neu khat akai a, alah uah ading sah a, tualeh apom a, akung uah,
  </para>
  <para style="p">
    <verse number="37" style="v" />mi koipou ka min a tambang naupang neu nou kipahpi pouma “Keima hing kipahpi ahi; tualeh Keima hing kipahpi pouma khu kei hing kipahpi ahisih a, kei hing sawlpa kipahpi ahi” zaw ding uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Johan in akungah, “Siepa mi khat na min a dawite notdoh ka mu ua, aman eite ahing zuilou zieh in ka khamta uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hinanleh “Jesu’n ama kham sih un, aziehpen ka min a sil lamdang bawl ngal a anua chienga Kei hing gense pai mi a um sih hi, chi’n ama adawng hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Koi hitaleh ei hing doulou pouma khu ei lam a pang ahi uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Koipou Khrist mi na hi zieh ua ka min a dawn ding tui nou khat hing pe pouma khu, chitahtahin ka hing hil ahi, akipahman mu ding ataan vawt sih ding hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tualeh “Koipou kei hing gingta tam naupang neu nounoute lah a khat zong puasah mi khu angawng ah sumheh suong kikhi henlen tuipi ah kipailut leh ama adingin ahoizaw ding hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh na khut in ahing puasah leh tankhie in. Khut ni nei a gawtmun mei mit theiloua na lut sangin; khut neilou a hinna a lut nanga dingin ahoizaw ding hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Athan uh ashi louna leh, meikuong ami louna ah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tueleh na kengin ahing puasah leh tankhie in; keng ni nei a gawtmun mei mit theilou a na lut sangin, kengbei a hinna a lut nanga dingin ahoizaw ding hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Athan uh ashi louna leh meikuong ami louna ah.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh na mit in ahing puasah leh kheikhie in, mit lang ni nei a gawtmun mei kuonga pailut a na um sangin mit langkhat nei a Pasian gam a lut nang a dingin ahoizaw hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Athan uh ashi louna leh meikuong a milouna ah.
  </para>
  <para style="p">
    <verse number="49" style="v" />Aziehpen michin meikuonga saw-al in a um dinga kithoina chinteng chi a saw-al in a um ding hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chi pen ahoi a, hinanleh chiin a alna mansuo taleh, bang nachi alsah kia ta diei? Nouma mama ah chi kinei unlen, khat leh khat kilemtah in um un,” achi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n khuna kipat in adingdoh a, Jordan luigal lang khat a Judia gam ah apeita hi. Tualeh mipite akungah ahing kikhawm kia ua, Aman abawl ngaina bangin, thu ahil hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pharisaite ahing pei ua, “Ama ze etna dingin mi’n azi akhul asieng ei?” chi’n a dong uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Aman adawng a, akung uah, “Mosi in noute bang thu ahing pie ei?” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n amaun “Mosi in kikhulna lai giel a, kikhul aphal hi,” achi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Jesu’n adawnga, akung uah, “Na lungtang khau zieh ua, tam thupieh noute ding a, ahing na gelpieh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh leitung siem chiil a kipat in Pasian in amauh Pasal leh numei in asiem hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tam thu ziehin pasal in anu leh apa anuasie ding a azi langah abeh chinten ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n ani un sa pum khat ahita ding ua; tuachi’n ni ahi nawn sih ding ua, tahsa pumkhat ahizawta ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuaziehin Pasian in agawmsa khu mihingin khen sih heh, achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh inn sung ah anuazuiten tua thu khu Ama adong uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Aman akung uah, “Mi koipou in azi akhul a, zi dang anei leh azi a angkawmsan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh numei in apasal akhul a, mi dang anei leh angkawm ahi hi.”
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n akhoi theina dingin naupangte akung ah ahing pui ua; hinanleh anuazuiten ahing puite ana phawh uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinanleh Jesu’n tua khu amu tahin alungkimta sih a, akung uah “Naupang neute ka kungah hing peisah unlen kham sih un, aziehpen Pasian gam khu hichibang mite a ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Adihtahin ka hing hil ahi, mi koipou naupang neute banga Pasian gam kipahpi lou pouma asung ah alut sih ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Aman amaute apom a, atung uah akhut akoi a, amauh aguolzawlta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh lampi a pei dinga apawtdoh laiin, mi khat ahing tai a, Amasangah akhupdin a, akung ah, “Siepa hoi, kumtawn hinna ka tan theina ding in bang ahiei ka bawl ding?” chi’n adong hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Jesu’n akungah, “Bangding a hoi hing chi na hiei? Mi khat chiloungal ahoi Koima a um sih, tua khu Pasian ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thupiehte na thei vele, angkawm sin, tuolthat sin, Gu sin, theipitu dihlou in pang sin, mi sol sin, Na nu leh na pa zatat in, chite ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n aman adawng a akung ah, “Siepa aw, tamte zousie, ka naupan lai a kipat a ka zui ahita hi,” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Jesu’n ama a en a, a itta a, akung ah, “Sil khat na sam nalai hi; pei inlen na neiteng zua inlen, mi zawngte kungah pie in, tuachi’n van ah gou na nei ding hi; tualeh hing pei inlen kross puo in hing zui in,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n amapa khu tua thu ah amai ahing muola, lunggim tahin apeita a, sum tampi nei mi ahi zieh in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n a kimvel a en a, anuazuite kungah, “Mi hausate Pasian gam a lut hasat tuoh na mai e!” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh anuazuiten athugente lamdang asa thei mama uhi. Hinanleh Jesu’n adawngkia a, akung uah, “Tate aw, hausatna muongte dingin Pasian gam a lut hasa hina va-ia e!
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi hausa Pasian gam a alut sangin, Sangawngsau phin bil vanga alutsuoh abailam zaw hi,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n amaun genthei guollouin lamdang asa ua, tuabang ahileh “Koi hundam in a um zou diei?” akichi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Jesu’n amauh a en a, “Tua khu mihing a dingin bawlguol ahisih a, hinanleh Pasian a dingin ahi theilou ahisih hi, aziehpen Pasian a dingin sil zousie ahi thei hi.”
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Peter in akungah, “En vawi, kouten bangkim nuasie in ka hing zui ua, chi’n ahing gen panta hi.”
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuabep in Jesu’n a dawnga, “Adihtahin ka hing hil ahi, mi koipou keima zieh leh khantanhoi zieh a, inn ahiei, sanggampa ahiei, sanggamnu ahiei, pa ahiei nu ahiei, zi ahiei, tate ahiei, tualeh gamte ahiei nuasie khu;
  </para>
  <para style="p">
    <verse number="30" style="v" />tu dam sung mama in, innte, sanggampate, sanggamnute, nute, tate leh bawlgentheinate toh, ale za a mu lou ding a um sih uh, tualeh hun hing tung ding a kumtawn hinna toh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinanleh mi tampi amasapente anukhia pente ahi ding ua, anukhiapente amasapente ahi ding uhi.”
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaute Jerusalem khuo zuontou a lampi a apeitou lai un, Jesu amasang uah apei a, tualeh amaun lamdang asa mama ua, azuipum un azau uhi. Tuachi’n Aman sawm leh nite atuom in azawpi kia a, atunga sil hing tung dingte ahil panta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Ngai un, Jerusalem khuo a hawtou ding ihi ua, Mihing Tapa khu siempu liente leh laigiel mite kunga matsahin a um dinga, tualeh ama khu shi dingin amawpai ding ua, Jentelte khut ah apekhe ding ua;
  </para>
  <para style="p">
    <verse number="34" style="v" />amaun apmai bawlna’n anei ding ua, ajep ding ua, chil asietkhum ding ua, tualeh athat ding ua, tualeh ani thum ni in athoukia ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Zebedi tapate Jakob leh Johan ahing pei ua, akung ah, “Siepa ka nget pouma uh nang bawlpieh ding ka ut uhi” achi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh Jesu’n akung uah, “Nou a dingin bang hing bawlpieh leng na ut uoi?” achi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n amaun akungah, Na thupina ah, khat na zietlam ah, khat na veilam ah hing tousah in, achi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hinanleh Jesu’n akung uah, “Bang ahiei na nget uh na thei sih uhi; ka nou dawn ding na dawn thei ding uoi? tualeh Ka baptisma tan ding zong na tang thei ding uoi?” achi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuachi’n amaun akungah, “Bawl ngam e,” achi uhi. Tuachi’n Jesu’n akung uah, Ka dawn ding nou pen na dawn ngei ding ua, tualeh ka baptisma tan ding zong na tang ngei ding uh;
  </para>
  <para style="p">
    <verse number="40" style="v" />hinanleh ka zietlam leh ka veilam a tou ding pen Kei pieh ding ahi sih a, ama-ua ding a kibawlpiehte ading ahi zaw ding hi, achi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh sawmten tua thu azah tahun, Jakob leh Johan tungah alungkim tasih uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu’n amauh ahan a akung uah, “Jentelte tunga vaihawm dinga a guotte uh atung uah alal mama ua, ami liente un atung uah thuneina toh vai ahawm uh, chi na thei uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hinanleh noute lah ah tuabang ahi sih ding hi, mi koipou na lah ua mi lien hi ut khu na nasem un apang zaw ding hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tualeh mi koipou na lah ua, masa pen ut khu mi zousie suoh a apan masah ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Aziehpen Mihing Tapa zong miten a nna aseppieh dinga hing pei ahi sih a, mite nasep pieh ding leh mi tampi tatna dinga ahinna pe dinga hing pei ahi zaw hi,” achi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tuachi’n Jerikou ah ahing tung ua; tuachi’n Jesu Jerikou akipat in anuazuite leh mipi tampi toh apeidoh lai un, Timai tapa Bartimai mitto lam gei ah khutdawin ana tou hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh Nazareth Jesu ahi chi azah tahin “Jesu’n, David tapa kei hing khotuo in,” chiin akikouta hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tuachi’n mi tampiten ama sip dingin akham ua, hinanleh ama’n “David tapa kei hing khotuo in” chi’n akihakou semsem hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tuachi’n Jesu ading a, “Ama hing han un” chiin thu apie hi. Tuachi’n amaun mittopa ahing han ua, akung ah, “Hamuong tahin um inlen, thou in, Aman nang ahing han hi” achi uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tuachi’n aman apuonsilte paikhie in ading a, Jesu kung ah ahing peita hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tualeh Jesu’n ama ana houpi a, akungah, “Na tungah bang bawl leng na ut ei?” achi hi. Mittopa in akung ah, “Mangpa mu thei ka ut hi,” achi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tuachi’n Jesu’n akung ah, “Peita in, na ginna in ahing dam sahta hi,” achi hi. Tuachi’n amit ahing vah paita a, lampi ah Jesu azuita hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Jerusalem kunga Olive muol a Bethphage leh Bethani khuo kung ahing tun tah un, anuazuite lah a mi ni asawl a;
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman akung uah, “Na mai zawn ua khuo ah vapei unlen, na lut tah chieng un, sabiltung nou kikhi, atunga koima tuon ngailouna khat na mu ding ua, tua khu hing sut unlen, hing kai un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh mi koi ahiei in na kung ua, bang dinga na sut uh ahiei? ahing chi leh Mangpa’n atulmaw ahi, tammun ah ahing koi kia pai na ding hi,” chi un achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n amauh ava peita ua, gawlzinga kot pulam a, sabiltung nou kikhi ava mu ua, tua khu asutta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh khuna ding koite ahiei in akung uah, “Bangdinga sabiltungnou sut na hi uoi?” achi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n amaun akung uah, Jesu’n thu apieh bangin agen ua, tuachi’n apei sahta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n amaun sabiltungnou khu Jesu kungah ahing kai ua, atungah apuonte uh apha ua, tualeh atung ah atuongta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh mi tampi in apuonte uh lampi ah apha ua, adangten zong gamlah a sawlbawhte satin lampi ah apha uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n amailam a peite leh anua lam a zuiten “Hosanna! Mangpa min a hing pei ahampha hi!
  </para>
  <para style="p">
    <verse number="10" style="v" />Gam hing tung ding ipa David gam ahampha hi; Tungnung pen ah, Hosanna,” chiin akikou uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Jesu Jerusalem a Pasian bieh inn ah a lut a, tuachi’n sil zousie a et kimvel zou in, nitah lam zong ahing hita a, sawm leh nite toh Bethani khuo ah apeita uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Azing ni in Bethani akipata ahing pei lai un, agil ahing kielta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh theipi kung na-pha mama khat gamlapi a um a mu a, aga ka mu khahleh chin ava zuon a, amun atun tahin, anaa loungal bangma amu sih hi; theipi ga hun ahi lou zieh in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Jesu’n theipi kung ahoupi a, “Tubansie bangchitan in, nanga kipat koiman ga ne nawn sih heh” achi hi. Tualeh anuazuiten tua khu aza uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Jerusalem ahing tung ua, tualeh Jesu Pasian bieh inn ah alut a, biehinn sunga van zua leh leite anotdoh panta a, sum heng mite dawkante leh palva zuate tounate asawnpua piehta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Pasian biehinn a koiman van alut peisuohpi uh aphal sih hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Aman akung uah, “Ka inn khu namchin dinga thunget na inn akichi ding, chia kigiel hilou ahiei mah? Hinanleh nouten gutate muna munpi inn na bawlta uhi.”
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh laigiel mite leh siempu lienten tam thu aza ua, Ama asuhmangthai theina ding uh asuita uhi; mi zousie’n athuhilte lamdang asah zieh un, Ama agiingta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh nitahlam ahing hitahin, khopi akipat in apawtdoh ta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zingmawnga ahing pei kawm un theipi kung khu azung tandonga agaw gawp khu ahing muta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Peter in hing theidoh in akungah, “Rabbi en vawi, theipi kung na hamsiet khu agaw gawpta hi” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Jesu’n adawnga, akungah, “Pasian ah ginna nei un.
  </para>
  <para style="p">
    <verse number="23" style="v" />Adihtah in ka hing hil ahi, mi koipou in tami muol kungah, kisuondoh inlen, tuipi ah kipailut in, chia alungtang a ginglel lou kei a agen khu hing tung ngeingei ding a hi, chia gingta poumain agen pouma amu ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaziehin na kung uah ka gen ahi, sil bangkim na thum chieng ua na nget pouma uh, musa in kingai un, tuachi’n na mu ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh thungen a na din pouma chieng un, koi tung hitaleh na lungdam louna uh aum leh, ngaidam un; tuachi’n na Pa uh van a um in zong na khelnate uh ahing ngaidam theina dingin.”
  </para>
  <para style="p">
    <verse number="26" style="v" />Hinanleh na ngaidam sih u’leh, “Na Pa uh van a um in zong na khelnate uh ahing ngaidam sih ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Jerusalem khuo ah alut kia ua; tualeh Pasian biehinn sunga avah kawi lai in, siempu liente leh laigielmite akung ah ahing pei ua;
  </para>
  <para style="p">
    <verse number="28" style="v" />akungah, “Bang thuneina na nei a, tam silte na bawl ahiei? tualeh tam silte bawlna dinga thuneina hing pie koi ahiei?” achi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hinanleh Jesu’n adawnga akung uah, “Ken zong thu khat ka hing dong ding, hing dawng un, tuachi’n bang thuneina nei a tam silte ka bawl ahiei, chi ka hing hil ding.
  </para>
  <para style="p">
    <verse number="30" style="v" />Johan Baptisma khu van akipan ahiei, mihing a kipan? hing dawng un,” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n amauh “Akingaituo ua, van apat chilei lah, bangding a ama gingta lou, ahing chiding a;
  </para>
  <para style="p">
    <verse number="32" style="v" />hinanleh mihing akipat ichi mai ding ade aw!” akichi ua, hinanleh mipite agiing zel ua, aziehpen mi zousie in Johan khu guolnei tahtah in a bawl chiet uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n amaun Jesu adawng ua, akung ah, “Ka gen thei sih uh,” achi uhi. Tuachi’n Jesu’n adawng a, akung uah, “Ken zong bang thuneina nei a, tam silte bawl ka hiei chi ka hing hil sih ding hi,” achi hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Aman akung uah gentena thuin thu agen panta hi. “Mi koi ahiei in grep huon abawl a, daiin aim kimkot a, grep tui suhna khuh atou a, inn sang khat alam a, louhoumite kung ah, asan in apie a, gam dang ah apeisanta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh aga law hunin, huon a ga atan ding lou houmite kunga kipat va la dingin lou houmite kungah asuohte khat asawl hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh amapa ana man ua, avua ua, khut guohin asawl kiata uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n aman asuoh dangkhat asawl kia a, amapa suongin ana sep ua, alutang ana suliem ua, zumhuoi taha na bawl in asawlmangta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n aman suoh dang khat asawlkia a, ama ana that ua, tualeh adang tampi zong, kimkhatte avua ua, kimkhatte athat uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuaziehin tuin tapa ittah khat anei nalai a, ka tapa pen azatat ding uh, chi’n ama zong anukhiapen in akung uah asawlta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh tua lou houmiten, Tampa pen gouluo dingpa ahi; hing pei un, ithat ding ua, agouluo ding khu ei a ahi mai ding hi, akichi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n ama khu aman ua, athat ua, tualeh grep huon pulam ah apaita uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuazieh in grep huon neipa’n bang a bawlta diei? Ama ahing pei dinga, lou houmite asumang dinga tualeh grep huon khu mi dangte kungah ape ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tam Laisiengthou a kigiel: Inn lam mite suong deilou pen, tua ngel ngel khu, aninga suong phatuom pen ahing hita hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tam khu Mangpa bawl ahi, imitmu uah alamdang hi. Kichi simkha ngailou na hi uoi mah?” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Ama mat atumta uhi, agentena thu khu amauh agenna ahi chi athei ua, hinanleh mipite agiing ua, tuachi’n Ama anuasie ua, apeimangta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n amaun athugente a man dingin Pharisaite leh Herod pawl ami koite ahiei Ama kungah asawl uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amauh ahing tun tah un, akungah, “Siepa Nang mi dihtah na hia, deisah tuom koima na nei sih a, mihing koima zatat tuom zong na nei sih hi, hinanleh Pasian lampite dihtahin na hil zel chi ka thei uhi. Kaisar kunga sie pieh adih ahiei, dihlou?
  </para>
  <para style="p">
    <verse number="15" style="v" />Pe ding ka hi uoi ahisihleh pelou ding ka hi uoi?” achi uhi. Hinanleh Aman alepchie dan uh athei a, akung uah, “Bangdinga hing ze et na hi uoi? Makhai khat hing tawi un ka en ding” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n ahing tawi ua, tualeh Aman akung uah “Tam koi lim leh koi min ahiei?” achi a, tualeh amaun “Kaisar a,” achi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Jesu’n adawng a, akung uah, “Kaisar silte Kaisar kungah pie unlen, Pasian silte Pasian kungah pie un,” achi hi. Tuachi’n amaun lamdang asa mama uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Saddukaite mishi thawkiana a um sih chite akungah ahing pei ua,
  </para>
  <para style="p">
    <verse number="19" style="v" />“Siepa, Mosi in mi khat asanggampa’n ta neilou in azi shisan taleh, asanggampa’n a zi luoin asanggampa a ding a ta ahinpieh ding ahi, chi’n ahing gelpieh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuin sanggam pasal sagi a um ua, a upa penin zi anei a, hahlesuon neilou in ashita hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n anina pa’n amanu akitenpi a, hahlesuon neilou in ashi zel a, tualeh athumna pa’n zong hichi mabangin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n asagi un akitenpi chiet ua, hahlesuon neilou in ashi chietta uhi, tualeh atawp ah tua numei zong ashita hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuazieh in mishi lah akipat thawkiana ni a, ahing thawkia chieng un, alah ua koipen zi ahita diei leh? Asagi un akitenpi chiet ngal ua,” chi’n adong uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu’n amauh adawnga, akung uah, “Tamte zieh hilou ahiei mah, na theikhel zelna uh, Laisiengthou leh Pasian silbawltheina na theilou zieh un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mishi lah akipat athawkia chiengun, zi leh pasal in akiteng nawn sih ding ua, hinanleh van ah vansawlsiengte abang zawta ding uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hinanleh Mishite kaithaw a a um ding thu uh, Mosi laibu a, sawlbawh lah a, Pasian in, kei Abraham Pasian, Isaak Pasian leh Jakob Pasian ka hi, chia ahoupi dan simkha lou na hi uoi amah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama pen mishi Pasian ahisih a, mihing Pasian ahi zaw hi, tuaziehin nah theikhiel na va-ia uchie,” achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n laigiel mite lah a khat ahing pei a, akiniel uh aza a, Jesu’n amauh hoitahin adawng chi athei a, Akungah “Thupieh tengteng lah a masa pen bang ahiei?” chiin adong hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n adawnga akung ah, “Thupieh zousie lah a masa pen khu, Israelte Aw Ngai un, Mangpa i Pasian u’khu, Mangpa khat ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Mangpa na Pasian khu, na lungtang zousie, na hinna zousie, na lungsim zousie, tualeh na hatna zousie toh, na it ding ahi. Tami Thupieh masa pen ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ani na khu tami ahi, Nangma na ki it bangin na innvengte na it ding ahi. Tamte sang a thupi zaw thupieh dang a um sih hi, achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n laigiel mipa’n a kung ah, “Adih hi, Siepa thudih na gen hi, Pasian khat a um a, Ama chilou adang a um sih.”
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama khu lungtang zousie a, theisiemna zousie a, hinna zousie a, tualeh hatna zousie a it a, tualeh eima iki it bang a innvengte it khu, halmang sillat leh kithoina zousie sangin ahoizaw hi,” achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n pil tahin adawng chi Jesu’n athei tahin, akungah, “Pasian gam akipat na gamla sih hi,” achi hi. Tuami nua kalsie koiman thu adong ngamta sih uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Jesu’n Pasian bieh inn a thu ahil laiin amauh ahoupi a, laigiel miten, “Khrist khu David tapa ahi, bangchidan a achi uh ahiei?
  </para>
  <para style="p">
    <verse number="36" style="v" />Ama David ngel in, Hagau Siengthou in: Mangpa’n ka Mangpa kung ah, Na melmate na keng ngapna a ka bawl masangsie in ka ziet lam ah touin, achi a, achi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuazieh in David ngel in Ama khu Mangpa ahi, achi ngal a, hei akipat a Ama atapa hi ata diei?” achi hi. Tualeh mipi vantangin kipahtah in athu angaikhie uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tuachi’n Aman akung ua athuhilna ah, “Laigielmite lah ah kiveng un, amaute puontuol sil a, van zuana munte a chibai buh bang a ut uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh kikhopna inn a toupha hoipen leh annkuongluina a mun hoi pen bang angaina tuom uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Meithaite inn sungte anegam ua, tualeh sawtpipi thungen khem akipang uhi, tuabang miten mawpaina lienzaw sem amu ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tuachi’n Jesu sumkoina lelam pang ah atou a, mipiten sumkoina bawm a asum khieh dan uh a en a, tualeh mi hausa tampiten, tampipi akhie uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tuachi’n meithai zawng mama khat ahing pei a, paisa san ni ahing khie hi, tuakhu paisa khat toh kibang ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tuachi’n Aman anuazuite ahan a akung uah “Adihtahin ka hing hil ahi, sum kholna bawm a sum khete zousie sangin, tam meithai zawng tahin akhe tam pen hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Aziehpen amaute zousiein aneival uh akhieh uh ahia, hinanleh tam meithainu’n anei zousie akitundingna ding teng akhieh sieng ahi,” achi hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Pasian bieh inn akipat apeidoh lai un anuazuite lah a mi khat in, akungah, “Siepa, en vawi, asuongte bangchituh a lien a, akilam dan bangchituh a thupi atai,” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Jesu’n adawnga, akungah, “Tam inn thupitah na mu maw? Suhchip lou a, suong khat tunga khat kichieng mawngmawng tanah a um sih ding,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Olive muol tung a Pasian bieh inn lam nga a atou lai in, Peter, Johan, Jakob leh Andru ten simtham in akung ah,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Tam silte bangchih chieng a hing tung ding adiei? Tualeh tam silte hing tun ding chiengin chiemtena bang ahing um diei?” hing hilin chi’n adong uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Jesu’n amauh adawng a, akung uah, “Koiman ahing sol louna dingun pilvang un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aziehpen, Kei Khrist ka hi chiin mi tampi ka min in ahing pei ding ua mi tampi asol ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh gal thute leh kidou thuthangte na zah hun chieng un lunggim sih un, tuate ahing tung ding mawng ahi; hinanleh atawpna ahi nai tadi sih ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nam tuom leh nam tuom akidou ding ua, gam tuom leh gam tuom akidou ding uh, tualeh mun tuom tuom ah zil akiling dinga, kielte leh buoinate atung ding hi, tamte nauvei kipatna ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Hinanleh pilvangun, vaihawm mite khut ah ahing mansah ding ua, kikhopna innte ah ahing vaw ding ua, tualeh keima ziehin gam uhte leh leengte mai ah theipina pe dingin na hing ding ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh khantanhoi khu nam zousie kunga gen masah ahi ding.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh ahing mat ua, ahing pieh doh hun chieng un bang ka gen diei chi’n kingaituo masa sih un, hinanleh ahun tah a hing kipeteng gen zaw un, aziehpen agen pen nouma na hi sih ding ua, Hagau Siengthou ahi zaw ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh sanggampa’n sanggampa tha dingin amansah ding a, tualeh pa in ta amansah dinga, taten zong nu leh pate a dou ding ua, athat sah ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Keima min zieh in mi zousie huot na hi ding uhi, hinanleh atawp donga thuoh zoupa khu hundam in a um ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Hinanleh guolnei Daniel in ana gen sumangthaipa kidahhuoi khu adin louna dinga ding na mu chiengun (asim poumain aumdan thei heh) tua hun chiengin, Juda gam a umte muol tung ah tai uheh;
  </para>
  <para style="p">
    <verse number="15" style="v" />Inn tunga umte kumsuh sih heh, a inn sunga sil umte lakhe dingin va lut sih heh;
  </para>
  <para style="p">
    <verse number="16" style="v" />lou a umte zong apuon la dingin nuakia sih heh,
  </para>
  <para style="p">
    <verse number="17" style="v" />tua ni chiengin gaite leh nausen neite tung agih ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua hun khu phalbilai ahilouna dingin thu ngen un.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aziehpen khum nite banga gimthuohna thupi mawngmawng Pasian in leitung asiem chiila kipat tuni tandong a um ngai nai sih a, um zong a um kia nawn sih ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Mangpa’n tua nite sutom sih leh mihing mawngmawng hingin asuohta sih ding uhi; hinanleh mi tel, ateltuomte ziehin, anite asutomta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n tua hun chienga mi koi pouin na kung ua, En un, tanah Khrist a um, ahisihleh En un, khunah Khrist a um, achi uleh tahsang sih un.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aziehpen Khrist tahlou leh guolnei tahlou ahing pawt ding ua, tuaten chiemtenate leh sil lamdangte mite solna in a ensah ding uhi, hithei leh telte nangawn asol ding uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh pilvangun, en un, sil zousie ka hing hil masa zou siengta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Hinanleh khum nite a, tua gimthuohna tun zou chiengin, ni suhmiel in a um ding a, hapi zong avah nawn sih ding hi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Vana kipat in aasite ahing kesuh ding ua, van a silbawltheina umte suhlingin a um ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua hun chieng in Mihing Tapa silbawltheina leh thupina toh meilum lah a hing pei amu ding uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua hun chiengin, Aman avansawlsiengte a sawldoh ding a, atelte lei ning li a kipat, kawlmong leitawpna kipat in van tawpna dongin, akhawm khawm ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Tuachi’n theipi kung ah gentena thu zil un, abate ahing dawn suong a, anate ahing sel chiengin nipi anaita chi na thei uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuamabangin nouten zong, tam silte ahing tun na mu chiengun, Ama ahing naita a, kotkha bul ah a umta, chi thei un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Adihtahin ka hing hil ahi, tam silte zousie atunkim masangsie’n tulai khangthate amang sih ding uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lei leh van amang dinga, ka thu ahileh amang sih ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Hinanleh tua ni leh ahun pen Pa loungal koima’n, van a vansawlsiengten zong, Tapa in zong, athei sih uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pilvang unlen, kigingsa a um in thungen un, ahun na theilou zieh un.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mi khat a inn nuasie a, asuohte kunga thuneina pie a, anasep ding uh pe chiet a, kotkha vengte zong kiging ding a thu pe phot a, gamlapi a va khuolzin bang ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuazieh in Kiging zing un, inn neipa hing pei ding hun, nitah ahiei, zanlai ahiei, Aa khuon hun in ahiei, ahisihleh zingmawngin ahiei, chi na thei sih uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahisihleh thakhat in hing pei khataleh imu in ahing mu kha ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh na kung ua ka gen khu mi zousie kunga ka gen ahi, kiging zing un.”
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni ni nuain Peikan pawi leh tanghou tolsawlou pawi um ding ahi a; siempu liente leh laigielmiten Ama khu solbawl a, mat a, tha theina ding dan asui uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hinanleh pawi hun sung hi da heh, tuachilou in mipi vantang lah ah, buoina hing um kha va,” achi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Bethani khuo a Simon miphapa inn a a um lai a, annkuong a im lai in, numei khat alabastar bawm a spiknard sathau gimnamtui man tamtah tawi in ahing pei a; tualeh amanu’n abawn a tawkeh a, alutung ah asungta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh alah ua lungkimlou pawlkhat a um ua, “Bangding a tam thau gimnamtui kimawh suhmang ahiei?
  </para>
  <para style="p">
    <verse number="5" style="v" />Tam sathau namtui makhai zathum sanga tamzaw a zua a, migentheite kunga pieh thei ding ahi,” achi ua; atungah aphunta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh Jesu’n “Amanu khu aum umin umsah un, bangdinga subuoi na hi uoi mah? Ka tungah sil hoi abawl ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aziehpen mi gentheite na kung uah a um zing ua, na ut hun hun un na panpi thei uhi, hinanleh kei pen na kung uah ka um zing sih ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanu’n abawl thei khamkham abawl ahita hi, ka sapum vui dinga sathau anu masah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Adihtahin ka hing hil ahi, leitung pumpi a tam khantanhoi kigenna phot ah, tam numeinu sil bawl amanu theizingna dingin akigen ding hi, achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Juda Iskariot, sawm leh nite lah a khat in Jesu zuousana amat sah theina dingin siempu liente kung ah ava hawta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n tami athei tah un, akipah ua, ama sum pieh achiemta uhi. Tuachi’n aman amatsahna ding lemtang asuita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh tanghou tolsawlou pawi ni masapen peikan pawi belamnou agaw ni un, anuazuiten akung ah, “Peikan annkuong na neh theina dingin, heisung ah vabawl u’leng na ut ei?” achi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Aman anuazuite ni asawl a, akung uah, “Khopi sung va lut unlen, khunah pasal bel a tui puo khat in ahing tuoh dinga, ama zui un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh na lutna penpen uh inntehpa kungah, Siepa’n Ka nuazuite toh peikan annkuong ka neh na ding uh mikhuol pindan heisung ahiei? achi hi chi un.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n ama’n inndan tungnung lientah vanzah ding umsa leh guotsa diem a um ahing ensah ding a, tuanah ei a dingin bawl un,” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n anuazuite apawtta ua, khopi sungah ava lut ua, akung ua agen bangin ava mu ua, peikan annkuong luina abawlta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nitahlam ahing hitahin Ama sawmlenite toh ahing peita uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh tou a, ann aneh lai un, Jesu’n “Adihtahin ka hing hil ahi, na lah ua mi keima toh ann ne khawm khat in ahing zuousan dinga, ahing mansah ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh alungdong panta ua, khat khat in a kung ah kei ka ma leh? achi ua, aban ban in “Kei ka ma leh?” achi chiet uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Aman adawnga akung uah, “Sawm leh nite lah a mi khat, ka annkuong sawhkhawmpipa ahi, achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing Tapa atungtang thu ana gel bangtah un apei ding a, hinanleh Mihing Tapa zuousan a mansah dingpa tung a gih hi. Tua mihing khu piengda vanglah leh ama adingin a hoi zaw ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n aneh lai un, Jesu’n tanghou ala a, aguolzawl zouin aphalsuo a, akung uah apie a, “La unlen ne un, tami ka tahsa ahi.”
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n nou ala a, kipahthu agen zouin, akung uah apie a, tuachi’n abawn un adawn chietta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Aman akung uah, “Tami kasisan mi tampi a dinga luong thuhun tha khu ahi, achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Adihtahin ka hing hil ahi, Pasian gam a atha a ka dawn ni atun masangsie in grepgui a ga ka dawn nawn sih ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh la khat asah zou un, apawt ua olive muol ah apeita uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Jesu’n akung uah, “Tuzan chiengin na bawn un ka tung ah na lungke sieng ding uhi; Aziehpen, belamchingpa ka sat dinga, Belamte akithethang ding uhi, chi gel ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hinanleh ka thawkia zou chiengin Galili gam ah na masang uah ka pei ding,” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hinanleh Peter in akung ah, “Abawn un lungke siengin hing taisan nan u’leh, Ken vang kang taisan sih ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n Jesu’n akung uah, “Adihtahin ka hing hil ahi, tuni, tuzan ngei in, aa ni vei akhuon masangin thumvei na hing kitheimawbawl ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinanleh aman khautahin, “Nang toh shi khawm ding hinanleng ka hing kitheimawbawl sih ding,” achi hi. Tuamabangin abawn un, achi chiet uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n amaun mun khat Gethsemani kichina mun ahing tung ua, tualeh Aman anuazuite kungah, “Ka thunget sungteng tanah na tou un” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Aman Peter, Jakob leh Johan azawpi a lunggim sengin achimaw panta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n akung uah, “Ka hinna hagau alunggim sengseng a, shina khop hiel ahi. Tanah na um unlen, kiging zing un” achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n mailam ah gamla deu ava pei a, tuol ah apua a, ahitheileh tua hunin Ama apel theina dingin thu angen hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh “Abba Pa, nanga dingin sil zousie ahithei hi; Tam nou kei akipat in lamangin, hinanleh kei thu hilou in, Nangma thuthu hizaw heh,” achi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n ahing pei a, amaute imu in amu a, tualeh Peter kungah, “Simon imu na hiei mah naikal khat zong kiginga um zoulou na hiei mah?
  </para>
  <para style="p">
    <verse number="38" style="v" />Solna a na lut louna ding un kiging zing unlen, thungen un. Hagau in angap a, tahsa pen ahat sih,” achi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Apeimang kia a, thu angen a, agen ngaima agen hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuachi’n ahing nua pei kia a, amauh imu in ahing mu kia zel a, a imut uh asuoh mama ziehin Ama dawn ding dan athei sih uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tuachi’n athumvei hing peina ah, akung uah, “I mu nalai a, tawldam na lailai na hi uoi mah? ahunta hi, ahun ahing tungta hi, en un, Mihing Tapa zuousan a mikhielte khut a pieh ahita.
  </para>
  <para style="p">
    <verse number="42" style="v" />Thou un pei vai, en un Keima hing mansah dingpa ahing tungta hi.”
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh athugen laitahin, Juda sawm leh nite lah a mi khat, siempu liente, laigielmite leh upate akipat in mipi tampi namsau leh khetbuh tawite toh ahing tung pai hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tuin Ama mansah dingpa’n, “Ka tawp penpen khu Ama ahi dinga, man unlen, kituptahin peimangpi ta un, chiin chiemtena ape masa zouta hi.”
  </para>
  <para style="p">
    <verse number="45" style="v" />Tuachi’n ahing tun tahin akungah ava pei pai a, Akungah “Siepa, Siepa” chiin atawp pai hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tuachi’n amaun atungah khut aha ua, amanta uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh akung ua dingte lah a khat in namsau adoh a, Siempu lienpen suohpa asat a, abil asatkhie hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tualeh Jesu’n amauh adawnga, akung uah, “Suomhat man ding bang hiel in, namsaute leh khetbuhte kengin kei man dingin na hing kuon uh maw?
  </para>
  <para style="p">
    <verse number="49" style="v" />Ni chin in Pasian bieh inn ah thuhil in ka um ngitnget a, na hing man sih uhi, hinanleh Laisiengthou thu atangtun ngei ding ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tuachi’n Ama anuasie ua, abawn un ataimang siengta uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tualeh tangval koi ahiei khat in, diel puon nem khat sil in Ama azui a, tualeh tangvalten ama ana man ua,
  </para>
  <para style="p">
    <verse number="52" style="v" />tuachi’n adiel puonnem nuasie in aguohtangin ataimangta hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tuachi’n Jesu Siempu lienpen mai ah a zawpi ua, tualeh ama toh siempu liente leh upate tualeh laigiel mite zousie ahing kikhawmta uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tualeh Peter in gamlapi ah, siempu lienpen innpi huongsung tandong azui a, tualeh suohte toh a toukhawm ua mei a awi uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tualeh siempu liente leh vaihawm mite zousie in Jesu atha theina dingun, Ama hehna ding asui ua amu sih uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Mi tampi in theipina dihlou toh aheh ua, hinanleh ahehna thute uh akituoh sih hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tuachi’n mi koite ahiei ading doh ua, zuou thu in aheh ua;
  </para>
  <para style="p">
    <verse number="58" style="v" />Tam khut a kibawl biehinn ka suse dinga; “Nithum sungin, khut a bawllou adang khat ka lamdoh ding achi ka za uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Hinanleh tuabanga a heh nangawn un zong, ahehna akituoh thei tuom sih hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Tuachi’n siempu lienpen alah uah adingdoh a Jesu kung ah, “Bangma a dawng lou na hiei mah? Tam mite hing hehna bangchidan ahiei?” Chiin adongta hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Hinanleh Ama asip dide a, Bangma in adawng sih hi; Siempu lienpen in “Nang Khrist hampha Tapa na hi ama leh?” chi’n adong kia hi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Tualeh Jesu’n ka hihi. “Mihing Tapa silbawltheina zietlam a tou leh van meilum lah a hing pei na mu ding uh,” achi hi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Tuachi’n Siempu lienpen in apuonte abotkeh a, “Theipimi dang bang ding ichi nalai diei?
  </para>
  <para style="p">
    <verse number="64" style="v" />Pasian agensiet dan na zata uhi, bang chi nasa uoi?” achi hi. Tualeh abawn un Ama khu shitah ahi chiin amawpai chietta uhi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Tuachi’n pawlkhat in chil asietkhum panta ua, Amai atuom pieh ua, avuo ua, tualeh akungah, “Siem in,” achi uhi. Tualeh vengmiten zong akhut peh un abeng uhi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Tuachi’n Peter khu nuoilam a innpi huongsunga a um lai in, Siempu lienpen suoh nungahte lah a khat ahing pei a,
  </para>
  <para style="p">
    <verse number="67" style="v" />Amanu’n Peter mei awi a um amu tahin, a en a, “Nang zong Nazareth Jesu toh umkhawm na hi,” achi hi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Hinanleh aman kitheimawbawlin, “Ka thei kha sih, na thugen zong ka theisiem sih,” achi hi. Tualeh innhim ah ava pawtdoh a, tuachi’n aa akhuongta hi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Tualeh suoh nungahnu’n amu kia a, akunga dingte kungah, “Tampa alah ua khat ahi,” achi kia hi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Hinanleh akitheimawbawl kiata hi. Tuachi’n tomkhat zouin akunga dingten Peter kungah, “Alah ua mi khat hizen teh, Galili mi nahi a, na ham in zong akithei hi achi uhi.”
  </para>
  <para style="p">
    <verse number="71" style="v" />Hinanleh aman tua na mihing genpa uh “Ka thei kha sih, chiin hamsie louin akichiemta hi.”
  </para>
  <para style="p">
    <verse number="72" style="v" />Tualaitah in “Aa ahing khuonga aniveina ahi. Tuachi’n Peter in Jesu’n akunga, aa nivei khuon masangin thumvei na hing kitheimawbawl ding hi,” achi thu atheidohta hi. Tualeh aman tua thu angaituo a, akapta hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zingmawng ahing hitahin siempu liente khu upate leh laigielmite, tualeh vaihawm mite zousie toh akikumkhawm ua, Jesu akaan ua, azawpi ua Pilat kungah apedoh ta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Pilat in “Judate leengpa na hi amah?” chi’n adong a, Aman adawnga, “Nang na genta hi,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh siempu lienten thu tampiin aheh ua, hinanleh aman adawng sih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Pilat in a dong kia a, akungah, “Bangma a dawng lou na hiei mah? En in, sil tampi in ahing heh uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hinanleh Jesu’n bangma in adawng nawnta sih a, tuachi’n Pilat in lamdang asa mama hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Pilat in pawi ni chiengin henta mi khat anget penpen uh apawt sah zel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh mi khat amin Baraba kichipa ahelpite toh kolbut khat a uma, amaun ahelna zieh un tuol athat uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n mipite ava peitou ua, ama ua dinga abawlpieh zel banga bawl dingin a ngen uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh Pilat in a dawng a, akung uah, “Judate leengpa hing hadoh pieh leeng na ut uoi?” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aziehpen siempu lienten thangsietna zieh a Ama apiehdoh uh ahi chi athei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh siempu lienten, Baraba hing hadoh zaw in, chia ngen dingin mipite achiilta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Pilat in adawnga, akung uah, “Judate leengpa na chipa uh bang ka lawta diei leh?” achi kia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n amaun “Kross ah kilbeh in,” chiin akikou kia uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Pilat in akung uah, “Bangdingin la, Aman bang bawlkhiel anei ei?” achi hi. Tualeh ama un “Kross ah kilbeh in,” chiin akihakou semsem uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Pilat in mipite suhlungkim a ut a, Baraba ahadoh piehta hi, Tualeh Jesu ajep zouin Kross a kilden dingin apeta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n galkapten Ama khu innpi huongsung Praitorium achi uah, apuilut ua, tualeh galkap zousie akihankhawm uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh puonsandup a silsah ua, ling lukhu aphan ua, akhusah ua,
  </para>
  <para style="p">
    <verse number="18" style="v" />tualeh Ama asalam ua, “Judate leengpa chiin salam abuh uhi!”
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n alu pumpengin asat ua, chil asietkhum ua, tualeh khupdin in Ama abie uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh chiemmui bawlna a azah zou un, puonsandup khu asatunga pat ahawhkhie ua, Ama puonte asilsah kia ua, Kross a kilden dingin azawpita uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh mi khat gam lam a kipata hing pei, Sairin khuo a mi, Simon, Alexander leh Rufus pa khu Kross paw dingin amanta uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Jesu khu Golgotha mun ah azawpi ua, tuakhu lugu mun, china ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n uoiin murrah toh kihal dawn dingin apie ua, hinanleh Aman asang sih hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Kross a akilbet zou tahun, michin in atan ding chiet uh theina dingin aisan in apuonsilte akihawm uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Ama akilbet hun u’khu nai thumna vel ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh ahehna lai uh, atunglam ah atah ua, “JUDATE KUMPIPA” chiin agiel uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Ama toh suomhat mi ni akilbet ua, khat azietlam ah, khat avei lam ah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Laisiengthou in, “Ama khu mi giloute toh simtha ahi,” achi khu atangtungta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh khum mun a hing pei kha pouma in alu uh thinkhum in, “Ehei! Nang Pasian biehinn susie a, ni thum sunga lamdoh kia pa;
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangma kihundoh inlen, Kross akipat hing kumkhie in, chiin a elhou uhi.”
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachibangmain siempu lienten zong laigielmite toh amau’leh amauh kihouin, a elhou ua, “Aman mi dang ahundoh a, Ama akihunkhe thei sih hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />I mu a, tualeh igintat theina dingin, Khrist, Israel leengpa tuin Kross apat hing kumkhie heh” achi uhi. Tualeh Kross a Ama toh akilbet khawmte un zong Ama a elhou uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nai guhna ahing hitah in, gam pumpi tungah nai kuona tandongin mielna a umta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh nai kuona ah, Jesu aw ngaitah in “Eloi, Eloi lama Sabakthani?” chiin akikoukhie a, tua khu “Ka Pasian, Ka Pasian bangdinga hing taisan na hei?” china ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Akunga ding pawlkhatten tuami azah tahun “Ngai un, Elijah ahan hi,” achi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuachi’n mi khat atai a, spanji khat zu thua a die dimin, pumpeng chieng dawna tahin adawn dingin apie a, ngaisahda un, “Ama lakhe dingin Elijah ahing pei ngel ei mah en vai,” achi u hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n Jesu aw ngaitah in akikou a, a hagau ahata hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tuachi’n Pasian biehinn a puonjah khu atunglam a kipat anuoilam tan dongin phalni kisuo in ahing kehsuohta hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh Ama maingat a ding galkap lienpan tuabanga kikoudoh leh ahagau ahata chi amu tahin “Tam mipa pen Pasian Tapa hi ngeingei va,” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Khunah numeite zong gamlatah akipat a en in a um ua, tuate lah ah, Mari Magdalene, Jakob naupangzaw leh Joses nu Mari, tualeh Salomi apang uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amaute khu, Galili gam a aum lai a Ama zui a, a nna seppiehte zong ahi uhi. Tualeh numei dang tampi Jerusalema Ama toh zawhtoute zong a um uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nitahlam ahing hitah in, kiginni ahi ziehin, tua khu khawlni masang ni ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Joseph Arimathai khomi vaihawm zatathuoitah Pasian gam hing tung ding kilam en zinga um, ahing pei a hangsantahin Pilat kungah alut a, Jesu luong ava ngenta hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tuachi’n Pilat in hichibanga ashi pai khu lamdang asa mama a, tuachi’n galkap lamkai khat ahan a ashina asawt taimah chiin adong hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tualeh galkap lamkaipa a kipat ashita chi atheichien tahin, aluong Joseph kungah apeta hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tuachi’n aman puon nem alei a, Jesu alakhie a, puon nem in atuom a, suong khuoh kuoh han khat ah asielta hi, tualeh suong khat hankot ah alia a, akhata hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh Mari Magdalene leh Joses nu Mari in asielna amu uhi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh khawlni ahing bei tahin, Mari Magdalene leh Jakob nu Mari leh Salomite, ahing pei ua, Ama anu ding un thau namtuite alei uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nipikal khat sung ni masa pen ni zingmawng matahin ni suoh lai in, han ah ahing pei uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh hankot akipat in suong “Koiin hing liakhiet pieh ding adiei?” chi a akihou laitah un,
  </para>
  <para style="p">
    <verse number="4" style="v" />a et u’leh, suong khu liakhietsain amuta uhi, asuong khu alien mama hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh han sunga alut u’leh, tangval khat puon ngou tuol sil azietlam pang a tou amu ua, azau mama ta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh Aman akung uah “Zau sih un, Kross a kikilbeh Nazareth Jesu sui na hi uhi. Ama athou kiata, Tanah a um nawn sih hi. Ama asielna mun uh en un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh pei unlen anuazuite leh Peter kungah, Galili gam ah na masang uah apei hi; na kung ua agen bangin, Ama na mu ding uh, chi’n va hil un,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n amauh kintahin apawt ua, han akipat in ataita ua, chitun a lamdang asah zieh un. Tualeh azau seng zieh un koima kungah bangma agen sih uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Jesu khu nipikal khat a ni masapen zingmawng matah a athawkia ni in, Mari Magdalene, asunga pat dawi sagi anawdohna nu kungah akilah masa pen hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n amanu apei a, Jesu toh na umkhawm zelte, Ama suuna na kapte ava hilta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh amaun Jesu ahing ta hi, tualeh amanu’n amu hi chi azah un, atahsang sih uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuami nuain alah ua mi ni gam lam zuon a apei lai un, mel tuom puoin akung uah ava kilah hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n amautegel apei ua, nuazui dangte ava hil ua, hinanleh amauh thu gen zong atahsang sih uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuami nualam in, annkuong im a atou lai un, sawm leh khatte kungah akilah a, athawkia nua a Ama mute thu atahsan lou zieh u’leh alungtang khau thu uah aphawhhil hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Aman akung uah “Leitung pumpi ah pei unlen silsiem chinteng kungah khantanhoi gen un.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koipou a gingta a baptisma tang khu hundam in aum ding a; hinanleh agingtalou khu siemmaw tangin aum ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh agingtate khu tam chiemtenain azui ding; Ka min in dawite anotdoh ding ua, ham thatein aham ding uhi;
  </para>
  <para style="p">
    <verse number="18" style="v" />gulte khut in aman ding ua; shina gu bangchibang dawn nan uleh zong, bangma achi sih ding uhi; tualeh damloute tungah khut angam ding ua, adam zel ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachia Mangpa’n akung ua, thu agen zouin, Ama van a puitou in a um a, Pasian zietlam ah atouta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh amaute akuondoh ua, mun chin ah khantanhoi thu agenta ua, Mangpa’n amaute aseppi a, chiemtenate in a zui a, athu asudet zel hi, Amen.
  </para>
</usx>
