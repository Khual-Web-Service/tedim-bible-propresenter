<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EXO" style="id">Pawtdohna</book>
  <para style="h">Pawtdohna</para>
  <para style="toc1">Pawtdohna</para>
  <para style="toc2">Pawtdohna</para>
  <para style="mt">Pawtdohna</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuin tamte khu Izipt gam a hing lut Israel tate min ahi, michin leh a innkuonpite uh Jakob toh hing peikhawmte ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Reuben, Simeon, Levi leh Juda.
  </para>
  <para style="p">
    <verse number="3" style="v" />Issakar, Zebulun leh Benjamin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dan, Naphtali, Gad leh Asher.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Jakob suon apat a hing pawtkhie mi zousie sawm sagi ahi uhi, Joseph pen Izipt gam a ana umsa ahita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Joseph ashita a, asanggamte zousie leh ama khanga mi zousie zong ashita uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh Israel hahlesuonten chitamtah asuong ua, ahing pung ta mama ua, atam deudeu ua, hatchitahin ahing hatta ua, gam ahing luodim ta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Joseph theikhalou leeng tha khat Izipt gam ah ahing umta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh aman mipite kungah, “Ngaiun, Israel hahlesuonte eite sangin atam zawta ua, a hat zawta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kisa un, pilvang tahin bawlvai, tuachilou in vang ahing pung sem sem ding ua, hichi ahing hiding hi, kidouna ahing um chiengin, i gal te langa pangin, eite ahing le dou kha ding uhi; tuaziehin gamsung akipat, amaute ideldoh ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuaziehin puohgihte a amauh asuh gentheina dingun atung uah na sem houtu akiguot ua, puoh gih a guon uhi, tuachi’n Pharaoh a dingin, gou kholna khopite Pithom leh Rameses abawlta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hinanleh asuh genthei semsem u’leh apung sem sem ua, atam deu deu uhi. Tualeh Israel tate zieh in a lunggim ta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuaziehin Izipt miten, Israel tate nna gim tah in asem sah uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n nasep gim nain ahinkhuo uh nuomlou tah in akoi ua, simen leh tehlei bawl in, gamlahah nasep chinteng sem in, abawl genthei ua, ana uh asep sahna zousie uah, gimtahin asem sah uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Izipt leengpa’n Hebru naudom mite a houpia, tuate lah a khat min shiphrah ahia adangpen Puah ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Tualeh aman Hebru numeite lah a, naudom nna nasep chiengun toupha tungah en unlen, tapa ahileh that unlen, tanu ahileh hing khoi un,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinanleh naudom miten Pasian agiing ua, Izipt leengpa thupieh bangin abawl sih ua, Pasal naupangte ahumhing zawta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuaziehin Izipt leengpa’n naudom mite ahan sah a, akung uah “Bang dinga tambang silte na bawl ua, pasal naupangte na huhhing uh ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh naudom miten Pharaoh kungah, “Hebru numeite khu Izipt numeite bang ahisih ua, akizen ua, naudom mite a kung ua, atun masangun, nau ana nei zou pai pai uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuaziehin Pasian in naudom mite akem hoi mama a, tuachi’n mite ahing pung ua, ahat mamata uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh hichi ahing hia, naudom miten Pasian agiin zieh un, Aman akung uah innkuonpi ding apie hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Pharaoh in amite zousie thu apeta a, “Tapa hing pieng pouma luidung ah na pai ding ua, tualeh tanu hing pieng pouma na huhhing dinguh ahi,” chin thu apeta hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Levi phunga kipat pasal khat apeidoh a Levi tanu khat zi in anei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n numeinu agai a, tapa anei a, naupang mel hoitah ahi chi athei in, ha thum sung aphuolta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hinanleh aphuol zou nawnlou bepin, phaipheng bawm aphan a, vahai buon leh chim in a zut bit a a sungah naungeh asiel a, lui panga pumpeng lahah akoi ta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh asanggamnu gamla kuom ah adinga bang ang suoh mawng eimah chi thei dingin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Pharaoh tanu lui a kisil dingin ahing peisuh a, asuoh numeite luipang ah avah koi uhi, tualeh pumpeng kawma bawm amu in asuohnu ala dingin a sawlta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hon leh naupang amuta a, ngaiin naungeh akapta hi. Tuachi’n alungsiet ta a, “Tampen Hebru naupangte lah a khat ahi” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuatahin asanggamnu’n Pharaoh tanu kungah “Na nau hing chinpieh dingin Hebru numeite lah a, naudom mikhat kang va hat pieh diei?” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Pharaoh tanu’n akungah, “Kuon in” achi a, tuachi’n nungah akuonta a, naungeh nu ava hanta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Pharaoh tanu in akungah, “Tami naupang la khie inlen, kei a dingin hing kep pieh in, na law ding hing pe navang;” tuachi’n numei nu’n naungeh khu ala a, akem tahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh naungeh ahing khanglien a, Pharaoh tanu kungah ahing pui a, tuachi’n atapa ahing hita hi. Tualeh amin dingin Mosi aphuo hi; “Tui a kipat ka lahdoh ahi ziehin” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh khum hunlai in hichi ahing hia, Mosi ahing pichin tahin asanggamte kungah ava haw a, a puohgihte uh ava mu hi, tualeh a unaute lah a khat, Hebru mi khat, Izipt mi khat in avuohlai ava muta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n adah leplop a, koima a um sih chi athei tahin, Izipt mi khu athat ta a, senel lahah a phuol ta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh ani ni nia ava haw kia leh, Ngaivawi Hebrumite lah a mi ni ana kilai ua, agilou zawpa kungah “Bang dinga na guolpa na vuoh ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n aman ka tung ua lal ding leh thukhen dinga, “Nang koi hing guot ahiei? Izipt mipa na tha banga kei zong hing tha sawm na hiei?” achi hi. Tuachi’n Mosi azauta a, “Tam sil kitheidoh petma hita e,” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharaoh in tam silte azah bep in, Mosi tha dingin asuita hi. Hinanleh Mosi Pharaoh mai a kipat in a taimangta a, Midian gamah atengta hi, tualeh tuikhuh gei khat ah atouta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Midian siempupa’n tanu sagi anei a, ahing pei ua, tui ahing tawi ua, apa uh ganhonte dawn dingin atuibelte uh adim uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n belam chingte ang pei ua, adelmang pieh zel ua, hinanleh Mosi ading doh a, amaute apanpi a, tualeh abelam honte uh tui apie hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n apa uh Reuel kunga ahing tun tahun, aman “Bangchidan ahiei tunia na hing hichi tun bai uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh amaun “Izipt mi khat in belam chingte khut a kipat ahing hunkhie a, tualeh ka tuibelte uh ahing dip pieh a, belam honte zong tui adawn sah hi.”
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n atanute kungah, “Ahileh ama heiah a um tai? bang dinga tua mipa nang nuasie uh ahiei? Ann ne dingin vahan un;” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Mosi in tua mipa toh tenkhawm ding pha asa ta a, tuachi’n aman atanu Zipporah Mosi apeta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh amanu’n tapa khat aneipieh a amin Gershom aphuo hi; “Theilou gamah mikhuol in ka um hi,” achi ziehin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n hun hing pei zel ah hichi ahing hia, Izipt leengpa ashita a, tuachi’n akol tanna zieh un, athum ua, akapta uhi; akoltanna zieh ua athumnate uh, Pasian kungah atungtou ta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Pasian in athumnate uh a za a, tualeh Pasian in Abraham, Isaak leh Jakob toh athuhun athei zing hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Pasian in Israeltate a en zinga, tualeh Pasian in amaute a ngaisah ta hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuin Mosi in asungpa Midiante siempu Jethro belam hon achinga, tualeh belam honte khu gamdai nualam muol ah apui a, Pasian muol Horeb mun ahing tung ta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh sawlbawh lah ah, Mangpa van sawlsieng meikuongin akungah ahing kilah a, tuachi’n a en a, tualeh ngaivawi sawlbawh khu akuonga, Hinanleh sawlbawhte akatum sih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Mosi in “Kihei vangin tua sillamdang thupi, bangchidan a, sawlbawh ka lou ahieimah? va enta vawng,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh endingin akihei chi Mangpa’n amu tahin, sawlbawh kawma kipat in Pasian in ahan a, “Mosi, Mosi,” achia; Tualeh aman “Tamnah um ing e” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Aman “Tamlang hing nai sin, na kedap na kenga pat sutkhie in, na dinna mun lei siengthou ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuathamlouin Keima “Na pa Pasian, Abraham Pasian, Isaak Pasian leh Jakob Pasian ka hi” achi hi. Tuachi’n Mosi in amai aphuolta hi. Pasian a et ngamlou ziehin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Mangpa’n “Izipt gam a um ka mite thuoh gimna ka mu a, atung ua nasem houtute zieha akikou uh ka za a, agentheinate uh ka thei hi.’
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n amaute Izipt mite khut a kipat a, hunkhie a gam hoi leh lien, nawitui leh khuoiju luonna gam Kanaanmite, Hitmite, Amormite, Perezmite, Hivmite leh Jebus mite, gam a puilut dinga hing peisuh ka hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuaziehin tuin ngaivawi, Israel tate kikou aw ka kung ah ahing tung hi: tualeh Izipt miten amaute nuoisie tah a, agawtnate uh zong ka muta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuaziehin tuin kisa in, Izipt gam a kipata ka mi Israeltate, na hing puidoh theina dingin, Pharaoh kungah ka hing sawl ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh Mosi in Pasian kungah, “Kei koi kahiei? Pharaoh kunga va haw a, Izipt-a kipat Israeltate puidoh ding?” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Aman, “Pellou in kahing umpi ngeingei ding, tami nanga dingin, ka hing sawl ahi chi chiemtena ahi ding: Izipt gam a kipat mite na hing puidoh zou chiengin, tami muol tungah Pasian nna nasem ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Mosi in Pasian kungah, “Ngaivawi Israel tate kung ah vapeiin akung uah, napu napate uh Pasian in na kung ua ahing sawl ka hi, kava chi chiengin, amaun amin bang ahiei? hing chita u’leh akung uah bang ka genta diei?” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Pasian in Mosi kungah, “KEIMA KHU KEIMA” ka hi, achi hi. Tualeh aman Israel tate kungah “KEIMA” in na kung uah “Ahing sawl hi,” nava chi ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuathamlouin Pasian in Mosi kungah, Israel tate kungah “Hichiin nava gen belap nalai ding hi, napu napate uh Mangpa Pasian, Abraham Pasian, Isaak Pasian leh Jakob Pasian in na kung ua ahing sawl ahi. Tami kumtawna ka min ahia, khang zousie tana ahing kithei zingna ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pei inlen Israel upate va hankhawm inlen akung uah napu napate uh Mangpa Pasian, Abraham Pasian, Isaak Pasian, leh Jakob Pasian, ka kungah, ahing kilaha, hichi’n achi hi, “Ka hing ve ngaita a, Izipt gam a na tung ua sil kibawlte ka muta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Keima’n Izipt gam gimthuohna akipat in hing puidoh vangin, Kanaanmite, Hitmite, Amormite, Perizmite, Hivmite leh Jebusmite gam nawitui leh khuoiju luonna gam ah ka hing puilut ding hi,” ka chita hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n amaun na aw angai khe ding ua, tuachi’n nang leh Israel upate, Izipt leengpa kungah navapei ding ua, akungah, Hebrute Mangpa Pasian in ahing kimupi a, tualeh na kungah ka hing ngen uhi, gamdai ah nithum lam ah hing peisah inlen, Mangpa ka Pasian uh kunga, kithoina kava bawl thei na dingun na chi ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hinanleh Izipt leengpa’n khut hattah loungal in ahing peisah sih ding chi ka thei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n ka khut ka zahdoh dinga, ka sil lamdang zousie ama u’lah mama ah bawlvangin, Izipt gam ka gawt dinga; tua zou chiengin noute ang pawtsah ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Iziptmite mitmu in, tam mite deisahna ka pe dinga, tualeh tambang ahing hidinga, na pei chiengun khut guohin na pei sih ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hinanleh numei chintengin, a innvengte leh, a inn gei a tengte kungah, sana-dangka kizepna ding leh nihten-puonsilte angen ding ua, khumte na tapate u’leh na tanute un na silsah ding uhi. Tua bangin Izipt mite na suom ding uhi,” achi hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mosi in adawnga, ahi vangin, “Ngaivawi, ahing tahsang sih ding ua, ka thu zong a ngaikhe ut sih ding uh: Mangpa na kungah kilah sihva achi ding zieh un,” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Mangpa’n akungah, “Na khut sunga khu bang ahiei?” achi a, aman “Chiengkhut” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Aman “Tuol ah khesuh vawi” achia, tuachi’n tuol a khieh suh leh gul asuohta hi, tuachi’n Mosi ataita hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Mangpa’n Mosi kungah “Na khut zandoh inlen amei ah man in” achi hi. Aman akhut azandoh a amat leh akhut ah chieng ahing suoh kia ta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Tuachia amaun apu apate uh Mangpa Pasian Abraham Pasian, Isaak Pasian leh Jakob Pasian, na kungah ahing kilah hi chi, atahsan theina ding uh ahi.”
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua ban ah Mangpa’n akungah tu’n, “Na khut na awmah koi in” achia, tuachi’n aman akhut a awm ah akoi a, tualeh alahdoh tahin ngaivawi, akhut apha a vua abang tahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh aman “Na khut na awmah koi kia in” achia, tualeh aman akhut a awmah akoi kia a, tualeh a awm apat alah doh leh, ngaivawi, achi dang ahing bang kia ta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n “Tambang ahing hiding, nang ahing gintat lou ua,” chiemtena khatna aw zong angaikhiet nuom sih u’leh, chiemtena nukhia pen aw, a gintat na ding uh ahi ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh tambang ahing hi dinga, tam chiemtena nite a gintat lou ua, na aw zong angaikhiet tuom sih u’leh, lui apat tui na la dinga tuolgum tungah nasung ding, tualeh lui a kipat a, na tui lah khiet khu tuolgum ah sisan ahing suoh ding hi, a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Mosi in Mangpa kungah, “Aw Mangpa, mi dangnal ka hi sih a, masang lai apat leh na suoh nang houpi nua in zong thu gen siem ka hi ngaisih a, tualemahin mi ham awh leh dang nal lou kahi,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Mangpa’n akungah “Mihing kam bawl koi ahiei? Ahisihleh ham theiloute, bil bingte, mutheinate, mittote, koi bawl ahiei? Keima Mangpa’n ka bawl hilou amah?
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuaziehin tu’n pei inlen, na kam ka umpi dinga, na gen ding kahing hil ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh ama’n ka hing ngen hi, “Aw ka Mangpa, midang sawl zaw mai in” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Mangpa lungthahna, Mosi tungah a kuongta a, akungah, “Levimi Aaron na sanggampa umlou ahiei mah? Ama mi kamsiem ahi chi ka thei hi. Ngaiin nangma hing lamtuo dingin ahing kuon hi, tualeh nang ahing mu chiengin akipah mama ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n nangman akungah thu na gen dinga, akam ah thu na mop ding hi, tualeh na kam leh akam umpi vangin, na bawl dinguh kang hil zel ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n ama khu mipite kunga, na thu genpa hivan in, ama khu nanga dingin na kam ahi dinga nang pen ama adingin a Pasian bang na hiding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh na khut in tam chieng na tawi dinga, tuatoh chiemtenate na bawl ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Mosi apei a, asungpa Jethro kungah ahing kile kia a, akungah “Izipt gam a um ka unaute kunga peikia ding leh adamna uoi mah chi va-en dingin hing hawsah in chin ka hing ngen hi,” achi hi. Tuachi’n Jethro in Mosi kungah “Lungmuong tahin peita’n” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Mangpa’n Midian gam a Mosi kungah, “Pei inlen Izipt gamah kilekia ta’n nang hing tha sawmte a shi siengta uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Mosi in a zi leh atapate azawpi a, sabiltung tung ah atuong sah a, Izipt gam langah ahing kile kia ta uhi. Tualeh Mosi in Pasian chieng a khut ah atawi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Mangpa’n Mosi kungah, “Izipt gam a kile kia dinga na pei chiengin, na khuta ka koi tua sil lamdang zousiete, Pharaoh masang ah bawl teitei in, hinanleh a lungtang ka sukhau dinga, mipite apeisah lou na dingin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh nangman Pharaoh kungah, Mangpa’n Israel khu ka tapa ahia, ka ta masapen ahi, achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh na kunga ka gen ahi, ka nna ahing seppieh thei na dingin, ka tapa peisah in, na peisah nuom sihleh, ngaivawi na tapa, nata masapen that ding kahi,” achi hi va chiin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n lampi a giehbuh ah tambang ahing hita a, Mangpa’n Mosi ahing kimupi a, tha dingin asuita hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualaitahin Zipporah in suong hiem khat ala a, atapa tep atan khie a, Mosi kengbul ah apai a, “Kei dingin sisan suo pasal na hi chienvawt hi” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Mangpa’n apeisanta a, khumin Zipporah in Teptan ziehin sisan suo pasal na hi, achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Mangpa’n Aaron kungah, “Mosi kimupi dingin gamdai ah vapei in” achi hi. Tuachi’n apeita a, Pasian muol ah ava kimupi a, atawp ta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Mosi in Aaron kungah ama sawlpa Mangpa thu zousie leh sil lamdang abawl dinga, athupieh zousie ahil tahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Mosi leh Aaron apei ua, Israel tate upa zousie ahan khawm ua,
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n Aaron in, Mangpa’n Mosi kunga, athugen zousie a gen a, mite masangah chiemtenate abawl hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n miten ana gingta ua, tualeh Mangpa’n Israel tate ahing ve a, athuohgimnate u’zong ahing enta chi azah un, alu uh akunsah ua, Pasian a bie uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh tuate zou in Mosi leh Aaron Pharaoh kungah ava pei ua akungah, “Israelte Mangpa Pasian in tam bangin agen hi, gamdai a kei a dinga Pawi abawl thei na dingun ka mite pei sahin achi hi,” chiin, achi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Pharaoh in “Israelte peisah dinga athu kaman ding Mangpa khu koi ahiei? Tua Mangpa ka thei sih hi, Israelte zong peisah sihvang,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n amaun “Hebrute Pasian in a hing kimupi a gamdai ni thum lam ah hing peisah inlen ka hing ngen uhi, Mangpa ka Pasian uh kungah kithoina hing bawlsahin, tua ahisihleh ka tung uah, natpi ahiei namsau ahiei ahing tungsah kha ding hi,” achi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Izipt leengpa’n a kung uah “Bang dinga nou Mosi leh Aaron in mipite a nasepna ua kipat khawlsah na hi uoi? na nasep uh vakisep khin khian un,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Pharaoh in “Ngaiun, gamsung a mite ahing tam sengseng ta ua, tualeh a puohgih ua pat na khawlsah ta mawh ua,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n tuami ni mamain nasep vengtute leh houtute tambangin thu apie hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Tumasang lai bangin tamite atehlei bawlna dinguh, Pawl penawn sih un, amaute kuon uhenlen pawl kitomkhawm uheh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh tumasanga atehlei bawl za ma uh atung uah na phut ding ua, na suh kiem pieh vawtlou ding uh ahi, athasiet man uh ahi, tuazieh a, ka Pasian kung uah va kithoi va ung achi uh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gimtah a asep thei na dingun mite tung ah nna tamsem guon unlen, tualeh thuginalou ngaisah da uheh,” chin thu apie hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh nasem vengtute leh houtute apawtdoh ua, mipite kungah, “Pharaoh in pawl ka hing penawnsih ding hi, achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nouma pei unlen na mu theithei na uah, pawl kilahkhawm un, hinanleh nana sep uh bangma a ki kiem sah tuom sih ding hi,” ava chita uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n mite bu pawl taanga bu kungbulte lakhawm dingin Izipt gamsungah akithezahta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh nasep vengtuten, “Tumasanga bupawl hing kipieh lai mabangin, na nasep uh, na nichin nasep uh zou kin un” chi’n anaw uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Pharaoh nasem vengtuten Israel tate lah a houtu dinga aguotte uh khu avuo ua, “Bang dinga tumasanga banga zani leh tuni tan a na tehlei bawlte uh zoulou na hi uoi mah?” chi’n a phuut uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuabepin Israeltate lah a, upate ahing pei ua, Pharaoh kungah akap ua, “Bangdinga na suohte nang hichi bawl tahlawm ahiei?
  </para>
  <para style="p">
    <verse number="16" style="v" />Na suohte lah bupawl ahing pe nawn sih ua, ka kung uah tehlei khengun ahing chi uhi. Ngaivawi, na suohte ahing vuo uhi, hinanleh adih lou khu na mite ahi,” achi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinanleh aman akung uah, “Thasie na hi uh, thasie na hi uh, tuazieha hing pei sah inlen Mangpa kung ah hing kithoi sah in na chi uh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuaziehin tu’n pei unlen nna vasem un, bupawl vang ang kipe sih ding a, hinanleh tehlei na khen ding ua kibituh za pen na pieh ding uh ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh “Na nichin nasep un, na tehlei khente uh, nakiem sah thei tuom sih ding uh,” achitah in, Israel tate upaten atansiet dan uh athei ta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Pharaoh kunga kipat ahing pawtdoh tah un, amaute toh kimu dinga na ngah Mosi leh Aaron toh akimu ta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh amaun akung uah, “Mangpa’n nou hing enkhie henlen, vai hing hawm piehta hen, Pharaoh leh asuohte mitmu ah, huot huoi nang suota ua, koute tha na dinga a khut ua namsau na tawisah tah zieh un,” achi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Mosi Mangpa kunglam ah akile kia a, “Aw Mangpa bang ding a tam mite hichi banga hoilou tah a na bawl ahiei? bang dinga kei nang sawl ahiei?
  </para>
  <para style="p">
    <verse number="23" style="v" />Na min a Pharaoh kunga thugen dinga ka va pei apat aman tam mite tungah sil gilou abawlta a; nanglah na mite na puidoh vawt sih hi,” achi hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Tuin Pharaoh kunga bang ahiei ka bawl ding; khut thahatna ziehin amaute ka peisah ding a, khut thahat in amau’te a gam akipat in ahawlkhe ding hi” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Pasian in Mosi ahoupi a, akungah, “Kei Mangpa ka hi”, achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham kungah Isaak kungah leh Jakob kungah bangkimbawlthei Pasian min in kana kilah ta a, hinanleh ka min JEHOVAH in akung uah thei ka hisih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaute kungah mikhuol ahina u’leh a khuolzinna gam uh Kanaan gam pe dingin amaute toh ka thuhun ka sudet ta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Izipt miten hentatna kol abu sah uh Israel tate kaa leh mauna zong ka zata a, ka thuhun zong ka thei zing hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuaziehin Israel tate kungah, kei Mangpa ka hi chi gen inlen, Iziptte puohgihna nuoi akipat ka hing puidoh dinga, ahing saltansahna ua kipat in ka hing suohtasah dinga, thukhenna thupitah toh banjahin ka hing tandoh ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka mipite hi dingin ka hing la ding a, tualeh kei na Pasian uh ka hi ding; tuachi’n Izipte puohgihte nuoi a kipat hing hundohpa Mangpa na Pasian uh ka hi chi, na hing thei ding uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Abraham, Isaak leh Jakob kunga, pieh dinga kana chiemsa gam sungah hing puilut vangin, tualeh na gouluo dingun hing pe vang. “Kei Mangpa khu ka hi”.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Mosi in Israel tate kungah tambangin thu agen tahi, hinanleh alungsim gentheina u’leh a koltanna uh gentheina ziehin Mosi thu gente angaikhe nuom sih uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Mangpa’n Mosi kungah agen a,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Vapei inlen, Izipt leengpa Pharaoh kungah, Israel tate agam apat pawtdoh sah dingin va gen in,” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Mosi in Mangpa maiah, “Ngaiin, Israel tate’n ka thu angai khiet nuom loupi uh. Kei muh teptanlou thugen bang chin Pharaoh in angai khe diei?” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Mangpa’n Mosi leh Aaron ahoupi a, Izipt gam akipat Israeltate puidoh dingin thu ka hing peta chi, Israel tate leh Izipt leengpa Pharaoh kungah vahil un chin thu apie hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tamte khu aphung upate uh ahi: Israel tamasapen Reuben tapate, Hanok, Pallu, Hezron leh Karmi tamte Reuben innkuonte ahi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Simeon tapate: Jemuel, Jamin, Ohad Jachin, Zohar leh Kanaan numei tapa Shaul, tamte Simeon innkuonte ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh tamte akhang dungzui ua, Levi tapate min ahi uhi: Gershon, Kohath leh Merari: Tualeh Levi damsung kumte kum zakhat leh sawmthum leh sagi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gershon tapate Libni leh Shimi ahi uhi, ainnkuon dung zui un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Kohath tapate; Amram, Izhar, Hebron leh Uzziel, tualeh Kohath damsung kumte, kum zakhat leh kum sawmthum leh kumthum ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari tapate: Mahali leh Musho tamte a khang uh dung zuiin Levi innkuonte ahi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Amram in apa sanggamnu Jokebed ziin anei a, amanu’n Aaron leh Mosi ahinpieh hi. Tualeh Amram damsung kumte, kum zakhat leh kum sawmthum leh sagi ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Izhar tapate, Korah, Nepheg leh Zikri ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Uzziel tapate: Mishael, Elzaphan leh Zithri.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aaron in Amminadab tanu, Nahshon sanggamnu, Elisheba akitenpi a; tualeh amanu’n Nadab, Abihu, Eleazar leh Ithamar ahinpieh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Korah tapate Assir, Elkanah leh Abiasaph: tamte Korah innkuonte ahi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aaron tapa Eleazar in Puttiel tanute khat ziin anei a tualeh amanu’n Phinehas ahinpieh hi, Akhangguidan dungzui un tamte Levi mite khanggui hing kipatna upate, ahi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tamte Mangpa’n Aaron leh Mosi kunga, “Israel tate apawl pawl in, Izipt gam a kipat in puidoh un” achite ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tamte khu Izipt Lengpa Pharaoh vahoupi a, Israel tate Izipt gam a pat a pawtdoh sah dinga thu vagente, tua mite khu Aaron leh Mosi ahi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n hichi ahing hia, Izipt gam a Mosi kunga Mangpa’n thu agen niin;
  </para>
  <para style="p">
    <verse number="29" style="v" />Mangpa’n “Kei Mangpa khu ka hi, na kunga ka gen zousie, Izipt leengpa Pharaoh kungah gen in” chi’n Mosi ahoupi hi
  </para>
  <para style="p">
    <verse number="30" style="v" />Hinanleh Mosi in Mangpa masangah “Ngaiin kei muuh temtanlou neimi ka hia, bangchin Pharaoh in ka thugen angaikhe diei?” a chi hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi kungah, “En in Pharaoh a dingin Pasian in kahing bawlta a, na sanggampa Aaron pen na guolnei ahi ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thu kahing pieh zousie na gendoh dinga, na sanggampa Aaron in Pharaoh kungah, Israel tate agam akipat pawtdohsah dingin thu agen ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Pharaoh lungtang ka khausah dinga, Izipt gamah ka chiemtenate leh sil lamdangte ka pungsah ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh, Pharaoh in na thu angaikhe sih ding, tuachi’n Izipt tunga ka khut kangah theina ding leh gawtna thupitah toh Izipt apat ka galkap honte leh ka mi Israelte ka puidoh theina ding in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Izipt tunga ka khut ka hing zahkhiet a, alah ua kipat Israel tate kapuidoh chiengin, Izipt miten kei Mangpa ka hi chi hing thei va uh,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Mosi leh Aaron in tuabangin abawl ua, Mangpa’n amaute thu apieh bangjelin abawlta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Pharaoh kunga thu avagen laiun Mosi kum sawmgiet leh kum thum a upa ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Mangpa’n Mosi leh Aaron kungah thu agen a,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Pharaoh in na kung ua, sillamdang hing bawl di uole achi chiengin Aaron kungah, Na chieng la inlen Pharaoh masangah paiin na chi dinga, tuakhu gul ahing suoh ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Mosi leh Aaron Pharaoh kungah ava pei ua. Mangpa’n thu apieh bangin ava bawlta uhi. Tuachi’n Aaron in achieng khu Pharaoh leh asuohte masangah apai a, tua khu gul ahing suohta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuabepin Pharaoh in zong, mipite leh dawithusiemte ahan a, tuachi’n Izipt gamsunga mitphiel dawisiem ten zong dawithu sam in tuabangin abawlta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaun zong achieng chiet uh apai ua, gul ahing suoh ta uhi. Hinanleh Aaron chiengin amaute chieng aval tahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Mangpa’n agensa bangin Pharaoh lungtang asuh khaupieh a, athugen uh a ngai khesih hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Mangpa’n Mosi kung ah, “Pharaoh lungtang suhkhau in aumta a, mipite apeisah nuom tasih hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zingmawng chiengin Pharaoh kungah nava hawding a, ngaiin tui apat a ahing pawt doh chiengin luipang ah ama kimupi dingin na ngah inlen, tualeh na khut in na chieng gul suohthei khu natawi ding ahi.’
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh akungah, “Hebrute Mangpa Pasian in na kung ah keima ahing sawl hi “Gamdai a ka nna asep theina ding un, ka mite peisah in,” hinanleh ngaiin tutan in na ngaisah sih hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mangpa’n tambangin agen hi, “Tamte ziehin kei Mangpa khu ka hi chi na thei ding, En in ka khuta ka tawi chiengin luituite ka saat dinga, sisan ahing suoh ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n lui a nga umte ashi ding a, tualeh ahing ui dinga, Izipt miten luitui akidah ding ua, a dawn sih ding uhi, achi hi na chi ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Mangpa’n Mosi kungah thu agen a, Aaron kungah “Na chieng la-inlen Izipt gam a tuite, aluitate uh aluipite u’leh atuikulte u’leh atuikhuhte uh tung ah na banzah in, tuachi’n tui zousie sisan asuoh dinga, Izipt gam sunga singhawm leh suonghawm a, tui um zousie sisan asuohna dingin,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Mosi leh Aaron in Mangpa’n thu apieh bangin abawlta uhi. Tualeh Pharaoh leh asuohte mitmu mama in Aaron in achieng alamtou a, lui a tuite asat a, tuachi’n lui a tui umte sisan asuoh siengta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh lui a nga um zousie ashita a, lui a uita a, Izipt miten luitui adawn thei ta sih uhi, tuachi’n Izipt gam pumpi ah sisan a umta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Izipt gam a mitphieldawi siemten zong adawithu un tuama bangin abawl uhi. Tualeh Pharaoh lungtang suhkhau in a um a, Mangpa’n achibangin amau’te thu angaikhe tuom sih hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Pharaoh akihei a, a innsungah alut a, tambang sil piengten alungtang akhoi kha vawt sih hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaziehin, Izipt mite zousie tui dawn ding suiin lui geite akhuot ua, lui tuite a dawn theitahlou zieh un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Mangpa’n lui asat zou ni sagi ahing ching ta hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah, “Pharaoh kungah va pei inlen, akungah ‘Mangpa’n ka miten ka nna asep theina dingun Pei sah in,
  </para>
  <para style="p">
    <verse number="2" style="v" />Na peisah nuom sihleh ngai in, na gamsung zousie ukenga ka gawt ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n lui in ukeng tampi ahing umdoh sah dinga, tuate ahing Peitou ding ua, na Innsungah ahing lut ding ua, na lupna pindan sunguh, na lupna tungah, na suohte innsung ah, na mite tungah leh na lungthu khuh sungah tualeh na tangbuong pawina kuong sung tanpha ah a dim ding uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh ukengte khu nang leh na mite tung leh na suohte zousie tung ah ahing kal ding uhi vachiin,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mangpa’n Mosi ahoupia akungah, Aaron kungah “Luitate tungah, luipite tungah, tualeh tuikulte tungah na khut a nachieng tawi pum in na banzah inlen Izipt gam tungah ukengte umdoh sahin, chiin” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Aaron in Izipt tuite tungah aban azah a tuachi’n ukengte ahing pawt khie ua, Izipt gam atuom suohta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh mitphieldawi siemten a dawi thu un, tuachi mabangin abawl ua, Izipt gam ah Ukeng aum sah uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuabepin Pharaoh in Mosi leh Aaron ahan a, “Kei leh ka mite akipat ukengte alah mang thei na dingin Mangpa kungah ngen un, tuachi’n Mangpa kunga ava kithoi theina dingun mipite ka pei sah ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Mosi in Pharaoh kung ah “Tam zatatna pom inlen, nang apat leh na inn apat a ukengte sumanga luidung mai mai a, a um na ding u’leh nangma leh na suohte leh namite a dingin bangchih chieng in kang nget pieh diei,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Pharaoh in “Zing chiengin” achi hi, Tualeh Mosi in “Mangpa ka Pasian uh bang koima a um sih chi na thei na dingin, na chibang hita hen. Achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh ukengte nang akipat, na innte akipat, nasuoh te akipat leh namite akipat apawtkhe ding ua, lui dungah a umta ding uhi.”
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Mosi leh Aaron Pharaoh kung apat apawt khie ua, tualeh Mosi in Pharaoh tunga atunsah ukengte ziehin Mangpa kungah angenta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Mangpa’n Mosi thu bangin abawlta hi. Tuachi’n ukengte khu innte akipat, inn huongsungte akipat leh loute akipat ashi gamta uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh miten aluoh khawm ua, asievum ua, gamsung a uita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hinanleh Pharaoh in ukengte abeita chi amu bep in, Mangpa’n agen bangin, alungtang akhausah a, a gen uh angaisah nawn sih hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Aaron kungah na chieng lamtou inlen Izipt gamsung a leivui zousie hit asuoh thei na dingin sat in, chiin” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh tuabangin abawl ua, Aaron in akhut in achieng alamtou a, lei a leivui asat a, tuate khu mite tung leh sate tung ah hit ahing suoha Izipt gam pumpi a, leivui zousie hit a suohta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh mitphieldawi siemten zong a dawi thu un tuabanga hit umsah a tum ua, hinanleh a bawl thei sih uhi, tuachi’n mi tung leh sa tungah hit a umta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n mitphieldawi siemten Pharaoh kungah “Tami Pasian khut nasep ahi bou hi, achi ua, tualeh Pharaoh lungtang akhau semsem a, Mangpa’n agen taah mabangin a thu uh a ngai khe sih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Mangpa’n Mosi kungah “Zingmawng matahin thou inlen, Pharaoh masangah va dingin, ngai in, lui lam zuona hing pei ding ahi, tuachi’n akungah Mangpa’n tambangin achi hi, Ka nna asep thei nading un ka mite pei sah in, achi hi vachiin.”
  </para>
  <para style="p">
    <verse number="21" style="v" />Khuchilou a, ka mite na pei sah sihleh ngai in, nangma tung leh na suohte tung leh na mite tung leh na innsungah thou ka hing sawl ding a, Izipt mite innsung leh a umna leitung uh thou honin adim ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh tuami hun chiengin, ka mite tenna, Goshen gam khu, thou hon um lou dingin, ka khen tuom ding hi, tuachi’n leitungah kei khu Mangpa ka hi chi na hing thei ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh ka mite leh na mite kikaal ah ki khenna koi vangin, zing chiengin tam chiemtena a um ding hi.”
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Mangpa’n tuabangin abawla, tuachi’n Pharaoh innsung leh a suohte innsungah leh Izipt gamsung tengah thou hon lungjin huoitah ahing tung ta a, thou honte ziehin agam a segawp ta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Pharaoh in Mosi leh Aaron ahan sah a, “Pei unlen tami gam sungah na Pasian kung uah va kithoi ta un,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Mosi in “Tuabanga bawl akilawm sih, aziehpen Mangpa ka Pasian uh kunga, Izipt mite dinga kidah huoi, kithoina lan ding ka hi uh; ngaiin Izipt mite mitmu a akidah huoi kithoina lanta uleng suongin hing sep lou ding uh amah?
  </para>
  <para style="p">
    <verse number="27" style="v" />Gamdai a nithum lamah ka va pei ding ua, ahing thupieh ding banga Mangpa ka Pasian uh kunga kithoina bawl ding in.”
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Pharaoh in “Gamdai a, Mangpa na Pasian uh kunga, na kithoithei na dingun kahing peisah dinga, hinanleh gamlapi va pei sih pou ulachin, kei dingin zong thu hing nget pieh un” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Mosi in, “Ngaiin, na kunga kipat ka pawt khe dinga, Pharaoh apat leh asuohte apat leh amite apat a, thou honpi apeimang theina dingun, Mangpa kung ah ka ngen ding hi. Hinanleh Mangpa kunga kithoi dinga mite peisah lou dingin Pharaoh lepchie sih heh,” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Pharaoh kungah akipat Mosi apawtkhie a, Mangpa kungah thu a ngen ta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Mangpa’n Mosi gen bangin a bawla, tualeh Pharaoh apat, asuohte apat leh amipite apat thou honte alakhie a, khat zong a um nawn sih hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hinanleh tam hun in zong Pharaoh a lungtang a khausah a, mite apeisah tuom sih hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Pharaoh kungah valut inlen, Mangpa Hebrute Pasian in, tambangin agen hi, kei ahing bieh theina dingun, ka mite peisah in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amaute peisah nuom lou a, na tuhtaang den nahlai leh;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngaiin, Mangpa khut khu, na gantatna muna na ganhonte, na sakolte, na sabiltungte leh sangawngsaute, bawngtalte leh belamte tungah tuvanin, gan natpi huoisetah a um ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Mangpa’n Israel gante leh Izipt gantate akhen tuom dinga, Israel tate neisa bangma ashi sih ding hi, chi’n vahil in achi hi.”
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mangpa’n hun bise khat aguot a, “Zing chiengin Mangpa’n gamsung pumpi ah tam sil abawl ding,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Mangpa’n tua sil khu azing ni’n abawl a, Iziptte gan hon zousie ashi ta a, hinanleh Israel tate ganta khat zong ashi sih hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Pharaoh in mi asawl a, ngaivawi, Israelte ganta khat zong ashi sih hi. Hinanleh Pharaoh lungtang akhau deu deu a mipite apeisah tuom sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Mangpa’n Mosi leh Aaron kungah “Tummeipi sunga vut na khut dim un la unlen, tua khu Mosi in, Pharaoh mu ngei ah, vanlam ah the hen, a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh tami khu Izipt gamsung pumpi ah leivui nel hing suoh vanin, Izipt gamsung zousie a mite tung leh sate tungah chibaw leh uilutpi ahing suoh ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n tummeipi sunga vut ala ua, Pharaoh masangah ading ua, Mosi in vanlam ah athe tou a, mite tung leh gantate tungah chibaw leh uilutpi ahing suoh ta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh uilut hima naikulte ziehin, mitphieldawi siemte Mosi masangah ading theita sih uhi; uilut khu mitphieldawi siemte leh Izipt mite zousie tunga atuh taah ziehin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Mangpa’n Mosi kunga agen tahmabangin, Mangpa’n Pharaoh lungtang asuhkhau pieh a agen uh a ngaikhe sih hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Mangpa’n Mosi kungah “Zingmawng matahin thou inlen, Pharaoh masangah vading inlen a kungah, Mangpa Hebrute Pasian in tam bangin agen hi.” Kei ahing bieh theina dingun ka mite peisah in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tutung in vang, na lungtang sung leh na suohte tung leh, na mite tungah, gawtna chinteng hing tung sah ding ka hi; Leitung pumpi ah keima bang koima a um sih chi na thei na dingin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuin nangma leh na mite natpi a gawt ding in ka khut zahkhe taleng, tuachi’n leitung akipat in sat khiehin na um tading hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinanleh, ngaiin, nangma a, Kasil bawl theina ensah dingin; leh leitung pumpi a ka min akithan theina dingin, tami zieh a kang tunding ahi bou hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tutan amau’te peisah nuom lou in, ka mite tungah na kiliensah nalai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai in zingchieng tuhun in, Izipt gam aum chil akipat tutan a umkha ngainai vawt lou, gielpi huoisetah ka zusah ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuaziehin tuin mi sawl inlen, na ganta teng leh lougam a na neiteng khum khawmin, a zieh pen inn a kikhum lou a, lou gam a um mi leh sa pouma tungah giel ake dinga, ashi ding uhi, vachi’n achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pharaoh suohte laha Mangpa thu zau pouma ten asuohte u leh agantate uh inn sungah a hawl lut uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh Mangpa thu khawh salouten asuohte u’leh agantate uh gamlah ah a nuasie uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Izipt gam sung pumpi a, mite leh sate tung leh Izipt gam pumpi a, annte-louhing chinteng tunga giel akieh theina dingin, na khut vanlam ah zah tou in,” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Mosi in achieng van langah aleh tou a, tuachi’n Mangpa’n vanpi ging leh gielpi ang sawlta a, tualeh leizul ah meikuong ahing tai ta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n giel, mei leh giel kihal huoise tah, Izipt mite nam khat ahing hi ua kipat a, Izipt gam a um kha ngainai vawtlou, ahing umta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh giel in Izipt gam pumpi a, lougam a um mite leh sate zousie aseplia siengta a, lou a annte louhing chinteng asepsie a, gamlah a, sing chinteng aseptan sieng tahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israeltate umna Goshen gamah vang giel ake sih hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Pharaoh in mi asawl a, Mosi leh Aaron ahansah a, akung uah “Tutungin vang ka mawta hi. Mangpa athudiha, kei leh ka mite ka gilou uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mangpa kungah ngen un, van ging he hu leh giel te ahun gawpta, tuachi’n ka hing peisah dinga, na um nawn sih ding uh” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuabepin Mosi’n akungah, “Khopi apat ka pawtdoh chiengin, Mangpa lam ah ka khut zahtou vangin tuachi’n van gingte akhawl ding a, giel zong a um nawn sih ding hi, tuachi’n leitung khu Mangpa a, ahi, chi na thei ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hinanleh nang leh na suohten vang, Mangpa Pasian ging nai tuom sih va uteh chi ka thei hi,” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuin pat leh barli bute gielin asep sie a, barli bute avui laitah ahia, pat zong aga laitah ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hinanleh mangbu leh buman pen apoudoh nailou zieh in asepse sih hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n Mosi Pharaoh kunga pat khopi pulam ah apawt ta a, tualeh Mangpa lang ah akhut a zahtou a, van ging leh gielpi a khawl a, leitungah guo azu nawn sih hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Pharaoh in guo le giel leh vanging atawpta chi amu in, khelna tam sem abawl nalai a, ama leh a suohten a lungtang uh a khausah ta uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Pharaoh lungtang suh khau in a um a, Israel tate apeisah nuom nawn sih hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi kungah “Valut in, tam ka chiemtenate amasanga ka etsah theina dingin, alungtang leh asuohte lungtang ka khausah ta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh nangman zong na tapa leh na tapa tapa zah a, Izipt gam a ka silbawldan leh alah ua chiemtena ka bawlte na hil theina dingin, kei MANGPA ka hi chi na theina dingun,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Mosi leh Aaron Pharaoh kungah ava lut ua, akungah, “Hebrute Mangpa Pasian in tambang in agen hi, bangtan ahiei ka masanga ki-ngiemkhieh na niel ding? Kei ahing bieh theina dingun ka mite peisah in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khumbanga ka mite na peisah nuom sihleh ngai aw, zingchiengin na gamsungah khauphete ka hing tungsah ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n lei mai atuom ding ua, koiman lei amu thei sih dinguh, giel sesiet mawh na kunga um nalai teng ane sieng ding ua, nanga dinga gamlah a singpou chinteng, ane zou sieng ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na innte leh na suohte innte tualeh Izipt mite inn zousie aluodim ding ua; leitunga aum ua kipat, tuni tan a na pate ahiei ahisihleh na pate pate in zong amu ngailou uh,” a chi hi. Tuachi’n aki heia Pharaoh akipat a pawtkheta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Pharaoh suohten akungah “Bangtan vei tam mipa ei dinga ithang uh hiding ahiei? Mangpa a Pasian uh abieh theina dingun, mite peisah mai in. Izipt gamsung suhsiet in a um chi thei nailou na hiei mah?” achi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Mosi leh Aaron Pharaoh kungah ahing zawpi kia ua, tualeh aman akung uah “Pei unlen Mangpa na Pasian uh vabeta un, hinanleh apei dingte koite ahi uoi?” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Mosi in “Ka naupangte utoh, ka tehsete utoh, ka tapate u’leh ka tanute utoh, ka belam honte u’leh ka bawng honte utoh, ka peiding uhi, Mangpa kunga annkuong luina neiding ka hi zieh un.”
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n aman akung uah, “Mangpa na kung uah um ta hen, nata neu noute utoh kang peisah maiding hi hinanleh pilvang un, silhoilou na masang uah a um hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuabang hithei lou e, nou pasal piching teng pei unlen, Mangpa vabie un, tuami na lunggul uh ahi ngal a,” tuachi’n Pharaoh masang akipat amaute adeldohta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Izipt gam tungah na khut jahin, khauphete ahing um na dingun. Izipt gam a ahing peitou ua, gam sunga haichi giel in asuhsiet mawh umsun sun aneh gam thei na dingun,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Mosi in a chieng Izipt gam tungah alehtou a, tuachi’n Mangpa’n tuami ni sunnitum leh zan khovah in tuami gam tungah Suolam hui alaang sah a, tualeh zingmawng ahing hitahin, tua suolam hui in khauphe ahing tunta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh khauphete khu Izipt gam pumpi tungah a leeng ua, Izipt gamsung zousie ah atu ua, atam mama uhi. Tumasangin khauphe hichibang mawngmawng in ana umkha ngainai sih a, tunua chiengin zong a um ngai nawn sih ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lei mai zousie adapsuoh ziehun, gamsung amiel deel-duulvawt hi, tualeh giel suhsiet mawh, tua gam a annte louhing zousie leh theiga zousie ane zou sieng ua, tuachi’n Izipt gamsung pumpi a, lou a haichi hing mawngmawng, singlelouhing a um nawn vawt sih hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Pharaoh in Mosi leh Aaron kintahin ahan sah a, akung uah, “Mangpa na Pasian u’leh noute tungah sil ka bawlkhielta, achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuaziehin tuin hepitahin tutunga ka khelna hing ngaidam unlen, tam shina kei akipat a alahdoh theina dingin, Mangpa na Pasian ukung ah hing nget pieh un,” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Pharaoh kunga kipat apawtdoh a Mangpa kungah angenta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Mangpa’n tumlam hui hattah ahing langsah a, tua huipi’n khauphete asemmang sienga, tuipi sungah asemlut siengta hi, tuachi’n Izipt gamsung pumpi ah khauphe khat zong a um nawn sih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh Mangpa’n Pharaoh lungtang asuhkhau pieh a, tuachi’n Israel tate apeisah nuom tuom sih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Na khut vanlam ah zahtou in, Izipt gamsunga miel thamkhah thei vawt, miel satah ahing um theina dingin,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Mosi in akhut vanlam ah a zahtou a, tuachi’n Izipt gamsung pumpi ah nithum sung miel satah mai a umta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Koima akimuthei sih ua, nithum sung vingveng koima a umna uapat athou khe sih uhi. Hinanleh Israel tate zousie umna teng avah hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Pharaoh in Mosi ahansah a, akungah, “Pei unlen Mangpa vabeta un, na belam honte u’leh na ganhonte uvang umsah unlen, na taneute u’zong zawpi un,” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hinanleh Mosi in “Mangpa ka Pasian uh kunga ka kithoi theina dingun, kithoina ding leh halmang sillat dingte, ka khut ua nang pieh tei tei ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka gan honte un zong ang zui ding ahi, kengchin khat zong ka nuasie sih ding uhi, aziehpen tuate lah akipat a, Mangpa ka Pasian uh bieh na dinga ka lah dinguh ahi, tuamun ka tun masangsie un bang pen in ahiei Mangpa ka bieh dinguh ka theinai sih uhi,” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hinanleh Mangpa’n Pharaoh lungtang asuhkhau pieh a, amaute apeisah nuom tasih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Pharaoh in akungah, “Ka kunga kipat pawt mang inlen Pilvangin, ka mel mawngmawng hing mu nawnsin ka melna mu ni-ni na shi ni ahi ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Mosi in, “Genhoi bou chie, na mel ka mu nawn tasih ding hi,” a chi hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi kungah, “Pharaoh tung leh Izipt gam tungah gawtna khat ka tungsah nalai ding; tua zaw chiengin tam mun akipat ahing peisah ding, ahing peisah vanglah chiengin tam mun a kipat ahing hawl khiet thaw vawt ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuin mipite zahin thugen inlen, Pasal chinin a innvengte kungah, numei chin in a innvengte kungah dangka kizepna leh sana kizepnate ngen uhen.”
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Mangpa’n Israel mite khu Izipt mite mitmu ah deisahna atangsah a; tuathamlouin Mosi khu Izipt gamsunga Pharaoh suohte thei leh mite mitmu ah mithupi tah ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Mosi in “Mangpa’n tambang in agen hi, zankim vel chiengin Izipt gamsung palsuoh in ka hing pei ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Izipt gamsunga tamasapen zousie, amang touna atou Pharaoh tamasa pen akipat bu gawtguoina sumheh gei a tou suohnu ta masa pen dongin a shi ding ua, tualeh ganta pieng masa pen zousie toh zong.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Izipt gamsung pumpi ah kale mauna huoisetah a um ding, tuabang aum khanai sih a, um zong a um kia nawn sih ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh Israel hahlesuonte mawngmawng sietna ding in, mihing leh gantate tungah ui in zong alei apia sah sih ding, tuachi’n Mangpa’n Izipt mite leh Israel mite akhen tuomdan na thei ding uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh tam na suohte zousie ka kungah ahing peisuh ding ua, ka masangah a kun ding ua, pawt khie inlen nang hing zui mite zousie zong, tua zou chiengin ka pei khe ding, chiin,” achi hi. Tuachi’n Pharaoh kunga kipat lungthah sa in apawt kheta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh Mangpa’n Mosi kungah, “Izipt gam a ka sil lamdang bawlte suhpung a, aum theina dingin, Pharaoh in na thu angai khe sih ding hi,” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Mosi leh Aaron in tamsil lamdangte zousie Pharaoh masangah abawl ua, tualeh Mangpa’n Pharaoh lungtang asuh khau pieh a, tuachi’n Israel tate agam apat apawtsah nuom tuom sih hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi leh Aaron Izipt gamah ahoupi a.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Tu ha khu nou adingin ha simpatna ahi dinga, nou adingin kumkhat sunga hamasa pen ahi ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel mipi kikhawmte zousie kungah, tuha ni sawm niin michin in apu apate uh innsuon dungzui in innkuon khat a dingin belam nou khat ala chiet ding uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh a innkuon uh belam nou khat thana ding khop a tawm taluo ahi u’leh, a innkuon a mitam dungzui in, a innveng naipen toh belam nou khat akikop ding ua, michin neh khop hun ding dungzui in belam nou na sim ding uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na belamnou ukhu gensiet bei atal kumkhat a upa ahi dinga, na belam hon ahiei, na kelhon ahiei lah a kipat in na lakhe ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh tuami ha ni sawm leh nili tan, na kem ding uhi. Tuachi’n Israel mipi kikhawmpi zousien ama ua chiet nitahlang ni dangsan hun chiengin a that ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh asisan ala ding ua, a nehna ding uh inn kot bieng khuomni te gel leh atung zawl ah na taat ding uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khum zanin sa mei a emmin, tolsawlou tanghou leh ankhate toh ane ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A siel in ne sih unlen, tui in zong huon vawt sih un, hinanleh alutang leh a keng leh asungkuo zousie toh mei in em unlen ne un.
  </para>
  <para style="p">
    <verse number="10" style="v" />A zing chieng tan adingin bangma val sah sih un, zingmawng chieng tan a val aum leh, mei a na haltum ding uh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh tambangin na ne ding uhi; na kawng uh gahsa in, na kedap uh butsa in, tualeh na khut ua na chiengkhut uh tawisa in, kintah in na ne ding uhi, tam khu Mangpa peikan ann ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tu zan chiengin Izipt gamsung ka tuon suoh dinga Izipt gamsunga ta pieng masa pouma mi hihenlen ganta hitaleh that sieng ding ka hi ziehin, tualeh Izipt gam pasien zousie sietna dingin, thukhenna ka bawl ding, kei Mangpa ka hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n sisan khu nou adingin na umna innte uah chiemtena ahiding, tua sisan ka mu chiengin ka hing peikan ding Izipt gam ka gawt chiengin noute sumang dingin gawtna na tung uah atusih ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n tuni khu nou a dingin thei zingna ni hivanin, na khang tan un Mangpa kunga annkuong luina niin na zang ding ua, kumtawn thugousie annkuonglui niin na mang ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni sagi sung tanghou tolsawlou na ne ding ua, ani masapen ni main, na innte ua kipat in tol na koimang ding uhi, aziehpen, ni masapen nia kipat a ni sagini donga, tanghou tolsaw ne pouma Israel lah a akipat satkhieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh ani masapen niin kikhopna siengthou aum dinga, tualeh ni sagi niin nou a dingin kikhopna siengthou aum kia ding hi, michin in nehletah chiloungal tua hun sungin, nna dang mawngmawng, a semsih ding hi, nehledawn vang na bawl thei ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n tanghou tolsawlou pawi ni khu na nit ding uhi. Tam ni mama a Izipt gam a kipat na mipite uh ka puidoh ahi zieh in, tami ni khu tangtawn a, na khang-thugousie ua umden dingin na nit ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ha khatna ni sawm leh nili ni nitah in, tanghou tolsawlou nane ding ua, tuami ha ma ni sawmni leh khat nitah tan dongin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni sagi sung na innte ua tol akimu vawtlou ding ahi, koipou mikhuol hiin a gam sunga pieng hitaleh, tol kisaw nepouma Israel mipi kikhawmte lah apat sat khiet ahi ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tol kisaw bangma naneh ding uh ahisih, na tenna munchin uah tol sawlou tanghou na ne ding uhi chi’n gen in” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Mosi in “Israel upate zousie ahansah a, akung uah na innkuon dungzuiun, belamnou va lakhie unlen, peikan na dingin that un.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh hissop lomkhat la unlen, kuongsunga um sisan ah die unlen, tuachi’n kottung zawl leh kotbieng khuomte gel ah na taat ding uhi; zingmawng masangsie na lah ua koima a innkot pulam a a pawtlou ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Iziptte that dinga Mangpa hing peisuoh ding ahi ziehin, tuachia kottung zawl leh kotbieng a khuomte gel a, sisan amu chiengin Mangpa’n tua kot khu a peikan dinga, ahing that dingin na innsung uah sumangthaitu hing lut aphal sih ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh tam silte khu nou leh natate ua dingin tangtawn thugousie a na nit ding uh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh hichi ahing hidinga, Mangpa’n ahing chiemsa banga ahing piehding gam na tun chiengun, tamsil bawlte na bawl zom zel dinguh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh tambang ahing hidinga, na tate un na kung ua, tam sil kibawl bang etsahna ahiei? chia ahing doh chiengun;
  </para>
  <para style="p">
    <verse number="27" style="v" />Nouten tam khu Mangpa peikan kithoina ahi, Mangpa’n Izipt mite atha laiin eihaw innte ana khawi a, Izipt gam a Israel tate innte ahing peikan hi, na chiding uhi” achi hi. Tuachi’n mipiten alu uh a kun sah ua, abeta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Israel tate apawt ta ua, Mangpa’n Mosi leh Aaron thu apieh bangin abawl ta uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh tambang ahi a, zankhang laitah in Mangpa’n Izipt gam a pieng masa zousie leengtouna a tou Pharaoh tamasapen akipat suongkul sunga um saltangte tamasapen dongin, athatlia siengta a, gantate ta masapen zousie zong.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n zanlai in Pharaoh leh asuohte zousie leh Izipt mite zousie athou ua, tuachi’n Izipt gamsung ah kaa leh mauna thupitah a umta hi, aziehpen mishi umlouna inn khat zong a um sih hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n azan azan in Mosi leh Aaron ahan sah a, “Thou unlen ka mite lah a kipat peikhie un, nougel leh Israeltate pawt un, tualeh na gensa bangun Mangpa va beta un.”
  </para>
  <para style="p">
    <verse number="32" style="v" />Na gensa bangun, na belam honte u’leh na bawng honte u’zong zawpi unlen, pei un, tualeh kei zong hing guolzawl un achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Izipt miten, agam ua kipata kintah a asawldoh theina dingun, anaw in anaw ta uhi, aziehpen “Shibei ding hitalou ihiei ma’h,” a chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n miten atangbuong meh laite uh tol ahal masangun ala ua, atangbuong zoinate utoh, Puon vai a ziel in a liengkou uah a khai ta uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Israel taten Mosi gen bangin a bawl ua; Izipt mite apat dangka kizepnate sana kizepnate leh Puonsilte angen uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh Mangpa’n mite khu Izipt mite mitmu ah deisahna apie a, tuachi’n anget pouma uh akung uah apie uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh Israel tate Rameses khuo akipat apawt ua, Sukoth atung ua, naupang simlou in pasal piching ngen nuoi guh vel keng in apei uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh mipi kitohpol tampi zong amau’toh a peitou khawm ua, bawng hon leh belam hon tualeh ganta tampi zong a zawpi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh Izipt gam a kipat ahing puohdoh uh tangbuong in tolsawlou tanghou akang uhi, tolsawlou ahi zieh in, Izipt gam apat kintah a nawdoh ahi ziehun, a umsawt thei sih ua, aneh ding tah ngel u’zong abawl man ta sih uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuachi’n Israel tate Izipt gam a aum sung uh, kum zali leh kum sawm thum ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh kum zali leh kum sawmthum beinua in hichi ahing hia, tuami ni mama in hichi ahing hi a, Mangpa mipite zousie Izipt gam a kipat apeidohta uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Izipt gam a kipat a amauh ahing puidoh ziehin Mangpa adinga khum zan zatatna toh nit ding ahi. Tam Mangpa zan Israel hahlesuonten akhang akhang ua anit dinguh ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh Mangpa’n Mosi leh Aaron kungah, “Tami Peikan pawi dan ahi, mikhuol koiman aneh lou ding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hinanleh mi’n sum a aleisa asuoh atep atan pieh nah pou leh anethei ding uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Gamdang mi leh sum a ki guoi suohten anethei sihding uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Innsung khat a neh ding ahia, asa them khat zong inn pulanga na tawidoh lou dinguh ahi, agu khat zong na tawnsah dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Israel mipi kikhawm zousien a zuidinguh ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tualeh na lah ua um gamdangmi khat in Mangpa peikan anitnuom leh Pasal zousie teptan hi henlen tuachi’n anit thei ding uhi, tuabang mite khu agam a pienga ngai ahiding uhi; hinanleh teptanlou mi’n vang aneh votlou ding ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Gamsunga pieng mi leh, na lah ua teng gamdang mi adingin dan khat a um ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Israel tate zousien tuabangin abawl ua, Mangpa’n Mosi leh Aaron, thu apieh bangin abawlta uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tuachi’n hichi ahing hia, tua ni mama in Mangpa’n Israel tate Izipt akipat apawl pawl in ahing puidoh ta hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Mosi ahoupia, akungah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel hahlesuonte lah a, ta chil naubu hong masapen pouma mihing hiin ganta hitaleh, ka kungah hing koituom un kei a ahi” chiin a gen hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Mosi in mite kungah, “Izipt gam a kolbun a, na saltanna inn ua kipat a, na hing pawtdoh ni uh, tuni thei zingun; Mangpa’n ban thahatna in tammun akipat noute ahing puidoh ahi, tol kisaw tanghou na neh dinguh ahisih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abib ha, tuniin nahing pawtdoh uh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n hichi ahi dinga, Mangpa’n Kanaanmite, Hitmite, Amormite, Hivmite, Jebus mite gam nawitui leh khuoizu luonna gam, napu napate uh kunga kihahsiel a pieh ana chiem gam a ang puilut hun chiengin, tami ha in tami nasep na bawl ding uh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ni sagi sung tolsawlou tanghou nane ding ua, ani sagi niin Mangpa dingin pawi na bawl ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ni sagi sung tolsawlou tanghou akine dinga, na lah uah tol kisaw tanghou aumding ahi sih, na tenna mun zousie uah zong tol akimu vawt lou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh tuami ni chiengin na tapa kungah, Izipt gam akipat a ka hing pawtdoh nia Mangpa’n ka tunga asil bawlte zieha, tami kibawl ahi chiin na hil ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tami Mangpa dan na kam a aumden thei na dingin, na khutah chiemtena ahi dinga, na mitte gel kikaal ah thei zingna ahi ding hi. Mangpa’n ban thahattah toh Izipt apat ahing puidoh ziehin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuaziehin tami thugousie kum china a hun tengin na nit dinguh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh hichi ahidinga, “Mangpa’n nang leh napu napate kunga pieh dinga anachiem banga, Kanaan mite gam a ahing puilut a, tua gam ahing pieh chiengin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Naubu hong masa pouma leh na ganta nei lah a pieng masapen zousie, Mangpa a dinga na koituom ding ahi, apate khu Mangpa a ahi ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh sabiltung nou pieng masa pouma, belamnou a natat ding ahi; na tatsih ding leh a ngawng na heh tanding, tualeh na tate lah a, ta pasal pieng masa zousie na tatding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh hichi ahi dinga, hun hing tunga na tapa in tambang ahiei? Chia ahing doh chiengin, akungah Mangpa’n Izipt gam a ikoltanna inna Kipat in ahing puidoh ahi, na chiding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh hichi ahing hi a, Pharaoh in ahing peisah nuomlou tahin, Mangpa’n Izipt gam a ta pieng masa zousie, mihing ta masapen leh ganta ta masapen athatgam sienga, tuaziehin naubu hong masapen apaa pouma Mangpa kunga ka piehkhiet ahi; hinanleh ka tate lah a pieng masa zousie ka tat ahi; chiin a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n na khut uah nou a dingin chiemtena ahi dinga; na mitte gel kikal ah tal gahna ahi ding; aziehpen khut hattahin Mangpa’n Izipt gam a kipat ahing puidoh ta hi,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh hichi ahing hi a, Pharaoh in mipite a peisah bepin, Pasian in naizaw nanleh, Philistinte gamlam tawn in amauh apui sih a, a ziehpen Pasian in “Kidounate amu chiengun, kisia khava unin Izipt gamah nuakia khava uh,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuaziehin Pasian in mipite Tuipisan gamdai lam ah apui kawizaw tahi; tuachi’n Israel tate khu Izipt akipat in ki galging sa in apeitou ta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Mosi in Joseph gute khu apuo a, aziehpen Pasian in “Israel tate pellouin ahing ve ngeingei dinga tuachi’n ka gute tammun akipat na puohtou teitei dinguh ahi chin khautah in akichiem sah sa ahi.”
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Sukoth akipat akipankhie ua, gamdai tuohchil Etham ah a gieh uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Mangpa khu sunin meilum khuom in, ama uh puidingin, tualeh zan in meikuong khuom in amaute vah pedingin amasang uah sun leh zanin a pei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mite masanga kipat in, sun a meipi khuom leh zan a meikuong khuom khu ala mang sih hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuin Mangpa’n Mosi a houpi a a kung ah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel tate kungah, kihei uhenlen Pi-hahiroth phahmasang Migdol leh Tuipi kikaal a Baalzephon gal ah giehphuol sat uhen, tuami kunga tuipi pieu ah gieh uheh chiin gen in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pharaoh in Israel tate tungthu ah, gamsung ah ataang ua, gamdai in a im khumta, achi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Pharaoh lungtang ka khausah dinga aman Israel mite anua del ding a, tualeh Pharaoh tung leh a galkapte zousie tung ah pahtawi in ka um ding a, Izipt miten Kei Mangpa ka hi chi atheina ding un, chiin agen a,” tuachi’n amaun tuabangin abawlta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n mite ataita uh chi Izipt leengpa ahil ua; tuachi’n Pharaoh lungtang leh asuohte lungtang khu mite sietna dingin akilehei ta a, tuachi’n amauten i nna ahing seppieh na ua pat Israel tate ipeikhesah ta mawh ua, “Bangchidan a tambanga ibawl uh ata diei?” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n asakollengte kimansan akoi a, mipite a zawpi ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh sakolleng teltuom zaguh leh Izipt gamsunga sakolleng zousie leh tuate zousie a, a houtute chiet utoh a pui a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Mangpa’n Izipt leengpa Pharaoh lungtang a khausah a, Israel tate a nua delta hi, tualeh Israel tate khu sumlepai tampi toh apawtdoh ta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Izipt miten Pharaoh sakol leh sakolleng zousie leh sakol tuonsiem teng leh galkap teng toh anuadel ua, Baal-zephon phahmasanga, Pi-hahiroth gei a, tuipi pieu a agiehna mun uah anuaphah ta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Pharaoh in ahing naitahin, Israel tate adahdoh u’leh, ngaivawi Izipt miten amauh ahing delta uhi, tuachi’n azau sengseng ua, Israel tate Mangpa kungah akapzahta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh amaun Mosi kungah, “Izipt gam a han aumlou zieh a gamdai a shidinga na hing puidoh ahiei mah? Bang zieh a hi chi bep dinga Izipt a kipat nang puidoh mawngmawng ahiei? achi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Izipt mite nna ka sep pieh theina dingun hing umsah mai in, chia Izipt gam a na kunga kang gensa uh hilou ahiei mah? Gamdai a mawh shi sangin Izipt mite nasem uleng hoizaw mading hiven,” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Mosi in mipite kungah, “Zau sih unlen ding khin-khien un, Mangpa’n tunia ahing etsah ding ahundamna khu en un: Tunia namu uh Izipt mite khu tangtawn in namu kia nawnsih ding uhi, achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mangpa’n nou a dingin ahing doupieh dinga, noute lungmuong tahin um un.”
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Mangpa’n Mosi kungah “Bangchidan a ka kung a kap na hiei? Israel tate kungah mailam nawin pei un chiin gen in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinanleh na chieng lehtou inlen, tualeh na khut tuipi tungah zah inlen tuipi kikhensah in. Tuachi’n Israel tate tuipi lai a tuol gaw ah apei ding uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh keiman, ngai in Izipt mite lungtang ka khausah dinga, amaute anuadel ding uhi: Tuachi’n ken Pharaoh tung leh a galkapte tung leh a sakollengte, tualeh asakol tung tuong mite tungah zatatna ka mu ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachia Pharaoh tungleh, asakollengte tungleh, a sakol tungtuong mite tunga, zatatna ka mu chiengin, Izipt miten kei Mangpa ka hi chi ahing thei ding uhi.”
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Israel mipite masang a pei, Pasian van sawlsieng khu akisuon a, anua lang uah apei a, tualeh meilum khuom khu amai lam ua kipat in akisuon a, anua lang uah ading ta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Izipt galkapte leh Israel mipite kikaal ah aumta hi, tam khu ama ua dingin meilum leh miel ahing hita a, hinanleh zan in Israelte adingin vah apie a, tuachi’n khat leh khat kinai tuo thei lou in zan tungtawn in a umta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Mosi in tuipi tung ah akhut azah a, tuachi’n Mangpa’n zankhovah in, suolam hui hattah in tuipi a mut khen sah hi. Tualeh tuipi laiah gamgaw abawl a tuite akikhen ta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Israeltate tuipi lai a, tuolgum ah a pei ua, tui khu a ziet lam u’leh aveilam uah ama ua dingin tuite baangin akisungta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Izipt miten adel ua, Pharaoh sakolte, asakollengte, sakol tungtuong mite zousie’n tuipi sungah adel lut uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh hichi ahing hia, zingmawng galven huntah in Mangpa’n meikuong leh meilum khuom apat ahing ensuh a, Izipt galkapte asubuoi ta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh asakolleng kengte uh alahkhiet pieh a, ahawl hat thei ta sih ua, tuachi’n Izipt miten “Israelte mai ah taizah maivai: Mangpa’n Israelte panpi in Izipt mite adoupieh hibou,” a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Izipt mite leh a sakollengte u’leh a sakol tung tuong mite uh tuiin ahing nuahup thei kia nadingin tuipi tungah na khut jahin,” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Mosi in tuipi tungah a khut a zah a, zingmawng ahing hiin, tuipi aluon ngai bangin aluong kia ta hi. Tualeh Izipt mite khu tuipi lai ah anua taikia ua, Mangpa’n Izipt mite tuipi laiah apaimang ta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n tuite ahing luongmat kia ua, sakollengte, sakol tungtuong mite leh Pharaoh galkap, amauh hing nuadel a tuipi sunga lutte zousie atummang siengta ua, alah ua khat zong asuohta sih uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hinanleh tuipi lai a, tuol gum tungah Israel tate apei ua, tuite khu a zietlam u’leh aveilam uah baangin akisung uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuabangin Mangpa’n tua niin Izipt mite khuta kipat in Israelte a hundoh ta hi; tualeh Israelten tuipi pieu a Izipt mi shite a mu uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Mangpa’n Izipt mite tunga sil thupi tah abawlte Israelten a mu ua, tuachi’n Mipiten Mangpa agiing ua, Mangpa leh asuoh Mosi agiing ta uhi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mosi leh Israel taten, Mangpa Pahtawina’n tam la asa ua, a genkhawm va luoi uhi: “Mangpa phat in la ka sa ding, Thupitah a, a guol zaw ziehin, Sakol leh atung tuongmi khu tuipi ah, apaimang ta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mangpa ka hatna leh ka la ahi, Ama ka hundamna ahing hita hi. Ka Pasian ahi a, Ama ka phat ding hi, ka pa Pasian ahia, Ama ka pahtawi ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mangpa khu galhatpa ahia, Amin zong Mangpa ahi,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pharaoh sakollengte leh, a galkap honte, Tuipi ah apaita a, a galkap lamkai teltuomte zong, Tuipi san lilai ah atumsiengta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuithuh tahin atum zouta a, Tuipi thuhtah sungah suongtum bangin, atum siengta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Mangpa na khut zietlam khu, silbawltheina in a thupi a, Na khut zietlam in aw Mangpa, Melmate a gawt guoi ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na hoina thupinain, nang hing dou dia thoute a zouta a, na thangpaina, na sawl khie a tuamin amauh, bu pawl bangin akatum ta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na nahkuo a huin tuite libang, aching sah hi, Tuite bangkhat chienkhawm bangin adinga; Tuipi sung gil lamah tuite, khalsah in a um hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dougal pa’n sulnua zui in delpha vangin, gallah sesum tanding hawm vang; atung uah kalung deite mu vangin, ka namsau doh khe vangin, ka khut in amaute sumangthang vang, achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na huikhi in nasem ngut a, Tuipi’n amaute puon bangin atuomta; Tuipi hattah ah ngen bangin atum uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Mangpa pasiente lahah, Nangma bang koi a um ei? Sienthouna a thupi, phatna a zauhuoi, sillamdang bawlna ah, Nangbang koi aum ei?
  </para>
  <para style="p">
    <verse number="12" style="v" />Na khut zietlam na zandoh a, Lei in amauh avalta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na tatsa mite, na khotuonain na puidoh a, Na mun siengthou ah, na banhatin na pui hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nam chin zatam in a za ding ua, azau ding uh, mangbatna in amanta Philistin gam a tengte.
  </para>
  <para style="p">
    <verse number="15" style="v" />Achija uhi Edom hausate, chitutnain amanta Moab lamkaite; zun siengta uh, Kanaan gam mite.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zauna leh chizatna atung uah tuvanin, na ban zaitha vangletna, lumsuongpi bang a dai uh, Aw Mangpa, na mite Amuolkhup masang un, na leisa na mite, amuolkhum sieng masang un.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hambang na huoilut ding amaute, na goutan muol ah na phut tadinga, Aw Mangpa, na umna dinga na bawl mun ah, Aw Mangpa, na khut ngel a na phudoh, mun siengthou ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mangpa’n tangtawn tangtawn in vai ahawmding.”
  </para>
  <para style="p">
    <verse number="19" style="v" />Pharaoh sakolte leh sakollengte tua leh, sakol tung tuong mite, tuipi sunga atum manglai un, Mangpa’n tuipi tuite a tung uah, a nua luon sah kia a, hinanleh Israel tate pen, tuipi lai a leihul tungah apei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Aaron sanggamnu guolneinu, Miriam in akhut ah khuongta atawia, tualeh numei zousien amanu nuazuiin, khuongta tawi in lamkawm in ahing pawtdoh ua;
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Miriam in amauh adawnga: “Mangpa phat in la sa un, thupitah a a guolzawta ziehin, Sakol leh atung tuong mite, tuipi sungah apailutta hi.”
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Mosi in Israeltate tuipi san a kipat hing puidohin, Shur gamdai ah apei ta ua; tualeh gamdai ah nithum apei ua, tui amu tasih uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Marah mun ahing tun un, akhaat ziehin Marah tuite adawn thei sih ua, tuaziehin tua mun khu Marah aki chita hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n mipite Mosi tungah aphunta ua, “Bang ahiei kadawn ding uh?” achi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Mosi Mangpa kungah akapta a, tualeh Mangpa’n sing khat a ensah a, tua khu tuisunga a khieh leh tui khu ahing humta hi. Tua munah ama ua dingin thugousie leh danthupieh abawl pieh a, tualeh amaute a ze-et ta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh “Mangpa na Pasian uh Aw, lunglut tah a na ngaikhiet ua, Amitmu a sildih na bawl ua, athupiehte na ngaisah ua, Adan thupiehte na zui u’leh, Izipt mite tunga natna-hipi ka tunsahte, na tung uah ka tungsah sih ding hi; aziehpen kei noute hing sudam Mangpa khu ka hi,” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh tuitawdoh sawmleni leh tum kung sawm sagi umna Elim mun ahing tungta ua: tualeh tua mun a tuigei ah giehphuol a bawlta uhi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Elim akipat in ahing kipandoh ua, Israel mi honpi Izipt gam akipat apawtdoh nua uh aha nina, ni sawm leh ninga niin Elim leh Sinai kikaal a Sin gamdai ah ahing tungta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Israel tate mipi umkhawmte, Mosi leh Aaron tungah gamdai ah aphun ta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Israel taten akung uah, “Izipt gam a sabel gei a ka toulai u’leh gilva tah a tanghou ka nehlai un Mangpa khut ah ana shi zaw tamai lei izaw, aziehpen tana mipi umkhawm zousie kiela thalup dinga gamdai a nang puidoh uh ahi” achi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Ngaiin nou a dingin van akipat tanghou ka hing zusah ding: tuachi’n mite apawtdoh ding ua, nichinin aneh khop ding uh a tomkhawm ding ua, amauten ka dan azui u’leh-azuilou uh ka etchien theina dingin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh hi chi ahing hi dinga, a ni guh niin, atom khawmte uh abawlkhol ding ua, tua khu ni chin a atom khawm uh leni ahiding ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Mosi leh Aaron in Israel tate zousie kungah, “Nitah chiengin Mangpa’n Izipt gam a kipat ahing puidoh ahi, chi nathei ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh zingmawng chiengin, Mangpa thupina na muding ua, Mangpa dem a atunga naphun nate uh azata a, kou bang ka hi ua na hing chi phunsan uh a hiei?”
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Mosi in tambang ahi ding hi, “Nitah lam chiengin Mangpa’n nehding sa ahing pe dinga, zingmawng chiengin tanghou khamtah a, nehding ahing peding hi; atunga Ama dema na phun nate uh Mangpa’n athei a; kou bang ka hi uoi? Na phun nate uh, kou gel tunga phun na hi sih ua, Mangpa tunga phun na hizaw uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Mosi in Aaron kungah, “Israel tate umkhawmte kungah, Mangpa kung nai ah hing pei un, na phunnate uh azata, chin gen in” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh hi chi ahi a, Aaron in Israeltate umkhawmte zousie kunga thu agen lai in, gamdai lam a et uleh, ngaivawi, Mangpa thupina meilum lah ah ahing kilang ta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a akungah.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Israeltate phunchieh nate ka zata a, akung uah nitah lam chiengin sa nane ding ua, zingmawng lam chiengin vatahin tanghou nane ding uhi; tuachi’n Mangpa na Pasian uh ka hi chi nathei ding uhi, chiin gen in” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh hi chi ahing hia, nitah lamin mengkeng hon ahing leeng tou ua, giehphuol ahing tuom dim ua, zingmawngin giehphuol kim ah daitui a kia hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Daitui kie ahul tahin, ngaivawi, gamdai leitung pumpi ah daitui khal chie a neu bem bilbel a um a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Israel taten amu tahun, “Bang ahiei” chi a theilou zieh un, bang ahiei chin khat leh khat akidongtuo uhi, Tuabep in Mosi in akung uah, “Tami Mangpa’n na nehding ua, a hing pieh tanghou ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tami Mangpa hing thupieh khu ahi, michin in na neh khop uh na tam leh tawm dungzui un, mi khat adingin omer khat tom unlen, michin in apuon inn ua umte a dingin zong tom un” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Israel taten tuabangin abawl ua, khen khatten tamdeu atom ua, khenkhatten tawm deu a tom uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachia Omer ate u’leh atom tam pa’n atang tam tuom sih a, atom tawm pan zong atawm tan tuom sih hi. Michin in akhamkhop ding chiet uh a tom uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Mosi in “Koiman zingmawng tan a, na koi lou dinguh ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh Mosi thu asang sih ua, alah ua mi khenkhatten zingmawng dong akoi u’leh athan a, a uita hi, tuachi’n Mosi atung uah a lungthah ta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n zingmawng teng in michin in a kham khop ding chiet uh a tom ua; tualeh ni ahing sat chiengin azunmang zel hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n hi chi ahia, a ni guh niin tanghou aleni a tam a tom ua, mikhat a dingin Omer ni zel in atom ua, tualeh mipite lah a, vaihawmte zousie a hing pei ua, Mosi ahilzel uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n ama’n akung uah, “Tami ahi Mangpa’n ana gen leng zing chieng khu Mangpa khawlni siengthou khu ahi; na kan dingte uh tunin kang unlen, nahuon dingte u’zong huon unlen, aval teng zingmawng chienga dingin khet un.”
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Mosi in ahil bangin zingmawng dongin a koi ua, a ui sih a; than zong atha sih hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Mosi in “tuami khu tuni’n ne un; tuni khu Mangpa a ding khawlni ahi ziehin, tuni’n gamlah ah tanghou namu sih ding uhi, achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Niguh sung na tom ding ua, hinanleh ni sagi ni khu khawlni ahia, khumni’n bangma a umsih ding hi.”
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh hichi ahing hi a, ani sagi ni’n mi khenkhat atom dingin ava kuon ua, amu sih uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Ka thupiehte leh ka dante bang tanvei nit utlou ding nahi uoi mah?
  </para>
  <para style="p">
    <verse number="29" style="v" />En un, Mangpa’n khawlni ahing pieh ziehin, a niguh niin ni ni ading tanghou ahing pie hi; michin aumna mun chiet uah um uhenlen, nisagi niin koima a umna ua pat pawtdoh sih uheh,” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n mipite ani sagi niin a khawl ta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Israel Inn kuonten tanghou min khu Manna achi ua; tuami khu Pasikhawm tang ngou bang ahia, atui dan tanghou khuoiju toh kihal bang ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Mosi in “Tam sil pen, Mangpa thupieh ahi, nakhang-nakhang ua koi dingin Omer khat dim thun un; Izipt gam a kipat a ka hing puidoh lai a, gamdai a ka hing vahna, ahi chi athei na dingun,” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Mosi in Aaron kungah, “Bel khat la-inlen Omer dim khat thun inlen, Mangpa masangah luikhie in, na hah nasuonte un akepden theina dingun” a chia.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mangpa’n Mosi thu apieh bangin, Aaron in thuhun masang ah kepden dingin aluitou tahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Israel taten mihing tenna gam atun masang sie uh, kum sawmli sung Manna ane ua, Kanaan gamgi zul atun masang sie uh Manna ane uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Omer khat khu ephah khat sesawm suo sekhat ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Israel tate mipi umkhawm zousie Mangpa thupieh dungzui in Sin gamdai akipat in apei ua, Rephidim munah giehphuol abawl ta uhi, tualeh tuanah mipite dawn ding tui a umta sih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuaziehin miten Mosi aphin ua, “Ka dawn dinguh tui hing pie’n” achi ua, tuachi’n Mosi’n akung uah, “Bang dinga kei nang phin uh ahiei? Bang dinga Mangpa ze-et nahi uoi?” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n mipite tuamun ah tuidu a dangtahin a um ua, tualeh mipite Mosi tungah aphunta ua, “Bangchidan a ka tate u’leh ka gantate uh puma dangtah a tha dinga Izipt akipat na’ng puidoh mawngmawng ahiei?” achi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Mosi Mangpa kungah a kap a, “Tam mipite bang kalaw diei? Suonga hing seplia dingin akisata uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Mangpa’n Mosi kungah, “Israel upate khenkhat zawpi inlen, mipi masangah pei zel in, tualeh tumasanga lui na satna chieng khu na khut ah tawi inlen, pei in, achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngaivawi khuna Horeb suongpi tungah na masang ah ka na ding dinga, tua suongpi khu na sat dinga, tuachi’n mipite dawn ding tui ahing luongdoh ding hi,” achi hi. Tualeh Mosi in Israel upate mitmu ah tua bangin abawl ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi in tua mun min khu Massah leh Meribah achita hi. Israel tate a kiphin ua, “I lah uah Mangpa um ahiei umlou?” chiin Mangpa a ze-et zieh un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Amalek ahing kuon a Rephidim ah Israel ang dou ta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Mosi in Joshua kungah “I lah a mite telkhie inlen Amalek dou dingin kuon khie in, zing chiengin ka khut a Pasian chieng tawi in muolvum ah ka hing ding ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Mosi in akunga agen bangin Joshua in abawla, Amalek ava douta hi. Tualeh Mosi Aaron leh Hur muolvum ah akaltou uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh hichi ahing hi a, Mosi in akhut adop sang chiengin Israelin a zou a, a khut a ngiem sah chiengin Amalek in a zou hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hinanleh Mosi khut ahing gih a tuachi’n suong ala ua, anuoi ah akoi ua, atungah a tousah uhi, tualeh Aaron leh Hur in akhut adoptou pieh ua, khat lam pang ah khat ale lampang ah khat; tuachi’n ni tum dongin akhutte pia lou in a umta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n, Joshua in Amalek leh a mite namsau hiem in a zouta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Tami thu theizingna dingin laibu sungah giel inlen Joshua bil ah zanonsah zel in, Amalek theizingna khu vannuoi apat phiet mang kilkel ding ka hi ziehin a chi hi.”
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Mosi in maitam khat adaw a, amin Jehovah Nissi achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mangpa akichiemta a, “Mangpa’n akhang akhangin Amalek mite a douding” achi hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Midian gam siempu Mosi sungpa, Jethro in Pasian in Mosi leh ami Israelte dinga asil bawl zousie ana za a, tualeh Mangpa’n Israel Izipt gam a pat apuidohta chi aza hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Mosi sungpa Jethro in Mosi zi Zipporah anua sawlkia zou in ahing pui a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zipporah tapate ni toh, tuate lah a khat pen min Gersom ahia, azieh pen aman “Theilou gam ah mikhuol in ka va um hi,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Adang khat pen min Eliezer ahi, aman “Ka Pasian khu ahing panpi ahia, Pharaoh namsau apat ahing hunkhieh ziehin” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Mosi sungpa Jethro khu, Mosi tapate leh azi toh, Pasian muol a, a giehphuol ua Mosi kungah ahing pei ua.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Mosi kungah, “Kei na sungpa Jethro na zi leh na ta pa tegel toh na kungah ka hing pei uhi” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Mosi a sungpa dawn dingin ava pei a, kun in chibai abuh a, atawp a, tualeh atanchin uh akidongtuo ua, apuonbuh sungah a lutta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Mosi in asungpa kungah, Israelte zieh a, Mangpa’n Pharaoh leh Izipt mite tunga, asil bawl zousie leh lampi a hamsatna atung ua hing tung zousie leh, tuate akipat Mangpa’n bangchibang a, amaute a hutkhiet zel ahiei chite zong ahil hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Jethro in Izipt mite khut a kipat ahutdoh a Israel tate tunga Mangpa’n silhoi a bawlpieh zousie ziehin akipah mama hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Jethro in “Izipt mite khut a kipat leh Pharaoh khut a kipata hing hundohpa leh Izipt mite khut nuoi akipat amipite tankhepa Mangpa’n thupha ngata hen, achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuin pasien dang zousie sangin, Mangpa a thupi zaw hi chi ka thei ta, aziehpen kisatheitah a asilbawlte zousie tung ah Ama a um hi.”
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Mosi sungpa Jethro in halmang sillat leh kithoinate Pasian a dingin alan a, tualeh Aaron leh Israel upate zousie Pasian masangah Mosi sungpa toh nekhawm dingin ang pei uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh azing ni’n hichi ahing hia, Mosi mite vaihawm dingin a tou a, tuachi’n mite zingmawnga kipat kitah dongin Mosi kung ah a ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Mosi sungpa’n mite kunga asilbawl zousie a muin, Mite kunga na silbawl khu bang a hiei? “Bang dinga, na tang a tou a, mite zingmawng a kipat nitah dong na kung a na dinsah ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Mosi in asungpa kungah, “Mipite Pasian tungtang dong dinga ka kunga hing pei ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thubuoi anei chiengun ka kungah ahing pei ua; tuachi’n ken khat leh khat kikaal thu ka khen pieh zel a, Pasian thupiehte leh adante ka na theisah zel hi,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Mosi sungpa’n akungah, “Na silbawl dan ahoi sih hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang leh na kunga um, mipite kisu gimgawp ding hi uteh, tam silte nanga dingin agih taluo hi, nangma ngen in na bawl zou sih ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuin ka gen ngai khie in, lem hing guot pieh vang, Pasian na kungah umta hen; nang Pasian leh mipite kaal ah mite palai in pang inlen, athu buoite uh Pasian kungah na tut ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh danthupiehte leh dante ah na hil ding a, apeina lampi ding u’leh ana sepding uh na kohmu ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuathamlouin, mipite lah apat, Pasian zaumi leh mi thudih leh huoihamlou, mi kizen deu deu na teldoh dinga, tuabang mite, tul tampi tunga vaihawm ding, za tampi tunga vaihawm ding, sawm ngate tunga vaihawm ding, tualeh sawm khat tunga vaihawmtu ding bangin na koi ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh tam miten bangchihlai pouin mipite vaihawm pieh uhenlen, tualeh hichi ahi ding hi, thu lien pouma nang kungah ahing tut ding ua, hinanleh thu neu zousie amauten angaituo ding uh ahi, tuachi’n nanga dingin jangkhai vanin, na puohgih ahing puohpi ding uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tam sil na bawl a, tualeh tuabanga Pasian in thu ahing pieh leh, khuchin napang sawt zou ding a, tualeh tam mipite zong lungdam in amun chiet uah apei ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Mosi in asungpa aw angaikhie a, agen zousie abawlta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Mosi in Israelte zousie lah akipat in, mikizente atel khie a, mipite tunga lupen vaihawm abawla, tul te tunga vaihawmtu, za te tunga vaihawmtu, sawmngate tunga vaihawmtu leh sawmte tunga vaihawmtute in akoi ta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n amaun, bangchihlai pouin mipite vai ahawmpieh ua, thu hamsate Mosi kungah ahing tut ua, hinanleh thu neu deu pouma, amaun thu a kikhen ta uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Mosi in a sungpa peisahin akikhenta ua, agam langzuon in apeita hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel tate Izipt akipat a apawtdoh nua uh, aha thumna khumi ni mama in Sinai gamdai ahing tung uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rephidim a kipata pawtkhie in Sinai gamdai ahing tung ua, tuachi’n gamdai ah a puon innte uh a zah ua, tuamun tangbul ah Israelten giehphuol a satta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Mosi Pasian kungah ahaw tou a, Mangpa’n muol a kipat in ama ahing han a, “Tambangin Jakob innkuonte kungah na gen ding a, Israel tate na hil ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izipt mite tunga ka bawl dante na muta ua, tualeh muvanlai ha tunga ka hing puoh a, keima kunga ka hing tut dante na theita uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuaziehin tuin ka thu na man ua, ka thuhun na zui tahtah u’leh, kei a dingin noute leitung mizousie te lah ah Gou manpha teltuom na hi ding uhi, aziehpen leitung pumpi kei a ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh noute kei a dingin, nam siengthou, lenggam siempu nahi ding uhi. Tam thute Israel tate kunga na gen ding thute ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Mosi ahing pei a, mipite lah a upate ahan khawm a, Mangpa’n akunga apieh tam thute zousie amasang uah aluita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n mipite zousie’n kituohtahin adawng ua, “Mangpa’n agen zousie ka bawl ding uh achi uhi,” tuachi’n Mosi in mipite thu gente Mangpa kungah atut kia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Mangpa’n Mosi kungah, “Ngaivawi, miten na kunga thu ka gen chienga, azah theina ding u’leh, kumtawn a nang ahing gintat den theina dingun, meilum satah lah ah ka hing pei hi,” achi hi. Tualeh Mosi in mipite thu gen Mangpa kungah a hilta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Mangpa’n Mosi kungah, “Mipite kungah vapei inlen tuni leh zing chiengin amaute susiengthou inlen, apuonte uh sawp uhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh ani thum nia dingin mansa in um uheh, ani thum niin Mangpa khu mizousie mitmu a Sinai tanga hing peisuh ding ahi zieh in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh mite akimvel ah dai nakai pieh ding a, muol a kaltou lou ding leh muol kiim thamkha lou dingin pilvang un, koipou muol thamkhate shi ngei ngei ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koima khut in akhoikhah ding ahisih, tuachilouin suonga selia ahisihleh thal a kap pailet ahi ding, ganta hiin mihing hitaleh, ahing sih ding hi. Pengkul sawtpi agin chiengin, muolah ang kaltou ding uh hi,” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n muol a kipat in mite kungah Mosi apei suh a, mipite asusiengthou a, tualeh amauten apuonte uh asawp uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh aman mipite kungah, “Nithum nia dingin mansa in um unlen, na zite utoh hing lumkhawm sih un,” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh ni thum ni zingmawng in, hichi ahing hia, vanpi ging leh tunphe tualeh muol tungah meilum satah a hing kai a; pengkul angai a ngai ahing gingta a, tuachi’n gieh phuol a mipite zousie achitun ta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Mosi in gieh phuol a kipat in mipite Pasian toh kimu dingin ahing puidoh a, amaute muol nuoilang ah a ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh, Sinai muol a Mangpa khu meikuonga ahing kumsuh ziehin, muol khu meikhu’n apum tuom ta hi, tualeh amei khu haltuina meikhu bangin ajamtou a, tualeh muol pumpi nasatah in akiling hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh pengkul gin a sawt a angai semsem bepin, Mosi in thu agen a, Pasian in aw gingin adawnga.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Mangpa khu Sinai muol vum tunga kipat in ahing kumsuh a, tuachi’n Mangpa’n Mosi muolvum tungah ahan tou a, Mosi ava peitou hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Mangpa’n Mosi kungah, “Kumsuh inlen mipite thu hilin, tuachilouin en dingin Mangpa lam ahing phuvang kha ding ua, alah ua tampi’n amanthai law kha ding uhi, achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Mangpa kung nai a hing pei siempute zong ki susieng thou uheh tuachilouin Mangpa amaute tungah lungkimmaw khava,” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Mosi in Mangpa kungah “Mipite Sinai muol ah ang peitou thei sih dinguh, Muol kimvel ah dai kai inlen, susiengthou in chia nang hil zieh in” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Mangpa’n akungah, “Pei inlen, kum suhin, tualeh Aaron toh nang hing kaltou kia un, hinanleh siempute leh mipite, Mangpa kunga hing pei dingin, hing phuvang sih uheh, tuachilouin amaute tungah Mangpa lungkim maw khava” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Mosi mite kungah akumsuh a, mite kungah thu agenta hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n hichiin tam thute zousie agen hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Kei Mangpa na Pasian, Izipt gam a na hentatna inn ua kipat a hing puidoh pa ka hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima loungal pasien dang mawngmawng na nei ding ahisih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Milim khenthu ahiei, ahisihleh tunglam van a um ahiei, nuoilam lei a um ahiei, lei nuoi lam tuisung a um, sil bang ahiei kibahpi mawngmawng na siemthu lou ding uh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaute mai a, na kun ding uh ahi sih, tualeh a nna u’zong nasep lou ding ahi; kei Mangpa na Pasian uh, thangsetah Pasian ka hi ziehin keima hing mudate khelna, khangthum khangli tan a, pate gitlouna tate tunga phuba la zel ka hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahing ita ka thupiehte zui, sang tampite kunga, khotuona musah Pasian ka hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mangpa na Pasian min na mawh gen ding ahi sih, Amin mawha genmi khu gilou lou in asep sih ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khawlni siengthou tah a nitding ahi, chi thei zingin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Niguh sung na sem inlen, nasep ding zousie nasep suoh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hinanleh ni sagi ni khu, Mangpa na Pasian uh khawlni ahi; tami niin nna mawngmawng nasep ding ahi sih a, nangman zong, natapa in zong, natanu in zong, na suohpa in zong, na suohnu in zong, na gantatein zong, tualeh na huong sunga um mi khuol in zong.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aziehpen niguh sungin Mangpa’n lei leh van leh tuisuogiette leh a sung a um zousiete a siem a, ani sagi niin a khawlta hi. Tuaziehin Mangpa’n khawlni khu aguolzawl a, asusiengthou ta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanu leh napa zatat in; Mangpa na Pasian in ahing pieh gam a na damsung nite asawt thei na dingin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuol na thading ahi sih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aang na kawm ding ahi sih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na guh ding ahi sih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na inn vengte langa techi dihlou a na panding ahi sih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na innvengte inn na en ding ahisih, na innvengte zi ahiei, asuohpa ahiei, asuohnu ahiei, abawngtal ahiei, a sabiltung ahiei, ahisihleh na innvengte neitah mawngmawng na en ding ahi sih,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh mipite zousie in, vanpi gingte, tunphete, pengkul gingte, tualeh muol meikhu in apumtuom, amutahun, akinua tawn ua, gamlapi ah ading uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Mosi kungah, “Nangman ka kung uah thugen inlen ka ngaikhe dinguh, hinanleh Pasian in vang ka kung uah thu genda mai heh, ka shi kha ding uh,” achi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Mosi in mipite kungah, “Zau sih un, Ama zauna na masang ua a um a, na khellouna ding un, Pasian noute hing en chien dinga hing pei ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n mipite gamlapi ah a ding ua, Mosi in Pasian umna miel keikui lam a zuon hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Mangpa’n Mosi kungah, “Israel tate kungah tambang in thu va genin, Nouma ngel in van a kipat a ka thugen na zata uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kei chilou pasien dang mawng mawng dangka asiem pasiente ahiei, sana asiem pasiente ahiei, nou adingin na siem dinguh ahi sih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kei a dingin lei ah maitam na bawl ding a, atungah na belamte, leh na bawngtalte, halmang kithoina leh kilemna kithoinate in na lan ding hi; ka min chiemtena dinga ka bawl na mun zousie ah, na kung uah kang pei dinga, ka hing guolzawl ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Suong maitam nang bawlpieh ding leh, suong kikheng a, na bawllou ding ahi: Suong tunga na hiemzah nalap leh na bua sah zou ahita hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka maitam kaltouna kalbite a, na kaltou vawt louding ahi,” na saguoh hina adawh louna dingin.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tuin tamte khu ahi, akung ua na theisah ding vaihawmna dante khu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hebrumi suoh a, nalei leh, kum guhsung na nna asem dinga, kum sagi na ah bangma a tatlou in vaiveng tah a, apawt khiet ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama tanga hing lut ahileh amatang main apawt kia maiding ahi, zi nei ahileh azi zong ama toh a pawt khawm ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Apuin zi ana guona, tapate ahiei, tanute ahiei, azi in ana neipieh leh azi leh atate a pu a ahi ding ua, amatang a pawt ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hinanleh a suohpa’n, kichientah a, kapu ka it a, ka zi leh ka tate ka it a, zalen in ka pawt khesih ding achileh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n apu in vaihawmte masangah amapa ahing pui ding a, kotlam dong ahiei, kot khuom bul ahiei ah ahing pui dinga, tualeh apu in bil vu nain abil a vu vangpieh dinga; tuachi’n kumtawn in ana asem tading hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh mi’n atanu suohnumei dinga, a zua leh amanu khu suoh pasalte bangin apawt sih ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Apuin azi dingin na khamta henlen, ama nu’n apu sulungkim tasih leh, akitatsah ding ahi, ana solbawl tah ziehin, nam dangte kunga zua kia theina anei sih ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh atapa zi dinga akhampieh ahilehvang atanute abawldan banga abawl ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman zidang nei kia nanleh zong, nehletah silleten leh azi ahinate akiemsah tuomlou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh tam sil thumte abawlpieh sihleh, sum pelou in zalentah in apawt khethei ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Koipou in mi avuoh a, ashi tahleh, tuamipa khu tha teitei ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh min atup mawng hilou, Pasian laitan ahile-vang atailutna ding mun ka hing guot pieh ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinanlezong mi’n tupna nei a, pilkheltah a zebawl a, a innveng tha atup leh ashi na dingin ka maitam apat na kaipawt ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi koi zong apa ahiei, anu ahiei vaw pouma, a shi ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh mi koizong mihing gu a zua ahiei, ahisihleh akeplai akhut a akimu leh, tha ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koizong anu ahiei, apa ahiei hamsie lawte khu tha ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh mi kihau uhenlen khat in khatpen suongtum ahiei ahisihleh khuttum ahiei in su henlen shi lou in lupna ngah in umta leh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hing thou kia theiin, chiengkhut khun a kholai avah thei leh, avawpa a siengding hi: ahun suhbei man alieu ding a, adamsieng sah ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh mikhat in asuohpa ahiei, asuohnu ahiei, chiengin sat henlen, akhutlum a ashi leh, tuamipa gawt ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanlezong ni khat ahiei, ni ni ahiei adam le-vang gawt lou ding ahi, aziehpen ama nei le lam ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mite akihau ua, numei nauvop lai asuh khah ua, anau atol leh anualam a sietna bangma in azui sih nahleh; anumeinu Pasal in atunga anget bang banga lieusah ding ahi, hinanleh vaihawmten alep dungzui a lieu sah ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh sietna dang mawngmawngin azui khah leh hinna tanga hinna, na pieh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mit taanga mit, ha taanga ha, khut taanga khut, keng taanga keng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Meia hal tanga mei a hal, liem tanga liem, vuoh tanga vuoh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mikhat in asuohpa ahiei, asuohnu ahiei mit suh pieh in setaleh, amit ziehin ama zalenin apei sah ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh mi’n asuohpa ahiei, asuohnu ahiei ha asuh kieh sahleh, a ha ziehin ama zalen in apeisah ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bawngtal in Pasal ahiei, numei ahiei, a suhlialeh tua bawngtal khu suonga selia ngeingei ding ahia, asa neh vawtlou ding ahi. Hinanleh bawngtal neipa tung thu asieng ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hinanleh bawngtal khu tumasanglam a zong mi nasu ngai sa, tualeh a pupa kunga zong, na kihil zel ahi a, hinanleh abawngtal a khum nuom lou ziehin Pasal ahiei numei ahiei na sulia taleh, bawngtal suonga selia ding ahia, aneipa zong shisah ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A tung a dangka sum pieh phut ahileh, ahinna tatna dingin akiphut za za apieh ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi tapa ahiei tanu ahiei a suh lia leh zong tam vaihawmna dan dungzui a, atunga kibawl ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bawngtal in suohpa ahiei suohnu ahiei, asuhlia leh bawngtal neipa’n, apu uh kungah dangka shekel sawm thum ape dinga, bawngtalpen suonga selia ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mi khat in leikhuh vua-kia loua anua sie ahiei, ahisihleh leikhuh tou a, sinlou a akoi zieh a bawngtal ahiei sabiltung ahiei, tua leikhuh sunga akieh leh;
  </para>
  <para style="p">
    <verse number="34" style="v" />Tua leikhuh neipa’n ganta man asan ding ahi; ganta neipa sum ape dinga, tuachi’n ganta shisa khu aman atang ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi khat bawngtal in midang bawngtal asuh liem a ahileh, abawngtal hing nalai pen a zua ding ua, a sum akihawm ding ua, tualeh bawngtal shi pen asa aki-hawm ding uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahisihleh, tua bawngtal in tumalam a zong ganta na su zel zel sa ahi chi akitheidoh a, anei pan akhum utlou ahileh, bawngtal tangin bawngtal ma ape dinga, ashi pen aman atang ding hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Mi khat in bawngtal ahiei, belam ahiei, aguh a atha ahiei, ahisihleh azualeh, bawngtal khat tangin bawngtal nga tualeh belam khat tangin belam li, apieh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Guta khat in mi inn abulu a, ana kivuoh a, ashi leh, ama ziehin sisan akisuo sih ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni’in asuoh khum manleh amazieh in sisan suo ahi dinga, aguhteng zong kimtahin apekia ding hi, pieh ding anei sih leh, aguhtat ziehin ama akizua ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A sil guhte bawngtal ahiei, sabiltung ahiei, ahisihleh belam ahiei hitaleh ahinga ama khuta akimu doh leh ale-ni in asang ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi khat in midang khat loulai ahiei, grep huon ahiei a, a ganta athangtatsah a, a nehtum sah taleh; ama lou hoipen leh agrephuon hoipen a adit ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mei ahing kah a, ling-lomte ahing pe a, buphaite ahiei, bukung dinglaite ahiei, ahisihleh aloulai pumpi akah tumtah leh; tua mei halpan akatum zousie aun in a dit ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mikhat in a innvengpa kungah, sum ahiei, avante ahiei kepsah dinga apieh a, tua vante akep sahpa innsunga pat akiguh manga, agupa akimat leh aleni in adin ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Agutapa akimatdoh lou leh, a inn neipa’n a innvengpa neitah tungah akhut aha kha eimah chithei chienna dingin, vaihawmte masangah ahing pui ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Suhkhelna pouma, bawngtal thu ahiei, sabiltung thu ahiei, belam thu ahiei, puon sil thu ahiei, van mang khat poupou tungtang thu mawngmawng ah mi dangin kei a ahi achileh, alang ni un vaihawmte mai ah athu uh tut hivan, vaihawmten a mawpai pen pen in a innvengpa aleni in a din ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi khat in a innvengpa kunga, sabiltung ahiei, bawngtal ahiei, belam ahiei, ahisihleh ganta khat poupou, kemsah ta henlen, koima theilou in ashi ahiei, aliem ahiei, ahisihleh na kikaimang taleh;
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n a innvengpa neitah akhoi khahleh khoi khahlou thu ah ani ua kikaal ah Mangpa min in kichiemna bawlva un, tuachi’n aneipa’n, tuami pom vanin, adin sih ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hinanleh ama apat a kigu ahileh, aneipa kunga adit ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sapi in ape a ana malnen tahlevang adihna chi theichetna dingin a them khat ahing tawi dinga, tuachi’n malnen a umpen adin sih ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Min a innvengpa ganta akawm a, aneipa umlou kaal a aliem a, ahisihleh, ashi tahleh pellou a a dit ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hinanleh aneipa akunga aumleh adin sih ding hi, man nei a kawm ahileh akikawm dandan thu uh ahiding.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Pasal in, nungah koimatoh kikham nailou, azawla aluppileh, akitenpi teitei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nu ngahnu pa’n azi dinga apieh ut vawt sih leh nungah siengthoute man ngainaza sum apieh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dawi thusiem numei mawngmawng na hinkhawi lou ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Koipou ganta toh lumkhawm pouma tha teitei ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Koipou Mangpa kung chilou, pasien dang kunga kithoina bawl pouma suhmangthang ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gamdang mite na suhbuoi ding ahi sih a, na bawlsiet ding zong ahisih hi; nouzong Izipt gam ah gamdang mi nana hitah ziehun.
  </para>
  <para style="p">
    <verse number="22" style="v" />Meithai ahiei, naupang pa neilou ahiei na bawl genthei dinguh ahi sih hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaute na bawl genthei ua, ka kunga kap kawma ang hat u’leh, ang hatna aw uh kana ngaikhe ngeingei ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n ka thangpaina a sou phut khadinga namsau in nou ka hing that kha dinga, tuachi’n na zite uh meithai ahi ding ua, na tate uh Pa neilou ahi ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na kung ua um ka mi gentheite, koipou sum na palahsah u’leh, sumpung hawmte banga na bawllou ding uh ahi; tualeh sumpung zong na lah lou ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na innvengte puonsil, lieukham dinga na lah leh, nitum masang ngei a na pieh ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuami apuonsil neisun ahia, atahsavun tuomlum ding, puonsil ahi thuoi a, bang silin a imu ta diei? Tualeh hichi ahing hiding hi, kap kawma ang hat chiengin kaza ding hi, hepisiem ka hi ziehin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pasian na housiet ding ahisih a, na mite lah a vaihawmte zong na samsiet ding ahisih hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na thei min masapen leh na zukai masapen lat ding kiheh sinlen, na tapate lah a pieng masapen kei nang pieh ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachimabanga na bawngtalte leh na belamte zong na bawl ding ahi; ni sagi sung api toh um van in; ani giet ni chienga nang pieh ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh kei a dingin misiengthou na hiding uh ahi, gamlah a gamsa in athasa mawngmawng na neh ding uh ahi sih, uite kunga na pai dinguh ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Thuthang dihlou na gen sawn ding ahisih a, theipi dihlou hidingin mi giloute toh kikhutzop sin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sil gilou bawl dingin, mipite na zui ding ahi sih a, thutanna heikawina dingin, mipi atam zote lam a pangin, thubuoiah thu na gen ding ahi sih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Migenthei zong athubuoi ah, na panpi tuom ding ahisih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na melmapa bawngtal ahiei, sabiltung ahiei, vahmang na mu leh akunga nang nuakai teitei ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma hing mudapa sabiltung avan gih puohin anetden namu leh, panpi nuomna lungsim neisih nanlachin zong, na panpi teitei ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na migenthei khu athubuoi ah dihlou tah a thukhenna na bawlpieh ding ahisih hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thudihlou apat kikoi gamla inlen, mawna neilou leh midihtat that sin, migilou siem ka tangsah sih ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh golguhna kichi mawngmawng na lah ding ahi sih, aziehpen golguhna in vaihawmte mit amiel sah a, midihtat thugen aheikawi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gamdang mi na bawlsiet ding ahisih a, noute zong Izipt gamah, gamdang mi nana hitah ziahun, gamdang mi lungsim na thei uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kum guh sung na gam ah, haichi na tudinga, tualeh haichi gate nala khawm ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh akum sagina kum in vang, na khawl sah dinga, na um sah khin khian ding ahi, tuachi’n na mite lah a gentheiten ane ding uhi. Tuamabangin na grephuon leh na Olive huon tunga zong na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni guh sung nna nasep ding ahia, ni sagi nia na khawl ding ahi, tuachi’n na bawngtal leh na sabiltung a khawl theina ding leh na suoh nu tapate leh na gamdang mite zong akisuhhal theina ding un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n na kung ua, kagen zousie ngaisah unlen: pasien dangte min mawngmawng lou kha sih unlen, nakam sung ua kipat in zong kiza sah sih un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kum khat sungin, kei a dingin pawi thumvei na bawl ding u hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tanghou tolsawlou Pawi na bawl dinga, (thu kahing pieh tah bangin ni sagi sung tanghou tolsawlou Abib ha a, hun kiguot ah na neh ding ahi; Izipt gam a kipat na hing pawtdoh u’khu tuami ha a ahiziehin tualeh ka masangah khut guoh in koima ahing kilah lou ding ahi.)
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh lou a na tu, na sepgimna ga masa pente, bulah pawi na bawl ding ahi; tualeh kumtawp chieng a, na bulahte inn a na hing khum zou chiengin pawltah pawi na bawl ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pasal zousie kum khat in thumvei Mangpa Pasian masanga ahing kilaah ding uh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kei a dinga kithoina sisan leh tanghou tol kisaw na lat khawm lou ding ahi, ka kithoina sathau zong zingmawng tan a um ding ahisih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na gam a haitha ga masapente Mangpa Pasian inn a na hing tawilut ding ahi. Kelnou sa api nawitui a na huon ding ahi sih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngaivawi lampi a nang hing veng ding leh, ka mun bawlsa a nangma hing tut dingin, na masangah van sawlsieng ka hing sawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama thu pilvang tahin ngaisah unlen, athu ngaikhie unlen suthangpai sih un, azieh pen na khelnate uh ahing ngaidam sih ding hi, ka min ama ah a um ngal a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hinanleh Ama aw na ngaikhiet a, ka thugen zousie na bawl leh, na melmate tungah melma ka hi dinga, nang hing doute ka dou ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka vansawlsieng na masangah apei zelding a, Amormite, Hitmite, Perizmite, Kanaanmite, Hivmite leh Jebusmite umna ah ahing puiding, tualeh amaute ka sumang ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A pasien te uh masangah kun sih unlen zong besih unlen, amauh bawldan in zong bawl sih un, hinanleh amaute na suchimit ding ua, amilimte u’leh akhuom siengthoute uh na satguoi ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Mangpa na Pasian nna nasem ding ua, tuachi’n aman naneh nadawn uh hing guolzawl van in, tualeh nalah ua kipat natna hii ka lamang ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na gam sung uah, nau sietna leh chiing mawngmawng a um sih ding; na damsung nite ka hing suhbuching pieh ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka giin huoina na masangah ka sawl ding a, na peina dinguh gam a mipite zousie ka subuoi dinga, tuachi’n na melmate un kang nuangatsah ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh na masang uah tunpite sawlvangin; tuamin Hivmite, Kanaanmite leh Hitmite khu na masang ua kipat kadel mangsah ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kum khat sungin amau’te na masang ua kipat, ka notmang sih ding hi, tuachilouin gam hing kieu gawp vanin, na sietna dingun gamsate hing pung kha va uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na hing pun ua, gam na hing luodim masang sie un, tawm nou nou in na masang uapat in ka delmang ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh na gamgi dingun, Tuipi san apat Philistinte tuipi dongin, tualeh gamdai akipat luipi dong, hing bawlpieh vangin, aziehpen agam a tengte na khut uah ka hing pe dinga, tuachi’n amaute na delmang ding uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaute leh a pasiente utoh thuhun na bawl dinguh ahi sih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amaute na gamsunga aten dinguh ahi sih a, tuachilou in, ka tungah tatsietna ahing bawlsah khading uhi, a pasiente uh nna nasep khahlaizang u’leh nou a dingin thang ahi ding hi.”
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Aman Mosi kungah, “Nang toh Aaron toh Nadab toh Abihu, tualeh Israel upate sawmsagi toh, Mangpa kungah hing kaltou unlen; gamla tah a dingin hing bie un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosi maimai Mangpa kunga ahing pei ding ahi, hinanleh amaute’n ahing naithei louding uh ahi; mipite zong amatoh apeitou lou dinguh ahi.”
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Mosi ahing pei a, Mangpa thu zousie leh thu khen vaihawmna zousie mipite kungah, a hil a, tuachi’n mipite zousien, aw kituohtahin a dawng ua, “Mangpa’n a gen zousie kabawl ding uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Mosi in Mangpa thugen zousie agiel a, zingmawng matahin athou a, muol bulah maitam abawl a; Israel nam sawm leh nite dungzui in, suong khuom sawmleni aphut hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh aman Mangpa kunga bawngtal a, halmang sillat leh lemna sillat kithoi dingin Israel mipite lah a tangvalte asawlta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mosi in sisan kimkhat ala a, maitam tungah athe hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n thuhunna laibu ala a, mipite zahin asim hi, tualeh “Mangpa gen zousie bawlva ungin athu ka mang ding uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Mosi in sisan ala a, mipite tungah athe a, tualeh “Ngaivawi, Mangpa’n tam thute zousie tungtang thu ah noutoh athuhun abawlna sisan khu ahi.”
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Mosi toh Aaron, Nadab leh Abihu, tualeh Israel upate sawm sagite toh akaltouta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh amaute’n Israelte Pasian amu ua, akeng nuoiah Saphire suonga kibawl hile kilawm, asien dan van sieng kilkel bangmai a um hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Pasian in Israeltate upate tungah akhut aha sih a, amauten zong Pasian amu ua, ane un adawn uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Mangpa’n Mosi kungah, “Muol tunga ka kungah hing kaltou inlen, khunah umin, tuachi’n mipite na hil dingin, suong peh a, dan leh thupieh ka gelte ka hingpe ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Mosi leh anasempa Joshua a dingdoh ua, tuachi’n Mosi Pasian muol ah akaltou tahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh aman upate kungah, “Na kung ua ka hing kile kia masangsie, tanah hing na ngah un, Aaron leh Hur toh umkhawm ding nahi uhi; mi koi inzong thubuoi bang ahiei na nei u’leh, akung uah na pei zel ding uhi.”
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Mosi muol tungah ava kaltou a, meilum in muol atuom ta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Mangpa thupina khu Sinai muol ah a um denta a, meilum in ni guhsung atuomkhuma; ani sagi niin meilum lah a kipat Mosi a han a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Israeltate mitmu a Mangpa thupina kilatdan khu muol tunga sil katumthei meikuong bang mai ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Mosi meipi lahah avalut a, muoltungah a kaltou ta hi; tuachi’n Mosi khu muol vum ah sun sawmli leh zan sawmli ava um ta hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a, akungah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israeltate kungah gen in, “Kei a dingin sillat hing tawikhawm uheh: michin alung tanga kiphaltah a pe poumate akipat, kei a dinga sillat dingin na la ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh ama ua kipat a sillat na lah dingte khu tamte ahi; sanate, dangkate, sum engte;
  </para>
  <para style="p">
    <verse number="4" style="v" />Vau zam engdumte, sandupte, sandangte, vau-malngatte, kelmulte;
  </para>
  <para style="p">
    <verse number="5" style="v" />Belamtal vun bum-sante, saham vunte, gichil singte;
  </para>
  <para style="p">
    <verse number="6" style="v" />Meivah a zahding thautuite, kinu ding thaunamtui leh hal ding sil gimnamtui tah toh;
  </para>
  <para style="p">
    <verse number="7" style="v" />Siempu puon leh a awm tuomna a zedingin Onix suong leh suongte toh;
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh mun siengthou hing bawlpieh uheh, alah ua ka ten theina dingin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Biehinn lim leh a sunga vanzah ding zousie, lim ka hing etsahte bangbang a na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh gichil singin bawm khat a bawl ding ua, adunglam tongni leh akim ahi dinga availam tong khat leh a kim, tualeh asanlam tongkhat leh akim ahi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Sanatui in na luonkhum dinga, asunglam leh apulam na luonkhum ding ahi, tualeh atung kimvel sana lal lukhu in na zem ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh tuami adingin sana taukuol li na sung dinga, tua aning lite ah nabul ding hi. Taukuol ni apang lang khat ah, taukuol ni apang lelam ah a um ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh gichil sing zawl ni na bawl dinga, sana tui naluon khum dinga,
  </para>
  <para style="p">
    <verse number="14" style="v" />Tua zawlte khu bawm panga tau kuolte ah na thun ding hi, tua zawlte a bawm akizawn thei na dingin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jawlte khu bawm panga kikhai taukuolte sungah a um den dinga, tuana pat lahdoh louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh bawmsungah theisahna ka hing pieh ding khu na koiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh sana chiim in Hepina toupha na bawl dinga, a sandan tong nileh akim, availam tong khat leh akim ahi ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Sana in Cherubim ni na bawl dinga, Hepina toupha mong lamte gel a seh toh na khet lut thaw ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cherub khat among lang khat ah bawl inlen, Cherub dang khat pen among lelam ah na bawl ding hi. Hepina toupha mongte gel ah Cherubimte nabawl ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cherubimten hepina toupha khu in ahate uh tunglam ah azah ding ua; akimaituo ding uhi, Cherubimten hepina toupha lam angat dinguh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hepina toupha khu bawm tungah na koiding a, tualeh bawm sungah ka hing pieh ding Techi panna na koi ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuamun ah ka hing kimupi dinga, Techipanna bawm tunga um Cherubimte gel kikal a hepina toupha tunglam akipat in, Israel tate kunga thupieh ka hing piehding sil zousie tungtangah nangma ka hing houpi zel ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh gichilsingin dawkang na bawl dinga adunglam tong ni ahi dinga, availam tongkhat ahi dinga, tualeh asanlam tong khat leh akim ahi ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua dawkang khu sana siengset in na luonkhum dinga akimvelah sana lallukhu na bawl ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh khutpeh chie a lien in, akimvelah atemna na bawl dinga, atemna kimvel ah sana lallukhu a na zep ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh tami dingin, sana taukuol li na bawl dinga, tua taukuol lite khu, aning lite a um akeng lite ah na bul ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh dawkang zawnna ding chiengzawlte khillutna dingin taukuolte khu a geiah a um ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh zawlte khu gichil singin nabawl ding a, sanatui na luonkhum ding ahi; dawkang zawnna dinga akinei theina dingin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh tuana dingin kuongte, hengte, haite leh asinte, abuohkhiehnadingin, noute na bawl ding ahi, tuate sanatui siengset a na luonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh dawkan tungah, ka masangah tanghousie na koi zing ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh sana siengset a kibawl thaumei khuom khat na bawl ding ahi. Thaumei tunna khuom leh a bate sehneu a khentuohsa ahi ding hi, apah mumte, amengdohte, apahpalte toh sakhat, akungpi toh kimat chiet ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thaumei tunna pangtuoh ah aba guh ahing mengkhe dinga, thaumei khuompang lang khat ah ba thum, tualeh thaumei khuom lelam pangah ba thum ma ahing mengkhe ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aba khatah Makha ga banga kibawl, nou thum leh apah mum leh, apahpal toh a um dinga tuabangma in aba lelam ah makha ga banga bawl nouthum apah mum leh, apahpal toh a um ding ahi; tuabangin thaumei tunna ba guhte na bawl ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n thaumei tunna kungpi ah makha ga bang a abaw nou li, apah mum toh apahpal toh a um ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh thaumei tunna akipata hing kadoh ba guhte dungzui in aba nite nuoi ah pah-mum khat a um dinga, tuatoh kizopin abate ni nuoi ah pah-mum ni a um ding hi, tualeh tuatoh kizopin aba nite nuoi ah pah-mum khat a um ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Apah mumte leh abate khu akungpi toh sakhat a kizop chiet ahi ding uhi: A unpi’n sana siengset a kikhen thaw a kibawl ahi ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh tuana detding thaumei sagi na bawl dinga, tuathaumeite khu detsa in atunna ah na tung ding hi; amazawn chiet uh atanvah theina ding un.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh meitena taitete leh meivam luohna kuongte zong sana siengset a bawl ahi ding hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuana vanzah um leh bel zousie sana siengset talent khat zang a na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tualeh muoltunga alim ka hing etsah bang ngei a, na bawl ding ahi chi theizing in, achi hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuabanah, biehbuh puonzah sawm neiin na bawl ding ahi; tangching puon kopta a kigan, adum, asan-au leh asandupte, Cherubte lim tuong siemtah a kigan in na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Puonzah khat saudan tong sawmni leh giet ahi dinga, tualeh puonzah khat letdan tong li ahi ding a, Puonzah zousie aki kim chiet ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Puonzah ngate, khat leh khat aki thuop khawm chiet ding ahia, tualeh adang ngate zong a kithuop chiet ding uh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh akimat tuona apat in puonzah mong gei guolah adumin abil na bawl dinga, tuachimabangin Puonzah dang mong gei-guol zong mattuona ni a nabawl ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Puonzah khat ah abil sawmnga na bawl dinga, anina kimattuona a puonzah mongah zong abil sawmnga ma na bawl ding hi; abilte khat leh khat akimat chiet theina dingun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh sana mehkil sawmnga na bawl dinga, tua mehkilten puonzah mongte atutuo dinga; tuakhu bieh-buh khat ahing hi ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh biehbuh tung khuna dingin kelmul puonzah na bawl ding a; puonzah sawm leh khat na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Puonzah khat sandan tong sawmthum ahi dinga, Puonzah khat letdan tong li ahi ding; Puonzah sawm leh khatte akikim chiet ding ahi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh puonzah ngate atuom chiet in na khuikhawm dinga, puonzah guhte zong atuom chiet in na khui khawm ding hi; Puonzah guhna khu biehbuh mai ah na hip ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Puonzah khuikhawm masa mong gei guol ageita pen ah, abil sawmnga na bawl ding a, puonzah khuikhawm langkhat mongah zong abil sawmnga ma na bawl ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh sum-eng in mehkil sawmnga, na bawl dinga, tua mehkilte khu abilte ah na vaw dinga, puon inn khu khat ahi theina dingin na kilkhawm chiet ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh puon inn puonzah val nalaite, akimkhat um nalaite, biehbuh nualangah na khai-khe ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Biehbuh puonzah adunglam a, a gei langkhat tuoh a, tongkhat tuoh valte khu, tamlang pang leh khumlang pang khukhumding in akaikhe ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh puonbuh khuna dingin belamtal vun kibum san na bawl dinga, atung sawn khuna dingin saham vunte na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh biehbuh adingin gichil singpeh lepkhawmsa tun dingin na bawl ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Singpeh khat sandan tong sawm ahi dinga singpeh khat vailam tongkhat leh akim ahiding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh singpeh khat ah kimattuona ni a um dinga; tuachi’n singpeh kilemtuote akiman tuoding uhi; tuachibangin biehbuh singpeh zousie na bawl ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh biehbuh a dingin singpeh sawmni simlam pangah, simlam ngain na bawl ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Singpeh sawmni nuoiah, dangkasia in khuom ngahna ding khuohkuoh sawmli na bawl ding hi, akimatna nite adingin, singpeh khat nuoi ah akingahna khuohkuoh ni, tualeh sing peh dang nuoi ah akimatna nite a dingin akingahna khuohkuoh ni ma na bawl ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Biehbuh pang nina mallam pangah singpeh sawmni a um ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh a dangka-sia kingahna khuoh kuoh sawmlite singpeh khat nuoiah, kingahna khuohkuoh ni, singpeh dang khat nuoiah kingahna khuohkuoh ni ma a um ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh biehbuh pangte tumlam a dingin singpeh guh bawl in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Apang ni-ah biehbuh ningte adingin singpeh ni na bawl ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n a nuoi lam ah tuate khu akibulkhawm dinga; atunglam ah sia-kuol toh akibulkhawm ding hi; tuachibangin ani tuoh ua a kizopmat ding uh ahi; tualeh tamte gel khu aning gel a pang tuoh ding ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n singpeh giet ahidinga, tualeh adangka kingahna khuohkuohte uh kingahna sawm leh guhte; singpeh khat nuoi ah khuohkuoh ni, singpeh dang khat nuoiah khuokuoh ni a um ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh gichilsing zawl na bawl dinga, biehbuh pang langkhat a dingin zawl nga.
  </para>
  <para style="p">
    <verse number="27" style="v" />Biehbuh lelampang a dingin zawl nga tualeh biehbuh tumlam sih nite a dingin zawl nga ma na bawl ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n, sing pehte laikim taha sing zawl kihung laita penin among khat apat among lang khattan a phah ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh singpehte khu sanatui a na luonkhum ding ahi, tuate tholna dingin sana taukuol na bawl dinga, tualeh azawlte sanatui a na luonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n muoltunga alim hing ki-ensah dungzui in, biehbuh na tungding ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh puonzah ding Puondum, Puonsandup leh san-au in Puonmalngat kopta a, khutsiem taha Cherubim lim tuonga kigan, na bawl ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuami khu sanatui a kiluonkhum gichilsing khuom lite tungah nazah dinga, akibaatna bilte sana a bawl ahi dinga, dangkasia khuohkuoh tunga kiphut ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh techipanna bawm puonzah sunglam a, na hing puohlut theina dingin puonzah khu mehkil a kil in na khai ding ahi; tuachi’n tua Puonzah in mun siengthou leh mun siengthoupen kikaal akhen ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh mun siengthoupen a techipanna thuhun bawm tungah hepina toupha na koiding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh Puonzah pulam ah dawkan na koi dinga simlampang biehbuh siih ah dawkan toh kizawn in meivah khuom na tungdinga, mallam pang ah dawkan na koiding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh biehbuh kotkha adingin, Puondum, Puonsandup, Puonsan au, leh Puon malngat zem kilawmtah khut a kigan phin a kikhui na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh akhaina dingin gichilsing khuom nga na bawl dinga, sanatui na luonkhum dinga, a kibaatna khu sana abawl ahi ding hi. Tualeh khumte a dingin sum-eng kingahna khuohkuoh nga na sung ding hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tualeh gichil sing in, Tong nga asau, tong nga alien maitam khat na bawl dinga; tua maitam khu ning li nei ahi dinga; asanlam tong thum ahi ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh aning lite ah akii na bawl dinga, a kiite khu akibang chiet ding uhi; tuate khu sum-eng na luonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh meivam dawna ding belte leh a meiam luohnate, akuongte, ataite te leh a mei belte na bawl ding a, tuana umlebel zousie sum-eng in na bawl suoh ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh maitam adingin sum-eng len a kiphan khat na bawl dinga, tua len tungah sum-eng taukuol li aning lite ah na bawl ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuapen maitam zawlpi nuoia na khai ding alen kiphan khu maitam laikim tandonga a kikhai khiet theina dingin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh maitam adingin gichilsing zawl ni na bawl dinga, sum-eng tui in na luonkhum ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zawlte khu tau kuol sungah na thun dinga tualeh zawlte khu maitam pang lang khat tuoh ah azawnna dingin a um ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Singpehte alai hawmin na bawl dinga; muoltunga hing ki-en sah bangin na bawl ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh biehbuh huongsung na bawl dinga, a sim lampang ngain asih langkhat adingin, Puon malngat kopta akigan tong zakhat a sau, puonzah langkhat a ding a um ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n khum khuom sawm nite leh akingahna khuohkuoh sawmnite khu sum-eng a bawl ahi dinga, khuomte a akhaina sia kawite leh Puonduongte dangkasia a bawl ahi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuamabangin mallam panga asaudan tongza asang puonkhai a um ding hi, tualeh khuom sawmnite leh akingah na khuohkuohte sum-eng a bawl ding ahi; a khuoma khaina te leh puonduongte dangkasia a bawl ahi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n tumlam panga huongsung vailam a dingin, Puonkhai tong sawmnga a sau a um ding hi; akhuom sawm, akingahna khuohkuoh sawm ahi ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huongsung let dan suolam pang ah tong sawmnga ahi ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kotpi sih langkhat lam a puon khaite tong sawm leh nga ahi ding; akhuom thum, akingahna khuohkuoh thum ahi ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh alangkhat lam pangah Puonkhai tong sawm leh nga a sau a um ding; akhuom thum leh a kingahna khuohkuoh thum ahi ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh huongsung kotpi a dingin, puonkhai tong sawmni a sau adum, asandup, asan-au leh puonmalngat kopta akigan, tualeh phin a kikhuite a um ding hi, tualeh akhuom li leh akingahna khuohkuoh zong li ahi ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huongsung kimvel a khuomte zousie dangka puonduonga khikhawm a hi ding; abatnate dangkasia ahi dinga, tualeh akingahna khuohkuohte sum enga bawl ahi ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A huong sung dunglam saudan, tong zakhat, a vailam letdan tong sawmnga ahi ding, tualeh asanlam puonmalngat kopta agat tong nga, tualeh angahna khuohkuoh sum-eng a bawl ahi ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Biehbuh sunga kizang um leh bel zousie leh akilbehna zousie, ahuong sung a sil khaina zousie sum-eng a bawl ahi ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thaumei mitlou a akuon zing thei na dingin, meivah a detding; Olive thau siengtah suhdoh hing tawi dingin Israel mipite thu nape ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kimutuona biehbuh sunga techipanna puonzah pulam ah, Aaron leh atapaten Mangpa masangah, nitah apat zingmawng dongin alim kep mama ding uh ahi. Tami Israeltate dinga akhang tungtawn ua, thugousie khat ahi ding hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tuin Israeltate lah a kipat in na sanggampa Aaron leh akunga um atapate na kungah pui inlen, aman kei a dinga siempu nna asep theina dingin Aaron leh atapate Nadab, Abihu leh Eleazar tualeh Ithamar tetoh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh na sanggampa Aaron a dingin athupisah ding leh akilawm sah dingin puonsil siengthou na bawlpieh ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n pilna hagau a ka dimsah, mi lungtang pilte zousie kungah thu gen in, siempu nasepna mun a, Ka nna asep theina dinga, Aaron ading akisuhsiengthou na ding puonsil abawlpieh thei na dingun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh tamte ahi puonsil dinga abawl dingte uh, awmtuomna, siempu puon, Puonahtuol, Puonahjem, dielkhip leh konggah; tualeh na sanggampa Aaron leh atate a dingin, puonsil siengthou abawlpieh ding uhi; siempu mun a ka nna ang seppieh theina dingin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaute’n sana khaute, khaudum, khausandup leh san au te, tualeh khau malngatte ala ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh amauten sana khaute, vau dumte, sandupte, san-aute, tualeh vau malngat Kopta a siemnel tah a kigan in siempu puonah abawl ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh tua puonah mong mailam leh nualam khui khawm liengkou ni nei sah ding ahi; tuachi’n akimatkhawm thei ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh puonah tung kawnggah siemneltaha kigan khu Puonah toh chi khat ahi ding a, tuakhu sana khaute, adum, asandup, asan-au leh puonmalngat kopta a gat ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Onix suong mantam ni nala dinga, atung ah Israel tate min na giel ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh suong khat tungah aminte lah ua guh na giel dinga, tualeh suong dangpen tungah min guh ma amau piendan dungzui in na giel ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Suonggiel siemmi’n agel banguh, min namna a tuong bangin, Israel tate min tua suongtegel ah na giel dinga, tuate khu sana khau kipheh a khum dingin na bawl ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua suongte gel khu Israel tate theizingna suong dingin siempu puonah liengkou gel ah na bel dinga, tuachi’n Aaron in theizingna dingin Mangpa masangah aminte uh aliengkou gel ah apo ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh sana in atuomna na bawl ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh amongte gel ah sana siengset a ki bawl khainieng nite pahkhi gui bangin apheh thawin na bawl dinga, akibultuonate ah tua pahkhi bang khainiengte na khi ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh siemnel taha bawl vaihawmna awmtuom na bawl dinga, siempu puonah kibawl bangin na bawl ding hi, sana khaute vaudumte, sandupte, san-aute leh vau malngat hoi kopta in na bawl ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tam khu hip ni a akihip chienga aning li kikim, asaudan khap khat, alet dan khap khat ahi ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh tami sungah suongmantam guol li na zeplut ding a; guol khatna khu, Sardi, Topaz leh Karbunkul suongte ahi ding; tampen a guol khatna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aguol nina pen, Emerald, Saphire, tualeh Diamond suong ahi ding;
  </para>
  <para style="p">
    <verse number="19" style="v" />Aguol thumna khu Jachinth, Agate, tualeh Amethist suongte ahi ding.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh aguol lina khu, Beril, Onix leh Jasper suongte ahi ding hi, tuate khu sana a ki bawl a tuomna a tuom ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh tua suongte ah, Israel tate min dungzui in sawm leh ni, amin uh bang zel in min namna a tuong bangin ahi ding hi. Michin amin utoh nam sawm leh ni dungzui in ahi ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh awmphaw tungah khau huol toh kibang khainieng sana siengset a kiphan na bawl ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Awmphaw tungah sana tau kuolni na bawl ding a, tua taukuol nite khu awmphaw mong gel ah na bul ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sana khainieng kihuol nite khu awmphaw monga um taukuol nite sungah na thun ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh khainieng kihuol mong lelam nite khu sana khauphan nite ah na khi dinga siempu puonah liengkou mailam a nakhi ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh sana taukuol ni bawl inlen, tau khu siempu puonah sunglam panga um awmphaw ningte gel ah na koiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sana taukuol ni dang zong bawl inlen tuate khu siempu puonah liengkou mailam te gel nuoilam panga, kimattuona mun leh siempu puonah gahna, siemnel taha kigan tunglam ah na vaw ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh siemnel tah a, kigan siempu puonah gahna tunglam a aum theina ding leh siempu puonah apat awmphaw akol theilouna dingin, awmphaw khu tua taukuolte ah khauhuol dumin na khikhawm ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Aaron mun siengthou a apei chiengin Mangpa masanga atheizing na dingin, alungtang tungah Israel tate min vaihawmna awmphaw ah apozel ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh vaihawmna awmphaw ah Urim leh thumim na koi ding ahi; tuate khu Aaron Mangpa masanga alut hun chieng, alungtang zawnah akoi zel ding ahi, tuachi’n Aaron in Israel tate vaihawmna khu Mangpa masanga apei hun chiengin alungtang zawnah a pozel ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh siempu puonahtuol khu adum ngen in na bawl ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Atunglam laitahah lu thunna ding ahawm khat aum dinga; ahawm kimvel akehbai louna dingin, puonah bantawng bangin agei kimvel na aiha kat ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh among nuoilamah adum in, asandup in, tualeh asan au in, among kimvel ah kawlbuthei lim na bawl dinga; akimvel in akikaal uah sana dah na bawl ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sana dah khat leh kawlbuthei khat, sana dah khat leh kawlbuthei khatma puonahtuol mong kimkot a, na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Aaron in Pasian na asep chiengin tam puonahtuol asil dinga; mun siengthou a Mangpa masanga alut leh apawt chiengin agin akiza ding, ashi lou na dingin.
  </para>
  <para style="p">
    <verse number="36" style="v" />Sana siengset peeh khat na bawl dinga atungah min namna a tuong bangin “MANGPA KUNGAH SIENGTHOUNA” chi na giel ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tami siempu dielkhip tunga a um theinading in khauhuol dum in dielkhip mailam zawn ah nakhi ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tami Aaron talpanga kitaa zing ding ahi, Israel taten asilpieh siengthou ding ua, alat dingte lah ua khelna umte khu Aaron in apuoh zel ding ahi; tuakhu Mangpa masanga santah a, a um theina dingin Aaron atalpanga a um zing ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh vaumalngat nem hoitah gan inlen, vaumalngat in siempu dielkhip na bawl dinga, tualeh kawnggah pen phin a siemtah a kijem a khui in na bawl ding hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tualeh Aaron tapate adingin puonah na bawl pieh dinga, kawnggah zong na bawl pieh ding hi, tualeh athupisah ding leh akilawmsah dingin diel khip ding zong na bawl pieh ding hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tamte khu na sanggampa Aaron leh akunga um atapate na silsah ding ahi. Kei a dinga siempu nna ahing seppieh thei na dingun, amaute sathau nanu dinga, na koituom dinga, na susiengthou ding hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tualeh aguohtanna uh selna dingin, vau malngat in toka na bawl pieh ding a akawng ua pat a pheizum tan uh akhu dinguh ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh Aaron leh atapaten kimutuona biehbuh sunga ahing lut chieng u’leh mun siengthou a Pasian nasem dinga maitam phung lam ahing lut chieng ua, gitlouna apuohlut ua ashilou na dingun, tam puonte asil dinguh ahi. Tam dante Aaron leh anua a ahahasuonte dinga, abei theilou kumtawna thupieh ahi ding hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tualeh siempu nna sem a ka nna asep theina ding ua, amau’te suhsiengthou na ding a, a tung ua na bawl ding tamte ahi: bawngtal tuoi khat leh gensietbei belam ni la inlen;
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh tangbuong tolsawlou, tanghou beu tolsawlou sathau kinu, tualeh tanghou pheng tolsawlou sathau kinu; na hing tawi ding ahi, tuate khu tangbuong nel a na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh tamte khu law sungah na koi dinga, a law in nangtawi dinga, bawngtal leh belamtalte gel toh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Aaron leh atapate kimutuona biehbuh kot kungah na hing pui dinga, amaute tuiin na sil ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Puonsilte la inlen, Aaron Puonah tungsil leh siempu Puontuol toh, siempu puon gahna siemnel tah a kigan in na gah ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh a siempu dielkhip a lu ah na khip sah dinga, a dielkhip tung ah manglukhu siengthou na koiding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuazouchiengin nu ding sathau na la dinga, a lutung ah na sung dinga, sathau na nu ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n atapate na hing pui dinga, puonah tungsilte na silsah ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh kawnggah in amau’te nagah dinga, Aaron leh atapate, tualeh alu uah diel na khip sah ding ahi, tuachi’n siempu nasepna khu tawp chi neilou a semden dingin namdet ahita ding uhi; tualeh Aaron leh atapate na susiengthou ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh kimutuona biehbuh mai ah bawngtal na hingkai dinga, Aaron leh atapaten bawngtal lutungah akhut uh angam ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh bawngtal khu, kimutuona biehbuh kotkhah bul ah, Mangpa masangah na that ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh bawngtal sisan khu na la dinga maitam kiite ah na khut me in na taat dinga, tualeh sisan khu maitam bul a na buoh sieng ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh asungthau zousie leh asin tuom thau leh akal nite leh atuomtu thaute na la dinga, maitam tungah na hal ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinanleh bawngtal sa leh avun leh a eeh pum a giehphuol pulam a mei a na haltum ding ahi; tami khelna kithoina ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh belamtal khat zong hing kai inlen, Aaron leh atapaten tam belamtal lutungah akhut uh anga ding uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh belamtal khu na that dinga, asisan na la dinga maitam kimvel a na the ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh belamtal khu nasem nen dinga, asung sa zousie leh akengte na sawp ding a, na semnen sate leh alutang na koi khawm ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n belamtal sa apumin maitam tungah na haltum ding hi. Tami Mangpa dinga halmang sillat ahi. Tami Mangpa dinga mei a kihal gimnam tui ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh belamtal dang khat zong nang kai dinga, Aaron leh atapaten tua belamtal lutungah akhut uh anga ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n belamtal khu na that dinga, asisan na la dinga, Aaron bildawn zietlam leh atapate zietlam bildawn leh akhut zietlam uh khutpi leh azietlam kengpi tungte ah na nu ding ahi. Tualeh maitam kimvel ah sisan na the ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh maitam tunga um sisan leh sathau kinu te khu la inlen, Aaron leh apuonsilte leh atapate leh akunga um atapate puonsilte tungah na the ding ahi. Tuachi’n ama leh a puonsilte leh atapate leh akunga um atapate puonsilte suh siengthou ahi ta ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hinanleh belamtal thau, amei thautah leh a sungthau toh, asin tuom thau leh akalnite leh atuop thaute toh, alieng zietlam na la ding hi; tami kisuhsiengthouna belamtal ahi zieh in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Mangpa masang a um tanghou tolsawlou law sunga um apat tanghou beu khat toh tanghou pheng sathau kitaat toh, tanghou phengneu khat na la ding a;
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuate khu Aaron khut leh atapate khut ah na koisieng dinga, Mangpa masanga vei sillat dingin tuate na nei ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh akhut ua pat in tuate zousie na nualah kia dinga, halmang sillatin Mangpa mai a gimnamtui dingin maitam tungah na haltum ding hi. Tami Mangpa dinga mei a hal kithoina ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Aaron suhsiengthou na Belamtal a awm-pheng na la dinga; Mangpa masanga vei sillat dingin tua khu na vei ding hi, tua khu nang tanvou ahi ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Aaron leh atapate dinga suhsiengthouna belamte vei sillat awmpheng leh vei zousa, khai sillat lieng khu na susiengthou ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuakhu Israel tate lah a, kumtawn a Aaron leh atapate tanvou dinga guot ahi ding; tuakhu khai sillat ahi ziehin, Israeltate lemna sillat kithoinate akipat a, khai sillat ahi ding. Mangpa kunga, a khai sillat uh ahi ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Aaron puonsilte khu ama nua chienga atapate ading ahia, thau nuni leh kinamdet ni chiengin tam puonsilten akivon ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh ama taanga siempu a pang atapa in kimutuona biehbuh sunga mun siengthou a Pasian nna sem dinga angpei chiengin tua puonte ni sagi asil ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh kisuhsiengthouna belamtal khu na la dinga mun siengthou ah na huon ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n Aaron leh atapaten belamtal sa leh law sunga um tanghou khu kimutuona biehbuh kotzung ah ane ding uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh amaute suhsiengthouna ding leh kituomkoi na ding a, tatna kibawlna silte ane ding uhi. Hinanleh gamdang miten anetheisih ding hi, sil siengthou ahi ziehin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh kisuhsiengthouna sa leh tanghou, zingchieng donga val aumleh, avalte mei a na haltum ding ahi, na neh lou ding ahi, sil siengthou ahi ziehin.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh na kunga ka hing thupieh dungzui a, Aaron leh atapate kunga na bawl ding ahi. Ni sagi sung amaute na susiengthou ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh nichin in khiel kithoina sillat dingin bawngtal khat lemna sillat in na lan ding hi, tuachi’n kilemna na bawl chiengin, maitam na suhsiengthouna dingin sathau na nu ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Maitam a dingin ni sagi sung kilemna na bawl dinga, na susiengthou ding hi, tuachi’n tami maitam siengthou pen ahi dinga, maitam khoikha pouma asiengthou ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tuachi’n maitam tunga na sillat ding khu tamte ahi, ani aniin belam kum khatna ni ahi ngitnget ding hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Belam khat zingmawng nalan dinga, belam dang khatpen nitah in nalan ding hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tualeh belam khat toh tangbuong ephah se sawm suo se khat thau hin seli suo se khat toh kihal, tualeh dawn sillat dingin uoin hin seli suo sekhat na pansah ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh belam dang khatpen maitam ah na lan ding a, zingmawng ann sillat dungzui leh dawnding sillat dungzuiin, gimnam tuidingin Mangpa adinga kihal sillat na lan ding hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tuakhu nakhang nakhang ua, na hah nasuonte tan a, kimutuona Puonbuh kotkhah bula Mangpa masanga halmang sillat ahi zing ding hi: tuanah ang houpi dingin ka hing pei zel ding hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh Israel tate toh tua munah ka kimutuo ding hi; tuachi’n biehbuh khu ka thupina a suh siengthou ahi ding hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tualeh kimutuona biehbuh leh maitam khu ka susiengthou dinga; Aaron leh atapate zong siempu mun a ka nna semdingin ka susiengthou ding hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tuachi’n Israel tate lah ah ka teng dinga, a Pasian uh ka hi ding hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tualeh amauten alah ua ka ten theina dinga, Izipt gam a kipat a amaute, hing puidohpa ka hi chi athei ding uhi, Kei Mangpa a Pasian uh ka hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tualeh gimnamtui halna maitam na bawl dinga, gichil singin na bawl ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Adunglam tong khat, availam tong khat ahi dinga ningli nei ahi ding a, asanlam tong ni ahi dinga, ningli nei ahiding a akiite akibang ahi ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh maitam tung apanglam aziet avei kimvel leh a kiite sana sieng set tuiin na luonkhum dinga, a kimvel ah sana in ageituomna na bawl ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh agei tuom nuoiah sana taukuol ni aning sih tegel ah na bawl dinga, asihte gel ah na vaw ding hi; tuapen azawnna chieng zawl te kithunna ahi ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh azawnna ding zawlte gichil sing in na bawl dinga, sanatui na luonkhum ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh tami khu techipanna tunga kang houpi zelna ding, hepina toupha mai a techipanna bawm kunga puonzah bul ah na koi ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aaron in tuami tungah zingmawng tengin gimnamtui ahal dinga, thaumeite adet zou chiengin gimnamtui ahal ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Aaron in nitahlam chienga thaumeite adet chiengin gimnamtui ahal zel ding ahi; nakhang nakhang ua Mangpa masanga gimnam tui ahi zing ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuami maitam tungah theilou gimtui ahiei, halmang kithoina ahiei, ann neh ding sillat na lan sih ding a, tualeh dawn sillat zong atunga na buoh ding ahi sih hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Aaron in kum khat in khatvei kiite tungah lemna abawl dinga, lemna dinga khelna thoina sisan in kum tengin khatvei na hahnasuonte uh tan in kilemna abawl zel ding uh ahi: tuami Mangpa adinga maitam siengthou pen ahi ding hi.”
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="12" style="v" />“Israeltate mi phaza na sim chiengin, aphaza uh nasim dungzuiin michin in ahinna uh tatna Mangpa kungah ape ding uhi, amaute na sim hun chienga alah ua natpi atun louna dingin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tam khu apieh dinguh ahi, sim sate lah a pang dinga peisuoh chin in mun siengthou a, kipe zel bang shekel khat ape ding uhi. (Shekal khat khu gerah sawm ni ahi): Shekel kimkhat pen Mangpa dinga sillat ahi ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Simsate lah a pang dinga peisuoh zousiete kum sawmni a upa leh atung lam in Mangpa kungah sillat ape ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na hinna uh tatna dinga, Mangpa kunga sillat na pieh chiengun, ahauten aval ape sih ding ua, azawngten zong shekel kimkhat sanga tawmzaw ape sih ding uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Israel tate kitatna sum na la dinga, kimutuona puonbuh nasepna dingin na mang ding hi; na hinna uh tatna dinga Mangpa masanga Israel tate adinga theizingna ahi theina dingin,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Mangpa’n Mosi ahoupia akungah,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kisilna ding sum-eng in tuikuong bawl inlen akeng zong sum-eng main na bawl ding hi, tuapen kimutuona biehbuh leh maitam kikaal ah na koi ding hi; tualeh asungah tui na koi ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aziehpen Aaron leh atapaten tuanah akhut u’leh akengte uh asil zel ding uh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kimutuona biehbuh sunga alut chieng uh ahiei, Mangpa dinga mei a hal sillat hal dinga, maitam phunga nasemdinga ahing lut chiengun, tua tuiin akisil zel ding uhi, tuachilouin ashi mai ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n ashi louna dingun akhutte u’leh akengte uh asil ding uhi, tuakhu amaute a ding leh ahah asuonte tandong ua dingin kumtawn thugousie ahi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuaban ah zong Mangpa’n Mosi ahoupi a, akungah;
  </para>
  <para style="p">
    <verse number="23" style="v" />“Gimnamtui lah a namtuipen Murrah tui shekel za-nga, singthal namtui tuaza kim khat, shekel zani leh sawmnga toh, kawltu gimnamtui shekel zani leh sawmnga.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh singthal chidang shekel zanga, mun siengthou a apieh zel uh shekel bang leh Olive thau hin khat toh hing toi inlen;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ginnamtui siemtu in asiem bangin, nuding sathau siengthou na bawl ding hi; tuapen nu ding sathau siengthou ahi ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh kimutuona biehbuh leh theipina bawm na nu ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh dawkang leh umlebel zousie leh thaumei tunna leh avanzah zousiete leh gimnamtui koina maitam leh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Halmang sillat maitam avanzah zousie tualeh tui kuong leh adouna keng zong na nu ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n asiengthou penpen ahing hi theina dingun, tuate na susiengthou ding hi. Tuami thamkha pouma asiengthou ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Aaron leh atapate sathau na nu ding a, na susiengthou ding hi; kei a dinga siempu nna asep thei na ding un.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Israel tate kungah, Tam sathau khu nakhang tungtawn ua kei a ding a, nu thei sathau siengthou ahi ding hi; chi’n gen in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mihing tahsa tunga sun ding ahi sih a, tualeh tam sathau kibawl bangin adang na bawl lou dinguh ahi, tami sathau siengthou ahita a, nou a dinga zong asiengthou ahi ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Koizong tam sathau toh kibang a bawl a hiei, ahisihleh gamdangmi tunga nukha a umleh, tua mipa khu amite lah apat satkhieh ahi ding,” chiin agen kia hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Mangpa’n Mosi kungah, “Gimnamtuitahte, stakte, onika, galbanum, la inlen, gimnamtui tah begaw siengtah abuh dan kibang la in.
  </para>
  <para style="p">
    <verse number="35" style="v" />Gimtui siempa siembang in chi kisaw chiim leh siengthou tahin gimnamtui na bawl ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh khenkhatte na gawtbuong ngingei dinga, kimutuona biehbuh a theipina bawm masang ah na koi ding hi, tuakhu nou adingin sil siengthou pen ahi ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hinanleh gimnamtui na bawl ding khu, akihalkhawm dan dungzui in nangma dinga na bawl ding ahi sih hi. Tami Mangpa dinga siengthou a na kep dinguh ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Koihitaleh tuatoh kibang nap ding bep a bawl aumleh, amite lah a kipat satkhieh ding ahi.”
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a akungah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“En in Keima’n Juda phunga Hur tapa, Uri tapa, Bezalel amin in kahanta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Pasian hagau in pilna, theisiemna, theitheina leh nasep siemna lam chintengah ama ka dimsah ta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khutsiemna toh bawldoh dingin, sana, dangka leh sum-eng nasem dingin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh suongmantamte bel dinga, atsiem siem nate, sing kilawm tah a atsiemnate sil zousie a, nasep siemna lam chin tenga sem dingin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh En in Keima’n, Dan nam a Ahisamak tapa Aholiab khu amatoh ka guot khawm tahi, na kunga ka hing thupieh zousie abawl thei na dingun siemna nei zousie lungtangah pilna ka koita hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kimutuona biehbuhte, theipina bawmte atunga um hepina toupha leh biehbuh vanzah zousiete;
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh dawkang leh avanzah zousiete, gimnam tui halna maitamte;
  </para>
  <para style="p">
    <verse number="9" style="v" />Halmang sillat maitam leh avanzah zousiete tuikuong leh a tunna toh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh siempu nasepna puonsilte, siempu Aaron puonsil siengthoute, atapate puonsilte siempu nasepna dingin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh kinu ding sathaute, mun siengthoua dinga gimnamtui hal dingte; na kunga thu ka hing pieh dungzuiin abawl ding uh ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Mangpa’n Mosi ahoupi a akungah,
  </para>
  <para style="p">
    <verse number="13" style="v" />“Israel tate kungah tambangin thu gen in, ka khawlnite na nit ngeingei dinguh ahi, Na hah nasuonte uh tana keileh nou kikal a chiemtena ahi ding hi, kei Mangpa noute hing susiengpa khu ka hi chi na theina ding un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuaziehin khawlni nanit dinguh ahi, Tuami nou a dingin ni siengthou ahi hi, koi hitaleh tam khawlni buasah pouma thalia teitei ding ahi. Koipou khawlni a nasem pouma, amite lah a pat satkhieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni guhsung nna nasem thei ding ua, hinanleh ani sagi ni khu khawldam na dinga khawlni Mangpa adinga siengthou ahi ding hi. Koi hitaleh khawlni a nna sem pouma thalia tei tei ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuaziehin Israeltaten akhang tungtawn ua thuhun tawp neilou a anit ding u’leh atan ding uh khawlni ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tami kei leh Israel tate kikaal a, kumtawn thuhun chiemtena ahi. Niguh sungin Mangpa’n lei le van asiema, ni sagini’n akhawla, atawldam ta hi, chi’n gen in, chi’n a gen hi.”
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Aman Sinai muol tunga Mosi ahoupi zouin, Pasian khut zunga giel theipina suongpeh ni Mosi apeta hi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n mipiten Mosi muol a kipat in hing kumsuh ha seng asata ua, mipite Aaron kungah ahing peikhawm ua, akungah, “Kisa’nlen kama uh pui dingin pasien te hing bawlpieh in, Mosi kichipa Izipt gam a kipat a hing puidohpa lah bang chi atai mah atungtang thu malmal ka thei kha nawn sih uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Aaron in akung uah, “Na zite uh na tapate u’leh na tanute un abil ua aba lai uh sana bilbate lakhie unlen ka kungah hing tawi un,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n mipi zousieten sana bilba abil ua aba laite uh alakhie ua, Aaron kungah ahing tawi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh aman akhut ua pat sanate ana la a, Bawngnou lim khat in a bawl ta hi, tualeh amauten “Israelte aw tamte khu Izipt gam a kipat ahing puidoh pasien te ahi uh,” achi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Aaron in tami amutah in, bawngnou lim masangah maitam abawla, tualeh Aaron in thuphuon abawla; “Zing chiengin Mangpa dingin pawi kibawl ding a hi,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n azingni’n matahin athou ua, halmang sillatte alan ua, kilemna sillatte ahing tawi uhi, tualeh mipite ne leh dawn dingin atou ua, tualeh ki mawl dingin a ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Mangpa’n Mosi ahoupi a, akungah, “Pei inlen kumsuh in; namite Izipt a kipat a na hing puidohte akisusegam sieng ta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Azui ding ua ka thupieh akipat kintah in akiheimangta uhi; bawngnou lim a bawl ua abeta ua, akungah kithoina abawl ua, Aw Israel Izipt gam a kipat a noute hing puidoh pasien te tamte ahi uhi, achi uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Mangpa’n Mosi kungah, “Tamite ka en a ka mu chienta hi, Ngai in amaute thuhil ha leh sapzalou migenhatah ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuaziehin tuin Keima ngentang hing umsah in, ka thangpaina amaute tung a, a kuon a, a kahtum theina dingin; hinanleh nang a kipat nam thupitah ka siem ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh Mosi in Mangpa a Pasian kungah angen a, “Mangpa silbawltheina nasatah leh khut hattah a Izipt gam a kipat a na puidoh na mite tunga bang dinga na lungthahna na kuonsah ding ahiei mah?
  </para>
  <para style="p">
    <verse number="12" style="v" />Bangding a Izipt miten muol tungte a thading leh leitunga kipat a sumangthai dinga atung ua sietna tut dingin amaute apuidoh ahi chi ding ahi uoi? na lungthahna zauhuoitah a kipat kihei kia inlen, na mite tunga tam silsie na bawl dinga pat in na lunggel heng mai in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na suoh Abrahamte, Isaakte leh Jakobte kunga nangma ngei kihahsiel a na ki chiemnate theizing inlen, akung ua, nahah nasuonte uh van a aasi za in ka pungsah dinga, na kung ua ka gensa tam gam zousie ka pedinga, amaute’n tamgam kumtawn in a luo dinguh na chite khu thei zingin a chi hi.”
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Mangpa’n amite tunga silsie abawl tup a kipat akisia kia ta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Mosi akihei a, muol tunga kipat a kumsuh a, theipina suong pheng kigielte gel akhut in atawi a, suongphengte gel khu lelam lelam a laiteng kigiel ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh suongpehte khu Pasian khutsuoh ahia, akigielte khu Pasian gel mama, suongpehte tunga kigiel ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Joshua in mipite kikou husa azah tahin Mosi kungah “Giehphuolah gal kidou husa gin a um hi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hinanleh aman, “Tami husa pen guolzawna kikou ging ahisih a, tualeh guollelna kikou husa ging zong ahi tuom sih hi, ka husa zahpen lasah thawmging ahi bou hi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh hichi ahing hia, giehphuol kung ahing tuntahin, bawngnou lim leh alam uh ahing muta a, tuachi’n Mosi lungthahna khu a kuongdoh ta a, asuongpeh tawite asep keh ta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n a bawngnou lim bawl uh ala a, mei in ahal a, tualeh a gawtguoi a, tuitungah athe a, Israel tate a dawn sah hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Mosi in Aaron kungah, “Tam mipiten na kungah bang abawl talawm ua, ahiei, hichi lawm lawm a khelna thupi leh huoisie atung ua na tunsah ta mai ahiei?” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aaron in, “Kapu lungthahna kuongzah sih heh, tamite khu sil bawlkhiel utmi ahi uh chi na thei asiei mah, achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amauten ka kungah, ka masang ua pei ding pasien te hing bawlpieh in; aziehpen Mosi Izipt gam a kipat a hing puidohpa lah heisunga um ahiei, hei a bangsuoh ataimah? chi ka thei kha nawnsih uhi, ahing chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n keiman akung uah, koihitaleh sana kizepna nei zousien sutkhie unlen hing pie un ka chia, tuachi’n amauten ahingpie ua, tuachi’n ken mei ah ka pailut a, tami bawngnou ahing suoh ta hi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuin Mosi in mipite sa guoh ahi uh chi amutahin (Aaron in amelmate ulah a azalatna ding un guohtang in ana umsah ta hi.)
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Mosi khu giehphuol lutna kotpi ah adinga, “Koi ahiei Mangpa lam a pang ding? Ka kungah hing pei heh” achia, tuachi’n Levitate zousie Mosi kungah apei khawm ta uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh akung uah, “Israelte Pasian in tambang in agen hi, michin in anamsau apang uah kuo henlen giehphuol sungah alutna kotpi akipat in kotpi lelam dongin, michin in a unaupa, michin in alawmpa, michin in a innvengpa that uheh” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Levi taten Mosi thu dungzuiin abawlta uhi. Tuami niin mi tul thum vel ashi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Mosi in, “Tuni’n Mangpa kungah kisusiengthou un, michin in atapate, a unaupate na dou ta uhi, tuachi’n “Mangpa’n” ahing guolzawl thei na dingin,” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh azing ni’n hichi ahing hia, Mosi in mipite kungah, “Nouten khelna thupitah na bawlta uhi, tuaziehin tuin kei Mangpa kungah ka peitou dinga, ahitheileh na khelna zieh ua thuphatawina kava bawl ding hi;” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Mosi Mangpa kungah ava tungkia a, “Aw tam mipiten khelna thupitah ana bawlta ua sana pasien te akibawl ta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hitananlezong akhelna uh na ngaidam thei na diei, na ngaidam thei sih ding leh, kahing ngen hi, na laibu sunga na gelsa apat hepitahin hing thaimang mai in achi hi.”
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Mangpa’n Mosi kungah, “Koi inzong ka tunga sil abawl khiel leh ka laibu sunga pat ka thaimang ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuaziehin tuin pei inlen na kunga ka genna mun ah mipite puiin; Ngai in ka van sawlsieng na masangah apei ding hi; Bangtenghitaleh, gawt ding a, ka hing ve hunchiengin, akhelna ngei uah ka gawt na ding hi,” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Mangpa’n mipite khu Aaron bawngnou lim bawl ziehin a gawtta hi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Mosi ahoupi a a kungah, “Dingdoh inlen tana kipat in nang leh Izipt gam a kipat a na hing puidoh mipite toh, Abraham, Isaak leh Jakob kunga, nahah nasuonte kungah ka peding hi chia ka kichiemna gam ah peitou ta un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka vansawlsieng na masangah ka sawl dinga; tualeh Kanaanmite, Amormite, Hitmite, Perezmite Hivmite leh Jebusmite ka notdoh ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ki peitou ta un, nawitui leh khuoizu luonna gam ah, kei noute lahah kang peitou sih ding hi, migenha na hi ziehun, tua ahisihleh lamkaal ah hing that gam khavang,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n mipiten tami thu hoilou kigen azah bep un akap ta ua, koima akizem aum nawn tasih uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mangpa’n Mosi kungah “Israel hahlesuonte kungah gen in, migenhatah nahi uhi, na lah uah huntomnou khat noute toh zawhkhawm taleng ka hing mangthaisah siengta ding hi. Tuazieh in na sa tung ua na kizepna uh koikhie un, na tung ua ka bawl ding ka thei na dingin,” achita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Israel taten Horeb muol kung ahing tun un, akizep nate uh asutkhie uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Mosi in apuonbuh asut a giehphuol pulam ah gamla simtah ah azah a, tuakhu kimutuona biehbuh achi hi. Tualeh hichi ahing hia, koizong Mangpa sui ut pouma giehphuol pulam a kimutuona biehbuh ah ava pei zel uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh hichi ahing hia, Mosi biehbuh zuon a apei chiengin mi zousie a thou ua, a puoninn kot khah bul chiet uah a ding ua, Mosi biehbuh sunga aluttum masang a en zel uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh hichi ahing hi a, Mosi biehbuh sung a alut zou chiengin meilum ahing kaisuh a, biehbuh kot ah a ding zel hi, tuachi’n Mangpa’n Mosi ahing houpi zel hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n mi zousie’n biehbuh kot a meilum ding khu amu ua, mi zousie athou ua apuonbuh kot ua pat in abe chiet uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Mangpa’n Mosi pen mi’n alawmpa ahoupi bangin kimaituoin ahoupi hi, tua zou chiengin giehphuolah ang peikia zel hi. Hinanleh asuoh Joshua, Nun tapa, tangval khu biehbuh apat apawtdoh sih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Mosi in Mangpa kungah, “En in, tam mite hing puitou in nang chi a; tualeh akunga na sawlding koi ahiei nang thei sahsih hi, Ahinlah na min in ka hing thei a, ka mitmu in deisahna zong na tang hi, na hing chi ngal a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuaziehin tuin na mit mua hepina tang ka hileh, nang na hing thei na ding leh, na mitmu a hepina ka tanthei na dingin, na lampi hing theisah in, tualeh tam namte na mite ngei ahidan ngaituo in,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Aman “Ka umpina khu nang toh azawhkhawm dinga, khawldamna ka hing pe ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Mosi in Mangpa kungah “Na umpina in ahing zui sih ding leh tamna kipat hing puitou da mai ta’n.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kei leh na miten na mitmu in hepina ka tanguh chi bang ka chi thei ding uoi? Koute na hing zawpi natah khu ahisih ding amah? Kei leh na mite leitung nam zousie apat khentuom in ka umta ding uh,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Mangpa’n Mosi kungah, “Tua zong na gen bangin ka hing bawlpieh ding hi, ka mitmu a hepina na tanziehin, na min zong ka thei chien hi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Mosi in “Ka hing ngen hi, na thupina hing musah in” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Aman “Ka hoina zousie na masang ah Ka peisah dinga, Mangpa min na masangah ka tangkoupi zel ding, tualeh ka lungsiet ut, ka lungsiet dinga, Ka khotuo nuom, Ka khotuo ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Aman “Ka mai namu thei sih ding hi, aziehpen ka mai mua hing koima a um theisih hi,” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Mangpa’n, “En in, ka kungah munkhat a um, suongpi tungah ding inlen;
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh hichi ahing hi dinga, Ka thupina a hing pei sungin, suongpi kawm ah kang koi ding a, Ka hing peipel sungin ka khut in ka hing sel ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh ka khut ka ladoh dinga, tuachi’n ka nualam na mu dinga, hinanleh ka mai vang akimu sih ding hi.”
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi kungah, “Amasa pen bang bangin suongpeh ni kheng inlen, tua suong pehte tungah, na sekeh suongpeh masate gel tunga kigiel thuhun zousie khu ka giel kia ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuaziehin zingmawng chiengin mansain um inlen, zingmawng chiengin Sinai muol ah hing kaltou inlen, muolvum a ka masangah hing ding in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh nang toh koima ahing kaltou louding ahi, muol kimvel a zong koima mawngmawng akimukhah lou ding ahi. Tualeh Muol mailam a belamhon leh bawng honte ann mai a atat louding uh ahi.”
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Mosi in amasapen bangin suongpeh ni akhengta a, tualeh Mangpa’n thu apieh bang in zingmawng matahin athou a Sinai muol ah suongpeh nite akhut a tawiin akaltouta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mangpa khu meilum lah ah ahing kum suh a, ama toh tuamun ah a ding khawm ua, tualeh Mangpa min khu apuongzahta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mangpa khu amasangah apei suoh a, “Mangpa, Mangpa Pasian lungsiet siem leh khotuo siem leh thuoh theitah leh hoina leh thutah a dim;
  </para>
  <para style="p">
    <verse number="7" style="v" />Sang tampite tunga khotuona langsah zing a, gitlouna, bawlkhelna, leh khelna ngaidam zel a; hinanleh bangchihtana siemmawna a maw maisah lou, pate gitlouna tate tung leh tate tate tunga khang thum khang lina tan a phuba lapa chin a phuong doh hi.”
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Mosi kintahin akisa a, lei lam ngain akun suh a Pasian abeta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n aman “Tuin na mitmu a lungsietna tang ka hileh Aw Mangpa, hepitahin ka lah uah Mangpa hing pei in; migenhate hinan uleng ka gitlouna u’leh ka khelna uh hing ngaidam inlen, koute na goutan dingin hing nei in,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Aman, “Ngai in, thuhun Ka bawl hi, na mite zousie masangah, leitung pumpi leh koi nam lah a zong ki bawl ngailou sil lamdang ka bawl ding hi: tualeh alah ua na umna mi zousieten Mangpa nasep a mu ding uhi; na kunga ka bawl ding lah sil chizathuoi ahi ngal a.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Tunia na kunga Ka hing thupiehte zuiin: Ngai in na masangah Amormite, Kanaanmite, Hitmite Perezmite, Hivmite leh Jebusmite ka notdoh ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pilvangin, na peina gam a teng mite toh thuhun khat bawl khava uchin, na lah uah thang ahi kha ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh amaitamte uh na suchim ding ua, amilimte uh na suse ding ua, a pasiennu uh Ashera limte na phua pieh ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aziehpen pasien dang mawngmawng na bieh lou ding uh ahi, Mangpa amin khu thangsiet hat ahia; thangsiet hat Pasian ahi ziehin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachilouin agam a teng mite toh thuhun na bawl kha ding ua, apasiente utoh ang akawm kha ding ua apasiente uh kungah akithoi ding ua, tualeh noute ahing chiel ding ua, akithoina sa uh na nekha ding uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh na tapate ua dingin, atanu te uh na la ding ua, atanu te uh a pasiente utoh a angkawm ding ua, tualeh na tapa te uh apasien te utoh ang akawm sah kha ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Siemthu milim pasien na ki bawl dinguh ahisih hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tanghou tolsawlou pawi na bawl dinguh ahi. Thu ka hing pieh bangin Abib ha in ni sagi sung Tanghou tolsawlou na ne ding uhi; azieh pen Abib ha a, Izipt a kipat hing pawtdoh na hi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Naubu hong masapen pouma kei a ahi, tualeh na ganhonte lah ua, bawngtal hiin belam hitaleh atal pouma toh,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh sabiltung nou pieng masapen khu belamnou a na tat ding ahi, na tatlou a ahileh angawng na heh tanding ahi. Na tapa pieng masapente zousie na tat ding uh ahi. Koi ma ka masangah khutguoh in ahing kilah ding ahisih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ni guhsung nna nasem ding ua, hinanleh a nisagi niin na khawl ding uhi, bu tu hun leh bu lah hun in zong na khawl ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Nipikaal pawi a kibawl pawi, mangbu ga masa pawi leh pawltah bu khum zou pawi zong na nit ding uh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kum khat sungin thumvei na pasal naupangte zousie uh Mangpa Pasian, Israel Pasian masang ah akilah chiet ding uh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aziehpen na masangah namte kang deldoh pieh dinga, na gamgite ka hing kehlet pieh dinga; kum khat sunga thumvei Mangpa na Pasian masanga kilah dinga nang pei chiengin, koiman na gam ang deigaw pieh sih ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Kei adinga kithoina sisan tol toh na latkhawm ding ahi sih hi, tualeh Peikan pawi kithoina sa zong azing chieng tan a um ding ahi sih hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na gam a pieng ga masapente khu Mangpa na Pasian innah na hing tawi ding ahi. Kelnou sa anu nawitui a na huon ding ahi sih hi;” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Mangpa’n Mosi kungah, “Tam thute giel in; tam thute dungzui a nang leh Israelte kunga thuhun ka bawl tah ziehin,” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Mosi khum munah Mangpa kungah sun sawmli leh Jan sawmli aum a; ann zong anesih a, tui zong a dawn sih hi. Tualeh aman suongpehte gel tungah thuhun thute, thusawmpiehte a giel hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh hichi ahing hi a, Mosi khu Sinai muol a kipat theipina suongpeh nite a khut a tawi a ahing kumsuh laiin Ama toh akihouna ziehin amai vun ataang chi athei sih hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Aaron leh Israel tate zousie’n Mosi amu tahun, Ngaiin amai vun ataanga, tuachi’n akung nai ua, ahing pei ding azauta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Mosi in amaute a han a; tualeh Aaron leh mipi umkhawmte vaihawmte zousie, akungah ahing nuapei kia ua, Mosi in amauh ahoupi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tua zouin Israel tate zousie’n ahing nai ua, Sinai muol a Mangpa’n akunga agen zousie, thupieh in a kung uah apeta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Mosi in akung ua, thugen a zaw masang sien amai puon in akhu hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hinanleh Mosi in Mangpa houpi dinga amasang a alut chiengin, ahing pawtdoh kia chieng in amaikhuna aladoh zel hi. Tualeh ahing pawtdoh zela, akunga thupiehte Israel tate ahilsawn zel hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n Israel taten Mosi mel a en ua, Mosi maivun taang khu amu zel uhi. Tualeh Mosi Pasian houpi dinga alut kia masangsien Mosi in maikhuna in amai akhu hi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mosi in Israelta kikhawmpite zousie ahankhawm a, akung uah, “Tam thute Mangpa’n na bawl ding ua, ahing thupieh thute ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni guh sung nna sep ahi dinga, hinanleh ani sagi pen nou adingin nisiengthou, Mangpa dinga khawldamna khawlni ahi ding hi: Koipou khumi nia nasem khu thalia ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khawlnia na tenna innte ua mei na tawlou dinguh ahi” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Mosi in Israelta kikhawm zousiete kungah, “Tam khu ahi Mangpa’n thu ahing pieh chiin agen a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na lah ua pat, Mangpa dingin sillat hing la un, mi koi hitaleh alungtanga utna nei pouma in Mangpa adingin sillat hing tawiheh; sanate, dangkate, sum engte;
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh puondumte, asandupte, asan-aute, puonmalngatte, kelmulte,
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh belammul kibum sante, ngalvang vunte sittim singte,
  </para>
  <para style="p">
    <verse number="8" style="v" />tualeh meivah ding sathaute, kinu ding sathau, hal namtui ding gimnam tuite.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Onix suongte, siempu puonah a ze ding leh awmtuom na a zah ding suongte.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Tualeh na lah ua lungtang pilna nei poumate nang pei ding ua, Mangpa hing thupieh zousie na bawl ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Biehbuh te, a puon innte, akhunate, akilbehnate a singpehte, azawlte, akhuomte leh akingahna khuohkuohte,
  </para>
  <para style="p">
    <verse number="12" style="v" />Bawm leh azawn na zawlte, khotuona toupha akhuna puonzahte,
  </para>
  <para style="p">
    <verse number="13" style="v" />Dawkan leh azawlte, a bel leh kuongte leh tanghousie toh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meivah ading a thaumei koinate, avanzahte athaumeite, meivah ading sathaute.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh gimnamtui halna maitam leh azawlte, nuding sathaute, hal ding gimnamtuite, biehbuh lutna kot a puonzahte,
  </para>
  <para style="p">
    <verse number="16" style="v" />Halmang sillatna maitam leh sum-eng a kizut azawnna zawlte, a umlebelte, sum-eng a kizut tui kuong leh atunnate.
  </para>
  <para style="p">
    <verse number="17" style="v" />A huongsunga puonzahte, a khuomte, akingahna khuohkuohte, a huongsung kotkhah puonzahte;
  </para>
  <para style="p">
    <verse number="18" style="v" />Biehbuh kilbehnate, ahuongsung kilnate, akhaute.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mun siengthou nasepna ding, nasepna puonsilte, siemputen nna asep hun chieng ua asil dinguh siempu Aaron puonsilte leh atapate Puonsilte, chi’n agen hi.”
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Israel mipi kikhawmpi zousie Mosi kunga kipat in apeidoh siengta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh michin alungsim a kilawpna nei zousie leh lungtanga phal pouma ahing pei ua, kimutuona biehbuh a zah ding leh nasepna dinga poimaw zousie leh puonsil siengthou dingin Mangpa kung ah ahing tawi khawm uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh lungtanga utna nei pouma numei hi in pasal hitaleh ahing pei ua, taute, bilbate, khutsipte, khite, sana a kibawl ngen ahing tawi uhi, tualeh michin sana pieh ding nei zousien Mangpa kungah silpieh apie uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n michin in Puondumte, asandupte, asan-aute, kelmulte, belamtal vun sante, ngalvang vun neiten ahing tawi khawm uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Michin dangka leh sum-eng silpieh pepouma in Mangpa dinga sillat dingin ahing tawikhawm uhi, tualeh nasepna a zah theiding mawng mawng sittim sing neiten ahing tawi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh numei khutsiem pilna neiten akhut un vau a zom ua, tualeh a vau hehte uh adum, asandup leh asan-aute leh puonmalngatte ahing tawi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh khutsiemna pilna a, alungtang uh thanopna a tohthou a um numei zousie’n kelmulte a zom uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh vaihawm te’n siempu puonah leh awmphaw a siet dingin Onix suong leh suongmantamte leh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Gimnamtuite, meivah ading sathaute, nu ding sathaute leh gimnamtui dingte ahing tawi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israeltaten ut thua sillat Mangpa kungah ahing tawi ua, michin numei leh Pasal kilawpna aneisah mipoumaten Mosi khut zanga bawl dinga thu apieh zousie bawlna dingin ut thua pieh sillatte Mangpa kungah ahing tawi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n Mosi’n Israel tate kungah “En un, Mangpa’n Juda phunga Hur tapa Uri tapa Bezalel khu amin in ahanta hi;
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Aman ama khu pilnate, theisiemnate thei ‘theinate leh nasep siemna chinteng nei dingin Pasian hagau in adimsah tahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na sepding piltah a suongtuo theinate, sana, dangka leh sum-eng khen siemnate,
  </para>
  <para style="p">
    <verse number="33" style="v" />Suongmantamte siet dinga atphal dan siemnate leh sing at siemnate leh lam chintenga khut siemnate nei dingin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh ama toh Dan nam a mi Ahisamak tapa Oholiab toh ani ua mite ahil theina dingun pilna apeta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amautegel pen lamchintengah khutsiem nate, suong khuoh siemnate, khutsiemna tuom tuomte, puondum, Puonsandup leh asan-aute leh Puonmalngat gat siemnate, banglam pou a nasep siemnate, silbawl dingte piltah a ngaituo siemnate nei dingin lungtang pilna in a sudim ta hi, achi hi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n “Bezalel leh Aholiab leh mi khutsiem koipou Mangpa’n thu apieh dungzui a, mun siengthou a nasepna zousie sem thei dinga pilna leh theisiemna apieh pouma in asep dinguh ahi” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Mosi in Bezalel leh Aholiab leh mi khutsiemte koizong Mangpa’n alungtang ua pilna apieh a, tuabang nasep sem ngap dinga alungtang ua thanopna nei zousie ahan ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh amaute’n Mosi khut a kipat in, Israel taten munsiengthou nasepna vanzah ding silpieh a hing tawite zousie uh a la zel uhi, tualeh zingmawng chin in akungah ut thu a silpiehte ava tawi zel uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n mun siengthou a nasep zousie sem mipilte zousie, michin anasep na ua kipat ahing pei ua,
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi kungah “Mangpa’n bawl ding a ahing thupieh bawlna ding hunza sang a tamzaw tham mipite’n a hing tawi ta uhi” chi’n ava gen uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mosi in thu apie a, tuachi’n mun siengthou a dinga silpieh ding, “Numei leh Pasal koima’n nasep silbawl in nei nawn sih un chi’n giehphuol sung pumpi ah tang atawh sah ta uhi.” Tuachi’n mipiten sil ahing tawi uh kham ahita hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aziehpen asil neisate uh bawl dinga poimaw zousie bawlna dingin akiching mama a, atam val seng lam ahita.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh biehbuh nasep semte lah a khutsiemna pilna nei poumaten, puonmalngat kopta adum, asandup leh asan-au, Cherubim lim a asiemnel tah a kizem puonzah sawm abawl uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Puonzah khat a dunglam tong sawmni leh giet ahia, puonzah khat vailam tong li ahia, puonzah zousie let dan akibang chiet ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh aman Puonzah ngate a zom khawma; tualeh nga dangte zong azopkhawm hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh akizopna akipan in puonzah gei ah adumin abil abawla, tuachibang main akizopna nina puonzah pulam geiah zong abawl hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Puonzah khatah abil sawm nga abawl a, anina kizopna, Puonzah geiah sawmnga ma abawl hi. A bilten Puonzah khat leh khat aki kaituo sah hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh sana in mehkil sawmnga abawl, tua mehkilten puonzahte akilbeh hi, tuachi’n biehbuh khat ahing hita hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh aman biehbuh tung khuna dingin kelmul puonzahte abawl a, puonzah sawm leh khat abawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puonzah khat dunglam tong sawmthum ahia; Puonzah khat vailam tong li ahi, Puonzah sawm leh khat te letdan akibang chiet ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Puonzah ngate akikilmat chiet a, tualeh puonzah guhte zong akikilmat tua chiet ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh akizopna puonzah geikhieng pen guol mong ah abil sawm nga abawla; anina kizopna puonzah gei ah zong abil sawmnga abawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh puon inn khat ahing hitheina dinga mattuona dingin, sum-eng in mehkil sawmnga abawl hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh aman belamtal vun kibum san in puon inn khuna ding abawla, tuami tungah ngalvang vunin akhuna ding abawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Gichil sing in biehbuh singpeh ding a bawl a, tangtah in atung hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Singpeh saulam tong sawm ahia, aletdan tong khat leh akim ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Singpeh khat in kigamlat dan kibang in kimat tuona ding at geng ni anei chiet hi, biehbuh singpeh zousie tuabangin abawl suoh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh biehbuh a dingin singpeh abawla simlam pangah simlam dawin singpeh sawmni a bawl hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh tua singpeh sawmnite nuoi ah dangka in kingahna khuohkuoh sawmli abawl hi, singpeh khat nuoi ah akeng nite dingin kingahna khuohkuoh ni tualeh singpeh dang nuoi ah akeng nite a dingin ki ngahna khuohkuoh ni ma abawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh biehbuh lelam pang mallam adingin singpeh sawm ni a bawl hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dangka a kibawl akingahna khuohkuoh sawmli toh: Singpeh khat nuoi ah akingahna khuohkuoh ni singpeh dang nuoi ah akingahna khuohkuoh nima abawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh tum lamgpang biehbuh ninga dingin singpeh guh abawl hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh biehbuh pang nite adingin singpeh ni abawl hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuate khu taukuol in atunglam leh anuoilam akitumat tuo hi, tuamabangin apang ni a, aning nite adingin abawl hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh singpeh giet leh akingahna khuohkuoh te dangka a ki bawl kingahna khuokuoh sawm leh guh a um hi, singpeh khat nuoiah akingahna khuohkuoh nizel a um hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Gichil sing zawl abawla, biehbuh pang khat a singpehte dingin zawlnga,
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh biehbuh a lelam panga singpehte adingin zawl nga, tualeh biehbuh tumlam panga singpehte ding in zawl nga ma abawl a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh singzawl laitapen khu, agei langkhat a kipan langkhat tan apei suoh sah hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh singpehte khu sanatui in aluonkhum a, azawl thunna ding taukuolte sana in abawla, azawlte sanatui a luonkhum hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh Puondum, asandup leh asan-au leh puonmalngat kopta in Puonzah abawla, khutsiem tahin Cherubim lim tuongin abawl hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh khumi adingin gichil singin khuom li abawla, sanatui aluonkhum hi: abatna siakawi te khu sana abawl ahi. Tualeh tuate kingahna dingin dangka in khuohkuoh li asung hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh biehbuh kotkha adingin adum, asandup, asan au leh puonmalngat kopta in phin a khui zem kilawmtah puonzah abawl a;
  </para>
  <para style="p">
    <verse number="38" style="v" />Khuom ngate abaat na siakawite toh; tualeh akhuom mong bawte leh chiengte sanatuiin aluonkhum a, hinanleh akingahna khuohkuoh ngate khu sum-eng a bawl ahi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Bezalel in gichil singin bawm abawl a adunglam tong ni leh akim ahia availam tong khat leh akim ahi, asaulam tongkhat leh akim ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh sana siengset in asunglam leh apulam aluonkhum a, a kimvel ah sana lallukhu in a zem hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh aning li a vaw dingin sana taukuol li a sunga, taukuol ni apang lang khat ah, taukuol dang nite apang lelam a vaw dingin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh aman gichilsing in zawl abawl a, tuate khu sana tui aluon khum hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh zawlte khu bawm panga taukuolte sungah apuohna dingin athun hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh aman sana siengset in hepina toupha abawl a; adunglam tong ni leh akim ahia, availam tong khat leh akim ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh aman seh a khen cherubim ni abawl a, hepina toupha mong tuoh ah abawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cherub khat tamlang pang mongah, Cherub dang pen khumlang pang mongah; hepina toupha akipat among nite ah cherubte abawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Cherubimte gel in aha uh tunglam ah azah ua, ahate uh kimattuoin hepina toupha akhu ua; khat leh khat akimai ngattuo ua, khotuona toupha lam ah cherubimten amai angat tuoh uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh aman gichilsing in dawkan abawl a, a dunglam tong ni ahia, availam tong khat ahi, tualeh asanlam tongkhat leh akim ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuakhu sana siengset in aluon khuma, akim vel ah sana in azem hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh khutpeh chie in agei guol abawl a, sana in a kimvel in azem hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuami adingin sana taukuol abawl a, tua taukuol lite khu akenga um ning lite ah avaw hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Agei guol zungah dawkan puohna ding zawlte guonlutna ding taukuolte a um uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh bawm zawnna dingin zawlte gichil singin abawl a, sanatuiin aluon khum hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh dawkan tunga akoi ding um leh bel te, akuongte, khete, noute, asun khiehna ding hengte leh uoin thawlte, sana siengset in abawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh aman sana siengset in thaumei tunna abawl a, tuami thaumei tunna khu seh a kikhenthaw ahia, akungpi leh aba leh anoubemte, amumte, apahte khu akizop chiet a bawl ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh aba guh a pangah ahing mengdoh a; aba thumte thaumei tunna pang lang khat ah tualeh aba thumma thaumei tunna lelam pangah a um hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aba khat ah, Almond sing pahmum bang nou thum, apahmum leh apahhoi, abawl a, tualeh aba dangah zong, Almond sing pahmum bang, nou thum ma abawl a, apahmum leh apahhoi abawl hi: Tuamabangin thaumei tunna ba guhte adingin abawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh thaumei tunna ah almond singga banga bawl noubem lite, amumte leh apahte a um hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh tua ba guh kizop nite nuoiah a mum khat a um a, meivah tunna apat mengdoh guhte ah a um chiet hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amumte leh abate akizop chiet uhi, a unpi’n sana siengset sakhat a seh a khenthaw a bawl ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh aman thaumei sagi leh ataite te leh avut luohnate sana siengset in abawl hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sana siengset talent khat in thaumei tunna leh avanzahte abawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh gichil singin gimnamtui halna maitam abawl a; adunglam tong khat ahia, a availam tongkhat ahi; ning li nei ahi; tualeh asanlam tong ni ahia; a kiite toh kizop chiet ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuakhu atung leh apang kimvel leh akiite sana siengset in a luonkhum a, tualeh akimvel ah sana in azem hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh akizepna nuoiah apuohna zawlte thollutna dingin apang gel tunga aningnite kung ah sana taukuol ni abawl hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh zawlte khu gichil singin abawl a sanatui aluonkhum hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh aman kinuding sathau siengthou leh gimnamtui bawlsiemten abawl uh gimnamtui halding siengthou tah abawl hi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh aman gichilsing in halmang sillatna maitam abawl a, adunglam tong nga ahia, availam zong tong nga ma ahia, ningli nei ahi. Tualeh asanlam tong thum ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh aning lite ah akiite abawl a, tua akiite khu maitam toh kizop chiet ahi; tuakhu sum-eng in a luonkhum hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh maitam a vanzah zousiete, belte, vutluohte, tuikuongte, sathuana tawkeute leh mebelte abawl a, tambang vanzah zousiete sum-eng in abawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh aman maitam adingin sum-eng chieng maitam dawdan nuoiah akimkhat chieng dongin abawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh zawl gollutna dingin sum-eng chieng ning lite adingin taukuol li a sung hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh gichilsing in zawl abawl a, sum eng in aluonkhum hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jawlte khu maitam panga taukuolte sungah, azawnna dingin athun a: maitam khu singpeh asung hawm in abawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh ama’n sum-eng in tuikuong leh atunna a bawl a, kimutuona biehbuh kotbul a nasem numeite himlang in abawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh biehbuh huongsung simlam ngat in simlam pang ah abawl a, ahuongsung puonzahte khu puonmalngat kopta a kigan tong zakhat a sau ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuami adingin khuom sawmni leh sum-eng, khuom ngahna khuohkuoh sawmni a um hi, khuom baatna siakawite leh akaimatnate khu dangka abawl ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh mallampang a dingin zong Puonzahte tong zakhat ahia, khuomte zong sawm ni ahi, a khuom ngahna sum-eng khuoh kuoh sawmni ahi. Tualeh khuom baatna siakawite leh akaimatnate khu dangka a bawl ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh tumlam panga dinga puon khainate khu tongsawm nga ahi; akhuomte sawm akingahna khuohkuoh te sawm; abaatna siakawite leh akimatnate khu dangka abawl ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh suolam ngat in, suolam pang adingin tong sawm nga ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kotpi pang langkhat puonzah tong sawm leh nga; akhuom thum, akingahna khuohkuoh thum.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh huong kotpi pang lelam lelam adingin puonzahte tong sawm leh nga; akhuomte thum, akingahna khuohkuoh thum ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huongsung kimvel a puonzah zousie khu Puonmalngat kopta akigan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh khuomte kingahna khuohkuoh te khu sum-eng a bawl ahia; khuombaatna siakawite leh achingbaante dangka abawl ahi, tualeh akhuommong bawte khu dangkatui a luonkhum ahia, huongsung pal khuom zousie zong dangka a kaimat ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh huongsung kotpi puonzahte khu phin a khui khawm, adum, asandup, asan au leh Puonmalngat kopta akibawl ahi, asanlam tongsawm ni, apeh sanlam khu huongsung puonzahte toh kituoh in tong nga ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh akhuomte li ahia, akingahna khuohkuoh te zong li ahia, abaatna siakawite dangka abawl ahia, tualeh a mongbawte leh akaimatnate khu dangka abawl ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh biehbuh leh ahuongsung kimvel kilbehna zousie sum-eng a bawl ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tam theipina biehbuh adinga vanzah, Mosi thupieh dungzui a, siempu Aaron tapa Ithamar khut zanga Leviten asimte uh dung zuiin tamte ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Juda phunga Hur tapa, Uri tapa, Bezalel in Mangpa’n Mosi kunga bawl dinga thu apieh zousie abawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh ama toh Dan phunga Ahisamak tapa Aholiab mikhutsiem, bangkhat gelsiem, Puondumte, sandupte, san-aute leh puonmalngatte kilawm tah in azem in agan hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Munsiengthou a dinga apoimawna zousie, azah dinga sana sillat kizang zousie, talent sawmni leh kuo leh mun siengthou a shekel apieh zelte uh sim bang a sim in shekel za sagi leh sawmthum ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh mipi kikhawmpite lah a simtel zousiete, sum pieh shekel tul khat leh zasagi leh sawmsagi leh nga ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kum sawmni leh atunglam, kisimkhasate lah a pang dinga peite, tul zaguh leh tul thum leh zanga leh sawmnga te, munsiengthou a shekel sim banga sim in bekah khat chiet (shekel kimkhat ahi) pie bang ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh dangka talent zakhat, mun siengthou khuom ngahna khuohkuoh leh puonzahna khuom ngahna khuohkuohte dingin akisung hi: talent zakhat a khuom ngahna khuohkuoh zakhat, khuom ngahna khuohkuoh khat adingin talent khat ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh shekel tul khat leh zasagi leh sawmsagi leh nga tein khuomte baatna siakawite abawla, akhuommong bawte dangka tuiin aluonkhum a, azingte akimat sah hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh sillat sum-eng khu talent sawmsagi leh shekel sangni leh zali ahi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuate in aman biehbuh kotkha dinga khuom ngahna khuohkuohte leh sum-eng maitam leh sum eng chieng ding leh maitam a vanzah zousie leh;
  </para>
  <para style="p">
    <verse number="31" style="v" />Huongsung kimvel a khuomngahna khuohkuoh te leh huongsung kotpi khuom ngahna khuohkuohte leh biehbuh kilna zousie leh huongsung kimkot a kilna zousie abawl hi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh amauten adum, asandup leh asan au te zangin mun siengthou a Pasian nasepna dingin nasepna puon zem hoitahte abawl ua, Mangpa’n Mosi kunga thu apieh bangin, Aaron dingin puon siengthoute abawl uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh sanate, khau dumte, a sandupte, asan-aute leh puonmalngat kopta in siempu puonah abawl hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sana khu pa dingdengin akhengpeeh ua, vau dum, sandup, san au leh vau malngatte, mi khutsiem tahin azem nei a siem dingin a bawl uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A liengkou ah a hip in akhuikhawm ua, among tuoh tuoh ah a khuikhawm uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh siempu puonah tunga akonggah ding siemnel tah a kigan khu, puonah toh avaukhau kibang a bawl khawm ahia; sanate, vau dumte, sandupte, san-aute leh puonmalngatte kopta a gat ahi. Mangpa’n Mosi thu apieh bang in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Israel tate min dungzui in, min namna a kigiel bang in sana khau nem a siettum Onix suongte agiel uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuate khu siempu puonah liengkou ah abel a, Mangpa’n Mosi thu apieh banga, Israel tate adinga theizingna suong hi dingin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh awmphaw khu siempu puonah ma bangin khut siemtahin sanate, Puon dumte, sandupte, san-aute leh puonmal ngat kopta in abawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuakhu ning li nei ahia; awmphaw khu akithuop in abawl uhi; asanlam khapkhat ahia, availam zong khapkhat ahia, akithuop ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh suong mantam guolli in asiet ua; aguol khatna khu Sardis, Topaz leh Karbunkul ahia, aguol khatna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh aguol nina khu; Emerald, Saphire leh diamond ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh guolthumna khu: Jacinth, Agate leh Amethist ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh guol lina khu: Beril, Onix leh Jasper ahi: sana khau nema kipheh a siettum ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Israel tate minte dung zuiin, suong mantam sawm leh ni akiguol a, amin chiet utoh akigiel khawm chiet hi; suong khat chietah min namna a kigielte bang in, Israel nam dungzuiin nam sawm leh nite a dingin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh amauten awmphaw tunga dingin sana siengset khauhuol kiheh bangin khainieng abawl uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh sana vaungat kipheh nileh taukuol ni abawl ua; tua taukuol nite khu awmphaw ning a among geitegel ah akoi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh sana khainieng kipheh nite gel khu awmphaw monga taukuol nite gel sungah athun uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh khainieng kiphan nite mong khu sana khaupheh nite ah akhikhawm ua, tuakhu siempu Puonah aanglam liengkou ah abeh uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh sana taukuol ni a bawl ua, khumte gel khu awmphaw mongte gel tungah, siempu puonah sung nung gei ah akoi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh sana taukuol dang ni a bawl ua, tuate khu siempu puonah mailam a kibat guinei nuoi lampang ah, siempu puonah kawnggah siemnel tah a kigan tung lam ah avaw uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh awmphaw khu, taukuolte in siempu puonah a um, taukuolte ah khau dumin akhituo ua, khutsiem tah a kigan siempu puonah kawnggah tunglam a aum theina ding leh awmphaw khu siempu puonah a abe det theina dingin; Mangpa’n Mosi kunga thu apieh bangin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh aman siempu puonah tuol, adum ngen a kigan abawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh puonah tuol laitahah puonah ban tawng bangin a suvanga, avanna akeh louna dingin akimvel in a aihakat hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh amauten puonahtuol mongah kawlbuthei lim adum in, asandup in, asan-au tualeh puonmalngat in abawl uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh sana siengset in dah abawl ua, tuate khu puonahtuol mong kimkot in kawlbuthei te kikal ah akhai suoh uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dahneu khat leh kawlbuthei khat zel nasepna puonah tuol mong kimkot tung suohin, a um hi; Mangpa’n Mosi kunga thu apieh bangin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh amauten Aaron leh atapate adingin puonmalngat akigan puonah tung sil;
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh puonmalngat in siempu dielkhip leh puon malngat hoitah kigan in lukhu kilawm tah leh tokasiing.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh puon malngat kopta leh adum, asandup leh asan au in kawnggah kikhui thaw abawl uhi. Mangpa’n Mosi kunga thu apieh bangin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh siempu lukhu siengthou a dingin sana peh, sana siengset in abawl ua, atungah min namna-a tuong bangin “MANGPA KUNG AH SIENGTHOUNA”, chi atuong sah uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh siempu dielkop tunglam ah vau dum in akhidet uhi, Mangpa’n Mosi kunga thu apieh bangin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n kimutuona puon inn biehbuh nasep zousie khu zaw sieng ahita. Tuachi’n Mangpa’n Mosi kunga thu apieh bang zelin Israel taten abawl uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n amauten biehbuh khu Mosi kungah ahing puo ua, apuon innte, avanzah zousiete, akilbehnate, asing pehte, azawlte, akhuomte, akhuom ngahna khuohkuoh te;
  </para>
  <para style="p">
    <verse number="34" style="v" />a tung khuna belamtal vun kibumsante, akhuna saham vunte, akhuna puonzahte,
  </para>
  <para style="p">
    <verse number="35" style="v" />Theipina bawmte, azawlte, khotuona touphate;
  </para>
  <para style="p">
    <verse number="36" style="v" />Dawkante, tuana vanzah zousiete, tanghousie koinate,
  </para>
  <para style="p">
    <verse number="37" style="v" />Sana siengset a kibawl thaumei tunnate, akizom a koi ding thaumeite, avanzah zousie leh thaumei detna ding sathaute,
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh sana maitamte, siempu nu ding sathaute, gimnam tuite, biehbuh kotkha puonzahte,
  </para>
  <para style="p">
    <verse number="39" style="v" />Sum eng maitamte sum eng chiengte, azawlte avanzat zousiete, tuikuong leh atunnate,
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahuongsung puonzahte, akhuomte, akhuomngahna khuohkuohte, ahuongsung kotpi puonzahte akhaute, akilnate, kimatuonate, biehbuh sunga vanzah zousiete toh;
  </para>
  <para style="p">
    <verse number="41" style="v" />Munsiengthou a siempu nasepna nihten Puonsil kilawmtah a kigante, siempu Aaron leh atapaten siempu nasep asep chieng ua asil dinguh sil leh ten siengthoute toh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mangpa’n Mosi athupieh zousie dungzuiin Israel taten abawl ding zousie uh abawl uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh Mosi in tua nasep na zousie a en a, Ngaivawi; Mangpa’n thu apieh bang ngel in azousiengta uhi, tuachi’n Mosi in amaute a guolzawl hi.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Mosi ahoupia akungah tam bangin agen hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ha masapen nikhat ni in kimutuona puon inn biehbuh na tunding ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh asungah theipina bawm na koi dinga, tualeh bawm khu puonzah a na dantan ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh dawkan na lalut dinga, atunga sil um dingte na koitup ding ahi; thaumei tunna na lalut ding a, thau meite na devah ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh theipina bawm masangah gimnamtui halna sana maitam na koi dinga, biehbuh kotkha puonzah na khai ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh halmang sillatna maitam khu kimutuona puon inn biehbuh kotkhah bul ah na daw ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh kimutuona biehbuh leh maitam kikal ah tuikuong na koi dinga, asungah tui na koiding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh akimvel in a huongsung na bawl dinga ahuongsung kotpi puonzah na zah ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh thau nu ding khu la inlen, biehbuh leh asunga um zousie na nu ding a, na susienthou ding a, a umlebelte leh vanzah zousie toh, tuachi’n a siengthou ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh halmang sillat maitam avanzahte zousie sathau nanu dinga, maitam na susiengthou ding hi, tuachi’n maitam khu siengthou pen ahita ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh tuikuong leh atunnate sathau nuin na susiengthou ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Aaron leh atapate kimutuona biehbuh kotkha ah na pui dinga, tuiin na sil ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Aaron in puon siengthoute na sil sah ding a, sathau na nu dinga, na susiengthou ding hi. Siempu nasep na mun a ka nna asep theina dingin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh atapate nang zawpi dinga, puonah tungsil na silsah ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amaute sathau nanu dinga, apa uh na nu bangin, siempu mun a Ka nna a sep thei na ding un, asathau kinu ukhu akhang akhang ua dinga siempu ahina uh chiemtena ahitah ding ziehin achi hi.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuabangin Mosi in abawla, Mangpa’n akunga thu apieh bangin abawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n hichi ahing hia, akum nina, ha masapen ani khat niin, biehbuh tun dingin a umta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Mosi in biehbuh khu atung dingta a, akhuom kingahna khuohkuohte aphut det a, asingpehte atung a azawlte ahunga, akhuomte aphut hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh puon inn khu biehbuh tungah azah a atung ah apuonbuh khuna akoi hi. Mangpa’n Mosi kunga thu apieh bangin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh aman theipina khu ala a thuhun bawm sungah akoi hi, bawm zawlte aguonga, thuhun bawm tungah hepina toupha akoi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh thuhun bawm khu biehbuh sungah alalut a, akhuna puonzah azah a, theipina bawm akhukhum hi. Mangpa’n Mosi thu apieh bang in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh kimutuona biehbuh sunga biehbuh mallam panga puonzah pulam ah, dawkan akoi a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh dawkan tungah, Mangpa masangah, tanghoute kituptah in akoi a, Mangpa’n Mosi kunga thu apieh bangin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh thaumei tunna khu kimutuona biehbuh sung biehbuh simlam panga dawkan tunna lelam ah akoi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Mangpa masangah thaumeite ataang ta hi, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh kimutuona biehbuh masanga puonzah masangah sana maitam a koi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n atungah gimnamtui a hal hi, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh aman biehbuh kotkha ah Puonzah azah hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh kimutuona puon inn biehbuh kotkha bul ah halmang sillat maitam akoi a, atung ah halmang sillatte leh ann sillat alan hi, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh kimutuona biehbuh leh maitam kikaal ah, tuikuong akoi a, kisilna dingin kuong sungah tui alui hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Mosi leh Aaron leh atapaten tuami tui in akhut u’leh akengte uh asil uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kimutuona biehbuh alut ding chieng u’leh maitam bul a apei ding chiengun a kisil uhi, Mangpa’n Mosi thu apieh bangin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh biehbuh leh maitam kimvel ah huongsung abawl a, huongsung kotpi Puonzah akhai hi. Tuachi’n Mosi’n nasep azouta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n kimutuona biehbuh khu meilum in ahing tuom a, Mangpa thupina in biehbuh ahing luodim ta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n biehbuh tunga meilum akhawlden tahzieh leh Mangpa thupina in biehbuh aluodim ziehin, Mosi khu kimutuona biehbuh sung ah alut thei tasih hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh biehbuh tunga pat meilum akitawlmang chiengin, Israel tate akisuon zel uhi, akhuol zin sung sie un.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hinanleh meilum akitawlmang masangsie’n, mailam nawt lou in a um uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mangpa meilum sun chiengin biehbuh tungah aum a, zanchiengin meikuongin Israel tate zousie mitmu in akhuol zin sung tengun a um hi.
  </para>
</usx>
