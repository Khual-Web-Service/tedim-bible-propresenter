<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Siemchilbu</book>
  <para style="h">Siemchilbu</para>
  <para style="toc1">Siemchilbu</para>
  <para style="toc2">Siemchilbu</para>
  <para style="mt">Siemchilbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Achiil in Pasian in Lei leh Van asiem.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lei khu lim leh guong neilou ana hia; tualeh tuipi thuhtah tung khu mielin akhu khum hi. Pasian Hagau in tuipi tungte a awpkhum zing hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Pasian in “Vah hing um heh” achia, tuachiin ‘vah’ ahing umta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Pasian in vah a en a, hoi asa mama hi; tuachi’n Pasian in vah leh miel akhenta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pasian in vah khu sun achia, miel khu zan achita hi. Tuachi’n nitah leh zingmawng ahing umta a, ani khat ni ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh, Pasian in “Tui leh tui” kikal ah vanthamjawl um henlen, tuachiin tui leh tuite khen heh, achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Pasian in vanthamjawl abawl a, tualeh vanthamjawl nuoia tuite leh vanthamjawl tunga tui umte a khenta a; tuabang ahing hita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Pasian in “Vanthamjawl khu Van” achi hi. Tuachi’n nitahlam leh zingmawnglam ahing umta hi, ani ni na ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Pasian in “Vannuoi a tuite munkhat ah umkhawm henlen gamgaw hing kilang hen” achia, tuabang ahing hita hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pasian in gamgaw khu Leitung achia, tualeh tui umkhawmte khu tuipite achita hi. Pasian in tuate a en a hoi asa mama hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Pasian in “Lei tung in annte louhing chi neite, theikung, leitunga amauh chi umdan bang chiet a hing ga, aga sunga achi umte hing poudoh sah tahen” achia, tuabang ahing hita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Lei tung in loupate, annte louhing amauh chi umdan ding banga chi neite, singkung amauh um ding dan bang chiet a ga, aga sunga achi umte apoudoh sahta a, tualeh Pasian in a en a, hoi asa hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n nitahlam aum a, zingmawnglam zong aum a, ani thum ni ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Pasian in “Sun leh zan khenna dingin vanthamjawl ah tanvah ding um henlen tuate khu chiemtenate, hunbite, nite kumte theina ding hi uhen,
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh leitung tanvah dingin vanthamjawl ah um uhen” achia, tuabang ahing hita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Pasian in vah thupi ni abawl a, avah thupi zawpen khu sun a vaihawm dingin tualeh avah neu zawpen khu zan a vaihawm dingin abawl a; aasite zong abawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Pasian in tuate khu leitung tanvah dingin vanthamzawl ah akoi a,
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh sunlai tung leh zan tunga vaihawm ding leh vah leh miel khen dingin akoi a, tualeh Pasian in tuate a en a hoi asa hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n nitah leh zingmawng ahing um a, ani li ni ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Pasian in “Tuite’n silsiem kipiathei hinna neite tampi hing pawtkhesah uhenlen vate zong tunglam vanthamjawl ah leeng uhen” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Pasian in Tuipi a silsiem hinna nei lienpipite asiem a, ganhing kipiathei chinteng tui in ahing pawtsah zousie ama uh chi umdan ding bang chietin asiem a, tualeh va hanei chinteng zong amauh chi umdan ding bang chietin asiem a, tualeh Pasian in tuate a en a, hoi asa hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Pasian in “Ama u’khu chi tampi suongin hing pung unlen, tuipite tui in dimsah unlen, vate zong leitung ah pung uhen” chi’n aguolzawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n nitahlam aum a, zingmawnglam zong aum a, tuakhu ani nga ni ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Pasian in “Leitung in silhing amauh chi umdan ding bang chietin; gantate, ganhing bohvate, gamsate amauh chi umdan ding bang chietin umsah uhen” achia; tuachi ahing hita uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Pasian in leitung a gamsate amauh chi umdan bang chietin, gantate amauh chi umdan bang chietin, tualeh leitunga ganhing bohvahte zousie amauh chi umdan bang chietin abawl a; tuachiin Pasian in a en a, hoi asa hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Pasian in, “I kibahpi eima meel bangbang in mihing siemvai in amauh khu tui a ngate, tungleeng vate, gantate, leitung pumpi a ganhing, leitung a bohvah zousie tungah thu nei sah vai” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Pasian in ama kibahpi in mihing asiem a, tualeh ama limlemel puo in pasal leh numei asiem hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n pasien in amauh guol azawl a, Pasian ma in akung uah, “Chi tamtah suongin hing pung unlen, leitung luodim unlen, na thu thu un umsah un; tuipi a ngate tungah, tunga leeng vate tungah leh leitunga vah ganhing chinteng tungah thu nei un” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Pasian in “Ngaivawi, leitunga um annte louhing chi nei zousie leh sing chi nei ga umna sing chinteng na kung uah kahing peta hi, tuate khu nou a dingin na ann ding uh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh leitung a gamsa zousie, tung a leeng va zousie leh leitung a bohvah hinna nei zousie kung ah a hinna ding un annte-louhing ka pie hi” achia; tuachiin tuabang ahing hi ta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Pasian in a silsiem zousie a en a, Ngaivawi hoi asa mama hi. Tuachi’n nitahlam leh zingmawnglam aum a, ani guh ni ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n lei leh van leh asung a umte zousie toh siem zousieng ahita hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Pasian in ani sagi niin azouta a, tuachi’n ani sagi niin anasep zousie apat akhawlta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Pasian in ani sagi ni khu aguolzawl a, asiensuota hi, aziehpen tua niin Pasian in asep abawl zousie apat akhawlta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lei leh van siem dan khu tambang ahi, Mangpa Pasian in lei leh van asiem ni in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n lei a loupa mawngmawng leitungah aum nai sih a, tualeh leitungah haichi mawngmawng apou nai sih hi. Aziehpen Mangpa Pasian in leitungah guo azu sah nai sih a, tualeh lou hou ding mihing koima aum nai sih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh leitung apat tuimei ahing kaitou a, leitung pumpi anom sah hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Mangpa Pasian in, lei a leivui in mi asiem a, anahkosung ah hinna hu aha khum a, tuachiin mi khu hinna nei mihing ahing suohta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Mangpa Pasian in suolam ah Eden huon khat asiem a, khunah a mihing siem khu aumsah ta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh leitung apat in Mangpa Pasian in singkung etla huoitah leh nehthei chinteng apousah a; hinna sing leh sie leh pha theina sing zong huon laikimtah ah apousah hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Eden apat in lui khat huon tapnou ding in aluong khie a, khunakipat in a kikhenzah a kaa li asuoh ta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aka khatna min Pishon ahia, khumkhu Sana tamna Havilah gam kuolkhum a luong ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh tua gam sana khu ahoi a, Bdelium leh Onix suongte zong aum hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh lui nina min Gihon ahia, Kush gam kuol khuma luong khu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lui thumna min khu Hiddekel ahia, Assiria gam suolam ah aluong hi. Tualeh lui lina khu Euphrates ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Mangpa Pasian in Mihing khu azawpi a, Eden huon kem ding leh veng ding in akoita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Mangpa Pasian in mihing kungah “Huon a sing chinteng ga zousie na ut ut in na ne thei ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinanleh sie leh pha theina singga khu na neh ding ahi vawtsih hi, na neh leh na neh ni mama in na shi ngeingei ding hi”, chi’n thu apie hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Mangpa Pasian in “Pasal amatang a aum ahoi sih, ama panpi ding, akithuopi dia kilawm bawlpieh vawng e”, achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Mangpa Pasian in lei akipat in gamsa chinteng leh tungleeng vate chinteng asiem a, tualeh amin ding uh bang ahisah mawng eimah chi athei na ding in Adam kung ah ahing zawpi a, tualeh ganhing zousiete khu Adam in amin uh ana phuo pieh bang zelin amin uh ahi denta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Adam in Ganta zousie tungleeng vate leh gamsate amin avaw chiet a, hinanleh Adam ading in apanpi ding leh akithuopi ding aum sih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Mangpa Pasian in Adam a imut asuah sah a, tuachiin nuomtah in a imu sah a, tualeh anahgute khat aladoh a, khummun khu asa ma in asuhdim pieh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Mangpa Pasian in Adam nahgu alaahdoh khu numei in asiem a, amanu Adam kungah ahing zawpi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Adam in, “Tam khu tuin ka gute gu leh ka tasate tahsa ahia, Pasal akipat kiladoh ahiman in Numei a kichi ding hi”, achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaziehin, pasal in anu leh apa anuasie ding a, azi lam ah abeh ding hi, tuachiin sakhat ahi ta ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Adam leh azi khu ani un guohtang in aum ua, hinanleh azum sih uhi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n gul pen Mangpa Pasian siem gamsa teng teng lah a agitlou pilpen ahi. Tuachi’n aman numei kung ah, ahileh, “Pasian in huon a singga pouma nesih un achi amah?” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh numei in gul kung ah, “Huon a singgate kane thei uhi’’.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hinanleh, “Huon laikim a singga khu Pasian in ne sih un, thamzong na tham khah ding uh ahi sih, tuachilou invang shi khava uteh a chi hi,” achi a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh gul in numei kungah “Shi lai zang lou e, achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aziehpen tua na neh ni uapat, na mit uh hing vah van in, sie leh pha thei in Pasian bang in na hing um ding uh chi Pasian in a thei khin-khian hi” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n numei in singga khu nehthei ahi chileh, mit hiptah ahi chileh mi pilsah dinga singga etla huoi ahi chi athei in aga khat alou a, aneta hi, tualeh apasal kungah zong apie a aman zong aneta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n ani un amit uh ahing vahta a, guohtang ahi uh ahing kithei kheta uhi. Tuachi’n theipina akhuikhawm ua puonsil in aneita uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh amaun nitah lam ninem a Mangpa Pasian huona vah kawi husa aza ua, tuachiin Adam leh azi in Mangpa Pasian khu huon a singte lah ah ana kibutsanta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Mangpa Pasian in “Adam ahan a, akung ah hei a um na hiei?” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n ama’n, “Huon ah na aw ka za a, guohtanga um ka hi ziehin ka zau a kibu ka hi” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh aman, “Guohtang nahi chi koiin ahing hil ahiei? Neh louding kachi singga ne hitachie izaw?” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuamin Adam in “Ka umpi dinga nahing pieh numei in singga ahing pie a, ka neta hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Mangpa Pasian in numei kungah, “Bang sil atai na bawl?” achia. Numei in, “Gul in ahing sol a ka neta hi,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Mangpa Pasian in Gul kungah, “Tambang sil nabawl tah ziehin gantate leh gamsa zousie lah a hamse thuah pen na hi dinga, tualeh na awm in kithol vachin, na damsung in leivui na ne ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh nang leh numei kahing kidou sah dinga, nahah-nasuonte leh ahahasuonte ka kidou sah nalai dinga, aman nalu hing tawguoi van in, tualeh nang ama ketul na tuhsidup pieh ding hi”.
  </para>
  <para style="p">
    <verse number="16" style="v" />Numei kungah Aman, “na gimna leh na nau neina hatangpi in supung vangin, gimtah in ta nahing dinga, na lunggul na pasal thu hivan in, aman na tungah thu anei ngitnget ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Adam kung ah, “na zi thu nasan a neh louding kachi singga na neh zieh in leitung nang ziehin samsiet ahita, na hinsung gimtah a sem in aga nane ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ling leh khaute lou ling neite nang ading in ahing pou dinga, tuachiin lei a annte louhing na ne ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lei a na kia kia masang sie’n na mai a khosa luong pumin ann na ne ding hi. Lei a lahkhiet na hi ziehin, leivui nahi a, leivui ma ah na kia kia ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Adam in azi min Evi aphua hi. Mi zousie nu ahi ziehin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Adam leh azi dingin Mangpa Pasian in Savun puontuol abawl pieh a, asil sah hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Mangpa Pasian in, “Ngai un, mihing khu eima bang a sie leh pha thei ahing hita a. Tuin hinna singkung akhut a louin ne va un, tangtawn in hing kha va uh” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuaziehin Mangpa Pasian in, ama khu a lahdohna leitang hou dingin, Eden huon akipat a notdoh ta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n mihing khu anotdoh ta a, Eden huon suolam ah hinna singkung lampi veng dingin Cherubimte leh meikuong namsau kihei kawikawi thei akoi ta hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Adam in azi Evi apawl a, agai a, Kain anei a, tuachiin “Mangpa apat in mikhat ka muta,” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh, amanu’n anaupa Abel anei kia a, Abel khu Belam ching mi ahia, hinanleh Kain pen lou hou mi ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh, tuazouin hichi ahing hia, Kain in Mangpa kung a lat ding in lou a haichi gate ahing tawi a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Abel in zong aganhon lah a pieng masa pente leh athau pente ahing tawi a, tualeh Mangpa’n Abel leh asil lat akipahpi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hinanleh Kain leh asil lat akipahpi sih hi. Tuachi’n Kain alungthah seng seng a, amai amuol vawt hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mangpa’n Kain kungah, “Bang dinga lungthah na hiei? tualeh bang dinga maimuol na hiei?
  </para>
  <para style="p">
    <verse number="7" style="v" />Sil bawlhoi lachin hing kipompieh louding amah? Na bawl hoi sihleh khelna na kotlam ah akuol zing hi tualeh alunggul khu nang lam ahi dinga, atungah thu na nei ding hi”.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Kain in a anaupa Abel ahoupi a, tualeh hichi ahing hita a, lou a aum lai un Kain in anaupa akihaupi a athat ta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Mangpa’n Kain kungah, “Na naupa Abel hei a um ahiai?” achi a; “Aman thei votsing, ka naupa chingpa kahi amah?” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Aman, “Bang bawl a kinei natai le? Na naupa sisan aw lei akipat ka kung ah ahing kikou hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na khut akipat na naupa sisan na sang dinga, kam nakah leia kipat hamsiet na hita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leitang nahaw chieng in zong ahoina ahing pephal nawn sih dinga, leitung ah vahvai leh taimang na hita ding hi”.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khumin, Kain in Mangpa kungah “Na hing gawtna ka thuoh zouding sang in anazaw hi”.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngaivawi, “tunin leitung apat na hing notdohta a, na mitmu apat phuol ka hita ding hi. Tualeh leitung ah vahvai ka hita dinga, tualeh tambang ahi ding hi, ahing mutapou in ahing that ding uhi,” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Mangpa’n akung ah “tuachi ahileh koipou Kain that khu ale sagi in atung ah phuba lah ahi ding achia, tualeh koi in zong ama amu a atha louna ding in Mangpa’n Kain achiemte ta hi”.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Kain khu Mangpa umna akipat apawtdoh a, Eden suolam a Nod gam ah ateng ta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Kain in azi apawl a, agai a, Enok anei hi. Tualeh khopi asiem a amin ding in atapa min puoin Enok ahisah hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Enok in tapa Irad anei a, Irad in Mehujael ahing a, Mehujael in Methushael ahing a, Methushael in Lamek ahing hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Lamek in zi ni anei a, khat min Adah ahia, adang pen min Zillah ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Adah in Jabal anei a, ama khu puon inn a tengte leh ganta khawi mite suongpa ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh anaupa min Jubal ahia, ama khu kaiging leh theile tum mite zousie hingpa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Zillah in zong Tubal-Kain, sum-eng leh sia, hiemhei khengsiem mi anei a, Tubal-Kain naunu min Naamah ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Lamek in azite “Adah leh Zillah kung ah ka aw ngai unlen, nou Lamek zite, ka thugen ngaikhie un, ahing suhliem ziehin mi khat ka that a, ahing suhnat ziehin tangval khat ka that hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kain phuba ale sagi a akilah ding leh Lamek phuba ale sawm sagi leh sagi a lah ahi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Adam in azi apawl kia a, tapa khat anei a, amin Seth ahisah hi. Aziehpen aman “Kain in athasa Abel thaheng ding Pasian in chihah dang ahing guotpieh ahita,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Seth in tapa khat anei a, amin Enosh ahisah hi. Tuahun a kipan in miten Pasian min law ahing pan uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tam Adam suonte kigelna laibu ahi. Pasian in mihing asiem niin Pasian bang in ana siem hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pasal leh numei in amauh asiem a aguolzawl a, amin Adam aphua hi, siem a aum niin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Adam kum za leh sawmthum ahi in ama tawh kibang ama sunvawt tapa khat anei a, amin Seth ahisah hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Seth ahin nua in Adam kum zagiet adam nalai a, tanu tapate anei nalai hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Adam dam sung zousie kum zakuo leh sawmthum ahia, tuachiin ashi ta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Seth kum za leh nga ahi in, Enosh ahing hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Seth in Enosh ahin nua in, kum zagiet leh sagi adam a, tanu tapate ahing nalai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Seth dam sung kum zakuo leh sawm leh ni ahia, tuachiin ashi ta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Enosh kum Sawmkuo ahi in, Kenan ahing hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Enosh in Kenan ahin nua in, kum zagiet leh sawm leh nga adam a, tanu tapate ahing nalai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Enosh dam sung khu kum zakuo leh nga ahia, tuachiin ashita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Kenan kum sawmsagi ahi in, Mahalalel ahing hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Kenan in Mahalalel ahin nua in, kum zagiet leh sawmli adam a, tanu tapate ahing nalai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Kenan dam sung khu kum zakuo leh sawm khat ahia, tuachiin ashita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Mahalalel kum sawmguh leh nga ahi in, Jared ahing hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mahalalel in Jared ahin nua in, kum zagiet leh sawmthum adam a, tanu tapate ahing nalai hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Mahalalel damsung khu kum zagiet sawmkuo leh nga ahia, tuachiin ashita hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Jared kum za leh sawmguh leh ni ahi in, Enok ahing hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Jared in Enok ahin nua in, kum zagiet adam a, tanu tapate ahing nalai hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Jared adam sung kum zakuo sawm guh leh ni ahia, tuachiin ashi ta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Enok kum sawmguh leh nga ahi in, Mathuselah ahing hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Enok in Mathuselah ahin nua in, kum zathum sung Pasian toh azawhkhawm a, tanu tapate ahing hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n Enok dam sung kum zathum sawmguh leh nga ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Enok Pasian toh azawhkhawm a, aum tasih hi. Pasian in alahmang tah ziehin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Mathuselah kum za leh sawmgiet leh sagi ahi in, Lamek ahing hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Mathuselah in Lamek ahin nua in, kum zasagi sawmgiet leh ni adam a, tanu leh tapate ahing hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Mathuselah adam kum zakuo sawmguh leh kuo ahia, tuachiin ashita hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Lamek kum za leh sawmgiet leh ni ahi in, tapa khat ahing a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh amin Noah aphua hi. “Ama mama in Mangpa hamsiet khum leitung zieh a, i khut nasep leh i gimnate ah hing hamuon va,” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Lamek in Noah ahin nua in, kum zanga sawmkuo leh nga adam a, tanu tapate ahing nalai hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Lamek dam sung kum zousie kum zasagi leh sawmsagi leh sagi ahia, tuachiin ashita hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Noah kum zanga a upa ahi in, Shem, Ham leh Japheth ahing hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh hichi ahing hi a, leitung ah mihingte ahing pung deudeu ua, tanute ahing neita uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pasian tapaten mihing tanu melhoite amu ua, adeite uh zi dingin akitenpi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Mangpa’n, “Ka Hagau in mihingte kumtawn in atenpi ngitnget sih ding, ama zong tahsa ahia, hinanleh adam sung ding uh kum za leh sawmni ahi ding,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua hunlai in leitung ah mi lienpipite ana um ua, tuami nuain zong Pasian tapaten mihing tanute apawl ua, tate aneipi ua, tuate khu nidanglai a mihat minthangte ahi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Pasian in leitung a mihingte gitlouna nasatah ahi chileh a lunggel uh gitlouna ngen ahi chi, amu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n leitunga mihing ana siem ziehin Mangpa akisia a alunggimpi ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n, Mangpa’n, “Ka misiemte leitung apat sumang mai vang, mihingte, gantate, gamsate, a awm a kitholte leh tungleeng vate ka na siem ka kisia seng hi,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hinanleh Noah in Mangpa mitmu in hepina anga hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tamte khu Noah hahlesuonte ahi. Noah khu ama khang laiin midih leh hoibukim ahia, Pasian toh azawhkhawm hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Noah in tapa thum Shem, Ham leh Japheth ahing hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pasian mitmu in leitung zong asegawp siengta a, tualeh leitung hiemngamna in adimta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Pasian in leitung a en a, “Ngaivawi, asegawp ta; tahsa zousie inlah leitung a aum dan uh asuse gawpta uh, achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Pasian in Noah kung ah tahsa zousie beina ka kungah ahing tungta, aziehpen amauh ziehin leitung hiemngamna in adimta; ngaivawi, amauh a leitang pumin ka sumang khawm ding,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Nangma ding in Tasing in kuong bawl in, kuong sung ah pindan na bawl ding a, asung leh apolamah singnai in nazut ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh nabawl dingdan tambang ahi. Kuong a dunglam tong zathum, a vailam tong sawmnga, tualeh asan lam tong sawmthum ahi ding.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuong ah kotta khat nabawl ding a, atung lam tong khat chienga na zaw ding ahi. Tualeh kuong kot khu apang ah nabawl ding a asawng nuoinung, sawng nina, tualeh sawng thum nei in nabawl ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh ngaivawi, keima ngel in vannuoi a tahsa hinna hunei zousie sumang ding in Tuichim ka tungsah ding a, tuachiin leitunga um zousie ashi sieng ding.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hinanleh nang toh ka thuhun sukip vang in, tualeh nang leh na tapate, na zi, na tapate zite, nangma toh kuong sung ah nalut ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh tahsa hinna nei zousie lah apat ni chiet ahing a khawi ding in kuong sung ah nahing puilut ding a, tuate atal leh anu ahi ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vate amauh chi umdan bang chiet in, gantate amauh chi umdan bang chiet in, ganhing awm a kitholte amauh chi umdan bang chiet in, chi chin a ni chiet ahing a khawi ding in na kung ah ahing pei ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh na ann neh ding zousie la inlen, na kung ah koikhawm in, tuachiin tuakhu nangma leh amaute neh ding ann ahi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuabang in Noah in abawl a, Pasian in akung a thu apieh zousie bang in abawl hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa’n Noah kung ah, “nang leh na innkuonpite kuong sung ah hing lut un, aziehpen nang khu tulai khangthate lah ah midihtat in kahing mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sa sieng chinteng lah ah atal leh anu, kop sagi, tualeh sa sienglou lah ah atal leh anu, kop khat zel na la ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tungleeng vate lah ah zong atal leh anu, kop sagi chiet, leitung pumpi a chiha ding, hingsah ding in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aziehpen ni sagi zou chieng in, leitung ah sun sawmli leh zan sawmli guo ka zusah ding a, tualeh ka siemsa ganhing zousie leitung apat sumang ding ka hi,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Noah in Mangpa’n akung a agen bang bang in abawl ta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh leitung a Tuichim atun lai in, Noah Kum zaguh a upa ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n, Noah khu Tuichim tunding ziehin, kuong sung ah atapate, azi leh atapate zite toh alutta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sa sieng leh asienglou lah ah zong vate leh leitung a bohvah ganhing teng lah ah zong.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pasian in Noah kunga thu apieh bangin atal leh anu nini zel in kuongsung ah Noah kung ah alut uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh nisagi nuain hichibang ahing hia, leitung ah tuichim ahing tungta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noah kum zaguh ahi kum, aha nina, ni sawm leh sagi niin, tuami ni mama in, tuithuh lienpipi nahte ahing kehzah a, van kottate ahing kihong ta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n leitung ah sun sawmli leh zan sawmli guo azu ta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuami ni ma main, Noah tapate Shem, Ham leh Japheth toh Noah zi leh atate zi thumte toh kuong ah alutta uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh amautoh sa zousie amauh chi umdan bang chiet in, ganhing leitung a bohvah zousie amauh chi umdan bang chiet in tualeh va ha nei chinteng zong.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amaukhu, hinna nahna-hu a nah thei zousie akopkop in Noah kung ah kuongsung ah alutta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n alutte khu Pasian thupieh bang in sa tengteng lah apat anu leh atal zel in alut ua, tuachiin Mangpa’n Kot akhah khumta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh leitung ah Tuichim sun sawmli leh zan sawmli atung a. Tuite ahing khang a, kuong khu leitung apat alaamtou ta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Tui ahing lien a, leitung ah akhang deudeu a, tuachiin Kuong khu tuitung ah akilaam ta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh leitung ah tui akhang deudeu a, vannuoi a muol sang zousie atum siengta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tong sawm leh nga thuh in tui avei a, muol sang zousie atum mang siengta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh leitunga um hinna nei a gamta, vate, gantate, gamsate, leitunga bohvah ganhing chinteng leh mihing zousie ashita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anahkuo ua hinna hagau nahna nei zousie, gamgaw a um zousie ashi beita uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n leitunga sil hing um zousie, mihingte, gantate, ganhing bohvahte tungleeng vate nangawn toh suhmangthai in aumta. Noah leh akung a kuong sunga umteng giap khawi in aumta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh tui khu ni za leh sawmnga sung leitungah avei denta hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Pasian in Noah leh kuong sunga ganhing zousie leh ganta zousie athei zinga, Pasian in leitungah hui alaangsah a, tuachi’n tui ahing kiem panta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuithuhpi nahte leh van kottate zong kha ahita a, van a guo zong theusah ahita hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh leitunga tui khu awlnou noua leitung apat kilekia in, Ni za leh sawmnga nuain ahing kiemta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n kuong khu aha sagina ni sawm leh sagi ni in Ararat muol ah akingata hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh aha sawmna dongin tui khu akiemsuh zel a, aha sawmna ni khat ni in muol vumte ahing kilangta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh ni sawmli nuain, Noah in kuong kotta abawl khu ahong a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n va-ah khat aha doh a, lei a tui kan sieng masang sien aleeng kawikawi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh leitung apat tui akiemtai mah chi theina dingin Vakhu khat aha kia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh Vakhu in tuh nading mawngmawng amulou ziehin akung ah kuongah ahing kile kiata a, leitung pumpi a tui aum nalai ziehin. Tuachi’n akhut apulam ah aha khie a, a kungah kuong sungah alalutta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh ni sagi dang angah kia nalai a, tua Vakhu khu kuong apat ahadoh kia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Vakhu khu nitahlam in ahing tunga, tualeh ngai vawi, anephu ah Olive singna kilou tha khat ahing taw hi. Tuachi’n Noah in leitungah tui akiemta chi atheita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n nisagi ma angahkia nalai a, tualeh Vakhu ahadoh kia a, tuachi’n akung ah ahing kile tasih hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh hichi ahing hi a, Kum zaguh leh khatna aha khatna ani khat ni in Tuite leitung apat akangta a, tualeh Noah in kuong khuna aladoh a, a en a, leitung ahulta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh aha nina ani sagi niin leitung ahul siengta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Pasian in Noah kungah thu agen a,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Kuong akipat pawtdoh inlen, nang leh na zi leh na tapate leh na tapate zite zong na kung ah pawt uheh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sa zousie lah a, vate lah a, gantate lah a, lei a awma kitholte lah a, na kunga um silhing tengteng hing pawtpiin, lei a hahlesuon tampi nei a, tualeh lei tunga ga tampi suonga, ahing pun theina ding un,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Noah, atapate toh azi toh, atapate zite toh apawtta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gamsa chinteng, abohvah ganhing zousie, va chinteng leh leitunga aboh a vah zousie amauh chi bang chiet in kuong akipat apawtta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Noah in Mangpa kungah, maitam abawl a, sa sieng zousie lah leh va sieng zousie lah ah ala a, maitam ah haltum sillatte alan hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Mangpa’n tua gimnamtui aza-a, tuachi’n Mangpa’n alungsim in “mihing ziehin leitung hamsiet lawnawn vawt sihvang, mihing lungtang ngaituonate khu aneu lai a kipat gilou mawng ahi thuoi a, tua kabawl bangin silhing chinteng zong ka sumangthang nawn vawt sihding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Leitung umlaisie haichi tu hun leh haichi lah hun khovot leh kholum hun, nipi leh phalbi, sun leh zan abeisih ding” achi hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Pasian in Noah leh atapate guol azawl a, akung uah, “hah leh suon tampi nei in hing pung unlen, leitung luodim un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nouma giinna leh zauna leitunga gamsate zousie, vanlaizawl a vate zousie, leitung a piathei zousie, tualeh tuipi a Ngate zousie tungah um vanin, amaute na khut ua piehkhiet ahita uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Silhing piathei zousie na ann ding uh ahiding a, annte louhing kahing pieh bangin sil zousie a unin kahing pie hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh sa ahinna asisan toh na nehkhawm ding uh ahisih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh pellouin na hinna uh sisan phuba ka la ding a, gamsate chinteng lah akipat ka la ding a, michin a unaupa tungah mihing hinna phuba kala ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Koipou mihing sisan suote mihing ma in ama sisan asuo ding hi. Pasian in Ama mel banga mihing asiem ahi ziehin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh noute ga tampi suongin hing chipha unlen, hing pungta un. Leitung ah hahlesuon tampi hing nei unlen, atung ah hing pungta un,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Pasian in Noah leh akunga um atate kungah,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ngai un, Kei mama in nouma leh na nua ua nahah nasuonte uh kungah zong ka thuhun ka sukip ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na kung ua na umpi uh silhing zousie, vate, gantate, kuong apat pawtdoh, lei a gamsa chinteng kung nangawn ah zong.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tambang in na kung uah, ka thuhun ka sukip ding, ganhing zousie zong tuichim a suhmang in aumnawn sih ding a, leitung suse dingin tuichim zong atung nawn sih ding”.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Pasian in “tami keima leh nouma leh na kung ua um silhing zousiete kikaal a hahlesuon tawp neilou a umzelte dinga thuhun chiemtena ahi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Meilum lah ah ka sakhituihup kazamsah a, tuakhu kei leh leitung kikaal a thuhun chiemtena ahi ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh hichi ahi ding a, leitunga meilum ka kaisah chieng in meilum lah ah Sakhituihup akimu ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh kei leh noute leh sate leh silhing zousie kikaal a ka thuhun um theizing vangin, tuachi’n Sa zousie sumang ding in tuisang alet nawnsih ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n sakhituihup pen meilum lah ah zamjel van in, tualeh Pasian leh leitunga um sate leh ganhing zousie toh kikaal a tangtawn thuhun theizing nading in tuami enzing vang” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Pasian in Noah kungah, “Tami kei leh leitunga um sa zousie kikaal a ka thuhun chiemtena ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Noah tapate, kuong apat a pawtdohte Shem, Ham leh Japheth ahi ua, tualeh Ham pen Kanaan pa ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tamte Noah tapa thumte ahi ua, ama ua kipat in leitung pumpi luodim in ahing umta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Noah lou houmi in ahing panga, grep huon abawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Uoin a dawn a, a kham ta a; tuachi’n a biehbuh sungah a lum khiel ta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Kanaan pa Ham in apa guoh tanga lum amu a, inn pulang aum a unau tegel ahil hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuami’n Shem leh Japheth in puonkhat ala ua, a liengkou uah ajawng ua, nuatawnin apa uh guohtang alum akhu ua, tuachi’n amai uh nualam ngasa’n apei ua, apa uh guohtanna amusih uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Noah a uain kham ahing hal a, atapa neupen in atung a abawl dan athei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n aman, Kanaan hamsiet in um henlen, a unaute silate sila ahi ding achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh aman, Mangpa Shem Pasian guolzawl in um heh, Kanaan asila in um heh achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pasian in Japheth khu sulien henlen, puon inn ah teng hen, tualeh Kanaan pen a sila hihen achi nalai hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Noah tuichim tunnua in Kum zathum leh sawmnga a dam a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Noah damsung Kum zakuo leh sawmnga ahia, tuachi’n ashita hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuate Noah tapate, Shem, Ham leh Japheth hahlesuonte ahi ua, tuichim tun nua in tapate anei chiet uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Japheth tapate: Gomer, Magog, Madai, Javan, Meshek tualeh Tiras toh ahi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Gomer tapate, Ashkenaz, Riphath leh Togarmah ahi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Javan tapate Elishah, Tarshish, Kittim tualeh Dodanim ahi ua.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tamte akipat in Jentelte tuipi panga gamte, amau gamah akikhenzah ua, amauh ham bang zel leh amauh phung bang zel in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Ham tapate: Kush, Mizraim, Phut tualeh Kanaan ahi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Kush tapate: Seba, Havilah, Sabtah, Raamah; tualeh Sapteka tualeh Raamah tapate Sheba leh Dedan ahi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Kush in Nimrod ahing a, ama leitungah mihattah ahing hipanta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama khu, Mangpa mai a sabengmi hattah ahia, tua ziehin ahi, “Mangpa mai a sabengmi hattah, Nimrod bang, ahi” ana chi leng uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh ama leenggam kipatna khu Shinar gam a Babel, Erek, Akkad leh Kalneh khuote ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua gam akipat in apawtkhie a, Assiria gam alut a, Nineveh, Rehoboth leh Kalah khuote.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Nineveh leh Kalah kikal a um Resen khuote asat a, tuami khopi lientah ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Mizraim in Ludim, Anemin, Lehabim, Naphtuhim leh,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathrusim, Kashulu (tamte akipat in Philistinte ahing pieng hi) leh Kaphtorim ahing hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Kanaan in atachil Sidon anei a, tualeh Heth zong anei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jebusmite, Amormite, Girgashmite,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hivmite, Arkmite, Sinmite,
  </para>
  <para style="p">
    <verse number="18" style="v" />Arvadmite, Zemarmite leh Hamathmite ahing a, anua in Kanaan namte ahing kithezah uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Kanaan mite gamgi ahileh Sidon akipat Gerar lam zuon in Gaza dong, tualeh Sodom Gomorrah, Adma leh Zeboim lam zuonin Lasha dong ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tamte khu anam uh bang zel leh aham dungzui u’leh agam leh anam umdan dungzui un Ham hahlesuonte ahi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Eber tate zousie suongpa Japheth upa Shem in zong tate anei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem tapate khu Elam, Asshur, Arpaksad, Lud leh Aram ahi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Aram tate; Uz, Hul, Gether leh Mash ahi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Arpaksad in Shelah ahing a, Shelah in Eber ahing hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Eber in tapa ni ahing a, khatpa min Peleg ahia, ama damlai in leitung khen in aum a, a sanggampa min Joktan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Joktan in Almodad, Sheleph, Hazarmaveth, Jerah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Haroram, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="28" style="v" />Obal, Abimael, Sheba.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ophir, Havilah leh Jobad ahing hi. Tamte zousie Joktan tapate ahi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh atenna mun ukhu, Mesha apat Sephar taang suolam ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tamte aphung u’leh aham uh dungzui leh agamte u’leh anamte uh dungzuiin Shem tapate ahi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tamte khu anam khanggui leh aphung gui uh dungzuiin, Noah tapate hahlesuonte ahi ua, tualeh tamte akipat in tuichim tun nua in leitungah, namte ahing kikhenzah ta uhi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh leitung pumpi ham khat kamsuo khat ana hia.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh tambang ahing hi a, suolam apat apei lai un, Shinar gamah phaijang khat amu ua, tuanah atengta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n “Kisa un, tehlei kheng vai in, tualeh hoitah in halgaw vai” akichita uhi. Tuachi’n suong taangin tehlei, tualeh akimattuona dingin tar azang uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh hing pei un, “Khopi khat bawlvai in, innsang avum van suding khat i lamding ua, i min uh thangsah vai, tua ahisihleh leitung pumpi ah kithezah sieng khavai” achi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mangpa mihing taten abawl uh khopi leh innsang ending in ahing peisuh a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Mangpa’n “envawi un, mite pumkhat hi ua, abawn un ham khat maimai anei uhi. Tualeh tam sil abawl panta ua, tuin asil bawl tup uh khamguol ahita sih ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hing pei un, ikuon dinga khatlekhat ham akitheituo louna dingun aham uh ivasulamdang ding uh” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Mangpa’n amauh khum mun apat leitung pumpi ah athezah siengta a, tuachi’n a khopi bawl uh atawpsanta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuaziehin amin khu Babel akichita hi. Mangpa’n khunah leitung pumpi ham a subuoita hi. Tualeh Mangpa’n amauh leitung pumpiah athezah siengta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tamte Shem hahlesuonte ahi uh, Tuichim tunzou in Shem kum za a upa ahia, tuichim tunzou kum ni nua in, Arpaksad ahing hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Shem in Arpaksad ahin nua in, kum za nga adam a, tapa leh tanute anei nalai hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Arpaksad kum sawmthum leh kum nga ahi in, Shelah ahing a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shelah ahin nua in, Arpaksad kum zali leh kum thum adam a, tapa leh tanute ahing nalai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Shelah kum sawmthum ahi in, Eber ahing hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Eber ahin nua in, Shelah kum za li leh kum thum adam a, tapa leh tanute ahing nalai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Eber kum sawmthum leh kum li ahi in, Peleg ahing hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Peleg ahin nua in, Eber kum za li leh kum sawmthum adam a, tapa leh tanute ahing nalai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Peleg kum sawmthum ahi in, Reu ahing a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Reu ahin nua in, Peleg kum za ni leh kum kuo adam a, tapa leh tanute ahing nalai hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Reu kum sawmthum leh ni ahi in, Serug ahing hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Serug ahin nua in, Reu kum zani leh kum sagi adam a, tapa leh tanute ahing nalai hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Serug kum sawmthum ahi in, Nahor ahing a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nahor ahin nua in, Serug kum zani adam a, tapa leh tanute ahing nalai hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Nahor kum sawmthum leh kum kuo ahi in, Tera ahing hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tera ahin nua in, Nahor kum za leh kum sawm leh kuo adam a, tapa leh tanute ahing nalai hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Tera kum sawmsagi ahi in, Abram leh Nahor leh Haran ahing hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tamte Tera hahlesuonte ahi uhi. Tera in Abram, Nahor leh Haran ahing a, Haran in Lot ahing hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Haran pen apienna gam Kaldaite khuo Ur ah apa Tera shi masangin ashita hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Abram leh Nahor in zi anei tuoh ua, Abram zi min Sarai ahia, Nahor zi min Haran, Milkah leh Iskah pa ahi. Haran tanu Milkah ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hinanleh Sarai pen achiing a, ta anei sih hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Tera in atapa Abram leh atupa Haran tapa Lot leh amounu, atapa Abram zi Sarai apui a, tuachi’n Kanaan gam a peiding in Kaldaite khuo Ur apat ahing pawtdoh ta ua, tualeh Haran khuo ahing tung ua, tuanah atengta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Tera damsung kum za ni leh kum nga ahia, Tera Haran khuo ah ashita hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n Abram kungah, “Na gam leh na tanaute leh napa innsung akipat pawt inlen, gam ka hing etsah ding langah pei in achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Nam thupitah in hing siem vangin, guol hing zawl vangin, na min suthupi vang, tualeh nang guolzawlna na hi ding.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh nang hing guolzawlte guolzawl vangin, nang hing hamsiette hamsiet vangin, tualeh nangma apat leitunga nam zousie guolzawl in umva uh,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Abram khu Mangpa’n akung a agen bangin akipankheta a, Lot in zong azui hi. Tualeh Haran a kipat apawtkhiet laiin Abram khu kum sawmsagi leh kum nga ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n, Abram in azi Sarah, anaupa tapa Lot leh anei alam zousie u’leh Haran khuo a ami neite zousie apui a, Kanaan gam a peiding in akipan kheta ua, tuachi’n Kanaan gam ahing tungta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Abram khum gamah Shekem mun tanin Moreh gangpising pouna dongin ahing peisuh a, tua hun lai in Kanaan mite tua gamah aum uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Mangpa Abram kungah akilah a, “Nahah na suonte kungah tam gam ka pe ding hi” achia, tuachi’n khummun ah, aman akunga kilah Mangpa dingin maitam a bawlta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh tua mun akipat in Bethel suolam muol khat ah akisuon a, khummun ah apuoninn ajahta a, tumlam ah Bethel aum a, suolam ah Ai khuo aum hi. Tuamun ah Mangpa dingin maitam abawl a, Mangpa min ahan hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Abram simlam zuon in akisuon nalai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh tua gam ah kiel atung a, khum gam a kiel akhawh seng ziehin, Abram Izipt gam a va um tadi dingin apei suhta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh hichi ahing ahia, Izipt a lutdia akisah lai in, azi Sarai kungah, “ngaivawi, numei melhoitah na hi chi ka thei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuaziehin hichi ahing hiding hi; Izipt miten ahing mu chiengun, tam minu azi ahi ang chi ding ua, kei ahing that ding ua, nangpen ahing hinkhawi ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang vanga hoitah a ka um theina ding leh najal a ka hin theina dingin, a sanggamnu ka hibou hi, hepitahin, hing chiin” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n hichi ahing ahi a, Abram Izipt gam ahing tunin Izipt miten numeinu khu amu ua, hoi asa mama uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharaoh milienten zong amanu amu un Pharaoh kungah ahoidan agen ua, tuachi’n numeinu khu Pharoah inn ah apuilut ta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh aman, amanu ziehin Abram khu alim bawl a, tuachi’n Belamte, Bawngtalte, Sabiltungtalte suohpa leh suohnute, Sabiltungnute leh Sangawngsaute aneilawta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinanleh Mangpa’n Abram zi Sarai ziehin Pharoah leh a innkuonpite tungah gawtna atungsah ta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Pharoah in Abram ahan a, ka tunga na silbawl bangchithu hita ahei? Amanu na zi ahi bang dinga hing hillou na hiei? achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bang dinga ka sanggamnu hibou nachi ahiei? Zi a na nei khamawh thei ka hi; tuaziehin tuin na zi tanah aum hi, zawpi inlen peimang tan achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Pharoah in atung thu ah amite thu apie a, tuachi’n ama khu azi toh anei alam zousie toh asawlkheta hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Abram khu Izipt gam a kipat in apeita a; ama leh azi leh anei alam zousie leh Lot toh simlam gam azuonta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Abram in gante, dangkate leh sana ahau mama hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh simlam apat in Bethel dongin apei zel a, Bethel leh Ai khuo kikal a, masang a apuonbuh jahna mun ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amasa a maitam bawlna mun ma ah Abram in Mangpa min ahan hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Lot Abram toh zawhkhawm pa’n zong belamte, bawng honte leh puon innte anei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n a umkhawmna ding un gam akiching tasih a, aneitah uh atam seng tah ziehin a umkhawm thei tasih uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Abram ganchingte leh Lot ganchingte kikaal ah kinielna ahing umta a, tuahun lai in khum gamah Kanaan mite leh Periz mite ateng uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Abram in Lot kungah “Hepitah in kei leh nang kikaal leh ka ganchingte leh na ganchingte kikaal ah kinielna um sih heh, unau ihi bou hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gam pumpi na masanga um hilou ahiei mah? hepitahin keima apat in umtuom mai in, nang veilang a na pei leh kei zietlang ah, ahisihleh nang zietlanga napei leh kei veilang ah ka pei ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Lot ahing khodah a, Jordan phaijang tengteng Zoar khodonga, amun tenga tuiluonna, Mangpa’n Sodom leh Gomorrah asuhsiet masanga Mangpa huon bang, Izipt gam bangmai ahi chi amu a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Lot in Jordan phaijang lam atel ta a, tualeh Lot suolam zuon in apei zel a, tuachi’n akikhenta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram Kanaan gam ah ateng a, Lot pen phaijang khopite ah ateng a, a puoninn Sodom khuodong in asuon zel hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh Sodom mite pen Mangpa mitmu in nahpitah a gilou leh khiel ahi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh akung a kipata Lot atuom um nua in, Mangpa’n Abram kung ah, “Tu’n dahdoh inlen na umna mun apat mallam, simlam, suolam leh tumlam en vawi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na gam mu zousie nang leh nahah nasuonte kungah tangtawn ading in kahing peding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nahah nasuonte lei a leivui bang maiin bawl vangin, tuachi’n min lei a leivui asim zou leh nahah nasuonte zong akisim zou ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thou inlen, gam khu adung avai tuonsuoh in, aziehpen na kung a hing pe ding ka hi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Abram in a puoninn asuon a, ahing pei a, Hebron a um Mamre gangpising lah ah atengta hi. Tualeh khunah Mangpa dingin maitam abawl hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Shinar leengpa Amraphel leh Ellashar leengpa Ariok leh Elam leengpa Kedorlaomer leh namte leengpa Tidal damlai in hichi ahing hia.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amauten Sodom leengpa Bera leh Gomorrah leengpa Birsha leh Admah leengpa Shinar leh Zeboiim leengpa Shemeber leh Bela leengpa khu ahing douta ua. (Bela khu Zoar ahi.)
  </para>
  <para style="p">
    <verse number="3" style="v" />Tamte zousie Siddim phaihawm ah apangkhawm ua. (Siddim khu chituipi ahi.)
  </para>
  <para style="p">
    <verse number="4" style="v" />Kum sawm leh ni Kedorlaomer nuoi ah nna asem ua, a kum sawm leh thumna ah ahing helta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh kum sawm leh lina ah, Kedorlaomer leh a kunga um leengte hing kuon in, Ashteroth Karnaim khuo ah Rephaim mite athat ua, Ham khuo ah Zuzimte athat ua, Shaveh Kiriathaim khuo ah Emimte athat uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh a umna uh Seir muol, gamdai zul a um, El-paran dongin Hormite athat uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n anuakia kia ua, Enmishpat ahing tung ua, tuami Kadesh ahi. Tualeh Amelek mite gam leh Hazezon-tamar khuo a teng Amorte nasan athat uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Sodom leengpa leh Gomorrah leengpa, Admah leengpa, Zeboiim leengpa leh Bela leengpa (khum khu Zoar ahi) a pawtkhie ua, Siddim phaihawm ah amauh dou dingin apangkhawmta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Elam leengpa Kedorlaomer toh, namte leengpa Tidal toh Shinar leengpa Amraphel toh Ellasar leengpa Ariok toh leeng lite khu leeng ngate toh akidou uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Siddim phaihawm khu longnai khuh ngenin adim a, Sodom leh Gomorrah leengte ataizah ua, kimkhatte leihawm sungah a kelut ua, akelou teng muol ah ataizah ta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n amaun, Sodom leh Gomorrahte neitah leh nehletah dingteng a unin ala ua, apeita uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh amaun, Sodom khuo a teng Abram sanggampa tapa Lot leh aneitah zousie ala ua apeita uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n gal a suohta mi khat ahing pei a, Hebru mi Abram ahing hil a, Ama khu Eshkol leh Aner sanggampa, Amor mi Mamre phaijang a gangpising lah a teng ahia, tamte Abram toh pangkhawm ahi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Abram in a sanggampa sal a mat in aum chi azahtah in, ama innsunga pieng achilsiemsa, asuohte zathum leh sawmkhat leh giet galvan in athuom a, Dan khodong in adelta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh zanlaiin amauh dou dingin ama leh asuohte akihawmkhen ua, asat gawp ua, Damaska khuo mallam a um Hobah dong anuadel uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n neitah zousie ahing nua puoh kia ua, a sanggampa Lot zong aneitah teng toh, tualeh numeite leh mipi zousie zong ahing puikia siengta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Kedorlaomer leh akung a leeng umte that zou a ahing kile kia nuain, Sodom leengpa khu Shaveh phaihawm ah (tuakhu leengpa phaihawm ahita) Abram dawn dingin ahing pei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Salem leengpa Melkizedek in tanghou leh zu ahing tawi a, Ama pen Pasian tungnung pen Siempu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Aman Abram aguolzawl a, “lei leh van neipa; Pasian tungnungpen Abram khu guolzawl in um hen”.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh na galte na khuta hing pepa Pasian tungnungpen phat in um heh, achi hi. Tualeh Abram in anei zousie sawm a khat apie hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Sodom leengpan Abram kungah, mihingte hing pien len, neitahte vang nangman kitan in achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hinanleh Abram in Sodom leengpa kung ah, “Lei leh van neipa, Mangpa Pasian tungnungpen lamah ka khut ka jahta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vau zamkhat zong, kengtodap khau nasan zong, na neisa mawngmawng bangma lavawtsih vang, tuachilouin Abram keima hausatsah ahi na chikha ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tangvalten aneh beiteng u’leh, ka mi zawpite tanvou chilou bangma kala sih ding Aner, Eshkol leh Mamreten amauh tanvou uh kilah uheh” achi hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tam silte nuain “Abram zausin, Kei na phaw leh na kipahman thupitah ka hi, chiin Mangpa thu Abram kungah mangmu bangin ahing tung hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Abram in, Mangpa Pasian aw, bang e nahing pieh ding? ta neilou a umden dinglah ka hia, ka gou kem ding Damaska a Eliezer ata amah?” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Abram mama in, “En vawi, hahlesuon mawngmawng na hing neisah sih a, en in, ka inn a pieng pen ka gouluo ding himai ven maw,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh ngaivawi, Mangpa thu akung ah ahing tunga, “Tampa pen na gouluo ding ahisih dinga, na tahsa a kipat a hing pieng doh ngel khu na gouluopa ahi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh ama inn pulam ah azawpi a, “Vanlam entou inlen, aasite sim vawi, nasim zou eimah” achi hi. Tualeh Ama mama in a kungah, nahah nasuonte tuabang ahi ding hi, achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh aman Mangpa khu atahsang a, tuami Aman ama dingin dihtatna in asim pieh ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Aman akung ah, “Keima, tam gam luodinga hing peding a Kaldaite khuo, Ur akipat hing puidoh pa Mangpa ka hi,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh aman, “Mangpa Pasian aw, ka luo ding chi bangchi’n ka thei diei?” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Aman akung ah, “Kum thum a upa Bawngla khat, kum thum a upa Keelpi khat leh kum thum a upa Belamtal khat, tualeh vakhu nou khat leh Paalva nou khat hing la in” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh ama’n tamteng ahing tawi a, alaikim tah ah aphalhah chiet a, tualeh phal khat leh phal khat kimaingattuo in akoi a, hinanleh vate aphalhah sih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh va sasiel nete saluong tunga ahing tuh chiengin, Abram in aheu zel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh nitum ding kuonin Abram nuomtah in a imuta a, tualeh ngaivawi, zauhuoina leh a miel a miel in ama ahing khu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Pasian in Abram kungah, “Nahah nasuonte amauh gam hilou ah mikhuol in aum ding ua, ana uh aseppieh ding ua, tualeh amauh kum zali sung asugenthei ding uhi chi kichientah in thei in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh khum ana aseppieh nam zong keiman thu ka khenkhum dinga, tuazou chiengin nei leh lam tampi toh hing pawtdoh ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh nangpen napu leh pate kungah hamuongtah in napei dinga, tehkun in ahing kivui ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinanleh akhang lina ah tammun ah ahing peikia ding uh, Amor mite tatsietna akim nai tadi lou ziehin,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh hichi ahing hi a, ni ahing tum a, khuo ahing mieltah in, ngaivawi, hal tuina meikhu zinzen leh meisel kuong pimpem, khu tua sa kiphalhahte kikal a pei kawi kawi ahing um hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khum ni mama in Mangpa’n Abram toh thuhun abawl a, “Na hah nasuonte kungah tam gam Izipt lui akipat Euphrates lui lien dong ka peta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kenmite, Kenizmite, Kadmonmite.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Hitmite, Perizmite, Rephaimmite.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Amormite, Kanaanmite, Girgashmite tualeh Jebusmite zong ka hing peta hi,” achi hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Abram zi Sarai in ta mawngmawng aneipieh tasih a, tualeh ama nu’n Izipt mi khat suohnu in anei a, amin Hagar ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Sarai in Abram kungah “Ngavawi, Mangpa’n lah ka ta hinding hing phalpieh talou a, hepitahin ka suohnu vave inlen, ama apat tate ka nei khah leh,” achi hi. Tuachi’n Abram in Sarai thugen asangta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Abram zi Sarai in a suohnu Izipt mi Hagar khu Abram Kanaan gam a kum sawm aten nua in ahing puia, apasal Abram kungah azi dingin apeta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh aman Hagar apawl a, ahing gaita hi. Agaita chi akithei bep in apinu asimmawta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Sarai in Abram kungah, “Kabawl khielna maw na tungah tu heh, ka suohnu na kawi dingin kahing pie a, agai chi akithei tahin, simmaw in ka umta hi. Mangpa’n nang leh kei kal thu khenta heh,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Abram in Sarai kungah, “Ngaivawi, na suohnu pen na khut a um ahi, atung ah na dei bang bangin bawl in,” achi hi, Tualeh Sarai in abawl genthei mama a, tuaziehin ataimang ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Mangpa vansawlsieng in amanu khu gamdai a tuikhuh kungah, Shur zotna lampi tuikhuh kungah amu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Aman, “Hagar, Sarai suohnu aw, hei a kipan a hing pei na hiei? Tualeh heisung zuon ding na hiei?” achi hi. “Amanu’n, kapi Sarai kunga pat a hing taikhie ka hi” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Mangpa Vansawlsieng in akung ah, “Napi kungah peikia inlen, athu thu in um in,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Mangpa Vansawlsieng in a kungah, “Nahah nasuonte sim senglou khop a tamin ka supung ding,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Mangpa Vansawlsieng in a kungah, “Ngaivawi, naupai na hi, tualeh tapa na nei dinga, amin Ishmael na hisah ding hi, Mangpa’n na gentheina azahtah zieh in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama khu mihinglah ah gamsabiltung bang ahi dinga, miteng dou vanin, mi zousien ama dou va uh, tualeh a unaute umna kung nai ah ateng ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Hagar in ama houpi Mangpa min dingin, “Nang ang muthei Pasian nahi; chiin aphuo-a aziehpen tanah Pasian ahing mupa mu a hing nalai, hing e, maw? achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuaziehin Tuikhuh min khu Beer-Lahairoi aki chita hi, Ngaivawi, tami Kadesh leh Bered kikaal a um ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Hagar in Abram tapa khat ahinpieh a, tualeh Hagar in ahin pieh atapa min Abram in Ishmael aphuota hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Abram khu Hagar in Abram dinga Ishmael ahinnpieh lai in kum sawmgiet leh guh ahi hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Abram kum Sawmkuo leh kuo ahi in Mangpa a kungah ahing kilah a, a kungah, “Kei Pasian Bangkimbawlthei.” Ka hi, ka masang ah pei inlen tualeh hoi bukim in um in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Kei leh nang kikaal ah ka thuhun hung vangin, tualeh hatangpi’n kahing pungsah ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Abram khu abohkhup a, tualeh Pasian in a houpi a, akung ah,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ngaivawi, Keima’n ka thuhun na kungah kahung hi; Tualeh nangpen nam tampite Pa nahi ding, achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na min zong Abram ahinawn sihding a, hinanleh na min Abraham ahizaw tading hi, aziehpen nam tampite Pa in ka hing bawlta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh hahlesuon tampi suongin hing chi phasah vangin, nang apat nam lientah siem vangin, tualeh nang a kipan in Lengte hing pieng va uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Kei leh nang leh na nua a nahah nasuonte, suon sawn sawnte dongin zong ka thuhun pen nang ading leh na nua-a nahah nasuonte dinga a Pasian uh hiding in tangtawn thuhun dingin ka sukip ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh nang leh na nua a nahah nasuonte kungah mikhuol na hina gam, Kanaan gam zousie tangtawn gou dingin hing pevang in, tualeh keima a Pasian uh ka hi ding,” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Pasian in Abraham kungah, “Tuaziehin nang pen in ka thuhun na zui ding ahi, tualeh nang leh na nua a, nahah nasuonten akhang akhang ua azuiding uh ahi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tampen kei leh nang leh na nua a nahah nasuonte kikaal a na zui ding uh ka thuhun ahi, nalah ua Pasal naupang pouma atep na tan ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n natep vun uh tanva uchin, tuakhu kei leh nang kikaal a thuhun chiemtena ahi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh nalah ua ni giet a upa pasal naupang pouma na hah nasuon sawn sawn dongin zong, na inn a pieng hiin, ahilouleh sum a kilei mikhuol hitaleh nahah nasuon pasal pouma nangma hahlesuon hilou zong tep tan ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na inn a pieng leh sum a nalei zong tep tan tei tei ding ahi, tuachi’n ka thuhun khu tangtawn thuhun dingin nasa tung uah aumta ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh pasal tep tanlou, atep vun uh tan a umlou pouma, tua mi khu amite lah apat suhmang ahi ding, aman ka thuhun apalsie ahi”.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Pasian in Abraham kungah, “Na zi Sarai khu amin Sarai nachi nawnsih dinga, hinanleh amin Sarah a hizawta ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n ama ka guolzawl dinga, ahi, ama namte nu ahidinga tualeh ama apat tapa ahing pieng dinga, ama apat mite leengte ahing um ding uh achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Abraham khu akhupboh a, anui a, a lungsim in, mi kum za a upa in ta anei ding adiei? Tualeh Sarah, kum sawmkuo a upa in Ta ahing ding adiei?” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Abraham in Pasian kungah, “Ishmael na masang ah umthei leh aw”, achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Pasian in Abraham kungah, Hilou e, na zi Sarah in tapa hing hinpieh tahtah ding a, amin dingin Isak na hisah ding hi; tualeh ka thuhun khu ama leh ahahasuonte toh tangtawn thuhun dingin ka sukip ding.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Ishmael tung thu zong ka hing ngaikhiet piehta hi. Ngaivawi ama ka guolzawlta hi, ka chi phasah ding a, nahpitah in zong ka supung ding hi. Leng sawm leh ni ahing dinga, ama nam thupitah in ka siem ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh ka thuhun pen kumkia tuhun chienga, Sarah in ahing hinpieh ding Isak kungah ahi, ka suhkip ding, achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n akung a thugen atawpsan a, Pasian in Abraham apeitou santa hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n Abraham in Pasian in a kunga agen bangin, atapa Ishmael leh a innsunga pieng zousie, sum a alei zousie leh Abraham innkuonte lah a pasal pouma apui a, tuani mama in atep vun uh atan piehta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Abraham in atep atan laiin kum sawmkuo leh kuo a upa ahita hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh atapa Ishmael in atep vun ana tanlai in kum sawm leh kum thum ahita hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuami ni ngel ngel in Abraham leh atapa Ishmael teptan ahita uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh a innkuonpite lah a pasal zousie toh a inn a piengte toh mi khuolte lah a sum a aleite zong ama toh teptan ahisiengta uhi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Mangpa khu a kungah Mamre gangpi sing lah ah ahing kilah a, ama khu sun nisat laitah in puonbuh Kotkhah bul ah atou a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachia dahtoua a et leh ngaivawi, mi thum a kungah a dinga, amu tahin a dawn dingin puonbuh kotbul apat atai a, lei ah abohkhup a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh aman “ka Mangpa aw, na mitmu a deisahna katan leh hepitahin na suohpa hing peisan sin achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tui tawmnou khatbeh hing la uhenlen, na kengte uh sil unlen, singnuoi ah khawldam tadi un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Tanghou neunou khat beeh la vangin na lungtang uh halsah un; tuazou chiengin pei zel nava uteh. Tua dinga na suoh kunga hing pei na hi ngei ding uhi, achi hi. Tualeh amaun na gen bangin, vabawl in” achi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Abraham khu Sarah kungah puonbuh sungah gangtahin alut pai a, “Tangbuong tena thum te inlen, kintahin meh inlen, Tanghou bawl in,” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Abraham Bawnghon lam ah atai a, Bawngnou tuoi hoitah khat ahing la a, asuohpa apie a, tualeh aman manlangin abawl meng meng hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n aman bawngnawi dat leh bawngnawi leh bawngnousa a bawlte ala a, amasang uah aluipieh a, ama pen akung ua singnuoi ah a dinga, amaun aneta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh amaun a kungah, “Na zi Sarah heia um ahiei?” achi ua, tualeh aman, “khunah puonbuh sungah” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Aman, “Tuhun kia chiengin pellouin na kungah hing pei kia ding ka hi, tualeh ngaivawi, na zi Sarah in tapa anei ding hi” achi hi. Sarah in anualam a puonbuh kot ah anaza hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Abraham leh Sarah a upata ua, ateh mama ta ua, numei ngaina khu Sarah tungah akang zouta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuaziehin Sarah in, ka teh nuain kipahna ka nei na diei izaw? Ka mangpa zong lah ateh tangal a chiin alungsim in aguh nui hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Mangpa’n Abraham kungah “Bang dinga Sarah in kei piteh pi’n ta ka nei tahtah na diei izaw chia nui ahiei?
  </para>
  <para style="p">
    <verse number="14" style="v" />Mangpa dingin sil hasataluo aum amah? hun sesa tuhun kia chiengin hing peikia vangin, Sarah in tapa anei ding hi, achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hinanleh Sarah in, azau manin, zuoupi hi nui vawt sing achia, tualeh ama’n hilou e, na nui zen vele” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n mite khummun apat in adingkhie ua, Sodom lam a en ua, tualeh Abraham zong amauh hading in lampi ah amaute azui hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Mangpa’n “Ka silbawl tup Abraham kungah ka imding amah?
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham nam thupi leh hattah hing hi ngei ding ahia, tualeh ama ah leitunga nam zousie guolzawl a um ding ahi thuoi a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aziehpen aman anua a, atate leh a innkuonpite thu apeding a, Mangpa’n Abraham tungtanga a thugen a tangtun theina ding in, dihtah leh khentuom neilou a, vaihawm dingin Mangpa lampi zuiva uh chi ka thei hi,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Mangpa’n “Sodom leh Gomorrah kikou akhawh seng ziehin leh a khelna uh akhawh seng seng ziehin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuin ka peisuh dinga, akikou gin uh ka kunga hing tung bang bangin abawl na uoi mah? Chi ka enkhe dinga, abawl sih u’leh ka vathei mai na ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n tua mite khumna kipat in akihei khie ua, Sodom lam azuon ua, hinanleh Abraham pen Mangpa masang ah ading ngitnget nalai hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Abraham in ahing nai a, a kungah “mi dihtatte zong migiloute toh sumang khawm ding na diei?
  </para>
  <para style="p">
    <verse number="24" style="v" />Khopi sungah midihtat sawmnga bang um taleh a sunga midihtat sawmngate ziehin khawi louin na sumang diei?
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang talawm in vang khumbang in midihtatte migilou banga aum mawh nading ua, midihtatte migiloute laha thalup sam ding vang nang talawm in bawl va-ia sih vateh maw? Leitung zousie a vaihawmpa’n dihtattah in abawl sih ding amah?” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Mangpa’n “Sodom khopi sunga midihtat sawmnga ka mu leh amauh ziehin khopumpi ka khawi ding,” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Abraham in a dawnga, “ngaivawi tuin kei leivui leh vutvai leltah in Mangpa kahing houpi thei a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Midihtat nga a, sawmnga chinglou, bang hitaleh nga achinlou ziehin khopi pumpi na sumang ding adiei?” achi hi. Tualeh “Sawmli leh nga ka mu leh sumang sihvang,” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh aman agen zom zel a, “Khunah sawmli bang muin umta leh” achia. Aman, “Sawmli ziehin ka sumang sih ding” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh aman “Aw Mangpa, lungthah sinlen, hing genkia nalai vang, khunah sawmthum bang muin umta leh,” achi hi. Aman “sawmthum ka mu leh sumang sihvang” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Aman, “Ngaivawi, keiman Mangpa ka hing houpi theita a, Sawmni bang muin umta leh,” achi hi. Aman “sawmni ziehin ka sumang sih ding” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Aman, “Aw Mangpa lungthah sinlen, khatvei hing genkia nalai vang. Khunah sawm bang muin umta leh” achi hi. Aman “Sawm zieh in zong sumang sihvang” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n Mangpa Abraham toh akihou zawin apeita hi. Abraham zong aumna mun ah akile kiata hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh vansawlsieng ni, nitah lamin Sodom khuo ah ahing peisuh ua, Lot pen Sodom Kul kotkhah ah anatou a, Lot in amauh amutahin, a lamtuo dingin ading khie a, tualeh tuol a bawhkhup in chibai abuh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh aman, “Ngaivawi un, ka mangpate aw, hepitahin nasuoh uh inn ah hing lut tadi unlen, gieh un; tualeh na kengte uh zong sil unlen, tuachi’n zingmawng matah in na thou ding ua, na pei na ding uhi” achi hi. Hinanleh Amaun, “Hilou e, kholai ah gieh nava ung,” achi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hinanleh aman azawl paupau a, tuachi’n a kungah apei ua, a inn ah alutta uhi. Tuachi’n aman me ahuon pieh a, tolsawlou tanghou a kanga, tuachi’n aneta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh alup masang un, khopi mite, Sodom mite ngel in ateh akhang, veng chin a mi zousien a inn ahing im kimkotta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Lot ahan ua, a kungah, “Tuzan a na inn a hing tungte heisungah aumta uoi? Ka luppi theina dingun ka kung uah hing puidohin” achi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Lot kotkhah zungah akung uah ava pawtdoh a, kot anua kha a;
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh “unaute hichi talawm in gilou sih ve un,”
  </para>
  <para style="p">
    <verse number="8" style="v" />“Ngaivawi un, pasal toh kithuo nailou tanu ni ka nei a, amauh hing puidoh vangin na law law uh lawta un; tammite pen bangma law vawtsih un, aziehpen tami zieh a ka inn a hinglut uh na sasih uh amah,” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh amaun kinuakhin in achi ua, “Tuachi’n amaun”, “Tampa lihleh tanah a hing tenglut a, thukhen vaihawm a um atum phuat a, tunvang amauh sangin nangma tungah ka bawlse zaw ding uh” achi ua, kotkhah suhsiet atumta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hinanleh tua miten akhut uh azandoh ua, Lot innsungah akailut ua, kot akhahta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh kotkhah bul a mite alien aneu amit uh atosahta ua, tuachiin kotkhah mutheilou in akimaimaw ta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n tua miten Lot kungah “Tamte chilou tanah mi dang aum nai mah? Na mahpa; na tanu, na tapa leh tam khopi a na neiteng tammun apat puidoh in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aziehpen akikou thawm uh Mangpa masang a akhawh seng ziehin, tami khuo suse ding ka hi uh. Tualeh Mangpa’n asumang ding a kou ahing sawl ka hi uh,” achi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Lot apawtdoh a, atanute kitenpi amahpate kungah ava hil a, “Kisa unlen tam mun akipat in pawtkhie un, Mangpa’n tami khopi asuhmang ding ahi,” achi hi. Hinanleh a thugente amahpate ngaiin chiemnui bawl abang giap hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh a zingmawng phalvah in, Vansawlsiengten Lot kungah, “Kisa inlen, tana um na zi leh natanu tegel puiin, ahisihleh tam khopi gawtna ah ka mang khava uteh” chi’n anawta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh ama awl awl in akisa nalai a, Mangpa mi hepisiem ahiziehin tua miten ama leh azi leh atanute akhut un aman ua, apuikhie ua, khopi pulamah akoita uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n hichi ahing ahia, amaute pulama apuidoh zaw un, aman, “Na hinna uh bitna ding in taikhie un, na nualam mawngmawng uh ensih unlen, phaijang mawngmawng ah zong khawlsih un. Tua muol ah tai un, tua chilouin katum khava uteh,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hinanleh Lot in akung uah, “Ka Mangpate aw, tuachi vang hida heh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngaivawi, tuin na suohin na deisahna ka muta a, tualeh na khotuona na liensah a, na khotuona in ka hinna humbitin ka tungah na sulangta hi. Hinanleh tua muol ah vang taisuoh zousih vang, sil hoilou in hing lap phadinga ka shi kha ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Ngaivawi, tam khopi khu taina dingin nainou khat ahia, tualeh khopi neunou zong ahi. Hepitahin khunah hing taisah zaw maiin (Khopi neunou ahisih amah?) tuachi’n ka hing ding hi” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh aman akungah, “Ngaivawi tam sil tungtang ah zong na thu ka pom a, tua na khopi gen zong ka sumang sih ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Manlangin khunah tai mengin, khuna na tun masangsie bangma bawl theilou ding ka hi” achia, tuaziehin tua khopi min Zoar a chi ta uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lot Zoar a alutin tua gamah ni ahing suohta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Mangpa’n Sodom leh Gomorrah tungah van a Mangpa kunga kipat in Mei leh Kat azusahta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n tua khopite leh phaijang zousie leh khopite a mi zousie leh leitunga sil pou pouma a unin asumang siengta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hinanleh azi in Lot nualam akipat in anualam a en a, tuachiin chikhuom asuoh ta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Abraham zingmawng matahin athou a, Mangpa masang a adinna munah ahawtou hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Sodom leh Gomorrah lam leh Phaijang gam zousie a ensuh a, tualeh ngaivawi, tua gam meikhu khu hal tuina meikhu bangin azamtou hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh hichi ahing hi a, Pasian in phaijang khopite asuhmang laiin Pasian in Abraham athei ngitnget a, tualeh Lot tenna asuhmang laiin, Lot khu manthaina lah a kipat in asawlkhie hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Lot Zoar nuasie in apeitou a, taangah ateng a, atanu nitegel zong akungah ateng uhi. Zoar a aten ngamlou ziehun, atanu nitegel toh leihawm sungah ateng uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh a u nu’n anaunu kungah, “I pa lah atehta a, leitung pumpi tawndan dungzui in, eitegel hing luppi ding leitungah pasal khat zong aum nawnsih hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hing peiin ipa zu dawn khamsah vaiin, asuon man louna dingin luppi vai” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n khum zanin, apa uh uain adawn khamsahta ua, tualeh a unu alut a apa toh alumkhawm ta hi. Tualeh aman alup lam leh athawkia lam athei sih hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh azingni’n tambang ahing hia, a unuin anaunu kungah “Ngaivawi, zani zanin ka pa toh ka lumkhawm a, tuzan in zong uain dawn khamsah vaiin, tualeh nang lut inlen va luppi in, ipa’n hahlesuon anei theina ding in,” achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh khumi zan in zong apa uh uain adawn khamsah ua, tualeh anaunu athou a, akung ah ava lum a, aman alup lam leh athaw lam athei sih hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tambangin Lot tanute gelin apa u’lah apat nau ahing paita uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh a unu in tapa khat anei a, amin Moab ahisah hi. Amapen tudongin Moab mite suongpa ahi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh anau nu in zong tapa khat anei a, amin Ben-Ammi ahisah hi. Amapen tudonga Ammon hahlesuonte suongpa ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Abraham khuna pat in simlam Zuonin akisuon a, Kadesh leh Shur kikal ah ateng a, tualeh Gerar munah aum tadi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Abraham in azi Sarah khu ka sanggamnu ahi achia, tuachi’n Gerar Lengpa Abimelek in mi a sawl a, Sarah ava puisahta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hinanleh Pasian khu zanlaiin Abimelek mangin a kungah ahing pei a akungah, “Ngaivawi na numei lah nu mi zi ahiziehin mishi giap na hita hi, aziehpen ama mi zi ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh Abimelek in akithuopi naisih a, tualeh aman, “Mangpa nam dihtatte nasan zong suliading na hiei mah?”
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman ka kungah “Ka sanggamnu ahi achisih amah? Tualeh amanu ngel in zong ka sanggampa ahi achi ngal a, lungsim siengthou tah puo leh khut siengthou tah nei kawm in tamsil kana bawlta hi,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Pasian in a mangin akungah, “Ahi, lungtang dihtah puoin tam sil na bawl hi chi ka thei a, tuachi’n ken zong ka tunga na khelding kana kham ahi, tuaziehin ahi, amanu na khoi ding ka phallou.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuaziehin tuin tua mipa zi pekia in, aziehpen ama guolnei ahia, Aman thu ahing nget pieh dinga, tuachi’n na dam ta ding hi. Na piehkia sihleh vang, na shi ngei ngei ding ahi chi theimai in, nangma leh na nei zousie toh” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaziehin Abimelek zingmawng matahin athou a, a suohte zousie ahan a, tam thute ahil a, a mite azau mama uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Abimelek in Abraham ahan a, a kungah “ka tung ua na silbawl bang chidan ahiei le? achia, na tungah bang ka bawlkhiel a, kei leh ka leenggam tunga sil hoilou lienpi hing tut na hiei? Na bawl vawt lou ding sil ka tungah na bawl hi” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Abimelek in Abraham kungah “Bang ngaituona nei a, tam sil na bawl ahiei?” chiin adong kia a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Abraham in, “Ken tam khuo ah Pasian giinna um vawtsih vanin, ka zi ziehin hing that mai khava uteh chia ka ngaituo zieh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hinanleh ka sanggamnu zong ahi mawng a, ka pa tanu ahia, hinanleh kanu tanu vang ahisih a, tuachi’n ka zi ahing hita hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh hichi ahing hi a, Pasian in ka pa innsung akipat a ahing vahvaisah laiin, keiman amanu kungah, ka tunga na suhlat ding na hepina tami ahi. I peina mun pou ah ka sanggampa ahi hing chizel in, kana chi mawng ahi” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Abimelek in Belamte, Bawngtalte, suohpate, suohnute azawpi a, Abraham kungah apie a, azi Sarah zong apekia ta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Abimelek in, “En in, ka gam na masang ah aum hi, na ut utna ah tengin achi hi.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Sarah kungah, “En in, na sanggampa dangka tul khat ka peta hi, Ngaivawi, na kunga um zousiete nang a dingin mit khuna ding ahi, achi hi. Na tungthu ah na dih sieng kiata hi,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Abraham Pasian kungah a thum a, tualeh Pasian in Abimelek leh azi leh asuohnute adamsah a, tuachi’n tate anei kiata uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mangpa’n Abraham zi Sarah ziehin Abimelek innkuonpite zousie ana chiingsah siengta hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Mangpa’n agensa bangin Sarah ave a, tualeh Mangpa’n agensa bangin Sarah tungah abawlta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Sarah agaita a, Pasian in a akunga agensa hun guot tahin Abraham ateh nua in tapa khat anei sahta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Abraham in, Sarah in ahin pieh atapa min Isaak aphuota hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n, Abraham in Pasian in a tung ah athupieh bangin atapa Isaak nigiet a chin in atep atanpieh tahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh atapa Isaak anei laiin, Abraham kum zakhat ahita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Sarah in, “Pasian in ahing nuisah ta a, aza zousie’n ahing nuipi ding uh” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Amanu mamain, Abraham kunga “Sarah in naungehte ahing pomding chia, genna dan thei ding koi ahiei? ateh nuain tapa ka hinpiehta thuoi a” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n naungeh ahing khanglien a, nawi neh atawp sahta ua, tualeh Isaak nawi neh tawp niin Abraham in annkuong thupitah alui hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Izipt mi Hagar tapa, Abraham a dinga ahinpieh pa’n anuisan lai Sarah in amu a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuaziehin aman Abraham kungah “tam suohnu leh atapa notdoh in; suohnu tapa in ka tapa Isaak gou aluopi sih ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh tamthu, atapa ziehin, Abraham a dingin lungkim a huoi vawtsih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Pasian in Abraham kungah, “Naupang leh na suohnu ziehin lungkimmaw sin, Sarah in agen zousie zuiin, Isaak akipat in nahah nasuon akichi pan ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh suohnu tapa akipat in zong, Nam khat ka siem doh ding hi aziehpen ama zong na suon ahi.”
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Abraham zingmawng matahin athou a, tanghou leh tuithawl ala a Hagar apie hi, aliengkou ah aposah a, tualeh naupang zong asawldoh ta hi. Tualeh amanu zong apei a, Beersheba gamdai ah avahvaita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Tuithawla tui ahing beita a, tuachiin naupang khu sawlbawh nuoi khat ah akoita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n apei a “Naupang shiding ka mu ngam sih achi ziehin,” amatoh kitang gamla simtah thaltang tuhphah na ding munah atouta hi; Tuachi’n amasang zawn a touin, aw ngaitah in akikou a, akapta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Pasian in naupang aw aza a, tuachi’n Pasian Vansawlsieng in van a kipat in Hagar ahan a, a kungah “Bangin ahing buoisah ahiei? Hagar zausin, aumna a naupang kikou aw Pasian in aza hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thou inlen naupang domtou inlen, na khut in tuin, ama nam thupitah a siem ding ka hi,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Pasian in amit avahsah a, tui khuh khat amu a, tuachiin ava pei a tuithawl athal dima adawnsah ta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Pasian naupang toh aumkhawm a, ahing khanglien a, Gamdai ah ateng a, thalkap siem mi ahing hita hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Paran gamdai ah a tenga, anu’n Izipt gam apat azi ding aguon hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh khum hun laiin hichi ahing hi a, Abimelek leh a galkap pawl lamkai lienpen Phikol in Abraham kungah “Na silbawl tapou ah Pasian in ahing umpi zel hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuaziehin tuin tam mun ah Pasian min in kei leh katu kata leh kahah kasuonte tung ah zong sol bawllou in, ka hing na hepitah mabang in kei leh na tenna gam hepina toh thuh sam dingin ka kung ah kichiem in,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Abraham in, “Kichiem vang” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Abimelek suohten tui khuh khat alahpieh ziehun Abraham in Abimelek khu aphawh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Abimelek in tam sil koi bawl ahiei, ka thei khavawtsih hi achia, nang zong lah nang hil kha nai vawtsih a, tualeh tuni chilou zah zong ka zakha naisih hi,” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Abraham in, Belamte leh Bawngtalte ala a Abimelek apia a, tuachiin ani un thuhun asiemta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Abraham in belam hon lah ah belamnou anu sagi akoi tuom a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Abimelek in Abraham kungah, tana belamnou anu sagi na koi tuomte bang china ahiei? achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khumin aman, “Tam tui khuh khu keima ngel tawdoh vawt ahi chi nahing theipina dingin belamnou anu sagi ka khut akipat na lah ding ahi” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuaziehin khum mun khu Beer-Sheba a kichita hi, tua mun a ani ua akichiem taah zieh un.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuabangin Beersheba ah thuhun ahung ua, tuamin Abimelek leh agalkap pawl lienpen Phikol khu ading khie ua, Philistinte gamah akile kiata uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Abraham in Beersheba ah tasing asuon a, khunah Mangpa tangtawn Pasian min alou hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n Philistinte gamah Abraham sawtpi aumta hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh tamte nuain tambang ahing ahi a, Pasian in Abraham a ze-et a, a kungah, “Abraham” achia, tualeh aman, “Ngaiin tanah ka um hi” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Aman, “Tuin na tapa, na tapa tang neisun Isaak na it mama zawpi inlen, Moriah gamah pei inlen, khuna ka hing hil ding taangte lah a khat ah halmang sillat in lan in,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Abraham zingmawng matahin athou a, a Sabiltung aguong a, a tangvalte lah a ni azawpi a, a tapa Isaak toh tualeh halmang sillat na ding sing alee a, akipankhie a, Pasian in ahilna mun lamah apeita hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n a ni thum niin Abraham adah a, amun khu gamla piin amu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Abraham in atangvalte kungah, “Sabiltung toh tanah na um unlen, kei leh naupang apam ah va pei va ungin, Pasian va beva ung, tualeh na kung uah hing peikia va-ung” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Abraham in halmang sillat sing ala a, a tapa Isaak a posah a, tualeh akhut in mei leh temta atawi a, tuachi’n ani un azawhkhawm ta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh Isak in apa Abraham kungah, “Pa aw!” achia, tualeh aman “Tanah um ing e bawi” achia, tualeh aman a kungah, “Envawi, mei leh sing aum a, hinanleh halmang sillat ding Belamnou heia um ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Abraham in, “Bawi Pasian in ama ading halmang sillat ding kingaituo naven” achia, tuachiin ani un azawhkhawm ta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Pasian in ahilna mun ava tungta ua, tuanah Abraham in maitam adaw a, a singte achieng khawm a, tualeh atapa Isaak akaan a, maitam a sing tungah asielta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Abraham in akhut alaam tou a, atapa thana dingin a temta alata hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh Mangpa Van sawlsiengin van apat in ahan a, “Abraham, Abraham” achi a; aman “Tanah um ing e” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh aman, “Naupang tungah na khut ha sinlen, bangma zong law vawt sin, na tapa tang neisun na itlou ziehin Pasian na giing hi chi tuin ka theita hi” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Abraham adahtou a, a et leh, ngaivawi, anualam ah Belamtal, Singbawh lah ah aki-a awh ana uma, Abraham in tua belamtal ava man a, atapa taangin halmang sillat in alanta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Abraham in tuamun min dingin Jehovah-Jire achita hi. Tuni donga “Mangpa tangah ngaituo ahi ding,” akichi zel bangin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Mangpa Van sawlsiengin van a kipat in Abraham ani veina dingin ahan a,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Keimaleh keima kilouin ka kichiem hi; Mangpa’n achi, azieh pen tam sillat na bawl ziehin na tapa, na tapa tang neisun zong na it lou ziehin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hing guolzawl ngei ngei vangin, van a aasi za leh Tuipi gei a pieunel za in na hah nasuonte ka pungsah ngei ngei dinga, tualeh nahah nasuonten agalte kulkot a luopieh ding uhi.”
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh “Ka thu naman ziehin na hah nasuonte ziehin leitunga nam zousie guolzawl in umva uh,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Abraham tangvalte kungah ahing kilekia a, adingdoh ua Beersheba ah apei khawmta ua, Abraham pen Beersheba ah aumta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh tamte nua in, “Ngaivawi, Milkah in zong na sanggampa Nahor dingin tate ahin piehta chiin Abraham ahing hil uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tapa tapen min Huz ahia, anaupa min Buz ahi. Tualeh Aram pa Kemuel toh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Kesed, Hazo, Pildash, Jidlaph leh Bethuel zong ahi uhi.”
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Bethuel in Rebekah ahing hi. Tam pasal giette Milkah in Abraham sanggampa Nahor dingin ahinpieh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh ameinu, amin Reumah in zong Tebah Gaham, Thahash leh Maakah ahing hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sarah damsung kum za leh kum sawmni leh sagi ahia, tamte Sarah damsung kumte ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Sarah Kirjath-Arba ah ashi a, tuami Kanaan gam a Hebron kichi ahia, tualeh Abraham pen Sarah suun ding leh kaa dingin ava hawta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Abraham mishi luong kung apat in adingdoh a, Heth tate kungah.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Na lah uah gamdang mi leh mikhuol bep ka hia, ka mishi luong ka mu nawnlou na dinga ka vui khiet theina dingin na lah uah kivuina mun ding goutan hing pie un,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Heth taten Abraham a dawng ua, a kungah.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ka mangpa uh ka thugen uh ngaikhie in, ka lah uah nang lal thupitah na hi; ka han uh na deina penpen ah na mishi vuiin, na mishi vuina dingin koiman ka han uh it sih va ung,” achi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Abraham adingkhie a, tua gammi hahlesuonte kun in salam abuh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh amauh ahoupi a, a kung uah “Ka mishi ka mu lou dinga ka vui pha nang sahpi u’leh hing ngaikhie unlen, Zohar tapa Ephron kungah hing ngetpieh un.
  </para>
  <para style="p">
    <verse number="9" style="v" />A loutaw a um aneisa Makpelah Kokhuh hing pie henlen, nalah ua vuina mun goutan dingin aman hun nasah zaza uh la henlen, hing pie heh” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Ephron khu Heth tate lah ah atou zinga, tuachiin Hitmi Ephron in, Hitmite leh a khopi kulpi kotkha a lut zousie nangawn theiin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hilou e, “Ka mangpa hing ngaikhie in lou ka hing pie a asung aum kokhuh zong kahing pie hi. Ka chipite tate mitmu in ka hing pie hi, na mishi vui in,” chiin Abraham adawng hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Abraham tua gam mite masang ah abohkhup hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh tua gam a tengte zah in Ephron kungah, “Pha nasah leh hing ngaikhie in, louman pen vang ka hing pe ding hi. Kei a kipat la inlen khunah ka mishi ka vui ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Ephron in Abraham a dawnga a kungah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka mangpa, hing ngaikhe vawi in, “Agam khu dangka Shekel zali hugiap ahia, tuami nang leh kei kaala gentham ahi amah? tuaziehin na mishi vui mai in,” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Abraham in Ephron thugen a ngaikhie a, tualeh Abraham in Heth tate theipi in Ephron genza dangka Shekel zali, Summet bawlte zah zel ate pieh a Ephron apeta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Ephron lou, Mamre mazawn a Makpelah gam a um alou toh, a sunga um kokhuh toh, alou lai leh agamgi kimkot a sing umte zousie toh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham kungah Heth tate theipi in, a khopi uh kotkhah a lut zousiete masang ah pieh kip in aumta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tamte zouin Abraham in azi Sarah Kanaan gam a Mamre mazawn a um Makpelah lou a kokhuh ah avuita hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n lou leh a sunga kokhuh um khu Heth taten Abraham kungah kivuina mun a nei den dingin apekipta hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuin Abraham akumte tam in ahing tehta a, Mangpa’n sil zousie ah a guolzawl hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Abraham in anei zousie tunga vaihawm, asuohte lah a upapen kungah, “Hepitahin nakhut ka pheipi nuoi ah gol in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n, Mangpa van Pasian leh lei Pasian min louin, ka umna Kanaan mite tanute ka tapa zi a neisah lou dingin ka hing kichiem sah ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh ka gam lam ua ka be leh phungte lah uah pei inlen, ka tapa Isaak zi ding na valah pieh ding ahi” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh a suohpan a kungah, “A numei in tam gam lamah hing zui utlou thei hi, na tapa na hing pawtkhietna gamlam a ka pui kia ngaiding adiei?” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Abraham in a kungah, “Ka tapa tualang a puikia lou dingin pilvang in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mangpa van Pasian, ka pa inn leh ka pienna gam a kipat hing lakhepa leh na hah nasuonte tam gam ka peding chia, ka kung a thugen a kichiem pa’n, a vansawlsieng na masang ah sawl vanin, tuana kipat ka tapa zi na hing neisah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh a numei in ahing zui ut vawt sih leh ka kunga na kichiemna thu ah na sieng dinga, abang abang hileh ka tapa tualang ah puikia vawt sin” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n asuoh pa’n akhut apu Abraham phei nuoi ah agol a, tuami thu ah a kichiemta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n a suohpa’n apu Sangawngsaute lah ah sawm ala a, apu neitah akhut aum zousie tawi in akipan kheta hi. Tuachi’n adingdoh a, Mesopotamia gam a Nahor umna khuo ah ahawta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh nitahlam a numeite tuitawi dinga akuon hun laitah un, daigei a tuikhuh kungah a sangawngsaute akhupdinsah a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n aman, “Aw Mangpa ka pu Abraham Pasian, hepitah in tunin hing lawchingsah inlen, ka pu Abraham tungah na hepina langsah in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngaivawi, tanah tuikhuh gei ah ka ding a, khopi mite tanute tui tawiding in ahing kuon uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh tambang hiheh, nungahte koi hitaleh, hepitahin ka dawn dingin na tuibel ngiemsah vawiin kachi a, tualeh aman, dawn inlen na sangawngsaute zong kadawn sah ding hi hing chipen pen, tuami ngel khu na suoh Isaak zi dinga na miguot hihen; tuachi’n ka pu tungah hepina na sulang chi, ka thei ding hi” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh hichi ahing hi a, a thugen azaw masangin ngaivawi, Abraham sanggampa Nahor zi Mikah tapa Bethuel tanu Rebekah, alieng a tuibel puoin ahing kuon hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh nungah pen amel ahoi mama a, nungah siengthou, pasal pawl kha nai vawtlou ahia; tualeh tuikhuh ah akumsuh a, a tuibel adim a ahing katou kiata hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh suohpa ama dawn dingin atai a, “Hepitahin na tuibel a tui tawmnou khat hing dawnsah ve,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuichin aman, dawnve, “Ka mangpa” achia, tuachi’n kintahin atuibel akhai ngiemsuh a, adawnsah hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh tui adawnsah zouin, “Na sangawngsaute a ding zong, akham masangsie uh ka tawipieh zel ding” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n manlangin atuibel a tuite gankuong ah asung a, tui thal dingin atai kia a, a sangawngsau zousie dingin tui athal pieh zel hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh tua mipa’n amanu a enzinga Mangpa’n a zinna alawchin sah leh chinsahlou theina dingin sip dide in a en khin khian hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n hichi ahing ahia, sangawngsauten tui adawn zoutah un tua mipan shekel kimkhat a gih sana bilba khat leh shekel sawm agih sana tau ni alakhie a,
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh “Koi tanu na hiei? hepitahin hing hil in, na pa inn ah giehna ding mun aum diei?” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n amanu’n a kungah, “Nahor dinga Milkah in a hinpieh Bethuel tanu ka hi” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualouzong, “Gante ann neh ding bupawl leh tunna ding inndan zong aum hi” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n tua mipan alu akunsah a, Mangpa abeta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh aman, “Ka pu tunga akhotuona leh athutahna tawpsan ngailou Mangpa ka pu Abraham Pasian phat in um hen, kei zong Mangpa’n ka pu unaute innlam a ahing na pui ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n nungahnu atai a tam silte anu innkuonpite avahil a,
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Rebekah in sanggam pasal khat anei a, amin Laban ahia, tualeh Laban tuikhuh a tua mipa kungah avatai ta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh hichi ahing ahia, aman a sanggamnu khuta taute leh bilbate amu a, tualeh a sanggamnu Rebekah in tua mipan ka kungah, “Tambangin agen hi achia, agen azah tahin tua mipa kungah ahing pei a, ngaivawi, ama tuikhuh ah sangawngsaute kungah ading hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh ama’n, hing lut in, nang Mangpa guolzawlpa; bang dinga innmai a ding na hiei? inn ah sangawngsaute dingin mun ka bawl zouta” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n, tua mipa inn sungah alut a, tualeh Laban in asangawngsau vante aphel a, sangawngsaute bupawl leh gan-ann apie a, tualeh ama leh a zawpite keng silna ding tui apie hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh amasang ah neh ding ann aluipieh a, hinanleh aman, “Kahing peina zieh thu ka gen masangin nesih vang,” achi hi. Tualeh aman, genveleh achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n aman, “Abraham suohpa ka hia.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh Mangpa’n ka pu nasatah in aguolzawl a, mi thupitah ahing hita hi. Belam honte, bawng honte, dangkate, sanate, suohnute, suohpate, sangawngsaute leh sabiltungte apie hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh ka pu zi Sarah in ateh nuain ka pu dingin tapa ahinpieh a, a kungah anei leh a lam zousie apeta hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh ka puin ka tapa zi dingin ka umna gam Kanaan mite tanute la sinlen.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hinanleh ka pa innkuonpite leh ka tanute kungah pei inlen, ka tapa zi ding na vala ding hi chiin ahing kichiem sah hi.’
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh ken ka pu kungah anumei in hing zui ut sih taleh, ka chi hi.’
  </para>
  <para style="p">
    <verse number="40" style="v" />Hinanleh aman ka kungah, ‘Mangpa, amasanga ka umzing na pa’n avansawlsieng na kungah hing sawl van in, na peina ah ahing lawchingsah na ding hi. Tualeh ka tapa zi dingin ka sanggamte leh ka pa innkuonpite lah apat nala ding hi, ahing chi hi.’
  </para>
  <para style="p">
    <verse number="41" style="v" />Ka sanggamte kunga na tun chiengin, ka kunga na kichiemna apat na sieng dinga, tualeh amanu ahing na pieh sih u’leh ka kunga na kichiemna apat na siengta ding hi ahing chi hi.’
  </para>
  <para style="p">
    <verse number="42" style="v" />Tualeh tuni in Tuikhuh ah kahing tunga, tualeh, Aw Mangpa, ka pu Abraham Pasian; tunia ka peina a nahing lawchin sah ding leh;
  </para>
  <para style="p">
    <verse number="43" style="v" />Ngaivawi, tuikhuh kungah ka ding hi, tualeh tambang hiheh, nungah tui tawi dinga ahing pei chieng in a kunga, “hepitahin dawnding na bel a tui tawmnoukhat hing pie’n,” ka chi a.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tualeh amanu’n ka kunga, “nang dawn inlen na sangawngsaute ading zong sawh vang achileh,” tua minu ngel khu Mangpa’n ka pu tapa dinga aguot numei hiheh, ka chi hi.’
  </para>
  <para style="p">
    <verse number="45" style="v" />“Hinanleh ka lungsim a ka gen zou masangin, Ngaivawi, Rebekah, alieng a tuibel puoin ahing kuon a, tuikhuh ah akumsuh a, tui adim a, tualeh ken a kungah hepitahin tui hing dawnsah in ka chi hi.’
  </para>
  <para style="p">
    <verse number="46" style="v" />Tualeh aman kintahin alieng a tuibel adom khie a, dawn inlen, na sangawngsaute zong dawnsah vang achi hi. Tuachi’n ka dawna ka sangawngsaute zong adawnsah hi.’
  </para>
  <para style="p">
    <verse number="47" style="v" />Tuachi’n koi tanu na hiei? chiin ka donga, tualeh amanu’n Nahor dinga Milkah in ahinnpieh Bethuel tanu achia, tuachiin anahkuo leh abil ah bilba kaba sah a, taute zong akhut ah ka bunsah hi.’
  </para>
  <para style="p">
    <verse number="48" style="v" />Tualeh ka lu kunsuhin Mangpa ka bie a, tualeh atapa zi dinga, ka pu naupa tanu puipieh dinga lampi dih a hing puipa Mangpa ka pu Abraham Pasian khu ka pahtawi hi.”
  </para>
  <para style="p">
    <verse number="49" style="v" />Tuin, “Ka pu na hepi ua, a tunga chitahpi a bawl ding na hi u’leh zong hing hil un, tuachiin zietlam amah veilam amah a ka kihei theina dingin,” achi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tuachi’n Laban leh Bethuel in adawng ua, “Tam sil Mangpa apat hing kipan ahia, asie apha na kungah ka gen thei sih uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Enin, Rebekah na masangah aum hi, pui inlen peitan; tualeh Mangpa’n agensa bangin na pu tapa zi in umta hen,” achi ua.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tualeh hichi ahi a, Abraham suohpan a thugente uh azahtah in leia bawhkhup in Mangpa abie hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tuachi’n Abraham suohpan dangka kizepnate Sana kizepnate leh puonsil nihten ahing lakhie a, Rebekah apeta hi. Tualeh a sanggampa leh anu zong sil manpha pipi apie hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tualeh aman aguolte toh ane in adawn ua, agiehta uhi. Tuachi’n zingmawng in athou ua, aman, “Kapu kungah hing peisah ta in” achi hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Hinanleh asanggampa leh anu’n nungahnu pen ka kung uah, “Tomnou khat atawmpen in ni sawm beeh umtadi henlen, tua zou chieng in hing pei nava” achi uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Tualeh aman, akung uah, hing vai kai sah da un, “Mangpa’n lah ka haw na ahing lawching sah ta ngal a; ka pu kunga ka pei thei na dingin, hing sawl doh zomai vawi un,” a chi hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tuachi’n ama un, nungahnu han vaiin ama nu kamteng ngaikhe vai achi uhi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tuachi’n Rebekah ahan ua, a kungah, “Tampa toh na zawhkhawm tading uh amah?” achi ua, tualeh amanu’n “Zawhkhawm tava ung” achi hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Tuachi’n amaun asanggamnu uh Rebekah leh adonnu toh Abraham suohpa toh a guolte toh apeisah ta uhi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Tualeh amaun Rebekah a guolzawl ua, a kungah, nang ka sanggamnu uh tul sawm ngen tul tampi nu hing hi inlen, nahah na suonten amauh mudate kul kotkhah luota uhen, achi uhi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Tuachi’n Rebekah leh a suohnute adingkhie ua sangawngsaute tungah atuong ua, tua mipa azuita uhi. Tuachi’n Abraham suohpa’n Rebekah puiin apeita hi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Tualeh Isaak khu Beer-lahairoi lam apat ahing pei a, simgam lam a teng ahi ziehin.
  </para>
  <para style="p">
    <verse number="63" style="v" />Tualeh Isaak nitahlam in lou ah kingaituo dingin a pawtdoh a, tualeh adah a, a et leh ngaivawi, sangawngsau hing peite amuta hi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Tualeh Rebekah adah a, Isaak amutahin sangawngsau tung apat akum a.
  </para>
  <para style="p">
    <verse number="65" style="v" />Tuachi’n ama’n. Abraham suohpa kungah, “Eite dawn dinga lou a hing pei khu koi ahiei?” a chi hi. Tualeh a suohpa’n, “Kapu ahive” achi a, tuaziehin amanu’n akikhuna puon ala a, akikhuta hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Tualeh suohpa’n asil bawl zousie a unin Isaak ahilta hi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Tuachi’n Isaak in Rebekah anu Sarah biehbuh ah apuilut a, Rebekah akitenpi ta a, azi ahing hita hi. Tualeh aman amanu a it mama a, tuachiin Isaak khu anu shi nuain alungmuang thei ta hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham in zi dang khat anei kia a, amin Keturah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh amanu’n Zimran, Jokshan, Medan, Midian Ishbak leh Shuah ahinpieh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Jokshan in Sheba leh Dedan ahing a, tualeh Dedan tapate Ashurim leh Letushim leh Leummim ahi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Midian tapate Ephah, Epher, Hanok, Abidah leh Eldaah ahi uhi, tamte a unpi un Keturah tate ahi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Abraham in anei zousie Isaak kungah apeta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinanleh ameinu tapate kungah Abraham in silpiehte apie a, ama dam laiin atapa Isaak kunga kipat suolam gam ah asawlmang ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Abraham damsung kum za leh kum sawmsagi leh nga ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Abraham kum tamtah a dama, vuoikawn vawt in a hagau aha a, ateh shita hi. Tualeh a chipite toh pui in aumta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh atapate Isaak leh Ishmael in, ama Mamre mazawn a um Hitmi Zohar tapa, Ephron lou a um Makpelah kokhuh ah avuita uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua lou pen Abraham in Heth tate kunga kipata alei ahia, tuanah Abraham leh a zi Sarah akivui ta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua zouin tambang ahing hi a, Abraham shi nuain, Pasian in a tapa Isaak aguolzawl a; Tualeh Isaak Beer-la-hai Roi ah a teng ta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tu’n tamte Abraham ading a Sarah suohnu Izipt mi Hagar in ahinpieh Abraham tapa Ishmael hahlesuonte khanggui ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh tamte amin chiet u’leh ahah asuonte uh dungzuiin, Ishmael tate min ahi. Ishmael tapa masapen Nebajoth ahia, abanah Kedar, Adbeel leh Mibsam.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mishma, Dumah leh Massa,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadar, Tema, Jetur, Nephish, Kedemah ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tamte Ishmael tapate ahi uhi, atenna khuo u’leh agiehbuh uh dungzui a amin uh kigiel ahia, anam uh dungzuiin leeng sawm leh ni ahi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Ishmael dam sung kum za leh kum sawm leh sagi ahia, tuachiin a hagau aha a, ashita hi. Achipite kungah pui in aumta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh ahahlesuonte Havilah gam akipat in Assiria zotna Izipt gam suolam toh kigaldot Shur dongin ateng ua, ama pen a unaute mitmu in ashita hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh tamte Abraham tapa Isaak tapate Jakob leh Isau tate khanggui ahi. Abraham in Isaak ahing a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isaak pen Siria mi Laban sanggamnu, Padan-Aram gam a Siriami Bethuel tanu Rebekah zi a anei laiin Kum sawmli mi ahia;
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh a zi achiin ziehin Isak in a zi a dingin Mangpa kungah a ngetpieh a, a ngetna khu Mangpa’n a ngaikhiet pieh a, tuachiin Rebekah ahing gaita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hinanleh anau paite asungah akisuol ua, tuachiin amanu’n “Tambang giap ding ahi leh kahin bang e aphatuom?” achia, tuachi’n Mangpa dong dingin akuonta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Mangpa’n a kungah, “Nasung ah Nampi ni aum a, nagil sunga kipat in nam ni kikhen vanin, nam khat pen adang khat pen sangin hatzaw vanin, a upa penin a naupang zawpa na asem ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n anau nei hun ahing tunin, ngaivawi, a sunga nau apeng ana hi a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n amasapen asanin asan a, puonmul banga nel thiep thuop in ahing pienga, tuachiin amin dingin Esau aphuo uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuazouin anaupa ahing pienga, akhut in Esau ketul atu chinten a, tuachiin ama min Jakob ahisah uhi. Rebekah in amaute anei laiin Isaak kum sawmguh mi ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n naupangte ahing khang lien ua, Esau sabeng siem, gamvah mi ahia, Jakob pen mimawl puon inn a teng mi ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Isaak in Sakhisa aneh zel ziehin Esau a it a, hinanleh Rebekah in Jakob a it zaw hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Jakob in Bechiim ahuon a, Esau gamvah ahing tunga, a tha agim mama hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n Esau in Jakob kungah, “Na bechim huon hing nesah in, ka basam gawpta hi” achia, tuaziehin ahi amin Edom akichina.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinanleh Jakob in, “Tunin upa na hina hing leisah phot in” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Esau in, “Ngaivawi, gilkiel a shi ding ka hita a, upa hina in kei a dingin bang phattuomna hing tun ding ahei?” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n Jakob in, a kungah, “Tunin ka kungah kichiem in” achia, tuachiin akichiemta a, upa hina Jakob kungah azuata hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuabepin Jakob in Esau kungah tanghou leh abuchiim apie a, tualeh aman ne in adawn a, akipeita hi. Tambangin Esau in upa hina amusit hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh tua gam a Abraham damlai a kiel tung masapen chilou, kiel dang khat ahing tung kia a, tualeh Isaak Philistinte leengpa Abimelek kungah Gerar ah ava haw a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khumin Mangpa a kungah akilah a, a kungah, “Izipt gamah peisuh sinlen, gam ka hing hilding ah teng in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tam gamah umtadi inlen, ka hing umpi dinga ka hing guolzawl ding hi, tualeh nang leh nahah nasuonte kungah, tam gam zousie hing pevangin napa Abraham kunga ka kichiemna pen ka sukip ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh nahah nasuonte van a aasi za in pungsah vangin, nahah nasuonte kungah tami gam zousie pevangin, tualeh nahah nasuonte vangin leitung nam zousie guolzawl in umva uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham in ka thu a manga, ka thuhilte, ka thupiehte, ka thuguotte leh ka dante azui ziehin,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Isaak Gerar ah ateng ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh khuna umten azi tungtang adong ua, aman, “Ka sanggamnu ahi” achia, amel ahoiseng ziehin, Rebekah ziehin tam khomiten hing that khava uh chiin, ka zi ahi achi ngam sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh hichi ahing hia, khuna hun sawtpi aum nuain, Philistinte leengpa Abimelek in kotta a ahing dahleh, ngaivawi, Isaak in azi Rebekah anou lai amu a;
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Abimelek in Isaak ahan a, “Ngaivawi, na zi hinapi, bang dinga ka sanggamnu ahi nachi ahiei?” achi hi. Khumin Isaak in a kungah, “Ama ziehin shi khavang kachi zieh ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Abimelek in, “Ka tung ua tam sil nabawl bang chidan ahiei? Mikhat in na zi ana luppi maithei asiei mah? Tuachi’n ka tung uah siemmaw hing tangsah thei nahi” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Abimelek in, “Koizong tam mipa ahisihleh a zi sukha pouma suhlia tei tei ding ahi,” chiin amite zousie thu apie hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Isaak in tua gamah bu a chiinga, tuami kumin ale za anei a, Mangpa’n a guolzawl hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n ama ahing thupi mama ta a, nasahtah a mi thupi hikhop hiel in ahing lawching deudeu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuaziehin aman belam hon leh bawnghon leh suoh tampi anei a, tuachi’n Philistinten athang sietta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n apa Abraham damlai a apa suohten tuikhuh ataw zousie uh Philistinten ahuh bing pieh ua, lei avuadim sieng uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Abimelek in Isaak kungah, “Ka kunga pat peimang doh in, kou sangin na thupi zawta hi achi hi.”
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Isaak tuana kipat in apawt kheta a, Gerer phaihawm ah apuon inn azah a, tuanah atengta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Isaak in apa Abraham damlai a a tuikhuh tawte uh atou kia hi. Abraham shi nua a, Philistinten ana huhdim pieh sieng uh ahi. Tualeh apa’n ana minvawsa bang chietin amin uh ahisah denta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Isaak suohten zong phaihawmah tuikhuh atou ua, tuanah tui nahnei khat amu uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh Gerar khuo a ganchingten, “Kou tuikhuh ahi” chiin Isaak ganchingte akihaupi uhi. Tuachi’n ama toh akiniel ziehun tua tuikhuh min Esek achita uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n amaun tuikhuh dang atoukia ua, tua zong a tupieh kia ziehun akihau ua, tuami min Sitnah achita uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh khummun akipat in akisuon a, tuikhuh dang atou kia a, tuapen atu nawnsih ua, sel zong akiselpi nawnsih uhi. Tuaziehin tammun min khu Rehoboth achita hi, “Tuin Mangpa’n ei a dingin mun kiningchingtah ahing bawl piehta a, tamgam sungah chi tampi isuong ta ding hi” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n tuana pat in Beersheba a zuonta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh khum zan mama in Mangpa, a kungah ahing kilah a, “Kei, na pa Abraham Pasian ka hi, zau vawt sin ka hing umpi zing hi; hing guolzawl vangin hinanleh ka suoh Abraham ziehin na hah nasuon ka hing pungsah ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh aman khunah maitam a bawla, Mangpa min a han a, biehbuh zong a jah a, tualeh Isaak suohten tuikhuh atouta uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Gerar akipat in Abimelek, a guolte lah a mikhat Ahuzath toh a galkap pawla lamkai lienpen Phikol toh a kungah ahing apei ua.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Isaak in a kungah, “Na hing muda ua, na kung ua kipat na hing nawdoh uh hitalou ka hiei amah? Bang chidan a ka kunga hing pei na hi uoi?” achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh amaun, “Mangpa na kungah aum chi ka thei chien uhi. Tualeh ikikaal uah kou leh nang kikaal ngei ah kichiemna neiin nang toh thuhun khat bawlvai kachi uhi.’
  </para>
  <para style="p">
    <verse number="29" style="v" />Na siet na ding ka bawl lou ua, silhoi loungal na tunga bangma ka bawl lou ua, hamuangtah a kahing sawlmang doh bang un, kou sietna ding mawngmawng na bawl louna dingin, tuin nang pen Mangpa guolzawl in na umta hi,” achi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuachi’n ama’n ama ua dingin annkuong a luipieh a, ne in adawnta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh zingmawng matah in athou ua, akichiem tuoh ua, tuachiin Isaak in asawl khie a, lungmuong tah in apeita uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh hichi ahing ahia, tuami ni mamain Isaak suohte ahing pei ua a kungah, tui tawdoh thu ahing hil ua, a kungah “Tui ka muta uhi” ahing chi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n aman tuami Sheba achita hi. Tuaziehin tua khopi min khu tuni tanin Beersheba akichi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Esau kum sawmli a upa ahi in Hitmi Beeri tanu Judith, leh Hitmi Elon tanu Basemath zi in anei hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuate khu Isaak leh Rebekah lungsim sugimte ahi uhi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh hichi ahing ahia, Isaak ahing tehta a, khomu theilou khop in amit ahing miel gawpta a, atapa upapen Esau a han a, a kungah, “Ka tapa” achi hi, tualeh aman, ngaiin “Tanah ka um hi” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh aman, “Ngaivawi, tuin ka teh sengta a, ka shi ni ding lah ka thei sih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuaziehin hepitahin na hiemzah, na thaltang bawm leh na thalpi la inlen, gam vavah inlen sakhi hing matpiehin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh ka du dan tahin me tuitahin hing bawl inlen ka kungah hing tawi in, ka shi masanga ne a ka hing guolzawl theina ding in” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Isaak in atapa Esau ahoupi lai, Rebekah in anaza hi. Tuachi’n Sakhi man a hing paw dingin Esau akuonta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Rebekah in atapa Jakob kungah, “Ngaivawi, na pa’n na u Esau ahoupi lai ka za a, akungah.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Sakhi hing va puohpieh inlen, me tuitah hing bawlpieh in, ka neh a ka shi masanga Mangpa kunga ka hing guolzawl theina ding in, chia agen kaza hi.’
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaziehin ka tapa ka hing thupieh bangin ka thu mangin.’
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuin ganhon lah ah vapei inlen, Kelnou hoitah ni hing lain, napa dingin adu dantah in me tuitah ka bawl piehding achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n tuami ane a, ashi masang ngei a nang ahing guolzawl theina dingin, na pa kungah nava tawi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Jakob in anu Rebekah kungah, “En in, ka upa Esau mi mul hau ahia, keipen mi vun mam kahi achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka pa’n ahing na zut kha thei hi, tua hileh ama ngaiin mi solpa ka bang dinga, guolzawl malahin samsiet kisui kawi ka bang kha zawsih ding amah?” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh anuin a kungah, “Na kisamsietna khu ka tungah tuzaw heh, ka tapa ka thu mang mai inlen, hing valah piehin,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n a pei a ava lata a, anu kungah ahing tawi a, tualeh anu in apa dudantah in me tuitah abawl piehta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Rebekah in atapa upapen Esau puon hoipen, a kunga inn sunga um khu ala a, atapa a naupang zaw Jakob a silsah ta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Kelnou vun khu akhut leh angawng mamna mun ah a koia,
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n me tuitah leh tanghou a bawlte khu atapa Jakob khut ah apie a,
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n apa kungah ahing pei a, “Pa aw”; achi hi, Aman, “Tanah um ing ei, koi na hiei? ka tapa,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Jakob in apa kungah, “Na tapa upapen Esau ka hi, na hing sawl bangin ka bawl zouta hi; hepitah in hing thou inlen, na hing guolzawl theina dingin ka Sakhisa ne vawi,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh Isaak in atapa kungah, “Ka tapa, bangchidan a hiei? hing manlang na va-ia chie?” achi hi. Tualeh aman, “Mangpa na Pasian in ahing lawchinsah zieh ahi” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Isaak in Jakob kungah, ka tapa, “Hepitah in hing naivawi, ka tapa Esau na hi tahtah nai? kahing zutding hi” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Jakob in apa Isaak anai a, aman ana zut a, Tualeh “A aw pen Jakob aw ahia, hinanleh akhut pen Esau khut ahi” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh a khutte a upa khut banga amul ziehin athei khen tasih a, tuachi’n ama a guolzawl ta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n aman, “Ka tapa Esau na hi ngel nai mah?” achi hi, tualeh aman “Hi ma inge” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh aman ka kungah, “Hing tawiin ka hing guolzawl theina dingin, ka tapa Sakhisa ka ne ding hi” achi hi. Tuachi’n a kungah ahing tawi nai a, aman aneta hi; tualeh uain zong a hing tawia a dawnta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n apa Isaak in a kungah, “Tuin hing nai inlen hing tawp in ka tapa” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n aman ava nai a atawpta hi. Tualeh aman a puon gimnam aza a, a guolzawlta hi, tualeh “Envawi, ka tapa gimnam pen Mangpa guolzawl gam gimnam abang hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuaziehin Pasian in van daichimte leh lei hoinate, thaunate leh bu leh uoiin tampi hing peta hen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Midang dangten na nna sem henlen, nam tuom tuomte na masangah kun uhen, na unaute tungah leeng in pang inlen, na nu tate na masangah kun uhen, tualeh hamsie hing lawte hamsiet in um henlen, ahing guolzawlte guolzawl in um uhen” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh hichi ahing hi a, Isaak in Jakob a guolzawl zou tahin, Jakob apa Isaak apat a apeikhiet zou laitahin, a upa Esau sabeng ahing tung a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh aman zong me tuitah a bawla, apa kungah ahing tawia, tualeh apa kungah, “Pa aw, thou inlen, na hing guolzawl thei na dingin na tapa Sakhisa ne vawiin” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh apa Isaak in a kungah, “Koi na hiei? achi hi, aman na tapa upapen Esau kahi” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n Isaak nasatah in achitun a, tualeh apa Isaak in a kungah, “Sakhi va man a ka kunga hing tawia, tualeh na hing tun masanga ka na neh zou a ka guolzawl pa koi ahiei? Heisungah aumtai? Hinanleh ama guolzawl in aum ta ve ve ding” achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Esau in apa thugente azah tahin, hase seng sengin hatang ka-in akapta hi, tualeh a kungah “Pa aw, kei zong hing guolzawl ve” achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hinanleh aman, “Na naupan ahing sol a, na guolzawlna akilah mangta hi” achi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh aman, “Amin Jakob kichi dih va-ia tei e izaw? Nivei ahing suomna ahita hi, uzaw ka hina ahing lah pieha, ngaivawi, tuin ka guolzawlna tan ding ahing lapieh kiata hi,” achi hi. Tualeh aman, “Kei dinga guolzawlna hing khetpieh talou na hiei mah?” achi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n Isaak in a dawnga, Esau kungah, “Ngaivawi, ama pen na mangpa dingin ka bawlta a, a unaute zousie asuoh dingin ka peta hi. Tualeh bu leh uain in ama ka vahta hi. Tuin nang a dingin bang kang bawlpieh ding ata diei, ka tapa” achi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh Esau in apa kungah, “Pa aw, guolzawlna khat mai mai amah na nei? Aw pa, kei zong hing guolzawl ve, aw pa,” achi hi. Tuachi’n Esau aw ngaitahin ahing kapta hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuachi’n apa Isaak in a dawnga, a kungah “Ngaivawi, na umna ding lei hoinatah leh tunglam a van daichimte kiehna ahi ding’ achi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Na namsau in na hing dinga, na naupa nna nasem dinga: tualeh hichi ahing hi dinga, thuneina na hing nei chiengin na ngawng apat in a hahkol na thing kheta ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tuaziehin Esau in Jakob apa’n ana guolzawl taah ziehin amuda a, tualeh Esau in a lungsim in, “Ka pa lah shibai tavan, tuachiengin ka nau Jakob ka that mai ding hi.” Achi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tualeh tam atapa upapen thugen Rebekah kungah hil in aumta a, tuachiin aman mi a sawl a, atapa naupang zaw Jakob ahan sah a, a kungah, “Ngaivawi, na upa Esau in na tungthu ah nangma tha hing sawm in akihenem hi.’
  </para>
  <para style="p">
    <verse number="43" style="v" />Tuaziehin ka tapa, tuin ka thu mangin, thou inlen, Haran a ka sanggampa Laban kungah taiin.’
  </para>
  <para style="p">
    <verse number="44" style="v" />Tualeh na upa lungthahna adai masangin a kungah ni tamlou khat va umin.’
  </para>
  <para style="p">
    <verse number="45" style="v" />Na u thangpaina na tunga a dai a, a tunga na sil bawlte a mangngil masang sien, tuachiengin mi hing sawl vangin, tuana kipat ka hing puikhesah ding hi, bang dingin ni khat thuin na ni un ka hing taan diei?” achi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tualeh Rebekah in Isaak kungah, “Heth tanute ziehin hin ka chimtah mama hi; Jakob zi dinga tam gam nungah Heth tanute bang aneikia nahlai levang kei dingin hin bang a phatuom diei?” achi hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Isaak in Jakob ahan a, a guolzawl a tualeh thu apie a, a kungah, “Kanaan gam nungah zi a na nei vawt lou ding ahi.’
  </para>
  <para style="p">
    <verse number="2" style="v" />‘Thou inlen Padan-Aram ah na nu pa Bethuel inn ah vapei inlen, tuana kipat in na nu sanggampa Laban tanute lah a mi zi in vanei in.’
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Tualeh bangkimbawlthei Pasian in hing guolzawl henlen, nam tuomtuom tampi na hing hithei na dingin chi tampi hing suongsah henlen, hing pungsah tahen.’
  </para>
  <para style="p">
    <verse number="4" style="v" />‘Tualeh mikhuol na hina gam, Pasian in Abraham kunga apiehna na luo theina dingin, Abraham guolzawlna khu nang leh na hah nasuonte kungah hing peta heh,” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Isaak in Jakob asawl kheta a, tualeh ama Jakob leh Esau nu Rebekah sanggampa Siria mi Bethuel tapa Laban kungah Padan-Aram ah apeita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Esau in, Isaak in Jakob a guolzawla, zi nei dingin Padan-Aram ah a sawlta chileh a guolzawl laia. Kanaan gam nungahte lah a mi zi in na neiding ahisih chi in thu apie chileh,
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob in anu leh apa thu mangin Padan-Aram ah apeita chi athei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Esau in Kanaan gam nungahten apa alungkimsah sih chi athei a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Esau Ishmael kungah ava pei a, a zi neisate ban ah neibe dingin Abraham tapa Ishmael tanu Mahalath, Nebajoth sanggamnu zi in ava neita hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Jakob Beersheba apat apeidoh a, Haran azuonta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh munkhat ah ahing tungta a, ni atumtah ziehin khum mun ah agiehta hi; tuanah suong khat ala a, taangkhap in anei a, tua nah i’mu dingin alumta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n mang anei a, ngaivawi, leitungah kellei ahing kidaw a, a dawnin van asu a, tualeh Pasian vansawlsiengte katou leh kumsuh amu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh ngaivawi, Mangpa adawn vum ah a dinga, “Kei Mangpa na pu Abraham Pasian leh Isaak Pasian ka hi; na lupna gam khu nang leh nahah nasuonte kungah ka hing peding hi.’
  </para>
  <para style="p">
    <verse number="14" style="v" />‘Tualeh na hah nasuonte khu leia leivui za hivanin, tumlam ah bang, suolam ah bang, mallamte ah bang, tualeh simlamte ah na kithezah dinga, nang leh nahah nasuonte ah leitunga nam zousie guolzawlin umva uh.’
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh ngaivawi, hing umpi vangin, na peina phot ah hing veng vangin, tam gam ah hing puikia vangin; na kunga ka gen ka bawl zou masang sie’n ka hing nuasie sih ding hi.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh, Jakob imu ahing khanglou a, achientah in, “Tami munah Mangpa a um hi; chi ken kana theilou ahi” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n azauta a, “Tam mun zauhuoi gimnei hina va-ia e, tami pen mun dang hilou in, Pasian inn ana hi a, tualeh tam mun pen van kotpi ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n, Jakob zingmawng matahin athou a, a suong taangkhap ala a, khum mun ah aphut a, a tungah sathau abuohta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh khum mun min dingin Bethel achita hi. Hinanleh khum khopi min achiil in Luz ana kichi hi.’
  </para>
  <para style="p">
    <verse number="20" style="v" />‘Tualeh Jakob in thu achiem a, “Pasian ka kungah aum a, ka peina lampi ah ahing venga, tualeh neh ding tanghou leh sil ding puon ahing pieh.’
  </para>
  <para style="p">
    <verse number="21" style="v" />‘Tuachia ka pa inn a hamuongtah a ka tunkia nahleh Mangpa pen ka Pasian ahi ding hi.’
  </para>
  <para style="p">
    <verse number="22" style="v" />‘Tualeh tam suong, suongphu dinga ka phu zong Pasian inn ahi ding a; tualeh ka kunga na hing pieh ding zousie ah sawm a khat ka hing pe ngei ngei ding hi” achi hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Jakob apei zel a, suolam mite gam ahing tungta a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n a enkawi a, lou a tuikhuh um khat amu a, ngaivawi, akungah Belam hon thum alum uhi. Tua tuikhuh apat Belam honte tui a dawnsah zel uhi. Tualeh suong lienpi khat in tuikhuh kam akisin hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Belamhon zousie aum khawm ua, tua tuikhuh kam a suong kisin alia khie ua, Belamte tui a dawnsah ua, tualeh suongpen tuikhuh kam ah aumna ngai ah akoi kia zel uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Jakob in a kung uah, “Ka unaute, heilam mi na hi uoi?” achi hi. Amaun, “Haran khuo lam mi ka hi uhi,” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh aman akung uah, “Nahor tapa Laban na theikha uoi?” achi hi, amaun, “Theima ung” achi ua.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh aman akung uah, “Adam nai?” achi hi. Amaun, “Adam na hi, tualeh envawi, atanu Rachel zong Belamhon toh ahing pei hi,” achi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh aman, “En un, ni zong asang nalai hi, ganhon pui khawm hun zong ahinai sih hi; Belamte tui dawnsah unlen, tualeh ann vanesah tadi un,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hinanleh amaun, “Ka hithei sihding uh, Belam hon zousie akipui khawm a, tuikhuh kam apat suong akiliadoh masang sien, tuazou chiengin Belamten tui ka dawnsah zel uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh amauh a houpi laiin, Rachel in apa belamte puiin, ahing pei a, ama b elam chingmi ahi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh hichi ahing hi a, Jakob in anu sanggampa Laban tanu Rachel leh anu sanggampa Laban belamte amu tahin ava nai a, tuikhuh kam apat suong a liadoh a, anu sanggampa belamte tui a dawnsah hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Jakob in Rachel a tawpa, aw ngaitah a kikou in akapta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Jakob apa tupa ahi chileh Rebekah tapa ahi chi Rachel a hil a, khumin amanu a tai a, apa ava hilta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh hichi ahing hi a, Laban in a sanggamnu tapa Jakob tanchin azah tahin adawn dingin a tai a, tualeh angawngkawi a, a tawpa a inn ah ahing peipi hi. Tualeh aman tua thute zousie a un in Laban ahil hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Laban in a kungah, “Nangpen ka gu leh ka sa chiet vawt hichie,” achi hi, tuachiin a kungah ha khat aumta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Laban in Jakob kungah, “Ka tupa na hi ziehin amawhna’n ka nna nasem ding amah? bang nalaw diei? hing hil vawi in,” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Laban in tanu ni a nei a, a uzaw min Leah ahia, anau zaw pen Rachel ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Leah khu a mit a zuongha a, hinanleh Rachel pen melhoitah leh ngaibang tah ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Jakob in Rachel a it a tualeh, “Na tanu naupang zaw Rachel dingin kum sagi na nna ka sem ding,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Laban in amanu pen midang kunga, “Ka pieh sangin nang hing peleng hoizaw naven; ka kungah um in,” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Jakob in Rachel a kitenpi theina dingin kum sagi a nna asep pieh a, hinanleh amanu a it seng ziehin tomnou kaal sungin a thei giap hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Jakob in Laban kungah, “Ka pawl theina dingin ka zi hing peta in, ka hun lah achingta ngal a,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Laban in khum mun a mi zousie a hankhawm a, annkuong aluita hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh hichi ahing hi a, nitah miel in aman atanu Leah a puia, Jakob kungah a hing puilut a, tualeh aman ana luppita hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Laban in, a suohnu Zilpah a tanu Leah suohnu dingin apie hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n hichi ahing hi a, zingmawng in ngaivawi, Leah ana hita a, Tuachi’n Jakob in Laban kungah, “Ka tunga na nasep bangchidan ahiei? Rachel dinga na nna ka sep hilou ahiei mah? Bang zieha na hing solbawl ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Laban in, “Ka gam uah tambang a ta upazaw masanga a anaupang zaw pieh ngaina ahisih hi.’
  </para>
  <para style="p">
    <verse number="27" style="v" />‘Amanu hapta suching phot inlen, tuachiin kum sagi dang ka nna nasep man dingin tami nu zong hing peva ung” achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Jakob in tambangin abawlta a; ani sagi asu buching ta hi, tuachiin atanu Rachel zong azi dingin apeta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Laban in a suohnu Bilhah khu a tanu Rachel suohnu dingin apie hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Jakob in Rachel zong a pawla, Leah sangin Rachel a it zaw a, tuachiin kum sagi dang Laban na asem hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Mangpa’n Leah pen it ladeuin aum chi amu in, a naubu a honpieh a, hinanleh Rachel pen a chiing hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Leah ahing gaita a, tapa khat a nei a, amin dingin Reuben aphuo hi. Aziehpen, “Mangpa’n ka gentheidan ahing muchien hi, tunvang ka pasal in hing it tava” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh a gai kia a tapa khat aneikia a, huot in ka um chi, “Mangpa’n azata a, tam tapa zong ahing pie hi” achi hi; tuachiin amin dingin Simeon aphuo hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh agai kia a tapa khat aneikia a, “Tuin tapa thum ka neipieh taah ziehin ka pasal in kei hing beltava” achi hi, tuaziehin amin Levi achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh agai kia a, tapa khat anei kia a; “Tuin vang Mangpa phat tavang,” achi hi. Tuaziehin amin Juda ahisah ta a, tuachiin naunei atawpta hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Rachel in Jakob ta ahinpieh sih chi akithei in, a sanggamnu a thangsietta a, Jakob kungah, “Ta hing pie in ahisihleh shi mai vang,” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Jakob Rachel tungah alungthah ta a, “Na naubu a ga hing phalsah loupa Pasian thaheng ka hiei mah?” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n amanu’n enve, “Ka suohnu Bilhah tanah aum hi, amanu pawl inlen, tuachiin ken zong ama a kipat tate ka nei theisam na dingin, ka pheitunga ta hing nei ding ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n asuohnu Bilhah a zi dingin apie a, tualeh Jakob in amanu a pawl a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Bilhah agai a, Jakob tapa khat ahing pieh ta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Rachel in, “Pasian in ahing vaihawm pieh a, ka aw zong aza a, tapa ahing pie hi,” achi hi. Tuaziehin a min dingin Dan a phuo hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh, Rachel suohnu Bilhah agai kia a, Jakob tapa anina a neipieh kia hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Rachel in, “Hatang pi’n ka sanggamnu ka buon a ka zouta” achi hi, tuachiin amin dingin Naphtali ahisah ta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leah in naunei atawpta chi akithei in a suohnu Zilpah a pui a, Jakob zi dingin apie hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Leah suohnu zilpah in Jakob tapa khat ahinnpieh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Leah in, “Vangphat huoi tei e izaw,” achi hi. Tuachi’n amin Gad ahisah hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Leah suohnu Zilpah in Jakob tapa anina ahinnpieh a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Leah in, “Kipah sam ing e, aziehpen numeiten hamphanua hing chi ding uhi.” Achi hi. Tuachi’n amin Asher ahisah ta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Bu lah laiin Reuben apawt khie a, loulai ah zawldei-ai ava mu a, anu Leah kungah ahing tawi hi. Tuachi’n Rachel in Leah kungah, “Hepitah in na tapa zawldei-ai hing hawm in” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh aman, “Ka pasal na hing lahpieh aneu tham a na ngai amah? Tualeh ka tapa zawldei-ai zong hing lahpieh na sawm nalai amah?” achi hi. Khumin Rachel in, “Ahisihleh na tapa zawldei-ai taangin tuzan ahing luppi ding” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh nitah lam in Jakob lou a pat ahing pei a, Leah adawn dingin a pei a, tualeh a kungah, “Hing pawl in ka tapa zawldei-ai in ka hing guoizouta hi,” achi hi, tuachiin tuami zan in a luppita hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Pasian in Leah ngetna a ngaikhie a, tuachiin amanu agaita a, Jakob dingin tapa ngana ahinnpieh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Leah in, “Ka suohnu ka pasal kunga ka pieh ziehin, Pasian in ka law ahing pie hi,” achi hi; tuachiin amin Issakar aphuota hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Leah agai kia a, Jakob dingin tapa a guhna ahinpieh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Leah in, “Pasian in vanken hoitah tah ahing neisah a, tuin tapa guh tah ka nei pieh ziehin ka pasal ka kungah teng taven, achi hi, tuachiin amin Zebulun a phuota hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tua zouin ta numei khat a nei a, amin Dinah aphuo hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Pasian in Rachel a theizinga, a thu ngetna angai khiet pieha, anau bu ahonpieh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n a gaia tapa khat a nei a, “Pasian in simmaw a ka umna hing lahkhiet piehta,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n amin Joseph aphuo hi. “Mangpa’n tapa khat hing belap pieh nalai ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh hichi ahing ahia, Rachel in Joseph anei zouin Jakob in Laban kungah, “Ka umna mun leh gam lam a ka pei theina dingin hing sawl kheta’n achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />‘Na nasep a ka lawdoh ka zite leh ka tate hing pienlen, hing peisah ta in; na nna ka hing seppieh dan lah na thei ngal a,” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Laban in a kungah, “Na mitmu a deisahna katan leh hepitahin khawl tadi in; aziehpen nangma vangin Mangpa’n kei ahing guolzawl chi theina ka nei hi, achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Laban in na law ding guot inlen, hing hil in hing pevang” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Jakob in a kungah, “Na nna ka hing seppieh dan leh ka kunga na ganta bang chium ahiei? chi na thei asiei mah, achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka hing pei masangin tawmnoukhat na nei a, tu’n tampi in a pungta hi. Tualeh Mangpa’n ka hing pei a pat in a hing guolzawl a, hinanleh bangchih chieng in ahiei keima innkuonte dinga ka sep khiet sam ding,” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n aman, “Bang ka hing pe diei?” achi hi, tualeh Jakob in “Bangma hing pe sin, tami na hing bawlpieh ding leh na gan honte vengin ka ching kia ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuni’n na ganhonte kava enkhe dinga, Belam hon lah a avom pawl nah mama te leh avom pawl chiptep leh avom pouma leh Kel lah a akang pawl nah mama te leh apuong pawl chiptepte atuom in ka la kheding a, tualeh tuban tuabanga hing pieng pouma ka law ding ahi ding hi achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n tubansie na mitmu a um ka law tungtang thu a, na hing pei hun chieng in ka dihtatnain ahing dawnpieh mai ding hi. Kel lah a apuong pawl nah mama lou leh apuong pawl chiptep lou leh belam laha, avom lou ka kunga namu teng ka guhin ngaisun maiin achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n Laban in, “Hoi e! na gen bang hita venleh” achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n tuami ni mama in keltal akaanga azing a pawlte leh akaang pawl chiptepte leh kelnu aha-pawl leh akaang a giel chiptepte leh a kaanna um pouma, belam lah a avom zousie toh apui tuom a atapate khutah apie a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh ama leh Jakob kikaal ah nithum lam aum sah a, tualeh Jakob in Laban ganhon um teng ahata hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh Jakob in hieng sing, zuonmuot sing leh sesing tuoite chiengpum dingin ala a, ahaw akhoh ngou chiet a, a chienga angou umte akilang sah hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh achieng haw khawte pen, Tui dawn dinga ahing pei chieng ua, agai thei na ding un, ganhonte tui dawnna kuong leh tui luonna ah, a belamte mazawn ah akoi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuachi’n ganhonte chieng zawn ah a hing gaita ua, a zinga pawlte bang aha pawl mama te bang, apawl chiptepte bang, ahing nei kheta uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tualeh, Jakob in belam noute atuom in a koi a, tualeh ganhonte Laban ganhon lah a, adung pawl leh apuong teng lam angasah a, tualeh ama ganhonte atuom koi zel a, Laban ganhon lah ah akoi sih hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh, hichi ahing hi a, gan hat deute ahing gai pat chieng un, Chieng lah apat agai theina dingun, Jakob in tui luonna ah gantate mu dingin Chiengte akoi zel hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hinanleh ganta zawngkhal deute akoi sih hi, a zawngkhalte Laban a ahia, a hatte Jakob a ahizel hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tuachi’n amapa hatangpi in ahing pungta a, gantate, Suohnute, suohpate, sangawngsaute leh sabiltungte tampi ahing neita hi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh aman, Laban tapaten, “Jakob in ipa nei zousie alah pieh siengta hi. I pa nei leh lam apat a tambang hausatna amu ahi” achi uh azata hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Jakob in Laban maisuo a en a, ngaivawi, tu malam a bangin a tungah ahoi nawn sih, chi a thei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuazouin Mangpa’n Jakob kungah, “Na pu leh pate leh na sanggamte gamlang ah nua peitan, ka hing umpi zing na ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuaziehin Jakob in mi a sawl a, gamlah a ganhon umna ah Rachel leh Leah ava hansah ta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh aman akung uah, “Napa mel ka mu in tu malam bangin ka tungah a hoi nawn sih chi ka thei a, hinanleh ka pa Pasian ka kungah aum zing hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh ka theitawp suoin na pa uh nna ka sep piehta chi na thei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh na pa un hing sol in kalaw sawmvei tah ahing suh lamdang pieha, hinanleh Pasian in ka siet na ding abawl aphal sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A pawl zousie na law ding ahing chi chiengin gan zousie in ha pawl a pawl ahing nei ua, adung pawlte na law ding ahing chi chiengin a dung pawl ahing nei zel uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuabangin Pasian in na pa uh gante lah pieh in kei ahing pie hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh hichi ahing hia, ganhonte ahing gai pat chieng un ka dahtoua ngaivawi, ka mangin belam talte ganhon ha pawl a pawl leh adung pawlte leh apawl chiptepte tunga kikhap ka mu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Pasian vansawlsiengin ka mangin ka kungah, Jakob ahing chia, tualeh keiman, tanah ka um hi ka chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman dahkhien len envawi, ganhonte tunga kikhap belam talte khu adung pawlte, ha pawla pawlte, tualeh apawl chiptepte bang ahi uhi. Tualeh Laban in na tunga abawl zousie ka muta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei khu suongphu sathau na buohkhumna leh ka kunga na kichiemna, tua Bethel Pasian khu ka hi. Tuin kisa inlen tam gam a kipat pei inlen, na pienna gam lamah peikia tain achi hi,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n, Rachel leh Leah in adawng ua, a kungah “Ka pa uh inn ah kouma ding tanvou leh gouluo ding leh gou tanding aum nalai amah?
  </para>
  <para style="p">
    <verse number="15" style="v" />Koute mikhuol bang giap a, hing bawl hilou ahiei mah? A hing zua zouta a, ka man uh zong ane zou siengta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pasian in ka pa ua kipat a tam hausatna alah khiet zousie ei leh i tate a ahi, tuachiin tuin Pasian in na kung a aget pouma bawl in” achi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Jakob akipan khie a, atate leh azite sangawngsau tungah a tuongsah a,
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Kanaan gam a, apa Isaak kunga pei dingin a ganta zousie leh Padan-Aram a kholkhawmte, aneilelam zousie apeipi sieng hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Laban a belam mul met dingin akuonta a, Rachel in a pa milimte aguhpieh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Jakob Siriami Laban theilou kal in aguhin akihem manga, a pei ding thu ahilsih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n anei zousie toh a taimang ta a, tualeh thouin luipi a galkai a, Gilead tanglam zuonin a peita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh ani thum ni’n Jakob a taita chi Laban ahil uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n aman a unaute a zawpi a ni sagi lamtan a nuadel ua, tuachiin Gilead tang ah a phata uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Pasian khu Siriami Laban kungah, zanin a mangin ahing pei a, a kungah, Jakob kungah “Ahoi hi in asie hitaleh bangma genlou dingin pilvangin,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Laban in Jakob a nuaphah ta a. Tuin Jakob in a puon inn tangah a zah touta a, tualeh Laban in zong a unaute toh Gilead singtang gam ah a zah uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Laban in Jakob kungah, “Na silbawl bang chidan ahiei?” ka theilou kaal a na kigelmanga, ka tanute zong namsau galmat banga na puimang mawh?
  </para>
  <para style="p">
    <verse number="27" style="v" />Bang dinga a guh a taimang a, ka kunga kipat a kipahtah leh late, khuongte leh tumging tetoh ka hing hahkhiet theina dinga hing hillou na hiei?
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh ka tapate leh ka tanute ka tawp ding hing phallou na hiei? na nasep a mothuoi seng hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na sietna ding bawl thei ka hia, hinanleh na Pa Pasian in za nitah in ka kungah Jakob kungah ahoi hi in asie hitaleh bangma gen lou dingin pilvangin chiin a hing houpi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh tuin na pa inn na ngai seng zieha pei na hitah lezong, bang dinga ka Milim pasiente na hing guhpieh ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n Jakob in a dawnga, Laban kungah, “Na tanute pauhat thuin hing lahpieh khavateh ka chia, ka zau zieh ahi” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Koi koi hinanleh na milim pasiente na muna pouma hing sih heh, I unaute mitmu a bang ahiei na neisa ka kunga um en chien inlen kilah in achi hi. Tua milim pasiente Rachel in aguh lam Jakob in athei lou zieh in.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Laban in Jakob puon inn leh Leah puon inn leh suohnu nite puon inn ah a lut a, hinanleh amu sih hi. Khumin, Leah puon inn apat peikhie in Rachel puon inn ah alut hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh milimte pen Rachel in analah ahia, sangawngsau van lah ah akoi a ana toukhum a. Tualeh Laban in a puon inn zousie aphele a amusih hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh amanu’n a pa kungah, “Na masanga ka dinkhiet theilou ziehin ka mangpa lung himaw sin, numei ngaina ka nei zieh ahibou hi,” achi hi. Tualeh aman a sui a hinanleh milimte amu zou sih hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuachi’n Jakob a lungthah a, Laban a houseta hi. Jakob in Laban kungah, “Bang e ka gamtat khielna? Ka mawna bang ahiei? tambang va-ia a thangpai a nang nuadel ta lawm?
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka vanteng a un a phele ta chin a, na innsung neitah bang e na mu? Eigel kikaal a thu khensat dingin ka unaute leh na unaute masangah koi in;
  </para>
  <para style="p">
    <verse number="38" style="v" />Kum sawmni vingveng na kungah ka umta a, na belam pite leh na kelpiten nou anei khiel ngai vawtsih hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Gamsa pelupte lah na kunga hing tut lou in, keiman aluongman ka toizel hi. Sun a kigu hi in, zan a kigu hitaleh na hing dinsah zel hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tambangin ka umzing hi, sun a kholum leh zan a khovot in a hing sugenthei mama a, imutna hun zong ka mu ngaisih hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tambangin kum sawmni vingveng na inn ah ka uma, na tanu nite thalaw in kum sawm leh kum li na nna ka sema, na ganta thalaw dingin kum guh na nna ka sema, tualeh kalaw sawm veitah na hing suh lamdang pieh nalai hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka Pa Pasian, Abraham Pasian leh Isaak zauna ka kunga umlou hileh tuin zong saguohin hing sawl khe ngei ngei ding na hi. Pasian in ka genthei thuohna leh ka khut sepgimna amu a, zani zan a ahing phawh ahi” achi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh Laban in a dawnga, Jakob kungah, “Tam tanute pen keima tanu ahi ua, tam naupangte zong keima naupangte ahi uhi. Tam gantate zong keima gantate ahi ua, tualeh na mu zousie zong kei a ngen ahi. Ka tanute tung leh atate uh tungah bang ahiei tunia ka bawlthei ding?
  </para>
  <para style="p">
    <verse number="44" style="v" />Tuaziehin hing pei in tuin, kei leh nang kikaal ah thuhun bawl vaiin tuamipen nang leh kei kikaal a ahing theipitu hisah vai,” achi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tuachi’n Jakob in suong khat ala a, tua suong pen aphutta hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tualeh Jakob in a unaute kungah, “Suong tomkhawm un,” achia, tuachiin suong ala ua, asepvum ua, tua avum ah ann ane uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh Laban in suong kisepvum khu Jegar-Sahadutha achia, hinanleh Jakob in Galeed achi hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tualeh Laban in, “Tam suong kisepvum pen tuni in nang leh kei kikaal a ahing theipi ahi,” achia, tuaziehin amin Galeed a kichi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tualeh Mizpah zong akichi hi. Aziehpen Laban in i kikhen hun chiengin “Mangpa’n kei leh nang hing veng tuoh ta hen.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ka tanute na suh gentheia, ahisihleh ka tanute loungal zi dang na nei leh koima i kungah aum sih, en in, nang leh kei kikaal ah Pasian ahing theipi hiheh” achi hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tuachi’n Laban in Jakob kungah, “Nang leh kei kikaal a ka suong sevum en inlen suong kiphut en in, achi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Sietna bawl dingin tam suong sevum kanin nang lam ah hing galkai sih vangin, nangzong tam suong sevum leh tam suongphu na hing galkai lou ding ahi, achi hi. Tam suong sevum atheipi ahia, tam suong phuzong ahing theipi ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham Pasian leh Nahor Pasian, apa uh Pasian in i kikaal ah thu khenta heh” achi hi, tualeh Jakob in apa Isaak in a giin, Pasian min lou in akichiem ta hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tuachi’n Jakob in muol tungah kithoina a bawl a, a unaute ann ne dingin ahan hi. Tuachi’n ane ua, zankhuo in taang tungah a giehta uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tualeh zingmawng matah in Laban a thou a, a tapate leh a tanute a tawpa a guolzawl hi. Tuachi’n Laban a peita a, a umna mun ah ahing tung kiata hi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Jakob apei zel a, Pasian vansawlsiengten ana lamdot uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Jakob in amauh amu tahin, tamte pen “Pasian galkapte ahi uh,” achi a tuachiin tuami mun khu Mahanaim achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Jakob in Seir gam a Edom langa a upa Esau kungah thangkou asawl masa hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh akung uah, “Ka mangpa Esau kungah tambangin vagen un, na suoh Jakob in tambangin agen hi, Laban kungah mikhuol in kava um a, tudongin ka um hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bawngtalte, sabiltungte gan honte leh suohnute leh suohpate ka nei hi. Tuachi’n na mitmu a hepina ka mu theina dingin, ka mangpa hil dinga mi ka hing sawl ahi,’’ chi in vagen un, chiin amauh thu apie hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n thangkoute Jakob kungah, “Ahing kile kia ua, na upa Esau kung kava tung ua, amazong pasal zali toh nang lamtuo dingin ahing pei hi” achi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Jakob azau seng senga, a lungkhamta hi. Tuachi’n a kunga mipi umte, Belam honte, Bawngtalte leh Sangawngsaute pawl ni in a khena.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh “Esau pawlkhat kung a ahing pei a, a tha taah a ahileh a pawldang pen a suohta ding” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Jakob in, “Aw! Ka pa Abraham Pasian leh ka pa Isaak Pasian, ka kunga, ‘na gamlam leh na tanaute kungah pei kia inlen, hoitahin hing bawl vang chipa Mangpa.’
  </para>
  <para style="p">
    <verse number="10" style="v" />Na suoh tunga na latsah hepinate lah leh thutahte lah a a neupen zong tangtah ka hisih, ka chiengkhut toh tam Jordan gal ka kaia, tuin pawl ni ka hita uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hepitahin ka upa khut apat, Esau khut apat, in hing hundohin, numei naupang puma ahing na tha khah ding ka zau hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh nangman, hoitahin ka hing bawl dinga nahah nasuonte Tuipi a pieunel sim senglou bangin bawl vang na chi hi,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n khum zan in khum munah a gieha, tualeh aneitah laha pat a upa Esau nuomman ding alakhie a;
  </para>
  <para style="p">
    <verse number="14" style="v" />Kelpi za ni, keltal sawmni; Belampi za ni leh Belamtal sawmni toh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sangawngsau nawi suhlai sawmthum leh anoute toh, Bawngpi sawm leh Bawngtal sawmni, Sabiltungpi sawmni leh Sabiltungnou sawm;
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n tuate atuom chiet in asuohte khutah a kemsah a, asuohte kungah, “Ka masang ah pei galkai unlen, pawl chin akaal umsah zel un” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh aman amasapen kungah, “Ka upa Esau in ahing kituohpi a, na kunga koi na hiei? heia haw ding na hiei? Tualeh na masanga umte koite ahi uoi? chia ahing doh leh;
  </para>
  <para style="p">
    <verse number="18" style="v" />A kungah, na suoh Jakob a ahi uh, ka mangpa Esau kunga nuomman a apieh dinga ahing hah ahi; tualeh ngai in, ama zong ka nua uah aum hi, na chi ding hi,” chi in thu apie hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh aman a nina leh athumna leh ganhon hawlte zousie kungah, “Esau na mu chieng un hichibang main na chi ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh ngaivawi, na suoh Jakob ka nua uah aum hi chi chiet un chi’n thu apechiet hi. Aman “Nuomnante ka masangah pei leh a lung ka damsah dinga, tuazou chiengin amel mu vang, tuachi’n ana hing kipahpi khamaw sih ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n nuomman khu a masangah apei galkai sah a, amapen tua zan in apawlte lah ah agieh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh zan in a thou a, a zi tegel leh a suohte ni leh a tapa sawm leh khatte puiin Jabbok luita kaina ah a kaipi ta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh amauh a zawpi a, lui agalkai sah a, anei zousie zong agal kaisah hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n Jakob amatangin aumta a, tualeh mi khat in phalvah dongin a kibuonpi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh azou sih chi akithei in, akhelpi gu kituona atham pieha, tuachiin akibuon laiun Jakob khelpi gutuona akilawi ta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Aman “Hing ha in, khuo vah ding ahita,” achia, Jakob in “Na hing guolzawl masangsie hing ha vawt sihvang” achi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Aman a kungah, “Na min bang e?” achi hi, Aman “Jakob” achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Aman, “Na min Jakob kichi nawn sih vanin, Israel ahing kichi tading hi. Nangman Pasian leh mihing na buona, na zouta hi” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Jakob in, “Hepitahin na min hinghil vawi” chi in a donga, Aman “Bang zieh a ka min na hing doh ahiei?” achi a, tuachiin tuamun ah ama aguolzawl ta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Jakob in tuamun min Peniel achita hi. “Pasian kimaituo in ka mu a, ka hinna ahing khawipieh nahlai ziehin,” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh Penuel a galkai lai in nisa in ama ahing khawta a, a khelpi ziehin abaita hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuaziehin tuni dongin Israel taten malpi gu kituona a sa pangpan um ane ngaisih uhi. Jakob malpi gu tuo a, a pangpan laitah akhoi pieh ziehin.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Jakob in dahtou a a-et leh ngaivawi, Esau khu pasal zali toh ahing pei hi. Tuachi’n aman atate khu Leah leh Rachel leh a suohnu nite kungah ahawm khen a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh suohnute leh atate uh amasapen in akoi a, Leah leh atate a ban ah akoi a, tualeh Rachel leh Joseph anukhiapen ah a koi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n ama khu amasang uah apei a, a upa kung atun masangin sagi vei tuol suin a bawhkhup hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Esau khu ana lamtuo dingin a tai a, a poma a ngawngkawi a atawpta hi. Tuachi’n ani un akap tuohta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachia Esau adah leh numeite leh naupangte amu a, “Na kunga umte koite ahiei?” achi hi, aman “Pasian in hepina toh na suoh ahing pieh naupangte ahi uhi” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n suohnute khu atate utoh ahing pei ua, kunin chibai abuh uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Leah zong atate utoh ahing pei nai ua, kunin chibai abuh ua, tuazou in Joseph leh Rachel ahing pei ua kunin chibai abuh uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Esau in a kungah, “Ganhon ka hing kituohpi tengpi bang chidan ahiei?” achi hi, aman, “Tamte ka mangpa mitmu a hepina ka mu theina ding ahi.” Achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh Esau in a kungah, “Nau aw, kenzong kichingtah in ka neina hi, nanei zousie nanga hizaw heh” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh, Jakob in, “Hilou e, na mitmu a hepina ka mu leh hepitahin ka nuomman hing piehte hing sanpieh in, aziehpen Pasian mel mu bangin na mai ka mu a, ka tungah lah na kipah ngal a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pasian in ahing khotuo ziehin hunkhop tahpi ka nei a, ka guolzawlna don, ka hing puohte hing sanpieh in chiin ka hing ngen ahi, achi a,” tualeh azawl paupau ziehin alata hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Esau in, “Kisa’n pei vaiin, keiman ma kai vangin zawhkhawm vai,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh Jakob in a kungah, “Naupangte aneu seng nalai uh chileh belam hon leh bawngnou hat nailoute ka kungah aum uhi, chi ka mangpa’n na thei hi achi hi, ni khat maimai zong hattah a akihawl leh ganhon zousie ashi sieng ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hepitahin ka mangpa, na suohpa masangah pei inlen, tualeh Seir taanga ka mangpa kung ka hing tun masang sien, ka masanga pei ganhonte leh naupangte ahi thei dan danin awlnou nouin hing zawpi vang” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Esau in, “Tuin ka kunga um mi khenkhatte beeh hing nuasie lenglah,” achi hi. Hinanleh aman, “Bang ngaise ding e? Ka mangpa mitmu in hepina hing musah mai vawi?” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Esau khu tuami ni in Seir tanglam zuonin akia kiata hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Jakob pen Sukkoth zuonin a pei a, ama dingin inn khat aki lam a, agantate dingin buh khat alampieh hi. Tuaziehin khum mun khu Sukkoth akichi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Jakob Padan-Aram gam a kipat ahing pei a, Kanaan gam a um Shekem khopi ah damtahin ahing tunga, apuon-inn khopi mazon ah azahta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Shekem pa Hamor tate khut apat gam neunou khat Dangka za khat in a lei a, tuanah apuoninn azahta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n khum munah maitam khat adaw a, amin El-elohe Israel aphuo hi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Leah in Jakob toh ahinpieh atanu Dinnah, khum gam a nungahte en dingin a pawtkhie a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh tuagam Lengpa Hivmi Hamor tapa Shekem in ana mu a, aman a luppi a abuasah ta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh aman Jakob tanu Dinnah khu alunggul vevaw a, angai seng manin kamsiem tahin ahoupi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Shekem in apa Hamor kungah, “Tam nungah ka zi dingin hing lah pieh in” achi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Jakob in atanu Dinnah, Shekem in abuasah chi aza a, tua hun laiin a tapate gamlah ah ganta toh aum ua, tuachiin amauh hing tun masangsie, Jakob asip khinkhian hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Shekem pa Hamor khu Jakob kihoupi dingin a kungah a hing pei a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Jakob taten tam thu azah tah un, gam lah apat ahing pei ua, tualeh Jakob tanu luppi a, Israelte lah a sil gilou mot-huoi, bawl vawt lou ding sil abawl ziehin a lunggim ua, a thangpai mama uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hinanleh Hamor in amaute ahoupi a, a kung uah “Ka tapa Shekem in na tanu alunggul vevaw a, hepitahin azi dingin hing pie un” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh zi leh ta in kiteng tua va ui, na tanute uh hing pie unlen, kou tanute zong la un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n kou toh na tengkhawm ding ua, gam zong ahing kihawm pieh dinga, summet bawl unlen tanah kikhuol ta un, nei leh lam khol in teng un,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Shekem in a nungahpa leh asanggampate kungah, “Hing hepi unlen, ka kunga na gen pouma uh hing pevang achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Manlemuol leh silpieh na hing nget nuom zaza uh ngen unlen, ka kunga na genbang bangun hing pevang, hinanleh nungah pen ka zi dingin hing pie un” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hinanleh Jakob taten asanggamnu uh Dinnah abuasah ziehin Shekem leh apa Hamor sol bawlna toh adawng ua, thu agen uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh amaun akung uah, “Tam sil, teptanlou mi kunga ka naunu uh pieh pen bawl thei sih va ung, aziehpen kou dinga min sietna ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hinanleh tambanga na bawl u’leh lem ka sa ding uhi, nalah ua pasal teng a tep na tan ua, kou banga na um u’leh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n ka tanute uh hing pe va ungin, kon zong na tanute uh lava ungin, tuachi’n nou toh ka tengkhawm ding ua, chikhat ihita ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinanleh teptan ding thu a ka thu uh na zui sih ding u’leh ka tanu uh zawpi va-ungin, pei mai va-ung,” achi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh a thugen un Hamor leh Hamor tapa Shekem akipah sah hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n atangval pan Jakob tanu adei seng ziehin, ni sawt hallouin tua sil abawlta hi. Amapen apa innkuonpite zousie sanga mite zatat pen ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Hamor leh atapa Shekem khu akhopi kul Kotpi ah ahing pei ua, a khopi mite toh akihou lim ua akung uah.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Tam mite eite toh kilemtah in aum uhi, tuaziehin tami gamah teng uhen len, tam gam sungah summet bawl uhen, ngaivawi un, ama ua dingin gam alien hun mama hi. A tanute uh zi dingin la vaiin, amaute zong i tanute uh pevai, achi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tam mite toh kilemtah a tengkhawm a, chi khat namkhat ihi theina ding aum hi. Amaute teptan ahi bangun, pasal zousie teptan hilei.
  </para>
  <para style="p">
    <verse number="23" style="v" />A gamte uh anei alamte uh, aganta khoite zousie uh eite a hing himai lou ding amah? A thu uh lemsahpi vaiin, ikung uah a teng maiding uhi” achi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Hamor leh atapa Shekem thu khu Kulkot a pawt zousien a za ua, a khopi kul kotpi a pawt pasal zousie tep atanpieh ta uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh, ni thum niin, hichi ahing hi a, a nat laitah un Jakob tate ni Simeon leh Levi, Dinnah sanggamten a namsau uh aman ua, hangsan tahin khopi ahing bulu ua, pasal zousie athat siengta uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh amaun, Hamor leh atapa Shekem khu namsau hiemin a that ua, Shekem inn apat Dinnah apuikhie ua, a peita uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Jakob tapaten ami thate uh ava tun khum ua, asanggamnu uh kisuh buana khopi asimta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A belamte, uh, a bawngtalte uh, asabiltungte uh khopi sunga sil umte pouma leh alou ua sil um poumate alah pieh uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh anei alam zousie uh, a taneute uh leh a zite uh sal in aman ua, innsunga um pouma atomgam pieh ta uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Jakob in Simeon leh Levi kungah, “Tam gam a umte lah a Kanaanmite leh Periz mite lah ah huot nang lawsah ua, nang lunggim sah seng uhi. Kei tawmnou khat ka hi ziehin ang dou dingin hing kikhawm va un, ahing that ding ua, ahing sumangthai ding uhi, kei leh ka innkuonpite toh,” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh amaun, “Ka sanggamnu uh kizua banga abawl ding uh ahiei mah?” achi uhi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Pasian in Jakob kungah, “Kisa inlen Bethel ah peitou inlen, tuanah tengin. Tualeh khunah na upa Esau kunga kipat a na taimang lai a, na kunga kilah Pasian a dingin maitam bawl in,” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob in a innkuonpite kung leh a kunga um zousie kungah, “Na lah ua gamdang pasien umte paimang unlen, kisusiengthou unlen, tualeh na puon sil uh heng un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n kisa vai in, Bethel ah peitou vai, tuanah ka lungdon lai a hing dawngpa leh ka pei peina lam a ka kunga um ngitnget Pasian a dingin maitam bawl vang” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n amaun Jakob kungah, a khut ua um gamdang pasien zousie leh abil ua aba uh bilba zousie Jakob kungah apie ua, Jakob in tuate zousie Shekem kunga um gangpi phung nuoiah a phuolta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh apei zel ua Pasian giinna khu akimvel ua khopite tungah aum a, Jakob tapate adelzui sih uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Jakob Kanaan gam a um Luz khuo ahing tunga, tuakhu Bethel ahi, ama leh akunga um zousie toh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh khunah maitam a bawl a, a sanggampa masanga kipat ataimang lai a Pasian akunga akilah ziehin khummun min El-Bethel aphuo hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Rebekah donnu, Deborah ashi a Bethel nuoi a gangpi sing nuoi ah avui ua, tua gangpi sing min khu Allon-Bakuth akichi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Jakob Padan-Aram gam a kipat ahing peidoh laiin, Pasian a kungah akilah kia a, tualeh ama aguolzawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh Pasian in a kungah, “Na min Jakob ahi a, na min Jakob kichi nawnsih vanin, Israel ahizaw ta ding achi hi,” tuachiin amin Israel achita hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Pasian in a kungah “Kei Pasian bangkimbawlthei ka hi, chi tampi suongin hing pung inlen, genkham ching nam tampi leh nam tuomtuom nanga kipat hing um vanin, tualeh nangma tahsa akipat leengte zong ahing umdoh ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Abraham leh Isaak kunga ka pieh gam khu nangma kungah hing pevangin, tualeh na nua a nahah nasuonte kungah gam khu pe zel vang,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n Pasian in ama a houpina mun akipat apeitou santa hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Jakob in ama ahoupi na munah khuom khat a phuta, tua suong khuom tungah dawn ding sillat a sunga sathau a sun khum hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Jakob in, Pasian in ama a houpina mun khu Bethel achi ta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Bethel apat apei zel ua, Ephrath tunna ding gamla simtah ahi nalai hi. Tuachi’n Rachel in nau a vei a, a gim mama ta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh hichi ahing hi a, agim mama laitahin naudomnu in a kungah “Zau vawtsin, tapa dang nei ding na hi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh hichi ahing ahia, a hagau aha ding kuonin (a shita a) amin Ben-oni a phuo a, hinanleh apan Benjamin chiin ahan hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n Rachel a shita a, Ephrath lampi ah avuita ua, Tuapen Bethlehem ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Jakob in ahan tungah khuom a phuta, tuakhu tuni dongin Rachel han suongphu ahi zing hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Israel khu apei zel a, Migdol Eder inn sang gal lam ah a puon inn azah hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh hichi ahing ahi a, Israel khum gam a aten laiin, Reuben in apa meinu Bilhah ava luppi a, tuakhu Israel in athei ta hi. Tuachi’n Jakob tapate sawm leh ni ahi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leah tapate Reuben, Jakob ta masapen leh Simeon, Levi, Juda, Issakar leh Zebulun.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rachel tapate Joseph leh Benjamin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rachel suohnu Bilhah tapate Dan leh Naphtali.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Leah suohnu Zilpah tapate, Gad leh Asher; tamte pen Jakob tapate Padan-Aram gam a aneite ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Jakob khu Abraham leh Isaak umna Kirjath-Arba khum khu Hebron ahi, Mamre ah apa Isaak kung ahing tungta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuin Isaak damsung kum za leh kum sawmgiet ahita hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Isaak upa vuoikawn vawt a damin ashita hi. A chipite kunga pui in aumta, a tapate Esau leh Jakob in avuita uhi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh tamte Esau (Edom kichipa) hahlesuonte ahi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esau in Kanaan gam a nungahte zi in anei hi. Hitmi Elon tanu Adah leh Hivmi Zibeon tanu, Anah tanu Aholibamah leh,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ishamael tanu Nebaioth sanggamnu, Basemath ahi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Adah in Esau dingin Eliphaz ahin pieh a, Basemath in Reuel ahing hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Aholibamah in Jeush leh Jaalam leh Korah ahing hi. Tamte pen Esau tapate Kanaan gam a aneite ahi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n Esau in a zite, a tapate a tanute a innsung mi zousie leh a gantate zousie, tualeh Kanaan gam a a sum lamdoh zousie puoin a naupa Jakob apat in gamdang ah apeita hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anei a lamte uh a tam seng ziehin a tengkhawm thei sih uhi. Tualeh ganta a hau seng zieh un mi khuol ahina gam un adawl zou tasih uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Esau khu Seir taangah a tengta hi. (Esau pen Edom ahi)
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh tamte Seir taanga Edom mite pa Esau hahlesuonte ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tamte Esau tapate min ahi; Esau zi Adah tapa Eliphaz leh Esau zi Basemath tapa Reuel.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Eliphaz tapate, min Teman, Omar, Zepho, Gatam leh Kenos ahi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Timna khu Esau tapa Eliphaz meinu ahia, aman Eliphaz dingin Amalek ahinpieh hi. Tamte Esau zi Adah tate ahi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh tamte Reuel tapate ahi uhi, Nahath, Zerah, Shammah leh Mizzah, tamte Esau zi Basemath tapate ahi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh tamte Esau zi Zibeon tanu Anah tanu Aholibamah tapate ahi uh, Aman Esau dingin Jeush, Jaalam leh Korah ahinpieh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tamte Esau tapate laha a lamkaite ahi uhi; Esau tamasapen Eliphaz tapate, Eliphaz tapate lamkai Teman, lamkai Zepho, lamkai Kanaz.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lamkai Korah, Lamkai Gatam, tualeh lamkai Amalek, tamte Edom gam a Eliphaz akipat hing piengkhie lamkaite ahi uhi; tamte Adah tapate ahi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh tamte pen Esau tapa Reuel tapate ahi uhi, lamkai Nahath, lamkai Zerah, lamkai shammah, lamkai Mizzah, tamte Edom gam a Reuel akipat hing pawtkhie lamkaite ahi uhi. Tamte Esau zi Basemath tapate ahi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh tamte Esau zi Aholibamah tapate ahi uhi. Lamkai Jeush, lamkai Jaalam, lamkai Korah, tamte Esau zi Anah tanu Aholibamah akipat a hing piengte ahi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tamte Edom kichi Esau tapate ahi ua, tualeh tamte a lamkaite ahi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tamte tua gam a teng Hormi Seir tapate ahi uhi. Loton, Shobal, Zibeon, Anah leh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dishon Ezer leh Dishan, tamte Edom gam a Seir tapate Hormite lamkai ahi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Lotan tapate Hori leh Hemam ahi uh. Lotan sanggamnu Timna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh tamte Shobal tapate ahi uhi. Alvan Manahath; Ebal, Shepho leh Onam.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh tamte Zibeon tate ahi, Ajah leh Anah, tam Anah khu gamdai a apa Sabiltungte achin laia, gamdaia tuisa pulna luikhuh mukhepa ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh Anah tate tamte ahi; Dishon leh Anah tanu Aholibamah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh tamte Dishon tate ahi uh, Hemdam, Eshbon, Ithran leh Cheran.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ezer tate tamte ahi uh, Bilhan, Zaavan leh Akan.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dishan tate tamte ahi, Uz leh Aran.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tamte Hormite akipat hing pawt lamkaite ahi uh, lamkai Lotan, lamkai Shobal, lamkai Zibeon, lamkai Anah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lamkai Dishon, lamkai Ezar, lamkai Dishan tamte Seir gam a hing pawt Hormite lamkaite ahi uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh tamte Israel tate tunga leeng koiman vai ahawm masanga, Edom gam a vaihawm leengte ahi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Beor tapa Bela in Edom gamah vai ahawm a, a khopi min Dinhabah ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Bela ashi bepin Bozrah khuo a um Zerah tapa Jobab in vai ahawm hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Jobab ashi bepin Teman gam a mi Husham in a taangin vai ahawm hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh Husham ashi bepin Moab gamlah a Midian thatpa, Bedad tapa Hadad in a taangin vai ahawm hi; a khopi min Avir ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh Hadad ashi bepin Masrekah a um samlah in a taangin vai ahawm hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tualeh samlah ashi bepin, luipi gei a teng Rehoboth a um Shaul in a taangin vai ahawm hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh Shaul ashi bepin Akbor tapa Baalhanan in a taangin vai ahawm hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tualeh Akbor tapa Baalhanan ashi bepin Hadar in a taang in vai ahawm hi. A khopi min Pau ahi, tualeh azi min Mehetabel, Mezahah tanu Matred tanu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tualeh tamte a innkuon u’leh a khomun u’leh amin uh dungzui a, Esau akipat hing pawt lamkaite minte ahi; Lamkai Timna lamkai Alvah, lamkai Jetheth.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lamkai Aholibamah, lamkai Elah, lamkai Pinon.
  </para>
  <para style="p">
    <verse number="42" style="v" />Lamkai Kenaz, lamkai Teman, lamkai Mibzan.
  </para>
  <para style="p">
    <verse number="43" style="v" />Lamkai Magdiel, lamkai Irom, tamte agam neina sung ua a umna uh dungzui a, Edom lamkaite ahi uhi, amapen Edom mite pa Esau ahi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Jakob khu apa mikhuol hina gam, Kanaan gamah atengta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tamte Jakob hah leh suonte ahi uhi, Joseph in kum sawm leh sagi ahi in, a ute toh ganhon aching ua, tam valnou pen apa zite Bilhah tapate leh Zilpah tapate toh a umkhawm uhi. Tualeh Joseph in a gitlouna uh apa kungah ahing tun zel hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh Israel in Joseph khu ateh nua-a ata ahi ziehin ata dangte sangin a it zaw hi. Tuachi’n Puon ah tuol ze tuom tuom a pawl khat abawl pieh hi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh apa un amapen a ute dang teng sangin a it zaw chi amaun a theitah un, ama amuda ua a kungah kampha mawngmawng a houpi aum sih uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Joseph in mang anei a, tuami a ute a hil a, tuachi’n amaun amuda deu deu ta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n aman akung uah, “Hepitahin ta kamang thu ngaivawi un, achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngaiun, lou ah buphai ina kaan ua, tualeh ngaivawi un, kei buphai ahing thou a, ahing ding hi. Tuachi’n ngaivawi un, nou buphaite khu akimvel ah ading ua, kei buphai chibai bawl in akhupboh uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh a uten a kungah, “Nangin ih ka tung ua vai na hawm phuat ding? Ahisihleh nang ih ka tung ua thunei phuat ding?” Achi ua, tuachi’n ama mang zieh leh a thugente ziehin amuda deu deuta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n aman mang dang khat anei kia a, tuami a ute ahil kia a, “Ngai un, mang dang khat kaman kia hi. Ni leh Ha leh aasi sawm leh khat ten chibai ahing buh ua, abohkhup uhi” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n aman tam thute apa leh a ute a hil a, tualeh apa’n aphawh a, a kungah, “Bang mang na mat valong ahiei? Kei leh na nu leh na ute na masanga lei a khupboh in chibai kang bawl talawm ding uh amah?” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n a uten ama athangsiet ua, hinanleh a pa’n athugente alungsim ah a vom zing hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh a ute, apa uh ganhonte ching dingin Shekem ah apei uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Israel in Joseph kungah, “Na uten Shekem gamah ganhon ching hilou uh ahiei mah? Hing peivawi, a kung uah hing sawl vang,” achi hi, tuachiin aman “Tanah um inge,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n aman a kungah, “Hepitahin pei inlen, na ute leh aganhonte uh adamna uoi mah va en inlen, tualeh athu hinghil kia in” achi hi. Tuachi’n ama khu Hebron phaiguom akipat in apei a Shekem avatung hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n koi ahiei mi khat in gamlah a vah kawikawi amu a, tualeh tua mipan a kungah, “Bang ahiei na sui” chi’n a dong hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n aman, “Ka ute sui ka hi, heitah ahiei aganhon chinna uh hinghil in” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua mipan, “Tana patin apawt kheta uhi. Dothan ah peivai akichi uh kaza hi,” achi hi. Tuachi’n Joseph in a ute anuadel a, ava muta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh amaun gamlapi apat in ana galmu ua, akung nai uh ahing tun masangin, ama tha ding thu ana phiel ta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n amauh khat leh khat kikumin, “En un, mang neipa hing pei e.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuaziehin hing pei un, that vaiin kokhuh sung khat ah khe vaiin, gamsa gilou in aneta chimai vai, tuachi’n amangte bang ahing suoh eimah envai?” akichi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh Reuben in tam thu aza a, akhut ua pat a hunkhie a, “That talawm sih vai,” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Reuben in akhut uapat a hunkhie a, apa uh kunga anuapei kia theina dingin, akung uah, “Sisan vang suo sih un, gamlah a guomkuoh sungah khie un, a tungah khut havawt sih un” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n hichi ahing hia, Joseph a ute kunga ahing tunin, amaun Joseph in puonahtuol zetuom tuom a pawl asil khu asutpieh ua.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n apui ua, kokhuh sung khat ah akhie uhi. Tua kokhuh khu aguoh ahia, tui aumsih hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh ann ne dingin atou ua, tualeh dahdoh in a en ua, tualeh ngaivawi, Ishmael mite pawl khat Gilead gam akipat a sangawngsau ua gimtuite, Singnai damdawite leh murrahte puo a Izipt gam a peisuh dingte ahing pei uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Juda in a unaute kungah “I naupa uh that in imlei bang e aphattuom na ding?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hing peiun, Ishmael mite kungah zua vaiin, tualeh a tungah khut hasih vai, ama lah i naupa uh, i tahsa vawt ahi thuoi a,” achi hi. Tuachi’n anauten a thukimpi ta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Midianmi summet bawlte ahing pei ua, Kokhuh apat in Joseph alakhie ua, Ishmael mite kungah Dangka sawmni in azuata uhi. Tualeh amaun Joseph pen Izipt gamah atutta uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Reuben khu kokhuh ah ahing pei kia a, tualeh ngaiun, kokhuh sungah Joseph ana umta sih hi. Tuachi’n aman a puonahte abotkeh ta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh a sanggamte kungah ahing kile kia a, “I nau lah aum nawn sin, kei heisung suding kata diei?” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n amaun Joseph puonah tuol ala ua, kelnou khat athat ua, apuonah tuol khu sisan lah ah adie uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n puonah tuol zetuom tuom a pawl ahah ua, apa uh kung ahing tut ua, “Tami maimai ka mu uhi, na tapa puonah tuol ahi nai? ahi siei? en in” achi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh aman athei pai a, “Tampen ka tapa puonah tuol hina, gamsa gilou khat in a neh hitaven maw, Joseph zong bawtel gawpa um hitaven maw?” achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh Jakob in a puon sillaite abotkeh a, akawng ah la-ip puon a tenga, a tapa ni tampi asuun hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh a tapate leh a tanute zousie ama henem dingin ahing pei ua, hinanleh amapa henem ding anuom sih a, kap kawmin akung uah “Kei zong ka tapa kungah han ah, lunggim pumin ka peisuh ding,” achi hi. Tambangin apa’n ama akaa hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuachi’n midianten Joseph khu Izipt gamah Pharoah nuoia milien Potiphar, veng pawlte lamkaipa kungah azuata uhi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuahun laiin hichi ahing hi a, Juda khu a unaute kung apat apeisuh a amin Hirah kichi Adullam mi khat avabel ta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Juda in tua muna Kanaan mi amin Shuoh kichipa tanu khat amu a, a kitenpi ta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n amanu’n nau a pai a, tapa a nei a, apa’n amin Er aphuo hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh agai kia a tapa khat anei kia a, amanu’n amin Onan ahisah hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh agai kia zel a, tapa khat anei kia a, amin Shelah ahisah hi. Amapa anei lai in, Juda Kezib a um ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Juda in atapa masa Er dingin zi alah pieh a, amanu min Tamar ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Juda tamasa Er khu Mangpa mitmu in agilou a, tuachi’n Mangpa’n athat ta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Juda in Onan kungah, “Na upa zi pawl inlen, kitenpi in, achi hi. Tualeh na upa dingin hahlesuon nei piehin” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinanleh Onan in hahlesuon pen ama a ding ahisih chi athei a, tualeh hichi ahing hi a, a upa zi apawl chiengin a upa dinga hahlesuon aum louna dingin leiah akesah zel hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh tuabanga asil bawl in, Mangpa alungdam sah tasih a, tuaziehin ama zong athat ta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Juda in amounu Tamar kungah, “Ka tapa Shelah pichin masang sien na pa inn ah meithai in va umtadi in” achi hi; tua ahisihleh ama zong a ute bangin hing shi khava achi zieh ahi. Tuachi’n, Tamar a pei a apa inn ah atengta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh hun hing pei zel in, Juda zi Shuoh tanu ahing shita a, Juda in a-it angaina athen bepin, Timnah khuo a abelam mul heute kungah a lawmpa Adullam mi Hirah toh ahawta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Tamar kungah “En in, na innpipa a Belam mul heu dingin Timnah khuo ah peitou ding ahi,” chiin ahil ua.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh aman ameithai puonte a koikhie a, kikhuna puona kikhuin amel kitheilouna dingin akituom a, tuachiin Timnah khuo lampi a Enaim kotpi lutna lampi gei mun awng khat ah ana touta hi. Aziehpen Shelah zong apiching ahita ngal a, a zi dingin amanu akipsih chi athei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Juda in amanu amu tahin kizuami hi dingin a ngaituo a, amai akikhu ziehin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n lamgei a numeinu kungah akihei a, “Hepitahin hing peivawi, lum khawm vai” achi a, (aman amounu ahilam athei sih hi.) Tuachi’n amanu’n “Nahing luppi man bang na hing pe diei?” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh aman “Ganhonte lah a kelnou khat hing hah vang” achi hi, tualeh amanu’n “Tuami nang hah masangin ka kep ding kichiemna khat hing pelou ding na mah?” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh aman, “Na kep ding bang kichiemna kahing pe diei?” achi hi. Amanu’n “Na min namna leh na tau leh na khut a na chieng tawi,” achi hi. Tuachi’n apie a, aluppi a nau avopsah ta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n amanu ading khie a, apeita hi; tualeh amai khuna puon ahawhkhie a, meithai hina puon asilta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Juda in numeinu a sil kepsahte amu kia theina dingin a lawmpa Adullam mi khut ah kelnou ahah a, hinanleh amanu amu zou tasih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh aman “Enaim gawlzing gei a tou a kizuanu heia um atai?” chiin tuamun a mi umte kungah a donga, tualeh amauten “Tamnah kizua koima um ngaisih” achi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh ama khu Juda kungah ahing kilekia a, amanu muzou sing. Tualeh khuna miten zong “Tanah kizua aum ngaisih achi uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n Juda in “Neiden mai heh, tuachilou invang zala khavai, Ngaivawi, tam kelnou ka hah a, amanu lah vamu zoulou chin a,” achi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh ha thum ding nuain, hichi ahing hia, Juda kungah, “Na mounu Tamar akizua hi,” tualeh “Ngai in, zawlta apaita hi chiin ava hilta uhi.’ Tuachi’n Juda in hing puikhie unlen hallup in um heh” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh ahing puidoh tah un, Tamar in “Tam silte neipa apat ahi nau ka pai chiin a innpipa kungah mi a sawl a,” tualeh amanu mama in “Tam silte, min namnate, taute leh chiengkhutte koi a ahiei? hepitahin enchien un,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Juda in ama-a ahi chi atheikhie a, “Kei sangin ama adihtat zaw hi, amanu ka tapa Shelah kunga kapieh lou ziehin” achi hi; tuachiin aluppi ngai nawn tasih hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh anauvei hun ahing tuntahin hichi ahi a, Ngai vawi, anaubu ah naupeng a um hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh hichi ahing hi a, anauvei laiin khatpa’n akhut ahing hadoh a, tualeh naudom nu’n akhut ah khausan khat akhi a “Tami ahing pawt masa ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh hichi ahing hi a, akhut anualah lut laiin, Ngai vawi, anaupa ahing pawtdohta hi. Tuachi’n naudomnu’n “Bang ding a pawtna ding kibawl na hiei? Tami bawsietna na tungah um heh,” achi a, tuaziehin amin Perez aphuo uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anuain a upa, akhut a khausan kikhi pen ahing pawt a, amin Zerah aphuo uhi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Joseph khu Izipt gamah apui suh ua, Pharoah nuoi a milien veng pawlte lamkai, Izipt mi Potiphar in khuna hing puisuh Ishmael mite khut apat in aleita hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Mangpa’n Joseph aumpi a, tuachi’n mi lawching tah ahia, apu Izipt mi inn ah aum hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh apu’n Mangpa’n ama aumpi a, asil bawl pouma ah Mangpa’n akhut ah a lawching sah chi a thei a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Joseph in apu mitmu in hepina a tanga, ana asep pieh hi. Tuachi’n aman a innsung mite tungah vaisai in apangsah a, anei zousie a khutah a unin a koi sieng hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n innsunga vaisai a akoi akipat tambang ahing hi a, Mangpa’n Izipt mi innsung, Joseph zal in a guolzawl ta hi. Inn leh gam a anei zousie tungah Mangpa guolzawlna aum hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n aman anei zousie a unin Joseph khutah a koia, tuachiin ann neh chilou anei zousie bangma theiphah anei sih hi. Tualeh Joseph mi melhoi mama leh etlawm tah ahia.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh tamte zouin hichi ahing hi a, apu zi in Joseph a dei et a, tuachiin “Hing luppi in” achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hinanleh ama a ut sih a, apu zi kungah “En in, ka puin tam innsung ah, ka kungah bang aum ei chi athei vateh sih hi, anei zousie a unin ka khutah ahing kemsah hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tam inn sungah keisanga lienzaw koima aum sih hi; a zi na hi ziehin nang chilou kei a dingin bangma it anei sih hi. Tuaziehin bang dingin tambang mawna lienpi bawl in, Pasian tungah sil gilou bawl in ka khiel thei diei?” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n hichi ahing ahia, ni chinin Joseph zawl nanleh ama luppi thu leh ama toh umkhawm lam thu ah a ngaisah nuom vawtsih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hinanleh tua hun laiin hichi ahing hia, a nasem dingin Joseph khu inn sungah ava lut a, tualeh inn sungah mi mawngmawng koima aum sih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh amanu’n a puonsil in ana man a, “Hing luppi in” a chi hi. Tualeh aman a khutah a puonsil a nuasie a, a taisanta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh hichi ahing hi a, a puonsil a khutah nuasiein ataikhie chi amutahin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanu’n a inn a mite a han a, a kung uah, “Envawi un, hing zumsah dinga Hebrumi khat i kung ua hing puilut ahita khula, hing luppi tumin ka kungah ahing lut a, tuachiin aw ngaitahin ka kikou ta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh hichi ahing hi a, aw ngaitah a ka kikou azah tahin a puonsil ka kungah nuasie in a taidohta hi” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh apu inn ahing tun masangsie’n a puonsil a kungah ana koi den hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n akungah tambangin agen a, “Hebru suoh i kunga na hing puiin hing suhzalat tumin ka kungah ahing lut a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n hichi ahing hi a, aw ngaitaha ka kikou leh a puonsil ka kunga nuasie in atai dohta hi” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n hichi ahing hi a, apu in a zinu’n a kunga “Tambang talawm a na suohpa’n a hing bawl” chithu azah tahin a lungthah ta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Joseph apu’n azawpi a, leengpa miliente akhumna uh suongkul ah akhumta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh Mangpa’n Joseph aumpi a, ahepina akilang sah a, suongkul vengpa mitmu ah deisahna a tangsah hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n suongkul vengpan suongkul aum suongkultang zousie Joseph khutah a unin akeem sah a, tuana abawl zousie uh Joseph bawl ahimai hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Suongkul vengpan Joseph khut nuoia um bangkim ava en nawn tasih hi. Mangpa’n Joseph aumpi a, tualeh abawl pouma Mangpa’n lawchinna apieh ziehin.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh tam silte nuain hichi ahing hia, Izipt leengpa uain pepa leh a tanghou bawl pa’n apu uh Izipt leengpa a lungthah sah ua.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n Pharoah milien nite uoin pete lah a lienpen leh tanghou bawlte lah a lienpen tungah alungthah ta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n amauh gel mi veng pawlte lamkai inn a, Joseph kikhumna suongkul ah a khumta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh mi veng pawl lamkai pa’n amaute gel Joseph a kemsah a, tualeh amaun ana asep pieh ua, hun tomkhat ataang uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh suongkul ataang Izipt leengpa uain pepa leh tanghou bawlpa ani un zan khat thuin mang akhietna tuom tuom tuoh aman uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Joseph zingmawng in akung uah ahing pei a, amauh ahing kimupi a, tualeh ngaivawi, ana lungkham mama uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n aman apu inn a akikhumna-a ama toh taangkhawm Pharoah miliente kungah, “Bang achia tunia tambanga ngui mel puo na hi uoi?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh amaute gelin a kungah, “Koute gel in mang ka nei ua, a hinghil chien thei koima aumsih hi,” achi ua, tualeh Joseph in akung uah, “Hilchienna kichite Pasian a hilou ahiei mah? Hepitahin hinghil un” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh uain pie lienpen pa’n amang Joseph ahil a, “Ngai in, ka mangin grepgui khat ka masangah ahing um a,
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh grep guiin ba thum anei a, tualeh ahing sel doh a ahing pah khe ngal a, grep ga bomte ahing uma ahing minta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Pharoah nou ka khut ah ahing uma, tualeh Grep gate ka lou a, Pharoah nou ah ka suh a, tualeh anou pen Pharoah khut ah kana pie hi,” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Joseph in a kungah “A hilchienna tami ahi, a ba thumte pen ni thum ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tu akipat ni thum sungin Pharoah in na lu adomkang dinga, na sep ngaima ahing semsah kia dinga, tualeh uain pepa nahi laia na pieh ngai bangin Pharoah nou akhut ah na pekia ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinanleh na hamphat kia chiengin kei hing manghil sinlen, hepitahin ka tungah na hepina hing langsahin, tualeh Pharoah kungah ka tungthu hing gen inlen, tam inn a kipat hing puikhie in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aziehpen Hebru mite gam a kipata mi’n ang guh mang uh ka hia, tanah zong suongkul khuh sunga ahing khumna dingun bangma ka bawl khiel sih hi,” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tanghou bawl lienpen pan ahilchienna dih chi athei in, Joseph kungah, “Kei zong mang ka nei a, Ngaiin, tanghou ngou lawbeu thum ka lu in kana puo a,
  </para>
  <para style="p">
    <verse number="17" style="v" />tualeh, lawbeu tungtapen sungah Pharoah ding, tanghou chi tuom tuom aum a; tuate pen vaten ka lutunga law a kapuoh na akipat ane siengta uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n, Joseph in a dawnga, “A hilchienna tami ahi, Law thumte khu ni thum ahia,
  </para>
  <para style="p">
    <verse number="19" style="v" />Tua kipat ni thum sungin Pharoah in na tahsa akipat na lutang domkang vanin, sing dawn ah ahing khai dinga, tualeh vaten nasa ane sieng ding uhi” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh, hichi ahing hi a, ni thum ni in, Pharoah pien hun a hing tunga, aman anasemte zousie a dingin ann kuong alui a: tualeh ana semte lah a, uain pie alien penpa lutang leh tanghou bawl alien penpa lutang a domkang ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n uain pie a lien penpa khu uain pe ma in apangsah kia a; tuachiin, Pharoah khutah nou apeta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivang in tanghou bawla lien penpa khu Joseph in amang a hilchien bangin akhai liata hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh uain pie alien penpa’n Joseph athei zing tasih a, amanghil ta hi.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh kum ni vingveng nuain hichi ahing hi a, Pharoah in mang a nei a, tualeh ngaivawi, luigei ah ana dinga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh ngaivawi, thakhat in lui akipan in bawngpi hoi mama thau tahtah sagi ahing pawt a, hampa lah ah ahing gamta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n ngaivawi, tuate nua ah lui akipat bawngpi dang ling thengthung gawng gemgom sagi ma ahing pawtkhie ua, bawngpi dangte kunga luigei ah ahing ding uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh bawngpi hoilou leh gawng gemgom ten bawngpi hoi leh thau mama sagite khu ane siengta uhi, tuachiin Pharoah akhanglou ta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh a imu kia a, mang anei kia a, tualeh ngaiin, thakhat in bu kung khat ah buvui sagi lienpipi leh hoitah tah ahing um khie a,
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n ngaivawi, tami nuain buvui sagi ngat giugeu suolam huiin amut heu gawpte ahing umdoh kia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh buvui sagi ngat giugeu ten buvui sagi lien leh hoite khu aval siengta uhi, tuachiin Pharoah a khanglou kia a, ngaiin a mang ana hi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh, zingmawng in tambang ahing hia, alungsim ngaituona a buoi mama a, mi a sawl a, Izipt gam a mitphieldawi siemte leh mipilte zousie a unin a hankhawm sah a, tualeh Pharoah in amaute a mang ahil a, hinanleh amang Pharoah hilchien thei koima aum sih uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualaitahin uain pie a lien penpa’n Pharoah kungah, “Tuni’n ka bawlkhelnate ka hing theidoh ta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pharoah a suohte tunga a lungthah laiin, kei leh tanghou bawl a lienpenpa, ka ni un suongkul veng lamkaipa inn a suongkul sungah ahing khumta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n zankhat ama leh ken mang khat ka nei tuoh ua, ka mangte un a khiehna atuom tuom anei tuoh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh tuanah vengpawl lamkai suohpa Hebru mi tangval khat ka kung uah aum a, tuachiin ama kahil ua, tualeh aman ka mang uh hilchienna ahing bawl a, ka mang uh dungzui in ahing hilchien tuoh tuoh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh tambang ahing hia, aman a hilchien bang bangin ahing umta a, keipen ka sep ngaima ahing semsah kia a, amapen akhailiata hi” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Pharoah in mi a sawl a, Joseph a hansah a, tuachiin gangtahin suongkul apat ahing pui ua, tualeh akhamulte heuin apuon silte a henga, Pharoah kungah ahing lut hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Pharoah in Joseph kungah, “Mang khat ka nei a a hilchien thei koima aum sih a, hinanleh nang a thu nathei pouleh na hilchien thei chi thu kigen kaza hi” achi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Joseph in Pharoah a dawnga, “Tuapen kei a um ahisih a, Pasian in Pharoah hamuonhuoi tahin a dawng zawding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Pharoah in Joseph kungah, “Ngaivawi, ka mangin luipi pieu ah kana dinga,
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh thakhat in lui akipat bawngpi athau a thau leh hoi tahtah sagi ahing pawtkhie a, loupa dawng lah ah ahing gamta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuachi’n ngaivawi, tuate nua ah, bawngpi dang ling letlut gawng gemgom ahoi a hoilou, tambang va-ia a hoilou, Izipt gam sunga ka mu khah ngai vawtlou ahing pawtdoh tou kia uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh bawngpi gawng gemgom leh hoilouten bawngpi athau a thau leh ahoi a hoi mama sagi hing pawt masate ane mangta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh, aneh zou nua un zong, anesiengta uh chi akithei tuom sih hi, achiillai mabangin hoilou tahin aum nalai uhi, tuachiin ka khanglouta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuamabangin ka mangin, bukung khat ah buvui sagi lien tahtah hoi mama ahing umdoh a,
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n ngaiin, tuate nua ah buvui sagi ma nang nit net ngat giugeu suolam huiin amut heu dohte ahing um doh kia uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh buvui ngat giugeu ten buvui hoi sagite avaltum sieng ta uhi, tualeh tami thu mitphieldawi siemte ka hil a, hinanleh ka kunga hinghil chien thei koima aum sih uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph in Pharoah kungah, “Pharoah mang tegel pen khat ahia; Pasian in bawl dia akisahte Pharoah kunga atheisah ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bawngpi hoi sagite khu kum sagi, ahia, tualeh buvui hoi sagite zong kum sagi ma ahia, na mang tegel khu khat ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh bawngpi gawng leh hoilou sagi anua a hing pawtdohte khu kum sagi ma ahia, tualeh buvui hoilou suolam huiin amut siet gawp sagite khu kiel kum sagi dingte ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tam silte ahi Pharoah kunga ka gen; Pasian in bawl dinga atup silte Pharoah atheisah ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngaivawi, Izipt gam sung tengteng ah nieng leh taitah a umna kum sagi ahing tung ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hinanleh tuate nuain kiel kum sagi ahing umkia dinga, tuachiin nieng leh tai a um nate Izipt gamah manghil sieng ahita dinga, kielna in gam sung ane segawp tading hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n kiel thupitahin azui ziehin gam sung pumpi ah nieng leh taitah a umlai theiphah ahi nawn tasih ding hi, a huoi siet seng ding ziehin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh Pharoah mang nivei anei thuosahna pen, sil bawl ding khu Pasian suhdet ahia, Pasian mama in atunsah pai ding ahizieh ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuaziehin tuin Pharoah in mi lemtheitah leh piltah khat suikhie henlen, Izipt gam sungah houtu in koi hen.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pharoah in tami bawl henlen, tualeh aman agam tungah houtu ding guot henlen, nieng leh taitah a um kum sagi sungin Izipt gam a pieng bu se-nga suo seni khonkhawm hen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tualeh amaun tua kum hoi sagi hing tung dingte a bu zousie lakhawm in Pharoah thuneina nuoi ah koi uhenlen tualeh khopite ah zong koikhawm uhen.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuachi’n tua bu khu Izipt gam sunga dingin kiginkholna a koikhawm ahi ding a, kiel zieh a gam amanthai louna dingin,” achi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n tami thu Pharoah leh asuohte tengteng ngaiin hoi asah lamtah uh ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh Pharoah in asuohte kungah, “Tambang Pasian hagau umna mi imu zou ding amah?” achi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuachi’n Pharoah in Joseph kungah, “Pasian in tamte zousie nang ahing theisah ziehin nang banga lemthei leh pil koima aum sih, achi hi.’
  </para>
  <para style="p">
    <verse number="40" style="v" />Ka inn sungah vaihawmin na pang dinga, ka mite zousie na thupieh banga vaihawm pieh ahi ding hi. Lengtoupha ah athu mai maiin nang sangin ka lien zaw ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tualeh Pharoah in Joseph kungah, “En in, Izipt gam pumpi ah vai hawm in ka hing koita hi,” achi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tuachi’n Pharoah in akhut akipan in amin namna khutsip lakhie in Joseph khutah abunsah a, puon malngat puon silte asil sah a, angawng ah sana khainieng a awsah ta hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tualeh a sakolleng nei anina ah atousah a, amasangah “Khupdin un” chiin akikou uhi. Tuachi’n ama khu Izipt gam zousie tunga vaihawmin a bawlta uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tualeh Pharoah in Joseph kungah, “Kei Pharoah ka hi, nang thulouin koiman Izipt gam sung zousie ah akhut ahiei, akeng ahiei aleh thei sih ding,” achi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tualeh Pharoah in Joseph min Zaphnath-paneah ahisah ta hi. Tualeh a zi dingin On khuo a Siempu Potiphera tanu Asenath apie hi. Tuachi’n Joseph apawt khie a Izipt gam teng teng atuon suah ta hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tualeh Izipt leengpa Pharoah masanga adin laiin Joseph khu kum sawmthum a upa ahia, tualeh Joseph khu Pharoah masang akipat apawt khie a Izipt gam teng teng atuon suah ta hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tualeh kum hoi kum sagi sungin leitangin bu leh bal tampi apieng sah hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tuachi’n aman Izipt gam a um, kum sagi sunga pieng bu zousie alakhawm a, tua bute pen khopite ah akoi khawma, khopi kimvel a bu zousie tua khopite ah akoi khawm hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tuachi’n Joseph in bu atama tam, tuipi pieunel bangin a sung khawm venvon a, simseng ding ahilou ziehin asim atawpsan vawt hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tualeh kiel kumte tun masangin On khuo siempu Potiphera tanu Asenath in Joseph tapa ni ahinpieh hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Joseph in atapa masapen min Manasseh aphuo hi, “Aziehpen Pasian in ka sep gimna zousie leh ka pa innkuonpite zousie a hing manghil sahta” achi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tualeh atapa nina pen min Ephraim aphuo hi, “Pasian in ka gim thuohna gamah hahlesuon ahing siempieh ta hi,” achi ziehin.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tualeh Izipt gam a kum hoi kum sagite ahing beita a,
  </para>
  <para style="p">
    <verse number="54" style="v" />Joseph in ana gensa bang bangin kiel kum sagi khu ahing tung panta hi. Kiel khu gamteng ah ahing tunga, hinanleh Izipt gam sungah neh ding aum hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tuachi’n Izipt gam pumpi ahing kiel ta a, mipite Pharoah kungah neh ding ngenin akikou ta uhi. Tualeh Pharoah in Izipt mite kungah, “Joseph kungah pei unlen, ama gen bang bangin bawl un” achi hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Tuachi’n leitung pumpi ah kiel ahing tungta a, khumin Joseph in bu sun khawmna inn zousie a honga, Izipt mite alei sah ta hi. Kiel pen Izipt gam sungah akhawh mama hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tuachi’n gam tenga kiel akhawh mama ziehin gamchina mite Izipt gamah Joseph kungah bu lei dingin ahing pei uhi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob in Izipt gamah bu aum chi athei a, tuachi’n Jakob in a tapate kungah “Bang dinga khat leh khat ki entuo na hi uoi mah?” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh aman “Ngaivawi un, Izipt gamah bu aum chi ka za hi, khunah peisuh unlen shi lou a i hin theina dingun, ei a ding in bu valei ta un,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Joseph unau sawmte Izipt gamah bu lei dingin ang peisuh ta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh Joseph sanggampa Benjamin pen Jakob in aunaute toh a zawhsah sih hi, silsie khat a tungah tung khava achi ziehin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualeh Israel tapate zong Izipt gam a pua suidingte toh azawhkhawmta uhi. Kanaan gam a zong kiel atun ziehin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Joseph pen Izipt gam sung pumpi vaihawmpa ahia ama ma khu gamsung mite zousie kunga azua a pang ahia, tualeh Joseph unaute khu ahing pei ua, leisu in a masang ah akunta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Joseph in a unaute amutah in athei pai a hinanleh akung uah atheilou bang in aum a, midang bangin a unaute ana houpi a, tualeh akung uah, “Hei a kipat a hing pei na hi uoi?” achi hi, amaun, “Kanaan gam apat bu lei dinga hing pei ka hi uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Joseph in a unaute a theia, hinanleh amaun athei sih uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n Joseph in amauh teng tungtang thu a manga amatte ahing theikheta a, akung uah, “Galguh na hi ua, mi enkhie a pang hiva uteh, tam gamsung umdan en a hing pei hibou uteh,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh amaun, akung ah, “Hi vawtsih ung, ka mangpa uh, na suohte bu lei dinga hing pei hibou ung.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka unpi un mi khat tate ka hi ua, midih hi ung, na suohte galguh bawla mi enkhie hisih ung,” achi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hinanleh aman akung uah, “Tahsang sing gam sung guohtang hidan en dinga hing pei hi uteh,” achi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaun “Na suohte unau sawm leh ni kahi ua, Kanaan gam a um mi khat tate ka hi uhi. Tualeh ngai in, tuin a tumpen ka pa uh kungah aum a, khatpen aum nawn tasih hi,” achi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinanleh, Joseph in akung uah, “Ka gensa mabangin noute galguh na hi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tambanga etchienin na um ding uh, na nau tumpen uh tam muna ahing pei sihleh tana pat in pawtkhe nawn sih va uteh chi Pharoah hinna a kichiem in ka hing chi ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nouma ah thutah aum ei aum siei etchien ahina dingin nalah ua khat sawl unlen, na naupa uh vapui sah un, tualeh noute pen suongkul ah na um phot ding uhi. Tua ahisihleh Pharoah hinna louin ka gen ngam ahi, noute galguh na hi uhi,” achita hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n aun un ni thum suongkul ah akhumta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Joseph in ni thum ni in akung uah, “Tami bawl unlen hing un, aziehpen Pasian ka giing hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Midih na hi u’leh na u naulah ua khat na suongkul lutna uah tangden henlen; noute pei unlen, kiel a um na unaupite ua dingin bu puo un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh na nau tumpen uh ka kungah hing zawpi un, tuachi’n na thu uh akitheichien dinga, na shi sih ding uhi,” achi hi. Amaun tuachi’n abawl uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh amauh khat leh khat akihou ua, “I nau tunga i silbawl uh i na bawlkhiel tahtah uhi, hepina a nget va ngua lai a achimaw dan munapia, i ngaisah nuom vawtlou uh, tuazieh a tambang mangbatna itung ua hing tung ahita hi” aki chi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh Reuben in “Naupang tungah sil bawlkhiel sih un, chiin na kung uah ka gen sih amah? Na ngaikhe ut sih ua, tuaziehin ngaivawi un, asisan phuba hing kila ahi” chiin amauh a dawnga.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahivang in a thugen uh Joseph in athei chi amaun a theisih uhi. Aman akung uah hamlet zanga thu agen ziehin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh aman amauh ale ngatsan a, akapta hi. Tualeh akung uah ahing pei kia a amauh ahoupi a, tualeh alah uapat Simeon apui tuom a, amitmu uah akanta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Joseph in a ipte uah bu thundim ding leh a ipte ua amauh sum chiet koikia ding leh lampi a aneh ding uh pe dingin thu apia a; tambangin atung uah abawlta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n abute uh a sabiltungte un aposah ua, khum mun apat apei ta uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh alah ua khat in giehbuh a sabiltung ann pe dinga a tumbu ahon leh a sum ahing mukhie a; a tumbu gong ah ana um hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n aman a unaute kungah, “Ka sum ana nuakoi kia mawh uhi, achi hi, envawi un ka tumbu sunga na um ahi achi hi,” tualeh amaun, Pasian in tambang talawma ahing bawl “Bang chidan adeh aw? chia lung himaw leh zau kawmin aki entuo uhi.”
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Kanaan gamah apa uh Jakob kungah ahing tung ua, atung ua sil tung zousie ahil uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Tua gam vaihawmpa’n khautahin ahing houpi a, agam uh enkhie galguh dingin ahing na ngaw hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinanleh kouten akungah, midih hi ung, galguh ka hisih uhi;’
  </para>
  <para style="p">
    <verse number="32" style="v" />Unau sawm leh ni kahi ua, Pa khat hah ngen ka hi ua, khat aum nawn sih a, nau tumpen tuin ka pa uh kungah Kanaan gamah aum hi kachi uhi.’
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n tuami gam vaihawmpa’n ka kung uah Tambangin midih na hi uh chi ka theina ding in na unau khat uh ka kungah nuasie unlen, na innkuonpi kielte a dingin bu puo unlen peita un,’ achi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tualeh na nautumpen uh ka kungah hing pui un; tuachi’n galguh na hi sih ua midih nahi zaw uh chi ka hing thei dinga, tuachi’n na naupa uh ka hing pekia dinga, tam gamah summet na bawl ta ding uhi” achi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuachi’n hichi ahing hia, a ipte uh ahing buh khiet u’leh, a sum tun chiet uh a ipsung uah ana umchiet hi; tualeh amauh leh apa un sum tunte amu un azauta mama uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tualeh apa uh Jakob in akung uah, “Nouten ka tate hing taansah hi uteh; Joseph lah aum nawn sih a, tualeh Benjamin puimang sawm na lai uchia, tam silte zousie in kei hing buohkhum ahita hi,” achi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuachi’n Reuben in apa kungah, “Ama na kunga kahing tut kia sihleh ka tapa nite that maiin; ama ka khutah hing pien len na kungah hing puikia na vang,” achi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tualeh aman, “Ka tapa pen na kung uah hing peisuh sihva, aziehpen a upa ashita a, ama maimai ahita hi. Na peina lamkaal uah tuohsie tuoh taleh ka lu kaang pen lungkhamna toh han ah tung suh sah ding hi uteh,” achi hi.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh khum gamah kiel anase mama a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh hichi ahing hi a, Izipt gam a ahing bu puohte uh aneh zou un apa un akung uah “Peikia unlen, bu tawmnou khat beeh valei kia un” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hinanleh Juda in a kungah, “Tua mipa’n na naupa uh na hing zawpi sih u’leh ‘ka mel na mu sih ding uh chiin ahing kal chinten hi.’
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka nau uh na hing zuisah ding leh peisuh va ungin, bu hing valei pieh va ung;
  </para>
  <para style="p">
    <verse number="5" style="v" />Hinanleh ama na hing sawl sihding leh pei sih va ung, Aziehpen tua mipa’n ka kung uah, na naupa uh na hing zawpi sih u’leh, ka mel mu thei sih va uteh achisa ahi ziehin chiin,” agen hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh Israel in “Bang dinga kei lungkham na dinga nau dang khat nei nalai ung chia tua mipa nava hil sese uh ahiei,” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaute’n “tua mipa’n kouma leh i innkuon tungtang thu pilvangtah in ahing donga, na pa uh adam nalai ei? Pienpi sanggam dang na nei na uoi? Chi’n ahing dong a, tuachia ahing doh dungzui a ka hil mai uh ahi, Na naupa uh hing zawpi un achi ding lam ka thei va teh sih uhi,” chiin a dawng uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n Juda in apa Israel kungah “Nautum in hing zuisah in, ka kisa ding ua ka kuon ding uh, nang leh kou leh ka tate uh ashi louna dingin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keima’n amaw paw vangin, keima lah ah amaw hing phut in, na kunga ka hing tut sih a na masanga ka hing dinsah sihleh tangtawn in amaw ka paw ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kinawngkai den sih leh ani veina zong hing tungkia tham ta ding hi unga,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh apa uh Israel in akung uah, “Tuin tuachibang ahi vanglah leh tambang in bawl un, na nasepna chiet ua, tam gam a theiga hoi pente leh Singnai damdawi, khuoizute, gimtuite, murrahte, thei hawsate, makhate them khat chiet tua mipa nuomman dingin puo un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh sum a leni a tam keng unlen, na tumbu gongte ua ahing sum puosahte u’zong tawikia un, a mukhiel hikhava.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh na naupa u’zong zawpisuh ta unlen tua mipa kungah haw kia un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh na naupa khat pen u’leh, Benjamin ahing hakhiet na dingin bangkim bawlthei Pasian in tua mipa hing khotuosah tahen, ka tate taan kahileh kataan maiding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n amaun, silpieh dingte atawi ua, sum aleni a tam akeng ua, Benjamin toh Izipt ah apeisuh ta ua, Joseph masang ah adingta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tualeh Joseph in akung ua Benjamin um amu tahin a innsung vaisaipa kungah “Tam mite innsung ah puilut inlen, sa gou inlen bawlin, tam miten kei toh sun chiengin ann a ne ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n tua mipa’n Joseph gen bangin a bawlta hi, tualeh aman tua mite Joseph inn sungah apuilut ta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Joseph inn a puilut a aum bep un, a zauta ua, “I haw masah laiun, i ipte ua sum hing kinuapieh kia zieh a ahing puilut hita ven izaw? i tunga imawna ding uh sui a, hing kihoupi a, eileh i sabiltungte uh suoh leh sal a hing mat sawm ahita ve uoh,” akichi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Joseph innsung vaisaipa kungah avapei ua, inn kotkhah zungah ama ahoupi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pu aw “Ka hing hawmasah laiun ann lei dinga hing hawsuh ka hi ua,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinanleh hichi ahing hi a, giehbuh ka tun ua ka ipte uh ka hon u’leh ngaivawi, ka sumte chiet uh ka ip gong chiet uah ana um hi, tua sumte abuh za mama ana um hi, tuate pen kahing paw kia uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh, bu leina ding zong sum dang ka hing keng kia uhi, ka sum uh ka tumbu sung ua koi na guon adiei chi ka thei sih uhi,” achi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh aman akung uah, “Hamuang tahin um unlen zau vawtsih un, na Pasian uh na pa uh Pasian in na tumbu sung ua gou ahing pieh ahi; na sumte uh ka mu na hi,” achi hi. Tualeh aman Simeon akung uah ahing pui hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n amapa’n tua mite khu Joseph inn sungah apuilut a, tui apie a, akeng uh asil ua, tualeh a sabiltungte uh ann apie hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n anuomman puohte uh Joseph ann ne dinga ahing pei chienga dingin mansain akoi ua, aziehpen tam mun a ann ne ding ahi uh chi athei uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachia Joseph inn ahing peitahin akhut ua nuomman umte inn sungah akung ah atawilut ua, khupboh in amasanga kunin chibai abuh uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n aman atung thu uh a donga “Na pa uh thu na gen uh tua puteh adam nalai ei? ahing nalai ei mah?” achi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh amauten a dawng ua, “Na suohpa ka pa uh adam nalai hi,” achi ua, tualeh alu uh kunin chibai abuh uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh ama adahtou a anu tapa, a sanggampa Benjamin amu a, “Tampa himaw, na nau tumpa uh, a tanchin na hing hil uh?” achi hi. Tualeh ama main, ka tapa, Pasian in hing hepi hen achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Joseph in anaupa amu tahin, ahase sengin kintah a pawtin akaana ding mun asui a, tuachi’n pindan a lut in ava kap kheta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n amai aphiet a, ava pawtkhe kia a, kideh tei tei in “Ann neh ding bawl un” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuachi’n ama ding a tuom in, ama ua ding a tuom in, tualeh Izipt mite anehpi dingte ading a tuom in abawl uhi. Aziehpen Izipt miten Hebru mite toh ann ane khawm ngaisih uhi. Tuabanga bawl ama ua dinga sienglou ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuachi’n upa pen ta masa hina dungzui in nau tumpen anaupanna dungzui in akizom ditdet in Joseph masang ah atou ua, lamdang sa in khat leh khat aki-entuo uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuachi’n Joseph in amasanga mite akipat in atanvou uh ann aban piehsah a, hinanleh Benjamin tan pen ama ua teng sangin ale nga in atam zaw hi, tuachi’n ama toh adawn ua nuom asa chiet uhi.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n aman a innsung vaisaipa kungah, “Tua mite tumbu ah apuoh zaw zaza uh bu sung dim inlen, asum chiet uh a tumbu sung chiet uah guongin achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh tua ka Dangka nou pen anaupang penpa tumbu ah guongin, abu man sum toh chiin thu apie a,” tuachiin aman Joseph genbangin a bawlta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh zingmawng khuo ahing vah tahin tuamite a Sabiltungte utoh a sawl kheta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh khopi akipat apeikhiet nua uh gamla atun masangun Joseph in a innsung vaisaipa kungah, “Kisa inlen tua mite vadel in, tualeh na phah tah chiengin akung uah, bang chidan a hoina sietna a thuh na hi uoi?’
  </para>
  <para style="p">
    <verse number="5" style="v" />Tami ka pu uain dawnna leh a aisanna nou hilou ahiei mah? Tambanga na namtat uh takhiel hi uteh va chi in,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh amaute adel phata a, akung uah tam thute abang bangin agen ta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh amaun akung ah, “Pu bang chidana tambang thute na gen ahiei? na suohten tambang sil ka bawllou ding dan uh.’
  </para>
  <para style="p">
    <verse number="8" style="v" />En in, ka tumbu gong ua ka sum mute uh zong Kanaan gam apat na kungah ka hing tawikia uhi, bang chidanin na pu inn apat dangka ahiei, Sana ahiei ka gu thei ding uoi?’
  </para>
  <para style="p">
    <verse number="9" style="v" />Na suohte lah a na muna penpen ama lah shi henlen, kouma zong na suoh hi mai va ung,” achi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh aman “Tuin na thu bangun hiheh, akimuna penpen ka suoh hi vanin, noupen getsiet banglou hi va uteh,” achi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n amaun a tumbu chiet uh akin theibangin leiah anga khe pai chiet ua, michin in a tumbu chiet uh ahong uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n aman a upa pen ua pat apan a anau tumpen pa tan dongin asui pai a, tuachiin nou khu Benjamin tumbu ah amuta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n amaun apuonte uh abotkeh ua, a sabiltungte uh posah chiet in khopi lamah ahing kile kiata uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Juda leh a sanggamte Joseph inn ah ahing pei ua, ama khunah ana um nalai a, tualeh amasangah abohkhup chiet uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Joseph in akung uah “Bang sil bawla kinei na hi uoi? Kei bang mite aisan asiem teitei uh chi theilou na hi uoi mah?”
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Juda in a kungah “Bang kagen ta ding uoi? Bang e kang hil taah ding uh? ahisihleh bang kachi gen veng ta ding uoi? Pasian in na suohte khelna mukhie ahita, Ngaiin, kou leh akhut a nou kimunapa” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinanleh aman, “Tuachibang a ka bawllou ding dan, hinanleh akhut a nou amuna pen pa vang ka suoh hivanin, noute pen na pa uh kungah hamuong tahin peita un” achi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n Juda in Joseph ahing nai a, “Pu aw hepitahin na suohin ka mangpa bil a na zah dingin thu tengkhat hing gensah inlen, na lungthahna na suohpa tungah kuongsah sin, nang pen Pharoah bang nahi ta ngal a.
  </para>
  <para style="p">
    <verse number="19" style="v" />‘Ka pu in na suohte kungah, ‘Pa ahiei sanggam ahiei na nei uoi?’ chiin na hing donga,’
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh kouten ka pu kungah Pa tehsie khat leh ateh nua a anei tapa naupang nalai ka nei uh, a upa a shita a, anu hin lah ah ama ngen um ahita a, apan lah a it mama hi, kachi uhi.’
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n nang na suohte kungah, ama ka mit a ka mu theina dingin ka kungah hing puisuh un na chi hi.’
  </para>
  <para style="p">
    <verse number="22" style="v" />Tualeh kouten ka pu uh kungah naupang in apa nuasie thei sih va, apa nuasie leh apan shi law ding hi ka chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hinanleh nangman na suohte kungah, na nau tumpen uh na hing zawpi sih u’leh ka mel mu nawnsih va uteh, na hing chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Tuachi’n hichi ahia, ka pa uh na suohpa kunga ka tuntou un, ka pu thu gente a kungah ka hil uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tualeh ka pa un peikia unlen, bu tawmnou khat beeh valei kia un achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hinanleh kouten ka pei suh thei nawn sih ding uh, ka nau tum un ahing zuiding leh peisuh va ung, aziehpen ka nau tum un ahing zui sihleh tua mipa mel muthei lou ding hi ung, ka chi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n na suohpa ka pan ka kung uah, ka zi in tapa ni ahing hinpieh chi na thei ve uo le; achi hi.’
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh khat in ahing peimang santa a, bawtel a um hita valon ding hia, ka chia, tuami nualangsie ama ka mu kha nawn vawt tasih hi.’
  </para>
  <para style="p">
    <verse number="29" style="v" />‘Tuachiengin tampa zong keia pat a na puimang ua, lamkaal ah tuosiet khat tuoh taleh ka lukaang khu lungkham tah a hankhuh tungsah ding na ve uoh maw,’ achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“‘Tuaziehin tuin ka nau un kou hing zuilouin um taleh na suohpa ka pa kungah tung taleng naupang hinna leh ahinna kigahkhawm ahi ziehin.
  </para>
  <para style="p">
    <verse number="31" style="v" />‘Tambang ahing hi dinga, naupang in hing zuilou chi amu chiengin ashi mai ding hi. Tuachi’n na suohten ka pa uh na suohpa lukaang khu lungkham tah a han a tungsah ding hita ve ung maw!’
  </para>
  <para style="p">
    <verse number="32" style="v" />‘Tuazieh in, na suohpa’n na kunga ka hing tutkia sih pouma leh amaw ka pa lah a tangtawnin povang chiin ka pa kungah naupang tungtang ah maw puoin ka na pangta hi.’
  </para>
  <para style="p">
    <verse number="33" style="v" />‘Tuaziehin tuin hepitahin na suoh khu naupang taangin kapu dingin suohin hing umsah in, tualeh naupang pen a ute toh peitou sahin.’
  </para>
  <para style="p">
    <verse number="34" style="v" />Aziehpen ka nau toh zawhlouin bang chiin ka pa kungah ka pei tou thei diei? Ka pa tunga sietna tung ding ka mu ngamsih hi,” achi hi.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Joseph pen a kunga dingte masangah akideh zou nawn sih a, “Mi zousie ka kung apat in pawt khesah un” chiin akikou a, tuachiin Joseph a unaute kunga akitheisah lai in a kungah koima ading sih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh ngaitahin akap khie a, Izipt mite leh Pharoah innsung miten zong aza uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Joseph in a unaute kungah “Keima Joseph ka hi, ka pa adam nalai ei mah?” achi hi, tualeh a sanggamten a dawng thei tasih ua, amasangah abuoita uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh Joseph in a unaute kungah “Hepitahin hing nai un” achi hi, tuachiin a nai ua, Aman “Kei Joseph na unaupa uh Izipt gam a na zuapa uh ka hi.”
  </para>
  <para style="p">
    <verse number="5" style="v" />Hinanleh tuin tambanga na hing zua ziehun, lungkham sih unlen, zong kilungthah khum tua sih un, Pasian in mite hinna humbit dingin na masang ua ahing na sawl masah ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kum ni sung tam gamah kiel atung pan nalai a, kum nga in asam nalai hi, tua hun sungin lou akihou sih dinga bu zong akila sih ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh, leitunga nahah nasuonte uh hing kepbit pieh ding leh hutkhietna thupi taha na hinna uh hundam dinga Pasian in na masang ua kei ahing sawl masah ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaziehin, tana hing sawl noute na hisih ua, Pasian ahizaw hi. Aman keima Pharoah dinga pa leh a innsung mi zousie dinga lamkai leh Izipt gam pumpi tunga vaihawmin ahing bawlta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Manlangin ka pa kungah peitou unlen, tualeh a kungah, Na tapa Joseph in tambangin achi hi, Pasian in Izipt gam pumpi tunga lamkai in ahing bawlta hi, ka kungah sawt kiheh louin hing peisuh heh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Goshen gamah na teng dinga, ka kungah na um ding hi; nangma leh na tate leh na tate tate leh na belamte leh na bawng honte leh na nei zousie toh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khunah keiman ka hing vaa dinga, kiel na ding kum nga aum nalai ziehin. Khuchilouin nang leh na innkuonpite leh na nei zousie na hing tasam kha ding uhi, chiin va genta un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh ngaivawi un, namit mu u’leh ka naupa Benjamin mit ngelngel in na kung ua keima kam ngelngel a ka thugen lai na mu uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuaziehin ka pa kungah, Izipt gam a ka thupina leh na sil mu zousie uh na hil ding ua, gangtah in kapa tammun ah hing puisuh un, achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n a naupa Benjamin ngawng kawiin a kap a, Benjamin zong ama ngawng kawiin a kapta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuathamlouin a unaute zousie atawpa, akakhum chiet a, tuazouin a unauten a houlimpi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n “Joseph sanggamte ahing tung uhi,” chi thuthang Pharoah inn sungah ana zata uhi. Tua thuin Pharoah leh a suohte akipahsah mama hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Pharoah in Joseph kungah “Na sanggamte kungah tambangin bawl un, na gante uh bu posah unlen, Kanaan gamah pei un,
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh na pa u’leh na innkuonpite va pui unlen, ka kungah hing pei un, Izipt gam a silhoite hing pe vangin gam sung thauna na ne ding uhi chi’n genin achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuin, thu ka hing pie hi, tami bawl in, na taneute u’leh na zite uh dingin Izipt gam a kipat sakollengte keng unlen na pa uh hing pui unlen hing pei un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na neitahte u’zong ngaituo data un, Izipt gam sunga silhoi pouma nou a ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Israel taten tuabangin abawl ua, Joseph in Pharoah thupieh bangin sakollengte a puia, tualeh lamkaal a neh ding zong apie hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A bawn un puonsil kihen nading ape chiet a, hinanleh Benjamin pen Dangka za thum leh puonsil kihenna ding nga apie hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh apa kungah tambangin ahah hi, Izipt gam silhoi puo sabiltung sawm, tualeh lamkaal a apa uh ding bu, tanghou leh neh thei puo sabiltungnu sawm ahah hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuachi’n a unaute asawl kheta a, apeita uhi, tualeh aman, akung uah, “Lampi a kihau lou dingin pilvang un” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Izipt gam a pat in apeitou ta ua, Kanaan gamah apa uh kung atungta uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh apa u kungah “Joseph ahing nalai hi, Izipt gam pumpi ah vaihawmin apang hi chiin ahil uhi. Hinanleh a thugen uh a tahsan lou seng ziehin Jakob alungtang ana vawt hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Tualeh Joseph in akung ua athu gente ahilta ua, tualeh ama puoh na dinga, sakolleng Joseph in ahing sawlte amu in apa uh Jakob lungtang asu hal kiata hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh, Israel in, ahunta hi; ka tapa, Joseph adam nalai; peivangin ka shi masang in va muta vang,” achi hi.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Israel, anei zousie toh ahing kipankhie a, Beer-sheba ahing tunga, apa Isaak Pasian kungah kithoinate alan hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n, Pasian in Israel kungah zanlai a mangin ahoupi a, “Jakob, Jakob” achi hi, tualeh aman “Tanah um inge,” achi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualeh, Aman “Kei Pasian na pa Pasian ka hi, Izipt gam a peisuh ding zausin, tuanah nang apat nam thupitah in ka hing siemding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Izipt gamah na kungah peisuh vangin tualeh pellouin hing puikhe tou kia vangin Joseph khut ngelin na mit asingsah ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n, Jakob pen Beer-sheba apat apei a; Israel taten apa uh Jakob leh a taneute u’leh a zite uh tuonna ding a Pharoah in sakolleng ahahte ah a tuongsah uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuachi’n amaun Kanaan gam a a lamkhiet uh ganta leh neitahte hing puoin Izipt gamah ahing tung ua, Jakob leh ahahasuonte zousie toh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A tapate, atapate tapate, a tanute, a tapate tanute leh ahah a suonte zousie Izipt gamah ahing lutpita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh tamte khu Israel tate Izipt gam a hinglut Jakob leh a tapate min ahi. Reuben, Jakob tapa upapen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Reuben tapate Hanok, Pallu, Hezron leh Karmi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Simeon tapate: Jemuel, Jamin leh Ohad, Jachin leh Johar tualeh Kanaan numei khat toh anei, Shaul toh ahi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Levi tapate Gershon, Kohath leh Merari.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Juda tapate Er leh Onan leh Shelah leh Perez leh Zerah; hinanleh Er leh Onam pen Kanaan gamah ashita uhi. Tualeh Perez tapate Hezron leh Hamul ahi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Issakar tapate Tola, Puvah, Job leh Shimron.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebulun tapate Sered leh Elon leh Jahleel.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tamte Leah tapate Padan-Aram gam a Jakob dinga ahin piehte a tanu Dinah toh ahi. A tapate leh a tanute a bawn un mi sawmthum leh thum ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad tapate Ziphion, Haggi, Shuni, Ezbon, Eri, Arodi leh Areli ahi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Asher tapate, Jimna, Ishuah, Ishui Beriah leh anaunu uh Serah tualeh Beriah tapate, Heber leh Malkiel.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Laban in atanu Leah kunga apieh Zilpah tapate ahi uhi. Tamte aman Jakob dinga ahinnpieh mi sawm leh guhte ahi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tualeh Jakob zi Rachel tapate Joseph leh Benjamin ahi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tualeh Joseph in Izipt gamah tapa Manasseh leh Ephraim anei a, tuate khu On kho siempu Potiphera tanu Asenath in ahinnpieh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh Benjamin tapate Balah, Becher Ashbel, Gera, Naaman, Ehi, Rosh, Muppim, Huppim leh Ard ahi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tamte Rachel in Jakob dinga ahin pieh a tapate ahi, a bawn un sawm leh li ahi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan tapa, Hushim ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naphtali tapate Jahzeel, Guni, Jezer leh Shillem te ahi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tamte Laban in atanu Rachel kunga apieh Bilhah tapate ahi uh, aman tamte Jakob dinga ahinpieh ahi a bawnun sagi ahi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jakob tapate zite simlouin a tahsa a piengkhie Izipt gam a a lutpiteng bawnin mi sawm guh leh guh ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tualeh Joseph in Izipt gam a anei tapate ni ahi ua, Izipt gam a hinglut Jakob innkuonte zousie mi sawm sagi ahi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuachi’n Jakob in Goshen gam lampi kawhmu dingin Juda pen Joseph kungah a sawl masa hi, tuachi’n Goshen gamah ahing tungta uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n Joseph in a sakolleng mansa in ana koia, Goshen ah apa dawn dingin apeitou a, a kungah akigen a, tualeh a ngawngkawi a sawtpi a ngawnga kiluoi in akap hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tualeh Israel in Joseph kungah, “Hing leh dam a na mel ka mu kia tah ziehin, tuin vang ka shi lezong shi taveng,” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuachi’n, Joseph in, a sanggamte leh apa innsung mite kungah, “peitou vangin Pharoah kungah, ka sanggamte leh ka pa innsung mite Kanaan gam a umte ka kungah hing tungta uh chiin vahil vang” achi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaute belam chingmi ahi ua, gan khawimi ahi ziehun, tualeh a belam honte u’leh a bawng honte u’leh anei alam zousie uh ahing puo uhi chiin vagen tavang achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh hichi hing hivanin, Pharoah in ahing hat a noute, bang nasem na hi uoi chia ahing doh chiengin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na suohte sepna pen kou leh ka pu ka pate ua kipanin ka neu lai ua pat tu dongin gan khawimi kahi uh nachi ding uhi. Tuachi’n Goshen gamah na teng thei ding uhi, achi hi. Aziehpen belam chingmi pouma Izipt mite dingin kidahhuoi ahi.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n, Joseph Pharoah kungah “Ahing pei a, a kungah ka pate, ka sanggamte a belam honte uh, a bawng honte uh, tualeh anei alam zousie utoh Kanaan gam a kipat ahing pei ua, tualeh tu’n, Goshen gamah aumta uhi” achi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh, aman a unaute lah a mi nga azawpi a, Pharoah mai ah akilah sah hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Pharoah in a sanggamte kungah, “Bang nasemmi na hi uoi?” achi hi, Amaun Pharoah kungah, “Na suohte ka pu ka pa ua kipat a belam chingmi kahi uhi” achi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh amaun Pharoah kungah, “Ka ganhonte uh neh ding aumlou ziehin na suohte na gam a umtadi dingin ka hing pei uhi. Kanaan gam kiel akhawh seng ziehin. Tuaziehin hepitahin na suohte Goshen gam ah hing teng sahin” achi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Pharoah in Joseph kungah, “Na pa leh na unaute na kungah a hing peita uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Izipt gam na masang ah aum hi, gam sung hoina mun pen Goshen gamah na pa leh na unaute tengsah inlen, tualeh alah ua mi silbawlthei tah nathei leh ka ganhonte tungah houtuin koiin” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tualeh Joseph in apa Jakob a zawpi a, Pharoah masangah ading sah hi, tualeh Jakob in Pharoah a guolzawl a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Pharoah in Jakob kungah “Kum bangza na hi tai?” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jakob in Pharoah kungah “Ka khuol zinna hun sung kumte kum za leh sawmthum ahi ta a, ka dam sung kumte a tawma, hinanleh genthei ahuoi hi, ka pu leh pate akhuolzin lai ua a dam kum tan zong ka pha nai sih hi,” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Jakob in Pharoah aguolzawl kia a, Pharoah masang apat a peikheta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuachi’n Joseph in apa leh a unaute Izipt gamah tenna a bawl pieha, Pharoah thupieh bangin gam sung hoina pen ah Rameses gam agou tan dingun apeta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n Joseph in apa leh a sanggamte leh apa innsung mite zousie a innkuon dungzui in neh ding apie a, avaa ta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh gam sung zousie ah neh ding mawngmawng aumta sih hi, kiel akhawh seng ziehin, tuachi’n Izipt gam leh Kanaan gam zousie kiel ziehin agim gawpta uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Joseph in Izipt gam sung leh Kanaan gam sung zousie bu lei na man sum zousie adon pieh sienga, Pharoah inn ah ahing tawi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n Izipt gam leh Kanaan gam sunga sum zousie ahing bei bepin Izipt mite zousie Joseph kungah ahing pei ua, “Ann hing piein bang dinga kiel shi ding ka hi uoi? ka sum ulah abei siengta hi achi” uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Joseph in “Na gantate uh hing pemai un, sum nanei nawnsih u’leh, na gantate uh manin bu kang peding,” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n agante uh Joseph kungah ahing kai ua, Joseph in sakolte man ding, belam honte man ding ganhonte man ding, bawnghonte manding leh sabiltung man dingin neh ding ana pe zela, tuami kumin agantate uh manin amauh neh ding a pie a, avaa chiet hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua kum ahing beita a akum kia in a kungah ahing peikia ua, “Ka sumte uh ka zah bei dan uh ka pu uh kungah imsih va ung, ka pu un ka ganhonte uh na tangta a, ka tahsa u’leh ka gam uh chilou ka pu uh mitmu in bangma aum nawn vawtsih hi.’
  </para>
  <para style="p">
    <verse number="19" style="v" />Bangzieh a kou leh ka gam uh na mitmu a shi ding ka hi uoi? kou leh ka gam uh ann manin hing lei maiin, tuachi’n kouma leh ka gam uh Pharoah suohte himai va ung; tuachia shilou a ka hin thei na ding un, tualeh gam asiet louna dingin bu chi hing pie in” achi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Joseph in Izipt gam tengteng Pharoah dingin alei pieh a, kiel anat seng ziehin michin in alou uh azuata uhi. Tuachi’n gam zousie Pharoah gam ahi siengta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tualeh mite pen Izipt gamgi tawpna langkhat apat alaang khat dongin khopite ah abawnun akisuon ta uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Siempute gam pen aleipieh sih a, aziehpen Siemputen Pharoah in apieh tanvou anei ua, Pharoah in apieh a tanvou uh ane ua, tuaziehin ama un agam uh azua sih uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Joseph in mite kungah, “Ngaivawi un, tunin nouma leh na gam uh Pharoah dingin ka hing leita a, envawi un, tanah bu chi nou ading aum hi, tam gam ah na tu ding uh hi, achi hi.’
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh bu lah hun chiengin tambang ahi ding hi; Pharoah a dingin Se-nga-suo sekhat na pe ding ua, Seli teng nou a ahi ding, tuapen na lou buchi ding uh, na neh ding uh, nouma leh na innkuonpite uh neh ding, nata neute uh neh ding, ahi ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuaziehin amaun, “Nang ka hinna uh nang humbit piehta a, ka pu uh mitmu ah hepina hing musah inlen, tuachi’n Pharoah suohte hi mai va ung” achi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tualeh Joseph in, Pharoah in se-nga suo sekhat atan ding chi Izipt gam pumpi ah tuni dongin danin a bawlta hi. Siempute gam pen ahileh Pharoah a hilou.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuachi’n Israel khu Izipt gam a Goshen gamah atengta a, tuanah innbul tahin aumta uhi. Tualeh chi tampi suongin nasatahin a khang ua apungta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tualeh Jakob Izipt gamah kum sawm leh sagi a tenga, tuachi’n Jakob damsung pumpi kum za leh sawmli leh sagi ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tualeh Israel khu ashi hun ding ahing naita a, tuachi’n atapa Joseph ahan a, a kungah, “Tuin na mitmu a hepina katan leh, hepitahin na khut ka malpi neiah gol inlen, ka tungah boh in, Hepitahin Izipt gamah hing vui mawngmawng sin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hinanleh, ka pu ka pate kungah lum vangin, Izipt gam a kipat na hing paw ding ua, tualeh akivuina mun uah na hing vuizaw ding hi achi hi, khumin aman na gen bangin ka hing bawl ding” achi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualeh aman ka kungah “Kichiem in leh;” achi hi, tuachiin a kungah a kichiemta hi, Tuachi’n Israel khu lupna luhung ah akunsuh ta hi.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh tam silte nuain hichi ahing hi a, Joseph kungah “En in, na pa achina ahi” chi’n ahil ua, tuachiin aman a tapa tegel Manaseh leh Ephraim a zawpi a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Jakob kungah “Envawi, na tapa Joseph na kungah ahing pei hi” chiin ahil ua, khumin Israel ahing hal a, lupna tungah atouta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuachi’n Jakob in Joseph kungah, “bangkimbawlthei Pasian khu Kanaan gam a Luz khuo ah ka kungah ahing kilah a, ahing guolzawl hi.’
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka kungah hahlesuon tampi ka hing neisah dinga, ka hing pungsah nalai dinga, nangma apat Nam tampi ka siemdoh ding, tualeh tam gam pen na nua a nahah nasuonte kungah a kumtawn goutan dingun ka pe ding hi ahing chi hi.’
  </para>
  <para style="p">
    <verse number="5" style="v" />“Tualeh tuin na tapa nite Izipt gam a na kunga ka hing pei masanga Izipt gam a na neite Ephraim leh Manaseh kei a ahi, Reuben leh Simeon mabangin keia ahi ding uhi.’
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh amauh nua a na hinte nanga hivanin, a goutan uah a ute uh min akikop mai ding uhi.’
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinanleh kei ka hileh Padan gam apat a ka hing pei laiin Rachel Kanaan gamah lampi ah Ephrath khuo tunna ding nainou khat aum laiin ka kungah ashita a, khummun Ephrath khuo lampi ah ka vuita hi.” (Tuami Bethlehem ahi) achi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuachi’n, Israel in, Joseph tapate a en a, “Tamte koite ahiei?” achi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh Joseph in apa kungah “Tam mun a Pasian in ahing pieh ka tapate ahi uh,” achi hi. Tualeh aman, hepitahin ka kungah “Hing puiin, amauh guolzawl vang” achi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuin Israel mit pen a upat tah ziehin amiel ta a, tuachi’n amuchien thei tasih hi, Tualeh amauh a kungah ahing pei ua, aman ana tawpa ana pom hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh Israel in Joseph kungah, “Na mel muding kilam en nawnlou hinga, hinanleh envawi, Pasian in nahah nasuon nasan ahing musahta hi” achi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualeh Joseph in atapate apa pheipi kaal apat in a puikhie a, amai ah lei suin akunta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualeh Joseph in amautegel akai a, akhut zietlam in Ephraim khu Israel khut veilam pangah a koia, Manaseh pen akhut veilam in Israel khut zietlam pangah ahing koi nai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuachi’n Israel in akhut zietlam phongin a naupang zaw Ephraim lutung ah anga a, akhut veilam Manasseh lutung ah anga hi, a theisa in akhut in asawh kokal a, Manasseh lah ta upa zaw ahi ngal a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh aman Joseph a guolzawla, “Ka pu leh pate Abraham leh Isaak masanga aum zingna Pasian, tuni donga ka dam sung ni teng teng hing vahpa Pasian,
  </para>
  <para style="p">
    <verse number="16" style="v" />Sietna teng teng laha kipata hing tanpa Vansawlsiengin naupangte guolzawl ta hen. Ka min leh ka pulepate Abraham leh Isaak min amauh min in puo u henlen, tualeh leitung ah mipi thupitah hi dingin hing khang uhen” achi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualeh Joseph in Ephraim lutunga apan akhut zietlam akoi amu tahin a lungkim tasih a, Ephraim lutunga pat Manasseh lutunga koi dingin apa khut adom kanga.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tualeh Joseph in apa kungah “Pa tambang ding ahisih, tampa hibou ta masa, nakhut zietlam a lutungah koiin,” achi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hinanleh apa a utsih a, “Ka tapa aw ka theina hi, amazong nam khat ahing hi dinga, ahing thupi ding hi, hinanleh anaupa pen ama sangin thupi zaw vanin, ahah asuonte pen nam tampi hing hi va uh” achi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuachi’n Jakob in “Israelten Ephraim leh Manasseh bangin Pasian in nang hing umsah hen,” chi’n nouma min louin ahing guolzawl zel ding uh chi’n tuani in amaute a guolzawl a. Tuachi’n Ephraim khu Manasseh masangah a umsahta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuachi’n Israel in Joseph kungah, “Ngaiin, shi ding ka hita a, hinanleh Pasian in nang hing umpi vanin, na pulepate gamah hing puilut kia ding hi.’
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuathamlouin na unaute tanvou sangin tankhat in ka hing petuon hi, ka namsau leh ka thalpi a Amormite khuta kipat ka lah pieh pen khu” achi hi.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tualeh Jakob in a tapate a han a, tambangin agen hi, “Ni nukhia lam chienga na tung ua sil hing tung ding ka hing hil theina dingin hing kikhawm un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nou Jakob tapate aw hing kikhawm unlen, ngaikhie un, na pa uh Israel thu ngaiun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Reuben nang kata masa, ka sil bawl theina, ka hatna kipatna na hi, a sangpen hina leh thuneina nanga ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh tuibanga detlou na hia, tungnung pen hina na nei sih ding hi, napa lupna tunga na kal ziehin na buasah ta hi, ka lupna ah akal hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon leh Levi unau ahi ua, gitlouna vanzahte khu atenna uah a um hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw ka hinna, nang vang akithukupna uah kigol sinlen; ka thupina nangpen a kikhopna uah pang sin, a lungthah un mi athat ua, aluhlul un bawngtal thahui asatbai uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Alungthah na uh zauhuoitah ahi ziehin, ham sietin um henlen, a thangpaina u’zong hamsiet in um tahen, hinsetah ahi ziehun, Jakob sungah amaute ka khenkhe dinga, tualeh Israel sungah ka thethang ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Juda nangpen na unauten ahing phat ding ua; na khut zong na galte ngawng ah na nga dinga: na pa tate na masangah kunva uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Juda khu Humpibahnei nou ahi; ka tapa na samat na peitou santa hi; na kun a, Humpibahnei bangin na boh a, tualeh Humpibahnei nu bangin koi ahiei ama phawng ngam ding?
  </para>
  <para style="p">
    <verse number="10" style="v" />Lengchieng pen Juda toh kikhen sih vanin, dan pepa chieng zong akeng kaala kipat pawtmang vawtsih va, Shiloh ahing tun masang sie; tualeh nam chinin ama thu amang ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A sabiltung grep kungah khi vanin, a sabiltungnou a grep kung deitel ah khiva, a puon silte greptui in sawp vanin, tualeh apuon zalte grep sisan in asawp nalai ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mitte greptui a san sahin aum dinga a hate bawngnawi a vamsah in a um ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zebulun tuipi geiah teng vanin kuong khawlna luipieu ahi dinga, a gamgi Sidon tandong ahi ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Issakar pen van gih lomni kikaal a kuol sabiltung hattah ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khawldam hoiin a thei a, tualeh gam zong nuomin athei hi, van po dingin alieng angiemsah a, paubawl a nasepsah ding suoh ahing hita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dan in Israelte lah ah nam khat bangin a mite avaihawm pieh ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan khu lamgei a gul um, lamlai a gulngan sakol kengpawng tuh pieh a, sakol tungtuong mi, a nua langa kithalngase a, thalkiehsahpa ahi ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Mangpa, na hundamna ka ngah zing hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gad pen galhon in asim ding ua, hinanleh atawp ah aman anua del ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asher khu aneh hoi vanin, leeng ann neh tuitah tah a piengsah ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nephtali pen Sazuhpi kihazan ahia, thu hoi tah tahte agen zel hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph khu gui ga nuomtah tuikhuh kunga pou, a bate a baang tunga zam, hieng ga nuomtah ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thal kap miten ama nahpitahin asu genthei ua, akap ua, a muda uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hinanleh ama thal mung pen khautahin aum ngitnget a, akhut banthahat khu Jakob Pasian khut hattahin asuhat a, (Khuna pat Belampu, Israel suongpi ahing um hi.)
  </para>
  <para style="p">
    <verse number="25" style="v" />Na pa Pasian nangma hing panpi ding, bangkimbawlthei pa, Tunglam van guolzawlnate leh Nuoilam a kipha Tuipi thuhtah guolzawlnate nawite leh naubu guolzawlna a nang hing guolzawl ding pa ngei khu suh hat in aum hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na pa hing guolzawlnate in kei hing suongtute hing guolzawlnate, tangtawn muol tawptan dongin a khup zawta hi; tuate khu Joseph lutungah um vanin, a unaute akipat khentuom a umpa lusip ah aum ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Benjamin pen Ngie gongsan ahia, zingmawng in asa kei ne vanin, nitah lam chieng a gallah vante ahawm ding hi.”
  </para>
  <para style="p">
    <verse number="28" style="v" />Tamte zousie Israel nam sawm leh nite ahi ua, tualeh tampen apa un akung ua a thugen leh a guolzawl nate ahi; Guolzawlna a tan ding bang chiet un a guolzawl hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuachi’n amaute thugousie apie a, akung uah, “Ka chi pite kunga puia um ding ka hita a. Hitmi Ephron lou a um kokhuh ah ka pu leh pate kungah hing vui un.’
  </para>
  <para style="p">
    <verse number="30" style="v" />Kanaan gam a Mamre mazawn a, Makpelah loua kokhuh Abraham in kivuina mun gou dinga Hitmi Ephron akipata alou toh alei khawm ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khummun ah Abraham leh azi Sarah avui ua, tuanah Isaak leh a zi Rebekah avui uhi, khunah ken zong Leah kana vuita hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lou leh a sunga um kokhuh Heth tate apat a kilei ahi,” achi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tualeh Jakob in a tapate kunga thugou a siepieh zouin a kengte lupna tungah anga tou a, ashita a, a chi pite kungah puiin aum ta hi.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuachi’n Joseph in apa mai leh amai sutuoin, a tawpa a kapta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh Joseph in a suoh damdawi siemte apa luong muot theilou a bawl dingin thu apie a, tuachi’n daktorten Israel luong pen amuot theilou dingin a bawlta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A luong bawlna in ni sawmli alut a, tuabanga muot theilou dinga a bawlna in ni tuaza lut zel mawng ahi. Tualeh Izipt miten ama ni sawmsagi asuun uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tualeh ama kaana nite abei nua in, Joseph in Pharoah innsung mite kungah “Tuin na mitmu ua deisahna katan leh hepitahin Pharoah zah ah thu gen un.”
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai un, ka pa’n “Shi ding ka hita, Kanaan gam a ka han dinga ka tawsa ah, khum mun ngeiah na hing vui ding ahi’ chi in ahing kichiemsah hi, tuaziehin, tun hepitahin hing peitousah inlen, ka pa hing vuisah in, tualeh ka hing peikia na ding hi, chiin hing genpieh un,” achi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tualeh, Pharoah in, peitou inlen, ahing kichiemsah bangin na pa va vuita in achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuachi’n Joseph apa vui dingin a peitouta a, tualeh ama toh Pharoah suohte zousie leh a innsung upate Izipt gam upate zousie.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualeh Joseph innsung mite zousie leh a sanggamte leh apa innsung mite zousie a peitou uhi. A ta neunoute u’leh a Belamte u’leh a bawng honte uh maimai Goshen gamah anuasie uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tualeh ama toh kangtalai leh sakol tungtuong mite apeitou khawm ua, honchingtah ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n Jordan gal a um Atad phuol mun ahing tung ua, tuanah kap leh mauin thupitahin ni sagi sung apa suunna abawl uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tualeh tua gam a teng Kanaan miten Atad phuolmun a suunna amu un, “Tam pen Izipt mite dingin mishi suunna huoisetah ahi,” achi uhi. Tuaziehin tua mun min dingin Abel-Mizraim achita uhi. Tuami Jordan gal a um ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuachi’n a tapaten a thupieh bang zelin, abawl piehta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aziehpen a tapaten Kanaan gamah a zawnglut ua, Abraham in kivuina mun gou dinga Hitmi Ephron akipat a alou toh alei khawm, Mamre mazawna um Makpelah lou a kokhuh ah avuita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualeh Joseph in apa avui zouin ama leh a unaute toh apa vui dinga hawtou teng toh Izipt gam ah ahing kile kiata uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tualeh Joseph sanggamten apa uh shita chi ahing ngaituo bep un “Joseph in hing muda vanin, a tunga sil gilou ibawl zousie itung uah phuba hing la khava” achi ua.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuachi’n Joseph kungah patong asawl ua, “Na pa’n ashi masangin tam bangin thu hing pie hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuachi’n Joseph kungah na gen ding uhi; hepitahin tuin na sanggamte khelna leh mawnate ngaidam in, aziehpen na tungah sil gilou abawl uh ahi. Tuaziehin tuin ka hing ngen uh ahi, na pa Pasian suohte khelna ngaidam in chiin achi ua, tualeh akung a thu agen lai un Joseph akapta hi.”
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachi’n a sanggamte zong avapei ua, amasangah akhupboh ua “Ngaiin na suohte ka hi uh” achi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Joseph in akung uah, “Zau sih un aziehpen kei Pasian thaheng a um ka hiei mah?
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinanleh nou vangin ka tungah sil gilou nana ngaituo ua; ahivangin Pasian in tuni bangin, mi tampite hingledam a a humbitna dinga silhoi tunna dinga ana ngaituo zoh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuaziehin zau vawtsih un, nouma leh na ta na naute uh ka hing vaa nading hi” achi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n Joseph pen ama leh apa innkuonpite toh Izipt gamah a teng ua, tualeh Joseph kum za leh sawmli adam hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tualeh Joseph in Ephraim tate akhang thumna dong amu a, Manasseh tapa Makir tate zong Joseph pheitungah akhang lien uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tualeh Joseph in a unaute kungah, “Shi ding ka hita hi, hinanleh Pasian in noute ahing ve ngeingei dinga, tualeh tami gam akipat ahing puikhe dinga, Abraham, Isaak, tualeh Jakobte kunga pieh dinga achiem gamah a hing puilut ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachi’n Joseph in Israel tate akichiem sah a, “Pasian in noute ahing ve ngei ngei dinga, tualeh ka gute tana kipat in na potou ding uhi,” achi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuachi’n Joseph kum za leh sawm a upa ahi in ashita hi; tualeh aluong muot theilouna in abawl ua, Izipt gam ah hankuong ah akoi ta uhi.
  </para>
</usx>
