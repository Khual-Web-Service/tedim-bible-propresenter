<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Thupilte</book>
  <para style="h">Thupilte</para>
  <para style="toc1">Thupilte</para>
  <para style="toc2">Thupilte</para>
  <para style="mt">Thupilte</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel leengpa David tapa Solomon thupilte:
  </para>
  <para style="p">
    <verse number="2" style="v" />Pilna leh kithuhilna theina ding, theisiemna thugil thute theikah ding;
  </para>
  <para style="p">
    <verse number="3" style="v" />pilna, thudihna, vaihawmna, leh khentuom neilou a thuhilna pomdan siemnate,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi mawlte kunga pilna tualeh khanglaite, kunga theina leh lunggelsiemna, thuhilna dingin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Mipilten zong tam thu azah ua, atheina uh akibelap na ding leh theisiemna nei mi in, thuhilna piltah anei theina ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thupilte leh ahilchiennate, mipilte thu leh athugil gente uh akhiehna theisiemna ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mangpa giin khu theina kipatna ahi a, hinanleh mi moten pilna leh thuhilna asimmaw uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka tapa na pa thuhilna ngaikhie inlen, na nu thuhilna kiheisan sin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na lutanga dingin pahkhi kilawmtah ahi dinga, na ngawng a dingin khigui hoitah ahi ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka tapa mikhielten ahing zawl chieng un, zop sin.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Amaun hing zuiin, sisan suo dingin mi buh vaiin, azieh beiin mawnaneiloute buhdap vai;
  </para>
  <para style="p">
    <verse number="12" style="v" />Sheol bangin ahingtangun pumval vai in, kokhuh a kesuhte bangin inawmval ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Van manpha namkim ilahpieh dinga, gallah vante inn dim in ikoi ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Koute lah ah hing tel inlen, isumbawmte uh ikitaang ding uhi,” achi chiengun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tapa alah uah va tel sinlen, alampite ua pat kihemkhie in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aziehpen akengte un sietna lam anaw del a, sisan suo dingin akinaw uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vate muna a lenthang zah khu amawhna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hinanleh tuabang miten amauh sisan ma abuh ua, ahinna uh buhdap ahi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Punna dihlou a huoiham poumate lampi khu tuabang ahi a, aneitute hinna alah pieh zel hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kholai ah pilna akikoua, gawlzing tengah ngaitah in akikou hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mitamna mun pente ah akikou a, khopi kulpi kotkhate ah thu agen hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Nou mi mawlte aw bangtanvei mawl ut nalai na hi uoi? Mi nuoisieten bangtanvei ami nuoisie bawlna kipah ding ahi uoi? Tualeh mi moten pilna bangtanvei ho nalai ding ahi uoi?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka phawhhilna langah hing kihei un, na tung uah ka hagau ka sungbaw dinga, na kung uah ka thute ka hing theisah ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aziehpen ka hing hat laiin, na hing nuol ua, ka khut ka zah a, koiman na ngaisah sih uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka hing thuhilna zousie na nelsie siengta ua, ka hing phawhhilnate khatbeh na zui nuomlou zieh un;
  </para>
  <para style="p">
    <verse number="26" style="v" />Ken zong na tuohsietni chieng un kang nuisan dinga, na zau a nachimaw chieng un kang engbawl nalai ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na zauna un khopihui banga ahing nawh chiengin, tualeh tuohsietna in pingpei banga noute ahing phah chiengin, Lunggimna leh chimawna na tung ua ahing tun chieng in;
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuabang hun chiengin keima ahing han ding ua, hinanleh amauh ka dawng sih dinga, pawnthaw tahin kei ahing sui ding ua, hinanleh ang musih ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aziehpen amaun pilna ana hota uh a, Mangpa giin khu atel sih uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka thuhilna khatbeeh zong adei sih ua, ka phawhhilna a simmaw uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuaziehin agamtatna ga uh ane ding ua, angaituonate mama uh amauh tungah akibung sieng ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aziehpen mi mawlte kiheimangna in amauh athat dinga, mi mote lawchinna in amauh asumang ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hinanleh ka thu ngaikhe pouma bittah in a um ding ua, silhoilou zauna neilou in lungmuong tahin a um ding uhi.”
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa ka thute na san a, ka thupiehte na lungsunga na kholkhawm a,
  </para>
  <para style="p">
    <verse number="2" style="v" />pilna lam a nabil nadaw a, theisiemna lam a na lungtang na ngat leh,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahi, theikah siemna theinuom a na kikou a, theisiemna aw ngaitah suo a na hat leh,
  </para>
  <para style="p">
    <verse number="4" style="v" />Dangka banga na sui a, gou kiphum banga na sui chien a ahileh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuachi’n Mangpa giindan na hing theisiem dinga, tualeh Pasian theina na mudoh ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aziehpen Mangpa’n pilna apie a, akam a pat in theina leh theisiemna ahing pawt hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman midihtat a dingin pilna dihtah akholkhawm a, dihtat taha gamtate a dingin ama khu lum le-phaw ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman dihtatna lampite avenga, tualeh Amisiengthoute lampi avengbit pieh zel hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuachi’n dihtatnate leh thudihnate, tualeh vaihawmna siemnate, deisahtuom neilounate na hing theisiem ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pilna na lungtang sunga ahing lut chiengin, na hinna in theina nuom asah hun chiengin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Sie leh pha khensiemna in nang ahing kembit dinga, theisiemna in nang ahing kem ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pilna in migiloute lampi akipat leh, thusie ngen gente akipat ahing hunkhe ding hi,
  </para>
  <para style="p">
    <verse number="13" style="v" />Mielna lampi a pei dingin, dihtatna lampite anuasie uh a,
  </para>
  <para style="p">
    <verse number="14" style="v" />Silgilou bawl khu akipahna uh ahi a, tualeh silgilou bawlte kipahpi mite,
  </para>
  <para style="p">
    <verse number="15" style="v" />Alampite uh akawi a, gamtat uh kawi mite lah a kipat leh,
  </para>
  <para style="p">
    <verse number="16" style="v" />Numei gamtat thanghuoi leh, kam zol zuou gensiemte lah akipat in, ahing hunkhe ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama nu’n asenlawm ngai anuasie a, a Pasian thuhunte amanghilta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aziehpen a inn shina lam anga a, amanu lampi khu shina ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amanu kunga va hawkha pouma anua peikia nawn sih ua, hinna lampite amankha kia nawn sih uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi hoite lampi a na pei a, midihtatte lampi na zui theina ding in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aziehpen midihtatten gamsung aluo ding ua, mi hoibukimte’n gam aluo den ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hinanleh migiloute pen gamsung akipat suhmang ahi ding ua, tualeh mi ginumloute tua gam akipat akibotdoh ding hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa ka thuhilna manghil sinlen, ka thupiehte na lungtang in kem heh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aziehpen tuaten na damsung ni leh kumte, asausah dinga lungmuonna kiningching, ahing pieh belap nalai ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khotuona leh thutah hasuo sinlen, na ngawngah viel inlen, na lungtang suongpeh tungah giel in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuachi’n Pasian leh mihing mitmu ah deisahna leh, ngaisangna na nga ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na lungtang zousie in Mangpa muong inlen, nangma theina ah kinga sin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na lampi zousie ama theisah in, tuachi’n Aman na lampite atangsah ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangma theina toh kipilsah sinlen, Mangpa giing inlen, gilou taisan in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tami na tahsa pumpi a dingin damna ahi dinga, na gute adingin hatna ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na nei nalam leh na louma a gamasate zousie in, Mangpa pahtawi in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuachi’n na annbuhte khu bu in ahing dimlet dinga, na belpi liente zong uoin tha in adimlet ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka tapa Mangpa phawhhilna ngaidau sinlen, ahing suhdihnate zong chimtah sin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aziehpen pa in apahtat atapa athunun bangin, Mangpa’n a itte ahoina dingun aphawhhil zel hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilna mu khu mi hampha ahi a, theisiemna mu mi khu mi nunnuom ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aziehpen dangka sum nei sangin aphatuom zaw a, tualeh apunna zong sana siengset sangin ahoizaw hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilna khu suongmanpha rubi sangin amanpha zaw a, tualeh na deithusam a na lunggulte toh zong, tekah thei guol ahi sih hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A khut ziet lam ah damsawtnate a um a, akhut veilam ah hausatna leh pahtawinate a um hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama lampite khu lungnopna lampi ahi a, tualeh alampite zousie hamuonna lampite ahi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama tuchintente a dingin hinna sing ahia, ama nei denten nuom asa uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mangpa’n pilna in leitung amukhie a, theisiemna in vante asudet hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Atheina in tuithuhtahte apohkeh sah a, meilumten vandaituite atakhe sah hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka tapa na mitte akipat in tamte peimang sah sinlen, pilnagil leh sie leh pha khensiemna kem ngitnget in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuachi’n na hagau a dingin hinna ahi dinga, na ngawnga dingin kizepna kilawmtah ahi ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuachi’n na lampi ah bittah in na pei dinga, na keng na sui sih ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na lup chiengin na zausih dinga, na i mut atui ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thakhat a patauna zau sinlen, migiloute tunga sietna ahing tun chiengin zong zausin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aziehpen na lungmuonna Mangpa ahi dinga, na keng awhlouna dingin aveng ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na bawl thei ahi nahpou leh, a tang dinga kilawmte silhoi it sin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na nei nah pouleh, na innveng kungah “Pei phot inlen, zing chiengin hing hawkia in hing na pevang,” chi’n nuasawl kia sin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na innveng in nang hing muonga, na kunga teng ahiziehin asietna ding ngaituo sin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na sietna ding bangma abawl sih pouleh, azieh bei in mi toh kihau sin.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thagum suo mi eng sinlen, agamtatnate uh khatbeh zong zuisin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aziehpen mi tatsete Mangpa’n akidah a, hinanleh midihtatte pen athuguh kem dingin zong amuong nalai hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Migiloute innsung ah Mangpa hamsietna a um a, hinanleh midihte innsung aguolzawl hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Misimmawhatte aman asimmaw ngei ngei dinga, mi kingaingiemte kungah hepina apie hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mipilte’n thupina aluo ding ua, hinanleh zumna khu mi mote kaisanna ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tate aw, pa thuhilna ngai unlen, theisiemna thei dingin lungluttah in ngai un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aziehpen ken thuhilna hoitah ka hing pie hi, ka dan taisan sih un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka pa tapa ka hi a, ka nu mitmu a adeithaw ata neisun ka hi nalai in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka pa’n ahing hil a, ka kungah, “Na lungtangin ka thute kem inlen, ka thupiehte zui inlen, hing in, ahing chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pilna nei inlen, theisiemna nei in, ka kam a thute manghil sinlen, ki heimangsan sin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pilna taisan sih pou lachin ahing kembit dinga, pilna it lachin aman ang veng ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pilna athupi masa pen ahi a, tuaziehin pilna nei inlen, na nei zousie pum in theisiemna nei in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pilna pahtawi lachin aman nang ahing tawisang ding hi, na pom chinten pouleh aman zatatna ahing peding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na lutanga dingin hepina kizepna ahing khipsah dinga, thupina manglukhu ahing khusah ding hi.”
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka tapa aw, ka thugente ngai inlen zuiin, tuachi’n na damsung kumte a sawt ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ken nangma pilna lampi ka hing hil a, lampi dih ah ka hing pui hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na pei chiengin na kalsuon ahasa sih dinga, na tai chiengin na kisuikha sih ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thuhilna tukip chinten inlen, hasuo vawt sinlen, kem in, aziehpen na hinna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Migiloute lampi ah lut sinlen, mi hoiloute lampi ah zong pei sin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua lampi zui sinlen peel in, kiheisan inlen nuasie in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aziehpen migiloute’n silsie khat tei abawl sih u’leh, a imu thei sih ua, tualeh mi khat puana ding abawl sih u’leh, a imu thei sih uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aziehpen amauten gitlouna tanghou ane ua, thagumsuona uoin adawn uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hinanleh midihte lampi zingmawng khovah bang ahi a, sunlai nisa banga tangpha sem sem bang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Migiloute lampi pen a miel keikui a, banga kipal ahi uoi chi nangawn athei sih uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa ka thute ngaikhie inlen, ka thugente ah na bil daw in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na mitmu akipat in peimangsah sinlen, na lungsim sunggil ah kem in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aziehpen tuate mukhete adingin hinna ahi a, atahsa pumpi ua ding damna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bangteng sangin na lungtang kem hoi in, aziehpen tuana kipat a hinna tuinah hing luongkhie ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khelhamna kam koimang inlen, tualeh lepchiena kamte nanga kipat, gamlatah ah koimang in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na mit in na mailam tangtah in en inlen, na mit in na masang tangtah in en kilkel in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na kengin azui ding lampi ngaituopha inlen, tualeh lampi dih leh dette zuiin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zietlam ahiei, veilam ahiei ah zong piel sinlen, sietna lampi ah na kalsuon vawt sin.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa ka pilnate ah lunglut inlen, ka theisiemna thute ah na bil daw in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuachi’n theikah siemna na nei dinga, na kam in pilna akem thei ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aziehpen numei thanghuoi in akam khuoizu bangin ahum sah a, tualeh akam sathau sangin azol zaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinanleh atawp ah amanu aichimtangkha bangin akha a, namsau tattuo hiem bang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amanu keng shina lam zuon in apei suh a, a kalsuonten mishi khuo lam azuon hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinna lampi ngaisut louin, alampite a kawi a, amanu’n lah aphawh kha sih hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuaziehin ka tate aw tuin, hing ngaikhie unlen, ka kam a thupawtte apat kiheimang sih un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanu akipat in na lampi gamla pi ah peel inlen, a inn kot kung nai ah pei sin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua ahisihleh na zatat huoina midangte kungah na pekha ding a, tualeh na kumte u’zong migiloute kungah na pekha ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gamdang miten na nei nalam atang ding ua, na sep gimna in midangte ahausah ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Atawpna lam ah, na tel na vou ahing thawp chiengin, da leh kap in na um ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuahun chiengin “Bangdinga thuhilna kana huot a, tualeh ka lungtang in phawhhilna, Kana simmaw ata diei,
  </para>
  <para style="p">
    <verse number="13" style="v" />tualeh kei hinghil mite thu kana manlou a, ahing thuhilna lam a ka bil na daw lou kata diei;
  </para>
  <para style="p">
    <verse number="14" style="v" />tu’n lah mipi kikhawmte leh khawmpite, lah ah mangthai petma ding lah kata’n na chi pan ding uhi.”
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma tuibel a tui kidawn inlen, nangma tuikhuh a tuiluongte kidawn in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tuinah khu munchin ah a luong zah ding a, tualeh na lui tuite kholai a luongzah ding ahiei mah?
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuate khu nangma a maimai hisah inlen, midang toh kikop sin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na tuinah guol zawl in um henlen, tualeh na sen zi toh nuomsa in um in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amanu a etla huoi sazuh leh a it huoi sazuhpi bang hihenlen, anawi in nang bangchihlai pou in hing lungkim sah henlen, tualeh a itna in na lungsim kipahsah ngitnget hen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa aw bang zieh a numei thangtat a kilungkimsah kawi a, tualeh bangdinga numei kam zolnu ang na kawi lai zang ding adiei?
  </para>
  <para style="p">
    <verse number="21" style="v" />Aziehpen mihingte gamtatna Mangpa mit in amu ngitnget a, alampite zousie a enchien zel hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Migilou pen ama gitlouna thangkam ah a awh a, akhelna khau in ama aman hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kithuhilna tahsap ziehin ashi dinga, amot seng ziehin a piel mang ding hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa na innveng a dinga mawpotu a na pan a, gamdang mi vuohna dinga na khut na lap leh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma ham kamte ah na awh a, na kam a thupawtten ahing manta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka tapa tambangin bawl inlen, kihunkhedoh in, na innveng khutsunga awh na hitahzieh in, kintah in pei pai inlen, amasang ah kingiemkhieh inlen na innvengpa va lut in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na mit imusah sinlen, na mitte lusu sah sin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sabengmi khut a sakhi asuohtat bang in leh, thangkam mi khut a va apit khieh bangin nangma leh nangma kihunkhedoh in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang mithasie aw, mesite kungah pei inlen, agamtat dan uh ngaituo inlen pil in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amauten lamkai ahiei, hausa leh vaihawm anei vateh sih uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nipi laiin neh ding asutuo ua, tualeh pawltah chienga aneh ding uh akholkhawm uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Mithasie bangtan vei ahiei na imut ding a, imutna apat bang chih chienga thoudoh ding na hiei?
  </para>
  <para style="p">
    <verse number="10" style="v" />Bakhat imu tadivang, bakhat mitsing nalai vang, bakhat ka khut hing pheh tadi vang na chi sungin;
  </para>
  <para style="p">
    <verse number="11" style="v" />zawnna suomhat bangin ahing tung dinga, tahsapna in galvan a kivonmi bangin ahing lap ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miginalou, mi gilou khu thumanlou gen in avah kawi kawi a,
  </para>
  <para style="p">
    <verse number="13" style="v" />mit sih et in mi ahoupi kawi a, akengtawtat in thu agen a, akhutme in mi akawh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alungtangah gitlouna ngen a um a, silhoilou bawl ding ngen atum a, kituohlouna a pieng sah hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuaziehin atungah sietna thakhat in atung dinga, suhdam guollouin thakhat in asegawp ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mangpa’n ahuot sil guh a um a, kidahhuoi asah sil sagi a um hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuate khu, kisahtheina mit ha, lei zuouthei, mawna neilou sisansuo khutte,
  </para>
  <para style="p">
    <verse number="18" style="v" />gitlouna ngaituona lungtang, silgilou bawl dinga kintah a tai kengte,
  </para>
  <para style="p">
    <verse number="19" style="v" />zuou gen a theipitu dihlou, leh unau lah a kituohlouna piengsah mite.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa na pa thupieh zui inlen, na nu dan nuasie sin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lungtang ah viel ngitnget inlen, na ngawng ah khi ngitnget in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na peina lampi ahing hil dinga, na imut kaal in ahing veng dinga, na khanlaw chiengin ang houpi ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aziehpen thupiehte khu meivah ahia, tam dan khu vah ahi, tualeh thununna kihilna khu hinna lampi ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Numei thanghuoi lah apat nang ahing veng dinga, numei thangtat mi zawlsiem kamhum akipat.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na lungtangin amanu melhoina enla sinlen, a mitmei a azawlphah in um vawt sin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aziehpen kizuanu a dingin ann kamkhat giap bang na hi dinga, tualeh angkawmnu’n na hinna manphatah asui leng hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi’n apuon kasahlouin mei-am a angpom thei diei mah?
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi khat akeng kasahlou in mei-am tungah avah thei diei mah?
  </para>
  <para style="p">
    <verse number="29" style="v" />Koipou a innvengpa zi luppi mi khu tuabang ahi dinga, koipou amanu va khoikha mi khu mawnabei in a um sih ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Gilkiel a shi dinga kisa mikhat in agilva theina dinga, mi van aguh leh koiman asimmaw sih ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinanleh akimat khah leh pen ale sagi in adin ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Koipou numei toh angkawm pouma in theisiemna atasam a, tuabanga bawl mi in ama hinna asusie hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Liemna leh zumhuoina amu dinga, tualeh aminsietna akiphietmang sih ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aziehpen thangsietna khu apasal thangpaina ahi a, tua ziehin phuba alah ni chiengin bangma ahinkhawi sih ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman zangnadopna asang nuom sih dinga, amanbei a silpiehte in zong alungkim sih ding hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa thute kem inlen, ka thupiehte na lungsim sungah kholkhawm in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka thupiehte zui inlen hingin, ka dan khu na mitlaidum bangin kemin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na khutmete ah viel inlen na lungtang, suongpeh tungah giel in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pilna kungah “Ka sanggamnu na hi chi inlen,” theisiemna kungah, ka unaunu na hi chi in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuahileh amauten numei thangtat nu akipat, ahing kem ding ua, numei thangtat nu kam zol leh, kamhum mizawlsiem akipat, ahing kembit ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aziehpen ka inn kotta vathang kikaal awng, apat in ka en a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi mawlte lah a tangvalnou khat ka mu a, khanglaite lah ah theisiemna neilou tangvalnou khat ka mu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kizuanu umna inn kunga gawlzing ah, ahing pei a, tualeh amanu inn lam zuon in apei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nitah khomiel zui leh zan khomiel nuoi ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tualeh ngaivawi, kizua puonsil a kizem, lepchie lungtang puo numei khat in ana kimu ta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amanu ahi selsul a, agelsuoh a, akengte a inn ah a um det thei sih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khatvei teng gawlzing lah ah, khatvei teng kholai lah ah a um kawi a, tualeh mi inn ning kawmkaal teng ah, mi adap ngah kawi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuachi’n amapa aman a atawpa, zum maw mel tah in akung ah thu agen hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Lemna sillatte ka kungah aum a, tuni’n ka thuchiemte ka tangtung sah hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuachi’n nangma mu dingin ka hing pawtdoh hi; phatuomngai tah in ka hing sui a, ka hing muta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka lupna tungah puonpha hoitah ka phata a, singthal te ka lupna tungah ka theta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Agimnamtui mama murate, aloete leh singthal te ka lupna tungah ka theta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hing pei inlen zingmawng khovah dong iki-itna, lungchim tahin izang khawm ding a, i ki-itna in ikilungnuom sah tuo ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aziehpen ka pasal ka inn uah a um sih hi, khuol gamlapi a zin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman dangka ip apuo a, ha lia laitah chiengin ahing tung bep ding hi,” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amanu’n akamsiem in amapa azawlzouta a, akamdam toh azawlpua zouta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua tangvalnou in ama adap zui pai a, bawngtal in a thatpa anua zui bangin, ahisihleh mimo apilna dinga, kol kibul dinga apei bangin,
  </para>
  <para style="p">
    <verse number="23" style="v" />leh thaltangin asin akap pailet masangsie, ashina ding ahilam theilou a, thang baw a leeng va bang ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaziehin nou ka tate aw, ka thu ngaikhie unlen, ka kam a thupawtte lunglut tahin ngai un;
  </para>
  <para style="p">
    <verse number="25" style="v" />khum minu lam zuon in na lungtang uh, kihei sah sih unlen, Amanu lampi zui in, lampiel kha vawt sih un.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aziehpen tuabang numei in mi tampi aliemsa in apuasahta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanu inn pen hankhuh zotna lampi ahi a, shina pindante zotsuhna lampi ahi bou hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pilna akikou sih amah? tualeh theisiemna ngaitah in akikou sih amah?
  </para>
  <para style="p">
    <verse number="2" style="v" />Pilna muol sang tungah adinga, lamka thuom tengah ading hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khopi lutna kotpite ah leh khopi lutna, kotkhate ah pilna akikou hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Mihingte aw noute hing han ka hi, mihing tapate han a ka aw suo ka hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw nou mi mawlte in pilna theisiem unlen, nou mi mote aw, theisiemna lungtang nei un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai un, silhoipente gen ding ka hi, ka kam akipat thudih hing pawtkhe ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aziehpen ka kam in thudih agen dinga, ka muh a dingin gitlouna khu kidahhuoi ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka kam a ka thugen zousie dihtatna ahi a, thu kawi leh thugilou a um sih hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A theisiemte adingin ka gen zousie akichiena, theina mute adingin adih sieng kei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dangka sangin ka thuhilna tel zaw inlen, sana siengset sangin theina tel zaw in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aziehpen Rubi suong manpha sangin, pilna amanpha zaw a, na lunggul thei sil dang bangma toh, tepi thei guol ahi sih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei, pilna khu pilvanna toh ka tengkhawm a, theina leh sie leh pha khensiemna zong ka nei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mangpa giin khu gilou huotna ahi a, kiletsahna, kisahtheina leh gamtat hoilou leh, zuou genna kamte ken ka huo hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thuhilna leh pilnagil kei a ahi a, kei theisiemna ka hi a, hatna ka nei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima vangin leengten vai ahawm ua, vaihawmten danthupieh dihna abawl uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keima vangin leengtapate leh, miliente tualeh vaihawmte zousie in, leitung vai ahawm uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kei hing itte ka it a, phatuom ngaitah a hing suiten ahing mu ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hausatna leh zatatnate ka kungah aum a, sawtpi dai hausatna leh dihtatna kei a ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka gasuote sana sangin ahoi zaw a, Ahi, sana siengset sangin zong ahoi zaw hi; tualeh ka sepsuo teng dangka sangin amanpha zaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dihtatna lampi ah ka pei a, thudih lampite ka zui hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kei hing itte hauna ka luosah a, tualeh a goubawmte uh ka dimsah hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mangpa’n anasep apatchil a kipat in kei ahing neita a, tanglai a anasep apat masang nangawn in,
  </para>
  <para style="p">
    <verse number="23" style="v" />kumtawn a kipat in, achiil a kipat in, ahisihleh leitung um masang nangawn a zong, phudet kana hita hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuithuhpite um masangin lahdoh kana hita a, tuikhuh tui a dimte um masang tham in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Muol leh taangte adin masangin, kei ka umzouta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Leitung leh gamte ahisihleh leivuite, akisiem masang peh in kei ka umzou thamta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vante asiem masang leh, tuipi thupite tung agitkuol laiin, kei ka umzouta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tunglam a meilumte a koi laiin, Tuipi thuhpi tuinahte abawl laiin,
  </para>
  <para style="p">
    <verse number="29" style="v" />tuipiten athupieh apalsat louna ding ua, gamgi ahun pieh laiin leh leitung kingahna aphum laiin, Kei ka umzouta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khum hunlai in Ama kungah nasem khutsiem, khat bangin agei ah kei ka umta hi. Nisima alungdamna ka hi a, Amatoh umkhawm nuom kasa ngitnget hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama tenna leitung khovel in nuom asa hi. Ka kipahna khu mihingte tapate ahi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualeh tuin, ka tate aw, ka thu ngai un, ka lampi zuite mi hampha ahi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thuhilna ngaikhie unlen, pil un, tualeh nelsie vawt sih un.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka thu ngaikhie mite, mi nuomsa ahi uhi, ni sim a ka kotpi vengte leh, ka kotkha bul a, hing ngahten nuom asa uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aziehpen koipou kei hing muten hinna amu ua, tualeh Mangpa deisahna zong amu ding uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hinanleh koipou ka tunga khiel mi in ama hinna aliemsah bep ahi, kei hing muda pouma shina it ahi uhi.”
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pilna in a inn alam a, khuom sagite aphutta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Agantate athatta a, aman a zu toh atohhal a, ann nehna ding dawkan zong adaw zouta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A suoh nungahte asawldoh a, khopi sunga munsang tengah mi han in akikou sah hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Nou mi mawlte pouma tamlangah hing kihei unlen,” theisiemna neilou pouma kungah;
  </para>
  <para style="p">
    <verse number="5" style="v" />“Hing pei inlen ka ann hing ne unlen, ka zu halsa dawn un,
  </para>
  <para style="p">
    <verse number="6" style="v" />Motna taisan unlen, hing pei un, theisiemna lampi ah pei un,” achi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi simmawhat mi phawhpa in zumna alawdoh giap a; migilou phawhhilpa in ama liemna ding alawdoh giap hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Misimmawhatte phawhhil sin, ahisihleh nang ahing muda kha ding hi, mipil phawh lachin nang ahing it ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipil kungah thuhilna pe lachin, ahing pil deu deu dinga, midih hil lachin atheitam sem sem ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mangpa giin khu pilna kipatna ahi a, Asiengthoupa theina khu theisiemna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aziehpen keima ziehin na damsung nite akibelap dinga, na damsung kumte zong akibelap ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na pil leh nanga dinga pil na hi dinga; hinanleh mi na simmaw leh pen, nangman amaw na kipuoh ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Numei mo khu akam atam a abil ap huoi hi, amawl a bangma athei sih hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A inn kotlam ah atou a, khopi munsang touna tungte ah atou hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amauh lampi a tangtah a pei a, agei a suoh khate pouma na han ding in:
  </para>
  <para style="p">
    <verse number="16" style="v" />“Koi pou pilna tasam leh,” mi mawlte pouma tanah hing ki heilut u’heh, ana chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Tui kigu ahumdeu se a, simtham a ann neh atuideu se hi.”
  </para>
  <para style="p">
    <verse number="18" style="v" />Hinanleh amaun mi shite khunah a um uh chi leh, amanu mi hatte shina hankhuh, thutah ah a um uh chi, athei sih uhi, achi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Solomon thupilte: Tapa pilin apa akipah sah a, tapa moin anu alunggim sah hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gitlouna toh kilamdoh hausatna aphatuom sih a, hinanleh dihtatnain shina apat mi ahunkhie hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mangpa’n midihtatte hinna gilkiel in akoi phal sih dinga, migilou lunggulte apaimang pieh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thasie khut in zawnna atun a, mi thanuom khut in hausatna atun hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nipi lai a lakhawm mi khu tapa pil ahi a, hinanleh bu lah hunlai a imu mi khu, zumna tungsah tapa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Guolzawlna khu midihtatte lutungah a um a, hinanleh hiemngamna in migiloute, kam atuomkhum hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Midihtat theizingna khu guolzawl in aum a, hinanleh migiloute min pen amuot mang ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungtang pil in thupiehte asanga, hinanleh mimo kamtam pen apua ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Midihtatte muonhuoi tah in apei hit hiet ua, hinanleh miletatte akitheidoh pai ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amit sih at a mi enpa’n buoina apiengsah a, hinanleh mi mo kamtam apua ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Midihtatte kam khu hinna tuikhuh ahi a, hinanleh migiloute kam pen, hiemngamna in atuom hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kimudana in kihauna apieng sah a, hinanleh itna in khelna akhu khum hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Theisiemna nei mi kam ah pilna akimu a, theisiemna neiloute el duong ah, chiengpum atu ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipilten theina akholkhawm a, mi mote kam in sietna a nai hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihausa hausatna khu ama adinga, khopi dettah ahi a, tahsapna khu mi zawngte sietna ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi dihtat sepgimna in hinna atun a, migiloute thaman pen khelna ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thuhilna kemhoi pouma hinna lampi ah a um a; phawhhilna zada mi in lampi azuikhiel zel hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amudana im mi in muh zuouthei a nei a, mi gensiet hat mi khu mi mo ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thu tampi kigenna ah khelna abei sih hi, hinanleh akamsip thei mi khu mi pil ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Midihtatte lei khu dangka sieng sitset bang ahi a, migilou lungsim pen manna bei ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Midihtatte muhin mi tampi avah a, mi mote pen pilna tahsam in ashi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mangpa guolzawlna in mi ahausa sah a, lunggimna abelap sih hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi mote adingin gitlouna bawl khu, kisuhhalna bang ahi a, hinanleh theisiemna nei mi in pilna anei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Migilou in agiin pen ma atuohkha dinga, midihtatte pen alunggulte uh akipe ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pingpei aman bangin, migiloute a um nawn sih ding ua, midihtatte pen kumtawn in adet den ding uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Grep tuithua in ha azausah a, mei khu in mit asip sah bangin, mi thasie khu ama sawltute a dingin tuabang ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mangpa giinna in damsung nite asau sah a, hinanleh migiloute damsung kumte tom sah ahi ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Midihte kinepna khu kipahna ahi dinga, migiloute lam etna pen amangthang ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Midih a dingin Mangpa lampi khu hatna ahi a, hinanleh manthaina khu sietna nasemte ading ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Midihtatte pen suonmang ahi ngai sih ding ua, migiloute pen gamsungah atengden sih ding uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Midihtatte kam in pilna thu agenkhie a, hinanleh hamselawna lei pen satkhieh ahi ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Midihtat muh in pomthei ding athei a, hinanleh migilou kam in thusie agen thei hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Buhna dihlou Mangpa adingin, kidahhuoi ahi a, hinanleh tena dih khu akipahna ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kisahtheina a um chiengin zum na zong, a um a hinanleh kingaingiemte, kungah pilna a um hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Midihte adihna un amauh apui ding a, mi gin umloute pen azuoutatna un, amauh sietna atun ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thangpai niin hausatna aphatuom sih a, dihtatna in shina akipat mi hunkhe zel hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gensietbei mi dihtatna in ama adingin, lampi tang a bawl pieh a, migilou pen ama gitlouna ah apua ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Midihte adihtatna un amauh ahunkhe dinga, mi gin umloute pen, amauh ngaisutna gilou ah a awh ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migilou ashi chiengin akinepna amangsieng dinga, midihloute kinepna pen amang ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Midihtat khu alunggimmna apat in hutdoh in a um dinga, ama taangin migilou ahing pei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Milepchie in akam in a innveng asusie a, theina ziehin midih hunkhieh in a um ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Midihtatte ading a sil apei hoi laiin khopi mite akipah a, migiloute ashi chiengun lungdamna kikou thawm a kiza hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Midihte guolzawlna vangin khopi pahtawi in a um a, hinanleh migiloute kam ham in khopi aguollel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pilna neilou mi in a innveng asimmaw a, hinanleh theisiemna nei mi pen a sip khinkhian hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi kamtam in thuguh ki imte agenkhie a, mi ginum in thuguh a im hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kithuhilna umlouna ah mi mipite apua zel a, thuhilthei mi tamna ah bitna aum hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mikhuol ading a mawpo dinga kipe mi pen, athuohgim ngeingei dinga, hinanleh mawpuohna hawte abit ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihepisiem numei in pahtatna alaw a, hinanleh thagumhat suongmiten, hausatna anga uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khotuona nei mite ama hinna mama adingin silhoi abawl a, hinanleh mitatsete pen, ama tahsa tung ngei ah lunggimna atungsah hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Migilou in thaman dihloutah in asanga, dihtatna haichi tupa’n kipahman, dihtah amu ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dihtatna in hinna lampi a mi a pui bangin, koipou gitlouna del in ama shina ding anua del hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lungtang dihlou pomite pen, Mangpa a dingin kidahhuoi ahi ua, hinanleh a umdan ua dihtatte khu, akipahna ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Migiloute pen gawtlou in asuohta sih ding ua, hinanleh midihtatte hahlesuonte pen, hutkhiet in a um ding uhi, chi thei in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngaituo siemna neilou numei melhoi khu, vohpi na kua a sana gui kibasah bang ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Midihtatte lunggul khu silhoi ngen ahi a, hinanleh migiloute lam et khu thangpaina ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kiphal taha hawmzah mi in anei tam deudeu a, mi chippongte pen a zawng sem sem hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sil phal mi hinna suhhausat ahi dinga, midangte bawlhoi mi khu, bawlhoi sem in a um ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Koipou bu leh bal it mi khu miten ahamsiet ding ua, hinanleh azua nuompa lutung ah guolzawlna atung ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koipou thanuomtah a silhoi sui teitei ten, deisahna amu ua, hinanleh silhoilou suiten silhoilou ma amu ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama hausatna muong mi khu apua dinga, hinanleh midihtat khu sing bawhpha bangin alun ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Koipou ama innsung buoi sah mi khu, akihawmkhai dinga mi hatte leh, mi pilte nasemin apang ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Midihtatte ga khu hinna singkung ahia, tualeh koipou hagau man khu mipil ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Midihtatte leitunga akithuh kia pai a ahileh, migilou leh mikhielte nasa sem in akithuh kia pai ding hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Koipou thuhilna ngaina in theina angaina hi, hinanleh phawhhilna zada pouma mi mo ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi hoi in Mangpa akipat deisahna a mua, hinanleh gitlouna ngaituo mi khu, Aman amawpai ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gitlouna in mi asudet thei sih ding a, hinanleh dihtatna thahui akisuon sih ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zi hoi khu apasal a dingin Manglukhu ahi a, hinanleh zumhuoina bawlnu khu, apasal a dingin gu leh taang natna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Midihtat lunggel khu adih a, hinanleh migilou thuhilna pen solna ngen ahi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Migiloute thu pen sisansuo dinga, dapbuhna thu ahi a, hinanleh midihte kam in amauh ahunkhie hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migiloute paikhieh in a um ua, a um nawn sih uhi, hinanleh midihtatte inn pen adingden ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi apilna dungzuiin phat in a um dinga, hinanleh lungsim semi pen akimuda ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama kingaithupi a tanghou neilou sangin, simmaw a um a suoh nei ahoizaw hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Midihtat in aganta hinna angaikhoh a, migiloute khotuona neempen zong agilou nalai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama gam hou khinkhian mi in ann neh ahau dinga, mi mantheilou nuazui mite pen theisiemna bei ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Migilouten migiloute sepsuosa adeigaw ua, hinanleh midihtatte thagui in ga asuong hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Migilou pen ama thugen gilou mama ah a awh a, hinanleh midih pen lungkham buoina, pat apawtdoh ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi’n akhut nasep apat neh amu bangin, akam siemna ga silhoi in atai ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mimote agamtatna pouma uah dih akisa ua, hinanleh kithuhilna ngaikhemi khu mipil ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi mo in alungthahna akilangsah pai a, hinanleh mi lunggel siem mi in, kizumsuona athusim sih hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koipou thudih gen miin dihtatna thu agen a, theipi dihtahlou in zuou agen hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Namsau a sut banga thugen mi a um a, hinanleh mipil lei khu damna ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thutah genna kamte kumtawn in a umden dinga, hinanleh zuou genna lei in, hun tomnou khat adai giap hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Silgilou sep tumte lungsim ah lepchiena thu a um a, lemna umsah tumte lungsim ah lungnopna a um hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Midihtatte a dingin sietna atung sih dinga, migiloute pen lungkham buoina in adim ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kam zuouthei khu Mangpa a dingin kidahhuoi ahi a; dihtah a bawlte pen akipahpi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lunggel siem mi in theina aphuol khin khian a, mi mote lungtang in motna aphuongdoh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi thanuom khut in vai ahawm dinga, mithasete pen mite nasem in apang ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihing lunggimna in kingaisietna atun a, hinanleh thuhoi in akipah sah hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Midihtatin pilvangtahin alawm ding atel a, migiloute gamtatin amauh apielmang sah hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mithasie in asabehna a amatsate, nangawn a em ngap sih a, hinanleh mithanuomte silnei khu amanpha hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dihtatna lampi ah hinna a um a, tua lampi ah shina a um sih hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tapa pil in apa thuhilna a ngaikhie a, hinanleh misimmaw hat miin phawhhilna, a ngaikhe nuom sih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi’n akamsiem ga silhoi ane dinga, hinanleh mi gin umloute hinna, in hiemngamna ane ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akam vengzou miin ahinna akembita, hinanleh a kam lienpi a kaah miin sietna atuoh ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mithasie hinna in alunggul a, bangma anei sih hi, hinanleh mithanuom hinna pen, hausat sahin a um ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Midihtat in zuou ahuo a, hinanleh migilou khu ahuothuoi a, zumna atuoh zel hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Genbanglou a gamta mi khu dihtatna in a kem a, hinanleh gitlouna in mikhiel apuasah hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi ama leh ama kihausa sah a bangma neilou a um a, hinanleh mi ama leh ama kizawng sah, napi hauna thupitah nei a um hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing hinna tatna khu ahausatna ahi a, hinanleh mizawng in vau hilna angai nuom sih hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Midihtatte vah khu anuom a, hinanleh migiloute meivah pen sumit ahi ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kiletsahna in kihauna apiengsah giap a, hinanleh thuhilna ngaisah miten pilna anei uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lepchietah a hausatnate akiem pai dinga, hinanleh sepgimna thaman kholkhawm mi khu, apung deu deu ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kinepna ahing zekai chiengin lungtang anasah a, hinanleh lunggulna ahingtun chiengin, hinna singkung ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koipou thupieh simmaw khu suhsiet ahi dinga, hinanleh koipou thupieh giing mi khu, kipahman pieh in a um ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipil dan khu hinna tuikhuh ahi a, shina thangte apata suohtatna ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Theisiemna hoiin deisahna apie a, hinanleh mi gin umloute lampi ahasa hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lunggelsiem mi pouma in theina toh kituohin, nna asem ua, hinanleh mi moten amotna uh asulang paipai uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thupotu gilou khu buoina ah akelut zel a, palai gin um in chidamna atut hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hoina dinga phawhhilna ngainuomlou mi in gentheina leh zumna atuoh dinga, bawlhoina ngaikhe miin pahtatna alaw ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lunggul bangbang a pichinsah a um khu, hinna a dingin anuom a; hinanleh mi mote a dingin, gitlouna taisan khu sil kidahhuoi ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mipilte toh zawhkhawm mi ahing pila, mi mote toh kigop mi pen suhmang ahi ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Silhoilou in mikhielte anuadel a, hinanleh midihtatte kungah nuomman akipe ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihoi in atu leh atate adingin gou anuasie a, tualeh mikhielte hausatna pen midihtatte, dinga gou kikholkhawm asuoh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mizawngte lou hawna ah ann tampi apieng thei a, hinanleh thudih a vaihawmna atahsap ziehin, suhsiet in a um leng hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Koi zong chieng zanglou mi khu atapa muda ahi, atapa it in thununna ape mengmeng hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Midihtatten ahinna uh ataimasang sie’n ane ding ua, hinanleh migiloute agilkiel ding uhi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Numei pil poumain a inn alama, hinanleh numei moin ama khut mama in a inn aphelsie hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dihtattah a gamta mi in Mangpa agiing a, gamtat gilou miin Ama asim maw hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mimo kam ah kiletsahna chieng a um a, hinanleh mipil kam in amauh akembit ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawngtalte umlouna ah gankuong asienga, bawngtal thahatna in bulah ding tampi apiengsah hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Theipitu gin um in zuou agen sih a, hinanleh theipitu dihlou in zuou agen ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Misimmawhat mi in pilna asui a, amu sih hi; hinanleh theisiemna nei mi in, bailamtah in theina amu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mimo umna apat kihemkhie in, aziehpen ama kam apat theina na mu sih ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lemguotsiem pilna khu alampi theisiem ahi a, hinanleh mimote motna khu lepchie na ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mimoten khelna anuisan ua, hinanleh midihtatte lah ah deisahna a um hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lungtangin ama khelna athei a, tualeh mikhuol khu ama nopsahna ah akikum sih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Migilou inn suhsiet ahi dinga, midihte puonbuh pen akhangtou sem sem ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihinga dinga dih hileh kilawm lampi a uma, atawpna khu shina lampi ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nuina ah zong lungsim natna a um thei a, tualeh nopna tawpna khu dana ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lungtanga nuatol mi khu ama ngaidan in adim ding a, tualeh mihoi in pen a umdan hoina pahtatman asang ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi mawl in thu zousie agingta a, hinanleh mi lunggelsiem in apeina lampite a en chien hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mipil in silhoilou agiinga ataisan hi, hinanleh mi mote athangpai ua, akimuong uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Milungthah baite mot huoitah in agamta ua, tualeh ngaituona a gitlou pilte pen, mi muda in aum hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi mawlten motna alawtah ua, hinanleh mi lunggelsiemte pen, theina manglukhu akikhusah hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihoite mai ah mihoiloute akun ding ua, tualeh midihtatte kotpiphungah, migiloute akun ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mizawngte pen a innvengte nangawn in a muda a, hinanleh mihauten lawm tampi anei uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koipou a innveng muda mi in khelna abawl hi, mi zawngte hepi mi khu mi nuomsa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Gitlouna bawlte alampiel uh hilou amah? Hinanleh hepina leh thutah pen, silhoi bawlte a ahi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sepgimna zousie ah metna a um a, hinanleh kam guoh a genthaw in zawnna ah hing puilut hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mipilte lallukhu pen ahausatna uh ahi a, hinanleh mi mote motna khu motna ma ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Theipitu dihtahin hinna ahunkhie hi, theipitu lepchie in zuou thu agen hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mangpa giinna ziehin kimuonna hattah a um a, ataten kibutna mun anei ding uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mangpa giin khu hinna tuikhuh ahi a, shina thang toh kipel theina ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mitampi umna ah leengpa avanglien a, hinanleh mipi umlouna ah leengtapate manthaina a um hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lungthah ha mi khu theisiemna nei ahi a, lungthah bai mi pen amotna uh sulang bep ahi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lungnopna khu tahsa damna ahi a, thangsietna pen gute nangawn muotna ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Koipou taga bawlgenthei khu asiempa simmaw ahia, tasamte hepi mi khu Pasian zatat mi ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Migilou khu ama gitlouna ah pailut in a um a, hinanleh midihtat in ashi na ah lam etna anei hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Theisiemna nei mi lungsim ah pilna akhawl hi, hinanleh mi mote lungsim a um khu akithei hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dihtatna in nam atawisang a, hinanleh khelna khu nam zalatna ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Suoh piltahin leengpa deisahna atanga, hinanleh zumna umsah mi tungah athangpaina atung hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dawnna nem in thangpaina aheimang a, hamkhau in lungthahna asousah hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipil lei in theina dihtah in a zang a, hinanleh mi mote kam in motna thu asekhie hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mangpa mit in mun chinteng amu a, asie leh apha zong a en a, achiemte hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamdam athugen lei khu hinna singkung ahi a, kamsie in lungsim asusie hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi moin apa thuhilna asim maw a, hinanleh koipou phawhhilna ngaisah mi khu lunggelsiem ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Midihtat innsungah gou tampi a um a, hinanleh migilou hausatna pen buoina bep ahi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mipil kam in theina ahawmzaha, hinanleh mi mote lungtangin tuabangin abawl sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mimo kithoina khu Mangpa’n akidah a, hinanleh midih thungetna pen akipahpi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Migiloute gamtatna khu Mangpa’n akidaha, hinanleh dihtatna zui mi khu a it hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Umdan hoi lampi taisante adingin, bawlhoina khautah apoimo a, tualeh bawlhoina thuhil mudate pen ashi ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gawtmun leh manthaina khu, Mangpa mai ah kihongsa in a um a, tuaziehin mihing tapate lungtang, bangzata in amuchien sem diei izaw!
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi simmaw hat mi in bawlhoina thuhilpa a it sih a, mipil kungah zong avahaw sih ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lungsim nopna in mai ataisah a, hinanleh lungsim dana in, hinna asusie hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Theisiemna nei lungtangin theina asui a, hinanleh mi mote kam, motthu in akivah hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gentheina thuoh mite damsung ni sietna ngen ahi a, hinanleh lungnopna nei miin pen lungnopna ankuong alui zing hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gou tampi nei a lungkhampi sangin, Mangpa giing kawm a gou tawmnoukhat nei ahoi zaw hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kimudana toh bawngnou thau sa neh sangin, ki itna toh annteme neh ahoizaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lungthah bai miin kihauna apiengsah a, lungthah ha miin kihauna asudai hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mithasete lampi linglah bang ahi a, midihte lampi pen lamlienpi bang ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tapa pil in apa akipah sah a, tapa maw in anu asimmaw hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sie leh pha khensiemna neilou miin motna khu, nuom asa a theisiemna nei mi pen dihtah in apei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lemguotna tellou in siltup khu chimawna ahi a, thuhiltu tampi umna ah lawchinna a um hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kam a dawnna mama in mi akipah sah a, tualeh ahuntah a thugen hoi hina maizen e.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mipil a dingin hinna lampi atou pei a, nuoilam a hankhuh apat akiheimang theina dingin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mangpa’n mi kiliensah inn asuse dinga, meithaite gamgi asuhdet pieh ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Migiloute ngaituona khu Mangpa a dingin akidahhuoi a, hinanleh misiengthoute thugen pen akipahpi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Punna dei a huoiham mi in ama innsung asubuoi a, hinanleh golguhna homi pen ahing ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Midihtat lungtangin dawn dan ding angaituo det det a, hinanleh migiloute kam in pen silhoilou asekhie hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mangpa khu migiloute apat gamlapi ah a um a, hinanleh midihtatte thungetna pen aza hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mit vahna in lungsim asunuom a, tualeh thutut hoiin in gute athausah hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinna dinga phawh hilna, ngaikhie bil mipilte lah ah a um den ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Koipou thuhilna ngaisahlou in ama hinna asimmaw a, hinanleh bawlhoina ngaikhe mi in theisiemna amu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mangpa giinna in pilna thuhilna ahi a, tualeh zatat huoina masangah kingiemkhiehna a um masa hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lungtang a kisahkholna khu mihing a ahi a, lei a dawnna pen Mangpa akipat ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing lampi zousie ama mitmu in asienga, hinanleh Mangpa’n lungsim a tupnate tena in ate zel hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na sep nabawl ding pouma Mangpa kungah, aap sieng lachin na ngaisutnate asudet ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mangpa’n sil zousie Ama a dingin abawl a, migiloute nangawn zong ni hoilou a dingin asiem hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lungtang kisathei pouma Mangpa a dingin, kidahhuoi ahi a, kithutuoh nan u’le zong gawtlouin aum sih ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khotuona leh thutah in gitlouna asawpsiengta a, tualeh Mangpa giinna ziehin gitlouna ataisan uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing khat umdan in Mangpa akipahsah chiengin, amelmate nangawn ama toh kilem dingin abawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dihloutah a hauna tampi sangin, dihtatna toh tawm noukhat nei ahoizaw hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing lungtangin agamtatna ding angaisut masa a, hinanleh Mangpa’n akalsuonte apui zel hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Leengpa kam sungah Pasian thutah a um a, thukhenna ah akam in zuouthu agen sih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Buhna dih leh tena dih Mangpa a ahi a, ip gihdante zousie Ama nasep ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lengpa adingin gitlouna bawl khu sil kidahhuoi ahi, aziehpen leengtoupha khu dihtatna a suhdet ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dihtatna kamte leengte kipahna ahi a, tualeh thudih gen pouma khu a it uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Leengpa lungthahna khu shina thangkou khat bang ahi a, hinanleh mipilten asulungdam ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Leengpa amaitai chiengin hinna a um a, adeisahna pen guo nukhia zusah meilum bang ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pilna mu khu sana sangin hoizaw hina va-ia e! tualeh theisiemna khu dangka sanga tel zawh ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Midihte lamlien khu silhoilou taisan ahi a, koipou alampi vengin ahinna avengbit hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kisahtheina khu sietna masangah apei a, tualeh lungsim ki uongsah khu puasietna masangah apei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi kisatheite toh gallahsum hawm sangin, mi zawngte lah a lungsim kingaingiem tah a umkhawm ahoizaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Koipou kithuhilna piltah a ngaikhe mi in silhoi amu dinga, tualeh koipou Mangpa muong mi ahampha ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lungtang pil khu milemthei akichi dinga, tualeh kam humin siemna apungsah hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Theisiemna nei mi a dingin hinna tuinah ahi a, hinanleh mi mote bawlhoina dinga thuhilna khu motna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mipil lungtangin akam ahil a, tualeh akam ah pilna abelap hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thu lungdamhuoite hinna a dingin khuoizu humbang ahi a, gu leh taanga dingin damna ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihinga dinga adih hileh kilawm lampi a um a, hinanleh atawpna khu shina lampite ahi thei hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Koipou nasemgim miin ama adinga sem ahi a, aziehpen akam gilkielna in asepsah ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pasian ngaisahlou miin silhoilou abawldoh a, tualeh akamham nangawn meikuong abang hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi kiuongsahin kihauna apiengsah a, tualeh bilkawm a thudapgen siu siau in, lawmta hoipen zong akikhensah hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thagum suonga gamtaten a innvengte azawl a, tualeh lampi hoilou lam ah apeipi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mit sih at a mihoupi mi in gitlouna angaituo a, Amuh chidet mi in sietna atungsah hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tehsie samkang pen thupina manglukhu ahi a, tam khu dihtatna gamtat apat kimu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Koipou lungthah ha mi khu galhang mi sangin ahoizaw a, tualeh koipou ama lungsim thuzaw mi khu, khopi khat simzou mi sangin ahoi zaw hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pheipi tunga ai akisan hangin, thukhennate pouma pen Mangpa a hing kipan ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kihau kawm kawm a ann neh ding tuitah, inn dim a umna inn sung sangin, kithutuoh tah a annkhing kam khat nehna, innsung a nuom zaw hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Suoh pil in zumna piengsah tapa tungah, vai ahawm dinga, tualeh asanggamte lah a khat bangin, goutan anei ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sana leh dangkate, meiphuolpi sunga etchien leh suhsieng ahi a, mihing lungtang pen Mangpa’n a enchien a asiengsah hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Silgilou bawlmi in kam gilou angaikhie a, mi zuou in lah thuginalou gen lei lam ah abil adaw hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi zawngte simmaw mi in, ama Siempa simmaw ahi a, tualeh vangsietna ni a, kipah mi khu gawtlou in asuohta sih ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tehsete adingin atute uh amanglukhu uh ahi a, tate athupina khu apulepate uh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi mo a dingin thupha genna kam akilawm thei sih a, leengpa adingin zuou genna kam akilawm maw dieh nalai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Silpieh khu aneitu mitmu ah suong mantam bang ahi a, akiheina lam phot ah alaw ching ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koipou tatkhelna ngaidam itna asui a, hinanleh thukhat avelvel a gen mi in, alawm hoite nangawn akikhensah hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi mo zakhatvei sat sangin, mipil in khatvei phawhhilna athei siem zaw hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Migilou in kiphinna ding maimai asui a, tuaziehin atungah thangkou gilou khat, ama dou dingin akisawl ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi mo khat amot laitah a kituohpi sangin, vawmpi noukai anou kiluoh pieh toh, kituoh a ut huoi zaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koipou silhoi silhoiloua thuh kia mite, innsung thusie in anuasie sih ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kihauna pat pen tui kiching hakhiet bang ahi a, tuaziehin kihauna a um masangin kiselna tawpsan in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koipou migilou siemtangsah a midih, mawpai mite ani un Mangpa adinga, kidahhuoi ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuaziehin pilna leina dingin, mi mo khut ah aman a um eimah, tuakhu a dingin ama’n theisiemna anei sih, chi thei in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lawm khat in bangchihlai pouin a it ngitnget a; sanggam khu vangsietna ni a dinga pieng ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theisiemna neilou mi in a innvengte taang a, mawpo dingin akichiem pai hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kihauna it miin khelna a it hi, koipou akotpi tawisang in sietna asui hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Koipou kiuohsahna lungtang nei mi in silhoi amusih a, tualeh lei thulimlou neiin vangsietna atuoh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tapa mo nei pa’n buoina ahingdoh a, mi mo nu leh paten lungnopna aneisih uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lungsim nopna khu chidamna damdawi ahia, lungtang hasie in gute agawsah hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Migilou in thudih a vaihawmna heikawina dingin, golguhna sum adap neh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sie leh pha khensiemna nei mi masangah pilna a um a, mi mo mit khu kawlmong ah a um hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tapa mo pen apa adinga lungkhamna ahi a, apienna anu a dingin khatna a hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mawna neilou mi gawt ahoi sih a, miliente athudih zieh ua zep zong ahoituom sih hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koipou theina nei mi khu athugen ah akiveng a, koipou lungsim tawldam mi in theisiemna anei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mimo nangawn asip dide leh apil a ngai ahi a, tualeh koipou akam sip khinkhian leh, theisiemna nei khat a sim ahi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi ama leh ama kituomkoi in alunggulte asui a, vaihawmna pilhuoi zousie tungah alungthah hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Theisiemna ah mi moin kipahna anei sih, hinanleh a lungtang a umte genkhieh nuom asa bep hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Migilou ahing um chiengin simmawna ahing um pai a, tualeh minsietna a um chieng zumna ahing um hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihing kam a thute khu tuithuhpi bang ahi a, tualeh pilna tuikhuh pen luita luong bang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Migilou deisah tuom ahoi sih a; thukhenna a midihtat paikhieh zong ahoi tuom sih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi mo kamte khu kinielna ah alut a, tualeh akam in zepna ahan hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi mo kam khu ama sietna ahi a, tualeh akamhamte ama hinna adinga thang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thuse gente gensietna thute ann tuitah bang ahi a, mihing tahsa sunglam ah alutsuh uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nasep thase mi pen sietna bawlmite a dingin sanggam ahi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mangpa min khu innsang dettah bang ahi a, midihtatte atailut, ua, abit uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihausa hausatna khu ama dinga akhopi dettah ahia; ama ngaidan in kulbaang sangtah bang ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Manthaina masangah lungtang kisahtheina a um a, tualeh za umna masang ah kingai ngiemna a um hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koipou thu chientah a azah masanga, dawng pai mi khu ama a dinga motna leh zumna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi alungsim a apan zou nahpouleh natna athuohzou a, hinanleh lungsim liem khu koi in athuohzou diei?
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi lungsim gelsiem in theina amu a, tualeh mipil bil in theina asui hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi khat a silthawn piehin ama a dingin, umna abawl pieh a, mithupite masangah ahing zawpi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A innveng hing pei a akidohchien masang sie a, asiemna thu gen masa pen khu adihin akilang hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ai san in kihauna akhawlsah a; mi hatte kikaal akhentan hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sanggam kisunua lungdam sahkia khu, kulpi muonhuoi lah sangin ahasa zaw a, akihauna u’zong kulpi kotkhah kilna zawlte bang ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi’n ama kamham ga akipat agilvana amu a, tualeh akam a athugente gasuo akipat agilva ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shina leh hinna khu lei sil bawltheina ah a um a, tualeh tuami it pouma in aga ane ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Koipou zi mu in silhoi amu hi, tualeh Mangpa akipat deisahna tang ahi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi zawng in kam neem zangin azawl zel a, hinanleh mihausaten khautah in a dawng hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lawm tamtah nei mi in ama sietna ding abawl a, hinanleh sanggam sanga muonhuoi zaw lawm zong a um hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi zawng adihna toh gamta mi khu, mimo thusie gen sangin ahoizaw hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualeh theina neilou hinna ahoi sih a, tualeh kalsuon kinawten lampi azui khiel uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing motna in agamtat asesah a, alungtang Mangpa tungah akiphin hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hausatna in lawm tampi asiem a, mi zawng pen alawm nangawn in ataisan hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Theipitu dihlou khu gawtlou in a um sih dinga, tualeh zuou thu gen pouma asuohta sih ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tampi in vaihawm mi deisahna asui a, tualeh koipou sil thawnpieh pe mi adingin, michin alawm ahi zel uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mizawng pen asanggamte zousie nangawn in amuda ua, alawmten gamlapi ah akihepmangsan sem ding uhi! Kampha toh maute anuadel vangin anuasie ua, ataisanta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Koipou pilna mu in ama hinna a it a, tualeh theisiemna kemching miin sil hoi amu ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Theipitu dihlou pen gawtlou in a umsih dinga, zuouthu gente amangthai ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi mo adingin nuomtat akilawm sih a, Suoh khat in leengtapate tunga, avaihawm khum ding akilawmmo zawsem ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Alunggelsiemna in mi alungthah ha sah a, tualeh tatkhelna mumo akipan pen athupina ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leengpa lungthahna khu humpibahnei hawh bang ahi a, hinanleh adeisahna khu hampa tunga daitui kia bang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tapa mo khu apa adinga vangsietna ahi a, tualeh zi hangsan phunhat khu intung ke a guotui tahkhie bang ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Inn leh hausatna pen pate akipat a gou kiluo sawn ahi a, hinanleh lunggelsiem zi pen Mangpa a hing kipan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thasietna in mi nuomtahin a imu sah a, tualeh mi thasie in gilkiel a thuoh ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koipou thupieh kemchingin ahinna akembit a, hinanleh agamtatna simmaw mi khu ashi ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koipou mi zawngte hepi miin, Mangpa leitawisah ahi a, asilpiehte Mangpa’n adinkia teitei ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lam etna a umlai in na tapa thunun inlen, amangthai mai dingin ngaituo sin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi lungthah bai in gawtna athuoh dinga, aziehpen va hundoh nanlachin, na hutdoh kia teitei angai ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lemguotna ngaikhie inlen thuhilna zuiin, na hinkhuo nukhia lam ah na pil law ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing lungsim ah tupna tampi a um a, ahivangin Mangpa deilam bou atangtung ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihingin alunggul pen hepina ahi a, mi zuouthei hi sangin mi zawng hi ahoizaw hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mangpa giinna in hinna atun a, tualeh hinna nei mi sungah lungkimna aumden dinga, silhoilou in ama ave ngai sih ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi thasie in akhut hengkuong sungah adie a, akam nangawn atuntou ngap sih hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi simmawhat khat satthop lachin, mi mawl ahing pilvang dinga, theisiemna nei mi phawhhil lachin, sie leh pha theina a nei ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Koipou apa bawlsie a, anu delmang mi khu zumna leh minsietna umsah tapa ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka tapa sil bawlkhiel dinga, pilna thuhilna ngaikhieh tawpsan in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Theipitu dihlou in vaihawmna dih asimmaw a, migilou kam in thulimlouna anawmval hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thukhenna khu mi simmawhatte a dinga, guonggal masah ahi a, tualeh mi mote elduongah zepna chieng atu ngei ngei ding hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zu in mi azawnkhaw vagiap a, zuchia dawn pen kihau kikohna ahi a, koipou zu in apuisiet pouma mipil ahisih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leengpa lungthahna khu humpibahnei hawh bang ahi a, Koipou ama phin lungthah mi in ama hinna abawlkhiel hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kihau kiselna lah a kihemkhe thei mi khu mizatat huoi ahi a, hinanleh mi mo pouma kihau kiselna ah akikumthaw paipai uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thasie in phalbi vawt ziehin lou ahou ngap sih dinga, tuaziehin pawltah chiengin khut adaw dinga, bangma anei sih ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing lungsim a tup leh ngimte khu tuili thuh banga vei ahi a, theisiemna nei mi in tuate apholdoh ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tamzaw in amauh hoina chiet gen in akiphat ua, hinanleh mi gin umtah tah koi in amudoh thei diei?
  </para>
  <para style="p">
    <verse number="7" style="v" />Midihtat ama dihna bangin agamta a, ama nua ah atate ahampha uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thukhenna leengtoupha tunga tou leengpa’n, sil hoilou zousie amit in athemangta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koi ahiei: “Ka lungtang ka susiengthou a, ka khelna apat in ka siengthouta,” chithei ding?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tena kibanglou leh buhna kibanglou, ani in Mangpa’n akidah hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naupang nangawn asilbawl ah ami hin zie akithei a, anasep siengthou leh dih akithei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khozahna bil leh khomuna mit, ani in Mangpa bawl ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />I mut khela sin, tuachilou in na zawnlaw kha ding hi, na mit hah sah in ann neh na nieng ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Van lei miin, tami hoisih,” bangma ding hisih chinapi, apeinua chiengin akisahtheipi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sana a um a, rubi suongmanpha tampi um nanleh, pilna kam khu gou manpha zaw ahi nalai lai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Theingailou mikhuol a dinga, mawpo dinga kipe mi puonsil la inlen, tualeh numei zuoutat a dinga, mawpuohna kichiemna khu ama apat in la in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lepchiete lawdoh ann mihing adingin atuise a, hinanleh anuachiengin akam ah suonghum adim ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tupleh ngim pouma thuhilna hoitah toh suhdet ahi a, tualeh piltah a lemguotna toh gal dou ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Koipou thuginalou gen a vahkawi miin thuguh ava gendohvade a, tuaziehin mi kamtam toh kigop sin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Koipou apa ahiei, anu ahiei, hamsiet pouma miel kiingkin lah ah, athaumei akimut mit pieh ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A kipat chiil a gou kintah a kimute pen, atawpah hamphatna ahisih ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Tam silhoilou ka thuh ding hi” chi sinlen, Mangpa ngahzaw in, Aman ang hundam na ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tena suong kibanglou Mangpa adingin kidahhuoi ahi a, Tualeh khaina dihlou ahoi sih hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing kalsuonte Mangpa a ahi a, mihingin ama kalsuon bang achi theisiem thei diei?
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihinga dingin “Asiengthou” hina chia kipumpieh pai khu, thang ahi tualeh kichiemnate nua dohchien kia zel zong.
  </para>
  <para style="p">
    <verse number="26" style="v" />Leeng pil in migiloute asepkhie a, tualeh bu vuohna leengpei atung uah ahuol sah hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihing lungsim pen Mangpa meivah ahi a, Asunggil tawng lah nangawn asui kawi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khotuona leh thutahin leengpa akembit a, tualeh aleengtoupha zong khotuona a tunding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tangvalte thupina khu ahatna uh ahi a, tualeh tehsete kilawmna khu asamkang uh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Satna maliem in gitlouna asiengsah a, tuabanga zepna in lungsim tawng thuh, pente zong a sieng sah hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leengpa lungtang Mangpa khut ah a um a, Aman luituite bangin adeina lam lamah ahei kawi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing umdan pouma amitmu in a dih a, hinanleh Mangpa’n lungtang a en hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kithoina sangin dihtatna leh, thudihna Mangpa a dingin apomtah zaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mit sang ha, lungtang kiliensah leh, migiloute meivah khu khelna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mithanuom tupna in hausatna atun tahpi a, hinanleh mikinaw pialpual in zawnna atun hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lei zuouthei toh kimu goute pen, tuihu leengmang pai bang leh shina thang ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migiloute thagum suona in amauh asumang ding hi, amaun vaihawmna dih apom nuom lou zieh un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mikhielte lampi asiein akawi a, hinanleh misiengthou nasep pen adih hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Numei hangsan khat toh inn khat a tenkhawm sangin, inntung vum ning khat a tangten ahoizaw hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migilou lungtangin gitlouna alunggul a, a innveng nangawn in amitmu ah deisahna amu sih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Misimmawhat akigawt chiengin mimawlten apillaw ua, mipil akithuhil chiengin theina anga belap uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Adihtat Pasian in, migilou innsung pilvang tahin angaituo a, agitlouna ziehun migiloute aphietmang hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mizawngte kaana zalou dinga abil hum pouma, ama mama zong aka hun a um ding a, koiman aza sih ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Simthama silthawnpieh in lungthahna adaisah a, simthama kiguhgolna in thangpaina adaisah hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thudih a nasep khu midihte kipahna ahi a, hinanleh khelna nasemte tungah sietna atung ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Theisiemna lampi apata vahmang mi pen, mi shite kikhopna ah akhawl ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koipou nopsahna khela khu migenthei ahi ding ua, koipou zu leh sathau ngaina pouma, ahausa ngai sih ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Migilou khu midihtat tatna man ahi ding a, tualeh mi muonhuoilou zong midih a dingin, tatna man ahi ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Numei hangsan leh phunhat toh tenkhawm sangin, gamdai a tangten ahoizaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mipil tenna ah gou leh sathau lunggul ding a um a, hinanleh mi moten anekhawng zel uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koipou dihtatna leh hepina zui mi in, hinna dihtatna leh zatatna amu uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mipil khu mihatte khopi kulbangah akal a, amuon mama uh kulpi asuhchip pieh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Koipou akam leh alei venghoi mi in, buoina a kipat ahinna akembit hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ki uongsah leh kisatheimi min khu, “Misimmawhat” akichi hi. Aman ki uongsah leh kisathei tah in nna asem hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mithasie pen alunggulna in ama athat a, Aziehpen akhut in nna asem nuom sih hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sun nitum in huoiham tahin mi neisa adeigaw a, hinanleh midihtat in apie a, kheet anei sih hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Migilou kithoina akidahhuoi a, lungsim gilou pum a ahing tawi chiengin, akidahhuoi zawsem hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Theipimi dihlou khu amangthai dinga, hinanleh athugen na zapa’n tawplou in agen ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Migilou in amai akhausah a, hinanleh midih in, aumdante abawl hoi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mangpa douna dingin, pilna ahiei, theisiemna ahiei ahisihleh lemguotna a um sih hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sakol pen kidouna ni chienga dingin chilsa in akikoi a, hinanleh guolzawna pen Mangpa a ahibou hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hausatna thupitah sangin min hoi tel zawh ding ahi a, tualeh sana leh dangka sangin, ittah a deisahna tel zawh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihau leh mi zawngten kikop khat anei ua, Mangpa khu amaute zousie siempa ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mipil in silhoilou amu masa a, akiphuolmang hiau hi, hinanleh mi mawlten aphusuoh tentun ua, athuohlaw zel uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kingaingiemna leh Mangpa giinna khu, hausatnate, zaumnate leh hinna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mitatsete lampi ah ling leh khaute leh thangte a um a, ama hinna kemsiem mi in tuate gamlapi ah apel ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naupang apeina ding lampi ah chil in, a upat dongin zong tuate akipat in apeimang sih ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihauten mi zawngte tungah vai ahawm ua, tualeh mi sum leitawite asum leitawinapa suoh in apang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Koipou thulimlouna haichi tu miin lunggimna a at dinga, tualeh alungthahna chieng alawsam ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koipou silphal mi khu guolzawl in a um ding a, aziehpen aman mi zawngte kungah neh ding apie hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Misimmawhat notmangdoh lachin kinielna abei dinga, Ahi, kihauna leh kisietna atawp ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Koipou lungsim siengthouna ngaina mi leh, hepina kamnem nei mi khu, leengpa lawm ahi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mangpa mitten theina akembit a, hinanleh mi gin umloute thugen apaimang hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Mithasie in innpulam ah humpibahnei a um a, gawlzing ah hing na that khava,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Numei thangtat kamsuo khu leihawm thuhtah ahi a, koipou Mangpa’n ahuot mi khu, tua leihawm sungah akesuh ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Motna khu Naupang lungtang ah kanlawm in a um a, bawlhoina chiengin tuami gamlapi ah ahawlmang ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koipou ahausatna belapna dinga, mizawngte nuoisie leh, mihaute kunga pieh belap mite khu, ahing tasam ngeingei ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mipilte thugen ah na bil daw inlen ngaikhiein, ka theina ah na lungtang pie in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aziehpen na lungtang sunga na kep hoi a, na kam a mansa a na koi leh mi hampha na hi ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na muonna Mangpa ah ahitheina dingin, tuni in nangma mama ka hing thuhil hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thuhilna leh theina a silhoi pente, na kungah ka hing gelpieh hilou ahiei mah?
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang hing sawlmite thudihtah a na dawn theina dinga, thutah leh thudih thuhilnate ka hing gelpieh hilou ahiei mah?
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi zawngte azawn man un suom sin, ahisihleh kulpi kotkha a genthei thuohte bawlse sin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aziehpen Mangpa’n amauh tungtang thu agen pieh dinga, tualeh amauh suom mite hinna asuom ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi lungthah hatte lawm in nei sinlen, mi lungpheng toh zong kigop sin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuachilouin ama gamtat zui kha vachin, na hinna thangkam na hikha ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Midang dinga mawpuo a kichiem in pang sinlen, Leibat thu a mawpuo in zong pang sin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pieh ding na neilou leh, bang dinga na nuoi a na lupna nangawn ladoh ding ahiei mah?
  </para>
  <para style="p">
    <verse number="28" style="v" />Na pu leh paten nidanglai a ana phusa gamgi chiemtena khin sin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi anasep nalam a siem leh thanuom na mu ei mah? Ama leengpa masang ah adinga, mi maimai masang ah ading sih ding hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vaihawmpa toh annkuong na imkhawm chiengin, na masang a kiluite hoitah in en masa in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gongsan mi na hileh na lawl ah temta koi in
  </para>
  <para style="p">
    <verse number="3" style="v" />A ann tuite ngen lunggul seng sin, aziehpen solna ann ahi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hausat ding lunggulna in semgim seng sinlen, nangma theisiemna a kingah tawp in.
  </para>
  <para style="p">
    <verse number="5" style="v" />A umloupi na mit a enla ding na hiei mah? Aziehpen hausatnaten ama ua dingin, ha akibawl ua, muvanlai bangin van lam ah aleengmang zel uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi chippongte ann ne sinlen, a anntui zong enla sin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aziehpen ama khu, alungtanga angaituo bang banga um mi ahi a, “Ne inlen dawn in” achi hangin ang deisah tah tah ahi sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na ann nehsate nangawn na lawkhe kia dinga, na kipah thugente amawhna asuoh ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi mokhat zahna ah thugen sin, aziehpen na pilna thugente asimmaw kha ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nidanglai gamgi suong khin sinlen, Pa neiloute gam sungah na gam keh sin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aziehpen amaute tanpa ahat mama a, amaute hum in nang hingdou in apang kha ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kithuhilna ah na lungtang nga inlen, theina thute ah na bil dawin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naupang bawlhoina dingin na khut nualah sin, Aziehpen chiengin sat nan lachin ashi vawtsih ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chiengpum toh na zep lachin, Sheol akipat in ahinna na hundoh ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tapa aw, na lungtang apil leh, Kei lungsim zong akipah ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahi na kam in thudih agen chiengin, ka lungsim a nuom ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na lungtang in mikhielte eng sih henlen, hinanleh sun nitum in Mangpa giing in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pellou in huntawpna ahing um dinga, na kinepna suhmangin a um sih ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka tapa aw, ngaikhie inlen pil in, tuami lampi ah na lungtang pui in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zu haite lah ah pang sinlen, tualeh mi gongsan a sa nete lah ah zong pang sin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aziehpen zu haite leh gongsante ahing zawng ding ua, imut haiten puonsie asil ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na pienna na pa thugen ngai inlen, na nu ateh chiengin simmaw sin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thutah lei inlen zua sin, pilna thuhilna leh theisiemna lei in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Midihtat pa akipah ma ma dinga, tapa pil nei pouma atapa tungah, alungdam mama ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na nu leh na pa kipah uhenlen, nang hing pai na nu lung nuom hen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka tapa na lungtang hing pie inlen, na mit in ka lampite en hen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aziehpen numei kizua khu guomthuhtah ahi a, tualeh numei tavai pen tuikul kochih thuhtah bang ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Suomhatte bangin mi abuhdap a, mihingte lah ah gin umlouna akibelap sah hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Koi ahiei tunggihna nei? Koi ahiei lungkham? Koi ahiei lungkimlouna nei? Koi ahiei phunna nei? Koi ahiei aziehbei a liemna nei? Koi ahiei mit san gegaw nei?
  </para>
  <para style="p">
    <verse number="30" style="v" />Zu mun henglate, zu bungbuta dawnte ahi uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zu asan kilkel laitah in en sinlen, nou sunga azie akilat lai leh, aluonsuh zieh zieh lai in enla vawt sin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Atawp ah gul bangin mi atu a, gulngan bangin mi atu vagiap hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na mit in sil lamdang tahtahte amu dinga, na lungtangin sil kilawmlou agenkhe ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahi, tuipi lai tah a lum bang leh, tembaw puonzahna khuom dawn a lum bang na hi ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Ang vuo ua na kasa sih,” “Ang sat ua ka liem sih,” bangchih chienga khanglou ding a, zu dawn a kuonkia ding ka diei? na chi ding hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migiloute eng sinlen, amau’toh kigop ding zong lunggul sin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aziehpen alungtangun thagum a suhsiet atum ua, akam un buoina bawl ding ngen agen uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilna ziehin inn akilam a, theisiemna toh khumi inn akiphutdet hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Theina ziehin pindante ah van manpha zousie leh, hausatna lungdamhuoi in adim hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mipil khu ahat a, Ahi, theina nei mi’n thahatna akhang sah hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aziehpen thuhilna piltah in gal na dou ding a, tualeh thuhil mi tampi umna ah bitna a um hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi mo adingin pilna asang senga, kulkotpi a kikhopna ah thu gen in akam kaah sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Silhoilou bawl dinga, lung geel pouma thuse bawl mi akichi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi mo lungsim ngaisutna pen khelna ahi a, mi simmawhatte pen mite dingin muda huoi ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vangsietna nia ba a na pua leh, atha zawngkhal na hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shina lam zuon a kikaimangte hunkhedoh inlen, tualeh thadinga kipalpuate nuakai kia in.
  </para>
  <para style="p">
    <verse number="12" style="v" />“En in, tami ka theikha sih uhi na chi pouma leh,” mihing lungtang buh pa’n angaituo sih ding amah? tualeh Ama na hinna kem pa’n tami athei sih ding adiei? Tualeh Ama’n michin anasep dungzuiin athuh sih ding adiei mah?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka tapa khuoizu nein aziehpen ahoi ahi, tualeh khuoikhah a khuoizu chiem in ahum ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuabangma in, pilna theina zong na hinna dingin ahum dinga, tuami na mu chiengin kipahna a um dinga, na lam etna khu suhmang ahi sih ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw migilou, midihtat tenna buhdap sinlen, akhawlna mun zong suhsiet pieh sin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aziehpen midihtat sagivei pua nanleh, athoukia dinga, hinanleh migiloute pen tuohsietna ah a pua ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na melma apua chiengin kipah sinlen, tualeh akipalpua chiengin na lung nuom sah sin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuachilouin Mangpa’n ahing mu dinga, alungkim sih kha ding a, ama apat in alungthahna aheimang kha ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Silhoilou bawlte ziehin kisulungkham sinlen, migiloute zong eng tuom sin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aziehpen migiloute a dingin lam et ding bangma aum sih a, ameivah u’zong mutmit ahi ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka tapa Mangpa leh leengpa giing inlen, lungsim heng themthumte toh kigop sin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aziehpen avangsietna uh thakhat in ahing umdoh ding a, Amautegel tunga sietna hing tung ding, koi in athei ei?
  </para>
  <para style="p">
    <verse number="23" style="v" />Tamte zong mipil thugen ahi. Vaihawmna a, deisah tuom nei ahoi sih hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Koipou migilou kunga, “Mawna na nei sih hi” chi pouma, miten ahamsiet ding ua, namten akidah ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hinanleh migilou phawhhilte akipah ding ua, tualeh guolzawlna hoitah atung uah atung ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dawnna dihtah pe mi muh khu michin in atawp ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pulam a na nasep guonggal masa inlen, tualeh loulai ah nanga ding toh, kituoh in koimasa inlen, tuazou chiengin na inn lam in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aziehbei in na innvengte sietna dingin, theipitu in pang sin; Bangzieh a na kam a solna thu, gen ding na hiei mah?
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ka tunga abawl bangbanga ken zong, ama tunga bawl ding ka hi, chi sin, Anasep dungzui a ama tunga thuh ding ka hi chi sin.”
  </para>
  <para style="p">
    <verse number="30" style="v" />Mithasepa loulai ka zawt kha ngaita a, theisiemna neilou mipa grep huon ah zong, ka suohkha hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Loupa in a dep a, loulingnei in akhukhum sieng a, tualeh a imna suong daite achim siengta hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuate ka mutah in hoitah in ka ngaituota hi, tuate ka en a, thuhilna manphatah ka muta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Banoukhat imut a, tomkhat lusuh zuol a, tomkhat khut phan a khawldam zuol kaal in,
  </para>
  <para style="p">
    <verse number="34" style="v" />zawnna khu suomhatte bangin, na tungah ahing tung dinga, tualeh tahsapna in zong, galvan a kivon bangin ahing delpha ding hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tamte zong Juda leengpa Hezekiah miten, ateikhieh uh Solomon thupilte ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sil im khu Pasian thupina ahi a, hinanleh tua silte suikhieh khu leengpa thupina ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vante sandan, leithuhdan, tualeh leengpa lungtang suiguol ahisih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dangka apat in sam eeh nawtkhie in, tuahileh dangka khengpa’n, manpha tahin akheng thei ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lengpa masanga akipat migilou lakhie in, tuahileh leengtoupha khu dihtatna toh suhdet ahi ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lengpa mai ah nangma kiphat sinlen, mi thupite dinna mun ah ding sin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aziehpen na mitin amusa miliente masanga, koingiem a na um sangin, “Tamlangah hing peitou in hing chileh” ahoizaw hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi toh kiheh dingin thukhenna lamah nawvah sin, aziehpen atawpna ah na innvengten, hing zumsah khata u’leh bang na lawta diei?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na thubuoi na innveng tawh kimaituo in genkhawm pai unlen, tuami thuguh khu midang kung ah gendoh sin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khuchilouin na thu zakha tapouin na zumna dingin, agendoh kha ding ua, na minsietna amangmaw kha ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Akituoh cheta thu kamkhat gen khu, dangka bawm sunga sana apple kikoi bang ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Taihilna piltah khu mi thumang bil ah, sana bilba bang leh sana siengtah, akipat akibawl kizepna bang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thangkou gin um khu asawltute a dingin, bu at lai a vua vawt bang ahi a, aziehpen aman apute hinna asuhal zel hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Silpieh dihlou tah akisahtheipi pouma, meilum guotui pailou leh hui toh kibang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thuohtheina mama in gam vaihawmpa akizawl lungdam zou a, tualeh kam nemtah in gute asutan zel hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khuoizu na mukha ngai ei? Nanga dinga hungiap ne in, na tam neh seng leh ahing ngap ding a na lawkha ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na innvengte inn ah hawmun seng sin, tuachilouin ahing chimtah ding a, ahing muda kha ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A innvengte tunga theipitu dihlou a pang, mi pen khetbuh leh, namsau leh thaltang toh kibang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hasat lai a, mi gin umlou gintat khah khu, habal leh kenggu kituona kilawi toh kibang ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ada leh lungkham mi kunga la sa mi khu, phalbi vawt laitah a apuon sutkhie leh, zuthua leh tang al halkhawm toh kibang ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na melma agilkiel leh neh ding ann pie inlen, adang ataa leh dawn ding tui pie in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuabanga na bawl leh alutunga mei-am sung na hi ding a, Mangpa’n nuomman ahing pe ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mallam hui in guo azusah teitei a, gensietna in lungthahna apiengsah teitei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Numei hangsan toh inn lienpi khat a tenkhawm sangin, inntung vum ning khat a ten ahoizaw hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gamlapi apat a thupha pen, hinna dangtahte a dinga tui vawt bang ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Migiloute zawlzou midihtat khu, tuinah nieh leh tuikhuh nieh toh kibang ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khuoizu tampi neh ahoi sih hi, tuamabangin mi’n ama thupina ding akibawl khu, thupina ahi sih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Koipou ama kithunun zoulou pen, khopi chimsa kulbang neilou bang ahi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nipi lai a vua kie leh, bulah lai a guozu akilawmlou bangin, mi mo kunga pahtawina pieh akilawm sih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vatou kitawm kawi kawi leh, sielpaleng leeng kawi kawi bangin, azieh bei a, hamselaw atangtung sih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sakol a dingin zepna, sabiltunga dingin kamkaina, tualeh mi mote elduong zepna ding in chieng ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi mo amotna dungzui in dawng sin, Nang zong ama bang na hikha ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi mo amotna dungzui in dawng in, ahisihleh apil in akingai kha ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Koipou mi mo khut a thuvaihah poumain, akeng asattan a, sietna adawn hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi mo kam a pawtdoh paunahte pen, mi kengbai kikhai nilnel toh kibang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi mo khat kunga zatatna pe pouma khu, suongtang saili toh khauzam a kaan khawm bang ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi mo kam a pawtdoh paunah khu, zukham khut loulingnei in asut bang ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi vahvai leh mi mo nasem dinga guoikha pouma pen, thalkap siemmi liemsah toh kibang ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ui in ama luoh aneh kia bangin, mi mo in amotna anua bawlkia zel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi ama leh ama apil a kingai na mu kha ngai ei? ama a kipat sangin mi mo a kipat in kinepna aum zaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi thasie in lampi ah humpibahnei a um a, kholai dungah “Humpibahnei giinhuoi tah a um hi,” achi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kotkha kopza tunga akihei kawikawi bangin, mithasie alupna tungah akihei hei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mithasie in annkuong sung akhut in asohsuh a, akam ah akhut a tuttou ngap nawn sih hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi thasie khu ama ngaiin, piltah a dawng thei mi sagi sangin pil akisa zaw hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Midangte kihauna va tuohkha a va kikumthaw mi khu, ui vahlai abil a kiman bang ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi theina meisel leh, thal mawhkap lungsim venglou mi khu,
  </para>
  <para style="p">
    <verse number="19" style="v" />a innvengte a sol zou chienga, “Ka chiemmuina chi mi toh kibang ahi.”
  </para>
  <para style="p">
    <verse number="20" style="v" />Singkhuo umlouna ah mei amit a, tuamabangin gensietna thu zong, agensawn mi umlouna ah kihauna atawp hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meihol khu mei aam sah dingin, singkhuo khu mei kuongsah ding ahimabangin, mi phunsie in kihauna apiengsah ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi gensiet hatte thugen khu hima toh kibang ahia, mihing tahsa sungah thuhtah in alutsuh thei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lungtang gilou kam zol mi pen, leibel dangka tui a kiluonkhum bang ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi muda senga lungsim tahtah genlou a, akam a kilep mi lungtang pen, lepchie na in adim hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thu kilawmtah agen vangin ama gingta sin, alungtang sungah kidahhuoi sagi a um hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A mimudana khu lepchiena in liekhu nanleh, agitlouna khu mipi kikhawmte mai ah, suhlat in a um ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lei hum tou pouma atawsa lei hum sungah, ama mama ake dinga, tualeh suongtum lia pouma, asuongtum in ama adeng ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lei zuoutheiin ama liemsahte a muda a, tualeh maitangphatna kam in zong mi asusie hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zing chienga ding thu ah kisathei sin, aziehpen tua ni in bang ahiei ahing, suohpi ding chi na thei sih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma kam in kiphat sinlen, midangin hing phatzaw hen, nangma muhin kiphat sinlen, meltheilou mi khat in hing genphazaw heh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Suongtum agih a, senel zong, agih a, tuate gel sangin mi maw khat lungthahna agihzaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thangpaina atatsie a, lungthahna zong asitsie hi; hinanleh thangsietna masanga koi ahiei ding thei ding?
  </para>
  <para style="p">
    <verse number="5" style="v" />Aguuh a ki itna sangin alangtanga kiphawh ahoizaw hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lawm hoitah apat liemna khu aginum a, hinanleh melma khat in a hing tawp leh ang leh bawl nop man ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Agilva mi a dingin khuoizu nangawn akidahhuoi a, hinanleh agilkiel mi a dingin, akha nangawn ahum hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A innsunga kipat a vahthap mi pen, vaa abu sunga kipat a leengmang toh kibang ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sathau namtui leh gimnamtui in lungsim asunuom a, tuamabangin lungtang tahtah a hing, kuondoh lawmhoi thuhilna hoiin alawm asulung nuom hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma lawm leh na pa lawm taisan sinlen, vangsietna na tuoh ni in na unaupa inn ah va haw sin, gamlapi a um sanggampa sangin, innveng kinaipi ahoizaw hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka tapa pil inlen, ka lung nuomsah in, tuachi’n kei hing gensete ka dawng thei ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi lunggelsiemten mailam hun a silhoilou amu masa a, akihemkhe thei hi; mi mawl in aphusuoh teitei a, gawt in a um zel hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Meltheilou gamdang mi a dinga, mawpo dinga kichiem mi puonsil lah pieh inlen; numei thanghuoi a dinga mawpo dinga, kichiem ahi leh akichiemna sum dingin koi in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi koi in zong zingkhangpi a, a innveng awngaitah a kikou a aguolzawl leh gausapna a, kisim ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Guochiin ni a inntung ke leh, numei hangsan phunsie akibang hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koipou amanu kham pen hui kham toh kibang ahi a, akhut ziet lam a sathau luongkhie khaam toh kibang giap ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sia in sia atathiem thei bangin, mihingin alawm mel ahiemsah hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theikung kemhoi mi in aga ane dinga, tuabangma in apu kemching mi in pahtat alaw ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tui a mel akimu bangin, mihing lungtangin ama mihin zie akilang sah hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mishikhuo leh gawtmun in hun chi anei ngai sih a, tuabangma in mihing mitten zong tai hun anei ngai sih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Suhsiengna bel khu dangka a ding ahi a, tualeh tumphuolpi khu sana suhsieng na ding ahi, tualeh mihing pen midangten pahtatna dungzui un akize et hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bu suhna sum sunga mi mokhat suh a na suh hangin, amotna toh na kikhen sah zou sih ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na belam honte umdan theichien dingin, thanop suo inlen, tualeh na ganhonte hoitahin kem in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aziehpen hausatnate kumtawn a ding ahisih a, Lenglukhu zong akhang akhanga umden ding ahisih hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bupawl puohkhiet a aum chiengin, loupa noute ahing khangdoh a, tualeh muoldawn a hampate lahkhawmin a um hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Belamnouten na puonsil ding ahing pe dinga, tualeh kelten na lou man ding.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuaban ah na neh ding leh na innkuonpite neh dingin, kelpi nawitui kichingtah na nei dinga, tualeh na innsunga nasem numeite a dingin, kichingtah na nei nalai ding hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migilou pen koima dellou in atai a, hinanleh midihtatte pen humpibahnei bangin ahangsan uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gamsung tatkhelna ziehin vaihawm mi tampi lal in apang ua, hinanleh theisiemna leh theina nei khat ziehin, tua gam adin sawtlaw ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi zawngte bawlsie mizawng khu, neh ding bangma nuasie neilou a, haichigate tawmang sieng guo toh kibang ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Koipou dan taisanten migiloute apahtawi ua, hinanleh dan zuimite’n amaute akal uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi hoilouten vaihawmnadih atheisiem sih ua, Mangpa suiten vang sil zousie atheisiem uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi hausa umdan dihlou tah a gamta sangin, mi zawng dihtah a gamta ahoizaw hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dan zuikim mi pouma tapa pil ahi a, mi gongsante toh kigop miin apa azumsah hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi koipou aneisa tunga sumpung del a, dihloutah a asum supung mi in, migenthei khotuo mi a dinga sum kholpieh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi koipou dan zui utlou a abil lehei pouma, athunget nangawn kidahhuoi ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Midihtat sietna lampi a peimang sah pouma, ama hum tawsa ma ah akesuh dinga, hinanleh genbanglou mi hoiin, Gou hoitah atang ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihausa khu ama ngaidan in pil akisa a, hinanleh mi zawng theisiemna nei miin, ama asuikhedoh zel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Midihtatte a lungnop chiengun thupina nasatah a um a, hinanleh migilou alet chiengin mite akibu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A khelna im mi pouma alawching ngaisih dinga, hinanleh akhelnate kipuongkhie a, tawpsan mi in khotuona amu ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zatattham ching a um zing mi a hampha hi, hinanleh alungtang khausah mi tungah vangsietna atung ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi zawngte tunga vaihawm migilou khu, humpibahnei hawh bang leh vompi hang mi del toh kibang ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Theisiemna tasam vaihawm mi khu, nasatah a mi sugenthei ahi a, hinanleh huoihamna huoin adam sung asusau ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koipou mi sisan suo ding puohgih a nei mi khu, kokhuh ah atailut ding a, koiman hou sih heh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Koipou dihtah a gamta pouma hundam in a um ding a, hinanleh agamtatna zousie a, letat pouma thakhat in apua ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama lou kihaw pouma in neh ding ann ahau dinga, hinanleh koipou pannabeite zui a, taapvahte pen atasam nasa mama ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi ginum in guolzawlna kiching atang dinga, hinanleh hausat pai ut mi pen, gawtlou in asuohta sih ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi deisah tuom nei ahoi sih hi, aziehpen tanghou themkhat zieh in, mi’n sil abawl khiel thei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Koipou kintah a hausat ding tum miin mit hoilou anei a, tualeh tahsapna atung a tung ding angaituokha sih hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Koipou alei a mi maitang phat hat mi sangin, phawhhil mi in atawp ah deisahna anga zaw ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Koipou anu leh apa neisa tomgam pieh a, “Tami tatsietna hisih chipouma” sietna bawl mite kithuopi ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi lungtang kiliensah in kihauna apiengsah a, hinanleh Mangpa muong poumate suhhausat in a um ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama kimuong mi khu mi maw ahi a, hinanleh piltah a gamta pouma hutdoh in aum ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koipou mi zawngte kunga sil pe pouma, atasam sih dinga, hinanleh amauh kimu maw bawl pouma in, gausapna tampi athuoh ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Migiloute ahing khanlet chiengun mite akibu ua, hinanleh amaute amanthai chiengun midihtatte akibelap uhi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Koipou kiphawhhil nanleh, angawng khau sah tei tei mi pen, thakhat a suhmangthai in a um ding ua, suhdam kia thei ahisih ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi dihtatten thuneina atan chiengun mipite akipah a, hinanleh migilouten vai ahawm chiengin, mite thumlemau in a um uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilna it mi in apa alungdam sah a, hinanleh kizuate toh kigop miin aneisa teng azangbei zel hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thudih a vaihawm leengpa’n agamsung asudet a, hinanleh golguhna lapa’n agam asusie hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A innveng maitangphat miin, ama keng awhna dingin lenthang akizah hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Migilou ama tatkhelna thangah awh a, hinanleh midihtatin la asa a akipah hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Midihtat in mi zawngte tungtang angaituo pieh a, hinanleh migilou in tuabang theisiemna theina anei sih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi simmawhatten khopi pumpi thang ah a awsah ua, hinanleh mipil in pen lungthahna aheimang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipil in mi mo khat akinielpi leh, tua mi mopa lungthah in, ahisihleh nuitaleh zong kilemna a um tuom sih hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sisan suo dinga dangtah in midih mawnabei amuda a, hinanleh midih in ahinna hoina ding asui pieh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi mo in alungsim zousie agendoh a, hinanleh mipil pen a ki ip thei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaihawmpa khat in zuou thu angaisah leh, anasemte zousie agilou sieng ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi zawng leh mi simmawhat in kikop khat anei ua, Mangpa’n ani un khovah khomutheina mit ape tuoh tuoh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi zawngte thudih a vaihawm pieh leengpa, mangtoupha kumtawn a sudet in a um ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thununna chiengin pilna apie a, hinanleh naupang kihazan in anu amaizum sah hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Migiloute atam sem sem leh, gamtat khelna atam sem sem a, hinanleh midihtatte’n a puana uh amu ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tapa bawlhoina ah thuzawlechin, ang tawldam sah dinga; Ahi na hinkhuo anuom sah ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kilahna mulouna ah mipite amangthai a, hinanleh dan zui mi pen ahampha hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thu a kihilna maimai in suoh khat akibawlhoi thei sih hi; aziehpen theisiem nanleh azui tuomsih ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kamlawp tah a thugen mi na mu ngai ei? tua mipa sangin mi mopa khat a dingin, kinepna a umzaw hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Asuohpa khat aneu apata hawmthaw tah a kemhoi miin, atawp ah atapa bangin amapa anei khong ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi lungthah bai mi in kihauna apiengsah a, tualeh mi lungtom in bawlkhel ahau hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi khat akiletsahna in angiemsah dinga, lungsim a kingaingiem mi pouma in pahtatna anga ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Guta toh kizopna nei pouma in ama hinna nangawn ahuo a, akichiem hangin thutah agen tuomsih hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihing giinna in thang asiem a, hinanleh Mangpa muongte abit ding uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mitampiten vaihawmpa deisahna asui ua, hinanleh mihinga dinga vaihawmnadih pen, Mangpa a hing kipan ahi bou hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Midihloute pen midih a dingin kidahhuoi ahi a, agamtat a dihtatte pen migiloute a dingin kidahhuoi ahi hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakeh tapa Agur thute, agenlawhna thute ngel: Tam mipa’n Ithiel kung ah leh Ukal, kungah thu aphuongkhie hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Adihtah in midangteng sangin ka mawlzaw dieh a, tualeh mihingte theisiemna ka nei sih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilna lah ka zil ngaisih a, asiengthoupa lah kana theikha ngai sih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vantunga kaltou a kumsuh kia khu koi ahiei? akhut sunga hui humthei koi ahiei? Leitung ning tawpna zousie sudetpa koi ahiei? tua mipa min bang ahiei? Tualeh atapa min bang ahiei? Nangman na theichien hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pasian thu chinteng adih a; Ama muonga belte adingin lum le phaw ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Athute belap sin, ahisihleh ahing phawhhil kha dinga, mi zuou na suoh kha ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanga kipat in sil ni ka hing ngen hi, ka shi masangin tuate hing nelsie pieh sin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei akipat in thudihlou leh, zuou thu kigente gamlapi ah koimang inlen, zawng sengin hing koi sinlen, hausengin zong hing koi sin, ni sima ka neh ding khop hing pie in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hausa seng leng nang ka hing manghil kha dinga, “Mangpa khu koi ahiei ka chikha viel dinga,” zawng seng taleng lah mi neisa ka guhpieh kha dinga, ka Pasian min ka daisah kha ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Suoh khat apu kungah hehse sin, ahing hamsiet kha dinga, ahing kimawsah kha ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Apate uh gausap leh anute uh, guolzawllou khang khat a um uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amauh mitmu a siengthou kisa, hinanleh athanghuoina ua pat a, sawpsieng nailou khang khat a um uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ki-uongsah tah a mit tungha a, amit vunte uh sangsah a vandah ving veng, khangkhat a um uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A zawngte leitung apat a valtum ding leh, mite lah apat a tasamte netum dinga, ahate uh namsau bang ahia, ahate uh temta hiem bang mi pawlkhat a um hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vot in tanu ni anei a, tuaten “Hing pie’n hing pie’n” chi’n akikou uhi. Lungkim thei ngailou sil thum a um a, Ahi, “Ahunta” chi ngai vawtlou sil li a um hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Haankhuh naupaina naubu chiing, tuidu a dangta ngitnget leitang, “Ahunta” chi ngailou mei ahi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pate simmawna leh, nute thumanna nuisatna mitte khu, phaijang va-ah ten akheupieh dinga, langta nouten ane ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keima’n lamdang seng ka sah sil thumtah aum hi; tualeh ka thei zoulou sil li apha hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vanlaizawla muvanlai lenna lampi, suongpi tunga gul lampi, tualeh tuipi tunga tembawh peina lampi leh, nungah leh tangval ki itna lampi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aangkawm numei gamtatna tambang ahi; ane a anehzou in anephu asia sienga, “Sildihlou bangma kabawl sih hi,” achi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sil thum ziehin leitung akiling a, tualeh athuoh zoulou sil li a um hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Suoh khat leengpa ahing pan chiengin, mi mo annkham a um,
  </para>
  <para style="p">
    <verse number="23" style="v" />Numei mudahuoi in pasal anei chiengin, suohnu khat in api asuon chiengin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Leitungah sil neu mama hinanleh pil mama li a um hi,
  </para>
  <para style="p">
    <verse number="25" style="v" />mesite ahat hetlou ganhing hon ahi ua, nipi laiin a ann neh ding uh akholkhawm uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zupite thahatna neivawtlou ganhing ahi ua, suongpi kawm ah inn abawl uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khuongbaiten leengpa anei vateh sih ua, hinanleh ahonhon in akitawl vaduam uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Inn ngah khu khut sunga mat thei hinapi in, leengte innpi sungah ateng uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kituoh tah a kalsuon khawm thum apha ua, akalsuon kilawm leh pisuoh mama li a um uhi,
  </para>
  <para style="p">
    <verse number="30" style="v" />Humpibahnei gamsa lah a hat pen ahi a, bangma mai a tai ngailou ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aa tal kimuongtah, keltal kimuongtah a vah lingliang leh, amipite masanga leengpa’n pitah a akalsuon khu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mot huoi tah a nangma na kiphat khahleh, ahisihleh sil hoilou na bawl tup leh, nakhut in na kam hum in.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aziehpen bawngnawi tohhal in hot lei, bawngnawi dat ahing suoh a, tualeh nahkuo heh lei nahkuosi aluong hi, tuabangma in kinielna in kihauna apiengsah hi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leengpa Lemuel thute anu’n ama anahil athugendohte:
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka tapa bang ahiei? Ka sunga pieng ka tapa bang ahiei? Bang ahiei ka kichiemna tapa?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na hatna numei kungah pe sinlen, leengte susetute kungah na lampite pe sin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Lemuel, leengte ading hilou, zu dawn khu leengte ading ahisih a, vaihawm mite adingin zuchia dawn ahoi sih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dawnta uleh danthupiehte amanghil ding ua, suhgentheina thuohte a dingin, thudih a vaihawmna akaikawi kha ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mangthai dinga kisate kungah zu chia pie inlen, tualeh milunggimte kungah zu chia pie in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama’n dawn henlen azawnna uh manghil uhenlen, agentheina uh thei nawn sih uhen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hamtheiloute adingin na kam kaah inlen, Ashi dinga kiguotsa mite tungtang thu gen pieh in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na kam kaah inlen, dihtah in thu khen inlen, mi tasamte leh mi gentheite tungtang thu gen pieh in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zi umdan hoi koi in amuzou diei, Amanphatna pen Rubi suongmanpha sangin, amanpha zaw tham hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Apasal lungtangin amanu amuong chinten a, phattuomna atasam ngai vawt sih ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amanu’n adamsungin apasal a dingin, aselam hilou ahoilam nna asep pieh ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amanu’n samul khau leh naikhau asui a, thanuom tahin akhut in lungkimtah in nna asem hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanu khu summet bawlte tembawh bang ahi a, amanu’n gamlapi akipat in ann neh ding, ahing paw zel hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khovah masangin amanu athou a, a innkuonte kungah ann apie a, tualeh anasem nungahte ading tanvou apie hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amanu’n lou angaituo a, tuakhu alei a, akhut nasep ga in grep huon abawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thahatna in atai agah a, abantha ahat sah hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Asummet bawlte ahoi hi chi amu a, zanlai chieng in zong ameivah amit sih hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A khut in mui azom a, akhutin muitung atu ngitnget hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A khut migenthei lam ah azah a, Ahi, akhotuona khut in tasamte abanpha hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amanu’n a innkuonpite akhuolnain vua kieh ding agiing sih hi; aziehpen a innkuonpite zousie puonlum sandang aguon a asil chiet uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Puonpha kilawmtah ama a dingin abawl a, amanu puonsilte puon malngat leh, puonsandup ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pasal gamsunga upate lah a, kulkotkha bula atou chiengin theiphah in a um hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amanu’n puon malngatte puonsil in abawl a, tuate azua hi, summet bawlte kungah puon kawnggahte azua zel hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thahatna leh zatatnate amanu puonsil ahi a, hun hing tung dingte ah amanu anuom ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amanu’n pilna toh akam akaah a, alei ah hepina dan a um hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanu’n a innkuonpite khohei danding hoitahin akhuol a, thasietna ann a ane ngai sih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Atate ahing thou ua, amanu khu hamphanu achi uhi; tualeh apasal in zong amanu hamphanu chi’n apahtawi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Tanu tampiten silhoi ana bawl ua, hinanleh nangman amaute na khup sieng hi,” achi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngai banna pen solhat ahi a, tualeh melhoina zong bangmalou ahi; hinanleh Mangpa giindansiem numei in pahtat alaw ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Akhut nasep gate amanu pie unlen, tualeh khopi kulkotkhate ah amanu nasepte, mama in amanu pahtawi hen.
  </para>
</usx>
