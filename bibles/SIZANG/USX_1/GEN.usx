<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Pianciilna</book>
  <para style="h">Pianciilna</para>
  <para style="toc1">Pianciilna</para>
  <para style="toc2">Pianciilna</para>
  <para style="mt">Pianciilna</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />A kipatciilin Pathian in vaannuai bup bitphua hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />tualai in leitung sia lim le meal nei ngawlin awngthong hi. Na theampo a tuam tuipi kihual sia khuazing in siin bikbek a, Pathian Thaa sia tui tungah diang hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuaciang Pathian in, “Khuavak om hen” ci in thupia a — khuavak piang hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian in tuasia a mu ciang phasa a, lungkim hi. Tuasia ciang ama in khuazing pan khuavak khen hi,
  </para>
  <para style="p">
    <verse number="5" style="v" />ama in khuavak sia ‘Sun’ ci a, khuazing sia ‘Zan’ ci hi. Nitak hun bo in zingsang hong theng a — a ni khat ni ahi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua zawkciang Pathian in, “Tui sia mun nii in a kikhen tuam natu mun kuampi khat om hen” ci in thupia a — tuaciang tuabangin piang hi. Pathian in tuabang mun kuampi khat vawt a, tuasia in a tung tui sia pan a nuai tui sia khen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama in mun kuampi sia “Van” ci hi. Nitak hun bo in zingsang hong theng a — a ni nii ni ahi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua zawkciang Pathian in, “Leitang pian natu in, van ii nuai a om tui teng mun khat ah kingawm hen” ci in thupia a — tuaciang tuabangin piang hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in leitang sia “Leitung” ci a, a kikaikhawm tui teng sia “Tuipi” ci hi. Pathian in tua bang a mu ciang phasa a, lungkim hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua zawkciang ama in, “Leitang in thingkung lopa nam theampo, tang a neite le nga a neite piangsak hen” ci in thupia a — tuaciang tuabangin piang hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leitang in thingkung lopa nam theampo piangsak a, Pathian in tuabang a mu ciang phasa a, lungkim hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nitak hun bo in zingsang hong theng a — a ni thum ni ahi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tua zawkciang Pathian in, “Sun le zan kikhen natu, nite, kumte le biakna poaite kipatna lak natu in van ah khuavakte piang hen a;
  </para>
  <para style="p">
    <verse number="15" style="v" />leitung khuavak pia tu in van taang hen” ci in thupia a — tuaciang tuabangin piang hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua ahiciang Pathian in khuavak a lian zaw nii vawt a, sun a uk tu ni le zan a uk tu tha ahi hi; ama in aksite zongh vawt hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama in leitung a taangsak tu in van ah khuavakte koi a,
  </para>
  <para style="p">
    <verse number="18" style="v" />sun le zan a uk tu le khuazing le khuavakte a khen tu ahi uh hi. Pathian in tuabang a mu ciang phasa a, lungkim hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nitak hun bo in zingsang hong theng a — a ni li ni ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua zawkciang Pathian in, “Tui sia a nungta nganhing nam tam mama te taw kidim hen a, vui sia vacimte taw kidim hen” ci in thupia hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tua ahiciang Pathian in tuipi nganhing liante, tui sung a nungta nganhing nam theampo le vacim nam theampo bitphua hi. Pathian in tuabang a mu ciang phasa a, lungkim hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian in tuate theampo thupha pia a, tui sung a teang nganhingte no nei in tuipi sung dim tavun, tuaciang vacimte pungin tam mama pha vun, ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nitak hun bo in zingsang hong theng a — a ni nga ni ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua zawkciang Pathian in, “Nganhing nuntakna a nei nam theampo: innsa le ngamsa, a lian le a no leitang in piangsak hen” ci in thupia a — tuaciang tuabangin piang hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuabangin tuate Pathian in vawtsiat hi, tuaciang ama ii mu teng sia phasa a, lungkim hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua zawkciang Pathian in, “Tu in eite in mihing ih vawt tu hi, amate sia eima taw kibang tu a hong suun tu hi. Amate in, ngasa, vacim le innsa ngamsa, a lian a note tungah vaang nei tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua ahiciang Pathian in ama mama taw a kibang mihingte bitphua hi. Ama in pa le numei bitphua a,
  </para>
  <para style="p">
    <verse number="28" style="v" />thupha pia in, “Na suan na paalte leitung mun theampo ah teangin, amate in leitung a uk tu in, ta tam mama nei tavun. Keima in ngasate, vacimte le nganhingte theampo tungah ukna za kong pia hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keima in note neak tu in antang nam theampo le thingnga nam theampo kong pia a,
  </para>
  <para style="p">
    <verse number="30" style="v" />ahizong ngamsate theampo le vacimte theampo ii an tu in lopa le a tee nei a kungte ka pia hi,” a ci ciang — tuabangin piang hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian in a vawtsa theampo a et ciang phasa in lungkim mama hi. Nitak hun bo in zingsang hong theng a — a ni luk ni ahi hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuabangin vaannuai buppi sia kikhuangkhim hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A ni sali ni ciangin Pathian in a nasep teng man siat a, nasep tawlnga hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tua ni in ama in a bitphua nasep a khuangkhim a, a nasep tawlnga ahi hu in, a ni sali sia thupha pia a, ni thupi khatin tuam koi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuaciang vaannuai bitphuana sia tuabang teng ahi hi. Topa Pathian in vaannuai bup a vawt lai in,
  </para>
  <para style="p">
    <verse number="5" style="v" />leitung ah thingkung lopate om ngawl a, thaicii a po zongh om ngawl hi, banghang ziam cile ama in nguazusak ngawl a, lotho tu khat zongh om ngawl hi,
  </para>
  <para style="p">
    <verse number="6" style="v" />ahizong leinuai pan tui pusuakin, lei kawtsak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuasia ciang Topa Pathian in lei pan leivui pawlkhat la in tuasia taw mihingpa khat vawt hi; ama in a naak sungah nuntakna a piangsak hu mopin tua mihingpa hong nungta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua zawkciang Topa Pathian in nisuana sang Eden ah huan khat vawt a, tua munah ama ii vawtsa mihingpa koi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama in a et hoi thingkung namcin tua munah posak in, ngaphate ngasak hi. Huan laizang ah nuntakna a pia thingkung le a pha a sia heak theina a pia thingkung posak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Eden huan sungah lui khat luang a, huan sung tui kawtsak hi; Eden puasang a thet ciang tua sia ngun li in kikhen hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A masabel ngun sia Pishon hi a; Havilah ngam kiimvealin luang hi. (
  </para>
  <para style="p">
    <verse number="12" style="v" />Tualai ah khamh ciitak om a, a om vazaak ngawl paaknamtui le suang manphate zongh om hi.)
  </para>
  <para style="p">
    <verse number="13" style="v" />A niina ngun sia Gihon hi a; Cush ngam kiimvealin luang hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A thumna ngun sia Tigris hi a, Assyria ngam nisuana sangah luang hi, tuaciang ngun a lina sia Euphrates ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuaciang Topa Pathian in Eden huan sungah a tho tu le a cing a keam tu in, mihingpa koi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in ama tungah, “Huan sung thingkung khat pawpo ii nga na ne thei tu a,
  </para>
  <para style="p">
    <verse number="17" style="v" />a pha le a sia heak theina thingnga ngawlbuang na ne thei tu hi. Tua thingkung ii nga na ne buahet tu a; na ne le na neak ni ma in na thi tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuaciang Topa Pathian in, “Mihingpa sia ama nguak a om tu pha ngawl hi. Ama a hu tu in a kilawm koppui tu khat ka vawt tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tua ahiciang Pathian in lei pan leivui pawlkhat la in, nganhing theampo le vacim theampo vawt hi. Tua zawkciang tua teng min a vaw tu in mihingpa ii mu tu in paipui a; ama ii min vaw bangin min nei siat uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuabangin mihingpa in vacim theampo le nganhing theampo min vaw siat a, ahizong ama a panpui thei tu a kilawm a koppui tu khat zongh om ngawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuasia ciang Topa Pathian in mihingpa mutthipsak a, a mut lanin a telngu khat laaksakin tua mun a sa khak kik hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian in tua telngu taw numei khat vawt a, ama ii kungah paipui hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuasia ciang mihingpa in, “Tu pepeet ciang, hisia in keima ii nam bang mihing khat — ka ngu pan a kila ngu le ka sa pan a kila sa ahi hi. Mihingpa sung pan a kila nu ahikom ama ii min ‘numei’ hi,” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua ahi hu in mihingpa khat in a nu le a pa nusia in a zi taw kingawm tu a, amate pumkhat suak tu uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tua mihingpa le tua numei a pumnguak hi uh a, ahihang maizum ngawl uh hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tu in ngul sia Topa Pathian vawtsa nganhingte sung pan a thiimthelbel nganhing ahi hi. Ngul in numei tungah, “Pathian in, huan sung thingkung khat pawpo ii nga ne thei ngawl tu nu hi, hong ci takpi ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Numei in, “Huan sung thingkung pawpo ii nga ne thei tu khu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahizong Pathian in huan laizang a om thingkung ii nga sia na ne buatu uh hi, tham zongh na tham buatu uh hi, hong ci hi; ka ne ka tham uh le ka thi tu uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngul in, “Tuasia thumaan hi ngawl hi; thi ngawl tu nu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Banghang ziam cile na neak uh ciang, Pathian taw kibangin, a pha le a sia na heak tu hunlam uh he ahikom Pathian in tuabangin hong ci hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Numei in thingkung hoizia le a nga a limtuakziate mu a, tuaciang miciim sua tu sia bangza in pha tu ziam ci in, ngaisun hi. Tua ahikom thingnga pawlkhat loin, ne hi. Tuaciang pawlkhat a pasal pia a, a pasal zongh in ne hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A neak zawk po ciang amate teltheina kipia a, a pumnguak ahi hunlam kiphawk uh hi; tua ciang amate in theitee te khui khawmin kiseal uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua nitakin, amate in huan sungah Topa Pathian khuasuan nging za uh a, ama ii mu ngawl natu thingkungte kawmah buu uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahizong Topa Pathian in mihingpa sam a, “Nang koi sungah om ni ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in, “Huan sungah na khuasuan nging ka za a; ka pumnguak om ka hikom lau in ka buu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in, “A kua in na pumnguak om ni hi, hong ci ziam? Ne heak in kong ci thingnga sia ne ni ziam,” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihingpa in, “Kei taw a omkhawm tu nong piak numei in thingnga hong pia a, ka ne hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Topa Pathian in numei tungah, “Banghang hi bang ngamta ni ziam?” ci in dongh hi. Ama in, “Ngul in hong theam a, ka ne hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuasia ciang Topa Pathian in ngul tungah, “Hi thu hangin nang daan hong kipia tu a; nganhing theampo sung pan nangma bek in hi haamsiatna na thuak tu hi: tu a kipan awmtaalin na vak tu a, na nuntak lai teng leivui na ne tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Numei taw khat le khat kong kihuatsasak tu a; ama ii hin le toaite le nang aa te a tawntungin na kingal tu uh hi. Ama ii hin le toaite in na lutang hong sucip tu a, nang in a khuatul na tuksak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuaciang ama in numei tungah, “Nau na paai ciang na ngimna le nau na sua ciang na natna kong khangsak tu hi. Tua kawm pan na pasal ma na it veve tu a, ama in nang hong uk lai tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuaciang ama in mihingpa tungah, “Na zi thu son ni in, ne heak in, kong ci thingnga sia ne ni hi. Tuabang ngamta na hikom nang hangin leitangh in haamsiatna thuak hi. Leisung pan nangma atu an a khom a pian natu in, na nuntak sung tawntung haksa takin na na seam tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lei sung pan ling le lopa te hong po tu a, duisung thingkung pan a piang ngamh ante na ne tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hong kipiansakna leitang ah na cia kik mateng leitang tung pan na a pian thei natu in, haksapi tak le khua ulsa suak in na na seam tu hi. Lei taw hong kivawt na hikom lei ma na suak kik tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adam in a zi min sia Eve phuak hi, banghang ziam cile ama in mihing theampo ii nu ahi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuaciang Topa Pathian in Adam le a zi atu in savun puan vawtin amate silhsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuaciang Topa Pathian in, “Tu in, mihingpa sia eima khat bang hong suakin a pha le a sia he hi. Nuntakna thingkung ii nga sia ne in a tawntungin a nuntak tu ki oai ngawl het tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tua ahiciang Topa Pathian in mihingpa sia, Eden huan pan hawlkhia in ama a kipiansakna leitang thosak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua ciang huan ii nisuana sangah Cherub te le a kiim mun theampo ah a kiheak, meikuang namsau khat koi hi. Tuasia kuama in nuntakna thingkung nai a neak thei ngawl natu in a khaamna ahi hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuaciang Adam in a zi ompui a, a zi naupaai hi. Ama in tapa khat nei a, “ Topa huna taw tapa khat ka nei hi,” ci hi. Tua ahikom ama in a min Cain phuak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nungsang ciang tapa khat nei kik a, Abel ahi hi. Abel sia tuucingpa khat suak a, ahizong Cain sia lothopa khat ahi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hun khat zawkciang Cain in a lo sung pan a piang ante hong paipui a, Topa tungah biakpiakna pia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuaciang Abel in a tuute khat pan a suak a taciil sia ngoin a sa limci belna teng taw biakpiakna pia hi. Abel biakpiakna tungah Topa lungkim hi,
  </para>
  <para style="p">
    <verse number="5" style="v" />ahizong ama in Cain le a biakpiakna nial hi. Cain sia a thin uuk mama a, lungkim ngawlin a mainguum hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuaciang Topa in Cain tungah, “Banghang thin uuk ni ziam? Banghang na mai nguumsak ni ziam?
  </para>
  <para style="p">
    <verse number="7" style="v" />A maan seam na hile na maitai tu a, ahizong a sia na vawt hu in, mawna in na innkha ah bok nginge hi. Tua in nang hong uk nuam a, ahizong nangma in tuasia na zaw kul tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaciang Cain in a suapuipa Abel tungah, “Dui sungah pai tawng,” ci hi. Amate dui sung a thet ciang Cain in a suapuipa ngalvawtin thatlum hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Topa in Cain tungah, “Na suapuipa Abel koi sungah om ziam?” ci in dongh hi. Cain in, “He ngawl khi hi. Ka suapuipa a cingpa hi na khi ziam?” ci in zo hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuasia ciang Topa in, “Banghangin hi bang a, a sia mama na seam thong ni ziam? Phula nuam a, a au aw khat bangin na suapuipa chisan in lei pan kei hong biakpui hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang sia haamsiat thuakpa na hi a, leitangh tho thei nawn ngawl tu ni hi. Na thalup lai in na naupa chisan dong tu in a kamkaa sa bang keakin tua lei in na naupa chisan huup zo hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />An ciin tu na hanciam zong lei pan bangma piang ngawl tu a, inn nei ngawlin leitung ah na vakthap tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuaciang Cain in Topa tungah, “Hi daanpiakna sia kei thuak tu in haksa leih hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka omna ngam pan nong hawlkhia a, nong ompuina pan a khualana ah nong notkeak hi. Inn nei ngawlin leitung ah a vakthap ka hi tu a, hong mu po in kei hong that tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahizong Topa in, “Hi ngawl hi. Khat po in nang hong that le phu kilamna in nuntakna sali kila tu hi,” ci in zo hi. Tua ahikom a kisik pui khat po in a thalup ngawl natu in, Cain tungah Topa in tepteena khat koi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuaciang Topa omna panin Cain paikhia a, Eden ii nisuana sang “Vakkot” a kicina ngam le lei ah teang hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cain le a zi in tapa khat nei a, a min Enoch phuak hi. Tuasia ciang Cain in khuapi khat saat a, a min tu in a tapa min vaw in Enoch ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Enoch in tapa khat nei a, a min Irad ci hi, Irad sia Mehujael ii pa hi a, Mehujael in tapa Methushael nei a, ama sia Lamech ii pa ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lamech in zi nii nei a, Adah le Zillah ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adah in ta Jabal nei a, ama sia puanbuk sungah a teang ngankhoaite ii taanghpupi ahi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A suapuipa sia Jubal hi a, ama sia tengtongh le tamngai a tum thei, music thiamte theampo ii taanghpupi ahi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zillah in Tubal Cain nei a, ama in thik le taau panin nazak namcin vawt hi. Tubal Cain ii suapuinu sia Naamah ahi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lamech in a zite tungah, “Adah le Zillah awng, hong ngai tavun: tangvalno khat thatlum zo khi hi, banghang ziam cile ama in kei hong vua hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cain kithalup manin a nuntakna sali taw kithuk kik ahile, kei hong thatlum a om le a sawmsali le salivei in kithuk kik tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Adam le a zi in tapa dang khat nei hi. A zi in, “Cain ii a thalup Abel taang tu in, Pathian in tapa khat hong pia hi,” ci hi. Tua ahikom a min Seth phuak hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Seth in Enosh kici tapa khat nei hi. Tua hun panin mihingte in biakpiakna ah Topa ii min thiangtho law kipan uh hi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />A nuai a teng sia Adam suan le paalte ahi hi. (Pathian in mihing a bitphua lai in, ama taw a kibangin vawt hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama in pa le numei bitphua a, thupha pia in, “Mihing” ci hi.)
  </para>
  <para style="p">
    <verse number="3" style="v" />Adam kum 130 a phak ciang, ama a suun tapa khat nei a, a min Seth phuak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua zawkin, Adam kum 800 nungta lai hi. Ama in ta dang zongh nei a,
  </para>
  <para style="p">
    <verse number="5" style="v" />kum 930 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Seth kum 105 a phak ciang tapa Enosh nei a,
  </para>
  <para style="p">
    <verse number="7" style="v" />tua zawkin kum 807 nungta lai hi. Ama in ta dangte zongh nei a,
  </para>
  <para style="p">
    <verse number="8" style="v" />kum 912 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Enosh kum 90 a phak ciang tapa Kenan nei a,
  </para>
  <para style="p">
    <verse number="10" style="v" />tua zawkin kum 815 nungta lai hi. Ama in ta dangte zongh nei a,
  </para>
  <para style="p">
    <verse number="11" style="v" />kum 905 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kenan kum 70 a phak ciang, tapa Mahalalel nei a,
  </para>
  <para style="p">
    <verse number="13" style="v" />tua zawkin kum 840 nungta lai hi. Ama in ta dangte zongh nei a,
  </para>
  <para style="p">
    <verse number="14" style="v" />kum 910 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahalalel kum 65 a phak ciang, tapa Jared nei a,
  </para>
  <para style="p">
    <verse number="16" style="v" />tua zawkin kum 830 nungta hi. Ama in ta dangte zongh nei a,
  </para>
  <para style="p">
    <verse number="17" style="v" />kum 895 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jared kum 162 a phak ciang, tapa Enoch nei a,
  </para>
  <para style="p">
    <verse number="19" style="v" />tua zawkin kum 800 nungta hi. Ama in ta dangte zongh nei a,
  </para>
  <para style="p">
    <verse number="20" style="v" />kum 962 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Enoch kum 65 a phak ciang tapa Methuselah nei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua zawkciang Enoch in Pathian taw kum 300 kithawlin, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama sia kum 365 nungta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathian taw a nuntak sung kithawl khawm a, tuaciang ama bo hi, banghang ziam cile Pathian in ama la hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Methuselah kum 187 a phak ciang, tapa Lamech nei a,
  </para>
  <para style="p">
    <verse number="26" style="v" />tua zawkin kum 782 nungta lai hi. Ama in ta dangte zongh nei a,
  </para>
  <para style="p">
    <verse number="27" style="v" />kum 969 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lamech kum 182 a phak ciang tapa khat nei a,
  </para>
  <para style="p">
    <verse number="29" style="v" />ama in, “ Topa ii haamsiatsa leitang tung mama panin hi tano in ih nasep haksatna theampo panin hong dawn tu hi,” ci ahikom a min Noah phuak hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lamech kum 595 nungta lai hi. Ama in ta dangte zongh nei a,
  </para>
  <para style="p">
    <verse number="31" style="v" />kum 777 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Noah kum 500 a phak zawkciang, tapa thum nei a, Shem, Ham le Japheth ahi uh hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leitung theampo ah mihing kizel a, tanumeite hong piang hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />Van mite pawlkhat in tua tanumeite phasa ahikom a dei po teenpui hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuasia ciang Topa in, “Mihingte sia a nuntak tawntung tu ka oai bua hi; amate cii le sa hi. Tu a kipan kum za le kul kaanin nungta ngawl tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua hun sung le tua zawkciang zonghin mihing tanumeite le van mite ii suan le paal mihing thatang lian namte leitung ah om hi. Amate sia taanghlai a ngalhangte le mihing minthangte ahi uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Leitung ah mihing theampo bangzata seksol a, khua ngaisut a sia bebek a nei tawntungna thu Topa in a mu ciang,
  </para>
  <para style="p">
    <verse number="6" style="v" />amate vawt a leitung ah a koisia khuangai hi. Ama hee mama a,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Hi ka bitphua sa mihingte, tuaciang nganhingte le vacimte zongh ka bosak siat tu hi, banghang ziam cile amate ka piansak sia ka khuangai hi,” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahizong Noah tungah Topa lungkim hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hi sia Noah taanghthu ahi hi. Ama in tapa thum nei a, Shem, Ham le Japheth te ahi hi. Noah in khialna nei ngawl a, ama ii hun lai in ama bekma mipha om hi. Pathian taw kithawlin nungta a,
  </para>
  <para style="p">
    <verse number="11" style="v" />ahizong mi theampo Pathian muna ah a sia hi a, koima po ah ngoltol ngamtatna kizel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian in leitung en a, a sia in mu hi, banghang ziam cile mihing theampo siatna taw kidim in nungta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian in Noah tungah, “Mihing theampo bosak tu in ka khensat zo hi. Leitung sia amate ngoltolna taw kidim ahikom amate ka mon siat tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang atu in thingpha taw teambaw khat vawt in a; a sungah inndoite vawtin, a sung a pua thingnaai taw zut in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuasia metre 133 a sau, metre 22 a zai, le metre 13 a saangin vawt in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Teambaw khuvum vawt in a, a khuvum le a pangh te kilaklaw centimetre 44 vangsak in. Dawl thum in vawt in a, a pangh ah kongkha khat koi in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nuntakna a nei theampo a lalcip tu in leitung ah tuipi ka liimsak tu hi. Leitung a om theampo thi siat tu a,
  </para>
  <para style="p">
    <verse number="18" style="v" />ahizong nang taw thuciamna khat ka vawt tu hi. Teambaw sungah na zi, na tapate le a zite taw tum vun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amate a nuntak natu in, nganhing namcinte le vacim namcinte sung pan anu khat le apa khat veu la in teambaw sungah khum in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Noma le tua teng atu in an namcinte zongh la in khol in,” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian thupiak bangin Noah in na theampo vawt siat hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Topa in Noah tungah, “Na innkuan bupin teambaw sungah tum vun; leitung theampo ah a maanin a seam sia nangma bekma kong mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Biakna taw kisai a thiangtho nganhingte kop sali tek paipui in a, ahizong a thiangtho ngawl nganhingte ahile kop khat tek bek paipui in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vacimte zongh nam khat ciang kop sali tek paipui in. Leitung ah vacim le nganhing nam theampo no nei kikin a nuntak natu hi bang vawt in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tu zo ni sali zawkciang, ni sawmli sung sun le zan ngua kong zusak tu a, ka vawtsa nuntakna nei theampo a mon natu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuaciang Noah in Topa thupiak theampo vawt siat hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Leitung ah tuipi a liim lai in Noah kum zaluk pha hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuipi liimna pan a suakta tu in Noah le a zi, a tapate le a zite teambaw sungah tum uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nganhing le vacim namkim anu le apa kopkhat tek, biakna taw kisai a thiangtho ahizong a thiangtho ngawl ahizong,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian thupiak bangin Noah taw teambaw sungah tum khawm uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni sali zawkciang tuipi liim hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noah kum zaluk a phak zawk, a tha nii na ni sawm le ni sali ni in, leinuai a om tui teng puaktham in kihongkeak a, mun theampo pan tui phuul hi, van ii tui kongpi theampo kihongin,
  </para>
  <para style="p">
    <verse number="12" style="v" />sun sawmli le zan sawmli tawntung leitung ah nguazu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tua ni ma in Noah le a zi sia a tapate thum Shem, Ham, Japheth le a zite teng taw teambaw sungah tum uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate taw in nganhing nam theampo, innsate le ngamsate, a lian a no, le vacim nam theampo tum uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian thupiak bangin nganhing nungta peuma ii a nam khat sim sung pan anu khat le apa khat veu Noah taw teambaw sungah tum uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Noah a tum zawkciang Topa in kongkha khak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuipi liim ni sawmli a ngei ciang teambaw a laam khom tu in tui hong thuk hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tui thuk vaial a, tui tungah teambaw laam hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tui thuk mama a, mualsaangbelte zong khum hi;
  </para>
  <para style="p">
    <verse number="20" style="v" />mualsaangbelte ii dawn tungsia ah metre sali a phak dong bang tui khang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Leitung ah a om a nungta teng — vacim theampo, nganhing theampo le mihing theampo thi siat hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Leitung ah om husang theampo thi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Topa in leitung ah a nungta theampo — mihing, nganhing le vacimte theampo mongsak siat hi. Noah le ama taw teambaw sungah a om teng bek taang hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni 150 sung tui kiamsuk tu kipan ngawl hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian in Noah le ama taw teambaw sungah a om nganhingte theampo mangil ngawl hi; ama in vuivasak a, tuaciang tui kiamsuk tu kipan hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leinuai pan tui phulna vangte le van ii tui kongpite kikhak siat hi. Nguazu nawn ngawl hi,
  </para>
  <para style="p">
    <verse number="3" style="v" />tuaciang ni 150 sung dadam in tui kiamsuk hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tha sali na, ni sawm le ni sali ni in, teambaw sia Ararat mual tungah hong tawlnga hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tui kiam susuk a, a tha sawmna, ni khat ni in mualdawnte kilangh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ni sawmli zawkciang Noah in khelki khat hong a,
  </para>
  <para style="p">
    <verse number="7" style="v" />va-ak khat tha hi. Va-ak hong heak kik ngawl a, ahihang tui a kiam siat mateng leang kawkoai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua hun sungin, tui kiam siat zo ziam ci sia a heak natu in, Noah in vakhu khat tha a,
  </para>
  <para style="p">
    <verse number="9" style="v" />ahizong lei theampo tui in khum lai ahikom vakhu in a tuk natu mun mu ngawl hi. Teambaw kungah vakhu hong leang kik a, Noah in manin sungtan pui hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in a dang ni sali a ngak zawkciang tua vakhu tha kik hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nitak sang ciangin ama kungah olive tee hing khat a muk ah pu in tua vakhu hong heak kik hi. Tua ahiciang tui kiamsuk zo a hina thu Noah in he hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua zawk ni sali ngak lai in khatvei ma tua vakhu tha kik hi; tu sia ciang, vakhu hong heak kik nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Noah kum 601 a phak zawk, a tha khatna, ni khat ni in tui kiam siat hi. Noah in teambaw sitna hongin khua en kawkoai a, leikote mu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A tha niina, ni kul le ni sali ni ciang leitung ko thiang hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian in Noah tungah,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Na zi, na tapate le a zite taw teambaw sung pan pusuak vun.
  </para>
  <para style="p">
    <verse number="17" style="v" />No nei kik a leitung theampo ah a kizel natu in, vacim theampo le nganhing theampo nangma pusua pui in,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua ahiciang Noah sia teambaw sung pan a zi a tapate le a zite taw pusuak uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nganhing theampo le vacim theampo a nam zui in, a pawl a pawl in teambaw sung pan pusuak uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noah in biaknatau khat Topa atu vawt hi; biakna taw kisai a thiangtho nganhing nam le vacim nam sim pan khat tek la in, biaknatau tungah pum bup meihal biakpiakna in pia hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Topa sia biakpiakna ngimnamtui in lungdamsak hi, tuaciang a thinsung ah, “Mihing ngamtatna hangin leitung ka haamsiat kik ngei buatu hi; a no lai pan a khuangaisutnate a siat hunlam ka he hi. Tu a ka vawt bangin nuntakna nei theampo ka mon kik ngei buatu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Leitung a om laiteng lopoai hun le anlaak hun om tu hi. A vot le a sa, khuakhaal le phalbi, sun le zan om tawntung tu hi,” ci hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian in Noah le a tapate thupha pia in, “Na suan na paalte leitung theampo ah teang tu in ta tam mama nei tavun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nganhing theampo, vacim theampo le ngasa theampo in no hong kiita in nungta tu uh hi. Tuate theampo noma khutnuai ah kikoi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tu in tuate na ne thei tu uh a, ankung hingte zong na ne thei tu uh hi; note an tu in tuate theampo kong pia siat hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na neak ngawl tu khat sia chi om lai sa na ne bua het tu uh hi; banghang ziam cile nuntakna sia chi sungah om ahi hu in neak tu kong khaam hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khat pawpo in mihing nuntakna a thisak le ama daan kipia tu hi. Mihing nuntakna a thisak nganhing sia kithisak tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing sia Pathian taw kibangin kivawt ahikom mihing khat a that pawpo sia ama ii mipuipa in thatlum tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Leitung theampo ah na suan le na paalte a teen thei natu in, ta tam mama na nei tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian in Noah le a tapate tungah,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tu in noma tung le na suan na paalte tung ahizong,
  </para>
  <para style="p">
    <verse number="10" style="v" />note taw teambaw sung pan a pusuak khawm nuntakna a nei theampo — vacim theampo le nganhing theampo taw — thuciamna kong vawt hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Note taw ka vawt thuciamna sia hi kammalte hi: nuntakna nei a minpiang peuma tuipi liimna taw ka mon kik ngei buatu a; tuipi liimin leitung ka lalsak kik ngei buatu hi, ci in kong kamciam hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang le nuntakna nei a minpiangte taw ka vawt a tawntung a kip tu ka thuciamna lim tu in
  </para>
  <para style="p">
    <verse number="13" style="v" />meei sungah ka sangun ka koi tu hi. Tua in leitung taw ka thuciamna lim hi tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Van ah meei ka kaaisak simin le sangun hong kilangh simin,
  </para>
  <para style="p">
    <verse number="15" style="v" />tuipi liimna in nuntakna nei peuma mon kik ngeingawl tu hi ci in, note le nganhing theampo tungah kong kamciamna ka phawk tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Meei sungah sangun a kilangh ciang ka mu tu a, tuaciang keima le leitung ah nuntakna nei a minpiangte kilaklaw ah a kho tawntung thuciamna sia ka phawk tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuasia in nuntakna nei a minpiang theampo tungah kamciam ka piakna lim ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Teambaw sung pan a pusuak Noah tapate sia Shem, Ham le Japheth ahi hi. (Ham sia Canaan ii pa ahi hi.)
  </para>
  <para style="p">
    <verse number="19" style="v" />Hi Noah ii tapa thumte sia simleitung mi theampo ii taanghpupite ahi uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noah sia lothopa khat hi a, sapit ciing masabelpa ahi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in sapittui ne in kham a, a puante suutin a puanbuk sungah a pumnguakin lum hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Canaan ii pa Ham in, a pa a pumnguak a lup a mu ciang, a suapuite nii kungah pai in son hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuasia ciang Shem le Japheth in puantual khat la in amate ii liangko nungsang ah baang uh hi, a nung leelam in puanbuk sungah tum uh a, a pa sia puantual taw siin uh hi. A pa uh a pumnguak a om a mu ngawl natu in amate in a lu heak uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Noah a sapittui kham theau kik a, a tungah a tapa nobel ii a vawtna teng a heak ciang
  </para>
  <para style="p">
    <verse number="25" style="v" />ama in, “Canaan tungah haamsiatna khat tung tahen! Ama sia a suapuite ii sila khat hi tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shem ii Pathian, Topa pok vun! Canaan sia Shem ii sila hi tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathian in Japheth pungsak tahen! A suan a paalte le Shem mite teang khawm tahen! Canaan sia Japheth ii sila hi tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuipi liim zawkciang Noah kum 350 nungta a,
  </para>
  <para style="p">
    <verse number="29" style="v" />kum 950 a phak ciang thi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hite sia Noah ii tapa ahi Shem, Ham le Jepheth te ii suan le paalte ahi hi. Tuipi liim zawkciang hite thum in tapate nei uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Japheth ii tapate — Gomer, Magog, Madai, Javan, Tubal, Meshech le Tiras — sia amate ii min a pu mite ii taanghpupite ahi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gomer ii suan le paalte sia Ashkenaz, Riphath, le Togarmah mite ahi uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Javan suan le paalte sia Elishah, Spain, Cyprus le Rhodes mite ahi uh hi;
  </para>
  <para style="p">
    <verse number="5" style="v" />amate sia tuikulhte tung le tuipi dung a, a teangte ii taanghpupite ahi uh hi. Hite sia Japheth ii suan le paalte hi a, a mihon simin amate kampau tek zangh a, ngam tuatuam ah minam tuam tekin teang uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ham ii tapate — Cush, Egypt, Libya le Canaan — sia amate ii min a pu, mite ii taanghpupite ahi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cush ii suan le paalte sia Seba, Havilah, Sabtah, Raamah le Sabteca mite ahi uh hi. Raamah ii suan le paalte sia Sheba le Dedan mite ahi uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cush in Nimrod a kici tapa khat nei a, leitung ah a masabel a minthang ngalzopa ahi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Topa huna taw savai minthang khat hi a, tua ahi hu in mihingte in “ Topa in nang sia Nimrod bangin savai minthang khat hong suaksak tahen!” ci uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A masa phitin ama ii kumpi ngam sia, Babylon ngam sungah a om Babylon, Erech le Accad ngam thum teng ahi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua ngam panin Assyria ah pai a, Nineveh, Rehoboth Ir, Calah khuapite,
  </para>
  <para style="p">
    <verse number="12" style="v" />tuaciang Nineveh le Calah khuapi lian kilaklaw ah a om, Resen khuapi saat hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Egypt suan le paalte sia Lydia, Anam, Lehab, Naphtuh,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathrus, Casluh mite, tuaciang Philistine te ii pianna Crete mite ahi uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Canaan ii tapate — a ubel Sidon le Heth — sia amate ii min a pu mite ii taanghpupite ahi uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Canaan mite sia Jebus te, Amor te, Girgash te,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiv te, Ark te, Sin te,
  </para>
  <para style="p">
    <verse number="18" style="v" />Arvad te, Zemar te le Hamath te ii taanghpupi zongh ahi hi. Canaan mite kithethaang a,
  </para>
  <para style="p">
    <verse number="19" style="v" />amate ngam sia, Sidon panin thangsang ah Gaza nai Gerar ngam dong hi a, nisuana sang ah Sodom, Gomorrah, Admah, tuaciang Lasha khua nai Zeboiim dong ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hite sia Ham ii suan le paalte hi a, amate kampau tek zanghin ngam tuatuam ah a minam tuam tekin teang uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Japheth ii upa Shem sia Hebrew mi theampo ii taanghpupi ahi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem ii tapate — Elam, Asshur, Arpachshad, Lud le Aram — sia amate ii min a pu mite ii taanghpupite ahi uh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aram suan le paalte sia Uz, Hul, Gether le Meshek mite ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Arpachshad sia Shelah pa hi a, Shelah sia Eber ii pa hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber in tapa nii nei a: khat ii min sia Peleg ci hi, banghang ziam cile ama ii hun sungin leitung mihingte kikhenthaang hi; a khat sia ii min Joktan kici hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joktan suan le paalte sia Almodad, Sheleph, Hazarmaveth, Jerah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadoram, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="28" style="v" />Obal, Abimael, Sheba,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ophir, Havilah le Jobab mite ahi hi. A vekpi in Joktan suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amate teenna ngam sia Mesha pan nisuana sang mualtung ngam Sephar dong kithung hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hite sia Shem ii suan le paalte hi a, amate kampau tek zanghin ngam tuatuam ah a minam tuam tekin teang uh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hi mite theampo sia Noah ii suan le paalte hi a, a khang simna taw kizui in, minam tuam veu suak hi. Leitung minam theampo sia tuipi liim zawkciang Noah tapate ii suan le paalte ahi hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />A masa phitin leitung buppi mihingte in kampau khat bek kinei a kammal kibang zangh uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amate nisuana sangah vak kawkoai a, Babylon ngam zaanglei mun khat a thet ciang tua munah khua saat uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amate khat le khat, “Hong pai tavun! uksuang seakin a sahin hal tawng” kici uh hi. Tua hi a, amate inn sak natu in uksuang te a kimat natu in kattaza zangh uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amate in, “Eite ii min nga thei natu le leitung theampo ah ih kithethaang ngawl natu in khuapi khat saatin van a baan tu tausaang khat ciang to tawng,” ci uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuasia ciang tua mite ii a vawt khuapi le tausaang a en tu in Topa hong paisuk a,
  </para>
  <para style="p">
    <verse number="6" style="v" />ama in, “Tu ciangin, hite sia a vekpi in mihing ci khat sa khat hi a, amate kam nam khat pau hi; a nasep tute a kipatna hi pheang hi. Hai ngawlin a nasep nop pawpo hong seam suak thei tu uh hi!
  </para>
  <para style="p">
    <verse number="7" style="v" />Eite paisuk in khat le khat a kam kitel ngawl natu in a kampau toknoaisak tawng,” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua ahiciang Topa in amate leitung mun theampo ah kithethaangsak hi, tuaciang amate in a khuapi saat tawlnga hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua khuapi sia Babylon ci uh hi, banghang ziam cile Topa in tua munah mihingte theampo ii kampau kitoknoai a, tua mun panin leitung mun theampo ah amate kithethaangsak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hite sia Shem ii suan le paalte hi. Shem kum 100 a phak, tuipi liim zawk kum nii a phak ciangin ama in Arpachshad kici tapa khat nei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua zawk in ama kum 500 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Arpachshad kum 35 a phak ciang, ama in Shelah kici tapa khat nei hi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Tua zawk in, ama kum 403 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shelah kum 30 a phak ciang, ama in Eber kici tapa khat nei hi;
  </para>
  <para style="p">
    <verse number="15" style="v" />tua zawkciang, ama kum 403 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Eber kum 34 a phak ciang, ama in Peleg kici tapa khat nei hi;
  </para>
  <para style="p">
    <verse number="17" style="v" />tua zawk in, ama kum 430 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Peleg kum 30 a phak ciang, ama in Reu kici tapa khat nei hi;
  </para>
  <para style="p">
    <verse number="19" style="v" />tua zawk in, ama kum 209 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Reu kum 32 a phak ciang, ama in Serug kici tapa khat nei hi;
  </para>
  <para style="p">
    <verse number="21" style="v" />tua zawk in, ama kum 207 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Serug kum 30 a phak ciang, ama in Nahor kici tapa khat nei hi;
  </para>
  <para style="p">
    <verse number="23" style="v" />tua zawk in, ama kum 200 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nahor kum 29 a phak ciang, ama in Terah kici tapa khat nei hi;
  </para>
  <para style="p">
    <verse number="25" style="v" />tua zawk in, ama kum 119 nungta lai a, ta dangte zongh nei hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Terah kum 70 a phak zawkciang, ama sia Abram, Nahor le Haran ii pa suak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hite sia Terah ii suan le paalte hi a, Terah sia Abram, Nahor le Haran te ii pa ahi hi. Haran sia Lot ii pa hi a,
  </para>
  <para style="p">
    <verse number="28" style="v" />ama ii pa Terah a nuntak lai in, a suana Babylon ngam Ur khuapi ah Haran thi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abram in Sarai teenpui a, Nahor in Haran ii tanu Milcah teenpui hi. Haran sia Iscah ii pa zongh ahi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sarai in ta nei thei ngawl hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Terah in a tapa Abram, Haran ii tapa ama ii tupa ahi Lot le a tapa Abram ii zi ahi a monu Sarai sam a, amate taw Canaan ngam ah pai tu in Babylon ngam Ur khuapi nusia uh hi. Amate Haran dong pai in tua munah teang uh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Terah kum 205 a phak ciang tua munah thi hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian in Abram tungah, “Na ngam, na bee le phungte le na pa inn nusia in a, kong lak natu ngam ah pai in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Suan le paal tam mama kong pia tu a, amate minam lian khat suak tu uh hi. Nang sia thupha naak na hi natu in, thupha kong pia tu a, na min kong thangsak tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma thupha hong piate thupha ka pia tu a, Ahihang nangma hong haamsiatte ka haamsiat tu hi. Nang tungtawnin minam theampo thupha ka pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abram kum sawmsali le kum nga a phak ciang Topa ci bangin Haran pan dingkhia hi; tuaciang Lot in zui hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram in a zi Sarai, a naupa ii tapa Lot, amate nei le lamh theampo le Haran pan a nga sila theampo Canaan ngam zotpui hi. Amate Canaan ngam a thet ciang
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram sia tua ngam kaantan in Shechem khua ah om mun thiangtho ahi Moreh ii thingkung thiangtho a thet dong paisuak hi. (Tua hun in Canaan te tua ngam ah teang lai hi.)
  </para>
  <para style="p">
    <verse number="7" style="v" />Abram kungah Topa kilangh a, “Na suan le na paalte tungah hi ngam ka pia tu hi,” ci hi. Tua zawkciang Abram in, ama ii kungah a kilangh Topa atu in biaknatau khat vawt hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua zawkciang Abram sia thangsang Bethel khuapi ii nisuana sang mualtung ngam ah kikhiin in nitumna sangah Bethel, nisuana sangah Ai khuate kilaklaw ah a ngiaphual saat hi. Tua mun zongh ah ama in biaknatau khat vawtin Topa bia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua zawkciang ama mun khat pan mun khat kikhiin in Canaan ngam thangsang ah pai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihang Canaan ngam sungah kialpi tung a, tua kialpi nasia ahikom tawmvei sung a teang tu in thangsang a om Egypt ah Abram paisuk lai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Egypt ngamsung tum tu in ngamngi a kan dek ciang a zi Sarai tungah, “Nang sia numei mealpha khat na hi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Egypt te in nang hong mu ciang nang sia keima zi hi hong ci tu uh a, amate in keima hong thatin nang hong nungtasak tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate tungah a suapuinu khi hi na ci in; tuasia ciang nang hangin kei ka suakta tu a, pha takin hong vawt tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama ngamngi kaanin Egypt ngam a tum ciang Egypt te in a zi mealphat hunlam mu uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zum uliante pawlkhat in ama a mu ciang a mealphatna kumpipa tungah son hi; tua ahikom kumpi inn sungah kipaipui hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua nu hangin kumpipa in Abram phat vawt a, ama ii tungah tuu, keal, khui, laa, silate le kalaohte a hon a hon in pia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahizong kumpipa in Sarai a laak hu in Topa in ama le a kumpi inn sungah a teang mite tungah natna ngilote tungsak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuasia ciang kumpipa in Abram sam a, “Banghangin hi bang hong vawt thong ni ziam? Ama na zi ahi sia banghang hong son ngawl ni ziam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Banghangin na suapuinu hi ci a, ama ka zi tu in ka laak tu hong oai ni ziam? Hi sungah na zi om hi; ama la in a, pusuak vun!” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kumpipa in a mite thupia a, amate in Abram sia a zi le a neisa theampo taw a ngam pua sangah pusuaksak uh hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram sia a zi, a neisa theampo le Lot taw Egypt panin saksang zuanin Canaan thangsang mun khat ah pai hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abram sia a hau mama khat hi a, tuute, kealte le khuite bek dom ngawlin khamh le ngunn zongh nei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tua zawkciang tua mun nusia in mun khat pan mun khat ah kikhiin in Bethel sang zuan hi. Bethel le ama ii ngiaphual a saat maksakna, biaknatau khat a sak ngeina mun Ai kilaklaw ah ama theng hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua munah ama in Topa bia hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lot zongh in tuute, kealte le khuite a nei bek dom ngawlin innkuanpui le naseamte zongh nei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua hi a, ngan tha natu mun kicing ngawl ahikom mun khat ah a nii in teenkhop tu suak thei ngawl hi, banghang ziam cile amate in nganno hau mama uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua hikom Abram ii ngancingte le Lot ii ngancingte kilaklaw ah kihauna piang hi. (Tua hunin Canaan te le Periz te tua ngam ah teang lai uh hi.)
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuasia ciang Abram in Lot tungah, “Eite sia mealheak khat ih hikom, na mite le ka mite a kihau tute hi ngawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua ahikom kikhen zaw heu tawng. Na deina ngam pawpo teal in. Nang mun khat sang na zuan le kei mundang khat ka zuan tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuaciang Lot khuadak a, Topa ii Huan ahibuale Egypt ngam taw a kibang Jordan kuam buppi le Zoar sang theampo, tui tam mama a omna mun teng mu hi. (Tua hun sia Sodom le Gomorrah khuapite Topa ii a lalsak ma ahi hi.)
  </para>
  <para style="p">
    <verse number="11" style="v" />Lot in Jordan kuam buppi ama atu in teal a, nisuana sangah kikhiin hi. Tuabangin amate nii kikhen hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram sia Canaan ngam ah teang a, Lot sia tua ngam kuam sung khuapite sungah teangin, Sodom khua hui ah ngiaphual saat hi,
  </para>
  <para style="p">
    <verse number="13" style="v" />Sodom mite sia seksol a, Topa tungah nasia takin a maw a khialte ahi uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lot ii a nusiat zawkciang Abram tungah Topa in, “Na omna mun panin mun theampo pha tak en in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na muna ngam theampo nang le na suan na paalte tungah kong pia tu a, a tawntungin noma aa hi tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Suan le paal tam mama kong pia tu a, kuama in sim siat zo ngawl tu hi; tua sia sim tu sia leitung ah leivui theampo sim siat tu ol zaw tu hi!
  </para>
  <para style="p">
    <verse number="17" style="v" />Tu in, pai ta'n a, ngam buppi va en ta'n, banghang ziam cile a vekpi nang tungah kong pia siat tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua ahikom Abram in a ngiaphual khiinin, Hebron ngamsung Mamre thingkung thiangthote kungah teang a, tua munah Topa atu in biaknatau khat sa hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babylon kumpipa Amraphel, Ellasar kumpipa Arioch, Elam kumpipa Chedorlaomer le Goiim kumpipa Tidal, hi kumpi lite in
  </para>
  <para style="p">
    <verse number="2" style="v" />a dang kumpi ngate: Sodom kumpipa Bera, Gomorrah kumpipa Birsha, Admah kumpipa Shinab, Zeboiim kumpipa Shemeber le Bela ahibuale Zoar kumpipa te sim uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hi kumpi ngate in kipawlna vawtin tu in Tuipi Thi a kici Siddim Kuam ah a ngalkapte ngawmtua uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amate kum sawm le kum nii sung Chedorlaomer khutnuai ah om uh a, ahizong kum sawm le kum thum kum ciang amate in ama leedo kik uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A kum sawm le li kum ciangin Chedorlaomer le ama taw a kipawl kumpite in a ngalkaphonpite taw sim kik a, Ashteroth Karnaim ah Rephaim, Ham ah Zuzim, Kiriathaim zaanglei ah Emim
  </para>
  <para style="p">
    <verse number="6" style="v" />le Edom mualte tungah Hor te zo in, sennealngam mong ah a om Elparan ciang dong del uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua zawkciang amate kiheak a Kadesh (tua hun in Enmishpat kici) ah pai kik hi. Amalek te ngam theampo le Hazazon Tamar ah a teang Amor te zo uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaciang Sodom, Gomorrah, Admah, Zeboiim le Bela kumpi ngate in, a ngalkaphonpi nei teng ngalsim tu in kaikhawm a,
  </para>
  <para style="p">
    <verse number="9" style="v" />kumpi nga teng in Elam, Goiim, Babylon le Ellasar kumpi lite taw Siddim Kuam ah kido uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua kuam sia kattaza dumte taw kidim a, Sodom le Gomorrah kumpite ngal kisimna pan a tai uh ciangin tua dumte sungah taakin, a dang kumpi thum teng sia mual tungah suakta uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kumpi lite in Sodom le Gomorrah ah omna theampo, a an teng zongh la in paipui uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sodom ah Abram suapuipa ii tapa Lot teang ahikom amate in a neisa teng taw paipui uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahizong ngalte khut sung pan a suakta khat in Hebrew mi Abram kungah pai in hi thu theampo son hi, Abram sia Amor mi Mamre ii neisa thingkung thiangthote kungah teang hi. Mamre le a suapuipate Eshcol le Aner sia Abram kipawlpui te ahi uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abram in a suapuipa tapa a kimatna thu a zaak ciang, ngalsim tu ngalkap 318 teng a ngiaphual ah kaikhawmin, tua kumpi li te Dan ciang dong del uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua munah a mite a pawlin khen a, zan in ngal a sim ciang zo uh hi. A ngalte sia Damascus saksang Hobah ciang dong del uh a,
  </para>
  <para style="p">
    <verse number="16" style="v" />tuaciang a kisuttol vanh teng nga kik hi. Ama in a suapuipa tapa Lot le a neisa teng, numeite le thongtaak dang teng zongh ciapui kik siat hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abram in kumpipa Chedorlaomer le kumpi dangte a zawna pan a cia kik ciang, Sodom kumpipa in Shaveh Kuam (Kumpipa Kuam zong kici) ah ama taw kisi tu in pai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuaciang Saangbel Pathian ii thiampi zongh ahi, Salem kumpipa Melchizedek in zongh anluum le sapittui Abram kungah puak a,
  </para>
  <para style="p">
    <verse number="19" style="v" />ama in “Vantung le leitung a vawt Saangbel Pathian in Abram thupha pia tahen!
  </para>
  <para style="p">
    <verse number="20" style="v" />Na ngalte hong zosak Saangbel Pathian sia kipok tahen!” ci in Abraham thupha pia hi. Tuaciang Abram in a kisuttol a nga kik vanh theampo sung pan sawm a khat Melchizedek tungah pia hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sodom kumpipa in Abram tungah, “Sutol vanh teng tang in a, ahizong ka mi teng hong pia kik ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abram in, “Vantung le leitung Vawtpa, Saangbel Pathian, Topa mai ah
  </para>
  <para style="p">
    <verse number="23" style="v" />khauzam khat ahizong, peangdap khau ngawngawn ahizong, na neisa bangma ka la buatu hi, ci in ciliapna taw ka kiciam hi. Tuasia ahibuale nangma in, ‘Abram a hausak pa keima khi hi,’ ci tha tu ni hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka mite ii zak sa teng ngawl buang keima tan tu in bangma ka la buatu hi. Ahizong keima hong panpui Aner, Eshcol le Mamre te in amate tel tu teng la tahen” ci in zo hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hi teng zawkciang Abram in mukholna nei a, Topa in, “Abram awng, lau heak in, Keima in lauhuaina panin nang kong dal tu a, thaman lian khat kong pia tu hi,” a cisia za hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahizong Abram in, “Vaanglianpipa Topa awng, ta nei ngawl ka hi ciang nong piak tu thaman sia kei atu in bang phatuam tu ziam? Ka innlua tu pa sia Damascus khua mi Eliezer bekma ahi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ta hong pia ngawl na hi ciang ka sila khat in ka neisa teng lua tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuasia ciang Topa in ama paupui kik a: “Hi sila, Eliezar in na neisate lua ngawl tu a; nangma tapa tatak ma na innlua hi tu hi,” a cisia za hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Topa in ama doipua sangah pusuapui a, “Van en in a, aksite sim sin in; tuaza a tam suan le paal na nei tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram in Topa pummuan a, hisia hangin Topa lungkim in ama saang hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuaciang Topa in ama tungah, “Hi ngam teng nangma hong pia tu in, Babylon ngam Ur khua pan hong masuanpa sia Keima Topa ka hi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahizong Abram in, “Vaanglianpipa Topa awng, tua ngam teng kei atu ahi sia bangbangin he thei tu khi ziam?,” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Topa in “Kum thum a pha khuipui khat, kum thum a pha keal khat, kum thum a pha tuutal khat, tuaciang inn vakhu khat le ngam vakhu khat hong paipui ta'n,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abram in hi nganno teng Pathian kungah paipui a, phel nii veu sua a phel khat teng le phel dang khat teng ngual nii a kinungngat in koisak hi; ahizong vacimte pheltham ngawl hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua saluangte tungah vaciikte tuaksuk hi, ahizong Abram in bengkeak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni tum ciang Abram mutthip a, ama tungah launa le patauna theng hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Topa in ama tungah, “Na suan na paalte ngamdang ah khualmi suak tu hi; amate sia tua munah kum zali sung sila kaai in kivawtsia tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahizong amate sila in a khoai minam sia daan ka pia tu a, tua ngamdang a nusiat ciang nei le lam tam mama hong ciapui tu uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma na hile kicing takin huaikut teakkut in na nungta tu a, nuam takin thi in, hong kivui tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khang li zawkciang na suan na paalte hi ngam ah hong cia kik tu hi, banghang ziam cile hi sungah Amor te sia hong seksol mama tu a, daan a kipiak mateng hi mun pan ka notkeak buatu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ni tumin khua a zin ciang meikhu a suak meibeal le meisip kuang sia thakhat thu in kilangh a, nganhing sabekte kilaklaw kaantan hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuasia ciang tua munah Topa in Abram taw thuciamna khat vawt hi. Ama in, “Na suan na paalte tungah Egypt ngamngi pan Euphrates ngun dong,
  </para>
  <para style="p">
    <verse number="19" style="v" />tua ngamte sungah Ken te ngam, Keniz te ngam, Kadmon te ngam,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hit te ngam, Periz te ngam, Rephaim te ngam,
  </para>
  <para style="p">
    <verse number="21" style="v" />Amor te ngam, Canaan te ngam, Girgash te ngam le Jebus te ngam teng a kihel hi leitang theampo piak tu kong kamciam hi,” ci hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram zi Sarai in ta khat zongh nei ngawl hi. Ahizong ama in Egypt te Hagar a kici sila numei khat nei hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />tua ahiciang Sarai in Abram tungah, “ Topa in keima ta hong neisak ngawl hi. Ka silanu taw banghang lumkhawm ngawl tu ni ziam? Ama in kei atu in ta khat hong neisak thei tha tu hi,” ci hi. Abram sia Sarai ii ci bang thukim hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tua ahiciang Sarai in Hagar sia Abram tungah a zino tu in pia hi. (Canaan ngam ah Abram kum 10 a teen zawkciang hi thu piang hi,)
  </para>
  <para style="p">
    <verse number="4" style="v" />Abram in Hagar ompui a, ama naungil om hi. Ama in a ngai hunlam a heak ciang, hong kiphasak a, Sarai zawngsak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuaciang Sarai in Abram tungah, “Hagar ii hong zawnsakna sia nangma khialna hang hi. Keima mama in nangma tungah ama kong pia a, ama in a ngai hunlam a heak pan kipan, kei hong zawngsak hi. Topa in nang ahibuale kei, akua a maan ci sia thu hong khen tahen,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram in, “Pha mama hi, ama sia na sila nu hi a, nangma khutnuai ah om hi; na uuk bang po vawt in,” ci in zo hi. Tua zawkciang Sarai in Hagar vawtsia mama ahikom Hagar tai hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Topa vantunglalang sia Shur paina lampi senneal ngamsung ciktui khat ah Hagar taw kisi a,
  </para>
  <para style="p">
    <verse number="8" style="v" />ama in, “Sarai sila nu Hagar awng, koisung pan hong pai a, koisung zot sawm ni ziam?” ci hi. Ama in, “Ka tonu kung pan a tai ka hi hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vantunglalang in, “Na tonu kungah cia kik ta'n a, ama sila ma in om ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua zawkciang ama in, “Suan le paal tam mama kong pia tu a, kuama in sim zo ngawl tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tapa khat na nei tu a, a min Ishmael na phuak tu hi, banghang ziam cile thinngim in na kaana Topa in za zo hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahizong na tapa sia ngamlaa khat taw kibang tu hi, ama in mihingte theampo langpan in, mihingte theampo in zongh, ama langpan tu hi. A mealheakte theampo om ngawlna ah ama teang tu hi, ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuaciang Hagar in, “Pathian a mu tatak khi ziam, tua thu son tu in nungta lai khi ziam?,” ci in ama le ama kidongh hi. Tua ahikom ama a paupui Topa sia, “Hong Mu Pathian khat” ci hi
  </para>
  <para style="p">
    <verse number="14" style="v" />Tua ahi hu in mite in Kadesh le Bered kilaklaw ah tuikhuk sia, “A Nungta Hong Mu Pa ii Tuikhuk, ‘Beer Lahai Roi’ ” ci uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hagar in Abram taw tapa khat nei a, Abram in a min Ishmael, phuak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua hun in, Abram sia kum sawmliat le kum luk pha hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram kum sawmkua le kum kua a phak ciang ama tungah Topa kilangh a, “Keima in Vaanglianbelpa Pathian ka hi hi. Ka thu hong ni ta'n a, a maan in seam tawntung in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma taw ka thuciamna ka vawt tu a, suan le paal tam tatak kong pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram sia a maitang lei a phak dong kunsuk a, Pathian in,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Nang taw hi thuciamna ka vawt hi: nang in minam tam mama te ii taanghpupi na hi tu hi ci in kong kamciam hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na min, Abram hi nawn ngawl tu a, Abraham kici zaw tu hi; banghang ziam cile minam tamte ii taanghpupi tu in kong siam zo hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima in suan le paal tam mama kong pia tu a, kimkhatte kumpi suak tu hi. Nangma in suan le paal tam mama na nei tu a, amate sia minamte suak tu uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ka kamciam ka kipsak tu a, nangma le na suan na paal khangkikte tungah, tawntung thuciamna hi tu hi. Keima in na Pathian ka hi tu a, na suan na paalte ii Pathian ka hi tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tu in ngamdangmi khat bangin na omna hi leitang sia nangma le na suan na paalte tungah kong pia tu hi. Canaan ngam bup sia na suan na paalte in a tawntungin lua tu a, keima in amate ii Pathian ka hi tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in Abraham tungah, “Nangma le na suan na paal khangkikte in keima taw ih thuciamna sia a zui tu in nangma zongh na thukim kul hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma le na suan na paalte theampo in no sung pan pa a minpiang ii vunteap at tu na thukim uh kul hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tu pan kipan note sung pan a sua zawk ni liat a pha pano peuma, vunteap ki at tu a, na inn sungsuak silate le ngamdang pan na lei silate zongh kihel tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Note vunteap ki atna in, no le kei kilaklaw a thuciamna khat a om hunlam lak tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A mi simin vunteap ki at nanak tu hi, hisia in note taw ka thuciamna kip tawntung hi ci in a lak tu na pumpi tungah limlakna khat hi tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pasal a minpiang vunteap a ki at ngawl peuma keima mi khatin kingaisun nawn ngawl tu hi, banghang ziam cile keima taw ka thuciamna ama in paltan hi,” ci hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian in Abraham tungah, “Na zi sia Sarai na ci nawn bua het tu hi; tu pan kipan ama min Sarah hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama thupha ka pia tu a, ama taw tapa khat kong pia tu hi. Ama thupha ka pia tu a, ama in minamte ii nu hi tu hi, tuaciang ama suan le paal sung pan kumpite piang tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham sia a maitang lei a phak dong kunsuk a, ahizong hi bang thu teng a ngaisut ciang a nuiza hi; a thinsung ah, “Kum zakhat a pha pasal khat in ta khat nei thei tu ziam? Kum sawmkua a pha Sarah in ta khat nei thei tu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in Pathian tungah, “Banghangin, Ishmael sia ka inn lua tu suaksak ngawl tu ni ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahizong Pathian in, “Hi ngawl hi, na zi Sarah in nang atu in tapa khat hong nei tu a, a min Isaac na phuak tu hi. Ama tung ahizong a suan a paalte tung ahizong ka thuciamna sia a tawntungin ka kholet tu hi. Tua in a tawntung a kip thuciamna khat ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ishmael huvau nong ngetna ka za zo hi, tua ahiciang ama thupha ka pia tu a, ta tam mama, suan le paal tam mama ka pia tu hi. Ama in kumpi sawm le nii te ii pa hi tu a, a suan a paalte sia minam lian khatin ka siam tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahizong mai kum tu hun khawng ciangin Sarah sung pan hong suak tu na tapa Isaac taw ka thuciamna ka kholet tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abraham tungah a thuson tu teng a man ciang, Pathian in ama nusia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tua ni mama in, Abraham in Pathian thu ni a, ama tapa Ishmael, a inn sungsuak pasal dang theampo, a inn sungsuak silate le a lei silate zongh vunteap atsak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham vunteap a ki at lai in kum sawmkua le kum kua pha a,
  </para>
  <para style="p">
    <verse number="25" style="v" />a tapa Ishmael kum sawm le kum thum pha hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ni khat sungin, amate nii sia
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham ii silate theampo taw vunteap at khawm uh hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Topa sia Mamre thingkung thiangthote kungah a om Abraham tungah kilangh hi. Abraham sia a puanbuk kongbiang ah sun nisatbel laitakin to hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />ama khua a etto le tuak san ah mihing thum a ding mu hi. Ama in amate a mu po ciang kimu tu in tai hi. A maitang lei a phak dong kunsuk in,
  </para>
  <para style="p">
    <verse number="3" style="v" />ama in, “Syate awng, nong hesuakna in hong baang ngawlin ka inn hong kaantan heak vun; hi sungah note leangna hong do tu in om khi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na peang sil natu tui kong toai tu a; hi thingkung nuai ah na tawlnga tu uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />An tawm kong pia tu a, tua an in na khualhawna ah hong thahatsak tu hi. Vaang nong piakna taw ka inn hong zuan zo na hi uh ciang, zin hong dosak tavun,” ci hi. Amate in, “Lungdam ung; hong saang khu hi,” ci in zo kik uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham a puanbuk sungah tai in Sarah tungah, “Na anvui a pha belte ip khat la in anluum in em paih in” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua zawkciang ama in a nganhon omna ah tai in khuino thau a limcibel khat tealin, a naseampa tungah aap a, neak thei tu in vawtsak memeang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama in amate mai ah khuinoai diat, khuinoai, khuisa le an hong lui hi. Ama mama in tualai thingkung nuai ah leangna do in an nesak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua zawkciang leangnate in ama tungah, “Na zi Sarah koisung om ziam?” ci in dongh hi. Ama in, “Puanbuk sungah ama om hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amate khat in, “Tu zo tha kua ciang kong pai kik tu a, na zi Sarah in tapa khat nei tu hi,” ci hi. Sarah in a pasal nungsang puanbuk kongkha pan ngai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham le Sarah sia huai mama zo a, Sarah sia a tha sim numei ngeina kang zo hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua ahikom Sarah ama nguakin nui a, “Tu in kei sia ka kum tamin huai zo a, numei le pa nopsakna nei thei lai tu khi ziam? Ka pasal zongh le huai zo si hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuasia ciang Topa in Abraham tungah, “Banghang Sarah nui a, ‘Ka kum a haam mama zawkciang ta nei thei takpi lai tu khi ziam?’ banghang ci ziam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Na khat pawpo Topa atu in a haksa leilam om na ziam? Kong ci sa bangin tu zo tha kua ciang kong pai kik tu a, Sarah in tapa khat nei tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sarah lau ahikom, tuasia nial hi. Ama in, “Kei ka nui bua hi” ci hi. Ama in, “Ahi ma hi, nui ni hi” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua zawkciang leangnate in nusia a Sodom khua a etsuk thei natu munah pai uh hi, Abraham in amate tha hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuaciang Topa in, “Ka hi tu thu teng Abraham tungah ka iim buatu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama ii suan le paalte minam lian khat le a thahat minam khat suak tu a, ama tungtawnin minam theampo thupha ka pia tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A tapate le a suan a paalte tungah ka thu ni a, thumaan thutang a vawt natu, thu a piak natu in ama ka teal zo hi. Tuabang a vawt uh le ka kamciamsa bangin ama ta tu ka hisak siat tu hi,” ama le ama kici hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuasia ciang Topa in Abraham tungah, “Sodom le Gomorrah a kimawsiatna, nasia mama a, a mawna uh lian mama hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A kimawsiatna ka zaak teng maan ziam maan ngawl ziam kantel tu in ka paisuk kul tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua zawkciang Abraham ii leangnate nii sia Sodom sangah pai a, ahizong Topa sia Abraham taw taanglai hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abraham in Topa neak a, “A mawbaang ngawlte a mawte taw susia khawm takpi tu ni ziam?
  </para>
  <para style="p">
    <verse number="24" style="v" />Sodom khuapi sungah mawbaang ngawl mihing sawmnga om le khuapi bup lalsak tu ni ziam? Tua sawmnga te huu tu in tua khuapi khoaikhe ngawl tu ni ziam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Mawbaang ngawlte a mawte taw thatlum khawm ngeingawl het tu ni hi. Tuasia suak thei ngawl hi! Tuabang vawt thei ngawl tu ni hi. Tuabang vawt thong lete a mawte bangma in a mawbaang ngawlte zongh daan thuak tu hi thong hi. Hi thei ngawl tu hi. Leitung theampo ii thukhenpa in thu a maan in a khen kul tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Topa in, “Sodom khuapi sungah a mawbaang ngawl mihing sawmnga mu leng, amate hangin khuapi bup ka khoaikhe tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham in, “ Topa awng, hi bangin hangsan takin kong ci kik sia nong hesuakna in hong maisak ta'n. Kei mihing khat hi lel a, nang tungah thu khat pawpo son natu thu ka nei bua hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahihang a mawbaang ngawl mihing sawmnga om zo ngawlin sawmli le nga bek om thei tha tu hi. Mihing nga a kisapna hangin khuapi bup na lalsak veve tu ziam?” ci kik hi. Topa in mimaw ngawl sawmli le nga mu leng tua khuapi ka lalcipsak buatu hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abraham in, “Sawmli bek om le eh!” ci kik hi. Topa in sawmli om le ka lalsak buatu hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Abraham in, “ Topa awng, nong hesuakna in na thin uuk heak in a, thu khat kong dongh lai tu hi. Sawmthum bek om le bangbang ahi tu ziam?” ci hi. Ama in, “Sawmthum ka mu le ka lalsak buatu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Abraham in, “ Topa awng, nong hesuakna in nang tungah kong ci ngam lalai na hong maisak ta'n. Kul bek kimu luilam le eh!” ci hi. Ama in, “Kul ka mu le khuapi ka lalsak buatu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abraham in, “ Topa awng, nong hesuakna in thin uuk heak in a, khatvei bek hong pausak lai ta'n. Sawm bek kimu le eh?” ci hi. Ama in, “Sawm a om le ka lalsak buatu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham taw a thu son tu teng a man zawkciang, Topa paisuak a, Abraham sia inn ah cia kik hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vantunglalangte nii Sodom a thet nitakin khuapi kongpi ah Lot to hi. Lot in, amate a mu po ciang dingin muak hi. Amate mai ah Lot kunin,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Syate awng note leangna hong do tu in kei hi sungah ka om hi. Nong hesuakna in, ka inn ah hong tung tavun. Na peang uh sil in zan hong ngiak thei tu nu hi. Zingsang ciang tho palin na pai natu uh na pai suak thei tu uh hi,” ci hi. Ahizong amate in, “Hi ngawl hi, khuapi khawlmun ah tu zan ka taam tu uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lot in amate kunh top ahikom a khakbel ciang a inn ah zui uh hi. Lot in a naseamte anluum pawlkhat emsak in a zinte anlim vaak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A zinte a lup ma in Sodom te in a inn kiim uum uh hi. Tua munah khuapi sung pan a moi a haam pasal theampo hong pai hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amate in Lot sam a, “Tu nitak na inn ah a taam tu in hong tung pasalte koisungah om ziam? Ko kungah hong pusuaksak ta'n” ci uh hi. Sodom pasalte in amate khialpui nuam hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lot pusuak in innkha kha san hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lot in amate tungah, “Lawmte awng, hong thuum khi hi, hi bang a seksol in ngamta heak vun!
  </para>
  <para style="p">
    <verse number="8" style="v" />En vun, ngaknu thiangtho ta numei nii ka nei hi. Note kungah amate kong paipui tu a, na uuk babang vawt thei tu nu hi. Ahizong hi mite bangma lawsak heak vun; keima zinte ahikom ka huuk kul hi,” ci hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahihang amate in, “Nang ngamdangmi awng, hong pial ta'n! Ko, bang seam tu ci hong sawl sia akua ni ziam? Hong pial ta'n, tua ahibuale amate tung ka vawt tu uh sangin a sia zaw in nang kong vawt tu uh hi,” ci uh hi. Amate in Lot a nungsangah sawnin, innkha sutham tu in pai uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahizong inn sung a om a zinte nii hong thengin amate omna inn sungah Lot kai a, innkha khak uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuaciang amate in innkha a mu thei ngawl natu in innpua sangah a om mi theampo a mit uh tawsak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua pasalte nii in Lot tungah, “Hi sungah a dangkhat pawpo — tapate, tanute, maakte — ahibuale khuapi sungah a teang mealheak dangte na nei lai le hi mun panin pusua pui in;
  </para>
  <para style="p">
    <verse number="13" style="v" />banghang ziam cile hi mun lalcipsak tu khu hi. Topa in hi mihingte a kimawsakna thute za zo ahikom Sodom khua lalcipsak tu in ko hong puak hi,” ci in son hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuaciang Lot va pai in a tanute ii a teenpui tu pasal, a maak tute tungah, “Manlang in hi mun pan pai vun; Topa in hi mun lalcipsak tu hi,” ci hi. Ahihang amate in ama ciammui thu son in ngaisun uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zingsang khuavak ciang a manlan natu in vantunglalangte in Lot thawn hi. Amate in “Manlang in khuapi a kilalcipsak ciang na suatak thei natu in, na zi le na ta numeite nii taw tai tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lot sia a thinkaa in om lai hi. Bangbang hikale Topa in ama hesuak hi; tua ahikom tua pasalte in ama, a zi le a tanute nii a khut lenin khuapi pua sangah masuan hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua zawkciang vantunglalang khat in, “Na nuntak natu in tai vun! Nungsang en kik heak vun a, munkuam ah tawlnga heak vun. Hong kithalup ngawl natu in mualte sangah tai tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahizong Lot in, “Hi ngawl hi, syapa awng, tuabangin hong ngamtasak heak in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangma in maipha nong pia zo a, ka nuntakna nong hun zo hi. Ahizong mualte khuala leih hi; lalna siatna in kei hong pha tu a, tua mun ka thet ma ka thi tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngalkhat ah khuano sia na mu ziam? Tua khua sia nai lel hi. Tualai ah hong paisak tan — tua mun sia khuano khat ahi sia na mu thei hi — tua hile ngammuang tu khi hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in, “Pha hi, na ci bangin ka thukim hi. Tua khua ka lalsak buatu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Manlang in! Tai in! Tua khua na thet mateng bangma ka vawt thei buatu hi,” ci in zo hi. Banghang ziam cile Lot in tua khua sia, no hi ci ahikom, a min Zoar kici hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zoar ah Lot a thet ciangin ni suak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Topa in thakhat thu in Sodom le Gomorrah khuapite tungah kaan meikuang zusak a,
  </para>
  <para style="p">
    <verse number="25" style="v" />tuaciang tua khuapite le a ngamkuam bup laltham in, tua munah a teang mihingte theampo le leitung ah a po theampo mon siat hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahizong Lot ii zi sia nungsang en kik ahikom cikhuam khat suak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A zing ciang zingtuung in Abraham sia Topa taw a kisik ngeina a dinna munah manlang takin pai hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama in Sodom le Gomorrah le a ngamkuam bup ensuk a, meiphualpi khat pan meikhu suak taw a kibang, lei pan meikhu a suakto mu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahizong Pathian in Lot ii teenna ngamkuam ii khuapite a lalcipsak ciangin a thinsung ah Abraham mangil ngawl ahikom Lot sia suaktasak hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lot in Zoar khua ah teen tu lauhuai sa ahikom a tanute nii taw mualte kawm ah kikhiinto in suanghawng khat sungah teang uh hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A unu in a nau tungah, “Ih pa huai zo a, ta ih nei thei natu in leitung bup ah ei hong teenpui tu pasal om ngawl hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hong pai ta'n, ih pa taw lumkhawmin ta hong neipui natu in ih pa sapittui khamsak tawng,” ci hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tua zanin amate in a pa sapittui pia a, a tanu uzaw taw lumin omkhawm hi. Ahizong a pa in sapittui kham leih ahikom a omkhop hunlam he ngawl hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />A zing ciang a unu in a suapuinu tungah, “Zeini zan in ama taw ka lumkhawm hi; tu nitak zong sapittui ih khamsak kik tu a, nangma taw na lumkhawm tu hi. Tuasia ciang ih unau in ih pa taw ta khat veve ih nei tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tua hi a, tua zanin, a pa sapittui khamsakin, a naunu le a pa lumin khial hi. A pa sapittui kham leih kik ahikom tuasia hunlam he ngawl hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuabangin Lot ii ta numeite ngeal sia a pa taw naupaai uh hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A tanu uzaw in tapa khat nei a, Moab ci in minphuak hi. Ama in tu hun a, Moab te ii pianna taanghpupi ahi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />A tanu nozaw zongh in tapa khat nei a, Benammi ci in min phuak hi. Ama in tu hun a Ammon te pianna taanghpupi ahi hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mamre pan Canaan thangsang ah Abraham kikhiin suk a, Kadesh le Shur kilaklaw ah teang hi. Tua zawk Gerar ah a teen lai in,
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham in a zi Sarah sia ka suapuinu hi, ci hi. Tua hu in Gerar kumpipa Abimelech in a zi tu in la hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zan khat Abimelech ii mang sungah Pathian kilangh a: “Hi numei na laak hu in, nang na thi tu hi, banghang ziam cile ama in pasal neisa ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahizong Abimelech in Sarah nai neak ngawl hi, tuaciang ama in, “ Topa awng, kei mawbaang ngawl khi hi. Kei le ka mite hong that tu ni ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham ama mama in ka suapuinu hi hong ci a, Sarah in tuabang ma hong ci hi. Tua ahikom kithasunna nei ngawlin ngamta ka hi a, ka khial bua hi,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in a mang sungah, “Hi hi, kithasunna nei ngawlin na ngamtatna thu kong he a; tua ahikom kei tungah nong maw ngawl natu in kong keam a, ama kong thuthasak bua hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahihang tu in, numeinu sia a pasal aap kik in. A pasal sia kamsaang khat hi a, na thi ngawl natu in thu hong ngetsak tu hi. A zi na pia kik bua ahile nangma a kipan na mite theampo na thi siat natu thu kong telkholsak hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zing ciang zingsang tuungin Abimelech in a uliante samin, thupiang teng son a, amate lau mama uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua zawkciang Abimelech in Abraham samin, “Kote tungah bang teng hong vawt ni ziam? Kei le ka kumpi ngam sungah hi siatna nong tunsak natu in nang tungah bang khialna hong vawt khi ziam? Kei tungah nong vawt bangin kuama in hong vawt ngeingawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Banghangin hi bang hong vawt ni ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham in, “Hi sungah Pathian a thasia khat zongh om ngawl tu ahikom ka zi a dei manin kei hong thatlum tu hi, ci in ka ngaisun hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama sia ka suapuinu tatak hi; pa khat ii ta ka hi uh a, ka nu uh kibang ngawl ahikom ka teenpui hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian in ka pa inn pan ngamdang ah hong pusuaksak ahiciangin Sarah tungah, ‘Kei sia mi theampo tungah ka suapuipa hi nong cina taw kei tungah na thumaanna nong lak thei tu hi,’ ka ci sa hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuaciang Abimelech in Abraham tungah Sarah aap kik a, tuu, khui le silate taw zong pia khawm hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama in Abraham tungah, “Hi ngam bup keima aa hi; na ukna po ah teang in,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama in Sarah tungah, “Na suapuipa tungah ngunntang tulkhat ka pia hi; nang taw a om mi theampo mai ah mawbaang ngawl na hina, a kilak natu hi a; khialna bangma vawt ngawl hi, ci in a kuama po in hong he tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham ii zi Sarah tungah tubang teng a pian hu in, Topa in Abimelech inn sung a om numei theampo, ta a nei thei ngawl tu in vawt hi. Tua ahiciang Abraham in Abimelech atu thu ngetsakin, Pathian in ama damsak hi. Amate in hin le toaite a nei thei natu in a zi le a sila numeite zongh damsak siat hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />A kamciamsa bangin Topa in Sarah thupha pia hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />tuaciang Sarah naupaai in Abraham huai zawkciang ama atu tapa khat nei hi. Tua tapano sia Pathian in ama piang tu a ci hun ma in suak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham in a tapa min Isaac phuak hi,
  </para>
  <para style="p">
    <verse number="4" style="v" />tuaciang Pathian thupiak bangin Isaac ni liat a phak ciang Abraham in a vunteap atsak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isaac a sua in Abraham kum zakhat pha hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sarah in, “Pathian in lungnopna le nuina hong pia zo hi. Hi thu a za peuma in hong nuipui tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua zawkciang, “Sarah in patangte noaitui taw vaakin a omh tu hi, ci in akua in Abraham tungah son ngei natu ziam? Ahizong a huai ciang ama atu in tapa khat ka nei zo hi,” Sarah in ci thua hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nauno hong khang a, noai a kitensak ni in Abraham in anneakpoai lian khat vawt hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ni khat ni in, Egypt mi Hagar ii Abraham atu a nei a tapa Ishmael le Sarah tapa Isaac kimai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sarah in amate a mu ciang Abraham tungah, “Hi sila numei le a tapa hawlkhia in. Ka tapa Isaac ii lua tu nei le lamh khen khat zongh hisia nu ii tapa in nga thei ngawl tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua in Abraham thinngimsak mama hi, banghang ziam cile Ishmael zongh ama ta ma ahi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahizong Pathian in Abraham tungah, “Hi tapano sia le na sila Hagar huvau in thinngim heak in. Sarah hong ci bang pawpo in seam in; banghang ziam cile kong kamciamsa suan le paalte Isaac tungtawnin na nei tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na silanu ii tapa tung zongh ah amate minam khat a suak tu in ta tam mama ka pia tu hi. Ama zongh nangma tapa ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A zing ciang zingtuung in, Abraham in Hagar tungah an pawl khat le savun thawl khat dim tui pia hi. Ama in a tapa, a nu nungzaang ah suanhin paikhiasak hi. Hagar pai in Beersheba duisung tengah vak kawkoai hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A tui ken teng a bo ciang ama in sawlpaang nuai khat ah a tapa nusia a,
  </para>
  <para style="p">
    <verse number="16" style="v" />meter zakhat bang a khuala na mun khat ah tosuk hi. Ama le ama, “Ka tapa a thi ka en ngam buatu hi,” ci hi. Tualai ah to in kap hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian in patang kaana aw za hi. Pathian vantunglalang in vantung pan Hagar paupui a, “Hagar awng, bang in nang hong thinngimsak ziam? Lau heak in! Pathian in patang kaana aw za zo hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ding in, pai in a, ama la in va theam ta'n. Ama ii suan le paal sia minam lian khat ka suaksak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tua zawkciang Pathian in Hagar mit vaaksak a, ama in tuikhuk khat mu hi. Ama pai in savun tuithawl sia dim a, pawlkhat tua patang pia hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Patang sia hong khangin Pathian in ompui hi; ama Paran dui sungah teang a, savai thiam khat suak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A nu in Egypt numei khat a zi tu in zonsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua hun in Abimelech sia a ngalkaphonpi ukpa Phicol taw Abraham kungah pai in, “Na nasepna theampo ah Pathian in hong ompui hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tua ahikom keima, ka tate ahibuale, ka suan ka paalte kong theam buatu hi ci in hisung Pathian mai ah kiciamna khat vawt in. Nang tungah kong thumaan zo hi, tua ahiciang kei tung le na teenna hi ngam zong ah nong thumaan natu in kamciam hong pia ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham in, “Kamciam kong pia hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abimelech naseamte ii a sutol tuikhuk khat taw kisai, Abraham in a lungkim ngawlna thu Abimelech tungah son hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abimelech in, “Akua in hong sut ziam, ka he bua hi. Nangma nong son bua a, tu a sia ka zaak ciilna hi,” ci hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuaciang Abraham in tuu le khui pawlkhat Abimelech pia in, amate nii in thukimna khat vawt uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham in a tuuhon sung panin tuuno sali tuamkoi hi,
  </para>
  <para style="p">
    <verse number="29" style="v" />tuaciang Abimelech in ama tungah, “Banghang tuabang hi ni ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Abraham in, “Hi tuuno salite hong sang ta'n. Hi bang nong saanna in hi tuikhuk a to sia keima ka hina thu nong pualaak na ahi hi” ci in zo hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua ahikom in tua mun sia, Beersheba kici hi, banghang ziam cile amate nii tua munah kiciamna khat vawt uh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Beersheba ah hi thukimna a vawt zawk uh ciang, Abimelech le Phicol, Philistia ah cia kik uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuaciang Abraham in Beersheba ah makeang kung khat suan a, Tawntung Pathian, Topa bia hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Philistia ngam ah Abraham khuangei ma teang hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hun khat zawkciang Pathian in Abraham ze et a; “Abraham awng!” ci in sam hi. Tuasia ciang Abraham in, “Hi khi hi, keima hi sungah om ing,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian in, “Na it mama, tapa khat bek na nei Isaac sia Moriah ngam ah paipui in. Tualai kong lak tu mual khat tungah keima biakpiakna in ama nong pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A zing ciang zingsang tuungin Abraham in biakpiak natu in thing pawlkhat tan a, a laa tungah suanh in a tapa Isaac le a naseamte nii taw, Pathian ii sawlna munah pai tu in ding uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A ni thum ni ciangin Abraham in tua mun ngalmu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuaciang ama in a naseamte tungah, “Hi lai ah laa taw na om vun. Kei le ka tapa sia zialai ah Pathian ka bia tu uh a, tua zawkciang kong cia kik tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham in biakpiak natu thing teng Isaac in puasak a, ama in nam khat le meitaw natu meikam keng hi. Amate a pata a paikhop kawkawm in
  </para>
  <para style="p">
    <verse number="7" style="v" />Isaac in, “Pa awng!” ci hi. A pa in, “Bang ziam ka ta awng,” ci in zo hi. Isaac in, “Mei le thing na ken ka mu a, ahizong biakpiak natu tuuno koisungah om ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham in, “Pathian in hong sik tu hi,” ci in zo hi. Tuaciang amate pata pai khawkhawm uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian ii a sonkholna mun a thet ciang, Abraham in biaknatau khat vawt a, a tungah thing koi hi. Ama in a tapa heencip in biaknatau tung thing tungah koi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuaciang ama in a tapa thatlum tu in a nam dok hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahizong Topa vantunglalang in vantung pan, “Abraham awng, Abraham awng!” ci in sam hi. Ama in, keima hi sungah om ing,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vantunglalang in, “Patangpa sia liamsua heak in, ama bangma law heak in. Pathian thu na nitna le na zatakna, tu in ka he hi, banghang ziam cile tapa khat bek na nei kei atu in na haza bua hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham khuadak kawkoai a, sawlpaang sungah a kii pan a awk tuutal khat mu hi. Ama pai in tua tuutal man a, a tapa taangin meihal biakpiakna khatin pia hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abraham in tua mun sia, Topa in hong sik hi “Jehovah Jireh” ci in min phuak hi. Tuni dong ciang mihingte in “ Topa ii mual tungah ama in hong sik hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Topa vantunglalang in vantung pan Abraham a nii veina sam a,
  </para>
  <para style="p">
    <verse number="16" style="v" />“ Topa cina ah — Keima min taw kiciamna khat ka vawt hi — thupha tam tatak kong pia tu hi. Banghang ziam cile hisia na vawt zo a, na tapa khat bek na nei kei atu in na haza bua hi,
  </para>
  <para style="p">
    <verse number="17" style="v" />na suan na paalte van ah aksi za, tuipivaal senvui za in tam mama ka phasak tu hi, ci in kamciam kong pia hi. Na suan na paalte in a ngalte zo tu uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangma suan le paalte tungah thupha ka piak bangin minam theampo in thupha ka piak tu hong ngen tu uh hi — tu teng sia nangma in ka thupiak na nit hang ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abraham sia a naseamte kungah cia kikin, Abraham teenna mun ahi, Beersheba ah amate taw ciakhawm tek uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hun khat zawkciang Abraham in, a suapuipa Nahor in a zi Milcah taw ta liat a neina thu he hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Uz sia a piang phit hi a, a suapuite sia Buz, Aram ii pa Kemuel,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chesed, Hazo, Pildash, Jidlaph le Bethuel ahi hi,
  </para>
  <para style="p">
    <verse number="23" style="v" />Bethuel sia Rebecca ii pa ahi hi. Milcah in Abraham suapuipa Nahor taw hi tapa liat teng nei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nahor zino Reumah in ta, Tebah, Gaham, Tahash le Maacah te nei hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sarah sia kum 127 nungta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Canaan ngam Hebron ah ama thi a, Abraham khuangai hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in tua mun a zi luang kisialna nusia in, Hit te kungah pai a,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Keima in note sungah ngamdangmi hong teang khat ka hi a; ka zi ka phum thei natu in, leitang tawm hong zuak tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amate in,
  </para>
  <para style="p">
    <verse number="6" style="v" />Syapa awng, kote ci bang hong ngai ta'n. Nangma in kote sungah lampui thahat khat in hong mu khu hi; ka thaan nei uh a phabel sungah na zi phum in. Na zi phum thei natu thaan ahile kote khat pawpo in hong pia thanuam khu hi,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuasia ciang Abraham in amate mai ah kunin,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Hi munah ka zi nong phumsak nuam uh le nong hesuakna in Zohar tapa Ephron tungah,
  </para>
  <para style="p">
    <verse number="9" style="v" />Machpelah Suanghawng hong zuak natu in hong ngetsak tavun, tuasia ama lo king ah om hi. Thaan leitang ka nei thei natu in, note theampo mai ah, a manh a cing taw kei hong zuak natu in hong ngetsak tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hit te kikhoptua na khuapi kongbiang ah Ephron zongh om hi; tua mun a omte theampo ii zaakin a zona pan,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Syapa awng, hong ngai ta'n; suanghawng omna tua ka lo buppi nang kong pia tu hi. Hi munah a om, ka mipuite ii mai ah tua ka lo sungah na zi na phum thei natu nang tungah kong pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahizong, Hit te mai ah Abraham kun a,
  </para>
  <para style="p">
    <verse number="13" style="v" />mi theampo zaak tu in Ephron tungah, “Hesuakna taw hong ngai ta'n. Na lociing bup kong lei tu hi. A manh kong piak za hong saang ta'n, tuaciang tua munah ka zi ka phum tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ephron in,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Syapa awng, tua leitang in ngunntang zali bek manh a — nang le kei kilaklaw ah son thamman na ziam? Tua munah na zi phum ta'n,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mipite zaak a, Ephron ii a sonna bang Abraham thukim in — sumzuakte ii a teena in a zak ngei toaisuangte zanghin ngunntang 400 pia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuabangin, Mamre nisuana sang, Ephron ii neisa Machpelah longam sia Abraham neisa suak hi. A lo bup le lo sungah a om suanghawng le thingkung theampo kihel in ama ii neisa hi siat hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua munah a kikhawm Hit te theampo in Abraham neisa a hina thu heakpui siat uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tua zawkciang Abraham in Canaan ngamsung tua suanghawng ah a zi Sarah phum hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua hi a, Hit te neisa ahi tua lo le suanghawng sia thaan mun khat tu in Abraham neisa suak hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tu in Abraham huai mama a, Topa in a sepna theampo ah thupha pia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama in a neisa theampo a uk, a naseam haambelpa tungah, “Ka phei kawmah na khut koi in a, kiciam in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hi sung a, Canaan mihingte sung pan ka tapa zi tu na teal ngawl natu in, vantung le leitung Pathian Topa min taw na kiciam tu ka dei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka pianna ngam ah pai kikin, ka beete sung pan ka tapa Isaac zi tu na pui tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahizong a naseampa in, “A numei in a inn nusia nuam ngawlin hi ngam ah kei hong zui nuam buathong le banglaw tu khi ziam? Nong paina ngam ah na tapa puak kik tu khi ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham in, “Tualai ah ka tapa na paipui thak ngawl natu, in kidawm in!
  </para>
  <para style="p">
    <verse number="7" style="v" />Vantung Pathian, Topa in ka pa inn pan le ka beete ngam pan hong paipui a, ama in ka suan ka paalte tungah hi ngam kong pia tu hi, ci in ciliaphuai takin kamciam hong pia hi. Tualai ah ka tapa atu zi khat na nga thei natu in ama in na mai ah ama ii vantunglalang sia sawl tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A numei in hong zui nuam bua ahile hi kamciam panin, nang na suakta tu hi. Bangbang po ahizong tua munah ka tapa na heak pui kik ngei buatu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuaciang a naseampa in, a topa Abraham ii phei kawmah a khut koi in Abraham ci bang seam tu in kiciam hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abraham neisa a uk, a naseampa in a topa kalaoh sawm la in, Mesopotamia saksang Nahor teenna khuapi ah pai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A thet ciang khuapi puasang tuikhuk ah a kalaohte khupdinsak hi. Tua hun in nikai zawk nitak sang hi a, numeite pusuak in a tuitoai hun ahi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama thungen a, “Ka topa Abraham ii Pathian, Topa awng, ka topa tung na kamciam kholet in tuni in hong taangtungsak ta'n.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hi sung, ka omna mun tuikhuk ah khuapi sung pan ngaknunote tuitoai in hong pai tu uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima in amate khat ii tungah, ‘Tui hong nesak ta'n, hesuakna taw na tuibeal niamsuksak in,’ ka ci tu hi. ‘Ne in, na kalaohte atu zongh tui kana toai tu hi,’ hong ci le tua nu sia, na naseampa Isaac atu in na teal kholsa numei hi tahen. Hi bangin hong hi takpi le ka topa tungah na kamciam na kholetna kong tel tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A thunget a man ma in, a liangko ah tuibeal a pua Rebecca hong theng hi. Tua nusia, Abraham suapuipa Nahor le a zi Milcahte ii tapa Bethuel ii tanu ahi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua nu sia, ngaknu thiangtho hi lai in, a mealpha mama ngaknuno khat hi. Ama tuikhuk ah tuaksuk a, a beal tui dimin hong kaato kik hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Naseampa, tua nu taw kimu tu in tai a, “Hesuakna taw na tuibeal sung panin ka neak tu tui hong pia ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in, “Ne in, syapa awng” ci in, a liangko pan a tuibeal niamsuksak paih a, tui a neak laitakin letsak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama, tui a neak zawkciang, Rebecca in, “Na kalaohte ii a du zaza a neak tu tui zongh ka na toai tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama in, a tuibeal taw tuitoai in ngan tui piakna kuang sungah sung memeang in, tuikhuk ah tui nawnin tai a, ama ii kalaohte theampo tui a kham mateng tui toaisak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tua pa huthe ngawlin, Topa in hong taangtungsak tu ahi katawm maw, ci in ama encik nginge hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngaknu nu sia tua teng a man zawkciang, tua pa in a manham khamh kual khat la in, ama naak ah baasak a, khamh hak lian nii zongh la in a baan ah bunsak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama in, “Na pa akua ziam, nong hesuakna hong son ta'n, na pa inn ah tu zan ka mite le keima ngia natu mun a om tu ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Ka pa sia Nahor le Milcah ii tapa Bethuel ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Koma inn ah na ngannote atu taangphaw le lopa ko tam mama om a, na ngia natu mun zongh om hi,” ci in ama in zo hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuasia ciang tua pa khupdin in Topa bia hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in, “Ka topa Abraham ii Pathian, Topa kipok tahen. Topa in ka topa Abraham tungah a kamciam sia thumaan takin kholet zo hi. Ka topa Abraham ii beete kungah Topa in hong masuan hi,” ci hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ngaknu nu sia a nu inn ah tai a, thupiang theampo son hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tu in Rebecca ii suapuipa Laban sia Abraham ii naseampa omna tuikhuk ah pai tu in tai hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Laban in a suapuinu naakba le a baan tungah haakte mu zo a, tua pa in Rebecca tungah a son teng a zaaksa hi. Ama sia a kalaohte kung tuikhuk ah a ding Abraham naseampa kungah pai in,
  </para>
  <para style="p">
    <verse number="31" style="v" />“Kei taw inn ah cia tawng. Nang sia Topa ii thupha piakpa khat na hi hi. Banghangin hi lai ah ding ni ziam? Ka inn ah nangma om natu inndoi khat le na kalaohte om natu mun om hi,” ci hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tua ahiciang tua pa inn sungah tum a, Laban in kalaohte vanh sua in, kalaohte taangphaw le lopa ko pia hi. Tua zawkciang ama in Abraham naseampa le a mite peang sil natu tui paipui hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />An a kilui ciang tua pa in, “Kong son tu teng kong son phot mateng an ka ne buatu hi,” ci hi. Laban in, “Na thuson zom in,” ci hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama kipan in, “Keima sia Abraham naseampa khi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Topa in ka topa nasia takin thupha pia a, a hau khat suaksak hi. Ama in, tuuhon, kealhon, khuihon, ngunn, khamh, sila pate le sila numeite, kalaohte le laate pia hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka topa ii zi Sarah a huai zawkciang ka topa atu tapa khat nei a, tua tapa tungah ka topa in a neisa theampo pia hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka topa in ama ii thupiak a zui tu in hong kiciamsak hi. Ama in, ‘Canaan ngam numeite sung pan ka tapa zi tu na teal buatu hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tua sangin, ka pa ii mipuite le ka beete kungah na pai tu a, ama zi tu na teal tu hi,’ hong ci hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuaciang, keima in ka topa tungah, ‘A numei in kei hong zui nuam buathong le banglaw tu khi ziam?’ ci in ka dongh hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ama in, ‘A thu ka nit tawntung Topa in na koppui tu a vantunglalang hong paisak tu a nangma hong taangtungsak tu hi. Nangma in ka mipuite, ka pa innkuan sung panin ka tapa zi tu na nga tu hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Na kiciamna pan na ton natu lampi khat bek om hi: ka beete kungah na pai ciangin amate in nang hong nial le tuasia ciang nang na tong tu hi,’ ci in hong zo hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Tuni in, tuikhuk kung ka thet ciang, ka thungetna in, ‘Ka topa Abraham ii Pathian Topa awng, nong hesuakna in ka sep tu teng hong taangtungsak ta'n.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hi sung tuikhuk ah om khi hi. Ngaknu khat tuitoai tu hong pai ciang a tuibeal sung pan tui neak tu hong piak natu in ka ngen tu hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ama lungkim in, ka kalaohte atu zongh tui hong pia le, tua nu sia ka topa tapa ii zi tu in na tealsa sia hisak in,’ ka ci hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Thim dide a ka thunget ka man ma in, Rebecca in a liangko tungah tuibeal pua in hong pai a, tuitoai tu in tuikhuk ah hong tuaksuk hi. Keima in ama tungah, ‘Nong hesuakna in ka neak tu tui hong pia ta'n,’ ka ci hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ama in, manlang takin a liangko pan a tuibeal niamsakin, ‘Ne in, na kalaohte zongh tui ka pia tu hi,’ hong ci hi. Tua ahiciang kei zongh tui ne a, ka kalaohte zongh ama in tui pia hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Keima in ama tungah, ‘Na pa akua ziam?’ ci in ka dongh hi. Ama in, ‘Ka pa sia Nahor le Milcah ii tapa Bethuel ahi hi,’ ci in hong zo hi. Tuasia ciangin, a naak ah naakba ka khai a, a baante tungah haakte ka bunsak hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Khupdin in Topa ka bia hi. Ka topa Abraham ii Pathian, Topa ka pok hi. Ama in ka topa ii beepa kung ma ah hong masuan zo a, hi lai ah ka topa ii tapa atu a tanu ka mu zo hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tu in hi bang ka topa tungah vaipuak na nei teng na khuangkhim tu na ngaisun uh a, ama tungah a kilawm bangin vawt na sawm uh le nong hesuakna in hong son tavun; hi thei bo na ci uh le zong hong son tavun, tua hile ka nasep tu zia ka khensat tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Laban le Bethuel in, “Hi thu Topa kung pan hong pai ahiciang, kote khensat tu hi ngawl hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hi sungah Rebecca om hi; ama ciapui tavun. Topa mama ii cisa bangin na topa tapa ii zi hi tahen,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Abraham naseampa in hi thu teng a zaak ciang, kunsuk in Topa bia hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tua zawkciang ama ii ken nikteen puansilh, ngunn le khamh kizepna teng sua khia in Rebecca pia hi. A suapuipa le a nu zongh a manham letsongte pia lai hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tuasia zawkciang Abraham ii naseampa le a mite anne tuidawn in, tua munah zan ngiak uh hi. Amate zingsang a thaw uh ciangin ama in, “Ka topa kungah hong ciasak kik tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ahizong, Rebecca suapuipa le a nu in, “Ngaknu nu taw nipi khat ahibuale ni sawm hong omkhawmsak lai ta'n, tua zawkciang hong cia thei tu hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ahizong ama in, “Kote hong taamsak heak vun. Topa in ka khualhawna hong zosak hi; ka topa kungah hong cia kiksak tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Amate in, “Ngaknu nu samin ama in bang a ci ziam, ih dongh tel tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tua ahiciang amate in Rebecca samin, “Hi pasalpa na zui paih nuam ziam?” ci in dongh hi. Ama in, “Ka zui paih nuam hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Tua ahikom amate in Rebecca le a innkuan ii naseam ngei sia nu zongh Abraham ii naseampa le a mite taw paisak uh hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Tuaciang amate in hi bangin Rebecca thupha pia uh hi: “Suapui nu, nang, a tul a thente ii nu suak ta'n! Na suan na paalte in, a ngalte ii khuapite zo tahen!”
  </para>
  <para style="p">
    <verse number="61" style="v" />Tua zawkciang Rebecca le a numei khangmoite Abraham ii naseampa taw paikhawm tu in, kithoai a, kalaoh tungah to uh hi. Tuaciang amate vaiding siat uh hi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Isaac sia, “A Nungta Hong Mu Pa ii Tuikhuk” a kici duisung ah pai in Canaan thangsang ah teang hi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Nikai zawk nitak sangin a lo sungah lam a seau le kalaohte hong pai mu hi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Rebecca in Isaac a mu ciang a kalaoh tung pan tuaksuk a,
  </para>
  <para style="p">
    <verse number="65" style="v" />Abraham ii naseampa tungah, “Lo sungah lamseau a, ei sang hong zuan pa akua ziam?” ci in dongh hi. Naseampa in, “Ama sia ka topa hi,” ci in zo hi. Tua ahiciang ama in, a mai khuna puan la in, a mai khu hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Naseampa in Isaac tungah a nasepna theampo son siat hi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Tua zawkciang Isaac in a nu Sarah teenna ngei tuipuanbuk sungah Rebecca paipui in ama sia a zi hong suak hi. Isaac in Rebecca it a, tua ahikom a nu thi huvau in ama a kihenepna suak hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham in zi dang khat nei a, a min Keturah ahi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama taw ta Zimran, Jokshan, Medan, Midian, Ishbak le Shuah nei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jokshan sia Sheba le Dedan ii pa hi a, Dedan ii suan le paalte sia Asshurim, Letushim le Leummim te ahi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Midian tapate sia Ephah, Epher, Hanoch, Abida le Eldaah ahi uh hi. Hite theampo sia Keturah ii suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham in a neisa theampo Isaac nusiat hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahizong ama nuntak sungin zi dangte taw a nei a tapate tungah letsongte pia hi. Tua zawkciang hi a tapate sia a tapa Isaac kung panin a khuala nisuana ngam ah paisak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abraham sia kum 175 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A ta Isaac le Ishmael te in Mamre nisuana sangah a om, Hit mi Zohar ii tapa Ephron ii lo sung, Machpelah Suanghawng sungah ama phum uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua lo sia Hit te tung pan Abraham ii a lei hi a; Abraham le a zi Sarah tua munah kiphum khawm hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham thi zawkciang, “A Nungta Hong Mu Pa ii Tuikhuk” nai ah a teang a tapa Isaac sia Pathian in thupha pia hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham ii zi Sarah ii sila nu ahi, Egypt mi Hagar ii Abraham taw a nei Ishmael in
  </para>
  <para style="p">
    <verse number="13" style="v" />amate ii suana taw kizui in a nuai a bang tapate nei hi: Nebaioth, Kedar, Adbeel, Mibsam,
  </para>
  <para style="p">
    <verse number="14" style="v" />Mishma, Dumah, Massa,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadad, Tema, Jetur, Naphish le Kedemah ahi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amate sia minam sawm le nii te ii taanghpupite hi a, amate minte la in khuanote le ngiaphual munte ii min in a kipia ahi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ishmael sia kum 137 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ishmael ii suan le paalte sia Egypt nisuana sang Assyria paina lampi, Havilah le Shur kilaklaw ah teang uh hi. Abraham suan le paal dangte taw kikhenin a tuamin teang uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hi teng sia Abraham ii tapa Isaac ii taanghthu ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isaac sia, Laban suapuinu, (Mesopotamia ngam Arameante) Bethuel tanu Rebecca taw a kiteen in kum sawmli pha hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rebecca in ta nei ngawl ahikom Isaac in Topa tungah thungetsak hi. Topa in ama thungetna zo a, Rebecca naupaai hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama in naupeang nei tu a, a sua ma in a naubu sungah amate khat le khat kihau hi. Ama in, “Banghangin kei tungah hi bang thu hong piang thong ziam?” ci hi. Tua ahiciang ama in Topa kungah pai in, ahang dongh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Topa in ama ii tungah “Minam nii na sungah om a; A kidem minam niite nang sung pan piang tu hi. Khat sia a dang khat sangin hat zaw tu a; A u zaw in a nau zaw sia ii na sepsak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A nau sua hun hong cing a, ama in tapa peang nei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A suak masa sia a ci san a, a vun sia mul nei puantual taw kibang hi, tua ahikom a min Esau kiphuak hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A niina pa in Esau khuatul len cinten sa in hong suak ahikom ama min Jacob kiphuak hi. Amate a sua lai in Isaac kum sawmluk pha hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua patangte hong khang a, Esau sia ngamsung vak a uuk sakap thiam khat suak hi. Ahizong Jacob sia mihing cinghkamh khat hi a, inn ah om hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isaac in Esau ii a samatte ii sa nene ahikom Esau diksa zaw a, ahizong Rebecca in Jacob diksa zaw hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ni khat Jacob in be mee huanin a om laitak Esau a savaina pan hong theng hi. Ama a ngilkial a,
  </para>
  <para style="p">
    <verse number="30" style="v" />Jacob tungah, “Ngilkial in pukhong khi hi; na meetui san tawm hong pia ta'n,” ci hi. (Tua ahikom ama Edom kici hi.)
  </para>
  <para style="p">
    <verse number="31" style="v" />Jacob in, “Tapaciil hina taw na nga na innluaza hong pia lete kong pia tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Esau in, “Hi hen! A thi tu ka hi hi; tua ahiciang ka innluaza bang a mang tu khi ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jacob in, “Ka innluaza hong pia tu khi hi ci in kiciam masa in,” ci in zo hi. Esau kiciam in a taciil innluaza Jacob tungah pia hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuaciang Jacob in anluum pawlkhat le antui pawlkhat Esau pia hi. Esau in a an le antuite ne in, dawnin, tua zawkciang dingto in paisan hi. Esau in taciil a hina innluaza a awlmawk ngawlna sia tu a bang ahi hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham hun lai in kialpi masa a tun bek dom ngawlin tua ngam sungah kialpi dangkhat tung hi. Philistine kumpi Abimelech kung Gerar ah Isaac pai hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Isaac kungah Topa kilangh a, “Egypt ah pai heak in; om a kong sonna mun hi ngam sungah om po in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hi lai ah teang in, nang taw kong omkhawm tu a, thupha kong pia tu hi. Nang le na suan na paalte tungah hi ngam theampo kong pia tu hi. Na pa Abraham tungah ka kamciam ka kholet tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na suan na paalte van ah aksi za in, ka tamsak tu a, amate tungah hi ngam theampo ka pia tu hi. Na suan na paalte thupha ka piak bangin leitung minam theampo in thupha ka piak natu kei tungah hong ngen tu uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham in ka thu ni a, ka thukhamte le ka thupiakte theampo kholet ahikom, nangma thupha kong pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua ahiciang Isaac sia Gerar ah teang hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua munah om mite in a zi taw kisai thu a dok ciang, ka suapuinu hi, ci hi. Ama in ka zi ci ngam ngawl hi, banghang ziam cile Rebecca sia a mealpha mama a, tua mite in Rebecca a nga nop manin, ama a thalup tu lau hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tualai ah Isaac tawmvei sung a om zawkciang Abimelech kumpipa in a khelki pan khua a etsuk le, Isaac le Rebecca a kino laitak mu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abimelech in Isaac samsak a, “Rebecca sia na zi hi! Banghangin ka suapuinu hi ci ni ziam?” ci hi. Ama in, “Ama ka zi hi ci leng kei hong kithatlum tu ci in ka ngaisun hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abimelech in, “Ko tungah banghang hi bang hong vawt ni ziam? Ka mite khat in olno takin na zi luppui thong le ko mawna sia nangma hang ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abimelech in mihingte theampo kidop natu thupia a: “Hisia pa ahizong, a zi ahizong a vawtsia peuma, kithatlum tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Isaac in tua leitang ah thaicii poai a, tua kum in a thaicii poai za sangin a za zakhat in an a tamzaw la hi, banghang ziam cile Topa in ama thupha pia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama nuamsa paisuak a, mihau mama khat suak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Banghang ziam cile ama in tuuhon, khuihon le naseam tam mama nei ahikom Philistine te in ama eang uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua ahikom a pa Abraham nuntak lai a, a naseamte ii a tawsa tuikhuk theampo Philistine te in lei huk siat hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuasia zawkciang Abimelech in Isaac tungah, “Ko ngam pan tai vun. Ko sangin thahat zaw zo nu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua ahiciang Isaac in tua mun nusia in Gerar Kuam ah ngiaphual saatin, tua munah tawmvei sung om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham hun lai a, a taw, Abraham thi zawkciang Philistine te ii lei a huk siat tuikhukte ama in khatvei to kik hi. Tuate a pa ii min a phua sa bangin Isaac in min vaw hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Isaac ii naseamte in tua kuam ah tuikhuk khat to in tui mu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gerar tuucingte in Isaac tuucingte taw kihau uh a, “Hi tui koma aa hi,” ci uh hi. Tua ahikom Isaac in tua tuikhuk, “Kihauna” ci in min phua hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Isaac ii naseamte in tuikhuk dangkhat to a, kihauna om kik leleau ahikom ama in, “Kingal vawtna” ci in minphua hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua mun pan kiinin tuikhuk dangkhat to hi. Tua tungtaang ah kikamtamna om ngawl ahikom ama in, “Suatakna” ci in min phuak hi. Ama in, “Tu in hi leitang ah teen thei natu in, Topa in suatakna hong pia zo ahiciang hi munah eite ih nuamsa tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Isaac in tua mun nusia in, Beersheba zuan hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua zanin Topa ama tungah kilangh a, “Keima in na pa Abraham ii Pathian ka hi hi. Lau heak in; nang taw kong omkhawm hi. Nang thupha kong pia tu a, suan le paal tam mama kong pia tu hi, banghang ziam cile ka naseampa Abraham tungah ka kamciamna hang ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Isaac in biaknatau khat tua munah vawtin Topa bia hi. Tua zawkciang tualai ah a ngiaphual saatin, a naseamte in tuikhuk dang khat to hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Isaac taw kimu tu in Gerar pan Abimelech sia a thudokpa Ahuzzath le a ngalkaphonpi ukpa Phicol taw pai hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua ahikom Isaac in amate tungah, “Kei taw kisi tu in banghang hong pai nu ziam, tu masia in nong pawl vawt peuma bua a, na ngam pan hong not hi ngawl nu ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amate in, “Nang taw Topa a om hunlam tu in ka he uh a, eite kilaklaw ah thukimna pha khat nei tu in ka ngaisun uh hi. Ko deina ah,
  </para>
  <para style="p">
    <verse number="29" style="v" />kote in nang kong natsak ngawl bangma in, nang zongh in kote nong natsak ngawl natuin kamciam nong piak natu ahi hi. Na tungah kong thuthiam uh a, nuam takin kong paisak uh hi. Topa in nang thupha hong piak sia tu in kitelthiang hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Isaac in amate atu in anneakpoai khat vawtsak a, amate anne in tuidawn uh hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A zing ciang zingtuung in mi simin kiciamna nei a, kipsak uh hi. Isaac in amate mangpha thaakin pawl le lawm khat bangin kikhen uh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tua ni in, Isaac ii naseamte hong pai in amate tawsa, tuikhuk thu ama tungah son hi. Amate in, “Tui ka mu zo uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama in tuikhuk sia, “Kiciamna” ci in minphua hi. Tuabangin Beersheba khuapi in a min nga hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau kum sawmli a phak ciang, Hit te numei te nii Beeri ii tanu Judith le Elon ii tanu Basemath teenpui hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amate in Isaac le Rebecca nuntak sung in thinngim pia uh hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tu in Isaac huai zo a, a mittaw hi. Ama in a ta uzaw Esau samin, “Ka tapa awng!” ci hi. A tapa in, “Hi ing” ci in zo hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Isaac in, “Nong mu bangin kei huai zo a, thi pal tha tu khi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na thal le thaltangte la in a, ngamvakin kei atu ngamsa khat hong kap ta'n.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka du ngei anlim tawm hong huan ta'n a, hong paipui ta'n. Tuasia ka neak zawkciang, ka thi ma in, ka thupha khakbel nang kong pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isaac in Esau a paupui laitakin, Rebecca in ngai nginge hi. Tua ahikom Esau savai tu in a kuan ciang,
  </para>
  <para style="p">
    <verse number="6" style="v" />Rebecca in Jacob tungah, “Na pa ii Esau tungah a son teng ka zaak zawk bek hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Ngamsa khat hong ciapui ta'n a, hong huansak ta'n, tuasia ka neak zawkciang, ka thi ma in Topa mai ah thupha kong pia tu hi,’ ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rebecca in a thuson zom a, “Tu in ka tapa awng, hong ngai ta'n a, kong ci bang seam in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nganhon sungah pai in, kealno a thau nii hong man ta'n, tua hile na pa du mama ngei tua an sia kong huan thei tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuasia a neak tu in na pa kungah na paipui thei tu a, a thi ma in a thupha nang hong pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahizong Jacob in a nu tungah, “Na heak bangma Esau in mul hau a, ahizong kei ka vun neal hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka pa in hong tham luilam thong le, ama ka theamna hong tel tu hi; hi bangin keima tungah thupha luangin haamsiatna ka thengsak zaw tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A nu in, “Ka tapa awng, nang tungah haamsiatna khat pawpo sia kei tungah hong tung tahen; kong ci bangin ngamta in; va pai ta'n a, keima atu in kealte hong paipui ta'n,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tua ahiciang kealte man tu in pai a, a nu kung then hi, tuaciang a nu in a pa du bangin huansak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua zawkciang ama in inn sungah a kep Esau ii puan phabelte la in, Jacob silhsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama in, kealvunte a baan tung le a ngawng mul om ngawlna teng ah koisak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama ii huan anlim le anluumte a tapa khut ah aap hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuaciang Jacob sia a pa kungah pai in, “Pa!” ci hi. A pa in, “Hi ing, ka tapate akua hi zaw ni ziam?” ci in zo hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jacob in, “Keima in na tapa u zaw Esau khi hi; nong sawl bangin vawt zo khi hi. Hesuakna taw hong to ta'n a, na thupha nong piak thei natu in, sa pawlkhat kong paipui sia ne in,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isaac in, “Ka tapa awng, hi bang manlang takin bangbang nga thei ni ziam?” ci hi. Jacob in, “ Topa na Pathian in ka nga natu hong hu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Isaac in Jacob tungah, “Hesuakna taw kong tham thei tu in hong neak lai ta'n. Nang Esau ma hi takpi ni ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jacob sia a pa nai hong neak zaw hi, a pa in tham a, “Na aw ahile Jacob awsua taw kibang a, ahizong na baan sia Esau baan tham taw kibang hi” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pa in Jacob a hina tel zo ngawl hi, banghang ziam cile Esau baan bangma in baanmul nei hi. A thuphate ama pia tu ahihang,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Nang Esau ma hi takpi ni ziam?” ci in dongh kik hi. Ama in, “Hi khi hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Isaac in, “Na sa huan tawm hong paipui ta'n. Ka neak zawkciang ka thupha hong pia tu khi hi,” ci hi. Jacob in a pa kungah a sa huan paipui in, a neak tu in sapittui zongh paipui hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuasia ciang a pa in ama tungah, “Ka tapa awng, hong neak ta'n a, hong namh ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in a pa namh tu hong pai le, a pa in a puan ngimnam za a — tua ahiciang ama thupha pia hi. Ama in, “Ka tapa ngimnamtui sia Topa ii thupha a piaksa lo khat ii ngim taw kibang hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathian in na tungah vantung daaitui hong pia hen a, na lote lei phasak tahen! An le sapittui tam mama hong pia tahen!
  </para>
  <para style="p">
    <verse number="29" style="v" />Minamte na naseam suakin mihingte na mai ah kun tahen. Na beete theampo uk in, na nu suan le paalte na mai ah kun tahen. Nang hong haamsiatte haamsiatna thuak hen a, nang thupha hong piate thupha nga tahen,” ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Isaac in thupha pia siat zo a, Jacob ii a nusiat zawk po ciang, a suapuipa Esau a savaina panin theng hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama zongh in anlim pawl khat huan a, a pa kungah paipui hi. Ama in, “Pa awng, hesuakna taw hong to ta'n a, na thupha kei nong piak thei natu in na tapa ii kong paipui sate ne in,” ci hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Isaac in, “Nang akua ni ziam?” ci in dongh hi. Ama in, “Na tapa u zaw Esau khi hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuaciang Isaac a ci liing ngawpin, a pumpi bup ngawk a, ama in, “Tua ahile, ngamsa khat kaplumin kei kungah hong paipui sia akua ziam? Nang nong thet mahiat in ka ne hi. Ama tungah ka thupha khakbel ka pia zo a, tua ahikom a tawntungin ama aa hi zo hi,” ci hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau sia hi thu a zaak ciang, nging takin kapngawp a, “Pa awng, kei zongh na thupha hong pia ta'n!” ci hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Isaac in, “Na suapuipa hong pai in kei hong theam hi. Ama in na thupha hong laaksak zo hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Esau in, “Tu a sia kei hong theam a nii veina hi. A min Jacob ahi sia lamdang ngawl hi. Ama in ka taciil innluaza la zo a, tu in ka thupha hong laksak leleau hi. Kei atu in thupha khat khe ngawl ni ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Isaac in, “Ama sia nangma to ka suaksak zo a, a beete theampo a ma sila te ka hisak zo hi. An le sapittui ama ka pia zo hi. Ka tapa awng, tu in nang atu kong vawtsak thei tu, bangma om nawn ngawl hi!” ci in zo hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Esau in a pa tungah ngen veve lai a: “Pa awng, thupha khat bek ma nei ni ziam? Kei zongh thupha hong pia ta'n, Pa awng!” ci in ama kap hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuaciang Isaac in ama tungah “Nang atu vantung pan daaitui om ngawl a, Nang atu a leipha lote om ngawl hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Na namsau suangin na nungta tu a, Ahizong na suapuipa ii sila na hi tu hi Ahihang ama na leedo ciangin ama ii ukna panin na peng tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Esau in Jacob ngaimaw hi, banghang ziam cile a pa in a thupha Jacob pia zo hi. Ama in “Ka pa thina hangin khuangai tu hun hong nai zo hi: tuasia zawkciang Jacob ka that tu hi,” ci in ngaisun hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahizong, Esau ii sawmna thu Rebecca in a zaak ciang Jacob sam a, ama in “Ngai in, na suapuipa Esau in nang thatlumin phulaak hong sawm hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tu in ka tapa awng, kong ci bangin ngamta in. Haran ah a teang ka suapuipa Laban kungah thakhatin tai zawzok ta'n,
  </para>
  <para style="p">
    <verse number="44" style="v" />na suapuipa thin uuk thai dong tawmvei sung Laban taw omkhawm ta'n,
  </para>
  <para style="p">
    <verse number="45" style="v" />tua hile ama tungah na vawtnate mangil tu hi. Tuasia ciang mihing khat po sawlin nang kong samsak kik tu hi. Banghangin ka tate nii, ni khat thu in khuai tu khi ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Rebecca in Isaac tungah, “Esau ii ngamdang zite hangin cimtakin ka nat law hi. Jacob zongh Hit te numei khat taw kiteang thong le, thi law liang tu khi hi,” ci hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isaac in Jacob samin a nukset zawkciang, “Canaan numei peuma teenpui heak in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tua sangin Mesopotamia ngam na pupi Bethuel inn ah pai in, na pu Laban tanute khat teenpui in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Minam tam te ii pa na sua natu in Vaanglianbelpa Pathian in na mopoai ah thupha hong pia hen a, ta tam mama hong pia tahen!
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian in, Abraham thupha a piak bangin nang le na suan na paalte thupha hong pia tahen a, Abraham tungah a piak, na teenna leitang sia nang neisa hisak tahen!” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isaac in Laban teenna Mesopotamia ah Jacob paisak a, Laban sia Arameante Bethuel tapa hi a, Jacob le Esau te ii nu, Rebecca suapuipa ahi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Isaac in Jacob thupha pia a, Mesopotamia ah zi zong tu in a paisakna thu Esau in he hi. Isaac in Jacob thupha a piak ciang Canaan numeite a teenpui ngawl natu in a thupiak zongh ama in he hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jacob in a nu le a pa thu ni in Mesopotamia ah a paina thu Esau in tel hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua zawkciang Esau in a pa Isaac ii Canaan numeite a lungkim ngawlna thu tel hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua ahiciang ama in Abraham tapa Ishmael kungah pai in a tanu Mahalath, Nebaioth ii suapuinu teenpui hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jacob in Beersheba nusia in Haran sang zuan hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nitum ciang mun thiangtho khat theng a, tua munah ngiaphual saat hi. Ama mu tu in, suang khat khamhin lumsuk hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama in mangman a, keallei khat leitung pan vantung dong kidawto in, vantunglalangte tua keallei ah a tuaksuk a kaato mu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuaciang ama kungah Topa ding hi. Ama in, “Keima in Abraham le Isaac te ii Pathian, Topa ka hi hi. Nang le na suan na paalte tungah na lupna hi leitang kong pia tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate leitung ah leivui za in tam tu hi. Amate in mun theampo ah ngamkeak tu uh a, nang le na suan na paalte tungtawnin minamte theampo thupha ka pia tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ciamtee ta'n, na paina po ah nang taw om in, kong dal tu a, hi leitang ah kong thet pui kik tu hi. Kong kamciamsa teng ka vawt siat mateng in, nang kong nusia buatu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jacob khanglo in, “ Topa hi sungah om hi! Ama hi munah om hi, keima in hi thu ka he bua hi,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama lau in, “Hi mun bangza in lauhuai ziam! Hi sia Pathian inn hi nanak tu hi; hi mun in vantung tum natu kongpi hi nanak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A zing ciang zingtuungin Jacob tho a, a suang lukham la in khansuang khat in phut hi. Tua zawkciang ama in khansuang sia olive thau buakin Pathian tungah aap hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in tua mun sia Bethel ci hi. (Nidangin tuak ah om khua sia Luz kici hi.)
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua zawkciang Jacob in Pathian tungah kiciamna khat vawt a: “Nangma in kei taw nong om a, ka khualhawna ah hong dalin, an le puan nong pia a,
  </para>
  <para style="p">
    <verse number="21" style="v" />tuaciang ciidam in ka pa inn ah ka cia kik le, tuasia ciang nangma in ka Pathian na hi tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hi khansuang ka phuna sia nangma hong kibiakna mun hi tu hi, tuaciang nong piak theampo sung pan sawm a khat, nang kong pia tu hi,” ci hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jacob sia a pai natu mun nisuana ngam sang manaw in paisuak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thakhatin lo sungah a om tuikhuk khat kung theng a, tuikhuk paam ah tuuhon, hon thum lum hi. Ngannote in hi tuikhuk pan tui ne hi, tuikhuk sitna suangtum sia lian mama hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualai ah tuuhonte hong thet hon ciang tuucingte in tua suang liikin, tuute tui pia hi. Tua zawkciang amate in a omna ngei ah tua suang koi kik hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jacob in tuucingte tungah, “Ka lawmte awng, koisung pan nu ziam?” ci in dongh hi. Amate in, “Haran pan hi ung,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama in, “Nahor ii tapa Laban na he uh ziam?” ci in dongh hi. Amate in, “He khu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in, “Ama a ciidam ziam?” ci in dongh hi. Amate in, “Ama a ciidam hi. En in, a tanu Rachel zongh a tuuhonte taw hi sungah hong pai hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jacob in, “Ni sang lai a, ngan hawl hun ngawl lai ahikom, tuute tui pia in tha kik ngawl tu nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amate in, “Tuuhon theampo hi lai ah om siat in, suangtum a kiliik kik mateng ngan ka tha thei buatu uh hi; tua zawkciang tuuhonte tui ka pia tu uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jacob sia amate taw kipaupui in a om laitak, Rachel, tuuhon taw hong theng hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jacob in a pu Laban tuuhon le Rachel a mu ciang tuikhuk ah pai in, suangtum liik in, tuute tui pia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua zawkciang Jacob in ama namh a, lungdamin kap hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama in Rachel tungah, “Keima in Rebecca ii tapa, na pa ii mealheak ka hi hi,” ci hi. Ama sia a pa tungah thu ko tu in tai hi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Laban in a tupa Jacob ii thu a zaak ciang ama muak tu in tai a, koai in namh a, inn ah ciapui hi. Jacob in thupiang theampo Laban tungah a son zawkciang,
  </para>
  <para style="p">
    <verse number="14" style="v" />Laban in, “Hi hi, nangma in keima chi le sa na hi tatak hi,” ci hi. Tualai ah Jacob tha khat bup taam hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Laban in Jacob tungah, “Nangma sia ka mealheak na hi manpo in, a thongin ka na nong sepsak buatu hi. Thasum bangza dei tu ni ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Laban in ta numei nii nei a; a unu min Leah hi in, a naunu min Rachel ahi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Leah sia a mit haa ngaibaang a, Rachel ahile a khan pha in a mealhoi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jacob sia Rachel taw ki it ahikom a pu tungah, “Rachel taw nong kiteangsak tu ahile, kum sali sung noma na kong sepsak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban in, “Midang khat po ka piak sangin ama nang kong pia nuam zaw hi; hilai kei kungah hong om ta'n,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jacob in Rachel a nga thei natu in kum sali sung naseam a, ama a itna hangin tua hunte ni tawmno taw kibang sa hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuaciang, Jacob in Laban tungah, “Ih hun cing hi; na tanu taw hong teangsak ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua ahiciang Laban in mopoai vawtsakin ngual theampo sam hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahizong tua zanin a pu in Jacob tungah Rachel taangin Leah pia a, Jacob in Leah luppui hi. (
  </para>
  <para style="p">
    <verse number="24" style="v" />Laban in ama ii silanu Zilpah, a tanu Leah tungah a naseam tu in pia hi.)
  </para>
  <para style="p">
    <verse number="25" style="v" />A zingsang ciang Leah a hina thu Jacob in he pheang hi. Ama in Laban kungah pai in, “Banghangin hi bang hong vawt thong ni ziam? Rachel nga nuam in hong thalaw hi ngawl khi ziam? Banghangin kei hong theam ni ziam?,” ci hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban in, “A u kan in a nau pasal a nei tu sia ko ngeina hi ngawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nipi khat sung mopoai vawt hun ngak phot in a, tuaciang a dang kum sali sung ka na nong sepsak lai tu ahile, Rachel kong pia tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jacob lungkim a, nipi khat sung mopoai hun a bo ciang, Laban in a tanu Rachel, Jacob zi tu in pia hi. (
  </para>
  <para style="p">
    <verse number="29" style="v" />Laban in a sila nu Bilhah sia a tanu Rachel tungah a naseam tu in pia hi.)
  </para>
  <para style="p">
    <verse number="30" style="v" />Jacob in Rachel zongh luppui a, ama in Leah sang Rachel it zaw hi. Tuasia ciang ama in a dang kum sali sung Laban atu naseam thua lai hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Rachel sangin Leah a it ngawl zawkna thu Topa in a heak ciang, Leah sia ta nei thei tu in siam a, ahizong Rachel sia ta neisak ngawl lai hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Leah ngai in tapa khat nei hi. Ama in, “Ka thinngimna Topa in hong mu a, tu in ka pasal in hong it tu hi,” ci a, tua ahiciang a min Reuben phuak hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama ngai kik a, tapa dang khat nei hi. Ama in, “Kei hong ki it ngawlna thu Topa in za zo ahikom Topa in hi tapa zongh kei hong pia zo hi,” ci a tua ahiciang a min Simeon phuak hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khatvei ma ama ngai kik a, tapa dang khat nei hi. Ama in, “Tu in ka pasal in kei hong kholet zaw tu hi, banghang ziam cile tapa thum ka neisak zo hi,” ci a, tua ahiciang a min Levi phuak hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuaciang Leah hong ngai kik a, tapa dang khat nei hi. Ama in, “Tu hile Topa ka pok tu hi,” ci a, tua ahiciang a min Judah phuak hi. Tuasia ciang ama ta tawp hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahihang Rachel in Jacob taw ta khat zongh nei ngawl hi, tua ahikom ama in a suapuinu Leah eangin Jacob tungah, “Ta hong pia tan tua ahibuale ka thi tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rachel tungah Jacob thin uuk a, “Pathian dinmun ka la thei buatu hi. Ta nei tu hong khak pa sia ama hi,” ci hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in, “Hi lai ah, ka silanu Bilhah om hi; ama taw lumkhawm lete kei atu in ta nei thei tu hi. Hi bangin kei sia ama tungtawnin nu khat ka suak thei tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua ahiciang ama in a pasal tungah Bilhah pia a, a pasal in ama ompui hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bilhah ngai in Jacob taw tapa khat nei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rachel in, “Pathian in thukhen a, maipha hong pia hi. Ama in ka thungetna hong za in tapa khat hong pia hi,” ci a, tua ahiciang a min Dan phuak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bilhah ngai kikin, Jacob taw tapa a niina nei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rachel in, “Haksa takin ka suapuinu ka do a, ahizong keima in ka zo zo hi,” ci a tua ahiciang a min Naphtali phuak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leah in a tatawp hunlam a kiheak ciang, a sila nu Zilpah sia Jacob ii zi tu in pia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuasia ciang Zilpah in Jacob taw tapa khat nei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Leah in, “Ka kaampha zo hi,” ci a, tua ahiciang a min Gad phuak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zilpah in Jacob taw tapa dang khat nei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Leah in, “Bangza in ka lungdam ziam! Tu in, numeite in a lungdam nu hong ci tu hi,” ci a, tua ahiciang a min Asher phuak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zungtaang laak hun laitakin Reuben sia lo sungah pai a, mandrake ai ngate mu in a nu Leah puak hi. Rachel in Leah tungah, “Hesuakna taw na tapa ii mandrake ai ngate tawm hong pia ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Leah in, “Ka pasal nong laaksak sia pha zo ngawl ziam? Tu in ka tapa ii mandrake ai ngate ngawngawn laaksak nong sawm lai hi,” ci in zo hi. Rachel in, “Na tapa ii mandrake ai ngate nong pia le, tu zan Jacob taw lumkhawm thei tu ni hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nitakin lo pan Jacob hong cia ciang, Jacob taw kimu tu in Leah pai a, “Tu zan kei kung hong lum tu ni hi, banghang ziam cile ka tapa ii mandrake ai ngate taw nang kong thapsa hi,” ci hi. Tua ahikom tua zanin Jacob le Leah omkhawm hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian in Leah ii thungetna zo a, ama ngai in Jacob taw tapa a ngana nei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Leah in, “Ka silanu ka pasal pia ka hikom Pathian in keima thaman hong pia zo hi,” ci a, tua ahiciang a tapa min Issachar phuak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leah ngai kik a, Jacob taw tapa a lukna nei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama in, “Pathian in letsong pha khat hong pia zo hi. Tu in ka pasal in kei hong saang tu hi, banghang ziam cile ama atu in tapa luk ka neisak zo hi,” ci a, tua ahiciang a min Zebulun phuak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tua zawkin ta numei khat nei a, ama in a min Dinah phuak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua zawkciang Pathian in Rachel phawk hi; ama ii thungetna zo in, ta nei thei tu in siam hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rachel ngai in tapa khat nei hi. Ama in, “Pathian in tapa khat hong piakna taw ka maizumna teng bosak zo hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Topa in tapa dang khat hong pia lai tahen,” ci a, tua ahiciang a min Joseph phuak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph a sua zawkciang Jacob in Laban tungah, “Ka inn ah a cia kik tu in hong paisak ta'n.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nang atu naseamin kong thalawsa ka zite le ka tate hong pia ta'n, cia tu khi hi. Pha takpi na kong sepsak na he hi,” ci hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Laban in ama tungah, “Thu hong son tong: Topa in nang hangin kei thupha hong piak hunlam mukholna nei in, ka he zo hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na thaman hong son lete kong pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jacob in, “Na na kong sepsakna thu le keima sep sungin na nganhonte a pun mama na thu na he hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kei kong thet ma in nganno tawm bek na nei hi, tu in tam mama in khang hi. Ka va ka ciana po ah Topa in nang thupha hong pia zo hi. Tu in keima phattuam natu ka ngaisut tu hun zo hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Laban in, “Bang hong pia tu khi ziam?” ci in dongh hi. Jacob in, “Thaman bangma dei bong. Hi ka ngaisutna bang na thukim le na nganhonte ka cing lai tu hi:
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuni in na nganhon theampo sungah hong paisak ta'n a, tuu a vom teng, kealno a ngial teng ahibuale a pawl teng hong theisak ta'n. Tua teng ka thaman tu in dei khi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ka thumaanna sia mai sangah ol takin hong mu thei tu ni hi. Ka thamante sit tu in nong pai ciang kealte sung pan a pawl ngawl, a ngial ngawl khat, tuute sung pan a vom ngawl khat pawpo ka nei le ka nguk ahi hunlam he tu ni hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Laban in, “Thukim ing. Nangma ci bangin ih vawt tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahizong tua ni in Laban in kealtal a ngial, a pawl teng le kealnu a ngial, a pawl ahibuale a kaang kihel teng khenkhia hi; tuu vom teng zongh khentuam hi. Ama in, tua teng a tapate kep tu in koi a,
  </para>
  <para style="p">
    <verse number="36" style="v" />tua zawkciang, Jacob kung pan ni thum paina munah hi nganhon teng paipui hi. Jacob in Laban ii nganno a taanglai teng keam hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jacob in hiang, thuangthi le pakngiam kungte pan a baak hingte saatin, a haw tawm ngiam a, a pawlin vawtin, a kaang ngialte kimusak hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ama in tua thingbaakte sia nganhonte ii mai, a tui neakna kuangte ii kungah koisak hi. Ama in tua munah thingbaak pawlte banghangin koi ziam cile ngannote tui ne tu in hong pai ciang a nu le a pa omkhopna mun ahihang hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tua ahikom, kealte tua thingbaak pawlte mai ah omkhawm a, no a nei uh ciang a ngial, a pawl veu piang uh hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jacob in tuute le kealte khenin tuam koi a, Laban ii nganno a ngial le a vom honte omna sang maingatsak hi. Hi bangin ama in a ngannote pungtosakin Laban ii ngannote taw kihelsak ngawl hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nganno ciidamte tua thingbaakte sungah a omkhop ciang, a no a pawlte a nei thei natu in thingbaak pawlte sia a maingatna uh tuikuang kungah Jacob in koi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahizong ama in tua thingbaakte sia nganno thazawmte mai ah koi ngawl hi. Hai ngawlin nganno thazawm teng Laban neisa suak a, nganno ciidam teng Jacob neisa suak hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hi bangin Jacob sia a hau mama suak hi. Ama in nganhonte, silate, kalaohte le laate tam mama nei hi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Laban tapate in, “Ih pa ii neisa theampo Jacob in la siat hi. A hauna theampo sia ih pa ii neisa tungtawnin a nga hi,” a cina thu Jacob in za hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nidang bang a Laban ii a pawlvawt nawn ngawlna thu zongh Jacob in mu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuasia ciang, Topa in ama tungah, “Na beete kung le na pate ii ngam le lei zuan kik in. Nang taw kong omkhawm tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua ahikom Jacob in a tuute omna lo sungah ama taw kimu tu in, Rachel le Leah kam vaitha hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama in a zite tungah, “Na pa ii nidang lai hong pawlvawt ngei bang ahi nawn ngawlna thu ka he hi; ahizong ka pa ii Pathian in kei hong ompui hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka tha neiza taw na pa ii na ka sep sia na heak uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahizong ama in kei hong theamin ka thamante sawmvei hong khealsak zo hi. Ka tungah siatna hong vawt tu sia Pathian in oai ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Laban in, ‘Keal a pawl iim-iam teng na thaman tu hi,’ hong ci ciang nganno theampo a pawl iim-iam in piang hi. Ama in, ‘Keal a ngial teng na thaman tu hi,’ hong ci ciang nganno theampo a ngialin piang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in na pa kung pan ngannote la a, kei hong pia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Ngannote a ta nei tu hunin, mang khat ka man a kealpuite sia kealtal a ngial, a pawl te taw omkhawmin ka mu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian vantunglalang in ka mang sungah hong paupui in, ‘Jacob!’ hong ci a, ‘Om khi hi,’ ci in ka zo hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuaciang ama in, ‘En in’ kealpuite a ompui kealtalte sia a ngial, a pawl vive hi. Hi bang a piang tu in, keima vawt hi, banghang ziam cile nang tungah Laban ii hong vawtna teng ka mu zo hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima in Bethel ah nang tung a hong kilangh Pathian ka hi hi, tua munah nong phaw tawntung natu khansuang phutin olive thau na buak a, aapna nei in kei tungah kiciamna khat na vawt hi. Tu in kithoai in a, na pianna ngam le lei zuan kik in’ hong ci hi,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rachel le Leah in Jacob tungah, “Ka pa uh kung pan ka lua tu bangma taang nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama in ko sia ngamdangmite bangin hong vawt hi. Ama in ko hong zuak a, hong kileina sum teng zongh zangh siat zo hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka pa uh kung pan Pathian ii a laak sa hi nei le lamh theampo sia ko le ka tate aa ahi hi. Pathian hong sawl pawpo seam in,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua ahiciang Jacob sia Canaan ngam a pa kung zuan kik tu in kithoai hi. Ama in a tate le a zite, kalaohte tungah tosak hi, Mesopotamia ngam pan a nga na theampo taw a nganno theampo a mai ah hawl hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban sia a tuute mul meet tu in pai a, ama om ngawl lanin Rachel in a pa ii neisa innkuan pathian milimte nguksak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jacob in Laban theam a, a cia natu vai hesak ngawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in a neisa theampo la in paisan vingveng hi. Ama in Eupharates ngun kaantan in, Gilead mualtung ngam sang manaw hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jacob taina thu ni thum zawkciang Laban tungah kison hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama in a mite samin a mite taw Gilead ngam mual tungah Jacob a phak dong ni sali sung del uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua zanin Laban mang sungah Pathian kilangh in Laban tungah “Bangbang po ahizong Jacob na lauthawn ngawl natu in kidawm ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jacob sia mual tungah ngiaphual saat a, Laban sia a mipuite taw Gilead mualtung ngam sungah ngiaphual saat hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban in Jacob tungah, “Banghangin hong theam a, ngal sungah ngalmat numeite bangin ka tanute taipui ni ziam?
  </para>
  <para style="p">
    <verse number="27" style="v" />Kei hong theam a, kei hong son ngawlin banghang ngelku ni ziam? Hong son hi lete lungdam in lasa a, daalkual khuangnote, tengtongh tumin hong tha tu khu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka tute le ka tanute mangpha thaakin, nong namhsak beak bua hi. Tua in a mawmawthuai ngamtatna ahi hi!
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang kong vawtsiat thei natu in tha nei khi hi, ahizong tu zanin na pa ii Pathian in bangbang po ahizong nang kong lauthawn ngawl natu in kidop tu thu hong pia hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hi bang nong nusiat sia na inn na thet kik tu thintoi mama na hina kong he hi, ahizong ka innkuan pathian milimte banghang ngu nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jacob in, “Kei kung pan na tanute nong lee kik tu ka lau hang hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahizong na pathian milimte hi sung khat pawpo tungah na mu le ama kithatlum tu hi. Hi lai ah ih mite sia ih tetti tu hi, zong in a, nangma neisa pawpo la in,” ci in zo hi. Laban ii pathian milimte Rachel nguk hunlam Jacob in he ngawl hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Laban pai in, Jacob puanbuk sung zong hi; tua zawkciang Leah puanbuk sung le sila numei niite puanbuk sung teng zong a, ahizong a pathian milimte mu ngawl hi. Tuasia ciang Rachel puanbuk sungah pai hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rachel in innkuan milimte ngu a, kalaoh tung tona ip sungah koi in topha hi. Laban in buk sung bup zong a, ahizong mu ngawl hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Rachel in a pa tungah, “Na mai ah hong ding thei ngawl ka hikom topa awng, thin uuk heak in; numei ngeina ka nei laitak hi,” ci hi. Laban in zong a, ahihang a innkuan milimte mu ngawl hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuaciang Jacob a thin uuk hi. “A bang khialna lian vawt khi ziam?” ci a, thin uuk tatakin dongh hi. “A bang thukham ka palsat hu in, bang thu nga a, hong zuizen thei ni ziam?
  </para>
  <para style="p">
    <verse number="37" style="v" />Tu in ka vanh nei theampo tok siat zo ni hi, na neisa na innkuan vanh bang mu ni ziam? Tuasia, hi lai ah na mite le ka mite mu thei tu in hong pusua ta'n, akua maan hi ziam, thukhensak tawng.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nangma kungah tu in kum kul sung kong om a; na tuu le na kealte a ciing om ngawl hi, tuaciang na nganhonte sung pan tuutal khat pawpo ka ne bua hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ngamsate in tuu khat hong matsak simin keima supna vive hi. Kei khialna hi ngawl hi, ci sia a lak tu in na kungah kong paipui ngei bua hi. Sun ahizong zan ahizong a kingute peuma, a taang nong ngen hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tamvei tatak sun nisa le zan khuadap ka thuak hi. Ka mu thei bua hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tuabangin kum kul sung tawntung nang kungah kong om hi. Kum sawm le kum li sung na tanute nii — kum luk sung na ngannote ka nga natu in na ka seam hi. Tua zawk ngawngawn in ka thaman sawmvei nong kheal hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka pate ii Pathian, Abraham le Isaac ii Pathian in kei taw omkhawm buathong le khut hawm nguakin nong hawlkhia zo tu hi. Ahizong Pathian in ka thinngimna le ka nasepna te mu zo a, tu zanin nang tungah thukhenna hong pia hi.”
  </para>
  <para style="p">
    <verse number="43" style="v" />Laban in Jacob tungah, “Hi numeite sia ka tanute hi; a tate keima neisa hi, nganhonte keima neisa hi. A tatakin ci leang hi sungah na mu theampo keima neisa hi. Ahizong ka tanute le a tate ka kep natu in bangma ka vawt thei tu om ngawl ahikom
  </para>
  <para style="p">
    <verse number="44" style="v" />nang taw thukimna khat vawt tu in ka kinging hi. Ih thukimna phaw kik natu in suangtumte ciang tawng,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tua ahiciang Jacob in suangtum khat la a phaw kik natu khansuang in phut hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jacob in a mite suang pawlkhat khawmsak in ciangto hi. Tuaciang a suang cianna hui ah amate an ne uh hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Laban in Jegar Sahadutha ci in min vaw ahihang Jacob in Galeed ci in min pia hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Laban in Jacob tungah, “Hi ih suangcian sia nang le kei atu in phawk sakna hi tu hi,” ci hi. Tua ahiciang tua mun sia Galeed kina hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Laban zongh in, “Eite khat le khat ih kikhen hangin Topa in ei hong mitsuan tahen,” ci hi. Tua ahikom tua mun zongh Mizpah ci in min phuak hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Laban in, “Ka tanute na vawtsia a, ahibuale numei dang na teenpui le kei kong he bua zong Topa in eite hong en nginge ci in, ciamtee ta'n.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hi lai ah ka suang ciante ih kilaklaw ah om hi, hi sungah phawna khansuang om hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hi suangcian le phawna khansuangte ngeal in ih kiciamnate hong phawksak kikte ahi hi. Nangma hong sim tu in hi suangcian kong kaantan ngei buatu a, nangma zongh in keima hong sim tu in hi suangcian ahibuale hi phawna khansuang nong kaantan ngei buatu hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham ii Pathian le Nahor ii Pathian in eite kilaklaw ah thukhen tu hi,” ci lai hi. Tua zawkciang Jacob in a pa Isaac ii biak Pathian min taw hi kamciamna keamcing tu in ciliap huai takin kiciam hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ama in ngan khat ngo a, mual tungah sangaw biakpiakna pia in, an ne tu in a mite sam hi. Amate an a neak zawkciang mual tungah zankhuateak om uh hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />A zing ciang zingtuung in, Laban in a tute le a tanumeite namhin mangpha thaak a, tuaciang nusia in a inn ah cia hi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jacob a papai laitak lampi ah vantunglalang pawlkhat in ama muak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jacob in amate a mu ciang ama in, “Hi sia in Pathian ii ngiaphual hi,” ci hi; tua ahiciang tua mun sia ama in Mahanaim naa hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jacob in Edom ngam a om a suapuipa Esau kungah kamtaite paisak khol hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama in kamtaite tungah: “Na thumaan naseam keima Jacob in, ka topa Esau tungah thu kong puakna panin, Laban kungah ka om a, tu in kong heak kik thei pheang hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keima in khuite, laate, tuute, kealte le silate ka nei hi. Topa awng nangma maipha ka nga tu lamen in hi bangin kam kong vaitha hi,” na ci vun, ci in sawl hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamtaite Jacob kungah hong heak kik ciang amate in, “Na suapuipa Esau kungah ka pai uh a, nangma muak tu in ama hong pai zo hi. Ama in mihing zali nei hi,” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jacob lau in, a thinngim hi. Ama in a mihingte ahizong, a tuute, a kealte, a khuite le a kalaohte ahizong pawl nii in khen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama in, “Esau hong pai in a masa pawl teng hong sim le zong, a dang teng suakta thei tu hi,” ci in ngaisun hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuasia ciang Jacob thungen a, “Ka pu Abraham ii Pathian le ka pa Isaac ii Pathian awng hong ngai ta'n! Topa awng, nangma in kei tungah na ngam na lei le na beete kungah cia kik in, tua hile nang atu na theampo phasak in na ma kong vangsak tu hi, nong ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na naseampa keima sia nong laksa na cikna le na thumaanna taw ka kilawm bua hi. Bangma dang nei ngawlin, ciangkhut khat bek ma taw Jordan ngun ka kaantan a, tuni in hi pawl niite taw in ka cia kik zo hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka suapuipa Esau khut sung pan nong hut natu in thu kong ngen hi. Kei lau khi hi — kote hong sim tu in ama hong pai laitak hi a, numei patang ngawngawn hong thalup siat tu ka lau hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangma in na ma kong vangsak tu a, tuipivaal senneal za in a tam, kuama sim zawk ngawl za dongin suan le paal kong pia tu hi, ci in nong kamciamnate phawk kik in,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tua munah tua zan a ngia zawkciang Jacob in a suapuipa Esau letsong a piak tu in a ngannote sung pan hi bang teng teal hi: keal anu 200 le keal apa 20, tuu anu 200 le tuu apa 20, kalaoh noaisuuk 30 le a note teng, khui anu 40 le khui apa 10, laa anu 20 le apa 10 te ahi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama in nganno teng a pawl a pawlin khen a, hon khat sim a uk tu in a naseamte khat tek koi hi. Ama in amate tungah, “Ka mai ah paikhol tavun a, honkhat le honkhat kilaklaw kihalsak in a nung kizuisak tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama in a masabel naseampa tungah, “Ka suapuipa Esau taw na kisik ciang, ‘Na topa akua ziam? Koisung pai tu nu ziam? Na mai a ngannote akua neisa ziam?’ ci in hong dok ciang,
  </para>
  <para style="p">
    <verse number="18" style="v" />‘Hite sia na naseampa Jacob neisa hi. Ama in hi teng a topa Esau letsong in hong puak hi. Jacob zongh ka nung ma ah om hi,’ ci in zo nanak tavun,” ci in thupia hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in tuabang ma in a niina, a thumna le nganno hon a uk dangte theampo tungah hi bangin thupia hi: “Esau taw na kimu uh ciang tu a bangin ci tu nu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />‘Hi hi, na naseampa Jacob ka nung uh ma ah om hi’ na ci tu uh kisamh hi.” Jacob in, “Ka letsong piak teng taw a thin ka zosak tu a, ama taw ka kimu ciang hong maisak thei tha tu hi,” ci in ngaisun hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in a letsong teng mai ah paikholsak a, ama ahile tua zanin ngiabuk ah taam lai hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua zan Jacob tho in, a zite nii, a zinote nii le a tate sawm le khat taw Jabbok Ngun kaantan uh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amate teng a paisak zawkciang, a neisa theampo zongh kaantansak a,
  </para>
  <para style="p">
    <verse number="24" style="v" />ahizong ama nguak nung sangah taang hi. Tuaciang mi khat hong pai in zingsang khuavak mahiat dong Jacob taw kibuan hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mipa in a zaw ngawlna thu a mu ciang Jacob khealbul suksak a, a khealngu kiloai hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua pa in, “Hong tha ta'n; khua hong vak tu hi,” ci hi. Jacob in, “Thupha nong pia buale kong tha buatu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua pa in, “Na min akua ziam?” ci in dongh hi. “Jacob” ci in ama in zo hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tua pa in, “Na min Jacob hi nawn ngawl tu hi. Nangma in Pathian le mihingte taw na kibuan a, nangma in zo ni hi; tua ahikom na min Israel hi tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jacob in, “Tua le na min hong son ta'n,” ci hi. Ahizong ama in, “Banghangin ka min he nuam ni ziam?” ci in zo hi. Tua zawkciang ama in Jacob thupha pia hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jacob in, “Maitang kisi in Pathian ka mu zo a, ahizong kei hong kihingkhoai lai hi,” ci ahikom ama in tua mun sia Peniel ci in min phuak hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jacob ii Peniel a nusiat laitakin ni suak a, ama a khealbai hi, banghang ziam cile ama a khealngu kiloai hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuni dong ngawngawnin Israel ii suan le paalte in khealbul a, a om sakhaal ne ngawl uh hi, banghang ziam cile hi sakhaal sia Jacob khealbul a kisuksakna mun ahihang hi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jacob in, Esau le a mi zali hong pai a mu ciang ama in a tate teng sia Leah, Rachel le a zinote nii kawmah khenin koi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama in a zinote le a tate teng masasak a, tua zawkciang Leah le a tate, a khakbel in Rachel le Joseph tonsak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jacob sia amate mai ah pai a, a suapuipa kung a thet tu ciang salivei lei ah kun hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahizong Esau sia ama muak tu in hong tai a, ama koai in namh hi. Amate kap khawm hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Esau in a kiim a paam a et ciang numeite le patangte mu a, “Nang taw a om hi mihingte a kuate ziam?” ci in dongh hi. Jacob in, “Hite sia Pathian ii a phatna hangin keima hong piak ka tate hi topa awng,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua zawkciang a zinote le a tate teng pai in kun hi;
  </para>
  <para style="p">
    <verse number="7" style="v" />tua zawkciang Leah le a tate teng pai in kun a, a khakbel in Joseph le Rachel pai in kun uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esau in, “Ka kisik puisa pawldang sia bangbangziam? Bang cinopna ahi ziam?” ci in dongh hi. Jacob in, “Tuate sia na mai kong etna hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahizong Esau in, “A kicing nei ing, suapui awng, na nei teng keam po ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jacob in, “Hi ngawl hi, hesuakna taw, na maipha a nga ka hile ka letsong hong saang ta'n. Tu in kei hong pawlvawt mama zo na hikom na maitang kong mu sia, Pathian maitang mu bang ka hi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang atu kong ken hi letsong sia hesuakna taw hong saang ta'n; Pathian in kei tungah hong thuthiam a, ka taangsap theampo hong pia hi,” ci hi. A saan mateng Jacob in sonpui top hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Esau in, “Kithoai vun a, pai tek tawng. Na mai ah kei pai tu khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jacob in, “Patangte thazawm a, tuute, ngannote le a note atu ka ngaisut a kul sia na he hi. Amate hawlngawp thong leng ni khat sung ngawngawn zong thi siat tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hesuakna taw paikhol ta'n, ngannote le patangte pai zawk babangin Edom ah kong phak dong dadam in kong zui tu uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Esau in, “Tua ahile ka mite pawlkhat nang taw ton tu in hong nusiat tong,” ci hi. Ahizong Jacob in, “Tuabang kisamh bo, na maipha ka nga tu uuk bek khi hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua ahiciang Esau sia, Edom ah cia kik tu in tua ni in kipan hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahizong Jacob in Sukkoth ah pai a, tua munah ama atu inn khat le ngannote atu thaampheangte sa hi. Tua ahikom tua mun sia Sukkoth kici hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jacob sia Mesopotamia pan hong heak kik ciang Canaan ngam Shechem khuapi ciidam takin hong theng a, tua khuapi hui lo khat sungah ngiaphual saat hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in Shechem ii pa Hamor suan le paalte tung pan tua lo ii khen khat sia ngunntang zakhat taw lei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama in tua munah biaknatau khat ciang in, a min El, Israel ii Pathian, ci in phuak hi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni khat ni in Jacob le Leah te ii tanu Dinah sia Canaan numei pawlkhat kungah haw tu in pai hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tua ngam ukpi, Hiv te Hamor ii tapa Shechem in ama a mu ciang manin buanin khialpui hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in tua numei sia deihuai mama sa a, it ahikom tua nu ii a it natu in zongh hanciam hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama in a pa tungah, “Hi numei ka zi tu in hong puisak ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jacob in a tanu Dinah ii minsiatna thu za ahihang a tapate duisung ah ngan cingin om ahikom amate hong cia mateng bangma vawt ngawl hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shechem ii pa Hamor sia Jacob taw thu son tu in a pai le,
  </para>
  <para style="p">
    <verse number="7" style="v" />Jacob ii tapate duisung pan hong cia taw kisi hi. Amate in a thu teng a zaak ciangin Shechem ii hi bang tengin ngamta a, Jacob ii tanu a buanna taw in Israel mite a zawnsak manin thuak zo ngawl a, amate thin uuk ngawp uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hamor in Jacob tungah, “Ka tapa Shechem sia na tanu taw ki it zo hi; nong hesuakna in kiteangsak tawng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ko mite le no mite kiteen natu in thukimna khat ih vawt tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuasia ciang ko ngam hi sungah ko taw nong om thei tu uh a; na teen nopna mun po ah teangin, na uuk bangin sum vawtin, nei le lamh na heang thei tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua zawkciang Shechem in Dinah ii pa le a suapuipate tungah, “Kei maipha hong pia tavun, na dei pawpo kong pia tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bang letsong teng dei nu ziam hong son tavun; mo man tu na deiza po hong ngen tavun; hong kiteangsak tu hi pole uhte nong nget zaza kong pia tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shechem in, a suapuinu uh Dinah min siasak zo ahikom Jacob ii tapate in Shechem le a pa Hamor kam a zona ah theambawl uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate in Shechem tungah, “Vunteap at ngawl khat tungah ka suapuinu kong teangsak thei buatu uh hi; hong teangsak hi le ung ko atu in min siatna khat hi tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koma taw na kiban natu uh in, pa theampo vunteap na at uh ciang bekin thukim thei tu khu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua zawkciang tuabang a kiteen tu thukim tu khu hi. Note sungah kong teang tu uh a, ci khat sa khat ih suak tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahizong ko ii ci teng hong saang ngawlin vunteap na at nuam bua uh le, ka suapuinu la in ka ciapui tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hamor le a tapa Shechem in hi thu teng pha tuak sa a,
  </para>
  <para style="p">
    <verse number="19" style="v" />tangvalpa in hai ngawlin a ci bangin a vunteap at paih hi, banghang ziam cile Jacob ii tanu a dei hang ahi hi. Shechem sia amate innkuan sungah a thupibel ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hamor le a tapa Shechem in taangpi kikhopna khuapi kongpi ah pai a, a khuapuite tungah thu a sonna panin:
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hi mite sia ih lawmte hi a, ih ngam sungah eima taw teang khawmin a ukna po ah paisak tawng. Ih ngam zongh lian a, amate atu taw in kicing lel hi. A tanute ih teenpui tu a, ei a te zongh ih pia tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahihang hi mihingte ei sungah hong teen tu a thukim thei natu le eima taw ci khat sa khat a sua natu in amate vunteap a ki at bangin ei, pa a minpiang vunteap ih at kulsak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A nganno teng le a neisa dang theampo ei aa hi lel tu ngawl ziam? Tua ahiciang thukim in amate ei sungah teangsak tawng,” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hamor le Shechem ii son thu teng a khuapuite theampo in lungkim pui a, pa theampo vunteap ki at siat hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni thum zawkciang amate vunteap atna meima nat saanin a om laitak, Jacob tapa teng sung pan niite, Dinah ii suapuipate ahi Simeon le Levi te in a namsau tek la in, muanmawk khol ngawlin khuapi sungah tum a, pasal theampo thatlum siat uh hi,
  </para>
  <para style="p">
    <verse number="26" style="v" />Hamor le a tapa Shechem zongh kihel hi. Tua zawkciang Shechem inn pan Dinah la in ciapui uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuabang a thalup zawkciang Jacob tapa dangte in, a suapuinu a kiminsiatsak huvau in a phula tu in a khua phuul uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amate in a tuuhonte, a khuite, a laate, khua sung le lo sung a om na theampo laaksak siat uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amate in na manpha theampo la in, numei patang theampo man a, inn sung vanh theampo pua in ciapui uh hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jacob in Simeon le Levi tungah, “Kei thinngim haksatna sungah hong then zo nu hi; tu in Canaan te, Periz te le mi dang theampo in kei hong ngaimaw tu hi. Kei la mihing tam nei ngawl a; amate teng kikop in kei hong sim thong le ih innkuan bup in hong mon tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahizong amate in, “Ka suapuinu uh sia pumpi kizuak khat bangin a kivawt tu sia suaksak thei mama ngawl khu hi,” ci in zo uh hi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian in Jacob tungah, “Bethel ah pai paih ta'n a, tua munah teang ta'n. Na suapuipa Esau kung pan na tai lai in, nang tungah hong kilangh Pathian, keima atu in tua munah biaknatau khat sa in,” ci hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tua ahiciang Jacob in a innkuan puite le a ompui teng tungah, “Ngamdang pathian milim na nei te vawk vun a; noma le noma kithiansua in, puanthiang silh vun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hi mun nusia in Bethel ah ih pai tu hi, tua munah ngim ka nga hunin hong hu a, ka paina sa theampo ah hong ompui Pathian atu in biaknatau khat ka sa tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua ahiciang amate in a ngamdang pathian milim a nei theampo le a baa lai bilbaate zongh Jacob tungah pia uh hi. Jacob in Shechem khuahui oak thingkung sia nuai ah tua teng phum hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jacob le a tapate vaiding tu a kipat lai in, khua naina tengah a teang mite tungah launa lian tung ahikom khua mite in amate del ngawl uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jacob sia a mihingte theampo taw Canaan ngam sung, tu in Bethel a kici Luz khua theng uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama in tua munah biaknatau khat sa hi, a suapuipa kung pan a tai lai in ama kungah Pathian a kilangh na mun ahikom tua mun sia Bethel ii Pathian min tapsakin Bethel ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rebecca a omh nu Deborah thi a, Bethel ii thangsang oak thingkung nuai ah kiphum hi. Tua ahikom, “Kaana Oak Thingkung” ci in min kiphuak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mesopotamia pan Jacob hong heak kik ciang ama tungah Pathian kilangh kik a, thupha pia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian in ama tungah, “Na min Jacob hi, ahizong tu pan kipan Israel hi tu hi,” ci hi. Tuabangin, Pathian in ama min Israel phuak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuaciang Pathian in ama tungah, “Keima in Vaanglianbelpa Pathian ka hi hi. Ta tam mama nei ta'n. Minamte nang sung pan hong piangsuk tu a, kumpite taanghpupi na hi tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham le Isaac ka piak ngam le lei sia nangma kong pia tu a, nang nung pan na suan na paalte tung zongh ah ka pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tua zawkciang Pathian in ama nusia hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian ii ama a paupuina tua munah Jacob in khansuang khat phut a, tua khansuang sia sapittui le olive thau buakna taw in aapna vawt hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama in tua mun sia Bethel ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jacob le a innkuanpuite Bethel pan ding uh a, Ephrath khua a thet ma hiatin Rachel a nau nei tu hun tung a, nautun zo in ngim mama hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama nautut a haksatbel hun ciang nausuaksak syanu in ama tungah, “Rachel awng, lau om nawn bo; tapa dang khat nei ni hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahizong a nu thi dektak zo hi, a thi ma a hui a tat tu ciang a tapa min Benoni ci in phuak hi, ahizong a pa in a min Benjamin phuak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rachel a thi ciang Eprath paina lampi hui, tu in Bethlehem a kici na munah kiphum hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jacob in tua munah khansuang khat phut a, tuasia tuni dongin Rachel thaanmual tepteena ahi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jacob kikhiin kik a, Eder tausaang langkhat ah a ngiaphual saat hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua ngam ah Jacob a teen laitakin, Reuben in a pa zinote khat ahi Bilhah taw omkhawm hi; Jacob in tua thu za a, thin uuk mama hi. Jacob in tapa sawm le nii nei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leah ii tapate sia Reuben (Jacob ii tapa lianbel), Simeon, Levi, Judah, Issachar le Zebulun ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rachel ii a tapate sia Joseph le Benjamin ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rachel sila Bilhah ii a tapate sia Dan le Naphtali ahi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Leah sila Zilpah ii tapate sia Gad le Asher ahi hi; hi tapate teng sia Mesopotamia ah suak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham le Isaac teenna ahi Hebron khua nai Mamre khua ah a om a pa Isaac kungah Jacob pai hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isaac kum za le sawmliat nungta in,
  </para>
  <para style="p">
    <verse number="29" style="v" />a huai tatakin thi hi; ama sia a tate Esau le Jacob in vui hi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hi mite sia Edom zongh a kici, Esau ii suan le paal te ahi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esau in Canaan numeite teenpui a: tuate sia Hit te Elon ii tanu Adah; Hiv te Zibeon tapa Anah ii tanu Oholibamah
  </para>
  <para style="p">
    <verse number="3" style="v" />le Nebaioth ii suapuinu, le Ishmael ii a tanu Basemath ahi uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Adah in ta Eliphaz nei a; Basemath in ta Reuel nei hi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Oholibamah in ta Jeush, Jalam le Korah nei hi. Hi teng sia Canaan ngamsung pan a nei Esau ii tapate ahi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua zawkciang Esau in a zite, a tapate, a tanute le a inn sung a teang mihingte theampo, a nganno theampo le Canaan ngam sungah a nga a neisa theampo la in a suapuipa Jacob kung pan ngamdang khat zuan khawm tek hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama le Jacob te kivaak kitaa natu in a teenna ngam le lei kicing zo ngawl ahi hu in paisan hi; amate ii neisa nganno tam leih ahikom teang khawm thei nawn ngawl uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua ahikom Edom mualtung ngam ah Esau teang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hite sia Edom te ii taanghpupi Esau suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Esau in a zi Adah taw tapa khat Eliphaz nei a, Eliphaz in tapa nga nei hi: tuate sia Teman, Omar, Zepho, Gatam le Kenaz ahi hi. Tuaciang a zi dang Timna taw tapa Amalek neithua hi. Esau in a zi Basemath taw Reuel nei a, Reuel in tapa li nei hi: tuate sia Nahath, Zerah, Shammah le Mizzah ahi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Esau in Zibeon tapa Anah ii tanu Oholibamah taw tapa thum nei a: Jeush, Jalam le Korah ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Esau suante sia hi minamte ahi uh hi. Esau ii ta masabel Eliphaz sia a nuai a minamte ii pianna taanghpupi ahi hi. Tua minamte sia Teman, Omar, Zepho, Kenaz,
  </para>
  <para style="p">
    <verse number="16" style="v" />Korah, Gatam le Amalek te ahi hi. Hite sia Esau ii zi Adah ii suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Esau ii tapa Reuel sia a nuai a minamte ii pianna taanghpupi ahi hi. Tuate sia Nahath, Zerah, Shammah le Mizzah te ahi hi. Hite sia Esau ii zi Basemath ii suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anah ii tanu, a zi Oholibamah taw a hin Esau ii suan le paalte sia a nuai a minamte hi a: Jeush, Jalam le Korah te ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hi minamte theampo sia Esau ii suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Edom ngam sungah a teang ciilte sia a minam in kikhen a, tuate ii pianna sia a nuai a bangin Hor te Seir ii suan le paalte taw kinguizui hi: tuate sia Lota'n, Shobal, Zibeon, Anah, Dishon, Ezer le Dishan ahi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lotan sia Hori le Heman beete ii pianna taanghpupi ahi hi. (Lotan in Timna a kici suapuinumei khat nei hi.)
  </para>
  <para style="p">
    <verse number="23" style="v" />Shobal sia Alvan, Manahath, Ebal, Shepho le Onam beete ii pianna taanghpupi ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zibeon in tapa nii nei a, Aiah le Anah ahi hi. (Anah sia duisung ngampa ah a pa laate a cin lai in, ciktui sa te a mu pa ahi hi.)
  </para>
  <para style="p">
    <verse number="25" style="v" />Anah sia Dishon ii pa hi a, Hemdan, Eshban, Ithran le Cheran te ii taanghpupi ahi hi. Anah zongh in Oholibamah a kici ta numei khat nei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ezer sia Bilhan, Zaavan le Akan beete ii pianna taanghpupi ahi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dishan sia, Uz le Aran bee le phungte pianna taanghpupi ahi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Edom ngamsung Hor minamte sia: Lota'n, Shobal, Zibeon, Anah, Dishon, Ezer le Dishan te ahi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Israel ngam sungah kumpi khat zongh a om ma in a nuai a kumpite in a kizomin Edom ngam uk uh hi: tuate sia Dinhabah khua pan Beor tapa Bela Bozrah khua pan Zerah tapa Jobab Teman ngamkhen pan Husham Avith khua pan Bedad tapa Hadad (Ama in Moab ngamsung a kisimna ah Midian te zo hi.) Masrekah khua pan Samlah Rehoboth-Ngun-tung-khua pan Shaul Achbor ii tapa Baal Hanan Pau khua pan Hadad (A zi sia Mehetabel hi a, Matred tanu, Mezahab ii tunu ahi hi.)
  </para>
  <para style="p">
    <verse number="40" style="v" />Esau sia a nuai a Edom minamte ii pianna taanghpupi hi a: tuate sia, Timna, Alvah, Jetheth, Oholibamah, Elah, Pinon, Kenaz, Teman, Mibzar, Magdiel le Iram ahi hi. Hi minamte teenna, a mun a ngam tek sia minam min zui in kilo hi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jacob sia a pa teenna ngei Canaan ngam ah teang suak hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />hisia sia Jacob innkuan taanghthu ahi hi. Joseph sia tangvalno kum sawm le kum sali pha a, a pa zinote ahi Bilhah le Zilpah ii tapate taw tuu le kealte cing khawm hi. Ama in a suapuite ngamtat siatna teng a pa tungah ko hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jacob in a tapa dang teng sangin Joseph it zaw hi, banghang ziam cile a huai zawkciang a nei tapa ahi hi. Ama in puantual baansau khat Joseph atu in khuisak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A pa in amate sang in Joseph a it zawkna thu a suapuite in a mu uh ciang a suapuipa ngaimaw mama a, pha takin paupui ngawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zan khat Joseph in mang khat man a, tua a mangmat teng a suapuipate tungah a son ciang amate in ngaimaw seseam uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in, “Ka mangmat sia hong ngai tavun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ei teng lo sungah zungtaang vawngte sawm in ih om a, keima taangvawng hong tho in dingtang hi. Keima taangvawng sia noma taangvawngte in kiim uumin a kun uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A suapuipate in ama tungah, “Nang kumpi khat suakin kote hong uk tu in kingaisun ni ziam?” ci in dongh uh hi. Ama ii mangmatte hu le a thuson teng hu in amate in ngaimaw seseam uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuasia zawkciang Joseph in mang dangkhat man leleau in a suapuipate tungah, “Mang dangkhat ka man a, tua ka mang sungah ni, tha le aksi sawm le khat te in keima hong kunsuk ka mu hi,” ci in son hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in a pa tungah zongh a mang son a, a pa in: “Tuasia bangbang mang hi thong ziam? Na nu, na suapuipate le kei, na mai ah pai in hong kun tu in ngaisun ni ziam?” ci in teih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Joseph ii suapuipate in ama eang uh hi, ahizong a pa in hi thute theampo a thinsung ah ngaisun nginge hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni khat ni in Joseph ii suapuipate a pa tuuhon cing tu in Shechem ah a pai zawkciang,
  </para>
  <para style="p">
    <verse number="13" style="v" />Jacob in Joseph tungah, “Na suapuite tuu cinna Shechem ah pai lete kong oai hi,” ci hi. Joseph in, “Kithoai zo ing,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pa in ama tungah, “Va pai ta'n a, na suapuite a ngammuang na ziam, a nganhonte a dam na ziam va en ta'n; tua zawkciang hong cia kikin hong son ta'n,” ci hi. Tua ahikom a pa in Hebron Kuam pan pai tu in ama sawl hi. Joseph sia Shechem theng a,
  </para>
  <para style="p">
    <verse number="15" style="v" />ngam sungah a va kawkoai sia pasal khat in a mu ciang, “Bang zong ni ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama in “A tuuhon a cing ka suapuite ka zong hi. Amate omna mun nong son thei tu ziam?,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua pa in, “Amate hi mun nusia zo hi. Dothan ah ka pai tu uh hi, a ci ka za hi,” ci hi. Tua ahiciang Joseph in a suapuite nungzui in Dothan ah amate mu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amate in a ngal khat ah Joseph mu a, amate kung a thet ma in, Joseph thalup tu in vaihawm a thukhensat uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amate khat le khat, “Hi sungah mangmanpa hong pai hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tu in hong pai tavun, ama thatin tuikhuk kang sa khat sungah a luang vawk tawng. Ngamsa khat in ama petlum hi, ih ci thei hi. Tuasia ciang a mangmatte bang a suak ziam ih en tu hi,” kici uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Reuben in a thuson teng a zaak ciang Joseph a suatak natu hanciam hi. Reuben in, “Joseph that bua tawng,
  </para>
  <para style="p">
    <verse number="22" style="v" />duisung ah a om hi tuikhuk sungah ama khia vun ahizong ama liamsua heak vun,” ci hi. Ama suatakin a pa kungah puak kik nuam ahikom ama in tubangin a ci ahi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A suapuite kungah Joseph hong thet ciang ama silh lai a puantual baansau laaikeaksak uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaciang amate in Joseph manin tuikhuk kang sa sungah khia uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />An a neak laitak Gilead pan Egypt ah khual a haw Ishmael te honkhat thakhat thu in mu uh hi. A kalaohte sia hel namtui le thingnaai te puasak uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah in a suapuite tungah, “Ih suapuipa that a tua thu ih ip hu in a bang meetna nga tu hi ziam?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hi Ishmael te tungah zuak heu tawng. Tuabang hi leang ama bangma law kul ngawl tu hi; tua bek dom ngawlin ama sia ih suapuipa hi a, eima chi le sa tatak ahi hi,” ci hi. A suapuite zongh lungkim a,
  </para>
  <para style="p">
    <verse number="28" style="v" />Midian te sum vawt pawlkhat hong thet nai ciang a suapuite in Joseph tuikhuk sung pan kaito kikin, Ishmael te tungah ngunn dangka kul taw zuak a, amate in Egypt ah paipui uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Reuben hong theng kik a, tuikhuk sungah Joseph a mu ngawl ciang khuangai in a puan balkeak hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A suapuite kungah ama heak kikin, “Tangvalpa om ngawl hi! Bang law tu khi ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuaciang amate in keal khat ngo a, tua chi sungah Joseph puantual pap hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amate in tua puan la a ciapui in a pa tungah, “Hi puan mu ung. Na tapa puan ahi ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />A pa in tua puan tel a, “Hi hi, ama puan hi! Ngamsa khat in thatlum zo hi. Ka tapa Joseph kibalneen zo hi!” ci hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jacob khuangai in a puan balkeak a, khau-ip puan silh hi. A tapa hangin khuangai a ngei hialma kaikut hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />A tapate le a tanute theampo in ama heeneam tu in hong pai hi, ahizong heenep tu nuam ngawlin, “Mithi khua ah ka tapa atu khuangai sa in ka paisuk tu hi,” ci hi. Tua ahiciang a tapa Joseph hangin ama khuangai top hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tua hun sungin Egypt ngam ah Midian te in Joseph sia Potiphar tungah zuak uh hi, ama sia kumpipa ii ulian khat hi a, kumpi inncing ngalkap hon ukpa ahi hi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua hun khawng in Judah sia a suapuipate nusia a, Adullam khua mi Hirah a kici pa taw teang khawm hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tualai ah Judah in Canaan mi Shua ii tanu ngaknu khat taw kimu hi. Ama in tua nu teenpui a,
  </para>
  <para style="p">
    <verse number="3" style="v" />tapa khat nei in a min Er phuak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama ngai kik a, tapa dangkhat nei in a min Onan phuak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tapa khat nei kik a, a min Shelah phuak hi. A tapa a sua laitakin Judah sia Achzib ah om hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah in a tapaciil Er atu in Tamar kici zi khat puisak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Er ngamtat pha ngawl a, Topa lungkimsak ngawl ahikom Topa in ama thatlum hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua zawkciang Judah in Er ii suapuipa Onan tungah, “Pai in, na suapuipa zi meingong nu taw lumkhawm ta'n. Na suapuipa in suan le paal a nei thei natu in, a pasal suapui na hi bangma na vaipuak tu teng khuangkhim ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahizong Onan in a tate sia ama aa ahi ngawl tu he ahikom a upa zi taw a omkhop simin, a suapuipa atu ta kuama a pian ngawl natu in a bawtui lei ah taaksak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A ngamtatna Topa lungkim ngawlin Topa in ama zongh thatlum hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuasia ciang Judah in a monu Tamar tungah, “Na nungsang na pa inn zuan kik ta'n a, ka tapa Shelah a tangval mateng meingong in va om phot ta'n,” ci hi. Shelah zongh a suapuite bangma in a kithalup tu a lau hangin Judah in hi bangin a ci ahi hi. Tua ahiciang Tamar a nungsang zuan hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua zawk hun khat ciang Judah ii zi thi hi. A khuangai hun a ven ciang, ama sia Adullam khua mi a lawmpa Hirah taw a tuute mul meetna mun Timnah ah pai uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi khat in Tamar tungah na topasal a tuute mul meet tu in Timnah ah pai hi, ci in son hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuasia ciang ama silh lai a meingong puante laih a, maituamna puanpaa khat taw a mai tuamin Timnah khua paina lampi tung, Enaim khua sung tumna ah to hi. Tu in Judah ii tapa nobel Shelah sia tangval zo ahi hunlam Tamar in he hi, ahizong ama sia Shelah taw kiteangsak ngawl lai hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Judah in Tamar a mu ciang ama sia a mai tuam ahikom numei pumpi kizuakte khat in ngaisun hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lampi hui ama omna ah pai in, “Pha hi, bangza ngen ni ziam?” ci hi. (Tua nu sia a monu ahi hunlam ama in he ngawl hi.) Tamar in, “Bang hong pia tu ni ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama in, “Ka nganhon sung pan kealno khat kong puak tu hi,” ci in zo hi. Tamar in, “Tua keal nong puak dong kei tungah kiciamna kho khat nong pia tu ahile thukim tu khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in, “Kiciamna bang hong pia tu khi ziam?” ci in dongh hi. Tamar in, “Na min tupna le a khau, na khut sungah a om na ciangkhut,” ci in zo hi. Ama in tua teng pia hi. Tua zawkciang amate omkhawm a, ama naupaai hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tamar inn ah cia in, a maituamna puan hawkin, a meingong puan teng silh kik hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Judah in a kiciamna vanh teng tan kik tu in keal khat taw a lawmpa Hirah paisak a, ahizong Hirah in tua nu mu zo ngawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in Enaim ah pasal pawlkhat dongh a, “Hi sung lamhui ah a om pumpi kizuak nu sia koi sungah om ziam?” ci hi. Amate in, “Hi sungah pumpi kizuak numei om ngeingawl hi,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama cia kikin Judah tungah, “Ama ka mu zo bua hi. Tua munah pasalte in hi sungah pumpi kizuak numei om ngeingawl hi, hong ci hi,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Judah in, “Vanhte ama in keamsak lel tawng, Mite in nuisansak nuam bua hing. A man piak ka sawm hang ama mu zo ngawl ni hi,” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tha thum bang zawkciang mihing khat in Judah tungah, “Na monu Tamar sia pumpi kizuak khat bang ngamta a, tu in ama naupaai hi,” ci in son hi. Judah in, “Ama paipui vun a, hallum tavun,” ci in thupia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama a kipaipui ciang, a topasal tungah kam vaitha a: “Hi vanh teng a neipa taw naupaai khi hi. Hi khau kivaw min tupna le hi ciangkhutte — en hen, akua neisa ziam?,” ci hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah in tua vanhte ciamtee a, “Ama maan hi. Ka tapa Shelah taw ka teensak tu hi napi ka teangsak bua hi — ama atu ka vaipuak a lel ka hi hi,” ci hi. Tuaciang Judah in ama omkhop pui kik ngei nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nausua hun a thet ciang naupeang a nei tu sia kimu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nausuak tu a tut laitak naute khat in a baan kilawtsak hi; nausuaksak syanu in tua baan zamhin khausan khat a khut tung khii a, “Hisia suak masa hi,” ci hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahizong a khut dawk kik a tuaciang a suapuipa hong suak masa hi. Tuasia ciang nausuaksak syanu in, “Hi bangin na sua natu lampi nangma in hong tawm ni hi,” ci hi. Tua ahikom ama min Perez kiphuak hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tua zawkciang a khut tung a khausan taw a suapuipa hong suak a, ama min Zerah kiphuak hi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ishmael mite in Egypt ah Joseph paipui a, kumpipa ii uliante sung pan khat ahi, kumpi inncing ngalkap bupa Potiphar tungah zuak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Topa in Joseph panpui a, nasep zosak hi. Ama sia Egypt mi a topa inn ah teang a,
  </para>
  <para style="p">
    <verse number="3" style="v" />Topa in Joseph panpui ahikom a nasepna theampo ah a zawsakna thu a topa in mu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama tungah Potiphar lungkim a, ama aituam naseam tu in koi hi; tua ahikom a inn le a neisa theampo uksak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tua hun a kipan Joseph hangin Egypt mi Potiphar te innkuan, a inn sung le a lo sungah a neisa theampo Topa in thupha pia hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Potiphar in a na theampo Joseph et tu in aap siat a, a anneak tu ngawl buang bangma dang thinbot in nei ngawl hi. Joseph sia a khanpha in a mealhoi a,
  </para>
  <para style="p">
    <verse number="7" style="v" />tawmvei zawkciang a topa zi in Joseph lungngul in luppui tu in kunh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama in nial a, “En in, hi sungah keima om ka hikom ka topa in inn sungah bangma thintoi ngawl hi. A neisa theampo ka et tu in hong aap siat hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hi inn sungah ama taw kibangin a thu neiza ma ka nei a, nangma simngawl buang kei atu in khaam hong nei ngawl hi. Tua ahiciang hi bang ngamtat pha ngawl vawtin Pathian tungah maw thei tu khi ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A topa zi in Joseph luppui tu ni khat zawk ni khat in kunh hi napi ama in luppui nuam ngawl hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahizong ni khat ni in Joseph sia inn sungah ama ii na seam tu in a tum ciang tualai ah inn naseamte kuama om ngawl hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A tonu in Joseph puantual pan man a, “Kei taw lumkhawm tawng,” ci hi. Ahizong a tonu khut sungah a puantual nusiat a, suakta in a pua sangah tai hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A tonu in a puantual nusia in inn pan a tai a mu ciang,
  </para>
  <para style="p">
    <verse number="14" style="v" />ama in a inn naseamte samin, “Hi sia en vun! Ka pasal ii inn ah hong ciapui, hi Hebrew sia pa in ei hong zawnsak vawt hi. Ama ka inndoi sungah hong tum a, buanin khialpui tu in hong kipan hi, ahizong a nging theiza in ka cik-au hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama in ka cik-au a zaak ciang a puantual kei kungah nusia in doipua ah tai hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph ii topa, inn ah hong cia dong ama in Joseph puantual keam hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuaciang a pasal tungah ama in thupiang a son ngei teng ma son a: “Hi lai ah nong ciapui Hebrew sila pa in ka inndoi sungah tumin, kei hong zawnsak vawt hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahizong ka cik-au ciang a puantual ka kungah nusia in doipua ah tai hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Joseph ii topa a thin uuk mama a,
  </para>
  <para style="p">
    <verse number="20" style="v" />Joseph mansak in kumpipa ii thongtaakte a koina thong sungah khum hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahihang thong ukpa ii Joseph tungah a lungkim natu in Topa in Joseph panpui a, thupha pia hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama in Joseph sia thongtaak dang theampo uk tu in koi a, thong sungah nasep theampo vaipuak neisak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph ii nasepnate thong ukpa ii et kik kul ngawl hi, banghang ziam cile Topa in Joseph panpui a, a nasepna theampo zosak hi.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua zawk hun khat ciangin Egypt kumpipa ii sapittui piapa le anluum empipa in kumpipa thin uuksak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hi naseam ulian niite tungah kumpipa thin uuk in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Joseph kikhumna mun, kumpi inncing ngalkap bupa inn sungah thongtaaksak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amate khuangeipi ma thong sungah om a, tua ngalkap bupa in Joseph sia amate naseamin koi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zan khat tua thong sungah sapittui piapa le anluum empipa in mang khat veve man a, a mangte in khiakna tuam tetek nei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zingsang in amate kungah Joseph a pai ciang thinngim a, a om sia mu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joseph in amate tungah “Banghangin tuni in na thin uh ngim tuak mama ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amate in, “Mang khat veve ka man uh a, tua mangte ii khiakna hong son thei tu hi sungah kuama dang om ngawl hi,” ci in zo hi. Joseph in, “Mang khiak theina hong pia sia Pathian hi, na mang uh hong son tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuasia ciang sapittui piapa in, “Ka mang sungah sapitkung khat ka mai ah om a,
  </para>
  <para style="p">
    <verse number="10" style="v" />tua tungah sapitbaak thum om hi. A teete a meen po ciang hong mom in sapitngate min hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kumpipa hai ka toai a; sapitngate ka lo a, hai sungah suukin ama ka pia hi,” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph in, “A khiakna hi bang hi: sapitbaak thum sia ni thum hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ni thum sungin kumpipa in nang hong suatak tu a, hong maisakin na nasep ngei hong pia kik tu hi. Ama sapittui piapa na hi lai a, na sep ngei bangma in a hai na pia tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahizong na dau a pai ciang nong hesuakna in kei hong phawk kik ta'n a, hi thongsung pan ka suatak thei natu in kumpipa tungah ka thu teng hesuakna taw hong sonsak ta'n.
  </para>
  <para style="p">
    <verse number="15" style="v" />A tatakin ci leang Hebrew ngam panin kei hong kiman hi a, hi lai Egypt ngam zongh ah thong sung hong kikhum natu in bangma ka vawt bua hi” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anluum empipa in sapittui piapa ii mang a khiakna sia thupha hi ci in a mu ciang ama in Joseph tungah, “Kei zongh mang khat man khi hi; anluum law thum thuapin ka lu tungah ka pua hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A tungbel law sungah kumpipa atu in moh namcin om a, vacimte in tuate ne uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph in, “A khiakna hi bang hi: law thumte sia ni thum ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni thum sungin kumpipa in nang hong pusua tu a, — tuaciang na ngawng hong tan tu hi! Tua zawkciang ama in na luang khuam khat tungah hong khai tu a, vacimte in na sa ne tu uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ni thum zawkciang kumpipa suani in, ama in a uliante theampo atu in poai khat khaam a; sapittui piapa le anluum empipa sia ama in tha in, a uliante mai ah paipui hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in sapittui piapa sia a nasep ngei ma pia kik a,
  </para>
  <para style="p">
    <verse number="22" style="v" />ahizong anluum empipa sia thatlum hi. Joseph son bang tatakin hi teng theampo piang siat hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahizong sapittui piapa in Joseph phawk ngei nawn ngawl hi — ama ii thu theampo mangil cip hi.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua zawk kum nii zawkciang Egypt kumpipa in mang man a, a mang sungah Nile ngunhui ah ding a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nile ngun sung panin khuipui a thau, a zol sali pusuak to in, lopa ne tu kipan uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tua zawkciang a ngawm, a ngu nguak a om khuipui salite pusuak to hi. Tua teng hong pai a, Nile ngunhui a khuipui dangte kungah dingin,
  </para>
  <para style="p">
    <verse number="4" style="v" />a ngawm khuipui salite in a thau khuipui salite netum uh hi. Tuasia ciang kumpipa khanglo hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama mu kikin mang dang khat man hi. A hui bup taknei in a min, taanghui sali sia kung khat tung pan hui hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuaciang senneal vui in theapsak in a ngeau singseng taanghui dang sali hong po hi,
  </para>
  <para style="p">
    <verse number="7" style="v" />a theap taanghui teng in a tak nei taanghui teng valhtum hi. Kumpipa khanglo a, mang maman ahi sia tel hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zingsang ciang ama thinngim ahikom mitbum thiamte le Egypt mipil miciim theampo samsak hi. Ama in amate tungah a mang teng son a, ahizong kuama in a mang khiaksak thei ngawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuasia ciang sapittui pia pa in kumpipa tungah, “Tuni in ka khialna kong pualaak kul hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kei le anluum empipa tungah na thin uuk a, kumpi inncing ngalkap bupa inn sung thong sungah nong khum hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zan khat ka nii in mang khat veve ka man uh a, ka mangte uh in khiakna tuatuam nei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua munah kumpi inncing ngalkap bupa ii silapa, Hebrew tangvalno khat kote taw omkhawm hi. Ama tungah koma mangte ka son uh ciang a khiakna hong son hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama son bang tatakin piang a: kei sia ka nasep nong pia kik a, ahizong anluum empipa sia na thatlum hi,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kumpipa in Joseph samsak a, thong sung pan thakhat ma in hong kipaipui hi. Joseph a mul meet thiangin, a puante a laih zawkciang kumpipa omna ah pai hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kumpipa in ama tungah, “Mang khat ka man a, kuama in a khiakna hong son thei ngawl hi, nang sia mangkhia thei ci in hong kison hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph in, “Kumpipa awng, kei hi thei hi ngawl hi, ahizong Pathian in mang khiakna maan hong son tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kumpipa in, “Ka mang sungah Nile ngunhui ah ka ding a,
  </para>
  <para style="p">
    <verse number="18" style="v" />limci in a thau khuipui sali, ngun sung pan hong pusuak to a, lohingte ne tu in kipan hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tua zawkciang a ngawm a ngu nguak a om a dang khuipui sali hong pusuak to hi. Tuate sia Egypt ngam sungah ka mu ngei khuipui zawngkhal belte ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khuipui ngawmte in khuipui thaute netum a,
  </para>
  <para style="p">
    <verse number="21" style="v" />ahizong kuama in a neak hunlam he ngawl tu hi, banghang ziam cile amate sia nidang bangma in ngawm veve hi. Tuasia ciang ka khanglo hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mang ka man kik a, taangkung khat tung pan a hui bup taknei in a min taanghui salite ka mu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuaciang senneal vui in theapsakin a ngeau singseng taanghui sali hong po a,
  </para>
  <para style="p">
    <verse number="24" style="v" />tuaciang a theap taanghuite in a taknei taanghuite valhtum hi. Mitbum thiamte tungah ka mang ka son a, ahizong amate khat zongh in ka mang khiakna hong son thei ngawl hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph in kumpipa tungah, “Na mangte nii ii a khiakna sia kibang hi; Pathian in a sep tu teng nang tungah hong son zo hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khuipui thau salite sia kum sali hi a, taanghui a taknei salite zongh kum sali ma hi; a khiakna kibang hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A khak sang a hong pusuak khuipui ngawm sali le senneal vui ii a ngeausak singseng taanghui theap salite sia kialpi kum sali ahi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuasia kong sonsa bangma hi — Pathian in a sep tu teng nang tungah hong lak zo hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Egypt ngamsung theampo ah kum sali sung an kihau mama tu hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tua zawkciang kum sali sung kialpi tungin an hau hun kum teng kimangil cip tu hi, banghang ziam cile kialpi in ngam lalsak tu hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />An hau hun teng kimangil bit tu hi, banghang ziam cile hong zui tu kialpi sia lauhuai mama tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mang nii a kipee in na matna sia Pathian in hi thu kipsak zo a, hai ngawlin tungsak tu cinopna ahi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Tu in mipil miciim thuhe pasal khat teal in a, ngam uk tu in koi in.
  </para>
  <para style="p">
    <verse number="34" style="v" />A dang vaihawm uliante ngam sungah koi kul a, kum sali an hau hun sungin lo ante ii see nga sua see khat la khol in.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thu pia in a, hong tung tu kumphate sungah an theampo kaikhawmsak in, tuaciang amate thuneina taw khuapite sungah an kholin a, cingsak in.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hi ante sia Egypt ngam ah hong tung tu kialpi kum sali sungah ngam sungah zeak tu in, a kikhol kholsa suak tu hi. Hi bang vaihawmna taw mihingte pukthi ngawl tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kumpipa le a uliante in hi vaihawmna lungkim a,
  </para>
  <para style="p">
    <verse number="38" style="v" />kumpipa in amate tungah, “Joseph sangin a phazaw mi ih mu ngei buatu hi, ama sia a sungah Pathian thaa a nei mihing khat ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kumpipa in Joseph tungah, “Pathian in nang tungah hite theampo hong lak zo hi, tua ahikom nang saang a, a ciim zaw le thu thuk mu zaw kuama dang om ngawl ahi sia kilangh hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ka ngam ukpa tu in nang kong koi tu a, nangma thupiakte ka mihingte theampo in zui tu hi. Nangma thuneina tungsia ah keima bek ka om tu hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tu in Egypt ngamsung theampo a ukpa tu in panmun kong pia hi,” ci hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kumpipa in a min tupna khutzungbu, a khutme pan suutin Joseph khutme ah bunsak hi. Ama in puantual neal a pha khat silhsakin a ngawng ah khamh khi khat awsak hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />A to natu in kumpi siphu ngalleang niina sia pia a, ama a cing ngalkapte a mai ah pai in, “Lam na awn vun! Lam na awn vun!” ci in ausak hi. Tuabangin Joseph sia Egypt ngamsung theampo a ukpa in panmun pia hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kumpipa in ama tungah, “Keima in kumpi ka hi hi — nangma oaina om ngawlin Egypt ngamsung theampo ah kuama in a khut a peang ngawngawn laam thei ngawl tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ama in Joseph sia Zaphenath Paneah ci in Egypt min thak pia a, a zi tu in Heliopolis khua thiampi khat ahi Potiphera ii tanu Asenath pia hi. Joseph sia Egypt kumpipa na a sep kipatin kum sawmthum pha hi. Ama sia kumpi zum nusia in ngamsung theampo ah khualhaw kawkoai hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />An hau hun kum sali sung in leitang pan an tam mama piang a,
  </para>
  <para style="p">
    <verse number="48" style="v" />tua teng theampo Joseph in kaikhawmin khuapi tengah kholsak hi. Ama in khua kiim a lote panin a piang ante sia a khuapi tek ah khol hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />A ankholte sia tamlei ahikom Joseph in sim vanglak ngawlin, tee nawn ngawl hi — tua teng sia tuipi vaal senvui taw kibang hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Kialpi kumte hong tun ma in Joseph in Asenath taw tapa nii nei hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ama in, “Pathian in ka thuakna theampo le ka pa innkuanpui theampo hong mangilsak hi,” ci hi. Tua ahikom a tapa masa min Manasseh phuak hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ama in, “Ka ngim thuakna munah Pathian in tate hong pia hi,” ci ahikom a tapa niina ii min sia Ephraim phuak hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />An hau in Egypt ii nopsakna hun kum salite hong bo a,
  </para>
  <para style="p">
    <verse number="54" style="v" />Joseph sonsa bangin kum sali kialpi kipan hi. Ngamdang theampo ah kialpi tung a, ahizong Egypt ngamsung teng ah an om hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Egypt te ngilkial tu hong kipat ciang kumpipa tungah an ngen uh hi. Tuaciang kumpipa in amate Joseph kungah pai in, ama ci bang a vawt natu in thupia hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Kialpi nasia vaial in ngam bup ah hong kizel a, tua ahiciang Joseph in ankholna inn theampo hongin Egypt te tungah antang zuak hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Mun theampo ah kialpi nasia mama tung ahikom leitung mun theampo pan mihingte Joseph kungah antaw tu in Egypt ah hong pai uh hi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jacob in Egypt ngam ah an a omna thu a heak ciang a tapate tungah, “Banghang hi bang om thawthong nu ziam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Egypt ah an a omna thu za khi hi, ih pukthi ngawl natu in va pai in antaw tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tua ahiciang Joseph ii suapui sealh sawmte Egypt ah antaw tu in pai hi,
  </para>
  <para style="p">
    <verse number="4" style="v" />ahizong Jacob in Joseph suapui laipee Benjamin in amate zuisak ngawl hi, banghang ziam cile ama tungah bang khat pawpo a pian thaak tu lau hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Canaan ngam sungah kial tung ahikom midangte taw Jacob tapate antaw tu in pai hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Egypt ngamukpa a hina taw Joseph in leitung mihing theampo tungah antang zuak hi. Tuabangin Joseph suapuipate hong pai a, a maitang uh leipha in ama mai ah kun uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joseph in a suapuite a mu ciang tel hi, ahizong a he ngawl bangin kivawt hi. Ama in a suapuite tungah kamngam taw, “Koisung pan hong pai nu ziam?” ci in dongh hi. Amate in, “Canaan ngam pan antaw tu in kong pai uh hi,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Joseph in a suapuipate a tel hang a suapuipate in ama tel ngawl uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joseph in amate taw kisai a mangmatnate phawk kikin, “Note sia thukankute na hi uh a; koma ngamsung thaneamna mun teng a dawp tu in hong pai nu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amate in, “Hi ngawl hi, topa awng, antaw tu in na silate bangin hong pai khu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ko teng unau khat hi ung. Topa awng, ko sia thukankute hi ngawl a, mi thumaante ka hi uh hi,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph in amate tungah, “Hi ngawl hi! Ngamsung thaneamna mun teng a dawp tu in hong pai nu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate in, “Topa awng, ka vekpi unau sawm le nii ka pha uh a, Canaan ngammi khat ii tapate ka hi uh hi. Ka suapui khat thi a, a nobel sia tu in ka pa uh taw om hi,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joseph in, “Kong cisa bangma hi. Note thukankute nu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Note hi bangin hong kisit tu hi: kumpipa min taw ka kiciam a, na nau nobel sia hi mun hong thet mateng note cia ngeingawl tu nu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Note sung pan khat pawpo in na pui tavun. Na thu uh a thian dong, thumaan son na hi hunlam a kisit thei mateng a dang teng sia thong sungah kong khum tu hi. Tuabang ahibuale a nungta kumpipa min lo in ka sonsa bang hi, note sia thukankute hi nanak tu nu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuabangin Joseph in ni thum sung amate thong sungah koi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ni thum ni in Joseph in amate tungah, “Keima in Pathian kiita mihing khat ka hi a, thu khat hangin na nuntakna uh kong khoaikhe tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thumaan mi na hina a kilak natu in note hong kikepna mun thong sungah khat om tu nu hi, a dang teng in ngilkial a om na innkuanpuite, na an leisa teng puak thei tu nu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua zawkciang na nau nobel uh sia kei kungah nong paipui tu uh hi. Tuabangin note thumaan son na hi uh sia hong kilangh tu a, kong that buatu hi,” ci hi. Tuasia bangin amate lungkim uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuaciang khat le khat tung ah, “Hi hi, ih suapuipa Joseph tuabang ih vawtsiat hu in tu in ih thuak hi ; ngimna lian a thuak ih mu a, hu ngen in hong thuum napi ih nadon bua hi. Tua hu in tu in hi ngimna sungah ih om hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Reuben in, “Ih naupa vawtsia heak vun hong ci khi hi, ahihang ka thu hong ni ngawl nu hi. Tu in ama ii thina thaman hong lo kiksak hi,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuabang a pau sia Joseph in tel siat hi, ahihang amate in tuasia hunlam he ngawl uh hi, banghang ziam cile amate in kampheen zanghin Joseph a paupui hang ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Joseph sia mundang ah pai in kap hi. Tua zawk a pau thei kik tu ciang hong heak kik a, amate sung pan Simeon tangkal in a mai ah khaukhitsak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph in a suapuite ip teng dim antang a hensak natu, mi khat sim ii sum sia a ip sung tek ah a koisak kik natu le lampi ah a neak tu nguai an a piak natu in thupia hi. Tuabang ma in kivawtsak hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua unaute in a antang lei teng a laate tungah suanhin vaiding uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua zan a ngiana munah amate sung pan khat in a laa an pia tu in a ip a hon le a tungbel ah a sum mu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama in a suapuite tungah “Ka sum hong kikoisak kik hi, hilai ka ip sungah om hi!,” ci hi. Amate thinkiam in lau a, “Pathian in eite tungah bang hong vawt thong ziam?” ci in khat le khat kidongh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Canaan ngam a pa Jacob kung a thet ciang amate in thupiang theampo a pa tungah son hi:
  </para>
  <para style="p">
    <verse number="30" style="v" />“Egypt ngamukpa in kamngam taw in hong paupui a, a ngam thu kanin hong mawsiat hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />‘Kote thukankute hi ngawlin mi thumaante ka hi uh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kote unau sawm le nii ka pha uh a, pa khat ii ta ka hi uh hi. Ka suapuipa khat thi a, a nobel sia ka pa uh taw Canaan ah om lai hi’ ci in ka zo uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tua pa in, ‘Hi bangin na thumaanna uh kong kan tu hi: note khat hi sungah kei taw om tu nu hi; a dang teng na innkuanpui ngilkialte atu in antang puakin cia tu nu hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na nau nobel sia hong paipui tavun. Tuasia ciang note thukanku hi ngawlin thumaan mi na hina uh kong he tu hi; na suapuipa kong pia kik tu hi, tuaciang hi munah om in, sumlei sumzuak thei tu nu hi,’ hong ci hi.”
  </para>
  <para style="p">
    <verse number="35" style="v" />Tua zawkciang a ipte a sua uh ciang amate khat simin a sumbawm tek mu a; a sum a mu uh ciang amate le a pa Jacob patau uh hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />A pa in amate tungah, “Ka tate theampo hong sumsisak nuam nu ziam? Joseph bo zo; Simeon bo zo a; tu in Benjamin paipui nuam nu hi. Kei sia a thuakbelpa ka hi hi!” ci hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahihang Reuben in a pa tungah, “Benjamin kong ciapui kik bua ahile ka tapate nii thatlum in. Ama sia keima kep tu in koi in a, kong ciapui kik tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahizong Jacob in, “Ka tapa no taw paisak thei ngawl tu khi hi; a upa thi zo a, ama bek taang hi. Lampi ah bang khat po tawk thei tha tu hi. Kei ka huai zo a, tuabang nong khuangaisaknate in kei hong thatlum tu hi,” ci hi.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Canaan ah kialpi nasia seseam a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Jacob innkuanpuite in Egypt pan a antang lei teng a neak siat zawkciang, Jacob in a tapate tungah, “Pai kik tavun a, antawm va taw tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah in a pa tungah, “Tua mipa in na naupa nong paipui bua uh le ka mai nong mu thei buatu uh hi, ci in ka kidop natu uh ngat takin hong vaitha zo hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka naupa nong zuisak le kote pai in nang atu an ka taw tu uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuabang na oai buale pai ngawl tu khu hi, banghang ziam cile tua pa in na naupa nong keng bua uh le ka mai nong mu thei buatu uh hi, hong ci sa hi” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jacob in, “Tua pa tungah suapui dang nei lai khu hi ci in na sonna uh taw banghangin hi zata thinngim hong pia thong nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate in, “Tua pa in eite thu le ih innkuan thu hong dongh top a, ‘Na pa uh nungta lai ziam? Suapui dang na nei uh ziam?’ hong ci hi. Ama thu dokte ka zo nanak uh kul hi. Na naupa hong paipui tavun, ama hong ci tu sia bangbangin hekhol thei tu khu ziam?,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah in a pa tungah, “Tangvalpa kei taw paisak in, ding kik pai tu khu hi. Tua hile eite ih pukthi buatu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka naupa atu in ka nuntakna taw kong kiciam hi. Nang kungah ciidam in kong ciapui kik bua ahile a tawntungin mawsiatna ka thuak tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Eite ngei mama ngakin vaikai bualeang tu in niivei kilee a, ih thet kik natu hi zo hi,” ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pa in amate tungah, “Tuabang hi tu ahile ngamsung pan a piang a phabel te: thingnaai tawm, khuaitui tawm, hel namtui tawm, pistachio nga le almond ngate tun in ngamukpa tungah piak tu in keng tavun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na ip ngong sungah nong ciapui uh na sumte na ken kik uh kul tu ahiciang na sum uh a zaa nii in keng vun. Sum hong khiak khial zong hi thei tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na suapuipa paipui vun a, hong ciapui kik pai tavun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama in na suapuipa le Benjamin sia no hong piak kik natu in Vaanglianbelpa Pathian in tuasia pa, no tungah hesuakna thin neisak tahen. Kei, ka tate a khuai siat tu ka hile zong thuak ka heu tong,” ci hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua ahiciang unaute sia letsongte le dangka a zaa nii in keng a, Egypt ngam ah Benjamin taw pai uh hi. Joseph kungah amate ki aap uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph in amate taw a om Benjamin a mu ciang, ama in a inn uk naseampa tungah, “Amate ka inn ah paipui in. Sun ciang amate kei taw an nekhawm tu ahikom ngan khat ngo in a, kinging in,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama thupiak bangin naseampa in Joseph inn ah unaute paipui hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Inn ah amate a kipaipui ciang amate lau a, “A masa lai a sumte ih ip sungah a om kik hu in hi munah hong kipaipui hi. Amate in thakhat thu hong sim tu a, ih laate hong laaksak zawkciang sila hong suaksak tu hi,” ci in ngaisun uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuaciang amate Joseph a inn uk naseampa omna kongkha ah pai in
  </para>
  <para style="p">
    <verse number="20" style="v" />“Topa awng hi lai ah antaw tu in khatvei kong pai zo uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Inn ka cia lam ka ngiaphual ah ka ipte ka hon uh ciang ka ipngong sung tek ah ka sumte — a vekpi ma in ka mu uh hi. Tua sumte kong keng kik uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />An a tamzaw lei natu in sum dang zongh kong keng thua uh hi. Ka ip sungah ka sumte uh akua in hong koisak kik ci sia ka he bua uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Naseampa in, “Thinngim om bo, lau heak vun. Note ii Pathian, na pa ii Pathian in na ip sungah note atu in sum hong koisak hi nanak tu hi. Na antang man uh a cingin ka nga hi,” ci hi. Tua zawkciang ama in amate kungah Simeon paipui hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naseampa in unaute inn sungah paipui hi. Ama in a peang sil natu in tui pia a, a laate an pia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amate ni sun ciang inn ah hong cia Joseph taw an nekhawm tu ci ahikom a piak tu letsong teng kinging khol uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joseph inn hong thet ciang amate in a letsong puakte inn sung ama kungah paipui in ama mai, lei ah kunsuk uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in amate tungah na dam uh ziam ci in a dok zawkciang, “A thu nong sonsa na pa huai — ama bangbang ahi ziam? Cidam in a nungta lai na ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amate in, “A kiniamkhiak na naseam pa, ka pa uh nungta lai in a ciidam hi,” ci in zo uh hi. Tuaciang amate khupdin in ama mai ah kunsuk uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Joseph in a naupa Benjamin a mu ciang, “Tua ahile, hisia kei tung a nong son uh na nau nobel sia ahi ziam? Ka tapa awng, Pathian in nang thupha hong pia tahen,” ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tua zawkciang Joseph sia a naupa ciliaphuai sa in a neno ahikom thakhat thu in pusuak hi. Ama in thuak zo nawn ngawl ahiciang a inndoi sungah pai in kap hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A mai a phia zawkciang hong pusuak a, ama le ama tha la tawmin an thuukin sawl hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Joseph atu sabuai khat ah an kilui in, a suapuite atu sabuai dang khat ah an kilui hi. Tualai ah an a ne Egypt te sia a tuamin kinesak hi, banghang ziam cile Egypt te in Hebrew te taw ankuang uum khop sia zano kisa hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Joseph mai sabuai ah a suapuite ama maingat in a haambel pan a moibel dong a kizomin tosak hi. Tuabangin amate a kitosak a mu uh ciang lamdang sa in khat le khat ki en uh hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Joseph ii sabuai tung pan amate an kipia a, Benjamin sia a dangte sangin a zaa nga tamzaw in kipia hi. Tuabangin amate Joseph taw anne tuidawn in nuamsa uh hi.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph in a inn uk naseampa tungah, “Hi pasalte ip sungah a puak zawk zaza nguai an hensak in a, amate sum tek a ipngong sungah koisak in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ngunn hai sia a moibelpa ii ipngong sung a tungbel ah antawk natu sumte taw koikhawmin,” ci in thupia hi. Ama in a kisawl bangin seam hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zingsang tuungin a laate uh taw unaute ciasak uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khuapi pan tawm a pai zawkciang Joseph in ama inn uk naseampa tungah, “Manlang in tua pasalte del ta'n. Na phak ciang amate tungah, ‘Thupha sia banghang a sia taw hong thuk nu ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Banghangin ka topa ngunn hai ngu nu ziam? Ka topa tui neakna hai hi a, aisaan na in a zak hi. Khialna nasia mama khat vawt nu hi!’ na ci ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naseampa in amate a phak ciang, hi kammal teng ma son kik hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate in, “Topa awng, hi bang teng na pau bang na cinopna ziam? Hi bang lawlawmin ngamta ngawl khu hi ci in ka kiciam uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na heaksa bangin ka ipngong sungah ka mu uh sumte Canaan ngam panin nang kungah kong paipui kik uh hi. Tuabang hi a, na topa ii inn pan ngunn ahizong khamh ahizong banghangin ngu tu khu ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Topa awng, khat pawpo tung pan na mu le tua pa kithat tu a, ko a dang teng na sila kong suak tu uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in, “Hi hen; ahizong tua hai a la sia bek ka sila suak tu a, no a dang teng na pai vahial thei tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua ahiciang amate in manlang takin a vanhte lei ah khiasuk uh a, amate ip tek hong uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph naseampa in a haambel pan a moibel dong pha takin tok a, tua hai Benjamin ii ip sungah mu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Unaute in khuangaina taw a puante balkeak in, laate tungah a vanhte suanhin khuapi ah heakkik uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Judah le a suapuite Joseph inn a thet uh ciang tua munah Joseph om lai hi. Amate Joseph mai ah kunsuk a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Joseph in, “Bang seam thong nu ziam? Keima dinmun ah a om mihing khat in aisaanna zanghin note hong man zo veve tu cisia he ngawl nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Judah in, “Topa awng, nang tungah bang hong ci thei tu khu ziam? Bangbangin hong nial thei tu khu ziam? Bangbangin kiphel thei tu khu ziam? Pathian in ka mawna uh hong kilanghsak hi. Tua hai a kimuna pa bek hi ngawlin kote theampo zongh tu in na sila ka hi uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Joseph in, “Oh, hi ngawl hi! Tuabang vawt ngeingawl tu khi hi! Hai a kimuna pa bekma ka sila hi tu hi. No a dang teng na pa kungah ciidam ludam in cia thei nu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Judah in Joseph kungah paito a, “Topa awng nong hesuakna in, na tungah hi vahial in thu hong sonsak ta'n. Kei tungah hong thin uuk heak in; Nang sia kumpipa tatak bang na hi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Topa awng, nangma in, ‘Pa ahizong suapui dang ahizong na nei uh ziam?’ ci in nong dongh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kote in, ‘Pa huai khat le a huai zawkciang a nei suapui naupa khat ka nei uh hi. Ama ii suapuipa thi a, nu khat tate sung pan ama bek nungta lai hi; a pa in ama it mama hi,’ kong ci uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Topa awng, nangma in ama na mu thei natu in hi lai ah hong paipui tavun nong ci a,
  </para>
  <para style="p">
    <verse number="22" style="v" />tangvalpa in a pa nusia thei ngawl tu hi; nusia le a pa thi tu hi ci in kong zo uh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuasia ciang nangma in, ‘A nobel na suapuipa uh taw nong pai bua uh le ka mai nong mu thei buatu uh hi,’ nong ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Ka pa kungah ka cia kik uh ciang nangma ci bangin ka son uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuasia ciang ama in, pai kikin, antawm taw lai tu in hong sawl hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Koma in, ‘Ka nau nobel ngawl taw tua pa kung hong kitumsak ngawl tu ahikom ko pai thei ngawl tu khu hi. Ka nau nobel zongh hong pai le tuasia ciang bek pai thei tu khu hi,’ ci in ka zo uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka pa uh in ko tungah, ‘Ka zi Rachel in tapa nii bek hong neipui sia na he uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A khat sia in keima hong nusia zo hi. Ama hong nusiat a kipan tu dong mu kik ngawl ka hikom, ngamsate in ama balneen zo hi nanak tu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tu in, hisia kei kung pan paipui in bang khat po tawk thong le haam zo ka hi bangma nong khuangaisakna in kei hong thatlum tu hi,’ hong ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Judah in, “Tua hi a, tu in topa awng, ka nau ngawl taw ka pa kungah cia kik thong leng ka naupa kei taw cia khawm ngawl hong mu po ciang ama thi tu hi. Ka pa nuntakna sia ka naupa nuntakna bek mitsuan in nungta a, ama haam mama zo ahikom ama ka khuangaisakna in thisak tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tua bek dom ngawlin ka naupa atu in ka pa tungah ka nuntakna ka khaam hi. Ka naupa ama kungah ka ciapui kik bua ahile ka nuntak sung theampo mawsiatna ka thuak tu hi, ci in ka son hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuaciang tu in topa awng, ka naupa taangin keima na sila in hi sungah kong om tu a; ama a suapuite taw paisak in.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka naupa kei taw hong om buale bangbangin ka pa kungah cia kik thei tu khi ziam? Ka pa tungah hi tuasiatna a tun ka mu tu sia kei thuak zo ngawl tu khi hi,” ci hi.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph in a naseamte mai ah a nenona khaam zo ngawl ahikom a inndoi sung pan a naseam theampo a pusua natu in thupia hi. Joseph in a suapuite tungah ama akua ci in a kison laitak kuama dang om ngawl hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Joseph nasia tak kap ahikom Egypt te in za a, tua thu kumpi inn sungah thang hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Joseph in a suapuite tungah, “Keima Joseph khi hi. Ka pa nungta lai ziam?” ci hi. Ahizong hi thu a suapuite in a zaak ciang amate lau mama ahikom zo thei ngawl uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua zawkciang Joseph in amate tungah, “Hesuakna taw hong neak tavun,” ci hi. Amate in neak a, ama in, “Egypt te tungah na zuak uh na suapuipa Joseph khi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hi lai ah nong zuak uh manin nuammaw sa in kimawsiat heak vun. Mihingte nuntakna ngum tu in note mai ah Pathian in kei hong paisak khol hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu kum sia ngam sungah kialpi tun kum niina hi pheang a, lotho ngawl, anlaak ngawl tu hun kum nga sung om lai hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Note le na suan na paalte nuntak thei natu le hi bang a lamdangin note kong suatak thei natu in note mai ah Pathian in kei hong paisak khol hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua hi a, hi munah kei hong then sia no hi ngawl het a Pathian ahi hi. Pathian in kumpipa ii ulianbel in hong koi hi. Ama ngam bup thuzeakpa ka hi a; Egypt ngam theampo a ukpa ka hi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tu in, ka pa kungah manlang in cia tavun a, na tapa Joseph in hi bang hong ci hi ci in son tavun: ‘Pathian in Egypt ngam theampo a ukpa in hong koi zo hi; kei kungah hai ngawlin hong pai ta'n.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kei taw nong kinai thei natu in Goshen ngam ah — nangma, na tate, na tute, na tuute, na kealte, na khuite le na neisa theampo taw na teang thei tu uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Goshen ah nong om le kong khoi thei tu hi. Kialpi hun kum nga bang om lai hi; nangma, na innkuanpuite le na ngannote na pukthi tu uh ka dei bua hi” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph in a thuson zom a, “Tu in note theampo le Benjamin awng, nang zongh in Joseph tatak ka hi sia nong mu thei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hi lai Egypt ngam sungah ka vaang neizia le na mu theampo ka pa tungah son tavun. Tua zawkciang manlang in ama hi munah hong paipui tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joseph in a suapuipa Benjamin koai in kap a; Benjamin zongh in koai in kap hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuaciang Joseph in a suapui teng khat zawkciang khat kap kawmin ngawngkoai in namh hi. Tua zawkciang a suapuite ama taw thuson tu kipan hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph suapuite hong paina thu kumpi inn sung dongah theng a, kumpipa le a uliante lungdam hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kumpipa in Joseph tungah, “A ngante vanh suanhin, Canaan ngam ah a heak kik natu in na suapuite sawl in.
  </para>
  <para style="p">
    <verse number="18" style="v" />A pa le a innkuanpuite puisak in a, hi lai ah pai kiksak in. Egypt ngam sungah leitang phabel sia amate ka pia tu a, amate nuntak khomna za sangin a tamzaw nei tu uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A zite, a tanote le a pa to natu in Egypt pan leang a ken natu zongh son in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amate in a neisa te a nusiat tu sia thinbot heak hen; Egypt ngam bup leitang phabel sia amate aa hi tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jacob tapate in a kisawl bangin ngamta hi. Kumpipa thupiak bangin Joseph in leangte le lampi a neak tu nguai an pia hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph in amate puan laih natu zongh puansilh khat tek pia a, ahizong Benjamin sia ngunn dangka 300 le puan laih natu silh nga pia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama in Egypt ngam pan a piang na phabelte laa sawm ii puakkhop le antang, anluum le lampi a neak tu nguai an laa sawm ii puakkhop ma a pa thaak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama in a suapuite tha a, amate tungah, “Lampi ah kihau heak vun,” ci in vaitha hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amate Egypt ngam pan dingin Canaan ngam a pa Jacob inn ah cia kik uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amate in a pa tungah, “Joseph nungta lai hi! Ama sia Egypt ngam theampo ukpa hi!” ci in son hi. Jacob in lamdangsa mama in um zo ngawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahizong Joseph ii kam vaithak teng a son ciang le ama Egypt ngam ah a pai natu in a kipuak, leangte a mu ciang, a pa ingh liangin a omna teng veng hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A pa in, “Ka tapa Joseph nungta tatak lai ziam! Ka kat sia tu teng ma hi ei! Ka thi ma in pai in va kimu nanak tong,” ci hi.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jacob in a vanh nei theampo heangin Beersheba ah pai a, tua munah a pa Isaac ii Pathian tungah biakpiakna nei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tua zanin Jacob ii mukholna sungah Pathian in paupui a, “Jacob, Jacob awng!” ci in sam hi. Jacob in, “Hi hi, hi sungah om ing,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in, “Keima in Pathian, na pa ii Pathian ka hi hi,” ci hi. “Egypt ah na pai tu sia lau heak in; na suan na paalte tualai ah minam lian khat in ka siam tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Egypt ah nangma taw kong paikhawm tu a, na suan na paalte hi ngam le lei ah kong ciapui kik tu hi. Na thi ciang Joseph sia nangma taw om tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Beersheba pan Jacob vaiding hi. A tate in a ma, a tanote le a zite, Egypt kumpipa ii a puaksak leangte tungah tosak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Canaan ngam pan ngannote le a vanh nei teng taw kithoai in Egypt ngam zuan hi. Jacob in a suan a paal theampo ahi:
  </para>
  <para style="p">
    <verse number="7" style="v" />a tapate, a tupate, a tanute le a tunute a vekpi in paipui hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama taw Egypt a zuan Jacob ii innkuanpui teng sia a tapa lianbel Reuben,
  </para>
  <para style="p">
    <verse number="9" style="v" />tuaciang Reuben ii tapate: Hanoch, Pallu, Hezron le Carmi,
  </para>
  <para style="p">
    <verse number="10" style="v" />Simeon le a tapate: Jemuel, Jamin, Ohad, Jachin, Zohar le Canaan numeinu ii tapa Shaul,
  </para>
  <para style="p">
    <verse number="11" style="v" />Levi le a tapate: Gershon, Kohath le Merari,
  </para>
  <para style="p">
    <verse number="12" style="v" />Judah le a tapate: Shelah, Perez le Zerah, (Judah ii tapa dangte Er le Onan hi a, Canaan ah thi uh hi.) Perez ii tapate: Hezron le Hamul,
  </para>
  <para style="p">
    <verse number="13" style="v" />Issachar le a tapate: Tola, Puah, Jashub le Shimron,
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebulun le a tapate: Sered, Elon le Jahleel ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hi tapa teng sia a tanu Dinah banah Jacob atu Leah ii Mesopotamia ah a nei tate ahi hi. Leah taw a nei a suan le a paal a vekpi in 33 pha hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad le a tapate: Zephon, Haggi, Shuni, Ezbon, Eri, Arod le Areli ahi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Asher le a tapate: Imnah, Ishvah, Ishvi, Beriah le a suapuinu uh Serah ahi hi. Beriah ii tapate sia Heber le Malchiel ahi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hi sawm le luk te sia Laban ii a tanu Leah a piak, a sila nu Zilpah taw a nei Jacob ii suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jacob in a zi Rachel taw tapa nii nei a: Joseph le Benjamin ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joseph in Heliopolis khua thiampi Potiphera ii tanu Asenath taw Egypt ah tapa nii nei a, Manasseh le Ephraim ahi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin ii tapate sia Bela, Becher, Ashbel, Gera, Naaman, Ehi, Rosh, Muppim, Huppim le Ard ahi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hi sawm le lite sia Jacob le Rachel suan le paalte ahi uh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan le a tapa Hushim.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naphtali le a tapate: Jahzeel, Guni, Jezer le Shillem ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hi salite Laban ii a tanu Rachel a piak a sila nu Bilhah taw a hin, Jacob ii suan le paalte ahi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Egypt ah a pai Jacob ii a suan le a paalte a vekpi in 66 hi a, tuate sungah a tapate ii zite kihel ngawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Joseph in Egypt ah tapa nii nei a, Jacob innkuanpuite tua mun a thet ciang a vekpi in 70 pha uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Goshen ah Joseph ii amate a mua natu a son tu in, Jacob in Judah pai kholsak hi. Amate a thet ciang,
  </para>
  <para style="p">
    <verse number="29" style="v" />Joseph, a siphu ngalleang tung to in a pa muak tu in Goshen ah pai hi. A kimu ciang Joseph in a pa ngawngkoai in ngei hialma kap hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jacob in Joseph tungah, “Tu hile na meal kong mu zo a, na nuntak lai hunlam hong he zo ka hikom kei a thi tu kinging khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua zawkciang Joseph in a suapuite le a pa innkuanpui dang teng tungah, “Kumpipa kungah ka na pai tu a, Canaan ah a teang ka suapuite le ka pa innkuanpui theampo ka kung hong zuan zo hi, ci in ka son tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Note sia tuucingte le ngan khoaite hi a, na tuute na ngante le na neisa dang teng theampo nong paipui uh sia ka son tu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kumpipa in note hong samin, bang na seam nu ziam ci in hong dok ciang,
  </para>
  <para style="p">
    <verse number="34" style="v" />ka taanghpupite bangma in ka khan tawntungin ngankhoai na seam ung, na ci tu uh hi. Tuabang na ci uh ciang ama in Goshen ngam ah hong teangsak tu hi,” ci hi. Egypt te in tuucingte sia thu a sim ngawl ahikom Joseph in tu a bangin a ci ahi hi.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua ahiciang Joseph sia a suapuite nga taw kumpipa kungah pai hi. Ama in, “Ka pa le ka suapuite Canaan ngam pan a tuute, a ngannote le a neisa teng theampo taw hong pai zo hi. Tu in amate Goshen ngam ah om uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tua zawkciang ama in kumpipa mai ah a suapuite paipui hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kumpipa in, “Bang na seam nu ziam?” ci in amate dongh hi. Amate in, “Topa awng, ka taanghpupite bangma in tuucingte hi ung.
  </para>
  <para style="p">
    <verse number="4" style="v" />Canaan ngam ah nasia tak kialpi tung a, ngantha natu mun om ngawl ahikom hi ngam ah a teang tu in kong pai uh hi. Hesuakna taw Goshen ngamkhen ah ka teen thei natu uh in thu hong pia ta'n,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kumpipa in Joseph tungah, “Tu in na pa le na suapuite hong theng zo ahiciang
  </para>
  <para style="p">
    <verse number="6" style="v" />Egypt leitang sia amate aa hi. Leitang phabelna mun ahi, Goshen ah teang tahen. Amate sung pan naseam thiam a om le ka ngannote a uk tu in koi in,” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuasia ciang Joseph in kumpipa mai ah a pa Jacob paipui in aap hi. Jacob in kumpipa thupha pia hi,
  </para>
  <para style="p">
    <verse number="8" style="v" />tuaciang kumpipa in ama tungah, “Kum bangza pha ni ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jacob in, “Vak kawkoai in ka nuntak zawk kum za le kum sawmthum pha zo hi. Ka taanghpupite ii kum tampi a vak kawkoai sia za zongh hi ngawl lai in, kum tawm napi ka haksa hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jacob in kumpipa sia vaithakna thupha pia in nusia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuaciang Joseph in a pa le a suapuite kumpipa thupiak bangin Egypt ngamsung lei phabelna Rameses khuapi nai ah mun pia in teangsak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph in a pa, a suapuite le a pa innkuanpui dang teng theampo a moibel dongin an pia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kialpi nasia mama ahikom in mun theampo ah an om ngawl a, Egypt te le Canaan mite ngilkial in a tha hong zawm uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joseph in mite ii an leina sum teng kaikhawmin kumpi inn sungah koi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Egypt le Canaan ah sum teng a kizak siat zawkciang Egypt te Joseph kungah pai in, “Ko an hong pia ta'n! Hong thisak heak in. Khat pawpo hong vaihawmpui ta'n! Ka sum uh teng bo siat zo hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph in, “Na sumte a bo siat zo le na ngannote hong paipui tavun; an taw kitheak tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua ahiciang a ngannote Joseph kungah paipui uh a, ama in a siphute, a tuute, a kealte, a khuite le a laate thena in an pia hi. Tua kum in ama in a ngannote theampo a thena in an pia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A kum kik ciang amate Joseph kungah pai in, “Topa awng, thumaan sia na maitang ah ka iim thei bua uh hi; ka sum uh theampo bo siat zo a, nganno theampo nangma aa hi zo hi. Ka pumpi uh le ka leitangte simngawl, kong piak tu bangma taang ngawl hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hong thisak heak in. Khat pawpo hong vaihawmpui ta'n! Koma lote vaalthongsak heak in. Koma le ka leitang an taw hong lei ta'n. Kote, kumpipa ii sila suakin, ka leitang uh ama ii neisa hi tu hi. Ka nuntak natu in an hong pia ta'n a, lote ah ka ciin tu uh thaicii hong pia ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joseph in Egypt leitang theampo kumpipa atu in lei hi. Kialpi nasia mama ahikom Egypt mi theampo a leitang a zuak ngawlin phamaw a; tuaciang leitang theampo kumpipa ii neisa suak siat hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Joseph in Egypt ngam mong khat pan mong khat dong mihingte sila suaksak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama in thiampite neisa leitang bekma lei ngawl hi. Kumpipa in amate nuntak khom natu an pia ahikom a leitangte zuak kul ngawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph in mite tungah, “Na mu uh bangin, tu in note le na leitangte kumpipa atu in kong lei zo hi. Na lo ah na ciin tu anciite hi sungah om hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anlaak hun ciang see nga sua see khat kumpipa na pia tu uh hi. A om lai teng sia, thaicii tu le noma le na innkuanpuite ii anneak tu in zangh thei tu nu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amate in, “Nangma in kote nuntakna nong hun zo a; kote tungah nong thuthiam hi, topa awng, tuaciang kote sia kumpipa ii sila ka hi tu uh hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua ahiciang Joseph in Egypt leitang taw kisai, lo an a piangte ii see nga sua see khat kumpipa ii neisa a sua thei natu thukham khat vawt hi. Hi thukham sia tuni dongin kizangh lai hi. Thiampite leitang bek kumpipa ii neisa suak ngawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israel te Egypt ngam Goshen ah teang a, tua munah amate hau in, ta tam mama nei uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jacob kum 147 a phak dong Egypt ah kum sawm le kum sali sung teang hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A thi tu hun a nai ciang ama in a tapa Joseph samin, “Ka phei kawmah na khut koi in, Egypt ah nong phum ngawl natu in kiciamna khat vawt in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka pate thaan ah kiphum nuam khi hi; Egypt ngamsung pan hong tua ta'n a, amate thaan ah hong phum ta'n,” ci hi. Joseph in, “Nong ci bangin ka vawt tu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jacob in, “Ka vawt nanak tu hi ci in hong kiciam ta'n,” ci hi. Joseph in kiciamna vawt a, tuaciang Jacob sia a lupna tungah lungdamko hi.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hun khat zawkciang a pa dam ngawlna thu Joseph tungah kison hi. Tua ahiciang a tapate nii, Manasseh le Ephraim taw a pa ve tu in pai uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jacob tungah na tapa Joseph in hong ve tu in hong pai hi, ci in a kison ciang, ama in a tha saanin lupna tungah toto hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jacob in Joseph tungah, “Canaan ngam Luz khua ah Vaanglianbelpa Pathian in kei tungah hong kilangh a, thupha hong pia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian in kei tungah, ‘Ta tam mama kong pia tu hi, tuabangin na suan na paalte sia minam tam mama te suak tu uh hi; keima in na suan na paalte tungah a tawntung a nei tu in hi leitang ka pia tu hi,’ hong ci hi,” a ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jacob in a pau zomin, “Joseph awng, hi lai ah kong pai ma in Egypt ah na nei na tapa niite keima aa hi; Reuben le Simeon bangma in Ephraim le Manasseh te sia keima tapate ma ahi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tapa a tamzaw na nei lai le amate sia kei aa ci in kingaisun ngawl tu a; a nga uh ngamhluana sia Ephraim le Manasseh tungtawnin hong pai tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na nu Rachel hangin hi bangin ka vawt ahi hi. Mesopotamia pan ka heakkik lai in, Canaan ngamsung Ephrath khua taw kikhuala ngawlna ah ka khuangaibel natu in na nu hong thi hi. Ephrath paina lamhui ah ama ka phum hi,” ci hi. (Ephrath sia tu in Bethlehem kici hi.)
  </para>
  <para style="p">
    <verse number="8" style="v" />Jacob in Joseph tapate a mu ciang, “Hi panote akua te ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joseph in, “Ka tapate hi, hi lai Egypt pan Pathian hong piak hi,” ci in zo hi. Jacob in, “Thupha ka piak thei natu in ka kungah hong paipui ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A kum tam zo ahikom Jacob ii mitte mang zo a, pha takin khuamu thei nawn ngawl hi. Joseph in a tapano te a kungah paipui a, a pa in amate koai in namh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jacob in Joseph tungah, “Nang hong mu kik tu in ka kimuangmaw ngei bua a, tu in Pathian in na tate ngawngawn hong musak hi,” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua zawkciang Joseph in Jacob kaang pan a amate la in, a pa mai lei ah kun hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Joseph in Jacob veisang ah Ephraim, a ziatsang ah Manasseh koi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahizong Jacob in a khutte kithatheaksak in, a nau zaw hi napi Ephraim lu tungah a khut ziatsang nga in, a uzaw Manasseh tungah a khut veisang nga hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua zawkciang ama in Joseph thupha pia hi; “Ka pate ahi Abraham le Isaac te ii a na a sepsak Pathian in hi panote thupha pia tahen! Tuni dongin keima lam hong pui Pathian in amate thupha pia tahen!
  </para>
  <para style="p">
    <verse number="16" style="v" />Natna satna theampo panin keima hong suatak vantunglalang in amate thupha pia tahen! Hi panote tungtawnin keima min le ka pate ahi Abraham le Isaac min nungta top tahen! Amate in ta tam mama nei in suan le paal tam mama nei tahen!”
  </para>
  <para style="p">
    <verse number="17" style="v" />A pa in a khut ziatsang Ephraim lu tungah a koi, a mu ciang Joseph a thinnuam ngawl hi; tua ahikom Joseph in a pa khut, Ephraim lu tung pan Manasseh lu tungah khiin tu in la hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in a pa tungah, “Pa awng, tuabang hi ngawl hi. Hi sia ta uzaw hi a, na khut ziatsang a lu tungah koi in,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A pa in nial a, “He khi hi, ka tapa awng, he khi hi. Manasseh ii suan le paalte zongh minam lian khat suak veve tu hi. Ahizong a naupa in ama sang in lian zaw tu a, ama suan le paalte minam liante suak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuabangin Jacob in tua ni in amate thupha pia a, “Israel mite in thupha a piak uh ciang na minte zangh tu hi. Amate in, ‘Ephraim le Manasseh taw kibangin Pathian in note hong siam tahen,’ ci tu uh hi,” ci hi. Hi bangin Jacob in Manasseh mai ah Ephraim koi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tua zawkciang Jacob in Joseph tungah, “Nong mu bangin kei thi nai tu khi hi, ahizong Pathian in nang hong panpui tu a, na taanghpupite ii ngam le lei ah hong ciapui kik tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amor mite tung pan ka namsau le ka thal taw ka laak, leipha ngam Shechem sia na suapuipate atu hi ngawlin nangma atu kong piak ahi hi.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jacob in a tapate samin, “Hong kikhawmtua tavun, mai sangah note tung a hong piang tu thu kong son tu hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Jacob ii tapate awng hong paikhawm tek tavun a, hong ngai tavun. Na pa Israel thu son ngai vun.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ka taciil Reuben awng, nang sia ka thahatna Tuaciang pasal ka tanna in, ka ta masabel na hi a, ka tapa teng sung pan a kiphasakbel le a thahatbel na hi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang in tuipawm khat taw na kibang a, Ahizong a thupibel na hi buatu hi, Banghang ziam cile ka zino na luppui a, na pa ii lupna na paksak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Simeon le Levi unau khat na hi uh hi. A ngalhiamte ngongtatna in zangh uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thuku sonna ah ka kihel buatu a, A kikhopna ah ka kipawl buatu hi, Banghang ziam cile a thin uuk uh ciang mihing that a, Kimaina in khuitalte ii a peangbaisak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thin uukna ah haamsiatna thuak hen, banghang ziam cile a thin uukna nasia leih hi. A thinsona ah haamsiatna thuak hen, banghang ziam cile a thinso nasia leih hi. Israel ngam sungah amate ka thethaang tu hi. A mipuite sungah amate ka khentham tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Judah awng na suapui te in nang hong pok tu hi. Na ngalte a ngawng pan na man hi. Na suapuite in na mai ah hong kun tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah sia, Sa manin a kuahawng zuan kik a, Kizia in a lumsuk tawpi khat taw kibang hi. Kuama in ama nawngkaisak ngam ngawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Judah in kumpi ciangkhut len tu a, A suan a paalte in ngamuk tawntung tu hi. Minamte in ama tungah phiangshia puak tu a, Thunitna taw ama mai ah kun tu uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama in a laano sia sapitkung khat ah khit a, Sapitkung phabel sia tung ahi hi. Ama in a puante chi bangin a san sapittui sungah sawp hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sapittui a neakna in a mitte san ngingu a, Noai a neakna in a hate paak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Zebulun sia tuipi hui ah teang tu hi. A tuipi vaal sia teambawte tawlngakna khat hi tu hi. A ngam Sidon ciang dong theng tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Issachar sia a tung tona ipte kawm ah kizia in a lum, Laa khat sangin phazaw ngawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahizong ama in a tawlngakna mun ii phatna mu a A ngam a lei nuamsa hi. Tua ahiciang a nungzaang ah vanh pua tu in ama kunsuk a, Sila khat bangin na kiseamsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Dan sia a mipuite ii a ukpa hi tu hi. Amate Israel minam dangte bangma hi tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan sia lampi hui ah a om ngul khat, lamzin hui ah a om ngul ngu nei khat hi tu a, Tua ngul in siphu khuatul pan tu hi, A tungto pa a nung sangah a kilot thal natu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“ Topa awng, nong hut tu ka ngak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Phalakte pawlkhat in Gad sim tu a, ahizong Gad in amate kileesak kikin sul zui tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Asher ii leitang pan an tam mama piang tu hi. Kumpi khat ii neak tu in a kilawm an, ama in pia tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Naphtali sia a ithuai tanote a nei, a tai vavil sangai khat ahi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Joseph sia ciktui hui khat ah a om ngamlaa khat taw kibang a, Mualpangh ah a om ngam siphuno khat taw kibang hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A ngalte in nasia takin sim a, A thal le a thaltangte taw del hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahizong Jacob ii Pathian Vaanglianbelpa ii vaangletna le Israel a Dal pa, Tuucingpa hangin A thal kinging top a, A khutte a tha kihatsak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang hong hu, na pa ii Pathian, Thupha hong pia Vaanglianbelpa Pathian in Vantung pan thupha ngua taw Leinuai tawngh pan tui taw Khoai le vul tam mama, tu le ta tam mama thuphate taw,
  </para>
  <para style="p">
    <verse number="26" style="v" />thupha antangte le paakte, Taanghlai mualte ii thuphate, Tawntung mualte panin, nopsakna te, Hi thupha teng Joseph ii lu tungah A suapuite sung pan a kituam koi pa ii mitkhu tungah tawlnga in, tung siat tahen.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Benjamin sia a hang mama ngiapui khat taw kibang hi. Zing le nitak sa thatlum in ne tum hi,” ci hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hi te sia Israel minam sawm le niite hi a, hi thu sia amate tetek taw a kiphu a kilawm tu in a son a pa ii a tapa khat sim tungah vaithakna kammal ahi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tua zawkciang Jacob in a tapate tungah, “Tu in ka mipuite thina ah a pai tu ka hi a, ka pate taw in suanghawng thaankhuk ah hong phumkhawm tavun, tua thaankhuk sia Hit mi Ephron ii lo sung hi a,
  </para>
  <para style="p">
    <verse number="30" style="v" />Canaan ngam Mamre ii nisuana sang Machpelah ah om hi. Abraham in hi thaankhuk le lo sia thaan mun tu in Ephron tung pan lei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua munah amate in Abraham le a zi Sarah; Isaac le a zi Rebecca phum a; tuaciang keima in Leah ka phum hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tua lo le thaankhuk sia Hit mite tung pan a kilei ahi hi. Tua munah hong phum tavun,” ci in thupia hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jacob in a tapate a vaithak zawkciang, ama lumsuk kikin thi hi.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph, a pa tungah kisepsuk a, kapin a pa maitang namh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuaciang Joseph in a pa luang a muat ngawl natu vawt tu in thupia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A luang muat ngawl natu nasepna sia a ngeina bangin ni 40 sung hai hi. Egypt mite sia ama atu in ni 70 sung khuangai in kap uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khuangai hunte a ven ciang, Joseph in kumpipa ii uliante tungah, “Hesuakna in kumpipa tungah hi thu hong sonsak tavun:
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Ka pa a thi mahiat in Canaan ngamsung, ama atu in a kinginna sa thaankuul ah ka phum natu in kamciamna hong vawtsak hi. Tua ahiciang hesuakna in ka pa a phum tu in hong paisak ta'n, tua zawkciang kong cia kik tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kumpipa in, “Kamciamna na vawt bangin, pai in na pa phum ta'n,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua ahiciang Joseph a pa phum tu in pai hi. Kumpipa ii ulian theampo, ama zumsung upate le Egypt ngam lampuite theampo Joseph taw pai uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama ii innkuanpui, a suapuipate le a pa ii innkuanpui a om lai teng theampo ama taw pai uh hi. A tanote, a tuute, a kealte le a khuite bek ma Goshen ngam ah taang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Siphu ngalleang tung le siphu tung a to mihingte zongh ama taw pai tek uh a; mihing tam peuma hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jordan ngun nisuana sangah a om Atad ancilna mun a thet ciang, amate ngei hialpo khuangai in nging takin kap uh hi, tuaciang Joseph in ni sali sung khuangai kaana hun in zangh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Canaan ngammite in Atad ah tua mihingte khuangai in kap a mu ciangin, “Egypt te in a ciliap huai khuangai kaana nasia takin vawt hi ta a!” ci uh hi. Tua ahikom tua mun sia Abel Mizraim kici hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua ahiciang Jacob thupiak bangin a tapate in seam uh hi;
  </para>
  <para style="p">
    <verse number="13" style="v" />amate in Canaan ngam ah a pa luang pua in thaan mun tu in Abraham ii Hit mi Ephron tung pan a lei, Mamre nisuana sangah a om Machpelah lo sung thaankuul ah phum uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pa a phum zawkciang Joseph, a suapuite le mithi phumna ah a zui theampo taw Egypt ah cia kik uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A pa thi zawkciang Joseph suapuite in, “Joseph in hong ngaimaw lai hen a, ama tungah siatna ih vawt theampo thuk kik hong sawm thong le bang law tu ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua ahikom amate in Joseph tungah, “Ih pa a thi ma in,
  </para>
  <para style="p">
    <verse number="17" style="v" />ama in, ‘Na suapuite ii nang tung a kong vawt khialna lian sia hesuakna taw maisak ta'n,’ ci in nang tungah hesuak ngen vun hong ci hi. Tu in na pa ii Pathian naseam kote ii vawt khialna sia pan hesuakna taw hong maisak ta'n,” ci in kam vaitha uh hi. Joseph sia hi kam vaithak a zaak ciang kap hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua zawkciang a suapuite hong pai in, ama mai ah kun uh hi. Amate in, “Hi lai na mai ah na silate bangin om ung,” ci uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahizong Joseph in amate tungah, “Lau heak vun; Pathian dinmun ah keima le keima kikoi thei ngawl khi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Note in a sia nong sawm uh hi, ahizong tua thupiang sia hu in tuni a, a nungta mihing tam mama te ii nuntakna a huu tu in, Pathian in tuasia a pha lam in hong heisak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bangma no lau natu om ngawl hi. Note le na tate kong khoi tu hi,” ci hi. Tuabangin Joseph in a suapuite thinsung lungsung kha tu in kamthiam kamneam zanghin a suapuite thinnuamsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph, a pa innkuanpuite taw Egypt ah teang khawm tan a; kum 110 a phak ciang thi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama in Ephraim ii tate le tute a mu dong nungta hi. Ama in Manasseh ii tapa Machir ii tate zongh a nuntak lai in ama innkuanpui in nei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama in a suapuite tungah, “Kei a thi nai tu ka hi hi, ahizong Pathian in note hong keam tatak tu a, hi ngam pan, Abraham, Isaac le Jacob te tungah a ciliap huai takin a kamciamna ngam ah hong paipui nanak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tua zawkciang Joseph in a mite kiciamna khat vawt tu in sawl hi. Ama in, “Pathian in tua ngam ah hong paipui ciangin noma taw ka luang paipui tu khu hi ci in hong kamciam tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuabangin Joseph kum 110 a phak ciang Egypt ngam ah thi hi. Amate in Joseph luang a muat thei ngawl natu in vawtin, mithi kuang khat sungah koi hi.
  </para>
</usx>
