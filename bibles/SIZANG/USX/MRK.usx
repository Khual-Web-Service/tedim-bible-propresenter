<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MRK" style="id">Mark</book>
  <para style="h">Mark</para>
  <para style="toc1">Mark</para>
  <para style="toc2">Mark</para>
  <para style="mt">Mark</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hi thu in Pathian Tapa Jesus Christ Lungdamna Thupha ahi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kamsaangpa Isaiah at sa bangin kipan hi. “Pathian in ‘Ka kamtaipa sia na lampi hong honkholsak tu in, na mai ah ka paisak tu hi.’
  </para>
  <para style="p">
    <verse number="3" style="v" />Sennealngam sungah mihing khat hong au a, ‘Topa atu in lampi puuakhol vun; ama khualhaw natu in lamzin tang khat vawtsak vun!’ ” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuabangin John sia sennealngam sungah hong kilak a, ama in thuhil in tuiphum hi. “Na mawna pan kisiik kik vun a, tui kiphum vun, tua hile Pathian in na mawnate hong maisak tu hi,” mipite tungah ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Judea ngam pan le Jerusalem khua panin John thuson ngai tu in mihing tam mama hong pai uh hi. Amate in a mawnate pualaak uh a, tua zawkciang Jordan Ngun sungah, ama in tuiphum hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />John in kalaoh mul taw a kitak puan silh a, savun kawngkhau thua in, a anneak sia khaumaw le ngam khuaitui ahi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihingte ii munah, ama in, “Kei nung pan hong pai lai tu pa sia kei sangin lianzaw pek hi. Kunin a peangdap khau suut tu zongh in ka kilawm bua hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Note sia tui taw tui kong phum hi, ahihang ama in Thaa Thiangtho taw hong baptize tu hi,” ci in taangko hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua zawk a ngei ngawlin Jesus sia Galilee ngam Nazareth khua panin hong pai a Jordan ah John in tuiphum hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuisung pan Jesus a thaw to po ciangin, van kihong a, Thaa sia ama tungah ngam vakhu bangin hong tuaksuk sia ama in mu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vantung panin aw khat nging a, “Nang sia ka it ka Tapa na hi hi. Nang tungah ka lungkim hi,” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thakhatin Thaa in ama sennealngam sungah paisak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tua munah Satan in ama ni sawmli sung ze et hi. Tua munah ngamsate zongh om a, ahizong, vantunglalangte hong pai in ama hu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />John thong sungah a kikhum zawkciang, Jesus Galilee ngam ah pai a, Pathian Lungdamna thupha hil hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“A hun hong tung zo hi, Pathian Ngam hong nai zo hi. Na mawnate uh pan kisiik vun a, Lungdamna Thupha um vun!” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesus Galilee tuili hui ah a va laitakin, ngasa paai mihing nii, Simon le a suapuipa Andrew ngeen taw ngasa manin a om mu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesus in, “Hong pai tavun, mihing mante kong suaksak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thakhatin amate in, a ngeen uh nusia in ama zui uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in mai sangah tawm a pai ciang, Zebedee ii tapate James le John te unau mu hi. Amate a ngeente puua in ngunkuang sungah om uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesus in a mu po ciangin sam hi; amate in a pa uh Zebedee le a cial sa naseamte ngunkuang sungah nusia in Jesus zui uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesus le a nungzuite Capernaum khua hong theng uh a, Sabbath kik ni ciangin, Jesus in Jew te ii synagogue ah pai in hilna nei tu in kipan hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A thuhilna a za mihingte in ama thuhil zia lamdang sa uh hi, banghang ziam cile, Thukham hil syate bang hi ngawlin, ama in thuneina taw thuhil hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tua zawk hiat ciangin doaivei pasal khat synagogue sungah hong tumin cik-au hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Nazareth mi Jesus awng, kote bang hong nuammaw ni ziam? Ko hong lalcipsak tu in hi sungah hong pai na hi ziam? Nang akua na hi hunlam hong he khu hi — Nang sia a thiangtho Pathian kamtaipa ni hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesus in doai munah, “Pau heak in, pasalpa sung pan hong pusuak ta'n!” ci in thupia hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Doai in pasalpa thing zazaan a, a nging in a cik-au zawkciang pasalpa sung pan pusuak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihingte theampo in lamdang mama sa uh a, “Bangbang thu hi thong ziam? Tu a sia kihilna thak khat ahi ziam? Hisia pa in doaite tungah thunei a, thu a piak ciangin doai in a thu ni hi!” ci in khat le khat kikum uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuabangin Jesus huvau thupiangte Galilee ngam mun theampo ah manlang takin kizel hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesus in a nungzuite taw synagogue nusia in Simon le Andrew te inn ah paisuak uh hi. Nungzui James le John zongh kihel hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Simon sunghnu a ciina in lum a, suuk hi. Jesus hong thet po ciangin, tua thu ama tungah son hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama in nupinu kungah pai in a khut pan kaito in thosak hi. A ciisa natna thai a, amate zin do hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ni tumin nitak hun a thet ciang, mihingte in Jesus kungah, ciinate le doaiveite paipui uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Khuapi sung pan mihing theampo inn mai ah kikhawm uh hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesus in natna satna namcin taw a na theampo damsakin, doaivei tam mama a doai nawkeaksak hi. Ama in doaite ii pau tu khaam hi, banghang ziam cile amate in Jesus sia akua ziam ci in he uh hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zingtuung khuavak ma in, Jesus tho in tua inn nusia hi. Khuapi puasang a ngamkhingna mun khat ah pai in thungen hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahihang Simon le a kitholpuite in ama zong tu in pai uh hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tuaciang ama a mu uh ciangin, “A kuama po in nang hong zong hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahihang Jesus in, “Hisung kiim le paam khua dangte sung zongh ah ih pai kul tu hi. Tua munte zongh ah thu ka hil kul tu hi, banghang ziam cile, tua nasep ma seam tu in hong pai ka hi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tua hi a, ama in Galilee ngam bup synagogue te ah thuhil in doaite not hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />A lauhuai vun natna vei a nasia mama khat Jesus kungah hong pai a, khupdin in, “Hong damsak nuam po lete hong damsak thei tu ni hi,” ci in hu ngen hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Jesus in ama khuangai huai sa in, a khut vaan in tham hi. “Hong damsak nuam khi hi, dam ta'n,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Thakhatin pasalpa a natna dam thiang paih hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tua zawkciang, Jesus in ama nasia tak talin, paisak paih a,
  </para>
  <para style="p">
    <verse number="44" style="v" />“En in, hi thu kuama munah son heak in. Pai vingveng ta'n a, thiampipa in vealsak ta'n; na thianthona mihing theampo tungah a kilangh natu in, Moses sawl bangin, sangaw biakpiakna vawt ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ahihang pasalpa pai in mun theampo ah hi thupiang sia son kawkoai hi. Pasalpa in nasia tak son ahikom Jesus sia khuapi khat pawpo ah, mipite ii mutang in, a tum ngam nawn bua hi. A ngamkhingna munte ah ama om a, mihingte in mun theampo panin ama kung zuan uh hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni tam kihal ngawlin Jesus Capernaum khua ah pai kik hi, tuaciang ama inn ah om hi, ci in kiza hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tua ahikom mihing tam mama hong kikhawmtua uh a, om natu mun awng zongh om nawn ngawl liangin kongbiang puasia dongin dim uh hi. Jesus in thu a hihil laitakin,
  </para>
  <para style="p">
    <verse number="3" style="v" />pasal li hong theng a, Jesus kungah pumzaw pasal khat puak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahizong mihonpite hu in ciina sia Jesus kung tatak a then zo bua uh hi. Tua ahikom amate in Jesus omna san innkhum sulet uh a, pasalpa phah tungah lumsakin, innkhum a sukletna panin khiasuk uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amate in bangza in upna nei ci sia Jesus in a mu ciang, pumzaw pa munah, “Ka tapa awng, na mawnate hong kimaisak zo hi,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua munah a to Thukham hil syate in,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Banghangin hi bangin pau ngam ziam? Hisia in Pathian min daisakna hi. Pathian bekma in mawnate maisak thei hi!” ci in ngaisun hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thakhatin Jesus in amate ngaisutna teng tel ahikom, “Banghang tuabangin ngaisun nu ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Hi pumzaw pa tungah ‘Na mawnate hong kimaisak zo hi’ cile, ‘Tho in, na phah luakin lampai in,’ ci koisia ol zaw ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua ahibuale Mihing Tapa in leitung mawmaisak theina nei hi, ci in no tungah lak tu khi hi,” ci in pumzaw pa munah,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Tho in, na phah luakin cia ta'n, hong ci khi hi!” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amate mu tangin pasalpa tho a, a phah luakin cia vingveng hi. Amate in lamdang sa mama in, Pathian pok uh hi. “Hi bang peuma mu ngei bua hing!” ci uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesus Galilee tuili hui ah pai kik hi. Mihon khat ama kungah hong pai hi, tuasia ciangin amate thuhil tu in kipan hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pai kawkawm in, Alphaeus ii tapa Levi kici shiadongpa a zum sungah to in a om mu hi. “Hong zui ta'n” ci hi. Levi zongh ding vangiat in zui hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua zawkciang Levi ii inn ah Jesus in an ne hi. Shiadongte honkhat le a dang a kinialnamhte pawlkhat in, Jesus zui a, Jesus le a nungzuite taw an nekhawm uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pharisee a kici Thukham hil syate in, Jesus shiadongte le a kinialnamhte taw an nekhawm in om a mu uh ciangin, “Banghangin ama in mihing tuabangte taw an nekhawm ziam?” ci in dongh uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesus in amate thu kidok za a, “Mihing ciidamte in syavuan tulmaw ngawl a, ciinate bek in syavuan tulmaw uh hi. Mihing zatakhuaite sam tu in kong pai bua a, a kinialnamhte sam tu in kong pai hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hun khat lai in, Tuiphumpa John ii nungzuite le Phariseete an tang uh hi. Mihing pawlkhat Jesus kungah hong pai a, “Banghangin Tuiphumpa John nungzuite le Phariseete nungzuite in an tang a, na nungzuite in, banghangin an tang ngawl ziam?” ci in Jesus dongh uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesus in, “Mopoai an kivaakna sungah leangnate in an ne ngawlin om tu na um uh ziam? Om ngawl tu hi! Zineipa sia amate taw a omkhop laiteng amate in tuabang a ngamta buatu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahihang ni khat ni ciangin zineipa sia amate kung pan hong kila tu a, tuasia ciangin an tang tu hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Kuama in puan lui ek sa sia puan thak taw phaw ngeingawl hi, banghang ziam cile puan thak sia a ton ciangin a lui sia ekkeak tu a, a vang zaisak seseam tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuasia bangma savun thawl lui sungah sapittui thak kuama in thaal ngeingawl hi, banghang ziam cile sapittui thak sia in savun thawl lui sia saantham tu a, a sapittui le a thawl lalcip tu hi. Sapittui thak sia savun thawl thak sungah thaal tu hi zaw hi,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesus sia Sabbath ni khat zungtaang lo pawlkhat kaantan in pai hi. A nungzuite zongh ama taw kithawl a, zungtaang huite hiat tu in kipan uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuasia ciang Phariseete in Jesus munah, “En in, Sabbath ni na nungzuite ii zia bang a ngamtat tu sia ih thukham in khaam hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesus in, “David in bang khat po a neak tu a kisap mama hun laitakin, a ngamtatna sim ngeingawl nu ziam? Ama le a mite a ngilkial hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua ahikom Pathian inn sungah tumin Pathian a kipiasa anluum ne hi. Tua hun laitak sia Abiathar in Thiampi Lianbel a sep laitak hi. Ih Thukham bangin ci leang thiampite bek in hi anluum a neak thei natu ahi hi, ahihang David in ne a, a mite zongh pia hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A thukhupna ah Jesus in, “Sabbath sia mihingte ii phat natu in a kivawt hi a, mihing sia Sabbath atu a kivawt a hi bua hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tua hi a, Mihing Tapa sia Sabbath ngawngawn ii Topa ahi hi,” ci hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua zawkciang Jesus in Jew te synagogue ah pai a, tua munah khut langkhatzaw pasal khat om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesus ngamtat khial tu a encik mihing pawlkhat tua munah om ahikom Sabbath ni in, Jesus in ciina damsak ziam, a damsak bua ziam, ci in encik nginge uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesus in pasalpa munah, “Hi sung mai sangah hong pai ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua zawkciang mipite munah, “Ih Thukham in Sabbath ni in, bang teng sep tu hong oai ziam? Ngual hu tu ziam maw ngual ngim pia tu ziam? Mihing khat ii nuntakna hun tu ziam maw that tu ziam?,” ci in dongh hi. Ahihang amate kam khat zongh a pau bua uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A kiimkot a et ciangin, Jesus in amate tungah thin uuk ahitazong hesuakhuai sa si hi, banghang ziam cile amate a thin uh pui mama a, a ngaisutna uh zongh maan ngawl hi. Tua zawkciang pasalpa munah, “Na khut vaan in,” ci hi. Ama in a khut vaan a, a khut dam kik hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua ahikom Phariseete sia synagogue nusia in thakhatin Herod pawlte pawlkhat taw kisi uh a, Jesus thalup tu in, vaihawmna nei uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesus le a nungzuite Galilee tuili sangah pai uh a, mihonpi in zui hi. Amate in Galilee, Judea,
  </para>
  <para style="p">
    <verse number="8" style="v" />Jerusalem, Idumea ngam, Jordan ngun nisuana sang ngam, Tyre le Sidon khuapite kiim le paam ngamte panin hong pai hi. Hi mite theampo sia Jesus sep le vawt teng a zaak hu in, Jesus kungah hong pai uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing tam mama a, ama a kihencip thak ngawl natu in nungzuite munah ngunkuang khat zongin sawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in mihing tam mama damsak hi, tuaciang natna nei peuma in ama tham tu in kiphul ngawp uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thaa ngilo vei mihingte in a mu uh ciangin, amate mai ah puk in, cik-au uh a, “Nang sia Pathian Tapa ni hi” ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama sia akua ahi hunlam kuama tungah a son ngawl natu in, thaa ngilote munah Jesus in nasia takin thupia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tua zawkciang Jesus in mualtung khat ah kaato in, ama dei teng a kungah samtuam hi. A kungah amate in zuan a,
  </para>
  <para style="p">
    <verse number="14" style="v" />tuaciangin ama in sawm le nii tealin, sawltakte ci in min vaw hi. “Kei taw a omkhawm tu in, no teng hong teal zo khi hi, thuhil tu zongin kong paisak tu a,
  </para>
  <para style="p">
    <verse number="15" style="v" />doaite nawkeak natu thu na nei tu uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sawm le nii a teal teng sia hi teng ahi hi, Simon (Jesus in Peter ci in min a piak sia),
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebedee tapate unau James le John, (Jesus in min pia a, Boanerges ci, a khiakna, “Vanto mihingte”);
  </para>
  <para style="p">
    <verse number="18" style="v" />Andrew, Philip, Bartholomew, Matthew, Thomas, Alphaeus ii tapa James, Thaddaeus, Minam itpa Simon,
  </para>
  <para style="p">
    <verse number="19" style="v" />le Jesus a leeheakpa Judas Iscariot te ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua zawkciangin Jesus inn ah cia hi. Mipi hong kikhawm leleau ahikom Jesus le a nungzuite in anneak hun tu a nga bua uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A innkuanpuite in a zaak uh ciangin ama keam tu in hong pai uh hi, banghang ziam cile mihingte in, “Ama a thin amh zo hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jerusalem pan hong pai thukhamhil sya pawlkhatte in, “Ama sungah Beelzebul om hi!” ci uh hi. “Tuasia doaite sung pan a lianbel sia hi, ama tungah doai nawkeak thei natu vaang a pia sia pa hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tua ahikom Jesus in amate a kungah samin, thusonteena taw amate tungah son hi. “Satan in bangbangin Satan notkeak thei tu ziam?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngam khat sia pawl tuatuamin kikhen hen a, khat le khat kido le tua ngam tamhtham tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Innkuan khat pawl tuatuamin kikhenin, pawlkhat le pawlkhat kido le tua innkuan sia kitamhtham tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua hi a Satan ngam sia pawltuamin kikhen le, kip ngeingawl tu a, tamhtham in bocip tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Thahatpa, a kiletheen phot mateng kuama in a inn phuul zo ngawl tu hi. Tua zawkciang bekma in phuul thei pheang tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“A tatak ka ci ciang, mihingte sia a mawnate le a sia a paunate uh pan kimaisak thei hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahihang Thaa Thiangtho a sonsiate sia, kimaisak ngeingawl tu hi, banghang ziam cile ama in tawntung mawna vawt ahi hi,” Jesus in ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />(Tuabang a ci sia banghang ziam cile mihing pawlkhat in, “Ama sia thaa ngilo vei hi,” a ci uh hang hi.)
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua zawkciangin Jesus nu le a suapuipate hong theng uh hi. Amate in doipua ah dingin, ama taw kimu tu in samsak hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesus kiim ah a to mihonte in, “En in, na nu le na suapuipate le na suapuinute in inn pua panin hong ngak a nangma taw kimu nuam hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jesus in, “Ka nu akua ziam? Ka suapuipate akua ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama in a kiim ah a to mihingte en in, “En vun! Hite sia ka nu le ka suapuite ahi hi!
  </para>
  <para style="p">
    <verse number="35" style="v" />“Pathian dei bang a ngamtate sia, ka suapuipa, ka suapuinu le ka nu ahi hi,” ci in zo kik hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesus in Galilee tuili hui ah hilna nei tu in kipan kik hi. A kiim ah mihing tam mama ahikom ama in ngunkuang sungah tuak in to hi. Tui tungah ngunkuang om a, mihonte tui hui vaalbo ah ding uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama in thusonteena zanghin, thu tam mama hi bangin hil hi:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ngai vun! khatvei lai in, pasal khat thaicii poai tu in kuan hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama in lo sungah thaiciite a poai ciangin, pawlkhat lamzin dung ah taakin, vacimte in tawm khawng uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pawlkhat suang tam, lei daina ah taak hi. A lei thuk ngawl ahikom hai ngawlin, thaiciite poto hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ni hong sat ciangin, ankungnote kaanghlum hi, a zung thuk ngawl ahikom ankungnote ko ngawtaak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thaicii pawlkhat sia lingphung sungah taak a, tua lingte in khannelh in deapcip ahi hu in a nga zo bua hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahihang thaicii pawlkhat sia lei phana ah taak ahikom, a kung hong po a, khangin a nga hong nga hi, tua a nga pawlkhat in, a zaa sawmthum, a zaa sawmluk le a dangte in a zaa zakhat dongin nga hi.”
  </para>
  <para style="p">
    <verse number="9" style="v" />“Bil na nei uh le hi thu za tavun!” ci in Jesus in a thuson khup hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesus ama nguakin a om laitak nungzui sawm le niite le a thuson a za pawlkhatte ama kungah hong pai a, thusonteenate a sontel natu in, dongh uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“No tungah Pathian Ngam thuku sia hong kipia zo hi,” ci in Jesus in zo kik hi. “Ahihang a puasang om ngualdangte in, thusonteena taw veu in a za tu uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuasia ciang: ‘Amate in e en ahihang a mu buatu hi; ngangai tu ahihang a tel buatu hi. Banghang ziam cile amate in mu thei, za thei thong le Pathian kungah heak kik tu uh a, tuaciang ama in a mawna uh maisak tu hi.’ ”
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuaciang Jesus in, “Hi thusonteena tel ngawl nu ziam? Tua ahile thusonteena dangte koibangin tel tu nu ziam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Thaicii poaipa in Pathian kammalte poai hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihing pawlkhatte lamdung ah a taak thaiciite taw kibang hi, a thu a zaak po ciangin, Satan hong pai in laaksak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngualdang pawlkhatte suang tungah a taak thaicii taw kibang hi. A thu a zaak po ciang lungdam takin saang hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahihang a thu in amate sungah thuk bun ngawl ahikom, khuangei a khom bua uh hi. Tua ahiciang tua thu hangin ngimna le vawtsiatna hong pai ciang, thakhat thu in amate pukkik uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngualdang pawlkhatte lingphung sungah taak thaiciite taw kibang hi. Hite sia a thu a zate ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahihang nuntakna tu thinngimna, hau nopna le a dang deinate in deapcip ahikom nga a nga thei bua uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahihang mihing pawlkhatte lei phana a, a kipoai thaiciite bang ahi hi. Amate in a thu za a, saangin, a nga nga uh hi, pawlkhat a zaa sawmthum, pawlkhat a zaa sawmluk, pawlkhat a zaa zakhat dongin nga uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesus in, “Mihing khat pawpo in meiinn hong sungtan pui in kuang nuai ah ahibuale lupna nuai ah koi ngei ka na ziam? Mei vakna khuam tungah koi hi ngawl ziam?
  </para>
  <para style="p">
    <verse number="22" style="v" />A kisealcip thute peuma a kipualaak tu a, a kisiin theampo kihongkeak tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bil na nei uh le za tavun!” ci in zomto hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesus in, “Na zaak uh sia pha takin ngai vun! Ngual tungah na zak thukhenna sia Pathian in no tungah thukhenna in hong zangh tu hi — a nasia zaw lai in thu hong khen tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na pawlkhat a nei sia tungah kipia thua tu hi, bangma a nei ngawl sia tung pan tawm bek a nei sun teng zongh kilaaksak tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesus in a ci lai na panin, “Pathian Ngam sia hi bang ahi hi. Pasal khat in ama lo sungah thaicii poai hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama zanin mu a, sunin diang hi, tua laan theampo in thaicii hong po a hong khang hi. Ahihang bangbangin piang ziam ci in a he bua hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Leitang mama in ankungnote posakin, ngasak hi, a masabel in a kung moi suakin ngap hong toai a, a khakbel in a ngapte sungah a tang a dim in om hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />An a ngau ciangin a kungte mihingte in a phiau taw attan uh hi, banghang ziam cile anlaak hun hong theng ahi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Pathian Ngam sia bang taw kibang ih ci tu ziam?” ci in Jesus in dongh hi. “Bang thusonteena taw sontel tu hi ziam?
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuasia hi bang hi. Pasal khat in ankamhcii, leitung a thaicii a nobel sia la in leisung tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tawmvei zawkciang poto a, ankungte sung pan a lianbel hong suak hi. A baakte zongh lian mama ahikom vacimte hong pai in, a lim bealhin bu vawt uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jesus in mihingte munah hi thuhil a, hi bang thusonteena dang tam mama zongh zangh hi, amate ii tel thei zaza son hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Amate tungah thusonteena ngawl taw thuson nuam ngawl a, ahihang a nungzuite bek a om ciang, amate munah a vekpi in sontel hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tua nitakin Jesus in a nungzuite munah, “Tuili langkhat ah pai tawng,” ci hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuasia ciang amate in mihonte tua munah nusia hi, A nungzuite zongh ngunkuang tungah kaa uh a, tua ii sungah Jesus to khol zo hi, tuaciang amate in ama ngunkuang taw paipui uh hi. Tua munah ngunkuang dang zongh om hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Thakhat thu in nasia tak vuiva a, tuihual ngunkuang sungah kisepsuk hi, tuasia ciangin ngunkuang sung tui dim dektak hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jesus sia ngunkuang nungsang ah lukham khat khamhin mu hi. Nungzuite in phong a, “Syapa awng, thilum siat dek ih hi sia awlmawk ngawl ni ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesus tho a, vuipi tungah “Thim vun,” ci a, tuihual tungah “Kilok heak vun!” ci in thupia hi. Vuipi tawlnga in tuihual thim dikdek hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jesus in nungzuite munah, “Banghangin lau nu ziam? Tu dong upna nei ngawl lai nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahihang amate lau mama uh a, “Hisia pa a bang mihing hi thong ziam? Vuipi le tuihualte ngawngawn in a thu ni hi!” khat le khat kici uh hi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesus a nungzuite taw Galilee Tuili langkhat Gerasa ngam theng hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngunkuang sung pan a pusua po ciang, mithi phumna thaankuul khat sung pan hong pai pasal khat taw Jesus kisi hi. Hisia pa thaa ngilo vei
  </para>
  <para style="p">
    <verse number="3" style="v" />ahikom thaan sungah teang hi. Kuama in ama thikkhau taw zong khit thei nawn ngawl uh hi:
  </para>
  <para style="p">
    <verse number="4" style="v" />tamvei ma a khut le a peang pan thikkhau taw kikhii ahihang a khii simin, ama in thikkhaute saantat in peangkol thikte zongh sutham hi. Ama kuama zaw zawk ngawl tu dongin hat mama hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sun le zan in thaan kawm le mualtung kaantan in vak a, cik-au in ama le ama suanghiam taw ki at bul hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesus a ngalmu ciangin, hong tai a, ama mai ah khupdin in,
  </para>
  <para style="p">
    <verse number="7" style="v" />“A saangbel Pathian Tapa awng! Kei bang hong law nuam ni ziam? Kei daan nong piak ngawl natu in Pathian min taw kong thuum hi,” ci in a aw neiza taw au hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />(Banghangin hi bang ci ziam cile Jesus in, “Thaa ngilo awng, pasalpa sung pan hong pusuak ta'n!” a ci hu ahi hi.)
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua hi a Jesus in, “Na min bang ziam!” ci in dongh hi. “Ka min sia ‘mihonpi’ hi —” ci hi, “Kote tam tatak ka pha uh hi!” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua ngam panin, thaa ngilote a nawkeak ngawl natu in Jesus tungah thaa ngilo in ngen top hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tua mualpangh ah vok honpi khat an zongin taa uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua ahikom thaa ngilote in Jesus munah, “Vokte kung zuanin a sung uh ah ka tum thei natu thu hong pia ta'n,” ci uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama in tuabangin thupia a, doaite in pasalpa sung panin pusuakin vokte sungah tum uh hi. Vok hon bup — tulnii bang a pha tu teng — liangpangh ah kinuntaw ngawp a, tuili sungah tuitaa in thi siat hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vokcingte tai in, hi thu khuapi sung le lote sungah kizelsak hi. Mihing tam mama in bang thupiang ci en tu in pai tek uh hi,
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesus kungah a thet uh ciangin, doai hon tam mama a vei pasalpa mu uh hi. Tua pa sia tua munah to a, puan silhin thinciim in om hi, tuasia ciang amate theampo lau uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A mute theampo in doaivei pasalpa tung le vokte tungah bang thupiang ci thu ngual munah sonsawn uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua ahikom amate ii ngam a nusiat natu in Jesus sawl uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesus ngunkuang tungah kaa tu a kithoai ciangin doaivei ngeipa in “Hong zuisak ta'n,” ci in ngen hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahihang Jesus in a zuisak nuam bua hi. “Na inn ah cia zaw ta'n a, Topa in nang tungah bang hong vawt a, bangza in hong dik ziam ci thu na innkuanpuite munah son ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua ahikom pasalpa pai in Khuapi Sawmte ah ama tungah Jesus ii nasepna teng son hi. A za theampo in lamdang sa uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesus in tuili kaantan in a langkhat ah pai hi. Tua tuili hui ah mihonpi khat Jesus kiim ah kikhawm uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jew te synagogue khat a lampui upa Jairus kici khat in, Jesus peang ah bok a,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Ka tanu zawm mama hi. Hong dam kik natu in, hong pai in a tungah na khut hong ngaksak ta'n,” ci in nasia takin ngen hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaciang Jesus in ama taw paikhawm hi. Mihing tam mama Jesus taw tonkhawm ahikom a kiim theampo pan kiphulung uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kum sawm le kum nii tawntung chibua natna nasia mama a thuak numei khat tuate sungah om hi,
  </para>
  <para style="p">
    <verse number="26" style="v" />syavuan tam mama te in bawl a, a sum a paai theampo bo in kibawl ahihang damzaw ngawlin lawmawk seseam hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in Jesus thu za ngei ahikom mihonte sung Jesus nungsang pan zui in,
  </para>
  <para style="p">
    <verse number="28" style="v" />“A puanmong beak tham thei leng dam tu khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A puan a thamsak ciang a chibua sia thakhatin kang hi, tuaciang a ngim ngana pan damna a nga hunlam kiphawk hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thakhatin ama sung pan vaangletna pusuak hi ci in Jesus in, phawk a mipite sangah kiheak in, “Akua in ka puan hong tham nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A nungzuite in, “Mihonpite ii hong neakcip na mu hi, bangbangin akua in hong tham nu ziam, ci ni ziam?” ci in zo kik uh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahihang Jesus in ama a tham sia a tel dong en kawkoai hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Numeinu in ama tungah bang thupiang ci in phawk ahikom, lau in liing a, Jesus sangah pai hi, a peang ah khupdin in, ama tungah a thu theampo son siat hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Ka tanu awng, na upna in hong damsak zo hi. Thinnuam in va pai ta'n, na ngim ngana pan dam ta'n,” Jesus in ci hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuabang Jesus a pau laitakin Jairus inn pan kamtai pawlkhat hong pai a, “Na tanu thi zo hi, banghangin Syapa ngim pepia lai ni ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jesus in amate thuson nangonthaakin, “Lau heak in, um po in” ci hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tua zawkciang Peter, James le a suapuipa John simngawl ngualdang kuama a paipui bua hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amate Jairus inn theng uh a, a kap taw a au taw buai in om Jesus in mu hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ama sungtang in tua mihingte munah, “Banghangin hi bangin buai nu ziam? Banghangin kap nu ziam? Numeino thi ngawl hi, a mu hi bek hi,” ci hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Amate in ama nuisan uh hi. Tua ahikom amate theampo, doipua ah pusuaksak siat a, numeino ii pa, a nu le nungzuite thum taw inn doituamna sung numeino lupna ah tum uh hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ama in numeino sia a khut pan kaito a, ama tungah, “Talitha, koum,” ci hi. A khiakna sia “Numeino awng, tho in hong ci khi hi,” cina ahi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ama thakhat thu in thoto a, a kiim tengah kotva tu in kipan hi. (Ama kum sawm le kum nii pha hi.) Hi bangin, hong pian ciangin, mihingte in lamdang sa mama uh hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ahihang Jesus in kuama munah a son ngawl natu in, nasia takin khaam hi, tuaciangin, “Bang khat pawpo a neak tu pia vun,” Jesus in ci hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesus in tua mun nusia in ama khua Nazareth ah cia kik a, a nungzuite in zui uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sabbath ni in synagogue ah thuhil tu in kipan hi. Tua munah mihing tam mama om hi; tuaciang ama thuson a zaak uh ciang, amate in lamdang sa tek uh hi. “Hite theampo koisung pan ama in nga ziam?” ci uh hi. “Ama tungah a kipia ciimna bang ciimna ziam? Ama in nalamdang laknate bangbangin vawt thei ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama Mary tapa James, Joseph, Judas le Simon ii suapui lettamapa hi ngawl ziam? A suapuinumeite zongh hi sung ma ah teang siat hi ka na ngawl ziam?” ci uh hi. Tua bangin ama a saang zo bua uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesus in, “Kamsaang khat sia ama khua, ama beete le a innkuanpuite simngawl po in, mun theampo ah zakta uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ciina tawmte tungah khut nga a, a damsak simngawl tua munah nalamdang laknate, a vawt thei bua hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in mihingte ii upna a nei ngawl uh sia, lamdang sa mama hi. Tua zawkciangin Jesus in tua mun kiim le paamte ah pai in mihingte hilna nei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama in nungzui sawm le niite samin, nii veu nii veu paikhawm tu in sawl hi. Doai ngilote tungah thuneina amate tungah pia a,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Na khualhawna uh ah, ciangkhut simngawl a dang keng heak vun — anluum hikale, an khonna ip hikale, sum hikale, na ipno sungah pua heak vun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Peangdapte thua vun a, ahizong laktong keng thua heak vun.
  </para>
  <para style="p">
    <verse number="10" style="v" />No hong saangna inn ah tung tavun a, tua mun pan na din kik uh mateng tua inn ah taam tavun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khua khat po ah no hong kisaang bua a, hong ngai nuam bua ahile, nusia vun a, na peang tung leivuite na thin tavun. Tuate amate kidop natu thupiakna ahi hi,” ci thua hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuabangin amate pai in mihingte a mawna uh pan a kisiik kik natu thuhil uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate in doaite tam mama notkeak in, ciina tam mama olive thau taw zut in damsak uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tu in Herod Kumpipa in hi thute theampo za hi, banghang ziam cile, Jesus ii minthanna mun theampo ah kizel hi. Mihing pawlkhat in, “Tuiphumpa John nungta kik hi! Tua hu in ama in nalamdang vawt thei natu, vaang nei hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A dangte in, “Ama Elijah hi,” ci uh hi. Ahihang a dangte in “Ama taanghlai kamsaangte bangin kamsaang khat hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Herod in a zaak ciangin, “Ama sia Tuiphumpa John hi! A lu ka tansak sa hi napi, hong nungta kik hi!” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Herod ama mama in, John a mat natu in thupia a, thikkhau khii in thong sungah khum hi. Herod in hi bang a, a ngamtat sia banghang ziam cile a suapuipa Philip ii zi Herodias a teenpui hang ahi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuiphumpa John in Herod munah, “Na suapuipa ii zi na teenpui sia suak ngawl hi!” a ci tawntung hang ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tua ahikom Herodias in John tungah lungkim ngawlin, thalup sawm ahihang Herod hu in a that thei bua hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Herod in John kiita hi, banghang ziam cile John sia mihing thiangtho, mihing pha hi ci in he a, tua ahikom ama keamcing hi. A hilna a zaak simin a thin nawngkai mama ahitazong, Herod in John thuson ngai nuam hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A khakbel ciang Herodias in hunpha khat nga hi. Herod suani hi a, ama in kumpi sung ulianbel theampo, ngalkapmangte le Galilee ii khuanu khuapa te atu in poai vawt hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Herodias ii tanu pai in hong laam a, Herod le a leangnate theampo lungkim uh hi. Tua ahikom Kumpipa in ngaknu nu munah, “Bang na dei ziam? Na dei pawpo hong pia tu khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Nong nget theampo hong pia tu khi hi, ka ngam a lang khen dongin hong pia tu khi hi, ci in ka kiciam hi!” ci in kamciam tam mama pia hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuasia ciang ngaknu nu pusuak a, a nu munah, “Bang ngen tu khi ziam?” ci in dongh hi. “Tuiphumpa John ii lutang,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngaknu nu kumpipa kungah manlang takin, heak kik a, “Tuiphumpa John ii lutang, tu mama in hi lai ah kuangdal khat tungah hong pia ta'n,” ci in ngen hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kumpipa sia hi thu huvau in khuangai mama hi, ahihang a leangna theampo ii mai a kiciamna a vawtsate hu in, a nial thei bua hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua ahikom a cing khat paisak paih in, John ii lutang hong paipui natu thupia hi. A cingpa pusuak in, thong sungah pai a, John ii lutang saattan hi;
  </para>
  <para style="p">
    <verse number="28" style="v" />tuaciang kuangdal khat ii tungah koi in ngaknu nu pia a, tua nu in a nu pia sawn hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />John ii nungzuite in hi thu a zaak uh ciangin, a luang la in vui uh hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sawltakte hong cia kik uh a, Jesus taw kisi in, amate sep teng le hilna teng ko uh hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mihing a pai a cia kithalee in tam mama ahikom, Jesus le a nungzuite anneak hun zongh a nga bua uh hi. Tua ahikom amate munah, “Eima teng nguak mun khat ah pai in, tawmvei no sung na toitan thei natu uh in, eima bek om tawng,” ci hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tua ahikom amate ngunkuang taw pai in, a ngamkhingna mun khat zuan uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahitazong, mihing tam mama in, amate pai mu uh a, a kuate ziam ci in tel paih ahikom, khuapi theampo pan hong pai uh a, leilam tawn in amate mai ah tai in, Jesus le a nungzuite thet ma in, tua munah theng uh hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesus in hi mihonpi khat a mu ciang, khuangai huai sa hi, banghang ziam cile amate sia tuucing nei ngawl tuuhonte bang ahi hi. Tua ahikom amate thu tam mama hil tu in kipan hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ni hong niam ciangin, nungzuite ama kungah pai uh a, “Tu in ni zongh niam mama zo a, hi sung sia ngamkhing mama mun khat ahi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mipite lo sung ahizong, khuano sung ahizong, a neak tu khat pawpo lei tu in paisak in,” ci hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Noma in a neak tu khat pawpo pia vun,” ci in Jesus in zo kik hi. “Amate vaak natu ngunn dangka zanii manh anluum lei le hong oai ni ziam?,” ci in amate in dongh uh hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tua ahikom, Jesus in, “Anluum bangza nei nu ziam? Pai in en tavun,” ci in dongh hi. “Anluum nga le ngasa nii kinei hi,” ci in zo kik uh hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesus in a nungzuite munah mipite a pawl a pawlin, lopa hing tungah tosakin sawl hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tua ahikom mipite a ngui in to a, pawlkhat zakhat, pawlkhat sawmnga in to uh hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tua zawkciang Jesus in anluum nga le ngasa nii teng la a, van ento in, Pathian tungah lungdamko hi. Ama in anluumte baltham in mipite hawmsak tu in a nungzuite tungah pia hi. Ngasa pum nii te zongh, amate sungah hawm siat hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />A om theampo in a kham in ne tek uh hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tua zawkciang nungzuite in, anluum le ngasa a khamvaal uh khum sawm le khum nii dimin seng lai uh hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />An a kivaak sia pasal tulnga pha hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Mipite a ciasak lanin Jesus in nungzuite ngunkuang tungah tosak a, tuili langkhat Bethsaida khua ah a paikhol tu in sawl hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kikhen natu mipite tungah mangpha a thaak zawkciang ama thungen tu in mual tungah kaato hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nitak ciangin ngunkuang tuili laizang ah theng a, Jesus ama nguakin lei ah om hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ama in a nungzuite ngunkuang nasia tak hotin a om mu hi, banghang ziam cile amate in vui vakna sang maingat in hot uh hi; tuaciang zingsang nai thum le nai luk kilaklaw in Jesus amate sang tui tungah lam hong pai hi. Ama in a nungzuite suang khial tu in kithoai a,
  </para>
  <para style="p">
    <verse number="49" style="v" />ahihang amate in tui tungah Jesus lam a pai mu uh hi. “Thithaa hi,” ci in ngaisun in cik-au uh hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ama a mu uh ciangin, amate a lau tek mama uh hi. Jesus in amate thakhatin paupui a, “Na thin uh liansak vun! Keima khi hi. Lau heak vun!” ci hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tuaciangin ama ngunkuang tungah to a, tuasia ciangin vui hong thim hi. Nungzuite in lamdang mama sa uh a,
  </para>
  <para style="p">
    <verse number="52" style="v" />banghang ziam cile amate in, mihing tulnga an kivaakna ii a khiakna tatak a tel bua uh hi; amate ngaisutna in a ban zo bua hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Amate in tuili kaantan in, Gennesaret vaalbo ah kaa a, tua munah a ngunkuangte khau khit uh hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Amate in ngunkuang a nusiat po ciang, mihingte in Jesus meal tel paih uh hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tua ahikom mihingte in ngam bup sungah del kawkoai uh a; ama om hi a kici na mun theampo ah ciinate phah tungah sialin ama kungah puak uh hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Jesus paina po khuapi, khuano le lo sung a om mihingte in ciinate vanhzuakna phual ah paipui uh a, a puanmong beak a tham tek thei natu in, ama tungah ngen uh hi, tuaciang a thamte theampo dam uh hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerusalem pan hong pai Phariseete pawlkhat le Thukham hil syate pawlkhat, Jesus kiim ah kikhawm uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amate in nungzui pawlkhatte an a neak tu ciang ngeina bangin, khut thiang ngawl taw an ne mu uh hi — koibang ziam cile amate in Phariseete hil bangin, a khut uh sil ngawl hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />(Phariseete le Jew te peuma in, amate ii taanghpupite hil, ngeina tuatuamte nasia takin zui uh hi: a khut uh ahi tu bangin a sil bua uh le an ne ngawl uh hi;
  </para>
  <para style="p">
    <verse number="4" style="v" />vanhzuakna phual pan a kinga peuma, tui taw sil phot ngawlin ne ngawl hi. Hai, kuang le beal, taausankuang le lupnate ahi tu bang a, silthiang natu ngeina dang tam mamate zui uh hi.)
  </para>
  <para style="p">
    <verse number="5" style="v" />Tua ahikom Phariseete le Thukham hil syate in Jesus munah, “Banghangin na nungzuite in, taanghpupite hil ngeinate zui ngawlin, an a neak tu uh ciang a khut thiang ngawl taw an ne ziam?” ci in dongh uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesus in a zo kikna ah, “Isaiah in note thu a sonkholna bangza in maan ziam! A kihitheamsak minamte awng, ama in hi bangin at hi: ‘Pathian in, hi mite in a kammal bek uh taw, kei zatakna hong pia uh hi, ahihang a thinsung uh kei taw kikhuala uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate ii hong biakna sia kimanna om ngawl hi, banghang ziam cile amate in mihingte vawttawm ngeinate Pathian ii Thukham bangin hil uh hi!’ ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“No in Pathian thupiakte vawkin mihingte ii hilnate na ni uh hi.”
  </para>
  <para style="p">
    <verse number="9" style="v" />“Noma ii kihilna te na kholet thei natu in Pathian thukhamte na nial zia uh na thiam uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bang ci nuam khi ziam cile Moses in ‘Na nu le na pa thasia vun,’ tuaciang, ‘A kuama po a nu a pa a haamsiat sia thina thuak tahen,’ ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahihang no ii hilna ah nu le pa hu natu in a kizangh thei na khat pawpo sia, ‘Hi sia Corban,’ hi, (Pathian atu a kipiasa hi) ci po le,
  </para>
  <para style="p">
    <verse number="12" style="v" />nu le pa a hu ngawl hangin, phamaw ngawl hi, ci nu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hi bang kihilnate khat tung pan khat na kipiak sawn uh ciang Pathian kammal a mel suak nu hi. Hi thu taw a kibang na ngamtatna dang uh zongh tam mama om lai hi,” Jesus in ci thua hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesus in mihonpite khatvei ma sam kikin, “Na vekpi in hong ngai tavun a, tel vun.
  </para>
  <para style="p">
    <verse number="15" style="v" />A pua sang pan hong tum nate bangma in, mihing khat sia zeksa taw kisai in ninsak ngawl hi. A sung pan hong pusuak to sia in mihing khat ninsak hi zaw hi,
  </para>
  <para style="p">
    <verse number="16" style="v" />Bil a neite in za tavun” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama mihonpite nusia in, inn sungah a tum ciang, a nungzuite in, hi hilna hong sontel ta'n ci uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“No sia ngualdangte sangin ciimzaw tuan ngawl nu hi. Tel ngawl nu ziam? A pua sang pan hong tum suk na khat pawpo in mihing khat sia ninsak ngawl hi,
  </para>
  <para style="p">
    <verse number="19" style="v" />banghang ziam cile a thinsung ah tum ngawlin, a ngilpi um sungah a tum zawkciang a pua sangah pusuak hi,” Jesus in ci hi. (Hi bang a ci ciang Jesus in, an a minpiang neak tuak hi, ci ahi hi.)
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuaciang ama in zomto a, “A sung sang pan hong pusuakte in mihing khat ninsak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Banghang ziam cile mihing khat ii a sung, a thinsung panin ngaisutna pha ngawl piang a, tuate in paktatna, kisutolna, kithalupna,
  </para>
  <para style="p">
    <verse number="22" style="v" />nupa kipalngulna, duhopna, ngamtat siatna tuatuam; kitheamna, maizummawkna, ki enna, kingensiatna, kiphatsakna, le mawmawtna —
  </para>
  <para style="p">
    <verse number="23" style="v" />hi siatnate theampo sia mihing khat ii sung pan hong pai nate hi a, tuabangte in amate ninsak hi,” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua zawkciangin Jesus Tyre khuapi hui ngamkhen ah pai tu in ding hi. Inn khat sungah tum a, tua munah ama a om hunlam kuama heak tu oai ngawl ahihang a bucip zo bua hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A tanu thaa ngilo vei nupi khat in, Jesus thu za ahikom thakhatin hong pai a, a peang ah bok hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nupinu sia Gentile mi hi a, Syria ngam Phoenicia ngamkhen sung pan a piang ahi hi. Ama in a tanu sungah a om doai a nawkeaksak natu in Jesus munah ngen hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahihang Jesus in, “Tanote vaak masa phot tawng, tate ii anneak laaksakin, ui piaksak tu kilawm ngawl hi,” ci hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Topa awng, tano teng an neakmongte sabuai nuai pan, ui ngawngawn in ne lai buang hi ngawl ziam!,” ci in nupinu in zo hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tua ahikom Jesus in, “Tuabangin nong zona hangin, va cia ta'n, doai sia na tanu sung pan pusuak zo hi cisia na mu tu hi!” ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nupinu a inn ah cia a, a sung pan doai pusuak sa a tanu lupna tungah a lum mu hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesus in Tyre kiim le paam teng nusia in Sidon kaantan in Galilee ah pai a, Khuapi Sawm ii ngamkhente tawn hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mihing pawlkhat in pasal nangong a pau thei ngawl khat hong paipui a, ama tungah Jesus ii a khut a ngak natu in ngen uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tua ahikom Jesus in ama nguakin mihonpite kung pan a khuala thithimna ah samtuam a, pasalpa ii bil sungah a khutme thunin, cilphii in pasalpa ii leei thamsak hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tua zawkciang Jesus in, van ento a, phiing vahumin, “Ephphatha,” “Kihong in!” ci hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thakhatin pasalpa in khuaza thei a, a pau thei ngawlna pan olno takin pau kik thei hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuaciangin mipite munah hi thu kuama tungah a son ngawl natu in, ama in khaam vaial kale mipite in son vaial uh hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A za theampo in lamdang sa mama uh hi. “Na theampo bangza in vawt thiam ziam! Ama in nangongte ngawngawn khua zasak thei a, a pau thei ngawlte dongin pausak thei hi,” ci uh hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuazawk khuangei ngawlin mihon dang khat hong kikhawm hi. Tua mihingte anneak tu bangma a nei nawn ngawl uh ciangin, Jesus in a nungzuite a kungah sam a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hi mite khuangai huai ka sa hi, banghang ziam cile amate in ni thum tawntung kei taw hong omkhawm a, tu in bangma neak tu nei nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />An ne ngawlin ciasak leang, lamkaal ah pukhong siat tu hi, banghang ziam cile pawlkhatte a khuala pek pan hong pai ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A nungzuite in, “Hi sung sennealngam ah koisung panin, mihing hi za ii anneak tu mu tu hi ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Anluum bangza nei nu ziam?” ci in Jesus in dongh hi. “Luum sali” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in mihonte lei ah to tu in sawl hi. Tua zawkciang ama in anluum sali teng la in, Pathian tung lungdamko in, balneen a, nungzuite ii mihonte a hawmsak tu in pia hi; tuabang ma in nungzuite in hawm uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate in ngasa no pawlkhat zongh nei uh hi. Jesus in hite atu lungdamko a, nungzuite tungah hawm vun ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing sim in ne uh a, kham tek uh hi — an ne mihing theampo 4,000 bang pha hi. Tua zawkciangin nungzuite in an neakmong a khop ciang khum sali dim pha hi. Jesus in mipite ciasak a,
  </para>
  <para style="p">
    <verse number="10" style="v" />thakhat thu in nungzuite taw ngunkuang tung zuanin Dalmanutha ngam ah pai uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Phariseete pawlkhat Jesus kungah pai a, ama taw kam kinial uh hi. Amate in Jesus thaangsia bangin sia nuam ahikom Pathian lungkimpuina a om le a om ngawl a tel nopna in, nalamdang lakna khat ngen uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahihang Jesus phiing vahumin, “Banghangin tu lai mihingte in nalamdang lakna veu hong ngen ziam? Hong pia ngawl tu khi hi kong ci hi! Hi mihingte tungah tuabang laknate kipia ngawl tu hi!” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate nusia in ama ngunkuang tung zuan kik a, tuili ngalkhat ah pai tu in kipan hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nungzuite in anluum a kicing a ken tu mangil a, ngunkuang sungah luum khat bek nei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Kidawm vun a, Phariseete le Herod ii tol panin, kikeam tavun,” Jesus in ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amate sung teng tua thu kikum uh a: “Hi bang a hong ci sia anluum ih nei ngawl hang a, hong ci hi vak,” ci uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesus in amate kikup tuamna teng tel paih ahikom, “Banghangin anluum nei ngawl huvau kikum nu ziam? Tel ngawl lai, he ngawl lai nu ziam? Na thin uh kiphel ngawl het ziam?
  </para>
  <para style="p">
    <verse number="18" style="v" />Mit nei napi — mu thei ngawl nu ziam? Bil nei napi — za thei ngawl nu ziam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Anluum nga taw mihing tulnga ka vaak lai in, a khawn laak uh bangza khawm kana nu ziam? Ciamtee nawn ngawl nu ziam?” ci hi. “Khum sawm le khum nii,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Tuaciang anluum sali taw mihing tulli ka vaak lai in a khawn laak uh khum bangza khawm kana nu ziam?” ci hi. “Khum sali,” ci in zo uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Tua hi napi tel ngawl lalai nu ziam?,” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amate Bethsaida khua hong theng a, ama ii tham tu in mittaw pasal khat mihing pawlkhat in Jesus kungah hong paipui hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesus in mittawpa ii khut pan len a, khua pua sangah paipui hi. Pasalpa mittang ah a cilphii zawkciang Jesus in ama tungah a khut nga a, “Khua na mu thei ziam,” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pasalpa in khuadak a, “Mihingte mu thei khi hi, ahizong amate thingkung lampaite taw kibangin ka mu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesus in pasalpa mittang tungah a khut nga kik hi. Tuasia ciang pasalpa in khua pha tatak a et le, khuamu thei kik a, na theampo thiang takin mu thei hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesus in a inn ah ciasak a, “Tua khuano sungah pai kik nawn heak in,” ci in thupia hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tua zawkciang Jesus le a nungzuite Caesaria Philippi khua hui khuanote ah pai uh hi. A pai kawmin, “Ngual in kei akua hi hong ci ziam,” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Pawlkhat in Tuiphumpa John hi hong ci hi, a dangte in Elijah hi hong ci a, kamsaang sung pan khat hi hong ci zongh om hi,” ci in zo kik uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Note in kei akua hi nong ci uh ziam?” ci hi. Peter in, “Nang sia Messiah ni hi,” ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuasia ciang Jesus in, “Kei huvau kuama munah son heak vun,” ci in thupia hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua zawkciang Jesus in a nungzuite hilna nei tu in kipan hi. “Mihing Tapa in nasia takin ngimna thuak tu a, upate, thiampi liante le Thukham hil syate in nial tu uh hi. Ama thatlum tu a, ni thum zawkciang nuntakna sungah tho kik tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ama in hi thu amate tungah thiangson mama hi. Tua ahikom Peter in ama sam tuamin teih hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahihang Jesus hong kingeilee a, a nungzuite en in, Peter teih hi. “Kei kung pan tai in Satan awng, na khua ngaisutna Pathian kung pan hong pai hi ngawlin, mihing pianzia sung pan hong pai ahi hi!” ci hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tua zawkciang Jesus in mihonte le a nungzuite ama kungah sam a, “Mihing khat po in kei hong zui nuam le, ama le ama kinial in, a thinglamtee pua in hong zui tahen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Banghang ziam cile a nuntakna a huu nuam sia in a nuntakna taan tu hi; ahihang kei hang le Lungdamna thu hang a nuntakna a taan sia in a nuntakna huu tu hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mihing khat in simlei bup a nga hangin, a nuntakna a taan le meetna nei tu ziam? Meet ngawl tu hi!
  </para>
  <para style="p">
    <verse number="37" style="v" />A nuntakna a nga kik natu in, a piak thei tu bangma om ngawl hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pathian nei ngawl, hi seksolna khang hun sungah mihing khat po in, kei le keima thu hangin, a mai a zum le, Mihing Tapa sia Pa ii vaangletna le a thiangtho vantunglalangte taw hong paikhop ciangin, Mihing Tapa zongh in tuasia pa atu a maizum tu hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuaciang ama pau thua lai a, “A tatakin kong ci ciang, hi sungah a om mihing pawlkhatte in Pathian Ngam sia vaangletna taw hong pai a mu uh mateng a thi buatu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni luk zawkciang Jesus in Peter, James le John te samin mualsaang khat tungah kaato pui hi, tua munah amate teng bek om uh hi. Amate mu tangin Jesus meal hong kikheal a,
  </para>
  <para style="p">
    <verse number="3" style="v" />tuaciang a puansilhte paakin tee a — leitung a khat pawpo ii thiansak thei sangin paak zaw lai hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuaciang nungzuite thum in Jesus sia Elijah le Moses taw thuson khawmin a om mu uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Peter in Jesus munah, “Syapa awng, hi sungah ih om sia bangza in pha ziam! Buk thum sa tawng, khat nang atu, khat Moses atu, khat Elijah atu,” ci hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama le a lawmte lau mama ahikom a pau tu he meal ngawl uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuaciangin meeikaai khat hong piang a, a limh taw amate tuamcip hi, tuaciangin meeikaai sung panin aw khat in, “Hi sia ka it ka tapa hi — ama thu ngai vun!” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amate in manlang takin a kiimkot a et uh le kuama dang a mu bua uh a, Jesus bek amate taw om a mu uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mualtung pan hong tuaksuk ciangin Jesus in, “Mihing Tapa sia thina pan a thaw kik mateng in na mu uh teng kuama munah son heak vun,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amate in a thupiak bangin om uh hi, ahihang amate sung teng kikum uh hi. “Thina pan tho kik ci sia bang a cinopna ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuaciang amate in Jesus munah, “Thukham hil syate in banghangin Elijah hong pai masa tu ci ziam?” ci in dongh uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A zo kikna pan, “Na theampo puua khol tu in Elijah hong pai masa takpi hi. Ahitazong, Mihing Tapa in nasia takin thuak tu a, ama kinial tu hi, banghangin Laithiangtho in ci ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahihang a tatakin kong ci ciang, Elijah hong pai takpi zo hi. Laithiangtho ii ama thu a sonsa bangma in, mihingte in amate uuk bang po in ama vawt uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate nungzui dang teng kungah a thet ciang, a kiim ah mihonpi na om a, Thukham hil syate taw kam kinial in om a mu uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihonpite in Jesus a mu ciangin lamdang sa mama uh a, ama delin muak tek uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesus in a nungzuite munah, “Amate taw bang teng kinial nu ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihon sung pan pasal khat in zo a, “Syapa awng, nangma kungah ka tapa kong paipui hi, banghang ziam cile ama doaivei in a pau thei bua hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thaa ngilo ii ama a vawtsiat simin, leiliik in, a kam pan cilphuan tha a, a haci in, a pum buppi tak hi. Na nungzuite munah thaa ngilo hong nawkeaksak natu ka nget hang, amate in a not zo bua uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesus in, “Bangzata in a um ngawl mihingte hi thong nu ziam! Bang tanvei no taw hong omkhawm zo tu khi ziam? Bang tanvei hong khual zo tu khi ziam? Patang sia ka kungah hong paipui tavun!” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amate in patang sia Jesus kungah paipui uh hi. Jesus a mu po ciang thaa ngilo in patang sia kikaikinsak a, lei ah pukin kilumliik a cilphuan tha hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesus in, “Hi bang ahithei zawk ngei zo ziam?” ci in a pa dongh hi. “A no lai pan ma hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Tamvei ma doai in ama thatlum nuamin meikuang sung le tui sungah lawn nithi hi,” ci hi. “Nong hu theina a om le, ko hong hesuak ta'n a hong hu ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesus in, “Nangma mama in na um nale hong hu thei khi hi, upna a nei khat tungah na theampo suak thei hi,” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thakhatin a pa au a, “Upna nei khi hi, ahihang kicing tham ngawl hi. A kicing zaw ka nei natu in hong hu ta'n!” ci hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mipite in ama uumci tu a kithoai sia Jesus in mu ahikom thaa ngilo tungah, thupia a, “Nangong le a pau thei ngawl thaa ngilo awng, patang sung pan hong pusuak ta'n a, ama sungah tum kik nawn heak in, ci in thu kong pia hi,” ci hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thaa ngilo cik-au a, patang sia nasia takin a kikaikinsak zawkciang pusuak hi. Patang sia mithi luang bang hi a, a kuama po in “Ama thi zo hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahihang Jesus in patang khut pan zamh a, a phokto ciang ama hong ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesus inn sungah a sungtan zawkciang a nungzuite in a tuamin dongh a, “Banghangin kote in doai not zo ngawl khu ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Hi bangte sia thungetna simngawl nadang in notkeak thei ngawl hi,” Jesus in ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesus le a nungzuite in, tua mun nusia in Galilee kaantan in pai uh hi. Jesus in ama omna kuama heak tu a dei bua hi,
  </para>
  <para style="p">
    <verse number="31" style="v" />banghang ziam cile ama in “Mihing Tapa in ama a thatlum tu mihingte tungah ki aap tu hi. Ahihang ni thum zawkciang nuntakna sungah ama tho kik tu hi,” ci in a nungzuite hil hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahihang amate in hi hilna bang ziam ci in a tel bua uh a, dongh zongh a dongh ngam bua uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amate Capernaum khua hong theng a, inn sungah a tum zawkciang, Jesus in a nungzuite munah, “Lampai kawmin na kinial uh sia bang thu ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahihang amate in a zo kik nuam bua uh hi, banghang ziam cile lampi tungah a kinial uh thu sia, akua lianbel ziam ci thu ahihang hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesus to a, nungzui sawm le niite samin, hi bangin ci hi, “A kuama po note sungah, a lianbel tu a nuam sia in, ama le ama a nobel in kikoi in, ngual theampo ii naseam in na om uh kul tu hi.”
  </para>
  <para style="p">
    <verse number="36" style="v" />Tua zawkciang ama in patangno khat lenin, amate mai ah dingsak hi. Patangno sia koai in hi bangin ci hi,
  </para>
  <para style="p">
    <verse number="37" style="v" />“A kuama po ka min taw hi patangte khat a saang sia in kei hong saang ahi hi; tuaciangin a kuama po kei hong saang sia in kei bek hong saang ngawlin kei hong sawlpa zongh a saang ahi hi”
  </para>
  <para style="p">
    <verse number="38" style="v" />John in, “Syapa awng, pasal khat in nangma min taw doai a nawnot ka mu uh a, a kheal natu ka sawl uh hi, banghang ziam cile ama ei pawl ahi bua hi,” ci hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesus in, “Thoh heak vun, banghang ziam cile kei min taw lamdang lakna a vawt khat in kei hong sonsia memeang ngawl tu hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Banghang ziam cile ei lang hong pang ngawl po, ei sang a hong kipawl ahi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />A tatakin kong ci ciang, keima mi na hi uh hu in, tuidam hai khat hong sua sia in, a thaman saang tatak tu hi.”
  </para>
  <para style="p">
    <verse number="42" style="v" />“Hi patangno khat ii kei hong upna a bosuasak mihing khat sia a ngawng ah an ngoaina suang lian khat khi hen a, tuipi sungah kivawk le phazaw hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tua ahikom na khut khat in na upna hong lalsak le saattan in! Khut nii taw hell ngam, a mit ngeingawl meisa sungah na pai uh sangin, khut langkhat nguak taw nuntakna sungah tum le uhte phazaw hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tua munah amate a ne thanhte in thi ngeingawl a, amate a hal mei in mit ngeingawl hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tuaciang na peang khat in na upna a lalsak le, saattan in! Hell sungah peang kim in na pai uh sangin, peang lang nguak taw nuntakna sungah tum zaw le uhte phazaw hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tua munah amate a ne thanhte in thi ngeingawl a, amate a hal mei in mit ngeingawl hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tuaciang na mittang khat in na upna uh a lalsak le khelkeak in! Pathian Ngam sungah mittang langkhat nguak taw tum le uhte hell sungah mittang cingin hong kivawk sangin phazaw hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />‘Tua munah amate a ne thanhte in thi ngeingawl a, amate a hal mei sia mit ngeingawl hi.’
  </para>
  <para style="p">
    <verse number="49" style="v" />“Sangaw biakpiakna sia ci al taw a kithiansua bangma in, mihing sim zongh meikuang in thiansua tu hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />“Ci al sia pha hi; ahihang ama in a alna a bosua le, bangbangin alsak kik thei tu nu ziam?” “Na sung uh a, kingualtamh theina ci al na nei tavun, khat le khat kilemna taw na om tavun,” ci hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua zawkciang Jesus in tua mun nusia in, Judea ngam ah pai a, Jordan Ngun kaantan hi. Mihonpite hong kikhawm kik a, a hil ngei tawntung sa bangma in amate hil hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phariseete pawlkhat ama kungah hong pai a, ama aitaa tu in hong kipan uh hi. “Ih Thukham in, pasal khat in a zi a khul tu oai ziam hong son ta'n,” ci uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesus in thudokna khat taw zo a, “Moses in bang thukham hong pia ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amate zo kikna pan, “Moses in pasal khat sia a zi a khul natu in, lai pia pole, khul thei hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesus in amate tungah, “Moses in hi bang thukham a at sia banghang ziam cile noma hil zawk a pang ngawl na hi uh hang hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahihang a kipatciil bitphua hun lai in, laithiangtho ii ci bangin ci leang, ‘Pathian in pa khat le numei khat vawt hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Tuaciang hi thu hangin, pa khat in a pa le a nu nusia in a zi taw kingawm tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuaciang amate nii sia khat suak tu hi.’ Tua ahikom amate nii hi nawn ngawlin, khat ahi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tua hi a, Pathian ii ngawmsa sia kuama in khen heak hen,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Inn sungah amate a sungtan zawkciang a nungzuite in hi thu huvau dongh uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amate munah, “Pasal khat a zi khul a, zi dang khat a nei sia in, a zi tungah nupa kipalngul mawna vawt ahi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuasia bangma in, numei khat in a pasal khulin, pasal dang a nei le, nupa kipalngul mawna vawt ahi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing pawlkhat in patangte tungah Jesus ii khut a ngaksak tu dei in, ama kungah hong paipui uh hi, ahihang nungzuite in amate teih uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesus in hi bang a ngamtat uh a mu ciangin, thin uuk a amate tungah, “Patangte ka kungah hong pai tahen, khaam heak vun, banghang ziam cile Pathian Ngam sia hi bangte atu ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A tatakin kong ci ciang, patangno khat ii saan bangin Pathian Ngam a saang ngawl peuma in, tuasung ah a tum thei buatu hi.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua zawkciang patangnote, a khut taw toai in, khat sim tungah a khut nga a, thupha pia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesus ding tu in a kipat kik ciangin, pasal khat hong tai a, ama mai ah khupdin in, “Sya pha awng, tawntung nuntakna ka nga natu in bang ka vawt tu ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Pathian khat bek simngawl, a pha kuama om ngawl hi. Banghangin kei pha hong ci ni ziam?,” ci in Jesus in dongh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Thupiakte na heak hi a: ‘Mihing that heak in; palngul mawna vawt heak in; nguta heak in; leilot thu taw ngual suanhkhial heak in; ngualtheam heak in; na pa le na nu zakta in,’ ” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Syapa awng, ka no lai mama panin, hi thupiakte ka zui siat zo hi,” pasalpa in ci hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesus in ama itna taw en in, “Na kisap khat bek om lai hi. Va pai ta'n a na neisa theampo zuakin, na sum nga teng mizawngte pia ta'n; tuasia ciang vantung ah hauna na nei tu hi; tua zawkciang hong pai ta'n a, ka nung hong zui ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pasalpa in hi thu a zaak ciangin a maikhing a, khuangai in a paisan hi, banghang ziam cile ama hau mama hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesus in a nungzuite en kawkoai a, amate munah, “Sumhaute Pathian Ngam sungah a tum tu sia, bangza in haksa tu ziam!” ci hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nungzuite in hi kammalte lamdang mama sa uh hi, ahihang Jesus in, “Ka tate awng, Pathian Ngam sungah tum tu, bangza in haksa ziam!
  </para>
  <para style="p">
    <verse number="25" style="v" />Sumhau khat ii Pathian Ngamsung a tum tu sia, kalaoh khat ii phin bilvang sungah a tum tu sangin haksa zaw hi,” ci lai hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hi bang a ci ciang, nungzuite lungmang seseam a, khat le khat in, “Tua ahile akua ngupna nga thei tu ziam?” kici uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesus in amate tangtan in en a, “Mihingte atu hi sia suak thei ngawl hi, ahihang Pathian atu in suak maw ngawl hi. Pathian atu in na theampo suak thei hi,” ci hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuasia ciang Peter in, “En in, kote in na theampo nusia in, nangma hong zui khu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesus in, “Hi hi, khat pawpo in inn ahizong, suapuipate ahizong, suapuinumeite ahizong, nu, pa, tate le lote ahizong, kei hang le lungdamna thu hangin a nusia le,
  </para>
  <para style="p">
    <verse number="30" style="v" />ama in hi khang hun sungah a tamzaw lai nga tu hi. Ama in innte, suapuipate, suapuinumeite, nu, pa, tate le lote a zaa zakhat tamzaw in nga tu hi, vawtsiatna zongh thuak tu hi, tuaciang hong pai pheang tu hun sungah tawntung nuntakna nga tu hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahihang tu laitak a masa ahi mihing tam mamate sia a khak hi tu a, tu laitak a khakte sia a masa hi tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesus le a nungzuite Jerusalem zuanin pai uh hi. Jesus in a patau a nungzuite mai ah paikhol hi; a nung pan a zui mihingte zongh lau uh hi. Khatvei ma Jesus in a nungzui sawm le niite sam tuam a, ama tungah a piang tu thute son hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Ngai vun, ei teng Jerusalem ah ih pai tu a, tua munah Mihing Tapa sia thiampi liante le Thukham hil syate tungah ngual in aap tu hi. Amate in thidaan pia tu a, tua zawkciangin Gentile te khut sungah ki aap tu hi,
  </para>
  <para style="p">
    <verse number="34" style="v" />tua mite in ama selno in, cilphii tu a, vel in thatlum tu uh hi; ahihang ni thum zawkciang ama nuntakna sungah tho kik tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tua zawkciang Zebedee tate ahi James le John sia Jesus kungah hong pai hi. “Syapa awng, ko atu hong vawtsak lete kong oai uh thu khat om hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Bang ziam?” ci in Jesus in dongh hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Na minthanna Ngamsung na kumpi tokhum tungah na to ciangin, ko zongh na ziatsang ah khat, na veisang ah khat, nong tosak tu ka uuk uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jesus in amate munah, “Nong nget uh sia bang ziam ci in na tel bua uh hi. Ngim thuakna hai ka dawn tu sia dawn thei natu nu ziam? Kei ii ki baptize bangin, no zongh ki baptize thei natu nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Hi thei tu khu hi,” ci in zo kik uh hi. Jesus in, “Hai ka dawn tu sia no zongh dawn takpi tu nu hi, ka ki baptize bang keak ma in, no zongh ki baptize tu nu hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahihang ka ziatsang le ka veisang a to tute sia, kei in teal thei natu thu ka nei bua hi. Hi munte sia ama puuakholsak te atu in, Pathian in pia tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />A nungzui dang sawmte in, hi thu huvau a zaak ciangin, James le John tungah thin uuk uh hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tua ahikom, Jesus in amate theampo samin, “Pathian he ngawlte a ukte hi a kici mihingte in a mite tungah vaangnei a, a lampuite in thuneina a cingin nei hi, ci in na he uh hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ahihang no sungah hi bang hi ngawl tu hi. Khat po in a lian tu a uuk uh le, a dang teng ii naseampa hi tu hi;
  </para>
  <para style="p">
    <verse number="44" style="v" />no sung pan khat in lampui a uuk le, ama sia a dang theampo ii salpa hi tu hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Banghang ziam cile Mihing Tapa ngawngawn zongh, ngual in ama na a sepsak tu in hong pai bua hi; ngual atu a seam tu le, a nuntakna pia in, mihing tam mama tan tu in hong pai hi,” ci hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Amate Jericho khua hong theng a, tuaciangin Jesus sia a nungzuite le mihonpi khat taw a din kik uh ciangin, lamhui ah Timaeus ii tapa mittaw khutdaw ngen Bartimaeus a kici khat to hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ama in Nazareth mi Jesus hong pai ci in a zaak ciangin, “David Tapa Jesus awng; kei hong hesuak ta'n!” ci in au hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Mipite sung pan pawlkhat in teih in, a thim natu in, sawl uh hi. Ahihang ama in awnging seseam in au a, “David Tapa Jesus awng, Kei hong hesuak ta'n,” ci hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Jesus tawlnga a, “Na sam tavun,” ci hi. Tua ahikom amate in mittawpa sam hi. “Lungdam in! Ama in hong sam hi, ding in,” ci uh hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ama in a puantual suutin, vawk a, lawp takin Jesus kungah pai hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Jesus in, “Nang atu bang hong vawtsak lengh, na nuam ziam?” ci in dongh hi. “Syapa awng, khuamu thei kik nuam khi hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />“Va pai ta'n, na upna in hong damsak zo hi,” Jesus in ci hi. Thakhatin ama khuamu thei a, tuaciang Jesus zui in pai hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amate Jerusalem hong nai ciang, Bethphage le Bethany khuapite taw a kinai, Olive Mual ah theng uh hi. Jesus in nungzuite nii sia mai ah pai kholsak a,
  </para>
  <para style="p">
    <verse number="2" style="v" />hi bangin sawl hi: “Na mai a khuano sia ah pai tavun. Tua mun na thet po uh ciang, bangma hun a tung a kito ngeingawl laano khat kikhit in, om na mu tu uh hi. A khau suut tavun a, hi sungah hong paipui tavun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuaciang khat po in banghangin tuabang hi nu ziam hong cile, Topa in tuulmaw hi, hong puak kik paih tu hi, na ci vun,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua ahikom amate pai a, laano sia khua sung lampi tung, inn khat ii kongkha khuam tungah kikhit in om mu uh hi. Amate in khau a suut uh ciangin,
  </para>
  <para style="p">
    <verse number="5" style="v" />a hui ah a dingte in, “Tua laano khau na suut uh sia bang tu ci nu ziam?” ci uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amate in Jesus ii sawl bangin zo uh a, tuasia ciangin tuate in paisak uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate in laano sia Jesus kungah hong paipui uh a, a puantual uh tua nganno tungah pha in, Jesus a tungah to hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing tam mamate in a puantualte lampi tungah pha uh hi, a dangte in lo sung pan thingsawl saattan in lampi tungah pha uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A mai ah a paite le a nung pan a zuite in, hi bangin au uh hi, “Hosanna, Pathian pok vun. Topa Pathian min taw hong pai pa sia Pathian in thupha pia tahen!
  </para>
  <para style="p">
    <verse number="10" style="v" />Hong tung tu ih pa David Kumpipa ngam Pathian in thupha pia tahen, Hosanna, Pathian pok vun!” ci uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesus Jerusalem khua theng a, Biakinn sungah tumin, na theampo enkot hi. Ahihang ni niam zo ahikom, a nungzui sawm le niite taw Bethany khua ah pai uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A zing ciang, amate Bethany pan hong heak kik ciang Jesus a ngilkial hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A ngalkhat ah theikung khat a tee puitung mama in mu hi, tua ahikom theinga khat po a om ziam ci in en tu in pai hi. Ahihang a kung a thet ciangin, theitee bek mu hi, banghang ziam cile a nga hun ahi bua hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesus in, “Nang tung pan kuama in theinga ne nawn heak tahen!” ci hi. A nungzuite in a pau teng za uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amate Jerusalem a thet ciangin, Jesus in Biakinn ah pai in vanh lei vanh zuak theampo notkeak siat hi. Ama in sum theakte ii sabuaite le vakhu zuakte tokhumte sawnthal hi,
  </para>
  <para style="p">
    <verse number="16" style="v" />tuasia ciang ama in kuama vanh pua in, Biakinn leitual kaantan in a pai tu a oai bua hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihingte hi bangin hil hi: “ ‘Ka innpi sia minam theampo atu in thungetna inn kici tu hi,’ ci in Pathian in a sonna Laithiangtho sungah ki at hi ngawl ziam? Ahizong note in, ngutate bukna phual na suaksak uh hi!” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thiampi liante le Thukham hil syate in, hi thu za uh a, tua hu in, Jesus a thalup thei natu lampi zong tu in, kipan uh hi. Amate in Jesus kiita uh hi, banghang ziam cile mipite in ama ii hilna sia lamdang a sa uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nitak sang ciangin Jesus le a nungzuite in khuapi nusia uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A zingsang ciang zingtuungin, lampi zui a, a pai uh ciang, amate in theikung a mu uh hi. Tuasia in a zung dongin thisuk hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Peter in bang thu om ci in ciamtee ahikom Jesus munah, “En in, syapa awng, theikung na haamsiat sia thi zo hi!” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesus in amate munah, “Pathian um vun.
  </para>
  <para style="p">
    <verse number="23" style="v" />A tatakin ka ci ciang, khat po in hi mual munah, tho in tuipi sungah kisep in ci in sawl hen a, a thinsung ah lungmang ngawlin a ci sa teng bang piang tu hi ci in a um takpi le, a up bangin piang tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hi thu hangin a tatakin kong ci ciangin: Thu na nget uh ciang, bang khat po na ngen uh le a nga sa bangin kingaisun vun, tua hile na nget uh po hong kipia tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thungenin na din uh ciang, khat po tungah diksak ngawlna na nei uh le, maisak tavun,
  </para>
  <para style="p">
    <verse number="26" style="v" />tua hile vantung a om na pa in, no ii mawna zongh hong maisak tu hi,” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amate Jerusalem ah khatvei ma hong theng kik hi. Jesus Biakinn sungah a va laitakin, thiampi liante, Thukham hil syate le upate ama kungah hong pai a,
  </para>
  <para style="p">
    <verse number="28" style="v" />“Hi bangte na vawt natu in bang thu nei ni ziam? Akua in tua thuneina hong pia ziam?” ci in dongh uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesus in zo kik a, “Kei zongh thu khat kong dongh tu hi, nong zo thei uh le hite vawt natu bang thunei khi ziam, ci in kong son tu hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tua ahile John ii tuiphum piak theina sia Pathian kung pan hong pai ziam maw: mihing kung pan hong pai ziam? hong son tavun,” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amate sung teng kinial tu in hong kipan uh a, “Bang ci tu hi ziam? ‘Pathian kung pan hi’ ci leang, tua ahile ‘Banghangin John um ngawl nu ziam?’ hong ci tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahihang ‘Mihing tung pan hi’ ci leang…’ ” (Amate in mipite kiita hi, banghang ziam cile John sia a kuama po in kamsaang khat hi ci in um tek uh hi.)
  </para>
  <para style="p">
    <verse number="33" style="v" />Tua ahikom amate in Jesus munah, “He ngawl khu hi,” ci uh hi. “Tua ahile kei zongh, bang thu taw hi nate vawt khi ziam ci sia hong son ngawl tu khi hi,” Jesus in ci hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuaciang Jesus in amate tungah thusonteena taw thu son hi. “Khatvei lai in pasal khat in sapithuan vawt a, dal taw uum in, a tuisuukna set atu leidum a taw zawkciang lo hun natu teitaan daw hi. Tua zawkciang, a saapthaw nuamte in saapsakin ama khualhaw hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sapit nga law hun ciangin, ama tan tu tel teng a la tu in, a silate khat paisak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lo saapte in tua silapa manin, saat a, a ngawlnguak in ciasak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua zawkciang huan neipa in, sila dang khat ma paisak hi; lo saapte in a lutang pan vel a, a maizumhuai dongin vawt uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan neipa in sila dang khat ma paisak lai hi; tuasia pa thatlum uh hi; a dang tam mama zongh tuabang ma in vawt uh a, pawlkhat vel in, pawlkhat thatlum uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuabang a sawl thei tu a taanglai mihing sia a it a tapa bek ahi hi. A khakbel ciangin ama in a tapa lo saapte munah paisak hi, ‘Ka tapa hi buang ahiciang, thasia hamtang vak’ ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahihang tua lo saapte in, “Hisia pa lo neipa tapa hi. Hong pai tavun, that tawng, tua hile a neisate eima aa suak tu hi!’ ci uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua ahiciang amate in lo neipa tapa manin thatlum uh a, a luang sapithuan pua sangah vawk hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tua hile huan neipa in bang a law tu ziam?” ci in Jesus in dongh hi. “Ama hong kuan tu a, tua mihingte a thalup zawkciang, sapithuan sia lo saap dangte tungah aap tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Laithiangtho sungah hi bangin a ki at sia sim ngeingawl lawlawm nu ziam? ‘Inn sate ii mannung ngawl hi ci a, a nil suangtum sia a thupibel suangtum suak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hi thu in Topa ii zeakna ahi hi; ih et ciang lamdang hi ngawl ziam!’ ”
  </para>
  <para style="p">
    <verse number="12" style="v" />Jew lampuite in Jesus mat sawm uh hi, banghang ziam cile amate in hi thusonteena sia amate huvau a sonna hi ci in tel uh hi. Ahihang mipite kiita ahikom amate in paisan uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Phariseete pawlkhat le Herod ii pawlmite pawlkhat in thudokna taw Jesus aitaa tu in paisak uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate Jesus kungah hong pai uh a, “Syapa awng, ngualdang ii ngaisutnate awlmawk ngawlin thumaan a son pa hi, ci in kong he uh hi. Mihing min le zate zongh thupi sim tuan ngawlin Pathian ii mihingte atu a deisak thute hil hi, ci in kong he uh hi. Ih thukham in Rome Kumpilianpa, shia ih piak tu khaam ziam? Pia tu hi ziam, pia ngawl tu hi ziam, hong son ta'n,” ci uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahihang Jesus in amate ii thimthel pilna teng tel a, ‘Banghangin kei thaang hong sia nuam nu ziam? Ngunn dangka khat hong paipui tavun, hong en sin tong,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amate in khat paipui a, ama in “Hite akua ii maitang lim le akua ii min ziam?” ci hi. “Kumpilianpa aa hi,” ci in a zo kik uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua ahikom Jesus in, “Tua ahile pha hi, Kumpilianpa ii neisa sia Kumpilianpa ma pia vun, Pathian ii neisa sia Pathian ma pia vun,” ci hi. Tuasia ciangin amate in Jesus sia lamdang sa uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihingte thina panin tho kik ngawl tu hi a ci Sadducee te pawlkhat Jesus kungah hong pai in,
  </para>
  <para style="p">
    <verse number="19" style="v" />“Syapa awng, hi thukham sia Moses in ei atu in a at ahi hi: ‘Pasal khat in a zi thi san in ta a nei buale, a pasal ii suapuipa in meingongnu sia teenpui tahen, tua hile ta a nei uh ciangin mithipa ta hi ci in kingaisun tu hi,’ ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khatvei lai in unau pa sali om hi: a lianbel sia in zi nei a, ta nei ngawlin thi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tua zawkciang a niina pa in, tua numei teenpui a, tuaciang ama zongh ta nei ngawlin thi hi. A thumna pa zongh tuabang ma ahi hi,
  </para>
  <para style="p">
    <verse number="22" style="v" />tuaciang a dangte theampo zongh tuabang hi siat hi: unau sali bupin tua numei teenpui tek a, ta nei ngawlin thi tek hi. A khakbel in tua numei zongh thi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tu in thaw kik ni ciang, tua nu sia akua zi hi tu ziam? A sali in teenpui tek hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesus in, “Bangza in telkhial nu ziam! Na telkhial uh sia banghang ziam, ci in na he uh ziam? Banghang ziam cile no sia Laithiangtho ahizong Pathian vaang ahizong na he bua uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Banghang ziam cile a thite sia nuntakna sungah a thaw kik ciangin, amate vantunglalangte bang hi tu a, a kiteang buatu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tu in a thite phoktona taw kisai in: Moses ii Laibu sungah sawlpaang kuang sia ii thu, sim ngeingawl nu ziam? Tua ii sungah ki at a, Pathian in Moses tungah, ‘Kei sia Abraham ii Pathian, Isaac ii Pathian, Jacob ii Pathian ka hi hi,’ ci hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in a nungtate ii Pathian hi a, a thisate ii Pathian ahi bua hi. Telkhial mama nu hi!” ci in zo hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thukham hil sya khat, tua kam kikupna sungah om hi. Jesus in Sadducee te pha takin zo kik thei ahi sia mu hi, tua ahikom ama in, thudok nop khat taw Jesus kungah pai hi, “Thupiak sung teng pan koisia thupibel ziam,” ci hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesus in zo a, “A thupibel sia hisia hi, ‘Israel awng, ngai vun! Topa ih Pathian sia ama bekma Topa ahi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Topa na Pathian sia na thin theampo, na thaa theampo, na ngaisutna theampo le, na thatang theampo taw it in.’
  </para>
  <para style="p">
    <verse number="31" style="v" />A niina a thupibel thupiak sia, ‘Nangma le nangma na ki it bangin na innpaamte it in’ Hite nii sangin a thupizaw thupiak dang om ngawl hi,” ci hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thukham hil syapa in, Jesus munah, “Pha mama hi, Syapa awng, na ci bangin Topa bekma Pathian hi a, ama ngawl pathian dang om ngawl hi na ci sia thumaan hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuaciangin mihingte in Pathian sia a thin theampo, a ngaisutna theampo, le a thatang theampo taw a it tu uh kul hi; tuaciangin ama a ki it bangma in a innpaamte a it tu kul hi. Pathian tungah nganhing taw biakpiaknate le a dang biakpiaknate sangin, hi thukham niite zui tu thupi zaw hi,” ci hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesus in tua pa ii zo kikna sia ciim kammal hi ci in mu ahikom, ama munah, “Nang sia Pathian ngam taw kikhuala ngawl ni hi,” ci hi. Hisia zawkciang kuama in Jesus thudang a dongh ngam nawn bua uh hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Biakinn sungah hilna a nei laitak Jesus in, “Thukham hil syate in bangbangin Messiah sia David ii suan hi ci thei ziam?
  </para>
  <para style="p">
    <verse number="36" style="v" />Thaa Thiangtho in David sia hi bangin pausak hi: ‘Topa in ka Topa tungah: Na ngalte na peang nuai ah kong koisak mateng, hi sung ka ziatsang ah hong to ta'n ci hi.’
  </para>
  <para style="p">
    <verse number="37" style="v" />“David mama in, ‘Topa’ ci hi; tua ahile Messiah sia David ii suan hi thei tu ziam,” ci hi. Mihon khat in Jesus ii thuson lungdam takin ngai uh hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amate a hil kawmin hi bangin ci hi, “Puantual silhin sumzuakna munah, ngual in zatak vawtin a biak tu thangai in, a vak thanuam Thukham hil syate kung panin kikeam vun,
  </para>
  <para style="p">
    <verse number="39" style="v" />synagogue sungah a kikoituam tokhumte le poai sungah a nuambel na munah to thanuam uh hi,
  </para>
  <para style="p">
    <verse number="40" style="v" />Amate in meingongte zothaw in, a inn uh suttol in, a sau pupui a thungetna taw amate ngamtatna phualseal uh hi. Tua hu in amate daan thuak tu nasia seseam tu hi!” ci hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Biakinn sum kholna hui ah Jesus a to laitak, ama in mihingte sumkhiak zia en hi. Sumhau tam mama in sum tam ma khia uh hi;
  </para>
  <para style="p">
    <verse number="42" style="v" />tuaciangin a zawng meingongnu khat hong pai a, pya khat tang taw a kikim dangkasan pheak nii khia hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ama in nungzuite sam in, “A tatakin ka ci ciang midangte sangin, hi meingongnu in tam khia zaw hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Banghang ziam cile a dangte in a nei vaal a lamh vaal uh teng khia uh hi, ahihang hi meingongnu in a zawn kawm pan, a nei theampo khia siat hi — a nuntak a kivaak natu a nei sun teng pia siat hi,” ci hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesus in Biakinn pan, a pusua laitak, a nungzuite khat in, “Sya awng, En in! Inn sakna suangte le a innte bangza in pha ziam!” ci hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesus in, “Hi innpuite mu hi ngawl ni ziam? Suangtum khat zongh ama omna ngei munah a om buatu hi; a kilawnthal ngawl khat zongh a om buatu hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesus Biakinn ngal Olive Mual tungah to in a om laitak Peter, James, John, le Andrew hong pai uh a, a tuamin thu sonpui hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Hi thu bang hun ciang hong tung tu ziam hong son ta'n, tuaciangin hite a pian natu bang limte in lak tu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesus in, “Kidawm vun a, kuama in theamsak heak vun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kei min taw mihing tam mama hong pai tu a, ‘Keima in tuasia pa khi hi!’ ci in mihing tam mama theam tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuaciangin ngal kisimna awnging a naina ah ahizong, a khualana ah ngal kidona thu ahizong, na zaak uh ciangin patau heak vun. Tuate sia a pian tu ma hi a, ahihang a tawp natu hi ngawl lai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngam khat le ngam khat hong kisim tu a; kumpi khat le kumpi khat hong kido tu hi. Mun theampo ah zinliing tu hi, tuaciangin kialpi tung tu hi. Hite sia nausuak tu a tut kipat bang ahi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Noma le noma na kikeam vun. No sia hong kiman tu a, zum mai ah hong kithen tu hi. Synagogue te ah hong kivel tu hi, Lungdamna Thupha son tu le, keima hu in ngamukte le kumpite mai ah note na ding tu uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihang a tawpna hong thet ma in, lungdamna thu sia mihing theampo tungah kihil siat tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuaciang no hong kiman a, zum mai ah hong kipaipui ciangin, na pau natu uhte thinngim khol heak vun; a hun hong thet ciangin, hong kihil babangin, na pau tu uh hi. Banghang ziam cile na kammal zak tu te sia no ii pau ahi buatu hi; Thaa Thiangtho kung panin hong pai hi tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihingte in a suapuite thalup tu in aap tu uh hi, tuaciang, pate in a tate tuabang ma in vawt tu hi. Tate in nute pate langpan in, thatsak tu uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing theampo in note kei hu in, hong ensan tu hi. Ahihang a tawp dong a thuak zote in ngupna a nga tu uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“ ‘A kiitakhuai mama thu’ sia a kilawm ngawlna munah hong piang, na mu tu uh hi.” (Hi lai a simte ii teptee tu thu hisia ii khiakna sia bang ziam ci in tel tavun!) “Tua hun ciangin Judea ngam a omte in mual tungah tai tahen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Innkhum tung a pasal khat in, a ken tu na khat pawpo la in, tuaksuk in a hun bosak heak hen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lo sung a om pasal khat in a laktong puasilh la tu in, a inn ah heak kik nawn heak hen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Numei naupaaite le nau noailuaite atu in, tua hun sia bangza in haksa tu ziam!
  </para>
  <para style="p">
    <verse number="18" style="v" />Hi thute a pian hun sia phalbi laitak ahi ngawl natu in, thu na ngen tavun!
  </para>
  <para style="p">
    <verse number="19" style="v" />Banghang ziam cile tua hun a ngimnate sia Pathian ii leitung a bitphua pan tu hun dong leitung mihingte ii heak ngei sangin nasia zaw pek tu hi. Tuabang ngimna sia maisang zongh ah a om nawn buatu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahihang Topa in tua nite khiamsuk zo hi; tua hi buale kuama nungta zo ngawl tu hi. Ama tealsa mihingte a khualna in tua nite khiam zo hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Tuaciang khat po in, ‘En vun, hi sungah Messiah om hi!’ ci in ahizong, ‘En vun, zia sungah om hi!’ — ci in ahizong hong ci a om le na um heak vun.
  </para>
  <para style="p">
    <verse number="22" style="v" />Banghang ziam cile Messiah theam le kamsaang theamte hong piang tu hi. Hi thei hile, Pathian ii tealsa mihingte ngawngawn a theam tu in, amate in nalamdang lakna a tumdang nate hong vawt tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na kidawm vun! A hun hong thet ma in, na theampo hong son zo khi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Ngimna hun zawkciang hong pai tu nite ah ni hong taang nawn ngawl tu a, tha zongh taang nawn ngawl tu hi,
  </para>
  <para style="p">
    <verse number="25" style="v" />aksite van panin taaksuk tu hi, van a om nate a paina lampi ngei panin lampial tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua zawkciangin Mihing Tapa sia hong kilangh tu a, meeikaai sungah vaangletna le minthanna lianpi taw hong pai tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in vantunglalangte leimong king li ah paisak tu a, Pathian ii tealsa mihingte leimong khat pan mong khat kilaklaw ah khawmtua tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Theikung in hilsak tavun. A baakte hong hing a hong moisuak in a tee note suak tu in a kithoai ciangin, khuakhaal hun hong nai zo hi, ci in na he uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuasia bangma, hi thute hong pianna mu uh ciangin, a hun hong nai zo hi, kipapan tu in kithoai zo hi, ci in na he tu uh hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tu laitak hunin a nungta mihingte a thi siat ma in hi thute hong tung tu hi — ci in na ciamtee tavun.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vantung le simlei hong bo tu hi, ahihang ka kammalte bo ngeingawl tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Ahihang kuama in a ni le a nai hong tun hun tu a he bua hi, van a vantunglalangte hikale Tapa hikale in a he bua a, Pa bek in he hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na kinging vun a, na kipilvangsak vun, banghang ziam cile a hun hong tun tu na he bua uh hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mihing khat khualhaw tu in dingin, a naseamte in inn ngaksak a, khat simin a sep tu tek a vaithak zawkciang, kong cingpa munah a cin thiam natu in, a vaitha sia taw kibang hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tua ahikom, na kikeam tavun, banghang ziam cile, innteakpa bang hun ciang hong cia kik tu, ci in na he bua uh hi — nitak zongh hi thei, zankim zongh hi thei, tua ahibuale zingtuung zongh hi thei, nisua laitak zongh hi thei hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Thakhat thu in hong theng le, a mu sa in na om uh hong si bua het le pha hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />No tungah kong son teng mihing theampo tungah ka son ahi hi. A kingingta sa in om vun!” ci hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tu in Paisan Poai le Tol saw ngawl Anluum Poai sia ni nii samh lai hi. Thiampi liante le Thukham hil syate in Jesus sia a thimtham in man a thalup thei natu in lampi zong uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Poai sungah vawt ngawl tu hi, tuabang ahibuale mihingte ngamlum tu hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesus sia Bethany khua ah a lauhuai vun natna a vei ngei Simon a kici khat inn ah a om hi. Jesus in an ne in a om laitak numei khat hong pai in, suangngo thawl khat dim a manpha mama sathau namtui hong keng a, Jesus lu tungah buak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua munah a om mihing pawlkhatte thin uuk a, khat le khat ii munah, “Sathau namtui pakvawt sia bang a phattuamna om ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngunn dangka zathum sangin a tamzaw kikhawng thei tu a, mizawngte kipia thei tu hi,” ci in, nasia takin numei nu ngamtatna mawpusak uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahihang Jesus in, “Ama koi po vun! Note in ama sia bang nuam maw nu ziam? Ama in kei atu in, nasep pha khat a seam hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mizawngte note taw hong omkhawm tawntung tu a, na hu nop uh simin na hu thei tu uh hi. Ahihang kei note taw hong omkhawm tawntung ngawl tu khi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama in a hi thei tawpin seam zo hi, ka kivui tu hun hong thet ma in, ka pumpi sathau hong noai a hong pua khol ahi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A tatakin ka ci ciang, leitung theampo ah lungdamna thu a kihil lai tengin ama ii vawt teng sia ama phawna taw kison tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua zawkciang nungzui sawm le nii sungah a kihel Judas Iscariot sia thiampi liante kungah Jesus leeheak tu in pai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama son teng amate lungkim a, sum piak tu in kamciam pia uh hi. Tuabangin Judas in amate khut sungah Jesus a aap thei natu hunpha khat zong hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tol saw ngawl Anluum Poai ni phitbel ni in, Paisan poai atu tuuno a kingo hi a, nungzuite in, “Paisan poai an sia koisungah pai in hong vawt kholsak tu khu ziam?” ci in dongh uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuasia ciang Jesus in amate sung pan nii paisak a, “Khuapi sungah pai le uhte pasal khat tuibeal taw tuitoai sia na mu tu uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama tumna inn ah va zui tavun, tuaciang innteakpa munah, ‘Syapa in, ka nungzuite taw Paisan poai an ka neak natu inn doituam sia koisung ziam ci hi, va ci tavun,’ ci hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuasia ciangin ama in inndawl tungnung ah doituam lian khat hong lak tu a, an lui natu le to natu kipua kholsa in om tu hi. Tua munah a kul teng, ei atu in a kipua kholsa in om tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nungzuite zongh pai in, khuapi sung a thet uh ciang na theampo Jesus ii sonsa bang tatak ma in a om mu uh hi. Tua munah Paisan poai an tu vawt uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A nitak ciangin Jesus a nungzui sawm le niite taw hong pai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sabuai ah an ne in a om laitak Jesus in, “No sung pan kei taw an nekhawm khat in, kei hong leeheak tu nu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nungzuite a thin uh nuam ngawl a, khat zawkciang khat in, “Kei hong ci nuam na hi bua na ziam?,” ci in dongh uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesus in “Noma sawm le nii sung pan khat hi tu nu hi, ankuang sungah anluum keima taw a sawk khawm sia hi tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Laithiangtho ii ci bangin, Mihing Tapa ahile thi tu a, ahihang Mihing Tapa a leeheakpa atu in bangza in lauhuai ziam? Tua pa atu in pian awl zaw le phazaw hi!” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amate an a neak uh laitakin, Jesus in anluum bek khat la in, lungdamkona thungen a, balneen in a nungzuite pia hi. “Hisia in ka pumpi ahi hi. Ne vun,” ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tua zawkciang hai la in, Pathian tungah lungdam a ko zawkciang, amate pia hi, tuaciangin amate in dawn uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Hisia in mihing tam mamate atu a kibua ka chisan hi, Pathian thuciamna a kipsak ka chisan ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A maan takin ka ci ciang, Pathian Ngam sungah sapittui thak ka dawn mateng, hi sapittui thak ka dawn nawn buatu hi,” Jesus in ci hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua zawkciang amate lasa in Olive Mual ah pai uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesus in “Note theampo in kei nong taisan tu uh hi. Banghang ziam cile laithiangtho in, ‘Pathian in tuucingpa thatlum tu a, tuaciang a tuute kithethaang tu hi,’ ci hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahihang nuntakna sungah hong kiphokto ciangin, note mai Galilee ah ka na paikhol tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Peter in, “A dang theampo in hong nusia zong, kei kong nusia buatu hi!” ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesus in Peter munah “A tatakin kong ci ciang, zan ciangin ak niivei a khuan ma in thumvei kei nong nial tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Peter in, “Nangma taw thi khop keak a kul zongin, tuabang peuma hong nial ngawl tu khi hi!” ci in kho takin zo hi. Nungzui dangte zongh in tuabang ma in ci tek uh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amate Gethsemane a kici mun hong theng uh a, Jesus in a nungzuite munah, “Thu ka nget lanin hi sungah na to vun,” ci hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama in Peter, James le John te paipui hi. Ama sia heena le thinngimna taw kidim hi,
  </para>
  <para style="p">
    <verse number="34" style="v" />tuaciang amate tungah, “Ka thinsung ah ka heena lian mama ahikom ka thi dektak hi. Hi sungah na om vun a, mu heak vun,” ci hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ama tawm pai thua lai a, lei ah bokin, ahithei le ngim thuak natu hun a peal thei natu in thungen hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Pa awng, Ka Pa awng! Na theampo nang atu in suak thei hi. Hi thuakna hai sia kei kung pan hong laaksak ta'n. Ahihang kei deina bang hi ngawlin, nangma deina bang hi tahen,” ci in thungen hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tua zawkciangin hong heak kik a, a nungzuite thum sia mutthip sa in a om mu hi. Ama in Peter munah, “Simon awng, mu ni ziam? Nai khat zongh hong ngak zo ngawl ni ziam?”
  </para>
  <para style="p">
    <verse number="38" style="v" />A nungzuite tungah, “Na ngak vun a, ze etna sungah na puk ngawl natu in, thungen vun. Thinsung in uukna nei ahihang pumpi sia thazawm hi,” ci hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ama khatvei ma pai kik a, a kammal zak ngei teng taw ma in thu ngen kik hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tua zawkciangin ama nungzuite kungah hong heak kik a, nungzuite mutthip sa in a om mu hi. Amate in Jesus tungah bang son tu ci a he bua uh hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ama a thum veina hong heak kik ciangin, nungzuite munah, “Tu dong mu lai in, tawlnga lai nu ziam? Tu a teng pha zo hi! A hun hong theng zo hi! En vun, Mihing Tapa sia mimawte khut sungah ki aap tu hi zo hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tho vun a, pai ka tawng. En vun, kei hong leeheak tu pa hi sungah om hi!” ci hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jesus tuabangin a pau laitakin, nungzui sawm le niite sung pan khat ahi Judas hong theng hi. Thiampi liante, Thukham hil syate le upate ii sawl mihon khat namsau le moltawng toai in, Judas taw hong kithawl khawm uh hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />“Ka nap pa sia na mat nop uh sia hi tu hi, man vun a, a cing tu kisepin paipui tavun,” ci in Judas in mipite limlakna piakhol hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Judas hong thet po ciangin Jesus kungah pai in, “Syapa awng!” ci in namh hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tuabangin Jesus man uh a, lencip uh hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ahihang tua munah a ding khat in, a namsau dokin Thiampi Lianbelpa ii salpa saat a, a bil saattan hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Jesus in amate tungah, “Mihing that taiku man tu bang phetin, kei hong man tu takpi namsau le moltawng taw hong kuan nu ziam?
  </para>
  <para style="p">
    <verse number="49" style="v" />Ni simin Biakinn sungah no taw omkhawm in hilna kong nei a nong man bua uh hi. Ahizong Laithiangtho a taangtut kul hi,” ci hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tuaciangin nungzuite theampo in ama nusia in taikeak uh hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Puankaang neal khat bek a silh tangval khat in, Jesus zui hi. Amate in tangvalpa man tu in kithoai uh hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ahihang ama in a puan nusia in, a nguaktangin tai hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tua zawkciang Thiampi Lianbelpa inn ah Jesus paipui uh hi. Tua munah thiampi liante theampo, upate le Thukham hil syate kikhawm uh hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Peter in a khuala thithimna panin Thiampi Lianbelpa ii leitual dong zui hi. Tua munah ngalkapte taw meilum oai in to hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Thiampi liante le Council buppi in, Jesus a thalup thei natu, a mawna zong ahihang a mu zo bua uh hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Mihing tam mama in leilot thu taw Jesus mawsak hikale amate khat le khat zongh a thu a kisi bua uh hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tuaciangin pawlkhat hong ding a, Jesus mawsak natu in, leilot thu hi bangin son uh hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />“Mihingte vawt Biakinn hisia ka baltham tu a, ahihang ni thum zawkciang mihingte vawt ngawl khat ka sa kik tu hi,’ ci in a pauna ka za uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Ahitazong amate ngawngawn a thu uh a kisi thei bua uh hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Thiampi Lianbelpa amate theampo ii mai ah ding a, Jesus thu dongh hi. “Hong mawsaknate na zo kik natu nei ngawl ni ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Jesus huthe ngawlin om a, kam khat zongh a pau bua hi. Tuaciangin Thiampi Lianbelpa in, khatvei ma, “Nang Thupha toai Pathian Tapa Messiah na hi ziam,” ci hi.
  </para>
  <para style="p">
    <verse number="62" style="v" />“Hi khi hi, no theampo in, Mihing Tapa sia Vaanglianbelpa ziatsang ah to in, vantung ah meeikaaite taw hong pai na mu tu uh hi,” ci in Jesus in zo hi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Thiampi Lianbelpa in, a puantual eautham a, “Tetti dang kul nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Pathian min a simmawk hunlam na zaak tek uh hi. Bangbangin thukhen tu nu ziam?” ci hi. Amate theampo in ama a langpan siat uh hi. Ama maw hi, thalup kul tu hi, ci uh hi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Amate pawlkhat in Jesus cilphii in, a mit a sawmsak zawkciang saat uh hi. “Akua in nang hong saat ziam, son thei ta'n,” ci uh hi. Tuaciangin ngalkapte in la in beang uh hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Thiampi Lianbelpa ii naseam numei khat hong pai laitakin, Peter leitual ah om lai hi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Ama in Peter mei oai in om a mu ciang, encian a, “Nang zongh Nazareth mi Jesus taw kithawl ni hi,” ci hi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Ahihang ama in nial hi. “Na son thu sia he ngawl khi hi,” ci in lampi ah paisan hi. Tuasia laitakin aklui khat khuang hi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Naseam numeinu in tua munah a mu ciang, a dingte zaak tu in, “Ama sia amate sung pan khat ahi hi,” ci kik hi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Ahihang Peter in nial kik hi. Tawmvei zawkciang tua munah a dingte in Peter munah, “Nang, amate mi khat na hina sia nial zo ngawl tu ni hi, banghang ziam cile nangma zongh Galilee ngam pan na hi hi,” ci uh hi.
  </para>
  <para style="p">
    <verse number="71" style="v" />Tuasia ciangin Peter in, “Thumaan son khi hi, ci in ka kiciam hi, thumaan ka son buale Pathian in daan hong pia tahen. Na son uh sia pa hong heaksak ngawl khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="72" style="v" />Tuasia ciangin aklui a nii veina khuang hi. Tuaciang Peter in Jesus ii ama tungah, “Aklui niivei a khuan ma in, hong he ngawl khi hi, ci in kei thumvei nong nial tu hi,” a ci teng phawk hi. Tuaciang ama in thuak zo ngawlin kap hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zingsang tuungin thiampi liante sia upate, Thukham hil syate le Council bup taw a manlang in hong kisitua uh a, amate in vaihawmna nei uh hi. Amate in Jesus thikkhau taw khi uh a, Pilate kungah paipui in aap uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pilate in, “Nang, Jew te ii kumpipa na hi ziam?” ci in dongh hi. Jesus in, “Nangma ci bang ahi hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thiampi liante in Jesus mawsiatna hau mama uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua ahikom Pilate in, “Amate kam zo ngawl tu ni ziam? Hong mawsaknate theampo ngai in,” ci kik hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesus in kammal khat zongh zo tuan ngawl ahikom Pilate in lamdang sa hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Paisan Poai kivawt simin mihingte ii nget thongtaak khat pawpo Pilate ii suataksak thei ngeina khat om hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua hun laitakin kumpi leedona a vawt tualthat thongtaak te sungah Barabbas a kici khat zongh om hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihonpite hong kikhawm a, Pilate tungah a vawt ngei bang a vawt natu ngen tu in hong kipat uh ciangin,
  </para>
  <para style="p">
    <verse number="9" style="v" />ama in, “Jew te kumpipa sia suatak leng, hong oai zaw nu ziam?” ci in dongh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thiampi liante in Jesus a een na hangin, ama tungah a aap uh hunlam thiangtel mama hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahihang thiampi liante in mihonpite hol a, Pilate in Barabbas a suataksak zawk natu ngensak uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pilate in mihonpite munah, “Tua ahile Jew te kumpipa na ci uh sia bang law leng hong oai nu ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate in, “Thinglamtee tungah thatlum in!” ci in au uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Ahihang ama in bang khialna nei ziam?” ci in Pilate in dongh hi. Amate in “Thinglamtee tungah thatlum in!” ci in a nging seseam in au uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilate in mihonpite lungkimsak nuam ahikom Barabbas tha hi. Tua zawkciangin Jesus velsak a thinglamtee tungah thalup tu in aap hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngalkapte in Jesus sia ngamuk mangpa leitual sumsung sangah paipui a, ngualdang theampo zongh sam uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amate in puantual sandup khat Jesus in silhsak a, lingngui taw a kivawt kumpilukhu khat a lu tungah khusak uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua zawkciang amate in, “Jew te kumpipa a khansau tahen!” ci in zatakna kipia theamsak uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amate in a lu pan saat a, cilphii in a mai ah a zakta bang keakin khupdin in, kun uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A selnona uh teng a man zawkciang puantual sandup sia ama tung pan suutin, ama puansilh ngei teng silhsak kik uh hi. Tua zawkciang thinglamtee tungah thalup tu in paipui uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngamsung pan khuapi sungah hong pai Simon a kici pasal khat taw lampi ah kisi a, ngalkapte in ama sia zawthawk thu taw Jesus ii thinglamtee puasak uh hi. (Tua Simon sia Cyrene pan hi a, Alexander le Rufuste ii pa ahi hi.)
  </para>
  <para style="p">
    <verse number="22" style="v" />Amate in Jesus sia Golgotha a kici munah paipui uh hi. Tua mun ii a min sia “Lungu Mun” cina hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tua munah amate in Jesus sia sapittui le myrrh a kici zatui nam khat a hel sia tul tu in, kipan uh hi. Ahihang ama in a dawn nuam bua hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaciangin ama thinglamtee tungah kilh a, a puansilh teng a koisia akua in nga tu ci in aisaanna taw a et zawk uh ciang hawm uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thinglamtee tungah a kilh hunin zingsang nai kua saat hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Jew te Kumpipa” hi ci in a kimawsakna lai ki at hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amate in ngualsuam phalakte nii zongh thinglamtee khat veve tungah kilh uh a, khat sia Jesus ii ziatsang, khat sia a veisang ah kilh uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />(Laithiangtho sungah ‘Ama in leitung thukham paltante thuak bangin thuak hi,’ a ci teng a taangtun natu ahi hi.)
  </para>
  <para style="p">
    <verse number="29" style="v" />Tua mun kaantan in a pai mihingte in, lupei san in nunau zazaan uh hi. “Heii! Biakinnpi baltham in ni thum sung ka sa kik thei tu ci ni hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tu in thinglamtee tung pan hong tuaksuk ta'n a, nangma le nangma kihun in!” ci uh hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuabang ma in, thiampi liante le Thukham hil syate in Jesus selno zazaan uh a, amate khat le khat hi bangin kici uh hi. “Ngualdang hun hi ve ahihang ama le ama kihun thei ngawl hi!
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel Kumpipa Messiah thinglamtee tung pan hong tuaksuk thei ziam maw en sin tawng, tua hile ama um vak hing!” ci uh hi. Tuaciang in Jesus taw thinglamtee tung a kikilh te nii zongh in Jesus nunau zazaan uh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nisun laitakin ngam bup khuazing in tuam cip a, nai thum sung khuazing hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nai thum sa ciangin Jesus in a nging tatakin au a, “Eloi, Eloi, lema sabachthani?” ci hi. A khiakna sia, “Ka Pathian, ka Pathian awng, banghangin hong nusia ni ziam?” ci na ahi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tua munah mihing pawlkhat a omte in ama auna za a, “Ngai vun, ama in Elijah sam hi!” ci uh hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amate sung pan khat in puansia khat la in, sapittui haau sungah a pap zawkciang, ciangkang dawn ah sawm hi. Tuaciang Jesus ii muk ah taa in, “Om zii tawng! Elijah sia thinglamtee tung panin ama suut tu in hong pai le hong pai ngawl en lai tawng!” ci hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jesus in nging takin au in, thi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Biakinn sungah kidoina puankhak sia a lu pan a taw dong khen nii kisua in kizen suk hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tua mun thinglamtee mai ah a ding ngalkap hon ukpa in, Jesus thi zia mu hi. “Hi mipa sia Pathian Tapa takpi hi!” ci hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Numei pawlkhat tua munah om a, a khuala thithimna mun khat pan en uh hi. Amate sungah a kihel teng sia Mary Magdalene, a khangmoi zaw James le Joseph nu Mary le Salome te ahi uh hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amate in Galilee ngam ah Jesus a om lai in zui uh a, a hu tawntung te ahi uh hi. Ama taw Jerusalem khua a hong paikhawm numei dang tam mama zongh om uh hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nitak ciangin Arimathea mi Joseph hong theng hi. Ama sia Council sungah a kizakta upa khat hi a, Pathian Ngam hong thet tu a ngakpa khat ahi hi. Tua ni sia kingin ni hi (Sabbath ma ni khat) tua ahikom Joseph in Pilate kungah hang takin pai a Jesus ii luang ngen hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Jesus thi zo hi ci a zaak ciangin, Pilate in lamdang sa hi. Ama in ngalkap hon ukpa sam a, Jesus a thi zawk a ngei zo ziam ci in dongh hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ngalkap mangpa ii thu kona teng a zaak zawkciangin, Pilate in Joseph tungah Jesus luang pia hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Joseph in puankaang neal khat lei a, a luang la suk in, tua pua taw tunin, suangpi a kikhuak thaan khat sungah sial hi. Tua zawkciang ama in thaan kongvang ah suangtum pui khat taw khak hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mary Magdalene le Joseph nu Mary in ngakin en a, Jesus luang koina mu uh hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sabbath ni bo zawkciangin, Mary Magdalene, James ii nu Mary le Salome in Jesus luang a zut natu in hel namtuite keng uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nipi ni zingtuung, nisua ciangin, amate thaan ah pai uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lampi ah khat le khat hi bangin a kikum uh hi, “Thaan kong panin akua in suangtumpui sia hong liik keaksak tu ziam?” (A suangtum sia lian mama hi.) Tuaciangin amate in a etto uh ciangin a suangtum sia a kiliik sa in om mu uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuabangin amate thaan sungah tum uh hi, tua munah tangval khangmoi khat a ziatsang ah to in a na om a, puantual kaang khat silh hi, tuaciangin amate lau mama uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Lau heak vun. Thinglamtee tungah a kithat Nazareth mi Jesus, zong na hi uh kong he hi. Ama hi sungah om ngawl a — tho kik zo hi! En vun, ama kisialna mun hi sung ahi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu in Peter pan kipan a nungzuite munah hi thu puak tavun: ‘Ama note mai Galilee ah paikhol zo hi; tua munah ama ii hong son ngei bangin, na mu tu uh hi,’ ” ci hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tua ahikom amate in lungmang patau in thaan sung pan, pusuak in tai uh hi. Amate in lau ahikom, kuama munah, bangma a son bua uh hi. [
  </para>
  <para style="p">
    <verse number="9" style="v" />Nipi ni zingtuungin Jesus thina pan a thaw kik zawkciang, a masa phitbel in Mary Magdalene tungah ama kilak hi, tua numei nu sung pan doaite sali Jesus in a hawlkeaksak ngei hi. [Numeite in Peter le a lawmte kungah pai a, amate tungah a kison thute a tom in sonsawn uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama pai in Topa kitholpuite munah son hi. Amate kapin, tau in om uh hi. Hisia zawkciang, Jesus ama mama in, nungzuite tungtawnin, nisuana pan nitumna ah, a thiangtho, a hing top, tawntung ngupna thu puak hi.]
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesus nungta a, ama tungah kilak hi ci in numeinu ii son ciangin, amate in a um bua uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hisia zawkciang, nungzuite nii ngamsung a pai laitakin Jesus sia a nam tuatuamin kilak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate heak kikin, nungzui dangte munah a son uh hangin amate in a um bua uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A khakbel in, Jesus sia nungzui sawm le khat te anneak laitakin kilak hi. Jesus in amate teih hi, banghang ziam cile amate in upna nei ngawl a, a thin uh pui ahikom, a nuntak kik a mute ii thu son a um zo bua uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama in, “Leitung mun theampo ah pai tavun a, mihing theampo tungah lungdamna thu hil tavun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akua po ahizong um in, tui a kiphumte kingum tu hi, a um ngawlte ahile puavawkna thuak tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thu umte nalamdang vawt thei natu vaang kipia tu hi; amate in keima min taw doaite a not tu uh hi; amate kam tumdangin pau tu uh hi;
  </para>
  <para style="p">
    <verse number="18" style="v" />ngulte zamhin nguu khat pawpo a ne zongin, bangma tat ngawl tu hi; amate in ciinate tungah a khut uh nga tu a, ciinate dam tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Topa in amate taw thu a son zawkciang, ama sia vantung ah kila to in Pathianziatsang ah to hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nungzuite mun theampo ah pai in, thuhil uh hi, tuaciang Topa in amate taw naseam khawm a, amate thuhilnate sia maan hi ci in a kilak natu in, nalamdang laknate vawtsak thei hi.]
  </para>
</usx>
