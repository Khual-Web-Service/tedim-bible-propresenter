<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JOB" style="id">Job</book>
  <para style="h">Job</para>
  <para style="toc1">Job</para>
  <para style="toc2">Job</para>
  <para style="mt">Job</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Uz ngam ah a teang Job kici mi khat om a, ama in Pathian bia in, ama ii tungah thumaan hi. Ama mihing pha khat hi a, siatna peuma a vawt ngawl natu in kidawm hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama in tapa sali le tanu thum nei a,
  </para>
  <para style="p">
    <verse number="3" style="v" />tuaciang tuu 7,000 kalaoh 3,000 khui 1,000 le laa 500 nei hi. Ama in naseam tam mama zongh nei a, Nisuana ngam sungah a haubel pa hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Job ii tapate in a ban a banin anneakpoai vawt nithi hi, tua poai ah a dangte theampo pai in a suapuinumeite thum zongh a kihel tu in sam tawntung uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A anneakpoai khuavak ni zing simin Job sia zingtuung in tho a, a tate khat sim a thiansua natu in sangaw biakpiakna vawt hi. Ama in hi bangin vawt tawntung hi, banghang ziam cile a tapate khat po in, a tupkhol ngawl bul Pathian a simmawkna taw in khialna nei tha thei tu hi ci in, a ngaisut hang hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Topa mai ah vantung mite a kilak tu ni a tun ciang tuate sungah Satan kihel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Topa in Satan tungah, “Bang teng vawt ni ziam?” ci in dongh hi. Satan in, “Mun khat pan mun khat ah pai in simleitung kiimveal in ka vak kawkoai hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Topa in, “Ka naseampa Job na phawk tha ziam? Leitung ah ama bangin a thumaan le a pha kuama om ngawl hi. Ama in kei hong bia a, a sia a vawt ngawl natu kidawm hi,” ci hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Satan in, “Hong biak hu in bangma nga buale Job in nang hong bia na tu ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama le a innkuan le a neisa theampo nangma in na huuksak tawntung hi. A sep a vawt theampo thupha na pia a, ngam bup dim tu za dongin ngannote na pia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahihang tu in a neisa theampo nangma in laaksak ci tawng — na maitang pan hong haamsiat tu hi!” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Topa in Satan tungah, “Pha hi, a neisa theampo nangma khut sungah om hi, ahihang Job pumpi tatak susia ngawl het tu ni hi,” ci hi. Tua ahiciang Satan in paisan hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ni khat ni Job ii tate a upabel pa ii inn ah anneakpoai a vawt laitakin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Job kungah kamtai khat hong tai hi. Ama in, “Kote lo sungah khuikaap taw naseam in om a, laate lo hui nganthana ah taa uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thakhat thu in Sabean te in hong sim a, tua nganno teng ngu siat hi. Amate in keima simngawl na naseam teng thatlum uh hi. Nang tungah thu ko tu in keima bekma suakta khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A thu son man tak ngawl lai in naseam dang khat hong theng a, ama in, “Khualeng in na tuute le a cingte hal lum siat hi. Nang tungah thu ko tu in keima bekma suakta khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A thu son man tak ngawl lai in naseam dang khat hong theng a, ama in, “Chaldean ngalnguk seamte pawl thum in hong sim a, kalaoh theampo ciapui in na naseamte keima simngawl thatlum siat hi. Nang tungah thu ko tu in kei bekma suakta khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A thu son man tak ngawl lai in naseam dang khat hong theng a, ama in, “Na tate na tapa ulianbel sia ii inn ah anneakpoai vawt in a om laitak,
  </para>
  <para style="p">
    <verse number="19" style="v" />sennealngam sang pan vuipi suangval hong va hi. Tuasia in a inn seamvawk a, amate theampo thisak siat hi. Na tungah thu ko tu in keima bekma suakta khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuasia ciang Job dingto a, khuangai in a puansilh teng baltham hi. A sam meet a, lei ah bokcip hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in, “Ka pian lai in ka nguaktang in ka suak a, ka nguaktang in ka thi tu hi. Topa in hong pia a, tu in Topa in la kik hi. Ama min kipok tahen!” ci hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama tungah hi bangin thu piang napi Job in Pathian mawsiat ngawlin mawna vawt ngawl hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Topa mai ah vantung mite a kilak kik tu ni a thet ciang tuate sungah Satan om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Topa in Satan tungah, “Koisung teng theng zo ni ziam?” ci in dongh hi. Satan in, “Mun khat pan mun khat ah pai in simleitung ah ka vak kawkoai hi,” ci in zo hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Topa in, “Ka naseampa Job na phawk tha ziam? Leitung ah ama bangin a thumaan le a pha kuama om ngawl hi. Ama in kei hong bia a, a sia a vawt ngawl natu kidawm hi. Bangma thu om ngawl bulin ama na suksiat natu in kei nong kun a, ahihang Job sia a ngei bangma in thumaan lai hi,” ci hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Satan in, “Mihing khat pawpo in a nuntak natu in a nei theampo pia khia tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahihang tu in sonteena in nangma in a pumpi nasak lete — ama in na maitang panin hong haamsiat tu hi!” ci in zo kik hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuasia ciang Topa in Satan tungah, “Pha hi, ama na khut sungah om hi, ahihang ama thatlum ngawl tu ni hi,” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuasia ciang Topa omna pan Satan pusuak in, ama in, Job ii pumpi tung theampo ah meima puite piangsak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Job in nin kholna hui ah to in a meimate a khuat natu in tungbeal tamhbek khat la hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A zi in ama tungah, “Na thumaan ngei ma in thumaan lalai na hi ziam? Banghangin Pathian haamsiat in thi heu ngawl ni ziam?” ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Job in, “A lui thawthongin pau ni hi! Pathian in napha khat po hong puak ciang lawp takin ih saang hi. Ngimna hong puak ciang banghangin phun thei tu hi ziam?” ci in zo hi. Hite theampo a thuak kawm sung panin, Job in Pathian tungah kam ngaldo bangma pau ngawl hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Job ii lawmte thum sia Teman khuapi panin Eliphaz, Shuah ngam panin Bildad, le Naamah ngam panin Zophar te ahi hi. Job ii hi bang zata a ngim thuakna thu a zaak uh ciang amate in Job kungah pai in heeneam tu in khensat uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amate in a khuala pan Job ngalmu a, ahihang tel ngawl uh hi. A tel tak uh ciang amate nasia tak kapin, khuangai in a puansilhte baltham a, leivui lawnto in a lu tungah the uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tua zawkciang amate in Job taw kam khat zongh pau ngawlin sun sali le zan sali lei ah topui uh hi, banghang ziam cile ama in bang zata in thuak ci sia amate in mu uh hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />A khakbel ciang Job pau in, ama pian ni haamsiat hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian awng, ka sua ni haamsiat in; ka nu ngil sungah ka om phit ni zan haamsiat in!
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua ni sia khuazing suaksak in, Pathian awng. Tua ni phawk kik ngei nawn heak in; tua ni in khuavak taang kiksak nawn heak in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tua ni sia a thim le a zingcip ni hisak in; meeikaai taw tuamcip in a, ni phiatkeak in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua zan sia kum simna sung pan phiatkeak in a, kisim kiksak nawn heak in;
  </para>
  <para style="p">
    <verse number="7" style="v" />tua zan sia a ngamkhing, lungdamna a om ngawl zan hisak in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Leviathan nganhing pui a uk thei bum le ai toaite in, tua ni sia haamsiatsak in!
  </para>
  <para style="p">
    <verse number="9" style="v" />Nikonghong aksi taangsak heak in; Tua zan sia khuavak tu lametna omsak heak in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngimna le heena sungah kei hong omsak in, kei hong piansak hu in tua zan haamsiat in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka nu sulh sungah thi ka na leng tua ahi buale ka sua po ciang thi ka na leng uuk ing.
  </para>
  <para style="p">
    <verse number="12" style="v" />Banghangin ka nu in a khup tungah hong toai ziam? Banghangin a noaitui taw hong vaak ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Tualai in thi hi leng, tu in ka tawlnga tu a,
  </para>
  <para style="p">
    <verse number="14" style="v" />taanghlai kumpi innte a sa kik kumpite le ngamukte bangin ka mu tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khamh le ngunn taw a inn uh a dim kumpi tate bangin ka mu zo tu a,
  </para>
  <para style="p">
    <verse number="16" style="v" />ahibuale a thisa in a suak nausen bangin mu zo tu khi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thaankuul sungah mi ngilote in a tatsiatna uh kheal a, a toi naseamte in a khakbel ciang tawlnga tu uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thongtaakte ngawngawn thinnuamin om hun nga a, ausatna le thu piakna kamhamte taw kipeal hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tua munah a minthang le a kihe ngawl mi theampo om a, salte a khakbel in suakta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Banghangin mihingte thinngimna nei in nungtasak tan ni ziam? Banghangin a khuangaite khuavak pia ni ziam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Amate in a thi tu ngak ahihang tuasia theng ngeingawl hi; amate in sumngum khat po sangin thaankuul deizaw uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thi in a kiphum mateng amate lungdam ngawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian in amate mailam seal a, tuaciang a kiimkot panin nengcip hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anneak tu taangin ka kap a, tauna pan ka tawp thei ngei bua hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka kiitak theampo le ka launa teng hong tung takpi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Keima in thinnop le tawlngak hun nei ngawlin, ka ngimnate a bo ngei nawn bua hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng, kei pau leng na thin a nawngkai tu ziam? Huthe ngawlin om thei nawn ngawl khi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi tam na hil zo a, tha zawngkhalte tha na pia zo hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khat po lutu in, toi in, tha zawmin a om ciang, na kammalte in hanthawn a, ama dingtangsak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tu in na ngim nga tu hun hong tung a, a thuak zo ngawl tu dongin na thinngim leih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangma in Pathian na bia a, na nuntakzia sitbaang ngawl hi; tua ahikom kimuanna le lametna na nei tu ahi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu in ngaisun kik in. Thutang mi khat ii tuasiatna a thuak ngei khat son in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mite in tatsiatna lo bangin tho a, ngitlona ancii poai bangin a poai ka mu hi; tu in amate in siatna le ngitlona teng anlaak bangin la uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vuipi suangval bangin Pathian thin uukna in amate susia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi ngilote sia tawpite bangin hawkin ngalh hi, ahihang Pathian in amate thimsak a, a hate suktansak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mat tu neak tu a nei ngawl tawpite bangin, amate thi a, a tate theampo kithethaang hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khatvei thu khat, aw thim taw hong theng a, dam pau mama ahikom ka za thei bua liang hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zan mangsia bangin tua in ka mut hong phawng hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Liingin ka ngawk hi; ka pumpi bup lau in, kithing hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vuiva vahiau khat in ka maitang hong seam a, lau in ka khuasik mul suak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua munah a ding khat ka mu thei hi; sal kaleng zong a bang tatak ziam ka son thei bua hi. Tuasia ciang a thim dide sung pan aw khat ka za hi:
  </para>
  <para style="p">
    <verse number="17" style="v" />“Pathian ii muna ah mi khat pawpo a thutang om thei tu ziam, tua ahibuale ama a bitphua pa mai ah a thiangtho om thei tu ziam?
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian in a vantung naseamte muang ngawl hi; ama in a vantunglalangte ii khialna ngawngawn mu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tungman taw kivawt a nungta khat, leivui sung pan a piang na khat pingpaleap bangin ol takin a kimetcip thei khat sia ama in muang tu in na um ziam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing khat sia zingsang in nungta tha tu a, ahihang nitak hun a thet ma in kuama heak ngawlin thi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama ii nei theampo kilaaksak a; ciimna nei ngawl lai in thi hi.”
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng, biakpui in. Hong zo a om ziam en in. Na bel thei tu vantunglalang khat po a om ziam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Thin natna teng taw na thi dong na thinngim tu sia mawmawt huai hi, khiakna om ngawl ngamtatna hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngammuang a kisa, mihing mawmawte ka mu ngei hi, ahihang a bangkuate thakhat thu in ka haamsiat hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tapate in ngal muanna mu zo ngeingawl a, kuama in amate hung tu in zum sungah dinpui ngawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ngilkial mite in a mawmaw sia ii lo an — ling kawm ah a po lo ante ngawngawn — neaksak tu uh hi. tuaciang a dangko mite in ama ii nei le lamh te eang tu uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siatna sia lei sungah po ngawl a, ngimna zongh lei panin po ngawl hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hi ngawl tatak ma hi! Mihing in ama le ama ngim kipia a, mei eakte mei sung pan a peakto bang tatak ahi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang hi leng Pathian kung tuu in, ama tungah ka thu ka sung tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama ii nasep lian a septe ih tel zo bua a, nalamdang a laknate bo hun nei ngawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in leitang tungah nguazusak a lote tui buak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hi hi, a kiniamkhiakte a laamto le, a khuangai theampo lungdamna a pia sia Pathian hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama in mihing kukalte ii ngealnate lumleesak a, miciimte zongh a tup a sawmnate sung ma ah thaangsia hi, tuabangin amate ii sepna bangma a taangtung ngawl tu in vawt hi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate suntang ngawngawnin khuazing a lei zawtin pai uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahihang Pathian in mizawngte thina pan hun hi; Ama in a cimawte zawthawkna pan hun hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama in mizawngte lametna pia a, mi ngilote thimsak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian ii puua kik sia mi hampha ahi hi! Pathian in hong teih le thin uuk heak in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian in ama liamsuate ii meimate tuamsak hi; a khut taw nang hong nasak a, a khut taw nang hong damsak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hun khat zawk hun khat ama in nang lal theina pan hong hun tu hi;
  </para>
  <para style="p">
    <verse number="20" style="v" />kialpi a tun ciang ama in nang hong nungtasak tu a, tuaciang ngal sungah thina pan nang hong dal tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathian in nang sia sonsiatna pan hong suatak tu a, lalna a tun ciang nang hong hun tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangma in ngoltolnate le ngilkialnate na nuisan tu a, tuaciang ngamsate na kiita buatu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na lo thawna munah suang om ngawl tu hi; ngamsate in nang hong sim ngeingawl tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuaciang na puanbuk sungah thinnuamin na teang tu hi; na tuute na et ciang bit takin a om na mu tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngan thana munah lopa teete zaa in ta tam mama na nei tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anlaak hun dong a min mangtaang huite bangin a huai a teakin na nungta tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Job awng, hi thute koma ii khuangeipi ka sin ka heaksa uh hi. Thumaan thu ahikom tu in saang thiam in.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka ngimna le ka khuangainate khai kitee le
  </para>
  <para style="p">
    <verse number="3" style="v" />tuipi vaal a senvuite sangin ngitzaw tu hi, tua hi a kamkhal ka paunate in note lamdang hong sasak heak hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vaanglianbel Pathian in thaltangte taw hong kap a, tuaciang a nguu in ka pumpi zenh hi. Pathian in a kiitakhuai nate ka mai ah ngual hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Laa in lopa a neak ciang lungkim a, khuipui in taangphaw a neak ciang thim dide hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahizong akua in limna nei ngawl, ci al ngawl an ne zo tu ziam? Aktuui dida sungah bang limna om na ziam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuabang ante lim ka sa bua a, ka neak peuma in hong sungnimsak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian in ka nget sia banghang hong pia ngawl hi tu ziam? Banghangin ka thunget hong zo ngawl hi tu ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama in kei hong that vet pole maw!
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuabang hong tha nop tu sia he leng ka natna bangza in a lian tazong, lungdamin ka kilawn tu hi, Pathian thiangtho hi, ci in he khi hi; ama ii hong thupiak po nalh ngeingawl khi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka luhai lai natu in bang thahatna nei na khi ziam? Muanmawkna ka nei ngawl nungsang banghang nung tataa lai tu khi ziam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei suang taw kivawt khi ziam? Ka pumpi sia taau ahi ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima le keima ka kihut natu tha nei ngawl khi hi; hu ngen in ka tai thei tu mun om ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian nusia ka hi a, ka hi bua zong — hi bang ngimna ah lawm le ngual thumaan kisamh khi hi,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahihang no ka lawmte awng, nguazuk ngawl ciang a kang luite bangin hong theam nu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Luite vuuk le tuikhalte in khakcip a,
  </para>
  <para style="p">
    <verse number="17" style="v" />ahizong nisa sungah tuate bo a, lui taw teng kongaw in om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sennealngam khualhawte tui a zonna in ngam amh a; amate sennealngam sungah vakkotin thi uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sheba pan le Tema pan tua khualhawte in tui zong uh hi,
  </para>
  <para style="p">
    <verse number="20" style="v" />ahihang luiko hui teng ah a lametna uh bo hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />No teng sia kei atu in tua luikote taw kibang nu hi, ka thuak teng na mu uh ciang lau in nungkin nu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Letsong khat nong piak tu ahizong, kei taangin khat po sumnguk nong piaksak tu in ahizong,
  </para>
  <para style="p">
    <verse number="23" style="v" />ngal khat po ahibuale zawthawk thu a zangh thei khat pawpo pan ahizong nong hut tu in kong ngen ziam?
  </para>
  <para style="p">
    <verse number="24" style="v" />Pha hi, hong hil tavun, ka khialnate hong son tavun. Thim dide in ka om tu a, kong ngai tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thumaan kammalte up taak hi, ahihang no nawnsan nu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka kam pan vui bek pusuak in a pau hong sa nu hi; tua ahile thinkiam a ka paute banghang hong zo nu ziam?
  </para>
  <para style="p">
    <verse number="27" style="v" />Tanga silate na nga natu in aisaanna nuangtangte ngawngawn na lawn uh a, tuaciang na lawm phabelte duupin na hau natu zong nu hi!
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka maitang hong en tavun. Leilot ngawl tu khi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A vaal kai in pau zo nu hi. Na thumaan ngawlna uh kheal vun. Hong puanil heak vun. Kei sia thumaan khi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahihang leilot thuson hong sa nu hi — a maan le a maan ngawl khentel in son thei ngawl hong sa nu hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihing nuntakna in zawthawk thu taw ngalkap nasep bang, na ham sepna taw nuntakna bang le
  </para>
  <para style="p">
    <verse number="2" style="v" />sila khat ii nilim vot a lungngul bang, naseampa khat ii a thasum ngakin a om bang ahi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tha khat zawk tha khat, ka nuntak pui tu bangma ka nei bua a; zan khat zawk zan khat in khuangai lungzuan hong pia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A mu tu in ka lupsuk ciang naite cing hak a; zankhuateak kilumlet in khuavak tu kaal ka ngakla hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka pumpi sia thanh taw kidim hi; meima khiik in tuamcip hi; Ka meima pan meima nai luang hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka ni ka hunte muanmawk lam et om ngawlin bawbo a, thiamtakte khauphei kithalee sia sangin manlang zaw hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian awng, na phawk in, ka nuntakna husan khat hi bek hi; ka lungdamna bo zo hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tu in hong mu ni hi, ahizong hong mu kik ngeingawl tu ni hi. Kei nong zong le om nawn ngawl tu khi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meeikaai khat a bo vadi bangin, mihing khat thi a heak kik ngeingawl hi; ama a hete theampo in ama mangil uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hi ngawl hi! Thim om thei ngawl tu khi hi! Ka thin uuk a, ka thin veeila khi hi. Ka pau kul hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Banghangin kei hong cing nu ziam? Tuipi nganhing pui khat hong sa nu ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Lumsuk in tawlngak tu ka hanciam hi; ka natna pan noptuamna ka zong hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahihang nangma mama in mangte taw nong lausak a; mukholnate le mangsiate nong puak hi,
  </para>
  <para style="p">
    <verse number="15" style="v" />hi bang a ngimhuai pumpi taw ka nuntak sangin ka tawl hong kisaanlup tu uukzaw liang khi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka thinkiam zo hi; nuntakna cimtak khi hi. Kei nguak hong nusia tavun. Ka nuntak man om ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Banghangin nang atu in mihingte sia thupi mama ziam? Amate ii sep sia banghang thinnopmawkpui ni ziam?
  </para>
  <para style="p">
    <verse number="18" style="v" />Zing simin ama na vil a, a minit simin ama na ze et hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka ciltee valh tu hun sung beak leidang en ngawl tu ni ziam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Thongcing pa awng, ka mawna in nang hong nasak ziam? Banghang phutuun sinna in kei hong zangh ni ziam? Nang atu in vanh ngitpi ka hi ziam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka mawna hong maisak thei ngeingawl tu ni ziam? Ka sep khialna hong hesuak thei ngawl tu ni ziam? Hai ngawlin ka thaankuul sungah ka om tu hi, tuaciang kei nong zon ciang ka om nawn buatu hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na hawpai kamtam thuson teng na man zo ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian in thutang lumlet ngeingawl hi; ama in a maan ngawl vawt ngeingawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian tungah na tate khial hi nanak tu hi, tua ahikom amate taw a kilawm bangin ama in daan pia hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahihang tu in kiheak in a, Vaanglianbelpa Pathian tungah thuum ta'n;
  </para>
  <para style="p">
    <verse number="6" style="v" />na thumaan mama a, na thiangtho le, Pathian hong pai a, nang hong hu tu hi, tuaciang na bangkua sia na thaman tu in puuapha tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nei le lamh na bosua theampo sia tua hun ciang Pathian hong piak tute taw en khawm leang son thamman ngawl tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Taanghlai hun a ciimna kan pak in; ih taanghpupite heak thumaan thutak te ngaisun in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ih khantom a, bangma ih heak om ngawl hi; leitung nuntakna sia limhte taw kibangin ih kaantan hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihang taanghpupi miciimte in hilsak in; amate hong sonna teng ngai in:
  </para>
  <para style="p">
    <verse number="11" style="v" />“Pumpa sia tui om ngawlna ah po thei ngawl hi, ciknawng omna puasia ah tuate kimu ngeingawl hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />No lei lai a, zak tu in saat thamman ngawl lai ahitazong, tui a kang le tuate sia a vul phit tute hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian selte sia tua pumpate taw kibang hi; Pathian a makngil uh po ciang a lametna bo hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate in khau zam khat — momkhau khat muang uh hi,
  </para>
  <para style="p">
    <verse number="15" style="v" />amate in pangpaan kaai khat neal le tuasia in amate do zo tu ziam? amate in khauzam khat zamh le tuasia in amate khuangkho zo tu ziam?
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi ngilote sia nitaang sungah lopate po bangin, huan bup lopa beakte taw kibangin po a, zel keak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A zungte in suangte vial a, tuaciang suangtum om theampo man tinten hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahihang tuate bot le uhte — tuate tua munah om ngei ahi hunlam a he khat zongh om ngawl tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hi hi, mi ngilote ii lungdamna sia tuabang teng hi; tu in midangte hong pai in a omna suan uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahihang Pathian in a thumaante taisan ngeingawl tu a, a tatsia mite huna pia ngeingawl tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in nang hong nuisakin hong ausak kik tu a,
  </para>
  <para style="p">
    <verse number="22" style="v" />ahizong ama in nang hong ensante tungah minsiatna tungsak tu hi, tuaciang mi ngilote bangkua teng bomang tu hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hi hi, tuate theampo sia ka zaak ngeisa vive hi. Ahizong, mihing khat in Pathian langpanna thu ah, bangbangin thu zo thei tu ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Bangbangin mihing khat po in Pathian nial zo tu ziam? Ama in kuama ii zo thei ngeingawl tu thu dokna tul khat, dongh thei tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian sia ciim peuma a, vaanglian hi; kuama in ama langpan zo ngawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama in kidop natu thu son khol ngawlin mualpite khiin a, tuaciang a thin uukna taw tuate susia hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in zinliingsak a, lei ngawksak hi, ama in leitung a nang khuamte thiing hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama in ni a sua ngawl natu in khak thei a, tuaciang zanin aksite taangsak ngawl thei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian ii vantungte a phalh ciang ahizong tuipi nganhing pui sia ii thibin a totcip ciang ahizong kuama in hu ngawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in aksite — Solh, Siluk, Zawlzawng te le thangsang aksite van ah khai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na lianpi ama ii septe ih tel zo bua hi, tuaciang ama ii lamdang laknate bo hun nei ngawl hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in hong kaantan hi, ahizong ama ka mu thei bua hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama in a dei po la a, kuama in tho thei ngawl hi; kuama in, “Nang bang vawt ni ziam?” ci in dongh ngam ngawl uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian ii thin uukna sia thai ngeingawl hi. Ama in ama langpan tuipi nganhing pui Rahab tha a pia a ngalte ngoaicip hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tua ahikom Pathian kam ka zo natu kammalte koi bangin mu thei tu khi ziam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Mawbaang ngawl ka hihang ka vawt theibel sia Pathian ka thukhenpa munah hesuak nget tu ahi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuasia ciang ngawngawn in, ka pau tu hong oai hial le zong, ama in hong ngai tu in ka um thei bua hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama in ahang thu om ngawl bulin kei hong nawk tu le hong liamsak tu vuipi suangvalte hong paisak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in ka hu zongh hong diiksak man bua hi, ka nuntakna a sia a kha taw hong dimh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thazaw ka suang tu ziam? Pathian tungah thazaw kisuang thei ziam? Thukhenzum ah ama then tu khi ziam? Akua in ama paisak thei tu ziam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Mawbaang ngawlin thumaan ka hi hang ka kammalte sia a mawte ii awsua bang ka hi hi, tuaciang ka pau theampo in kei hong puanil taw kibang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mawbaang ngawl khi hi, ahizong awlmaw zo nawn bong. Nuntak tu ngaisun zo ngawl khi hi, thupi ka sak om nawn ngawl hi; maw ka leang, maw bua ka leang Pathian in eite hong lalsak tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A maw ngawl mi khat thakhat thu in a thi ciang Pathian nui hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathian in leitung sia mi ngilote pia hi. Ama in thukhenmangte theampo mittawsak siat hi. Tuabang sia Pathian ii vawt ahibuale akua vawt ziam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka ni hunte pai vahan a, khat zongh a pha om ngawl hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ngunkuang manlangbel sia bangin ka nuntakna bo vazangh a, muvanlai ii bilpi khat man tu in a suktun bangin manlang hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zumnui maitai in ka natnate makngil sawm leng ngim ka thuakna theampo in hong lauthawn tu in hong vil kik hi. Pathian in kei sia a maw ma in hong koi hunlam ka he hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Maw hong kiputsak zawk nungsang banghang awlmawk tu khi ziam?
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka mawnate hong silthiang zo tu satpia om ngawl hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian in a kiihuai dum sungah kei hong lawn suk a, ka puansilhte ngawngawn in kei hong maizum pui hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pathian sia mihing hile a kam zo thei khi hi; ka kihauna uh thukhen tu in zum ah pai thei tu khu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahihang ko kilaklaw ah palai hong seam tu kuama om ngawl — Pathian le kei thu hong khen khawm tu kuama om ngawl hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pathian awng, kei daan nong piak tawp in! A kiitakhuai na vawt te heam in!
  </para>
  <para style="p">
    <verse number="35" style="v" />Kei lau ngawl khi hi, pau tu khi hi, banghang ziam cile ka thinsung keima in he khi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka nuntak cimtak khi hi, lungkim ngawl a, ka phun ka mauna hong ngai ta'n.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hong puavawk heak in Pathian awng. Kei nong mawsakna a bang hi thong ziam? Hong son ta'n!
  </para>
  <para style="p">
    <verse number="3" style="v" />Tua zata bang na ngitlo sia maan tu ziam? Nangma vawtsate ma zawnsak vawt tu ni ziam? Tuaciang mi ngilote sawmna tungtaang ah maipha pia tu ni ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kote muna bangin tuate na mu ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ko ma bangin na khantom ziam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua ahile banghang ka mawna theampo hong sul zui in, ka sep khial theampo banghang hong vaizui ni ziam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Maw ngawl ka hi hunlam le, na khut sung pan kei hong hun thei kuama om ngawl ci sia na he hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na khutte in kei hong piangsak a hong zeam hi, tuaciang tu in tua khutte ma in kei hong lalsak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tungman panin nong vawt sia phawk kik in a, leivui suak tu in hong ngoaivui kik tu ni ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma in kei pian natu in ka pa thahatna na pia a; ka nu sulh sungah nong khangsak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka pumpi sia ngute le sazangte taw na vawt hi, tuaciang tua ngute sia sangol le vun te taw na tuam hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nuntakna le a kikhomsuan itna nong pia zo a, tuaciang nong khoi nong kepna taw kei nong nungtasak zo hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahihang tua hun sung theampo ah nong natsak natu na ngeal ku sia tu in ka he hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka mawna nong maisak nop ngawl hu in mawna a vawt ziam ci in nong encik hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka maw poma ciang ngim nong thuaksak a, ahihang a maanin ka ngamtat ciang maipha ka nga bua hi. A cimaw a maizum in ka om hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zawna khat pawpo nei lei leng zong, tawpi khat taw kibangin nong vai hi; hong liamsua tu in nalamdang laknate ngawngawn na vawt hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kei hong langpanin a ding tu tetti na nei tawntung hi; Kei tungah na thin uukna khang vaial hi; kei nong sim natu ngealna thak na nei tawntung hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian awng, banghang hong piangsak ni ziam? Kuama ii hong mu ma in ka thi tu hi zo kana ve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sulh sung pan thaankhuk ah paitan paih hi leng a om ngeingawl sia bang hi tu kana ve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka khan bo dektak zo hi ngawl ziam? Kei nguak hong omsak kapo in! Ka hun nei lai sun teng a nuamin hong zanghsak ta'n.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hai ngawlin ka pai tu a, kong heak kik nawn buatu hi — ka zot natu ngam sia thinkiamhuai in, khuamial in khuazing cip a,
  </para>
  <para style="p">
    <verse number="22" style="v" />khuazinna, limhte taw a kiliana le lungman buaina ngam hi a, khuavak sia khuazing a hina mun ahi hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hi nawnsan thute theampo kuama in zo kik ngawl tu ziam? Kam tam pauna in mihing khat a maan suaksak ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Job awng, koma in hong zo kik thei ngawl tu hong um ni ziam? Nong nunauna kammalte in kote pau ngawlin hong koi tu ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Na pau teng thumaan hi ci ni hi; Pathian muna ah ka thiang ci ni hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian in na kam hong zo le uuk na peu ing!
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in ciimna nam tam a om sia nang hong son tu hi; mihingte heak zawk ngawl thuthukte a om sia nang hong son tu hi. Pathian in na kilawmna za sangin a tawm zaw daan hong pia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian ii letna le a vaang ii a phakcia le a mongte na mu thei ziam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Van sia Pathian atu mong nei ngawl ahihang, tuasia nang bat zawk hi ngawl hi. Pathian in mithi khua he ahihang nang in na he bua hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian letna sia simlei sangin zaizaw a, tuipi sang zong zaizaw hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian in nangma hong manin, thusit tu in hong puak le ama a khaktan tu akua om ziam?
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in akua teng mannung ngawl ci sia he hi; ama in amate tatsiatna theampo mu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngam laate a zual sa in a pian ciang mi ngoaite a ciim hong kipan tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Job awng, na thin maansak in, Pathian zuan in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na bangkua sung pan siatna le tatkhialna teng heam in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuasia zawkciang dinmun kho le hangsanna taw leitung vaite maingat kik in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuasia ciang, na ngimna theampo na ngaisutna pan a bosa namthuam bangin kiciamtee nawn ngawl tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na nuntakna sia sunkim laitak nitaang sangin taang zaw tu a, tuaciang na nuntakna a zingbel hunte zing khuavak bangin taang tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngal muanna le lametna taw kidim in na nungta tu hi; Pathian in nang hong dal tu a, tawlngakna hong pia tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na ngalte na kiita buatu hi; mihing tam mama in huna hong ngen tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahihang mihing ngilote thinkiam in, a kiim a paam en tu a, tuaciang suatak natu lam om ngawl cisia mu tu hi. Amate lametna khat sia thina hong pai tu ci thu bek ahi hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hi hi, na kampau sia mihonpite ii a ci nop teng hi. Na thi uh ciang ciimna sia note taw thi khawm tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahihang, kei zongh no ngaisut za ma ngaisun thei khi hi; Note sang in kei nangh zaw tuan ngawl khi hi; na sonsa theampo sia a kuama po ii heaksa thu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tu in ka ngualtamhte ngawngawn in kei hong nuisan hi; kei thutang in sit baang ngawl hi napi hong kinuisan hi; ahihang Pathian in ka thungetna hong zo kik hun om ngei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Note ngim nga ngawl nu hi, ahihang ciammuina in hong nei nu hi; mihing a puk dek khat vel nu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahihang ngutate le Pathian a selte sia amate ii tha le ngal bekma a pathian hi napi thinnuamin nungta uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vacimte le nganhingte ngawngawn in no hong hil thei natu thu tam ma nei hi,
  </para>
  <para style="p">
    <verse number="8" style="v" />leitung le tuipi nganhingte ii ciimna ngen in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amate theampo in Topa khut ii a vawt hunlam he uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A piansaksa te ii nuntakna lam a lak sia Pathian hi; mihing theampo nuntakna sia ama ii khut sungah om hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahihang na leei in an tep a, diksa ahi bangma na bil in kammalte a zaak sia diksa hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pasal haamte in ciimna nei hi, ahihang Pathian in ciimna le vaangletna nei hi. Pasal haamte in thuthuk mu hi; Pathian in thuthuk muna le vaangletna nei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian in a balthap ciang akua in sa kik thei a, Pathian ii thong a khiak sia akua in suatak thei tu ziam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian in nguatui a khaam ciang nguatui hang a; tuite a tha ciang namthuam hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian sia thahat a, a tawntungin ngalzo hi; ngual theamte le theam thuakte ama khut sungah om hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama in ngamukte ii ciimna laaksak a, ngam lampuite sia a mawmawte bangin ngamtasak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in kumpite za taaksak a, thong sungah khum hi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in thiampite le vaang nei mite kiniamkhiaksak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama in a kimuang mite thimthusak a, tuaciang uhaamte ii ciimna laaksak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in vaangletna a neite min siasak a, ngamukte ii thahatna bosak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama in thina bang ahi khuazingna munte ah khuavak puak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama in ngamte thahatsakin liansak hi, ahihang a zawkciang tuate zo in lalsak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama in a lampuite mawmawsak a, lungmang sa le ngammang sa in vakvaisak hi;
  </para>
  <para style="p">
    <verse number="25" style="v" />amate khuazing sungah zawtin vak uh a, zukhamte bangin hoi vatut uh hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na son theampo ka zaak ngeisa vive hi. Tuate ka tel siat a; na heak za uh ma ka he hi. Kei, no sangin nangh zaw tuan ngawl khi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahizong ka thu kinialpui sia Pathian hi a, no hi ngawl nu hi; ka thu sia ama taw kinial nuam khi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na heak ngawl uh teng leilot thu taw seal nu hi; no sia kuama a damsak zo ngawl syavuante taw kibang nu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bangma son ngawlin om vun, tuasia ciang khat po in a ciim hong sa tha tu hi!
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka thu kong pualaak ciang ngai vun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Banghangin leilot nu ziam? Na leilotnate in Pathian phatuamsak tu in ngaisun nu ziam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama sungsia tu hanciam nu ziam? Ama ii thu sia zum ah kinial nuam nu ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in no hong en cian le a pha khat pawpo a mu tu ziam? Ngual na theam uh bangin Pathian theam thei tu in ki um nu ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Doidan nopna na seal uh hang ama in no hong teih tu a,
  </para>
  <para style="p">
    <verse number="11" style="v" />tuaciang ama thahatna in no hong lausak tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na paunakte vut taw kibangin kimanna om ngawl hi; na ngatang seenate tungman bangin topcip hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thim khipkhep vun a, thuson tu hun khat kei hong pia tavun, a sua nop po suak hi tahen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima in ka nuntakna pia tu in ka kinging hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka lametna theampo bosua zo ci leang Pathian in hong that hial zong bang phamaw ziam? Ama tungah ka thu sung tu khi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka hangsanna zongh in hong hun thei lai hi, banghang ziam cile mi ngilo khat peuma in Pathian mai si ngam ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tu in ka son telna kammalte ngai vun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka thu sung tu in kinging zo khi hi, banghang ziam cile keima ka maan hunlam kihe khi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian awng, kei maw hong suan tu in hong pai ni ziam? Tuabang hong pai na hile thim om in a thi tu kinging khi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thu nam nii hong ngensak ta'n; tuate thukim lete nang kung pan buk tu hanciam ngawl tu khi hi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Kei daan nong piak tawp in a, launa taw kei hong sucip heak in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian awng, pau masa in, hong zo tu khi hi. Tua ahibuale kei hong pausak ta'n a, hong zo ta'n.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka mawnate bang teng ziam? Khialna ka vawt bang om ziam? Bang khialna liante taw kei hong kimawsak ziam?
  </para>
  <para style="p">
    <verse number="24" style="v" />Banghangin kei hong pial ni ziam? Banghangin hong ngal vawt ni ziam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Kei hong lauthawn nuam ni ziam? Kei sia thingtee khat hi lel khi hi; taangphaw ko sa khat a ngal vawvawt na hi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kei tungah nasia takin maw nong suanh hi, ka khanmoi lai ka ngamtatna ngawngawn taw nong mawsak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka peangte thikkol nong bulh hi, ka kalsuan sim nong encik a, ka khuanite ngawngawn na en cian hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tua hu in thing muatsa bangin ka topcip a, nget ii neaksa puanpuasilh bangin ka om hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eite theampo sia a thaneam a cimaw sa in ih piang hi. A vekpi in khantom nuntak haksatna le ngimnate a kibang in kidim hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ih khangto a, paakte bangin manlang takin ih vul hi; limhte bangin ih bo hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian awng, kei nong en beak tu ziam, ahibuale thu hongsit in kei tungah thu nong khen tu ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihing bang a thiang ngawl na khat pawpo sung pan a thiangtho na piang thei ngeingawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama khansau za tu — a nuntak hun tha pha za tu sia a masia in kikhensat zo hi. Nangma in tuate na khensat zo a, tuasia kilai kik thei ngawl tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mundang en in a, ama nguak nusia in; Ama in a thuak zo tu ahile — a nuntakna haksa sungah nuamsasak in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thingkung kiphuk sa khat atu in lametna om hi; tuasia nungta kikin meang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zungte haamin, a bul lei sungah thi kale
  </para>
  <para style="p">
    <verse number="9" style="v" />tui a nga thingkung no bangin meang tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihang mihingte thi a, tua in amate tawpna hi; amate thi hi, tuasia zawkciang amate koisungah om ziam?
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngun a luan tawp te, tuili a kangte bangma in,
  </para>
  <para style="p">
    <verse number="12" style="v" />mihingte thi in, a tho kik ngei buatu hi. Vanpi a kip laiteng amate khanglo ngeingawl tu hi; amate a mutna pan tung nawn ngawl tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mithi khua ah kei hong seal heu lete uuk nang; na thin uuk thai dong hong seal ka ven, tuasia zawkciang kei nong phaw kik natu hun khat ciangtan in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihingte thi le amate nungta kik thei ziam? Ahihang hi ngim ngana hunte a bo dong hun phazawte ngak tu khi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuasia ciang nong sam tu a, kong zo tu hi, tuaciang nong bitphua sa kei tungah na lungkim tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua zawkciang ka kalsuan simin nong encik tu a, ahizong ka mawna ka khialna te nong sul zui buatu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma in tuate na maisak tu a, na heam tu hi; ka vawt a maan ngawlte theampo na niilkeak tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mualte a cip tu hun le a kip suangliangte a kikhin tu hun hong theng tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tui in suangpite seu tu a, tuaciang nguapi in leinealte tai tu hi; tuabang keakin kote ii nuntak tu lametna teng na lalsak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing khat na zothaw a ama a tawntung na hawlkhia hi. A thi ciang a meal mang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tapate in minphatna nga kale ama in heaksak ngeingawl hi, amate a min siat ciang ama tungah kison ngawl hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama in ama ii a pumpi natna le a thin heena teng bek phawk hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng! na kammalte a hawmpi hi, a hawmpi hi!
  </para>
  <para style="p">
    <verse number="3" style="v" />Miciim kuama in nang pau bangin pau ngawl hi, ama le ama tuabang khiakna nei ngawl kammalte taw a kidal om ngawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma ci bang suak thei thong le kuama in Pathian kiita ngawl tu a; ama tungah kuama in thungen ngawl tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na seksolna sia na pauna panin kilangh hi; na pilna kammalte taw kiseal sawm ni hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kei in nang kong puanil tu kul tuan bo; na pau kammal theampo taw nangma kipuanil ni hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang sia mihing a piang phitbelpa kisa ni ziam? Pathian in mualte a vawt lai in om ni ziam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian vaihawmnate za ku ni ziam? Mihing ciimna sia nang bek in nei kisa ni ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ko ii heak ngawl thu khat pawpo na heak om tuan ngawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka ciimna uh sia na pa ii pian ma in a piangte — puakkaang sa mite tung pan ka heak uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in nang heenepna hong pia hi; banghangin nolh lalai ni ziam? Ama taangin kam-uai in kamthiam taw pau khu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahihang nang na hile, patau in thin uukna taw ko nong sal hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian tungah na thin uuk a, ama na son sia hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing khat pawpo sia thiangtho takpi thei tu ziam? Mihing khat pawpo sia Pathian muna ah maan thei tu ziam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahang sia Pathian in a vantunglalangte ngawngawn muang ngawl hi; amate zongh ama muna ah thiangtho ngawl hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuaciang, mite in siatna sia tui bang phetin dawn uh hi; hi hi, amate lal in mannei ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Job awng, ka heak kong son sia tu in ngai in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Miciimte in a taanghpupite tung pan a heak uh thumaan thutak te kei hong hil zo hi, tuaciang amate in thukute seal nei ngawl uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A ngam sungah ngamdangmi om ngawl hi; Pathian taw amate a kikhualasak tu kuama om ngawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngualdang a zothaw mihing seksol khat sia, a khan tawntungin ngim thuak tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A lauhuai awte a nakheng sungah ciik au tu hi, ngammuang a kisak laitak phalakte in ama sim tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amate in khuazing sung pan a suatak tu lametna nei ngawl hi, banghang ziam cile namsau khat in amate that tu in mun khat pan ngak hi,
  </para>
  <para style="p">
    <verse number="23" style="v" />tuaciang amate ii luang ne tu in vaciikte in ngak hi. Amate in a mailam khuazing ahi sia he a;
  </para>
  <para style="p">
    <verse number="24" style="v" />a thahat kumpipa khat bangin tuasiatna in amate sim tu in ngak nginge hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuasia in Pathian khuttum a ngat, Vaanglianbelpa a nalh mihing khat ii thuak tu a tangsa ahi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amate kiphasak a leedo kin uh hi; amate in thinpui takin a lum laamto a, Pathian do tu in tai uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amate sia khuapite a la le a neite ii taisat sa innte a suan te hi a, ahihang ngal in tua khuapite le innte lalthamsak tu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amate khuangei hau ngawl tu hi; a neisa bangma kikhomsuan ngawl tu hi. A limh uhte ngawngawn bo tu a,
  </para>
  <para style="p">
    <verse number="30" style="v" />tuaciang amate khuazing sung pan suakta ngawl tu hi. Amate sia a baakte mei ii a kak, a paakte vui ii seamkeak thingkung te bang hi tu hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amate in siatna a suang tu in a mawmaw lawlawm uh le siatna sia amate ii tel hi tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A hun a cin ma in amate vulcip tu uh hi, thingbaak khat bangin vulin hing kik ngei nawn ngawl tu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amate a nga ung lai teng a pul sapitkung bang hi tu hi; amate sia a paak pul sa olive kung bang hi tu hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pathian a sel mite atu in suan le paal om ngawl tu a, sumnguk taw a kisa innte kaanghmei tawk in laltham tu hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hi mite sia ngual ngim piak sawm in, siatna a vawtte hi a; amate thinsung sia ngualtheam nopna taw kidim tawntung hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kammal tuabangte tu masia in ka za ngei zo hi; heenepna nong piak uh sia ngim kipiakna hi bek hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pau tan viuveu tu nu ziam? kam a pau khak tu sia na uukna in kam tungnut kitu nu ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kei dinmun ah no om le uhte a, no dinmun ah kei ding leng, no pau theampo kei zong pau thei tu khi hi. Tel takin ka lu pei a, kam tam mama kong son thei tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngaisut piakna taw no kong thahatsak thei tu a, heeneam tu in no kong pau pupui tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahihang ka thusonte in bangma hong hu ngawl a, ka thim om ciang zong ka natna nuamtuam tuan ngawl hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian awng, hong toisak niknek zo ni hi, ka innkuan in hong kithalup tu na oai zo hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangma in nong pummat zo a; ka ngal na hi hi. Ka vun le ka ngu nguak bekin ka om a, tuasia zongh ka maw hunlam a kilakna in mite in ngaisun hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in thin uukna taw ka ngu ka taang khat zawkciang khat thiaktan a; etsatna taw kei hong ngau hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mite in kei hong nunau a; amate in hong kiim uum in ka maitang hong beang hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in kei sia mi ngilote khut sungah hong aap zo hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thinnuam in ka om a, ahihang Pathian in ka longtawl pan hong zamh a, hong vel in hong sucip hi. Pathian in phutuunna in hong nei a,
  </para>
  <para style="p">
    <verse number="13" style="v" />tuaciang ka kiimkot pan thaltangte taw hong kap a — tuate in hong sun in hong liamsua hi, tuasia ciang zong ama in hong hesuak tuan bua hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama in kei hong liamsua kikik hi; Ngual a huatsa leilam ngalkap khat bangin ama in kei hong sim hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khuangai in khau-ip puan ka silh a, hi sung leivui sungah ngallel in ka tocip hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka mai a san dongin ka kap a, ka mit tumin ka mitkhu bolin dup hi,
  </para>
  <para style="p">
    <verse number="17" style="v" />ahihang ngongtat mawna khat zongh ka vawt bua hi, tuaciang Pathian tungah thin tak taw thu ka ngen hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Simlei awng, kei tungah hong kivawt khialnate seal heak in! Thukhaikim natu ka sapna aw thimsak heak in!
  </para>
  <para style="p">
    <verse number="19" style="v" />Kei atu hong ding tu le kei hong panpui tu vantung ah khat om hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka lawmte in kei hong lang a; ka mit pan ka thituite Pathian mai ah taak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing khat in a lawmpa atu a maangkaasak bangin kei atu in Pathian tungah hong thuumsak tu khat ka kisamh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tu in ka kumte bawbo a, a kiheak kik ngawl tu lampi ka tawn hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka nuntak hun a bo tu nai zo a, ka hu zongh ka sang lalaa hi; thaankuul simngawl kei atu bangma om nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngual theampo ii hong nunau zazaan nate ka en bek hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian awng, kei thumaan khi hi. Ka kammal hong saang ta'n. Ka pauna hong panpui tu kuama om ngawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amate khua ngaisut thiamna teng na khak hi, tu in amate in kei hong zosak heak in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Paunak lui sungah mihing khat in sum huvau in a lawmte leeheak a, tua hu in a tate in thuak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu in mite in hi paunak sia kei tungah hong zangh hi; Amate hong pai in ka maitang cil hong phii hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka heena in ka mit hong tawsak phial hi; ka khut le ka peang te sia limhte bangin zeen kiangkuang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thumaan khu hi a kicite in ciza in ingh a, amate theampo in kei sia Pathian sel ci in hong ningkhiin uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zatakhuai khu hi a kicite in amate ngaisutna maan kisa vaial uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihang amate a vekpi hong pai in ka mai ah hong ding tek le, amate sungah a ciim khat beak zongh ka mu buatu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka ni hunte bawbo a; ka tupnate taangtung ngawl hi; ka lametna bo hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahihang ka lawmte in zan sia sun hi ci a; khuavak nai hi ci hi, ahihang khuazing sungah om lai ka hi hunlam ka he hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka lametna in mithi khua bek hi a, tua mun khuazing sungah a mu tu in ka lumsuk tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thaankuul sia ka pa ka ci tu a, kei hong ne thanh te sia ka nu le ka suapuinumeite ka ci tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei atu lametna khat pawpo koi sungah om ziam? akua in tua lametna mu tu ziam?
  </para>
  <para style="p">
    <verse number="16" style="v" />Mithi khua ka zotsuk ciang kei taw lametna tonkhawm ngawl tu hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng, nang bang mihingte thim om thei ngeingawl tu ahi bua ziam? Na pau tawlnga in hong ngai po lete hong paupui thei tu khu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ko sia khui khawng bangin mawmaw ci in akua in nang hong ngaisunsak ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Na thin uukna taw nangma le nangma a kinatsua hi bek ni hi. Na thin uuk hang po in leitung kinusia tu ziam? Pathian in na lungkim natu in mualte a khiin tu ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi ngilote ii khuavak taang kimitsak lai tu hi; a meikuang kuang kik ngei nawn ngawl tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tuipuan bukte sungah a meiinn sia kimit tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A kalsuannate kho hi, ahizong tu in amate lutu hi; amate ma ii ngaisut a kipiakna taw amate puk hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngen khat sungah amate vak a, a peangte awk hi;
  </para>
  <para style="p">
    <verse number="9" style="v" />thaangsia na khat sungah a khuatulte awk a, lencip hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lei ah thaangkhau khat kiseal a, a lampi ah thaang khat kisiah zo hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A kiimkot panin launa in ngak hi; tua in a kalsuan simin amate zuizen hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amate hau ngei hi, ahihang tu in ngilkial in vak hi; tuasiatna in a kung panin ngak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A kiitakhuai natna khat amate ii pumpi tungah kizel a, a khut le a peangte muatsak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate ngammuang takin a teenna tuipuan bukte panin kinuaicip a, Thina Kumpipa mai ah kikaikeak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tu ahile natna a nga thei ngawl natu in kaan a kithe zawkciang, a kuama po a tuipuan buk sungah teang thei hi!
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuate ii a baakte le a zungte sia vulin ko hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amate ii minthanna sia tualsung le ngamdang ah bo vangeu a; kuama in amate phawk nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amate a nungtate ngam pan kinotkeak tu a, khuavakna pan khuazingna ah kinot tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amate in suan le paal nei ngawl a, kuama taang nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nisuana pan nitumna dong amate ii thuakna a za theampo lau in liinglawng hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuasia in mi seksolte ii thuak tu hi a, Pathian a awlmaw ngawlte thuak tu a tangsa ahi hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Banghangin kammalte taw kei hong vawtsia tawntung nu ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Hun khat zawk hun khat kei nong selno tawntung uh a, nong vawtsiat hu in maizum ngawl nu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sep khial keak ka nei zong, tua in no koibang hong nasak ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />No hile kei sangin phazaw kisa nu hi, tuaciang ka ngimnate, ka maw hu in a piang sa nu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hi sia a seam sia Pathian a hi sia mu thei ngawl nu ziam? Ama in kei hong mat natu in thaang hong sia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama ii ngongtatna lungkim ngawlin, nial leei kaleng kuama in hong ngai ngawl hi; thukhaikim ka deina in ka au sia kuama in za ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian in lampi khak zo a, ka paisuak thei bua hi; ama in khuazing sungah ka lampi seal zo hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama in ka nei ka lamh theampo la siat zo a, ka minthanna siasak zo hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in ka ci tung mun theampo hong vel zazaan hi, ka lametna hong zunglok a, vul in a thi tu in kei hong nusia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian thin uukin kei tungah a thin hong so hi; ama ii ngal ciphabel bangin kei hong vawt hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei hong sim tu in a ngalkaphonpite hong paisak hi; amate in kulhte to in ka tuipuan buk uumci uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka suapuipate ii hong taisat sia Pathian ii vawt hi; Kei hong hete atu in kei sia khualmi ka suak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka beete le ka ngualtamhte bo siat zo hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka inn ah zin hong tung ngeite in kei hong mangil zo hi; ka naseam numeite in khualmi khat le ngamdangmi khat bangin kei hong vawt hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Naseam khat ka biapui ciang, ama tung hu ka nget ciang, hong zo ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka zi in ka husan ngim namh zo ngawl a, ka suapuipate in hong neak ngawl uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Patangte in hong mu ciang hong zawngsak in hong nuisan uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka ngualtamh pha belte in hong et ciang hong lipkhap uh hi; ka it belte ka lang ah pang uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka ngute tungah ka vuntunte kaai vadul hi; a nungta valiai bekma in ka suakta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Note ka ngualtamhte nu hi! Hesuak mulkimna hong nei tavun! Pathian khut in kei hong vaatvawk zo hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian ii kei hong vawt siat bangin, banghangin note in hong vawtsia hamtang tu nu ziam? Nong vawtsiatna uh tu za pha heu zo ngawl ziam?
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing khat in ka kammalte phawk in, laibu khat sungah ciamtee le paw oai napeu ing!
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua ahibuale sikkhu khat taw suang tungah ka kammalte a tawntung a kip tu in khen le oai napeu ing.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahizong vantung ah a om khat om a, a khakbel ciang kei hong hung tu in ama hong pai tu sia ka he hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Natna in ka vunte a neaktum zawk ngawngawn in hi ka pumpi sia taw ma Pathian ka mu tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama ka mittang mama taw ka mu tu hi, tuaciang ama sia khualmi khat hi ngawl tu hi. Ka thin letna bo hi, banghang ziam cile
  </para>
  <para style="p">
    <verse number="28" style="v" />noma in, “Bangbangin ama ii nat natu vawt zazaan thei tu hi ziam?” na ci uh hi. Kei nong sim natu uh paulap khat na zong uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahihang tu in tua namsau — mawna tungah Pathian thin uukna a thengsak namsau sia kiita vun, tua hile thukhen tu khat a om sia he tu nu hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng, ka ngaisutna hong lumlet ni hi, tu in kong zo tu kaal ngakla khi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na paunate zawnsakna kammal vive hi, ahizong kong zo natu daan he khi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Taanglai pek pan leitung ah mihing a kikoi ciil lai in
  </para>
  <para style="p">
    <verse number="5" style="v" />mi ngilote khuangei a lungdam ngawl hunlam he nanak tu ni hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amate van nawl in khangto a, nasia khan mama ahiciang a lutang in meeikaai te dongto thei hikale
  </para>
  <para style="p">
    <verse number="7" style="v" />ama sia leivui bangin kiseamkeak tu hi. Amate a he ngeite in amate ii thetna hawna he ngawlin a lung uh mang tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amate sia mang khat bang, zanlai mangmu bangin mangthang tu a, kimu kik ngei nawn ngawl tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A teen ngeina mun pan amate bo tu hi;
  </para>
  <para style="p">
    <verse number="10" style="v" />tuaciang mizawngte ii na a nguksak sia a tapate in piakik tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pumpi moi in hat mama ngei hikale hai ngawlin leivui suak tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama in siatna sia limsa mama a, namtui sa in a kam sungah pawlkhat muam hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahihang a an neakte a ngil sungah a sia a khaa suak a, nguu bangma in khaa tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi seksol pa in a nguktak haunate lua kik siat hi; Pathian in a ngilsung pan ngawngawn in tuate la kik hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi ngilo pa ii a valh sia nguu taw kibang hi; tua in ngulnguu hangte tuk bangin ama thatlum hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama sia olive thau a luang ngunte ahibuale noai le khuaitui a luang luite mu tu in nungta ngawl tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in a sepna sa theampo nusia tu a; a haunate nopsakna in nei man ngawl tu hi,
  </para>
  <para style="p">
    <verse number="19" style="v" />banghang ziam cile ama in mizawngte nengcip in awlmaw ngawl a, tuaciang ngualdang khat po ii sak sa innte sut hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A duhopna huvau in lungkim ci om ngeingawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amate an a neak uh ciang a khamvaal om ngei ngawl hi, ahihang tu in a nopsakna bo vangeu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A daupai bel laitakin thinngimna takngimna theampo in sukhuanin zawmcip tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A du a dei theampo ne tahen! Pathian a thinso, a thin uukin ama daan pia tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thik namsau pan suatak tu a hanciam ciang taau thal in ama kap vawk tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thaltang khat in a pum sung pailet in tangciak a, a tee thaltang dawn pan a chi mal taak hi, tuaciang a thin laucip hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A kholsa na theampo kilalthamsak a, mihing khut taw a kitaw ahi ngawl meikuang khat in ama le a innkuan bup kaangh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vantung in hisia pa ii mawna pualaak a, leitung in ama mawsiatna tetti pang hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama ii nei le lamh theampo Pathian thin uukna tuipawm sungah kisiasak tu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hisia mi ngilote thuak tu tangsa hi a, tua in amate thuak tu in Pathian ii seesa ahi hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kong son tu teng hong ngai tavun; Heenep natu kong nget sia, tua teng lian ma hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pau tu hun hong pia tavun a, ka man zawkciang nong nunau nuam uh le noma thu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A thithei mihingte taw a kihau hi ngawl khi hi; ka thin vei laakna sia ahang thupi khat om hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kei hong en tavun. Ingh in, thim om in, hong salhsak tham liang hi ngawl ziam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Kei tungah hong piangsate ka ngaisut ciang lung amh in liingin ka ci ngawk hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Banghangin Pathian in misia te a huai dong a nuamsa in nungtasak ziam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Amate in tate le tute nei a, tuate khan en tu in nungta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in a bangkua uh ah tuasiatna tungsak ngawl hi, amate thaa lau in nungta ngeingawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hi hi, a khuite theampo pungin a no sua ciang haksa ngawl hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A note sia tuunote bangin tai in kimai uh a,
  </para>
  <para style="p">
    <verse number="12" style="v" />tengtongh le tamngaite aw taw laam uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate thinnuam in nungta a, tuaciang ngimna thuak ngawlin nuam takin thi uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi ngilote in Pathian tungah koma nguak hong nusia ta'n ci uh hi; amate in a nuntakna sungah Pathian ii deina he nuam ngawl uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amate in Pathian atu sep kul sa ngawl hi, a tungah thunget zongh phattuamna omsa ngawl hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amate in a nei tha le ngal taw zawna ka nga uh ci hi, ahihang amate khua ngaisutzia ka saang thei bua hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi ngilopa ii meivak sia kimitsak ngei ziam? Amate khat in tuasiatna thuak ngei ziam? Pathian thin uukin a ngilote daan pia ngei ziam?
  </para>
  <para style="p">
    <verse number="18" style="v" />tuaciang vui ii taangphaw a seam bangin ahibuale vuipi suangval ii leivui a let bangin amate seamkeak ngei ziam?
  </para>
  <para style="p">
    <verse number="19" style="v" />A pa ii mawnate hu in a tate khat ii tungah Pathian in daan pia hi ci nu hi. Hi ngawl hi! Mawneite amate mama Pathian in daan pia hen; Amate mawna hu in ama ii tuabang a vawtna thu ama in lak hen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi mawte in amate aituamin daan thuak tahen; Amate in Vaanglianbel pa Pathian thin uukna thuak tahen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Eite ih khan man zawkciang ih tate ii a lungdam le a lungdam ngawl ih awlmawk takpi ziam?
  </para>
  <para style="p">
    <verse number="22" style="v" />A saangna munah a omte ngawngawn thu a khen Pathian tungah mihing khat pawpo in hilcian thei ziam?
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing pawlkhat sia a thi ni dong ciidam in nungta a; a pumpi uh zongh pha takin kivaak a, sa pha in, lungdamin olno takin thi uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A dangte in lungdamna nei vet ngawl hi; amate thinsia in nungta a, thinsia in thi uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahihang a vekpi, a kibangin thi a, a kibangin kiphum hi; amate a vekpi thanhte taw kituam hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Elna thin kukal na nei uh hong he khi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Tu in siatna a vawt mi liante ii innte koisung om ka na ziam?” ci in na dongh uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khualhaw mite taw thu kumkhawm ngawl nu ziam? Amate ii hong ko kik thute he ngawl nu ziam?
  </para>
  <para style="p">
    <verse number="30" style="v" />Pathian thin uuk a daan a piak ni in mi ngilote sia kikhoaikhe tawntung hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi ngilote a mawsiat tu kuama om ngawl hi, tua ahibuale ama ii sepsate theampo a thuk kik tu kuama om ngawl hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pha takin a kicing a thaankuul omna thaanmual ah amate a kipuak ciang,
  </para>
  <para style="p">
    <verse number="33" style="v" />mihing a tul simin thaan kuanpui a, a luangte tungah lei ngawngawn in dam takin vuknelh hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuaciang no na hi uh le! Thu nawnsan teng po taw kei heenep nong sawm uh hi! Nong zo kikna peuma leilot thu vive hi!
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihing khat pawpo, a ciimbel ngawngawn Pathian ii zak thei a suak ngei om ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />A maan na sep na vawtte in Pathian phatuamsak ziam, tua ahibuale a peuma in na phatna in ama hu ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma in Pathian na zatak hu in ama in nang hong hil a, hong sitna hi ngawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hi ngawl hi, tuasia na maw lei lam hang hi a; na tatsiatna teng theampo hang ahi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na suapui khat ii hong bat sum na losakna in a puan teng na laaksak a, bangma na kheetsak bua hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A toite tui na pia nuam bua a, tuaciang a ngilkialte an na pia nuam bua hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Leitang theampo na sungsuam natu in na vaang neina le na za neina na zangh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meingongte na hu nop ngawl bek dom ngawlin tangate zongh na suttol a, na vawtsia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua ahikom tu in na kiim theampo ah na taak natu vuumte om a, tuaciang thakhat thu in launa taw na kidim hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khua hong zing mama ahikom khua na mu thei bua a, tuaciang namthuam in nang hong khuum hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian sia a saangbel vantungte ah teangin, tuaciang aksite a omna saang napi ensuk hi ngawl ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahitazong nangma in, “Pathian in bang he ziam? Ama meeikaai in seal hi — bangbangin ama in ei tungah thu hong khen thei tu ziam?” ci in na dongh lalai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Van khuvum tungah ama a pai ciang meeikaai saate in khua a mu ngawl tu in ama seal hi ci in, na ngaisun hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi ngilote tot tawntung na lampi ma tawn tu in na khensat ziam?
  </para>
  <para style="p">
    <verse number="16" style="v" />A hun uh a tun ma ngawngawnin namthuam in amate taaikeak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hi mite sia Pathian a nialte le Pathian in amate bangma law zo ngawl tu in a um mite ahi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahihang amate nuamsa in a khangtosak sia Pathian hi a — mi ngilote thinsung ka tel thei bua hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi ngilote daan a kipiak a mu uh ciang miphate lungdamin maw baanna nei ngawl mite nui uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi ngilote neisa theampo kisusia siat a, tuaciang a taanglai sun peuma kaanghmei in kaanghtum hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Job awng, tu in Pathian taw kilemna vawt in a, ngalte khat bang a ama na vawtna teng tawlnga in, tuabang hi lete ama in nangma thupha hong pia tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama ii hong thuhilnate saang in a, a kammalte na thinsung ah ciamtee in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hi hi, Pathian kungah kiniamkhiakna taw heak kik hamtangin, na bangkua sungah a sia ngamtatna theampo na bosak ta in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na khamhte vawk in; na khamh pha belte luamko sungah sung in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vaanglianbelpa Pathian sia na khamh hisak in, nang atu a saangin a kiciang ngunn hisak in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuasia ciang Pathian na muang tawntung tu a, ama, na lungdamna ii naak ahi hunlam na mu tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thu na nget ciang ama in hong zo tu a, tuaciang na kiciamnate na len tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na sep na vawt theampo na taangtun tu a, na paina lampi ah khuavak taang tu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathian in a kiphasakte khia suk a, a kiniamkhiakte hun hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na sepna maanin, maw baanna na nei buale ama in nang hong suatak tu hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lungkim ngawlna pualaakin Pathian langpan lai khi hi; tau ngawlin ka om thei bua hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Koisungah ama mu thei tu khi ziam, tuaciang ama omna munah koibangin pai tu khi ziam ci sia ka he nuam hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A mai ah ka thu teng ka son tu a keima sang pan ka nial nopna teng ka sung tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama ii a son tu sia le bangbangin kei hong zo kik tu ci ka he nuam hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in a thahatna theampo kei tungah hong zangh tu ziam? hong zangh ngawl tu hi, ama in ka thusonte hong ngai tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima in thutak son khi hi; Pathian taw kam kikum thei tu khi hi; ama in kei, mawbaang ngawl hi ci in a tawntung atu in khatvei lian pualaak tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ni suana sangah ka zong zo a, ahihang tua munah Pathian om ngawl hi; Nitumna sang ka zon hang ama ka mu bua hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian sia saksang le thang sangah na seam hi, ahihang ama ka mu bualai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua hi napi Pathian in ka kalsuanna theampo he hi; Ama in kei hong sit le a thiangin hong mu tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama ii a teal lampi sia thumaan takin ka zui a, lam ka pial ngei bua hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian ii thupiakte ka seam tawntung hi; ama ii deina ka zui a, keima ii uuk bangin ka ngamta bua hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama kikheal ngeingawl hi. Kuama in ama nalh zo ngawl hi, tua ahibuale a vawt nopte kuama in khaam zo ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kei atu a ngealsa sia ama in taangtungsak tu hi; tuasia ama ngealna tam mama sung pan khat bek hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama mai ah lau in ka liing vadil hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vaanglianbelpa Pathian in ka thin hanna bosak hi. Khuazing in ka mit hong tawsak ahitazong hong patausak sia khuazing hi ngawl a Pathian ahi hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Banghangin Pathian in thukhen natu hun khat, ama na a seamte atu in thutang khen ni khat ciangtan ngawl ziam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Mite in leitang tamzaw a nga natu in, longi khiin uh hi; amate in tuute ngu in amate tuuhonte taw koi khawm uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amate in tangate neisa laanote la in, a leiba a lo dong meingong nu ii khuital keam hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amate in mizawngte ii a nga thei tute khaktan in; tuaciang a zawngkhalte zawthawkna taw taisakin buusak uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tua ahikom mizawngte sia, ngam laate bangin, duisung ngam kona sungah an zong uh hi; amate in koima dang po ah a tate an tu mu zo ngawl uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amate in amate ii neisa ahi ngawl lo ante a laak kul hi, tuaciang mi ngilote ii sapithuan sungah sapitngate lo uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zanin amate bangma silh ngawlin lum a, khuasik dal natu puan nei ngawl uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mualtung ah ngua a zute in amate tuamcipsak a, suangpite kung a kipha tinten in bealh uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Misiate in pasel patang note sal suaksak a, mizawngte ii tate leiba taangin la uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mizawngte ahile a kiseal natu puan nei ngawlin a vak kul a, mangtaang a at laitakin a ngil uh kial nanak tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amate in olive ngate sathau in ngoai a, sapitngate a tui suuk hi, ahihang amate mama a dang uh ko hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khuapite sungah a liamte le a thi dekte in au in a ko uh hang Pathian in amate thungetnate awlmawk ngawl hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khuavak a nial mite om hi; Amate in tuasia tel ngawl hi, ahibuale a lamlakna mun zuan ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khuavak ciang mi thatpa tho in mizawngte thatlum tu in kuan hi, zanin ama in ngual ii na nguksak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Palngul mawna a vawt sia in khuangial tu ngak hi; Ama in kuama ii mu thei ngawl tu in a maitang seal hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zanin ngutate in innte phuul a, ahihang sunin amate buu in khuavak pial uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amate in sun khuavak kiita a, ahihang amate atu in khuazing kiitakhuai ngawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi ngilopa sia khuanawl tuipawm in taaikeak a, tuaciang a neisa leitang Pathian in haamsiat hi; ama a sapithuan sungah naseam tu in kuan nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nisa khua kona sungah vuuk a tuithap vadi bangin mimaw khat sia a nungtate ii ngam panin bo vangeu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tu in a nu ngawngawn in ama phawk nawn ngawl hi; ama thanh in ne a, thing puk khat bangin kimuatsak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuabangin a pian sia meingongte a vawtsiat hang le tasel nupite tungah cikna thiamna a lak ngawl hang hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian in ama ii thahatna taw a thahatbelpa susia a; Pathian hong dian tak ciang mi ngilo pa thi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian in ama ngal muangin nungtasak thei hikale ama encik tan viuveu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tawmvei sung teng mi ngilo pa nuamsa hi, ahihang tua zawkciang ama lopa khat bangin vul a, ankung vui kisaattante bang ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tu a ka ci bang hi bo ci in khat po in a nial thei tu ziam? Ka kammalte maan ngawl hi ci in, khat po in a lak thei tu ziam?
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian vaanglian hi; mi theampo in ama kiita in zakta hen; ama in a vantung ngam sungah kilemna omsak tan hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama ii na a seam vantunglalangte akua in a phakza sim zo tu ziam? Pathian ii khuavak a taan ngawlna mun om ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian muna ah a thutang ahibuale a thiang, akua om tu ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama mit sungah tha ngawngawn taang sitset ngawl a, aksite zongh thiang ngawl hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua ahile tangteal, lungno ahi tua mihing sia bangbang hi tu ziam? Pathian mit muna ah mihing sia man nei tham ziam?
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />A zawngkhal a thazawm mi kei — atu in nong huna bangza in pha ziam!
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuabang ngaisutna pha nong pia a, kei bangin a mawmaw khat sia na heakna nong hawm hi!
  </para>
  <para style="p">
    <verse number="4" style="v" />Na kammal theampo akua in za tu in um ni ziam? Hi bang pau tu in akua in nang hong thaw ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />A thisate ii thaate sia leinuai ah a om tui sungah liinglawng hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mithi khua kihongin Pathian mai ah kilangh hi. Ama ii a mu thei ngawl natu in a khak a dal bangma om ngawl hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian in van saksang teng phalh a, tuaciang leitung sia mun awngpi sungah kaaisak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Meeite tui taw a kidimsak sia Pathian hi, ama in tuate a ngitna taw a puathap ngawl natu in keam hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama in thalik sia meeikaai khat ii nungah seal hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in khuazing pan khuavak sia tuipi maitang tungah a kisuai a beampui khat sia taw khen hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama in van a len khuamte a teih ciang tuate lau a kilok in liing uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama ii thahatna in tuipi zothal hi; ama in a thiamna taw nganhingpui Rahab thatlum hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama ii husan sia in van thiangsak a, tuaciang ama khut in a suakta nganhing pui sia that hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahihang hite ama thahatna ii a hiauhiau hi bek a, ngual ii kihuau in a son vasipte ih zaak hi bek hi. Pathian bangbang tatakin lian cisia akua in he thei tu ziam?
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thukhaikim thu hong pia nuam ngawl, ka nuntakna a lalsak, a nungta Vaanglianbelpa Pathian taw ka kiciam hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian in husanna hong piak laiteng in
  </para>
  <para style="p">
    <verse number="4" style="v" />ka kam ka muk in a sia peuma pau ngeingawl tu a, ka leei in leilot thu khat zongh son ngeingawl tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />No pasalte maan nu hi ci ngeingawl tu khi hi; ka mawban ngawlna sia ka thi dongin ka thasua buatu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Maan khi hi ka ci sia bangma hunin thasua ngawl tu khi hi; hi thu ah kithasunna om ngawlin ka thin thiang hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kei hong langpanin kei hong ngal vawtte a vekpi in mi seksolte le thutang ngawlte bangin daan kipia tahen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian selte nuntakna sia Pathian ii a tangkal hun ciang bang lametna om na ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngimna hong tun ciang Pathian in amate auna za tu ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amate in Pathian piak lungdamna sia a dei tu uh hi a, ama ii tungah tatsat ngawlin thu a nget tu ahi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian ii vaangletna bangza in lian ziam, hong hilsak tavun a, tuaciang Vaanglianbelpa Pathian in bang ngeal ziam ci sia no hong sonthiangsak tavun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahihang, kong hil bua zong noma mama in mu tek zo nu hi; tua ahiciang banghangin tuabang nawnsan thu son nu ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hisia in vaanglianbelpa Pathian ii a ngilo, a ngongtat mite daan a piakzia hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate in tapa tam mama nei thei tha tu hi, ahihang ngal sungah a vekpi kithat tu a; amate ii tanote in neak tu a kicing nei ngeingawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A nungta sunte zongh natna taw thi tu a, tuaciang a meingongte ngawngawn in a thi huvau in khuangai ngawl tu uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi seksol sia in sim zawk ngawl ngunntang nei tu a, khat pawpo ii kisap za sangin a tamzaw puansilhte nei tu hi;
  </para>
  <para style="p">
    <verse number="17" style="v" />ahihang mipha khat po in tua puante silh tu a, tuaciang mi thumaan khat po in tua ngunte tang tu uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi seksol pa in mombu bangin innte sa a, tua ahibuale lote a cing sila khat ii buk bangin sa hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hun khakbel khat sungah amate a hau in lum tu a, a khanlaw uh ciangin, a nei a lamh teng a bo siat mu tu uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thakhat thu in khuanawl suak bangin launa in nawk tu a; zanin vui in amate seamkeak tu hi;
  </para>
  <para style="p">
    <verse number="21" style="v" />ni suana vui in amate a inn uh panin lenkeak tu hi;
  </para>
  <para style="p">
    <verse number="22" style="v" />amate ii suatak natu a hanciam mama laitakin tua vui in amate dual ngawl hetin nuaimang tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amate a tai uh ciang, vui nging himhum in, lalsak theina hatna taw amate hawk a lausak hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngunn a kitawna mun ah a khukte om a, Khamh a kithiansakna munte zongh om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khuktote in thik sia lei sung pan to in, Tuaciang suang panin taausan tuisak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amate in khuazing thukbelna sungah zong uh hi. Amate in lei taw thukna ah zongin Tuaciang khuazing sungah suangte to uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihing khat pawpo ii teenna mun Tua ahibuale mihing peang taw khual a haw ngeina mun taw a kikhualana ah Mihingte in suangkhuk tumna hawngte to uh hi. Tua mun dum thukte sungah Ama in khau luai a lungzuangin naseam hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thaw ante leitang pan piang hi, Ahihang tua leitang sia ii nuai ah Na theampo kilaaikeak in kisutham hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Leisung suangte ii sungah sapphire suangmanpha vomte om a, Tuaciang a leivui sungah khamh kihel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Suangkhukte paina lampite a mu ngei muthi om ngawl hi, Tuaciang tuate tungah vaciik leang ngeingawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tawpi ahibuale a kiitakhuai ngamsa ngilo dangte in Tua a ngamkhing lampite tawn ngeingawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Suangkhuk naseamte in suangsak belte to a, Mualte sia mual peang dong totham hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Suangte sungsang a tawletna hawng vangte panin Amate in suangmanphate mu uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amate in ngun naakte dong to in, a kiseal nate a kilangh taakna ah paipui uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahihang ciimna koisungah kimu thei ziam? Tel thei natu in koisungah ih sin thei tu ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ciimna sia a thithei mite sungah kimu ngawl tu hi. Kuama in a manphatna tatak he ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuipi liante le tuipi peuma ii a thuknate in zongh Tua munah ciimna om ngawl hi ci uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ciimna sia ngunn le khamh taw kilei thei ngawl hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ciimna ii manphatna sia A phabel khamh le suangmanpha te taw kitee thei ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ciimna sia khamh sangin manpha zaw a, Khamh paakbung khat ahibuale maanhai pha belte sangin manpha zaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ciimna ii manphatna sia tuipi muanpaakte, suangkaangte ahibuale suangmanpha sante ii manphatna sangin mannei zaw hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Topaz suangmanpha pha belte le khamh ciitak ii man sia Ciimna ii manphatna taw kisontee thei ngawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua ahile, ciimna ii naak koisung om ziam? Koisungah tel thei natu in ih sin thei tu ziam?
  </para>
  <para style="p">
    <verse number="21" style="v" />A nungta nganhing in tuasia mu thei ngawl hi, A leang vacim khat zongh in mu thei ngawl hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thina le lalna ngawngawn zongh in mu ngawl a, ngual ii kamdawn bek za khu hi ci hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian bek in a lampi he a, Ciimna a kimuna mun he hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Banghang ziam cile ama in leimongte dong mu a, Van ii nuai ah a om na theampo mu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathian in vui ii a thahatna a piak ciang, tuipi ii phakcia tu a khensat ciang;
  </para>
  <para style="p">
    <verse number="26" style="v" />Pathian in nguazuk natu mun, Tuaciang vanto khualeng meeite lampi tu a khensat ciang;
  </para>
  <para style="p">
    <verse number="27" style="v" />Tuasia ciangin ama in ciimna mu a, a man neina sit hi — Ama lungkim in kipsak hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathian in mite mun ah, “Na ciim natu uh in, Topa thasia nanak tu nu hi. Na heak thei natu uh in siatna pial hamtang tu nu hi,” ci hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job a thuson kipan kik hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian ii hong et hong kepcing hun lai bangkeakin ka nuntakna khatvei kipan kik thei le oai meak ing.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tualai in kei taw Pathian omkhawm tawntung a, khuazing kaantan in ka va ciang khuavak hong pia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua hun lai sia ka nopsak hunlai hi a, Pathian ii hong pawlmatna in ka bangkua hum hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tualai in kei taw Vaanglianbelpa Pathian omkhawm a, kei sia ka tate theampo in hong kiim uum vaniau hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka khuipuite le ka kealpuite in noai tam mama hong pia a, ka olive kungte suang tam belna lei sungah po hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khuapi upate a kikhop simin amate sungah ka kihel ciangin,
  </para>
  <para style="p">
    <verse number="8" style="v" />khangmoite in kei hong mu po le hong pial a, tuaciang khanghaamte in zatak piakna in hong din uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipite ii lampuite zongh a pau uh tawlnga uh hi;
  </para>
  <para style="p">
    <verse number="10" style="v" />a thupibel mite zongh huthe ngawlin om uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kei hong mu theampo ahibuale kei hong za mite theampo in ka sep ka vawt sate a pha in hong son uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mizawngte a au uh ciang ka hu hi; Zot natu mun a nei ngawl tangate ka hu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngim le kham nasiabel a thuak mite in kei hong pok uh hi, tuaciang meingongte ngam muanna a nga natu in ka hu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thutang le khualna taw ka ngamta tawntung hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mittawte atu in mittangte ka hi a, peangbaite atu in peangte ka hi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mizawngte atu in pa dinmun ah ka ding a, khualmi a ngimngate sangah ka pang hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihing cizat nei ngawlte ii thahatna ka susia a, a vawtsiat mite ka suatak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khansau in nuntak tu le nuam takin inn ah thi tu ka ngaisun tawntung hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kei sia a zungte, tui a nga tawntung le a baakte daaitui a kawt thingkung khat bang ka hi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi theampo in kei hong pok tawntung a, ka thahatna kiam ngeingawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngaisutna ka piak ciang mite huthe ngawlin om a, ka son sia pha takin hong ngai hi;
  </para>
  <para style="p">
    <verse number="22" style="v" />ka man zawkciang zong bangma belap natu nei ngawl uh hi. Ka kammalte a sungah nguamalte bangin tum hi;
  </para>
  <para style="p">
    <verse number="23" style="v" />khaal kipat hun a lothote in khuapi ngua a saan thiam bangin a kuama po in ka kammalte saan thiam uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A thin uh a kiam ciang amate ka maitui a; ka maitaina in amate tha ngasak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amate ka huai ka keam a, a vaite ka hawmsak hi. Kumpi khat ii a ngalkapte a lampui bangin amate lam ka pui a, a thinngim ciangin amate ka heeneam hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahihang tu in kei sangin a khan moi zaw pasalte in kei sia ciammuina po in hong nei uh hi! A pate mannung mama ngawl tawntung ahiciang ka uite ii tuu cinna ah ka husak bua hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amate sia pasal tha tual sa honkhat hi a, kei atu na khat pawpo a seam tu in thazawm lei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amate zawng mama in a ngilkial ahikom duisung ngampa ngamtongtana munah zanin thingzung ko te khim uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amate in sennealngam ah thingno pote botin ne uh hi, limna a nei ngawl belh munphia kung ii zung ngawngawn ne uh hi!
  </para>
  <para style="p">
    <verse number="5" style="v" />Nguta khawngte ausat bang phetin a kuama po in amate ausan in notkeak uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amate sia liang maitang ah a kito vang lianghawngte sungah teang tu uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate ngamsate bangin dui sungah au in, sawlpaang nuai ah khawl om uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mannung ngawl, a son thamman ngawl, min memeal nei ngawlte veu ahi hi! Amate sia ngamsung pan kinotkeak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tu in amate hong pai in kei hong nuisan uh hi; kei sia amate atu in ciammuina bang bek ka suak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amate in kei kiihuai hong sa uh hi; amate in kei taw a kiteengat ciang pha mama kisa uh a, hong pai in ka maitang ngawngawn cil hong phii uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in a thazawm le a cimaw in kei hong vawt zo ahikom amate in a thinsona taw kei hong langpan uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hi a ngilo nuam mihonte in hong talphul a kei hong simin, hong taisak hi; amate in a khakbel hong sim natu kithoai uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate in ka suatak natu khaktan a, hong susia tu in hanciam uh hi; tuaciang amate a tho tu kuama om ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka kidalnate hong phullet a hong nawk in, ka tung pan hong sucip suk uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Launa in kei hong zo hi; ka vaang sia vui muut khat bangin bo hi; ka nopsaknate meeikaai khat bangin tai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tu in thi dektak khi hi; ka ngim thuakna sia nuamtuam tuan ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zanin ka ngu ka taang theampo na hi; kei hong nene natna sia tawp hun nei ngawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian in ka laktong ngawngliip pan hong zamh a, ka puante meakcip in mealhemsak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in buannoai sungah kei hong lawn suk a, leivui taw in ka kibang hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathian awng, hong biakpui khi hi, ahihang nong zo ngei bua hi; thu kong nget ciang nong nadon bua hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kei tungah nong ngilo mama a; na tha neiza taw nong vawtsia hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vui in nong seamkeaksak hi; vuipi suangval sungah nong lawlok hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing theampo atu in a kisee kholsa thina sungah nong puak hunlam ka he hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hesuak nget simngawl a dang bangma a vawt thei nawn ngawl, a lalsa pasal khat sia, banghangin sim nu ziam?
  </para>
  <para style="p">
    <verse number="25" style="v" />A ngim nga mite taw kap khawm ngawl a a cimaw a kitasamhte atu keima khuangai ngawl ka na khi ziam?
  </para>
  <para style="p">
    <verse number="26" style="v" />Lungdamna le khuavak ka lam en a ahizong ngimna le khuazing hong theng zaw hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thinngimna le natna in kei hong baltham a ni khat zawk ni khat ka thuak hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thinngim lungngimin nitaang mu ngawlin ka vavak a; ngualhon sungah dingin huna ka ngen hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ka aw sia ngam ui ahibuale kalaoh vacim aw bang hi a, heehuai in lungzuanhuai hi;
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka vun dup zo a, ka ci suuk ngawp hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khatvei lai in a zaaknop huai music la awte ka zaakna munah tu in khuangai in mauna le kaana aw bek ka za hi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ci le sa deina taw numei khat po ka et ngeingawl natu in a ciliap huai kamciam khat ka vawt zo hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vaanglianbelpa Pathian in ei tungah bang hong vawt ziam? Ama in mihingte nasepna bangbangin thuk kik ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in, a maan ngawl a seamte tungah tuasiatna le lalna tungsak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian in ka vawt theampo he a; ka kalsuanna theampo mu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngitlo ngamtatna nei ngeingawlin, ngualtheam tu hanciam ngeingawl khi hi ci in ka kiciam hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in a maan khaikhin tungah ka ngitna hong tee tahen, tuaciang ama in ka mawban ngawlna mu tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lam maan panin ka pial a, ahibuale siatna in ka zolsak a, ka khutte mawna taw a nin le
  </para>
  <para style="p">
    <verse number="8" style="v" />tuasia ciang ka lo ante laltham tahen a, ahibuale, ka anciinte ngualdang in ne tahen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka innpaam pa ii zi ka dei a, a kongbiang pua sangah buu in ka ngak le
  </para>
  <para style="p">
    <verse number="10" style="v" />tuasia ciang ka zi in pasal dang khat ii an huansak tahen a, pasal dang khat ii lupna ah lum tahen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuabang a ngamtatsia te thidaan nga tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuasia in ka nei theampo a kuangtumsak, a lalcipsak thei, hell mei bang khat hi tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka naseamte khat in ka tungah a lungkim ngawlna hong pualaak ciang, ngai in ama tungah a pha ka vawt hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuabang a pha vawt bua leng bangbangin Pathian maitang si ngam tu khi ziam? Kei tungah thukhen tu in Pathian hong pai ciang a bang son thei thong tu khi ziam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei hong bitphua Pathian in ka naseamte zongh bitphua hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mizawngte hu tu ka nial ngei bua hi; meingongte thinkiam in ka omsak ngei bua hi,
  </para>
  <para style="p">
    <verse number="17" style="v" />tua ahibuale neak tu ka nei laiteng tangate a ngil ka kialsak bua hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka khan tawntungin amate pha takin ka en hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zawng leih a, puansilh lei zo ngawl a kitasamh khat ka mu ciang,
  </para>
  <para style="p">
    <verse number="20" style="v" />keima ii tuu hon sung pan a piang samulte taw a kivawt puansilhte ka pia tu hi. Tuasia ciang ama in a thinsung theampo taw kei hong pok hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thukhenzum ah ka zaw thei tu he in tanga khat ka theam le,
  </para>
  <para style="p">
    <verse number="22" style="v" />tuasia ciang ka baante taltan tahen; tuate ka liangko panin kileamkeak tahen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian ii daan ka kiitak hu in tuabangin ka ngamta ngei buatu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hauna ka muang ngei bua a,
  </para>
  <para style="p">
    <verse number="25" style="v" />tua ahibuale ka neisa tungah ka kiphasak ngei bua hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A taang mama ni ahibuale, a hoi mama tha ka bia ngei bua hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka khut nam in amate zatak ka pia ngei bua a, amate upat pia tu in lam hong kipialsak ngei ngawl hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuabang mawna sia thidaan piak tu ahi hi; tuasia in Vaanglianbelpa Pathian nial hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ka ngalte ii a thuak ciang ka lungdam ngeingawl hi, tua ahibuale tuasiatna a thuak ciang dik ka sa ngei bua hi;
  </para>
  <para style="p">
    <verse number="30" style="v" />Amate thi natu thungetna taw ka maw ngei bua hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kei atu na hong sepsak mite theampo in khualmite pha takin vai ka mua tawntung hunlam hong he hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Khualhaw mite ka inn ah tung tu in ka sam a, lampi tungah ka lumsak ngei bua hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Midangte in a mawna a khialna te uh seal tu hanciam a, kei ka hile ka phualseal ngei bua hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mite ii hong ci tu sia ka kiita ngei bua hi; amate hong ci zazaan tu ka lau bua hi thim om in inn sungah ka omcip ngei bua hi,
  </para>
  <para style="p">
    <verse number="35" style="v" />Ka pau teng kuama in ngai ngawl tu ziam? Ka kammal theampo thumaan hi ci in ka kiciam hi. Vaanglianbelpa Pathian in ka kam hong zo tahen. Hong langpante ii hong mawsaknate ka mu thei natu in ki at le
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka liangko tungah kiphasak liuliau in ka suang tu a, kumpilukhu khat bangin ka lu tungah ka khu tu hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pathian tungah ka sep sa theampo ka son tu a, ama mai ah awlmaw ngawlin ka om liuliau tu hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ka thaw leitang sia ka nguk ahi a, a nei tatakte tung pan ka laksak ahile —
  </para>
  <para style="p">
    <verse number="39" style="v" />tua munah a kiciing ante ne in, tua ante a ciing lothote ka pukthisakin ahile —
  </para>
  <para style="p">
    <verse number="40" style="v" />tuasia ciang zungtaang le mangtaangte a po luangin lopa le lingkungte po tahen. Job ii thu sonte a tawpna hi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job sia ama mawbaang kisa ngawl ahikom pasal thum teng in zo kikik tu hanciam nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahihang a kungah a ding Elihu a kici pasal khat in a thin uukna vei zo nawn ngawl hi, banghang ziam cile Job in ama le ama kitangsakin, Pathian mawsiat hi. (Elihu sia Buz ii suan Barakel ii tapa hi a, Ram ii bee le phung pan hi.)
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama sia Job ii ngualtamh thumte tungah a thin uuk si hi. Amate in Job ii kam a zo natu he thei tuan ngawl hi, tuasia in Pathian sia a khial bang suaksak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Elihu ahile tualai ah a moibel ahikom ngual theampo ii thuson man dong ngak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tua pasal te thum in Job kam a zo thei ngawl a mu ciang ama thin uukin,
  </para>
  <para style="p">
    <verse number="6" style="v" />thuson tu hong kipan hi. Kei moi lai a, no haam zo nu hi, tua ahikom ka ngaisutna kong son tu ka lauthawng hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Noma na pau tu uh ma hi a, no uhaamzawte in na ciimna nong hop tu uh ma hi ci in kei le kei ka kici hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahihang mihingte kungah pai in ciimna a pia sia Vaanglianbelpa Pathian ii thaa hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khanghaamna in mihingte ciimsak ngawl a, a maan sia hesak tuan ngawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua ahikom tu in nong nangai tu uh ka dei hi; ka ngaisutna teng hong sonsak tavun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na thu son uh lai in thinsau takin kong ngai a, tuaciang ciim kammalte na zon uh laitakin kong ngak nginge hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pha takin kong ngai a, na lel uh ka he hi; Job paunate na nial thei tuan bua uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bangbangin ciimna ka mu zo uh ci thei tu nu ziam? Pathian in Job kam a zo kul tu hi, banghang ziam cile noma in Job na lel uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Job in kei hong paupui hi ngawl a, noma hong paupui hi. ahihang no ii zo bangin ka zo ngei buatu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Job awng, amate in a kammal zak tu he tuan ngawl hi; nang hong zo thei ngawl hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amate pau ngawl a om laitak ngak kenkon tu khi ziam? Amate tua munah dingin a pau tu he nawn ngawl uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hi ngawl hi, tu in keima in kong zo tu a, ka ngaisutna kong son tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pau ngawlin ka om thei nawn bua hi. Ka pau tute ka iip thei nawn bua hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pau tu hun nga buathong leng, sapittui thak a dim savun thawl bang in puaktham tu khi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thuak zo nawn ngawl khi hi; ka pau tu kul hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hi kam kinialna sungah pan tuam mun nei ngawl tu khi hi; kuama sialpok ngawl tu khi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sialpok dan zongh thiam ngawl khi hi, ngual ka sialpok le Pathian in manlang takin kei daan hong pia tu hi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng, tu in ka son tu theampo pha takin hong ngai ta'n.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka thin sungah a om teng son tu in kinging khi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka kammalte theampo ka ci takpi ma hi a, thumaan thutak ka son hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian ii thaa in kei hong vawt a, nuntakna hong pia hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nong zo thei le hong zo ta'n. Nong nial natu kinging khol in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang le kei sia Pathian ii muna ah ih kibang a, ih nii in tungman pan hong kivawt hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua ahikom kei nong kiitak natu bangma thu om ngawl hi; Nang hong neethaw ngawl tu khi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tu in hi teng sia na pau vangiat ka zaak ahi hi:
  </para>
  <para style="p">
    <verse number="9" style="v" />“Kei maw ngawl khi hi; a maan ngawl vawt ngawl khi hi. Kei sia mawbanna nei ngawlin mawna khialna pan peng khi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihang Pathian in kei hong sim nop hu in paulap tu thu mu a, ngalte khat bangin hong vawt hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama in ka peang thikkol bulh a, ka tukna ka dianna theampo hong encik hi,” ci ni hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Job awng, ahihang hong son khi hi, nangma khial ni hi. Mihing khat pawpo sangin Pathian lianzaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Banghangin eite ii lungkim ngawlnate hong zo ngeingawl hi ci in Pathian mawsiat ni ziam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian in thuson kik a, son kikik ahihang ama paunate kuama in nangai ngawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zan lai mihingte mut lanin Pathian in mang le mukholsakna te taw hong paupui hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in ama ii paunate amate in ngaisak hi, tuaciang kidop natu a son kholnate in amate lausak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian in amate tungah mawna khialna a vawt nawn ngawl natu le a kiphatsak nawn ngawl natu in pau hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in amate lalsak ngawl tu hi; ama in thina mama panin amate hun hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian in mihingte, natna thuaksakna le a pumpi tung natna dimsakna taw in hil hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ciina khat in a ankam lim ngawl a, an limbel zongh sungnim huai sa hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ci a sa theampo kiam a; a ngu nguak bek a om na mu thei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama mithi khua zuan tu in kipapan hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mite ii a nasep a phawksak kik, vantunglalang khat — Pathian ii vantunglalang a tul sim sung pan khat, amate hu tu in hong pai thei tha tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A hesuakna taw vantunglalang in, “Ama suatak in! Ama mithi khua ah a pai tu hi ngawl hi. Ama a suatak natu in hi lai ah a kitatna om hi,” ci tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A pumpi moi sua kikin thahat kik tu hi; thu a nget ciang Pathian in zo tu hi;
  </para>
  <para style="p">
    <verse number="26" style="v" />ama in lungdamna taw Pathian bia tu hi. Pathian in ama atu in na tuatuamte a maan in lemh kik tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in mihonte tungah, “Maw zo khi hi. A maan bang seam ngawl ka hihang, Pathian in hong khoaikhe hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mithi khua ah ka pai ngawl natu in ama in hong keamcing a, ka nungta lai hi” ci tu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathian in hite theampo seam kikik hi,
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama in mihing khat ii nuntakna hun a, tuaciang nuntak sung lungnopna pia hi;
  </para>
  <para style="p">
    <verse number="31" style="v" />Tu in Job awng, ka son tu sia hong ngai ta'n; thim khipkhep in a, kei hong pausak ta'n.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahihang son nop khat po na nei le tuasia za nuam khi hi; lungdam takin maan hi ci ngam tu khi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahihang tuabangin na son buale, thim om in hong ngai ta'n, na ciim natu zia hong hilcian tu khi hi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />No pasalte ciim mama a, pil mama nu hi; tu in ka son sia hong ngai tavun.
  </para>
  <para style="p">
    <verse number="3" style="v" />An na tep uh ciang a lim sia he nu hi, ahizong ciim kammalte na zaak uh ciang he ngawl nu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hi sia eima ii khensat tu bek hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Job in mawbanna nei bong, Pathian in kei, thumaan hong danh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in dongh a, “Banghangin leilot in khial khi hi ci thei tu khi ziam? Kei sia thithei natu za in liam khi hi, ahihang mawna nei ngawl khi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hi pasal pa Job bang mi khat pawpo na mu ngei uh ziam? ama in Pathian zatakna lak ngeingawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama in misiate taw kithawl le mi mawte taw vaa kot nuamsa hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama in Pathian ii deina zui tu in hanciam sia a phatna om ngei peuma bo ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />No a tel thei pasalte awng, hong ngai tavun! Vaanglianbelpa Pathian in a maan ngawl naseam tu ziam?
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama in mite a sepna bangin tel pia a, amate tungah a kiphu a kilawm bangin vawt hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaanglianbelpa Pathian in siatna vawt ngawl hi; ama in kuama tungah thumaan ngawlin seam ngeingawl hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian in a vaangletna ngualdang khat tung pan nga ziam? Ama leitung uk tu in khat po in koi ziam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian in nuntakna husan sia la kik le,
  </para>
  <para style="p">
    <verse number="15" style="v" />tuasia ciang a nungta theampo thi tu a leivui suak kik tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na ciim uh le tu in kei thuson hong ngai tavun.
  </para>
  <para style="p">
    <verse number="17" style="v" />A thutang Pathian ningkhiin nu ziam? Ama in thumaan thu ngaimaw sa nu ziam?
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian in kumpite le ngamukte sia a nginat ngawl ciang ahibuale a seksol ciangin ningkhiin hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in ngamukte sangah pang ngawl hi, mizawngte puavawk a, a haute maipha pia tuan ngawl hi, banghang ziam cile mi theampo ama ii bitphua sa vive hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing khat sia zanin thakhat thu in thithei hi. Pathian in mihingte vaatvawkin amate bo hi; a thahatte zongh ol takin ama in thatlum hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama in ih kalsuanna theampo encik hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mimaw khat Pathian muna pan a seal zo tu khuazing om ngawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Eite pai in ama ii thukhenna ih thuak tu hun Pathian in ciangtan kul sa ngawl hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama in lampuite heam in ngualdang taw a laih natu in, thu katna, thusitna khat kul sa ngawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Banghang ziam cile ama in amate sep sia he hi, ama in zanin amate lawnthal a sucip hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama in mi theampo ii mu theina munah mi mawte daan pia hi,
  </para>
  <para style="p">
    <verse number="27" style="v" />banghang ziam cile amate in ama nung zui nawn ngawlin a thupiakte theampo thusim ngawl uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amate in mizawngte sia zawthawk thu taw ausak in Pathian kosak hi, tuaciang Pathian in hu ngenin a au nate za hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathian in bangma vawt ngawl tu in a khensat hial le zong kuama in ama mawsak thei ngawl hi. Ama in a mai seal le eite ih cimaw tu hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi a neng niam Pathian selte ii amate a uk ngawl natu in minamte ii vawt thei bangma om ngawl hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Job awng, na mawnate Pathian tungah pualaak zo ni ziam, tuaciang na maw kik ngawl natu in kamciam pia zo ni ziam?
  </para>
  <para style="p">
    <verse number="32" style="v" />Na khialnate hong lak natu in Pathian tungah ngen zo ni ziam? siatna vawt a kheal tu in na thukim zo ziam?
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathian sepna sia na nial nungsang na dei bang hong vawtsak tu muangmaw thei lai ni ziam? Nangma ii khensat tu hi a, kei khensat tu hi ngawl hi; tu in na ngaisutna ko hong son ta'n.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mihing khuangaisun thei khat pawpo in thukim tatak tu hi; tuaciang ka pauna hong za miciim khat in
  </para>
  <para style="p">
    <verse number="35" style="v" />Job sia tel ngawl vai taw papau a, a pauna po khiakna nei vaset zongh om ngawl hi, ci tu hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Job ii pauna theampo ngaisun vun; ama misia khat bangin a pau hunlam na mu tu uh hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pathian a leedona taw a mawna a khialna belap hi; eite theampo ii mai ah ama in Pathian nunau hi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng, Pathian muna ah maw ka baang bua hi na ci tu sia maan ngawl hi,
  </para>
  <para style="p">
    <verse number="3" style="v" />tua ahibuale Pathian tungah, “Ka mawna in nang bang hong tatsak ziam? Ka maw ngawl ciang bang phattuamna nga khi ziam?” ci a na dok tu kilawm ngawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma le na lawmte kam zongh kong zo tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Van ento in! meeikaaite bangza in saang ziam!
  </para>
  <para style="p">
    <verse number="6" style="v" />Na maw le tua in Pathian sia bangma tatsak ngawl hi. A maan ngawl tamvei na vawtna in ama bang a tatsak tu ziam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Thutang mama na hina taw in Pathian na hu ziam? Pathian in nang tung pan kitaangsap nei ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na maw na khial hu in a thuak sia na mipuite hi a, phatna na vawtna in amate hu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihingte a kinenniam ciang tau a; a hun tu in amate in khat po ko uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihang in amate in a haksatbel hun sungin lametna a pia amate a bitphuapa Pathian kung zuan ngawl uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amate in eite hong ciim sak, nganhing ahibuale vacim khat pawpo sangin a ciim zaw in hong vawt Pathian kung zuan ngawl uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amate hu ngenin au ahihang Pathian in zo ngawl hi, banghang ziam cile amate a kiphasak misiate ahi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate ii aukeakna zongh a lui thawthong hi; Vaanglianbelpa Pathian in amate mu ngawlin za ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Job awng, Pathian mu thei bong ci ni hi; ahihang thinsau takin ngak in — na vai sia ama mai ah om nginge hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian in daan pia ngawl a, mawna zongh thusim ngawl hi, ci in ngaisun ni hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na papau hang phattuamna om ngawl hi; na thuson teng mama a tel ngawl na hi sia kilangh hi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na thin sausak in a, Pathian taangin ka paunate tawmvei hong ngai lai ta'n.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka heakna zai hi; kei hong bitphuapa Pathian sia thutang a hina a lak tu in ka heak teng ka zangh tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang tungah kong sawl khial bua hi; na mai ah a ciim takpi mi khat na mu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian bangza in hat ziam! Ama in kuama nomu ngawl hi; Ama ii a tel ngawl bangma om ngawl hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in mawneite nungtasak tan ngawl a, mizawngte tungah a khaikimin vawt tawntung hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama in thutangte sungsia hi; kumpite bangin amate in uksak a, a tawntungin kipatoaisak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahihang mite sia a sep a vawt hu in thikkol bul a thuak le,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in amate kiphatsakna le a mawnate a lak ahi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Siatna pan a kikheal natu, a kidop natu in a sonkholte amate in ngaisak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amate in Pathian thu ni in ama atu na a seam uh le a khan tawntung thinnuam in nuamsa tu uh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuabang in a ngamta bua uh le, amate sia a tel ngawl ma in thi tu a, tuaciang lui kaantan in mithi khua zuan tu uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian selte sia thin uuk tawntung hi, daan a kipiak ciang zongin, huna a nga natu in thungen ngawl uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amate khanthi uh hi, a nuntakna uh maizumna taw bo hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahihang Pathian in mihingte ngim thuakna tungtawnin hil a, thinngimna sia a mit kihon natu in zangh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in nang ngimna sung pan hong la khia a, tuaciang ngammuangin hong lungnuamsak a, na sabuai tungah anlim nawno hong kilui veuvo hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahihang tu in nang, na kilawm bangin daan hong kipia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sumnguk neaknate ii na theamsak ngawl natu ahibuale haunate ii lam hong pialsak ngawl natu in kidawm in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hu ngen a auna in bangma a pha hong sua ngawl tu hi; na thatang theampo in tu in nang hong hu thei ngawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Minamte lalcip natu hun, tua zan hong thet tu ngakla heak in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Siatna sangah na kihei ngawl natu in kidawm in; tuasia pan na kikep natu in ngim thuakna hong kipuak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian ii vaangletna sia bangza in lian ci sia ciamtee in; Ama sia sya theampo sung pan a lianbel hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuama in Pathian munah bang seam tu ci in sawl thei ngawl hi, ahibuale siatna vawt hi ci in kuama in mawsak thei ngawl hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A nasep tungtaang ah ama kipok tawntung hi; nang zongh ama na pok kul tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A kuama po in ama sepsate mu uh hi; ahihang eite in ih ngal et thei bek hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama ii letna a cingin ih he thei bua hi; ahibuale ama kumte ih sim thei bua hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lei pan tui la in nguamalte a suaksak sia Pathian hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama in meeikaaite panin mihing nam theampo atu nguazusak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Meeikaaite koi bangin kikhiin a, ahibuale Pathian teenna van lenglet in bangbangin vanto ziam ci sia kuama in he ngawl hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama in van theampo lenglet in khualengsak a, ahihang tuipi thuknate zing veve hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hisia in ama ii mite a vaak zia le an tam mama a nguan zia ahi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ama in khualeng sia a khut taw zamh a tuaciang a tuunna mun santak khasak hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Vanto in vuipi nguapi hong pai tu taangko a, ngannote in hong pai hi ci in he uh hi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vuipi suangval in nasia takin ka thin hong patausak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Note theampo awng, Pathian ii aw, a kam sung pan hong pai vanto awnging ngai vun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in khualeng sia vanpi kaantan in leimong khat pan mong khat dongah puak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tua zawkciang a vaanglian vanto awnging ahi ama hawkna aw kiza a, tua hun sung teng khualeng tee vazal hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian thupiakna taw nalamdangte, ih tel zawk ngawl a tumdang nate piang hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in vuuk, lei ah a kia tu in thu pia a, nguatui tam mama zusak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama in eite nasep hong tawlngasak a; ama vawt theite eite hong lak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngamsate in amate ii kua tek zuan uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Suangval vui sia thangsang pan hong va a, hong vut vaval khuasik sia saksang pan hong pai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian ii husan in tuite khalsak a, vuukkhal suaksak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khualeng sia meeikaai sung pan taang vazai hi,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian ii deina bang in tuate kikhiin uh hi. Simleitung mun theampo ah tuate in Pathian thupiak theampo seam uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian in lei kawtsak tu in nguatui puak hi; mihingte daan a pia tu ahibuale a deisakna lak tu in ama in nguazusak thei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Job awng, tawmvei tawlnga in ngai in; Pathian ii a lamdang a nasepte ngaisun in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian in thupia in meei sung pan khualeng a piansak zia na he ziam?
  </para>
  <para style="p">
    <verse number="16" style="v" />Koi bangin meeite van ah kikhaangin, Pathian ii a lamdang a nasep thiamna na he ziam?
  </para>
  <para style="p">
    <verse number="17" style="v" />He ngawl ni hi, thangsang vui hong va in ngamsung a nawk ciang sa saa in ngim thuak bek ni hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian in van zalh in tua sia thik taat sa bang, a sak in a vawt lai, nang hu thei ni ziam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian tungah ka son tu uhte hong hil ta'n; kote thinsung ah bangma om ngawl hi; son tu bangma nei ngawl khu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathian taw kipaupui tu ngen ngawl tu khi hi; banghangin kei hong lalsak natu hunpha pia tu khi ziam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Tu in van a khuavak tee vanai hi; tuasia ih et tu in taang leih hi, tuaciang van sia vui in muut thiang zo hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A taang khamh ci khat saksang ah kimu hi, tuaciang Pathian ii vaangletna in zatakna taw kidim a hong lausak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian ii vaangletna lian mama ahikom ama ih neak thei bua hi; eite taw ih kizopna ah ama thutang thumaan hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua hi a, mihing theampo in ama a zatak, a kiitak uh sia lamdang ngawl hi, tuaciang ama in a kiciimsakte a awlmawk ngawl sia zongh lamdang ngawl hi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua zawkciang vuipi suangval sung pan Topa in Job paupui hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na heak ngawlna le khiakna om ngawl na kammalte taw kei ciimna nong dok sia nang akua ni ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Tu in ding tang in a, kong thudokte hong zo ta'n.
  </para>
  <para style="p">
    <verse number="4" style="v" />Simlei ka vawt lai in nang na om ziam? He mama na kisa le tua thu kei hong son ta'n.
  </para>
  <para style="p">
    <verse number="5" style="v" />Leitung letna bangcia pha tu cisia akua in khensat ziam? Akua in a tungah pikhau kai in tee ziam? Hite theampo hong zo thei tu ni ziam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Leitung anang khuamte, bang in len ziam? Simlei ii a king suangpi sia akua in khia ziam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Tua ni vaktuung in aksite lasa khawmin, vantung mite lungdam in au uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lei sung pan tuipi a puathap lai in tua tuipi khaktan tu in akua in kongpite khak ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />meeikaai taw tuipi a tuam le tuasia khuazing taw a tuam pa sia keima khi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuipi atu in ngamngi khat ka vawt a, a kongpi kikalhte nungah ka keam hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keima in tuasia ii munah, “Hi ciang bek pai in, pai leet heak in! Hi sungah a thahat, na tuihualte a tawlngak kul tu hi” ka ci hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Job awng, na khan sung theampo ah ni khat beak khua a vak tu in thu na pia ngei ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Leitang a zamh tu le a pummat tu, mi ngilote a bukna pan a thingkeak tu in khuavak tungah thu na pia ziam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Puan kithepte le tungman tungah tazeik khet sia a kilangh bangin sun nitaang in mualte le ngamkuamte kilanghsak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sun khuavak sia mi ngilote atu taang leih a, amate ii ngongtat natu te khak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuipi thuknate sung cikte ah na om ngei ziam? Tuipi liante ii tawdap lei ah na vak ngei ziam?
  </para>
  <para style="p">
    <verse number="17" style="v" />Khuazing na mithi khua a cing kongpite hong lak khat po a om ngei ziam?
  </para>
  <para style="p">
    <verse number="18" style="v" />Simlei bangza in lian cisia ngaisutna khat pawpo na nei ziam? na he le hong zo ta'n.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khuavak koisung pan hong pai a, khuazing ii a kipatna naak sia bang ziam ci in na he ziam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuate tungah bang tan khuala pai tu cisia na lak thei ziam? ahibuale tuate na heak kiksak thei tu ziam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuabang hi thei tu in kong um takpi hi, nang na khan haam mama zo a, leitung a kivawt lai in om zo na hi hang hi!
  </para>
  <para style="p">
    <verse number="22" style="v" />Vuuk le ngial ka kholna mun ah na haw ngei ziam?
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuate ngim nga hun le ngal kido hunte atu in ka kinginna hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni a suatona mun ah, ahibuale nisuana vui hong vakna munah na om ngei ziam?
  </para>
  <para style="p">
    <verse number="25" style="v" />A kua in nguatui hong luan natu in luam to a, akua in vanto keakkiat natu in lam sialsak ziam?
  </para>
  <para style="p">
    <verse number="26" style="v" />A kua in kuama ten ngawlna munah nguazusak ziam?
  </para>
  <para style="p">
    <verse number="27" style="v" />A kua in lopa meen natu in leiko, lei dangtaakte tuibuak ziam?
  </para>
  <para style="p">
    <verse number="28" style="v" />Nguatui ahibuale daaitui in pa a nei ziam?
  </para>
  <para style="p">
    <verse number="29" style="v" />Vuuk le thuamluak ii nu akua ziam?
  </para>
  <para style="p">
    <verse number="30" style="v" />Tui sia suang a suaksak le tuipi maitang a khalsak sia akua ziam?
  </para>
  <para style="p">
    <verse number="31" style="v" />Pleiades aksite na sawm khawm thei ziam? ahibuale Orion aksi a sawm khawm khaute na suut thei tu ziam?
  </para>
  <para style="p">
    <verse number="32" style="v" />Aksite hun khat zawk hun khat lam na pui thei ziam? Tuaciang Bear aksi lian le Bear aksi no tungah lam na lak thei ziam?
  </para>
  <para style="p">
    <verse number="33" style="v" />Vante a uk upadi te na he ziam, tuaciang tuate leitung ah na zanghsak thei tu ziam?
  </para>
  <para style="p">
    <verse number="34" style="v" />Meeikaaite tungah au in nang tui hong tuamsak nguatui a suak tu in thu na pia thei tu ziam?
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuaciang khualeng a taang vazak tu in thupia lete tuasia nang kungah hong pai in, “Nong sawl babang hong sepsak tong” hong ci tu ziam?
  </para>
  <para style="p">
    <verse number="36" style="v" />Nile ngun bang hun ciang pawm tu ci sia akua in vakaangte hil ziam? ahibuale nguazuk tu hunlam akua in aklui hil ziam?
  </para>
  <para style="p">
    <verse number="37" style="v" />Leivuite leitangh a suaksak ngua a zuk natu in meeite simin a lumlet thei ciimna kicing sia akua in nei ziam?
  </para>
  <para style="p">
    <verse number="39" style="v" />Tawpite a leihawngte sungah a buk ciang a neak tu an na zonsak ziam,
  </para>
  <para style="p">
    <verse number="40" style="v" />tuaciang a ngilkial tawpi note an ngakin a kuate sungah a lup laitak, a lung na kimsak ziam?
  </para>
  <para style="p">
    <verse number="41" style="v" />Va-ak ngilkialte a len kawkoai ciang, a note andu in kei hong ko in a au ciang an a vaak sia akua ziam?
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sathakte bang hunin suak cisia na he ziam? Sangaite a no sua tu ngakin na en ngei ziam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuate in a no bang tanvei paai ci sia na he ziam? Tuate sua hun tu na he ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />A no suak tu in lei ah a baw suk tu hun le a note leitung ngam sungah a tatpui tu hun na he ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />A note duisung ah khangin a thahat uh hi; amate paikhia in heak kik nawn ngawl uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngam laate akua in suatakna pia ziam? Akua in thazau in, vakzausak ziam?
  </para>
  <para style="p">
    <verse number="6" style="v" />A inn tu in senneal ngam ka pia a tuate ci al zaangtam ah ka teangsak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuate awsana khuapite taw a kikhualana ah om uh a, kuama in zualin naseamsak thei ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mualte sia tuate ii kivaak natu a tatna mun hi a, tua munah a neak tu in lohing pawpo zong uh hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngam khuital khat in nang na hong sepsak tu ziam? Na nganbuk sungah zan a ngiak nuam tu ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuate khat khaukhii in lo na thosak thei tu ziam? Ahibuale na lo sungah lei kalthapna thik ha na kaisak thei tu ziam?
  </para>
  <para style="p">
    <verse number="11" style="v" />A thahatna lian, na suang thei tu ziam, nang ii nasep lian a seam tu in na muangmaw ngam tu ziam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Na anlaakte hong puaksak tu le na taang cilna phual panin antangte hong kaikhopsak tu in na muangmaw ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Kalaoh vacim khat ii thaphil sia bangza in manlang ziam! Ahihang kalaoh vacim sia hilniang vacimlian khat bangin leang thei ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kalaoh vacim puite in a tuuite lei sa ii a lumsak tu in lei ah nusia hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A tuuite sia peang khat po in siiktham thei ahibuale ngamsa khat po in tamhsak thei tu cisia phawk ngawl hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua a tuuite ama tuui hi ngawl bang phetin ngamta in, a thasaan nate a lui thawthong a sua tu sia zongh thinbot ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A mawmaw sak, ciimna a pia ngawl sia keima khi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahihang ama a tai ciang siphu khat le a tung to khat pawpo sia nuisan bek hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Job awng, siphute thahatsak in, a ngawng mul kaai niingniangte a pia sia nangma na hi ziam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Khaumaw bangin amate na kipeaksak ziam? tuaciang a naak thinna taw mihingte na lausak ziam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuate in ngamkuam sungah lawp takin lei khuat hi; a tha nei za taw ngal kisimna phual del uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuate in launa a cisia he ngawl uh hi, tuaciang namsau in heak kiksak thei ngawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A tung a tote ii ngalhiam kente, nging lialua in nisa sungah tee vazial hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Siphute patauna taw a ci liingin mai ah tai uh hi; lemle kitum ciangin ding thong thei ngawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lemle kitum simin a naak uh thing hi; ngal kisimna mun nai a thet ma in ngal ngimnam za thei a, tuaciang tuate in ngalkapbute ii au in a thupiakte za uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Muthi khat in thangsang zuan tu in a tha a phalh ciang, a len thei natu sia nang tung pan hong sin ziam?
  </para>
  <para style="p">
    <verse number="27" style="v" />Muvanlai khat in mualsaang dawnte ah bu a tom nop ciang nangma thupiak tu hong ngak ziam?
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuasia in a saangbel suangpite tungah a bu vawt a, tuaciang suanghiamte a kulh in mang hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tua mun panin ama in a nai, a khuala ah bang khat po that in a neak tu a om ziam ci in encik hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sathite kiimkot ah muvanlaite kikhawm a, muvanlai note in a chi dawn uh hi.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job awng, nang in Vaanglianbelpa Pathian thato ni hi; tu in tawlnga tu ni ziam ahibuale a kam zo tu ni ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Topa awng, a mawmawthuai kam pau khi hi. Bang kong zo thei tu ziam? Bangma dang ka son nawn buatu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka pau tu za sangin tamzaw pau zo khi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuasia ciang vuipi suangval sung panin Topa in Job khatvei paupui kik hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu in dingtang in a, kong dok thute hong zo ta'n.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei thutang ngawl hi hong ci nuam in hanciam a — kei a khial hong tangsak a nang le nang kimaansak nuam ni ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang keima bangin hat ni ziam? Na aw keima vanto aw bangin na ngingsak thei ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuabang ahile na vaang neina le na kisuantaak na taw ding in; nang le nang vaangletna le minthanna puan silh in.
  </para>
  <para style="p">
    <verse number="11" style="v" />A kiphasakte en in; na thin uukna lak in a, amate kiniamkhiaksak in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hi hi, amate en in a, khiasuk in; mi ngilote a dinna munah sucip in.
  </para>
  <para style="p">
    <verse number="13" style="v" />A vekpi in lei sungah phum in; mithi khua ah heencip in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuasia ciang nang hong pok masa phit tu sia keima hi tu khi hi, nangma ma in zawna nga hi, kong ci tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Behemoth nganhing pui sia en in; ama ka bitphua a, tuaciang nangma kong bitphua hi. Ama in khuipui khat bangin lopa ne hi,
  </para>
  <para style="p">
    <verse number="16" style="v" />ahizong a pumpi sungah bang thahatna om a, a sangol sungah bang vaangletna om ziam!
  </para>
  <para style="p">
    <verse number="17" style="v" />A mei sia cedar thingkung bangin dingto a, a peang thangolte hat hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ngute taau bangin khoh a, a peangte thikpum bang ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nganhing nungta theampo sung pan a lamdangbel ma hi! Ama a Bitphuapa bek in ama zo thei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngamsate kimaina mualte tungah ama ii kivaak natu lopa po hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lingkungte nuai ah ama lumin, nawng sung pumpate kawm ah buu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama sia luihui a po lingkungte le pakngiamte in a lim bealhsak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama in nguntui luang vahawn sia kiita ngawl hi; ama Jordan nguntui in a maitang a the ciang om hiithiat lel hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Akua in a mittawsakin man thei tu ziam? Ahibuale akua in thaang sungah a naak awksak thei tu ziam?
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leviathan awle sia ngasa tangthaakna taw na man thei tu ziam? ahibuale khau taw a leei na khii thei tu ziam?
  </para>
  <para style="p">
    <verse number="2" style="v" />A naakphe khau thun thei tu ni ziam? ahibuale a khangute pailet in thikkoai bul thei tu ni ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in hong thaa ta'n ci in hong ngen tu ziam? Nang tungah hesuak hong ngen tu ziam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama in nangma taw thukimna vawtin a tawntungin na na a seam tu in hong kamciam tu ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Na naseam numeite nuizak natu khat in vacim khat khoai bangin ama khau na khi tu ziam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngasa paaite in a man a tuuk tu ziam? Sumzuakte in a zuak tu in a sa sem tu ziam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngasa matna teite taw a vun tung dimin ahibuale ngasa khawna teite taw a lu na hol let thei tu ziam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Khatvei ama tham lete bangma hun na tham kik nuam nawn buatu hi; na kidona na mangil ngei buatu hi!
  </para>
  <para style="p">
    <verse number="9" style="v" />Leviathan awle a mu pawpo lau in lei ah puk hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama a thin uuk ciang kiitakhuai mama hi; a mai ah kuama ding ngam ngawl tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama ngalvawt a simin, bangma a tat thei ngawl akua om tu ziam? Tuabang ahithei tu leitung theampo ah kuama om ngawl tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leviathan awle ii peangte thu le ama ii letna le hatna thu na tungah hong sonsak ta'n.
  </para>
  <para style="p">
    <verse number="13" style="v" />A puanpuasilh sia kuama in leamkeak zo ngawl hi, ahibuale a ngaldalna a silh sia kuama in sunlet thei ngawl hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kiitakhuai hate a po iim-iam ama ii kha ngu sia akua in bal thei tu ziam?
  </para>
  <para style="p">
    <verse number="15" style="v" />A cingzaang teng ah a hawlipte a ngui in kithuap cinten a, suang bangin sak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua a hawlipte khat le khat ngat takin kimatcip bikbek a, a kawm pan vui zong tum zo ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuate theampo kho takin kimatcip ahikom bangma in khentham thei ngeingawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama a naak thing in hetchia a law ciang khualeng vazal a, a mittangte ni suaktuung bangin tee hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kam sung pan meikuang leng a, mei eak leang vazai hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Beal khat nuai pan lopa kaangh khu suak bangin a naak sung pan meikhu pusuak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A husan in mei piangsak a; a kam sung pan meikuang lengto hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A ngawng thahat mama ahikom ama taw a kisi peuma lau vadil hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama ii vun tungah a nip mun om ngawl a; a kiseak zo ngawl thik bangin a vun sak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A suang lungtang in kiitak nei ngawl a, a tam thei ngawl an ngoaina suang khat bangin sak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama a thawto ciang a hat belte zongh in kiita a; lau in cimaw uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama a liamsua thei namsau om ngawl hi; ama a nasak thei tei ahibuale thaltang ahibuale teipalh om ngawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama atu in thik sia taangphaw ko bangin ngeam a, taau sia thingmuat bangin nip hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama a taisak thei thaltang om ngawl hi; ama a kidenna suangte taangphaw bekte taw kibang hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ama atu in khetbuk khat sia taangphaw bek khat bang bek hi a, pasalte ii tei taw a khaw uh ciang ama nui hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A ngilvun taalte leibeal tamhbek kiilte bang hi a; tuate in taangcilna leang khat bangin lei buanna sautham hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama in tuipi sia tuiso bangin kiloksak a, tuaciang sathau beal khat bangin phuansak hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ama paina sa lampi sia taang a, tuaciang tuipi tui sia a kaang phuan suaksak hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Leitung ah ama taw a teengat tu bangma om ngawl hi; ama sia kiitak a nei ngawl nganhing khat ahi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nganhing kiphasak belte ngawngawn ama in nomu hi; ama sia ngamsa theampo ii kumpi ahi hi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tua zawkciang Job in Topa kam zo hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Topa awng, vaangletna theampo na nei hi; na vawt nop theampo na vawt theina thu ka he hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bangma tel ngawl pi in na ciimna kong dok ngamna thu taw kisai in nong dongh hi. Keima in ka tel ngawl thute, kei heak tu in lamdangin a nasia leih thute a son ka hi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na pau laitakin kong ngai tu le nong doknate kong zo tu hanciam in nong sawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hun bosa sungah ngual ii hong son teng bekma ka he hi, ahihang tu in ka mittangte taw ma in nang kong mu zo hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua ahikom ka pau sa theampo tungtaang ka maizum a, kisik kik in leivui sung le vut sungah ka om hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Topa in Job a paupuina teng a man zawkciang ama in Eliphaz tungah, “Nangma le na lawmte nii tungah ka thin uuk hi, banghang ziam cile, kei huvau ka naseampa Job ii son bangin note in thumaan thutak na son bua uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tu in khuital sali le tuutal sali Job kungah paipui vun a, noma atu in sangaw biakpiakna in tuate pia vun. Job in no atu thu hong ngetsak tu hi, tuaciang ama ii thungetna ka zo tu a, na kilawm uh bangin kong maimawlsak buatu hi. Ama ii son bangin kei huvau thumaan na son bua uh hi,” ci hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eliphaz, Bildad le Zophar te in Topa ii amate sep tu a sawl bangin a sep uh ciang Topa in Job thungetna zo hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuaciang Job in ama ii a lawmte thum atu thu a ngetsak zawkciang Topa in Job sia nuamsasak kik a, nidangin a nei ngeiza ii a zaa nii pia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Job ii a suapui pate, a suapuinumeite le, a ngualtamh luite theampo ama inn ah hawin ama taw anneakpoai vawt uh hi. Amate in Topa ii ama tung a tunsak ngimnate theampo hu in khuangai pui in heeneam uh hi. Amate khat simin sum pawlkhat le khamh khutzungbu khat tek ama pia uh hi
  </para>
  <para style="p">
    <verse number="12" style="v" />Topa in Job sia a khaksang a nuntak sungin a masa a nuntakna sangin thupha tamzaw lai pia hi. Job in tuu 14000, kalaoh 6000, khui 2000, le la 1000 nei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama sia tapa salite le tanu thumte ii pa suak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama in a tanu lianbel sia Jemimah, a niina sia Keziah, tuaciang a nobel sia Keren Hapuch ci in min phuak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Leitung bup ah Job ii tanute bangin a mealpha numei dang om ngawl hi. A pa in a suapui pate a piak bangma in a tanute ngamh khensak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Job in hisia zawkciang a tute le a tu selawnte a mu tu dongin kum 140 khansau in nungta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuaciang ama kum haam tatakin thi hi.
  </para>
</usx>
