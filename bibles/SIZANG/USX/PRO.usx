<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Paunak</book>
  <para style="h">Paunak</para>
  <para style="toc1">Paunak</para>
  <para style="toc2">Paunak</para>
  <para style="mt">Paunak</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel kumpipa David tapa Solomon ii paunakte ahi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hisung a paunakte in ciimna le ngaisutpha khentel natu le a khiakna thuk kamtepteete tel natu in hong hu tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuate in pilvangna taw bangbangin nungta tu, bangbangin thumaan tu a, thutang tu, thukhual tu ci in nang hong hil thei tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuate in heakna a nei ngawl lai khat pilsak thei tu a, tuaciang in khangnote kicinna a nei thei natu dan hil hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hi paunakte in a ciimte ii heakna ngawngawn belap thei a, pilna saang a neite lamlak hi,
  </para>
  <para style="p">
    <verse number="6" style="v" />tuasia ciangin amate in paunakte ii a kiseal khiaknate he thei tu a, mihing ciimte dok thu telhakte zongh tel thei tu uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Heakna na nei natu in Topa thasiana na nei phot kul hi. Mihing mawmawte in ciimna awlmawk ngawlin kan nuam ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na pa le na nu hong sonte pha takin nadon in, ka tapa awng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amate hong hilnate in a et hoi dial khat, khi khat ii na meal hong hoi tuamsak bangin na pianzia hong etlawmsak tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka tapa awng, mimawte hong ze et ciangin zui heak in.
  </para>
  <para style="p">
    <verse number="11" style="v" />A zezen in, amate in “Hong pai ta'n; ih thalup tu khat zong ka tawng! Mawna nei ngawl khat cimthoina in ngalvawt sin ve tawng!
  </para>
  <para style="p">
    <verse number="12" style="v" />Amate ih mu tangin nungta a, ciidam hikale amate tungah ih law nop teng ih man zawkciang thi siat tu hi!
  </para>
  <para style="p">
    <verse number="13" style="v" />Hauna namcin le ih innte sia ih sutol vanhte taw a kidim in ih mu tu hi!
  </para>
  <para style="p">
    <verse number="14" style="v" />Hong pai ta'n a hong pawm ta'n, ih nguk theampo ih hawm tek tu hi,” hong ci tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tapa awng, mihing tuabangte taw kithawl heak in. Amate kung pan kiheam in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amate in a sia khat a vawt tu ngakla hi. Amate in thatlum tu in kinging tawntung hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na mat nop vacim sia ii mu tangin thaang nasia hang, bangma phatuam ngawl hi,
  </para>
  <para style="p">
    <verse number="18" style="v" />ahihang mihing tuabangte in amate le amate thaang kisia uh a, tua thaang sungah amate thi tu uh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihing suamna in a suamte nuntakna siik kik vaciat hi, ngoltolna taw a nungta khat pawpo tungah tuabang ma in tung hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai in! Ciimna in khuapi lampi liante sung le vanhzuakna phual ah hong sam hi,
  </para>
  <para style="p">
    <verse number="21" style="v" />khuapi kongpite le mihingte kisiktuana munte ah a nging tatakin hong sam hi:
  </para>
  <para style="p">
    <verse number="22" style="v" />“Mihing mawmawte awng! bang tanvei mawmaw nuam nu ziam? Heakna bang tanvei ciammui vawt tu nu ziam? Heak tu sawm nawn ngawl nu ziam?
  </para>
  <para style="p">
    <verse number="23" style="v" />Kong teih ciangin hong ngai tavun; ngaisutna pha kong pia tu a, ka heaknate kong hawm tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hong sasam khi hi, hong pai tavun ci in hong thaw khi hi, ahihang hong ngai nuam ngawl nu hi. Kei sia hong nadon nuam ngawl nu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngaisutna kong piak theampo thusim ngawl nu hi, kong hil kong pau tu zongh nong oai ngei bua uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua ahikom ngim na nga ciang, kong nuisan tu hi. Launa lian tatakin nang hong nawk a,
  </para>
  <para style="p">
    <verse number="27" style="v" />na tungah vuipi suangval bangin hong va a, ngimna vuipi hong puak hi, nang sia natna le cimawkna taw na om hun ciangin kong nunau tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuaciang ciimna nong kan tu a, ahihang kong zo buatu hi. Mun theampo ah hong zong ka lete zong nong mu buatu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Heakna bangma hunin na thusim ngei bua a Topa thu nit tu zongh na nial tawntung hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngaisutna kong piakte na dei ngei bua a, kong hil kong pau ciangin nong nadon bua hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua ahikom, nangma taw a kiphu bangin na nga tu hi, tuaciang nangma ngamtatna ma in na ci hong nasak tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Heakna nei ngeingawlte thi hi, banghang ziam cile amate in ciimna nial uh hi. A mawmawte sia awlmawk a neithei ngawlna in amate lalsak hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahihang a kuama po kei thu hong ngaite in ngammuanna nei tu hi. Ama sia thinmuang in om tu a, a launa tu bangma thu a om buatu hi.”
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa awng, kong hilte sin in a, vawt a kong sawlte bangma hunin mangil heak in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ciimna thute ngai in a, tuate heak tu in hanciam in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hi hi, ciimna ngen in; a thuk mu theina nei natu maangkaa in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngunn ahizong a kiseal sum manphate ahizong na zon tu bangin nasia takin zong in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuabangin na ngamta le Topa kiitakna sia bang ziam ci in na he tu a, Pathian thu heakna in na nei tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ciimna a pia sia in Topa hi; ama kung pan heakna le tel theina hong pai hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama in huna pia a, thutang, thumaante a sungsia hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Midangte tungah a kilawm tu bangin a ngamtate ama in sungsia a, ama tungah a kipiate ama in cing hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka pau nong ngai le, a maan, a tang le a kilawmte na he tu hi. Na vawt tute na he tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A ciim na suak tu a, na heakna in nopsakna hong pia tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A thuk na mu theina le na telna in nang hong sungsia tu hi,
  </para>
  <para style="p">
    <verse number="12" style="v" />tuaciang a maan ngawlte na vawt ngawl natu in hong khaam tu hi. Amate pauna taw ngimna a piangsak mite kung panin tuate in hong keam tu hi,
  </para>
  <para style="p">
    <verse number="13" style="v" />tuabang mite in thutang nuntakzia nusia in mawna khuazing sungah a teang uh hi,
  </para>
  <para style="p">
    <verse number="14" style="v" />tuabang mite in a maan ngawl sepna sungah nuamsa a, tuaciang in khiakna nei ngawl siatnate ah thanuam uh hi,
  </para>
  <para style="p">
    <verse number="15" style="v" />amate sia mihing suantaak ngawl a muan thamman ngawlte ahi uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangma in numei paktat khat po ii kamthum taw hong zolnate na nalh zo tu hi,
  </para>
  <para style="p">
    <verse number="17" style="v" />ama in a pasal tungah thumaan ngawlin kiciamna thiangthote a mangil nu ahi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama inn ah na haw le thina lampi ah khual a hawhaw na hi hi. Tua munah pai tu sia mithi khua a neak na hi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama kung a haw peuma hong heak kik ngeingawl hi. Tua pa in nuntakna lampi ah hong kilee kik ngei nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tua ahikom mihing phate lamlaknate zui in thutang nuntakna taw nungta hamtang in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thutang mi, thumaan takkhate, hisung eima ii leitang tungah a nungta tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahihang Pathian in mihing seksolte leitung panin dokkhe tu a, hi mawneite leitung panin thingnote baw bangin bot tu hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa awng, kong hilte mangil heak in. Vawt a, kong sawlte a tawntungin ciamtee in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kong hilnate in khansauna le nuntakna nuam hong pia tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thuciipna le thumaanna thasua ngei heak in. Na ngawng kiimkot ah vet in a; na lungtang tungah at in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hi bangin na ngamta le Pathian le mihingte in nang dik hong sa tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na thin theampo taw Topa muang in. Nangma ii he na kisakte bangma hunin muang heak in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na sep na vawt theampo sungah Topa phawk in, tua hile ama in a maan lampi hong lak tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na hi bang sangin a ciim zaw in kituat heak in, Topa ii thu ni lel in a, a maan ngawlte vawt tu nial in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuabangin na hile zatui pha bang hong hi tu a, na liamnate hong damsak in, na natnate hong nuamtuamsak tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leitang tung pan a piang theampo sung pan a phabel sia piakna taw Topa patoai in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuabangin na hile na ansaal sia antangte taw kidim tu a, na khol natu om ngawl liang dongin sapittui tam mama na nei tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka tapa awng, Topa in tekna, hilna hong nei ciangin pha takpi in nadon in a, kidop natu hong piak thu hi ci in saang in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nu le pate in a kiphatsak pui a ta khat, a tek a hil bangma Topa in ama ii itte tek hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A ciim a hong kikheal mihing — telthiamna a nei pa in mihing lungdam ahi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tua ii sungah ngunn sangin meetna tam om zaw hi; nang atu in khamh sangin man neizaw hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ciimna sia suang manphate sangin manpha zaw hi; deihuai na sak na khat pawpo taw zong a kitee ngat thei bua hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ciimna in khansauna hong pia a, hauna le minphatna zongh hong pia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ciimna in na nuntakna hong nuamsak tu a, thinmuang takin hong tonpui tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihing ciimte sia a lungdamte ahi uh hi; ciimna in nuntakna pia tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Topa in simlei sia ama ciimna taw bitphua hi; ama heakna taw van sia a omna munah koi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama ciimna in ngunte luangsak hi, tuaciang leitang atu in meeikaaite in nguatui piasak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka tapa awng, na ciimna le a thuk na muna sia keamcing in kholet in. Na kung panin taisua heak in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuate in nangma nuntakna hong pia tu hi, a nuam le lungdam nuntakna hong pia tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na paina lampi ah sumsina om ngawlin na pai tu a, zongh na lutu beak buatu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lupna na zot ciang zong na lau buatu a, zankhuateakin mut citakin na mu tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi seksolte tungah vuipi suangval bangin thakhatthu a tung thei lal theinate patau in na nei buatu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Topa in nang hong keamcing tu hi. Ama in thaang sungah nang hong awksak buatu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bang hun po ahizong, na hi thei lai teng a kitaangsamhte tungah phatna vawt in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tutawm in na hu thei tu ahi nale zing ciang dong na innpaamte in ngaksak heak in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na innpaamte tungah siatna a piangsak thei bangma sawmku heak in; amate in nang hong muangin na nai ah hong teang hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nang tungah siatna hong vawt ngeingawl mihing khat taw bangbang po thu om kale kam kinial heak in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mihing ngoltolte eang heak in a, amate ngamtat bangin ngamta tu in khensat heak in,
  </para>
  <para style="p">
    <verse number="32" style="v" />banghang ziam cile Topa in ngamtat pha ngawl a vawtte ngaimaw a, ahizong thutangte sia ama mimuan in koi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Topa in mi seksolte inn ah haamsiatna koi a, ahihang a thutangte inn sia thupha pia hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama in a kisatheite zangh ngawlin, a kiniamkhiakte maipha pia hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mihing ciimte in a pok huai minphatna nga tu a, ahizong mihing mawmawte in maimawlna bekma nga thua tu hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa awng, na pa hong hilnate ngai in. Pha takin nadon lete telthiamna na nei tu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang kong hil sia pha ahikom a vekpi in ciamtee in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka nu le ka pa ii tapa khat bek ahi keima ka patangno lai in,
  </para>
  <para style="p">
    <verse number="4" style="v" />ka pa in hong hil hi. Ama in, “Ka ci theampo ciamtee in a, mangil ngei heak in. Kong sawl bangin ngamta in, tua hile na nungta tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ciimna le thuthuk mu theina kan in! Kong cite sia mangil heak in a, awlmawk ngawlin om heak in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ciimna taisan heak in; tua hile tuasia in nang hong hung tu hi; ama it in, tua in nang hong keamcing tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ciimna ngana sia na vawt thei sung pan a thupibel ahi hi. A dang theampo na nga tazong thuthuk muna ma kan in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ciimna thangai in, nang hong liansak tu hi. Ciimna pom in, minphatna hong pia tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ciimna in na minthanna lukhu ahi tu hi,” hong ci hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka tapa awng, hong ngai ta'n. Kong son tute thupi laak in, tua hile khansau in na nungta tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ciimna le a maan lampi taw nuntakzia hong hil zo khi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ciim takin kal na suan le bangma in na lampi hong khak ngawl tu a, na tai ciangin na lutu buatu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na sinsate a tawntungin ciamtee in. Na sin pilna sia na nuntakna ahi hi — pha takin keamcing in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi ngilote paina ah pai heak in. Mi seksolte ngamtatna ettee in zui heak in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuabangin vawt heak in! Siatna pan kikeam in! Nial in a, na pai ngei bangin pai in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi seksolte sia a maan ngawl ngamtatna khat peuma a vawt bua uh le mutthip thei ngawl uh hi. Khat po a liamsua bua uh le amate mutthip thei ngawl uh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Seksolna le ngoltolna sia amate atu in an le tui bang ahi uh hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thutangte tot lampi sia sun dongin, a taang vaial nisuak taw kibang hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi seksolte lampi ahile zan bangin zing hi. Amate in liik ahihang bang tungah, lutu ziam ci in a mu thei bua uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa awng, ka ci teng pha takin nadon in. Ka kammalte ngai in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuate in nangma taisansak heak in. Tuate ciamtee in a, na thinsung ah keam in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuate in a tel theite tungah nuntakna le ciidamna pia tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na khua ngaisut dan kidawm in; na nuntakzia sia na khua ngaisutna in zeam hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A maan ngawl peuma bangma son ngei heak in. Ngual theamna le leilot thu peuma zangh heak in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Citak kimuanna taw maisang mitsuan in; maizumna taw kun heak in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na sep po pha takin ngeal phot in, tua hile nasep theampo a maan suak tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Siatnate pial in a, tang takin mai sangah kalsuan in. A maan lampi panin kal khat zongh pial heak in.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa awng, hong nadon ta'n a, ka ciimna le thuthuk ka muna hong ngai ta'n.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuaciang ngamtat luheakzia ahi tu bang na he tu a, na kammalte in heakna na nei hunlam hong lak tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pasal dang khat ii a zi muk sia khuaitui bangin thum tha tu a, ama ii hong napna in olive thau bangin neal tu hi,
  </para>
  <para style="p">
    <verse number="4" style="v" />ahihang a zawkciang tua nu in a sia a kha le natna bek hong nusiat hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama in mithi khua hong zotpui tu hi; ama tot lampi in thina lampi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama in nuntakna lampi tungah a om bua hi; vakthapin bang teng piang ziam ci zongh a tel bua hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu in hong ngai tavun, ka tapate awng, ka pau teng mangil ngei heak vun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuabang numei sia ii kung panin kikeam vun! Ama ii bangkua nai ngawngawn zongh neak tha heak vun!
  </para>
  <para style="p">
    <verse number="9" style="v" />Na neak uh le, nidang na nei ngei kizataknate sia midangte in lua tu a, hesuakna sel mite khutsa taw na khanthi tu uh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hi hi, khualmite in na hauna theampo la siat tu a, na thalaw sa theampo sia ngualdang khat atu hi tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na thi natu lupmun tungah na tatau tu a, na sazang le na thangolte kine tum tu hi,
  </para>
  <para style="p">
    <verse number="12" style="v" />tuasia ciang, “Banghangin he thei ngawl khi ziam? Banghangin khat po in teksak ngeingawl ka na khi ziam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka syate thu ka ngai bua a, amate ka thusim bua hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuaciang thakhat thu in mipi mai ah maizum minsiat ka thuak sia keima le keima ka kihe hi,” na ci tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na zi tungah thumaan in a, na itna sia ama bekma pia in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Numei dang taw na nei na tate in bangma phattuamna hong pia ngawl tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma tate nangma hong hu tu in hong khang tu a, ngualdang a hu tu ahi bua hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tua ahikom na zi taw lungdam vun a, na teenpui nu taw thinnuamin om in —
  </para>
  <para style="p">
    <verse number="19" style="v" />ama sia sangai bangin ngaibaang in thuzawk huai hi. Ama ngaibannate taw na lungdamsak in; ama hong itna in nangma tuamsak in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa awng, banghangin na itna sia numei dang khat pia tu ni ziam? Banghangin ngualdang khat zi ii ngaibannate lungngul zaw tu ni ziam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Topa in na ngamtatna theampo hong mu hi. Na paina theampo ama in hong encik hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi seksol khat ii mawnate sia thaang khat ahi hi. Amate mama ii mawna ngeen sungah amate awk uh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amate in a pumpi ki uk zo ngawl ahikom thi uh hi. Amate mawmawt leilamna in a thaankuul uh ah amate puak tu hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa awng, ngualdang khat ii leibatte vaipuak la tu in kamciam na vawt ngei ziam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma kammal ma in hong man kik ngei a, nangma kamciam in thaang hong sia ngei ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Tua ahile ka tapa awng, nang sia tua mihing pa khut sungah om ni hi, ahihang hisia vai taw na kipeal natu a manlang in ama va zuan ta'n a, hong maap natu in hesuak ngen ta'n.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma le nangma sia mut hun ahizong tawlngak hun ahizong kipia heak in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Savaipa thaang panin vacim ahizong, sangai ahizong a suatak bangin tua thaang panin pusuak in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing dathamte in mitsate nuntakzia tung pan sin tahen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate in lampui ahizong, hausa, ukpi ahizong nei ngawl hi,
  </para>
  <para style="p">
    <verse number="8" style="v" />ahihang amate in phalbi sung atu a kinginna in khaal lai in an koikhol hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing datham pa in bang tanvei lupna tungah lum tu ziam? Bang hun ciang hong tho peetma tu ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama in, “Tawmvei mu zok tong, leekoai in tawmvei sung tawlnga sin tong” ci hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahihang a mut lanin zawnna in hiamh toai ngualsuamte bangin ama sim tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihing ngautaak ngawl, mi seksolte in leilot thu sonin vak kawkoai hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amate nang hong theam natu in a mit suukin a khut uh vik hi,
  </para>
  <para style="p">
    <verse number="14" style="v" />tuasung theampo ah siatna taw kidim in a khel thinsung taw mun theampo ah nawngkaina piangsak tu in hol kawkoai hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hi thu hangin amate heakkhol ngawlin lalna in amate vaat tu a, tuaciangin amate sia thi theina ciang dongin liam tu uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Topa ii a etsat le a dual zawk ngawl thu nam sali om hi: Kiphatsakna maipuak, a theam thei leei, mawnei ngawlte a thatlum khut, seksol sawmin a ngaisun thinsung, siatna vawt tu a, a zuan ngang peangte, leilot thu khat zawkciang khat a son tetti, lawm le ngual sungah buaina pian natu a heltua pa cite ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa awng, na pa hong sonte vawt in a, na nu hong hilte mangil ngei heak in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amate ii kammalte phawk tawntungin a, na thinsung ah kip takin ciamtee in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amate hong hilnate in khual na haw ciangin hong hu tu hi, zanin hong hung tu hi, tuaciang sunin ngaisutna pha hong pia tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amate hong hilnate sia a taang khuavak hi; amate hong teknate in nuntakzia hong hil thei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua hilnate in numei pha ngawlte kung panin hong keam tu hi; midangte zite ii zolna kammalte pan hong keam tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amate mealphatna ip la heak in. Amate sikvil mit hana sungah awk heak in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pasal khat in anluum khat man za taw pumpi zuak numei khat nga thei hi, ahihang palngul mawna in a neisa theampo bosak tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na puan kaangh ngawl hetin na awm ah meikuang na toai thei tu ziam?
  </para>
  <para style="p">
    <verse number="28" style="v" />Na peang kaangh ngawl hetin meikam tungah na pai thei tu ziam?
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngual zi a luppui sia tuabangza ma in lauhuai hi. Tuabang a ngamta theampo in ngimna thuak tu hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A ngilkial laitak a, an a ngu nguta khat sia mihingte in zawngsak ngawl hi;
  </para>
  <para style="p">
    <verse number="31" style="v" />ahitazong ama a kiman le a see sali in liau tu hi — a neisa theampo a piak siat kul tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahihang palngul mawna a vawt mihing khat in ngaisut kaakna nei ngawl ahi hi. Ama le ama a kilalsua hi lel hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama a min kisiasak tu a, kivelpheang tu hi; a tawntungin maimawl tu hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pasal khat in a zi a muan nawn ngawl ciang a thin uuk za sangin a thin uuk zawk hun om ngawl hi; ama ii thuk kikna in ciangtan nei ngawl hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ama in liausum bangma a saang buatu hi; letsong bangza po in a tam ta zongin a thin uukna thai zo ngawl tu hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa awng, ka paunate ciamtee in a, kong sawlte vawt tu mangil ngei heak in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kong sawlte seam lete na nungta tu hi. Na mittangte na huuk bangin kong hilnate kidawm in zui in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kong hilnate a tawntung keamcing in; na lungtang tungah at in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ciimna sia na suapuinu bangin ngaisun in a, thuthuk muna sia na ngualtamh phabel bangin ngaisun in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuate in ngual zite kung panin nang hong keam tu hi, zolna kampau thei numeite kung panin hong keam tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khatvei lai in ka khelki panin a pua sang khua ka et le
  </para>
  <para style="p">
    <verse number="7" style="v" />bangma a khua he seam ngawl lai tangval tam mama ka mu hi, tuate sungah a mawmaw khat a tuamin ka ciamtee hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama in numei khat ii teenna nai, lampi sia tawnin pai hi,
  </para>
  <para style="p">
    <verse number="9" style="v" />tua hun sia nitak khuazin zawk ahi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuasia ciang tua nu in ama taw kisi hi; tua nu sia pumpi zuak numeite bangin kizeam a, tuaciang ama in niimna khat nei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama sia hangin a maizum maw numei khat hi a, lampi ah vak tawntungin tua ahibuale
  </para>
  <para style="p">
    <verse number="12" style="v" />lamking pan ngakin ding hi, khat vevei sia lampi ah, khat vevei le vanhzuakna phual ah ngakin om hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama in tangvalpa ngawngkoai in namh a, a mittang salhin,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Tuni in biakpiakna ka vawt a, sangaw biakpiakna pan sa zongh ka nei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tua ahikom nangma zong tu in kong pusuak hi. Kong mu nop bangma in hi sungah na om hi!
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka lupna sia Egypt pan puanneal a pawlkhat taw ka siin zo hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tua lupna sia myrrh, aloe le cinnamon thingnamtuite taw ka namtuisak zo hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hong pai ta'n! Zankhuateakin lumkhawm tawng. Khat le khat kikoai in nuamsa tawng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka pasal sia inn ah om ngawl hi. Khual khuala a haw laitak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama in sum tam ma keng a, nipi nii sung hong cia ngawl tu hi,” ci hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuabangin ama in tangvalpa sia ama thiamna taw zol a, numei ii kamthum kamzol in tangvalpa zo hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thakhat thu in ama sia ngaw tu in a kipaipui khuital bangin numei nu taw pai a, thaang sungah a awk tu sangai bangin kilawn in tai hi;
  </para>
  <para style="p">
    <verse number="23" style="v" />tua thaang sia thaltang ii a lungtang a vutlet natu mun hi. Ama sia ngeen sungah a tum vacim bang hi a — ama nuntakna lauhuai ahi hunlam a he bua hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tu in, ka tapate awng, hong ngai tavun. Ka pauna hong nadon tavun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuabang numei khat in na thinzosak heak vun: ama ii nung zuikot heak vun.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama in pasal tam mamate ii lalcipna hi a, a kisim zo ngawl mihing tam mamate ii thina piangsak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama inn ah na haw le mithi khua a zuazuan na hi hi. Tua in thi natu lamban khat ahi hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai vun! Ciimna in hong sam hi. Thu tuatna in ama le ama hong kihiil hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lampi hui mualdawnte le lamkaate ah ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khuapi sung tumna mun, kongpite hui ah ama in hi bangin au hi:
  </para>
  <para style="p">
    <verse number="4" style="v" />“Mihingte awng, hong maangkaa khi hi; leitung ah a om theampo sam khi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Puicing ngawl lai nu ziam? Puicin natu in kisin vun. Mawmaw nu ziam? Ngaisut theina na nei natu in sin vun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka kammal pha mamate hong ngai tavun; kong son theampo maan hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka ci teng thumaan hi; leilot thu ngaimaw khi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka pau theampo thumaan hi; a maan ngawl ahibuale lampui khialna bangma om ngawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thuthuk a mu thei mihing khat atu in thiang sitset hi; pha tak a, a kihil sa khat atu in tel ol hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngunn sangin kong lamlakna teal zaw vun; khamh phabel sangin heakna teal zaw vun.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Keima in Ciimna ka hi hi, suangmanphate sangin ka phazaw hi; na dei theampo, kei taw a kitee ngat thei bangma om ngawl hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keima in Ciimna ka hi hi, thuthuk mu theina ka nei hi; keima in heakna le thukhenna maan ka nei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Topa zatakna in a sia ngaimawkna ahi hi; kiphatsakna le kisaktheina, siatna lampite le a maan ngawl kammalte ka ngaimaw hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngealnate ka nei a, tuabangin ka seam suak hi. Telthiamna ka nei a, ka thahat hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kumpite ngamukna le ngamukte ii upadi phate a vawtna ah ka hu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Leitung ah ngam uk theampo in keima huna taw ngam uk hi, ngam uliante ahizong nam liante ahizong ka hu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kei hong itte ka it hi; kei hong zong po in hong mu thei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Haunate le minphatna, nopsakna le matutna piak tu ka nei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kei tung pan na ngate in khamh phabel sangin phazaw a, ngunn ciitak sangin phazaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thutang lampi ka tawn a; thukhaikim lampi ka zui hi,
  </para>
  <para style="p">
    <verse number="21" style="v" />kei hong itte hauna ka pia hi, a innte uh sum le vanh manpha te taw ka dimsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“ Topa in a masa phitbel in kei hong bitphua a, khuangeipi lai in a nasep phitbel ka hi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kipatciil hun mama in kei hong kivawt hi, simlei a kipat ma in a masabel ka hi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuipite a pian ma, ciktui te a om ma in ka piang zo hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mualpite pian ma, mualnote a om natu tek ah a kikoi ma in ka piang zo hi,
  </para>
  <para style="p">
    <verse number="26" style="v" />Pathian in leitung le a lote a vawt ma, ahibuale leitang masabel sia khutdim a vawt ma ngawngawnin ka piang zo hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Van sia a om natu munah ama ii a koi hun lai, tuipi kaantan in vanmong a phalh lai,
  </para>
  <para style="p">
    <verse number="28" style="v" />van ah meeikaaite a koi lai, tuipi tuinaakte a hon lai le,
  </para>
  <para style="p">
    <verse number="29" style="v" />tuipi tuite ama ii ciza sangin a saangzawin a khanto ngawl natu thu a piak lai, leitung tawdapte a phaa lai in tua munah kei ka om zo hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Keima in ama kungah inn limsuaithiamte bangin ka om hi, kei sia ni simin ama ii lungdamna naak ka hi hi, tuaciang ama taw ka om sia nuam ka sa tawntung hi,
  </para>
  <para style="p">
    <verse number="31" style="v" />simlei taw lungdam in mihing namte dik a sa pa ka hi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Tu in, khangmoite awng, hong ngai tavun. Ka ci bangin vawt vun, na lung uh dam tu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />No hong kihilte ngai vun. Ciim vun a; ngaingon heak vun.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kei thu hong ngaipa in lungdam tu hi — Ni simin ka kongbiang ah om a, ka inn sung tumna pan hong ngak pa sia mihing lungdam ahi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kei hong mu pa in nuntakna mu a, tuaciang Topa in ama diksa tu hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kei hong mu ngawl pa in ama le ama kiliamsua hi; a kuama po kei hong ensan sia in thina dei ahi hi.”
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ciimna in a inn sa a, khuam sali phut hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama in poai vawt natu nganno khat ngosakin, sapittui sungah hel thei tuatuamte a hel zawkciang sabuai phaasak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama in a naseam numeite sam a, khua sung a saang belna mun pan hi bangin ausak hi;
  </para>
  <para style="p">
    <verse number="4" style="v" />“Heakna nei ngawl mite awng, hong tum tavun!” Tuaciang mi mawmawte munah ama in;
  </para>
  <para style="p">
    <verse number="5" style="v" />“Hong pai tavun a, ka an ne in, ka hel sa sapittui ne vun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Heakna nei ngawl mihingte taw kitholna nusia vun a, nungta vun. Heakna lampi zui in” ci hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing kisathei khat na hil na pau le hong lanna bek na thuak tu hi. Mihing tatsia khat na teih le thinnatna bekma na nga tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A kisathei khat bangma hunin hilin pau heak in; ama in tua hu in nang hong ensan tu hi. Ahihang mihing ciim khat hilin pau lete ama in nang hong zakta tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A ciimte khat ii tungah na ci pawpo in ama ciimsak seseam tu hi. A thutang khat ii tungah na son khat sia in ama ii heakna belap hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ciim natu in Topa na thasia maksak kul hi. A Thiangtho Pa na he le telthiamna nei na hi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ciimna in kum tam mama na khan hong sausak tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ciimna na nei le a hampha tu sia in nangma na hi a, ciimna na nial le a thuak tu sia nangma na hi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mawmawtna sia a au vazak, heakna nei ngawl, a maizum maw numei khat taw kibang hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama in a kongbiang ah to a, ahibuale khua sung a saangbelna munah to in,
  </para>
  <para style="p">
    <verse number="15" style="v" />amate nasep tek ngaisun a, hong papai mihingte tungah:
  </para>
  <para style="p">
    <verse number="16" style="v" />“Hong tum tavun, heakna nei ngawl mihingte awng!” ci hi. A mawmawte mun ah:
  </para>
  <para style="p">
    <verse number="17" style="v" />“A kingu tuidam in thum zaw hi. A kingu anluum in lim zaw hi” ci hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama ii inn sungah a tumte thi a, a tum sate sia tu in mithi khua, a thukbelna ah a om hunlam tua numeinu ii a theam zawkte in a he bua uh hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hite sia Solomon ii paunakte ahi hi: Tapa ciim in a pa angtangsak a; a mawmaw sia in a nu khuangaisak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thumaan ngawlna taw na nga hauna in bangma phattuamna hong pia ngawl tu hi, ahihang thumaanna in na nuntakna hong ngum thei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Topa in mihing phate ngilkialsak ngawl tu hi; ahihang a seksolte sia amate ii deite a ngasak buatu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dathamna in zawnna piangsak tu a, ahizong nasep hatna in hong hausak tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing khuangaisun thei khat in a hunlai in lo ante kaikhawm hi; anlaak hun sung teng mutna in mindaina hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing pha khat in thupha saang tu hi. Mihing seksol khat ii kammalte in a ngoltol pianzia phualseal hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing phate sia thupha saanna hi ci in kiciamtee tu hi, ahihang mihing seksolte sia kimangil pal tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing khuangaisun theite in ngaisut pha piakna saang thei hi. Mawmawt kam a pau mite sia siatna sung theng tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thumaan mihingte thinmuang hiithiat a, ahizong thumaan ngawlte mat thuak tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thumaan thutak a iim te in buaina piangsak a, ahizong phualseal ngawlin a son ngamte in kilem natu in naseam ahi uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihing pha khat ii kampaute in nuntakna tuinaak hi a, ahizong a seksol khat ii kammal in a ngoltol pianzia phualseal hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ki etsatna in buaina thawn a, ahizong itna in tatkhialna theampo maisak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing a pilte in khiakna nei in pau a, ahizong a mawmawte daan piak kul hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ciimte in heakna a nga thei za in la a, ahizong mihing mawmawte hong pau ciang buaina taw kinai hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hauna in a haute hung a; zawnna in a zawngte susia hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nasep pha sepna thaman in nuntakna hi a, ahizong mawna in mawna dang tamzaw lai sung hong then hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kihil kipau ciangin a ngai mihingte nungta tu a, ahizong amate khialna a pualaak nuam ngawlte atu in lauhuai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihing khat ama ii etsatna a phualseal sia in leilot pa ahi hi. Thu nawnsan a kizelsak sia in mihing mawmaw ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kam tam pau vaial lete mawna vawt vaial hi thei tha tu ni hi. Mihing ciim na hile pau ngawlin om khipkhep tu ni hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing pha khat ii kammalte in ngunn ciitak bang hi a, a seksol khat ii ngaisutnate in man nei ngawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing pha khat ii kammalte in mihing tam mama phattuamna pia tu a, ahizong nangma le nangma sia mawmawtna taw na kithatlum thei tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang hong hausak sia in Topa ii thupha ahi hi. Nasep hanciamna in hong hauzawsak thei ngawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A maan ngawl sep diksakna sia mawmawtna hi. Mihing pilte in ciimna sungah nuamsa uh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A thutangte in amate deite nga a, ahizong a seksolte in a kiitakbel teng nga tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vuipi suangval hong pai in a seksolte seamkeak a, ahizong mihing thumaante a tawntung suakta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bangma hunin mihing datham pa khat in nang atu bangma seamsak ngei heak in; ama sia na ha le zuhau a kilem ngawl bang ahibuale na mittang sungah meikhu bangin hong nuammawsak tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Topa thu ni lete na khansauzaw tu hi. Mihing seksolte sia thi hun ngawlin khanthi uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihing phate ii lametnate in thinnopna sung hong then a, ahizong mihing seksolte in mai sangah lamet tu bangma a nei thei bua uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Topa in thumaan mihingte sungsia hi; ahizong a ngamta khialte susia hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A thutang mite in ngammuanna nei tawntung tu a, ahizong mihing seksolte a ngam sungah a nungta buatu hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A thutang mihingte in ciimkam pau uh a, ahizong kamsia a pau leei sia kitawlngasak tu hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A thutang mihingte in a dik thute pau tu he a, ahihang a seksolte in ngual thin nat natu bek pau nithi uh hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Topa in khaikhin maan ngawl a zanghte ensan hi. Toaisuang maante hangin ama lungdam hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing kiphasak te hai ngawlin maimawl tu hi. Kiniamkhiakna sia ciimna hizaw hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing pha na hile thumaanna in lam hong lak hi. Mihing a muanhuai ngawlte sia amate thumaan ngawlna in susia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na thi ni hong thet ciang haunate in bangma phattuamna hong pia zo ngawl tu hi, ahihang thumaanna in na nuntakna hong ngum thei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thumaanna in mihing pha khat ii nuntakna olsak zaw hi, ahihang mihing seksol khat in ama puk natu ama mama in piangsak tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thutang hina in a thumaante suatak hi, ahihang a muanhuai ngawlte sia amate duhopna thaang sungah awk hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing seksol khat a thi ciangin ama lametna zongh ama taw thi khawm hi. Haunate sungah thinmuanna sia bangma ahi bua hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A thutangte sia ngimna pan kidal hi; a seksolte tungah ngimna tung zaw hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian sel mihingte thu sonna in nang hong lalsak thei a, ahizong thutangte ciimna in nang hong hun thei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A thumaante in hamphatna a nei uh ciangin khuapi sungah lungdamna om a, a seksolte a thi uh ciang lungdamna aw nging hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A thutangte ii thupha a piak uh ciangin khuapi khat sia khua thupi suak hi; ahihang khuapi khat sia a seksolte kammalte taw kilalsak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngual zawnsak kampauna in mawmawtna hi. Khuangaisun thei khat na hile na thim khipkhep tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thu nawnsan son khat sia thuku huvau ah kimuang thei ngawl hi, ahihang a muan taak khat sia na muang thei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lampuina a nei ngawl minam khat sia puk tu hi. Ngaisutna a pia thei tam mama a om le ngammuanna om hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khualmi khat ii leiba losak tu in kamciam na pia le na kisiik tu hi. Kamkumh bua lete nangma atu in phazaw hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A thuthiam numei khat kizakta a, ahizong ngamtat pha ngawl numei khat sia a maizum huai khat ahi hi. A datham mihing khat in sum a nei ngei buatu a, ahihang a hanciam mama khat sia hau tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na dik le nangma le nangma kiphatvawt na hi hi. na ngilo le nangma le nangma kiliamsua na hi bek hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihing seksolte in a tatakin bangma meetna a nga bua hi, ahihang a maan in na ngamta le thaman hong kipia takpi tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A maan a, ngamta tu khensatna a nei sia nungta tu hi, ahihang akua po ahizong a maan ngawl ngamtatna a vawt hamtang sia thi tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Topa in mihing thinsiate ngaimaw hi, ahizong a maan a ngamtate it hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing ngilote daan kipia tu ci sia a pealmaw hi, ahihang thutang mite ahile suakta tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thu khensatna pha a nei ngawl numei khat ii mealphatna in vok naak ah khamh naakba taw kibang hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing phate ii deite sia phatna taw tawp tawntung hi; mihing seksolte ii a deite a nga uh ciang a kuama po thin uuk hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing pawlkhat sia a sum uh zangh vapeak a hau vaial hi. A dangte sia kidawm in zangh hi napi zawng vaial hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngo vapeak vun, tua hile na nuamsa tu uh hi. Ngual hu vun, no zongh hong kihu tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A man khan tu ngak a, antang a kholte sia mihingte in haamsiat hi, ahihang tuabang khol ngawlin a zuak paihte sia ngual in pok hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na mungtupnate a pha le nang hong kizakta tu hi, ahihang ngimna na zong le tuasia ma na nga tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A hauna uh a suangte in tangngam lai a, thingteete bangin a pul tu uh hi, ahihang thutangte in khaal lai a, thingteete bangin a khang tu uh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amate ii bangkuate sungah ngimna a piangsakte in a tawpna ah bangma a nei buatu uh hi. Mi mawmawte sia miciimte ii naseam a suak tawntung tu uh hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thutang in nuntakna pia a, ahihang ngoltolna in nuntakna bosak hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mihing phate hi leitung ah thaman kipia ahiciang mihing seksolte le mimawte daan kipia tu hi ci sia na he hamtang tu hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />A kuama po heakna a deite in a khial ciangin hil tu uuk hi. Kihil kipau tu dei ngawlna in mawmawtna hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Topa in mihing phate tungah lungkim a, ahizong siatna a ngealte puavawk hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Seksol tatsiatna in thinmuanna pia ngawl a, ahizong mihing thutangte in dinmun kip nei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zi pha khat in a pasal ii angtanna le lungdamna ahi hi; ahihang a pasal a maizumsak zi khat in a pasal ii ngu sungah cancer natna khat taw kibang ahi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A thumaan mihingte in a kilawm bangin hong vawt tu hi; mihing seksolte in theam tu bek hong sawm hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing seksolte ii kammalte in mihing thatlum thei a, ahihang a thutangte ii kammalte in tawnna a thuakte suatak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing seksolte in kiamsukin suan le paal nei ngawl a, ahihang thutangte ii bangkuate sia nungta paisuak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na pil le, nang hong kipok tu hi; na mawmaw le nang hong kinomu tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Milian khat bang kiheang in ngilkial a ih om sangin nuntak natu a thalaw mihing thawthong khat hi leang phazaw hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihing pha khat in a ngannote pha takin en a, ahihang mihing seksolte in nganno tungah tatkha hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nasep hanciam lotho mi khat in neak tu tam mama nei hi, ahihang kimanna om ngawl nasepnate taw hun bosakna in mawmawtna hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihing seksolte ii uuk theampo sia, a sia vawt tu zonna ahi hi, ahihang thutangte a dinmun kho hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing seksolte khat in ama ii pauna taw thaang sungah awk hi, ahihang a thumaan khat in ama le ama ngimna pan kipusua hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na thaman sia na pauna le na sepna tung pan kituat tu hi; nang taw a kiphu bang na nga tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihing mawmawte in amate le amate maan kisa tawntung hi. Mihing ciimte in ngaisut piakna ngai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A mawmaw khat in diksak ngawlna a nei ciang manlang takin kilanghsak hi. Mihing khuangaisun theite in ngual ii lanna kam a awlmaw buatu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thumaan na son ciangin thutang khenna piang hi; ahihang leilotna in a kikhaikim ngawl thukhenna piangsak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngaisun phot ngawl a, pauna in namsau taw saat bangin thuk bunin liamsak thei hi, ahihang ciim kampauna in damsak thei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leilot thu sia ngei kho ngawl a, thumaan thutak sia a tawntungin nungta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Siatna a ngealte in muanmawk ngawl thusia khat tawk tu a, ahihang phatna a seamte in lungdamna nga tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thutang mite tungah a sia na khat zongh tung ngawl hi, ahihang a seksolte in ngimna simngawl bangma a nei bua uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Topa in leilot theite ensan hi, ahihang a kampau sa a kholette diksa hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing khuangaisun theite in a heak uh thute son vazai ngawl hi, ahihang mihing mawmawte in a heak ngawlna uh teng ma thangsak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nasep hamciamna in thahatna hong pia tu hi; na dathamna in sal hong sua tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thinngimna in lungdamna hong suttol thei hi, ahihang kamthiam in hong lungpilsak tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A thutang pa sia a lawm pa atu in lamhilpa hi tu a, ahihang a seksol khat ii lampi in amate lam pialpui hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na da a tham le na zon sia na nga ngei buatu a, ahizong nasep na hanciam le hauna na nga tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thutang hina in nuntakna lampi hi; seksolna sia thina lampi ahi hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tapa ciim khat in a pa ii a hil a pau ciangin nadon a, ahihang a kisathei mihing khat in khial khi hi a ci ngei bua hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing phate sia amate pauna tung panin thaman kipia tu a, ahihang ngualtheam theite sia andu ngilkial bangin ngoltol ngamtatna dei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na pau po kidawm in a, na nuntakna huu in. Kidawm ngawlin a pau khat in ama le ama kisiatsua hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A datham khat in na khat pawpo bangza in a dei hang, a nga ngei buatu hi. Naseam hat khat in a dei po nga tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing thumaante in leilot thute ngaimaw hi, ahihang mihing seksolte ii kammal in maizumhuai a, minpaan huai hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thutang hina in a maw ngawlte hung hi; seksolna in mawneite ii pukna hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing pawlkhat sia a hau bangin kiheang ahihang, bangma a nei bua uh hi. A dang pawlkhat sia a zawng bangin kiheang ahihang, nei le lamh a nei uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sumhau khat in a nuntakna a huuk natu in a sum a zak kul a, ahihang a zawng khat sia ama a tawng tu kuama a om bua hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thutangte sia khuavak taang kiukiau khat taw kibang hi; a seksolte sia meiinn a mit vangeu taw kibang hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kisak theina in ngim ngana simngawl bangma dang a piangsak bua hi. Ngaisutna ngetna in ciim zawkna hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ol takin hauna na nga le na bosak pal tu hi. A haksa zaw in na thalaw le a tamzaw na nei tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lametna a bo ciang ngaisutna zongh lal a, ahihang na uukna khat a taangtun ciang thinnopna taw hong kidimsak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngaisutna phate na nial le ngimna a zong na hi hi; tuasia zui lete na ngammuang tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ciimte hong hilnate sia nuntakna ii tuinaak hi; tuate in launa sungah na om ciang hong suaktasak tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilna in kithasiana piangsak a, ahihang a muanhuai ngawlte sia lalna lampi a tawn uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khuangaisun thei mihingte in a ngamtat ma in ngaisun phot tawntung hi, ahihang mihing mawmawte in a heak ngawlna uh thangsak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A muan thamman ngawl kamtaite in ngimna piangsak hi, ahihang a muanhuaite in kilemna hong then hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kihilna a ni nuam ngawl po sia zawngin mindai tu hi. A kuama po kihil kipauna a ngai sia kizakta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na dei po na nga tu sia bangza in pha ziam! Mihing mawmawte in siatna nusia nuam ngawl hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A ciimte taw na kithawl le na ciim tu hi. Mihing mawmawte taw na kipawl le na lal tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngimna in mawneite mun theampo ah zuizen a, ahihang mihing thutangte sia a thaman in naphate kipia tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihing pha khat in a tute atu hauna nusiat tu hi, ahihang mawneite hauna sia thutangte kung zuan tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kitho ngawl lote in mizawngte atu, an tam mama piangsak thei hi, ahihang a maanin a ngamta ngawlte in mizawngte thaw tu khaktan hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na tapa na hilna in daan na pia buale ama a it ngawl na hi hi. Ama na it nale hil in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thutangte in a neak tu a kicing nei a, ahihang a seksolte sia a ngil uh kial tawntung hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Numeite ii ciimna taw inn sung nuntakzia kipuua a, ahihang mawmawtna in tuate susia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thumaan in, tua hile Topa thasiana a lak na hi hi; thumaan heak in, tua hile Topa na thasia ngawlna a lak na hi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A mawmaw a kiphasakte kam tam pau hi; a ciimte ii kammal in amate huu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lotho tu khuital a om buale na ansaal hawm tu a, ahihang tua khuitalte a om hu in na ansaal sia antang taw kidim tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A muan taak tetti khat in thutak son tawntung a, ahihang a muan thamman ngawl khat in leilot thu simngawl a dang a son bua hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A kinasiasak mihingte bangma hun a ciim thei ngei buatu hi, ahihang mihing pilvangte in olno takin tel thei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing mawmawte kung pan kikeam in; amate in nang hong hil tu bangma a nei bua uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Banghangin mihing pil khat sia ciim ziam? Banghang ziam cile ama in a sep tu he hi. A nangh khat sia banghangin mawmaw ziam? Banghang ziam cile ama in he siat kisa hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing mawmawte in mawna a vawt le zong phamaw sa ngawl hi, ahihang mihing phate in maw kimaisak tu dei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na thinnopna sia nangma ii aituam hi; na thin natna zongh nangma ii aituam hi. Kuama in tuate nang taw hawm thei ngawl hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihing pha khat ii inn sia mihing ngilo khat ii inn a kisuksiat zawkciang zong kip lai tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lampi maan na sak khat in thina sung hong then thei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nuina in heena seal thei hi. Lungdamna a bo zawkciang heena sia tua munah om tawntung hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing pha ngawlte in amate taw a kiphu bangin nga tu hi. Mihing phate in amate sepnate tung pan thaman nga tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A mawmaw khat in na theampo um tu hi; khuangaisun theite in a kalsuan natu kidawm hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihing ciimte in ngim ngana pan a kikep thei natu kidawm hi, ahihang mihing mawmawte sia kidawm ngawlin ngamta memeang hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A thinngeam mihingte in a mawmawthuai nate seam hi; a ciimzawte in dai takin om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Heakna nei ngawlte in a mawmawtna taw a kiphu bang nga uh hi, ahihang a pilte tungah heakna sia thaman in kipia hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihing ngilote in thutangte mai ah kiniamkhiak in kun a, maipha a zong tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mizawng khat sia kuama in a dei bua hi, a innpaamte ngawngawn in, a dei bua uh hi, ahihang a hau khat in lawm tam ma nei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lungdam nuam le a zawngte tungah dik in; mi khat po zawnsakna sia mawna ahi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A pha na vawt le ngualdang ii muanna le zatakna na thalaw tu hi; a sia na vawt le a ngamta khial na hi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na na seam le nuntak natu na thalaw tu hi; thuson in na to thawthong le na zawng tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing ciimte in hauna thaman saang a, ahihang a mawmawte sia amate ciim ngawlna panin kihe hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tetti khat in thumaan a son ciangin ngual nuntakna huu hi; ama in leilot thu a son ciangin ngual leeheak ahi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Topa thasiana in mihing khat le a innkuanpuite atu in kimuanna le ngammuanna pia hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thina na pial nuam ziam? Topa thasiana in nuntakna tuinaak ahi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kumpipa khat ii letna sia mihing bangza uk ziam, ci thu taw kisai hi; a uk tu mihing a nei buale ama in bangma ahi bua hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai takin na om le nang sia a ciim na hi hi, ahihang na thin a ngeam le, bangza mawmaw ci a lak hi bek ni hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thinnopna in pumpi ciidamsak hi, ahihang eenna thin in cancer natna taw kibang hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mizawngte na nengcip le a vawt pa Pathian simmaw na hi hi; ahihang mizawngte tungah dikna in biakpiakna nam khat ahi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mihing seksolte in amate tatsiatnate taw amate le amate ii a kiamsuk natu uh piangsak hi, ahihang mihing phate sia amate takkhana in huu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ciimna sia mihing pilvangte ii ngaisutna theampo sungah om hi; a mawmawte in ciimna huvau bangma a he bua hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thutang hina in minam lian khat suaksak hi; mawna in minam khat ii min daisak hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kumpipate in nasep thiam uliante diksa uh a, ahihang nasep thiam ngawlte daan pia uh hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Awneam taw kizona in thin uukna thaisak a, ahihang awtawlok in thinsosak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing ciimte a pau uh ciang heakna deihuaisak a, ahihang mihing mawmawte in nawnsan thu son nuam uh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Topa in mun theampo ah bang teng piang ci in mu hi; na pha ih seam a, a sia ih seam zong ama in hong en nginge hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamthiam in nuntakna piangsak a, ahihang ngitlo kampauna in na thin hong siasak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na pa hong hilnate na awlmawk ngawl tu sia mawmawthuai hi; ama ii hong hilna hong paunate saan theina in ciimna ahi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thutang mihingte in a hauna uh keamcing hi, ahihang mihing seksolte in hun haksa hong thet ciang a neisate bosua uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Heakna sia mihing a ciimte in kizelsak a, mihing mawmawte ii kizelsak hi ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing phate thunget ciang Topa lungkim hi; ahihang mihing seksolte hong paipui sa ngaw biakpiaknate ensan hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Topa in mihing ngilote ngamtatziate ensan hi, ahihang a maan a seamte it hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A maan ngawl sep na nei le nasia takin daan hong kipia tu hi; kipuuaphat tu na uuk buale na thi tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mithi khua ngawngawn in, tua munah bang om ziam ci in Topa ii heak tu sia khaam thei ngawl hi; tua ahile bangbangin mihingte in amate khua ngaisutna sia Pathian mai ah seal thei tu ziam?
  </para>
  <para style="p">
    <verse number="12" style="v" />A kisathei mihingte in kipau kihil tu a uuk bua uh hi; a ciimzawte tung panin ngaisutna a ngen ngei bua hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihingte sia a lungdam uh ciangin maitui uh a, ahihang a hee uh ciangin thinkiamna maipuak nei uh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing pilvangte in he thua nuam hi, ahizong a nanghte in heak ngawlna taw lungkim uh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mizawng khat ii nuntakna sia a tawntung thasaalin dianna hi a, ahihang mihing lungdamte in a nuntak nuamsa tawntung uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hau a ngim nga tu sangin, zawng a Topa kiitakna in phazaw hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ki etsatna a omna munah sa a limbel neak sangin na it mihingte taw antee neak khop sia phazaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thinngeamna in kam kinialna piangsak a, ahihang thinsauna in kilemna hong puak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na da a tham le mun theampo ah haksatna na thuak tu a, ahihang na thumaan le ngim na nga buatu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ta ciimte in a pate lungdamsak hi. A mawmawte bek in a nute maimawlsak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing ciim ngawlte in a mawmawtna taw lungdam uh hi, ahihang a ciimte in a maan sia bek seam tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngaisut piakna na nga thei theampo la lete zawna na nga tu hi; tua ngawl taw zawna na nga buatu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hun taw a kilawm a kiphu tu kammal zak thei sia bangza in thinnopna om ziam!
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing ciimte in nuntakna lampi ah paito uh a, thina lampi a tawnsuk bua uh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A kisathei mite ii bangkua sia Topa in susia tu a, ahihang ama in meingong khat ii neisa sia a huu tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Topa in ngitlo ngaisutnate ngaimaw hi; ahihang ama in kamthiamte diksa hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thumaan ngawlin meetna nga tu na sawm le na innkuan in ngimna sung na theng tu hi. Sumnguk ne heak in tua hile na khansauzaw tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihing phate in ngual kam a zo ma in ngaisun masa uh hi. Mihing ngilote in manlang takin zo kik a, ahihang buaina piangsak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mihing phate thu a nget ciang Topa in ngai hi, ahihang ama in a ngilote a awlmawk bua hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A maitaite in nang hong lungdamsak hi, tuaciang lungdamhuai thute in na thin hong nuamzawsak hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nang hong kihil hong kipau ciangin na nadon le a ciim na hi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Heak nopna na nei buale nangma le nangma kisiatvawt na hi hi. Kipau kitekna na saang thei le na ciim seseam tu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Topa thasiana in pilna heakna khat ahi hi. Patoaina na saan thei ma in na kiniamkhiak masak kul tu hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eite in tupna sawmna vawt ka leang Pathian ii deina bang bekin taangtung hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na sep na vawt theampo maan hi ci in ngaisun tha tu ni hi, ahihang Topa in na tupna laingil tungah thu hong khen hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na ngealnate Topa in thupha hong piak natu in ngen in, tua hile na sep tak ciang zawna taw, ma na tun tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Topa vawt sa khat simin a tawp natu khat tek om hi; a seksolte tawp natu sia lalna ahi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A kisathei pawpo Topa in ensan hi; ama in amate daan thuak natu panin a suaktasak buatu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thumaan vun a, citak vun, Pathian in na mawna hong maisak tu hi. Topa ii thu ni vun, thusia bangma na tungah hong tung ngawl tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Topa na lungkimsak ciangin na ngalte zongh lawm le ngual na suaksak thei tu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thumaan ngawlna taw sum tam mama nga sangin thumaan takin thalaw vateeina taw sum tawmno khat nei sia phazaw hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangma in ngealna vawt thei tu na hihang Pathian in na ngamtatnate hong zeak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kumpipa in Pathian ii thuneisakna taw pau hi; ama thukhennate sia maan tawntung hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Topa in toaisuangte le khaikhin a maan tu dei a, vanhzuak theampo a kilawm in zuak tu dei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kumpipate in ngitlona dual zo ngawl hi, banghang ziam cile a khaikim thukhenna in kumpi khat thahatsak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kumpipa khat in thumaan thutak za nuam a, thumaan a sonte ama in maipha pia tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing ciim khat in kumpipa lungdam in a om thei natu hanciam tu hi; kumpipa a thin a uuk le khat po in thi law thei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kumpipa ii maipha a piakte sia khuakhaal kipat hun a, nguazusak meeikaaite bang ahi hi. Tuasung ah nuntakna om hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khamh le ngunn sangin ciimna le heakna nei tu phazaw hi — phazaw pek hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Miphate in siatna a pial lampi tawn in khualhaw hi; tua ahikom na pai natu en in kidawm ta'n — tua in na nuntakna hong hun thei tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kiphatsakna in siatna sungah hong then a, kisaktheina in kiamsukna sung hong then hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kisatheite ii sungah kihel a, ih pawlte ii a sutol vanh hawmte ih nga sangin, kiniamkhiakin a zawngin om leang phazaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang hong kihilnate nadon in tua hile zawna na nga tu hi; Topa muang lete na lungdam tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ciim a puicing mihing khat sia ama ii tel theina a neina pan kihe hi. Ama sia kamthum pau vaial a, ngual huai vaial hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A ciimte atu in ciimna sia nuntakna tuinaak ahi hi, ahihang mihing mawmawte pilsak tu hanciamna sia hun bo thawthong hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing pilvangte in a pau ma in ngaisun khol uh hi; tuasia ciang amate pauna sia ngual zaak nop suak seseam hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kamthiam paunate sia khuaitui bangin thum a, ciidam natu in pha hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A maan lampi hi ci in na up sia in thina sung hong then thei hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nasep haksa seam khat ii ankam limna in a nasep hatsak zaw hi, banghang ziam cile ama in a ngilvasak nuam hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihing ngilote in ngualdangte ngim nga natu in lam zong uh hi; amate kammalte mama ngitlona taw kuang hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ngual ngensiatna sia mihing seksolte in kizelsak hi; amate in buaina piangsakin, ngualtamh hina zongh khentham hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A ngoltol mihingte in a lawmte theamin lalna sungah tumpui hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nang hong maitui a hong mitsuk te kidawm in; amate in a sia pawlkhat ngaisun zo hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khansauna sia a thutangte ii thaman ahi hi; puakkaanna in minthanna kumpilukhu ahi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thahatna sangin thinsauna phazaw hi. Khuapite na uk siat sangin nangma le nangma na ki uk zawk tu sia phazaw hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mihingte in Pathian ii deina a heak natu in aisaan uh a, ahizong a zo kikna sia Pathian ii khensatna bang bek ahi hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thinngimna taw kidim inn khat sung anneakpoai ah anneak sangin anluum ko bekkhat thinnuam a, neak sia phazaw hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A pil naseam khat in a mannung ngawl a topa ii tapa tungah thunei tu a, a ngamh sung pan khen khat lua tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khamh le ngunn sia mei taw hal in kisit hi, Topa in mihing khat ii thinsung sit hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihing ngilote in ngitlo ngaisutnate diksa a, leilot theite in leilot thu diksa hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing zawngte na nuisan le, amate a vawt Pathian a selno na hi hi. Midang khat ii kaamsiatna tungtaang ah diksa in na om le daan na thuak tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Patangnote in a pate huvau in a angtan uh bangin pasal haamte in a tute huvau in angtang uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngual ii zatakte in leilot thu son ngawl hi, tuaciang mihing mawmawte in a mannei thuson tu bangma he ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing pawlkhat in sumnguk piakna sia mitbum bang hi thei tu in ngaisun uh hi; amate in sumnguk piakna taw na theampo seam thei tu in um hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihingte ii hong it tu na nuam uh le no tungah hong khial ciangin maisak vun. Tatkhialnate teptee in nei leang ngualtamh hina khentham thei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A mawmaw khat sia zakhatvei saatna taw a heak tu sangin, a pilvang khat in khatvei teihna taw tamzaw he thei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Buaina a piangsak tawntung mihing seksolte kungah thina sia kamtai ngilo khat bangin hong pai tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mawmawthuai tupna taw a komla mihing mawmaw pawlkhat taw kimu tu sangin, a note a kimatsak vompui khat taw kisi leang phazaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thupha khat sia thusia taw na thuk le na bangkua sungah siatna a veng ngei buatu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kam kinial kipatna in tuicimna phung pan tuikee kipat bang hi; a nasiat ma in tawp vun.
  </para>
  <para style="p">
    <verse number="15" style="v" />A maw ngawl khat mawsakna ahizong mi seksol khat tha thongna ahizong Topa atu in ngaimawkhuai khawm hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihing mawmaw khat ii tungah pilna sin natu sum bosakna in phat tuamna om ngawl hi, banghang ziam cile ama in pianpui khentel theina nei ngawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngualtamhte in a ki itna kilak tawntung uh hi. Ngimna thuak khawm tek tu ih hi buale unau khat ih hi man bang om ziam?
  </para>
  <para style="p">
    <verse number="18" style="v" />Khuangaisun ngawl te bekma in ngual leiba losak tu in kamciam tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mawna a lamnai sia in ngimna vawt a lamnai ahi hi. A tawntungin na kisuangtaak le ngimna a zawzong na hi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A sia vive ngaisun a, a paute in a pha mu tu lamet thei om ngawl a — siatna bek mu tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mawmawthuai nasepte a seam tate ii nu le pa atu in heena le khuangaina simngawl a dang bangma a om bua hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Maituina in na ci hong damsak hi. A tawntung mainuu a omna in vuitat zok ngawl thina ahi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A maan ngawl thukhenmangte in sumnguk ne ku hi, tuasia ciang a khaikim thukhenna kivawt nawn ngawl hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing pil khat in ciim ngamtat tu tumh hi, ahihang a mawmaw khat in a tuatuam tumh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ta mawmawte in a pate atu in heena le a nute atu in thinnat khuangaina piangsak hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A maw ngawl khat liau piak tu sia maan ngawl hi; mihing phate daan a khak ciangin thukhaikim lam pan pialsak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama le ama a kimuang khat sia pau tawntung ngawl hi. A om hithiat mihingte sia thuthuk tatak muna nei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A tawpna ah, mihing mawmaw khat ngawngawn zongh pau bua hen a, a kam iim in om le a ciim a pilvang ma kisa thei hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngual taw a kituiton thei ngawl mihingte sia amate bek a kikinte ahi hi; midangte ii maan hi ci in a heakte a thukim pui buatu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing mawmaw khat in na khat a tel le a tel ngawl sia phamaw a sa bua hi; ama ii uuk sia ama bangza in pil khi ziam, ci in a lak nuam hi bek hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawna le maizumna tonkhawm hi; na zatakhuaina taan lete a luangin zawnsakna na nga tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihing khat ii kammalte in ciimna ii naak, tuipi bangin a thuk le a thiang luamtui luang bang hi thei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A mawte angvan a, a maw ngawlte tungah a kikhaikim in thukhen ngawlna sia maan ngawl hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A mawmaw khat po in kam kinialna a phuang le, ngual ii vel tu a zong ahi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A mawmaw khat a pau ciangin ama le ama kilalsak hi a; ama kampaute taw thaang sungah awk hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngual ngensiatna sia lim mama a, bangza in kivalh suk nuam ziam!
  </para>
  <para style="p">
    <verse number="9" style="v" />A datham mihing khat sia ngual a lalsak thei khat za in sia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Topa sia, tausaang kho taw kibang a, thutangte in zuanin ngammuanna nga thei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihaute ahile amate hauna in, a saang a kho khuapi luphungte bangin, amate dal hi ci in ngaisun hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A kiniamkhiak ngawlte kuama in a zakta bua hi; mihing a kisatheite sia lalna lampi zuan ahi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngual kam na zo ma in ngai masa in. Tuabangin na hi buale nang sia mawmaw a, ngual a thusim ngawl na suak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na nat ciangin nuntak nopna thin in nang hong luhaisak thei hi, ahihang tuasia na bosua tha le na lamet khakbel sia bo hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihing pilvangte in lawp tawntung a, pilna sin tu kingingsa in om uh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihing thupi khat taw na kisi nuam ziam? Letsong khat puak lete ol takin na kisi thei tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thukhenzum sungah, a pau phitbel pa sia a langkhat pa ii thu a dok mateng a maan son bang hi tawntung hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thukhenzum sungah a thahat mihing nii sia thu nei in a kilangpan tan le mee sawksak in thu saatsat thei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na mealheakte hu lete amate in khuapi luphung kho khat bangin nang hong dal tu hi, ahihang amate taw na kihau le a innkha uh hong khasan tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na ci pawpo taw kizui in thupiangte na nuntakpui kul tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na kampauna in nuntakna hong keam thei a, tua ahibuale zong hong lalsak thei hi; tua ahikom na kammal tung pan a piang thute lungkimin na thuak kul hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zi khat na nei ciang na pha khat mu na hi hi; tuasia in nang tungah Topa pha hi ci in hong lak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mizawng khat in a pau ciangin kamthiam a zak kul hi, ahihang mihau khat in ngual kam a zo ciangin kamkhal zangh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kingualtamhna pawlkhat sia kho ngawl hi, ahihang ngualtamh pawlkhatte ahile suapui laipeete sangin thumaan zaw hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />A leilot thei a mawmaw khat hi tu sangin, zawng napi a thumaan khat ih hi tu phazaw hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Heakna om ngawl thalawpna in pha ngawl hi; thin vei laakna in ngimna sungah hong then tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing pawlkhatte in amate ii mawmawt ngamtatnate taw kilal sua a, tuasia ciang Topa mawsiat uh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihaute in ngualtamh thakte mu tawntung hi, ahihang a zawngte in ngualtamh tawmno a nei sun teng keam zo ngawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thukhenzum sungah leilot thu na son le daan na thuak tu hi — suatakna a om buatu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing thupite tung pan maipha nga tu in a kuama po hanciam uh hi; a kuama po in phattuamna a pia theite sia ka ngualtamh hi ci tek uh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mizawng khat in a mealheakte ngawngawn konlaw thei ngawl hi, ama ii ngualtamh a nei ngawl sia lamdang ngawl hi. Bangza in hanciam kale kuama a nga zo bua hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangma le nangma kiphatvawt in a, na sin thei theampo sin in; tuaciang na sin sa teng ciamtee in, tua hile na khangto tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thukhenzum sungah leilot thu a sonte peuma daan piakna pan suakta ngawl tu hi; ama a lal ahi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A mawmawte a nuam leilam in nungta heak hen a, salte in lianzaw tate uk heak hen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khuangaisun thei khat na hile na thin tomna na uk zo tu hi. Nang tung hong taa khial khat a om ciang awlmawk ngawlin om theina in phatna lian khat ahi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kumpipa ii thin uukna in tawpi hawk bang ahi hi. Ahihang ama ii hong phatvawtna sia ih dei laitak a zu nguatui bang ahi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A mawmaw tate in a nu le a pate lalna sung then thei hi. A nawnsan zi sia mal khakhat in a taak vakek tui taw kibang hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing khat in a nu le a pa tung panin inn le sumte lua thei a, ahihang Topa bek in khuangaisun thei zi khat pia thei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na datham nuam le datham in; mumu lel in, ahihang ngilkial in na om tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian thukhamte tang in, na khansauzaw tu hi; na thusim buale na thi tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A zawngte tungah na piak ciangin Topa tungah pukthaak bang hi a, Topa in hong lo kik tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na tate heak thei natu in a khanmoi lai in tek in. Tuabangin na vawt buale amate le amate a kilalsua natu in a hu na hi tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihing khat a thin a ngam le ama in a piang thute thuaksak in. Ngim nga natu panin khatvei na hun ngei le na hut kik kul tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngaisut piakna ngai in heakna sin tu na lungngul le ni khat ni ciang na ciim tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihingte in na namcin ngeal thei hi, ahihang Topa deina bang bekin piang tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Duhopna in min paanna hi; mizawngte in a leilot theite sangin phazaw lai hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Topa thu ni in na om le khansau in na nungta tu hi, lungkim in siatna pan suakta in na om tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing pawlkhatte a kam sungah an zongh kibak naap ngawl za dongin datham mama hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A phazaw ngamtatna a he ngawlte ii a heak thei natu in, kisaktheinate sia daan kipia tu hi. Na ciim le nang tungah hong kipau hong kihil ciangin na tel tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A maizumhuai, a minpaan pa bek in a pa vawtsia tu a, ahibuale a inn panin a nu not tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tapa awng, pilna sinna na tawp le na heak sate zongh hai ngawlin na ngaingon tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tetti khat in mihing khat pawpo supna baina pia nuamin a khensat zawkciang thumaan thukhenna om thei nawn ngawl hi. A seksol mihingte in a sia nate sin tu lamnai hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A kihisak a mawmaw khat in velna vuakna nga tatak tu hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zu tamlei neakna in aw saangsak a, hong mawmawsak hi. Zu khamna sia mawmawthuai hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hong ngalh tawpi khat na kiitak tu bangin a thin uuk kumpipa khat kiita in; ama thin uuksakna in eima le eima kithalupna hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kam kinialnate sia a mawmaw khat po in pan thei hi; tuate panin kikepna in a zatak huai ngamtatna ahi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A hun lai in lothaw tu a datham mama lotho pa khat in anlaak tu a nei buatu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing khat ii khua ngaisutnate sia, tuikhuk thuk sung a tui bang ahi hi, ahihang thuthuk mu thei khat in tua tui toai thei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing theampo in bangza thumaanin citak khi ziam ci thei tek uh hi, ahihang tuabang ahi takpi mihing ih mu zo tu ziam!
  </para>
  <para style="p">
    <verse number="7" style="v" />A pa uh thumaan a, a maan nasep a seam le, a tate sia hampha uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kumpipa in thukhenna ah to a, a sia a mu ciang khentel hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khat pawpo in ama thinsung thiangtho a, mawna taw kipeal zo ing a ci thei takpi tu ziam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Topa in a maan ngawl khaikhin toaisuangte le vanh teena a zangh mihingte ensan hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Patangnote zongh amate ii sep le vawt taw amate sia bang ziam ci in lak hi; amate thumaan ziam, pha ziam na son thei tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Topa in khuamu thei natu mittangte le khua zaak thei natu bilte hong pia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na hunte mumutna in na zangh le na zawng tu hi; komla in, tua hile neak tu tam mama na nei tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vanh lei thei khat in a manham lei hi ci in phun a, tua zawkciang a man a nee zawkna sia kiphatsak pui hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na son sia bang ziam ci in na he le, khamh le suangmanpha te sangin a manpha zaw na khat a nei na hi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khualmi khat ii leiba teng losak tu in kamciam a pia mi mawmaw khat sia ama ii neisate laaksakin a lo dong vaukhamna in koisak khol kul hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thumaan ngawlna taw na nga nate sia an limbel neak bangin diksa tha tu ni hi, ahihang hai ngawlin hun khat ciang, tuate in kamdim senvui baak bang hi tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngaisut piakna pha saang in, zawna na nga tu hi; ngealna om ngawlin ngalsim thawthong heak in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngualngen khat in thuku a keam thei ngei buatu hi. Mihing a kam tamleite kung pan kikeam in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na nu le na pa na tomlaw le na nuntakna sia khuazing sungah meiinn mit bangin bo tu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hauna ol vaial in na nga le nang atu pha ngawl vaial tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngual ii nang tungah hong khialnate thuk kik tu in ngaisun heak in. Topa muang in, ama in a maanin seam tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Topa in a maan ngawl khaikhin le toaisuang a zangh mihingte ensan hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Topa in ih tot tu lampi khensat zo hi; tua ahile bangbangin khat pawpo in ama nuntakna ii zotna sang a tel thei tu ziam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathian tungah piak tu kamciam na vawt ma in, pha tak ngaisun phot in. A zawkciang khuangai tha tu ni hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A ciim kumpipa khat in akua in a maan ngawl seam ziam ci in he tu a, tua pa hesuak ngawlin daan pia tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Topa in khua ngaisut theina le a pha a sia heak theina hong pia hi; eima le eima ih kiphualseal zo bua hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kumpipa khat in thumaan, thukhaikim le a kilawm bangin a uk laiteng a vaangletna kip tu hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khangnote ii thahatna thupi ih sa a, khanghaamte puakkaang ih zakta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khat vevei thuakna haksa khat in, ih nuntakzia hong khealsak hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Topa in luitui luanna lam ol takin a heak bangin kumpipa khat ii ngaisutna uk hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na sep na vawt theampo maan sa tha tu ni hi; ahihang Topa in na tupna laingilte tungah thukhen hi ci in ciamtee in.
  </para>
  <para style="p">
    <verse number="3" style="v" />A maan le ahi tu bangin seam in; tua in sangaw biakpiakna sangin Topa lungdamsak zaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihing seksolte sia amate ii a kihisakna le a kisaktheina in uk hi, tuaciang hisia in mawna ahi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pha takpi ngeal in, tam mama na nei tu hi; na lawplai leih le a kicing na nei ngei buatu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thumaan ngawlna taw na nga hauna bo pal tu a, ahihang thina thaang sung hong tumpui ma in bo ngawl tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing seksolte sia amate ii ngoltolna taw lal uh a, amate in a maan sep tu nial uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mimawte in lampi koai tawn uh hi; a maw ngawlte in a maan seam hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A nge hat zi khat taw inn khat sung teenkhop sangin innkhum tungah teang leang phazaw hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi seksolte in ngilkial andu bangin siatna vawt nuam hi; amate in kuama tungah hesuakna nei ngawl hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A kihisak khat in daan a khak ciangin khuangaisun meal ngawl khat ngawngawn in pil law hi. A ciim khat in ama a kihilna tung panin pilna nga tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thumaan thutang ahi Pathian in, mihing seksolte inn sungah bang piang ziam ci in he a, a seksolte siacipsak tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mizawngte auna aw ngai tu na nial le, hu tu dei a, nangma ii hu ngetna aw hong kizaaksak ngawl tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing khat po in nang tungah hong thin uuk le letsong khat piak ku na taw ama thim tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thukhaikimin a kisep ciang, mihing phate lungdam uh hi. Ahihang mihing ngilote thinkiamsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kilawm ngamtatna pan, a puapial pawpo thina in ngak nginge hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A nuam leilam nuntaknate, sapittui le anlim neak lei nate in nang hong hausak ngeingawl tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihing seksolte in mihing phate tungah thuaksak tu a hanciam ngimna teng, amate tung ma ah theng kik hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A ngenge, a phuphun zi khat taw teenkhop sangin sennealngam sungah teang leang phazaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing ciimte in hauna le nopsakna taw nungta uh hi, ahihang mihing mawmawte in sum a nga pawpo a manlang thei zaza in zangh uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dik in a, thumaan in, tua hile khansau in na nungta tu hi; ngual dangte in hong zakta tu a, ahi tu bangin hong phatvawt tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A pil a thiam ngalkapmang khat in mihing thahatte ii a cin khuapi khat sia la zo hi, tuaciangin amate ii muan khuapi luphungte susia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Buaina taw na kipeal nuam le, na kampau kidawm in.
  </para>
  <para style="p">
    <verse number="24" style="v" />A kihisak mihing khat hong lak ta'n, tua hile a kisathei, a kiphasak le ngual atu a ngaisun ngawl mihing khat kong lak tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nasep tu a nial mihing datham khat in ama le ama kithat hi bek hi;
  </para>
  <para style="p">
    <verse number="26" style="v" />a dei teng a nga natu a ngaisut sia ama nasep hi bek hi. Thumaan thutang khat ahile ngual pia thei a, ngo takin pia hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihing seksolte ii sangaw biakna a piak ciang, a tuanin ngitlo thin taw a pia le Topa in huatsa hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A leilot khat ii tetti panna sia ki um ngawl hi, ahihang thu a ngaisun kaak mihing khat ii kammal sia kisaang hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thumaan thutang mihingte in amate le amate kimuang uh hi; a seksol mihingte in a thiam thei za in a kivawttawm uh kul hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mihingte ciimna pilna, kivakna le thuthuk muna cite sia — Topa in nang hong langpan le, kimanna nei ngawl hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ngalsim natu in siphute na kinging kholsak thei hi. Ahihang ngalzawna hong pia pa in Topa ahi hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Minphatna le hau mamana khat sasang teal tu hi le uhte minphatna teal vun.
  </para>
  <para style="p">
    <verse number="2" style="v" />A haute le a zawngte in hisia nei khawm hi: Amate nii sia Topa ii vawt khop ahi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing khuangaisun theite in ngimna hong pai ciangin mu thei a pial uh hi, ahihang khuangaisun meal ngawl khat sia tua ii sungah tum vacin tu a, a zawkciang kisiik tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Topa ii thu ni vun a, kiniamkhiak vun, tua hile hauna, patoaina le khansauna na nga tu uh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na nuntakna na it le, lamdung ah a kisia mihing seksolte matna thaangte na pial vun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Patang khat ii a nuntakzia tu na hil vun, tua hile a khan tawntungin ciamtee tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mizawngte in sumhaute ii sal ahi uh hi. Sum na pu le leeitopa ii sal na suak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A maan ngawl thaicii na tu uh le siatna hong po to tu hi, tuaciang ngual na zawthawkna uh sia a tawpna hong hi tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Piakna sungah na ngo vun a, na an uh mizawngte na hawm vun. Tua hu in thupha na saang tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A kihisak mihing sia na pial vun, tua hile kam kinialna, kihauna le min kisiatsakna a om nawn buatu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thinsung thianthona le kamthiam paunate zak tu dik na sa le kumpipa ii lawm na hi tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leilot theite ii kammalte maan ngawl hi ci in lakna taw Topa in thumaan thutak sia keamcing hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pasal datham pa in inn veu ah om hi; pusuak leng tawpi in hong man thei tha tu hi ci hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Palngulna sia thaang hi a — Topa thin uukna a thuakte tua thaang sungah awk hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Patangte ii mawmawthuai ngamtatna le bawlpelnate a nei sia a ngeina hi lel hi, ahihang a kilawm bang a, ngoaibul bekna taw amate ngamtat zia tu kihil thei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na hau natu in mihaute tungah letsong na pia a, ahibuale mizawngte na zothaw le nangma zongh na zawng tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai vun, mihing ciimte pauna kong hil tu hi. Amate ii hilciannate kan vun,
  </para>
  <para style="p">
    <verse number="18" style="v" />tuaciang ciamtee in, na zangh kik thei le na lungdam tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Topa na pummuan tu ka dei hi; tua hu in tu in hong son tu khi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang atu in paunak sawmthum kong at zo hi. Tuate sungah heakna le ngaisut pha piaknate om hi,
  </para>
  <para style="p">
    <verse number="21" style="v" />tuaciang tuate in thumaan thutak sia bang tatak ziam ci in hong hil tu hi. Tua zawkciang tuate a zong tu in hong kipaisak ciang a maan thu nong ciapui tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hi thei tang ci in mizawngte tung pan hamphatna la heak vun; thukhenzum ah cimaw in a dingte tung pan hamphatna la heak vun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Topa in amate ii thu sia amate taangin nialsak tu a, amate nuntakna a lauthawn po ii nuntakna kilauthawn tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing thinngam, thin ngeamte ngualtamh in na man heak vun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amate omziate na zui tha tu a, na kikheal kik zo buatu uh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi dangkhat ii leibate losak tu in kamciam pia heak vun.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lo zawk ngawlna khat nei lete na lupna dongin amate in hong laaksak tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na taanghpupite ii ngisuang luite na khiin heak vun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nasep pha tak a, a seam mihing khat hong lak tavun, tuaciang mihing tam mamate sang a phazaw, kumpite kitholpui tu dong a, a kilawm khat kong lak tu hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihing thupi khat taw an nekhawm tu in na to uh ciang, ama sia akua ziam ci in phawk nginge tavun.
  </para>
  <para style="p">
    <verse number="2" style="v" />An na du mama uh zong na kidawm tavun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama hong lui anlimte neak nopin nei leih heak vun; hong aitaana khat po zongh hi thei tha tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hau tu na hanciamna ah nangma le nangma na tha a bo ngawl natu in ciimna a khom na nei in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na sumte sia muvanlai khat a tha hong po in a len bangma in thakhat thu in bo thei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing a iiciilte sabuai ah an na ne heak vun, tua ahibuale zong anlim hong luite hu in duhop neak heak vun.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Tawm beak ne lai in” hong ci kale hong ci takpi hi ngawl thei hi. Ama ii ngaisutna sia ama tatak ma ahi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na neak sa teng na lua kik tu a, na sialpokna theampo a vaal thong hi tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing mawmaw khat sia a khua heak thei natu in na sonpui heak vun; ama in thupi sa thei meal ngawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bangma hunin ngisuang luite na khiin ngei heak vun, ahibuale tangate neisa leitang na sut heak vun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Topa sia amate ii a vaanglian a dal pa hi a, nang hong langpanin amate ii sang panin hong pau tu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na syapa ii hong hilna pha tak nadon in a, na sin thei theampo sin in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Patangte tungah tek tu le pau tu haisaang heak in. A kilawm bang a, a ngoaibul bekna in ama thisak ngawl tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A tatakin ci leang ama ii nuntakna kihun zongh hi thei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tapa awng, nong ciim le ka lungdam mama tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ciim kamte na pau ka zaak ciang ka angtang tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mimawte eang heak in; Topa thasiana sia na nuntak sung na thintoi thu hisak in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuabang hi lete na maivang tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai in ka tapa awng, ciim in a na nuntakzia thuk takin ngaisun in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sapittui tam lei a nete, ahibuale an a bebente taw na kithawl heak in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zukhamte le antuangte zawng vaial tu hi. Anneak le mut sia nasep in na nei le hai ngawlin puansia ngapkaai na silh tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na pa thuson ngai in; ama ngawl taw piang thei ngawl tu ni hi. Na nu a khanhaam ciangin ama thupi na saknate lak in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thumaan thutak, ciimna, sintheina le khua ngaisut theina, hite sia a man piak taak a, ahizong na zuak tu in manpha lei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing thutang khat ii pa in a lungdam natu thu om hi. Tapa ciim khat tungtaang ah na angtang thei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na pa le na nu sia nang huvau in angtang tahen; tua lungdamna sia na nu pia in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tapa awng, hong nadon ta'n a, ka nuntakna sia nangma ettee tu hisak in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pumpi zuak numeite le a paktat numeite sia a lauhuai thi theina thaang ahi uh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amate in ngualsuam phalakte bangin hong ngakin pasal tam mamate thumaan ngawl suaksak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zu tam ne leilam a, a nam thak a ne nuam lai khat kei hong lak ta'n, tuaciang a thinngim mama, khuangaihuai a kisa, ngual buaisak tawntung le lungkim ngawlin a phun tawntung khat kong lak tu hi. A mit san neinoi a, a pial thei tu hi napi liamnate nei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sapittui sia bangza po in san kilkel in, hai sungah tee vasip a, valhsuk ol hikale na ze etsak heak vun.
  </para>
  <para style="p">
    <verse number="32" style="v" />A khuavak ni zing ciang ngul nguu nei ii tuk bang hi na sa tu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />A kiitakhuai lului na mu tu a, na ngaisutna le na kampauna a thiangtho vaset buatu hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuipi tungah teambaw nguih bang, teambaw kilok tung to a, a saangna ah hong veito bang na hi tu hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Hong kivua hi nak tu hi ve aw,” na ci tu a, “Vel zazaan thuak hi vak ing, ahihang ka phawk bua hi. Banghang khangciim thei ngawl khi ziam? Zu tawm ma kisamh lai ing,” na ci tu hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihing tatsiate na eang heak vun a, amate pawlpui tu in na hanciam heak vun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Buaina piansak tu sia amate ngaisut pi hi lel hi; amate a pau simin mihing khat pawpo ii thin nasak tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Innkuante in ciimna le telthiamna doppha in kisa hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Heakna omna munah inn doituamte sia a manpha na hoite taw kizeam hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ciimna in thahatna sangin phazaw hi. Hi hi, heakna sia thahatna sangin thupi zaw hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tawpkhakna ah ngal na do ma in pha takpi na ngeal uh kul a, tuaciang ngaisut piakna pha tam na ngana zui in zawna zongh na nga zaw thei tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ciimkam tepteete sia mihing mawmaw khat ii tel tu in thuk lei hi. Amate in a thupi kikupnate sungah a son tu bangma he ngawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thusia bebek na ngeal le, buaina piangsak pa ci in na minthang tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing mawmaw khat ii ngaisut tupnate sia mawna taw kidim hi. Midangte siatson bebek a kinte ngual in ensan hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Phatmawk hun sungah, na thaneam le a thaneam takpi ma na hi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihing khat sia thumaan ngawl thu taw a kithat tu na mu le ama na hut natu in haisaang heak in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei taw bang kisai ziam ci tha tu ni hi, ahihang Pathian in na thinsung tawngh hong he a, tua tungah thu hong khen tu hi. Ama in nang hong en nginge hi; ama in he hi. Tuaciang na sep babangin ama in thaman hong pia tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tapa awng, khuaitui ne in; khuaitui pha hi. Khuai lu sung a, khuaitui sia na leei tungah thum ahi bangma
  </para>
  <para style="p">
    <verse number="14" style="v" />ciimna sia na thaa atu in pha hi ci in na telthiang tu hi. Ciimna nga in, tua hi le na mai vang tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihing thumaan khat suttol tu a tum, ahibuale a inn a laaksak nuam mihing seksol pa bang hi heak vun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihing thumaan khat in bang tanvei po a puk hial zong tho kik tawntung tu hi; ahizong lalna in mihing seksolte siasak tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na ngal pa lalna a thuak ciangin lungdam heakin a, tuaciang a lutu ciangin lungdam heak vun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngual tungtuan nopna na nei le Topa in hong he tu a, a dei buatu hi; tuasia ciang Topa in amate daan piak awl thei tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihing ngilote hangin na thinngimsak heak in; amate eang heak in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing seksol khat sia a mai bing hi — lamet tu a nei bua hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka tapa awng, Topa thasiana nei in a, kumpipa zongh zakta in. Kumpipa langpanin a leedote taw bangma kipee-awna nei heak in;
  </para>
  <para style="p">
    <verse number="22" style="v" />tuabang mihingte tawmvei no sungin siacip thei hi. Pathian ahibuale kumpipa piansak thei lalna sia na he ziam?
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing ciimte in hite zongh na ci lai hi: Thukhen pa khat atu in doidan nopna a nei sia maan ngawl hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mikhial khat khial ngawl hi a cile ama sia mihing theampo in haamsiat in ensan tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A mawte daan a pia thukhenmangte ahile khangto tu a, ngual phat sonna nga tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A thumaan kam zo kikna in lawm tatak hina lim khat ahi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na lo ante laak pha zo a, na nuntak natu thalaw thei tu in na kimuan mateng, na inn sa heak in a, innkuan phut heakin.
  </para>
  <para style="p">
    <verse number="28" style="v" />A thu om ngawlin ngualdang khat langpanin tetti pang heak in, ahibuale zong ama ii huvau telkhial thei thute phuang heak in.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ama ii kei hong vawt bangin ama tungah vawt tong! Ama thuk tong!” ci heak vun.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pasal datham le a mawmaw khat ii lo sung le sapithuan sungah ka vak hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tua munte sia lingkungte le lopate in khunel hi. A huang uumna phungte zongh cimh zo hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hite ka en a, khua ka ngaisut ciang tua tung panin hi bang heakna khat ka nga hi:
  </para>
  <para style="p">
    <verse number="33" style="v" />na uuk le tawmvei sung mu zok in. Leekoai in tawmvei tawlnga in,
  </para>
  <para style="p">
    <verse number="34" style="v" />ahihang na mut lanin zawnna in hiamh toai phalak khat bangin hong sim tu hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah Kumpipa Hezekiah kumpi zum sung pan ettee in a ki at kik Solomon paunakte om thua lai hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian ii a seal thute hu in ama zatak ih pia hi; kumpipate sia tua thu a thiangin a sontel uh hu in zatak ih pia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kumpipa khat ii ngaisut sia na he ngei bua uh hi; ama ngaisutnate in ei bat zawk ahi ngawl, van saang bang, tuipi thuk bang ahi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngunn sung panin a nin teng a laakkeak ciangin ngunn seakpa in na hoi mama khat piangsak thei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kumpipa kung panin ngaisutna pia mihing siate heam le uhte a kumpi ukna sia thukhaikim thu om hi ci in thang tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kumpipa mai ah na din uh ciangin hong nasia ngaisut natu in hanciam heak vun a, mihing thupi bangin kiheang heak vun.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thupi zaw ngualdang khat atu na dinmun awn a hong kisawl sangin dinmun saangzawna ah kaato a hong kisawl tu sia phazaw hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na muna uh khat taw kisai in thukhenzum theng papaih heak vun. Tetti dang khat in nang muna sia maan ngawl hi ci in hong lak thei le bang law tu ni ziam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na innpaamte taw ngaisut kisik ngawlna khat na nei uh le noma sungah kilemtua tavun a, thuku khat po pualaak se heak vun.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua ahibuale mihing theampo in thuku keamcing thei ngawlte ci in hong he tu a, tua maizumna na pu zo ngei buatu uh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngaisutna khat pha tak a, pualaak theina in ngunn tung khamh taw zep bang ahi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thuakna a nei ngeisa mihing khat ii kidop tu thupiakna a saang nuamte sia khamh khutzungbute ahibuale khamh pha belte taw a kivawt kizepnate sangin phazaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A muanhuai kamtaipa sia anlaak hun nisat laitak tuivot bangin, a sawlpa atu lungpilna ahi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Piak tu kamciam napi a pia ngeingawlte sia nguatui paai ngawl meeikaai le vuite bang ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thin sau takin zolna in a tha khobel kinanna sutham thei a, ngamukte thinsung ngawngawn zo thei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na kisap za sangin a tamzaw khuaitui ne heak vun; a tam lei le hong luasak tha tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na innpaamte mun haw vazut leih heak vun; amate in hong cimtak tu a, hong ngaimaw thei tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A maan ngawl kimawsakna sia, namsau, moltawng, ahibuale thaltang hiam bangin kiitakhuai hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Phatmawk hun sungah a muanhuai ngawl khat muan thaakna sia ha ngawk sa taw an thai nop bang, ahibuale peangbai sa in lampai taw kibang hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A thin kiamcip khat kungah lasakna sia khuasik laitak a puan suusakna, ahibuale a liamma sung ci noisakna taw kibang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na ngalte a ngil a kial le an pia in; a dang a ko le amate ii dawn tu khat pia in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Maizumna taw ama na kaanghsak tu a, tuaciang Topa in thaman hong pia tu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Saksang vui in ngua hong puak bangma ngual ngensiatna in thin uukna hong puak takpi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A nge hat zi khat taw inn khat sungah teenkhop sangin innkhum tungah teang leang phazaw hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A khak belin, a khualana mun pan thupha zaakna in na dangko laitak tuivot neak bang ahi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mihing pha khat in mihing ngilo khat ii thu a zawp ciang ciktui nin ahibuale nguu a kitha tuikhuk khat hong phawksak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khuaitui tam lei sia nang atu pha ngawl hi, tuasia bangma, pokna tam lei nga tu hanciam zongh pha ngawl hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na thin uukna na khaam zo buale luphung taw a ki uum ngawl, a kisim thei khuapi dongdai bangin na cimaw tu hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />A mawmaw khat pok natu sia khaal lai vuuk taak, ahibuale anlaak hunlai nguazu tu bang keakin suak thei ngawl hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thuak tu ma in na kilawm bua nale haamsiatna in bangma hong law zo ngawl tu hi. Tuate in leleang a, tawlngak hun a nei ngawl vacimte taw kibang hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Siphu khat sia saat kul a, laa khat sia kamkhau bul kul a, tuaciang a mawmaw khat sia vel kul hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A mawmawthuai dokna khat na zo le, a dongh pa bangma a mawmaw na hi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A mawmawthuai dokna khat sia a mawmawthuai ma in zo kik lete, a dongh sia in ama kingaisut bangin a pil ngawl hunlam kiphawk tu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing mawmaw khat kamtai in na sawl le, nangma peang a saattan bang na hi thei hi; buai natu a zong na hi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A mawmaw khat in paunak khat a zak theina sia a koncip khat ii a peang a zak thei bang bek hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mawmaw khat po pokna in saili kuung tungah suangtang kikhit bang bek ahi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A mawmaw khat in ciimkam teptee a zak ciang zukham khat ii a khut sung pan ling tangciak a daw nop hong phawksak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thacialpa khat in, hong vak thawthong a mawmaw khat po tha a cial le, a kisai theampo nasak bek hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A mawmaw khat in mawmawt vai khat a nii veina in a vawt kik le a luak sa a ne kik ui khat taw kibang hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A ciim ngawl khat ciim a kisa sia sangin, a mawmawbel khat phazaw lai hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing dathamte banghangin a inn uh pan pusuak ngeingawl ziam? Amate in bang kiita ziam? Tawpite ziam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing dathamte sia a lupna tungah kilum lelet uh hi. Innkha khat pattaa tungah a kihei za sangin, tua pa in a khuala zaw theng ngawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi pawlkhatte sia ama le ama a kam sungah an a kibak tu takpi zongh datham hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A datham mihing khat in, amate ii ngaisut thiamna a lak thei pasal sali sangin pilvangzaw in kingaisun tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang taw kisai ngawl thu khat taw kam kinialna sungah kihelna sia khua sung lampi tawnin ui khat a bil pan zap taw kibang hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihing khat in ngualtheam a, a zawkciang ka ciammuina zam a cite sia, a lauhuai ngalhiam taw a kimai mihing thin amh khat taw kibang hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thing om buale mei mit hi; thu nawnsan om buale kihauna bo hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meihol in meikamte linghsak a, thing in mei kuangsak hi, buaina a piangsakte in kam kinialna kipee suaksak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thu nawnsan sia lim mama hi! Bangza in valh thanuam hi ziam!
  </para>
  <para style="p">
    <verse number="23" style="v" />Na ngaisut takpi teng seal a, thumaan son ngawlna in a man ol leibeal zutna in a kizangh cimbeng taw kibang hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A kihitheamsak mihing khat in ngual a etsatna sia kisialpokna kammalte taw seal hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A kampaunate ahile zaaknophuai tha tu hi, ahihang um heak vun, banghang ziam cile a thinsung ah ki etsatna a dim in om hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A ngual etsatna sia phualseal zo tha tu hikale, mihing theampo in a ngitlo ngamtatnate mu tu hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngual thaang a sia mihingte sia amate ma awk kik vacin hi. Min a cimhsak mihingte sia min in vuknelh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Leilot thu taw ngual thinnat natu a vawt nuam khat sia na etsat kul hi. Thumaan ngawl sonna in siatna simngawl a dang a piangsak bua hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zing ciang thu taw kisai in kisuangtaak khol heak vun. Tua hun le tu kilaklaw bang piang tu ziam na he bua uh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Midangte in poksak vun — khualmite ngawngawn in poksak vun; bangma hunin noma le noma kipok heak vun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawmawt ngamtatna pan a piang thei ngimnate sia suang le sen ii ngitna taw kisontee thei ngawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thin uukna sia tatkha a, lalna piangsak thei hi, ahihang ki eenna sia bangma taw kiteengat thei ngawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing khat ii a khialna hu in a kilangh in hilna pauna sia kei bangma hong awlmawk ngawl hita a, hong ci saang phazaw hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngualtamh khat in hong nasak tha hial zong, a pha piang le a deina hi. Ahihang na ngal khat in a khut taw na liangko pan hong koai ciang — na kikeam vun!
  </para>
  <para style="p">
    <verse number="7" style="v" />Na ngil a va laitakin khuaitui zongh na du buatu hi, ahihang na ngilkial laitakin, ankha khat zongh thum hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A inn pan a puapial khat pawpo sia, a bu sung pan a leang vacim taw kibang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Paaknamtui le sathau namtuite in hong lungdamsak zaw a, ahihang ngimna in na thinnopna bosak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma ngualtamhte ahizong na pa ngualtamhte ahizong mangil heak in. Ngim na nga le na suapuipa kungah hu ngen heak in; na nai a om innpaam khat in a khuala a om na suapuipa sangin hong hu thei zaw hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ciim in, ka tapa awng, tua hile ka lungdam tu hi; kei tungah maw hong zong khat po munah ka zo kik natu om hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihing khuangaisun theite in ngimna hong pai ciangin mu thei a pial uh hi, ahihang khuangaisun meal ngawl khat sia tua ii sungah tum vacin tu a, a zawkciang kisiik tu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khualmi khat ii leiba teng losak tu in kamciam a pia mi mawmaw khat sia ama ii neisate laaksakin a lo dong vaukhamna in koisak khol kul hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zing tuungin na ngualtamh te awnging takin nuksetna kam taw na phong le a haamsiat taw zong na kibang thei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A nge hat zi khat sia nguazuk ni a, mal khakhat veu a taak vakek tui taw kibang hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bangbangin ama thimsak thei tu ni ziam? Vui vak thimsak tu, ahibuale na khut sungah sathau hum zawk tu na hanciam ngei ziam?
  </para>
  <para style="p">
    <verse number="17" style="v" />Thik le thik kitaat a kihiamsak bangin mihingte in khat le khat tung panin heakna nga hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theikung khat pha takin ou lete theinga na ne tu hi. A topa a ou naseam khat sia kipatoai tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tui sung pan hong leng kik na mu sia nangma maitang hi a, tuasia bangma na thinsung ah na mu sia nangma tatak na hi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihingte ii deina sia mithi khua bang ahi hi — a tamzaw lai te atu mun awng om tawntung hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meisa in khamh le ngunn a tak le a theam sit a; mihing khat ii minthanna zongh kisit thei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A mawmawte a thi dektak dongin na vuak bel hang amate mawmawtna lakeak zo ngawl lai tu ni hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na tuute le na khuite na hi theiza in pha tak vak in,
  </para>
  <para style="p">
    <verse number="24" style="v" />banghang ziam cile hauna sia kip ngawl hi. Minamte ngawngawn a tawntungin kip ngawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Taangphawte na tan a, tua zawkciang lo sung pan a piang kik tu taangphawte a khan lan in mualpangh ah lopate na meet hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na tuute pan a piang tuumulte taw puansilhte na vawt thei hi, tuaciang keal pawlkhat na zuak man sum taw leitang na lei thei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A om lai kealte in nangma le na innkuanpuite, tuaciang na naseam numeite atu zongh noai hong pia tu hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihing seksolte sia kuama ii del ngawl bulin tai hi, ahihang a thumaan mihing khat in tawpi bangin hang hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Minam khat a maw ciang ngam uk khat zawkciang khat kilaih tu hi. Ahihang ngam khat sia a pilvang, khuangaisun thei lampuite a nei le, thahat tu a, kip tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mizawngte a zawthawk vawt thunei mihing khat sia lo an a lalsak vui le ngua taw kibang hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thukham na thusim buale mihing seksolte sangah pang na hi hi; ahizong thukham na ni le amate a langpan na hi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing ngilote in thukhaikim sia bang ziam ci in a he bua uh hi, ahihang Topa a biate in pha takin tel uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zawng a, thumaan tu sia, hau a thumaan ngawl sangin phazaw hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thukham a zui khangno khat in mihing pilvang ahi hi. A mannung ngawl ngualtamh a nei pa sia a pa maimawlna ahi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihingte tungah summeet thaakna le ngual duupna taw na hau le na hauna teng mizawngte tungah a thudik khat ii khut sung theng tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thukham na zui buale na thungetnate sia Pathian atu in a ngaimawk huai, a zaak thada suak tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihing thumaan khat a sia vawt tu in na theam le nangma thaang sung ma ah na taaksuk tu hi. Mawbaang ngawlte thaman a pha kipia tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihaute sia amate ciim kisa tawntung a, ahihang ngual ii ngamtatzia a thuk a mu thei mizawng khat sia ciimzaw hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihing phate in ukna za hong nga ciang mihing theampo lungdamin poai khaam uh a, ahihang mihing siate in ngam a uk ciang mihingte buu uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na mawnate seal tu na hanciam le nuntak sungin zawna na nga ngei buatu hi. Mawna pualaak vun a, nusia vun; tuasia ciang Pathian in na tungah hesuakna hong lak tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Topa thu ni tawntung in, tua hile na lungdam tu hi. Na thin na puisak le siatna sung na theng tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A seksol ngamuk khat ii lang ah, mizawngte a hu tu a om bua hi; ama sia tawpi hawk le an zongin a vakkot vompui bangin kiitakhuai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khua ngaisutna pha a nei ngawl ngamuk khat sia a ngilo zawthawk thu taw ngamuk khat ahi hi. Thumaan ngawlna a ngaimaw khat in khuangei mama ngam uk tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihing that pa khat sia ama atu thaankuul a manlang thei za in a to pa ahi hi. Na tho heak vun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thumaan le uhte ngammuangin na om tu uh hi. Na thumaan buale thakhat thu in na puk tu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nasia tak a diang lotho pa in neak tu tam mama nei hi. Hun a bosak thawthong mihingte sia, zawng tawntung tu uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thumaan mihingte in nuntakna kicing taw lungdamin a nungta tu uh hi. Ahihang hau tu kaal na ngakla uh le daan na thuak tu uh hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi doidanna in khialna hi. Ahihang thukhenmang pawlkhat in sumnguk tawmno po deina ngawngawnin a maan ngawlin naseam tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaangsung bek a he mihing duhopte in hau tu ngakla in diang ahiciang, zawnna ii vaat tu hun a he bua uh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khat pawpo pau in hil vun, a zawkciangin ama in sialpokna sangin diksa zaw tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A nu a pate neisa ngukna in mawna in a ngaisun ngawlte sia nguta dangte taw kilamdang ngawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Duhopna in ngimna bek piangsak hi. Topa na muan tu sia phazaw pek hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangma bek ii ngaisutna teng zuina in mawmawtna hi. Ngammuangin om vun a, tuaciang a ciimzawte ii hong hilnate zui vun.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mizawngte pia vun, tua hile bangma hun na kitaangsamh buatu uh hi. A zawngte na en bua uh le mihing tam mama in hong haamsiat tu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihing pha ngawlte in ukna za a nga ciang mihingte buu uh hi. Ahihang amate a za a taak uh ciang a thutang mite in uk kik tu hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nang hong kipau hong kihil simin na thin na puisak vaial le ni khat ni ciang sukcipna na thuak tu a, na lu na phong kik zo nawn buatu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thutang ngamukpa khat hong lak tavun, a lungdam ngam mite kong lak tu hi. A seksol ngamukpa khat hong lak tavun, a thinngim ngammite kong lak tu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ciimna thupi na sa le na pa in nang hangin angtang tu hi. Pumpi zuak numeite tungah, sumzakna sia a mawmawthuai maizakna hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kumpipa in thukhaikim sia thinbot in a nei le a ngam thahat tu a, ahizong ama in sum bekma thinbot in a nei ciang a ngam lalsak tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na ngualtamhte na sialpok le, nangma le nangma thaang kisia na suak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi ngilote amate mawna sungah awk hi, thumaan mihingte ahile lungdam in suakta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing pha khat in mizawngte nga tuakte he a, ahihang mihing seksolte in tuabangte a tel thei bua uh hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngualdangte atu khualna a nei ngawl mihingte in khuapi bup buaisak thei hi. Mihing ciimte in thimsak khipkhep hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi pilvang khat in a mawmaw khat tungah thu a vawt ciang, mi mawmaw sia nui bekin, aw saang taw kam ngaldo pau hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngual thalup tu a ciza ngawl mihingte in a thumaan pawpo ngaimaw hi, ahihang thumaan mihingte in tuabang mihing khat ii nuntakna huu tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihing mawmawte in a thin uukna uh kilanghsak hi, ahihang khuangaisun theite in thinsau in a thin uukna iip hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngamuk khat in a maan ngawl thute a nadon le, a ulian theampo sia leilot theite ahi tu uh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mizawng pa le ama a zothaw pa in hisia nei khawm hi — Topa in amate ngeal sia mittangte neisak khawm hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kumpipa khat in mizawngte nga tu a kilawm thute a panpui le ama in kum saupi ngam uk tu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Patangte atu in hilna le tekna sia pha hi. Patangte in amate uuk bang bekin a khang le a nute maizumsak tu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihing ngilote ngamukna za hong nga ciang khialna lian khang hi. Ahihang a thutangte in tuabang mihingte ii kiamsukna mu tu in a nungta tu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tate tek vun, tua hile a tawntungin ama hu in na angtang tu hi. Amate in maizum natu ahang thu omsak ngeingawl tu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian ii lamlak ngawl minam khat sia thu kinitna om ngawl minam ahi hi. Pathian thukham a zui pa in mihing lungdam ahi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Naseamte sia thusonpuina bek taw na hil na pau thei buatu hi. Amate in hong tel thei tu ahihang hong thusim tuan buatu uh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngaisun ngawlin a pau khat po atu sangin, a ngoai a mawmaw khat atu lametna om zaw hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na naseam khat sia a no panin, a dei theampo na pia le ni khat ni ciang na neisa theampo ama in hong suanthal tu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihing thinngamte in kihauna le buaina tam mama piangsak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kisaktheina in, kiamsukna sung hong then tu a, ahizong na kiniamkhiak le hong kizakta tu hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nguta khat ii kipawl puipa sia a ngal ci phabel ahi hi. Thukhenzum sungah thumaan a son le nguta pa daan kipia tu a, tuabang a son buale Pathian in nguta pa haamsiat tu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Midangte ii nang hong ngaisutnate thin nopmawkin na nei tu sia lauhuai hi, ahizong Topa na muang le ngammuangin na om tu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A kuama po in ngamuk khat ii hong deisakna kithangai tek hi, ahihang Topa tung pan bekin thutang khenna na nga thei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thutangte in mi seksolte ensan a, mi seksolte in thutangte ensan hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hite in Jakeh tapa Agur ii a ciliap huai kammalte ahi hi: “Pathian in kei taw omkhawm ngawl hi, Pathian kei taw omkhawm ngawl hi, tuaciang keima cimaw khi hi.”
  </para>
  <para style="p">
    <verse number="2" style="v" />Keima in mihing khat taw sangin nganhing khat taw ka kibang zaw hi. Mihing khat ii nei tu a kilawm khua ngaisut theina ka nei bua hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ciimna ka sin ngei bua hi, tuaciang Pathian thu bangma heak ka nei bua hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Akua in vantung thu heaknate a cingin nei ngei ziam? A kua in vui sia, a khut sungah man ngei ziam? Tua ahibuale tui sia puanbek taw tun ngei ziam? Tua ahibuale leitung ngamngite phut ngei ziam? Na he le, ama akua ziam? Ama ii tapa sia akua ziam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian in a kamciam theampo keamcing hi. Ama ii huuk tu a zong theampo atu in ama sia lum taw kibang hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama ii son ngeingawl khat pau hi na cile ama in hong teih tu hi, tuaciang a leilotpa na hi hunlam hong lak tu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian awng, ka thi ma in thu nam nii kong ngen hi:
  </para>
  <para style="p">
    <verse number="8" style="v" />leilot ngawl natu in hong keamcing ta'n, tuaciang hau le hong hausak heak in a, zawng le hong zawngsak heak in. Tua ahikom an ka taangsap za bek hong pia ka po in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka kham vaalin an ka nei le, nang hong tulmaw bong kong ci tha tu hi. Ahihang ka zawng le, ka nguta tha tu a, ka Pathian ii min daina kong suaksak tu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Naseamte a topa tungah sonsia ngei heak vun. Tua hu in haamsiatna le ngimna na nga tu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pate haamsiatin a nute a thupi sim ngawl mihing om hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A nin thei za in, nin napi thiangtho a kisa mihing om hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pha mama a kisa mihing om hi — Oh, bangza in amate le amate pha kisa ziam?
  </para>
  <para style="p">
    <verse number="14" style="v" />A zawngte le a kitaangsamhte tung pan ngitlo vai taw a nga thei zaza uh a duup mihing om hi; tuabangin amate nuntakna a zong uh mihing om hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Liit khat in tanu nii nei a, a min sia “Hong pia ta'n!” hi khawm hi. A lungkim ngeingawl, na nam li om hi:
  </para>
  <para style="p">
    <verse number="16" style="v" />Mithite khua, tasel numei, nguatui a kisamh leiko, le a kisumit zo ngawl meikuangte ahi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A pa sia ngual nuizak tu in ciammuina in a nei, ahibuale a nuhuai a zawngsak mihing khat pawpo sia vaciikte in a sa ne le pha hi, tua ahibuale zong a mittangte ngam va-akte in khel le pha hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kei atu a tel hak mama thu li om hi:
  </para>
  <para style="p">
    <verse number="19" style="v" />van ah a leang muvanlai, suangpi tung a vak ngul, tuipi tungah lam khial ngawlin a pai teambaw, le pa khat le numei khat a kidei theina ci teng ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zi thumaan ngawlte ngamtatna in hi bang ahi hi; ama in palngul mawna vawt a, tua zawkciang kibual a, “Ahihang, a maan ngawl bangma vawt nei bong!” ci lai hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Leitung ngawngawn ii dual zawk ngawl na nam li om hi:
  </para>
  <para style="p">
    <verse number="22" style="v" />kumpipa a suak sal khat, a du theampo a nei mi mawmaw khat,
  </para>
  <para style="p">
    <verse number="23" style="v" />pasal a nga a etsat huai numei khat, a tonu omna a suan naseam numei khat.
  </para>
  <para style="p">
    <verse number="24" style="v" />Leitung ah nganhing no mama napi pil citak a pil li om hi:
  </para>
  <para style="p">
    <verse number="25" style="v" />Mitsate; tuate in thaneam mama ahihang a an neak tu uh khaal sungin khol hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Liang lai a, teang ngalhvang nam khat te: tuate in thahat ngawl hi, ahihang liang lai suangpite kawmah teang thei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khaumawte: tuate in kumpipa nei ngawl ahihang hi vadiam in vak hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Innhikte: na khut sungah khat kihum thei napi, kumpi teenna inn sungah kimu thei hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lam a pai uh ciang a etlawm mama na nam li om hi:
  </para>
  <para style="p">
    <verse number="30" style="v" />nganhing sung teng pan a thahatbel le kiitak mama a nei ngawl tawpi;
  </para>
  <para style="p">
    <verse number="31" style="v" />kealtal, aklui pokngai le a mite mai ah a om kumpipate.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kiphatsak natu le a sia ngeal natu za dongin na mawmaw le tawlnga phot in a, khuangaisun in!
  </para>
  <para style="p">
    <verse number="33" style="v" />Noai na sasau le thawbat na nga tu hi. Midang khat ii naak na suu le, chi luang tu hi. Na thin na sosak le ngimna sungah na theng tu hi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kumpipa Lemuel tungah a nu ii a ciliaphuai kampaunate in hi teng hi;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Nangma in ka thungetna hong kizo kikna ka it ka tapa na hi hi. Nang tungah bang kong son tu ziam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na tha nei theampo numei le pa omkhopna huvau in zangh heak in a, na sum theampo numei tungah zangh heak in; tuate in kumpipate susia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hong ngai ta'n, Lemuel awng. Kumpipate in sapittui ne ngawl tu hi, ahibuale, zu thangai leilamna thin nei ngawl tu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zu a neak uh ciang amate in thukhamte mangil in, kitaangsapna a nei mihingte ii nga tuak thute ngaingon uh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zu sia a thi dektak mihingte, a thinngim mamate atu ahi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amate in a zawnna le a khuangaina a makngil thei natu in dawn tahen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amate atu, thu a son thei ngawl mihingte atu in sonsak in. A cimaw theampo ii nga tu a kilawmte sungsia in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amate taangin pau in a, thutang thukhenpa hi in. A zawngte le taangsapna a neite ii nga tuak thute sungsia in.
  </para>
  <para style="p">
    <verse number="10" style="v" />A zaktel mama zi khat mu natu bangza in haksa ziam! Ama in suangmanpha te sangin tam mama in manpha zaw hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pasal in ama tungah muanna nei a, tuaciang a pasal a zawng ngei buatu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tua nu in a nuntak lai tawntungin a pasal tungah phatna vawt a bangma hunin siatna a thuaksak bua hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama in tuumul puante le puannealte takin komla tawntung hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vanh pua teambawte bangin ama in a khuala munte panin inn ah an hong ciapui hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zingsang khuavak ma in tho a, innkuan anneak tu vawtin, a naseam numeite sep tu teng zongh son hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama in leitangte en in lei hi, ama thalaw sa sum taw sapitkungte ciing hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama in naseam hat khat hi a, thahatin lawp hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama in a sep a vawt theampo ii manphatna he a, khuazan dongin naseam hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama in khauzomin ama puan tu tak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A zawngte le a kitaangsamh te ngo takin pia hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Vuuk a kiak hangin a thin a ngim bua hi, banghang ziam cile a innkuanpuite in puan lum nei uh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama in luppha puanvante takin puanneal sandup phate silh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pasal sia mihing tam ii heak, ngammite ii lampui khat ahi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama in puansilh le kawngkhaute vawtin vanhzuakte munah zuak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama hat a, ngual in thasia in mailam atu a patau bua hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama in a pau ciang kamneam le ciimkam taw pau hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama in a tawntungin komla a, a innkuanpuite kisapte vah hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A tate in ama thupi a sakna uh lak a, a pasal in pok hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A pasal in: “Numei tam mamate in zipha vive hi a, ahihang tuate theampo sung pan nang sia a phabel na hi hi,” ci hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngaibanna in hong theam thei a, mealhoina zongh bo thei hi, ahihang Topa a zakta numei khat sia kipok tu hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama sep le vawt theampo tungah minphatna pia vun. Ama in mihing theampo ii zatakna a nga tu in kilawm hi.
  </para>
</usx>
