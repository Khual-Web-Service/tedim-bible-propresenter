<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ZEP" style="id">Zehpani</book>
  <para style="h">Zehpani</para>
  <para style="toc1">Zehpani</para>
  <para style="toc2">Zehpani</para>
  <para style="mt">Zehpani</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yuda Hkawhkam Amon a kasha Yoshia up hkang ai lak htak e, Zehpania hpe jaw ai dai Madu a mungga gaw ndai hku rai nga ai. (Zehpania gaw Hkawhkam Hezekia, Amaria, Gedalia hte Hkushi hku nna hkrat yu wa ai amyu matu mara langai rai nga ai.)
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu gaw, “Ginding aga ting hta nga ai arai yawng ngu na
  </para>
  <para style="p">
    <verse number="3" style="v" />shinggyim masha ni hte dusat yam nga ni yawng, ntsa malen u ni hte hka kata na nga ni hpe ngai jahten kau na we ai. Ngai gaw tara n lang ai ni a hkrat sum ai lam hpe shabyin dat na nngai. Ngai gaw shinggyim masha yawng mayawng hpe shamyit kau na we ai; asak hkrung nga ai ni kadai mung ngam nga lu na n rai, nga nna Madu ngai nan tsun ni ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ngai gaw Yerusalem mare masha ni hte Yuda mung na amyu masha nlang ni hpe ari jaw na we ai. Ngai gaw Bala hpara nawku daw jau ai jahtum na masat dingsat kumla ni hte shi hpe daw jau nga ai maigan htung tara hkan ai hkinjawng ni hpe pyi, kadai n matsing mat lu hkra jahtum kau na mawe ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kadai mung tinang nta ntsa de lung wa nna ajan, shata hte shagan ni hpe nawku nga ai ni hpe ngai jahten kau na we ai. Ngai hpe nawku daw jau ai hte ngai hta ga sadi dung nga na nga nna dagam da ai ni ngai kaw nna htak mat wa nhtawm Molek hpara a mying nsang hta ga shaka la ai ni hpe ngai shamyit kau na we ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai kaw nna kayin mat wa ai ni hte ngai kaw sa du nna hkan nang na loi mi mung n myit ai ni hte shanhte hpe lam woi na matu ngai hpe hpyi lajin ai lam n nga ai ni hpe ngai jahtum kau na mawe ai,” nga nna tsun nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu gaw mungkan masha ni hpe tara tingnyang hta dung nna jeyang na nhtoi ni wa magang ra ai; dai majaw shi a man e asim sha nga nga mu. Dai Madu gaw shi a amyu masha ni hpe hkungga nawng jau ya na matu poi shachyip lajang ya nga ai hte Yuda mung hpe hpya kau na matu gumlau hpyen ni hpe shaga da nga nu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw, “Sat nawng ya ai shani e, du magam ni, hkawhkam kasha ni hte maigan htung hkan ai ni yawng hte hpe ari jaw na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Maigan nawku htung hkan ai ni zawn nawku ai ni hte shanhte a madu ni a nta hpe arung arai lagu, masha sat amu jahpring ya ai ni mahkra hte hpe ngai ari jaw na we ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai Madu gaw, “Dai shani hta e, Yerusalem na Nga Chyinghka lam hta hkrap shabam ai nsen nanhte na lu na ra ai. Dai mare a lawk nnan daw hkan na masha ni a yawn shabam ai nsen hte kawng ntsa hkan nga ai dum nta ni hpe hpya jahten kau ai nsen ni hpe na lu na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hpaga ga ai masha ni yawng si htum mat ma sai majaw, mare a lawu maga de nga ai nanhte gaw dai lam na ai shaloi, hkrap shabam nga myit dai!
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai aten e ngai gaw pyengdin lang let, Yerusalem hpe sawk yu na nngai. Dai Madu gaw lam langai hku shing n rai lam kaga hku nna mi rai rai, lama mi hpe galoi mung galaw na n rai, nga nna shanhte hkum shanhte tsun let tinang dai myit dik nga ai ni hte madu hkum madu kam hpa nga ai masha ni hpe ngai ari jaw na we ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte a sut gan lanep tai mat nna dum nta ni jahten kau ai hkrum na mara ai. Shanhte galaw da ai dum nta ni hta shanhte galoi mung rawng lu na mara ai n rai, sabyi sun hkai sharing da ti mung sabyi ntsin lu lu na mara ai n rai.”
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai Madu a galu kaba ai nhtoi gaw ni wa ra ai; dai gaw grai ni wa ai hte grai lawan du wa nga ai! Dai shani gaw ahkup ahka nga na ra ai, dai sharung shayawt ai nhtoi shani e, share shagan ai hpyenla ni pyi myit htum ai hte marawn jahtau wa na mara ai!
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai nhtoi gaw sindawng kahtet ai nhtoi, ru tsang hte kyindut hkrum ai nhtoi, shingran katsi ai hte marawng marang shabyin ai nhtoi, nsin sin ai hte sin mak mat ai nhtoi, nsin htat ai hte sumwi mung ai nhtoi,
  </para>
  <para style="p">
    <verse number="16" style="v" />bunghku kum ai mare ni hte tsaw ai hpyen dap ni hpe htim gasat let majan pahtau dum nna garu jahtau ai nhtoi rai na ra ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai Madu gaw, “Shinggyim masha ni a ntsa e dai zawn re ai tsin-yam tsindam shangun dat nna, masha hkum shagu gaw myi n mu ai wa zawn lamawm hkawm wa na mara ai. Shanhte gaw ngai hpe yubak galaw ma ai majaw, shanhte a asai hpe ya jang, hka zawn ru pru wa wa nna shanhte a moi mang ni gaw ga ntsa e yat mara taw nga na mara ai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi a sindawng kahtet ai hpe madun ai shani hta, shanhte a ja gumhpraw mahkra hte pyi shanhte hpe hkye la lu na n rai. Shi a masin kahtet ai wan hte mungkan ga ting hpe jahten kau na ra ai. Mungkan ga ntsa e nga ai masha hkum shagu a matu, akajawng sha re ai jahtum nhtoi shabyin dat na ra ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaya n chye ai amyu baw e,
  </para>
  <para style="p">
    <verse number="2" style="v" />nanhte gaw nbung e shapoi kau hkrum ai numhkaw zawn garai n gawt kau hkrum ai hte dai Madu a masin kahtet ai gaw garai n hkru ai sha nanhte a ntsa de garai n du ai hte shi a sindawng kahtet ai hpe madun ai shani garai n du yang, nanhte a n hkru ai lam hpe hpyi nem nga mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Madu a hkang da ai ga matsun ni hpe madat mara let dai lamu ga na shagrit shanem ai amyu masha nlang hte e, Madu hpang de kayin wa marit. Teng man ai amu galaw mu, Dai Madu a man e nanhte hkum hpe shagrit shanem mu. Shi a masin kahtet ai hpe madun dan nna ari jaw na nhtoi kaw na nanhte mahkoi lawt wa lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Gaza mare hta kadai mung ngam nga lu na ra ai n rai; Ashkelon mare gaw katsi katsang shara tai mat wa na ra ai. Ashdod masha ni gaw shani chyingtung e gawt shapraw kau hkrum nna, Ekron gaw shanhte a mare kaw nna gau shapraw kau hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Panglai hkin-gau mayan hku nga ai Hpilisti masha ni e, nanhte gaw dingnye hkrum nga myit dai. Dai Madu gaw nanhte hpe ari jaw na matu daw dan nu ai. Shi gaw nanhte hpe jahten kau na ra ai, nanhte kadai mung ngam nga lu na n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Panglai hkin-gau na nanhte a lamu ga gaw udat shara, sagu rem ni a sum gap shara hte sagu hpung ni a ulawng shara ni tai mat na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Naw ngam nga ai Yuda amyu masha ni gaw nanhte a lamu ga hpe madu la kau ya na mara ai. Shanhte gaw shanhte a sagu hpung ni hpe ushat shayaw nna Ashkelon mare na nta ni hta yup na mara ai. Dai Madu shanhte a Karai Kasang gaw shanhte hte rau nga nga nna shanhte hpe kalang mi bai ngamu ngamai shangun na ra ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chyahtum Chyalai N-gun rawng ai dai Madu gaw, “Moba hte Amon masha ni gaw nye a amyu masha ni hpe n kaw n law rai nna asawng asang di ma ai; shanhte a lamu ga madu la na nga, gumrawng nga ma ai lam, ngai na ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai gaw ahkrung nga ai dai Madu Israela a Karai Kasang teng teng rai nga nngai hte maren, Moba hte Amon mungdan yan gaw Sodom hte Gomora mare zawn jahten kau hkrum na mara ai gaw ngai dagam da se ai. Shanhte gaw jum nhkun hte htani htana katsi katsang shara tai mat nna nam hkrai shim rai na ra ai. Nye a amyu masha ni kaw na naw ngam nga ai ni gaw shanhte hpe kashun kashe hpya sha nna shanhte a lamu ga ni hpe la kau ya na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai gaw Moba hte Amon yan gaw shan a gumrawng gumtawng ai hte myit tsaw myit dap nga nna, Chyahtum Chyalai N-gun rawng nga ai dai Madu a amyu masha ni hpe n kaw n law di ai a majaw nni nkri ari hkrum sha na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu gaw shanhte hpe jahkrit shama dat na ra ai. Shi gaw aga ting na karai ni hpe kaman de shayu kau tawn na ra ai, shaloi masha amyu baw shagu gaw shanhte a shara kaw na shi hpe nawku na mara ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu gaw Ehtiopi masha ni hpe mung si wa na myit dai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw Asuri mungdan hpe shaza kau na matu shi a daru magam n-gun lang wa na ra ai. Shi gaw Ninewe mare hpe shingran katsi ai shara hte hkun hkraw ai zaibru jang shatai kau na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yam nga u hpung ni hte dusat amyu shagu gaw dai shara hta hpum nga na mara ai. Dai hten run mat sai shara na hkuwawt ni hta u hku ni dung nga na mara ai; hkuwawt chyinghka ntsa hkan e mung nga nga na mara ai. Chyinghka hkinbawng ntsa hkan e u hka ni ak nga na mara ai. Dai dum nta gap ai arit hpunpyen ni mung gawng mat na ra ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai mare gaw shi a daru magam n-gun hta gumrawng gumtawng nga nna shim ai mare re, ngu myit aru yu ai a majaw, byin wa na lam rai nga ai. Dai mare masha ni mung shanhte a mare gaw mungkan hta hkik hkam htum ai mare rai nga ai, nga nna myit la nga ma ai. Ya mare dai gaw katsi katsang byin mat nna matse labye dusat ni hpum shanu ai shara tai mat wa sa hka! Dai mare hku lai wa ai ni yawng yu hkrit kajawng nna shingdu de htingnut mat wa na mara ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yerusalem gaw dingnye hkrum nga sai, shi gaw awu asin rai nna gumle gumlau re ai hte dai mare masha ni hpe nan adip arip hkan galaw nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai mare gaw dai Madu a nsen n madat ai hte matsun maroi ga ni hpe mung n hkap la nga ma ai. Dai Madu hta kam hpa ai lam n nga ai sha n-ga, karum la na matu hpyi lajin ai lam mung n galaw ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />De a du salang ni gaw shabam hkawm ai hkanghkyi ni zawn, tara agyi ni gaw hpang jahpawt sha na matu pyi n ngam da lu hkra lawhpa marin ai hte kawsi ai chyahkyawn ni zawn rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Myihtoi ni gaw lit n la ai hte ga kaman sha tsun nhtawm gumle gumlau rai nga ma ai; hkinjawng ni mung, chyoi pra ai shara hpe awu asin di nna shanhte a akyu a matu Karai Kasang a hkang da ai tara hpe manai makai di ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai ti mung, dai Madu gaw dai mare hta ya du hkra nga nga nna, shi gaw teng man ai amu galaw let n shawp n kap ai amu hpe galoi mung n galaw nga ai. Jahpawt shagu n hprai ai sha, shi gaw shi a amyu masha ni hpang de tara malang ai hku shapraw dan nga ai. Rai tim, n teng n man ai masha ni gaw shut hpyit ai amu ni hpe matut galaw nga ma ai hte kaya n chye nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu gaw, “Ngai gaw amyu baw ting hpe la kau na we ai. Shanhte a mare ni hpe ngai jahten kau nna shanhte a mare bunghku ni hte langchyi ni hten ngam nga manu ai. Shanhte a mare ni katsi katsang rai mat nna, mare lam ni hta masha n lai ai hte dai mare e kadai sha pyi ngam nga na ra ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a amyu masha ni ngai hpe hkrit hkungga wa nna, nye a hkang da ai tara matsun ni hpe hkap la wa na mara ai; shanhte hpe ngai sharin shaga ai ga matsun ni hpe galoi mung n malap kau lu na mu ai ngu, ngai myit nawn we ai. Rai ti mung, kade n na yang, shanhte gaw shawoi na hte maren, n hkru n kaja ai hpe shanang galaw wa nga masai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw, “Sha ala nga mu,” ngu nna tsun wu ai. Masha amyu baw ni hpe mara jaw na matu ngai rawt sa wa ai nhtoi du hkra ngai hpe ala nga mu; Masha amyu baw ni hte hkawhkam mungdan ni nye a masin kahtet ai hpe shanhte hkam sha lu na matu shanhte hpe zup hpawng shangun na nga, ngai shatawng shada da nngai. Nye a sindawng kahtet ai masin a majaw ginding aga ting jahten kau hkrum na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Dai hpang, ngai gaw masha amyu baw ni hpe galai kau nna shanhte gaw kaga hpara ni hpe n nawku ai sha ngai kaw chyu akyu hpyi wa na mara ai. Shanhte yawng nye a ga matsun ni hpe madat mara hkan sa na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tsan la ai Ehtiopi mung na shabra kau dat ai nye a amyu masha ni pyi ngai hpang de shagu hkungga sa sak jaw na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte ngai hpe gumlau nga myit ti mung, dai shani e nanhte nye a amyu masha ni kaya kahpa loi mi sha pyi hkrum ra na myit dai n rai; gumrawng gumtawng ai hte myit tsaw myit dap nga ai masha hkum shagu hpe ngai la kau na nngai; nanhte mung ngai hpe nye a chyoi pra ai bum ntsa e galoi mung bai gumlau rawt lu na n rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai gaw shagrit shanem ai masha ni hte matsan mayan re ai masha ni hpe Yerusalem e jahti da nna shanhte gaw karum la lam lu na matu ngai hpang de sa wa na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naw ngam nga ai Israela amyu masha ni gaw kade a ntsa e mung shut hpyit ai amu galaw wa na n rai; masu magaw ga tsun na n rai. Hkalem hkalau ga mung shanhte shakut tsun na ma ai n rai. Shanhte gaw kadai hpe mung n hkrit ra ai sha shim lum ai hte ngamu ngamai wa na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israela amyu masha ni e, kabu gara mahkawn mangoi ai hte jahtau garu nga mu! Yerusalem e, na a myit masin mahkra hte kabu awng sharawng nga u!
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai Madu gaw nanhte a ari ahpri hpe jahkring kau nna nanhte a gumlau hpyen ni yawng hpe la kau ya na ra ai. Dai Madu Israela a hkawhkam gaw nanhte hte rau anga nga ai; Dai shara hta ya kaw nna hkrit tsang shara hpa mung nga na n rai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte gaw Yerusalem hpe ning ngu tsun na aten aten du wa nga sai, “Ziun mare e, hkum hkrit nga et! Na a lata hkum shakya kau nga et!
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai Madu nanhte a Karai Kasang gaw nanhte hte rau anga nga ai; shi a daru magam n-gun gaw nanhte hpe awng padang jaw ya nga ai. Dai Madu gaw nanhte hpe awng sharawng wa nna shi a tsaw ra myit hta, shi nanhte hpe asak nnan jaw ya na ra ai. Shi gaw lusha poi hta shang lawm nga ai masha ni kabu gara nga ma ai zawn,
  </para>
  <para style="p">
    <verse number="18" style="v" />nanhte yawng a ntsa e mahkawn mangoi let kabu gara na ra ai. Dai Madu gaw, “Ngai gaw nanhte hpe jahkrit shama daw dan ai amu hte nanhte a sari jahpoi kau ya ai amu ni hpe ngai jahtum kau ya ni ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aten gaw du wa nga sai! Ngai gaw nanhte hpe dip gamyet sha ai ni hpe ari jaw na nngai; daw hten ai masha ni yawng hpe ngai mawai la na nngai, bawng dung hkrum nga ai ni yawng hpe dum nta de woi wa na nngai. Ngai gaw shanhte a kaya kahpa hpe shagrau sha-a ai hku bai jaw ya na nngai, mungkan ga yawng gaw shanhte hpe shakawn na mara ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aten gaw du wa nga sai! Ngai gaw bra ayai hkawm nga ai amyu masha ni hpe dum nta de woi wa na nngai; Ngai gaw nanhte hpe mungkan ting hta kajai gumhkawng ai amyu shatai na mawe ai nanhte hpe kalang mi bai ngamu ngamai shangun na we ai.” Dai Madu nan tsun nu ai.
  </para>
</usx>
