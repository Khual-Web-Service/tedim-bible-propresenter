<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PSA" style="id">Shakawn Kungdawn</book>
  <para style="h">Shakawn Kungdawn</para>
  <para style="toc1">Shakawn Kungdawn</para>
  <para style="toc2">Shakawn Kungdawn</para>
  <para style="mt">Shakawn Kungdawn</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />N hkru ai masha ni a hpaji daw ai lam hpe ningdang ai ni, yubak kap ai ni a kasi hta n hkan nang ai ni, Karai Kasang hpe jahpoi asawng ai ni hte rau n dung lawm ai ni gaw a nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shingrai na malai, dai Madu a Tara hpe madat mara nna, dai Tara hpe shani shana sharin la ai ni gaw kabu gara ai hpe mu la nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw hka kau e tu nna, shi a aten hta asi si nhtawm alap mung n hkraw mat ai hpun ni hte bung nga ai. Shanhte galaw ai lam shagu awng dang nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai ti mung, n hkru ai masha ni gaw dai zawn n rai; shanhte gaw nbung e shapoi ai numhkaw hte bung nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yubak kap ai ni gaw Karai Kasang a daw dan ai hkrum na mara ai, Karai Kasang a amyu masha kaw nna jahka kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ding hpring ai ni gaw dai Madu kaw nna lam woi ai hte makawp maga la ai hkrum nga ma ai; n hkru ai ni chyawm gaw htum mat wa na mara ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha amyu ni hpa majaw gumlau ai amu maw mawn ma ta? Amyu masha ni shanhte a akyu n pru ai mayun amu ni hpe hpa majaw galaw mayu nga ma ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu hte shi lata san da ai Hkawhkam wa hpe shanhte a hkawhkam ni gumlau nna, mung du ni mung ninghkap na matu jawm mayun bawng nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw, “Shanhte a up hkang ai kata kaw nna, anhte hkum nan lawt lu u ga; shanhte tek jum da ai hpe anhte lamat kabai kau ga,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sumsing lamu hta nga ai shi a tingnyang kaw nna dai Madu gaw shanhte a gawng kya ai yaw shada lam ni hpe mani asawng ya nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai, shi gaw shanhte hpe masin pawt ai hte sadi jaw nhtawm shi a pawt sindawng ai hte shanhte hpe jahkrit mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw, “Nye a chyoi pra ai kawng Ziun ntsa e nye a hkawhkam wa hpe arawng aya ngai ap ya ni ai,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkawhkam wa gaw, “Madu kaning nga tsun ai lam hpe ngai tsun shabra na nngai,” nga nna tsun ai. Shi gaw ngai hpe, ‘Nang gaw nye a kasha rai nga ndai; dai ni, ngai gaw na a kawa tai nga ni ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpyi u, ngai nang hpe masha amyu baw ni hte shanhte a mungdan ni yawng hte hpe ap ya na de ai; lamu ga ting na a rai na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang shanhte hpe hpri sumdoi hte shabya kau nna; nang shanhte hpe ga di bu langai mi hpe zawn ahkyep alep rai mat hkra, gamang kau na ndai,’” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkawhkam ni e, ya ndai sadi jaw ai ga ni hpe madat mu; mungkan ga a du salang ni e, ndai sadi jaw ai lam hpe sharin la mu:
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu hpe hkrit hkungga ai hte daw jau mu;
  </para>
  <para style="p">
    <verse number="12" style="v" />hkrit gari ai hte shi hpe dingnyawm nga mu; shing n rai yang, shi a masin kahtet ai gaw alawan su rawt wa ai hte nanhte gaw akajawng sha si mat na marin dai. Makawp maga la na matu, shi kaw du sa ai ni gaw a lu ma ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, ngai gaw gumlau hpyen law law lu nngai, law law wa ngai hpe gumlau nga ma hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />“Karai Kasang gaw shi hpe karum la na ra ai n rai,” nga nna, shanhte gaw nye a lam hpe tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai ti mung, Madu e, nang gaw hkrithpa shara kaw na tut nawng makawp maga la ai ninggang rai nga ndai, nang gaw ngai hpe awng padang jaw ya ai hte nye a share shagan ai myit masin hpe bai jaw ya nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karum la na matu, Madu hpe ngai shaga nngai; shi ngai hpe shi a chyoi pra ai Bum kaw nna htan ya nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu ngai hpe shana tup makawp maga bau sin nga ai majaw; ngai kaleng taw nna yup lu nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a gumlau hpyen mun sen ni ngai hpe jut man grup wang shinggrup da ti mung, ngai n hkrit nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu e, sa rit! Nye a Karai Kasang e, ngai hpe hkye hkrang la e! Nang gaw nye a gumlau hpyen ni yawng hpe ari jaw ndai, ngai hpe machyi shangun lu ai shanhte a n-gun atsam hpe nang shadaw kau ya nga ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Awng padang gaw Madu kaw nna rai nga ai- Shi gaw shi a amyu masha ni a ntsa e, shaman ya nga u ga law.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai hpe makawp maga ya ai Karai Kasang e! ngai akyu hpyi yang, htan ya e! Ngai ru tsang hkrum ai shaloi, nang ngai hpe karum la nit dai. Ngai hpe ya jang matsan dum ai hte nye a akyu hpyi ai ga hpe na ya e law.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amyu masha ni ngai hpe galoi du hkra n kaw n law di na myit ni? Akyu n rawng ai lam hpe nanhte tsaw ra nga nna, shut hpyit ai lam de galoi du hkra hkan nang na ngu myit ni?
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu gaw ding hpring ai masha ni hpe shi a matu lata san da nu ai hpe dum mu; ngai shi hpe shaga ai shaloi, shi ngai hpe madat ya nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hkrit gari ai hte yubak galaw ai lam hpe jahkring kau mu; nanhte a yupku ni a ntsa e, azim sha kaleng nga ai shaloi, dai lam hpe sung sung myit yu mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu hpe ra n rawng ai shagu hkungga ni hpe nawng jau nna; shi hta kam hpa nga mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />“ Madu e, anhte hpe chyeju grau nna jaw ya mi; matsan dum ai myit hte anhte hpe mada mara ya mi,” nga nna masha law law wa akyu hpyi nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai ti mung, nang ngai hpe jaw ya ai kabu gara ai lam gaw, shanhte lu la na ra ai shanhte a nai mam nsi ni hte sabyi ni yawng mayawng hta grau nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai kaleng taw ai shaloi, ngwi pyaw ai hte ngai yup lu nga nngai; O Madu e nang chyu sha ngai hpe hkum hkum tsup tsup shim ai shara hta tawn da nga ndai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, Nye a ga ni hpe madat ya e, nye a madai ai nsen hpe na ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a Karai Kasang hte Hkawhkam wa e! karum la na matu, nye a hpyi jahtau ai nsen hpe madat ya e, O Madu e, ngai nang kaw akyu hpyi nngai;
  </para>
  <para style="p">
    <verse number="3" style="v" />nang gaw jahpawt manap aten hta nye a nsen hpe na ya nga ndai; jan pru wa yang mung nye a akyu hpyi ga hpe ngai sak jaw nna, na a mahtai hpe ala nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang gaw n teng n man ai amu ni hta awng sharawng ai Karai Kasang n rai nga ndai; na a man e, n hkru ai amu hpa hpe mung nang ahkang jaw ai n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gumrawng gumtawng ai ni gaw na a man e tsap lu ma ai n rai, tara n lang ai masha ni yawng hpe mung nang n ju n dawng nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Masu magaw ga tsun ai ni yawng hte hpe nang jahten kau ndai; kashun kashe hte hkalem hkalau chye ai ni hpe nang matsat nga ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai ti mung, na a galu kaba ai tsaw ra myit a majaw ngai na a nta de sa lu nngai; na a chyoi pra ai Nawku Htingnu hta ngai nawku lu nna nang hpe hkrit hkungga ai hte dingnyawm lu nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, Ngai gaw gumlau hpyen law law lu nga nngai! Na myit ra ai hku, galaw lu u ga, ngai hpe lam woi la e; na a lam hkan lu hkra nye a matu na a lam hpe jasan ya rit.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a gumlau hpyen ni tsun ai hpa lam hpe rai tim, galoi mung n mai kam nga ai; shanhte gaw jahten kau na matu sha, ra sharawng nga ma ai. Shanhte tsun shaga ai ga ni gaw dwi sau nna abawk shatsawm lu nga ma ti mung, dai ni gaw hkrit tsang mai ai hkalem ga ni hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, shanhte hpe daw dan nna ari jaw u: shanhte a maw mawn ai n hkru ai lam hta Shanhte nan hten za mat mu ga. Shanhte a law la ai yubak mara ni hte shanhte nang hpe gumlau nga ma ai majaw, shanhte hpe na a man kaw nna gawt kau u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, nang hta shim lum ai lam mu tam ai ni yawng hte gaw kabu gara lu na mara ai; shanhte gaw tut nawng e, kabu gara let mahkawn shakawn lu nga ma ai. Nang hpe tsaw ra ai ni hpe makawp maga ya nga u; na majaw, shanhte teng teng kabu gara nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, nang gaw na a ga madat mara nga ai ni hpe shaman ya nga ndai; na a tsaw ra myit gaw shanhte hpe ninggang zawn makawp maga ya nga ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, masin pawt ai hte ngai hpe hkum daru et! Na masin kahtet ai hte ngai hpe ari hkum jaw et!
  </para>
  <para style="p">
    <verse number="2" style="v" />O Madu e, ngai hki ba la nga nngai, ngai hpe matsan dum la e law! Ngai tsep kawp kya gumba mat nga nngai majaw ngai hpe n-gun jaw ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a hkum ting mung htum hkra ru tsang hkrum sha nga li ai. Madu e ngai hpe karum la na matu galoi du hkra ala na ngu nga n ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, ngai hpe sa hkye hkrang la e law; na a matsan dum ai hta, ngai hpe si ai kaw nna mawai la e law.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katsan ga e, nang hpe dum nga ma ai n rai; kadai mung, dai shara hta nang hpe shakawn lu ma ai n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai yawn hkyen ai hte hki ba la nga nngai, nye a hkrap agru ai kaw na pru ai myi prwi gaw nye a yupra hpe madi ya nga ai rai nna, nye a baw hkum mung myi prwi ni hte madi nyap nga li ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a gumlau hpyen ni a majaw myi bum mat hkra hkrap nna, ngai gaw adan aleng n mu lu nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />N hkru ai masha nanhte e, ngai kaw nna pru mat wa mu! Dai Madu gaw nye a hkrap ngu hkrap ngoi ai nsen hpe na ya nga ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />shi gaw karum la na matu nye a hpyi jahtau ai nsen hpe madat ya ai hte nye a akyu hpyi ai ga hpe shi htan ya na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a gumlau hpyen ni gaw nhtum nni sum kaya ai lam hpe chye wa na mara ai; shanhte akajawng sha kaming kamawng shaden kau ai hkrum na mara ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu nye a Karai Kasang e, makawp maga la na matu, ngai nang kaw du sa nngai; ngai hpe hkan shachyut ai ni yawng a lata kaw nna, ngai hpe mawai la ai hte hkrang shaw la e;
  </para>
  <para style="p">
    <verse number="2" style="v" />shing n rai yang, shanhte gaw hkanghkyi zawn ngai hpe kawa hpai mat wa na maru ai, ngai hpe hkye hkrang la na, kadai mung n nga ai shara hta, shanhte gaw ngai hpe ashep ashin di gang je kau na mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />O Madu nye a Karai Kasang e, ngai masha langai ngai hpe shut kau ni ai rai yang mung, nye a manang wa hpe gumle gumlau galaw kau ni ai rai yang mung, shing n rai, matu kata nye a gumlau hpyen wa a ntsa e, kashun kashe amu galaw kau ai hte, ndai lam langai ngai hpe ngai galaw hkrup kau ni ai rai yang mung,
  </para>
  <para style="p">
    <verse number="5" style="v" />nye a gumlau hpyen ni ngai hpe hkan shachyut rim nna, shanhte ngai hpe kahtum kadaw di sat kau nhtawm, asak n rawng sai ngai hpe ga ntsa e, kau da nga mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu e, Pawt sindawng ai hte rawt u! Nye a gumlau hpyen ni a sindawng kahtet ai hpe rawt ninghkap u; hprang u, ngai hpe karum la e! Nang hpyi ai gaw teng man rap ra ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai majaw masha yawng mayawng hte hpe, na grup yin e jahpawng da nna; shanhte hpe sumsing lamu kaw nna up hkang nga u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw masha amyu baw yawng hte a tara agyi wa rai nga ndai; Madu e, ngai hpa mara n kap nga nngai hpe nang chye nga ai rai nna, nye a maga de tsap nna tara dara ya e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw ding hpring ai Karai Kasang rai nga ndai rai nna, anhte a myit mang ai lam hte ra sharawng ai lam ni hpe jeyang ya nga ndai. N hkru ai masha ni a tara n lang ai lam hpe jahkring kau nna, mai kaja ai masha ni hpe shagrau kumhpa jaw ya nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang gaw ngai hpe makawp maga ai wa rai nga ai; shi hpe madat mara ai ni hpe shi hkye hkrang la nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang gaw ding hpring ai tara agyi rai nga ai hte tara n lang ai ni hpe tut nawng e, daw dan ya nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte gaw shanhte a lam ni hta n galai shai ai rai yang, Karai Kasang gaw shi a nhtu hpe garang shadai ya wu ai. Shi gaw shi a ndan hpe shachyen nna dai hpe gap na matu jin jin rai nga na ra ai;
  </para>
  <para style="p">
    <verse number="13" style="v" />shi gaw shi a si shangun lu ai laknak ni hpe hta lang nna, ju jahkyeng da ai shi a pala ni hte shading da nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tara n lang ai ni gaw n hkru ai lam hpe kaning rai myit shapraw nga ma ai hpe yu yu mu. Shanhte gaw makyin madut ru tsang lam hpe maw mawn nna, hkalem hkalau lam hpe hkan galaw nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, shanhte gaw kaga ni a matu, mahkam hkam da ai hta; shanhte hkum nan ahkang la nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai shanhte gaw shanhte galaw ai n hkru ai amu hta ari hkrum sha nna, shanhte a kashun kashe re ai amu hta machyi hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi a teng man rap ra ai tara a majaw, Madu hpe ngai chyeju dum nga nngai; Ngai gaw Tsaw Htum ai dai Madu hpe mahkawn shakawn na nngai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu anhte a Madu e, na a galu kaba ai lam hpe mungkan ting hta mu lu nga a hka! Nang hpe shakawn ai ga ni, sumsing lamu ni de du hkra hkrang lung nga ai;
  </para>
  <para style="p">
    <verse number="2" style="v" />dai shakawn ga ni hpe ma kaji ni hte chyu chyu ai ma ngai ni mahkawn ma ai. Nang gaw na a gumlau hpyen ni yawng a lata kaw nna, shim ai hte sim sa nga ndai; nang hpe ninghkap ai kadai hpe mung, nang manga kau nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang hpan tawn da ai lamu hpe ngai mada yu ai shaloi; nang gaw shata hte shagan ni hpe shanhte a shara ni hta tawn da nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mungkan masha ngu ai gaw kadai wa rai nna nang myit du ya nga n ni? Si chye ai wa sha hpe, nang hpa rai n-gaw nwai myit madun nga n ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai tim, nang gaw shi hpe na a npu hprut hku hpan da nhtawm; nang gaw shi hpe hpung shingkang hte arawng sadang ka-up ya nit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang shi hpe hpan tawn da ai arai yawng mayawng a ntsa e, up hkang ai wa tai lu na, ahkang ap ya nit dai; nang gaw shi hpe hpan da ai arai yawng mayawng a ntsa e san da nna;
  </para>
  <para style="p">
    <verse number="7" style="v" />sagu hte dumsu, matse labye dusat ni yawng mung,
  </para>
  <para style="p">
    <verse number="8" style="v" />ntsa malen u ni, nga ni hte panglai kata e rawng ai hkrung kanu ni yawng hte hpe mung, shi a npu hta nang tawn da nit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />O Madu anhte a Madu e, na a galu kaba ai lam hpe mungkan ting hta mu lu nga a hka!
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nye a myit masin mahkra hte nang hpe ngai shakawn nga na nngai; nang galaw dan sai mauhpa amu mahkra hpe ngai tsun dan nga na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a majaw, kabu gara ai hte ngai mahkawn mangoi nga na nngai; Chyahtum Chyalai n-gun rawng ai Karai Kasang e, ngai nang hpe mahkawn shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang dan pru wa ai shaloi, nye a gumlau hpyen ni nhtang mat wa nna; shanhte kadawng taw mat ai hte si mat ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang gaw na a tara dara ai lam hta myit malang ai hte ding man ai wa rai nga ndai rai nna; ngai hpang maga de nang tara jeyang ya nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw tara maigan ni hpe daw dan nna, tara n lang ai ni hpe shamyit kau nit dai; shanhte hpe galoi mung dum sana n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte a gumlau hpyen ni gaw htani htana htum mat masai; nang gaw shanhte a mare ni hpe jahten kau nit dai hte shanhte gaw tsep kawp malap kau ai hkrum nga masai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai ti mung, Madu gaw htani htana hkawhkam wa rai nga ai; shi gaw tara dara na matu, shi a tingnyang hpe lajang da nu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw mungkan ga hpe ding man ai hku up hkang nga nna; amyu baw ni hpe teng man rap ra ai tara hte shi jeyang nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu gaw dip da hkrum ai ni a shingbyi shara rai nga ai; ru tsang hkrum ai aten ni hta shim lum ai shara mung rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu e, nang hpe chye ai ni gaw nang hpe kam hpa na mara ai; nang kaw sa ai ni kadai hpe mung, nang kau da nga ndai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ziun e up nga ai Madu hpe mahkawn shakawn mu! Shi hpa galaw sai amu, amyu baw shagu hte hpe htawn tsun dan mu!
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang gaw nni nkri hkrum sha ai ni hpe dum nga nna; shanhte a hpyi jahtau ai nsen hpe shi malap kau nga ai n rai, shi gaw shanhte hpe shut hpyit ai ni hpe, ari jaw nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Madu e, ngai hpe matsan dum la e law! Nye a gumlau hpyen ni ngai hpe jahkrum ai nni nkri lam ni hpe mu ya e! Madu e, si hkrung si htan kaw nna ngai hpe mawai la e,
  </para>
  <para style="p">
    <verse number="14" style="v" />shaloi, Yerusalem amyu masha ni a man e, ngai rawt tsap lu nna, ngai nang hpe shakawn ai lam yawng mayawng shanhte hpe tsun dan lu na nngai. Nang ngai hpe hkye hkrang la nit dai majaw ngai kabu gara lu na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tara maigan masha ni gaw nhkun htu mu ai hte dai hta di hkrat bang mu ai; shanhte hkam da ai mahkam hta shanhte bai lu nga manu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai Madu gaw shi a ding man ai tara dara lam ni hta shi hkum nan hpe shadan dan nu ai hte; tara n lang ai ni gaw shanhte galaw ai arawn alai hte maren, mahkam hta lu nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tara n lang ai ni hte Karai Kasang hpe nyet kau ai ni yawng a jahtum gaw si hkrung si htan lam rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ra kadawn ai ni gaw tut nawng e, nsawn nsang di hkrum na ma ai n rai; matsan mayan ni a myit mada shara htani htana agrawp kau ai hkrum na ma ai n rai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Madu e, sa rit! Kadai hpe mung nang hpe hkum ninghkap shangun et! Tara maigan ni hpe na a man de woi sa nna, shanhte a ntsa e tara jeyang daw dan ai ga tsun ya u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Madu e, shanhte hpe hkrit kang shangun u; shanhte gaw si mat chye ai shinggyim masha ni chyu rai nga ma ai lam shanhte hpe chye shangun u.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang gaw hpa rai tsan tsan e nga nga n ta? Anhte ru tsang hkrum nga ga ai shaloi nang hpa majaw makoi nga n ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Tara n lang ai ni gumrawng gumtawng nga nna, matsan mayan ni hpe zingri zingrat nga ma ai; shanhte galaw da ai mahkam ni hta shanhte hpe lu shagun u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tara n lang ai masha wa gaw shi a n hkru ai myit marin lam ni hta gumrawng nga nna; lawhpa ai masha wa gaw matsa mawa ga tsun ai hte Madu hpe nyet kau nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tara n lang ai masha wa gaw Madu a lam hpe hpa zawn n nawn nga ai; Karai Kasang n ra ai nga nna shi a myit hta gumrawng nga lu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tara n lang ai wa gaw lam shagu hta awng dang nga ai. Shi gaw Karai Kasang a tara dara ai lam ni hpe n chye na lu nga ai; shi gaw shi a gumlau hpyen ni hpe jahpoi asawng kau nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw, “Ngai galoi mung sum na n rai; ngai galoi mung ru tsang hkrum na n rai,” nga nna shi hkum shi tsun nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a tsun shaga ai ga hta dagam dala, masu magaw hte jahkrit shama ai ga ni hte hpring nga ai; shi gaw n dawng ai hte n hkru ai ga ni hpe tsun na lawan nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw mara n kap ai masha ni hpe sat na lagyim la nga let, kahtawng ni hkan, shi hkum shi makoi nga ai; shi gaw karum la lam n nga ai ru yak hkrum ai ni hpe kin-yu yu nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw hkanghkyi langai zawn lagyim shara hta la nga nhtawm; matsan mayan ni hpe gamu rim la na shi la nga let, shi gaw shi a mahkam hta shanhte hpe rim bang ai hte shanhte hpe tsan tsan de garawt mat wa wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karum la lam n nga ai ru yak hkrum ai ni gaw agrawp taw mat nna; n-gun laba gaw shanhte hpe dang kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tara n lang ai wa gaw, “Karai Kasang nga ai n rai! Shi gaw shi a myi ni hpe di da nu ai hte, ngai hpe galoi mung mu na ra ai n rai,” nga nna shi hkum shi tsun nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, tara n lang ai masha ni hpe ari jaw u! Nni nkri hkrum sha nga ai ni hpe dum nga u!
  </para>
  <para style="p">
    <verse number="13" style="v" />Tara n lang ai masha wa gaw Karai Kasang hpe n kaw n law di lu ai hte, “Shi gaw ngai hpe ari jaw na ra ai n rai,” nga nna gara hku shi hkum shi tsun lu nga a ni?
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai ti mung, ru tsang hte nni nkri hpe nang mu mada nna matsing da nga ndai hte karum la na matu, tut nawng e, jin jin rai nga ndai. Dai karum la lam n nga ai masha wa gaw shi hkum nan nang hta ap nawng shamyet shanat nga nna, nang gaw ra kadawn ai ni hpe tut nawng e, karum la nga ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tara n lang ai hte n hkru ai masha ni a n-gun atsam hpe daw kau ya u; shanhte galaw dan sai shut hpyit amu dai hpe, shanhte bai n matut galaw ai aten du hkra, shanhte hpe ari jaw u.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai Madu gaw htani htana agrin nga ai hkawhkam rai nga ai. tsasam karai ni hpe nawku ai ni gaw shi a lamu ga kaw nna hkoi mat wa na mara ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />O Madu e, grit nem ai ni a akyu hpyi ga ni hpe nang madat ya na rin dai; nang gaw shanhte hpe nden marai jaw ya na ra ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zingri zingrat hkrum ai ni hte jahkrai nmai ni a hpyi jahtau ai nsen ni hpe nang na ya na ndai; nang gaw shanhte a maga de tara jeyang ya ai shaloi shinggyim masha ni gaw hkrithpa lam hpe bai naw shabyin sana n rai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu hta shim nga lu na matu ngai kam hpa nngai. “Ntsa malen u langai mi zawn bum ni hkan pyen hkawm u,
  </para>
  <para style="p">
    <verse number="2" style="v" />hpa majaw nga yang, tara n lang ai ni gaw shanhte a ndan ni hpe shaw nna, kaja ai masha ni hpe shingnip kata kaw nna gap dat na nga, shanhte a pala ni hpe shading da ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Arai yawng mayawng hkrat ga mat ai shaloi, mai kaja ai masha langai wa mi pyi lu galaw ai lam hpa mung n nga nga ai nga nna ngai hpe tsun ai nang gaw kade wa angawk nga n hka!
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw shi a chyoi pra ai Nawku Htingnu hta e, nga nga ai; sumsing lamu hta shi a tingnyang nga nga ai. Shara shagu hkan nga nga ai amyu masha ni hpe shi mada yu nna, shanhte hpa galaw nga ma ai hpe chye nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw kaja ai ni hpe mung, tara n lang ai ni hpe mung maren san jep nna; tara kata ai ni hpe shi a myit masin mahkra hte n dawng nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw tara n lang ai ni a ntsa e, grung nga ai wan n-ga hte hkru nga ai kan wan ni hpe ru jahkrat dat nna, shi shanhte hpe kahtet kang ai nbung ni hte ari jaw mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu gaw ding hpring nga ai rai nna mai kaja ai magam amu ni hpe tsaw ra nga ai; dai hpe hkan galaw ai ni gaw shi a man e shanu nga lu na mara ai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, anhte hpe karum la mi! Mai kaja ai masha langai mung n nga sai; ding man ai masha ni hpe mung loi mi pyi n mu lu mat sai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte yawng hte gaw shada da masu ga tsun ma ai; shanhte gaw shada da abawk ai ga hte hkalem nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu e, abawk ai ga tsun ai shinglet ni hpe shazim kau u! “Anhte a n-gup ga ni hte anhte ra ai lam lu la ga ai, anhte hpa ra sharawng ai lam hpe tsun dan na ga ai hte langai mi mung anhte hpe jahkring da lu na n rai,” nga nna shakawng ai ga tsun ai n-gup ni hpe pat kau ya u.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Rai ti mung, ra kadawn ai ni gaw dip gamyet sha hkrum nga ma ai hte, zingri zingrat hkrum ai ni machyi madai sharung nga ma ai majaw, shanhte marit nga ai shim lam, ngai shanhte hpe jaw ya na matu, ya jang, ngai sa wa na nngai,” nga nna Madu tsun ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu a ga sadi ni gaw kam mai nga ai; dai ni gaw wan htung hta sanit lang shabyawng jen kau sai gumhpraw jet zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tara n lang ai masha ni gaw shara shagu hkan nga nga ma ai; n hkru ai lam hpe kadai mung sharawng awlaw nga ma ai. Madu e, anhte hpe tut nawng e, shim nga lu na matu bau sin ya mi, ndai zawn re ai masha ni a lata kaw nna anhte hpe kyem mazing da mi law.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang gaw galoi aten du hkra ngai hpe malap kau na ngu n ta? Htani htana du hkra kun? Nang gaw galoi aten du hkra ngai kaw na makoi nga na n ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ru tsang ai hpe kade na hkra ngai hkam sharang na rai nga a ta? Nye a myit masin hta yawn hkyen ai lam hpe kade na hkra shani shana jahpring ya na ngu n ta? Nye a gumlau hpyen ni nye a ntsa e awng padang kade na hkra dip la lu na ma ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu nye a Karai Kasang e, ngai hpe mada yu nna htan ya e. Ngai n si u ga, ngai hpe n-gun bai jaw ya e.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Anhte gaw shi hpe dang kau sagaw ai,” nga nna nye a gumlau hpyen ni hpe hkum lu shangun et; Nye a hkrat sum ai lam shanhte hpe hkum yu kabu shangun et.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw na a dinggrin tsaw ra myit hpe kam hpa nga nngai; nang ngai hpe hkye mawai la na rin dai majaw ngai kabu gara nga na nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu e, nang gaw ngai hta mai kaja nga nit dai majaw; ngai nang hpe mahkawn mangoi nga na nngai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Karai Kasang n nga ai,” nga nna angawk ai ni gaw shanhte a myit hta tsun nga ma ai. Shanhte yawng hte gaw myit tsam mat nga ma ai, hkrithpa amu ni hpe, shanhte galaw kau mu ai; dai teng man ai amu hpe galaw na masha kadai mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpaji rawng nna shi hpe nawku daw jau ai ni nga dam ai rai yang, dai hpe mada yu na matu dai Madu gaw sumsing lamu kaw nna shinggyim masha ni hpe gum yu nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai ti mung, shanhte yawng hte gaw shut hpyit ma masai; shanhte yawng hte wa, maren n kaja nga ma ai. Dai teng man ai amu galaw ai masha shanhte hta langai mi mung n nga nga ai, kaja wa, langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu gaw, “Shanhte n chye na ma ai kun? Ndai n hkru n shawp ai amu galaw ai ni yawng hte wa gri magra re ai ni rai nga ma ai kun? Shanhte gaw nye a amyu masha ni hpe hpya sha let nga nga ma ai, ngai kaw galoi mung akyu n hpyi yu ma ai,” nga nna san nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai ti mung, Karai Kasang gaw shi hpe madat mara ai ni hte rau nga nga ai majaw, shanhte hkrit gari wa na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />N hkru n shawp ai amu galaw ai ni gaw myit shagrit shanem ai masha wa a yaw shada ai lam hpe jahten ya ti mung, Madu gaw shi hpe makawp maga da ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Awng padang gaw Ziun kaw nna Israela hpang de du sa wa na matu, ngai kade wa akyu hpyi nga a hka! Madu shanhte hpe kalang mi bai ngamu ngamai shangun ai shaloi Israela amyu masha ni kade wa a lu na ma hka!
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, na a Nawku Htingnu de kadai wa shang mai nga a ta? Na a chyoi pra ai Ziun bum ntsa hta kadai wa nawku daw jau mai nga a ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Lam shagu hta Karai Kasang a ga hpe madat mara ai wa gaw teng man ai amu hpe tut nawng e galaw nga nna; shi tsun ai ga mung teng man ai hte myit malang nga ai majaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />kaga masha ni hpe shatan nhkan ga n tsun nga ai. Shi gaw shi a manang ni hpe shut hpyit ai amu hpa mung n galaw ai hte, shi a htingbu ni a lam shiga n shapoi ya nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw Karai Kasang hpe nyet kau ai ni hpe matsat nga ai; Madu a ga madat mara ai ni hpe shagrau sha-a nga ai. Ga sadi shatup na matu kade wa yak hkra rai ti mung, shi jaw da ai ga sadi ni hpe tut nawng e galaw shatup nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw amyat n la ai sha, hkoi ya ai hte mara n kap ai wa hpe masu ai sakse tai ya na matu mayun kumhpa hpe jaw tim hkap la na wa n rai. Ndai lam ni hpe galaw shadik ai ni kadai mung tut nawng e shim nga na mara ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, Ngai hpe makawp maga la e, Shim nga na matu, ngai nang hpe kam hpa nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Nang gaw nye a Madu rai nga ndai; mai kaja ai arai yawng mayawng gaw nang kaw na hkrai rai nga ai,” ngu nna Madu hpe ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu a kangka ai amyu masha ni gaw kade wa mai kaja nga ma hka! Shanhte hte rau rai nga na gaw nye a pyaw htum ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tsasam karai ni kaw hkan gat ganawng nang ai ni gaw shanhte hkum nan hta ru tsang lam law law hkrum wa na mara ai. Shanhte a nawng jau ai hkungga hta ngai n lawm na nngai, shanhte a karai ni hpe ngai nawku na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, ngai lu ai arai yawng mayawng hte gaw na a rai nga ai. nang gaw ngai hta ra kadawn ai lam yawng mayawng hpe mung jaw ya nga ndai; du na ra ai nye a aten ni gaw na a lata hta rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a matu, na a kumhpaw kumhpa ni gaw kade sha mauhpa rai nga nna; dai ni gaw kade wa kaja nga ma hka!
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi ngai hpe lam woi nga ai majaw, Madu hpe ngai shakawn na nngai; shing rai shana e mung nye a htauli htaula myit gaw ngai hpe shadum jahprang nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu ngai hte rau nga ai hpe ngai tut nawng e adum nga nngai; shi ani sha nga nga ai majaw, hpa mung ngai hpe jahkrit shama lu sana n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw ngai hpe Si du a n-gun atsam kaw nna makawp maga la ndai, ngai nang hpe kangka ai hte daw jau ni ai, shing rai, nang gaw ngai hpe Katsan ga de n kabai kau na rai nga ndai majaw, ngai gaw kabu chyeju dum ai hte tsep kawp shim lum nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang gaw ngai hpe asak hkrung ai lam de woi sa ai lam madun dan na rai ndai; na hpung shingkang gaw ngai hpe kabu gara ai myit hte jahpring ya nna, sharawng awng ai lam htani htana jaw ya nga ai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, teng man ai lam a matu, nye a hpyi nem ai ga hpe madat ya e; karum la na matu, nye a jahtau tsun ai nsen hpe na la ya e! Nye a ding man ai akyu hpyi ga hpe madat ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang gaw ding hpring ai lam hpa rai nga ai hpe chye nga ndai majaw; nye a maga de tsap nna nang tara jeyang na rin dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw nye a myit masin hpe chye ya nga ndai. Shana aten hta, nang gaw ngai kaw du sa nna, ngai hpe akri akrai san jep yu nit dai, ngai hta n hkru ai myit hpa mung n rawng nga ai hpe nang mu ya nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaga masha ni zawn, n hkru ai ga ngai tsun ai n rai; ngai gaw na a hkang da ai ga hpe madat mara nga nngai hte kashun kashe du daw sai hkaw re ai lam ni hta hkan nang kau ni ai n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw na a lam hta tut nawng e hkawm nga nngai; dai lam kaw nna galoi mung n yit yu nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang e, nang ngai hpe htan ya ndai majaw, ngai nang hta akyu hpyi nga nngai. Dai majaw, ngai hpang de kayin wa nna, nye a ga ni hpe madat ya e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a mauhpa tsaw ra myit madun dan nna ngai hpe hkye hkrang la e; na a makau e nga lu yang, ngai gaw nye a gumlau hpyen ni a lata kaw nna shim lum nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tara n lang ai ni a gasat gala ai hte law la ai hpyen ni ngai hpe wang shinggrup nga ai kaw na na a myi sha ni hpe nang makawp maga ndai zawn ngai hpe na a singkaw ni a shingnip a npu e makoi da e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte gaw matsan dum ai myit n rawng ma ai hte gumrawng gumtawng ai myit hte tsun ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai kayin hkawm ai shara shagu hte hta, ya e, shanhte ngai hpe wang shinggrup nga ma ai; ngai hpe gang jahkrat lu na ginjang hpe shanhte sin yu nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte ni gaw hkanghkyi ni zawn ngai hpe ashep ashin di nna, gang amya je kau na matu, gyem ai hte la nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Madu e, sa rit! Nye a gumlau hpyen ni hpe ninghkap nna, dang kau u! Tara n lang ai ni kaw na, na a nhtu hte ngai hpe hkye hkran la e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ndai prat hta shanhte ra mara mahkra hkam la lu ai ni a lata kaw nna, ngai hpe hkye hkrang la e; shanhte a matu, nang mahkawng da ya sai nni nkri lam ni hte shanhte hpe ari jaw u. Dai hpe shanhte a kashu kasha ni alaw ahtam hkam sha mu ga hte matut nna shanhte a shu mashi shu masha ban prat du hkra hkam sha nga mu ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, ngai chyawm gaw shut hpyit ai amu hpa mung n galaw kau nga nngai majaw ngai nang hpe mu lu na ring ngai hte, ngai yup hprang wa ai shaloi, na a hpung shingkang gaw kabu gara ai hte ngai hpe jahpring ya na ra ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang hpe ngai kade wa tsaw ra nga a hka! Nang gaw ngai hpe makawp maga ai wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu gaw ngai hpe makawp maga ai wa rai nna; nye a ngang kang ai hpyen dap shi rai nga ai. Nye a Karai Kasang gaw ngai hpe makawp maga ai wa rai nna, shi hta ngai shim lum nga nngai. Shi gaw ngai hpe ninggang langai mi zawn makawp maga nna, ngai hpe makawp maga ai hte shim hkra bau sin nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai gaw Madu hpe shaga ai hte, shi gaw ngai hpe nye a gumlau hpyen ni a lata kaw na hkye hkrang la nga ai. Madu gaw hpung rawng nga u ga law!
  </para>
  <para style="p">
    <verse number="4" style="v" />Si hkrung si htan a hkrithpa gaw ngai hpe gawan da nna; jahten sharun ai a hka leng gumdin ni nye a ntsa e, taleng nga sai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Si hkrung si htan a hkrithpa gaw ngai hpe gawan da mi ai; lup sung hku gaw nye a matu mahkam hkam da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a ru tsang ai hta, ngai gaw Madu hpe shaga nna; karum la na matu, nye a Karai Kasang hpe ngai shaga we ai. Shi a Htingnu hta, nye a nsen hpe shi na ya nna; karum la na matu, ngai hpyi jahtau ai nsen hpe shi madat ya ni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai, Karai Kasang gaw pawt sindawng ai a majaw, ginding aga gaw gari awam wa nna, bum ni a npawt nhpang ni mung shamu shamawt nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a ladi hku ni kaw nna wan hkut ni pru wa nhtawm, shi a n-gup kaw nna grung ai wan shinglet hte hkru nga ai wan n-ga ni hte pru wa nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw lamu hpe gang je nna yu wa ai hte shi a lagaw npu e, sin mak ai sumwi hte yu wa nu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw singkaw tu ai hkrung kanu a ntsa e jawn nna tin tin pyen sa nga ai; nbung a singkaw ntsa hta e, shi pyen hkawm nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi gaw shi a hkum hpe nsin hte ka-up da nna; htat ai sumwi ni hte hka kaba ni shi hpe gawan shinggrup da nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi a man e nga ai myi hprap kaw na sin tawng hte wan shinglet ni gaw sin htat nga ai sumwi ni hpe ga dinghkren kau nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi, Madu gaw lamu de na mu hpe shangoi dat nga ai; Tsaw Htum ai Wa a nsen hpe na lu nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw shi a pala ni hpe gap dat nna, shi a gumlau hpyen ni hpe shabra kau nga ai; myi hprap ni hpe shanhte hpang de dat dat nna jahprawng kau mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu e, nang gaw na a gumlau hpyen ni hpe daru kau let, masin kahtet ai hte shanhte hpe marawn shabam dat yang, panglai htumpa a htingnyep ni dawng pru wa nna, lamu ga a npawt nhpang ni hpaw malang wa nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu gaw matsaw ntsa kaw na ngai hpe sai la nu ai; shi gaw ngai hpe sung ai hka kata kaw nna gang shaw la nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />N-gun rawng ai nye a gumlau hpyen ni hte, ngai hpe n dawng nga ai ni yawng a lata kaw na shi ngai hpe mawai la nu ai. Shanhte gaw nye a matu nau wa n-gun rawng nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai ru tsang hkrum ai shaloi, ngai hpe gasat ma ai, rai ti mung Madu ngai hpe makawp maga da nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi gaw ngai hpe hkrithpa shara kaw nna karum la nga sai; shi ngai hta awng nga ai majaw, ngai hpe hkye hkrang la nga sai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ding man ai amu hpe ngai galaw ai majaw, Madu gaw ngai hpe shagrau nga ai; ngai gaw mara n kap ai wa rai nga nngai majaw, shi ngai hpe shaman ya nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Madu a tara hpe, ngai hkan nang ni ai, nye a Karai Kasang kaw nna tsan tsan de, ngai kayin mat wa ni ai n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi a tara yawng hte hpe ngai hkan sa ni ai; shi a hkang da ai tara ni hpe ngai n madat kau ai n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ngai mara n kap nga nngai gaw shi chye nga ai; shut hpyit amu galaw ai kaw nna ngai koi kau ni ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai ngai gaw ding man ai amu hpe galaw nngai majaw; shi ngai hpe shagrau sha-a nga ai, ngai mara n kap ai wa rai nga nngai gaw, shi chye nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Madu e, nang hta sadi dung nga ai ni a ntsa e, nang mung sadi dung nga ndai; kup tsup ai ni hpe ra n rawng ai chyeju galaw nga ndai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Myit san seng ai ni hpe chyoi pra ai myit nang madun dan nga ndai, tara n lang ai ni hpe chyawm gaw ninghkap ai myit nang madun dan nga ndai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shagrit shanem ai myit rawng ai ni hpe nang hkye hkrang la nga ndai; rai ti mung gumrawng gumtawng myit rawng ai ni hpe nang shagrit kau nga ndai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Madu e, nang ngai hpe nhtoi jaw ya ndai; nye a nsin hpe mung, nang jahkoi kau ya nga ndai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang nye a gumlau hpyen ni hpe gasat na matu, ngai hpe n-gun atsam jaw ya nga ai; shanhte a dap ni hpe dang kau na, daru magam n-gun mung jaw ya nga ndai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ndai Karai Kasang shi a amu bungli ni kade wa hkum tsup nga a hka! Shi a tsun shaga ai ga ni, kade wa kam mai nga a hka! Shi gaw shi a makawp maga ai hpe hkan tam ai ni yawng a ninggang zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai Madu shi chyu sha Karai Kasang rai nga ai; Karai Kasang chyu sha anhte a dahpran shara rai nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shi gaw ngai hpe n-gun shaja ya ai hte nye a hkrun lam hpe shim lum shangun ai Karai Kasang rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shan nga lagaw gaw ngang ai zawn, shi gaw ngai hpe shangang ya nna; bum ni a ntsa e, ngai hpe shi bau sin makawp maga ya nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi ngai hpe majan a matu hpyen hpaji sharin ya ai; shing rai, ngai gaw ja dik ai ndan hpe lang lu nga nngai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Madu e, nang gaw ngai hpe makawp maga ai hte hkye hkrang la nga ndai; na a n-gaw nwai ai myit gaw ngai hpe galu kaba shangun nga ai, na a daru magam n-gun gaw ngai hpe shim lum shangun nga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Rim hkrum hkyen ai kaw na, nang ngai hpe bau sin la ni ai, ngai galoi mung n kadawng yu nngai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ngai gaw nye a gumlau hpyen ni hpe hkan shachyut nna, shanhte hpe rim da nngai: shanhte hpe ngai shamyit kau ai aten du hkra, ngai hkring nga ai n rai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ngai shanhte hpe adup kadawng dat ai hte shanhte n rawt lu ma ai; shing rai shanhte gaw nye a man e, sum mat ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nang ngai hpe majan a matu n-gun jaw ya nga ndai; nye a gumlau hpyen ni a ntsa e, awng padang lu shangun nga ndai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang gaw nye a gumlau hpyen ni hpe ngai kaw nna jahprawng kau shangun ya ndai; ngai gaw ngai hpe n dawng ai ni hpe shamyit kau nngai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Karum la na matu, shanhte jahtau ma ti mung, shanhte hpe kadai mung n hkye la nga ai; shanhte gaw Madu hpe shaga ti mung, shi htan ya nga ai n rai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ngai gaw shanhte hpe adup mani kau mawe ai, shing rai, shanhte gaw nbung e shapoi kau ai ga nhpu zawn tai mat ma ai. Nmaw lam ni a ntsa e taw ai hkumpup ni hpe zawn, ngai shanhte a ntsa e, kabye anut nga nngai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nang gaw ngai hpe gumlau masha ni a lata kaw nna hkrang shaw la nit dai, amyu baw ni a ntsa e, up hkang ai wa, nang ngai hpe shatai nit dai; Ya chyawm gaw, ngai n chye ai amyu masha ni nye a mungdan masha ni tai wa nga masai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Maigan masha ni nye a man e, dingnyawm nga ma ai; ngai tsun ai ga hpe na ma yang shanhte madat mara ma ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shanhte gaw shanhte a share shagan myit nden mat mat nna; shanhte a hpyen dap kata ni kaw na, hkrit gari let pru wa ma ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dai Madu gaw ahkrung nga ai law! Ngai hpe makawp maga ai wa gaw a lu u ga law! Ngai hpe hkye hkrang la ai Karai Kasang gaw galu kaba nga ai hpe htawn tsun mu.
  </para>
  <para style="p">
    <verse number="47" style="v" />Shi gaw nye a gumlau hpyen ni a ntsa e, dang lu na awng padang ngai hpe jaw ya nga ai; nye a npu e, amyu baw ni hpe shi ap ya ni ai
  </para>
  <para style="p">
    <verse number="48" style="v" />hte nye a hpyen ni a lata kaw na, ngai hpe hkye hkrang la nga ai. Madu e, nye a gumlau hpyen ni a ntsa e, ngai hpe awng padang jaw ya nit dai hte kashun kashe du daw sai hkaw shangun ai masha ni a lata kaw na nang ngai hpe makawp maga la nga ndai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shing rai, ngai gaw nang hpe amyu baw ni a ka-ang e, shakawn nngai; ngai nang hpe mahkawn shakawn nga nngai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Karai Kasang shi a hkawhkam wa hpe kaba la ai awng padang jaw ya e; lata san da sai Dawi hte shi a aru arat ni hpe dinggrin tsaw ra myit htani htana madun dan nga ai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sumsing lamu gaw Karai Kasang a hpung shingkang hpe kade wa san pra ai hku hpaw shaleng da nga a hka! Dai gaw shi galaw da sai amu hpe kade wa dan leng ai hku madun dan nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Lani hte lani shi a hpung shingkang hpe shana ya nna; lana hte lana dai lam hpe kahtap tsun dan nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />N-gup aga hte n shaga ai sha, hpa nsen mung n na lu nga ai;
  </para>
  <para style="p">
    <verse number="4" style="v" />rai tim, shanhte a mungga gaw mungkan ga shara shagu de chyam bra mat wa nna mungkan ting dai mungga hpe na lu nga ai. Karai Kasang gaw jan a matu lamu ntsa e nta langai gap da ya nu ai;
  </para>
  <para style="p">
    <verse number="5" style="v" />shing rai, hkungran na matu kabu gara ai hte pru sa wa ai la nnan langai mi zawn mung, ginsup ninghkrin langai mi kagat shingjawng na matu, myit katu wa nna pru wa ai wa zawn mung, ajan gaw jahpawt manap e pru wa nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw lamu maga mi de nna pru wa nhtawm maga mi de dinghkren du nga ai. Hpa mung shi a kang kahtet ai kaw na lawt lu nga ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu a tara gaw hkum tsup nga ai; dai gaw n-gun atsam ningnan jaw ya nga ai. Madu a hkang da ai ga ni teng man kam ging nga ai majaw, dai tara n lu ai ni hpe hpaji byeng-ya jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu a tara ni gaw teng man nga nna, dai hpe hkan sa madat mara ai ni kabu gara nga ma ai. Madu a hkang da ai tara ni gaw ding man nga ai rai nna, myit masin hpe chye na shangun nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu hpe hkrit hkungga ai lam mai kaja nga ai rai nna, dai gaw htani htana agrin nga na ra ai. Madu a tara dara ai lam teng man nga ai rai nna, dai gaw tut nawng e tara rap ra nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai ni gaw ja jet hta grau nna ra sharawng mai nga ai hte lagat jahku jet hta grau dwi nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai ni gaw na a shangun ma rai nga ai ngai hpe machye machyang hpaji jaw ya e; ngai mung dai lam ni hpe hkan sa madat mara ai majaw, shagrau sha-a ai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tinang nang a shut ai lam ni hpe kadai wa mung n mu lu nga ai; Madu e, makoi magap da ai yubak mara kaw na mung, ngai hpe hkrang shaw la e!
  </para>
  <para style="p">
    <verse number="13" style="v" />Myit shadang ai yubak mara ni kaw na mung, ngai hpe shim hkra bau sin ya e; dai ni gaw ngai hpe n up lu mu ga. Shing rai, ngai gaw hkum tsup wa nna n hkru ai yubak kaw na mung lawt lu na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nye a shingbyi shara hte nye a hkye hkrang la ai Madu e, nye a n-gup ga ni hte nye a sumru ai lam ni gaw na a man e sharawng awng nga u ga law.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nang ru tsang hkrum nga ai shaloi, dai Madu gaw nang hpe htan ya u ga! Yaku a Karai Kasang gaw nang hpe makawp maga nga u ga!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi nang hpe shi a Htingnu kaw nna karum ai lam shangun dat u ga; Ziun bum kaw nna nang hpe karum ai lam jaw dat u ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a nawng jau ai hkungga ni yawng hte hpe shi hkap la u ga; na a shagu hkungga yawng hte hpe mung ra sharawng nga u ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang ra sharawng ai hpa hpe rai tim, shi nang hpe jaw ya u ga; na a yaw shada ai lam yawng mayawng hte hpe awng dang shangun u ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai, anhte gaw na a awng padang a majaw, kabu jahtau nga na ga ai; anhte a Karai Kasang hpe shakawn kungdawn ai hte na a awng padang ninglaw hpe masat poi galaw na ga ai. Na a hpyi lajin ai lam yawng mayawng hte hpe mung Madu htan ya nga u ga law.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu shi lata san da sai hkawhkam wa hpe awng padang ninglaw jaw ya nga ai lam, ya ngai chye ni ai; shi gaw shi a chyoi pra ai sumsing lamu kaw nna shi hpe htan ya nga ai hte shi a daru magam n-gun hte shi hpe hkik hkam ai awng padang ninglaw lam ni jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nkau mi shanhte a majan leng ni hte bai nkau mi shanhte a jawn gumra ni hpe kam hpa nga ma ai; rai ti mung, nanhte gaw anhte a Madu Karai Kasang a daru magam n-gun hpe kam hpa nga ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte ahtu ai hte kadawng mat wa ma ti mung, anhte rawt nna ngang ngang tsap nga lu na ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, hkawhkam wa hpe awng padang ninglaw jaw ya u; anhte shaga ai shaloi, anhte hpe htan ya mi law.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang gaw hkawhkam wa hpe n-gun atsam jaw ya nit dai majaw, shi kabu gara nga ai; nang gaw shi hpe padang ninglaw lu shangun ndai majaw shi kabu gara nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a myit ra sharawng ai hku, nang lajang ya nit dai; shi a hpyi lajin ai lam ni hpe mung nang htan ya nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw galu kaba ai chyeju ni hpe gun nna shi kaw sa ndai; shi a baw hta ja janmau nang gup ya nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw asak hpyi nu ai hte dai hpe nang jaw ya nit dai; dai gaw prat galu ai hte htani htana asak rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang karum la ai a majaw, shi a hpung shingkang galu kaba nga ai; nang shi hpe gumhkawng ai hte arawng sadang jaw ya nit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a chyeju ni gaw shi hte rau htani htana a nga nga ai; na a hpung shingkang mung shi hpe kabu gara ai hte jahpring ya nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hkawhkam wa gaw Chyahtum Chyalai n-gun rawng ai Madu hpe kam hpa nga ai; Madu a dinggrin tsaw ra myit a majaw shi tut nawng e shim lum nga na ra ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hkawhkam wa gaw shi a gumlau hpyen yawng mayawng hte hpe rim la na ra ai; shi hpe n dawng ai masha shagu hte hpe mung shi rim kau na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi dan pru wa ai shaloi, kang kahtet ai wan gaw arai ni hpe hkru kau ai zawn, shi gaw shanhte hpe shamyit kau na ra ai. Madu gaw shi a masin kahtet ai hte shanhte hpe mayu kau nna; wan mung shanhte hpe hkru kau na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte a matu mara ni langai mi mung hkrung nga lu na mara ai n rai; hkawhkam wa mung shanhte yawng hte hpe sat kau na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw shanhte a yaw shada ai lam ni hpe galaw nhtawm; n hkru ai hku shi hpe maw mawn ma ti mung, shanhte awng dang wa na mara ai n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw shi a ndan pala ni hte shanhte hpe gap dat na ra ai; shanhte hpe kayin hprawng mat wa shangun na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Madu e, na a galu kaba ai n-gun atsam a majaw, anhte nang hpe shakawn ga ai! Anhte gaw na a daru magam n-gun atsam hpe mahkawn shakawn nga na ga ai law.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Karai Kasang e, nye a Karai Kasang e, nang hpa rai ngai hpe kau da nga n ta? Karum la na matu, myit chyum myit htum hte ngai hpyi jahtau ni ai, rai ti mung, ya du hkra, dai lam n du nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a Karai Kasang e, shani e, ngai nang hpe shaga ti mung; nang n htan ya ndai; shana e shaga ti mung, ban sa ai lam ngai n lu nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai ti mung, nang gaw Chyoi Pra ai Wa zawn tingnyang hta dung nga ndai; Israela amyu masha ni e shakawn kungdawn hkrum ai wa mung rai nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte a kaji kawa ni gaw nang hta kam hpa nga ma ai; shanhte nang hpe kam hpa nga ma ai hte maren nang shanhte hpe hkye hkrang la nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw nang hpe shaga mu ai hte, hkrithpa shara kaw nna lawt lu nga masai; shanhte nang hpe kam hpa manoi manat nga ma ai hte myit daw myit hten nga ma ai n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rai ti mung, ngai gaw masha langai mi n rai mat ni ai; latung shingtai langai mi rai nga nngai, masha shagu e n kaw n law re ai hte matsat kau ai hkrum nga nngai!
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai hpe mu ai ni yawng hte gaw ngai hpe mani asawng nga ma ai; shanhte gaw shanhte a shinglet ni hpe shaw dan nhtawm baw ni hpe kanga dan nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Nang gaw Madu hpe kam hpa shamyet shanat nga ndai, nang hpe shi hpa majaw n hkye la na rai wu ni? Madu gaw nang hpe ra sharawng ai rai yang, shi nang hpe hpa majaw n karum ai nga na rai wu ni?,” nga nna shanhte tsun ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw ngai hpe shangai wa ai shani kaw nna shim lum ai hte bau sin da ai wa nan rai nga ndai, Ngai ma chyangai naw rai nga yang, nang ngai hpe shim lum ai hte bau maka dat nit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai gaw shangai wa ai shani kaw nna nang hta kam hpa shamyet shanat nga nngai; nang gaw tut nawng e na, nye a Karai Kasang rai nga nit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai hpe hkum jahka da et! Ru tsang gaw ni nga ai, karum la na matu langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gumlau hpyen law law ni gaw ngai hpe usu ni zawn wang gawan da mi ai; Bashan ga na matse ai usu ni zawn shanhte ngai hpe shinggrup da mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte gaw hkanghkyi ni zawn, n-gup ni hpe mahka nna; shabam ai hte ngai hpe amya je nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ga ntsa e, hka hpe ru kau ai zawn, nye a n-gun hkoi mat sali ai. Nye a nra hkrihkraw ni mahkra kashai mat sai, nye a myit masin mung shabyawng da ai gitbaw zawn rai nga li ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nye a yuhkraw gaw ga nhpu zawn hkraw mat nna; nye a shinglet nye a gumra hta kap mat nga ai. Nang gaw ngai hpe ga nhpu hta si na matu tawn kau da nit dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />N hkru ai masha hpung mi, ngai hpe wang gawan da nna; gwi wunawng mi ngai kaw htim sa wa ai zawn shanhte ngai kaw htim sa wa ma ai; shing rai shanhte gaw nye a lagaw lata ni hpe gang je nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a nra ni yawng kra dawng taw nga sai, nye a gumlau hpyen ni ngai hpe azi yu nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte gaw nye a bu hpun palawng a matu hpai da da ma ai; shanhte shada da garan la nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Madu e, ngai hte hkum tsan nga et! Ngai hpe mawai la na tin tin sa rit!
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai hpe nhtu kaw na hkrang shaw la e; gwi ni kaw na, nye a asak hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ndai hkanghkyi ni kaw na ngai hpe mawai la e; ndai matse labye usu ni a man e, ngai gaw karum la masha n nga ai hte garen gari hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang hpa galaw dan sai lam, nye a amyu masha ni hpe tsun dan na nngai; shanhte a zuphpawng hta ngai nang hpe shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />“ Madu a shangun ma ni e, shi hpe shakawn mu! Yaku a aru arat ni e, shi hpe shagrau sha-a nga mu! Israela amyu masha ni e, shi hpe nawku daw jau mu!
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi gaw matsan mayan wa hpe n gawn n sawn di ai n rai, shanhte a nni nkri hpe n sawn n sang di ai n rai; shi shanhte kaw na kayin mat wa ai n rai, rai ti mung, karum la na matu shanhte shaga yang, shi htan ya nga ai.”
  </para>
  <para style="p">
    <verse number="25" style="v" />Law la ai shawa hpawng hta, nang hpa galaw da sai lam hpe ngai shakawn nga na nngai; nang hpe nawku daw jau nga ai ni a man e, ngai ga sadi jaw da sai shagu hkungga ni hpe ngai nawng jau na nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Matsan mayan masha ni gaw shanhte ni ra ai made, sha lu na mara ai; Madu kaw du sa ai ni shi hpe shakawn na mara ai. Shanhte gaw htani htana ngamu ngamai nga mu ga law!
  </para>
  <para style="p">
    <verse number="27" style="v" />Amyu baw ni yawng hte gaw Madu hpe dum na mara ai. Mungkan shara shagu de na masha ni shi kaw kayin wa na mara ai; Masha amyu baw yawng hte mung, shi hpe nawku daw jau na mara ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Madu gaw hkawhkam rai nga ai, amyu baw shagu hte hpe shi up hkang nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Gumrawng gumtawng ai masha yawng hte gaw shi hpe dingnyawm wa na mara ai; si chye ai masha yawng hte mung shi a man e, dingnyawm wa na mara ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Du wa na ban prat masha ni gaw shi hpe daw jau na mara ai; du wa na ban prat du hkra, dai Madu a lam hpe masha ni tsun kajai wa na mara ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Garai n shangai ai masha ni hpe, “ Madu gaw shi a amyu masha ni hpe hkye hkrang la sai,” nga nna tsun dan na mara ai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw sagu rai nga ai ngai hpe rem ai wa rai nga ai; ngai hta ra kadawn ai lam yawng mayawng hpe ngai hkam la lu nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsit lali ai tsingdu pa layang ni hta shi ngai hpe ban sa shangun nna; sim sa san tsawm ai hka nawng de shi ngai hpe woi sa wa ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw ngai hpe n-gun atsam ningnan jaw ya nga ai. Shi ga sadi jaw da sai hte maren, ding man ai lam ni hta shi ngai hpe lakawn wa nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sung htum ai nsin hta ngai lai hkawm mat wa ti mung; nang ngai hte rau nga nga ndai majaw, Madu e, ngai hkrit na nngai n rai. Hpa majaw nga yang, na a sagu rem daw hkrawng hte sumdoi gaw ngai hpe makawp maga ya nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a gumlau hpyen ni yawng ngai hpe mu mada lu ai shara hta; nye a matu sha ku nang lajang da ya nga ndai. Nang gaw ngai hpe shagrau sha-a hkrum ai manam langai mi hpe zawn hkalum la nga ndai, nye a gawm hpe nten dem rai hkra jahpring ya nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a mai kaja ai lam hte tsaw ra myit gaw nye a asak prat tup hta ngai hte rau nga nga na ra ai gaw ngai chye nga nngai, na a nta gaw prat dingsa na nye a shanu shara tai na ra ai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ndai mungkan hte dai hta nga ai arai yawng mayawng hte gaw Madu a rai nga ai; Aga hte de a ntsa e nga ai arai yawng mayawng mung shi a rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ginding aga a kata, sung ai hka ni a ntsa e, dai hpe shi gaw da nna de a npawt nhpang ni hpe nammukdara kata sung ai shara ni hta jahkrat tawn da nga sai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu a bum de lung lu na ahkang kadai wa lu nga a ta? Shi a chyoi pra ai Nawku Htingnu de kadai wa shang lu nga a ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Sat lawat hte myit sawn ai lam hta san seng ai ni, hpara sumla ni hpe n nawku ai ni n teng n man ai ga sadi ni hpe n jaw ai ni rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu shanhte hpe shaman ya nna, shanhte hpe hkye hkrang la na ra ai; Karai Kasang gaw shanhte hpe mara n kap ai ni ngu nna tsun na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai zawn re ai masha ni gaw Karai Kasang hpang de sa ai ni rai nna, Yaku a Karai Kasang man e, du ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mare chyinghka ni hpe hpaw malang da mu, prat dingsa na chyinghka ni hpe hpaw mu; magrau grang ai hkawhkam wa shang wa na ra ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai magrau grang ai hkaw hkam wa gaw kadai rai nga a ta? Shi gaw n-gun atsam hte n-gun chyalai rawng ai wa hte majan hta awng padang ninglaw lu ai Madu rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mare chyinghka ni hpe hpaw malang da mu; Prat dingsa na chyinghka ni hpe hpaw mu; magrau grang ai hkawhkam wa shang wa na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai magrau grang ai hkawhkam wa gaw kadai rai nga a ta? Awng padang lu ai Madu -Shi gaw galu kaba ai hkawhkam wa rai nga a hka!
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, nye a akyu hpyi ai ga hte nang hpe nawng jau nga nngai;
  </para>
  <para style="p">
    <verse number="2" style="v" />nye a Karai Kasang e, nang hpe ngai kam hpa nga nngai. Kaya kahpa sum mat ai kaw na ngai hpe hkye hkrang la e; nye a gumlau hpyen ni hpe awng padang hte hkum kabu shangun nga et!
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang hpe kam hpa ai ni hta sum ai lam n hkrum nga ai; nang hpe gumlang ai ni a ntsa e chyawm gaw tin tin du nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />O Madu e, na a lam ni, ngai hpe sharin ya e, dai lam ni, ngai hpe chye shangun e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a teng man ai lam hte maren, asak hkrung nga lu na matu ngai hpe sharin ya e, nang gaw nye a Karai Kasang rai nga nna ngai hpe hkye hkrang la ai wa rai nga ndai majaw, ngai nang hta tut nawng kam hpa nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />O Madu e, chyaloi nhkoi kaw nna nang madun dan nga sai na a matsan dum ai myit hte dinggrin tsaw ra myit hpe adum nga u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a ram prat na shut hpyit ai lam ni hte yubak mara ni hpe, raw dat kau ya e. Madu e, na a dinggrin tsaw ra ai myit hte mai kaja ai myit hta ngai hpe adum nga e law!
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu gaw ding hpring ai hte mai kaja ai wa rai nga ai majaw, yubak kap ai ni hpe shanhte hkan sa ra ai lam, shi sharin ya nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Teng man ai lam hta shagrit shanem ai ni hpe shi woi lakawn wa nna; shi a myit ra ai lam shanhte hpe sharin ya nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a ga shaka hpe kyem da nna, shi a hkang da ai ga yawng hte hpe madat mara ai ni hpe, sadi sahka ai myit hte tsaw ra myit hte shi lam woi nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu e, na a ga sadi hpe shadik shatup nga u, nye a yubak ni hpe mung raw dat kau ya e; kaning rai nme law, dai hte gaw law la nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu hpe madat mara ai ni gaw shanhte hkan sa ra ai lam ni hpe shi kaw nna sharin la na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte gaw tut nawng e ngamu ngamai wa nna shanhte a kashu kasha ni mung dai lamu ga hpe madu lu na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai Madu gaw shi a ga madat mara nga ai ni a jinghku rai nga nna shi a ga shaka shanhte hte shagrin da nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Karum la na matu, Madu hpe ngai aten shagu mada nga ai rai nna, shi ngai hpe hkrithpa shara kaw nna mawai la nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu e, ngai gaw garen gari hkrum nga nngai hte n-gun kya nga nngai majaw; ngai hpe mada mara ya nna, matsan dum la e law.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a myit ru myit tsang ai lam ni hpe hkyamsa jaw ya e, ru tsang lam yawng mayawng kaw na ngai hpe hkye hkrang la e law.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a myit ru myit tsang lam hte nni nkri lam ni hpe myit sawn ya e, nye a yubak ni yawng hte hpe mung dat kau ya e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai hta gumlau hpyen ni kade law nga ai hpe mu ya e; shanhte ngai hpe kade wa n dawng nga ma ai hpe mung chye ya e.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai hpe makawp maga ai hte hkye hkrang la e; ngai hpe hkum sum shangun nga et. Shim lum nga na matu, nang kaw ngai sa du nngai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang hpe ngai kam hpa nga nngai majaw, nye a mai kaja ai hte myit malang ai gaw ngai hpe bau sin nga u ga.
  </para>
  <para style="p">
    <verse number="22" style="v" />O Karai Kasang e, na a amyu Israela masha ni hpe shanhte a ru tsang ai lam yawng kaw nna hkye hkrang la u law!
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, teng man ai lam hpe ngai galaw nna nang hta tsep kawp kam hpa nga nngai majaw ngai hpe mara n kap ai wa ngu nna htawn shana ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu e, ngai hpe dinglik yu nna chyam yu et, nye a myit ra ai lam ni hte myit sawn ai lam hpe san jep ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a dinggrin tsaw ra myit gaw nye a lam woi ningshawng rai nga ai; na a sadi sahka ai myit mung ngai hpe tut nawng e, lam woi ya nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Manu n dan ai masha ni hte ngai rau hpawng nga nngai n rai; sawt ai masha ni hte ngai hpa n seng nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />N hkru ai masha ni a hpawng hpe ngai n dawng nga nngai, tara n lang ai ni hpe ngai koi yen nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu e, ngai mara n kap nga nngai hpe madun lu na matu, nye a lata hpe ngai kashin nngai; nawku daw jau na matu na a tawn hkungri hpe shinggrup hkawm nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chyeju dum ai mahkawn mangoi ga langai ngai mahkawn nna na a mauhpa magam amu ni yawng hpe tsun dan nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />O Madu e, nang nga ai nta hte, na a hpung shingkang shanu nga ai shara hpe ngai tsaw ra nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yubak kap ai ni hte rau ngai hpe hkum jahten kau et; masha sat ai ni hkrum na ari kaw na ngai hpe jahti tawn da e;
  </para>
  <para style="p">
    <verse number="10" style="v" />shanhte gaw n hkru n shawp ai lam hpe aten shagu galaw nga ma ai, mayun kumhpa hpe hkap la na matu, tut nawng e, jin jin rai ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a matu chyawm gaw, tara ai lam hpe ngai galaw nga nngai; ngai hpe matsan dum ai hte hkye hkrang la e law!
  </para>
  <para style="p">
    <verse number="12" style="v" />Hkrit hpa shara yawng hte kaw na, ngai shim lum nga nngai; shi a amyu masha ni a shawa hpawng hta Ngai gaw dai Madu hpe shakawn nngai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu gaw nye a nhtoi hte hkye hkrang la ai wa rai nga ai; kadai hpe mung ngai n hkrit na nngai. Dai Madu gaw hkrithpa shara yawng kaw na ngai hpe makawp maga la nga ai rai nna; ngai galoi mung hkrit na nngai n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />N hkru ai masha ni ngai hpe gasat ai hte sat kau na matu shakut ma ai shaloi shanhte gaw ahtu ai hte kadawng mat ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hpyen luksuk ni ngai hpe wang gawan da ti mung; ngai hkrit na nngai n rai, gumlau hpyen ni ngai hpe gasat yang pyi Karai Kasang hpe naw kam hpa nga na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw ngai ra sharawng ai lam langai mi hpe dai Madu kaw hpyi se ai; dai gaw, ngai ahkrung nga dingsa dai Madu a nta hta shanu nga lu nna; shi a mai kaja ai lam hpe dai shara hta mu lu nga ai; shi a lam woi ai hpe hpyi lajin na matu chyu sha ngai ra nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ru tsang hkrum ai aten ni hta, shi gaw nye a shingbyi shara tai ya na ra ai; shi gaw ngai hpe shi a Htingnu kata hta shim ai hte bau sin na ra ai hte, tsaw ai lunghkrung ntsa e, ngai hpe shim nga shangun na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai, ngai gaw ngai hpe wang shinggrup da ai nye a gumlau hpyen ni hpe dang kau nngai; shi a Nawku Htingnu hta kabu gara jahtau garu nhtawm shagu hkungga ni hpe nawng jau na ring ngai. Ngai gaw Madu hpe mahkawn mangoi let shi hpe shakawn na ring ngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu e, ngai nang hpe shaga yang, ngai hpe na ya e! Matsan dum ai myit hte ngai hpe htan ya e!
  </para>
  <para style="p">
    <verse number="8" style="v" />“Ngai hpe nawku daw jau na sa rit,” nga nna nang tsun ndai shaloi, “ Madu e, ngai sa wa na nngai,” ngu nna ngai htan ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nang gaw ngai kaw na hkum makoi nga et!,” Ngai hpe masin hkum pawt et; Na a shangun ma wa hpe hkum n dang kau et; Karai Kasang, ngai hpe hkye hkrang la ai wa e, Nang gaw ya du hkra, ngai hpe karum la ai wa rai nga ndai majaw, ngai hpe hkum kau da et, ngai hpe hkum kabai da nga et.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye nu yan wa ngai hpe kabai kau da ai rai tim, Madu gaw ngai hpe lanu lahku la na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu e, nang ngai hpe hpa galaw shangun mayu ai lam ngai hpe sharin ya e, Ngai gaw gumlau hpyen law law lu nga nngai majaw, shim ai lam dingyang hta ngai hpe woi lakawn wa rit.
  </para>
  <para style="p">
    <verse number="12" style="v" />Masu magaw ga ni hte jahkrit shama ai lam ni hte, ngai hpe htim anut nga ai nye a gumlau hpyen ni a lata hta ngai hpe hkum kau da nga et.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai naw hkrung nga ai prat hte hta Madu a mai kaja ai lam hpe ngai mu lu na hpe ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Madu hpe kam hpa nga u. Kam sham nga u, myit hkum htum et; Madu hpe kam hpa nga u.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a dahpran shara rai nga ai Madu e, ngai nang hpe shaga nngai. Nye a hpyi jahtau ai nsen hpe madat ya e! Ngai shaga ai nsen hpe nang n htan ya ai rai yang, katsan ga e shang sa wa ai ni hta ngai lawm mat wa na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karum la na matu ngai nang hpe hpyi jahtau ai hte na a chyoi pra ai Htingnu maga de nye a lata ni hpe sharawt tawn ai shaloi, ngai hpyi ai nsen hpe na ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tara n lang ai ni hte mung, n hkru ai amu galaw ai ni hte mung, masha a n-gup aga ni gaw jinghku zawn hku hkau nga ti mung, shanhte a myit masin ni hta n ju n dawng ai myit rawng nga sai ni hte rau ngai hpe hkum daw dan et.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte hpa galaw sai lam hte shanhte shut hpyit kau sai n hkru n shawp ai amu a matu, shanhte hpe ari jaw u; shanhte a sat lawat yawng a matu shanhte hpe ari jaw u; shanhte hpe ang ai hte maren tai ya u!
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw kaning re ai amu galaw sai shing n rai, shi hpa galaw tawn sai lam ni hpe, shanhte hpa zawn n nawn ya nga ma ai; dai majaw, shi shanhte hpe ari jaw na ra ai, shanhte hpe htani htana shamyit kau na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu hpe shakawn kungdawn nga mu; shi gaw karum la na matu nye a hpyi jahtau ai nsen hpe na ya ni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu gaw ngai hpe makawp maga ai hte ninggang tai ya nga ai; ngai shi hpe kam hpa nga nngai. Shi gaw ngai hpe karum la ai lam jaw ya ai hte ngai hpe kabu gara shangun nga ai; Ngai shi hpe kabu gara ai mahkawn ga ni hte shakawn nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw shi a amyu masha ni hpe makawp maga nga ai; lata la hkrum ai shi a hkawhkam wa hpe makawp maga ai hte hkye hkrang la nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, na a amyu masha ni hpe hkye hkrang la u, na a amyu masha ni hpe shaman ya u. Shanhte hpe yu ai sagu rem wa tai nga nna, shanhte hpe htani htana lanu lahku nga u law.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sumsing lamu na lamu kasa ni yawng hte e, dai Madu hpe shakawn kungdawn mu; shi a hpung shingkang hte daru magam n-gun hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpung shingkang rawng ai dai Madu a mying nsang hpe shakawn mu; Chyoi Pra ai Wa dan pru ai shaloi, shi a man e, dingnyawm mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Madu a nsen hpe, panglai hka ni a ntsa e, na lu nga ai; hpung shingkang dan hkung ai Karai Kasang a nsen gaw mu zawn ngoi nga ai, shi a nsen gaw nammukdara a ntsa e hpung tang kashaw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu a nsen hpe shi a n-gun kaba hte galu kaba ai lam yawng hta na lu nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu a nsen gaw arit hpun ni hpe sha n rai, Lebanon arit hpun maling ni hpe pyi daw agrawp kau nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lebanon bum ni hpe dumsu kasha ni zawn shi gumtawng shangun nna, Hermon Bum ni hpe usu kasha langai mi zawn gumlawt shangun nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu a nsen gaw myi hprap wan hpe htoi gala shangun nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a nsen gaw dai nam mali hpe ashun shangun nna, Kadesha a nam mali hpe shi awam wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu a nsen gaw wamyi hpun ni hpe ashun dat nna, hpun lap ni hpe sharun kau wu ai shaloi, “Karai Kasang gaw hpung shingkang rawng nga u ga,” nga nna shi a Nawku Htingnu kata na masha shagu hte jahtau garu ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai Madu gaw sung ai hka ni hpe up nga ai; shi gaw htani htana hkawhkam hku up nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu gaw shi a amyu masha ni hpe n-gun atsam jaw ya ai rai nna ngwi pyaw sim sa ai chyeju hte shanhte hpe shaman ya nga ai.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang ngai hpe hkye hkrang la nit dai, nye a gumlau hpyen ni ngai hpe dang kau ai kaw na, nang ngai hpe makawp maga la nit dai majaw, ngai nang hpe shakawn nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />O Madu nye a Karai Kasang e, karum la na matu ngai nang hpe jahtau ni ai, nang ngai hpe shamai ya nit dai;
  </para>
  <para style="p">
    <verse number="3" style="v" />nang gaw ngai hpe nsung hku hta na mawai la nit dai. Ngai Katsan ga de yu wa nga ai kaw na nang nye a asak hpe mawai la nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a kangka ai amyu masha ni yawng hte e, dai Madu hpe mahkawn shakawn nga mu! Chyoi Pra ai Wa galaw da sai amu hpe dum nna, shi hpe chyeju dum mu!
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi a masin kahtet ai gaw hkring mi sha rai nga ai, shi a mai kaja ai lam prat ting a matu rai nga ai. Shana e myi prwi ni lwi nga ti mung, jahpawt e kabu gara ai lam lu la nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ngai gaw galoi mung sum hkrum na n rai,” ngu nna nye hkum ngai myit sim ai hte tsun nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu e, nang gaw nye a ntsa e mai kaja nga nit dai; Nang gaw ngai hpe bum ntsa e de da ai hpyen dap langai mi hpe zawn makawp maga da nit dai. Rai ti mung, na a myi man hpe makoi kau ai shaloi, ngai hkrit kahpra mat nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, ngai nang hpe shaga nngai; nang karum la na matu ngai hpyi nem nngai:
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nye a si hkrung si htan kaw nna, nang hpa baw akyu hkam la lu na rai nga n ta? Lup sung hku de ngai sa wa ai kaw nna, hpa baw amyat lu la na rai nga n ta? Si sai masha ni nang hpe shakawn lu nga ma ni? Na a n shut n shai chye ai mai kaja lam hpe, shanhte tsun dan lu na ma ni?
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu e, ngai hpe na ya ai hte matsan dum la e! Madu e, ngai hpe karum la e law!”
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang gaw nye a yawn hkyen ai hpe kabu gara ka gumlawt ai hte galai ya nit dai; nye a myit yawn ai lam hpe nang la kau ya nna, kabu gara ai hte ngai hpe shinggrup da ya nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai, ngai gaw atsin sha nga nga na nngai n rai; ngai nang hpe mahkawn shakawn nga na nngai. Madu e, nang gaw nye a Karai Kasang rai nga ndai; Ngai nang hpe htani htana chyeju dum nga na nngai law.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, makawp maga la na matu, nang kaw ngai du sa nngai. Ngai hpe galoi mung asum hkum hkrum shangun nga et. Ngai hpe hkye hkrang la e, ngai hpyi nngai!
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hpyi ai ga hpe na ya e! Ngai hpe ya jang hkye hkrang la e! Ngai hpe makawp maga la na matu, nye a shingbyi shara tai nga u; ngai hpe hkye hkrang la na matu, nye a makawp ninggang tai nga u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw nye a shingbyi shara hte dahpran shara rai nga ndai; nang ga sadi tawn da nit dai hte maren, ngai hpe woi awn lam madun la e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a matu galaw da sai mahkam kaw na ngai hpe shalawt la e law; hkrithpa shara kaw na mung, ngai hpe makawp maga la e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a lanu lahku ai chyeju hta nye hkum ngai ap ya de ai. Madu e, nang ngai hpe hkye hkrang la na rai nga ndai, nang gaw sadi sahka re ai Karai Kasang rai nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />N teng n man ai karai ni hpe nawku ai ni hpe nang n dawng nga ndai; rai ti mung, ngai gaw nang hpe kam hpa nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a dinggrin tsaw ra myit a majaw ngai myit pyaw let kabu gara nga na nngai. Nye a nni nkri hpe nang mu ya nga nna, nye a tsin-yam tsindam hpe nang chye ya nga ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye gumlau hpyen ni ngai hpe rim la na, nang ap ya nga ndai n rai; ngai sa mayu ai shara de ndut ndang hkawm sa lu na lam, nang lajang ya nga ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, ngai ru yak tsin-yam hkrum nga nngai majaw, ngai hpe matsan dum la e; nau hkrap kau ai majaw nye a myi ni bum nga li ai, ngai gaw kaja wa dik hkra hki ba mat ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yawn hkyen lam a majaw ngai n-gun kya gumba mat nga nngai; hkrap sharung ai gaw nye a asak hpe kadun kau shangun nga sai. Nye a ru tsang ai lam yawng a majaw, ngai hta n-gun lagaw yawm nga nngai rai nna, nye a nrut nra ni du hkra tsam mat nga li ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a gumlau hpyen ni yawng hta, grau nna nye a htingbu ni ngai hpe n kaw n law di mi ai; ngai hpe chye ai ni mung, ngai hpe hkrit nna, shanhte gaw ngai hpe lam nmaw e mu mada ma ai shaloi; shanhte hprawng kagat mat wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai hpe si mat sai wa zawn, kadai mung malap kau masai; kabai kau ai shanut shanaw hte maren rai mat ni ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gumlau hpyen law law ni tsun gahte ai ga hpe ngai na nngai; hkrit kajawng hpa lam yawng gaw ngai hpe wang shinggrup da mi ai. Shanhte ngai hpe gumlang na lam jawm bawngban nna, ngai hpe sat kau na matu, maw mawn nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai ti mung, O Madu e, nye a kam hpa ai gaw nang hta nga nga li ai; Nang gaw nye a Karai Kasang rai nga ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw tut nawng e, na a lata hta rai nga nngai, ngai hpe zingri zingrat nga ai ni hte nye a gumlau hpyen ni a lata kaw na ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a shangun ma a ntsa e, matsan dum ai myit hte mada mara ya e; na a dinggrin tsaw ra myit hte ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Madu e, nang hpe ngai shaga nngai rai nna; ngai hpe kaya kahpa hkum jahkrum et. Tara n lang ai ni gaw kaya kahpa hkrum nga mu ga, katsan ga de atsin sha shanhte yu mat wa mu ga.
  </para>
  <para style="p">
    <verse number="18" style="v" />Masu magaw ai ni, gumrawng gumtawng ai hte myit tsaw myit dap rawng nga nna, ding hpring ai masha ni a lam hpe n kaw n law nga nna tsun ai ni yawng hte hpe jasim kau u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang hpe shagrau sha-a ai ni a matu nang kyem da ya ai kaja ai chyeju ni gaw kade wa mauhpa rai nga a hka! Nang kade wa mai kaja nga ai hpe mung nang hta kam hpa nga ai ni hpe kade sha shim ai hku nang makawp maga ya nga ndai hpe mung masha shagu chye nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Masha ni a maw mawn ai kaw na nang shanhte hpe na a man na shim lum ai shara hta makoi da nna; shanhte a gumlau hpyen ni roi rip ai kaw nna mung shim ai shara hta nang shanhte hpe makoi da nga ndai,
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai Madu hpe shakawn kungdawn mu! Ngai gaw wang da ai hkrum nna gasat hkrum nga ai shaloi, ngai hpe shi a tsaw ra myit madun dan ai gaw kade wa mauhpa rai nga a hka!
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi gaw ngai hpe shi a man kaw na gawt shapraw kau hkrum sai zawn nawn nna, ngai myit yu ai hte hkrit kau ni ai. Rai ti mung, karum la na matu shi hpe ngai shaga yang, nye a hpyi jahtau ai nsen hpe shi na ya sai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi a kangka ai amyu masha ni yawng hte e, dai Madu hpe tsaw ra nga mu. Dai Madu gaw kangka ai ni hpe makawp maga nga ti mung, gumrawng gumtawng ai ni hpe chyawm gaw shanhte hkam la ging ai hte maren ari jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Madu hta myit mada nga ai ni yawng hte e, n-gun shaja nna, nden marai rawng nga mu.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yubak dat kau hkrum ai hte, shut hpyit ai ni a mara hta na raw dat kau hkrum nga ai ni gaw a lu ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shut hpyit ai amu hta na dai Madu e mara shagun n hkrum ai hte, masu magaw lam yawng hta na lawt lu ai wa gaw a nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a yubak ni hpe ngai garai n yin la yang, shani tup hkrap nga ai majaw, ngai hki ba nga ni ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, nang ngai hpe shani shana ari jaw nit dai; ginhtawng ta na kang kahtet ai a majaw, madi manyap shara ni hkun hkraw mat wa ai zawn, nye a n-gun atsam mung tsep kawp htum mat nga sali ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai, ngai gaw nye a yubak ni hpe nang kaw yin la ni ai; nye a shut hpyit ai mara ni hpe mung ngai makoi magap da nngai n rai. Dai lam ni hpe nang kaw mara yin la na ngai daw dan ni ai; nye a yubak yawng hte hpe nang dat kau ya nit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna, na a sadi dung ai amyu masha ni yawng hte gaw ra kadawn ai aten ni hta nang kaw akyu hpyi na mai nga ai; ru tsang mawru kaba adawt shang wa ai shaloi dai gaw shanhte kaw du dep wa na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw nye a gawp makoi shara rai nga ndai; nang gaw ngai hpe ru yak tsin-yam kata kaw nna hkye hkrang la na rin dai. Nang ngai hpe makawp maga ndai majaw na a hkye hkrang la ai lam hpe ja ja mahkawn na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw, “Nang hkawm sa ang ai lam ngai nang hpe sharin ya na nngai, ngai nang hpe hpaji jaw nna sharin matsun na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ga madat na matu hpri makrang hte gumhtung sumri ni hte hkang ra ai gumra hte lawze ni zawn machye machyang n rawng hkum rai myit,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tara n lang ai ni gaw nni nkri hkam sha ra na ma ai, rai ti mung, Madu hpe kam hpa nga ai ni gaw shi a dinggrin tsaw ra myit hte makawp maga la ai hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ding hpring ai ni e, Madu galaw dan sai amu a majaw, kabu gara ai hte pyaw pyaw rai nga mu. Shi a ga madat mara ai ni e, kabu gara marawn jahtau nga mu law!
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ding hpring ai ni yawng hte e, Madu galaw dan sai amu a majaw, kabu gara marawn jahtau nga mu; shi a ga madat mara ai ni yawng hte e, shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu hpe tingse ni hte dum shakawn mu, sumri rawng ai madum sumpyi ni hte shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mahkawn ga nnan hte shi hpe mahkawn mu, madat pyaw hkra tingse dum nna, kabu gara marawn jahtau nga mu!
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu a mungga ni gaw teng man nga ai, shi a amu bungli ni yawng kam mai nga lu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu gaw ding man ai hte teng man ai hpe tsaw ra nga ai; shi a dinggrin tsaw ra myit gaw aga ting hta hpring nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu gaw shi a hkang da ai mungga hte sumsing lamu ni hpe hpan da nu ai; jan, shata hte shagan ni mung, shi tsun dat ai mungga hte byin wa sai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw hka panglai ni yawng hpe shara langai mi hta sumpum gumdin da nga ai; sung ai nammukdara hka ni hpe dum ni hta la shingdang da nu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ginding aga yawng hte e, dai Madu hpe nawku mu! Mungkan ga na mashani yawng hte e, shi hpe shagrau sha-a mu!
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi ga shaga dat ai shaloi, mungkan ga byin pru wa sai; shi a hkang da ai mungga a jaw e, arai yawng mayawng dan pru wa sai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai Madu gaw masha amyu baw ni a shatawng shada ai lam ni hpe shanut kau ya nga ai; shanhte a maw mawn ai lam ni n awng dang u ga, shi shanhte hpe hkum shingdang da nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, shi a yaw shada ai lam ni gaw htani htana agrin nga ai; shatawng shada ai lam ni mung prat dingsa anga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu hpe shanhte a Karai Kasang shatai ai amyu baw gaw a nga ai; shi e lata la hkrum ai amyu masha ni gaw a lu nga ai!
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw sumsing lamu kaw nna gum yu nga ai hte shinggyim masha nlang hte hpe mu nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi up hkang nga ai shara kaw nna, ga ningtsa e nga ai masha nlang ni hpe shi gum yu nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai Madu gaw shanhte a myit mang ai lam yawng mayawng hte hpe hkrang shapraw ya nga ai; shanhte galaw ai lam yawng mayawng hte hpe mung chye ya nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi a n-gun rawng ai hpyen luksuk a majaw hkawhkam wa majan dang ai n rai; hpyen ma langai mi gaw shi a n-gun a majaw awng padang lu ai n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Majan gumra ni gaw awng padang a matu kaman lila rai nga ai; dai ni a n-gun kaba hte hkye hkrang la lu nga ai n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai Madu gaw shi hpe hkrit hkungga ai ni hte shi a dinggrin tsaw ra myit hpe kam hpa nga ai ni hpe, sin yu nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai Madu gaw shanhte hpe si ai kaw na hkye hkrang la nga ai; shi gaw shanhte hpe hku hku hpang gara ai aten hta asak hkrung nga lu na ahkang jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anhte gaw dai Madu hpe myit mada nga ga ai; shi gaw anhte a makawp ninggang hte karum la ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a majaw anhte kabu gara nga ga ai; shi a chyoi pra ai mying nsang hta anhte kam ga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Madu e, nang hpe anhte myit mada nga ga ai hte maren, na a dinggrin tsaw ra myit gaw anhte hte rau anga nga u ga law.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw dai Madu hpe tut nawng chyeju dum nga na nngai; shi hpe shakawn ai lam, ngai galoi mung jahkring kau na nngai n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi galaw da sai amu a matu, ngai shi hpe shakawn nga na nngai; dip gamyet sha hkrum ai ni yawng hte e, madat la nna kabu gara nga mu!
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Madu a galu kaba ai lam hpe ngai hte rau htawn tsun ga; shi a mying nsang hpe anhte jawm shakawn ga!
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw Madu kaw akyu hpyi ni ai hte shi ngai hpe htan ya ni ai; shi gaw nye a hkrithpa lam yawng kaw na, ngai hpe shalawt la ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dip gamyet sha hkrum ai masha ni gaw dai Madu hpe yu nna kabu gara nga ma ai; shanhte gaw galoi mung myit daw myit hten ai hkrum na mara ai n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Matsan mayan hkrum ai masha ni shi hpe shaga yang, shi htan ya nga ai; shi gaw shanhte a ru yak tsin-yam yawng kaw na shanhte hpe hkye hkrang la nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu hpe shagrau sha-a ai ni hpe shi a lamu kasa ni bau sin nga ma ai; hkrithpa shara kaw na mung, shanhte hpe mawai la nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu kade wa mai kaja nga ai gaw nang hkum nan chyim yu nna chye u; shi hta shingbyi shara mu ai wa gaw a nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a amyu masha ni yawng hte e, dai Madu hpe shagrau sha-a nga mu; shi a ga madat mara ai ni gaw shanhte a ra kadawn nga ai lam yawng hte hpe hkam la lu nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkanghkyi ni pyi lusha kadawn nna kawsi hkrum nga ma ti mung; Madu a ga madat mara ai ni gaw mai kaja ai lam hpa mung ra kadawn nga ma ai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a rau ram manang ni e, wa marit nye a ga hpe madat mu; dai Madu hpe shagrau sha-a na lam ngai nanhte hpe sharin ya na nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang gaw kabu gara ai asak hkrun lam hpe ra sharawng nga n ni? Asak galu ai hte kabu gara ai hpe nang ra nga n ni?
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hpang, n hkru ai ga tsun shaga ai hte masu magaw ga tsun ai lam hpe koi gam nga u.
  </para>
  <para style="p">
    <verse number="14" style="v" />N hkru n shawp ai lam hpe koi kau nna mai kaja ai lam hpe galaw nga u; na a myit masin mahkra hte ngwi pyaw sim sa lam a matu, shakut shaja nga u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai Madu gaw ding hpring ai ni hpe mada mara nga nna; shanhte a hpyi jahtau ai nsen ni hpe madat ya nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai ti mung, n hkru n shawp ai amu galaw ai ni hpe shi hkum shingdang nga ai; shing rai, shanhte si wa ai shaloi, shanhte gaw alawan sha, malap kau ai hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ding hpring ai ni Madu hpe shaga yang shi madat ya nna; shi gaw shanhte a ru yak tsin-yam yawng hta na, shanhte hpe mawai la nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai Madu gaw myit daw myit hten ai ni hte ani sha nga nga ai; myit mada shara n nga mat sai ni hpe shi hkye hkrang la nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai mai kaja ai masha wa gaw ru yak tsin-yam law law hkrum sha nga ai; Madu gaw dai ni yawng hta na shi hpe hkye hkrang la nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Madu gaw shi hpe n hten n za mat hkra, tsep kawp kyem mazing ya nga ai; shi a nrut nra ni langai mi mung, daw hten ai hkrum nga ai n rai.
  </para>
  <para style="p">
    <verse number="21" style="v" />N hkru ai gaw tara n lang ai ni hpe sat kau na maru ai; ding hpring ai ni hpe n dawng ai ni chyawm gaw ari jaw ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai Madu gaw shi a amyu masha ni hpe hkye hkrang la na ra ai; makawp maga la na matu, shi kaw du sa ai ni chyawm gaw jahti la ai hkrum na mara ai.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, ngai hpe ninghkap ai ni hpe ninghkap kau u; ngai hpe gasat ai ni hpe mung, gasat kau u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a ninggang hte hpri palawng la nna, ngai hpe mawai la na, du rit.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a nri hte majan nwa ni hpe sharawt nna ngai hpe hkan shachyut ai ni hpe ninghkap u. nang gaw ngai hpe hkye hkrang la na nngai, ngu nna ga sadi jaw e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai hpe sat na matu shakut ai ni gaw sum mat nna jahpoi jahpyak kau ai hkrum nga mu ga! Ngai hpe ninghkap na maw mawn ai ni mung shingdu de nhtang kau dat nna shanut kau ai hkrum mu ga!
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu a lamu kasa gaw shanhte hpe hkan shachyut nga yang; shanhte gaw nbung e shapoi kau ai numhkaw zawn rai mat mu ga!
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu a lamu kasa gaw shanhte hpe adup kadawng yang, shanhte a hkawm sa ai hkrun lam gaw sin mak mat ai hte manen mat mu ga!
  </para>
  <para style="p">
    <verse number="7" style="v" />Hpa mung n ra ra re ai kaw, shanhte gaw nye a matu mahkam hkam da ma ai, ngai hpe rim bang na matu sung ai nhkun langai mi htu da nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung, shanhte gaw n dum shami naw rai nga yang, hten byak ai hkrum na mara ai; shanhte hkam da ai mahkam hta shanhte nan lu nna, hten byak ai hkrum na mara ai!
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi, dai Madu a majaw ngai kabu gara ai hkrum na nngai; shi ngai hpe hkye hkrang la ni ai majaw ngai kabu gara ai hkrum na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Nang hte bung ai wa langai mi mung n nga nga ai, nang gaw n-gun ja ai wa a lata kaw na gawng kya nga ai wa hpe, dip gamyet sha ai wa a lata kaw na matsan mayan wa hpe makawp maga ya nga ndai,” ngu nna nye a myit masin mahkra hte dai Madu hpe tsun dan na nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />N hkru n shawp ai masha ni gaw ngai hpe nhtan shai ai hku sakse hkam ya nna; ngai hpa mung n chye lawm ai ru hka amu ni hte ngai hpe mara shagun ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte gaw kaja ai amu a matu, n hkru ai hte ngai hpe bai nhtang tai ma ai; ngai myit htum nga nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai ti mung, shanhte machyi hkrum nga ma ai shaloi, sharung shayawt ai hku nna, lachyit nba bu hpun let; lusha gam nna nye a hkum hpe shagrit kau nhtawm jinghku wa shing n rai hpu nau langai ngai a matu akyu hpyi myit dum ya ai zawn, nye a baw gum dagup ai hte ngai akyu hpyi ni ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kanu a majaw, sharung shayawt hkrum ai wa zawn, ngai gaw nshang htingkung hkra yawn hkyen hkawm nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, ngai ru yak tsin-yam hkrum nga ai shaloi, shanhte yawng kabu gara nga ma ai; ngai hpe jawm shinggrup da nna asawng asang di mi ai. Tsasam masha ni ngai hpe gayat ai hte ngai hpe n sim n sa kahpret nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chyahten labye wa hpe jahpoi asawng ai masha ni zawn, shanhte ngai hpe n ju n dawng ai myi hte yu azi da mi ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Madu e, galoi du hkra, nang a yu nga na ngu n ta? Shanhte a gasat gala ai kaw na ngai hpe mawai la e. Ndai hkanghkyi ni kaw nna, nye a asak hpe hkye la e law!
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai shaloi, na a amyu masha ni a shawa hpawng hta ngai nang hpe chyeju dum na nngai; shanhte yawng a man e, ngai nang hpe shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Masu magaw ai nye a gumlau hpyen ni gaw ngai hpe dang kau lu ma ai majaw gumrawng ai lam hkum byin shangun et! Lachyum n pru ai sha, ngai hpe n ju n dawng ai ni, ngai yawn hkyen hkrum ai hpe mu nna, hkrum sha sahka, nga nna hkum kabu shangun et!
  </para>
  <para style="p">
    <verse number="20" style="v" />Shanhte gaw hku hku hkau hkau rai n shaga ma ai; shing rai tsun na malai, shanhte gaw ngwi pyaw sim sa lam tam ai ni hpe, masu magaw lam amyu myu hte shatan nhkan di ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Nang hpa galaw da sai lam hpe anhte mu sagaw ai,” nga nna jahtau tsun let; shanhte ngai hpe mara shagun da nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai ti mung, Madu e, nang gaw dai lam ni hpe mu nit dai majaw, Madu e, atsin sha hkum nga nga et, ngai hte ani sha nga nga u law!
  </para>
  <para style="p">
    <verse number="23" style="v" />Madu e, na a myit hpe shajin u; Ngai hpe makawp maga la e; Nye a Karai Kasang e, rawt nna nye a maga de tsap nhtawm nye a amu hpe dangrang ya e.
  </para>
  <para style="p">
    <verse number="24" style="v" />Madu e, nang gaw ding hpring ai wa rai nga ndai majaw ngai hpe mara n kap ai wa re ngu nna tsun ndau ya e; nye a gumlau hpyen ni hpe nye a jaw e, awng padang hte hkum kabu shangun et.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Shi hpe anhte jahten kau lu sagaw ai! Dai gaw anhte myit ra ai lam nan rai sai,” nga nna shanhte hpe shada da hkum tsun hkat lu shangun et.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nye a nni nkri hpe yu kabu nga ai ni, tsep kawp sum mat ai hte shanut kau ai hkrum nga mu ga. Ngai hta grau ai ni re ngu nna tsun ai ni gaw, kaya kahpa hte myi man sum ai hkrum sha mu ga.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngai hpe mara n kap ai wa ngu nna mu mada mayu ai ni gaw kabu gara nga ai; “ Madu gaw kade galu kaba nga a hka! Shi gaw shi a shangun ma wa a awng dang ai lam hta sharawng awng nga ai,” nga nna shanhte kahtap kala jahtau tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi, na a ding man ai lam hpe ngai tsun shana ya na nngai; ngai mung nang hpe shani tup shakawn nga na nngai law.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yubak gaw tara n lang ai masha wa a sung ai myit kraw kata hta shaga nga ai; shi gaw Karai Kasang hpe nyet kau nhtawm shi hpe hkrit hkungga ai lam hpa mung n nga ai, ngu nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpa majaw nga yang, shi gaw shi hkum shi grai rai la sai ngu nna myit la nga ai; Karai Kasang gaw shi a yubak hpe n mu tam ai hte dai hpe daw dan jeyang na n rai, nga nna shi myit nawn la nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a tsun shaga ai ga gaw n hkru n shawp ai hte masu magaw ga ni hte hpring nga ai; hpaji rawng ai lam hte mai kaja ai lam hpe shi kachyi mi mung n galaw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw yup ku ntsa e kaleng nga yang, n hkru ai mahkyen ni hpe galaw ma ai; shi galaw ai amu hpa mung n kaja nga ai, n hkru ai amu hpa hpe mung galoi mung ningdang kau nga ai n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, na a dinggrin tsaw ra myit gaw sumsing lamu du hkra dep nga ai; na a sadi sahka mung lamu ni de du hkra maden jat nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a ding man ai lam gaw bum ni zawn tsaw nga nna, na a teng man ai lam mung hka panglai zawn sung nga ai. Masha hte dusat yam nga ni gaw na a lata hta rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang e, na a dinggrin tsaw ra myit gaw kade wa hpu reng nga a hka! Na a singkaw ni a shingnip npu hta shingbyi shara anhte lu ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang jaw ya ai n taw n tsang re ai lusha hta anhte lu sha ga ai; na a mai kaja ai chyeju hte lwi ai hka nu kaw na nang anhte hpe lu shangun mi ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw asak yawng a hka hpawk rai nga ndai; na a nhtoi majaw, anhte dai nhtoi hpe mu lu ga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang hpe chye chyap ai ni hpe matut nna tsaw ra nga u, ding hpring ai ni hpe matut nna mai kaja ai amu galaw nga u law.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gumrawng gumtawng ai masha ni ngai hpe hkum gasat shangun et, n hkru n shawp ai masha ni mung ngai hpe hkum jahtaw kau shangun et.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yu u, n hkru ai masha ni kanang kadawng taw nga sai hpe yu u. Shanhte gaw dai yang e kataw nna n lu rawt nga ma ai.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />N hkru n shawp ai ni a majaw myit hkum ru et; n teng n man ai amu galaw ai ni hpe hkum yu manawn et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hkraw mat ai tsingdu zawn, shanhte kade nna yang hkoi mat na mara ai; nyip mat ai hpun lawn kasha ni zawn shanhte si mat na mara ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Madu hta kam hpa nga let mai kaja ai amu hpe galaw nga u; dai lamu ga hta shanu nga nna shim nga u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu hta na a kabu gara ai lam hpe tam la u; shi gaw na a myit ra sharawng ai lam hpe jaw ya na ra ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na hkum dai Madu hpe ap ya u; shi hta kam hpa nga u, nang hpe shi karum la na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a ding man ai lam hpe jan pungding shingkang zawn, shi shapraw dan na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu a man e amu sha nga nga nna shi shabyin ya na lam hpe ala nga u; n hkru n shawp ai ni a yaw shada ai lam ni hta awng dang wa nna, ngamu ngamai wa ai ni hpe hkum yu tsang nga et.
  </para>
  <para style="p">
    <verse number="8" style="v" />Myit hkum ru, masin mung hkum pawt et, dai gaw nang hpe ru tsang sha hkrum shangun nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu hta kam hpa nga ai ni gaw lamu ga hpe madu lu na mara ai; rai ti mung, tara n lang ai ni chyawm gaw gawt shapraw kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tara n lang ai ni gaw kade nna yang, hkoi mat wa na mara ai; nang shanhte hpe tam yu ti mung, shanhte hpe mu tam na n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, myit shagrit shanem ai ni mahtang dai lamu ga hpe madu lu na mara ai; ngamu ngamai ai lam hte ngwi pyaw sim sa ai lam hpe kabu gara hkam la lu na mara ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />N hkru n shawp ai masha wa gaw mai kaja ai masha wa hpe n kaja ai hku maw mawn nna shi hpe n ju n dawng ai myi hte yu azi da nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai ti mung, tara n lang ai ni gaw kade n na yang, jahten kau ai hkrum mat na hpe Madu chye nga ai majaw, shi shanhte hpe mani nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Matsan mayan ni hte ra kadawn ai ni hpe mung, teng man ai amu galaw ai masha ni hpe mung sat kau na nga; n hkru n shawp ai ni gaw shanhte a nhtu ni hpe shaw nna, ndan ni hpe shachyen nga ma ai;
  </para>
  <para style="p">
    <verse number="15" style="v" />rai ti mung, shanhte ni mahtang shanhte a nhtu ni hte nan sat kau ai hkrum na mara ai; shanhte a ndan ni mung agrawp daw kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mai kaja ai wa a sut gan kachyi mi gaw tara n lang ai wa a sut gan yawng hta grau nna manu dan nga ai,
  </para>
  <para style="p">
    <verse number="17" style="v" />hpa majaw nga yang, Madu gaw tara n lang ai wa a n-gun hpe shadaw kau ya na ra ai; rai ti mung, mai kaja ai ni hpe chyawm gaw shi makawp maga la na ra ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai Madu gaw shi a ga madat mara nga ai ni hpe shi lanu lahku nga nna; dai mungdan hpe shanhte htani htana madu na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yak hkak hkrum ai shaloi nni nkri hpe shanhte hkam sha na mara ai n rai; hku hku ai aten hta mung, shanhte gaw ra kadawn ai lam n nga hkra, hkam la lu na mara ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rai ti mung, tara n lang ai ni gaw si mat na mara ai; Madu a gumlau hpyen ni mung nam e tu ai nampan ni zawn wai mat nna, wan hkut zawn shanhte mawng mat na mara ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tara n lang ai masha wa gaw arai shap la ti mung, galoi mung nhtang ya nga ai n rai; rai ti mung, mai kaja ai wa gaw shi a kumhpaw kumhpa ni hpe ndaw nhta jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Madu kaw na shaman ai chyeju lu la ai ni gaw lamu ga hpe madu lu na mara ai; rai ti mung, shi kaw na dagam dala hkrum ai ni chyawm gaw gawt shapraw kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai Madu gaw masha wa hpe shi sa ang ai lam hta woi wa ai; shi hta sharawng awng ai ni hpe makawp maga ya nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shanhte kataw ai lama rai yang, shanhte kataw nan nga na mara ai n rai; kaning rai nme law, Madu gaw shanhte hpe sharawt la na ra ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya chyawm gaw, ngai asak kaba ugut gu wa nga nngai, ngai gaw aten na na asak hkrung nga ni ai; rai ti mung, mai kaja ai masha wa hpe Madu kau da nna, shi a kashu kasha ni lusha hpyi sha hkawm ai hpe ngai galoi mung garai n mu yu nga nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi gaw aten shagu, ndut ndang jaw ya ai hte kaga ni hpe hkoi ya nga ai; shi a kashu kasha ni mung chyeju kumhpa tai nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />N hkru ai lam hpe kau da nna mai kaja ai amu hpe galaw u; shing rai, na a aru arat ni gaw dai lamu ga hta tut nawng e, shanu nga lu na mara ai;
  </para>
  <para style="p">
    <verse number="28" style="v" />hpa majaw nga yang, Madu gaw teng man ai lam hpe tsaw ra nga nna; kangka ai shi a amyu masha ni hpe n kau da nga ai majaw rai nga ai. Shi gaw shanhte hpe htani htana makawp maga nga ai, rai ti mung, tara n lang ai wa a aru arat ni gaw gawt shapraw kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ding hpring ai masha ni gaw lamu ga hpe madu lu na mara ai hte; dai lamu ga hta htani htana shanu nga na mara ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mai kaja ai masha langai mi a n-gup ga ni hta hpaji ga rawng nga ai; shi gaw tut nawng e tara ding nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi gaw Karai Kasang a tara hpe shi a kraw lawang hta kyem da nga ai; dai tara hpe galoi mung ahkan sa nga na ra ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tara n lang ai masha wa gaw mai kaja ai masha wa hpe lagyim yu nna; shi hpe sat kau na, shakut nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rai ti mung, Madu gaw shi hpe shi a gumlau hpyen wa a lata hta ap kau da na wu ai n rai; shi tara jeyang ai hkrum yang, ari jaw ai hte daw dan hkrum na n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Madu hta myit mada nga nna shi a hkang da ai ga ni hpe madat mara u; shi nang hpe lamu ga jaw ya nna, nang hpe shagrau sha-a na ra ai. Tara n lang ai ni gawt shapraw kau hkrum ai hpe nang mu lu na ra ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tara n lang nna mazut gumshem nga ai wa hpe ngai lang mi chye yu ni ai; shi gaw Lebanon arit hpun zawn masha shagu a ntsa e, ka-up da nu ai;
  </para>
  <para style="p">
    <verse number="36" style="v" />rai ti mung, kade n na ai aten hta ngai lai wa yu ai shaloi dai shara hta shi n nga sai; shi hpe ngai tam yu tim, shi hpe n mu lu mat ni ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Mai kaja ai masha wa hpe matsing da u, ding hpring ai masha wa hpe maram masam yu u; ngwi pyaw sim sa ai masha wa gaw aru arat law law lu nga ai;
  </para>
  <para style="p">
    <verse number="38" style="v" />rai ti mung, yubak kap ai masha ni gaw tsep kawp jahten kau ai hkrum na mara ai; shanhte a aru arat ni mung yeng seng kau ai hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai Madu gaw ding hpring ai masha ni hpe hkye hkrang la nna, ru tsang hkrum ai aten ni hta shanhte hpe makawp maga ya nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shi gaw shanhte hpe karum nna mawai la nga ai, shanhte gaw shi kaw makawp maga la na matu du sa nga ma ai majaw, shi shanhte hpe tara n lang ai ni a lata kaw nna hkye hkrang la nga ai.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, na a masin kahtet ai hta ngai hpe ari hkum jaw et!
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a pala ni a jaw e, ngai hta nma kap nga nna nang ngai hpe adup kadawng tawn nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a masin kahtet ai majaw ngai laja lana machyi hkrum nga nngai; nye a yubak ni a majaw, nye a hkum ting hta ana zinli hkrai rai nga li ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw nye a yubak mawru kata hta lup mat wa nga nngai; dai ni gaw tsin-yam lit langai mi rai nga nna, hkam sharang lu na matu, nau li la nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw angawk angak rai mat ni ai majaw, nye a nma ni yat nna manam hkying nga li ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw nshang htingkung nga nngai hte myit daw myit hten ai hkrum nga nngai; shing rai, shani tup ngai sharung shayawt nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai gaw hkum kahtet machyi nga nngai hte si wa mahka rai mat nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai gaw hki ba la nga nngai hte teng sha wa, agrawp agrap rai mat nga nngai; nye a myit kraw lawang mung ru tsang hkrum nga nna, nchyi nmu hte ngai madai nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />O Madu e, ngai hpa hpe ra marit nga ai gaw nang chye nga ndai; nye a madai ai nsen ni yawng hpe mung nang na ya nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a salum htuk htak nga li ai, nye a n-gun mung htum mat sali ai; nye a myi ni mu na atsam n rawng mat sai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a ningma ni a majaw, nye a manang ni hte htingbu ni ngai kaw n ni sa wa na ma ai; nye a dinghku pyi ngai hpe gang kau da nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai hpe sat mayu ai ni, nye a matu mahkam hkam da nga nna, ngai hpe machyi shangun mayu ai ni mung ngai hpe jahten shabyak lu na matu jahkrit shama nga ma ai; shanhte gaw ngai hpe n sim n sa n kaja ai lam maw mawn nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai gaw na lahpang ai masha langai wa zawn n na lu nngai, ma-a ai masha langai wa zawn n lu shaga nga nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai gaw na n na lu ai majaw, n htan ai na hpang wa hte bung nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, Madu e, ngai gaw nang hpe kam hpa nga nngai; nye a Madu Karai Kasang e, nang gaw ngai hpe htan ya na rin dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nye a gumlau hpyen ni, nye a myit ru myit tsang ai lam hta hkum yu kabu shangun nga et; nye a hkrat sum mat ai lam hta mung, shanhte hpe hkum gumrawng shangun nga et!
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai gaw kataw na sha rai ni ai hte n sim n sa machyi ai mung hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a yubak ni hpe ngai yin la nga nngai, dai gaw ngai hpe myit ru myit tsang lam jahpring ya nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nye a gumlau hpyen ni gaw hkam kaja nga ma ai hte n-gun ja nga ma ai; mara kata, ngai hpe n dawng ai ni law law nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mai kaja ai a matu, n hkru ai hpe htang jaw ai ni gaw teng man ai amu hpe ngai galaw shakut nga ai majaw, ngai hte nhtan shai nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Madu e, ngai hpe hkum kau da et; nye a Karai Kasang e, ngai hte tsan tsan hkum nga et.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai hpe hkye hkrang la ai Madu e, ngai hpe ya jang karum la e law!
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Ngai galaw ai amu hta sadi sahka hte nga na ring ngai; nye a shinglet hte ngai yubak n galaw shangun na nngai. N hkru ai masha ni, ni nga yang, ngai hpa mung tsun dan na nngai n rai,” nga nna ngai tsun ni ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mai kaja ai lam hpe pyi, ga hkum mi n tsun ai sha, ngai zim rai nga nga nngai! Rai ti mung, nye a nni nkri chyu sha grau rawt sawng wa nga li ai,
  </para>
  <para style="p">
    <verse number="3" style="v" />myit ru myit tsang ai gaw, ngai hpe ka-up kau nga li ai. Ngai grau myit ru magang, ru tsang ai gaw ngai hta grau law wa magang rai nga ai; Ngai n san ai sha n nga lu nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />“ Madu e, ngai gaw galoi du hkra hkrung nga lu na rai nga a ta? Ngai galoi si na rai nga a ta? Nye a asak galoi wa mi she htum mat na, ngai hpe tsun dan e law.”
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang jaw ya ai nye a asak gaw kade wa kadun nga a hka! Na a man e, nye a asak prat gaw hpa n rai nga ai zawn rai nga ai. Kaja wa ahkrung nga ai masha hkum shagu gaw nsa sa lai nbung hte,
  </para>
  <para style="p">
    <verse number="6" style="v" />shingnip langai mi hta pyi grau nga ai n rai. Shi galaw ai lam yawng mayawng mung kaman a matu rai nga ai; shi gaw sut gan hpe mahkawng da ti mung dai hpe kadai lu la na ra ai gaw, n chye nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu e, ngai gaw kaning re ai hpe myit mada lu na rai nga a ta? Ngai nang hpe myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a yubak yawng mayawng kaw nna ngai hpe hkye hkrang la e, shing rai, angawk ai ni ngai hpe hkum mani asawng shangun nga et.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang ngai hpe ndai zawn re ai nni nkri hpe jahkrum ai wa rai nga ndai majaw, ngai ga hkaw mi mung n tsun ai sha, zim rai nga na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai hpe ari hkum jaw sa! Nang adup ai a jaw e, ngai si wa magang nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a daru sharin ai lam ni hte, masha a yubak hpe nang ari jaw nga ndai; dai wa tsaw ra ai arai hpe manut e, jahten kau ai zawn nang jahten kau nga ndai. Kaja wa, masha langai mi gaw nsa sa lai nbung langai mi hta grau nga ai n rai!
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, nye a akyu hpyi ai ga hpe na ya e, ngai hpyi jahtau ai nsen hpe madat ya e; ngai hkrap ngu hkrap ngoi nga yang, ngai hpe sa karum la e. Nye a kaji kawa ni yawng zawn, ngai gaw na a manam sha, jahkring mi tai nga nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai garai n si mat wa yang, kabu gara let nga lu na matu ngai hpe masin hkum pawt nga e law.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu karum la na matu ngai myit galu ai hte ala nga nngai; shaloi, ngai hpe shi madat ya nna, nye a hpyi jahtau ai nsen hpe na ya ni ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw ngai hpe hkrit hpa nhkun hta na mung, lup si shangun ai nawng wam hta na mung gang shaw la nhtawm; lunghkrung ntsa e, shim hkra ngai hpe tawn da nna makawp maga da ni ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw ngai hpe mahkawn ga nnan mahkawn shakawn na matu sharin ya ai, dai gaw anhte a Karai Kasang hpe shakawn ai mahkawn langai mi rai nga ai. Law law wa dai hpe mu nna hkrit maja let, Madu hpe shanhte kam hpa nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hpara sumla hpang de n hkan nang ai hte, karai masu ni hpe nawku daw jau ai ni hte mung, n mazum ai sha, dai Madu hpe kam hpa nga ai ni gaw a nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte a Madu Karai Kasang e, anhte a matu nang galaw da ya sai amu ni gaw law la nga ai; nang hte bung ai wa kadai mung n nga nga ai! Anhte a matu mauhpa yaw shada lam law law hpe nang galaw da ya nit dai. Dai ni gaw nau law la ai majaw, dai ni yawng a lam hpe ngai dang hti lu ai n rai!
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang gaw shagu hkungga ni hte wan nat hkungga ni hpe n sharawng nga ndai; tawn hkungri ntsa e, hkum ting nat nawng ai hkungga ni hte, yubak mara raw dat kau na matu nawng jau ai hkungga ni hpe, nang n hpyi nga ndai. Shing rai nawng jau ya na malai, nang tsun ai lam hpe na la na matu, nang gaw ngai hpe na lashing hpaw ya nit dai,
  </para>
  <para style="p">
    <verse number="7" style="v" />ngai gaw, “Ngai nang e, nga nga nngai; nye a matu na a sharin shaga ai ga matsun ni gaw tara laika buk hta rawng nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a Karai Kasang e, na a myit ra ai hku galaw na, ngai kade wa tsaw nga a hka! Na a sharin shaga ai lam hpe nye a myit kraw lawang hta ngai mazing da nga nngai,” ngu nna ngai htan ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, na amyu masha ni yawng a shawa hpawng hta nang anhte hpe hkye hkrang la ai dai kabu gara shiga hpe ngai tsun dan ni ai. Dai hkaw tsun ai lam hpe ngai galoi mung jahkring kau na n rai nga ai hpe nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hkye hkrang la ai shiga hpe ngai hkum nan ip da nga nngai n rai; ngai gaw na a sadi sahka hte karum la ai lam hpe tut nawng atsun ni ai; Na a amyu masha ni yawng a shawa hpawng hta, na a kangka ai lam hte dinggrin tsaw ra nga ai lam ni hpe ngai n tsun ai sha nga kau nngai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu e, ngai hpe matsan dum ai lam nang galoi mung jahkring kau na n rai nga ndai gaw, ngai chye nngai. Na a tsaw ra myit hte sadi sahka gaw ngai hpe tut nawng e, shim lum shangun na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai gaw ru tsang law law hte gawan da hkrum ai wa rai nga nngai dai gaw n dang hti hkra law la nga ai! Ngai loi mi pyi n mu mada lu hkra, nye a yubak ni mung ngai hpe dep nang mat sai; dai gaw nye baw na kara ni hta grau law ai rai nna, nye a myit gawng run mat sali ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Madu e, ngai hpe hkye hkrang la e! Ngai hpe ya jang, karum la e!
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai hpe sat na maw ai ni tsep kawp sum mat nna shanut kau ai hkrum mu ga. Nye a ru tsang ai lam ni a majaw kabu gara nga ai ni gaw shingdu de htingnut mat wa nna, kaya kahpa hkrum mu ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai hpe mani asawng ai ni gaw shanhte sum mat ai a jaw e, myi man sum mat mu ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang kaw du sa ai ni yawng hte gaw awng sharawng ai hte kabu gara nga mu ga; na a hkye hkrang la ai lam hpe chyeju dum ai ni yawng hte gaw, “ Madu gaw kade wa galu kaba nga a hka!” nga nna tut tut atsun nga mu ga.
  </para>
  <para style="p">
    <verse number="17" style="v" />Madu e, ngai gaw gawng kya nga nngai hte matsan mayan re ai wa rai nga nngai, rai ti mung, nang gaw ngai hpe malap kau nga ndai n rai. Nang gaw nye a hkye hkrang la ai wa hte nye a Karai Kasang rai nga ndai- ngai hpe karum la na tin tin du rit law!
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Matsan mayan masha ni a matu, myit ru myit tsang ya nga ai ni gaw a nga ai; shanhte ru tsang hkrum nga ai shaloi, dai Madu gaw shanhte hpe karum la na ra ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu gaw shanhte hpe makawp maga ai hte shanhte a asak hpe kyem mazing da ya na ra ai; shi gaw dai lamu ga hta shanhte hpe kabu gara shangun nna, shanhte a gumlau hpyen ni a lata hta shanhte hpe shi kau da na wu ai n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte machyi makaw hkrum nga ai shaloi, dai Madu gaw shanhte hpe karum la na ra ai; shanhte hpe hkam kaja lam jaw ya na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />“ Madu e, nang hpe ngai yubak galaw kau ni ai; ngai hpe matsan dum la nna, ngai hpe shamai shatsai la e,” ngu nna ngai tsun ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a gumlau hpyen ni gaw nye a lam hpe matse ai hku tsun nga ma ai; shanhte gaw ngai si nna, masha ni ngai hpe malap kau na matu, ra sharawng nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai kaw sa chyai ai ni gaw myit kaja ai hte n sa ma ai; shanhte gaw nye a lam hte seng ai n kaja ai shiga hpe mahkawng shinggyin nna shara shagu de dai lam hpe tsun shabra ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai hpe n ju n dawng ai masha yawng hte gaw nye a lam hpe shanhte shada da gahte tsun ma ai; shanhte gaw nye a lam hpe grau sawng ai hku myit shapraw ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Shi gaw si machyi chyi nga nna, yupku kaw na galoi mung rawt lu sana n rai,” nga nna shanhte tsun ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai hpe grau nna kam hpa let ngai hte rau shat jawm sha ai nye a kaja htum ai manang wa pyi ngai hpe nhtang gumlau kau nu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu e, ngai hpe matsan dum la nna, hkam kaja ai lam ngai hpe bai jaw bang ya e; shaloi, nye a gumlau hpyen ni hpe ngai tai lu na ring ngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte ngai hpe dang kau lu na mara ai n rai, nang ngai hpe ra sharawng nga ndai gaw ngai chye lu na ring ngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Teng man ai amu hpe ngai galaw nga nngai majaw nang ngai hpe karum la na rin dai; nang gaw ngai hpe na a man e, htani htana bau sin na rin dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu Israela a Karai Kasang hpe shakawn mu! Ya kaw nna htani htana shi hpe shakawn ga law! Amen! Amen!
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shan nga gaw hka shi a katsi ai hka hpe marit nga ai zawn; Karai Kasang e, ngai mung nang hpe marit nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahkrung nga ai Karai Kasang e, ngai nang hpe shagroi gara nga nngai; ngai gaw na a man e, galoi wa mi she, sa wa lu nna, nawku daw jau lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai gaw shani shana hkrap nga nngai, shing rai, myi prwi ni sha, nye a lusha rai nga ai; “Na a Karai Kasang kanang nga nga a ta?,” nga nna aten shagu nye a gumlau hpyen ni ngai hpe san nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lai sai aten na lam hpe ngai myit dum yu ai shaloi, nye a myit hta grai yawn la nga nngai; Karai Kasang a nta de shawa masha ni hte rau ngai lung wa ai shaloi, kabu gara ai shawa hpawng gaw, Karai Kasang hpe mahkawn mangoi ai hte, kabu jahtau nhtawm, shanhte hpe woi hkawm lung wa yu ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai hpa majaw nde wa myit n pyaw nga nngai kun? Ngai hpa majaw nde wa ru tsang hkrum nga nngai kun? Ngai gaw Karai Kasang hta myit mada nga let, nye a hkye la Madu hte nye a Karai Kasang hpe kalang mi bai, shakawn na ring ngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw ndai yang e, bawng dung hkrum nga yang nye a myit grai kaji la nga li ai; shing rai, shi gaw yawn hkyen hpa langai hpang langai hpe hka leng ni zawn nye a wenyi a ntsa e hprwi di ya ni ai; jahten shaza ai wa gaw mawru hka zawn nye a man e wu kadu nga ai; dai gaw hka rum ni Hermon bum hte Miza bum kaw nna Yawdan hka de mu ngoi ai zawn wu kadu hkrat wa ai nsen hte bung nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw shani na aten hta, shi a dinggrin tsaw ra myit hpe madun dan ya u ga; shaloi, shana na aten hta, ngai mung mahkawn shakawn lu na nngai; nye a asak a Karai Kasang hpang de akyu hpyi lu n-ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nang gaw ngai hpe hpa majaw malap kau nga n ni? Nye a gumlau hpyen ni a gumshem ai hta ngai nni nkri hpe hpa majaw matut hkam sha ra nga a ta?,” ngu nna nye a shingbyi shara Karai Kasang hpe ngai tsun ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Na a Karai Kasang kanang nga nga a ta?,” nga nna shanhte ngai hpe tut tut san nga ma ai majaw, shanhte a jahpoi asawng ai nni nkri hpe hkam sha nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai hpa majaw nde wa myit n pyaw nga nngai kun? Ngai hpa majaw nde wa ru tsang hkrum nga nngai kun? Ngai gaw Karai Kasang hpe myit mada nga let, nye a hkye la Madu hte nye a Karai Kasang hpe kalang mi bai shakawn na ring ngai.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, ngai hpe mara n kap ai wa ngu nna tsun shana ya e; n kam n sham ai masha ni kaw na nye a maw mawn ai lam hpe makawp maga ya e. Masu magaw ai ni hte n hkru n shawp ai masha ni a lata kaw nna ngai hpe hkrang shaw la e!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang gaw ngai hpe makawp maga ai wa rai nga ndai; ngai hpe hpa majaw nang kau da nga n ta? Nye a gumlau hpyen ni a gumshem ai hta ngai hpa majaw nni nkri hpe matut hkam sha ra nga a ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a nhtoi hte na a teng man ai lam hpe jaw dat rit, dai gaw ngai hpe woi lakawn mat wa nna; na a chyoi pra ai Ziun Bum hte nang shanu nga ai Nawku Htingnu de woi wa u ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi, Karai Kasang e, na a tawn hkungri de ngai sa wa lu na ring ngai; nang gaw nye a kabu gara ai chyeju hka hpawk rai nga ndai. O Karai Kasang e, nye a Karai Kasang e, nye a tingse hpe dum ai hte nang hpe ngai mahkawn shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai hpa majaw nde wa myit n pyaw nga nngai kun? Ngai hpa majaw nde wa ru tsang hkrum nga nngai kun? Ngai gaw Karai Kasang hta myit mada nga let, nye a hkye la Madu hte nye a Karai Kasang hpe kalang mi bai ngai shakawn na ring ngai.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, anhte a na ni hte dai lam hpe anhte na yu saga ai. Anhte a kaji kawa ni mung, lai mat wa sai nhtoi ni ngu ai, shanhte a aten hta, nang galaw shapraw dan sai galu kaba ai amu ni ngu ai;
  </para>
  <para style="p">
    <verse number="2" style="v" />maigan masha ni hpe nang kaning rai shaden kau sai lam, shanhte a mungdan hta na a amyu masha ni hpe shanu nga na matu shara jahkrat ya sai lam, kaga amyu baw ni hpe nang ari jaw kau nna na a amyu masha ni hpe ngamu ngamai shangun nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a amyu masha ni gaw dai lamu ga hpe shanhte a nhtu ni hte gasat dang la lu ma ai n rai; shanhte a n-gun atsam hte dai mung hpe lu la ai n rai. Dai gaw na a daru magam atsam hte na a chyalai n-gun shanhte hpe na a tsaw ra myit madun sai ngu ai nang shanhte hte rau shanu nga ai ga sadi ni a majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang gaw nye a hkawhkam wa hte nye a Karai Kasang rai nga ndai; na a amyu masha ni hpe awng padang nang jaw ya nga ai rai nna,
  </para>
  <para style="p">
    <verse number="5" style="v" />anhte gaw gumlau hpyen ni hpe na a daru magam n-gun hte dang ga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw nye a ndan hpe n kam nngai, nye a nhtu mung ngai hpe hkye la lu ai n rai;
  </para>
  <para style="p">
    <verse number="7" style="v" />rai ti mung, nang gaw anhte hpe gumlau hpyen ni a lata kaw na hkye hkrang la nit dai; anhte hpe n ju n dawng ai ni hpe mung dang kau ya nga nit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anhte gaw nang hpe tut nawng e shakawn nga na ga ai, nang hpe htani htana chyeju dum nga na ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung, ya chyawm gaw nang anhte hpe kau da nit dai hte sum shangun kau nit dai; nang gaw anhte a hpyen luksuk ni hte rau majan pa de kachyi mi mung n pru sa nit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw anhte hpe anhte a gumlau hpyen ni kaw nna jahtaw jahprawng kau shangun nhtawm, shanhte gaw anhte a arai ni hpe shanhte a matu, hpya la kau manu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sagu ni hpe zawn anhte hpe sat kau na matu, nang ahkang jaw kau nit dai; nang gaw anhte hpe maigan mungdan ni de shabra kau nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a amyu masha ni gaw manu kachyi mi sha dan nga ai ni hpe zawn nang shanhte hpe manu kachyi mi hte sha dut kau nga nit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anhte a htingbu ni gaw nang anhte hpe kaning di kau sai lam hpe mu nga ma ai rai nna, shanhte gaw anhte hpe ashu ai hte mani asawng nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amyu baw ni a ka-ang e, nang anhte hpe mani chyai hpa galaw kau nit dai rai nna; shanhte gaw shanhte a baw kanga let, anhte hpe jahpoi asawng nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw tut nawng e, myi man sum nga nngai;
  </para>
  <para style="p">
    <verse number="16" style="v" />nye a gumlau hpyen ni hte ngai hpe n ju n dawng ai ni a asawng asang ai hte n kaw n law re ai ni a nsen ni hpe na lu ai majaw; ngai gaw kaya kahpa hte htinggrum da hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anhte gaw nang hpe n malap kau nga ga ai hte anhte hpe nang tawn da ya sai ga shaka hpe mung n jahten sharun kau ga ai; rai ti mung, dai lam ni yawng gaw anhte hta byin nga sai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anhte gaw nang hta sadi n dung nga saga ai n rai; na a hkang da ai ga ni hpe mung, anhte n hkan ai sha, lale kau ga ai n rai;
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai ti mung, zai ai dusat ni a ka-ang hta, nang anhte hpe matsan mayan tawn kau da nna; htat htum ai si ai shingnip hta nang anhte hpe kabai kau da nit dai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anhte a Karai Kasang hpe nawku daw jau nga ai hpe anhte jahkring kau nna; tsasam karai hpe akyu hpyi nga ga ai rai yang,
  </para>
  <para style="p">
    <verse number="21" style="v" />anhte a kraw kata e makoi da ai myit sawn lam ni hpe nang chye ya nga ndai majaw; nang dai lam hpe teng teng mu chye kau na ndai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai ti mung, na a majaw anhte aten shagu sat kau ai hkrum nga ga ai; sat na san da hkrum ai sagu ni zawn, anhte nawn da ai hkrum nga ga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Madu e, rawt u! Nang hpa rai yup pyaw nga n ta? Na a myit hpe shajin u! Anhte hpe htani htana hkum kau da nga et!
  </para>
  <para style="p">
    <verse number="24" style="v" />Nang gaw hpa rai anhte kaw na makoi nga n ta? Anhte a nni nkri hte ru tsang lam hpe hkum malap kau ya mi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anhte gaw ga du hkra kadawng agrawp nga ga ai; anhte sum mat ga ai majaw, ga nhpu ntsa e, galeng taw nga ga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anhte hpe karum la na sa rit! Na a dinggrin tsaw ra myit a majaw, anhte hpe hkye hkrang la mi law!
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hkawhkam wa a matu, ndai mahkawn hpe ngai jahtuk ai majaw; nye a myit masin hta tsawm htap ai ga ni hte hpring nga li ai. Kungkyang ai laika ka shara wa lang ai pen zawn, nye a shinglet gaw ga shagawp tsun na jin jin rai nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang gaw lasha ni hta ahpraw tsawm htum ai wa rai nga ndai; nang gaw ga shaga ningtam rawng ai wa rai nga ndai. Dai majaw Karai Kasang nang hpe tut nawng shaman ya nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />N-gun chyalai rawng ai hkawhkam wa e, na a nhtu hpye u; nang gaw hpung shingkang hte daru magam hpring nga ai wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Teng man ai hte rap ra ai tara hpe makawp maga let awng dang ai kaw du hkra, hpung shingkang hta jawn sa wa u! Na a n-gun gaw nang hpe galu kaba ai awng padang ninglaw ni hpe hkam la shangun na ra ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a pala ni masen nga ai rai nna, na a gumlau hpyen ni a masin salum ni hpe galun htinggrang ya nga ai. Masha amyu ni mung na a lagaw nhpang e, dingnyawm na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang nang hpe jaw ya nit dai mungdan gaw htani htana prat dingsa agrin nga na ra ai. Nang gaw na a amyu masha ni hpe teng man ai tara hte up hkang na ra ai rai nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />ding man ai lam hpe nang tsaw ra nga ai hte, n hkru n shawp ai amu hpa hpe mung n dawng nga ndai. Dai re ai majaw, Karai Kasang na a Karai Kasang gaw nang hpe lata la nit dai; kaga hkawhkam kadai wa hta mung, grau nna kabu gara ai lam, nang hpe jaw ya nga nit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a hpun palawng ni gaw mura, achyaw ni hte manam pyaw nga ai; tingse dum ai ni mung magwi kawng hte mawn sumli da ai hkawhkam htingnu ni hta nang hpe shangwi shapyaw ya nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a hkawhkam htingnu na shayi sha ni hta hkawhkam ni a shayi sha ni mung lawm nga ma ai; na a tingnyang a hkra maga de, htoi kabrim ai ja hte mawn sumli da nga ai hkawhkam jan tsap nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkawhkam wa a num nnan jan e, ngai hpa tsun na lam hpe madat la u; na a amyu masha ni hte na a makyin jinghku ni hpe malap kau u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a tsawm htap ai ahpraw shingyan gaw hkawhkam wa hpe myit gang ra sharawng shangun na ra ai; shi gaw na a madu rai nga ai rai nna nang shi a ga hpe madat mara nga ra nga ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Turu amyu masha ni nang hpe kumhpaw kumhpa sa jaw na mara ai; sut su ai ni mung na a myi man tam wa na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkawhkam shayi sha gaw hkawhkam htingnu kata hta nga nga ai-shi gaw kade wa tsawm htap nga a hka! Shi a palawng galu ni hpe ja ri hte da da nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nsam amyu hkum ai palawng galu ni hte sumli nna; shi a shingnan hkawn sek ni mung hkan bawp nang ma ai hte, hkawhkam wa hpang de sa wa ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kabu gara re ai myi man hte shanhte pru sa wa nna; hkawhkam wa a hkaw de shang sa wa ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nye a hkawhkam wa e, na a kaji kawa hkawhkam hkringhtawng matut hkam la lu na matu; nang hta shadang sha law law shaprat wa na ra ai, nang gaw shanhte hpe aga ting a ntsa e, du salang shatai na rin dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a mahkawn ga gaw na a amying hpe htani htana dan hkung shangun na ra ai; masha shagu hte mung nang hpe prat ting shakawn kungdawn nga na mara ai law.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw anhte a shingbyi shara hte n-gun rai nga ai; ru tsang hkrum ai aten ni hta karum la na, tut nawng jin jin rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai re ai majaw, ginding aga gaw ashun awam nga nna, bum ni sung ai hka nawng kaba hta di hkrat bang nhtawm;
  </para>
  <para style="p">
    <verse number="3" style="v" />panglai hka ni wu kadu nga ai hte dai ni rawt hta wa ai a majaw, kawng ni ashun nga ma ti mung, anhte hkrit ra na ga ai n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang a mare ngu ai, Tsaw Htum Ai Wa a chyoi pra ai nta hpe kabu gara shangun ai hka nu langai mi nga nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang gaw dai mare hta shanu nga nna, dai mare gaw galoi mung jahten kau ai hkrum na n rai; jahpawt manap jau jau e, dai mare hpe shi karum la na matu pru sa na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Masha amyu ni hkrit kajawng nga masai, mungdan ni ashun awam nga masai; Karai Kasang gaw mu shangoi dat wu ai hte mungkan ga gaw byawng mat nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Chyahtum Chyalai N-gun rawng ai Madu gaw anhte hte rau rai nga ai; Yaku a Karai Kasang gaw anhte a shingbyi shara rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sa marit, dai Madu hpa galaw da sai amu ni hpe yu mu. Ginding aga a ntsa e, shi galaw da sai mauhpa amu ni hpe mada yu mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw mungkan ga na majan ni yawng hpe shazim kau nna; ndan ni hpe shi shadaw kau let, ri ni hpe jahten kau nhtawm, hpyen ninggang ni hpe wan hta nat kau nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw, “Gasat gala ai lam hpe jahkring kau mu, ngai gaw masha amyu baw ni a ka-ang e mung, mungkan ting a Karai Kasang rai nga nngai hpe mung chye mu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chyahtum Chyalai n-gun rawng ai dai Madu gaw anhte hte rau nga nga ai; Yaku a Karai Kasang gaw anhte a shingbyi shara rai nga ai law.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha amyu yawng hte e, kabu gara ai hte lahpawk dum mu! Nsen sharawt ai mahkawn mangoi ga ni hte Karai Kasang hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsaw Htum ai dai Madu gaw hkrithpa wa rai nga ai; shi gaw mungkan yawng hpe up hkang nga ai galu kaba ai hkawhkam wa rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw anhte hpe masha amyu ni hpe dang lu ai, awng padang lam jaw ya nga ai; shi gaw anhte hpe masha amyu baw ni hpe up hkang shangun nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw anhte shanu nga na lamu ga hpe anhte a matu lata san ya nga sai; dai gaw shi tsaw ra ai shi a amyu masha ni a gumrawng mai ai sut gan rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang gaw shi a tingnyang de lung nga ai. Dai Madu lung wa yang, kabu gara jahtau garu ai nsen hte pahtau dum ai nsen ni hpe na lu nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang hpe mahkawn shakawn mu! Anhte a hkawhkam wa hpe mahkawn shakawn mu!
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang gaw mungkan yawng hpe up ai hkawhkam wa rai nga ai; mahkawn mangoi ga ni hte shi hpe shakawn kungdawn mu!
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang gaw shi a chyoi pra ai tingnyang hta dung nga ai; shi gaw amyu baw ni yawng hte hpe up hkang nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Masha amyu baw ni a du salang ni gaw Abraham a Karai Kasang a amyu masha ni hte rau hpawng nga ma ai. Hpyen dap ni yawng hta daru magam n-gun shi grau kaba nga ai; shi gaw tsaw htum ai hku up hkang nga ai.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw galu kaba nga ai rai nna shi a chyoi pra ai bum ntsa e nga ai anhte a Karai Kasang a mare hta shi hpe tsaw htum ai hku shakawn kungdawn ra nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang a bum ngu ai Ziun gaw tsaw nga nna, tsawm htap nga ai; galu kaba ai hkawhkam wa a mare gaw mungkan amyu masha ni yawng hte hpe, kabu gara shangun nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai mare a hpyen dap kata ni hta shi hte rau shim lum nga ai hpe Karai Kasang madun dan nu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hkawhkam ni jawm hpawng nga nna, Ziun bum hpe htim gasat na matu, shanhte pru sa wa ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai ti mung, shanhte gaw dai bum hpe mu ma ai shaloi mau mahka mat nhtawm; hkrit kajawng ai hte hprawng mat ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw dai yang e, ma shangai hkyen nna shinggyim machyi hkrum ai num hte,
  </para>
  <para style="p">
    <verse number="7" style="v" />laja lana re ai nbung laru kata, le de, wo de, adawt kanga hkrum nga ai sanghpaw li zawn hkrit gari ai hte ruyak kyindut hkrum hkra nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang hpa galaw dan sai amu hpe anhte mu lu sagaw ai; Chyahtum Chyalai n-gun rawng ai Madu anhte a Karai Kasang a mare hta, dai lam hpe anhte ya mu lu saga ai. Shi gaw dai mare hpe htani htana shim nga shangun na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />O Karai Kasang e, na a Htingnu kata hta na a dinggrin tsaw ra myit a lam hpe anhte myit yu ga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw shara shagu hkan nga nga ai amyu masha ni a shakawn kungdawn ai hkrum nga ndai; na a mying nsang aga ting hta kajai gumhkawng nga ai, nang gaw teng man ai tara hte up hkang nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ziun a amyu masha ni kabu gara lu mu ga! Teng man ai tara dara lam ni hpe nang jaw ya nga ai; Yuda mung na mare ni hta kabu gara ai gaw anga nga u ga law!
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang a amyu masha ni e, Ziun hpe shinggrup hkawm ai hte de a langchyi ni hpe hti yu mu;
  </para>
  <para style="p">
    <verse number="13" style="v" />de a mare bunghku ni hpe matsing nna, de a hpyen dap ni hpe san jep yu mu, shing rai jang,
  </para>
  <para style="p">
    <verse number="14" style="v" />nanhte gaw, “Dai Karai Kasang gaw htani htana prat dingsa na anhte a Karai Kasang rai nga ai; shi gaw anhte hpe prat ting lam woi wa na ra ai,” nga nna hpang ban prat masha ni hpe hkai dan lu na myit dai.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha shagu, ndai ga hpe madat la mu! Shara shagu hkan na,
  </para>
  <para style="p">
    <verse number="2" style="v" />galu kaba ai hte kaji kadun nga ai ni, sut su ai ni hte matsan mayan masha ni n nga, yawng hte e, madat la mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a myit sawn ai lam ni gaw asan sha rai na ra ai; ngai gaw hpaji ga ni hpe tsun na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw ga shagawp ni hte seng ai ga ni hpe tsun nna; dai ni a lachyum ni hpe tingse dum let shaleng dan na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte a sut gan ni hta kam hpa nga nna, shanhte a n taw n tsang sut su ai lam hta shakawng shakat rai nga ai n hkru n shawp ai ni hte gumlau hpyen ni a majaw ngai gaw wang shinggrup da hkrum nga nngai, ngai gaw hkrit tsang ra ai aten ni hta pyi n hkrit nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Masha gaw shi a hkum hpe shi nan galoi mung hkrang la lu ai n rai; shi gaw Karai Kasang hpe shi a bunglat n jaw lu nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpa majaw nga yang, masha a asak bunglat gaw nau wa kaba la nga ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />shi hpe lup wa de n shang hkra htani htana hkrung nga shangun lu na matu shi jaw lu ai manu gaw dang law nga ai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hpaji chye chyang ai masha ni rai ti mung, angawk angak re ai hte mana ai masha ni du hkra pyi, si ai hpe n lai lu ai gaw, kadai mung chye lu nga ai. Shanhte yawng gaw shanhte a sut gan ni hpe shanhte a matu mara ni a matu, htawng da ya nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw shanhte a lamu ga ni hpe kalang mi madu da yu sai ni rai nga ma ti mung; shanhte a lup sung hku ni gaw shanhte a htani htana dum nta rai nga ma ai; shanhte gaw dai shara hta aten tup rawng nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Masha a galu kaba ai lam gaw si ai kaw nna shi hpe n lu hkum da nga ai; shi gaw dusat ni zawn naw si wa na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte a hkum ni hpe kam hpa nga ai ni hta hpa byin wa na lam hte shanhte a sut gan ni hta myit dik dum nga ai ni a gam maka hpa rai na re ai hpe yu yu mu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte gaw sagu ni zawn si na matu dingnye lu ma ai, Si du gaw shanhte hpe rem ai sagu rem wa rai na ra ai. Shanhte a hkum tsawp ni gaw shanhte a dum nta hte tsan ai Katsan ga kaw alawan yat mat wa yang; dai ding hpring ai masha ni gaw shanhte hpe padang dip lu na mara ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, Karai Kasang gaw ngai hpe mawai la nna; shi ngai hpe si du a lata kaw nna hkye hkrang la na ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Masha langai mi sut gan lu su wa nna; shi a sut gan n taw n tsang law htam jat wa ai shaloi, myit gale galau hkum rai nga et;
  </para>
  <para style="p">
    <verse number="17" style="v" />shi si wa yang, dai ni hpe shi hte rau la mat wa lu nga ai n rai; shi a sut gan ni shi hte rau lup sung hku kata de hkan shang lu ai n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Masha langai wa mi gaw ndai prat hta e, myit dik dum nna, shi awng dang ai amu hta shakawn ai hkrum sha nga tim pyi,
  </para>
  <para style="p">
    <verse number="19" style="v" />shi si ai aten hta, shi a kaji kawa ni yawng nga ai htani htana sin mak ai shara hta rau wa nga na ra ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Masha a galu kaba ai lam gaw si ai kaw nna, dai ni hpe n lu hkum da nga ai; Shi gaw dusat ni zawn naw si wa na ra ai.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Chyahtum Chyalai n-gun rawng ai Madu Karai Kasang mungga tsun ai; sinpraw kaw nna sinna maga du hkra na mungkan ting hpe shi shaga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang gaw shi a hkum tsup tsawm htap nga ai Ziun mare kaw nna, nhtoi shatu dat wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte a Karai Kasang sa wa nga ai rai tim, atsin sha du sa nga ai n rai; shi a man e wan shinglet ni hkru nga nna shi a makau mayang hkan e, laru kaba ru nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a amyu masha ni hpe shi tara jeyang ai hpe mu lu na matu, Madu gaw sumsing lamu hte ginding aga hpe sakse shatai na nga, shaga dat wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Hkungga nawng jau let, ngai hte ga shaka tawn da ai ni, nye a kangka ai amyu masha ni hpe ngai hpang de woi hpawng mu,” nga nna shi tsun ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang gaw ding hpring ai wa rai nna, shi nan tara agyi rai nga ai hpe sumsing lamu gaw shana shabra ya nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Nye a amyu masha ni e, madat mu, ngai ga tsun nga nngai; Israela e, ngai nang hpe mara madun ai sakse hkam na nngai; Ngai gaw Karai Kasang na a Karai Kasang rai nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a shagu hkungga ni hte wan nat hkungga ni ngai hpe tut nawng jaw jau ai majaw, ngai nang hpe daru na nngai n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung, na a sun na usu ni hpe mung, na a wuhpung na bainam ni hpe mung, ngai n lang ra nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nam maling kata hkan nga ai dusat yam nga ni yawng hte kawng hkying mun ni hta nga nga ai yam nga ni yawng hte gaw nye a rai nga li ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ntsa malen u ni yawng hte udat pa hkan nga ai asak hkrung ai dusat ni yawng mung, nye a rai nga li ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Ngai kawsi ai hkrum wa yang lusha a matu ngai nang kaw hpyi na n rai; hpa majaw nga yang, mungkan ting hte dai hta nga ai arai yawng mayawng hte gaw nye a rai nga li ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai gaw dumsu shan sha nga a ni? shing n rai, bainam ni a asai hpe lu nga a ni?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyeju dum shakawn ai gaw Karai Kasang hpe na a shagu hkungga nawng jau ai lam rai nga u ga; Chyahtum Chyalai n-gun rawng ai Madu hpe nang ndat da ai ga sadi yawng hte hpe jaw ya u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ru tsang hkrum ai shaloi, ngai hpe shaga e, ngai nang hpe hkye hkrang la na nngai; shing rai, nang ngai hpe shakawn na rin dai,” nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai ti mung, Karai Kasang gaw n hkru ai wa hpe, “Nang hpa majaw nye a hkang da ai ga ni hpe hti shakrai nga na rai ta? Nang hpa majaw nye a ga shaka lam ni hpe tsun nga na rai ta?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai shading sharai ai ga hpe nang ningdang kau nna; nye a hkang da ai ga ni hpe nang nyet kau nga ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang mu hkrup ai lagut shagu hte a manang nang tai nna; numshaw lashaw ai ni hte rau nang kanawn nga ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Nang gaw n hkru ai ga shaga na matu, tut nawng e, jin jin rai nga ndai; masu magaw ga ni hpe tsun shaga na, nang galoi mung lit li nga ai n rai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na chyurum hpu nau ni hpe mara shagun na hte shanhte hpe mara tam na matu mung; nang hta jin jin rai nga ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai lam yawng hte hpe nang galaw nit dai, ngai hpa mung n shaga nngai majaw, nang zawn ngai rai nga nngai ngu nna nang myit la nga ndai; rai ti mung, ya chyawm gaw, ngai nang hpe daru sharin na nngai hte nang hpe dai lam asan sha tsun dan na nngai.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Ngai hpe malap mali rai nga ai wa nang e, ndai ga ni hpe madat yu u: shing n rai, ngai nanhte hpe jahten sharun kau na nngai, nang hpe hkye hkrang la na kadai mung nga na n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chyeju dum ai shagu hkungga gaw ngai hpe shagrau sha-a ai lam rai nga ai; nye a ga madat mara ai ni yawng hte hpe ngai teng teng hkye hkrang la na nngai.”
  </para>
  <chapter number="51" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, na a dinggrin tsaw ra myit a majaw, ngai hpe matsan dum la e. Na a galu kaba ai matsan dum myit a majaw, nye a yubak ni hpe arut kau ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a n hkru n shawp ai lam yawng hte hpe kashin kau ya nna, nye a yubak kaw na ngai hpe jasan jaseng la e!
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a shut hpyit ai mara ni hpe ngai matsing nga nngai; nye a yubak ni hpe ngai tut nawng adum nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai nang hpe yubak galaw shut kau ni ai- nang hpe chyu sha shut kau ni ai. Nang myit yu ai n hkru n shawp ai lam hpe ngai galaw shut kau ni ai. Dai majaw, ngai hpe tara jeyang ai hta nang gaw teng man nga ndai; ngai hpe daw dan jeyang ai hta nang ding hpring nga ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai shangai wa ai shani kaw nna, ngai gaw n hkru n shawp nga nngai; nu a hkritung kaw nna pyi, ngai hta yubak kap nga ni ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang gaw myit malang ai hte teng man ai lam hpe hpyi nga ndai majaw; nye a kraw lawang hta na a hpaji hte jahpring ya e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a yubak hpe la kau ya e, shing rai jang, ngai san pra wa lu na nngai; ngai hpe kashin la e, shing rai jang, ngai gaw hkyen hta pyi grau hpraw wa lu na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kabu gara ai hte ngwi pyaw ai nsen ni ngai hpe na shangun et; nang ngai hpe daw agrawp kau ai rai ti mung, ngai kalang mi bai naw kabu gara wa lu na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a yubak ni hpe n mu lu u ga, na a myi ni hpe di da u; nye a n hkru n shawp ai lam yawng hte hpe arut kau ya e.
  </para>
  <para style="p">
    <verse number="10" style="v" />O Karai Kasang e, san seng ai myit ngai hta hpan shapraw ya e; sadi dung ai wenyi hte myit masin nnan ngai hpe jaw ya rit.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a myi man kaw nna ngai hpe hkum shaden kau et; na a chyoi pra ai wenyi ngai kaw na hkum dawm la kau ya e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a hkye hkrang la ai kaw na lu la ai kabu gara ai lam, ngai hpe bai jaw ya e; nang hpe madat mara mayu ai myit ngai hta bang ya e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi, yubak mara lu ai masha ni hpe na a hkang da ai tara lam ni hpe ngai sharin ya na nngai; shanhte gaw shi hpang de kayin wa na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang e, nye a asak hpe shalawt ya nna, ngai hpe hkye hkrang la e; na a ding man ai lam hpe ngai kabu gara htawn tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu e, ga shaga lu na matu, ngai hpe karum la e; shing rai, ngai nang hpe shakawn na nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang gaw shagu hkungga ni hpe n ra sharawng nga ndai, shing n rai yang, ngai sak jaw na de ai; nang gaw wan nat hkungga ni hpe mung n ra sharawng nga ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />O Karai Kasang e, nye a shagu hkungga gaw shagrit shanem ai myit rai nga li ai; shagrit shanem ai myit hte myit malai ai myit masin hpe nang n ningdang kau na ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Karai Kasang e, Ziun hpe matsan dum nna shi hpe karum u; Yerusalem mare a bunghku ni hpe bai gaw gap da u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai shaloi, nang gaw ra n rawng ai shagu hkungga ni hte anhte a wan nat hkungga ni hta sharawng awng wa na rin dai; na a tawn hkungri ntsa e mung, usu ni hpe nawng jau wa na mara ai.
  </para>
  <chapter number="52" style="c" />
  <para style="p">
    <verse number="1" style="v" />Galu kaba ai masha wa e, nang gaw hpa majaw na a n hkru ai lam hta gumrawng nga n ta? Karai Kasang a tsaw ra myit gaw htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a shinglet gaw dai kara rep nhkyi zawn kaga ni hpe jahten sharun na, maw mawn nga ndai. Nang gaw masu magaw ga hpe tut nawng e, gyin shalat ai wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw kaja ai hta n hkru ai hpe, teng man ai hta shut hpyit ai hpe grau nna tsaw ra nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masu magaw ai wa e, nang gaw na a n-gup ga ni hte masha kaga ni hpe myit machyi mat hkra, tsun na hpe ra sharawng nga ndai!
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai majaw, Karai Kasang gaw nang hpe htani htana jahten sharun kau na ra ai; shi gaw nang hpe na a nta kaw nna gang gare la na ra ai. Shi nang hpe asak hkrung nga ai ni shanu nga ai mungkan ga kaw nna la kau na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ding hpring ai masha ni dai lam hpe mu nna hkrit wa na mara ai; shaloi shanhte nang hpe mani ashu let, tsun ai gaw,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Yu u, ndai yang e, shi a shim lam a matu Karai Kasang hpe n kam hpa ai sha, de a malai shi a law la ai sut gan hte n hkru n shawp ai amu hta shim lam tam nga ai masha langai mi, nga nga ai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung, ngai gaw Karai Kasang a nta na tsit lali ai tsanlun hpun zawn rai nga nngai; Ngai gaw shi a dinggrin tsaw ra myit hpe htani htana prat dingsa kam hpa nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang e, nang galaw dan sai amu magam ni a majaw ngai tut nawng e, chyeju dum nga na nngai; na a amyu masha ni a man e, nang mai kaja nga ndai hpe ngai htawn tsun na nngai.
  </para>
  <chapter number="53" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Karai Kasang n nga ai!,” nga nna angawk ai ni gaw shanhte a myit hta tsun nga ma ai. Shanhte yawng hte gaw tsam mat nga ma ai, hkrithpa amu ni hpe, shanhte galaw kau ma ai; dai teng man ai amu hpe galaw na masha kadai mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi hpe nawku daw jau na hte hpaji rawng nga ai ni kadai rai tim nga dam ai rai yang, dai hpe mada yu na matu, Karai Kasang gaw sumsing lamu kaw nna shinggyim masha ni hpe gum yu nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai ti mung, shanhte yawng hte gaw shut hpyit ma masai; shanhte yawng hte wa maren n kaja nga ma ai. Dai teng man ai amu galaw ai masha shanhte hta langai mi mung n nga nga ai, kaja wa, langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang gaw, “Shanhte n chye na ma ai kun? Ndai n hkru n shawp ai amu galaw ai ni yawng hte wa, gri magra re ai ni rai nga ma ai kun? Shanhte gaw nye a amyu masha ni hpe hpya sha let nga nga ma ai hte, ngai kaw galoi mung akyu n hpyi yu ma ai,” nga nna san nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi, shanhte gaw shawng de galoi mung garai n hkrum kadup yu ai kaba la ai hkrit kahpra lam hpe hkrum hkra wa na mara ai; hpa majaw nga yang, Karai Kasang gaw shi a amyu masha ni a gumlau hpyen ni a nrut nra ni hpe gat kau ya na ra ai. Karai Kasang shanhte hpe ningdang kau mu ai majaw, Israela amyu masha ni shanhte hpe awng dawm dang kau na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israela amyu masha ni a awng padang gaw Ziun kaw nna du sa na matu, ngai kade sha akyu hpyi nga a hka! Karai Kasang gaw Israela amyu masha ni hpe kalang mi bai ngamu ngamai shangun ai shaloi shanhte kade sha kabu gara lu na ma hka!
  </para>
  <chapter number="54" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, na a daru magam n-gun hte ngai hpe hkye hkrang la e; na a grau htum ai n-gun hte ngai hpe shalawt dat e!
  </para>
  <para style="p">
    <verse number="2" style="v" />O Karai Kasang e, nye a akyu hpyi ga hpe na ya e; nye a n-gup aga ni hpe madat ya e!
  </para>
  <para style="p">
    <verse number="3" style="v" />Gumrawng gumtawng ai ni ngai hpe gasat na matu sa wa nga ma ai; Karai Kasang hpe hpa zawn n nawn nga ai masha mazut ni mung, ngai hpe sat na matu shakut nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai ti mung, Karai Kasang gaw ngai hpe karum la ai wa rai nga ai; dai Madu gaw ngai hpe makawp maga ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a gumlau hpyen ni hpe ari jaw na matu Karai Kasang gaw shanhte a n hkru ai hpe bai tai u ga; shi gaw sadi sahka myit rawng nga ai majaw, shanhte hpe shi shamyit kau na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />O Madu e, ngai nang hpe kabu gara ai myit hte shagu hkungga ni nawng jau na nngai; nang mai kaja nga ndai majaw ngai nang hpe chyeju dum nga na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a ru tsang lam yawng kaw na, nang ngai hpe mawai la nga nit dai, nye a gumlau hpyen ni sum mat ai hpe ngai mu se ai.
  </para>
  <chapter number="55" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, nye a akyu hpyi ga hpe na ya e; ngai hpyi lajin ai hpe myi man hkum kayin kau ya e!
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hpe madat ya nna htan ya e; nye a myit ru myit tsang ai lam ni hta ngai hki ba la nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a gumlau hpyen ni a jahkrit shama ai a jaw e, ngai hkrit gari nga nngai; tara n lang ai ni a dip gamyet sha ai hta ngai agrawp ayai ai hkrum nga nngai. Shanhte gaw ngai hpe sharu shatsang nga ma ai; shanhte ngai hpe masin pawt let n ju n dawng nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Si Du a jahkrit shama ai gaw ngai hpe dip gamyet ai rai nna, ngai hkrit gari nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw nau hkrit gari mat ai majaw ging mat ni ai; ngai gaw kajawng kaja re ai hte htinggrum da ai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkrudu zawn singkaw tu na hpe ngai kade sha marit nga nngai. Hkrudu zawn singkaw tu taw gaw tsan tsan de pyen hkawm mat wa nna ban sa lu na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tsan tsan de ngai pyen hkawm mat wa nna, nam mali hpe nye a nta shatai na we ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai gaw nbung bungga hte laru kaba kaw nna lawt na, nye a matu shingbyi shara langai mi hpe tam na we ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />O Madu e, nye a gumlau hpyen ni a tsun shaga ai ga ni hpe shanut kau ya u! Mare kata hta kashun kashe, du daw sai hkaw re ai hte aruk arak nga ai hpe ngai mu nngai;
  </para>
  <para style="p">
    <verse number="10" style="v" />dai mare hpe shani shana kawan hkawm nna, dai mare hta ru hka amu hte myit ru myit tsang ai hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hten za ai amu gaw shara shagu hte hta nga nga nna lam nmaw ni hta mung; dip lu dip sha ai hte masu magaw ai ni hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gumlau hpyen wa ngai hpe mani asawng ai rai yang, ga dai hpe hkam lu na nngai; nye a hpyen wa nye a ntsa e, gumrawng gumtawng nga ai rai yang, shi kaw na ngai makoi mat lu nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai ti mung, dai zawn galaw ai gaw nye a manaw manang wa, nye a kanawn manang wa hte hkau chyap ai manang nan rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />An shada da grai hku hkau ai hte shaga chyai lu saga ai sha n ga; Nawku Htingnu kata hta rau sha nawku daw jau yu saga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nye a gumlau hpyen ni gaw shanhte a aten garai n du yang si htum mat mu ga; shanhte gaw katsan ga de jahkrung sa mat wa mu ga! Dai n hkru n shawp ai gaw shanhte a dum nta ni hte shanhte a myit kraw lawang ni hta rawng nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai ti mung, karum la na matu ngai gaw Madu Karai Kasang hpe hpyi shaga ai; shi ngai hpe hkye hkrang la na ra ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jahpawt manap, shani ka-ang hte shana na aten ni hta, nye a hpyi aput ai hte madai ai nsen gaw shi kaw hkrang lung wa ai; shi gaw nye a nsen hpe na ya na ra ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gumlau hpyen law law ni hpe ngai hkap gasat ai majan ginra kaw na; shi ngai hpe shim ai hku bai woi wa na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Moi chyaloi nhkoi prat kaw nna up hkang nga ai Karai Kasang gaw nye a akyu hpyi ga hpe na ya nna, shanhte hpe dang kau na ra ai. Shanhte gaw myit n malai hkraw nga ma ai, shi hpe hkrit kamyin ai myit mung n rawng nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a shawng na manang wa gaw shi a jinghku ni hpe gasat nna; shi a ga sadi ni hpe mung, jahten kau nu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a n-gup aga ni gaw htawbat hta grau manen nga ai; shi a myit masin kata hta n dawng ai myit rawng nga ai; shi tsun ai ga hkum ni gaw namman hta grau kya nga ti mung, dai ai nhtu zawn, gadoi di lu nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na a ru yak tsin-yam ni hpe Madu hta tawn da u, shi nang hpe makawp maga la na ra ai; ding hpring ai masha ni hpe shi galoi mung sum shangun nga ai n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai ti mung, Karai Kasang e, nang gaw masha sat ai ni hte masu magaw ai masha ni hpe shanhte a asak ka-ang garai n lai yang pyi shanhte a lup sung hku ni de, jahkrat kau na rai nga ndai. Ngai chyawm gaw nang hpe kam hpa nga na nngai.
  </para>
  <chapter number="56" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai gaw gasat gala ai hkrum nga nngai, nye a gumlau hpyen ni ngai hpe aten shagu zingri zingrat nga ma ai majaw, ngai hpe matsan dum la e law.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a hpyen ni ngai hpe shani tup gasat nga ma ai; ngai hpe gasat ninghkap ai ni grai law la nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chyahtum Chyalai n-gun rawng ai Madu e, ngai hkrit kahpra nga ai shaloi nang hpe ngai kam hpa nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw Karai Kasang hta kam hpa nga ai a jaw e, n hkrit nga nngai; shi jaw da sai ga sadi a majaw ngai shi hpe shakawn na nngai. Shinggyim masha sha gaw ngai hpe hpa di lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a gumlau hpyen ni ngai hpe shani tup sharu shatsang nga ma ai; ngai hpe lam maga ga hku nna, machyi shangun na matu, shanhte tut nawng e myit shapraw nga ma ai!
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw shim ai makoi shara hta hpawng nga nna, ngai galaw ai lam mahkra hpe shanhte lagyim yu ai hte, ngai hpe sat kau lu na matu myit mada nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />O Karai Kasang e, shanhte a n hkru n shawp ai lam a majaw, shanhte hpe ari jaw u; na a pawt sindawng ai hte dai masha ni hpe dang kau u!
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai ru tsang kade hkrum sha ni ai gaw nang chye nga ndai; nye a myi prwi jahpan hpe nang tawn da ya nna, na a laika buk hta jahpan dai ni rawng nga ai n rai ni?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai nang hpe shaga ai shani e, nye a gumlau hpyen ni htingnut mat wa ai hkrum na mara ai; Karai Kasang gaw nye a maga de nga nga ai hpe ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu a ga sadi ni a jaw e, ngai shakawn na nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi hpe ngai kam nngai majaw, ngai hkrit tsang nga na n rai. Shinggyim masha sha gaw ngai hpe hpa di lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="12" style="v" />O Karai Kasang e, nang gaw ngai hpe Si Du a lata kaw nna hkrang shaw la nhtawm; sum mat ai kaw nna mung, ngai hpe makawp maga la nit dai majaw,
  </para>
  <para style="p">
    <verse number="13" style="v" />ngai ga sadi tawn da ni ai hte maren, ngai nang hpe nawng jau na de ai, nye a chyeju dum ai shagu hkungga hpe mung, ngai nang hpe jaw jau na we ai. Shing rai, asak hkrung nga ai ni a ntsa e, htoi tu nga ai nhtoi ngu ai Karai Kasang a man e, ngai hkawm sa nga na nngai.
  </para>
  <chapter number="57" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw nang hta shim nga lu na matu du sa nngai majaw; Karai Kasang e, ngai hpe matsan dum la e, matsan dum la e law. Laru kaba ni lai mat wa ai aten du hkra, na a singkaw ni a shingnip hta ngai shingwung nga na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsaw Htum ai Karai Kasang ngu ai, nye a ra kadawn ai lam shagu hta karum la ai Karai Kasang hpe ngai shaga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw sumsing lamu kaw nna htan ya ai hte ngai hpe hkye hkrang la na ra ai; ngai hpe dip gamyet sha ai ni hpe shi dang kau na ra ai. Karai Kasang gaw shi a dinggrin tsaw ra myit hte sadi sahka myit, ngai hpe madun dan na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masha shan sha ai hkanghkyi ni zawn, gumlau hpyen ni wang shinggrup da ai ngai hkrum nga nngai. Shanhte a wa ni gaw nri hte pala ni zawn rai nga ai, shanhte a shinglet ni dai ai nhtu ni zawn rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />O Karai Kasang e, lamu hta na a hkik hkam ai lam hte ga ntsa ting hta mung, na a hpung shingkang dan hkung nga ai hpe madun dan u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a gumlau hpyen ni ngai hpe rim na matu nye a lam e, sumgawn jahkrat da nga ma ai; ngai gaw myit ru myit tsang hkrum nga nngai. Nye a lam hta shanhte nhkun htu tawn ma ai, rai tim shanhte mahtang dai kaw di hkrat bang ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang e, ngai tsep kawp kam hpa nga nngai; ngai nang hpe mahkawn mangoi hte shakawn na nngai!
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a wenyi e, dum hprang u! Nye a tingse hte sumpyi e, dum hprang u! Jan hpe mung ngai jasu na nngai!
  </para>
  <para style="p">
    <verse number="9" style="v" />O Madu e, amyu baw ni a ka-ang hta, nang hpe ngai chyeju dum nga na nngai. Amyu masha ni a man e, ngai nang hpe shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a dinggrin tsaw ra myit gaw sumsing lamu ni de dep nga ai; na a sadi sahka mung lamu kaw du hkra dep nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang e, lamu hta na a galu kaba ai lam hte aga ntsa ting hta e mung, na a hpung shingkang dan hkung nga ai hpe madun dan nga u law.
  </para>
  <chapter number="58" style="c" />
  <para style="p">
    <verse number="1" style="v" />Du salang ni e, nanhte gaw kaja wa teng man ai daw dan lam hpe jaw ya nga myit ni? Masha nlang hte hpe rap ra ai tara hku nna tara jeyang ya nga myit ni?
  </para>
  <para style="p">
    <verse number="2" style="v" />N rai law! Nang galaw lu na n tara ai lam hpe chyu sha nang myit nga ndai; ga ntsa na kashun kashe du daw sai hkaw ai amu ni hpe nanhte shut hpyit tawt lai nga myit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />N tara ai masha ni gaw shanhte a asak hkrun lam yawng hta shut hpyit ai hku hkawm sa nga ma ai; shanhte gaw shangai wa ai shani kaw nna masu magaw ai ga ni hpe tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lapu ni zawn, shanhte hta mung atuk hpring hkra rawng nga ma ai; na n na ai pu htum zawn shanhte a na ni hpe pat da ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lapu lakle sara wa a nsen hpe n na ai hte kung ai mandan sara wa a mahkawn ga hpe mung, n na ai na lahpang ai pu htum zawn, shanhte a na ni hpe pat da nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang e, ndai hkanghkyi matse ni a wa ni hpe shadaw kau ya u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw hkyet mat wa ai hka zawn hkoi mat wa mu ga; lam ntsa e tu ai tsing ni hpe zawn shanhte kabye anut kau ai hkrum nga mu ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hkoi lapawp gaw shi a bawp nen byawng mat ai zawn rai mat mu ga; nhtoi hpe galoi mung n mu yu ai nbya ma zawn, shanhte rai mat mu ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte dai lam hpe garai n tan chye lu yang, tsingdu ni hpe zawn, shanhte dan kau ai hkrum nga ma ai; shanhte gaw asak hkrung nga yang pyi, shi a pawt singdawng ai hta, Karai Kasang gaw shanhte hpe shapoi kau na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ding hpring ai ni gaw mara kap ai ni ari jaw hkrum ai hpe mu ai shaloi, kabu gara na mara ai; shanhte gaw tara n lang ai ni a asai hku kabye lai mat wa na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ding hpring ai ni gaw teng teng shagrau sha-a ai hkam la na mara ai; mungkan hpe tara jeyang na Karai Kasang gaw teng teng nga nga ai,” nga nna masha ni tsun wa na mara ai.
  </para>
  <chapter number="59" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Karai Kasang e, nye a gumlau hpyen ni kaw na, ngai hpe hkye hkrang la e; ngai hpe gasat ai ni a lata kaw nna mung, ngai hpe makawp maga la e!
  </para>
  <para style="p">
    <verse number="2" style="v" />N hkru n shawp ai masha ni a lata kaw nna ngai hpe hkye hkrang la e; masha sat amu galaw ai ni a lata kaw nna mung, ngai hpe mawai la e!
  </para>
  <para style="p">
    <verse number="3" style="v" />Yu u! Shanhte gaw ngai hpe sat na matu ala nga ma ai; mazut ai masha ni ngai hpe hkap daw na matu zup hpawng nga ma ai. O Madu e, shanhte gaw shanhte a shara ni hta gasat na matu jin jin rai nga ai lam gaw, ngai galaw shut kau sai shut hpyit lam, shing n rai, yubak a majaw mung n rai, dai sha n ga, nye a mara langai ngai a majaw mung n rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyahtum Chyalai n-gun rawng ai Madu Karai Kasang e, rawt u, ngai hpe karum la na sa rit; Israela a Karai Kasang e, nang hkum nan yu yu u! Rawt nna maigan masha ni hpe ari jaw u: gumle gumlau sadi n dung ai masha ni hpe matsan dum ai myit hkum madun nga et!
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw shana de nhtang wa nna, gwi ni zawn nying let, mare kata hkan, ningwan hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte a n kaw n law re ai hte jahkrit shama ai ga ni hpe madat ya u; shanhte a n-gup kata na shinglet ni gaw nhtu zawn dai nga ma ai; shanhte tsun shaga ai ga hpe kadai mung n na ma ai nga nna shanhte myit nawn da ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung, Madu e, nang gaw shanhte hpe mani kau nga ndai; tara maigan ni yawng hpe mung, nang ashu kau nga ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai gaw na a n-gun atsam hpe kam hpa nga nngai, O Karai Kasang e, nang gaw nye a shingbyi shara rai nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a Karai Kasang gaw ngai hpe tsaw ra nga ai rai nna, ngai kaw sa wa na ra ai, nye a gumlau hpyen ni sum mat ai lam shi ngai hpe madun dan shangun na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />O Karai Kasang e, shanhte hpe hkum sat kau et, shing n rai, nye a amyu masha ni malap kau na mara ai. Anhte hpe makawp maga ai Madu e, na a n-gun atsam hte shanhte hpe shabra kau nna, shanhte hpe dang kau u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yubak gaw shanhte a nten ni hta rawng nga ai, shanhte tsun shaga ai ga ni yawng mung yubak hkrai rai nga ai. shanhte gaw dagam dala ga hte masu magaw ga ni hpe tsun nga ma ai majaw; shanhte a gumrawng gumtawng ai mahkam hta ahkang nga mu ga!
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a masin kahtet ai hte shanhte hpe shamyit kau u, shanhte hpe atsai awai shamyit kau u. Shaloi, Karai Kasang gaw Israela hpe up hkang nga ai lam hpe masha shagu chye wa nna, shi a up hkang ai gaw mungkan ga ting a ntsa e, maden jat wa na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nye a gumlau hpyen ni gaw shana e nhtang wa nna, gwi ni zawn nying let, mare kata hkan, ningwan hkawn nga ma ai;
  </para>
  <para style="p">
    <verse number="15" style="v" />gwi ni zawn lusha a matu brak hkawm nga ma ai hte lusha shahpa law law shanhte n mu tam ai shaloi, ngoi garu nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai ti mung, na a n-gun atsam a lam hpe ngai mahkawn mangoi nga na nngai; na a dinggrin tsaw ra myit a lam hpe jahpawt manap shagu ngai ja ja mahkawn shakawn na nngai. Nang gaw nye a langchyi rai nga nna, ngai ru tsang hkrum ai aten hta na shingbyi shara rai nga nit dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai hpe makawp maga ai wa e, ngai nang hpe shakawn nga na nngai; Karai Kasang gaw nye a shingbyi shara rai nga ai, ngai hpe tsaw ra ai Karai Kasang mung rai nga ai.
  </para>
  <chapter number="60" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, nang gaw anhte hpe ningdang kau nna; anhte hpe sum shangun kau nit dai. Nang gaw anhte hpe masin pawt kau ti mung, ya chyawm gaw, anhte hpang de bai kayin mada la mi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang gaw lamu ga hpe gari ashun shangun nna, dai hpe nang kahtam hpaw kau nit dai; dai gaw ga ayai mat nga ai majaw ya dai nma ni hpe tsi shamai ya u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw na a amyu masha ni hpe nni nkri laja lana hkam sha shangun nit dai; anhte gaw chyaru nang ai ni zawn, ndi nda kayin hkawm nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang hpe hkrit hkungga ai ni gaw jahten shabyak ai kaw nna lawt wa lu na matu, shanhte hpe shadum jahprang nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a daru magam n-gun hte anhte hpe hkye hkrang la mi; anhte a akyu hpyi ai ga hpe mung htan ya mi, shing rai jang, nang tsaw ra ai amyu masha ni hkye mawai la ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi a chyoi pra ai shara kaw nna Karai Kasang gaw, “Awng padang hte ngai Shehkem hpe garan na nngai, Suhkot kadit hpe mung nye a amyu masha ni a lata de garan ya na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gilead gaw nye a rai nga ai, Manashe mung nye a rai nga li ai; Ehprim gaw nye a hpri gupchyawp rai nna, Yuda gaw nye a hkawhkam rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung, Moba hpe nye a lagaw kashin ai di zawn ngai lang kau na nngai; Edom a ntsa e mung, nye a hkyepdin hpe kabai tawn na nngai; dai gaw ngai madu la na ngu ai kumla rai nga ai. Hpilisti ni gaw nye a ntsa e, awng padang jahtau garu lu na mu ai nga nna, shanhte myit nawn nga masai kun?,” nga nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />O Karai Kasang e, dai ngang kang ai mare de, ngai hpe kadai woi sa na rai nga a ta? Edom de ngai hpe kadai woi sa na rai nga a ta?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw anhte hpe teng teng kau da nu ni? Anhte a hpyen luksuk ni hte rau nang n pru sa nga n ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Gumlau hpyen wa hpe hkap daw na matu, anhte hpe karum la mi; masha a karum la ai lam gaw manu n dan nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang anhte a hpang maga de tsap yang, anhte awng padang lu la na ga ai; shi gaw anhte a gumlau hpyen ni hpe shamyit kau na ra ai.
  </para>
  <chapter number="61" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, nye a jahtau ai nsen hpe na ya e; nye a akyu hpyi ga hpe madat ya e!
  </para>
  <para style="p">
    <verse number="2" style="v" />Dum nta hte tsan gang nna myit htum nga yang, ngai nang hpe shaga nngai!
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw ngai hpe makawp maga ai wa hte gumlau hpyen ni hpe ninghkap lu ai nye a ngang kang ai dahpran shara rai nga ndai majaw, ngai hpe shim ai shingbyi shara de woi wa e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a asak prat tup na a chyoi pra ai shara hta ngai nga nga lu n-ga; na a singkaw ni a npu e shim ai shara hta ngai shingwung lu n-ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />O Karai Kasang e, nye ai ga sadi ni hpe na ya nit dai; nang hpe shagrau sha-a ai ni madu ai sali wunli ni nang ngai hpe jaw ya nit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkawhkam wa a asak hpe shaning law law kahtap jat ya u; shing rai, shi gaw matut manoi asak galu nga u ga!
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang e, na a man e, shi htani htana a up nga u ga: na a dinggrin tsaw ra myit hte sadi sahka ai myit gaw shi hpe makawp maga ya nga u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi, ngai ga sadi jaw da ai hte maren, nang hpe shani shagu jaw nngai; nang hpe tut nawng mahkawn shakawn nga na nngai.
  </para>
  <chapter number="62" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang ngai hpe hkye hkrang la na matu, ngai amu sha hte ala nga nngai; Ngai gaw shi hpe chyu sha kam hpa manoi nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi chyu sha ngai hpe hkye hkrang la ai hte makawp maga nga ai; shi gaw nye a dahpran shara rai nga ai, ngai gaw galoi mung sum hkrum na nngai n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanhte yawng gaw daw agrawp mat ai nhpan daram sha n-gun rawng ai masha langai mi hpe, galoi aten du hkra, shi hpe gasat na ngu nga myit ni?
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi hpe shagrau shatsaw da ai shara kaw nna chyu sha nanhte shi hpe gang jahkrat kau mayu nga myit dai, nanhte gaw masu magaw ga tsun na hpe ra sharawng nga myit dai. Shaman ga ni hpe nanhte tsun nga myit ti mung, nanhte shi hpe nanhte a myit masin kata kaw nna dagam dala ga tsun nga myit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw Karai Kasang hta chyu sha, manoi gumgoi nga nngai; ngai shi hpe myit mada nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi chyu sha ngai hpe hkye hkrang la ai hte makawp maga nga ai; shi gaw nye a dahpran shara rai nga ai, ngai galoi mung sum hkrum na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a hkye hkrang la ai lam hte arawng sadang gaw Karai Kasang hta rai nga ai; shi gaw n-gun ja ai hte ngai hpe makawp maga ai wa rai nga ai, nye a shingbyi shara mung rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a amyu masha ni e, aten shagu Karai Kasang hpe kam hpa nga mu. Shi gaw anhte a shingbyi shara rai nga ai, nanhte a ru tsang lam yawng mayawng shi hpe tsun dan mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shinggyim masha yawng hte gaw nsa sa lai nbung kasha zawn sha rai nga ma ai; galu kaba ai wa hte kaji kadun ai wa mung, maren sha manu n dan nga ai. Shanhte hpe joi hta shen yu ai shaloi, shanhte a namnak hpa mung n rawng nga ma ai; shanhte gaw nsa sa lai nbung hta pyi grau nna tsang nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kabring kabrawng du daw sai hkaw re ai amu hpe nang hkum kam hpa nga et; mya lu mya sha nna lu la ai arai hpa hpe rai tim, hkum myit mada nga et, nang sut su wa ti mung, dai ni hta myit hkum manoi nga et.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu hta daru magam n-gun rawng nga ai hpe mung, shi a tsaw ra myit dinggrin rai nga ai hpe mung, Karai Kasang tsun ai ga dai hpe law law lang, ngai na ni ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />O Madu e, nang na masha shagu hte hpe tinang galaw ai amu hte maren, shagrau kumhpa jaw ya nga u law.
  </para>
  <chapter number="63" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, nang gaw nye a Karai Kasang rai nga ndai, ngai nang hpe marit nga nngai. Nye a hkum ting nang hpe ra marit nga nngai; hkun hkraw mat nna, akyu n jaw mai sai hte hka n rawng mat sai lamu ga zawn, nye a myit masin mung nang hpe shagroi gara nga li ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyoi pra ai shara hta nang hpe ngai mu lu n-ga, nang gaw kade wa n-gun chyalai rawng nga ai hte hpung shingkang rawng nga ai hpe mung ngai mu lu n-ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a dinggrin tsaw ra myit gaw dai asak hta grau nna mai kaja nga ai majaw, ngai nang hpe shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai asak hkrung nga dingsa nang hpe chyeju dum nga na nngai; nang kaw akyu hpyi ai shaloi, nye a lata ni hpe sharawt da na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a wenyi gaw, dwi sau ai lusha hpe sha lu ai zawn myit dik ai hkrum na ra ai; ngai nang hpe kabu gara ai mahkawn mangoi ga ni hte mahkawn shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai yupku ntsa e kaleng nga ai shaloi nang hpe dum nga nngai; nang ngai hpe tut nawng karum la nga nit dai majaw
  </para>
  <para style="p">
    <verse number="7" style="v" />na a lam hpe shana tup ngai myit yu nga nngai. Na a singkaw ni a shingnip kata hta kabu gara ai hte ngai mahkawn mangoi nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai nang kaw hkan jum noi nga nngai; na a lata ngai hpe shim hkra makawp maga ya nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai hpe sat na matu shakut shaja ai ni gaw katsan ga de yu mat wa na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte gaw majan e sat kau ai hkrum na mara ai; shanhte a hkum shan ni mung chyahkyawn ni e sha kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi hpe Karai Kasang awng padang jaw ya ai majaw, hkawhkam wa kabu gara na ra ai. Karai Kasang a mying nsang hta ga shaka tawn da ai ni gaw shi hpe shakawn lu na mara ai: rai ti mung, masu magaw ga tsun ai ni a n-gup ni chyawm gaw pat kau ai hkrum na mara ai.
  </para>
  <chapter number="64" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai ru tsang hkrum nga nngai, nye a akyu hpyi ga hpe madat ya e! Nye a gumlau hpyen ni hpe ngai hkrit nga nngai, nye a asak hpe hkye hkrang la ya e!
  </para>
  <para style="p">
    <verse number="2" style="v" />Tara n lang ai ni a maw mawn ai lam hte n hkru n shawp ai masha ni a hpawng kaw na, ngai hpe makawp maga la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw shinglet ni hpe nhtu ni zawn garang shadai nna; mazut ai ga ni hpe pala ni zawn shading da nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw shanhte a kaya n chye ai masu magaw ga ni hpe tin tin htawn shabra nga ma ai; nden n rawng ai masu magaw ga ni hte mai kaja ai masha ni hpe shatan nhkan ga tsun nna jahpyak nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw n hkru ai amu hpe galaw maw mawn ai lam hta shanhte shada da n-gun jaw hkat nga ma ai; shanhte a mahkam ni hpe gara shara ni hta hkam da yang mai na lam, shanhte tsun jahta nga ma ai. Shing rai, shanhte gaw, “Dai mahkam ni hpe kadai mung mu lu na n rai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw n hkru n shawp ai yaw shada lam ni hpe maw mawn nna, “Ra n rawng ai sai kap amu hpe anhte yaw lajang da lu saga ai,” nga nna tsun ma ai. Masha a myit masin hte kraw lawang ni hpe chye na lu na matu, yak la ai mauhpa lam ni rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai ti mung, Karai Kasang gaw shi a pala ni hte shanhte hpe gap dat nna; akajawng sha, shanhte hkala hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte tsun shaga ai ga ni a majaw, shi shanhte hpe jahten kau na ra ai; shanhte hpe mu mada ai ni yawng hte gaw shanhte a baw ni hpe kanga na mara ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte yawng hte gaw hkrit wa na mara ai rai nna, Karai Kasang hpa galaw da sai lam hpe shanhte myit aru yu na mara ai hte shi a amu bungli lam hpe tsun hkai dan na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang galaw shapraw dan sai amu ni a majaw, ding hpring ai masha ni yawng kabu gara na mara ai. Shanhte shi hta shim lum nga na mara ai, mai kaja ai amyu masha ni yawng shi hpe shakawn na mara ai.
  </para>
  <chapter number="65" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, nang anhte a akyu hpyi ga ni hpe htan ya mi ai majaw, Ziun ntsa e, anhte nang hpe shakawn ai lam gaw teng man nga ai; nang hpe jaw tawn ai ga sadi ni hpe mung anhte shadik shatup nga ga ai. Shanhte galaw shut kau ai yubak ni a majaw, shara shagu de na amyu masha ni, nang kaw du sa wa na mara ai. Anhte shut hpyit kau sai mara ni anhte hpe gamaw kau ti mung; nang gaw dai lam ni hpe mara dat ya nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang lata la hkrum sai ni hte, na a chyoi pra ai Htingnu kata hta nga lu na matu, nang woi sa wa hkrum ai ni gaw a lu nga ai. Anhte gaw na a nta na kaja ai arai ni hte, na a chyoi pra ai Nawku Htingnu na shaman chyeju ni hta myit dik nga na ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang anhte hpe awng padang jaw ya ai hku, anhte hpe htan ya nga ndai, anhte hpe hkye hkrang la na matu, mauhpa magam amu ni hpe nang galaw nga ndai. Mungkan ga ting hte panglai ni din ai shara shagu na amyu masha ni gaw nang hpe kam hpa nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a n-gun atsam hte bum hpe shi a shara ni hta de da nna; na a chyahtum chyalai daru magam n-gun hpe madun dan nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw panglai hka ni a wu kadu ai nsen, hka leng ni a kashaw kashai ai nsen ni hte, amyu baw ni a rawt kabrawng ai hpe shazim kau nga ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a magam amu ni gaw mungkan ga a jahtum shara maga mi kaw nna maga mi de du hkra, kabu gara jahtau garu shangun nga ai. Nang galaw dan sai galu kaba ai lamik kumla ni a majaw, mungkan ga ting mau mahka nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw lamu ga a matu marang jahtu ya ai hte mungkan ga hpe yu lanu lahku nga ai lam madun dan nga ndai; nang dai hpe sut su shangun ai hte ga sau ing shangun nga ndai. Hka shi ni hpe hka hte nang jahpring da nna; aga hta nai mam ni hte nang shatut ya nga ndai. Nang gaw dai hku nna lajang da nit dai:
  </para>
  <para style="p">
    <verse number="10" style="v" />shawt htai da ai sun ni hta marang hpe nhpaw n-ya nang jahtu ya nna; dai ni hpe hka hte madit ya nga ndai; ga namhpun hpe marang shaya nna, shakya ya nga ai, dai hta hkai nmai ni hpe nang tu kaba shangun nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang gaw mai kaja ai lam hpe jaw ya ai majaw shu la lu ai nai mam ni kade wa sut su nga a hka! Nang hkawm du ai shara shagu hkan e, nhpaw n-ya law htam shangun nga ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Udat shara ni hta yam nga wuhpung ni hte hpring nga ai; kawng nhkrem ni hta kabu gara ai hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Prang ni hta sagu ni hte hpring nga ai; kadit ni hta hkaulan mam ni hte hpring nga ai. Arai yawng mayawng hte gaw garu jahtau ai hte kabu gara mahkawn ma ai.
  </para>
  <chapter number="66" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amyu masha ni yawng hte e, Karai Kasang hpe kabu gara jahtau garu ai hte shakawn nga mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a mying nsang a hpung shingkang hpe mahkawn mu; hpung shingkang hte hpring ai shakawn kungdawn ga hte shi hpe daw jau mu!
  </para>
  <para style="p">
    <verse number="3" style="v" />“Nang galaw ai amu ni gaw kade wa mauhpa rai nga a hka! Na a daru magam n-gun grai galu kaba nga ai majaw, na a gumlau hpyen ni gaw na a man e, hkrit ai hte gum dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ga ntsa e shanu nga ai masha shagu hte gaw nang hpe nawku daw jau ma ai; shanhte gaw nang hpe mahkawn shakawn nga ma ai, na a mying nsang hpe shanhte mahkawn shakawn nga ma ai,” nga nna Karai Kasang hpe tsun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang galaw dan sai amu hte shinggyim masha ni a lapran e, shi galaw dan sai mauhpa magam amu ni hpe, sa nna yu yu mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw panglai hpe hkun hkraw ai hkarang hku galai kau nga ai; anhte a kaji kawa ni, lagaw hte dai hka hpe lai di mat wa masai. Shi galaw dan sai amu magam ni a majaw, anhte kabu gara lu saga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a chyalai n-gun hte htani htana shi up nga nna; amyu baw ni a ntsa e, shi azi yu nga ai. Shi hpe kadai wa mung n gumlang mu ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amyu baw ni yawng hte e, anhte a Karai Kasang hpe shakawn mu; nanhte a shakawn kungdawn ai ga hpe na lu shangun mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw anhte hpe jahkrung da nu ai anhte kataw mat na matu shi ahkang jaw ai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, nang gaw wan hte gumhpraw hpe shabyawng nna jasan ai zawn, anhte hpe chyam yu nga ndai. Dai zawn, nang gaw anhte hpe chyam yu ngut nit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang gaw anhte hpe mahkam de jahkrat kau nna; anhte a shingma ntsa hta, li ai lit hpe mara ya nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte a gumlau hpyen ni hpe anhte a ntsa e, nang kabye shangun nna; anhte gaw wan hpyen, hka mawru hpyen ni hpe hkrum kadup lai wa saga ai; rai ti mung, ya chyawm gaw, nang anhte hpe shim lum ai shara de woi wa nga nit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai na a nta de wan nat hkungga ni hpe la sa na nngai; ngai ga sadi jaw da ai hte maren, nang hpe ngai nawng jau na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai ru tsang hkrum nga nngai shaloi, ngai nang hpe tsun dan lai wa sai lam ni hte maren, nang hpe jaw na de ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw tawn hkungri ntsa e nat nawng na matu, sagu ni hpe nawng jau na nngai; usu ni hte bainam ni hpe mung, nawng jau na nngai; shing rai, hkungga wan hkut gaw lamu de mawng lung wa na ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Karai Kasang hpe hkrit hkungga ai ni yawng hte e, sa madat la mu, shi nye a matu galaw dan sai amu ni nang hpe tsun dan na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karum la na matu, shi hpe ngai jahtau ni ai; ngai shi hpe mahkawn mangoi ni hte shakawn ni ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a yubak ni hpe ngai hpa zawn n nawn kau ai rai yang; dai Madu ngai hpe madat ya na wu ai n rai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai ti mung, Karai Kasang gaw ngai hpyi tsun ai ga ni hpe teng teng na ya nu ai; nye a akyu hpyi ai ga ni hpe mung shi madat ya nu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi gaw nye a akyu hpyi ai ga ni hpe n ningdang kau ya ai hte, shi a dinggrin tsaw ra myit, ngai kaw na n dawm la kau ya ai majaw, ngai Karai Kasang hpe shakawn nngai law.
  </para>
  <chapter number="67" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, anhte hpe matsan dum nna shaman ya mi; anhte hpe na a matsan dum lama ai myit hte mada mara nga u. Shing rai, mungkan ting gaw na a ra sharawng ai myit hpe chye wa lu mu ga; amyu baw ni yawng hte mung, na a hkye hkrang la ai lam hpe chye na lu mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />O Karai Kasang e, na a amyu masha ni nang hpe shakawn lu mu ga; masha amyu baw nlang hte mung nang hpe shakawn lu mu ga!
  </para>
  <para style="p">
    <verse number="4" style="v" />Masha amyu ni hpe teng man ai tara hte nang jeyang ya nna; mungkan ga na amyu baw ni yawng hte hpe lam woi nga ndai majaw, amyu baw ni yawng kabu gara ai hte mahkawn shakawn nga mu ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />O Karai Kasang e, masha amyu baw ni yawng nang hpe shakawn mu ga; masha amyu baw ni yawng hte mung nang hpe shakawn mu ga!
  </para>
  <para style="p">
    <verse number="6" style="v" />Lamu ga gaw shi a nsi naisi shapraw ya sai; Karai Kasang, anhte a Karai Kasang gaw anhte hpe shaman ya sai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang gaw anhte hpe shaman ya mi ai, shara shagu hkan nga nga ai masha amyu yawng shi hpe shagrau sha-a nga mu law.
  </para>
  <chapter number="68" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw rawt nna shi a gumlau hpyen ni hpe shabra kau nga ai; shi hpe n dawng n yawt ai ni, sum ai hte hprawng mat ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Wan hkut mawng mat wa ai zawn, shi shanhte hpe gawt kau mu ai; gitbaw gaw wan a man e byawng mat ai zawn, tara n lang ai ni Karai Kasang a man e hten byak mat nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai ti mung, ding hpring ai ni kabu gara nga ma ai rai nna, shi a man hta kabu awng nga ma ai. Shanhte gaw kabu gara nga ma ai hte kabu jahtau nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang hpe mahkawn mu, shi a mying nsang hpe mahkawn shakawn mu; sumwi jawn ai wa a matu lam shajin mu. Shi a mying gaw Madu rai nga ai, shi a man hta kabu gara nga mu!
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi a chyoi pra ai Nawku Htingnu hta shanu nga ai Karai Kasang gaw jahkrai nmai ni hpe lanu lahku nga nna gaida jan ni hpe makawp maga ya nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Garen gari nga ai wa hpe shanu nga na nta shi jaw ya nga ai; bawng dung ai ni kabu gara ai shanglawt ahkaw ahkang lu la na matu, shi woi awn nga ai; rai ti mung, gumlau ai ni gaw akrin akraw re ai lamu ga hta shanu nga na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />O Karai Kasang e, na a amyu masha ni hpe nang woi awn nna; nam mali hpe nang woi lai mat wa ai shaloi,
  </para>
  <para style="p">
    <verse number="8" style="v" />mungkan ga gaw gari ashun wa ai hte lamu na marang htu wa nga ai; hpa majaw nga yang, Sina bum a Karai Kasang rai nga ai Israela a Karai Kasang du sa wa ai majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw marang hpe ntaw ntsang jahtu dat ya nna, na a hkun hkraw mat sai lamu ga hpe bai shabran dat ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na amyu masha ni gaw dai shara hta shanhte a dum nta ni hpe shachyaw nga ma ai; nang gaw na a mai kaja ai lam hta matsan mayan masha ni hpe shara lajang jaw ya nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu gaw hkang da ai ga jaw dat ai hte, num law law wa dai shiga hpe gun hkawm nga ma ai;
  </para>
  <para style="p">
    <verse number="12" style="v" />“Hkawhkam ni hte shanhte a hpyen luksuk ni hprawng mat wa masai!,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nta e nga ai num ni gaw gumhpraw hte gayawp nna singkaw ni hta htoi kabrim ai ja hte gala nga ai hkrudu sumla lanep ni hpe garan la nga ma ai. (Nanhte hta na nkau mi gaw hpa majaw majan gasat nga ai shani hta, sagu lawng ni hkan nga nga myit ni?)
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyahtum Chyalai N-gun Rawng Ai Karai Kasang gaw hkawhkam ni hpe Zalmon bum de shabra kau ai shaloi, shi gaw dai shara hta hkyen hkrat shangun nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bashan bum gaw grai kaba nga nna, bum pungding law law marawng nga ai bum rai nga a hka!
  </para>
  <para style="p">
    <verse number="16" style="v" />Pungding law law marawng nga ai bum kaba kaw nna Karai Kasang shanu nga na matu lata san da ai bum hpe asawng ai nsam hte hpa majaw nang yu nga a ni? Dai Madu gaw dai shara hta htani htana shanu nga na ra ai!
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai Madu gaw hkying mun law la nna, n-gun rawng ai shi a hpyen leng ni hte Sina kaw nna chyoi pra ai shara de sa wa nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bawng masha law law hte rau dai tsaw ai bum ntsa de shi lung wa nga ai; shi gaw gumlang ai masha ni kaw na kumhpaw kumhpa law law hpe hkap la da nga ai. Dai Madu Karai Kasang gaw dai shara hta shanu nga na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anhte a lit ni hpe lani hte lani gun ya nga ai Madu hpe shakawn mu; shi gaw anhte hpe hkye hkrang la ai Karai Kasang rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anhte a Karai Kasang gaw hkye hkrang la ai Karai Kasang rai nga ai; shi gaw Madu rai nga nna, si hkrung si htan a lata kaw nna mawai la ai anhte a Madu rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yubak lam ni hta shanang nga ai shi a gumlau hpyen ni a baw ni hpe Karai Kasang teng teng abrep kau na ra ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai Madu gaw, “Na a gumlau hpyen ni hpe Bashan kaw nna bai shaga shapraw la na nngai; nammukdara a sung htum ai shara kaw na mung ngai shanhte hpe shaga shapraw la na nngai,
  </para>
  <para style="p">
    <verse number="23" style="v" />shing rai, shanhte a sai hta nang kabye lai wa u ga, na a gwi ni ra ai daram mata lu mu ga,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Karai Kasang e, nye a hkawhkam Karai Kasang gaw shi a chyoi pra ai shara de, awng padang ninglaw hte yan ganawng sa wa ai hpe yawng hte wa mu nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mahkawn hkawn ai ni shawng sa wa nna, tingse sumpyi dum ai ni hpang e hkan nang nhtawm, ka-ang e, shup sheng dum ai mahkawn ma ni hkan nang nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Shi a amyu masha ni a hpawng hta Karai Kasang hpe shakawn mu; Yaku a aru arat ni yawng hte e, dai Madu hpe shakawn mu!”
  </para>
  <para style="p">
    <verse number="27" style="v" />Hpungdim rai nga ai Benyamin amyu bawsang ni shawng sa nna; dai hpang, Yuda ningbaw ningla ni hte shanhte a u hpung ni, Zebulun hte Naphtali yan a ningbaw ningla ni matut nna hkan nang na rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Karai Kasang e, anhte a matu nang akyu jashawn nit dai, dai daru magam n-gun hte hkawhkam ni nang hpe kumhpaw kumhpa la sa ya ai, dai Yerusalem mare hta nga ai na a Htingnu kaw nna daru magam n-gun hpe madun dan u.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mai-aw pa na matse labye dusat ngu ai Egutu mung hpe daru kau u; usu hpung ni hte shanhte a dumsu kasha ni ngu ai amyu baw ni gaw, nang hpe yawng jawm dingnyawm nna shanhte a gumhpraw sak jaw wa ai aten du hkra daru kau u. Majan shabyin na hpe ra sharawng nga ai ni hpe shabra kau u!
  </para>
  <para style="p">
    <verse number="31" style="v" />Egutu mungdan na sumtsan salang ni nang kaw du sa wa na mara ai; Ehtiopi masha ni mung Karai Kasang hpe akyu hpyi ai hta shanhte a lata ni hpe sharawt wa na mara ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mungkan ga na mungdan ni e, Karai Kasang hpe shakawn mu; moi chyaloi nhkoi kaw nna nga nga sai lamu hta jawn nga ai Madu hpe mahkawn shakawn mu. Nsen kaba hte jahtau dat ai shi a nsen hpe madat mu.
  </para>
  <para style="p">
    <verse number="34" style="v" />Karai Kasang a daru magam amu hpe htawn tsun mu; shi a hpung shingkang gaw Israela amyu masha ni a ntsa e, nga nga ai, shi a chyahtum chyalai n-gun a hpung shingkang mung, lamu ni hta dan hkung nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shi a chyoi pra ai Htingnu kaw nna sa wa ai Israela a Karai Kasang gaw kade wa hpung shingkang hte hpring nga a hka! Shi gaw shi a amyu masha ni hpe n-gun atsam jaw ya nga ai. Karai Kasang hpe shakawn mu law!
  </para>
  <chapter number="69" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, ngai hpe hkye hkrang la e! Hka gaw nye a du du hkra lim lung wa nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai gaw sung ai hkumpup hta lup wa nga nngai, dai shara hta kabye na ga shaja n nga nga ai. Sung ai hka de ngai rai wa nga nngai; hka leng ni ngai hpe marit shangun hkyen wa nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai gaw karum la na matu marawn jahtau nngai majaw hki ba nga nngai, nye a yu hkraw mung machyi nga li ai. Nang karum la na hpe mada yu nga nngai majaw nye a myi ni mam mat li ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mara kata e, ngai hpe n ju n dawng nga ai ni gaw nye a baw na kara singgawng ni hta grau law nga ma ai; Nye a gumlau hpyen ni ngai hpe masu magaw shatan nhkan ga tsun nna, gumlang nga ma ai; Shanhte gaw n-gun ja nga ma ai rai nna, ngai hpe sat kau mayu nga ma ai. Ngai n lagu la ai arung arai ni hpe bai nhtang jaw shangun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />O Karai Kasang e, nye a yubak ni hpe nang kaw na makoi magap da lu nga ai n rai; ngai kade sha angawk lai wa sai hpe mung nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyahtum Chyalai n-gun rawng ai hte Grau Htum ai Madu e, nang hta kam hpa nga ai ni hpe, nye a majaw kaya kahpa n hkrum sha mu ga! Israela a Karai Kasang e, nang hpe nawku daw jau ai ni hpe nye a majaw myi man hkum jasum kau ya nga et!
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a jaw e, ngai n kaw n law re ai hkrum sha nga nngai; ngai gaw kaya kahpa hte ka-up da ai hkrum nga ni ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a hpu nau ni hta tsasam wa zawn, nye a dinghku masha ni hta maigan masha langai mi zawn ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a Htingnu hta nye a myit manoi ai nja nhpra myit gaw wan zawn, nye a myit masin hta grung nga li ai. Nang hpe shatan nhkan tsun ai ga ni gaw nye a ntsa e mara nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lusha gam let nye hkum ngai shagrit shanem kau ai shaloi, masha ni ngai hpe n kaw n law di nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sharung shayawt ai hpun palawng ngai bu hpun ti mung, shanhte ngai hpe mani asawng nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mare lam ni hta, shanhte nye a lam hpe hkan shatan nga ma ai; chyaru nang ai ni mung, laka ga ni hte nye a lam hpe asawng nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai ti mung, nye a matu chyawm gaw, Madu e, ngai nang hta akyu hpyi nga na nngai; Karai Kasang e, nang ra sharawng ai aten hta ngai hpe htan ya e. Na a kaba la ai tsaw ra myit hte hkye hkrang la na nga nna nang tawn da ai ga sadi hte maren ngai hpe htan ya e law.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hkumpup hta lup mat wa nga ai kaw na mung; nye a gumlau hpyen ni a lata kaw nna mung, sung ai hka kaw nna mung, ngai hpe hkye hkrang la e, ngai hpe hkrang shaw la e,
  </para>
  <para style="p">
    <verse number="15" style="v" />Mawru hka hte ngai hpe hkum ka-up kau shangun et; sung ai hka hte ngai hpe hkum marit shangun et, lup sung hku de mung ngai hpe hkum lup wa shangun et.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu e, na a dinggrin tsaw ra myit a mai kaja ai lam hta, ngai hpe htan ya e, na a kaba la ai matsan dum myit hte ngai hpe mada mara la rit.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai gaw ru tsang kaba hkrum nga nngai majaw, nang hkum nan na a mayam wa kaw nna hkum makoi nga et; ya jang, ngai hpe htan ya e!
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai hpe hkye hkrang la na matu, sit sa wa rit; nye a gumlau hpyen ni a lata kaw na, ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai gaw kade wa n kaw n law di ai hkrum nna kade wa myi man kaya hkrum ai hte, kade wa arawng jahpoi hkrum nga nngai gaw nang chye nga ndai; nye a gumlau hpyen ni yawng hpe nang mu mada nga ndai.
  </para>
  <para style="p">
    <verse number="20" style="v" />N kaw n law re ai lam ni gaw nye a myit masin hpe gawng sharun ya nga ai majaw, ngai myit htum nga nngai. Matsan dum la na masha hpe ngai myit mada yu ni ai, rai ti mung, langai mi mung n nga nga ai; myit shalan shabran ya na matu mung, kadai hpe mung ngai n mu lu nngai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngai kawsi ai hkrum yang, shanhte ngai hpe gung jaw mi ai; ngai hpang gara ai hkrum yang, shanhte ngai hpe ntsin jahkri jaw lu mi ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte a lusha poi ni gaw shanhte hpe jahten sharun shangun mu ga; shanhte a chyoi pra ai lusha poi gaw shanhte hpe hkrat sum shangun mu ga.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shanhte a myi ni n mu lu mat hkra, shanhte a myi sin mak malu ga; shanhte a shingma marung ni hpe tut nawng e, kya kau shangun u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shanhte a ntsa e, na a masin kahtet ai hpe ru bun u; na a sindawng kahtet ai gaw shanhte hpe dep nga u ga.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte a dap dabang ni katsi katsang jahkam tawn da ai hkrum nga mu ga: shanhte a sum ni hta kadai mung hkrung nga ai hte n nga lu mu ga.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shanhte gaw nang e ari jaw tawn da hkrum ai ni hpe zingri zingrat di nga ma ai; nang nma shakap da hkrum ai ni a nni nkri lam ni hpe shanhte shatan nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte a yubak yawng hte hpe jahpan galaw nna mazing da u; na a hkye hkrang la ai lam hta shanhte hpe daw chyen mi sha pyi, hkum hkam la shangun et.
  </para>
  <para style="p">
    <verse number="28" style="v" />Asak laika buk kaw na shanhte a amying ni hpe arut kau ya u ga; na a amyu masha ni a jahpan hta shanhte n lawm lu mu ga.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rai ti mung, ngai gaw machyi nga ai hte myit htum nga nngai; Karai Kasang e, ngai hpe pawn sharawt la nna, hkye hkrang la e!
  </para>
  <para style="p">
    <verse number="30" style="v" />Karai Kasang hpe mahkawn mangoi ga hte ngai shakawn nga na nngai; chyeju dum ai myit hte shi a galu kaba ai lam hpe ngai htawn tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai gaw dumsu hkungga nawng jau ai hta grau nna Madu hpe kabu shangun nga ai; hpum sau ai usu hkungga nawng ya ai hta grau nna sharawng awng wa na ra ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dip gamyet sha hkrum nga ai ni, dai lam hpe mu ma ai shaloi, shanhte kabu gara wa lu na mara ai; Karai Kasang hpe nawku daw jau ai ni mung myit n-gun lu la na mara ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai Madu gaw ra kadawn nga ai ni a akyu hpyi ga ni hpe madat ya nga nna; bawng dung nga ai shi a amyu masha ni hpe n malap kau nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sumsing lamu hte ginding aga, panglai ni hte dai hta rawng ai hkrung mahkrung yawng hte e, Karai Kasang hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shi gaw Yerusalem mare hpe hkye hkrang la na ra ai hte Yuda mung na mare ni hpe mung bai gaw gap da na ra ai. Shi a amyu masha ni dai shara hta shanu nga lu nna, lamu ga hpe madu lu na mara ai;
  </para>
  <para style="p">
    <verse number="36" style="v" />shi a shangun ma ni a aru arat ni gaw dai hpe hkring htawng hkam la lu na mara ai hte, shi hpe tsaw ra nga ai ni dai shara hta shanu nga lu na mara ai.
  </para>
  <chapter number="70" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai hpe hkye hkrang la e! Madu e, ngai hpe ya jang, karum la e!
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hpe sat na maw mawn ai ni tsep kawp sum mat nna shanut kau ai hkrum mu ga. Nye a ru tsang ai lam ni a majaw kabu gara nga ai ni gaw shingdu de nawku htingnut mat wa nna kaya kahpa hkrum sha nga mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai hpe mani asawng ai ni gaw shanhte sum mat ai a jaw e, myi man sum mat mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang kaw du sa ai ni yawng hte gaw awng sharawng ai hte kabu gara nga mu ga. Na a hkye hkrang la ai lam hpe chyeju dum ai ni yawng hte gaw, “ Madu gaw kade wa galu kaba nga a hka!,” nga nna tut tut atsun nga mu ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />O Karai Kasang e, ngai gaw gawng kya nga nngai hte matsan mayan re ai wa rai nga nngai; rai ti mung, nang gaw ngai hpe malap kau nga ndai n rai. Nang gaw nye a hkye hkrang la ai wa hte nye a Madu rai nga ndai. Ngai hpe karum la na tin tin du rit law!
  </para>
  <chapter number="71" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, makawp maga la na matu, ngai nang kaw du sa ring ngai; ngai hpe galoi mung hkum sum shangun et!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang gaw ding hpring nga ndai majaw, ngai hpe karum la ai hte mawai la e. Ngai hpyi nem ai ga hpe madat ya ai hte ngai hpe hkye hkrang la e!
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a shim ai shingbyi shara hte n-gun ja ai hpyen dap tai nga nna, ngai hpe makawp maga la e; nang gaw nye a shingbyi shara hte dahpran shara rai nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a Karai Kasang e, tara n lang ai masha ni, n hkru ai masha ni hte mazut ai masha ni a n-gun atsam kaw na ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Grau Htum ai Madu e, nang hpe ngai myit mada nga nngai; ngai naw kaji nga ai aten kaw nna, nang hta ngai kam hpa nga ni ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw nye a asak prat tup nang hta shamyet shanat nga ni ai; Ngai shangai wa ai shani kaw nna, nang ngai hpe makawp maga la nit dai. Shing rai, ngai nang hpe tut nawng shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw nye a n-gun ja ai shingbyi shara rai nga nit dai majaw; nye a asak prat gaw masha law law a man e, kasi tai nga li ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai nang hpe shani tup shakawn nga na nngai, shing rai, na a hpung shingkang hpe htawn tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya, ngai dingla wa nga nngai majaw, ngai hpe hkum kabai kau nga et; ya, ngai n-gun yawm nga nngai majaw, ngai hpe hkum kau da nga et.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a gumlau hpyen ni ngai hpe sat kau mayu nga ma ai; shanhte ngai hpe gumlang maw mawn na matu tsun jahta nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Karai Kasang shi hpe kau da nu ai; anhte shi a hpang hkan nna shi hpe rim la ga, shi hpe mawai la na masha kadai mung n nga ai,” nga nna shanhte tsun ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang e, tsan tsan de hkum nga nga et; nye a Karai Kasang e, ngai hpe karum la na matu alawan du rit law.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai hpe gasat ai ni sum mat nna, jahten kau ai hkrum nga mu ga; Ngai hpe machyi shangun na matu, shakut nga ai ni kaya kahpa hkrum ai hte myi man sum mat mu ga.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang hta ngai galoi mung myit mada nga nngai; shing rai, nang hpe grau grau nna ngai shakawn na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a mai kaja ai lam hpe ngai htawn tsun na nngai; ngai chye na ai hta grau nna lachyum sung nga ai rai tim, na a hkye hkrang la ai lam hpe shani tup ngai tsun dan na nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai gaw Madu Karai Kasang a n-gun hte pru sa wa na nngai; na a mai kaja ai lam hpe chyu sha, ngai htawn tsun na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai brang ram prat naw rai nga ai aten kaw nna nang ngai hpe sharin ya nit dai; na a mauhpa magam amu ni hpe ya du hkra, ngai tsun dan nga nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ya chyawm gaw, ngai dingla wa nga nngai hte nye a kara hpraw wa nga li ai. Karai Kasang e, ngai hpe hkum kau da nga et! Du sa wa na masha ban prat yawng hte hta na a daru magam n-gun hte chyahtum chyalai rawng ai n-gun hpe ngai htawn tsun yang, ngai hte rau rai nga u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Karai Kasang e, na a ding man ai lam gaw lamu ni de dep nga ai. Galu kaba ai magam bungli ni hpe nang galaw nit dai, nang zawn re ai wa langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang gaw ru tsang lam ni hte nni nkri lam ni hpe nye a ntsa e, hkrum sha shangun ai rai tim, nang gaw nye a n-gun hpe bai jahpring ya na rai nga ndai; lup sung hku de n du hkra mung, nang ngai hpe kyem mazing la na rin dai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang ngai hpe shawng na hta, grau nna galu kaba shangun na rin dai; nang gaw ngai hpe bai shalan shabran la na rin dai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai nang hpe teng teng, tingse hte dum shakawn na nngai; nye a Karai Kasang e, na a sadi sahka lam hpe ngai shakawn nga na nngai. Israela a Chyoi Pra ai Wa e, tingse hte ngai nang hpe dum mahkawn nga na nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na matu tingse dum ai shaloi, kabu gara ai hte ngai jahtau na nngai; nang ngai hpe hkye hkrang la nit dai majaw, nye a myit masin, hkum hkrang mahkra hte, ngai mahkawn na ring ngai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngai hpe machyi shangun na matu shakut ai ni gaw sum mat ai hkrum nna kaya kahpa hkrum nga ma ai majaw, na a ding man ai lam hpe ngai shani tup tsun dan na nngai.
  </para>
  <chapter number="72" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, na a ding man ai lam hte tara jeyang na matu, hkawhkam wa hpe sharin ya u; na a teng man ai lam shi hpe garan ya u,
  </para>
  <para style="p">
    <verse number="2" style="v" />shing rai yang, shi gaw na a amyu masha ni hpe teng man ai lam hte up hkang lu na ra ai, dip gamyet sha hkrum nga ai ni hpe ding man ai lam hte up hkang lu na ra ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lamu ga gaw ngamu ngamai ai lam hpe kabu gara let hkam la lu mu ga; ding man ai lam hpe hkan sa nga mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hkawhkam wa gaw matsan mayan masha ni hpe rap ra ai hku tara jeyang lu u ga; ra kadawn ai ni hpe mung karum ya lu u ga, shanhte hpe dip gamyet sha ai ni hpe dang kau lu u ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Prat ban law law a matu du sa wa na, shu mashi shu masha ni, jan, shata, htoi nga dingsa, na a amyu masha ni nang hpe nawku daw jau lu mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Prang ni a ntsa e, marang htu ai hte lamu ga ntsa e, marang shaya hkrat nga ai zawn, hkawhkam wa mung dai zawn rai nga u ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai ding man ai lam gaw nye a asak prat tup hta galu kaba nga u ga; shata gaw shi a nhtoi hpe jaw ya lu nga dingsa, ngamu ngamai ai lam agrin nga u ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a mungdan gaw panglai kaw nna panglai du hkra, Uhprat hka nu kaw nna mungkan ga a jut mi de du hkra, dam lada wa na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nam mali hkan na amyu baw ni gaw na a man e, dingnyawm wa na mara ai; shi a gumlau hpyen ni gaw shi a man e dingnyawm wa na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Spain mung hte zunlawng ni a hkawhkam ni gaw, shi hpe kumhpaw kumhpa ni, sa sak jaw na mara ai; Arabi hte Ehtiopi mung na hkawhkam ni mung, shi hpe hkungga kumhpa la sa ya na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam ni yawng hte gaw shi a man e, dingnyawm wa na mara ai; amyu masha ni yawng hte mung shi hpe daw jau na mara ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi hpe shaga ai matsan mayan masha ni, ra kadawn nga ai ni hte n sawn n sang di kau hkrum ai ni hpe shi mawai la nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gawng kya ai ni hte matsan mayan ni a ntsa e, shi matsan dum nga ai; ra kadawn nga ai ni a asak ni hpe hkye hkrang la nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte a asak ni gaw shi a man e, manu dan nga ai; shi gaw shanhte hpe dip gamyet sha ai hte kaming kamawng du daw sai hkaw re ai amu kaw na mawai la nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hkawhkam wa a asak galu nga u ga! Arabi mung na aja ni hpe hkam la lu u ga; shi a matu akyu hpyi ya nga ai ni, aten shagu hpyi ya lu mu ga; Karai Kasang a chyeju ni gaw shi a ntsa e, tut nawng anga nga u ga law!
  </para>
  <para style="p">
    <verse number="16" style="v" />Lamu ga ni hta nsi naisi ni ja kat nga u ga; Lebanon mung na nsi naisi si ai zawn, kawng ni yawng hta hkai nmai ni rai nga mu ga; Prang yang na tsingdu ni zawn, mare ni hta amyu masha ni hte hpring nga mu ga.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hkawhkam wa a amying hpe galoi mung n malap kau lu mu ga; shi a mying gumhkawng ai lam, jan zawn agrin nga u ga. Hkawhkam wa hpe Karai Kasang shaman chyeju jaw ya ai zawn, amyu baw ni yawng mung, Karai Kasang shanhte hpe shaman ya na matu hpyi nga mu ga.
  </para>
  <para style="p">
    <verse number="18" style="v" />Madu Israela a Karai Kasang hpe shakawn mu! Shi chyu sha ndai mauhpa magam bungli ni hpe galaw nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi a hpung shingkang hte seng ai mying nsang hpe htani htana shakawn mu! Shi a hpung shingkang gaw mungkan ting hta pri rai nga u ga law. Amen! Amen!
  </para>
  <para style="p">
    <verse number="20" style="v" />Ndai gaw Yese a kasha Dawi akyu hpyi ai ga ni hta na hpang jahtum na akyu hpyi ga rai nga ai.
  </para>
  <chapter number="73" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw myit masin san seng ai Israela amyu masha ni hpe kaja wa, chyeju jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rai ti mung, tara n lang ai ni a matu, lam shagu hta kaja nga ai hpe ngai mu ai shaloi; de a majaw, gumrawng gumtawng ai ni hpe ngai yu manawn wa nngai, kam hpa ai lam ngai hta ganoi noi shamat kau nna, nye a makam masham mung ganoi noi htum mat li ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw n-gun ja nga ma ai hte hkam kaja nga ma ai majaw; nni nkri hpe shanhte n hkam sha nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw kaga masha ni zawn, nni nkri hpe n hkam sha ra ma ai; kaga masha ni lu ai ru yak tsin-yam ni shanhte n lu nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai, shanhte gaw gumrawng gumtawng ai hpe kachyi zawn; kashun kashe du daw sai hkaw re ai hpe ntsa palawng kaba zawn, sumli da nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte a myit masin gaw n hkru n shawp ai lam hpe ru jaw dat nna; shanhte a kraw lawang ni gaw n hkru n shawp ai hku maw mawn ai hte kyin nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw kaga masha ni hpe mani asawng nna n hkru n hkra ai lam ni hpe tsun nga ma ai. shanhte gaw gumrawng gumtawng nga ma ai hte, kaga masha ni hpe dip gamyet sha na lam maw mawn nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte gaw sumsing lamu na Karai Kasang hpe n kaja ai hku shatan nhkan ga tsun nna ga ntsa e nga ai masha ni hpe chyawm gaw, myit tsaw myit dap ai hkang da ai ga ni hte aming jaw ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai, Karai Kasang a amyu masha ni nan shanhte kaw kayin bang mat wa nna; shanhte tsun ai hpa lam hpe rai tim ra sharawng ai myit hte kam nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw, “Karai Kasang chye na n rai; Tsaw Htum ai Wa mu tam na n rai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tara n lang ai ni gaw dai zawn rai nga nna shanhte gaw ntaw ntsang lu ma ai hte aten shagu hta, grau grau lu wa nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai majaw, nye hkum ngai san seng hkra nga nna, yubak n galaw ai sha nga kau ai gaw kaman wa rai nga a ni?
  </para>
  <para style="p">
    <verse number="14" style="v" />O Karai Kasang e, nang ngai hpe shani tup nni nkri jahkrum da nga ndai; nang ngai hpe jahpawt shagu ari jaw nit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lama, dai zawn re ai lam ni hpe ngai tsun kau ai rai tim; na a amyu masha ni hta na marai langai mi zawn ngai asak hkrung nga sana n rai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ndai mang hkang lam ni hpe ngai shakut nna myit jahkawn yu ni ai; rai ti mung, dai gaw chye na na matu, nye a matu nau wa yak la nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />shing rai, ngai gaw na a Htingnu kata de du sa ai aten du hkra yak la nga ai. Shaloi, tara n lang ai ni hta kaning rai wa na lam hpe ngai chye na ni ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang gaw manen nna lagaw kashawt ai shara ni hta shanhte hpe tawn da nna; shanhte hpe hten mat na shara de jahkrat kau na ndai!
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte gaw shaloi jang, jahten shabyak kau ai hkrum nga ma ai; shanhte a hpang jahtum na lam gaw hkrithpa shara rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Madu e, shanhte gaw jahpawt manap aten hta mat mat ai yup mang ni zawn rai nga nna; Madu nang rawt wa ai shaloi, shanhte n nga nga masai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a myit sawn ai lam ni gaw ahkup nga nna nchyi nmu hkrum nga ai shaloi, nye a hkam sha ai lam ni hta myit kraw yu machyi nga ai hte
  </para>
  <para style="p">
    <verse number="22" style="v" />dusat zawn ngai angawk mat wa ai hte na a myit ra ai lam hpe mung ngai n chye na mat nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai ti mung, ngai nang hte rau ani sha nga nga nngai hte; nang ngai hpe lata hte jum da nga ndai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na a sharin matsun ai ga hte ngai hpe nang woi lakawn wa nna; nang ngai hpe hpang jahtum na aten hta hpung shingkang hte hkap la na ndai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sumsing lamu hta, nang hta kaga ngai kadai hpe Madu shatai na rai nga a ta? Nang nye a Madu rai nga yang, mungkan ga ntsa e, ngai hpa naw ra na rai nga a ta?
  </para>
  <para style="p">
    <verse number="26" style="v" />Nye a myit masin hte hkum hkrang n-gun ni yawm mat wa tim; Karai Kasang gaw nye a n-gun rai nga ai. Ngai hta ra kadawn ai lam yawng mayawng gaw shi rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang hpe kau da ai ni gaw teng teng htum mat na mara ai; nang hta sadi n dung ai ni hpe Nang shamyit kau na rin dai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Rai ti mung, nye a matu chyawm gaw, Karai Kasang hte ani sha nga lu na, Madu Karai Kasang hta makawp maga ai lam mu tam la na matu hte shi galaw dan sai magam bungli ni hpe htawn tsun na lam ni gaw kade sha mauhpa rai nga a hka!
  </para>
  <chapter number="74" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, nang anhte hpe hpa rai ndai zawn kau da nga n ta? Na a amyu masha ni hpe htani htana masin pawt nga na ngu nga n ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Moi moi kaw nna, na a matu nang nan lata la ai amyu masha ni hte; na a amyu masha ni tai nga na matu mayam kaw nna hkrang shaw la hkrum sai na a amyu masha ni hpe dum nga u. Nang lang mi nga lai wa sai Ziun bum hpe dum nga u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte a gumlau hpyen ni atsai awai hpya jahten kau sai Nawku Htingnu kata na arung arai ni mahkra hpe sa du gawan yu u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a gumlau hpyen ni gaw awng padang ninglaw hpe Htingnu kata hta jahtau garu nga ma ai; shanhte a dawnghkawn ni hpe mung awng padang kumla hku nna dai shara ni hta jung da nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw nwa ni hte hpun kran daw ai hpun kran masha ni zawn rai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw maka ka da ai hpunpyen yawng hpe sumdu kaba hte nwa ni hte abyen agrawp kau manu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw na a Nawku Htingnu hpe agrawp daw kau nna wan hte nat kau nga masai; shing rai, nang hpe nawku daw jau ai shara hpe shanhte awu asin di kau manu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw anhte yawng hte hpe atsai awai agrawp kau mayu nga masai; dai lamu ga hta nga ai chyoi pra ai shara shagu hte hpe shanhte wan nat kau da manu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a makam masham hte seng ai chyoi pra ai kumla ni hpe n mu lu saga ai; dai shara hta myihtoi langai mi mung n nga nga sai hte kade daram na hkra, ndai zawn byin wa na lam, kadai mung n chye nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />O Karai Kasang e, na a gumlau hpyen ni gaw kade na hkra, nang hpe mani asawng nga na ma ai kun? Na a mying nsang hpe shanhte htani htana n kaw n law di nga na ma ai kun?
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang anhte hpe karum la na matu hpa majaw ningdang kau nga n ni? Na a lata ni hpe hpa majaw shingdu de hkintum da nga n ta?
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai ti mung, Karai Kasang e, nang gaw shawng npawt kaw nna anhte a hkawhkam wa rai nga nit dai; nang anhte hpe law law lang mung, hkye hkrang la nit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a daru magam n-gun hte panglai hka hpe garan kau nhtawm; panglai numraw ni a baw ni hpe abrep kau ya nit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang gaw baren numraw Lewihtan a baw ni hpe abrep kau nna; shanhte a hkum shan ni hpe nam mali hkan nga ai dusat ni hpe jaw sha kau nit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hka deng ni hte hka hpawk ni hpe nang shalwi dat nna, hka nu kaba ni hpe nang jahkraw kau nga ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang gaw shani hte shana hpe hpan da nna, jan hte shata yan hpe dai yan a nga shara ni hta nang masat tawn da nga ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mungkan ga a jarit ni hpe nang shadawn ya nga ndai; ginhtawng hte nshung ta ni hpe nang hpan da nga nit dai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rai ti mung, Madu e, na a gumlau hpyen ni nang hpe asawng asang di nga ai hpe, dum nga u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Karum la na jinghku n lu ai na a amyu masha ni hpe mazut ai gumlau hpyen ni a lata de hkum kau da nga et; zingri zingrat hkrum sha nga ai na a amyu masha ni hpe hkum malap kau nga et!
  </para>
  <para style="p">
    <verse number="20" style="v" />Anhte hte nang tawn da sai ga shaka hpe dum nga u; dai mung na sin mang nga ai njut nnaw shara shagu hkan kashun kashe du daw sai hkaw re ai amu nga nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dip gamyet sha hkrum nga ai ni hpe kaya kahpa hkum jahkrum et; matsan mayan ni hte ra kadawn nga ai ni gaw nang hpe shakawn nga mu ga law.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang e, rawt u, nang galaw ai amu hpe makawp maga u! karai kata ai masha ni gaw shani tup nang hpe mani asawng nga ma ai hpe dum nga u.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na a gumlau hpyen ni a sin pawt lahtet marawn jahtau ai hte; na a hpyen ni matut manoi garu ai nsen ni hpe hkum malap kau nga et.
  </para>
  <chapter number="75" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, anhte nang hpe chyeju dum shakawn ga ai; anhte nang hpe chyeju dum shakawn ga ai! Anhte gaw nang kade wa hkik hkam ai lam hpe htawn tsun ga ai, nang galaw dan sai mauhpa amu ni hpe anhte tsun ga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang gaw, “Tara jeyang na aten ladaw hpe ngai tawn da se ai,” “Shing rai, rap ra ai tara hte ngai jeyang na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mungkan ga hte dai hta nga ai hkrung mahkrung mahkra hte gari ashun awam wa ti mung; de a npawt nhpang ni hpe ngai shangang shakang da na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai tara n lang ai ni gaw myit tsaw myit dap n rai nga mu ga, ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte a shakawng shakat ai lam hpe jahkring kau na matu mung ngai shanhte hpe hkang da ni ai,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tara dara ai lam gaw sinpraw maga kaw nna, shing n rai, sinna maga de na; dingdung maga kaw nna shing n rai, dingda maga de nna du sa wa na ra ai n rai;
  </para>
  <para style="p">
    <verse number="7" style="v" />Tara agyi gaw dai Karai Kasang nan rai nga ai, shi gaw nkau mi hpe jeyang daw dan nna nkau mi hpe mara shalawt dat ya na ra ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw shi a masin kahtet ai ngu ai nsa ja ai sabyi ntsin hte hpring nga ai gawm hpe shi a lata hta lang da nga ai. Dai ntsin hpe shi ru dat ai hte tara n lang ai ni yawng hte gaw dai hpe lu nga ma ai; shanhte gaw kahte mi pyi n ngam mat hkra lu kau nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung, Yaku a Karai Kasang a lam hpe tsun nga ai hte shi hpe mahkawn shakawn na; ngai galoi mung jahkring kau na we ai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tara n lang ai ni a n-gun atsam hpe shi shadaw kau ya na ra ai; rai ti mung, ding hpring ai ni a daru magam n-gun hpe chyawm gaw shi rawt jat kaba shangun na ra ai law.
  </para>
  <chapter number="76" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yuda mung hta e, Karai Kasang hpe chye ma ai, shi a mying nsang hpe Israela mung hta e, shagrau sha-a nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw Yerusalem mare hpe shi a nta shatai nna, Ziun Bum ntsa hta e, shi shanu nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw hpyen ni a pala ni hpe mung, shanhte a ninggang ni hte nhtu ni hpe mung, rai sa, shanhte a laknak yawng hpe mung, agrawp shadaw kau ya wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang e, na a hpung shingkang kade wa galu kaba nga lit hka! Na a hpyen ni hpe nang dang kau ai bum ni kaw na nang nhtang wa yang, na a arawng sadang gaw kade wa kaba nga lit hka!
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte a share shagan ai hpyenla ni gaw shanhte lu ai arai yawng raw sharun la kau ai hkrum ma ai; ya, shanhte si kadawng taw nga masai. Shanhte a n-gun hte kung kyang ai lam yawng hte mung kaman lila sha rai mat manu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yaku a Karai Kasang e, nang shanhte hpe jahkrit shama dat ai shaloi; gumra ni hte dai hta jawn nang nga ai ni di hkrat si mat masai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai ti mung, Madu e, nang hpe masha yawng hte wa, hkrit kamyin nga ma ai. Nang masin pawt ai shaloi kadai mung na a man e, n lu rawt tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ga ntsa e, dip gamyet sha hkrum ai ni yawng hte hpe hkye hkrang la na matu, tara dara ai lam hpe daw dan na nang rawt tsap wa ai shaloi; mungkan ga gaw hkrit ai hte atsin sha nga nga nu ai. Nang gaw na a tara dara ai lam sumsing lamu kaw nna chye shangun nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Masha a masin kahtet ai lam gaw na a matu grau nna shakawn na lam chyu sha shabyin ya nga ai; majan ni hta n si ai sha, naw hkrung ngam nga ai ni gaw na a masat da ai poi ni hta kabu gara shang lawm lu na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu na a Karai Kasang hpe nang jaw da ai ga sadi hte maren jaw ya u; makau grup yin hta nga nga ai masha amyu baw ni yawng hte e, shi hpe kumhpaw kumhpa sak jaw mu. Karai Kasang gaw masha ni, hpe hkrit kamyin shangun nga ai;
  </para>
  <para style="p">
    <verse number="12" style="v" />shi gaw gumrawng gumtawng ai hkawhkam shadang sha ni hpe shagrit kau nna; galu kaba ai hkawhkam ni hpe jahkrit shama nga ai.
  </para>
  <chapter number="77" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw Karai Kasang hpe ja ja jahtau nngai; ngai ja ja jahtau ai majaw, shi na ya nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai gaw Ru tsang hkrum ai aten ni hta, Madu hpe akyu hpyi nngai; shana tup ngai gaw nye a lata ni hpe sharawt nna akyu hpyi ai, rai ti mung, shalan shabran ai lam hpe ngai n mu lu nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai Karai Kasang a lam hpe myit yu ai shaloi, nsa kaba shaw nngai; ngai myit aru yu ai shaloi, myit ru myit yak ai lam hpe ngai hkam sha nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi ngai hpe shana tup jasu tawn ai; ngai nau wa myit tsang ai majaw, aga pyi n lu shaga nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw lai mat wa sai nhtoi ni hpe myit aru yu ai hte; lai mat wa sai shaning ni hpe myit dum nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai shana tup sung sung myit sumru yu nna nga shalai kau nngai; ngai myit aru yu ai hte, ndai lam hpe nye hkum ngai san yu nngai;
  </para>
  <para style="p">
    <verse number="7" style="v" />“ Madu gaw anhte hpe tut nawng e, kabai kau sana nu ai kun? Shi anhte hpe galoi mung bai n ra sharawng mat na nu ai kun?
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi anhte hpe n tsaw ra sana nu ai kun? Shi a ga sadi mung hten mat sana nu ai kun?
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang gaw matsan dum na malap kau nu ai kun? Matsan dum la na malai, masin kahtet bu nga ai kun?”
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi, ngai hpe machyi shangun htum ai gaw, “Karai Kasang hta daru magam n-gun n rawng mat sai,” nga ai rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu e, na a galu kaba ai magam amu ni hpe ngai myit dum nga na nngai; nang galaw lai wa sai mauhpa amu ni hpe ngai bai myit dum nga na nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang galaw dan lai wa sai lam yawng hte hpe ngai myit yu nga na nngai; na a grau htum ai magam amu ni hpe ngai myit aru yu nga na nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />O Karai Kasang e, nang galaw ai lam shagu hte gaw chyoi pra nga ai; nang zawn galu kaba ai karai shaje n nga nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang gaw laklai ai mauhpa amu ni hpe galaw ai Karai Kasang rai nga ndai; masha amyu ni a ka-ang hta na a grau htum ai atsam hpe madun dan nga nit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a daru magam n-gun hte na a amyu masha ni rai nga ai Yaku hte Yosep yan a aru arat ni hpe nang hkye hkrang la nga nit dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Karai Kasang e, hka hpung ni nang hpe mu ai shaloi, dai ni nang hpe hkrit nga ma ai; panglai hka a sung ai shara hkan na hka ni mung kanawng nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sumwi ni marang htu jahkrat ya nna, lamu kaw na mu ngoi agung nga ai hte mungkan shara shagu de myi hprap gala nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na a mu ngoi agung nga nna, myi hprap wan ni mungkan ga hpe jahtoi ya nga ai; mungkan ga mung gari ai hte ashun awam nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang gaw hka leng ni a ntsa hku hkawm lai mat wa nna; sung ai panglai hka hpe lai di mat wa nga ndai, rai ti mung, na a lagaw hkang hpe kadai mung n mu lu nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang gaw Mawshe hte Arun yan hpe ningbaw shatai nhtawm, na a amyu masha ni hpe sagu rem wa zawn woi wa nit dai.
  </para>
  <chapter number="78" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a amyu masha ni e, nye a sharin shaga ai ga hpe madat la mu, ngai tsun ai ga hpe mung madat la mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anhte a kaji kawa ni anhte hpe tsun dan sai majaw, anhte chye da sai magam amu ni hte;
  </para>
  <para style="p">
    <verse number="3" style="v" />lai sai prat kaw nna magap da ai mauhpa lam ni hpe hpaji ga ni hte nanhte hpe ngai tsun shaleng dan na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai lam ni hpe anhte a kashu kasha ni a man e, makoi da na ga ai n rai; Madu a daru magam n-gun a lam, shi a galu kaba ai magam amu ni hte shi galaw dan sai mauhpa lam ni hpe hpang ban prat masha ni hpe anhte htawn tsun dan na ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw Israela amyu masha ni hpe jep ai tara ni hte; Yaku a aru arat ni hpe hkang da ai tara ni hte jaw da ya nit dai. Madu gaw shi a hkang da ai tara ni hpe shanhte a kashu kasha ni hpe sharin ya na matu; anhte a kaji kawa ni hpe tsun matsun da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai, hpang ban prat na masha ni gaw shanhte a kashu kasha ni hpe matut nna kayin tsun dan lu mu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ndai lam hku nna, shanhte mung Karai Kasang hpe kam hpa na mara ai; shi galaw dan sai amu ni hpe shanhte malap kau na mara ai n rai, dai sha n ga, shi a hkang da ai tara ni hpe tut nawng madat mara na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw gumlau ai ni hte n madat n mara ai ni, Karai Kasang hpe kam hpa ai lam hta galoi mung n ngang ai ni hte shi hta sadi sahka myit n dung ai shanhte a kaji kawa ni zawn rai nga na ma ai n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ndan pala ni hpe chye lang nna gasat chye ai Ehprim a kashu kasha ni gaw majan shani e, hprawng mat ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte gaw Karai Kasang hte ga shaka tawn da ai hpe n mazing da nga ma ai; shi a hkang da ai tara ni hpe hkan sa na matu, ningdang kau nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw shi galaw dan sai magam amu ni hte shanhte mu yu sai mauhpa lamik kumla ni hpe malap kau manu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Egutu mung hta nga ai Zoan prang yang hta e, shanhte a kaji kawa ni yu nga yang, Karai Kasang gaw mauhpa lamik kumla ni hpe madun dan nu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi gaw panglai hka hpe lahkawng brang garan kau nna, hka hpe lahkawng maga de shakum zawn shatsap da ai hte shanhte hpe dai lam hku, woi lai mat wa nu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw shanhte hpe shani e sumwi hte shana tup wan a nhtoi hte woi wa mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nam mali na lunghkrung ni hpe shi kayat hpaw nna; shanhte hpe sung ai shara ni kaw na hka jaw lu mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw lunghkrung hta na hka hpe shapraw ya nhtawm; hka nu zawn lwi shangun nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai ti mung, shanhte gaw Karai Kasang hpe gumlang ai yubak matut galaw nga ma ai; nam mali e mung, Tsaw Htum ai Wa hpe shanhte gumlau kau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte gaw shanhte sha mayu ai lusha hpe hpyi ai hku nna, Karai Kasang hpe dingsa sa chyam yu nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Nam mali kata e, Karai Kasang gaw anhte hpe lusha jaw ya lu na kun?
  </para>
  <para style="p">
    <verse number="20" style="v" />Lunghkrung hpe shi gayat ai hte hka hpungtun hte lwi pru wa shangun ai gaw teng nga sai; rai ti mung, shi anhte hpe muk lusha hte shi a amyu masha ni hpe shan jaw ya lu na kun?,” nga nna Karai Kasang hpe gumlang ai hte shanhte tsun ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai, shanhte tsun shaga ai ga hpe shi na wu ai shaloi, Madu gaw masin pawt nga wu ai; shi a amyu masha ni hpe wan hte shi gasat nna, shi a masin kahtet ai gaw shanhte a ntsa e grau grau nna law jat wa nu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hpa majaw nga yang, shanhte shi hpe n kam nga ma ai hte shi hkye hkrang la lu nga ai lam hpe shanhte n kam nga ma ai majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai ti mung, shi gaw ntsa na lamu hpe tsun wu ai hte; sumsing lamu na chyinghka ni hpe hpaw na matu hkang dat wu ai;
  </para>
  <para style="p">
    <verse number="24" style="v" />shi gaw shanhte sha na matu, Manna hpe jahtu ya nhtawm; sumsing lamu na nsi naisi shanhte hpe jaw mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai, shanhte gaw lamu kasa ni a lusha sha lu ma ai; shanhte marit ai lam yawng mayawng Karai Kasang shanhte hpe jaw ya mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sinpraw nbung hpe mung shi bung shangun nna, shi a daru magam n-gun hte dingda nbung hpe kabrawng shangun nhtawm;
  </para>
  <para style="p">
    <verse number="27" style="v" />hkin-gau ntsa e, nga ai zaibru zawn law nga ai u ni hpe mung, shi a amyu masha ni a matu, shi jahkrat jaw ya nga sai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte a dap ka-ang, shanhte a nga shara sum ni a makau grup yin hta dai ni hpe jahkrat ya wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shing rai, amyu masha ni sha lu ma ai hte myit dik nga ma ai; shanhte ra marit nga ai lam, Karai Kasang shanhte hpe jaw ya nga sai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rai ti mung, shanhte dai daram sha lu nga ninglen, myit dik ai lam n lu la nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai majaw, Karai Kasang shanhte hpe masin pawt wa nna; shanhte a n-gun ja htum ai ni hte Israela ni a share shagan shabrang ni hpe shi sat kau ya wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ndai lam ni yawng hpe shanhte hkrum kadup nga ma ti mung; amyu masha ni gaw yubak naw galaw shanang nga ma ai, shi a mauhpa lamik kumla hte madun dan ti mung, shanhte shi hpe n kam hpa nga ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai re ai majaw, shanhte a shani nhtoi ni hpe nsa zawn; shanhte a asak ni hpe kajawng kaja re ai tsin-yam tsindam ni hte jahtum kau ya wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shanhte kaw na n kau mi hpe shi sat kau ai aten shagu hta, ngam ai ni gaw shi hpang de kayin wa ma ai; shanhte myit malai wa nna, Madu kaw akroi anoi akyu hpyi nga ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Karai Kasang gaw shanhte hpe makawp maga nga ai wa rai nga ai hte; shanhte hpe karum la na matu, Chyahtum Chyalai n-gun rawng ai Madu du sa nga ai lam hpe, shanhte dum nga masai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Rai ti mung, shanhte a tsun shaga ai ga ni masu magaw ga ni hkrai rai nga ma ai hte shanhte tsun shaga ai lam ni myit malang ai hku hpa mung n rai nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte gaw shi hta sadi dung nga ai ni n rai nga ma ai; shi hte ga shaka tawn da ai lam hta mung kangka ai ni n rai ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Rai ti mung, Karai Kasang gaw shi a amyu masha ni hpe matsan dum nga ai; shi shanhte hpe n shamyit kau ai sha, shanhte a yubak hpe raw dat kau ya nu ai. Shi gaw shi a masin kahtet ai lam hpe law law lang shakawp da nna; shi a pawt sindawng ai hpe hkum shadang da nga ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shanhte gaw si chye ai hkrung kanu ni sha rai nga ai; nbung bung lai mat wa nna me rai, mat mat ai nbung zawn rai nga ma ai hpe shi dum ya wu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shanhte nam mali hkan e, shi hpe kade lang wa gumlau kau nga ma ai; kade lang wa shi hpe myit shayawn kau nga ma hka!
  </para>
  <para style="p">
    <verse number="41" style="v" />Shanhte gaw Karai Kasang hpe lang hte lang chyam yu nna Israela a chyoi pra ai Karai Kasang hpe, myit machyi shangun wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Madu a galu kaba ai daru magam n-gun hte shanhte a gumlau hpyen ni a lata kaw nna shanhte hpe hkye hkrang la sai nhtoi hpe mung;
  </para>
  <para style="p">
    <verse number="43" style="v" />Egutu mung, Zoan pa layang e, shi a laklai ai amu ni hte mauhpa lamik kumla ni hpe madun dan nga sai lam hpe shanhte malap kau manu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shi gaw Egutu masha ni hka n lu lu mat hkra, hka nu, hka shi kaw na hka ni hpe sai shatai kau ya nu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shi shanhte hpe nni nkri jaw ya lu ai jinghkam ni hpe mung, shanhte a lamu ga hpe jahten kau ya na matu, shu ni hpe mung, shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shanhte a nsi naisi ni hpe sha kau ya na matu mung, shanhte a lagum hpun ni hpe hkyen hte mung, dinggam-yaw ni hpe mung shi shangun dat ya nu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Shanhte a sabyi sun ni hpe sin marang hte mung, shanhte a lagum hpun ni hpe hkyen hte mung, shi sat kau ya wu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Shanhte a yam nga ni hpe sin tawng ni hte mung, shanhte a dusat u hpung ni hpe mu myi hprap hte mung, sat kau ya wu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shi gaw shi a pawt sindawng ai hpe ru dat nna; Si Du a kasa ni du sa wa ai zawn, tsin-yam tsindam, nchyi nmu re ai ru tsang kaba, shanhte hpe shabyin dat ya wu ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Shi gaw shi a masin kahtet ai lam hpe n jahkring da ai hte; shanhte a asak ni hpe n lahpawt dum ai sha, ana zinli hte shanhte hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Egutu mung ting na dinghku yawng a shadang sha alat ni hpe shi sat kau ya wu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Dai hpang, shi gaw shi a amyu masha ni hpe sagu rem ai wa zawn, woi wa nna; shanhte hpe nam mali hku woi lakawn wa mu ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Shi shanhte hpe shim lum ai hku woi wa mu ai majaw shanhte n hkrit nga ma ai. Rai ti mung, panglai hka gaw shanhte a gumlau hpyen ni hpe ka-up kau mu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Shi shanhte hpe shi a chyoi pra ai lamu ga de mung; shi hkum nan dang manga tawn da sai bum ni de mung woi wa nga nu ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Shi a amyu masha ni shawng de rawt sa wa ai shaloi, shawng e de nga sai amyu masha ni hpe shi gawt shapraw kau ya nhtawm; Israela amyu baw ni hpe shanhte a lamu ga garan ya ai hte, shi a amyu masha ni hpe shanhte a dum nta ni jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Rai ti mung, shanhte gaw Chyahtum Chyalai n-gun rawng ai Karai Kasang hpe gumlau nga ma ai hte shi hpe chyam yu nhtawm, shi a hkang da ai tara ni hpe n madat mara nga ma ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Shanhte a kaji kawa ni zawn, sadi n dung ai sha gumlau ai ni rai nga ma ai; magaw ai ndan pala zawn, n mai kam ai ni rai ma ai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Shanhte gaw maigan hpara ni a nawku ai shara ni hte shanhte a hpara sumla ni hte shi hpe sindawng kahtet shangun nga masai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Dai lam ni hpe shi mu wu ai shaloi, Karai Kasang masin pawt nu ai; shing re ai lam ni a majaw, shi a amyu masha ni hpe tsep kawp kabai kau da nu ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Shi gaw anhte a ka-ang hta nga lai wa sai Shilo mare na sum nta hpe kau da nu ai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Shi a daru magam n-gun hte hpung shingkang a kumla rai nga ai Sakse Sumpu hpe gumlau hpyen ni rim la kau na ahkang shi jaw kau ya wu ai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Shi a amyu masha ni hpe shi masin pawt nna; shanhte a gumlau hpyen ni a lata hta sat kau ai hkrum mu ga, shi ap kau ya wu ai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Shabrang ni majan hta sat kau ai hkrum nga ma ai; mahkawn ni mung shanhte hpe hkungran la na masha langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Hkinjawng ni mung kashun kashe du daw sai hkaw re ai amu hta si mat nga ma ai; shanhte a gaida jan ni hpe hkrap ngu hkrap ngoi na ahkang n jaw wu ai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Jahtum e, Madu gaw yup nga ai kaw na yup hprang wa ai wa zawn; sabyi ntsin a majaw myit katu kahtet wa nna n-gun ja ai share shagan wa zawn hprang wa nga sai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Shi a gumlau hpyen ni hpe kanut wa shangun nna; prat dingsa kaya kahpa jahkrum da nga wu ai.
  </para>
  <para style="p">
    <verse number="67" style="v" />Rai ti mung, Yosep a matu mara ni hpe shi kabai kau nna; Ehprim a amyu baw ni hpe shi n lata la nga ai.
  </para>
  <para style="p">
    <verse number="68" style="v" />De a malai, Yuda a amyu baw masha ni hte, shi grau tsaw ra ai Ziun Bum hpe lata la nu ai.
  </para>
  <para style="p">
    <verse number="69" style="v" />Dai shara hta e, sumsing lamu na shi a nta hte bung ai shi a Nawku Htingnu hpe gaw gap da wu ai; htani htana prat ting ngang kang nga ai lamu ga zawn, dai hpe ngang ngang kang kang shi gaw da nga wu ai.
  </para>
  <para style="p">
    <verse number="70" style="v" />Shi gaw shi a shangun ma Dawi hpe lata la nu ai, sagu hpung ni hpe bau rem nga ai udat shara ni kaw na shi hpe lata la nhtawm;
  </para>
  <para style="p">
    <verse number="71" style="v" />Israela amyu masha ni a hkawhkam, Karai Kasang a amyu masha ni a sagu rem wa tai nga na matu, shi hpe san da nu ai.
  </para>
  <para style="p">
    <verse number="72" style="v" />Dawi gaw shanhte hpe tinggyeng myit n rawng ai sha lanu lahku bau maka ai hte; kung kyang ai hpaji hte shanhte hpe woi lakawn wa nga sai.
  </para>
  <chapter number="79" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, maigan amyu ni na a lamu ga hpe shang gasat ma ai; na a chyoi pra ai Nawku Htingnu hpe shanhte awu asin di kau nga manu ai; Yerusalem mare hpe mung jahten sharun kau da manu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte gaw na a amyu masha ni a moi mang ni hpe langda ni a matu; na a nchyang mayam ni a moi mang ni hpe matse labye dusat ni sha na matu, tawn da nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw na a amyu masha ni a asai hpe hka zawn, jahkaw ma ai; Yerusalem mare hku lwi hkrat wa ai hka ni zawn, sai hka lwi nga nhtawm, si ai masha ni makoi mayang na masha langai mi mung n nga sai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Htingbu mungdan amyu masha ni mung anhte hpe asawng asang di mi ai; anhte hpe mani ai hte n kaw n law di da mi ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, nang anhte hpe htani htana masin pawt nga na n ni? Na a masin kahtet ai lam gaw wan zawn matut nna hkru shangun na wu ni?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang hpe nawku daw jau ai lam n galaw ai ni, nang hpe akyu n hpyi ai masha amyu ni a ntsa e, na a masin kahtet ai lam, ru bun dat u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw na a amyu masha ni hpe sat kau ma ai, na a mungdan hpe mung, shanhte jahten sharun kau manu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anhte a kaji kawa ni a yubak majaw, anhte hpe ari hkum jaw et; anhte a myit mada shara yawng shamat kau saga ai majaw, ya jang, anhte hpe matsan dum la mi law.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang e, anhte hpe karum la mi, anhte hpe hkye hkrang la mi; na a mying nsang a gawp e, anhte hpe mawai la mi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Na a Karai Kasang kanang nga nga lit ta?,” nga nna amyu baw ni anhte hpe hpa rai dai zawn san shara nga shangun na rai ta? Na a shangun ma ni a asai jahkaw kau ya ai masha amyu baw ni hpe, nang ari jaw ai lam, anhte hpe mu mada shangun mi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bawng dung masha ni a madai ai nsen ni hpe madat ya u; si ari daw dan hkrum nga ai ni hpe, na a kaba la ai daru magam n-gun hte shalawt dat u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, maigan mungdan ni a n kaw n law re ai hte nang hpe kabai tawn nga ma ai majaw, shanhte hpe sanit lang ari bai htang jaw u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi, anhte na a amyu masha ngu ai na a sagu hpung na sagu ni, nang hpe htani htana chyeju dum nga na ga ai hte, du wa na aten ahkying yawng hta mung, chyeju shakawn nga na ga ai law.
  </para>
  <chapter number="80" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela amyu masha ni a Sagu Rem Wa e, anhte hpe madat ya mi; sagu hpung ni a ningbaw wa e, anhte hpe na ya mi. Singkaw tu ai hkrung kanu ni a ntsa na, na a tingnyang hta dung nga ai wa e,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ehprim, Benyamin hte Manashe amyu baw ni hpe nang hkum nan shadan dan nna; na a daru magam n-gun madun dan ai hte anhte hpe hkye hkrang la na du sa wa rit!
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang e, anhte hpe bai woi nhtang wa mi law! Na matsan dum lama ai myit anhte hpe madun ya mi, shaloi anhte hkye hkrang la ai hkrum na raga ai!
  </para>
  <para style="p">
    <verse number="4" style="v" />Chyahtum Chyalai n-gun rawng ai Madu Karai Kasang e, nang gaw galoi du hkra, na a amyu masha ni a akyu hpyi ai ga ni a jaw e, pawt nga na n ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw anhte a yawn hkyen ai hpe lusha zawn jaw sha nna; myi prwi hpe gawm kaba hta jaw lu nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang gaw anhte a lamu ga hpe, grup yin mungdan ni hpe sa gasat shangun nga ndai; anhte a gumlau hpyen ni mung anhte hpe n kaw n law di mi ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chyahtum Chyalai n-gun rawng ai Karai Kasang e, anhte hpe bai woi nhtang wa mi law! Na matsan dum lama ai myit anhte hpe madun ya mi, shaloi anhte hkye hkrang la ai hkrum na raga ai!
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw Egutu mung kaw na sabyi ru langai mi hpe la wa ndai; kaga amyu baw ni hpe nang gawt shapraw kau nhtawm, dai hpe shanhte a lamu ga hta, hkai nit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sabyi hpun tu kaba wa lu na matu lamu ga hpe nang jasan shatsawm ya nga ndai; de a hpun ru ni ga de ru jung mat wa nna dai gaw lamu ga ting a ntsa e, hkram wa nga sai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai gaw kawng ni hpe, shi a shingnip hte hkung ka-up nga ai; de a lakung ni mung kaba la ai arit hpun ni hpe htawng nga sai.
  </para>
  <para style="p">
    <verse number="11" style="v" />De a lakung ni gaw Nawng Kaba de lagra nna, Uhprat hka nu du hkra, hkrawn jat wa sai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hpe kum shinggrup da ai shakum ni hpe nang hpa majaw jahten kau nga n ta? Ya gaw, ndai lam hku lai sa ai ni kadai rai ti mung, dai sabyi si ni hpe lagu di la lu nga manu ai;
  </para>
  <para style="p">
    <verse number="13" style="v" />dai hpun hpe wa ndu ni e, kabye agrawp mat wa nna, matse labye dusat ni, dai hte hkru kat nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyahtum Chyalai n-gun rawng ai Karai Kasang e, anhte hpe mada mara la mi! Sumsing lamu kaw nna anhte hpe gum yu nna, na a amyu masha ni hpe hkye hkrang la na matu, du sa wa rit!
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang kaba shangun ai sabyi hpun lawn hte nang hkai da ai sabyi ru ni hpe sa makawp maga la u.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anhte a gumlau hpyen ni dai hpe wan nat kau nna, kran daw kau nga masai; shanhte hpe masin kahtet ai hte yu nna shanhte hpe jahten kau u!
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang lata la sai amyu masha ni ngu ai, n-gun grai ja wa hkra nang sharawt tawn ai amyu hpe mada mara ai hte makawp maga ya nga u.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anhte galoi mung, nang kaw na htak mat wa na ga ai n rai; anhte hpe jahkrung la mi, anhte nang hpe shakawn nga na ga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chyahtum Chyalai n-gun rawng ai Madu Karai Kasang e, anhte hpe bai woi nhtang wa mi law. Na a matsan dum lama ai myit anhte hpe madun dan mi, shaloi anhte hkye hkrang la ai hkrum na raga ai.
  </para>
  <chapter number="81" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anhte a dahpran shara Karai Kasang hpe kabu gara jahtau nga mu; Yaku a Karai Kasang hpe mahkawn shakawn nga mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Madum sumpyi shawng dum ai hte hpang wa mu, shup sheng ni hpe dum mu; pyaw ngawn ai tingse sumpyi hte daw raw ni hte dum mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shata praw hte shagawng shani e, poi galaw na matu, pahtau dum mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai gaw Israela hta nga nga ai tara rai nga nna, Yaku a Karai Kasang kaw na lu la ai ga ndat rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Egutu mung hpe shi gasat ai shaloi, Israela amyu masha ni hpe jaw ya ai ga ndat rai nga ai. N chye na ai ga nsen langai mi hpe ngai na nngai, dai nsen gaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Nanhte a shingma na lit ni hpe ngai shayu kau ya nna, nanhte a wut tawng hpai ai ka htang ni hpe ngai jahkrat da ya ni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang ru tsang hkrum nga ai shaloi, ngai hpe shaga manit dai hte; ngai nanhte hpe hkye hkrang la ni ai. Nbung laru kata na, nye a makoi nga ai shara kaw nna ngai nanhte hpe htan ya mani ai. Meriba hka hpawk e, ngai nanhte hpe chyam yu made ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a amyu masha ni e, ngai sadi jaw ai ga hpe madat la mu; Israela amyu masha ni e, ngai hpe madat ya na, ngai kade wa ra sharawng nga a hka!
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte gaw kaga hpara shaje hpe galoi mung n nawku lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai nanhte hpe Egutu mung kaw nna shapraw la ai nanhte a Madu Karai Kasang rai nga nngai. Nanhte a n-gup ni hpe mahka mu, ngai nanhte hpe lusha jaw na mawe ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Rai ti mung, nye a amyu masha ni ngai hpe madat na ma ai n rai; Israela amyu masha ni ngai hpe madat mara nga ma ai n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai, shanhte a baw ja ai lam hku sa wa lu mu ga; shanhte ra mara hpe galaw lu mu ga, ngai shanhte hpe ahkang jaw dat nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nye a amyu masha ni ngai tsun ai ga hpe na ya na, ngai kade myit ra nga a hka; nye a a ga hpe shanhte madat mara ya na, ngai kade wa marit nga a hka!
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai gaw shanhte a gumlau hpyen ni hpe alawan sha dang kau ya nna; shanhte a hpyen ni yawng hpe shamyit kau na we ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai hpe n ju n dawng nga ai ni mahtang nye a man e, hkrit kamyin ai hte dingnyawm wa nna; shanhte hkrum sha na ari mung htani htana rai na mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai ti mung, kaja htum ai hkaulan mam hte ngai shanhte hpe bau nna, nam na lagat jahku hte shanhte hpe myit dik hkra jahkru na mawe ai.”
  </para>
  <chapter number="82" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw sumsing lamu na kongsi hpe woi awn nga ai; karai ni a zup hpawng hta shi a daw dan ai lam hpe tsun dan nga ai;
  </para>
  <para style="p">
    <verse number="2" style="v" />“N tara ai hku tara jeyang ai lam hpe nanhte jahkring da lu na myit dai; tara n lang ai ni hpe myi man tau ai lam nanhte kachyi mi mung n rai lu na myit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Matsan mayan ni hte jahkrai ma ni a ahkaw ahkang ni hpe makawp maga ya mu; ra kadawn nga ai ni hte karum la na masha kata ai ni hpe rap ra ai hku jeyang mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />N hkru n hkra re ai masha ni a n-gun atsam kaw na shanhte hpe mawai la mu!
  </para>
  <para style="p">
    <verse number="5" style="v" />“Nanhte gaw hpaji n chye nga myit hka! Kade sha angawk angak rai nga myit hka! Nanhte gaw tsep kawp hten run mat manit dai; teng man rap ra ai tara gaw ndai mungkan kaw na mat mat sai.
  </para>
  <para style="p">
    <verse number="6" style="v" />‘Nanhte gaw karai ni rai nga myit dai, nanhte yawng gaw Tsaw Htum ai Wa a kasha ni rai nga myit dai,’ ngu nna ngai tsun ni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai ti mung, masha ni zawn, nanhte si wa na marin dai; hkawhkam kasha ni zawn nanhte a asak htum mat na marin dai.”
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang e, sa rit, mungkan ga hpe up hkang nga u; amyu baw ni yawng hte gaw na a hkrai rai ma ai.
  </para>
  <chapter number="83" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, azim sha hkum nga nga et; chyasi chyamang hkum rai nga et, atsin sha mung hkum nga nga et!
  </para>
  <para style="p">
    <verse number="2" style="v" />Yu u, na a gumlau hpyen ni gumlang nga ma ai; nang hpe n ju n dawng nga ai ni rawt malan nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw na a amyu masha ni hpe gumlang na matu mayun hpaji daw nga ma ai; nang e makawp maga da nga ai ni hpe mung, shanhte gumlang na maw mawn nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw, “Sa marit, shanhte a mungdan hpe anhte jahten kau ya ga: shing rai, Israela amyu ni htani htana malap kau ai hkrum nga mu ga,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw shanhte a yaw shada ai lam hpe jawm myit hkrum da ma ai, nang hpe gumlang na matu, jinghku hpung langai hpe jawm hpaw ninghtan da nga ma ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />Edom amyu masha ni hte Ishmaela amyu ni, Moba amyu masha ni hte Hagara amyu ni;
  </para>
  <para style="p">
    <verse number="7" style="v" />Gebala amyu ni, Amon hte Amalek amyu ni, Hpilisti ni hte Turu amyu masha ni lawm nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asuri masha ni mung, Lawt a aru arat ni rai nga ai Amon masha ni hte Moba masha ni hpang maga de, jinghku hpyen hpung hta shang lawm nga masai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte hpe Midian masha ni hte Kishon hka nu makau e, Sisera hte Yabin yan hpe di ai zawn di kau u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang shanhte hpe Endora e dang kau ai hte shanhte a moi mang ni gaw ga ntsa e, yat taw mat mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Oreb hte Zeeb hpe nang galaw kau ai zawn, shanhte a ningbaw ningla ni hpe mung di u; Zeba hte Zalmuna hpe nang galaw kau ai zawn, shanhte a du salang ni yawng hte hpe mung dang kau u,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Karai Kasang madu da ai lamu ga hpe anhte gaw, anhte a matu la kau na ga ai,” nga nna kadai wa tsun kau nga a ta?
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang e, shanhte hpe ga nhpu zawn agat kau nna; nbung e shapoi kau ai numhkaw zawn, shapoi kau u.
  </para>
  <para style="p">
    <verse number="14" style="v" />Maling dinggram hpe wan hte hkru kau nga ai, bum ni hpe jahkat kau ai sharaw wan shinglet numli ni zawn:
  </para>
  <para style="p">
    <verse number="15" style="v" />na a nbung laru hte shanhte hpe hkan shachyut nang nna, na a nbung bungga ni hte shanhte hpe jahkrit kau u.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu e, shanhte a myi man ni hpe, kaya kahpa hte ka-up da ya u; na a daru magam n-gun, shanhte hpe hkam la shangun u.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte gaw htani htana sum mat ai hte jahkrit shama ai hkrum sha nga mu ga; tsep kawp sari jahpoi hkrum ai hte shanhte si htum mat mu ga.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang chyu sha Madu rai nga ai lam hte ga ntsa ting hta e, Tsaw Htum ai Wa rai nga ai lam hpe shanhte chye na la mu ga law.
  </para>
  <chapter number="84" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chyahtum Chyalai n-gun rawng ai Madu e, na a Nawku Htingnu hpe ngai kade wa tsaw ra nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai shara hta ngai kade wa nga mayu nga a hka! Madu a Nawku Htingnu kata hta shanu nga lu na ngai marit nga nngai. Nye a hkum hkrang, myit masin mahkra hte hte, ahkrung nga ai Karai Kasang hpe ngai kabu gara mahkawn shakawn nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a hkawhkam hte nye a Karai Kasang Chyahtum Chyalai n-gun rawng ai Madu e, u tsa ni pyi, na a tawn hkungri ni a makau e, shanhte a tsip galaw nga ma ai, pilan ni mung shanhte a matu nta lu nga ma ai, shing rai, shanhte a u hkalung ni hpe dai shara ni hta tawn da nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a Nawku Htingnu kata hta nang hpe tut nawng mahkawn shakawn let; shanu nga ai ni gaw kade wa a nga ma hka!
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang kaw na n-gun atsam lu la nna, Ziun Bum de nawku lung wa na matu myit katu nga ai ni gaw kade wa a nga ma hka.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw Baka ngu ai hkun hkraw ai kadit hpe lai di mat wa yang; dai gaw hka hpawk ni lwi pru ai shara tai wa nga ai; mahpawng hpaw marang gaw dai shara hpe la-ing ni hte jahpring ya nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte hkawm sa mat wa magang n-gun atsam grau nna jat la lu nga ma ai; Ziun Bum ntsa e, karai ni a Karai hpe shanhte wa mu lu na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chyahtum Chyalai n-gun rawng ai Madu Karai Kasang e, nye a akyu hpyi ga hpe na ya e; Yaku a Karai Kasang e, madat ya e!
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang e, nang lata san da sai hkawhkam ngu ai anhte a hkawhkam wa hpe shaman ya u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a Nawku Htingnu hta lani mi sha nga lu ai gaw kaga shara e, nhtoi hkying mi nga ai hta grau kaja nga ai; Ngai gaw tara n lang ai wa a nta ni hta nga lu ai gaw Karai Kasang a nta chyinghka hkinbawng hta e, tsap nga na hpe, grau nna tsaw nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu gaw anhte hpe makawp maga ai wa hte hpung shingkang hte hpring ai hkawhkam wa rai nna; matsan dum ai myit hte arawng sadang anhte hpe shaman ya nga ai. Shi gaw teng man ai amu galaw ai ni hpe mai kaja ai lam hpa hpe mung jaw ya na, ningdang ai n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chyahtum Chyalai n-gun rawng ai Madu e, nang hpe kam hpa nga ai ni gaw kade wa a lu nga ma hka!
  </para>
  <chapter number="85" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang gaw na a lamu ga hpe matsan dum nga ndai; Israela amyu masha ni hpe kalang mi bai ngamu ngamai shangun nga nit dai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang gaw na a amyu masha ni a yubak ni hpe raw dat kau ya nit dai; shanhte a shut hpyit ai lam ni hpe mara dat kau ya nga nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte hpe masin pawt ai lam nang jahkring kau nna; na a masin kahtet ai hpe mung shakawp kau nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte a hkye la Madu Karai Kasang e, anhte hpe mi na hte maren bai hkap la mi, anhte hpe n yu ra hkum rai nu yaw!
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang anhte hpe htani htana masin pawt nga na n ni? Na a masin kahtet ai lam galoi mung n htum mai na rai sani?
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte hpe n-gun atsam kalang mi bai shaja ya mi: shing rai, anhte, na a amyu masha ni nang hpe shakawn nga na ga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu e, na a dinggrin tsaw ra myit anhte hpe madun ya mi; na a hkye hkrang la ai karum la lam, anhte hpe jaw ya mi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu Karai Kasang tsun nga ai ga hpe ngai madat nga nngai; anhte gaw angawk angak re ai lam ni de n kayin sa mat wa ai rai yang, shi a amyu masha ni rai nga ai anhte hpe ngwi pyaw sim sa ai lam jaw ya na shi ga sadi tawn da nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi hpe shagrau sha-a ai ni hpe shi hkye hkrang la na, kaja wa, jin jin rai nga ai; shi a hkye hkrang la ai hpung shingkang gaw anhte a lamu ga hta nga nga na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tsaw ra myit hte sadi sahka myit gaw rau dan pru wa nga ai; ding man ai hte ngwi pyaw sim sa ai lam mung, ahpum ginshum wa na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Masha a sadi sahka gaw ginding aga kaw nna rawt lung wa nhtawm; Karai Kasang a ding man ai lam, sumsing lamu kaw nna gum yu na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu gaw anhte hpe ngamu ngamai shangun na ra ai; anhte a lamu ga gaw nsi naisi nhpaw n-ya shapraw ya na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ding man ai lam gaw dai Madu a shawng e, sa wa nna; shi a matu lam shajang shajin ya na ra ai.
  </para>
  <chapter number="86" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, ngai hpe karum la na masha n lu nga nngai hte gawng kya nga nngai majaw, ngai hpyi nem ai ga hpe madat ya nna htan ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai gaw nang hta sadi dung nga nngai majaw, si ai kaw nna ngai hpe hkye hkrang la e, ngai nang hta kam hpa nga nngai hte na a shangun ma rai nga nngai majaw, ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw nye a Karai Kasang rai nga ndai majaw, ngai hpe matsan dum la e; ngai shani tup, nang kaw akyu hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, Nye a akyu hpyi ai ga ni nang kaw hkrang lung wa nga ai majaw; na a shangun ma wa hpe kabu shangun e law.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw anhte a ntsa e, mai kaja nga nna mara dat kau ya nga ndai; nang kaw akyu hpyi nga ai ni yawng a matu, na a dinggrin tsaw ra myit hpe hpring hpring tsup tsup hkam sha shangun nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu e, nye a akyu hpyi ai ga hpe madat ya e; karum la na matu ngai hpyi jahtau ai nsen ni hpe na ya e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a akyu hpyi ai ga hpe nang htan ya ndai majaw; ru tsang hkrum ai aten ni hta ngai nang hpe shaga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, nang hte bung ai karai langai mi mung n nga nga ai. Nang galaw da lu sai amu ni zawn, kadai mung n lu galaw nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang hpan tawn da ai masha amyu baw ni yawng hte gaw nang kaw sa nna dingnyawm wa na mara ai; shanhte gaw na a galu kaba ai lam hpe shakawn na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw galu kaba nga nna mauhpa amu ni hpe galaw nga ndai; nang chyu sha Karai Kasang rai nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu e, nang ngai hpe galaw shangun mayu ai lam ngai hpe sharin ya e, ngai gaw na a ga hpe kangka ai hte madat mara nga na nngai; nang hpe tsep kawp ap nawng ai myit masin hte daw jau lu na lam, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu nye a Karai Kasang e, ngai nang hpe nye a myit masin mahkra hte shakawn nga nngai; na a galu kaba ai lam hpe ngai htani htana htawn tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a dinggrin tsaw ra myit gaw nye a matu kade wa kabu gara nga a hka! Nang gaw ngai hpe lup sung hku kaw nna nan hkye hkrang la nit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang e, gumrawng gumtawng ai masha ni ngai hpe sa gumlang nga ma ai; nang hpe hpa zawn n nawn ai ni hte gumshem ai masha hpung mi gaw ngai hpe sat hkyen nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, Madu e, nang gaw tsaw ra matsan dum ai Karai Kasang rai nga ndai; nang gaw tut nawng e hkam sharang ai, matsan dum ai hte sadi sahka nga ai wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai hpe mada mara ya nna matsan dum la e; ngai gaw nye nu daw jau ai zawn, ngai nang hpe daw jau ai majaw, ngai hpe n-gun shajat ya nna hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Madu e, na a mai kaja ai sakse, ngai hpe madun dan e; nang ngai hpe jaw ya ai shangwi shapyaw lam hte karum la ai lam hpe mu ai shaloi, ngai hpe n ju n dawng nga ai ni kaya kahpa hkrum mat na mara ai.
  </para>
  <chapter number="87" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu gaw shi a mare hpe chyoi pra ai bum ntsa e, de da nu ai;
  </para>
  <para style="p">
    <verse number="2" style="v" />shi gaw Yerusalem mare hpe Israela mung e nga ai kaga mare ni yawng hta grau nna tsaw ra nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang a mare e, shi tsun dan ai na a mauhpa amu ni hpe madat u:
  </para>
  <para style="p">
    <verse number="4" style="v" />“Nye a ga hpe madat mara ai mungdan ni a jahpan hpe hta ai shaloi, Egutu mung hte Babelon yan hpe ngai shalawm la na ring ngai; Hpilisti, Turu hte Sudan amyu masha ni hpe, Yerusalem mare masha jahpan hta ngai sawn bang ya na nngai.”
  </para>
  <para style="p">
    <verse number="5" style="v" />Ziun chyawm gaw amyu baw yawng hte hte seng nga ai; Chyahtum Chyalai n-gun rawng ai Wa gaw dai bum hpe shangang shakang da na ra ai, nga nna tsun pru wa na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu gaw amyu masha ni a jahpan hpe ka tawn da na ra ai; shanhte ni hpe Yerusalem mare a mung chying sha hku shalawm da na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ziun gaw anhte a shaman chyeju lam yawng hte hpe hkam la shangun ai hka hpawk rai nga ai,” nga nna shanhte ka manawt ai hte mahkawn shakawn ma ai.
  </para>
  <chapter number="88" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai hpe hkye hkrang la ai Madu Karai Kasang e shani tup ngai nang hpe hpyi jahtau nna; shana e mung, na a man de du sa nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a akyu hpyi ai ga hpe na ya e; karum la na matu, nye a hpyi jahtau ai nsen hpe madat ya e!
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai ru tsang law law hkrum sha nga nngai majaw, si mahka de du nga ni ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Si hkyen wa nga ai kaga masha ni yawng zawn ngai rai nga nngai hte; nye a n-gun atsam ni yawng mung htawng mat nga li ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw si ai ni a lapran hta kabai da ai hkrum nga nngai; lasa si nna shanhte a lup sung hku kata kaw kaleng taw nga ai ni zawn ngai rai nga nngai. Dai ni hpe nang tsep kawp malap kau nna, shanhte gaw na a karum la ai lam hpe n hkam la lu ai ni rai nga masai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang ngai hpe sin dik htum ai hte sung dik htum ai nhkun ngu ai; sung ai lup wa kata de kabai bang kau nit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a masin kahtet ai lam gaw nye a ntsa e, li hkra gamyet da nga ai; dai masin kahtet ai hka leng ni a npu hta ngai ayai aya rai mat nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw nye a manang ni hpe ngai hpe kau da shangun nit dai; nang ngai hpe shanhte a man e, matsat shabat shatai kau nit dai. Ngai gaw la sharawng da ai hkrum nga nngai hte lawt lam hpe n mu lu ni ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />nni nkri hkam sha ai majaw, nye a myi ni amam nga li ai. Madu e, ngai nang hpe shani shagu shaga nga nngai hte; nye a lata ni hpe sharawt nna, nang kaw akyu hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw si mat ai ni a matu lamik kumla ni hpe madun dan nga n ni? Shanhte rawt nna, nang hpe shakawn nga ma ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Lup sung hku kata e, na a dinggrin tsaw ra myit a lam hpe tsun kajai nga ma ni? Ngarai mung e na a sadi sahka lam hpe shanhte hkai nga ma ni?
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai sin htat ai shara hta na a mauhpa lamik kumla ni hpe mu lu nga a ni? Malap kau hkrum ai masha ni a mung hta na a mai kaja ai lam hpe chye lu nga a ni?
  </para>
  <para style="p">
    <verse number="13" style="v" />Madu e, karum la na matu, ngai nang hpe shaga nga nngai; jahpawt shagu nang kaw akyu hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Madu e, nang ngai hpe hpa majaw kau da nga n ta? Nang ngai kaw nna hpa majaw kayin mat wa n ni?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai naw kaji nga ai aten kaw nna nni nkri hpe hkam sha ni ai gaw ganoi noi si hkra rai ni ai; nang jaw ai ari ahpri ni a majaw ngai hki ba la nga nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a masin kahtet ai gaw ngai hpe agrawp ayai kau nna; nang ngai hpe gasat ai majaw, ngai hpe jahten kau nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte ngai hpe mawru hka zawn shani tup gawan da nna; ngai hpe wang shinggrup da nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang gaw nye a ni dik ai manang ni hpe kau da shangun nit dai; sin htat ai nsin chyu sha nye a manang rai nga sali ai.
  </para>
  <chapter number="89" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, na a dinggrin tsaw ra myit a lam hpe ngai tut nawng e, mahkawn mangoi nga na nngai; na a sadi sahka hpe ngai htani htana htawn tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a tsaw ra myit prat tup grin nga na ra ai hte na a sadi sahka mung; sumsing lamu zawn grin ngang nga ai hpe ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw, “Ngai lata da ai masha wa hte ga shaka tawn da ni ai, nye a shangun ma kaja Dawi hpe ga sadi jaw da ni ai hte maren,
  </para>
  <para style="p">
    <verse number="4" style="v" />‘Na a aru arat hpe tut nawng e, hkawhkam shatai da nna, na a hkawhkam amyu ni hpe htani htana shagrin da na nngai,’” nga nna tsun nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, sumsing lamu ni gaw nang galaw ai mauhpa lam ni hpe mung, chyoi pra ai ni gaw na a sadi sahka lam hpe mung, mahkawn mangoi nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu e, sumsing lamu hta e, nang hte bung ai wa kadai mung n nga nga ai; sumsing sha ni kadai mung nang hte shabung lu nga ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw chyoi pra ai ni a hpawng hta hkrit hkungga ai lam hkam la lu nga ndai; shanhte yawng hte gaw nang hpe mau mahka let tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chyahtum Chyalai n-gun rawng ai Madu Karai Kasang e, nang zawn daru magam n-gun rawng ai wa kadai mung n nga nga ai; Madu e, nang gaw lam shagu hta sadi sahka nga ai wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw n-gun hte hpring ai panglai hka hpe up hkang nga ndai; de a ja la ai hka leng ni kabrawng wa tim, nang shazim kau nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw hka numraw Rahab hpe agrawp kau ai hte dai hpe sat kau nga ndai; nang na a gumlau hpyen ni hpe na a chyahtum chyalai n-gun hte dang kau nga sai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sumsing lamu hte ginding aga gaw na a rai nga ai; mungkan ga hte dai hta nga ai arai yawng mayawng hte hpe mung nang galaw da nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dingdung hte dingda hpe nang hpan da nit dai; Tabura bum hte Hermon bum ni mung nang hpe kabu gara mahkawn shakawn ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang gaw daru magam n-gun kade wa kaba nga lit hka! na a n-gun kade wa galu kaba nga lit hka!
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a mungdan hpe ding man ai hte teng man ai lam hta npawt gaw da nga ai; nang galaw ai lam shagu hte hta tsaw ra myit hte sadi sahka ai lam hpe madun dan nga ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahkawn hkawn ai hte nang hpe nawku daw jau ai ni hte; na a matsan dum lama ai myit a nhtoi hta hkawm sa nga ai amyu masha ni gaw kade wa a lu nga ma hka!
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a majaw shanhte shani tup kabu gara nga ma ai; na a mai kaja ai lam a majaw shanhte nang hpe shakawn nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang anhte hpe awng padang kaba jaw ya nga ndai; na a tsaw ra myit hta, anhte hpe nang awng dang shangun nga ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Madu e, Nang gaw anhte hpe makawp maga la na wa hpe lata da ya nga ndai; Israela a chyoi pra ai Karai Kasang e, nang anhte a matu hkawhkam jaw ya nit dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kalang mi na shingran langai mi hta, na a kangka ai shangun ma kaja ni hpe nang tsun ai gaw, “Gumhkawng ai hpyenla langai mi hpe ngai shadaw karum yu se ai; amyu masha ni kaw na langai mi hpe ngai lata la nna hkawhkam tingnyang ap ya se ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a shangun ma kaja Dawi hpe chyoi pra ai namman sau hte chya ya nna hkawhkam aya dang ya se ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a n-gun gaw shi hte rau tut nawng anga nga na ra ai hte; nye a daru magam n-gun hte shi hpe n-gun shaja ya na ra ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi a gumlau hpyen ni shi hpe galoi mung dang lu na n rai; tara n lang ai wa mung shi hpe dip lu na ra ai n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi a hpyen ni hpe ngai agrawp ayai kau na we ai hte; shi hpe n dawng nga ai masha shagu hte hpe ngai sat kau na we ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngai shi hpe tsaw ra nga nna shi hta sadi dung nga na nngai; ngai shi hpe tut nawng e, awng dang shangun na nngai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngai gaw shi a mungdan hpe Ka-ang Panglai kaw nna Uhprat hka nu du hkra maden ya na nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi gaw ngai hpe, ‘Nang gaw nye a kawa hte nye a Karai Kasang rai nga ndai, nang gaw ngai hpe makawp maga nga ai wa hte ngai hpe hkye hkrang la ai Madu rai nga ai,’ nga nna tsun na ra ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngai shi hpe nye a kasha alat aya hta dang da na nngai; hkawhkam ni yawng hte hta grau kaba ai wa, ngai shatai na we ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nye a ga sadi shi hta tut nawng e ngai shagrin da nna; shi hta tawn da ai ga shaka htani htana agrin nga na ra ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shi a hkawhkam amyu gaw lamu zawn ngang grin wa na ra ai; shi a matu mara ni gaw tut nawng e hkawhkam tai nga lu na mara ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Rai ti mung, shi a matu mara ni gaw nye a tara hpe n madat n mara nna; nye a hkang da ai tara ni hte maren n hkawm n sa nhtawm,
  </para>
  <para style="p">
    <verse number="31" style="v" />nye a sharin shaga ai ga ni hpe shanhte hpa zawn n nawn ai hte; nye a hkang da ai tara ni hpe n hkan sa ai rai yang chyawm gaw;
  </para>
  <para style="p">
    <verse number="32" style="v" />Shanhte galaw sai yubak ni a majaw, ngai ari jaw na mawe ai. Shanhte a shut hpyit ai mara ni a majaw, ngai shanhte hpe nni nkri hkam sha shangun na mawe ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rai ti mung, Ngai gaw Dawi hpe tut nawng tsaw ra nga nna, shi tawn da ai nye a ga sadi hpe mung, ngai jahten sharun kau na n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi hte galaw da ai nye a ga shaka hpe ngai jahten kau na n rai, shi hta tawn da ai ga sadi langai mi hpe pyi ngai shabai la na we ai n rai.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Nye a chyoi pra ai mying nsang hta kalang ta ga sadi hpe ngai shagrin da se ai; ngai gaw Dawi hpe galoi mung masu na we ai n rai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shi a aru arat ni matut manoi anga nga na mara ai; jan a shingkang htoi nga dingsa, ngai shi a mungdan hpe sin yu nga na we ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Lamu hta shata gaw grin ai sakse tai nga ai zawn, dai mungdan mung agrin nga na ra ai,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Rai ti mung, nang gaw nang lata ai hkawhkam wa hpe masin pawt nga ndai; nang shi hpe kabai kau da ai hte tawn kau da nit dai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Na a shangun ma hte tawn da ai ga shaka hpe nang jahten kau nit dai hte; shi a janmau hpe ga nhpu de, nang jahkrat kau ya nit dai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shi a mare bunghku ni hpe nang run jahkrat kau ya nhtawm; shi a hpyen dap ni hpe jahten kau ya nit dai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lai wa lai sa masha yawng hte gaw shi a arung arai ni hpe lagu la ma ai; shi a htingbu ni yawng mung shi hpe mani asawng nga ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shi a gumlau hpyen ni hpe nang shadang shangun nna; shanhte yawng hte hpe nang kabu gara shangun nga nit dai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nang gaw shi a hpyen laknak ni hpe jahten kau ya nna; shi hpe majan pa hta jasum kau shangun nga ndai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shi a hkawhkam sumdoi hpe nang la kau ya nna; shi a hkawhkam tingnyang hpe ga de kadawng kau ya nit dai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nang gaw shi hpe shi a aten garai n du yang dingla shangun nna, kaya kahpa jahkrum da nit dai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Madu e, nang na hkum hpe htani htana htinggrum makoi da na ngu nga n ni? Na a masin kahtet ai gaw wan zawn kaden du hkra hkru nga na rai ta?
  </para>
  <para style="p">
    <verse number="47" style="v" />Nye a asak kade daram kadun nga ai hpe dum nga u; si mat chye ai anhte yawng hte hpe nang hpan da nga ndai hpe mung dum u.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kadai wa, galoi mung n si n mat mat ai sha, asak hkrung nga lu na rai nga a ta? Masha gaw shi hkum shi lup sung hku de n shang mat wa hkra, gara hku shingdang da lu nga a ni?
  </para>
  <para style="p">
    <verse number="49" style="v" />Madu e, shawng na na a tsaw ra myit a sakse ni gara kaw rai nga a ta? Dawi hpe nang jaw tawn sai ga sadi ni gara kaw rai nga ma ta?
  </para>
  <para style="p">
    <verse number="50" style="v" />Na a mayam wa, ngai kade asawng asang hkrum nga nngai rai ti mung, tara maigan ni a dagam dala ga hpe gara hku ngai hkam sharang nga ai hpe rai ti mung, hkum malap kau ya e.
  </para>
  <para style="p">
    <verse number="51" style="v" />Madu e, nang lata san da ai hkawhkam wa hpe na a gumlau hpyen ni n kaw n law di nga ma ai! Shi hkawm sa ai shara shagu hta, shi hpe asawng asang di mu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Madu hpe htani htana shakawn kungdawn nga mu law! Amen! Amen!
  </para>
  <chapter number="90" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang gaw anhte a tut nawng na shingbyi shara dum nta rai nga ndai;
  </para>
  <para style="p">
    <verse number="2" style="v" />Bum ni hpe garai n hpan da ai hte mungkan ga garai n lat ai aten kaw nna, nang gaw chyi nma pri npra Karai Kasang rai nga ndai; htum ngu n nga ai htani htana Karai Kasang mung nang rai nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw shinggyim masha ni hpe ga nhpu de bai shabai kau nna; shanhte hpe mi na shara de nhtang wa masu, nga nna nang tsun nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a matu shaning hkying mi gaw lani mi zawn rai nga nna; dai ni gaw lai mat wa sai mani na nhtoi hte kadun la ai shana na ahkying aten zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang anhte hpe hka mawru zawn garawt agre mat wa nna; anhte gaw yup mang mang ai daram pyi, n nga lu nga ai. Jahpawt e maku ku wa nhtawm,
  </para>
  <para style="p">
    <verse number="6" style="v" />tu kaba wa nna pu lagra nga ti mung, shana de hkraw mat ai hte si mat ai tsingdu ni zawn anhte rai nga ga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a pawt sindawng ai hta anhte jahten kau ai hkrum nga saga ai; na a masin kahtet ai hta anhte hkrit gari ai hkrum nga saga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw anhte a yubak ni hpe na a man e tawn da nna; anhte a makoi magap da ai yubak ni hpe nang mu lu na shara hta e, tawn da ya nga ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a pawt sindawng ai hta anhte a asak ni hpe kadun kau shangun ndai; dai gaw kahte tsun ai ga nbung zawn hkoi mat na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anhte yawng lu ai asak gaw sanit shi ning rai nga ga ai. anhte n-gun ja ga ai rai yang chyawm gaw matsat shi ning du nga ga ai; ti mung, dai asak hkrung ai laman hte hta, ru tsang ai hte yawn hkyen ai hpe sha hkam sha nga ga ai, hkring mi rai jang asak mung lai mat wa nna anhte mung hkoi mat nga ga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a n-gun hte hpring ai pawt sindawng ai hpe kadai wa hkam sha yu nga a ni? na a ja la ai masin kahtet ai lam gaw kade daram hkrit kahpra shangun nga ai hpe kadai wa chye ya lu nga a ni?
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte hpaji chye wa na matu anhte a asak prat kade daram kadun nga ai lam anhte hpe sharin ya mi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a masin kahtet ai gaw kade wa na hkra rai na rai nga a ta? Madu e, na a shangun ma ni hpe matsan dum la mi law!
  </para>
  <para style="p">
    <verse number="14" style="v" />Jahpawt shagu, na a dinggrin tsaw ra myit hte anhte hpe jahpring ya mi; shing rai, anhte a asak prat tup kabu gara ai hte nang hpe mahkawn shakawn nga lu u ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anhte nni nkri hkrum sha nga ai shaning ni yawng hte hta nang anhte hpe jaw ya sai yawn hkyen hkrum shangun ai daram anhte hpe ya e, kabu gara ai lam jaw ya mi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a shangun ma ni rai nga ai anhte hpe na a grau htum ai magam amu ni hpe mu shangun mi; anhte a aru arat ni mung na a hpung shingkang hte hpring ai n-gun atsam ni hpe mu shangun mi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anhte a Madu Karai Kasang e, na a shaman ai chyeju gaw anhte hte rau rai nga u ga. Anhte galaw ai amu shagu hte hta awng dang ai lam anhte hpe jaw ya mi law!
  </para>
  <chapter number="91" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shim nga lu na matu, Madu hpang de du sa wa ai wa kadai rai ti mung; Chyahtum Chyalai n-gun rawng ai Wa a makawp maga ai npu hta shanu nga ai wa kadai rai ti mung,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Nang gaw nye a dahpran shara hte ngai hpe makawp maga ai wa rai nga ndai; nang gaw nye a Karai Kasang rai nga ndai, nang hta ngai kam hpa nga nngai,” nga nna shi hpe tsun lu nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw n mu lu ai hkrithpa tsin-yam yawng hte hte, si shangun lu ai ana ahkya ni yawng kaw nna; nang hpe shim hkra makawp maga la na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw shi a singkaw ni hte nang hpe magap da na ra ai, shi a lanu lahku mada mara ai hta nang shim nga lu na ra ai; shi a sadi sahka gaw nang hpe makawp maga ya ai hte, bau sin ya na ra ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shana e hkrum chye ai kaning re ai hkrithpa tsin-yam rai tim, shani e akajawng sha byin wa ai gasat gala lam hpe rai tim;
  </para>
  <para style="p">
    <verse number="6" style="v" />nsin e byin ai ana zinli ni hpe rai tim, shani e, n hkru ai ni sat wa ti mung, dai ni hpe nang n hkrit ra nga ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a makau e masha hkying mi, na a grup yin e mun mi si taw nga ti mung; nang hta machyi hkrum lu na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tara n lang ai ni, kaning rai ari hkrum sha nga ma ai hpe nang mu mada lu na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw Madu hpe na a makawp maga shara hte Tsaw Htum ai Wa hpe na a shingbyi shara nang shatai nit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai majaw tsin-yam tsindam hpe nang hkrum lu na n rai; kashun kashe du daw sai hkaw lam mung na a nta hta ni wa lu na n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang hkawm sa ai shara shagu hta nang hpe makawp maga na hte; nang hpe bau sin na matu, Karai Kasang gaw shi a lamu kasa ni hpe hkang da na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nlung ni hta na a lagaw n ahtu u ga, shanhte a lata ni hte nang hpe pawn la na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkanghkyi ni hte lapu ni, matse ai hkanghkyi ni hte tuk rawng ai lapu ni a ntsa e, nang kabye hkawm lu na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang gaw, “Ngai hpe tsaw ra ai ni hpe, ngai hkye la na ring ngai; ngai hpe Madu zawn yin la ai ni hpe ngai makawp maga na ring ngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte ngai hpe shaga yang, ngai shanhte hpe htan ya na nngai; shanhte ru tsang hkrum yang, ngai shanhte hte rau nga nga na nngai. Ngai shanhte hpe mawai la nna; shagrau sha-a na mawe ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai shanhte hpe asak galu shangun na nngai, ngai shanhte hpe hkye hkrang la na nngai,” nga nna tsun ai.
  </para>
  <chapter number="92" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu hpe chyeju dum shakawn nna Tsaw Htum ai Karai Kasang a hpung shingkang arawng sadang hpe mahkawn mangoi let,
  </para>
  <para style="p">
    <verse number="2" style="v" />mahku pyaw ai tingse, sumri rawng ai madum sumpyi ni hte jahpawt manap shagu na a dinggrin tsaw ra myit hte shana shagu na a sadi sahka lam ni hpe htawn tsun dan ai gaw, kade wa mai kaja nga a hka!
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, na a mauhpa magam amu ni gaw ngai hpe kabu shangun nga ai; nang galaw da sai bungli ni a majaw ngai kabu gara mahkawn shakawn nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, na a amu ni gaw kade wa galu kaba nga a hka! na a myit sawn ai lam ni mung kade wa sung nga a hka!
  </para>
  <para style="p">
    <verse number="6" style="v" />Angawk ai masha wa n chye lu ai hte hpaji n rawng ai masha wa myit n hkawn lu ai lam baw mi nga nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tara n lang ai ni gaw tsingdu ni zawn tu wa lu nna, shut hpyit ai amu galaw let ngamu ngamai lu ma ti mung; shanhte yawng hte gaw tsep kawp jahten kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, nang chyawm gaw htani htana agrau nga ai wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a gumlau hpyen ni si mat wa na mara ai hte; tara n lang ai ni yawng hte mung, sum mat ai hkrum na mara ai gaw, anhte chye nga ga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw ngai hpe hpaw lam zawn n-gun shaja ya nna; ngai hpe kabu gara ai hte nang shaman ya nit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a gumlau hpyen ni sum mat ai hpe ngai mu lu se ai hte; tara n lang ai masha ni a hkrap shabam ai nsen ni hpe na lu se ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ding hpring ai masha ni gaw namhtan hpun ni zawn bawng ring wa nna; Lebanon a arit hpun ni zawn shanhte tu kaba wa na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai ni gaw Madu a nta hta hkai da nna, anhte a Karai Kasang a Htingnu hta lali tsawm nga ai hpun ni hte bung nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpun gaw hpundaw wa ai aten hta pyi asi naw si nna; tut nawng e tsit lali nga ai hte ja kat nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai hpe makawp maga ai Madu gaw ding man nga nna; shi hta hpa mung hkum tsup nga ai lam hpe madun dan nga ai.
  </para>
  <chapter number="93" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu gaw hkawhkam rai nga ai. Shi gaw daru magam hpung shingkang hte n-gun hpe bu hpun da nga ai. Mungkan ga hpe ngang ngang kang kang shi gaw da nna dai gaw shamu shamawt n lu nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu e, na a tingnyang gaw shawng npawt kaw nna ngang grin nga sai, nang gaw aten ahkying ni a shawng kaw nna pyi, nga nga nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu e, nammukdara a nsen ni ngoi kashaw nga ai; dai ni a nsen wu kadu ai hte kashaw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu gaw nammukdara a ngoi kashaw ai hte panglai hka leng ni hta pyi grau nna daru magam n-gun rawng nga ai, sumsing lamu hta e tsaw htum ai hku up hkang nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, na a hkang da ai tara ni gaw htani htana agrin nga ai, na a Nawku Htingnu mung teng teng chyoi pra nga nna, htani htana agrin nga ai.
  </para>
  <chapter number="94" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang gaw ari jaw ai Karai Kasang rai nga ndai; na a masin kahtet ai hpe madun dan u!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang masha yawng mayawng hte hpe tara jeyang ai wa rai nga ndai; rawt nna, gumrawng gumtawng ai ni lu la ang ai hte maren, ari jaw ya u!
  </para>
  <para style="p">
    <verse number="3" style="v" />Tara n lang ai masha ni galoi aten du hkra kabu gara lu na rai nga ma ta? Madu e, galoi aten du hkra rai na kun?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ru hka amu galaw shapraw ai ni mung galoi aten du hkra, gumrawng gumtawng lu nna grang dakat lu na rai nga ma ta?
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, shanhte gaw na a amyu masha ni hpe adip arip di nna; nang madu tawn sai amyu masha ni hpe shanhte dip gamyet sha nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw gaida jan ni hte jahkrai ma ni hpe sat nga ma ai hte, anhte a lamu ga hta nga ai tsasam manam ni hpe mung htau kau ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw, “ Madu anhte hpe n mu nga ai; Israela a Karai Kasang mung n yu nga ai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a amyu masha ni e, nanhte gaw kaning rai nna hpaji n rawng ai hte angawk angak rai mayu nga myit ni? Galoi mi she, sharin hkam la na ngu nga myit ni?
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang gaw anhte a na ni hpe hpan da ya mani ai-shi anhte hpe ari n jaw na rai wu ni? Karai Kasang gaw anhte a myi ni hpe hpan da ya mani ai-shi n mu lu na rai wu ni?
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw amyu baw ni hpe daru sharin nga ai- shi anhte hpe ari n jaw na rai wu ni? Shi gaw shinggyim masha ni yawng a sharin sara rai nga ai-shi hpaji n rawng nga a ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu gaw shanhte hpa myit nga ai hpe chye nga ai, shi gaw shanhte a myit sawn yu ai lam, kade lachyum n pru nga ai hpe chye ya nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, nang matsun madun ai hte nang sharin ya ai tara hpe hkam la lu ai wa gaw kade wa a nga a hka!
  </para>
  <para style="p">
    <verse number="13" style="v" />Tara n lang ai ni hpe mahkam hkam na matu, nhkun htu tawn ai aten du hkra ru tsang ai nhtoi ni kaw na, nang shi hpe ban sa ai lam jaw ya nga ndai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Madu gaw shi a amyu masha ni hpe kau da na ra ai n rai; shi hte seng ai amyu masha ni hpe kabai kau da na ra ai n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tara rung ni hta teng man ai lam hpe bai mu lu wa na ra ai; ding hpring ai masha ni yawng hte mung dai lam hpe madi shadaw na mara ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kadai wa gaw nye a maga de tsap nna, tara n lang ai masha ni hpe gumlang yu nga a ni? Kadai wa gaw nye a maga de nga nna, n hkru ai amu galaw ai ni hpe ninghkap yu nga a ni?
  </para>
  <para style="p">
    <verse number="17" style="v" />Lama, Madu gaw ngai hpe n karum ai rai yang, katsi katsang re ai lamu ga de, tin tin ngai sa mat wa na we ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Ngai kashawt taw nga nngai,” nga nna ngai tsun nngai; rai ti mung, Madu e, na a dinggrin tsaw ra myit hte ngai hpe pawn sharawt la nga ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai myit ru myit tsang hkrum hkra nga ai shaloi; nang ngai hpe shalan shabran ai hte kabu gara shangun nga ndai.
  </para>
  <para style="p">
    <verse number="20" style="v" />N tara ai amu hpe tara shang hkra chye galaw nna, dai zawn re ai gumhpraw marin ai tara agyi ni hte nang hpa mung n seng nga ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte gaw kaja ai masha ni hpe n hkru ai hku maw mawn nhtawm, mara n kap ai masha ni hpe si ari jaw nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai ti mung, dai Madu gaw nye dahpran shara rai nna; nye a Karai Kasang ngai hpe makawp maga ya nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi shanhte hpe tara n lang ai amu a jaw e, ari jaw na ra ai, shanhte a yubak ni a majaw shanhte hpe jahten kau na ra ai; Madu anhte a Karai Kasang gaw shanhte hpe jahten shamyit kau na mu ai law.
  </para>
  <chapter number="95" style="c" />
  <para style="p">
    <verse number="1" style="v" />Wa marit, Madu hpe anhte shakawn ga! Anhte hpe makawp maga ai Karai Kasang hpe kabu gara mahkawn shakawn ga!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a man e, chyeju dum let anhte shang nna, mahkawn mangoi ga hte shi hpe kabu gara shakawn ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaning rai nme law, Madu gaw Chyahtum Chyalai n-gun rawng ai Karai Kasang, karai ni yawng a ntsa e up nga ai n-gun hte hpring ai hkawhkam wa rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw sung htum ai lungpu hku kaw nna tsaw htum ai bum pungding du hkra, mungkan ga ting hpe up hkang nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi hpan da ai panglai hka hte shi hkum nan hkrang shapraw gaw da ai lamu ga hpe mung, shi up nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sa marit, anhte shi hpe dingnyawm ai hte nawku daw jau ga; anhte a Madu Hpan Wa Ningsang Wa a man e, lahput hput di ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw anhte a Karai Kasang rai nga ai; anhte gaw shi e lanu lahku tawn ai amyu masha ni; shi bau rem da nga ai sagu hpung ni rai nga ga ai. Shi tsun shaga ai ga ni hpe dai ni jang, madat la mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Meriba e nga lai wa sai nanhte a kaji kawa ni zawn nanhte a du ni hpe hkum shaja da nga myit; nam mali na Masa shara e, nanhte a kaji kawa ni nga lai wa ai shaloi na zawn, nanhte a myit hpe hkum shaja da nga myit.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte gaw shanhte a matu, ngai galaw shapraw dan sai amu ni hpe mu lu manu ai; rai ti mung, ngai hpe dai shara hta chyam yu manit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai gaw mali shi ning tup, dai amyu masha ni hpe n yu ra mat nngai. ‘Shanhte gaw kade wa sadi n dung nga ma hka! shanhte gaw nye a hkang da ai tara ni hpe ndang kau ai ni rai ma ai.’
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai pawt sindawng nga nngai hte, ‘Nanhte myit sim myit sa hte nga lu na matu, ngai lajang da ya ai mungdan de, galoi mung shang sha lu na ra ai n rai,’” ngu nna dagam shaka da nngai.
  </para>
  <chapter number="96" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe mahkawn ga nnan hte mahkawn mu! Mungkan ga ting dai Madu hpe mahkawn shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu hpe mahkawn mu, shi hpe shakawn mu! Shi anhte hpe hkye hkrang la sai ngu ai kabu gara shiga hpe shani shagu htawn tsun nga mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masha amyu ni hpe shi a hpung shingkang, amyu masha ni yawng hte hpe shi a grau htum ai magam amu ni hpe htawn tsun dan nga mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw galu kaba nga ai majaw grai shakawn ging ai wa rai nga ai; karai ni yawng hta shi hpe shagrau sha-a na mai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaga tsasam amyu baw ni yawng hte a karai ni gaw hpara sumla ni hkrai rai nga ma ai; rai ti mung, dai Madu chyawm gaw sumsing lamu ni hpe hpan da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hpung shingkang hte galu kaba ai hpung shingkang gaw shi hpe shinggrup da nna; daru magam n-gun hte tsawm htap ai lam gaw shi a Nawku Htingnu hta hpring nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aga ting na amyu masha ni yawng hte e, dai Madu hpe shakawn mu; shi a hpung shingkang hte daru magam n-gun hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu a hpung shingkang hte seng ai mying nsang hpe shakawn mu; shagu hkungga lang let, shi a Nawku Htingnu de shang sa wa mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi dan pru wa ai shaloi, Chyoi Pra Ai Wa a man e, dingnyawm mu; aga ting shi a man e, hkrit gari nga mu!
  </para>
  <para style="p">
    <verse number="10" style="v" />“Dai Madu gaw hkawhkam rai nga ai! Aga hpe ngang ngang kang kang shi gaw da nna, dai gaw shamu shamawt nga ai n rai; shi gaw amyu masha ni hpe teng man ai lam hte tara jeyang na ra ai,” nga nna amyu baw ni yawng hpe tsun mu.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ginding aga hte sumsing lamu ni e, kabu gara nga mu! panglai hte dai hta rawng ai hkrung mahkrung yawng hte e, shi hpe nsen kaba hte jahtau garu nga mu;
  </para>
  <para style="p">
    <verse number="12" style="v" />pa ni hte dai hta na nga manga yawng hte e, kabu gara nga mu! maling na hpun ni kabu gara jahtau garu wa na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw mungkan ga hpe up hkang na matu du sa wa ai shaloi, shi gaw mungkan ga na amyu masha ni hpe teng man rap ra ai tara ni hte up hkang na ra ai.
  </para>
  <chapter number="97" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw hkawhkam rai nga ai! Ginding aga e, kabu jahtau nga u! panglai zunlawng ni e, nanhte mung kabu gara nga mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sumwi ni hte nsin gaw shi hpe gawan shinggrup da nna; shi gaw tara ai hte ding man ai hku up hkang nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a shawng e, wan sa wa nna shi hpe wang shinggrup da ai gumlau hpyen ni hpe hkru kau nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a myi hprap gaw mungkan ga hpe jahtoi ya nga nna, aga gaw dai hpe mu nna hkrit gari nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mungkan ga ting a Madu Karai Kasang a man e, bum ni gaw gitbaw zawn byawng mat nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sumsing lamu ni gaw shi a ding man ai lam hpe htawn tsun nga nna; amyu baw ni yawng hte mung shi a hpung shingkang hpe mu nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hpara sumla hpe nawku ai wa kadai rai ti mung, kaya kahpa hkrum nga nna; karai ni yawng gaw Madu a man e, dingnyawm nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, nang tara jeyang ai a majaw, Ziun amyu masha ni kabu gara nga ma ai, Yuda mung na mare ni mung kabu jahtau nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyahtum Chyalai n-gun rawng ai Madu e, mungkan ga mahkra hpe up hkang ai wa nang rai nga ndai; nang gaw hpara ni mahkra hta grau nna kaba nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />N hkru ai ni hpe n ju n dawng nga ai ni hpe Madu tsaw ra nga ai; shi gaw shi a amyu masha ni a asak ni hpe makawp maga ya nna, tara n lang ai masha ni a n-gun atsam kaw nna mung, shanhte hpe mawai la nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ding hpring ai wa a ntsa e, nhtoi hpe jahtoi ya nna; mai kaja ai ni a ntsa e, kabu gara ai lam tawn da ya nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu galaw da ngut sai amu ni a majaw, ding hpring nga ai ni yawng hte e, kabu gara nga mu! Chyoi pra ai Karai Kasang galaw da nu ai amu ni hpe dum mu, shi hpe chyeju dum mu law.
  </para>
  <chapter number="98" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe mahkawn ga nnan hte mahkawn mu; shi gaw mauhpa magam amu ni hpe galaw da nu ai! Shi a daru magam n-gun hte chyoi pra ai n-gun a jaw e, shi gaw awng padang hpe hkam la nu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu gaw shi a awng padang hpe ndau shabra nna; shi a hkye hkrang la ai daru magam n-gun hpe amyu baw ni hpe, chye shangun nu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw Israela amyu masha ni hpe shanhte a matu, sadi dung ai hte dinggrin tsaw ra myit hte shi a ga sadi hpe shagrin da nu ai; shing rai, shara shagu hkan na amyu masha ni yawng hte gaw anhte a Karai Kasang a awng padang hpe mu lu nga masai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mungkan ga ting, dai Madu hpe kabu gara mahkawn nga mu; shi hpe mahkawn mangoi let kabu gara jahtau nga mu!
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu hpe mahkawn shakawn mu! Tingse ni hpe dum let, shi hpe mahkawn shakawn mu!
  </para>
  <para style="p">
    <verse number="6" style="v" />Pahke hte pahtau ni hpe gawut dum let, anhte a Hkawhkam rai nga ai dai Madu hpe kabu gara ai hte jahtau garu nga mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Panglai hte dai hta rawng ai hkrung mahkrung yawng hte e, marawn kashaw nga mu; mungkan ga hte dai hta shanu nga ai ni yawng hte e, shi hpe mahkawn mangoi nga mu!
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu gaw ginding aga hpe up hkang na matu, du sa ra ai majaw, hka nu ni e, shi a man hta lahpawk dum nga mu;
  </para>
  <para style="p">
    <verse number="9" style="v" />kawng ni e shi a man hta, kabu gara ai hte mahkawn jawm mahkawn shakawn nga mu. Shi gaw mungkan ga na amyu masha ni hpe teng man rap ra ai tara hte up hkang na ra ai.
  </para>
  <chapter number="99" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw Hkawhkam rai nga ai, amyu masha ni hkrit gari nga ma ai. Shi gaw singkaw tu ai hkrung kanu ni a ntsa na, shi a tingnyang ntsa e dung nga ai, ginding aga gaw ashun awam nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ziun e shanu nga ai dai Madu gaw n-gun chyalai rawng nga ai; amyu baw ni yawng hta grau htum ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masha shagu hte gaw shi a galu kaba nna, hpung shingkang arawng sadang hte hpring ai mying nsang hpe shakawn na mara ai; shi gaw Chyoi Pra Ai Wa rai nga ai!
  </para>
  <para style="p">
    <verse number="4" style="v" />Chyahtum Chyalai n-gun rawng ai Hkawhkam wa e, nang gaw teng man ai lam hpe tsaw ra nga ndai; Israela mungdan hta, teng man ai tara hpe nang tawn da ya nit dai, ding man ai lam hte rap ra ai tara ni hpe mung nang jashawn da ya nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu anhte a Karai Kasang hpe shakawn kungdawn mu; shi a tingnyang man e, nawku daw jau mu! Shi gaw Chyoi Pra Ai Wa rai nga ai!
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawshe hte Arun gaw shi a hkinjawng yan rai nga ma ai, Samuela mung Madu kaw akyu hpyi ai wa rai nga ai; shanhte gaw Madu hpe shaga nga ma ai hte, Madu mung shanhte hpe htan ya mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw shanhte hpe sumwi shadaw kaw nna ga tsun nu ai; dai Madu shanhte hpe jaw ya ai tara ni hte hkang da ai ga ni hpe shanhte madat mara hkan nang nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />O Madu anhte a Karai Kasang e, na a myu masha ni shaga ai nsen hpe nang htan ya nit dai; shanhte galaw shut kau sai yubak ni a majaw, nang shanhte hpe ari jaw ti mung, nang gaw yubak mara ni hpe raw dat kau ya ai Karai Kasang rai nga ndai hpe madun dan nga nit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu anhte a Karai Kasang hpe shakawn kungdawn mu; shi a chyoi pra ai bum hta nawku daw jau nga mu! Dai Madu anhte a Karai Kasang gaw chyoi pra nga ai.
  </para>
  <chapter number="100" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mungkan ga yawng hte e, dai Madu hpe mahkawn mangoi nga mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu hpe kabu gara ai hte nawku daw jau nga mu; shi a man de, kabu gara mahkawn let shang mu!
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Madu gaw Karai Kasang rai nga ai hpe yin la mu. Shi anhte hpe hpan da mi ai rai nna, anhte mung shi hte seng ai ni rai nga ga ai; anhte gaw shi a amyu masha ni rai nna, shi a sagu hpung ni rai nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nawku Htingnu chyinghka ni de, chyeju dum ai myit hte shang mu; dai Nawku Htingnu a wang kata de shakawn kungdawn let shang sa mu. Shi hpe chyeju dum mu, shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw mai kaja nga ai rai nna, shi a tsaw ra myit htani htana anga nga ai, shi a sadi sahka gaw prat mi hte prat mi agrin nga ai law.
  </para>
  <chapter number="101" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, nye a mahkawn ga gaw sadi dung ai hte teng man ai lam rai nga ai, dai hte, ngai nang hpe mahkawn mangoi nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a sat lawat ni mara n kap na ra ai. Nang ngai kaw galoi aten e, du sa wa na n ni? Ngai gaw nye a nta hta san seng ai asak hkrun lam hte shanu nga na nngai;
  </para>
  <para style="p">
    <verse number="3" style="v" />n hkru n hkra ai lam hpe ngai galoi mung, hkam sharang na nngai n rai. Karai Kasang a man kaw nna myi man kayin mat wa ai ni a shamu shamawt ai lam ni hpe ngai n dawng nga nngai; ngai gaw shanhte hte hpa seng na nngai n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw masu magaw ai masha tai na n rai, n hkru ai masha ni hte ngai hpa mung n galaw na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Langai ngai a n kaja ai lam ni hpe kahte tsun ai wa kadai hpe rai tim, ngai shaden kau na we ai. Gumrawng gumtawng ai hte myit tsaw myit dap rawng ai wa hpe ngai hkam sharang na nngai n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang hta sadi sahka nga ai ni hpe ngai ra sharawng nga na we ai; shanhte hpe nye a hkawhkam wang hta shanu nga shangun na nngai. Tsep kawp myit malang ai ni, ngai hpe daw jau na ahkang hkam la lu na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Masu magaw ai wa kadai mung, nye a hkawhkam wang hta shanu nga lu na n rai; sawt ai wa kadai mung nye a man e, grin nga lu na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anhte a lamu ga hta shanu nga nna, tara n lang ai ni hpe, lani hte lani ngai jahten sharun kau na we ai; n hkru ai masha ni yawng hpe mung, Madu a mare kaw nna gawt shapraw kau na we ai.
  </para>
  <chapter number="102" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, nye a akyu hpyi ga hpe madat ya e; karum la na matu, nye a hpyi jahtau ai nsen hpe na ya e!
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai nni nkri hkrum nga ai shaloi ngai kaw nna hkum kayin mat wa et! Ngai shaga ai shaloi, nye a ga hpe madat ya nna, tin tin htan ya e!
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a asak gaw wan hkut zawn hkoi mat wa nna; nye a hkum hkrang mung wan zawn hkru nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw tsingdu jahkraw zawn kabye dip da ai hkrum nna; lusha sha mayu ai myit pyi n rawng mat nga li ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai ja ja madai sharung nga nngai, hpyi hte nrut nra ni hta jan nna ngai hpa mung n rai nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw nam mali e nga ai zai ai u ni hte kabai kau da sai dum nta hkan nga ai u hku ni zawn rai nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai n lu yup nga nngai majaw nta numgaw e dung nga ai u shingtai zawn, ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a gumlau hpyen ni ngai hpe shani tup asawng nga ma ai; ngai hpe asawng asang re ai ni nye a mying hpe gang nna dagam dala ga tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a pawt sindawng ai hte masin kahtet ai a majaw, wan dap ni gaw nye a malu masha rai nga ai; nye a luhpa ni mung nye a myi prwi ni hte kayau nga li ai. Nang ngai hpe magra sharawt la nna, tsan tsan de kabai kau nga nit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a asak gaw jan shang wa yang na shingnip zawn rai nga nna; hkraw ai tsingdu hte bung nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai ti mung, Madu e, nang gaw htani htana agrin nga ai hkawhkam wa rai nga ndai; ban prat masha ni mahkra nang hpe adum nga na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang rawt wa nna, Ziun mare hpe matsan dum na rin dai; dai mare hpe matsan dum na aten du wa nga sai, dai aten gaw ya e nan rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ziun mare gaw jahten sharun kau hkrum nga tim pyi, na a shangun ma ni shi hpe tsaw ra nga ma ai; dai mare hten byak mat ti pyi, shanhte dai hpe matsan dum ai myit nga nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amyu baw ni Madu hpe hkrit hkungga wa na mara ai, mungkan ga na hkawhkam ni yawng hte gaw shi a daru magam n-gun hpe hkrit kamyin wa na mara ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu gaw Ziun mare hpe bai gaw gap da ai shaloi, shi a galu kaba ai lam hpe madun dan na ra ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw kabai kau da hkrum ai shi a amyu masha ni a nsen ni hpe na wa na ra ai; shanhte a akyu hpyi ga ni hpe madat ya na ra ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpang ban prat na masha ni a matu, Madu galaw da sai amu ni hpe ka matsing da nga mu; shing rai, ya garai n shangai pra sa wa na ni mung, shi hpe shakawn kungdawn wa na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai Madu gaw shi a chyoi pra ai hte tsaw htum ai shara kaw nna gum yu nga ai; shi gaw sumsing lamu kaw nna ga de gum yu nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi gaw bawng dung ai ni a madai ai nsen hpe na ya nna; si na matu, daw dan hkrum nga ai ni hpe shalawt dat nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai majaw, masha amyu baw ni hte mungdan ni rau sa hkrum zup nna, Madu hpe nawku daw jau ai shaloi, shi a amying nsang hpe Ziun Bum hta htawn tsun dan na mara ai; amyu masha ni mung, Yerusalem mare hta shi hpe shakawn kungdawn na mara ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ngai naw kaji nga ai aten kaw nna Madu ngai hpe n-gun shayawm kau ya ni ai; shi gaw nye a asak hpe kadun kau ya ni ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />O Karai Kasang e, ngai garai n dingla yang, nye a asak hpe hkum dawm kau ya e. Madu e, nang gaw htani htana anga nga ndai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang gaw, moi moi e, ginding aga hpe hpan da nit dai, na a lata ni hte sumsing lamu ni hpe nang nan galaw da nga nit dai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai ni hten run mat wa tim, nang agrin nga na ndai; dai ni yawng gaw hpun nba ni zawn, dingsa mat wa na ra ai, hpun palawng ni zawn nang dai ni hpe galai kau ai hte dai ni mung wai mat na mara ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Rai ti mung, nang chyawm gaw dinggrin anga nga ndai, na a asak gaw galoi mung htum mat chye ai n rai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anhte a kashu kasha ni shim lum ai hte shanu nga lu na mara ai; shanhte a aru arat ni gaw na a makawp maga ai npu hta shim nga lu na mara ai.
  </para>
  <chapter number="103" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a wenyi e, dai Madu hpe shakawn u! Nye a hkum hkrang, myit masin mahkra hte e, shi a chyoi pra ai mying nsang hpe shakawn nga u!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a wenyi e, Madu hpe shakawn u! Shi a chyeju yawng hte hpe hkum malap kau nga et!
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw nye a yubak yawng hte hpe raw dat kau ya nga ai; nye a ana ahkya yawng hte hpe mung, shi shamai shatsai ya nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi ngai hpe nsung hku hta na hkye hkrang la nga ai shi a tsaw ra matsan dum ai myit hte shaman ya nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw nye a prat hpe mai kaja ai hte shakat ya ai majaw, ngai gaw galang zawn ram prat bai pra nna n-gun ja nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Madu gaw dip gamyet sha hkrum nga ai ni hpang maga de, tara dara ya nga nna; shanhte lu la ang ai ahkaw ahkang ni hpe jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw Mawshe hpe shi a yaw shada ai lam madun dan nu ai, shi a mauhpa magam amu ni hpe Israela amyu masha ni hpe mu la shangun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw matsan dum ai, tsaw ra ai, myit galu kaba ai hte dinggrin tsaw ra myit hpring nga ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi tut nawng e, daru nga ai n rai, shi htani htana apawt nga ai wa n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anhte hkam la ging ai mara hte maren, shi anhte hpe ari jaw mi ai n rai; anhte a yubak ni hte shut hpyit ai mara ni hte maren, shi bai tai mi ai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lamu gaw ginding aga hta tsaw nga ai hte maren, shi hpe hkrit hkungga nga ai ni a ntsa e shi a tsaw ra myit mung, dai hte maren galu kaba nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sinpraw gaw Sinna hte tsan gang nga ai zawn, shi anhte a yubak ni hpe anhte kaw nna shatsan kau ya mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kawa gaw kasha ni hpe matsan dum lama ai zawn, Dai Madu gaw shi hpe shagrau sha-a ai ni hpe matsan dum nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anhte hpe hpa hte galaw da nga ai hpe shi chye nga ai; anhte ga nhpu ni rai nga ga ai hpe shi dum nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anhte a asak prat chyawm gaw tsingdu zawn rai nga ai; nam na nampan zawn, anhte tu kaba wa nna pu lagra nga ga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hpang, de a ntsa e, nbung bung ahpawt wa nna, dai gaw mat mat nga ai; dai hpe kadai mung bai mu lu nga ai n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai ti mung, Madu hpe shagrau sha-a nga ai ni a ntsa e, shi a tsaw ra myit htani htana agrin nga ai,
  </para>
  <para style="p">
    <verse number="18" style="v" />shi a ga shaka hpe hkan nang nga ai ni hte shi a hkang da ai ga ni hpe kangka ai hte madat mara hkan sa nga ai ni a ntsa e, shi a mai kaja ai gaw hpang ban ni yawng a matu anga nga na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai Madu gaw shi a tingnyang hpe sumsing lamu ntsa e, shadun da nna; shi gaw yawng mayawng a ntsa na hkawhkam wa rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chyahtum Chyalai n-gun hte hpring nga nna Madu a hkang da ai ga ni hpe madat mara hkan sa let, shi tsun ai ga ni hpe madat mara nga ai lamu kasa ni e, shi hpe shakawn kungdawn nga mu.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi ra sharawng ai hku amu galaw nga ai shi a shangun ma ni rai nga ai sumsing lamu na daru magam n-gun hte hpring nga ai ni e, Madu hpe shakawn kungdawn nga mu!
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi up hkang nga ai shara shagu hkan na, hpan hpajang da mada yawng hte e, Madu hpe shakawn kungdawn nga mu! Nye a wenyi e, Madu hpe shakawn u!
  </para>
  <chapter number="104" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Wenyi e Madu hpe shakawn u! O Madu nye a Karai Kasang e, nang gaw kade wa galu kaba nga n hka! Nang gaw daru magam, hpung shingkang hte bu hpun da nna;
  </para>
  <para style="p">
    <verse number="2" style="v" />na a hkum hpe nhtoi hte hpun lawai da nga ndai. Nang gaw sumsing lamu ni hpe sum zawn kahpyan da nna;
  </para>
  <para style="p">
    <verse number="3" style="v" />lamu madin hta nga ai hka ni a ntsa e, na a nta hpe gap da nga ndai. Nang gaw sumwi ni hpe na a gumra leng zawn, nang akyu jashawn nna; nbung a singkaw ntsa e, nang jawn nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang gaw nbung ni hpe na a kasa ni shatai nna, myi hprap wan gala ai hpe na a shangun ma ni zawn, nang akyu jashawn nga ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw ginding aga hpe de a npawt hta ngang ngang gaw da nna; dai gaw galoi mung shamu shamawt kau hkrum na n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai ginding aga ntsa e, nammukdara hpe nba zawn, nang magap da nna; hka mung bum ni hpe ka-up da nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw hka ni hpe daru kau dat ai shaloi, dai ni tse rai yawng mat wa nna; nang jahtau tsun ai mungga hpe dai ni na ai shaloi, lawan wan lwi agre mat wa nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hka ni gaw bum ni a ntsa kaw nna, kadit hkam wam de, dai ni a matu nang san da ya sai shara ni de, lwi mat wa nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu gaw mungkan ga hpe sha-u kalang mi bai n ka-up kau u ga; hka ni n lu lai di na ga jarit hpe masat da nu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw hkaraw ni hkan e, hka hpawk ni hpe jahpaw dat ya nna, bum ni a lapran hku hka nu ni hpe lwi shangun nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai ni gaw nam na ashu ashan ni a matu hka jaw ya nna, dai shara ni hkan lawze shazai ni shanhte a hpang gara ai hpe shamai la lu nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ntsa malen u ni mung dai ni a makau mayang hkan tu nga ai hpun ni hta; atsip tsip let, mahkawn gashai nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sumsing lamu kaw nna bum ni a ntsa e, nang marang jahtu dat ndai majaw, lamu ga ni na a chyeju ni hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yam nga ni a matu tsingdu hpe nang shatut ya ndai hte, shinggyim masha ni lang na matu, hkai nmai ni hpe mung shatut ya nga ndai. Shing rai, shi gaw shi a nsi naisi ni hpe tu kaba shangun lu nga ai hte,
  </para>
  <para style="p">
    <verse number="15" style="v" />shi hkum nan myit ngwi myit pyaw na matu sabyi ntsin hpe mung; kabu sumsai lu na matu, tsanlun sau hpe mung, n-gun hpring wa na matu, shadung muk hpe mung, shi galaw shapraw nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu hkai da ai shi a hpun ni ngu ai Lebanon a arit hpun ni mung: lamu marang hpe law hkra hkam la lu nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shara hta e, ntsa malen u ni shanhte a atsip tsip nna, u kawp ni mung marau hpun ntsa hkan e, atsip galaw da nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ya ni gaw tsaw ai bum ntsa hkan e, nga nga ma ai; du dumsi dusat ni nlung bum n-gam hkan e, makoi rawng nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang gaw hti hkum shata ladaw da na matu, shata hpe hpan da nna; jan mung, shi a shang na aten hpe chye nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shana hpe nang hpan da nna nsin e, nam na matse labye ni yawng pru hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hkanghkyi hkalung ni shan hpe gyam ai shaloi, shabam nga ma ai; shanhte gaw Karai Kasang jaw ya ai lusha ni hpe hkan tam nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jan pru wa yang, shanhte a lungpu kata de nhtang shang mat wa nna, hpum nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai shaloi, shinggyim masha ni shanhte a magam amu galaw na matu, pru sa wa nna, shana de du hkra, amu galaw nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Madu e, nang gaw amyu baw sumhpa hpe galaw da nit dai! Nang gaw yawng mayawng hte hpe hpaji rawng ai hku galaw da ni hka! Mungkan ga gaw nang hpan da ai hkrung mahkrung ni hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />N dang hti hkra law la ai hkrung mahkrung kaji kaba ni shanu nga ai, Nammukdara gaw dam lada nna kaba nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai nammukdara hka ntsa hta e, sanghpaw li ni hkawm nga ma ai; dai shara ni hta nang hpan da ai baren numraw Lewihtan mung pyau chyai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai ni yawng gaw ra ai aten hta lusha shahpa jaw ya na matu; nang Madu hpe shamyet shanat nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nang dai ni hpe lusha jaw nna, shanhte dai hpe sha ma ai; nang lusha shahpa jaw nna shanhte myit dik nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang myi man kayin mat wa ai shaloi, dai ni hkrit nga ma ai; dai ni a nsoi nsa ni hpe, nang dawm la kau ya ai shaloi, shanhte si wa nna, shanhte pru wa ai ga nhpu kaw nna dai ga nhpu de bai nhtang mat wa ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rai ti mung, nang shanhte hpe nsoi nsa gawut bang dat ai hte shanhte hpe hpan da nga ndai; shing rai, nang gaw mungkan ga hpe asak ningnan jaw ya nga ndai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Madu a hpung shingkang htani htana agrin nga u ga! Madu gaw shi galaw da sai magam bungli ni hta kabu gara nga u ga!
  </para>
  <para style="p">
    <verse number="32" style="v" />Lamu ga hpe shi mada yu ai hte dai ni gari wa nga ai; bum ni hpe shi ahtawk dat wu ai shaloi, dai kaw na wan hkut ni pru wa nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ngai hkrung nga ai hte yang, Madu hpe ngai mahkawn mangoi nga na nngai; ngai ahkrung nga dingsa, nye a Karai Kasang hpe ngai mahkawn shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nye a kabu gara ai lam gaw shi kaw na rai nga ai majaw, nye a mahkawn shakawn ai ga hpe Madu ra sharawng nga u ga law.
  </para>
  <para style="p">
    <verse number="35" style="v" />Yubak kap ai ni dinghta ga kaw nna shamyit kau ai hkrum nga mu ga; tara n lang ai ni hkoi mat mu ga. Nye a wenyi e, dai Madu hpe shakawn u! Dai Madu hpe shakawn nga u law!
  </para>
  <chapter number="105" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu a chyeju hpe shakawn nga mu, shi a galu kaba ai lam hpe htawn tsun nga mu; shi galaw dan sai magam bungli ni, amyu baw ni hpe tsun dan mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu hpe mahkawn shakawn nga mu; shi galaw dan sai mauhpa amu nlang hte hpe tsun hkai dan mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte hpe shi madu da nga ai majaw kabu gara nga mu; shi hpe nawku daw jau ai ni myit dik myit pyaw lu mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karum hpyi na matu, dai Madu hpang de sit shang wa mu, shi hpe n sim n sa nawku daw jau nga mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi a shangun ma Abraham a aru arat ni hte shi lata la sai Yaku a aru arat ni e, Karai Kasang galaw dan sai lamik kumla ni hte shi jaw da sai tara dara lam ni hpe adum nga mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu gaw anhte a Karai Kasang rai nga ai, shi a hkang da ai tara ni mungkan ting a matu rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw shi a ga shaka hpe htani htana shagrin da na ra ai; shi a ga sadi ni prat ban hkying mi a matu rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw Abraham hte tawn da sai myit hkrum ga shaka hte, Isak hpe jaw da sai shi a ga sadi hpe shagrin da na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Ngai nang hpe Hkanan mung jaw na nngai, dai hpe nang madu lu na ra ai,” nga nna Madu gaw Yaku hte ga shaka tawn da nu ai hte maren,
  </para>
  <para style="p">
    <verse number="11" style="v" />dai gaw prat dingsa htani htana agrin nga na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang a amyu masha ni gaw hti hkum hku nna n law nga ma ai; shanhte gaw Hkanan mungdan hta masha tsasam ni rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte gaw mungdan langai mi kaw nna langai mi de; hkawhkam mungdan mi kaw nna mungdan mi de, kayin hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai ti mung, Karai Kasang gaw shanhte hpe dip gamyet sha lu na ahkang, kadai hpe mung n jaw ya nga ai; shanhte hpe makawp maga la na matu,
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu gaw, “Ngai lata san da sai shangun ma ni hpe hkum machyi shangun myit, nye a myihtoi ni hpe hkum hkra ya mi,” nga nna hkawhkam ni hpe sadi jaw nu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu gaw shanhte a mungdan e hku wa dat dat ya nna, shanhte a lusha mahkra hpe dawm la kau ya nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai ti mung, shi gaw shanhte a shawng e mayam hku nna, dut kau hkrum ai Yosep ngu ai masha langai mi shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi tsun ai myihtoi ga dik wa ai aten du hkra, shi a lagaw gyit hkang da ai hkrum nna; shi a du hpe mung, hpri sumri hte gyit da ya nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai Madu a mungga gaw shi a teng man ai lam hpe sakse madun dan nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai shaloi, Egutu hkawhkam wa shi hpe raw dat nna, amyu baw ni a du wa gaw shi hpe shalawt dat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hkawhkam wa gaw shi a mung up magam bungli hta woi awn na matu, shi hpe san da mu ai hte, mungdan ting a ntsa e up hkang na du, shi hpe shatai nu ai rai nna,
  </para>
  <para style="p">
    <verse number="22" style="v" />shi gaw hkawhkam wa a up hkang du ni a ntsa e mung, hkaw kata na hpaji jaw du, salang ni hpe sharin matsun na ahkang mung shi hkam la nu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hpang Yaku gaw Egutu mung de yu wa nna, dai mungdan hta sa shanu nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai Madu gaw shi a amyu masha ni hpe kashu kasha law law mayat maya shangun nna; shanhte a gumlau hpyen ni hta grau nna, n-gun ja wa shangun nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi gaw Egutu masha amyu ni hpe shi a amyu masha ni hte n ju n dawng shangun nna; shi a shangun ma ni hte hkalem hkalau amu shabyin dat wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hpang, shi lata san da sai shi a shangun ma Mawshe hte Arun yan hpe shi shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte gaw, Karai Kasang a mauhpa magam amu ni hte lamik kumla amyu myu ni hpe Egutu mung hta e, madun dan manu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Karai Kasang gaw dai mungdan a ntsa e, nsin jasin dat nu ai; rai ti mung, Egutu amyu masha ni shi a hkang da ai ga hpe n madat ya mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shi shanhte a hka nu ni hpe sai shatai kau ya nna, dai hta rawng ai nga ni yawng hpe sat kau ya wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte a mungdan hta shu ni hte hpring nga nna; hkawhkam wa a gawk de du hkra, shu ni hte hpring kaput nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Karai Kasang hkang dat ai hte maren, jinghkam hte ji nu ni, mungdan ting hta prang hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shi gaw shanhte a mungdan hta marang a malai sin hte myi hprap wan dat dat wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shi gaw sabyi ru ni hte maihpang hpun ni hpe jahten kau nna; mungdan ting na hpun ni yawng hpe agrawp shadaw kau nu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi hkang dat ai hte, sen sen wan wan n dang hti hkra law ai dinggam-yaw ni du sa wa nga ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai ni gaw mungdan na hpun lawn kasha ni yawng hpe sha kau nga ma ai; nsi naisi yawng hpe mung mayu kau ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Egutu mungdan na dinghku yawng a shadang sha alat ni hpe shi sat kau ya mu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai hpang shi gaw Israela amyu masha ni hpe woi shapraw mat wa nna, shanhte gaw gumhpraw hte aja ni hpe mung, htaw mat wa ya nga ma ai; shanhte yawng hte mung hkam kaja ai hte n-gun hpring shajang nga ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Egutu amyu masha ni mung shanhte hpe hkrit nga ma ai; shanhte pru mat wa ai shaloi, kabu gara nga ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Karai Kasang gaw shi a amyu masha ni a ntsa e, sumwi ka-up da ya nna; shana e, shanhte hpe wan jahtoi ya nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shanhte hpyi mu ai hte maren, u preng ni hpe dat dat ya nna; shanhte myit dik hkra sha lu na matu, lamu na lusha shanhte hpe jahkrat jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shi gaw lunghkrung hpe hpaw dat nna hka ni kapaw pru wa nhtawm; hkun hkraw ai shara hkan, hka nu langai mi zawn lwi nga ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shi a shangun ma kaja Abraham hte tawn da ai chyoi pra ai ga sadi ndat ga ni hpe shi dum nga wu ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Dai majaw shi lata la hkrum ai shi a amyu masha ni hpe woi shapraw mat wa ai; shanhte kabu gara jahtau garu ai hte mahkawn shakawn ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shi shanhte hpe kaga amyu masha ni a lamu ga ni hpe jaw ya nna; shanhte mung kaga masha ni a sun, hkauna ni hpe madu la nga ma ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shing rai, shi a amyu masha ni shi a tara ni hpe madat nna; shi a hkang da ai ga ni yawng hpe hkan shatup na mu ai. Dai Madu hpe shakawn nga mu law!
  </para>
  <chapter number="106" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn nga mu! Shi mai kaja nga ai majaw, dai Madu hpe chyeju dum mu; shi a tsaw ra myit mung htani htana prat ting agrin nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi galaw dan sai mauhpa magam amu ni yawng hpe kadai wa tsun hkai dan lu nga a ta? Shi a hpung shingkang arawng sadang nga manga hte hpe kadai wa shakawn lu nga a ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a hkang da ai ga ni hpe madat mara hkan nang nga nna, ding man ai amu hpe tut nawng e, galaw nga ai ni gaw a nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, na a amyu masha ni hpe nang karum ndai shaloi, ngai hpe mung dum nga et; shanhte hpe nang hkye hkrang la ai shaloi, ngai hpe mung shalawm la et.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a amyu masha ni a ngamu ngamai ai lam hpe mung, na a amyu baw a kabu gara ai lam hpe mung, nang madu da ai amyu masha ni a kabu gumrawng ai lam hpe mung ngai hpe mu mada shangun e law.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte gaw anhte a kaji kawa ni galaw lai wa sai zawn yubak galaw kau saga ai; shing rai, anhte gaw tara n lang ai ni hte n hkru n shawp ai ni tai mat nga saga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Egutu mung hta shanu nga ai anhte a kaji kawa ni gaw Karai Kasang a mauhpa magam amu ni hpe n chye na kau mu ai; shanhte hpe law law lang shi madun dan sai shi a tsaw ra myit hpe shanhte malap kau nna, shanhte gaw, dai Chyahtum Chyalai n-gun rawng ai Madu hpe pyi, dai Nawng Hkyen e gumlau ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung, shi gaw shi a galu kaba ai daru magam n-gun hpe madun dan na matu, ga sadi tawn da sai hte maren, shanhte hpe hkye hkrang la nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi Nawng Hkyeng hpe hkang dat ai hte dai gaw hkyet mat nga ai; shing rai, shi a amyu masha ni hpe hkun hkraw nga ai ga ntsa hku woi rap mat wa nu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw n ju n dawng ai ni a lata na shanhte hpe mawai la nu ai, shanhte a hpyen ni kaw na shi shanhte hpe hkye la nu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, shanhte a gumlau hpyen ni mung hka hta lup si mat nna; langai mi mung n lawt lu nga masai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hpang, shi a amyu masha ni shi tawn da sai ga sadi ni hpe kam sham wa nna; Madu hpe mahkawn shakawn nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai ti mung, shanhte gaw shi galaw dan sai amu ni hpe alawan malap kau ya mu ai hte; shi a hpaji jaw ai lam ni hpe n la nga ai sha, galaw kau manu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nam mali kata e, shanhte ra marit nga ai lam hpring nga sai hte; Karai Kasang hpe chyam yu mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai majaw shanhte hpyi ai lam, shanhte hpe shi jahkrat ya ti mung, shanhte hpe hkrithpa ana ahkya mung, jahkrat ya nu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte gaw dai nam mali kata hkan e, Mawshe hte Madu a chyoi pra ai shangun ma kaja Arun yan hpe yu manawn nga masai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shaloi, lamu ga gaw ga mahka wa nna, Dahtan hpe mayu kau wu ai; Abiram hte shi a dinghku masha ni hpe mung kaput kau wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte a hpang hkan nang ai ni a ntsa e, wan nan hkrat wa nna; tara n lang ai masha ni hpe hkru jahkat kau mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte gaw Sina e, ja dumsu kasha sumla galaw nna dai hpe nawku nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shanhte gaw Karai Kasang a hpung shingkang hpe tsingdu sha ai dusat a sumla hte galai kau mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Egutu mung hta shi a mauhpa magam amu ni hte shanhte hpe hkye hkrang da ai Karai Kasang hpe shanhte malap kau mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai mung hta shi galaw dan sai amu ni gaw kaning re ai mauhpa wa rai nga a hka! Nawng hkyeng hta shi galaw dan sai magam amu ni gaw kaning re ai mauhpa wa rai nga a hka!
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw shi a amyu masha ni hpe jahten kau na nga, Karai Kasang tsun wu ai shaloi, shi lata la ai shangun ma kaja Mawshe gaw shi a man e, rawt tsap nna, shanhte hpe n shamyit kau u ga, shi a masin kahtet ai hpe shakawp ya wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi, shanhte Karai Kasang a ga sadi hpe n kam mat ma ai majaw, pyaw ai mungdan de shang sha na, shanhte ningdang kau mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte gaw shanhte a sum ni hta nga nga nna aput angun nga ma ai; Madu a hkang da ai ga ni hpe mung n kam madat nga masai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai re ai majaw, Madu shanhte hpe nam mali kata e, si jahtum kau shangun na wu ai majaw mung,
  </para>
  <para style="p">
    <verse number="27" style="v" />shanhte a aru arat ni hpe n kam n sham ai ni a mungdan hkan e, shabra kau na wu ai majaw mung, maigan mungdan hkan e, si mat shangun na lam ni a majaw mung, dagam dala ga hte shanhte hpe sadi jaw wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai hpang, Karai Kasang a masha ni Bala hpara hpe Peura shara hta nawku daw jau nga ma ai; hpara chyasi ni hpe nawng jau ai hkungga shan ni hpe mung sha nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shanhte gaw shanhte galaw ai amu ni hte Madu a sindawng kahtet ai hpe jasu shalut ya nga ma ai majaw, hkrithpa ana zinli mung, shanhte hta byin pru wa nga masai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rai ti mung, Hpineha rawt tsap ai hte mara kap ai ni hpe ari jaw kau wu ai majaw, ana zinli hkoi mat wa nga sai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai Hpineha galaw ai akyu hpe dai ni du hkra tut nawng e, myit adum nga ma ai; dai hpe prat mi hte prat mi adum nga na mara ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amyu masha ni gaw Meriba hka hpawk hta e, dai Madu hpe pawt sindawng shangun mu ai; shanhte galaw shapraw ai arawn alai a majaw, Mawshe mung ru yak tsin-yam hkrum nu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shanhte gaw Mawshe hpe ahkup ahka nga hkra, myit machyi shangun mu ai majaw, shi n myit yu ai sha, ga shaga kau nu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shanhte gaw maigan amyu masha ni hpe sat shamyit kau na matu, Madu shanhte hpe hkang da sai ga hpe n hkan shatup ai sha n ga,
  </para>
  <para style="p">
    <verse number="35" style="v" />maigan amyu masha ni hte shanhte dinghku de ma ai hte maigan htung tara ni hpe shanhte hkap la nga mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Karai Kasang a amyu masha ni gaw hpara sumla ni hpe nawku daw jau mu ai, dai gaw shanhte byak ai lam hpe shabyin ya nga sai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte gaw shanhte a shayi shadang sha ni hpe shagu hkungga hku nna; Hkanan hpara sumla ni hpe nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shanhte gaw mara n kap ai kashu kasha ni hpe sat nawng ma ai; mungdan gaw masha sat amu galaw ai ni a majaw awu asin rai mat sai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shanhte galaw ai amu ni hte shanhte hkum hpe awu asin di kau nna; Karai Kasang hta sadi sahka myit n dung mat nga masai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shing rai, Madu gaw shi a amyu masha ni hpe pawt sindawng nga nna; shanhte hpe shi matsat kau wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shi shanhte hpe masha amyu baw ni a n-gun atsam de ap kau nna; shanhte a gumlau hpyen ni shanhte hpe up hkang nga ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shanhte gaw shanhte a gumlau hpyen ni a dip gamyet zingri ai hpe hkrum sha nga ma ai; gumlau hpyen ni a npu hta tsep kawp shanhte taw nga ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Madu gaw law law lang, shi a amyu masha ni hpe mawai la nga ai; shanhte shi hpe gumlau na lam, lata la nga ma ai majaw, yubak nawng de grau nna lup shang mat wa masai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ti mung, shanhte hpyi jahtau ai shaloi, Madu na ya wu ai; shanhte a myit ru myit tsang ai lam hpe shi dum ya mu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shi gaw shanhte a akyu a matu, shi a ga shaka hpe dum ya wu ai; shi a kaba la ai tsaw ra myit a jaw e, shi a pawt sindawng ai myit hpe shakawp kau wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shanhte hpe zingri zingrat nga ai ni yawng a myit masin kraw lawang kata hta; shanhte hpe yu matsan dum la shangun mu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Anhte a Madu , Karai Kasang e, anhte hpe hkye hkrang la mi; Masha amyu ni a kata kaw nna anhte hpe woi nhtang wa mi. Shing rai, na a chyoi pra ai mying nsang hpe shakawn nna, anhte nang hpe chyeju dum shakawn nga na ga ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Dai Madu Israela a Karai Kasang, hpe shakawn nga mu! Shi hpe ya kaw nna, htani htana shakawn kungdawn nga mu! Masha hkum shagu, “Amen” ngu nna tsun nga mu ga law! Dai Madu hpe shakawn mu!
  </para>
  <chapter number="107" style="c" />
  <para style="p">
    <verse number="1" style="v" />“ Madu gaw mai kaja nga nna, shi a tsaw ra myit htani htana agrin nga ai majaw, shi hpe chyeju shakawn mu!”
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a jaw e hkye hkrang la hkrum sai ni yawng hte gaw dai Madu hpe chyeju shakawn ai hta, dai ga ni hpe atsun nga mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw nanhte a gumlau hpyen ni a lata kaw nna mawai la nu ai; sinpraw sinna, dingdung dingda mungdan shagu de nga hkawm nga ai nanhte hpe bai woi wa manit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masha nkau mi gaw, lam n nga ai nam mali hkan e, brak hkawm nga ma ai; shanhte shanu nga na mare de hkrang ai lam hpe mung n mu tam lu nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw kawsi hpang gara ai hkrum nga ma ai; myit mada ai lam mahkra hpe shayaw kau mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi, shanhte ru tsang hkrum ai aten hta Madu hpe hpyi jahtau mu ai; shi shanhte a nni nkri kaw nna shanhte hpe hkye hkrang la nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw shanhte hpe shanu nga lu na shara de, malang ai lam hku nna woi wa mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte a matu, shi galaw dan nu ai mauhpa magam bungli ni hte; shi a dinggrin tsaw ra myit a majaw shanhte dai Madu hpe chyeju shakawn lu na rai mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw hpang gara hkrum ai ni hpe jahkru ya nna, kawsi hkrum ai ni hpe kaja ai lusha hte shakat ya nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Masha nkau mi gaw nsin kata hta myit nchyi nmu hte sharen da ai hkrum nga nna; bawng dung ai masha ni mung hpri sumri hte gyit da ai nni nkri hpe hkrum sha nga mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hpa majaw nga yang, shanhte gaw Chyahtum Chyalai n-gun rawng ai Karai Kasang a hkang da ai ga ni hpe gumlau kau nna; shi a sharin shaga ai ga matsun ni hpe mung n hkap la kau ai majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte gaw bungli ja ja galaw nga ma ai majaw hki ba nga ma ai shanhte kataw yang, kadai mung karum la na mu ai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi shanhte gaw ru tsang hkrum ai aten hta, dai Madu hpe hpyi jahtau mu ai rai nna; shi gaw shanhte a shoichyum shoirang kata kaw nna shanhte hpe hkrang shaw la nu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw shanhte hpe nsin tawng hte sin htat ai shingnip kata kaw nna woi shapraw la ai hte; shanhte hpe gyit hkang da ai hpri sumri ni hpe mung, gang di kau ya nu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte a matu, shi galaw dan nu ai mauhpa magam bungli ni hte; shi a dinggrin tsaw ra myit a majaw, dai Madu hpe chyeju shakawn nga ra ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw mare chyinghka ni hpe agrawp kau nna, hpri htinggrang ni hpe kahtum kadaw di kau nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte galaw ai yubak ni a majaw masha nkau mi angawk nga ma ai; shanhte galaw ai n hkru n hkra lam ni a majaw, nkau mi nchyi nmu hkrum sha nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte gaw lusha shahpa hpe pyi n kam yu mat mu ai hte, si hkrung si htan a chyinghka de ni wa nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi, shanhte ru tsang hkrum ai aten hta Madu hpe hpyi jahtau mu ai; shi shanhte a shoichyum shoirang kata kaw nna shanhte hpe hkrang shaw la mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi gaw shi a mungga hte shanhte hpe shamai shatsai ya ai hte, lup sung hku kata na, shanhte hpe hkye hkrang la wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte a matu, shi galaw dan sai mauhpa magam bungli ni hte; shi a dinggrin tsaw ra myit a majaw, dai Madu hpe chyeju shakawn lu na rai mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte gaw shagu hkungga ni hte shi hpe chyeju shakawn lu na rai mu ai; kabu gara ai mahkawn mangoi ga hte shi galaw dan sai ni yawng hpe tsun hkai dan lu na rai mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Masha nkau mi gaw nammukdara hka a ntsa e, sanghpaw li ni hte hkawm sa nna; panglai hka ni a ntsa e, shanhte a kan bau magam amu hpe galaw shachyen nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shanhte gaw dai Madu hpa galaw lu ai amu hte, panglai ntsa e, shi madun dan ai mauhpa magam amu ni hpe mu mada nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi hkang dat ai shaloi, nbung laru ru wa nna; hka leng ni rawt kabrawng wa nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sanghpaw li ni mung nbung ntsa de rawt lung wa nna; sung ai hka de, lup shang mat wa nga ai. Ndai zawn re ai hkrithpa lam a majaw, masha ni gaw shanhte a nden mat mat mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte gaw chyaru nang ai ni zawn ndi nda rai hkawm nna; shanhte a kung kyang ai hpaji nlang mung kaman lila rai mat manu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi, shanhte ru tsang hkrum ai aten hta, dai Madu hpe hpyi jahtau mu ai rai nna; shi shanhte a shoichyum shoirang kata kaw na hkrang shaw la nu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nbung laru hpe shi shazim kau ai hte, hka leng ni mung sim mat ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nbung laru sim mat ai majaw, shanhte kabu gara nga ma ai; shanhte sa mayu ai daru de, shim ai hku, shanhte hpe shi woi wa nu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shanhte a matu, shi galaw dan sai mauhpa magam bungli ni hte shi a dinggrin tsaw ra myit a majaw, dai Madu hpe chyeju shakawn lu na rai mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shanhte shi a galu kaba galu kaba ai lam hpe amyu masha ni a hpawng hta htawn tsun dan lu na rai mu ai hte; ningbaw ningla ni a zup hpawng hta shi hpe shakawn lu na rai mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai Madu gaw hka nu ni hpe atsai awai jahkraw kau nna, hka hpawk ni hpe pat kau ya nu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai mungdan hta shanu nga ai ni a tara n lang ai lam a majaw, shi gaw ga sau hpring ai shara ni hpe jum ga shatai kau ya nu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zaibru jang ni hpe hka nawng, hkun hkraw ai lamu ga hpe hka hpawk lwi ai shara shatai kau nu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shi gaw kawsi hkrum ai amyu masha ni hpe dai shara hta nga shangun nna; shanhte shanu nga na matu mare hpe de da nga ma ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte gaw sun galaw nna, sabyi hpun ni hpe hkai nhtawm nsi naisi hpe ntaw ntsang shu la mu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shi a amyu masha ni hpe shi shaman ya nna, shanhte hta kashu kasha law law mayat maya nga ma ai; shanhte a yam nga ni n yawm mat u ga, shi bau sin ya nga ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Karai Kasang a amyu masha ni gaw gumshem dip gamyet sha hkrum ai hte nni nkri hkam sha nga ma ai; sum mat ai hte kaya kahpa hkrum sha nga ma ai shaloi,
  </para>
  <para style="p">
    <verse number="40" style="v" />shanhte a ntsa e, dip gamyet sha nga ai ni hpe shi matsat kau nga ai lam hpe madun dan nna; shanhte hpe lam n hku ai katsi katsang re ai nam mali de brak hkawm shangun mu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Rai ti mung, shi gaw ra kadawn nga ai ni hte, shanhte a nni nkri kata kaw na mawai la ai hte; shanhte a dinghku masha ni hpe sagu hpung ni hpe zawn shalaw jahtam ya mu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ding hpring ai masha ni dai lam hpe mu nna kabu gara nga ma ti mung; tara n lang ai ni yawng hte hpe chyawm gaw shazim kau ya wu ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hpaji rawng ai ni ndai amu ni a lam hpe myit sawn yu nga mu ga; shanhte gaw dai Madu a dinggrin tsaw ra myit hpe myit yu nga mu ga law.
  </para>
  <chapter number="108" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Karai Kasang e, ngai nang hpe tsep kawp kam hpa nga nngai; ngai nang hpe mahkawn mangoi ai hte nang hpe shakawn na nngai! Nye a wenyi e, dum hprang u!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a tingse hte sumpyi e, dum hprang u! Jan hpe mung ngai jasu na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />O Madu e, amyu baw ni a ka-ang hta, nang hpe ngai chyeju dum nga na nngai; amyu masha ni a man e, ngai nang hpe shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a dinggrin tsaw ra myit sumsing lamu ni de dep nga nna; na a sadi sahka gaw lamu kaw du hkra dep nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />O Karai Kasang e, lamu hta na a galu kaba ai lam hte aga ntsa ting hta e mung, na a hpung shingkang dan hkung nga ai hpe madun dan nga u law.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a daru magam n-gun hte anhte hpe hkye hkrang la mi; anhte a akyu hpyi ai ga hpe mung htan ya mi, shing rai jang, nang tsaw ra ai amyu masha ni hkye mawai la ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a chyoi pra ai shara kaw na Karai Kasang gaw, “Awng padang hte ngai Shehkem hpe garan na nngai, Suhkot kadit hpe mung nye a amyu masha ni a lata de garan ya na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gilead gaw nye a rai nga ai, Manashe mung nye a rai nga li ai; Ehprim gaw nye a hpri gup chyawp rai nna, Yuda gaw nye a hkawhkam sumdoi rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung, Moba hpe nye a lagaw kashin ai di zawn ngai lang kau na nngai; Edom a ntsa e mung, nye a hkyepdin hpe kabai tawn na nngai; dai gaw ngai madu la na ngu ai kumla rai nga ai. Hpilisti gaw nye a ntsa e, awng padang jahtau garu lu na mu ai nga nna, shanhte myit nawn nga masai kun?,” nga nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, dai ngang kang ai mare de ngai hpe kadai woi sa na rai nga a ta? Edom de ngai hpe kadai woi sa na rai nga a ta?
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang anhte hpe teng teng kau da nu ni? Anhte a hpyen luksuk ni hte rau nang n pru sa nga n ni?
  </para>
  <para style="p">
    <verse number="12" style="v" />Gumlau hpyen wa hpe hkap daw na matu, anhte hpe karum la mi; masha a karum la ai lam gaw kaman sha rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang anhte a hpang maga de tsap yang, anhte awng padang lu la na ga ai; shi gaw anhte a gumlau hpyen ni hpe shamyit kau na ra ai.
  </para>
  <chapter number="109" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai nang hpe shakawn kungdawn nngai; atsin sha hkum nga nga et!
  </para>
  <para style="p">
    <verse number="2" style="v" />Tara n lang ai masha ni hte masu magaw ai ni ngai hpe htim gasat kau mani ai. Shanhte nye a lam hpe masu magaw ga ni hte tsun shatan nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a lam hpe n hkru n hkra ai shatan nhkan ga ni hte shanhte tsun nhtawm; mara kata e, ngai hpe hpyen galaw ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai shanhte hpe tsaw ra ai hte shanhte a matu akyu hpyi ya tim pyi, shanhte ngai hpe ninghkap nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw kaja ai a malai n hkru n shawp ai, tsaw ra myit a malai n ju n dawng ai myit ni hte ngai hpe bai tai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a gumlau hpyen wa hpe tara jeyang na matu gumhpraw marin ai tara agyi ni hpe lata san da u, shi a gumlau hpung kaw na marai langai ngai shi hpe mara shagun ai wa tai shangun u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi san jep ai hkrum nna, shut ai mara mu hkrum nga u ga; shi a akyu hpyi ai ga pyi ru hka amu sawn ya u ga!
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a asak mung, kade nna yang, htum mat u ga; shi a bungli hpe masha kaga wa lu la mat u ga!
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a kashu kasha ni jahkrai nmai tai mat nna; shi a madu jan mung gaida gaina tai mat u ga!
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a kashu kasha ni dum nta n lu ai mawhpyi ni tai mat mu ga; shanhte shanu nga ai nta chyahten ni kaw nna mung, gawt shapraw kau ai hkrum nga mu ga!
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi a hka madu ni shi a sut gan arung arai yawng hte hpe la kau ya nga mu ga; masha tsasam ni mung, shi galaw ai bungli akyu mahkra hte hpe hkam sha lu mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi hpe matsan yu dum ai masha kadai mung n nga u ga; shi kau da ai jahkrai nmai ni hpe kadai mung n lanu lahku nga u ga.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi a aru arat ni yawng hte mung si mat mu ga; shi a mying hpe hpang ban prat hta n dum shajang mu ga.
  </para>
  <para style="p">
    <verse number="14" style="v" />Madu gaw shi a kaji kawa ni galaw ai n hkru n shawp ai amu ni hpe adum ya nga u ga; shi a kanu tawt lai ai yubak ni hpe galoi mung n raw dat ya lu u ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai Madu gaw shanhte a yubak ni hpe, tut nawng e adum ya nga u ga; rai ti mung, shanhte hkum nan tsep kawp malap kau ai hkrum nga mu ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai masha wa matsan dum na lam, galoi mung n myit yu ai hte; shi gaw matsan mayan re ai wa, ra kadawn ai wa hte karum la na masha n lu ai ni hpe zingri sat kau nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />shi gaw dagam ai hpe tsaw ra nga ai, shi nan dagam dala ai bai hkrum nga u ga! shi shaman chyeju jaw ya na hpe n ju n dawng nga ai majaw, kadai mung shi hpe n shaman ya u ga!
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi bu hpun palawng hpun man nga ai zawn dagam dala ga hpe man man atsun nga u ga; shi a dagam dala ga gaw hka zawn hkum kata de madi shang wa nna, sau zawn shi a nrut nra de du hkra tsim shang wa u ga!
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai dagam ai gaw hpun palawng zawn shi hpe ka-up da u ga; shingkyit zawn shi hpe tut nawng e, kyit shinggrup da u ga!
  </para>
  <para style="p">
    <verse number="20" style="v" />Madu e, dai zawn n hkru n shawp ai lam hte ngai hpe tsun shatan nga ai, nye a gumlau hpyen ni hpe, dai lam hku nna ari jaw u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rai ti mung, nye a Tsaw Htum Ai Madu e, nang jaw da sai ga sadi hte maren, ngai hpe karum la e; na a mai kaja ai tsaw ra myit a majaw, ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai gaw matsan mayan re ai wa hte ra kadawn nga ai wa rai nga nngai; nye a myit masin de du hkra, achyaw machyi ai ngai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shana de na shingnip zawn, ngai wai mat wa magang nga nngai; latung shingtai zawn tsan tsan de shapoi kau ai ngai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lusha kadawn ai majaw, nye a lahput lagaw ni gawng kya nga li ai; ngai gaw nra hta hpyi kap mat sai daram sha rai mat nga nngai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Masha ni ngai hpe mu ma ai shaloi shanhte ngai hpe mani asawng nga ma ai; shanhte gaw n kaw n law re ai hku nna, shanhte a baw ni hpe kanga dan ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nye a Madu Karai Kasang e, na a dinggrin tsaw ra myit a majaw ngai hpe karum la e! Ngai hpe hkye hkrang la e!
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngai hpe hkye hkrang la ai wa gaw nang rai nga ndai hpe nye a gumlau hpyen ni hpe chye shangun e law.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte gaw ngai hpe dagam nga ma ti mung, nang ngai hpe shaman ya na rin dai; ngai hpe zingri zingrat di ai ni sum mat mu ga, na a shangun ma ngai chyawm gaw kabu gara lu n ga.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nye a gumlau hpyen ni gaw myi man sum ai hte htinggrum da ai hkrum nga mu ga; shanhte gaw kaya kahpa hpe nba zawn lawai da nga mu ga.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngai gaw dai Madu hpe nsen ja ja hte chyeju shakawn nga na nngai; ngai shi hpe amyu masha ni a hpawng hta shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hpa majaw nga yang, shi gaw matsan mayan wa hpe makawp maga ya nna; shi hpe si na tara daw dan ya ai ni a lata kaw nna hkye hkrang la ai majaw rai nga ai.
  </para>
  <chapter number="110" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw, “Na a gumlau hpyen ni hpe na a lagaw kabye lahkum ngai shatai kau ai aten du hkra, ndai nye a hkra maga de, dung nga u,” nga nna nye a Madu hkawhkam wa hpe tsun nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu gaw na a hkawhkam daru magam arawng sadang hpe Ziun kaw nna shara shagu de, maden dat na ra ai. Shi gaw nang hpe, “Na a gumlau hpyen ni a ntsa e, up hkang nga u,” nga nna tsun nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na gumlau hpyen ni hpe nang htim gasat ai shani e, na a amyu masha ni gaw madu myit hte shang karum wa na mara ai. Jahpawt manap jau jau e, hkrat ai mari zawn, na a brang ram ni nang shanu nga ai chyoi pra ai bum ni de du sa wa na mara ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Nang gaw Melhkizedek a hkringhtawng lam hta na htani htana hte seng ai hkinjawng tai na rin dai,” nga nna Madu dagam da ai ga sadi rai nhtawm, dai ga sadi hpe bai nhtang dawm la kau na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw na a hkra maga hta nga nga ai. Shi pawt sindawng ai aten hta e; hkawhkam ni hpe anyawp kau na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw masha ni hpe tara dara na ra ai hte, majan pa ni hta masha mang ni hte jahpring da na ra ai; mungkan ting na hkawhkam ni hpe shi agrawp kau na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hkawhkam wa gaw lam makau e lwi ai hka shi hka hpe lu na ra ai; shing rai, shi gaw n-gun rawng wa nna, awng padang hta rawt tsap wa lu na ra ai.
  </para>
  <chapter number="111" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Ngai gaw nye a myit masin mahkra hte shi a amyu masha ni a hpawng hta, dai Madu hpe chyeju shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu galaw ai magam bungli ni kade wa mauhpa rai nga a hka! Dai amu ni hta awng sharawng nga ai nlang hte gaw dai lam ni hpe chye la mayu nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi galaw ai lam yawng mayawng hte hta hpung shingkang arawng sadang hte hpring nga ai; shi a ding man ai lam prat ting anga nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw shi a mauhpa magam bungli ni, anhte hpe n malap shangun nga ai; shi gaw matsan dum ai hte n-gaw n wai ai myit rawng ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw shi hpe shagrau sha-a ai ni hpe lusha jaw ya nga nna; shi a ga shaka hpe galoi mung n malap kau nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Maigan masha ni a lamu ga, shanhte hpe jaw ya ai hku nna shi a amyu masha ni hpe daru magam n-gun madun dan nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi galaw ai amu yawng mayawng hte hta, shi gaw sadi sahka hte teng man nga ai wa rai nga ai; shi a hkang da ai ga matsun nlang hte kam hpa mai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai ni gaw prat ting agrin nga nna dai ni hpe teng man ai hte ding man ai hku jaw da ya sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a amyu masha ni hpe shi shalawt dat nhtawm, htani htana hte seng ai ga shaka hpe shanhte hte shi galaw da nu ai. Shi gaw Chyoi Pra nga ai hte Chyalai n-gun rawng ai wa rai nga ai!
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu hpe shagrau sha-a ai gaw hpaji rawng wa na lam rai nga ai; shi a hkang da ai ga matsun ni hpe madat mara hkan sa nga ai ni yawng hte hpe teng man ai tara dara lam jaw ya nga ai. Shi gaw htani htana shakawn kungdawn ai lam hkam la na ra ai.
  </para>
  <chapter number="112" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Dai Madu hpe shagrau sha-a nna shi a hkang da ai ga ni hpe madat mara hkan sa na hta awng sharawng nga ai wa gaw a nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai mai kaja ai masha wa a kashu kasha ni mung, ga ntsa e, daru magam n-gun hte hpring wa na mara ai; shi a aru arat ni mung shaman chyeju hkam la lu na mara ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a dinghku masha ni gaw sut ring chying wa ai hte sut su wa na mara ai; shi htani htana ngamu ngamai wa na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Matsan chye dum ai, n-gaw n wai myit hte teng man nga ai mai kaja ai masha ni a matu, nhtoi gaw nsin hta htoi tu ya nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Masha kaga wa hpe ntaw ntsang hkoi ya nna, shi a kan bau bungli hpe ding man ai hku galaw nga ai wa gaw a nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mai kaja ai masha wa gaw galoi mung hkrat sum mat na n rai; shi hpe tut nawng e adum nga ai hkrum na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />N kaja ai shiga hpe na yang, dai hpe shi n hkrit nga ai; shi a makam masham n-gun ja nga ai hte dai Madu hpe kam hpa nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw myit ru myit tsang ai hte hkrit ai myit n nga nga ai; shi a gumlau hpyen ni sum mat ai hpe teng teng mu lu na re nga nna, shi kam nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw ra kadawn nga ai wa hpe nhpaw n-ya jaw ya nna, shi a matsan dum ai lam galoi mung yawm mat ai n rai; Shi gaw daru magam n-gun jat wa ai hte hkungga lara ai hkrum na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tara n lang ai ni dai lam hpe mu nna, masin pawt nga ma ai; shanhte gaw wa utik ai hte myit daw hten mat nna; shanhte a myit mada ai lam ni mung htani htana hten mat na mara ai.
  </para>
  <chapter number="113" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Dai Madu a shangun ma ni e, shi a mying nsang hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu a mying nsang hpe ya kaw nna, htani htana shakawn nga mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jan pru ai kaw nna, jan shang ai aten du hkra, Dai Madu a mying nsang hpe shakawn nga mu!
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw amyu baw ni yawng a ntsa e up nga ai; shi a hpung shingkang sumsing lamu ntsa e kabrim nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu anhte a Karai Kasang hte bung ai wa langai mi mung n nga nga ai. Shi gaw ntsa de na tsaw ai shara hta e nga nga ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />rai ti mung, shi gaw sumsing lamu hte ginding aga hpe mu lu na matu gum yu nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw matsan mayan ni hpe ga nhpu hta na sharawt la nhtawm; ra kadawn nga ai ni hpe nchyi nmu kata kaw na pawn sharawt la nga ai,
  </para>
  <para style="p">
    <verse number="8" style="v" />shanhte hpe hkawhkam kasha ni hte manang shatai nna amyu masha ni a hkawhkam kasha ni hpe karum manang shatai wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw maudung num dum nta hta dai jan hpe shagrau sha-a nna; kashu kasha shaprat shangun ai hte kabu gara shangun nga ai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="114" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaku a aru arat, Israela amyu masha ni gaw maigan Egutu mung kaw nna pru mat wa ma ai shaloi,
  </para>
  <para style="p">
    <verse number="2" style="v" />Yuda amyu ni gaw dai Madu a chyoi pra ai amyu masha ni tai wa sai; Israela gaw shi madu da ai amyu tai wa masai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nawng Hkyeng gaw dai hpe mu nna hprawng mat wa ai; Yawdan hka nu mung lwi nga ai kaw nna hkring mat nga sai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bum ni gaw bainam ni zawn gumlawt nga nna; kawng ni gaw sagu kasha ni zawn gumlawt hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Panglai e, nang hpa majaw hprawng mat n ni? Yawdan hka nu e, nang hpa majaw lwi nga ai kaw nna hkring mat n ni?
  </para>
  <para style="p">
    <verse number="6" style="v" />Bum ni e, nanhte hpa majaw bainam ni zawn gumlawt gumtawng nga myit ni? Kawng ni e, nanhte hpa majaw sagu kasha ni zawn shingtawt hkawm nga myit ni?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ginding aga e, dai Madu a man e mung, Yaku a Karai Kasang a man e mung, hkrit gari nga u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw nlung bum ni hpe nawng ing, lunghkrung ni hpe lwi nga ai hka hpawk shara ni shatai kau nu ai.
  </para>
  <chapter number="115" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Madu e, na a dinggrin tsaw ra myit hte sadi sahka lam a majaw, na a hpung shingkang gaw nang hta chyu sha, rai sa, nang hta chyu sha, anga nga u ga, anhte hta dai hpung shingkang nga ai n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Nanhte a Karai Kasang kanang nga nga a ta?,” nga nna amyu baw ni anhte hpe hpa majaw san nga ma ni?
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte a Karai Kasang gaw sumsing lamu hta nga nga ai; shi ra ai hku hpa lam hpe mung shi galaw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a hpara ni hpe aja gumhpraw hte galaw da nna; dai ni hpe masha a lata hte tawk galaw da nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte hta n-gup tu nga ma ti mung, ga n lu shaga nga ai; myi tu ti mung, n mu lu nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte hta na tu nga ma ti mung, n na lu nga ma ai; ladi tu ti mung, n lu manam nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte hta lata tu ti mung, n jum lu nga ma ai, lagaw tu nga ma ti mung, n lu hkawm nga ma ai; shanhte gaw nsen hpe mung n shapraw lu ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpara sumla ni hpe tawk galaw ai ni hte, shanhte hpe kam sham nga ai ni gaw shanhte galaw ai hpara sumla ni zawn sha, rai nga mu ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israela amyu masha ni e, dai Madu hpe kam hpa nga mu. Shi nanhte hpe karum ya nna, makawp maga nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang a hkinjawng ni e, dai Madu hpe kam hpa nga mu. Nanhte hpe karum let makawp maga nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu hpe nawku daw jau nga ai ni yawng hte e, dai Madu hpe kam hpa nga mu. Shi nanhte hpe karum ya nna, makawp maga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu anhte hpe adum nga ai hte shaman ya na ra ai; Shi gaw Israela amyu masha ni hte Karai Kasang a hkinjawng ni yawng hte hpe shaman ya na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi hpe shagrau sha-a ai masha shagu hta na, kaji ai kaba ai n nga, yawng hpe shaman ya na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai Madu gaw nanhte hte nanhte a aru arat ni hpe kashu kasha ni jaw ya nga u ga!
  </para>
  <para style="p">
    <verse number="15" style="v" />Sumsing lamu hte ginding aga hpe hpan tawn da ai, Madu gaw nanhte hpe shaman ya nga u ga!
  </para>
  <para style="p">
    <verse number="16" style="v" />Sumsing lamu hpe dai Madu chyu sha madu nga ai; ginding aga hpe chyawm gaw shinggyim masha ni hpe ap ya nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Si mat sai ni hte, katsi katsang re ai shara de, du shang mat wa ai ni gaw dai Madu hpe shakawn lu ma ai n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rai ti mung, asak hkrung nga ai anhte ni chyawm gaw ya kaw nna, htani htana prat dingsa du hkra, shi hpe chyeju dum shakawn kungdawn nga na ga ai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="116" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw nye a nsen hpe na ya ai majaw, ngai shi hpe tsaw ra nga nngai; shi nye a akyu hpyi ai ga ni hpe madat ya nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai shi hpe aten shagu shaga yang, nye a nsen hpe shi madat ya nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Si du a sumgawn gaw ngai hpe htinggrum da nna; katsan ga na ru tsang ni, ngai hpe wang shinggrup da nga sai. Shing rai, ngai gaw hkrit ai hte nchyi nmu myit kahtet nga li ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi, ngai gaw, “ Madu e, ngai nang hpe hpyi nem nga nngai, ngai hpe hkye hkrang la e,” ngu nna dai Madu hpe shaga ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw matsan dum ai hte mai kaja ai wa rai nga ai; anhte a Karai Kasang gaw matsan chye dum ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu gaw matsan mayan hkrum ai masha ni hpe makawp maga ya nga ai; ngai hkrit tsang hpa hkrum ai shaloi, shi ngai hpe hkye hkrang la sai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a myit masin e, dai Madu gaw nang hpe mai kaja ai chyeju madun dan nit dai majaw, kam hpa nga u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw ngai hpe si ai kaw nna mung, nye a myi prwi pru ai kaw nna mung, nye a lagaw kashawt ai kaw nna mung, hkye hkrang la sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai majaw, hkrung nga ai ni a mungkan hta dai Madu a man e, ngai hkawm nga na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Ngai gaw tsep kawp agrawp mani kau ai hkrum nga nngai,” nga nna tsun nga ai shaloi pyi, ngai kam sham nga dingyang naw rai nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai hkrit tsang ai aten hta pyi, “Kadai hpe mung n kam lu nga ai,” ngu nna tsun ni ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu ngai hpe jaw ya ai chyeju nlang hte hpe, hpa baw hte wa daw jau lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai hpe hkye hkrang la ai majaw, dai Madu hpe chyeju dum shakawn na matu; shi hpe sabyi hkungga nawng jau ya na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai shi hpe ga shaka tawn da ai hte maren, shi a amyu masha ni yawng a hpawng hta, ngai dai hpe shatup na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi a amyu masha ni hta na langai mi si mat wa yang, dai Madu gaw kade wa gawng run machyi nga a hka?
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu e, ngai gaw na a shangun ma wa rai nga nngai; nye nu galaw daw ai zawn ngai nang hpe daw jau nga na nngai. Nang ngai hpe si ai kaw na hkye hkrang la nit dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chyeju dum hkungga ni hte ngai nang hpe nawng jau na nngai, nye a akyu hpyi ai ga hte nang hpe sak jaw na nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai nang hpe ga sadi tawn da ai hte maren, na a amyu masha ni yawng a hpawng hta mung, Yerusalem na na a chyoi pra ai Htingnu hta mung, dai ga sadi hpe ngai shatup na nngai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="117" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amyu baw ni yawng hte e, dai Madu hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a tsaw ra myit gaw anhte a matu kaba nga ai, shi a sadi sahka gaw htani htana prat dingsa agrin nga ai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="118" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw mai kaja nga ai majaw, shi hpe chyeju dum mu; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Shi a tsaw ra myit htani htana agrin nga ai,” nga nna Israela amyu masha ni tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Shi a tsaw ra myit htani htana agrin nga ai,” nga nna Karai Kasang a hkinjawng ni tsun mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Shi a tsaw ra myit htani htana agrin nga ai,” nga nna shi hpe nawku daw jau ai ni yawng hte mung tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai ru yak kyindut hkrum nga yang, dai Madu hpe ngai hpyi jahtau ni ai; shi ngai hpe htan ya nna ngai hpe shalawt dat ni ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu ngai hte rau rai nga ai rai nna, ngai hpa hpe mung n hkrit nga nngai; Kadai wa ngai hpe hpa di lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu ngai hpe karum ai wa rai nga ai majaw; nye a gumlau hpyen ni sum mat ai hpe ngai mu lu na ring ngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Masha hta shamyet shanat ai hta, dai Madu hpe kam hpa ai gaw grau nna mai kaja nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Masha a ningbaw ni hpe shamyet shanat ai hta dai Madu hpe kam hpa ai gaw grau nna mai kaja nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gumlau hpyen law law wa, ngai hpe wang shinggrup da nga ma ti mung; dai Madu a daru magam n-gun hte shanhte hpe ngai shamyit kau lu nga nngai!
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte ngai hpe jut shagu de nna wang da nga ma ti mung: dai Madu a daru magam n-gun hte shanhte hpe ngai shamyit kau lu nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte gaw lagat ni zawn, ngai hpe ginjup shatsang nga ma ti mung; ju hpun hkru ai wan zawn, shanhte tin tin hkru krawp mat nga ma ai. Dai Madu a n gun atsam hte ngai shanhte hpe shamyit kau nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai gaw laja lana gasat ai hkrum nna, sum hkrum nga nngai; rai ti mung dai Madu ngai hpe karum la nga sai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai Madu ngai hpe daru magam n-gun hte atsam marai jahpring ya nna; shi ngai hpe hkye hkrang la ni ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Dai Madu gaw chyahtum chyalai n-gun hte mauhpa magam amu ni hpe galaw nu ai!
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi a daru magam atsam hte anhte hpe awng padang lam jaw ya sai; shi a chyahtum chyalai n-gun hte majan hpe dang kau nu ai,” nga nna Karai Kasang a amyu masha ni shanu nga ai sum ni kaw nna kabu gara jahtau ai awng padang nsen ni hpe madat mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai si wa na nngai n rai, de a malai, ngai hkrung nga nna, dai Madu galaw dan sai magam amu ni hpe htawn tsun dan nga na nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi ngai hpe laja lana di nna ari jaw nga ti mung: shi ngai hpe si shangun nga ai n rai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nawku Htingnu chyinghka ni e, nye a matu hpaw malang nga u; ngai shang wa nna dai Madu hpe chyeju sa dum na nngai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Da ndai gaw Madu a chyinghka rai nga nna, ding hpring ai ni chyu sha shang lu nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Madu e, nang ngai hpe htan ya nna, ngai hpe awng padang jaw ya nit dai majaw, ngai nang hpe shakawn na nngai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nta gaw ai ni lata kau sai nlung gaw, yawng hta grau ahkyak htum ai ningjut nlung tai wa ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai gaw Madu e galaw ai amu rai sai; dai gaw anhte a man na mauhpa amu rai nga sahka!
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai ni na nhtoi gaw dai Madu a awng padang lu ai shani rai nga ai; anhte kabu gara nga let, masat poi galaw nga ga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Madu e, anhte hpe hkye hkrang la mi, anhte hpe hkye hkrang la mi! Madu e, anhte hpe awng padang jaw ya mi!
  </para>
  <para style="p">
    <verse number="26" style="v" />Madu a mying nsang hte du sa ai wa hpe Karai Kasang shaman ya nga u ga! Madu a Htingnu kaw nna, anhte nang hpe shakawn ga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai Madu gaw Karai Kasang rai nga ai, shi gaw anhte hpe chyeju jaw ya mani ai. Nanhte a lata ni hta hpun lakung ni hpe lang nna, poi hpang ai hte tawn hkungri hpe hkawm shinggrup nga mu.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nang gaw nye a Karai Kasang rai nga ndai ngai nang hpe chyeju shakawn nga na nngai; na a galu kaba ai lam hpe ngai htawn tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shi mai kaja nga ai majaw, dai Madu hpe chyeju shakawn nga mu; shi a tsaw ra myit htani htana agrin nga ai law.
  </para>
  <chapter number="119" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu a hkang da ai tara hte maren, mara n kap ai hku asak hkrung nga ai ni gaw a lu ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a hkang da ai tara ni hpe hkan nang nna, myit masin mahkra hte shi hpe madat mara hkan sa ai ni gaw a lu ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw galoi mung shut hpyit ai amu hpe galaw nga ma ai n rai; shanhte gaw dai Madu a lam ni hta ahkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, nang anhte hpe na a hkang da ai tara ni hpe jaw ya nhtawm; dai ga matsun ni hpe kangka ai hte madat mara hkan sa na matu, nang anhte hpe tsun da nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a ga matsun ni hpe hkan shatup lu hkra ngai sadi sahka rai nga lu na hpe, ngai kade wa myit mada nga a hka!
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a hkang da ai tara ni yawng hpe ngai madat mara lu ai rai yang ngai kaya kahpa hkrum na nngai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a ding hpring ai tara dara lam ni hpe sharin la lu nna, san seng ai myit hte nang hpe ngai shakawn na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai gaw na a tara ni hpe madat mara hkan nang nga na nngai; ngai hpe galoi mung hkum kau da nga et!
  </para>
  <para style="p">
    <verse number="9" style="v" />Shabrang wa gaw shi a asak hkrun lam hpe san seng nga u ga, kaning rai shadik lu na rai nga a ta? Dai gaw na a hkang da ai tara ni hpe madat mara hkan sa ai hte sha shadik lu nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a myit masin mahkra hte, ngai nang hpe daw jau na matu shakut na nngai; na a hkang da ai tara ni hpe lale kau ai kaw nna ngai hpe makawp da e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a tara hpe nye a myit masin hta ngai kyem da nga nngai rai nna, ngai nang hpe yubak n galaw na nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, ngai nang hpe shakawn nga nngai; na a lam ni, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang jaw ya sai hkang da ai tara ni yawng hpe, nsen ja ja hte ngai kahtap tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sut gan nlang hkam la lu ai hta, na a hkang da ai tara ni hpe hkan nang nga na, ngai grau ra sharawng nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw na a ga matsun ni hpe sharin la nngai, na a sharin achyin ai lam hpe mung ngai sawk dinglik yu nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tara ni hta ngai kabu awng sharawng nga nngai; na a hkang da ai tara ni hpe ngai malap kau na nngai n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na a shangun ma wa ngai hpe mai kaja ai lam madun dan e; shaloi, ngai na a sharin achyin ai ga ni hpe madat mara hkan sa nna, asak hkrung nga na nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a myi ni hpe hpaw ya e, shaloi, na a tara hta na mauhpa teng man ai lam ni hpe ngai mu lu na nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai gaw ndai mungkan ga ntsa e, jahkring jahkra a matu sha, nga nga nngai; na a hkang da ai ga ni hpe ngai kaw na hkum makoi da et.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aten shagu, na a tara dara ai lam hpe ngai chye mayu nga nngai majaw; nye a myit masin marit ai hte ndawt nga li ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang gaw gumrawng gumtawng ai ni hpe daru sharin nga ndai; na a hkang da ai tara ni hpe tawt lai ai ni gaw dagam kau ai hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />ngai gaw na a tara ni hpe shadik shatup nga ni ai majaw, shanhte a shatan nhkan re ai hte n kaw n law re ai kaw na ngai hpe shalawt la e.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mung up du ni ngai hpe gumlau na matu, maw mawn ai hte hpawng nga ma ti mung; ngai gaw na a sharin achyin ai lam ni hpe sharin la nga na nngai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na a ga matsun ni ngai hpe myit shapyaw ya nna; dai gaw ngai hpe hpaji jaw, lam madun ai ni rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngai gaw sum kadawng mat nna, ga nhpu hta galeng taw mat ni ai; na a ga sadi hte maren, ngai hpe n-gun nnan jaw ya nna bai sharawt la e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ngai galaw shut kau sai lam mahkra hpe ngai yin la sai majaw, nye a hpyi nem ai ga hpe htan ya nit dai, na a lam ni hpe mung, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na a tara ni hpe chye na lu na matu, ngai hpe karum la e; na a mauhpa sharin achyin ai lam ni hpe ngai myit aru yu nga na nngai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ngai gaw yawn hkyen ai hte dip da hkrum nga nngai majaw; na a ga sadi hta maren, ngai hpe n-gun ban ya e.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shut ai lam hta hkawm sa nga ai kaw na ngai hpe sharai la e; na a mai kaja ai lam hta, ngai hpe na a tara sharin ya e.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na a tara hpe madat mara na matu ngai lata la ni ai; na a tara dara ai lam ni hpe ngai madat hkam la ni ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Madu e, ngai gaw na a ga matsun ni hpe hkan sa nga ni ai; ngai hpe kaya kahpa hkum, jahkrum et.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nang ngai hpe chye na lu ai myit nyan hpaji hpe grau jaw ya na rai nga ndai majaw, na a hkang da ai tara ni hpe sharawng awng ai myit hte ngai madat mara hkan sa nga na nngai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Madu e, na a tara ni a lachyum, ngai hpe sharin achyin ya e; dai lam ni hpe aten shagu ngai madat mara hkan sa nga na nngai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na a tara, ngai hpe shaleng dan et, shing rai, dai hpe ngai madat mara nga na nngai; nye a myit masin mahkra hte, dai hpe ngai mazing bang da na nngai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Na a hkang da ai tara ni hta, kabu gara ai lam hpe ngai mu nngai majaw, dai ga matsun ni hpe chye madat mara nga shangun rit.
  </para>
  <para style="p">
    <verse number="36" style="v" />Sut su ngamu ngamai wa na hta, na a tara ni hpe madat mara hkan sa na hpe grau ra sharawng ai myit ngai hpe jaw bang ya e.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kaman lila hpe myit manoi nga ai kaw nna ngai hpe shatsan kau ya e; na a ga sadi nga ai hte maren, mai kaja ai lam, ngai hpe madun dan e.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nang hpe hkrit hkungga ai ni hpe jaw ya ai ga sadi, na a shangun ma wa, ngai hpe mung jaw ya e.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ngai hkrit kahpra ai hpe asawng asang re ai ni kaw na ngai hpe hkye mawai la e; na a tara dara ai lam ni gaw kade wa mauhpa rai nga a hka!
  </para>
  <para style="p">
    <verse number="40" style="v" />Ngai gaw na a hkang da ai tara ni hpe madat mara mayu nga nngai; nang ding hpring nga ndai majaw, ngai hpe asak ningnan jaw ya e.
  </para>
  <para style="p">
    <verse number="41" style="v" />Madu e, nang ngai hpe kade wa tsaw ra nga ndai gaw ngai hpe madun dan e; na a ga sadi hte maren, ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="42" style="v" />Na a ga hta ngai kam hpa nga nngai majaw, ngai hpe n kaw n law re ai ni hpe ngai htan lu na nngai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Na a tara dara ai lam ni hta nye a myit mada ai lam nga nga li ai majaw, teng man ai ga hpe aten shagu tsun shaga lu na matu ngai hpe karum la e.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na a tara hpe n hprai ai sha, htani htana prat dingsa ngai hkan nang nga na nngai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na a sharin achyin ai hpe ngai madat mara hkan nang shakut nga nngai majaw, hkum tsup ai shanglawt ahkaw ahkang hta ngai hkawm sa nga na nngai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Na a hkang da ai ga ni hpe hkawhkam ni a man e, ngai tsun ndau na nngai rai nna, kaya kahpa ngai hkrum na nngai n rai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hkang da ai tara ni hpe ngai tsaw ra nga nngai majaw, dai lam ni hpe madat mara hkan sa ai hta kabu awng sharawng ai lam hpe ngai mu tam nngai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Na a hkang da ai tara ni hpe ngai tsaw ra hkungga nngai; na a ga matsun ni hpe ngai myit aru yu nga na nngai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Na a shangun ma wa ngai hpe jaw ai ga sadi hpe adum nga u; dai gaw ngai hpe myit mada shara jaw ya nga sai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Na a ga sadi gaw ngai hpe asak jahkrung ya nga nit dai majaw; nni nkri hkrum sha nga ai aten hta pyi, shalan shabran ai ngai hkrum nga ni ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Gumrawng gumtawng ai ni ngai hpe tut nawng e, jahpoi asawng nga ma ti mung; na a tara hpe ngai n kau da na nngai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Lai mat wa sai aten na, na a tara dara ai lam ni hpe ngai dum nga nngai; Madu gaw dai lam ni ngai hpe shalan shabran ya nga ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tara n lang ai ni na a tara hpe n hkan ai sha, jahten nga ma ai hpe ngai mu ai shaloi; ngai masin kahtet nga nngai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Kadun la ai dinghta ga na nye a asak hkrun lam hta hkawm sa nga ai laman; na a hkang da ai ga hte seng ai mahkawn ga ni hpe ngai ka jahtuk shalat da nga nngai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Madu e, shana na aten ngai nang hpe myit dum nga nna; na a tara lam ni hpe ngai myit sumru yu nga nngai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Na a hkang da ai ga ni hpe madat mara hkan sa ai hta; nye a kabu gara ai lam hpe ngai mu tam la nga nngai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Madu e, ngai ra sharawng ai lam yawng mayawng gaw nang rai nga ndai; na a tara ni hpe madat mara hkan sa lu na matu, ngai ga sadi jaw nga nngai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Na a ga sadi hte maren, ngai hpe matsan dum la na matu, nye a myit masin mahkra hte nang kaw ngai hpyi nem nga nngai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Ngai gaw nye a asat lawat ni hpe myit sawn yu ni ai; na a ga matsun ni hpe hkan nang na matu, nang hpe ngai ga sadi jaw we ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />N kanung nga ai sha, na a hkang da ai ga ni hpe ngai tin tin madat mara hkan sa nga nngai.
  </para>
  <para style="p">
    <verse number="61" style="v" />N hkru n shawp ai ni nye a matu mahkam hkam da nga ma ti mung; na tara ni hpe ngai malap kau na nngai n rai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Ngai gaw shana yup tung e hprang wa nna, na a ding man ai tara dara lam a matu mara nang hpe ngai shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Ngai gaw nang hpe daw jau nga ai ni hte na a tara ni hpe hkan sa nga ai ni yawng a jinghku wa rai nga nngai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Madu e, ginding aga gaw na a dinggrin tsaw ra myit hte hpring nga ai; ngai hpe na a hkang da ai tara ni sharin ya e.
  </para>
  <para style="p">
    <verse number="65" style="v" />Madu e, na a ga sadi hpe nang shatup nit dai; na a shangun ma wa, ngai hpe mung mai kaja ai lam galaw nga ndai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Na a hkang da ai ga ni hpe ngai kam hpa nga nngai majaw; nyan hpaji hte machye machyang hpaji ngai hpe jaw ya e.
  </para>
  <para style="p">
    <verse number="67" style="v" />Nang ngai hpe ari garai n jaw yang pyi, ngai gaw lam dam mat mat rai nngai, rai ti mung, ya chyawm gaw na a ga hpe ngai madat nga nngai.
  </para>
  <para style="p">
    <verse number="68" style="v" />Nang gaw kade wa mai kaja nga ai hte kade wa matsan dum nga a hka! Ngai hpe na a hkang da ai ga matsun ni sharin ya e.
  </para>
  <para style="p">
    <verse number="69" style="v" />Gumrawng gumtawng ai ni nye a lam hpe masu magaw ga ni hte tsun shatan nga ma ti mung; nye a myit masin mahkra hte na a ga matsun ni hpe ngai madat mara hkan sa nga nngai.
  </para>
  <para style="p">
    <verse number="70" style="v" />Ndai masha ni myit hkawn hkrang ai lam n nga ma ai rai tim, ngai gaw na a tara hta awng sharawng nga nngai.
  </para>
  <para style="p">
    <verse number="71" style="v" />Ngai hkrum sha ai ari gaw nye a matu kaja nga li ai; hpa majaw nga yang, dai gaw ngai hpe na a hkang da ai ga ni hpe sharin la shangun nga ai.
  </para>
  <para style="p">
    <verse number="72" style="v" />Nang ngai hpe jaw ya ai tara gaw mungkan ga na ja gumhpraw sut gan yawng mayawng hta grau nna manu dan nga li ai.
  </para>
  <para style="p">
    <verse number="73" style="v" />Nang ngai hpe hpan da nna shim lum ai hte tawn da nga ndai; na a tara ni hpe sharin la lu n ga, chye chyang ai nyan ngai hpe jaw ya e.
  </para>
  <para style="p">
    <verse number="74" style="v" />Na a ga sadi hpe ngai kam hpa nga nngai majaw, nang hpe hkrit kamyin nga ai ni, ngai hpe mu ma ai shaloi, kabu gara lu na mara ai.
  </para>
  <para style="p">
    <verse number="75" style="v" />Madu e, na a tara dara ai lam ding man nga ai hpe ngai chye nga nngai; nang sadi dung nga ndai majaw, ngai hpe ari jaw nga ndai.
  </para>
  <para style="p">
    <verse number="76" style="v" />Nang ngai hpe ga sadi jaw da nit dai hte maren na a shangun ma wa ngai hpe na a dinggrin tsaw ra myit hte shalan shabran ya nga rit.
  </para>
  <para style="p">
    <verse number="77" style="v" />Na a tara hta ngai sharawng awng nga nngai majaw, nye a ntsa e, matsan dum nga ya rit, ngai ahkrung nga lu na ring ngai.
  </para>
  <para style="p">
    <verse number="78" style="v" />Gumrawng gumtawng ai ni ngai hpe masu ai hku mara shagun nga ma ai majaw kaya kahpa hkrum sha nga mu ga; ngai chyawm gaw na a sharin matsun ai ga ni hpe myit aru yu nga na nngai.
  </para>
  <para style="p">
    <verse number="79" style="v" />Nang hpe hkrit kamyin nga ai ni hte na a hkang da ai ga ni hpe chye na ai ni yawng hte gaw ngai kaw du sa wa mu ga.
  </para>
  <para style="p">
    <verse number="80" style="v" />Ngai gaw na a hkang da ai ga ni hpe ra n rawng hkra madat mara hkan sa nga nngai majaw, kaya kahpa hte sum kadawng ai lam ngai hta n hkrum nga u ga.
  </para>
  <para style="p">
    <verse number="81" style="v" />Madu e, ngai hki ba la nga nngai majaw, ngai hpe hkye hkrang la na matu, nang hpe ala nga nngai; na a mungga hta ngai kam hpa nga nngai.
  </para>
  <para style="p">
    <verse number="82" style="v" />“Nang ngai hpe galoi mi she, karum la na rai nga n ta?,” ngu nna san ai hte, nang tawn da sai ga sadi hpe mada azi yu ai majaw, nye a myi ni tsu nga li ai.
  </para>
  <para style="p">
    <verse number="83" style="v" />Ngai gaw kabai kau sai shanhpyi ndum zawn akyu n rawng nga nngai; rai ti mung, na a hkang da ai ga ni hpe ngai malap kau nga nngai n rai.
  </para>
  <para style="p">
    <verse number="84" style="v" />Gade daram na hkra, ngai ala ra na rai nga a ta? Ngai hpe zingri zingrat di ai ni hpe galoi aten hta, nang ari jaw na n ni?
  </para>
  <para style="p">
    <verse number="85" style="v" />Na a tara hpe hkan sa na matu lale ai gumrawng gumtawng masha ni ngai hpe mahkam hkam na matu, nhkun htu da nga masai.
  </para>
  <para style="p">
    <verse number="86" style="v" />Na a hkang da ai tara ni yawng myit du kam hpa mai nga ai; masha ni gaw masu magaw ga ni hte ngai hpe zingri zingrat di mi ai- ngai hpe karum la e law!
  </para>
  <para style="p">
    <verse number="87" style="v" />Shanhte ngai hpe ganoi noi sha lu sat kau ma ai; rai ti mung, na a hkang da ai ga ni hpe ngai n kau da nga nngai.
  </para>
  <para style="p">
    <verse number="88" style="v" />Na a dinggrin tsaw ra myit a majaw ngai hpe mai kaja ai lam madun dan e; shing rai, na a tara ni hpe ngai madat mara hkan sa lu n ga.
  </para>
  <para style="p">
    <verse number="89" style="v" />Madu e, na a mungga htani htana agrin nga na ra ai; dai gaw sumsing lamu hta e, prat dingsa agrin nga ai.
  </para>
  <para style="p">
    <verse number="90" style="v" />Na a sadi sahka prat mi hte prat mi agrin nga ai; ginding aga hpe nang shara masat da ya nit dai hte, dai gaw a nga nga ai.
  </para>
  <para style="p">
    <verse number="91" style="v" />Arai yawng mayawng hte gaw na a shangun ma ni rai nga ma ai; na a hkang da ai ga ni a majaw, dai ni yawng dai ni du hkra anga nga ma ai.
  </para>
  <para style="p">
    <verse number="92" style="v" />Lama wa, na a hkang da ai tara gaw nye a matu kabu gara ai npawt nhpang n rai taw gaw, nye a nni nkri hta ngai si mat wa na nngai.
  </para>
  <para style="p">
    <verse number="93" style="v" />Ngai gaw na a ga matsun ni hte sha asak hkrung nga lu nga nngai majaw, dai lam ni hpe ngai galoi mung n sawn n sang di kau na we ai n rai.
  </para>
  <para style="p">
    <verse number="94" style="v" />Ngai gaw na a rai nga nngai, ngai hpe hkye hkrang la e! Ngai gaw na a hkang da ai ga ni hpe madat mara hkan sa na matu, shakut shaja ni ai.
  </para>
  <para style="p">
    <verse number="95" style="v" />N hkru n shawp ai masha ni ngai hpe sat na matu, hkap nga ma ti mung; na a hkang da ai tara ni hpe ngai myit aru yu nga na nngai.
  </para>
  <para style="p">
    <verse number="96" style="v" />Arai yawng mayawng hte gaw shadaw shadang a npu e nga nga ma ai; na a hkang da ai mungga gaw dam lada hkum tsup nga ai hpe, ngai sharin la lu ni ai.
  </para>
  <para style="p">
    <verse number="97" style="v" />Na a tara hpe ngai kade wa tsaw ra nga a hka! Dai lam hpe shani tup ngai myit sawn yu nga nngai.
  </para>
  <para style="p">
    <verse number="98" style="v" />Na a hkang da ai mungga gaw ngai hte rau aten shagu nga nga ai rai nna, dai mungga a majaw, nye a gumlau hpyen ni hta grau nna ngai hpe hpaji machye machyang lu la shangun nga ndai.
  </para>
  <para style="p">
    <verse number="99" style="v" />Ngai gaw na a ga matsun ni hpe myit aru yu nga nngai majaw; ngai hpe sharin ya ai sara ni yawng hta grau nna ngai chye chyap nga nngai.
  </para>
  <para style="p">
    <verse number="100" style="v" />Ngai gaw na a hkang da ai ga ni hpe madat mara hkan sa nga nngai majaw; asak kaba sai masha ni hta pyi grau nna ngai hpaji rawng nga nngai.
  </para>
  <para style="p">
    <verse number="101" style="v" />Ngai gaw na a mungga hpe madat mara hkan sa mayu nga nngai majaw, n hkru ai sat lawat yawng hte hpe ngai koi yen kau ni ai.
  </para>
  <para style="p">
    <verse number="102" style="v" />Nang nan nye a sara rai nga ndai majaw, na a ga matsun ni hpe ngai hprai kau we ai n rai.
  </para>
  <para style="p">
    <verse number="103" style="v" />Nang sharin shaga ai ga matsun ni gaw kade wa dwi nga a hka! Dai gaw lagat jahku hta pyi grau nna dwi nga ai.
  </para>
  <para style="p">
    <verse number="104" style="v" />Ngai gaw na a tara mungga ni kaw nna hpaji byeng-ya lu la nga nngai majaw, n tsawm n htap ai arawn alai sat lawat mahkra hte hpe ngai n dawng nga nngai.
  </para>
  <para style="p">
    <verse number="105" style="v" />Na a mungga gaw ngai hpe lam woi ai pyengdin hte nye hkrun lam a matu, nhtoi rai nga ai.
  </para>
  <para style="p">
    <verse number="106" style="v" />Na a ding man ai ga matsun ni hpe madat mara hkan sa na matu, ngai dagam da ai ga sadi hte maren ngai hkan galaw shadik shatup nga na nngai.
  </para>
  <para style="p">
    <verse number="107" style="v" />Madu e, ngai hkrum sha nga ai nni nkri ni gaw teng teng hkrithpa wa rai nga li ai; na a ga sadi hte maren, ngai hpe asak jahkrung tawn e.
  </para>
  <para style="p">
    <verse number="108" style="v" />Madu e, nye a chyeju shakawn akyu hpyi ai ga hpe hkap la ya nna, na a hkang da ai lam, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="109" style="v" />Ngai gaw hkrithpa asak hkrun lam hta asak dan hkawm sa na matu, tut nawng e jin jin rai nga nngai; na a tara hpe ngai malap kau we ai n rai.
  </para>
  <para style="p">
    <verse number="110" style="v" />Tara n lang ai masha ni nye a matu mahkam hkam da nga ma ti mung, na a hkang da ai tara ni hpe ngai madat mara hkan sa nga nngai.
  </para>
  <para style="p">
    <verse number="111" style="v" />Na a hkang da ai tara ni gaw prat dingsa na nye a sut gan ni rai nga ai; dai ni gaw nye myit masin kabu gara ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="112" style="v" />Ngai gaw si ai shani du hkra, na a tara ni hpe madat mara hkan sa na matu myit daw dan da se ai.
  </para>
  <para style="p">
    <verse number="113" style="v" />Nang hta tsep kawp sadi n dung ai ni hpe ngai n ju n dawng nga nngai; rai ti mung, na a hkang da ai tara hpe chyawm gaw ngai tsaw ra nga nngai.
  </para>
  <para style="p">
    <verse number="114" style="v" />Nang gaw nye a dahpran shara hte ngai hpe makawp maga ai wa rai nga ndai; na a ga sadi hpe ngai myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="115" style="v" />Yubak kap ai masha ni e, ngai kaw nna pru mat wa mu, nye a Karai Kasang a hkang da ai ga ni hpe ngai madat mara nga na nngai.
  </para>
  <para style="p">
    <verse number="116" style="v" />Na a ga sadi hte maren, ngai hpe n-gun jaw ya e, shaloi ngai asak hkrung nga lu na nngai; nye a myit mada ai lam hta myit daw myit hten shara hkum tai shangun et.
  </para>
  <para style="p">
    <verse number="117" style="v" />Ngai hpe jum da e, shing rai ngai shim nga na nngai; shaloi, na a hkang da ai ga ni hpe tut nawng e, ngai madat mara nga na nngai.
  </para>
  <para style="p">
    <verse number="118" style="v" />Nang gaw na a hkang da ai tara ni hpe hkan sa na matu lale ai ni hpe ningdang kau nga ndai; shanhte a masu magaw ai maw mawn lam ni gaw kaman lila rai nga ai.
  </para>
  <para style="p">
    <verse number="119" style="v" />N hkru n hkra re ai ni yawng hte hpe maza mala hpe zawn, nang kabai kau nga ndai; ngai chyawm gaw na a sharin matsun ai ga ni hpe tsaw ra nga nngai.
  </para>
  <para style="p">
    <verse number="120" style="v" />Na a majaw, ngai hkrit gari nga nngai, na a tara dara ai lam ni a majaw, ngai hta hkrit kamyin ai myit hpring nga nngai.
  </para>
  <para style="p">
    <verse number="121" style="v" />Ding man ai hte mai kaja ai amu ni hpe ngai galaw se ai; nye a gumlau hpyen ni a lata de ngai hpe hkum kau da et!
  </para>
  <para style="p">
    <verse number="122" style="v" />Na a shangun ma wa hpe nang karum la na lam, ga sadi jaw e; myit tsaw myit dap ai masha ni ngai hpe hkum dip gamyet shangun et!
  </para>
  <para style="p">
    <verse number="123" style="v" />Hkrang shaw la na matu, nang ga sadi jaw da sai, na a hkye hkrang la ai karum la lam hpe azi yu nga ai nye a myi ni tsu nga li ai.
  </para>
  <para style="p">
    <verse number="124" style="v" />Na a dinggrin tsaw ra myit hte maren, ngai hpe chyeju galaw ya e, na a hkang da ai ga ni, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="125" style="v" />Ngai gaw na a shangun ma wa rai nga nngai, na a sharin achyin ai lam ni hpe ngai chye lu n ga ngai hpe machye machyang jaw ya e.
  </para>
  <para style="p">
    <verse number="126" style="v" />Madu e, masha ni na a tara ni hpe hpa zawn n nawn ya nga ma ai majaw, ndai aten na a matu amu galaw na aten rai nga ai.
  </para>
  <para style="p">
    <verse number="127" style="v" />Aja hte jet ai aja hta grau nna, na a hkang da ai tara ni hpe ngai tsaw ra nga nngai.
  </para>
  <para style="p">
    <verse number="128" style="v" />Dai majaw na a ga matsun yawng hte hpe ngai hkan nang nga nngai; shut hpyit ai lam yawng hte hpe ngai n dawng nga nngai.
  </para>
  <para style="p">
    <verse number="129" style="v" />Na a sharin achyin ai ga ni gaw mauhpa wa rai nga ai; dai lam ni hpe, nye a myit masin mahkra hte ngai madat mara hkan nang nga nngai.
  </para>
  <para style="p">
    <verse number="130" style="v" />Na a sharin achyin ai mungga ni hpe tsun shaleng ai lam ni gaw nhtoi hpe jaw ya nga ai rai nna, n chye n chyang ai ni hpe kunghpan wa shangun nga ai.
  </para>
  <para style="p">
    <verse number="131" style="v" />Na a hkang da ai ga ni hpe ngai sharawng nga nngai majaw, hka hpe gara ai zawn gara nna, n-gup mahka let kalawp nga nngai.
  </para>
  <para style="p">
    <verse number="132" style="v" />Nang hpe tsaw ra nga ai ni yawng hte a ntsa e, nang galaw ai zawn, ngai hpang de kayin wa nna ngai hpe matsan dum la e.
  </para>
  <para style="p">
    <verse number="133" style="v" />N hkru n shawp ai masha ni ngai hpe n ka-up kau lu mu ga; na a ga sadi nga ai hte maren, kadawng mat wa ai kaw na, ngai hpe shadaw la e.
  </para>
  <para style="p">
    <verse number="134" style="v" />Ngai gaw na a hkang da ai ga ni hpe hkan nang lu n ga: ngai hpe dip gamyet nga ai ni a lata kaw na hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="135" style="v" />Na a myi man shingkang hte ngai hpe shaman ya e, ngai hpe na a tara ni sharin ya e.
  </para>
  <para style="p">
    <verse number="136" style="v" />Masha ni na a tara hpe n madat n mara nga ma ai majaw, nye a myi prwi ni gaw hka nu zawn lwi nga li ai.
  </para>
  <para style="p">
    <verse number="137" style="v" />Madu e, nang gaw ding hpring nga ndai hte na a tara ni mung teng man nga ai.
  </para>
  <para style="p">
    <verse number="138" style="v" />Nang jaw ya sai tara hkrang ni tsep kawp rap ra ai hte teng man nga ai.
  </para>
  <para style="p">
    <verse number="139" style="v" />Nye a gumlau hpyen ni, na a hkang da ai ga ni hpe hpa zawn n nawn ya nga ma ai majaw, nye a masin kahtet ai gaw wan zawn hkru nga li ai.
  </para>
  <para style="p">
    <verse number="140" style="v" />Na a ga sadi gaw kade wa teng man nga a hka! Dai hpe ngai kade wa tsaw ra nga n hka!
  </para>
  <para style="p">
    <verse number="141" style="v" />Ngai gaw hpa n ging ai hte yu kaji kau hkrum ai wa rai nga nngai; rai ti mung, na a sharin shaga ai ga ni hpe ngai hprai kau nga nngai n rai.
  </para>
  <para style="p">
    <verse number="142" style="v" />Na a ding man ai lam htani htana prat dingsa agrin nga na ra ai. na tara mung tut nawng e teng man nga ai.
  </para>
  <para style="p">
    <verse number="143" style="v" />Myit ru myit tsang ai hte yawn hkyen ai ngai hkrum sha nga nngai; rai ti mung, na a hkang da ai mungga ni ngai hpe kabu gara shangun nga ai.
  </para>
  <para style="p">
    <verse number="144" style="v" />Na ga matsun ni tut nawng e teng man nga ai; ngai hkrung nga lu n ga, ngai hpe chye chyang ai hpaji jaw ya e.
  </para>
  <para style="p">
    <verse number="145" style="v" />Nye a myit masin mahkra hte, ngai nang hpe shaga nga nngai; Madu e, ngai hpe htan ya e, na a hkang da ai ga ni hpe ngai madat mara hkan nang nga na nngai!
  </para>
  <para style="p">
    <verse number="146" style="v" />Ngai nang hpe shaga nngai, ngai hpe hkye hkrang la e; na a hkang da ai tara ni hpe ngai shadik shatup nga na nngai.
  </para>
  <para style="p">
    <verse number="147" style="v" />Karum la na matu, jan garai n pru yang, nang hpe ngai shaga nngai; na a ga sadi hpe ngai myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="148" style="v" />Shana tup n yup ai sha galeng taw nga let, na a sharin shaga ai ga ni hpe myit aru yu nga nngai.
  </para>
  <para style="p">
    <verse number="149" style="v" />Madu e, na a tsaw ra myit gaw dinggrin rai nga ai majaw; na a matsan dum ai myit ngai hpe madun dan nna, nye a asak hpe kyem mazing da ya e.
  </para>
  <para style="p">
    <verse number="150" style="v" />Mazut ai hte zingri zingrat ai ni ngai hpang de shanang sa wa nga ma ai, masha dai ni na a tara hpe galoi mung n hkan nang ai ni rai ma ai.
  </para>
  <para style="p">
    <verse number="151" style="v" />Rai ti mung, Madu e, nang ngai hte ani sha nga nga ai; na a hkang da ai ga ni mahkra agrin nga ai.
  </para>
  <para style="p">
    <verse number="152" style="v" />Moi moi kaw nna, na a sharin shaga ai ga ni hpe ngai hka ja la ni ai; nang gaw dai ni hpe htani htana shagrin da nga nit dai.
  </para>
  <para style="p">
    <verse number="153" style="v" />Na a tara hpe ngai n malap kau nga nngai majaw, nye a nni nkri hpe yu nna, ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="154" style="v" />Ngai hpang maga de tsap nna nye a amu hpe jeyang ya e; na a ga sadi nga ai hte maren, ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="155" style="v" />Tara n lang ai ni na a tara ni hpe n hkan nga ma ai majaw; hkye hkrang la ai shanhte hkrum na ma ai n rai.
  </para>
  <para style="p">
    <verse number="156" style="v" />Rai ti mung, Madu e, na a matsan dum ai myit galu kaba nga ai rai nna; na a matsan dum lama ai myit madun dan nna ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="157" style="v" />Ngai gaw gumlau hpyen ni hte dip gamyet sha ai masha law law lu nga nngai; rai ti mung, na a tara ni hpe madat mara na matu ngai hprai na n rai.
  </para>
  <para style="p">
    <verse number="158" style="v" />Gumle gumlau re ai ni na a hkang da ai ga ni hpe n hkan nga ma ai hpe, ngai mu ai shaloi, ngai yu matsat nga nngai.
  </para>
  <para style="p">
    <verse number="159" style="v" />Madu e, na a sharin shaga ai ga ni hpe ngai kade daram tsaw ra nga ai hpe yu yu u; na a tsaw ra myit galoi mung galai mat ai n rai, dai majaw ngai hpe hkye hkrang la e!
  </para>
  <para style="p">
    <verse number="160" style="v" />Na a tara madung gaw teng man ai lam rai nga ai; na a ding man ai tara dara lam yawng hte gaw htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="161" style="v" />Daru magam n-gun atsam rawng ai masha ni gaw ngai hpe n tara ai hku gasat nga ma ti mung; ngai gaw na a tara hpe hkungga nga nngai.
  </para>
  <para style="p">
    <verse number="162" style="v" />Na a ga sadi ni a majaw, ngai kade wa kabu gara nga a hka! Law la ai ja gumhpraw sut gan ni hpe mu tam ai wa zawn, kabu gara nga nngai.
  </para>
  <para style="p">
    <verse number="163" style="v" />Ngai gaw masu magaw ga ni mahkra hpe n ju n dawng ai hte matsat nga nngai, rai ti mung, na a tara hpe chyawm gaw ngai tsaw ra nngai.
  </para>
  <para style="p">
    <verse number="164" style="v" />Na a ding man ai tara dara lam ni a majaw, lani mi hta sanit lang, nang hpe ngai chyeju dum shakawn nga nngai.
  </para>
  <para style="p">
    <verse number="165" style="v" />Na a tara hpe tsaw ra ai ni hkum tsup re ai shim lum ai lam hpe hkam la lu nga ma ai; shing rai, hpa mung, shanhte hpe myit kataw shangun lu na n rai.
  </para>
  <para style="p">
    <verse number="166" style="v" />Madu e, ngai hpe hkye hkrang la na matu nang hpe ngai ala nga nngai; nang hkang da ai ga hte maren, ngai galaw nngai.
  </para>
  <para style="p">
    <verse number="167" style="v" />Na a sharin shaga ai ga ni hpe ngai madat mara hkan sa nga nngai; dai lam ni hpe, nye a myit masin mahkra hte tsaw ra nga nngai.
  </para>
  <para style="p">
    <verse number="168" style="v" />Na a hkang da ai ga ni hte na a matsun maroi ga ni hpe ngai madat mara hkan sa nga nngai; ngai galaw ai lam yawng mayawng hpe mung nang mu nga ndai.
  </para>
  <para style="p">
    <verse number="169" style="v" />Madu e, karum la na matu, nye a hpyi jahtau ai nsen nang kaw hkrang lung wa u ga! Na a ga sadi hte maren, ngai hpe machye machyang hpaji jaw ya e.
  </para>
  <para style="p">
    <verse number="170" style="v" />Nye a akyu hpyi ai ga hpe madat ya e; na a ga sadi hte maren, ngai hpe hkye hkrang la e!
  </para>
  <para style="p">
    <verse number="171" style="v" />Nang ngai hpe na a tara ni sharin ya ai majaw, nang hpe ngai tut nawng shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="172" style="v" />Na a hkang da ai tara ni gaw ding man nga ai majaw, na a tara lam hpe ngai mahkawn shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="173" style="v" />Na a hkang da ai ga matsun ni hta ngai hkan nang nga nngai majaw, ngai hpe karum la na matu, tut nawng e, jin jin rai nga u.
  </para>
  <para style="p">
    <verse number="174" style="v" />Madu e, na a hkye hkrang la ai karum la lam hpe ngai kade wa marit nga a hka! Na a tara hta ngai kabu gara ai lam mu la nngai.
  </para>
  <para style="p">
    <verse number="175" style="v" />Ngai hpe asak jaw ya e, shaloi, nang hpe ngai shakawn nga n ga, na a sharin shaga ai ga matsun ni ngai hpe karum nga u ga.
  </para>
  <para style="p">
    <verse number="176" style="v" />Ngai gaw mat mat ai sagu zawn dam hkawm nga nngai; na a tara hpe n hprai kau nga nngai majaw, na a shangun ma re ai ngai hpe sa lakawn la e law.
  </para>
  <chapter number="120" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai ru tsang hkrum nga ai shaloi, dai Madu hpe ngai shaga ai hte ngai hpe shi htan ya ni ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu e, masu magaw ai masha ni hte hkalem hkalau chye ai masha ni a lata kaw nna ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masu magaw masha ni e, nanhte hpe Karai Kasang hpa galaw na rai nga a ta? Shi nanhte hpe gara hku ari jaw na rai nga a ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Hpyenla wa a masen ai pala ni, hkyeng kahtet nga ai nhprang wan n-ga ni hte ari jaw na ra ai!
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanhte a lapran e ngai nga nga ai gaw Meshek mung hta e nga nga ai zawn mung; Kedara amyu masha ni a lapran e nga nga ai zawn mung, nni nkri rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw ngwi pyaw sim sa lam hpe n dawng nga ai masha ni hte nau wa na hkra, nga kau se ai!
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngwi pyaw sim sa lam hpe ngai tsun yang, shanhte majan gasat na lam hpe tsun ma ai.
  </para>
  <chapter number="121" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw bum lang ni de mada yu nngai; ngai hpe karum na gaw, kanang na pru wa na rai nga a ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Sumsing lamu hte ginding aga hpe hpan tawn da ai dai Madu kaw nna ngai hpe karum ai lam pru wa na ra ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw nang hpe kataw shangun na ra ai n rai; nang hpe makawp maga ai wa gaw tut nawng e dum hprang nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israela hpe makawp maga nga ai wa gaw, galoi mung yup nga, yup pyaw nga ai n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw nang hpe bau sin na ra ai; shi nang hpe makawp maga na matu, na a makau e nga nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shani na ajan, shana na shata, nang hpe machyi shangun lu na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu gaw hkrithpa yawng hta na nang hpe makawp maga la na ra ai; shi nang hpe shim hkra bau sin na ra ai;
  </para>
  <para style="p">
    <verse number="8" style="v" />dai Madu gaw ya kaw nna htani htana prat dingsa nang hkawm sa ai shara shagu hkan e, nang hpe makawp maga nga na ra ai.
  </para>
  <chapter number="122" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shanhte gaw, “Dai Madu a nta de anhte lung wa saga,” nga nna ngai hpe tsun ma ai shaloi, ngai kabu gara nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya aten hta anhte ndai, Yerusalem mare chyinghka lam kata e, tsap nga ga ai!
  </para>
  <para style="p">
    <verse number="3" style="v" />Yerusalem mare gaw shi shara hte shara htuk manu, tsawm htap ai hku, bai gaw gap da ai mare rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ndai mare gaw shi a hkang da ai mungga nga ai hte maren, dai Madu hpe chyeju shakawn kungdawn na matu, amyu baw ni, Israela amyu bawsang ni sa zup ai shara rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ndai mare gaw Israela Hkawhkam ni hkaw dung nna, shanhte a amyu masha ni hpe tara jeyang na shara rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Nang hpe tsaw ra ai ni ngamu ngamai nga mu ga, na a mare bunghku kata ni hta ngwi pyaw sim sa nga u ga,
  </para>
  <para style="p">
    <verse number="7" style="v" />na a hkawhkam htingnu ni hta shim nga u ga,” nga nna Yerusalem mare a ngwi pyaw sim sa lam a matu akyu hpyi nga mu, nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a jinghku ni hte manang ni a matu mara, “Nang hta ngwi pyaw sim sa ai lam nga nga u ga law,” nga nna Yerusalem mare hpe ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a Madu Karai Kasang a nta a jaw e, na a ngamu ngamai lam a matu, ngai akyu hpyi nga nngai.
  </para>
  <chapter number="123" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang up hkang nga ai Sumsing lamu de ngai mada yu nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shangun ma wa gaw shi a madu a ntsa e mung, shangun ma numsha gaw shi a nta madu jan a ntsa e mung shamyet shanat nga ai zawn, anhte a Madu Karai Kasang a matsan dum ai chyeju hpe hkam la lu ai aten du hkra, anhte mung nang hpe a mada yu nga na ga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu e, anhte hpe matsan dum la mi, anhte hpe matsan dum la mi law! Anhte gaw n kaw n law re ai hte kaya kahpa nau wa hkrum sha nga saga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte gaw lu su ai ni a asawng asang re ai hte gumrawng gumtawng hte dip gamyet sha ai ni a shatan nhkan hpe hkam sha ai aten mung nau wa na mat wa saga ai.
  </para>
  <chapter number="124" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lama wa, dai Madu anhte a hpang maga de n nga ai rai yang, hpa baw byin wa na rai nga ga ta? Israela amyu masha ni e, htan yu mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />“Anhte a gumlau hpyen ni anhte hpe gasat wa ai shaloi dai Madu anhte hpang maga de lama n nga ai rai yang;
  </para>
  <para style="p">
    <verse number="3" style="v" />shanhte hta masin kahtet ai gaw tung wa nna anhte hpe chyahkrung mayu kau na mu ai;
  </para>
  <para style="p">
    <verse number="4" style="v" />shing rai, hka mawru gaw anhte hpe magawn mat wa nna dai hka anhte hpe kaput kau na ru ai,
  </para>
  <para style="p">
    <verse number="5" style="v" />n-gun ja ai hka hpungla ni anhte hpe marit si shangun na sha rai mu ai.”
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte hpe anhte a gumlau hpyen ni a lata hta n jahtum kau shangun ai dai Madu hpe anhte chyeju dum nga ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jau gawng wa a mahkam hta na lawt wa ai u zawn, anhte mung lawt mat wa lu saga ai; mahkam daw agrawp mat nna, anhte lawt lu saga ai!
  </para>
  <para style="p">
    <verse number="8" style="v" />Sumsing lamu hte ginding aga hpe hpan da ai dai Madu kaw nna, anhte hpe karum ai lam pru wa nga ai.
  </para>
  <chapter number="125" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe kam hpa nga ai ni gaw galoi mung n ashun, galoi mung shamu shamawt n nga ai Ziun Bum zawn rai ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bum ni gaw Yerusalem mare hpe grup rai gawan da nga ai hte maren, dai Madu mung, shi a amyu masha ni hpe ya kaw nna prat dingsa grup rai gawan da nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tara n lang ai ni ding hpring ai ni a lamu ga hpe tut nawng e, up hkang lu ma ai n rai; lama wa, shanhte up hkang lu ai rai yang mung, ding hpring ai masha ni nan n hkru ai amu hpe galaw na ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, kaja ai masha ni hte na a hkang da ai ga ni hta madat mara hkan sa nga ai ni hpe, mai kaja ai lam jaw ya u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai ti mung, n hkru n shawp ai ni hpe nang ari jaw ai shaloi, na a lam ni hpe yit kau da nga ai ni hpe mung ari jaw u. Ngwi pyaw sim sa ai gaw Israela ni hte rau anga nga u ga law!
  </para>
  <chapter number="126" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu anhte hpe Yerusalem mare de bai woi nhtang wa ai shaloi; dai gaw yup mang zawn rai nga ai!
  </para>
  <para style="p">
    <verse number="2" style="v" />Anhte kaning rai mani ai, kaning rai kabu gara mahkawn mangoi saga ai! Dai shaloi kaga amyu baw ni gaw, “Dai Madu shanhte a matu, amu kaba galaw ya nu ai,” nga nna anhte a lam hpe tsun mi ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw kaja wa, anhte a matu amu kaba ni hpe galaw ya nu ai; dai gaw anhte a matu kade wa kabu gara shara rai nga sahka!
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, marang jahtu dat ya ai shaloi, hkun hkraw nga ai hkaraw hkam wam ni hta hka ni du shang wa ai zawn, anhte hpe kalang mi bai ngamu ngamai shangun mi law.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte a nsi naisi ni hpe myi prwi hte gat hkai ai ni gaw kabu gara ai hte bai shu la lu mu ga!
  </para>
  <para style="p">
    <verse number="6" style="v" />Nli noi hpye hpye nna, hkrap let pru sa wa ai ni gaw hkauling lahkawn hpai nna, kabu gara mahkawn shakawn let bai nhtang wa na mara ai.
  </para>
  <chapter number="127" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw dai nta hpe n gap da ai rai yang, nta gap ai ni a amu kaman lila rai nga ai. Dai Madu gaw dai mare hpe n makawp maga ai rai yang, sin langa ni a makawp maga ai lam kaman sha rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jahpawt manap jau jau rawt nna, shana aten lai hkra kan bau makan amu a matu, hki ba let galaw ti mung kaman lila rai nga ai. Hpa majaw nga yang, dai Madu gaw shi tsaw ra ai ni hpe naw yup nga yang pyi, shanhte hta ra nga ai lam ni hpe jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kashu kasha ni gaw dai Madu kaw na kumhpa ni rai nga ai; shanhte gaw jet ai shaman chyeju majing ni rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ram prat hta lu ai kashu kasha ni gaw hpyenla wa a lata na pala ni hte bung nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai zawn re ai pala law law lu ai masha wa gaw a nga ai. Shi gaw shi a gumlau hpyen ni hte tara rung e hkrum ti mung, sum ai lam galoi mung hkrum na n rai.
  </para>
  <chapter number="128" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu a ga hpe madat nna, shi a hkang da ai mungga hte maren asak hkrung nga ai ni gaw a lu ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a lata amu gaw na a ra kadawn nga ai lam ni hpe jahkum shatsup ya lu na ra ai; nang kabu gara wa lu ai hte ngamu ngamai wa na rin dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a nta hta, na a madu jan gaw si si ai sabyi hpun zawn, na a nsha ni gaw tsanlun hpun lawn kasha ni zawn na a sha ku grup yin e rai nga na ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu a ga hpe madat mara hkan sa ai wa gaw ndai zawn, shaman ai chyeju hpe teng teng hkam la lu na ra ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw nang hpe Ziun Bum kaw nna shaman ya nga u ga! Nang hkrung nga ai nhtoi yawng hte hta, Yerusalem a ngamu ngamai ai lam hpe mu lu n ga!
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a kashu ni hpe mung nang hkrung nga ai hte yang mu lu n ga! Ngwi pyaw sim sa ai gaw Israela hte rau anga nga nu ga law!
  </para>
  <chapter number="129" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela e, nang gaw naw kaji nga ai aten kaw nna, na a gumlau hpyen ni nang hpe kaning rai zingri zingrat di lai wa sai lam, anhte hpe tsun dan mi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ngai naw kaji nga ai aten kaw nna, nye a gumlau hpyen ni ngai hpe mazut ai hku zingri nga ma ti mung, shanhte ngai hpe n dang lu ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw nye a shingma hta sung ai nma jahkang ya nna; dai gaw shawt tawn da ai hkauna pa zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai ti mung, ding man ai wa ngu ai dai Madu gaw, mayam yam ai kaw nna, ngai hpe shalawt la nu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ziun hpe n dawng n yawt nga ai ni nlang hte gaw, kaya kahpa hte sum mat nna, jahtaw kau ai hkrum nga mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte yawng hte gaw nta numgaw e tu nna, dai ni pyi garai n tu kaba wa lu yang, hkraw si mat ai tsingdu ni zawn rai mat mu ga,
  </para>
  <para style="p">
    <verse number="7" style="v" />dai hpe kadai mung hkan lahkawn shinggyin ai n rai; dai hpe shabawn hpai mat wa ai wa mung kadai n nga nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Dai Madu gaw nanhte hpe shaman ya nga u ga, dai Madu a mying nsang hte anhte nanhte hpe shaman ya ga ai,” nga nna lai hprang masha ni kadai mung n tsun na mara ai.
  </para>
  <chapter number="130" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nye a myit htum ai shara kaw nna nang hpe ngai shaga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu e, nye a hpyi jahtau ai nsen hpe na ya e; karum la na matu, nye a hpyi shaga ai nsen hpe madat ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lama rai nna, anhte a yubak ni hpe ka matsing da ai rai yang; kadai wa mara daw dan ai kaw nna hprawng lawt lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai ti mung, nang anhte hpe mara raw dat ya nga ndai, dai majaw, anhte nang hpe hkrit hkungga ai hte madat mara hkan sa nga ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw dai Madu a karum la ai lam hpe myit mada let ala nga nngai; shi a mungga hpe ngai kam hpa nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sin langa ni jahpawt manap hpe ala nga ai zawn rai sa, sin langa ni jahpawt manap hpe ala nga ai hta grau nna, ngai gaw dai Madu hpe myit katu ai hte ala nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israela e, shi a tsaw ra myit gaw dinggrin anga nga ai hte; shi anhte hpe hkye hkrang la na matu, tut nawng e, ra sharawng nga ai majaw, dai Madu hta kam hpa nga mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw shi a Israela amyu masha ni hpe, shanhte a yubak yawng kaw nna hkye hkrang la na ra ai.
  </para>
  <chapter number="131" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, ngai gaw nye a gumrawng gumtawng ai myit hpe kau da ni ai; nye a myit tsaw myit dap rawng ai akyang kaw nna mung kayin kau da ni ai. Ngai gaw kaba la ai amu ni hta na mung, nye a matu chye na na, nau wa yak la ai amu lamang ni hpe mung ngai myit n lawm nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai na malai, ngwi pyaw sim sa ai lam hta ngai myit dik myit hkut nga nngai. Chyu chyu ai ma gaw shi kanu a lahpyen hta atsin sha yup galeng taw nga ai zawn, nye a myit masin mung atsin sha nga nga li ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israela e, ya kaw nna htani htana prat dingsa, dai Madu hpe kam hpa nga mu law!
  </para>
  <chapter number="132" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, Dawi hte shi hkam sha lai wa sai maru mayak lam yawng hte hpe hkum malap kau et!
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu e, Dawi gaw, “Dai Madu a Nawku Htingnu ngu ai, dai Chyahtum Chyalai n-gun rawng ai Yaku a Karai Kasang a matu nta n gap ngut dingsa, nye a nta de wa na nngai n rai, yupku ntsa de ngai lung na n rai, ngai ban sa la na n rai, ngai yup la na n rai,” nga nna nang hpe shi dagam da ai ga sadi hte Chyahtum Chyalai n-gun rawng ai Yaku a Karai Kasang hpe, shi tawn da nu ai ga ndat hpe dum nga u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Betlehem mare hta e, Sakse Sumpu a lam hpe anhte na saga ai rai nna, dai hpe Yearim a yi hta anhte mu lu sagaw ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anhte gaw, “ Madu a nta de anhte sa wa ga; shi a tingnyang man e, anhte nawku daw jau ga,” ngu nna tsun saga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, na a daru magam n-gun a kumla rai nga ai Sakse Sumpu nga ai Nawku Htingnu de sa wa nna; dai shara hta htani htana shanu nga u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a hkinjawng ni gaw teng man ai lam hpe tut nawng hkan galaw nga mu ga; na a amyu masha ni mung kabu gara jahtau garu nga mu ga!
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu e, na a shangun ma Dawi wa hpe nang ga sadi jaw da nga nit dai majaw; na a namman jaw hkam ai hkawhkam wa hpe hkum kau da nga et.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu gaw, “Ngai na a nsha ni hta na marai langai ngai hpe hkawhkam shatai na we ai, shi gaw na a hkang hta up hkang na ra ai. Lama rai nna, na a nsha ni nye a ga shaka hte shanhte hpe ngai jaw ai hkang da ai ga ni hpe, hkan sa nga ai rai yang chyawm gaw shanhte a kasha ni hpe mung, na a hkawhkam hkringhtawng hta prat dingsa hkawhkam tai lu na mara ai,” nga nna Dawi hpe nang dagam ga sadi tawn da nit dai hpe nang bai nhtang dawm kau na ndai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw Ziun hpe lata la nu ai; dai mare hpe shi a shanu shara shi galaw mayu nga ai rai nna,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Ndai shara hta htani htana ngai anga nga na nngai, dai mare hpe mung, ngai up hkang mayu nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw Ziun mare hpe shi hta ra kadawn nga ai lam mahkra ntaw ntsang shaman ya na nngai; dai mare na matsan mayan masha ni hpe mung, lusha hte ngai jahkru shakat na nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai mare na hkinjawng ni galaw ai lam shagu hpe mung, ngai shaman ya na nngai; shing rai, dai mare na amyu masha ni mahkawn mangoi ai hte kabu gara jahtau garu wa na mara ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shara hta, ngai gaw Dawi a aru arat langai ngai hpe hkawhkam kaba shatai na we ai; ngai lata la ai hkawhkam wa a up hkang ai tara hpe dai shara hta grin nga shangun na nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai gaw shi a gumlau hpyen ni hpe kaya kahpa hte htinggrum da ya na nngai; rai ti mung, shi a mungdan gaw ngamu ngamai wa nna gumring gumrat wa na ra ai,” nga nna tsun nga ai.
  </para>
  <chapter number="133" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang a amyu masha ni myit hkrum rap ra nna, rau hpawng nga lu ai gaw, kade wa mauhpa rai nga a hka, dai gaw kade wa ngwi pyaw nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai gaw, Arun a baw hte nhka mun kaw nna, shi a palawng du hkawp du hkra, byawng hkrat mat wa ai manu dan ai namman sau zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai gaw Hermon bum ntsa hte Ziun bum ni a ntsa e, hkrat ai numri ni zawn rai nga ai. Dai gaw galoi mung htum ngu n nga ai asak, dai Madu ga sadi jaw ya sai shi a shaman chyeju rai nga ai.
  </para>
  <chapter number="134" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shi a Nawku Htingnu kata hta, shana e nawku daw jau nga ai shangun ma ni yawng hte e, sa marit, dai Madu hpe shakawn ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanhte a lata ni hpe sharawt nna Nawku Htingnu kata hta akyu hpyi mu, dai Madu hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="3" style="v" />Sumsing lamu hte ginding aga hpe hpan tawn da ai dai Madu gaw Ziun Bum kaw nna nanhte hpe shaman ya nga u ga law!
  </para>
  <chapter number="135" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu a nta wang hte anhte a Karai Kasang a Nawku Htingnu kata hta tsap nga ai Madu a shangun ma ni e, shi a mying nsang hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi mai kaja nga ai majaw, dai Madu hpe shakawn mu; shi matsan dum nga ai majaw, shi a mying nsang hpe mahkawn shakawn nga mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw Yaku hpe shi a matu, Israela amyu masha ni hpe shi madu na matu, lata la nu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte a Madu gaw galu kaba nga nna, hpara ni yawng hta grau nga ai hpe ngai chye nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sumsing lamu hte ginding aga hta e mung, panglai ni hte sung la ai shara shagu hkan e mung, shi myit ai hte maren, galaw nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mungkan ga a jahtum shara kaw nna laru sumwi ni hpe shi sharawt dat nna; nbung laru a matu myi hprap wan gala ya ai hte shi a dum kata kaw nna, nbung hpe mung shapraw dat wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Egutu mung hta e, masha hte dusat kaw na kasha alat ni yawng hte hpe shi sat kau ya mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai mung hta e, Hpara-u hte shi a ali ama ni yawng hte hpe ari jaw na matu; lamik kumla ni hte mauhpa amu ni hpe shi shapraw dan nu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw amyu baw ni law law hpe shamyit kau nna; daru magam n-gun hte hpring ai hkawhkam ni hpe sat kau nu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amori masha ni a hkawhkam Sihon, Bashan hkawhkam Oga hte Hkanan mung na hkawhkam ni mahkra hpe mung sat kau nu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw shanhte a lamu ga ni hpe shi a amyu masha ni a lata hta ap ya nu ai; shi gaw dai lamu ga ni hpe Israela ni a lata hta jaw da nu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Madu e, nang gaw Karai Kasang rai nga ndai hpe tut nawng e htawn tsun na mara ai; prat ban masha ni yawng hte mung nang hpe adum nga na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai Madu shi a amyu masha ni hpe makawp maga nga nna; shi a shangun ma ni a ntsa e, matsan dum ai myit rawng nga na ra ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Masha amyu baw ni a hpara sumla ni hpe ja gumhpraw ni hte galaw da nna; dai ni gaw masha a lata hte tawk shapraw da ai sumla ni rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte hta n-gup tu ti mung, n lu shaga nga ma ai, myi tu ti mung, n mu lu nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte hta na tu ti mung, n na lu ma ai, shanhte gaw nsoi nsa pyi n lu sa nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai ni hpe tawk ai ni hte, shanhte hpe kam hpa nga ai ni yawng hte mung shanhte galaw ai sumla ni zawn rai mat na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israela amyu masha ni e, dai Madu hpe shakawn mu! Karai Kasang a hkinjawng ni e, shi hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="20" style="v" />Lewi ni e, dai Madu hpe shakawn mu; dai Madu hpe nawku daw jau ai ni yawng hte e, shi hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="21" style="v" />Ziun ntsa e mung, shi shanu nga ai Yerusalem hta mung, dai Madu hpe shakawn mu. Dai Madu hpe shakawn mu.
  </para>
  <chapter number="136" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shi gaw mai kaja nga ai majaw, dai Madu hpe chyeju dum shakawn nga mu; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpara ni yawng hta kaba htum ai Karai Kasang hpe chyeju dum shakawn mu; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu ni yawng hta chyahtum chyalai n-gun rawng htum ai dai Madu hpe chyeju dum shakawn nga mu; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi chyu sha mauhpa lamik kumla kaba galaw lu nga ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi a hpaji hte sumsing lamu hpe shi hpan da nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw sung ai hka ni a ntsa e, ginding aga hpe gaw da nga ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw jan hte shata hpe galaw da nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jan gaw nhtoi hpe up hkang na matu shi hpan da nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shata hte shagan ni hpe hpan ai gaw shana hpe up na matu rai nga ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Egutu amyu masha ni a kasha alat ni hpe shi sat kau nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israela amyu masha ni hpe Egutu mung kaw nna shi woi wa nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi a n-gun ja ai lata, daru magam n-gun hte hpring ai lahpum ni hte, shanhte hpe woi wa nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi gaw Nawng hkyeng hpe lahkawng brang di nna ga garan kau nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi a amyu masha ni hpe de a ka-ang hku shi woi lai mat wa nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, shi gaw Egutu hkawhkam hte shi a hpyen luksuk ni hpe dai nawng hta lup si shangun nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi a amyu masha ni hpe nam mali hku shi woi wa nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw daru magam n-gun hte hpring nga ai hkawhkam ni hpe sat kau nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mying gumhkawng ai hkawhkam ni hpe sat kau nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi gaw Amori hkawhkam Sihon hpe sat kau nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bashan hkawhkam Oga hpe sat kau nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi gaw shanhte a lamu ga hpe shi a amyu masha ni a lata hta ap ya nu ai; shi a tsaw ra myit htani htan agrin nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi gaw dai ni hpe shi a shangun ma rai nga ai Israela hpe jaw nu ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anhte sum mat ga ai shaloi, anhte hpe shi malap kau mi ai n rai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi anhte hpe anhte a gumlau hpyen ni a lata kaw nna shalawt dat mi ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi gaw hkrung mahkrung guji guyang yawng hte hpe lusha jaw sha nga ai; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sumsing lamu na Karai Kasang hpe chyeju dum shakawn nga mu; shi a tsaw ra myit htani htana agrin nga ai.
  </para>
  <chapter number="137" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ziun mare hpe anhte myit dum dat ga ai shaloi, anhte gaw Babelon mung na hka nu, hka shi ni a makau hkan dung nga let, hkrap nga ga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai makau mayang hkan tu nga ai u byap hpun ni hta anhte a tingse ni hpe noi da nga ga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte hpe rim da ai ni gaw, shanhte hpe mahkawn mangoi dan na matu tsun ma ai; shanhte gaw, “Ziun a mahkawn, anhte hpe mahkawn dan mi,” nga nna shanhte hpe shangwi shapyaw ya na matu, tsun ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tsasam mungdan hta e, anhte kaning rai nna dai Madu hpe mahkawn shakawn lu na rai nga ga ta?
  </para>
  <para style="p">
    <verse number="5" style="v" />Yerusalem e, nang hpe ngai malap kau sayang gaw: tingse hpe galoi mung ngai n dum lu nu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang hpe ngai malap kau nna, nang hpe nye a kabu htum ai shara hku n myit sawn kau ai rai yang, hpang de, ngai galoi mung bai n mahkawn shakawn lu nu ga!
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu e, Yerusalem mare hpe dang la ai shani, Edom amyu masha ni galaw ai amu ni hpe dum nga u; “Ndai mare hpe ga du hkra run kau gaw!,” nga nna shanhte tsun ai ga ni hpe adum nga u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Babelon e, nang gaw jahten kau ai hkrum na rin dai. Anhte hpe nang galaw mi ai hte maren, nang hpe bai tai lu ai wa gaw a nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a ma chyangai ni hpe la nna, nlung hta shanhte hpe adit kau ai wa gaw a nga ai.
  </para>
  <chapter number="138" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nye a myit masin mahkra hte nang hpe ngai chyeju shakawn nga nngai. hpara ni a man e, nang hpe ngai mahkawn shakawn nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a dinggrin tsaw ra myit hte sadi sahka gaw, na a mying nsang hte na a hkang da ai mungga ni hpe lam madun dan nga nit dai majaw, na a chyoi pra ai Nawku Htingnu de, ngai myi man yawng nna, dingnyawm ai hte na a mying nsang hpe shakawn na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang hpe ngai shaga yang, nang ngai hpe htan ya nit dai; na a n-gun hte ngai hpe n-gun shaja ya nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, mungkan ga na hkawhkam nlang hte gaw na a ga sadi ni hpe na yu manu ai majaw, shanhte nang hpe shakawn kungdawn na mara ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang galaw dan sai amu ni hte, na a galu kaba ai hpung shingkang a lam hpe shanhte mahkawn mangoi wa na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang gaw tsaw htum ai shara hta nga nga ai rai tim, grit nem nga ai ni hpe nang lanu lahku nga ndai; gumrawng gumtawng ai ni mung nang kaw nna, makoi yen lu ma ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ru tsang ai hte gawan da ai ngai hkrum nga ai shaloi, ngai hpe nang makawp maga da nga ndai. Nye a gumlau hpyen ni a sindawng kahtet ai hpe nang hkap shingdang ya nna, na a daru magam n-gun hte ngai hpe hkye hkrang la nga ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang ga sadi tawn da nit dai hte maren, lam shagu hpe jahpring shatsup ya na rin dai; Madu e, na a tsaw ra myit htani htana agrin nga ai. Nang hpang da sai amu ni hpe shangut u law.
  </para>
  <chapter number="139" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang ngai hpe manaw yu nna chye nga ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai galaw ai lam yawng mayawng hte hpe mung, nang chye nga ndai; nye a myit mang ai lam yawng mayawng hpe mung, tsan tsan kaw nna, nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai bungli galaw nga ai hte hkring nga ai hpe nang mu nga ndai; ngai galaw ai lam yawng mayawng hpe mung nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ndai ga garai n shaga shapraw ai kaw nna pyi, ngai hpa tsun wa na lam hpe nang chye ngut chyalu rai nga ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw ngai hpe jut shagu kaw nna na a daru magam n-gun hte ngai hpe makawp maga nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a lam hpe chye ya ai na a machye machyang hpaji gaw nau sung la nga ai; dai gaw, nye a machye machyang hte n dang dep lu nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang kaw nna lawt mat wa na matu, ngai gara de sa lu na rai nga a ta? Na a man kaw nna, gara de, ngai hprawng lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="8" style="v" />Sumsing lamu de lung mat wa ai rai yang mung, dai shara hta, nang nga nga na rin dai; Katsan ga e, ngai lama taw nga ai rai yang mung, dai shara hta nang nga nga na rin dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sinpraw maga de, ngai pyen hkawm mat wa ai rai yang mung, sinna maga tsan dik htum ai shara hta sa nga ai rai yang mung,
  </para>
  <para style="p">
    <verse number="10" style="v" />dai shara ni hta nang nga nga nna, ngai hpe woi wa na rin dai; ngai hpe karum la na matu, dai shara hta nang nga nga na ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nsin gaw ngai hpe ka-up da nna, nhtoi gaw nye a grup yin e shana tai u ga, nga nna ngai tsun nga yang;
  </para>
  <para style="p">
    <verse number="12" style="v" />nsin mung na a man e, nsin zawn n rai mat nna, dai shana gaw shani zawn tai nga ai. Nsin hte nhtoi gaw na a man e maren sha rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang gaw nye hkum a hkrihkraw lami laman shagu hpe hpan da nna; nye nu a kan hta e, ngai hpe shachyaw da nit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang gaw hkrit hkungga mai ai Madu rai nga ndai majaw, ngai nang hpe shakawn kungdawn nga nngai. Nang galaw ai lam yawng mayawng mung laklai ai mauhpa amu ni rai nga ai hpe nye a myit masin mahkra hte chye nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nye a nrut nra ni hkrang pru wa nna, langai hte langai shada da atsawm sha htuk shachyaw mat wa nhtawm, nu a hkritung kan hta kaba wa let dai shara hta ngai naw rawng nga yang pyi, nang ngai hpe chye nga nit dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai garai n shangai wa ai aten kaw nna pyi, nang ngai hpe mu nit dai. nye a matu masat da ya ai nhtoi ni langai mi hpe mung ngai garai n mu yang, na a laika hta yawng ka matsing da nga nit dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Kasang e, na a myit mang ai lam ni nye a matu kade wa yak la nga a hka; Dai ni gaw kade wa law la nga a hka!
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hte hpe hti yu na nga yang, shanhte gaw zaibru hta n ga law htam nga ma ai. Ngai yup hprang wa ai shaloi, nang hte rau ngai naw nga na nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Karai Kasang e, n hkru n shawp ai ni hpe nang sat kau na, ngai kade wa ra nga a hka! Kasu kabrawng shabyin ai masha ni, ngai kaw nna pru mat wa na hpe, ngai kade wa ra nga a hka!
  </para>
  <para style="p">
    <verse number="20" style="v" />Shanhte na a lam hpe n tara ai hku tsun nga ma ai; na a mying nsang hpe n hkru n hkra ai ga ni hte shanhte tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Madu e, nang hpe n ju n dawng ai ni hpe ngai mung kade wa n dawng nga a hka! Nang hpe gumlau ai ni hpe mung ngai kade wa matsat nga a hka!
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai shanhte hpe n dawng n yawt ai myit masin mahkra hte n dawng nga nngai; shanhte hpe nye a gumlau hpyen ni zawn ngai sawn la nga nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Karai Kasang e, ngai hpe manaw yu nna nye a myit hpe chye ya e; ngai hpe chyam dinglik yu nna nye a myit sawn ai lam hpe mu chye nga ya e.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nye a myit masin hta n hkru ai lam lama rawng nga ai rai yang, dai ni hpe sawk yu u; htani htana agrin nga ai lam de, ngai hpe woi wa e law.
  </para>
  <chapter number="140" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, n hkru n shawp ai masha ni a lata kaw na ngai hpe hkye hkrang la e; kashun kashe du daw sai hkaw shabyin ai masha ni a kata kaw nna mung, ngai hpe makawp maga la e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte gaw tut nawng e, n hkru n shawp ai amu hpe maw mawn nga ma ai hte, tut nawng e, ga law ga la lam hpe shalut kabrawng dat ya nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte a shinglet ni gaw gung rawng ai lapu zawn rai nga nna, shanhte tsun shaga ai ga ni mung pu mawp a atuk zawn rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, n hkru n shawp ai ni a n-gun atsam kata kaw na, ngai hpe makawp maga la e; ngai hkrat sum mat na matu maw mawn nga ai, kashun kashe du daw sai hkaw shabyin ai masha ni a lata kaw na makawp maga la e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gumrawng gumtawng ai masha ni nye a matu mahkam hkam da nga masai; shanhte ngai hpe rim la na matu, lam e sumgawn nep da nna, mahkam galaw da nga masai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw Madu hpe, “Nang gaw nye a Karai Kasang rai nga ndai,” ngu nna tsun nngai; Madu e, karum la na matu, nye a hpyi jahtau ai nsen hpe na ya e!
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a Grau Htum Ai Madu Chyahtum Chyalai n-gun hte hpring nga nna, ngai hpe makawp maga ai Madu e, nang gaw ngai hpe majan pa hta makawp maga ya nit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, tara n lang ai wa a ra ai lam hpe hkum jaw ya et; shanhte a n hkru ai maw mawn lam ni hpe mung, hkum hkan ya nga et.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a gumlau hpyen ni hpe awng padang hkum lu shangun nga et; ngai hpe jahkrit shama ai lam yawng mayawng mung shanhte a ntsa e, bai hkrat wa mu ga.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte a ntsa e, hkyeng kahtet nga ai n hprang wan n ga hkrat bun nga u ga; shanhte nhkun de di hkrat bang nna galoi mung bai n lu pru wa lu mu ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Masha kaga ni hpe masu magaw ga hte mara tam nga ai ni, hkrat sum nga mu ga; n hkru ai lam gaw kashun kashe du daw sai hkaw shabyin ai masha ni hpe hkan dep nang nna, shanhte hpe jahten kau mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, nang gaw matsan mayan ni a akyu hte, ra kadawn nga ai ni a ahkaw ahkang hpe makawp maga ya nga ndai gaw, ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ding hpring ai masha ni nang hpe teng teng shakawn kungdawn wa na mara ai; shanhte gaw na a man e, shanu nga lu na mara ai.
  </para>
  <chapter number="141" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang hpe ngai shaga nga nngai, ngai hpe ya jang karum la e! nang hpe ngai shaga ai shaloi, ngai hpe madat ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a akyu hpyi ai ga hpe manam pyaw ai baw lawban zawn; nye a lata sharawt ai gaw shana de na hkungga hpe zawn, hkap la ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu e, nye a n-gup hta mung, nye a nten chyinghka hta mung, sin langa ni hpe tawn da ya e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shut hpyit amu galaw mayu ai kaw na mung, n hkru ai masha ni a tara n lang ai amu hta shang lawm nga ai kaw nna mung, ngai hpe shatsan shagang kau ya e. Shanhte a lusha poi ni hta ngai galoi mung n shang lawm nga u ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mai kaja ai masha wa gaw ngai hpe ari jaw u ga, shawang myit kaba hte ngai hpe daru sharin nga u ga, rai ti mung, shanhte a n hkru ai sat lawat ni hpe ninghkap na, tut nawng e, ngai akyu hpyi nga nngai majaw, n hkru ai masha ni a shagrau sha-a ai lam hpe galoi mung ngai hkap la na n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte a mung du, salang ni nlung ninggam kaw nna kabai jahkrat kau ai hkrum nga ma ai shaloi; amyu masha ni nye a ga teng man nga ai hpe yin la na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte a nrut nra ni gaw, chye ga da ai hpun zawn, kahtum kadaw rai mat nna; dai nrut nra ni hpe lup sung hku hkan e, gat ayai da nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung, nye a Tsaw Htum Ai Madu e, ngai nang hta dingyang kam hpa nga nngai; na a makawp maga ai lam hpe ngai tam nga nngai, ngai hpe hkum si shangun et!
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a matu, shanhte hkam da ai mahkam kaw na mung, n hkru ai amu galaw ai ni a mahkam kaw na mung, ngai hpe makawp maga la e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai mahtang asan apra sha lai mat wa nna, tara n lang ai ni chyawm gaw tinang a mahkam hta di hkrat mat mu ga.
  </para>
  <chapter number="142" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karum la na matu, Madu hpe ngai shaga nngai; shi hta e, ngai hpyi nem nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a aru ara lam mahkra hte hpe shi hpang de, ngai la sa nngai; nye a ru tsang lam yawng hte hpe mung, shi hpe ngai tsun dan nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai gaw myit daw hten nna, asum jaw kau na matu jin jin rai nga ai shaloi, ngai hpa galaw ang ai lam hpe shi chye ya nga ai. Ngai hkawm sa wa ai lam hta nye a gumlau hpyen ni nye a matu mahkam up da ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a makau mayang hkan e, ngai yu dat ai shaloi, ngai hpe karum la na masha kadai hpe mung ngai n mu nngai; ngai hpe makawp maga la na masha kadai mung n nga ai. Ngai hpe lanu lahku la na, kadai n nga nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, karum la na matu, ngai nang hpe jahtau nga nngai; Madu e, nang gaw ngai hpe makawp maga ai wa rai nga ndai; ndai asak hkrun lam hta, ngai ra ai lam yawng mayawng mung nang rai nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai myit chyum myit htum hkrum hkra nga nngai majaw, karum la na matu, nye a hpyi jahtau ai nsen hpe madat ya e. nye a gumlau hpyen ni ngai hta nau wa n-gun ja nga ma ai majaw, shanhte a lata kaw nna, ngai hpe hkye hkrang la e law.
  </para>
  <para style="p">
    <verse number="7" style="v" />Myit ru myit yak hkrum nga ai kaw nna ngai hpe shalawt la e; shaloi, na a mai kaja ai lam ni a majaw na a amyu masha ni a hpawng hta, nang hpe ngai shakawn kungdawn nga na nngai law.
  </para>
  <chapter number="143" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nye a akyu hpyi ai ga hpe na ya e! Na a ding man ai lam hta, nye a hpyi nem ai ga hpe madat ya e; na a sadi sahka hte ngai hpe htan ya e!
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a shangun ma wa, ngai hpe, tara jeyang ai hpe hkum hkrum shangun nga et; na a man e, mara n kap ai masha langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a gumlau hpyen wa ngai hpe hkan shachyut dep ni ai hte; ngai hpe atsai awai di nna dang kau nu ai. Shi gaw ngai hpe sin mak ai shara hta sharen da ai rai nna, moi na ten hta si mat wa sai ni zawn ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai majaw, ngai asum jaw kau na matu, jin jin rai nga nngai; myit chyum myit htum, mung hkrum sha nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw lai mat wa sai nhtoi ni hpe adum nga nngai; nang galaw dan lai wa sai amu ni yawng a lam ni hpe, ngai myit sawn yu nga nngai, na a amu ni yawng hpe ngai myit aru yu nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a lata hpe nang kaw ladawn nna, akyu hpyi nga nngai; hkun hkraw nga ai lamu ga gaw hka hpe marit ai zawn, nye a wenyi mung, nang hpe gara nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu e, ngai hpe ya jang, htan ya e! nye a myit mada ai lam yawng htum mat sali ai. Na a myi man ngai kaw nna, hkum kayin kau nga et; shing rai yang, nsung hku kata de shang mat wa ai ni hta ngai lawm wa na ring ngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang hpe ngai kam hpa nga nngai majaw, jahpawt manap shagu hta, na a dinggrin tsaw ra myit ngai hpe a shadum ya nga rit. Nye a akyu hpyi ai ga gaw nang kaw hkrang lung wa nna, ngai hkawm sa wa ang ai lam, ngai hpe madun ya e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, makawp maga la na matu, nang kaw ngai sa wa nga nngai; nye a gumlau hpyen ni a lata kaw nna ngai hpe mawai la e law.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw nye a Karai Kasang rai nga ndai, na a myit ra ai hku, galaw lu na matu ngai hpe sharin ya e. Mai kaja ai lam madun ya nna, shim ai hkrun lam hta woi lakawn wa ya rit.
  </para>
  <para style="p">
    <verse number="11" style="v" />Madu e, na a ga sadi hte maren, ngai hpe mawai la e; na a mai kaja ai lam hta nye a ru tsang kaw na ngai hpe hkye hkrang la e!
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai hpe nang tsaw ra nga ndai majaw nye a gumlau hpyen ni hpe shamyit kau u, ngai gaw na a shangun ma wa rai nga nngai majaw, ngai hpe dip gamyet sha nga ai ni yawng hte hpe shamyit kau u law.
  </para>
  <chapter number="144" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai hpe makawp maga nga ai Madu hpe shakawn kungdawn mu! Shi gaw ngai hpe majan a matu zai ladat hpaji sharin ya ai hte ngai hpe lajang shachyip ya nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw ngai hpe makawp maga ya ai wa, nye a shamyet shanat shara wahpang; ngai hpe hkye hkrang la ai nye a dahpran shara, hte shim lum na matu, ngai kam hpa nga ai wa rai nga ai. Amyu baw ni hpe shi nye a npu e tawn da nu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu e, shinggyim masha gaw hpa wa mi rai nna, nang shi hpe mada yu nga n ni? Shinggyim masha sha hpe nang hpa majaw ahkyak wa zawn nawn nga n ni?
  </para>
  <para style="p">
    <verse number="4" style="v" />Shinggyim masha gaw nsa sa lai nbung hte bung nga ai, shi a nhtoi ni lai mat wa ai shingna zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, lamu hpe gang je hpaw nna yu hkrat wa rit; bum ni hpe ahtawk hkra ai hte dai ni wan hkut shapraw ya na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Myihprap galam dat nna, na a gumlau hpyen ni hpe shabra kau u; na a pala ni hpe gap dat nna shanhte hpe jahprawng kau u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tsaw htum ai shara kaw nna, na a lata hpe ladawn ai hte sung ai hka kata kaw nna, ngai hpe gang shaw la ai hte mawai la e; tsasam masha ni a n-gun kata kaw nna ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw teng man ai ga hpe, galoi mung n tsun nga ma ai; teng man ai ga tsun na matu, dagam ga hte ga shaka tawn sai rai ti mung, shanhte naw masu nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang e, mahkawn ga nnan hte nang hpe ngai mahkawn mangoi na nngai; tingse dum let nang hpe ngai mahkawn mangoi na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang gaw hkawhkam ni hpe awng padang jaw ya nga ndai hte; na a shangun ma wa Dawi hpe mawai la nit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gumshem ai nye a gumlau hpyen ni a lata kaw nna ngai hpe hkye hkrang la e; tsasam masha ni a n-gun atsam kata kaw nna mung ngai hpe hkye hkrang la e; shanhte gaw teng man ai ga hpe galoi mung n tsun nga ma ai hte dagam ga hte ga shaka la tim pyi shanhte masu ai ga ni hpe naw tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte a shadang sha ni gaw shanhte a brang ram prat hta, hpun lawn kasha ni tu kaba wa ai zawn; anhte a shayi sha ni mung, Nawku Htingnu jut ni hpe mawn sumli da ai nlung shadaw ni zawn, rai nga mu ga.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anhte a mam dum ni hta nsi naisi hkum dingnum hte hpring nga u ga; udat pa layang hkan e nga ai sagu ni hta mung, kasha hkying hkying mun mun law htam wa mu ga.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anhte a dumsu yam nga ni hta nbya n nga, daw hten mat ai mung n hkran ai sha, law htam mayat maya wa mu ga. Anhte a mare ni hta myit ru myit htum ai a majaw jahtau marawn ai nsen ni mung n nga u ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ndai zawn teng man ai hte nga lu ai amyu gaw a nga ai; Madu hpe Karai Kasang hku nna hkap la kam sham ai amyu gaw a nga ai law!
  </para>
  <chapter number="145" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Karai Kasang hte hkawhkam wa e, na a galu kaba ai lam hpe ngai htawn tsun nga na nngai; ngai nang hpe htani htana prat dingsa chyeju shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shani shagu nang hpe ngai chyeju dum shakawn nga na nngai; nang hpe ngai htani htana prat dingsa shakawn kungdawn nga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu gaw galu kaba nga ai majaw, nachying shakawn ging ai wa rai nga ai; shi a galu kaba ai lam hpe n dang chye lu nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang galaw ai magam amu, shu mashi shu masha, ban prat mi hte prat mi, shakawn shagrau nga na mara ai; na a daru magam amu ni hpe mung, shanhte htawn tsun dan na mara ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a hpung shingkang hte arawng sadang hpe mung shanhte tsun hkai dan na mara ai; na a mauhpa magam bungli ni hpe ngai myit aru yu nga na nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a daru magam amu ni hpe masha amyu ni htawn tsun dan na mara ai; na a galu kaba ai lam hpe mung, ngai htawn tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw na a mai kaja ai lam yawng hte hpe tsun dan na mara ai; na a matsan dum ai lam hpe shanhte mahkawn shakawn na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu gaw tsaw ra ai hte matsan dum ai wa rai nga nna; shi gaw pawt sindawng ai hpe hkam sharang ai hte dinggrin tsaw ra myit hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw nlang hte a ntsa e, mai kaja nga ai rai nna, shi galaw ai arai yawng mayawng a ntsa e mung, matsan dum ai myit rawng nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu e, nang hpan da ai hkrung mahkrung yawng hte gaw nang hpe shakawn na mara ai hte, na a amyu masha ni yawng hte mung nang hpe chyeju dum shakawn na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw na a hkawhkam daru magam hpung shingkang hte na chyahtum chyalai n-gun a lam hpe hkai dan na mara ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai, masha hkum shagu hte gaw na a atsam rawng ai magam bungli ni hte; hpung shingkang arawng sadang hte hpring nga ai, na a mungdan lam ni hpe chye na lu na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a up hkang lam gaw htani htana agrin nga nna, nang gaw htani htana prat dingsa agrin nga ai hkawhkam wa rai nga ndai; Madu gaw shi a ga sadi ni hta sadi dung nga ai hte magam bungli ni yawng hta tsaw ra matsan dum ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw ru tsang hkrum nga ai ni hpe karum ya nna; kataw ai ni hpe sharawt la nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Asak hkrung ai ni yawng hte gaw nang hpe myit mada let, mada yu nga ma ai rai nna, shanhte hta lusha shahpa kadawn wa ai shaloi, shanhte hpe nang lusha jaw ya nga ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte hpe nang law htam hkra jaw nna, masha yawng a ra kadawn ai lam mahkra hpe nang jahkum shatsup ya nga ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Madu shi galaw ai lam yawng mayawng hte hta ding hpring nga ai rai nna, shi a magam bungli ni yawng hta matsan yu dum ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi gaw shi hpe shaga ai ni hte myit malang ai hte shi hpe shaga ai ni hte ani sha nga nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi hpe hkrit hkungga ai ni a ra kadawn ai lam ni hpe shi jaw ya nna; shanhte a hpyi jahtau ai nsen ni hpe na ai hte shanhte hpe hkye hkrang la mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi hpe tsaw ra ai masha hkum shagu hte hpe, shi makawp maga ya ti mung; tara n lang ai ni hpe chyawm gaw shi sharun shabyak kau na wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngai gaw dai Madu hpe tut nawng e shakawn kungdawn nga na nngai; shi hpan da ai hkrung mahkrung yawng hte gaw shi a chyoi pra ai mying nsang hpe htani htana shakawn kungdawn nga mu ga law.
  </para>
  <chapter number="146" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Nye a wenyi e, dai Madu hpe shakawn kungdawn nga u!
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai asak hkrung nga ai hte yang, shi hpe ngai shakawn nga na nngai; nye a asak prat tup, nye a Karai Kasang hpe mahkawn nga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shinggyim masha ni a ningbaw ningla ni hpe hkum kam hpa nga et; shinggyim masha kadai mung nang hpe hkye hkrang la lu na n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte si mat wa ai shaloi, ga nhpu de bai nhtang mat wa ai; dai shani jang, shanhte a maw mawn ai lam yawng htum mat nga manu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku a Karai Kasang karum la ai lam hpe hkam la lu ai ni hte dai Madu shi a Karai Kasang hta shamyet shanat nga ai ni gaw a lu ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw sumsing lamu hte ginding aga, panglai hte dai hta rawng marawng yawng hte a hpan Madu rai ngai ai. Shi gaw shi a ga sadi ni hpe tut nawng e a shatup nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw dip gamyet sha hkrum ai ni a hpang maga de, tara dara ya nna; kaw si hkrum ai masha ni hpe lusha shahpa jaw ya nga ai. Dai Madu gaw bawng dung ai ni hpe mung shalawt dat wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Myi n mu ai ni hpe myi shamu ya nna, kataw ai ni hpe shi sharawt la nga ai; shi a ding hpring ai masha ni hpe shi tsaw ra nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a lamu ga hta nga ai tsasam masha ni hpe shi makawp maga ya nga ai; gaida gaina ni hte jahkrai nmai ni hpe shi karum ya nga ai, rai ti mung, tara n lang ai ni a maw mawn ai lam hpe chyawm gaw jahtum kau ya nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai Madu gaw htani htana hkawhkam wa rai nga ai, Ziun e, na a Karai Kasang gaw prat mi hte prat mi up nga na ra ai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="147" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Anhte a Karai Kasang hpe mahkawn shakawn na mai kaja nga ai; dai gaw sharawng awng ai lam rai nna, shi hpe shakawn kungdawn na mai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu gaw Yerusalem mare hpe bai de da nna, bra hkawm mat wa sai Israela amyu masha ni hpe bai shinggyin la nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw myit daw ai ni hpe shamai ya nna, shanhte a ningma ni hpe ahkyen kayawp ya wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi hpan da sai shagan ni a hti hkum ni hpe daw dan nna; langai hte langai hpe mying shamying da ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte a Madu gaw galu kaba nga nna chyahtum chyalai n-gun hte hpring nga ai wa rai nga ai; shi a nyan hpaji hpe shadawn lu nga ai n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw shagrit shanem ai ni hpe sharawt la ti mung; tara n lang ai ni hpe ga de du hkra agrawp ayai kau wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu hpe mahkawn mangoi ga hte mahkawn shakawn mu; anhte a Karai Kasang hpe tingse hte mahkawn shakawn mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw lamu hta sumwi ni hpe kahpyan da nhtawm, lamu ga a matu marang hpe shi jahtu ya nga ai; shing rai, kawng ntsa hkan e mung, tsingdu ni hpe shatut da nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw yam nga ni hpe shahpa jaw ya ai hte, u hka hkalung ni ngoi shaga ai shaloi, shat ni hpe jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />N-gun ja ai gumra ni hpe shi n ra sharawng nga ai hte share shagan ai hpyenla ni hpe shi yu kabu nga ai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, shi hpe shagrau sha-a ai ni hte shi a dinggrin tsaw ra myit hta kam hpa nga ai ni hpe shi ra sharawng nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yerusalem e, dai Madu hpe shakawn u! Ziun e, na a Karai Kasang hpe kungdawn u!
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi gaw na a mare chyinghka ni hpe shangang da nna, na a amyu masha ni hpe, shi shaman ya nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw na a lamu ga jarit ni hpe shim nga shangun nna; sau ai hkaulan mam hta nang hpe shakat ya nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi gaw ginding aga de, ga matsun shangun dat nna, dai mungga hte maren, tin tin byin wa nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw hkyen hpe nba zawn hpyan jahkrat dat nna, hkyen gumdin ni hpe ga nhpu zawn, gat dat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw sin tawng ni hpe lung sha ni zawn jahkrat dat nna; shi dat dat ai kashung lagyi ai hpe kadai mung n hkam lu nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpang, shi a ga matsun dat dat nna, hkyen hpe shabyawng kau dat nu ai; nbung hpe shi dat dat nna, hka shi ni lwi wa nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi gaw shi a amyu masha ni hpang de, shi a mungga hte shi a sharin achyin ai matsun mungga hte tara ni hpe Israela amyu masha ni hpang de jaw ya nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi gaw kaga amyu baw ni a matu, ndai zawn re ai lam n galaw ya wu ai rai nna; shanhte gaw shi a tara ni hpe n chye nga ma ai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="148" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Tsaw htum ai shara hta nga nga ai ni e, sumsing lamu na dai Madu hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a lamu kasa ni yawng hte e, shi hpe shakawn mu: Sumsing lamu hte seng ai shi a hpyen luksuk ni yawng hte e, shi hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajan hte shata, shi hpe shakawn mu, htoi kabrim ai shagan ni e, shi hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tsaw htum ai sumsing lamu ni hte lamu a ntsa hta nga nga ai hka hpung ni e, shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu a mying nsang hpe yawng jawm shakawn nga mu ga! Na a mungga majaw, nga yawng danghta hpan da hkrum nga ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />na a hkang da ai mungga hte maren, shanhte a shara ni hta htani htana agrin nga ma ai, dai ni gaw hkang da ai mungga hpe n lai lu nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Panglai baren numraw ni, sung ai nammukdara yawng, myi hprap hte sin, hkyen hte sumwi, shi a mungga hpe madat mara ai nbung laru ni e, mungkan ga kaw nna, dai Madu hpe shakawn nga mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kawng ni hte bum ni, namsi hpun ni hte maling mala ni, shani da ai yam nga ni hte matse labye dusat ni yawng, gumrawt hkawm ai baw hte ntsa malen u ni e, shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam ni hte amyu baw shagu, hkawhkam shadang sha ni hte kaga mung du, salang ni yawng; mahkawn ni hte shabrang ni, gumgai dingla ni hte ma kaji ni e, shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu a mying nsang hpe shanhte yawng shakawn mu ga! Shi a mying nsang gaw kaga ni yawng hta grau nga ai; shi a hpung shingkang gaw ginding aga hte sumsing lamu a ntsa e, chyam nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw shi a amyu baw ni hpe n-gun shaja ya nga ai majaw, shi a amyu masha ni yawng shi hpe shakawn nga ma ai- shi hpe grai tsaw ra ai Israela amyu masha ni mung shi hpe shakawn nga ma ai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="149" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Dai Madu hpe mahkawn ga nnan hte mahkawn mu; shi a kangka ai amyu masha ni a hpawng hta, shi hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela amyu masha ni e, nanhte a Hpan Madu a majaw kabu gara nga mu; Ziun a amyu masha ni e, nanhte a hkawhkam wa a majaw kabu gumrawng nga mu!
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a mying nsang hpe ka manawt let shakawn mu; chying bau ni hte tingse ni hpe dum nna shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw shi a amyu masha ni hta awng sharawng nga nna; shagrit shanem ai ni hpe awng padang hte shi shagrau sha-a nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang a amyu masha ni gaw shanhte a awng padang lam hta kabu gara lu mu ga; kabu gara ai hte shana tup, shanhte mahkawn mangoi nga mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Masha amyu baw ni hpe awng dang kau na matu hte amyu masha ni hpe ari jaw na matu mung,
  </para>
  <para style="p">
    <verse number="8" style="v" />shanhte a hkawhkam ni hte mung du, salang ni hpe hpri sumri ni hte gyit nna, Karai Kasang a mungga hte maren, amyu baw ni hpe ari jaw na matu mung, Karai Kasang a amyu masha ni gaw shanhte a lata hta dai ai nhtu ni hpe lang da nna, nsen kaba hte jahtau let, Karai Kasang hpe shanhte shakawn mu ga. Ndai gaw Karai Kasang a amyu masha ni a awng padang lam rai nga ai. Dai Madu hpe shakawn mu!
  </para>
  <chapter number="150" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu hpe shakawn mu! Shi a Nawku Htingnu hta Karai Kasang hpe shakawn mu! Sumsing lamu hta shi a daru magam n-gun hpe shakawn mu!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi galaw dan sai mauhpa magam bungli a matu shi hpe shakawn mu. Shadawn n dang lu ai shi a galu kaba galu kaba ai amu hpe, shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pahtau ni hte shi hpe shakawn garu mu. Tingse daw raw ni hte shi hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chying bau dum ai hte ka manawt let, shi hpe shakawn kungdawn mu. Tingse ni hte sumpyi ni hpe dum let shi hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shup sheng ni hte shi hpe shakawn kungdawn mu. Grau ngoi gara ai shup sheng ni hte shi hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nsoi nsa rawng ai ni yawng hte e, dai Madu hpe shakawn kungdawn nga mu! Dai Madu hpe shakawn mu!
  </para>
</usx>
