<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Ningpawt Ninghpang</book>
  <para style="h">Ningpawt Ninghpang</para>
  <para style="toc1">Ningpawt Ninghpang</para>
  <para style="toc2">Ningpawt Ninghpang</para>
  <para style="mt">Ningpawt Ninghpang</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shawng ningpawt e, Karai Kasang gaw ninggawn tawa hpe hpan da yang,
  </para>
  <para style="p">
    <verse number="2" style="v" />ginding aga gaw hkrang kata akrin akraw rai nga ai. Yawng mayawng hpe ka-up da ai dai wu kadu ai nammukdara gaw sin mak ai nsin hta rawng nga ai hte Karai Kasang a Wenyi mung hka hpung ni a ntsa e shamu hkawm nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Karai Kasang gaw, “Nhtoi tai u ga” ngu yang, nhtoi pru wa nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang mung dai hpe shi mu nna awng sharawng nga ai. Dai hpang shi gaw nhtoi hpe nsin kaw nna ginhka karan kau wu ai,
  </para>
  <para style="p">
    <verse number="5" style="v" />shi gaw nhtoi hpe “Shani” nsin hpe “Shana” ngu nna shamying wu ai. Shana gaw lai mat wa nna jahpawt du nga sai, dai gaw langai ya nhtoi rai nga sai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpang Karai Kasang gaw, “Hka hpungnung hpe karan nna hka hte hka lahkawng brang karan na matu lamu madin nga u ga,” ngu nna hkang dat wu yang dai mung byin nga sai. Dai rai nna Karai Kasang gaw lamu madin hpe galaw nna madin kata e nga ai hka hte madin ntsa e nga ai hka hpe karan da wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw lamu madin hpe “Sumsing lamu” ngu nna shamying wu ai. Shana gaw lai mat wa nna jahpawt du nga sai, dai gaw lahkawng ya nhtoi rai nga sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang Karai Kasang gaw, “Lamu kata e nga ai hka hpung ni shara mi hta shinggyin hpawng nga u ga, shaloi hkarang ga dawng pru wa na ra ai,” ngu nna hkang dat wu yang, dai mung byin nga sai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw dai hkarang ga hpe “Ginding aga,” ngu nna shamying nhtawm shinggyin hpawng nga ai hka hpung ni hpe “Panglai” ngu nna shamying da wu ai. Karai Kasang gaw dai hpe mu nna awng sharawng nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang shi gaw, “Nsi naisi li rawng ai nai mam ni hte asi si ai namsi namsaw hpun amyu yawng hte hpe aga hta na shapraw ya u ga,” ngu nna hkang dat wu yang, dai mung byin nga sai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna aga gaw hpun amyu hkum sumhpa yawng hte hpe shapraw wu ai; Karai Kasang gaw dai hpe mu nna awng sharawng nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shana gaw lai mat wa nna jahpawt du nga sai, dai gaw masum ya nhtoi rai nga sai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpang Karai Kasang gaw, “Shani hte shana hpe karan ginhka na matu mung, shani nhtoi, shaning nhtoi hte du hkra ladaw a aten ladaw langa hpe madun dan na matu mung, lamu ntsa e nhtoi ni dan pru wa mu ga;
  </para>
  <para style="p">
    <verse number="15" style="v" />dai ni gaw ginding aga ntsa e nhtoi jaw ya na matu lamu e htoi ya nga na ra ai,” nga nna hkang da wu ai hte dai mung byin nga sai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna Karai Kasang gaw nhtoi hkum kaba lahkawng hpe hpan da nu ai hte ajan gaw shani hpe up nna shata gaw shana hpe up nga ai, shi gaw shagan ni hpe mung galaw da nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw ga ntsa e htoi tu ya na matu mung,
  </para>
  <para style="p">
    <verse number="18" style="v" />shani hte shana hpe up na matu hte nhtoi hte nsin hpe karan ginhka na matu mung tawn da wu ai. Karai Kasang gaw dai amu hpe mu nna awng sharawng nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shana gaw lai mat wa nna jahpawt du nga sai, dai gaw mali ya nhtoi rai nga sai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hpang Karai Kasang gaw, “Nsoi nsa rawng nna hkrung nga ai baw wunawng wuwa gaw hka hpung ni hta kanawng nga nna, ntsa malen u ni mung nbung nga ai lamu ntsa hkan hpring nga mu ga,” nga nna hkang da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai rai nna, Karai Kasang gaw hka hta rawng nna kanawng hkawm nga ai amyu shagu hpe mung, panglai numraw kaba ni hpe mung, ntsa malen u amyu baw hkum sumhpa ni hpe mung hpan da wu ai. Karai Kasang gaw dai amu hpe mu nna awng sharawng nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi gaw dai ni yawng hpe shaman ya nhtawm hka hta rawng ai hkrung mahkrung ni mayat maya wa nna panglai hka hta hpring wa mu, ntsa malen u ni mung law htam wa mu, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shana gaw lai mat wa nna jahpawt du nga sai, dai gaw manga ya nhtoi rai nga sai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hpang Karai Kasang gaw, “Ginding aga gaw nsoi nsa rawng nna ni ai hte zai ai, kaji ai hte kaba ai dusat amyu hkum sumhpa ni yawng hpe shapraw u ga,” ngu nna hkang dat wu yang, dai mung byin nga sai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai rai nna Karai Kasang gaw dai yawng mayawng hpe galaw da nu ai hte dai amu hpe shi mu nna awng sharawng nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hpang Karai Kasang gaw, “Ya chyawm gaw shinggyim masha ni hpe anhte hpan da na ga ai. Shanhte gaw anhte zawn rai nna anhte hte bung na mara ai, shanhte gaw nga ni hpe mung, ntsa malen u ni hpe mung, ni ai, zai ai, kaji ai, kaba ai n nga dusat dumyeng ni yawng hpe a up nga na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai rai nna Karai Kasang gaw shinggyim masha ni hpe hpan da nna shi hte nan bung wa hkra shan hpe galaw da nga ai. Shi gaw numsha hte lasha hpe hpan da let,
  </para>
  <para style="p">
    <verse number="28" style="v" />shan hpe shaman ya nna, “Kashu kasha law law shaprat mu, shaloi nan a matu mara ni aga ting hta shanu nga lu nna, dai hpe up hkang lu na mara ai. Ngai gaw nan hpe nga ni hpe mung, ntsa malen u ni hpe mung, dusat nhprang ni hpe mung up hkang na ahkang jaw da nga nngai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nan sha na matu nsi naisi li rawng ai nai mam amyu yawng hte asi si ai hpun amyu yawng ngai jaw da made ai;
  </para>
  <para style="p">
    <verse number="30" style="v" />rai ti mung matse labye dusat ni yawng hte ntsa malen u ni yawng a matu lu sha ngu na tsit lali ai tsingdu tsingman hte lap lap ai hpun lawn kasha ni hpe ngai jaw da se ai,” ngu nna tsun yang, dai mung byin nga sai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Karai Kasang gaw shi galaw da sai amu yawng mayawng hpe yu yu nna, grai myit sharawng awng nga wu ai. Shana lai mat wa nna jahpawt du nga sai, dai gaw kru ya nhtoi rai nga sai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi ninggawn tawa ting a amu gaw ngut kre nna hkum tsup nga sai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang gaw sanit ya nhtoi hta e, shi galaw nu ai amu magam hpe shangut shakre nna bungli galaw ai hpe jahkring da nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw sanit ya nhtoi hpe shaman ya nhtawm dai nhtoi hpe laksan shani hku masat da nga ai, hpa majaw nga yang, shi a hpan da ai amu hpe dai shani e shangut nna bungli galaw ai hpe jahkring da nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ndai hte gaw ninggawn tawa amu hpe kaning rai hpan da nga ai lam rai nga ai. Dai Madu Karai Kasang gaw ninggawn tawa hpe hpan hpajang da yang,
  </para>
  <para style="p">
    <verse number="5" style="v" />nawnam mung, nsi naisi hpa mung ginding aga ntsa e maku ku nga ai n rai, hpa majaw nga yang, shi gaw marang hpe mung garai n jahtu ai hte aga hpe yu lajang na masha kadai mung n nga nga ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />rai ti mung ga kata na hka rawt lung wa nhtawm ga ntsa ting hpe madit ya nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang dai Madu Karai Kasang gaw aga kaw nna ga loi mi hpe la nhtawm dai hte shinggyim hkrang shachyaw wu ai; shi a ladi hta hkrung ai nsoi nsa hpe shi kawut bang ya wu ai hte dai shinggyim masha gaw hkrung hpang wa nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang dai Madu Karai Kasang gaw sinpraw maga na Eden ngu ai shara hta sun langai hkai sharam tawn nhtawm dai shara hta shi shachyaw da sai shinggyim masha hpe tawn da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai sun hta tsit lali tsawm ai hpun amyu myu hpe shi tu shangun ai hte dai hta ja kat ai asi ni hpe mung si shangun nga ai. Dai sun a ka-ang e, asak jahkrung ya ai hpun hte kaja ai hte n kaja ai lam mahkra hpe chye ginhka shangun ai hpun mung tu nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai sun hpe madit ya na matu Eden hta hka shi langai lwi pru nga ai; dai gaw Eden a shinggan maga de hka nu mali garan pru mat wa nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Langai ngu na hka nu gaw Pishun rai nna dai gaw Hawila mung grup lwi kawan mat wa ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />(Dai shara hta jet ai aja, grai taw nna manam hawm ai baw hpun naw hte manu dan ai lungseng ni rawng nga ai.)
  </para>
  <para style="p">
    <verse number="13" style="v" />Lahkawng ngu na hka nu gaw Gihon rai nga ai; dai gaw Hkusha mung grup yin hku lwi mat nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Masum ngu na hka nu gaw Asuri mung a sinpraw maga de lwi mat wa ai Tigri hka nu rai nga ai; mali ngu na hka nu gaw Uhprat hka nu rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang Madu Karai Kasang gaw dai hpe yu lajang na hte sin nga na matu dai masha hpe Eden hta tawn da wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw dai masha wa hpe, “Dai sun hta tu ai kaning re ai hpun hta na asi hpe rai tim sha mai nga ndai;
  </para>
  <para style="p">
    <verse number="17" style="v" />rai ti mung kaja ai hte n kaja ai hpe chye ginhka shangun ai hpun hta na asi hpe chyawm gaw nang n sha lu na ndai. Dai hpun kaw na nang sha ai rai yang, dai shani jang nang si na rin dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi dai Madu Karai Kasang gaw, “Dai shinggyim lasha gaw shi hkrai nga na n mai nga ai. Shi hpe karum shingtau na matu ram ging ai nrum ntau langai galaw na we ai,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai rai nna aga kaw na ga loi mi shi la nhtawm ashu ashan ni yawng hte ntsa malen u ni yawng hpe shachyaw wu ai. Dai hpang, dai ni hpe shi mying shingteng jaw ai hpe chye lu hkra nga, dai masha wa hpang de woi wa wu ai. Dai ni yawng mung mying shingteng hkam la nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna dai masha wa gaw ntsa malen u ni yawng hte dusat ni yawng hpe mying shamying wu ai; rai ti mung shi hpe karum na htap htuk ai manang shanhte hta na langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang dai Madu Karai Kasang gaw dai masha wa hpe yup kaba hte yup shangun nna, shi yup nga yang, dai masha wa a garep nra langai mi hpe shi shaw la nhtawm, ashan hte bai shatup ya wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi shaw la ai garep nra hte numsha langai mi hpe shachyaw wu ai rai nna dai masha wa kaw woi wa ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi dai masha gaw, “Ya, ndai gaw nye a hkum hte nan bung ai; Nye a nra hta na nra, nye a ashan hta na ashan rai nga ai. Shi a amying ‘Numsha’ rai nga ai; hpa majaw nga yang shi gaw lasha hta na shaw la ai rai nga ai,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai re ai majaw, lasha gaw shi a kanu yan kawa hpe kau da nhtawm shi a madu jan hte manoi nga na rai nna, shan lahkawng gaw hkum shan langai sha tai lu na mara ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai lasha hte numsha yan singgu krin rai nga ma ti mung, shan shada n kaya ma ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai lapu gaw dai Madu Karai Kasang e galaw da nu ai dusat hta zai hpaji rawng htum nga ai. Dai lapu gaw numsha hpe, “Ndai sun hta tu ai gara hpun hta na asi hpe rai tim, nan n sha lu na rai myit dai, nga nna Karai Kasang nan hpe kaja wa tsun a ni?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai numsha gaw, “Ndai sun a ka-ang hta tu ai hpun hta lai nna, gara hpun na asi hpe mung an sha mai nga ga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang gaw an hpe dai hpun a asi hpe n sha hkrup na matu mung, dai hpe hkra pyi n sa hkra na matu mung, tsun da mani ai; dai hpe an sha hkrup ai rai yang, an si na ga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lapu gaw, “Dai ga teng nga ai n rai; nan si lu na myit dai n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai asi hpe nan sha ai shaloi Karai Kasang zawn nan tai wa nna kaja ai hte n kaja ai lam hpe nan chye ginhka wa na hpe shi chye ai majaw Karai Kasang tsun da ai re,” nga nna bai htan wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpun gaw kade wa tsawm nga ai mung, de a asi hpe sha dat yang kade wa mai kaja nga ai mung, dai gaw hpaji rawng ai wa tai wa yang kade sha mauhpa rai nga ai hpe shi myit lu nga ai hpe mung, dai numsha mu wu ai. Dai majaw dai hpun hta na asi di la nna sha wu ai. Dai hpang shi gaw nkau mi hpe shi a madu wa hpe jaw wu ai rai nna shi mung sha kau nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai asi hpe shan sha ngut ai shaloi jang, chye na hkawn hkrang ai hpaji shan lu la nna, shan singgu krin rai nga ma ai hpe dum chye ma ai; dai majaw shan gaw lakum lap ni hpe chywi matut nna tinang hkum ni hpe magap da ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shan gaw dai shana de na aten hta e dai Madu Karai Kasang sun hta sa hkawm nga ai hpe na ma ai; shan gaw Karai Kasang a myi man kaw nna makoi lu hkra nga, hpun ni a kata e gawp nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung Madu Karai Kasang gaw shinggyim lasha hpe, “Nang kanang nga nga n ta?,” ngu nna shaga wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw, “Ndai sun e na a nsen hpe ngai na nna, singgu shakrin rai nga nngai majaw ngai hkrit nna gawp makoi nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang gaw, “Nang singgu shakrin rai nga ndai hpe kadai wa tsun dan a ta? Hkum sha ngu nna nang hpe ngai tsun da ai hpun hta na asi hpe nang sha kau nu ni?,” nga nna san wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shinggyim lasha gaw, “Ndai shara e ngai hte rau nga na matu nang ap ya ai numsha gaw ngai hpe namsi jaw nna dai hpe ngai sha kau ni ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu Karai Kasang gaw, “Nang hpa majaw ndai amu hpe galaw kau nu ni?,” ngu nna numsha hpe san wu ai. Shi gaw, “Dai namsi hpe sha na matu, lapu mahtang ngai hpe lau la ni ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpang Madu Karai Kasang gaw lapu hpe, “Ndai amu a majaw nang ari hkrum sha na rin dai; dusat yam nga ni yawng hta nang chyu sha ndai dagam dala ga hkrum na ndai. Nang gaw ya kaw nna na a kan hte gumrawt hkawm lu na ndai, nang hkrung nga ai nhtoi hte yang, ga nhpu sha lu na rin dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw nang hte shinggyim numsha a lapran hta mung, na a amyu matu hte shi a myu matu hpe mung n ju n dawng shangun nna galoi mung gumlau hpyen atai shangun nga na nngai. Shi a amyu matu gaw na a baw hpe abrep nna nang mung shanhte a lahtin hpe achye na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw numsha hpe mung, “Na a na-um nasin re ai tsin-yam hte shinggyim machyi ai nchyi nmu lam hpe ngai shalaw ya na nngai. Dai zawn hkrum hkra nga ti mung, nang gaw na a madu wa hta myit manoi nga nna, shi mung na a ntsa e up nga na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw lasha hpe mung, “Na madu jan a ga hpe nang madat nna, hkum sha ngu nna ngai tsun da ai hpun hta na asi hpe nang sha kau nit dai. Nang galaw kau nit dai amu a majaw aga gaw dagam dala hkrum na ra ai. Nang hkrung nga ai hte yang bungli shaja sha ra nna na a matu lusha hpe mung dai hta alaw alam galaw shapraw ra na ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hta na aju ni hte atsing ni tu pru wa nna, nam na namlaw namlap ni hpe nang sha lu na rin dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ga hte nang shachyaw da ai hkrum nga ndai majaw ga de nang bai nhtang wa ai aten du hkra, ga kaw nna hpa hpe mung tu shaprut lu na matu nang gaw salu salat hte bungli shaja sha ra na ndai. Nang gaw ga hte shachyaw da nga ndai majaw ga bai tai na rin dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adam gaw shi a madu jan hpe Ewa ngu nna shamying wu ai; hpa majaw nga yang shi gaw shinggyim masha ni yawng a kanu rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai Madu Karai Kasang gaw Adam hte shi a madu jan a matu shanhpyi hpun palawng galaw nna shan hpe shabu jahpun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hpang Madu Karai Kasang gaw, “Ya chyawm gaw masha wa gaw anhte hta na langai mi zawn tai wa nna kaja ai hte n kaja ai a machye machyang hpaji hpe lu la nga nu ai. Shi gaw htani htana ahkrung nga na matu, asak jaw ya ai hpun a asi hpe di sha na ahkang lu nu ai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai rai nna Madu Karai Kasang gaw shan hpe Eden sun kaw nna shapraw kau nhtawm shan a hkrang shachyaw la hkrum ai ga hta shan hpe galaw sha shangun wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hpang shi gaw sun a sinpraw maga de ahkrung nga ai hkrung kanu ni hte man maga shagu de shi chyu nwat shadang chye ai wan nhtu hpe tawn da wu ai. Dai gaw asak jahkrung ya ai hpun de ni sa wa ai kadai hpe mung hkap shingdang na matu rai nga ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Adam gaw shi a madu jan hte kanawn nna, shi hta na-um nasin hkum tai wa sai. Shi gaw shadang sha langai shangai nhtawm, “Dai Madu karum la ai a jaw e, shadang sha langai ngai lu se ai,” nga nna tsun wu ai. Dai rai nna shi gaw dai shadang sha hpe Ka-in ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw hpang e mung Abela ngu ai shadang sha hpe bai shangai wu ai. Abela mahtang sagu rem sha ai wa rai nna Ka-in gaw yi hkauna galaw sha ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aten ram ram na ai hpang, Ka-in gaw dai Madu hpe hkungga nawng jau na matu shi a nsi naisi nkau mi la sa nna dai hpe jaw wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hpang Abela mung shi a sagu hpung hta na shawng hkrat ai sagu kasha hpe la sa nhtawm dai hpe sat nna, dai ni hta na grau tsawm ai daw hpe hkungga nawng jau ya na hkungga a matu jaw ya wu ai. Dai Madu gaw Abela hte shi a hkungga hpe awng sharawng ya wu ai;
  </para>
  <para style="p">
    <verse number="5" style="v" />rai ti mung shi gaw Ka-in hte shi a hkungga hpe hpa n sawn ya wu ai. Ka-in masin ja ja kahtet ai hte pawt sindawng nga lu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpang dai Madu gaw Ka-in hpe, “Nang hpa rai pawt nga n ni? Nang hpa majaw myi man sum nga n ta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang jaw ai amu galaw yang gaw nang myi man hpaw lu na rai nga ndai, rai ti mung nang gaw n hkru n shawp ai amu galaw kau nit dai majaw yubak gaw na a chyinghka e makun hpum nga ai. Dai gaw nang hpe up hkang mayu ti mung, dai hpe nang awng dang kau lu ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang Ka-in gaw shi a kanau Abela hpe, “Pa hkan e hkawm chyai ga,” ngu nna tsun wu ai. Pa hkan e shan nga hkawm nga yang, Ka-in gaw shi a kanau hpang de kayin sa nna shi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu gaw Ka-in hpe, “Na a kanau Abela kanang rai nga a ta?,” ngu nna san wu ai. Shi mahtang, “Ngai n chye nngai. Ngai gaw nye a kanau wa hpe hkan lakawn ai wa zawn nawn nga n ni?,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hpang dai Madu gaw, “Nang hpa rai ndai hkrit hpa amu hpe galaw kau nu ni? Na a kanau a asai gaw matai htang ya na matu shaga ai nsen zawn aga kaw nna ngai hpang de jahtau nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang shi hpe sat ai shaloi, shi a asai hpe hkap la na matu, lamu ga gaw shi a n-gup mahka ai hte na kanau a asai lu kau nu ai. Nang gaw dagam dala hkrum nna yi hkauna galaw ti mung mi na shadang du lu na ndai n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a hkai nmai ni hpe gat hkai ai rai yang, aga kaw nna hpa mung tu na ra ai n rai; nang gaw ginding aga ntsa e nta n lu ai sha brak hkawm ai wa tai na rin dai.”
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka-in gaw dai Madu hpe, “Ndai ari gaw nye a matu n dang hkam lu hkra, nau wa kaba la nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang gaw ngai hpe ndai lamu ga kaw nna mung, na a man kaw nna mung shaden kau nga ndai. Ngai gaw ginding aga ntsa e nta n lu ai sha brak hkawm ai wa tai wa nna ngai hpe mu tam ai kadai wa mung ngai hpe sat kau na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, dai Madu gaw, “N rai law, marai langai ngai nang hpe sat ai rai yang, yubak ari htang sanit jaw ai hkrum na wu ai,” ngu nna shi hpe tsun wu ai. Dai majaw dai Madu gaw Ka-in hpe mu ai ni kadai mung shi hpe n sat lu mu ga, shi hpe masat shakap tawn da ya wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai Ka-in gaw dai Madu a man kaw nna pru mat wa nhtawm Eden a sinpraw maga e nga ai “Brak Hkawm Ai Shara,” mying ai mung hta nga nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka-in hte shi a madu jan gaw shadang sha langai lu ma ai rai nna, shi hpe Enuk ngu nna shamying ma ai. Dai hpang Ka-in gaw mare langai de nna dai hpe shi a shadang sha a amying hku hkan nna Enuk ngu shamying da nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Enuk gaw Irad mying ai shadang sha langai lu ai, shi gaw Mehuyaela a kawa rai nga ai; Mehuyaela gaw Mehtushaela mying ai shadang sha langai lu ai, shi gaw Lamek a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lamek gaw Ada hte Zila ngu ai madu jan lahkawng lu nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ada gaw Yabala hpe shangai wu ai, shi gaw janghpang sum ni hta nga nna yam nga rem sha ai ni a kaji kawa tai wa sai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a kanau gaw Yubala rai nna, tingse sumpyi chye dum ai ni yawng a kaji kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zila mahtang magri mang hte hpri arai yawng hpe chye galaw ai ndup sama Htubala Ka-in hpe shangai wu ai. Htubala Ka-in a kajan gaw Nama rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lamek gaw shi a madu jan yan hpe, “Ada hte Zila yan e, nye a ga madat mu; Shabrang langai mi ngai hpe gamai ai majaw ngai shi hpe sat kau ni ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka-in hpe sat ai wa yubak matai htang sanit hkrum ai rai yang; Ngai hpe sat ai wa kadai rai ti mung, yubak matai htang sanit shi sanit hkrum lu na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Adam hte shi a madu jan hta kaga shadang sha bai lu ma ai. Madu jan gaw, “Karai Kasang gaw Ka-in e sat kau ai Abela a shara hta shadang sha langai jaw ni ai,” ngu nna tsun wu ai. Dai rai nna shi hpe Shet ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shet mung shadang sha langai lu ai rai nna shi hpe Enusha ngu nna shamying wu ai. Dai aten kaw nna nawku daw jau ai hta dai Madu a chyoi pra ai mying ningsang hpe amyu masha ni lang hpang wa masai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ndai gaw Adam a amyu matu ni a labau lasang lam rai nga ai. (Karai Kasang shinggyim masha ni hpe hpan da ai shaloi shi hkum nan hte bung hkra galaw da nu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw numsha hte lasha hpe hpan da nna dai ni hpe shaman ya nhtawm shanhte hpe, “Shinggyim Masha,” ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Adam a asak 130 ning du ai shaloi shi hte bung ai shadang sha langai shaprat nna dai wa hpe Shet ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hpang Adam gaw asak 800 ning naw nga lu wu ai. Shi gaw kaga shayi shadang sha ni,
  </para>
  <para style="p">
    <verse number="5" style="v" />hpe mung shaprat nhtawm asak 930 ning hta si mat sai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shet gaw asak 105 ning du ai shaloi, shadang sha Enusha hpe shaprat wu ai,
  </para>
  <para style="p">
    <verse number="7" style="v" />dai hpang asak 807 ning du hkra naw nga wu ai. Kaga shayi shadang sha ni hpe mung shi shaprat nna,
  </para>
  <para style="p">
    <verse number="8" style="v" />shi a asak 912 ning hta si mat sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Enusha a asak 90 ning du ai shaloi shadang sha Kenan hpe shaprat wu ai,
  </para>
  <para style="p">
    <verse number="10" style="v" />dai hpang shi gaw asak 815 ning du hkra naw nga wu ai. Shi gaw kaga shayi shadang sha ni hpe mung shaprat nna,
  </para>
  <para style="p">
    <verse number="11" style="v" />shi a asak 905 ning hta si mat sai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kenan a asak 70 ning du ai shaloi, Mahalalela ngu ai shadang
  </para>
  <para style="p">
    <verse number="13" style="v" />sha langai hpe shaprat wu ai; dai hpang shi a asak 840 ning du hkra naw nga lu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi mung kaga shayi shadang sha ni hpe shaprat nna shi a sak 910 ning hta si mat sai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahalalela a asak 65 ning du ai shaloi, shadang sha Yared hpe shaprat wu ai,
  </para>
  <para style="p">
    <verse number="16" style="v" />dai hpang shi a asak 830 ning du hkra naw nga lu ai. Shi mung kaga shayi shadang sha ni hpe shaprat nna,
  </para>
  <para style="p">
    <verse number="17" style="v" />shi a asak 895 ning hta si mat sai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yared a asak 162 ning du ai shaloi, shadang sha Enuk hpe shaprat wu ai,
  </para>
  <para style="p">
    <verse number="19" style="v" />dai hpang shi a asak 800 ning du hkra naw nga lu ai. Shi mung kaga shayi shadang sha ni hpe shaprat nna,
  </para>
  <para style="p">
    <verse number="20" style="v" />shi a asak 962 ning hta si mat sai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Enuk a asak 65 ning du ai shaloi, shi gaw shadang sha Mehtusela hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hpang, shi gaw Karai Kasang hte 300 ning tup rau hkawm rau sa ai hte kaga shayi shadang sha ni hpe mung shaprat wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw asak 365 ning du hkra nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi hkrung nga ai hte yang Karai Kasang hte kanawn mazum nga wu ai, dai hpang shi n nga mat sai, hpa majaw nga yang Karai Kasang shi hpe woi la kau nga sai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mehtusela a asak 187 ning du ai shaloi, shi gaw shadang sha Lamek hpe shaprat wu ai; dai hpang shi a asak 782 ning du hkra naw nga nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi mung kaga shayi shadang sha ni hpe shaprat nna,
  </para>
  <para style="p">
    <verse number="27" style="v" />shi a asak 969 ning hta si mat sai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lamek a asak 182 ning du ai shaloi, shi hta shadang sha langai lu ai rai nna,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Dai Madu e dagam kau ai ga hta, ndai ma gaw anhte hkrum ai laja lana re ai amu bungli ni yawng hta na anhte a matu ngwi pyaw ai lam sa ya na ra ai,” ngu nna tsun wu ai; dai rai nna shi hpe Noa ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lamek gaw 595 ning du hkra naw nga lu ai; shi mung kaga shayi shadang sha ni hpe shaprat nna,
  </para>
  <para style="p">
    <verse number="31" style="v" />shi a asak 777 hta si mat sai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Noa a asak 500 ning du ai hpang, shi a shadang sha masum rai nga ai Shem, Ham hte Yahpet ni hpe shaprat wu ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shinggyim masha gaw mungkan ga ting hta chyam bra wa nna, shayi sha ni shangai wa ma ai shaloi,
  </para>
  <para style="p">
    <verse number="2" style="v" />sumsing shadang sha ni ni gaw dai shayi sha ni tsawm htap nga ma ai hpe mu ma ai rai nna, shanhte yu ra nga ma ai hte maren la ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hpang dai Madu gaw, “Shinggyim masha ni hpe ngai htani htana ahkrung nga shangun na n rai; shanhte gaw si chye ai ni rai nga ai. Shanhte gaw ya kaw nna asak latsa e hkun ning hta n jan ai sha nga lu na rai ma ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai prat e mung, dai prat a hpang e mung, dai shinggyim numsha ni hte Karai Kasang a shadang sha ni a aru arat ni gaw ginding aga ntsa e grai galu kaba ai ni rai ma ai. Shanhte gaw moi prat kaw nna magrau grang ai share ninghkrin ni hte kajai gumhkawng ai masha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ga ntsa na shinggyim masha shagu hte gaw kade wa n shawp n kap nga ai hte aten shagu hta shanhte a myit mang ai lam kade wa n hkru nga ma ai hpe dai Madu mu ai shaloi,
  </para>
  <para style="p">
    <verse number="6" style="v" />shi shanhte hpe hpan da nna ginding aga ntsa e shanu nga shangun ai hpe shi a kraw lawang e yawn nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi grai wa myit malai lu ai hte, “Ngai hpan da sai ndai shinggyim masha ni hpe mung, dusat yam nga hte ntsa malen u ni hpe mung atsai awai di kau na nngai; hpa majaw nga yang, dai ni hpe ngai hpan da ai majaw ngai myit yawn nga nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung dai Madu chyawm gaw Noa hpe awng sharawng nga wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Da ndai gaw Noa a maumwi rai nga ai. Shi gaw shadang sha masum lu ai; dai ni gaw Shem, Ham, hte Yahpet ni rai nga ai. Noa gaw yubak mara hpa mung n lu ai hte shi a aten hta shi chyu sha mai kaja ai wa rai nga ai. Shi gaw Karai Kasang hte rau kanawn mazum let hkrung nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung shinggyim masha shagu gaw Karai Kasang a man e n hkru nga ma ai hte kashun kashe du daw sai hkaw amu gaw shara shagu hkan chyam bra nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang gaw mungkan ga hpe mada yu wu yang, dai gaw n hkru n shawp ai amu hte hpring nga ai hpe mu wu ai; hpa majaw nga yang, shinggyim masha ni mahtang n hkru n shawp ai asak hkrun lam hta hkawm sa nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang gaw Noa hpe, “Ndai shinggyim masha ni yawng hpe jahtum kau na matu, ngai daw dan da se ai. Shanhte a kashun kashe du daw sai hkaw amu ni gaw ndai mungkan hta hpring chyat nga ai majaw, shanhte hpe ngai atsai awai shamyit kau na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a matu kaja ai hpun ngau hte sanghpaw li shachyaw u; dai hta gawk ni bang nna, de a kata hte shinggan maga de mung hpun naw chya da u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpe galu maga de pe 450, nda maga de pe 75 hte tsaw maga de pe 45 di nna galaw u.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai sanghpaw li hta hkuwawt langai hpaw nhtawm hkuwawt hte nhkrem ni a lapran e yungnu 18 gang ai shara tawn da u. Tsang masum rawng ai li nang shachyaw nhtawm nhkrem e numgaw chyinghka langai waw na rai ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai mung asak hkrung ai ni yawng hte hpe shamyit kau na matu ga ntsa de hka kaba hte sha-u sha-ing dat na nngai. Ga ntsa na nga manga hte gaw si htum mat na mara ai,
  </para>
  <para style="p">
    <verse number="18" style="v" />rai ti mung, nang hte chyawm gaw ga shaka ngai tawn da na nngai. Nang hte na a madu jan mung, na a shadang sha ni hte shanhte a madu jan ni mung sanghpaw li kata de shang wa mu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dusat yam nga amyu shagu hte ntsa malen u amyu shagu hkrung nga na matu, dai ni hta na ayi ala ni hpe sanghpaw li kata de jashawn da u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang hte dai ni a matu malu masha hkum sumhpa yawng hpe htun da u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang shi hpe hkang da wu ai hte maren, lam shagu hte hpe shi galaw wu ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw Noa hpe, “Nang hte na a nta masha ni yawng dai sanghpaw li kata de shang manu; ndai mungkan ga yawng hta jaw ai amu galaw ai gaw nang chyu sha rai nga ndai hpe ngai mu se ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang hte rau san seng ai dusat yam nga shagu hta na ayi ala sanit nit; n san n seng ai dusat yam nga hta na chyawm gaw gup gup hpe sha nang jashawn na rai ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ntsa malen u amyu shagu hta na mung gup sanit hpe bang da na rai ndai. Dai amu hpe galaw u, shaloi ginding aga ntsa e bai pra wa na matu dai dusat yam nga amyu shagu hte ntsa malen u amyu shagu hte gaw hkrung nga na mara ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai ni kaw nna sanit ya du jang, shani mali shi ya, shana mali shi na tup, ga ntsa de ngai marang jahtu dat na nngai; shing rai ngai hpan da sai hkrung mahkrung mahkra hte hpe shamyit kau na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu hkang da sai hte maren, lam shagu hte hpe Noa galaw wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ginding aga ntsa e sha-u ing ai shaloi, Noa gaw 600 ning rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi hte shi a madu jan, shi a shadang sha ni hte shanhte a madu jan ni gaw sha-u sha-ing ai kaw nna lawt lu hkra nga, sanghpaw li kata de shang ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang hkang da nu ai hte maren, san seng ai hte n san n seng ai dusat yam nga amyu shagu hta na mung,
  </para>
  <para style="p">
    <verse number="9" style="v" />ntsa malen u ni hta na mung, ayi ala lahkawng hkawng, Noa hte rau dai sanghpaw li kata de shang wa ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai sanit ya nhtoi du jang, sha-u sha-ing ai gaw du sai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noa a asak kru tsa ning du ai shaning a shata lahkawng a shi sanit ya shani e nan, aga a kata de nga ai hka hpungtun ni yawng kapaw pru wa nna sumsing lamu na sha-u chyinghka ni hpaw malang mat wa ai hte,
  </para>
  <para style="p">
    <verse number="12" style="v" />shani mali shi ya, shana mali shi na tup, ga ntsa e marang ahtu nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai shani jang, Noa hte shi a madu jan, shan a shadang sha masum rai nga ai Shem, Ham, Yahpet ni hte shanhte a madu jan ni gaw sanghpaw li kata de shang ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte hte nawng ni ai, zai ai, kaji ai, kaba ai n nga dusat yam nga amyu shagu hte
  </para>
  <para style="p">
    <verse number="15" style="v" />ntsa malen u amyu shagu hte hta na ayi ala lahkawng hkawng hte gaw Karai Kasang hkang da sai hte maren,
  </para>
  <para style="p">
    <verse number="16" style="v" />Noa hte rau dai sanghpaw li kata de shang ma ai. Dai hpang dai Madu gaw Noa hpe kata e la sharawng da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai sha-u sha-ing ai gaw nhtoi mali shi ya tup matut ing nga ai rai nna, sanghpaw li shawaw mat wa na matu hka ni tung rawt wa nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hka gaw grau nna tung jat wa magang sanghpaw li gaw hka ntsa e yawng nang magang rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hka gaw grai tung lung wa ai rai nna tsaw htum ai bum ni hpe pyi lim kau nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hka gaw bum pungding kaw nna ntsa de pe 25 tawt hkra naw tung rawt nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ginding aga ntsa e shanu nga ai hkrung mahkrung shagu ngu na ntsa malen u mung, yam nga mung, shinggyim masha shagu mung si mat nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ginding aga ntsa na nsoi nsa rawng ai nga manga hte mung si mat ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai Madu gaw ga ningtsa na hkrung mahkrung mahkra ngu na shinggyim masha, yam nga hte ntsa malen u ni hpe atsai awai jahten kau wu ai. Noa hte dai sanghpaw li kata na shi hte rau rawng ai ni chyu sha ngam nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hka gaw nhtoi latsa e manga shi ya du hkra yawm mat nga ai n rai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw Noa hte shi hte rau sanghpaw li hta rawng nga ai yam nga ni yawng hpe malap kau wu ai n rai; shi gaw nbung wa shangun dat ai rai nna, dai hka gaw yawm hpang wa nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aga a kata de nga ai hka hpungtun ni hte sumsing lamu na sha-u chyinghka ni pat mat nga ai. Marang mung hpawng mat ai hte,
  </para>
  <para style="p">
    <verse number="3" style="v" />dai hka mung nhtoi 150 ya rai jang, angwi ngwi sha yawm mat wa nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai sanghpaw li mung shata sanit a nhtoi shi sanit ya shani e, Ararat ngu ai bum mayan ntsa e mara nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hka gaw shata shi du hkra yawm hkrai yawm wa nna shata shi a praw langai ya shani hta bum pungding ni dawng pru wa nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya nhtoi mali shi ya lai jang, Noa gaw hkuwawt chyinghka hpe hpaw nna uhka hpe dat dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai uhka gaw ga ntsa e hka tsep kawp hkyet mat ai aten du hkra, bai n nhtang wa ai sha, pyen kahkrang hkawm nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shing rai nga yang, Noa gaw hka yawm mat wa sai hpe chye lu hkra nga, hkrudu hpe mung dat dat yu wu ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />rai ti mung, hka gaw ga ntsa ting hta naw ing nga ai rai nna, hkrudu shi dung sa na shara n mu wu ai. Dai u mung sanghpaw li de bai nhtang wa ai. Noa mung lata ladawn nna hkrudu hpe hkap jum la nhtawm sanghpaw li kata de jashawn la wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai kaw nna nhtoi sanit ya du hkra, shi naw la nhtawm hkrudu hpe bai dat dat wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai u gaw tsanlun lap katsing hpe di makrang nna shana de maga, shi kaw bai nhtang wa wu ai. Dai rai nna hka yawm mat sai hpe Noa chye wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hpang sanit ya du hkra shi bai la yu nhtawm, hkrudu hpe kalang mi bai dat dat wu yang, dai lang hta hkrudu bai n wa mat nga sai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Noa a asak 601 ning du ai shawng shata a praw langai ya shani hta, dai hka hpungtun gaw hkyet mat sai. Noa mung sanghpaw li magap hpaw nna grup yin de mada yu wu yang, aga gaw hkraw wa nga ai hpe mu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai shata lahkawng a hkun sanit ya shani e, ginding aga gaw atsai sha hkraw mat nga sai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Karai Kasang gaw Noa hpe, “Nang hte na a madu jan mung,
  </para>
  <para style="p">
    <verse number="16" style="v" />na a shadang sha ni hte shanhte a madu jan ni mung, dai sanghpaw li kaw nna pru wa mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ntsa malen u ni yawng hte yam nga ni hpe mung nang hte rau shapraw u; shing rai dai ni gaw ginding aga ting hta chyam bra wa nna law htam mayat maya wa mu ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna Noa gaw shi a madu jan hte mung, shi a shadang sha ni hte shanhte a madu jan ni hte mung sanghpaw li kaw na pru wa ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yam nga ni hte ntsa malen u ni yawng mung tinang a amyu hte tinang dai sanghpaw li hta na pru wa nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noa gaw dai Madu a matu tawn hkungri galaw nhtawm, san seng ai yam nga hte ntsa malen u amyu shagu hte hpe la nna tawn hkungri ntsa e, hkum dingnawng wan nat hkungga nawng jau wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hkungga a manam pyaw ai sangau gaw dai Madu hpe awng sharawng shangun nga ai rai nna dai Madu gaw, “Shinggyim masha e galaw ai amu a majaw, ginding aga hpe ngai galoi mung dagam kau na ni ai n rai; shi a myit mang ai lam ni gaw shi naw kaji nga ai aten kaw nna n shawp nga ai hpe ngai chye nngai. Ndai lang ngai galaw kau ni ai zawn asak rawng ai hkrung mahkrung ni yawng hpe ngai galoi mung bai jahten na ni ai n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ginding aga grin nga dingsa, nli gat ai aten hte shu la ai aten, anga nga na ra ai. Bai kashung ai hte kahtet ai, nlum ta hte nshung ta, shani hte shana mung tut nawng agrin nga na ra ai,” nga nna shi a kraw e tsun nga ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw Noa hte shi a shadang sha ni hpe shaman ya nna, “Kashu kasha law law shaprat mu, shaloi nanhte a aru arat ni mungkan ting hta shanu nga lu na mara ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dusat yam nga ni mung, ntsa malen u ni hte hka kata na nga ni yawng mung nang hpe hkrit hkungga na mara ai. Dai ni yawng hpe na a lata hta ap da ya nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya chyawm gaw, dai ni hpe mung, tsit lali ai namlaw namlap ni hpe mung nanhte sha lu na myit dai; nanhte a matu lusha tai u ga she, dai yawng mayawng nanhte hpe ngai jaw da nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lam langai mi gaw asai naw rawng ai ashan hpe nanhte sha lu na myit dai n rai; dai asak gaw asai hta rawng nga ai majaw ndai lam hpe ngai hkum da nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Marai langai ngai masha a asak hpe la kau ai rai yang, shi gaw ari jaw ai hkrum na rai wu ai. Shinggyim masha a asak hpe hkra ai dusat yam nga hpe mung si ari ngai jaw na we ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang gaw shinggyim masha hpe shi hte maren bung hkra hpan da nga sai, dai rai nna masha langai ngai hpe sat ai wa kadai rai ti mung shi hkum hpe marai langai ngai e sat kau ai hkrum nga u ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Nanhte gaw kashu kasha law law shaprat lu na rai myit dai, shaloi nanhte a aru arat ni mungkan ga ting hta shanu nga lu na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang gaw Noa hte shi a shadang sha ni hpe,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ya chyawm gaw nang hte na a ru arat ni hte mung,
  </para>
  <para style="p">
    <verse number="10" style="v" />hkrung mahkrung yawng hte mung, ntsa malen u ni hte dusat yam nga ni yawng hte nang hte rau sanghpaw li kaw na pru wa ai amyu shagu hte hte mung, nye a ga shaka hpe tawn da nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ndai ga ni hte hpawn nye a ga shaka hpe nanhte hte ngai tawn nngai; Dai gaw sha-u a majaw hkrung mahkrung ni yawng jahten kau ai galoi mung bai n hkrum na hte sha-u hte ginding aga hpe galoi mung bai n jahten kau na ngu nna ngai ga sadi jaw ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanhte hte mung, hkrung mahkrung yawng hte mung, ngai tawn da nga ai dai htani htana hte seng ai ga shaka a kumla gaw,
  </para>
  <para style="p">
    <verse number="13" style="v" />sumwi ni hta nye a n-goila tum hpe ngai tawn da nga nngai. Dai gaw mungkan ga hte tawn da ai nye a ga shaka kumla tai na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lamu mung shangun nna dai n-goila tum gaw sumwi hta dan pru ai shaloi,
  </para>
  <para style="p">
    <verse number="15" style="v" />nanhte hte dusat yam nga ni yawng hpe sha-u hte hkrung mahkrung ni yawng hpe galoi mung bai n jahten kau na ngu ai, nye a ga sadi hpe ngai dum nga na nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sumwi ni hta dai n-goila tum dan pru wa ai shaloi, dai hpe ngai yu nna, ngai hte ginding aga ntsa e shanu nga ai hkrung mahkrung ni yawng a lapran e tawn da ai dai htani htana hte seng ai ga shaka hpe dum nga na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai gaw hkrung mahkrung mahkra hte ngai shaka tawn da ai ga sadi a kumla rai nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sanghpaw li na pru wa ai Noa a shadang sha ni gaw Shem, Ham hte Yahpet ni rai ma ai. (Ham mahtang Hkanan a kawa rai nga ai.)
  </para>
  <para style="p">
    <verse number="19" style="v" />Ndai Noa a shadang sha ni masum hte gaw mungkan ga na amyu masha ni yawng a kaji kawa ni rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noa gaw sun hkauna galaw sha ai wa rai nna, sabyi sun shawng hkai ai wa mung rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sabyi ntsin nkau mi hpe shi lu ngut ai hpang, shi nang nga ai rai nna hpun nba ni hpe raw kau nhtawm shi a sum hta shakrin taw nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hkanan a kawa Ham gaw shi a kawa singgu krin rai nga ai hpe mu jang, shinggan de pru nhtawm shi a kahpu yan hpe sa tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hpang Shem hte Yahpet gaw hpun nba la nhtawm, tinang a lahpa ni hta mara da nga ma ai. Shan mung sum de htingnut sa wa nna kawa hpe magap ya mu ai; kawa a singgu krin hpe n mu lu u ga, shan a myi man hpe kaga maga de yawng da mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Noa gaw sabyi nang ai kaw na bran wa yang, shi a kasha kaji wa shi hpe kaning di nu ai hpe chye wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi gaw, “Hkanan gaw dagam dala hkrum u ga! Shi gaw shi a kahpu kanau ni kaw mayam tai mat nu ga.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shem a Karai Kasang dai Madu hpe shakawn mu! Hkanan gaw Shem a mayam tai mat nu ga.
  </para>
  <para style="p">
    <verse number="27" style="v" />Karai Kasang gaw Yahpyet hpe maden shajat ya nu ga! Shi a aru arat ni Shem amyu bawsang ni hte rau shanu nga lu mu ga! Hkanan chyawm gaw Yahpet a mayam tai mat nu ga,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Noa chyawm gaw dai sha-u ing ai hpang, 350 ning du hkra naw hkrung nga nna,
  </para>
  <para style="p">
    <verse number="29" style="v" />shi a asak 950 ning hta si mat sai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ndai lam ni gaw Noa a shadang sha ni rai nga ai, Shem, Ham hte Yahpet ni a aru arat ni rai ma ai. Dai masum hte gaw sha-u ing ai hpang e shadang sha ni hpe shaprat ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya Yahpet a shadang sha ni gaw Goma, Magoga, Madai, Yawan, Htubala, Meshek hte Htira ni rai ma ai. Shanhte gaw shanhte a mying ni hta hkan nna ran yu wa ai amyu bawsang ni a kaji kawa ni tai wa masai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Goma a aru arat ni gaw Ashkena, Rihpat hte Htugama amyu masha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yawan a aru arat ni gaw Elisha, Spain, Kupru hte Roda amyu masha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw zunlawng ni hte panglai hkin-gau mayan hku shanu nga ai amyu masha ni a kaji kawa ni rai ma ai. Dai ni gaw Yahpet a aru arat ni rai nna, tinang mungdan ni hta abaw asang kaga ga rai shanu nga nhtawm, shaga ai ga mung kaga ga rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ham a shadang sha ni gaw Hkusha, Egutu, Libya hte Hkanan ni rai ma ai. Shanhte a mying ni hta hkan nna amyu bawsang ni a kaji kawa ni tai wa masai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkusha a matu mara ni gaw Seba, Hawila, Saphta, Rama hte Sabhtahka amyu masha ni rai nga ai. Rama a matu mara ni gaw Sheba, hte Dedan amyu masha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hkusha gaw Nimrod mying ai shadang sha hpe shaprat nna dai wa gaw mungkan ga hta shawng paw pru ai share ninghkrin kaba tai wa sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu a karum la ai gawp e, shi gaw jaugawng kaba rai nga ai rai nna masha ni mung, “Dai Madu gaw nang hpe Nimrod zawn jaugawng kaba shatai u ga!,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shawng na shi a mungdan hta Babelon mung na Babelon mare, Erek hte Ahkad mare masum mung lawm nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai mung kaw nna Asuri mung de shi sa wa nhtawm Ninewe, Rehubut Ira, hte Hkala mare ni hpe mung,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ninewe hte Hkala mare kaba yan a lapran na Resen mare hpe mung de da wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Egutu a matu mara ni gaw Ludi, Anam, Lehab, Nahtuha,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pahtrusa, Hkasluha hte Hpilisti masha ni pra hkrat wa ai Kreti amyu masha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hkanan a shadang sha ni hta alat Sidon hte Het rai ma ai. Shan a amying hta hkan nna amyu bawsang ni a kaji kawa ni tai wa masai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkanan gaw Yebusi, Amori, Girgashi, Hiwi,
  </para>
  <para style="p">
    <verse number="17" style="v" />Arki, Sini, Arwadi, Zimari hte Hamahti amyu masha ni a kaji kawa mung rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kaga ga re ai Hkanan a amyu bawsang ni chyawm gaw
  </para>
  <para style="p">
    <verse number="19" style="v" />Hkanan a lamu ga jarit ni rai nga ai Sidon mare kaw nna dingda maga Gerara hku hprang rai nna Gaza makau du hkra, bai sinpraw maga de Sodom, Gomora, Adma hte Zeboim mare ni hku hkrawn rai nna Lasha mare makau du hkra ran mat wa ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai ni gaw lakung lama kaga ga, shaga ai ga kaga ga, mungdan ni kaga ga hte amyu bawsang ni kaga ga re ai Ham a matu mara ni rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yahpet a kahpu kaba Shem gaw Hebre amyu masha ni yawng a kaji kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem a shadang sha ni gaw Elam, Ashura, Arhpaza, Luda hte Aram ni rai nna shanhte a mying ni hta hkan nna pra nga ai amyu masha ni a kaji kawa ni tai wa nga masai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aram a matu mara ni gaw Uza, Hula, Gehta hte Meshek amyu masha ni rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Arhpaza mung Shela a kawa rai nna, Shela gaw Ebera a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ebera mung shadang sha lahkawng lu wu ai; langai wa a mying gaw Hpelek rai nga ai, hpa majaw nga yang shi a prat hta mungkan ga na masha ni ga karan mat nga ma ai. Kaga langai wa a mying gaw Yoktan rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yoktan a matu mara ni gaw Almoda, Shelep, Hazarmawet, Yara,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadoram, Uzala, Dikla,
  </para>
  <para style="p">
    <verse number="28" style="v" />Ubala, Abimaela, Sheba,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ohpira, Hawila hte Yoba amyu masha ni rai ma ai. Shanhte yawng gaw Yoktan a amyu matu ni rai ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte shanu nga ai lamu ga gaw Mesha mare kaw nna sinpraw maga Sehpara bum du hkra maden nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai ni gaw lakung lama kaga ga, shaga ai ga kaga ga, mungdan ni kaga ga, amyu bawsang ni kaga ga re ai Shem a matu mara ni rai ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ndai amyu masha ni yawng hte gaw Noa a matu mara ni hta na pra hkrat wa ai hte lakung lama hta hkan nna langai hte langai ran wa ai amyu baw ni a lam rai nga ai. Dai sha-u ing ai hpang ginding aga hta pra nga ai amyu baw ni yawng gaw Noa a shadang sha ni hta na ran yu wa ai ni rai ma ai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shawng e, mungkan ga ting na masha amyu ni hta tsun shaga ai ga langai sha nga ai rai nna dai ga hpe lang nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte gaw sinpraw maga de htawt hkawm nga ma yang, Babelon mung hta nga ai pa layang langai mi de du nna dai yang e de nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw shada da hpe, “Sa marit! Anhte wut ju nna dai hpe ja hkra kabaw ga,” ngu nna tsun hkat ma ai. Dai rai nna, lang na wut ni hte wut ni hpe chya shakap na hka namsu ni hpe shanhte lu la ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw, “Lamu dep langchyi hte mare langai mi hpe anhte jawm galaw ga, shaloi anhte a matu amying gumhkawng shangun lu nna ga ntsa ting hta anhte n bra mat na ga ai,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hpang dai Madu gaw shinggyim masha ni galaw da sai mare hte langchyi hpe yu yu na nga, yu hkrat wa wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw, “Yu mu, ndai ni yawng gaw amyu langai sha rai nna ga langai hpe sha shanhte shaga nga ma ai; ndai gaw shanhte nnan galaw hpang ai amu rai nga malu ai. Kade n na yang, shanhte ra sharawng hpa lam hpe mung shanhte galaw lu na mara ai!
  </para>
  <para style="p">
    <verse number="7" style="v" />Anhte yu sa nna, shanhte a ga hpe shanut kau ya ga; shaloi shada da tsun hkat ai ga hpe shanhte n chye na mat na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna dai Madu gaw shanhte hpe mungkan ga ting de shabra kau dat wu ai rai nna, mare de ai hpe shanhte jahkring kau ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu gaw amyu masha ni a ga hpe shanut kau nna mungkan ga ting de shabra kau wu ai majaw, dai mare hpe Babelon ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ndai ni gaw Shem a lakung lama ni rai nga ai. Sha-u ing ngut ai hpang ni ning ngu na, Shem a asak 100 ning du ai shaloi, Arhpaza mying ai shadang sha hpe shi shaprat ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang shi gaw asak 500 ning naw nga nna shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Arhpaza a asak 35 ning hta shadang sha Shela hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hpang shi gaw 403 ning du hkra naw nga nna shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shela a asak 30 ning du ai shaloi, shadang sha Ebera hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang shi gaw 403 ning du hkra naw nga nna shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ebera a asak 34 ning du ai shaloi, shadang sha Hpelek hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang shi gaw 430 ning du hkra naw nga nna shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpelek a asak 30 ning du ai shaloi, shadang sha Reu hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang shi gaw 209 ning du hkra naw nga nhtawm shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Reu a asak 32 ning du ai shaloi, shadang sha Seruk hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang shi gaw 209 ning du hkra naw nga nhtawm, shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Seruk a asak 30 ning du ai shaloi, shadang sha Nahora hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hpang shi gaw 200 ning du hkra naw nga nhtawm shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nahora a asak 29 ning du ai shaloi, shadang sha Htera hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hpang shi gaw 119 ning du hkra naw nga nhtawm shayi shadang sha ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Htera asak 70 ning du ai hpang, Abram, Nahora hte Haran ni a kawa tai wa sai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai ndai ni gaw Abram, Nahora hte Haran ni a kawa Htera a matu mara ni a lam rai nga ai. Haran gaw Lawt a kawa rai nga ai,
  </para>
  <para style="p">
    <verse number="28" style="v" />shi a kawa naw hkrung nga yang, Babelon mung na shi a daidaw buga Ura mare hta si mat sai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abram gaw Sarai hpe la nna Nahora gaw Haran a shayi sha Milhka hpe la wu ai; bai shi gaw Yisahka a kawa mung rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sarai chyawm gaw maudung num rai nna kashu kasha n lu nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Htera gaw shi a kasha Abram hte shi a kashu Haran a shadang sha Lawt hpe mung, shi a kanam Abram a madu jan Sarai hpe mung shaga woi nhtawm Hkanan mung de sa wa na nga, Babelon mung Ura mare kaw nna pru sa wa ai. Shanhte gaw Haran mare de du hkra sa nhtawm dai yang e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Htera chyawm gaw shi a asak 205 ning hta dai mare e si mat sai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw Abram hpe, “Na a mungdan, na a jinghku jingyu ni hte na kawa a buga kaw nna pru wa nhtawm ngai nang hpe madun na de ai mung de sa wa su.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai nang hpe law law mayat maya shangun nna amyu kaba shatai na nngai. Ngai nang hpe shaman ya nna na a mying hpe gumhkawng shangun na nngai; shing rai nang gaw chyeju daju tai na rin dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang hpe shaman ya ai wa hpe ngai shaman ya na nngai, Rai ti mung nang hpe dagam ai wa hpe ngai dagam kau na nngai. Na a marang e, amyu baw yawng hte hpe ngai shaman ya na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abram a asak 75 ning du ai shaloi, dai Madu shi hpe tsun da sai hte maren, Lawt hte rau Haran mare kaw nna shi pru wa wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram gaw shi a madu jang Sarai hte shi a kanau a kasha Lawt hpe mung, shi a sut gan yawng mayawng hte Haran mare e shanhte lu la ai mayam ni yawng hte hpawn Hkanan mung de shanhte pru sa wa ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte dai Hkanan mung de du ai shaloi, Shehkem ginwang, More shara na chyoi pra ai hpun tu ai shara de du hkra, dai mung de Abram ga sa wa wu ai. (Dai aten hta Hkanan masha ni dai mung hta naw nga nga ma ai.)
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu gaw Abram kaw dan pru nna shi hpe, “Na a amyu matu mara ni hpe ngai jaw na ngu ai mungdan gaw ndai rai nga ai,” ngu nna tsun wu ai. Dai rai nna, shi kaw dan pru ai dai Madu a matu dai shara hta tawn hkungri hpe Abram galaw wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang dingda maga de yu wa nhtawm Behtela a sinpraw maga na kawng de shi htawt sa let shi a sum hpe Behtela a sinna maga hte Ai mare a sinpraw maga na lapran e gap wu ai. Dai yang e, tawn hkungri hpe mung shi gap nna dai Madu hpe nawku wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang shi gaw shara mi kaw nna shara mi de htawt hkawm nhtawm Hkanan mung a dingda maga de du hkra hkawm sa mat wa wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rai ti mung Hkanan mung hta grai nga n manu ai hte hku hku wa ai rai nna, dingda maga Egutu mung e tawng marang mi sa shingbyi nga na matu Abram pru sa wa wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Egutu mung a lamu ga jarit de lai bang wa nga yang, shi a madu jan Sarai hpe, “Nang gaw ahpraw tsawm ai num rai nga ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Egutu masha ni nang hpe mu ai shaloi, nang gaw nye a madu jan rai nga ai nga nna shanhte myit la na mara ai, shaloi shanhte ngai hpe sat kau nna nang hpe jahkrung da na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang gaw nye a kajan she re ngu nna shanhte hpe tsun dan u; shing rai na a majaw shanhte ngai hpe jahkrung da ai hte atsawm sha hku la na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Egutu mung de shi lai bang mat wa ai shaloi shi a madu jan tsawm htap nga ai hpe Egutu masha ni mu ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hkawhkam wang na du salang nkau mi mung dai numsha hpe mu ma ai rai nna, shi kade daram tsawm htap nga ai lam hkawhkam wa hpe tsun dan mu ai; dai rai nna shi gaw hkawhkam htingnu de shaga la ai hkrum wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai numsha a majaw hkawhkam wa gaw Abram hpe atsawm sha hku la nhtawm shi hpe sagu, bainam, dumsu, lawze, mayam ni hte gawla-uk ni hpe hpung hte hpung jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai ti mung hkawhkam wa Sarai hpe shaga la kau wu ai majaw shi a ntsa e mung, hkawhkam wang na masha ni a ntsa e mung, hkrit hpa ana zinli hpe dai Madu dat dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpang hkawhkam wa gaw Abram hpe shaga la nna, “Nang ngai hpe hpa galaw kau nit ni? Ndai numsha na a madu jan rai nga ai gaw nang ngai hpe hpa majaw n tsun dan n ni?
  </para>
  <para style="p">
    <verse number="19" style="v" />Nye a madu jan tai u ga, shi hpe na a kajan she re ngu nna hpa rai tsun n ta? Yu u, ndai gaw na a madu jan rai nga lit dai, shi hpe woi la nna pru mat wa u!,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hkawhkam wa gaw shi a masha ni hpe hkang dat wu ai; shing rai shanhte gaw Abram hte rau shi a madu jan hpe mung shi madu da ai arai yawng mayawng hte nawng mungdan kaw nna shapraw dat mu ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Abram gaw shi a madu jan hte shi lu malu hte mung, Egutu mung a dingdung maga, Hkanan mung a dingda maga de lung wa ma ai. Lawt mung shi hte rau hkan lung wa wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abram chyawm gaw sagu, bainam hte nga dumsu sut hte mung, aja gumhpraw sut hte mung ja ja lu su nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hpang shi gaw shara mi kaw nna shara mi de kanawt hkawm let Behtela mare de du hkra sa wa wu ai. Behtela hte Ai mare lapran na shawng de shi sum gap nna tawn hkungri galaw yu sai shara de,
  </para>
  <para style="p">
    <verse number="4" style="v" />shi bai du wa ai; shing rai dai shara hta dai Madu hpe shi nawku wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lawt mung sagu bainam hte nga dumsu sut, shi a dinghku hte shangun nchyang law law ni lu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shan hta yam nga sut nau law htam wa ai majaw, shan lahkawng shara sha nga na gaw lamu ga udat shara n shang nga malu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai rai nna Abram a nga rem ma ni hte Lawt a nga rem ma ni a lapran e ga law ga la byin wa masai. (Dai aten hta Hkanan hte Hperizi amyu masha ni dai mungdan hta naw shanu nga ma ai.)
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang Abram gaw Lawt hpe, “An gaw hpu nau rai nga ga ai majaw na a masha ni hte nye a masha ni ga law ga la ai amu hpe n shapraw ang nga ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna an hka saga. Nang ra sharawng ai lamu ga kaning re ai shara hpe rai tim lata la u. Nang maga mi de rai yang, ngai mung kaga maga mi de rai mat wa na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lawt gaw grup yin de mada dat yu wu yang, Zoara mare hkrang ai lam dingyang ngu na dai Yawdan Kadit ting hta hka law nga ai rai nna, dai gaw dai Madu a Sun Shing n rai Egutu mung zawn rai nga ai hpe mu wu ai. (Dai gaw Sodom hte Gomora mare ni hpe dai Madu garai n jahten kau yang byin ai lam rai nga ai.)
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna, Lawt gaw shi a matu Yawdan Kadit ting hpe lata la nhtawm sinpraw maga de htawt mat wa wu ai. Dai kaw nna shan lahkawng langai hte langai hka mat wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram chyawm gaw Hkanan mung e naw nga nga wu ai; Lawt gaw dai kadit hkan na mare ni hta nga nhtawm n hkru n shawp ai hte
  </para>
  <para style="p">
    <verse number="13" style="v" />dai Madu hpe yubak tawt lai ai masha ni shanu nga ai Sodom mare makau du hkra sum ni gap da nga wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lawt pru mat wa ai hpang, dai Madu gaw Abram hpe, “Ya nang nga ai shara kaw nna man maga shagu de atsawm sha mada yu u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang mu ai lamu ga mahkra, nang hte na a amyu matu mara ni hpe ngai jaw na nngai; shing rai dai gaw na a matu htani htana madu da ai lamu ga tai na ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a amyu matu mara ni hpe ngai shalaw jahtam na nngai; kadai mung shanhte yawng hpe dang hti lu na mara ai n rai; dai gaw ga ntsa e taw ai ga nhpu ni hpe n dang hti ai zawn law htam na mara ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya chyawm gaw, dai lamu ga nang hpe ngai jaw na de ai majaw, mungdan ting de pru hkawm nna yu yu u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna Abram gaw shi a sum htawt nna Hebron mare na chyoi pra ai hpun tu ai Mamre ngu ai shara makau e shang nga nga ai hte dai yang e, dai Madu a matu tawn hkungri langai mi shi galaw wu ai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hkawhkam mali rai nga ai, Babelon hkawhkam Amrahpela, Elasa hkawhkam Ariok, Elam hkawhkam Hkedalauma, hte Goim hkawhkam Htidala
  </para>
  <para style="p">
    <verse number="2" style="v" />hte gaw hkawhkam manga rai nga ai Sodom hkawhkam Bera, Gomora hkawhkam Birsha, Adma hkawhkam Shinab, Zeboim hkawhkam Shemeba, hte Zoara ngu ai Bela a hkawhkam ni hpe hpyen gasat ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hkawhkam manga hte gaw ya aten Jum Nawng ngu ai Sidim Kadit hta sa hpawng nna n-gun galung da nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw Hkedalauma up ai npu hta shi lahkawng ning tup rawng nga nna shi masum ning hta shi hpe gumlau ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi mali ning hta e Hkedalauma hte shi a jinghku hpyen hpung ni gaw rau sa nhtawm, Ashterot Karnaim hta e Rehpim masha ni hpe mung, Ham hta e Zuzim masha ni hpe mung, Kiriahtim pa hta e Emim masha ni
  </para>
  <para style="p">
    <verse number="6" style="v" />hpe mung dang kau nhtawm, Edom bum ga hkan e nga ai Hori masha ni hpe mung, zaibru jang nten mahka e nga ai masha ni hpe Elahparan du hkra, shanhte hpe shachyut kau mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang shanhte kayin yu wa nna (Dai aten hta Enmisahpat ngu ai) Kadesha mare de nhtang mat wa ma ai. Shanhte gaw Amalek masha ni a mungdan ting hpe mung, Hazazon Tama e nga ai Amori masha ni hpe mung dang kau ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang Sodom, Gomora, Adma, Zeboim hte Bela hkawhkam ni gaw
  </para>
  <para style="p">
    <verse number="9" style="v" />shanhte a hpyen luksuk ni hpe shajin da nhtawm, Elam, Goim, Babelon hte Elasa hkawhkam ni hpe Sidim kadit e gasat nga ma ai. Hkawhkam mali hte hkawhkam manga majan gasat nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya, dai Kadit hta e hka namsu nhkun hkrai pri rai nga ai; shaloi Sodom hte Gomora hkawhkam ni gaw majan pa kaw nna hprawng wa ma yang, dai nhkun ni hta hkrat shajang ma ai; rai ti mung, kaga hkawhkam masum hte gaw bum ga de hprawng lawt wa ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam mali ni gaw Sodom hte Gomora mare na arai nga manga hte hpawn lusha shahpa ni hpe htawm la nna wa mat ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sodom mare e nga ai Abram a kanau a kasha Lawt hte shi a sut rai yawng hpe mung shanhte la mat wa ya mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai ti mung, hprawng lawt wa ai masha langai mi gaw Amori masha Mamre madu da ai dai chyoi pra ai hpun ni tu ai shara makau e naw nga ai Hebre masha Abram hpang de dai lam yawng sa tsun dan wu ai. Mamre hte shi a kahpu kanau yan rai nga ai Eshkola hte Anera ni chyawm gaw Abram hte ga shaka tawn da ai jinghku ni rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Abram gaw shi a kanau a kasha hpe rim mat wa ai lam na jang, majan gasat kung ai masha 318 hte hpe shi a sum hta shaga mahkawng la nhtawm dai hkawhkam mali hte hpe Dan mare du hkra hkan shachyut ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai shara e, shi a masha ni hpe hpung hte hpung garan nna shana e dai hpyen ni hpe gasat ai hte shanhte hpe dang kau mu ai. Shi gaw shanhte hpe Damasku mare a dingdung maga,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hoba mare du hkra hkan shachyut ma ai rai nna, shanhte la mat wa sai arai ni yawng hpe nhtang la lu ma ai. Shi gaw shi a kanau a kasha Lawt hte shi a arai ni hpe mung, numsha ni hte hpawn kaga bawng masha ni hpe mung bai woi la lu nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abram gaw Hkedalauma hte kaga hkawhkam ni hpe dang kau nna bai wa ai shaloi, Sodom hkawhkam wa shi hpe sa tau la na nga, Shawe Kadit ngu ai (Hkawhkam Kadit) de pru sa wa wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tsaw Htum ai Karai Kasang a hkinjawng rai nna, Salem hkawhkam tai nga ai Melhkizedek mung Abram hpang de muk hte sabyi la sa ya nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />shi hpe shaman ya let, “Sumsing lamu hte ginding aga hpe hpan da ai dai Tsaw Htum ai Karai Kasang gaw Abram hpe shaman ya u ga!
  </para>
  <para style="p">
    <verse number="20" style="v" />Na a gumlau hpyen ni a ntsa e, nang hpe awng padang jaw ya ai dai Tsaw Htum ai Karai Kasang gaw a nga u ga law!,” nga nna tsun ai. Abram mung shi lu la sai arai mahkra a htam shi hta na htam mi hpe Melhkizedek a lata hta jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sodom hkawhkam wa gaw Abram hpe, “Arai ni hpe la kau u, rai ti mung, nye a amyu masha ni yawng hpe chyawm gaw ngai hpe nhtang ap ya e,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abram gaw, “Na a arai ngu na hpa hpe mung, dai sha n-ga ri yan mi hte kyepdin sumri yan mi du hkra pyi, ngai n la na nngai ngu, Sumsing lamu hte ginding aga hpe hpan da ai wa dai Tsaw Htum ai
  </para>
  <para style="p">
    <verse number="23" style="v" />dai Madu Karai Kasang a man e ngai dagam da se ai. Dai rai nna nang gaw, ‘Abram hpe sut su shangun ai gaw ngai wa rai nga nngai,’ ngu nna galoi mung tsun lu na ndai n rai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nye matu ngu nna hpa hpe mung ngai hta la na n rai. Nye a masha ni lang ai arai hpe chyu sha ngai hkap la na nngai. Rai ti mung nye a jinghku hpung ni rai nga ai Anera, Eshkola hte Mamre ni chyawm gaw shanhte lu la sai gambum hte maren la wa manu ga,” ngu nna htan wu ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Abram gaw shingran langai mu ai hte dai Madu gaw shi hpe, “Abram e, hkum hkrit et, hkrit hpa shara kaw na nang hpe ngai makawp la nna nang hpe kumhpa kaba jaw na we ai,” ngu nna tsun ai ga hpe na wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rai ti mung, Abram mahtang, “Tsaw Htum ai Madu e, na a kumhpa gaw ngai hpe kaning re ai mai kaja lam shabyin ya lu na rai nga a ta? Ngai hta kashu kasha mung n lu nngai. Nye a sali wunli dagraw na wa gaw Damasku mare na Elieza chyu sha rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang ngai hpe kashu kasha n jaw ndai, dai rai nna nye a mayam ni hta na langai ngai gaw nye a sut gan sali wunli dagraw la na rai sahka,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hpang shi gaw, “Dai Elieza ngu ai mayam wa gaw na a sut gan sali wunli hpe dagraw la lu na ra ai n rai; na a shadang sha nan na a sali wunli hpe madu lu na ra ai,” ngu nna dai Madu shi hpe bai tsun ai ga hpe na wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai Madu gaw shi hpe shinggan de woi shapraw nhtawm, “Sumsing lamu de mada yu nna dai shagan ni hpe hti shakut yu u; dai zawn law htam ai amyu matu ni hpe nang lu na rin dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram mung dai Madu hpe kam hpa nga wu ai, dai lam a majaw, dai Madu gaw shi hpe awng sharawng ai hte hkap la wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai dai Madu gaw shi hpe, “Ndai lamu ga gaw na a matu rai nga u ga, nang hpe jaw na matu ngu nna she, Babelon mung Ura mare kaw nna nang hpe woi shapraw wa ai dai Madu ngai nan rai nga nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai ti mung, Abram mahtang, “Tsaw htum ai Madu e, dai lamu ga gaw nye a matu tai na ra ai gaw, ngai kaning di chye lu na rai nga a ta?” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw, “Masum ning du ai dumsu upra langai, bainam kanu langai hte sagu la langai, hkrudu langai hte ura langai ngai hpang de la sa ya rit,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abram gaw dai yam nga ni hpe Karai Kasang hpang de la sa nhtawm hkum shagu hpe ka-ang brang brang di ga let, maga mi de chyen chyen di da wu ai; rai ti mung u ni hpe chyawm gaw n ga wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Langda ni dai mang ntsa de pyen hkrat wa ma ti mung, Abram dai ni hpe gawn kau wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jan shang wa jang, Abram gaw n dum mat hkra yup nga ai rai nna ja ja hkrit gari mat wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw shi hpe, “Na a amyu matu ni gaw maigan mung hta tsasam masha ni sa tai nga na mara ai; shanhte gaw dai mung hta e mayam tai nna shaning mali tsa ning tup gumshem ai hte zingri zingrat ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai ti mung shanhte hpe yam ai amyu hpe ngai ari jaw na we ai; bai shanhte gaw dai maigan mungdan kaw nna pru wa ai shaloi, shanhte hte rau sut gan law law la mat wa na mara ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang hkum nan mung gawng kung asak kaba ai du hkra nga lu nna ngwi pyaw ai hte si wa nhtawm makoi mayang ai hkrum na ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Prat mali lai ai hpang, na a amyu matu ni ndai shara de bai nhtang wa na mara ai; hpa majaw nga yang, Amori masha ni ari ahpri hkrum mu ga, shanhte grai n hkru n shawp ai ni tai mat wa ai aten du hkra, ngai shaden kau na nngai n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jan shang mat nna nsin htat nga ai shaloi, wan hkut hku ai wan mang hte wan tu ai shanan gaw akajawng sha dan pru nna shan hkyep ni a lapran hku lai mat wa ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpang dai Madu gaw Abram hte ga shaka tawn da nu ai. Shi gaw, “Egutu mung a ga jarit kaw nna Uhprat hka nu du hkra
  </para>
  <para style="p">
    <verse number="19" style="v" />dam ai lamu ga yawng hte Keni, Kenizi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Kadmoni, Heti, Hperizi, Rehpim,
  </para>
  <para style="p">
    <verse number="21" style="v" />Amori, Hkanani, Girgashi hte Yebusi masha ni nga ai mung ni lawm hkra, na a amyu matu ni hpe jaw na matu, ngai ga sadi tawn da se ai,” ngu nna tsun wu ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram a madu jan Sarai gaw shi a matu kashu kasha n lu ya nga ai. Rai ti mung, shi hta Hagara mying ai Egutu amyu mayam num langai mi lu wu ai;
  </para>
  <para style="p">
    <verse number="2" style="v" />shi gaw Abram hpe, “Dai Madu gaw ngai hpe kashu kasha n lu shangun ni ai. Dai rai nna nang hpa majaw nye a mayam num jan hte n yup lu na rai ta? Nye a matu kasha mahkoi mi shangai ya lu nhten,” nga nna tsun wu ai. Dai majaw Abram gaw Sarai tsun ai ga hpe myit hkrum ya wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna shi gaw Hagara hpe Abram a lashi num tai ya na matu jaw ya wu ai. (Ndai lam gaw Abram Hkanan mung e shi ning sa nga sayang she byin wa ai lam rai nga ai.)
  </para>
  <para style="p">
    <verse number="4" style="v" />Abram gaw Hagara hte kanawn ai rai nna, Hagara hta na-um nasin rai nga ai. Shi na-um nasin rai sai lam hpe chye jang, gumrawng gumtawng wa nna Sarai hpe n kaw n law di wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hpang Sarai gaw Abram hpe, “Ya Hagara ngai hpe n kaw n law di ai gaw na a mara rai lit ga. Ngai hkum nan na a lata hta shi hpe ap ya ni ai. Ya shi na-um nasin rai sai hpe shi chye ai hte ngai hpe n kaw n law di kau ni ai. An kadai mahtang teng man nga ai gaw nang hte ngai hpe dai Madu jeyang ya u ga!,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram mahtang, “Grai rai la sai, shi gaw na a mayam num rai nna na a up hkang ai npu hta taw nga ai jan rai nga ai; nang shi hpe kaning di mayu yang di u,” ngu nna htan wu ai. Shaloi Sarai gaw Hagara hpe adip arip di wu ai rai nna shi hprawng pru mat wa wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu a lamu kasa gaw Shura de sa wa ai zaibru jang na hka hpawk langai mi hta Hagara hpe hkap mu wu ai
  </para>
  <para style="p">
    <verse number="8" style="v" />hte, “Sarai a mayam num Hagara e, kade nna pru wa nhtawm kanang de sa wa nga n ta?,” ngu nna san wu ai. Shi gaw, “Nye a madu Sarai kaw nna hprawng wa nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw, “Na a madu hpang de bai nhtang wa su, shi a mayam tai nga u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hpang shi gaw, “Na a amyu matu ni hpe kadai mung n dang hti ai grai law htam hkra ngai nang hpe jaw na de ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang hta shadang sha shangai wa na ra ai; shi hpe Ishmaela ngu nna nang shamying lu na rai ndai; hpa majaw nga yang nang jahtau ai matsan tsin-yam nsen hpe dai Madu na ya nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai ti mung na a shadang sha gaw zai ai lawze zawn brak hkawm na ra ai; shi gaw masha shagu hte hpyen tai na ra ai, masha shagu mung shi hpe hpyen na ra ai. Shi gaw shi a kahpu kanau makyin jinghku ni yawng hte hka bra nna nga hkawm ra na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hagara gaw shi hkum hpe, “Ngai gaw Karai Kasang hpe mu lu sai hte dai lam hpe htawn tsun na matu teng teng asak hkrung nga nngai kun?,” ngu nna dinglik yu wu ai. Dai rai nna shi hte ga tsun ai dai Madu hpe, “Nang gaw mu lu ai Karai Kasang rai nga ndai,” ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai re ai majaw amyu masha ni gaw Kadesha hte Bered lapran e nga ai hka htung dai hpe, “Ngai Hpe Mu Ai dai Asak Hkrung Ai Wa A Hka Htung,” ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hagara gaw Abram hpe shadang sha shangai ya ai rai nna shi hpe Ishmaela ngu nna shamying ya wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abram gaw dai aten hta asak matsat shi kru ning du salu ai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram a asak jahku shi jahku ning du ai shaloi, dai Madu gaw shi kaw dan pru nna, “Ngai gaw Chyahtum Chyalai N-gun Rawng Ai Karai Kasang rai nga nngai. Nye a ga hpe madat mara nna teng man ai amu hpe tut nawng a galaw nga u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a ga shaka hpe nang hte ngai tawn da nna, law htam ai amyu matu mung nang hpe jaw na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram gaw ga du hkra dingnyawm dagup nga yang, Karai Kasang gaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ndai ga shaka nang hte shagrin da ni ai; nang gaw masha amyu baw law law a kaji kawa tai wa na lit dai hpe ngai ga sadi jaw nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a amying hpe ya kaw nna Abram ngu lu na n rai; ngai nang hpe masha amyu baw law law a kaji kawa shatai nga nngai majaw na a amying hpe Abraham ngu na rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai nang hpe amyu matu law law jaw na we ai; dai ni hta nkau mi hkawhkam hkawseng pru shajang na mara ai. Nang hta amyu matu grai law htam wa nna dai ni gaw amyu baw ni tai wa na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Nang hte mung, du na ra ai ban na na a amyu matu ni hte mung htani htana ga shaka ngu ai nye a ga sadi hpe ngai shatup na nngai. Ngai gaw na a Karai Kasang mung, na a amyu matu ni a Karai Kasang mung tai nga na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya nang tsasam tai nga ai ndai mung ting gaw nang hpe mung, na a amyu matu ni hpe mung ngai jaw na we ai. Ndai Hkanan mung ting hpe na a amyu matu ni htani htana madu lu na mara ai; ngai mung shanhte a Karai Kasang tai nga na nngai.”
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang gaw Abraham hpe, “Nang hkum nan hte du na ra ai ban na na a amyu matu ni hte ngai shaka da ai ga shaka hpe shadik shatup lu na matu nang mung myit hkrum ra na ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanhte hta na lasha shagu hpe matu gadoi ya na matu, nang hte na a amyu matu ni yawng myit hkrum lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte gaw ya kaw nna asak nhtoi matsat ya du sai lasha ma chyangai shagu hte hpe mung, nanhte a dum nta ni hta shangai ai mayam lasha shagu hte hpe mung, maigan masha ni a lata kaw nna mari la sai mayam lasha shagu hte hpe mung, matu gadoi ya na rai myit dai. Dai gaw nanhte hte nye a lapran e tawn da ai ga shaka hpe madun dan ai kumla rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lasha hkum shagu matu gadoi hkam la na rai myit dai, dai gaw nanhte hte tawn da ai htani htana agrin nga ai nye a ga shaka hpe shadan dan ai hkum shan hte seng ai kumla tai na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Matu gadoi n hkam ai lasha kadai rai ti mung nye a amyu masha hta na sumri dan kau ai hkrum na rai nga ai; hpa majaw nga yang ngai hte shaka tawn ai ga shaka hpe shi n hkan shatup ai majaw rai nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Karai Kasang gaw Abraham hpe, “Na a madu jan hpe mung Sarai ngu sana n rai; ya kaw nna shi a mying hpe Sara ngu na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi hpe ngai shaman ya nna, shi hta na shadang sha langai mi nang hpe jaw na we ai. Ngai shi hpe shaman ya nna, shi gaw amyu baw ni a kanu tai wa nhtawm; shi a amyu matu ni hta mung, hkawhkam hkawseng ni pru shajang na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham gaw ga du hkra dingnyawm dagup let, “Latsa ning du sai wa gaw kasha naw lu na kun? Jahku shi ning hta Sara kasha naw shangai lu na kun?,” ngu nna mani ai hte shi myit sumru yu nga wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi gaw Karai Kasang hpe, “Hpa majaw Ishmaela hpe nye a sali wunli n hkam la shangun a ta?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai ti mung, Karai Kasang chyawm gaw, “N rai law, na a madu jan Sara nan na a matu shadang sha shangai ya na ra ai; shi hpe Isak ngu nna shamying na rin dai. Shi hte mung, shi a amyu matu ni hte mung shaka da ai nye a ga shaka hpe htani htana ngai shadik nga na nngai. Dai gaw htani htana hte seng ai ga shaka rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ishmaela a lam hte seng nna nang hpyi lajin ai ga hpe ngai na ni ai, dai rai nna ngai shi hpe shaman ya nhtawm kashu kasha hte amyu matu law law shi hpe ngai jaw na nngai. Shi gaw hkawhkam kasha shi lahkawng a kawa tai wa na ra ai. Shi a amyu matu ni hpe mung amyu kaba ngai shatai na we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rai ti mung htaning ndai aten hta e, Sara shangai na ra ai shadang sha Isak hte mahtang nye a ga shaka hpe shagrin da na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang gaw Abraham hpe ga shaga ngut jang shi kaw nna lung mat wa wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai shani jang, Abraham gaw Karai Kasang a ga matsun hte maren shi a shadang sha Ishmaela hpe mung, shi a nta na kaga lasha ni yawng hte hpawn shi a nta hta shangai ai mayam lasha ni hte shi mari da sai mayam lasha ni hpe matu gadoi ya wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham gaw shi hkum nan matu gadoi hkam ai shaloi jahku shi jahku ning rai nga salu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi a kasha Ishmaela chyawm gaw shi masum ning hta rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shan wa lahkawng yan hte rau Abraham a mayam lasha ni yawng mung,
  </para>
  <para style="p">
    <verse number="27" style="v" />dai shani jang matu gadoi hkam la ma ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw Mamre mare na chyoi pra ai hpun ni tu ai shara hta nga ai Abraham kaw dan pru wu ai. Abraham gaw shani jan ja dik ai aten e,
  </para>
  <para style="p">
    <verse number="2" style="v" />shi a sum chyinghka lam kaw dung let mada yu dat yang, dai shara hta masha marai masum tsap nga ma ai hpe mu wu ai. Shanhte hpe mu ai hte rau, sa tau la na nga shi rawt sa wa wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw ga de myi man dingnyawm dagup nhtawm, “Madu ni e, chyeju hte nye a nta e n hkring ai sha hkum lai wa myit; ngai gaw nanhte hpe daw jau na matu nang e nga nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanhte a lagaw kashin na hka la sa ya made ga; ndai hpun npu hta nanhte ban sa la lu na myit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanhte a matu lusha mung la sa ya na nngai; dai gaw nanhte matut hkawm sa na hkrun lam a matu n-gun awai la shangun na ra ai. Nanhte gaw de a matu nye a dum nta de du sa manit dai; dai rai nna ngai nanhte hpe daw jau lu n ga law,” ngu nna shi tsun wu ai. Shanhte mung, “Chyeju kaba sai, anhte mung hkap la ya saga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham mung sum kata de tin tin shang wa nhtawm Sara hpe, “Na a kaja htum ai muk shadung hpai mi hpe tin tin la nhtawm nkau mi hpe muk pa kaba u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang shi gaw dumsu hpung nga ai de gat sa nna nu nu nai nai rai hpum sau ai dumsu kasha hpe dun wa nhtawm shangun ma hpe ya wu ai; dai hpe jin jin lajang da na matu mung shatin wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw htawbat, nga chyu hte dumsu shan nkau mi hpe la nna dai masha ni a man e, lusha hpe shachyip jaw wu ai. Dai hpun npu hta shi hkum nan shanhte hpe daw jau ai hte shanhte mung sha nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang shanhte gaw shi hpe, “Na a madu jan Sara kanang nga nga a ta?,” ngu nna san mu ai. Shi gaw, “Shi gaw wora sum kata e nga nga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte hta na langai wa gaw, “Ya kaw nna shata jahku a hpang ngai bai du na ring ngai; shaloi na a madu jan Sara shadang sha langai lu na ra ai,” ngu nna tsun wu ai. Sara mung shing nga tsun ai wa a shingdu na sum a chyinghka makau e nga nga nna madat nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya Abraham hte Sara yan gaw aprat grai kaba masai rai nna Sara hta numsha hking mung htum mat salu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai majaw Sara gaw, “Ya ngai gumgai ni ai hte n-gun yawm mat ni ai, dai rai yang num la kanawn ai hta ngai naw pyaw lu na rai nga a ni? Dai sha n-ga, nye a madu wa mung dingla mat sai,” ngu nna shi kraw e mani nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hpang dai Madu gaw Abraham hpe, “Sara gaw hpa majaw mani let, ‘Ngai gaw grai gumgai sayang me, kaja wa kasha lu na rai nga a ni?,’ ngu nna tsun ai hpe san wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai Madu n dang galaw lu ai amu nga nga a ni? Ngai tsun da sai hte maren, ya kaw nna shata jahku du jang, ngai bai du na ring ngai, dai shaloi Sara gaw shadang sha langai mi lu na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sara chyawm gaw shi hkrit nga ai majaw, “Ngai n mani nngai,” ngu nna dai ga hpe ningdang kau wu ai. Rai ti mung, shi mahtang, “Rai sa, nang mani nit dai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hpang masha dai ni gaw Sodom mare hpe mada lu ai shara langai mi de sa mat wa ma ai; Abraham mung shanhte hpe hkan sa dat na nga, shanhte hte rau sa wa nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai Madu gaw, “Ngai galaw na amu Abraham hpe makoi magap da na nngai n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi a amyu matu ni mung galu kaba wa nna n-gun hte hpring ai amyu tai wa na mara ai; Shi a jaw e, amyu baw ni yawng hpe ngai shaman ya na nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abraham gaw shi a shadang sha ni hte shi a matu mara ni nye a ga hpe madat mara nna ding hpring teng man ai amu hpe galaw ai lam hta shi hkang lu na matu ngai shi hpe lata la ni ai. Shanhte hkan shatup ai rai yang, nye a ga sadi hte maren, shi a matu lam shagu hpe ngai shadik ya na nngai,” ngu nna shi kraw e tsun wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hpang dai Madu gaw Abraham hpe, “Sodom hte Gomora mare hpe mara shagun ai nsen hkrit hpa rai nga malu ai rai nna shanhte a yubak gaw grai wa kaba nga malu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngai na la sai dai mara shagun ai nsen ni, teng ai n teng ai hpe chye lu na matu, ngai nan yu yu na nngai,’ ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hpang masha lahkawng pru mat wa nhtawm Sodom mare de matut sa mat wa ma ai, rai ti mung dai Madu gaw Abraham hte rau naw hti ngam nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abraham gaw dai Madu hpang de sit sa nna, “Mara n kap ai ni hpe mara kap ai ni hte rau nang teng teng jahten kau na wu ni?
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai mare hta e mara n kap ai masha manga shi nga dam yang, dai mare ting hpe nang naw jahten kau na wu ni? Dai manga shi hpe hkye mawai la na matu mare dai hpe n ngam da na wu ni?
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang gaw teng teng mara n kap ai ni hpe sat kau na n rai nga ndai. Dai gaw mai byin na n rai! Shing re ai amu hpe nang galaw lu na n rai nga ai. Nang galaw ai rai yang, mara n kap ai ni mung, mara lu ai ni hte rau ari jaw ai hkrum na mu ai. Dai gaw n mai byin ai lam rai nga ai. Ga ntsa ting a tara agyi wa gaw teng man ai hku daw dan na rai wu ai,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai Madu gaw, “Sodom mare hta mara n kap ai masha manga shi hpe ngai mu ai rai yang shanhte a majaw mare ting hpe ngai ngam da na we ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham gaw, Madu e, ndai zawn matut nna wam tsun ai nye a ga hpe mara dat ya e law. Ngai gaw shinggyim masha sha rai nna hpa tsun na ahkaw ahkang pyi n lu ai wa rai nga nngai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Rai ti mung, mara n kap ai masha manga shi n nga ti mung, mali shi manga dang gaw nga dam nhten; shing rai marai manga yawm nga ai majaw mare ting hpe jahten kau na wu ni?,” ngu nna bai tsun wu ai. Dai Madu gaw, “Dai mare hta mara n kap ai masha mali shi manga hpe ngai mu ai rai yang, ndai mare hpe jathen na n rai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abraham bai tsun wu ai gaw: “Ndai mare hta marai mali shi sha gaw mahkoi mi nga dam nhten.” Shi gaw, “Ndai mare hta marai mali shi nga ai rai yang, ngai jahten kau na n rai,” ngu nna bai tsun wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Abraham gaw, “ Madu e, masin hkum pawt et, ngai naw tsun we ga; dai mare hta marai sumshi nga ai rai yang, gara hku law?,” ngu nna tsun wu ai. Shi mung, “Marai sumshi hpe ngai mu mada ai rai yang, ngai n jahten na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai Abraham gaw, “ Madu e, ndai zawn matut nna wam tsun ai nye a ga hpe chyeju hte mara dat ya e law. Masha marai hkun hpe mu ai rai yang gara hku law?” ngu nna tsun wu ai. Shi mung, “Dai marai hkun hpe ngai mu ai rai yang, n jahten kau na we ai,’ ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abraham mung, “ Madu e chyeju hte masin hkum pawt et, ndai lang mi sha gaw ngai naw tsun we ga. Marai shi hpe mu ai rai yang, kaning di na wu ni?,” ngu nna tsun wu ai. Shi chyawm gaw, “Dai yang e marai shi nga ai rai yang, dai mare hpe ngai jahten kau na we ai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham hte shaga ngut ai hpang dai Madu mung wa mat wa nna Abraham mung shi a dum nta de nhtang mat wa wu ai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai lamu kasa yan gaw nrim aten e, Sodom mare de sa du ma yang, Lawt gaw mare chyinghka e dung nga ai. Shi shan hpe mu ai hte rau shan hte hkrum na matu rawt sa wa wu ai. Shi gaw shan a man e gum dagup let,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Madu yan e, nan hpe daw jau lu n ga, ndai yang e ngai nga nga nngai. Chyeju hte nye a nta de sa wa ya mi. Nan a lagaw hpe shin lu nna shana tup nga nga lu na myit dai. Shing rai jahpawt manap jau jau rawt nhtawm nan a hkrun lam hpe matut sa wa mu,” ngu nna tsun wu ai. Rai ti mung shan mahtang, “N rai law, ndai mare lam kaba hkan e she an shana tup nga nga na ga ai,” ngu nna htan ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw shan hpe akroi anoi nga nna matut shadut wu ai majaw, shan mung shi hte rau shi a nta de hkan wa ma ai. Bai manam ni a matu muk loi mi kabaw na matu mung, mu mai ai lusha hkyen lajang na shajin ngut jang, shan sha ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai manam yan yup ra garai n shang yang, Sodom mare na lasha ni dai nta hpe grup di wang da mu ai. Mare na lasha kaji kaba yawng mung dai shara hta nga nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lawt hpe shanhte shaga shapraw la nhtawm, “Dai na nang hte rau nga na matu du sa ai yan gaw kanang rai nga ma ta? Shan hpe anhte hpang de shapraw ya mi!,” ngu nna san mu ai. Sodom mare na lasha nlang ni mahtang shan hte kanawn mayu nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lawt mahtang shinggan de pru nna shi a shingdu na chyinghka la tawn da wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw shanhte hpe, “Manang ni e, ndai zawn re ai n hkru n shawp ai amu hkum galaw nga myit! Ngai nanhte hpe hpyi nem nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yu mu, ngai hta mahkawn jet naw re ai shayi sha lahkawng lu nngai. Shan hpe nanhte ra ai hku mi di lu na rai myit dai. Rai ti mung ndai masha yan hpe chyawm gaw hpa mung hkum di ya mi; shan gaw nye a nta na manam yan rai nga ma ai majaw ngai shan hpe makawp maga la lu na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung, shanhte mahtang, “Yen u, nang tsasam masha wa mi anhte hpe hpa galaw na lam tsun mi ai, nang gaw kadai wa rai nga n ta? Yen u, shing n rai jang shan hpe di ai hta nang hpe mahtang grau sawng hkra di na ga ai,” ngu nna tsun mu ai. Lawt hpe shingdu de shanhte kanawng shanga kau nhtawm chyinghka hpe agrawp daw kau na matu sit lung wa ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rai ti mung, nhku e rawng nga ai masha lahkawng mahtang lata ladawn dat nhtawm Lawt hpe nta de gang bang la nna chyinghka la kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang shan mung shinggan e nga ai lasha ni yawng hpe myi n mu kau ya mu ai majaw chyinghka hpe shanhte n mu tam lu ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hpang masha lahkawng mung Lawt hpe, “Ndai yang nang hte seng ai shadang sha ni hte shayi sha ni, kahkri ni hte ndai mare hta shanu nga ai kaga jinghku jingyu ni kadai rai tim naw nga ai rai yang, shanhte hpe ndai shara kaw nna woi pru mat wa sanu;
  </para>
  <para style="p">
    <verse number="13" style="v" />hpa majaw nga yang, ndai shara hpe an jahten kau na saga ai. Ndai masha ni a hkrit hpa mara shagun ai lam ni hpe na ai majaw Sodom mare hpe jahten kau na matu dai Madu an hpe shangun dat nu ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpang Lawt gaw shi a shayi sha ni hpe la na hkyen ai kahkri ni hpang de sa nhtawm, “Alawan rawt manu, ndai shara kaw nna pru mat wa manu; dai Madu gaw ndai shara hpe jahten kau na nu ai,” ngu nna tsun dan wu ai. Rai ti mung, shi shatu nga ai ngu nna shanhte myit nawn ya mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nhtoi htoi ai aten hta, lamu kasa yan mung Lawt hpe shatin mu ai. Shan gaw, “Hkum lanyan nga masa; Ya ndai mare hpe jahten kau ai shaloi nanhte a asak n sum hkrum u ga, na a madu jan hte shayi sha lahkawng yan hpe woi nna pru mat wa manu,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lawt chyawm gaw ung ang ai hte htingnai nga wu ai. Hpa mi rai tim, dai Madu shi hpe matsan dum nga ai majaw dai masha yan gaw shi hte shi a madu jan hpe mung, shi a shayi sha yan hpe mung lata hte dun nhtawm shanhte hpe mare shinggan de woi shapraw da mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang lamu kasa langai mi gaw, “Na a asak lawt lu hkra hprawng u! Shingdu de hkum kayin yu et! Kadit hkam wam hta mung hkum hkring et; sat kau ai mung nang n hkrum ru ga, kawng ni de kagat lung wa u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rai ti mung Lawt mahtang, “N rai law, Madu e, chyeju hte dai zawn re ai hpe hkum di shangun mi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang mung ngai hpe myi man grai pa shangun nit dai hte nye a asak hpe hkye mawai la nit dai, rai ti mung kawng ni nau tsan la nga ai rai nna tsin-yam tsindam gaw ngai hpe hkan lep nang nna dai shara de ngai garai n dang hprawng yang si na ring ngai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Wora mare kaji hpe nang mu ai n rai ni? Dai gaw ani sha rai nga ai. Dai de mahtang tawng hkra ngai hprawng lung we ga. Dai shara mung kaji sha re ai hpe nang mu lu nga ndai; ngai mung shim lum lu na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi mung, “Rai sa, ngai hkraw ya nga nngai. Dai rai nna,
  </para>
  <para style="p">
    <verse number="22" style="v" />mare dai hpe ngai n jahten kau na we ai. Dai re ai majaw alawan kagat hprawng sanu! Nang dai de du mat wa ai aten du hkra, ngai hpa mung n galaw na nngai,” ngu nna tsun wu ai. Lawt gaw dai mare hpe kaji ai ngu wu ai majaw mare dai hpe Zoara ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zoara mare de Lawt du shang wa yang ajan pru wa nga sai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai Madu gaw Sodom hte Gomora mare yan a ntsa de kan hte grung ai wan hpe akajawng sha jahtu dat nhtawm, dai mare lahkawng hpe mung,
  </para>
  <para style="p">
    <verse number="25" style="v" />kadit ting hte dai mayan hkan shanu nga ai masha ni yawng hte ga ntsa e tu matu mahkra hpe jahten kau mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rai ti mung, Lawt a madu jan chyawm gaw hpang de nhtang yu nna jum shadaw tai mat lu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham mahtang hpang jahpawt jau jau rawt nna dai Madu a man e, shi tsap yu sai shara de tin tin sa mat wa wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sodom hte Gomora mare ni hte kadit ting hpe shi mada yu wu yang, wan htung kaba kaw na pru ai wan hkut zawn ga kaw nna mawng lung nga ai hpe mu lu wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rai ti mung Lawt shanu nga yu sai dai kadit na mare ni hpe Karai Kasang jahten kau ai majaw, Abraham hpe shi dum wu ai rai nna Lawt hpe shim ai shara de shalawt dat na ahkang jaw wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lawt gaw Zoara mare hta nga hkrit wu ai majaw, shi hte shi a shayi sha lahkawng yan hte rau kawng nga ai de lung wa nhtawm lungpu langai mi hta wa rawng nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ya kana mahtang kanau jan hpe, “An a kawa dingla magang wa nga sai; dai sha n ga, kashu kasha lu na matu an hpe la na lasha ni kadai mung htung hte maren ndai mung, ndai mungkan ga ntsa ting hta n nga masai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sa wa rit, an a kawa hpe shanang da gaw; shaloi an shi hpe rau lu yup nna shi a matu mara ni pra wa lu na rai nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shan gaw dai shana e nan shi hpe sabyi jaw shanang da nhtawm kana jan mahtang shi hte rau kanawn wu ai. Rai ti mung shi grai nang nga ai majaw shing re ai lam hpe shi n chye wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hpang shani e mung, kana gaw kanau jan hpe, “Mana e ngai shi hte rau yup ni ai; ya dai na mung shi hpe jaw shanang da gaw; nang shi hte rau yup u. Shaloi an a kawa a majaw an hta kasha langai hpra lu la na ga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai rai nna shan gaw dai shana e, shi hpe jaw shanang da nhtawm kanau jan shi hte kanawn wu ai. Shi mung grai nang nga ai majaw shing re ai lam hpe shi n chye wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ndai lam hku nna Lawt a shayi sha lahkawng yan gaw kawa hta na na-um nasin hkum ni tai wa masai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shaloi kana mahtang shadang sha langai shangai nna dai ma hpe Moba ngu nna shamying wu ai. Shi gaw dai ni du hkra nga ai Moba amyu masha ni a kaji kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kanau jan mung shadang sha langai shangai nhtawm dai ma hpe Benami ngu nna shamying wu ai. Bai shi gaw dai ni du hkra nga ai Amon amyu masha ni a kaji kawa rai nga ai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham gaw Mamre mare kaw nna dingda maga Hkanan mungdaw mi de htawt sa wa nhtawm, Kadesha hte Shura lapran e shanu nga ai. Dai hpang kade n na yang, Gerara mare hta nga nga wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a madu jan Sara hpe shi a kajan re nga nna tsun wu ai majaw Gerara Hkawhkam Abimelek mung Sara hpe shi hpang de woi la kau wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang chyawm gaw lana mi na aten hta, yup mang hte shi kaw dan pru nna, “Masha e la da sai ndai num hpe nang woi la nit dai majaw, nang si na rin dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai ti mung, Abimelek mahtang shi kaw garai n kahtep ai rai nna shi gaw, “Madu e, ngai hpa mara mung n lu dum nga nngai! Nang gaw ngai hpe mung nye a masha ni hpe mung jahten kau na wu ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Sara gaw shi a kajan re ngu nna Abraham shi nan tsun mi ai hte maren Sara mung dai zawn sha tsun mi ai. Ngai gaw ndai amu hpe san seng ai myit hte galaw nngai, ngai gaw shut hpyit ai amu hpa mung n galaw kau nga nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai yup mang hta Karai Kasang gaw, “Rai sa, san seng ai myit hte ndai lam nang galaw ndai hpe ngai chye nngai; dai rai nna ngai hpe nang yubak galaw na kaw nna nang hpe ban shadang ai hte shi hpe n hkra shangun nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai ti mung, ya chyawm gaw dai num hpe shi a madu wa a lata de bai ap ya u. Shi myihtoi rai nga ai hte maren, na a matu shi akyu hpyi ya na ra ai; shaloi nang si lu na ndai n rai. Rai ti mung, nang shi hpe n ap ya ai rai yang chyawm gaw nang hte na a masha ni yawng si htum mat na myit dai hpe ngai sadi jaw nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpang jahpawt manap jau jau aten hta, Abimelek gaw shi a du salang ni yawng hpe shaga la nhtawm byin sai lam shanhte hpe tsun dan wu ai rai nna shanhte hkrit kahpra nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang Abimelek gaw Abraham hpe shaga la nna, “Nang anhte hpe hpa di nit ta? Nang hpe ngai hpa shut ai a majaw ngai hte nye a mungdan hta ndai tsin-yam tsindam hpe du shangun nga n ni? Kadai mung n galaw ging ai amu nang ngai hpe galaw kau nit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang hpa majaw dai zawn re ai amu hpe galaw n ta?” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham gaw, “Ndai yang e Karai Kasang hpe hkrit ai masha kadai mung n nga ai; nye madu jan hpe woi la lu na matu, ngai hpe sat kau na mu ai, ngu ngai myit nawn kau nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw nye a kajan majing mung rai nga ai. Shi gaw nye nu a shayi sha n rai ti mung nye wa a shayi sha rai nga ai rai nna shi hpe ngai la nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai rai nna Karai Kasang gaw ngai hpe nye wa a nta kaw nna maigan mung ni de shangun dat ai shaloi ngai shi hpe, “Nang ngai hta kade wa sadi dung nga ai hpe, ngai gaw na a kayung wa rai nga ai ngu nna masha shagu hpe tsun dan ai hku nna nang shadan dan lu nga ndai,’” ngu nna tsun we ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpang Abimelek gaw Abraham a lata hta Sara hpe bai ap ya wu ai; dai hte maren, sagu, dumsu hte mayam ni hpe mung jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi gaw Abraham hpe, “Ndai shara gaw nye a lamu ga hkrai rai nga li ai; dai rai nna nang yu sharawng ai shara kanang kaw rai tim nga u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw Sara hpe mung, “Na a kayung wa hpe gumhpraw hkying mi ngai jaw nga nngai; dai gaw nang nan mara n kap nga ai hpe nang hte rau nga ai ni yawng a man e sakse madun ai ja rai nna, masha shagu mung nang nan shut hpyit ai amu hpa mung n galaw shut kau nga ndai hpe chye lu na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham a madu jan Sara hta byin lai wa sai lam a majaw dai Madu gaw Abimelek a hkaw wang na numsha kadai hpe mung kashu kasha n kap hkra dim da nu ai. Dai rai nna Abraham gaw Abimelek a matu akyu hpyi ya wu yang, shi hpe mung, shi a madu jan hte mayam num ni hpe mung Karai Kasang shamai ya nu ai rai nna shanhte gaw kashu kasha ni shaprat mu ai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw shi shagrin da sai ga sadi hte maren, Sara hpe shaman ya ai hte shi hta na-um nasin rai wa nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham asak kaba sayang mahtang shi a matu shadang sha shangai ya wu ai. Shi shangai wa na ra ai ngu nna Karai Kasang tsun da ai ahkying hta nan shadang sha shangai wa sai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham mung shi hpe Isak ngu nna shamying nhtawm,
  </para>
  <para style="p">
    <verse number="4" style="v" />Isak asak 8 ya nhtoi du jang, Karai Kasang hkang da ai hte maren Abraham gaw shi hpe matu gadoi ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isak shangai wa ai shaloi Abraham a asak 100 ning rai nga wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sara gaw, “Karai Kasang ngai hpe kabu shangun ai hte mani shangun ni ai; dai lam hpe na ai ni kadai mung ngai hte rau mani na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang shi gaw, “Sara mung kashu kasha ni hpe chyu shachyu na ru ai, nga nna Abraham hpe kadai tsun yu na wu ta? Rai tim shi dingla mat wa ai aten hta she, shi a matu shadang sha langai ya ni ai,” ngu nna tsun kahtap wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai ma mung kaba wa nna chyu jahka ai shani e Abraham mung lusha poi kaba galaw ya wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lani mi na aten hta, Egutu num Hagara gaw Abraham a matu shangai ya ai shadang sha Ishmaela hte Sara a shadang sha Isak yan shada shatu ginsup chyai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sara gaw shan hpe mu nna Abraham hpe, “Ndai mayam num hte shi a shadang sha hpe gawt kau u. Dai numsha a shadang sha gaw nye a shadang sha Isak hkam la ang ai na a sut gan sali wunli a daw chyen mi hpe pyi hkam la lu na n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ishmaela mung shi a kasha rai nga ai majaw dai lam hpe Abraham nachying myit yak dum nga wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai ti mung, Karai Kasang gaw Abraham hpe, “Dai ma hte na a mayam num Hagara a majaw myit hkum ru et! Sara nang hpe tsun matsun ai hku hkan galaw u. Hpa majaw nga yang, ngai ga sadi tawn da ni ai hte maren, Isak hku nna sha na a amyu matu tai na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai gaw mayam num a shadang sha hpe mung kashu kasha law law jaw na nngai; shi gaw na a shadang sha langai rai nga ai majaw shanhte gaw amyu langai tai wa na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hpang jahpawt manap jau jau aten hta, Abraham gaw Hagara hpe lusha loi mi hte shanhpyi htingpa hta lu hka ntsin hpring hkra bang nna kasha hte rau dat dat wu ai. Dai hpang ma hpe mung shi a shingma ntsa hta shaba dat ya nhtawm dat dat wu ai. Shi pru mat wa nhtawm Berasheba nam mali hkan kayin hkawm nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai gun ai lu hka ntsin ma mat jang, ma hpe mung sumwum kata e tawn kau da nhtawm,
  </para>
  <para style="p">
    <verse number="16" style="v" />dai shara kaw na pe 300 daram tsan ai shara hta sa dung nga wu ai. Shi gaw, “Nye a ma si mat ai mung ngai n mu mayu mat ni ai,” nga nna shi hkum hpe ndawt wu ai. Shi gaw dai shara e dung nga let jahtau hkrap wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Kasang mung dai ma jahtau hkrap ai nsen na wu ai rai nna, sumsing lamu na Karai Kasang a lamu kasa gaw Hagara hpe, “Hagara e, nang hpa baw ru yak tsin-yam hkrum hkra nga n ta? Hkum hkrit nga et, Karai Kasang gaw dai ma a jahtau hkrap ai nsen hpe na ya nu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna rawt u, sa nna ma hpe pawn shadaw ai hte shi hpe shalan shabran la su. Shi a amyu matu ni hta na amyu kaba ngai shatai na we ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang Karai Kasang shi a myi hpe jahpaw ya wu ai rai nna hka htung langai mi hpe shi mu wu ai. Shi sa nhtawm shanhpyi nhpye hta hka jahpring la nhtawm ma hpe jaw lu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Karai Kasang mung dai ma hte rau rai nga nna, shi galu kaba wa ai hte Hparan nam mali e nga nga let kung kyang ai jaugawng langai mi tai wa nu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a kanu mung shi a matu Egutu shayi sha langai mi tam ya wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai aten hte yang, Abimelek gaw shi a hpyen du Hpikola hte rau sa nna Abraham hpe, “Nang galaw ai lam shagu hta Karai Kasang nang hte rau nga nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai rai nna ngai hpe mung, nye a kashu kasha ni hte matu mara ni hpe mung, nang n masu hkalem kau ai sha, na a ntsa e ngai sadi dung lai wa ai zawn nang mung nye a ntsa hte ya nang shanu nga ai ndai mung a ntsa e mung, sadi dung nga na ga sadi ndai shara Karai Kasang a man e dagam da e,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham mung, “Ngai ga sadi jaw nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abraham chyawm gaw Abimelek a shangun ma ni kashun la sai hka htung a lam hte seng nna Abimelek hpe tsun lajin wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abimelek mung dai hpe kadai galaw ai gaw ngai n chye nngai. Nang mung dai lam ngai hpe n tsun dan yu ndai; ndai gaw dai lam hte seng nna shawng na ai shiga rai sai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai hpang Abraham gaw Abimelek hpe sagu hte dumsu nkau jaw nna shan lahkawng a myit hkrum ga shaka hpe shagrin da ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham gaw shi a sagu hpung na sagu kasha sanit hpe jahka tawn wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abimelek gaw shi hpe, “Nang hpa majaw dai zawn galaw n ta?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Abraham gaw, “Ndai sagu kasha sanit hpe hkap la u. Ndai zawn galaw ai a majaw ndai hka htung hpe ngai htu se ai lam nang yin la lu na ndai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai yang e shan lahkawng dagam ma ai majaw shara dai hpe Berasheba ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shan gaw Berasheba e myit hkrum ga shaka hpe shagrin da ngut ai hpang, Abimelek hte Hpikola yan mung Hpilisti mung de nhtang mat wa ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai hpang Abraham chyawm gaw Berasheba shara e magyeng hpun langai mi hpe hkai nna, htani htana agrin nga ai dai Madu Karai Kasang hpe nawku wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abraham gaw Hpilisti mung e na na wa nga nga wu ai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya aten ram ram na mat ai hpang, Karai Kasang gaw Abraham hpe chyam yu na nga shi hpe, “Abraham!,” ngu nna shaga wu ai. Abraham mung, “Rai sa, ngai nang e nga nga nngai!,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang gaw, “Nang grai tsaw ra ai na a shadang sha shingtai Isak hpe woi nna Moria ga de sa wa su. Ngai nang hpe madun na de ai bum ntsa e, shi hpe shagu hkungga shatai nna ngai hpe nawng jau e,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hpang jahpawt manap jau jau aten hta, shagu hkungga nat nawng na matu hpun nkau mi hpe Abraham chye ga nna, shi a lawze hta daw byau nhtawm shi hte rau Isak hte shangun ma lahkawng hpe mung woi wu ai. Karai Kasang shi hpe tsun da sai shara de shanhte pru sa mat wa ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masum ya sat hkawm ai hpang, Abraham gaw tsan tsan e nga ai dai shara hpe mu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hpang Abraham gaw shangun ma yan hpe, “Nan nang e lawze hte rau nga nga mala, Ndai ma hte ngai chyawm gaw htawra de lung wa nna nawku na ga ai. Dai hpang, nan hpang de an bai nhtang yu wa na ga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham gaw Isak hpe hkungga nat na hpun jahpai nhtawm shi hkum nan mung nhtu hte wan wut hpang na grung ai wan n-ga ni hpe lang da wu ai. Shan wa lahkawng rau sha hkawm lung wa ma yang,
  </para>
  <para style="p">
    <verse number="7" style="v" />Isak mahtang, “Wa e!,” ngu nna shaga wu ai. Shi mung, “Rai sa, ngai sha e!,” ngu nna htan wu ai. Isak gaw, “Nang hta wan n-ga ni hte hpun ni nga nga ai hpe ngai mu nngai; rai ti mung hkungga nat nawng na sagu kasha kanang nga nga a ta?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham chyawm gaw, “Karai Kasang shi nan lama ma lajang ya na ra ai,” ngu nna htan wu ai. Dai hpang shan lahkawng rau sha bai matut lung mat wa ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang shi hpe tsun ai shara de shan du lung wa ai shaloi Abraham gaw tawn hkungri galaw nhtawm, de a ntsa e hpun mara garai da wu ai. Dai hpang shi a kasha hpe gyit nna tawn hkungri na hpun ntsa e shi hpe mara tawn wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hpang Abraham gaw kasha hpe sat na matu nhtu lang da wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, dai Madu a lamu kasa gaw sumsing lamu kaw nna shi hpe, “Abraham, Abraham,” ngu nna shaga wu ai. Shi mahtang, “Rai sa, ngai nang e nga nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lamu kasa gaw, “Dai ma hpe hkum hkra et; shi hpe hpa mung hkum di et. Na a shadang sha shingtai shi hpe jaw na nang n kanung nga nit dai majaw Karai Kasang hpe nang hkrit hkungga ai hte madat mara nga ndai hpe ya ngai chye ni ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham mung grup yin de mada yu wu yang, sagu la langai mi sumwum hta shi a nrung chya nna dau nga ai hpe mu wu ai. Abraham sa nna dai hpe sa raw la nhtawm shi kasha a malai wan nat hkungga nawng ya wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abraham mung dai shara hpe, “Dai Madu karum ai,” ngu nna shamying wu ai. Dai ni na amyu masha ni pyi,” Dai Madu a bum ntsa e, shi karum la ai,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai Madu a lamu kasa gaw sumsing lamu kaw nna Abraham hpe lahkawng lang ngu na bai shaga nhtawm,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Ngai gaw nye a mying nsang hta dagam ai hte dai Madu tsun nga ai gaw, ndai amu hpe nang galaw ai hte na a shadang sha shingtai ngai hpe jaw na, nang n kanung nga nit dai majaw ngai nang hpe hkum tsup hkra shaman ya na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na a amyu matu ni hpe mung lamu na shagan ni shing n rai panglai zaibru ni zawn ngai nang hpe jaw na nngai. Na amyu matu ni mung shanhte a gumlau hpyen ni hpe dang kau lu na mara ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a hkang da ai ga hpe nang madat mara nga ndai majaw na a amyu matu ni yawng hpe ngai shaman ya ni ai zawn amyu baw ni yawng mung shanhte hpe shaman ya na matu, ngai hpe san wa na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abraham mung shi a shangun ma yan hpang de bai nhtang wa nhtawm shi shanu nga ai Berasheba mare de shanhte rau wa mat wa ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aten ram ram na ai hpang, Abraham gaw shi a kanau Nahora a matu madu jan Milhka kasha matsat shangai ya sai hpe chye da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai ni gaw kasha alat Uza, shi a kanau Buza, Aram a kawa Kemuela, Hkesed, Hazo, Piledasha, Yidlap, hte Rebeka a kawa Behtuela ni rai ma ai. Milhka gaw Abraham a kanau Nahora a matu ndai shadang sha matsat hpe shangai ya nu ai. Nahora a lashi num Reuma mung Teba, Gaham, Htahasha, Mahka hte hpe shangai ya wu ai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sara gaw asak latsa hkun sanit ning du hkra hkrung nga wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sara gaw Hkanan mung na Hebron mare hta si mat ai. Shi si mat ai majaw Abraham sharung shayawt ai hte hkrap ngu hkrap ngoi nga wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham gaw shi a madu jan a si mang hpe sharawn tawn ai shara kaw nna pru mat wa nhtawm Heti masha ni hpang de sa mat wa let,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ngai gaw ndai yang nanhte a ka-ang e shanu nga ai maigan masha wa rai nga nngai; dai rai nna nye a madu jan hpe lup makoi lu na matu, ngai hpe lamu ga dachyawk mi dut ya mi,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte mung, “Madu e, anhte a ga hpe madat ya mi. Anhte nang hpe n-gun atsam hte hpring ai ningbaw langai zawn mu mada ga ai; dai rai nna anhte lu ai kaja htum ai lup hta na a madu jan hpe lup makoi lu na matu nang hpe lup wa langai anhte kabu gara ai hte jaw na ga ai,” ngu nna htan ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang shanhte a man e, Abraham gaw gum dagup let, “Ndai shara e, nye a madu jan hpe lup makoi na nanhte hkraw myit yang, chyeju hte Zohara a kasha Ehpron hpe shi a sun jahtum makau e nga ai Makhpela ginlawng hku, ngai hpe dut ya na san ya mi. Ndai shara nanhte a man na dai lamu ga a manu jahpu tup tup hte ngai hpe dut ya na matu, shi hpe san ya mi, dai hpe lup wa shara zawn ngai madu da lu na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ehpron shi nan mung mare chyinghka na hpawng ginra hta kaga Heti masha ni hte rau dung nga ai. Dai yang e madat nga ai masha shagu hte gaw, Abraham hpe,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Madu e, madat u, ginlawng hku lawm ai sun lamu ga ting nang hpe ngai jaw na nngai. Ndai yang na nye a amyu masha ni a man e nan nang hpe ngai jaw na de ai; na a madu jan hpe nang lup makoi lu na ndai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai ti mung, Abraham mahtang Heti masha ni a man e gum dagup let
  </para>
  <para style="p">
    <verse number="13" style="v" />masha shagu mung na la lu mu ga Ehpron hpe, “Ngai nang hpe san yu de ga, chyeju hte madat la ya e. Dai sun ting hpe ngai mari la na nngai, ngai jaw na manu jahpu hpe hkap la ya e; dai shara hta nye a madu jan hpe ngai lup makoi na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ehpron mung, “Madu e, dai lamu ga a manu gaw gumhpraw lap mali tsa sha dan nga ai. Dai gaw an a lapran e hpa wa mi rai nga a ta? Dai shara hta na a madu jan hpe lup makoi u,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham mung myit hkrum ai hte na lawm ai masha ni a man e Ehpron tsun hpaw sai manu hpe hpaga ni jai lang ai gumhpraw mali tsa, shi hpe shen ya wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ehpron madu da ai dai Mamre a sinpraw maga na Makhpela e nga ai lamu ga gaw Abraham a sut gan tai wa sai. Dai lamu ga hta sun mung, dai ginlawng hku mung, bai sun a jahtum shingnawm du hkra tu ai hpun ni yawng mung lawm nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpawng ginra hta lawm ai Heti masha yawng hte mung, dai gaw Abraham madu da sai sut gan rai nga ai ngu, jawm hkap masat da ya ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang Abraham mung Hkanan mung na dai ginlawng hku hta shi a madu jan Sara hpe lup makoi wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna, Heti masha ni madu da ai sun hte dai hta nga ai ginlawng hku gaw Abraham madu nga na lupding lupra shara tai wa sai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Abraham gaw grai dingla wa nna prat kaba nga sai; dai Madu mung shi galaw ai lam shagu hpe shaman ya nu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham gaw nta na shi lu ai sut rai mahkra hpe up ai asak kaba ai shi a shangun ma wa hpe shaga la nhtawm,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Na a lata nye a magyi lapran hta bang nna dagam ru. Ngai sha a matu ningrum ningtau langai ndai Hkanan mung na shayi sha ni hpe n lata hkrup lit ga, sumsing lamu hte ginding aga a Madu Karai Kasang a mying nsang hta ngai nang hpe dagam shangun mayu nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a daidaw mungdan de nang sa nna, ngai sha Isak a matu nye a amyu bawsang ni kaw na ningrum ningtau langai sa la ya lu na rai ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai ti mung, dai shangun ma wa mahtang, “Dai numsha ndai mungdan de ngai hte rau hkan wa na matu n hkraw ai rai yang kaning di na rai nga a ni? Dai n rai, nang pru kau da ai mungdan de na a nsha hpe ngai bai woi sa wa lu na rai nga a ni?,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham gaw, “Ngai sha hpe dai de nang bai n woi sa ra hkra sadi nga u!
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu sumsing lamu a Karai Kasang gaw ngai hpe nye kawa a nta hte nye a amyu bawsang ni shanu ai buga kaw nna woi la nhtawm ndai lamu ga hta nye a amyu matu ni hpe jaw na nga nna ngai hpe shi dagam let ga sadi shagrin da nu ai. Shi gaw shi a lamu kasa hpe na a shawng de shangun dat na ru ai; dai shara hta ngai sha a matu ningrum ningtau langai nang la ya lu na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai numsha nang hte rau n hkan nang hkraw ai rai yang chyawm gaw ndai shagrin da sai ga sadi kaw na nang lawt lu na rin dai. Rai ti mung, ngai sha hpe gara hku nna mung bai woi nhtang sa wa lu na n rai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna, shangun ma wa mung, shi a madu Abraham a magyi lapran hta shi a lata bang nna, Abraham tsun matsun ai hte maren hkan galaw na matu dagam yin la wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abraham a sut rai hpe up ai shangun ma wa gaw shi madu a gawla-uk ni hpe byau la nna Nahora shanu nga ai Mesopotamia mung a dingdung maga na mare de sa wa wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi du shang wa yang, mare shinggan na hka htung makau e, shi a gawla-uk ni hpe jahpum tawn da wu ai. Dai aten gaw numsha ni hka ja na matu pru sa wa ai shana de na ahkying rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw, “Dai Madu nye a madu Abraham a Karai Kasang e, dai ni na aten hta awng dang ai lam ngai hpe jaw ya e; nye a madu hpe jaw ai na a ga sadi mung dik wa u ga law.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ndai mare na num mahkawn ni hka ja na matu pru sa wa na ndai hka htung hta ngai nga nga na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai gaw dai ni hta na marai langai ngai hpe, “Chyeju hte ngai ntsin lu n-ga, na a ntsin di bu shayu u,’ ngu nna tsun yang, shi rai nna, ‘Lu u, na a gawla-uk ni hpe mung ngai ja jaw na nngai,” ngu nna tsun pru wa ai numsha gaw, na a shangun ma Isak a matu, nang san da ya ai jan rai sanu ga. Dai zawn byin wa ai rai yang, nye a madu hpe jaw ai ga sadi hpe nang shadik shatup nga nit dai gaw ngai chye lu na we ai,” ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ga dai garai n htum yang, yu u Rebeka gaw shi a lahpa ntsa e di bu hpai let du sa wa nga sai. Shi gaw Abraham a kanau Nahora hte madu jan Milhka yan a shadang sha Behtuela a shayi sha rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw nachying ahpraw tsawm ai hte hkawn jet naw rai nga ai. Dai hka htung de shi yu sa nna ntsin di bu hpe jahpring nhtawm bai lung wa nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shangun ma wa gaw shi hpang de gat sa wa nhtawm, “Chyeju hte na a di bu kaw na ntsin ngai hpe jaw lu e,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi mung, “Madu e, she lu u,” ngu nna shi a lahpa kaw na di bu hpe alawan shayu la nga ai, dai hpe shi lu nga yang, di bu hpe mung jum da ya wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi lu ngut jang dai numsha gaw, “Na a gawla-uk ni hpe mung hkru hkra ngai ja jaw na we ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi a di bu na ntsin hpe yam nga ni hpe jaw ai ntsin htung hta ru bang nhtawm, hka bai ja la na matu hka htung de gat yu wa nna shi gawla-uk ni yawng hka lu ngut ai aten du hkra ntsin ja jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai wa mung dai Madu shi hpe awng dang ai lam jaw ya sai rai, n rai hpe chye lu hkra dai numsha hpe atsin sha azi yu nga wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai numsha gawla-uk ni hpe ntsin jaw ngut jang, dai wa gaw manu dan ai ja shanghkawng la nna shi a ladi hta noi ya let kaba ai ja lahkawn man mi hpe mung shi a lata hta hkawn ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hpang shi gaw, “Chyeju hte na nwa kadai rai nga ai gaw, ngai hpe tsun dan e. Shi a nta hta ngai hte nye a masha ni manam na gawk nga a ni?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi gaw, “Nye wa mahtang Nahora hte madu jan Milhka yan a kasha Behtuela rai nga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi gaw, “Anhte a nta hta yihku hte ushat law law nga ai; nanhte a matu nga shara mung nga ai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi dai wa gaw hput di di let dai Madu hpe nawku wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shi gaw, “Nye a madu hta shi a ga sadi hte maren, sadi sahka hte shatup ya sai nye a madu Abraham a Karai Kasang dai Madu a nga u ga law. Dai Madu gaw ngai hpe nye madu a amyu bawsang ni nga ai de ading sha woi wa ni ai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai numsha mung shi kanu a nta de gat wa nhtawm byin ai lam yawng hpe wa tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya Rebeka hta Laban mying ai kahpu langai lu wu ai. Shi mung Abraham a shangun ma wa nga ai hka htung de gat sa wa wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shi kajan a ladi shanghkawng hte lata na lahkawn ni hpe Laban mu wu ai. Dai wa kajan hpe kaning nga tsun ai ga hpe shi a kajan kaw na na la wu ai. Shing rai hka htung makau e nga ai shi a gawla-uk ni a makau hta tsap nga ai Abraham a shangun ma hpang de shi sa wa nhtawm, “Nta de ngai hte rau wa ga.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nang gaw dai Madu a shaman chyeju hpe hkam la ai wa rai nga ndai. Hpa rai ndai shinggan e tsap nga n ta? Nye a nta hta na a matu ya jang mai nga ai gawk langai mi lajang da ya se ai: dai sha n rai, gawla-uk ni a matu nga shara mung nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai rai nna, dai wa gaw nta de shang mat wa ai hte Laban mung gawla-uk ni hpe hking raw kau ya nhtawm dai ni hpe yihku hte ushat jaw sha wu ai. Dai hpang shi gaw Abraham a shangun ma hte shi a masha ni a matu lagaw shin hka la wa ya wu ai. Bai shat lusha ni hpe la wa ya yang,
  </para>
  <para style="p">
    <verse number="33" style="v" />dai wa gaw, “Ngai tsun ang ai ga hpe tsun ngut ai aten du hkra shat lusha garai n sha na nngai,” ngu nna tsun wu ai. Dai rai nna Laban gaw, ‘Rai taw, she matut tsun yu u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi gaw, “Ngai gaw Abraham a shangun ma wa rai nga nngai,” ngu nna tsun hpang wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Dai Madu gaw nye a madu hpe grai shaman ya nu ai hte sut su shangun nu ai. Dai sha n-ga, sagu, bainam hte dumsu uhpung ni hpe mung, aja gumhpraw ni hte hpawn mayam num mayam la ni, gawla-uk ni hte lawze ni hpe mung shi jaw ya nu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nye a madu a madu jan Sara asak kaba sayang she, shi a matu shadang sha langai mi shangai ya wu ai majaw nye a madu shi lu malu mahkra shi a kasha hpe jaw nu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nye a madu mung shi hkang da ai ga hpe madat mara na matu ngai hpe ga sadi hte dagam shangun ni ai. Shi gaw, ‘Ngai sha a matu ningrum ningtau langai mi hpe dai Hkanan mung na shayi sha ni hta na nang lata lu na n rai;
  </para>
  <para style="p">
    <verse number="38" style="v" />dai hkan na lata la na malai, nye wa a amyu masha ni hte nye a amyu bawsang ni hpang de mahtang sa nna shi a matu ningrum ningtau lata ya lu na ndai,’ ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai rai nna nye a madu hpe, “Dai numsha ngai hte rau n hkan hkraw ai rai yang, kaning di na rai ta?,” ngu nna san we ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shi gaw, ‘Ngai tut nawng e madat mara nga ai dai Madu gaw shi a lamu kasa hpe nang hte rau shangun dat nna nang hpe awng dang ai lam jaw ya na ra ai. Nang mung ngai sha a matu ningrum ningtau langai mi hpe nye a amyu masha ni kaw na mung, nye wa a dinghku kata kaw na mung num la lu na ndai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nang dagam da ai kaw na lawt lu na ginjang langai sha nga nga ai; dai gaw nye a amyu bawsang ni de nang sa ai hpe n hkap la ai rai yang chyawm gaw nang lawt lu na rin dai,’ ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Ngai gaw, ‘Ya dai ni ndai hka htung de ngai du ai shaloi, nye a madu Abraham a dai Madu Karai Kasang hpe chyeju hte ngai galaw nga ai lam hta awng dang ai lam jaw ya e.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ndai hka htung makau e ngai nga nga nngai. Nang de num mahkawn langai mi hka ja sa na matu, pru sa wa ai shaloi shi a di bu kaw na lu hka ntsin ngai hpe jaw lu na matu hpyi nngai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shi dai hpe hkraw ya nna nye a gawla-uk ni hpe mung hka ja jaw na nngai, nga nna tsun wa ai rai yang, dai numsha gaw nye madu a shadang sha a ningrum ningtau hpe nang lata san da ya ai jan rai u ga, ngu nna hpyi we ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ya dai lam, nye a kraw kata e shing ngu akyu hpyi tsun ai pyi garai n htum yang, Rebeka gaw shi a lahpa hta ntsin di bu hpai nna sa wa nhtawm hka ja na matu hka htung de yu wa wu ai. Dai rai nna ngai shi hpe, “Chyeju hte ngai hpe ntsin jaw lu e,” ngu nna tsun we ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shi mung shi a lahpa na ntsin di bu hpe tin tin shayu ya nhtawm, ‘She lu u, na a gawla-uk ni hpe mung ngai ja jaw na we ai,’ ngu nna tsun ai. Dai rai nna ngai ntsin lu ni ai, shi mung gawla-uk ni hpe hka ja jaw wu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ngai mung shi hpe, “Na nwa kadai rai nga a ta?,” ngu nna san we yang, shi gaw, Nye wa gaw Nahora hte Milhka yan a kasha Behtuela rai nga ai,” ngu nna htan wu ai. Dai hpang ngai gaw shi a ladi hta shanghkawng hte lata hta lahkawn ni hpe hkawn ya nngai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ngai mung hput di nna dai Madu hpe nawku nngai. Nye a madu a shadang sha a matu dai shayi sha hpe ngai sa mu ai shara ngu ai nye madu a amyu bawsang hpang de ading sha woi sa wa ai nye madu Abraham a Karai Kasang dai Madu hpe shakawn kungdawn nngai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ya chyawm gaw, nye a madu hpe nanhte maga na lit hpe shatsup ya na myit makun ai hte shi hpe htuk tsawm ai hku lajang na rai myit yang mung, chyeju hte ngai hpe tsun dan mi; dai hku n tsun lu ai rai yang mung, kaning rai galaw na hpe ngai daw dan na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Laban hte Behtuela yan mung, “Ndai lam gaw dai Madu hpajang ai lam rai nga ai hte maren, dai amu hpe an n chye daw dan lu na ga ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Yu u, nang e Rebeka nga nga ai; shi hpe woi wa u. Dai Madu nan tsun sai hte maren, na madu a shadang sha a madu jan shi tai nu ga,” ngu nna htan ma ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ga dai hpe Abraham a shangun ma wa na ai shaloi jang shi gum dagup let dai Madu hpe nawku wu ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Dai hpang hpun palawng ni hpe shi la shapraw nhtawm aja, gumhpraw sumli arai ni hte hpawn Rebeka hpe jaw wu ai. Shi a kanu yan kayung hpe mung manu dan ai kumhpaw kumhpa ni jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Dai hpang Abraham a shangun ma wa hte shi kaw hkan nang ai ni mung lusha sha nna shana nhtoi shalai ma ai. Hpang jahpawt shanhte rawt wa yang shi gaw, “Nye madu a nta de bai wa lu n-ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Rai ti mung, Rebeka a kanu yan kayung chyawm gaw, “Ndai numsha anhte hte rau bat mi shing n rai nhtoi shi ya dang naw nga nga u ga; dai hpang mahtang shi hkan nang wa u ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Rai ti mung shi mahtang, “Anhte hpe hkum hkum da mani. Dai Madu gaw anhte a hkrun lam hpe abu abai n nga hkra lajang da ya mani ai; nye a madu hpang de she, ngai nhtang wa lu u ga law,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Shanhte gaw, “Dai rai taw gaw, dai numsha hpe anhte shaga la nna shi hpa mi naw tsun ra ai hpe san yu na ga ai,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Dai rai nna shan gaw Rebeka hpe shaga la nhtawm, “Nang ndai wa kaw hkan mayu nga n ni?,” ngu nna san mu ai. Shing rai nna shi mung, “Rai sa, hkan nang wa na nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Shing rai, shanhte gaw Rebeka hte shi a shingnan num hpe Abraham a shangun ma hte shi a masha ni hte rau hkan nang shangun mu ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Shanhte mung Rebeka hpe ning nga ai ga ni hte shaman ya mu ai: “Anhte a kajan e, nang gaw masha mun mun sen sen ni a kanu tai wa nit ga law! Na a amyu matu ni mung shanhte a gumlau hpyen ni shanu ai mare ni hpe madu la lu mu ga law!”
  </para>
  <para style="p">
    <verse number="61" style="v" />Dai hpang Rebeka hte shi a shangun ma numsha ni mung rawt nang nna Abraham a shangun ma wa hte rau wa na matu gawla-uk ni hta jawn let shanhte yawng pru mat wa ma ai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Isak gaw, “Ngai Hpe Mu Ai Asak Hkrung Ai Wa A Hka Htung” nga ai nam mali kata de sa wa nhtawm Hkanan mung a dingda daw de nga nga wu ai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Shi chyawm gaw shana maga de loi jau jau re ai aten hta pa layang hkan e hkawm chyai na nga, pru mat wa yang, gawla-uk ni wa ai hpe mu wu ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Rebeka mung Isak hpe mu wu yang, gawla-uk kaw nna yu nhtawm,
  </para>
  <para style="p">
    <verse number="65" style="v" />Abraham a shangun ma wa hpe, “Wora pa e anhte maga de hkawm sa wa ai wa gaw kadai wa rai nga a ta?,” ngu nna san wu ai. Dai shangun ma wa mung, “Shi gaw nye a madu rai nga ai,” ngu nna htan wu ai. Dai rai nna shi gaw du gyit sumpan hpe la nhtawm shi a myi man hpe magap da wu ai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Dai shangun ma wa mung shi galaw sai lam shagu Isak hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="67" style="v" />Dai hpang Isak gaw kanu Sara nga lai wa sai sum kata de woi shawn la wu ai. Rebeka mung shi a madu jan tai wa sai. Isak mung Rebeka hpe tsaw ra wu ai rai rai nna, kanu a yawn hta na shalan shabran hkrum wu ai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham mung Ketura mying ai kaga num langai mi hpe bai la wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai num gaw shi a matu Zimran, Yokshan, Medan, Midian Ishbak hte Shua ni hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yokshan gaw Sheba hte Dedan yan a kawa rai nna, Dedan a matu mara ni gaw Ashurim, Letushim hte Leumim ni rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Midian a kasha ni gaw Ehpa, Ehpera, Hanuk, Abida hte Eleda ni rai ma ai. Dai ni yawng gaw Ketura a matu mara ni rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham chyawm gaw shi lu ai sut rai mahkra Isak hpe jaw wu ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />rai ti mung shi naw hkrung nga yang, kaga num ni hta na Abraham lu ai shadang sha ni hpe mung kumhpaw kumhpa karan jaw wu ai. Dai hpang dai shadang sha ni hpe shi a shadang sha Isak kaw na tsan mat mu ga, lamu ga a sinpraw maga de shi dat dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya Abraham gaw shi a asak latsa e sanit shi manga ning du ai shaning hta si mat wa sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a kasha yan rai nga ai Isak hte Ishmaela yan gaw Heti masha Zohara a kasha Ehpron madu da ai Mamre a sinpraw maga na sun hta nga ai Makhpela ginlawng hku hta shi hpe lup makoi da ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai gaw Hiti masha ni kaw na Abraham mari da ai sun rai nga ai. Dai yang e, Abraham hte shi a madu jan Sara shan lahkawng hpe lup makoi da nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham si mat ai hpang, Karai Kasang gaw, “Ngai Hpe Mu Ai Asak Hkrung Nga Ai Hka Htung” a makau e shanu nga ai shi a shadang sha Isak hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sara a mayam Egutu num Hagara gaw Abraham a matu Ishmaela
  </para>
  <para style="p">
    <verse number="13" style="v" />hpe shangai ya wu ai rai nna dai shadang sha ni a shangai chyinghkai hkrat wa ai jahpan gaw ndai hku rai nga ai. Dai ni gaw Nabaiyut, Kedara, Adebela, Mibsam,
  </para>
  <para style="p">
    <verse number="14" style="v" />Mishma, Duma, Masa,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadad, Tema, Yetura, Nahpisha hte Kedema hte rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte gaw amyu bawsang shi lahkawng a kaji kawa ni rai nna, shanhte a kahtawng ni hte but ai dabang hku hkan nna dai ni a mying ni hpe jaw da mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ishmaela si mat ai shaloi shi a asak latsa e sumshi sanit ning rai nga wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ishmaela a matu mara ni gaw Egutu mung a sinpraw maga, Asuri mung de sa wa ai lam hta nga ai Hawila hte Shura lapran na lamu ga hkan e shanu nga ma ai. Shanhte gaw Abraham a amyu bawsang ni hte kaga san rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ndai gaw Abraham a kasha Isak a ahtik labau rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isak a asak mali shi ning du ai shaloi, Mesopotamia mung na Aramiyan masha Behtuela a shayi sha, Laban a kajan Rebeka hpe la wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rebeka maudung dung ai a majaw Isak gaw shi a matu dai Madu kaw akyu hpyi ya wu ai. Dai Madu mung shi a akyu hpyi ga hpe htan ya wu ai rai nna Rebeka hta na-um nasin rai wa lu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi hta marun hkan nau shangai wa na ra ai rai nna, garai n shangai ai hkritung ma yan gaw shi a kan kata hta shan shada da malan da ting gasat hkat ma ai. Shi gaw, “Ngai hta lama mi byin ai zawn nga ai gaw hpa majaw rai ang ai i?,” nga nna tsun wu ai. Dai rai nna dai mahtai a matu dai Madu hpe san na nga, pru sa wa wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai Madu gaw shi hpe, “Na a hkum hta amyu lahkawng nga lit dai; Shada da htinghtawng shingjawng hkat ai amyu lahkawng hpe nang shangai dat na rin dai. Langai wa mi gaw kaga wa hta grau n-gun ja na ra ai; Kaba ai wa mahtang kaji ai wa hpe daw jau na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi a shangai nhtoi gu wa ra ai. Shi hta shadang sha marun lahkawng kan hta rawng nga wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shawng shangai ai wa mahtang hkyeng ai nsam rawng nna shi a ahpyi mung mun tu ai nba hte bung nga ai. Dai rai nna shi hpe Esaw ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hpang na wa gaw Esaw a lahtin manat let shangai wa ai; dai rai nna shi hpe Yaku ngu nna shamying mu ai. Dai kasha yan hpe shaprat ai shaloi, Isak a asak kru shi ning du salu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai ma yan kaba wa nna, Esaw gaw kung kyang ai jaugawng tai wa nhtawm nam hkawm ai asak hkrun lam hpe ra sharawng ai wa rai nga ti mung, Yaku mahtang atsin zim re ai masha re ai majaw nta e sha nga nga wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isak gaw Esaw gyam jaw ai shan lusha sha ai hpe myit pyaw dum wu ai majaw Esaw hpe ra sharawng nga wu ai; rai ti mung Rebeka chyawm gaw Yaku hpe mahtang tsaw ra wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lani mi na aten hta, Yaku shapre si mai shadu nga yang, nam hkawm ai kaw nna Esaw shang wa wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shi kawsi nga wu ai majaw Yaku hpe, “Ngai hpe dai hkyeng ai si mai loi mi jaw e, ngai kawsi kyet nga nngai,” ngu nna tsun wu ai. (Dai rai nna shi hpe Edom ngu nna shamying mu ai.)
  </para>
  <para style="p">
    <verse number="31" style="v" />Yaku gaw, “Dai rai taw, na a hpu lat aya ngai hpe jaw ai rai yang, ndai mung nang hpe ngai jaw na we ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Esaw mung, “Ara rai sa, ya ngai si wa magang rai nga sayang, me, nye a hpu lat aya ngai hpe hpa baw mai kaja lam shabyin ya lu na rai nga a ni?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yaku gaw, “Dai rai yang, na a hpu lat aya ngai hpe jaw na matu shawng dagam u,” ngu nna htan wu ai. Esaw mung dagam nhtawm shi a hpu lat aya Yaku hpe jaw wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai hpang Yaku mung Esaw hpe muk hte si mai ntsin loi mi jaw wu ai. Shi mung dai ni hpe lu sha nhtawm bai rawt hkawm mat wa wu ai. Esaw gaw shi a hpu lat aya hpe n gawn n sawn di kau wu ai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham a prat hta byin ai hkuwa hta kaga, dai mung e hkuwa kaga mung naw nga nga ai. Isak gaw Gerara mare e nga ai Hpilisti Hkawhkam Abimelek hpang de sa mat wa wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu mung Isak kaw dan pru nna, “Egutu mung de hkum sa et; ngai nang hpe nga shangun ai ndai mungdan e nga u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ndai yang e nga u, ngai nang hte rau nga nga nna nang hpe shaman ya na nngai. Nang hpe mung, na a amyu matu ni hpe mung ndai mung ting ngai jaw na mawe ai; shing rai na nwa Abraham hpe ngai shagrin da sai ga sadi hpe ngai shatup na we ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a mayu matu ni hpe lamu na shagan ni zawn ngai shalaw na mawe ai rai nna, dai ni yawng hpe ndai mung ting ngai jaw na mawe ai. Amyu baw ni yawng mung na a amyu matu ni hpe ngai shaman ya ni ai hte maren shanhte hpe shaman ya na matu hpyi lajin wa na mara ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham gaw nye a ga madat nna nye a tara ni hte hkang da ai ga ni yawng hpe shadik shatup nu ai majaw ngai nang hpe shaman ya na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai majaw Isak gaw Gerara mare e nga nga wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai yang na lasha ni shi a madu jan a lam hpe san mu ai rai nna, shi gaw ngai jan re, ngu wu ai, hpa majaw nga yang, Rebeka nachying ahpraw tsawm htap nga ai rai nna, dai yang na lasha ni Isak hpe sat kau nhtawm Rebeka hpe woi la kau ya na hpe shi hkrit tsang nga wu ai majaw shi a madu jan rai nga ai hpe shi n yin la gwi wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya dai yang e Isak nga ai nhtoi tsawmra mi na jang, Hkawhkam Abimelek gaw hkuwawt hku nna gum yu dat wu yang, Isak hte Rebeka makrai chyai nga ma ai hpe mu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abimelek mung Isak hpe shaga la nhtawm, “Yu u, shi gaw na a madu jan rai nga lit dai! Dai re ai mi shi gaw na a kajan re ngu nna nang hpa rai tsun n ta?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abimelek mung, “Nang anhte hpe kaning rai galaw kau nu ni? Ndai yang na nye a lasha langai ngai na a madu jan hte aloi sha yup hkrup taw gaw, anhte shut hpyit ai mara a matu nang hta lit nga na lit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abimelek gaw shi a amyu masha ni yawng hpe, “Ndai wa hpe mung, shi a madu jan hpe mung, shut ai wa kadai mung sat kau ai hkrum na ru ai,” ngu nna sadi jaw wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu gaw Isak hpe shaman ya wu ai majaw, dai mung e shi yi galaw wu yang shawoi shi galaw yu sai shaning ni hta dai shaning e htam latsa grau nna shu la wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi gaw matut nna ngamu ngamai wa ai rai nna grai lu su wa wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sagu dumsu uhpung hte shangun ma law law shi lu ai majaw Hpilisti masha ni shi hpe yu manawn nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai re ai majaw Abraham naw hkrung nga yang shi kawa Abraham a shangun ma ni e htu da ai hka htung ni hpe shanhte kaput kau ya mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hpang Abimelek gaw Isak hpe, “Nang gaw anhte hta grau nna n-gun ja nga nit dai majaw anhte a mungdan kaw nna pru mat wa nu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai Isak gaw dai mung kaw na pru mat wa nhtawm Gerara Kadit e shi a sum hpe gap nna dai yang e nga nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Isak gaw kawa Abraham a aprat e htu nna shi si mat ai hpang e, Hpilisti masha ni kaput kau ya ai hka htung ni hpe bai htu hpaw ai hte de a amying ni hpe mung, shi kawa shamying da ya ai hte maren bai shamying da wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Isak a shangun ma ni mung dai kadit hta hka htung langai mi htu ma ai rai nna dai hta hka rawng ai hpe shanhte mu ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gerara na sagu rem ai ni hte Isak a sagu rem ai ni gaw, “Ndai hpe anhte she madu ga ai,” ngu nna tsun let ga law hkat ma ai. Dai majaw Isak gaw hka htung dai hpe, “Ga Law Ga La,” ngu nna shamying da nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Isak a shangun ma ni mung kaga hka htung langai mi hpe htu ma ai; dai hta mung ga law ga la byin ai majaw hka htung dai hpe “N Ju N Dawng” ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi mung dai yang na htawt nhtawm kaga hka htung langai bai htu wu ai. Dai hta chyawm gaw ndang kalang hpa mung n nga sai rai nna shi gaw dai shara hpe “Shanglawt” ngu nna shamying wu ai. Ya chyawm gaw dai Madu anhte hpe ndai ga e nga na matu anhte hpe shanglawt jaw nu ai; dai rai nna anhte ndai mung e ngamu ngamai wa saga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Isak gaw dai kaw nna pru nhtawm Berasheba de sa wa wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai shana jang, dai Madu gaw shi kaw dan pru nna, “Ngai gaw na a kawa Abraham a Karai Kasang rai nga nngai; hkum hkrit et, ngai nang hte rau rai nga nngai. Nye a shangun ma Abraham hpe jaw ai ga sadi hte maren, ngai nang hpe shaman ya nhtawm amyu matu law law mung nang hpe jaw na we ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Isak mung dai yang e tawn hkungri galaw nna dai Madu hpe nawku wu ai. Dai hpang shi a sum hpe dai yang e jung da ai hte shi a shangun ma ni mung kaga hka htung langai mi htu ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai shaloi, Abimelek gaw shi a hpaji jaw Ahuza hte shi a hpyen dap hpe up ai hpyen du Hpikola yan hte rau Isak hpe sa hkrum na nga, Gerara kaw nna pru sa wa ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai rai nna Isak gaw, “Shawng de nanhte ngai hpe grai wa n hku hkau myit dai. Nanhte a mung kaw nna mung ngai hpe pru mat wa shangun manit dai mi, ya hpa lam a majaw nanhte ngai kaw du sa nga myit ni?,” ngu nna hkap san wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte gaw, “Dai Madu nang hte rau nga nga ai hpe ya anhte chye saga ai. Dai majaw anhte a lapran hta dagam ai myit hkrum ga shaka langai mi tawn da na lam anhte myit lu ga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anhte nang hpe n machyi shangun ga ai zawn nang mung anhte hpe n machyi shangun na ga sadi hkam la na matu anhte ra sharawng nga ga ai. Nang hpe anhte yu matsan dum ga ai majaw ngwi pyaw simsa ai hte nanhte hpe pru wa shangun saga ai. Dai Madu nang hpe shaman ya nga sai gaw hpa ung ang shara n nga nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Isak gaw shanhte a matu lusha poi hkyen ya mu ai hte shanhte dai hpe lu sha nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hpang jahpawt manap jau jau aten hta, langai hte langai tinang nang a ga sadi hpe jaw nhtawm dai hpe dagam nna dazik dawk da mu ai. Isak gaw shanhte hpe wa manu yaw, ngu nna shakram dat nhtawm jinghku majing ni zawn shanhte n ja let hka bra mat wa ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai shani jang, Isak a shangun ma ni gaw, “Anhte hka mu saga ai,” nga nna shanhte htu da sai hka htung a lam shi hpe wa tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shi mung dai hka htung hpe, “Dagam Ga Shaka” ngu nna shamying wu ai. Dai gaw Berasheba mare mying lu wa ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ya Esaw a asak mali shi ning du jang, Heti numsha lahkawng rai nga ai Eri a shayi sha Yudit hte Elon a shayi sha Basemat yan hpe la wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai yan gaw Isak hte Rebeka hpe myit ru shoi chyum shangun mu ai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, Isak dingla wa nna myi amam wa wu ai majaw myi n mu lu nu ai. Shi a shadang sha kaba Esaw hpe shaga la nhtawm, “Ngai sha e,” ngu nna tsun wu ai. Shi mung, “Rai sa, nang e nga nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Isak gaw, “Ngai dingla nga ni ai rai nna kade n na yang, si mat na hpe nang mu na ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a ndan hte pala ni hpe la nhtawm prang de pru sa nna nye a matu shan sa tam sat wa rit.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai sha ra hkra mu mai ai hku lusha shadu nhtawm ngai hpang de la wa rit. Dai hpe sha ngut ai hte rau nye a nsa garai n htum mat ai laman, hpang jahtum ngai tsun na shaman ga, nang hpe ngai jaw na we ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isak gaw Esaw hpe shing nga tsun ai ga hpe Rebeka madat la wu ai. Esaw gaw shan tam na nga pru mat wa ai shaloi,
  </para>
  <para style="p">
    <verse number="6" style="v" />Rebeka gaw Yaku hpe, “Na a nwa gaw, ngai garai n si yang, dai Madu a man e nang hpe shaman ya de ga, nye a matu shan la wa nna dai hpe nye a matu shadu u,” nga nna Esaw hpe tsun ai na nwa a ga hpe ngai na ni ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rebeka gaw, “Ngai sha e, ya nye a ga hpe madat u; ngai tsun ai hte maren galaw u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya, dai bainam hpung de sa nna hpum tsawm ai bainam kasha lahkawng la wa rit; dai ni hpe ngai shadu nna na nwa grai sha ra ai hku lusha hpe lajang ya na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi garai n si yang shi nang hpe shaman jaw da lu u ga, dai shan shat mai shi sha na matu nang la wa ya lu na ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, Yaku mahtang shi a kanu hpe, “Esaw gaw amun tu ai wa rai nna, ngai chyawm gaw akrin sha rai nga nngai hpe nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nye wa ngai hpe hkap masawp yu na ra ai nhten; shi hpe ngai masu hkalem nga ai hpe shi chye kau na ra ai; ndai lam hku nna shaman ya ai hkam la na malai, ngai hkum nan matsa kau ai she hkrum sha nga na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi kanu gaw, “Ngai sha e nang hkrum na matsa mawa gaw nye a ntsa e she hkrat wa ru ga; ngai tsun ai hte maren she galaw u; nye a matu bainam kasha yan hpe sa la wa rit,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai majaw dai ni hpe shi sa la wa nna kanu kaw dun wa ya wu ai; kanu mung shi a kawa sha ra ai hku shan shat mai shadu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang Rebeka gaw nta e shi kaw nga ai Esaw a kaja htum ai hpun palawng hpe la nhtawm Yaku hpe jahpun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw bainam hpyi ni hte shi a lata hte amun n tu ai du hkan kayawp ya wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang mu mai ai shan shat mai hte shi kabaw ai muk hte hpawn Yaku a lata hta jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpang Yaku gaw kawa hpang de shang nhtawm, “Wa e!,” ngu nna tsun wu ai. Shi mung, “Rai sa, nga nga nngai,” ngu nna htan let, nang kadai mahtang rai nga n ni?,” ngu nna bai san wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yaku mahtang, “Ngai gaw na a kasha alat Esaw rai nga nngai, nang tsun ai hte maren galaw se ai; chyeju hte rawt dung nna ndai na a matu ngai la wa ya ai shan shat mai sha u; na a shaman ga ngai hpe jaw lu na rai ndai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isak gaw, “Ngai sha e, kaning rai ndai daram lawan nna mu tam a ni?,” ngu nna hkap san wu ai. Yaku mahtang, “Dai Madu na a Karai Kasang gaw ngai hpe karum la ai hte mu tam la nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Isak gaw Yaku hpe, “Nang Esaw teng teng rai nga n ni? Ngai nang hpe masawp yu lu n ga, chyeju hte ngai hpang de sit wa yu rit,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yaku mung shi a kawa hpang de sit wa nna shi hpe masawp yu let, “Na a nsen gaw Yaku a nsen, lata chyawm gaw Esaw a lata zawn rai nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yaku a lata gaw Esaw zawn mun tu nga wu ai majaw, Isak gaw shi hpe n chye matsing nga wu ai. Isak gaw shi a shaman ga Yaku hpe jaw hkyen nga nu ai;
  </para>
  <para style="p">
    <verse number="24" style="v" />rai ti mung, “Nang teng teng Esaw rai nga n ni?,” ngu nna bai kahtap san wu ai. Shi mung, “Ngai rai nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Isak gaw, “Dai rai taw gaw, shan shat mai la wa yu rit. Dai hpe sha ngut jang, nye a shaman ga ngai nang hpe jaw na de ai,” ngu nna tsun wu ai. Yaku gaw shan shat mai hpe shi hpang de la wa nhtawm lu na matu sabyi ntsin hpe mung la wa ya wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hpang shi a kawa mung Yaku hpe, “Ngai sha e, ngai kaw sit wa nna, ngai hpe pup e,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yaku mung sit lung wa nna shi hpe pup wu ai; Isak gaw shi a palawng sama hpe manam la nhtawm shi hpe shaman ya wu ai. Shi gaw, “Nye kasha a manam pyaw ai sama gaw dai Madu shaman ya ai yi hkauna nngawt bat hte bung nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Karai Kasang gaw nang hpe lamu na numri jaw ya nhtawm na a yi sun hkauna ni hpe ga sau tung shangun u ga! Nai mam law law hte sabyi ntsin ni mung nang hpe jaw na nit dai!
  </para>
  <para style="p">
    <verse number="29" style="v" />Masha amyu baw ni na a shangun ma ni tai mat mu ga; amyu masha ni mung nang hpe dingnyawm gum dagup nga mu ga. Na amyu matu mara ni yawng hpe nang up hkang nna na ningnu a amyu matu ni na a man e dingnyawm nga mu ga; nang hpe matsa ai ni matsa ai bai hkrum mu ga; nang hpe shaman ai ni shaman ai bai hkrum mu ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ya, Isak gaw shi a shaman ga jaw ngut ai hte Yaku pru mat wa ai hpang kade n na yang, shi a kahpu Esaw shan tam ai kaw nna du shang wa wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi mung shan shat mai shadu ngut ai hpang kawa kaw la wa wu ai. Shi gaw, “Wa e, chyeju hte rawt dung nna na a matu ngai la wa ya ai ndai shan shat mai hpe sha ya e, shaloi na a shaman ga ngai hpe jaw lu na ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Isak gaw, “Rai taw, nang kadai rai nga n ta?,” ngu nna shi san wu ai. Shi gaw, “Na a nsha alat Esaw wa rai nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Isak gaw, “Ataw, dusat hpe sat nna ngai kaw la sa wa ai wa gaw kadai ta? Nang garai n du yang ngai dai hpe sha kau se ai. Shi hpe nye a hpang jahtum na shaman ga hte shaman kau ni ai rai nna dai gaw shi hta htani htana agrin nga na ra ai,” ngu nna grai gari ashun ai hte san wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai lam hpe Esaw na jang, ja ja jahtau hkrap let, “Wa e, na a shaman ga ngai hpe mung jaw e law!,” ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Isak gaw, “Na nnau wa sa nna ngai hpe masu hkalem kau ni ai. Na shaman chyeju hpe mung shi la kau nu ai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Esaw gaw, “Ndai lang hte lahkawng lang shi ngai hpe maw sha kau nu ai. Dai rai nna shi a mying Yaku rai nga wu ai gaw hpa mau shara n rai nga ai. Nye a hpu lat aya hpe mung shi la kau nu ai. Ya mung nye a shaman chyeju hpe la kau ya nu ai. Nye a matu shaman chyeju langai mi mung nang n ngam da ya sani?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Isak gaw, “Ngai shi hpe na a madu tai shangun se ai. Shi a amyu matu mara ni yawng mung shi a mayam ni tai mat shangun kau se ai. Nai mam hte sabyi ntsin mung ngai shi hpe jaw se ai. Ngai sha e, ya gaw na a matu ngai galaw ya lu ai lam hpa mung n nga sai!,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Rai ti mung, Esaw mahtang shi a kawa hpe, “Wa e, nang gaw shaman chyeju langai sha lu n ni? Wa e, ngai hpe mung shaman ya e!,” ngu nna jahtau hkrap let matut hpyi lajin wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai hpang Isak gaw shi hpe, “Na a matu lamu na numri hkrat na n rai; Na a matu ga sau rawng ai yi sun hkauna ni nga na n rai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Na a nhtu hte nang hkrung nga lu na ndai. Rai ti mung na a kanau a mayam tai nga u; Nang gumlau rawt yang, shi a reng hkang ai hpe nang daw kau ya lu na rin dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Yaku hpe shi kawa jaw ya ai shaman chyeju a majaw Esaw mahtang Yaku hpe n dawng da wu ai. Esaw gaw, “Nye wa a si hkrung si htan hta yawn hkyen na aten gaw ni wa sai; shaloi Yaku hpe ngai sat kau na we ai,” ngu nna shi hkum hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Rai ti mung, Esaw a yaw shada ai lam hpe Rebeka na wu ai rai nna Yaku hpe shaga la nhtawm, “Madat u, na a nhpu Esaw nang hpe mara tam nna sat kau na maw nga ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Dai majaw, ngai sha e, ngai tsun ai hte maren, ya jang galaw u. Haran e nga ai ngai yung Laban hpang de ya jang rawt sa wa su.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na nhpu masin kawp nna nang shi hpe di ai amu ni hpe shi malap kau ai aten du hkra, shi kaw tawng marang mi sa nga su;
  </para>
  <para style="p">
    <verse number="45" style="v" />dai hpang nang hpe sa woi la na matu marai langai ngai hpe shangun dat ya na nngai. Dai rai nna, lani jan hta sha, nye kasha lahkawng yan hpe ngai hpa majaw jasum kau na rai nga a ni?, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Rebeka gaw Isak hpe, “Ngai gaw Esaw a maigan num ni a majaw hki ba ai hte masin yu machyi la nga nngai. Yaku mung ndai Heti numsha ni hta na langai mi hpe la hkrup ai rai yang gaw si mat na mahtang ngai ging nga nngai,” ngu nna tsun wu ai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isak gaw Yaku hpe shaga la ai hte shaman ya nna, “Hkanan numsha langai mi hpe mung hkum la et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mesopotamia mung de sa nna, na a nji Behtuela a nta de mahtang sa wa nhtawm, dai yang na na ntsa Laban a shayi sha langai ngai hpe sa la su.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chyahtum Chyalai N-gun Rawng Ai Karai Kasang gaw na a dinghku de sa wa ai lam hpe shaman ya nhtawm, kashu kasha law law nang hpe jaw ya u ga; shaloi nang gaw amyu baw law law ni a kawa tai wa na rin dai!
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang hpe mung, na a amyu matu ni hpe mung, Abraham hpe shi shaman ya ai zawn shaman ya nga u ga. Karai Kasang Abraham hpe jaw ai ya nang shanu nga ai ndai lamu ga hpe nang madu lu na rin dai!,” ngu nna tsun dat wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isak gaw Esaw yan Yaku a kanu Rebeka a kayung Aramiyan masha Behtuela a kasha, Mesopotamia mung e nga ai Laban hpang de Yaku hpe shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Isak gaw Yaku hpe shaman ya nhtawm num sa la na matu Mesopotamia mung de shangun dat sai hpe Esaw chye wu ai. Isak shi hpe shaman ya ai shaloi Hkanan numsha hpe n la na matu hkang da wu ai hpe mung chye wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kanu yan kawa a ga madat nna Mesopotamia mung de sa mat wa ai hpe shi mu chye wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a kawa Isak Hkanan numsha ni hpe n ra sharawng nga ai hpe Esaw mu chye wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna Abraham a kasha Ishmaela hpang de sa nhtawm Nabaiyut a kajan rai nga ai Ishmaela a shayi sha Mahalat hpe la wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Yaku gaw Berasheba kaw nna pru wa nhtawm Haran maga de sa wa wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shana maga jan du wa ai aten hta, chyoi pra ai shara langai mi de shi du nna, dai yang e sum galaw wu ai. Dai hpang nlung langai mi a ntsa e, shi baw bunghkum let yup nga wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai shaloi ginding aga kaw nna lamu du hkra hkap ai lakang langai mi hta lamu kasa ni lung lung yu yu re ai yup mang hpe shi mu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw dai yang na shi a makau e tsap nga nhtawm, “Ngai gaw Abraham, Isak ni a dai Madu Karai Kasang rai nga nngai; nang hpe mung, na a amyu matu ni hpe mung ndai lamu ga hpe ngai jaw na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte gaw ga na nhpu ni zawn law htam wa na mara ai. Shanhte gaw lamu ga man yawng de shanhte a lamu ga maden kung dam wa na mara ai. Nang hte na a amyu matu ni a jaw e, amyu baw ni yawng hpe ngai shaman ya na we ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yu u, ngai nang hte rau rai nga nngai mung, nang hkawm sa ai shara shagu hkan nang hpe ngai makawp maga ai hpe mung, ndai mung de nang hpe bai woi wa na lam hpe mung, adum nga u. Ngai nang hpe ga sadi jaw da sai amu yawng mayawng hpe galaw shatup ngut ai aten du hkra, nang hpe ngai kau da na nngai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yaku yup hprang wa nna, “Dai Madu nang e nga nga a hka! Shi ndai shara hta nan nga nga ai hpe ngai n chye kau ni hka!,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw hkrit ai hte, “Shara ndai gaw hkrit mai ai shara rai nga a hka! Dai shara gaw Karai Kasang a nta hte sumsing lamu a chyinghka lam rai nga a hka!,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yaku gaw hpang jahpawt jau jau rawt nna, shi bunghkum ai nlung hpe la nhtawm masat dingsat hku jung da wu ai. Dai hpang de a ntsa e tsanlun sau ru bun let Karai Kasang hpe ap nawng da wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai shara hpe Behtela ngu nna shamying wu ai. (Dai mare hpe shawng de Luza ngu nna mung shamying ma ai.)
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai shara hpe Yaku gaw dai Madu hpe, “Nye wa a nta de shim lum ai hte ngai bai nhtang wa lu hkra,
  </para>
  <para style="p">
    <verse number="21" style="v" />nang gaw nye a Karai Kasang tai nga let, ngai hte rau nga nga nhtawm ngai hkawm sa nga ai hkrun lam hpe makawp maga ya nna, lusha hte hpun palawng ngai hpe jaw ai rai yang gaw,
  </para>
  <para style="p">
    <verse number="22" style="v" />ndai ngai jung da se ai masat dingsat nlung gaw nang hpe nawku ai shara tai na ra ai. Nang ngai hpe jaw ai mahkra a htam shi hta na htam mi, ngai nang hpe jaw na we ai,” ngu nna dagam shaka wu ai.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, Yaku gaw shi a hkrun lam hta matut hkawm sa wa nna, sinpraw maga na lamu ga de shanang sa wa wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw pa layang e hka htung langai mi nga nna de a grup yin hkan sagu hpung masum hpum jawng nga ai shara de akajawng sha hprawt rai du shang wa wu ai. Sagu hpung ni hpe ndai hka htung kaw na hka jaw lu ma ai. Dai hka htung magap gaw nlung kaba rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai yang e, sagu hpung ni yawng hpe rau jahpawng da ngut jang, sagu rem ni gaw hka htung magap ai nlung hpe kanawng sit da nhtawm sagu ni hpe hka ja jaw jaw rai ma ai; dai hpang nlung dai hpe mi na shara hta bai magap da da di mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yaku gaw sagu rem ai ni hpe, “Nye a jinghku ni e, nanhte kanang na rai nga myit ta?,” ngu nna san wu ai. Shanhte mung, “Haran ga na ni rai nga ga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw, “Nahora a kashu Laban hpe nanhte chye myit ni?” ngu nna san wu ai. Shanhte mung, “Rai sa, anhte chye ga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw, “Shi hkam kaja nga a ni?,” ngu nna san wu ai. Shanhte gaw, “Shi hkam kaja nga ai, yu u, shi a shayi sha Rahkela mung sagu hpung hte rau nang de sa wa nga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yaku mung, “Yu mu, jan naw rawng nga ai; sagu ni hpe jahpawng da na aten garai n du ai mi; nanhte hpa majaw dai ni hpe hka jaw nga myit ni? Dai ni hpe udat shara de naw gau sa wa mu,” ngu nna shanhte hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw, “Sagu hpung ni yawng ndai shara de shinggyin du hpawng wa nna, dai nlung hpe n la kau dingsa anhte dai hku n lu galaw na ga ai. Dai hpang mahtang anhte gaw sagu hpung ni hpe hka ja jaw lu na ga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yaku gaw shanhte hte ga naw shaga nga yang, sagu hpung ni hte rau Rahkela du sa wa nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rahkela hte rau shi katsa Laban a sagu hpung hpe Yaku mu dat yang, hka htung de shi sit sa nhtawm dai hka htung magap nlung hpe shi kanawng sit da let, sagu ni hpe hka ja jaw wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang Yaku gaw shi hpe pup nhtawm kabu gara jahtau wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw Rahkela hpe, “Ngai gaw na nwa a amyu rai nna, Rebeka a kasha rai nga nngai,” ngu nna tsun dan wu ai. Rahkela gaw shi a kawa hpe wa tsun dan na nga gat mat wa wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Laban mung shi a kahkri Yaku a lam hpe na jang, shi hpe tau la na nga, gat sa wa nna shi hpe ahpum pup let nta de woi wa wu ai. Yaku mung byin mabyin mahkra Laban hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Laban gaw, “Rai sa, nang gaw kaja wa sha nye a ashan hte asai nan rai nga ndai,” ngu nna tsun wu ai. Shing rai Yaku gaw dai yang e shata mi tup nga nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Laban gaw Yaku hpe, “Nang mung nye a amyu rai nga ndai majaw nye a matu kaman lila sha gaw n galaw kau ang na ndai. Nang hpe shabri shabrai kade wa jaw na ra n ni?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Laban hta shayi sha lahkawng lu da wu ai rai nna, kaba ai gaw Lea rai nna kaji wa gaw Rahkela rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lea gaw myi tsawm nga ti mung, Rahkela mahtang hkum hkrang tsawm nna ahpraw mung htap nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yaku mahtang Rahkela hpe tsaw ra wu ai rai nna, shi gaw Laban hpe, “Nang hkraw n yang gaw, Rahkela hpe jaw sha e; shaloi na a matu sanit ning tup ngai amu galaw jaw na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban mung, “Kaga masha ni hta nang hpe ya sha na gaw grau mai kaja nga ai. Ndai yang e ngai hte rau nga ga,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yaku gaw Rahkela a matu sanit ning galaw jaw wu ai rai nna shi hpe lu la ang nu ai. Shi mahtang Rahkela hpe tsaw ra wu ai majaw shi a matu nhtoi kade ya n na ai zawn nawn kau wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang Yaku gaw Laban hpe, “Ladaw da ai aten du sai, ya na a shayi sha hpe la nit ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Laban mung masha shagu hte hpe saw shaga nhtawm hkungran poi galaw ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai ti mung dai shana jang, Laban gaw Rahkela a malai Lea hpe Yaku hpang de woi sa ya nna, Yaku mung shi hte kanawn kau wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />(Bai Lea a shingnan num tai na matu shi a mayam num Zilhpa hpe mung Laban ap ya wu ai.)
  </para>
  <para style="p">
    <verse number="25" style="v" />Hpang jahpawt rai jang, Lea rai nga ai hpe Yaku mu ai rai nna, Laban hpang de sa nhtawm, “Ndai amu ngai hpe nang hpa majaw galaw n ta? Rahkela a matu ngu nna she, ngai galaw ai mi, nang ngai hpe hpa majaw maw sha kau n ta?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban mahtang, “Kaba ai hpe shawng garai n ya sha yang, kaji ai shayi sha hpe shawng ya sha ai gaw ndai ga na htung masa n rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hkungran poi galaw ai ndai bat lapran mi lai hkra naw la u; shing rai nye a matu sanit ning nang naw galaw jaw na rai yang, nang hpe Rahkela jaw sha na de ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yaku mung myit hkrum ya wu ai rai nna hkungran poi galaw ai bat lapran mi lai mat ai hpang Laban gaw Yaku hpe shi a shayi sha Rahkela hpe Yaku a madu jan tai na matu ya sha wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />(Rahkela a shingnan num tai na matu shi a mayam num Bila hpe mung Laban ap ya wu ai.)
  </para>
  <para style="p">
    <verse number="30" style="v" />Yaku mung Rahkela hte kanawn wu ai rai nna Lea hta shi hpe mahtang grau tsaw ra wu ai. Shi gaw Laban a matu sanit ning naw galaw jaw wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lea mahtang Rahkela daram tsaw ra myit hpring hpring n hkam la hkrum wu ai hpe dai Madu mu ai shaloi, kashu kasha shaprat na lam hpaw ya wu ai; rai ti mung Rahkela hpe chyawm gaw maudung dung shangun da wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lea hta na-um nasin hkum tai wa nna shadang sha langai shangai wu ai. Lea gaw, “ Madu nye a tsin-yam tsindam hpe mu ya nu ai. Ya chyawm gaw nye madu wa ngai hpe tsaw ra lu na nu ai,” ngu nna tsun wu ai. Shing rai shi hpe Rubin ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shi hta na-um nasin hkum bai tai wa nna, shadang sha bai shangai wu ai. Lea gaw, “Dai Madu ngai hpe ndai shadang sha jaw ya ni ai; hpa majaw nga yang ngai n dawng n yawt hkrum nga ai hpe shi na ya nu ai,” ngu nna tsun wu ai. Dai rai nna shi hpe Simun ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi hta na-um nasin hkum bai tai wa nna shadang sha langai bai shangai wu ai. Shi gaw, “Ya chyawm gaw ngai shi a matu shadang sha masum hpe shangai ya ni ai majaw, nye a madu wa ngai hte grau kanawn na ru ai,” ngu nna tsun wu ai. Shi hpe Lewi ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai hpang mung shi hta na-um nasin hkum bai tai wa nna shadang sha kaga langai mi hpe shangai wu ai. Shi gaw, “Ya gaw dai Madu hpe ngai shakawn na we ai,” ngu nna tsun nhtawm shi hpe Yuda ngu nna shamying wu ai. Dai hpang shi gaw kasha n shangai ai sha nga mat ai.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rai ti mung, Rahkela mahtang Yaku a matu kasha n shangai ya dum wu ai majaw, shi a kana jan hpe yu manawn nga ai rai nna Yaku hpe, “Ngai hpe kasha jaw e, dai n rai yang, ngai si mat na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yaku gaw Rahkela hpe masin pawt let, “Karai Kasang a shara hta ngai n nga lu nngai; kashu kasha n shaprat shangun lu ai mung shi chyu sha re,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rahkela gaw, “Ndai yang e, nye a mayam num Bila nga nga ai; shi hte rau yup u, nye a matu shayi shadang sha shaprat ya lu na rai wu ai. Dai lam hku nna sha, ngai mung shi a marang e kanu tai lu na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna shi a madu wa hpang de Bila hpe ap ya wu ai rai nna Yaku mung shi hte kanawn wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bila hta na-um nasin hkum tai wa nna Yaku a matu shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rahkela gaw, “Nye a maga de Karai Kasang jeyang ya ni ai rai nna, nye a akyu hpyi ga hpe shi na ya nu ai. Dai rai nna shi hpe Dan. ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bila mung na-um nasin hkum bai tai wa nna, Yaku a matu lahkawng ngu na shadang sha hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rahkela gaw, “Nye a kana hpe aja awa gasat nna dang kau se ai,” ngu nna tsun wu ai. Dai rai nna shi hpe Naphtali ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lea gaw shi hta kashu kasha n shaprat mat sai hpe dum wu yang, shi a mayam num Zilhpa hpe Yaku a madu jan shatai na shi hpe jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hpang Zilhpa gaw Yaku a matu shadang sha langai shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lea gaw, “Ngai gam rawng nngai,” ngu nna tsun wu ai. Dai rai nna shi hpe Gad ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zilhpa gaw Yaku a matu kaga shadang sha langai shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lea gaw, “Ngai kade sha a lu nga n hka! Ya chyawm gaw numsha ni ngai hpe a lu ai jan ngu nna shaga na mi ai,” ngu nna tsun wu ai; dai rai nna shi hpe Ashe ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Rubin gaw hkaulan mam dan ai aten e, yi sun ni de pru sa nhtawm dudim si mu wu ai rai nna kanu Lea hpang de la wa wu ai. Rahkela gaw Lea hpe, “Chyeju hte na nsha la wa ai dudim si loi mi ngai hpe jaw e,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lea gaw, “Nye a madu wa hpe la kau ya ai pyi nang n law dum n ni? Ya mung nye a dudim si ni hpe la kau ya na nang naw shakut nga n hka i?,” ngu nna htan wu ai. Rahkela mung, “Na nsha a dudim si ni ngai hpe nang jaw ai rai yang, dai na jang Yaku hte nang lu yup na ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya shana maga de, Yaku gaw pa de na wa yang, Lea gaw shi hpe tau la matu pru sa wa nhtawm, “Ngai sha a dudim si hte ngai nang hpe mari la sade ai majaw, nang ngai kaw dai na shang yup lu na ndai,” ngu nna tsun wu ai. Shi gaw dai shana e Lea hte kanawn kau wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Kasang gaw Lea akyu hpyi ai ga hpe htan ya wu ai rai nna shi hta na-um nasin hkum tai wa ai hte Yaku a matu manga ngu na shadang sha hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lea gaw, “Nye a madu hpe mayam num ya sha ni ai majaw, Karai Kasang gaw ngai hpe shabrai jaw ni ai,” ngu nna tsun wu ai. Dai rai nna shi hpe Yisahka ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lea hta na-um nasin hkum bai tai wa nna Yaku a matu kru ngu na shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi gaw, “Karai Kasang ngai hpe kaja ai kumhpa langai jaw ni ai. Dai rai nna ya chyawm gaw ngai shi a matu shadang sha kru shangai ya ni ai majaw nye a madu wa ngai hpe hkap la na ru ai,” ngu nna tsun wu ai. Dai rai nna shi hpe Zebulun ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang shayi sha langai shi shangai ai rai nna shi hpe Dina ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang gaw Rahkela hpe dum wu ai rai nna shi a akyu hpyi ga hpe htan ya ai hte kashu kasha shaprat na lam hpaw ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi hta na-um nasin hkum tai wa nna shadang sha langai shangai wu ai. Shi gaw, “Karai Kasang ngai hpe shadang sha jaw ya ai majaw nye a shatan nhkan hpe la kau ya nu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai Madu ngai hpe shadang sha langai naw jaw ru ga,” ngu nna tsun wu ai. Dai rai nna shi hpe Yosep ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yosep hpe shangai ai hpang, Yaku gaw Laban hpe, “Nye a dum nta buga de nhtang wa lu n ga, ngai hpe wa shangun e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ngai nang hpe galaw jaw nna lu da sai nye a madu jan ni hte kashu kasha ni hpe dat ya e; ngai pru mat wa na ni ai. Ngai nang hpe kade daram shakut nna daw jau se ai gaw nang chye nga ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Laban gaw shi hpe, “Ndai lam ngai naw tsun yu n ga; na a majaw dai Madu ngai hpe shaman ya ni ai gaw wenyi a n-gun atsam a jaw e ngai dum chye ni ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na a shabrai ni hpe daw dan u; dai ni hpe ngai jaw na we ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yaku mahtang, “Ngai nang hpe kaning rai galaw jaw sai mung, na a sagu bainam hpung ni hpe nye a lata hte bau maka dat ai hta kade sha galu kaba law htam wa sai hpe mung nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngai garai n du yang, na a sut gan loi sha mi she rai nga lit dai. Ya chyawm gaw manu mana jat wa nit dai. Ngai du ai shara shagu hta dai Madu nang hpe shaman ya nit dai. Ya chyawm gaw nye a sut gan amyat shachyip la na aten mung rai nga sali ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Laban gaw, “Nang hpe hpa jaw na rai ta?, ngu nna san wu ai. Yaku mahtang, “Ngai hpa shabrai ni hpe mung n ra nngai. Ndai hpaji jaw ga hpe nang myit hkrum ya ai rai yang chyawm gaw na a sagu bainam hpung ni hpe matut nna sin rem ya na nngai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai ni jang, na a yam nga uhpung ni nga ai de ngai sa nhtawm, chyang ai sagu kasha shagu hte aprup aprap ateng apang re ai bainam kasha ni hpe la da na we ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai gaw ngai ra ai shabrai yawng rai nga li ai. Dai rai jang, htawm hpang e, nye a shabrai ni hpe nang sa jep yang, ngai ding man nga ai hpe nang aloi sha mu lu na rin dai; aprup aprap ateng apang re ai bainam kasha ni hte n chyang ai sagu kasha ni ngai hta lawm wa ai rai yang chyawm gaw dai gaw lagu la ai ni rai nga ai ngu, nang chye la lu na ndai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Laban mung, “Rai sa, myit hkrum ni ai, nang hpaji jaw ai hte maren, ya an galaw wa yu saga,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Rai ti mung, dai shani jang, Laban gaw ka ka kawk kawk re ai hte ateng apang re ai bainam la ni hte aprup aprap ateng apang re ai hte hpraw ai ka ai ayi ni yawng hte chyang ai sagu ni yawng hpe mung htawt kau wu ai. Shi gaw dai ni hpe shi kasha ni hpe ap kau wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Yaku hte masum ya sat tsan ai shara hta dai yam nga hpung hpe sa tawn da shangun wu ai. Yaku chyawm gaw ngam ai Laban a sagu bainam hpung ni hpe bau rem ya nga wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Yaku gaw popala, batan hte paling hpun na tsit ai hpun lakung ni hpe dan la nna hpun hpyi nkau mi hpe gang gaw wu ai; dai lakung ni hta ahpraw bai bai rai hkra gadoi dumrit ashit da wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shi gaw dai lakung ni hpe yam nga ni sa lu ai shanhte a ntsin htung ni hta, sagu bainam ni a man hkan e tawn da ya wu ai. Yam nga ni dai yang e hka sa lu nna uli lung ma ai majaw dai lakung ni hpe shi jung da ya wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai rai nna bainam ni dai lakung ni a man e uli lung ai shaloi, ka ka shit shit, aprup aprap ateng apang re ai bainam kasha ni hkrat shajang nga ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Yaku gaw sagu ni hte bainam ni hpe garan ginhka da nhtawm, ka ka shit shit re ai hte Laban a sagu bainam hpung na chyang ai ni de man yawng shangun wu ai. Ndai lam hku nna shi a sagu bainam ni hpe Laban a hpung ni kaw na kaga ga jahka tawn wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />N-gun ja ai yam nga ni uli lung ma ai shaloi, Yaku gaw ntsin htung ni hta dai yam nga ni a man e, lakung ni hpe jung da ya wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dai ni mung lakung ni a lapran e uli lung ma ai. Rai ti mung, n-gun kya ai yam nga ni a man e chyawm gaw shi n jung da ya wu ai. Dai rai nna kade n na yang, n-gun kya ai yam nga ni yawng gaw Laban a matu rai nna, n-gun ja ai ni mahtang Yaku a matu rai nga ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ndai lam hku nna, Yaku gaw grai lu su ai wa tai wa nna sagu bainam hpung, mayam num mayam la, gawla-uk ni hte lawze law law hpe shi lu la wu ai.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Laban a shadang sha ni gaw, “Anhte a kawa madu da ai sut gan nga manga hpe Yaku e la kau ya nu ai; shi a sut gan lu malu yawng mung wa a marang e, lu su wa salu ai,” ngu nna tsun shajang nga ma ai hpe Yaku na wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Laban gaw shawng de na zawn hku lahkun n rai mat sai hpe mung shi mu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hpang dai Madu gaw shi hpe, “Na a nwa ni hte na a bawsang ni nga ai mung de bai wa nu; ngai nang hte rau anga nga na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai re ai majaw, Yaku gaw Rahkela hte Lea hpe shi a sagu bainam hpung ni nga ai pa ga de shi hpe sa hkrum na matu shiga shana dat wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw shan hpe, “Nan a nwa gaw ngai hpe shawoi na zawn hku lahkun n rai nga ai hpe ngai mu mada ni ai; rai ti mung, nye wa a Karai Kasang chyawm gaw ngai hte rau nga nga li ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a n-gun atsam yawng hte nan a nwa hpe ngai galaw jaw se ai gaw, nan lahkawng mung chye nga myit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ti mung, shi mahtang ngai hpe maw sha nna nye a shabrai hpe shi lang galai kau ya ni ai. Rai ti mung ngai hpe jasum machyi shangun na Karai Kasang n hkraw nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Laban mahtang, “Dai aprup aprap re ai bainam hpung ni yawng gaw na a shabrai ni rai nga lit dai,” ngu wu yang, bainam hpung ni yawng aprup aprap re ai bainam kasha ni hkrat shajang ma ai. Shi gaw, ‘Ka ka shit shit re ai bainam kasha ni gaw na a shabrai ni rai u ga,’ ngu wu yang, dai bainam hpung ni yawng ka ka shit shit re ai bainam kasha ni hkrat shajang ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang gaw nan a nwa a sagu bainam ni hpe shaw la nna ngai hpe jaw ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Uli lung ai aten hta ngai mada yu we yang, uli lung ai bainam la ni gaw ka ka shit shit, aprup aprap, ateng apang re ai ni rai nga ma ai hpe ngai yup mang mu we ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang a lamu kasa gaw ngai hpe yup mang hta, “Yaku e! ngu nngai; ngai mung, ‘Rai sa, nang nga nga nngai,’” ngu nna htan we ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw, ‘Mada yu u, uli lung ai bainam la ni yawng ka ka shit shit re ai hte aprup aprap ateng apang re ai ni hkrai rai ma ai. Nang hpe Laban e galaw ai lam yawng mayawng hpe ngai mu se ai majaw ndai lam hpe ngai shabyin ai re.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang gaw masat dingsat nlung hta tsanlun sau ru bun nna, ngai hpe ga shaka hte dagam da ai dai Behtela e nang hpe shadan dan ai Karai Kasang rai nga nngai. Ya chyawm gaw na a daidaw ga de nhtang wa na matu jin jin di da sanu,’” ngu nna matut tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rahkela hte Lea mung Yaku hpe, “An a matu, wa kaw na hkam la na sali wunli hpa mung n nga sai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi an hpe maigan masha ni hpe zawn di mani ai. An hpe mung shi dut kau nu ai. An hpe jaw ra ai gumhpraw yawng mung shi jai kau nu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />An a kawa kaw na Karai Kasang shaw ya ai ndai sut gan yawng gaw an a matu hte an a kasha ni a matu rai nga mali ai. Dai majaw Karai Kasang nang hpe tsun matsun ai hte maren she galaw nu,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna Yaku gaw shi a kawa nga ai Hkanan mung de nhtang wa na matu shajin da nu ai. Shi a kasha ni hpe mung, madu jan ni hpe mung gawla-uk ni hta shajawn nna Mesopotamia mung e shi lu la sai sut gan yawng hte hpawn shi a shawng e yam nga hpung ni yawng hpe gau let woi pru wa wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ya Laban gaw sagu mun rep na nga, hkawm mat wa ai laman e, Rahkela gaw nta na gumgun gumhpai hpara sumla ni hpe lagu mat wa ya wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yaku mung shi pru mat wa na lam n chye shangun ai sha, Laban hpe zai hte hkalem kau da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi gaw shi lu da ai sut gan yawng hpe la nna tin tin pru mat wa wu ai. Shing rai Uhprat hka nu rap kawt kau nhtawm Gilead bum ga de yawng let pru sa wa nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya masum ya na ai hpang, Yaku hprawng mat wa sai lam Laban hpe tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw shi a masha ni hpe woi nhtawm sanit ya tup hkan shachyut yang, Yaku hpe Gilead bum ga e hkan dep wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Karai Kasang mung dai shana e yup mang hta Laban kaw dan pru nhtawm, “Yaku hpe hpa lam hku mung n jahkrit shama ai sha, sadi nga u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yaku gaw shi a sum dabang hpe bum langai a ntsa e gap da nu ai; Laban mung shi a jinghku ni hte Gilead bum ga hta but nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban gaw Yaku hpe, “Nang gaw ngai hpe zai hte hkalem kau da nna majan hta rim la ai num ni hpe zawn nye a shayi sha ni hpe hpa majaw woi mat wa n ni?
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang gaw ngai hpe zai hte hkalem kau da nna, hpa mung n tsun ai sha, hpa majaw lagyim pru mat wa n ni? Nang ngai hpe tsun dan taw gaw, nang hkawm sa wa na hkrun lam ting hta tingse sumpyi ni hte mahkawn mangoi let kabu gara ai hte nang hpe shabawn dat lu na rai nngai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ya gaw ngai shu ni hte ngai sha ni hpe pyi n lu pup, n lu shakram dat lu hkra, nang galaw nit hka! Dai gaw angawk ai amu rai nga sai!
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang hta machyi hkrum mat hkra galaw lu na n-gun atsam ngai lu nngai, rai ti mung, mana e, na nwa a Karai Kasang gaw hpa lam hku nna mung nang hpe n jahkrit shama na lam ngai hpe sadi jaw da ni ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nang na a dum nta de nhtang wa na grai myit katu ai a majaw, wa ai gaw ngai chye na nngai; rai ti mung nye nta na gumgun gumhpai hpara sumla ni hpe nang hpa majaw lagu la nit ni?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yaku gaw, “Na a shayi sha yan hpe nye a lata kaw na nang woi la kau ya na ndai ngu ngai myit nawn ai hte hkrit ai majaw rai sai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Rai ti mung, ndai yang, na a gumgun gumhpai hpara sumla ni hpe kadai wa kaw nang mu hkrup ai rai yang, dai wa gaw si lu na rai wu ai. Ndai yang e nga ai anhte a masha ni hpe sakse shatai nhtawm nang hte seng ai arai hpa hpe mung tam nna dai ni hpe la u,” ngu nna htan wu ai. Yaku mahtang Laban a hpara sumla ni hpe Rahkela e lagu da ai hpe n chye da wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Laban gaw Yaku a sum, dai hpang Lea a sum, dai hpang mayam num lahkawng a sum de sa tam wu ai rai ti mung, shi a hpara sumla ni hpe n mu tam wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rahkela a sum de mung shang wu ai. Rahkela gaw dai hpara sumla ni hpe la nhtawm gawla-uk hking tingsan kata e bang da nna, de a ntsa e shi dung nga wu ai. Laban chyawm gaw sum ting hkan tam sawk yu wu ti mung, dai ni hpe n mu wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Rahkela mung kawa hpe, “Wa e, na a man e ngai n lu rawt tsap lu ti mung, ngai hpe masin hkum pawt et; ngai numsha hking lang nga nngai,” ngu nna tsun wu ai. Dai hpang Laban tam sawk yu wu ti mung, shi a hpara sumla ni hpe n mu tam wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai hpang Yaku masin pawt nhtawm, “Ngai hpa baw ru hka amu shut kau a ni? Ngai hpe hkan tam shachyut na ahkang nang jaw lu hkra ngai kaning re ai tara hpe jahten kau nga a ni?
  </para>
  <para style="p">
    <verse number="37" style="v" />Ya nang nye a arai mahkra hpe nang tam sawk yu nit dai; dai rai yang, nang hte seng ai na nta na arai hpe mu tam la nu ni? Nang hte nye a masha ni dai hpe mu lu mu ga, ndai yang e, dai hpe shaw shapraw da gaw; shing rai shanhte mahtang an hta na kadai wa ding man nga ai hpe daw dan ya mi ga.
  </para>
  <para style="p">
    <verse number="38" style="v" />Lai wa sai hkun ning tup ngai nang hte rau nga wa ni ai; shaloi na a sagu bainam yi ni nbya bya ai n rai, na a yam nga hpung ni hta na sagu la langai mi hpe mung ngai sha kau ya ni ai n rai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nam na matse labye dusat ni yam nga langai kawa sat shagu dai mat mat ai hpe ngai hkum nan tut nawng hpai wa nngai. Dai hpe ngai n la ai sha nang hpe wa madun dun re ai gaw nye a mara n rai nga li ai. Shani hte shana e lagu la hkrum ai yam nga hpa rai tim, de a malai nang ngai kaw na hpyi la la rai nga ndai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shani na kahtet kang ai hte shana na kashung ai nni nkri hpe law law lang ngai hkam sha kau ni ai. Yup n lu sha ai mung ngai hkrum lai wa ni ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shaning hkun ning ting ngai nang hte rau dai zawn nga kau ni ai. Na shayi sha yan a matu shi mali ning, na a yam nga hpung ni a matu kru ning, ngai galaw jaw kau da se ai. Dai rai tim pyi, nye a shabrai ni hpe shi lang nang galai kau ya nit dai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nye kaji kawa ni a Karai Kasang ngu ai Abraham, Isak ni a Karai Kasang gaw ngai hte rau she n nga ai rai taw gaw, nang ngai hpe kaman dat dat kau chyalu rai nga ndai. Rai ti mung Karai Kasang gaw ngai hkam sha ai tsin-yam tsindam hte ngai galaw sai amu hpe mu mada ya ni ai majaw, mana e, shi tara daw dan ai lam jaw ya mi ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Laban gaw Yaku hpe, “Ndai numsha ni nye a shayi sha ni hkrai; shanhte a kasha ni mung ngai hte seng ai hkrai; ndai yam nga hpung ni mung nye a hpung ni hkrai rai nga li ai. Ndai yang e nang mu mamu mahkra gaw nye a hkrai rai nga ai. Shing re ai rai tim, nye a shayi sha ni hte shanhte a kasha ni hpe hkum da na ngai hpa mung dang di lu nga ai n rai nga ai majaw,
  </para>
  <para style="p">
    <verse number="44" style="v" />nang hte myit hkrum ga shaka tawn da na ngai jin jin rai nga nngai. An a myit hkrum ga langai hpe adum nga na sakse tai nga u ga, nlung ni hpe sumpum tawn ga,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Dai rai nna Yaku gaw nlung langai mi hpe la nna dai hpe masat dingsat hku jung da wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shi gaw shi a masha ni hpe nlung mahkawng sumpum da na tsun wu ai. Dai hpang shanhte mung nlung sumpum makau e shat jawm sha ma ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Laban chyawm gaw dai hpe Yegara Sahaduta ngu nna shamying wu ai. Yaku mahtang dai hpe Galeda ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Laban gaw Yaku hpe, “Ndai nlung sumpum gaw an lahkawng a matu myit dum sakse tai nga na ra ai,” ngu nna tsun wu ai. Dai rai nna dai shara hpe Galeda ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Laban mung Yaku hpe, “Anhte shada da hka mat wa yang, dai Madu anhte hpe ayu nga u ga law,” ngu nna tsun wu ai. Dai shara hpe Mizpa ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Laban mung matut nna, “Nye a shayi sha yan hpe nang n gawn n sawn di nna kaga numsha ni hpe la ai rai yang, shing re ai lam hpe ngai n chye lu tim, Karai Kasang an hpe azi yu nga ai hpe gaw, adum nga ga.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ndai yang e, an a lapran hta ngai sumpum da sai nlung ni hte jung da sai masat dingsat nlung ni nga nga sai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ndai nlung sumpum hte dai masat dingsat nlung lahkawng gaw myit dum shangun ai masat ni rai nga ai. Ngai mung ndai sumpum hta lai nna nang hpe galoi mung sa gasat na n rai; nang mung ngai hpe gasat na, ndai sumpum hte masat dingsat nlung hta na galoi mung lai lu na n rai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham a Karai Kasang hte Nahora a Karai Kasang gaw an a lapran e jeyang ya nu ga,” ngu nna tsun wu ai. Dai hpang Yaku gaw ndai ga sadi grin nga u ga, shi kawa Isak nawku ai Karai Kasang a mying nsang hte dagam shaka da wu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Shi gaw, yam nga langai sat nhtawm bum ntsa e hkungga nawng ya wu ai; shi a masha ni hpe mung shat sha shaga wu ai; shanhte lusha sha ngut ai hpang dai bum e lana mi nga shalai kau mu ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ya hpang jahpawt manap jau jau aten hta, Laban gaw shi a kashu ni hte shayi sha ni hpe pup shakram dat nhtawm shi a nta de nhtang wa na nga, pru mat wa wu ai.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaku gaw shi a hkrun lam hpe hkawm matut sa wa wu yang, lamu kasa nkau mi shi hte sa hkrum ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai ni hpe shi mu ai shaloi, “Ndai gaw Karai Kasang a dabang rai nga ai,” ngu nna shi tsun wu ai. Shing rai dai shara hpe ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yaku gaw Edom mung e nga ai shi a kahpu Esaw hpang de shi a shawng e kasa ni hpe shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi shanhte hpe hkang dat mu ai gaw: “Na a ga hpe madat mara ai shangun ma, ngai Yaku gaw ya du hkra Laban kaw nga kau da nna bai nhtang wa ai hta htingnai mat nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dumsu ni hte lawze ni mung, sagu bainam ni hte mayam ni mung, ngai lu nngai. Na a man e myi man pa lu na hpe myit mada let nang hpe shana dat nngai.”
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai kasa ni Yaku kaw bai du wa yang, shanhte gaw, “Na a nhpu Esaw kaw anhte du saga ai. Nang hpe sa tau la na nga, shi a hkrun lam hkawm na matu shajin da nu ai. Shi hte rau masha mali tsa mung lawm nang na ma ai,” ngu nna tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yaku gaw hkrit kahpra ai hte myit ru nga wu ai. Shi kaw hkan nang ai masha ni hte shi a sagu, bainam, dumsu hte gawla-uk ni hpe mung hpung lahkawng di nna garan tawn da wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw, “Shawng na hpung hpe Esaw sa gasat yang, hpung mi gaw lawt lu na nhten,” ngu nna myit nawn da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang Yaku gaw, “Nye a aji Abraham a Karai Kasang nye wa Isak a Karai Kasang e, nye a akyu hpyi ga hpe na ya e! Madu e, nang ngai hpe nye a mung ga, nye a amyu ni shanu nga ai ga de nhtang wa na matu mung, nye a matu lam shagu hta mai kaja shangun na mung, nang tsun nit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a shangun ma wa, ngai gaw nang madun dan sai matsan dum ai chyeju hte sadi sahka lam mahkra hte n ging n dan la nga nngai. Nye a dawhkrawng langai mi hte sha, ndai Yawdan hka hpe rap di nngai; ya chyawm gaw ndai hpung lahkawng hte ngai nhtang wa ni ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye hpu Esaw a lata kaw na ngai hpe hkye hkrang la e, ngai akyu hpyi nga nngai law. Ngai hkrit mung hkrit nga nngai-shi sa wa nna anhte hpe gasat nhtawm anhte yawng hpe mung, kanu ni hte kasha ni hpe pyi sa shamyit kau na hkrit nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nye a matu lam shagu hta mai kaja shangun na mung, ngai hpe panglai hkin-gau mayan kadai mung n dang hti lu hkra law htam ai zaibru ni zawn amyu bawsang ni hpe shalaw jahtam ya na nga nna mung, nang ga sadi jaw nit dai hpe dum nga u,” ngu nna akyu hpyi wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shana tup dai yang e nga nga ai hpang, shi a yam nga hpung hta na kahpu Esaw hpe kumhpa na matu, bainam yi lahkawng tsa, bainam la hkun, sagu yi lahkawng tsa, sagu la hkun, kasha ni hte nawng chyu chyu ai gawla-uk kanu sumshi, dumsu uyi mali shi, dumsu usu shi, lawze yi hkun hte lawze la shi hpe lata tawn da wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai ni hpe hpung hte hpung garan tawn nhtawm hpung shagu hta shi a shangun ma langai hpra hpe woi awn shangun wu ai. Shi gaw shanhte hpe, “Nye a shawng e sa wa masu; bai hpung hte hpung mi mung gang gang rai mu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw shawng na shangun ma wa hpe, “Nye a kahpu Esaw nang hte hkrum nna, ‘Na a madu kadai rai ta? Nang kade sa wa nga n ni?, Na man na ndai yam nga ni hpe kadai madu a ni?,’ nga nna hkap san yang, na a shangun ma Yaku a rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi gaw dai ni hpe shi a madu Esaw hpe jaw dat ai kumhpa rai nga ai. Yaku shi hkum nan gaw anhte a shingdu e naw rai nga ai,’” ngu nna nanhte htan lu na myit dai, nga nna hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hte maren hpung lahkawng na wa hpe mung, hpung masum na wa hpe mung, kaga hpung yawng hta hkan ai ni hpe mung: “Da ndai gaw nanhte Esaw hte hkrum ai shaloi tsun na ga rai malit dai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nanhte gaw, ‘Rai sa, na a shangun ma Yaku gaw anhte a shingdu e naw rai nga ai,’” ngu lu na myit dai, nga nna hkang da wu ai. Yaku mung, “Ngai shi hpe kumhpaw kumhpa jaw ya nna, shi a myit hpe kayin wa hkra lau la na we ai; shaloi ngai shi hte hkrum yang, ngai hpe mara mahkoi mi dat ya nhten,” ngu nna myit yu nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi gaw kumhpaw kumhpa ni hpe shi a shawng e shawng shalai dat nna shi mahtang dabang e dai shana nga shalai kau wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai shana e, Yaku rawt nna shi a madu jan lahkawng hte shingnan num yan hpe mung, shi a kasha shi langai hpe woi nna Yabok hka hpe rap ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi shanhte hpe rap shakawt kau ngut ai hpang, shi a sut rai yawng hpe mung sharap tawn da wu ai;
  </para>
  <para style="p">
    <verse number="24" style="v" />rai ti mung shi chyu sha shingdu e hti ngam nga wu ai. Shaloi masha langai mi sa nna nhtoi grai wa n san lu ai aten du hkra shi hte gamu hkat nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai wa shi n dang lu ai hpe mu jang, Yaku a dangbau manat ya ai rai nna hkrihkraw kashai mat wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai masha wa gaw, “Ngai wa na ni ai; nhtoi mung htoi wa ra ai,” ngu nna tsun wu ai. Yaku mahtang, “Nang ngai hpe n shaman ya ai rai yang, ngai wa shangun na n rai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai wa gaw, “Na a mying hpa rai lit ta?,” ngu nna san wu ai. Shi gaw, “Yaku” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai masha wa gaw, “Na a mying Yaku ngu lu sana n rai. Nang gaw Karai Kasang hte mung, masha ni hte mung malan da ting hkat ai hte dang kau nit dai; dai rai nna na a amying Israela rai na lit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yaku mung, “Na a mying ya jang ngai hpe tsun dan e,” ngu nna tsun wu ai. Rai ti mung, shi mahtang, “Nang hpa majaw nye a mying chye mayu nga n ni?,” ngu nna tsun nhtawm Yaku hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Yaku gaw, “Ngai gaw Karai Kasang hpe myi man chyaw mu se ai. Ngai mung ya du hkra naw ahkrung nga nngai,” ngu nna tsun wu ai. Shing rai dai shara hpe Hpeniela ngu nna shi shamying da wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hpeniela shara na Yaku pru wa yang, jan pru sai. Shi a dangbau a majaw shi a lagaw layawt mat wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Yaku a dangbau kaw na lasa manat hkrum wu ai majaw Israela amyu ni dai ni du hkra, dai dangbau hkrihkraw ntsa na lasa n sha ma ai.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Esaw gaw shi a masha mali tsa hte rau sa wa nga ai hpe Yaku mu wu ai; Shi gaw Lea, Rahkela hte shingnan num lahkawng yan hpe kasha karan ya wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna shingnan num yan hte shan a kasha ni hpe shawng e, dai hpang Lea hte shi a kasha ni, Rahkela hte Yosep hpe jahtum e, shi tawn da wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yaku mahtang shanhte a shawng e lai sa mat wa nna shi a kahpu kaw du ai aten du hkra ga de sanit lang gum dagup wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai ti mung, Esaw mahtang shi hte hkrum lu hkra gat sa wa nna, shi hpe ahpum da let pup wu ai. Shan nau lahkawng yan hkrap ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Esaw gaw grup yin de mada yu wu yang, numsha ni hte kasha ni hpe mu ai shaloi, “Nang hte rau hkan ai ndai masha ni gaw kadai ni rai nga ma ta?,” ngu nna san wu ai. Hpu ba e, ndai ni gaw ra n rawng hkra ngai hpe Karai Kasang jaw ya ai ma ni rai nga ma ai,” ngu nna Yaku htan wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpang shingnan num ni hte shanhte a kasha ni sit lung wa nhtawm gum dagup ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang Lea hte shi a kasha ni sit lung wa nhtawm gum dagup ma ai. Yawng a hpang jahtum hta, Yosep hte Rahkela sit lung wa nhtawm gum dagup ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esaw mahtang, “Ngai hkrum kau dat ai kaga hpung ni gaw kaning re ai ni rai nga ma ta? Dai gaw kaning re ai lachyum rai nga a ta?,” ngu nna san wu yang, Yaku gaw, “Dai gaw na a man e myi man pa lu na matu rai nga li ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung, Esaw mahtang, “Ngai nau wa e, ngai lu ai hte pyi ram la nga nngai; nang lu ai dai ni hpe bai la da u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaku gaw, “N rai law, na a man e ngai myi man pa ni ai rai yang gaw chyeju hte nye a kumhpa ni hkap la ya e. Nang ngai hpe hku lahkun re ai myit rawng nga ndai majaw, na a myi man hpe mu lu ai gaw nye a matu Karai Kasang a myi man mu lu ai zawn rai nga li ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a matu ngu nna ngai la wa ya ai ndai kumhpa hpe chyeju hte hkap la ya e; Karai Kasang mung ngai hpe matsan dum la nna, ngai hta ra ai lam magup hpe jaw ya ni ai,” ngu nna tsun wu ai. Yaku mung shi hkap la ai aten du hkra a shadut nga wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Esaw gaw, “Sa, pru sa wa na hkyen yu saga. Na a shawng e ngai sa na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yaku mahtang, “Ma ni mung n kung ma ai; bai sagu ni hte yam nga hpung hta chyu chyu ai hkalung ni hkan nang ma ai hpe ngai myit shalawm ra ai mung nang chye nga ndai. Dai sha n-ga, lani mi hta sha dai ni hpe nau hte gawt shatsang jang mung uhpung ting si mat na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nye a shawng e nang mahtang wa magang su. Ngai gaw yam nga ni hte ma ni hkawm lu ai daram mi hte nang nga ai Edom mung de hkan du nang ai aten du hkra angwi ngwi hte hkan nang wa na nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Esaw gaw, “Dai rai taw, nye a masha nkau mi nang hte tawn da ya de ga,” ngu nna tsun wu ai. Rai ti mung, Yaku mahtang, “Na a man e myi man pa lu na hta kaga
  </para>
  <para style="p">
    <verse number="16" style="v" />hpa mung ngai n ra nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Esaw gaw dai shani jang rawt nna Edom mung de bai wa mat wa wu ai. Rai ti mung, Yaku chyawm gaw Suhkot ngu ai shara de du hkra hkawm sa wa nna, shi nga na nta hte yam nga ni rawng na sum ni hpe gap wu ai. Dai rai nna shara dai hpe Suhkot ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yaku gaw Mesopotamia mung na bai wa yang, Hkanan mung na Shehkem ngu ai mare de shim lum ai hte du wa nna dai mare makau na pa ni hta shi a dabang ni de da wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shehkem a kawa Hamura a amyu matu ni shanu nga ai pa layang daw chyen mi hpe mung gumhpraw latsa hte mari la kau wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai yang e, tawn hkungri langai mi shi galaw tawn da nhtawm dai hpe Ela, Israela a Karai Kasang ngu nna shamying wu ai.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaku hte Lea yan a shayi sha Dina gaw lani mi na aten hta, Hkanan mung na numsha nkau mi hpang de sa chyai na nga, pru mat wa wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai mung hpe up ai Hiwi amyu masha Hamura a kasha Shehkem gaw shi hpe mu nna, woi wa nhtawm roi kau wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai ti mung, dai numsha a ahpraw ningja grai tsawm htap nga ai hpe shi mu wu ai majaw shi hta tsaw ra myit anoi nga ai rai nna shi a tsaw ra myit hpe hkam la lu na matu shakut wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw kawa hpe, “Ndai numsha hpe nye a madu jan shatai la na, ngai ra sharawng nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku gaw shi a shayi sha sari jahpoi hkrum nga sai hpe chye wu ti mung, shi a shadang sha ni yam nga ni hte pa de naw nga nga ma ai majaw shanhte bai wa ai aten du hkra atsin sha nga nga wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shehkem a kawa Hamura gaw Yaku hpe
  </para>
  <para style="p">
    <verse number="7" style="v" />sa shaga na nga pru sa wa nga yang sha, Yaku a shadang sha ni mung pa de na du shang wa ma ai. Dai lam hpe shanhte na ma yang, Shehkem galaw kau ai dai zawn re ai amu hte Yaku a shayi sha roi kau hkrum ai a jaw e, Israela amyu masha ni n kaw n law di kau hkrum sai hpe na kajawng nna ja ja pawt bu nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hamura gaw shi hpe, “Ngai sha Shehkem gaw na a shayi sha hpe tsaw ra myit jung noi nga nu ai. Chyeju hte shi hpe la shangun ga law.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte hte nanhte a amyu masha ni shada da num jaw num ya rai nna mayaw htinggaw de sha wa lu na myit hkrum ga shaka hpe galaw tawn da saga,
  </para>
  <para style="p">
    <verse number="10" style="v" />shing rai yang, nanhte mung ndai anhte a mung hta anhte hte rau nga lu na myit dai; nanhte myit htep nga ai gara shara hta mung shanu nga lu nna, hpaga yumga ndut ndang lu galaw nhtawm sut gan madu la lu na myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang Shehkem mung Dina a kawa hte kahpu kanau ni hpe, “Ndai lam hta ngai myi man pa lu we ga, nanhte myit dik hkra hpyi ai hpe ngai jaw na made ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai shi hpe hkungran la na, nanhte hkraw myit dai rai yang, nanhte la ang ai hpu ja re ai kumhpa a lam ngai hpe tsun dan mi. Num nnan a matu nanhte hpyi ai made ngai bang na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shehkem mung shanhte a kajan Dina hpe sari jahpoi kau ya nu ai majaw Yaku a shadang sha ni mahtang Shehkem hte shi a kawa Hamura yan hpe hpaji hte htan ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte gaw shi hpe, “Matu gadoi n hkam ai wa hpe anhte a kajan n ya sha lu na ga ai; dai sha n-ga, anhte a matu myi man sum shara tai na ru ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anhte zawn nanhte mung tai wa myit ga, nanhte a lasha ni yawng matu gadoi hkam ai rai yang chyu sha, anhte myit hkrum ya lu na ga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hpang shada da num jaw num ya ai amu hpe anhte myit hkrum ya na ga ai. Anhte mung nanhte a ka-ang e nga lu nna, nanhte hte amyu langai sha tai na ga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai ti mung anhte a ga ni hpe nanhte n hkap la ai sha, matu gadoi n hkam la myit yang chyawm gaw shi hpe anhte woi nna wa mat na ga ai,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai ga ni hpe Hamura hte shi a kasha Shehkem na ra ma ai,
  </para>
  <para style="p">
    <verse number="19" style="v" />Yaku a shayi sha hpe tsaw ra wu ai majaw mung, shing re ai hpaji jaw ga hpe galaw na dai shabrang wa loi mi mung n kanung nga ai. Shi gaw shi a dinghku masha ni yawng hta grau ahkyak htum ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hamura hte shi a kasha Shehkem gaw mare chyinghka e nga ai hpawng ginra de sa nhtawm shanhte a manang rai nga ai
  </para>
  <para style="p">
    <verse number="21" style="v" />mare masha ni hpe, “Ndai masha ni hku hkau chye ma ai; dai rai nna ndai mung hta anhte hte rau shanu nga nna hpaga yumga ndut ndang galaw mu ga. Ndai mungdan mung shanhte a matu nga shara dam lada rai nga malu ai. Shanhte a shayi sha ni hpe anhte la ga; shanhte hpe mung anhte a shayi sha ni hpe ya sha ga.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai ti mung shanhte matu gadoi hkam ai zawn anhte a lasha ni yawng hpe matu gadoi ya ai rai yang chyu sha, shanhte gaw anhte a ka-ang e nga nga nhtawm anhte hte amyu langai sha rum wa na, ndai amyu masha ni myit hkrum ya na mara ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shanhte a yam nga hte sut gan arai yawng mayawng gaw anhte a arai tai na n rai ni? Dai re ai majaw shanhte gaw anhte a ka-ang e, shanu nga lu mu ga, dai hpe anhte myit hkrum daw dan ya saga,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hamura hte Shehkem yan a lajin ai ga hpe mare masha ni yawng myit hkrum ai hte lasha ni yawng mung matu gadoi hkam la mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Masum ya na ai hpang, dai matu gadoi hkam ai ni naw machyi nga yang, Yaku a kasha Dina a kahpu Simun hte Lewi yan gaw nhtu hpra hpra lang nna mare de sa nhtawm n rup n tsen ai hpe alun ai lam hpa mung n nga ai sha, lasha ni yawng hte hpawn Hamura hte Shehkem shan wa lawm hkra sat kau mu ai. Dai hpang Dina hpe Shehkem a nta kaw nna shapraw la nhtawm woi mat wa ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Masha sat sharu kau ngut ai hpang mung, Yaku a shadang sha nkau mi mahtang shanhte a kajan a sari hpoi awu asin hkrum ai hpe matai dawp la na nga, mare hpe hpya kau ya mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte gaw sagu bainam hpung, dumsu lawze ni hte mare kata hte hkauna pa hkan na arai nga manga yawng la kau ya mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shanhte gaw manu dan ai arung arai shagu hpe la nhtawm numsha ni hte ma kaji ni yawng hpe mung rim la ai hte nta hkan na arung arai shagu hpe mung htawm la kau ya ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Yaku gaw Simun yan Lewi hpe, “Nan gaw ngai hpe ru yak tsin-yam tsindam la wa ya manit dai. Ya chyawm gaw Hkanani hte Hperizi masha ni hte mungdan hta shanu nga ai masha shagu hte gaw ngai hpe n dawng na mara ai. Ngai hta masha n law nga ai majaw shanhte yawng rau jawm zup nna ngai hpe htim gasat ai rai yang, anhte a dinghku ting shamyit kau ai hkrum na raga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Rai ti mung shan mahtang, “Anhte a kajan hpe shawa num langai zawn n shatai kau lu na ga ai,” ngu nna htan ma ai.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw Yaku hpe, “Behtela de ya jang sa wa nna, dai yang e nga nga u. Na nhpu Esaw kaw na hprawng mat wa ai shaloi, nang kaw dan pru ai Ngai Karai Kasang a matu, dai yang e tawn hkungri langai galaw u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna Yaku mung shi a dinghku masha ni hte shi hte rau nga nga ai ni yawng hte hpe, “Nanhte lu ai maigan hpara sumla ni hpe shapraw kau mu, tinang hkum hpe tinang dai shachyoi shapra nna asan aseng re ai hpun palawng ni bu hpun mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai ru yak tsin-yam tsindam hkrum ai aten hta ngai hpe karum la nna ngai hkawm sa ai shara shagu hkan mung ngai hte rau anga nga ai Karai Kasang a matu tawn hkungri galaw na ngu ai Behtela de sa wa na matu ndai shara kaw nna anhte pru sa wa saga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna shanhte gaw maigan hpara sumla mahkra hte na hta kai ai shanghkawng ni, Yaku a lata de ap kau mu ai. Dai arai ni hpe Shehkem makau e tu ai wamyi hpun nhpang e shi lup kau ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku hte shi a shadang sha ni pru wa hkyen nga yang, hkrit hpa kaba gaw grup yin na mare masha ni a ntsa e, du pru wa ai majaw, dai masha ni shanhte hpe n hkan shachyut ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yaku hte shi hte rau hkawm sa nga ai masha yawng hte gaw, ya aten e Behtela ngu nna shamying ai dai Hkanan mung na Luza mare de du ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai yang e, tawn hkungri langai hpe shi galaw wu ai. Dai shara hpe Behtela shara na Karai Kasang a matu ngu nna shamying wu ai; hpa majaw nga yang, kahpu a lata kaw na shi hprawng mat wa yang, dai shara e Karai Kasang shi nan Yaku hpe shadan dan ai shara rai nga lu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rebeka hpe yu lajang ai Debora si mat nna, Behtela a dingda maga na wamyi hpun nhpang e lup makoi kau mu ai. Dai rai nna dai hpun hpe, “Hkrap Ai Wamyi Hpun,” ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yaku gaw Mesopotamia mung kaw nna nhtang wa wu yang, Karai Kasang shi kaw kalang mi bai dan pru nhtawm shi hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang gaw shi hpe, “Na a mying Yaku rai nga lit dai; rai ti mung, ndai aten kaw nna Israela ngu na rai nga lit dai,” ngu nna tsun wu ai. Karai Kasang gaw shi hpe Israela ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang gaw shi hpe, “Ngai gaw Chyahtum Chyalai N-gun Rawng Ai Karai Kasang rai nga nngai. Kashu kasha law law mayat maya u; amyu baw ni nang hta na pra hkrat wa nhtawm hkawhkam ni a kaji kawa mung nang tai na rin dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham hte Isak yan hpe ngai jaw ai lamu ga gaw nang hpe mung, na a hpang na amyu matu ni hpe mung ngai jaw na we ai,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hpang Karai Kasang mung shi kaw nna pru mat wa wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang shi hpe ga shaga ai dai shara hta Yaku gaw masat dingsat nlung langai jung da nna, dai hta e sabyi ntsin hte tsanlun sau ni ru bun let nawng da wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai shara hpe Behtela ngu nna shi shamying wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yaku hte shi a dinghku masha ni Behtela kaw nna pru mat wa nhtawm Ehprat kaw nna loi mi naw tsan ai shara hta shanhte naw nga nga yang, Rahkela hta shangai nhtoi gu nna shinggyim machyi laja lana hkrum sha wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai shangai yak nga yang, shangai karum ai jan gaw, “Hkum hkrit et; shadang sha langai nang bai lu nit dai,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rai ti mung, shi si wa nna shi a nsoi nsa hkyet mat wa yang, shi a shadang sha hpe Benoni ngu nna shamying da wu ai. Rai ti mung shi a kawa chyawm gaw Benyamin ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rahkela si mat ai shaloi, ya aten e Betlehem ngu nna tsun ai Ehprat de sa wa ai lam makau hta shi hpe lup makoi da mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yaku mung dai yang e, masat dingsat nlung langai jung da wu ai rai nna dai gaw dai ni du hkra Rahkela a lup hpe naw matsing da ya nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yaku gaw matut hkawm mat wa nhtawm Edera langchyi a man maga mi hta shara la nna shi a sum de da nga wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yaku dai mung hta nga nga yang, Rubin mahtang shi kawa a lashi num Bila kaw shang nna kanawn kau wu ai; dai lam hpe Yaku na wu ai rai nna sindawng kahtet wu ai. Yaku hta shadang sha ni shi lahkawng nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lea a shadang sha ni gaw, Rubin (Yaku a shadang sha alat), Simun, Lewi, Yuda, Yisahka hte Zebulun hte rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rahkela a shadang sha ni gaw Yosep hte Benyamin yan rai ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rahkela a mayam num Bila a shadang sha ni gaw Dan hte Naphtali yan rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lea a mayam num Zilhpa a shadang sha ni gaw Gad hte Ashe yan rai ma ai. Ndai hte gaw Mesopotamia mung e shangai ai shadang sha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yaku gaw Abraham hte Isak shanu nga ai Hebron makau na shi kawa Isak nga ai Mamre kahtawng de sa wa wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isak gaw asak latsa e matsat shi ning du hkra nga nna,
  </para>
  <para style="p">
    <verse number="29" style="v" />asak kung ugut gu ai aten hta si wa nu ai; shi a shadang Esaw hte Yaku hkan nau shi hpe lup makoi kau ma ai.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Da ndai gaw Edom ngu nna mung shaga ai Esaw a lakung lama ni rai ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esaw mahtang Hkanan numsha ni rai nga ai Hiti masha Elon a shayi sha Ada hpe mung, Hiwi masha Zibeon a kasha Ana a shayi sha Aholibama hpe mung,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ishmaela a shayi sha Nabaiyut a kajan Basemat ni hpe la wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ada gaw Elihpa hpe shangai wu ai; Basemat mahtang Reuela hpe shangai ya wu ai. Aholibama gaw Yeusa, Yalam, Kora hte hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ndai ni yawng gaw Hkanan mung e, Esaw a matu shaprat ya ai shadang sha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpang Esaw gaw shi a madu jan ni, shi a shadang sha ni hte shayi sha ni, nta masha ni yawng hte hpe mung, shi a yam nga hpung ni yawng hte Hkanan mung e shi lu la da sai sut gan arung arai yawng hte hpawn shi a kanau Yaku kaw nna kaga mung de htawt mat wa wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Esaw hte Yaku hta yam nga ni grai law nga ai rai nna, shan rau nga na lam n mai byin ai hte shan shanu nga ai lamu ga mung shan hpe grai wa n lu madi shadaw karum lu ai a majaw, Esaw pru mat wa wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Esaw mahtang Edom mung na kawng marawn hkan shanu nga wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Da ndai ni gaw Edom masha ni a kaji kawa rai nga ai Esaw a lakung lama ni rai nga ai. Esaw a madu jan Ada gaw shi a matu shadang sha Elihpa hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai Elihpa gaw shadang sha manga lu ai rai nna, dai ni gaw Hteman, Umara, Zehpu, Gahtam hte Kena ni rai nga ai. Kaga madu jan rai nga Htimna mung Elihpa a matu shadang sha Amalek hpe shangai ya wu ai. Esaw a madu jan Basemat mung shadang sha Reuela hpe shangai ya wu ai. Reuela mung shadang sha mali lu wu ai; dai ni gaw Nahat, Zera, Shama hte Miza ni rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zibeon a kasha Ana a shayi sha Esaw a madu jan Aholibama gaw shadang sha masum rai nga ai Yeusa, Yalam hte Kora ni hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ndai ni gaw Esaw kaw na yu hkrat wa ai amyu bawsang ni rai ma ai. Esaw a shadang sha alat Elihpa gaw Hteman, Umara, Zehpu, Kena,
  </para>
  <para style="p">
    <verse number="16" style="v" />Kora, Gahtam hte Amalek ni gaw amyu bawsang ni a kaji kawa tai wa sai. Dai ni yawng gaw Esaw hte madu jan Ada yan a lakung lama ni rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Esaw a shadang sha Reuela gaw Nahat, Zera, Shama hte Miza amyu bawsang ni a kaji kawa tai wa sai. Dai ni yawng gaw Esaw hte madu jan Basemat yan a lakung lama ni rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yeusa, Yalam hte Kora ni gaw Esaw hte shi a madu jan rai nga ai Ana a shayi sha Aholibama yan kaw na yu hkrat wa ai amyu lakung ni rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ndai ni yawng gaw Esaw kaw nna pra hkrat wa ai amyu bawsang ni rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Edom mung na ningpawt buga masha ni gaw amyu bawsang hku ran hkrat wa nna shanhte a kaji daju Hori masha Seira a matu mara ni gaw Lotan, Shobala, Zibeon, Ana, Dishon, Ezera hte Dishan ni rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lotan mahtang Hori hte Heman amyu lakying ni a kaji kawa rai nga ai. (Lotan hta Htimna mying ai kajan langai lu wu ai.)
  </para>
  <para style="p">
    <verse number="23" style="v" />Shobala mung Alwan, Manahat, Ebala, Shehpu hte Onam amyu lakying ni a kaji kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zibeon hta Aya hte Ana ngu ai shadang sha lahkawng nga nga ai. (Ana gaw shi kawa a lawze ni hpe bau rem nga yang, nam mali e hka lum hka hpawk ni hpe sa mu ai wa rai nga ai.)
  </para>
  <para style="p">
    <verse number="25" style="v" />Ana gaw Hemdan, Eshban, Yitran, Hkeran amyu lakying ni a kaji rai nga ai Dishon a kawa rai nga ai. Ana gaw Aholibama mying ai shayi sha langai mi mung lu wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ezera gaw Bilahan, Zawan hte Akan amyu lakying ni a kaji kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dishon mung Uza hte Aran amyu lakying ni a kaji kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ndai ni gaw Edom mung hta nga ai Hori bawsang Lotan, Shobala, Zibeon, Ana, Dishon, Ezera hte Dishan amyu bawsang ni rai ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Israela mung hta gara hkawhkam mung garai n paw pru wa yang, lawu de na hkawhkam ni Edom mung hta matut manoi up hkang lai wa masai. Dai ni gaw; Dinhaba mare na Beora a kasha Bela, Bozra mare na Zera a kasha Yobab Hteman ginwang na Husham, Awit mare na Bedad a kasha Hadad (Shi gaw Moba mung na majan hta Midian masha ni hpe gasat dang kau ai wa rai nga ai.) Masreka mare na Samla, Hka nu makau na Rehubut mare na Shaula, Akbora a kasha Bala Hanan, Paw mare na Hadad (Shi madu jan a mying gaw Mehetabela rai nna Matreda a shayi sha rai nhtawm Mezahaba a kashu rai nga ai.)
  </para>
  <para style="p">
    <verse number="40" style="v" />Esaw gaw Edom amyu Htimna, Alwa, Yehtet, Aholibama, Ela, Hpinon, Kena, Hteman, Mibzara, Magdula, hte Iram amyu bawsang ni a kaji kawa rai nga ai. Ndai amyu bawsang shagu shanu nga ai shara gaw dai amyu bawsang ni a mying hta hkan nna gumhkawng pru wa nga ai.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaku gaw shi a kawa nga ai Hkanan mung hta matut nna nga nga wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Da ndai gaw Yaku a dinghku ginru ginsa lam rai nga ai. Yosep gaw asak 17 ning re ai shabrang ma rai nna, shi a kahpu ni hte mung, shi a kawa a lashi num ni rai nga ai Bila hte Zilhpa yan a shadang sha ni hte mung sagu bainam ni rem wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yaku mahtang shi asak kaba sayang she Yosep shangai wa wu ai majaw, shi a kasha kaga ni yawng hta shi hpe grau tsaw ra wu ai. Dai rai nna tsawm htap ai hte mawn sumli da ai palawng lawng ta galu langai mi chywi ya wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a kawa shanhte hpe tsaw ra ai hta Yosep hpe mahtang grau nna tsaw ra ai hpe mu ma yang, shanhte gaw shanhte a kanau hpe grai wa n dawng nga ma ai hte shi hpe hku lahkun re ai lai hte n kam hkap shaga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yosep gaw kalang mi na aten hta yup mang mu nna shi a kahpu ni hpe dai lam hkai dan wu ai. Shanhte gaw shi hpe grau nna n ju nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw, “Ngai mu ai yup mang hpe madat yu mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anhte yawng sun e hkaulan mam hkauling ni hpe gyit nga ga yang, nye a hkauling mahtang jan rai rawt tsap nga ai. Nanhte a hkauling ni chyawm gaw grup wan rai nna nye a hkauling hpe gum dagup nga ma ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a kahpu ni gaw, “Nang gaw hkawhkam tai wa nna anhte hpe up hkang lu na zawn myit nawn nga n ni?,” ngu nna san mu ai. Dai rai nna shi a yup mang hte shanhte hpe tsun ai shi a ga ni a majaw shanhte shi hpe grau nna n ju n dawng nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang Yosep gaw yup mang kaga hpe mung bai mu nna shi a kahpu ni hpe, “Yup mang kaga mung ngai mu se ai; jan shata hte shagan shi langai, ngai hpe nawku dingnyawm ai hpe ngai mu nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw shi a kawa hpe mung dai yup mang tsun dan wu ai rai nna shi a kawa mung shi hpe, “Dai yup mang gaw hpa wa rai nga lit ta? Ngai hte na nnu, na nhpu ni nang kaw sa nna nawku dingnyawm na rai nga ga ai ngu, nang myit nawn da wu ni?,” ngu nna shi hpe daru kau wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yosep a kahpu ni gaw shi hpe yu manawn da mu tim, shi a kawa chyawm gaw dai lam mahkra hpe amyit yu nga wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lani mi na nhtoi hta Yosep a kahpu ni gaw shanhte a kawa a sagu bainam hpung ni hpe rem na matu, Shehkem de sa mat wa ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yaku gaw Yosep hpe, “Na a nhpu ni sagu bainam rem ai Shehkem de sa na ngai ra nga nngai,” ngu nna tsun wu ai. Yosep mung, “Ngai jin jin rai nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi a kawa mahtang, “Na a nhpu ni shim lum nga ai hpe mung, sagu hpung ni kaja nga ai hpe mung sa yu su, shing rai bai wa nna ngai hpe tsun dan e,” ngu nna tsun wu ai. Shi a kawa mung shi hpe Hebron Kadit kaw nna shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yosep gaw Shehkem de du nhtawm dai shara de shi kayin hkawm yang, masha langai mi shi hpe mu nna, “Nang hpa baw tam nga n ta?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw, “Sagu bainam ni hpe rem hkawm nga ai nye hpu ni hpe tam hkawm nngai; shanhte kanang hkan nga hkawm nga ai lam ngai hpe nang tsun dan lu na n ni?,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai masha wa mung, “Shanhte pru mat wa masai. Shanhte gaw Dohtan de sa wa na ga ai, nga nna shanhte tsun hkat ai hpe ngai na nngai,” ngu nna tsun dan wu ai. Dai rai nna, Yosep mung shi a kahpu ni hpang de hkan mat wa nhtawm Dohtan e shanhte hpe sa mu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi tsan tsan e naw rai nga yang, shanhte shi hpe mu nna, shanhte kaw garai n du yang, shi hpe lagu sat kau na myit daw dan da mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte langai hte langai mung, “Yu mu, ndai yang e, yup mang mu ai wa du ra ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sa rit, ya chyawm gaw shi hpe sat kau nna, hkun hkraw ai hka htung langai ngai hta shi hpe kabai bang da gaw; matse labye dusat langai ngai mahtang shi hpe kawa sat kau nu ai, ngu nna anhte lu tsun na ga ai. Dai hpang shi a yup mang ni hpa tai na nu ai gaw, anhte mada yu ga,” ngu nna tsun hkat ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rubin gaw shanhte tsun hkat ai ga hpe na kau wu ai rai nna, Yosep hpe hkye la na shakut wu ai. Shi gaw, “Anhte shi hpe n sat ga, nam na ndai hka htung kata de mahtang shi hpe kabai bang da ga;
  </para>
  <para style="p">
    <verse number="22" style="v" />rai ti mung, shi hpe chyawm gaw n machyi shangun ga,” ngu nna tsun wu ai. Shing ngu shi tsun ai gaw, Yosep hpe shanhte a lata kaw na hkye la nhtawm shi a kawa hpang de bai wa sa ya na matu maw mawn ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya Yosep kahpu ni kaw du jang, shanhte gaw tsawm htap ai arai hte mawn sumli da ai shi a palawng ta galu hpe gang raw kau ya mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hpang shi hpe woi mat wa nna hkun hkraw ai hka htung kata de shi hpe kabai bang da mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte shat sha nga ma yang, Gilead mung kaw nna Egutu mung de bu hkawm sa wa ai Ishmaela masha wuhpung ni hpe shanhte akajawng mu dat ma ai. Shanhte a gawla-uk ni hta manam pyaw ai namji namya, hpun naw hte mura ni hpe htaw nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yuda chyawm gaw shi a kahpu ni hpe, “Anhte a kanau wa hpe sat kau nna dai sai kap ai amu hpe magap da ai rai yang, anhte hta hpa akyu hkam la lu na rai nga ga ta?
  </para>
  <para style="p">
    <verse number="27" style="v" />Shi hpe mahtang ndai Ishmaela masha ni a lata de dut kau dat ga; shaloi anhte shi hpe hpa mung n machyi shangun ra nga ga ai; hpang jahtum dik dik tsun ga nga yang, shi gaw anhte a kanau rai nna anhte a ashan hte asai majing nan rai nga ai,” ngu nna tsun wu ai. Shi a kahpu kanau ni mung dai lam hpe myit hkrum ya mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Midian hpaga masha nkau mi lai sa wa nga yang, kahpu kanau ni mung dai hka htung kata na gang shaw shapraw nhtawm Ishmaela masha ni hpe gumhpraw hkun hte dut kau dat ya mu ai. Shanhte mung shi hpe woi nna Egutu mung de woi mat wa ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rubin dai hka htung de bai wa yu wu yang, dai shara hta Yosep n nga sai hpe mu wu ai; shi gaw yawn hkyen ai hte shi a palawng ni hpe gang je kau wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shi gaw shi a kanau ni hpang de bai nhtang wa nhtawm, “Dai ma n nga sai! Ngai kaning di na rai nga a ta?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hpang bainam langai mi hpe shanhte sat nna, Yosep a palawng hpe de a asai hta kapruk bang mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shanhte gaw dai palawng hpe shanhte a kawa hpang de la wa nhtawm, “Ndai hpe anhte mu ga ai; na nsha a palawng wa n rai a ni?,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kawa mung dai hpe shi matsing da wu ai rai nna, “Rai sa, dai gaw shi a rai nga lu ai! Matse labye dusat lama mi e shi hpe kawa sat kau nu ai. Nye a kasha Yosep gaw kahtum kadaw rai mat hkra ashep ashin gang je kau hkrum nga sahka!,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Yaku gaw yawn hkyen ai hte shi a hpun palawng ni hpe gang je kau nhtawm lachyit nba lawai da wu ai. Shi gaw shing rai hkrum hkra sai kasha a matu nhtoi na na wa sharung shayawt nga wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shi a shadang sha ni hte shayi sha ni yawng mung shi hpe shalan shabran na nga, rawt sa wa ma timung, shi chyawm gaw shalan shabran hkrum na hpe n kam hkam la wu ai rai nna, “Ngai gaw nye kasha a matu sharung shayawt ai hte katsan ga de yu mat wa na ni ai,” ngu nna tsun wu ai. Dai rai nna shi a kasha Yosep a matu matut nna sharung shayawt nga wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai aten hta Midian masha ni gaw Yosep hpe Egutu mung na hkawhkam wa a du salang rai nga ai hkaw wang na sin langa ni a du Hputihpa hpe dut ya kau mu ai.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai aten daram hta, Yuda gaw shi a kahpu kanau ni kaw nna pru mat wa nhtawm Adulam mare na Hira mying ai wa hte rau sa nga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai yang e, Shua mying ai Hkanani masha langai mi a shayi sha hpe sa hkrum nna shi hpe la kau wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai numsha mung shi a matu shadang sha langai shangai ya nhtawm shi hpe Era ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw na-um nasin hkum bai tai wa ai hte shadang sha kaga langai shangai wu ai; shi hpe Onan ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hpang shadang sha langai mi bai shangai wu ai rai nna shi hpe Shela ngu shamying wu ai. Dai ma hpe shangai ai shaloi Yuda gaw Hkezib mare e nga nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yuda gaw shi a kasha alat Era a matu Htama mying ai numsha hpe la ya wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Era a sat lawat chyawm gaw n hkru n shawp nga ai rai nna dai gaw dai Madu hpe n sharawng awng shangun nga ai. Dai rai nna dai Madu gaw shi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang Yuda gaw Era a kanau Onan hpe, “Na nhpu a gaida jan kaw sa shang yup su. Shi madu wa a kanau zawn shi hpe kahkyin ra ai na a lit hpe jahpring shatsup u, na nhpu a amyu matu ni matut lu na rai ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai ti mung kashu kasha ni hpe shi madu lu na n rai nga ai hpe Onan chye wu ai rai nna shi kahpu a kashu kasha matu ni n dawng wa u ga, kahpu a gaida jan hte kanawn ai aten hta shi a azu hpe ga de jahkaw wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi galaw ai lam hpe dai Madu n ra sharawng wu ai majaw shi hpe mung sat kau wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang Yuda gaw shi a kanam Htama hpe, “Ngai sha Shela kaba wa ai aten du hkra gaida tai nna, na nwa a nta de wa nhtang nga su,” ngu nna tsun wu ai. Shela chyawm gaw shi a kahpu yan zawn sat kau hkrum na hpe hkrit ai majaw shi dai ga hpe tsun wu ai. Shing rai Htama mung shi kawa a nta de wa mat wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya aten tsawmra mi na mat ai hpang, Yuda a madu jan mung si mat lu ai. Shi yawn bran ngut ai hpang, shi hte shi a jinghku Adulam masha Hira hte rau shi a sagu mun rep ai Htimna de sa wa ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Masha langai ngai gaw na a n-gu shi a sagu mun rep na nga Htimna de sa wa nga ai, ngu nna Htama hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw, shi hpun hpun re ai gaida hpun palawng hpe galai kau nhtawm man magap hte shi myi man hpe magap kau nna Htimna de sa wa ai lam hta nga ai Enaim mare chyinghka lam e sa dung nga wu ai. Hpa majaw nga yang, Yuda a shadang sha hpungdim Shela kaba ti mung shi hpe n hta shangun wu ai gaw, shi hkrak sha chye da wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai num hpe Yuda mu wu yang, shi a myi man hpe magap da wu ai majaw dai num gaw shawa num rai nga ai ngu nna myit nawn da wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yuda gaw lam a wora maga mi de lai sa nhtawm, “Rai sa, nang hpe jahpu kade daram jaw ra na ta?,” ngu nna tsun wu ai. (Shi gaw shi a kanam rai nga wu ai hpe n chye nga ai.) Dai num mahtang, “Nang ngai hpe hpa jaw na n ta?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yuda mahtang, “Nye a yam nga hpung kaw na bainam kasha langai mi nang hpe jaw dat na nngai,” ngu nna htan wu ai. Dai num gaw, “Rai sa, nang bainam kasha jaw dat ai aten du hkra, ga sadi hpe shatup lu u ga, arai lama ma hpe n jaw da lu na n ni?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yuda gaw, “Ngai nang hpe ga sadi hku hpa arai hpe jaw na rai nga a ta?,” ngu nna san wu ai. Dai num mung, “Na a dazik hte saidawng mung, nang lang ai dawhkrawng mung jaw da e,” ngu nna htan wu ai. Shi mung dai ni hpe jaw da wu ai. Dai hpang shan lahkawng kanawn mu ai rai nna, dai num hta na-um nasin hkum rai wa sai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang Htama mung nta de wa nhtawm shi a man magap hpe la kau nna gaida bu hpun palawng bai hpun da wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ya Yuda gaw dai num kaw tang da ai ga sadi arung arai ni hpe bai shaw la na matu shi a jinghku wa Hira hpe bainam kasha langai mi ya dat wu ai; rai ti mung, Hira mahtang dai num hpe n mu wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi gaw Enaim na lasha nkau mi hpe, “Ndai lam makau e nga ai shawa num kanang rai nga a ta?,” ngu nna san wu ai. Shanhte mahtang, “Ndai yang e shawa num langai galoi mung n nga yu ai,” ngu nna htan dat mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi gaw Yuda hpang de bai wa nna, “Ngai dai num hpe n lu tam nngai. Dai yang na lasha ni mung, ndai yang e shawa num galoi mung n nga yu ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yuda gaw, “Ngai shi hpe jaw shakut ti mung, nang shi hpe n mu tam nit dai majaw, an hpe masha ni e mani asawng kau na hpe n ra nga ga ai hte maren, arai dai ni hpe shi la kau sanu ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shata masum daram na ai hpang, marai langai mi gaw Yuda hpe, “Na a kanam Htama gaw shawa num zawn hpye hkawm nna, ya na-um nasin rai nga wu ai,” ngu nna tsun dan wu ai. Yuda gaw, “Shi hpe woi shapraw la nhtawm wan nat sat kau mu,” ngu nna hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi woi shapraw hkrum ai hte rau shi a kagu hpang de, “Ndai arung arai ni hpe madu ai wa a majaw ngai na-um nasin rai nga nngai. Ndai arai ni hpe yu yu u-ndai dazik hte de a saidawng, ndai dawhkrawng ni kade na rai nga ai gaw mada yu u,” ngu nna shiga shana dat wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yuda mung dai arai ni hpe yu matsing nna, “Shi mahtang ngai hta grau ding man nga ai. Ngai shi hpe ngai sha Shela hte kahkyin shangun ang ai rai tim, dai nye a lit hpe ngai hprai kau se ai,” ngu nna tsun wu ai. Dai hpang Yuda shi hte galoi mung bai n kanawn mat wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya shi a shangai nhtoi gu wa ai shaloi, shi hta ma marun rawng nga ai hpe chye lu nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shi ma shangai nga yang, langai wa lata shaw dat wu ai rai nna, shangai karum ya ai jan gaw dai hpe magra jum da nna hkyeng ai ri hte lata e gyit gumbat ya nna, “Ndai mahtang shawng shangai na ru ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rai ti mung, dai lata hpe shi bai dawm la kau ai shaloi, shi a kahpu shawng shangai wa sai. Shaloi shangai karum ai jan gaw, “Na a lam nang hpaw nga n hka!,” ngu wu ai. Dai rai nna shi hpe Hparet ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai hpang lata e ri ahkyeng hte gumbat da ai shi a kanau shangai wa ai rai nna shi hpe Zera ngu nna shamying mu ai.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Ishmaela masha ni Yosep hpe Egutu mung de woi hkrat wa nhtawm hkawhkam wa a mung bawng du salang ni hta na hkawhkam wang hpe sin ai sin langa ni a du Hputihpa hpe dut ya mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu gaw Yosep hte rau nga nga ai rai nna shi hpe awng dang shangun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yosep gaw Egutu masha shi a madu a nta hta nga wu ai. Shi galaw ai lam shagu mung shi hpe awng dang shangun ai dai Madu gaw Yosep hte rau nga nga ai hpe mu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hputihpa mung shi hpe yu sharawng wu ai rai nna shi hte sha seng ai shangun ma shatai da wu ai. Shi a nta hte shi madu da lu sai arung arai yawng Yosep hpe hpareng shangun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yosep a majaw, dai aten kaw nna dai Madu mung Egutu mung na dai masha wa a nta dinghku hte shi a sun hkauna na shi lu ai arai shagu hte hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hputihpa mung shi lu ai arung arai mahkra hpe Yosep e yu lajang na matu, shi a lata hta ap ya wu ai rai nna, shi sha ai lusha hta kaga hpa hpe mung shi nan n hkan chye nang ra wu ai. Yosep chyawm gaw hkum shingyan galu kaba nna ahpraw nsam mung htap nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kade n na yang, shi madu a madu jan mahtang Yosep hpe ra gasit hpang wa nna shi hte rau yup na matu saw lajin wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yosep mahtang n hkraw ya ai rai nna, shi hpe, “Yu u, ndai yang ngai nga nga nngai majaw nta kata na arung arai hpa hpe mung nye a madu shi nan n chye da ra nu ai. Shi lu malu arai mahkra hpe hpareng lajang ya na matu mung ngai hpe ap da ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ndai nta hta shi lu ai daru magam ahkang aya zawn ngai mung lu nngai. Nang hta kaga hpa mung ngai hpe shi hkum shingdang da ai n rai; dai re ai mi, dai zawn n hkru ai amu hte Karai Kasang hpe ngai kaning di shut hpyit lu na rai nga a ta?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw Yosep hpe shani shagu tsun wu ti mung, shi hte rau yup wu ai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai ti mung, lani mi na aten hta, Yosep gaw shi a amu galaw na nga, nta nhku de shang wa yang, dai yang e nta na shangun ma langai mi mung n nga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai numsha gaw shi a palawng galu hpe magra jum da nna, “Sa rit, ngai hte yup ga,” ngu wu ai. Rai ti mung shi chyawm gaw shinggan de kagat hprawng mat wa nna dai numsha a lata hta palawng galu hpe tawn kau da wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi a lata hta palawng galu hpe tawn kau da nhtawm shinggan de hprawng mat wa ai hpe shi mu dat wu yang,
  </para>
  <para style="p">
    <verse number="14" style="v" />shi a nta na shangun ma ni hpe shaga nna, “Da ndai hpe yu yu mu! Nye a madu wa ndai nta de woi tawn ai ndai Hebre masha wa gaw anhte hpe n sawn n sang di mi ai. Nye a gawk de shi shang wa nna ngai hpe roi na shakut wu ai majaw nsen kaba hte ngai dang lu ai daram jahtau dat we ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai ja ja jahtau dat ai nsen hpe shi na wu ai rai nna shi a palawng hpe nye a makau e tawn kau da nhtawm shinggan de gat hprawng mat wa wu ai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yosep a madu nta de bai du wa ai aten du hkra, shi a palawng galu hpe shi kaw tawn da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang shi gaw madu wa hpe, “Ndai kaw nang woi tawn da ai dai Hebre mayam wa gaw nye a gawk de shang nna ngai hpe n sawn n sang di wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rai ti mung, ngai jahtau dat we yang, shi a palawng galu hpe nye a makau e tawn kau da nna shinggan de gat hprawng mat wa wu ai,” ngu nna shawng na ga hte maren hkap tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yosep a madu chyawm gaw ja ja masin pawt wu ai rai nna, Yosep hpe rim nhtawm,
  </para>
  <para style="p">
    <verse number="20" style="v" />hkawhkam wa a bawng masha ni rawng ai htawng hta shi hpe bang da wu ai rai nna dai yang e shi bawng dung nga wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rai ti mung dai Madu gaw Yosep hte rau rai nga ai majaw shi hpe shaman ya wu ai; htawng agyi wa mung shi hpe ra sharawng nga wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai rai nna shi gaw Yosep hpe kaga bawng masha ni yawng hpe hpareng na ahkang ap ya wu ai rai nna htawng kata galaw na bungli lit shagu hpe mung shi hpe hpajang shangun mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai Madu gaw Yosep hte rau rai nga nna shi galaw ai amu shagu hta shi hpe awng dang shangun wu ai majaw htawng agyi wa gaw Yosep hte seng ai amu langai mi mung hkan yu ra wu ai n rai.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aten ram ram lai mat wa ai hpang, Egutu hkawhkam kaw sabyi jau ai wa hte muk kabaw ai agyi yan hkawhkam wa hpe shut kau mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ndai sabyi jau ai wa hte muk kabaw ai agyi yan hpe shi masin pawt ai majaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />Yosep hpe sharen da ai dai sin langa ni a du wa a nta na htawng hta e shan hpe sharen da mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shan gaw htawng kata hta nhtoi tsawmra mi na hkra sharen da ai hkrum ma ai hte sin langa a du wa gaw shan hpe yu na, shangun ma hku Yosep hpe lit shatsam da wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai yang e, htawng rawng nga ai sabyi jau ai wa hte muk kabaw agyi yan gaw lana jan hta sha,
  </para>
  <para style="p">
    <verse number="6" style="v" />lachyum kaga ga rawng ai yup mang langai hpra mu ma ai. Hpang jahpawt e Yosep shan kaw sa yang, shan myi man sum nga ai hpe shi mu wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw shan hpe, “Nan hpa majaw dai ni tup grai myit ru nga myit ni?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shan gaw, “An yup mang langai hpra mu ga ai. Rai ti mung, dai yup mang a lachyum hpa rai nga ai hpe htai dan lu na masha kadai mung ndai yang e n nga nga ai,” ngu nna htan mu ai. Yosep gaw, “Yup mang ni hpe htai na marai atsam ni hpe Karai Kasang jaw ya nga ai. Dai rai nna nan a yup mang ngai hpe tsun dan yu mi,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna sabyi jau ai wa gaw, “Nye a yup mang hta, yu u, nye a man e,
  </para>
  <para style="p">
    <verse number="10" style="v" />sabyi ru langai mi tu nga nna, dai hta lakung masum kung nga ai. Alap lap wa ai hte rau pu majawm ai hte pu pu nga ai rai nna sabyi si sumbaw ni myin nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam wa a sabyi gawm hpe ngai lang da nhtawm sabyi si sumbaw ni hpe gawm kata de shup bang nna dai hpe hkawhkam wa a lata de jaw nngai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yosep gaw, “De a lachyum ndai hku rai nga ai. Sabyi lakung masum gaw masum ya rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Masum ya rai jang, hkawhkam wa nang hpe shapraw dat nna mara dat ya na ra ai. Dai sha n-ga, na a aya hta nang hpe bai dang da na ra ai. Shawng de nang shi a man e, sabyi jau yu nit dai hte maren, shi a gawm hte shi hpe nang jau lu na rin dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai ti mung, lam shagu hta nang ngamu ngamai wa ndai shaloi, chyeju hte ngai hpe dum nga e; hkawhkam wa a man e nye a lam tsun dan lu nit ga, chyeju hte ngai hpe matsan dum la e. Ndai htawng kaw nna pru lu na mung, ngai hpe karum la e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw Hebre masha ni a mung kaw nna shagyeng rim woi la hkrum ai wa rai nga nngai. Ya ndai Egutu mung hta mung htawng e rim bang da hkrum na daram kaba ai ari hte ging dan ai amu hpa hpe mung n galaw shut kau yu nngai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai sabyi jau ai wa a yup mang chyawm gaw myi man pa shangun lu na lachyum rai nga ai hpe muk kabaw ai agyi wa chye wu yang, shi mung Yosep hpe, “Ngai mung yup mang langai mu nngai; dai gaw muk rawng ai ka masum hpe nye baw ntsa e gup da we ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ntsa jahtum na muk ka hta hkawhkam wa a matu kabaw hkut da sai muk amyu hkum sumhpa yawng rawng nga li ai rai nna, ntsa malen u ni mung dai ni hpe shaw sha ma ai,” ngu nna hkai dan wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yosep mung, “De a lachyum gaw da ndai hku rai nga lit dai; dai muk ka masum gaw masum ya rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Masum ya rai jang hkawhkam wa nang hpe shalawt dat nna baw kahtam di kau ya na ra ai. Dai hpang na a hkum hpe hpun shadaw hta noi da na mara ai; ntsa malen u ni mung na a ashan hpe achye sha na mara ai,” ngu nna htai ya wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Masum ya nhtoi lai jang, hkawhkam wa shi a shangai nhtoi shani hta, shi a du salang ni yawng hpe lusha poi galaw daw wu ai; dai hpang sabyi jau ai wa hte muk kabaw ai agyi yan hpe shi a du salang ni a man de woi shapraw dat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi gaw sabyi jau ai wa hpe shawng na shi a aya hta bang da wu timung, muk kabaw ai agyi wa hpe chyawm gaw sat kau wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai lam yawng gaw Yosep htai da sai hte maren byin wa sai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai ti mung, sabyi jau ai wa mahtang Yosep hpe galoi mung n myit dum ai sha shi a lam yawng hpe malap kau wu ai.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya lahkawng ning lai jang, Egutu hkawhkam yup mang mu wu ai. Yu u, Nila hka nu makau e shi tsap nga yang, dai hka nu hta na hpum sau ai
  </para>
  <para style="p">
    <verse number="2" style="v" />hte hkum hkrang pri manen ai upra sanit pru lung wa nhtawm tsingdu tsingman ni hpe sha let nga nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hpang kaga upra sanit mung pru lung wa ma ai. Dai ni mahtang gaw lasi grawm grawm rai nna nra dawng ai hte kyip kyip rai ma ai. Dai ni gaw hkin-gau ntsa e nga nga ai kaga upra ni a makau hkan e sa tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai lasi grawm grawm re ai upra ni mahtang hpum sau ai upra ni hpe sha kau mu ai, dai hpang hkawhkam wa hprang mat wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi bai yup nna kaga yup mang hpe bai mu wu ai. Yu u, mam hpun langai mi hta na ja kat nna myin sai mam gungsi sanit si pru nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpang kahtet kang ai zaibru jang nbung ahpawt ai a majaw mam nmyem gungsi sanit pru nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai mam nmyem gungsi ni mahtang ja kat ai gungsi ni hpe mayu kau mu ai. Dai hpang hkawhkam wa hprang mat wa ai hte yup mang mu nu ai hpe shi dum chye wa wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jahpawt rai jang, shi myit ru nga ai rai nna, Egutu mung na mandan lakle chye ai sara ni hte hpaji byeng-ya chye ai ni yawng hpe shi shaga la nhtawm shi a yup mang hpe hkai dan wu ai. Rai ti mung, shi mu ai yup mang htai ya lu ai masha mi n nga nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang sabyi jau ai wa gaw hkawhkam wa hpe, “Ngai shut kau se ai majaw mara dai hpe dai ni she ngai yin la lu nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang chyawm gaw muk kabaw ai agyi hte ngai hpe masin pawt nit dai majaw sin langa du wa a nta hta an hpe sharen da mi ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />An lahkawng gaw lana jan e sha, lachyum kaga ga rawng ai yup mang ni hpe mu ga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai sin langa du wa ai mayam ngu ai Hebre shabrang langai mi mung dai yang e an hte rau sharen da ai hkrum wu ai. Shi hpe yup mang ni hkai dan ga ai rai nna an a matu dai ni hpe shi htai ya mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi htai ya ai hte maren, lam shagu byin wa sai. Dai rai nna mi na nye a aya hpe nang bai jaw ya tim, muk kabaw ai agyi wa hpe chyawm gaw nang sat kau nit dai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hkawhkam wa gaw Yosep hpe shaga la na matu shangun dat wu ai. Shi gaw nmun shangun nna hpun palawng galai kau ngut ai hte hkawhkam wa a man de shang wa wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hkawhkam wa gaw shi hpe, “Ngai yup mang langai mu nngai, dai hpe kadai mung n htai lu ma ai. Nang chyawm gaw yup mang ni hpe htai ya lu nga ndai hpe ngai chye da ni ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yosep gaw, “Hkawhkam wa e, ngai n htai lu na nngai; rai ti mung Karai Kasang gaw ra sharawng ai ga htai langai jaw ya na ra ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hkawhkam wa mung, “Nila hka nu hka kau e ngai tsap nga yang
  </para>
  <para style="p">
    <verse number="18" style="v" />hpum nna manen pri tsawm ai nga upra sanit dai hka nu kaw na pru lung wa nhtawm tsingdu tsingman ni sha let nga nga ma ai hpe ngai mu nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang lasi grawm grawm rai nna nra hkrai se se re ai kaga nga upra sanit mung pru lung wa ma ai. Dai ni gaw Egutu mung shara shagu hkan ngai galoi mung mu yu nga ai ni hta pyi grau n tsawm ai upra ni rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai lasi ai upra ni mahtang hpum tsawm ai ni hpe sha kau mu ai;
  </para>
  <para style="p">
    <verse number="21" style="v" />rai ti mung, mi na ta raw yu n tsawm nga ma ai majaw kadai mung dai hpe n chye ma ai. Dai hpang ngai hprang mat ni ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai mam hpun langai mi hta kaba ja kat nna myin ai mam gungsi sanit si pru wa ai yup mang hpe mung ngai naw mu nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hpang e mung, kaji nna nyip nyip rai nhtawm kahtet kang ai zaibru jang nbung a majaw kahtet kyip mat ai mam gungsi sanit prut lung wa nga ai;
  </para>
  <para style="p">
    <verse number="24" style="v" />dai ni gaw ja kat ai mam gungsi sanit hpe mayu kau mu ai. Yup mang dai ni hpe mandan lakle sara ni hpe ngai hkai dan ti mung shanhte hta na kadai mung n htai ya lu ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yosep gaw hkawhkam wa hpe, “Dai yup mang lahkawng yan a lachyum gaw maren sha rai nga ai. Karai Kasang galaw na amu shi nang hpe tsun dan nu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hpum sau ai nga upra sanit gaw sanit ning rai nga ai; bai ja kat ai mam gungsi sanit mung sanit ning rai nga ai. Dai ni gaw lachyum maren sha rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />De a hpang e pru lung wa ai lasi grawm grawm re ai nga upra sanit hte kaji nna nyip nyip rai nhtawm kahtet kang ai zaibru jang na nbung ahpawt ai a majaw kyip mat ai mam gungsi sanit gaw hku hku na sanit ning rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai gaw ngai nang hpe hkai dan ai hte maren Karai Kasang galaw na amu shi nang hpe madun dan nit dai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai rai nna Egutu mung ting hta sanit ning tup nai mam ni hpring kabrat hkra law htam wa na ra ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai hpang sanit ning hku hku wa na ra ai rai nna dai gaw mung ting hpe jahten kau na ra ai; shawng na lu su ngamu ngamai lai wa sai sanit ning hpe dum lu na ra ai n rai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hku hku ai gaw nachying hkrit kajawng shara rai na ra ai majaw shawng na lu su ngamu ngamai ai aten hpe n dum mat hkra malap kau na mara ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nang mu kahtap ai yup mang a lachyum gaw dai amu hpe Karai Kasang shagrin shangang nna dai hpe du na ra ai kade n na ai aten hta shi shabyin dat na ra ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Dai re ai majaw, hpaji byeng-ya hte myit kraw hpaji hte hpring ai masha hpe, ya jang nang lata la nhtawm mungdan hpe hpareng na shi hpe san tawn da sanu.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kaga myit su salang ni hpe mung san da nna hpring kabrat hkra lu su ngamu ngamai ai sanit ning laman na nai mam htam manga hta na htam mi hpe lahkawn shangun u.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai du na ra ai lu su ngamu ngamai ai shaning laman hta malu masha yawng lahkawn shinggyin da lu na matu, shanhte hpe hkang da nna dai ni hpe sin na matu shanhte hpe ahkaw ahkang jaw ya u.
  </para>
  <para style="p">
    <verse number="36" style="v" />Egutu mung a ntsa e du wa nga ai dai hku hku na sanit ning laman hta, dai malu masha gaw mungdan a matu jarit lusha tai na ra ai. Ndai lam hku nna, mung masha ni kawsi kyet na mara ai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hkawhkam wa hte shi a mung du salang ni mung shi a yaw shada ai lam hpe myit hkrum ya mu ai hte shagrin ya mu ai;
  </para>
  <para style="p">
    <verse number="38" style="v" />shi gaw shanhte hpe, “Karai Kasang a Wenyi rawng ai ndai Yosep hta grau kaja ai masha anhte galoi mung mu tam na ga ai n rai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hkawhkam wa gaw Yosep hpe, “Karai Kasang nang hpe ndai amu yawng madun dan nit dai majaw kaga kadai hta mung grau kaba ai hpaji byeng-ya hte myit kraw hpaji hpe nang lu la nga ndai gaw asan sha rai nga sai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ngai gaw nang hpe nye a mungdan ting a ntsa na mung du shatai na nngai; nye a amyu masha ni yawng na a hkang da ai ga ni hpe madat mara na mara ai. Na a ahkang aya mung nye a lawu hprut hta agrin nga lu na rin dai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ngai nang hpe Egutu mung ting hpe up hkang na mung du aya ya jang san da sade ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hkawhkam wa mung hkawhkam dazik tawk ka da ai lachyawp hpe shi a lata hta chyawp ya wu ai. Dai hta kaga, reng ai lachyit palawng galu hpe mung jahpun ya nhtawm shi a du hta ja saidawng mung gali ya wu ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shi gaw Yosep hpe hkawhkam wa jawn ai leng a lahkawng ngu na leng hta shajawn wu ai. Shi a sin langa ni mung shi a shawng e sa wa nna, “Lam yen mu! ngu nna jahtau mu ai. Shing rai Yosep gaw Egutu mung ting hpe up hkang lu na mung du aya hta san da ai hkrum wu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hkawhkam wa gaw shi hpe, “Ngai hkawhkam rai nga nngai-na a ahkang hte sha n rai yang, Egutu mung ting hta kadai mung tinang a lagaw lata sharawt lu na ma ai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shi gaw Yosep hpe Egutu amyu mying rai nga ai Zahpenat Hpanea ngu nna shamying wu ai; bai shi hpe Heliopoli mare na hkinjawng Hputihpera a shayi sha Asenat hpe mung shi a matu la ya mu ai. Egutu hkawhkam hpe daw jau hpang wa ai aten hta Yosep a asak gaw sumshi ning rai nga salu ai. Shi gaw hkawhkam wang kaw nna pru mat wa nhtawm Egutu mung ting de gawan hkawm wu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Dai lu su ngamu ngamai ai sanit ning laman hta lamu ga gaw nsi naisi law htam hkra shapraw ya nga ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Yosep gaw dai ni yawng hpe lahkawn shinggyin nna mare ni hta htun da wu ai. Dai mare ni a grup yin hkauna ni hta na nai mam malu masha ni hpe mung mare shagu hta htun da wu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Nai mam ni grai law htam nga ai rai nna, dai ni hpe n shadawn ai sha tawn da wu ai. Dai ni gaw panglai zaibru daram law nga ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Dai hku hku ai shaning ni garai n du yang, Asenat gaw Yosep a matu shadang sha lahkawng shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Shi gaw, “Ngai hkam sha ai nye a nni nkri yawng hte nye wa a dinghku yawng hpe Karai Kasang e malap kau shangun ni ai. Dai re ai majaw shi a shadang sha alat hpe Manashe ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Shi gaw, “Ngai ru yak tsin-yam tsindam sa hkrum ai mung hta Karai Kasang ngai hpe kashu kasha jaw ya ni ai,” ngu nna tsun wu ai. Dai majaw dai shadang sha hpe Ehprim ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ya Egutu mung hta lu su ngamu ngamai ai sanit ning htum mat ai hte rau Yosep htai ya sai hte maren,
  </para>
  <para style="p">
    <verse number="54" style="v" />hku hku na sanit ning gaw du hpang wa ra ai. Dai rai nna mung shagu hkan e hku hku nga ma ti mung Egutu mung hta chyawm gaw lusha ni nga nga ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Egutu masha ni kawsi kyet hpang wa ai shaloi, shanhte gaw hkawhkam wa kaw lusha sa hpyi jahtau ma ai. Shanhte hpe Yosep hpang de sa shangun nhtawm shi shanhte hpe tsun ai hte maren, hkan galaw na matu hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Dai hkuwa gaw grau grau sawng wa ai rai nna mungdan ting hta byin nga ai. Yosep gaw mam dum ni yawng hpe hpaw nhtawm Egutu masha ni hpe nai mam dut ya wu ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Dai hkuwa gaw shara shagu hkan nachying laja nga ai majaw Yosep hpang de nai mam mari na nga, mung shagu na masha ni Egutu mung de du sa nga ma ai.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Egutu mung e nai mam nga ai hpe Yaku chye wu yang, shi gaw shi a shadang sha ni hpe, “Nanhte hpa majaw shada da sha yu hkat nga myit ni?
  </para>
  <para style="p">
    <verse number="2" style="v" />Yu mu, Egutu mung e nai mam ni nga nga ai hpe ngai na nngai; anhte kyet si ai n hkrum u ga, dai mung de yu sa nna nai mam ni sa mari la masu,” ngu tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yosep a kahpu ni marai shi hte gaw nai mam mari na nga, Egutu mung de yu sa ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai ti mung, Yaku gaw Yosep a kanau Benyamin hpe chyawm gaw kahpu ni hte rau n shangun dat wu ai; hpa majaw nga yang, shi hta n hpru n mai ai lam lama ma hkrum hkra na wu ai hpe shi hkrit tsang ai majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hkanan mung hta mung hku hku wa ai majaw, Yaku a shadang sha ni, nai mam mari na nga, kaga masha ni hte rau du shang wa ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Egutu mung a mungdu Yosep gaw mungkan shara shagu na du sa ai masha ni hpe nai mam ni dut ya nga wu ai. Yosep a kahpu ni du sa nhtawm shi man e ga du hkra dingnyawm dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yosep gaw shi a kahpu ni hpe mu ai shaloi, shi shanhte hpe chye matsing wu ti mung, shanhte hpe n chye ai zawn shi galaw dan wu ai. Shi gaw shanhte hpe nsen shaja let, “Nanhte kanang na du sa ai ni rai myit ta?,” ngu nna san wu ai. Shanhte gaw, “Nai mam malu masha mari na matu Hkanan mung kaw nna anhte du sa raga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yosep mahtang shi a kahpu ni hpe chye matsing wu ti mung, shanhte shi hpe n chye matsing da mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yosep gaw shanhte a lam hte shi mu ai yup mang ni hpe myit dum let, “Nanhte kin-yu ni rai nga myit dai; anhte a mungdan n-gun kya ai hpe sa yu ai ni she rai nga myit dai,” ngu nna shanhte hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte mahtang, “N rai law madu e, na a mayam ni lusha mari na san san a matu sha du sa ga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anhte yawng mung kahpu kanau ni hkrai rai nga ga ai. Anhte kin-yu ni n rai nga ga ai. Madu e, anhte gaw ding man ai masha ni she rai nga ga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yosep gaw shanhte hpe, “N rai law, nanhte gaw anhte a mungdan n-gun kya ai hpe sa yu ai ni she rai nga myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte mung, “Madu e, anhte gaw Hkanan mung hta nga ai kawa langai a shadang sha kahpu kanau shi lahkawng ni rai ga ai. Kanau langai mi mahtang si mat nna hpungdim wa chyawm gaw anhte kawa hte rau ya naw nga nga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yosep gaw, “Ngai tsun sai hte maren, nanhte gaw kin-yu ni she rai nga myit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai lam teng n teng nanhte chyam yu ai hkrum na myit dai. Nanhte a kanau hpungdim wa hpe ndai shara de n woi sa myit dai rai yang chyawm gaw galoi mung pru wa lu na myit dai n rai, ngu nna hkawhkam wa a mying hta ngai dagam da made ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nanhte tsun ai ga teng ai n teng ai hpe chyam yu lu hkra, nanhte hta na marai langai mi wa nna shi hpe wa woi la mu; ngam ai ni hpe chyawm gaw htawng hta sharen da na mawe ai. Dai hku n rai yang, hkawhkam wa teng teng hkrung nga ai hte maren, nanhte kin-yu ni rai nga myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang shi shanhte hpe htawng hta masum ya sharen da wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Masum ya du ai shani hta Yosep gaw shanhte hpe, “Ngai gaw Karai Kasang hpe hkrit kamyin ai wa rai nga nngai. Dai rai nna mabyin lam langai mi a ntsa hta ngai nanhte a asak hpe jahkrung da ya na made ai rai nna ning di mu:
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanhte ding man nga myit dai hpe chyam yu lu hkra, nanhte hta na marai langai ngai hpe htawng hta sharen da nna, ngam ai ni mahtang kawsi kyet nga ai nanhte a dinghku masha ni hpang de nanhte lu mari da lu sai nai mam ni la nna nhtang wa masu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hpang nanhte a kanau hpungdim wa hpe ngai hpang de woi sa wa mi; dai hku galaw ai gaw nanhte tsun ai dai teng man ai lam gaw sakse tai wa nna, nanhte mung si na myit dai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte mung dai ga hpe myit hkrum ya mu ai rai nna, shanhte shada da mung, “Rai sa, anhte a kanau wa hpe anhte galaw kau ai amu ni a majaw ya, anhte nni nkri hkrum sha nga saga ai; shi a myit masin hta na ru yak tsin-yam tsindam kaba hpe anhte mu nna, karum la na matu shi hpyi nem ti mung, anhte n madat kau ya saga ai. Dai re ai majaw ya anhte ndai ru yak tsin-yam tsindam hkrum sha nga saga ai,” ngu nna tsun hkat ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rubin chyawm gaw, “Ma hpe n machyi shangun na matu, ngai tsun ni ai; rai ti mung, nanhte mahtang n madat ya myit dai. Shi a si hkrung si htan a matu, ya anhte ari jaw ai hkrum nga saga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yosep gaw shanhte kaning nga tsun ai hpe chye na wu ti mung, shanhte dai lam hpe n chye mu ai; hpa majaw nga yang, shanhte mahtang shi hpe ga gale ai wa hte tsun tsun di wu ai majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yosep gaw shanhte kaw nna pru mat wa nhtawm sa hkrap nga wu ai. Shanhte kaw bai nhtang shang wa nna ga shaga ngut jang Simun hpe shaw shapraw la nhtawm shanhte a man e shi hpe gyit tawn wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yosep gaw shi kahpu ni a daw hta nai mam ni hte baw jahpring ya nhtawm, langai hte langai a nhpye htingpa hta mung tinang a gumhpraw bai bang ya nna, hkrun lam a matu malu masha jaw dat na hkang dat wu ai. Dai mung galaw da nga sai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kahpu ni gaw lawze ni hta shanhte mari da sai nai mam ni hpe htaw nna pru mat wa ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte gaw shawng de lana mi but yu sai dabang sa ra hta langai wa mi gaw shi a lawze hpe lusha jaw na nga, shi a nhpye htingpa hpaw dat wu yang, dai nhpye htingpa mahka hta shi a gumhpraw ni hpe mu wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shi gaw shi a kahpu ni hpe shaga la nhtawm, “Nye a gumhpraw ngai hpe bai bang ya mi ai. Dai gaw nang e nye a nhpye htingpa hta rawng nga li ai!,” ngu nna tsun wu ai. Shanhte mung myit mak mat nna hkrit gari let Karai Kasang anhte hpe hpa wa mi galaw nu ai kun?,” ngu nna shanhte shada da san hkat mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hkanan mung e nga ai shanhte a kawa Yaku kaw du wa yang, shanhte hta hkrum kadup ai lam yawng hpe tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Dai Egutu mungdu wa gaw anhte hpe ja ja tsun nna, shi a mung hpe kin-yu yu shadu mani ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai, ‘Anhte chyawm gaw kin-yu ni n rai ga ai, ding man ai masha ni she rai nga ga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anhte gaw kawa langai kaw na shadang sha marai shi lahkawng rai nga ga ai. Kanau langai mahtang n nga mat nna, hpungdim wa gaw Hkanan mung e, anhte a kawa hte rau naw nga nga ta sai,” ngu nna anhte htan ga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai wa gaw, “Nanhte ding man ai masha ni rai myit yang mung, ndai hku nna sawk shapraw yu made ga; nanhte hta na marai langai mi ngai hte rau nga nna, ngam ai ni mahtang nanhte mari da sai nai mam ni hte hpawn, kawsi kyet nga ai nanhte a dinghku masha ni hpang de la wa masu.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nanhte a kanau hpungdim wa hpe ngai hpang de woi sa wa marit. Shaloi nanhte gaw kin-yu ni n rai nga myit dai sha, ding man ai masha ni she rai nga myit dai hpe ngai chye lu na made ai. Nanhte a hpu nau wa hpe ngai mung nanhte a lata de bai ap ya ai hte nanhte mung ndai yang e shanu nga lu nna, hpaga yumga galaw lu na myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai hpang shanhte mung shanhte a nhpye htingpa ni hpe htawk yu mu yang, shanhte langai hte langai tinang nang a gumhpraw tingsan ni hpe mu ma ai. Shanhte dai gumhpraw tingsan ni hpe mu ma ai shaloi, shanhte hte shanhte a kawa Yaku ni hkrit gari nga ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shanhte a kawa gaw shanhte hpe, “Nye a kasha ni yawng hpe jasum kau shangun na nanhte ra nga myit ni? Yosep n nga sai, Simun mung n nga sai. Ya Benyamin hpe mung la kau ya na nanhte ra sharawng nga myit dai. Ngai mahtang dai nni nkri hpe hkam sha ai wa rai nga n hka!,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Rubin gaw shi a kawa hpe, “Benyamin hpe nang hpang de, ngai bai n woi nhtang wa ai rai yang, nye a shadang sha lahkawng yan hpe nang sat kau ya lu na ndai. Dai re ai majaw nye a lata hta shi hpe ap ya e, ngai shi hpe bai woi nhtang wa na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Rai ti mung, Yaku gaw, “Nye a kasha gaw nanhte hte rau yu sa lu na n rai; shi a kahpu mung si mat salu ai, shi langai chyu sha ngam sai. Hkrun lam e shi hta lama ma mung byin hkrum chye nga ai. Ya ngai asak kaba ugut gu ni ai rai nna, ngai hpe yawn hkyen ai amu shabyin nna sat kau na myit dai,” ngu nna tsun wu ai.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hkanan mung hta hkuwa grau laja wa ai rai nna, Egutu mung na
  </para>
  <para style="p">
    <verse number="2" style="v" />shanhte htaw wa ai nai mam ni yawng hpe Yaku a dinghku masha ni sha kau ngut jang, Yaku gaw shi a shadang sha ni hpe, “Anhte a matu lusha loi mi naw sa mari la na, bai rawt yu masu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yuda mahtang shi hpe, “Anhte a kanau wa hpe anhte hte rau n woi sa ai rai yang, shi a man de anhte shang lu na ga ai n rai, nga nna dai wa anhte hpe ja ja sadi jaw dat mi ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte a kanau wa hpe anhte hte rau jahkan dat na nang kam ai rai yang gaw, na a matu lusha anhte sa mari na ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai ti mung nang n kam ai hte anhte a kanau wa hpe mung anhte hte rau n woi sa ai rai yang chyawm gaw shi a man de shang lu na ga ai n rai,” ngu nna shi anhte hpe tsun da mani ai majaw anhte n yu sa lu na ga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yaku mung, “Nanhte hta kaga kanau naw nga ai lam, dai wa hpe tsun dan nna ngai hpe hpa rai tsin-yam tsindam shabyin nga myit ta?,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw, “Dai wa mahtang anhte a lam, anhte a dinghku a lam grai grai san let, ‘Nanhte a kawa naw hkrung nga malit ni? Nanhte hta kaga kanau naw nga myit ni?,’ nga ai majaw shi a ga san ni hpe anhte htai kau ya saga ai. Anhte a kanau hpe anhte hte rau woi sa shangun mu, nga nna shi anhte hpe tsun dat ai hpe anhte kaning rai chye lu na rai nga ga ta?,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yuda gaw kawa hpe, “Dai ma hpe ngai hte rau jahkan dat wu. Dai rai jang, anhte ya jang rawt sa wa na ga ai. Anhte kadai mung kawsi kyet si na ga ai n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai gaw nye a asak ap let ga sadi shagrin da nngai rai nna shi a majaw ngai hpe mara shagun lu na ndai. Ngai shi hpe shim lum hkam kaja ai hte nang hpang de bai n woi wa ai rai yang, dai mara hpe ngai tut nawng gun nga na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anhte grai wa na mat hkra n la ra ga taw gaw, dai mung de lahkawng lang pyi bat lu na saga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte a kawa chyawm gaw, “Dai rai taw, ning rai mu: dai mung du wa a matu kumhpa shatai na ndai mung na kaja htum ai balsam naw loi mi, lagat ntsin loi mi, manam hawm ai baw namji namya ni, mura, chyaran si hte batan si ni hpe nanhte a magun lit ni hta bang nna la sa ya mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanhte mung gumhpraw htam lahkawng la gun mu, hpa majaw nga yang, nanhte a lit mahka hta nhtang ya dat ai gumhpraw ni hpe mung gun sa mu; dai gaw shut ai amu rai yang mung rai na sai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanhte a kanau hpe mung woi nna, ya jang dai wa hpang de nhtang sa wa manu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyahtum Chyalai N-gun Rawng Ai Karai Kasang gaw dai wa a jaw e, nanhte hpe matsan dum la shangun nga u ga; Benyamin hta kaga nanhte a hpu nau langai mi hpe ngai hpang de bai woi nhtang wa na shi dat dat ya na ru ai. Nye a matu chyawm gaw, kasha ni sum mat ai rai yang mung sum mat sanu ga,” ngu nna shanhte hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shan nau ni gaw kumhpa ni hte gumhpraw htam lahkawng la lang nna Benyamin hte rau Egutu mung de rawt sa mat wa ma ai. Shanhte hkum nan Yosep kaw sa du ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte hte rau Benyamin lawm sa wa ai hpe Yosep mu wu yang, shi a nta hpareng ya ai shangun ma wa hpe, “Ndai ni hpe nye a nta de woi wa su; ngai hte rau dai ni shani ka-ang e shat lusha sha lu na ma ai; shan sat nhtawm lusha wa hkyen su,” ngu nna shi hpe hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi hkang dat ai hte maren shangun ma wa galaw nna kahpu kanau ni hpe Yosep a nta de woi wa ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte nta de woi wa hkrum ma ai shaloi, shanhte gaw, “Shawng na lang anhte a nhpye htingpa ni hta bai bang dat ya ai gumhpraw a majaw ndai yang e anhte woi la ai hkrum nga saga ai. Shanhte gaw anhte hpe akajawng sha htim gasat nhtawm anhte a lawze ni hpe la kau ya ai hte anhte hpe mayam shatai kau na mu ai,” ngu nna shanhte hkrit ai hte myit nawn da ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai rai nna shanhte gaw hpareng shangun ma wa hpe nta chyinghka e, “Madu e, nang ra sharawng ai rai yang,
  </para>
  <para style="p">
    <verse number="20" style="v" />anhte ndai yang e, lusha mari na matu shawng de kalang mi du yu saga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nta de wa ai hkrun lam na dabang hta anhte nga nga ga ai shaloi, anhte a nhpye htingpa ni hpe hpaw yu ga yang, tinang nang a nhpye htingpa mahka hta myi na ta n yawm ai sha rawng nga ai gumhpraw ni hpe an nau ni mu ga ai. Dai hpe nang hpang de anhte la sa raga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya mung, lusha mari na matu anhte hte rau gumhpraw hpe mung grau law la sa ga ai. Anhte a nhpye htingpa ni hta dai anhte a gumhpraw ni hpe kadai bang dat ya ai gaw, anhte n chye ga ai,” ngu nna tsun dan ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai shangun ma wa chyawm gaw, “Hkum myit ru myit; hkrit mung hkum hkrit myit. Nanhte a Karai Kasang dai nanhte a kawa a Karai Kasang gaw nanhte a nhpye htingpa ni hta nanhte a matu gumhpraw bang ya manit dai. Nanhte a gumhpraw hpe ngai lu la ni ai,” ngu tsun nhtawm Simun hpe shapraw ya ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai shangun ma wa gaw shan nau ni hpe nta de woi shang wa wu ai. Shi shanhte hpe ntsin jaw wu ai rai nna, shanhte lagaw shin la lu ma ai; lawze ni hpe mung ushat jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte gaw Yosep hte rau lusha jawm sha na matu saw shaga da hkrum nga ma ai majaw shani ka-ang shi du wa ai shaloi, shi hpe jaw na kumhpa ni hpe mung jin jin lajang da mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yosep gaw nta nhku de du shang wa ai shaloi, shi nga ai nta nhku de kumhpa ni hpe shanhte la shang wa nhtawm shi a man e ga du hkra gum dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shi gaw shanhte a hkam kaja lam hpe san yu nhtawm, “Nanhte a kawa dingla a lam ngai hpe tsun dan yu manit dai-shi gara hku rai nga a ni? Shi naw hkrung nna hkam kaja nga a ni?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte mung, “Nang hpe hkungga ai shangun ma, anhte a kawa gaw naw hkrung nga nna hkam kaja nga ai,” ngu nna htan let shi a man e hput di nhtawm gum dagup ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai yang e Yosep a kanau Benyamin hpe shi mu wu ai shaloi, shi gaw, “Ndai wa gaw nanhte ngai hpe tsun dan yu sai nanhte a kanau hpungdim wa rai nga a ni? Ngai sha e, Karai Kasang nang hpe shaman chyeju jaw u ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai hpang Yosep gaw shi a myit masin hta n-gaw n wai ai myit hpring nga lu ai majaw akajawng sha pru mat wa wu ai. Shi gaw sharai n lu gawng run wu ai rai nna, shi a gawk kata de shang hkrap nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi gaw man myit kau nhtawm tinang hkum hkang let pru wa nna, lusha daw jau na matu hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Yosep a matu sha ku langai, shi a kahpu kanau ni a matu kaga shara mi di nna lajang ya ma ai. Dai yang e sha ai Egutu masha ni a matu mung kaga tawn ya mu ai. Dai gaw shanhte mahtang Hebre masha ni hte rau sha na matu arawng sum dum nga ai ngu, shanhte myit nawn la ai majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kahpu kanau ni gaw hpu lat wa kaw nna hpungdim wa kaw du hkra tinang a asak kaji kaba hku hkan nna Yosep hte man hkrum rai sha ku saboi e greng rai dung nga ma ai; shanhte kaning rai dung nga ai hpe shanhte mu ai shaloi shanhte shada da yu nna mau nga ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shat lusha hpe Yosep a sha ku kaw nna shanhte hpe daw jau mu ai rai nna Benyamin hpe mahtang kaga ni hta jan nna manga lang jat ya wu ai. Dai rai nna shanhte gaw Yosep hte rau shanhte lu nang mat ai aten du hkra rau lu rau sha nga ma ai.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yosep gaw shi a nta hpareng ai shangun ma wa hpe, “Ndai ni a nhpye htingpa ni hta shanhte htaw lu ai made mam baw jahpring dat ya nhtawm, langai hte langai a gumhpraw ni hpe mung tinang nang a nhpye htingpa mahka hta bang dat ya u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a gumhpraw gawm hpe kanau hpungdim wa a nhpye htingpa mahka hta nai mam mari na matu la sa ai gumhpraw hte hpawn bang dat u,” ngu nna hkang dat wu ai. Shi mung hkang dat ai hte maren galaw wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jahpawt manap jau jau aten e, dai kahpu kanau ni hpe shanhte a lawze ni hte rau dat dat mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw mare hte kade wa n tsan ai shara hta naw hkawm nga ma yang, Yosep gaw shi a nta hpareng ya ai shangun ma wa hpe, “Wora masha ni hpang de tin tin hkan su; nang shanhte hpe hkan dep ai shaloi, “Nanhte gaw mai kaja lam hpe n kaja ai hte hpa rai htang nga myit ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye madu a gumhpraw gawm hpe hpa rai nanhte lagu la nga myit ni? Dai gaw shi lu ai gawm rai nna shaba wawt yang lang ai gawm mung rai nga ai. Ya nanhte gaw grai sawng ai ru hka amu she shut kau manit myit hka!,’” ngu nna shanhte hpe san u, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai shangun ma wa shanhte hpe hkan dep ai shaloi, ndai ga ni hpe shi kahtap tsun wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw, “Madu e, dai zawn nga nna tsun mi ai gaw kaning ngu mayu nga ndai kun? Dai zawn re ai amu anhte n galaw shut yu ga ai hpe dagam lu ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anhte a nhpye htingpa mahka ni hta mu ai gumhpraw ni hpe pyi Hkanan mung kaw na nang hpang de bai la sa saga ai hpe nang chye nga ndai. Dai she rai yang me, na a madu a nta kaw na ja gumhpraw anhte hpa rai lagu na rai nga ga ta?
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, anhte hta na marai langai ngai hta dai hpe mu ai rai yang, shi si lu na rai wu ai; anhte mung na a mayam ni tai na saga ai,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw, “Ngai myit hkrum ya nngai; rai ti mung dai gawm hpe la ai wa chyu sha nye a mayam tai lu na, nanhte hta na ngam ai ni yawng chyawm gaw lawt lu na rai myit dai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna shanhte mung shanhte a daw ni hpe ga de tin tin shayu nhtawm kadai mung kadai tinang nang a nhpye htingpa ni hpe hpaw yu ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yosep a shangun ma wa mung kaba htum ai wa kaw nna kaji htum wa kaw du hkra, azin ayang sawk tam wu yang, Benyamin a nhpye htingpa hta dai gawm hpe mu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai kahpu kanau ni gaw yawn hkyen ai hte shanhte a hpun palawng ni hpe gang je kau nna shanhte a lawze ni hta daw mara nhtawm mare de bai nhtang wa ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yuda hte shi a kahpu kanau ni Yosep a nta de shang wa ai shaloi, shi mung dai yang e naw nga nga wu ai. Shanhte shi a man e gum dagup nga ma yang,
  </para>
  <para style="p">
    <verse number="15" style="v" />Yosep gaw, “Nanhte hpa galaw kau myit ta? Ngai zawn san ai masha wa gaw nanhte hpe shaba wawt let tam shapraw la lu ai hpe nanhte n chye nga myit ni?,” ngu nna san mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yuda chyawm gaw, “Madu e, nang hpe anhte hpa tsun lu na rai nga ga ta? Anhte kaning rai ndang hkat lu na ga ta? Anhte gaw tinang hkum hpe kaning rai jasan shapra lu na rai nga ga ta? Karai Kasang mung anhte a mara n magap da ya mani ai. Ya chyawm gaw dai gawm mu hkrum ai wa sha n-ga, anhte yawng mung na a mayam ni rai nga saga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yosep gaw, “Dai hku n rai law! Dai zawn re ai amu hpe ngai galoi mung galaw na we ai n rai! Gawm la hkrum ai wa chyu sha nye a mayam tai na rai nga ai. Nanhte ngam ai ni chyawm gaw nanhte a kawa hpang de shim lum ai hte angwi apyaw sha nhtang wa mu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yuda chyawm gaw Yosep hpang de sit lung wa nna, “Madu e, chyeju hte nang hte n dut n dang ga shaga lu na ahkang jaw e law; ngai hpe mung masin hkum pawt et; nang gaw hkawhkam wa zawn rai nga ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Madu e, nang chyawm gaw anhte hpe, ‘Nanhte kawa lu myit ni? Kaga kanau naw lu myit ni?,’ ngu nna san yu nit dai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anhte mung, ‘Kawa dingla lu ga ai; shi dingla wa sayang she shangai wa ai anhte a kanau hpungdim mung naw nga ai. Dai ma a kahpu chyawm gaw si mat sai rai nna shi a kanu hta na shi hkrai sha hkrung nga sai majaw shi a kawa shi hpe nachying wa tsaw ra nga ai,’ ngu nna htan ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Madu e, nang shi hpe mu lu n ga, ndai de shi hpe woi sa wa na mung nang anhte hpe tsun nit dai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anhte chyawm gaw dai ma shi kawa hte n hka lu ai; shi rai nna hka lu ai rai yang chyawm gaw shi a kawa si mat na wu ai ngu nna mung tsun yu saga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang mahtang, “Nanhte a kanau hpungdim wa hpe nanhte hte rau n woi sa ai rai yang, na a man de bai shang lu na myit dai n rai,’ ngu nna tsun nit dai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anhte gaw anhte a kawa hpang de bai nhtang wa yang, nang tsun ai ga hte maren, shi hpe tsun dan saga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hpang shi mung lusha loi mi bai sa mari la na matu nhtang sa shangun mi ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anhte gaw, ‘Anhte n sa lu na saga ai. Anhte a kanau hpungdim wa anhte hte rau n lawm yang, dai wa a man e anhte shang lu na ga ai n rai. Anhte a kanau hpungdim wa sa lawm ai rai yang chyu sha anhte sa lu na saga ai,’ ngu nna htan saga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anhte a kawa gaw anhte hpe, ‘Nye a madu jan Rahkela gaw ngai hpe shadang sha lahkawng sha shangai ya ai gaw nanhte chye nga myit dai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shan hta na langai mi mahtang ngai hpe tawn kau da nga sai. Shi hpe matse labye dusat ni e ashep ashin di gang amya je kau manu ai rai nna shi tawn kau da ai shani kaw nna ngai shi hpe n mu yu mat ni ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya mung ndai langai mi hpe nanhte ngai kaw na woi mat wa nhtawm shi hta nhpru nmai ai lam lama ma byin ai rai yang, ngai dingla ni ai hte maren nanhte ngai hpe yawn hkyen jahkrum nna sat kau na myit dai,’ ngu nna tsun mi ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Yuda gaw matut nna, ya chyawm gaw madu e, “Nye wa hpang de ndai ma n lawm ai sha nhtang wa ai rai yang, ngai hte rau ma dai n lawm wa ai hpe shi hkap mu mada ai hte shi si mat na wu ai. Shi a asak gaw dai ma a asak hta manoi nga ai rai nna, ya shi grai dingla wa sai hte maren, anhte shi hpe yawn hkyen jahkrum nna sat kau na ga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ngai gaw dai ma a matu nye wa hpe nye a asak hte ga sadi jaw da nngai. Dai ma hpe shi hpang de ngai bai n woi wa ai rai yang, nye a asak prat tup mara gun nga sana nngai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ya chyawm gaw madu e, ngai mahtang ma a malai na a mayam tai na matu ndai yang e nga nga na nngai. Shi hpe chyawm gaw shi a kahpu ni hte rau nhtang wa shangun ya e.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai ma ngai hte rau n rai yang, kaning rai wa kaw ngai nhtang wa na rai nga a ta? Nye wa a ntsa hta hkrat wa na ru yak tsin-yam tsindam dai hpe ngai n lu yu na nngai,” ngu nna tsun wu ai.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yosep mung shi a hkam sha ai lam, shi a shangun ma ni a man e n sharang da lu nu ai rai nna, shanhte yawng hpe gawk kaw na pru mat wa na matu hkang dat wu ai. Yosep gaw shi a kahpu kanau ni hpe shi kadai rai nga ai lam tsun dan wu ai shaloi, masha kaga kadai mung shi kaw n nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi ja ja hkrap nga ai hpe Egutu masha ni mung na ma ai. Dai shiga gaw hkawhkam htingnu de hkrang pru wa nga sai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yosep gaw shi a kahpu kanau ni hpe, “Ngai gaw Yosep rai nga nngai; nye a wa naw hkrung nga a ni?,” ngu nna san wu ai. Rai ti mung shi a kahpu ni dai lam hpe na ma ai shaloi ga n lu htan mat ma ai hte grai hkrit gari mat ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hpang Yosep gaw shanhte hpe, “Chyeju hte sit sa wa marit,” ngu nna tsun wu yang, shanhte mung shi a makau de sit sa wa ma ai. Shi gaw, “Ngai gaw nanhte Egutu mung de dut kau hkrum ai nanhte a kanau Yosep rai nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya chyawm gaw ngai hpe ndai mung de dut kau dat myit dai majaw myit hkum ru myit; tinang hkum hpe mung mara hkum shagun nga myit. Ndai gaw masha ni a asak hkye mawai la na matu she, nanhte a shawng e Karai Kasang ngai hpe shangun dat ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ndai mung hta hku hku ai lahkawng ning sha naw rai nga ai; yi hkauna n galau lu na hte mam n dan lu na manga ning naw nga nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanhte hte nanhte a matu mara ni hpe ngam nga shangun na matu mung, ndai zawn re ai mauhpa lam hta na nanhte hpe hkye mawai la na matu mung, Karai Kasang gaw nanhte a shawng e ngai hpe shangun dat ni ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai re ai majaw, ngai hpe ndai de shangun dat ai gaw teng teng nanhte rai myit dai n rai; Karai Kasang mahtang shangun dat ai she rai nga ai. Shi gaw ngai hpe hkawhkam wa a tsaw htum ai arawng aya hte hpring ai mung du shatai ni ai. Ngai mahtang shi a mung ting hpe hpareng ai wa rai nga nngai; Egutu mung ting hpe up hkang ai wa mung ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya alawan, wa hpang de nhtang wa nna, shi a kasha Yosep ning nga nna shi hpe htet ai lam wa tsun masu: ‘Karai Kasang gaw ngai hpe Egutu mung ting hpe up hkang shangun ni ai; dai majaw loi mi mung n kanung nga ai sha ngai hpang de yu wa marit.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai hte ani sha rai nga ai Goshen mung hta nang mung, na a kasha ni hte kashu ni mung, sagu bainam ni mung, dumsu yam nga ni hte nang lu malu mahkra hte shanu nga lu na ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Goshen mung hta nang shanu nga ai rai yang, ngai nang hpe bau maka lu na nngai. Ya hku hku na manga ning naw nga ai rai nna nang mung, na a dinghku hte yam nga hpung ni kawsi kyet na hpe n yu sharawng nngai,’” ngu nna tsun dat wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yosep gaw matut nna, “Ya nanhte yawng hte nang Benyamin mung, ngai nan Yosep rai nga nngai hpe mu lu manit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Egutu mung hta ngai kade daram ahkang aya rawng nga nngai hte nanhte mu mamu mahkra, wa hpe tsun dan mu. Shi hpe tin tin ndai ga de woi yu wa mi,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw kanau Benyamin hpe ahpum nna hkrap wu ai. Benyamin mung shi hpe ahpum let hkrap wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang shi a kahpu ni langai hte langai hpe ahpum pup let naw hkrap nga wu ai. Dai hpang she, shi a kahpu kanau ni shi hte ga shaga hpang wa ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yosep a kahpu kanau ni du sai shiga hkawhkam hkaw de hkrang shang wa ai shaloi, hkawhkam wa hte shi a du salang ni na sharawng nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hkawhkam wa gaw Yosep hpe, “Na a nhpu nnau ni hpe shanhte a yam nga ni hta daw mara nna, Hkanan mung de nhtang wa shangun wu.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte a kawa hte shanhte a dinghku masha ni yawng hpe ndai mung de nhtang sa wa shangun mu. Ngai mung shanhte hpe Egutu mung na kaja htum ai lamu ga jaw na mawe ai; shaloi shanhte hpring kabrat hkra ngamu ngamai wa nna matut shanu nga lu na marin dai lam hpe tsun dan u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte a madu jan ni hte kaji ai ma ni, shanhte hte rau kawa hpe mung htaw la na matu, ndai Egutu mung na leng ni hpe la wa na shanhte hpe tsun u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shanhte gaw shingdu de shanhte a sut rai ni hpe tawn kau da ai a jaw e, shanhte hpa mung myit ru ra na ma ai n rai; Egutu mung ting na kaja htum ai gaw shanhte a matu rai nga manu ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte tsun matsun hte maren, Yaku a shadang sha ni galaw ma ai rai nna, Yosep mung hkawhkam wa hkang dat ai hte maren shanhte hpe leng mung, hkrun lam e sha na malu masha ni hpe mung jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte hpe hpun palawng gahti galai langai hpra jaw dat wu ai; rai ti mung, Benyamin hpe mahtang gumhpraw masum tsa hte hpun palawng man manga naw kahtap jaw wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw shi a kawa hpang de Egutu mung na kaja htum ai arung arai htaw ai daw hte hpawn lawze shi, hkrun lam a matu mam hte muk, kaga lusha htaw ai lawze shi shangun dat ya wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi gaw shi a kahpu kanau ni hpe shangun dat nhtawm shanhte pru wa ai shaloi, shi shanhte hpe, “Hkrun lam hkan e, ndang kalang hkum rai hkat myit,” ngu nna tsun dat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte gaw Egutu mung kaw nna pru wa nhtawm Hkanan mung na shanhte a kawa Yaku shanu nga ai nta de nhtang wa ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hpang shanhte gaw shi hpe, “Yosep naw hkrung nga ai! Shi gaw Egutu mung ting hpe up nga ai!,” ngu nna tsun dan mu ai. Yaku gaw sai kajawng mat nna shanhte hpe n kam da wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Rai ti mung, Yosep shanhte hpe tsun dat ai ga shi hpe tsun dan nna shi hpe Egutu mung de woi yu wa na matu Yosep shangun dat ai leng ni hpe shi mu wu yang, kajawng kahpra ai myit hte bran mat wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shi gaw, “Ngai sha Yosep gaw naw hkrung nga a hka! Ndai lam yawng hpe ngai san sagawn lu ni ai! Ngai garai n si yang, shi hpe sa jahkrum na matu yu sa na we ai,” ngu nna tsun wu ai.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaku gaw shi lu malu mahkra lit bawn nhtawm shi a kawa Isak a Karai Kasang hpe shagu hkungga nawng jau ai Berasheba de yu sa wa wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang mung shana e shingran hta shi hpe, “Yaku, Yaku!,” ngu nna shaga wu ai. Shi mung, “Rai sa, ngai nang e nga nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi mahtang, “Ngai gaw Karai Kasang rai nga nngai, na nwa a Karai Kasang mung rai nga nngai; Egutu mung de yu sa na lam hkum hkrit nga et; dai yang e nang hpe ngai amyu kaba shatai na we ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai mung nang hte rau Egutu mung de yu sa nna, dai kaw na ndai mung de na a amyu matu ni hpe ngai bai woi lung wa na nngai. Yosep mung nang si ai aten du hkra nang hte rau nga nga na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku gaw Berasheba kaw na rawt sa wa wu ai. Shi a shadang sha ni gaw shi hte shanhte a ma kaji hte madu jan ni hpe Egutu hkawhkam e shangun dat ai leng ni hta shajawn dat mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte mung Hkanan mung na shanhte lu ai yam nga ni hte sut gan arung arai ni hpe la nna, Egutu mung de sa mat wa ma ai. Yaku mung shi hte rau shi a amyu matu ni yawng rai nga ai,
  </para>
  <para style="p">
    <verse number="7" style="v" />shadang sha ni, lasha, numsha, hte kashu ni yawng hpe woi mat wa wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ndai gaw Egutu mung de shi hte rau yu sa ai Yaku a dinghku hpung ni hta na shi a kasha alat Rubin hte Rubin a shadang sha ni a lam rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rubin a shadang sha ni gaw Enuk, Hpalu, Hezron hte Hkarmi hte rai ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Simun hte shi a shadang sha ni gaw Yemuela, Yamin, Ohad, Yahkin, Zohara hte Hkanan num hta na Shaula hte rai ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lewi hte shi a shadang sha ni gaw Gershon, Kohat hte Merari hte rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yuda hte shi a shadang sha ni gaw Shela, Hparet, Zera hte rai ma ai. (Yuda a kaga kasha ngu na Era hte Onan chyawm gaw Hkanan mung e si mat masai.) Hparet a shadang sha ni gaw Hezron hte Hamula rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yisahka hte shi a shadang sha ni gaw Htola, Hpua, Yashub hte Shimron ni rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebulun hte shi a shadang sha ni gaw Sered, Elon hte Yalela hte rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ndai ni gaw Mesopotamia mung hta Yaku a matu Lea shangai ya ai shadang sha ni rai nga ai, dai hta jan nna shi a shayi sha Dina mung rai nga ai. Shi a matu mara ni ngu na Lea kaw na ni yawng sumshi masum rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad hte shi a shadang sha ni gaw Zehpu, Hagi, Shuni, Ezbon, Eri, Arodi hte Areli hte rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ashe hte shi a shadang sha ni gaw Imna, Iswa, Iswi, Beria hte shanhte a kajan Sera hte rai ma ai. Beria a shadang sha yan gaw Hebera hte Malhkiela yan rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Laban a shayi sha Lea hpe jaw ai mayam num Zihpa kaw nna pra hkrat wa ai Yaku a matu mara ni gaw shi kru rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yaku a madu jan Rahkela mahtang shi a matu Yosep yan Benyamin hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Egutu mung Heliopoli mare na hkinjawng Hpoti Hpera a shayi sha Asenat hta na Yosep a matu shaprat ai shadang sha ni gaw Manashe hte Ehprim yan rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benyamin a shadang sha ni gaw Bela, Behkera, Ashbela, Gera, Naman, Ehi, Rosha, Muhpim, Hupim hte Arda hte rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ndai ni gaw Yaku hte Rahkela kaw na shaprat ai shadang sha shi mali hte rai ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan a shadang sha gaw Hushim rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naphtali hte shi a shadang sha ni gaw Yazela, Guni, Yezera hte Shilem ni rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Laban a shayi sha Rahkela hpe jaw ai mayam num Bila hta na Yaku a matu shaprat ya ai matu mara sanit hte rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yaku a kanam ni n lawm ai sha, Egutu mung de sa wa ai shi a nshang hkrat ni yawng kru shi kru rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Egutu mung e Yosep shaprat ai shadang sha lahkawng mung lawm ai rai yang, Egutu mung de du ai Yaku a amyu matu ni yawng marai sanit shi rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte du shang wa ai shaloi, Goshen mung e shanhte hpe sa tau la na matu Yosep hpe sa hkrum la na nga, Yaku gaw shi a shawng e Yuda hpe shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shanhte du shang wa ma yang, Yosep gaw shi a gumra leng hta jawn nna kawa hpe sa tau la na nga, Goshen mung de lung mat wa wu ai. Shan shada hkrum ai hte rau Yosep mahtang shi kawa a du hta ahpum noi let na na wa hkrap nga wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Yaku gaw Yosep hpe, “Ya chyawm gaw nang hpe mu ni ai; nang gaw ahkrung nga ndai hpe ngai chye ni ai majaw si na jin jin rai nga nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hpang Yosep gaw shi a kahpu kanau ni hte shi a kawa a dinghku masha ni hpe, “Hkanan mung na nye a kahpu kanau ni hte nye wa a dinghku masha ni yawng ngai kaw du nga sai lam, hkawhkam wa hpe ngai wa shana na nngai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nanhte gaw sagu bainam, yam nga rem sha nna nga ai sagu rem ni rai nga myit dai rai nna nanhte a sagu, bainam hpung ni hpe mung nanhte a yam nga hpung ni hpe mung, nanhte lu malu mahkra hpe mung la sa mara ai, ngu nna hkawhkam wa hpe wa tsun shana na nngai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hkawhkam wa nanhte hpe shaga nna nanhte hpa galaw sha myit ta?, ngu nna san myit yang,
  </para>
  <para style="p">
    <verse number="34" style="v" />nanhte a jiwoi jiwa ni a prat kaw nna nanhte a prat du hkra, yam nga rem sha ai ni rai nga ga ai, ngu nna tsun na rai myit dai. Dai hku tsun yang sha, shi nanhte hpe Goshen mung e shanu shangun na ra ai,” ngu nna tsun wu ai. Egutu masha ni mahtang sagu bainam rem sha ai ni hte hpa mung n seng mayu nga ma ai majaw dai ga Yosep tsun wu ai.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai rai nna Yosep gaw shi a kahpu manga hpe woi nhtawm hkawhkam wa hpang de shang ma ai. Shi gaw, “Nye wa hte nye a kahpu kanau ni shanhte a sagu bainam, yam nga hpung ni hte shanhte madu da sai arung arai yawng hte Hkanan mung kaw na du yu wa ma ai; ya Goshen mung e shanhte nga nga ma ai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai hpang shi a kahpu kanau ni hpe hkawhkam wa hpang de woi sa wa wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hkawhkam wa mung, “Nanhte a magam bungli ni gaw hpa wa mi rai nga myit ni?,” ngu nna shanhte hpe san wu ai. Shanhte gaw, “Madu e, anhte gaw anhte a kaji kawa ni zawn sagu bainam rem sha ai ni rai nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hkanan mung hta mung hkuwa laja wa ai rai nna anhte a sagu bainam ni a matu udat shara n nga mat sai majaw ndai mung hta shanu nga na, anhte du sa ga ai; dai re ai majaw, chyeju hte ndai Goshen mung hta shanu nga lu na ahkang anhte hpe jaw mi law,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hkawhkam wa gaw Yosep hpe, “Ya chyawm gaw na nwa hte nhpu nnau ni du mara ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Egutu mung gaw shanhte a mung rai nga sai majaw, kaja htum ai mungdaw rai nga ai Goshen mung hta shanhte hpe nga shangun u; shanhte hta atsam marai hte hpring ai masha ni nga dam yang mung, nye a yam nga ni hpe rem na hpareng shanhte hpe galaw shangun u,” ngu nna tsun matsun dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang Yosep gaw shi a kawa Yaku hpe woi la nna hkawhkam wa hpang de woi shawn da wu ai. Yaku mung hkawhkam wa hpe shaman ya wu ai;
  </para>
  <para style="p">
    <verse number="8" style="v" />hkawhkam wa gaw shi hpe, “Nang asak kade ning rai sani?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yaku gaw, “Bu htawt hkawm ai nye a prat gaw latsa e sumshi ning tup na mat sali ai; dai shaning ni gaw nye a kaji kawa ni a shaning galu bu hkawm ai zawn n re ai sha, kadun ai hte yak la nga li ai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaku gaw hkawhkam wa hpe shaman ga tsun nna pru mat wa wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang Yosep mung hkawhkam wa shi hpe hkang da nu ai hte maren, shi a kawa hte kahpu kanau ni hpe Egutu mung na kaja htum ai shara ngu ai Ramese mare hte ni htep ai shara shanhte hpe jaw nna nga shangun mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yosep gaw shi a kawa hpe mung, shi a kahpu kanau ni hpe mung, naw ngam nga ai shi a kawa a dinghku masha mahkra hte kaji htum ai wa a matu du hkra lusha garan jaw wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shara shagu hkan lusha htum mat hkra hku hku ai gaw nachying laja nga ai rai nna, Egutu hte Hkanan mung masha ni mung kawsi hpang gara ai hte n-gun kya mat ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte nai mam ni mari yang, dai jahpu gumhpraw ni yawng hpe Yosep shinggyin la nna hkawhkam htingnu de la sa ya wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Egutu hte Hkanan mung hta gumhpraw jai shama kau jang, Egutu mung masha ni Yosep kaw sa nna, “Anhte hpe lusha jaw mi! Anhte hpe hkum si shangun mi! Lama ma sha pyi galaw ya mi! Anhte a gumhpraw yawng mung ma mat saga ai,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yosep gaw, “Nanhte a gumhpraw ma mat malit yang gaw nanhte a yam nga ni hpe dun sa wa mi; dai yam nga jahpu a malai nanhte hpe ngai lusha jaw made ga,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna shanhte mung Yosep hpang de shanhte a yam nga ni hpe la sa nhtawm, dai gumra, sagu, bainam, dumsu hte lawze ni a matu shi shanhte hpe lusha jaw wu ai. Dai shaning hta shanhte a yam nga yawng a matu lusha hte galai nna shi bau maka lu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpang shaning hta mung shanhte shi kaw sa nna, “Madu e, anhte a gumhpraw yawng ma mat saga ai; dai lam nang kaw na anhte makoi gyem lu na ga ai n rai. Anhte a yam nga ni hpe mung nang madu la nit dai; anhte a hkum hte lamu ga hta jan nna nang hpe jaw na hpa mung n ngam sai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anhte hpe hkum si shangun mi! Lama mi sha gaw lajang ya mi! Anhte a sun hkauna ni hpe hkum jahkam da shangun mi. Lusha hte galai na matu anhte a hkum hte lamu ga ni hpe mari la mu. Anhte mahtang hkawhkam a mayam ni tai nna shi mung anhte a lamu ga ni hpe madu la lu na ra ai. Anhte ahkrung nga lu na matu, anhte hpe nai mam jaw mi, anhte a sun hkauna ni hta gat na nli mung jaw mi,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yosep mahtang Egutu mung na lamu ga mahkra hpe hkawhkam wa a matu mari la kau wu ai. Hkuwa nachying laja nga ai majaw, Egutu masha ni tinang nang a lamu ga ni hpe shanawng dut kau ra ma ai rai nna, dai gaw hkawhkam wa a lamu ga hkrai tai mat malu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yosep gaw amyu masha ni hpe Egutu mung a jahtum maga mi de na ni hpe kaga maga mi de du hkra mayam amu ni hpe galaw shangun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hkinjawng ni madu ai lamu ga hpe chyu sha, shi n mari wu ai. Dai gaw shanhte nga na matu hkawhkam wa ahkang jaw da wu ai majaw shanhte a lamu ga ni hpe n dut ra ma ai; hpa majaw nga yang, hkawhkam wa shanhte hpe karum gumhpraw jaw da nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yosep gaw mung masha ni hpe, “Yu mu, hkawhkam wa a matu nanhte hte nanhte a lamu ga ni hpe ya ngai mari la ni ai. Ndai gaw nanhte a sun hkauna ni hta gat hkai na nanhte a matu nli tum ni rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nsi naisi shu la ai aten hta htam manga kaw na htam mi gaw hkawhkam wa hpe nanhte sak jaw lu na rai myit dai. Ngam ai hpe chyawm gaw hpang e gat na nli a matu mung, nanhte hte nanhte a dinghku masha ni a matu mung, lusha rai nga myit ga, nanhte lang lu na myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte mung, “Anhte a asak hpe nang hkye la ya nit dai. Madu e, nang gaw anhte hpe mung matsan yu dum la nit dai. Dai rai nna hkawhkam wa a mayam anhte tai na saga ai,” ngu nna htan ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai re ai majaw, nsi naisi shu la ai htam manga na htam mi hpe hkawhkam wa madu la u ga, nga nna Yosep gaw Egutu mung a matu tara htuk shapraw da wu ai. Dai tara gaw dai ni du hkra n hten n run ai sha naw grin nga ai. Hkinjawng ni a lamu ga chyu sha hkawhkam wa madu ai lamu ga n tai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israela amyu masha ni gaw Egutu mung Goshen mung hta shanu nga nna lu su ngamu ngamai wa ma ai hte shanhte hta kashu kasha law law mayat maya wa ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yaku gaw Egutu mung e shi sanit ning sa shanu nga ai hte shi a asak latsa e mali shi sanit ning du hkra hkrung nga lu wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yaku gaw si wa na nhtoi ni wa jang, shi a kasha Yosep hpe shaga la nhtawm shi hpe, “Na a lata nye a magyi lapran hta shawn bang nna ngai hpe Egutu mung e n lup makoi da na matu dagam shaka u.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nye a kaji kawa ni hpe makoi ai shara hta lup makoi na hpe ngai ra sharawng nngai; dai re ai majaw, Egutu mung kaw nna ngai hpe hpai lung wa nhtawm shanhte hpe lup ai shara hta ngai hpe lup makoi da mi,” ngu nna htet da wu ai. Yosep mung, “Nang htet ai hte maren, ngai galaw na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yaku gaw, “Nang galaw na rai yang dagam u,” ngu nna tsun wu yang, Yosep mung dagam shaka wu ai rai nna Yaku gaw shi a yup ku ntsa e chyeju shakawn wu ai.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang kade n na yang, shi a kawa machyi nga ai hpe Yosep na wu ai. Dai rai nna shi a kasha Manashe hte Ehprim yan hpe woi let Yaku hte wa hkrum na matu sa mat wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yaku gaw shi a kasha Yosep shi hpe sa hkrum ai lam hpe na wu yang, n-gun da ting la nna yup ku hta rawt dung wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yaku gaw Yosep hpe, “Chyahtum Chyalai N-gun Rawng Ai Karai Kasang gaw Hkanan mung Luza mare e ngai kaw dan pru nna shaman ya ni ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw ngai hpe, “Kashu kasha law law jaw na we ai; shing rai na a amyu matu ni amyu baw law law tai wa na mara ai; na a amyu matu ni htani htana madu nga lu na matu ndai mungdan hpe ngai jaw na de ai,’” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku mahtang matut nna, “Yosep e, Egutu mung ndai yang e, ngai garai n du yang na a matu shangai wa sai shadang sha lahkawng hpe ngai madu nga nngai; Ehprim yan Manashe gaw grau nna nye a kasha Rubin yan Simun zawn rai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang hta shadang sha ni naw nga ai rai yang, shanhte a matu n myit ya ra na sai. Dai ni gaw Ehprim hte Manashe yan hkam la lu ai sali wunli a jaw e sha lu na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ndai lam hpe na nnu Rahkela a majaw ngai galaw nga nngai. Mesopotamia mung kaw nna ngai bai nhtang wa ai shaloi, Ehprat mare hte nau n tsan ai Hkanan mung hta shi si mat nna ngai hpe yawn hkyen kaba jahkrum nu ai. Dai rai nna Ehprat de sa wa ai lam makau e shi hpe ngai lup makoi se ai,” ngu nna tsun wu ai. (Ehprat hpe ya aten e Betlehem ngu ai re.)
  </para>
  <para style="p">
    <verse number="8" style="v" />Yaku gaw Yosep a shadang sha yan hpe mu wu ai shaloi, “Ndai ma yan gaw kadai dai rai nga ma ta?,” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yosep chyawm gaw, “Ndai yan gaw Egutu mung e Karai Kasang ngai hpe jaw ai shadang sha yan rai nga ma ai,” ngu nna htan wu ai. Yaku mung, “Shan hpe ngai hpang de sit wa shangun u; shan hpe ngai shaman ya na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaku gaw asak kaba nu ai majaw myi amam nna, atsawm sha n mu lu wu ai. Yosep mahtang ma yan hpe shi hpang de woi sa ya ai majaw shi shan hpe ahpum let pup wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yaku gaw Yosep hpe, “Nang hpe bai mu lu na matu ngai galoi mung n myit ni ai; ya chyawm gaw na a kasha yan hpe pyi Karai Kasang ngai hpe mu shangun ni ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hpang, Yosep gaw shan hpe Yaku a lahpyen kaw na shaw la nhtawm shi a man e ga du hkra gum dagup shangun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yosep gaw Yaku a pai maga de Ehprim, Manashe hpe hkra maga de tawn da ya wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai ti mung, Yaku mahtang shi a lata hpe kashai kau nna shi a hkra lata hpe asak kaji ai Ehprim a baw ntsa e mara tawn wu ai; shi a pai lata hpe chyawm gaw grau kaba ai Manashe a baw ntsa e mara ya wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang shi gaw Yosep hpe shaman ya wu ai: “Nye a kaji kawa ni rai nga ai Abraham hte Isak daw jau ai Karai Kasang gaw ndai ma yan hpe shaman ya u ga law! Ngai hpe lam woi nga ai Karai Kasang gaw ndai yan hpe dai ni jang shaman ya u ga law!
  </para>
  <para style="p">
    <verse number="16" style="v" />Machyi shoichyum ai yawng hta na ngai hpe hkye mawai la sai lamu kasa gaw shan hpe shaman ya u ga law! Nye a mying hte mung, nye a kaji Abraham hte nye wa Isak yan a amying hte mung, ndai ma yan matut nna hkrung nga mu ga law! Shan hta kashu kasha law law mayat maya wa nna amyu matu law law gumja gumhpra rai wa manu ga law!”
  </para>
  <para style="p">
    <verse number="17" style="v" />Kawa mahtang Ehprim a baw ntsa e shi a hkra lata mara tawn ai hpe Yosep mu nna myit n pyaw wu ai; kawa a lata hpe Ehprim a baw kaw na Manashe a baw de htawt mara ya na matu pawn ya wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi gaw kawa hpe, “Wa e, dai hku n rai nga ai; ndai ma mahtang shadang sha alat rai nga ai; na a hkra lata shi a baw ntsa e mara ya u,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi a kawa chyawm gaw n hkraw ai hte, “Ngai chye nngai, ngai sha e, ngai chye nngai; Manashe amyu matu ni mung galu kaba ai amyu ni tai na mara ai. Rai ti mung, shi a kanau wa mahtang shi hta grau kaba na ra ai rai nna shi a amyu matu ni amyu baw law law tai wa na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna shi shan hpe dai shani jang shaman ya nhtawm, “Israela amyu masha ni shaman ga tsun ai shaloi, shanhte gaw nan a mying hpe gang na mara ai. Shanhte gaw, ‘Karai Kasang gaw Ehprim yan Manashe hpe zawn shatai nga u ga,’” ngu nna tsun na mara ai. Ndai lam hku nna Yaku gaw Manashe a shawng e Ehprim hpe tawn da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang Yaku gaw Yosep hpe, “Nang mu ai hte maren ngai gaw si wa na chyu sha rai ni ai, rai ti mung Karai Kasang gaw nanhte hte rau nga nga nna nanhte a kaji kawa ni nga ai mung de bai woi wa na ra ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nye a nhtu, ndan hte Amori masha ni kaw na lu la ai dai namhpun kaja ai Shehkem hpe ngai jaw na nngai; dai gaw na nhpu nnau ni a matu n rai; na a matu san san rai nga ai,” ngu nna tsun wu ai.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaku gaw shi a shadang sha ni hpe shaga la nna, “Nang e grup rai wa hpawng yu mu; du na ra ai aten nanhte hta hpa byin wa na lam, ngai nanhte hpe tsun dan made ga:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Yaku a shadang sha ni e, rau wa hpawng nna madat la mu. Nanhte a kawa Israela a ga hpe madat la mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Nye a kasha alat Rubin e, nang gaw nye a n-gun hte Nye a ram prat na ma ningshawng rai nna, Nye a shadang sha ni yawng hta arawng kaba htum ai hte n-gun ja htum ai wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang gaw mawru hka zawn kabrawng nga ndai, Rai ti mung nang gaw ahkyak htum ai wa n rai nga ndai, Nang gaw nye a lashi num hte yup nit dai majaw, Na nwa a yup ku hpe sari jahpoi kau ya nga ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Simun yan Lewi shan nau rai ma ai. Shan gaw kashun kashe du daw sai hkaw amu shabyin ai laknak ni lang ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw shan a mayun bawng ban ai hta shang lawm na n rai, Shan a zuphpawng ni hta shang lawm na n rai, Shan gaw masin kahtet ai a majaw masha sat manu ai. Ginsup chyai na matu dumsu usu lahkap dan masai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shan a sindawng kahtet ai gaw grai laja nga ai majaw dagam dala hkrum nga ma ai, Shan a masin kahtet ai majaw dai gaw grai mazut nga ai. Ngai gaw shan hpe Israela mungdan ting de shabra kau na mawe ai; Ngai gaw shan hpe amyu masha ni hta na shabra kau na mawe ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Yuda e, na a kahpu kanau ni nang hpe shakawn na mara ai. Na a gumlau hpyen ni a du hpe nang manat nga ndai. Na a nhpu nnau ni na a man e gum dagup na mara ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yuda gaw nam shan hpe kawa sat nna shi a lungpu de nhtang wa nhtawm Galeng gumkan nga ai hkanghkyi hte bung nga ai. Kadai mung shi hpe shatu gwi na n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yuda gaw hkawhkam sumdoi lang lu na ra ai, Shi a amyu matu ni tut nawng a up nga na mara ai. Amyu baw ni shi hpe shagrau kumhpa jaw ai hte Shi a man e madat mara let gum dagup na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi a lawze uram hpe kaja htum ai sabyi ru ni hte sabyi hpun ni hta dun da let, Sai zawn hkyeng ai sabyi ntsin hta Shi a hpun palawng ni hkrut wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi a myi gaw lu ai sabyi ntsin hte hkyeng nga ai; Shi a awa mung lu ai ngachyu hte hpraw nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Zebulun gaw panglai makau e nga na ra ai. Shi a hka kau gaw sanghpaw li ni a matu daru tai na ra ai. Shi a lamu ga jarit mung Sidon du hkra maden na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Yisahka gaw lit mara ai daw hking ni a lapran hta Lit li nna n lu rawt tsap ai lawze hta pyi grau kaja nga ai n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung sa ra shara kaja nga ai rai nna Lamu ga mung yu sharawng hpa rai nga ai hpe shi mu mada wu ai. Dai rai nna lit gun na matu shi a shingma hpe shi gum ya nna; Mayam langai mi zawn bungli galaw shadut hkrum nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Dan gaw shi a amyu masha ni hpe up hkang ai wa tai nna, Shanhte mung kaga Israela amyu bawsang ni zawn tai na mara ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan gaw nmaw lam makau e hpum nga ai lapu, Lam masun makau na atuk rawng ai lapu zawn tai nna Gumra lahtin achye na ra ai; Gumra jawn ai wa gaw hpang de kadawng mat nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />“ Madu e, ngai gaw na a hkye hkrang la ai lam hpe ala nga nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Gad gaw damya hpung mi htim gasat ai hkrum na ra ai; Rai ti mung shi shanhte hpe kayin htim nna shachyut kau na ra ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Ashe a lamu ga gaw dwi sau mu mai ai lusha hpe shapraw ya nna; Hkawhkam wa a matu lusha shi jaw na ra ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Naphtali gaw dat da ai shan nga rai nna Yu tsawm ai shan nga kasha ni hpe shangai ya nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Yosep gaw hka hpawk makau e nga ai lawze shazai hte Kawng nhkrem hkan hkawm nga ai gumra kasha shazai hte bung nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi a gumlau hpyen ni grai gumshem ai hku shi hpe htim gasat nhtawm, Shanhte a ndan pala ni hte shi hpe hkan shachyut ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rai ti mung Chyahtum Chyalai N-gun rawng ai Yaku a Karai Kasang a daru magam n-gun hte, Sagu rem wa ngu ai Israela hpe makawp maga ai wa a majaw mung, Shi a ndan dingyang kaja nna, Shi a lahpum ni mung n-gun hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai gaw nang hpe karum ai na nwa a Karai Kasang rai nna, Sumsing lamu na shaman ai chyeju marang hte mung, Ga kata na sung ai hka a majaw mung, Yam nga hte kashu kasha law law mayat maya shangun ai shaman chyeju ni a majaw mung,
  </para>
  <para style="p">
    <verse number="26" style="v" />Nsi naisi hte nampu nampan ni hpe jaw ya ai shaman chyeju ni a majaw mung, Moi moi na bum ni hpe shagrin da ai shaman chyeju ni a majaw mung, Htani htana agrin nga ai kawng ni kaw na ra sharawng ai arung arai ni hpe hkam la shangun ai shaman chyeju ni a majaw mung, Chyahtum Chyalai N-gun Rawng Ai Karai Kasang gaw nang hpe shaman ya u ga law. Dai shaman chyeju ni gaw Yosep a baw ntsa e mung, Shi a kahpu kanau ni hte hka mat wa ai wa a kahtan ntsa e mung anga nga u ga law.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Benyamin gaw matse ai chyahkyawn langai hte bung nga ai. Shi gaw jahpawt shana ashan amya sat nna mayu sha nga ai.”
  </para>
  <para style="p">
    <verse number="28" style="v" />Ndai hte gaw Israela amyu bawsang shi lahkawng rai nga ma ai; ga ndai gaw shadang sha shagu lu la ang ai hte maren shanhte a kawa tsun da ai shaman ga rai nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai hpang Yaku gaw shi a shadang sha ni hpe, “Ya chyawm gaw ngai si wa na ni ai rai nna, nye a amyu masha ni hpawng nga ai de wa na ni ai. Hkanan mung Mamre a sinpraw maga na Makhpela pa hta nga ai dai Heti masha Ehpron a sun na ginlawng hku hta nye a kawa ni hte rau ngai hpe lup makoi da mi. Dai ginlawng hku hpe Abraham gaw lup wa shatai na matu Ehpron a sun hpe mari da nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai shara hta Abraham hte shi a madu jan Sara hpe shanhte lup makoi da manu ai; dai shara hta Isak hte shi a madu jan Rebeka hpe lup makoi da manu ai; dai hta e Lea hpe mung ngai lup makoi da se ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai sun hte dai hta nga ai ginlawng hku hpe Heti masha ni kaw na mari da ai rai nga ai. Dai yang e, ngai hpe lup makoi da mi,” ngu nna htet da wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yaku gaw shi a shadang sha ni hpe numhtet ga tsun matsun ngut jang, shi bai galeng dat ai hte nsa hti mat salu ai. Shi a amyu hpawng nga ai de du mat wa nga ai.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yosep gaw shi a kawa hpe ahpum nna hkrap let shi a myi man hpe pup wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai hpang Yosep gaw shi a kawa a hkum tsawp n yat manam mat hkra tsi lajang da na matu hkang da wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shawoi na zawn tsi lajang da na matu nhtoi mali shi ya aten la ra nga ai. Egutu masha ni mung shi a majaw sanit shi ya tup sharung shayawt nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai sharung shayawt ai nhtoi lai jang, Yosep gaw hkawhkam wa a du salang ni hpe shaga la nna, “Chyeju hte ndai shiga hkawhkam wa hpang de shana ya mi:
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Nye wa si wa mahka e Hkanan mung hta shi lajang da sai lup hta shi hpe lup makoi na matu, ngai hpe ga sadi hte dagam da shangun ni ai. Dai re ai majaw chyeju hte nye wa hpe lup makoi na matu ngai hpe wa shangun mi. Dai hpang ngai bai wa na nngai da,’” ngu nna tsun ya mi ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkawhkam wa gaw, “Nang galaw na ngu ga sadi jaw da nit dai hte maren na nwa hpe wa lup makoi su,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai rai nna Yosep gaw shi a kawa hpe lup makoi na matu lung wa wu ai. Hkawhkam wa a du salang ni yawng mung shi a hkaw na arawng aya kaba lu ai masha ni hte Egutu mung na ningbaw ni yawng mung Yosep hte rau hkan lung wa ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a dinghku, shi a kahpu kanau ni hte shi kawa a dinghku na ngam nga ai ni yawng mung shi hte rau lung wa ma ai. Shanhte a ma kaji ni, sagu, bainam, dumsu hpung ni hpe sha Goshen ginwang kaw tawn da ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gumra leng ni hta hkan ai masha ni hte gumra jawn ai ni mung shi hte rau lung wa ma ai rai nna, dai gaw grai law ai wunawng wuwa rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yawdan hka a sinpraw hkran na Atad a chyarang pa e shanhte du shang wa ma yang, shanhte gaw aten galu wa mi ja ja sharung shayawt nga ma ai. Yosep mung yawn hkyen poi hpe sanit ya tup galaw wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Atad a chyarang pa e dai masha ni hkrap ngu hkrap ngoi nga ma ai hpe Hkanan masha ni mu ma ai shaloi shanhte gaw, “Egutu masha ni a sharung shayawt ai poi gaw ja ja kaba nga malu hka!,” ngu nna tsun ma ai. Dai rai nna shara dai hpe Abela Mizraim ngu nna shamying ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yaku a shadang sha ni mung shi hkang da nu ai hte maren galaw ya mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte gaw shi a hkum tsawp hpe Hkanan mung de hpai wa nhtawm lup wa shatai na nga Heti masha Ehpron kaw na Abraham mari la ai dai Mamre a sinpraw maga de nga ai Makhpela sun na ginlawng hku hta lup makoi bang da ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yosep gaw shi a kawa hpe lup makoi da ngut jang, shi hte shi a kahpu kanau ni mung, makoi mayang poi hta shi hte rau hkan lawm nang ai ni yawng mung, Egutu mung de bai nhtang yu wa ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte a kawa si mat ai hpang Yosep a kahpu kanau ni gaw, “Yosep gaw anhte hpe n ju n dawng ai myit naw rawng nna anhte shi hpe machyi shoichyum jahkrum ai lam a majaw anhte hpe bai tai na mi she yaw shada yang gara hku rai na ta?,” ngu nna san hkat ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna shanhte gaw Yosep hpang de shiga shana dat ma ai: “Anhte a kawa garai n si yang,
  </para>
  <para style="p">
    <verse number="17" style="v" />shi anhte hpe, ‘Shanhte nang hpe shut kau mu ai shaloi, na nhpu nnau ni a shut kau ai n hkru ai amu hpe chyeju hte mara dat ya u,’ ngu nna nang hpe hpyi nem na matu tsun da mi ai. Dai rai nna na nwa a Karai Kasang a shangun ma anhte a galaw shut kau sai mara hpe chyeju hte mara dat ya mi law.” Yosep gaw dai shiga hpe lu la ai shaloi hkrap wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpang shi a kahpu kanau ni nan shi a man de sa nna dingnyawm gum dagup let, “Anhte gaw na a mayam ni zawn na a man e nga nga ga ai,” ngu nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai ti mung, Yosep gaw shanhte hpe, “Hkum hkrit myit; ngai gaw nye a hkum hpe Karai Kasang a shara hta n tawn da lu nngai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nanhte ngai hpe n hkru ai hku gaw maw manit dai; rai ti mung byin lai wa sai lam ni a majaw dai ni du hkra masha law law a asak hpe jahkrung ya na matu Karai Kasang dai hpe mai kaja ai lam hku galaw nu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nanhte hkrit tsang shara hpa mung n nga ra na myit dai. Nanhte hte nanhte a ma kaji ni hpe ngai lanu lahku nga na made ai,” ngu nna tsun wu ai. Shanhte hpe kam wa hkra tsun ai gaw shanhte hpe hkra shangun nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yosep gaw kawa a dinghku masha ni hte rau Egutu mung e matut shanu nga ma ai. Shi si ai aten hta shi a asak latsa e shi ning rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw Ehprim a kasha ni hte kashu du hkra mu kau da nu ai. Manashe a shadang sha Mahkira a kasha ni hpe mung shi pawn da lu nu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi gaw shi a kahpu kanau ni hpe, “Ngai si wa na ni ai; rai ti mung Karai Kasang gaw nanhte hpe teng teng lanu lahku nhtawm ndai mung kaw nna woi pru wa let, Abraham, Isak hte Yaku ni hpe dagam let ga sadi jaw da ai mung de nanhte hpe woi wa na marin dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hpang Yosep gaw shi a amyu masha ni hpe dagam shaka na matu lajin wu ai. Shi gaw, “Ngai hpe ga sadi jaw mi, Karai Kasang nanhte hpe dai mung de woi wa ai shaloi nye a hkum tsawp hpe nanhte hte rau la lung wa na rai myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai rai nna Yosep gaw asak latsa e shi ning hta Egutu mung e si mat wa nu ai. Shanhte gaw shi a hkum tsawp hpe lajang nhtawm da-u hta bang da ma ai.
  </para>
</usx>
