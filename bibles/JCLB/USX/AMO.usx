<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="AMO" style="id">Amo</book>
  <para style="h">Amo</para>
  <para style="toc1">Amo</para>
  <para style="toc2">Amo</para>
  <para style="mt">Amo</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ndai gaw Yuda mungdan a Hkawhkam Uzia hte Israela Hkawhkam Yosha a kasha Yeroboam a lakhtak e, nnang nawn garai n nawn ai lahkawng ning a shawng e, Tekoa mare na sagu rem wa Amo hpe Israela hte seng nna Karai Kasang kaw na lu la ai mungga ni rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amo gaw, “Dai Madu gaw Ziun Bum kaw na shabam nga ai; shi a nsen hpe Yerusalem kaw na sharawt dat nga ai. Udat shara ni hkun hkraw mat nna Hkarmela Bum ntsa na tsing nyui mat nga ai,” nga nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Madu gaw, “Damasku masha ni lang hte lang yubak galaw shut nga masai; dai lam a majaw ngai shanhte hpe ari teng teng jaw na nngai. Shanhte gaw Gilead masha ni hpe matse gumshem ai myit hte di kau ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna, ngai gaw Hkawhkam Hazaela gap da ai hkawhkam htingnu de wan jahkrat dat nna Hkawhkam Benhadad a hpyen dap ni hpe jahkru kau na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai gaw Damasku mare chyinghka htinggrang ni hpe agrawp daw kau nna, Awen kadit e nga ai ni hte Behteden hpe up hkang ai wa hpe yeng seng kau na nngai. Suri masha ni gaw Kira mung de bawng masha ni zawn woi mat wa hkrum na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu gaw, “Gaza masha ni gaw lang hte lang yubak galaw shut kau nga masai, dai lam a majaw ngai shanhte hpe teng teng ari jaw na nngai. Shanhte gaw amyu ting hpe rim la nna Edom masha ni a lata de mayam hku dut kau dat ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai rai nna, ngai gaw Gaza mare bunghku a ntsa e wan jahkrat dat nna dai mare a hpyen dap ni hpe jahkru kau na we ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai gaw Ashdod hte Ashkelon mare ni a mungdu ni hpe tsep kawp la kau na nngai. Ngai gaw Ekron mare hpe ari jaw ai hte ngam nga ai Hpilisti masha ni yawng si mat na mara ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai Madu gaw, “Turu masha ni lang hte lang yubak galaw shut kau nga masai, dai lam a majaw, ngai shanhte hpe teng teng ari jaw na we ai. Shanhte gaw amyu baw ting hpe woi mat wa nna Edom mung hta bawng dung shangun ma ai, shanhte galaw da sai manang ga shaka hpe mung n shatup ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai rai nna, ngai gaw Turu mare bunghku ntsa e wan jahkrat dat nna dai mare a hpyen dap ni hpe jahkru kau na we ai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu gaw, “Edom masha ni lang hte lang yubak galaw shut nga masai, dai lam a majaw ngai shanhte hpe teng teng ari jaw na we ai. Shanhte gaw shanhte a kahpu kanau ni rai nga ai Israela amyu masha ni hpe matsan dum ai lam n nga ai sha nhtu lang let hkan shachyut ma ai. Shanhte a masin kahtet ai gaw shadaw shadang n nga nga ma ai; shanhte a masin kahtet ai hpe galoi mung n lu shakawp nga masai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna, ngai gaw Teman mare a ntsa e wan jahkrat dat nna Bozra a hpyen dap ni hpe jahkru kau na we ai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw, “Amon masha ni lang hte lang yubak galaw shut kau nga masai, dai lam a majaw ngai shanhte hpe teng teng ari jaw na we ai. Shanhte gaw lamu ga maden jat la lu na matu majan gasat ai shaloi Gilead mung na na-um nasin re ai num ni hpe pyi kan ga kau ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai rai nna, ngai gaw Raba a mare bunghku ni a ntsa de wan jahkrat dat nhtawm de a hpyen dap ni hpe jahkru kau na we ai. Dai hpang dai yang e hpyen majan shani jahtau garu ai lam nga nna dai gasat gala ai gaw nbung laru zawn n-yun bu na ra ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte a hkawhkam hte shi a du salang ni bawng dung hkrum mat wa na mara ai,” ngu nna tsun ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Madu gaw, “Moba masha ni lang hte lang yubak galaw shut kau nga masai, dai lam a majaw ngai shanhte hpe teng teng ari jaw na we ai. Shanhte gaw Edom hkawhkam wa a nrut nra ni hpe wan wu tai mat hkra ju kau let n gawn n sawn di ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai gaw Moba mung a ntsa e wan jahkrat dat nhtawm Keriot a hpyen dap ni hpe jahkru kau na we ai. Moba masha ni gaw hpyenla ni marawn jahtau nna pahtau dum nga ai hte yang majan a wu gadu ai nsen hta si mat na mara ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai gaw Moba mungdu wa hte dai mung na ningbaw ni yawng hpe sat kau na nngai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw, “Yuda amyu masha ni gaw lang hte lang yubak galaw shut kau manu ai, dai lam a majaw, ngai shanhte hpe teng teng ari jaw na nngai. Shanhte gaw nye a sharin shaga ai ga matsun ni hpe n kaw n law di ma ai, nye a hkang da ai ga ni hta n hkan sa ma ai. Shanhte gaw shanhte a kaji kawa ni hkan nang yu sai akyu n rawng ai hpara sumla ni hta nan lam yit nga masai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai rai nna, ngai gaw Yuda a ntsa e wan jahkrat dat nhtawm Yerusalem a hpyen dap ni hpe jahkru kau na we ai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu gaw, “Israela amyu masha ni lang hte lang yubak galaw shut kau manu ai, dai lam a majaw ngai shanhte hpe teng teng ari jaw na we ai. Shanhte gaw hka n lu wa ai ding man ai masha ni hte kyepdin man mi a manu hpe pyi n lu nhtang ya ai matsan mayan re ai masha ni hpe mayam hku dut kau ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw n-gun kya nga ai ni hte karum la na masha n lu ai ni hpe kabye anut ma ai; matsan mayan masha ni hpe lam shadam kau nga ma ai. Kawa hte kasha gaw mayam mahkawn langai sha hte jawm kanawn let nye a chyoi pra ai amying nsang hpe awu asin di ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw matsan mayan ni a hka a matu shadun da ai nba hpe Karai Kasang hpe nawku ai shara shagu hkan nep da nna yup ma ai. Shanhte gaw shanhte a Karai Kasang a Nawku Htingnu hta shanhte shawa la lu ai gumhpraw hte sabyi ntsin mari lu nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ti mung, nye a amyu masha ni e, arit hpun daram tsaw nna wamyi hpun zawn n-gun ja ai Amori la wa-ngan ni hpe na a majaw ngai tsep kawp jahten shaza kau ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai gaw nanhte Amori masha ni a lamu ga hpe madu la lu hkra nanhte hpe Egutu mung kaw na woi shapraw wa nhtawm nam mali kata e mali shi ning tup ngai woi lakawn wa ni ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte a kasha nkau mi kaw na myihtoi ni, nanhte a shabrang ni hta na nkau mi hpe Nazari masha ni hku ngai lata da ni ai. Israela amyu masha ni e, ndai lam teng nga ai, n rai ni? Dai Madu ngai nan tsun ni ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai ti mung, nanhte gaw Nazari masha ni hpe sabyi lu shangun nna myihtoi ni hpe nye a mungga n tsun na matu hkang da manit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya chyawm gaw, ngai gaw nanhte hpe ga de agrawp kau na we ai; nanhte gaw mam nsi lit htaw ai leng zawn madai na rai myit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kagat chyang ai ni pyi hprawng lawt lu na n rai; n-gun ja ai masha ni shanhte a n-gun htum mat na mara ai; hpyenla ni mung tinang asak hkrang shaw la lu na ma ai n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ndan lang ai wa mung tsap lu na n rai, kagat chyang ai wa mung hprawng lawt lu na n rai; gumra jawn ai ni mung shanhte a asak a matu lawt lu na ma ai n rai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai shani e, share shagan ai hpyenla ni pyi shanhte a laknak ni hpe jahkrat da nna hprawng kagat mat wa na mara ai.” Dai Madu nan tsun nu ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela amyu masha ni e, nanhte hte seng nna dai Madu tsun nu ai ndai mungga hpe mung, shi gaw amyu baw ting hpe Egutu mung kaw nna woi wa sai lam hpe mung madat mu:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ginding aga ntsa na masha amyu baw yawng hte e, nanhte gaw ngai chye nna lanu lahku la yu sai ni chyu sha rai nga myit dai. Dai gaw nanhte a yubak mara hpe grai hkrit tsang shangun nga ai, dai re ai majaw, ngai gaw de a matu nanhte hpe ari jaw na nngai.”
  </para>
  <para style="p">
    <verse number="3" style="v" />Hkrum hkat na matu lajang da ai lam n nga yang, marai lahkawng rau hkawm hpang lu na rai nga a ni?
  </para>
  <para style="p">
    <verse number="4" style="v" />Hkanghkyi gaw nam maling kata e htim na shan shi n mu yang shabam ga a ni? Hkanghkyi uram gaw shahpa n lu rim yang, shi a nhkun kata e nying ga a ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Mahkam hta u shat n tawn da ai rai yang, u lu ga a ni? Hkam da ai mahkam hta hpa n lu yang mahkam htim ga a ni?
  </para>
  <para style="p">
    <verse number="6" style="v" />Mare kata hta majan pahtau dum ai nsen na yang, mare masha ni n hkrit na ma ni? Dai Madu gaw tsin-yam tsindam n dat dat yang, dai mare hta byin lu na rai nga a ni?
  </para>
  <para style="p">
    <verse number="7" style="v" />Tsaw Htum ai dai Madu gaw shi myit mang ai lam, shi a shangun ma myihtoi ni hpe garai n shadan yang, hpa lam hpe mung shi galoi mung n galaw yu nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hkanghkyi shabam ai shaloi, n hkrit ai wa kadai nga lu a ta? Tsaw Htum ai dai Madu shaga yang, myihtoi n htoi na kadai wa rai nga a ta?
  </para>
  <para style="p">
    <verse number="9" style="v" />Egutu hte Ashdod na hkawhkam htingnu ni hta nga ai ni hpe ning ngu tsun ndau mu: “Samari makau grup yin na kawng ni hta hpawng shinggyin ai hte dai shara na kaba ai kabring kabrawng amu hte shut hpyit kau ai ru hka amu ni hpe yu yu mu.”
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai Madu gaw, “Ndai masha ni gaw shanhte a nga shara ni hta ru hka amu hte kashun kashe du daw sai hkaw amu ni hte jahpring da nga ma ai. Shanhte pyi gara hku ding man na lam hpe n chye nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna, gumlau hpyen wa gaw shanhte a mungdan hpe wang shinggrup da nhtawm shanhte a hpyen dap ni hpe jahten kau ai hte shanhte a nga shara ni hpe hpya kau ya na ra ai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai Madu gaw, “Sagu rem wa gaw hkanghkyi e sha kau sai sagu lagaw lahkawng shing n rai sagu a na daw mi hpe sha bai gare la lu ai zawn Samari masha ni hta na naw hkrung nga ai nkau mi chyu sha zing hkam ai sut gan hta hkrawn taw nga na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chyahtum Chyalai N-gun rawng ai Tsaw Htum ai dai Madu gaw, “Ya chyawm gaw madat mu, Yaku a aru arat ni hpe sadi jaw mu,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Israela amyu masha ni shanhte galaw shut ai yubak ni a majaw ngai shanhte hpe ari jaw ai shani hta, Behtela a tawn hkungri ni hpe mung ngai jahten kau na we ai. Hkungri shagu na nrung ni daw kau ai hkrum nna ga de hkrat mat na ra ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw nshung ta na nta ni hte nlum ta na nta ni hpe jahten kau ya na nngai. Magwi kawng hte mawn sumli da ai nta ni hten run mat wa nna, kaba dam lada ai nta shagu jahten kau hkrum na mara ai,” nga nna tsun ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaw jahpum da ai Bashan na nga kanu ni zawn galu kaba hpum tsawm nga ai Samari numsha ni e, ndai ga madat mu, nanhte gaw n-gun kya ai ni hpe n gawn n sawn di nna, matsan mayan masha ni hpe dip gamyet sha nhtawm nanhte a madu wa ni kaw lu na sabyi ntsin shapraw ya na hpyi nga myit dai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsaw Htum ai dai Madu gaw chyoi pra nga ai hte maren, shi gaw, “Shanhte gaw nanhte hpe chyinghkyi ni hte garawt mat wa ai shaloi, dai nhtoi ni du wa na ra ai; nanhte kaw na marai shagu hte gaw myek hta lu ai nga zawn tai mat na rai myit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanhte gaw ni htum ai bunghku waw ai de gang garawt mat wa ai hkrum nna kabai shapraw kau hkrum na rai myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tsaw Htum ai dai Madu gaw, “Israela amyu masha ni e, nanhte galaw mayu ai rai yang, Behtela a chyoi pra ai shara de yubak sa galaw masu! Gilgala de sa nna nanhte a n-gun lagaw mahkra hte yubak galaw mu! Jahpawt shagu shagu hkungga nawng ya na matu yam nga ni la sa mu, Masum ya nhtoi shagu nanhte a htam shi hta na htam mi la sa mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang kaw chyeju dum ai myit hte sa nna nanhte a muk nawng jau mu, nanhte la sa ai shajan hkungga ni tsun shakawng dan mu! Dai zawn re ai amu galaw na nanhte tsaw nga myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ngai gaw nanhte a mare shagu de hkuwa shabyin dat ai wa rai nga nngai, ti mung nanhte ngai hpang de nhtang wa myit dai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai gaw nanhte a hkai nmai ni marang grai ra ai shaloi, marang n htu shangun nngai. Ngai gaw mare langai a ntsa e marang jahtu ya ti mung kaga mare hta n jahtu ya nngai. Hkauna pa langai a ntsa e marang htu ti mung, kaga langai mi hta hkun hkraw nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpang gara nna n-gun kya nga ai mare law law na masha ni gaw hka mu tam la na myit mada mai ai mare de sa ma ai, rai ti mung dai yang e, lu na hka alaw alam nga nga ai n rai. Shing rai tim, nanhte ngai kaw nhtang wa myit dai n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nanhte a hkai nmai nsi naisi ni hpe jahkraw kau shangun na matu kahtet kang ai nbung dat dat nngai. Hkakrit kadawn ni nanhte a sun ni, sabyi sun ni, lakum hpun ni hte tsanlun hpun ni yawng hpe sha kau ma ai. Shing rai tim, nanhte ngai kaw nhtang wa myit dai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Egutu mung hta ngai dat dat ai ana zinli hte bung ai palik ana zinli hpe nanhte a ntsa de mung ngai shangun dat ni ai. Nanhte a shabrang ni hpe majan pa hta, ngai sat kau ya ni ai; nanhte a gumra ni hpe mung ngai la kau ya ni ai. Nanhte a dap hta si mang ni a manam hkying ai hte nanhte a ladi ni hta ngai jahpring ya ni ai. Shing rai tim, nanhte ngai kaw nhtang wa myit dai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ngai gaw Sodom hte Gomora hpe jahten sharun kau ai zawn nanhte nkau mi hpe jahten kau ni ai. Naw ngam nga ai nanhte gaw wan mang kaw na shaw la ai hkru nga ai wan nhtaw daw zawn rai nga myit dai. Dai rai ti mung, nanhte ngai kaw nhtang wa myit dai n rai,” nga nna dai Madu tsun ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Dai rai nna, Israela amyu masha ni e, ngai nanhte hpe ari jaw na nngai. Dai amu hpe ngai galaw na rai nga nngai majaw, nye a tara jeyang ai lam hpe hkrum kadup na jin jin rai nga mu!”
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang gaw bum ni hpe galaw da ai wa rai nna nbung hpe hpan da nga ai. Shi gaw shi a myit mang lam masha ni hpe chye shangun nga ai; shi gaw nhtoi hpe nsin galai kau nga ai. Shi gaw ginding aga a tsaw ai shara ni hta hkawm nga ai. Ndai gaw shi a amying shingteng rai nga ai: Chyahtum Chyalai N-gun rawng ai Madu Karai Kasang rai nga ai!
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela amyu masha ni e, nanhte a matu ngai mahkawn ai ndai makoi mayang mahkawn hpe madat mu:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela hkawn sek gaw kataw mat sai, Galoi mung bai rawt lu na n rai! Shi gaw ga ntsa e kabai tawn da hkrum nga sai, Kadai mung shi hpe karum sharawt la ai n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tsaw Htum ai dai Madu gaw, “Israela mung na mare langai gaw hpyenla hkying mi dat dat ti mung, latsa chyu sha nhtang wa nga ai; kaga mare langai gaw latsa dat dat ti mung, marai shi chyu sha nhtang wa nga ai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Madu gaw Israela amyu masha ni hpe, “Ngai hpang de sa marit, nanhte hkrung nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nawku na matu Berasheba de hkum sa wa myit. Ngai hpe Behtela e hkum tam shakut myit- Behtela gaw kaman sha rai mat na ra ai. Gilgala de hkum sa myit- shi a masha ni bawng dung hkrum na matu dingnye hkrum nga masai,” ngu nna tsun ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu kaw sa mu, nanhte hkrung nga lu na rai myit dai. Nanhte n sa ai rai yang, Israela amyu masha ni a ntsa e wan hkrat bun ai zawn ye magawn mat wa na ra ai. Wan gaw Behtela masha ni hpe hkru kau nna kadai mung dai hpe sat kau lu na ra ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanhte gaw teng man rap ra ai tara hpe manai kau nna amyu masha ni a ahkaw ahkang hpe masu hkalem nga myit dai majaw, dingnye hkrum nga myit dai!
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai Madu gaw Kru Majan hte Nhtoi Gintawng shagan ni hpe hpan da nga sai. Shi gaw nsin hpe shani nhtoi, shani hpe shana kayin kau nga ai. Shi gaw panglai hka ni hpe shaga dat nna dai ni hpe ginding aga ntsa e ru dat nga ai. Shi a amying shingteng gaw dai Madu rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw n-gun rawng ai shanhte a hpyen dap ni hpe jahten kau nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanhte gaw n tara ai lam hta dakat ai kadai hpe rai ti mung, tara rung e teng man ai ga tsun ai ni hpe mung n dawng nga myit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte gaw matsan mayan masha ni hpe dip gamyet sha nna shanhte a nsi naisi ni kashun la kau ya nga myit dai majaw, nanhte gaw gap da ai tsawm ai nlung wahpang nta ni hta nga lu na myit dai n rai, nanhte hkai da ai tsawm la ai sabyi sun kata kaw na sabyi ntsin lu lu na myit dai n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanhte galaw shut kau ai yubak ni gaw kade sha hkrit hpa rai nga ai hte nanhte shut hpyit kau sai ru hka amu ni kade law la nga ai hpe ngai chye nngai. Nanhte gaw mai kaja ai masha ni hpe zingri zingrat di ai, mayun kumhpa ni la ai hte tara rung ni hta matsan masha ni hpe teng man rap ra ai hku n daw dan nga myit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai rai nna, ndai zawn n hkru ai aten ni hta azim sha nga ai gaw kaja ai amu rai nga a hka!
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanhte hkrung nga lu myit ga, n hkru ai hpe tawn da nna teng man ai amu galaw na shachyen nga mu. Dai hpang, Chyahtum Chyalai N-gun rawng ai Madu Karai Kasang gaw shi rai nga ai nga nna nanhte tsun myit dai hte maren, nanhte hte rau kaja wa nga nga na ra ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />N hkru ai amu hpe n dawng nga mu, teng man ai amu hpe tsaw ra nga mu, teng man rap ra ai tara gaw tara rung ni hta dang nga ai hpe mu lu nga ai. Dai Madu gaw naw hkrung ngam nga ai ndai amyu baw a amyu masha ni hpe mahkoi matsan chye dum la mai nhten.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna, Chyahtum Chyalai N-gun rawng ai Tsaw Htum ai dai Madu gaw, “Mare nmaw lam ni hkan e hkrap shabam ai hte yawn hkyen jahtau garu ai nsen ni nga nga na ra ai. Yi hkauna galaw sha ai ni pyi si mat sai ni a matu yawn hkyen hkrap shabam na nga sharung shayawt na matu manu jahpu jaw da hkrum ai ni hte rau shaga la hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sabyi sun ni yawng hta mung hkrap ngu hkrap ngoi ai gaw nga na ra ai. Ndai amu yawng byin wa na ra ai hpa majaw nga yang, ngai nanhte hpe ari jaw na made ai,” ngu nna tsun nga ai. Dai Madu tsun nu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai Madu a nhtoi hpe ala nga ai nanhte a matu kade sha hkrit hpa rai nga a hka! Dai shani e, nanhte mai kaja lam hpa baw galaw lu na rai myit ni? Dai shani gaw nanhte a matu nhtoi n rai, nsin a shani tai na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai shani gaw hkanghkyi langai kaw na hprawng wa ai wa hte tsap hte hkrum ai wa zawn tai na ra ai! Shing n rai nta de wa nna shakum hta lata mara da nga yang, lapu e achye hkrum ai wa zawn tai na ra ai!
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai Madu a shani gaw nhtoi n rai, nsin tai na ra ai; dai shani gaw sin mak wa nna, hpa mung htoi tu na ra ai n rai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai Madu gaw, “Ngai gaw nanhte a nawku htung hte seng ai poi ni hpe n dawng nngai; shing re ai lam ni hpe ngai hkam sharang lu na n rai!
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanhte nye a matu wan nat hkungga hte shadung hkungga ni nawng jau ai shaloi, dai ni hpe ngai hkap la na n rai; nanhte kaw tawn da ai yam nga ni hte hkungga nawng jau ti mung ngai hkap la na n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Garu kachyi nga ai nanhte a mahkawn mangoi hpe jasim kau mu; nanhte dum ai tingse nsen hpe ngai madat mayu nngai n rai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai na malai, teng man rap ra ai tara gaw hka shi zawn lwi nga u ga; ding man ai gaw galoi mung hkyet mat n chye ai hka shi zawn tai nga u ga.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Israela amyu masha ni e, ngai gaw nanhte hpe nam mali hku woi wa ai mali shi ning laman shagu hkungga ni hte shadung hkungga ni hpe n hpyi yu nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rai ti mung, ya chyawm gaw Sahkut ngu ai nanhte a hkawhkam hpara sumla ni hte Kaiwan ngu ai shagan hpara sumla ni hpe nawku manit dai majaw, dai hpara sumla ni hpe nanhte hpai hkawm ra na myit dai,
  </para>
  <para style="p">
    <verse number="27" style="v" />ngai nanhte hpe Damasku mare tawt hkra bawng dung sa shangun na nngai,” nga nna Chyahtum Chyalai N-gun Rawng Ai Karai Kasang ngu ai amying shingteng lu ai dai Madu tsun ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nanhte a matu Ziun hta ndai zawn ngwi pyaw ai asak hkrun lam lu la ai hte Samari mung e sim sa shim ai lam hkam sha lu ai, ndai galu kaba ai Israela amyu baw a galu kaba ai ningbaw ni kaw karum la na matu sa du ai masha ni gaw nanhte a matu kade wa hkrit hpa rai na rai nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Hkalna mare hpe sa yu yu mu. Dai hpang Hamat a galu kaba ai mare de matut sa nhtawm Gat a Hpilisti mare de yu sa wa mu. Dai ni gaw Yuda hte Israela mungdan ni hta grau kaja nga a ni? Shanhte a lamu ga gaw nanhte a lamu ga hta grau dam lada nga a ni?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanhte gaw tsin-yam tsindam a nhtoi du wa ra ai hpe yin la na matu ningdang kau nga myit dai, rai ti mung nanhte hkum nan galaw ai amu gaw dai nhtoi hpe grau shani la nga myit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zing hkam ai yup ra ntsa hta hkum chyan nna dumsu hkalung hte sagu kasha shan sha ai gaw nanhte a matu kade sha hkrit hpa rai na rai nga a hka!
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanhte gaw Dawi galaw sai zawn mahkawn mangoi ka shagawp na hte tingse sumpyi dum na ra sharawng nga myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanhte gaw sabyi ntsin hpe gawm hta lu nna manam pyaw htum ai sau jet ni lang nga myit dai, rai ti mung nanhte gaw Israela a hten run lam hpe sharung shayawt nga myit dai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai rai nna, nanhte gaw shawng nnan bawng dung hkrum na myit dai. Nanhte galaw ai poi ni hte hkik hkam lusha poi ni htum mat na ra ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chyahtum Chyalai N-gun rawng ai Tsaw Htum ai dai Madu gaw ndai dagam sadi jaw ai lam jaw ya nu ai: “Ngai gaw Israela amyu masha ni a gumrawng gumtawng ai hpe n dawng nngai; ngai gaw shanhte a zing hkam ai nta htingnu ni hpe matsat nngai. Ngai gaw shanhte a mare daju hte dai hta nga manga shagu hpe gumlau hpyen a lata de jaw kau na we ai.”
  </para>
  <para style="p">
    <verse number="9" style="v" />Lama rai nna, dinghku langai hta marai shi ngam nga ai rai yang, shanhte si na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Si mat sai wa a jinghku, makoi mayang poi hpareng ai wa gaw nta nhku de shang nna moi mang la shapraw na ra ai. Dai jinghku wa gaw nta nhku de naw nga nga ai wa hpe shaga dat nna, “Nang hte rau langai wa mi naw nga a ni?,” ngu nna san dat wu ai. Dai masha wa gaw, “N nga sai!,” ngu nna htan dat na ra ai. Dai shaloi jinghku wa gaw, “Nang azim sha nga u! Anhte gaw dai Madu a amying hpe tsun na matu pyi sadi ra nga ga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu hkang dat ai ga jaw dat ai shaloi, nta kaji kaba ni daw agrawp mat na mara ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gumra ni gaw lunghkrung ntsa hkan e gumlawt hkawm lu nga a ni? Kadai wa panglai hka hpe dumsu hte shawt lu a ni? Ti mung, nanhte gaw teng man rap ra ai tara hpe gung, jaw ai hpe shut ai de kayin kau nga myit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanhte gaw Lodeba mare hpe gasat la lu ai majaw shakawng nga myit dai. Nanhte gaw, “Karnaim hpe lu la na matu n-gun law nga ga ai,” nga nna gumrawng myit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyahtum Chyalai N-gun rawng ai Madu Karai Kasang gaw shi nan, “Israela amyu masha ni e, ngai gaw nanhte a mungdan hpe madu la na matu maigan hpyen hpung hpe shangun dat na nngai. Dai ni gaw nanhte hpe dingdung maga Hamat Uhkan kaw nna dingda maga Araba hka shi du hkra zingri zingrat na myit dai,” ngu nna tsun ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw Tsaw Htum ai dai Madu kaw na shingran langai lu la nngai. Dai shingran hta hkawhkam wa a yihku gambum dan ngut ai hpang, tsing nnan prut wa ai aten hta dinggam-yaw wunawng wuwa hpan dat ai hpe ngai mu nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a shingran hta dinggam-yaw ni mungdan na tsit lali ai lap yawng sha kau nga ai hpe mu nngai, dai hpang ngai gaw, “Tsaw Htum ai Madu e, na a amyu masha ni hpe mara dat ya u! Shanhte kaning rai hkrung lu na rai ma ta? Shanhte gaw grai kaji ai hte n-gun kya ai ni rai nga ma ai!,” ngu nna tsun we ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Madu gaw shi a myit galai mat nna, “Nang mu ai lam gaw byin wa lu na ra ai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw kaga shingran langai mung Tsaw Htum ai Madu kaw na lu la nngai. Dai shingran hta shi a amyu masha ni hpe wan hte ari jaw hkyen nga ai hpe mu nngai. Dai wan gaw mungkan ga a npu tsang hta nga ai nammukdara hka kaba hpe hkru kau nna mungkan ga a lamu ga hpe mung hkru magang shangun nga sai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hpang ngai gaw, “O Tsaw Htum ai Madu e, jahkring kau u! Na a amyu masha ni kaning rai hkrung nga lu na rai ma ta? Shanhte gaw grai kaji ai hte n-gun kya nga ma ai!,” ngu nna tsun we ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu gaw shi a myit bai galai mat nna, “Dai gaw byin wa na ra ai n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai gaw dai Madu kaw na shingran kaga lu la nngai. Dai shingran hta, shadawn sumri hte shading nna gaw gap da sai bunghku makau e shadawn sumri hpe shi a lata hta lang nna tsap nga ai hpe ngai mu nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw ngai hpe, “Amo e, nang hpa mu n ta?,” ngu nna san wu ai. Ngai gaw, “Shadawn sumri langai,” ngu nna htan we ai. Dai hpang, shi gaw, “Nye a amyu masha ni gaw n ding ai bunghku zawn rai nga ma ai hpe madun dan na matu dai hpe ngai lang nngai. Shanhte hpe ari jaw na lam hte seng nna nye a myit bai galai mat na ra ai n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Isak a amyu matu mara ni nawku ai shara ni jahten shaza hkrum na mara ai. Israela a chyoi pra ai shara ni hten run taw mat na mara ai. Ngai gaw Hkawhkam Yeroboam a magam matu hpe jahtum kau na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Behtela na hkinjawng Amazia gaw Israela a Hkawhkam Yeroboam hpang de ning ngu shiga shana dat wu ai: “Amo gaw amyu masha ni a lapran e nang hpe gumlau na matu maw mawn nga ai. Shi a tsun shaga ai ga ni gaw mungdan hpe jahten nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ndai gaw shi tsun ai ga rai nga ai: ‘Yeroboam gaw majan hta si mat na ra ai, Israela amyu masha ni gaw shanhte a mungdan kaw na bawng rim hkrum mat wa na mara ai.’”
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hpang, Amazia gaw Amo hpe, “Myihtoi wa e, ram sai! Yuda mung de bai nhtang wa nna dai shara hta mungga htawn tsun u. Dai amu a matu shanhte nang hpe shabrai jaw mu ga.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ndai Behtela e galoi mung myihtoi hkum htoi sa. Ndai shara gaw hkawhkam wa a nawku shara ngu ai amyu sha ting hte seng ai nawku htingnu rai nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amo gaw, “Ngai gaw shabrai a matu dai zawn myihtoi htoi ai wa n rai nngai. Ngai gaw yam nga rem sha ai wa hte lakum hpun ni hpe yu lajang ai wa she rai nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai ti mung, dai Madu gaw yam nga rem nga ai nye bungli kaw na shaga la nhtawm shi a amyu masha Israela ni hpang de sa nna myihtoi htoi na matu hkang dat nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna, ya chyawm gaw dai Madu tsun ai ga hpe madat u. Nang gaw ngai hpe myihtoi n htoi na matu mung, Israela amyu masha ni hpe ninghkap tsun ai ga jahkring na matu tsun ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna, Amazia e, dai Madu gaw nang hpe, ‘Na a madu jan gaw mare hta shawa num tai na ra ai, na a kashu kasha ni majan hta sat kau hkrum na mara ai. Na a lamu ga gaw karan kau hkrum nhtawm kaga ni hpe jaw kau ra na ra ai, nang nan gaw n san n seng ai mung hta si na rai ndai. Israela amyu masha ni gaw kaja wa shanhte a mung kaw nna bawng dung hkrum mat wa na mara ai,’” ngu nna tsun wu ai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw Tsaw Htum ai dai Madu kaw na kaga shingran langai lu la nngai. Dai shingran hta ngai gaw namsi ka langai mu nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai Madu gaw, “Amo e, nang hpa mu n ta?,” nga nna san wu ai. Ngai gaw, “Namsi ka langai,” ngu nna htan we ai. Dai Madu gaw ngai hpe, “Jahtum ai gaw nye a amyu masha Israela ni a matu du nga sai. Ngai gaw shanhte hpe ari jaw na hte seng nna nye a myit bai galai na n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai shani e, hkawhkam htingnu kata hta mahkawn mangoi ai nsen gaw hkrap shabam ai hte galai mat nna, si mang ni shara shagu hkan e taw nga na mara ai. Shanhte gaw atsin sha kabai kau hkrum na mara ai,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ra kadawn ai ni hpe kabye dip ai hte mungdan na matsan mayan masha ni hpe jahten sharun shakut nga ai nanhte gaw ndai ga madat mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanhte gaw tinang hkum hpe, “Anhte a mam dut lu na matu chyoi pra ai nhtoi ni lai mat wa na anhte la nga ga ai. Bansa Nhtoi htum mat ai shaloi, anhte a arai mari la ai ni hpe n man ai joi jang ni lang nna, dang hpe kaji, joi hpe kaba shangun let manu kaba hte dut la lu na rai nga ga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte gaw hkaulan mam nmyem ni hpe tsaw ai manu hte dut la lu na rai nga ga ai. Anhte gaw tinang a hka ni hpe n wa lu ai matsan mayan masha ni hpe mu tam na rai ga ai, kyepdin man mi a manu daram pyi manu n rawng ai shanhte hpe mayam ni hpe zawn mari lu na ga ai,” nga nna tsun myit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu Israela a Karai Kasang gaw ning ngu dagam nu ai: “Ngai gaw shanhte a n hkru ai arawn alai ni hpe galoi mung malap kau na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna ginding aga gaw ashun wa na ra ai, mungdan na masha shagu hte mung tsin-yam tsindam hkrum sha na mara ai. Mungdan ting gari ashun wa nna dai gaw Nila hka nu zawn rawt tung wa nna hkyet mat wa na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai gaw shani chyingtung e ajan hpe jashang kau shangun ai hte ginding aga hpe shani aten e nsin sin shangun ai shaloi dai aten du wa na ra ai. Tsaw Htum ai dai Madu ngai nan tsun ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai gaw nanhte a poi ni hpe makoi mayang poi shatai kau nna, nanhte a kabu gara ai mahkawn mangoi ni hpe sharung shayawt ai hte galai kau ya na made ai. Ngai gaw nanhte a baw ni hpe shakrin kau shangun nhtawm lachyit nba hpun shangun na made ai. Nanhte gaw kasha shingtai si mat ai majaw kanu yan kawa yawn hkyen hkrum nga ai zawn tai na myit dai. Dai shani gaw ahkup ahka nga nna htum mat wa na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Dai mungdan hta hkuwa hpe ngai dat dat ai shaloi dai aten gaw du wa na ra ai. Amyu masha ni gaw kawsi kyet na mara ai, rai ti mung muk a majaw n rai; shanhte gaw hpang gara na mara ai, rai ti mung hka a majaw n rai. Shanhte gaw dai Madu a mungga hpe kawsi ai hte hpang gara na mara ai. Tsaw Htum ai dai Madu ngai nan tsun ni ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amyu masha ni gaw Jum Nawng kaw nna Ka-ang Panglai du hkra, dingdung kaw nna sinpraw du hkra ningwan hkawm na mara ai. Shanhte gaw dai Madu kaw na mungga hpe shara shagu hkan tam na mara ai, rai ti mung shanhte dai hpe mu tam na ma ai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai shani e, hkam kaja ai shabrang ni hte numsha ni pyi hpang gara ai hte ba kalawp mat na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Samari a hpara sumla ni hte dagam ai ni gaw, ‘Dan a hpara shing n rai Berasheba a hpara hte ndai amyu masha ni hkrat mat nna bai n rawt wa lu na mara ai,” nga nna tsun ma ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw tawn hkungri makau e tsap nga ai Madu hpe mu nngai. Shi gaw ndai hkang da ai ga jaw wu ai: “Nawku Htingnu shadaw ni a pungding ni hpe agrawp shadaw kau mu, shaloi grai ja ai npawt nhpang gaw gari ashun wa na ra ai. Dai ni hpe agrawp daw ai hte amyu masha ni a ntsa de hkrat shangun u. Ngai gaw ngam nga ai amyu masha ni hpe majan hta sat kau na we ai. Kadai mung hprawng lu na n rai; langai mi mung lawt lu na ra ai n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte gaw katsan ga de yu wa ai shanhte a lam htu tim pyi, ngai shanhte hpe rim la na nngai. Shanhte sumsing lamu de lung ai rai tim pyi, ngai shanhte hpe shayu la na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte Hkarmela Bum pungding ntsa e makoi nga ai rai yang, ngai shanhte hpe hkan tam rim la na nngai. Shanhte gaw ngai kaw nna panglai htumpa hta makoi nga ai rai yang, shanhte hpe kawa na matu panglai baren numraw hpe ngai hkang dat na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw shanhte a gumlau hpyen ni a lata hta rim hkrum mat wa ai rai yang, sat kau na matu ngai shanhte hpe aming jaw na nngai. Ngai gaw shanhte hpe karum na matu n rai, shanhte hpe shamyit kau na matu daw dan da nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyahtum Chyalai N-gun rawng ai Tsaw Htum ai dai Madu gaw ginding aga hpe ahtawk hkra dat ai hte dai gaw ashun nga ai; dai hta nga ai ni yawng sharung shayawt nga ma ai. Mungkan ga ting gaw Nila hka nu zawn rawt tung wa nna kyet mat nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Madu gaw shi a nta hpe sumsing lamu ni hta gap da nna, ginding aga a ntsa e lamu madin tawn da nga ai. Shi gaw panglai hka ni hpe shaga dat nna dai ni hpe ginding aga ntsa de ru dat wu ai. Shi a mying shingteng gaw dai Madu rai nga a hka!
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu gaw, “Israela amyu masha ni e, ngai gaw nanhte hpe Ehtiopi masha ni zawn myit nawn da we ai. Ngai gaw nanhte hpe Egutu mung kaw nna woi shapraw wa ai zawn Hpilisti masha ni hpe Kreti mung na, Suri masha ni hpe Kira mung kaw na woi shapraw da ni ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tsaw Htum ai dai Madu ngai gaw yubak mara hte hpring ai ndai Israela mungdan hpe azi yu nga nngai, ngai gaw dai mungdan hpe ginding aga a man kaw na jahten kau na nngai. Rai ti mung, ngai gaw Yaku a amyu matu mara yawng hpe jahten shaza kau na nngai n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ngai gaw n-gu hpe hking kau ai zawn, Israela amyu masha ni hpe hking kau na matu hkang da na nngai. Ngai gaw akyu n rawng ai ni yawng hpe yeng seng kau na matu shanhte hpe masha amyu baw ni a lapran e hking kau na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a amyu masha ni hta na yubak kap ai masha ni gaw, ‘Karai Kasang gaw anhte hpang de tsin-yam tsindam dep shangun na n rai,’” nga nna tsun ai ni yawng majan hta sat kau hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu gaw, “Ngai gaw daw hten mat ai nta langai zawn rai nga ai Dawi a mungdan hpe bai gaw gap da ai shaloi dai nhtoi du wa na ra ai. Ngai gaw de a bunghku ni hpe bai lajang ai hte dai hpe bai gaw gap da na nngai. Ngai gaw dai hpe bai gaw gap ai hte moi na zawn bai de da na nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna, Israela amyu masha ni gaw naw ngam nga ai Edom mung a lamu ga hte nye a matu ngu nna san da sai amyu baw ni yawng hte hpe up hkang na mara ai,” ngu nna dai amu shabyin na ra ai dai Madu tsun ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Madu gaw, “Nhtoi ni du wa mara ai: “Nli tum tu ai gaw dai hpe dan la lu ai hta grau lawan tu na ra ai, sabyi si ni gaw sabyi ntsin galaw shapraw lu ai hta grau lawan tu na mara ai. Bum ni hta dwi ai sabyi ntsin kahte hkrat na ra ai, kawng ni hta sabyi ntsin ni lwi na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai gaw nye a amyu masha ni hpe shanhte a mung de woi wa na nngai. Shanhte gaw hten run mat sai shanhte a mare ni hpe bai gaw gap nna dai yang e nga na mara ai; shanhte gaw sabyi sun ni hkai sharing nna sabyi ntsin lu na mara ai; shanhte gaw sun ni galaw nna shanhte hkai ai shat mai lu sha na mara ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai gaw nye a amyu masha ni hpe ngai shanhte a matu jaw ai lamu ga hta hkai da na nngai, shanhte gaw bai baw kau hkrum na mara ai n rai,” ngu nna tsun ai. Dai Madu na a Karai Kasang tsun nu ai.
  </para>
</usx>
