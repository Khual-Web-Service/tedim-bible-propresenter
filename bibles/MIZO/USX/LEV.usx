<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LEV" style="id">Leviticus</book>
  <para style="h">Leviticus</para>
  <para style="toc1">Leviticus</para>
  <para style="toc2">Leviticus</para>
  <para style="mt">Leviticus</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpan Mosia a ko va, inbiakna puan in aṭangin a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte chu bia la, an hnênah, ‘In zînga tu pawhin Lalpa hnêna thilhlan in hlanin, ran, bâwng rual zînga mi emaw, berâm leh kêl zînga mi emaw in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A thilhlan chu bâwng rual zînga mi, hâlral thilhlan a nih chuan a pa, sawisêl bo a hlân tûr a ni; a thilhlan chu Lalpa hmaa pawm a nih theih nân inbiakna puan in kawngka bulah a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, hâlral thilhlan lû chungah chuan a kut a nghat ang a; tichuan, a tân inremna siamna tûrin pawmsak a ni ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Lalpa hmaah bâwngpa a talh ang a; tin, Arona fapa puithiamten thisen chu an hlân ang a, inbiakna puan in kawngka bula maichâm chu thisen chuan an theh vêl tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, hâlral thilhlan chu a lip ang a, a chan tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, puithiam Arona fapate chuan maichâmah chuan mei an dah ang a, mei chungah chuan thing an chhep khâwm ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Arona fapa puithiamte chuan sa hrang te, a lû te, a thau te chu maichâma mei chunga thingah chuan an dah fel ang a;
  </para>
  <para style="p">
    <verse number="9" style="v" />a kawchhûngte leh a kete erawh chu tuiin a sil ang. Puithiam chuan Lalpa tâna rimtui tak, meia hlan hâlral thilhlan atân a pum chuan maichâmah a hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />A thilhlan chu hâlral thilhlan atâna ran rual zînga mi, berâm emaw, kêl emaw a nih chuan, a pa, sawisêl bo a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Maichâm sîr, hmâr lampangah Lalpa hmaah a talh ang a; tin, Arona fapa puithiamte chuan maichâm chu a thisen chuan an theh vêl tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, a chan ang a, a lû nên, a thau nên; tin, puithiamin maichâm chunga mei chunga thingah chuan a dah fel ang;
  </para>
  <para style="p">
    <verse number="13" style="v" />a kawchhûngte leh a kete erawh chu tuiin a sil ang. Tin, a pumin puithiamin a hlân ang a, maichâmah a hâl tûr a ni; Lalpa tâna rimtui tak, meia hlan hâlral thilhlan a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Lalpa tâna a thilhlan chu sava lam hâlral thilhlan a nih chuan, a thilhlanah ṭhuro emaw, pârvano emaw a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puithiamin maichâmah a rawn keng ang a, a lû a ṭhuai bung ang a, maichâmah a hâl ang; tin, a thisen chu maichâm pangah chuan an far kangtîr ang a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, a chawkchaweng chu a hmul nên maichâm kiang, chhak lampanga meivâp dahna hmunah chuan a paih ang a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, a thlate chu a ṭhuai thlawn ang a, a tak erawh chu phel lovin; tin, puithiamin maichâmah, mei chunga thingah chuan a hâl tûr a ni. Chu chu Lalpa tâna rimtui tak, meia hlan hâlral thilhlan a ni.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tu pawhin thilhlan, chhangphut thilhlan Lalpa hnêna a hlan hunin, a thilhlan chu chhangput dip tak a ni tûr a ni. Hriak a leih ang a, a chungah beraw a dah bawk ang a;
  </para>
  <para style="p">
    <verse number="2" style="v" />tin, Arona fapa puithiamte hnênah a kalpui ang a, anin a vei khatin chuta chhangphut dip tak chu, a hriak nên a beraw zawng zawng nên chuan a la chhuak ang a; tin, puithiam chuan maichâm chungah chuan hriat rengna, Lalpa tâna rimtui tak, meia thilhlan atân a hâl ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chhangphut thilhlan lâk bângte chu Arona leh a fapate ta tûr a ni ang. Chu chu Lalpa tâna meia thilhlantea thil thianghlim tak pakhat a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, chhangphut thilhlan, a urnaa ur thilhlan i hlan chuan chhangphut dip tak, hriaka hmeh dawidim telh loh chhang emaw, hriaka chulh dawidim telh loh chhangpêr pan emaw a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, i thilhlan chu thlênga ur chhangphut thilhlan a nih chuan dawidim telh loh, hriaka hmeh, chhangphut dip tak a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />I phel ang a, hriakin i leih tûr a ni; chu chu chhangphut thilhlan a ni e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, i thilhlan chu thirbêla kan, chhangphut thihlan a nih chuan chhangput dip tak leh hriaka siam a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, chûng thila siam chhangphut thilhlan chu Lalpa hnênah i rawn la ang a; chu chu puithiam hnêna hlan a ni ang a, anin maichâmah a rawn kalpui tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, puithiamin chhangphut thilhlan ata hriat rengna chu a la chhuak ang a, maichâmah chuan a hâl ang; chu chu Lalpa tâna rimtui tak, meia thilhlan a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, chhangphut thilhlan lâk bângte chu Arona leh a fapate pual tûr a ni ang; chu chu Lalpa tâna meia thilhlantea thil thianghlim ber a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chhangphut thilhlan rêng rêng, Lalpa hnêna in hlan tûr chu dawidim tela siam tûr a ni lo; Lalpa tâna meia thilhlanah chuan dawidim emaw, khawizu emaw rêng rêng in hâl tûr a ni lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Siam hmasak ber thilhlan ang zawngin Lalpa hnênah in hlân ang a; nimahsela, rimtui atâna maichâmah chuan dah tûr a ni lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />I chhangphut thilhlan zawng zawng chu Pathian thuthlung entîrna chi i al tûr a ni; i thilhlan zawng zawng chu chi i al zêl tûr a ni; i thilhlan zawng zawngah chuan chi i hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rah hmasa ber chhangphut thilhlan Lalpa hnêna i hlan chuan buh thar hmasa bera mi, chhangphut thilhlan atân chhangpêr i hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, hriak i leih ang a, a chungah beraw i dah tûr a ni; chu chu chhangphut thilhlan a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, puithiamin chhangpêr leh hriak ṭhen chu hriat reng nân beraw zawng zawng nên chuan a hâl tûr a ni; chu chu Lalpa tâna meia thilhlan a ni.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />A thilhlan chu remna thilhlan inthawi a niha, bâwng rual zînga mi a hlan chuan, a nu emaw, a pa emaw pawh ni sela, Lalpa hmaah sawisêl bo a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thilhlan lû chungah chuan a kut a nghat ang a, inbiakna puan in kawngka bulah a talh ang a; tin, Arona fapa puithiamte chuan maichâm chu thisen chuan an theh vêl tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, remna thilhlan inthawinaa mi Lalpa tâna meia thilhlan a hlân ang a; a kawchhûng thau leh a rîlbawh zawng zawng leh,
  </para>
  <para style="p">
    <verse number="4" style="v" />a kal pahnih leh, a bawhtu thau a nêma mi leh a thin tuamtu râng, a kalte chawpin a phawrh tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Arona fapaten maichâmah, meia thil awm chunga hâlral thilhlan chungah chuan an hâl tûr a ni; chu chu Lalpa tâna rimtui tak, meia thilhlan a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, remna thilhlan inthawinaa Lalpa tâna a thilhlan chu berâm rual zînga mi a nih chuan a nu pawh ni sela, a pa pawh ni sela, sawisêl bo a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thilhlana berâmno a hlan chuan Lalpa hmaah a hlân ang a.
  </para>
  <para style="p">
    <verse number="8" style="v" />A thilhlan lû chungah chuan a kut a nghat ang a, inbiakna puan in kawtah a talh ang a; tin, Arona fapaten maichâm chu thisen chuan an theh vêl tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, remna thilhlan inthawinaa mi, Lalpa tâna meia thilhlan a hlân ang; a thau te, a mei thau tak a tluanin, a kâwngruh thlengin a la vek ang a; a kawchhûng thau te, a rîlbawh zawng zawng te,
  </para>
  <para style="p">
    <verse number="10" style="v" />a kal pahnih leh a bawhtu thau a nêma mi leh a thin tuamtu râng, a kalte chawpin a phawrh tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, puithiamin chu chu maichâmah a hâl tûr a ni; chu chu Lalpa tâna meia thilhlan ei tûr chhiah a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />A thilhlan chu kêl a nih chuan Lalpa hmaah a hlân ang a.
  </para>
  <para style="p">
    <verse number="13" style="v" />A lû chungah a kut a nghat ang a, inbiakna puan in kawtah a talh ang a; tin, Arona fapaten maichâm chu thisen chuan an theh vêl tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, chumia a thilhlan chu a hlân ang a, Lalpa tâna meia thilhlan chu; a kawchhûng thau leh a rîlbawh zawng zawng leh,
  </para>
  <para style="p">
    <verse number="15" style="v" />a kal pahnih leh a bawhtu thau a nêma mi leh, a thin tuamtu râng, a kalte chawpin a phawrh tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, chûng chu puithiamin maichâmah a hâl tûr a ni a, rimtui atâna meia thilhlan ei tûr chhiah a ni. A thau zawng zawng chu Lalpa pual a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thau emaw, thisen emaw ei loh tûr tih hi in thlahte zêl tân pawh in awmna apiangah zawm tûra thupêk ding reng a ni ang,’ ti rawh,” tiin.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte chu bia la, ‘ Lalpan thil tih loh tûra thu a pêkte, a enga pawh hi miin hriat loh vângin lo ti palh sela, a titu chu
  </para>
  <para style="p">
    <verse number="3" style="v" />hriak thih puithiam ni sela, mipui thiam loh chantîr thei thil a tihsual chuan, a thil tihsual tâk sual thawi nân Lalpa hnênah bâwngtuai sawisêl bo, sual thawinaah hlân rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bâwng chu inbiakna puan in kawngka bulah Lalpa hmaah a rawn kai ang a, bâwng lû chungah a kut a nghat ang a, Lalpa hmaah bâwng chu a talh tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, hriak thih puithiam chuan bâwng thisen eng emaw zât chu a la ang a, inbiakna puan inah chuan a rawn keng ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Puithiam chuan thisenah chuan a kut zungṭang a chiah ang a, a ṭhen chu Lalpa hmaah, hmun thianghlim puanzâr bulah chuan vawi sarih a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, puithiam chuan Lalpa hmaah, inbiakna puan ina rimtui hâlna maichâm kîahte chuan thisen chu tlêm a tât ang; tin, bâwng thisen la awm zawng zawng chu, inbiakna puan in kawngka kianga hâlral thilhlan maichâm bulah chuan a chhûng chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, sual thawina bâwng thau zawng zawng chu a la vek ang a; remna thilhlan inthawina bâwngpaa mi lâk angin, a kawchhûng thau leh a rîlbawh zawng zawng leh a kal pahnih leh a bawhtu thau a nêma mi leh a thin tuamtu râng, a kalte chawpin a phawrh ang a; tin, puithiamin hâlral thilhlan maichâmah a hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, bâwng vun te, a sa zawng zawng te, a lû nên, a kete nên, a kawchhûng te, a êk te,
  </para>
  <para style="p">
    <verse number="12" style="v" />a bâwng pum chu dai pâwn lam hmun faiah, vut paihnaah a kalpui ang a, thing chungah a hâl ang; vut paihnaah chuan hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel chu a hnam puma an lo suala, hre lova Lalpa thupêk eng pawh an lo bawhchhiat palh chuan,
  </para>
  <para style="p">
    <verse number="14" style="v" />chu thil tihsual chu hriat chhuah a nih veleh mipuiin sual thawi nân bâwngtuai an hlân ang a, inbiakna puan in kawtah an rawn kai tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, mipuiho upate chuan Lalpa hmaah bâwng lû chungah chuan an kut an nghat ang a; tin, bâwng chu Lalpa hmaah talh tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, hriak thih puithiam chuan inbiakna puan inah bâwng thisen eng emaw zât chu a rawn keng ang a;
  </para>
  <para style="p">
    <verse number="17" style="v" />tin, puithiamin thisenah chuan a kut zungṭang a chiah ang a, puanzâr bulah Lalpa hmaah vawi sarih a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, thisen chu inbiakna puan ina Lalpa hmaa maichâm kîah chuan tlêm a tât ang a; thisen la awm zawng zawng chu inbiakna puan in kawngka kianga, hâlral thilhlan maichâm bulah chuan a chhûng chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, a thau zawng zawng chu a la vek ang a, maichâmah a hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutiang chuan bâwng chu a ti ang a; sual thawina bâwng a tih ang chiahin hei pawh hi a ti tûr a ni. Tin, puithiamin inremna a siamsak ang a, ngaihdam an ni ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, bâwng chu daipâwn lamah a kalpui ang a, bâwng hmasa a hâl angin a hâl tûr a ni. Chu chu mipuite tâna sual thawina a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rorêltuin thil a tihsuala, Lalpa a Pathianin tih loh tûra thu a pêk zawng zawng a enga pawh a tih palha thiam loh a chana,
  </para>
  <para style="p">
    <verse number="23" style="v" />a thil sual tih chu hriattîr a nih chuan a thilhlanah kêl, a pa, sawisêl bo a rawn kai ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kêl lû chungah chuan a kut a nghat ang a, Lalpa hmaa hâlral thilhlan an talh ṭhinnaah chuan a talh tûr a ni. Chu chu sual thawina a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, puithiamin sual thawina thisen chu a kut zungṭangin tlêm a pir ang a, hâlral thilhlan maichâm kîahte chuan a tât ang a, hâlral thilhlan maichâm bulah a thisen chu a chhûng chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, a thau zawng zawng chu remna thilhlan inthawina thau a hâl angin maichâmah a hâl tûr a ni. Tichuan, a sual chungchâng thûah chuan puithiamin inremna a siamsak ang a, ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, vântlâng zînga mi a tua pawhin Lalpan tih loh tûra thu a pêkte a enga pawh tisual palhin, thiam loh lo chang ta sela,
  </para>
  <para style="p">
    <verse number="28" style="v" />a thil sual tih chu hriattîr a nih chuan a thilhlanah kêl, a nu, sawisêl bo, a thil tihsual tâk sual thawi nân a rawn kai tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sual thawina lû chungah chuan a kut a nghat ang a, hâlral thilhlanna hmunah chuan sual thawina chu a talh tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, puithiamin thisen chu a kut zungṭangin tlêm a pir ang a, hâlral thilhlan maicham kîahte chuan a tât ang a, a thisen la awm zawng zawng chu maichâm bulah chuan a chhûng chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, a thau zawng zawng chu remna thilhlan inthawina thau an lâk angin a la vek ang a; tin, puithiamin Lalpa tâna rimtuiah maichâmah a hâl tûr a ni. Tichuan, puithiamin inremna a siamsak ang a, ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, sual thawi nâna a thilhlana berâmno a rawn ken chuan, a nu, sawisêl bo a rawn keng tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sual thawina lû chungah chuan a kut a nghat ang a, hâlral thilhlan an talhnaah chuan sual thawi nân a talh tûr a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, puithiamin sual thawina thisen chu a kut zungṭangin tlêm a pir ang a, hâlral thilhlan maichâm kîahte chuan a tât ang a, a thisen la awm zawng zawng chu maichâm bulah chuan a chhûng chhuak ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />A thau zawng zawng chu berâmno thau, remna thilhlan inthawinaa mi lâk angin a la vek ang a, puithiamin Lalpa tâna meia thilhlan angin maichâmah a hâl tûr a ni. Tichuan, puithiamin a thil tihsual tâk chungchâng thûah inremna a siamsak ang a, ngaihdam a ni ang.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tu pawh a thil hmuh emaw, a thil hriat emawa hretu a niha, rorêlna hmaa puang tûra tih a nih hnu pawha a sawi duh lohva, thil a tihsual chuan a khawlohna mawh chu a phur ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, tu pawhin thil thianghlim lo rêng rêng, ramsa thianghlim lo ruang emaw, ran thianghlim lo ruang emaw, a vaha vâk chi rannung thianghlim lo ruang emaw, hre lo pawha a khawiha, a lo thianghlim loh chuan thiam loh a chang ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, mihring pawh a thianghlim lohna eng ang pawh ni sela, a thianghlim lohna chu hre lo pawha a khawih chuan, a hriat chhuah hun chuan thiam loh a chang ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, tu pawhin thil ṭha lo emaw, thil ṭha emaw ti tûra a kâa hre lo pawha chhia a chham zung zung chuan, eng pawh ni sela, a chhechham chhuah zung zung mai chu a hriat chhuah hunah chuan thiam loh a chang ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, heti hi a ni ang a, hêng thil pakhatah pawh hian thiam loh a chan hun chuan a sualna chu a puang ang a;
  </para>
  <para style="p">
    <verse number="6" style="v" />sual thawi nân berâm rual zînga mi a nu, berâmno emaw, kêl emaw a thil tihsual tâk man atân Lalpa hnêna hlan tûrin, a bawhchhiat thawina chu a rawn keng ang. Tichuan, puithiamin a sualna chungchâng thûah chuan inremna a siamsak ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />A neihin berâmno a tlin loh chuan, Lalpa hnêna hlan tûrin a sual man atân chuan a bawhchhiat thawinaah ṭhuro pahnih emaw, pârvano pahnih emaw a rawn keng tûr a ni: pakhat chu sual thawi nân, pakhat chu hâlral thilhlan atân.
  </para>
  <para style="p">
    <verse number="8" style="v" />Puithiam hnênah a rawn keng ang a, ani chuan sual thawina tûr chu a hlân hmasa ang a, phel lovin a lû chu a nghâwngah a ṭhuai bung ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, sual thawina thisen chu maichâm pangah chuan tlêm a theh ang a; tin, thisen la awm zawng chu maicham bulah chuan far kangtîr tûr a ni. Chu chu sual thawina a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, a pakhata chu dân angin hâlral thilhlanah a hlân ang a. Tichuan, puithiamin a thil tihsual tâk chungchâng thûah inremna a siamsak ang a, ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaherawhchu, a neihin ṭhuro pahnih emaw, pârvano pahnih emaw pawh a tlin loh chuan, a sual man atâna thilhlanah sual thawi nân chhangphut dip tak, epha hmun sâwma ṭhena hmun khat a rawn keng ang. Hriak a leih tûr a ni lo va, a chungah beraw a dah tûr a ni hek lo, sual thawina a nih avângin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Puithiam hnênah a rawn keng ang a, puithiamin hriat rengna atân a vei khatin a la ang a, maichâm chungah Lalpa tâna meia thilhlan angin a hâl tûr a ni. Chu chu sual thawina a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, chûng thil zînga a enga pawh a tihsual tâk chungchâng thûah chuan, puithiamin inremna a siamsak ang a, ngaihdam a ni ang. A la awm zawng chu chhangphut thilhlan ang bawkin puithiam chanpual tûr a ni ang,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Tu pawhin thil a tihsuala, Lalpa thil thianghlimte chunga a sual palh chuan a bawhchhiat thawina, berâm rual zînga mi berâmpa sawisêl bo, hmun thianghlim sekel ang, tangka sekel eng emaw zât hua i ngaih, bawhchhiat thawinaah Lalpa tân a rawn kai tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, thil thianghlim chunga a lo tih dik loh tâkna chu a rûl ang a, a hmun ngaa ṭhena hmun khat a belh ang a, puithiam a pe tûr a ni. Tichuan, puithiam chuan bawhchhiat thawina berâmpa chuan inremna a siamsak ang a, ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tu pawhin thil a tihsuala, tih loh tûra Lalpan thu a pêkte a enga pawh a tih chuan, hre lo mah sela thiam loh a chang rêng rêng ang a, a khawlohna mawh chu a phur ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, berâm rual zînga mi berâmpa sawisêl bo, i ngaiha âwm tâwk, bawhchhiat thawinaah puithiam hnênah a rawn kai tûr a ni. Tichuan, puithiam chuan hre lova a tihsual palh chungchâng thûah chuan inremna a siamsak ang a, ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chu chu bawhchhiat thawina a ni; Lalpa hmaa thiam loh chang a ni ngei a ni,” tiin.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Tu pawhin thil tisualin, Lalpa thu bawhchhe ta sela, sum kawltîr thu emaw, hlêp thu emaw, rûkrûk thu emawa a ṭhenawmte tihderin a ṭhenawmte bum ta sela,
  </para>
  <para style="p">
    <verse number="3" style="v" />a nih loh leh, thil bo chharin, tihderin dâwtin chhia chham ta sela, hêng thil zawng zawng a enga pawh hi a tihsual chuan,
  </para>
  <para style="p">
    <verse number="4" style="v" />heti hi a ni ang a, a sual ngeia, thiam loh a chan chuan a thil rûk te, buma a thil lâk te, a hnêna sum kawltîr te, thil bo a chhar te,
  </para>
  <para style="p">
    <verse number="5" style="v" />dâwta chhia a chhamna thil eng pawh chu a rûl leh tûr a ni. A kim chiahin a rûl leh vek ang a, a hmun ngaa ṭhena hmun khat chu a chuangin a belh ang a, thiam loh a chan ni chuan a neitu chu a pe tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />A bawhchhiat thawina berâm rual zînga mi, i ngaiha âwm tâwk, berâmpa sawisêl bo, bawhchhiat thawinaah Lalpa tân puithiam hnênah a rawn kai tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, puithiamin Lalpa hmaah inremna a siamsak ang a, ngaihdam a ni ang, thiam loh channa tûra thil a tih apiang chungchângahte chuan,” tiin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Arona leh a fapate hnênah, ‘Hei hi hâlral thilhlan dân tûr chu a ni: hâlral thilhlan chu maichâm chunga a hâlnaah chuan zankhuain a tûk thlengin a awm ang a; tin, maichâma mei chu a nung reng tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, puithiam chuan a puan zai sîn silhfên a inbel ang a, a tisa khuh nân a puan zai sîn kekawr a ha ang a; tin, maichâma hâlral thilhlan kâng vâpte chu a la ang a, maichâm sîrah a dah tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, a silhfên chu a hlîp ang a, silhfên dang a inbel ang a, a vâpte chu daipâwn lam hmun faiah a kalpui tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, maichâm chunga mei chu tihnun reng a ni ang a, a mit tûr a ni lo. Tin, puithiam chuan tûk tin thing a tuah ang a, hâlral thilhlan chu a dah fel ang a; chutah chuan remna thilhlante thau chu a hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maichâmah mei a nung reng ang a; a mit tûr a ni lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, hei hi chhangphut thilhlan dân tûr chu a ni: Arona fapate chuan maichâm bulah, Lalpa hmaah an hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, anin a vei khatin chhangphut thilhlana mi, chhangphut dip tak leh a hriak leh chhangphut thilhlan chunga beraw zawng zawng chu a la chhuak ang a, chu chu Lalpa tâna rimtui tak, hriat rengna atân maichâmah a hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, lâk bângte chu Arona leh a fapaten an ei tûr a ni; chu chu hmun thianghlimah dawidim tel lovin an ei ang a; inbiakna puan in kawtlaiah an ei tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dawidim telin ur tûr a ni lo. Meia ka thilhlana an chanvo atân ka pêk a ni; chu chu sual thawina leh bawhchhiat thawina anga thil thianghlim tak a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Arona thlah mipa zawng zawngin an ei tûr a ni. Chu chu Lalpa tâna hâlral thilhlan chungchâng thûah in thlahte zêl chena kumkhaw dân a ni ang. Tu pawh chumi khawih apiangte chu tihhran an ni ang,’ tiin thu pe rawh,” tiin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="20" style="v" />“Hriak thiha a awm nia Arona leh a fapaten Lalpa hnêna an hlan tûr thilhlan chu hei hi a ni: chhangphut thilhlana hlan ṭhin tûr, chhangphut dip tak epha hmun sâwma ṭhena hmun khat, zîngah a chanve, tlaiah a chanve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Urna thlêngah hriak pawlha siam tûr a ni. A inchiah chhuah hunah i rawn la lût ang a, a phel tê têin chhangphut thilhlan chu Lalpa tâna rimtuiah i hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />A fapate zînga mi a thlâktu, hriak thih puithiam chuan a hlân ang a; kumkhaw dân tûr angin Lalpa tân hâl ral vek tûr a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Puithiam chhangphut thilhlan apiang chu hâl ral vek tûr a ni a, ei hauh loh tûr a ni,” tiin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="25" style="v" />“Arona leh a fapate hnênah, ‘Hei hi sual thawi dân tûr chu a ni: hâlral thilhlan talh ṭhinnaah sual thawina pawh chu Lalpa hmaah talh tûr a ni. Chu chu thil thianghlim tak a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sual thawina hlântu puithiam chuan a ei ang a; inbiakna puan in kawtlaiah, hmun thianghlimah ei tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tu pawh chumi sa khawih apiangte chu tihhran an ni ang; tin, a thisen chu eng puanah pawh theh per ni sela, a kaina apiang chu hmun thianghlimah i su tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />A chhumna hlum bêl chu tihkeh tûr a ni a; dâr bêla chhum a nih erawh chuan nawh faia tleuh fai tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Puithiam chhûngkuaa mipa tawh phawt chuan chumi chu an ei thei ang. Chu chu thil thianghlim tak a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sual thawina, a thisen hmun thianghlima inremna siamna tûra inbiakna puan ina rawn lâk chu ei tûr a ni lo; hâl tûr a ni.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, hei hi bawhchhiat thawi dân tûr chu a ni, thil thianghlim tak a ni:
  </para>
  <para style="p">
    <verse number="2" style="v" />hâlral thilhlan an talh ṭhinnaah bawhchhiat thawina pawh chu an talh tûr a ni; tin, a thisen chuan maichâm chu a theh vêl tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, a thau zawng zawng chu a hlân tûr a ni: a mei thau tak te, a kawchhûng thau te,
  </para>
  <para style="p">
    <verse number="4" style="v" />a kal pahnih leh a bawhtu thau, a nêma mi leh a thin tuamtu râng, a kalte chawpin a phawrh ang a;
  </para>
  <para style="p">
    <verse number="5" style="v" />tin, puithiam chuan Lalpa tâna meia thilhlanah maichâm chungah a hâl tûr a ni. Chu chu bawhchhiat thawina a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Puithiam chhûngkuaa mipa tawh phawt chuan chumi chu an ei thei ang; hmun thianghlima ei tûr a ni. Chu chu thil thianghlim tak a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bawhchhiat thawina chu sual thawina ang bawk a ni a, dân khat a ni: chumia inremna siamtu puithiam chuan chu chu a nei tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Puithiam, mi tu pawh hâlral thilhlana a hlansaktu puithiam ngei chuan, hâlral thilhlana a hlan vun chu a pumbil tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, a urnaa ur chhangphut thilhlan apiang te, kan bêla kan leh thlênga ur zawng zawng chu a hlântu puithiam pual tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chhangphut thilhlan zawng zawng chu hriaka hmeh pawh, a ro pawh, a dang ang bawkin Arona fapate zawng zawngin an insem tlâng tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, hei hi miin Lalpa hnêna a hlan tûr, remna thilhlan inthawi dân tûr chu a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lâwm thu sawi nâna a hlan chuan, lâwmthu sawi inthawinaah chuan hriaka hmeh dawidim telh loh chhang leh, hriaka chulh dawidim telh loh chhangpêr pante leh, chhangphut dip tak hriaka ngun taka hmeh a hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lâwm thu sawi nâna a remna thilhlan inthawinaah chuan, chhang dawidim telh a hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, chumi ata chu thilhlan tina mi Lalpa tâna thên thilhlan atân pakhat ṭheuh a hlân ang a; remna thilhlan thisena thehtu puithiam pual tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, lâwmthu sawi nâna a remna thilhlan inthawina sa chu thilhlan a hlan ni la lain ei zawh tûr a ni a; a tûk thlengin eng mah a khêk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaherawhchu, a thilhlan inthawina chu thutiam emaw, mahni duh thûa thilhlan emaw a nih chuan, a inthawina a hlan ni la la chuan ei tûr a ni a; tin, ei bâng chu a tûkah ei tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaherawhchu, inthawina sa a ni thum ni thlenga la awm cheu chu hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />A remna thilhlan inthawina sa chu ni thum ni thlenga an ei chuan, pawmsak a ni lo vang a, a hlântu pawh chu hlâna ngaih a ni hek lo vang; thil tenawm a ni ang a, tu pawh a ei apiangin an khawlohna mawh chu an phur ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, sa, thil thianghlim lo rêng rêng nêna intawk chu ei tûr a ni lo va, hâl tûr a ni. Tin, sa chu a thianghlim apiang chuan an ei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Remna thilhlan inthawina sa, Lalpa chanpual, thianghlim lo chunga eitu erawh chu, chu mi chu a chipuite zîng ata tuithlârin a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, tu pawhin thil tenawm, thianghlim lo rêng rêng, mi thianghlim lo emaw, ran thianghlim lo emaw, thil thianghlim lo rêng rêng a khawiha, remna thilhlan inthawina sa, Lalpa chanpual a ei chuan, chu mi chu a chipuite zîng ata tuithlârin a awm tûr a ni,’ tiin hrilh rawh,” tiin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Israela thlahte hnênah, ‘Sebâwng emaw, berâm emaw, kêl emaw thau in ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amaha thi thau leh sa seh thau chu thil dang engah pawh hman theih a ni ang a; ei erawh chu in ei hauh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tu pawh, Lalpa tâna miin meia thilhlan an hlan sathau ei chu a chipuite zîng ata tuithlârin a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />In awmna tawh phawtah chuan thisen rêng rêng, sava emaw, ramsa emaw thisen in ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tu pawh ni sela, thisen ei rêng rêng chu, chu mi chu a chipuite zîng ata tuithlârin a awm tûr a ni,’ tiin hrilh rawh,” tiin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Israela thlahte hnênah, ‘ Lalpa hnêna a remna thilhlan inthawina hlân apiang chuan, Lalpa tâna a thilhlan chu a remna thilhlan inthawina ata a rawn hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lalpa tâna meia thilhlan chu ama kut ngeiin a rawn keng ang a; a thau chu a ir chawpin a rawn la tûr a ni, a ir chu Lalpa hmaa thên thilhlana thên a nih theih nân.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, puithiamin maichâmah a thau chu a hâl ang a; a ir erawh chu Arona leh a fapate pual tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />A bawp ding lam chu inremna thilhlan inthawina ata thên thilhlanah puithiam in pe tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Arona fapate zînga remna thilhlan thisen leh thau hlântu apiang chuan, a chanvo atân a bawp ding lam a nei tûr a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />A ir leh a bawp an thên ṭhin chu Israela thlahte an remna thilhlan inthawinate ata chu ka tîl hrang a, Israel thlahte kumkhaw tih dân tûr atân puithiam Arona leh a fapate ka pe a ni,’ tiin hrilh rawh,” tiin.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hei hi a ni, anmahni hriak a thih nîa Israela thlahten an pêk tûra Lalpan thu a pêk, puithiam hna thawka Lalpa rawngbâwl tûra a hlan nî achina Lalpa tâna meia thilhlan ata Arona chanvo leh a fapate chanvo tûr chu. Hei hi kumkhuaa an thlahte zêl thlenga an tih dân tûr a ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hei hi Sinai thlalêra Israela thlahten thilhlan Lalpa hnêna hlân tûra thu a pêk nî-a, Sinai tlânga Lalpan Mosia thu a pêk hâlral thilhlan te, chhangphut thilhlan te, sual thawina te, tihhranna te, remna thilhlan inthawina dân te chu a ni.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona chu a fapate nên hruai la, silhfên te, hriak thih mi te, sual thawina bâwngpa te, berâmpa pahnih te, chhang dawidim telh loh bâwm khat nên chuan keng bawk la;
  </para>
  <para style="p">
    <verse number="3" style="v" />tin, mi zawng zawng chu inbiakna puan in kawngka vêlah awm khâwmtîr rawh,” tiin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Mosia chuan Lalpan thu a pêk ang chuan a ti a; mi zawng zawng chu inbiakna puan in kawngka vêlah chuan an awm khâwm a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Mosian pung khâwmho hnênah chuan, “Hei hi a ni, Lalpan tih tûra thu a pêk chu,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Mosian Arona leh a fapate chu a rawn hruai a, a bual a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, kawr chu a hâktîr a, kâwng hrênna chuan a hrêng a, kawrfual chu a hâktîr a, puithiam kawr chu a bel a; puithiam kawr hrênna thiam taka tah chuan a hrêng a, chu chuan a hrêng bet a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, âwmbel chu a bel a; tin, âwmbelah chuan Urim leh Thumim a dah a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Diar chu a khimtîr a; tin, diar pang hma lamah chuan rangkachak phêk, tihhran chhinchhiahna thianghlim chu a bel a, Lalpan Mosia thu a pêk ang khân.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Mosia chuan hriak thih mi chu a la a, biak bûk leh a chhûnga thil awm zawng zawngte chu a thih a, a tithianghlim hlawm a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chu bawk chuan maichâm chu vawi sarih a theh a, maichâm leh a bungbêl zawng zawng te, maihûn leh a hûnchhante chu tithianghlim tûrin a theh a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, a tihthianghlimna tûrin hriak thih mi chu Arona lûah a leih a, a thih a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Mosian Arona fapate chu a rawn hruai a, kawr a haktîr a, kâwng hrênnain a hrêng a, diar a khimtîr a, Lalpan Mosia thu a pêk ang khân.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, sual thawina bâwngpa chu a rawn kai a, Arona leh a fapate chuan sual thawina bâwngpa lû chungah chuan an kut an nghat a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Mosia chuan a talh a; thisen chu a la a, chu chu inremna maichâm atan a kut zungṭangin a kîahte chuan a vêlin a tât a, maichâm chu a thian a, maichâm bulah thisen chu a leih a, a tithianghlim a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, a rîlbawh zawng zawng te, a thin tuamtu râng te, a kal pahnih leh a thaute a la a, maichâmah Mosian a hâl a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bâwngpa erawh chu a vun nên, a sa nên, a êk nên, daipâwnah a hâl a, Lalpan Mosia thu a pêk ang khân.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, hâlral thilhlan berâmpa chu a han hlân a, Arona leh a fapate chuan berâmpa lû chungah chuan an kut an nghat a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Mosia chuan a talh a; tin, maichâm chu thisen chuan a theh vêl a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, berâmpa chu a chan a, a lû leh sa hrangte leh a thaute chu a hâl a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, a kawchhûng leh a kete chu a sil a; berâmpa chu maichâmah a vaiin a hâl vek a; Lalpa tâna meia thilhlan a ni a, Lalpan Mosia thu a pêk ang khân.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, berâmpa dang, tihhranna berâmpa chu a han hlân leh a; Arona leh a fapate chuan berâmpa lû chungah chuan an kut an nghat a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Mosia chuan a talh a, thisen chu a la a, Arona beng ding lam hmâwrah te, a kut ding lam zungpuiah te, a ke ding lam zungpuiah te a hnawih a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Mosia chuan Arona fapate chu a hruai a, an beng ding lam hmâwrah te, an kut ding lam zungpuiah te, an ke ding lam zungpuiah te a hnawih a; tin, maichâm chu thisen chuan a theh vêl a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, a thau te, a mei thau tak te leh a rîlbawh zawng zawng te, a thin tuamtu râng te, a kal pahnih leh a thaute leh a bawp ding lam a la a;
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa hmaa chhang dawidim telh loh bâwm ata chu chhang dawidim telh loh pakhat leh, hriaka hmeh chhangpêr pakhat leh chhangpêr pan pakhat a la a, sa thau chungah leh a bawp ding lam chungah chuan a dah a;
  </para>
  <para style="p">
    <verse number="27" style="v" />tin, a vai chuan Arona kutphah chungah leh a fapate kutphah chungah chuan a dah a, Lalpa hmaa thên thilhlanah a thên a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Mosian an kut ata chu a la a, halrâl thilhlan chungah maichâmah a hâl a; chu chu rimtui atâna tihhranna a ni; Lalpa tâna meia thilhlan a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Mosian a ir chu a la a, Lalpa hmaa thên thilhlanah a thên a; chu chu tihhranna berâmpaa Mosia chanvo a ni, Lalpan Mosia thu a pêk ang khân.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Mosian hriak thih mi ata leh maichâma thisena mi a la a, chu chuan Arona leh a silhfên a theh a, a fapate leh a fapate silhfênte pawh; Arona leh a silhfên chu a tithianghlim a, a fapate leh a fapate silhfênte pawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Mosian Arona leh a fapate hnênah chuan, “Inbiakna puan in kawngka bulah sa chu chhûm ula, ‘Arona leh a fapaten an ei tûr a ni,’ tia thu ka pêk ang khân, chutah chuan tihhranna bâwma chhang nên ei rawh u.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, sa leh chhang ei bângte chu in hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />In intihhranna ni a kim hma loh chuan inbiakna puan in kawngka chu chhuahsan lovin ni sarih in awm tûr a ni; ni sarih a tihrang dâwn si che u a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tûna tih ang hian inremna siamsak tûr che uin Lalpan tih tûr thu a pe a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Inbiakna puan in kawngka bulah chuan ni sarih, chhûn leh zân in awm reng ang a, in thih loh nân Lalpa thupêk chu in zâwm tûr a ni; chutianga thupêk chu ka ni,” a ti a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tichuan, Lalpan Mosia hmanga tih tûra thu a pêk zawng zawng chu Arona leh a fapate chuan an ti a.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, heti hi a ni a, a ni riat ni chuan Mosian Arona leh a fapate leh Israel upahote chu a ko va.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Arona hnênah chuan, “Sual thawi nân bâwngno a pa leh hâlral thilhlanah berâmpa, sawisêl bo ve ve kai la, Lalpa hmaah hlân rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Israela thlahte hnênah chuan, ‘Sual thawi nân kêlpa, hâlral thilhlanah bâwngno leh berâmno kum khat mi ve ve sawisêl bo ṭhiau
  </para>
  <para style="p">
    <verse number="4" style="v" />leh, bâwngpa leh berâmpa Lalpa hmaa remna thilhlana hlanah rawn kai ula, hriaka hmeh chhangphut thilhlan nên; vawiinah hian in hnênah Lalpa a lo lang dâwn e,’ tiin hrilh rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Mosian thu a pêk ang chuan inbiakna puan in kawtah an rawn kai a; tin, mi zawng zawng chuan an va hnaih a, Lalpa hmaah chuan an va ding a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Mosia chuan, “Hei hi a ni in tih tûra Lalpan thu a pêk che u kha; tichuan, Lalpa ropuina chu in zîngah a lo lang ang,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Mosian Arona hnênah, “Maichâm chu rawn hnaih la, i sual thawina te, i hâlral thilhlan te hlân la, nangma tân leh mipuite tân inremna siam rawh. Mipuite thilhlan chu hlân la, an tân inremna siam rawh, Lalpa thupêk angin,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Arona chuan maichâm chu a va hnaih a, ama puala sual thawina bâwngno chu a talh a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Arona fapate chuan thisen chu a hnênah an hlân a, thisenah chuan a kut zungṭang a chiah a, maichâm kiahte chuan a tât a, thisen chu maichâm bulah a leih a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sual thawina thau te, a kal te, a thin tuamtu râng te erawh chu maichâm chungah a hâl a, Lalpan Mosia thu a pêk ang khân.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, a sa leh a vun chu daipâwnah a hâl a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, hâlral thilhlan chu a talh a; Arona fapate chuan thisen chu an pe a, anin maichâm chu a theh vêl a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hâlral thilhlan sa hrang chu a mal malin a lû nên an pe a, ani chuan maichâmah a lo hâl a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, a kawchhûng te, a kete a sil a, maichâmah hâlral thilhlan chungah chuan a hâl a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, mipuite thilhlan chu a hlân a, mipuite sual thawina kêl chu a kai a, a talh a, a hmaa mi ang bawk khân sual thawinaah a hlân a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, hâlral thilhlan chu a hlân a, a dân ang zêlin a hlân a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, chhangphut thilhlan chu a hlân a, chuta mi chu a vei khatin a la a, zîng lam hâlral thilhlan bâkah maichâmah chuan a hâl bawk a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mipuite puala remna thilhlan inthawina bâwngpa leh berâmpa chu a talh bawk a; tin, Arona fapaten a thisen chu an pe a, maichâm chu a theh vêl a;
  </para>
  <para style="p">
    <verse number="19" style="v" />tin, bâwngpa thau leh berâmpa thau te, a mei thau tak te, a rîlbawh te, a kal te, a thin tuamtu rângte an pe bawk a;
  </para>
  <para style="p">
    <verse number="20" style="v" />a thau chu a ir chungah te chuan an dah a; tin, ani chuan a thau chu maichâmah chuan a hâl a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, a ir leh a bawp ding lam chu Arona chuan Lalpa hmaah thên thilhlanah a thên a, Mosia thupêk ang khân.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Arona chuan mipui lamah chuan a bân a phar a, mal a sâwm hlawm a; tin, sual thawina leh hâlral thilhlan leh remna thilhlan a hlân zo chu a lo chhuk a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Mosia leh Arona chu inbiakna puan inah an va lût a; tin, an lo chhuak leh a, mipuite chu mal an sâwm a. Tin, Lalpa ropuina chu mi zawng zawng chungah chuan a lo lang a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Lalpa hma aṭang chuan mei a lo chhuak a, hâlral thilhlan leh thaute chu maichâmah chuan a kâng ral ta a. Tin, chu chu mipui zawng zawngin an hmuh chuan an au dur dur a, an bawkkhup ta ṭhuap a.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Arona fapa, Nadaba leh Abihua-te chuan an mei lâkna chu an la ve ve a, chutah chuan meiling an dah a, rimtui an phul a, Lalpa hmaah a thupêk lohvin mei hman loh chi an hlân a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutichuan, Lalpa hma aṭangin mei a lo chhuak a, anni chu a kâng hlum a, Lalpa hmaah chuan an thi ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutichuan, Mosian Arona hnênah, “ ‘Mi rawn hnaihtuahte chuan thianghlimin ka lang ang a; mipui zawng zawng hmaah chuan chawimawiin ka awm ang,’ tia Lalpan a sawi kha hei hi a nih hi,” a ti a. Tin, Arona chu a ngawi reng a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, Mosia chuan Arona pami Uziela fapa, Misaela leh Elzaphana-te chu a ko va, an hnênah, “Lo hnai ula, in unaute hi hmun thianghlim ata daipâwnah zâwn chhuak rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutichuan, an lo hnai a, an puithiam kawr ha chungin daipâwnah an zâwn chhuak a, Mosia sawi ang chuan.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Mosian Arona hnênah leh a fapa Eleazara leh Ithamara-te hnênah chuan, “In sam thlah suh ula, in puante pawt thlêr hek suh u; chuti lo chuan, in thi ang a, mi zawng zawng chungah Lalpa a thinur ang; in unau, Israel chhûngkaw pum puiin mei, Lalpa hâl chu sûn zâwk rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, inbiakna puan in kawngka ata chu in chhuak tûr a ni lo; chuti lo chuan, in thi ang, Lalpa hriak, thih mi chu in chungah a awm si a,” a ti a. Tichuan, Mosia thu ang chuan an ti ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Lalpan Arona chu a bia a,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nang emaw, i fapate emaw pawhin inbiakna puan in chhûnga in kal laiin uain leh zu rêng rêng in suh u; chuti lo chuan, in thi ang. Chu chu in thlahte zêl thlenga kumkhaw dân tûr a ni ang a;
  </para>
  <para style="p">
    <verse number="10" style="v" />chu chu a thianghlim leh a thianghlim lo leh, a thiang leh a thiang lo in thlei theihna tûr leh,
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpan Mosia hmanga an hnêna a sawi, thupêk zawng zawngte chu Israela thlahte in zirtîr theih nân a ni ang,” tiin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Mosian Arona hnênah leh a fapa la dam Eleazara leh Ithamara-te hnênah chuan, “ Lalpa tâna meia thilhlana mi, chhangphut thilhlan lâk bângte chu la ula, maichâm bulah dawidim tel lovin ei rawh u; thil thianghlim a ni si a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa tâna meia thilhlana i pual leh i fapate pual a nih avângin hmun thianghlimah in ei tûr a ni; chutianga thu pêk chu ka ni e.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ir thên leh a bawp ding lam thên chu hmun faiah in ei tûr a ni, nang leh i fapate leh i fanuteho nên; Israela thlahte remna thilhlan inthawinaa i pual leh i fapate puala ruat a ni si a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bawp thên leh ir thên chu Lalpa hmaa thên thilhlana thên tûrin, meia thilhlan thau nên an rawn keng tûr a ni a. Chu chu nang leh i fapate nên, kumkhuaa in pual tûr a ni ang, Lalpa thupêk ang khân,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Mosia chuan sual thawina kêl chu ngun takin a zawng a; tin, ngai teh, an lo hâl tawh reng a. Tichuan, Arona fapa la dam, Eleazara leh Ithamara-te chungah chuan a thinur a,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Engati nge sual thawina chu hmun thianghlimah in ei loh? Thil thianghlim, mipuiho khawlohna phur tûra Lalpa hmaa remna siamsakna tûra a pêk che u a ni si a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai teh u, a thisen chu hmun thianghlimah in la lût hlei nêm; thu ka pêk ang khân hmun thianghlimah chuan in ei ngei ngei tûr a ni asin,” tiin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Arona chuan Mosia hnênah, “Ngai teh, vawiinah hian Lalpa hmaah an sual thawina leh an hâlral thilhlan chu an hlân a ni a; hetiang thil hi ka chungah a lo awm ta mai si a! Vawiinah hian sual thawina chu lo ei ta ila, Lalpa ngaiha thil tih âwm a lo ni dâwn maw?” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Mosian chu chu a hriatin a lungawi ta a.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia leh Arona a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte chu bia ula, ‘Lei chunga sa zawng zawng zînga nungcha in ei tûrte chu hêng hi a ni:
  </para>
  <para style="p">
    <verse number="3" style="v" />sa zînga a tin kâka, tin kâk chhuak, chaw ṭhial nawn chi tawh phawt chu in ei thei ang a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaherawhchu, chaw ṭhial nawn chi emaw, tin kâk chhuak emaw zînga mi hêngte hi chu in ei tûr a ni lo: sanghâwngsei, chaw chu ṭhial nawn mah sela, a tin a kâk loh avângin, in tân a bawlhhlawh a ni;
  </para>
  <para style="p">
    <verse number="5" style="v" />tin, sazupui, chaw chu a ṭhial nawn na a, a tin a kâk loh avângin, in tân a bawlhhlawh a ni;
  </para>
  <para style="p">
    <verse number="6" style="v" />tin, zupui, chaw chu a ṭhial nawn na a, a tin a kâk loh avângin, in tân a bawlhhlawh a ni;
  </para>
  <para style="p">
    <verse number="7" style="v" />tin, vawk, a tin chu a kâk a, a kâk chhuak na a, chaw a ṭhial nawn loh avângin, in tân a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />An sa in ei tûr a ni lo va, an ruang pawh in khawih tûr a ni lo; in tân a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuia chêng zawng zawngah hêngte hi in ei thei ang: tuifinriat leh lui leh tuia awm, pângparh leh phuhlip nei tawh phawt chu in ei thei ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuia chêng zawng zawngte leh tuia nungcha awm zawng zawng zînga tuifinriata mi te, luia mi te, pângparh leh phuhlip nei lo apiangte chu in tâna thil tenawm a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />In tân thil tenawm a ni ang; an sa in ei tûr a ni lo va, an ruangte chu thil tenawmah in neih tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuia mi, pângparh leh phuhlip nei lo tawh phawt chu in tân thil tenawm a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, sava zînga mi chu hêng hi thil tenawma in neih tûr a ni; ei loh tûr a ni a, thil tenawm an ni: mupui te, lungdûp te, muârla te,
  </para>
  <para style="p">
    <verse number="14" style="v" />mutê te, ngawihûp chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="15" style="v" />choâk chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="16" style="v" />sava sâng te, vabak te, tuifinriat sava te, mu chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="17" style="v" />hrângkir te, luidung mû te, chingpirinu te,
  </para>
  <para style="p">
    <verse number="18" style="v" />chhimbuk sialki nei te, tuivalawng te, mulukawlh te,
  </para>
  <para style="p">
    <verse number="19" style="v" />kânghlai te, dîl sava chi rêng rêng te, chhuangtuar leh bâk te.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thla nei, ke palia kal chi zawng zawng chu in tân thil tenawm a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amaherawhchu, thla nei, ke palia kal chi pawh lei chunga perh nâna an keṭang chung lama bawp nei zawng zawng zînga mi hêngte hi in ei thei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hêngte pawh hi in ei thei ang: khaukhuap chi rêng rêng te, khauêkṭhingṭial chi rêng rêng te, perhpâwng chi rêng rêng leh khau chi rêng rêng te.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaherawhchu, thla nei, ke pali nei, a kala kal chi zawng zawng chu in tân thil tenawm a ni vek ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, hêng avângte hian bawlhhlawh in lo kai ang; tu pawh, hêng sa ruang khawih apiang chu tlai lam thlengin an bawlhhlawh ang a;
  </para>
  <para style="p">
    <verse number="25" style="v" />tin, tu pawh hêng ruang latu apiangte hian an puante an su tûr a ni a, tlai lam thlengin an bawlhhlawh ang:
  </para>
  <para style="p">
    <verse number="26" style="v" />ran a tin kâka, tin kâk chhuak lo, chaw pawh ṭhial nawn lo chi zawng zawng chu in tân thil bawlhhlawh a ni a; tu pawh chûng khawih apiang chu an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, fuliafa zawng zawng zînga ke bâwra kal apiangte chu in tân thil bawlhhlawh a ni a; an ruang khawih apiang chu tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, an ruang latu apiang chuan an puante an su tûr a ni a, tlai lam thlengin an bawlhhlawh ang. In tân thil bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, leia a bawha bawkvâk chi zînga in tâna thil bawlhhlawh chu hêngte hi a ni: bui te, chaichîm te, tangkeu chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="30" style="v" />chawkê te, tangkâwng te, laitel te, kâwlchawr te, laikîng te.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hêng hi a bawha bawkvâk chi zawng zawng zînga in tâna thil bawlhhlawhte chu an ni. Tu pawhin hêng thi hnute hi an khawih chuan tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, an thiha eng pawh an delh chu a bawlhhlawh zêl ang; hmanraw hman tawh phawt chu thing bungbêl emaw, puan emaw, savun emaw, saiip emaw pawh ni sela, tuiah chiah tûr a ni. Tin, tlai lam thlengin a bawlhhlawh ang; chumi zawhah chuan a thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hlum bêl, a enga pawh a tlâkna apiang chu in tikeh zêl tûr a ni; a chhûnga awm zawng zawng chu a bawlhhlawh a ni:
  </para>
  <para style="p">
    <verse number="34" style="v" />chumi bêla ei mi awm zawng zawng pawh, chumia awm tuia chiah tawh rêng rêng chu thil bawlhhlawh a ni ang; tin, in mi, in theih chi zawng zawng pawh, chumi bêla mi rêng rêng chu thil bawlhhlawh a ni ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, thil eng pawh an ruang a eng lai pawhin a delh tawh phawt chu thil bawlhhlawh a ni zêl ang; chhang urna emaw, ur lumna bêl emaw pawh tihkeh vek tûr a ni; a bawlhhlawh tawh a, in tân thil bawlhhlawh a ni ang.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amaherawhchu, tuikhur emaw, tuizêm, tui tling khâwm emaw chu a bawlhhlawh lo vang a, an ruang khawih apiang erawh chu a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, chi, chîn tûr rêng rêng chu an ruang a eng lai pawhin lo delh ta ang sela, a bawlhhlawh lo va.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amaherawhchu, chi, tuia chiah hnu chu an ruang a eng lai pawhin delh sela, in tân thil bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ran in ei theih chi rêng rêng eng pawh thi sela, a ruang khawih apiang chu tlai lam thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="40" style="v" />A sa ei apiang chuan a puante a su tûr a ni a, tlai lam thlengin a bawlhhlawh ang. A ruang latu pawhin a puante a su tûr a ni a, tlai lam thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tin, rannung lei chunga a bawha bawkvâk chi zawng zawng chu thil tenawm an ni a; ei tûr an ni lo.
  </para>
  <para style="p">
    <verse number="42" style="v" />A tlenga tleng chi leh ke palia kal chi emaw, ke tam tak nei chi emaw, lei chunga a bawha bawkvâk chi rêng rêng chu in ei tûr a ni lo, thil tenawm an ni si a.
  </para>
  <para style="p">
    <verse number="43" style="v" />A bawha bawkvâk chi rêng rêngin in intitenawm tûr a ni lo va; in bawlhhlawh phahna tûrin, chûng chuan in intibawlhhlawh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kei hi Lalpa in Pathian ka ni si a; chuvângin, intithianghlim ula, thianghlimin awm rawh u; kei ka thianghlim si a. Lei chunga chêng, a vaha vâk, a eng ang chi mahin intibawlhhlawh suh u.
  </para>
  <para style="p">
    <verse number="45" style="v" />In Pathian ni tûra Aigupta ram ata hruai chhuak chhotu che u Lalpa chu ka ni si a. Kei ka thianghlim si a; chuvângin, nangni pawh in thianghlim tûr a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hei hi sa leh savate leh nungcha, tuia chêng chi tinrêng leh, leia a bawha bawkvâk chi tinrêngte chungchâng thûa dân tûr chu a ni,
  </para>
  <para style="p">
    <verse number="47" style="v" />thianghlim leh thianghlim lo thleina tûr leh, nungcha ei theih mi leh nungcha ei theih loh mi thleina tûrin,’ ti rawh u,” tiin.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte hnênah, ‘Hmeichhiain nau a paia, fapa a hrin chuan ni sarih a bawlhhlawh ang a; hmeichhe dân pângngai hun laia a bawlhhlawh angin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, a ni riat niin naute serh hmâwr vun tan tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thisen avânga inthianin ni sawmthum leh ni thum a la awm cheu tûr a ni; a inthen ni a kim hma loh chuan thil thianghlim rêng rêng a khawih tûr a ni lo va, hmun thianghlimah pawh a lût tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmeichhia a hrin erawh chuan, hmeichhe dân pângngai hun laia a bawlhhlawh angin chawlhkâr hnih a bawlhhlawh ang; tin, thisen avânga inthianin ni sawmruk leh ni ruk a la awm cheu tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, fapa emaw, fanu emaw avânga a inthenna ni a kim veleh, hâlral thilhlanah berâmno kum khat mi leh sual thawi nân pârvano emaw, ṭhuro emaw inbiakna puan in kawngka bulah puithiam hnênah a rawn keng tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, anin Lalpa hmaah a hlân ang a, inremna a siamsak ang a; tichuan, a thisen chhuahna ata tihthianghlim a ni ang. Hei hi mipa emaw, hmeichhia emaw hringtu tâna dân a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, a neihin berâmno a tlin loh chuan ṭhuro tuak khat emaw, pârvano tuak khat emaw a keng tûr a ni: pakhat chu hâlral thilhlanah, pakhat chu sual thawi nân. Chutiang chuan puithiamin inremna a siamsak ang a; tichuan, a thianghlim tawh ang,’ tiin sawi rawh,” tiin.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia leh Arona a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mi a tisa vun a vûn emaw, a khir emaw, a bawl emaw, a vuna phâr hri ni âwma a lan chuan puithiam Arona hnênah emaw, a fapa, puithiamte zînga tu ber emaw hnênah hruai tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, puithiam chuan tisa vuna hri chu a lo en ang a; tin, a hri awmna laia hmul chu a lo vâra, a hri chu a tisa vun aia thûka a lan chuan phâr hri a ni a. Tin, puithiam chuan amah chu a lo en ang a, mi bawlhhlawh a nih a puang tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tisa vuna bawlte chu a lo vâra, vun aia thûka a lan lohva, a hmul chu a vâr loh chuan hri veitu chu puithiamin ni sarih a khung hrang ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, puithiam chuan ni sarih ni chuan amah chu a en ang a; tin, ngai teh, a hri chu a ngai renga a hmuha, a hri chu a ṭai darh loh chuan puithiam chuan ni sarih vêk a khung hrang leh ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, puithiam chuan ni sarih ni chuan a en leh ang a; tin, ngai teh, hri chu a lo thîma, hri chu a vuna a ṭai darh loh chuan puithiam chuan a thianghlim tih a puang tûr a ni; khir mai a ni a, a puante a su ang a, a lo thianghlim ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaherawhchu, a thianna tûra puithiam a inentîr hnua a khir chu a vuna a ṭai darh zau chuan, puithiam a inentîr leh tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, puithiam chuan a lo en ang a; tin, ngai teh, a khir chu a vuna a ṭai darh chuan puithiam chuan a bawlhhlawh tih a puang ang. Phâr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Phâr hri miin a vawn chuan puithiam hnênah hruai tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, puithiamin a lo en ang a; tin, ngai teh, vuna a vâra a lo vûn chhuaha, a hmul a tihvâra, a vûng chu a lâwn chuan,
  </para>
  <para style="p">
    <verse number="11" style="v" />phâr benvawn a tisaah a awm a ni a. Puithiamin a bawlhhlawh tih a puang ang a, khung hran tûr a ni lo, bawlhhlawh a ni si a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, a phâr chu vuna a ṭai darh zauva, a hri veitu chu a vun, a lû aṭanga a ke lêr thlenga puithiam hriat theih chin phârin a bawm chuan,
  </para>
  <para style="p">
    <verse number="13" style="v" />puithiam chuan a en ang a; tin, ngai teh, phârin a tisa zawng zawng a bawm chhuah tawh chuan hri veitu chu a thiang tih a puang tûr a ni. A vâr zo tawh a, a thianghlim tawh a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaherawhchu, a tisa a lo lâwn chuan a lo bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puithiam chuan a tisa lâwng chu a lo en ang a, a bawlhhlawh tih a puang tûr a ni; tisa lâwng chu a bawlhhlawh a ni. Phâr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaherawhchu, tisa lâwng chu a lo danglam leha, a lo vâr leh chuan puithiam hnênah a kal ang a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, puithiamin a lo en ang a; tin, ngai teh, a hri chu a lo vâr chuan puithiam chuan hri veitu chu a bawlhhlawh lo tih a puang tûr a ni. A thianghlim tawh a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, tisa vun a lo khawihlia, a lo dama,
  </para>
  <para style="p">
    <verse number="19" style="v" />a khawihlina hmuna a lo vâr pâwn emaw, vâr sen deuhva a lo bawl emaw chuan puithiam entîr tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, puithiam chuan a lo en ang a; tin, ngai teh, vun aia thûka a lana, a hmul chu a lo vâr chuan puithiamin a bawlhhlawh tih a puang tûr a ni. Phâr hri a ni a, khawihliah a lo piang chhuak a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amaherawhchu, puithiamin a lo ena, hmul vâr a awm lohva, vun aia a thûk lohva, a thîm deuh chauh a nih chuan, puithiamin ni sarih a khung hrang ang a;
  </para>
  <para style="p">
    <verse number="22" style="v" />tin, vuna a ṭai darh chuan puithiamin a bawlhhlawh tih a puang tûr a ni. Hri a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaherawhchu, a bawl vâr chu a awmna ngaia a awma, a ṭai darh loh chuan khawihli ser mai a ni a; puithiamin a thianghlim tih a puang tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, tisa vun a kana, a kâng lâwng chu vâr sen deuh emaw, a vâr emawa a lo bawl chhuah chuan,
  </para>
  <para style="p">
    <verse number="25" style="v" />puithiamin a lo en ang a; tin, ngai teh, a bawl lai taka hmul chu a vâra, vun aia thûka a lan chuan phâr a ni a, kângah chuan a lo piang chhuak a ni. Tichuan, puithiamin a bawlhhlawh tih a puang tûr a ni. Phâr hri a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amaherawhchu, puithiamin a lo ena, tin, ngai teh, a lo bawla, a hmul vâr a awm lohva, vun aia thûk lova thîm deuh chauh a nih chuan puithiamin ni sarih a khung hrang ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, puithiamin ni sarih nîah amah chu a en ang a, vuna a ṭai darh zau chuan puithiamin a bawlhhlawh tih a puang tûr a ni. Phâr hri a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, a bawl chu a awmna ngaia a awm renga, vuna a ṭai darh lohva, thîm deuh chauh a nih chuan mei kan pâwn mai a ni a, puithiamin a thianghlim tih a puang tûr a ni; kâng ser mai a ni si a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, hmeichhia emaw, mipa emawin a lûah emaw, a khabe hmul laiah emaw hri a vei chuan,
  </para>
  <para style="p">
    <verse number="30" style="v" />puithiamin hri chu a lo en ang a; tin, ngai teh, vun aia thûka a lana, hmul eng sîn tak a awm chuan puithiamin a bawlhhlawh tih a puang tûr a ni; pupangliah a ni a, lû leh khabe hmul phâr a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, puithiamin pupangliah hri chu a ena, vun aia thûk lova a lana, a hmul dum a awm loh chuan puithiamin pupangliah hri veitu chu ni sarih a khung hrang ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, ni sarih nîah puithiamin hri chu a en ang a; tin, ngai teh, pupangliah chu a ṭai darh lohva, hmul eng a awm lohva, pupangliah chu vun aia thûka a lan loh chuan,
  </para>
  <para style="p">
    <verse number="33" style="v" />meh tûr a ni a, pupangliah lai erawh chu a mêt tûr a ni lo. Tin, puithiamin pupangliaha chu ni sarih dang a khung hrang leh ang a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, ni sarih ni chuan puithiamin pupangliah chu a en leh ang a; tin, ngai teh, pupangliah chu a vuna a darh lohva, vun aia thûka a lan loh chuan puithiamin a thianghlim tih a puang tûr a ni; tin, a puante a su ang a, a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amaherawhchu, pupangliah chu a inthen fai hnua vuna a ṭai darh zau chuan,
  </para>
  <para style="p">
    <verse number="36" style="v" />puithiamin amah chu a lo en ang a; tin, ngai teh, pupangliah chu vuna a ṭai darh chuan, puithiam tân chuan hmul eng chu zawn a ngai kher lo vang; a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amaherawhchu, pupangliah chu a ngai renga a hmuha, hmul dum a ṭo chuan pupangliah chu a dam a ni a, a thianghlim a ni; puithiamin a thianghlim tih a puang tûr a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tin, hmeichhia emaw, mipa emaw, an tisa vunah bawl, bawl vâr tak a awm chuan,
  </para>
  <para style="p">
    <verse number="39" style="v" />puithiamin a en ang a; tin, ngai teh, an tisa vuna bawl chu a vâr thîm deuh chauh a nih chuan bawl mai a ni a, vuna lo piang a ni a; a thianghlim a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mi a sam a tlâk kawlh chuan lukawlh a ni a; nimahsela, a thianghlim a ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />A chhîp sam a tlâk kawlh chuan chalkawlh a ni a; nimahsela, a thianghlim a ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amaherawhchu, lukawlhah emaw, chalkawlhah emaw, hri sen deuhva vâr a awm chuan, a lukawlh emaw, a chalkawlh emawa lo piang phâr a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tichuan, puithiamin a lo en ang a; tin, ngai teh, a lukawlh emaw, a chalkawlh emawa hri lo pâwng chhuak chu a sen vâr hiara, tisa vuna phâr anga a lan chuan,
  </para>
  <para style="p">
    <verse number="44" style="v" />mi phâr a ni a, a bawlhhlawh a ni. Puithiamin a bawlhhlawh tih a puang ngei ngei tûr a ni; a phârna chu a lûah a ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />Phâr hri vei chu a puante pawh thlêr a ni ang a, a sam a thlah ang a, a hmui chung lam a tuam ang a, ‘Ka bawlhhlawh e! Ka bawlhhlawh e!’ tiin a au tûr a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Phârin a bawm chhûng chu bawlhhlawh a ni ang a; a bawlhhlawh a, amahin a awm hrang tûr a ni; a awmna tûr chu daipâwn a ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />Silhfên pawh, sahmul silhfên emaw, la zai sîn silhfên emaw pawh, tah emaw, phiar emaw pawh, la zai sîn emaw, sahmul emaw pawh, savun emaw, eng pawh savuna siamah emaw phâr hri a awma,
  </para>
  <para style="p">
    <verse number="49" style="v" />chu hri chu silhfênah emaw, savunah emaw, tahah emaw, phiarah emaw, eng pawh savuna siamah emaw a hring deuh emaw, a sen deuh emawa a lo lan chhuah chuan, phâr hri a ni a, puithiam entîr tûr a ni.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tin, puithiamin hri chu a lo en ang a, hri kaina chu ni sarih a khung hrang ang.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tin, ni sarih nîah hri chu a en ang a, hri chu silhfên, tahah emaw, phiarah emaw, eng atân pawha an hman savunahte emaw a ṭai chuan hri chu phâr nghet tak chi a ni a; a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="52" style="v" />Silhfên chu, tah emaw, phiar emaw, sahmul emaw, la zai sîn emaw, savuna siam chi rêng rêng emaw, phâr awmna tawh phawt chu a hâl tûr a ni, phâr nghet tak chi a ni si a; hâl ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tin, puithiamin a lo ena, silhfên, tah emaw, phiar emaw, savuna siam chi rêng rêng pawha hri chu a ṭai loh chuan,
  </para>
  <para style="p">
    <verse number="54" style="v" />hri awmna chu puithiamin sûk thu a pe ang a, ni sarih dang a khung hrang leh ang.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tin, hri awmna sûk hnu chuan puithiamin a en leh ang a; tin, ngai teh, hri lan dân chu a danglam loh chuan hri chu ṭai lo mah sela, a thianghlim chuang lo va, i hâl tûr a ni; a nghet chi a ni, a chhûng lam emaw, a pâwn lam emawa kawlh pawh ni rawh se.
  </para>
  <para style="p">
    <verse number="56" style="v" />Tin, puithiamin a lo ena, sûk hnua thîm deuh chauh a nih chuan silhfên ata emaw, savun ata emaw, tah ata emaw, phiar ata emaw chu a pawt thla ang.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tin, hri chu silhfên tahah emaw, phiarah emaw, savuna siamahte emaw a la lan cheu chuan, a lo chhuak leh a ni a; hri awmna chu i hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tin, silhfên chu tah emaw, phiar emaw, eng pawh savuna siam chi rêng rêng emaw i sûka, hriin a kiansan chuan sûk leh tûr a ni a; tichuan, a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="59" style="v" />Hei hi silhfên, sahmul emaw, la zai sîn emaw, tah emaw, phiar emaw, savuna siam chi rêng rêngte emawa phâr hri awm, a thianghlim leh a thianghlim loh puan dân tûr chu a ni,” tiin.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hei hi phâr inthen nia a tih dân tûr a ni ang: puithiam hnênah hruai tûr a ni a;
  </para>
  <para style="p">
    <verse number="3" style="v" />tin, puithiam chu daipâwnah a kal chhuak ang a; tin, puithiam chuan a en ang a; tin, ngai teh, phâr chu a phârna hri a dam chuan,
  </para>
  <para style="p">
    <verse number="4" style="v" />puithiam chuan a inthian tûra chu sava nung thiang pahnih leh, sidar thing leh la zai sen leh husop kensak tûrin thu a pe ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, puithiam chuan sava pakhat chu hlum bêlah lui tui chungah talh tûrin thu a pe ang a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sava nung chu sidar thing te, la zai sen te, husop te nên chuan a keng ang a, lui tui chunga sava talh thisenah chuan a hnim vek ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, phârna laka inthian tûra chu vawi sarih a theh ang a, a thianghlim tih a puang ang a; tin, sava nung chu ramah a chhuah ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, a inthian tûra chuan a puante a su ang a, a inmêt kâwng vek ang a, a inbual tûr a ni; tichuan, a lo thianghlim ang. Chumi zawhah chuan riahhmunah a kal ang a; amaherawhchu, a puan in pâwn lamah ni sarih a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, heti hi a ni ang a, a ni sarih ni chuan a sam zawng zawng leh a khabe hmul leh a mit ko hmulte a mêt kâwng ang a, a hmul zawng zawng a mêt kâwng ang; tin, a puante a su ang a, a inbual tûr a ni; tichuan, a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, ni riat ni chuan berâmno a pa pahnih sawisêl bo leh berâmno a nu pakhat sawisêl bo, kum khat mi leh chhangphut thilhlan atân chhangphut dip tak, epha hmun sâwma ṭhena hmun thum hriaka hmeh leh hriak log khat a keng tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, a thiantu puithiam chuan inthian tûra leh chûng thil chu, inbiakna puan in kawngka bulah Lalpa hmaah a dah ang a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, puithiam chuan berâmno pakhat chu hriak log khat nên chuan a la ang a, bawhchhiat thawi nân a hlân ang a, Lalpa hmaa thên thilhlan atân thên tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, sual thawina leh hâlral thilhlan an talh ṭhinna hmun, hmun thianghlimah chuan berâmno a pa chu a talh tûr a ni; sual thawina chu puithiam pual a ni ang bawkin, bawhchhiat thawina pawh chu puithiam pual a ni si a; thil thianghlim tak a ni e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Puithiam chuan bawhchhiat thawina thisen chu a la ang a, inthian tûra beng ding lam hmâwrah te, a kut ding lam zungpuiah te, a ke ding lam zungpuiah te a hnawih ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, hriak log khata mi chu puithiam chuan a la ang a, ama vei lam kutphahah a chhûng ang a;
  </para>
  <para style="p">
    <verse number="16" style="v" />puithiam chuan a kut vei lama hriakah chuan a zungṭang ding lam a hnim ang a, hriak chu Lalpa hmaah a kut zungṭangin vawi sarih a theh ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, a kuta hriak la awm zawng chuan inthian tûra beng ding lam hmâwr te, a kut ding lam zungpui te, a ke ding lam zungpuitea bawhchhiat thawina thisen chungah te chuan a hnawih ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Puithiam chuan a kuta hriak la awm zawng chuan inthian tûra lû a hnawih ang a; tin, puithiam chuan Lalpa hmaah inremna a siamsak tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, puithiam chuan sual thawina chu a hlân ang a, a thianghlim lohna avânga inthian tûra chu inremna a siamsak ang a; tin, chumi zawhah chuan hâlral thilhlan chu a talh ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, puithiam chuan hâlral thilhlan leh chhangphut thilhlan chu maichâmah chuan a hlân ang a, puithiam chuan inremna a siamsak ang a; tichuan, a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, mi rethei a niha, chutiang chu a tlin loh chuan, berâmno a pa pakhat bawhchhiat thawina, inremna siamsak nâna thên tûr leh, chhangphut thilhlan atân chhangphut dip tak epha hmun sâwma ṭhena hmun khat, hriaka chawhpawlh, hriak log khat nên a keng ang a;
  </para>
  <para style="p">
    <verse number="22" style="v" />tin, ṭhuro tuak khat emaw, pârvano tuak khat emaw, a neih theih zâwk zâwk apiang; pakhat chu sual thawina, pakhat chu hâlral thilhlanah a ni ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ni riat nîah a inthen nân puithiam hnênah, inbiakna puan in kawngka bulah Lalpa hmaah a rawn keng tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tichuan, puithiamin bawhchhiat thawina berâmno leh hriak log khat chu a la ang a; tin, thên thilhlanah Lalpa hmaah puithiam chuan a thên ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, bawhchhiat thawina berâmno chu a talh ang a; puithiam chuan bawhchhiat thawina thisen chu a la ang a, inthian tûra beng ding lam hmâwrah te, a kut ding lam zungpuiah te, a ke ding lam zungpuiah te a hnawih ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, puithiam chuan hriak chu ama kutphah vei lamah a bun ang a;
  </para>
  <para style="p">
    <verse number="27" style="v" />tin, puithiam chuan a kut vei lama hriak ṭhenkhat chu a kut ding lamin Lalpa hmaah vawi sarih a theh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, puithiam chuan a kuta hriak chuan inthian tûra beng ding lam hmâwr te, a kut ding lam zungpui te, a ke ding lam zungpuitea bawhchhiat thawina thisen chung takahte chuan a hnawih ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Puithiam kuta hriak la awm zawngte chuan, Lalpa hmaa inremna siamsak tûrin, inthian tûra lû chu a thih tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, ṭhuro emaw, pârvano emaw, a neih theih zâwk zâwk apianga pakhat chu a hlân ang a;
  </para>
  <para style="p">
    <verse number="31" style="v" />a neih theih zâwk zâwk apiang, sual thawi nân pakhat, hâlral thilhlanah pakhat, chhangphut thilhlan nên. Chutiang chuan puithiam chuan inthian tûra chu Lalpa hmaah inremna a siamsak ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hei hi phâr hri vei, inthenna dân ang tlin lote tâna dân a ni,” tiin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Lalpan Mosia leh Arona a bia a,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Luah tûra ka pêk che u Kanaan ram in luh huna, in luah tûr ram khawii inah pawh phâr hri ka dah chuan,
  </para>
  <para style="p">
    <verse number="35" style="v" />chumi in neitu chuan, ‘He inah hian hri ni âwm tak awm âwmin ka hria,’ tiin puithiam a hrilh tûr a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tin, puithiam chu hri en tûra a luh hma chuan, in chhûnga thil awm zawng zawng chu bawlhhlawha a chan loh nân, in chu tihruah tûrin puithiam chuan thu a pe ang a; chumi zawh chuan puithiam chu in en tûr chuan a lût ang.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, hri chu a en ang a; tin, ngai teh, hri chuan a hring lam deuh emaw, a sen lam deuh emawa bang a ei khuar tawha, bang aia phaia a lan chuan,
  </para>
  <para style="p">
    <verse number="38" style="v" />puithiam chu in ata kawngkaah a chhuak ang a, in chu ni sarih a khâr ang.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, ni sarih nîah puithiam chuan a va en leh ang a; tin, ngai teh, hri chu banga a lo ṭai chuan,
  </para>
  <para style="p">
    <verse number="40" style="v" />hri awmna lung chu lâk chhuaha, daipâwnah hmun bawlhhlawha paih tûrin puithiam chuan thu a pe ang.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tin, in chhûng lam chu a ziah vêltîr ang a; tin, lung chârna an ziah khawh chu daipâwnah hmun bawlhhlawhah an chhûng ang.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tin, lung dang an la ang a, chûng lung hmunahte chuan an dah ang; tin, lung chârna dang an la ang a, in chu a bel ang.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tin, lung a lâk chhuaha, in chu a ziaha, a bel zawh hnua hri chu ina a lo chhuah leh chuan,
  </para>
  <para style="p">
    <verse number="44" style="v" />puithiam chu a va lût ang a, a va en leh ang; tin, ngai teh, hri chu ina a lo ṭai chuan chu ina phâr chu a nghet chi a ni a; in chu a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />In chu a ṭhiat ang a, a lung te, a thing te, a lung chârna zawng zawngte pawh; tin, daipâwnah hmun bawlhhlawhah a thiar chhuak ang.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tu pawh chu in khâr chhûnga lût rêng rêng chu tlai lam thlengin an bawlhhlawh bawk ang.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tin, tu pawh chumi ina mu apiangte chuan an puante an su ang a; tin, tu pawh chu ina chaw ei apiangte chuan an puante an su tûr a ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tin, puithiam chu a luha, a han en vêla, in chu bel ṭhat a nih hnua hri chu a ṭai loh chuan, in chu a thianghlim tih puithiamin a puang ang, hri chu a kian tawh avângin.
  </para>
  <para style="p">
    <verse number="49" style="v" />In thenna tûr chuan sava pahnih leh sidar thing leh la zai sen leh husop a keng ang.
  </para>
  <para style="p">
    <verse number="50" style="v" />Sava pakhat chu hlum bêlah lui tui chungah a talh ang a;
  </para>
  <para style="p">
    <verse number="51" style="v" />tin, sidar thing leh husop leh la zai sen leh sava nung chu a la ang a, sava talh tâk thisenah leh lui tuiah chuan a hnim ang a, in chu vawi sarih a theh ang.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tin, in chu sava thisen te, lui tui te, sava nung te, sidar thing te, husop te, la zai sente chuan a thian ang.
  </para>
  <para style="p">
    <verse number="53" style="v" />Sava nung erawh kha chu khua aṭangin ramah a thlawh chhuahtîr tûr a ni. Chutiang chuan in tân chuan inremna a siam ang a; tichuan, a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hei hi phâr hri chi tinrêng leh pupangliah chungchânga dân chu a ni;
  </para>
  <para style="p">
    <verse number="55" style="v" />puana phâr awm leh ina mite,
  </para>
  <para style="p">
    <verse number="56" style="v" />pâwng te, khir te, bawl chungchângahte pawh,
  </para>
  <para style="p">
    <verse number="57" style="v" />a thianghlim loh lai leh a thianghlim lai kawhhmuhna tûrin hei hi phâr chungchânga dân chu a ni,” tiin.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan Mosia leh Arona a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte chu bia ula, an hnênah, ‘Mipa tu pawh a tisaah thil a puh chuan a thil pût avâng chuan a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A thil puh chhûng zawng chu a bawlhhlawh a ni: a tisaah chuan a pût reng emaw, a pût chu dan emaw pawh ni sela, a bawlhhlawh tho a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thil pûta mutna khum tawh phawt chu a bawlhhlawh ang a, a ṭhutna tawh phawt chu a bawlhhlawh bawk ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, tu pawh a khum khawih apiangte chuan an puante an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thil pûta ṭhutnaa ṭhu apiangte chuan an puante an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu pawh thil pûta tisa chu khawih apiangte chuan an puante an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thil pûta chuan mi bawlhhlawh lo chil a chhâk chuan, a puante a su ang a, a inbual tûr a ni a, tlai lam thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuanna eng pawh thil pûta chuanna chu a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tu pawh a innghahna hnu thil khawih apiangte chu tlai lam thlengin an bawlhhlawh ang. Chûng thil chawi sawntu apiangte chuan an puante an su ang a, an inbual tûr a ni; tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, tu pawh, thil pûta chuan a kut tleuh lova a khawih apiangte chuan an puante an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thil pûta hlumbêl khawih hnu chu tihkeh tûr a ni; tin, thing bungbêl zawng zawng chu tleuh fai vek tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, thil pûta chu, a thil pût tihthianghlim a nih chuan a inthen nân ni sarih a intuk ang a, a puante a su ang a, lui tuiah a inbual ang a; tichuan, a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ni riat ni chuan ṭhuro tuak khat emaw, pârvano tuak khat emaw kengin Lalpa hmaah inbiakna puan in kawngka bulah a kal ang a, puithiam a pe tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puithiam chuan sual thawi nân pakhat, hâlral thilhlanah pakhat a hlân tûr a ni; chutiang chuan puithiam chuan a thil pût thûah Lalpa hmaah inremna a siamsak ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tu pawh inpâwlna chi amah aṭanga a chhuah chuan a pumin a inbual vek tûr a ni a, tlai lam thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, silhfên te, savun te, inpâwlna chi awmna tawh phawt chu, sûk faia sil fai vek tûr a ni a, tlai lam thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, hmeichhia a mutpui pawhin an pahnihin an inbual ve ve tûr a ni a; tin, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmeichhiain thil pût a neiha, a taksa aṭanga thil pût chu thi a nih chuan, ni sarih chhûng chu a bawlhhlawh ang; tin, tu pawh amah khawih apiang chu tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />A bawlhhlawh chhûnga a mutna tawh phawt chu a bawlhhlawh ang a, a ṭhutna tawh phawt pawh a bawlhhlawh bawk ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tu pawh a khum khawih apiangte chuan an puante an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tu pawh a ṭhutna khawih apiangte chuan an puante an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khuma thil awm emaw, a ṭhutnaa thil awm emaw khawih apiangte chu tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tu pawhin an mutpuia, a bawlhhlawhna chu an kai chuan ni sarih an bawlhhlawh ang a; an mutna khum apiang chu a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmeichhia a bawlhhlawh hun pângngai ni lova ni rei fe a thi a puh emaw, a bawlhhlawh dân pângngai aia rei a thi a puh emaw chuan, a bawlhhlawhna dân pângngai chhûnga a awm ṭhin angin, thi pûta a bawlhhlawh chhûng zawng chuan a awm bawk tûr a ni; a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />A thi puh chhûng zawnga a mutna khum tawh phawt chu, a bawlhhlawh dân pângngai hun laia a khum ang a ni ang a; a ṭhutna apiang chu a bawlhhlawh dân pângngai hun laia a bawlhhlawh angin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tu pawh chûng thil khawih apiang chu an bawlhhlawh ang a, an puante an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaherawhchu, a thi pût chu tihthianghlim a nih chuan ni sarih a intuk ang a, chumi hnuah chuan a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, a ni riat nîah ṭhuro tuak khat emaw, pârvano tuak khat emaw a keng ang a, inbiakna puan in kawngka bulah puithiam a pe tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, puithiamin sual thawi nân pakhat, hâlral thilhlanah pakhat a hlân tûr a ni. Chutiang chuan puithiam chuan thi pûta a bawlhhlawhna thûah Lalpa hmaah inremna a siamsak ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hetiang hian Israela thlahte chu an bawlhhlawhna ata chu in tihrang tûr a ni, an zînga ka biak bûk an tihbawrhbân châng pawha an bawlhhlawhna avânga an thih loh nân.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hei hi thil pûtate leh bawlhhlawh phaha inpâwlna chi chhuakate tâna dân chu a ni;
  </para>
  <para style="p">
    <verse number="33" style="v" />an bawlhhlawhna avânga peihsam lo te, a hmei a pa, thil pûtho te, hmeichhia, an bawlhhlawh laia mutpuitute tân pawh,’ ” tiin.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Arona fapate pahnihin Lalpa an va hnaiha an thih phah hnu chuan, Lalpan Mosia a bia a;
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpan Mosia hnênah, “I unau Arona bia la, puanzâr chhûng hmun thianghlimah, bâwm chunga zahngaihna ṭhutphah hmaah chuan eng lai mahin lo lût hauh suh se, a thi dah ang e; zahngaihna ṭhutphah chungah, chhûmah ka rawn inlâr dâwn a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hetiang hian Arona chu hmun thianghlimah a kal tûr a ni: sual thawi nân bâwngtuai, hâlral thilhlanah berâmpa nên.
  </para>
  <para style="p">
    <verse number="4" style="v" />Puan zai sîn kawr thianghlim chu a ha ang a, a tisa khuh nân puan zai sîn kekawr chu a ha ang a, puan zai sîn kâwnghrênin a inhrêng ang a, puan zai sîn diar a khim tûr a ni. Hêng hi silhfên thianghlim a ni a; a inbual tê tê ang a, a inbel tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Israela thlahte mipuiho ta kêlpa pahnih sual thawi nân leh, hâlral thilhlanah berâmpa pakhat a keng ang a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Arona chuan ama puala sual thawina bâwngpa chu a hlân ang a, amah leh a chhûngte tân inremna a siam ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kêl pahnih chu a kai ang a, inbiakna puan in kawngka bulah Lalpa hmaah a dah ang a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Arona chuan kêl pahnih chungchângah chuan ṭhum a vâwr ang a: pakhat chu Lalpa pual a ni ang a, pakhat chu Azazela pual a ni ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Arona chuan Lalpa puala tlu kêl chu a la ang a, sual thawi nân a hlân ang a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Azazela puala tlu kêl erawh chu inremna siamna tûra Azazela tân thlalêra chhuah tûrin, Lalpa hmaah a nungin a dah ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arona chuan ama puala sual thawina bâwngpa chu a la ang a, amah leh a chhûngte tân inremna a siam ang a, ama puala sual thawina bâwngpa chu a talh ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa hmaa maichâm ata mei lâkna meilinga khat a la ang a, rimtui tui tak râwt dip dep ṭhûm khat nên puanzâr chhûng lamah a luhpui ang a;
  </para>
  <para style="p">
    <verse number="13" style="v" />rimtui khu chuan thuhriattîrna chunga zahngaihna ṭhutphah chu a bawhna tûrin, Lalpa hmaa meiah rimtui chu a phul ang, thihna a tawh loh nân.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bâwngpa thisen eng emaw zât chu a la ang a, a kut zungṭangin zahngaihna ṭhutphah chhak lampang chu a theh ang a, a kut zungṭangin zahngaihna ṭhutphah bul chu thisen chuan vawi sarih a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, mipui pual sual thawina kêl chu a talh ang a, a thisen chu puanzâr chhûng lamah a luhpui ang a, a thisen chu bâwngpa thisen a tih ang khân a ti ang a, zahngaihna ṭhutphah leh zahngaihna ṭhutphah bul chu a theh ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israela thlahte bawlhhlawhnate avâng leh an bawhchhiatnate, an sualna zawng zawngte avângin hmun thianghlim pualah inremna a siam ang a; chutiang bawk chuan an bawlhhlawhnate zînga awm, inbiakna puan in pualah pawh a siam bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmun thianghlima inremna siam tûra a luh lai chuan, amah leh a chhûngte leh Israel mipuiho puala inremna a siam zawha a lo chhuah leh hma loh chuan, tu mah rêng rêng inbiakna puan in chhûngah chuan an awm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpa hmaa maichâm lamah chuan a chhuak ang a, chumi pual chuan inremna a siam ang a, bâwngpa thisen leh kêl thisen eng emaw zât chu a la ang a, maichâm kîahte chuan a vêlin a tât ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, a kut zungṭangin vawi sarih a theh ang a, a thian ang a, Israela thlahte bawlhhlawhnate lak ata chu a tithianghlim ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, hmun thianghlim leh inbiakna puan in leh maichâm puala inremna a siam zawh chuan kêl nung chu a hlân ang a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Arona chuan kêl nung lû chungah chuan a kut khinghnih a nghat ang a, a chungah chuan Israela thlahte khawlohna zawng zawng te, an bawhchhiatna zawng zawng te, an sualna zawng zawngte chenin a chham ang a, chûngte chu kêl lû chungah chuan a nghat ang a, mi pakhat an ruat diama khân thlalêr lamah a hruai bo daih ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, kêl chuan an khawlohna zawng zawng chu chên loh leiah a phur ang a, kêl chu thlalêrah chuan a chhuah tûr a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Arona chu inbiakna puan inah chuan a lût ang a, hmun thianghlim a luh laia puan zai sîn silhfên a inbel chu a hlîp ang a, chutah chuan a hnutchhiah ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, hmun thianghlimah a inbual ang a, a silhfên a inbel ang a, a lo chhuak ang a, ama puala hâlral thilhlan leh mipui puala hâlral thilhlan chu a hlân ang a, amah leh mipui tân inremna a siam ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, sual thawina thau chu maichâmah a hâl ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Azazela pual kêl chhuahtu apiang chuan an puan an su ang a, an inbual ang a, chumi zawhah chuan an awm hmun lamah an haw leh tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sual thawina bâwngpa leh sual thawina kêl thisen inremna a siam nâna hmun thianghlima an luhpui chu, daipâwn lama kalpui tûr a ni ang a; a vun te, a sa te, a êk te chu an hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />A hâltu chuan a puan a su ang a, a inbual ang a, chumi zawhah chuan an awm hmun lamah a haw leh tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hei hi in kumkhaw dân tûr a ni ang a: thla sarihna, chumi thla ni sâwm ni chuan in rilrute in tihrehawm ang a, in rama mi rêng emaw, ram dang mi in zînga khawsa emawin hna eng mah an thawk tûr a ni lo:
  </para>
  <para style="p">
    <verse number="30" style="v" />hemi ni hian nangmahni tihthianghlim nân in tân inremna siam a ni dâwn a ni; tichuan, Lalpa hmaah in sualna zawng zawng lak ata in thianghlim ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />In tân chawlh hle hle ni a ni a, in rilrute in tihrehawm ang a; kumkhaw dân tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, puithiam, a pa aia puithiam ni tûra hriak thih tûr leh tihhran tûra chuan inremna a siam ang a; puan zai sîn silhfên, silhfên thianghlim chu a inbel ang a;
  </para>
  <para style="p">
    <verse number="33" style="v" />hmun thianghlim pualah inremna a siam ang a, inbiakna puan in leh maichâm pualah inremna a siam bawk ang a; tin, puithiamte leh mipuiho tân inremna a siam leh bawk ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />An sualna zawng zawngte avânga kum tin vawi khat, Israela thlahte tân inremna siam hi in kumkhaw dân tûr a ni,” a ti a. Tichuan, Lalpan Mosia thu a pêk ang chuan a ti a.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona leh a fapate leh Israela thlahte zawng zawng bia la, an hnênah, ‘Hei hi Lalpa thupêk chu a ni:
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel chhûngkaw zînga mi rêng rêng, bâwngpa emaw, berâmno emaw, kêl emawte riahhmun emaw, daipâwn emawa talha,
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa biak bûk hmaa Lalpa tâna thilhlana inbiakna puan in kawngka bula rawn la lo apiang, chu mi chu thisen chhuaha ngaih a ni ang; thisen chhuah ngei a ni a, chu mi chu a chipuite zîng ata tuithlârin a awm tûr a ni;
  </para>
  <para style="p">
    <verse number="5" style="v" />chu chu Israela thlahten an inthawinate, tâmlaka an inthawinate chu an rawn lâka, Lalpa tân ngeia inbiakna puan in kawngka bulah, puithiam hnênah an rawn lâka, Lalpa tâna remna thilhlan inthawinaa an inthawi theih nân a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, puithiamin inbiakna puan in kawngka bula maichâm chu thisen chuan a theh ang a, a thau chu Lalpa tâna rimtui takah a hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />An uire ṭhinna kêlpa hnênah chuan an inthawi tawh tûr a ni lo, tih hi. Hei hi an thlahte zêl chena an kumkhaw dân tûr a ni,’ tiin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, an hnênah, ‘Israel chhûngkaw zînga mi rêng rêng emaw, ram dang mi an zînga khawsaten emaw hâlral thilhlan emaw, inthawina emaw hlâna,
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa hnêna inthawi tûra inbiakna puan in kawngka bula rawn la lo an awm chuan, chu mi chu a chipuite zîng ata tuithlârin a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, tu pawh Israel chhûngkaw zînga mi emaw, ram dang mi an zînga khawsa emaw, eng thisen pawh ei apiang chu, chu thisen eitu chungah chuan ka hmai ka thuar ang a, a chipuite zîng ata tuithlârin ka awmtîr ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tisa nunna chu thisenah chuan a awm si a; in nunna atâna inremna siamna tûra maichâm chunga ka pêk che u a ni; nunna atâna inremna siamna chu thisen ngei chu a ni si a.’
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuvâng chuan Israela thlahte hnênah, ‘Tu mahin thisen in ei tûr a ni lo va, ram dang mi in zînga khawsate pawhin thisen an ei tûr a ni hek lo,’ ka ti a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Israela thlahte zînga mi emaw, ram dang mi an zînga khawsain emaw ram vâka, sa emaw, sava emaw, ei theih chi a rawn hawn chuan a thisen chu a tichhuak ang a, vaivutin a vûr tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tisa zawng zawng nunna thûah chuan a thisen leh a nunna chu angkhat chiah a ni; chuvângin, Israela thlahte hnênah chuan, ‘Eng sa thisen mah in ei tûr a ni lo, tisa zawng zawng nunna chu a thisen chu a ni si a; tu pawh a ei apiang chu tuithlârin a awm tûr a ni.’
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, amaha thi emaw, sa seh emaw ei apiang chu, chumi rama mi rêng emaw, ram dang mi emaw pawh ni sela, an puan an su ang a, an inbual tûr a ni a, tlai lam thlengin an bawlhhlawh ang a; chumi hnuah chuan an thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />An sûk lohva, an inbual loh phei chuan, an khawlohna mawh chu an phur ang, ka ti a, ti rawh,” tiin.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte chu bia la, an hnênah, ‘Kei hi Lalpa in Pathian chu ka ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />In awm tawhna Aigupta ram mite tih ang kha ti suh ula, ka hruai luhna tûr che u Kanaan ram mite tih ang pawh ti suh ang che u; an dân pawh zâwm bawk hek suh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka rorêlte chu in pawm ang a, ka dânte chu zawhin in zâwm tûr a ni: kei hi Lalpa in Pathian chu ka ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuvângin, ka dân leh ka rorêlte chu in zâwm tûr a ni; chu chu miin a tih chuan a nun phah ang: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu mân in chhûng bulte rêng rêng chu an saruakna hlîm tûrin in pan tûr a ni lo: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />I pa saruakna emaw, i nu saruakna emaw chu i hlîm tûr a ni lo. I nu a ni a, a saruakna i hlîm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />I pa nupui saruakna i hlîm tûr a ni lo; i pa saruakna a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />I farnu, i pa fanu emaw, i nu fanu emaw, i pianpui emaw, i pianpui loh emawte saruakna pawh i hlîm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />I fapaa fanu emaw, i fanua fanu emaw saruakna, an saruakna chu i hlîm tûr a ni lo. An saruakna chu nangma saruakna a ni si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />I pa nupuia fanu, i pa hrin saruakna chu, i farnu a ni a, a saruakna i hlîm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />I pa farnu saruakna chu i hlîm tûr a ni lo; i pa chhûng bul a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />I nu laizâwn saruakna chu i hlîm tûr a ni lo; i nu chhûng bul a ni si a.
  </para>
  <para style="p">
    <verse number="14" style="v" />I pa unau saruakna chu i hlîm tûr a ni lo va. A nupui chu i pan tûr a ni lo, i nu a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />I monu saruakna chu i hlîm tûr a ni lo, i fapaa nupui a ni a, a saruakna i hlîm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />I unaupa nupui saruakna chu i hlîm tûr a ni lo, i unaupa saruakna a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nufa faa saruakna chu i hlîm tûr a ni lo. A saruakna hlîm tûrin a fapaa fanu emaw, a fanua fanu emaw i nei tûr a ni lo; i chhûng bulte an ni a. Suahsualna nasa tak a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />I nupuia laizâwn chu a saruakna hlîm tûrin i nupui la dam chhûng chuan i nei kawp tûr a ni lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, hmeichhia a bawlhhlawh dân pangngaia a bawlhhlawh chhûng chuan, a saruakna hlîm tûrin i pan tûr a ni lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />A laka intibawlhhlawh tûrin i vêng pa nupui i mutpui tûr a ni lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Moleka puala meia tihluh tûrin i rîla rahte rêng rêng i pe tûr a ni lo va, i Pathian hming i tichhe tûr a ni hek lo. Kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmeichhia angin mipa i pâwl tûr a ni lo; thil tenawm a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Intihbawlhhlawhna tûrin ran rêng rêng i pâwl tûr a ni lo va, hmeichhia rêng rêng inpâwltîr tûrin ran hmaah a ding tûr a ni hek lo; suahsualna chungchuang a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hêng thil, a enga mahah hian intibawlhhlawh suh u; hêng thil zawng zawngah hian in hmaa ka hnawh chhuah tâk hnamte chu an lo bawlhhlawh tawh a;
  </para>
  <para style="p">
    <verse number="25" style="v" />ram pawh chu a bawlhhlawh tawh a ni; chuvângin, chuta a khawlohna chu ka hrem a, ram chuan a chhûnga awmte chu a luak chhuak ta vek a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuvângin, nangni chuan ka dân te, ka rorêlte in zâwm tûr a ni a, hêng thil tenawm hi a enga mah in ti tûr a ni lo, in rama mi rêng emaw, ram dang mi in zînga khawsate pawhin
  </para>
  <para style="p">
    <verse number="27" style="v" />(hêng thil tenawm zawng zawng hi in hmaa he rama awmte khân an lo ti tawh a, ram pawh chu a bawlhhlawh tawh a ni);
  </para>
  <para style="p">
    <verse number="28" style="v" />in hmaa awm hnam a law chhuak ang bawka in tihbawlhhlawha ram chuan a luak chhuah ve lohna tûr che uin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tu pawh hêng thil tenawm hi a enga pawh titu apiang chu an chipuite zîng ata tuithlârin an awm ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuvângin, hêng thil tenawm in hmaa an chîn ang hi in chîn ve loh nân leh, chûngah chuan in intihbawlhhlawh loh nân ka thupêk hi in zâwm tûr a ni: kei hi Lalpa in Pathian chu ka ni,’ ti rawh,” tiin.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlah, mipuiho zawng zawng chu bia la, an hnênah, ‘In thianghlim tûr a ni; kei, Lalpa in Pathian hi ka thianghlim si a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi tinin in nu leh in pa in ṭih tûr a ni a; tin, ka Chawlhnite in serh tûr a ni: kei hi Lalpa in Pathian chu ka ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Milem lamah thle suh ula, milem chhûn pathiante insiam hek suh u: kei hi Lalpa in Pathian chu ka ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Lalpa tâna remna thilhlana in inthawi hunin pawm tlâk ni tûrin in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />In hlan ni tak leh a tûka ei tûr a ni a; ni thum ni thlenga awm a awm chuan hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ni thum nia ei a nih vaih chuan thil tenawm a ni a, pawmsak a ni lo vang.
  </para>
  <para style="p">
    <verse number="8" style="v" />A ei apiang chuan, Lalpa thil thianghlim a tihbawrhbân avângin, a khawlohna mawh a phur ang a; chu mi chu a chipuite zîng ata tuithlârin a awm zâwk ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, in lova buh in seng hunin in vau fêmte thlengin in seng vek tûr a ni lo va, a ṭo pawh in zawng tûr a ni lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, in grêp huana a ṭo in zawng tûr a ni lo va, in grêp huana a rah tla pawh in chhar khâwm tûr a ni lo va, mi rethei leh ram dang mi in zuahsak tûr a ni: kei hi Lalpa in Pathian chu ka ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rûk in ru tûr a ni lo va, a derin thil in ti tûr a ni lo va, dâwt in inhrilh tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian hming tihliauvin ka hming chhâlin dâwtin chhia in chham tûr a ni lo: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />I ṭhenawmte i bum tûr a ni lo va, i ruksak tûr a ni hek lo. Inhlawhfa hlawh chu zankhua khuain, a tûk thlengin i kawl tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bengngawng chu ânchhia i lawh tûr a ni lo va, mitdel hmaah tlûkna i dah tûr a ni hek lo; amaherawhchu, i Pathian chu i ṭih tûr a ni: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rorêlnaah chuan fel lo takin in rêl tûr a ni lo; mi rethei i thlei tûr a ni lo va, mi thiltithei i zah chuang tûr a ni lo; fel takin i ṭhenawm ro i rêlsak tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />I chipuite zîngah mite rêlin i vâk vêl ruai tûr a ni lo va, i ṭhenawm thisen thûah a ni lo zâwngin i ṭang tûr a ni hek lo: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />I rilruin i unau i haw tûr a ni lo. I ṭhenawm chu i zilhhau ngei tûr a ni, a sualnaa i hul nân.
  </para>
  <para style="p">
    <verse number="18" style="v" />Phuba i la tûr a ni lo va, i chipui thlahte huatna i pai tûr a ni hek lo; nangmah i inhmangaih angin i ṭhenawm i hmangaih tûr a ni zâwk. Kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka thupêkte chu in pawm tûr a ni. I ran chu chi hrang hrang thlahtîr suh. I lovah thlai chi hnih chîng suh la, thil chi hrang pahnih tah pawlh puan i sin tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tu pawh bâwihnu, pasal hualtu nei, la tlan loh, la chhuahtîr loh hmeichhia nêna mu dûn apiangte chu hrem an ni ang; tihhlum tûr zawng an ni lo vang, ani chu la chhuah loh a nih avângin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Inbiakna puan in kawngka bulah Lalpa hnêna a bawhchhiat thawina, bawhchhiat thawina berâmpa chu a rawn kai tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, a thil tihsual tâk, a sualnaah Lalpa hmaah bawhchhiat thawina berâmpa chuan puithiamin inremna a siamsak ang; tichuan, a thil tihsual tâk, a sualnaah chuan ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, ram chu in va luaha, ei atân thei kûng chi tinrêng in phun hun chuan a rah chu thiang lovah in ngai tûr a ni. In tân kum thum thiang lova ngaih tûr a ni a; ei hauh loh tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amaherawhchu, a kum li kum chuan a rah zawng zawng chu Lalpa fak nân a puala tihhran tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, a kum nga kum chuan in tân a pun zêl theih nân a rah chu in ei tûr a ni: kei hi Lalpa in Pathian chu ka ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />A thisen chawpin eng mah in ei tûr a ni lo va, dawi te in hmangin aien te in chîng tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />I bekbawr aṭangin a vêlin i lû i mêt tûr a ni lo va, i khabe hmul sîr tuak i tan tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mitthi avângin in taksa in zai tûr a ni lo va, in inṭial tûr a ni hek lo: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nawhchizuara siam tûrin i fanu tibawrhbâng suh; ram chu uirena ramah a lo chang ang a, suahsualnain a lo khat dah ang e.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka Chawlhnite chu in serh tûr a ni a, ka hmun thianghlim chu in zah tûr a ni: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ramhuai aienthiam zâwlte chu pan suh ula, dawithiamte pawh in bawlhhlawh phahna tûrin zawng chhuak suh u: kei hi Lalpa in Pathian chu ka ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lûa kêlsam ṭote hmaah chuan i ding zêl ṭhîn tûr a ni a, tar hmêl chu i zah tûr a ni a, i Pathian chu i ṭih tûr a ni; kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, ram dang mi, in rama khawsa ve an awm chuan in tichhe tûr a ni lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ram dang mi in zînga khawsate chu in tân in rama mi rêng ang an ni tûr a ni a, nangmah i inhmangaih angin i hmangaih tûr a ni; nangni pawh Aigupta ramah khân ram dang mi in nih kha: kei hi Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Rorêl thûah te, tehna hmawlhah te, khînah te, tehnaah te fel lo takin in ti tûr a ni lo.
  </para>
  <para style="p">
    <verse number="36" style="v" />Bûkna dik tak, khîn dik tak, epha dik tak, hin dik tak in nei tûr a ni: kei hi Lalpa in Pathian, Aigupta ram ata hruai chhuaktu che u kha ka ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, ka thupêk zawng zawngte leh ka rorêl zawng zawngte chu in pawm ang a, in zâwm tûr a ni: kei hi Lalpa chu ka ni,’ ti rawh,” tiin.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte hnênah chuan, ‘Israela thlahte zînga mi emaw, Israel rama khawsa ram dang mi emaw, an rîla rah Moleka pe apiangte chu tihhlum ngei tûr a ni a; hemi rama mite hian lungin an dêng tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, kei pawhin, ka hmun thianghlim tibawlhhlawh tûr leh, ka hming thianghlim tibawrhbâng tûra a rîla rah Moleka a pêk avângin, chu mi chungah chuan ka hmai ka thuar ang a, a chipuite zîng ata ka tiboral ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, hemi rama mite hian a rîla rah Moleka a pêk an hai dera an tihhlum loh chuan,
  </para>
  <para style="p">
    <verse number="5" style="v" />amah leh a chhûngte chungah chuan ka hmai ka thuar ang a, Moleka laka uire tûra mi uiresan apiangte nên an chipuite zîng ata ka tiboral ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, an laka uire tûra ramhuai aienthiam zâwlte leh dawithiamte pantu chungah chuan ka hmai ka thuar ang a, a chipuite zîng ata ka tiboral ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Intithianghlim ula, thianghlimin awm rawh u: kei hi Lalpa in Pathian chu ka ni si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka thupêkte chu in pawmin in zâwm tûr a ni; kei hi Lalpa , a tithianghlimtu che u ka ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />A nu emaw, a pa emaw ânchhe lawh apiang chu tihhlum ngei tûr a ni. A nu emaw, a pa emaw ânchhe lawh a ni a, a chungah a thisen mawh chu a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi nupui uiretu, a ṭhenawm nupui uiretu chu, a uirepa leh a uirenu chu tihhlum ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, pate nupui mutpui chu, a pa saruakna hlîm a ni a; tihhlum ve ve ngei tûr an ni a, an thisen mawh chu an chungah a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miin a monu a mutpui chuan tihhlum ve ve ngei tûr an ni ang; suahsualna chungchuang ti an ni a, an thisen mawh chu an chungah a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Miin hmeichhia a mutpui anga mipa a mutpui chuan thil tenawm tak an ti ve ve a ni a, tihhlum ngei tûr an ni; an thisen mawh chu an chungah a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miin nufa faa nupuia a neih chuan suahsualna nasa tak a ni a, in zînga suahsualna a awm loh nân amah leh anni pahnih pawh hâl hlum tûr an ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miin ran a mutpui chuan tihhlum ngei tûr a ni a, ran pawh chu in tihlum tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, hmeichhiain ran a va hnaiha, a inpâwltîr chuan hmeichhia chu i tihlum tûr a ni, ran pawh chu. Tihhlum ngei tûr an ni a; an thisen mawh chu an chungah a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Miin a farnu, a pa fanu emaw, a nu fanu emaw a neiha, a saruakna a hmuha, ani pawhin a saruakna a hmuh chuan thil zahthlâk tak a ni a, an chipuite thlahho mit hmuhah tihboral tûr an ni; a farnu saruakna hlîm a ni a, a khawlohna mawh a phur ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, miin hmeichhia a fel loh laia a mutpuia, a saruakna a hlîm chuan a thi chhuahna hlîm a ni a; an chipuite zîng ata tihboral ve ve tûr an ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutichuan, i nu laizâwn emaw, i pa farnu emaw saruakna i hlîm tûr a ni lo; a laichîn hnai saruaka siam a ni a; an khawlohna mawh an phur ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Miin a pami nupui a mutpui chuan a pami saruakna hlîm a ni a; an sual mawh an phur ang a, fanau lovin an thi ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Miin a unaupa nupui a neih chuan thil bawlhhlawh a ni a; a unaupa saruakna hlîm a ni a; fanau lovin an awm ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichuan, ka thupêk zawng zawng te, ka rorêl zawng zawngte in pawm ang a, in zâwm tûr a ni; tichuan, awm tûra ka hruaina che u ram chuan a luak chhuak dâwn lo che u nia.
  </para>
  <para style="p">
    <verse number="23" style="v" />In hmaa ka hnawh chhuah tâk hnam dânte chu in zawh tûr a ni lo; hêng thil zawng zawng hi an ti ṭhîn a, chuvâng chuan ka ten a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amaherawhchu, nangni hnênah chuan, “An ram, hnute tui leh khawizu luanna ram chu in luah ang a, in luah atân ka pe ang che u,” ka lo ti tawh a ni. Kei hi Lalpa in Pathian, hnam dangte laka tihrangtu che u hi ka ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuvângin, sa thiang leh thiang lo leh sava thiang leh thiang lo in thlei hrang ang a; sa emaw, sava emaw, leia a bawha bawkvâk chi rêng rêng emaw, in tâna thiang lova ka thlei hrante chuan in nunna in titenawm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka tâna mi thianghlim in ni tûr a ni; kei Lalpa hi ka thianghlim si a; ka ta in nihna tûrin hnam dangte lakah ka tihrang che u a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mipa pawh hmeichhia pawh, ramhuai aienthiam zâwl emaw, dawithiam emaw chu tihhlum ngei tûr a ni; lungin an dêng tûr a ni; an thisen mawh chu an chungah a awm tûr a ni,’ ti leh bawk rawh,” tiin.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia hnênah, “Arona fapa, puithiamte chu bia la, an hnênah, ‘An chipuite zînga mitthi avângin tu mah an intibawlhhlawh tûr a ni lo;
  </para>
  <para style="p">
    <verse number="2" style="v" />an chhûng bul - an nu te, an pa te, an fapa te, an fanu te, an unau te,
  </para>
  <para style="p">
    <verse number="3" style="v" />an farnu, an la awmpui, nula, pasal la nei lo te avâng chuan an intibawlhhlawh thei ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />An chipuite zînga a puipa ber an nih avângin an intibawlhhlawhin an intibawrhbâng tûr a ni lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />An lû an mêt kawlh tûr a ni lo va, an khabe hmul sîr tuak an tan tûr a ni bawk lo va, an taksa an zai tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />An Pathian tân mi thianghlim an ni tûr a ni a, an Pathian hming an tihliau tûr a ni lo; Lalpa tâna meia thilhlan te, an Pathian tâna ei tûr chhiahte an hlân ṭhîn a ni a; chuvângin, an thianghlim tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmeichhia, nawhchizuar emaw, hminghliau emaw, a pasal mâk hnu emaw an nei tûr a ni lo; an Pathian tân mi thianghlim an ni si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuvângin, i tithianghlim tûr a ni; i Pathian tâna ei tûr chhiah chu an hlân ṭhîn si a. I tân mi thianghlim an ni tûr a ni; kei Lalpa , a tithianghlimtu che u hi ka thianghlim si a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Puithiam tu pawh a fanu nawhchizuara a intihbawrhbân chuan a pa tibawrhbâng a ni a, hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />A unaute zînga puithiam lalber, a lû hriak thih mia thih tawh, silhfên bel tûra tihhran tawh chuan a sam a thlah tûr a ni lo va, a puante a pawt thlêr tûr a ni lo va;
  </para>
  <para style="p">
    <verse number="11" style="v" />mitthi ruang awmnaah a lût tûr a ni lo va, a nu emaw, a pa emaw avângin a intibawrhbâng tûr a ni hek lo;
  </para>
  <para style="p">
    <verse number="12" style="v" />hmun thianghlim ata chu a chhuak tûr a ni lo va, a Pathian hmun thianghlim a tibawrhbâng tûr a ni bawk hek lo; a Pathian hriak thih mia tihhranna chu a chungah a awm si a: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nupuiah chuan nula thianghlim a nei tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmeithai emaw, mâk hnu emaw, hmeichhe hminghliau emaw, nawhchizuar emaw chu a nei tûr a ni lo va; ama chipui, nula thianghlim nupuiah a nei tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, a chipuite zîngah a thlahte chu a tibawrhbâng tûr a ni lo. Kei hi Lalpa , a tithianghlimtu chu ka ni si a,’ ti rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Arona hnênah, ‘An chhuante zêl thlenga i thlahte zînga chiangkuan lohna nei apiang chuan, a Pathian ei tûr chhiah hlân tûrin rawn hnaih suh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tu pawh chiangkuan lohna nei apiang chuan an rawn hnaih hauh tûr a ni lo: mitdel te, kebai te, hnârpêr te, fuke sei lutuk apiang te,
  </para>
  <para style="p">
    <verse number="19" style="v" />ke tliak te, kut tliak te,
  </para>
  <para style="p">
    <verse number="20" style="v" />êlkun te, mi tawngchham te, mit chiangkuang lo te, mi buar te, mi phuhlip te, tilmu keh te chuan.
  </para>
  <para style="p">
    <verse number="21" style="v" />Puithiam Arona thlah chiangkuan lohna nei rêng rêng chuan Lalpa tâna meia thilhlan hlân tûrin an rawn hnaih tûr a ni lo. Chiangkuan lohna nei an ni a; an Pathian ei tûr chhiah hlân tûrin an rawn hnaih hauh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />An Pathian ei tûr chhiah, a thianghlim leh a thianghlim ber pawh chu an ei thei ve ve ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaherawhchu, chiangkuan lohna nei an nih avângin puanzâr chhûngah emaw, maichâm kiang hnaiah emaw zawng an kal thei lo vang, ka hmun thianghlimte an tibawrhbâng dah ang e. Kei hi Lalpa , anmahni tithianghlimtu chu ka ni si a,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutiang chuan Mosia chuan Arona leh a fapate leh Israela thlahte zawng zawng hnênah a sawi a.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona leh a fapate hnênah sawi la, Israela thlahte thil thianghlim, ka tâna an hlan lakahte chuan inthiarfihlîm rawh se, ka hming an tihliau dah ang e. Kei hi Lalpa chu ka ni a.
  </para>
  <para style="p">
    <verse number="3" style="v" />An hnênah, ‘In chhuante zêl thlenga in thlahte zawng zawng zînga mi, tu pawh bawlhhlawh chunga Israela thlahten Lalpa tâna an hlan thil thianghlim rawn hnaih apiang chu, ka lak ata tuithlârin a awm tûr a ni. Kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Arona thlah tu pawh phâr emaw, thil pût emaw chuan, a thianghlim hma loh chuan thilhlan thianghlimte zînga mi chu a ei tûr a ni lo. Tin, tu pawh, mitthi tihbawlhhlawh emaw, chi chhuaka emaw khawih apiang te,
  </para>
  <para style="p">
    <verse number="5" style="v" />tu pawh amah tibawlhhlawh thei, a bawha bawkvâk rêng rêng emaw, bawlhhlawh kai theih nei mi emaw khawih apiang te;
  </para>
  <para style="p">
    <verse number="6" style="v" />chutiang khawihtu chu tlai lam thlengin a bawlhhlawh ang a; tin, a inbual loh chuan thilhlan thianghlimte zînga mi chu a ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, ni a tlâk chuan a thianghlim tawh ang; chumi hnuah chuan thilhlan thianghlimte zînga mi chu a ei thei tawh ang, a ei tûr a nih avângin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Intibawlhhlawh tûrin amaha thi emaw, sa seh emaw a ei tûr a ni lo. Kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuvângin, ka thupêk chu a pawm tûr a ni; chuti lo zawng, an tihbawrhbân chuan a sual mawh an phur ang a, an thih phah ang. Kei hi Lalpa , anmahni tithianghlimtu ka ni si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ram dang miin thilhlan thianghlim chu an ei tûr a ni lo; puithiam hnêna khawsa emaw, inhlawhfa emaw chuan thilhlan thianghlim chu an ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaherawhchu, puithiamin tu emaw ama suma a lei chuan, chu mi chuan a ei thei ang; tin, a ina piangte chuan a ei tûr chu an ei ve ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Puithiam fanuin ram dang mi a neih chuan thên thilhlan, thilhlan thianghlimte zînga mi chu a ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaherawhchu, puithiam fanu chu fa nei lovin hmeithaiin emaw, mâkin emaw a awma, a pa in lama a kîr leh chuan a nulât lai ang bawk khân a pa ei tûr chu a ei ve leh ang; nimahsela, ram dang mi chuan an ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miin hre lova thilhlan thianghlim chu a ei chuan a hmun ngaa ṭhena hmun khat chu a dah belh ang a, thilhlan thianghlim chu puithiam a pe tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />An thilhlan thianghlimte ei chuan thiam lohna thlensaktu, khawlohna mawh chu inphurhtîr tûrin Israela thlahte thilhlan thianghlim, Lalpa hnêna an hlante chu an tibawrhbâng tûr a ni lo. Kei hi Lalpa , anmahni tithianghlimtu chu ka ni si a,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Arona leh a fapate leh Israela thlahte zawng zawng bia la, an hnênah, ‘Israel chhûngkaw zînga mi emaw, Israel-te zînga awm, ram dang mi emaw, tu pawh an thilhlan, hâlral thilhlana Lalpa hnêna an hlan, an thutiamna emaw, mahni duh thûa thilhlan emaw hlân apiangte chuan,
  </para>
  <para style="p">
    <verse number="19" style="v" />chhân tlâk in nih theihna tûrin bâwng emaw, berâm emaw, kêl emaw, a pa sawisêl bo in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sawisêl kai rêng rêng chu in hlân tûr a ni lo; pawmsak tlâk che u a ni dâwn si lo va.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tu pawh thutiam tikimchang tûrin emaw, mahni duh thûa thilhlanah emaw remna thilhlan inthawina, a ran rual zînga mi emaw, a berâm rual zînga mi emaw Lalpa hnêna hlân apiang chuan, pawm tlâk a nih theih nân sawisêl bo a hlân tûr a ni a; sawisêl kaina rêng rêng a awm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />A mitdel te, a ruh tliak te, a silawng te, pân nei te, a tangseh te, a phâr te chu Lalpa hnênah in hlân tûr a ni lo va, meia thilhlanah Lalpa hnênah maichâmah in hlân tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mahni duh thûa thilhlanah chuan bâwngpa emaw, berâmno emaw fuke sei lua emaw, tawi lua emaw pawh in hlân thei ang a; thutiam nân erawh chuan pawmsak a ni lo vang.
  </para>
  <para style="p">
    <verse number="24" style="v" />A tilmu chhut duk emaw, chhut perh emaw, chhut keh emaw, lâk emaw chu Lalpa hnênah in hlân tûr a ni lo va, in ramah hian chutiang chu inthawi nân in hmang tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ram dang mi aṭanga lain chûng zînga mi rêng rêng chu in Pathian ei tûr chhiahah in hlân tûr a ni lo, chûnga chhiatna leh sawisêl kaina a awm avâng chuan; pawmsak theih che u a ni lo vang,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Bâwngpa emaw, berâm emaw, kêl emaw, a lo pianin a pui hnênah ni sarih a awm tûr a ni; ni riat ni aṭanga chumi hnu lamah chuan Lalpa tâna meia thilhlanah pawm theih a ni ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bâwngpui emaw, berâmpui emaw, a no nên ni khatah in talh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, lâwmthu sawi inthawia Lalpa hnêna in inthawi hunin, chhân tlâk in nih theihna tûrin in inthawi tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chumi ni chuan ei zawh tûr a ni a; a tûk thlengin eng mah in khêk tûr a ni lo. Kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuvângin, ka thupêkte hi in pawmin in zâwm tûr a ni. Kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, ka hming thianghlim hi in tihliau tûr a ni lo va, Israela thlahte zîngah chawimawiin ka awm tûr a ni. Kei hi nangmahni chawimawitu,
  </para>
  <para style="p">
    <verse number="33" style="v" />in Pathian ni tûra Aigupta ram ata hruai chhuaktu che u ka ni. Kei hi Lalpa chu ka ni,” tiin.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte bia la, an hnênah, ‘ Lalpa kût hunbi, inkhâwmpui thianghlima in siam tûr ka kût hunbi chu hêngte hi a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni ruk hna thawh tûr a ni a, ni sarih ni erawh chu urhsûn taka lâk chawlhna, inkhâwmpui thianghlim a ni. Eng hna mah in thawk tûr a ni lo; in awmna apiangah Lalpa tâna Chawlhni a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa kût hunbi, inkhâwmpui thianghlim, a hun tak zêla in siam tûr chu hêngte hi a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thla khatna, ni sâwm leh ni li ni tlai lam chu Lalpa Kalhlên Kût a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, chumi thla vêk ni sâwm leh ni nga ni chu Lalpa tâna chhang dawidim telh loh kût a ni; ni sarih chhûng chu chhang dawidim telh loh in ei tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />A ni khat ni chuan inkhâwmpui thianghlim in nei ang a, hna rêng rêng in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ni sarih chhûng chuan meia thilhlan Lalpa hnênah in hlân tûr a ni. A ni sarih ni chu inkhâwmpui thianghlim a ni a; hna rêng rêng in thawk tûr a ni lo,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israela thlahte bia la, an hnênah, ‘Ram ka pêk che u in va thlena, chuta buhte in seng hun chuan, in buh thar hmasate phal khat chu puithiam hnênah in rawn keng tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pawmsak theih che u a nih nân, anin buhphal chu Lalpa hmaah a lo thên ang a; Chawlhni tûk tûk lehah puithiam chuan a thên tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, buhphal in thên ni chuan berâmno a pa, sawisêl bo kum khat mi hâlral thilhlanah Lalpa hnênah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, chuta chhangphut thilhlan chu, chhangphut dip mi epha hmun sâwma ṭhena hmun hnih hriaka hmeh Lalpa tâna rimtui tak, meia thilhlan a ni tûr a ni; tin, chuta in tûr thilhlan chu uain hin hmun lia ṭhena hmun khat a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />In Pathian tâna thilhlan chu in hlan hma chuan, chumi hma rêng rêng chuan a chhangin emaw, a kanin emaw, a vuiin emaw in ei tûr a ni lo; hei hi in awmna apiangah in thlahte zêl thlenga kumkhaw dân tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chawlhni tûk tûk leh, thên thilhlan buhphal in rawn ken ni aṭangin in chhiar ang a, Chawlhni vawi sarih a tling tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chawlhni vawi sarihna tûk thleng chuan ni sawmnga in chhiar ang a, Lalpa hnênah chhangphut thar thilhlan in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />In awmna hmun aṭangin epha hmun sâwma ṭhena hmun hniha siam, chhang hlâwm thên tûr pahnih, chhangphut dip mi, dawidim nêna âwm, Lalpa tâna siam hmasak ber hlan tûr in rawn keng tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, chhang hlan rual chuan berâmno pasarih sawisêl bo kum khat mi leh, bâwngtuai leh berâmpa pahnih in hlân tûr a ni. Chûngte chu an chhangphut thilhlan leh an in tûr thilhlante nên chuan, Lalpa tâna hâlral thilhlan, Lalpa tâna rimtui tak, meia thilhlan a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, sual thawi nân kêlpa pakhat leh, remna thilhlan inthawinaah berâmno a pa pahnih kum khat mi in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Puithiamin siam hmasak ber chhang chu berâmno pahnih nên chuan, Lalpa hmaa thên thilhlanah a thên ang a; puithiam pual, Lalpa tâna thianghlim a ni ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, chumi ni vêk chu in ruat ang a, in tân inkhâwmpui thianghlim a ni ang a, hna rêng rêng in thawk tûr a ni lo. Hei hi in awmna apiangah in thlahte zêl thlenga kumkhaw dân tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />In lova buh in seng hunin in vau fêmte thlengin in seng vek tûr a ni lo va, a ṭo pawh in zawng tûr a ni lo. Mi rethei leh ram dang mi in zuahsak tûr a ni. Kei hi Lalpa in Pathian chu ka ni,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Israela thlahte bia la, an hnênah, ‘Thla sarihna, chumi thla ni khat ni chu in tân urhsûn taka lâk chawlhna, tawtawrâwt tuma hriat rengna, inkhâwmpui thianghlim a ni ang a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hna rêng rêng in thawk tûr a ni lo va; Lalpa tâna meia thilhlan in hlân tûr a ni,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Lalpa chuan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Thla sarihna ni sâwm ni erawh hi chu inremna ni a ni a. In tân inkhâwmpui thianghlim a ni ang a; in rilrute in tihrehawm ang a, Lalpa tâna meia thilhlan in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chumi ni chuan eng hna mah in thawk tûr a ni lo, Lalpa in Pathian hmaa remna siamsak tûr che ua inremna ni a ni si a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tu pawh ni sela, chumi nia an rilru tihrehawm lote chu an chipuite zîng ata tuithlârin an awm ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tu pawh ni sela, chumi nia hna eng pawh thawk apiang, chu mite chu an chipuite zîng ata ka tiboral ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Eng hna mah in thawk tûr a ni lo. Hei hi in awmna apiangah in thlahte zêl thlenga kumkhaw dân tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />In tân Chawlhni urhsûn taka lâk chawlhna a ni ang a, in rilrute in tihrehawm tûr a ni; chumi thla ni kua ni tlai lam, chumi tlai aṭanga tlai lam leh thleng chu Chawlhniah in hmang tûr a ni,” tiin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Israela thlahte bia la, an hnênah, ‘Thla sarihna, ni sâwm leh ni nga ni hi Lalpa tâna ni sarih awm bâwkte kût a ni a.
  </para>
  <para style="p">
    <verse number="35" style="v" />A ni khatna chu inkhâwmpui thianghlim a ni ang. Hna rêng rêng in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ni sarih chhûng chuan meia thilhlan Lalpa hnênah in hlân ang a, a ni riat ni chu in tân inkhâwmpui thianghlim a ni ang a, meia thilhlan Lalpa hnênah in hlân tûr a ni. Inkhâwmpui ṭiakna ropui tak a ni a; hna rêng rêng in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hêngte hi a ni, Lalpa kût hunbi, Lalpa Chawlhni te, in thilpêk te, in thutiam zawng zawng te, mahni duh thûa thilhlan, Lalpa hnêna in hlan ṭhinte tiam lova, Lalpa tâna meia thilhlan te, hâlral thilhlan te, chhangphut thilhlan te, inthawina te, in tûr thilhlante a ni bîk ṭheuhva hlan tûra inkhâwmpui thianghlima in siam tûrte chu.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, thla sarihna ni sâwm leh ni nga nia in lova thil hâwngte in seng zawh chuan Lalpa kût chu ni sarih in awhtîr ang a; a ni khatna ni chu chawlh dêrna a ni ang a, a ni riat ni pawh chu chawlh dêrna a ni bawk ang.
  </para>
  <para style="p">
    <verse number="40" style="v" />A ni khat ni chuan thing kûng mawi tak tak rah te, tûm kau te, thing buk tak zâr te, luia tuipuisuthlah te in keng ang a, Lalpa in Pathian hmaah ni sarih in hlim ang.
  </para>
  <para style="p">
    <verse number="41" style="v" />He kût hi Lalpa tân kum tin ni sarih in awhtîr tûr a ni. Hei hi in thlahte zêl thlenga kumkhaw dân tûr a ni a; thla sarihnaah in nei ṭhîn ang.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chhâwl bûkah ni sarih in awm ang a. Israel rama mi rêngte chu chhâwl bûkah in awm vek ang a;
  </para>
  <para style="p">
    <verse number="43" style="v" />tichuan, in thlahte chuan Israela thlahte chu, Aigupta ram ata ka hruai chhuah lai khân chhâwl bûkah ka awmtîr tih an hre thei ang. Kei hi Lalpa in Pathian chu ka ni,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tichuan, Mosian Lalpa kût hunbi siamte chu Israela thlahte hnênah a puang ta a.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathianin Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte chu olive hriak fîm tak, chhit tûra sâwr, khâwnvâr tihalh reng nân i hnêna rawn la tûrin thu pe rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Inbiakna puan ina thuhriattîrna puanzâr pâwn lamah chuan, tlai lam aṭanga zîng lam thleng atân Lalpa hmaah Aronan dah fel rawh se; hei hi in thlahte zêl thlenga kumkhaw dân tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa hmaah khâwnvâr dahna thianghlim tak chungah chuan khâwnvârte chu dah fel ṭhîn rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, chhangphut dip mi la la, chu chu chhang sâwm leh pahnihah i âwm tûr a ni; chhang pakhatah chuan epha hmun sâwma ṭhena hmun hnih hman tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa hmaah rangkachak hlang dawhkân chungah tlar hnihin, tlar khata paruk ve vein i tiang tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chhang chungah, a tlar hnihah chuan beraw fîm tak i dah tûr a ni, hriat rengna, Lalpa tâna meia thilhlan ang a nih theih nân.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chawlhni apiangin Lalpa hmaah a dah fel ṭhîn tûr a ni; kumkhaw thuthlunna, Israela thlahte tân a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Arona leh a fapate pual a ni ang a, hmun thianghlimah an ei tûr a ni; kumkhaw dâna Lalpa tâna meia thilhlante zînga mi, a tâna thil thianghlim tak a ni,” tiin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel hmeichhe fapa, a pa Aigupta mi, mi pakhat chu Israela thlahte zîngah a va kal a; chu Israel hmeichhe fapa leh Israel mi, mi pakhat chu riahhmunah an insual a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel hmeichhe fapa chuan ânchhe lawhin Pathian hming a sawi chhia a; tichuan, Mosia hnênah an rawn hruai a. A nu hming chu Selomithi a ni a, Dan chi Dibria fanu a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa kâ aṭanga thuchhuak nghah nân tân inah an khung a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Anchhe lawhtu chu daipâwnah hruai ula; a hretu zawng zawng chuan a lûah an kut nghat sela, mi zawng zawng chuan lungin dêng rawh se.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Israela thlahte chu bia la, an hnênah, ‘Tu pawh a Pathian ânchhia lawh apiang chuan a sual mawh a phur ang a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Lalpa hming sawi chhia apiang chu tihhlum ngei tûr a ni. Mi zawng zawngin lungin an dêng ngei ngei tûr a ni; Lalpa hming an sawi chhiat chuan ram dang mi pawh, he rama mi rêng pawh tihhlum tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thi khawpa mi chunga kut thlâk apiang chu tihhlum ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thi khawpa ran chunga kut thlâk apiang chuan a rûl tûr a ni: nun aiah nun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, miin a ṭhenawm a tihhmêlhem chuan a tih ang tak chuan a chungah tih ve tûr a ni:
  </para>
  <para style="p">
    <verse number="20" style="v" />ruh tliak aiah ruh tliak, mit aiah mit, ha aiah ha; mi a tihhmêlhem angin a chungah pawh tih ve tûr a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ran tihlum apiang chuan a rûl tûr a ni a; mi tihlum apiang chu tihhlum ve tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ram dang mite tân leh he rama mi rêngte tân dân hmun khat in nei tûr a ni. Kei hi Lalpa in Pathian ka nih hi,’ i ti tûr a ni,” tiin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, Mosia chuan Israela thlahte chu a bia a, ânchhe lawhtu chu daipâwnah an hruai chhuak a, lungin an dêng a. Israela thlahte chuan Lalpan Mosia thu a pêk ang chuan an ti ta a.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Sinai tlângah Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte bia la, an hnênah, ‘Ram ka pêk che u in va thlen hun chuan, ram chu Lalpa hmingin a châwl tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />I lovah kum ruk chhûng chu thil i chîng ang a, i grêp huan chu kum ruk chhûng i sât no vang a, a hâwngte i seng ang a;
  </para>
  <para style="p">
    <verse number="4" style="v" />a kum sarih kum erawh chu ram chawlh dêrna, Lalpa hminga chawlhna a ni ang a; i lovah buhbâl i chîng tûr a ni lo va, i grêp huan i sât no tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />I buhhli chu i seng tûr a ni lo va, i enkawl loh grêp chu i lo tûr a ni lo; ram chawlh dêrna kum a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ram chawlh kuma mi chu in ei chawp atân a ni ang: i tân te, i chhiahhlawh leh i chhiahhlawhnu tân te, i hlawhfa tân te, i hnêna khawsa ram dang mi tân te,
  </para>
  <para style="p">
    <verse number="7" style="v" />i bâwng rual tân te, i rama ran tân te. Chuta a hâwng zawng zawng chu ei chawp atân a ni ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, chawlh kum, kum sarih chu i chhiar ang a, kum sarih hmun sarih a ni ang a; chawlh kum, kum sarih chhûng chu kum sawmli leh kum kua a ni ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chumi hnu thla sarihna, ni sâwm ni chuan tawtawrâwt ring tak chu i ham vêltîr ang a; inremna nîah chuan in ram zawng zawngah tawtawrâwt in ham vêltîr tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, kum sawmngana chu in lâwm ang a, ram chhûng zawng zawngah, chuta awm zawng zawng hnênah zalênna thu in puang tûr a ni. In tân Jubili a ni ang a; mi tinin mahni ta ngai in ta leh ang a, mi tin mahni in chhûngkhûr ṭheuhvah in awm leh ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chumi kum sawmngana chu in tân Jubili a ni ang a; eng mah in chîng lo vang a, a hli pawh in la lo vang a, grêp enkawl loh rah pawh in lo tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jubili a ni si a; in tân a thianghlim tûr a ni; chu in lova thil hâwng chu in ei tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />He Jubili kumah hian mi tinin mahni ta ngai in ta leh ṭheuh tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />I ṭhenawm hnênah eng emaw i hralha, i ṭhenawm laka eng emaw i lei pawhin in inbum tûr a ni lo.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jubili hnua kum zât ang zêlin i ṭhenawm thil i lei ang a, buhbâl hâwn kum tam azirin i hnênah a hralh tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kum tam dân azir zêlin a man chu i tipung ang a, a kum tlêm dân azir zêlin a man chu i tikiam ang; buhbâl hâwn kum tam dân azirin i laka hralh a ni e.
  </para>
  <para style="p">
    <verse number="17" style="v" />In inbum tûr a ni lo va, i Pathian chu i ṭih tûr a ni. Kei hi Lalpa in Pathian chu ka ni si a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuvângin, ka thuruatte chu i zâwmin ka rorêlte chu i pawmin i ṭih tûr a ni; tichuan, chu ramah chuan thlamuang takin in khawsa dâwn nia.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ram chuan a rah a chhuah ang a, hnianghnârin in chên ang a, thlamuang takin in va khawsa dâwn nia.
  </para>
  <para style="p">
    <verse number="20" style="v" />A nih leh, “A kum sarih kum chuan eng nge kan ei ang le? Ngai teh, eng mah kan chîng dâwn si lo va, kan thil hâwngte kan seng bawk dâwn si lo va,” in ti a nih chuan,
  </para>
  <para style="p">
    <verse number="21" style="v" />a kum ruk kum chuan ka malsâwmna in chungah ka thlentîr ang a, kum thum chhûng atân chuan rah a chhuah ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, a kum riat kum chuan in chîng ang a, thil hâwng in vawn, a hluite chu in ei ang a, a kum kaw kum thlengin; a lo thar leh thleng chuan in vawn, a hluite chu in ei tûr a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kumkhua atân ram chu hralh hlen tûr a ni lo, ram chu ka ta a ni si a; mikhual, ka hnêna khawsa mai in ni si a.
  </para>
  <para style="p">
    <verse number="24" style="v" />In ram luah zawng zawng chu a neitu hmasain a tlan lêt thei tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />I unau chu lo retheiin, a ram ṭhenkhat lo hralh sela, a laichîn bul berin a unauvin a lo hralh chu a rawn tlan tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, miin tlansaktu tûr a neih lohva, a lo neihnuna, tlanna khawp a neih chuan,
  </para>
  <para style="p">
    <verse number="27" style="v" />a hralh chin kum chu chhût sela, a hralhna pa chu a têl chuanna chu pe kîr rawh se; tichuan, a ram chu a luah leh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />A tâna a tlan lêt leh theih loh erawh chuan, a hralh tâka chu Jubili kum thlengin a leitu kutah chuan awm rawh se; tin, Jubili kum chuan a chhuak leh ang a, ani chuan a ram chu a luah leh ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, miin kulh nei khuaa in a hralh chuan, a hralh achin kum khat zên zâwn chhûng chuan a tlan leh thei ang; kum khat pumhlûm chhûng chuan tlan leh theihna a nei ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kum khat chhûnga a tlan theih loh chuan, kulh nei khuaa in chu kumkhuain, a thlahte zêl thleng pawhin a leitu ta a ni tlat tûr a ni a. Jubili-ah pawh a chhuak chuang lo vang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kulh nei lo khuaa inte erawh chu thingtlâng ram anga ngaih a ni ang a. Tlan theih a ni ang a, Jubili-ah a chhuak ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaherawhchu, Levi-hote khua, an chanpuala khuaa inte chu Levi-hote chuan eng lai pawhin an tlan thei ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Levi-ho zînga miin a tlan loh chuan hralh tawh in leh a chanpual khua chu Jubili-ah a chhuak ang; Levi-hote khuaa inte chu Israela thlahte zînga an chanpual a ni si a.
  </para>
  <para style="p">
    <verse number="34" style="v" />An khaw dai vêla lote erawh chu hralh theih a ni lo vang, an kumkhaw chanpual a ni si a.
  </para>
  <para style="p">
    <verse number="35" style="v" />I unau a lo retheiha, a rawn belh che chuan i lo chhawmdâwl tûr a ni; mikhual, i hnêna khawsa angin i awmpui tûr a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />A lakah tangka emaw, thil emaw, a pung la suh; Pathian ṭih zâwk rawh, i unau chu i hnêna a khawsak theih nân.
  </para>
  <para style="p">
    <verse number="37" style="v" />A pung ûmin i sum i pûktîr tûr a ni lo va, pung ûmin i ei tûrte pûktîr hek suh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kei hi Lalpa in Pathian, Kanaan ram pe tûr che u leh in Pathian ni tûra Aigupta ram ata hruai chhuaktu che u ka ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, i bula chêng i unau a lo retheiha, i hnêna a rawn tlûk luh chuan bâwih angin i chhawr tûr a ni lo.
  </para>
  <para style="p">
    <verse number="40" style="v" />Inhlawhfa ang leh i hnêna khawsa ve angin i hnênah a awm tûr a ni a, Jubili kum thlengin i rawng a bâwl ang.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chumi zawhah chuan i hnên ata a chhuak ang a, amah leh a fate nên anmahni chhûngkaw ngaiah an lût leh ang. An pi leh pute in leh lo chu an luah leh tûr a ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Aigupta ram ata ka hruai chhuah, ka chhiahhlawhte an ni si a; bâwih hralha hralh tûr an ni lo.
  </para>
  <para style="p">
    <verse number="43" style="v" />Rura takin a lakah i awm tûr a ni lo va, i Pathian chu i ṭih tûr a ni zâwk.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bawihnu leh bâwihpaa i neih tûrte chu in vêl hnamte zînga mi, bâwihnu leh bâwihpa atân chuan in lei tûr a ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tin, in zînga khawsa ram dang mi leh in rama piang an chhûngte zînga mite pawh in lei thei bawk ang; chûng chu in mi in sa an ni ang.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tin, in hnua in fate rochun atân an mi an saa an neih atân in siam ang a; chûng zînga mite chu kumkhuaa in bâwih atân in nei ang. Amaherawhchu, in unau Israela thlahte lakah chuan rura takin in awm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ram dang mi emaw, i hnêna khawsa tu emaw a lo neihnuna, a kianga i unaupa a lo retheiha, i hnêna ram dang mi hnênah emaw, i hnêna khawsa hnênah emaw, ram dang mite thlah chhûng hnênah emaw a tlûk luh chuan,
  </para>
  <para style="p">
    <verse number="48" style="v" />a tlûk luh hnu pawhin tlan leh theih a ni ang. A unaute zînga miin an tlan thei ang a:
  </para>
  <para style="p">
    <verse number="49" style="v" />a pamiin emaw, a pami fapain emaw a tlan thei ang a; a chite zinga a laichîn hnaiin a tlan thei bawk ang. Tin, amah pawh a lo neihnun leh chuan a intlan thei ang.
  </para>
  <para style="p">
    <verse number="50" style="v" />A tlûk luhna pa nên a tlûk luh aṭanga Jubili kum leh tûr chhût dun sela: a tlûk luh man chu a kum azirin a ni ang a; tin, hlawhfaa rawih chhût ang zêla chhûtsak a ni ang.
  </para>
  <para style="p">
    <verse number="51" style="v" />Kum tam tak a la bâk chuan a tlanna man chu a belh chhûng hu tâwk man a pe kîr leh tûr a ni.
  </para>
  <para style="p">
    <verse number="52" style="v" />Jubili kum thlenna tûr kum rei lo tê chauh a la awm a nih chuan chhût dûn sela; a awm kum tam zia azirin a tlanna man a pe kîr tûr a ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kum khat bi zêla rawih inhlawhfa angin a bêl tûr a ni a, i mit hmuhah rura takin a ti tûr a ni lo.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chûng ang zâwnga tlan a nih loh pawhin, Jubili kum chuan a chhuak ang - amah leh a fate nên.
  </para>
  <para style="p">
    <verse number="55" style="v" />Israela thlahte chu keima chhiahhlawhte an ni si a; Aigupta ram ata ka hruai chhuah, ka chhiahhlawhte an ni: kei hi Lalpa in Pathian chu ka ni.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Milem in insiam tûr a ni lo va, milem siam chawp emaw, lung phun emaw in din tûr a ni lo va, chibai bûk atân in ramah hian milem chuanna lung in phun tûr a ni hek lo: kei hi Lalpa in Pathian chu ka ni si a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Chawlhnite chu in serh ang a, ka hmun thianghlim chu in zah tûr a ni: kei hi Lalpa chu ka ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka thuruatte chu in zawma, ka thupêkte in pawma, in zawm chuan,
  </para>
  <para style="p">
    <verse number="4" style="v" />ruahtuite chu a hun têah ka tlâktîr ang a, lei chuan thil a hâwntîr ang a, rama thingte chuan rah an chhuah ang a.
  </para>
  <para style="p">
    <verse number="5" style="v" />In hruiha buh chuan grêp lawh hun a man phâk ang a, in lawh chuan thil chîn hun a man phâk ang a; in chhang chu hnianghnârin in chên ang a, in ramah hian thlamuang takin in khawsa ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />He ram hi râlmuang takin ka awmtîr ang a, in mu hle hle ang a, tu mân an tihlau lo vang che u; ramsa sualte chu he ram ata hi ka hnawt ṭiau vang a, khandaihin in ram a fang tlang hek lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />In hmêlmate chu in ûm ang a, in hmaah khandaiha thahin an awm ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi pangain za in ûm ang a, zain sîng in ûm ang a; in hmêlmate chu in hmaah khandaiha thahin an awm ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, ka duhsak ang che u a, chi tam tak ka thlahtîr ang che u a, ka tipung ang che u; tin, in lakah ka thuthlung ka tinghet ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rei tak in vawn a hluite chu in ei ang a, a thar dah nân a hluite chu in la chhuak ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />In zîngah ka biak bûk chu ka awmtîr ang a, ka nunna chuan a hnuchhawn lo vang che u.
  </para>
  <para style="p">
    <verse number="12" style="v" />In zîngah ka chêng ang a, in Pathian ka ni ang a, nangni pawh ka mite in ni ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei hi Lalpa in Pathian, an bâwih in nih lohna tûra Aigupta ram ata hruai chhuaktu che u chu ka ni a; in nghâwngkawlte chu ka titliak a, ding charin ka kaltîr tâk che u hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaherawhchu, ka thu in pawm lohva, hêng thupêk zawng zawngte hi in zawm lohva,
  </para>
  <para style="p">
    <verse number="15" style="v" />ka thuruatte in duh lohva, in nunnain ka rorêlte a huata, ka thupêk zawng zawngte zâwm lova ka thuthlung in bawhchhiat chuan,
  </para>
  <para style="p">
    <verse number="16" style="v" />kei pawhin in chungah hei hi ka ti ang: in chungah thil hlauhawm tak, in nunna tihmuih telh telh leh in mit tichau telh telh ngawrna leh sikserhte ka lêntîr ang. Tin, in thlai chite chu in chîng thlâwn mai mai a ni ang, in hmêlmate chuan an ei zêl dâwn a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />In chungah chuan ka hmai ka thuar ang a, in hmêlmate hmaah in tlâwm ang; nangmahni hawtuten in chungah ro an rêl ang a, tu ma ûm lohvin in tlân ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, chuti chung pawha ka thu in la pawm loh cheu chuan, in sualte avângin vawi sarih ka la hrem leh ang che u.
  </para>
  <para style="p">
    <verse number="19" style="v" />In chakna chhuan tawlawl chu ka chhu chhia ang a, in vân chu thîr angah ka siam ang a, in lei chu dâr angah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, in tha in sêng thlâwn mai mai a ni ang; in ram chuan thil a hâwntîr lo vang a, rama thingte chuan rah an chhuah hek lo vang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi kalh zâwnga in awma, ka thu in pawm loh chuan in sualnate azirin, a leh sarihin in chungah hremna ka thlentîr ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, in zîngah ramsate ka rawn kaltîr ang a, chu chuan in fate a lâksak ang che u a, in rante a sehsak ang che u a, a tikiam tial tial ang che u a, in kawngte a lo ṭhing ṭhuap ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuti chung pawha ka thununna in pawm chuan lohva, mi kalh zâwnga in la awm cheu chuan,
  </para>
  <para style="p">
    <verse number="24" style="v" />kei pawh nangmahni kalh zâwngin ka awm ang a, keimah ngeiin in sual avângin vawi sarih ka hrem ang che u.
  </para>
  <para style="p">
    <verse number="25" style="v" />In chungah khandaih ka lên ang a, chu chuan thuthlung phuba a la ang. Mahni khaw chhûng ṭheuhvah in tawm khâwm ang a, in zîngah hri ka lêntîr ang; tin, hmêlmate kuta pêk in ni ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />In rin pui ber chhang ka tihchahsak che u hunah chuan, hmeichhe sâwmin a âwmna pakhatah an âwm ang a, in chhang chu bûk chiah zêlin an pe leh ang che u; in ei ang a, in kham chuang lo vang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuti chung pawha ka thu in pawm chuan lohva, mi kalh zâwnga in la awm cheu chuan,
  </para>
  <para style="p">
    <verse number="28" style="v" />thinrim takin nangmahni kalh zâwngin ka awm ang a; in sual avângin vawi sarih ka hrem bawk ang che u.
  </para>
  <para style="p">
    <verse number="29" style="v" />In fapate sa in ei ang a, in fanute sa in ei bawk ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, in hmunsângte ka tichim ang a, in milemte ka titlu ang a, in ruangte chu in milemte ruang chungah ka paih ang; tin, ka nunna chuan a haw dâwn che u a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />In khawpuite chu ka tiṭiau vang a, in hmun thianghlimte chu ka tiram ang a, in rimtuite chu ka hnîm lo vang.
  </para>
  <para style="p">
    <verse number="32" style="v" />In ram chu ka tiṭiau vang a, in hmêlma chuta awmte chuan mak an ti ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, hnam dangte zîngah ka tidarh ang che u a, a ûm tûr che uin khandaih chu ka phawi ang; tichuan, in ram chu a ṭiau vang a, in khuate chu a ram ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, ram chu a ṭiau chhûng zawng leh, in hmêlmate rama in awm chhûng chuan a Chawlhniahte chuan a hlim ang; chutih hnuah chuan ram chu a châwl ang a, a Chawlhniahte chuan a hlim ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />A ṭiau chhûng zawng chuan a châwl ang; in awm laia in Chawlhnia châwl ve ṭhîn lote kha.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tin, in zînga mi la awm chhunte chu, an hmêlmate ramah an thinlungah chauhna ka awmtîr ang; tin, hnahthel lêng riin a ûm ang a, khandaih laka tlânchhia angin an tlânchhia ang a, tu ma ûm hleih lohvin an tlu ang.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tu ma ûm hleih lohvin khandaiha ûm ang maiin an inpal thlu rem rum ang; in hmêlmate lo dang tûrin chakna rêng rêng in nei lo vang.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hnam dangte zîngah in boral ang a, in hmêlmate ram chuan a ei zo vang che u.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, in zînga mi la awm chhunte chu in hmêlmate ramah an khawlohna avângin an hmuih telh telh ang; an pi leh pute chuan an khawlohnate an hmuih phah angin, anni pawhin an hmuih phah ve bawk ang.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ka chunga an sualna avâng leh an khawlohna leh, an pi leh pute khawlohna leh mi kalh zâwnga an awm avânga,
  </para>
  <para style="p">
    <verse number="41" style="v" />kei pawh anmahni kalh zâwnga ka awma, an hmêlmate rama ka awmtîrte chu an phat lohva, an thinlung tan loh chu a intihhnuaia, an khawlohna avânga hremna chu an pawm chuan,
  </para>
  <para style="p">
    <verse number="42" style="v" />Jakoba hnêna ka thuthlung chu ka hre reng ang a, Isaaka leh Abrahama hnêna ka thuthlungte pawh ka hre reng ang a; tin, ram pawh chu ka hre reng bawk ang.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ram pawh chu an kiansan ang a, anmahni awm lova a ṭiau chhûng chuan a chawlh niahte chuan a hlim ang; ka rorêlnate an duh loh avâng leh an nunnain ka thuruatte a huat ṭhin avângin, an khawlohna hremna chu an pawm tûr a ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuti chung pawh chuan an hmêlmate rama an awm chu, anmahni tiboral dêr tûrin an laka ka thuthlung bawhchhiain ka paih thla lo vang a, ka haw hek lo vang. Kei hi Lalpa an Pathian chu ka ni si a.
  </para>
  <para style="p">
    <verse number="45" style="v" />An Pathian ka nih theihna tûra hnam tinte mit hmuha Aigupta ram ata ka hruai chhuah, an thlahtute thuthlung chu anmahni avâng hian ka hre reng zâwk ang. Kei hi Lalpa chu ka ni,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hêng hi Sinai tlânga Mosia hmanga amah leh Israela thlahte kâra Lalpan a siam thupêk te, rorêl te leh dân te chu a ni.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Mosia a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela thlahte bia la, an hnênah, ‘Miin eng emaw pawimawh bîk chungchângah thu a tiam chuan, a mihring hu tâwk i ruat ang chu Lalpa pual a ni ang a,
  </para>
  <para style="p">
    <verse number="3" style="v" />mipa a nih chuan i ruat dân tûr chu kum sawmhnih aṭanga kum sawmruk mi chu hmun thianghlim sekel ang, tangkaraw sekel sawmnga hu a ni ang;
  </para>
  <para style="p">
    <verse number="4" style="v" />hmeichhia a nih chuan i ruat dân tûr chu sekel sawmthum a ni ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, kum nga aṭanga kum sawmhnih mi a nih chuan, i ruat dân tûr chu mipa chu sekel sawmhnih, hmeichhia chu sekel sâwm a ni ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, thla khat aṭanga kum nga mi a nih chuan, i ruat dân tûr chu mipa chu tangkaraw sekel nga, hmeichhia chu tangkaraw sekel thum a ni ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, kum sawmruk aṭanga a chung lam a nih chuan, i ruat dân tûr chu mipa chu sekel sâwm leh panga, hmeichhia chu sekel sâwm a ni ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaherawhchu, i ruat aia a lo retheih chuan puithiam hnênah hruai tûr a ni ang a, puithiamin a lo ruat ang; thutiamtu theih tâwk ang ang puithiamin a lo ruat ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, thilhlan, Lalpa hnêna an hlan tûr chu ran a nih chuan, tu pawhin Lalpa tâna chutiang an pêk rêng rêng chu thil thianghlim a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tidanglam tûr a ni lo va, a ṭhain a chhia, a chhiain a ṭha thlâkthleng tûr a ni hek lo; ran, ran vêka a thleng luih chuan a pahnihin a thlengna nên chuan a thianghlim tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, ran thianghlim lo, Lalpa hnêna hlan ngai loh mi a nih chuan, ran chu puithiam hmaah a dah tûr a ni;
  </para>
  <para style="p">
    <verse number="12" style="v" />tin, puithiam chuan a ṭhat dân azirin a man tâwk a lo ruat ang a; nang puithiamin i ruat tâwk ang apiang chu a ni zêl ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaherawhchu, a tlan leh tak tak dâwn chuan i ruat zât hmun ngaa ṭhena hmun khat a belh tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, miin a in chu Lalpa pual atâna a hlan dâwn chuan a ṭhat leh ṭhat loh azirin puithiamin a ruat tûr a ni; puithiam ruat ang ang chu a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, a hlântu chuan a in chu a tlan leh dâwn chuan, a man tûra i ruat zât hmun ngaa ṭhena hmun khat a belh tûr a ni; tichuan, a ta a ni leh ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, miin a rama lo, a ṭhen Lalpa pual atâna a hlan dâwn chuan i ruat dân tûr chu a chi tuh azir zêlin a ni ang. Barli homer khat hmun chu tangkaraw sekel sawmnga man a ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />A lo chu Jubili kum aṭanga hlan a nih chuan i ruat ang chu a ni reng ang a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jubili kum hnua hlan a nih erawh chuan, puithiamin a man chu Jubili thlen lehna tûr kum azir zêlin a ruatsak ang a, i ruat dân aṭanga a kiam tâwk siam a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />A hlântuin a tlan leh dâwn tak tak chuan, a man i ruat zât hmun ngaa ṭhena hmun khat a belh ang a, a ta a ni leh chiah ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lo chu a tlan duh lo emaw, mi dang hnênah a hralh emaw a nih chuan tlan leh theih a ni tawh lo vang;
  </para>
  <para style="p">
    <verse number="21" style="v" />Jubili kuma a chhuah leh hun chuan lo chu Lalpa tâna thianghlim, a puala lo hluihlâwn ang a ni ang a, puithiam ta tûr a ni ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />A rama mi ni lo, lo a lei Lalpa hnêna a hlan chuan,
  </para>
  <para style="p">
    <verse number="23" style="v" />Jubili kum thlengin i ruat dân angin puithiamin a man chu a ruatsak ang a, i ruat ang chuan Lalpa tâna thil thianghlimah chumi ni chuan a pe tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Jubili kum chuan a leina pa, a ram neitu pângngai chuan a nei leh ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />I ruat dân zawng zawng chu hmun thianghlim sekel ang zêl a ni tûr a ni; sekel khat chu gera sawmhnih a ni ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amaherawhchu, ran zînga piang hmasa ber, a pian hmasak ber avânga Lalpa pual atâna ruat tawh phawt chu tu mân an hlân tûr a ni lo; sebâwngpa pawh, berâm pawh ni sela, Lalpa pual a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, ran thianghlim lo a nih chuan i ruat dân angin a tlan tûr a ni ang a, a hmun ngaa ṭhena hmun khat a belh tûr a ni; tin, tlan a nih loh chuan i ruat dân angin hralh tûr a ni ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaherawhchu, miin a thil neihte zînga mi, Lalpa puala a hlan tawh phawt chu, mihring emaw, ran emaw, a rama lo emaw pawh ni se, hralh tûr a ni lo va, tlan tûr a ni hek lo; chutianga thilhlan tawh zawng zawng chu Lalpa tâna thianghlim tak a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mihring pawh ni se, chutianga hlan tawh phawt chu tlan tûr a ni lo; tihhlum ngei ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ram chhûnga mi, sâwma pakhat zawng zawng, lova thil hâwngte pawh, thei rahte pawh Lalpa pual a ni a; Lalpa tâna thianghlim a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Miin a sâwma pakhat zînga mi a eng pawh a tlan dâwn chuan a hmun ngaa ṭhena hmun khat a belh tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ran leh berâm rual zînga sâwma pakhat, tiang hnuaia lût a sâwmna zêl chu Lalpa tâna thianghlim a ni ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />A chhiat leh ṭhat a fiah tûr a ni lo va, a thlâkthleng tûr a ni hek lo; a thleng luih chuan a pahnihin a thlengna nên chuan thil thianghlim a ni ang a, tlan leh theih a ni lo vang,’ ti rawh,” tiin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hêng hi Sinai tlânga Israela thlahte tâna Lalpan Mosia a pêk, thupêkte chu a ni.
  </para>
</usx>
