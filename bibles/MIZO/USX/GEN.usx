<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Genesis</book>
  <para style="h">Genesis</para>
  <para style="toc1">Genesis</para>
  <para style="toc2">Genesis</para>
  <para style="mt">Genesis</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />A tîrin Pathianin lei leh vân a siam a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, lei hi a chhia a, a ruak ngawt a ni a; tui thûk tak chung chu a thim mup a. Pathian Thlarau chuan tui chungte chu a awp reng a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Pathianin, “Êng lo awm rawh se,” a ti a; tichuan, êng a lo awm ta mai a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Pathianin êng chu a en a, ṭha a ti hle a; tichuan, Pathianin êng leh thim chu a ṭhen ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Pathianin êng chu ‘chhûn’ a vuah a, thim chu ‘zân’ a vuah a. Tichuan, tlai lam a awm a, zîng lam a awm bawk a, a ni khatna chu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Pathianin, “Tui leh tui kârah chuan boruak zau tak awm sela, chu chuan tui leh tuite chu ṭhen rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, Pathianin boruak zau tak chu a siam a, boruak zau tak hnuaia tui awmte leh boruak zau tak chunga tui awmte chu a ṭhen ta a; chutiang chu a lo ni ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Pathianin boruak zau tak chu ‘vân’ a vuah a. Tichuan, tlai lam a awm a, zîng lam a awm bawk a, a ni hnihna chu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Pathianin, “Vân hnuaia tuite chu hmun khatah awm khâwm sela, khawmual chu lang rawh se,” a ti a; tichuan, chutiang chu a lo ni ta a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Pathianin khawmual chu ‘lei’ a vuah a; tui awm khâwmte chu ‘tuifinriatte’ a vuah a. Tin, Pathianin chu chu a en a, ṭha a ti hle a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Pathianin, “Leiin hnim te, thlai chi nei te, thei kûng, leia anmahni chi awm dân tûr anga rah, a rah chhûnga a chi awmte chu chhuah rawh se,” a ti a; tichuan, chutiang chu a lo ni ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tichuan, lei chuan hnim te, thlai anmahni chi awm dân tûr anga chi nei te, thing anmahni chi awm dân tûr anga rah, a rah chhûnga a chi awmte chu a chhuah ta a. Tin, Pathianin a en a, ṭha a ti hle a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tichuan, tlai lam a awm a, zîng lam a awm bawk a, a ni thumna chu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Pathianin, “Chhûn leh zân ṭhenna tûrin vân boruak zau takah chuan êntute awm sela, chûngte chu chhinchhiahna te, hun bi te, ni te, kum te hriatna tûr ni rawh se;
  </para>
  <para style="p">
    <verse number="15" style="v" />lei chung ên tûrin vân boruak zau takah chuan êntuahte awm bawk rawh se,” a ti a; tichuan, chutiang chu a lo ni ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tichuan, Pathianin êntu ropui zâwk chu chhûn rorêl tûrin, êntu ropui lo zâwk chu zân rorêl tûrin a siam a; arsite pawh khi a siam bawk a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Pathianin chûngte chu lei chung ên tûr leh,
  </para>
  <para style="p">
    <verse number="18" style="v" />chhûn chungah leh zân chunga rorêl tûr leh, êng leh thim ṭhen tûrin vân boruak zau takah khian a dah ta a. Tichuan, Pathianin chu chu a en a, ṭha a ti hle a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tichuan, tlai lam a awm a, zîng lam a awm bawk a, a ni lina chu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Pathianin, “Tuite chuan thilsiam che thei, nunna neite tam tak chhuah ṭeuh sela, savate pawh vân boruak zau tak, zâwl duaiah, lei chungah chuan thlâwk rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tichuan, Pathianin tuifinriata sa lian pui puite chu a siam a, thil nung che thei tinrêng, tuiin a chhuah ṭeuhte chu, anmahni chi awm dân tûr ang ṭheuhvin a siam bawk a, sava thla nei tinrêng pawh anmahni chi awm dân tûr ang ṭheuhvin a siam bawk a. Tin, Pathianin chu chu a en a, ṭha a ti hle a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Pathianin, “Chi tam tak thlahin lo pung ula, tuifinriat tuite tikhat rawh u, savate pawh leiah pung rawh se,” tiin mal a sâwm a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, tlai lam a awm a, zîng lam a awm bawk a, a ni ngana chu.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Pathianin, “Lei chuan thil nung anmahni chi awm dân tûr ang ṭheuhvin, ran te, rannung te, ramsa te anmahni chi awm dân tûr ang ṭheuhvin chhuah rawh se,” a ti a; tichuan, chutiang chu a lo ni ta a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tichuan, Pathianin ramsa anmahni chi awm dân tûr ang ṭheuhvin, rante anmahni chi awm dân tûr ang ṭheuhvin, leia bawkvâka kal zawng zawngte anmahni chi awm dân tûr ang ṭheuhvin a siam a. Tin, Pathianin chu chu a en a, ṭha a ti hle a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Pathianin, “Kan anpuiin, keimahni ang takin mihring siam ila; anni chu tuifinriata sangha chungah te, rannung leia bawkvâka kal zawng zawng chungah te thu i neihtîr ang u,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tichuan, Pathianin ama anpuiin mihring a siam a, Pathian anpui ngeiin a ni a siam ni; mipaah leh hmeichhiaah a siam a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Pathianin anmahni mal a sâwm a; Pathian vêkin an hnênah, “Chi tam tak thlaha lo pungin, leilung hi luah khat ula, in thû thûin awmtîr rawh u; tuifinriata sangha chungah te, chunglêng sava chungah te, thil nung leia bawkvâka kal zawng zawng chungah te thu nei bawk rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Pathian vêkin, “Ngai teh u, lei chung zawng zawnga thlai chi nei awm tinrêng leh thing tinrêng, thing chi nei rah awmnate chu ka pe che u a ni; in chaw atân a ni ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, leia sa tinrêng hnênah te, chunglêng sava tinrêng hnênah te, leia bawkvâka kal, nunna nei tinrêng hnênah te an chaw atân hnim hring tinrêng ka pe a ni,” a ti a; tichuan, chutiang chu a lo ni ta a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Pathianin a thilsiam tinrêng chu a en a, ngai teh, ṭha a ti êm êm a. Tichuan, tlai lam a awm a, zîng lam a awm bawk a, a ni rukna chu.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tichuan, lei leh vân chu an chunga awmho zawng zawngte nên chuan siam zawh a ni ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Pathianin ni sarih nîah chuan a thilsiam chu a ti zo va, ni sarih nîah chuan a thilsiam zawng zawng chu a chawlhsan ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, Pathianin ni sarih ni chu mal a sâwm a, a serh ta a; chumi nîah chuan Pathianin a thilsiam zawng zawng, thu ngawta a siam leh kuta a siamte chu a chawlhsan tâk avângin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lei leh vân siam dân chu hetiang hi a ni. Lalpa Pathianin lei leh vân a siam ni khân,
  </para>
  <para style="p">
    <verse number="5" style="v" />leia hnim rêng rêng hi leiah a la awm lo va, leia thlai rêng rêng pawh hi a la ṭo hek lo. Lalpa Pathianin lei chungah ruah a la sûrtîr si lo va, lei lettu tûrin mihring lah an la awm hek lo;
  </para>
  <para style="p">
    <verse number="6" style="v" />amaherawhchu, lei aṭangin chhûm a lo chhuak a, lei chung zawng zawng chu a tihnâwng ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Lalpa Pathianin leia vaivutin mihring a siam a, a hnârah chuan nunna thaw chu a thaw lût a; tichuan, mihring chu mi nung a lo ni ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Lalpa Pathianin chhak lamah, Eden-ah chuan huan a siam a, a mihring siam chu chutah chuan a awmtîr ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, lei aṭangin Lalpa Pathianin thing mit la tak leh ei mi tinrêng a ṭotîr a. Nunna thing pawh huan lai takah chuan a ṭotîr a, a chhia leh a ṭha hriatna thing pawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Eden aṭangin huan tihnâwng tûrin lui a luang chhuak a; chuta ṭang chuan a pêng darh a, pêng li a lo ni ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pakhatna hming chu Pison a ni a; chu chu Havila ram zawng zawng hualtu chu a ni a, chutah chuan rangkachak a awm.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chumi rama rangkachak chu ṭha tak a ni. Chutah chuan bedolak leh berul lung pawh a awm.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, lui pahnihna hming chu Gihon a ni a; chumi chu Kus ram zawng zawng hualtu chu a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, lui pathumna hming chu Hiddekel a ni a; chu chu Assuria ram chhak lama luang chu a ni. Tin, lui palina chu Euphrates a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Lalpa Pathian chuan mihring chu a hruai a, Eden huanah chuan a enkawl leh a vêng tûrin a dah ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Lalpa Pathian chuan mihring hnênah chuan, “Huana thing tinrêng rahte hi i duh duhin i ei thei e;
  </para>
  <para style="p">
    <verse number="17" style="v" />a chhia leh a ṭha hriatna thing rah erawh hi chu i ei tûr a ni lo, i ei chuan i ei ni la lain i thi ngei tûr a ni,” tiin thu a pe a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Lalpa Pathian chuan, “Mihring amah chauhva awm hi a ṭha lo ve; amah ṭanpuitu tûr a kawppui âwm mi ka siamsak teh ang,” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Lalpa Pathian chuan leiin ramsa tinrêng leh chunglêng sava tinrêng chu a siam a, an hmingah eng nge a vuah dâwn tih hriat nân Adama hnênah a hruai hlawm a; tin, thil nung tinrêngte chu Adaman an hminga a lo vuah apiang chu an hming a lo ni hlen ta a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Adama chuan ran zawng zawng te, chunglêng sava te, ramsa tinrêng te chu hming a vuah ṭheuh va; nimahsela, Adama tân chuan ṭanpuitu tûr a kawppui âwm mi a awm lo va.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tichuan, Lalpa Pathian chuan Adama chu tui takin a muthilhtîr a; tichuan, a muhîl ta a; tin, a nâk ruh pakhat a la a, chumi ai chu tisain a awh phuitîr ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Lalpa Pathian chuan Adama laka a lâk nâk ruh chu hmeichhiaah a siam a, Adama hnênah a hruai ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Adama chuan, “Hei zet chu ka ruh ang ruh neia, ka tisa ang tisa nei ngei chu a ni; mipa laka lâk chhuah a nih avângin ‘hmeichhia’ tih tûr a ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuvângin, mipain a nu leh a pa a kalsan ang a, a nupui a vuan ang; tichuan, tisa pumkhat an lo ni tawh ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Adama leh a nupui chu an pahnihin saruakin an awm a, an zak lêm lo va.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa Pathianin ramsa a siam zawng zawngah chuan rûl a fing vervêk ber a. Tichuan, ani chuan hmeichhe hnênah chuan, “Pathianin, ‘Huana thing rah rêng rêng hi in ei tûr a ni lo,’ a ti elo maw?” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, hmeichhia chuan rûl hnênah chuan, “Ti lo ve, huana thing rahte hi kan ei thei asin;
  </para>
  <para style="p">
    <verse number="3" style="v" />huan lai taka thing awm rah erawh chu Pathianin, ‘In ei tûr a ni lo, tawh pawh in tawk tûr a ni lo; chuti lo chuan, in thi ang,’ a ti a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, rûl chuan hmeichhe hnênah chuan, “Thi teh suh e;
  </para>
  <para style="p">
    <verse number="5" style="v" />in ei ni apang chuan in mit a lo vâr ang a, a chhia leh a ṭha hriain Pathian ang in lo ni dâwn tih Pathianin a hre reng a nih chu,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, hmeichhia chuan thing rah chu ei mi a ni tih leh, mit la tak a ni tih leh, mi tifing tûrin thing rah îtawm tak a ni tih a hriat chuan, a rah ṭhenkhat chu a lo va, a ei ta a; tin, a pasal a pe ve a, ani pawhin a ei ve ta a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, an pahnih chuan an mit a lo vâr a, saruak an nih an lo inhre ta a; tichuan, theipui hnah an ṭhui khâwm a, pawnfên an insiam chawp a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Lalpa Pathian chu huana tlai ni nêma a lêng thâwm chu an lo hria a; tichuan, Adama leh a nupui chuan huana thing zîngah chuan Lalpa Pathian chu an lo bihrûksan ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Lalpa Pathian chuan Adama chu a ko va, a hnênah, “Khawiah nge i awm?” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, ani chuan, “Huana i thâwm ka hria a, saruaka awm ka nih avângin ka hlau ta a; tichuan, ka biru ta a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, ani chuan, “Saruak i nih tuin nge hrilh che? Thing rah ei loh tûr ka tih tlat che kha i ei ta a ni maw?” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Adama chuan, “Mi awmpui tûra i hmeichhe mi pêk ngei khân thing rah chu mi pe a, ka ei ta a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Lalpa Pathian chuan hmeichhe hnênah chuan, “I thiltih hi eng tizia nge ni le?” a ti a. Tin, hmeichhia chuan, “Rûlin mi tihder a, ka ei ta a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Lalpa Pathian chuan rûl hnênah chuan, “Hetiang hi i tih avângin ran zawng zawng leh ramsa tinrêng zingah chuan ânchhe dawngin i awm bîk ang a; bawkkhupin i kal tawh ang a, i dam chhûng zawngin vaivut i ei bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, nang leh hmeichhia hi ka indotîr ang che u a, i thlahte leh a thlahte pawh ka la indotîr bawk ang; chu mi chuan i lû a la tithitling ang a, nangin a keartui i la tithitling ang,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmeichhe hnênah chuan, “I hrehawmna leh i nau paina chu nasa takin ka tipung ang a; hrehawm takin fa i hring thîn ang a; nimahsela, i duh zâwng chu i pasal lam a ni ang a, ani chuan i chungah thu a nei fo vang,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Adama hnênah chuan, “I nupui thu i zawma, thing pakhat, ‘A rah i ei tûr a ni lo,’ tia thu ka pêk che kha, a rah i ei avângin lei hi nangmah avângin ânchhe dawngin a awm ta a ni; i dam chhûng zawngin rim taka thawkin a rah chu i ei tawh ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hlîng leh buarte pawh a chhuahsak ang che; tin, leia thlai chu i ei tawh ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, leia i kîr leh hma loh chuan i hmaia thlantui luang zawih zawihin chaw i ei tawh ang, lei aṭanga lâk chhuah i ni si a; vaivut i ni a, vaivutah i kîr leh tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Adama chuan a nupui chu mi nung zawng zawng nu a nih avângin a hmingah Evi a vuah a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Lalpa Pathian chuan Adama tân leh a nupui tân chuan savun kawrfualte a siamsak a, a haktîr ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Lalpa Pathian chuan, “Ngai teh u, mihring chu a chhia leh a ṭha hriain keimahni ang a lo ni ta; tûnah chuan a kuta banin, nunna thing rah chu lova eiin, kumkhuain a nung dah ang e,” a ti a;
  </para>
  <para style="p">
    <verse number="23" style="v" />chuvângin, Lalpa Pathian chuan amah a lâk chhuahna lei chu let tûrin Eden huan ata chu a tîr chhuak ta a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutichuan, mihring chu a hnawt chhuak ta a; tin, nunna thing kawng chu vêng tûrin, Eden huan chhak lampangah chuan cherub-te leh mei khandaih vir tawn zawk zawk chu a awmtîr ta bawk a.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Adama chuan a nupui Evi chu a pâwl a; tichuan, a rai a, Kaina a hring a, “ Lalpa ṭanpuiin mipa ka lo nei ta,” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, a nau Abela a rawn hring leh a. Tin, Abela chu berâm vêngtuah a awm a, Kaina erawh chu lei lettuah a awm.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, a nakinah chuan heti hi a ni a, Kaina chuan Lalpa hnêna hlan atân lova mi a rawn la a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Abela pawh chuan a berâm rual zînga piang hmasa berte leh an thaute chu a rawn la bawk a. Tin, Lalpa chuan Abela leh a thilhlan chu a lâwm a;
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaina leh a thilhlan erawh chu a lâwm ve lo va. Tichuan, Kaina chu a thinur êm êm a, a hmêl chu a lo dur ta khup a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, Lalpa chuan Kaina hnênah chuan, “Engati nge i thin a ur? Engati nge i hmêl a lo dur tâk?
  </para>
  <para style="p">
    <verse number="7" style="v" />Thil i tih ṭhat chuan lawm i hlawh dâwn lo vem ni? I tih ṭhat loh erawh chuan sual chu kawngka bulah a bawk reng a ni; a duh zâwng chu nangma hnên lam a ni ang a, a chungah thu i nei tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaina chuan a nau Abela hnênah, “Lovah i feh ang,” a ti a. Tin, heti hi a ni a, lova an awm laiin Kaina chuan a nau Abela chu a bei a, a that ta mai a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, Lalpa chuan Kaina hnênah chuan, “I nau Abela kha khawiah nge a awm tâk?” a ti a. Tin, ani chuan, “Ka hre lo. Ka nau vêngtu ka ni em ni?” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, ani chuan, “Eng nge i tih tâk ni? I nau thisen aw chuan lei aṭangin mi au asin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuvângin, lei, i kut ata i nau thisen dawng tûra a kâ lo ângtu ata hi ânchhe dawng i ni ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lei i leh pawhin a ṭhatna chu a pe phal tawh lo vang che. Leiah hian tlân bo leh vâkvai i lo ni tawh ang,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Kaina chuan Lalpa hnênah, “I mi hremna hi a nasa êm a, ka tuar zo lo vang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai teh, nangin vawiinah hian lei chung ata mi hnawt chhuak ta si a, i mit hmuh phâk loh va thuhrûkin ka awm dâwn ta a; leiah hian tlân bo leh vâkvai ka lo ni dâwn ta si a; tichuan, heti hi a ni ang a, tu pawh mi hmu apiangin mi that mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Lalpa chuan a hnênah, “Chuti a nih chuan, tu pawh Kaina that apiang chu a leh sarihin a chungah phuba lâk a ni ang,” a ti a. Tichuan, miin amah an hmuha an thah loh nân Lalpan Kaina chu a chhinchhiah ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tichuan, Kaina chu Lalpa hnên ata chu a chhuak a, Eden chhak lama Nod ramah chuan a awm ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Kaina chuan a nupui a pâwl a; tichuan, a rai a, Enoka a hring a. Tin, khua a siam a, a khaw hmingah chuan a fapa hming chawiin Enok a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Enoka chuan fapa Irada a nei a, Irada chuan fapa Mehujaela a nei a, Mehujaela chuan fapa Methusaela a nei a, Methusaela chuan fapa Lameka a nei a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Lameka chuan nupui pahnih a nei a: pakhat hming chu Adai a ni a, pakhat hming chu Zillai a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Adai chuan Jabala a hring a; ani chu puan ina awm ran vulhtuho thlahtu a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />A nau hming chu Jubala a ni a; ani chu ṭingṭang leh phênglâwng tumtuho zawng zawng thlahtu a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Zillai pawh chuan Tubal-kaina, dâr leh thîr hriamhrei tinrêng chhertu a hring a. Tin, Tubal-kaina farnu chu Naami a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Lameka chuan a nupuite hnênah chuan: “Adai leh Zillai-te u, ka aw hria ula; Lameka nupuite u, ka thusawi hi ngaithla rawh u. Mi tihhliam avângin mi ka that a, Mi vuak thitlin avângin tlangvâl ka that a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kaina phuba mah a leh sariha an lâk dâwn chuan, Lameka phuba chu a leh sawmsarih leh pasarihin an la ngei ngei ang,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Adama chuan a nupui chu a pâwl leh a; tichuan, ani chuan fapa a hring leh a, a hmingah chuan Setha a sa a: “Pathianin Abela aiah chi thlah dang mi ruatsak ta; Kaina chuan amah a that ta si a,” a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Setha chuan, amah ngei pawh chuan fapa a nei ta a; a hmingah chuan Enosa a sa a. Chumi lai chuan miten Lalpa hming chu an lo lam ṭan ta a.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hei hi Adama thlahte chuanna lehkhabu chu a ni. Pathianin thu ngawta mihring a siam ni khân Pathian anpuiin amah chu a siam a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thu ngawtin mipa leh hmeichhiaah anmahni chu a siam a ni; thu ngawta siama an awm ni khân mal a sâwm a, an hmingah chuan “mihring” a vuah a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Adama chuan kum za leh kum sawmthum a nihin amah ang tak, ama anpui ngei fapa a nei a; a hmingah chuan Setha a sa a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Setha a neih hnu chuan Adama chu kum zariat a la dam a; fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Adama dam chhûng zawng zawng chu kum zakua leh kum sawmthum a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Setha chuan kum za leh kum nga a nihin fapa Enosa a nei a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Enosa a neih hnu chuan Setha chu kum zariat leh kum sarih a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tichuan, Setha dam chhûng zawng zawng chu kum zakua leh kum sâwm leh kum hnih a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Enosa chuan kum sawmkua a nihin fapa Kenana a nei a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Kenana a neih hnu chuan Enosa chu kum zariat leh kum sâwm leh kum nga a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tichuan, Enosa dam chhûng zawng zawng chu kum zakua leh kum nga a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Kenana chuan kum sawmsarih a nihin fapa Mahalalela a nei a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Mahalalela a neih hnu chuan Kenana chu kum zariat leh kum sawmli a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tichuan, Kenana dam chhûng zawng zawng chu kum zakua leh kum sawm a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Mahalalela chuan kum sawmruk leh kum nga a nihin fapa Jareda a nei a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Jareda a neih hnu chuan Mahalalela chu kum zariat leh kum sawmthum a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, Mahalalela dam chhûng zawng zawng chu kum zariat leh kum sawmkua leh kum nga a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Jareda chuan kum za leh kum sawmruk leh kum hnih a nihin fapa Enoka a nei a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Enoka a neih hnu chuan Jareda chu kum zariat a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Jareda dam chhûng zawng zawng chu kum zakua leh kum sawmruk leh kum hnih a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Enoka chuan kum sawmruk leh kum nga a nihin fapa Methusela a nei a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Methusela a neih hnu chuan, Enoka chu kum zathum chhûng zawng Pathian nên an lêng dûn ṭhîn a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, Enoka dam chhûng zawng zawng chu kum zathum leh kum sawmruk leh kum nga a ni a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Enoka chu Pathian nên an lêng dûn ṭhîn a; tin, a awm ta lo va, Pathianin a la bo ta a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Methusela chuan kum za leh kum sawmriat leh kum sarih a nihin fapa Lameka a nei a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Lameka a neih hnu chuan Methusela chu kum zasarih leh kum sawmriat leh kum hnih a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tichuan, Methusela dam chhûng zawng zawng chu kum zakua leh kum sawmruk leh kum kua a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Lameka chuan kum za leh kum sawmriat leh kum hnih a nihin fapa a nei a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, “He mi ngei hian Lalpa ânchhe lawh lei avânga kan hnathawhna leh kuta kan thawh rimnaah hian min thlamuan tawh ang,” tiin a hmingah Nova a sa a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Nova a neih hnu chuan Lameka chu kum zanga leh kum sawmkua leh kum nga a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Lameka dam chhûng zawng zawng chu kum zasarih leh kum sawmsarih leh kum sarih a ni a; tin, a thi ta a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, Nova chu kum zanga mi a ni a; Nova chuan fapa Sema te, Hama te, Japhetha te a nei a.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, heti hi a ni a, lei chungah mihring an lo puna fanute an lo neih hlawm chuan,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian fapate chuan mihring fanute chu hmêl ṭha takin an hmu a; tichuan, an duh zâwng apiang chu nupuiah an nei ta ṭhîn a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, Lalpa chuan, “Ka Thlarau chuan mihring chu kumkhuain a bei reng lo vang, anni chu tisa an ni si a; nimahsela, kum za leh kum sawmhnih chu an la dam ang,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chûng lai chuan mi lianho chu leiah hian an awm a; chumi hnuah pawh Pathian fapaten mihring fanute chu an pâwl a, an laka fate an neih ṭhin lai khân an awm bawk a. Chûngte chu hmasânga mi chak, mi hmingthangte kha an ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Lalpa chuan leiah hian mihring sualzia chu nasa tak a ni tih leh, an rilru suangtuahzia rêng rêng chu sual hlîr a ni fo mai tih a lo hria a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, leiah hian mihring a lo siam tâk avângin Lalpa chu a inchhîr a, rilru nat nân a hman phah ta a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, Lalpa chuan, “Ka mihring siam hi lei chung ata ka tiboral teh mai ang; mihring te, sa te, rannung te, chunglêng sava te nên lam hian; ka siam tâk avângin ka inchhîr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nova erawh chuan Lalpa mit a tlung a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hêng hi Nova thlahte chu an ni. Nova chu mi fel tak a ni a, a dam rualpuite zîngah chuan sawisêl bo a ni. Nova chu Pathian nên an lêng dûn ṭhîn a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Nova chuan fapa pathum: Sema te, Hama te, Japhetha te a nei a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, lei hi Pathian mit hmuhin a chhe zo tawh a, lei hi inpâwngnêknain a khat zo ta bawk a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Pathianin lei hi a en a, tin, ngai teh, a chhe zo tawh a; tisa zawng zawngin leiah hian an awm dân an tichhe zo tawh si a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Pathianin Nova hnênah, “Tisa zawng zawng tâwpna chu ka hmaah a lo thleng ta a ni, anmahni avângin lei hi inpâwngnêknain a khat zo ta si a; tichuan, ngai teh, a lei chawpin ka tiboral dâwn e.
  </para>
  <para style="p">
    <verse number="14" style="v" />I tân fâr thingin lawng siam rawh; lawngah chuan pindante i siam tûr a ni a, a chhûng lam leh a pâwn lam chu fâr hnai i hnawih vek bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, hei hi i siam dân tûr chu a ni: lawng dung lam chu tawng zathum ni sela, a vâng lam chu tawng sawmnga ni sela, a sân lam chu tawng sawmthum ni rawh se.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lawngah chuan tukverh i siam tûr a ni a, a chung lam tawng khat chinah chuan i zo tûr a ni; tin, lawng kawngka chu a pangah i siam tûr a ni a. Chhâwng hnuaihnung leh chhâwng hnihna leh chhâwng thumna neiin i siam tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, ngai teh, keimah ngeiin tisa zawng zawng, nunna thaw pai rêng rêng chu vân hnuai ata tiboral tûrin leiah hian tui ka tilêt dâwn a ni; leia thil tinrêng awm hi an thi vek ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaherawhchu, ka thuthlun chu i chungah ka tinghet zâwk ang a; lawngah chuan i lût tûr a ni: nang i lût tûr a ni a, i fapate leh i nupui leh i fapate nupuite pawh i hnênah an lût ve tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, tisa zawng zawnga thil nung tinrêng zînga mi, chi tin pahnih zêlin i hnênah tihnun ve tûrin lawngah chuan i hruai lût tûr a ni; a nu leh pa zêl an ni tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Savate anmahni chi awm dân ang ṭheuhvin, rante anmahni chi awm dân ang ṭheuhvin, leia rannung tinrêng anmahni chi awm dân ang ṭheuhvin, chi tin pahnih zêlin, i tihnun tûrin i hnênah an lo kal tûr a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, chaw in ei mi zawng zawng la la, i hnênah dah khâwm rawh; tichuan, nang leh anni tân chaw a ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutiang chuan Novan a ti a; Pathianin a hnêna thu a pêk zawng zawng ang ngei chuan a ti ta a.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Nova hnênah chuan, “Nang leh i chhûngte zawng zawng chu lawngah lût rawh u; nang zawng tûnlai ṭhangthar zîngah hian ka mit hmuhin mi fel tak i nih hi ka hria che a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sa thiang tinrêng zînga mi, a pa leh a kawppuinu nên ṭheuh tuak sarih zêlin; sa thiang lo zînga mi, a pa leh a kawppuinu nên ṭheuh tuak khat zêlin;
  </para>
  <para style="p">
    <verse number="3" style="v" />chunglêng sava zînga mi pawh, a nu leh a pa ṭheuh tuak sarih zêlin, lei chung zawng zawngah chi thlah tûra tihnun tûrin i hnênah i hruai tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ni sarih a la bâk a, chumi hnuah chuan lei chungah hian ni sawmli leh zan sawmli chhûng zawng ruah ka sûrtîr ang a, ka thil nung siam tinrêng hi lei chung ata ka tiboral ang,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Nova chuan Lalpan a hnêna thu a pêk zawng zawng ang zel chuan a ti ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, leia tui a lêt lai chuan Nova chu kum zaruk mi a ni a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, tui a lêt dâwn avângin Nova chu lawngah chuan a lût a, a fapate leh a nupui leh a fapate nupuite pawh a hnênah an lût ve a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathianin Nova thu a pêk ang khân sa thiang zînga mi pawh, sa thiang lo zînga mi pawh, sava zînga mi pawh, leia bawkvâka kal tinrêng zînga mi pawh, a nu leh a pa ṭheuh, a tuak zêlin Nova hnênah lawngah chuan an lût ta a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, ni sarih hnuah chuan leiah hian tui chu a lo lêt ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nova chu kum zaruk a nih kum, a thla hnihna ni sâwm leh ni sarih nîah, chumi ni ngei chuan tui thûk zau tak hna zawng zawngte chu a lo sah ta vek a, vân tukverhte pawh a lo inhawng ta bawk a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ni sawmli leh zan sawmli chhûng zawng leiah hian ruahpui vânâwn a sûr ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chumi ni ngei chuan Nova te, Nova fapa Sema te, Hama te, Japhetha te, Nova nupui leh a fapate nupui pathumte chu lawngah chuan an lût ta a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anniho bâkah sa tinrêng anmahni chi awm dân ang ṭheuhvin, ran zawng zawng anmahni chi awm dân ang ṭheuhvin, rannung leia bawkvâka kal tinrêng anmahni chi awm dân ang ṭheuhvin, sava tinrêng anmahni chi awm dân ang ṭheuhvin sava tinrêng, thla nei tinrêng chu an lût bawk a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tichuan, tisa zawng zawng nunna thaw pai rêng rêngte chu, a tuak zêlin Nova hnênah lawngah chuan an lût ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, a lûtte chu Pathianin a hnêna thu a pêk angin tisa zawng zawng zînga mi a nu leh a pa zêlin an lût a; tin, Lalpan ani chu a khâr khum ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, tui chu leiah hian ni sawmli chhûng zawng a lêt a; tui chu a lo awm ta pûng a, lawng chu a chîm lâng a, lei chung lamah a sêp kâng ta a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, tui chu a lo awm ta pûng pûng a, lei chungah hian a lo pung ta chiam a, lawng chu tui chungah chuan a lâng zêl a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, lei chungah hian tui chu nasa takin a lo pung a; vân hnuaia tlâng sâng zawng zawngte chu a pil zo ta vek a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tawng sâwm leh tawng nga zeta sângin a lo awm ta pûng a; tlângte chu a pil ta daih a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tichuan, tisa, lei chunga che thei zawng zawng: sava te, ran te, sa te, rannung lei chunga bawkvâka kal tinrêng te, mihring zawng zawngte chu an thi zo ta vek a.
  </para>
  <para style="p">
    <verse number="22" style="v" />An hnâra nunna thlarau thaw awmna zawng zawng, khawmuala awm apiangte chu an thi zo ta vek a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, lei chunga thil nung awm tinrêng: mihring te, ran te, rannung te, chunglêng savate chu tihboralin an awm a; lei ata tihboralin an awm ta. Nova leh lawnga a hnêna awmte chauh chu zuahin an awm ta a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, tui chu ni za leh ni sawmnga chhûng zawng chuan leiah hian a awm ta pûng mai a.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Pathianin Nova leh lawnga a hnêna thil nung tinrêng leh ramsa zawng zawng awmte chu a hre reng a; tin, Pathianin lei chung lamah hian thli a tlehtîr a; tichuan, tui chu a lo kâm ṭan ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tui thûk tak hnate leh vân tukverhte pawh chu a lo inkhâr a, vân aṭanga ruah lo sûr chu tihbânin a awm ta bawk a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, tui chu lei chung ata a kâm ta deuh deuh va. Tichuan, ni za leh ni sawmnga a ral hnu chuan tui chu a lo tlêm ta deuh va;
  </para>
  <para style="p">
    <verse number="4" style="v" />tichuan, lawng chu thla sarihna ni sâwm leh ni sarih nîah chuan Ararat tlângah a innghat ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, tui chu thla sâwmna thlengin a tlêm ta deuh deuh zêl a; tin, thla sâwmna ni khat nîah chuan tlâng chhîpte chu a lo lang ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, ni sawmli hnuah chuan heti hi a ni a, Nova chuan lawng tukverh a siam kha a hawng ta a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, choâk pakhat a thlawh chhuahtîr a; chu chu a chhuak a, lei ata tui chu a kang zawh hma loh chuan a thlâwk vêl a thlâwk vêl a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, lei chungah tui a tlêm tawh nge tawh lo tih hriat nân ṭhuro a thlawh chhuahtîr leh a;
  </para>
  <para style="p">
    <verse number="9" style="v" />nimahsela, ṭhuro chuan fûkna rêng rêng a hmu lo va, a hnênah lawngah a kîr leh ta a, tui chu lei chung zawng zawngah chuan a la awm si a. Tichuan, a kut a han zen chhuak a, a man a, lawng chhûngah chuan a hnênah a la lût leh ta a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, ni sarih dang a nghâk leh rih a, ṭhuro chu lawng aṭangin a thlawh chhuahtîr leh a.
  </para>
  <para style="p">
    <verse number="11" style="v" />ṭhuro chu tlai lamah chuan a hnênah a lo lût leh a; tin, ngai teh, a hmuiah chuan olive hnah tihthlawn hlim a rawn pu a; chutichuan, Nova chuan leiah tui a tlêm ta tih a hre ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ni sarih dang a nghâk leh pek a, ṭhuro chu a thlawh chhuahtîr leh a; tin, a hnênah a lo kîr leh ta lo va.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, heti hi a ni a, a kum zaruk leh kum khatnaah, a thla khatna ni khat nîah chuan tui chu lei ata a kang zo ta a; tichuan, Nova chuan lawng khuhna chu a hlîm a, a en a; tin, ngai teh, lei chung chu a lo hil ta tlul a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, a thla hnihna ni sawmhnih leh ni sarih nîah chuan lei chu a lo ro zo ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Pathianin Nova hnênah chuan,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Lawng ata chhuak rawh, nang leh i nupui leh i fapate leh i fapate nupuite pawh i hnênah chhuak ve rawh se.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tisa zawng zawng zînga mi thil nung tinrêng i awmpuite kha, sava te, ran te, rannung lei chunga bawkvâka kal tinrêngte nên khân i hnênah hruai chhuak rawh, leiah hian no nei ṭeuhvin, chi tam tak thlaha an lo punna tûrin,” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tichuan, Nova chu a chhuak a, a fapate leh a nupui leh a fapate nupuite pawh a hnênah an chhuak ve a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sa tinrêng te, rannung tinrêng te, sava tinrêng te, lei chunga che thei apiangte chu anmahni chi awm dân ang ṭheuhvin lawng ata chu an chhuak a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Nova chuan Lalpa tân maichâm a siam a; tin, sa thiang tinrêng zînga mi leh sava thiang tinrêng zînga mi a la a, maichâmah chuan hâlral thilhlante a hlân ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Lalpan rimtui chu a hria a; tin, Lalpa chuan a rilruin, “Lei chu mihring avângin ânchhia ka lawh leh tawh lo vang, mihring rilru ngaihtuahnate chu an naupan têt ata a sual si a; tûna ka hrem ang hian thil nung tinrêng ka hrem leh tawh hek lo vang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lei awm chhûng zawng buh tuh leh buh lâk te, khaw vâwt leh khaw lum te, nipui leh thlasik te, chhûn leh zân te chu a bo lo vang,” a ti a.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Pathianin Nova leh a fapate chu mal a sâwm a, an hnênah, “Chi tam tak thlaha lo pungin, lei hi luah khat rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmahni ṭihna leh hlauhna leia sa tinrêng leh chunglêng sava tinrêngin an nei ang; chûngte leh leia bawkvâka kal zawng zawng leh tuifinriat sangha zawng zawngte chu, in kuta pêk an ni vek tawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thil nung che thei tinrêngte chu in tân ei tûr an ni ang a; thlai hring ka pêk che u ang khân engkim ka pe vek a che u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaherawhchu, sa a nunna (a thisen) chawpin in ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, in thisen, in nunnate thisen phuba chu ka la ngei ngei ang; sa tinrêng lakah ka la ang, mihring lakah pawh. Mi tin an unaute lakah chuan, mihring nunna phuba chu ka la ṭheuh vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu pawh mihring thisen chhuahtu chu, mihring vêkin ama thisen chu an chhuah ve tûr a ni; Pathian anpuiin mihring a siam si a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, nangni chu chi tam tak thlahin lo pung rawh u; leiah hian fa tam tak hring ula, a chungah hian lo pung rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Pathianin Nova hnênah leh a hnêna awm a fapate hnênah chuan,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tin, ngai teh u, keimah ngeiin in hnênah leh in hnua in thlahte hnênah pawh ka thuthlung chu ka tinghet a ni;
  </para>
  <para style="p">
    <verse number="10" style="v" />in hnêna thil nung tinrêng awm, in awmpui sava te, ran te, ramsa tinrêngte hnênah pawh; lawng aṭanga lo chhuak zawng zawng, leia sa tinrêng hnênah lam chuan.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, in hnênah ka thuthlung chu ka tinghet ang: tisa zawng zawng tuilêta tihboralin an awm leh tawh lo vang a; lei tichhe tûrin tui a lêt leh tawh hek lo vang,” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Pathian vêkin, “Hei hi kei leh nangni leh in hnêna thil nung tinrêng awmte kâra chhuan, tâwp nei lova awm zêlte tân ka thuthlung chhinchhiahna chu a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chhûmah ka chhimbâl ka zâmtîr a, chu chu kei leh lei kâra thuthlung chhinchhiahna tûr a ni ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, heti hi a ni ang a, lei chunga chhûm ka zâmtîrin chhimbâl chu chhûmah chuan a lang ang a,
  </para>
  <para style="p">
    <verse number="15" style="v" />kei leh nangni leh tisa zawng zawng zînga mi, thil nung tinrêngte kâra ka thuthlung awm hi ka hre reng ang; tichuan, tui chu tisa zawng zawng tiboral tûrin a lêt leh tawh lo vang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, chhimbâl chu chhûmah a zâm ṭhin ang; tichuan, Pathian leh lei chunga tisa awm zawng zawng zînga mi, thil nung tinrêngte kâra kumkhaw thuthlung awm chu, ka hriat reng theihna tûrin ka en ṭhîn ang,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Pathian vêkin Nova hnênah chuan, “Chu chu kei leh lei chunga tisa awm zawng zawng kâra ka thuthlung tihngheh chhinchhiahna a ni,” a ti leh a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Nova fapa lawng aṭanga chhuakte chu Sema te, Hama te, Japhetha te an ni. Hama chu Kanaana pa a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chu mite pathum chu Nova fapate an ni a, chu mite laka chhuakte chuan lei zawng zawng hi an dâp zo ta a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Nova chu lo neituah a awm ṭan a, grêp huan a siam a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Uain chu a in a, a rui a; tichuan, a puan inah chuan a mu sual ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Hama, Kanaana pa chuan a pa mu sual chu a hmu a, pâwna a unaute pahnih chu a hrilh a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, Sema leh Japhetha chuan puan an la a, kokia inzâwnin hnungtawlhin an kal a, an pa mu sual chu an khuh ta a. An hmai chu lehlam hawiin a awm a, an pa mu sual chu an hmu lo va.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Nova chu a uain rui chu a lo harh a, a fapa naupang berin a chunga a tih zia chu a lo hre ta a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tichuan, “Kanaana chu ânchhe dawngin awm rawh se; A unaute chhiahhlawhte chhiahhlawh a ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />“ Lalpa , Sema Pathian chu fakin awm rawh se; Kanaana chu a chhiahhlawhah awm rawh se.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathianin Japhetha chu tilian sela, Sema puan inahte awm rawh se; Tin, Kanaana chu a chhiahhlawhah awm rawh se,” a ti bawk a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Nova chu tuilêt hnu chuan kum zathum leh kum sawmnga a dam a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tichuan, Nova dam chhûng zawng zawng chu kum zakua leh kum sawmnga a ni a; tin, a thi ta a.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, hêng hi Nova fapa Sema te, Hama te, Japhetha teho thlahte an ni: tuilêt hnuah chuan fapate an nei hlawm a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Japhetha fapate chu Gomera te, Magoga te, Madaia te, Javana te, Tubala te, Meseka te, Tirasa te an ni a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Gomera fapate chu Askenaza te, Riphatha te, Togarma te an ni a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Javana fapate chu Elisa te, Tarsisa te, Kittima te, Dodanima te an ni a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chûngho aṭang chuan a ni, Jentail-te thliarkârahte chuan anmahni ram rama an darh tâk ni, anmahni ṭawng ang zêl leh anmahni hnam ang zêlin anmahni chi zîngahte chuan.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Hama fapate chu Kusa te, Mizraima te, Puta te, Kanaana te an ni a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Kusa fapate chu Seba te, Havila te, Sabta te, Raama te, Sabteka te an ni a; tin, Raama fapate chu Seba leh Dedana an ni a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Kusa chuan fapa Nimroda a nei a; ani chu leia mi chak tak a lo ni ṭan ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa hmaah chuan sa pêl mi chak tak a ni a; chuvângin a ni, “Lalpa hmaa sa pêl chak tak Nimroda ang a ni,” an tih ṭhin ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, a lal ṭanna chu Sinar rama Babel khua te, Erek khua te, Akkad khua te, Kalne khua te a ni a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chumi ram aṭang chuan a chhuak a, Assuria ramah a lût a, Ninevi khua te, Rehoboth-ir khua te, Kala khua te,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ninevi leh Kala inkâra Resen khua te a siam a (chumi Resen khua chu khaw ropui tak a ni).
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Mizraima chuan Lud-ho te, Anam-ho te, Lehab-ho te, Naphtu-ho te,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathrus-ho te, Kasluh-ho (Philistin-ho chhuahna) te, Kaptor-ho te chu a thlah a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Kanaana chuan a fa tîrah Sidona a nei a, Hetha pawh a nei bawk a;
  </para>
  <para style="p">
    <verse number="16" style="v" />Jebus-ho te. Amor-ho te, Girgas-ho te leh,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiv-ho te, Ark-ho te, Sin-ho te leh,
  </para>
  <para style="p">
    <verse number="18" style="v" />Arvad-ho te, Zemar-ho te, Hamath-ho te a thlah a. Chumi hnuah chuan Kanaan-ho hnamte chu an darh zau ta a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Kanaan-ho ramri chu Sidon khua aṭangin Gerar pan zâwngin, Gaza khaw thlengin; Sodom leh Gomorra leh Adma leh Zeboiim pan zâwngin, Lasa khaw thlengin a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chûnghote chu Hama thlahte chu an ni, anmahni hnamte ang zêl leh anmahni ṭawngte ang zêlin, anmahni ram ramahte leh anmahni chi zîngahte chuan.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Sema, Ebera fa zawng zawngte thlahtu, Japhetha u pawh chuan fate a nei a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sema fapate chu Elama te, Assura te, Arpaksada te, Luda te, Arama te an ni a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Arama fapate chu Uza te, Hula te, Gethera te, Masa te an ni a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Arpaksada chuan fapa Sela a nei a; tin, Sela chuan fapa Ebera a nei a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Ebera chuan fapa pahnih a nei a: pakhat hming chu Pelega a ni a, a dam lai chuan lei hi ṭhenin a awm a; a nau hming chu Joktana a ni a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Joktana chuan fapa Almodada te, Selepha te, Hazarmavetha te, Jera te leh,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadorama te, Uzala te, Dikla te leh,
  </para>
  <para style="p">
    <verse number="28" style="v" />Obala te, Abimaela te, Seba te leh,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ophira te, Havila te, Jobaba te a nei a. Chûng zawng zawng chu Joktana fapate an ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, an awmna chu Mesa aṭangin khawchhak tlâng Sephar lam pan zâwngin a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chûnghote chu Sema thlahte chu an ni, anmahni hnamte ang zêl leh anmahni ṭawngte ang zêlin, anmahni ram ramahte, anmahni chite ang zêl chuan.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chûnghote chu Nova thlahho hnamte an ni a, an thlahte ang zêlin, an chite zîngah chuan; tuilêt hnuah chûngho aṭang chuan a ni, leiah hian chi tin an darh tâk ni.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, leia mi zawng zawng chu ṭawng hmun khat leh thusawi dân hmun khat an ni vek a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, heti hi a ni a, khawchhak lama an insawn zêl lai chuan Sinar ramah phaizâwl an hmu a; chutah chuan awm hmun an khuar ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, “Hawh u, leirawhchan siam ila, ṭha takin i rawh ang u,” an ti hlawm a. Tichuan, lung aiah leirawhchan an hmang a, a châr nân alkatra an hmang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, “Hawh u, khawpui siam ila, in sâng a chhîpina vân tawng tûrin sa bawk ila, kan hming i tithang ang u; chuti lo chuan, lei chung zawng zawngah hian tihdarhin kan awm dah ang e,” an ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Lalpa chu mihring faten khawpui leh in sâng an siam vêl chu en tûrin a zuk chhuk a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Lalpa chuan, “Ngai teh u, mite hi pumkhat an ni a, an zain ṭawng hmun khat an nei si a, hei thil an ti ṭan a nih hi; tûnah zawng an thiltih tum rêng rêngte pawh khap rual a ni tawh lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hawh u, i zuk kal ang u khai, ṭawng an inhriat tawn theih loh nân khutah khuan an ṭawng i zuk tihhransak ang u,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichuan, Lalpan anniho chu chuta ṭang chuan lei zawng zawngah chuan a tidarh a; tichuan, an khaw siam chu an bânsan ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuvângin, a hming chu Babel an ti a, Lalpan chutah chuan leia mi zawng zawng ṭawng chu a tihhran tâk avângin; chuta ṭang chuan Lalpan anniho chu lei chung zawng zawngah chuan a tidarh ta bawk a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hêng hi Sema thlahte chu an ni: Sema chu kum za mi a ni a, tuilêt hnu kum hnihah chuan fapa Arpaksada a nei a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arpaksada a neih hnu chuan Sema chu kum zanga a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Arpaksada chuan kum sawmthum leh kum nga a nihin fapa Sela a nei a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sela a neih hnu chuan Arpaksada chu kum zali leh kum thum a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sela chuan kum sawmthum a nihin fapa Ebera a nei a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ebera a neih hnu chuan Sela chu kum zali leh kum thum a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ebera chuan kum sawmthum leh kum li a nihin fapa Pelega a nei a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pelega a neih hnu chuan Ebera chu kum zali leh kum sawmthum a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pelega chuan kum sawmthum a nihin fapa Reuva a nei a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Reuva a neih hnu chuan Pelega chu kum zahnih leh kum kua a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Reuva chuan kum sawmthum leh kum hnih a nihin fapa Seruga a nei a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Seruga a neih hnu chuan Reuva chu kum zahnih leh kum sarih a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Seruga chuan kum sawmthum a nihin fapa Nahora a nei a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nahora a neih hnu chuan Seruga chu kum zahnih a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nahora chuan kum sawmhnih leh kum kua a nihin fapa Tera a nei a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tera a neih hnu chuan Nahora chu kum za leh sâwm leh kum kua a la dam a, fanu leh fapate a nei leh hlawm a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tera chuan kum sawmsarih a nihin fapa Abrama te, Nahora te, Harana te a nei a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hêng hi Tera thlahte chu an ni: Tera chuan fapa Abrama te, Nahora te, Harana te a nei a. Tin, Harana chuan fapa Lota a nei a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Harana chu a pianna rama Kaldai-ho khua Ur-ah, a pa Tera hmaah chuan a thi a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Abrama leh Nahora chuan nupui an nei a: Abrama nupui hming chu Saraii a ni a; Nahora nupui hming chu Harana fanu Milkai a ni a, Harana chu Milkai pa leh Iskai pa a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Saraii chu a ching a; fa rêng a nei lo va.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Tera chuan a fapa Abrama te, a fapaa fapa (Harana fapa) Lota te, a mo, a fapa Abrama nupui Saraii te a hruai a; tin, Kanaan-a kal tûrin Kaldai-ho khua Ur aṭang chuan an chhuak ho ta a; tin, Haran khua an thleng a, chutah chuan awm hmun an khuar ta a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, Tera dam chhûng chu kum zahnih leh kum nga a ni a; tin, Tera chu Haran khuaah chuan a thi ta a.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpan Abrama hnênah chuan, “I khaw lam ata leh i laichînteho zîng ata leh i pa in ata chhuak la, ram ka la entîr tûr che lamah kal rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, chi ropui takah ka siam ang chia; mal pawh ka sâwm ang chia, i hming ka tiropui bawk ang; tin, nang malsâwmna ni ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, malsâwmsaktu apiang che chu mal ka sâwm ang a, ânchhe lawhtu che chu ânchhia ka lawh ang; nangmahah chuan leia hnam tin an la thawveng ang,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutichuan, Abrama chu Lalpan a hnêna a sawi angin a kal ta a, Lota chu a hnênah a kal ve a. Tin, Abrama chu Haran khua ata a chhuah lai chuan kum sawmsarih leh kum nga mi a ni a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Abraman a nupui Saraii leh, a nau fapa Lota leh an sum deh chhuah zawng zawng leh, Haran khuaa an mi neih tâkte chu a hruai a, Kanaan rama kal tûrin an chhuak a. Tin, Kanaan ram chu an thleng ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abrama chu chumi ramah chuan Sekem hmun thlengin, More sasua thleng chuan a kal zêl a. Chûng lai chuan Kanaan-hote chu chumi ramah chuan an awm a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Lalpa chu Abrama hnênah a inlâr a, “He ram hi i thlahte hnênah ka la pe ang,” a ti a. Tichuan, chutah chuan a hnêna inlâr Lalpa tân chuan maichâm a siam a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, chuta ṭang chuan Bethel chhak lama tlângah chuan a insawn a, chutah chuan a puan in a zâr a, a thlang lamah chuan Bethel chu a awm a, a chhak lamah Ai khua a awm a; chutah chuan Lalpa tân maichâm a siam leh a, Lalpa hming chu a lam a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Abrama chu chhim ram lam pan cheuvin a insawn ta zêl a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, chumi ramah chuan ṭâm a lo tla a; tin, chumi ramah chuan ṭâm chu a nasat êm avângin, Abrama chu Aigupta rama awm rih tûrin a chhuk ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, heti hi a ni a, Aigupta rama an luh dâwn lai chuan a nupui Saraii hnênah chuan, “Ngai teh, hmeichhe hmêl ṭha tak i ni tih ka hria.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tichuan, hetiang hi a ni ang, Aigupta-hovin an hmuh hunah che chuan, ‘Hei hi a nupui a nih hi,’ an ti ang a; tin, kei chu min that mai ang, nang erawh chu an zuah ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />I zâra ṭha taka ka awm theih nân leh nangmah avânga ka nun theih nân, ‘A farnu ka ni,’ khawngaih takin ti zêl ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, heti hi a ni a, Abrama chu Aigupta rama a luh chuan, Aigupta-ho chuan hmeichhia chu an hmu a, a hmêl chu ṭha an ti êm êm a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharaoa mi liante pawhin an hmu a, Pharaoa inah an hruai lût ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, ani chuan Saraii avângin Abrama chu ṭha takin a ti a; tichuan, berâm te, bâwngpa te, sabengtungpa te, bâwihpa te, bâwihnu te, sabengtungnu te, sanghâwngsei te a neih phah ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Lalpa chuan Abrama nupui Saraii avângin, Pharaoa leh a chhûngte chu sawisak namênin a sawisa ta lo va.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tichuan, Pharaoa chuan Abrama chu a ko va, “Ka chunga i thiltih hi eng tizia nge ni le? I nupui a ni tih engati nge mi hrilh loh?
  </para>
  <para style="p">
    <verse number="19" style="v" />‘Ka farnu a ni,’ engati nge i tih? Chumi avâng chuan alâwm ka nupuia ka lo neih tâk hial ni. Aw le, tûnah en rawh i nupui hi, hruai la, kal daih rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Pharaoa chuan a chungchâng thûah chuan mi hnênah thu a pe a; tichuan, amah an han thlah ta a, a nupui nên, a neih zawng zawng nên.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Abrama chu Aigupta ram aṭang chuan a chhuak a, chhim ramah chuan a chho ta a, a hnênah chuan a nupui te, a neih zawng zawng te, Lota te an chho ve a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Abrama chu ran te, tangkarua te, rangkachak tein a hausa êm êm a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, chhim ram aṭang chuan Bethel thleng zakin a kal zêl a, Bethel leh Ai khaw inkâra a tîra a puan in awmnaah khân,
  </para>
  <para style="p">
    <verse number="4" style="v" />a tîra a maichâm siamna ngeiah khân; tin, chutah chuan Abrama chuan Lalpa hming a lam a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Lota, Abrama hnêna kal ve pawh khân bêram rual te, bâwng rual te, puan in te a nei ve a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, an awm dunna tûrin ramin a daih ta lo va, an thil neih chu a nasa êm si a; chutichuan, an awm dûn thei ta hlawl lo va.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, Abrama ran pute leh Lota ran pute kârah chuan inhnialna a lo chhuak ta a. Chumi lai chuan Kanaan-hote leh Periz-hote chu chumi ramah chuan an awm a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tichuan, Abraman Lota hnênah, “Khawngaih takin, nang leh keia kârah, i ran pute leh ka ran pute kârah pawh inhnialna awm suh se; unau kan ni si a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ram chu a pum puiin a awm duai lo vem ni? Khawngaih takin ka hnên ata hi intihrang mai rawh. Nang vei lama i kal chuan kei ding lamah ka kal ang a; a nih loh leh, nang ding lama i kal chuan kei vei lamah ka kal ang e,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tichuan, Lota chu a dâk a, Zoar khaw lam pan zâwng chuan Jordan phaizâwl zawng zawng chu Lalpa huan ang, Aigupta ram anga ram tina tui tam tak awm chukna a ni tih a hria a, Lalpan Sodom leh Gomorra khua a tihchhiat hma kha a ni si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutichuan, Lota chuan Jordan phaizâwl zawng zawng chu a thlang ta a; tin, Lota chu chhak lamah chuan a insawn a. Tichuan, an inṭhen ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abrama chu Kanaan ramah chuan a awm a, Lota chu phaizâwl khuaahte chuan a awm a, a puan in chu Sodom khaw thlengin a sawn zêl a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Sodom mite chu Lalpa mit hmuhin nasa taka suaksual leh mi sual an ni a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, a hnên ata Lota a awm hran hnu chuan Lalpan Abrama hnênah, “Dâk la, i awmna aṭang khân hmâr lam te, chhim lam te, chhak lam te, thlang lam te en rawh;
  </para>
  <para style="p">
    <verse number="15" style="v" />i ram hmuh zawng zawng hi kumkhua atân nang leh i thlahte ka pe dâwn che u a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, i thlahte chu leia vaivut ang maiin ka la siam ang; chutichuan, miin leia vaivut hi an chhiar sên chuan, i thlahte pawh chhiar sên an ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tho la, ram hi a dung leh a vâng fang chhuak rawh; ka pe dâwn che a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tichuan, Abrama chuan a puan in chu a sawn a, Hebron-a awm Mamre sasaw kiangahte chuan awm hmun a va khuar a, chutah chuan Lalpa tân maichâm a siam a.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Sinar khaw lal Amraphela te, Ellasar khaw lal Arioka te, Elam khaw lal Kedorlaomera te, Goiim khaw lal Tidala te dam lai chuan heti hi a ni a,
  </para>
  <para style="p">
    <verse number="2" style="v" />anni chuan Sodom khaw lal Bera chu an rûn a, Gomorra khaw lal Birsa te, Adma khaw lal Sinaba te, Zeboiim khaw lal Semebera te, Bela khaw lal te chu an rûn bawk a (Bela khua chu Zoar khua a ni a).
  </para>
  <para style="p">
    <verse number="3" style="v" />Chûngho zawng zawng chu Siddim ruamah chuan an ṭang tlâng a (chumi ruam chu Tuifinriat Al a ni a).
  </para>
  <para style="p">
    <verse number="4" style="v" />Kum sâwm leh kum hnih chhûng Kedorlaomera hnuaiah an awm a, a kum sâwm leh kum thumnaah erawh chuan an hel ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, a kum sâwm leh kum linaah chuan Kedorlaomera leh a hnêna lal awmte chu an lo kal a, Asteroth-karnaim khuaah Rephaim-hote an that a, Ham khuaah Zuzim-hote an that a, Kiriathaim khuaah Emim-hote an that a,
  </para>
  <para style="p">
    <verse number="6" style="v" />an awmna Seir tlângah, El-paran thlengin Hor-hote an that a (El-paran chu thlalêr depa awm a ni).
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, an kîr leh a, En-mispat an thleng a (chu chu Kadesh a ni a). Amalek-ho rama mi zawng zawng leh Amor-ho, Hazazon-tamar khuaa awmte pawh chu an that leh a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tichuan, Sodom khaw lal te, Gomorra khaw lal te, Adma khaw lal te, Zeboiim khaw lal te, Bela khaw lal te chu an chhuak a (Bela khua chu Zoar khua a ni a); tin, Siddim ruamah chuan anniho chu bei tûrin an ṭang tlat a;
  </para>
  <para style="p">
    <verse number="9" style="v" />Elam khaw lal Kedorlaomera te, Goiim khaw lal Tidala te, Sinar khaw lal Amraphela te, Ellasar khaw lal Arioka te chu bei tûrin; lal paliin lal panga an bei a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Siddim ruam chu alkatra khurin a khat a; tin, Sodom leh Gomorra khaw lalte chu an tlânchhia a, chutah chuan an tla a, a tla bângte chu tlângah chuan an tlân bo ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tichuan, Sodom leh Gomorra mite sum zawng zawng leh an ei tûr zawng zawng chu an la a, an haw ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lota, Abrama unauva fapa, Sodom khuaa awm chu, a sumte nên an la bawk a, an kal ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, mi pakhat tlân chhuak chu a lo kal a, Hebrai mi Abrama chu a hrilh a; ani chu Amor mi Mamre-a sasaw kiangahte chuan a awm a. Mamre-a chu Eskola leh Anera unau a ni a; chûng mite chu Abrama te nêna ṭang za an ni a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Abraman a fa chu salah an hruai tih a hriat veleh, a ina piang, ama mi, zir thiam sa tawh, zathum leh sâwm leh pariat a hruai chhuak a, Dan khaw thlengin a ûm ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, zânah chuan anmahni bei tûrin amah leh a bâwihte chu an insem darh a, anniho chu an that a, Hoba khaw thlengin an ûm a (Hoba chu Damaska khaw hmâr lamah a awm a).
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, sum zawng zawng chu a rawn la kîr leh vek a, a fa Lota leh a sumte chu a rawn la leh vek bawk a, hmeichhiate pawh a rawn hruai leh a, mi dang zawng zawngte nên.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Kedorlaomera leh a hnêna lal awmte thata a hâwn hnuah chuan, Sodom lal chu Save ruamah chuan Abrama hmuakin a chhuak a (Save ruam chu Lal ruam a ni a).
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Salem khaw lal Melkisedeka chuan chhang leh uain a rawn la a; ani chu Pathian Chungnungbera puithiam a ni a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, ani chuan Abrama chu mal a sâwm a, “Lei leh vân neitu Pathian Chungnungbera chuan Abrama malsâwm rawh se.
  </para>
  <para style="p">
    <verse number="20" style="v" />I hmêlmate i kuta petu, Pathian Chungnungbera chu fakin awm bawk rawh se,” a ti a. Tin, Abrama chuan ani chu engkim sâwma pakhat a pe a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Sodom khaw lal chuan Abrama hnênah, “Mihringte hi mi pe la, sumte hi chu nangman nei rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Abrama chuan Sodom khaw lal hnênah chuan, “La zai khat tê pawh, pheikhawk chilhna pakhat tê pawh, i neih rêng rêng chu ka la lo vang, tiin lei leh vân neitu, Lalpa , Pathian Chungnungbera lamah chuan ka kut ka phar tawh a ni; chuti lo chuan, ‘Abrama chu keima tihhausak alâwm,’ i ti dah ang e:
  </para>
  <para style="p">
    <verse number="24" style="v" />tlangvâlho ei ral leh ka mi kalpuite chanvo chauh lo chu ka la lo vang; Anera te, Eskola te, Mamre-a te chuan an chanvo chu la rawh se,” a ti a.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chûng thil hnuah chuan, “Abram, hlau suh, kei hi i phaw leh i lâwmman nasa tak mai ka ni asin,” tiin, Lalpa thu chu Abrama hnênah mumang angin a lo thleng a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Abrama chuan, “Aw Lalpa Pathian, eng nge mi pêk ang, fa nei lovin ka awm hlen dâwn a, ka ro khâwmtu tûr chu Damaska khuaa mi Eliezera hi a ni si a?” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Abrama vêkin, “Ngai teh, chi rêng rêng mi thlahtîr si lo va; en teh, ka ina piang hi ka roluahtu tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, ngai teh, “Kha mi kha i roluahtu tûr a ni lo vang; nangma rîla lo la rah tûr ngei chu i roluahtu tûr a ni zâwk ang,” tiin Lalpa thu chu a hnênah a lo thleng a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, ani chu pâwnah a hruai chhuak a, “Vân lam khi en la, arsite khi i chhiar theih chuan chhiar teh khai,” a ti a. Tin, amah vêkin a hnênah, “I thlahte chu khiti zât khi an la ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, ani chuan Lalpa chu a ring a; tichuan, ani chuan chu chu a felnaah a ruat ta a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, a hnênah, “He ram hi luah tûra pe tûr chea Kaldai-ho khua Ur ata hruai chhuaktu che Lalpa kha ka ni,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, ani chuan, “Aw Lalpa Pathian, ka luah ang tih engtin nge ka hriat ang?” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, ani chuan a hnênah, “Bâwngla kum thum mi leh kêlpui kum thum mi leh berâmpa kum thum mi leh ṭhuro leh pârvano mi rawn lâk rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tichuan, chûng zawng zawng chu a rawn lâksak a, a lai takah a phel ṭheuh va, a phel pakhat chu a phel lehlam zâwnah chuan a dah ṭheuh zêl a; savate erawh chu a phel ve lo va.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, sava sa hel ei mite chu sa ruangahte chuan an zuk fu ṭhîn a, Abrama chuan a lo hnawt kiang zêl a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ni tlâk dâwn suar suar lai chuan Abrama chu a lo muhîl ta dêr mai a; tin, ngai teh, thim nasa tak, thil râpthlâk zet hian amah a rawn khuh a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Pathian chuan Abrama hnênah, “I thlahte chu anmahni ram lovah chuan mikhualin an la awm ang a, an rawng an la bâwlsak ang tih chiang takin hre rawh khai; tin, kum zali an tirethei ang a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, an rawng an bâwlsakate chi pawh chu ka la ngaihtuah ang a; tin, chumi hnuah chuan sum tam tak neiin an lo la chhuak ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang erawh chu i thlahtute hnênah thlamuang takin i kal ang a; i lua kêlsam ṭo vekin an phûm ang che.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, chhuan linaah chuan hetah hian an lo kal leh ang; Amor-ho sualnate hi a la kim rih si lo,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, heti hi a ni a, ni a tlâka khua a lo thim chuan, ngai teh, rawh tuina mei khu mup mup leh chûng sa phel kârah chuan, meichher alh hluah hluah kal kal a lo awm a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chumi ni chuan Lalpa chuan, “He ram hi, Aigupta lui aṭanga lui lian pui (Euphrates lui) thlengin i thlahte ka pe tawh:
  </para>
  <para style="p">
    <verse number="19" style="v" />Ken-ho te, Keniz-ho te, Kadmon-ho te,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hit-ho te, Periz-ho te, Rephaim-ho te,
  </para>
  <para style="p">
    <verse number="21" style="v" />Amor-ho te, Kanaan-ho te, Girgas-ho te, Jebus-ho te nên hian ka pe bawk a,” tiin Abrama hnênah chuan thu a thlung ta a.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Abrama nupui Saraii chuan fa rêng rêng a hrinsak lo va; tin, Saraii chuan Aigupta mi bâwihnu pakhat a nei a, chu mi hming chu Hagari a ni a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Saraii chuan Abrama hnênah, “Ngai teh khai, Lalpan fa mi neihtîr phal loh hi; khawngaih takin ka bâwihnu hi pâwl rawh; ama lakah chuan fate ka nei mahna,” a ti a. Tichuan, Abrama chuan Saraii thu chu a zâwm ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, Abrama nupui Saraii chuan, Abrama chu Kanaan rama kum sâwm a awm hnu chuan, a bâwihnu Aigupta mi Hagari chu a hruai a, a pasal Abrama hnênah chuan a nupuia awm tûrin a pe a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Hagari chu a lo pâwl a; tin, ani chu a rai ta a. Tin, a rai tih a inhriat veleh a pi chu a hmusit ta mai a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Saraii chuan Abrama hnênah, “Ka thil tuar hi nangin a mawh phur rawh! Ka bâwihnu chu i pawm atân ka pe chia; tin, a rai tih a inhriat veleh mi hmusit ta mai a. Lalpa chuan nang leh keia thu hi ngaihtuah rawh se,” a ti a:
  </para>
  <para style="p">
    <verse number="6" style="v" />Abrama erawh chuan Saraii hnênah, “Ngai teh, i bâwihnu chu i kuta awm alâwm; i remtih ang apiang chu a chungah ti ta che,” a ti a. Tichuan, Saraii chuan a tirethei ta hle a; chuvângin, a tlân bosan ta a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Lalpa vântirhkoh chuan thlalêrah tuikhur kiangah, Sur panna kawnga tuikhur kiangah chuan a lo hmu a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, a hnênah, “Hagar, Saraii bâwihnu, khawi aṭangin nge i lo kala, khawiah nge i kal dâwn?” a ti a. Tin, ani chuan, “Ka pi Saraii hnên ata ka tlân bo a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Lalpa vântirhkoh chuan a hnênah, “I pi hnênah kîr leh la, a thû thûin awm rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Lalpa vântirhkoh vêk chuan a hnênah, “I thlahte chu chhiar sên loh khawp hiala tamin ka la tipung ang,” a ti leh a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Lalpa vântirhkoh vêk chuan a hnênah, “Ngai teh, nau i pai ta a, fapa i hring ang a; Lalpa chuan i hrehawmzia hi a hriat tâk avâng hian a hmingah chuan Ismaela i sa tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ani chu mihring zînga ram sabengtung ang a ni ang; ani chuan mi tin a do vang a, mi tinin ani pawh an do bawk ang; a unau zawng zawng depah a awm bawk ang,” a ti leh pek a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Hagari chuan amah betu Lalpa hming chu, “Nang hi hmutheitu Pathian i ni,” tiin a vuah a, “Hetah ngei hian mi hmutu chu ka en zui zêl em ni aw?” a ti a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chumi avâng chuan tuichhunchhuah chu “Beer-lahai-roi” vuah a ni ta a; ngai teh, Kadesh leh Bered khaw inkârah a awm.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Hagari chuan Abrama chu fapa a hrinsak a; tin, Abrama chuan a fapa Hagari hrin chu a hmingah Ismaela a sa ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Hagarin Abrama tân Ismaela a hrin lai chuan Abrama chu kum sawmriat leh kum ruk mi a ni a.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Abrama chu kum sawmkua leh kum kaw mi a nihin, Lalpa chu Abrama hnênah chuan a rawn inlâr a, a hnênah, “Kei, Pathian Engkimtitheia ka ni; ka hmaah awm la, ṭha famkimin awm rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, nangmah nêna kan inkârah thu ka thlung ang a, nasa takin ka tipung ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Abrama chu a bawkkhup ta a; tin, Pathianin ani chu a bia a,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ngai teh, kei zawngin ka thuthlung chu i hnênah a ni ka thlun ni; tichuan, chi hrang hrang tam tak thlahtu i ni tawh ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />I hming pawh Abrama a ni tawh lo vang a, i hming hi Abrahama a ni tawh zâwk ang; chi hrang hrang tam tak thlahtu tûra ka siam tâk che hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, nasa takin chi ka thlahtîr ang chia, nangmahah chuan chi tih tham zet zette ka siam ang a, nangmah aṭang chuan lalte an lo chhuak bawk ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, kei leh nang leh i hnua i thlahte, an thlah chhâwng zêlte thleng pawhin ka thuthlung hi, i tân leh i hnua i thlahte tâna an Pathian ni tûrin, kumkhaw thuthlung atân ka tinghet ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, i hnênah leh i hnua i thlahte hnênah chuan i mikhualna ram, Kanaan ram zawng zawng hi kumkhaw ro atân ka pe dâwn che u a ni; tin, kei hi an Pathian ka ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Pathian vêkin Abrahama hnênah chuan, “Tin, nang zawngin ka thuthlung hi i zâwm tûr a ni; nangin i zâwm tûr a ni a, i hnua i thlahte, an thlah chhâwng zêlte thleng pawhin an zâwm ve tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hei hi kei leh nang leh i hnua i thlahte kâra ka thuthlung i zawm tûr chu a ni; in zînga mipa tawh phawt chu serhtan tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tichuan, in serh vun tisaah chuan serhtanin in awm tûr a ni; chu chu nangmah nêna kan inkâra thuthlung chhinchhiahna a ni ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tichuan, in zînga ni riat mi chu, in thlah chhâwng zêlte thleng pawhin, i thlah ni kher lo pawh, i ina piang emaw, mikhual tu laka mi pawh tangka suma i lei emaw pawh ni sela, mipa tawh phawt chu serhtan tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />I ina piang leh i tangka suma i lei pawh serhtan ngei tûr a ni; tichuan, ka thuthlung chu kumkhaw thuthlung atân in tisaah a awm tawh ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, mipa serhtan loh, a serh vun tisaa serh tana awm lo chu, chu mi ngei chu a chipui zîng ata tihboral a ni ang; ani chuan ka thuthlung chu a bawhchhia a ni,” a ti leh a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Pathian vêkin Abrahama hnênah, “I nupui Saraii pawh, a hmingah Saraii i ti tawh lo vang a, a hming chu Sari a ni tawh zâwk ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, ani chu mal ka sâwm ang a, chu lo pawh chu ama lakah chuan fapa ka pe ang che; a ni, amah chu mal ka sâwm ang a, chi hrang hrang thlahtunu a ni tawh ang; hnam hrang hrang lalte ama lakah chuan an lo la chhuak ang,” a ti leh pek a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutichuan, Abrahama chu a bawkkhup a, a nui a, a rilruin, “Kum za mi hian fa a nei dâwn em ni ang? Sari, kum sawmkaw mi chuan fa a hring dâwn em ni ang?” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Abrahama vêk chuan Pathian hnênah, “Ismaela hi i hmaah awm thei sela aw!” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Pathianin, “Ni lo ve, i nupui Sarin fapa a hrinsak zâwk ang che, a hmingah chuan Isaaka i sa tûr a ni; tin, ka thuthlung chu ama hnua a thlahte tân, kumkhaw thuthlung atân a hnênah chuan ka tinghet ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ismaela chung thu pawh hi ka ngaihthlâksak che a ni; ngai teh, amah chu mal ka sâwm tawh a, chi tam tak ka thlahtîr ang a, nasa takin ka tipung bawk ang; ani chuan lal sâwm leh pahnih a hring ang a, amah chu chi ropui takah ka la siam ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka thuthlung erawh chu Isaaka, Sarin nakkum hetih hun taka a hrinsak tûr che hnênah chuan a ni ka tihngheh zâwk dâwn ni,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tichuan, a hnêna a thusawi chu a bâng a; tin, Pathian chuan Abrahama chu a chhohsan ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Abrahama chuan a fapa Ismaela leh, a ina piang zawng zawngte leh a tangka suma a lei zawng zawng, Abrahama chhûngte zînga mi mipa tawh phawt chu a hruai a, Pathianin a hnêna a sawi tawh angin, chumi ni ngei chuan an serh vun tisa chu a tansak ta a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Abrahama chu a serh vun tisaa a serh an tan lai chuan kum sawmkua leh kum kaw mi a ni a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, a fapa Ismaela chu a serh vun tisaa a serh an tan lai chuan kum sâwm leh kum thum mi a ni a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chumi ni ngei chuan Abrahama leh a fapa Ismaela chu serhtan an lo ni ta a.
  </para>
  <para style="p">
    <verse number="27" style="v" />A chhûngte zînga mipa zawng zawng, a ina piangte leh mikhual laka tangka suma a leite pawh, ama rual chuan serhtan an lo ni ta vek a.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abrahama chu chhûn ni lum lai taka puan in kawngka bula a ṭhut laiin, Lalpa chu Mamre sasaw kiangahte chuan a hnênah a rawn inlâr a;
  </para>
  <para style="p">
    <verse number="2" style="v" />tin, a han dâk a, a en a; tin, ngai teh, a zâwn lawkah chuan mi pathum an lo ding reng a; tin, a hmuh veleh puan in kawngka ata chu anmahni lâwm tûrin a va tlân a, lei siin chibai a bûk a,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ka pu, mi khawngaih theih chuan, khawngaih takin i chhiahhlawh hi mi kal pêl lul suh ang che u;
  </para>
  <para style="p">
    <verse number="4" style="v" />tui tlêm tal rawn la sela, in kete sil ula, thing hnuaiah hian châwl teh rih u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chhang tlêm tal ka va la ang a, in thinlung tiharh ang che u; chumi hnuah chuan in kal zêl dâwn nia; chumi avânga in chhiahhlawh hnêna lo kal hi in ni châwk ang a,” a ti a. Tin, anni chuan, “I sawi ang chuan va ti rawh,” an ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, Abrahama chu puan in chhûngah Sari hnênah chuan a lût thuai a, “Rang takin chhangphut dip tak tehkhâwng thum siam la, hmet la, chhangpêrahte siam rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Abrahama chu bâwng rual lamah a va tlân a, bâwngno nalh ṭha zet hi a rawn la a, chhiahhlawh hnênah a pe a; tin, ani chuan a lo siam thuai thuai a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, hnute tui khal te, hnute tui te, bâwngno sa siamte chu a la a, an hmaah a va hlui ta a; tin, thing hnuaiah chuan an kiangah a ding reng a, anni chuan an ei ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, anni chuan a hnênah, “I nupui Sari khawiah nge a awm?” an ti a. Tin, ani chuan, “Saw puan inah sâwn,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, ani chuan, “Hun hi a lo thlen leh tikah chuan i hnênah ka lo kal leh ngei ngei ang a; tin, ngai teh, i nupui Sari chuan fapa a nei ang,” a ti a. Tin, a hnunga puan in kawngka bul aṭang chuan Sarin a lo hria a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abrahama leh Sari chu upa tak, tar tawh tak an ni a; hmeichhe dân pângngai chu Sari chungah chuan a reh daih tawh a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tichuan, Sarin, “Tar ka nih tawh hnu hian lâwmna ka nei ang maw, ka lalpa lah a upa tawh bawk si a?” tiin a rilruin a nui a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Lalpa chuan Abrahama hnênah, “Engati nge Sarin, ‘Kei tar hian fa ka hring êm ang maw?’ tia a nuih?
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa tân thil rêng rêng a harsa lutuk em ni? Hun ruatah, hun a lo thlen tikah chuan i hnênah ka lo kal leh ang a; tin, Sari chuan fapa a nei ang,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutichuan, Sari chuan. “Ka nui lo,” tiin a pha a; a hlau si a. Tin, ani chuan, “Awih loh loh tûr; i nuih ngei kha le,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, mite chu chuta ta chu an tho va, Sodom khaw lam chu an en a; tin, Abrahama chu anmahni thlah tûrin an hnênah a kal ve a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Lalpa chuan, “Ka thiltih tûr hi Abrahama lakah hian ka zêp ang em aw?
  </para>
  <para style="p">
    <verse number="18" style="v" />Abrahama hi chi ropui leh thiltithei tak a lo la ni ngei dâwn a, amahah chuan khawvêla chi tin an la thawveng dâwn si a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa kawng an zawh theih nân a hnua a fate leh a chhûngte, thil fel taka ti tûr leh rorêl anga ti tûra thu a pêk theihna tûrin ani chu ka ruat tawh si a; chutichuan, a chungchâng thû a sawia chu Lalpan Abrahama chunga a thlentîr theihna tûrin,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Lalpa chuan, “Sodom leh Gomorra khaw au thâwm chu a nasain, an sual nasa êm êm ngei mai;
  </para>
  <para style="p">
    <verse number="21" style="v" />tûnah ka zuk kal ang a, an au thâwm ka hnêna lo thleng ang ngei hian an ti nge ti lo ka en ang a; an tih loh chuan ka hre mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, mite chu chuta ta chu an hawi a, Sodom khaw lam chu an pan ta a; Abrahama erawh chu Lalpa hmaah chuan a la ding reng a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Abrahama chuan a va hnaih a, “Mi felte chu mi sualte zîngah i tiboral ve dâwn em ni?
  </para>
  <para style="p">
    <verse number="24" style="v" />Khaw chhûngah chuan mi fel sawmnga tal an awm mahna; a chhûnga mi fel sawmnga awmte avâng chuan khua chu zuah phah lovin i tiboral dâwn em ni?
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang êm chuan chutiang chuan mi felte chu mi sualte anga an awm vena tûra, mi felte chu mi sualte zînga tihhlum ve mai te chu i ti âwm êm si lo va; nang êm chuan i ti âwm êm si lo! Lei chung zawng zawng Rorêltu chuan fel takin a ti dâwn lâwm ni?” a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Lalpa chuan, “Sodom khaw chhûngah chuan mi fel sawmnga pawh ka hmuh chuan, anmahni avâng chuan khaw pum pui chu ka zuah mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, Abrahama chuan, “Ngai teh, kei vaivut leh meivâp mai hian Lalpa chu ka be pawp ta sa che:
  </para>
  <para style="p">
    <verse number="28" style="v" />mi fel chu pangain sawmnga an tling lo a ni mahna; pangaa an tlin loh avângin khaw pum pui chu i tiboral dâwn em ni?” a ti a, a chhâng a. Tin, ani chuan, “Chutah chuan sawmli leh panga pawh ka hmuh chuan ka tiboral lo vang,” a ti a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, ani chuan amah chu a be leh zêl a, “Chutah chuan sawmli chauh i hmu a ni mahna,” a ti a. Tin, ani chuan, “Sawmli avâng pawh chuan ka tiboral lo mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, ani chuan, “Aw, Lalpa chu thinur suh ang che, ka han sawi leh teh ang: chutah chuan sawmthum chauh i hmu a ni mahna,” a ti a. Tin, ani chuan, “Chutah chuan sawmthum pawh ka hmuh chuan ka tiboral lo mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, ani chuan, “Ngai teh, Lalpa chu ka be pawp ta sa che: chutah chuan sawmhnih chauh i hmu a ni mahna,” a ti a. Tin, ani chuan, “Sawmhnih avâng pawh chuan ka tiboral lo vang,” a ti a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, ani chuan, “Aw, Lalpa chu thinur suh ang che, vawi khat chauh chuan ka han sawi leh teh ang: chutah chuan sâwm chauh i hmu a ni mahna,” a ti a. Tin, ani chuan, “Sâwm avâng pawh chuan ka tiboral lo vang,” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tichuan, Lalpa chu Abrahama nêna an inbiak zawh veleh chuan a kal ta a; tin, Abrahama chu ama awmna lamah a kîr leh ta a.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, vântirhkoh pahnih chuan tlai lamah Sodom khua an zuk thleng a; Lota chu Sodom khaw kulh kawngkhârah chuan a lo ṭhu a; tin, Lotan anmahni a lo hmu a, lâwm tûrin a ding ta a; tin, a hmaia lei siin chibai a bûk a;
  </para>
  <para style="p">
    <verse number="2" style="v" />tin, “Ngai teh u, ka pute u, khawngaih takin in chhiahhlawh inah hian lût rih ula, riak ula, in kete sil rawh u; tichuan, zîng takah in tho vang a, in kal leh dâwn nia,” a ti a. Nimahsela, anni chuan, “Ni lo ve, khawlaiah kan riak zâwk ang,” an ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nimahsela, ani chuan a thlêm chiam a; tichuan, a hnênah an kal a, a inah chuan an lût ta a; tin, ani chuan chawhmeh a siam a, chhang dawidim telh loh a kang a; tin, an ei ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nimahsela, an mut hmain khuaa mi, Sodom khuaa mite ngei chuan, vêng tina mi zawng zawngin, a pui a pangin, in chu an hual vêl hlawm a;
  </para>
  <para style="p">
    <verse number="5" style="v" />tin, Lota chu an ko va, a hnênah, “Zânina i hnêna mi lo lûtte kha khaw nge an awm? Anmahni kan pâwl theih nân kan hnênah rawn hruai chhuak rawh,” an ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Lota chu kawngka bulah chuan an hnênah a va chhuak a, kawng a khâr leh a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, “Ka unaute u, khawngaih takin chuti êm chuan sual ma ta che u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai teh u, mipa la pâwl ngai loh fanu pahnih ka nei a ni; mi khawngaih ula, anni chu in hnênah ka rawn hruai chhuak ang e, ṭha in tih ang apiangin an chungah ti nâng che u; hêng mite chungah erawh hi chuan eng mah ti lul suh ang che u, chumi avâng chuan asin ka in chhûngah hian an lo luh ni,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, anni chuan, “Kiang mai rawh,” an ti a. Tin, anmahni vêk chuan, “He mi hrep hi heta awm tûr hian a lo pêm lût a, rorêltuah awm a tum vei a; tûnah zawng anni chunga tih ai mahin i chungah kan tiṭha lo lehzual ang,” an ti a. Tin, Lota chu an bawh chiam a, kawngkhâr chu tihchhiat tumin an rawn hnaih a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nimahsela, mite chuan an kut an zen chhuak a, Lota chu an hnênah in chhûngah chuan an hnûk lût a, kawng an khâr ta tlat a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, kawngka bula mite chu a lian a têin an mit an tihdelsak a; chutichuan, kawngkhâr chu an zawng hmu zo ta lo va.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, mite chuan Lota hnênah, “Hêng mite lo hi hetah hian chhûngte dang i nei em? I mâkpa leh i fapate leh i fanute leh khaw chhûnga i neih apiangte chu khua ata hi hruai chhuak rawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa hmaah chuan an au thâwm chu a lo nasat tâk avângin he khua hi kan tiboral dâwn a ni; tiboral tûrin Lalpa chuan min tîr bawk si a,” an ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tichuan, Lota chu a kal chhuak a, a fanute neitu, a mâkpate hnênah chuan a va sawi a, “Tho ula, hemi khua ata hi chhuak rawh u; Lalpan khua hi a tiboral dâwn a ni,” a ti a. Nimahsela, a mâkpate ngaih chuan fiamthu sawi ang lek a ni a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, khawfîng a chah veleh chuan vântirhkohte chuan, “Tho la, i nupui leh heta i fanu pahnih awmte hi hruai rawh; chuti lo chuan, he khaw hremnaah hian in boral ve dah ang e,” tiin Lota chu an tur ta sek a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nimahsela, a la muang hle si a; tichuan, Lalpan amah a khawngaih avângin, mite chuan a kutah leh a nupui kutah leh a fanute pahnih kutah chuan an chelh a; tichuan, an hruai chhuak a, khaw pâwnah chuan an dah ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, heti hi a ni a, pâwna an hruai chhuah hnu chuan, “I nunna tûrin tlân chhuak rawh! I hnung lam hawi suh la, phaizâwlah rêng rêng hian ding hek suh; tlângah sâwn tlân rawh; chuti lo chuan, i boral dah ang e,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nimahsela, Lota chuan an hnênah, “Ka pu, chûng ang chu ni suh se!
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai teh, i chhiahhlawh hian i mit a tlung a, nangin i zahngaihna chu i tilian a, chu zahngaihna chu ka nun humhimin ka chungah i lantîr a ni; tlângah saw zawng ka tlân thei lo vang, thil ṭha lo tak hian mi rawn nangin ka thi dah ang e.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai teh, saw khua saw tlân nân a hnai ber a, khaw tê tak tê a ni bawk si a; aw, chutah chuan (khaw tê tak tê a ni lâwm ni?) mi tlântîr zâwk rawh; tichuan, ka nung dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, ani chuan a hnênah, “Ngai teh, chu thil kawngah pawh chuan ka zâwm che a ni, khua i sawi chu ka tiboral lo mai ang e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmanhmawh la, chutah chuan tlân rawh; chumi i thlen hma loh chuan eng mah ka ti thei dâwn si lo va,” a ti a. Chuvângin, chu khaw hmingah chuan Zoar an vuah ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lota chuan Zoar khua chu a thlen chuan lei chungah chuan ni a lo chhuak tawh a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Lalpa chuan Sodom leh Gomorra khaw chungah chuan, vâna Lalpa hnên aṭang chuan kât leh mei a sûrtîr a;
  </para>
  <para style="p">
    <verse number="25" style="v" />tichuan, chûng khuate leh phaizâwl zawng zawng leh, khuaa mi zawng zawng leh leia thil ṭote chu a tiboral ta vek a.
  </para>
  <para style="p">
    <verse number="26" style="v" />A nupui erawh chu Lota hnung aṭang chuan a lehhawi a, chi khâwn dingah a lo chang ta a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, Abrahama chu zîng takah Lalpa hmaa a dinna hmunah khân a han chho va;
  </para>
  <para style="p">
    <verse number="28" style="v" />tin, Sodom leh Gomorra khaw lam leh phaizâwl ram zawng zawng lam chu a thlîr a, a en reng a; tin, ngai teh, chumi rama meikhu chu rawh tuina meikhu ang maiin a khu chho ngut ngut a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, heti hi a ni a, Pathianin phaizâwl khuate chu a tihboral laia Lota awmna khuate chu a tihboral lai chuan, Pathianin Abrahama chu a hre reng a, Lota chu boralna zîng ata chu a tîr chhuak a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Lota chu Zoar khua ata chu a chho va, tlângah chuan a awm a, a fanute pahnih chu a hnênah an awm bawk a; Zoar khuaah a awm ngam si lo va. Tin, amah leh a fanute pahnih chu pûkah an chêng a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, a upa zâwk chuan a naupang zâwk hnênah chuan, “Kan pa hi a upa tawh a, khawvêl zawng zawng dân anga min pâwl tûrin, lei chungah hian mipa pakhat mah an awm tawh si lo va.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hawh, kan pa hi uain i intîr ang khai; tichuan, kan pa chithlah mang lova kan siam theih nân a hnênah kan mu dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tichuan, chumi zân chuan an pa chu uain an intîr ta a. Tin, a upa zâwk chu a lût a, a pa hnênah chuan a va mu a; tin, ani chuan a lo mut lai chu a hre lo va, a thawh leh lai pawh chu a hre hek lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, heti hi a ni a, a tûkah chuan a upa zâwk chuan a naupang zâwk hnênah chuan, “Ngai teh, nizânah khân ka pa hnênah ka mu a, zâninah pawh hian uain i intîr leh ang khai; tin, nang lût la, kan pa chithlah mang lova kan siam theih nân a hnênah va mu ve rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tichuan, chumi zân pawh chuan an pa chu uain an intîr leh a; tin, a naupang zâwk chu a tho va, a hnênah a va mu ta a; tin, ani chuan a lo mut lai chu a hre lo va, a thawh leh lai pawh chu a hre hek lo.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chutiang chuan Lota fanute pahnih chuan an pa lakah chuan nau an lo pai ta ve ve a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, a upa zâwk chuan fapa a hring a, a hmingah chuan Moaba a sa a; chu mi chu tûnlaia Moab-ho thlahtu hi a ni a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tin, a naupang zâwk pawh chuan fapa a hring ve a, a hmingah chuan Ben-ammia a sa a; chu mi chu tûnlaia Amona thlahte thlahtu hi a ni.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Abrahama chu chuta ṭang chuan chhim ram lam panin a insawn a, Kadesh khua leh Sur inkârah chuan awm hmun a khuar a; Gerar khuaah chuan a awm ta rih bawk a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Abrahaman a nupui Sari chu, “Ka farnu a ni,” a ti a; tichuan, Gerar lal Abimeleka chuan mi a tîr a, Sari chu a va hruaitîr ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nimahsela, Pathian chu zânah a mumangah Abimeleka hnênah a lo kal a, a hnênah, “Ngai teh, i hmeichhe hruai avâng hian mitthi mai i ni ta; mi nupui a ni si a,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abimeleka erawh chuan a la pâwl rih lo va; tichuan, “Lalpa, mi fel takte pawh i tihlum dâwn em ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah ngei pawhin ka hnênah, ‘Ka farnu a ni,’ a ti lâwm ni? Tin, ani ngei pawhin, ‘Ka nuṭa a ni,’ a ti bawk si a; thinlung ṭha tak pu leh kut thianghlim tak nei chungin hei hi ka ti a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Pathianin a mumangah chuan, “Ni, hei hi thinlung ṭha tak pu chungin i ti a ni tih ka hria e. Tichuan, kei pawhin ka chunga thil i tihsual tûr chu ka khap che a ni; chuvângin a ni, amah i khawih ka phal loh ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutichuan, tûnah mi nupui kha pe kîr leh rawh; ani chu zâwlnei a ni si a, a ṭawngṭaisak ang chia, i dam dâwn nia. I pêk kîr leh loh zawngin i thi ngei dâwn tih hre rawh, nang leh i neih zawng zawng nên,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tichuan, Abimeleka chu zîng takah a tho va, a chhiahhlawh zawng zawng a ko va, an beng hriatah chûng thu zawng zawng chu a hrilh a; tin, mite chuan an hlau ta êm êm a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutichuan, Abimeleka chuan Abrahama a ko va, a hnênah, “Kan chunga i thiltih hi eng tizia nge ni le? Eng kawngah nge i chungah thil ka tihsuala, kei leh ka khua leh tuite chungah hian thil sual nasa tak i rawn thlen hi le? Thil tih âwm loh tak ka chungah i tih tâk hi,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Abimeleka vêk chuan Abrahama hnênah, “Eng nge i hmuha, hetiang thil hi i tih le?” a ti leh a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Abrahama chuan, “He khuaah hian Pathian ṭihna a awm hauh lo ngei ang a, ka nupui vâng hian mi tihlum mai ang tih ka rin vâng a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chu achhapah ka farnu a ni rêng bawk si a, ka pa fanu a ni a, ka nu fanu erawh chu a ni lo; tin, ka nupuiah a lo awm ta a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, heti hi a ni a, Pathianin ka pa in ata mi vahvaihtîr lai khân, a hnênah, ‘Hei hi i khawngaihna ka chunga i lantîr tûr chu a ni: kan thlenna hmun apiangah, “Ka nuṭa a ni,” ti zêl ang che,’ ka ti rêng a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Abimeleka chuan berâmte leh bâwngpate leh bâwihpate leh bâwihnute a hruai a, Abrahama chu a pe a, a nupui Sari pawh chu a pe kîr leh ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Abimeleka chuan, “En teh, ka ram chu a awm duai alâwm, i duhna apiangah hian awm rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Sari hnênah chuan, “En teh, i nuṭa hi tangka sângkhat ka pe ta a; ngai teh, i hnêna awm zawng zawngte lakah chuan i tân mit khuhna tûr a nih hi; i chung thu rêng rêngah hian i fel leh tawh vek a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, Abrahama chuan Pathian hnênah a ṭawngṭaisak a; tin, Pathianin Abimeleka leh a nupui leh a bâwihnute chu a tidam leh a; tichuan, fate an hring leh ta a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abrahama nupui Sari avâng chuan, Lalpa chuan Abimeleka chhûngte zawng zawng chu a tiching ta tlat hlawm si a.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Lalpa chuan a sawi tawh angin Sari chu a zuk kan a, Lalpa chuan a sawi tawh angin Sari chungah a tihsak ta bawk a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, Sari chu a rai a, Pathianin a hnêna a sawi hun ruat takah chuan Abrahama chu a tar hnuin fapa a hrinsak ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Abrahaman a fapa neih, Sarin a hrinsaka chu a hmingah Isaaka a sa a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Pathianin thu a pêk ang khân Abrahaman a fapa Isaaka chu ni riat a tlinin a serh a tansak a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Abrahama chu a fapa Isaaka a neih lai chuan kum za mi a ni a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Sari chuan, “Pathianin mi tinui ta; mi tin a hria apiangin mi nuihpui ang,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, amah vêkin, “ ‘Sarin nautête a la pawm ang,’ tih tuin nge Abrahama hnênah sawi ngaihna hria ang? A tar hnu hian fapa ka hrinsak tâk hi,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, nautê chu a lo ṭhang lian a, a hnute hnêk an bântîr ta a; tin, Isaaka chu a hnute hnêk an bântîr ni chuan Abrahaman ruai ropui tak a ṭheh a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Aigupta mi Hagari fapa, Abrahama tâna a hrina chuan a nuihsan lai Sarin a hmu a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chumi avâng chuan Abrahama hnênah chuan, “He bâwihnu leh a fapa hi hnawt chhuak rawh; he bâwihnu fapa hi ka fapa Isaaka ro luahpuitu tûr a ni thei lo vang,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, chu thu chu a fapa avângin Abrahama ngaih chuan thil ṭha lo tak a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nimahsela, Pathianin Abrahama hnênah chuan, “Naupang chungchâng thu leh i bâwihnu chungchâng thu leh bâwih chungchang thu hi i ngaihin thil ṭha lo tak ni suh se; Sarin i hnêna thu a sawi zawng zawng chu zâwm rawh; Isaaka-ah hian i thlahte an la ti dâwn si a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, bâwihnu fapaah pawh hian, i thlah a nih avângin chi tihtham zet ka la siam ang,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tichuan, Abrahama chu zîng takah a tho va, chhang leh tuithâwl tuia khat a la a, Hagari a pe a, a kokiah a chhuansak a, naupang pawh chu a kaltîr ta a; tichuan, a kal a, Beer-seba thlalêrah chuan a vâk a vâk ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, tuithâwla tui chu a lo awm ta lo va; tichuan, naupang chu hnim buk pakhat hnuaiah a dah ta mai a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, “Naupang thi tûr chu ka en ngam lo ve,” a tih avângin a kal a, hla fe, thal kah phâk tâwk angah hian a hma zâwnah chuan a va ṭhu ta chawt a. Tichuan, a hma zâwnah chuan a ṭhu a, ring takin a ṭap ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Pathianin naupang aw chu a hria a; tin, Pathian vântirhkohvin vân aṭangin Hagari chu a zuk au va, a hnênah, “Hagar, eng i ti nge ni le? Hlau suh; a awmnaa naupang aw kha Pathianin a hria asin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tho la, naupang kha kai tho la, i kutin chelh rawh, amah chu chi ropui takah ka siam dâwn asin,” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Pathianin a mit a tihvârsak a, tuichhunchhuah a hmu ta a; tichuan, a va kal a, tuithâwlah chuan tui chu a thun khat a, naupang chu a intîr ta a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Pathian chu naupang hnênah chuan a awm ṭhîn a, a lo ṭhang lian zêl a, thlalêrah a awm ṭhîn a, thal kah thiam mi a lo ni ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Paran thlalêrah chuan a awm a; tin, a nu chuan Aigupta ram ata nupui a neihsak a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, heti hi a ni a, chumi lai vêl chuan Abimeleka leh a sipai pâwl hotu Phikola chuan Abrahama hnênah, “I thiltih apiangah Pathian i hnênah a awm zêl ṭhîn a;
  </para>
  <para style="p">
    <verse number="23" style="v" />chutichuan, tûnah hetah hian Pathian hming chhâlin, kei leh ka fapa leh ka fapaa fapa pawh tihder lovin, ka lo khawngaih tâk che ang khân, kei leh i awmna ram hi khawngaih ve thung zâwk tûrin ka hnênah chhia chham rawh khai!” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Abrahama chuan, “Ka chham ang chu,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Abimeleka chhiahhlawhten tuichhunchhuah an chhuhsak avâng chuan Abrahaman Abimeleka chu a zilh a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Abimeleka chuan, “Chumi thil titu chu tu nge ni, ka hre hauh lo mai; nang lahin mi hrilh si lo va, vawiinah chauh lo chuan ka la hre ve hauh lo mai,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tichuan, Abrahama chuan berâmte leh bâwngpate a hruai a, Abimeleka hnênah a pe a; tin, an pahnih chuan thu an thlung ta a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Abrahaman a berâm rual zînga mi berâmno a nu pasarih a dah hrang a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tichuan, Abimeleka chuan Abrahama hnênah, “Berâmno a nu pasarih a hranga i dah hi eng tizia nge ni?” a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, ani chuan, “He tuichhunchhuah hi keimahin ka laih a ni tih mi hriatpuina tûrin, hêng berâmno a nu pasarih hi ka kut ata i la tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chumi avâng chuan chumi hmun chu Beer-seba a vuah a; chutah chuan an pahniha chhia an chham dun avângin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chutichuan, Beer-seba-ah chuan thu an thlung ta a; tin, Abimeleka chu a tho va, a sipai pâwl hotu Phikola nên Philistin-ho ramah chuan an hâwng leh ta a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Abrahama chuan Beer-seba-ah chuan fâr thing a phun a, chutah chuan Lalpa , Chatuana Pathian hming chu a lam a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tichuan, Abrahama chu Philistin-ho ramah chuan rei tak a awm a.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, heti hi a ni a, chûng thil hnuah chuan Pathianin Abrahama chu a fiah a, a hnênah, “Abraham,” a ti a; tin, ani chuan, “Heta hi ka awm,” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, ani chuan, “I fapa, i fapa neih chhun, i hmangaih tak, Isaaka ngei kha hruai la, Moria ramah chuan kal la, chutah chuan ka hrilh tûr che tlâng pakhatah chuan hâlral thilhlanah hlân rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Abrahama chu zing takah a tho va, a sabengtung a siam a, a hnênah a chhiahhlawh tlangvâl pahnih a hruai a, a fapa Isaaka nên; tin, hâlral thilhlan atân thing a ek a, a tho va, Pathianin a hrilhna hmun lamah chuan a kal ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, ni thum nîah chuan Abrahama chu a han dâk a, a hmun chu hla takah a han hmu a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Abrahaman a chhiahhlawh tlangvâlte hnênah chuan, “Hetah sabengtung nên hian lo awm rawh u, kei leh naupang hi sawtah sâwn kan va kal ang a; tin, Pathian kan va bia ang a, in hnênah kan lo kîr leh ang,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Abrahama chuan hâlral thilhlanna thing chu a la a, a fapa Isaaka chu a puttîr a; ani chuan mei leh chemtê a keng a; tichuan, an pahnihin an kal dûn ta a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Isaaka chuan a pa Abrahama chu a bia a, “Ka pa,” a ti a; tin, ani chuan, “Ka fapa, heta hi ka awm,” a ti a. Tin, ani chuan, “En teh, mei leh thing chu a awm a; nimahsela, hâlral thilhlan tûr berâmno chu khawiah nge a awm?” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Abrahama chuan, “Ka fapa, Pathianin ama tâna hâlral thilhlan tûr berâmno chu a ngaihtuah chawp mai ang chu,” a ti a; chutichuan, an pahnih chuan an kal dûn ta zêl a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Pathianin a hrilh hmun chu an va thleng ta a; tin, Abrahama chuan chutah chuan maichâm a siam a, thing chu a chhep khâwm a, a fapa Isaaka chu a phuar a, maichâma thing chungah chuan a muttîr a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Abrahama chuan a kutin a ban a, a fapa tihhlum nân chemtê chu a la a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Lalpa vântirhkoh chuan vân aṭangin amah chu a zuk au va, “Abraham, Abraham,” a zuk ti a; tin, ani chuan, “Heta hi ka awm,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ani chuan, “Naupang chungah khân i kut thlâk suh la, amah kha eng mah tih hek suh; i fapa, i neih chhun tak pawh mi pêk i ui loh avângin Pathian i ṭih tih tûnah ka hre ta a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Abrahama chu a han dâk a, a en a; tin, ngai teh, a hnung lamah chuan berâmpa, a ki thing hnawka lo tâng tlat a awm a; tichuan, Abrahama chuan berâmpa chu a va man a, chumi chu a fapa aiah hâlral thilhlanah chuan a hlân ta zâwk a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tichuan, Abrahaman chumi hmun hmingah chuan Jehova-jire a vuah a; vawiin thlenga, “ Lalpa tlângah ngaihtuah a ni ang chu,” an tih ṭhin ang hian.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Lalpa vântirhkoh chuan a vawi hnihnaah vân aṭangin Abrahama chu a zuk au leh a,
  </para>
  <para style="p">
    <verse number="16" style="v" />“He thil hi i tih tâk avâng leh i fapa, i neih chhun tak pawh i ui loh avângin mal ka sâwm ngei ngei ang chia,
  </para>
  <para style="p">
    <verse number="17" style="v" />vâna arsi zât leh tuifinriat kama ṭiau vaivut zâtin i thlahte chu ka la tipung ngei ngei ang tih leh, i thlahte chuan an dote kulh kawngkhâr chu an la neihsak ang tih leh,
  </para>
  <para style="p">
    <verse number="18" style="v" />ka thu i âwih tâk avângin i thlahah chuan khawvêla chi tin an la thawveng ang tih, mahni leh mahni inchhâlin chhia ka chham ta, Lalpan a ti,” a zuk ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutichuan, Abrahama chu a chhiahhlawh tlangvâlte hnênah chuan a kîr leh a; tin, an tho va, Beer-seba-ah chuan an kal za ta hlawm a; tin, Abrahama chu Beer-seba-ah chuan a awm ta reng a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, heti hi a ni a, chûng thil hnuah chuan miin Abrahama hnênah chuan, “Ngai teh, Milkai pawh khân i nau Nahora chu fate a hrinsak ta asin,” tiin an hrilh a.
  </para>
  <para style="p">
    <verse number="21" style="v" />A fa tîr chu Uza a ni a, a nau chu Buza a ni a, Kemuela, Arama pa nên,
  </para>
  <para style="p">
    <verse number="22" style="v" />Keseda te, Hazova te, Pildasa te, Jidlapha te, Bethuela te pawh an ni a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Bethuela chuan fanu Rebeki a nei a; chûng pariatte chu Milkai chuan Abrahama nau Nahora chu a hrinsak a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />A hmei, a hming Reumai pawhin Teba te, Gahama te, Tahasa te, Maaka te a hring bawk a.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Sari dam chhûng chu kum za leh kum sawmhnih leh kum sarih a ni a; chûng chu Sari dam chhûng kum chu a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Sari chu Kanaan rama Kiriath-arba khuaah chuan a thi a (chu chu Hebron khua a ni). Tin, Abrahama chu Sari sûn tûr leh ṭah tûrin a lo kal a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, mitthi ruang hma ata chu a tho va, Hetha thlahte hnênah chuan,
  </para>
  <para style="p">
    <verse number="4" style="v" />“In zîngah mikhual leh pêm mai ka ni a; ka mitthi ruang hi ka hmuh loh va ka phûm theihna tûrin in zîngah hian phûmna hmun ro mi pe rawh u,” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Hetha thlahte chuan Abrahama chu an chhâng a, a hnênah,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ka pu, min ngaithla teh, nang chu kan zîngah hian lal ropui tak i ni a; kan thlânahte hian i duhna berah chuan i mitthi chu phûm ta che; i mitthi i phûmna tûrin kan zînga tu mahin kan thlân pêk che kan ui lo vang,” an ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, Abrahama chu a tho va, chumi rama mi Hetha thlahte chu chibai a bûk a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, “Ka mitthi chu ka hmuh loh va ka phûm rem in tih chuan mi ngaithla ula, Makpela pûk, a lo mawnga awm, a neih kha mi pe tûrin Zohara fapa Ephrona hnênah mi ngensak teh u. In zîngah phûmna hmun ro atâna a man tâwk ang zêlin mi pe rawh se,” tiin a bia a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Ephrona chu Hetha thlahte zîngah chuan a ṭhu ve reng a; tichuan, Hit mi Ephrona chuan Hetha thlahte hriatah, a khaw kulh kawngkaa lût apiangte hriat ngeiah chuan,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ni lo ve, ka pu, mi ngaithla teh; lo chu ka pe chia, a chhûnga pûk awm pawh chu ka pe bawk a che; ka chipuiho fate mit hmuhah hian ka pe a che; i mitthi chu phûm mai rawh,” tiin Abrahama chu a chhâng a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Abrahama chu chumi rama mite hmaah chuan a kûn a, chibai a bûk a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, chumi rama mite hriatah chuan Ephrona hnênah, “Rem i tih phawt chuan khawngaih takin mi ngaithla teh; lo man chu ka pe zâwk ang che; ka hnên ata hi la la, chutah chuan ka mitthi chu ka phûm dawn nia,” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Ephrona chuan Abrahama chu a chhâng a, a hnênah,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Ka pu, mi ngaithla teh; lei hmun, tangka sekel zali hu mai te chu nang leh keia tân sawi tham em ni ang? I mitthi chu phûm mai rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tichuan, Abrahama chuan Ephrona thu chu a zâwm ta a; tin, Abrahaman Hetha thlahte hriatah Ephronan tangka a sawi zât, tangka sekel zali, sumdâwnghovin an hman ṭhin chu a bûk a, Ephrona chu a pe ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutichuan, Ephrona lo, Mamre zâwna Makpela rama awm chu, a lo nên, a chhûnga pûk awm nên, lova thing awm zawng zawngte nên, a lo ri vêl zawng zawnga thing awmte nên chuan,
  </para>
  <para style="p">
    <verse number="18" style="v" />Hetha thlahte mit hmuhah, a khaw kulh kawngkaa lût apiangte mit hmuhah chuan, ro atân Abrahama hnênah pêk nghehin a awm ta a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chumi hnuah chuan Abrahaman a nupui Sari chu Kanaan rama Mamre zâwna (chu chu Hebron khua a ni a) Makpela lova pûkah chuan a phûm ta a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, lo leh a chhûnga pûk awm chu, phûmna hmun ro atân Abrahama chu Hetha thlahten an pe nghet ta a.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Abrahama chu a lo upa a, a lo tar ta hle a; tin, Lalpa chuan Abrahama chu thil engkimah mal a sâwm tawh a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Abrahama chuan a chhiahhlawh, a chhûngte zînga upa ber, a neih zawng zawng chunga thuneitu hnênah chuan, “Khawngaih takin i kut kha ka malpui hnuaiah rawlh rawh;
  </para>
  <para style="p">
    <verse number="3" style="v" />tichuan, Lalpa , vân Pathian leh lei Pathian chu chhâlin, ka awmna Kanaan-ho nula zînga mi hi ka fapa nupuia neihsak lo tûrin chhia ka chhamtîr dâwn che a ni;
  </para>
  <para style="p">
    <verse number="4" style="v" />kan ram lamah, ka laichînte hnêna kalin ka fapa Isaaka hi nupui i neihsak zâwk tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, chhiahhlawh chuan a hnênah, “Hmeichhia chuan hemi ram lamah hian mi zui duh kher lo thei a; i fapa hi i lo chhuahna ram lamah chuan ka hruai kîr leh dâwn em ni ang?” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Abrahama chuan a hnênah, “Ka fapa hi chutah chuan hruai kîr leh lo tûrin fîmkhur rawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa , vân Pathian, ka pa in ata leh ka pianna ram ata mi hruai chhuaktu leh, mi betu leh, ‘He ram hi i thlahte ka la pe ang,’ tia ka hnêna chhechhamtu chuan, amah ngeiin a vântirhkoh chu i hmaah a kaltîr ang a, chuta ṭang chuan ka fapa hi nupui i rawn neihsak dâwn nia.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, hmeichhia chuan a zui duh loh che chuan, ka hnêna i chhechham kawngah hian i thiang mai ang; eng pawh ni rawh se, ka fapa hi chutah chuan i hruai kîr leh tûr a ni lo,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, chhiahhlawh chuan a kut chu a pu Abrahama malpui hnuaiah chuan a rawlh a, chumi thûah chuan a hnênah chhia a chham ta a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, chhiahhlawh chuan a pu sanghâwngsei zînga mi sanghâwngsei sâwm a hruai a, a pu thil ṭha tinrêng kengin a chhuak ta a; tichuan, a tho va, Mesopotamia rama Nahora te khuaah chuan a kal a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, tlai lama hmeichheho tui chawi tûra an chhuah hun lai tak chuan, dai kianga tuichhunchhuah kiangah chuan a sanghâwngseite chu a ṭhingṭhittîr a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, “Aw Lalpa , ka pu Abrahama Pathian, khawngaih takin vawiinah hian mi hlawhtlintîr la, ka pu Abrahama chungah chuan khawngaihna lantîr ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />En teh, tuikhur kiangah ka ding a, khuaa mite fanuho pawh tui chawi tûra an lo kal hi;
  </para>
  <para style="p">
    <verse number="14" style="v" />tichuan, heti hian ni rawh se, nula tu hnênah pawh, ‘Khawngaih takin ka in tûrin i tui bêl kha han tihniam teh khai,’ ka tiha, ‘In rawh, i sanghâwngseite pawh hi in tûr ka pe ang e,’ titu apiang, chu mi ngei chu i chhiahhlawh Isaaka tâna i mi ruat chu ni rawh se; tin, chumiah chuan ka pu chungah khawngaihna i lantîr tih ka hre dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, heti hi a ni a, a sawi zawh hma chuan, ngai teh, Abrahama nau Nahora nupui Milkai fapa Bethuela fanu Rebeki chu, a kokia tui bêl puin a lo chhuak a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chu nula chu a hmêl a ṭha êm êm a, nula thianghlim a ni a; mipa rêng rêngin an la pâwl ngai hauh lo. Tin, tuikhurah chuan a chhuk a, a tui bêl chu a tikhat a, a chho leh a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, chhiahhlawh chu a tâwk tûrin a tlân a, “Khawngaih takin i tui bêla tui kha tlêm tê mi intîr teh khai,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, ani chuan, “In ta che, ka pu,” a ti a; tin, rang takin a tui bêl chu a kutah a chawi thla a, a intîr ta a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, a intîr hnuin, “I sanghâwngseite tân pawh an in kham hma loh chuan ka chawi zêl ang e,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, rang takin a tui bêl chu a ran thlêngah chuan a ruak a, tui chawi tûrin tuichhunchhuah lamah chuan a tlân leh a, a sanghâwngseite zawng zawng tân chuan a chawi ta zêl a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, chhiahhlawh chuan ani chu a en reng a; Lalpan a va zinna chu a hlawhtlintîr leh tîr loh hriat nân a ngawi reng mai a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, heti hi a ni a, sanghâwngseite chuan an in kham veleh, chhiahhlawh chuan rangkachak hnârvuah duli bûk leh a kut atân banbun pahnih rangkachak tangka sâwm bûk a phawrh a;
  </para>
  <para style="p">
    <verse number="23" style="v" />tin, a hnênah, “Tu fanu nge i nih? Khawngaih takin mi hrilh teh. I pa inah kan riahna tûr hmun a awm ang em?” a ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, ani chuan a hnênah, “Bethuela, Milkai fapa, Nahora tân a hrinsaka fanu ka ni,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, amah vêkin a hnênah, “Buhpâwl leh ran chaw kan ngah ve ve a, riahna hmun pawh kan nei,” a ti bawk a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tichuan, chhiahhlawh chuan a lû a kûn a, Lalpa chu chibai a bûk a,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Ka pu chunga a khawngaihna leh a rinawmna bâng chuang lo Lalpa , ka pu Abrahama Pathian chu fakin awm rawh se; kei pawh hi Lalpa chuan ka pu unaute in lamah mi hruai a lo nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, nula chu a tlân a, chûng thû chu a nu chhûngte a va hrilh a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rebeki chuan nuṭa a nei a, a hming chu Labana a ni a; tichuan, Labana chu a chhuak a, tuikhur lamah mi hnênah chuan a tlân ta a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Heti hi a ni a, hnârvuah leh a farnu kuta banbunte chu a hmu a, “Mi chuan chutin khatin mi ti a,” tia a farnu Rebeki thusawite chu a hriat veleh chuan, mi hnênah chuan a kal ta a; tin, ngai teh, ani chu tuikhura sanghâwngseite kiangah chuan a lo ding reng a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Labana chuan, “Nang Lalpa malsâwm dawngtu, lo kal la, ka inah lût rawh. Engah nge pâwna i din reng? In leh sanghâwngseite tân hmun ka buatsaih tawh asin,” a ti a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, mi chu inah chuan a lût a; tin, Labana chuan sanghâwngsei thuamhnaw chu a phelh a; tin, sanghâwngseite tân buhpâwl leh ran chaw a pe a, a ke leh a ṭhiante ke sil nân tui a pe bawk a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Abrahama chhiahhlawh hmaah chuan ei tûr an hlui a; nimahsela, ani chuan, “Ka rawn kal chhan thu ka sawi hma loh chuan ka ei lo vang,” a ti a. Tin, ani chuan, “Sawi ta che,” a ti a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, ani chuan, “Abrahama chhiahhlawh ka ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, Lalpa chuan ka pu chu nasa takin mal a sâwm a, mi lian tak a lo ni ta a; Lalpa chuan a hnênah berâm rual te, bâwng rual te, tangkarua te, rangkachak te, bâwihpa te, bâwihnu te, sanghâwngsei te, sabengtung te a pe bawk a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka pu nupui Sarin a tar hnuin ka pu tân fapa a hring a; ama hnênah chuan a neih zawng zawng a pe vek a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, ka pu chuan, ‘Ka awmna rama Kanaan-ho nula zînga mi hi ka fapa nupuiah i neihsak tûr a ni lo;
  </para>
  <para style="p">
    <verse number="38" style="v" />ka pa in lamah, ka laichînte hnêna kalin ka fapa tân nupui i neihsak zâwk tûr a ni,’ tiin chhia mi chhamtîr a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, keiin ka pu hnênah chuan, ‘Hmeichhia chuan mi zui duh kher lo thei a,’ ka ti a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tin, ani chuan ka hnênah, ‘ Lalpa , a hmaa ka awm ṭhinna chuan a vântirhkoh chu i hnênah a tîr ang a, i kalna tûrah chuan a hlawhtlintîr ang che; tichuan, ka fapa tân ka laichînte leh ka pa chhûngte zînga mi nupuiah i neihsak dâwn nia;
  </para>
  <para style="p">
    <verse number="41" style="v" />ka laichînte hnên ngei i thlen hunah chuan ka hnêna i chhechham lakah hian i thiang ang; nula chu an pêk loh che chuan ka hnêna i chhechham lakah hian i thiang ang,’ a ti a.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Tichuan, vawiinah hian tuikhur chu ka lo thleng a, ‘Aw Lalpa , ka pu Abrahama Pathian, rem i tih chuan ka kalnaah hian mi hlawhtlintîr ang che.
  </para>
  <para style="p">
    <verse number="43" style="v" />En teh, tuikhur kiangah ka din hi; tin, heti hi ni rawh se, nula tui chawi tura lo chhuak tû hnênah pawh, “Khawngaih takin in atân i tui bêla tui kha tlêm tê mi pe teh,” ka tiha,
  </para>
  <para style="p">
    <verse number="44" style="v" />anin ka hnênah, “In rawh, i sanghâwngseite tân pawh hian ka chawi ang e,” titu apiang, chu mi ngei chu ka pu fapa tâna Lalpa hmeichhe ruat chu ni rawh se,’ ka ti a.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tin, ka rilrua ka sawi zawh hma chuan ngai teh, Rebeki hi a tui bêl puin a lo chhuak a; tin, tuikhurah chuan a chhuk a, tui a zuk chawi a; tin, a hnênah, ‘Khawngaih takin tui mi intîr teh khai,’ ka ti a.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tin, ani hian rang takin a koki ata chu a tui bêl a chawi thla a, ‘In rawh, i sanghâwngseite pawh hi in tûr ka pe ang e,’ a ti a; chutichuan, ka in a, sanghâwngseite pawh a intîr bawk a.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tin, keiin, ‘Tû fanu nge i nih?’ tiin ka zâwt a. Tin, ani hian, ‘Bethuela, Nahora fapa, Milkai’n a hrinsaka fanu,’ a ti a; tin, hnârvuah chu a hnârah ka vuah a, bânbunte chu a bânah ka buntîr bawk a.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tin, ka lû ka kûn a, Lalpa chu chibai ka bûk a, Lalpa , ka pu Abrahama Pathian, ka pu nauva fanu hi a fapa tân nupuia neihsak tûra kawng dik taka mi hruaitu chu ka fak ta a.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tichuan, tûnah ka pu chu in khawngaiha, a chunga rinawm taka in tih dâwn chuan mi hrilh rawh u; in tih dawn loh pawhin min hrilh rawh u; chutichuan, ding lam emaw, vei lam emaw ka hawi thei ang,” a ti a.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tin, Labana leh Bethuela chuan an chhâng a, “He thil hi Lalpa hnên aṭanga chhuak a nih hi; a chhia a ṭha pawh i hnênah kan sawi thei lo ve.
  </para>
  <para style="p">
    <verse number="51" style="v" />En teh, Rebeki chu i hmaa hi a awm alâwm; hruai la, kal ta che, Lalpan a sawi tawh angin i pu fapaa nupuiah awm rawh se,” an ti a.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tin, heti hi a ni a, Abrahama chhiahhlawh chuan an thu chu a hriat velah lei siin Lalpa chibai a bûk ta a.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tin, Abrahama chhiahhlawh chuan tangkaraw incheinate leh rangkachak incheinate leh silhfênte a la chhuak a, Rebeki chu a pe a; a nuṭa leh a nu pawh chu thil hlu takte a pe bawk a.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tin, amah leh a ṭhiante chuan an eiin an in a, an riak ta a; tin, zîngah an tho va, “Ka pu hnênah mi kaltîr tawh rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tin, a nuṭa leh a nu chuan “Chêmtei hi ni rei lo tê, ni sâwm lek tal kan hnênah awm rih rawh se; chumi hnuah chuan a kal dâwn nia,” an ti a.
  </para>
  <para style="p">
    <verse number="56" style="v" />Tin, ani chuan an hnênah, “Mi tikhawtlai suh u khai, Lalpa chuan ka kalnaah hian mi hlawhtlintîr ta si a; ka pu hnêna ka hâwn theihna tûrin mi kaltîr zâwk teh u khai,” a ti a.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tin, anni chuan, “Chêmtei chu kan ko vang a, ama kâ ngei kan bia ang,” an ti a.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tichuan, Rebeki chu an ko va, a hnênah, “He mi hnênah hian i kal duh ang em?” an ti a. Tin, ani chuan, “Duh ang chu,” a ti a.
  </para>
  <para style="p">
    <verse number="59" style="v" />Tichuan, an farnu Rebeki leh a awmtu leh Abrahama chhiahhlawh leh a hote chu an kaltîr a.
  </para>
  <para style="p">
    <verse number="60" style="v" />Tin, Rebeki chu mal an sâwm a, a hnênah, “Kan farnu, nang chu sîng hlîra sâng tam tak nu lo ni la, i thlahte chuan anmahni hawtute kulh kawngkhâr chu neihsak rawh se,” an ti a.
  </para>
  <para style="p">
    <verse number="61" style="v" />Tichuan, Rebeki chu a tho va, a bâwihnute nên, sanghâwngsei chungahte chuan an chuang a, mi chu an zui ta a; tichuan, Abrahama chhiahhlawh chuan Rebeki chu a hruai a, a kal ta a.
  </para>
  <para style="p">
    <verse number="62" style="v" />Tin, Isaaka chu Beer-lahai-roi lam aṭang chuan a lo kal a, Chhim rama awm a ni si a.
  </para>
  <para style="p">
    <verse number="63" style="v" />Tin, Isaaka chu tlai lamah phûlah inngaihtuah tûrin a va lêng chhuak a; tin, a han dâk a, a en a; tin, ngai teh, sanghâwngseite an lo kal a.
  </para>
  <para style="p">
    <verse number="64" style="v" />Tin, Rebeki chu a han dâk a, Isaaka a hmuh veleh chuan sanghâwngsei ata a chhuk ta a.
  </para>
  <para style="p">
    <verse number="65" style="v" />Tin, Abrahama chhiahhlawh hnênah chuan, “Phûla min hmuak tûra lo kal saw tu nge ni?” a ti a. Tin, chhiahhlawh chuan, “Ka pu a nih saw,” a ti a; tichuan, a inkhuhna puan a la a, a inkhuh ta a.
  </para>
  <para style="p">
    <verse number="66" style="v" />Tin, chhiahhlawh chuan a thiltih zawng zawng chu Isaaka a hrilh a.
  </para>
  <para style="p">
    <verse number="67" style="v" />Tin, Isaaka chuan Rebeki chu a nu Sari puan inah chuan a hruai lût a; tin, Rebeki chu a nei a, a nupui a lo ni ta a; tin, amah chu a hmangaih hle a; tichuan, Isaaka chu a nu thih hnuah pawh chuan a lo thlamuang thei ta a.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Abrahama chuan nupui dang a nei a, a hming chu Keturi a ni a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, ani chuan Zimrana te, Joksana te, Medana te, Midiana te, Isbaka te, Suaha te a hrinsak a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Joksana chuan fapa Seba leh Dedana a nei a. Tin, Dedana fapate chu Assurima te, Letusima te, Leummima te an ni a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Midiana fapate chu Epha te, Ephera te, Hanoka te, Abida te, Elda te an ni. Chûng zawng zawng chu Keturi fate an ni a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Abrahama chuan a neih zawng zawng chu Isaaka a pe a.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hmeiho fapate erawh chu Abrahama chuan lâwmmante a pe a; tin, amah a la dam lai ngei chuan a fapa Isaaka hnên ata chu khawchhak lamah, khawchhak ramah chuan a kal botîr ta hlawm a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Abrahama dam chhûng chu kum za leh kum sawmsarih leh kum nga a ni a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Abrahama chuan a thlarau a thlah a, lua kêlsam ṭo vek, putar tak, tar kûna damin a thi a, a chipuite hnênah chuan hruaiin a awm ve ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, a fapa Isaaka leh Ismaela chuan Hit mi Zohara fapa Ephrona lova Mamre zâwna Makpela pûkah chuan an phûm ta a;
  </para>
  <para style="p">
    <verse number="10" style="v" />chu lo chu Abrahaman Hetha thlahte laka a lei a ni; chutah chuan Abrahama chu an phûm a, a nupui Sari nên khân.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, heti hi a ni a, Abrahama thih hnuah chuan Pathianin a fapa Isaaka chu mal a sâwm a; tin, Isaaka chu Beer-lahai-roi kiangah chuan a awm a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, hêng hi Abrahama fapa Ismaela, Sari bâwihnu, Aigupta mi, Hagarin Abrahama a hrinsaka thlahte chu an ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hêng hi an hming ṭheuh leh an thlahte ang zêlin Ismaela fapate hming chu a ni: Ismaela fa upa ber chu Nebaiotha a ni a; a naute chu Kedara leh Adbeela leh Mibsama leh,
  </para>
  <para style="p">
    <verse number="14" style="v" />Misma leh Duma leh Masa an ni a;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadada leh Tema, Jetura, Naphisa leh Kedema an ni bawk a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chûng chu Ismaela fapate an ni a; chûng chu an khua ang zêl leh an riah bûk ang zêlin an hming ziak a ni a; an chi ang zêl chuan lal sâwm leh pahnih an ni a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Ismaela dam chhûng kum chu hei hi a ni, kum za leh kum sawmthum leh kum sarih hi. Tin, a thlarau a thlah a, a thi a, a chipuite hnênah chuan hruaiin a awm ve ta a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, a fapate chu Havila ram aṭangin Assuria ram pan zâwngin Aigupta ram zâwn, Sur thlengin an awm a; an unau zawng zawng depah chuan an awm a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, hêng hi Abrahama fapa Isaaka thlahte chu an ni: Abrahama chuan fapa Isaaka a nei a;
  </para>
  <para style="p">
    <verse number="20" style="v" />Isaakan Paddan-aram rama Suria mi Bethuela fanu, Suria mi, Labana farnu Rebeki chu a nupuia a neih lai chuan kum sawmli mi a ni a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, a nupui chu a chin avângin Isaaka chuan Lalpa hnênah a ngensak chiam a; tin, Lalpan a dîlna chu a ngaihthlâksak a; tichuan, a nupui Rebeki chu a rai ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, a nau paite chu a kawchhûngah chuan an insual a; tin, ani chuan, “Hetiang a nih si chuan eng vângin nge ka dam reng le?” a ti a. Tichuan, Lalpa zâwt tûrin a kal ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Lalpa chuan a hnênah, “I chhûlah chuan chi hnih an awm a, I pum chhûng aṭang ngei chuan hnam hnih an inṭhen ang; Hnam pakhat chu hnam pakhat ai chuan a chak zâwk ang a; Tin, a upa zâwk chuan a naupang zâwk rawng chu a bâwl ang,” a ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, a nau hrin a hun chuan ngai teh, a chhûlah chuan phîr an lo awm a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, a hmasa zâwk chu a sena sen tur, puan hmul anga hmul thupin a lo chhuak a; tichuan, a hmingah chuan Esauva an sa a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chumi zawhah chuan a nau chu a lo chhuak leh a, a kutin Esauva keartui chu a chelh reng a; tichuan, ani hmingah chuan Jakoba an sa a; tin, Rebekin anmahni chu a hrin lai chuan, Isaaka chu kum sawmruk mi a ni a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, naupangte chu an lo ṭhang lian a; tin, Esauva chu sa pêl thiam tak, mi ramvachal a ni a; Jakoba erawh chu mi ni chuah, puan in lamtea awm mi a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Isaaka chuan a sakhi sa a ei ṭhin avângin Esauva chu a ngaina a; Rebeki erawh chuan Jakoba chu a ngaina zâwk a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Jakoba chuan englo a chhûm kawi a; tin, Esauva chu ram lam aṭangin a lo hâwng a, a chau hle a;
  </para>
  <para style="p">
    <verse number="30" style="v" />tin, Esauvan Jakoba hnênah chuan, “Khawngaih takin i englo sen chhum kawi ngei kha mi eitîr teh khai; ka chau êm mai,” a ti a. Chuvâng chuan a ni, a hming chu Edoma an tih ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Jakoba chuan, “I fa tîr nihna mi leitîr zet la le,” a ti a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, Esauva chuan, “Ngai teh, ka thi lek lek a ni si a; fa tîr nihna mai hi ka tân eng nge sâwt ang?” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Jakoba chuan, “Ka hnênah chhia chham zet rawh le,” a ti a; tin, a hnênah chhia a chham a; tichuan, a fa tîr nihna chu Jakoba hnênah a hralh ta mai a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, Jakoba chuan Esauva chu chhang leh dailuah chhum kawi a pe a; tichuan, a eiin a in a, a tho va, a kal ta a; chutiang chuan Esauva chuan a fa tîr nihna chu a ngainêp a ni.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, chumi ramah chuan Abrahama dam laia ṭâm lo tla hmasa zâwk tih loh kha, ṭâm a lo tla leh a. Tichuan, Isaaka chu Philistin-ho lal Abimeleka hnênah Gerar khuaah a zuk kal a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Lalpa chu a hnênah a rawn inlâr a, “Aigupta ramah chuan zuk kal suh; ram ka hrilh tûrah che chuan awm rawh;
  </para>
  <para style="p">
    <verse number="3" style="v" />he ramah hian awm rih la; tichuan, i hnênah ka awm ang a, mal ka sâwm dâwn che nia; hêng ram zawng zawng hi nangmah leh i thlahte pein, i pa Abrahama hnêna chhia ka chham kha ka tinghet dâwn a ni;
  </para>
  <para style="p">
    <verse number="4" style="v" />tin, vâna arsi zâtin i thlahte chu ka la tipung ang a, hêng ram zawng zawng hi i thlahte ka la pe bawk ang; tin, i thlahah chuan khawvêla chi tin an la thawveng ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abrahama chuan ka thu a âwih a, ka thuhrilhte, ka thupêkte, ka thuruatte, ka dânte pawh a zawm avâng khân,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, Isaaka chuan Gerar khuaah chuan awm hmun a khuar ta a;
  </para>
  <para style="p">
    <verse number="7" style="v" />tin, chumi khuaa mite chuan a nupui chanchin an zâwt a; tin, ani chuan, “Ka farnu a ni,” a ti a; a hmêl a ṭhat avângin, “He khuaa mite hian Rebeki vângin mi that dah ang e,” tiin, “Ka nupui a ni,” a ti ngam lo a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, heti hi a ni a, chutah chuan rei tak a awm hnuin, Philistin-ho lal Abimeleka chuan tukverh aṭangin a han thlîr a; tin, ngai teh, Isaakan a nupui Rebeki a chhaih lai a han hmu a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, Abimelekan Isaaka chu a ko va, “Ngai teh, i nupui a nih ngei hi le; engati nge, ‘Ka farnu a ni,’ i tih mai le?” a ti a. Tin, Isaaka chuan a hnênah, “ ‘Amah vângin ka thi dah ang e,’ ka tih vâng a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Abimeleka chuan, “Kan chunga i thiltih hi eng tizia nge ni le? Mite zînga mi tu pawh hian i nupui hi an lo mutpui mai thei asin; tichuan, kan chungah hian thiam lohna i rawn thlentîr a ni dâwn asin,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Abimeleka vêk chuan, “Tu pawh he mi hi emaw, a nupui hi emaw khawih apiang chu tihhlum ngei ngei tûr a ni,” tiin mi zawng zawng chu thu a pe a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Isaaka chuan chumi ramah chuan buh a chîng ve a, chumi kum chuan a leh za a hmu a; Lalpan mal a sâwm bawk a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tichuan, ani chu a lo ropui ta hle a, nasa taka mi ropui lo ni khawpin a lo lian ta tulh tulh a;
  </para>
  <para style="p">
    <verse number="14" style="v" />berâm rualte leh bâwng rualte a nei a, chhiahhlawh tam tak a nei bawk a; tichuan, Philistin-ho chuan an îtsîk ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, a pa Abrahama dam laia a pa chhiahhlawhten tuichhunchhuah an laih zawng zawng chu Philistin-hoten an hnawh a, leiin an lo tikhat vek mai a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Abimeleka chuan Isaaka hnênah, “Kan hnên ata kal bo daih rawh, kan aiin i chak zâwk si a,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, Isaaka chu chuta ta chu a chhuak a, Gerar ruamah chuan a puan in a zâr a, chutah chuan awm hmun a khuar ta a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Isaaka chuan a pa Abrahama dam laia an tuichhunchhuah laihte chu a lai leh a; Abrahama thih hnu khân Philistin-ho chuan an lo hnawh khat vek tawh si a; tin, a pain a hming a lo vuah ang zêl khân a hming a vuah hlawm a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Isaaka chhiahhlawhten ruamah chuan an lai a, chutah chuan tuichhunchhuah hna nei an hmu ta hlauh va.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Gerar khuaa ranpute chu, “Tui hi kan ta a ni,” tiin Isaaka ranpute nên chuan an inhnial a; tichuan, amah nên an inhnial avângin tuichhunchhuah hmingah chuan “Esek” a vuah ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, tuichhunchhuah dang an lai leh a, chumi pawh chu chuh tumin an inhnial leh a; tichuan, a hmingah chuan “Sitna” a vuah leh a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, chuta ta chu a insawn a, tuichhunchhuah dang a lai leh a; chu chu chuh tumin an inhnial ta lo va; tichuan, “Tûnah zawng Lalpan hmun zau tak mi siamsak ta a, he ramah hian chi tam tak kan thlah tawh ang,” tiin, a hmingah chuan “Rehoboth” a vuah ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, chuta ṭang chuan Beer-seba-ah a han chho va.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chumi zân ngei chuan Lalpa chu a hnênah a rawn inlâr a, “Kei hi i pa Abrahama Pathian chu ka ni; hlau suh, i hnênah ka awm alâwm, mal ka sâwm ang chia, ka chhiahhlawh Abrahama avângin i thlahte chu ka la tipung dâwn asin,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tichuan, chutah chuan maichâm a siam a, Lalpa hming chu a lam a, chutah chuan a puan in a zâr bawk a; tin, Isaaka chhiahhlawhte chuan chutah chuan tuichhunchhuah an lai leh a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Gerar khua aṭangin Abimeleka chu a ṭhian Ahuzzatha nên, a sipai pâwl hotu Phikola nên a hnênah an kal a,
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, Isaaka chuan an hnênah, “Mi hua a, in hnên ata mi kal botîr si a, eng vângin nge ka hnêna in lo kal le?” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, anni chuan, “ Lalpa chu i hnênah a awm tih chiang takin kan hria a; tichuan, ‘I pawi kan khawih ngai loh ang leh, thil ṭha chauh lo chu i chungah eng mah rêng rêng kan tih lohva, tlang taka kan kal botîr ta che ang khân, keini pawh kan chhiatna tûr rêng rêng i tih lohna tûrin kan kârah, keini leh nangma kâr ngeiah hian, chhechhamna lo awm tawh sela, i hnênah thu min thluntîr rawh,’ kan ti; tûnah chuan nang zawng Lalpa malsâwm dawngtu i nih tawh hi,” an ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, ani chuan an tân ruai a ṭheh a; tichuan, an eiin an in ta a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, zîng lamah chuan zîng takah an tho va, chhia an chham tawn a; tin, Isaakan anni chu a kaltîr a; tichuan, a hnên aṭang chuan tlang takin an chhuak ta a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, heti hi a ni a, chumi ni vêk chuan Isaaka chhiahhlawhte chu an lo kal a, an tuichhunchhuah laih chanchin an rawn hrilh a, a hnênah, “Tui kan hmu ta,” an ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tichuan, chu tuichhunchhuah chu “Siba” a vuah a; chuvângin, chumi khaw hming chu tûn thlengin “Beer-seba” a la ni a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, Esauva chuan kum sawmli mi a nihin, Hit mi Beeria fanu Judithi leh, Hit mi Elona fanu Basemathi nupuiah a nei a;
  </para>
  <para style="p">
    <verse number="35" style="v" />chûngte chu Isaaka leh Rebeki thinlung tiretheitute an ni a.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, heti hi a ni a, Isaaka chu a lo tar a, khaw hmu thei lo khawpa a mit a lo thim hnu chuan a fapa upa zâwk Esauva chu a ko va, a hnênah, “Ka fapa,” a ti a; tin, ani chuan a hnênah, “Heta hi ka awm,” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, ani chuan, “Ngai teh, ka tar tawh êm a, ka thih ni tûr ka hre si lo va.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutichuan, tûnah hian khawngaih takin i hriamhrei, i thal bâwm leh i thal ngul kha keng la, va ramchhuak la, sakhi mi va kahsak rawh;
  </para>
  <para style="p">
    <verse number="4" style="v" />tin, ka thih hmaa mal ka sâwmsakna tûr chein, ka duh zâwng takin chawhmeh tui takah mi siamsak la, ka ei tûrin ka hnênah rawn la rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Isaakan a fapa Esauva a biak lai chu Rebeki chuan a lo hria a. Tin, Esauva chu sakhi kâpa rawn hâwn tûrin ramah chuan a kal ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Rebeki chuan a fapa Jakoba hnênah, “Ngai teh, i pa chuan i u Esauva hnênah,
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Sakhi mi rawn lâk la, ka eia, ka thih hmain Lalpa hmaah mal ka sâwmsakna tûr chein, chawhmeh tui takah mi siam rawh,’ tia a sawi ka hria.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichuan, ka fapa, tûnah hian thu ka pêk che ang zêlin ka thu zâwm ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ran rual zîngah va kal la, chuta ta chu kêlno pahnih ṭha tak mi va lâk rawh; tichuan, chumi chu a duh zâwng takin i pa tân chawhmeh tui takah ka lo siam ang e;
  </para>
  <para style="p">
    <verse number="10" style="v" />tin, a thih hmaa mal a sâwmsakna tûr chein, a ei tûrin i pa hnênah i va kalpui tûr a ni,” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Jakoba chuan a nu Rebeki hnênah, “Ngai teh, ka u Esauva chu mi hmul tak a ni a, kei zawng mi mâm tak ka ni si a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka pa chuan mi lo dap vêl mai thei a; tichuan, ama ngaihin bumtu ang ka lo ni ang a, malsâwm ahnêkin ânchhia indawntîr mai ka ni ang asin,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, a nu chuan a hnênah, “Ka fapa, i ânchhe dawn tûr chu ka chungah awm rawh se; ka thu zâwm la, mi va lâk mai rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, a kal a, a va la a, a nu hnênah a rawn kalpui a; tichuan, a nu chuan a pa duh zâwng takin chawhmeh tui takah a siam a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Rebeki chuan a fapa upa zâwk Esauva silhfên ṭha tak, ina a hnêna awm chu a la a, a fapa naupang zâwk Jakoba chu a thuam a;
  </para>
  <para style="p">
    <verse number="16" style="v" />tin, kêlno vunte pawh chu a kutah leh a nghâwng mâm laiah chuan a bel bawk a;
  </para>
  <para style="p">
    <verse number="17" style="v" />tin, chawhmeh tui tak leh chhang a siamte chu a fapa Jakoba kutah a pe a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, ani chu a pa hnênah a kal a, “Ka pa,” a ti a; tin, ani chuan, “Heta hi ka awm; ka fapa, tu zâwk nge i nih?” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Jakoba chuan a pa hnênah, “I fapa upa zâwk Esauva ka ni; mi tirh ang khân ka ti zo ta a, khawngaih takin tho la, mal mi sâwmsakna tûrin ṭhu la, ka sakhi sa hi ei rawh le,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Isaaka chuan a fapa hnênah, “Ka fapa, eng tizia nge i va rawn hmu hma teh thut ve le?” a ti a. Tin, ani chuan, “ Lalpa i Pathian chuan mi hlawhtlintîr vâng a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Isaaka chuan Jakoba hnênah, “Ka fapa, khawngaih takin lo hnai teh khai, ka lo dap vêl teh ang che, ka fapa Esauva i ni meuh na emaw,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Jakoba chuan a pa Isaaka chu a va hnaih a; tin, ani chuan a lo dap vêl a, “A aw chu Jakoba aw a ni si a, a kutte erawh chu Esauva kut a ni si,” a ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, a u Esauva kut anga a kut a hmul avângin amah chu a hre lo va; chutichuan, mal a sâwm ta a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, “Ka fapa Esauva ngei i ni maw?” a ti a. Tin, ani chuan, “Ni e,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, ani chuan, “Mi han lâk hnaih rawh; tichuan, mal ka sâwmsakna tûr chein ka fapa sakhi sa chu ka lo ei ang e,” a ti a. Tin, a rawn la hnai a, a ei ta a; uain pawh a lâksak a, a in bawk a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, a pa Isaaka chuan a hnênah, “Ka fapa, lo hnai la, mi fâwp rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, a va hnaih a, a fâwp a; tin, ani chuan a silhfên rim chu a hria a, mal a sâwm a, “Ngai teh, ka fapa rim hi Lalpa malsâwm ram rim ang a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tichuan, Pathianin vân daifîm leh lei ṭhatna leh, Buh tam tak leh uain tam tak pe che rawh se.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hnam hrang hrangten i rawng bâwl sela, Chi hrang hrangten chibai bûk che rawh se. I unaute chungah lalah awm langin, I nû faten chibai bûk che rawh se. Anchhe lawhtu apiang che chu ânchhe lawhin awm sela, Malsâwmtu apiang che chu malsâwmin awm rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, heti hi a ni a, Isaakan Jakoba mal a sâwm zawh veleh Jakoba chu a pa Isaaka hnên ata a chhuak hman chauh va, a u Esauva chu a sa pêl a lo hâwng a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, ani pawh chuan chawhmeh tui takah a siam a, a pa hnênah a rawn la ve a; tin, a pa hnênah chuan, “Ka pa, tho la, mal mi sâwmsakna tûrin i fapaa sakhi sa hi ei rawh le,” a ti a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, a pa Isaaka chuan a hnênah, “Tu nge i nih?” a ti a. Tin, ani chuan, “I fapa, i fapa upa zâwk, Esauva ka ni,” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tichuan, Isaaka chu nasa takin a khûr chiam a, “Sakhi kâpa ka hnêna a sa rawn laa, i lo thlen hmaa ka ei zawh veka, mal ka sâwm tâka kha tu nge ni le? A ni, amah chu malsâwmin a awm tawh tho tho vang,” a ti a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esauva chuan a pa thusawi chu a hriatin nasa tak leh lungchhe takin a ṭap ta rawih a, a pa hnênah chuan, “Aw ka pa, kei hi, kei pawh hi mal mi sâwm ve lul rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, ani chuan, “I nau chuan mi rawn bum a, i malsâwmna chu a lâksak ta che a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tin, ani chuan, “A hmingah Jakoba an vuah dik hle lo vem ni? Hei vawi hnih mi lan tâk hi; ka fa tîr nihna chu mi lâksak a; tin, ngai teh, tûnah hian ka malsâwmna mi lâksak leh tâk hi,” a ti a. Tin, amah vêkin, “Malsâwmna mi la zuahsak lâwm ni?” a ti a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, Isaaka chuan a chhâng a, Esauva hnênah, “Ngai teh, amah chu i lalah ka siam a, a unau zawng zawngte pawh a chhiahhlawh atân ka pe vek a; buh leh uainin ka châwm ta bawk a; ka fapa, nanga tân eng nge ka tih ang le?” a ti a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tin, Esauva chuan a pa hnênah, “Ka pa, malsâwmna pakhat chauh em ni i neih? Aw ka pa, kei hi, kei pawh hi mal mi sâwm ve lul rawh,” a ti a. Tin, Esauva chu ring takin a ṭap ta a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, a pa Isaaka chuan a chhâng a, a hnênah, “Ngai teh, i awmna tûr chu lei ṭhatna hlatah leh, Chung lam ata vân daifîm hlatah a ni a awm dâwn ni;
  </para>
  <para style="p">
    <verse number="40" style="v" />I khandaihin a ni i nun dâwn ni, I nau rawng pawh i bâwl dâwn a ni; Tin, heti hi a ni ang a, i tâl chhuah hunah chuan A nghâwngkawl chu i nghâwng ata i thing thla tawh ang,” a ti a.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tin, a pain mal a sâwm avâng chuan Esauva chuan Jakoba chu a haw ta a; tin, Esauva chuan a rilruin, “Ka pa sûn ni tûr chu a hnai tawh a, chumi hunah chuan ka nau Jakoba chu ka that mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tin, a fapa upa zâwk Esauva thusawi chu Rebeki an hrilh a; tichuan, mi a tîr a, a fapa naupang zâwk Jakoba chu a ko va, a hnênah, “Ngai teh, i u Esauva chuan i chungchâng thûah, nangmah tihhlum tumin a inhnêm a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chutichuan, ka fapa, tûnah ka thu hi âwih rawh: tho la, Haran khuaa ka nuṭa Labana hnênah tlân bo rawh.
  </para>
  <para style="p">
    <verse number="44" style="v" />I u thinrimna hi a reh hma loh chuan a hnênah ni eng emaw zât va awm rih rawh;
  </para>
  <para style="p">
    <verse number="45" style="v" />i u thinurna hi i chunga a reha, a chunga i thiltih hi a theihnghilh hunah chuan mi ka tîr ang a, chuta ta chu ka rawn hruai chhuahtîr ang che; eng atân nge ni khatah in pahnihin ka chân ang che u?” a ti a.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tin, Rebeki chuan Isaaka hnênah, “Hetha fanute avâng hian nun hi ka ning êm mai; Jakoba hian hemi ram nula, hêng ang Hetha fanuteho zînga mi hi nupuia a neih leh ve lek phei chuan, ka tân nun hi eng nge sâwt ang?” a ti a.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tichuan, Isaaka chuan Jakoba chu a ko va, mal a sâwm a, thu a pe bawk a, a hnênah, “Kanaan ram nulaho zînga mi hi nupuiah i nei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tho la, Paddan-aram rama i nu pa Bethuela inah kal la, chuta mi chu i nu nuṭa Labana fanute zînga mi nupuiah va nei rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Pathian Engkimtitheia chuan malsâwm chein, hnam hrang hrang tam tak i lo nih theih nân chi tam tak thlahtîr chein, tipung che rawh se;
  </para>
  <para style="p">
    <verse number="4" style="v" />i mikhualna ram, Pathianin Abrahama a pêk hi, i luah nân Abrahama malsâwmna chu dawntîr bawk che rawh se, nang leh i thlahte pawh,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Isaaka chuan Jakoba chu a kal botîr a; tin, Paddan-aram rama Jakoba leh Esauva nu Rebeki nuṭa Suria mi Bethuela fapa, Labana hnênah chuan a kal ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Esauva chuan Isaakan Jakoba chu mal a sâwm a, nupui nei tûrin Paddan-aram ramah a kal botîr tih leh, mal a sâwm laia, “Kanaan ram nulaho zînga mi hi nupuiah i nei tûr a ni lo,” tiin thu a pe tih leh,
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakoban a nu leh a pa thu awihin Paddan-aram ramah a kal ta tih a hria a;
  </para>
  <para style="p">
    <verse number="8" style="v" />tichuan, Esauva chuan Kanaan ram nulate chuan a pa Isaaka lung an tiawi lo tih a hre ta a;
  </para>
  <para style="p">
    <verse number="9" style="v" />tichuan, Esauva chu Ismaela hnênah a va kal a, Abrahama fapa Ismaela fanu Mahalathi, Nebaiotha farnu chu, a nupui atân a nupui neih sate bâkah a va neih belhchhah leh a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Jakoba chu Beer-seba aṭangin a chhuak a, Haran khaw lam a pan ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, khawi lai hmun emaw a han thleng hlauh va, ni a tlâk tawh avângin chutah chuan a riak ta a; tin, chumi hmuna lung pakhat chu a la a, a lukhamah a dah a, chumi hmunah chuan muhîl tûrin a mu ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, mumang a nei a; ngai teh, lei chungah hian leilâwn a lo indawh a, a chhîp chuan vân a thleng a; tin, ngai teh, a chungah chuan Pathian vântirhkohte an chhovin an chhuk a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, ngai teh, a chhîpah chuan Lalpa a ding a, “Kei hi Lalpa , i pu Abrahama Pathian leh Isaaka Pathian chu ka ni; i mutna lei kha nang leh i thlahte ka la pe ang che u.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, i thlahte chu leia vaivut zâtin an awm ang a, thlang lamah te, chhak lamah te, hmâr lamah te, chhim lamah te i darh zau vang a; tin, nangmahah leh i thlahah chuan khawvêla hnam tin an la thawveng ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, ngai teh, i hnênah ka awm a, i kalna apiangah ka vêng zêl ang chia, he ramah hian ka hruai kîr leh ang che; i hnêna ka sawi hi ka tih hma loh chuan ka thlahthlam dâwn lo che a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Jakoba chu a muhîl a han harh a, “He hmunah hian Lalpa chu a awm ngei mai, ka lo hre si lo va,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, a hlau va, “He hmun hi a va hlauhawm êm! Hei hi hmun dang a nih loh hi, Pathian in a lo nih hi le, hei hi vân kawngka a lo nih hi!” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Jakoba chu zîng takah a tho va, lung a lukhama a dah chu a la a, lungphun atân a phun a, a chhîpah chuan sahriak a leih a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, chumi hmun hmingah chuan Bethel a vuah a; a khaw hming erawh chu a tîrah chuan Luz a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Jakoba chuan, “Ka pa ina thlamuang taka ka hâwn lehna tûrin Pathian ka hnêna a awma, he ka kalna kawngah hian mi vêna, ei tûr chhang leh sin tûr silhfên mi pêk dâwn chuan, Lalpa chu ka Pathian a ni ang a,
  </para>
  <para style="p">
    <verse number="22" style="v" />he lung, lungphun atâna ka phun pawh hi Pathian in a ni ang; tin, i mi pêk tûr zawng zawngah chuan sâwma pakhat ka pe ngei ngei ang che,” tiin thu a tiam ta a.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chumi hnuah chuan Jakoba chu a kal ta zêl a, khawchhak fate ram chu a thleng ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, a han en a, ngai teh, phûlah hian tuichhunchhuah a lo awm a; a kiangah chuan berâm rual thum hi an bawk reng a; chumi tuichhunchhuah ata chu berâm rualte chu tui an intîr ṭhîn a ni. Tuichhunchhuah kawngkaa lung awm chu a lian hle a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, chutah chuan berâm rual zawng zawng an kal khâwm ṭhîn a; tin, tuichhunchhuah kawngka ata lung chu an lum sawn a, berâmte chu tui an intîr a, lung chu tuichhunchhuah kawngkaa a awmna pângngaiah chuan an dah leh ṭhîn a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Jakoba chuan an hnênah, “Ka unaute u, khawi lama mi nge in nih?” a ti a. Tin, anni chuan, “Haran khuaa mi kan ni,” an ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, ani chuan an hnênah, “Nahora fapa Labana in hria em?” a ti a. Tin, anni chuan, “Hria e,” an ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, ani chuan an hnênah, “A dam lai em ni?” a ti a. Tin, anni chuan, “Dam lai rih e; en teh, a fanu Rakili pawh berâm hruaia a lo kal saw,” an ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, ani chuan, “Ngai teh u, ni a la sâng hle a; ran hruai khâwm pawh a la hun hek lo. Berâmte hi tui intîr ula, va thlah rawh u khai,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, anni chuan, “Kan thei lo vang, berâm rual zawng zawng an kal khâwm a, tuichhunchhuah kawngka ata lung hi an lum sawn hma loh chuan; chumi hnuah chuan berâmte chu tui kan intîr ṭhîn a ni,” an ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, anmahni a la biak lai chuan, Rakili chu a pa berâmte hruaiin a lo thleng ta a; ani chuan a vêng ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, heti hi a ni a, Jakoba chuan a nu nuṭa Labana fanu Rakili leh, a nu nuṭa Labana berâm rual chu a hmuh chuan Jakoba chuan a va hnaih a, tuichhunchhuah kawngka ata lung chu a lum sawn a, a nu nuṭa berâmte chu tui a intîr ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Jakoba chuan Rakili chu a fâwp a, ring takin a ṭap ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Jakoba chuan a pa tupa a nih leh Rebeki fapa a ni tih Rakili chu a hrilh a; tichuan, Rakili chu a tlân a, a pa a va hrilh ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, heti hi a ni a, Labana chuan a farnua fapa Jakoba chanchin chu a hriat veleh a hmuak tûrin a tlân a, a pawm a, a fâwp a, a inah a hruai ta a. Tin, Jakoba chuan chûng thu zawng zawng chu Labana chu a hrilh a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Labana chuan a hnênah, “Ka ruh leh ka tisa ngei i nih chu le,” a ti a. Tin, a hnênah thla khat a awm ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Labana chuan Jakoba hnênah, “Ka tupa i nih avângin a thlâwnin ka rawng i bâwl tûr em ni? Eng nge i hlawh ang? Mi hrilh teh khai,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Labana chuan fanu pahnih a nei a: a upa zâwk hming chu Leaii a ni a, a naupang zâwk hming chu Rakili a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Leaii mit chu a pâwl a; Rakili erawh chu mi tituai ṭha tak a ni a, a hmêl pawh a ṭha hle a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Jakoba chuan Rakili chu a hmangaih a; tichuan, “I fanu naupang zâwk Rakili nei tûrin kum sarih i rawng ka bâwlsak ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Labana chuan, “Ani chu mi dang ka pêk ai chuan ka pêk che a ṭha zâwk ang chu; ka hnênah awm reng mai rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Jakoba chuan Rakili nei tûr chuan kum sarih chu rawng a bâwl ta a; nimahsela, a hmangaih hle avângin ni rei lo tê ang chauhvin a hria a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Jakoba chuan Labana hnênah. “Ka pâwl theihna tûrin ka nupui chu mi pe rawh le, ka hun a kim tawh si a,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tichuan, Labana chuan chumi khuaa mi zawng zawng chu a khâwm vek a, ruai a ṭheh a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, heti hi a ni a, thimhlimah chuan a fanu Leaii chu a hruai a, Jakoba hnênah a hruai lût a; tin, ani chu a lo pâwl a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Labana chuan a bâwihnu Zilpaii chu a fanu Leaii hnênah a bâwihnu atân a pe a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, heti hi a ni a, zîng a lo nih chuan, ngai teh, Leaii a lo ni si a; tichuan, Jakoba chuan Labana hnênah, “Ka chunga i thiltih hi eng tizia nge ni le? Rakili nei tûrin i rawng ka bâwl lo vem ni? Eng vângin nge mi bum mai le?” a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Labana chuan, “Kan ramah hian chutianga fa u hmaa a naupang zâwk kaltîr chu dân a ni lo asin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hemia ni sarih hi tlingtla rih la; tichuan, kum sarih dang ka rawng i bâwl leh tûr aiah chuan mi dang pawh chu kan pe ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tichuan, Jakoba chuan chutiang chuan a ti a, a ni sarih chu a tlingtla a; tichuan, a fanu Rakili chu nupuiah a pe ta a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Labana chuan a bâwihnu Bilhaii chu a fanu Rakili hnênah a bâwihnu atân a pe a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Rakili chu a pâwl bawk a, Leaii ai chuan Rakili chu a hmangaih zâwk bawk a, Labana rawng chu kum sarih dang a bâwl leh ta a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Lalpa chuan Leaii chu huatin a awm tih a hria a; tichuan, a chhûl a hawnsak a; Rakili erawh chu a ching a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, Leaii chu a rai a, fapa a hring a, a hmingah chuan Reubena a sa a; “ Lalpa chuan ka hrehawmzia a hmuh avâng a nih hi; tûnah zawng ka pasalin mi hmangaih tawh ang,” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, a rai leh a, fapa a hring leh a; “ Lalpa chuan huatin ka awm tih a hriat avângin hei pawh hi mi pe a nih hi,” a ti a; tichuan, a hmingah chuan Simeona a sa a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, a rai leh a, fapa a hring leh a; “Tûnah zet chuan fapa pathum ka hrinsak tâk avângin ka pasalin mi zâwm tawh ang,” a ti a; chuvângin, a hmingah chuan Levia an sa a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, a rai leh a, fapa a hring leh a; “Tûn ṭumah hi chuan Lalpa ka fak ang,” a ti a; chuvângin, a hmingah chuan Juda a sa a; tin, fa a hring leh ta rih lo va.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Rakili chuan Jakoba chu fa rêng rêng a hrinsak lo tih a inhriat chuan, a laizâwnnu chu a îtsîk ta a; tin, Jakoba hnênah chuan, “Fate mi pe rawh; chuti lo chuan, ka thi ang,” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Rakili chungah chuan Jakoba thin chu a lo ur ta thut a; tichuan, “I rîla rah phal lotu Pathian aiawhtu ka ni em ni?” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, ani chuan, “En teh, ka bâwihnu Bilhaii saw, amah saw pâwl rawh; chutichuan, kei pawhin ama lakah fate ka neih ve theih nân, ka mal chungah hian fa a hring dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, a bâwihnu Bilhaii chu a nupui atân a pe a; tin, Jakoba chuan ani chu a lo pâwl a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Bilhaii chu a rai a, Jakoba chu fapa a hrinsak ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Rakili chuan, “Pathianin mi ngaihtuah a, ka aw a hre bawk a, fapa mi pe a nih hi,” a ti a; chuvângin, a hmingah chuan Dana a sa a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Rakili bâwihnu Bilhaii chu a rai leh a, Jakoba chu fapa dang a hrinsak leh a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Rakili chuan, “Pathian buanin ka laizâwnnu ka buan a, ka hneh ta,” a ti a; tichuan, a hmingah chuan Naphtalia sa a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Leaii chuan fa dang a hring leh ta rih lo fo tih a inhriatin, a bâwihnu Zilpaii chu a hruai a, a nupui atân Jakoba a pe a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tichuan, Leaii bâwihnu Zilpaii chuan Jakoba chu fapa a hrinsak a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Leaii chuan, “A va vânneihthlâk êm!” a ti a; tichuan, a hmingah chuan Gada a sa a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Leaii bâwihnu Zilpaii chuan Jakoba chu fapa dang a hrinsak leh a,
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Leaii chuan, “Ka va nihlawh êm! Hmeichheho chuan nihlawh mi ti ngawt dâwn a nih hi,” a ti a; tichuan, a hmingah chuan Asera a sa a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, buh lâk laiin Reubena chuan phûlah zâwlaidi a va hmu a, a nu Leaii hnênah a rawn la a. Chutichuan, Rakili chuan Leaii hnênah, “Khawngaih takin i fapa zâwlaidi ṭhenkhat kha mi lo pe teh,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, ani chuan a hnênah, “Ka pasal mi chhuhsak hi thil duai em ni? Ka fapaa zâwlaidi pawh hi mi chhuhsak i tum lehzêl maw?” a ti a. Tin, Rakili chuan, “A nih loh leh, i fapaa zâwlaidi aiah hian zâninah a mutpui ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, tlai lamah chuan Jakoba chu phûl aṭang chuan a lo hâwng a; tin, Leaii chu a hmuak tûrin a chhuak a, “Mi pâwl tûr a ni; ka fapaa zâwlaidiin ka hawh tawh tlat si chia,” a ti a. Tichuan, chumi zân chuan a mutpui ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Pathianin Leaii ṭawngṭaina chu a ngaithla a; tichuan, a rai a, Jakoba chu fapa pangana a hrinsak leh a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Leaii chuan, “Ka bâwihnu chu ka pasal hnêna ka pêk avângin Pathianin ka hlawh mi pe ta a nih hi,” a ti a; tichuan, a hmingah chuan Isakara a sa a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Leaii chu a rai leh a, Jakoba chu fapa parukna a hrinsak leh a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Leaii chuan, “Pathianin thuam ṭha tak mi neihtîr a; tûnah zawng ka pasal chu, fapa paruk ka hrinsak tâk avângin ka hnênah a chêng tawh ang,” a ti a; tichuan, a hmingah chuan Zebuluna a sa a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, chumi hnuah chuan fanu a hring leh a, a hmingah chuan Dinaii a sa a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Pathianin Rakili chu a hre reng a; tichuan, Pathianin a ṭawngṭaina a ngaithla a, a chhûl a hawnsak ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, a rai a, fapa a hring ta a; tin, “Pathianin ka hmingchhia a chhilh ta,” a ti a;
  </para>
  <para style="p">
    <verse number="24" style="v" />tin, “Lalpa chuan fapa dang mi pêk belhchhah leh rawh se,” tiin a hmingah chuan Josefa a sa a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, heti hi a ni a, Rakili chuan Josefa chu a hrin hnuin, Jakoban Labana hnênah, “Keima awmna pângngaiah, kan ram lama ka hâwnna tûrin mi kaltîr tawh rawh khai.
  </para>
  <para style="p">
    <verse number="26" style="v" />I rawng ka bâwl chhan ka nupuite leh ka fate hi mi pe la, mi kaltîr rawh; i rawng ka bâwlsakzia che chu i hre si a,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, Labana chuan a hnênah, “Mi khawngaih theih chuan la awm ta rih che, Lalpa chuan nangma zâran mal mi sâwm tih aienin ka hria asin,” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, amah vêk chuan, “I hlawh tûr ruat la, mi hrilh teh; tichuan, ka pe dâwn che nia,” a ti a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, ani chuan a hnênah, “Engtin nge i rawng ka bâwla, engtin nge i ran chu ka hnênah an awm i hria alâwm.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka lo kal hma zawngin tlêm tê chauh i nei a, tûnah zawng tam taka an lo chan tâk hi; ka pênna lam apiangah Lalpa chuan mal a sâwm zêl che a ni; amaherawhchu, eng tikah nge keima chhûngkaw tân ka thawh chhuah ve ang?” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, ani chuan, “Eng nge ka pêk ang che?” a ti a. Tin, Jakoban, “Eng mah mi pe tûr a ni lo; he thil hi mi tihsak chuan i ran rual chu ka thlahin ka vêng leh ang e.
  </para>
  <para style="p">
    <verse number="32" style="v" />Vawiinah hian i ran rual chu ka va en chhuak vek ang a, berâm zînga a hângin a kah chik nuk leh a hângin a kah phoh phoh leh a hâng apiang leh, kêl zînga a vârin a kah chik nuk leh a vârin a kah phoh phohte chu chuta ta chu ka hruai hrang zêl ang; tin, tûn achina chutianga lo piang apiangte chu ka hlawh tûr ni ang hmiang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chutichuan, tûn achinah, i mit hmuha awm ka hlawh kawng thûah i lo kal hun chuan, ka felna hian mi chhânsak mai ang; kêl zînga a vârin a kah chik nuk loh leh a vârin a kah phoh phoh loh leh, berâm zînga a hâng lo ka hnêna i hmuh apiang chu ka rûkah i ruat mai tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, Labana chuan, “Ngai teh, i sawi ang tak chu ni ang hmiang,” a ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tichuan, chumi ni tak chuan kêlpa, a vâra ze tan leh a vârin a kah phoh phoh zawng zawng leh, kêlnu, a vârin a kah chik nuk leh a vârin a kah phoh phoh zawng zawng, a vâr tel apiang chu, berâm zînga a hâng zawng zawngte nên chuan a hruai hrang a, a fapate kutah a pe a;
  </para>
  <para style="p">
    <verse number="36" style="v" />tin, amah leh Jakoba kârah chuan ni thum kalah a awmtîr a; tin, Jakoba chuan Labana ran rual dang zawng zawng chu a thlah leh ta a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, Jakoba chuan hriang leh vaiumkhal leh thingse tiang hring a la a, a pil a khawk vâr thliah a, tiangahte chuan a vâr chu a tilang a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tin, a tiang pil khawhte chu ran rualten an rawn in ṭhinna tui inna thlêngah te, tui luannaah te chuan, ran rualte hma zâwn zêlah a dah ta a; tin, tui in tûra an lo kal lai chuan an lo rai ṭan ṭhîn a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tichuan, ran rualte chu tiang zâwnahte chuan an rai ṭan a, a ze tan te, a ze chik nuk te, a ze phoh phoh te an rawn hring ṭhîn a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tin, Jakoba chuan berâmnote chu a dah hrang a; tin, ran rualte chu Labana ran rual zînga a ze tan leh a hâng zawng zawng lam chu a hawitîr ṭhîn a; ama ran rualte chu a dah hrang ṭhîn a; Labana ran zîngah chuan a dah lo va.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tin, heti hi a ni a, ran chak deuhte chu an rai ṭan apiangin tiang zînga an rai ṭan theihna tûrin, Jakoba chuan tui luannaah, ran mit hmuhah chuan tiangte chu a dah ṭhîn a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amaherawhchu, ran chu an ṭan a ṭhat loh chuan a dah ṭhîn lo; chutichuan, a no ṭanṭha lo deuhte chu Labana ta a ni zêl a, a chak deuhte chu Jakoba ta a ni zêl a.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tichuan, Jakoba chu nasa takin a lo pung a, ran rual, rual lian tak tak te, bâwihnu te, bâwihpa te, sanghâwngsei te, sabengtung te a lo nei ta a.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, ani chuan Labana fapaten, “Jakoban kan pa ta zawng zawng chu a lâksak vek a, kan pa taa mi a ni, hêng ropuina zawng zawng hi a hmuh ni,” an tih thute a lo hre ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, Jakoban Labana hmêl a en a; tin, ngai teh, tûn hma lam angin a chungah a ṭha ta lo tih a hria a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Lalpa chuan Jakoba hnênah, “I thlahtute ramah leh i laichînte hnênah haw leh tawh rawh; i hnênah ka awm zêl dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, Jakoba chuan mi a tîr a, phûla a ran rual awmna lamah chuan Rakili leh Leaii chu a ko va;
  </para>
  <para style="p">
    <verse number="5" style="v" />tin, an hnênah, “In pa hmêl ka hmuhin, tûn hma lam angin ka chungah a ṭha ta lo tih ka hria a; nimahsela, ka pa Pathian chu ka hnênah a awm reng a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangni pawhin in pa rawng hi ka theihtâwpin ka bâwl tih in hria a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nimahsela, in pa chuan mi bum a, ka hlawh hi vawi sâwm lai mi tihdanglamsak tawh a; nimahsela, Pathianin ka pawi a khawih a phal lo a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />‘A ze chik nukte chu i hlawh a ni ang,’ a tih leh, ran zawng zawng chuan a ze chik nukte an hring ṭhîn a; tin, ‘A ze tante chu i hlawh a ni ang,’ a tih leh, ran zawng zawng chuan a ze tante an hring ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutiangin Pathianin in pa rante chu a lâksak a, keimah mi pe ta a nih hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, heti hi a ni a, rante chu an rai ṭan lai chuan, ka mumangah chuan ka han dâk a; tin, ngai teh, a pa, ran bawhtute chu, a ze tan te, a ze chik nuk te, a ze zeng zung te an ni tih ka hmu a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, ka mumangah chuan Pathian vântirhkohvin, ‘Jakob,’ mi lo ti a; tin, keiin, ‘Heta hi ka awm,’ ka ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ani chuan, ‘Han dâk la, en rawh, a pa, ran bawhtu zawng zawng saw, a ze tan te, a ze chik nuk te, a ze zeng zung te an nih saw; Labanan i chunga a thiltih zawng zawng hi ka hmu asin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei hi, lungphuna sahriak i hnawihna, ka hnêna thu i tiamna Bethel, kha Bethel Pathian kha ka ni; tûnah tho la, he ram ata hi chhuak la, i pianna ramah chuan haw leh tawh rawh,’ a ti a,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Rakili leh Leaii chuan an chhâng a, a hnênah. “Kan pa inah chuan kan tân chanvo leh ro khâwm tûr rêng a la awm cheu em ni?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ani chuan mikhual ang lekah min ngai tawh a ni lâwm ni? Min hralh a, kan man pawh a ei zo vek tawh si a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathianin kan pa laka sum a lâksak zawng zawng chu keimahni leh kan fate ta a nih hi; chutichuan, Pathianin i hnêna a sawi apiang chu ti rawh khai,” an ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, Jakoba chu a tho va, a fapate leh a nupuite chu sanghâwngsei chungahte a chuantîr a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Kanaan rama a pa Isaaka hnêna kal tûrin a ran zawng zawng leh, a sum khâwl khâwm zawng zawng, a ran hmuhte, Paddan-aram rama a khâwl khâwmte chu a kalpui ta vek a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Labana chu a berâm hmul mêt tûrin a kal daih a; tin, Rakili chuan a pa milemte a rûksak a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Jakoba chu Suria mi Labana hriat loh hlânin a kal ru ta daih a, a tlân bo tûr chu a hrilh lo va.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichuan, a neih zawng zawng nên chuan a tlân bo ta a; tin, a tho va, Luipui chu a kân a, Gilead tlâng lam chu hmachhawnin a pan zêl a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, a ni thum nîah chuan Jakoba a tlân bo tih Labana chu an hrilh a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, a unaute a hruai a, ni sarih kal a ûm a; Gilead tlângah chuan a ûm pha ta a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Suria mi Labana hnênah chuan zâna a mumangah Pathian a lo kal a, a hnênah, “Jakoba hnênah a chhia a ṭha enga mah sawi lo tûrin fîmkhur rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Labana chuan Jakoba chu a ûm pha ta a. Tin, Jakoba chuan a puan in chu tlângah a lo zâr tawh a; tin, Labana pawhin a unaute nên chuan Gilead tlângah an zâr ve ta a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Labana chuan Jakoba hnênah, “I thiltih hi eng tizia nge ni le, ka hriat loh hlâna i kal rûk daiha, chemsen bâwihte ang maia ka fanute i hruai bo hi?
  </para>
  <para style="p">
    <verse number="27" style="v" />Eng vângin nge a rûka i tlân bova, mi kal rûksana, hlimna te nên, hla te nên, khuangtê te nên, ṭingṭang te nên ka thlahna tûr chein mi hrilh lohva,
  </para>
  <para style="p">
    <verse number="28" style="v" />ka tute leh ka fanute ka fawh i phal loh ni? Atthlâk takin a ni thil i tih ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tichhe thei che ka ni asin; nimahsela, i pa Pathian chuan nizânah khân, ‘Jakoba hnênah a chhia a ṭha a enga mah sawi lo tûrin fimkhur rawh,’ tiin mi bia a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, i pa in i ngaih tawh êm êm avângin kal châk hle mah la, eng vângin nge ka pathiante mi rûksak ni?” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Jakoba chuan a chhâng a, Labana hnênah, “Ka hlauh vâng a ni; i fanute hi mi lâk luihsak dah ang e, ka ti a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tu pawh i pathiante lo kawltu apiang chu an nung lo vang; kan unaute mit hmuhah hian i ta ka hnêna awm chu en chiang la, la ta che,” a ti a. Rakilin a lo ru tih Jakoban a hre si lo va.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Labana chu Jakoba puan inah te, Leaii puan inah te, bâwihnu pahnih puan inah te a lût zêl a; nimahsela, a hmu lo va. Tin, Leaii puan in ata chu a chhuak a, Rakili puan inah chuan a lût leh a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, Rakili chuan milemte chu a lo la a, sanghâwngsei thuamhnaw zîngah a lo dah a, a lo ṭhut hnan diam a. Tin, Labana chuan a puan in chhûng zawng zawng chu a dap vêl vek a; nimahsela, a hmu lo va.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, ani chuan a pa hnênah, “I hmaa ka thawh peih loh avâng hian, ka lalpa, thinur suh ang che; hmeichhe awm dân pângngai chu ka chunga a awm lai tak a ni si a,” a ti a. Tichuan, a zawng a zawng a; nimahsela, milemte chu a hmu zo ta lo va.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tin, Jakoba chu a thinur ta a, Labana chu a hau va; Jakoba chuan Labana hnênah, “Eng nge ka bawhchhiata, eng nge ka sualna, mi rawn ûm vak mai ni?
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka bungrua zawng zawng i dap vêl pawhin, i in chhûng bungrua rêng rêng eng nge i hmuh ni? Keini pahnih hi min ngaihtuah theihna tûrin ka unaute leh i unaute hmaah hian dah rawh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hei kum sawmhnih zet i hnênah ka awm ta a; i berâmpuite leh i kelpuite chuan an note an hring sual ngai lo va, i berâm rual zînga a pate pawh ka ei ngai si lo va.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ramsa sehte pawh i hnênah ka rawn thlen ngai lo va; keiin a bo ai chu ka tuar zâwk ṭhîn a; chhûna rûk emaw, zâna rûk emaw ka rulh i phût ṭhîn.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hetiangin ka awm ṭhîn; chhûna ni sa leh zâna khaw vâwtin mi tihrehawm êm êm ṭhîn a; mut pawh ka hmu ngai ṭhîn lo va.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chûng kum sawmhnih chhûng zawng chu i inah ka awm a; i fanute pahnih hlawh tûrin kum sâwm leh kum li i rawng ka bâwl a, i rante hlawh tûrin kum rûk ka bâwl leh a; ka hlawh lah chu vawi sâwm lai i tidanglam si a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka pa Pathian, Abrahama Pathian, Isaaka ṭiha chu ka hnênah awm lo phei sela chu, tûnah pawh hian ruak ngawta mi hâwntîr ngei ngei tûr i nih hi. Pathianin ka hrehawmzia leh ka thawh rimzia chu a hmu a, nizânah chuan a zilh che a nih chu,” a ti a.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tin, Labana chuan a chhâng a, Jakoba hnênah. “Fanute hi keima fanu an ni a, naupangte hi keima naupang an ni a, rante hi keima ran an ni a, i hmuh zawng zawng hi keima ta vek an ni; vawiinah hian hêng ka fanute chungah leh, an fa hrinte chungah hian eng nge ka tih theih ang?
  </para>
  <para style="p">
    <verse number="44" style="v" />Hawh teh, kei leh nang hian thu i thlung teh ang; chu chu kei leh nanga kârah hriatna ni rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tichuan, Jakoba chuan lung a la a, lungphun atân a phun a.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tin, Jakoban a unaute hnênah, “Lung la khâwm rawh u,” a ti a; tin, lung an la a, an tiang khâwm a; tin, lung tian khâwm kiangah chuan chaw an ei a.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tin, Labana chuan chu lung tian khâwm chu Jegar-sahadutha a vuah a; Jakoba erawh chuan Galeed a vuah a.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tin, Labana chuan, “He lung tian khâwm hi vawiinah hian kei leh nanga kârah hriatna a nih hi,” a ti a. Chuvângin, a hmingah chuan Galeed vuah a ni ta a;
  </para>
  <para style="p">
    <verse number="49" style="v" />Mizpa vuah a ni bawk a, Labanan, “Inṭhena kan awm hunin Lalpa chuan min vêng tawn rawh se.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ka fanute hi i tihretheiha, ka fanute lo hi nupui dangte i neih chuan, tu mah kan hnênah an awm lo na a, en teh, Pathian chu kei leh nanga kârah hretu a ni,” a ti si a.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tin, Labana vêkin Jakoba hnênah, “He lung tian khâwm hi en la, keimah leh nangma inkâra he lung ka phun pawh hi en teh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Pawi inkhawihsak tûrin kei hi he lung tian khâwm hi pêlin i hnên lamah ka lo kal lo vang, tih leh, nang pawh he lung tian khâwm leh he lungphun hi pêlin ka hnên lamah i lo kal lo vang tih, he lung tian khâwm hi hriatna ni sela, he lungphun pawh hi hriatna ni bawk rawh se.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abrahama Pathian, Nahora Pathian, an pa Pathian chuan kan kâra thu ngaihtuah rawh se,” a ti leh a. Tin, Jakoba chuan a pa Isaaka ṭiha chu chhâlin chhia a chham ta a.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tin, Jakoban tlângah chuan inthawina a hlân a, a unaute chu chhang ei tûrin a ko va; tichuan, chhang an ei a, tlângah chuan an riak ta hlawm a.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tin, zîng takah Labana chu a tho va, a tute leh a fanute chu a fâwp a, mal a sâwm a; tin, Labana chu a kal a, ama awmna lamah a haw leh ta a.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Jakoba chu a kal ta zêl a; tin, Pathian vântirhkohten an lo tâwk a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Jakoban anni chu a hmuh chuan, “Hêng hi Pathian pâwlho an ni,” a ti a; tichuan, chumi hmun hmingah chuan Mahanaim a vuah a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Jakoba chuan Seir rama Edom phûl lamah, a u Esauva hnênah chuan a hmaah zualkote a kaltîr a.
  </para>
  <para style="p">
    <verse number="4" style="v" />An hnênah, “Ka lalpa Esauva hnênah chuan heti hian in sawi tûr a ni, ‘I chhiahhlawh Jakoban heti hian a ti a ni: “Labana hnênah chuan ka mikhual a, tûn thlengin ka awm ta reng a;
  </para>
  <para style="p">
    <verse number="5" style="v" />bâwngpa te, sabengtung leh berâm te, bâwihpa leh bâwihnu te ka nei hlawm a; tichuan, i mit ka tlun theih nân ka lalpa hrilh tûrin mi ka rawn tîr a ni,” a ti,’” tiin anni chu thu a pe a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, zualkote chu Jakoba hnênah an lo kîr leh a, “I u Esauva hnên kan va thleng a; tin, mi zali rawn hruaiin hmuak tûr chein a lo kal nghe nghe asin,” tiin an sawi a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutichuan, Jakoba chuan a hlau êm êm a, a mangang ta a; tichuan, a hnêna mi awm te, berâm rual te, bâwng rual te, sanghâwngsei te chu pâwl hnihah a siam a;
  </para>
  <para style="p">
    <verse number="8" style="v" />“Esauva chu pâwl pakhat hnênah a lo kala a thah chuan, pâwl pakhat la awm chu an tlân bo thei ang,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Jakoba vêk chuan, “Aw, ka pu Abrahama Pathian, ka pa Isaaka Pathian, aw Lalpa , ‘I ram lamah leh i laichînte hnênah haw leh tawh rawh; tichuan, ka ti ṭha ang che,’ mi titu,
  </para>
  <para style="p">
    <verse number="10" style="v" />i chhiahhlawh chunga khawngaihna zawng zawng i lantîr zîngahte hian, a tenau ber pawh hmu tlâk ka ni lo ve; he Jordan lui hi ka tiang nên chauh ka kân a; tûnah zawng pâwl hnih zet ka lo nih tâk hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khawngaih takin ka u kut ata, Esauva kut ata ngei chu mi chhan him ang che; nunau chawpa mi rawn thah ka hlau si a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangin, ‘Ka ti ṭha ngei ngei ang chia, i thlahte chu tuifinriata ṭiau vaivut chhiar sên loh khawp hiala a tam angin ka siam ang e,’ i ti a,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, chumi zân chuan chutah chuan a riak ta a; tin, a neih zînga mi, kêlpui zahnih leh kêlpa sawmhnih, berâmpui zahnih leh berâmpa sawmhnih, sanghâwngsei sâwr lai sawmthum an note nên, bâwngpui sawmli leh bâwngpa sâwm, sabengtungpui sawmhnih leh sabengtungno sâwm chu a u Esauva tân lâwmmanah a la hrang a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, chûngte chu pâwl tin a hrang ṭheuhvin, a chhiahhlawhte kutah a kawltîr a; tin, a chhiahhlawhte hnênah chuan, “Ka hmaah kal kai ula, pâwl tin hi kâr neihtîr zêl rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, a hma hruaitu hnênah chuan, “Ka u Esauva chuan a tawh chia, ‘Tu mi nge i nih? Khawiah nge i kal dâwn? I hmaa awmte hi tu ta nge?’ tia a zawh hun che chuan,
  </para>
  <para style="p">
    <verse number="18" style="v" />‘I chhiahhlawh Jakoba ta an ni; ka pu Esau, i tân lâwmmanah a thawn che a nih hi; ngai teh, amah pawh kan hnungah sâwn a awm,’ ti ang che,” tiin thu a pe a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, a dawttu leh, a dawt lehtu leh, ran rual khalhtu dang zawng zawng hnênah pawh, “Esauva in hmuh hun chuan chutiang bawk chuan in sawi tûr a ni;
  </para>
  <para style="p">
    <verse number="20" style="v" />tin, ‘Ngai teh, i chhiahhlawh Jakoba chu kan hnungah sâwn a awm,’ ti bawk ang che u,” tiin thu a pe ṭheuh va. “Lâwmman ka hmaa kal hianin a thin ka tidam ang a, chumi hnuah chuan a hmêl ka hmu ang; tichuan, mi lo lâwm mahna,” a ti a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichuan, lâwmman chu a hmaah chuan a kal kai ta a; ani erawh chu, chumi zân chuan a pâwl zîngah chuan a riak ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, zânah chuan a tho va, a nupuite pahnih leh, a bâwihnute pahnih leh, a fa sâwm leh pakhatte chu a hruai a, Jabok lui kaiah chuan a kai ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, anni chu a hruai a, lui chu a kaitîr a, a neih zawng zawng pawh a kaitîr bawk a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Jakoba chu amah chauhvin a awm ta a; tin, mi pakhatin ani chu khawfîng chah thlengin a buan a buan a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, a hneh lo tih a inhriatin a malpui ruh chuktuahah chuan a khawihsak a; tichuan, a buan lai chuan Jakoba malpui ruh chuktuah chu a lo pelhsawlh ta a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, ani chuan, “Mi thlah rawh, khawfîng pawh a chah dâwn tawh hi,” a ti a. Tin, ani chuan, “Mal mi sâwm loh chuan ka thlah lo vang che,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, ani chuan a hnênah, “I hming eng nge ni?” a ti a. Tin, ani chuan, “Jakoba,” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, ani chuan, “I hming chu Jakoba an ti tawh lo vang a, Israela an ti zâwk tawh ang; Pathian leh mihring i bei a, i hneh tawh si a,” a ti a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Jakoba chuan ani chu a zâwt a. “Khawngaih takin i hming mi hrilh rawh,” a ti a. Tin, ani chuan, “Eng vângin nge ni ka hming mi zawh?” a ti a. Tin, chutah chuan mal a sâwm ta a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Jakoba chuan chumi hmun hmingah chuan Peniel a vuah ta a: “Pathian chu a hmaihma ngeiah ka hmu a, ka nunna hi zuah a ni si,” a ti a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Penuel a pelh lai chuan ni a lo chhuak a, amah chu a rawn chhun a, a malpui avâng chuan a lo bai ta a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuvângin, tûn thlengin Israela thlahte chuan malpui ruh chuktuaha khêl tha awm hi an ei ngai lo; Jakoba malpui ruh chuktuah chu a khêl tha lai taka a khawih avângin.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Jakoba chu a han dâk a; tin, ngai teh, Esauva chu a hnêna mi zalite nên an lo kal a. Tichuan, a fate chu Leaii hnênah te, Rakili hnênah te, bâwihnu pahnih hnênah te a sem thliah a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, bâwihnute leh an fate chu a hmatâwng berah a dah a, Leaii leh a fate chu a dawtah a dah a, Rakili leh Josefa chu a hnung berah a dah a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, amah chu an hmaah chuan a kal a, a u bul a thlen hma chuan vawi sarih lei siin chibai a bûk a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Esauva chu amah lâwm tûrin a tlân a, a pawm a, a ir a chuktuah a, a fâwp a; tin, an ṭap dûn ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Esauva chu a han dâk a, hmeichhiate leh naupangte chu a hmu a; tichuan, “I rawn hruaite saw tute nge ni?” a ti a. Tin, ani chuan, “Pathianin khawngaih taka i chhiahhlawh a pêk naupangte an nih saw,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichuan, bâwihnute chu anmahni leh an fate nên chuan an lo kal hnai a, an kûn a, chibai an bûk a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Leaii pawh a fate nên chuan an lo kal hnai a, an kûn a, chibai an bûk ve a; tin, chumi hnuah chuan Josefa leh Rakili chu an lo kal hnai a, an kûn a, chibai an rawn bûk bawk a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Esauva chuan, “Ran rual ka tawh zozaite kha eng tizia nge ni?” a ti a. Tin, ani chuan, “Ka lalpa, i mit ka tlun theih nân ka ti a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Esauva chuan, “Kei pawhin ka ngah e, ka nau; i neih zawng zawng chu i ta ni rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Jakoba chuan, “Ni lo ve, i mit ka tlun chuan, khawngaih takin ka lâwmman pêk che kha mi pawmsak rawh; Pathian hmêl hmu angin i hmêl ka hmu a, ka chungah i lâwm si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathianin mi khawngaih avâng leh, ka ngah avâng hian khawngaih takin ka thil rawn pêk che kha pawm rawh,” a ti a. Tichuan, a thlêm a thlêm a, a pawm ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Esauva chuan, “Hawh, i kal ang, hma ka hruaisak ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, ani chuan a hnênah, “Naupangte hi an la têt leh, berâm rual leh bâwng rual ka hnêna awmte hi no hruai an nih, ka lalpa, i hria e; ni khat chauh pawh an khalh chak lutuk chuan ran rual zawng zawng hi an thi mai ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka lalpa, khawngaih takin i chhiahhlawh hmaah hian kal la; kei chuan Seir tlângah, ka lalpa, i hnên ka thlen hma loh chuan, ka hmaa ran kal hi an kal theih tâwk ang zêl leh, naupangte kal theih tâwk ang zêlin, zawimuangin ka rawn chhawm zêl ang e,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Esauva chuan, “Ka hnêna awm mi ṭhenkhatte hi ka hnutchhiah tal ang che chu,” a ti a. Tin, ani chuan, “Engah kher maw? Ka lalpa mit mi tluntîr mai rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutichuan, Esauva chu chumi ni vêk chuan Seir tlâng lam panin a kîr leh ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Jakoba chu Sukkoth hmunah chuan a kal a, ama tân in a sa a, a rante tân bûkte a sa bawk a; chuvângin, chumi hmun hming chu Sukkoth an ti ta a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Jakoba chu Paddan-aram ram ata a lo kal chu thlamuang takin Sekem khua, Kanaan rama awm chu a thleng a, dai kiangah chuan a puan in chu a zâr ta a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, a puan in zârna hmun chu, Sekema pa Hamora fate hnên aṭangin tangka zain a lei a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutah chuan maichâm a siam a, a hmingah chuan El-Elohe-Israel a vuah a.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Leaii fanu Dinaii, Jakoba a hrinsak chu chumi ram nulate hmu tûrin a va lêng chhuak a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Hiv mi Hamora, chumi ram lal fapa Sekema chuan ani chu a lo hmu a; tin, a man a, a mutpui a, a tlâwm ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, a rilru chu Jakoba fanu Dinaii chungah chuan a awm tlat a, chu nula chu a hmangaih a, ani chu ṭawngkam ṭha takin a bia a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Sekema chuan a pa Hamora chu a bia a, “He nula hi nupuiah mi neihsak rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Jakoba chuan a fanu Dinaii chu Sekeman a tibawrhbâng tih a lo hria a; a fapate chu phûlah a ran zîngah an awm a; tichuan, an lo hâwn hma loh chuan Jakoba chu a ngawi reng a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Sekema pa Hamora chu Jakoba be tûrin a hnênah a kal a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Jakoba fapate chuan an hriat veleh phûl aṭang chuan an lo hâwng ta a; tin, Jakoba fanu mutpuiin Israel-ho zînga thil sual âtthlâk tak, thil tih hauh loh tûr chu a tih tâk avângin an lungngai a, an thinur ta êm êm a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Hamora chuan anmahni a bia a, “Ka fapa Sekema rilru chu in fanu chungah a awm tlat a; khawngaih takin nupuiah neihtîr ta che u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, i innei tawn ang u; in fanute min neihtîr ula, kan fanute pawh nei bawk rawh u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tichuan, kan hnênah in awm ang a, ram pawh hi a awm duai fo vang; hêngah hian awmin sumdâwng ula, hêngah hian lo intimuk rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Sekema chuan nula pa leh a nuṭate hnênah, “Mi khawngaih rawh u, ka hnêna in sawi apiang ka pe zêl ang che u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Man leh thilpêk chu eng zât pawh ngên ula, in tih ang zêlin ka pe ang che u; eng pawh ni sela, nula chu nupuiah mi neihtîr phawt mai rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Jakoba fapate chuan an farnu Dinaii chu a tihbawrhbân avângin, Sekema leh a pa Hamora chu ngamthlêmnain an chhâng a, an sawi ve a,
  </para>
  <para style="p">
    <verse number="14" style="v" />an hnênah, “He thil - serhtan lo mi, kan farnu pêk hi - kan ti thei lo vang; chu chu kan tân hmingchhiatna tûr a ni si a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hetianga in tiam chauh hian in thu ang chu kan remti ang: in zînga mipa tawh phawt chu serh tanin keimahni angin awm ula;
  </para>
  <para style="p">
    <verse number="16" style="v" />chutichuan, kan fanute kan neihtîr ang che u a, keini pawhin in fanute kan nei bawk ang a; tin, in hnênah kan awm ang a, chi khat kan lo ni dâwn nia.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nimahsela, serhtan kawnga kan thu in zawm dâwn loh chuan kan fanu chu kan hruai ang a, kan kal mai ang,” an ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, an thu chuan Hamora leh Hamora fapa Sekema chu a tilâwm a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tichuan, tlangvâl chuan Jakoba fanu chu a duh hle avângin, chu thil chu rei rial lovin a ti ta mai a; ani chu a pa chhûngte zawng zawng zînga mite zah ber a ni a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Hamora leh a fapa Sekema chuan an khaw kulh kawngkhâr chu an thleng a, an khuate chu an bia a,
  </para>
  <para style="p">
    <verse number="21" style="v" />“Saw mite saw min rem takin an awm a; chuvângin, he ramah hian awmin, hêngah hian sumdâwng rawh se; ngai teh u, an tân pawh ram hi a zau tâwk si a; an fanute saw nupuiahte nei ila, kan fanute pawh i neihtîr bawk ang u.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nimahsela, chi khat kan lo nihna tûra kan hnêna awm chu hetianga kan tiam chauh hian, saw mite sâwn min remtihpui dâwn a ni: serhtan an nih angin kan zînga mipa tawh phawt chu serhtan lo ni ve ila.
  </para>
  <para style="p">
    <verse number="23" style="v" />An ran te, an sum te, an sa zawng zawng te kan ta a ni vek dâwn lâwm ni? An thu hi i remtihpui mai ang u; tichuan, kan hnênah an awm dâwn nia,” an ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Hamora leh a fapa Sekema thu chu a khaw kulh kawngkhâra chhuak zawng zawngte chuan an zâwm a; a khaw kulh kawngkhâra chhuak zawng zawng, mipa tawh phawt chuan serh an tantîr ta vek a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, heti hi a ni a, a ni thum nîah, an nat lai tak chuan Jakoba fapate zînga mi pahnih, Dinaii nuṭa Simeona leh Levia chuan, an khandaih keng ve vein, a rûkin khua chu an bei a, mipa zawng zawng chu an that zo phiar a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tichuan, Hamora leh a fapa Sekema chu khandaih hriamin an that a, Sekema in ata Dinaii chu an hruai a, an chhuak ta a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jakoba fapateho chuan an mi thahte chu an va nangchîng a, an farnu chu an tihbawrhbân avângin khua chu an rawk ta a.
  </para>
  <para style="p">
    <verse number="28" style="v" />An berâm rualte, an bâwng rualte, an sabengtungte, an khuaa thil awmte, an lova thil awmte chu an lâksak a;
  </para>
  <para style="p">
    <verse number="29" style="v" />an sum zawng zawng leh an fanau tê tête leh an nupuite zawng zawng, in chhûnga awm apiang chu an man a, an rawk bawk a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Jakoban Simeona leh Levia hnênah chuan, “Nangnin he rama awmte zînga Kanaan-ho leh Periz-hote zîngah hian, huat mi phurhtîrin mi timangang hle a ni; kei tlêm tê ka nih avâng hian mi bei tûrin an inpun khâwm ang a, mi that mai ang; tichuan, tihboralin ka awm ang, kei leh ka chhûngte nên hian,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, anni chuan, “Kan farnu hi nawhchizuar tih angin a ti tûr em ni ang?” an ti a.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Pathianin Jakoba hnênah chuan, “Tho la, Bethel-ah chho la, chutah chuan awm rawh; tin, i u Esauva hnên ata i tlân bo laia i hnêna inlâr Pathian tân khân chutah chuan maichâm siam rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, Jakoban a chhûngte leh a hnêna awm zawng zawngte hnênah chuan, “In zînga mi dang pathian awmte chu dah bo daih ula, intithianghlimin in silhfênte thlâk rawh u;
  </para>
  <para style="p">
    <verse number="3" style="v" />tho ila, Bethel-ah i chho vang u; tichuan, ka mangan laia mi chhânga, ka kalnaa ka hnêna awm zêl Pathian tân khân maichâm ka siam dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, mi dang pathian, an kuta awm zawng zawng leh an benga bengbeh an beh zawng zawng chu Jakoba an pe a; tin, Jakoba chuan Sekem khaw kianga sasaw hnuaiah chuan a thukru ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, an kal a; an vêl khuate chuan an lo hlau nasa ta êm a, Jakoba fapate chu an ûm ta lo va.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichuan, Jakoba chuan Kanaan rama Luz khua chu a thleng a, amah leh a hnêna awm zawng zawngte nên (Luz chu Bethel a ni a).
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, chutah chuan maichâm a siam a, a u hnên ata a tlân bo lai khân chutah chuan Pathian a hnêna a inlâr avângin, a hmun chu El-Bethel a ti ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Rebeki awmtu Debori chu a thi a, Bethel hnuaia sasaw hnuaiah chuan an phûm a; sasaw hming chu Allon-bakuth an ti ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Jakoba chu Paddan-aram ram aṭanga a hâwnin Pathian a hnênah a inlâr leh a, mal a sâwm a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian chuan a hnênah, “I hming hi Jakoba a ni a; i hming chu Jakoba an ti tawh lo vang, i hming chu Israela a ni zâwk ang,” a ti a; tichuan, a hmingah chuan Israela a ti ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Pathian vêkin a hnênah, “Kei Pathian Engkimtitheia ka ni; chi tam tak thlahin lo pung rawh; chi tihtham zet leh chi hrang hrang tam tak pawh i lakah an lo la awm ang a, i ṭhâlbê aṭangin lalte pawh an lo la chhuak bawk ang;
  </para>
  <para style="p">
    <verse number="12" style="v" />tin, Abrahama leh Isaaka ram ka pêk hi ka pe ang che, i awm loh hnua i thlahte pawh ram hi ka pe zêl ang,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Pathianin amah a biakna hmun aṭang chuan Jakoba chu a chhohsan ta a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, a biakna hmunah chuan Jakoban englo a phun a (lung a ni a phun ni); a chungah chuan thilhlan, in mi a leih a, a chungah sahriak a leih bawk a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Jakoba chuan Pathianin amah a biakna hmun hmingah chuan Bethel a vuah a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Bethel aṭang chuan an kal a; tin, Ephrath khaw thlenna tûr chu hla fe a la ni a; tin, Rakili chuan nau a vei a, na takin a vei ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, heti hi a ni a, na taka a vei laiin nau chhar mi chuan, “Hlau suh; fapa dang i nei dâwn a nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, heti hi a ni a, a thlarau a chhuah dâwn laiin (a thi ta si a) a hmingah chuan Ben-onia a sa a; a pa erawh chuan Benjamina a sa a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tichuan, Rakili chu a thi a, Ephrath kawngah chuan an phûm a (Ephrath khua chu Bethlehem khua a ni).
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, a thlân chungah chuan Jakoban lung a phun a; chu chu tûn thlengin Rakili thlân Lungphun a la ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Israela chu a kal zêl a, Migdal Eder piahah chuan a puan in a zâr ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, heti hi a ni a, Israela chu chumi ramah chuan a awm laiin, Reubena chuan a pa hmei Bilhaii chu a va mutpui a; tin, Israela chuan chu chu a hre ta a. Tin, Jakoba fapate chu sâwm leh pahnih an ni a:
  </para>
  <para style="p">
    <verse number="23" style="v" />Leaii fapate chu Reubena (Jakoba fa tîr) te, Simeona te, Levia te, Juda te, Isakara te, Zebuluna te an ni a;
  </para>
  <para style="p">
    <verse number="24" style="v" />Rakili fapate chu Josefa leh Benjamina an ni a;
  </para>
  <para style="p">
    <verse number="25" style="v" />tin, Rakili bâwihnu Bilhaii fapate chu Dana leh Naphtalia an ni a;
  </para>
  <para style="p">
    <verse number="26" style="v" />tin, Leaii bâwihnu Zilpaii fapate chu Gada leh Asera an ni a. Chûng chu Jakoba fapa, Paddan-aram rama a neihte kha an ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, Jakoba chuan Kiriath-arba khuaa Abrahama leh Isaaka awmna Mamre-a a pa Isaaka hnên chu a thleng ta a (Kiriath-arba khua chu Hebron a ni).
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Isaaka dam chhûng chu kum za leh kum sawmriat a ni a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Isaaka chuan a thlarau a thlah a, upa tak, tarkûna damin a thi a, a chipuite hnênah hruaiin a awm ve ta a; tin, a fapa Esauva leh Jakoba chuan an phûm ta a.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, hêng hi Esauva thlahte chu an ni (Esauva chu Edoma a ni).
  </para>
  <para style="p">
    <verse number="2" style="v" />Esauva chuan a nupuite chu Kanaan rama nula zînga mi a ni a neih ni: Hit mi Elona fanu Adai leh, Hiv mi Zibeona tunu, Ana fanu Oholibami-te chu an ni;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ismaela fanu, Nebaiotha farnu Basemathi nên chuan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Adai chuan Esauva chu Eliphaza a hrinsak a; Basemathi chuan Reuela a hring a;
  </para>
  <para style="p">
    <verse number="5" style="v" />Oholibami chuan Jeusa leh Jalama leh Kora a hring a; chûng chu Esauva fapa, Kanaan rama a neihte an ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Esauva chuan a nupuite leh, a fapate leh, a fanute leh a ina mi zawng zawng leh a rante leh a sa zawng zawng leh, a sum zawng zawng, Kanaan rama a hmuhte chu a chhawm a, a nau Jakoba hnên ata chu ram dangah a kal ta daih a.
  </para>
  <para style="p">
    <verse number="7" style="v" />An thil neihte chu a nasa lutuk a, an awm dûn thei lo a ni; an rante avângin an mikhualna ram chuan a daih ta si lo va.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tichuan, Esauva chu Seir tlângah chuan a awm ta a; Esauva chu Edoma a ni a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, hêng hi Seir tlânga Edom-ho thlahtu Esauva thlahte chu an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hêng hi Esauva fapateho hming chu a ni: Eliphaza, Esauva nupui Adai fapa leh Reuela, Esauva nupui Basemathi fa hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Eliphaza fapate chu Temana te, Omara te, Zephova te, Gatama te, Kenaza te an ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Timni chu Esauva fapa Eliphaza hmei a ni a; ani chuan Eliphaza chu Amaleka a hrinsak a. Chûng chu Esauva nupui Adai fapate chu an ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, hêng hi Reuela fapate chu an ni: Nahatha leh Zera te, Sama leh Miza te hi. Chûng chu Esauva nupui Basemathi fapate chu an ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, hêng hi Zibeona tunu, Ana fanu Esauva nupui Oholibami fapate chu an ni: ani chuan Esauva chu Jeusa leh Jalama leh Kora chu a hrinsak a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hêng hi Esauva fapate zînga a hotute chu an ni: Esauva fa tîr Eliphaza fapate chu: hotu Temana te, hotu Omara te, hotu Zephova te, hotu Kenaza te,
  </para>
  <para style="p">
    <verse number="16" style="v" />hotu Kora te, hotu Gatama te, hotu Amaleka te hi; chûng chu Edom rama Eliphaza laka chhuak hotute chu an ni; chûng chu Adai fapate chu an ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, hêng hi Esauva fapa Reuela thlahte chu an ni: hotu Nahatha te, hotu Zera te, hotu Sama te, hotu Miza te hi; chûng chu Edom rama Reuela laka chhuak hotute chu an ni; chûng chu Esauva nupui Basemathi fapate chu an ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, hêng hi Esauva nupui Oholibami fapate chu an ni: hotu Jeusa te, hotu Jalama te, hotu Kora te hi; chûng hotute chu Ana fanu, Esauva nupui Oholibami hrinte chu an ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chûng chu Esauva fapate chu an ni, chûng chu an zînga hotute chu an ni; Esauva chu Edoma a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hêng hi Hor mi Seira fapa, chu rama awmte chu an ni: Lotana te, Sobala te, Zibeona te, Ana te,
  </para>
  <para style="p">
    <verse number="21" style="v" />Disona te, Ezera te, Disana te hi; chûng chu Edom rama Seira fa Hor-ho laka chhuak hotute chu an ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Lotana fate chu Horia leh Hemama an ni; Lotana farnu chu Timni a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, hêng hi Sobala fate chu an ni: Alvana te, Manatha te, Ebala te, Sephova te, Onama te hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, hêng hi Zibeona fate chu an ni: Aia leh Ana hi; he Ana hi a ni, a pa Zibeona sabengtungte a thlah laia thlalêra tui lum khurte hmu chhuaktu kha ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, hêng hi Ana fate chu an ni: Disona leh Ana fanu Oholibami hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, hêng hi Disona fate chu an ni: Hemdana te, Esbana te, Ithrana te, Kerana te hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hêng hi Ezera fate chu an ni: Bilhana te, Zaavana te, Akana te hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hêng hi Disana fate chu an ni: Uza leh Arana hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hêng hi Hor-ho laka chhuak hotute chu an ni: hotu Lotana te, hotu Sobala te, hotu Zibeona te, hotu Ana te,
  </para>
  <para style="p">
    <verse number="30" style="v" />hotu Disona te, hotu Ezera te, hotu Disana te hi; chûng chu Seir rama an hotu dang anga Hor-ho laka chhuak hotute chu an ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hêng hi lal rêng rêngin Israela thlahte chunga ro an rêl hmaa, Edom rama rorêltu lalte chu an ni:
  </para>
  <para style="p">
    <verse number="32" style="v" />Beora fapa Bela chuan Edom ramah ro a rêl a; a khawpui hming chu Dinhaba a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Bela chu a thi a, Bozra khuaa mi Zera fapa Jobaba chuan a aiawhin ro a rêl ta a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, Jobaba chu a thi a, Teman-ho rama mi Husama chuan a aiawhin ro a rêl ta a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, Husama chu a thi a, Bedada fapa Hadada, Moab phûla Midian-ho thattu khân a aiawhin ro a rêl ta a; a khawpui hming chu Avith a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tin, Hadada chu a thi a, Masreka mi Samla chuan a aiawhin ro a rêl ta a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, Samla chu a thi a, Luipui kama Rehoboth khuaa mi Saula chuan a aiawhin ro a rêl ta a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tin, Saula chu a thi a, Akbora fapa Baal-hanana chuan a aiawhin ro a rêl ta a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, Akbora fapa Baal-hanana chu a thi a, Hadara chuan a aiawhin ro a rêl ta a; a khawpui hming chu Pau a ni; a nupui hming chu Mehetabeli a ni a, ani chu Mezahaba fa Matredi fanu chu a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tin, hêng hi an chhûngkua ang zêl leh, an hmun ang zêl leh, an hming ang zêlin Esauva thlah hotute hming chu a ni: hotu Timna te, hotu Alva te, hotu Jethetha te,
  </para>
  <para style="p">
    <verse number="41" style="v" />hotu Oholibama te, hotu Ela te, hotu Pinona te,
  </para>
  <para style="p">
    <verse number="42" style="v" />hotu Kenaza te, hotu Temana te, hotu Mibzara te,
  </para>
  <para style="p">
    <verse number="43" style="v" />hotu Magdiela leh hotu Irama-te hi; chûng chu an ram neihah chuan an awmna ang zêlin Edoma thlah hotute chu an ni; chu Esauva chu Edom-ho thlahtu chu a ni.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Jakoba chu a pa mikhualna ram, Kanaan ramah chuan a awm ta a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hêng hi Jakoba thlahte chanchin a ni. Josefa chu kum sawm leh kum sarih mi a nihin, a ute nên ran rual an thlah a; ani chu naupang a la ni a, a pa nupuite Bilhaii leh Zilpaii fapate hnênah a awm a; tin, Josefa chuan an sual thuthang chu an pa hnênah a thlen a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Israela chuan Josefa chu a tar lam fa a nih avângin a fate zawng zawng ai chuan a hmangaih zâwk a; tichuan, kawrfual ze hrang hranga zia a siamsak a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, an pa chuan ani chu a ute zawng zawng aiin a hmangaih zâwk tih a ute chuan an lo hre ta a; tichuan, ani chu an haw ta hle a, ṭawngkam ṭha rêng rêng a chungah an rawlh thei ta lo va.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Josefa chuan mumang a nei a, a ute hnênah chuan a hrilh a; tichuan, ani chu an haw lehzual ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, ani chuan an hnênah, “Khawngaih takin ka mumang hi lo ngaithla teh u:
  </para>
  <para style="p">
    <verse number="7" style="v" />ngai teh u, lovah hian buhphalte kan lo têl a; tin, ngai teh u, ka buhphal chu a lo tho va, a ding ta luah a; tin, ngai teh u, in buhphalte chuan an rawn hual vêl a, ka buhphal chu chibai an bûk hlawm a,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, a ute chuan a hnênah, “Nang tehchai hian kan chungah ro i rêl tehlul ang maw? Nang tehchai hian kan chungah thu i nei tehlul ang maw?” an ti a. Tichuan, a mumang avâng leh a thusawi avâng chuan amah chu an haw lehzual sauh va.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, mumang dang a nei leh a, a ute chu a hrilh leh a, “Ngai teh u, mumang ka nei leh ta a; ngai teh u, nî te, thla te, arsi sâwm leh pakhatte khian chibai mi lo bûk zuk nia maw le,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, a pa chu a hrilh a, a uteho pawh; tichuan, a pa chuan a zilh a, a hnênah, “Mumang i neih hi eng mumang nge maw ni? Kei leh i nu leh i ute hian lei siin chibai kan rawn bûk tehlul dâwn che maw?” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, a uten ani chu an îtsîk a; a pa erawh chuan a thusawi chu a rilruin a vawng reng a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, a ute chu Sekem-ah chuan an pa ran rual chu thlahin an kal a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Israela chuan Josefa hnênah, “I uten Sekem-ah alâwm maw ran rual chu an thlah? Lo kal teh, an hnênah ka tîr ang che,” a ti a. Tin, ani chuan a hnênah, “Mi tîr ta che,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, ani chuan a hnênah. “Va kal ta la, i ute chu an dam emaw, ran rualte pawh an dam emaw va chian ta la, chanchin mi rawn hrilh leh ang che,” a ti a. Chutichuan, Hebron ruam ata chu a tîr chhuak a; tin, ani chuan Sekem chu a va thleng a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, mi tuin emaw amah chu a hmu a, ngai teh, phûlah chuan a vâk a vâk a; tichuan, mi chuan, “Eng nge i zawn le?” tiin a zâwt a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, ani chuan, “Ka ute ka zawng a ni; khawngaih takin ran rual an thlahna chu mi hrilh teh khai,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, mi chuan, “Heta ṭangin an chhuah tâk kha, ‘Dothan-ah i kal ang u,’ an tih chu ka hria,” a ti a, Tin, Josefa chuan a ute chu a ûm a. Dothan-ah chuan a va hmu a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, anni chuan hla tak aṭangin an lo hmu a; tichuan, an kiang hnai a thlen hmain amah thah thu an phiar ta a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, “En teh u, mang neia chu a lo kal saw. Hawh u, that ila, khuarkhurum pakhatah i thlâk ang u khai; tin, ‘Sakawlhin a seh ta,’ kan ti dâwn nia; tichuan, a mangte chu engtin nge a awm kan la hre mai ang,” an ti hlawm a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Reubena chuan chu chu a lo hria a, an kut ata a chhan chhuak a; “A thah êm chu i that suh ang u,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Reubena vêk chuan a pa hnêna a hruai lehna tûrin, an kut ata chu a chhan chhuah theih nân an hnênah chuan, “Thisen chu chhuah suh u; thlalêra khuarkhurumah hian thlâk ula, kut zawng a chungah thlâk suh u,” a ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, heti hi a ni a, Josefa chuan a ute hnên a va thlen chuan, Josefa chu a kawrfual, a kawrfual ze hrang hranga zia a hâk chu an lo hlihsak a;
  </para>
  <para style="p">
    <verse number="24" style="v" />tin, an hruai a, khuarkhurumah chuan an thlâk ta a; khuarkhurum chu a ruak, tui awm tawh lo a ni a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, chaw ei tûrin an han ṭhu hlawm a; tin, an han dâk a, an en a; tin, ngai teh, Ismael khualzinho, Gilead ram aṭanga an sanghâwngseia englo rimtui leh thinghnai damdawi leh murra phura, Aigupta rama zuk kal tûrte an lo kal a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Juda chuan a unaute hnênah, “Kan nau kan thaha, a thisen chhuak kan zêp chuan eng nge hnemhnânna awm ang?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hawh u, a chunga kut thlâk lovin, Ismael-ho hnênah sâwn i hralh zâwk ang u; amah hi kan nau, kan tisa ngei a ni si a,” a ti a. Tin, a unaute chuan a thu chu an zâwm ta a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Midian-ho sumdâwngte an lo kal a; tichuan, Josefa chu khuarkhurum ata chu an kai chhuak a, Ismael-hote hnênah chuan, Josefa chu tangka sawmhnihin an hralh ta a, Tin, Josefa chu Aigupta ramah an hruai ta a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Reubena chu khuarkhurumah a lo kal leh a; tin, ngai teh, Josefa chu khuarkhurumah chuan a lo awm ta lo va; tichuan, a silhfênte a pawt thlêr ta a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, a naute hnênah a kal leh a, “Taitea kha a awm ta lo, kei hi khawiah nge ka kal tâk ang le aw?” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Josefa kawrfual chu an la a, kêlpa an talh a, a thi-ah chuan kawrfual chu an hnim a;
  </para>
  <para style="p">
    <verse number="32" style="v" />tin, kawrfual ze hrang hranga zia chu an thawn a, an pa hnênah chuan an rawn la a; tin, “Hei hi kan hmu ngawt a, i fapaa kawrfual a ni nge ni lo en teh,” an ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, ani chuan a lo hre mai a, “Ka fapaa kawrfual a nih hi! Sakawlhin a seh ta zuk nia le; Josefa chu mathei lovin pawh sawm vekin a awm a ni ngei ang,” a ti a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tichuan, Jakoba chuan a silhfênte a pawt thlêr a, saiip puan a fêng a, ni rei tak a fapa chu a sûn a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, a fapate zawng zawng leh a fanute zawng zawng chu amah thlamuan tûrin an tho va; nimahsela, ani chuan thlamuan a duh lo va; “Lusûn chungin thlânah ka fapa hnênah chuan ka liam dâwn e,” a ti a. Tichuan, a pa chu amah ngaiin a ṭap ṭhîn a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tin, Midian-ho chuan Josefa chu Aigupta ramah an luhpui a, Pharaoa hnuaia hotu pakhat, vêngtu pâwl hotu, Potiphara hnênah chuan an hralh a.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chumi lai chuan heti hi a ni a, Juda chu a unaute hnên ata a chhuk a, Adulam mi pakhat a hming Hira chu a zuk bêl ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Juda chuan chutah chuan Kanaan mi pakhat a hming Sua fanu a hmu a; tin, ani chu a nei a, a pâwl ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, a rai a, fapa a hring a; tin, Judan a hmingah chuan Era a sa a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, a rai leh a, fapa a hring leh a; tin, a nuin a hmingah chuan Onana a sa a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, fapa a hring leh pek a, a hmingah chuan Sela a sa a; chu mi chu a hrin lai chuan Juda chu Kezib khuaah a awm a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Juda chuan a fa tîr Era chu nupui a neihsak a, a hming chu Tamari a ni a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Juda fa tîr Era chu Lalpa mit hmuhin mi sual a ni a; tichuan, Lalpan ani chu a tihlum ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Juda chuan Onana hnênah, “I u nupui chu pâwl la, pasalte unau tih tûr chu tihsak la, i u tân chuan chi thlahsak rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Onana chuan chi thlah tûr chu ama thlah a ni dâwn lo tih a hria a; tichuan, heti hi a ni a, a u nupui a pâwl apiangin, a u tân chi a thlahsak lohna tûrin leiah chuan a titla ṭhîn a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, a thiltih dân chu Lalpa mit hmuhah chuan sual tak a ni a; tichuan, ani pawh chu a tihlum ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Juda chuan a monu Tamari hnênah chuan, “Ka fapa Sela hi a puitlin hma loh chuan i pa in lamah pasal nei lovin lo awm rih ang che,” a ti a. “Chuti lo chuan, ani pawh hi a ute angin a thi dah ang e,” a ti a ni. Tichuan, Tamari chu a pa in lamah chuan a va awm ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, a nakinah chuan Sua fanu Juda nupui chu a thi a; tin, Juda chuan a ngaih a lo reh a, Timna khuaah a berâm hmul mêttute hnên lamah chuan, amah leh a ṭhian Adulam mi Hira chu an chho ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, miin Tamari chu, “I pu chu a berâm hmul mêt tûrin Timna khuaah a chho dâwn,” tiin an hrilh a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tichuan, ani chuan a pasal sûnna silhfênte chu a hlîp a, inkhuhna puanin a inkhuh a, a intuam tlat a, Timna khaw kawnga Enaim kulh kawngkaah chuan a lo ṭhu a; Sela chu a puitling tawh si a, a pa chuan a nupuiah a neihsak lo zo a ni tih a hria a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Juda chuan ani chu a hmuh chuan nawhchizuarah a ruat a; a hmai a inkhuh tlat si a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tichuan, kawng sira hmeichhe lam chu a va pan a, “Hawh, khawngaih takin i mu dûn ang,” a ti a; a mo kha a ni tih a hre si lo va. Tin, ani chuan, “Mi mutpui chuan eng nge mi pêk ang?” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, ani chuan, “Ran rual zinga mi kêlno ka thawn ang che,” a ti a. Tin, ani chuan, “Chu chu i rawn thawn hmaa lo hrên tûr eng emaw tal mi pe ang em?” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, ani chuan, “Hrên tûr eng nge ka pêk ang che?” a ti a. Tin, ani chuan, “I hming nemna leh i hrui, i tiang ken nên khân,” a ti a. Tichuan, a pe a, a mutpui ta a; tin, a lakah chuan fa a pai ta a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, a tho va, a inkhuhna puan chu a hlîp a, a hmeithaina silhfênte chu a inbel leh ta a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Juda chuan a thil hrên chu chu hmeichhe kut ata la tûrin a ṭhianpa, Adulam mi kutah chuan kêlno chu a thawn a; nimahsela, ani chuan amah chu a va hmu zo si lo va.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichuan, hmeichhe awmna hmuna mite hnênah chuan, “Kawng sîra Enaim-a nawhchizuar awm kha khawiah nge a awm tâk?” tiin a zâwt a. Tin, anni chuan, “Nawhchizuar rêng hetah an awm lo ve,” an ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Juda hnênah chuan a kîr leh a, “Amah chu ka hmu zo lo, a hmuna mite pawhin, ‘Nawhchizuar rêng rêng hetah an awm lo,’ an ti bawk a,” a ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Juda chuan, “Nei hlen mai rawh se; chuti lo chuan, kan mualpho dah ang e; ngai teh, he kêlno hi ka thawn a, amah i hmu zo si lo va,” a ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, thla thum emaw lai chinah chuan miin Juda chu, “I monu Tamari chuan tlangvâl a ngai a; chu lo pawh chu, ngai teh, sâwn a pai nghe nghe asin,” tiin an hrilh a. Tin, Juda chuan, “Hruai chhuak ula, hâl hlumin awm rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, an hruai chhuah chuan Tamari chuan, “Hêng thil neitupa lakah hian a ni, nau ka pai ni,” tiin a pu hnênah chuan mi a tîr ta a; amah vêkin, “Khawngaih takin hêng hming nemna te, hrui te, tiang te hi tu ta nge ni, en chiang teh khai,” a ti bawk a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Juda chuan chûng thil chu a ta a ni tih a lo hria a, “Ani chu ka aiin a fel zâwk a ni; ka fapa Sela ka neihtîr ta si lo va,” a ti a. Tin, Juda chuan ani chu a pâwl leh ta hauh lo va.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, nau a vei lai chuan heti hi a ni a, ngai teh, a chhûlah chuan phîr an lo awm a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, heti hi a ni a, nau a vei chuan pakhat chuan a kut a rawn zen chhuak a; tichuan, nau chhar mi chuan, “Hei hi a chhuak hmasa zâwk a nih hi,” tiin a chelh a, a kutah chuan la sen a buntîr a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, heti hi a ni a, a kut chu a lâk luh leh lai chuan, ngai teh, a unau chu a lo chhuak ta a; tichuan, nau chhar mi chuan, “Engati nge chhuahna i insiam ni?” a ti a; chuvângin, a hmingah chuan Pereza an sa a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, chumi hnuah chuan a unau, a kuta la sen bun kha a lo chhuak leh a; a hmingah chuan Zera an sa a.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Josefa chu Aigupta ramah an hruai chhuk a; tin, Pharaoa hnuaia hotu pakhat, vêngtu pâwl hotu, Aigupta mi, Potiphara chuan chuta rawn hruai chhuktu Ismael-hote kut ata chu a lei ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Lalpa chu Josefa hnênah a awm a; tichuan, ani chu mi vânnei tak a ni a; tin, a pu Aigupta mi inah chuan a awm a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, a pu chuan Lalpa chu a hnênah a awm a, a thiltih apiang Lalpan a kutah a hlawhtlintîr tih a lo hre ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, Josefa chuan a pu mit a tlung a, a rawng a bâwl ṭhîn a; tin, ani chuan a chhûngte chungah chuan hotuah a siam a, a neih zawng zawng a kutah a dah ta vek a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, heti hi a ni a, inah chuan hotuah a siam a, a neih zawng zawng chunga hotua a siam achinah chuan, Josefa avângin Lalpa chuan Aigupta mi chhûngte chu mal a sâwm ta a; in lam leh ram lama a neih zawng zawng chu Lalpan mal a sâwm ṭhîn a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, a neih zawng zawng chu Josefa kutah a dah tlat a, a hnêna thil awm rêng rêng chu a hriatpui hauh lo va, ama chaw ei chauh lo chu a hre lo. Tin, Josefa chu mi tlâwntlai ṭha tak a ni a, a hmêl pawh a ṭha hle a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, chûng hnuah chuan heti hi a ni a, a pu nupui chuan Josefa chu a ngaihmelh a; tin, “Mi mutpui rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ani erawh chuan a duh lo va, a pu nupui hnênah chuan, “Ngai teh, ka pu chuan he inah hian ka hnênah eng eng nge awm a hre si lo va, a neih zawng zawng ka kutah hian a dah vek a;
  </para>
  <para style="p">
    <verse number="9" style="v" />he inah hian ka aia lian zâwk tu mah an awm lo va; a nupui i nih avângin nangmah chauh lo chu ka lakah eng mah ui a nei hek lo; chutichuan, engtin nge he sual lian tak hi tiin Pathian chunga thil ka tihsual theih ang?” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, heti hi a ni a, ni tin maiin Josefa chu be ṭhîn mah sela, amah mutpui lam thu emaw, ama hnêna awm lam thu emaw a pawm duh lo va.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, chumi lai vêl chuan heti hi a ni a, a hna chu thawk tûrin in chhûngah a va lût a; tin, chutah chuan an in awm rêng rêng tu mah an awm lo va.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tichuan, ani chuan, “Mi mutpui rawh,” tiin a silhfênah a lo man a; tin, ani chuan a silhfên chu a kutah chuan a tlânsan a, a chhuak ta daih a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, heti hi a ni a, a silhfên chu a kuta hnutchhiahin a tlân chhuak ta tih a hriat veleh,
  </para>
  <para style="p">
    <verse number="14" style="v" />a in awmte chu a ko va, an hnênah, “En teh u, mi timualpho tûrin Hebrai mi pakhat kan hnêna a hruai luh tâk hi! Mi mutpui tumin ka hnênah hian a lo lût a; tichuan, aw ring takin ka au ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, heti hi a ni a, aw chhuahin ring takin ka au tih a hriat veleh, ka kiangah a silhfên hi a tlânsan a, a chhuak ta daih a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Josefa pu a lo hâwn hma loh chuan a silhfên chu a kiangah a lo dah reng a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, a hnênah hetiang thu hi a lo sawi a, “Hebrai chhiahhlawh kan hnêna i rawn hruai kha, mi tihmualpho tumin ka hnênah a lo lût a;
  </para>
  <para style="p">
    <verse number="18" style="v" />tin, heti hi a ni a, aw chhuaha ka au veleh ka kiangah a silhfên hi hnutchhiahin a tlân chhuak ta a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, heti hi a ni a, Josefa pu chuan a nupuiin a hnêna, “I chhiahhlawh hian heti hian mi ti,” tia a thusawi a han hriat chuan a thin a lo ur ta thut a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Josefa pu chuan ani chu a hruai a, tân in, lal mi tâng phuara an awmnaah chuan a khung ta a; tichuan, chuta tân inah chuan a awm ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nimahsela, Lalpa chu Josefa hnênah a awm zêl a, a chungah ngil a nei a, tân in vêngtu pawh a khawngaihtîr a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tichuan, tân in vêngtu chuan tân ina tângho awm zawng zawng chu Josefa kutah a kawltîr ta vek a; tichuan, chuta an tih apiang chu Josefa chu a titu a ni zêl ṭhîn a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa chu Josefa hnênah a awm a, a thiltih apiang chu Lalpa chuan a hlawhtlintîr ṭhin avângin, tân in vêngtu chuan a kuta thil awm rêng rêng chu a en duh ta lo va.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, chûng thil hnuah chuan heti hi a ni a, Aigupta lal uain petu leh a chhang siamtute chuan an pu Aigupta lal chu an tivui a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, Pharaoa chu a chhiahhlawh hotu pahnih chungah, a uain pe hotu ber chungah leh a chhang siam hotu ber chungah chuan a thinur ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, vêngtu pâwl hotu inah, tân in, Josefa phuara a awmnaah chuan a tântîr ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, vêngtu pâwl hotu chuan Josefa chu anmahni a enkawltîr a; tichuan, ani chuan an rawng a bâwl ta a; tin, ni eng zât emaw lai an tâng rih a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, tân ina phuara awm, Aigupta lal uain petu leh chhang siamtu chuan, an pahnihin zan khatah mumang awmze hrang ve ve an nei a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, a tûk zîngah chuan Josefa chu an hnênah a va lût a, anni chu a va hmu a; tin, ngai teh, an lo lungngai hle a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, ani chuan, “Engtizia nge vawiin chu lungngai hmêl in va pu ve?” tiin Pharaoa chhiahhlawh hotu, a pu ina tâng vete chu a zâwt a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, anni chuan a hnênah “Mumang kan nei a, min hrilhfiah thei tu mah an awm si lo a ni,” an ti a. Tin, Josefa chuan an hnênah “Mumang hrilhfiahnate chu Pathian ta a ni lo vem ni? Khawngaih takin mi han hrilh teh u,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, uain pe hotu ber chuan a mumang chu Josefa a hrilh a, a hnênah, “Ka mumangah chuan ngai teh, ka hmaah hian grêp hrui a lo awm a;
  </para>
  <para style="p">
    <verse number="10" style="v" />grêp hruiah chuan pêng pathum a awm bawk a; tin, chawr chhuak angin a lo awm a, a pârte a lo chhuak a; a pâr bâwrte chuan grêp hminte a rawn chhuah ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Pharaoa no chu ka kutah hian a lo awm a; tichuan, grêp rahte chu ka lo va, Pharaoa novah chuan ka sâwr a, no chu Pharaoa kutah ka lo pe a,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Josefa chuan a hnênah, “Hei hi a hrilhfiahna a ni: pêng pathum chu ni thum a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tûn achin ni thumah Pharaoan i lû a chawi kâng ang a, i hnathawh chu a thawhtîr leh ang che; tichuan, a uain petu i nih laia i pêk dân pângngai ang khân Pharaoa no chu a kutah i pe leh dâwn a nih chu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaherawhchu, i chan ṭhat leh hunah chuan mi han hre reng la, khawngaih takin ka chungah khawngaihna rawn lantîr ang che; Pharaoa hnênah ka chanchin han sawi la, he in ata hi mi hruai chhuak ang che.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hebrai-ho ram ata miin a rûka an rûk bo ka ni a; he ramah pawh hian rip chhûnga mi khungna khawp eng mah ka tisual hek lo,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chhang siamtu chuan hrilhfiahna chu a ṭha tih a hriatin Josefa hnênah chuan, “Kei pawh mumang ka nei a; ngai teh, chhang vâr, fawng pathumin ka lo chhîpchhuan a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, fawng chungnung berah chuan Pharaoa chaw, chhang siamtu siam, chi tinrêng hi a lo awm a; tin, chûng chu savaten ka fawng chhîpchhuan ata chu an lo ei noh noh va,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Josefa chuan a chhâng a, “Hei hi a hrilhfiahna a ni: fawng pathum chu ni thum a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tûn achin ni thumah chuan Pharaoan i taksa ata i lû a chawi kâng ang a, thing lêrah a khai ang che; tichuan, savaten i sa chu an ei noh noh dâwn a nih chu,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, heti hi a ni a, a ni thum ni, Pharaoa pian champhaphâk nîah chuan, ani chuan a chhiahhlawh zawng zawngte tân ruai a ṭheh a; tin, a chhiahhlawhte zinga mi uain pe hotu ber lû leh chhang siam hotu ber lû chu a chawi kâng ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Josefan anmahni a hrilhfiah ang takin, uain pe hotu ber chu uain petuah a ṭantîr leh a; tichuan, no chu Pharaoa kutah chuan a pe leh ta a;
  </para>
  <para style="p">
    <verse number="22" style="v" />chhang siam hotu ber erawh chu a khai hlum ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nimahsela, uain pe hotu ber chuan Josefa chu a hre reng ta awzâwng lo va; a theihnghilh ta mai a.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, kum hnih zet hnuah chuan heti hi a ni a, Pharaoa chuan mumang a nei a; tin, ngai teh, lui kamah hian a lo ding a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, ngai teh, bâwngpui pasarih nalh tak tak, thau tak tak hi tui aṭang chuan an lo chhuak chho va, phairuang zîngah hian an lo tla a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, ngai teh, bâwngpui dang pasarih pawr tak tak, chêr tak tak hi tui aṭang vêk chuan an hnuah an lo chhuak chho leh a, bâwngpui dangte kiangah lui kamah chuan an lo ding hlawm a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, bâwngpui pawr tak tak, chêr tak tak chuan bâwngpui nalh tak tak, thau tak tak chu an ei zo ta mai a. Chutichuan, Pharaoa chu a ṭhangharh ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, a han muhîl leh a, mumang a nei leh a; tin, ngai teh, buh kûng khatah hian vui sarih lian tak tak, ṭha tak tak hi an lo chhuak a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, ngai teh, chumi hnuah chuan vui sarih sîn tê tê, khawchhak thli chhêm ro rim rem hi an lo chhuak leh a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, vui sîn tê tête chuan vui sarih lian tak tak, ṭha tak takte chu an lem zo ta mai a. Tin, Pharaoa chu a han ṭhangharh a; tin, ngai teh, mumang a lo ni a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, a tûk zingah chuan heti hi a ni a, a rilru chu a lo mangang ta hle a; tichuan, mi a tîr a, Aigupta rama mitlâk dawithiam zawng zawng leh mi fing zawng zawng chu a ko va; tin, Pharaoa chuan a mumang chu a lo hrilh hlawm a; nimahsela, Pharaoa hrilhfiah thei tu mah an awm si lo va.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chumi lai chuan uain pe hotu ber chuan Pharaoa hnênah, “Vawiinah hian ka tihsual ka hre chhuak ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pharaoa a chhiahhlawhte chungah a thinur a; tichuan, vêngtu pâwl hotu inah chuan kei leh chhang siam hotu ber chu min tântîr a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, kei leh ani chuan zan khatah mumang kan nei a, mumang awmze hrang ve ve a ni kan neih ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, chutah chuan kan hnênah vêngtu pâwl hotu chhiahhlawh, Hebrai mi, tlangvâl pakhat a awm a; tin, ani chu kan hrilh a, ani chuan kan mumangte chu min hrilhfiah ta a; kan mumang ang zia zêlin a ni min hrilhfiah ve ve ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, heti hi a ni a, min hrilhfiah ang takin a lo awm ta ngei a ni; kei chu ka hnathawh hi mi thawhtîr leh a, chhang siamtu chu khai hlum a ni ta a,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutichuan, Pharaoa chuan Josefa chu a kohtîr ta nghâl a; tichuan, hmanhmawh takin rip ata chu an hruai chhuak ta a; tin, ani chu a inmêt fai a, a silhfên chu a thlâk a, Pharaoa hnênah chuan a va lût a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Pharaoa chuan Josefa hnênah, “Mumang ka nei a, a hrilhfiah thei tu mah an awm lo va; nangin mumang hi a thu i hriat chuan i hrilhfiah thei tih i chanchin hi mi sawi ka lo hria a,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Josefa chuan Pharaoa chu a chhâng a, “Chu chu keimaha awm a ni lo ve; Pathianin Pharaoa chu thlamuanthlâk takin a chhâng zawk ang,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Pharaoa chuan Josefa hnênah, “Ka mumangah chuan, ngai teh, lui kamah hian ka lo ding a;
  </para>
  <para style="p">
    <verse number="18" style="v" />tin, ngai teh, bâwngpui pasarih thau tak tak, nalh tak tak hi tui aṭang chuan an lo chhuak chho va, phairuang zîngah hian an lo tla a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, bâwngpui dang pasarih berh tak tak, pawr êm êm, chêr tak tak, chutiang rêng rênga chhia Aigupta ram zawng zawng pawha ka la hmuh ngai loh hi, an hnuah an lo chhuak chho leh a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, bâwngpui chêr tak tak, pawr tak takte chuan bâwngpui pasarih thau tak tak lo chhuak hmasate chu an ei zo ta mai a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, an ei zawh hnu pawh chuan an ei tih an hriat chuang loh; a tîr ang bawk khân an la pawr ta reng a. Chutichuan, ka ṭhangharh ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, ka mumang dang lehah chuan, ngai teh, buh kûng khatah hian vui sarih lian tak tak, ṭha tak tak hi a lo chhuak a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, ngai teh, chumi hnuah chuan vui sarih vuai sil sel, sîn tê tê, khawchhak thli chhêm ro rim remte hi an lo chhuak leh a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, vui sîn tê tête chuan vui sarih ṭha tak takte chu an lem zo ta maiin ka hmu a. Tin, mitlâk dawithiamhote chu ka hrilh a; nimahsela, mi hrilhfiah thei tu mah an awm si lo va,” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Josefa chuan Pharaoa hnênah, “Pharaoa mumang hi hmun khat a ni; Pathianin a thiltih tûr chu Pharaoa a hriattîr a nih chu.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bâwng pasarih ṭha tak takte chu kum sarih an ni a, vui sarih ṭha tak takte chu kum sarih an ni bawk a; mumang chu hmun khat a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, an hnua bâwng pasarih chêr tak tak, pawr tak tak lo chhuak chhote chu kum sarih an ni a, vui sarih a sî hlîr, khawchhak thli chhêm ro rim remte nên chuan; chûng chu ṭâm kum, kum sarih tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chu chu a ni Pharaoa hnêna ka sawi kha; Pathianin a thiltih tûr chu Pharaoa a hriattîr a nih hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai teh, Aigupta ram chhûng zawng zawngah hian hausak tawntaw kum, kum sarih a lo thleng dâwn;
  </para>
  <para style="p">
    <verse number="30" style="v" />chumi hnuah chuan ṭâm kum, kum sarih a lo awm leh ang; tichuan, hausakna zawng zawng kha Aigupta ramah hian theihnghilh vek a ni tawh ang; ṭâm chuan ram hi a ei chhe zo vang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hausakna kha, a zuitu ṭâm avâng chuan he ramah hian an hre tawh lo vang; a nasa hle dâwn si a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, mumang Pharaoa vawi hnih a neih nawntîrna chu hemi avâng hian a ni, thiltih tûr chu Pathianin a tihngheha, Pathian vêkin a thlentîr lawk dâwn avângin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chutichuan, tûnah hian Pharaoa chuan mi pakhat bengvâr tak, fing tak mai zawng chhuak sela, Aigupta ram chungah hian hotuah awmtîr rawh se.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pharaoan chu chu ti sela; tin, ram chungah hian hotute ruat sela, hausak kum, kum sarih chhûng chuan Aigupta ram buh hi hmun ngaa ṭhena hmun khat zêl khâwm rawh se.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tichuan, anni chuan chûng kum ṭhat kum lo thleng tûra buh zawng zawng chu lâwr khâwmin, Pharaoa hnuaia awm tûrin khuaahte la ei atân buh chhûng khâwm sela, vawng tlat rawh se.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tichuan, ṭâm avânga ram hi a boral loh nân buh chu ṭâm kum, kum sarih Aigupta rama lo thleng tûr atân chuan he ram atân hian inrin lâwkna tûr a ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, chu thu chu Pharaoa leh a chhiahhlawhte zawng zawng chuan ṭha an tih zâwng tak a ni a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tin, Pharaoa chuan a chhiahhlawhte hnênah, “Hetiang, Pathian thlarau awmna mi hi kan hmu zo dâwn em ni?” a ti a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tin, Pharaoa vêk chuan Josefa hnênah, “Pathianin chûng zawng zawng chu a hriattîr che avângin, nang anga bengvâr leh fing rêng rêng hi an awm lo ve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang hi ka chhûngte chungah hotuah i awm ang a, ka khua leh tui zawng zawng hi i thu ang zêlin an awm ang; lalṭhutphaha ṭhut thûah chauh hian i aiin ka lal ang,” a ti a.
  </para>
  <para style="p">
    <verse number="41" style="v" />Pharaoa vêk chuan Josefa hnênah, “Ngai teh, Aigupta ram zawng zawng chungah hian hotuah ka siam a che,” a ti a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tin, Pharaoan a kut ata a hming nemna zungbun chu a phawi a, Josefa kutah a buntîr a, puan zai sîna siam silhfênte a bel a, a nghâwngah rangkachak ṭhi a awrhtîr a.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tin, a tawlailîr neih pahnihnaah chuan a chuantîr a; a hmaah chuan, “Ṭhingṭhi ru,” tiin an au zêl a; tichuan, Aigupta ram zawng zawng chungah chuan hotuah a siam ta a.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tin, Pharaoa chuan Josefa hnênah, “Kei Pharaoa ka ni, nangma thu lo chuan Aigupta ram chhûng zawng zawngah hian tu mân an kut emaw, an ke emaw an lek lo vang,” a ti a.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tin, Pharaoan Josefa hmingah chuan Zaphenath-panea a vuah a; On khaw puithiam Potiphara fanu Asenathi nupuiah a neihtîr bawk a. Tin, Josefa chu a chhuak a, Aigupta ram chu a fang ta a.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tin, Josefa chu Aigupta ram lal Pharaoa hmaa a din lai chuan kum sawmthum mi a ni a. Tin, Josefa chu Pharaoa hnên ata a chhuak a, Aigupta ram zawng zawng chu a fang chhuak ta a.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tin, kum ṭhat kum, kum sarih chhûng chuan lei chuan hlâwk takin buh a chhuah ṭhîn a.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tin, Aigupta rama kum ṭhat kum, kum sarih lo thlenga buh zawng zawng chu a lâwr khâwm a, buh chu khuaahte chuan a chhûng khâwm ta a; khaw tinah a vêl lova buh ṭheuh chu a chhûng khâwm zêl a.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tichuan, Josefa chuan buh chu tam tak, tuifinriata ṭiauvut zât laiin a chhûng khâwm rui a; a chhiar pawh chu a bâng ta hial a, chhiar sên rual a ni ta si lo va.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tin, ṭâm lo thlen hma chuan Josefa chuan fapa pahnih a nei a, chu mite chu On khaw puithiam Potiphara fanu Asenathi chuan a hrinsak a ni.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tin, Josefan a fa tîr hmingah chuan Manasea a sa a; “Pathianin ka thawhrimna zawng zawng leh ka pa chhûngte zawng zawng chu mi theihnghilhtîr ta si a,” a ti a.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tin, a fa pahnihna hmingah chuan Ephraima a sa a, “Pathianin ka hrehawm tuarna ramah hian chi mi thlahtîr ta si a,” a ti a.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tin, kum ṭhat kum, kum sarih, Aigupta rama lo thleng chu a lo vei ta a;
  </para>
  <para style="p">
    <verse number="54" style="v" />tin, ṭâm kum, kum sarih tûr chu Josefa sawi ang takin a lo thleng ṭan ve ta a. Ram tinah ṭâm a lo tla ta a; Aigupta ram chhûng zawng zawngah erawh chuan ei tûr a awm a.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tin, Aigupta rama mi zawng zawng chu an ṭâm veleh Pharaoa hnênah ei tûr dîlin an au va; tin, Pharaoa chuan Aigupta mi zawng zawng hnênah chuan, “Josefa hnênah kal ula; a hrilh apiang che u chu ti rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="56" style="v" />Tin, ṭâm chu lei chung zawng zawngah chuan a lo tla ta a; tichuan, Josefa chuan chhûn khâwmna in zawng zawng chu a hawng a, Aigupta mite hnênah chuan a hralh a; Aigupta ramah chuan ṭâm chu a tla nasa hle si a.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tin, lei chung zawng zawngah ṭâm chu a tlâk nasat avângin, ram tina mite chu buh lei tûrin Aigupta ramah Josefa hnênah chuan an kal ṭhin a.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Jakoba chuan Aigupta ramah buh a awm tih a lo hre ta a; tichuan, Jakoba chuan a fapate hnênah, “Engati nge in inen mai mai ni?” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, amah vêk chuanin, “Ngai teh u, Aigupta ramah buh a awm tih ka lo hre ta; thi lova kan nun chhuah theihna tûrin chutah chuan zuk kal ula, chuta ta chu kan tân zuk lei rawh u khai,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, Josefa uteho sâwm chu Aigupta ram ata buh lei tûrin an zuk kal ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Josefa nau Benjamina erawh chu a ute hnênah chuan Jakoban a kaltîr ve lo va; “Tawhsual a zuk tâwk hlauh dah ang e,” a ti a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Israela fapate chu mi kalho zîngah chuan buh lei tûrin an kal ve a; Kanaan ramah pawh ṭâm a tla ve si a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Josefa chu Aigupta ram chungah chuan hotu a ni a, amah chu chumi rama mi zawng zawng hnênah a hralhtu a ni; tichuan, Josefa uteho chu an lo kal a, lei siin amah chibai an bûk hlawm a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Josefa chuan a uteho chu a lo hmu a, anni chu a lo la hre hlawm a; nimahsela, an lakah chuan chi dang angin a insiam a, ram takin a bia a; tin, an hnênah, “Khawi aṭanga lo kal nge in nih?” a ti a. Tin, anni chuan, “Buh lei tûrin Kanaan ram aṭanga lo kal kan ni,” an ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Josefa chuan a uteho chu a lo la hria a, anni erawh chuan ani chu an hre si lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Josefa chuan anmahni chungchâng thu mumanga a hmuhte kha a hre chhuak a, an hnênah, “Enthlatute in nih hi! Ram ruahzia en tûrin in lo kal a nih hi le!” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, anni chuan a hnênah, “Ka pu, ni suh e, i chhiahhlawhte hi buh lei tûra lo kal kan ni asin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi pakhat fa vek kan ni; mi dik tak kan ni a, i chhiahhlawhte hi enthlatute kan ni awzâwng lo ve,” an ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ani chuan an hnênah, “Ka âwih lo, ram ruahzia en tûra lo kal in nih hi maw,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, anni chuan, “Keini i chhiahhlawhte hi unau sâwm leh pahnih, Kanaan rama awm mi pakhat fa kan ni; tin, ngai teh, kan tlum ber chu tûnah chuan kan pa hnênah a awm a, pakhat chu a awm ta lo a ni,” an ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Josefa chuan an hnênah, “ ‘Enthlatute in ni’ ka tih che u kha, in nih ngei hi!
  </para>
  <para style="p">
    <verse number="15" style="v" />Heti hian fiahin in awm ang: in tlum ber chu heta a lo kal loh chuan, Pharaoa nunna chhâlin, heta ta hi in chhuak lo vang ka ti che u a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmahniah thutak a awm nge awm lo in thu fiah nân in zînga pakhat tîr ula, in nau chu rawn hruai rawh se, nangni erawh chu phuarin in lo awm rih ang; chuti lo chuan, Pharaoa nunna chhâlin, ‘Enthlatute in ni ngei mai!’ ka ti dâwn che u a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, an za chuan ni thum a tântîr hlawm a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, a ni thum nîah chuan Josefa chuan an hnênah, “Heti hian ti ula in nung ang, Pathian ka ṭih si a:
  </para>
  <para style="p">
    <verse number="19" style="v" />mi dik tak in nih chuan in unau zîngah hian pakhat phuarin awm rawh se; nangni erawh chu kal ta ula, in chhûngteho ṭâm tân chuan buh phur rawh u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, in tlum ber chu ka hnênah rawn hruai ang che u; chutichuan, in thu chu a fiah ang a, in thi dâwn lo nia,” a ti a. Tichuan, chutiang chuan an ti ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, anni chuan, “Kan nau chunga kan thiltih kha kan thiam lo tak tak a nih hi, khawngaih tûra min ngen ṭâwk ṭâwk laia a thinlung manganzia hmu reng chunga kan ngaihthlâksak duh loh kha; chuvângin, he manganna hian min tlâkbuak a nih hi,” an inti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Reubena chuan, “ ‘Naupang chungah thil tisual suh u,’ tiin in hnênah ka sawi lo vem ni? In ngaithla duh lo a nih kha; chuvângin, ngai teh u, a thisen phuba chu an la a nih hi,” tiin anni chu a chhâng a.
  </para>
  <para style="p">
    <verse number="23" style="v" />An kârah ṭawng letlingtu a awm avângin Josefan an thusawi chu a hria tih an hre lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, ani chuan a lehhawisan a, a va ṭap ta a; tin, an hnênah a kîr leh a, anni chu a bia a, an zing ata Simeona chu a hruai hrang a, an mit hmuhah chuan a phuar ta a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Josefa chuan an bâwmte chu buha tikhat tûr leh an tangkate chu an ipa dah leh ṭheuh tûr leh, kalkawng atân ei tûr pe tûrin thu a pe a; tichuan, chutiang chuan an tihsak ta a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, an buh chu an sabengtungte chu an phurhtîr a, chuta ta chu an chhuak ta a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, an zînga mi pakhatin, riah bûkah a sabengtung chaw pe tûra a ip a han hawn chuan a tangka chu a hmu ta mai a; ngai teh, a ip rawng bulah chuan a lo awm ta a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tichuan, a unaute hnênah chuan, “Ka tangka kha an lo dah leh a nih hi maw le; ngai teh u, ka ipa hi a lo awm reng mai,” a ti a; tin, an thin a ṭhâwng zawk a, “Pathianin hetia min tih hi eng tizia nge ni aw?” tiin khûr chungin an inen ta hlawm a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Kanaan rama an pa Jakoba hnên chu an lo thleng a, an chunga thil thleng zawng zawng chu an hrilh a;
  </para>
  <para style="p">
    <verse number="30" style="v" />“Chumi ram hotu chuan ram takin min bia a, ram enthlatuah min puh a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, keini chuan a hnênah, ‘Mi dik tak kan ni; enthlatu kan ni awzâwng lo ve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Unau sâwm leh pahnih kan ni a, pa pakhat fapate kan ni vek a; pakhat chu a awm ta lo va, kan tlum ber chu tûnah hian Kanaan ramah kan pa hnênah a awm a ni,’ kan ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, chu mi, an ram hotu chuan kan hnênah, ‘Heti hian mi dik tak in ni tih ka la hria ang: in unau pakhat ka hnênah hnutchhiah ula, in chhûngteho ṭâm tân chuan buh phur ula, kal tawh rawh u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, in tlum ber chu ka hnênah rawn hruai ang che u; tichuan, enthlatu in ni lo va, mi dik tak in ni zâwk tih ka hria ang; chutichuan, in unaupa hi ka pe leh ang che u a, he ramah hian in sumdâwng dâwn nia,’ min ti a,” an ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tin, heti hi a ni a, an ipte chu an bun ruah laiin, ngai teh, an tangka fûn ṭheuh chu an ipah chuan a lo awm ta ṭheuh va! Tin, anniho leh an pa chuan an tangka fûnte chu an hmuh chuan an hlau hle a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tin, an pa Jakoba chuan an hnênah, “Nangni hian ka fate mi chântîr a nih hi; Josefa a awm tawh lo va, Simeona pawh a awm tawh hek lo, Benjamina lam pawh hruai bo in tum lehzêl a; chûng thil zawng zawng chuan mi tlâkbuak a nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tin, Reubena chuan a pa hnênah, “I hnêna ka rawn hruai leh loh chuan ka fapate pahnih hi that mai ang che; ani chu ka kutah mi kawltîr la, i hnênah ka rawn hruai leh mai ang,” tiin a sawi a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nimahsela, ani chuan, “Ka fapa hi in hnênah a chhuk ve lo vang; a u a thi tawh a, amah chauh hi a ni tawh si a; in kalna kawng lakahte tawhsual a zuk tawh chuan ka lû ṭuak hi lungngaihnain thlânah in liamtîr dâwn a ni,” a ti a.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, chumi ramah chuan ṭâm a tla nasa hle a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, heti hi a ni a, Aigupta ram ata buh an phurh chhoh kha an ei zawh chuan an pa chuan an hnênah, “Kal leh tawh ula, buh tlêm tal kan tân zuk lei leh rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, Juda chuan a hnênah, “Chu mi chuan, ‘In nau chu in hnêna a rawn tel loh chuan ka hmêl in hmu tawh lo vang,’ tiin min phût tlat a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kan nau hi kan hnênah i tirh chuan buh kan zuk leisak ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />I tirh loh erawh chuan kan zuk kal lo vang; chu mi chuan kan hnênah, ‘In nau chu in hnêna a rawn tel loh chuan ka hmêl in hmu lo vang,’ a ti miau si a,” tiin a sawi a,
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, Israela chuan, “Eng vângin nge nau dang in la neih thûte lam in hrilh khera, ka tâna ṭha lo tak in tih ni?” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, anni chuan, “Chu mi chuan, ‘In pa chu a la dam em? Unau dang in la nei em?’ tiin kan chanchin leh kan laichînte chanchin min zâwt tlat si a; tichuan, chûng a thu min zawh ang zêl chu kan hrilh a ni: ‘In nau chu rawn hruai chhuk rawh u,’ a ti ang tih tu nge hre kher ang i?” an ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Juda chuan a pa Israela hnênah, “Taitea chu ka hnênah kaltîr rawh; tichuan, kan tho vang a, kan kal mai ang e; keini leh nang leh kan fanau tê tête pawh hi thi lova kan nun theihna tûrin.
  </para>
  <para style="p">
    <verse number="9" style="v" />A chungchâng thûah hian keiman a mawh ka phur zêl ang; keima kutah ngei amah dah ang che. Ani chu i hnênah ka rawn hruai leh lohva, i hmaah hian ka dintîr leh loh chuan a mawh chu kumkhuain ka phur nâng e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Awm rei suh ila chuan tûnah hian a vawi hnihna pawh kan lo thleng leh tawh ngei ngei ang,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, an pa Israela chuan an hnênah, “Chutiang a nih si chuan heti hian ti rawh u: in bâwmahte khân he rama thil ṭha ṭha ṭhenkhat - thinghnai damdawi te, khawizu te, englo rimtui te, murra te, theipilsak te, vaiumkhal te tlêm ṭheuhvin chu mi tân chuan lâwmmanah sin thlâk rawh u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, tangka a leh hnih keng ula, in ip rawng bula tangka a pêk kîr che u pawh kha keng leh rawh u; a tihpalh a ni mahna.
  </para>
  <para style="p">
    <verse number="13" style="v" />In nau pawh chu hruai ula, tho ula, chu mi hnênah chuan kal leh rawh u.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tichuan, in unau pakhat leh Benjamina hi a chhuahsakna tûr che uin, Pathian Engkimtitheia chuan chu mi chu khawngaihtîr che u rawh se. Tin, ka fate chu chân a nih leh ka chân mai a ni ang chu,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tichuan, anni chuan lâwmman chu an keng a, tangka chu a leh hnih an keng bawk a, Benjamina pawh an hruai a; tin, an tho va, Aigupta ramah an zuk kal a, Josefa hmaah chuan an ding leh ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Josefa chuan Benjamina an hnêna awm chu a hmuh veleh, a in enkawltu hnênah chuan, “Saw mite saw in chhûngah hruai lût la, sa talh la, buatsaih rawh; saw mite sâwn chhûnah ka hnênah chaw an ei dâwn a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, ani chuan Josefa thupêk angin a ti a; Josefa inah chuan a hruai lût a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Josefa inah hruai luha an awm avângin an hlau va, “Kal hmasak ṭuma kan ipa tangka min pêk kîrte avâng khân a nih hi min hruai luh ni; kan chungah remchâng zawnga min beiin, keimahni leh kan sabengtungte nên hian bâwih atân min man a tum a nih hi,” an ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Josefa in enkawltu kiangah chuan an va kal a, kawngka bulah chuan an bia a,
  </para>
  <para style="p">
    <verse number="20" style="v" />“Aw ka pu, kan lo kal hmasak ṭum khân buh lei tûr ngawta lo chhuk kan ni a;
  </para>
  <para style="p">
    <verse number="21" style="v" />tin, heti hi a ni a, riah bûk kan thlen chuan kan ipte chu kan han hawng a; tin, ngai teh, kan tangka ṭheuh chu kan ip rawng bulah a lo awm ta ṭheuh va, kan tangka chu a bûk ngai thênin a lo awm a; tichuan, kan rawn keng leh a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, buh leina tûrin tangka dang pawh kan rawn keng a; kan tangka chu tuin nge kan ipah dah kan hre si lo,” an ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, ani chuan, “Thlamuang takin awm ula, hlau suh u; in Pathian, in pa Pathian chuan in ipahte chuan ro a pe che u a nih chu; in tangka kha ka hmu si a,” a ti a. Tin, Simeona chu an hnênah a rawn hruai chhuahsak ta a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, anni chu Josefa in chhûngah a hruai lût a, tui a pe a, an ke an sil ta a; an sabengtungte pawh chu chaw a pe bawk a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, an lâwmman ken chu Josefa chawfâka a lo kal hmain an lo buatsaih lâwk a; chutah chuan chaw an ei dâwn tih an hre si a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, Josefa chu ina a lo hâwn veleh, an kuta lâwmman awm chu in chhûngah a hnênah an keng lût a, lei siin chibai an bûk hlawm a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, ani chuan an chanchin a zâwt a, “In pa, a chanchin in sawi putar kha, a dam lai a ni em? Nungdamin a la awm em?” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, anni chuan, “Kan pa, i chhiahhlawh chu a dam lai a ni a, nungdamin a la awm e,” an ti a. Tin, an lû an kûn a, chibai an bûk leh a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, ani chu a dâk a, a nau Benjamina, a nu fapa chu a hmu a, “Kha kha in tlum ber, a chanchin mi hrilha kha em ni?” a ti a. Tin, amah vêkin, “Ka fapa, Pathianin khawngaih che rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Josefa chuan a nau a hmuh chuan a lung a chhiat tâk êm avângin, hmanhmawh takin ṭahna hmun a zawng ta thuai a, a pindan chhûngah a lût a, chutah chuan a ṭap chhuak ta a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, a hmai a phih a, a va chhuak leh a, a insûm hrâm hrâm a, “Chaw ei siam rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tichuan, ama tân a hrangin, anniho tân a hrangin, Aigupta mi a eipuiteho tân a hrangin an siam ta a (Aigupta-hovin Hebrai-ho chu an eipui thei si lo; chutiang tih chu Aigupta-ho tân chuan a thiang lo a ni).
  </para>
  <para style="p">
    <verse number="33" style="v" />Tichuan, upa ber chu fa tîr nihna angin, naupang ber chu a tlum ber nihna angin Josefa hmaah chuan an ṭhu zêl a; chutichuan, mak an ti hlawm ṭheuh va.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tin, Josefa chuan a hnêna mi chanvote chu an hnênah a hlan chhâwntîr a, Benjamina chanvo phei chu an chanvo zawng zawng ai chuan a leh ngain a tam bîk a ni. Tin, uain te an in a, a hovin an hlim ta hle a.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, ani chuan a in enkawltu hnênah chuan, “Kha mite ip kha an phurh theih tâwkin buhin tikhat la, an tangka ṭheuh chu an ip rawng bulah dah ṭheuh rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, ka no, tangkaraw no kha, an naupang ber ip rawng bulah dah rawh, a buh man tangka nên khân,” tiin thu a pe a. Tichuan, ani chuan Josefa thusawi ang chuan a ti ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, khua a vâr veleh anni chu an sabengtungte nên chuan an kaltîr ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, khua ata an kal chhuak chu an la thlen hlat hmain Josefa chuan a in enkawltu hnênah, “Tho la, mite kha va ûm rawh; tin, i ûm phâk veleh an hnênah, ‘Engtizia nge thil ṭha thil ṭha lova in rulh ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Kha kha ka pu uain inna leh aienna ngei a ni lo vem ni? Hetiang in tih hi in tisual a ni,’ ti rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, a ûm phâk a, chûng thu chu an hnênah a sawi a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, anni chuan a hnênah, “Ka pu, eng tizia nge ni hetiang thu i sawi? I chhiahhlawhte hian chutiang thil kan tih loh tûrzia mai chu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai teh, kan ip rawng bula tangka kan hmuhte pawh kha Kanaan ram aṭangin i hnênah kan rawn ken leh kha. Engtin nge i pu ina mi tangkarua emaw, rangkachak emaw kan rûk theih ang le?
  </para>
  <para style="p">
    <verse number="9" style="v" />I chhiahhlawhte zîngah hian tu pawh i hmuhna apiang chu thi rawh se, keini pawh kan pu bâwihah kan awm mai ang e,” an ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, ani chuan, “Aw le, in thu ang zêl chuan ni ang hmiang; amaherawhchu, tu pawh ka hmuhna apiang chu ka bâwihah a awm ang a, nangni erawh chu sawisêl bovin in awm ang,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chu veleh chuan hmanhmawh takin mahni ip chu leiah an la thla ṭheuh va, mahni ip chu an hawng ṭheuh bawk a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ani chuan an upa berah a ṭan a, an naupang ber thlengin a zawng a; tichuan, no chu Benjamina ipah chuan a hmu ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chu veleh chuan an silhfênte chu an pawt thlêr a, mahni sabengtung chu an phurhtîr leh ṭheuh va, khuaah chuan an kîr leh ta a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Juda leh a unaute chuan Josefa in chu an va thleng a, ani chu chutah chuan a lo la awm cheu va; tin, a hmaah chuan an bawkkhup ta hlawm a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Josefa chuan an hnênah, “Eng thil nge ni in tih tâk ni? Keimah ang mi hian ai an en thiam ngei ang tih in hre lo vem ni?” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Juda chuan, “Ka pu, i hnênah eng nge kan sawi tâk ang? Eng nge kan hrilh ang? Engtin nge kan insawi ven tâk ang le? Pathianin i chhiahhlawhte sualna chu a hmu chhuak ta a nih hi; ngai teh, ka pu, i bâwihte kan nih tâk hi, keimahni leh a kuta no an hmuhna pawh hi,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, ani chuan, “Chutiang chuan ka tih loh tûrzia mai chu; a kuta no an hmuhna chauh hi ka bâwihah a awm ang. Nangni erawh zawng thlamuang takin in pa hnênah han kal rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chu veleh Juda chuan Josefa chu a va hnaih a, “Aw ka pu, khawngaih takin, ka pu, i chhiahhlawh hi i beng hriatah thu kam khat mi sawitîr la, i thinur chu i chhiahhlawh chungah hian alhtîr suh ang che; nang zawng Pharaoa ang mai i ni si a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka pu, nangin, ‘Pa emaw, unau emaw in nei em?’ tiin i chhiahhlawhte hi min zâwt a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, ka pu, keinin i hnênah hian, ‘Pa putar tak leh a tar lam fa, naupang tê kan nei a; chu mi u chu a thi a, a nu hrinah chuan amah chauh chu a la awm a, a pa chuan amah chu a hmangaih hle mai,’ kan ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, nangin i chhiahhlawhte hnênah hian, ‘Amah chu ka mita ka hmuh theih nân ka hnênah rawn hruai thla rawh u,’ i ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, ka pu, keinin i hnênah, ‘Taitea chuan a pa a kalsan thei lo vang; a pa a kalsan zawngin a pa chu a thi mai dâwn si a,’ kan ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, nangin i chhiahhlawhte hnênah hian, ‘In tlum ber chu in hnêna a lo chhuk ve loh chuan ka hmêl in hmu leh tawh lo vang,’ i ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, heti hi a ni a, i chhiahhlawh ka pa hnên kan han thlen chuan, ka pu, i thu chu kan hrilh a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, kan pa chuan, ‘Kal leh tawh ula, buh tlêm tal kan tân zuk lei leh rawh u,’ a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, keinin, ‘Kan zuk kal thei tawh lo vang; kan tlum ber hi kan hnêna a tel ve erawh chuan kan zuk kal mai ang; kan tlum ber hi kan hnêna a tel loh chuan chu mi hmêl chu kan hmu thei dâwn lo a ni,’ kan ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, i chhiahhlawh ka pa chuan kan hnênah, ‘Ka nupui chuan fapa pahnih mi hrinsak tih in hria e;
  </para>
  <para style="p">
    <verse number="28" style="v" />tin, a pakhat chu ka hnên ata a kal chhuak a, pawh sawm vekin a awm a ni ngei ang, ka ti a; chumi achinah chuan amah chu ka hmu ta lo vang vang a;
  </para>
  <para style="p">
    <verse number="29" style="v" />tichuan, he mi pawh hi ka hnên ata in hruai bova, tawhsual a zuk tawh chuan ka lû ṭuak hi lungngaihnain thlânah in liamtîr dâwn a ni,’ a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutichuan, Taitea hi kan hnêna tel lova i chhiahhlawh ka pa hnên ka han thlen chuan, a nunna chu Taitea nunna nên a inzawm tlat avângin,
  </para>
  <para style="p">
    <verse number="31" style="v" />heti hi a ni ang a, Taitea hi a tel ve lo tih a hriat veleh a thi mai ang; tichuan, i chhiahhlawhte hian i chhiahhlawh kan pa lû ṭuak chu lungngaihnain thlânah kan liamtîr dâwn a nih hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />I chhiahhlawh hian, ‘I hnêna ka rawn hruai leh loh chuan a mawh chu kumkhuain ka pa lakah ka phur ang,’ tiin, ka pa lakah chuan Taitea chungchâng thûah hian a mawhphurtuah ka insiam tawh si a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chutichuan, khawngaih takin i chhiahhlawh hi Taitea aiah, ka pu, i bâwihah mi awmtîr la, Taitea hi a ute hnênah chhohtîr ang che.
  </para>
  <para style="p">
    <verse number="34" style="v" />Taitea ka hnêna tel lovin ka pa hnênah engtin nge ka chhoh theih ang? Ka pa chunga chhiatna thleng tûr chu ka hmu ang asin,” a ti a.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Josefa chu a kianga ding zawng zawngte hmaah chuan a insûm zo ta lo va, “Mi zawng zawng hi ka hnên ata kal chhuahtîr vek rawh u!” tiin a au va. Tichuan, Josefa a unaute hnênah a inhriattîr chhûng zawng a kiangah tu mah an ding lo va.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, a ṭap ta rawih a; tichuan, Aigupta-hovin an hria a, Pharaoa chhûngte pawhin an hre bawk a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Josefa chuan a unaute hnênah, “Josefa kha ka ni; ka pa chu a la dam maw?” a ti a. Nimahsela, a unaute chuan an chhâng thei lo va, a hmaah chuan mangang takin an awm ta a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, Josefa vêkin a unaute hnênah, “Khawngaih takin mi rawn hnaih teh u,” a ti a. Tichuan, an va hnaih a. Tin, ani chuan, “In unaupa Josefa, Aigupta rama luhpui tûra in hralha kha ka ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nimahsela, heta kal tûra mi hralh avâng hian lungngai suh ula, mahni inhaw duh hek suh u; mite nunna chhandam tûrin Pathianin in hmaah mi lo tîr hmasa a nih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />He kum hnih chhûng hian he ramah hian ṭâm a lo tla ta a; kum nga a la bâk a, chumi chhûng zawng lei leh hi a awm lo vang a, buh lâk pawh a awm hek lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, leiah hian chithlahte zuahsak tûr che u leh, chhandamna ropui takin nungdama ka awmtîrna tûr che uin Pathianin in hmaah hian mi lo tîr hmasa a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichuan, heta mi kaltîrtu hi nangni in ni lo va, Pathian a ni zâwk e; ani chuan Pharaoa paah leh, a chhûngte zawng zawng hotuah leh Aigupta ram zawng zawng rorêltuah mi siam ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rang takin ka pa hnênah han kal ula, a hnênah, ‘I fapa Josefa chuan heti hian a ti a: “Pathianin Aigupta ram zawng zawng hotuah mi siam ta; ka hnênah lo chhuk rawh, rei rawn rial suh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tichuan, Gosen ramah i awm ang a, ka kiang ngeiah hian i awm dâwn nia, nang leh i fate leh i tute nên, i berâm rualte leh i bâwng rualte leh i neih zawng zawng nên.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutah chuan keiman ka châwm ang che, ṭâm tûr kum nga a la awm si a; chuti lo chuan, i lo rethei dah ang e, nang leh i chhûngte leh i neih zawng zawngte nên khân,”’ han ti ang che u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, ngai teh u, nangmahni mit ngei leh ka nau Benjamina mit ngeiin keima kâ ngeiin a sawi lai in hmu reng a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Aigupta rama ka ropuina zawng zawng thu leh in thil hmuh zawng zawng thu hi ka pa in hrilh ang a; ka pa chu rang takin hetah in rawn hruai thla tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, a ir leh a nau Benjamina ir chuktuahin a ṭap ta a; Benjamina pawh a ir chuktuahin a ṭap ta bawk a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, a unaute zawng zawng chu a fâwp a, a ṭah khum ta ṭheuh va; chumi hnuah chuan a unaute chuan thukhawchâng an sawipui ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, “Josefa unaute an lo kal,” tih thuthang chu Pharaoa inah chuan an lo hre ta a; chu chuan Pharaoa leh a chhiahhlawhte chu a tilâwm hle a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Pharaoa chuan Josefa hnênah, “I unaute hnênah, ‘Heti hian ti rawh u: in sate chu buh phurhtîr ula, chhuak ula, Kanaan ramah kal rawh u.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, in pa leh in chhûngte chu hruai ula, ka hnênah hian lo kal rawh u; tichuan, Aigupta rama thil ṭhate hi ka pe ang che u a, he rama thil awm ṭha berte hi in ei dâwn nia,’ ti rawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thu ka pe a che, ‘Heti hian ti rawh u: in fanau tê tête tân leh in nupuite tân Aigupta ram aṭang hian tawlailîrte la ula, in pa hruaiin lo kal rawh u.
  </para>
  <para style="p">
    <verse number="20" style="v" />In bungrua pawh ngaihtuah duh suh u, Aigupta ram zawng zawnga thil ṭha apiang hi in ta a ni si a,’ tiin hrilh rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tichuan, Israela fate chuan chutiang chuan an ti a; tin, Josefa chuan Pharaoa thupêk ang chuan tawlailîrte an hnênah a pe a, kalkawng atân ei tûr a pe bawk a.
  </para>
  <para style="p">
    <verse number="22" style="v" />An zaa hnênah silhfên inthlâknate a pe ṭheuh va; Benjamina hnênah phei chuan tangka zathum leh silhfên inthlâkna panga a pe a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, a pa hnênah chuan hetiang hi a thawn a: sabengtung sâwm, Aigupta rama thil ṭha phur leh sabengtungnu sâwm, kalkawnga a pa tân buh leh chhang leh ei tûr phur a thawn a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutichuan, a unaute chu a tîr chhuak a, an kal ta a; tin, ani chuan an hnênah, “Kalkawngah inhau lo tûrin fimkhur rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Aigupta ram ata chu an han chho va, Kanaan rama an pa Jakoba hnên chu an han thleng a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tin, a hnênah, “Josefa kha a lo la dam a, Aigupta ram zawng zawng rorêltu a ni,” tiin an hrilh a. Tin, a thin a mit sulh a, an thu chu a âwih si lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, an hnêna Josefa thusawi zawng zawng chu an hrilh a; tin, a chuanna tûr tawlailîr, Josefan a thawnte chu a han hmuh chuan, an pa Jakoba thinlung chu a harh ta huai a;
  </para>
  <para style="p">
    <verse number="28" style="v" />tin, Israela chuan, “A tâwk ta e; ka fapa Josefa chu nungdamin a lo la awm a nih tak hi; ka thih hmain amah ka zuk hmu ang,” a ti ta a.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Israela chu a neih zawng zawng nên a chhuak a, Beer-seba chu a thleng a, a pa Isaaka Pathian hnênah chuan inthawinate a hlân a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Pathianin zâna a mumangahte chuan Israela chu a bia a, “Jakob, Jakob!” a ti a. Tin, ani chuan, “Heta hi ka awm,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, ani chuan, “Kei Pathian, i pa Pathian chu ka ni; Aigupta rama zuk kal chu hlau suh, chutah chuan chi ropui takah ka siam dâwn che a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aigupta ramah chuan i hnênah ka zuk kal ve ang a, ka hruai chho leh ngei ngei bawk ang che; tin, Josefa chuan i thih hunah i mit a siamsak dâwn che nia,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Jakoba chu Beer-seba aṭang chuan a chhuak a; Israela fapate chuan an pa Jakoba leh an fanau tê tête leh an nupuite chu a chuan nâna Pharaoa tawlailîr thawnahte khân an chuantîr a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, Jakoba leh a thlahte zawng zawng chuan Kanaan rama an deh chhuah an rante leh an bungruate chu an chhawm a, Aigupta ram chu an thleng ta a;
  </para>
  <para style="p">
    <verse number="7" style="v" />a fapate, a tupate, a fanute, a tunute, a thlahte zawng zawng chu Aigupta ramah chuan a luhpui ta hlawm a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, hêng hi Israela thlah Aigupta rama lût, Jakoba leh a fapate hming chu a ni: Reubena, Jakoba fa tîr chu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Reubena fapate chu Hanoka te, Palua te, Hezrona te, Karmia te an ni a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Simeona fapate chu Jemuela te, Jamina te, Ohada te, Jakina te, Zohara te, Kanaan hmeichhe laka a fapa Saula te an ni a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Levia fapate chu Gersona te, Kohatha te, Meraria te an ni a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Juda fapate chu Era te, Onana te, Sela te, Pereza te, Zera te an ni a; Era leh Onana erawh chu Kanaan ramah chuan an thi ta a ni. Pereza fapate chu Hezrona leh Hamula an ni a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Isakara fapate chu Tola te, Puva te, Ioba te, Simrona te an ni a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Zebuluna fapate chu Sereda te, Elona te, Jahleela te an ni a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chûngho zawng zawng chu Leaii fapa, a fanu Dinaii nên, Paddan-aram rama Jakoba a hrinsakate chu an ni a; a fapate leh a fanute zawng zawng chu sawmthum leh pathum an ni a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Gada fapate chu Ziphiona te, Hagia te, Sunia te, Ezbona te, Eria te, Arodia te, Arelia te an ni a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Asera fapate chu Imna te, Isva te, Isvia te, Beria te an ni, an farnu Seri nên; tin, Beria fapate chu Hebera leh Malkiela an ni a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chûngho chu Zilpaii, Labanan a fanu Leaii hnêna a pêka fapate chu an ni, chûngho chu Jakoba a hrinsak a, mi sâwm leh parukte chu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Jakoba nupui Rakili fapate chu Josefa leh Benjamina an ni a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tin, Josefa chuan Aigupta ramah fapa Manasea leh Ephraima a nei a, chu mite chu On khaw puithiam Potiphara fanu Asenathi chuan amah a hrinsak a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Benjamina fapate chu Bela te, Bekera te, Asbela te, Gera te, Naamana te, Ehia te, Rosa te, Mupima te, Hupima te, Arda te an ni a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chûngho chu Rakili fapa, Jakoba a hrinsakte chu an ni; an za chuan sâwm leh pali an ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tin, Dana fapa chu Husima a ni a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Naphtalia fapate chu Jazeela te, Gunia te, Jezera te, Silema te an ni a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chûngho chu Bilhaii, Labanan a fanu Rakili hnêna a pêka fapate chu an ni, chûngho chu Jakoba a hrinsak a; an za chuan pasarih an ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jakoba fapate nupuiho chhiar lovin, Jakoba hnêna Aigupta rama lût ve, a ṭhâlbea chhuak zawng zawngte chu an za chuan sawmruk leh paruk an ni a;
  </para>
  <para style="p">
    <verse number="27" style="v" />tin, Josefan Aigupta rama fapa a neihte chu pahnih an ni. Jakoba chhûngte zawng zawng Aigupta rama lûtte chu sawmsarih an ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Jakoba chuan Gosen ram lam kawng lo kawhhmuh tûrin Juda chu Josefa hnênah a kal hmasaktîr a; tichuan, Gosen ramah chuan an lût ta a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Josefa chuan a tawlailîr chu a buatsaih a, Gosen ramah chuan a pa Israela hmuak tûrin a han kal ta a; tin, a hnênah a inhriattîr a, a ir a chuktuah a, rei fe a ir chuktuahin a ṭap a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tin, Israela chuan Josefa hnênah, “Nungdama i lo la awma, i hmêl ka hmuh leh tâk avâng hian tûnah chuan duh leh thi tawh rawh i,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, Josefa chuan a unaute leh a pa chhûngte hnênah, “Ka han kal ang a, Pharaoa ka hrilh ang a, a hnênah, ‘Ka unaute leh ka pa chhûngte, Kanaan rama awmte kha, ka hnênah an lo thleng ta;
  </para>
  <para style="p">
    <verse number="32" style="v" />anni chu ran vulhtute an nih avângin berâm vêngtute an ni a; an berâm rualte leh an bâwng rualte leh an neih zawng zawng an rawn chhawm vek a ni,’ tiin ka han sawi ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, heti hi a ni ang a, Pharaoan a koh che ua, ‘Eng hna nge in thawh ṭhin?’ a tih hunah chuan,
  </para>
  <para style="p">
    <verse number="34" style="v" />nangnin, ‘I chhiahhlawhte hi kan thlahtute chenin, kan naupan têt ata tûn thlengin ran vulhtute kan ni,’ ti ang che u; chutichuan, Gosen ramah in awm thei dâwn nia,” a ti a. Berâm vêngtute rêng rêng chu Aigupta mite ten zâwng tak an ni si a.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tichuan, Josefa chuan Pharaoa chu a han hrilh a, a hnênah, “Ka pa te, ka unau te, an berâm rual te, an bâwng rual te, an neih zawng zawngte nên Kanaan ram ata an lo thleng thla ta a; tin, ngai teh, Gosen ramah an awm,” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, a unaute zînga mi, mi panga a hruai a, Pharaoa chu a hriattîr a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Pharaoa chuan a unaute hnênah, “Eng hna nge in thawh ṭhin?” a ti a. Tin, anni chuan Pharaoa hnênah, “I chhiahhlawhte hi kan thlahtute chenin, berâm vêngtute kan ni,” an ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, anni vêk chuan Pharaoa hnênah, “He rama awm rih tûr hian kan lo kal a ni, kan ramah i chhiahhlawhteho berâm rualte tân ei tûr a awm ta si lo; ṭâm hi Kanaan ramah a tla nasa hle si a; chutichuan, khawngaih takin i chhiahhlawhte hi Gosen ramah min awmtîr ang che,” an ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, Pharaoa chuan Josefa a bia a, “I pa leh i unaute chu i hnênah an lo kal ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aigupta ram chu a awm duai alâwm; i pa leh i unaute chu ram ṭha lai apiangah hian awm hmun khuartîr ta che; Gosen ramah awm hmun khuar rawh se. Tin, an zîngah mi thiltithei tak hriat i neih phei chuan ka ran chunga hotuahte siam ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Josefa chuan a pa Jakoba chu a hruai lût a, Pharaoa hmaah chuan a dintîr a; tichuan, Jakoba chuan Pharaoa chu mal a sâwm ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Pharaoa chuan Jakoba hnênah, “Kum eng zât nge i nih tawh?” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Jakoba chuan Pharaoa hnênah, “Ka khualzin kum chin chu kum za leh kum sawmthum a ni a; ka dam chhûng kumte hi a tlêmin a hrehawm a ni, mi thlahtute an khualzin laia an dam chhûng kum pawh a zât ve hek lo,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Jakoba chuan Pharaoa chu mal a sâwm leh a, Pharaoa hnên ata chu a chhuak ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tichuan, Josefa chuan a pa leh a unaute chu awm hmun a khuartîr a, Pharaoa thupêk angin Aigupta rama ram ṭha ber laiah, Rameses ramah chuan ro atân ram a pe ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Josefa chuan a pa leh a unaute leh a pa chhûngte zawng zawng chu an chhûngkua ang zêlin ei tûr a pe a, a châwm ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, chumi ram zawng zawngah chuan ei tûr rêng rêng a awm ta lo va; ṭâm a tla nasa êm êm si a; chutichuan, ṭâm avâng chuan Aigupta ram leh Kanaan ram chu a chau ta a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Josefa chuan an buh leina manah, Aigupta ram leh Kanaan rama tangka awm zawng zawng chu a khâwm ta vek a; tin, Josefa chuan chu tangka chu Pharaoa inah chuan a la ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Aigupta ram leh Kanaan rama tangka zawng zawng an deh ral zawh chuan, Aigupta mi zawng zawng chu Josefa hnênah an lo kal a, “Ei tûr min pe rawh khai; i hmaah hian kan thi mai dâwn em ni ang le? Tangka lah a awm tawh si lo,” an ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tin, Josefa chuan, “In rante rawn pe mai rawh u; tangka a awm tawh loh chuan in ran manah ei tûr ka pe ang che u,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, an rante chu Josefa hnênah an hruai a; tin, Josefa chuan chûng sakawr manah te, berâm rual manah te, bâwng rual manah te, sabengtung manah te chuan ei tûr a pe zêl a; chumi kum chuan an ran zawng zawng manah ei tûr a pe a, a châwm ta hlawm a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, chumi kum a veia, kum lo thar lehah chuan a hnênah an lo kal leh a, a hnênah, “Kan tangka zawng zawng kan deh ral tawhzia leh, ka pu, kan ran rualte i ta a nih tawhziate hi, ka pu, i lakah hian kan zêp lo vang; ka pu, i mit hmuhah hian kan taksa leh kan ramte chauh lo chu eng mah a awm tawh hauh lo mai.
  </para>
  <para style="p">
    <verse number="19" style="v" />I hmaah hian keini leh kan ram hi kan boral mai dâwn em ni ang le? Keimahni hi kan ram chawpin ei tûrin min lei rawh; tichuan, keini leh kan ram hi Pharaoa chhiahhlawhte kan ni mai ang e; tin, thi lova nungdama kan awm theihna tûr leh, ram hi a ṭiau lohna tûrin buh chi min pe ang che,” an ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Josefa chuan Pharaoa tân Aigupta ram zawng zawng chu a lei ta a; ṭâm chu an chunga a thlen nasat êm avângin Aigupta mite chuan an lo chu an hralh ṭheuh si a; tichuan, ram chu Pharaoa ta a ni ta vek a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihringte chu Aigupta ramri lehlam tâwp aṭanga a lehlam tâwp thlengin, khuaahte chuan a insawntîr ta hlawm a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Puithiamho ram chauh a lei lo va; puithiamhote chuan Pharaoa lakah chanvo an nei a, Pharaoan an chanvo a pêk chu an ei ṭhîn a ni; chuvângin, an ram chu an hralh ve lo va.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chumi hnuah chuan, Josefan mite hnênah chuan, “Ngai teh u, vawiinah hian nangniho hi in ram chawpin Pharaoa tân ka lei ta che u a; hei, heta hi in tân buh chi a awm hi, leiah chîng ang che u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, buh lâk hunah te chuan heti hi a ni ang a, Pharaoa tân hmun ngaa ṭhena hmun khat zêl in pe ang a, a hmun li chu nangmahni ta a ni ang, chu chu lova chîn lehah te, nangmahni leh in chhûngte eiah te, in fanau tê tête eiah te a ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, anni chuan, “Nangin kan nun hi i chhan him tawh a; ka puin min khawngaih sela, Pharaoa chhiahhlawhte kan ni mai ang,” an ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tichuan, Josefa chuan Pharaoan hmun ngaa hmun khat a hmuh zêl tûr thu hi, Aigupta ram tân tûn thlengin dânah a siam ta; puithiamho ram chauh chu a ni, Pharaoa ta ni lo chu.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tin, Israel-ho chuan Aigupta rama Gosen ramah chuan awm hmun an khuar ta a; chutah chuan an intimuk a, chi tam tak an thlah a, nasa takin an pung ta a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tin, Jakoba chu Aigupta ramah chuan kum sâwm leh kum sarih a awm a; chutichuan, Jakoba dam chhûng chu kum za leh kum sawmli leh kum sarih a ni ta a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, Israela thih hun tûr chu a lo hnai ta a; tichuan, a fapa Josefa chu a ko va, a hnênah, “I mit ka tlun chuan khawngaih takin i kut kha ka malpui hnuaiah rawlh la, mi khawngaihin ka chungah tihtak zetin ti ang che; khawngaih takin Aigupta ramah hian mi phûm lul suh ang che;
  </para>
  <para style="p">
    <verse number="30" style="v" />mi thlahtute hnêna ka muthilh hunah chuan nangin Aigupta ram ata hi mi zâwn chhuakin, anmahni phûmna hmunah chuan mi phûm zâwk tûr a ni,” a ti a. Tin, ani chuan, “I sawi ang hian ka rawn ti ang e,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tin, ani chuan, “Ka hnênah chhia chham rawh le,” a ti a; tichuan, a hnênah chhia a chham ta a. Tin, Israela chu khum lû siin a kûn ta a.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, chûng hnuah chuan heti hi a ni a, Josefa hnênah, “Ngai teh, i pa a damlo ve,” an ti a. Tichuan, a fapate pahnih Manasea leh Ephraima chu a hnênah a hruai ve a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Jakoba hnênah “Ngai teh, i fapa Josefa i hnênah a lo kal e,” tiin an hrilh a; tichuan, Israela chu a intiharh a, khumah chuan a ṭhu ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tin, Jakoba chuan Josefa hnênah, “Pathian Engkimtitheia chu Kanaan rama Luz khuaah chuan ka hnênah a inlâr a, mal mi sâwm a,
  </para>
  <para style="p">
    <verse number="4" style="v" />ka hnênah, ‘Chi tam tak ka thlahtîr ang chia, ka tipung bawk ang chia, chi hrang hrang awm khâwmah ka siam ang che; tin, he ram hi i hnua i thlahte hnênah chuan kumkhaw ro atân ka pe ang,’ mi ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tin, i fapate pahnih, Aigupta rama i hnêna ka lo kal hmaa Aigupta rama i neihte hi ka ta an ni; Ephraima leh Manasea hi, Reubena leh Simeona ang bawkin ka ta an ni ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tin, he mite hnua fa i neihte chu i ta an ni ang, an ro chanah chuan an ute hming chu an ṭâwm mai ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, keia thu zawng, Paddan-aram aṭanga ka lo kal lai khân Rakili chu Kanaan ramah, kawng lakah, Ephrath khua chu a la hlat fe laiin ka bulah a thi a; chuta Ephrath khaw kawngah chuan ka phûm ta a (chu chu Bethlehem khua a ni),” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tin, Israela chuan Josefa fapate chu a en a, “Heng hi tute nge ni?” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, Josefa chuan a pa hnênah, “Hêng hi ka fapa, Pathianin heta mi pêkate chu an ni,” a ti a. Tin, ani chuan, “Khawngaih takin ka hnênah hian han hruai hnai rawh; tichuan, anmahni mal ka lo sâwm ang e,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israela mit chu a upat avângin a fiah lo va, a hmu thei lo a ni. Tin, anni chu a han hruai hnai a; tin, ani chuan a lo fâwp a, a lo pawm a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, Israela chuan Josefa hnênah, “I hmêl hmuh hi ka beisei tawh lo va; nimahsela, ngai teh, Pathianin i thlahte hmêl lam pawh mi hmuhtîr ta a nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, Josefa chuan anni chu a pa kapkâr ata chu a kai chhuak a, a hmaia lei siin chibai a bûk a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tin, Josefa chuan an pahnih chuan a kai a, Ephraima chu a kut ding lamin Israela kut vei lampangah a kai a, Manasea chu a kut vei lamin Israela kut ding lampangah a kai a, a rawn hruai hnai a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Israela chuan a ban kawkalh lui a, a kut ding lam chuan a ban a, Ephraima, a naupang zâwk chhîpah a nghat a; Manasea chu fa tîr a ni si a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Josefa chu mal a sâwm a, “Mi thlahtu Abrahama leh Isaaka, a hmaa an awm ṭhinna Pathian, vawiin thlenga ka dam chhûng zawng zawnga mi châwmtu Pathian,
  </para>
  <para style="p">
    <verse number="16" style="v" />sual zawng zawng laka mi tlantu vântirhkoh chuan naupangte hi malsâwm rawh se; tin, ka hming leh mi thlahtu Abrahama leh Isaaka hming chu anmahni hmingah pu rawh se; tin, khawvêl lailiah mipui tam tak ni tûrin lo pung rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tin, Josefa chu, a pain a kut ding lam Ephraima chhîpa a nghat chu a hmuhin a lungni ta lo va; tichuan, a pa kut chu Ephraima chhîp ata Manasea chhîpa sawn tûrin a chawi kâng a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Josefa chuan a pa hnênah, “Ka pa, hetiang tûr a ni lo, hei hi asin fa tîr chu ni; i kut ding lam hi a chhîpah nghat zâwk rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nimahsela, a pa chuan a duh lo va, “Ka hria e, ka fapa, ka hria e; ani pawh hnama sawi thamin a awm bawk ang a, ani pawh a ropui bawk ang; amaherawhchu, a nau hi a aiin a ropui zâwk ang a, a thlahte pawh chi hrang hrang tam tak an lo la ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tichuan, Jakoban, “Israel-ho chuan, ‘Ephraima leh Manasea angin Pathianin awmtîr che rawh se,’ tiin mangmahni hming lamin mal an sâwm ṭhin ang,” tiin, chumi ni chuan anni chu mal a sâwm a; tichuan, Ephraima chu Manasea hmaah a awmtîr ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Israela vêk chuan Josefa hnênah, “Ngai teh, ka thi dâwn ta e; nimahsela, Pathian chu in hnênah a awm ang a, in thlahtute ramah chuan a hruai leh ang che u.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chumi lo pawh chu, i unaute chanvo aiin chan khatin ka pe chuang a che, ka khandaih leh ka thal ngula Amor-ho kut ata ka lâksaka kha,” a ti a.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tichuan, Jakoba chuan a fapate chu a ko va, heti hian a sawi a: “Ni hnuhnûngahte in chunga thil la thleng tûr chu ka hrilh theihna tûr che uin rawn inkhâwm rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangni Jakoba fapate u, rawn inkhâwm ula, ngaithla rawh u; In pa Israela thu hi ngaithla rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Reuben, nang hi ka fa tîr, ka thiltihtheihna, ka chakna rah hmasa ber i ni; Sân berna leh thuneih berna chu i ta a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nimahsela, tui anga nghet lo i ni, Chungnun berna chu i nei lo vang; I pa khumpui i kai avângin; Chumi lai chuan chu chu i tibawlhhlawh a, ka mutnaa a kai kha.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeona leh Levia hi unau an ni a; An khandaihte chu thisen chhuahna hriamhrei a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw, ka thlarau, nang zawng an inrâwnnaah chuan inrawlh ve suh; Ka ropuina, nang zawng an inkhâwmnaah chuan tel ve suh; An thinurin mi an that a, An tihmawhin bâwngpa tha an chhat a.
  </para>
  <para style="p">
    <verse number="7" style="v" />An thinurna chuan ânchhia dawng rawh se, kawlh tak a ni si a; An thinrimna pawh chuan ânchhia dawng rawh se, nun chhe tak a ni si a! Jakob-hovah chuan anni chu ka tiṭhen ang a, Israel-hovah chuan ka tidarh bawk ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Juda, nang zawng i unauten an fak ang che; I kut chu i dote nghâwngah i nghat ang a; I pa fapate chu i hmaah an kûn ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Juda hi sakeibakneino a ni; Ka fapa, i sa seh chu i chhohsan ta a. A kûn a, sakeibakneipa angin a bawk a, Sakeibakneinu ang bawk siin; Tuin nge titho ngam ang?
  </para>
  <para style="p">
    <verse number="10" style="v" />Lal tiang chu Juda lakah a bo lo vang a, Rorêltu tiang chu a ke kâr ata a bo hek lo vang, Silova lo kal hma loh chuan; Hnam tinin ama thu an âwih ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />A sakawrno chu grêp hruiah a thlung a, A sabengtungno chu grêp hrui ṭha miah a thlung bawk a. A silhfênte chu uainah a su a, A puan chu grêp thisenah a su bawk a.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mitte chu uain aiin a duk ang a, A hate chu hnute tui aia tihvârin a awm bawk ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zebuluna hian tuifinriat kamah awm hmun a khuar ang: Lawng chawlhna vaukam a ni ang a, A ramri chu Zidon-ah a ni ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Isakara hi sabengtung chak tak, berâm huang kâra bawk a ni;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chawlh chu ṭhain a hria a, Ram chu nuamin a hre bawk a; Tichuan, englo pu tûrin a koki chu a tihniam a, Hnathawka rawih luihin chhiahhlawhah a lo awm ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dana hian a mite chu, Israel hnam zînga hnam pakhat ni vein, ro a rêlsak ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dana hi lamliana rûl, kalkawnga rûlrial, A chunga chuang zangthala tla dêr khawpa Sakawr kea chu ṭhîntu hi a ni ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Lalpa , i chhandamna chu ka nghâk reng e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gada hi râlin an bei ang a; Nimahsela, ani chuan an keartui lamah a bei zâwk ang,
  </para>
  <para style="p">
    <verse number="20" style="v" />Asera hi a ei a ṭha ang a, Lal ei mi tui tak takte a tichhuak ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naphtalia hi zukpui chhuah a ni; thu ṭha takte a sawi ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Josefa hi pêng rah duh tak a ni, tuikhur kianga pêng rah duh tak chu; A pêng lehchhâwngte chuan lung bang a zâm khuh a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thal kâpho chuan ani chu nasa takin an tirethei a, An kâp a, an tiduhdah a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nimahsela, ani thal ngul chu khauh takin a awm reng a, A kut thate chu Jakoba Mi Chaka kuta - tihchak (chuta ṭang chuan Berâm Vêngtu, Israela Lungpui chu a lo awm a),
  </para>
  <para style="p">
    <verse number="25" style="v" />I pa Pathian, nangmah ṭanpui tûra Engkimtitheia, Chung lam vân malsâwmnate, Hnuai lama bawk reng tui thûk tak malsâwmnate, Hnutê leh chhûl malsâwmnatea Nangmah malsâwmtu tûr ngeia tihchakin a awm a.
  </para>
  <para style="p">
    <verse number="26" style="v" />I pa malsâwmnate hian, Mi thlahtute malsâwmnate chu Chatuan tlâng tâwp rêt thlengin a khûm ta zâwk a ni. Chûngte chu Josefa lûah a awm ang a, A unaute hnên ata tihhrana awma chhîpah chuan a awm ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Benjamina hi chinghne koham a ni; Zîngah chuan a sa seh chu a ei ang a, Tlai lamah chuan a râllâk chu a sem ang,” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chûng zawng zawng chu Israel hnam sâwm leh hnam hnihte chu an ni a, chu thu pawh chu anmahni malsâwma an hnêna an pa thusawi chu a ni; an malsâwm dawn tûr tâwk ang zêlin mal a sâwm ṭheuh va.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tin, anni chu thuro a chhiah a, an hnênah, “Ka chipuite hnênah hruaiin ka awm ve dâwn ta a; Hit mi Ephrona lova pûk, Kanaan rama Mamre zâwna Makpela lova pûk, Abrahaman phûmna hmun ro atân, Hit mi Ephrona laka a lo chawpa a leiah khân mi thlahtute hnênah mi phûm ve ang che u:
  </para>
  <para style="p">
    <verse number="31" style="v" />chutah chuan Abrahama leh a nupui Sari chu an phûm a; chutah chuan Isaaka leh a nupui Rebeki chu an phûm a; chutah bawk chuan Leaii ka phûm a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lo leh a chhûnga pûk awm chu Hetha thlahte laka lei a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tin, Jakoba chuan a fapate hnêna thuro a chhiah zawh chuan, a kete chu khumah a hlâng kai a, a thlarau a thlah a, a chipuite hnênah chuan hruaiin a awm ve ta a.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tin, Josefa chuan a pa hmai a si a, a ṭah a, a fâwp a fâwp a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tin, Josefa chuan a chhiahhlawh damdawi thiamhote chu a pa ruang ṭawih thei lova siam tûrin thu a pe a; tichuan, damdawi thiamhote chuan Israela ruang chu ṭawih thei lovin an siam ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />A ruang siam chhûng chuan ni sawmli a awh a, ṭawih thei lova siamna chuan ni chuti zât chu a awh ṭhîn rêng a ni; tin, ni sawmsarih chhûng zawng Aigupta-ho chuan amah chu an ṭah a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, amah an ṭah nite chu a ral hnu chuan Josefan Pharaoa chhûngte chu a bia a, “I mit ka tlun chuan, khawngaih takin Pharaoa beng hriatah chuan,
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Ka pan, “Ngai teh, ka thi dâwn ta e; Kanaan rama thlân ka laih saah, chutah ngei chuan mi rawn phûm ang che,” tiin chhia mi chhamtîr a. Chutichuan, khawngaih takin ka pa hi mi han phûmtîr ang che; tin, ka lo kal leh mai ang, a ti e,’ tiin sawi rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tichuan, Pharaoa chuan, “Chhia a chhamtîr che ang chuan i pa chu han phûm ta che,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, Josefa chu a pa phûm tûrin a han kal ta a; tin, Pharaoa chhiahhlawh zawng zawng, a chhûngte zînga upate leh Aigupta ram upa zawng zawng leh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Josefa chhûngte zawng zawng leh a unaute leh a pa chhûngte chu a hnênah an han kal ve a. An fanau tê tête leh, an berâm rualte leh an bâwng rualte chauh chu Gosen ramah chuan an hnutchhiah a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tin, an hnênah tawlailîrte, sakawr chung chuang mite an han kal ve a; tichuan, pâwl lian tak mai an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tin, Jordan lui râla Atada hruihzâwl chu an thleng a, chutah chuan nasa takin an ṭah chiam a: ni sarih a pa sûnna a siam a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, chumi rama mi Kanaan-hote chuan Atada hruihzâwla an mitthi sûn chu an hmuh chuan, “Hei, Aigupta-ho mitthi sûnna nasa tak a nih hi,” an ti a; chuvângin, chumi hmun hmingah chuan Abel-mizraim an vuah ta a, chu chu Jordan lui râla awm a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tin, a fapate chuan a thupêk ang zêlin an tihsak a.
  </para>
  <para style="p">
    <verse number="13" style="v" />A fapate chuan Kanaan ramah an zâwn lût a, Abrahaman phûmna hmun ro atân, Hit mi Ephrona laka a lo chawpa a lei, Mamre zâwna Makpela lova pûkah chuan an phûm ta a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tin, Josefa chu a pa a phûm zawh chuan, amah leh a unaute leh a pa phûm tûra a hnêna han kal vete zawng zawng nên chuan, Aigupta ramah an haw leh ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tin, Josefa unaute chuan an pa thi chu an ngaihtuahin, “Josefan min hua ang a, a chunga thil kan tihsual zawng zawng phuba kha kan chungah hian a la la kim seuh mai ang e aw,” an ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tichuan, Josefa hrilh tûrin thu an chah a, “I pa chuan a thih hma khân,
  </para>
  <para style="p">
    <verse number="17" style="v" />‘Heti hian Josefa hnênah, “Khawngaih takin i unaute bawhchhiatna leh an sualna chu ngaidam ang che, i chungah thil zawng an tisual na a,” tiin in sawi tûr a ni,’ a ti a, thu min pe a; tichuan, khawngaih takin i pa Pathian chhiahhlawhte bawhchhiatna chu ngaidam ang che,” an ti a. Tin, a hnêna an han sawi chuan Josefa chu a ṭap ta a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, a unaute pawh chu an va kal ve a, a hmaah chuan an bawkkhup ta hlawm a; tin, “Ngai teh, i chhiahhlawhte kan nih hi,” an ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tin, Josefa chuan an hnênah, “Hlau suh u; Pathian aiawh em ka nih?
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangni zawngin ka chungah thil sual tih in rilrûk a; nimahsela, Pathian chuan vawiin ang hian mi tam tak nungdama chhan himna tûra thil ṭhaa chantîr a rilrûk zâwk a lo ni si a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichuan, hlau suh u; nangmahni leh in fanau tê tête nên ka châwm zêl ang che u,” a ti a. Chutichuan, a thlamuan a, ṭawngkam ṭha takin a be hlawm a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tin, Josefa chu amah leh a pa chhûngte nên, Aigupta ramah chuan an awm a; Josefa chu kum za leh kum sâwm a dam a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Josefa chuan Ephraima fa, a tute khûp thum a hmu a. Manasea fapa Makira fate pawh Josefa mal chungah an piang a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tin, Josefan a unaute hnênah, “Ka thi dâwn ta e; nimahsela, Pathianin a rawn kan ngei ngei ang che u a, he ram ata hi a rawn hruai chhuakin, Abrahama te, Isaaka te, Jakoba te hnênah chhechhama pêk a tiam ramah a hruai chho vang che u,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tin, Josefa chuan Israela thlahte chu chhia a chhamtîr a, “Pathianin a rawn kan ngei ngei ang che u a, ka ruhte hi heta ta in zâwn chho tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutichuan, Josefa chu kum za leh kum sâwm mi a nihin a thi a; tin, a ruang chu ṭawih thei lovin an siam a, Aigupta ramah kuangah an dah ta a.
  </para>
</usx>
