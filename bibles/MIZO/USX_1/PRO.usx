<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Proverbs</book>
  <para style="h">Proverbs</para>
  <para style="toc1">Proverbs</para>
  <para style="toc2">Proverbs</para>
  <para style="mt">Proverbs</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel lal Davida fapa Solomona thufing:
  </para>
  <para style="p">
    <verse number="2" style="v" />Finna leh zirtîrna hriat theihna tûr te, Hriat thiamna thu ngaihruat dân thiamna te,
  </para>
  <para style="p">
    <verse number="3" style="v" />Felna te, rorêl te, hleih nei lova hmang hre taka zirtîrna pawm dân thiamna te;
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi mâwlte remhriatna neihtîr tûr te, Tlangvâlte hriatna leh ngaihruat thiamna neihtîrna tûr leh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi fingten an hriata, an thiamna te a lo puna, Thil ngai thiam miin rorêlna fingte a man thiamna tûr te,
  </para>
  <para style="p">
    <verse number="6" style="v" />Thufing leh a hrilhfiahna te, mi fing thu leh an thu ril sawite hriat thiamna te chu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa ṭih hi finna bul a ni a; Nimahsela, mi âte chuan finna leh zirtîrna an hmusit ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka fapa, i pa zirtîrna che chu ngaithla la, I nu zirtîrna che chu hawisan suh;
  </para>
  <para style="p">
    <verse number="9" style="v" />I lû atân pârṭhi mawi tak a ni ang a, I nghâwng atân ṭhi ang a ni dâwn si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka fapa, mi sualin an thlêm che chuan zâwm suh.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Hawh teh, thisen chhuah tûrin i châng ang khai, A vâng eng mah awm lovin pawi khawih lote chu i châng ru teh ang;
  </para>
  <para style="p">
    <verse number="12" style="v" />Seol angin a nung chungin i lem teh ang, An puma khuarkhuruma tla angin;
  </para>
  <para style="p">
    <verse number="13" style="v" />Thil hlu tak takte kan nei ang a, Râllâk sumin kan in kan tikhat dâwn nia.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kan zîngah lo tel ve la, Tangka ip kan inṭâwm dâwn nia,” te an tihin,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka fapa, an zîngah chuan tel ve suh la, An kawng ata inthiarfihlîm rawh;
  </para>
  <para style="p">
    <verse number="16" style="v" />An kete chu thil sual lamah a tlân a, Thisen chhuah tûrin an hmanhmawh ruai ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lên chu a lothlâwn maia zâr a ni, Eng sava mit hmuhah pawh;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chûngte chuan anmahni thisen an châng a, An nunna châng ru an ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutiang chu a ni hlâwknaa duhâm apiangte kawng chu; A neitute nun a lâksak ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kawtthlêrah finna chu ring takin a au va, Kawtthlêr ṭhuamahte chuan a aw a chhuah a;
  </para>
  <para style="p">
    <verse number="21" style="v" />Mipui inkhâwmna lai takah a au va, Khawpuiah, khaw luhna kawngkhâr bulah chuan a au chhuak a:
  </para>
  <para style="p">
    <verse number="22" style="v" />“Nangni mi mâwlte u, eng chen nge mâwlna in ngainat dâwn? Eng chen nge hmusittute hmuhsitnaah in hlim anga, Mi âten finna in huat dâwn?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka zilhna che u lamah hian lo hawi rawh u; Ngai teh u, in chungah ka thlarau ka leih ang a, Ka thu ka hriattîr ang che u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka ko che u a, in duh lo va, Ka kut ka phar a, tu mân in ngaisâng lo va;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka remruat zawng zawng chu eng mah lovah in ngai zâwk a, Ka zilhna rêng rêng in pawm duh lo va;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuvângin, kei pawh in vânduai ni chuan ka nui ang a, In hlauh hun a lo thlen chuan ka nuihsan ang che u,
  </para>
  <para style="p">
    <verse number="27" style="v" />In hlauhna thlipui anga a lo thlena, In vânduaina ṭhâwngaleivir anga a lo thlena, Hrehawmna leh manganna in chunga a lo thlen hunin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutichuan, mi ko vang a; nimahsela, ka chhâng lo vang; Zîng takah mi zawng ang a; nimahsela, mi hmu lo vang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hriatna chu an huata, Lalpa ṭihna chu an thlan loh avângin;
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka remruat pakhat tê mah an duh lo va, Ka zilhna zawng zawngte chu an ngainêp a;
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuvângin, anmahni kawng rah chu an ei ang a, Anmahni suangtuahnain an tlai ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi mâwlte hnungtawlhna chuan anmahni a that ang a, Mi âte hlawhtlinnain anmahni a tiboral ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ka thu pawm apiangte erawh chu him takin an awm ang a, Thil ṭha lo hlau lovin an awm hle hle ang.”
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka thute i dawna, Ka thupêkte i khâwl khâwma,
  </para>
  <para style="p">
    <verse number="2" style="v" />Finna lama i beng i chhita, I thinlung hriatna lam atân i pêk chuan;
  </para>
  <para style="p">
    <verse number="3" style="v" />A ni, hriatna i auhva, Hriat thiam theihna pawh i auh chuan;
  </para>
  <para style="p">
    <verse number="4" style="v" />Tangkarua anga i zawna, Ro phûm rûk anga i zawn chuan;
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa ṭih nachâng i lo hria ang a, Pathian hriatna chu i chhar chhuak ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa chuan finna a pe ṭhîn a, A kâ aṭang chuan finna leh hriat thiamna a lo chhuak ṭhîn a ni;
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi tluangte tân finna dik a chhêk khâwm ṭhîn a, Rinawm taka awm ṭhînte tân phaw a ni;
  </para>
  <para style="p">
    <verse number="8" style="v" />Rorêlna kawngte a vêna, A mi thianghlimte kawng a vawn ṭhat theih nân.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, felna leh rorêlna chu i lo hre thiam ang a, Hleih neih lohna nên, a ni, kawng ṭha tinrêng pawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />I thinlungah finna chu a lût ang a, I nunna atân hriatna chu tui tak a ni ang;
  </para>
  <para style="p">
    <verse number="11" style="v" />Remhriatnain a vêng ang chia, Hriat thiamnain a enkawl ang che;
  </para>
  <para style="p">
    <verse number="12" style="v" />Sual kawng ata chhan chhuak tûr che leh, Thil awihawm lo sawi mite laka chhan chhuak tûr chein;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chûngte chuan kawng thima kal tûrin kawng dik chu an kalsan a;
  </para>
  <para style="p">
    <verse number="14" style="v" />Thil tha lo tih chu an lâwm zâwng a ni a, Thil sual bengtla lo mai maiahte an lâwm ṭhîn;
  </para>
  <para style="p">
    <verse number="15" style="v" />An kawngte chu a kawi a, An rin tlâk loh;
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmeichhe sual lakah chuan a chhan ang che, Ram dang mi, kam thluma thlêmtu che lakah;
  </para>
  <para style="p">
    <verse number="17" style="v" />A tleirâwl lai ṭhian kalsana, A Pathian thuthlung theihnghilhtu lak ata chu.
  </para>
  <para style="p">
    <verse number="18" style="v" />A in chuan thihna lam a hawi a, A kawngte chuan mitthi lam.
  </para>
  <para style="p">
    <verse number="19" style="v" />A hnêna kal rêng rêng chu an kîr leh tawh ngai lo va, Nunna kawng an pawh ngai hek lo;
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi ṭha kawng i zawha, Mi fel kawng chu i zawh zêl theih nân.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi tluangte chu leilungah hian an chêng ang a, Ṭha famkimte chu chutah chuan an awm reng ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi suaksualte erawh chu leilung ata tihboral an ni ang a, Vervêk taka titute chu tihboral phiar an ni ang.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka dân chu theihnghilh suh la, I thinlungin ka thupêkte chu zâwm reng zâwk rawh se;
  </para>
  <para style="p">
    <verse number="2" style="v" />Dam ni leh kum te, Thlamuanna te a pêk belhchhah dâwn che nia.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khawngaihna leh thutak chuan hnuchhawn che suh se; I nghâwngah zem tlat la, I thinlung phêkah ziak rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, Pathian leh mihring mit hmuhah, Duhsakna leh hming ṭhatna i hlawh dâwn nia.
  </para>
  <para style="p">
    <verse number="5" style="v" />I thinlung zawng zawngin Lalpa ring la, Nangma hriatnaah innghat suh;
  </para>
  <para style="p">
    <verse number="6" style="v" />I kawng zawng zawngah amah hre reng la, I kawngte chu a kawhhmuh zêl ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mahni ngaihin intifing suh la; Lalpa chu ṭih la, sual kalsan rawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />I lai atân hrisêlna a ni ang a, I ruh atân thlîng a ni ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />I sumin Lalpa chawimawi la, I thil lo pung hmasa ber zawng zawngte nên;
  </para>
  <para style="p">
    <verse number="10" style="v" />Tichuan, i buh in chu a lo khat liam ang a, I sâwrkhur chu uain tharin a luang liam ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka fapa, Lalpa thununna che ngainêp suh la, A zilhhauna che ning hek suh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa chuan a hmangaihte chu a zilhhau ṭhîn a ni, Pain fa a lawm apiangte a zilhhau ṭhîn ang hian.
  </para>
  <para style="p">
    <verse number="13" style="v" />Finna hmu chhuaktu chu a nihlawh a, Hriat thiamna hmu chhuaktu pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tangkaraw peipun aiin a peipun chu a ṭha zâwk si a, A hlêp pawh rangkachak ṭha mi aiin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lunghlu sen mi aiin a hlû a; Thil i duhthusâm theih ang zawng zawng pawhin a hen lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kut ding lamah dam reina a awm a, A kut vei lamah sum leh ropuina.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kawngte chu nunkhaw nawmna kawng a ni a, A kawng zawng zawng chu thlamuanna a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />A vuan apiangte tân nunna thing a ni a, A kawl reng apiangte chu an hamṭha e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa chuan finnain leilung a din a, Hriatnain vânte a tinghet a;
  </para>
  <para style="p">
    <verse number="20" style="v" />A thiamnain tuifinriatte a sah a, Chhûmte chuan dai a fartîr a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka fapa, i mit ata kiantîr suh la, Finna leh ngaihruat thiamna dik tak chu vawng tlat rawh;
  </para>
  <para style="p">
    <verse number="22" style="v" />I nunna atân nunna a ni ang a, I nghâwng atân khawngaihna.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tichuan, i kawngah him takin i kal ang a, I ke chu a petek lo vang.
  </para>
  <para style="p">
    <verse number="24" style="v" />I mut hunin i hlau lo vang a, A ni, i mu ang a, tui takin i muhîl ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hlauhna lo awm thutte chu hlau suh la, Mi suaksualte chunga ṭiauna a lo thlenin hlau hek suh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa chu i himna a ni si a, I ke chu âwk lo tûrin a vêng dâwn a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />A phute tân ṭhatna ui suh, I kutah tih theihna a awm phawt si chuan.
  </para>
  <para style="p">
    <verse number="28" style="v" />I ṭhenawm hnênah, “Kal leh ta rih la, lo kal leh rawh, Naktûkah ka pe ang che,” ti suh, I kawl reng si chuan.
  </para>
  <para style="p">
    <verse number="29" style="v" />I ṭhenawm chungah thil ṭha lo suangtuah suh, Ngaihngam takin i kiangah a awm tih hre siin.
  </para>
  <para style="p">
    <verse number="30" style="v" />A vâng awm lovin mi sual mai suh, I pawi eng mah a khawih loh chuan.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi nunrâwng awt suh la, A kawng a enga mah thlang suh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kawhmawh bâwl chîng chu Lalpa ngaihin tenawm an ni si a; Mi ṭha famkim erawh chu a ṭhian an ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpa ânchhia chu mi suaksual inah a awm a, Mi felte chênna erawh chu mal a sâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mi hmusittute chu a hmusit ṭhîn a, Inngaitlâwmte erawh chu khawngaihna a pe ṭhîn.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi fing chuan ropuina an rochung ang a, Mi âte kaisânna erawh chu mualphona a ni ang.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapate u, pa zirtîrna chu ngaithla ula, Hriat thiamna chu hre tûrin ngaithla rawh u;
  </para>
  <para style="p">
    <verse number="2" style="v" />Zirtîrna ṭha tak ka fah si che u a; Ka zirtîrna hi hawisan suh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka pa fapa ka ni a, Ka nu fa, fapa mal duata duat ka ni a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi zirtîr a, ka hnênah, “I thinlung chuan ka thute hi vawng reng sela; Ka thupêkte hi zâwm la, nung rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Finna nei la, hriat thiamna nei rawh; Theihnghilh suh la, Ka kâa thuchhuakte hi chhiat lam pansan suh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hawisan suh la, a humhim ang che; Hmangaih la, a vêng ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Finna hi thupui ber a ni a; Chuvângin, finna hi nei rawh; A ni, i thil neih zawng zawng chân pawhin finna hi nei rawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chawimawi la, anin a chawisâng ang che; I lawm chuan zahawmah a siam ang che,
  </para>
  <para style="p">
    <verse number="9" style="v" />Khawngaihna lukhum i lû a khumtîr ang a, Mawina lallukhum a pe ang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw ka fapa, ka thu ngaithla la, pawm rawh; Tichuan, i dam chhûng kum a lo tam ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Finna kawng ka zirtîr chia, Ṭhatna kawngah ka hruai chia.
  </para>
  <para style="p">
    <verse number="12" style="v" />I kal laiin i pheichheh a zâng ang a; I tlân pawhin i petek lo vang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zirtîrna chu vuan tlat la, chhuah suh; Vawng tlat rawh, i nunna a ni si a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi suaksual kawngah chuan lût suh la, Mi sual kawngah chuan kal suh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pumpelh la, a kiangah kal suh; Hawisan la, kal zêl rawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pawi an khawih phawt loh chuan an mu ngai lo va, Tute emaw tal chhiatna an thlensak loh chuan an mut a chhuak thei lo.
  </para>
  <para style="p">
    <verse number="17" style="v" />Suahsualna chhang an ei a, Nunrâwnna uain an in ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi felte kawng erawh chu zîng khawvâr êng tir, chhûn vânglai thlenga êng zual zel ang hi a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi suaksualte kawng chu a thim a, Eng nge an chhuih an hre lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa, ka thu ngaithla la, Ka thusawiah i beng dawh rawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />I mit hmuh ata chhuahtîr suh, I thinlung lai takah pai rawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hmutute tân nunna a ni a, An tisa zawng zawng tân hrisêlna a ni si a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thil dang ber aiin i thinlung vêng ṭha rawh, Nunna lo chhuahna a ni si a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ṭawng chaltlai bânsan la, Mi bum chîng suh.
  </para>
  <para style="p">
    <verse number="25" style="v" />I mitin hma lam en la, Ngîl takin hma lam thlîr rawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />I ke tân kawng tirualrem la, I kawng zawng zawng tihngheh ni rawh se.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ding lamah emaw, vei lamah emaw pêng suh; Sual ata i ke sawn rawh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka finna ngaithla la, Ka hriatnaah i beng dawh rawh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngaihruat thiamna i vawna, I leiin hriatna a vawn theih nân.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hmeichhe sual hmui ata khawizû a far a, A hmui chu hriak aiin a nâl si;
  </para>
  <para style="p">
    <verse number="4" style="v" />A tâwpna erawh chu sai angin a khâ a, Khandaih hriam tawn angin a hriam.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ke chu thihnaah a chhuk a, A ke pênin Seol lam a pan.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichuan, nunna kawng rualrem a hmu lo va, A kawngte chu a nghet lo va, a hre si lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuvângin, ka fapate u, ka thu ngaithla ula, Ka kâa thu hi hawisan teh suh u khai.
  </para>
  <para style="p">
    <verse number="8" style="v" />I kawng chu a hnên ata sawn daih la, A kawngka va hnaih suh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuti lo chuan, i ropuina chu mi dang a pe ang a, I kumte chu mi nun chhia i pe dah ang a,
  </para>
  <para style="p">
    <verse number="10" style="v" />Ramdangmite chu i thahruiin i titlai ang a, I thawhrimna chu hmêlhriat loh inah a awm dah ang e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tin, i tisa leh i taksa a ral hunin, I hun tâwp lamah chuan i ṭap ang a,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Engtiziaa zirtîrna chu ka lo huata, Ka thinlungin zilhhauna chu lo ngainêp nge maw ni aw?
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi zirtîrtu thu lah ka lo âwih ta hek lo va, Mi zirtîrtute chungah ka beng ka lo dawh ta bawk hek lo;
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipuite leh pung khâwmho zîngah chuan, Ka lo thih teuh hle chu le!” i la ti ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />I tuibêl ata tui in la, I tuichhunchhuaha tui tharlâm chu.
  </para>
  <para style="p">
    <verse number="16" style="v" />I tuihnate chu ram tina luang darhin, Kawtthlêrah te lui tui a luang dâwn em ni?
  </para>
  <para style="p">
    <verse number="17" style="v" />I tân chauh ni sela, Ramdangmite ṭâwmpui lohvin.
  </para>
  <para style="p">
    <verse number="18" style="v" />I tuichhunchhuah chu malsâwmin awm sela, I tleirâwl lai nupuiah chuan hlim rawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zukpui duhawm tak leh zukchal nalh tak angin, Eng lai pawhin a ṭâng chhûng chuan tilungawi fo che sela, A hmangaihnaah chuan lâwm fo rawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Eng atân nge, nang, ka fapa chuan hmeichhe sual i lawm anga, A ṭâng i pawm ang?
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihring kawngte chu Lalpa mit hmuhah a awm a, A kawng zawng zawng a tihrualremsak ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama khawlohna ngeiin mi suaksual chu a man ang a, A sualna hruizêna thlunin a awm ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zirtîrna tlâkchham vângin a thi ang a, A ât êm avângin a bo vang.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, i ṭhenawm tâna mawhphurtua i lo ṭana, Ramdangmi vuak nâna i kut i hman chuan,
  </para>
  <para style="p">
    <verse number="2" style="v" />I ṭawngka chhuakah i âwk a, I ṭawngka chhuakin a man che a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka fapa, i ṭhenawm kutah i awm tih inhriain hei hi ti la, intichhuak rawh; Kal la, intihnuai la, i ṭhenawm chu luh ngut ngut rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />I mit chu muthilhtîr suh la, I mit vun mutthlûktîr hek suh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sa pêltu laka sakhi a tlân chhuak ang leh, Sava vehtu laka sava a thlâwk chhuak angin intichhuak rawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang, thatchhepa, fanghmîr tih dânte chhût la, fing rawh;
  </para>
  <para style="p">
    <verse number="7" style="v" />Anni chuan lal te, hotu te, rorêltu te nei lovin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nipuiah chaw an chhêk khâwm a, A seng hunin an ei tûrte an sêng khâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw, thatchhepa, eng chen nge i mut dâwn? Eng tikah nge i muhîl chu i thawh dâwn?
  </para>
  <para style="p">
    <verse number="10" style="v" />I duh chuan mu hlek la, chhîng hlek rawh, Kut kuangkuahin châwl hlek teh;
  </para>
  <para style="p">
    <verse number="11" style="v" />I mut hlânin i rethei hman ang a, Tlâkchhamnain sipai angin a rawn nang thut ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi tlâktlai lo, mi khawlo chu, Ṭawng chaltlai nên a vâk vêl a;
  </para>
  <para style="p">
    <verse number="13" style="v" />A mit a siai a, a kein thu a sawi a, A kut zungṭangin a zaizir ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />A thinlungah luhlulna a awm a, thil sual a suangtuah reng a, Inrem lohna a tuh ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuvângin, a chhiatna a lo thleng thut ang a, Vawi leh khatah tihchhiatin a awm ang a, tihṭhat leh theih tawh lohvin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil paruk Lalpan a huat ṭhin a awm a, A ni, pasarih a ten zâwng tak a awm:
  </para>
  <para style="p">
    <verse number="17" style="v" />Mit chapo te, lei dawthei te, Pawi khawih lo thisen chhuahna kut te,
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil ṭha lo suangtuah ṭhîn thinlung te, Pawi khawih tûra ngal chak te,
  </para>
  <para style="p">
    <verse number="19" style="v" />Hretu der dâwt sawi ṭhîn te, Unau kâra inrem lohna tuhtute hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa, i pa thupêk chu zâwm la, I nu zirtîrna chu hawisan suh.
  </para>
  <para style="p">
    <verse number="21" style="v" />I thinlungah thlung reng la, I nghâwngah awrh rawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />I vah vêlin a hruai ang chia, I mut hunin a vêng ang chia, I thawh hunin a bia ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thupêk chu khâwnvâr a ni a, dân chu êng a ni si a; Tin, zirtîrnain a zilhhauna chu nunna kawng a ni;
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmeichhe khawlo lakah leh, Hmeichhe sual kam thlum laka vêng tûr chein.
  </para>
  <para style="p">
    <verse number="25" style="v" />I thinlungin a mawina ît suh la, A men novin hîp che suh se.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nawhchizuarnu avângin pa chhang themah a chang a, Uirenu chuan nunna hlu tak a zawng ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Miin a puan kâng lovin mei a pawm thei em ni?
  </para>
  <para style="p">
    <verse number="28" style="v" />Miin a ke kâng lovin meiling a rap thei em ni?
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutichuan, mi a ṭhenawm nupui hnêna kala, Tu pawh amah va khawih chu hrem lohvin a chhuak lo vang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Miin a rilṭâm tihreh nâna rûk a rûk chuan an hmusit ṭhîn lo va;
  </para>
  <para style="p">
    <verse number="31" style="v" />Nimahsela, an hmuh chhuah chuan a leh sarihin a rûl ang; A ina a sum zawng zawng a pe ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi nu uiretu chuan hriatna a nei lo a ni, Ama nunna tichhe tûr thil a ti a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hliam a tuarin a hminghliau vang a, A hming a chhe hlen bawk ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thîkthuchhiatna chu mipa thinrimna a ni a, Phuba lâk ni chuan a zuah lo vang.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tlanna chu engah mah a ngai lo vang a; Thilpêk tam tak pe mah la, a lung a awi chuang lo vang.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka thu pawm la, Ka thupêkte khâwl khâwm rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka thupêkte zâwm la, nungdamin awm rawh; Ka dân chu mitnautê angin vawng rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />I zungṭangah bun la, I thinlung phêkah ziak rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Finna hnênah chuan, “Ka farnu i ni,” ti la, Hriatna chu i laichînnu vuah rawh;
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmeichhe sual lakah vênga, Hmeichhe khawlo thlêmna laka vêng tûr chein.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka ina tukverh zâwngdaikalh âwng aṭang chuan ka han thlîr a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi mâwl tlangvâl zîngah chuan, Tlangvâl hriatna nei lo ka hmu a,
  </para>
  <para style="p">
    <verse number="8" style="v" />A awmna lam hnaih kawtthlêrah chuan a kal ṭan a, A in lam a pan ta a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Tlai lam thimhmulah, zân thim, thim tak hnuaiah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai teh, nawhchizuar anga inthuam leh fin vervêk rilru pu hmeichhiain a tâwk a.
  </para>
  <para style="p">
    <verse number="11" style="v" />A awm hle hle thei lo va, a tum a ruh a, A ke chuan a ina awm a duh lo va,
  </para>
  <para style="p">
    <verse number="12" style="v" />Kawtthlêrah te, pêng ṭhuam laiah te a awm a, Kil tin kil tangah a châng ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutichuan, a man a, a fâwp a, Tlângnêl tak hmêl puin a hnênah,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Remna thilhlan inthawinate ka hlân tûr a ni a, Vawiinah ka thutiam ka hlen ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuvângin, nangmah tawh tum chein ka lo kal a ni, Ngun taka zawn tum chein; tin, ka hmu ta chia.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka khumah âwngphah mawi tak ka phah a, Aigupta ram lazaia ṭial.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka khum chu beraw te, aloe te, thakthîngtein ka tirimtui a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hawh teh, zankhuain hmangaihna duhtâwkin i chên ang khai, Hmangaihnain inhnêm ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />In neitupa lah a awm si lo, Hla takah a zin a;
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangka ip a keng a, Thla hlei nga hunah a lo haw dâwn a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ṭawngkam thiamin a thlêm thlu a, A infak mawinain a hruai bo ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />A zui ta nghâl mai a, Bâwng, a talhna hmuna a kal ang leh, Mi â tihfin tûra kawl bun tûra a kal ang leh,
  </para>
  <para style="p">
    <verse number="23" style="v" />Savain a thihna tûr a ni tih hre lova, Thalin a thin a dawh tlang thlenga thang lam a pan angin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuvângin, ka fapate u, ka thu hi ngaithla ula, Ka kâa thuchhuakte hi pawm rawh u.
  </para>
  <para style="p">
    <verse number="25" style="v" />I thinlungin a kawngte chu âwn suh sela, A kawngahte chuan kal bo suh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi tam tak a hliam a, A ni, a thahte chu tam tak an ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />A in chu Seol kawng a ni a, Thihna pindan a zuk chhun a.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Finna chu a auvin, Hriatna chuan a aw a chhuah lo vem ni?
  </para>
  <para style="p">
    <verse number="2" style="v" />Kawng sîr hmun sâng chungahte, Kawng pêng ṭhuamahte a ding ṭhîn a;
  </para>
  <para style="p">
    <verse number="3" style="v" />Khaw tawntirh kawngkaah, Khaw luhna kawngka bulah te ring takin a au va:
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw, nangni mihringte u, Ka auh che u hi, Ka aw chu mihring fate tân a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw, nangni mi mâwlte u, Remhriatna hi lo hre thiam teh u; Nangni mi âte u, finna thinlung nei mi lo ni rawh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngaithla rawh u, thil ṭha tak mai ka sawi dâwn a ni, Ka thusawite chu thil dik hlîr a ni ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka kâ chuan thutak a sawi chhuak ang a; Suahsualna chu ka hmui tân thil tenawm a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka kâa thu zawng zawngte chu a fel vêl vek a ni, Thu kawi leh bengtla lo rêng rêng a awm lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hre thiamte tân a fiah vek a, Finna hmutute tân a dik vek a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka zirtîrnate dawng rawh u, tangkarua te ni lovin; Tin, finna chu rangkachak duhawm mi ai pawhin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Finna chu lunghlu sen mi aiin a ṭha zâwk si a; Duhthusâm theih thil zawng zawng pawh a hen zo a awm lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei, finna chuan ka chên nân remhriatna ka siam a, Finna leh ngaihruat thiamna ka hre chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa ṭih chu sual huat hi a ni; Chapona te, uanthuanna te, thil ṭha lo tih chîn te, Ṭawng chaltlai te hi ka haw tak zet a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Remruat leh hriatna dik hi ka ta a ni a; Hriat thiamna ka ni a, chak tak ka ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei mi hmangin lalin ro an rêl a, Hotuten rorêlna felin thu an titlu ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kei mi hmangin hotuten ro an rêl a, Mi lian te, leilunga rorêltute zawng zawng pawhin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi hmangaihtu chu ka hmangaih a, Ṭhahnemngai taka mi zawngtute chuan mi hmu ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sum leh ropuinate ka hnênah a awm a, A ni, sum leh felna tlo tak mai chu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka rah chhuah chu rangkachak aiin a ṭha zâwk a, A ni, rangkachak ṭha mi ai pawhin; Ka lâk luh chu tangkaraw ṭha mi aiin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Felna kawng ka zawh a, Rorêlna kawng takah;
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi hmangaihtute chu sum ka rochuntîr theih nân leh, An ro bâwmte ka tihkhah theih nân.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa chuan a thilsiam bul berah mi din a, Hmasânga a thilsiam bul berah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chatuan ata, a tîr têa din ka ni, Leilung awm hma rêngin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuifinriat la awm hma daihin ka piang tawh a, Tuikhur tui tam tak la awm hma daihin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tlâng liante an din hma leh, Tlâng tête awm hmain ka piang tawh a;
  </para>
  <para style="p">
    <verse number="26" style="v" />Leilung a la din hma leh ram te a din hma, Khawvêla vaivut pawh a la awm ṭan hma daihin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vânte a tihngheh laiin ka awm tawh a, Tuifinriat chunga kal hualna a siam laiin,
  </para>
  <para style="p">
    <verse number="28" style="v" />Chung lam vân a tihngheh laiin, Tuifinriat a lo ngheh laiin;
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuite chuan a thupêk an bawhchhiat lohna tûra tuifinriat rite a siamsaka, Leilung nghahchhan a ruat lai khân.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutih lai chuan mi themthiam angin a kiangah ka awm a; Ni tin a lâwmna ka ni a, A bulah ka hlim êm êm bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chên theihna leilungah hlim taka awmin, Ka lâwmna chu mihring fate chungah a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Khai le, ka fapate u, ka thu ngaithla rawh u, Ka kawng zawhtute chu mi nihlawh an ni si a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zirtîrna chu ngaithla ula, fing ula, Duh lo suh u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka kawngka bula nghâka, Ka kawt hungna kawngkâa ni tin nghâk renga, Ka thu ngaithlatu chu a eng a thâwl e.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi hmu apiang chuan nunna a hmu a ni si a, Lalpa duhsakna a dawng ang.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amaherawhchu, ka chunga sual apiang chuan ama nunna a tikhawlo va; Mi hua apiang chuan thihna an duh a ni.”
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Finna chuan a in a sa a, A ban pasarih a phun a;
  </para>
  <para style="p">
    <verse number="2" style="v" />A rante a talh a, a uain te a chawhpawlh a, A dawhkânah pawh ei tûr a hlui a.
  </para>
  <para style="p">
    <verse number="3" style="v" />A nulate a tîr chhuak a, Khuaa hmun sâng ber berah a au va,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Mi mâwl apiang chu he lamah hian lo kal rawh se,” tiin. Tin, hriatna nei lote chu,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Lo kal ula, ka chhang ei ula, Ka uain chawhpawlh chu in rawh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw, nangni mi mâwlte u, âtna kawng chu chhuahsan ula, nung rawh u; Tin, hriatna kawngah chuan kal rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmuhsit chîng zilhtu chuan tihtauh khumna a tâwk ṭhîn a, Mi suaksual zilhtu chuan kut tuarna a insiam ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmuhsit chîng mi chu zilh suh, a haw dah ang che; Mi fing zilh la, a hmangaih ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi fing zilh la, a fing lehzual sauh dâwn nia; Mi fel zirtîr la, thiamnaah a lo pung dâwn nia.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa ṭih hi finna bul a ni a. Mi Thianghlima hriatna hi hriat thiamna a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keimahin i nite chu tihpun a ni ang a, I dam chhûng kumte chu a pung ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />I lo fin chuan, i tâna fing i lo ni ang, Hmusittu i nih chuan nangmah chauhvin i tuar ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmeichhe â chu a awm hle hle thei lo va, A mâwl a, eng mah a hre lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kawngkâah a ṭhu ṭhîn a, Khuaa hmun sângtea ṭhuphahah chuan;
  </para>
  <para style="p">
    <verse number="15" style="v" />Kawnga lo kal apiangte chu,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Mi mâwl apiangte chu he lamah lo kal rawh u,” tia ko tûrin; Tin, hriatna nei lote hnênah chuan,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Rûk tui chu a thlum a, A rûka chhang ei chu a tui a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nimahsela, chutah chuan mitthi an awm tih leh, A mi sâwmte chu Seol rila awm an nih a hre lo.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Solomona thufing. Fapa fingin pa lâwm a siam a, Fapa â erawh chu nu rihna a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Suahsualna ro chuan hlâwkna a nei lo va, Felna erawh chuan thihna ata a chhan chhuak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa chuan mi fel nunna chu rilṭâm a phal lo vang a, Mi suaksualte duhthusâm erawh chu a paih bosak ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kut dâwngdah chuan retheihna a thlen ṭhîn a, Mi taima kut erawh chuan hausakna a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Buh seng laia inchhêk khâwl chu fapa fing a ni a; A seng hun laia muhîl erawh chu fapa, Mualphona thlen ṭhîntu a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi fel lûah chuan malsâwmnate a awm a, Mi suaksual ka erawh chu nunrâwnnain a tuam.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi fel hriat rengna chu malsâwmna a ni a, Mi suaksual hming erawh chu a ṭawih ral ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi fing chuan thinlungin thupêkte a dawng ṭhîn a, Mi â kamtam erawh chu a tlu ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngîl taka kal chu muanawm takin a kal ṭhîn a, A kawng tikhawlotu erawh chu hriat chhuahin a awm ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mit siaitu chuan lungngaihna a thlen a, Mi â kamtam chu a tlu ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi fel kâ chu nunna tuikhur a ni a, Mi suaksual kâ erawh chu nunrâwnnain a tuam;
  </para>
  <para style="p">
    <verse number="12" style="v" />Huatnain inhauna a chawk chhuak a, Hmangaihna erawh chuan bawhchhiatna zawng zawng a khuh ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngaihruat dik thiam mi kâah chuan finna hmuh a ni a; Amaherawhchu, hriat thiamna nei lo mi hnungzâng atân tiang a awm.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi fingte chuan hriatna an khâwl khâwm a; Mi a kâ erawh chu boral hnaih rengna a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi hausa sum chu a khawpui nghet a ni a; Mi rethei boralna chu an pachhiatna a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi fel thawhrimna chuan nunna a thlen a, Mi suaksual hlâwkna chuan sualna.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thununna pawm chu nunna kawngah a awm a, Zilhhauna hawisantu erawh chuan a tisual ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huatna zêptu chu hmui dawthei nei mi a ni a, Mi rêlna thu chhâk chhuak mi chu mi â a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thu tam takah chuan bawhchhiatna a awm ṭhîn a, A ka sûm thei mi erawh chuan fing takin a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi fel lei chu tangkaraw ṭha mi ang a ni a, Mi suaksual thinlung erawh chu eng hû mah a ni lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi fel kâ chuan mi tam tak a châwm a, Mi â erawh chu hriat thiamna tlachhamin a thi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa malsâwmna chuan a tihausa ṭhîn a, Lungngaihna a belhchhah ṭhîn lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi â tân chuan thil sual tih hi nuamsip bâwlna ang a ni a, Chutiang bawk chuan hriat thiamna nei mi tân chuan finna chu a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi suaksual chu, a hlauh ang ngeiin a chungah a lo thleng ang; Mi fel duhthusâm chu pêk a ni ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ṭhâwngaleivir a lo virin mi suaksual chu a boral a, Mi fel erawh chu chatuan lungphûm a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ha tân uain thûr leh mit tân meikhu angin, Mi thatchhia chu a tîrtu tân a ni ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lalpa ṭihna chuan dam chhûng ni a tisei a; Nimahsela, mi suaksual kumte chu tihtawi a ni ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi fel nghahfâk chu lâwmna a ni ang a, Mi suaksual hmachhuan erawh chu a boral ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi dik tak tân Lalpa kawng chu kulhbîng a ni ang a, Thil ṭha lo titu tân erawh chuan boralna a ni ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi felte chu tihsawnin an awm lo vang a, Mi suaksualte erawh chu leilungah an awm lo vang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi fel ka chuan finna a chhâk chhuak a, Ṭawng chaltlai lei erawh chu tan chhum a ni ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi fel kâ chuan pawm tlâk chu a hria a, Mi suaksual kâ erawh chu chaltlai takin a ṭawng chhuak ṭhîn.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bûkna dik lo hi Lalpa mit hmuhin thil tenawm a ni a, Khîn dik chiah erawh chu a lâwm zâwng a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chapona a lo awmin mualphona a lo awm a, Inngaitlâwmte hnênah chuan finna a awm.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi fel rilru ṭhatna chuan anmahni a hruai ang a, Mi vervêkte luhlulna erawh chuan anmahni a tiboral ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thinur ni chuan sum leh paiin ṭangkaina a nei lo vang a, Felna erawh chuan thihna ata a chhan chhuak ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi ṭha famkim felna chuan kawng a kawhhmuh ang a; Mi suaksual erawh chu ama suahsualnain a titlu ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi dik tak felna chuan anmahni a chhan chhuak ang a, Vervêk taka titute erawh chu anmahni pawi khawihna ngeia manin an awm ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi suaksual chu a thihin a hmachhuan chu a boral ang a, Thil ṭha lo titute nghahfâk chu a boral ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi fel chu manganna ata chhuahin a awm a, Mi suaksualin a hmun chu a luah thung a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian ngaihsak lo mi chuan a kâin a ṭhenawmte a tiboral a, Mi fel erawh chu hriatna avângin chhan chhuahin a awm ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi felte chunga thil a tluan laiin khua a hlim a, Mi suaksualte an thihin au dur durna a awm ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi felte malsâwmnain khua chawimawiin a awm a, Mi suaksualte ka erawh chuan a tichhia.
  </para>
  <para style="p">
    <verse number="12" style="v" />A ṭhenawm hmusittu chuan finna a nei lo va, Hriatna nei mi erawh chu a ngawi ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi kamtam tei ruai mi chuan thurûkte a tilang a, Mi rilru rinawm nei mi chuan thil a thup ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Inhruaina fing awm lohnaah chuan mite an tlu ṭhîn a, Remruat thiam tamnaah himna a awm.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tu pawh ram dang mi tâna mawhphurtua insiam chuan lungngaihna a insiam ang a, Mawhphurtua insiam hawtu erawh chuan ngaihngam taka awmna a nei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmeichhe ṭha chuan zahawmna a chang ang a, Pâwng lâk chîng mi chuan sum a chang ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zahngai thei mi chuan ama nunna atâna ṭha a ti ṭhîn a, Mi nunrâwng erawh chuan ama tisa buaina a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi suaksual chuan bumna hlawh a dawng ṭhîn a, Felna tuhtu erawh chuan a tak tak hlawh a dawng ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Felnaa nghet taka ding mi chuan nunna a chang ang a, Thil sual ûmtu chuan ama thihna.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi rilru bawlhhlawhte chu Lalpa tâna tenawm an ni a, An kawnga mi fel famkimte erawh chu a lâwm zâwng an ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Inthurual mah sela, mi suaksualte chu hrem lohvin an chhuak lo vang a, Mi fel thlahte erawh chu chhan chhuahin an awm ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmeichhe hmêl ṭha, ngaihruat thiamna nei lo chu, Vawk hnâra rangkachak khâng vuah ang a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi fel duhthusâm chu thil ṭha chauh a ni a, Mi suaksual hmachhuan erawh chu thinurna a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sem darh chu pun lehzualna a ni a, Mamawh tâwk aliam kawmpui chu tlâkranna a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi thilphal nunna chu tihthauvin a awm a, Tui leih ṭhîntu chuan mahni pawh a inleih a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Buh kawmpuitu chu miin ânchhia an lawh ang a, A zuartu lû chungah erawh chuan malsâwmna a awm ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ṭhahnemngai taka ṭhatna zawngtu chuan duhsakna a zawng a ni a; Pawi khawih tûr zawngtu erawh chu, ama chungah a thleng ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />A sum ring mi chu a vuai ang a, Mi fel erawh chu hnim angin a duah ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mahni chhûngkua tibuaitu chuan thli a rochung ang a, Mi â chu mi thinlung fing chhiahhlawhah a awm ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi fel rah chu nunna thing a ni a, Mi fing chuan mi rilru a hneh ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ngai teh, mi fel mah leiah hian thungrulh an nih chuan, Mi suaksual leh thil tisualtu chu eng ang taka nasa lehzual ni ang maw!
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thununna ngaina mi chuan hriatna a ngaina ṭhîn a, Zilhhauna haw mi erawh chu ramsa ang mai a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi ṭha chuan Lalpa duhsakna a hlawh ang a, Suahsualna rilru pu mi erawh chu thiam loh a chantîr ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihring chu suahsualnain tihngheh a ni lo vang a; Amaherawhchu, mi fel dinhmun chu a nghîng lo vang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmeichhe khawsak ṭha chu a pasal tân lallukhum a ni a, Zahpuiawm tak thil ti erawh chu a ruh timawihtu a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi fel ngaihtuahnate chu a fel a, Mi suaksualte remruat erawh chu bumna a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi suaksual ṭawngkam chu thisen chhuah tûra chânna a ni a, Mi dik tak ka erawh chuan anmahni a chhan chhuak ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi suaksualte chu paih thlâkin an awm a, an bo ṭhîn a, Mi fel chhûng erawh chu an awm reng ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi a fin dân ang zêla fakin a awm ang a, Mi luhlul erawh chu hmuhsit a ni ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mahni inngaihlu, chhang pawh nei si lo ai chuan, Tu ma ngaihsân loh, chhiahhlawh nei chu a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi fel chuan a ran nunna a engto va; Nimahsela, mi suaksual zahngaihna nêm ber pawh hi a râwng a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />A lei lettu chuan chhang a ngah ang a; Nimahsela, mi lêlo tih dân zâwmtu chu finna nei lo mi a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi suaksualte chuan mi ṭha lote lên an duh a, Mi felte bul erawh chuan rah a chhuah ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi sual chu ama hmuia chhuak ngeiin a âwk ṭhîn a, Mi felte erawh chuan buaina an pumpelh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miin a ṭawngkam chhuak rah chu a seng ang a, Ama kut thiltih ngei chu a hnênah hlan a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi a kawng chu ama mitah chuan a dik a, Mi fing erawh chuan rorêl a ngaichâng ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi a buaina chu a lang nghâl a, Mi fing erawh chuan mualphona a thup ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thu dik sawi chuan felna a entîr a, Hretu dik lo erawh chuan bumna.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khandaih chhun anga na taka mi chhun thu sawi an awm a, Mi fing lei erawh chu damna a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thutak hmui chu kumkhuain tihngheh a ni ang a, Lei dawthei erawh chu rei lo tê atân chauh a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thil ṭha lo suangtuahtute thinlungah chuan bumna a awm a, Remna rorêltute pawh chuan lâwmna an nei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi felte chungah chuan pawi khawihna a thleng lo vang a, Mi suaksualte erawh chu thil ṭha lovin an khat ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmui dawthei hi Lalpa ten zâwng tak a ni a, Dik taka titute erawh chu a lâwm zâwng an ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi fing chuan finna a thup a, Mi â thinlung erawh chuan âtna a puang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi taima kut chuan rorêlna a keng ang a, Mi thatchhia erawh chu hna rim tak thawk tûra tih a ni ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lungkham neih hian mi a tihrehawm a, Thu ṭha erawh chuan mi a tilâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi fel chu a ṭhenawm tân hruaitu a ni a, Mi suaksualte kawng erawh chuan bona a thlensak ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi thatchhia chuan ramvâka a kah rawh tûr a nei lo; Mihring sum hlû chu taihmâk a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Felna kawngah chuan nunna a awm a, Chumi kawngah chuan thihna a awm lo.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Fapa fing chuan a pa thununna a pawisa ṭhîn a, Hmuhsit chîng mi erawh chuan zilhhauna a ngaithla duh ṭhîn lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi ṭha chuan a kâa thuchhuak rah a dawng a, Bum hmangte duh zâwng erawh chu tharum thawh a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kâ vêng ṭha chuan a nunna a vêng ṭha a ni a, A kâ zau taka âng erawh chuan boralna a chang ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thatchhe rilru chuan thil a duh ṭhîn a, Nimahsela, eng mah a nei chuang lo va; Mi taima rilru erawh chu tihtlai a ni ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi fel chuan dâwt a hua a, Mi suaksual erawh chu a tenawm a, mualphona a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Felna chuan dik taka awmte chu a vêng ṭhîn a, Suahsualna erawh chuan mi sual a theh thlu ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hausaa inngai eng mah nei lo an awm a, Retheia inngai hausa hle si an awm.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi hausa chuan intlanna a nei a, Mi rethei erawh chuan a nei ve lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi fel êng chu a êng ṭha hle a, Mi suaksual khawnvâr erawh chu tihmih a ni ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chapona chuan inhauna mai a tichhuak a, Thunun ṭhat mi hnênah erawh chuan finna a awm.
  </para>
  <para style="p">
    <verse number="11" style="v" />Eng mah lo mai maia sum deh chhuah chu tihrîral a ni ang a; Thawh rima khâwl erawh chu a pung ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Beiseina tihkhawtlai hian thinlung a tina a, Duhthusâm lo thleng erawh chu nunna thing a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thu chu ngainêp apiang chuan boralna an inthlen ang a, Thupêk ṭih apiang erawh chu lâwmman pêk a ni ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi fingte zirtîrna chu nunna tuikhur a ni, Thihna thang hawisanna tûrin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hriatna ṭha chuan duhsakna a dawntîr a, Mi vervêk kawng erawh chu a bumboh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Remhria zawng zawngin finnain an thawk a, Mi â erawh chuan âtna a zâr darh ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zualko suaksual chu thil sualah a tlu lût ṭhîn a, Palai rinawm chu damna a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thununna duh lotu chungah chuan pachhiatna leh mualphona a thleng ang a, Zilhhauna ngaisângtu erawh chu chawimawi a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Duhthusâm puitlina a lo awm chu rilru tân a thlum a; Mi âte tân chuan sual kalsan hi thil tenawm a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi fing pâwl la, i lo fing ang a, Mi â pâwl erawh chu hrehawm tuar phahna a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi sual chu thil sualin a zui zêl ṭhîn a, Mi fel erawh chu thil ṭhaa thungrulh a ni ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi ṭha chuan a tute thlenga rochun tûr a hnutchhiah ṭhîn a, Mi sual sum erawh chu mi fel tân khâwl khâwm a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi rethei lei lehah chuan chaw tam tak a awm a; Nimahsela, rorêl dik lo awmna chu tihchhiatin a awm ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tiang hmang duh lo chuan a fa a hua a ni, A hmangaihtu erawh chuan a thunun chawt ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi fel chuan a rilru tihtlai nân a ei ṭhîn a, Mi suaksual pum erawh chuan a tlachham ang.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hmeichhe fing zawng zawngin in an sa a, A â erawh chuan anmahni kut ngeiin an ṭhiat ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dik taka awm mi chuan Lalpa a ṭih a, Mi tihmawh erawh chuan a hmusit a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi a kâah chuan chapona tiang a awm a, Mi fingte kâ erawh chuan anmahni a hum ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bâwngpa awm lohnaah chuan bâwng chaw dahna a fai ṭhîn a; Amaherawhchu, pun hle-na chu bâwngpa thahruiah a awm.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hretu dik chu a daw lo vang a, Hretu dik lo erawh chuan dâwt a phuh chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmuhsit chîng mi chuan finna a zawng a, a hmu ṭhîn lo va; Hriat thiamna neitu tân erawh chuan finna hi awlsam tak a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi a hnên ata chu kal chhuak rawh, Amahah chuan hriatna ka i hmu lo vang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Remhre finna chu mahni awm dân hriat hi a ni a, Mi âte âtna erawh chu bumna a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi âte chuan thiam loh channa hi an ngai lêlo va, Mi dik zîngah erawh chuan duhsakna ṭha a awm,
  </para>
  <para style="p">
    <verse number="10" style="v" />Mahni lungngaihna chu amah chauhvin a hria a, A lâwmna pawh mi dangin an hriatpui lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi suaksual in chu tihchhiat a ni ang a, Mi dik puan in erawh chu a vul ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi ngaiha kawng dik ni âwm taka lang, A tâwp chu thihna kawng ni si a awm.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nuihnaah pawh rilru lungngaihna a awm a, Hlim tâwpna chu rihna a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thinlunga hnungtawlh mi chu ama duh dânin a khat ang a; Mi ṭha chu amah leh amah a intilungawi ang,
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi mâwl chuan thu tin a ring a, Mi remhria erawh chuan a kalna a en ṭha ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi fing chuan a hlauthâwng a, sual a kalsan ṭhîn a; Mi â erawh chu a intihuai a, mahni a inring ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thinram mi chuan âtthlâk takin thil a ti ang a; Tin, thil sual suangtuah hmang mi chu huat a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi mâwl chuan âtna an rochung a, Mi remhria erawh chu hriatna khumtîrin a awm.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi sual chu mi ṭha hmaah a kûn a, Mi suaksual chu mi fel kawngka bulah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi rethei chu a ṭhenawmte ngei pawhin an hua a, Mi hausa erawh chuan ṭhian tam tak an nei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tu pawh ṭhenawmte hmusit chuan thil a tisual a ni; Mi rethei lainattu erawh chu a eng a thâwl e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thil ṭha lo suangtuahtute chuan an tisual a ni lâwm ni? Thil ṭha suangtuah miah erawh chuan zahngaihna leh thutak a awm ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thawh rimna zawng zawngah hian hlâwkna a awm a, Kâa sawi mai mai erawh chuan tlâkranna mai a thlen a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi fing lallukhum chu a sum a ni a, Mi âte âtna chu âtna ngawt a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hretu dik chuan mite a chhan chhuak a, Dâwt chhâk chhuak mi chuan bumna a tichhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa ṭihnaah chuan rinna chak tak a awm a, A fate chuan inhumhimna hmun an nei ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lalpa ṭihna chu nunna tuikhur a ni, Thihna thang hawisanna tûrin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mipui tamnaah chuan lal ropuina a awm a, Mi tlêmnaah erawh chuan lal fapa boralna a awm.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thinur har mi chu finna nasa tak nei mi a ni a, Mi ti thawt thawt erawh chuan âtna a chawimawi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rilru dam chu tisa nunna a ni a, Itsîkna erawh chu ruh mawihna a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi rethei hnehchhiahtu chu a siamtu hnehchhiah a ni a, Tlachhamte khawngaihtu chuan a chawimawi a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi suaksual chu a thil tihsualah chuan theh luh a ni a, Mi fel erawh chuan a thihnaah nghahfâk a nei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ngaihthiamna nei mi thinlungah chuan finna a chêng ṭhîn a, Mi a chhûng lama awm erawh chu a lang sa reng.
  </para>
  <para style="p">
    <verse number="34" style="v" />Felnain hnam a chawimawi a, Sualna erawh chu hnam tin tân hmingchhiatna a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lal duhsakna chu fing taka titu chhiahhlawh chungah a awm a, A thinurna erawh chu mualphona thlentu chungah a awm ang.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chhânna nêmin thinur a tikiang ṭhîn a, Ṭawng huatthlala erawh chuan thinur a chawk tho ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi fing lei chuan finna thu dik a chhak chhuak ṭhîn a, Mi a kâ erawh chuan thu âtthlâk a chhâk chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa mit chu hmun tinah a awm a, Thil ṭha leh ṭha lo a enthla reng ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lei dik tak chu nunna thing a ni a, Luhlulna awmna erawh chu thinlung lungchhiatna a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi â chuan a pa thununna a ngainêp ṭhîn a, Zilhhauna ngaisâng chuan hmang hre takin a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi fel inah chuan sum tam tak a awm a, Mi suaksual hlâwkna erawh chu buaina a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi fing hmui chuan hriatna a tidarh a, Mi a thinlung erawh chuan chutiang chu a ti lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi suaksual inthawina chu Lalpa tâna tenawm a ni a, Mi ṭha ṭawngṭaina erawh chu a lâwm zâwng a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi suaksual kawng chu Lalpa tâna tenawm a ni a, Felna kawng zawhtu erawh chu a hmangaih ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kawng pênsantu thununna chu a na a, Zilhhauna hawtu chu a boral ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Seol leh Abaddon chu Lalpan a hmu tlang a, Mihring thinlung phei chu a va hmu chiang dâwn êm!
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmuhsit chîng mi chuan zilhhauva awm a ngaina lo va, Mi fing hnênah chuan a kal duh lo vang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thinlung hlimin hmêl hlim a siam a, Thinlung lungngaihna erawh chuan rilru a tilungchhe ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hriat thiamna thinlung neitu chuan hriatna a zawng a, Mi a kâ erawh chu dâwtin a inhrai ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hrehawm tuartu tân chuan ni zawng zawng hi a ṭha lo vek a, Thinlung hlim mi erawh chuan ruai a ṭheh reng mai a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa ṭihna nêna tlêm tê neih chu, Tam tak neiha buaina tawh ai chuan a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmangaihna awmnaa anhnah chawa rin chu, Huatna awmnaa bâwngpa châwm thau ei aiin a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi thinchhia chuan inhauna a chawk tho va, Mi thluak nêm erawh chuan inhauna a tireh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi thatchhe kawng chu hlîng pal ang a ni a, Mi tluang kawng chu lamliana siam a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Fapa fing chuan pa hlim a siam a, Mi â erawh chuan a nu a ngainêp ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Finna nei lote chuan âtna hi an hlimna a ni a. Thil hre thiam mi erawh chuan a kawng a tingîl ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Remruat lâwk lova thil tih a hlawhtling duh lo, Remhria an tam chuan a hlawhtling ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hun taka chhânna dik hriat hi A va lâwmawm êm!
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi fing tân chuan nunna kawng hi a chung lamah a kal a, Hnuai lama Seol chu a kalsan theih nân.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lalpan mi chapo in chu a kar phawng ang a, Hmeithai hmun erawh chu a tinghet ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpan mi suaksualte ngaihtuahna chu a ten a, Thinlunga thianghlimte erawh chu a lawm.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi duhâm chuan ama chhûngkua a tibuai ṭhîn a, Tham hawtu erawh chu a hmuingîl ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi fel thinlung chuan ngun takin a chhâng a, Mi suaksual ka erawh chuan thil ṭha lo a chhâk chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lalpa chu mi suaksual lakah chuan a hla a, Mi fel ṭawngṭai erawh chu a ngaithla ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hlim hmêlin mi a tilâwm a, Chanchin lâwmawmin mi a tiharh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nunna zilhhauna pawm ṭhîn chu Mi fing zîngah a tel ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thununna duh lo chuan a thlarau a ngainêp a, Zilhhauna pawm erawh chuan hriat thiamna a chang ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpa ṭihna chu finna zirtîrtu a ni a, Inngaihtlâwmna chu chawimawia awmna a ni.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rilru lo ruahman lâwkna chu mihring chan a ni a, Lei chhânna erawh chu Lalpa aṭangin a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi ama ngaihin a kawng zawng zawng a thianghlim a; Nimahsela, Lalpan rilrute a bûk ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />I hnate chu Lalpa kawltîr rawh; Tichuan, i thil ruahmante chu tihnghehin a awm ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpan thil zawng zawng hi chhan nei ṭheuhvin a siam a, A ni tak e, mi suaksualte pawh hi ni ṭha lo atân.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thinlunga chapo apiangte chu Lalpa tâna tenawm an ni; Inthurual mah se, hrem lohvin chhuah an ni lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zahngaihna leh thutakin khawlohna chu tlen fai a ni a, Lalpa ṭihnain miin sual a kalsan ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi, a awm dânin Lalpa a tihlâwm chuan, A hmêlma nên lam inremin a awmtîr ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Fel lo taka deh chhuah tam tak ai chuan, Fel taka deh chhuah tlêm tê a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihring rilruin a kawng a ruahman a, A ke pên erawh chu Lalpan a hruai ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lal kâah chuan Pathian thu tihtlûk a awm a; A kâ chuan a rêl sual lo vang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bûkna leh tehna dik hi Lalpa ta a ni a, Ip rih zâwngte chu a ngaihtuah ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Suahsualna thil tih hi lalte tân tenawm a ni, Lalṭhutthlêng chu felnaa tihngheh a ni si a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kâ fel chu lal lâwmna a ni a, Thu dik sawi chu an ngaina ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lal thinurna chu thihna zualko ang a ni a, Mi fing erawh chuan a nem dai ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lal hmêl êngah chuan nunna a awm a, A duhsakna chu ruahtui tla hnuhnûng chhûm ang a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rangkachak ai chuan finna neih hi a va ṭha nasa zâwk êm! A ni, tangkarua ai chuan hriat thiamna chu thlan zâwk tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi tluangte lamlian chu sual kalsan a ni; A kawng vêng ṭha chuan a nunna a humhim a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chapona chu boralna hmaah a kal a, Rilru intivei chu tlûkna hmaah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi chapote nêna râllâk thil insem ai chuan, Mi retheite nêna rilru thuhnuairawlh nih a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thu chîk taka dâwn mi chuan thil ṭha a dawng ang a, Lalpa ring apiang chu an nihlawh ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rilrua fing chu mi remhria tih an ni ang a, Ṭawngkam thlumna chuan thiamna a tipung.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hriat thiamna hi a neitu tân chuan nunna tuikhur a ni a, Mi âte tân erawh chuan thununna chu an âtna a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi fing thinlung chuan a ka a zirtîr ṭhîn a, A hmuiah thiamna a belhchhah ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thu pai nuam chu khawithlâr ang a ni a, Nunna tân a thlum a, ruh tân hrisêlna a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi ngaiha kawng dik ni âwm taka lang, A tâwp chu thihna kawng ni si a awm.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hnathawk mi chu ei tûr avângin a rim a, A rilṭâm reh nân a thawk rim ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi tlâktlai lo chuan pawi khawih tûr a ngaihtuah chhuak a, A kaah mei sa tak a awm.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ṭawng chaltlai mi chuan inhauna a theh darh a, Sêsêa thu sawi hmangin ṭhian bulte a tiṭhen ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi nunrâwngin ṭhenawmte a hruai sual ṭhîn a, Kawng ṭha lovah a hruai ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />A mit maimitchhîng chuan thil ṭha lo suangtuah nân a ti a ni a, A heh pettu chuan thil ṭha lo a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lu ṭuak chu ropuina lallukhum a ni a, Felna kawngah hmuh a ni ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi thinnel chu mi chak aiin a ṭha zâwk a, A rilru thunun hneh chu khaw latu aiin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mal chungah ṭhum an vâwr a, Thil lo chhuak erawh chu Lalpa tih a ni.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Insual bur bura ruaiṭhehna in ai chuan, Inrem taka chaw ṭhing bâr khat eina a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chhiahhlawh fing taka che chuan fapa, mualphona thlentu chungah chuan ro a rêl ang a, Unau ro zîngah chanvo a nei ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tihthianghlimna bêl chu tangkaraw tân a ni a, rawh tuina chu rangkachak tân a ni a, Thinlung erawh chu Lalpan a fiah ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thil ṭha lo titu chuan mi suaksual kamchâng a bengkhawn ṭhîn a, Mi dawthei chuan pawi khawih hmang lei lamah beng a chhi ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi rethei hmusittu chuan a Siamtu a ngainêp a ni a, Mi vânduaina diriamtu chu hrem lohvin a awm lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu leh fate hi upate lallukhum an ni a, Fanaute ropuina chu an pate hi an ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thusawi ropui leh mi â a inmawi lo va, Hmui dawthei leh lal fa a inmawi lo lehzual.
  </para>
  <para style="p">
    <verse number="8" style="v" />A dawngtu mitah chuan thilpêk chu lunghlu ang a ni a, A hawina lam apiangah a hlawhtling ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bawhchhiatna thuptu chuan inhmangaihna a zawng a, Thil sawi sawi hmang chuan ṭhian bulte a tiṭhen ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi â vawi za vuak aiin Mi fingah chuan vawi khat zilhhauna pawh a lût thûk zâwk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi ṭha lo chuan helna ngawt a zawng ṭhîn a; Chuvângin, a chungah zualko nun chhia tirh a ni ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi â ât lai tawh ai chuan Savawm, a no lâksak daih hmachhawn a duhawm zâwk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ṭhatna suala thungrûltu chu Thil ṭha lovin a in a chhuahsan lo vang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Inhnial hi tuikhuah hnâm tîr ang a ni a; Chuvângin, insualna a awm ṭan hmain inhnial bâng rawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi suaksual thiamtu leh mi fel thiam lotu chu, Lalpa tân ang khat rengin an tenawm ve ve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hriat thiamna nei si lo mi â kutah chuan, Engah nge finna leina tûr man a awm ni?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ṭhian chuan eng lai pawhin a hmangaih reng a, Mangan ni atân unauva piang a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hriatna nei lo mi chuan a kut a bêng a, A ṭhenawmte hmaah mawh- phurtuah a insiam ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Insual ngaina mi chuan bawh- chhiatna a ngaina ṭhîn a, A in hungna kawngkhâr tisâng chuan boralna a zawng ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rilru luhlul nei mi chuan thil ṭha a hmu ṭhîn lo va, Tin, lei bengtla lo neitu chu pawi khawihnaah a lût ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi â hringtu chuan ama lungngaihna a thlen ṭhîn a, Mi â pa chuan lâwmna a nei lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thinlung hlim hi damdawi ṭha tak a ni a, Thinlung lungchhia erawh chuan ruh a tiro ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi suaksual chuan rorêlna kawngte tikikawi tûrin, Mi kut ata thamna a la ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Finna chu hriat thiamna neitu hmaah a awm ṭhîn a, Mi â mit erawh chu kâwlkilah a awm ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Fapa â chu a pa tilungngaitu a ni a, A hringtunu tân a khâ a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi fel hrem a ṭha lo va, Mi ṭha an ṭhatna avânga vuak a ṭha hek lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />A thusawia insûm ṭhîn chuan finna a nei a, Rilru dam mi chuan hriat thiamna a nei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi â pawh a ngawih reng chuan mi finga chhiar a ni a, A hmui a chîp chuan mi remhriaa ngaih a ni.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi inkulh hrang chuan mahni duh zâwng a zawng ṭhîn a, Finna dik zawng zawng a tai ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi â chuan hriatnaah lâwmna a nei lo, Ama rilruin a tihlan chauh lo chu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Suahsualna a lo awmin hmuhsitna pawh a lo awm ṭhîn, Mualphona a lo awmin zilhhauna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi â kâa thu chu tui thûk tak ang, Finna lui, lui luang ang a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi suaksual duhsak a ṭha lo va, Rorêlnaa mi fel hnâwl a ṭha hek lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi â hmui chuan inhauna a thlen a, A kâ chuan vuakna a ko.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi â kâ chu a boralna a ni a, A hmui chu a nunna thang a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sêsêa thu sawi hmang mi thu chu chaw tui tak ang a ni a, Pum chhûngril berah a lût ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hnathawha mi dâwngdah pawh Tiboraltua unaupa a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa hming chu kulhpui a ni a, Mi fel chu a tlân lût ṭhîn a, a him ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hausa chuan a sum chu a kulhpui a ni a, A suangtuah dânah chuan kulh sâng tak a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihring rilru chapona chu boralna hmaah a kal a, Inngaihtlâwmna chu chawimawina hmaah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngaihthlâk ahmaa chhân chu A tân âtthlâk nihna leh mualphona a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi rilru nei chuan a chak lohna chu a tuar zo vang a; Mahse, rilru hliam chu tu nge tuar thei ang?
  </para>
  <para style="p">
    <verse number="15" style="v" />Remhre thinlung chuan hriatna a dawng ṭhîn a, Mi fing beng chuan hriatna a zawng ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi a thilpêkin kawng a tihkuaksak a, Mi ropuite hmaah a hruai lût ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />A thiamna thu sawi hmasatu chu felin a lang ṭhîn a; Mahse, a ṭhenawmte an lo kal a, an rawn tilang ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ṭhumvâwrin inhauna a tibâng a, Mi chakte a tiṭhen ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />I unau pui la, kulhpui angin a hum ang che; In inhau erawh chuan, a inkhâr hnan ang che.
  </para>
  <para style="p">
    <verse number="20" style="v" />Miin a pumpui chu a kâ rahin a tikhat ang a, A kâa thil hâwngin a titlai ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lei thiltihtheihnaah chuan thihna leh nunna a awm a, A ngainatute chuan chumia rah chu an ei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nupui hmu chuan thil ṭha a hmu a ni, Lalpa duhsakna a chang ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi rethei chuan a thlêmin an thlêm a, Mi hausa erawh chu rura takin an ṭawng ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ṭhian tam tak siam chuan mahni intihchhiatna a siam a ni a; Amaherawhchu, unau aia nghet zâwk ṭhian an awm ṭhîn.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi, a hmuia tihmawh, â bawk si ai chuan Mi rethei, rilru ṭha tak pua awm chu a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hriatna lova duhna ngawt pawh hi a ṭha lo va, Ke chhep rang ringawt chu a kal sual ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi a âtnain a kawng a tihchhiatsak ṭhîn a, A rilru Lalpa chungah a vui ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sumin ṭhian tam tak a neih belhtîr a, Mi rethei erawh chu a ṭhianten an thlauhthla ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hretu der chu hrem lohvin a awm lo vang a, Dâwt sawi chu a chhuak lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tam takin mi thilphal duhsakna an ngên ang a; Thil pe ṭhîntu lakah chuan mi tin mai hi ṭhian an ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi rethei chu a unaute zawng zawng chuan an vai huat ṭhîn a, Ṭhian maite chu a lakah an va hla lehzual dâwn êm! Thuin a ûm a; nimahsela, an kal daih tawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Finna dawngtu chuan ama nunna a hmangaih ṭhîn a, Hriatna vawngtu chuan thil ṭha a hmu ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hretu der chu hrem lohvin a awm lo vang a, Dâwt sawi chu a boral ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nunkhaw nawm chu mi â nên a inhmeh lo va, Chhiahhlawhin lal fate chunga rorêl chu a inhmeh lo lehzual.
  </para>
  <para style="p">
    <verse number="11" style="v" />A ngaihruat thiamnain mi a thin a tihnelsak ṭhîn a, Bawhchhiatna hai der chu a ropuina a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lal thinrim chu sakeibaknei rûm ang a ni a, A duhsakna erawh chu hlobet chunga dai ang a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Fapa â chu a pa vânduaina a ni a, Nupui ân ṭhinna chu eng lai pawha ruah far reng ang a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />In leh sum leh pai chu pate laka roluah a ni a, Nupui remhria erawh chu Lalpa laka mi a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dâwngdahnain tui taka mutnaah a hruai lût a, Mi thatchhia chuan rilṭâm a tuar ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thupêk vawng ṭha chuan a nunna a vawng ṭha a ni a, A awm dâna fîmkhur lo erawh chu a thi ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi rethei khawngaih chuan Lalpa a pûktîr a ni a, A thil tihṭhat chu a rûl ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Beiseiawm a la nih laiin i fapa chu thunun la, Boral mai tûrah ngai suh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thinur ti nasa mi chuan hrem a tuar ang, I chhan chhuah pawhin, chhan chhuah leh ṭhin a ngai ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />A tâwp a tâwpa i lo fin theih nân zilhna pawm la, Thununna pawisa rawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihring thinlungah suangtuahna tam tak a awm a; Lalpa remruat erawh chu a pângngai reng ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi a duhthusâm chu a ngilneih dân tehna a ni a, Mi dawthei ai chuan mi rethei a duhawm zâwk.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa ṭihna chuan nunna a thlen a, A nei apiang chu lungawi takin an awm ang a, Thil ṭha lovin a tlâkbuak lo vang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi thatchhia chuan a kut thlêngah a hnim a, A kâ han thlen leh takngial pawh a peih lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmuhsit chîng mi chu vua la; Tichuan, mi mâwlin remhriat a zir ang a; Ngaihthiamna nei chu zilh la, a hre thiam ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pate tiretheia, nute hnawt chhuak chu, Fapa, mualphona thlena, hmingchhiatna thlentu a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka fapa, thil tidik lo tûra Finna zirtîrna thu ngaihthlâk chu bâng rawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thuhretu tlâktlai lo chuan rorêlna a hmusit a ni a, Mi suaksual kâ chuan khawlohna a lem.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rorêlna chu hmuhsit chîngte tâna buatsaih a ni a, Vuakna chu mi âte hnungzâng atân.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Uain hi nuihzatbûra mi siamtu a ni a, Zupui hi insual bûng bûngna a ni; Chumi buma awmte chu an fing lo a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lal vauna chu sakeibaknei rûm ang a ni a, Tu pawh a thin tiur chu mahni nunna chunga thil tisual an ni ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Intihbuaina ata lo inthiarfihlîm hi thil duhawm a ni a, Mi â apiangte chu an insual ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi dâwngdah chuan thlasik avângin lei a let peih lo va; Chuvâng chuan buh seng laiin kut a dawh ang a, Eng mah a nei lo vang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Remruatna chu mihring thinlungah tui thûk tak ang a ni a; Nimahsela, hriat thiamna nei chuan a phawrh chhuak ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rinawm tak niin an insawi ṭheuh va, Rinawm tak tak tu nge hmu thei ang?
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi fel, ama remruat thiama awm mi fate chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rorêlnaa lal ṭhu chuan, A mitin thil ṭha lo zawng zawng a tibo ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ka thinlung ka tithianghlim a, Ka sual lakah ka thianghlim,” tu nge ti thei?
  </para>
  <para style="p">
    <verse number="10" style="v" />Bûkna dang dang te, tehna dang dang te hi, Lalpa mit hmuhah ang khat rengin thil tenawm a ni ve ve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naupang takngial pawh a thiltihin a intilang ṭhîn, A thiltih chu a thianghlim leh a dik emawin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hriatna beng leh hmuhna mit hi Lalpa siam ve ve a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mut thlahlel suh, i lo pachhe dah ang e; I mit meng la; tichuan, chhang kham khawp i nei dâwn nia.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Eng mah a nih loh hi, eng mah a nih loh hi,” thil leitu chuan a ti ṭhîn a, A kal hnu chuan a chhuang leh viau si ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rangkachak te a awm a, lunghlu sen te pawh a tam a; Hriatna hmui erawh chu lungmawi hlu tak a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hnam dang tâna mawhphurtua inpe silhfên chu la la, Hnam dang tâna inpe chu hrêngah hmang rawh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bumna chhang chu miin tui a ti a; Mahse, a hnuah a ka chu lungtêin a khat ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi râwnin i thiltum chu bûk la, Fel taka rêlin hmêlma bei rawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi kamtam tei vêl ruai chuan thurûkte a tilang ṭhîn a; Chuvângin, a kâ zau taka âng chu pâwl suh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A nu emaw, a pa emaw ânchhe lawhtu chu, Thimtham lai berah a khâwnvâr tihmihsak a ni ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sum hi a tîrah deh chhuah thuai theih mah sela, A tâwpah malsâwm a ni kher lo vang.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Sual chu ka thungrûl teh mai ang,” ti suh la, Lalpa ngaichâng rih la, ani chuan a chhan him ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bûkna dang dang hi Lalpa mit hmuhah thil tenawm a ni a, Khîn dik lo hi a ṭha lo a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihring kawngte chu Lalpa ruat a ni a, Engtin nge mihringin a kawng an hriat theih ang?
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathian tân thil pe tûrin intiam thut suh, I inchhîr leh dah ang e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lal fing chuan mi suaksualte a zâp kiang a, An chungah sisêp a ruai ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihring rilru chu Lalpa khâwnvâr a ni a, Pumpui chhûngril lam zawng zawng pawh a ên chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zahngaihna leh thutakin lal a vawng ṭha a, A ṭhutthlêng chu zahngaihnaa tundinin a awm.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tlangvâlte ropuina chu an chakna a ni a, Putarte mawina chu an lû ṭuak a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pem khawpa vuakna chuan thil ṭha lo a tlêng fai a, Vuakna chuan pumpui chhûngril lamte pawh a fan.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lal thinlung chu Lalpa kutah a awm a, tui luanna kawng angin, A duh duhnaah a tikawi ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi tin awm dân hi mahni mitah chuan a dik tih a ni a; Nimahsela, Lalpan thinlung a bûk ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Inthawina aiin dik tak leh fel taka rorêl chu Lalpa tân a pawmawm zâwk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi indah chung leh rilru chapo te, Mi suaksual khâwnvâr hi sual a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi taima ngaihtuahna chuan neihnunna lam chauh a pan a, Mi thatchhia erawh chuan tlâkchhamna lam chauh a pan a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lei dawthei hmanga sum deh chhuah chu, Chhûm thli chhêm lên chhêm lên ang a ni; A zawngtu chu thihna zawng a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi suaksualte nunrâwnna chuan anmahni a hnâwl bo vang, Rorêlna fel an duh loh avângin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thiam lohna phurtu kawng chu a kawi êm êm mai a, Mi thianghlim erawh chu a thiltih a ngîl a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmeichhe inhau hmang tak nêna in zau taka awm ai chuan, In chung chhîp kila awm a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi suaksual rilru chuan thil ṭha lo a duh a, A ṭhenawmten a mitah duhsakna an hmu lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmuhsit chîng mite hrema an awmin mi mâwlte chuan an fin phah a; Tin, mi fing chu zirtîra a awmin hriatna a dawng ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi fel chuan mi suaksual chhûngkuate a ngaihtuah ṭhîn a, Mi suaksualte an chhiatna tûra thehthang bo an nihzia te.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi rethei au thâwma beng chhu ngawng chu, Ani pawh a au vang a; nimahsela, ngaihthlâksak a ni bîk lo vang.
  </para>
  <para style="p">
    <verse number="14" style="v" />A rûka thilpêkin thinur a tireh a, Puan hnuaia thilpêkin thinur nasa tak a tidai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rorêl fel hi mi fel lâwmna a ni a, Khawlohna titu tân erawh chuan boralna a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hriatna kawng ata kal bo chu Mitthi awm khâwm zîngah a châwl ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nawmsakna thlahlel chu mi rethei a ni ang a, Uain leh hriak ngaina mi chu a hausa lo vang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi suaksual chu mi fel tlanna an ni ang a, Mi bum hmang chu mi dik tak tlanna.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmeichhe ân hmang leh phunchiar nêna awm ai chuan Thlalêr rama awm a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi fing awmnaah chuan ro leh hriak hlu tak a awm a, Mi â erawh chuan an dawlh mai ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Felna leh zahngaihna zuitute chuan Nunna te, felna te, chawimawina te an hmu ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi fing chu mi chak khawpuiah a lâwn a, Chumia an rin pui ber chakna chu a lâk thlâksak ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tu pawh a kâ leh a lei vêng ṭha chuan Manganna lakah a nunna a vêng ṭha a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi chapo leh mi intivei chu a hming pawh Hmusittua a ni; Inngaih ropui chaponain thil a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi dâwngdah duhthusâm chuan amah a tihlum ṭhîn, A kutin hnathawh a duh loh avângin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nilênga duhâm taka awh nei an awm a; Mi fel erawh chuan a pe a, eng mah a sûm lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi suaksual inthawina chu thil tenawm a ni a, Rilru sual nêna a rawn lâk chu a va tenawm lehzual dâwn êm!
  </para>
  <para style="p">
    <verse number="28" style="v" />Hretu der chu a boral ang a; Nimahsela, hretu dik chuan tu ma dodâl lohvin thu a sawi ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi suaksualin a hmêl a tiruh a, Mi fel erawh chuan a kawng a rêl fel ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lalpa kalh zâwnga hlawhtling finna te, hriatna te, Remruatna te a awm lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sakawr chu indo ni atân buatsaih a ni a, Hnehna erawh chu Lalpa ta a ni.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sum tam tak aiin hmingṭhat hi thlan zâwk tûr a ni a, Tangka leh rangkachak aiin duhsakna a ngainatawm.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi hausa leh mi rethei an awm za a, An vaia siamtu chu Lalpa a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi hmanghria chuan thil ṭha lo chu a hmuhin a biru ṭhîn a; Mi mâwl erawh chuan a tâwn mai ṭhîn a, a tuar phah ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Inngaihtlâwmna leh Lalpa ṭih man chu Sum te, chawimawina te, nunna te a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi bengtla lo kawngah chuan hlîng te, thang te a awm a, A nunna vawng ṭha chuan a hlat daih ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naupang chu a kalna âwm kawngah chuan zirtîr ula, A upat hun pawhin a thlah lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi hausain mi rethei ro an rêlsak a; Tin, pûktu chu a pûktîrtu chhiahhlawh a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khawlohna tuhtu chuan vânduaina a ât ang a, A thinurna talhtum chu a hlawhchham ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi thilphal chu malsâwmin a awm ang, A chhang mi rethei a pêk ṭhin avângin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmuhsit chîng mi chu paih chhuak ula, inhnialna chu a kiang ang, A ni, insualna te, inrunluihna te a reh ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thinlung thianghlimna ngaina chuan A ṭawngkam chhuak mawi avângin lal chu a ṭhian a ni ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa mit chuan hriatna nei mi chu a vawng ṭha ṭhîn a, Mi vervêk thu erawh chu a paihthlâksak ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi thatchhia chuan, “Pâwnah sakeibaknei a awm a, Kawtthlêrah ka tualthi ang,” a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmeichhe sual kâ chu khuarkhurum thûk tak a ni a, Lalpa huat zâwngte chu chutah chuan an tla ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Naupang thinlungah chuan âtna a bet tlat a; Mahse, thununna tiangin hla takah a hnawt kiang ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />A hlâwkna tûra mi rethei hnehchhiah leh, Mi hausa tlawntu chuan tlâkranna mai a thlen ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />I beng chhi la, mi fing thu ngaithla rawh; Tin, i thinlung chu ka finna dawn nân hmang rawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />I thinlung chhûnga i vawna, I kâa i tihngheh bawk chuan thil duhawm tak a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />I rinna chu Lalpa chunga a awm theih nân, Vawiinah hian i hnên ngeiah ka hriattîr che a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thutak nghehzia hriattîr che leh, A rawn petu che hnêna thutak chu i lêtpui theih nân, Remruat dân leh hriatna ṭha tak ka ziaksak che a ni lâwm ni?
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi rethei chu rawk suh, a rethei si a, Kulh kawngkâah mi lungngaite hnehchhiah hek suh;
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpan an thu a sawipui dâwn si a, Anmahni rawktute nunna chu a rawk dâwn a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thinrim hmang mi chu ṭhian suh la, Mi thinchhia chu kawp suh;
  </para>
  <para style="p">
    <verse number="25" style="v" />A tih dân i zir ang a, I nunna atân thang i tawng dah ang e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Intiamkamte zîngah tel suh la, Leiba atân intiamkamtute zîngah pawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Eng mah pêk tûr i neih si loh chuan Engah nge i khum chu a lâksak loh vang che?
  </para>
  <para style="p">
    <verse number="28" style="v" />In pi leh puten hmakhawsânga Ramri an lo kham chu sawn suh u.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi a hnathawha taima i hmu ṭhîn em? Lal hmaah te a awm ang a, Mi narân hmaah chuan a awm lo vang.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rorêltute nêna chaw eia in ṭhut dunin I hmaa mi chu ngun takin en rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />I ril a ṭâm hle chuan Insûm deuh vang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bumna chaw mai a nih hre rengin, A tuina ngawt chu ît suh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Intihausa tûrin intihah suh la, Nangma finna rin bâng rawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thil awm lo chungah i mit i nghat dâwn em ni? Sum chuan thla a insiam ngei ngei a, Mupui vân lama thlâwk ṭhîn ang hian.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi fîr chhang chu ei suh la, A thil tuihnaite ît hek suh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A suangtuah ang chiah zêlin a ni a awm ni, “Ei rawh, in rawh,” a ti ang chia; Mahse, a rilru chuan ngaimawhna che a nei lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />I chaw bâr chu i luak chhuak ang a, I thu thlum tak chu i chân ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi â beng hriatah chuan thu sawi suh, I thufingte chu a ngainêp dâwn si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmakhawsânga ramri lo kham chu sawn suh la, Pa nei lote lovah inrawlh suh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anmahni tlantu chu a chak a, I chungah an thu a sawipui dawn si a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zirtîrna lamah i rilru nghat la, I beng chu hriatna thu lamah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naupang thunun tîm suh, Tiangin vaw mah la, a thi dâwn si lo va.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tiangin i vua ang a; Tichuan, Seol ata a nunna i chhan chhuak ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka fapa, i rilru a fin chuan Ka thinlung a lawm tak tak ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />A ni, i kâin thil dik a sawiin Ka rilru a hlim ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />I thinlungin mi sual awt suh se; Nilêngin Lalpa ṭihin awm zâwk rawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lâwmman a awm ngei dâwn si a, I beisei chu tihbovin a awm lo vang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka fapa, ngaithla la, fing la, Kawngah chuan i thinlung hruai rawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uain heh mite zîngah leh Sa heh mite zîngah tel suh;
  </para>
  <para style="p">
    <verse number="21" style="v" />Zu rui mite leh sa heh mite chu an lo rethei dâwn si a, Nguinain puan chhia a sintîr ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />I pa, a hringtu che thu chu pawm la, I nu chu a lo tarin hmusit suh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thu dik chu lei la, hralh leh tawh suh; A ni, finna te, zirtîrna te, hriat thiamna te nên.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi fel pa chu nasa takin a hlim ang a, Fa fing hringtu chuan a chungah lâwmna a nei ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />I nu leh pa chu hlim takin awm sela, A hringtu che chu hlim takin awm rawh se.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka fapa, i thinlung mi pe la, Ka awm dânte hian i mit tlung rawh se.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nawhchizuar chu khuarkhurum thûk tak a ni a, Hmeichhe sual chu khuarkhurum zîm a ni;
  </para>
  <para style="p">
    <verse number="28" style="v" />A ni, rûkru angin mi an châng a, Mihring zîngah vervêkna an tipung ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tute nge chungpik ṭhîna, tute nge lungngai ṭhîna, tute nge inhau ṭhîn? Tute nge thubuai nei ṭhîna, tute nge a vâng awm lova hliam tuar ṭhîna, Tute nge mit sen rêm rûm ṭhîn le?
  </para>
  <para style="p">
    <verse number="30" style="v" />Zu hmuna awm reng ṭhînte, Zu chawhpawlh in ṭhînte an ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Uain a sen kâk laiin en suh, Nova a zia a lan lai te, A luan thlâk zaih zaih lai tein;
  </para>
  <para style="p">
    <verse number="32" style="v" />A tâwpah chuan rûl angin a chu a, Rûl tûr ṭha mi angin mi a chu ṭhîn.
  </para>
  <para style="p">
    <verse number="33" style="v" />I mitin thilmak takte a hmu ang a, I thinlungin thu chaltlai takte a chhâk chhuak ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />A ni, mi tuifinriat lai taka mu ang emaw, Lawng puanzârna chhîpa mu ang emaw i ni ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Min vua a, a na si lo, Min vêl a, ka hre lo, Eng tikah nge ka lo harh ang aw? Ka in leh bawk ṭhîn ang,” i ti ang.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi sualte awt suh la, An zînga tel châk hek suh.
  </para>
  <para style="p">
    <verse number="2" style="v" />An thinlungin hnehchhiahna an zir a, An hmuiin pawi khawih lam thu mawlh an sawi ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Finnain in chu sak a ni a, Hriat thiamnain tihngheh a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tin, hriatna avângin pindan chu Sum hlu tak leh duhawm taka tihkhahin a awm.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chakna aiin finna a ṭha a, Âwmkhauh aiin hriat thiamna.
  </para>
  <para style="p">
    <verse number="6" style="v" />Beih hmain ngun taka râl rêl a ṭha, Rem i hriat poh leh i chak zâwk ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi â tân finna chu a sâng lutuk a, Kulh kawngkâah a kâ a âng lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thil ṭha lo ti tûra remruat ṭhîn chu Miten pawi khawih hmang an ti ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi â ngaihtuahna chu sual a ni a; Tin, mi hmuhsit chîng mi chu mihring tân tenawm an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mangan nia i chauh mai chuan I chakna a beitham a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thi tûra hruaite chu chhan chhuak la, Thah mai tûrte chu chhan chhuak thuai rawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Ngai teh, hei chu ka hre lo,” i tih mai chuan, Thinlung bûktu chuan a ngaihtuah dâwn lâwm ni? I nunna vawngtu chuan a hre dâwn lâwm ni? Mi tin an thiltih ang zêlin a rûl dâwn lâwm ni?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka fapa, khawizu in rawh, a ṭha si a, Khawithlâr i kâa tui tak chu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tichuan, i nunna atân finna chu chutiang a ni tih i hria ang a; Tin, i hmuh chuan lâwmman a awm ang a, I beisei chu tihbo a ni lo vang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw, mi suaksualpa, mi felte awmna chu châng suh; A awmna chu tihchhiatsak suh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi fel chu vawi sarih tlu mah sela, A tho leh zêl ṭhîn; Mi suaksual erawh chu chhiatnain a tiboral ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />I hmêlma a tlûkin lâwm suh la, Tihtlâwma a awmin i rilru lâwm suh se;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuti lo chuan, Lalpan a hmu ang a, a lâwm lo vang a, A laka a thinrim a lamlêt dah ang e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thil ṭha lo titute avângin intilungngai duh suh la, Mi suaksual awt hek suh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi sual tân chuan lâwmman a awm dâwn si lo va, Mi suaksual khâwnvâr chu tihmih a ni dâwn si a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka fapa, Lalpa leh lal chu ṭih la, Rilru danglam pu mite chu pâwl suh;
  </para>
  <para style="p">
    <verse number="22" style="v" />An chhiatna a lo thleng thut ang a, An boral kumte chu tu nge hria?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hêngte pawh hi mi fing thusawi a ni, Rorêlnaa mi zah zâwng neih hi a ṭha lo a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi suaksual hnêna, “I fel e,” titu chu Mi tinin ânchhia an lawh ang a, Hnam tinin an hua ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />A zilhhautute erawh chu an hlim ang a, An chungah malsâwmna ṭha tak a lo thleng ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dik taka chhângtu chu Ṭhian ṭha a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pâwn lam thil buatsaih la, Lo lamah inpeih diam la, Chumi zawhah i in sa rawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A vâng awm lovin i ṭhenawmte chungchâng thûah hretu ni suh la, I kâin bum bawk suh.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ka chunga a tih angin a chungah ka ti ang a, A thawh dân ang zêlin ka pe ang,” ti suh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi thatchhe lovah ka kal a, Hriatna nei lo mi grêp huanah nên;
  </para>
  <para style="p">
    <verse number="31" style="v" />Ngai teh, hlîngin a hnim phui chûk mai a, A chhûng zawng zawng chu ṭaiṭênin a phui chûk mai a, A hungna lungpalte chu a chim vek a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tichuan, ka en reng a, ngun takin ka ngaihtuah ta a, A mi zirtîr chu ka hmu a, ka pawm ta a.
  </para>
  <para style="p">
    <verse number="33" style="v" />I duh chuan mu hlek la, chhîng hlek rawh, Kut kuangkuahin châwl hlek teh;
  </para>
  <para style="p">
    <verse number="34" style="v" />I mut hlânin i rethei hman ang a, Tlâkchhamnain sipai angin a nang thut ang che.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hêng pawh hi Solomona thufing, Juda lal Hezekia miten an ziak chhâwn chu a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil thup hi Pathian ropuina a ni a, Lal ropuina erawh chu thil zawn chhuah a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vân hi a sâng êm a, lei hi a thûk êm a, Lalte rilru pawh hi chhui chhuah rual a ni lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tangkaraw êkchhia paih la, A chhertuin thil mawi a chher thei ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lal hma ata mi suaksual chu sawn bo ula, A lalṭhutthlêng chu felnaa tihngheh a ni ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lal hmaah chawimawina chuh suh la, Mi ropuite hmunah ding suh.
  </para>
  <para style="p">
    <verse number="7" style="v" />I hmuh tawh ṭhin mi lian hmaa tihhnuai i nih ai chuan, “Ṭhutphah ṭha deuhvah lo ṭhu rawh khai,” I hnêna han tih chu a ṭha zâwk si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Inbei tûrin hmanhmawh takin kal suh, A tâwpah i ṭhenawmten an tihmualpho hun chein, A tihngaihna i hre lo mai dah ang e.
  </para>
  <para style="p">
    <verse number="9" style="v" />I thubuai chu i ṭhenawmpa nên sawi dûn ula, Mi dang thurûk chu puang suh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A hretu chuan a hau vang chia, I hmingchhiatna a reh lo dah ang e.
  </para>
  <para style="p">
    <verse number="11" style="v" />A âwm tak thu sawi hi Tangkaraw bâwma rangkachak apple ang a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thu âwih bengah chuan Zilhtu fing chu, Rangkachak bengbeh leh rangkachak ṭha mi ṭhi ang a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />A tîrtute tâna palai rinawm tak chu, Buh seng laia vûr vâwt ang a ni, A pute nunna a tihharh ṭhin avângin.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pêk loh pui pea insawia uangthuang chu, Ruahtui pai lo chhûm leh thli ang a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dawhtheihnain rorêltu thlêm thlûkin a awm a, Thu nêm chuan ruhte a titliak ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khawizu i hmu ṭhîn em? A tâwk lekin in rawh; Chuti lo chuan, i la lua ang a, i luak leh dah ang e.
  </para>
  <para style="p">
    <verse number="17" style="v" />I ṭhenawm in tlawh cheh lutuk suh, A ning ang chia, a haw dah ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mahni ṭhenawm chungchânga dâwt sawi chîng chu, Tuboh te, khandaih te, thal hriam tak te a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mangan laia mi rinawm lo rin chu, Ha bal leh ke ruh pelh ang a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi lungngai hnêna hla satu chu, Khaw vawh nia sihfên hlih leh pema chingal leih ang a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />I hmêlma a ril a ṭâm chuan ei tûr pe rawh, A tui a hâl chuan in tûr pe rawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A lû chungah meiling i chhek khawm a ni ang a, Tin, Lalpan a rûl ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmâr thliin ruah a rawn thlen a, Chutiang bawkin mi rêl hmang leiin thinur hmêl.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmeichhe ân hmang tak nêna in zau taka awm ai chuan, In chung chhîp kila awm a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ram hla taka chanchin chu Mi tuihâl tak tâna tui vâwt ang a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi fel, mi suaksual kawng kiantu chu Tuikhur hnuchhawn hnu leh tuihna tihkhawloh ang a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khawizu in tam hi a ṭha lo va; Chutiang bawkin miin mahni ropuina an zawng hi ropuina a ni lo ve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mahni rilru thunun zo lo mi chu Khawpui chim kulh nei lo ang a ni.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nipuia vûr tla leh buh seng laia ruah sûr a inhmeh lo angin, Mi â tân chawimawina hi a inhmeh lo a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chawngzawng thlâwk thlâwk leh vamûr lêng lai angin, Vâng awm lova ânchhe lawh chu eng mah lo a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vuakna hrui chu sakawr tân a ni a, Thîrbarh chu sabengtung tân a ni a, Tiang chu mi a hnungzâng tân a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi â chu a ât dân angin chhâng suh, Amah ang i lo ni hlauh dah ang e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi â chu a ât dân azirin chhâng rawh; Chuti lo chuan, mi fingah a inngai mai dah ang e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi â thu chahtu chuan ama ke a tan a ni a, Ama chhiatna a in a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kebai kete chu a thên a thên a, Chutiang chuan tehkhin thu chu mi âte kâah chuan a ni ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi â chawimawi chu Lung intiang khâwm chunga lunghlu ip ang a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi âte kâa tehkhin thu chu, Zu rui mi kuta hlîng chhun ang a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi â leh mi veivâk ruai ṭhîntu chu, Thal kah thiam, mi hliam ṭhîntu ang hi a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi â a âtzia tilang nawn leh ṭhîn chu, Ui a luak hnu ei leh ṭhîn ang hi a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mahni ngaiha fing inti i hmu ṭhîn em? Chu mi ai chuan mi âah beisei tûr a tam zâwk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi thatchhia chuan, “Kawngah sakeibaknei a awm, Kawtthlêrah sakeibaknei a awm,” a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kawpzaa kawngkhâr a her vêl angin, Mi thatchhia chu a khumah a her vêl ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi thatchhia chuan thlêngah a kut a hnim a; A kâa thlen leh pawh a peih ṭhîn lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi pasarih thil chhût thiam ai pawhin, Mi thatchhia chu ama ngaihin a fing zâwk.
  </para>
  <para style="p">
    <verse number="17" style="v" />A inrawlh vena tûr pawh awm hauh si lova kal paha mi sual mai chu Ui kal lai a benga lo mantu ang a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ṭhenawmte buma, “Ka fiamthu a ni lâwm ni?” titu chu Mi â, meichher te, thal te, thihna tea mi tihṭhaihtu ang a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thing a ral avângin mei chu a thi a, Sêsêa thu sawitu awm lohnaah chuan inhauna a reh ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meiling chu meihawl tivâmtu leh thing chu mei tialhtu a ni angin, Ân hmang mi chu insualna tialhtu a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sêsêa thu sawi hmangte thu chu chaw tui tak ang a ni a, Pumpui chhûngrilah a lût ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thu sawi tlawr hmui leh thinlung sual chu, Hlumbêl, tangkaraw tuiêka luan ang a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi huat hmang a kâin a thup a, A thinlungah erawh chuan bumna a vawng ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ṭha taka thu a sawi pawhin ring suh, A thinlungah thil tenawm pasarih a pai si a.
  </para>
  <para style="p">
    <verse number="26" style="v" />A huatna chu bumnain thup mah sela, A suahsualna chu tlâng hriatah tihlan a ni ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khuarkhurum lai apiang chu, a chhûngah chuan an tla ang a, Tu pawh lung lum chu ama chungah a lo lum lêt leh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lei dawthei chuan ama hliamte chu a haw ṭhîn a, Fak derna kâ chuan thil a tichhe ṭhîn.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />A tûk lama thil lo awm tûr chhuang suh, Chumi ni chuan eng nge a rawn chhuahpui dâwn i hre si lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma kâa infak lovin mi dangin fak zâwk che sela; Nangma hmui ni lo, hmêlhriat loh mi hmuiin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lung hi a rit hle a, ṭiau vaivut pawh hi a khîn hle a; Nimahsela, mi âin mi an tihbuaina chu, Chumi pahnih ai pawh chuan a rit zâwk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thinurna chu a râwng a, thinrimna chu a so va; Mahse, îtsîkna chu tu nge tuar zo awm?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmangaihna inthup ai chuan A langa zilhhauna a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ṭhian min hliamna chu a tak a, Hmêlma min fawhna erawh chu a der a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi puar tân chuan khawithlâr pawh a tenawm a, Mi rilṭâm tân erawh chuan thil khâ zawng zawng pawh a tui a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi a hmun vah bosan chu, Sava a bu thlawh bosan ang a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hriak leh rimtuiin rilru a tihlim ṭhîn angin, Thinlung tak aṭanga lo chhuak ṭhian remruatpuina chuan a tihlim ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma ṭhian ngei leh i pa ṭhian chu thlauhthla suh; I vânduai niin i unaupa inah kal suh; Lamhla taka unau aiin lamhnaia ṭhenawmte chu an ṭha zâwk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka fapa, fing la, ka thinlung tilâwm rawh; Mi sawichhetute ka chhân theih nân.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi fing chuan thil ṭha lo a hmu a, a biru ṭhîn a, Mi mâwl erawh chuan a tâwn ṭhîn a, a tuar phah ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hnam dang tân mawhphurtua inpe silhfên chu la la, Ram dang hmeichhe tâna mawhphurtua inpe chu hrêngah hmang rawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zîng taka thova, ring taka a ṭhian malsâwmtu chu, A tân ânchhiaa ngaih a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khawchêng leh hmeichhe ân hmang chu, Angkhat an ni;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutiang nu khap beh tum chu, Thli hup beh leh hriak hûm beh tum ang a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thîrin thîr a tihriam a, Chutiang bawkin miin a ṭhian hmêl a tihriam.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tu pawh theipui kûng nei chuan a rah a ei ang a, Tu pawh a pu rawngbâwl chu chawimawi a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuia hmêl ngai ngai a lang angin, Mihring thinlung chu mihringah a lang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Seol leh Abaddon-in tâwk tih lêm a nei lo angin, Mihring mitin tâwk tih rêng a nei lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tihthianghlimna bêl chu tangkaraw tân a ni a, rawh tuina mei chu rangkachak tân a ni a, Mihring chu a thil fak zâwngah fiah a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi â chu buh nên sumah sukin dêng mah ula, A âtna chuan a thlah lo vang.
  </para>
  <para style="p">
    <verse number="23" style="v" />I berâm rualte awm dân chu hriat tumin taihmâk chhuah la, I ran rualte chu vêng ṭha rawh;
  </para>
  <para style="p">
    <verse number="24" style="v" />Sum leh paite chu chatuan atân a ni lo va; Lallukhum chuan chhuan zawng zawng a daih em ni?
  </para>
  <para style="p">
    <verse number="25" style="v" />Hlobet chu an ât a, hlobet no dep a lo lang a; Tlânga hlobet an la khâwm a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Berâmte chu i silhfên atân a ni a, Kêlte chu lo man atân;
  </para>
  <para style="p">
    <verse number="27" style="v" />I khawpkham tûr kêl hnutê a awm ang a, In chhûngkuaa ei atân, in nulate châwmna te nên.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi suaksualte chu tu ma ûm lohvin an tlânchhia a, Mi felte erawh chu sakeibaknei angin an huai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ramin a bawhchhiat chuan puipate an inthlâk zut ṭhîn a; Mi thil ngaih dân thiam leh hriatna neite erawh chu ram chuan a din rei phah ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi rethei hnehchhiahtu mi renchham chu, Ei tûr eng mah hnutchhiah nei lova thil lên bo vek ruah ang a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dân hawisantute chuan mi suaksual an fak ṭhîn a, Dân zâwmtute erawh chuan an kalh ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi ṭha lo chuan rorêl an hre thiam ṭhîn lo va; Lalpa zawngtute erawh chuan engkim an hre thiam ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi hausa awm dân dik lova awm ai chuan, Mi rethei awm dân dik taka awm chu a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu pawh dân zâwmtu chu fapa fing a ni a, Mi virte ṭhian erawh chuan a pa mualphona a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />A pung ûma a sum tipungtu chuan, Mi rethei lainattu tân a khâwlsak a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dân ngaithla duh lova hnuchhawntu chu, A ṭawngṭaina pawh tenawm a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi ṭha kawng ṭha lova kal botîrtu chu Ama hum laihah ngei a tla ang a, Mi ṭha famkimte erawh chuan thil ṭha an rochung ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hausa chu ama ngaihin a fing a; Nimahsela, mi rethei thil ngaih dân thiamte chuan an lailang ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi fel hlawhtlinnaah chuan ropuina nasa tak a awm a; Mi sual an dinchan erawh chuan mite an biru ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bawhchhiatna zêptute chu an hmuingîl lo vang a, Zêp lova inpuanga hawisantute chuan zahngaihna an hmu ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa ṭih reng mi chu a eng a thâwl a, Thinlung tikhauhtu erawh chu vânduainaah a tlu lût ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi rethei chunga rorêltu suaksual chu, Sakeibaknei rûm ang leh savawm pâwng vâk ruai ang a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil ngaih dân thiam lo hotu chu mi hnehchhiahtu a ni ṭhîn a, Awhna hawtu erawh chuan a dam chhûng a tisei ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi thisen phurtu chu Khuarkhurumah a tlân lût ang a; Tu mahin hum suh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tu pawh dik taka awm chu chhan chhuahin a awm ang a, Dik lo taka awm erawh chu a tlu thuai ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />A lei lettu chuan chhang a ngah ang a, Mi lêlo zuitu erawh chu a pachhe hle ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi rinawm chuan malsâwmna a ngah ang a, Hausak thuai tum erawh chu hrem lohvin a chhuak lo vang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi thlei bîk neih hi a ṭha lo va, Miin chhang them avângin an bawhchhe tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi fîr chuan sum a ûm a, A chungah tlâkchhamna a lo thleng dâwn tih a hre lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leia mi fak dertu ai chuan, Mi zilhtu chuan a hnua fak a hlawh tam zâwk ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />A nu emaw, a pa emaw rawka, “Bawhchhiatna a ni lo ve,” titu chu, Tiboraltu ṭhian a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi rilru duhâm chuan inbeihna a chawk chhuak a, Lalpa a rinna nghattu erawh chu tihthauvin a awm ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mahni rilru ring maitu chu mi â a ni a, Fing taka chetla mi erawh chu chhan chhuah a ni ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi rethei thil petu chuan a tlachham lo vang a, Maimitchhînsantu erawh chuan ânchhia nasa tak a dawng ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi suaksual an dinchanin mite an biru a, An boralin mi fel an pung ṭhîn.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zilhhau fo pawha a ring tikhawng tlat chu, Vawi leh khatah tihtliahin a awm ang a, tihdamna a awm lo vang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi fel an lo pun hian mite an lâwm ṭhîn a, Mi sualin rorêlna an chanin mite an rûm ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Finna ngainatu chuan a pa lâwmna a thlen a, Nawhchizuar pâwltu chuan a sum a tirîral ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dik taka lalin ro a rêl chuan ram a phuisui a, Thamna a lâk chuan ram a chhe ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ṭhenawm fak dertu chuan A ke tân lên a zam a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi ṭha lote bawhchhiatnaah chuan thang a awm a, Mi fel erawh chu a zai a, a hlim.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi fel chuan mi rethei thu a hriatsak a, Mi suaksual erawh chuan hriatna tûrin ngaihthiamna a nei lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmusittu chuan khawpui a tialh a, Mi fing erawh chuan thinurna a tikiang ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi fingin mi â a hnial chuan, A thinur emaw, a nui emaw, inremna a awm lo rêng rêng ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thisen chhuah châk mite chuan mi ṭha famkim an hua a, Mi dik takte erawh chuan a nunna humhim an tum ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi â chuan a thinur thu zawng zawng a sawi chhuak a, Mi fing erawh chuan an thup a, An ngawihpui ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rorêltuin dâwt thu a ngaihsân chuan, A chhiahhlawhte zawng zawng an sual ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi rethei leh hnehchhiahtu an awm dûn a, Lalpan an mit a tihvârsak ve ve a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi retheite rinawm taka rorêlsaktu lal chu, A lalṭhutthlêng chu kumkhuaa tihngheh a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tiang leh zilhhaunain a tifing a, Naupang thlahthlam erawh chuan a nu zahna a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi sual an lo punin bawhchhiatna pawh a pung ṭhîn a, Mi fel erawh chuan an tlûkna chu a la hmu ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />I fapa chu thunun fel la, chawlhna a pe ang chia, A ni, i rilru lâwmna a thlensak ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Inlârna a awm loh chuan mipui an tladah ṭhîn a, Dân zâwmtu erawh chu a nihlawh ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chhiahhlawh chu thu maia thunun mi a ni lo, Hre mah sela engah mah a ngai lo vang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thu sawi thuai thuai mi i hmu ṭhîn em? Chu mi ai chuan mi âah beisei tûr a awm tam zâwk.
  </para>
  <para style="p">
    <verse number="21" style="v" />A naupan têt aṭanga chhiahhlawh duat chuan, A tâwpah in ro pawh a chuh ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi thinurin insualna a chawk chhuak a, Mi thinrimin bawhchhiatna a ngah ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi a chaponain a titlâwm ang a, Mi rilru inngaitlâwm chuan chawimawi a hlawh ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rûkru kawppuitu chuan ama nunna a hua a ni; Chhechham ri a hria a, eng mah a sawi si lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi dang ngaih dân pawisak luat a hlauhawm a, Lalpa a innghah erawh chu a him.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi tam takin rorêltute duhsak hlawhna an zawng a; Mahse, mihring chunga rorêlna chu Lalpa hnên aṭanga lo chhuak a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi fel lo chu mi fel ngaihin tenawm a ni a, Tin, dik taka awm mi chu mi suaksual tân tenawm a ni.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakeha fapa Agura thute: Thufing chu. Miin Ethiela hnênah, Ethiela leh Ukala hnênah heti hian a ti,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi ahluanah ka mâwl ber a, Mihringin hriat thiamna an neih hi ka nei lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Finna ka zir lo va, Mi Thianghlima hriatna ka nei hek lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tu nge ni vâna chho tawha, Lo chhuk leha chu? Tu nge ni a kuta thli hûm khâwmtu chu? Tu nge ni a puana tui fûntu chu? Tu nge ni kâwlkil zawng zawngte tinghet? Tu nge ni a hming, tu nge ni a fapaa hming pawh i hria em?
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa thu zawng zawng chu fiah a ni tawh, Amah ringtu zawng zawng tân ani chu phaw a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thute chu belhchhah suh; Chuti lo chuan, a lailang ang chia, Dawthei i lo ni dah ang e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thil pahnih ka dîl chia, Ka thih hmain rem ti lul ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thil lawi lo leh dâwtte chu mi tihsawnsak daih ang che; Pachhiatna emaw, neihnunna emaw mi pe suh la, Ka tâna mamawh chawin mi châwm rawh;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuti lo chuan, ka tlaipuar ang a, ka phat ang chia, “ Lalpa chu tu nge ni?” ka ti dah ang e; A nih loh vêk leh ka lo rethei ang a, rûk ka ru ang a, Ka Pathian hming ka tihliau dah ang e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chhiahhlawh chu a pu hnênah rêl suh, Ânchhia a lawh ang chia, Thiam loh i hlawh dah ang e.
  </para>
  <para style="p">
    <verse number="11" style="v" />An pate ânchhia lawha, An nute malsâwm lo chhuan an awm.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mahni ngaiha thianghlim inti chhuan an awm a; Nimahsela, an bawlhhlawhna tlen fai a ni si lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ṭha inti êm êmte an awm a, Ṭha an va inti tehrêng êm!
  </para>
  <para style="p">
    <verse number="14" style="v" />An hâ chu khandaih ang, an ha hnuai lam chemtê ang chuan an awm a, Leilung ata mi rethei leh mihring zîng ata mi renchhamte ei zo tûrin.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Mi pe rawh, mi pe rawh,” tia au fanu pahnih nei saihlît a awm a. Thil pathum, kham lêm nei lo a awm a, E, thil pali a ni, “A tâwk e,” ti ngai lote:
  </para>
  <para style="p">
    <verse number="16" style="v" />Thlân leh chhûl ching, Tui khawpkham lo leilung leh, “A tâwk e,” ti ngai lo mei.
  </para>
  <para style="p">
    <verse number="17" style="v" />A pa hmusittu leh A nu thu âwih ngainêptu mit chu Phai choâkin an kher chhuak ang a, Mupuinoten an ei ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil pathum ka tâna mak lutuk a awm a, E, thil pali a ni ka hriat loh chu:
  </para>
  <para style="p">
    <verse number="19" style="v" />Boruaka mupui kawng, Lung chunga rûl kawng, Tuifinriata lawng kawng, Mipain nula a panna kawngte.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutiang chu a ni, hmeichhe uire hmang kawng chu; A ei a, a hmui a hru fai a, “Thil sual eng mah ka ti lo,” a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thil pathum avângin leilung a khûr ṭhîn, Thil pali a ni, tuar theih lohte:
  </para>
  <para style="p">
    <verse number="22" style="v" />Chhiahhlawh chu lal a lo niha, Mi â chu buh leh saa a lo tlaia,
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmeichhe huatthlala takin pasal a lo neiha, Chhiahhlawh nulain a pi ro a luahin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thil tê tham tê pali lei chungah hian a awm a; Mahse, an fing hle reuh mai:
  </para>
  <para style="p">
    <verse number="25" style="v" />Fanghmîr hi chak lo tak an ni a: Nimahsela, ṭhâlah an chaw tûr an khâwl khâwm ṭhîn;
  </para>
  <para style="p">
    <verse number="26" style="v" />Sazupui hi chhiaṭha tak an ni a; Nimahsela, lungpuiahte an awmna an siam ṭhîn;
  </para>
  <para style="p">
    <verse number="27" style="v" />Khaute hian lal an nei lo va; Nimahsela, a rualin an kal ṭhîn;
  </para>
  <para style="p">
    <verse number="28" style="v" />Daidêpte hi an kein an inham tâng ṭhîn a; Nimahsela, lal inah an awm ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thil pathum an awm dâna ropui tak an awm a, E, pali a ni, an awm dâna ropui tak chu:
  </para>
  <para style="p">
    <verse number="30" style="v" />Sakeibaknei chu ramsa zîngah a chak ber a, Eng mahin a tilêt zo lo va;
  </para>
  <para style="p">
    <verse number="31" style="v" />Ui sa thiam; kêlpa pawh; Lal, tu mah amah beitu awm lo chu.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangmah inchawisâng tûra thil âthlâk tak i lo tih tawh emaw, Thil ṭha lo i lo ngaihtuah tawh emaw a nih chuan, I kâ hup rawh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hnute tui chawhin hnutekhal a rawn tichhuak ang leh, Hnâr sâwra thi a lo chhuak angin, Tihthinur luihnain inhauna a hring ṭhîn.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lal Lemuela thute, thufing, a nu zirtîrte chu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka fapa, aw ka rîla rah, Aw, ka chhechham fapa, lo ngaithla teh.
  </para>
  <para style="p">
    <verse number="3" style="v" />I chakna chu hmeichhia pe suh la, Lal tichhe ṭhîn hnênah i nunnate pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Lemuel, lalin uain in tûr a ni lo va, Rorêltuten, “Khawiah nge rakzû?” an ti tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />An in chuan dân an theihnghilh ang a, Mi retheite chungah ro an rêl dik lo dah ang e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Boral dâwn ṭêpte chu rakzu pe ula, Mi lungngai chu uain pe rawh u.
  </para>
  <para style="p">
    <verse number="7" style="v" />In sela, a pachhiatna chu theihnghilh sela, A hrehawmzia chu hre reng lo rawh se.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ṭawngtheilote tân i kâ âng la, Hnuchhawnho zawng zawng chungchâng thûah te.
  </para>
  <para style="p">
    <verse number="9" style="v" />I kâ âng la, fel takin rorêl la, Mi rethei leh renchhamte chungah rorêl rawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmeichhe khawsak ṭha tu nge hmu thei ang? A man chu lunghlu sen mi aiin a sâng zâwk daih si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pasal thinlung chuan a ring a, Chhawrna a hmai lo vang.
  </para>
  <para style="p">
    <verse number="12" style="v" />A dam chhûngin Chhe lam ni lovin, ṭha lam hlîrin thil a tihsak ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Berâm hmul leh la a zawng a, A kutin lungawi takin a thawk ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sumdâwng lawng ang a ni a, Ram hla tak ata ei tûr a la ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khawvâr hmain a tho va, A chhûngte ei tûr a pe ṭhîn a, A chhiahhlawh nulate hnênah an tih tûrte a hrilh ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan tûr a ngaihtuah a, a lei a, Ama kutkawih ngeiin grêp huan a siam ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chaknain a kâwng a hrêng a, A bânte a tichak ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />A sumdâwnna a hlâwk tih a hria a, Zânah pawh a khâwnvâr a mit ngai lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kutin hmui kut a chelh a, A kutin hmuithal a vuan a.
  </para>
  <para style="p">
    <verse number="20" style="v" />A kut mi rethei lamah a phar a, A ni, renchhamte thlengin a ban phâk a.
  </para>
  <para style="p">
    <verse number="21" style="v" />A chhûngte vûr a hlauhsak lo va; A chhûngte zawng zawng chu puan sen lâr sinin an awm si a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chhuatphah puan mawi a insiam a, A silhfên chu lazai sîn mi leh puan sen duk a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kulh kawngkâa an ram upate nên an ṭhut hovin, A pasal chu a hriat a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lazai sîn silhfên a siam a, a zuar ṭhîn a, Sumdâwngte hnênah kâwnghrênte a thawn ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />A silhfên chu chakna leh ropuina a ni a, Hun lo la thleng tûr atân pawh a nui a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Finnain a kâ a âng a, A kâah chuan ngilneihna thu a awm.
  </para>
  <para style="p">
    <verse number="27" style="v" />An chhûng khawsak dân a en ṭha a, Dâwngdahna chhang a ei lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />A fate chu an tho va, “Engthâwli” an ti a; A pasal pawhin a fak a:
  </para>
  <para style="p">
    <verse number="29" style="v" />“Hmeichhe tam tak khawsak ṭha an awm a; Mahse, nang chuan i khûm vek a ni,” tiin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Duhsakna hi bumna a ni a, hmêl ṭhatna chu eng mah lo a ni; Lalpa ṭihtu hmeichhia erawh chu fak a ni ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />A kutkawih chhuah chu pe la, A thiltihin kulh kawngkaah chuan fak rawh se.
  </para>
</usx>
