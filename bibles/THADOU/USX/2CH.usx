<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2CH" style="id">2 Thusimbu</book>
  <para style="h">2 Thusimbu</para>
  <para style="toc1">2 Thusimbu</para>
  <para style="toc2">2 Thusimbu</para>
  <para style="mt">2 Thusimbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David chapa Solomon chu alenggama chun hatah-in akisuhat tan, Pakai a-Pathen'in aumpin, nasatah-in achoisang tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Solomon'in Israelte jouse, sepai sang lamkaiho, ja lamkaiho, thutan ho, Israel pumpi sunga gamvaipo jouse, phung upaho henga thu aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun Solomon chule aumpi houkhom ho jouse chu Gibeon'a um munsanga chun acheuvin ahi; ajehchu hia chu Pakai soh Mosi'n gamthipma anasem Pathen houkhom ho Houbuh chu uma ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla Pathen thingkhong chu David'in Kirjath-jearim'a konin akoina dinga asemna chun apotou tan ahi; ajehchu hiche dinga chu Jerusalem'a ponbuh khat anasonsa ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukalvalin Hur chapa, Uri chapa, Bezaleel in'a anasem sum-eng maicham chu Pakai houbuh maija chu akoi ahin; Solomon le houkhom ho chun hichu aholun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakai angsunga um sum-eng maicham phunga chun Solomon achetouvin, hichu houkhom ho Houbuh-a uma ahin, achunga chun govam thilto sangkhat jen atoh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche janchun Solomon henga Pathen akilah-in, ahenga, Thumin, ipi kapeh ding ham, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Solomon'in Pathen henga, Nangman kapa David henga hepina lentah namusah-in, ama khelin keima neilengchan sahtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuhin, vo Pakai Pathen, kapa David henga nathutep chu guilhun sahtan: ajehchu leivuibanga tam miho chunga hi lenga neitun ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche miho anga kavaikon kavailhun theinadin, chihna le hetna neipen; ajehchu hibangse-a tam nam mite hi kon thu atanjou dingham? atin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pathen'in Solomon jah-a, Hiche lungthimhi navopma, haona, neile gou, jabolna, namelmate hinkho, ahiloule nangma hinkho sotna jong thumlouva; achunguva lenga kapansah kamite thu natan theina dinga, chihna le hetna naki thumjoh jeh-in:
  </para>
  <para style="p">
    <verse number="12" style="v" />Chihna le hetna chu kapeh nahitan; chule nangma masanga anaum lengho khatchan jong ananei khahlou, nanunga honjong aneikhah loudiu haona, neile gou, chule jabolna jong kapeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin Solomon chu Gibeon'a um munsanga, houkhom ho houbuh masang akholjina-a konin Jerusalem'a ahungin, Israelte chunga vai ahomtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Solomon'in kangtalai ho le sakol chung touho akhomin: aman kangtalai sangkhat le jani, chule sakol chunga tou mi sangsom le sangni aneijin, hicheho chu sakol kangtalai khopiho-a le lengpa umna Jerusalem'a akoijin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Jerusalem'a chun lengpan dangka le sana song bangkhopma nengin akoijin, chule cedar thing chu phaichama theiba thing tam bangkhopma neingin aum sah-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Solomon'in tupat kikheh ho chu Egypt'a konin sakol ho ahin toldoh sah-in; lengpa sumkol veihon tupat kikheh ho chu aman apeh uva akilahjiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon kangtalai khat chu dangka shekel jagup din Egypt'a konin ahintoluvin; hitichun Hit miho lengte jouse dingle Syria lengho dingin sakolhochu amaho minin ahin toldoh jiuvin ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Solomon'in Pakai min dinga in khat le alenggama dinga in khat sah ding agel lhutai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Solomon'in pohgih poding mi sangsomsagi, molsanga song khengding mi sangget, chule avetupdiu mi sangthum le jagup alhengdoh tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Solomon'in Tyre lengpa Huram henga mi asolin, Kapa Davidn'in achenna ding in khat akisahna dinga cedar thing nathotna nabolna bangin keimatah jong neibolin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vetan, choldo nikho, lhathah nikho, chule Pakai ka Pathen'u kutpi nikhoho le ama henga katdoh ding, amasanga gimnamtui halna ding, tanglouva vetsahna changlhah tona ding, chule jingkah nilhah-a govam thilpeh bolna dinga Pakai ka Pathen mina inkhat kasah ahi. Hichehi Israelte dinga a-itih-a houdan thupeh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule ka-in sahhi lentah ahin; ka Pathen'u hi pathenho jouse sanga lenjo ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla vanle vanho van jengin jong ama adoljoulou ahin, kon ama dinga in asahpeh jou dingham? Ama anga ganlhaina kago tailou, kei koi kahia ama dinga in kasahpeh thei dingham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun kapa David'in anamanchahsa Judah le Jerusalem'a kaumpi natongthem hotoh tongkhom dingin, sana, dangka, sum-eng, thih, pon asandup, asanthip, adum ho jouse-a thepna nei mikhat neihin solpeh-in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Labanon'a konin cedar thing, chah thing, algum thingho jong neihin tolpeh-in; ajehchu nasohte chu Lebanon thing tuhdan athemuve ti kahei; chule vetan, keima sohten nangma sohte kithopiu vintin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Thing nengtah-a eigonpeh dingu ahi; ajehchu ka in sahgot hi kidangtah-a len hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule, vetan, nasohte, thing phuh-a tanho chu suhlou chang kigoibong tena sangsomni, sakolchang tena sangsomni toh, lengpitwi tena sangsomni, chule thaotwi tena sangsomni kapeh ding ahi, tin mi agahsole.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin Tyre lengpa Huram'in sut tho-in adonbutnin, Solomon athot tai; Pakaiyin amite angailut jeh-in, nangma achunguva lengin nasemtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Achung chonin Huram'in aseiben, Van le lei sempa, Pakai dinga in khatle alenggam dinga in khat sathei dinga David dinga chihna le hetkhen themna nei chapa chingtah khat pepa Pakai Israel Pathen chu nunnom hen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule tun keiman kapate Huram mi, mithemnal, hetkhen themma nei mi khat kahin solpeh-e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama Dan chanute numei khat chapa, apachu Tyre mi ahin, sana-a, dangka-a, sum-enga, ponduma, tupat ponnema, ponsanthip lama themtah ahin; thiljem jouse khengthei, boldinga kigonpeh jouse boldohthei ahin, nangma khutthemho le kapu David napa khutthemho toh kithothei ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun tuhin ka pakaiyin anaseisa suhlou chang, sakolchang, thaotwi, lengpitwi chu asohte henga hinthot tahen;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keihon Lebanon'a konin nangaichat dingjat jat chu phuh ungting; keihon nahenga Joppa geijin twipi chunga puma kahin toldiu, chule nanghon Jerusalem geija naki lhoh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Solomon'in apa David'in anasimsa bangin, gamsunga um gamdangmi jouse asimin; amaho chu sangjakhat le sangsomnga chule sangthum le jagup asimdoh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amaholah-a sangsomsagi chu thilgih poding, mi sangsomget chung molchunga song khengding, chule mi sangthum le jagup chu anatoh-u vetup dingin apansah tan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Solomon'in Jerusalem'a um Moriah molsang, apa David henga Pakai kilahna mun, Jebus mi Ornan pholmun David'in anagona mun'a chun Pakai in chu asapantan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Alengchan kum lina, alhani na, nini chan nin insah akipantan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun hichehohi Pathen in kisah dingdan Solomon anakihil chu ahi. Adunglam chu tena masa dungjuijin tong somgup ahin, avaichu tong somni ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule inmai lama um hongcha dunglam chu invai dungjuijin tong somni ahin, asanlam tong jakhatle somni ahin: asunglam chu sana theng twijin aloijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule aman in alenjo sung chu chahthingin athopmin, hichu sana thengin aloijin, achunga chun tumthingho le thihkhao kiphan lim aseme.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin in chu ahoinadin song mantamin ajemin, sana chu Parvaim gam sana ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman in chu a-inkamho, akhomho, abangho, akotho chu sana in aloijin; bangho chunga chun Cherub limho asemin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman in theng chungnung asemin, adung chu invai dungjuija tong somni ahin, avai jong tong somnima ahi: chuin aman sana thengset talent jagup man jenin aloijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule akilnaho chu sana shekel somnga-a gih ahin, chule indan chungnung chu sana-a kiloi ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule intheng chungnung sunga chun Cherub ni lim asemin, sana in aloijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cherub teni lhachu tong somni asaovin: Cherub khat lha langkhat chu tong nga ahin, inbang chu aphan ahi: hiche bang chun alha langkhat jong tong nga ma ahin, Cherub khatpa lhaving chu aphai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Cherub khatpa lhaving langkhat chu tong nga ahin, inbang chu aphan; alhaving dang jongchu tong nga ahin, Cherub khatpa lhaving chutoh akimatnin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche Cherub teni lhavingho chu tongsomni akijalin, amani akengin adinglhonin, amailhonin sunglam angatgel lhone.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman ponjal adum, asanthip, asandup, chule tupat ponnem asemin; achunga chun Cherub ho lim achonsah-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman inmaija chun khom ni tong somthum le nga sanggel jong asemin, achungvuma alujum lhon chu tongnga gel ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman muntheng insunga bangin thihkhao kiphan asemin, khomteni leh-a akhaijin, chule khombula chun kolbuthei lim jakhat asemin, thihkhao kiphana-a chun akoije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman Houin maija chun khompi ni, khat chu jetlama, khat veilama atungdoh-in; chule jetlama pa minchu Jachin asah-in, veilamapa minchu Boaz asah-in ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin aman sum-eng maicham, adung tongsomni, avai tongsomni, chule asan tongsom khat asemin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman twikonglen ageilang khatna pat langkhat kah chu tongsom lha-a akimvel kikolkhum ahin, chule asanlam chu tong nga asangin asemin, chule khaojang tong somthum khatnin akimvel akolkhumin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anoilam chu bongchalho lheh lheh abangin, hiche lim chun akimvelin akolkhumin, tong khatna som cheh-in twikong chu akimvelin ahi. Hiche kisun laija chu bongchal lim golnia kisung ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichu bongchal somleni chunga chun adingin; thumin sahlam angan, thumin lhumlam angan, thumin lhanglam angan, chule thumin solam angai: chule twikong chu hitiho chungvuma chu kiluija, atou chu akholut cheh-u ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Asadan khutphang chana sa ahin, agei chu khongeija molhoipah kisem tobang ahin; hichun bath sangthum adole.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman twidol jong som asemin; kisilna dingin jetlama nga akoijin, veilama ngama akoijin ahi: hicheho sunga chu govam thiltoho asopjiu ahin, ahinla twikongho chu thempuho kisilna ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule agongu dungjuijin sana meivah khom som asemin; houin sunga jet lama nga, chule veilama nga atunge.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman dokhang som jong asemin, houin sunga chun jetlama nga chule veilama ngama akoije; chule sana twikong jakhat jong asemin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuche bana aman thempuho hongsung le kulpi, chule kulpi kotkhah asemin; chule kotho chu sum-eng in aloijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule twikong chu solam mong jetlam lhanglam jona chun akoijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Huram'in belho le vutloho, chule twikongho chu asemtan ahi. Chule Huram'in Pathen in'a dinga Solomon lengpa abolpeh natohho chu ajoutan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hetding chu khomteni, khombemho, khom teni lehvuma abohteni, chule khompiteni lehvuma abohtenia khombem teni khuna ding pahvuiteni;
  </para>
  <para style="p">
    <verse number="13" style="v" />Pahvui teni chunga kolbuthei jali, khomho chunga abohtenia khombem teni khuna ding pahvui khat khat chunga chu kolbuthei golnini ga ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman akhomho asemin, chule akhomho chungadin twidol ho aseme.
  </para>
  <para style="p">
    <verse number="15" style="v" />Twikong khatle anoija bongchal somleni asemin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Belho jong, vutlona le satulka; hicheho jouse hi apa Huram'in Pakai in'a dinga sum-eng duljetna Solomon lengpa asempeh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jordan phaicham Succoth le Zeradathah kikah-a hahlei laija lengpan alhahtho ngen ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hitichun Solomon'in hiche umle belho jousehi bulhing setnin asemtan ahi: ajehchu sum-eng ho gihchu hetsoh jouhoi ahitapoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Solomon'in Pathen in dinga umle belho jouse asemjouvin, sana maicham jong, chule achunga vetsahna changlhah kitoh koina dokhang jong;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chukalvalin muntheng pen masanga adan dungjuija adetjiu meivah khomhole ameivahho jong sanathengin asemin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule pahchaho, thaomei ho, chaicheho jouse jongchu sana thengselin asemin;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule thaomei ponchenaho, twikongho, thihkheho, gimnamtui lhengho chu sana thengselin asemin: insung lutna, muntheng chungnung kotkhah sungnung, chule houin kotkhah ho chu sana in asemin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun Pakai in dinga Solomon'in aboljouse chu jo ahitan: Solomon'in apa David'in anakatdohsa thil jouse; chule sana, dangka, chule manchah jouse chu Pathen in thilkholna lah-a chun ahin polut tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Solomon'in Israel upa hole phung upaho, Israel chate upaho lamkai jouse chu David khopi Zion'a kona Pakai kitepna thingkhong podoh din Jerusalem'a akhomin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun Israel mite jouse lha sagi lhinna kut-a chun lengpa henga akikhom taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Israel upaho jouse ahungun; Levi ho chun thingkhong chu apodoh taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahon thingkhong, houkhom ho houbuh, chule houbuh sunga um le bel thengho jouse ahinpo touvun; hichehohi thempuho le Levi ho hinpohtou ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Solomon lengpa le ahenga thingkhong maija mipi kikhom Israel hou lamkaiho jouse chun kelngoiho le bongchal ho-a kilhaina abolun, hichu atambehseh jeh-in seijougol ahitapoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin thempuho chun Pakai thulhun thingkhong chu ama mun, houin'a muntheng lai, muntheng chungnung pena chun Cherubim lhaving noi ngeija ahinpolut taovin ahi:
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Cherub teni lhaving chun thingkhong kikoina ding chung chu akhu ahin, chule Cherub teni chun thingkhong le achunga amoljol teni chu akhu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin thingkhoga moljol teni chu asao behseh jeh-in, munthenga konin akimuphan ahi; ahin polama vang akimupoi. Hitichun hikoma chun aumjing nalaije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thingkhong sunga chu Egypt'a kona ahungdoh laiju, Pakaiyin Israel chatetoh Horeb mun'a kitepna asem laija, Mosi'n anakoilut songpheng teni tailou imacha umlou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, Thempuho chu munthenga kona ahungdoh phatnun, (ajeh chu thempu aumho jouse kisutheng cheh jiuva ahin, ahona kingahlou ahiuve:
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujongle Levi lasaho jouse, Asaph'a kon jouse, Heman'a kon, Jeduthun'a kon, achapateu le asopiteu jouse chu tupat ponbangleh-a akivonun, thih khutbehho, tumgingho, selangdah ho akichoijun, maicham mong solama chun adingun, chule amaho chutoh sumkon mut thempu jakhat le somni dinguva ahi:)
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahung hitin ahi, Pakai vahchoina le thangvahna aw akijah nadinga sumkon mut hole lasaho chun awkhat banga ahin ginsah uva; sumkon le thih khutbeh chule tumgingthei manchah ho jouse to kitho-a apenuva, Ama aphai, ijeh inem itile ahepina atonsotnin aum jinge, tia Pakai avahchoi laijun: Pakai houin ngeichu meilhangin adiptan;
  </para>
  <para style="p">
    <verse number="14" style="v" />Meilhang jehchun thempuho chu kinbol dingin ading thei tapouve: ajehchu Pathen in chu Pakai loupi na-in adip ahitai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Solomon'in, Pakaiyin muthim lhangkhal kiheh lah-a kachending ahi, tin anaseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijongle naum nading le, tonsotna nachenna ding mun hidingin in khat kasahpehtai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpan amai aheijin, Israel houkhom ho jouse chu phatthei aboh-in: chule Israel houkhom ho jouse chu adingdoh-un ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman, kapa David henga akamtah-a anaseisa akhut tah-a guilhun sah-a Israel Pakai Pathen chu nunnom hen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman kamite Egypt gama kona kapuidoh nikho-a patnin kamin umna dinga in khat sahna dingin Israel phung jouse sunga khopi khatcha kanalheng khapon; kami Israelte chunga vaipo dingjong mi khatcha kana lheng khapoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla keiman Jerusalem chu kamin umtheina din kana lhengin; kami Israelte chunga vaihomdin David chu kana lhengin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun Israel Pakai Pathen dinga in khat sahdoh ding chu kapa David lungsunga ana umin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Pakaiyin kapa David henga, Kamin dinga in sah ding nalunga nagela, hitobang lungtup chu nalunga aumjeh-in aphalheh jenge;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeng jongle in chu nangman nasah louding ahi; amavang nataijola hungpeng nachapa chun, kamina in chu asahding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh-a chu Pakaiyin anaseisa chu aguilhunsah ahi. Ajehchu keima kapa David indan sunga kahung seilenin, Pakai thutep bangin Israel laltouna-a katouvin, Israel chate Pakai Pathen min dingin in chu kasatan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hiche sunga chun Pakaiyin Israel chatetoh anasem kitepna thingkhong chu kakoitan ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ama Israel houkhom ho jouse mitmun Pakai maicham anga chun adingin, akhut ajah-in:
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu Solomon'in sum-eng dokhang tong nga sao, tong nga len chule tong thum sangkhat asem ahin, hichu hongsung lailunga atun ahi. Chuin hiche chunga chun adingin, Israel houkhom ho jouse masanga chun adilsun, akhutnin vanlam sangin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitin ati, Vo Pakai, Israel Pathen, nangma banga akitepna subulhit, namasanga alung pumpiuva vahlea nasohte henga hepina musah-a van'a ahin leija ahin jong Pathen dang aumpoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman nasoh kapa David henga nana thutep jouse nasubulhit nin; nakamtah-in nanaphong doh-in, tunikho banghin nakhut tah-in namolso tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun tun, Vo Pakai Israel Pathen, nasoh kapa David henga, Nachate chu kamasanga nangma chonna banga alamlhah uva, chule kadanthu dungjuija alamlhah na diuva achihthei pou uva ahile; kamitmu-a Israelte laltouna-a touding mi lhasam louding ahi, tia nana thutep chu molsotan.
  </para>
  <para style="p">
    <verse number="17" style="v" />Achutile tun, vo Pakai Israel Pathen, nasoh David henga naseisa thu chu subulhit teijin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla Pathen chu leisetna hin mihemte toh achengkhom mong nadem? Vetan vanle vanho van'in jong nadolou ahin, keiman kasah hiche inhi iti neojocheh-a hitam!
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun vo Pakai ka Pathen, nasoh taona le thumna hi jabolpeh inlang, na angsunga nasohpa taona le pen nahi ngaipeh-in:
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nasoh-in hiche lam nga-a ataona nangaipeh na dingin; kamin kakoi ding ahi tia nanaseina mun, hiche in hi asun ajanin ve jingin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun nasohpa le nami Israel ten hichemun lam nga-a ataonao chu ngaipeh-in: nachenna mun van'a konin ngaijin lang, najahpeh tengle ngaidamtan.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi khattou aheng akom douna-a achonsetna, kihahselsah dinga achunga thutep achuh-a, hiche akihahsel dingpa chu hiche insung namaicham masang ahi ahunga ahile,
  </para>
  <para style="p">
    <verse number="23" style="v" />Van'a konin hinngaijin lang na hintongin, nasoh chu athu tanpeh-in; michonpha chu themchanna le, achonphatna dungjuija lethuh inlang; migilou chu ama luchang ngeija phulahna chuhsah-in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule nangma douna chonset aboljeh uva, nami Israelte chu amelmateu masanga aleluva; ahung kile heijuva, namin aphondoh uva, hiche insungahi na-angsunga taona le thumna aneijuva ahile;
  </para>
  <para style="p">
    <verse number="25" style="v" />Van'a konin hin ngaipeh inlang, nami Israelte chonsetna chu ngaidamin, chule nangman amaho le apu apateu nanapeh gama chun hinlepui kitnin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangma douna-a achonset jeh uva, van akikha-a, go julouva aumteng; amaho hiche munlam nga-a atao uva, namin aphondoh uva, namgman nasuh genthei jeh uva, achonset naova kona ahung kileuva ahile;
  </para>
  <para style="p">
    <verse number="27" style="v" />Van'a konin hinngaijin lang, ajot dingu lampi pha nahil theina dingin, nasohte le nami Israelte chonset ngaidamin; chule alodinguva namite nanapehna nagam chunga hin go hinjuh sah-in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Gamsunga kel alhah ham, hise alan ham, huise anun ham, thinglung ahiloule khaokho alan hama; melmaten agamsungu khopiho-a chu aumchah-uham; itobang hise ham ahiloule itobang natna hijongle alanteng;
  </para>
  <para style="p">
    <verse number="29" style="v" />Amitakipmin apohgih ule alung khamna cheh akihetdoh uva, hiche in lam nga-a akhut ajah uva, changval ham ahiloule Israel mipi jousen, itobang taona hihen, itobang thumna hijong le ahin nei tengule;
  </para>
  <para style="p">
    <verse number="30" style="v" />Nachenna van'a konin ngaipeh inlang, ngaidamin, chule alunggelu nahet bangin, mitin alamlhah dungjui cheh-un lethuh-in; (ajehchu nangma bouvin mihem chate lungsung nahet ahi.)
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutia chu kapu kapateu nanapehna gamsunga hi achenlai seuva nalampi ajot nadinguva nagin dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chukalvalin namin loupitahle nakhut thahat tah, chule naban jahdoh jala gamlatah-a kona hung nami Israelte hilou gamdang mi thudola; amaho ahunguva hiche insunga hi ataovuva ahile;
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuteng nachenna mun vanho ngeija konchun ngaijin lang, gamdang mipan nakoulona pen dungjui chun bolpeh-in; chutile leiset mite jouse namin ahet dingu, nami Israel ten nagin banguva nagin diu, chule keiman kasah hiche inhi namina kivo ahi ti ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Namite chu nangman nasolna lampia amelmateu satdinga akondoh uva, nangman nalhendohsa hiche khopi lam le nangma min dinga kasah hiche in lam nga-a hi ahung tao uva ahile,
  </para>
  <para style="p">
    <verse number="35" style="v" />Nangman van'a konin ataonao le athumnao ngaipeh inlang, athu-u bolpeh in.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amaho nangma douna-a achonsetnuva, (ajehchu achonse lou khatcha umlou ahi,) nangma achunguva nalunghana, amelmateu henga napeh doh-a, amahon gamlatah ham naicha hama sohchanga akaimang uva ahile,
  </para>
  <para style="p">
    <verse number="37" style="v" />Hijongle sohchanga akikainao gama chu ahung kingaito uva, asohchannao gama chu ahung kiheijuva nahenga ahung tao uva, Keiho kana chonseuvin, kasukhelun, chule giloutah-in na katonguve atiuva;
  </para>
  <para style="p">
    <verse number="38" style="v" />Soh-a akikainao asohchannao gama kona chu alung pumpiu le ahinna pumpiuva nangma lama ahung kiheijuva, apu apateu nanapeh gam le nangman nanalhen khopi, chule keiman namin dinga kasah hiche in lam nga-a hi ahungtao uva ahile;
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuteng ataonao le athumnao chu nachenna mun van'a kon ngeichun ngaipeh inlang, athu chu bolpeh-in; chule nangma douna chonsea namite hi ngaidamin.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tun, ka-Pathen, kangeh nahi, hiche mun'a taona kimanna-a hin, namit hasah inlang, nana hinsungin.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hijeh chun tun, vo Pakai Pathen, nacholdona mun'a dingin nangma chule nathahatna thingkhong toh kipatdoh-in; vo Pakai Pathen nathempu ho chu huhhingna-in kivonu henlang, namithengte chu phatna-a kipah uhen.
  </para>
  <para style="p">
    <verse number="42" style="v" />Vo Pakai Pathen, nathaonupa mai chu heimang hih-in, nasoh David hepinaho chu geldoh-in, ati.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Solomon taojou phatnin, van'a konin mei ahungleng lhan, govam thilto le ganlhaina hochu akavamin, houin chu Pakai loupina adimtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakai in chu Pakai loupina adimjeh-in, Pakai insunga chun thempuho alutthei tapouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Israel chate jousen mei ahung lenlhah le in chunga Pakai loupina ahung kumlhah chu amuphatnun, tolla songlhongnal chunga amaiju asulutnun, Pakai chu ahouvun, avahchoijun, Ama aphat jeh-in, ahepina tonsotnin aumjinge, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lengpa le mijouse chun Pakai angsunga chun ganlhaina atoh taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Solomon'in bongchal sangsomni le sangni toh, kelngoi sang jankhatle sangsomni in kilhaina abolin; hitichun lengpa le mijouse chun Pathen in chu athenso taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin thempuho chu atohmun cheh uva adingun; chule Levi ho jong chun David'in, Ajehchu ahepina atonsotnin aumjinge tia Pakai vahchoina dinga anasem, Pakai tumging thei manchah ho chu akichoijun; chuin thempuhon mipi angsunga chun sumkon amutnun ahile, Israelte jouse chu adingdoh sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chukalvalin Solomon'in Pakai in maija hongsung lailung chu athenson ahi: ajehchu Solomon'in asem sum-eng maicham chun govam thilto le anneh thilto, chule thao thilto chu adol joulou jeh-a, govam thilto le chamna thilto thao ho chu hikoma chu atou ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche sung mama chun Solomon le akoma um Israelte jouse, Hamath lutna-a pat Egypt vapi geija hung kikhom mipi atama tam chun nisagi kut amangun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin niget lhinin kikhoppi loupitah abolun ahi: ajehchu amahon maicham thensona chu nisagi amanuva, kut chu ni sagima amanu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin lha sagina, nisomni le nithum ni chun, Pakaiyin David le Solomon chule ami Israelte henga anamusah phatna jeh chun, mipi chu kipahtahle thanom tah-in aponbuh lamuva asoltan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun Solomon'in Pakai inle lengpa in chu ajoutai: chule Pakai in le amatah in sahna dinga Solomon lunga kon jouse chu aman lamjang keijin amolsotan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakai chu jan-in Solomon henga akilah-in, ahenga hitin aseije, Nataona kangaijin, hiche munhi keima dinga ganlhaina in hidingin kalheng tai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman van kakha-a go ajuhda-a, ahiloule gamsung bahgam dinga khaokhopi kalansah-a, ahiloule kamite lah-a hise kalansah-a ahile;
  </para>
  <para style="p">
    <verse number="14" style="v" />Kamina kikou kamite hi ahung kineosah uva, atao uva, kamai aholuva, akhansetna houva kona akile heijuva ahile; chuteng keiman van'a kona ataonao kangaipeh ding, achonsetnao kangaidam-a, agamu kadamsah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche mun'a taona kimangho lama kamit kahasah-a kana kasun jing ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu a-itih-a kamin umjing nadinga hiche in hi kalhena kasuhtheng ahitai: kamit le kalungthim hi chukoma umjing ding ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nangma thudol vang, napa David lamlhah banga kamasanga nalam lhah-a, Keiman kathupeh jouse dungjuija nabola, kachonna dan le kathutan lhah nanitna ahile;
  </para>
  <para style="p">
    <verse number="18" style="v" />Nanga kona Israelte lah-a vaipo ding lhasam louding ahi, tia napa David toh kakitepna dungjuija nalenggam laltouna kaphudet ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla nakihei manga, namasanga kakoi kachonna dan le kathupeh nadalhah-a, nache-a pathen dangho najena naga houva ahile;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutengle amaho kanapeh gamsunga kona ajung ajaova kabodoh uva, kamin dinga kathenso hiche in hi kamitmu-a kona kapaidoh ding, namtin lah-a thuchih le seichah khatna kaum sah ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hiche in sangtah hi ajotpa channin adatmoa; chutia chu amahon, Pakaiyin ibola hiche gam le hiche in hi ahitibol ham? atidiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amahon apu apateu Pakai Pathen, Egypt gama kona ahin puidohpao adalhah uva, pathen dangho akolchah uva, ahou uva chule ajenjeh uva; hijeh-a chu hitobang thilsehi achunguva alhunkhum sah ahi, tia adonbut dingu ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Solomon'in Pakai in le ama in ding asahsung kum somni kichaijin ahitin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huram'in Solomon analepeh khopi chu Solomon'in asaphan, hia chun Israel chate chu achensahtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Solomon Hamath-zobah satdin achen, agajou tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman gamthipma Tadmor asan, Hamath'a thilkholna khopiho jouse asan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman Beth-horon sahnung le Beth-horon lhangnung khopi kium kul, abangho, akotpiho, akotgolho pumin jong asan,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Baalath le Solomon'in anei thil kholna khopi jouse, sakol kangtalai khopiho, sakol touthemho khopiho asan, chule Jerusalem le Labanon chule alenggam pumpi-a Solomon'in asah nom jouse chu asadohtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel hilou Hit mite, Amor mite, Perizz mite, Hiv mite, chule Jebus mite amoh chengse thudola,
  </para>
  <para style="p">
    <verse number="8" style="v" />Achateu gamsunga amaho nunga kidalha, Israel chaten asuhmang louhou chu Solomon'in tuni geijin kai apeh sah-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel chate lah-a konin Solomon'in anatong soh alapon ahi; ahin amaho chu galbolin, gal lamkaijin, sakol kangtalai ho le sakol ho chunga lamkaijin apansahjon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichehohi Solomon pipui lenho ahiuvin, mipi chunga vaihom mi jani le somngajen ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Solomon'in Pharaoh chanu chu David khopi-a konin ama dinga asahpeh in lama apuitoutai. Ajehchu aman, Israel lengpa David in chu Pakai thingkhong lhunna muntheng ahijeh-in, ka-inneipi chengthei louding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Solomon'in hongcha maija asem Pakai maicham chunga chun Pakai henga govam thilto atoh-in,
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi thupeh dungjuija, niseh-a dia kibituh ngei bangin choldo nikho ho, lhathah niho, kumkhatna abineija kibol kut thumho; cholsolou changlhah kut, haptaho kut, chule Houbuh kutna atohjin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin apa David thupeh bangin, thempuho chu natong dingin aloi aloijin, Levi ho chu niseh-a angaichat dungjuija vahchoi dingle thempuho masanga lhachana tongding, Kotpi ngahho jouse jongchu kotpi jouse-a akihopkhen dungjui uvin mopohna apesoh keijin ahi; ajeh chu Pathen mipa David'in hitia hi ana thupeh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule thempuho le Levi ho chu lengpan athupeh-a konin ipilam thu hihen, sumle pai lampang hijongle akiheimang pouvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun Pakai inbul kiphu nikho-a pat le akijo theng nikho geija Solomon natoh jouse chu gontupsa ahi. Hitichun Pakai in chu achamkimin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Solomon Edom gamsunga luipipanga um Ezion-geber le Eloth'a chun achen ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Huram'in asohte khut, twikhanglen umdan hethem asohteho khutnin kong inneiho ahin thotnin ahi. Chuin amaho Solomon sohte toh Ophir'a acheuvin, chua kon chun sana talent jali le somnga ahin laovin, Solomon lengpa heng ahinlhut taove.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Sheba lengnun Solomon kithan chu ajatan, aloi tampitah toh, gimnamtui ho le sana chule songmantam tampitah po-a sangongsang ho ahin puijin, thudoh hahsatah ho-a Solomon phochen dingin Jerusalem'a ahungin ahi. Chuin amanu Solomon heng ahunglhun phatnin, alungsunga umjouse akhedoh-in akihoupitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Solomon'in athudoh jouse ahilin: Solomon'a kona kisela amanu ahil lou khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Sheba lengnun Solomon chihna le a-insah amuphatnin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule adokhanga anneh, asohte toudanho, alhachate kinboldan, akivonnao; chule akhon domho le akivonnao; chule Pakai in'a achetouna lampiho amuphatnin; alungthim abeihel jengtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amanun lengpa jah-a, Kagam sunga nathilbol le nachihna thulhut kanajah chu anadih lheh-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla kahunga kamittah-a kamu kahsen athu-u chu katahsan pon ahi: ven, na chihna loupi danhi akehkhat jong einakisei peh lou ahibouve: ajehchu naminthan na kanajah chu nakho khelin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namite le hiche nasohte na ang sunga dingjinga nachihna thu jajingho hi anunnom ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai na Pathen'a dinga leng hidinga alaltouna tousah ding thanoma Pakai na Pathen chu nunnom hen: ajehchu na-Pathen'in tonsotna dinga tundoh dingin Israelte angailun, hiche jeh-a chu thudih le chonphatna boldinga achunguva lenga napansah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amanun lengpa chu sana talent jakhat le somni, gimnamtui tamtah toh, songmantam ho apen: Sheba lengnun Solomon lengpa apeh gimnamtui tobang khatcha aum khapoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Ophir'a kona sana hinpo-a Huram sohte le Solomon sohten jong algum thinghole songmantam ho ahinpouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin lengpan algum thinga chun Pakai in le lengpa inpi kalbiho, lasaho selangdah le tumgingho asemin;chule hitobang chu masangin Judah gama ana kimu khapon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Solomon lengpan Sheba lengnu chu ama hinpoh tailouvin angaichatna athumjouse chu apen ahi. Hitichun amale asohte chu agamlama akileuvin achemang taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tun kumkhat sunga Solomon henga sana hunglut chu sana talent jaguple somgup le gup ahin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichu thiljohle sumkol veiho hinpoh simlouva ahi. Chule Arabia lengho jouse le gamsunga gamvaipoho jousen Solomon henga sana le dangka ahin popo jengun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Solomon lengpan sana kikhenglum jani asemin, sanalum khatna chu sana kikheng shekel jagup lutna ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule sana-a kikheng lumdal jagup asemin, lumdal khatna chu sana shekel jathum lutna ahi. Chuin lengpan hicheho chu Lebanon gammang in'a chun akoije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chukalvalin lengpan Saiha laltouna lentah khat asemin, sana thengin aloijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Laltouna-a kaldohna ding chun kalbi gup aumin, akeng chu sana-a kisem ahin, hichu laltouna toh kikilmat ahi; touna alangtoa chun khut ngapna aum gelin, khut ngapna geija chun keipi bahkai ni adinge.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule kalbi gup alangtoa chun keipi bahkai somleni adingin; hitobanga kisem hi lenggam khatcha-a jong aumpon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Solomon lengpa khonho jouse chu sana ngen ahin, chule Lebanon gammang in'a khonho jouse chu sana theng ngen ahi: dangka-a kisem khatcha aumpoi, Solomon khanglaijin hichu imachan akisimpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu lengpa kong inneiho chu Huram sohte toh Tarshish'a chejiu ahin; Tarshish kong inneiho chun kumthum sehle khatvei sana, dangka, saiha chule vahong chalho ahinpohjiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Solomon lengpan leiset lengho jouse chu haona le chihna-a akhelsoh keijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Pathen'in alungsunga akhumpeh chihna chu ngaidingin leiset lengho jousen Solomon umna chu ahin holhol jenguvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule amitakipmin athilpeh diu dangka kongle belho, sana kongle belho, ponsil, galvon, gimnamtui ho, sakol ho, sanganho kumtin in abi neijin ahinpe jiuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Solomon'in sakol le sakol kangtalai kholna in sangli aneijin, sakol touthem mi sangsom le sangni aneijin; amaho chu sakol kangtalai khopiho le lengpa heng Jerusalem'a aumsah-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule ama vadunga pat Philistinete le Egypt gamgi geijin lengho jouse chunga vai ahomin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule lengpan Jerusalem'a dangka chu songho abahsah-in, cedar thingho chu phaicham nemho-a tamtah keh theiba thingho abahsah jengin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule amahon Egypt'a konle gamjousea konin sakol ho Solomon henga ahintol tol jengun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tun Solomon thilbol dangho jouse, thusim abula pat ajona gei chu Nathan themgao lekhabu, Shilon mi Ahijah gaothu seina, Nebat chapa Jeroboam douna-a mitvahnei Iddo thilmuho-a chu kisun sohkeija hilouham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Solomon chu Jerusalem'a Israel pumpi chunga kum somli analeng change.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Solomon chu apu apatetoh alumkhom tan, apa David khopi-a avuitaove. Chuin ama khelin achapa Rehoboam alengchang tan ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Rehoboam Schechem'a achen ahi: ajehchu Shechem'a chu ama leng chansah dinga Israelte jouse hunga ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, Solomon lengpa-a kona jam-a Egypt'a ga um Nebat chapa Jeroboam'in hichu ajah phatnin, Egypt'a konin Jerusalem'a ahung kiletai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin akou dingin mi asolun ahi. Hitichun Jereboam le Israelte jouse Rehoboam henga hungun,
  </para>
  <para style="p">
    <verse number="4" style="v" />Napan kanamkol jonu agihsah behseh-in ahi: hijeh chun tun napan kachunguva angap sohthalah natoh hahsa le anamkol gihtah hi jansah domin lang, keihon nangma jennung kate, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman ajah uva, Nithum joule kahenga hungkit taovin ati. Chuin mipi apotdoh taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Rehoboam'in apa Solomon hinlaija amasanga dingjing tehse ho chu adopmin, Hiche mipihohi donbutna dinga ipi thumop neipeh diuham? ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon ahenga, Hiche mipite hi nakhoto-a, nakipa sah-a, ahenguva thupha naseipeh-a ahile, a-itih-a nalhacha ding ahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla tehse hon athumopmu chu adondan, amatoh seilettha, amasanga dingjing khangdongho thumop chu alajon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman ajah uva, Napan kachunguva anangap namkol jonhi themkhat jansah domin tia kajah-a seija hiche mitekhu idonbut theinadiu ipi thuhil neinei uvem? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amatoh seilettha khangdongho chun ahenga, Napan kanamkol jonu agihsah ahin, nangin vang themkhat beh jansah-in tia nahenga sei mipi chu hitin donbutnin, Kamechahi kapa kong sanga sajo ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajeh chu kapan namkol jon gihtah nachung uva angap ahin, keiman na namkoljon'u kabelap ding: kapan khaohola nanasuhgimu ahin, kenvang aipi-a kasuhgim ding nahiuve, tin seijin atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun lengpan, Nithum nile hungun anati bangchun, nithum nin Jeroboam le mipi ho jouse chu Rehoboam henga ahungtaovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin lengpan amaho chu gumtah-in anadonbutnin; chule Rehoboam lengpan tehse ho thumop chu adon tapon,
  </para>
  <para style="p">
    <verse number="14" style="v" />Khangthah ho thumop dungjuijin, Kapan na namkol jonu agihsah ahin, kenvang kabelap ding; kapan khaohola nasuhgimu ahin, kenvang aipiho-a kasuhgim ding nahiuve tin adonbut tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun lengpan mipi ho thu angaitapoi. Ajehchu Pakaiyin Shilon mi Ahijah amanchah-a, Nebat chapa Jeroboam henga anaseisa chu amolso theina dinga, hichu Pathen'in asosah ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin lengpan athu-u angai pehlou chu Israelte jousen amuphatnun, mipin lengpa chu adonbutnun, David'a chu ipi chan kaneijum? Jesse chapa-a chun goulo imacha kaneipouve. Vo Israel, amitakipmin naponbuh cheh-u kijot taovin: chule tun, David, na-insung kivettan, atiuve. Hitichun Israelte jouse aponbuh cheh-a achetauve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla Judah gam khopiho-a cheng Israel chunga vang Rehoboam aleng changin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Rehoboam lengpan kai vaipopa Hadoram chu asolin ahile Israel chaten amachu songin asepmun, athitai. Ahinla Rehoboam lengpa chu Jerusalem'a jamdingin asakol kangtalai ja atoudoh loitan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun Israel'in tugeijin David insung adoujing taovin ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Rehoboam Jerusalem'a ahung phatnin, lenggam chu Rehoboam henga puilut kit theina dinga Israelte satdin Judah le Benjamin insunga akilhengtum gal hatcheh mi sangsom le sangetjen akhomin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla Pathen mipa Shemaiah henga chun Pakai thu ahung lhungin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah lengpa Solomon chapa Rehoboam le Juda gama cheng Israelte le Benjamin mite jouse henga,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin hitin ati, Nangho nachetou loudiu, nasopiteu jong nagasat loudiu ahi: amitakip na-in cheh-a kileuvin: hichehi keimabol ahi, tin seijin, gatin ati. Chuin Pakai thu chu angaijun, Jereboam satdinga achegot uva konin akih taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Rehoboam Jerusalem'a achengin, Judah gamsunga chun kihuhdoh nading khopi Kul asadoh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Bethlehem, Etam, chule Tekoa jengjong asadoh-in,
  </para>
  <para style="p">
    <verse number="7" style="v" />Beth-zur, Shoco, chule Adullam,
  </para>
  <para style="p">
    <verse number="8" style="v" />Gath, Mareshah, chule Ziph,
  </para>
  <para style="p">
    <verse number="9" style="v" />Adoraim, Lachish, chule Azekah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Zorah, Aijalon, chule Hebron asadoh-in, hichehohi Judah le Benjamin gama um kulpinei khopiho ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kulho chu asudetnin, hicheho-a chun vaipo akoicheh-in, nehding le thao chule lengpitwi akholkhome.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule khopi tina lumle tengcha ho akoicheh-in, dettah-in asemin, Judah le Benjamin chu ama lama pang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Israel gamsung jouse-a thempuho le Levi ho jouse agamkai cheh uva konin ahenga ahunguve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Jeroboam le achapaten Pakai dinga thempu na atoh naova kona ahaisah jeh uva, Levi ho chun agamule aumnao khopi kimvelse adalhah uva, Judah le Jerusalem'a hunguva ahi:
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman munsang ho-a ding, thilhaho-a ding, chule abongnou semho-a dinga thempuho akisuhdet ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule amaho nungchun Pakai Pathen holding lungput neija Israelte chu apu apateu Pakai Pathen henga ganlhaina boldingin Israel phung jouse-a konin Jerusalem'a ahunguvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti chun Judah lenggam chu asuhatnun, kumthum sung Solomon chapa Rehoboam chu ahatsah uvin ahi: ajehchu amahon kumthum sung David le Solomon lampi ajotnun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Rehoboam'in David chapa Jerimoth le Jesse chapa Eliab chanu Abihail chanu Mahalath chu aji dingin akipuijin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amachun chate, Jeush, Shemariah, chule Zaham ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amanu nungin Absalom chanu Maachah akichenpin, amanun Abijah, Attai, Zizah, chule Shelomith ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Rehoboam'in Absalom chanu Maachah chu ajite jousele athaikemho lah-a angailu pene, (ajehchu aman ji somleget le thaikem somgup akipuijin; chapa somni le get le chanu somgup anei ahi).
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Rehoboam'in Maachah chapa Abijah chu lenga semding agotjeh-in, asopite lah-a vaipo pipen dingin akoijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman chingthei tah-in abolin, achate jouse chu Judah le Benjamin gamjouse khopi kulpi nei tina athecheh-in, nehding nengchetnin apen ahi. Chule amaho dingin ji tamtah agonpeh-e.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Rehoboam'in lenggam atundoh-a, ama hattah-a akisahdoh phatnin, amale aumpi Israelte jousen Pakai danthupeh chu anungsun taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule ahitin ahi, amahon Pakai douna asuhkhel jeh uvin, Rehoboam lengchan kal kum nga lhina-in, Jerusalem satdingin Egypt lengpa Shishak chu ahung kontou tan,
  </para>
  <para style="p">
    <verse number="3" style="v" />Sakol kangtalai sangkhat le jani le, sakol touthem sangsomgup toh ahung kontaovin: Egypt'a kona ahin kondohpi Lubim miho, Sukkiim miho, Ethiopia miho chu simjoulou ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman Judah gamsung kulpinei khopiho chu aban lah-in, Jerusalem'a ahungtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Shishak jeh-a Jerusalem'a kikhom Rehoboam le Judah pipuiho henga chun Shemaiah themgao chu ahungin, ajah uva, Pakaiyin hitin aseije, Nanghon neinungsun taovin, hijeh-a chu kenjong Shishak khutna kadalhah-u nahitaove, tin Pakaiyin aseije, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichun Israel pipuiho le lengpa chu akineosah uvin, Pakai chu chonpha ahi atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin akineosah-u chu amuphatnin, Shemai henga Pakai thuchu ahung lhungin, hitin aseije, Amaho akineosah taovin; hijeh chun sumang tapong ting, amavang akihoidoh nadiu themkhat kapeh ding ahi. Chule Shishak khutna kona Jerusalem chunga kalunghana kabuh lhah louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeng jongle keima kinbol le lenggam dangho kinbol ahetkhen theina diuva, amaho ama soh-a pangdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun Egypt lengpa Shishak'in Jerusalem ahungsatnin, Pakai in sunga gouho le leng in sunga gouho chu apomangin; aman Solomon'in anasem sana lumdal ho jong chu apomangtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hicheho khelchun Rehoboam lengpan sum-eng lumho akisemin, hiche chu leng in lutna kotngah vaipoho khutna akoitan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule lengpa Pakai in sunga alutji tengle kotngahpa chu hunga, agalahdoh jia, chule kotngah ho indan sunga akoilut kitji ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ama akineosah phatnin, asuh manghel lounadin Pakai lunghanna chu ama-a konin akilehei tan; chule Judah gamsunga jong thil ache hoi tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun Rehoboam lengpa chu Jerusalem'a akisuhat nin, lengvai apon ahi. Ajehchu Rehoboam alengchan patchu akum kum somli le kum khat ahitan, Pakaiyin amin umna dinga Israel phung jouse-a kona alhendoh khopi Jerusalem'a chun kum somlesagi lengvai apon ahi. Chule anu min chu Naamah ahin, Ammon mi ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Pakai holna dinga alungthim agontuplou jeh-in, thilse jeng abolin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun Rehoboam thilbol abula pat ajogei chu Shemaith themgao lekhabu le, mitvanei Iddo khanggui bu-a kisun hilouham? chule Rehoboam le Jereboam kah-a chun kidouna aumjom jingin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Rehoboam chu apu apate toh alumkhomin, David khopi-a akivuitai: chule achapa Abijah chu ama khelin alengchang tai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Jeroboam lengchan kum somle kumget lhin kum-in Judah gama Abijah alengchang panin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman Jerusalem'a kumthum lengvai apon ahi. Anu min chu Michaiah ahin, Gibeah mi Uriel chanu ahi. Chule Jeroboam le Abijah kah-a gal ana umin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Abijah chu galsat dingin lhentum cheh sepai galsat mihangsan sangjali to akigol toh-in: Jeroboam'in jong lhentum cheh sepai galsat mihangsan sang jaget toh ama satdingin akigol toh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Ehpraim molsanga um Zemaraim mol chunga Abijah adingin, Nangma Jeroboam le Israelte jousen kasei ngaijuvin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai Israel Pathen'in Israelte chunga lenggam hi David le achapate henga chi-a kitepna-a tonsotna dinga anapehsa ahi chu nahet diudol hilouham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijongle David chapa Solomon sohpa Nebat chapa Jeroboam chu akipatdoh-in, a-pakaipa dounan akiphintan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule ama henga chun pannabei ho, Belial chate akikhomun, Rehoboam chu khangdong cha le lungthim nemhiuheo ahi-a amaho doudal thei ahilou petchun, Solomon chapa Rehoboam dounan akisuhat nun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule tun nanghon David chapate khutna um Pakai lenggam chu doudal dingin nangaitou vin; chule nangho mihonpi tamtah nahiuvin, Jeroboam'in pathenho dinga anasempeh-u sana bongnouho chu nangho toh aumkhomin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon bongchal khat le kelngoichal sagi-a kisutheng dinga hungchan chu pathen hilouho thempu ahithei nadinga; Pakai thempuho, Aaron chapate le Levi ho nanodoh uva, gamdang namho chona banga thempu nakisem thu-u hilouham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiho din vang Pakai chu ka Pathen'u ahin, ama chu kanungsun pouve; chule Pakai kinbol thempuho chu Aaron chapate ahiuvin, chule Levi hon amaho kin abol jingun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amahon jingkah nilhah sehle Pakai henga govam ganlhaina le gimnamtui ahaljiuvin; vetsahna changlhah jong chu dokhang theng chunga atoh jiuvin; chule nilhah seh-a halding sana meivah khomle chua meivah pumin akoitoh jiuvin ahi. Ajehchu keihon Pakai i-Pathen'u thupeh kanit jingu ahin; nanghon vang ama nanungsun taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule veuvin, Pathen amatah chun eilamkai hidingin eiumpiuvin, chule athempuho jong nangho douna gal sumkon mutdingin aumjinguve. Vo Israel chate, napu napateu Pakai Pathen'u chu kisatpi hih-un; ajehchu najolou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla Jeroboam'in anunglam uva kona hinbulu ding asolin ahi: hitichun amaho Judah te masanga aumun, chule ahin bulu dingho chu anunglam uva aumun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Judah ten akinung heijuva ahile, veuvin, gal chu anung ama uva aumtan ahi: Chuin Pakai henga ataovun, chule thempuhon sumkon amutnun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Judah mite a-aovun: chule Judah mite hatah a a-ao phatnun ahitin ahi, Pathen'in Jeroboam le Israelte jouse chu Abijah le Judah te masanga agal lelsah tan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Israelte chu Judah masanga ajamtaovin; Pathen'in amaho chu akhutnuvah apedoh tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Abijah le amiten amaho chu atamatam athat taovin: hitichun hikoma chun Israel mite chu lhentum cheh sangjanga athiuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hitichun chuche chunga chun Israel chate chu suhnemin aumun, Judah chate chun apu apateu Pakai Pathen chunga akingai jeh-un ajoutaovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Abijah'in Jeroboam anungdelin, ama-a konin khopi phabep alan, Bethel chu akholenho pumin, Jeshanah chu akholenho pumin, chule Ehpraim chu akholenho pumin alatan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abijah nikho laijin Jeroboam chu ahatdohjou tapon ahi: chuin Pakaiyin adengin, athitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Abijah vang ahat cheh cheh-in, ji somleli aneijin, chapa somnileni toh chanu somgup ahingin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abijah thilbol adangse le alamlhah ho, chule athuseiho chu Iddo themgao thusima kisun cheh ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun Abijah apu apatetoh alumkhomin, David khopi-a avuijun: chule achapa Asa ama khelin alengchang tan ahi. Ama nikholaijin gamsung chu kum som galmongin aumuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Asa'in Pakai a-Pathen mitmun apha le adih jeng abolin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu aman gamdang pathenho maicham ho le munsang ho aladoh-in, milimho avobongin, Asherah limho aphuh lhun:
  </para>
  <para style="p">
    <verse number="4" style="v" />Judah te chun apu apao Pakai Pathen aholuva, adanthu le athupeh anit dingun athupeh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman Judah te khopiho jouse-a konin munsanghole milimho alamangin; lenggam chu ama noija galmongin aumin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Judah gamsunga chun khopi kulneiho asan ahi: ijeh inem itile gamsungin choldona amun, chule chuche kumho-a chun aman gal aneipon ahi: ajehchu Pakaiyin choldona apeh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun aman Judah te henga, Gamhi imasanguva aumpetnin, hiche khopiho hi saohitin, akimveluvah kulbangho, insangho, kotpiho, chule kotgolho semuhite; ajehchu eihon Pakai i-Pathen'u iholun, eihon ama iholun chule aman ningjouse-a choldona eipeuvin ahi, ati. Hitichun amahon asaovin, akhangtou lheh-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Asa'n Judah'a konin thih khutbu le tengcha choi cheh galsat mi sangsomthum aneijin, Benjamin'a kona lum le thal thocheh mi sangjani le somget aneijin: amaho mihat mihangsan cheh ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Ethiopia mi Zerah chu amaho satdin galmi janel asang asangto, sakol kangtalai jathum toh ahung kondoh-in; Mareshah'a ahungun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Asa ama satdin ahung kondoh-in, Maresha'a um Zephathah phaichama chun galsat dingin akigoltoh taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Asa'n Pakai a-Pathen akouvin, Pakai, nangman napanpi ding chu mi tamtah manchah ding hihen, ahiloule thanei louho manchah ding hijongle imacha ahichom poi: vo Pakai ka Pathen'u, neipanpi uvin; ajehchu nanga kingai kahiuvin, namina mihonpi hi satdinga che kahiuve. Vo Pakai, nangma ka Pathen'u nahi: mihemin najouhih helhen, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun Pakaiyin Asa le Judah te masanga Ethiopia mite chu ajouvin; Ethiopia mite ajamtaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Asa le aumpi mipi chun amaho chu Gerar geijin adelun: Ethiopia mite chu ajoutaovin, hitichun amaho akidodoh jou tapouve; ajehchu Pakai le ajanel angsunga gallel ahitaove; chuin amahon galthil kichom tamtah ahinkipoh mangun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amahon Gerar kimvela khopi jouse asumangun ahi; ajehchu achunguva Pakai ginna hung chu-a ahitai: chule amahon khopi jouse achomun ahi: ajehchu hiche ho sunga chu galthilchom tamtah uma ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon ganchaho ponbuh ho jong asumangun, kelngoiho le sangongsang ho tampitah akikaimangun, Jerusalem'a ahung kile taove.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Oded chapa Azariah chunga Pathen lhagao ahungchun:
  </para>
  <para style="p">
    <verse number="2" style="v" />Asa kimupi din achen, ahenga, Asa, Judah te chule Benjamin miten kathusei ngaijun; amatoh naum khom lai seuvin, Pakaiyin na-umpive; nanghon ama nahol uva ahileh ama namu dingu; amavang nanungsun uva ahile, aman jong nangho nanungsun dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun Israel hi phat sottah Pathen dih bei le, mihil ding thempu bei, chule dan bei anahiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla amaho alungdon uva Israel Pakai Pathen henga akileuva, ama aholuva ahile, ama amu jiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hichelai chun vaikonpa ahiloule vailhungpa din chamna anaumpon, gamsunga cheng jouse chunga gentheina nasatah anaumjon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen'in vangsetna jouse-a asuhgenthei jeh-un, namkhat le namkhat, khopi khat le khopi khat akisumang touvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun hatnunlang nakhut thau lhomsah hih-un; ajehchu nanatoh-u tohman kipe ding nahiuve, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Asan hiche thuho le Oded themgao thusei ajah phatnin, ahangsan chehtan, Judah le Benjamin gamsung jouse-a kon le Ephraim molsanga kona akhopi lah ho-a konin kidah umtah milim jouse akoimangin, Pakai hongcha maija um Pakai maicham chu asemphan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman Judah mite le Benjamin mite jouse, chule Ephraim, Manasseh le, Simeon'a kon amaho umpi gamdang miho jouse akhom khomin ahi. Ajehchu Pakai a-Pathen'in aumpi amuphatnuva, Israel'a konin mi tamtah-in ama ahinbelu ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun Asa lengchan kal kum somle kumnga na, alhathum lhina-in amahole amaho Jerusalem'a akikhom khom taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hiche chunga chun amahon Pakai henga galthila ahin chomhou lah-a konin bongchal jasagi le kelngoi sangsagi atoh-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon alungthim pumpiu le ahinna pumpiuva apu apateu Pakai Pathen hol dingin kitepna aneijuvin;
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun alen hihen aneo hileh, numei hihen pasal hijongle, Pakai Israel Pathen hollou chanchu kithat ding ahi atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakai henga awsang tah-in, sumkon le sumkon binei mutpum in akihahselun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Judah te jouse chu kihahsel na-a chun akipah uvin ahi; ajehchu alung pumpiuva kihahsel uva, angaichat nao pumpi-a aholu ahin; amachu amuvin ahi: chuin Pakaiyin akimveluvah choldona apeuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chujongle Asa lengpa nu Maachah thudola, amanun Asherah lim anakisem jeh-in, lengnu ahina-a konin akoidohtai: chule Asa'n amilim chu aphuh lhun, achon goijin, Kidron vadunga ahal lhatai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla Israel'a konin munsang ho chu akilamangpon: hijeng jongle Asa lungthim vangchu ahinkho lhumkeijin achamkimin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule aman Pathen insunga chun apa thensosa thilho le amatah in athensosa thilho, dangka, sana chule umle belho chu ahin polutnin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Asa lengchan kum somthum le kumnga sungchun gal aumkit tapon ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Asa lengchan kal kum somthum le kumgup kum-in, Judah lengpa Asa henga koimacha alut le apot aum louhel nading gelnan Israel lengpa Baasha chu Judah satdin ahungtouvin, Ramah chu asadohtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun Asa'n Pakai in'a konle leng in goukholna in'a konin dangka le sana aladoh-in, Damascus'a cheng Syria lengpa Banhadad agah thotnin, ahenga,
  </para>
  <para style="p">
    <verse number="3" style="v" />Kapa le napa kah-a anaum bangin keima le nang kah-a kitepna aumin ahi: ven, dangka le sana kahin thotne; chen, ama keija kona apotdohna dingin, Baasha toh nakitepna lhon gasukehtan, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Benhadad'in Asa lengpa thu angaijin, agalsat lamkaiho chu Israel khopiho satdin asolin; amahon Ijon, Dan, Abel-maim le Naphtali thilkholna khopiho jouse agajou taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ahitin ahi, Baasha'n hichu ajah phatnin, Ramah asah chu adalhan, anatoh atansahtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Asa lengpan Judah te jouse apuijin, amahon Baasha'in amanchah Ramah songho jouse le thingho chu apomangun, hicheho-a chun Geba le Mizpeh asadohtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichelai chun mitvahnei Hanani chu Judah lengpa Asa henga ahungin, ahenga, Nangma Pakai na Pathen'a kingai louva Syria lengpa-a nakingai jeh-in, Syria lengpa sepai janel chu nakhutna konin ahoidoh taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ethiopia mite le Lubim mite chu sakol kangtalai tamtah le sakol touthem tamtah janel mihonpi hilouvu ham? ahivangin Pakaiya nakingai jeh-in aman amaho nakhutna apedoh-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu ama lama alungthim chamkimho henga amaho khela ahatna musah dinga Pakai mit chu leiset pumpi-a suhletunga lhailele-a ahi. Hichea hin nangman ngolhoi tah-in thil naboltai: hijeh-a chu tua patna gal nanei jingding ahitai, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuphatnin mitvah neipa chunga Asa alunghangin, songkul'a akhumtai; ajehchu hiche thilho jeh-a chu achunga alungsalheh jenga ahi. Chule hiche laichun Asa'n mi phabep asugentheijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule vetan, Asa thilbol amasale anunung chu, vetan, Judah le Israel lengho lekhabua akisunlut cheh-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Asa lengchan kal kum somthum le kumko lhin kum-in akenga natna aneitan; ahanat kikhon geijin anatan: ahinla anatna-a chun Pakai hollouvin louthem ho joh anaholin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Asa apu apate toh alumkhomin, alengchan kal kum somli le kumkhat lhina-in athitan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amahon aman David khopisunga anakisem lhansunga avuijun, gimnamtui semhon gimnamtui jat chomchom agonu dimset jalkhuna chun alupsah taove. Chule amahon ama dingin meikong deojejun atih-un ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin achapa Jehoshaphat ama khelin aleng changin, Israelte dounan akisuhat nin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman Judah gamsunga kulbang nei khopiho jouse-a galsatmi akoijin, Judah gamsung le apa Asan analahsa Ephraim khopiho-a sepaihon akoicheh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin Jehosaphat aumpin ahi; ajehchu aman apa David lampi masa chu ajotnin, Baalim ahol pon;
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai apa Pathen joh aholin, ama thupeh ho-a chun achonnin, Israelte chonna bangin achonpon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Pakaiyin lenggam chu akhutna asudetnin; Judah te jousen Jehosaphat henga thilpeh ahinchoijun, chule aman haona le jabolna bulhing setnin aneije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Alungthim Pakai lampiho-a achoisangin; achungchonin jong Judah gamsunga konin mun sanghole Asherah limho alamangin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Alengchan kumthum na-a jongchun Judah gamsung khopiho-a cheng miho hildingin amilenho Benhail, Obadiah, Zechariah, Nethaneel chule Michaiah asolle.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman amaho chutoh Levi miho, Shemaiah, Nethaniah, Zebadiah, Asahel, Shemiramoth, Jehonathan, Adonijah, Tobijah, Tob-adonijah, chule amahotoh Elishama le Jehoram thempu teni asoltan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amahon Judah gamsunga ahilun, Pakai danthu lekhabu chu akikenun, Judah gamsung khopiho jouse achonchan sohkeijun, mipichu ahil leuvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Judah gamkimvela um lenggam ho jouse chunga chun Pakai kichatna achutan, hitichun amahon Jehosaphat dounan gal abol pouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Philistine mite phabepmin jong Jehosaphat chu thilpeh le dangka kai apeuvin; chule Arab mihon kelngoi hon sangsagi le jasagi toh kelchal jasagi ahin peuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jehosaphat chu nasatah-in aloupitan; Judah gamsunga kulpiho le thilkholna khopiho asadoh-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman Judah gamsung khopiho-a chun natoh tamtah aneijin: galbolmiho le mihat mihangsan ho chu Jerusalem'a aumun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hichehohi apu apateu insung kailhah dungjuija ajatnu chu ahi: Judah insunga sang gal lamkaiho pipui chu Adnah ahin; chule amatoh umkhom mihat mihangsan hochu sangjathum ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ama bana chu gallamkai Jehohanan ahin, ama tohin mi sangjani leh sangsomget aumkhomin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama bana chu ama le ama kiphal tah-a Pakai henga kipe Zichri chapa Amasiah ahin; ama tohin mihat mihangsan sangjani aumkhomin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Benjamin'a konin mihat mihangsan Eliada ahin, ama tohin thal le lum thothei mi sangjani aumkhomin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule abana chu Jehozabad ahin, ama tohin galkap dinga kigosadem mi sangjakhat le sangsomget aumkhomin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hicheho hi Judah gamsung pumpi-a kulbang nei khopiho sunga lengpan akoiho simlouva lengpa ngahho chu ahiuve.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Jehoshaphat chu haona le jabolna nasatah achangtan, chule Ahab toh kiguijopna aneitan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin kum ijat-ham jouvin Ahab henga Samaria'a achesuh-in ahi. Chuin Ahab'in amale alhonpiho chu kelngoi le bongchal nengchetnin athapeh-in, Ramoth-gilead'a kilhon toupi din ajolin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Israel lengpa Ahab'in Judah lengpa Jehoshaphat henga, Ramoth-gilead'a neilhonpi dingham? ati. Chuin aman adonbutnin, Keima nangma tobang kahin, kamite jong namite tobang ahi; galchu sat hu nao vinge, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jehoshaphat'in Israel lengpa jah-a, Katao ahi, tuni hin Pakai thu doptadin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Israel lengpan themgaoho mi jali jen akhomin, ajah uva, Ramoth-gilead'a galsatna kakon diuham, ahiloule kahaidiu ham? ati. Chuin amahon, Kontaovin; ajehchu Pathen'in lengpa khutna apehdoh dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla Jehoshaphat'in, Hicheho tilouva hi eihon idop theidiu Pakai themgao umlouva hitam? ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Israel lengpan Jehoshaphat jah-a, Eihon Pakai thu idopna theidiu mi khat aum nalainai: ahinla keiman ama kahon ahi; ajehchu aman thilphalou tilou apha eigaopeh ngaipoi: amachu Imla chapa Micaiah ahi, ati. Chuin Jehoshaphat'in, Lengpan hiti chun thu seihih-in, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Israel lengpan lamkaiho khat akouvin, Imla chapa Micaiah chu kintah-in gakouvin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Israel lengpa le Judah lengpa Jehoshaphat chu Samaria lutna kotpi bul mun onglaija lengvon pumin alaltouna gella atou lhonin; a-angsung lhona chun themgaoho chun gaothu aseijun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Chenaanah chapa Zedekiah chun thih sakiho akisemin, Hicheho-a hi Syria mite chu amanhel tokah seova nano ding ahi tin Pakaiyin aseije, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuti chun themgao jouse chun chutima chun gaothu aseijun, Ramoth-gilead'a chetouvin lang galo lhingin: ajehchu Pakaiyin hichu lengpa khutna apehdoh ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Micaiah kou-a che sottol chun ajah-a, Ven, lengpa henga themgaoho chun kitohtah-in aphalam aseijuve; katao ahi, nathu chu amaho-a tobangin hihen, chule apha seijin, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Micaiah'in, Pakai hingjing min pana kasei ahi, Ka-Pathen'in asei sei bouchu keiman kaseiding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ama lengpa henga ahung phatnin, lengpan ajah-a, Micaiah, Ramoth-gilead'a galbola kakon diuham, ahiloule kahaisah diham? ati. Chuin aman, Kontou vunlang galo lhingun, amaho chu nakhutna kipedoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin lengpan ajah-a, Pakai mina thutah tailou imacha dang seilou dinga ijatvei kaki hahsel sah ding nahim? ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman, Israelte molsang chungho-a achingbei kelngoi banga akithecheh-u kamui: chule Pakaiyin, Hiche hohin lamkai anei tapouve; hijeh chun amitakip a-incheh-a lung mongin kiletaohen atie, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Israel lengpan Jehoshaphat henga, Aman thilse tailou apha eigaopeh ponte tia kasei hilouham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Micaiah'in aseiben, Pakai thu ngaijun; Pakai alaltouna-a atouva, ajetle veija vanmi janel jouse adinnu kamui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Pakaiyin, Koipen tah-in Israel lengpa Ahab chu Ramoth-gilead-a agathi den nadinga agalhep dingham, ati. Chuin khatnin hitobanghin atin, achom khatnin khutobang khun atin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujouvin lhagao khat ahung potdoh-in, Pakai anga agadingin, Ken lheminge, ati. Chuin Pakaiyin ajah-a, ipi lampi-in em? ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman chedoh ingting, athemgaoho koma jouthu sei lhagaova kagapan ding ahi, ati. Chuin Pakaiyin, Nangman nagalhep ding, jojong najoding ahi: chen lang chuti chun gaboltan, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun tun, vetan, Pakaiyin hiche nathemgao ho kama jousei lhagao akoija, Pakaiyin nangma douna-a thilse asei ahitai, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin Chenaanah chapa Zedekiah chun ahin naijin, Micaiah ngeiphe abengin, ajah-a, Hoiche lampi-a Pakai lhagao chu keima-a kona nangma henga thusei dinga che-a ham? ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Micaiah'in, Ven, kiseldinga indan sungnunga nalut nikhole hetan nate, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Israel lengpan, Micaiah chu man unlang, khopi vaipo Amon le, lengpa chapa Joash henga lekaijun;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule, Lengpan hitin aseije, Hichepa hi keima lhamonga kahung kilekit kahsen songkul'a khumin lang, gimbolna changlhah le gimbolna twijin vah uvin atie, tin gaseijun ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Micaiah'in, Lungmonga nahung kile ngeingeija ahile Pakaiyin keima mangcha-a thu aseilou hinte, ati. Chule aman, Mipi jousen ngaijun, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun Israel lengpa le Judah lengpa Jehoshaphat chu Ramoth-gilead lama akontou lhontai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Israel lengpan Jehoshaphat jah-a, Keiman kalim kachom sah-a galmuna kache ding ahi; nangma vang naleng von kivonin, ati. Hitichun Israel lengpan alim achomsah-in, galmuna ache taove.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tun Syria lengpa chun alhonpi sakol kangtalai lamkaiho athupeh-in, Nanghon Israel lengpa tailou alen jong aneo jong nasat loudiu ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin ahitin ahi, sakol kangtalai lamkaihon Jehoshaphat amu phatnun, Hichekhu Israel lengpa ahi, atiuve. Hijeh chun kisatpidin ahin um taovin; ahinla Jehoshaphat chu apeng jah-in ahile, Pakaiyin akithopin; Pathen'in amaho chu amapa adalhah sahtan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu ahung hitin ahi, sakol kangtalai lamkaihon Israel lengpa ahilou ahetphat uvin, ama nung adel naova konin ahung kinungle taovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin mikhatnin doitum neilouvin athal akapmin ahile, Israel lengpa ompho kikah tah chu akhan ahi. Hijeh chun asakol kangtalai tolpa henga, Janel lah-a kona neitoldoh theinadin nakhut leheijin; ajehchu keima kamachang tan ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule hiche nikho chun galkisat anasalheh jengin: ahijeng vangin Israel lengpa chu sakol kangtalai chunga Syria mite lamngan nilhah geijin aumin: chuin nisa lhumphat donin athitan ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Judah lengpa Jehoshaphat chu lungmong tah-in a-in lam Jerusalem'a ahung kile kit tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama kimupi din mitvahnei Hanani chapa Jehu apotdoh-in, Jehoshaphat lengpa henga, Nangman Pathen helouho napanpi-a, Pakai hotbolteho nangailut ding hijaham? hijeh chun Pakai masanga konin nachung uva lunghana achutan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahivangin hiche gama kona doikhomho nalahmanga, Pathen holding nalungthim nagot jeh-in, nangma-a thilpha akimun ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jehoshaphat Jerusalem'a achengin; Beersheba'a pat Ephraim molsang geijin amite lah-a achelen, Pakai apu apateu Pathen lama amaho chu ahin lepui kitnin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman Judah gama kulbang nei khopiho jouse-a, khopi tina thutan ho akoijin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Thutan ho henga, Nathilbol uva chingtheijun: ajehchu mihem dinga thutan nahipouvin; nathutan naova na-umpiu Pakai ding joh-a thutan nahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun nachung uva Pakai ginna umhen; chingthei tah-in bolun: ajehchu Pakai i-Pathen uva chun khangitlouna, maipha vetna, chule nehguh nehna aumpon ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chukalvalin amaho Jerusalem'a ahung kile phatnun, Jehoshaphat'in Jerusalem'a chun Pakai thutan ding le thunoh baotamna-a thutan dingin Levi ho le thempuho, chule Israel phung upaho akoijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman amaho chu athupeh-in, Nanghon Pakai ging pum le kitah tah-a, chule lungthim chamkim tah-a hichu naboldiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule achennao akhopi houva nasopiteu lah-a kon ipi thu hijongle: thisan le thisan kikah thu, danthu le thupeh kikah thu, chondanho le thutanlhahho thua naheng uva hungchan chu, nangho le nasopiteu chunga lunghanna achuh louna dinga Pakai douna-a asuhkhel louna diuva nahil chahdiu ahi. Hichehi bolun, chutile nasuhkhel lou dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule veuvin, thempu chungnung Amariah chu Pakai thulam jouse-a nachung uva aumin; chule lengpa thulam jouse-a Judah te insung vaihompa Ishmael chapa Zebadiah aume; chule Levi mite jong chu namasanguva lamkai hidiu ahi. Hangtah-in tongun, chule Pakaiyin miphaho aumpi ding ahi, ati.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jou jonghin ahitin ahi, Moab chatele Ammon chate chu Ammon mite hilou adangtoh Jehoshaphat satdin ahunguvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin mi phabep Jehoshaphat henga ahungun, Mihonpi tamtah nangma doudin twipigal hilam Syria'a konin ahung konun; chule vetan, Engedi kite Hazazon-tamar'a aumun ahi, tin ahilun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jehoshaphat akicha tan, Pakai holdin akipen, Judah gamsung pumpi-a an ngol din aphongdoh tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Judah chu Pakai kithopina thumdin akikhom khomun: Judah khopiho jouse-a konin Pakai holdin ahungdoh-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jehoshaphat chu Judah le Jerusalem houkhom ho lah, Pakai insunga inhong thah maija chun adingin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitin ati, Vo kapu kapateu Pakai Pathen, nangma van'a um Pathen nahi hilouham? chule Pathen helou mite lenggam ho chunga vaihom nahi hilouham? chule koimachan nanan joulou na dinga, nakhutna thahatna le thaneina uma hilouham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nami Israelte masanga kona hiche gama chengho nodoh-a, nagolpa Abraham chilhahte tonsotna dia pe-a ka-Pathen'u nahi hilouham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amaho hia chun achengun, hia chun namin dingin muntheng khat nasahpeh-un,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijemtia kachunguva thilphalou, chemjam, thutana, hise, kellhah ho kachunguva ahung chuh-a ahile, hiche in mai le na angsung tah-a hi kadindiu, (ajehchu hiche insunga hi namin uma ahi,) kathohgim naova kona nangma henga kapendiu, chuteng nangman neingaipeh uva neikithopi dingu ahi, tin anaseijuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule tun, vetan, Egypt gama kona ahungdoh laijuva Israel ten gala asat dingu nanaphal louho, amavang amaho-a kona kinungle uva, asuhmang louvu Ammon chate le Moab chate, chule Seir molsang miho hi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Vetan, itobanga eilethuh-u hitam, nangman kalodiuva neinapeh-u nagouchana kona nodoh dingin ahunguve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo ka Pathen'u, nangman athu-u natanlou dingham? Ajehchu eidoudiuva hungkon hiche hon tamtah ho douna dingin hatna kanei pouvin; alonaje jong kahepouve: ahin kamitnu hi nangma chunga aume, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Judah te jouse chu Pakai angsunga achasen houle ajiteu, chule achateu toh adingsoh keijun ahi
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichun Levi mi Asaph chate lah-a Mattania chapa, Jeiel chapa, Benaiah chapa, Zekeriah chapa, Jahaziel chunga chun houkhom ho lailung tah-a Pakai lhagao ahungchutan;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman, Ngaijun, nangho Judah te jouse le Jerusalem'a cheng jouse, chule nangma Jehoshaphat lengpa, Pakaiyin najah uva hitin aseije, Hiche mihonpi jeh hin nangho kicha hih-un, lung jong lungthoi hih-un; ajehchu galsat hi nangho-a ahipon, Pathen'a joh ahi
  </para>
  <para style="p">
    <verse number="16" style="v" />Jing nikhole amaho doudingin konsuh-un; veuvin, amaho Ziz songkol'a ahung kaltou uve; nanghon Jeruel gamthip masang, vadung kichaina lama namudiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche galhi nangho sat ngailou ding ahi: nangho le nangho kigol toh-un, dingthim beh uvinlang, napanpiuva Pakai huhhingna chu veuvin, vo Judah le Jerusalem: kicha hih-un, lungjong lungthoi hih-un; jingtengle amaho doudingin kondoh-un; ijeh inem itile Pakaiyin na umpi dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jehoshaphat akunin amai tolla asuluttai: chuin Judah le Jerusalem'a cheng jouse Pakai anga alhuvin, Pakai chu ahou taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Kohath chate lah-a kon le Korhi chate lah-a kon Levi miho chu awgin sangtah le nasatah-a Israel Pakai Pathen vahchoi dingin adingdoh uvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin jingpi tah-in athouvun, Tekoa gamthipma alutnun: amaho achedoh laijun Jehoshaphat adingin, ajah uva, Vo Judah le Jerusalem'a chengte, kathusei ngaijun; Pakai na Pathen'u tahsanun, chutile naki phutdet dingu ahi; athemgaoho tahsanun, chutile nalolhin dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin mipi toh akihoutoh phatnin, Pakai vahchoijun, ajehchu ahepina tonsotnin aumjinge, tia sepaiho masanga achepumuva athen hoina vahchoi ding le Pakai henga lasa ding mi alhengdoh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amahon lasah le vahchoina apat phatnun, Pakaiyin Judah doudinga hunga Ammon chate, Moab chate, chule Seir molsang miho dounan changpang akoijin; chuin amaho chu ajou taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Ammon chate le Moab chate chu Seir molsang miho thatgam hela sumanghel dingin amaho dounan akipat doh-un: Seir'a chengho athagam phatnun, amitakip khatle khat akisumangto taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Judah te gamthipma um khongahpa insang ahung lhun phatnun, mihonpi lam chu aveovin ahile, veuvin, tolla mithilong alhuchap jengin, khatcha ahoidoh aumpouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Jehoshaphat le amite chu galthil kichomdinga ahung phatnun, amahon mithi longho-a chun thil mantam tahtah haosatna le kijepna thil lutahtah ho amuvin, apohlel khophel dingun amaho-a din akisut lhah-un ahi: chule atam behseh jehchun, galthil chu nithumjen achom khomun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin nilinin amaho Berachah phaichama akikhomun ahi; ajehchu hia chun Pakai achoi-anun ahi. Hijeh chun hiche mun minchu tugeijin Berachah phaicham akitin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chujouvin Judah le Jerusalem mite jouse akinung leuvin, Jerusalem'a kipahtah-a chedingin Jehoshaphat chu alamkaijin ahi; ajehchu Pakaiyin amelmateu chunga akipasah-u ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin tumging le selangdah, chule sumkon tho-in Jerusalem'a Pakai in chu ahunglhung taove.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Pakaiyin Israel te-a dingin amelmateu dounan gal asatne ti ajah phatnun, chuche lenggam ho jouse chunga Pathen ginna achutai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Jehoshaphat gamsunga lungmona aumtan ahi; ajehchu a-Pathen'in akimvela choldona apeh ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hitichun Jehoshaphat chu Judah te chunga aleng changin ahi. Ama alengchan pat chun kum somthum le kumnga ahin, ama Jerusalem'a kum somni le kumnga aleng changin ahi. Chule anu minchu Azubah ahin, Shilhi chanu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule aman apa Asa lamlhah ajotnin, chua kona petdoh louvin Pakai mitmu-a adih chu abolin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahijeng vangin munsang ho chu lahmangin aumpon ahi; ajehchu mipi chun apu apateu Pathen lama dingin alungthimu agongtup hihlaijun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tun Jehoshaphat thilbol dangho jouse chu abula pat achaina gei chu, veuvin, Israel lengte lekhabu sunga kiphapoh, Hanani chapa Jehu lekhabua akisuncheh-in ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hiche jou nung hin Judah lengpa Jehoshaphat chun thil giloutah bola Israel lengpa Ahaziah toh kiguijopna aneijin;
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman Tarshish'a chena ding kong-innei semna'a amato chun akigui jopmin; chule amanin Ezion-gaber'a kong innei chu asem lhonin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chujouvin Mareshah mi Dodavah chapa Eliezer'in Jehoshaphat dounan gaothu aseijin, ahenga, Nangman Ahaziah toh kiguijopna nabol jeh-in, Pakaiyin nanatoh ho asusetai, ati. Hitichun kongho chu suhsetnin aum gamin, Tarshish'a achethei lhon tapoi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Jehoshaphat apu apate toh alumkhomin, David khopi-a apu apate toh avuikhom taove. Chule ama khelin achapa Jehoram alengchang tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman Jehoshaphat chapate sopi Azariah, Jehiel, Zechariah, Azariah, Michael, chule Shephatiah aneijin: amahohi abonuva Israel lengpa Jehoshaphat chapate ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule apaovin amaho thilpeh nasatah dangka, sana, thilmantam ho, chule Judah gama kulbang nei khopiho apeuvin ahi: ahinla lenggam chu Jehoram apen ahi; ajehchu ama apeng masapen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tun Jehoram'in apa lenggam ahin lopat phatnin, amale ama akisuhat nin, asopi pasal jouse chemjamin athatnin, Israel pipuiho dangdang jong athatnin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alengchan patchun Jehoram chu kum somthum le kumni ahitan, Jerusalem'a kumget aleng changin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Ahab insung bangin Israel lengte lamlhah ajotnin ahi; ajehchu aman Ahab chanu jin aneijin: chule Pakai mitmun thilse abolin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Pakaiyin David to kitepna anasemjeh le, amale achate henga a-itih-a meivah peh dinga anakitep jehchun, David insung chu asumang pon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama nikholai chun Edom mite chu Judah vaihomna noija aumnaova konin akiphinun, leng khat akitun taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jehoram apipuiho le amato umkhom sakol kangtalai jousetoh akondoh-un: chuin jan-in athoudoh-in, ama le asakol kangtalai lamkaiho umkimvela Edom mite chu asatnin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun tuni geijin Edom mite chu Judah te khutnoija konin akiphinjing taovin ahi. Hiche phatlai mama jong chun aman apu apate Pakai Pathen anungsun jeh-in; Libnah chu akhut noija konin akiphinin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukalvalin jong aman Judah molsang chungho-a munsang ho asemin, Jerusalem'a chengho ajonthanhoi sah-in, Judah te apuimangin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Elijah themgaova konin ahenga lekha ahungin, hitin ati, Napa David Pakai Pathen'in hitin aseije, nangman napa lamlhah najuilou jehle, Judah leng Asa lamlhah najuilou jeh,
  </para>
  <para style="p">
    <verse number="13" style="v" />Amavang Israel lengte lamlhah najuija, Ahab insung jonthanhoi banga Judah le Jerusalem'a chengho na jonthanhoi sah-a, nang sanga phajo cheh napa insunga nasopite nathagam jeh-in,
  </para>
  <para style="p">
    <verse number="14" style="v" />Vetan, Pakaiyin namite, nachate, najite, chule nanei nagouho jouse chu hise nasatah-a ajepding:
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangman gilnatna kona natna nasatah naneiding, ani ni-a hiche natna jeh-a chu nagil hung lotdoh kahse-a natna nanei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chukal valin Pakaiyin Ethopia naija um Philistine miho le Arab miho lungthim chu Jehoram doudingin atildoh-in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho Judah gama ahung kontouvun, abuluvin, lengpa insunga kimu thiljouse le achapate le ajite jong apomangun; hitichun achate lah-a alhumpen Jehoahaz tailou chapa khatcha adalhahpeh pouvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin hicheho jouse jouhin Pakaiyin amachu gilnat damthei louvin ajeptan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ahitin ahi, phat phabep sung kumni kichai jouvin, anatnajeh in agiljang ahung lotdoh-in; hitichun natna hoisetah-in athitan ahi. Chule amiten apate meikong anatipeh ji bangun, ama chu meikong atipeh pouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Alengchan kipat in ama kum somthumle kumni ahin, Jerusalem'a kumget lengvai apon, koimacha alha ngaija beihelin athitan ahi. Ahijeng vangin amahon David khopi-a avuijun, lengte lhan vang ahipoi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jerusalem'a chenghon achapa lhumpen Ahaziah chu ama khelin alengchansah taove. Ajehchu Arab miho toh kiloija gebuh-a hunga mihon ho chun a-ute sese atha gamu ahitai. Hitichun Judah lengpa Jehoram chapa Ahaziah chu alengchang tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Alengchan patchun Ahaziah chu kum somli le kumni ahin, Jerusalem'a kumkhat aleng changin ahi. Anu min chu Athaliah ahin, Omri chanu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amajong Ahab insung lamlhah ajuijin ahi. Ajehchu anu chu athilse bolna dinga athumopma pang ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun aman Pakai mitmun Ahab insung bangin thilse abolin ahi: ajehchu apa thinungin amaho chu amanthahna dinga thumopmin apanguvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amajong amaho thumop bangchun achonin, Israel lengpa Ahab chapa Jehoram toh kilhonin Syria lengpa Bazael toh kisatdin Ramoth-Gilead'a achen: chule Syria mihon Joram chu amavouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Syria lengpa Hazael toh Ramoth'a akisatna-a amachanjeh-in, kijendam dingin Jezreel'a ahung kiletai. Chuin ama adamlou jehchun, Judah lengpa Jehoram chapa Azariah chu Ahab chapa Jehoram ve dingin Jezreel'a ache suh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Joram henga Amaziah ahungchu amanthahna dinga Pathen thilgon ahi: ajehchu ama ahung chun, Pakaiyin Ahab insung sumang ding thao anu Nimshi chapa Jehu doudin Jehoram toh akondoh lhonin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahung hitin ahi, Jehu'n Ahab insung chunga thutana anei laijin, Judah pipuiho le Ahaziah sopiho chapaten Ahaziah ajenu chu amun, amaho chu athat tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman Ahaziah aholin; chule amahon ama amanun, (ajehchu ama Samaria'a anakisel ahin,) Jehu henga ahin puijun ahi. Chuin amahon ama atha jouvun avui taovin ahi. Ajehchu amahon, Amahi alung pumpi-a Pakai hola Jehoshaphat chapa ahi, atiuve. Hitichun Ahaziah insung miten lenggam chunga lengvaipo ding anei tapouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla Ahaziah nu Athaliah'in achapa thi amu phatnin, akipatdoh-in Judah insunga lengte chilhah jouse athat gamtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla lengpa chanu Jeho-shabeath'in Ahaziah chapa Joash chu akithatna leng chapate lah-a konin agudoh-in, adonnu toh indan sung khatna akoitai. Hitichun Jehoram lengpa chanu Jehoiada thempupa jinu Jeho-shabeath chun (ajehchu amanu Ahaziah sopinu hija ahi,) amanun amapa atha louna dingin, Athaliah'a konin aselin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ama chu amahotoh kumgup sung Pathen in'a akiselin: chule gamsunga chun Athaliah'in lengvai apon ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kum sagi lhinna-in Jehoida akisuhat nin, Ja lamkaiho, Jeroham chapa Azariah, Jehohanan chapa Ishmael, Obed chapa Azariah, Adaiah chapa Maaseiah, chule Zichri chapa Alishaphat apuijin, amato kitepna aneijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Judah gam achonleuvin, Judah khopiho-a konin Levi mite le Israel phung upaho jouse akhomun, Jerusalem'a ahungun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin houkhom ho jouse Pathen insung lengpa toh thulhun asemuvin ahi. Chuin aman ajah uva, Veuvin Pakaiyin David chapate thudol asei banga, lengpa chapan lengvai apohding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon nabol dingu chu hiche ahi; choldoni-a lutji thempuho le Levi ho lah-a hopthum-a hopkhat chu kotngah-a napandiu,
  </para>
  <para style="p">
    <verse number="5" style="v" />Hopthum-a hopkhat lengpa in'a; chule hopthum-a hopkhat chu kotpi bula napandiu: chule mipi ho jouse chu Pakai in hongcha ho-a umdiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla thempuho le kinbola pang Levi ho tailou koimacha Pakai insung hunglut louding ahi; amaho athenjeh uva lutdiu ahin: mipi ho jouse vang Pakai anga dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Levi miten akhutna manchah kichoijuva lengpa chu aum kimvel diu; koi hijongle insung hunglut chan chu kithat ding ahi. Ahinla nanghon lengpa chu ahunglut le apotdoh teng naumpi jingdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun Levi ho le Judah te jousen Jehoida thempu thupeh bangtah-in abolun, chule amitakipmin choldoni-a hunglut ding amiho chu choldoni-a potdoh dingho chutoh apuijun ahi; ajehchu Jehoida thempupan anatoh-u angahsah louvu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chukalvalin Jehoida thempupan ja lamkaiho chu Pakai in'a um David lengpa tengcha ho le lumho chu apen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman miho jouse chu amitakip akhutna galvon kengcheh-in houin jetlama pat veilam geijin, maicham le houin lhung lhonin lengpa kimvela adin sah-in ahi
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin amahon leng chapa ahin puidoh-un, achunga lallukhuh akhuh peh-un, thulhun chu apeuvin, lengin asemtaove. Chuin Jehoiada le achapaten thao anuvin, Pathen'in lengpa huhhing hen atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun Athaliah'in mipi alhai gin le lengpa vahchoina husa ajah phatnin, Pakai insunga mipi henga chun ahungin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Amanun agahven ahile, veuvin, insung lutna-a khompi phunga chun lengpa adingin, chule lengpa koma chun pipuiho le sumkon mutho adingun: gamsung mipi jouse akipah-un, sumkon amutnun, lasahon jong akihil bangun manchahto thon avahchoijun ahi. Chuphatnin Athaliah'in apon abot eh-in, Kidouna, kidouna, atin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichun Jehoida thempupan janel chunga lamkaija akoi ja lamkaiho chu apuidoh-in, ajah uva, Amanu chu milah-a konin puidoh unlang, amanu juichan chu chemjamin thatnun, ati. Ajehchu thempupan, Amanu chu Pakai insunga that hih-un ati, ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun amahon achunga akhut alhaovin; lengpa in khoma sakol lutna kotpi phung ahunggei phatnin, chua chun amanu athat taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Jehoiada'n ama le mipi ho jouse le lengpa kah-a chun Pathen mite ahina diuvin kitepna asemin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun mipi jouse Baal in'a acheuvin, amaichamho le amilimho asuchimun, maicham meija chun Baal thempu Mattan chu athat taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujongle Jehoiada'n Pakai in'a natoh ding jouse chu, Mosi danthu bu-a kimu dungjuija David'in ana gontup bangchun, Pakai insunga kipah le lasa puma Pakai henga govam thilto tohdoh dinga David'in anahoptoh Levi mite thempuho khutna apedoh-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule aman imalam jouse-a thenglou tapou khatcha alut louna dingin, Pakai in kotpi-a kotngah ho akoijin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman ja lamkaiho, milunho, mipi chunga vaipoho le chuche gama mipi ho jouse chu apuijin, Pakai in'a konin lengpa chu apuilhasuh-un: kotpi sang palgalkai jin leng in lama acheuvin, lengpa chu alenggam laltouna-a atousah taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule gamsung mipi jouse akipah-un: Athaliah chemjam'a atha phatnun, khopi chu lung mongin aumtan ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joash chu alengchan patchun kum sagi ahibepmin, Jerusalem'a kum somli aleng changin ahi. Anu min chu Zibiah ahin, Beersheba mi ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jehoiada thempu nikho laisen Joash'in Pakai mitmun adih abolin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Jehoiada ama dingin ji ni apuipeh-in, aman chanu chapa ahingin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin hiche jouhin ahitin ahi, Joash'in Pakai in semphat ding alungviltai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman thempuho le Levi ho akhomin, ajah uva, Judah khopiho-a cheovinlang, akum kum-a Pakai in semphatnadin Israel mijouse henga dangka gadong khomun, chule hiche natoh hi nakino sah dingu ahi, ati. Ahinla Levi ho chu akino pouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin lengpan thempu chungnung Jehoiada chu akouvin, ajah-a, I-atile Pakai soh Mosi le Israel houkhom ho thupeh dungjuija hettohsahna houbuh-a dinga tokhom chu Judah le Jerusalem'a kona gadongkhom dinga Levi mite nasol louham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu numei phalounu Athaliah chapaten Pathen in chu asuseuvin; Pakai in'a thil kikatdoh jouse jong Baal'a dingin apedoh gam taovin ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amahon lengpa thupeh-in sumbom asemun, hichu Pakai in kotpi polama akoijun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin gamthipma Pathen soh Mosi'n Israelte chunga anapohsah tokhom chu Pakai henga ahinchoi diuvin, Judah gamjouse le Jerusalem'a asam phong taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin pipuiho jouse le mipi ho jouse athanomun, ahinchoijun, apehchai kahseovin sumbom sunga alehlut nun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun ahung hitin ahi, hichelai chun sum thingkhong chu lengpa natohna mun'a Levi ho khutnin ahin domlutnin, sum tampi aumtai ti ahet phatnun, lengpa thuchingpa le thempu chungnung vaipoho ahungun, sumbom chu ahongun, aladoh-un, chule amun mama-a agakoi kitnun ahi. Hitichun niseh in abolun, sum tampi akholdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin lengpa le Jehoiada'n hicheho chu Pakai in'a natong kinbolho apedoh lhonin; chule amahon Pakai in semphat nadin songkheng hole thingthem ho agoijun, chujongle Pakai in chu bolpha dingin thih le sum-enga semphaho jong agoijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun natong hon atongun amaho-a konin natoh chu amolsouvin, Pathen in chu amasalai bangin atungdoh-un, asudet taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ajophatnun sumval chu lengpa le Jehoiada henga ahinchoijun, hichea chun Pakai in'a ding um le bel ho, kinbol nading le thiltona ding manchah ho, thihkhe ho, sanale dangka umle bel ho asemuvin ahi. Chuin Jehoiada nikho laisen Pakai in'a chun govam thilto tanglouvin atoh jinguvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla Jehoiada chu atehlheh tan, nikho alhingsetnin athin; athi chun kum jakhatle somthum ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Israelte lah-a Pathen'a ding le a-in dinga thilpha aboljeh-in, amahon David khopi-a lengho lah-a avuitaove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tun Jehoiada thinungin Judah pipuiho ahungun, lengpa chu jana ahung peuvin ahi. Chuin lengpan amaho angaipeh tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amahon apu apateu Pakai Pathen in adalhauvin, thingbul le milim semthuho ahou taove: chule hiche suhkhelna jeh hin, Judah le Jerusalem chunga lunghanna achutai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla aman amaho chu Pakai henga hinlepui kit dingin themgaoho asolin; chule amahon amaho dounan thu aseijun: ahinla angaipeh pouve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jehoiada thempupa chapa Zechariah chunga Pathen lhagao ahung chun, amachu miho chunglama adingin, ajah uva, Pathen'in hitin aseije, Nakhantou louna diuva ibola Pakai thupeh chu nasuhkhelu ham? Nanghon Pakai nanungsun tah jeh-un, amanjong nangho nanungsun taove, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ama dounan guhthimin akihou khomun, Pakai inhong sunga chun lengpa thupeh-in songin aseplih taove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun Joash lengpan apa Jehoiada'n ama anahepina ageldoh tapon, achapa chu athat tan ahi. Chuin athi konin, Pakaiyin hinvehen lang, hinlethuh hen, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin kumlhun phatnin ahitin ahi, Syria sepaite chu ama doudingin ahung kontouvun; amaho Judah le Jerusalem'a ahungun, mipi lah-a kona pipuiho jouse athat gamun, amaho-a kona achomdoh jouse chu Damascus lengpa athot soh hel taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu Syria sepaiho hon lhomcha hunguva ahin, Pakaiyin janel mihon tamtah chu amaho khutna apedoh tan ahi; ajehchu amahon apu apateu Pakai Pathen anungsun taovin ahi. Hitichun amahon Joash chunga thutanna anei taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amahon ama adalhah phatnun, (ajehchu natna nasatah thoh puma adalhah-u ahi,) Jehoiada chapate thisan jehchun asohte guhthimin akihou somun, ajalkhuna athatnun, ama athitai. Chuin David khopi-a avuijun, lengte lhanna vang avuipouve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule ama douna-a guhthima kihou somho chu hichehohi ahiuve; Ammon mi Shimeath chapa Zabad, Moab mi Shimrith chapa Zehozabad ahilhone.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tun achapate thudol le, achungah pohgih natsatje thu, chule Pathen in kisemphat thudol chu, veuvin, lengho thusimbua akisun chen cheh-in ahi. Chuin achapa Amaziah chu ama akhelin alengchang tan ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amaziah chu alengchan patchun kum somni le kumnga ahin, Jerusalem'a kum somni le kumko aleng changin ahi. Chule anu minchu Jehoaddan ahin, Jerusalem mi ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman Pakai mitmu-a adih abolin, ahinla lungthim chamkimtah-in abolpon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun ahitin ahi, lenggam chu ama-a akiphudet phatnin, apa lengpa anathat asohho chu athat tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla achate chu athatpoi; Mosi danthupeh lekhabua kisun, Pate chu chate jeh-a thilou ding, chate dinga jong pate jeh-a thilou ding, amavang mitin ama chonset jeh-a thiding ahi, tia Pakaiyin athupeh bangchun abolin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukalvalin Amaziah'in Judah te akhom khomin, Judah le Benjamin gamsunga apu apateu insung kailhah dungjuijin sang chunga lamkai le ja chunga lamkaijin apansah-in: chule kum somni-a pat chunglamse asima ahile, tengle lum choija gal konthei lhentum cheh mi sangjathum aumuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Israel gama kon mihat mihangsan cheh sangjakhat jong dangka talent jakhat-in athalah-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla ahenga Pathen mi khat ahungin, Vo lengpa, Israel galsat ho chu lhonpi hih-in; ajehchu Pakaiyin Israel le Ephraim chate aumpipon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin nache ding ahi jongle, boljengin, galsat dingin kisuhatnin: Pathen'in melmate masanga nalhuhsah ding ahi; ajehchu Pathen'in panpi theina le pailhah theina thahat anei ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Amaziah'in Pathen mipa jah-a, Achutile Israel sepaiho kapeh dangka talent jakhat chu i-ilo dingu hitam? ati. Chuin Pathen mipan adonbutnin, Pakaiyin chuche sanga gamchenga tamjo napehthei ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuphatnin Amaziah'in Ephraim'a kona ahenga hung sepaiho chu in'a kile kitdin achom khentai. Hijeh chun Judah te chunga alunghang lheh jengun, lunghang tah-in inlama akilekit taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Amaziah akisuhat nin, amite chu apuidoh-in, chi phaichama acheuvin, Seir miho chu sangsom jen athatnun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ahing hoiju sangsom dang chu Judah ten gal hingin akaijun, songpi chungvuma akaitouvun, songpi vuma konin asonlhaovin, abonchauvin agoisoh jengun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla Amaziah'in amatoh galsatna chelou dinga anungsolho chu Samaria apat Beth-horon geijin Judah gam khopiho chunga achuvin, mi sangthum athatnun, thilchom tamtah akipoh uvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun ahitin ahi, Edom mite athana-a Amaziah ahung kilekit phatnin, Seir chate pathenho chu ahinpon, a-pathen dingin atungdoh-in, a-anguva chun akunin, ahenguva gimnamtui ahalin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun Amaziah chunga Pakai lunghan akongjahtan, ahenga themgao khat ahin solin, ama chun ajah-a, Ipi dinga nakhutna kona amite huhdohjoulou chuche mite pathenho najuiham? ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahitin ahi, ajah-a thu aseilai chun, lengpan ajah-a, Nangma lengpa thumopma kisem nahim? kithipmin, ibola kithat ding nahim? ati. Chuin themgaopa chu akhongaijin, Nangman hichehi nabola, kathumop nasan loujeh-in, Pathen'in nangma suhmangdin nagotai ti kahei, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin Judah lengpa Amaziah'in mi thuhilna alan, Israel lengpa Jehoahaz chapa, Jehu chapa, Joash henga mi asolin, Hungin khatle khat kimaito-in kisat hite, agatisah-e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Israel lengpa Joash'in Judah leng Amaziah henga, Lebanon'a lingphungin Lebanon'a cedar phung jah-a, kachapa jiding nachanu neipen ati; chuin Lebanon'a konin gamsa khat ahungin, lingphung chu achon lhutan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangman, Ven, keiman Edom mite kajouve natin, nalung thimin nangma kihoitho sah dingin nadom kangin ahi: tun na-in'a kium thimin; ibola nangma le naumpi Judah mite lhuhna dinga kisalung gima nahim? ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla Amaziah'in ngaisah ding agopon ahi; ajehchu Edom mite pathenho ahoujeh uva, amelmateu khutna apehdoh theina dinga Pathen thilgon hija ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun Israel lengpa Joash ahung kontouvin, amale Judah lengpa Amaziah chu kimaito-in Judah gamsunga um Beth-shemeash'a kimaiton akisat lhontai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Judah ten Israelte masanga gal alel taovin, amitakip aponbuh cheh uva ajam taove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Israel lengpan Jehoahaz chapa, Joash chapa, Juda lengpa Amaziah chu Beth-shemesh'a amanin, Jerusalem'a ahinkaijin, Jerusalem kulbang chu Ephraim kotpi-a pat kulning kotpigei tong jalijen asuchimin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman Pathen insunga sana le dangka, chule um le bel ho jouse chu, lengpa in'a gouchinga pang Obed-edom le lhachaho pumin akaijin, Samaria'a akiletai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Judah lengpa Joash chapa Amaziah chu, Israel lengpa Jehoahaz chapa Joash thinungin kum somle kumnga ahing nalaije.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tun Amaziah thilbol dangho jouse abula pat ajogei chu, vetan, Judah le Israel lengte lekhabua kisunlut hilouham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Tun Amaziah'in Pakai anungsun jouvin, Jerusalem'a chun ama dounan galguh abol taovin, chule ama Lachish'a ajamtai; ahinla Lachish'a mi anungdel sah-un, hia chun athat taove.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin sakol ho chunga ahinpouvin, Judah khopi-a chun apu apate toh avuikhom taove.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Judah mite jousen kum somlegup hibep Uzziah chu apuijun, apa Amaziah khelin alengchan sah taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amachun lengpa apu apatetoh alupkhom nungin, Eloth kho chu asaphan, Judah gama alelutsah kit tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Alengchan kipat in Uzziah kum somlegup ahin, Jerusalem'a kum somnga le kumni aleng changin ahi. Anumin chu Jecholiah ahin, Jerusalem mi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule apa Amaziah thilbol jouse bangin, aman Pakai mitmu-a adih abolin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pathen kilahna hethemna nei Zachariah nikho laisen Pathen aholin; chule Pakai ahol laise chun Pathen'in alolhin sah-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ama akondoh-in Philistine te akisatpin, Gath kulbang le Jabnah kulbang, chule Ashdod kulbang asuchimin, Ashdod kimvel le Philistine mite lah-a khopiho asan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pathen'in Philistinte le Gurbaal'a chenga Arab mite, chule Mehunim mite douna-in apanpin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Ammon miten Uzziah chu thilpeh apeuvin: Egypt lutna geijin amin athangin ahi; ajehchu ama nasatah-in akisuhatna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chukalvalin Uzziah'in Jerusalem kotpi ning le, phaicham kotpi, chule kulbang kisuhto na-a chun insang asan, hicheho chu asudetnin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nelphaija jong insang asan, twikul tamtah alaijin ahi: ajehchu aman gamnem laile phaicham ho-a gancha tamtah anei ahi; chule molsang hole Carmel mun'a honlei bolding akoijin ahi; ajehchu loubol ngailu mi ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukalvalin Uzziah lengpan agal lamkai khat Hananiah khutnoija lekha sunpa Jeiel le vaipopa Maaseiah khutna ajatnu kisimtoh dungjuijin, ahon honna kondoh-a galbol mi janel aneijin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihat mihangsan pipuiho jouse chu sangni le jagup alhinguvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho khutnoija thanei tah-a galsat, melma-a kona lengpa panpi thei sepai sangjathum le sangsagi le janga aumuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Uzziah'in sepai jousedin lum, tengcha, thih lukhuh, thih sangkhol, thalpi, chule song sena ahsongse agonpeh cheh-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman Jerusalem'a thilsemdoh themho pohdoh-a konin insang chungle kulpi bangho chunga thal kapdohna dingle songlen lenho kapdohna ding manchah aseme. Chuin gamtina aminthang tan ahi; ajehchu ahat kikhon kahsen kidang tah-in kithopin aumin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla ahung hatdoh phatnin, amanthah nadingin alungthim ahung kichoisang tai. Ajehchu Pakai a-Pathen dounan asuhkhel tan, gimnamtui halna maicham chunga gimnamtui haldingin Pakai houin sung alutnin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Azeriah thempupa le mihangsan cheh Pakai thempu mi somgetnin anung ajuilutnun;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Uzziah lengpa chu ajahdaovin, ahenga, Uzziah, Pakai henga gimnamtui halhi nang bolding ahipoi, gimnamtui haldinga kithenso Aaron chate thempuho bolding ahibouve: munthenga konin potdoh-in; ijeh inem itile nangman nasukhel tan; Pakaiya kona jabolna nachanna lou ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichun Uzziah alunghangin, akhutna gimnamtui halna ding lheng akichoi ahin; chuin thempuho chunga alunghan phatchun, Pakai insunga thempuho masang gimnamtui halna maicham koma chun achalpanga phah ahung chutan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin thempu chungnung Azariah le thempuho jousen avetnuva ahile, veuvin, achalpang chu anaphahtan, amahon chua konchun asondoh taovin ahi; hichun amatah jong potdoh din akinotan ahi; ajehchu Pakaiyin ama chu aden ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun Uzziah lengpa chu athikahsen miphah ahitan, miphah ahi jehchun inchoma achengtai; ajehchu Pakai in'a kona kinodoh ahitai. Chuin achapa Jotham chu leng in chunga vaipon apangin, gamsung mite thu atanin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun Uzziah natoh adang jouse amasa-a pat ajona gei chu, Amoz chapa Isaiah themgaovin asunin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun Uzziah chu apu apate toh alumkhomin, lengte kivuina mun'a chun apu apate toh avuitaove; ajehchu amahon, Ama miphah ahi, atiuve. Chuin ama khelin achapa Jotham alengchang tan ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jotham alengchan pat chun kum somni le kumnga ahin, Jerusalem'a kum somle kumgup aleng changin ahi. Anu min chu Jerushah ahin, Zadok chanu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman apa Uzziah'in anabol jouse dungjujin Pakai mitmu-a adih chu abolin ahi: ahijeng vangin ama Pakai houin sunga analutpoi. Ahin mipichun thilphalou abol nalaijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman Pakai houin kotpi sang chu asan, chule Ophel kulbang chu nasatah-in asan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chukalvalin Judah molsang ho-a khopiho asan, gam mangho-a chun in thupi tahtah le insangho asan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ammon lengpa tojong akisatnin, amaho chu ajouvin ahi. Chule Ammon chaten hiche kum mama chun dangka talent jakhat toh suhlouchang atena dim sangsom le sakolchang atena dim sangsom apeuvin ahi. Hitichun Ammon chaten amachu akum ninale thum na-in jong tamtah tah apeuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun jotham'in Pakai Pathen anga alampi akigontup jeh-in, ahung hat lhehtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun Jotham thilbolho dangho jouse, agalbolho jouse, alamlhah jouse chu, veuvin, Israel le Judah lengte lakhabu-a akijihlut cheh-e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama alengchan pat chun kum somni le nga ahin, Jerusalem'a kum somle kumgup lengvai apon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jotham apu apate toh alumkhomin, David khopi-a avuitaove: chuin achapa Ahaz chu ama khelin alengchang tan ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahaz alengchan pat chun kum somni ahin, Jerusalem'a kum somle kumgup aleng changin ahi. Ahin aman apu David bangin Pakai mitmun adih abolpon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu Israel lengho lamlhah ajuijin, Baalim kilhajol jong asemin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chukalvalin Hinnom chapa phaichama chun gimnamtui ahalin, Pakaiyin Israelte masanga anodohsa namho thilbol thet umtah bangin, aman achate chu meija agouvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman munsang ho, lhangho, chule thinghing noi tina kilhaina abolin, gimnamtui ahalin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Pakai a-Pathen'in Syria lengpa khutna apedoh-in, amahon akisat piuvin, amaho tamtah gal hingin akaijun, Damascus'a apui taove. Chule Israel lengpa khutna jong pehdoh-in aumin, aman ajouvin, mi tamtah athatnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Remaliah chapa Pekah chun nikhat sungin Judah te sangjakhat le sangsomni athatnin, abonuva mihangsan cheh ahiuve; ajehchu amahon apu apateu Pakai Pathen anungsun taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Ephraim mihatpa Zichri chun lengpa chapa Maaseiah le insung vaipo Azrikam, chule lengpa noidou Elkanah chu athatnin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Israel ten asopiteu lah-a konin mi sangjani, numei ho, achapateu, chule achanuteu chu gal hingin akaimangun, amaho-a konin galthil tamtah jong apomangun, galthil kichomho chu Samaria'a ahinpouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla Pakai themgao khat hia chun anaumin, amin Oded ahi: chuin ama Samaria'a hung janelho masanga chun achen, ajah uva, Judah te chunga napu napateu Pakai Pathen alunghan jeh-in amaho chu nakhut uva apedoh-in, ahin nanghon lunghan manin nathatnun, hichu van ahung geitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nanghon Judah le Jerusalem mite chu nanoi uva soh numei le soh pasal'a vulding nagouvin ahi: ahinla nangho-a jong, nangho tah ngeija jong Pakai na Pathen'u douna-a chonset uma hilouham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun tun kasei ngaijun lang, nasopiteu lah-a kon gal-hinga nahinkaiju, gal-hingho chu lhadoh kit taovin; ajehchu tijat umtah Pakai lunghanna chu nachung uva aumtai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Ephraim chate lamkaiho phabep, Johanan chapa Azariah, Mishillemoth chapa Berechiah, Shallum chapa Jehizkiah, chule Hadlai chapa Amasa chu galmuna kona hungho dounan adingdoh-un;
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajah uva chun, Gal hinga namathou chu hilama nahinkai loudiu ahi: ajehchu Pakai douna-a ikhel nao chungchona, ichonset nao le isuhkhel nau belap ding go-a nahiuve: ijeh inem itile isuhkhelu alenin, Israelte douna-a tijat umtah lunghan chua ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun sepaihon gal hingho le galthil kichomho chu pipuiho le houkhom ho masanga adalha taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin akimin phahho chu akipatnun, gal-hinga kimanho chu apuijun, galthil ho-a kon chun alah uva sagoh keova umho chu von avonpeh-un, kengchot asepeh-un, nehding le donding apeuvin, thao anuvin; achatmo jouse sangan chunga atousah-un, lusu kena khopi-a asopiteu umna Jericho'a apuijun; chuin amaho Samaria'a akile taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichelai chun Ahaz lengpan Assyria lengpa ahin panpi nadingin ahenga mi asolin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Edom miten Judah te ahung satkit uvin, gal hingin akai kit taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Philistine ten jong gamnem khopiho le Judah lhanglam ahin buluvin, Beth-shemesh, Aijalon le Gederoth, chule Shocho chu akhoneo hou pumin, Timnah chu akhoneo hou pumin, Gimzo jong akhoneo hou pumin alauvin, hia chun acheng taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu Israel lengpa Ahaz jeh-a Pakaiyin Judah asuhnem ahi; ajehchu Judah chu sagoh-a aumsah-a, Pakai douna nasatah-a chonkhel ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Assyria lengpa Tilgath-pilneser chu ahenga ahungin, hatsah jolouvin, ahung sugenthei jin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu Ahaz'in Pakai in'a konle lengpa in'a kon, chule pipuiho-a kona thil mantamho alah doh-a Assyria lengpa chu apeh ahin; ahinla aman apanpipon ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule alung genthei laitah-in jong Pakai douna suhkhel aneibebe jengin ahi: hichehi Ahaz lengpa chu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu aman alel Damascus te pathenho henga ganlhai abolin; chule aman, Syria lengte chu a-pathen houvin apanpi jeh-un, keima jong eipanpi theina diuvin, amaho henga ganlhaina bolinge, ati ahi. Ahinla amaho chu amale Israelte jouse manthah na ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Ahaz'in Pathen in'a umle bel ho achom khomin, Pathen in'a umle bel ho chu asatse gamin, Pakai in kot akhahchah-in, Jerusalem ningkoi tina ama dingin maicham akisemin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Judah te khopi tamtah-a pathen dangho henga gimnamtui halna ding munsang ho asemin, apu apate Pakai Pathen alunghan sah-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tun athilbol dangho le achondan dangho jouse abula pat achaigei chu, veuvin, Judah le Israel leng teho lekhabua akisun cheh-in ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Ahaz chu apu apatetoh alumkhomin, khopisung Jerusalem ngeija chun avuitaove: ahinla Israel lengte lhana chun akoipouve. Chuin achapa Hezekiah chu ama khelin alengchang tan ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezekiah alengchan pat chun kum somni le kumnga ahin, Jerusalem'a kum somni le kumko aleng changin ahi. Anu minchu Abijah ahin, Zekeriah chanu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama apa David'in anabolho jouse bangin Pakai mitmu-a adih abolin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Alengchan kipat kum, lha masapen-in Pakai in kotho chu ahongin, asemphan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman thempuho le Levi ho apuilutnin, solam khopi lamlena akhom khomin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ajah uva, Nangho Levi ho, kathu ngaijun, tun nanghole nangho kisuthengun lang, napu napateu Pakai Pathen in jong suthengun, chule munthenga konin abohho chu podoh uvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu ipateovin asukhelun, Pakai i-Pathen'u mitmu-a thilphalou anabolun, chule ama adalhaovin, Pakai chenna mun'a konin amai aheimangun, anung ngat taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujongle hongcha kotho akhah-un, meivah ho asumitnun, muntheng sunga chun Israel Pakai Pathen henga gimnamtui ahal pouvin chule govam thilto jong atohpouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun Pakai lunghanna chu Judah le Jerusalem mite chunga achutan, namit tah uva namu-u bangin boina, lungkidanna, chule khoisatna henga apedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijeh inem itile veuvin, ipu ipateu chu chemhemin alouvun, hichejeh hin ichapateu le ichanuteu chule ijiteu asohchang taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun alunghana tijat umtah chu eihoa kona aheimang theina dingin, Pakai Israel Pathen toh kitepna semding kalunga aumin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka chapateho, tun nahsahmon bolhih-un: ajehchu Pakaiyin nangho hi a-angsunga dingding, ama jending, alhacha na tongding, chule gimnamtui hal nadinga nalhenu ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichun Levi miho chu, Kohath chapate lah-a kon Amasai chapa Mahat le Azeriah chapa Joel: chule Merari chapate lah-a kon Abdi chapa Kish, Jehalelel chapa Azariah: Gershon mite lah-a kon Zimmah chapa Joash le Joash chapa Eden,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Elizaphan chapate lah-a kon Shimri le Jeiel: Asaph chapate lah-a kon Zechariah le Mattaniah,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Heman chapate lah-a kon Jehiuel le Shimei: Jeduthun chapate lah-a kon Shemaiah le Uzziel akipat doh-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin asopiteu akou khomun, akisuthengun, Pakai thua kona lengpa thupeh dungjuijin Pakai in sutheng ding chun ahungtaove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin thempuho chu asutheng dingin Pakai in sungnunga alutnun, Pakai houin sung athenglou amujouseu chu Pakai inhong sunga ahinpodoh uvin ahi. Chuin Levi mihon Kidron vadung lama pohdoh dingin alauvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tun lha masapen nimasanin asutheng pannun, chuchelha nigetnin Pakai hongcha-a ahungun, niget sungin Pakai in chu asuthengun, lha masa nisomle nigupnin ajona asemtaove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Hezekiah lengpa henga ahungun, ajah-a, Pakai in jouse le govam thiltona maicham chu a-umle belho jousetoh, chule vetsahna changlhah dokhang chu a-umle bel jouse toh kasutheng soh hel taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chukalvalin Ahaz lengpan alengvaipoh laija asuhkhelna apaimang um le bel jouse chu kagong toh-un, kasutheng uvin, chule ven, hicheho chu Pakai maicham masanga aumuve, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichun Hezekiah lengpa matah-in athouvin, khopi sunga vaihomho akhomin, Pakai houin lama achetou taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin lenggam le muntheng chule Judah dinga chonset thilto dingin bongchal sagi, kelngoichal sagi, kelngoinou sagi, chule kelchal sagi ahin kaijun ahi. Chuin hicheho chu Pakai maicham chunga tohdoh dingin Aaron chapate thempuho chu athupeh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun bongchal ho chu athatnun, thempuhon athi chu alauvin, maicham chunga atheuvin; hitobang machun kelngoichal ho chu atha phatnun, athi chu maicham chunga atheuvin; kelngoinou ho jong athatnun, athichu maicham chunga atheuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin kelchalho chu chonset thilto dingin lengpa le houkhom ho masanga ahinkaijun; hicheho chunga chun akhutnu angamun:
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin thempu hon hicheho chu athatnun, Israelte jouse-a dinga lhatdohna bolna dingin maicham chunga athisana kichamna asemun ahi: ajehchu lengpan govam thilto le chonset thilto chu Israelte jouse-a dinga boldingin athupeh-in ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin David le lengpa themgao Gad chule Nathan themgao thupeh bangin, Pakai in'a chun Levi ho chu thih khutbeh, tumging le selangdah ho tumdin akoijun ahi: ijeh inem itile hitia chu boldinga Pakaiyin athemgaoho-a kona thu apeh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Levi ho chu David manchah ho toh, chule thempuho chu sumkon toh adingun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Hezekiah'in maicham chunga chu govam thilto ato dinguvin thupeh aneijin ahi. Chuin govam thilto atopat phatnun, sumkon le Israel lengpa David manchah ho toh kithon Pakai la chu asapan taovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin houkhom ho jousen Pathen ahouvun, lasahon la asauvin, sumkon mut hon sumkon amutnun: hicheho jousehi govam thilto kichai kahsen aboljom jingun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin thilto ajophatnun, lengpa le aumpiho jouse akunun, Pathen ahou taovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Achung chonin lengpa Hezekiah le pipuihon David le mitvanei Asaph sem Pakai la sadingin Levi ho thu apeuvin ahi. Chuin amahon kipahtah-in vahchoi la asaovin, akunun Pathen ahou uvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hichun Hezekiah'in adonbutnin, Tun nangho Pakaiya dinga kisuhtheng nahitah-u toh kilhonin, hung naijun lang ganlhaina le thangvahna thilto hochu Pakai in sunga hin choijun, ati. Chuin houkhom ho chun ganlhaina le thangvahna thilto hochu ahinchoi lutnun; chule alungthima kiphalna neichan chun govam thilto atoh-un ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule houkhom ho hinto govam thilto jat chu bongchal somsagi, kelngoi chal jakhat, kelngoi nou jani ahi. Hicheho jousehi Pakai henga govam thilto-a ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule thil kithensoho chu bongchal jagup le kelngoi sangthum ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahinla thempuho alhom behseh jeh-u chun govam thilto jouse chu avun alipjou pouvin; hijeh chun natoh kichai kahsehle thempu dangho akisuhtheng kahseuvin asopihou Levi ho chun akitho piuvin ahi: ajehchu amaho le amaho kisuhtheng nalama Levi ho chu thempuho sangin alungdih jouvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chujongle govam thiltoho, chamna thilto-a dinga athao ho, chule govam thilto jouse-a dinga don thiltoho chu atamlheh jengin ahi. Hitichun Pakai houin lhacha natoh dan chu akigoltoh chetnin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Pathen'in mipi agontup jeh chun Hezekiah le mipi chu akipah lheh jenguvin ahi: ajehchu thilchu photlotna kibol ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Hezekiah'in Israelte le Judah te jouse henga mi asolin, chule Ephraim le Manasseh henga jong, Pakai houin Jerusalem mun'a ahunguva, Israel Pakai Pathen henga kalchuh kut ahung manna diuvin lekha athotnin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu lengpa le apipuiho chule Jerusalem'a houkhom ho jouse chu lhanina-a kalchuh kut mang dinga kihoutoh-u ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu thempuho bulhing setna akisuh theng lou jeh-u le, mipi ho jong Jerusalem'a ahung kikhopkhom loujeh uva, hichepetna chu amanthei louvu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hiche thilhin lengpa le houkhom ho jouse alung lhaisah lheh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Beersheba'a pat Dan geija Israelte jouse henga, Jerusalem'a ahunguva Israel Pakai Pathen henga kalchuh kut ahungman diuva phonjal dingin akilol lha taovin ahi: ajehchu akisutdan bangtah a phat sottah anabol louvu ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun lekha thah ho chu lengpa le pipuiho-a kona lekhathot pumin Israel le Judah gamjousea acheuvin, lengpa thupeh bangin hitin agaseijuve, Israel chate, nangho Abraham, Isaac, chule Israel Pakai Pathen henga hungkileuvin, chutile ama nangho Assyria lengte khutna kona hoidoh amohho henglama hungkile kitding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho apu apateu Pakai Pathen douna-a sukhela napu napateu le nasopiteu bangin umhih-un, hijeh-a chu namu-u bangahi aman amaho chu akamhel dinga apehdoh-u ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun nangho napu napateu bangin lungtah hih-un, Pakai henga nangho le nangho kipelut unlang, a-itih-a dinga asuhthengsa amunthenga chun lutjouvin: chule alunghana tijat umtah chu nangho-a kona aheimang theinadin, Pakai na Pathen'u kin boluvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Pakai heng lama nahung kilehei kitnuva ahile, nasopiteu le nachateo chu hiche gama ahung kilekit nadinguva gal hinga akaimanghou angsunga lungsetna chang dingu ahi: ajehchu Pakai na Pathen'u chu lungset le hepina-a dim ahin, nangho ama heng lama nakile heijuva ahile, aman nangho-a kona amai aheimang louding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun lekha thah ho chu Ephraim le Manasseh chule Zebulun geipeh-in khopitina acheuvin: ahinla amahon anuisatnun anahsah pouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahijeng vangin Asher le Manasseh chule Zebulun mi phabep akineosah-un, Jerusalem'a ahungun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai thua kona lengpa le pipuiho thupeh jopnadin, Judah gamsung jong Pathen'in lungkhat aputsah uve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin alhanina-in cholsolou changlhah kut mangdin Jerusalem'a mi tamtah, mipi atama tam akikhomun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho akipatnun Jerusalem'a maicham ho chule gimnamtui halna maicham ho aladoh-un, Kidron vadunga aseplut taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichun amahon lhanina nisomle nilinin kalchuh kut ding gan athatnun ahi: chuin thempuho le Levi ho chu ajahcha taovin, chuphatnin amahole amaho akisuthengun, govam thiltoho chu Pakai insunga alalut taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pathen mi Mosi danthu dungjuijin, amaho chongai danin ama muncheh-a adingun: thempuhon Levi ho khutna alah-u thisan chu atheuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu houkhom ho lah-a mi tamtah kisutheng lou aum nalaijun: Pakaiya dinga suhtheng ahina diuva, athenglou takipma dinga kalchuh kut sa thapeh ding mopohna chu Levi ho changuva ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu mipi choplop, Ephraim, Manasseh, Issachar le Zebulun'a kon mi tamtah chu kisutheng lou ahiuvin, ahinla akisun banglouvin amahon kalchuh kut an chu ane jenguvin ahi. Ahinla Hezekiah'in amaho ataopeh-in, Pakai Phatah chun amitakip,
  </para>
  <para style="p">
    <verse number="19" style="v" />Munthenga kisuhthengna dungjuija thenga hihih jongle, Pathen, apu apateu Pakai Pathen holdinga alungsunga kigotna neichan chu ngaidamhen, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin Hezekiah taona asanpeh-in, mipi chu asudamtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jerusalem'a um Israel chate chun cholsolou changlhah kut chu kipana nasatah-in nisagi amangun: Levi ho le thempuho chun ani anin Pakai avahchoijun, manchah gingtah pumin Pakaiya la asaove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Hezekiah'in Pakai hetna phatah thuhila pang Levi ho jouse henga lhamona thu aseijin: amahon apu apateu Pakai Pathen henga chamna thilto atoh-un, chonset phondohna aneijun, chule kut ni sagi lhumkeijin aneuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin khoppi pumpi chu nisagi bang manbe dingin akihouvun, kipahtah-in nisagi amanbe kitnun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu Judah lengpa Hezekiah'in houkhom ho chu bongchal sangkhat le kelngoi sangsagi apen; chule pipuiho chun houkhom ho chu bongchal sangkhat le kelngoi sangsom apeuvin: thempu tamtah akisuthengun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Judah gam houkhom ho jouse, thempuho le Levi ho toh, chule Israel gama kona hungdoh houkhom ho jouse, Israel gama kona hungdoh-a Juda gama cheng gamdang mijouse jouse chu akipah-un ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitichun Jerusalem'a kipana nasatah aume: ajehchu Israel lengpa David chapa Solomon nikho-a patnin chutobangtah kipana chu ana umkhapon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuphatnin thempuho le Levi ho chu akipat doh-un, mipi chu phatthei abohtauve: chuin athuseiju chu ngaipeh-in aumin, ataonao chu achenna muntheng van geijin alhungin ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hicheho jouse akichai nunghin, chua um Israelte jouse chu Judah khopiho-a acheuvin, song milimho avochipmun, thingbomho aphulhuvin, Judah le Benjamin gam, Ephraim le Manasseh gamho-a konin munsang ho le maicham ho jouse chu abeihel kahsen aphuhlhu uvin ahi. Chuin Israel chate jouse akinung leuvin, amitakip agoulona akhopi cheh uva akile taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Hezekiah'in thempuho le Levi kihom khenho chu akihopkhen dungjuijun atoh dingu akomu peh-in, amitakip akinbol dingu dungjui cheh-in, thempuho le Levi ho chu govam thilto le chamna thilto toh ding, lhacha natong ding, thangvahna peding, Pakai ponbuh kotpi phunga vahchoi jingdingin angansen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman Pakai dan thupeh-a kisun banga, jingkah le nilhah-a dinga govam thilto ding; choldo nikho, lhathah nikho, chule kut bineiho-a dinga govam thilto dingho chu lengpa neile gouva konin aman apohdoh dingin agongin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chukalvalin Pakai danthu-a akitilkhou theina diuvin Jerusalem'a cheng mipi ho chu thempuho le Levi ho chan pedingin athupeh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin thupeh ahung kithejal jal-in, Israel chaten chang, lengpitwi, thao, khoiju, chule lousoh jouse-a kon gamasaho chu ninglhing tah-in ahinpolut nun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Judah khopiho-a cheng Israel le Judah chate thudol chu, amahon jong bongchal le kelngoiho hopsom, chule Pakai a-Pathen uva dinga kikatdoh thilthengho hopsom ahinpeuvin, asevum jengun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lha thum na-a asetvum patnu ahin, lha sagina-in ajou uvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Hezekiah le pipuiho chu ahunguva, akisevum chu amuphatnun, Pakai le amite Israelte chu phatthei aboh taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuphatnin Hezekiah'in akisevum thudol chu thempuho le Levi ho chu adongin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Zadok insung mi Azariah thempu chungnung'in adonbutnun, Mipihon Pakai insunga thilto ahinpohlut patnuva patnin nehding bulhing setnin kaneijun, tamtah avaldoh nalaijin ahi: ajehchu Pakaiyin amite phatthei aboh-in, chule thil hijatpi hi amoh chengse chu ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Hezekiah'in Pakai insunga chu indan sem dingin thu apen, chule amahon asem taovin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin thiltoho le hopsom ho, chule thilpeh thengho chu tahsan umtah-in alhoh lutnun: hiche chunga chu Levi mi Conaniah chu vaipo ahin, asopipa Shimei chu ama noidou ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Jehiel, Azariah, Nahath, Asahel, Jerimoth, Jozabad, Eliel, Ismachiah, Mahath, chule Benaiah, mi hicheng hi Hezekiah lengpa le Pathen houin lamkai Azariah thupeh-a, Conaniah le asopipa Shimei khutnoija vetupma pang ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule solam kotpi ngah-a pang Levi mi Imnah chapa Kore chu, Pakaiya lungcham thilpehho vetuple, Pakaiya dinga thilpeh le thiltheng chung nungho homtoh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama bana chu Eden, Miniamin, Jeshua, Shemaiah, Amariah, Shecaniah ahiuvin, amaho thempuho khopiho-a umuva, asopihou chu akihopkhenu dungjuija alen aneo kibanga chan ahoppeh dingu;
  </para>
  <para style="p">
    <verse number="16" style="v" />Khanggui kisutna-a kisun pasal kum thuma pat chunglamse tilou, Pakai in'a hunglut amitakip chu akihopkhenu dungjuija nitina akin bolna-a amuding achan chu ahop dingu,
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule apu apateu ingsung kailhah-a dungjuija khanggui kisutna-a jao thempu-a pang le Levi miho kum somni-a pat chunglamse kihomkhena anatoh-u dungjui,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule mipi jouse lah-a kona khanggui kisutna-a jao jouse, achasen hou, ajiteu, achapateu, chule achanuteu geija ahoppeh dingu ahi: ajehchu amaho akin boldiu kipe mun'a chu thenna-a kisutheng cheh ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Akhopihou kimvel loujao dunga cheng le khopi tina Aaron chapate thempuho thudola, thempuho lah-a pasal jouse le Levi mite lah-a kon khanggui kisutna-a kisimho jouse chan hoppeh dingin mi phabep akimin kutnin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Hezekiah'in Judah gamsung jouse-a hitichun abolin, chule Pakai a-Pathen angsunga chun apha, adih, chule atah jeng abolin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Pathen houin kinbolna-a anatoh jouse ahin, danthu lam ahin, thupeh lam ahin, abula patnin a-Pathen aholin, alung pumpin atongin; hitichun akhangtou cheh cheh-in ahi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheng thilho kiphudet nunghin, Assyria lengpa Sennacherib ahungin, Judah gama alutnin, kulbang nei khopiho dounan gebuh asongin, ama-a dinga joding angaiton ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Hezekiah'in Sennacherib ahunga Jerusalem satding agot chu amu phatnin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Apipuiho le amihat hotoh khopi pama twinahho suhbing dingin akihouvun, amahon akitho piuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hitichun mipi tamtah akikhomun, gamsung lailunga long twinahho le vachaho atingun, Ipibola Assyria lengho, twi nengtah-a amu diuham? atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ama akisuhat nin, kulbang kehlai jouse asaphan, insangho atungdoh-in, polama kulbang chom jong agensonin, chule David khopi-a um Millo jong asaphan, tengcha le lumdal jong ninglhing tah-in asemin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin mipi chunga gal lamkaiho atungin, amaho chu khopi kotpi lamlena chun ahenga akhomin, ahenguva lhamona thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hatnunlang hangun, Assyria lengpa ahiloule aumpi mipi ho jeh-in kicha hih-un, lungjong lungthoi hih-un: ajehchu ama umpi sangin eiho umpi atamjon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama koma um chu tahsa bantha ahin; eiho koma vang Pakai i-Pathen'u chu eihuhdiu le igalteu satdinga uma ahi, ati. Chuin Judah te lengpa Hezekiah thuseija chun mipi chu alung ngam taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche jouhin Assyria lengpa Sennacherib'in asohte chu (ahinla amale aumpi agalhat ho jouse chun Lachish dounan kulpi akaijun ahi,) Jerusalem'a um Judah lengpa heng le Jerusalem'a um Judah mite jouse henga asolin, hitin agasei sah-e,
  </para>
  <para style="p">
    <verse number="10" style="v" />Assyria lengpa Sennacherib'in hitin aseije, Jerusalem'a umkulsa naum nunguva, ipi-a kisong nahiuvem?
  </para>
  <para style="p">
    <verse number="11" style="v" />Hezekiah'in, Assyria lengpa khutna konin Pakai i-Pathen'un eihuh naovinte tia gilkel le dangchah-a nathi nadiuva bou najolu hilouham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Amunsangho le amaichamho sumanga, Judah le Jerusalem henga, Maicham khat angabou nahou uva, achunga gimnamtui nahaldiu ahi tia seija chu hiche Hezekiah mamahi hilouham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei le kapaten gamdangho chunga ipi kanabolu nahet lou uham? chuche gamsunga cheng namho pathenho chun amaho kakhutna kona anahuhdoh jou beh-um?
  </para>
  <para style="p">
    <verse number="14" style="v" />Kapaten anasuh manghel-u namho pathenho lah-a kakhutna kona amite huhdoh-a koi ana uma, kakhutna kona na-Pathen'u chun nahuhdoh jou diuham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun tun Hezekiah chun nalhemlha hih-u hen, ahiloule najol lhahih-u hen, tahjong tahsan hih-un: ajehchu koimacha namle lenggam pathen khatchan amite chu kakhutna konle, kapate khutna konin anahuhdoh joupoi: na Pathen'un kakhutna kona nahuh dohding chu ichanna lhinglel jocheh hitam? ati, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin asohten Pakai Pathen le asohpa Hezekiah dounan thu aseibe nalaijun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman Israel Pakai Pathen tailtomna le ama dounan lekhathot jong asunin, Gamdangho namdang pathen hon amiteu kakhutna kona ahuhdoh louvu bangin, Hezekiah Pathen'in jong amite kakhutna konin huhdoh ponte, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin khopi chu alah theina diuvin Jerusalem mite kulbanga um miho henga chun, kichatsah-a, suhboina dingin Judah te paovin awsang tah-in asapkhumun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahon Jerusalem Pathen dounan, mihem khutna kisem leiset pathenho douna bangbepmin thu aseijun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin hiche jeh hin, Hezekiah lengpa le Amoz chapa Isaiah themgao chu atao lhonin, vanlam sangin akaplhonin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin vantil khat asolin, Assyria lengpa gebuh-a um mihat hangsan jouse, chule lamkaiho le vaipoho chu athatgam tan ahi. Hitichun maijum tah-in agamlama akiletai. Chuin a-pathen in'a ahung phatnin asunga kona hungpengho tahchun hiche munachun chemjamin athat taovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun Pakaiyin Hezekiah le Jerusalem'a chengho chu Assyria lengpa Sennacherib khutna kon le adang jouse khutna konin ahuhdoh-in, lamtina apuihoijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin mi tamtah-in Jerusalem'a Pakaiya dingin thilpeh ahinpouvin, Judah leng Hezekiah chu apeove: hitichun hiche-a pat chun namjouse mitmun amachu choi-atnin aumtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche nikholai chun Hezekiah chu thina khopmin anatan, Pakai henga ataovin ahile, Aman ahenga thu aseijin, melchihna khat apen ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla Hezekiah'in achunga phatna kibol dungjuijin alethuh pon ahi. Ajehchu alungthim akichoisang tan; hijeh chun amale Judah chule Jerusalem chunga Pathen lunghana achutan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla Hezekiah le Jerussalem'a chengho jouse chu alungsung hoithona-a konchun akineosah taovin, hitichun Hezekiah nikho sungsen achunguva Pakai lunghanna achutapoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Hezekiah'in nasatah-in haona le jabolna aneitan: aman ama dingin dangka, sana, songmantam, gimnamtui, lumle pho, chule thillu jat jouse khol khomna ding in akisah-in;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chujongle chang le lengpitwi, chule thao khol khomna dingin in asan; chule ganhing namkim khumna dingin gan in asan, chule kelngoi ho-a dingin kelngoi hongho asemin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chukal valin khopiho akisahdoh-in, kelngoihon le bonghonho ahaolheh jengin ahi: ajehchu Pathen'in neile gou atama tam apen ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche Hezekiah mamahin Gihon luipi sahnung jong atingkangin, David khopi lhumlam sanga jangpetnin alonsah-in ahi. Chuin Hezekiah chu anatohna jouse akhangtouvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahijeng vangin palaija hunga Babylon pipuho thudol, gamsunga thil kidang kibolho kholdinga ahinsol hou thudola vang; alungsunga umjouse ahetdohna dingle apatep nadingin, Pathen ama-a konin apotdoh-in ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tun Hezekiah thilbol danghole aphatnaho chu, veuvin, Amoz chapa Isaiah gaothil mun'a le Judah le Israel lengte lekhabua chun akisunlut cheh-in ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Hezekiah chu apu apate toh alumkhomin, David chapate lhan thupipena chun avuitaove: chule athi chun Judah le Jerusalem'a chengho jousen jabolna apeuve. Chuin achapa Manasseh chu ama khelin alengchang tan ahi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manasseh lengchanpat chun kumsom le kumni ahin, Jerusalem'a kum somnga le kumnga aleng changin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla Pakaiyin Israelte masanga kona anodoh pathen helou namhon thilbol thet umtah bangchun, Pakai mitmun thilphalou abolin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu aman apa Hezekiah suhchimsa munsang ho chu asapha kitnin, Baal maicham ho atungdoh-in, thingbomho aphutnin, van janel jouse ahouvin, amaho chu ajenin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin, Jerusalem'a hi a-itih-a kamin umding ahi tia aseina mun, Pakai insunga jong chun maicham ho asemin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman Pakai houin hongcha teni-a chun van janelho jouse-a dingin maicham atungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Hinnom chapa phaicham meisung chu achate apalsah-in, phat ho jong anitnin, phun asangin, doi le ai amangchan, lhakou ho le mitpheldoi themho jong adongin: phinsetna lunghansah nadinga Pakai mitmun thilphalou tamtah abolin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Pathen in sunga chun aman milim semthuho akoijin, Pathen'in David le achapa Solomon henga, Israel namjouse anga kana lhendoh hiche Jerusalem houin sungahi a-itih-a kamin kakoi jingding:
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi khutna kona kapeh kadanthu jouse le kachona dan ho jouse, chule kachondan jouse atohdoh uva ahile, napu napateu dinga kanapeh leisetna kona jong Israelte keng kachondoh kit louhel ding ahitai tia aseina mun'a chun milim semthuho chu akoijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun Manasseh'in Judah le Jerusalem'a chengho chu Pakaiyin Israelte anga anasuhmang houbeiho sanga khohjo cheh-in thilphalou abolsahtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Manasseh le amite henga thu anaseijin, ahinla amahon ngaipeh-in anei pouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Pakaiyin Assyria sepai janel lamkaiho chu achunguva achuhsah-in, amahon Manasseh chu linglah-a akaijun, henkol abuvin, Babylon'a akaitaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ama suhgentheija aumphatnin, Pakai a-Pathen aholtan, apu apate Pathen angsunga nasatah-in akineosah tan,
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahenga ataotai: chuin alungsetna achangin, ataona asanpeh-in, alenggam Jerusalem'a ahinpui kit tai. Chuphatnin Manasseh'in Pakai amachu Pathen ahi ti ahetai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin hiche jouchun David khopi polama Gihon lhumlam vacha phaicham ngalim kotpi lutna geijin, chule Ophel gei umkimvelin kulpi asan, asana sangin atungdoh-in, Judah gama kulbang nei khopi jouse-a chun gal lamkaiho akoitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin gamdang pathenho le milimho chu Pakai in'a konin aladoh-in, Pakai in molsang Jerusalem'a anatundoh maicham ho jouse chu khopi polama apaidoh sohtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakai maicham asemphan, achunga chun chamna thilto le thangvahna thilto ganlhai abolin, Judah te chun Israel Pakai ajen dinguvin thu apen ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeng jongle mipihon munsang ho-a chun ganlhaina abol nalaijun, amavang Pakai a-Pathen'u hengabou abolu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun Manasseh thilbol dangho le a-Pathen henga ataona, chule Pakai Israelte Pathen mina ahenga themgaoho thusei ho chu, veuvin, Israel lengte lekhabua akisun cheh-e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ataonaho jong, chule Pathen'in iti alungsetnam; chule akineosah masanga achonsetna jouse le asuhkhelna jouse, munsang asahna munho jouse le thingbul le milim aphuho jouse chu, veuvin, themgaoho thusei ho lah-a akisun cheh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hitichun Manasseh apu apate toh alumkhomin, amatah insunga avuitaove. Chuin achapa Ammon ama khelin alengchang tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ammon alengchan phatchun akum kum somni le kumni ahin, Jerusalem'a kumni aleng changin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla apa Manasseh'in anabol bangin Pakai mitmun thilse abolin ahi. Ammon'in apa Manasseh'in anasema anahou khentho milimho jouse henga ganlhaina abolin;
  </para>
  <para style="p">
    <verse number="23" style="v" />Apa Manasseh anakineosah bangin Pakai anga akineosah pon; ahinla Ammon'in asuhkhel bebe jengin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin asohte ama dounan galguh abolun, a-insung tah-a athat taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla Ammon lengpa douna-a galguh bolho jouse chu gamsung miten athatgamun; gamsung mite chun achapa Josiah chu akhelin alengchan sah taovin ahi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Josiah alengchan patchun kum get ahin, Jerusalem'a kum somthumle kumkhat aleng changin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Pakai mitmu-a adih abolin, apa David lamlhahho ajotnin, jetlam le veilama akihei dohpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu alengchan kal kumget lhina-in chapangcha ahinalaijin, apa David Pathen chu ahol pantan ahi. Chuin kum somle nina-in Judah le Jerusalem chu munsang ho, doikhomho, khenthu milimho, chule lhahtho milim ho-a konin asuthengtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Baal maicham ho chu amitmun asuchimun, chule hicheho chunga um milimho chu aphuh lhun: thingbul hole khettho milimho, chule lhahtho milimho chu avochipmin, leivui ason, ahenguva kilhaiho lhan chunga chun athe jalsoh helin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thempuho guho chu amaicham chunguva ahalin, Judah le Jerusalem chu asuthenge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun aman Manasseh, Ephraim, Simeon, chule Naphtali khopiho le akimvelu jouse jongchu hitichun abolcheh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman maicham ho le doikhomho asuhchima, milim kikhengho bongsela avoh chipma, Israel gamsung pumpi-a milimho aphuh lhuh soh phatnin, Jerusalem'a akiletai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun alengchan kal kum somle kumget alhinna, gamsungle in chu asuhtheng phatnin, Azaliah chapa Shephan le khopisung vaipo thuchingpa Joahaz chapa Joah chu Pakai a-Pathen in saphadin asole.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin thempu chungnung Hilkiah henga ahung phatnun, amahon kotngah Levi mihon Manasseh le Ephraim mite, chule Israelte amoh umjouse le Judah le Benjamin mite jouse khutna kona adonkhom uva Pathen insunga akoiju sum chu apeuvin; chuin Jerusalem'a akiletaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakai in vetupma natongho khutna chun akoijun, amahon Pakai in sapha ho le semhoiho khutna apeuvin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Judah lenghon anasuhsetnu lhongho semphatna dingin song kikheng le athopna ding thing chohnadin khuthemho le insaho chu apeuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin mihon na chu tahsan umtah-in atongun; amachal nadinguva avetupmuva chu Levi ho Merari chapate-a kon Jahath le Obadiah; Kohath chapate-a kon Zechariah le Meshullam ahin; chule Levi dangho lasahna-a manchah tumthemho jousetoh na chu atonguvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho chu pohgih poho vetupma chule lhachaho tintang kinbolna jouse vesuija jong ahiuve; chule lekhasunho, vaipoho, chule kotngah ho chu Levi mite lah-a jeng ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakai in'a achoilutnu sum chu ahinladoh phatnun, Hilkiah thempupan Mosi'n apeh Pakai danthu lekhabu chu amudoh-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Hilkiah'in adonbutnin Lekhasunpa Shaphan henga, Danthu lekhabu chu Pakai in'a akimu dohtai, ati. Chuin Hilkiah'in lekhabu chu Shaphan apetai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Shaphan'in lekhabu chu lengpa henga achoijin, lengpa henga thu alhut kitnin, Nasohte boldia kigotpeh jouse chu abolnaove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Pakai in'a aum kimu sum chu alakhomun, vetup hole natongho khutna apedoh taove, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin lekhasun Shaphan'in lengpa henga, Hilkiah thempupan lekhabu khat eipei, ati. Chuin Shaphan'in lengpa anga hichu asimdoh pehtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ahitin ahi, lengpan danthuho chu ajah phatnin apon abottel tai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin lengpan Hilkiah le Shaphan chapa Ahikam, Micah chapa Abdon, lekhasun Shaphan, chule lengpa soh Asaiah chu thu apen,
  </para>
  <para style="p">
    <verse number="21" style="v" />Cheovin, hiche lekhabu kimu chungchanga hin keima le Israel le Judah'a kidalha ho din Pakai chu neigadoh peh-un: ajehchu hiche lekhabua kisun banga ipu ipateovin Pakai thu anajoplou jeh-un, Pakai lunghanna chu ichunguva akibung lhatai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin lengpan anganseho le Hilkiah chu ponho chingtupma pang Hasrah chapa, Tikvath chapa, Shallum jinu, Huldah themgaonu henga acheuvin; (tun amanu Jerusalem indan nina-a cheng ahi,) chule hiche thuchu agasei taove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amanun amaho chu adonbutnin, Israel Pakai Pathen'in hitin ati, Kahenga nahinsolpa chu seipeh uvin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakaiyin hitin aseije, Veuvin hiche munle asunga chengho chunga Judah lengpa masanga asimdoh-u lekhabua kisun sapsetna jouse chu kalhunsah ding ahi:
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu amahon eida lhaovin, akhutnuva athilbol uva kona eilunghan sahna diuvin pathen dangho henga gimnamtui ahalun ahi; hiche jeh-a chu hiche mun chunga kalunghana kibunglha ding, chule kisumit jou louding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahin Pakai dong dinga nahin soluva Judah lengpa thudol chu hitin seipeh-un, Nangman najah thuho thudola hin Israel Pakai Pathen'in hitin aseije,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche mun douna le asunga chengho douna athusei najah phatna, nalung anema, Pathen anga nakisuhnem jeh-in, chule kamasanga nakineosah-a, napon nabotel-a, kamasanga naka jeh-in; keiman jong nathu kangaipeh-e, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ven, keiman napu napate toh kagop khom ding, lungmonga lhana nakivui ding, hiche munle asunga chengho chunga kalhunsah ding thilphalou jouse chu namitnin amulouding ahi, ati. Hitichun lengpa henga thu ahinpo taovin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin lengpan mi asolin, Judah le Jerusalem'a upa jouse akhomin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin lengpan Judah mijouse le Jerusalem'a chengho jouse toh, thempuho, Levi ho, chule mijouse alen aneo Pakai in'a achetouvun; chuin aman Pakai in'a amudoh-u kitepna lekhabua thu jouse chu anabenguva asimdoh peh-in ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin lengpa chu aumna mun'a adingin, alungthim pumpi le ahinna pumpi-a Pakai nung juiding le, athupehho, ahettoh sahnaho, achondanho nitding, chule hiche lekhabua kisun kitepna thuho jouse tongdoh dingin Pakai angsunga kitepna aneijin ahi
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Jerusalem le Benjamin'a umjouse hiche-a chu dingdet dingin aseijin ahi. Chuin Jerusalem'a chengho chun a-Pathen'u, apu apateu Pathen thulhun dungjuijin abol taovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Josaiah'in Israel chate gam jouse-a konin thil thet umjouse alamangin, Israel'a umjouse chu Pakai a-Pathen'u bouchu ajensah-in ahi. Chuin ahinkho lhumkeijin Pakai, apateu Pathen ajuija konin akichoi dohpon ahi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin Josiah'in Jerusalem'a chun Pakai dingin kalchuh kut amangin: lha masapen nisomle nili nin kalchuh kut sa athatnun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin thempuho chu akinganse naova apansah-in, amaho chu Pakai in'a kinboldin atilkhouvin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakaiya dinga atheng Israelte hila pang Levi ho jah-a chun, Israel lengpa David chapa Solomon'in asah in'a chun thingkhong thengchu koijun; hichu nalengkou uva dinga pohgih hitalou ding ahi: tun Pakai na Pathen'u le ami Israelte jenun,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Israel lengpa David sutle achapa Solomon sut dungjuijin, napu napateu insungho kailhah dungjui le nakihopkhen dungjuijun kigotup uvin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule mipi ho nasopiteu insung kailhah kikhen dungjuile, Levi insung kailhah kikhen dungjuijin muntheng chun dinguvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun kalchuh kut sa that unlang kisuthengun, chule Mosi khutna kon Pakai thu dungjuija atoh theina diuvin, nasopiteu chu gongtoh-uvin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Josiah'in chuche mun'a um mijouse chu kalchuh kutna atodiu ganhon lah-a konin kelngoinou le kelnou sangsomthum le bongchal sangthum apen, hicheho chu lengpa neija kon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin apipuiho chun mipi ho, thempuho, chule Levi ho chu hongphal tah-in apeuvin; Pathen in vaipo Hilkiah, Zechariah, chule Jehiel chun thempuho chu kalchuh kut thiltodin ganchaneo sangni le jagup le bongchal jathum apeuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Conaniah le asopi Shemaiah le Nathaneel, chule Levi ho pipu Hashabish le Jeiel, chule Jozabad jongchun Levi ho henga kalchuh kutna todin ganchaneo sanga le bongchal janga apeuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun lhacha natohna chu agongun, lengpa thupeh bangin thempuho chu amun cheh uvah adingun, Levi ho jong aloi loijin apang taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon kalchuh kut sa athatnun, thempuhon akhutna konin thisan atheuvin, Levi hon avun alipmuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mosi lekhabua kisun banga, mipi chun a-insungu kikhen dungjuija Pakai henga atotheina dingun, govam thiltoho chu aladoh-un ahi. Hitichun bongchalho jong aboluve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin kalchuh kut sa chu chondan dungjui jin meija agou minun, thilto theng dangho vang bel le bel lengnei, chule khangbelin ahonun, mipi lah-a chun ahomdoh loi jiuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche jouchun amahole thempuhodin asemtoh uvin ahi: ajehchu Aaron chapate thempuho chu thilto thua govam thilto le thao thilto-a khojin geija kisalel uva ahi; hijeh chun Levi ho chun amaho dingle Aaron chapate thempuhodin agongtoh uvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin David le Asaph, Heman, chule lengpa mitvanei Jeduthun thupeh dungjuijin, Asaph chapate lasaho chu amun cheh-a aumun; akinuva kona atoldoh theilouna diuvin kotngah hon kotpi tina angah-un ahi; ajehchu asopiteu Levi hon agontohpeh-u ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun Josiah lengpa thupeh bangin kalchuh kut nitna dingle Pakai maicham chunga govam thiltoho tona dingin, hiche nikho mama chun Pakai kinbolna jouse chu agongtoh uvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Israel chapate chua umho chun kalchuh kut amangun, cholsolou changlhah kut jong nisagi amanguve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Samuel themgao nikho-a patnin Israel gamsunga chutobang kalchuh kut ana umkhapon; Josiah le thempuho, Levi ho, chule chua um Judah le Israel jouse, chule Jerusalem'a chenghon anaman bangun, Israel lengte jousen jong hitobang kalchuh kut hi anamang khapouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Josiah lengchan kala kum somle kumget na-a hiche kalchuh kut hi anamanu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hicheho jouse nung, Josiah'in houin agontoh phatnin, Egypt lengpa Nicho chu Euphrates luija Carchemish satdin ahungtouvin; chule Joshiah chu ama doudin akondoh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla aman ahenga palai ahinsolin, ajah-a, Judah lengpa, nangle kei kikah-a ipi iboina uma ham? tunia nangma doudinga hung kahipoi, kakisatpipa insung doudinga hungjoh kahibouve: ajehchu Pathen'in kikinno dinga eithupeh ahi: eiumpia Pathen nadoudal na-a konin kikhindalin, nasumang khante, agati sah-e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahijeng vangin Josiah'in ama-a konin amai aheidoh nompon, akisatpi theinadin amel achomsah-in, Pathen kama kon Necho thusei chu angai hih-in, Megiddo phaichama kisatpidin ahunge.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin thal kaphon Josiah lengpa ahin kapkha taovin; hichun lengpa chun asohte henga, Neipodoh-un; ajehchu nasatah-in kamachang tai ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun asohten amachu kangtalai ja konchun aladoh-un, akangtalai nina-a akoijun; Jerusalem'a ahinpolut nun, athin, apu apateu lhankhuh khatna avuitaove. Chuin Judah le Jerusalem mite jousen Josiah chu alunghempi taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Jeremiah'in jong Josiah alunghempin: chule lasa pasal hole lasa numei ho jousen Josiah chu tunigeijin akalaova akacham cham jengun, Israel gamsunga chondan khatnin asem taovin ahi: chule veuvin, hicheho chu kala lekhabua akisunin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tun Josiah thilbol dangho le Pakai danthu-a kisun dungjuija aphatnaho,
  </para>
  <para style="p">
    <verse number="27" style="v" />Anatohho apatna le ajona chu, veuvin, Israel le Judah lengte lekhabua akisun cheh-in ahi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin chuche gam mihochun Josiah chapa Jehoahaz chu apuijin, Jerusalem'a apa khelin alengchansah taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jehoahaz chu alengchan patnin kum somni le kumthum ahitan, Jerusalem'a lha thum alengchange.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jerusalem'a Egypt lengpan amachu asulhun, agamchu dangka talent jakhat le sana talent khat kai apohsah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Egypt lengpa chun asopipa Eliakim chu Judah le Jerusalem'a lengin atungin; amin chu Jehoiakim'in akhel peh-in ahi. Chuin Necho chun asopipa Jehoahaz chu apuijin, Egypt'a akaitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jehoiakim chu alengchan patnin kum somni le kumnga ahin, Jerusalem'a kum somle kumkhat aleng changin ahi. Ahin aman Pakai a-Pathen mitmun thilse jeng abolin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Babylon lengpa Nebuchadnezzar ama satdin ahung kontouvin, Babylon'a puidin bul atuh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nebuchadnezzar'in Pakai in'a khon le kongho jongchu Babylon apon, hicheho chu Babylon'a a-houin'a akoijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun Jehoiakim thilbol dangho ama-a kimudoh thet umtah thil anabolho chu, veuvin, Israel le Judah lengte lekhabua akisuncheh-e, chuin achapa Jehoiachin chu ama khelin alengchang tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jehoiachin chu alengchan patnin kum get ahin, Jerusalem'a lhathum le nisom aleng changin ahi. Chule aman Pakai mitmun thilphalou abolin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin kum kichai phatnin, Nebuchadnezzar lengpan mi ahinsolin, Pakai in'a um le bel phaho toh Babylon'a apuijin; asopipa Zedekiah chu Judah le Jerusalem chunga lengin atungtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zedekiah alengchan patchun kum somni le kumkhat ahin, Jerusalem'a kum somle kumkhat aleng changin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman Pakai a-Pathen mitmun thilse abol jingin, Pakai kama kona thuseipa Jeremiah themgao anga chun akisunem nompon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama Pathen'a ana kitep sah-a Nebuchadnezzar dounan jong agolkeh-in, Pakai Israel Pathen lama akiheina dinga konin angong avaiputnin, alung atahsah-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chukalvalin thempu pipuiho jouse le mipi chun Pathen helouho thilbol thet umtahho bangin asukhel taovin; Jerusalem'a Aman asuhthengsa Pakai houin jongchu asuboh-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule apu apateu Pakai Pathen'in amite chung le achenna mun alainatpi jeh-in, ahenguva sottol tamtahvei asolin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Pakai lunghan amite chunga akondoh chu, asudai lhading abeihel kahsen amahon Pathen thupo ho chu totnopnan aneijun, chule athuho anuisatnun, athemgaoho chu dihlou tah-in amang chaovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun achunguva Chaldea mite lengpa ahin puilutnin, amunthengu insunga agollhanghou chemjamin athatnin, gollhang le nungah, tehse le tehse kongkon chunga lainatna beijin, abonun ama khutna apedohtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pathen in'a um le bel jouse alen aneo, Pakai in'a gouho le leng in'a gouho, chule apipuiho: hitiho jouse Babylon'a apotai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Pathen in chu ahalun, Jerusalem bang asuchimun, leng inpi jouse meijin ahalun, chua um le bel phaho jouse chu asumang helun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chemjam'a kona sohcha jouse chu aman Babylon'a apuijin; chua chun Persia lenggam vaipoh kahsen amaho chu amale achapate soh-in apanguvin:
  </para>
  <para style="p">
    <verse number="21" style="v" />Gamsungin acholngahni aman kahse-a Jeremiah kama Pakai thu guilhuna dingin: ajehchu kumsom sagi asuhbulhit nadingin, agohkeova aumlaisen acholngahni chu anitnin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun Jeremiah kama Pakai thusei guilhun theinadin, Persia lengpa Cyrus lengvaipoh kumkhat na-in, Pakaiyin Persia lengpa Cyrus lungthim atildoh-in, hitichun aman alenggam sung jouse-a thuphon aneijin, chule sut thon jong akoijin ahin,
  </para>
  <para style="p">
    <verse number="23" style="v" />Persia lengpa Cyrus in hitin aseije, Leiset lenggam jouse hi van Pakai Pathen'in keima eipeh ahitan; chule Judah gam Jerusalem'a ama-a ding in sadingin eingansen ahi. Amite jouse lah-a kon koi naum uvem? Pakai a-Pathen'in ama chu umpi hen, chule ama chetouhen, ati.
  </para>
</usx>
