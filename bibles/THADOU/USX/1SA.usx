<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1SA" style="id">1 Samuel</book>
  <para style="h">1 Samuel</para>
  <para style="toc1">1 Samuel</para>
  <para style="toc2">1 Samuel</para>
  <para style="mt">1 Samuel</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Ephraim molsang Ramathiam Zophim mun'a Ephrath mi, Zuph chapa, Tohu chapa, Elihu chapa, Jeroham chapa, amin Elkanah kiti mikhat anaumin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman ji ni aneijin, khatnu minchu Hannah ahin, achom khatjonu minchu Peninnah ahi. Chule Peninnah chun cha aneijin, ahinla Hannah'in vang cha aneipoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hiche mipahi akhopia konin kumsehle Shiloh'a janel Pakai houding le ganlhai boldin achetoujin ahi. Chule Pakai thempu Eli chapateni Hophni le Phinehas chu hia chu umji lhon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Elkanah hin thilto aneiphat tengle a-inneipi Peninnah le achapate le achanute jouse chu chan apejin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla Hannah vang chun achanding doltah apejin ahi: ajehchu aman Hannah angailun, ahinla amanu chu Pakaiyin anaobu akhapeh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Pakaiyin anaobu akhapeh jehchun khatjonu chun alungnat nadingin nasatah-in alunghansah jin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule chutia chu kumseh-a aboljing ahin, Pakai in'a amanu achetou tengle amanu aphinsejin; hijeh chun amanu akapmin anjong aneji tapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin Elkanah'in a-inneipi Hannah hengah, Ibola naka ham? ebola an nelouva um nahim? chule ibola lungkhama uma nahim? Keima nang dinga chapa som sanga phajoa kahi louham? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutia amahon Shiloh'a an aneh uva, chule twi adonjou phatnun, Hannah akipatdoh tan ahi. Tun Eli thempu chu Pakai houin khom khat bula touna chunga touva ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanu chu ahinna ahesoh lheh jengin, Pakai henga ataovin, chule laina tah-in akapmin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amanu kitepna khatna akitepmin, Vo janel Pakai, nasohnu thohgimnahi neivet peh-a, neihet jinga, nasohnu hi nasuhmil louva, nasohnu hi chapa khat neipeh-a ahile, chuteng ahinkho lhumkeija Pakaiya kapeh ding, alua samchem kilamlou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ahitin ahi, amanu Pakai anga ataojom jing laihin, Eli'n amuh phunchu anaven ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tun Hannah hin alungsunga asei ahijeh-in, amuh bouchu aphunin, ahin a-aw vang akijapoi. Hijeh chun Eli'n amanu jukhamin agelin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Eli'n amanu jah-a, Itihchan nakham dingham? Naju chu nanga konin koimangin, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Hannah'in adonbutnin, Ahipoi, ka pakai, keima lungkham na-a dim numei kahi; keiman ju le khamnathei jong kadonpoi, amavang Pakai anga kahina kabuhlhah joh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nasohnu hi Belial chanun neisim hih-in, ajehchu kakiphina le kahesohna tambehseh jenga tuchana hi thu kasei ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuphatnin Eli'n adonbutnin, Lung mongin chetan: Israel Pathen'in nathilthum chu naphal pehtai ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amanun, Nasohnu hi namitnun lungsetna neimusah-in, ati. Chutichun hiche numei chu achena ding lampia achen, an anen, chule lungkham mel aputapon ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amaho jingkah matah-in athouvun, Pakai ahouvun, akileuvin, a-in'u Ramah'ah ahung taove. Chuin Elkanah'in a-inneipi Hannah chu aluppin; chule Pakaiyin amanu chu ageldoh tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun ahung hitin ahi, Hannah'in nao avopma, aphat ahunglhin tah-in chapa khat ahingin, Pakai henga kanathum ahi atin, amin Samuel asahtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Elkanah kitipa le a-insung mijouse chu Pakaiya kumtin ganlhai le akitepna tohdohdin achetou taove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla Hannah achetoupoi; ajehchu amanun a-inneipu henga, Naosen in noi abankahsea kachetou louding ahi, Pakai anga gaki lahthei ahi-a, chule chumuna a-itih-a aumden theiding teng kahinpui ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin a-inneipu Elkanah'in ajah-a, Nangman phante nati bangchun boltan; noi aban kahsen khongai jengin; Pakaiyin bou athu chu phutdet hen, ati. Chutichun amanu aum denin, chule achapan noi aban kahsen avah-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amanun noi abansah phatnin, ama chu alhontoupin; bongchal thumtoh, changbong ephah khat le lengpitwi haikhat toh Shiloh'a Pakai in'a ahinpuitai: chule chapang chu khangdong cha ahi nalaije.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin bongchal khat athatnun, naosen chu Eli henga apuitaovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amanun, Vo ka pakai, nangma nahinjing bangin, ka pakai, hilaimuna nangma koma ana dinga Pakai henga anataova numei chu keima kahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche chapang dinga hi anataova kahin; Pakaiyin ahenga kanathum kataona chu eipetai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun keiman jong amahi Pakai henga kapeh ahi; ama ahinlai chansea Pakaiya hiding ahi, ati. Chuin amapan chukoma chun Pakai ahoutan ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Hannah ataovin, Kalungsung Pakaiya akipah lheh-in, Pakaiya ka ki hi choisangin aumin ahi: nami huhhingna-a chu kakipa jeh-in, kamelmate chunga kakam akikeh lenin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai banga thenga koima aumpoi: ajehchu nang tailou koimacha dang aumpon; i-Pathen'u tobang songpi jong aumpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kiletsah valin thu seitahih-in; nakamin hoithona thu pothih hen: ajehchu Pakai chu hetna Pathen ahin, chule aman thil kibol jouse aleptohji ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihatte thalpi abong gamin, chule akipal lhuho chu hatna-in ataiju akigah pehtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ana oivaho-a chu neh holnan amaho le amaho changlhah mandin akipedoh-un, anakel ho akelkit tapouve: chutichun achingan cha sagi ahingtan, chatam neinuchu alhasamtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin athatnin achoh hingjin: chule thikholkhul'a apuisuh-in apuidoh kitjin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin avaichatsah-in chule ahaosahjin; aman asunemin chule adomsang jin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman mivaicha chu leivuija konin akaithouvin; leng chapate lah-a tousah dingle, loupina laltouna losah dingin; khutdo chu eh lah-a konin adom doh-in ahi. Ajehchu leiset khompi jouse Pakaiya ahin, achunguva chu vannoihi atun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman amithengte kengchu achintup ding; chule migiloupa chu muthima thipbeh-a umding ahi; ajehchu thahatna koima dingjou louding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai douho chu ahal hala kisuchipdiu; amaho chunga Ama van'a kona hung kitumding ahi. Pakaiyin leiset kolmong gei thu atan ding; aman alengpa chu thahat apehding, athaonupa ki chu achoisang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Elkanah a-in lam Ramah kho-a achetai. Chule chapang chun Eli thempu masanga Pakai kin aboltan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun Eli chapa teni chu Belial chapate ahilhonin, amanin Pakai ahe lhonpon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule mipi ho lah-a thempuho bolding chu, khattouvin akilhaina atodoh teng, sa chu asou laitah le thempu sohpa chun satul kathum neikhat ahinchoija;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman hichu bel bilnei, khangbel len, ahiloule bel sunga chu asutlutna, satul ka-a ahin khaidoh jouse chu thempupan ama dinga akilahji ahi. Hitia hi Shiloh'a hung Israelte jouse henga aboljiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sathao chu ago masang uva jong thempu sohpa chu hunga, ganlhaina bolpa jah-a chu, Thempupa-a dinga gopeh dingin saphe chu neipen; ajehchu aman nanga kona akihon minsa alah louding, asel bou alahding ahi, atiji ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule khattouvin ahenga, Amahon athao ago masat teiju ngai ahi, chujou tengle nahinnan adeijat jat kilah-in tia aseija ahileh; aman, Ahipoi, tu-a hi neipeh teiding ahi, achuti loule thahatsana kalahding ahi, tia adonbut ji ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti chun gollhangho chonsetna chu Pakai masanga anasalheh jengtan; mihon Pakaiya thilto chu athetlo taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amavang chapangchan Samuel'in tupat ponnem thempu boitong sangkhol aki-ah in, Pakai anga lhacha na atongin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chukalvalin anun sangkhol chol neokhat akhuipeh-in, kumsehle ganlhaina boldinga a-inneipu toh ahungtou lhonteng ahinchoi pehjin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Eli'n Elkanah le a-inneipi phatthei aboh-in, Pakai henga thilpeh jalchun hiche numeija hin Pakaiyin sonle pah napelhon hen, ati. Chuin a-in lhona achelhon tai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin Hannah ahung vilin ahile amanun nao avopmin, chapa thumle chanu ni ahingin ahi. Chule chapang Samuel chu Pakai angsunga akhanglenin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun Eli atehlheh jengtan, Israelte jouse chunga achapateni thilbol jouse; houkhom ho houbuh kotphunga numei hung kikhom ho iti alup piji lhonham ti ajatan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman aheng lhonna, Ibola chutobang thil nabolhon ham? Ajehchu nakhanset bollhon chu hiche miho-a konhin kajan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahipoi, kachateni; kajahhi thulhut phaloutah ahi: nangnin Pakai mite chu nachon khelsah lhon ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mikhat tou midang douna-a achonsetna ahile, thutanpan athu atan ding ahin: ahin mikhat tou Pakai douna-a achonsetna ahile, kon ama dinga ataopeh dingham? ati. Ahijeng vangin Pakaiyin amani thading atup jeh chun, apao thusei chu angaideh lhonpon ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin chapang Samuel chu akhang akhangin, Pakai le mihem deisah-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Pathen mikhat Eli henga ahungin, ajah-a hitin ati, Pakaiyin hitin aseije, Amaho Egypt gama Pharaoh insunga aum laijuva chu napa insunga kichentah-a kana phondoh hitalou ham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Israel phung jouse-a kona kathempu hiding, ka-maicham chunga thilto ding, gimnamtui halding, chule kamasanga thempu boitong sangkhol kivon dinga kana lhendoh hilouham? Chule Israel chate meija kigou thilpeh jouse napa insung kanapeh hilouham?
  </para>
  <para style="p">
    <verse number="29" style="v" />Ipi dinga kaumna-a kathupeh kaganlhaina le kathilto napeh manga, kami Israelte thilpeh jouse-a kon ahoipen chun nathao dohsah nadinga keisanga nachapateni najabol joh ham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh chun Pakai Israel Pathen'in, Keiman nangma insungle napa insungchu a-imatih chana kamasanga vahle diu ahi, tia anasei ahin: ahinla tun Pakaiyin, Hichu keija konin gamla tahen; ajehchu eijabol ho chu kajabol ding, chule nahsah louva eibolho chu nahsah louva kabolding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vetan, na-insunga tehse khatcha aumlouna dinga, nangma ban le napa insung mite ban kasatlhah nading nikhoho chu ahung lhungtai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Kachen namun le Pathen'in Israel apehding gou jouse-a chu melma khat aum namu ding: chule a-imatih chana na-insunga tehse umta louhel ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule ka-maicham'a kona kasatlhah louding namipa chu namitlhi sosah dingle nalungsung suna dinga kakoiding: chule na-inna peng jouse chu adonglai cheh-a thiding ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule hichehohi nachapateni Hopni le Phinehas chunga thil hunglhung dingho namelchihna ahi; nikhat sunga anilhona thilhon ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule keiman kalungthim le kangaito dungjuija tongding, keima dinga thempu tahsan umtah khat kitundoh ding: chule keiman a-insung dettah-a katundohpeh ding; chule ama a-itih-a kathaonupa masanga vahle jing ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule hung hitiding ahi, na-in'a umnalai chasun chu ahenga hunguva dangka pehkhat le changlhah kamkhat athum diu, ahenga, Changlhah halkhat kaneh theina dingin, thempu natoh khat neipen, tia asei dingu ahi, ati.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chapang Samuel chu Eli masanga Pakai kin bolin apangin ahi. Chule hichelai chun Pakai thuchu amantam lheh jengin; phongtah-a kilahna anaumpoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin hiche laichun ahitin ahi, Eli chu aumna-a alupma, kho muthei lou leuva amitchu ahung thima;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pathen kitepna thingkhong umna Pakai houin'a Pathen thaomei chu amit masang, chule Samuel chu imu ding aluplhah petnin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutichun Pakaiyin Samuel akouvin ahile aman, Hikoma kaume, tin adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ama Eli henga alhaijelin, Hikoma kaume; ajehchu nangman neikouve, agatin ahi. Chuin aman, Kakoupoi, galumkit tan, ati. Chuin ama achen alumtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin avelin akoukitnin, Samuel, ati. Chuin Samuel athouvin, Eli henga chun achekitnin, Hikoma kaume; ajehchu nangman neikou monge, ati. Chuin aman adonbutnin, Kakoupoi, kachapa; galum kittan, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun Samuel'in Pakai chu ahehih laijin, Pakai thujong chu ahenga akiphong hihlaije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin athumvei channa-in Pakaiyin Samuel akoukitnin ahi. Chuin ama athouvin, Eli henga achen, ajah-a, Hikoma kaume; ajehchu nangman neikou monge, ati. Chuin Eli'n Pakaiyin chapang chu akou ahi ahedohtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun Eli'n Samuel henga, Chen, galum kittan; chule hitiding ahi, aman nahinkou kitna ahileh, nangman, Seijin, Pakai, nasoh in kajanai natiding ahi, ati. Chutichun Samuel aumna-a agalumtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakai ahungin, adingin, amasa-a bangchun, Samuel, Samuel, tin akouvin ahi. Hichun Samuel'in adonbutnin, Seijin; ajehchu nasoh-in kajanai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Samuel jah-a, Ven Israel sunga thilkhat kabolding ahin, hichun ajachan nakhang asutding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche nikho chule Eli douna-a a-insung chungchanga kanasei jousechu kaboldoh ding; kakipat tengle achaina jong kabolding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu aman ahetsa khansetna jeh-a, a-insung chu a-imatih chana athu katan ding ahi tia kahilsa ahitai. Ajehchu achapa tenin thilse abol lhonin, aman amani anaphoh tangpoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hichejeh-a chu keiman Eli insung chunga kana kihahsela, Eli insung khansetna chu ganlhai le anneh thilto-a jong a-itih-a suhtheng thei hilouding ahi, kanati ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Samuel chu jingkah geijin alumin, Pakai in kot ho ahongin ahi. Chule Samuel'in Eli henga athilmu hetsah dingchu akichalheh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichun Eli'n Samuel akouvin, ajah-a, Kachapa Samuel ati. Chuin Samuel'in adonbutnin, hikoma kaume, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman, Pakaiyin nahenga aseichu ipithu ham? kangeh nahi, Keija konin imhih-in: nahenga aseijouse chu kahenga na-im auma ahile, Pathen'in nahenga chutobang chun chule akhohcheh-in jong bolhen, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Samuel'in thujouse chu ahilin, chule ahenga imacha a-im aumpoi. Chuin aman, Ama Pakai ahin, aman pha asah sah chun bolmaihen, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Samuel chu ahung khanglen jep jepmin, Pakaiyin aumpin, chule ama thuho chu khatcha jong tolla alhah sahpon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Dan'a pat Beersheba geijin Israelte jousen Samuel chu Pakai themgao khatnin akitung dohtai ti ahetauve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Shiloh'a chun Pakai ahung kilah kitnin ahi: ajehchu Pakai thu dungjuija Shiloh'a chu Pakai amatah Samuel henga kiphongdoh ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Samuel thu chu Israelte jouse henga ahung lhungtan ahi. Tun Israelte chu Philistine te satdin akondoh taovin, Ebenezer panga ponbuh asongun: Philistine te chun Aphek mun'a ponbuh asongun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Philistine te chu Israelte satdingin amaho le amaho akigol toh-un: chuin gal akisat phatnun Israelte chu Philistine te masanga agallel taovin; chule amahon galmuna chun galsat mi sangli tobang athat taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin mipi chu gebuh ahunglhun phatnun Israel upaho chun, Ipijeh-a tunia Pakaiyin Philistine te masanga eigol lel sah-u ham? Shiloh'a konin Pakai kitepna thingkhong chu eiho henga dingin gapodoh-u hitin, hichu ilah uva ahungteng, hichun igalmiteu khutna konin eihuhdoh theijunte, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun mipichun Cherub teni kikah-a cheng janel Pakai kitepna thingkhong chu chua kona agapoh theina diuvin Shiloh'a mi asolun: chule Eli chapateni Hophni le Phinehas chu Pathen kitepna thingkhong chutoh chukoma chun aum lhonin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakai thingkhong chu gebuh ahunglhun phatnin Israelte jousen ha aovin a-aovun, hitichun leiset akithong leovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Philistine ten gingleng lunga a-ao ginu ajah phatnun, Hebrew miho gebuh-a ging lenglung khu ipithu hitam, akitiuvin ahi. Chuin amahon Pakai kitepna thingkhong gebuh hunglhung ahi ti ahechen taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Philistine ten Gebuh-a Pathen hunglut ahi atiuvin akicha taovin ahi. Chuin amahon, Ohe idau ahi! ajehchu tumasangin hitobang thil anasoh khapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ohe idau ahi! hiche hat chungnung Pathenho khutna kona kon eihuhdoh diuham? Hichehohi gamthipma Egypt mite hivei jouse-a sugama Pathenho chu ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo nangho Philistine te, nangho soh-a ana um banguva, Hebrew mite soh-a naum louna dingun hatnunlang, kipasal sah-un: nangho kipasal sah-un lang, satnun atiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Philistine techun asatnun, Israelte chu jo-in aum taovin, chule amaho amitakip aponbuh lam cheh uva ajam taovin; chule nasatah-a kithana aumin ahi: ajehchu Israelte chu keng sepai sangsomthum athiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pathen kitepna thingkhong chu alah peh-un; chule Eli chapateni Hophni le Phinehas jong athat taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin sepai lah-a konin Benjamin phunga kon mikhat alhaijelin, apon teldehduh le aluchanga leiset pumin hicheni mama chun Shiloh'a alhailutnin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ama ahungphatnin, veuvin, Eli chu lampamah touna chung khatna atouvin, anaven ahi: ajehchu Pathen kitepna thingkhong jeh chun alungsung akithingin ahi. Chule mipa khopi sunga ahunglut phatchun aseijin ahile khopi pumpi mihochu hakan akaptaovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Eli'n ka awgin chu ajah phatnin, Hiche awging lullul khu ipithu hitam? ati. Chuin mipa chun kinotah-in ahungin, Eli ahung hiltai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun Eli chu kum somko le kumget ahitan; amit athimin, kho amuthei tapon ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin mipan Eli jah-a, Keima sepai lah-a kona hungdoh-a kahin, tunia hi sepaiho lah-a kona hungjam doh kahi, ati. Chuin aman, Kachapa, chukoma chu ipi soh em? ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin thupopan adonbutnin ajah-a, Philistine te masanga chun Israelte ajamun, mipi lah-a chun nasatah-a kithana aumin, chule nachapa teni Hophni le Phinehas jong athi lhonin, Pathen kitepna thingkhong jongchu alataove, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, aman Pathen kitepna thingkhong aphahpoh phatnin, kotpi phung sih-a chun atouna-a konin anung lhuh-in, angong atat bongin, athitan ahi; ajehchu ama tehse ahin, gih-a ahi. Chule aman kum somli Israelte thu anatanin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amounu Phinehas inneipi chu naovopma soh koncha ahi: chuin aman Pathen kitepna thingkhong kilahle atehpu le a-inneipu thithu ajah phatnin, ama abungin nao aneitan ahi. Ajehchu anatchu achunga hunglhung ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ama athikon chun akoma ding numei ho chun, Kicha hih-in; ijeh inem itile chapa khat nahin ahi, atiuve. Ahinla amanun adonbut tapon, ngaijong angaisah tapoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichun amanun naosen min chu Ichabod asah-in, Loupina chu Israel'a konin akitol mangtai ati: Pakai kitepna thingkhong kilahpeh jeh le, atehpu le a-inneipu jeh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amanun, Loupina chu Israel'a kon kitolmang ahitai: ajeh chu Pathen thingkhong kilahmanga ahitai, ati.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Philistine ten Pathen thingkhong chu alauvin, Ebenezer'a konin Ashdod'a ahinpouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Philistine ten Pathen thingkhong ahinlah phatnun, Dagon in'a ahinpouvin, Dagon koma akoi taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ajing jingkah matah-a Ashdod miho atho phatnun, veuvin, Dagon chu Pakai thingkhong masanga chun amai tollam ngan analhutan ahi. Chuin amahon Dagon chu adomdoh-un akitunna mama-a chun atung kitnun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ajing jingkah matah-a atho phatnun, veuvin, Dagon chu Pakai thingkhong masanga chun amai tollam ngan analhun; chule Dagon luchang le akhutphang teni chu tanbohsan kotbula chun anaumin, Dagon tahsa chubou ana kidalhan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Dagon thempupa hihen lang, Dagon insunga hung koi hijongle, Ashdod'a Dagon kotphung chu tuni geijin achon pouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla Pakai khutchu Ashdod mite chunga gihsatah-in achun, chule amaho chu asumangin, Ashdod le agam kimvela chengho chu uilutnin ajepmin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Ashdod miten hichu amuphatnun, Israel Pathen thingkhong hi eihotoh umthei ponte: ajehchu ama khut chu eiho chungle i-pathen'u Dagon chunga anasa behseh jengin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun amahon Philistine te milen milal jouse ahenguva akou khomun, Israel Pathen thingkhong hi i-ilo diuham? atiuve. Chuin amahon adonbutnun, Israel Pathen thingkhong chu Gath lama kipotahen, atiuve. Chuin Israel Pathen thingkhong chu chulama chun apotaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ahitin ahi, hichu chulama apoh nungun, Pakai khutchu suhgamna nasatah-in khopi dounan achun; khopi sunga mite chu alen aneo abonun ajepmin, achunguva uilut achutan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun amahon Pathen thingkhong chu Ekron'a asoltaove. Chuin ahitin ahi, Ekron'a Pathen thingkhong ahunglhun phatnin, Ekron mite chu apeng jah-un, Amahon eiho le imiteu thatgam dingin Pathen thingkhong chu eiho henga ahinpouve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Philistine milen milal ho jouse chu agakoukhom sah-un, ahenguva, Israel Pathen thingkhong hi solmangun, chule eiho imiteu eitha louna dingin aum namun mama-a chekit tahen, atiuve. Ajehchu hiche khopi jouse sunga chu suhgamna nasatah uma ahitan; Pathen khut chu gihsatah-a chua ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule mihem athilouho chunga chun uilut achun; chule khopi-a kana awgin chu van alhung touvin ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thingkhong chu Philistine gama lhasagi aga umin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Philistine ten thempuho le doithemho akouvun, ahenguva, Pakai thingkhong chu ikalodiuham? Aumna ngaija chu iti kasol diuham? neisei peh-un, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahon, Israelte Pathen thingkhong chu nasol ule agoh-in solhih-un, ahinla suhkhel thilto khattoh nalesoltha teidiu ahi; chuteng nadam uva, ipijeh-a nangho-a kona akhut achondoh louham ti nahet dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun amahon, Amatoh kalesol tha dingu suhkhel thilpeh dingchu ipi hiding ham? atiuve. Amahon adonbutnun, Philistine te milal ho jat dungjuija uilut lim sanatum ngale sana jucha lim nga; ajehchu nabon chaova chungle namilen milal hou chunga chu natna kibang chua ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun gamsung suse na-uilutnu limle najucha limu chu nasem uva; chule Israel Pathen chu loupina napeh dingu ahi. Chuti henlang hile nanghole na-pathen hou, chule nagam uva konin akhut ajangkhaisah domding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti ahile ibola Egypt mite leh Pharaoh banga nalungu natahsah uham? Aman alah uva kidangtah-a na atoh phatna chu amahon mipi achedohsah uva, chule amaho potdoh-u hilouham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun kangtalai thah khat semun lang, namkoljon pokhalou bongpi noi kilhohlai ni kaijun, chule bong kang chuto sutouvin lang, anouteni chu amani-a konin inlama hinkaijun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Pakai thingkhong chu domun lang bongkang chunga koijun; chule suhkhel thilpeh ding sana tum amato nung soltha dinga nasemhou chu thingkhong khatna khumun lang apanga koijun; chule achemang nadingin solmangun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Beth-shemesh lampia ama gamkaija chu chetoupeh-am veuvin; achetou peh-a ahile hiche thilse khohtahhi amabol hija ahi; amavang achetoupeh louva ahile, eisugimuva chu ama khut ahipon, achama ichunguva hungsoh ahi ti ihetdiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin mihon achuti bolun, bongpi noi kilhohlai ni akaijun, chule bongkang chuto asutouvin, chule anouteni chu in'a ahentup taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakai thingkhong le sana jucha lim le uilut lim umna thingkhong chu bongkang chunga chun akhangdoh taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin bongpi tenichun Beth-shemesh jotna lamchu ajonjang lhonin, kun pumin lamlhongpi chu ajotpeh lhonin, jetle veija apetdoh lhonpoi; chule Philistine milal hochun Beth-shemesh gamgi geijin ajuipeh-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Beth-shemesh mihochun phaichama chu asuhlou changu ana-atnu ahin: amaho akhoda uva ahile thingkhong chu amutaovin, hiche amujeh-u chun akipah lheh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin bongkang chu Beth-shemesh khomi Joshua lou ahung lutnin, chua songpi lentah khat umna-a chun adingtai. Chuin amahon bongkang thingchu a-eh un, bongpi tenichu Pakai henga govam thilto-in atoh taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Levi hon Pakai thingkhong le aumpi sana manluho umna thingkhong chu alalhauvin, songpilen chunga chun akoitaove. Chule Beth-shemesh mihon hiche nikho mama chun Pakai henga govam thiltoho le ganlhainaho abol taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Philistine milal ngahon hiche amuphatnun, hicheni mama chun Ekhron'a akile taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Philistine ten Pakai henga suhkhel thilto dinga ahin nungsolu uilut lim sanatumho chu ahile; Ashdod dinga khat, Gaza dinga khat, Ashkelon dinga khat, Gath dinga khat, chule Ekron dinga khat ahin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule sana jucha limho chu, kul kikai khum khopiho le thinglhang khoneoho puma Philistine te milen milal nga ho khopi jouse jat dungjuija ahin, Pakai thingkhong akoilhahnao Abel songpilen chung geichu ahi. Hiche songpi chu Beth-shemesh mite Joshua loulaija chu tuni geijahi umjing nalai ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahon Pakai thingkhong sung avetjeh-un, Aman Bethshemesh mihochu athatnin; mipi ho lah-a mi sangsomnga le somsagi jen athatnin ahi. Pakaiyin mipichu tamtah atha jeh-in mipi chu alunghem taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Beth-shemesh miho chun, Hiche Pakai Pathen thengtah masanga hi koiham adingjou dinga? Chule eihoa kona ama koihenga chedoh dingham? atiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon Kirjath-jearim kho miho henga thupole ho asolun, ahenguva, Philistine ten Pakai thingkhong ahinpokit taove; hungsuh-un lang naheng uva potaovin, atiuve.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Kirjath-jearim miho chu ahungun, Pakai thingkhong chu apotouvun, thinglhanga Abinadab insunga apolutnun, achapa Eleazar chu Pakai thingkhong chingtup dingin athenso taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, Kirjath-jearim'a thingkhong chu phat sottah aumin ahi; ajehchu kum somni jen uma ahi. Hitichun Israel insung pumpi chun Pakai lhangaijin akachamun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Samuel'in Israel insung jouse jah-a, Nangho nalung pumpiuva Pakai henga hungkile nahiuva ahile, nalah uva konin gamchom pathenho le Ashtaroth chu koimangun; chule Pakaiya din nalungu gongtup unlang, amabou jenun: chutile aman Philistine te khutna kona nahuhdoh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun Israel ten Baalim le Ashtaroth chu akoimangun, Pakai bou ajentaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Samuel'in, Israelte chu abonchauvin Mizpeh'a khom khomun, chule keiman Pakai henga nataopeh uvinge, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mizpeh'a akikhom khomun, twi athalun, Pakai angsunga asunglhaovin, hiche nikho chun an angolun, Keiho Pakai dounan kachonse taove, atiuve. Chuti chun Samuel'in Israelte chu Mizpeh'a athu-u atanin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Philistine ten Israelte Mizpeh'a akikhom khomuve ti ajah phatnun, Philistine milal ho chu Israelte doudingin akontouvin ahi. Chuin Israel chaten hichu ajah phatnun, Philistine te chu akicha taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Israel chaten Samuel henga, Philistine te khutna kona eihuhdoh nadingun Pakai ka-Pathen'u hengu keiho dingin tanglouvin neitao peh-un, atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Samuel'in kelngoinou noicheplai khat alan, apumin Pakai henga govam thilto-in atohdoh-in: Israelte din Pakai henga ataovin; Pakaiyin asanpehtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Samuel'in govam thilto ato laijin, Philistine te chu Israel satdin ahung naijun ahi. Ahinla Pakaiyin hiche nikho chun Philistine te chunga vangin nasatah aginsah-in, alungboi sah-in, Israelte masanga agal lel taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Israel mite chu Mizpeh'a konin apotdoh-un, Philistine te chu anungdelun, Beth-car aphah kahseovin athatpeh-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Samuel'in song khat alan, Mizpeh le Shen kah-a atungin, chuin Hichan geijahi Pakaiyin eipanpiu ahi atin, aminchu Ebenezer asahtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutichun Philistine te chu suhnemin aumun, chule amaho Israelte gamsunga ahungkit tapouve. Samuel nikho laisen Pakai khutchun Philistine te adou jingin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Philistine ten Israel te-a kona analah khopiho chu Ekron'a pat Gath geijin Israelte alepeh kit tan; chule agam kimvelho jouse jongchu Philistine te khutna konin Israel ten alelah kit taovin ahi. Chule Israelte le Amor mite kah-a chun chamna aumin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Samuel'in ahinlai sungin Israelte thu anatanin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule akumseh'in Bethel le Gilgal, chule Mizpeh'a achekol lejingin, hiche munho-a chun Israelte thu atanjin ahi
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Ramah'a chun a-in aumjeh'in ahungkile kitjin; chule hia chun Israelte thu anatanjin; hia chun Pakai dingin maicham khat asemin ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Samuel ateh phatnin achapa teni chu Israelte chunga thutandin apansah tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tun achapa lenpenpa minchu Joel ahin; aninapa minchu Abiah ahi: amanichu Beersheba-a thutan ahilhone.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule achapa teni chu ama lampia achelhonpon; ahin alam louva sum muding agolhonin, nehguh akilah lhonin, chule thudih chu aheikon lhonin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun Israel upaho jouse chu akikhom khomun, Samuel henga Ramah'a ahungun,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule ajah-a, Ven, nangla natehtan, nachapa tenila nang lampiho-a achelhon poi; tun namdangho jouse bangin kathu-u tanding leng khat neisem peh-un, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla amahon, Kathu-u tanding lengkhat neipeuvin, tia aseiju chun Samuel alung phatmo sah-in ahi. Chuin Samuel Pakai henga ataotan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin Samuel henga, Mihon nahenga aseijouse chu ngaipehtan, ajehchu amahon nangma napaiju ahipon; amavang achunguva vai kahom louna dinga keimajoh eipaiju ahibouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Egypt gama kona kahinpuidoh-a pat tuni geija athilbol jouseu dungjuija keima eidalhah uva, pathen dang ajenjiu banga chu, nangma henga jong abolu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun tun amaho thuchu ngaipeh-in: ahijeng vangin amahochu gihsalin lang, achunguva leng changdingpa thutan dingdan chu musah-in, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Samuel'in Pakai thuho jouse chu leng neipeuvin tia ngeh-a mipi ho henga chun ahiltan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman, Hichehi nachung uva lengchang dingpa thutan dingdan chu hiding ahi: aman nachapateo chu ama-a dinga alah-a, akangtalaiho-a ding le asakol sepai dinga apansah ding, chule abang asakol kangtalai masanga lhaiding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule aman asang chunga gallamkai, somnga chunga gallamkai dinga apansah ding; chule amaho chu alou lhouding, achang atding, agalmanchah semding, chule asakol kangtalai ho manchah sema apansah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman nachanuteu chu gimnamtui semding, anhon ding, chule changlhah semdinga akilahding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman nalouhou, nalengpi leihou, chule na-olive honhou chu aphapenho kisana alah-a, asohte apehding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman namuchi houle nalengpigao somakhat alah-a, avaipoho le asohte apehding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman nasoh pasal hou le nasoh numei hou, chule nagollhang phapenhou le nasangan hou chu alah-a, ama na atohsah ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman nakelngoi honhou somakhat alahding: chule nangho ama soh-a napan dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiche nikho chule nanakilhenu lengpa jeh-a chu nahung ka diu; chule hiche nikho chule Pakaiyin nanangai peh loudingu ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahijeng vangin mipichu Samuel thusei chu ngaiding anompouvin; amahon, Ahipoi, kachunguva leng khat kaneitei dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu keiho jong namdangho jouse tobang kahidiu; chule kalengpaovin kathu-u eitan pehdiu, chule kamasanguva lamkaija kagalu eisatpeh dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Samuel'in mipi ho thujouse chu angaijin, chuin abonchan Pakai nakhang sunga akhumsoh kitnin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakaiyin Samuel henga, athuseiju ngaipeh inlang leng khat tundoh pehtan, ati. Chuin Samuel'in Israel miho henga chun, Amitakip nakhopi cheh uva chetaovin, ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichelai chun Benjamin mikhat amin Kish kiti Abiel chapa, Zeror chapa, Bechorath chapa, Aphiah chapa, Benjamin mi, mihat thuneitah khat aumin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman gollhang dei umtah le hoitah amin Saul kiti chapa khat aneijin: chule Israel chate lah-a chun ama sanga hoija mi aumpoi. Alengkouva pat chunglamse chu midangho vuma sangdoh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Saul pa Kish sanganho chu amangin ahile Kish'in achapa Saul jah-a, Tun kipat in, nasoh ho lah-a khat kipuijin lang, sanganho holin chen, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman Ephraim molsang ajotpeh-in, Shalisha gamsung ajotnin, ahinla amanin amujou lhonpon ahi. Chuin Shalim gamsung ajotpeh lhonin, chua jong chun anaum pouvin ahi. Chuin Benjamin gamsung ajotpeh lhonin, ahinla amudeh lhonpoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amani Zuph gam ahunglhung lhon phatnin, Saul'in ahin kilhonpi asohpa jah-a, Hungin, kileta hite, achuti loule kapa sanganho chung sangin eini chunga lungkham jogetninte, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman ahenga, Ven, tuhin hiche khopi sungahin Pathen mi khat aume, chule amachu ja umtah mi ahin; aman asei jouse guilhung jengji ahi. Tun hilama chun chehite; ijem atile ichena lhonding lampi eihil theilhon khattou vinte, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun Saul'in asohpa jah-a, Ahinla ven, eini chelehen mipa chu ipi ichoipeh dingham? Ajehchu ibelsung lhona changlhah la abeisohtan, Pathen mipa choipehding thilpeh dingla aumpon: ipi ineijem, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin sohpa chun Saul adonbut kitnin, Ven, keiman kakhutna dangka shekel khat hoplia hopkhat aume; ilampi lhonding eihil lhon nadingin, hichehi Pathen mipa chu petange, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />(Masanglaijin Israel gama Pathen thudoh neidinga mi achetengle, Hungin, mitvah neipa henga chehite, ana tijiuve. Ajehchu tu-a themgao kitihi masanga chu mitvah neipa kitiji ahi).
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Sual'in asohpa henga, Naseidih-e; hungin, chehite, ati. Chuti chun Pathen mipa umna khopi-a chun achelhon tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin khopi jotna lhanga chu akaltou lhona ahile, soh nungah ho twithal dinga hungpot dohho amulhonin, ahenguva chun, Mitvah neipa chu umam? atilhone.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon amani chu adonbutnun, Aumnai, ven, ama namasang lhona ache-e; tun kikinsah lhonin, ajehchu ama tunia hi khopi-a hunga ahi; ajehchu tunia hi munsanga mipi ganlhaina umding ahi:
  </para>
  <para style="p">
    <verse number="13" style="v" />Khopisung nalut lhonlhonle munsanga an ne-a ache masanga namupai jeng lhonding ahi: ajehchu ama ahunglhun masanga mipihon an anehlou dingu ahi, ajehchu aman ganlhaina chu phatthei aboh-a, chujou teng akikouho chun anehdiu ahi. Hijeh chun tun chetou lhonin, tuphat donnahi ama namu lhonding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin khopi sunga chun achetou lhontai: amani khopisung ahunglut lhon phatnin, veuvin, munsanga cheding chun Samuel chu amani henglam jonin ahunge.
  </para>
  <para style="p">
    <verse number="15" style="v" />Saul hunglhun masanga nikho-a chu Pakaiyin Samuel nabenga hitia anasei ahitai,
  </para>
  <para style="p">
    <verse number="16" style="v" />Jing nikho tuphat don hileh Benjamin gama kon mikhat kahinsol ding ahin, amachun Philistine te khutna kona kamite ahuhdoh theina dinga, kami Israelte chunga gallamkai dinga amachu thao nananu ding ahi: ajehchu akanao kaheng ahunglhun tahjeh-in, kamite chu kakhohsah tan ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Samuel'in Saul amuphatnin, Pakaiyin ahenga, Ven! keiman nahenga kanasei mipa chu, hiche mipa hin kamite chunga vai apohding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Sual'in kotpi phunga chun Samuel chu agah naijin, Katao ahi, mitvah neipa in chu hoilaiham neihilin, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Samuel'in Saul adonbutnin, Keima mitvah neipa chu kahi: munsang lama chun kamasanga chetouvin; ajehchu nangman tunia hi keima toh an ineh khomding, chule jingtengle kasol bepding; nalungsunga um jouse chu kahil ding nahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nithum masanga anamanga nasangan hou thudola vang, amaho chunga chun lungkham hih-in; ajehchu amahochu amutaove. Chule Israelte ngaichat ho jouse chu koichunga umam? Nangmale napa insung pumpi chunga uma hilouham? ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Saul'in adonbutnin, Keima Israel phung jouse lah-a aneopen Benjamin mi kahi louham? chule ka-insung jong Benjamin phunga alhumpen hilouham? achutile ipijeh-a kahenga hitobang chu naseiham? ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Samuel'in Saul le asohpa chu kikhopna in'a ahin puilutnin, akikouho lah-a mun loupi pena atousah-in ahi: amaho chu somthum tobang ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Samuel'in anhonpa jah-a, Nahenga, Atum beh-in koijin, tia kapeh sachan chu hinchoitan, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin anhonpan adah le achunga umhochu adomdoh-in, Saul anga aluitai. Chuin Samuel'in, Ven, anakikhen khenna chu hiche hi ahi, na-anga akiluije; ne-in; ajehchu, Keiman mipi ho kakouve kati-a pat tuchana hi nangma dinga anakikoi ahi, ati. Chutichun hiche nikho chun Saul'in Samuel to anekhomin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin munsanga kona khopi sunga ahungsuh phatnun, Samuel'in indan chunga chun Saul akihoulimpin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin matah-in athouvun; nisa sophat donin ahitin ahi, Samuel'in Saul chu indan chunga chun akou touvin, ajah-a chun, Kasoldoh theina dingin thouvin, ati. Chuin Saul athouvin, amale Samuel chu achedoh gel lhontai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin khopi pam geija achesuh lhon laijin, Samuel'in Saul jah, Sohpa hi imasang lam lhona ache nadingin solin, (ama achetai,) ahin nangma vang Pathen thu kamusah theinadin chomkhat dingdenin, ati.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Samuel'in thaothei khat alan, aluchunga asunglhan, amachu achopmin, ajah-a, Pakaiyin agoulote chunga gallamkai dinga thao nanu hilouham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Tunia hi nangma keima-a kona nachedoh tengle, Benjamin gamgi Zelzah'a Rachel lhan koma mini namu ding; chule amanin nangma henga, Ahol dinga nache lona sanganho chu akimutai: chule ven, napan sanganho khohsah ding anga-in, nangma dingin alungkhamin, Kachapa dinga hi ipi kabol dingham? atie, ati lhonding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuteng chua konchun masanglama chebe lechun Tabor phaicham lhungin natin, chua chu Bethel'a Pathen henga chetou mi thum nakimuto piding, khatpan kelnou thum, khatpan changlhah thum, chule khatpan lengpitwi haikhat achoiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amaho chun chibai naboh diu, changlhah ni napeh dingu; hichu akhutnuva kona nakisan ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujou tengle Philistine sepaiho umna Pathen lhang chu nahung ding; chule hitiding ahi, hiche khopi-a chu nahungtengle, tumging le khongcha, kuli, chule selangdah amasanguva hintho-a munsanga kona hung kumlha themgao honkhat nakitopi ding; amaho chun gaothu asei dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Pakai lhagao nachunga hungchu ding, amahoto gaothu nasei khomding, chule michombeh nakiso ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hung hitihen, hiche melchihnahohi nachunga ahunglhun tengle, thil hungso dungjuija nabol jengding ahi; ajehchu Pathen'in na-umpinai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangma kamasanga Gilgal'a nachesuh ding; chule ven, govam thiltoho tohdingle chamna thilto ganlhaina toh dinga nahenga kahungsuh ding ahi. Nangman ipi nabolding musah dinga nahenga kahung kahse-a, nisagi nakhongai ding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ahitin ahi, ama Samuel'a kona kinungle dinga che akigotchun, Pathen'in ama lungchom khat apen; hicheni chun melchihna jouse chu aguilhung soh heltai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amani chuche lhang lama chu ahung lhona ahile, veuvin themgao honkhat toh akitoh lhonin; chule Pathen lhagao achunga ahung chutan, chuin aman alah uva chun gaothu aseitan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, masanga ama anahesa jouse chun aman themgaoho lah-a gaothu asei chu amuphatnun, miho chu khatle khat akihouvun, Kish chapa chunga khu ipi hungsoh-a hitam? Saul jong themgaoho lah-a panga hitam? atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin chukoma mikhatnin adonbutnin, Ahin apao chu koiham? ati, hijeh chun Saul jong themgaoho lah-a panga ham? kitihi thuchih ahung hidohtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin athemgao thusei kichai chaijin, ama munsang lama ahungtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Saul pangahpa chun amale asohpa henga, Hoilama nache lhonham? ati. Chuin aman, Sangan hola che kahi lhonin: chule hoimacha kamu lhonlou phatnin, Samuel henga kahunglhone, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Saul pangah pan, Katao ahi, Samuel'in nahenga ipi aseijem neihilin, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Saul'in apangahpa henga, Aman sanganho chu akimutai tin kichentah-in eihil lhone, ati. Ahinla lenggam thudol Samuel'in aseivang chu ahilpoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Samuel'in mipichu Mizpeh'a Pakai henga akoukhomin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel chate jah-a chun, Israel Pakai Pathen'in hitin aseije, keiman Egypt'a konin Israel kahin puidoh-in, Egypt mite khutna konle lenggam jouse-a kon, chule nasugenthei houva konin kahuh doh-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahin tunin nahesoh naole nagenthei nao jouse-a kona nahuhdoh uva Pathen nanotthap taovin; chule nanghon ama henga, Ahipoi, kachunguva leng khat neitun peh-un, nati uve. Hijeh chun tun nangho tah Pakai masanga aphung phungin, asang sangin hungkipe doh-un, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Samuel'in Israel phung jouse aheng ahin naisah phatnun, Benjamin phungchu alhengtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin phung chu a-inko kou-a aheng ahin nai phatnun, Matri insungchu lhen ahin, Kish chapa Saul chu lhendoh ahitai. Ahinla amachu aholule amujou pouve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun amahon mi ahung be ding umnalai em, tin Pakai chu avelin adong kitnun ahi. Chuin Pakaiyin adonbutnin, Veuvin, ama thilkeu lah-a akisele, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amaho alhaijun chua konin agapuidoh taovin ahi: chuin ama mipi lah-a adin phatnin, alengkouva pat chunglamse chu mijouse sangin asangjon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Samuel'in mijouse jah-a chun, Pakaiyin alhenpa, mijouse lah-a amatobang aumlou khu namu uvem? ati. Chuin mijouse chun hatah in asamun, Pathen'in lengpa huhhing hen, atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujouvin Samuel'in mipi chu lenggam thudol ahilin, lekhabu khatna asun lutnin, Pakai angsunga chun akoitai. Chuin Samuel'in mipi ho chu ama ama incheh-a asolmangtai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Saul jong Gibeah'a a-in'a achetan; chule Pathen'in alungu atohkhah mi honkhatnin alhonpiuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla Belial chate chun, Hiche pan iti eihuhdoh diuham? atiuve. Chuin amahon ama nahsahmon abolun, thilpeh imacha ahinchoipeh pouve. Ahinla ama athipbeh-in ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Ammon mi Nahasah chu ahung konin, Jabesh-Gilead dounan gebuh asongin ahi. Chuin Jabesh mijouse chun Nahash jah-a, Keihotoh kitepna khat semin, chule keihon nangma kajen dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Ammon mi Nahash chun adonbutnin, Hitia hi nang hotoh kitepna kasem ding ahi, namit jetlam jouseu kakaldoh-a, Israel jouse-a dinga jum na hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jabesh upahon ajah-a, Israel gamkai jouse thangkou kasolthei nadiuvin, ni sagi neikhongai jun; chujouteng eihuhdoh dingu mi aumlouva ahile nahenga kahung kipehlut dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun thupole ho chu Saul chenna Gibeah ahung lhungun, thuchu miho jah-a aseitaovin ahi. Chuin mijouse awgingin akaptaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin veuvin, Saul chu louva konin ganchahon nunga ahungin ahi; chuin Saul'in, Ipi hahsatna uma mipi ho khu kapma hiuvam? ati. Chuin amahon Gibeah miho thupoh chu aseipeh taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Saul'in chuche thuho chu ajah phatnin Pathen lhagao achunga ahungchun, alunghana chu nasatah-in akoujah jengtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin bongchal ni alan, achenbong bongin, Israel gamkai jouse-a thupole ho khutna athotnin, Saul le Samuel nung hinjuilou chanchu hitabonga hi abongchal chunga kibolding ahi, ati. Chuin mipi chunga chun Pakai ginna achutan, amaho lungkhat tah-in ahung kondoh taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman amahochu Bejek mun'a asimin ahile, Israel chate chu sangjathum ahin, Judah miho chu sangsomthum ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amahon thupole mi ahungho henga, Jabesh Gilead miho henga chun, Jing nikho nisasat laitahle kithopina namu dingu ahi, tin gaseipeh-un atiuve. Chuin thupole ho chu ahungun, Jabesh miho chu aseipeh-un ahile, amaho akipah lheh-un ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun Jabesh mihon, Jingle naheng uva kahungdoh dingu ahin, nanghon kilominte tia pha nasah bangun kachungu boltaovin, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ajingin ahitin ahi, Saul'in mipi chu loithumin ahom khenin; jingpi phalvah-in amaho janel lailung tah-a chun alutnun, Ammon miho chu nisa asatdoh kahsen athatnun ahi. Chuin ahitin ahi, mi ni kidalha khoma aumlou kahsen, amoh chengse chu akithe cheh-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin mipi chun Samuel henga, Saul chu ichunguva lengchang mongding ham tia seija chu koiham? keihon katha theina dinguvin, amaho chu hinpuijun atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Saul'in, Tunia hi mi khatcha kithat theilou ding ahi; ajehchu tunia hi Pakaiyin Israel sunga huhhingna na atoh ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin Samuel'in mipi ho jah-a, Hungun, Gilgal'a cheohitin, chule chua chun lengam gasemthah-u hite, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin mipi ho jouse chu Gilgal'a acheuvin; chule Gilgal'a chun Pakai masanga Saul chu lengin asemtaove. Chule hiche mun'a chun Pakai angsunga chamna thilto ganlhaina apeuvin; chuachun Saul le Israel mite jouse nasatah-in akipah-un ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Samuel'in Israelte jouse jah-a, Veovin kahenga nasei jouseu chu kangaijin, nachung uva lengkhat kasempeh taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule tun veuvin, lengpa chu namasanguva achei: chule keima tehse lukang kahitan; chule veuvin, kachapate nang hotoh aumui: chule keima kachapan laijapat tunigeija hi namasanguva chejing kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Veuvin, keima hikoma kaume; Pakai le athao nupa anga kachung chang thu hettoh sah-un: koi bongchal kalahpeh umkham? koi sangan kalahpeh umkham? koi kajoulhep umkham? koi kasuhgenthei umkham? ahiloule koi khutna kona kamit chotna dinga nehguh kalah umkham? Keiman hichu nangho kalepeh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amahon, Nangman neijoulhep khapouve, nei sugenthei kha pouvin, chule koima khutna konin jong nala khapoi, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman ajah uvah, Kakhutnahin adihlou ima namupouve tihi Pakai chu nachung uva ahetoh ahin, athao nupa hi tunia ahetoh ahi, ati. Chuin amahon, Amachu ahetoh ahi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Samuel'in mipi jah-a, Mosi le Aaron ana gonga, chule Egypt gama kona napu napateu hinpuidoh-a chu Pakai ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun nanghole napu napateu chunga anabol Pakai chonphatna natoh jouse chu, Pakai masanga nangho toh kagelkhom theina dingin dingdet nun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Egypt'a Jacob alut nungin, napu napateu chun Pakai akouvun, chuin Pakaiyin Mosi le Aaron asolin, amanin napu napateu chu Egypt'a kona apuidoh lhona, hiche munahi achensah lhon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amahon Pakai a-Pathen'u chu asuhmil phatnun, aman Sisera Hazor janel gallamkai khut le Philistine te khutna, chule Moab lengpa khutna ajoh doh-in, chuin amahon amaho asatnun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amaho Pakai henga akapmun, ahenga, Keihon Pakai kadalhah uva Baal lim le Ashtaroth kajen jeh-un kachonse taove: ahinla tun kamelma teo khutna konin neihuhdoh uvin, chutile nangma kajen diu ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Jerubbaal, Bedan, Jephthah chule Samuel asolin, ningtina namelmate hou khutna konin nahuhdoh-un, lung mongin nacheng taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin nanghon Ammon chate lengpa Nahash nangho douna-a ahung namu phatnun, Pakai na Pathen'u chu nalengpao ahilaijin, nanghon kahenga, Ahipoi; leng khatnin kachunguva vai ahomding ahibouve, nati uve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun tun veuvin, nanghon nalhen ule nangaichatnu lengpa chu hikoma aume; chule veuvin, Pakaiyin nachung uvah leng khat atungtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanghon Pakai nagin uva, ama najen uva, a-aw nangai uva, chule Pakai thupeh chu nadou daova ahile, nangho le nachung uva vaipo lengpan jong Pakai Pathen chu najuijom jing dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla Pakai awchu nangailou uva, Pakai thupeh chu nadou uva ahile, Pakai khutchu napu napateu chunga anachuh banga, nangho chunga hungchu ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun tun, dingun lang hiche thil loupitah Pakaiyin namitmuva namasanguva abol dinghi veuvin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tunihi suhlou chang atni hilouham? leng nakithum jeh uva Pakai mitmu-a nathilbolu nagitlou nao chu lentah ahi ti nahetdoh uva chule namutheina diuva keiman Pakai kakou ding; aman van ginle go ahinsolding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutichun Samuel'in Pakai akouvin ahi; chuin hiche nikho chun Pakaiyin van ginle go ahinsolin: chuin mijousen Pakai le Samuel chu nasatah-in aging taovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin mipi jouse chun Samuel henga, Kathi louna diuvin Pakai na Pathen henga nasohtedin neitao peh-un; ajehchu kachonsetnau jouse belapma hiche lenghi kaki thumu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Samuel'in mipi ho henga, Kicha hih-un: nanghon hiche gitlouna jousehi nabolu ahitai: hitajongle Pakai juina-a konin kiheimang daovinlang, nalung pumpiuvin Pakai chu jenuvin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule kiheimang hih-un; phatchomnabei le huhhing theilou pannabei thilho najui louheldiu ahi; ajehchu hihochu ahomkeo ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutile Pakaiyin amin loupina jala amite adalhah louding ahi: ajehchu nangho amite-a semdinghi Pakai kipana ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chukalvalin keiman vang, nangho dinga kataona man kangah-a Pakai chunga kachonset dingchu Pathen'in jahda hen; amavang keiman apha le lamdih chu kahil dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakai bou gingun lang, nalung pumpiuvin thutah-in ama jenun: itobang thil loupitah nanabolpeh-u hitam ngaitouvin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla nangho gilou tah-a nachon jingule, nangho le nalengpau nagom uva namanthah dingu ahi, ati.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Saul kumkhat aleng changin; chuin Israelte chunga kumni alengchan phatnin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Saul'in ama dingin Israelte lah-a konin pasal sangthum alhengdoh-in; sangni chu Saul'in Michmash le Bethel molsanga aumpin; sangkhat chu Jonathan toh Benjamin gam Gibeah'a aumun: chule mipi amohho chu apon in cheh uvah asoltan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jonathan'in Gebah'a Philistine sepai touho chu asatnin, hichu Philistine ten ajataove. Chuin Saul'in, Hebrew miten anajaohen atin, gamsung jouse-a chun sumkon amutnin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Israelte jousen Saul'in Philistine sepai honkhat abulu-in, chule Israelte chu Philistine te hot ahung hitaove ti ajataovin ahi. Chuin mipi ho chu Saul lengpa henga Gilgal'a akikhom taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Philistine te chu Israelte toh kisatdin akikhom khomun, sakol kangtalai sangsomthum, sakol sepai sanggup, chule mipi chu twikhanglen kama neldi jat helin atamun ahi. Chuin amaho ahung kondoh-un, Beth-aven'a pat solama um Michmash'a pannun asemun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutia Israel miten nochinto-a aumu amuphatnun, (ajehchu mipi chu lungdong lheh jenguva ahi,) mipi chu songko sung, hambohlah, songpiho-a, munsang ho-a, chule kotong dunga akisel gamtaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Hebrew mi phabep Jordan agalkai jun, Gad le Gilead gama acheuvin ahi. Saul vangchu Gilgal'a aum nalaijin, mipihon kihotpum pummin anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Samuel'in phat ateppeh dungjuijin, nisagi aumin: ahin Samuel chu Gilgal'a ahunglou phatnin; mipi ho chu ama-a konin akithecheh taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Saul'in, Hikoma hin kahenga govam thilto le chamna thilto hinchoijun, ati. Chuin aman govam thilto aboltai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, aman govam thilto atojou jouvin, veuvin, Samuel ahung lhung paijin; chule Saul chu amatoh kimuto-a chibai bohdin apotdoh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Samuel'in, Ipi bola nahim? ati. Chuin Saul'in, Mipi ho keija kona akithe cheh uva, nangla nikho kitep sunga nahung da-a, chule Philistine te Michmash'a akichop khomu kamuphatna;
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichejeh-a keiman, Tu-a hi Philistine te keima doudinga Gilgal'a hungdiu ahitan, keimanla Pakai henga ngehna kanei louding ahi katin: hijeh-a chu keile kei kachamlouva kakibola, govam thilto kanato ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Samuel'in Saul henga, Nangin ngol hoitah thil nabol ahitai: nangman thupeh nape-a Pakai na Pathen'in nathupeh chu nanit tapoi: ajehchu tuahi Pakaiyin nalenggam chu Israel chunga a-itih-a dinga phudet ding agot ahin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Amavang tun nalenggam hi chejom louding ahitai: ajehchu nangman Pakaiyin nathupeh chu nanit lou jeh-a, Pakaiyin ama lungput tobang pumi akihol ahitai, chule Pakaiyin ama chu amite chunga lamkai dinga athupeh ahitai, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Samuel akipat doh-in Gilgal'a konin Benjamin gam Gibeah'a achetoutai. Chuin Saul'in amatoh umkhom miho chu pasal jagup tobang asimdohtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Saul le achapate Jonathan, chule amanito umkhom miho chu Benjamin gam Gibeah'a chun aumtaove; ahinla Philistine mihon Michmash'a panmun asemun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Philistine te pan mun'a konchun michom dingho chu loithumin ahung potdoh-un: loikhat chun Shual gam Ophrah jotna lampi chu ajotnun;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule loikhat chun Beth-horon jotna lampi ajotnun; chule loikhat chun gamthip Zeboiim phaicham ngatna gamgi chin jotna lampi ajotnun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tun Israel gampumpia chun thihkheng khatcha anaumpon ahi: ajehchu Philistine ten, Achuti loule Hebrew miten chemjam le tengcha kikhen getnunte, atiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Israelte jouse chu amitakip alangkon thih-u, alou kalnao, aheichao, chule atuphenghou khenghem dinga Philistinte henga chesuhji ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Achutijeng vangin amahon tupheng, langkon thih, thihka, heicha, chule gancha hoina thihmol suhhemna aneijun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun chuche ni-a kidouna-a chun ahitin ahi, Saul le Jonathan toh kiloi miho khutna chun chemjam le tengcha khatcha muding aumpon ahi. Ahinla Saul le achapa Jonathan'in vang aneijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Philistine sepaihon ho chu Michmash lampi lama achedoh-un ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun nikhat chu ahitin ahi, Saul chapa Jonathan'in agalvon po-a pang gollhangpa jah-a, Hungin, Philistine sepaihon ho umna apang langkhatna khun gache galkai hite, ati. Ahinla apa henga anahet sahpon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Saul chu Gibeah khopam ningkoi Migron'a um kolbuthei phung noikhatna atouvin ahi. Chule ama umpi mihochu pasal jagup tobang ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Shiloh'a chun Pakai thempu Eli chapa, Phinehas chapa, Ichabod sopipa Ahitub chapa Ahiah chu boitong sangkhol akivonin ahi. Chule mipi chun Jonathan chelam chu ahepouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jonathan'in Philistine te sepaihon ho galkai agotna lampi kikah jetle veija chun songpihem ni aumin, khatpa minchu Bozez ahin, khatjopa min chu Seneh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tomasah pachun Michmash sahlam angan, khatjopa chun Gibeah jotna lhanglam angan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Jonathan'in agalvon po-a pang golhangpa henga, Hungin, hiche cheptanlou sepaihon ho heng lama khun galkai hite: Pakaiyin eini dinga na eitoh pehlhon thei ahi. Ajehchu Pakaiya dingin huhdohna natohna-a hin tam le lhomin ima apopon ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin agalvon popan ajah-a, Nalungsunga umjouse chu bolin: kiheijin; ven, nalungdei banga umdingin keima nakoma kaume, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuphatnin Jonathan'in, Ven miho henga khun galkai hitin, amaho gakimusah hite.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amahon eini henga, Naheng lhona kahung kahseovin umtadi lhonin atiuva ahile, i-umna mun lhona idinden lhonding, ahenguva ichetou louding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla amahon, Kahenguva hungtou lhonin, atiuva ahile ichetou ding ahi: ajehchu Pakaiyin ikhutna amahochu eipehdoh lhon ahitan: hiche hi amelchihna hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin anilhonin Philistine sepaihon ho aga kimusah lhontan ahi. Chuin Philistine ten, Veuvin, Hebrew ho khu akiselnao kohoma konin ahungdoh uve, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin sepaiho chun Jonathan le agalvon popa chu ahin donbutnun, Kahenguva hungtou lhonin, thilkhat vetsah-unge atiuve. Chuin Jonathan'in agalvon popa jah-a, Neihin juitouvin: ajehchu Pakaiyin amahokhu Israelte khutna apehdoh ahitai, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Jonathan'in akhutle akeng tho-a akaltouva ahile, agalvon popan anung ajuitan ahi. Chuin amaho Jonathan masanga chu alhu taovin; anunga agalvon popa chun ahin that peh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jonathan le agalvon popa mitha masatpen hochu mi somni bang ahin, gamneocha bongchal tokhat khoijou theibep acre keh sungbou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin loujauva mipi janel lah leh mipi ho jouselah'a chun tijatna nasatah aumtan; sepaihon ho le thilchomho jong akihotnun: chule ling akihotnin, chutichun tijatna nasatah aumtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Benjamin gama Gibeah'a Saul'in khongah akoiho chun aveovin; chuin veuvin, mihopi chu achat melmulun, khat le khat akiphuto saosaovun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Saul'in aumpi mipi ho jah-a, Tun kisim unlang ilah uva koi potdoh am veuvin, ati. Chuin amahon asimphatnun, veuvin Jonathan le agalvon popa anaum tapoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Saul'in Ahiah jah-a, Pathen thingkhong chu hilama hinpon, ati. Ajehchu hichepetna chu Pathen thingkhong chu Israelte toh uma ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ahitin ahi, Saul'in thempu henga thu aseipet chun, Philistine te janel husa chu ahagincheh cheh jengtan: chuin Saul'in thempupa jah-a, Nakhut ladohtan, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Saul le akoma um mijouse chu akikhom khomun, galmuna chun ahungtaove. Chule veuvin, mitin chemjam chu aloipa chunga achun, chule boina nasatah aumin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chukalvalin chuche masanga Hebrew miho Philistine te toh ana umkhomho, chuche gamkimvela kona agebuh uva amahotoh anachetouho chu, amaho jongchu Israelte toh apangkhomun, Saul le Jonathan to apangkhom taovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chubangma chun Ephraim molsanga anakisel Israel mite jouse chun, Philistine te ajam taove tithu ajah phatnun, amaho jong chun galsat na-a amaho chu hatah in anungdelun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutichun Pakaiyin chuche nikho chun Israel ahuhdoh-in, chule gal kisat chu Beth-aven geijin agalkaijun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hiche nikho chun Israelte chu alung genthei lheh-un ahi: ajehchu Saul'in, Kamelmate phu kalahthei nadin, nilhah ahi kahse-a an ne-a chu sapset changhen, tia mipi chu ahahsel ahi. Chutichun koimachan an kiti atep pouvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin gamsung mi jouse chu gamlah ahunglhung taovin; chule leichunga chun khoiju anaumin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin mipi ho jouse chu gamlah ahunglut phatnun, veuvin, khoiju anakaijin; ahin koiman akhutna alan anepon ahi: ajehchu mipi chun hahselna chu akichatnu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla Jonathan'in apan mipi hahselna-a ahahsel chu anajapon; hijeh chun akhutna achoi molmuh-a chun khoiju lah chu asunlutnin, chuin akhutnin alan akama ahengtan ahile, amitchu hoitah-in ahung hahdoh theitan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuphatnin mipi lah-a khatnin adonbutnin, Napan mipi nasatah-a hahselna-a ahahsela, Tunia an ne-a michu sapset changhen ati ahi, ati. Chutichun mipi alhasam tan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuphatnin Jonathan'in, Kapan gamsunghi agentheisah ahi: Katao ahi, vetemin, hiche khoiju themkhat katep jeh-a kamithi iti hungha doh-a hitam.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mipi jonghin amelmateu thil achom naova amuhouhi aning anopmin nomtah-in neleu phacheh louding ham? hijeh-a chu tugeija Philistine te tamtah itha theilouvu hilouham? ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule hicheni chun Michmash'a pat Aijalon geijin Philistine te chu athat peh-un; chule mipi chu alhasamlheh taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin mipi chu thil kichom chunga achuvin, kelngoiho, bongchalho, bongnouho chu tollhanga athatnun: athisan pumchun anetaovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuphatnin amahon Saul jah-a, Vetan, mipin thisan aneh uva konin Pakai dounan achonse taove, atiuve. Chuin aman, Nanghon nasukhelun; tuni hin songtum lentah neitahkhum taove, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Saul'in, Mipi lah-a kithecheh unlang, ajah uvah, Amitakipmin nabongchalu, nakelngoiju hinkaijun, chule hikoma hin thatnuvin lang neuvin; thisan puma ne-in Pakai dounan chonse hih-un, ati. Chuin chuche jan chun mipi jouse amitakipmin abongchalu chu ahinkaijun, hikoma chun athat taove.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Saul'in Pakai dingin maicham khat asemin; hiche chu Pakai dinga maicham asem masat pentah ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Saul'in, Eihon janlaijin Philistine te nung delsuh-u hitin, jingkhovah kahsen chommu hitin, chule amaho khatcha hinghoi pouhite, ati. Chuin amahon, Nangman phante nati tichu bolin, atiuve. Chuphatnin thempupan, Hilamhin Pathen naitadiu hite, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Saul'in Pathen adongin; Philistine te satna kakonsuh dingham? Nangman amaho chu Israelte khutna napehdoh dingham? ati. Ahinla hiche nikho chun adonbut tapoi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Saul'in, Mipi ho pipui jousen hilam hinai cheh-un: chule tunia hiche chonset hi hoilaija umham heuvin lang vetemun.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ajehchu Israel huhhing-a hingjing Pakai mina kasei ahi, kachapa Jonathan chunga uma hijongle, ama thonlouva thiding ahi, ati. Ahinla mipi ho jouse lah-a konin khatchan adonbut pon ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuphatnin aman Israelte jouse jah-a, Nangho langkhatna umunlang, keile kachapa Jonathan langkhatna kaum lhonding ahi, ati. Chuin mipin Saul jah-a, Nangman phante nati tichu boltan atiuve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hijeh chun Saul'in Israelte Pakai Pathen henga, Vang kisan dihtah hintah langin, ati. Chuin Saul le Jonathan chunga achutan, mipi vang ahoidohtai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Saul'in, Keile kachapa Jonathan kah-a vang san uvin, ati. Chuin Jonathan chunga achutai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuphatnin Saul'in Jonathan jah-a, Ipi nabolham neihilin, ati. Chuin Jonathan'in, Kakhutna um mol leh-a khoiju themcha khat katep ahi, chule ven, kathi teiding ahi, tin ahiltan ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Saul'in, Pathen'in hitichun chule akalvalin jong boljenghen, ajehchu Jonathan, nangma nathi teiding ahi, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin mipi ho chun Saul jah-a, Israelte lah-a huhhingna loupitah bolla Jonathan hi thiding ham? Pathen'in jahda hen: Pakai hingjing mina kaseiju ahi, aluchunga kon samjang khatjon tolla lhalouding ahi; ajehchu tunin aman Pathen toh atongkhomin ahi, atiuve. Chutichun mipin Jonathan chu athilou nadin ahuhdoh taove.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chujouvin Saul chu Philistine te nung adelna-a konin ache toutan; chule Philistine te jong aumnaova achetauve.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuti chun Saul'in Israelte chunga lengvai apon, ningtina amelmate jouse, Moab, Ammon chate, Edom, Zobah lengho, chule Philistine mite to akidouvin: chule akiheina lam tina gal ajoupeh-in ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin aman mipi janel akhomin, Amalek mite asatnin, chule amaho chom gama miho khutna konin Israelte ahuhdoh-in ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tun Saul chapate chu Jonathan, Ishui, chule Melchishua ahiuvin, chule achanu teni minchu hiche ahi; apeng masa nu min Merab ahin, chule aneojonu min Michal ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule Saul inneipi min Ahinoam ahin, Ahimaaz chanu ahi. Chule ajanel gal lamkaipa minchu Abner ahin, Saul pangahpa Ner chapa ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chule Kish chu Saul pa ahin, chule Abner pa Ner chu Abiel chapa ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chule Saul nikholai sungse chun Philistine mite toh kidouna chu anasalheh jengin ahi: chutichun Saul'in mihat le mihangsan amu poupouva ahile, amanin ama-a dingin akipui jengjin ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Samuel'in jong Saul jah-a, Pakaiyin ami Israelte chunga leng dinga nangma thao nudingin einasol ahin, hijeh chun tun Pakai thusei hi ngaijin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Janel Pakaiyin hitin aseije, Amalek'in Israel chunga ana thilbol, Egypt'a kona ahungtouva chu lampia iti ana lamtin ham ti kahe jingin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun chenlang Amalek gasatnin, chule aneijouseu sumanghelin lang, amaho khatcha khenhih-in; pasal le numei agomin, naosen le noicheplai, bong le kelngoi, sangongsang le sanganho abonin thatgamin, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Saul'in mipi ho chu akhom khomin, Telaim mun'a chun keng sepaiho sangjani leh, Judah mi sangsom asimdoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Saul Amalek khopi khatna ahungin, phaichama chun achangpang tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Saul'in Ken miho jah-a, Cheovin, kipatdoh-un, Amelek mite-a kon chun chesuh-un, achuti loule keiman amahotoh kasuh mangtha dingu ahi: ajehchu Egypt'a kona Israelte ahungtouvu chun hepina nana musah-un ahi, ati. Hijeh chun Ken miho chu Amalek miho-a konin apotdoh taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Saul'in Amalek mite chu Havilah'a pat Egypt toh kigalsai Shur lutna geijin anasuhmang pehtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman Amalek mite lengpa Agag chu ahingin amanin, mijouse chu chemjam monghemin asumang sohkeijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin Saul le mipi chun Agag le kelngoi hoipenho, bongchal thao ho, kelngoithao ho le anouhose chu ahing hoijun, ahin aphalou le dei umlou sechu asumang heltan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun Samuel henga Pakai thu ahung lhungin, hitin ati,
  </para>
  <para style="p">
    <verse number="11" style="v" />Saul lenga kanatundoh hi kakisih tai: ajehchu ama eijui na-a konin akileheijin, kathupeh ho atongdoh tapoi, ati. Hichun Samuel alungkham sahtan; jankhovah helin Pakai henga ataotai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Saul kimupi dinga Samuel jingpitah-a athochun, Samuel henga, Saul chu Carmel lhanga ahungin, chule vetan, minkhat akisemin, chule ache lelen, achedoh-in, Gilgal'a achesuhtai, tin aseipeh-uvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Saul henga Samuel ahungin: chule Saul'in ahenga, Pakai phattheiboh chang nahi; keiman Pakai thupeh chu kamolso tai, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Samuel'in, Kanakhanga kelngoi hamgin le bongchal hamgin kajah hi ipi thu hitam? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Saul'in, Amahon Amalek mite-a kona ahinkaiju ahi: ajehchu mipihon kelngoiho le bongchalho aphapenho chu Pakai na Pathen lhaina dinga ahing hoiju ahi; adangse vang kasumanghel taove, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuphatnin Samuel'in Saul henga, Khongaijin, tujana Pakaiyin kahenga ipi anaseijem nahilinge, ati. Chuin aman, Seijin, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Samuel'in, Namitmu-a neocha nahilaija chu Israel phungpi luchanga nakisema, Pakaiyin Israel pumpi chunga leng dinga thao nananu hilouham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Pakaiyin kholjinin nasolin, nahenga, Chenlang michonse Amalek mitekhu gasumangsoh helin, chule abeitheng tokah seuvin amaho chu satnin, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Achutile ibola Pakai awchu ngailouva, thil kichom chunga nachuhjoh-a, chule Pakai mitmu-a thilse nabol ham? ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Saul'in Samuel jah-a, henge, keiman Pakai thusei kanitnin, Pakaiyin eisolna lampia chun kachen, Amalek lengpa Agag chu kahinpuijin, Amalek mite chu kasumang heltai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin mipi hin suhmang heldingsa thilkichom kelngoiho le bongchalho, thil lah-a apha chung nungho chu Gilgal'a Pakai na Pathen henga ganlhaina-a dinga ahin kilah-u ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Samuel'in, Pakaiyin Pakai thusei ngai akipapi banga, govam thilpeh le ganlhainaho akipapi hinam? ven, thuman hi ganlhaina sanga phajo ahin, chule thusei kingaipeh hi kelngoichal thaotah sanga phajo ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ijeh inem itile golkeh hi aisana-a chonsetna toh kibang ahin, louchal kitihi khangitlouna le milim houna toh kibang ahi. Ajehchu nangman Pakai thusei napaidoh tah jeh-in, Aman jong leng nahina-a kona napaidoh ahitai, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Saul'in Samuel henga, Keima kachonse tai: ijeh inem itile Pakai thupeh hole nangma thuho kapalkeh tai. Ajehchu mipi kakichatna, athu-u kanangai ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun, tun, nahenga katao ahi, kachonsetna neingaidamin lang, Pakai chu kahouthei nadingin keima toh kinungle kitnin, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Samuel'in Saul jah-a, Keima nang toh kakinungle kit louding ahi: ajehchu nangman Pakai thu napaidoh ahitan, Pakaiyin Israelte chunga leng nahina-a kona napaidoh ahitai, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Samuel chu chemang dinga akiheija ahile, aman asangkhol chol mong chu amanin, aloi-eh tan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Samuel'in ajah-a, Tunia hi Pakaiyin Israel lenggam chu nanga kona alhetela, nangma sanga phajo naheng nakom khat henga apeh ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chujongle Israel Thahatna chu jou louding, alung jong aheilou ding ahi; ajehchu ama lunghei ding mihem ahipoi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuphatnin aman, Keima kachonse tai: hitajongle katao ahi, kamite upaho masang le Israelte masanga neijabolin lang, Pakai na Pathen chu kahouthei nadingin keima toh kinungle kitnin, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuti chun Samuel chu Saul toh akinunglen, chuin Saul'in Pakai ahou tai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichun Samuel'in, Amalek mite lengpa Agag chu kahenga hinpuijun ati. Chuin Agag chu ahenga ti kithing pumin ahungin ahi. Chule Agag chun, Thina tijat umtah chu chemanga ahitai, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Samuel'in, Nachemjam chun numei ho chabei aso banga, numei lah-a nanujong chabei hiding ahitai, ati. Chuin Samuel'in Gilgal'a Pakai masanga chun Agag chu ahal halin asattel tan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chujouvin Samuel chu Ramah'a achetan; chule Saul jong Saul umna Gibeah ah achetoutan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Samuel chu athi nikho geijin Saul kimupi dingin ahungkit tapoi; ahijeng vangin Samuel chu Saul dingin alunghem jingin ahi. Chule Saul chu Israelte chunga lenga anatun chu Pakai akisih tan ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Samuel jah-a, Israelte chunga alengchana kona kapaidoh henasa itihchan Saul dinga nalunghem dingham? nasaki-a thao sungdim minlang chen, keiman Bethlehem mi Jesse henga kasolding nahi: ajehchu achapate lah-a khu lengchang ding khat keiman gotsa kakoi ahitai, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Samuel'in, Iti kachethei dingham? Saul'in jadoh leh eithading ahi, ati. Chuin Pakaiyin, Bongla khat kaijinlang, Pakai henga ganlhaina neidinga hung kahi, tin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ganlhaina-a chun Jesse kouvin, chule keiman nabolding chu kahilding ahi: chule nahenga kaminphah pachu keima dinga thao nanu ding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Samuel'in Pakai seibang chun abolin, Bethlehem'a ahungtan ahi. Chuin khopi-a upaho chu ahung jehchun atiu akithingin, Chamna-a hunga nahi hinam? atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman, Chamna ahinai: Pakai henga ganlhai bola hunga kahi: nangho kisuthengun lang kahenga ganlhaina-a hungun, ati. Chuin Jesse le achapate chu asuthengin, ganlhaina-a din akoutai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, amaho ahung phatnun, aman Eliab chu aven, Pakai thaonupa chu amasanga umpa hi hiteijinte ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin Pakaiyin Samuel jah-a, Nangman amaiso ahiloule asandan chu vehih-in, ajehchu keiman amachu kadeilou ahi; ijeh inem itile Pakaiyin mihem thilvet banga avet ahipoi; ajehchu mihemin polam melput avet ahin, Pakaiyin vang lungsung avet ahi, atipeh-e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin Jesse'n Abinadad akouvin, Samuel anga asolin ahi. Chuin aman, Hichepa jong Pakaiyin alhengpoi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Jesse'n Shammah asolkitnin ahi. Chuin aman, Hichepa jong Pakaiyin alhengpoi atipeh-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Avelin Jesse'n achapate sagiho chu Samuel anga asolin, ahi. Chuin Samuel'in Jesse jah-a, Hicheho hi Pakaiyin alhengpoi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Samuel'in Jesse jah-a, Hiche mun'a hi nachate jouse umkim sohkeiju vaham? ati. Chuin aman, Aneopenpa avat nalaije, chule ven ama kelngoi ching ahi, ati. Chuin Samuel'in Jesse jah-a, Gakousah-in; ajehchu ama hikoma ahunglhun masangse-a eiho itou loudiu ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman agakou sah-in, ahinpui taove. Tun amachu tahsa phatah, mitha hoitah, chule vetnom umtah ahi. Chuin Pakaiyin, Kipatdoh-in, thao nutan; ajehchu hichehi amapa chu ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichun Samuel'in saki-a thaochu alan, asopite lah-a amachu thao anutai. Chuin chuche nikho-a patnin Pakai lhagao David chunga achutai. Hitichun Samuel akipatdoh-in, Ramah'a achetai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla Pakai lhagao chu Saul'a konin achemang tan, chule Pakaiya kon lhagao gilou khatnin asugimtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Saul sohten ahenga, Ven, tuahi Pathen'a kon lhagao gilou khatnin nasuhgim ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun ka-pakaiyun namasanga um nasohte hin semjang saithem mikhat agahol nadiuvin thupeh neijin; chule hung hitiding ahi, Pathen'a kon lhagao gilou chu nachunga ahung umteng, aman semjang asai ding, chutengle nangma naphat jiding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Saul'in asohte jah-a, Tun asai themtah mikhat neipeuvin, amachu kahenga hinpuijun, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin sohte lah-a khatnin adonbutnin, Ven, Bethlehem mi Jesse chapa semjang saithemtah, gal hat mihangsan, galbolmi, ijakaija hekhen themtah, chule melhoitah, Pakaiyin aumpi khat kamui, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Saul'in Jesse henga thupole ho solin, ahenga, Kelngoiho toh umkhom nachapa David chu neihinsol peh-in, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jesse'n changlhah toh lengpitwi haikhat, chule kelnou khat sangan apohsah-in, achapa David khutna Saul athot tai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin David Saul henga ahungin, amasanga adingtai: chule aman nasatah-in alungsetnin, agalvonpon ahung pangtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Saul'in Jesse henga, Katao ahi, David hi kamasanga dingjing hen; ajehchu ama kamitmun lungsetna achange, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ahitin ahi, Pathen'a kon lhagao gilou chu Saul chunga aumtengle, David'in semjang alan, akhutna asaijin ahi: hitichun Saul chu alimdohjin, aphajitan, chule lhagao gilou chun adalhaji tan ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Judah gam Shochoh mun'a chun Philistine galsat ho chu galbol din akikhomun, chule Ephes-damim'a um Shochoh le Azekah kikah-ah ponbuh asongun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Saul le Israelte jong akikhom khomun, Elah phaicham panga aponbuh-u asongun, Philistine te douna-a galsatdin akigongtoh taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Philistine te chu molpang langkhatna adingun, chule Israelte chu molpang khatlama adingun ahi. Chule akah uva chun phaicham khat aume.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Philistine te gebuh-a konin Gath khomi amin Goliath kiti mihat tah khat, tong gup le khap khatna sang ahungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule aman aluchunga sum-eng lukhuh akhuh-in, thih sangkhol aki-ah-in, asangkhol gihdan chu sum-eng shekel sanga agih ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Akengteni sum-eng ngaltomin akitomin, chule alengkou teni kikah-a sum-eng tengcha aumin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule atenglung chu ponkhong ho talhang abangin, atengpeh gih chu thih shekel jagup ahi: chule mikhatnin apho apon amasanga achen ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ama adingin Israel galsat miho jah-a chun asamin, Ipi dinga galsat dinga hung kigola nahiuvem? keima Philistine kahi, nangho Saul sohte nahiu hilouham? nanghodin mikhat lheng unlang, amachu kahenga hungsuh hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman eihung kisatpi jouva, eitha-a ahile, keiho nasoh-u hiuvingting; ahinla ken kajo-a, amachu katha-a ahile nangho kasoh nahiuva, neijen dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Philistine mipa chun, Tunia hi Israel galsat miho kataitom nahiuve; kaki satpi dingin, mi khat neipeuvin, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Saul le Israel mijousen Philistine mipa thusei chu ajah phatnun, alungu alhan, akichalheh jengun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun David chu Judah gam Bethlehem'a Ephrath mi Jesse chapa ahi; amapan chapa get aneijin, chule ama Saul nikholaija chun tehsetah ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Jesse chapa lenpen thumho chu acheuvin galmuna chun Saul ajuijun ahi. Chule achapa thum galmuna cheho minchu, achapa lenpen Eliab, abanna Abinadad, athumna Shammah ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule David chu alhumpen ahin, chule alenpen thumin Saul ajuiju ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla David chu achen Saul'a konin apa kelngoi ching dingin Bethlehem'a ahung kile kit tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Philistine mipa chun jingkah nilhah-in ahin naijin, nisomli sungin ahung kilah jingin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jesse'in achapa David jah-a, Tun na-ute dingin changkanpoh ephah khatle changlhah lhon somkhat choi jinlang, na-ute gebuh lama lhaijin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiche bongnoiha somkhat hi sangkhat chunga gal lamkaipa pohpeh-in, chule nasopite iti umuvem gavenlang thu hinle poh-in, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tun Saul le Israel mite jouse chu Elah phaichama Philistine tetoh kisatdinga uma ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin David chu jingkah matah-in athouvin, kelngoiho chu achingtup ding khattoh adalhan, Jesse'n athupeh bangchun thilho chu apon achetai. Chuin janelho galkula kon galsat dinga akijotdoh uva, galsat dinga a-ao laitah-un, ngahphol chu agalhungtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu Israelte le Philistine te chu galsat mi le galsat mi kisatto din akigol cheh taove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin David'in thil chingtuppa henga athilpohho chu adalhan, galsat miho lah-a alhailutnin, a-ute chu chibai agabohtai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amahotoh akihou laijin, veuvin, Gath mi Philistine mihatpa, amin Goliath kitipa chu Philistine galsat mihon lah-a konin ahungdoh-in, athusei ngaibang chun ahinsei kitnin ahile, hichu David'in ajatai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Israel mite jousen mipa chu amuphatnun, ama-a konchun ajamun, hatah-in akichao vin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Israel miho chun, Ahungdoh mipa khu namuvem? Israelte sujum ding mongmonga hungdoh-a ahi; chule hiti ding ahi, ama that penpen chu lengpan haona nasatah-a ahaosah ding, chule amachu achanu jong apeh-a, apate insung chu Israel lah-a a-onthol sah ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin David'in akoma dingho jah-a chun, hiche Philistine mipa thatna, Israel te-a kona minsetna lamangpa chu i-kilo dingham? ajehchu hiche cheptanlou Philistine mipa hi hoi koi hija, Pathen hing galsat miho hi ajumso ham? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin mihochun hitihin adonbutnun, Amapa that penpen chunga chu, akisei bang banga kibolding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin a-upa alenpen Eliab'in miho toh akihoulim chu ajan; David chunga chun Eliab lunghanna chu akoujah jengtan, ajah-a, Ibola hikoma hungsuh nahim? chule kelngoi lhomcha khat chu gamthipma koi nahin chin sah ham? naki letsah na le naphatlou kahei; ajehchu kidouna munoma hungsuh nahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin David'in tu-a hi ipi kabol em? ajeh uma hilouham? ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ama-a konin adangho lama akiheijin, chutobangma chun aseijin ahi: chuin mipin amachu amasa bangma chun adonbutnun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin David thusei ho ajah phatnun, Saul henga aga hetsah taovin ahile, aman akouding ahinsol tai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin David'in Saul jah-a, Ama jehkhun koimacha lunglha hihhel hen, nasohhi kache-a hiche Philistine mipa tokhun kaga kisat ding ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Saul'in David jah-a, Hiche Philistine mipa kidoupi dingkhun chethei pon nate: ajehchu nangma khangdong chabou nahin, amakhu aneova patna galbolmi hung hija ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin David'in Saul jah-a, Nasohhin apa kelngoi ana chingin, hia chun keipi bahkai le vompi ahunga kelngoihon lah-a konin kelngoi nouho ahunglhoh jiteng;
  </para>
  <para style="p">
    <verse number="35" style="v" />Anung kadel jin, kakidel pin, akama konin kaloidoh-in kahuh dohjin ahi: chule keima thatdinga ahung kipatdoh-a ahile, akhamula kamanin, kajepmin, kathatjitai, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nasoh hin keipi bahkai le vompi ani-in kathatnin ahi: chule hiche cheptanlou Philistine mipa hi Pathen hing galsat mite ajumso kimu ahin, hiteho khat tobang chu hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />David'in aseiben, Pakaiyin keipi khophanga konle vompi khophanga kona eina huhdoh ahin, aman hiche Philistine mipa khutna kona jong eihuhdoh ding ati. Chuin Saul'in David henga, Chen, Pakaiyin naumpi hen, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Saul'in agalvon chu David avonpeh'in, aluchanga chun sum-eng lukhuh akhuhpeh-in, thih sangkhol a-ah peh-in ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin David'in achemjam chu agalvon chunga akojin, cheding agon ahi; ajehchu hichu anapatep khahlou ahi. Chuin David'in Saul jah-a, Hicheho pumin chethei ponge, ajehchu hichehohi kamangkhapoi, ati. Chuti chun David'in asutlha gamtai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin atenggol akhutna achoijin, vachadunga konin songchang jolsel changnga alhengin, akelngoi chinna sakhao neo sunga akhumin; akhutna ahsongse achoijin, Philistine mipa chu anailut tan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Philistine mipa ahungin, David chu ahin naipheijin; chule apho popa chu amasanga achen ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule Philistine mipan avetle David amuphatnin, amachu anoiselheh-in ahi: ajehchu ama khangdong ahin, tahsa phatah le maiso hoitah ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Philistine mipan David jah-a, Keima uicha kahia kahenga tenggol toh nahungham? ati. Chuin Philistine mipa chun a-pathenhou min panin David chu agaosaptai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Philistine mipan David jah-a, Kahenga hungin, keiman naphe chu chunga leng vachate le gamlah-a gamsaho kapeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin David'in Philistine mipa jah-a, Nangma kahenga chemjam le tengcha chule lum tho-a nahung ahin, hinlah keima vang nangin nataitom Israel galsat mite Pathen, janel Pakai mina chu hunga kahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tunia hi Pakaiyin nangma kakhutna eipehdoh ding; chule nangma katha-a, nalu kalahding; chule leiset pumpin Israelte lah-a Pathen aumme ti ahetna diuva, Philistine sepai janel longchu tunia hi chunga leng vachate le leija gamsaho kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule hichea kikhom jousehin Pakaiyin chemjam le tengchan ahuhhing poi ti ahetdiu ahi; ajehchu galsat hi Pakaiya ahin, aman nangho kakhut uva eipehlut diu ahitai, ati.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin ahung hitin ahi, Philistine mipa ahung kipatdoh-a, David henglam ahin nai phatnin, kintah-in David chu Philistine galsat miho toh kisuto dingin alhaitan ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin David'in akhutnin sakhao sung asoh-in, chua konchun songchang khat alan, ahsongse-a chu asea ahile, Philistine mipa chalpanga achun, songchang chu achalpanga alutnin; chuin ama amaijin tolla alhutai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuti chun David'in Philistine mipa chu ahsongse le songchang khatnin ajouvin, Philistine mipa chu asepmin, athattai; ahinla David khutna chun chemjam aumpon ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hitichun David alhaijin, Philistine mipa chunga adingin, achemjam chu alan, apaija konchun asatdoh in, athatnin, hia chun alu atanbongtai. Chuin Philistine ten amihatpao athi chu amuphatnun ajamtaovin ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin Israelte le Judah miho akipatnun, hatah in a-aovun, phaicham le Ekron kotpi aphah kahseovin Philistine te chu anung delun ahi. Chule Philistine mipi ho chu Shaaraim lampi dunga, Gath le Ekron changeijin alhuchap jengun ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin Israel chate chu Philistine te anungdel uva konin ahung kileuvin, aponbuh houchu asumang taove.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ahin David'in Philistine mipa luchang chu alan, Jerusalem'a ahinpotai; ahin agalvon vang apon in'a akoijin ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin Saul'in David Philistine mipa satdinga achedoh amuchun, janel gallamkai Abner jah-a, Abner hiche gollhangpa hi koicha ham? ati. Chuin Abner'in, Vo lengpa, nahinna hingjeng hen, kasei theipoi, ati.
  </para>
  <para style="p">
    <verse number="56" style="v" />Chuin lengpan, Khangdongpa chu koicha ham? hinkhol toh-in, ati.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin David chu Philistine mipa atha-a kona ahung kile phatnin, Abner'in apuijin, akhutna Philistine mipa luchang pumin Saul masanga ahin puilut tai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Chuin Saul'in ajah-a, Gollhang nangma koipen cha nahim? ati. Chuin David'in adonbutnin, Keima Bethlehem mi nasoh Jesse chapa kahi, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Saul henga athusei achai phatnin, Jonathan hinna chu David hinna toh akijopmat tan, chule Jonathan'in David chu ama hinna bang bangin angailutan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin hicheni chun Saul'in ama akipuijin, chule a-in lam apa in'a achesah nom tapoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chujouvin Jonathan le David'in kitepna aneilhone; ajehchu aman ama hinna bangin amachu angailun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jonathan'in achunga kai asangkhol len chu asutlhan, avonho, achemjam le athalpi, chule akongah sannin David apetan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Saul'in asolnalam lama David achedohjin, chule chingthei tah-in aumin ahi: chule Saul'in ama chu galbolho chunga lamkaijin atungin, ama chu mijouse mitmu le Saul sohte mitmun deisahna achangin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, David'in Philistine mipa atha-a, atha naova kona ahungkileu chun, Israelte khopiho jouse-a konin numei ho lasa le lam pumin, khongcha le thil gingtheiho thon thanom tah-in Saul lamto dingin ahungpot doh-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin numei hon la asaovin, Saul'in asang asang athatnin, David'in sangsom sangja athatne, tin khatle khat akidonbutnun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Saul alung ahanglheh-in, akisei chun alung phatmosah lheh-in; aman, David'in sangsom athan aseijun, chule keiman sangkhat kathan bou aseijuve: lenggam tailou adang ipi alahbe ding umtam? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Saul'in chuche ni-a pat akalse chu David chu amit thiptan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, ajingin Pathen'a kona lhagao gilou chu Saul chungah ahungchun, insunga chun gaothu aseijin: phatdanga bangin David'in akhutnin semjang asaijin; chule Saul khutna chun tengcha khat aumin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Saul'in tengcha chun akhon ahi; ajehchu aman, David chu tengchan bangtoh khobeh inge, ati ahi, chuin David ama-a konin nivei ahoidoh-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Saul'in David chu akichatan ahi, ajehchu Pakaiyin ama aumpin, Saul chu adalha tai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun Saul'in ama-a konin asoldoh-in, sangkhat chunga gal lamkaijin apansah-in; chule ama mipi masanga chun alutle apotlejin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin David alampi jouse-a chingthei tah-in aumin; chule Pakaiyin aumpin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun Saul'in ama chingtheitah-a aum amuphatnin, amachu akichatan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Israelte jouse le Judah ten David chu a-angsung uva alutle apotle jeh-in angailuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Saul'in David jah-a, Ven, kachanu lenjonu Merab hi najidinga kapeh ding nahi: keidin hangtah-in pang poupouvin lang, Pakai galchu satnin, ati. Ajehchu Saul'in, Kakhut hi achunga chuhda hen, amavang Philistine te khut joh chu achunga chuhen, ati ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin David'in Saul jah-a, Keima hi koi kahiham? chule kahinkho ipi hija, Israel insunga kapa insung ipi hija, lengpa tupa kahiding ham? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla Saul chanu Merab chu David akipeh ding phatchun ahitin ahi, Meholath mi Adriel jidin amanu akipetan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Saul chanu Michal'in David adeichan; chule Saul jah-ah aseipeh-un ahile ama akipah lheh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Saul'in, Amanu hi amapa dinga thang ahitheina dingle, Philistine te khut achunga achuhthei nadin, amanu chu David penge, ati. Hijeh chun Saul'in David jah-a, Tunia katupa nahi ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Saul'in asohte thu apen, ajah uva, David toh guhthim chan kihou unlang, ahenga, Ven, lengpan nachunga kipana aneijin, asohte jousen nangailui: hijeh chun tun lengpa tupa hitan tiuvin, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Saul sohten thuho chu David jah-a aseijun ahi. Chuin David'in, Kei migenthei le mi nahsahmo kahi nahena saova, lengpa tupa hidingchu thil bailama nagelu ham? ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Saul sohten ajah-a, David'in hitin aseije tin aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Saul'in, Hitia hi David henga nasei dingu ahi, lengpan amelmate phu lahna dinga Philistine chep jakhat tailou numei man imacha angehpoi tin seijun, ati. Ahinla Saul'in David chu Philistine te khutna thisah agot ahibouve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin asohten hichethu chu David aseipeh phatnun, lengpa tupa hiding chu David akipah-in; nikhoho chu akichai hihlaije.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin David akipatdoh-in, amale amite acheuvin, Philistine miho jani agathatnun: David'in achepmu ahinpon, lengpa tupa ahithei nadin, lhingkeijin lengpa apetaove. Chuin Saul'in ajidin achanu Michal apetai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Saul'in Pakaiyin David aumpi chu ahetan, chule Saul chanu Michal'in amachu angailun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Saul'in David chu akicha cheh tan: Saul chu David melma ahijom jingtan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chujouvin Philistine pipuiho apotdoh-un: chuin ahitin ahi, amaho potdoh nungun, David chu Saul sohte jouse sangin chingthei cheh-in aumtan; chutichun aminchu nasatah-in akithangin ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Saul'in achapa Jonathan le asohte jouse David that dingin ahoulimpi tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla Saul chapa Jonathan'in David chu angailu lheh-in: chule Jonathan'in David henga, Kapa Saul'in thadingin nahole: hijeh chun tun, katao ahi, jingkah ahikahsen kichihtheijin, munthipma uminlang kiselin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keima kachesuh-a naumna loujaova chun kapa koma kadina, nangma chungchang thu kaseiding; chule kamudoh chanchu nangma kaseipeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jonathan'in apa Saul henga David chu aseiphan, ahenga hitin aseije, Lengpan asohpa David dounan chonset boldahen; ajehchu nang dounan achonsepon, chule athilbol jouse chu nang dinga phatna ngen ahi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu aman ahinkho akhutna akichoi tho-a, Philistine mipa anatha-a, Pakaiyin Israelte jouse dinga huhhingna loupitah anabol ahi: chuti ahile ajeh beija David chu natha-a, monabei thisan douna-a nachonset ding ham? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Saul'in Jonathan thusei angaijin: chule Saul akihahselin, Hingjing Pakai min pana kasei ahi, ama kithat louding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jonathan'in David akouvin, chule Jonathan'in thu jouse chu ahiltan ahi. Chule Jonathan'in David chu Saul henga apuijin, masanglaija bangin a-angsunga aumkit tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin gal aumkit tan: David akondoh-in Philistine tetoh akisatnin, amaho nasatah-in athatnin; chuin amaho ama-a konin ajamtaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin a-insunga auma, akhutna teng akichoi petnin, Pakaiya kon lhagao gilou chu Saul chunga achutan; chule David'in akhutnin semjang asaijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Saul'in David chu bangtoh khobeh-a thading agon; ahinla ama Saul umna-a konin ajamdoh-in, ateng chun bang akhochang jengin ahi. Chuin David ajamin, hiche janchun ajamdoh tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Saul'in David inlama jingkah-a anachanga thatdingin sottol leho asolin ahi: chuin David inneipi Michal'in ahenga, Tujanna nahinna nakihuh doh louva ahile, jingle nakithat ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun Michal'in David chu bangkotna akhailhan: ama achen, ajamin, ahoidohtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Michal'in milim khat alan, jalkhuna chun alupsah-in, aluchang dingin kelcha mul akoijin, hichu ponnin akhun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Saul'in David kouding thangkou asolphatnin, amanun, Adampoi atin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Saul'in David vedin sottol hochu asolkitnin, ajah uva, Katha theinadin, ajalkhun pumin kahenga hindom touvun, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin sottol ho ahunglut phatnun, veuvin, jalkhuna chun aluchang dinga kelcha mul kikoi milim khat analumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Saul'in Michal henga, Ibola hitia hi neijou lhepma, kamelma pa chu ahoidoh nadinga nasoldoh ham? ati. Chuin Michal'in Saul adonbutnin, Aman kahengah, Neiche sah-in; ibola kathading nahim? atin ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin David chu ajamin, ahoidohtan, Ramah'a Samuel koma ahungin, Saul thilbol jouse chu ahiltai. Chuin amale Samuel ache lhonin, Naioth'a acheng lhontai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin hichu Saul ahilun, Ven, Ramah gamsung Naioth'a David aume, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Saul'in David mandin sottol leho asolin: chuin amahon themgao honkhat gaothu aseijuva, chule achunguva Samuel lamkaija ana ding amuphatnun, Saul sottol leho chunga chun Pathen lhagao ahung chun, amahon jong gaothu asei taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin hichu Saul aseipeh phatnun, sottol dangho asolkitnin ahile, amahon jong chutima chun gaothu aseikit taove. Chuin Saul'in athumveina-a sottol leho asolkitnin ahileh, amahon jong gaothu aseiden kit taove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichun amajong Ramah'a ahungin, Sechu'a um twikul lentah phung ahung lhungin, Samuel le David hoija umlhonnam? tin adongin ahi. Chuin mikhatnin, Vetan, Ramah gam Naioth mun'a aum lhone, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ama Ramah gam Naioth'a achen ahile, Pathen lhagao chu ama chunga jong achutan, Ramah gam Naioth alhun kahsen ache pumin gaothu aseipeh tan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aponjong ahohlhan, Samuel angsunga chun hitichun gaothu aseijin, chuche nikho nilhum le jankhovah-in asagoh-in alumin ahi. Hijeh chun amahon, Saul jong themgaoho lah-a panga hitam? atiuve.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David chu Ramah gam Naioth'a konin ajamin, Jonathan henga ahungin, ajah-a, Ipi kabol am? kakhan gitlouna ipi umam? chule napa anga kachonsetna ipi uma thadinga kahinkho hi aholham? ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman ajah-a, Nathi ding chu Pathen'in jahda hen: ven kapan keima hetsah louvin, thil len hihen, thilneo hijongle bolponte. Achutile ipi dinga kapan hicheho chu kakoma a-im dingham? Chutiponte, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David akihahsel kitleuvin, Namitmu-a lungsetna kachanhi napan chentah-in ahen; Jonathan'in hichehi hetda maihen, atiloule lungna getninte ati hinte. Ahinla hingjing Pakai le nangma mina pana kasei ahi, keima le thina kikah-a hi kalkhat sehbou uma ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun Jonathan'in David jah-a, Ipi hijongle nahinnan angaichat chanchu, nanga dinga kabolpeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David'in Jonathan jah-a, Ven jingkhu lhathah ni ahin, lengpa toh ankonga thonlouva katoukhom tei ngai ahi; ahinla anithum ni nilhah geija gamlah-a kaga kisel theinadin neisolin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Napan eiholmona aumhela ahile, David'in akhopi Bethlehem'a gache vahdin kakoma phalna khohtah-in athumin ahi: ajehchu insung pumpi-a dinga kumtin ganlhai chukoma aneiju ahi, tin seijin ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitia chu aman, Aphai atia ahile, nasohhi lungmona kanei ding; amavang hatah-a alung hana ahileh, thilse angaitoi ti hejengin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu nasoh chunga hi hepina neitah-a na natoh ding ahi; ajehchu nasohhi Pakaiya kitepna naneipi ahitai. Hijeng jongle keima-a khangitlouna aumle, nangmatah in neithat jengin; ipi khoh-a napa henga neipui dingham? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jonathan'in, Hichu nanga konin gamlahen: ajehchu kapan nachunga thilse bol agot kahet monga ahile, kahil louding ham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuphatnin David'in Jonathan jah-a, Napan setah-in nadonbut tale, kon eihunghil dingham? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jonathan'in David jah-a, Hungin, loujaova chehite, ati. Chuin amani loujao lama achedoh lhontan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jonathan'in David jah-a, Pakai Israel Pathen chu ahetoh ahi! jing nikho, ahiloule nithum nikho hama kapa kadoh teng, David dinga apha ahia, chuteng nahenga mi kasol louva kahetsah louva ahile,
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakaiyin chutobang chun, chule akhohjo cheh-in Jonathan chunga boljenghen: ahinla nangma bolset dingchu kapa lunglhaina ahia ahile, lhamonga nachethei nadin nahetsah ingting, nasolmang nange. Chule kapa ana umpi bangchun Pakaiyin nangma naumpi hen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule kathilouna dinga kahinlai jenga Pakai phatna neimusah ding hilouvin;
  </para>
  <para style="p">
    <verse number="15" style="v" />A-itih-a dinga ka-insunga kona naphatna nasat tanhel louding ahi. Pakaiyin David melmate aboncha leiset chunga asuhmanghel nung jongle sattanhih helin, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun Jonathan'in David insung toh kitepna asemin, Pakaiyin David melmate chunga phu lahen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jonathan'in angailut jeh-in, David chu akihahsel sah kitnin ahi. Ajehchu aman ama hinna angailut bang banga angailut ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichun Jonathan'in David jah-a, Jing nikho khu lhathah ni ahin; natouna a-on ding jeh-a nakiholmo ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nithum naum nungteng, nachesuh loija thukhoh aumtengle nakisel jina mun mama-a chu nahung ding, Ezel song panga chu na-umden ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule keiman doikhat neibanga thalchang thum hiche panga chu kahinkap ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ven, chapang khat kahinsol ding, Chenlang thalchang ho khu gaholdoh-in, katiding ahi. Chule chapang henga chu, Ven, thalchang ho chu nasih hilam panga aume, hinlan kati-a ahile, hung jengin. Ajehchu Pakai hingjing mina kasei ahi, nangma dingin lungmona aumin, setna aumpoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla gollhangpa jah-a chu, Ven, thalchang ho chu nakhel lama aume, kati-a ahile; nalampi-a che jengin: ajehchu Pakaiyin nasolmang ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nang le kei kikah-a iseidohho jouse chunga chun, ven, Pakai chu nang le kei kikah-a a-itih-in umjing hen, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuti chun David amale ama gamlah-a akiselin: chuin lhathah nikho ahunglhun phatnin, lengpa chu an nedin atou lhatan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin lengpa phat dangho bangin atouna chunga atouvin, bangpanga touna-a chun atouve: chuin Jonathan akipatdoh-in, chule Abner chu Saul panga atouvin, David munchu a-ongtan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahivangin Saul'in hicheni chun imacha aseipoi: ajeh chu aman, Achunga thilkhat tou soh-a thenglou hinte; thonlouva ama thenglou hinte, tia angaito ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ajingin ahitin ahi, hichu chuche lha nini channi ahin, David munchu a-ongkit tai. Chuin Saul'in achapa Jonathan jah-a, Jesse chapa chu janhi-a jong, tunia jong ibola hunglou ham? ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Jonathan'in Saul adonbutnin, David'in Bethlehem'a chenadin hatah-in kakoma phalna athumin:
  </para>
  <para style="p">
    <verse number="29" style="v" />Katao ahi, neiche sah-in: ajehchu ka insung miten khopi sunga ganlhaina kaneidiu ahin; chule kasopipan chua umdin eithupeh-in ahi: chule tun, namitmu-a lungsetna kachana ahile, katao ahi, neichesah inlang kasopite gamunge, atin ahi. Hijeh-a chu lengpa dokhanga hunglou ahi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuphatnin Jonathan chunga Saul lunghana chu akoujah tan, ajah-a, Nang numei vahvei le golkeh chapa, nangman nangmatah jachat nadingle nanu sagohkeu jachatsah nadinga Jesse chapa chu nalhen ahi kahetlouva nabolham?
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu Jesse chapa leiset chunga ahinlaisea nangma le nalenggam kiphutdet louding ahi. Hijeh chun tun kahenga din mi gakousah-in, ajehchu ama thiteiding ahi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Jonathan'in apa Saul adonbutnin, ajah-a, Ipi dinga ama kithat dingham? aman ipi abolem? ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Saul'in thadingin teng khatnin akhon ahi. Hichea konchun Jonathan'in apan David thading agotmong ahichu ahetai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hitichun Jonathan chu dokhanga konchun lunghang tah-in akipatdoh-in, chuche lha anini nichun an anetapoi. Ajehchu apan ajachatsah behseh jehchun, David chu alungkhampin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Jingkah-in ahitin ahi, David toh akitep phat tah chun Jonathan chu chapang khat toh apotdoh-in, loujaova chun achetai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin aman achapangpa jah-a, Lhaijinlang kathalchang kap ho chu gaholdoh-in atin. Chuin chapangpa chu alhai tolhonin, thalchang khat akal lama chun agah kapmin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin chapangpa chun Jonathan'in akapdoh thalchang phung aphah phatnin, Jonathan'in chapangpa jah-a, Thalchang chu nakal peh-a uma hilouham? tin asame.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Jonathan'in chapang chu asamin, Kikinnon, gangin, umden hih-in, ati. Chuin Jonathan chapangpa chun thalchang ho chu achom khomin, apu henga ahungtai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahin chapang pa chun imacha ahepon: Jonathan le David'in bou thil kibolchu ahelhone.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Jonathan'in amanchahho chapangpa apen, ajah-a, Chenlang khopi-a anapo lutan, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin chapangpa achedoh doh-in, David lhanglama munkhatna konin ahung kipatdoh-in, amai tolla asulutnin, thumvei akunin ahi. Chuin khatle khat akichopto lhonin, David'in alhakang kahse chun hatah-in akika lhontan ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Jonathan'in David henga, Lung mongin chetan, ajehchu ini-a Pakai mina ikihahsela, Pakai chu kei le nang kah-a, chule kei chilhahle nang chilhah ho kah-a a-itih-in ahetoh hijing tahen tia inasei ahitai, ati. Chuin ama akipatdoh-in achetai. Chule Jonathan jong khopi sunga alut tan ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin David Ahimelech thempu henga Nob'a ahungin ahi. Chule David to akimuto chu Ahimelech akichan, ajah-a, Ipidinga nachangseh nahi hija, koimatoh kilhonlou nahim? ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David'in Ahimelech thempu jah-a, Lengpan kinkhatna eisola, kajah-a, Keiman kasolna thudol le kathupeh hi koimacha hetsah hih-in, ati ahi. Chule keiman kasohte hilai khulai mun'a chu kasol ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun tun nakhutna ipi umam? kakhutna changlhah nga ahiloule nakoma um umchu neipen, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin thempu pan David adonbutnin, Kakhutna changlhah lham aumpon, changlhah thengbou aume; gollhangho chu numeija kon beh-a akichintup uva ahile, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David'in thempu pa chu adonbutnin, ajah-a, Atahbeh-in kahunga pat nithum tobang keiho-a kona numei ho kichomkoi ahin, chule gollhangho belho hi athenga ahi, chule changlhah chu tunia belsunga kisutheng hijongle, gelkhatna alham ahi ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun thempupan changlhah theng chu apetai; ajehchu khat akilahdoh tengle changlhah sapeh akhela koidinga Pakai angsunga kona kiladoh vetsahna changlhah tailou changlhah ding umlou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun hicheni chun Saul sohte khat hia chun Pakai anga anakihenin; aminchu Doeg ahin, Edom mi Saul ganchingho lah-a apipuipen ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin David'in Ahimelech henga, Nakhutna tengcha ahiloule chemjam umlou ham? ajehchu lengpa thuchu thukin ahijeh-in kachemjam le kagal manchah kahin poman tapoi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin thempu pan, Ven, Elah phaichama natha Philistine mipa Goliath chemjam chu hia thempu sangkhol nunga ponin akijelin aume: nadeile hichu kilah-in; ajehchu hiche tailou chu adang aumpoi, ati. Chuin David'in, Chekal lhah chu umding ham; neipe jengin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin David akipatdoh-in, hicheni chun Saul ginna in ajamin, Gath lengpa Achish henga chetai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Achish sohten ajah-a, Hichehi chuche gam lengpa David hilouham? Mihon achung changa lampuma khat le khat kidonbut to-a la asah uva, Saul'in sangkhat athatnin, David'in sangsom athatne, atiuchu hilouham? atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Davidn'in thuhochu alungsunga aching pai jengin, Gath lengpa Achish chu akicha lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun amasanguva achondan khelin, amitnuva chun akingolsah-in, kotpi kotkhah ho ajihpol letlut in, akhamul achun achilche akaisah dehduh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin Achish'in asohte jah-a, Veuvin, mingol ahi henasa ibola kahenga nahin pui uham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Mingol kangaichat hija, ka-angsunga angolna-a kichem dinga hitobang mihi nahin pui uham? Hitobang miho ka-insunga hunglut diham? ati.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun chua konchun David apotdoh-in, Adullam songkoa akiselin; asopitele apa insung mijousen ajah phatnun ahenga achesuh-un ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin alung genthei jouse, leiba neijouse, chule lunglhailouna neijouse ahenga ahung kikhomun; amaho chunga chun ama gal lamkaijin apangin: chule ama toh umkhoma chu mi jali tobang ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David chua konin Moab gam Mizpeh'a achetan: chule Moab lengpa jah-a, Pathen'in kachunga ipi abolding ahi kahet masangsen, nahenga katao ahi, kanule kapa aumna-a hung dohhen lang nangma toh umkhom hen, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman amani Moab lengpa anga apuijin; chule David songkoa aumlaisen amato acheng khomun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Gad themgaovin David henga, songko sunga chun umden hih-in; potdoh-in, Judah gamsunga chen, ati. Chuin David apotdoh-in, Hareth gammanga alut tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Saul'in David le aumpi miho chu akimu dohtai ti ajah phatnin, (tun Saul chu Gibeah gam Ramah kho-a thingphung khat noija aumin, akhutna tengcha akichoijin, akimvela asohte jouse adingun ahi;)
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Saul'in avella ding asohte jah-a chun, Tun nangho Benjamin miten ngaijun; Jesse chapa chun nangho amitakip lou le lengpi honho napeh cheh uva, sangkhat chunga gallamkai le jakhat chunga gal lamkaija napansah cheh dingu hija;
  </para>
  <para style="p">
    <verse number="8" style="v" />Nabon uva keima douna galguh nabol uva, chule kachapan Jesse chapa toh kitepna anei lam eihetsah-a khatcha naum daova, keima dinga lungkham khatcha naum daova, chule tunia banga hi kachapan kasohpa keima douna-a eichanglhi dinga atildoh jonghi eihila koima umlou nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Saul sohte chunga lamkaija kitung Edom mi Doeg chun adonbutnin, Nob'a Ahitub chapa Ahimelech henga Jesse chapa ahung kamui.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule aman amadin Pakai adohpeh-in, nehding ho apen, chule Philistine mipa Goliath chemjam jong apei, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin aman Ahitub chapa Ahimelech thempupa le apa insungmi Nob'a um thempuho jouse koudin mi asolin ahi. Chuin amaho abonun lengpa henga ahunguvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Saul'in, Tun nangma Ahitub chapa, ngaijin, ati. Chuin aman, Ka pakai hikoma kaume, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Saul'in ajah-a, Tunia banga hi nangma le Jesse chapan ibola keima douna-a galguh nabol lhona, keima douna-a kipatna eichanglhi dinga nangman amachu changlhah le chemjam napeh-a, Pakai nadoh peh ham? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Ahimelech'in lengpa chu adonbutnin, Lengpa tupa hija, nasolna chana chea, na-insunga ja-umtah David tobanghi nasohte jouse lah-a koi umam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Achutile ama dinga Pathen dohpeh chu kakipatbep ham? hichu keija konin gamlahen: lengpan nasohpa hi le kapa insung mite jousehi imachan mo neichan hihbeh-un; ajehchu hicheho jouse thudol hi nasohpan alhom hihen atam hileh imacha kahepoi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin lengpan, Ahimelech nangma le napa insung mite jouse nathi teidingu ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin lengpan akoma ding keng sepaiho henga, Kiheijun lang Pakai thempuho chu David toh akikhut jop jeh ule, amahon ajampet ahetnuva keima eihetsahlou jeh-un thatnun, ati. Ahinla Pakai thempuho chunga akhutnu lha dingchu lengpa sohte anompouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin lengpan Doeg henga, Nangma kiheijin lang thempuho chungachun chun, ati. Chuin Edom mi Doeg chu akiheijin, thempuho chunga achun, hiche nikho chun tupat ponnem thempu sangkhol kivon mi somget le nga athatnin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin thempuho khopi Nob chu chemjamin asatnin, pasal le numei, chapang le noichep laiho, bongchal, sangan, chule kelngoiho chemjamin athat gamin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Ahitub chapa Ahimelech chapate lah-a khat amin Abiathar chu asohchan, David henga ajamin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Saul'in Pakai thempuho atha chu Abiathar'in David ahetsah tan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin David'in Abiathar jah-a, Chuche ni-a Edom mi Doeg chua anauma chu Saul ahetsah teiding chu kahet ahitai: napa insung mite jouse chu keijeh-a thia ahitaove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangma kahenga ummin lang, kicha hih-in: ajehchu keima thadinga eiholpa chun nang jong thadinga nahol ahi. Keitoh na-umle vang nahoidoh ding ahi, ati.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin amahon David jah-a, Ven Philistine ten Keilah asatnun, changphol ho achomun ahi, atiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun David'in Pakai adongin, Kache-a Philistine te khu kagasat dingham? ati. Chuin Pakaiyin David jah-a, Chen, Philistine te gasatnin lang, Keilah gahuhdoh-in, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David loihon ajah-a, Ven, hikom Judah gama bon kikicha-a, Keilah'a ihunguva, Philistine galsat miho igadou diuchu iti kichat umjocheh ding hitam? atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun David'in Pakai adong kitnin ahi. Chuin Pakaiyin adonbutnin, Kipatdoh-in lang Keilah'a chesuh-in; ajehchu Philistine te chu nakhutna kapehdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun David le aloite Keilah-a acheuvin, Philistine te chutoh akisatnun, agancha hou ahin pui mangun, amaho chu nasatah-in athatnun ahi. Hitichun David'in Keilah miho chu ahuhdoh tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, Ahimelech chapa Abiathar chu David henga Keilah lama ajam phatnin, aman akhutna thempu sangkhol khat ahinchoijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David Keilah'a ahungchu Saul henga aseipeh taovin ahi. Chuin Saul'in, Pathen'in ama kakhutna eipehdoh ahitai; ajehchu khopi kulkotpi le kotjol nei alutna chu, ama kikam khum ahitai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Saul'in mijouse chu galsat ding, Keilah'a chesuh-a David le aloite umchah din akoukhom tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule David'in guhthima Saul'in ama chunga doha abolchu ahen; Abiathar thempu henga chun, Thempu sangkhol chu hinchoi jin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun David'in, Vo Pakai Israel Pathen, keijeh-a Keilah khopi suse dingin Saul ahung suh-e ti kichentah in kajatai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keilah mihon akhutna eipehdoh diu ham? nasoh-in kajah banga hi Saul hungsuh ding ham? Vo Pakai Israel Pathen, katao ahi, nasoh hi neihet sah-in, ati. Chuin Pakaiyin, Hungsuh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichun David'in, Keilah miten keima le kamitehi Saul khutna eipeh doh dingu ham? ati. Chuin Pakaiyin, Amahon napehdoh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphatnin David le aloiho mi jagup tobang chu akipatnun, Keilah chu adalhaovin, achetheinao lamcheh-a achetauve. Chuin David chu Keilah'a konin ajamdoh tai tichu Saul aseipeh taovin; chule aman amaho kondoh dingchu ajahda tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin David chu gamthipma mundet tah khatna aumin, Ziph gamthip lhang khatna aumden tan ahi. Chule Saul'in aniseh-in aholin, ahivangin Pathen'in akhutna apedoh pon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Saul chu ama that dingin ahung kondoh-e ti chu David'in amutan: chule David chu Ziph gamthip gammanga uma ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Saul chapa Jonathan akipatnin, David umna gammanga chun achen, Pathen'a akhut tha agahatsah-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman ajah-a, Kicha hih-in: ajehchu kapa Saul khutnin namaidoh louhel ding ahi; nangma Israel chunga leng changding nahin, keima nabantah-a kahi ding ahi; chule hichu kapa Saul'in ahet ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amanin Pakai angsunga kitepna aneilhonin ahi: chuin David gammanga aumin, Jonathan chu a-in'a achetai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin Ziph miho chu Gibeah mun'a Saul henga ahungun, ajah-a, Jeshimon lhanglama um Hachelah lhang gammang lah mun dettah khatna David chu keiho toh kisela hilouham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun, vo lengpa, nalungin hungsuh ding anangaichat dungjuijin hungsuhtan; chule keiho mopohna chu lengpa khutna pehdoh dingchu hiding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Saul'in, Nangho Pakaiya phattheiboh chang hiuvin; ajehchu nanghon keima neilainat piuvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cheovin, naheng uva katao ahi, gakhol toh-un, hilai mun'a chu kon amu ham akiselna mun gaveovin lang gahetoh-un; ajehchu ama doha thuhtah ahi ti eikisei peh-e.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun akiselguhna mun jouse chu gahetoh-un, chule adihchet chu nahet tengule kahenga hung kitnun, chutengle keima nangho toh kalhon ding ahi. Chule hung hitiding ahi, ama gamsunga um ahi pouva ahile, Judah mi asang asang lah-a chu kaholdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amaho akipat doh-un, Saul angsunga konin Ziph gama ache taovin ahi: ahin David le aloiho chu Jeshimon lhanglam phaichama um Maon gamthipma aumuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Saul le amite jong ama holin acheuvin ahi. Chuin amahon David aseipeh-un: hijeh chun ama songpi khat sunga ahung lutnin, Maon gamthipma aumtan ahi. Saul'in hichu ajah phatnin, David chu Maon gamthipma ahin nungdel tan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Saul molpang hilam sanga achen, David le aloiho molpang khulam sanga acheuvin; chule David'in Saul ginna jammang loiding agon ahi: ajehchu Saul le aloihon David le amite chu matdinga a-umkolu ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla Saul henga thupole khat ahungin, ajah-a, Kinonlang hungin; ajehchu Philistine ten gamsunga gal ahinbol taove, tin ahungseijin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun David nung adelna-a konin Saul akinunglen, Philistine te satdin achetai. Hijeh chun hiche mun chu Sela-hammah-lekoth asah taovin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin David chua konchun achetouvin, Engedi mun dettah sunga achengtai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Philistine te nung adelna-a kon Saul ahungkile phatnin, ahenga, Ven, Engedi gamthipma David aume tin aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun Saul'in Israelte jouse lah-a kona kilhengdoh mi sangthum akipuijin, David le amite chu gamkel ho umna songko dung holdin achetaovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lamdunga kelngoi kotphung songko umna khatna ahungin; chule Saul chu kicholdo dingin alutnin ahi: David le aloiho chu songko sungnung lama chu uma ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David loihon ajah-a, Vetan, Pakaiyin nahenga, Ven, namelmate nakhutna kapehdoh ding ahi, nangman phante nati bang banga achunguva nabol ding ahi, tia asei nikho chu tuni ahi, atiuve. Chuin David akipatdoh-in, Saul sangkhol chol mong chu achelhah pehtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin chuche jouvin ahitin ahi, aman Saul sangkhol chol monglha achelhah jehchun David'in alungthimin phamo asalheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman aloiho jah-a, Pakai thaonu kapu chunga kakhut kalapma, thaonu ahi ti henasasa hitobang kabolding chu Pakaiyin aphalpoi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti chun David'in asohte chu hiche thua hin asutangin, Saul chunga akhut analha sahpon ahi. Ahinla Saul chu songkoa konin ahungdoh-in, alamjot ban ajomkit tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin David jong akipatnin, songkoa konin apotdoh-in, Saul jah-a, Kapu lengpa tin agah samin ahi. Chuin Saul'in nunglam ahinven ahile, David akunin tolla aboh khupmin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin David'in Saul jah-a, Ibola miho thusei, ven David'in suhsetdin nahole atiuchu nangaiham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ven, tunia hi Pakaiyin songko sunga chu itobanga kakhutna eipehdoh hitam ti namit tah-in namutai. Mi phabepmin nangma thatdin eisolun; ahin, Keiman kapu chunga kakhut lhaponge, ajehchu ama Pathen thaonu ahi, tin kamitmun kahing hoijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukal valin, kapa, ven, kakhutna um napon chol mong kachetanhi ven: ajehchu naponchol kache lhah-a nangma katha louva konhin kakhutna gitlouna le khelna aumpon, nangma dounan kachonsepoi ti namun, nahen ahi. Ahinla nangin kei hinkho lahdin neidel lelen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keima le nangma kah-a Pakaiyin thu tanhen lang, Pakaiyin naphu kachunga lamaihen; amavang kakhut hi nachunga chulou ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gollui thuchih-a kisei bangin, Migilouva konin gitlouna asohdoh-e, akiti: keima vang kakhut nachunga lhaponge.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israelte lengpa hi koi nung dela hung doh ham? nangman koinung nadel ham? uithisa khat nungle uili khat nungbou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun Pakai chu thutan hihen lang kei le nang kah-a thu tanhen, chule hinve hen, hin kholtoh henlang, nakhutna kona eihuhdoh hen, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahitin ahi, David'in Saul jah-a hiche thuho hi aseijou phatnin, Saul'in, Kachapa David, hichehi nangma aw hija ham? ati. Chuin Saul hakan akaptai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman David jah-a, nangma keisangin nachonphajoi: ajehchu nangman apha jenga bou neilethuh-in, keiman vang ase jenga bou kalethuh-e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule tunin nangman neiboldan neimusah tai: ajehchu Pakaiyin nakhutna einapeh jengin jong, nangman neithat poi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu min amelma amule bitkeicha lampia achemangsah dingham? Hijeh chun tunia kahenga nathilbol jehhin Pakaiyin thilphan nalethuh hen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule ven, tun thonlouva nangma leng nahung hia, Israel lenggam hi nakhutna kitungdoh ding ahi, ti kichen tah-in kahetai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun tun kahenga, kanung tengle kachilhah te nasuhbeilou nading le, kapate insunga kona kamin nasuhmang louna dingin Pakaiya kihahsel in, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin David Saul henga akihahsel tan ahi. Chuin Saul a-in'a achetan; David le amite vang aumnao mun'a achetou taovin ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Samuel athitan; Israelte jouse akikhom khomun, alunghem piuvin, a-in mun Ramah'a avui taovin ahi. Chuin David akipatnin Paran gamthipma achesuhtai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Moan kho-a chun Carmel'a anei agouho uma mikhat aumin; chule mipa chu ahao lheh jengin, kelngoi sangthum le kelcha sangkhat aneijin ahi. Chuin aman Carmel'a akelngoi mul avouvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun mipa minchu Nabal ahin, a-inneipi minchu Abigail ahi. Chule amanu chu numei lungching tah le melhoitah ahin: hinla mipa vang chu umje helou le gilou tah-a natong ahi: chule ama Caleb insungmi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David'in gamthipma chun Nabal'in akelngoi mul avouve ti thu ajan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David'in gollhang som asolin, David'in gollhangho jah-a chun, Carmel'a chetouvun lang, Nabal henga cheovin, chule kaminin chibai gabolun:
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule haosatah-a hingpa jah-a chu hitia nagasei dingu ahi, Nachunga lungmon umhen, na-insung chunga lungmon umhen, chule nanei jouse chunga lungmon umhen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule tun nangman kelngoimul vouho naneije ti kajaovin ahi: tun nakelngoi chingho chu Carmel'a aum sungseuvin keihotoh kaum khomun, kasugenthei pouvin, amahoa konin jong imacha amanga aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nagollhangho dongle chun namusah naovinte. Hijeh chun gollhangho hi namitmun lungsetna changu hen: ajehchu keiho kut nikho-a hung kahiuve. Nakhutna naphal khamkham chu nasohte le nachapa David dingin hinpen tin, gaseijun, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin David gollhangho ahung phatnun, hiche thuho jouse dungjui chun Nabal henga David minin aseijun anga taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Nabal'in David sohte chu adonbutnin, David chu koiham? chule Jesse chapa koiham? tulaijin apu thu palkeh-a jam manga soh tamtah aume.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman ka-anneh le katwidon, chule ka kelngoi mul vouho dia kathapeh kasa chu kalah-a hoija kon ahiu kahetlou mihochu kapeh dingham? ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun David gollhangho chu akinung leuvin, ahungun thujouse chu David ahiltaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin David'in aloiho jah-a, Amitakipmin nachemjam cheh kikouvin, ati. Chuin amitakip chun ama ama chemjam cheh akiko taovin; chule David'in jong achemjam akikon ahi. Chuin David nunga chun mi jali tobang le, moltum choi mi jani tobang acheuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin gollhang khatnin Nabal jinu Abigail aseipeh-in, ajah-a, Ven, David'in gamthipma konin kapu chibai boh dingin sottol leho ahinsolin ahile, aman amaho anajumson ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla miho chu keihodia phatah ahiuvin, eisugenthei pouvin, amahotoh kakihou theijuva, gamlah-a kaum sungseuvin imacha jong kamansah pouve:
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaho toh kiloija kelngoi kachin sungseuvin, amaho keihodin sun le janin kulbangin akisungun ahi
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun tun nangman ipi nabolding ham henlang ngaiton; ajehchu kapu chung le a-insung pumpi douna-a thilse kingaito ahitai. Ajehchu ama chutobang tah-a Belial chapa ahin, min ahenga thu asei theipon ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuphatnin Abigail akinoloijin, changlhah lhon jani, ju haini, kelngoi semtohsa nga, changkanpoh tena nga, chule lengpithei ga gop boh jakhat, theichang changlhah jani alan, asangan ho chunga agongtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amanun asohte jah-a, Kamasanga cheovin; veuvin, nanung uva kahunge, ati. Ahinla ajipa Nabal ahetsahpon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule anahitin ahi, amanu sangan chunga atouva, lhang dunga ahungsuh laijin, veuvin, David le aloiho amanu dontah-a ahungun; amaho chu akimaitopi tai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tun David'in, Aneijouse imacha amanlouna dinga gamthipma kanachin tuppeh chu mohseh ahitai; aman apha chu asen eilethuh tai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pasal tapou ama-a kaiho jouse jingkah khovah geija kahinghoi ja ahile, akalvalin jong Pathen'in David melmate chunga bolhen, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Abigail'in David amuphatnin, sangan chunga konin kintah-in akumlhan, David masanga chun alhun, tolla aboh khupmin;
  </para>
  <para style="p">
    <verse number="24" style="v" />Akhophang bula alhun, ajah-a, Kachunga, ka pakai, keima chunga hiche themona hi umhen; chule nahenga katao ahi, nasohnu hi nanakhanga thu neiseisah inlang, nasohnu thusei hi neingaipeh-in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nahenga katao ahi, ka pakai, hiche Belial mipa Nabal hi thupi tah-in lahih-in: ajehchu amin tobang banga ama jong hija ahin; amin Nabal ahin, ama-a ngolna um ahi. Ahinla kapun nahinsol gollhangho chu nasohnun kanamu lou ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun tun, kapu, Pakai hingjing le nangma hinna panna kasei ahi, Pakaiyin thisanso dinga nahung kon le nangma khut tah-a thisan phuladinga nahung kon hi atuhtang ahitan, tun namelmate le kapu dinga thilse ngaito chanchu Nabal tobang hiuhen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule tun kapu henga nasohnun kahinpoh hiche phattheina hohi, kapu nung hinjui gollhangho hi kipehen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nahenga katao ahi, nasohnu suhkhelna ngaidamin: ijeh inem itile Pakaiyin thonlouva kapu insung hi dettah-a atundoh ding ahi; ajehchu kapun Pakai gal nasat ahin, chule nahinkho sunga hin thilse himhim akimu pon ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahijeng vangin nahin nungdel dingle nahinkho lamang dingin mikhat akipatdoh-in: ahinla kapu hinna hi Pakai na Pathen hinna toh kikan khom ding ahin; namelmate hinnaho vang, aman ahsongse-a kona kisepdoh banga asedoh ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule hung hitiding ahi, Pakaiyin kapu-a dinga aman nangma chungchanga thilpha anaseiho jouse dungjuija ahintoh chaija, Israel chunga vaipo-a nahin pansah tengle;
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajeh beijin thisan naso hihen lang, kapu'n ama phu akilahna hijongle, hichu nangma dinga lungkhamna le, kapu dinga lungnatna hitalou ding ahi: ahinla Pakaiyin kapu-a dinga thilpha ahinbol tengle, nasohnu hi neihin geldoh-in, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin David'in, Abigail jah-a, Tunia eikimupi dinga nahinsola Israel Pakai Pathen chu nunnom hen.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tunia thisanso dinga kahungna-a kon le, kakhut tah-a kaphu kakilah nadinga kona eihoidoh-a nangmale nathumop chu nunnom hen.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ajehchu nangma eikimupi dinga kino loija nahung lou hile; nangma suhsetna dinga kona eituhtanga hingjing Israel Pakai Pathen min pana kasei ahi, thonlouva jingkhovah teng Nabal'a dinga pasal khatcha jong asohcha umlou helding ahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hitichun David'in amanun ahin pohpeh hochu akhutna konin akisanin, amanu jah-a, Na-in'a lung mongin chetan, ven na aw kangaija chule nangma kajabol nahitai, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Abigail chu Nabal henga ahungin; veuvin, aman a-in'a lengpa golvah tobangin golvah anabolin; chule Nabal chu ju akham jeh-in, alungsung akipah lheh-in ahi. Hijeh chun amanun jingkhovah kahsen imacha ahilpoi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahin jingkho ahungvah-in ahitin ahi, Nabal juhu atheu phatnin, a-inneipin thuho jouse chu aseipehtan ahile, alungsung athi helin, songtumto abangtan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin nisom jouvin ahitin ahi, Pakaiyin Nabal chu adengin ahile athitan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin David'in Nabal thithu ajah phatnin, Nabal khutna kona i-sah louva eikibolna phu eilah peh-a le asohpa thilse-a kona hoidoh-a Pakai chu nunnom hen; ajehchu Pakaiyin Nabal gitlouna chu ama luchanga achuhsahtai, ati. Chuin David'in Abigail chu ajidinga gahel dingin ahenga mi asolin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin David sohte chu Carmel'a Abigail henga ahung phatnun, amanu henga, David'in ajidinga nangma puidinga nahenga eihinsolu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin amanu akipatnin, aboh khupmin amai tolla asulutnin, ven, nasohnu hi kapupa sohte keng sildingin soh-in hungpang inge, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Abigail akipatdoh paijin, sangan chung khatna atouvin, anungjui nungah nga toh ahin; David thupole ho nunga achen, ajin agapang tai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin David'in Jezreel mi Ahinoam jong akipuijin; amani jong anilhonin aji ahilhontai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ahinla Saul'in achanu David jinu Michal chu Gallim mi Laish chapa Phalti chu apetan ahi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Ziph mite chu Saul henga Gibeah'a ahungun, David chu Jeshimon masanga um Hachilah lhanga kisela hilouham? atiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin Saul akipatnin, Ziph gamthipma David holdingin Israel pasal akilhengdoh sangthum apuijin, Ziph gamthipma achesuh tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Saul'in Jeshimon masang lampi pang Hachilah lhanga gebuh asongin ahi. Ahinla David chu gamthipma aumin, Saul'in gamthipma anung ahindel chu amun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun Davidn'in mive lhiho asolin, Saul chu ahung monge ti ahechentai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David akipatnin, Saul gebuh sonna-a chun ahungin ahi: chuin David'in Saul le janel gal lamkai Ner chapa Abner lupna chu aven: Saul chu leiko-a alumin, mipi chun akimvela gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin David'in adonbutnin Hit mi Ahimelech jah le Joab sopipa Zeruiah chapa Abishai jah-a, Saul henga agebuh uva keitoh lhonsuh ding koi nahiuvem? ati. Chuin Abishai'in, Keima nangtoh kalhonsuh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti chun David le Abishai chu jan-in mipi ho henga chun ahunglhonin: chuin veuvin, Saul leiko sunga analumin, alulhun koma chun atengcha tolla akiphutnin ahi: Abner le mipi vangchu akimvela alumun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun Abishai'in David jah-a, tunia hi Pathen'in namelmapa hi nakhutna napehdoh ahitai: hijeh chun nahenga katao ahi, tun that jeng inge, tengchan khatvei sutnin tolto kilbeh jenging kate, velni kasut louding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin David'in Abishai jah-a, Sumang hih-in: ajehchu koiham Pathen thaonusa khat douna-a achunga akhut lha-a themmo changlouva umthei ding? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />David'in aseiben, Hingjing Pakai min pana kasei ahi, Pakaiyin sumang nante; ahiloule athinading anikho hunglhung nante; ahilou jongle galsatna konsuh intin, mangthah nante.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai thaonu chunga kakhut kalha ding chu Pakaiyin aphalpoi; ahinla nahenga katao ahi, tun alulhun koma tengcha le atuipai chu lanlang cheta hite, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun David'in Saul lulhun koma tengcha le twipai chu alan, achemang lhontai; amahon hejong ahepouvin, mujong amupouvin, koimacha akhanga jong aumpoi. Pakaiya kona imutlhuhna nasatah achunguva achuh jeh chun, amaho a-ihmu cheh-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin David agal langkhatna agalkaijin, chule lhang chungvum khatna gamlatah-a adingin; akah uvah gam ong lentah aumin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin David'in mipi le Ner chapa Abner agah samin, ajah-a chun, Abner, nadonbut louding ham? ati. Chujouvin Abner'in adonbutnin, Lengpa hinsama nangma koi nahim? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin David'in Abner jah-a, Nangma pasal hangsan nahi hilouham? chule Israel sunga nangma tobang koi umam? achutile napu lengpa chu ida nangatup louham? ajehchu miho lah-a khat napu lengpa thatdingin ahungin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche nathilbol hi aphapoi. Hingjing Pakai min pana kasei ahi, Pakai thaonu napupa nangatup loujeh-a athidinga lom nahi. Chule tun, lengpa tengcha chu hoija um hitam? chule alulhun koma um atuipai chu hoija uma hitam? ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Saul'in David aw chu ahen, Hiche hi nang aw ham? kachapa David? ati. Chuin David'in, Vo ka pakai lengpa, kei aw ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman ipidinga ka pakaiyin asohpa nung adel ham? ipi kabol em? ahiloule kakhutna ipi gitlouna umem?
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun tun nahenga katao ahi, kapu lengpan asohpa thusei hi ngaihen. Pakaiyin keima doudinga nachothou ahile, aman thilto kisanhen; ahinla amahochu mihem chate ahiule, Pakai masanga sapset changuhen; ajehchu amahon tuni hin Pakai gouloho umna-a konin einodoh-un, pathen dangho gajenin eitiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun tun kathisanhi Pakai maikoh-a tolla longhihhen; ajehchu Israelte lengpa chu mikhatnin molsang ho-a vabuh adel bangin, uili khat holin ahung kondohtai, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichun Saul'in, Keima kachonse tai: hungkile kittan, chapa David: ijeh inem itile keiman nangma kasuh gentheikit louding ahitai, ajehchu tunin kahinna hi namitmun amantan lheh-e: vetan, ngolhoi tah-in kachonin, nasatah-in, kasukheltai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin David'in adonbutnin, Ven lengpa tengchahi gollhangho khat hung galkaihen lang hunglahen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakaiyin amitakip achonphatna le akitahna alethuhjin ahi: ajehchu tunin Pakaiyin nangma kakhutna eipeluttan, hijongle keiman Pakai thaonusa chunga kakhut kalha louding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule ven, tunia nahinkho kamitmu-a manlutah ahibang hin, Pakai mitmun keima hinkho jong manlutah hihen, chule gentheina jouse-a konin eihuhdoh hen, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujouvin Saul'in David jah-a, Kachapa David, nunnomin, nangin thil loupitah nabol ding, chule jojong najopeh ding ahi. Chutichun David achenading lampia achetan, Saul jong aumna-a akiletai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David'in alungthimin, Tun nikhatle Saul khutna kathi teiding ahin; Philistine te gamsunga gangtah-a ka-otdoh tailou keidinga phajo imachadang aumpoi. Chutile Saul'in Israel gamsunga eihol hi ngatantin; akhutna kona kahoidoh ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David akipatnin Gath lengpa Maoch chapa Achish henga aumpi mi jagup chutoh agalkai taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David chu amale aloiho, chule amitakip a-insung mite jouse toh, David le ajiteni Jezreel mi Ahinoam le Carmel mi Nabal inneipi Abigail ngei chutoh Gath'a chun Achish toh acheng taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David Gath'a ajamtai ti Saul aseipeh-un ahile, aman aholkit tapoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David'in Achish jah-a, Tun namitmu-a lungsetna kachana ahile, gamsunga khopiho lah-a hin kachen nadin munkhat eipeuhen; nasohhi ibola lengkhopi sunga nangtoh kachen khom dingham? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuphatnin Achish'in hiche nikho chun Ziklag chu apetai. Hijeh chun Ziklag chu tulai geihin Judah lengte gam ahijingtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Philistine te gamsunga David aumna phatchu kum khat le lhali lhingset ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin David le aloiho chu akondoh-un, Geshur mite, Gezri mite, chule Amalek mite agasat taove; ajehchu hiche namhochu Shur jotna lampi-a pat Egypt gam geija masanglaija pat agama chu cheng anahi taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule David'in chuche gamchu asumangin, numei pasal khatcha ahoipon, kelngoiho leh bongchalho, sanganho leh sangongsang ho, chule ponsil ho akilah-in Achish henga ahung kiletai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Achish'in, Tuni hoilam nagachomu ham? ati. Chuin David'in, Judah lhanglam sang, Jerahmeel mite lhanglam sang, chule Ken mite lhanglam sang, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuti chun David'in Gath henga thu hinpo ding pasal ahin, numei ahin khatcha ahinghoi jipon ahi; ajehchu aman, achuti loule ichungthu-u ahenga gahilun tin, David'in chutin abolin, Philistine gamsunga achengin phatseh-in hiti khatin achonne tiget nunte ati ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Achish'in David atahsanin, Aman ami Israelte chu akihotsah heltai; hijeh-a chu ama a-itih-a kasoh hijing ding ahitai, ati.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche nikho laichun ahitin ahi, Philistine te chun Israelte toh kisatdin asepaiteu galsat dingin akhom khomun ahi. Chuin Achish'in David jah-a, Nangho le namite galsatdia keitoh ikon dohdiu ahi ti kichentah-in nahei, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David'in Achish henga, Thonlouva nasohpa hin ipi kabolthei nahet ding ahi, ati. Chule Achish'in David jah-a, Hijeh-a chu a-itih-a eihongbit dinga kapansah ding nahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun Samuel chu athitan, Israelte jouse chun akauvin, ama khopitah Ramah-a chun avuitaove. Chule Saul'in lhakouhole doithemho gamsunga konin anodohtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Philistine te akichom khomun, ahungun Shunem'a gebuh ahungsong taovin ahi: chule Saul'in Israelte jouse achom khomin Gilboa'a gebuh asongun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Saul'in Philistine janelho amuphatnin, akichan, alungthim akihot hot jengtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Saul'in Pakai adoh phatnin, Pakaiyin amangin jong, Urim'in jong, themgaohon jong adonbutpon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuphatnin Saul'in asohte henga, Ahenga kache-a kadoh theinadin numei lhakouthei khat neigahol peh-un, ati. Chuin asohten ajah-a, Ven, Endor'a numei lhakouthei khat aume, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Saul'in alim akhelin, vonchom akivonin, minitoh jan-in numeinu henga chun ahungtaove. Chuin aman, Nahenga katao ahi, nalha kouthei na-a chun phun neisan peh-inlang, nahenga min kasei penpen chu neihin koudoh peh-in, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin numei chun ajah-a, Ven, Saul'in lhakou ho le doithemho gamsunga kona iti adeldoh helham nangman nahei. Achutile ibola kathi nadinga, kahinkho hi thang neikam peh ham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Saul amanu henga Pakaiya akihahselin, Hingjing Pakai min pana kasei ahi, hiche jeh-a hi nachunga engbolna chulou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin numei nun, Nahenga koi kahin puitou diham? ati. Chuin aman, Samuel neipuitou peh-in, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amanun Samuel amuphatnin hatah-in apengin: chuin Saul jah-a, Ibola neilhep ham? ajehchu nangma Saul nahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin lengpan amanu jah-a, Kicha hih-in: nangin ipi namu em? ati. Chuin numeinu chun Saul jah-a, pathenho leisetna kona ahung kaltouvu kamui, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman amanu jah-a, Aman itobang mel aputnem? ati. Chuin amanun, Tehsepu khat ahungtouvin; sangkhol cholin akivone, ati. Chuin Saul'in Samuel ahi ahetan, amai tolla asulutnin akuntai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Samuel'in Saul jah-a, Ibola puitoudinga neisuhboi ham? ati. Chuin Saul'in adonbutnin, Kalung genthei behset jenga ahi; ajehchu Philistine ten eisatnun, Pathen keija konin achemang tan, themgao ham, mang hamin jong eidonbut tapon ahi: hijeh-a chu ipi kabolding nangin neihetsah theina dinga kakou nahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichun Samuel'in, Pakai nanga kona achemang henasa le namelma ahitai ti henasa-a ibola keima neidoh ham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakaiyin kakoma aseibanga abol ahitai. Ajehchu Pakaiyin lenggam chu nakhutna kona alhekeh-a, naheng nakom David ngeichu apeh ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu Pakai thusei nangaipon, chule Amalek mite chunga alunghana tijat umtah chu natongdohpoi; hijeh-a chu tunia hi hichehi Pakaiyin nachunga abol ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Achungchona jong Pakaiyin Israel chu nangma toh Philistine te khutna apehdoh ding ahinalaije. Chule jing nikho le nangma le nachapate keitoh i-um khomdiu ahitan: chule Pakaiyin Israel janel jongchu Philistine te khutna apehdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuphatnin Samuel thusei jehchun Saul chu alhun tolla akijamhel jengin, akicha behseh jengtan ahi: chule ama-a chun tha himhim aum tapon ahi; ajehchu sun nilhum jankhovah-a an nelouva um ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin numeinu chu Saul henga ahungin, alunggim behseh chu amun, ajah-a, Ven, nasohnun nathu kanitnin, chule kahinkho kakhutna kakichoijin, kahenga nasei thuho chu kangaijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun tun nahenga katao ahi, nangin jong nasohnu thusei ngaijin lang, na-anga changlhah kam khatbeh luipeh ingting; nachena ding lampia nache tengle tha nanei theinadin nen, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin ama anomhih-in, Kaneh louding ahi, ati. Ahinla asohte le numeinu akithouvin angeh teitei jengun ahile, athu angaitai. Chutichun tolla konin akipatdoh-in, jalkhun chunga atoutai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule numeinu hin a-in'a bongnou thaochet khat aneijin; chuin gangtah-in athatnin, changbong alan ameh halin, chule hichea chun cholso louvin changlhah akangin;
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Saul le asohte anga ahindomin, amahon anetaove. Chuin amaho chuche janchun akipatnun, achetauve.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Philistine ten asepaiteu jouse Aphek'a akhomun, Israel ten Jezreel'a twinah phung khatna gebuh asongun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Philistine te pakaiho chu aja ajan, chule asang asangin akitol akitol jengun; ahinla David le aloiho chu Achish toh anunung penin ahung kitolun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Philistine pipuihon, Hiche Hebrew miho hin hikoma ipi aboluham? atiuve. Chuin Achish'in Philistine pipuiho jah-a, Amahi Israel lengpa Saul sohpa, ni hijatle kum hijat kakoma um, kei koma ahung lutna pat tuni geija amona kamulou David hilouham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Philistine pipuiho chu achunga alunghangun, chule Philistine te chun ahenga, Hiche mipahi nangman aumna dinga napeh mun'a chu achekit theinadin kinungle sahtan, eiho toh galmuna chesuh khom hihhen, achuti loule galkisat na-a chun eiho douvin hungpang getninte. Ajehchu apu toh ipi-a kicham kit dingham? hiche mite luchanga kon hilou dingham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihon khat le khat kilhang lhah-a lam puma la asah uva, Saul'in asang asang athatnin, David'in sangsom sangja athatne, atiuchu hiche David hi hilouham? atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuphatnin Achish'in David akouvin, ahenga, Hingjing Pakai min pana kasei ahi, nangma nachondih jingin, chule janel lah-a keima toh nalutle napotle hi kamitmun aphalheh-e: ajehchu kahenga nahunga pat tunigei hin nachunga thilse kamupoi: hitajongle pipuihon nadeipouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun Philistine pipuiho nalunghansah lounadin kilenlang, lung mongin chetan, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin David'in Achish henga, Hijongle ken ipi kabol em? tuni geija nangma toh kahung um sunga hi nasoh chunga ipi namu-a, kapu lengpa melmate satdinga kache monading ipi umam? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Achish'in adonbutnin, David jah-a, Kamitmun Pathen vantil khat bangin naphai ti kahei: achuti vangin Philistine pipuihon, Ama eiho toh galmuna chetou louhel ding ahi, ati ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun tun jingkah matah kho avah vahle napu sohte nahin kilhonpi hotoh thoudoh unlang che jengun, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuti chun David le amite chu kipatdoh-a Philistine gama kiledin matah-in athoutaove. Chule Philistine te chu Jezreel'a achetou taove.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, nithum ni-a David le aloiho Ziklag ahung lhunun, Amalek miten lhanggam le Ziklag ana buluvin, Ziklag kho chu anasatnun, meijin ahalun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule asunga um numei ho chu gal hingin akaijun, alen le aneo khatcha thatlouvin akaimangun, achetauve ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun David le aloiho chu khopi ahunglhung taovin, chuin veuvin, meijin ana kihal vamin; ajiteu le achapateu, chule achanuteu gal hingin anakai taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David le alhonpi mipi chu ka nadinga tha aneilou geijun, hakan akaptaovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule David jiteni Jezreel mi Ahinoam le Carmel mi Nabal jinu Abigail chu gal hingin anakai taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule David chu ahesoh lheh jengtan ahi; ajehchu amitakip achapate le achanute dinga alungkham cheh jeh-un, mipin ama songa seding agotauve. Ahinla David amatah Pakai a-Pathen'a akitil khouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David'in Abiathar thempu Ahimelech chapa henga, Nahenga katao ahi, thempu sangkhol chu eihin choipeh-in, ati. Chuin Abiathar'in thempu sangkhol chu David henga ahinchoi tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin David'in Pakai adongin, Hiche mihonpi chu kanungdel dingham? del leng kaphah jouding ham? atin ahi. Chuin aman adonbutnin, Delin: ajehchu nangman naphah teitei ding, thonlouva nahuhdoh sohding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutichun David le aumpi jagupho chu acheuvin, Besor vachadung ahung lhungun, ami dalhahho chu chuachun aumtaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla David le mipi jali chun anungdel uvin ahi; ajehchu mi jani chu alhahsam behseh jeh uva Besor vachadung galkai joulouva umdena ahitaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon gamlah-a chun Egypt mikhat amuvin, David henga ahinpuijun, changlhah apeuvin ahile aman anen; chule donding twi jong apeuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin theichang changlhah halkhat le lengpithei gop bohni apeuvin; chuin aman aneh phatnin, atha ahungkile kittan ahi. Ajehchu nithum le janthum an nelou twi donlouhel ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin David'in ajah-a, Koija nahiham? chule Hoilama kon nahim? ati. Chuin aman keima Amalek mikhat soh, Egypt gollhang kahi; kadamlou jeh-in kapun nithum masang chun eidalhatan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chereth mite lhanglam, Judah te gamsung, chule Caleb gam lhanglam kabulu uvin, chule Ziklag chu meijin kahalun ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin David'in, Hiche loiho henga chu neipuisuh theiding ham? ati. Chuin aman, Neitha louding le kapu khutna neipehdoh loudingin Pathen'a kihahsel in, chule hiche loiho henga chun puisuh nange, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman apuisuh phatnin, veuvin, amaho tollhanga anakithe jalun, Philistine gam le Judah gama kona thil tamtah achomdoh jeh-u chun, aneovin, adonnun, alamun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin David'in amaho chu khovah tila pat ajing nilhah lam geijin asatnin: sangongsang chunga touva hoidoh gollhang jali tilou mi khatcha asohchapon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule David'in Amalek miten apoh mangho chu akilelah sohkeijin: David'in ajiteni jong ahuhdohtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amahon anachomu alen ahin, aneo ahin, achanuteu ahin, achapateu ahin khatcha lhasam umlou helin David'in alelah sohkeijin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin David'in kelngoihon holeh bonghonho chu alasoh keijin, hiho chu gancha dangho masanga ahoijun, Hihohi David galthil chom ahi, atiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin David alhahsam behseh jeh-a David juijou louva mi jani ho heng, Besor vachadunga aumsah hou henga chun ahungin; chule amaho David le ahinlhonpi mipi ho chu lamtodin apotdoh-un ahi. Chuin David'in miho heng ahinnai phatchun, amaho chu chibai aboh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichun David kilhonpi ho lah-a migilouho le Balial miho jouse chun adonbutnun, Amaho ilah uva ahung pantha loujeh-u chun, akipuijuva ache theina ding uva ajiteu le achateu ipeh-u tailou akichom thilho jouse chu khatcha ipeh lou dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuphatnin David'in, Kasopite ho, Pakaiyin eihoidoh uva, eiho doudinga hunga mihonpi chu ikhutnuva eipedoh uva kona eipeh-u thilho hi chutichun bolhih-un.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu hiche thua hi kon nathu-u angai dingham? galsat dinga konpa chan jatjat chu thilchinga pangpa jong changding ahi: amaho akibang banga kihom dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule chuche nikho-a pat tuni geihin, Israelte din chutichun houdan thupeh le chondanin achepehtai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin David Ziklag'a ahung phatnin, agalthil chomho phabep chu Judah upaho, agolho geijin athotnin, ajah uva, Veuvin, Pakai melma te-a kon galthil kichomdoh nangho dinga thilpeh ahi, atin;
  </para>
  <para style="p">
    <verse number="27" style="v" />Bethel'a umho, Ramoth lhanglama umho, chule Jattir'a umho,
  </para>
  <para style="p">
    <verse number="28" style="v" />Aroer'a umho, Siphmoth'a umho, chule Eshtemoa'a umho,
  </para>
  <para style="p">
    <verse number="29" style="v" />Rachal'a umhole Jerahmeel mite khopiho-a umho, chule Ken mite khopi ho-a umho,
  </para>
  <para style="p">
    <verse number="30" style="v" />Hormah'a umhole, Chorashan'a umho, chule Athach'a umho,
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Hebron'a umhole, David amatahle aloiho umna munjouse-a henga chun athot tan ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Philistine ten Israelte dounan gal ahinbolun: chule Israel mitechu Philistine te masanga konin ajamun, Gilboa molsanga chun akithat chap jengun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Philistine ten Saul le achapate hatah-in ajuijun; chule Philistine te chun Saul chapate Jonathan, Abinadab, chule Melchishua chu athat taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Saul douna gal kisat chu anasa lheh jengin; thalthem ho-a konin nasatah-in amachangtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuphatnin Saul'in agalvon popa jah-a, Nachemjam satdoh inlang neisunpai jengin; achutiloule hiche cheptan louho khu hunguntin eisununtin, eijumso getnunte, ati. Ahinla agalvon popa anompoi; ajehchu kicha behseh jenga ahi. Hijeh chun Saul'in chemjam alan, achung chu abotan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin agalvon popan Saul athi amuphatnin, aman jong achemjam chu abokhumin amatoh athi thatai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti chun Saul le achapate thum, agalvon popa le amiho jouse chu chuche nichun athigam taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Israel mipi phaicham pang langkhatna umhole, Jordan pang langkhat lama umhon Israel mite ajama Saul le achapate athiu chu amuphatnun, khopiho adalhaovin ajamtaovin ahi. Chuin Philistine te ahungun, asunga acheng taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ajingin ahitin ahi, Philistine te akithatho von sutdinga ahung phatnun, Saul le achapa thumho chu Gilboa molsanga alhuh chapmu amutaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amaho alu atanun, agalvon asutlhaovin, amilim hounao inho le mipi ho lah-a phonjal dingin Philistine te gamsunga athot kimvel taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin agalvon chu Astaroth insunga akoijun: along chu Beth-shan banga akanbeh-un ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Philistine ten Saul abolnau chu Jabesh-gilead'a chenghon ajah phatnun;
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihangsan jouse akipatnun, jankhon acheuvin, Saul le achapate longchu Beth-shan kulbanga konin alauvin, Jabesh'a ahungun, hikoma chun ahaltaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aguho chu alauvin, Jabesh kho-a thingphung noi khatna avuijun, nisagi an angolun ahi.
  </para>
</usx>
