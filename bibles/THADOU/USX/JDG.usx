<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JDG" style="id">Thutanho</book>
  <para style="h">Thutanho</para>
  <para style="toc1">Thutanho</para>
  <para style="toc2">Thutanho</para>
  <para style="mt">Thutanho</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Joshua thi nungin ahitin ahi, Israel miten Pakai henga, Keiho-a dinga Canaan mite douva kisatpi dinga koi che masapen dingham? tin adongun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin, Judah chetou ding ahi; Ven, keiman gamsunghi akhutna kapehdoh ahitai ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Judah'in asopipa Simeon hengah, Canaan mite eisat khompi dingin keima eikipe kagam lona-a hungtouvin; chule chutobangma chun nangma nakipe nagam lona-a jong kilhonpinge, ati. Hitichun Simeon'in akilhonpin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Judah achetouvin, chule Pakaiyin Canaan mite le Perizz mite chu akhutna apehdoh tan: chule amahon Bezek'a chun mi sangsom athat uvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahon Adonibezek chu Bezek'a amuvin, ama chu akisat piuvin, chule Canaan mite le Perizz mite chu athatnun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin Adonibezek ajamin; chuin amahon anungdelun, amanun, chule akhutpi le akeng khopiho atanpeh-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Adonibezek'in, Leng somsagi akhutpiu le akengpiu kitanlhaho chun kadokhang noija anmal akilokhomu ahin: keiman kana bol bang banga chu Pathen'in kachunga eilethuh ahitai ati. Chule amahon ama chu Jerusalem'a ahinpuijun, chua chun ama athitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun Judah chatehon Jerusalem asatnun, alauvin, chemjamin asatnun, chule khopi chu meijin ahal lhaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche nungchun Judah chate chu molsanga cheng, lhanglama cheng, chule phaichama cheng Canaan mite toh kisat dingin achesuh-un ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Judah'in Hebron'a cheng Canaan miho akisatpin; (tun Hebron hi masangin Kirjath-arba ana kiti:) chuin amahon Sheshai, Ahiman, chule Talmai chu athatnun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin chua konchun Debir'a chengho akisatpin ahi: masangin Debir min chu Kirjath-sepher anahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Caleb'in, Koihile Kirjath-sepher gasatna, gala-a aumleh, amachu ajidinga kachanu Achsah kapeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Caleb naopa Kenaz chapa Othniel'in hichu agalatan; chuin aman achanu Achsah chu ajidin apetan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ahitin ahi, amanu amapa henga ahung phatnin, amanun apa henga gam athumdin angehtai. Chuin amanu asangan'a konin akumlhan ahile, Caleb'in amanu henga, Ipi nadeijem? anati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amanun ahenga, Phatthei neiboh-in: Nangman lhanglam gam neipeh ahi ngaleh, twinahho jong neipen, ati. Chuin Caleb'in twinah sahnung le lhangnung chu apetai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Mosi nupapa Ken mipa chate chu tumthing kena khopi-a konchun Judah chate toh apotdoh-un, Arad lhanglama um Juda gamthipma alutnun; chule acheuvin miho lah-a chun agacheng taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Judah chu asopipa Simeon toh achen, Zaphath'a cheng Canaan mite athat nun, asugam helun ahi. Chule akhopi minchu Hormah akitin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Judah'in Gaza chu agamsung pumpi toh, Askelon chu agamsung pumpi toh, Ekron chu agamsung pumpi toh alan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Pakaiyin Judah aumpin; aman molsanga chengho chu adelmangin; amavang phaichama chengho chun thih sakol kangtalai aneijeh-un adeldoh joupon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Mosi'n anasei bangin Hebron chu Caleb apeuvin ahi. Chuin aman chukoma konchun Anak chate thumho chu adeldoh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Jerusalem'a chenga Jebus mite chu Benjamin chaten adeldoh pouvin; amavang tunigeijin Jebus mite chu Benjamin chatetoh Jerusalem'a achengkhom nalaijun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Joseph insung miho jong chu Bethel satnin akonun; chule Pakaiyin amaho aumpin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Joseph insung miho chun Bethel gavelhi din mi asolun ahi. (Masangin hiche khopi minchu Luz anakisah-in ahi.)
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin gam velhihon khopi-a kona hungdoh mikhat amuvin, ahengah, Kataovu ahi, khopi lutna hoilang ham neihilun, chutile hepina kamusah dingu nahi, atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman khopi lutna avetsah phatnin, amahon khopi chu chemjamin asumangun; mipa vang chu a-insung mite toh asoldoh taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin mipa chu Hit miho gama achen, khopi khat agatungdoh-in, hichu Luz asah-in: tuni geijin hiche minchu apujing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Manasseh'in Bethshean'a chenghole akhopi, Taanach'a chengho le akhopiho, Dor'a chengho le akhopiho, Ibleam'a chengho le akhopiho, Megiddo'a chengho le akhopiho chu anodoh pon; amavang gamsunga chun Canaan miho acheng jouvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ahitin ahi, Israelte ahunghat phatnun Canaan miho chu hunama natongin apansah-un, adeldoh sohkei pouvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ephraim'in jong Gazer'a cheng Canaan miho chu adeldoh pon; amavang Canaan miho chu Gezer'a amaho lah-a achengun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulun'in jong Kitron'a cheng miho ahin, chule Nahalol'a cheng miho ahin adeldoh pon; amavang Canaan miho chu alah uva achengun, hunam natongin apansah uvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Asher'in jong Accho'a cheng miho, Zidon'a cheng miho, Ahlab'a, Achzib'a, Helbah'a, Aphik'a, chule Rehob'a cheng miho chu adeldoh pon ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amavang agama cheng Canaan miho lah-a chun Asher mite chu achengun ahi. Ajehchu amaho adeldoh louvu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Naphtali'in jong Beth-shemesh'a chengho ahin, chule Beth-anath'a chengho chu adeldoh pon; amavang agama cheng Canaan miholah-a chun ama achengun ahi. Ahijeng vangin Beth-shemesh le Beth-anath'a chengho chun amaho henga kai apeuvin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Amor mite chun Dan chate chu molsang lama adel touvun, phaichama hungjong ahungsah pouvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahin Amor mite chu Aijalon'a um Heres molsang le Shaalbim'a achengun ahi. Ahivangin Joseph insung mite khutnin amaho chu ajouvin, hitichun amaho hunam natongin apangtaovin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Amor miho gamgi chu Akrabbim lam chetou na-a pat, songpi-a pat achunglam ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai vantil khat Gilgal'a konin Bochim'a ahungtouvin, hitin aseije, Keiman Egypt'a konin kapotdoh sah-in, napu napateu kahahselna gamsunga kahin puilutnin; chule keiman kanaseijin, Nang hotoh kakitepna imatih-a jong kasukeh louding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nangho hiche gama cheng miho toh kijop matna naneilou diu; amaicham nasuhchim pehdiu ahi kanati. Ahinla nanghon ka aw nangaipouve. Ibola hiche hi nabolu hitam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun hiti jonghin kaseije, Namasanguva kona amaho kadeldoh louding; amavang amaho chu naveluva ling banga umdiu, chule a-pathen houchu nangho dinga thang hiding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ahitin ahi, Pakai vantil chun Israel chate jouse henga hiche thu asei pet chun, amaho awsang tah-in akap taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amahon hiche mun minchu Bochim asah-un; chule chukoma chun Pakai henga kilhaina abolun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Joshua'n mipi ho chu alhadoh phatnin, Israel mite amichangcheh chu agamu lodin a-inlam cheh uva ache taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin miho chun Joshua hinlaise le, Israelte dinga Pakai natoh loupitahho anamu-a Joshua sanga hingsot upaho hinlaise chun Pakai chu ajenun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakai lhacha Nun chapa Joshua chu kum jakhatle somkhat alhin phatnin athitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amahon Gaash sahlam Ephraim molsanga um agoulo Timnath-heres gamgi-a chun avuitaovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin chuche khang miho jouse jong chu apu apateu toh gopkhomin aumgam taovin; chule amaho nungin Pakai helou, chule Israelte dinga anatohho hephalou khangchom ahung umdoh tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Israel chate chun Pakai mitmun thilse abolun, Baal ajenun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amahon Egypt gama kona hinpuidoh-a apu apateu Pakai Pathen chu adalhaovin, aveluva um mihemho pathenho lah-a pathen dangho chu ajuijun, hicheho anga chun aboh khupmun, Pakai chu alunghansah taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule amahon Pakai adalhaovin, Baal le Astaroth chu ajen taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichun Pakai lunghanna chu Israelte chunga ahung soudohtan, amaho achomgam hou khutna chun achomgam dingun apedohtan; chule amaho agal miteu masanga adin joulou nadingun, aveluva um agal miteu khutna ajohdoh tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakaiyin aseibang le amaho chunga akihahselna bangchun, achedohna chanuva Pakai khut chu amaho dounan aphalou lama achun; amaho nasatah-in agenthei taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin Pakaiyin thutan ho atundoh peh-in, amaho chun achomgam hou khutna konin ahuhdoh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahijeng vangin amahon athutanhou thu chu angai pouvin, pathen dangho nung juijun noti'n apangun, a-anguva aboh khupmun ahi. Amaho apu apa teovin Pakai thupeh angaijuva achenau lampia konchun gangtah-in akihei mangun, hibang chun abolpouvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pakaiyin thutan ho atundohpeh phatnin, Pakaiyin thutan ho aumpin, thutan ho nikholaisen agalteu khutna konin ahuhhingin ahi. Ajehchu amaho suhgenthei le bol hesoh-a aum uva apen pennao jehchun Pakaiyin alung aheitan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule ahitin ahi, thutanpa athi phat phatle amaho akilehei jiuvin, pathen dangho chu jending le a-anga bohkhup dingin apu apateu sangin abohjo jiuvin; acham tah uva anatoh uva konle, alouchal uva konin atang deh pouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakai lunghana chu Israelte chunga ahung soudoh-in, hitin aseije, Hiche mite hin apu apateu henga thupeh kanapeh kakitepna asuhkeh uva, chule kathu angailou jeh-un,
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman jong Joshua athia adalhah namhohi amasanguva kona khatcha kadeldoh louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutia chu amaho-a kona hi, apu apa teovin anajui banguva Israel ten Pakai lampi chu ajuijuvem ajuihih uvem kaphotchet ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichejeh-a chu Pakaiyin hiche namho chu mangang tah-a delmang louva akoija, chule Joshua khutna jong ana pehdoh lou ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin Israelte, Canaan gamsunga galkisat hekha loulai Israel mi tampiho patep nadia akhen namtin vaipiho chu hichenghi ahiuvin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate khangguihon galsat dan ahetna dingu leh, tumasanga ima anahe loulaihon ahetna dinguva kikhena ahiuve;
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche ho chu, Philistinte leng nga ho, Canaan miho jouse, Sidon miho, Baal-hermon molsanga patna Hamath lutna geija Lebanon molsanga cheng Hiv miho ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Israel ten Pakai thupeh, Mosi khutna kona apu apateu henga ana thupeh chu angainah uvem ti photchetna dinga amaho chu kikhendoh ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Israel chate chu Canaan miho, Hit miho, Amor miho, Perizz miho, Hiv miho, Jebus miho lah-a achengun;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amahon achanuteu ajidingun alauvin, achanuteu amaho chapate dingin apeuvin, chule a-pathen hou jong ajenun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Israel chate chun Pakai mitmun thilse abolun, Pakai a-Pathen'u asumilun, Baal le Asherah ajenun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichejeh chun Pakai lunghana chu Israelte chunga asoudoh tan, hijeh chun Mesopotamia lengpa Chushan-rishathaim khutna amaho ajohdoh tan; hitichun Israel ten Chushan-rishathaim chu kumget ajenun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Israel chate Pakai henga apen phat uvin, Pakaiyin Israelte huhdoh ding khat, Caleb naopa Kanez chapa Othniel ngeichu atungdoh-in, amachun amaho ahuhdoh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakai lhagao chu achunga achun, aman Israelte thu atanin, galsat din akondoh-in: chule Pakaiyin Mesopotamia lengpa Chushan-rishathaim chu akhutna apedoh-in; chule akhutnin Chushan-rishathaim chu ajoutan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin gamsung chu kum somli akicholdon ahi. Chuin Kenaz chapa Othniel chu athitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Israel chaten Pakai mitmun thilse abolkit taovin; chule amaho Pakai mitmu-a thilse jeng abol jeh-u chun, Pakaiyin Israelte dounan Moab lengpa Eglon chu athahatsah tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman Ammon le Amalek chate ahenga akhomin, akondoh-in Israelte agajouvin, tumthing khopi chu alotan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun Israel chaten Moab lengpa Eglon chu kum somleget ajenun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin Israel chate Pakai henga aka phatnun, Pakaiyin Benjamin mi Gera chapa Ehud, mi veikolong pa chu ahuhdoh dingun atundohpeh-in; chule ama khutna chun Israel chaten Moab lengpa Eglon henga thilpeh athotnun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Ehud'in hemto chemjam tongkhatna sao akisemin, ajetlam malpi chunga avonnoija akigah-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman thilpeh chu Moab lengpa Eglon henga ahin choijin: chule Eglon chu mithaotah ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman thilpeh apeh jou phatnin, thilpeh hinpoho chu asolmangtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin amatah Gilgal'a song kikhena mun'a konchun akileheijin, ahenga, Vo lengpa keiman nahenga dingin guhthim thusei ding kaneije atile, aman thipmin atin ahi. Chuin akoma ding jouse chu ama-a konin achemang taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Ehud ahenga ahungin; chule ama chu amachang dingabou anei nipilai touna indan-a chun atouvin ahi. Chuin Ehud'in ahenga, Nahenga seiding Pathen'a kon thukhat kaneije ati. Hichun ama atouna-a konchun akipatdoh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Ehud'in akhut veilam ahin lhang doh-in, ajetlam pheichunga chem chu alan, a-oija adotlut tai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule achem nunga chun achemkung jong alutthan; chem chu athaovin atomin ahile aman chem chu a-oija konin asatdoh joutapon; chule a-eh ahungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin Ehud hongcha lama apotdoh-in, touna danho kotho chu akha khumin, akam khumtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama achedoh phatnin asohteho ahungun, chule touna danho kot kikam chu amuphatnun, Amahin thonlouva nipilai indan sunga akeng akikhu hinte atiuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amahon jachat umleuvin angah-un; chule veuvin, aman indan kot chu ahongtapon ahi. Hijeh chun amahon aheh hongna alauvin, ahongdoh-un; chule veuvin a pakaiyu chu tolla athisan analumin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule amaho khongai kahchun Ehud ahoidohtan, song kikhetna mun akhelin, Seirah geijin ajamdoh tan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ahitin ahi, ama ahung phatnin, Ephraim molchunga chun sumkon ahin mutnin, chule Israel chate chu amatoh mola konin ahungsuh-un, ama amasan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman amaho henga, Kanung hinjuijun: ajehchu Pakaiyin namelmao Moab mite chu nakhut nuva apehdohtai, ati. Chule amahon anung ajui suh-un, Moab mai naija um Jordan gal kulho chu alauvin, koimacha agalkaisah pouvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin amahon hiche pettah chun Moab mite sangsom tobang athat uvin, amaho chu mihat cheh le mihangsan cheh ahiuve; koimacha ahoidoh aumpon ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hitichun hiche nikho chun Moab chu Israel khutnoija suhnemin aumin ahi. Chuin gamsung chu kum somget acholngan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule amanungin Anath chapa Shamgar ahin, amapan bong sutna tengcha-in Philistine te mi jagup athatnin: chule Israelte jong ahuhdoh-in ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Ehud athi phatnin, Israel chate chun Pakai mitmun thilse abolkit taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin amaho chu Hazor mun'a vaihompa, Canaan lengpa Jabin khutnah ajohdoh tan ahi. Ajanel lamkai chu Sisera ahin, amachu Gentile ho umna Harosheth'a cheng ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Israel chate chu Pakai henga atao taovin ahi. Ajehchu aman thih-a kisem sakol kangtalai jako aneijin; chule aman kum somni Israelte chu nasatah-a asuh genthei ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Lapidoth jinu Deborah themgaonu chun hiche laija chu Israelte thu atan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amanu chu Ephraim molsanga um Ramah le Bethel kikah-a Deborah tumthing noija chu chenga ahin; chule Israel chate chu athu-u tansah dinga ahenga hungjiuva ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amanun Kadesh-napthtali'a kon Abinoam chapa Barak agakou sah-in, ajah-a, Israel Pakai Pathen'in, Tabor molsang lama chun chenlang, Naphtali chatele Zebulun chate sangsom kipuijin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule keiman Jabin gal lamkaipa Sisera chu asakol kangtalai le amihonpi to nangma heng Kidron vapidung lama kahin puiding; amachu nakhutna kapehdoh ding ahi, tia thu napeh hilouham? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Barak'in amanu henga, Nangman nei kilhonpi leh chenange; amavang nei kilhonpi lou dinga ahile kache louding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amanun, Keiman thonlouva kalhonpi ding nahi; ahivanga nakalsona lampia hi nangma dinga loupina umlou ding ahi; ajehchu Pakaiyin Sisera chu numei khat khutna ajohdoh ding ahi, ati. Chuin Deborah akipatnin Barak toh akilhonin Kadesh lama achelhontan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Barak'in Zebulun le Naphtali chu Kadesh'a akouvin; mi sangsom toh alhon touvin: chule Deborah'in alhon toupin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun Mosi nupapa Hobab chate lah-a Ken mi Heber chu Ken miho-a konin akitumse-in, Kedesh koma um Zaanaim phaichama chun ponbuh akisontan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amahon Tabor molsanga chun Abinoam chapa Barak chu achetoutai ti Sisera henga aseipeh taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Sisera'in akangtalai jouse, athih kangtalai jako geijin, chule Gentile ho umna Harosheth'a kon Kishon vapidung geija akoma um mijouse chu akhom khomin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Deborah'in Barak henga, Kipat in, ajehchu tunihi Pakaiyin nakhutna Sisera apehdoh nikho ahi; Pakai chu namasanga che hilouham? ati. Hitichun Barak Tabor molsanga konin achesuh-in, mi sangsomin anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakaiyin Barak masanga Sisera le akangtalai ho, chule aumpiho chu chemjam monghemin amaimoh sahtan; hitichun Sisera chu akangtalaija konchun akumlhan akengin ajammang tan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin Barak'in Gentile ho umna Harosheth geijin kangtalai ho le janelho chu anungdelin; Sisera sepai jouse chu chemjam monghemin alhusoh keijun, khatcha asohcha aumpouvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin Sisera chu Ken mi Heber inneipi Jael ponbuh geijin akengin ajamlutnin ahi. Ajehchu Hazor lengpa Jabin le Ken mi Heber insung kikah-a chamna uma ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Jael chu Sisera lamto dingin ahungdoh-in, Hunglutnin, ka pakai, kahenga hunglutnin, kicha hih-in ati. Chuin amapa amanu ponbuh sunga ahunglut phatnin, amanun ama chu pon akhu khumin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amapan amanu jah-a, Nahenga katao ahi, dondingin twi themkhat neipen, ajehchu kadang achah lheh-e ati. Chuin amanun bongnoi hai ahongin, amapa adonsah-in, chule akhu khumtai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amanu koma aseikitnin, Pon in kotna dingin lang, chule hiti ding ahi, mikhattou nahenga ahunga, Hikoma hi mi umam? tia nadoh ule, aumpoi tin seijin, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche jouchun Heber jinu Jael'in pon in kilna thingkil chu alan, akhutna sehtumkhat alan, ahenga kangchan achen, angeichanga chun akhenlutnin, toltoh akilmat jengin ahi; ajehchu ama acholjeh-a aihmumil hela ahi. Hitichun amapa athitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin veuvin, Barak'in Sisera ahinjui laijin, Jael chu amapa kimutopi dingin apotdoh-in, chule ahenga, Hungin, keiman naholpa chu vetsah inge, ati. Chuin amapa amanu ponbuh-a ahung phatnin, veuvin Sisera chu athisan analumin, thingkil chu angeichanga ana kiphut in ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun hiche nikho chun Pathen'in Canaan lengpa Jabin chu Israelte masanga asunemtai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Israel chate khut akhangtou chehcheh-in, Canaan lengpa Jabin asuhmang kahseovin, Canaan lengpa Jabin chu ajoupeh-un ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Deborah le Abhinoam chapa Barak in hiche nikho chun la asalhonin, hitin atilhone,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipite amaho le amaho akipehdoh uva, Israel phu alahpeh jeh-in, Pakai chu avahchoijun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo lengho, ngaijun; Vo pipuiho, nana hinsungun; kei, keimatah in Pakaiya la sangting, Israel Pakai Pathen vahchoi La kasah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai, Seir'a kona nangma nahung doh-a, Edom loujaova kona nahung kondoh chun, leiset akihot nemin, vanho apullhan, meilhang ho atuisoh gamtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Molsang ho chu Pakai masanga ajunlhan, Sinai jengjong chu Israel Pathen masanga ajunlha tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anath chapa Shamgar nikho laijin, Jael nikho laijin, Lamlhongpiho athipbeh-in, kholjinle hon lampel ajotnuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khosunga chengho aum tapouvin, Israel sunga aum tapouve; Keima Deborah kakipat doh-a, Israel sunga minu khatna kakipatdoh masangsen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amahon pathen thah ho akilhennun, chuin kotpi sunga gal anaume. Israel sangsomli lah-a lumle teng ana umam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Kalungthim hi mipi lah-a kona achamtah-a kipedoh Israel gamvaipoho lah-a aume, Pakai chu nunnom hen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Seijuvin, nangho sangan kang chunga touho, thupi tanna-a touho, chule lamdunga cheleho.
  </para>
  <para style="p">
    <verse number="11" style="v" />Atuikhainau munho-a thalkap ho thal len gina kona kihuh dohhon, chumuna chu amahon Pakai chonphatna natoh aseiphong diu, chonphatna natoh ngei chu Israel sunga akho sunguva chengho lah-a ajahsah diu; chuteng Pakai mite kotpi phunga kumsuh diu ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thouvin, thouvin, Deborah; thouvin, thouvin, la khat san: kipat doh-in, nangma Abinoam chapa Barak, chule gal hinga ki kaiho gal hingin kaijin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin aman ahingdohpa chu miho lah-a miloupiho chunga vaihomin apansah-in; Pakaiyin keima mihat ho chunga vai eipohsah-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ephraim'a konin Amalek douding amaho lah-a jung khat aumin, nangma nungin namite lah-a Benjamin; Machir'a konin gamvaipoho ahungsuh-un, chule Zebulun'a konin thil sunhon lekhamol tuhho ahungsuh-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Issachar leng chapa ho chu Daborah toh aumkhomun; Issachar jengjong, chule Barak jong aumin: ama chu kengin phaichama lama akisolin ahi. Reuben kikhentel jeh-in lungsunga lunggel lentah asohdoh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kelngoiho pen gin ngaidinga, kelngoi honlah-a ibola nangma uma nahim? Reuben kikhentel jeh-in lungsung kikholna nasatah aumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gilead chu Jordan gal langa achenge: chule Dan chu ibola kong innei sunga umden ham? Asher twipi panga aumjingin, chule abahho kah-a achengin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zebulun le Naphtali hi gam sanglam loulaija thina ginglouva ahinkholhon phaldoh-a mi ahilhone.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lengho ahungun gal ahungsatnun, Megiddo twipi pang Taanach mun'a Canaan lengho asatnun; Amahon gamthil le sum alapouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amahon van'a konin gal asatnun, ahsihon alamlhah uva konin Sisera asatnun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kishon vapidungin amaho alhoh mangun, hichu malai vapi, Kishon vapi chu ahi. O kahinna, nangman thahatna nachotpha ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujouvin sakol ho chu akihatil jeh-un, amihatpaovin ahatil jeh-un, atinhou alhong gamtan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Meroz chu samseuvin, tin Pakai vantil'in aseije, asunga chengho jouse chu nasatah-in samseuvin; ajehchu Pakai kithopi din ahung pouvin, ahat ho doudinga Pakai kithopi dingin amaho ahung pouvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Numei ho jouse chungvuma Ken mi Heber jinu Jael chu phatthei changding ahin; ponbuh-a cheng numei ho jouse chungvuma phatthei changding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amapan twi athumle amanun bongnoi apen; amanun milen kongsunga bongnoi ha ahin domin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amanun akhutnin thingkil alan, akhut jetlama natongho seh alan; seh-a chun Sisera akhenin, amanun angeichang akhet pai phatnin alu chu avochiptan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amapa amanu kengbula aboh khupmin, alhun, akijamtai: amanu kengbula aboh khupmin, alhun; abohkhupna-a chun athisan akijamtai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sisera nuchun bangkotna konin aven, avangkah-a konin apengjah-in, Ipidinga akangtalai hung geisangham? Ipidinga akangtalai kangho khongai ahidem?
  </para>
  <para style="p">
    <verse number="29" style="v" />Aloi numei chinghon adonbutnun, Henge, amanu amale ama akidonbutnin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Amaho gangjou louvu hitam? Gal thilkichom kihom louvu ham? Pasal takip dinga nungah khat ahiloule ni; Sisera dinga gal thillah jemchom chom, gal thillah kikhui pahjem chomchom, alangtoa kikhuipah jem chomchom, galthil kilahho ngonga dinga kilomho amujou louvu ahidem? ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />O Pakai, Hitichun nagalmiteu mangthah hen: ahivanginla ama ngailuho chu thahat tah-a chelai nisa banguhen. Chuin gamsung chu kum somli acholdon ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Israel chaten Pakai mitmun thilse jeng abolun ahile; Pakaiyin amaho chu Midia te khutna kum sagi apedoh tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Midia te khut chun Israelte chu ajoutan: chule Midia mite jehchun Israel chaten molsang ho-a kokhuh, leikoho, chule kuldet akisem taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ahitin ahi, Israel ten muchi atu tengule Midia miho ahung tou jiuvin, chule Amalek miho le solam chateho jongchu amaho doudin ahung tou jiuvin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amaho dounan gebuh asong jiuvin, Gaza geijin leisetna kon muchi jouse chu asuse jiuvin, chule Israelte dingin nehding himhim akhenji pouvin, kelngoiho, bongho, sanganho jong akhenji pouvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu amaho aganchahou le aponbuh-u toh hungtou jiuva, mihonpi chu khaokho banga hung kitol jiuva ahi; ajehchu amahole asangongsang hou chu simjou lou ahiuvin, gamsung sumang dinga hunglut jiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Midia mite jeh chun Israelte chu nasatah-in avaicha taovin; chuin Israel chate Pakai henga apeng taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin ahung hitin ahi, Midia mite jeh-a Israel chaten Pakai asap phatnun,
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin Israel chate dingin themgao khat ahinsol peh-in, ama chun ahenguva hitihin thu aseijin, Israel Pakai Pathen'in hitihin aseije, Keiman Egypt'a kona kahinpuidoh uva, nabul putnaova kona kahinpuidoh nahiuvin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Egypt mite khutna konle, nabol gentheihou khutna kona kahuhdoh uva, namasanguva kona kadeldoh-a, agamu nangho kapeh nahiuve;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule keiman naheng uva, Keimahi Pakai na-Pathen'u kahi; nanghon agamuva nachennao Amor mite pathenho chu ging hih-un, kanatin: ahinla nanghon kathu nanit pouvin ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakai vantil khat ahungin, Ophrah kho-a um Abiezer mi Joash gangpi phung noija atouvin; chule achapa Gideon chun Midia mite-a kona sel dingin lengpiga chilna-a suhlou chang achilin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakai vantil chu ahenga akilah-in, ajah-a, Nangma mihang gal hatpa, Pakaiyin naumpi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Gideon'in ama henga, Vo ka Pakai, Pakaiyin eiumpiuva ahileh, hichengpihi ibola kachunguva chu-a ham? Chule kapu kapateuvin keiho henga Pakaiyin keiho Egypt'a kona eihin puidoh-u hilouham, tia anaseiju athilbol kidangho chu hoilamba hija hitam? Ahinla tun Pakaiyin eida lhaovin, Midia mite khutna eipedoh taove, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin amapa aven, hitin aseije, Hiche nathahatna-a hin konin, chule nangman Midia te khutna konin Israel nahuhdoh ding ahi, keiman kasol nahi hilouham? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman ahenga, Vo ka Pakai, iti dana keiman Israel kahuhdoh dingham? Ven, ka-insung hi Manasseh sunga dinga alhasampen ahin, chule keimahi kapa insunga dinga alhumpen kahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin ahenga, Thonlouva keiman nangma kaumpi ding nahin, chule nangman Midia mite chu mikhat tha-a natha ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman ahenga, Tu-a namitmu-a lungsetna kachana ahile, nangman nei kihoupina melchihna neimusah-in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nahenga katao ahi, nahenga kahunga thilpeh kahin choidoh-a na anga kakoi kahsen, hiche mun'a konin chedoh hih-in, ati. Chuin aman, Nahung kahse-a kana ngading nahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Gideon alutnin, kelnou khat athatnin, chule changbong chol solou ephah khat aga kangin; saphe chu pocha sunga ahengin, atwi chu bel sunga asunglutnin, gangpi phung noija aumna-a chun ahinchoijin, amapa chu apen ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pathen vantil chun ahenga, Saphe le chol solou changlhah chu lanlang songpi chungahin koijin lang, atuichu sunglhan ati. Chuin hitichun aboltai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakai vantil'in akhutna um tenggol muh-a chun saphe le cholsolou changlhah chu agah tongkhan ahileh, songpi-a konchun mei ahung kongdoh-in, saphe le cholsolou changlhah chu akamangtan ahi. Chujouvin Pakai vantil chu amitmua konin achemang tai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Gideon'in ama chu Pakai vantil ahi ahet phatnin, Gideon'in, Ohe Pakai Pathen! ajehchu keiman Pakai vantil chu kimaito tah-in kakimupi tai, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakaiyin ahenga, Lung mongin umin, kicha hih-in; nathi louding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Gideon'in Pakai dingin chua chun maicham khat atungdoh-in, hichu Jehovah-shalom asahtai. Tuni geijin Abiezer mite umna Ophrah'a aum jingin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin hiche jan mama chun ahitin ahi, Pakaiyin ahenga aseijin, Napa bongchal gol, kum sagi lhing bongchal gol nina ngei chu lanlang, napa Baal maicham chu suchimin, chule akoma um thingbom chu phuhlhun;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule hiche songpi chunga hin Pakai na Pathen dingin maicham khat sanlang, hoitah-in goltupmin, chule bongchal nina chu lanlang, naphuh ding thingbom thinga chun halvam thilpeh chu toh-in, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chujouvin Gideon'in asohte mi som apuijin, Pakaiyin ahenga aseibang chun aboltan ahi. Chule ahitin ahi, apa insung mihole khopi-a miho aginjeh chun sunnin abolngam pon, jannin abolin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin khopi miho chu jingpi tah-a ahungthodoh phatnun, veuvin Baal maicham chu ana kisulhun, chule akoma um thingbom jong chu ana kiphuh lhutan, chule Maicham kisa chunga chun bongchal nina chu ganlhaijin ana kitoh-in ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin amaho khatle khat, Hichehi koibolham? tin akidong touvin ahi. Chule amahon akholuva adoh phatnun, Hichehi Joash chapa Gideon bol ahi, tin adonbutnun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chujouvin khopi sunga mihon Joash henga, Nachapa hinpuidoh in, thitei tei ding ahi. Ajehchu aman Baal maicham asuchimin, chule akoma um thingbom chu aphuh lhun ahi, atiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Joash'in akidin tepiho jouse henga, Nanghon Baal dinga thu naseipeh dingu ham? Nanghon ama nahuhhing dingu ham? Koihile ama-a dinga thusei chanchu tu jingkah ahipet hin kithat jenghen; ama pathen ahile achungthu kisei hen, ajehchu mikhatnin amaicham asuhchim pehtai, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun aman, Baal'in amapa dounan achungthu kiseihen, ajehchu aman a-maicham asuhchim pehtai, atin, amapa chu Jerubbaal asahtai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chujouvin Midia te jousele Amalek mite chule solama chateho akikhomun, agalkaijun, Jezreel phaichama pon in asong taovin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahivangin Pakai lhagao chu Gideon chunga ahung chun, chule aman sumkon amutnin; Abiezer miho anunga ahung kikhomun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin aman Manasseh mite umna jouse-a thusep asolin, amaho anunga ahung kikhomun ahi. Chule Asher henga jong, Zebulun henga jong, Naphtali henga jong thusep asolin; chuin amaho ama kimutopi din ahung touvun ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Gideon'in Pathen henga, Nangman nasei banga kakhutna Israel nahuhdoh dinga ahile,
  </para>
  <para style="p">
    <verse number="37" style="v" />Ven, keiman tollhanga kelngoi mul kakoi ding; daitwi chu kelngoimul chungabou alhah-a, akivela leiset chungchu agotseh-a ahile, nasei banga chu kakhutna Israel nahuhdoh ding ahi tichu kahet ding ahi, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin chutichu ahitai. Ajehchu ajing jingkah matah-in athouvin, kelngoimul ho chu achom khomin, atuichu kelngoi mula kona chu ahehlhan ahile, kongkhat adimsetnin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Gideon'in Pathen henga, Kachunga lunghang hih beh-in, khatvei sehseh bou seikit inge: katao ahi, hiche kelngoi mula hin khatvei patep kit inge; tun kelngoimul chung bouchu gotsah inlang, leiset chung vang daitwi kotsah-in, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Pathen'in hiche janchun hitichun aboltai. Ajehchu kelngoi mul chung bouchu ago-in, leiset chung jouse chu dai akotnin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Jerubbaal, (hichu Gideon ahi,) le aumpi miho jouse chu jingpi tah-in athoudoh-un, Harod twikul panga chun ponbuh asongun; hitichun Midia sepai janel chu asahlam uva Moreh lhang chin phaichama aumun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin Gideon henga, Akhutnuva Midia mite kapehdohna din nalhonpi miho chu atam behseh uve, achuti loule Israelte kei dounan hoithou vintin, kakhut tah-in eihuhdoh ahi tigetnunte, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun tun chenlang mipi ho jahdin gaseiphongin, Koitobang akicha le atijachan chu, Gilead molsanga konhin kinungle loihen, tin ati. Chuin mipi-a konchun mi sangsomni le ni akinunglen, sangsom aum denun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakaiyin Gideon henga, Mipi hohi atam behseh nalaijui; Amaho hi twiphunga puilhan, chukoma chu keiman nangma-a dingin kapatep ding ahi. Chule hitiding ahi, keiman, Amahi nangma toh lhonkhom ding ahi katichan chu nangma toh lhonkhom ding; chule koi hijongle nahenga, Amahi nangma toh lhonkhom louding ahi kati chanchun, nangma toh lhonkhom louding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun aman mipi ho chu twiphunga apuilhan ahi. Chuin Pakaiyin Gideon henga, Koihile uicha banga twi chu aleija letho chanchu achoma nakhendoh ding, chutobang ma-a chu akhupma bohkhupma donho jong nakhendoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin akama akhut koija letho ho jouse chu jathum ahiuvin; mipi adangse vangchu akhupma dilsua dontho ho ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin Gideon henga, Ale-tho mi jathum hochu mangcha-a nangma kahuh hinga, Midia te chu nakhutna kapehdoh ding ahi. Adangse vangchu ama ama muncheh-a chetaohen,
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun mihon aneh dingu le asumkon cheh-u akhutnuva akichoijun ahi. Chuin aman Israel dangse chu amitakip aponbuh cheh-a asolin, hiche mi jathum ho chu aumdensah-in ahi: chule Midia mipi janel chu ama noija phaichama chun aumun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin hiche jan mama chun ahung hitin ahi, Pakaiyin ahengah, Thoudoh-in, mipi janel lah-a khun chesuh-in; ajehchu nakhutna kapehdoh
  </para>
  <para style="p">
    <verse number="10" style="v" />Amavang chesuh ding nakichatle, nasohpa Purah kilhonpin lang janel lah-a chun chesuh-in;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amahon ipi aseijiu nagajah ding ahin, chutengle mipi janel henga chesuhna dinga nakhut chu suhhatna umding ahitai, ati. Chujouvin ama asohpa Purah toh mipi janelho lah-a sepai manchah choiho umna china chun aga chesuh lhonin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Midia miho, Amalek miho, chule solam chate mipi ho chu khaokhote banga tamin phaicham lhonlhunga aumun; chule asangongsao houchu simsenglou, twikhanglen panga neldi banga tam ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Gideon ahung phatnin, veuvin, chukoma chun mikhatnin agolpa koma amang aseijin, hitin ati, Ngaijin, keiman mang khat kamatnin, ven, Midia mipi janel lah-a butunna kisem changlhah pheng ahung kilih lutnin, ponbuh geijin ahung lutnin, hichun ahinse-a ahileh asuchimtan, akilehkhup min, athalin akijamtai, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aloipan adonbutnin, Hichu Israel mikhat Joash chapa Gideon chemjam tilou imadang hiponte. Ajehchu Pathen'in akhutna Midia te le mipi janel hi apehdoh ahitai ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahitin ahi, Gideon'in mang kisei le aledohna kisei chu ajah phatnin, Pathen ahouvin, Israel mipi ho lah-a akinunglen, hitin aseije, Thouvun, ajehchu Pakaiyin nakhut uva Midia mipi janel chu apedohtai, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman mi jathum chu loithumin akhenin, akhutcheh uva sumkon khatcheh apen, chule leibel keu khatcheh, asunga thaomei kikoi leibel keu khatcheh toh apen ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman ahenguva, keima neiveuvin lang, kabol bang bangin bollun. Chule veuvin, keima ngahmun pam kahung lhun tengle hung hitiding ahi, keima bol bangbang chu nabol cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keima le kaumpi jousen sumkon kamut tengule, nanghon jong ngahmun jouse pang tinna sumkon namut uva, Pakai le Gideon chemjam, nati diu ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun jan khangkim kipat tah-in Gideon le aumpi mi jakhat chu gebuh pam chu ahung lhungun, amaho chu ngahtup ana kikhel jou pettah-u ahin; chuin amahon sumkon amutnun, akhutnuva leibel keuho chu avokeh uvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule loithumho chun asumkonnu chu amutnun, bel homho jong chu asukeh un, akhut veijun meivah ho chu adomun, akhut jetna sumkon tuh in amutnun, chuin Pakai le Gideon chemjam tin a-ao taovin, ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ngahphol kimvella chun amitakip adinna cheh uva adingun ahi. Chuin janel chu alhaijun, hatah in apengun ajammang taovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin loithumho chun asumkonu amutnun ahile, Pakaiyin mitin chemjam chu aloipa chunga achuhsah-in, mipi janel pumpi lah ngeija chun; chuin mipi janel chu Zererath'a mun'a um Beth-shittah lama le, Tabbath lama Abel-meholah gamgi geijin ajamtaovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Israel mijouse chu Naphtali'a kon, Asher akon, Manasseh'a konin akikhomun, Midia miho chu anung delun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Gideon'in Ephraim molsang jouse-a thusep asolin, ahenguva, Midia mite doudin hungsuh un, chule amaho masanga konin Bethbarah le Jordan geijin atwi neh-u chu lahpeh-un, atin ahi. Chujouvin Ephraim mijouse chu akikhom khomun, Bethbarah le Jordan geijin amaho-a konin atwi neh-u chu alah peh-un ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amahon Midia mite leng chapa ni Oreb le Zeeb chu amanun; chuin amahon Oreb chu Oreb song chunga athatnun, chule Zeeb chu Zeeb lengpiga chilna-a athatnun, Midia te chu anungdelun, Oreb le Zeeb luchang chu Jordan gallanga Gideon henga ahinpouvin ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Ephraim mihon ahenga, ibola nangin keiho neihiti bol uva, Midia mite toh kisatna nacheuva chu neikou louvu ham? atiuvin amachu nasatah-in ahouseuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman amaho henga, Nang hotoh tekah dinga tu-a keiman ipi kabol em? Abiezer theichang ga lokhom sanga Ephraim lengpiga lokhom chu phajo louham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen'in nakhut uva Midia leng chapa teni Oreb le Zeeb chu apedoh tan: keiman nang hotoh tekah dinga ipi katoh jouding ham? atin ahi. Chuin chuche aseiphatnin ama chunga lunghan nau chu adailhatan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Gideon Jordan'a ahungin, apalgalkai paijin, amale alhonpi mi jathum chu amaho nungdel nan alhadah taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman Succoth miho henga, Naheng uva katao ahi, kanung juija miho hi changlhah peovin, ajehchu amaho alhadah taove, chule keiman Midia leng teni Zebah le Zalmunna nung kadel ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Succoth leng chapate chun, Zebah le Zalmunna khutchu nakhutna umbeh hita-a, keihon nasepai ho chu changlhah kapeh dingu ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Gideon'in, Hiche jeh-a chu Pakaiyin Zebah le Zalmunna kakhutna eipehdoh phatle, keiman gamthipma lingho le khaogui lingneiho-a naphe-u kabotel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ama Penuel geijin achepeh-in, hitobangma chun ahenguva aseijin; chule Penuel'a um miho jongchun, Succoth mihon adonbutna bangu chun anadonbutnun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman Penuel miho henga aseijin, Lungmonga kahungkit tengle, hiche insanghi kasuhchim ding ahi, atin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun Zebah le Zalmunna chu Karkor munna aumlhonin, chule aumpi miho chu sangsom le sangnga ahiuvin, abonuva chu solam chate janel hon lah-a amoh ngen ahiuve. Ajehchu chemjam lamthei cheh mi sangjakhat le sangsomni athiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Gideon Nabah le Jogbehah solam sanga chengho ponbuh lampia chun achetouvin, chule janel chu aban tha gamin ahi: ajehchu amaho mongtah-a umuva ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Zebah le Zalmunna ajam phatnin, aman anung delin, chule Midia lengteni Zebah le Zalmunna chu amanin, janel pumpi chu amaimoh sahtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Joash chapa Gideon chu nisa sodoh masangin galmuna konin ahung kinungle tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Succoth mi golhang khat amanin, adongin ahile, amapan Succoth leng chapateho le, a-upahou mi somsagi le sagi geijin phatechan ahiltai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Succoth miho henga chun ahungin, chule ajah uva, Veuvin Zebah le Zalmunna, Tu-a hi nakhutna Zebah le Zalmunna khut chu umbeh hija, namite lhasamho chu changlhah kapeh diuham? tia neitaitom nao chu, atin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman khopi-a upaho chu amanin, gamthipma lingle khaogui lingnei chu alan, hicheho-a chun Succoth miho chu ahiltan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Penuel insang chu asuhchimin, khopi-a miho chu athatnin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin Zebah le Zalmunna henga, Tabor munna nathaho chu itobang mi hiuvem, atin ahi. Chuin amanin, Amaho chu nangma tobang ahiuvin, amitakip leng chapate tobang cheh ahiuve, tin adonbut lhone.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman, Amaho chu kasopite ahiuvin, kanu chapa ngen ahiuve: Pakai ahin jing bangin, nangman amaho chu nana hinghoi hile, keiman nangni hi kathalhon louding nahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman achapa masapen Jether henga, Kipatdoh inlang amani hi thatnin, ati. Ahinla gollhang chun achem adohdohpoi: ajehchu ama chapang nalai ahijeh-in akichan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin Zebah le Zalmunna'in, Nangma kipat inlang kachung lhonna hung chun; ajehchu mi ahi dungjuija, athahat jong umding ahi, atilhone. Chuin Gideon akipat doh-in, Zebah le Zalmunna chu athatnin, chule a-sangongsao ngonga um kijepnaho chu alan, ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujouchun Israel mihon Gideon henga, Nangmale nachate, chule natute geijin kachunguva vaihomin. Ajehchu nangman Media miho-a konin neihuhdoh uvin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Gideon'in amaho henga, Keima kahin, kachate ahiuvin jong nangho chunga vai kahomlou dingu ahi; Pakaiyin nangho chunga vai ahom ding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Gideon amaho henga, Keiman nangho henga ngehnom khat kaneije, mijousen agalthil chomuva kona bilba ho jouse chu keima neipeuvin, ati (Ajehchu amahon sana bilba aneiju ahi; ajehchu amaho Ishmael mi hiuva ahi).
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amahon adonbutnun, Keihon hicheho chu kipahtah-in peuvinge, atiuve. Chuin amahon pon aphaovin, ami takipmin gal thila kichomdoh bilba hochu asepkhom taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman athum sana bilbaho chu sana shekel sangkhat toh jasagi in agih-in; hicheho lah-a chu Midia lengho kivon na ngong'o, ponsandup ho, chule sangongsao hon angonguva aki-o'u khivuiho kisimtha lou ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Gideon'in thempu boitong sangkhol khat asemin, hichu ama khopi Ophrah ngeija akoijin ahi. Chuin Israelte jousen chukom mun'a chun acheuvin, noti'n apangun; hiche chu Gideon le a-insungmite dingin thang ahung sohtan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun Midia te chun kiletsahna-a aluchangu aputkit louna dingun Israel chate masanga suhnemin aumtan ahi. Chule Gideon nikho sungin gamsung chu kum somli mongtah-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Joash chapa Jerubbaal achen, a-in'a agachengtan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Gideon ama laigila kon chapa somsagi ahingin ahi. Ajehchu aman ji tamtah anei ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Shechem'a cheng athaikemnu jongchun chapa khat ahinpeh-in, amin Abimelech asah-in ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Joash chapa Gideon chu tehkem setnin athitan, Abiezer mite umna Ophrah mun'a um apa Joash vuikhuh-a chun avuitaovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin ahitin ahi, Gideon athi joujou chun, Israel chate chu akilehei kitnun, chule Baal henga noti chonin achon kitnun, Baal-berith chu a-pathen diuvin akisemuvin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Israel chate amun jouse-a agaltehou khutna kona amaho huhdoh-a Pakai a-Pathen'u chu ageldoh tapouve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Israelte anamusah phatna jouse dungjuijin jong, Gideon kiti Jerubbaal insung miho henga jong khotona amusah pouvin ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jerubbaal chapa Abimelech chu Shechem'a anu sopite henga achen, amaho akihoupin, anu pa le a-insungmi jouse henga hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Katao ahi, Shechem'a cheng mijouse jah dingin seijun, Jerubbaal chapate somsagi chun nangho chunga vai ahom chu phajo-am, ahiloule mikhatnin nachung uva vai ahom chu phajo em? Keimahi nagu-u leh naphe-u kahi tijong geldoh-un, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin anu sopiho jousen Shechem'a cheng mijouse jah-a ama chungchanga hiche thu jouse chu aseijun ahile; alungun Abimelech nung juidingin aumtaove; ajehchu amahon, Amahi isopiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amahon Baal-berith in'a konin dangka somsagi apeuvin, hiche-a chun Abimelech'in pannabei le thulahlou miho agoijin, amahon anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ama apa in Ophrah'ah achen, asopiho Jerubbaal chapate somsagi chu song khat chunga athatnin ahi. Jerubbaal chapa aneopen Jotham vangchu ahing hoijin ahi; ajehchu ama kisela ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Shechem miho jousele Millo insungmi jouse akikhomun, acheuvin, Abimelech chu Shechem'a um khompi phaichama chun lengin atungtaovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin hichu Jotham aseipeh phatnun, ama achen Gerizim molvum'a adingin, aw sangtah-in asamin, amaho henga, Shechem'a um mihon, Pathen'in nathuseiju angainadin, keima thusei hi ngaijun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khatvei chu thingphung ho achunguva leng changding thao nu dingin achedoh-un; Olive thingjeh-a, Kachung uvah vaipon pangin atiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla Olive thing chun ahenguva, Mihem le Pathen jabolna kineiji kathao hi kadalhah-a, thingphung ho chunga dopsanga umdinga kache dingham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin thingho chun theichang thing henga, Nangma hungin lang kachunguva vai hungpon atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla theichang thing chun ahenguvah, Keiman kalhum na leh kaga phatah hi kadalhah-a, thingphung ho chunga dopsanga umdinga kache dingham? ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujou phatnin thingho chun lengpigui henga, Nangma hungin lang kachunguva vai hungpon atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin lengpigui chun ahenguva, Mihem le Pathen kipasah ka ju hi kadalhah-a, thingphung ho chunga dopsanga umdinga kache dingham? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujou phatnin thing jouse chun theimi koma, Nangma hungin lang kachunguva vai hungpon, atiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin theimi chun thingho henga, Nanghon tahbeh-a nachung uva leng hidinga thao neinu uva ahileh, hungun lang natahsan naochu kalim'a hung ngam uvin: achuti louva ahile, theimi-a konhin mei hungpot doh henlang, Lebenon'a cedar thingho hi hung kavam hen, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche jehchun tun, dihtahle lung thengsela Abimelech chu lenga nalhenu ahi-a, Jerubbaal le a-insung mite chunga phatecha nabolu ahi-a, chule akhutna achandinga kilom dungjuija achunga natong nahiuva ahile,
  </para>
  <para style="p">
    <verse number="17" style="v" />(Ajehchu kapan nangho dinga gal asatna, ahinkho set toh dinga aphala, Midia miho khutna kona nahuh doh-u ahin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla nanghon tunin kapa le a-insung mite dounan nakipat doh-un, achapate mi somsagi chu song khat chunga nathatnun, chule asohnu chapa Abimelech chu nasopiu ahijeh-in Shechem miho chunga lengin nasemun ahi.)
  </para>
  <para style="p">
    <verse number="19" style="v" />Tunia hi nanghon Jerubbaal le a-insung mite chunga kitah tahle lunggiltah-a natong nahi vangule, nangho Abimelech chunga kipah unlang, amajong nangho chunga kipahhen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang chuti ahi louva ahileh, Abimelech'a konin mei hungdoh henlang, Shechem miho le Millo insung chu kavamhen; chule Shechem mihole Millo insunga konin mei hungdoh henlang, Abimelech chu kavamhen, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jotham alhaijin, ajam mangin, Beer kho-a achen, asopipa Abimelech agin jeh-in chuachun achengtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israelte chunga Abimelech'in kumthum vai apoh jouvin,
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathen'in Abimelech le Shechem miho kikah-a lhagao phalou ahinsolin; chule Shechem miho chun Abimelech chu lungthim kitahloutah-in abolun:
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichu gilou tah-a anabolu Jerubbaal chate mi somsagi ho phu chu achunguva achuh theina dingle, athisannu phu chu athatnuva pang asopipau Abimelech chunga achuh-a; chule asopihou thana dinga kithopi-a Shechem miho chunga achuh theina dinga chuti ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Shechem miho chun molchunga ama changlhi ding akoijun, chule amahon chuche lampia amaho hinhopa jouse chu achomun: chule hiche thu chu Abimelech henga akiseipeh tan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Ebed chapa Gaal chu asopihotoh ahungin, Shechem agalkaijun; chule Shechem miho chun ama chu atahsanun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin amaho loujaova apotdoh-un, alengpi theihou chu alohkhomun, achilun, kipa golnop abolun, chule a-pathen'u in'a alutnun, aneuvin, adonnun, chule Abimelech chu agaosap uvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Ebed chapa Gaal'in, Abimelech chu koi hija, chule Shechem chu koi hija, eihon ama ijendiu ham? Amachu Jerubbaal chapa hilouham? Chule avaipo chu Zebul hilou ham? Shechem pa Hamor miho chu jenuvin: ajehchu ipidinga ama ijendingu ham?
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule amahohi Pathen'in kakhutnoija aumsah hile, keiman Abimelech kalahdoh ding ahi, ati. Chuin aman Abimelech henga, Nagalsat mi supungin lang, hung doh-in, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin khopi vaipo Zebul chun Ebed chapa Gaal thusei ajah phatnin, alunghan akongjah tan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman Abimelech henga guhthimin thupo asolin, ajah-a, Ven, Ebed chapa Gaal le asopiho Shechem'a ahungun; chule vetemin, amahon nangma dounan khopi kul akai taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun tun nangma naumpi nasopi ho toh jan-in kipat unlang, loujaova chang lhiuvin;
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule hitiding ahi, jingkah-a nisa ahungso sole, nangma jingpitah-in thoudoh inlang, khopi chu nokhumin: chule ven, amale aumpiho nang douna ahung tengule, nangman aphat namu dungjuija achunguva na natohding ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Abimelech aumpiho toh jannin athouvun, chule loi li akiso-un Shechem douna-in achang pangun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Ebed chapa Gaal apotdoh-in, khopi lutna kotpi-a chun adingin; chule Abimelech le aumpiho chu akisel naova konin ahungpot doh-un ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Gaal'in miho chu amuphatnin, Zebul henga, Ven mipikhu molsang chunga konin miho ahungsuh uve, ati. Chuin Zebul'in ahenga, Molsang le-lim ho chu nangin mi-a namu hinte, atin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Gaal'in aseikitnin, Ven, lampia gamsung kimlai tah-a konin miho ahung suh-in, chule loi dangjong Meonemin phaicham ahunge ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hichun Zebul'in ahenga, Abimelech chu koi hija, amachu ijen diuham? tia nathuseina nakam chu tu-a hoilama um hitam? Hiche mihohi hilou ham nangin nataitom chu? Katao ahi, potdoh inlang, gakisatpin ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Gaal chu Shechem miho masanga achedoh-in, Abimelech akisatpi tai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Abimelech'in ama chu adelin ahile, ama masanga ajamtan; kotpi lutna geijin mi tamtah alhun, akitongkhan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Abimelech Arumah'a achengtai. Chule Zebul'in Gaal leh asopiho chu Shechem'a achen nalou diuvin anomangin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin ajingin ahitin ahi, mipi chu lou jaova apotdoh-un; hichu Abimelech aseipeh taovin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin aman mipi chu akipuijin, hopthum in ahomin, loujaova chun achang pangun, chule aveovin ahile, veuvin, mipi ho chu khopi-a kona ahungdoh-un; chuin amaho dounan akipatdoh-in, amaho chu athat tai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Abimelech le aumpiho chu amasang lamuva alhaijun, khopi lutna kotpi-a chun adingun; adang loini chun loujaova umho chu anokhumun, athatgam taovin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin Abimelech'in nilhum keijin khopi chu akisatpin; chule khopi chu alan, asunga cheng jouse chu athatnin, khopi chu asuchimin, asugoi selin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Shechem daivei insanga umhon hichu ajah phatnun, Berith pathen in'a kohomsung khatna alut taove.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin Shechem daivei insanga um mijouse akikhom khomtai tichu Abimelech ahil taovin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin Abimelech ama le aumpi mijousetoh Zalmon molsanga akaldoh-un; chule Abimelech'in akhutna heicha akichoijin, thinga konin abah alhamlhan, hichu alan, alenga apun, chule aumpiho henga chun, Ipi kabol namu bangun, kino uvin, kabol bang banghin bolun, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin mipi jouse chun Abimelech bol bang chun athingbah ding cheh-u alham lhaovin, Abimelech nung ajuijun, kohoma chun akoijun, achunguva kohom chu ahal khumun; hitichun Shechem daivei insanga umho jong chu athi taovin, amaho chu numei le pasal sangkhat tobang ahiuve.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chujouvin Abimelech chu Thebez'ah achen, chule Thebez kho dounan gebuh agasongin, ahin latan ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ahinla khopi sunga chun daivei insang dettah khat aumin, hiche sunga chun numei le pasal, chule khopi sunga um mijouse chu akikha khumun; kul chunga chun ahung kaldoh-un ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin Abimelech insanga chun ahungin, ahung satnin, meija hal dingin insang kotphung lama ahungin ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin numei khatnin sumheisong halkhatnin Abimelech luchang ahinsepmin, alugu asepkeh tan ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hichun aman agalvonpo gollhangpa chu gangtah-in akouvin, ahenga, Mihon numei tha ahi eiti lounadin nachemjam satdoh inlang neithatnin ati. Chuin gollhangpa chun asunpaijin ama athitai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin Israel miho chun Abimelech athi amuphatnuvin, amitakip ama mun cheh-a achetauve.
  </para>
  <para style="p">
    <verse number="56" style="v" />Hitichun Pathen'in Abimelech'in asopi somsagi atha-a, apa chunga akhansetna jouse chu alethuh tan ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chule Shechem miho thilse bol jouse chu Pathen'in aluchung uva akhuhpeh-in; chule achunguva Jerubbaal chapa Jotham sapsetna chu ahung lhungtan ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Abimelech nungin Issachar mi Dodo chapa, Pu-ah chaoa, Tolla chu Israel huhdohdin ahung kipatdoh-in; chule amachu Ephraim molsanga um Shamir kho-a cheng ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman kum somni le kumthum Israelte thu atanin, chuin athin, Shamir'a akivuijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ama nungin Gilead mi Jair ahung kipatdoh-in, kum somni le kumni Israelte thu atanin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule aman sanganchal chunga toucheh chapa somthum aneijin, chule amahon khopi somthum aneijun, tunichan geihin Havoth-jair akitin, hicheho chu Gilead gamsunga um ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jair athin, chule Camon'a akivuitan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Israel chate chun Pakai masanga thil gilou abolkit taovin, Baal le Ashtaroth, chule Syria pathenho, Zion pathenho, Moab pathenho, Ammon chate pathenho, chule Philistine te pathenho ajenun, Pakai chu adalhaovin, amachu jenjong ajen pouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakai lunghana chu Israelte chunga asoudoh tan, chule aman Philistine te khut le Ammon chate khutna ajoh dohtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin hiche kum-a patchun amahon Israel chate, Jordan gala um Amor mite gam Gilead'a um Israel chate jouse chu kum somle kumget sung asugentheijun, anoijuva akun sah-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chukalvalin Ammon chate chu Judah douna le, Benjamin douna, chule Ephraim insungmi douna kisatpi dingin Jordan agalkaijun; hitichun Israel ahesoh lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Israel chate chu Pakai henga apengun, Nangma dounan kachonse taove, ajehchu ka Pathen'u kadalhaovin, Baal jeng kahoutaovin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Israel chate henga, Keiman nangho Egypt mite-a kona, Amor mite-a kona, Ammon chate-a kon, chule Philistine te-a kona kahuhdoh nahilouvu ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Zidon miten jong, Amalek mite, chule Maon miten nasuh gentheijuvin; chuin kahenga natao ule, amaho khutna konin kahuhdoh-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahijeng vangin nanghon keima neidalhaovin, pathen dangho najenun ahi; hijeh chun keiman nangho nahuhdoh kit tapouvinge.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cheovinlang nanghon nakilhenu pathenho henga chun gakap taovin; amaho chun nangho nahesoh genthei naova konin nahuhdoh-u hen, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Israel chate chun Pakai henga, Keiho kachonse taove. Nangman pha nasah dungjuijin kachunguva boljengin; kataovu ahi, tuni hin nei huhdoh pou pouvun, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amahon alah uva konin gamdang pathenho chu apaimangun, Pakai chu ajen taove. Chuin Israelte gim gentheina chu athohjou tapon ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouchun Ammon chate akikhom khomun, Gilead'a gebuh asongtaove. Chule Israel chate jong akikhom khomun, Mizpeh'a gebuh asongtaovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Gilead leng chapatele miho chu khatle khat akihouvun, Ammon chate douna kisatpi dinga hung kipandoh ding chu itobang mi ham? Ama chu Gilead gama chengho jouse lamkaija pang ding ahi, atiuve.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Gilead mi Jephthah chu mihat hangsantah ahin, amahi noti chapa ahin; chule Gilead'in Jephthah ahingin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Gilead jinu chun chapate ahingin; chule ajinu chapate chu ahungkhang lennun, amahon Jephthah chu anomangun, ahenga, Nangman kapao in nalo louding ahi; ajehchu nangma hetlou numei cha nahi, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chujouvin asopiho-a konin Jephthah ajamangin, Tob gama agachengtai. Chuin pannabei miho Jephthah toh akiloijun, amatoh michomin ache jiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujou chomkhat jouvin ahung hitin ahi, Ammon chate chun Israel chunga gal ahin bolun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ahitin ahi, Ammon chaten Israel chunga gal abol phatnun, Gilead upaho chu Tob gama kona Jephthah puidoh dingin achedoh taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amahon Jephthah henga, Hungin, Ammon chate toh ikisat theina dingun, keiho gal lamkaijin hung pangin, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jephthah'in Gilead upaho henga, Nanghon neihot uva, Kapa in'a kona neikai doh-u hilou ham? Chule ibola tu-a hi nagenthei phatnuva kahenga hunga nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Gilead upaho chun Jephthah henga, Hiche jeh-a chu Ammon chateho toh kisat dinga nangma keiho to nalhona, chule Gilead'a chengho jouse chunga kalamkai uva napana dinga, nahenga hung kihei kit kahiuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jephthah'in Gilead upaho henga, Ammon chate satdinga in'a neipui kitnuva, chule Pakaiyin amaho chu ka angsunga eipehdoh-a ahile, keima nalamkai uva kapan mongding ham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Gilead upahon Jephthah henga, Nathu sei banga kabol lou uleh, Pakai chu ikah uva ahetoh hihen, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jephthah Gilead upaho toh alhonin, chule miho chun amachu achunguva vaipo dingle alamkai diuvin asemun; chule Jephthah'in hicheng thu jousehi Mizpah mun'a Pakai angsunga asei ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jephthah'in Ammon chate lengpa henga thupo ho asolin, ajah-a, Nangman keima ilo ding neiti-a, kagam sunga keima douva kisatpi dinga hunga nahim? atin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Ammon chate lengpan Jephthah thupo ho chu adonbutnin, Israel ten Egypt gama ahungdoh laijuva kagam'u Arnon'a kona Jabbok, chule Jordan geija alo jeh-u ahi: hijeh chun tun hiche gamho chu kicham delin neilepeh kit taovin, atin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jephthah in Ammon chate lengpa henga thusep mi asol kitnin:
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahenga, Jephthah'in hitihin aseije, Israel'in Moab gam alahpeh pouvin, chule Ammon chate gam jong alahmang peh pouvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin Israel Egypt'a kona ahungdoh-u chun, twipisan geijin gamthip gam ahin jotnun, chule Kadesh ahung lhungun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Israel'in Edom lengpa henga thusep asolin, Nahenga katao ahi, nagamsung neijot galkai sah-in, atin; ahinla Edom lengpan angaipeh pon ahi. Chuin hiche bangma chun Moab lengpa henga thusep asolkitnin; ahin aman jong anoppeh dehpoi. Hijeh chun Israel Kadesh'a aumdentai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin amahon gamthip lah ahin jotnun, Edom gam le Moab gam chu avelkolun, Moab gam solam sanga ahungun, Arnon gal lampanga gebuh asaovin, ahivangin Moab gam gamgi sunga ahunglut pouvin ahi. Ajehchu Arnon hi Moab gamgi ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Israel'in Amor mite lengpa, Heshbon lengpa Sihon henga thusep asolin, chule Israel'in ahenga, Nahenga katao ahi, kagam kalut theina dingin, nagam chu neipal galkaisah-in, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin Sihon'in agamsung pal galkai ding chun Israel chu atahsan pon: ahivangin Silhon'in amiteho jouse akhom khomin, Jahaz'a gebuh asongun, chule Israel akisatpi tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin Pakai Israel Pathen'in Shihon le amite jouse chu Israel khutna apedoh tan, chuin amahon amaho chu athatnuvin ahi. Hitichun Israel'in chuche gama cheng Amor mite gam jouse chu alo taovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amahon Arnon'a kon Jabbok geijin jong, chule gamthip gama kon Jordan geijin Amor mite gamsung chu alo taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun tun Israel Pakai Pathen'in Amor mite chu amite Israel masanga konchun anodoh ahitan; nangman hichu nalo dingham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangman na-pathen Chemosh'in nalo dinga napeh chu nalo louding ham? Hijeh chun Pakai ka Pathen'un kamasanguva kona adeldoh hou gamsung chu kalo dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule tu-a hi nangho Moab leng Zippor chapa Balak sanga phajo nahiuvem? Aman Israel douna kiphin kha-em? Ahiloule amaho akidoupi khah-em?
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel chu Heshbon le akholenho, Arnon le akholenho, Aroer le akholenho, chule Arnon panga khopiho jouse-a kum jathum achen laija chu? Chuche phat sunga chu ibola ana kinunglah kitlou nahim?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun keima nangma dounan kachonsepoi, nangman keima neidouhi kachunga dihlou joh nahi. Thutan Pakai chun tunikho hin Israel chate le Ammon chate kikah-a thu tanhen, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin Ammon chate lengpan Jephthah'in ahin misol ahinsola thu asei chu ngaipeh-in aneipon ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chujouvin Pakai Lhagao chu Jephthah chunga achun, chule ama Gilead le Manasseh agalkaijin, Gilead gama Mizpeh agalkaijin, chule Mizpeh'a um Gilead gama Mizpeh'a konin Ammon chate umnalam ajonin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Jephthah'in Pakai henga kihahsel na-in akihahselin, chule hitin aseije, Nangman Ammon chate chu kakhutna thonlouva neipehdoh-a ahile,
  </para>
  <para style="p">
    <verse number="31" style="v" />Hitiding ahi, Ammon chate-a kona lungmonga kahung kilekit tengle, eikimutopi dinga kakotna kona hungpotdoh masapen chu thonlouva Pakaiya hiding, chule keiman govam thilto-a katoding ahi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hitichun Jephthah chu Ammon mite satdingin ahenglam uva achen; chule Pakaiyin amaho chu akhutna apedoh tan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin aman amaho chu Aroer'a kipat in Minnith changeijin athatpeh-in, khopi somnijen, chule lengpilei phaicham geijin hathan athattan ahi. Hitichun Ammon chate chu Israel chate masanga suhnemin aumun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jephthah Mizpeh kho-a a-in'a ahungin ahile, veuvin, achanu ama kimupi din khongcha beng pumle lam pumin ahungdoh-in ahi. Amahi chanu changkhat seh ahin; amanu tailou hi chapa le chanu dang aneilou ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin ahitin ahi, aman amanu amuphatnin, apon abotkeh-in, Kaden Kachanu! nangman keima neisunem lheh-in, chule nangma hi eisugimho lah-a khat nahitai. Ajehchu keima Pakai henga kana kamkatan, chule kih theilou ding kahitai, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin amanun ahenga, Hepa, nangman Pakai henga nakam nanakat ahitah-a ahile, nangman nakama nana phondoh bangbang chun kachunga boltan; ajehchu Pakaiyin nagalmite Ammon chate chunga phu nalahpeh ahitai, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin amanun apa henga, Hichehi keima dingin neibol peh-in, Molsang chung dunga kachesuh kachetouva, kagol hotoh nungah theng kahina pul kagadou nadiuvin, lhani neichang lhan, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin aman, Chen, ati. Hitichun aman amanu chu lhani sunga dinga asolmang tan ahi. Chuin amanu aloiho toh achen, molsang chungho-a chun nungah theng ahina pul chu agadou tan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin lhani nungin ahitin ahi, amanu apa henga ahung kinunglen, aman akitepna bangin amanu chunga atongtan: chule amanu pasal to akitimat pon ahi. Chule hichehi Israelte chonna dan ahung hitan,
  </para>
  <para style="p">
    <verse number="40" style="v" />Hitichun Israel chanute chu Gilead mi Jephthah chanu lunghempi nan kumseh leh nili achedoh jiuvin ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Ephraim miho chu akikhom khomun, sahlama acheuvin, Jephthah henga, Ipijeh-a Ammon chate kisatpi dinga nahung galkaija, chule ibola naki lhonpi dinga neikou lou uham? Na inpuma kahal khum dingu nahi, atiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jephthah ahenguva, Keima le kamite Ammon chateto hatah in kakisat nun, kahinkou laijun akhut uva konin neihuh doh pouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin neihuhdoh louvu kahet phatnin, kahinkho kaki choithon, Ammon chate kisatpi din kagalkaijin, Pakaiyin amaho chu kakhutna eipehdohtan ahi. Achutile ibola tunia hi keima to kisat dinga nahung kon uham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jephthah'in Gilead mihojouse akhomin, Ephraim toh akisat tai. Chule Gilead mihon Ephraim miho chu athat taove; ajehchu amahon, Nangho Gilead mite hi Ephraim'a kona jammang, Ephraim mite le Manasseh mite lah-a kona jam mangho nahiuve, atijiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Gilead miho chun Ephraim miho lhun masanga Jordan galkainaho chu ana laovin: chule ahung hitin ahi Ephraim mite ahung jamdoh hochun, nei galkai sah-un ati tengule; Gilead miho chun ahenguva, Nangma Ephraim mi nahim? tin adong jiuvin; amahon, Kahipoi, ati-a ahile,
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon ahenga, Chuti ahile Shibboleth gah ti-in ati jiuvin: chuteng aman Sibboleth ati jin ahi; ajehchu dihtah-a aseidoh thei jilou ahi. Chuteng amahon amapa chu aman jiuvin, Jordan vadung lampia chun athat jiuvin ahi. Hitichun hiche chunga chun Ephraim chu mi sangsomli le sangni athatnun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Jephthah'in Israelte chunga kumgup thu atanin ahi. Chujouvin Gilead mi Jephthah chu athitan, chule Gilead khopi ho sung khatna akivuitan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ama nungin Bethlehem'a um Ibzan'in Israelte thu atanin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman chapa somthum le chanu somthum aneijin, aman hiche achanute chu gamdanga asolin, chule achapate dingchu gamdangmi chanu somthum apuipeh-in ahi. Chule ama Israelte chunga kum sagi thutanin apangin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chujouvin Ibzan athitan, Bethlehem'a avuitaovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amanungin Zebulun mi Elon'in Israel chate thu atanin; chule aman Israelte chunga kumsom thutanin apangin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Zebulun mi Elon athitan, chule Zebulun gamsunga um Aijalon mun'a akivuitan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule amanungin Pirathon mi Hillel chapa Abdon chu Israelte thutanin apangin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman chapa somli leh tu somthum aneijin, sangan gol somsagi chunga atouvin ahi. Aman Israelte chunga kumget thu anatanin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pirathon mi Hillel chapa Abdon athitan, Ephraim gama Amalek mite molsanga um Pirathon munna akivuijin ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israel chaten Pakai mitmun thilse abolkit taovin ahile, Pakaiyin amaho chu Philistine te khutna kum somli apedohtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichelai chun Zorah kho-a Dan phunga kon Manoah kiti khat anaumin; chule ajinu chu aching ahin, chaneilou ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakai vantil chu numeinu henga chun ahung kilah-in, amanu henga, Tun vetemin, nangma achinga nahin, cha nahingpoi; ahinla nangman nao nahinvop ding, chule chapa khat naneiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Katao ahi, hichejeh chun chingtheijin, ju le khamnathei donhih-in, chule thilthenglou kiti poupou jong nehih-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu vetan, nangma gaijin natin, chapa khat nanei ding; aluchanga samchem kilam louding ahi. Ajehchu naosen chu naobu-a kon Pathen'a dinga Nazir hiding ahi. Chule ama chun Israelte chu Philistinte khutna kona ahuhdoh patding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin numeinu chu ahungin ajipa henga, Pathen mi khat kahenga ahungin, amaiso chu Pathen vantil maisotoh abangin, Kichat aumlheh-e; ahinla keiman hoija hungkon nahim tinjong kadongpon, chule aman jong kahenga amin eiseipehpoi:
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin aman kahenga, Ven, nangman nao navopding, chapa khat nanei ding ahi; chule nangman tun ju le khamna thei donhih-in, thilthenglou kiti poupou jong nehih-in: ajehchu chapang chu naobu-a kona athini geija Pathen'a dinga Nazir hiding ahi, tin aseije, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Manoah Pakai henga ataovin, hitin aseije, Vo ka pakai, nahinsol Pathen mipa chu kakom lhona hungkit henlang, ahung pengding chapang chunghi ipi katohlhon dingham eihung hil lhonhen, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pathen'in Manoah aw chu angaipeh-in; amanu loujaova atouna-a Pathen vantil chu amanu henga ahung kitnin; ahinla ajipa Manoah chu amatoh anaumpon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin numeinu chu mangang tah in alhai jel-in, ajipa chu agahilin, ahenga, Ven, nikhat ni-a kahenga hung kilah mipa chu kahenga ahung kilah kitne, agati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Manoah akipat doh-in, ajinu nung ajuijin, mipa koma chun ahungin, ahenga, Nangma hiche numei to kihouva chu nahim? ati. Chuin aman ahenga, Kahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Manoah'in, Tun nathuseiho chu hung guilhung hen. Chapang chu iti kakhou khah lhona, chule achunga ipi kabol lhon dingham? ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakai vantil chun Manoah henga, Numeinu henga kasei jouse bangchun amanu kichih thei hen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanun lengpi guija kona kisem ipi thil hijongle nehda hen, chule ju le khamnathei jong dondahen, chule thilthenglou kiti poupou jong nehdahen: kathupeh jouse chu amanun juihen, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Manoah'in Pakai vantil henga, Nahenga katao ahi, keinin nang dinga kelnou khat kagagot lhon kahsen neiumpeh lhonin, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakai vantil chun Manoah henga, Nangman nei khongaisah jongle chun keiman nachanglhah neponge: chule nangman govam thilto nato dinga ahile, Pakai henga nato ding ahi, ati. Ajehchu Manoah'in amachu Pakai vantil ahilam ahetlou ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Manoah'in Pakai vantil henga, Nathusei aguilhun tengle nangma kajolbol theilhon na dingin, namin ipiham neisei peh-in, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pakai vantil'in ahenga, Akiselguh ahi munasa-a, ibola hitachu kamin neidoh ham? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun Manoah'in kelnou khat chu anneh thilto toh alan, songchung khatna Pakai henga atoh doh-in ahi. Chuin vantil chun kidang tah-in abolin, Manoah le ajinun hichu avelhonin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu ahung hitin ahi, meikou chu maichama kona van lama alentou chun, Pakai vantil chu maicham meikou lah-a chun alengtou tan ahi. Chuin Manoah le ajinun hichu avelhonin, amailhon tolla asulut lhontan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin Pakai vantil chu Manoah le ajinu henga akilahkit tapoi. Hichun Manoah'in Pakai vantil ahichu ahedohtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Manoah'in ajinu henga, Eini thonlouva ithitei lhonding ahitai, ajehchu einin Pathen imulhontai, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla ajinun amahenga, Pakaiyin eini eithanom lhona ahile, govam thilto le neh thilto chu eini khutna kona akisan louding, chule hicheho jouse jonghi eivetsah lhon louding, chujongle tuphat tah-a hi hitobang thilho jong hi eiseipeh lhon lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin numeinu chun chapa khat ahingin, Samson asahtai. Chuin chapang chu ahung khangin, Pakaiyin phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Zorah le Eshtaol kikah-a Dan gebuh-a chun Pakai lhagaovin achunga na atong pantan ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Samson chu Timnah'a achesuh-in, chule Timnah'a chun Philistine te chanuho numei khat amun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama ahung touvin anule apa henga aseijin, hitin ati, Keiman Timnah'a Philistine te chanuho numei khat kamui: hijeh chun amanu chu kaji dingin gapui lhonin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche phatchun anule apan ahengah, Nasopi ho chanute ahiloule kamite jouse lah-a numei umlouhel hija, cheptanlou Philistine te kichenpi ding nagot ham? atilhonin ahi. Chuin Samson'in apa henga, Amanu neipui peh-in; ajehchu amanun kalung atoh lheh-e, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Achuti vangin anule apan hichu Pakaiya kon ahi le, aman Philistine te douna-a phat gomkom ahol ahi chu ahelhon pon ahi. Ajehchu hiche petna chu Philistine ten Israelte chunga vai ahomu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin Samson anule apa toh Timnah'a achesuh-un, chule Timnah kho lengpi leilai ahung lhung taovin: chuin veuvin, keipi bahkai golbep khatnin ahin ngih tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakai Lhagao chu thanei tah-in achunga ahung chun ahile, aman kelnou alhetel bangin, akhutna imacha choilouvin abottel tan ahi. Ahinla aman athilbol chu anule apa henga aseidoh pon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin ama achesuh-in, numei chutoh akihoulimin; chule amanun Samson alunglhaisah lheh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin phat chomkhat jouvin amanu puidingin ahung kilekitnin, akeipi bahkai thasa longchu ve dingin akiheijin ahile; veuvin, keipi bahkai long sunga chun khoilhah anakaijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman akhutnin alan, alamjot pumin anen, anule apa koma ahungin, amani jong apen, chule amanin jong anelhonin ahi. Ahinla hiche khoiju chu keipi bahkai thilong sunga kona alah ahi chu anule apa aseipeh pon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun apachu numeinu koma chun achesuh tan ahi. Chuin Samson'in chukhoma chun golvah abolin ahi; ajehchu gollhang hon hitia chu abolngai mong ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, amahon ama amuphatnun, ama koma umdingin loi somthum ahinpuijun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Samson'in ahenguva, Keiman naheng uva thuchih khat kasei ding: hiche chu nanghon golvah nisagi sunga neihilchen theijuva, nahetdoh uva ahile, keiman nangho ponsil somthum, chule kikhelna von somthum kapeh dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amavang neihilchen theilouvu leh, nanghon ponsil somthum le kikhelna von somthum neipeh dingu ahi, ati. Chuin amahon ahenga, Nathuchih chu seijin, keihon ngaijuvinge, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman amaho henga, Mi ne-a konin nehding ahung potnin, thahat tah-a kona thil lhumtah ahung potne, ati. Chuin amahon nithum geijin thuchih chu ahedoh thei pouvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin nisagi nin ahitin ahi, amahon Samson jinu henga, Hiche thuchih hi eihil chetna dingun najipa jolin, achutiloule nangma le napa inhi meija kahal dingu ahi: nangman kanei hou lahpeh dinga neikouvu ham? Hiti chu hilouham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Samson jinu chu ahenga akapmin, hitin aseije, Nangman nei ngailut ahipon, neihot joh ahi: Nangman kamite henga thuchih nadongin, keima neiseipeh poi, ati. Chuin aman amanu henga, Ven, keiman kanu kapa koma jong kaseilou ahin, hiche chu nangma koma kasei ding ham? ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin agolvah-u kibol sungse, nisagi ni chun amanu a-angsunga akapkap jengtan ahi. Chuin ni sagi nin ahitin ahi, amanun aha ngeh behseh jehchun aseidoh pehtan ahi. Chuin amanun thuchih chu amite chateho henga aseipeh tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ni sagi ni nisalhum masangin khopi-a cheng pasal ho chun ahenga, Khoiju sanga lhumjo ipiham? chule keipi bahkai sanga hatjo ipi ham? atiuvin ahi. Chuin aman amaho henga chun, Kabongla-a hi lou nakai louvu hile, kathuchih hi hedoh pouvin nate, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakai Lhagao achunga ahungchun, ama Ashkelon'a achesuh-in, mi somthum athatnin, avonhou chu ahinlan, athuchih aseidohho henga chun kikhelna von somthum chu apetan ahi. Chuin alunghan akoujah-in, apa in lama achetou tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Samson jinu chu agolpa, agolpha pena aneipa henga chun ape taovin ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla chomkhat jouvin ahung hitin ahi, suhlou chang atlaijin, Samson'in kelnou khat apon ajinu agavilin; chule, Indan sunga kajinu henga kagalut ding ahi, ati. Ahin ajinu pa-in alutding aphalpon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ajinu pan, Keiman najinu nahot mongmonga kangaito ahitan; hijeh-a chu naloipa kapeh ahitai. Anaonu hi ama sanga hoijoa hilouham? Nahenga katao ahi, amanu khelin kipuitan, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Samson'in amaho chungchanga hitin aseitai, Tun keiman amaho chunga mona boljong leng Philistine mihon a-engkhan eihisah thei pouvinte, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Samson achen sial jathum amanin, ameiju akan matnin, meisel phabep alan, amei le amei kikah-a chun akanmat pehtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin meisel ho-a chun mei atih-in, Philistine te changphung dinglah-a alhalut nin ahile, changphal le changphung dinglai ho, lengpilei le Olive thing jouse geijin akamangtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Philistine ten, Hichehi kon abol ham? atiuve. Chuin amahon, Timnah tupa Samson bol ahi, ajehchu aman ajinu alahpeh-a aloipa apeh jeh ahi, tin adonbut uve. Chuin Philistine te ahungun, amanu chule apa chu meijin ahal lih taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Samson'in amaho henga, Nanghon hiche nabol jeh uva hi, keiman nachung uva phu kalah ding ahi, hichu kabol chaiteng umthim bepding kahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman amaho chu khotona beijin mitamtah athatnin; chule achesuh-in Etam songpi vuma agacheng tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Philistine te achetouvun, Judah gamsunga gebuh asonguvin, chule Lehi mun'a chun akithe jalun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Judah miten, Ipi bola keiho douna-a hunga nahiuvem, atiuve. Chuin amahon adonbutnun, Samson kantum dingle, kachung uva abol bang banga achunga bol dinga hungtouva kahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin Judah mi sangthum Etam molsang songpi chunga chun achetouvun, chule Samson henga, Philistine hi eiho chunga vaipo ahiuve ti nahetlou ham? Chule nangman kachunguva nabol pihi ipi ham? atiuve. Chuin aman amaho henga, Ka chunga atoh bang banguva chu keiman jong amaho chunga katoh ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amahon ama henga, Keihon nangma Philistine te khutna kapehdoh theina dinguva, nangma kantum dinga hunga kahiuve, atiuve. Chuin Samson'in ahenguvah, Nangho tah-in neitha louna dingun kahenga kihahselun,atin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amahon ahenga, Ahipoi, keihon nangma kakanchah uva, amaho khutna kapehdoh dingu ahibouve; keihon nangma nathat pouvinge, atiuve. Chuin amahon amachu khao thahbet nin akanun, song chunga konchun ahin puidoh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule ama Lehi mun ahunglhun phatnin, Philistine te chu ama dounan hatah in a-aovun ahi. Hichun Pakai Lhagao thanei tah-in achunga ahung chun ahile, akhut kikanna khaoho chu meija kihaltan abang jengin, akhutna konin akikan naho chu alhamang tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman Sangan khagu thahbet khat amun, hichu alan, hiche-a chun mi asang asang avolihtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Samson'in, Sangan khagu mangchan, athop athopmin kavolhun, Sangan khagu mangchan, mi sangkhat kathatnin ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahung hitin ahi, aman thu aseijouvin, sangan khagu chu akhutna konin apaimangin, hichemun chu Ramath-lehi asahtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ama hatah-in adang chahtan, Pakai hengah ataovin, hitin ati, Nangman nasoh khutna hi hitobang lhatdohna nasatah hi napeh ahitan; tu-a hi dangchah-a kathi-a, cheptan louho khutna hi kalhuh ding ham? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Pathen'in Lehi mun'a chun komtong apokehsah-in ahile, chu-a kon chun twi ahung longdoh-in; chule aman adonphatnin, alungthim ahatdoh kitnin, ahaldoh kit tai. Hijeh chun hiche mun chu En-hakkore asah tan, hichu tuni geijin Lehi mun'a aum jingin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman Philistine te nikho laijin Israelte chunga kum somni thu anatanin ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Samson Gaza'ah achen ahile numei kijoh khat amun, amanu henga chun alut tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Gaza mite henga, Samson hilama ahunge, ti aseipeh taovin ahi. Chuin amahon a-um na munm chu a-umkimvelun, chule jan khovah keijin khopi kotpi-a chun achanguvin, jan khovah in thipchetnin aumun, Jingkah kho ahungvah vahleh itha dingu ahi, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Samson khangkimgei alumin, khangkimin athoudoh-in, khopi kotpi kotkhahle akhom tenitoh abotdoh-in, abonchan alengkouva apun, Hebron maijona um lhangvum khatna apudoh pehtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hiche nung chun ahitin ahi, aman Sorak phaichama numei khat amin Delilah kitinu chu adeicha tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Philistine vaipoho chu amanu henga ahungun, ahenga, Amapa hi kakan tum uva achunga kachuh theina dingun, iti achunga tha kanei thei dingu ham ti hetdohna dingin, amapa khu anajolin lang, athahatna nasatah khu hoija umham ana hedoh-in: chule keiho mikhat cheh-in nangma dangka sangkhat le jakhat kapeh dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Delilah'in Samson henga, Nahenga katao ahi, nathahatna nasatah hi hoija uma hija, chule nangma suhgentheina dinga hi ipi-a naki kan dingham? neiseipeh temin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Samson'in amanu henga, Ago khalou khaogui hing sagi in eikanleo, keima lhasam tangting, midangho bang bang kahi ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche phatchun Philistine vaipohon chun amanu henga, ago khalou khaogui hing sagi ahinchoijun, chule amanun hicheho-a chun akanin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun mi phabepmin ama chu achang lhiuvin, indan sunga chu amanu toh uma ahiuve. Chuin amanun ahenga, Samson, Philistine te nachunga chuding ahi taove, ati. Chuin aman khaoguiho chu patdum kipheh meija kihaltan bangin abottan jengtan ahi. Hitichun athahatna chu hetdoh ahipon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Delilah'in Samson henga, Ven, nangman neidai chavaijin, jouvin neilheme. Tu-a hi katao ahi, ipi-a nakikan tum thei dingham? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman amanu jah-a, amahon mi kikanna khahlou khao thahbet-a eikan leu, kalhahsam ding ahitan, chuteng midangho bang bang kahi ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun Delilah'in khao thahbet alan, Samson chu akanin, ajah-a, Samson, Philistine te nachunga chuding ahitaove, atin ahi. Chule mi phabepmin indan sunga achanlhih jingu ahi. Chuin aman hicheho chu patjang kibot tan bangin akhutna konin atumtan tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Delilah'in Samson henga, Tuni geihin nangman neidai chavaijin, jouvin nei lheme: ipi-a kikan ding nahim, neihilin, ati. Chuin aman, Nangman kalua kasam pheh sagi hi hehkople chun, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman ahehkopmin akildet chetnin, ahenga, Samson, Philistine te nachunga chuding ahitaove, ati. Chuin ama a-imutna konin athoudoh-in, asam lom kihehkop leh akilna chu abotdoh tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amanun ahenga, Nalungsung keima koma umlouva, nangman kalungsetne iti neitithei ham? Nangman hiche thumvei neidai chavaijin, nahatna nasatah hi hoilaija umham neiseipeh poi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahitin ahi, amanun aniseh-a angah jinga, adoh jing phatnin, amapa thiding khopmin alung gimtan ahileh;
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun alungthim jouse amanu henga aseijin, hitin ati, Kalu chunga samchem kipan khalou ahi; ajehchu keima kanu oisunga patna Pathen'a dinga Nazir mi kahi. Kasam akivo chaija ahile kahatna keija kona chemanga, kalhahsam ding, midangho bang bang kahiding ahitai, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Delilah'in amapan ahenga alungsunga um jouse aseidoh chu amuphatnin, Philistine vaipoho koudingin mi asolin, ajah uva, Khatvei hungtou kitnun, ajehchu aman alungsunga um jouse eiseipehtai, ati. Chujouvin Philistine vaipoho chu ahungun, akhutnuva sum jong ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amanun amapa chu apheipi chunga alupsah-in a-imutsah-in; asam voudingin mi akouvin, alua lom sagi-a asam kikan chu avolhah pehtan ahi. Chuin amanun asugim panin, chule athahatna chu ama-a konin achemang tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amanun, Samson, Philistine te nachunga chuding ahi taove, ati. Chuin ama a-imutna-a konin ahung thouvin, chule, Nidang bangin chedoh ingting, kithing lhange ati. Ahinla Pakaiyin ama adalhah chu ahepon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla Philistine ten amanun, amit teni akaldoh-un, Gaza'a apui lhaovin, sum-eng henkol abupeh-un; songkul inna sumhei goijin apangtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla alu-a asam chu akivotol nungin ahung khangpan kit tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujou phatnin Philistine vaipoho chu a-pathenu Dagon henga kilhaina loupitah bola, kipa thanop boldingin akikhom khom taovin ahi. Ajehchu amahon, I-pathen'u hin imelmapao Samson hi ikhutnuva eipehdoh-u ahi, atiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin mipin ama amuphatnun a-pathen'u chu avahchoijun ahi. Ajehchu amahon, I-pathen'un imelmapao, chule eiho tamtah eithatnuva, igamsungu sumangpa hi ikhutnuva apehdoh ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin ahitin ahi, amaho alungthimu akipa phat chun, Vetnom um eibolpeh diuvin Samson gakouvun atiuvin ahi. Chuin amahon songkul in'a konchun Samson agakouvun, chule aman amaho dingchun vetnom um abolpehtai. Chuin amahon amachu khom lentah ni kah-a adinsah-un ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Samson'in akhut kaile-a pang chapangpa henga chun, Inpi kingapna khom teni chu kaki ngainadin neituh sah-in, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tun in chu numei le pasal dimsetna ahin, chule Philistine vaipoho jouse chu umsoh keijuva; Chule in chunga chu Samson vetnom um bol vedinga numei pasal mi sangthum jen uma ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Samson Pakai henga ataovin, Vo Pathen, Philistinte chunga khatvei sehseh kamit teni asuhchotnao phu kalah theinadin; Vo Pakai Pathen, katao ahi, neigel doh-in, chule katao ahi, tu khatvei sehseh hi katha hatsah-in, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Samson'in inpi douva pang, alaija inpi kidouna khomteni chu atuh-in; chule khatna chun akhut jetlam angamin, khat joh-a chun akhut veilam angamin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Samson'in, Philistine mite hito thitha tange, atin ahi. Chuin aman athahat jouse-a asonin ahile, inpi chu vaipoho jouse le asunga umho jouse chunga chun achimtan ahi. Hitichun hiche athinia amitha chu ahinlaija atha sangin atamjon ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chujouvin asopitele apa insung mite ahungsuh-un, along chu alauvin, ahin potouvun, Zorah le Eshtaol kikah-a apa Manoah lhankhuh-a chun avui taovin ahi. Aman Israelte chunga kum somni thu anatanin ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Ephraim molsanga chun Micah kiti mikhat aumin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman anu henga, Nangma-a kona dangka shekel sangkhat le jakhat kiladoh, nana gaosap khum, chule keima jah-a jong nanasei chu, ven, hiche dangka chu kakoma aume; keima lah ahi, ati. Chuin anun, Kachapa, Pakaiya phattheiboh changin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman anu koma dangka shekel sangkhat le jakhat chu anungpeh phatnin, anun ahenga, Milim kilha le kikheng semna dinga keiman kakhutna kon kachapa dinga dangka chu Pakaiya kapehdoh ahitai: hijeh-a chu tu-a hi nangma koma kapehdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin sum chu anu henga alepeh-in ahi. Chuin anun dangka shekel jani chu alan, dangka khengpa apen ahile, aman hiche-a kon chun milim kilha le milim kikheng asemin; chule hicheho chu Micah in'a umin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Micah kitipa chun pathen ho inkhat aneijin, thempu boitong sangkhol le milim houna asemin, chule achapate lah-a khat chu athenso-in, amachu thempun apangin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche laichun Israel ten leng aneipouvin, ahinla mijousen ama mitna dih asah chanchu aboljengu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Judah gam Bethlehem'a kon Judah insungmi gollhang khat aumin; ama chu Levi mi ahin, chule chukoma chu khopema ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hichepa chun chen nading mun amu muna-a cheng dingin Judah gam Bethlehem khopi chu ahin dalhan ahi. Chuin ama akholjin lena lamin, Ephraim molsanga um Micah in chu ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Micah'in amapa henga, Hoija kona hung nahim? ati. Chuin aman ahenga, Keima Judah gam Bethlehem'a kon Levi mi kahin, chule chen nading mun hola kholjin le-a kahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Micah in ahenga, Keima toh chengkhomin, chule keima dingin pa le thempu-in pangin, chule keiman kumkhatna dangka shekel som, von tokhat, chule nehle chah kapeh ding ahi, ati. Hitichun Levi mipa chu achengtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Levi mipa chu mipatoh umkhom dingchu anomtan, chule gollhangpa amapa dingchun achapa khat tobang ahitan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Micah chun Levi gollhangpa chu athenson, chule gollhangpa chu athempun apangin, Micah in'a chun aumin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin Micah'in, Tun Levi mikhat thempu-in kaneitan, Pakaiyin kachunga thilpha abolding ahi ti kahetai, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche nikho laichun Israelte lah-a leng aumpoi. Chule hiche nikholai machun Dan mite chenna ding gam aholun ahi; ajehchu hiche nikho geija chu Israelte phung lah-a amaho gamlo ding aumloulai ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Dan chate chun aumnao mun Zorah le Eshtaol kho-a konin a-insungmiu pasal hangsan cheh mi nga gam velhi dingle gamhol dingin asolun; ajah uvah, Cheovinlang gamchu gakholun, atiuve. Hichun Ephraim molsanga um Micah in'a chun aga lhungun, hia chun ageh taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho Micah in'a aumlaijun, amahon Levi gollhangpa chu a-awso-a konin aheuvin; aheng lama akiheijun, ajah-a, Kon hikoma hi nahin puilut ham? Chule hikoma hi ipi nabol ham? chule hikoma hi ipi naneijem? atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman ahenguvah, Micah'in hiti khati hin eibolin, eigoijin, chule athempua kapan ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amahon ahenga, Nahenga kataovu ahi, kachenao lampia hi kakhantou kakhantou lou dingu kahet theina diuvin, Pathen neidoh peh-un, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin thempupa chun ahenguvah, Lungmong tah-in cheovin, Pakaiyin nachenao lampia naumpi naove, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujouvin mi ngaho chun akipat doh-un, Laish kho-a ahung lhungun, hichea chengho Sidon miho bang banga-a chamdela, mongtah le bit keija achenu chu amuvin; chule hiche gama chun ipi lama hijongle ajachatnau boldoh pehding lamkai aneipouvin ahi. Chule amaho Sidon mite-a konin agamlauvin, chule koimato jong kigui jopna anei pouvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amaho Zorah le Eshtaol'a sopite henga ahungun: chule asopiho chun ahenguva, Ipi seithei nanei uvem? atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amahon, Amaho doudinga ikontou theina dinguvin, kipat un: ajehchu keihon gamchu kagam'u uvin, chule veovin, gamphatah ahi. Ima nabol got louvu ham? Chu gama cheding le galut ding chule galo ding thase hih-un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangho nache tengule, mongtah-a cheng miho kom le gam lentah nalhun dingu ahi. Ajehchu Pathen'in leisetna thil um jouse lhahsam louna mun chu nakhut uva napeh-u ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Zorah le Eshtaol kho-a konchun Dan insung mite mi jagup chu manchah pumin ahung kondoh-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amaho achetouvun, Judah gam Kirjath-jearim'a gebuh asongtaove. Hijeh chun hiche munchu tuni geijin Mahaneh-dan asah-un ahi. Veovin hichu Kirjath-jearim nunglama uma ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amaho chua konchun Ephraim molsang lam ajonun, Micah in ahung lhung taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin Laish gam velhia che mi ngaho chun adonbutnun, asopiho henga, Nangho hiche inho-a hi thempu boitong sangkhol, milim ho, milim kilhah le, milim kisoltho aume ti nahet uvem? Hijeh chun tun ipi nabol dingu ham ngaitouvin, atiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amaho chulama chun akiheijun, Levi gollhangpa umna in, Micah in geija chun ahungun, ama chu chibai aboh-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Dan insungmi galvon kivona mi jagupho chu kotpi-a chun adinguvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin gam velhia mi nga chu ache touvun, hilama chun ahung lutnun, milim kisemthu, boitong sangkhol, milimho, milim kilhajolho chu alauvin, chule thempupa chu galvonna kivon mi jagup ho toh kotpi phunga chun adingun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amaho Micah in'a acheuva, milim kisemthu ho, thempu boitong sangkhol, milimho, akisoltho milim ahin lah-u chun, thempupan amaho henga , Ipi bola nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahon ahenga, Thipbeh-in, nakhutnin nakam kihupmin lang, kanungu hinjuijin, chule keiho dingin pa le thempu-in pangin. Nangma dinga mi khatseh insunga thempu-a panding phajo-am, ahiloule phung khat le Israel insung khat chunga thempu-a pan phajo-am? atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin thempupa lungsung chu akipah lheh-in, thempu boitong sangkhol, milimho, chule akilhahtho milim chu alan, mipi lailunga chun achetan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun amaho akiheijun, akipat doh-un, chule amasanguva chapangho le ganchaho achesah-un ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Micah in'a kona gamla thimtah agei phatnun, Micah invela miho chu akikhom khomun, Dan miho chu adelpha taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amahon Dan chate chu agah samun ahi. Chuin amaho Micah heng lama chun akiheijun, ahenga, Ipin nabola hitobang mihonpi toh nahung ham, atiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman, Nanghon keiman kakisem ka-pathen le kathempu nakilah uvin nachemang taove. Chule ken idang kanei nahlai ham? chule nanghon kahenga, ipin nabol ham, natiu chu ipi nasei nao ham? ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Dan chate chun ahenga, Kalah uva na awgin kijah sah hih-in, achuti loule alunghangho nachunga hung chuntin, nahinkho le na-insung pumpi manlo ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Dan chate chu alampiuva achemang taove, chule Micah'in amaho chu ama dinga ahatvalu chu amu phatnin, akinunglen a-in lama achetai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin amahon Micah thilsemho le athempupa chu ahin laovin, mongtah le bitkeija cheng mite umna Laish kho chu ahunglhung taove. Chuin amahon amaho chu chemhemin athatnun, khopi chu ahallha taove.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho Zidon'a kona gamlatah ahijeh ule, koimatoh kiguijop lou ahi jeh-u chun ahuhdoh dingu koima aumpon ahi. Hichu Beth-rehob koma phaichama uma ahi. Chuin amahon khopi khat asaovin, chua chun acheng taove.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin akhopi semu chu Israel'a dinga hungpenga apau Dan min aput sah-un, Dan asah taove. Ahivangin khopi minchu amasa Laish anahin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Dan chate chun semthu milim atungdoh-un; agamu chu sohchanga ache kahseuvin Manasseh chapa, Gershom chapa, Jonathan le achateho chu Dan phunga thempun apanguvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin amahon Micah'in asemthu milim chu atungdoh-un, hiche phatsungse chu Pathen in chu Shiloh-a aumin ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche nikho laichun ahung hitin ahi, Israelte lah-a leng aumlou laichun, Ephraim molsang panga chun Levi mikhat ana khopemin, ama chun Juda gam Bethlehem'a konin thaikem khat akipuijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama thaikemnu chu ama dounan noti'n apangin, chule ama-a konin achedoh-in Juda gam Bethlehem'a apa in'a chun achen, chua chun lhali aga umin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin a-inneipu chu amanu kamdama kihoupi ding le hin nungpui kit dingin akipat doh-in, asoh khat le sangan kopto akipuijin, anung ajuijin ahi. Chuin amanun amapa chu apa in'a ahin puijin; chule nungahnu pa chun amapa amuphatnin kipah tah-in alamton ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin anupa-pa, nungahnu pachun, amapa chu a-umsah-in; chule amapa jong ama chutoh nithum aumkhomin ahi. Hitichun mahon aneuvin, adonun, chule chu-a chun ageh-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin nili chanin ahung hitin ahi, jingkah matah-a ahung thodoh doh-un, amapa che dingin akipatdoh tan ahi. Hichun nungahnu pa chun achanu jipa henga, Changlhah themkhat beh nenlang nalung suhal photnin, chujou tengle chenan nate, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amani atou lhonin, anekhom, adonkhom lhonin ahi. Ajehchu nungahnu pa chun mipa henga chu, Katao ahi, lunglhai selin umin, tujan khongaijin lang, nalungthim kipasah-in, atin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin mipa chu chedinga akipatdoh phatnin, anupa-pa chun alho lhon ahile, amapa aumkit tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ani nga ni jingpi tah-in amapa chedingin ahung thoudoh-in ahile, nungahnu pa'n ahenga, Katao ahi, nalung suhal tadin, ati. Chuin amani nisa akihei geijin akhongai lhonin, chule amanin anekhom kit lhonin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule mipa chu ama, athaikem, chule asohpa toh chedinga ahung kipatdoh phatnin, anungahnu pa chun ahenga, Ven, tuhi nilhah hiding ahitan, kangeh nahi, tujan khongai nalaijun: ven, nikho kichai ding ahitai, nalungthim kipana dingin hilaija hin geh maijun; chule jingle in nalhun theina dingin, jingpitah le najotna ding jonnan nate, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla mipa chu khongai ding anompon, hijeh chun akipat doh-in achen, Jebus maijon ahung lhungtan, hichu Jerusalem ahi. Chule akoma sangan ni apho lhingset toh, athaikemnu aumin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amaho Jebus kom ahung lhunun, nikho chu beiding ahitan; asohpa chun apu henga, Katao ahi, hungin, Jebus miho khopi-a hin lutnu hitin, gehtao hite, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin apupan ahenga, Eiho Israel chate-a hilou, hetkhahlou miho khopi-a ilut loudingu ahi; Gibeah kho geija cheu hite, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin asohpa henga, Hungin, Gibeah ahiloule Ramah khatjoh joh naiju hitin, jan geh-u hite ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho acheuvin, alamjot ajomun; chule Benjamin mite kho Gibeah kom alhunun, nisa alhumtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amaho hilama chu lutding le Gibeah'a chu geh dingin akihei lutnun ahi. Chuin ama alutphatnin, khopisung lamlen khatna atoutan ahi. Ajehchu amaho puiding le a-in'a lhunsah ding koimacha umlouva ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin veuvin nilhah ahiphatnin, tehsepu khat alou kona-a konin ahungin, ama jong chu Ephraim molsanga kon ahin; Gibeah'a khopem ahi: ahivangin chuche mun'a cheng miho chu Benjamin mi ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ama agah khodah-in ahile, khopi lampi-a tou kholjin mipa chu amun; chuin tehsepun ajah-a, Hoija cheding nahiuva? chule hoilama hungkon nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman amapa henga, Keiho Juda gam Bethlehem'a kon Ephraim molsang jonding kahiuvin, keima chu mun'a kon kahi. Keima Juda gam Bethlehem'a gache-a kahin, ahin tu-a hi Pakai in'a cheding kahi; chule koiman a-in'a eilhunsah ding aumpoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahin hikoma hin changpol le ka sangan hou dinga ngaikhoh ho aumin, chule keima ding le kasohnu ding, chule nasohpan alhonpi gollhangpa dingin lengpitwi le changlhah jong aumin ahi, imacha alhasam beihela uma ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin tehsepun, Lungmong tah-in umun; hijongle nadei jouseu keima chunga ngamun lang, lamlhonga vang geh hih beh-un, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun tehsepu chun amapa chu a-in'a apuilutnin, a-sangan teni chu nehding apen; chule amahon akengu akisilun, aneovin adonun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amaho alungsungu akipa laitah-un, veuvin, khopi miho phabep, Belial chapa phabep chun aumnao in chu aum kimvelun, akot chu achumun, chule a-inneipa tehsepu henga chun, Na in'a lhungpa chu kaki timatpi dingun hinpui doh-in, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin mipa, a-inneipa chu ahenguva achedoh-in, ajah uva, Ahipoi, kasopiho, ahipoi, naheng uva katao ahi, hitilom hin khangse hih-un; hiche mipa hi ka in'a hung ahi namu jeh uvin, hiche ngol hoitah hi bolhih-un.
  </para>
  <para style="p">
    <verse number="24" style="v" />Veovin, hikomahin kachanu nungah khat le thaikemnu aume; keiman amani hinpui doh ingting, nanghon amanichu noinep munlang, achung lhona pha nasah sah-u chu boljeng uvin: hichepa chunga vang chutobang thilse chu bol hih-un, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla miho chun ama thusei chu ngaisah-in aneipeh pouve. Hitichun mipa chun athaikemnu chu apuijin, amaho henga chun ahin puilut tan ahi; chuin amahon amanu aluppiuvin, jan khovah jingkah geijin akichep naovin ahi. Chuin jingkho ahung vah phatnin, amanu asolmang taove.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin thingjang ahungvah phatnin numeinu chu ahungin, apupa umna mipa kotphunga chun alhun, khovah lhah kahsen hia chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin jingkah-in a-pakaipa athouvin, inkot chu ahongin, achena ding lampia chu che dingin apotdoh-in ahile; veuvin, athaikem numeinu chu kotbula chun analhun, chule akhut teni chu kotbula ana kingamin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin amapan ahenga, Thouvin, chetaohite ati. Ahin adonbut tapoi. Hichun mipan amanu chu a-sangan chunga adomdoh-in, amajong atoudoh-in, achena dinga achetai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin amapa a-in alhun phatnin, chemcha khat alan, athaikemnu chu atuh-in, agutoh pumin a-at khen khenin, tum somleni ason, chuin Israel gam pumpi-a athot tai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ahitin ahi, hiche mujouse chun, Israel chate Egypt gama kona ahung potdoh uva pat tuni chan geihin hitobanghi akibol khapon, mujong akimu khapoi. Hichehi ngaitouvin, thuhilna lauvin lang, nalungthimun thu seijun, atiuve.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Israel chate jouse chu Dan'a pat Beersheba changei, chule Gilead gamsunga konin jong achedoh-un, mihonpi chu mikhat bangin Pakai ansung Mizpeh mun'a akikhom khomun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin mipi jouse lamkaiho, Israel phungho chu Pathen mite kikhopna-a chun apangun, chemjam lamthei cheh kenga kalsong sepai sangjali ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />(Hichun Benjamin chaten Israel chate chu Mizpeh'a achetou uve ti ajataovin ahi.) Chuin Israel chaten, Iti dana hitobang gitlouna natoh hi sohdoh-a ham? neisei peh-un, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Levi mipa, akithat numeinu jipa chun amaho adonbutnin, ahenguva, Benjamin miho khopi Gibeah'a chun keima le kathaikemnu jan gehdingin kahung lhonin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun Gibeah miho keima dounan ahung kipat doh-un, jan-in kaumna in aum kimvelun, thadingin eigouvin: kathaikemnu hunamin abolun ahile, athilotan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin keiman kathaikemnu chu kahin pon, kasat tel telin, chule Israelte chenna gamtina kathot kimvel tai. Ajehchu amahon Israel sunga thet umtah jonthanhoi le ngol hoitah na atong doh-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veovin, nangho nabonun Israel chate ngen nahiuve: hikoma hin nathuhilu le nathumop mu neipeuvin, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin mipi jouse chu mikhat bangin akipat doh-un, Eiho khatcha iponbuh uva ichelouhel diu, khatcha i-in'uva iche louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin eihon tu-a hi Gibeah chunga ibol dingu chu hiche hi ahi: vang kivet dungjuija amaho doudinga ikon tou dingu;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amaho Benjamin te khopi Gibeah'a alhun tengule, amahon Israel sunga ngol hoitah aboldoh banguva chu achunguva na atoh theina dinguvin, eihon Israel phung jouse-a kona mipite an thah dinga, mi jakhat lah-a kon som, sangkhat lah-a kona jakhat, chule sangsom lah-a kon sangkhat ilhendoh dingu ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun Israel mite jouse khopi douna chun mikhatseh bangin akipunkhom taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Israel phungho chun Benjamin phungho jouse henga mi asolun, Nalah uva kibol hitobang khangitlouna hi ipi hitam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichejeh chun tun keihon amaho chu katha uva, Israel lah-a kona gitlounahi kasuhmang nadingun hiche miho, Gibeah'a um Belial chate chu neipedoh-un, atiuve. Ahinla Benjamin chaten asopiho Israel chate thusei chu ngaisah-in aneipeh pouvin:
  </para>
  <para style="p">
    <verse number="14" style="v" />Amavang Benjamin chate chu Israel chate satdingin, akhopi houva konin Gibeah khopi-a chun akikhom khomun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hiche pettah-a chun Gibeah a chengho lhentum cheh jasagi tilouvin, Benjamin chate chu akhopihou jouse-a konin chemjam lamthei mi sangsomni le sanggup aumin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheho lah-a chun lhentum cheh veikolong mi jasagi aumun; chule amaho chun samjangte geija khel louhela sepkha thei cheh ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Israel mite chu Benjamin simlouvin chemjam lamthei cheh mi sangjali ahiuvin; amaho hi abonuva galhang cheh ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Israel chate chu akipat doh-un, Pathen in lama chun ache touvun, Pathen'a konin thumop angeh-un, Keiho lah-a Benjamin chateho toh kisat dinga koipen kachetou masah ding ham? atiuve. Chuin Pakaiyin, Judah chetou masa ding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun Israel chate chu jingkah-in athou doh-un, Gibeah dounan gebuh asong taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Israel miho chu Benjamin to kisatdin akondoh uvin; chule Israel chate chu amaho toh kisat dingin Gibeah'a chun akigoltoh taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Benjamin chate chu Gibeah'a konin ahung potdoh-un, hiche nikho chun Israel mite sangsomni le sangni jen tolla asat chapmun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Israel mite chu akitil khouvun, amasani-a akigolna mun mama uva chun galsat dingin akigolkit taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />(Chuin Israel chate achetouvun, nilhah geijin Pakai angsunga akapmun, Pakaiya kon thumop angeh-un, Kasopipa Benjamin chate douva kisatpi dinga kachetoukit ding ham? atiuve. Chuin Pakaiyin, Agakisatpi din kontouvin, ati.)
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin anikho ni channin Israel chate chu Benjamin chate dounan ahung nailut kit taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin anikho ni chanin Gibeah'a konin Benjamin amaho doudingin ahungdoh-in, Israel chate sangsom le sang get chu tolla asat chapmun ahi; amaho chu abonchauva chemjam lamthei cheh ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche phatchun Israel chate, chule mi jouse chu ache touvun, Pathen in'a ahungun, akapmun, chule Pakai angsunga atouvun, hiche nikho chun nilhah geijin an angolun, chule Pakai angsunga chun govam thilto le chamna thilto atoh-un ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Israel chaten Pakai adongun, (ajehchu hiche nikho laija chu Pathen thulhun thingkhong chu hikoma chu uma ahin,
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule hiche nikho laichun Aaron chapa Eleazar chapa Phinehas chu a-angsunga chun adingjin ahi), Kasopipa Benjamin chate douva kisatpi dinga kachekit ding ham? atiuve. Chuin Pakaiyin, Kontouvin, ajehchu jingle amaho khu nakhutna kapehdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Israel ten Gibeah kimvela changpang ding akoigu taovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule anithum channin Benjamin chate sat dingin Israel chate akontouvun, nidanga bangin Gibeah'a kidou dingin akigolkit taovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Benjamin chate chu mipi ho dou dingchun ahungdoh-un ahile, khopi-a konchun agamlha taovin ahi. Chule nidang bangin miho chu asatnun, Pathen in chetouna lamlhong le Gibeah jotna loujao lah-a chun Israelte mi somthum tobang athatpan kit taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Benjamin chaten, Amasa bangin imasanguva tha-in aumkit taove, atiuve. Ahinla Israel chate chun, Eiho jamuhitin, khopi-a konin lamlhonga puidoh uhite, atiu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Israel miho jouse chu apanmun cheh uva konin ahung kipatdoh uvin, amaho le amaho Baal-tamar'a akigolun; chule Israel chate changpanga pangho chu aumnao Gibeah phaichama konin ahungdoh-un ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Israel mipi lah-a konin kilhengdoh mi sangsom ho chu Gibeah dou dingin ahungdoh-un, chule gal kisat chu anasa lheh-in ahi. Ahivangin Benjamin miho chun achunguva manthah na akomchaova aume ti ahepouve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Pakaiyin Benjamin chu Israel masanga agal lel sahtan; chule hiche nikho chun Israel chaten Benjamin mite chu sangsomni le sangnga le jakhat athatnun; amaho chu chemjam lamthei cheh ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hitichun Benjamin chaten agal lel'u chu amutaovin ahi. Ajehchu Israel miho chun Gibeah pama changpang akoihou chu atahsan jeh uva, Benjamin miho dinga chu mun a-otnu ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin changpangho chun kinotah-in Gibeah chu adel khumun; chule changpangho chu akihom khenun, khopi sunga chengho jouse chu chemjamin athat gamtaovin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tun Israel miho leh changpangho chun akah uva melchihna khat aneiju ahin, hichu khopi-a kona meikong nasatah le meikhu ajamdohsah dingu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chutichun Israel mite chu agalsat naova kona akicholnga kahlah-un, Benjamin miho chun ahin nokhumun, Israel mi somthum tobang athatnun ahi. Ajehchu amahon, Amahohi kisatna masa-a banga imasanguva gallel kit ahi taove atiu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahinla khopi-a kona meikong leh meikhu khompi banga ahung kitundoh phatnin, Benjamin miho chu akinung heijun aveovin ahile, veuvin, khopi-a kon meikong chu van geijin akikho touvin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Israel miho ahung kinunghei kitnun ahile, Benjamin mihon kidang asaovin ahi; ajehchu amahon achunguva manthah na ahung lhungtai ti amuvin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hijeh chun amaho Israelte masang chun akinung heijun, gamthip lama ajam taove; ahinla gal kisatchun apha paovin, khopi-a kona hungdoh hochun alah tah uva konin asumangun ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hitichun Benjamin miho chu aumkolun, adelun, Gibeah maijon nisona lam geijin bailam tah-in kengin achilun ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Benjamin miho chu sangsom le sangget athiuvin; abonchauvin mihangsan jeng ahiuve.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin amaho akiheijun gamthip Rimmon songpi lama ajam taovin ahi. Chuin amahon lamlhonga chun mi sanga athatnun, chule Gidom geijin hatah-in anung adelun, mi sangni athatnun ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hitichun chuche nikho-a Benjamin mite athi jat chu chemjam lamthei cheh mi sangsomni le sangnga ahin; amaho abonchauva mihangsan cheh ahiuve.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ahin mi jagup hochu akiheijun gamthip Rimmon songpi lama chun ajamun, chule Rimmon songpi-a chun lhali aumun ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin Israel miho Benjamin miho chunga achukit uvin, chemjamin athatnun, khopi jouse-a konin amu jouseu mihem hihen, sahem hijongle athat gamun ahi. Chule amahon ahung lhunnao khopi jouse jongchu meijin ahalun ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Israel mihon chu Mizpeh'a akihahselun, Ilah uva khatchan achanu Benjamin mi ji dinga apehthei louding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin mipi chu Pathen in'a ahungun, Pathen anga nilhah geijin aumun, aw sangtah-in asamuvin, hakan akapmun;
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Israelte Pakai Pathen, hitobang pihi ipi jeh-a Israel lah-a soh-a, tunikho-a Israel lah-a kona phungkhat lhasam ding hitam? atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ajingin ahung hitin ahi, miho chu jingpi tah in athouvun, maicham khat asaovin, govam thilto le chamna thilto atoh-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Israel chaten, Israel phung jouse lah-a kona Pakai henga dinga mipi houkhom ho toh lhontou lou koi umam? atiuve. Ajehchu amahon Mizpeh mun'a Pakai henga hunglou tapou chungchanga kihahselna lentah aneijuva, Amachu thatei tei ding ahi, atiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Israel chate chu asopipao Benjamin dingin alung hesoh-un, Tuni hin Israel'a konin phung khat akipai dohtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu-a amoh umnalai ho ji ding chungchanga hi ipi ibol dingu hitam? Eihola Ichanuteu ajidiuvin pepouhite tin Pakai anga kihahselna ineitaovin, atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amahon, Pakai henga dinga Mizpeh'a hungtou lou Israel phung khat tou umam? atiuvin ahi. Chuin veovin, Jabesh Gilead'a konin akikhomho umna gebuh'a chun koimacha ahungpouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu mipi chu akisima ahile, veuvin, Jabesh Gilead'a cheng miho chu khatcha jong aumpon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin mipi kikhom chun ahangsan dehset cheh mi sangsom le sangni asolun, chule thupeh aneijun, ahenguva, Cheovinlang Jabesh Gilead'a chengho chu numei leh achateuse toh chemhemin gathatnun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hichehi nabolding dolu chu ahi: nanghon pasal takip, chule pasal toh lumkhomsa numei takip chu natha gamheldiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon Jabesh Gilead'a kon chun pasal hekhalou nungah theng jali amudoh-un ahi. Chuin amahon amaho chu Canaan gama Shiloh gebuh-a ahin puijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin houkhom pumpi chun Rimmon songpi-a um Benjamin chatetoh kihou dingle, amaho lungmong tah-a kou dingin mi phabep asolun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun Benjamin chu ahungkit tan; chule amahon amaho chu Jabesh Gilead miho-a kona ahinghoiju numei ho chu ajidingun apeuvin; ahinla hicheho chun atohjou pon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakaiyin Israel phungho sunga chun kikhenna aumsah jehchun, mipi ho chu Benjamin jeh-in alunghemun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chujouvin mipi kikhomho lah-a upaho chun, Benjamin'a konin numei ho akisumang tai ti imu utoh lhona, ahing nalaiho ji dinga hi ipi ibol dingu hitam? atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amahon, Israel lah-a kona phungkhat suhmanga aumlou nadinga, Benjamin miho lah-a kona ahingdoh hohin goulo aneitei dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla eihon amaho chu aji dinguva ichanuteu ipehthei loudingu ahi: ajehchu Israel chate chun kihahselna ananeijuva, Benjamin mi jidinga achanu pechan chu sapset changhen anatiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouchun amahon, Veuvin Bethel sahlam, Bethel'a kona Sheshem jotna lamlhong solam, chule Lebonah lhanglam Shilloh mun'a khun kumseh le Pakai golvah akiboljin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichejeh chun amahon Benjamin chate chu athupeh-un, ahenguva, Cheovin lang lengpi leija khun gachang pangun;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ana veuvin lang, veuvin, Shiloh kho-a nungah ho chu lamna-a lamdinga ahungule, lengpi leija konchun hungpot unlang, amitakipmin Shiloh chanute-a konchun naji ding cheh-u kimatnun lang, chule Benjamin gam lama chepiovin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hung hitiding ahi, apatehou ahiloule asopitehou kehenguva kiphinna thu seidinga ahung tengule, keihon amaho henga, Keiho jal-in amaho chunga khun khohsahna neijun, ajehchu gal kisatna-a chu eihon amitakip ajidingu ikhendoh peh pouvin, chule nanghon tu-a jonghi amaho napeh-u ahilou jeh-in, themmo chang pouvin nate, tin seinao vinge, atiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Benjamin chate chun hitichun aboltauvin, amahon amijat dungjuijun alama hungdohho aji dinga akimat hou chu akipuijun; chule agoulonao gama akileuvin, khopi ho chu asaphaovin, acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin hichephat chun Israel chate chu hiche mun'a konchun akipat doh-un, amijouse ama phungle insung, chule agou lona mun cheh-a achedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichelai chun Israelte lah-a leng aumpon: amijousen ama mitmu-a pha asah chu abol jengu ahi.
  </para>
</usx>
