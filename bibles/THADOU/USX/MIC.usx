<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MIC" style="id">Micah</book>
  <para style="h">Micah</para>
  <para style="toc1">Micah</para>
  <para style="toc2">Micah</para>
  <para style="mt">Micah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengho Jotham, Ahaz chule Hezekiah nikholaijin Moresheth mi Micah henga Pakai thu hunglhung, Samaria le Jerusalem chung chang thudolla athilmu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngaijun nangho mijousen; Vo leisetle asunga um jousen, ngaitemun; Pakai Pathen chu nangho douna-a ahetoh hihen, a-houin thenga kona Pakai chu ahetoh chu hihen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu veuvin, Pakai chu aumna munna kona hung potdoh-a, leiset munsang ho chu achotpha ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule mei koma khoilu jun bangle, twiho mun nema akisunlhah bang hella, phaicham ho chu khikeh-a, molsangho chu anoija junlha ding ahi
  </para>
  <para style="p">
    <verse number="5" style="v" />Hicheho jousehi Jacob khan gitlou jehle, Israel insung chonset jeh ahi. Jacob suhkhelna ipi ham? Samaria chu hilou ham? Chule Judah munsang ho chu ipi ham? Jerusalem chu hilou ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh-a chu keiman Samaria chu gamlah-a thilnen kisekhom banga kasema, chule lengpi leija kibol ding; Chule chua songho chu damphaija kasunlhah-a, abul ho chu kadosah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule alim semthu milim jouse chu kavohchip gam hella, noti mana amu jouse chu meija kahal vam gamhel ding, chule milim jouse chu kasuh manghel ding ahi; ajehchu amanun noti mana kon alokhom ahijeh-in, hicheho chu noti man mama-a kilekit ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu kaka-a kapen ding, kakisut lha-a sagoh keova kaumding ahi. Dragon ho bangin penging ting, sumbupi bangin haminge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu amanu maput chu damkit theilou ahi: ajehchu hichehi Judah gam alhungtan, kamite kotpi phung ahung lhungtan, Jerusalem jengjong ahung lhungtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichehi Gath kho-a seiphong hih-un, kapjong kaphih hellun; Aphrah insunga leivui lah-a chun kitangle leovin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Shaphir'a chengpa nangma, sagoh keovin jahcha tah-in chemangtan, Zaanan miho chu Bethe-zel miho lunghemna-a dingin apotdoh pouvin, aman nangma-a kona dinmun akimuding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Maroth mihon chingthei tah-in chanpha angahuvin, ahinla Pakaiya konin thilse chu Jerusalem kotpi phung ahunglhung suhtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo, nangho Lachish mite, kangtalai chu gamsa hattah toh sutouvin; amanu hi Zion chanute chonset kipatna ahin, ajehchu Israel suhkhelna chu nanga akimudoh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh-a chu nangin Moresheth-gath henga thilpeh napeh ding, Achzib inho chu Israel lengho dinga lheplhahna hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla vo Mareshah mi, nangma goulo ding khat nahenga kahin puiding; Israel loupi nachu Adullam geija hung ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nasam kivel tollin, nacha ngaitahho jallin kivel tollin; mulaopi lumui bangin kivou muijin, ajehchu amaho nanga kona gal hinga che ahitaove.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khangitlouna thilgongho, ajalkhun chunga thilse bolho chu ohe adao ahi! akhutnuva boltheina umma ahijeh-in, jingkah kho hungvah teng hichu aboljiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amahon mi lou athang setnun, pumhatnin alahpeh-un; chule inho athangset nun, alahpeh-un; chutichun amahon mihem le a-in, amihem le anei agouho asugenthei jin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun veuvin, hiche insung douna dingin thil gilou kagongin; hiche phat hi phat phalou ahijeh-a chua kona chu nangongu naheithei lou dingu, hoitho tah-a naumthei lou dingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hicheni chule mikhatnin nangho douna-a thulem khat aseija, lunghem tah-a ka la-a nakacham uva; eikisumang theng helluva ahitai, kamite gouchan chu akheldoh tai; Aman hichu keija kona iti ana chon mang ahitadem! aman kagam hou chu akaleh in eihop khenpeh taove, tia aseidiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh-a chu nangin Pakai houkhom na-a khaova vang kisanna chan homding koima naneilou dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gao hih-un, tin gao thusei ho henga seijuvin; amaho henga chu amahon gaothu aseiloudiu, chule amahon jachatna atoloudiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo nangho Jacob insung tia kiminvote, Pakai lhagao chu nahsah mo-a uma ham? hichehi ama natoh hi jaham? Kitah-a chonpha chunga chu kathu hohin thilpha abolji hilou ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla tumapan louvin kamitehi melma bangin nabolun; nangman gal deilou mongtah-a vahle ho chu galmuna kon hung kileho bangin avonu le asangkhol cholu nasutlhah peh-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kamite numei ho chu a-in'u nomtah ho-a konin nanodoh un, kaloupina chu achateuva konin a-itih-a dingin naladoh taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hikom munhi nakicholdo nao mun ahilou jeh-in, kipat un lang potdoh-un; ajehchu hichehi akisuboh ahin, hichun nangho nasuhmanguva, melse tah-a nasuh gamheldiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mikhat chun lhagaovin vahle hen adihlouvin jou bol henlang, keiman lengpitwi le ju thu-in naheng uva gaothu seijinge, tile, ama chu hiche mite themgao hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Jacob, keiman nabon chaova kakhop khom teidingu ahi. Keiman thonlouva Israel amoh chengse chu kakhop khom ding, keiman amaho Bozrah kelngoi banga kakoi khoma, hongsunga kelngoihon banga kakoi khomding; amaho mipi tamtah jeh-a husan nasatah aso dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asusepa chu amasanguva ahungdoh-e; amahon asuseuvin, chule kotpi chu ajotpaijun, chua chun achedoh taove; chule alengpao chu amasanguva chea, Pakai chu amaho luchang hiding ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin keiman, Vo Jacob luchangho, chule Israel insunga pipuiho, ngai phaovin, naheng uva katao ahi, nanghon thutandih nahet dingdolu hilou ham? kati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho apha hot bolla ase ngailuho, amaho-a kon avunu naleolhah peh-un, aguhouva konin atahsapheo nakhoh lha uvin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Kamite sajong nane uvin, amaho-a kon avunu naliplhauvin; chule bella lhah ding bangle belpi sunga lhahding bangin aguhou navochip un, aphe-u nachen bong selun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuteng amaho Pakai henga penguntin, hijongleh aman amaho angaipeh lou ding; athil bollule amaho tah chonna phatlou jeh-a, aman amaho-a kona amai jengjong aselding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamite lamvai sah-a, chamna umhen tia samma, aha uva pet; akamuva ima henglouva pa douna-a galsat dinga kigo themgaoho thudolla; Pakaiyin hitin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun mu naneilou helna diuva nangho dinga jan hunglhung ding, chule ai nasan theilouna dinguva nachung uva mu thim ding, chule themgaoho chunga nisa lhumma, amaho chunga chu sun jong thim ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutengle themgaoho chu jahchao vintin, Ai themho chu maimoh dingu; henge, Pathen'a kona donbutna aumtah loujeh-a, amahon akamu akisipdiu ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Jacob henga asuhkhelna, Israel henga achonsetna phonpeh dingin, Pakai lhagaova konin tahbeh-in thilboltheina, thutanna chule hatna-in kadimset tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangho Jacob insung luchangho leh Israel insung pipuho, thutanna hotbola, thudih akaleh-a heiho, naheng uva katao ahi, hichehi ngai phaovin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon Zion chu thisan aso uvin, Jerusalem chu khangitlouna asouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukoma vaipoho chun thilpeh kineppi na-in thu atannun, chule thempuhon tohman mun'a dingin ahilun, themgaoho chun sum deinan agaovui. Achutijeng vangin, Pakai chu eiho lah-a uma hilou ham? Ichunguva thilphalou hunglhung ponte, atiuvin Pakaiya akingaijun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu Zion chu nangho jala lou banga kikaija, Jerusalem chu thilboh kisevum hung hiding, houin umna molsang chu gamlah-a munsang ho bangding ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla ninunung lamleh hunghiti ding ahi, Pakai in umna molsang chu molsang ho chung vuma hung kisadoh ding, lhangvum hoa choisanga hung umding; chule hia chu mipi ho twilona longlut dingu ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule namtinho chu hunguvin tin, hungun, Pakai molsanga kaltouvu hitin, Jacob Pathen in'a chun kaltouvu hite; aman alampiho chu eihil untin, eiho alampia chu ichediu ahi; Zion'a kon chun danthupeh potdoh intin, Pakai thu chu Jerusalem'a kona hungpotdoh ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule aman mitamtah thu atana, chule gamla tah-a nam hattahho chu aphosal ding; chuleh achemjamu chu lou kaina ha-a akhendiu, chule atengcha hou chu kangkuija akhendiu ahi; nam khatnin nam khat chunga chemjam lamtapontin, galsat jejong kithemchuh tapouvinte.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin mi jouse ama ama lengpi theile theichang phung noija touvuntin, koima chan kichatsah tapou vinte; ajehchu janel Pakaiyin akamcheng tah-a aphondoh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu mi jouse ama Pathen min cheh-a chonuntin, chule eiho Pakai i-Pathen'u mina atonsot atonsotna ichon lediu ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin hitin aseije, hicheni chuleh keiman elbaiho khom ingting, akinomang saho kakhopkhoma, chule kasuhgentheiho chu kakhop khom ding ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule elbaiho chu ahingdoh amoh-a kasemding, gamla tah-a kipaidoh ho chu nam hattah khatna kasem ding ahi; tua patna Pakaiyin Zion molsanga tonsotna achunguva vai ahomding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Vo nangma, ganchaho insang, Zion chanu umna kuldet, nahenga hunglhung ding ahi, navaihom na masa jongchu hunglhung ding ahi; lenggam chu Jerusalem chanute henga hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tu-a ibolla awthong jeju-a naka ham? nalah uva leng umlou ham? nangma nathumop ji-a chu mang thah-a hitam? ajehchu numei naosonat banga natna-in naphah ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Zion chanu, naonei dingin chanei dinga naosonat thohgim bangin thohgimin; ajehchu khopi-a kona tu-a napotdoh-a, loujaova nachen ding, chule Babylon geipeh-a nache ding ahi. Chukoma chu huhdoh-a naum ding; chukoma chu namelmaho khutna kona Pakaiyin nahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tunjong nangma doudin nam tamtah akikhom taovin, amanu suhboh-in umhen lang, imitnu hin Zion vehen, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla amahon Pakai lunggel ho chu ahepouvin, athumopna jong ahethem pouve; ajehchu pholla changphal ho banga amaho chu akhop khomding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Zion chanu, thouvin lang chillin, naki chu thih banga kasem ding, natin chu sum-eng banga kasem ding ahi; chule mi atama tam ahalhalla nasuhchip ding; chule ahamphatnao Pakaiya dinga kakatdoh ding, chule athilluhou chu leiset pumpi Pakaiya dinga kakatdoh ding ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo galsat mihonpi chanu, tun nangman galsatmi ahona din kigom khomin; aman eiho dounan kulpi eikaikhum taovin; amahon Israel thutanpa chu molla angeiphe avohdiu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla nangma, Bethlehem Ephrathah, nangma Judah gam sang tamtah lah-a neocha hijongle chun, nangma-a kona kami Israelte lah-a vaipo ding khat hungsoh doh ding; ahung kipatna chu masanglaipeh, tonsotna pat ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh-a chu aman naosonat thohnun cha ahindoh kahse-a, amaho chu donlouva akoija adalhah ding ahitai; chutengle asopite ahingdoh amoh chengse chu Israel chate henga hung kile kit dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ama chu dingin tin Pakai thahat na-a chu kivah ding; Pakai a-Pathen loupina-a minna chu kivah ding; chule amaho umjing dingu ahitai; ajehchu tu-a ama chu leiset kolmong geija loupi ding ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Assyria miho chu igam sunguva hi ahunglut tengule, hiche mipahi kichamna chu hintin; chule aman ileng inpihou ahin chotpha tengleh, eihon ama doudinga kelngoi ching sagi le pipui get itun dohdiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amahon Assyria gam chu chemjam'a asuhgamuva, Nimrod gam chu ahunglut na-a asuhgam diu; chutia chu ama igam sunguva ahunglutna, igamgisung hou achotpha tengle, Assyria mite-a kona eihuhdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Jacob'a ahingdoh amoh chengse chu, mipi tamtah lah-a Pakaiya kon daitwi le hamhing chunga goju banga umding ahiuve; hichun mihem angahpon, chule mihem chapate jong angah pon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Jacob'a ahingdoh amoh chengse chu mipi tamtah lah chidang namdangte lah-a gammang lah gamsaho lah-a keipi bahkai tobang hidiu, chule kelngoi hon lah-a keipi bahkai khangdong tobang hi ding ahi; Amachu avahlen ahile, achonlhun chule abottelin, koima ahuhdoh jou aumpoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nakhut chu nakidoupi te chunga kidomsang ding, chule namelmaho chu kisatlha ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hiche ni chule hunghiti ding ahi, Keiman nalah uva kona nasakol hou chu kasat chapma, chule nakangtalai hou chu kasuhmang ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman nagam uva khopiho chu kasat gama, chule nakhopi det jouseu kasuhchim ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule keiman nakhutna mitpheldoi themho chu kasatlhah ding, chuleh nangman phunsan ho naneilou ding ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nalah uva kona namilim semthu hou kasatlhah ding, chule namilimu dinglaiho kasat lhah ding ahi; chule nanghon nakhutsemhou chu nahou kit tahlou heldiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nalah uva kona nathing milimhou chu kabodoh ding, chutiachu nakhopihou chu kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Pathen hephalouho chunga, anajahkhah louvu lunghang tah-a phulahna le lungsatna kalhunsah ding ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun nanghon Pakai thuseihi ngaijun; kipat doh unlang molsang ho masanga nachung thu galhutnun, lhangho chun na aw-u ngaijuhen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo nangho, molsang jousen, Pakai nelkalna chu ngaijun, chule nangho leibul dettahhon ngaijuvin, ajehchu Pakai chun ami Israelte toh kinel kalna aneijin, chule ama Israelte toh kinel ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo kamiteho, nangho-a dinga ipi kanabolem? chule hoilaija kana suhchol khah uvem? neihin donbutnun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu keiman Egypt gamma konin nangma kahin puidoh-in, chule soh hina insunga konin kalhat doh-in, namasanguva Mosi, Aaron chule Miriam kasole.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo, kamiteho, Pakai chonphatna chu nahet theina dinguva, Moab lengpa Balak thumop le, Beor chapa Balam'in Shittim'a kona Gilgal geija adonbut dan chu, tuhin geldoh uvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai anga chu ipitoh kahunga, Pathen chungnung anga chu kakunding ham? kum khatbep bongnou leh govam thilto toh ama anga chu kahung ding ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai chu kelngoichal sang tamtah jeh-a lunglhaija, ahiloule thaotwija long vadung sangsoma lunglhai dingham? Kasuhkhel jeh-a kacha masapen chu kapeh-a, kahinna chonset jeh-a kalaigil ga chu kapeh ding ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo mihem, aman apha chu navetsahsa ahitan; Pakaiyin nangma-a kona angeh chu navetsah ahitai; dihtah-a na natoh-a, hepina nakhoh sah-a, chule kineosah tah-a na-Pathen toh lam najotkhom ding chu hilou ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai aw chu khopi heng lama akisamin, chihna nei mihon namin amu dingu ahi; Nanghon tenggol le alheng dohpa thu ngaijuvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migiloupa ina chu gitlouna goubom um nalaija, thil tena dihlou thet umtah chu um nalaijem?
  </para>
  <para style="p">
    <verse number="11" style="v" />Khaikot dihlou pumle lheplhahna khaodip gihtah puma chu amaho athenga kasim ding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu chukoma mihaoho chu hunam dimset ahiuvin, chule chua chengho chun jou thu aseijun, akamuva aleiju chu lheplhah na dimset ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh-a chu kenjong nang kavoh-a kanatsah ding, nachonset naho jeh-a agohkeova kalha ding nahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman nen natin, ahivanga nava louding; chule lhahsamna chu nalai lunga umding ahi; nangman tuhdet ding somin natin, ahivanga nahuhdoh jou louding ahi; nahuhhing chasun jongchu keiman chemjam henga kapeh doh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman tun natin, ahivanga na-at louding, olive gaho chu chillin natin, ahivanga athao chu nakinu lou ding, lengpitwi lhumkeija nasemding, ahivanga nadon lou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Omri dan kisunho akinit jingin, Ahab insung miho thilbol jouse chu akibol jingin, chule athumop houva nachon jingin ahi; hijeh-a chu keiman nangma ahomkeova kasema, chule chua chengho chu nuijat nopna bep kahisah ding, chutia chu kamite ikisah louna chu napohdiu ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ohe ada kahi! ajehchu keima nipilai theiga ho kilohkhom bangle, lengpiga kilo lhahna nung bangin kaumtai; nehding thei bohla aumtapon, ka hinna'in theiga min masapen angaichan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipha chu leisetna konin amangthah tan; mihemte lah-a kitah khatcha aumtapoi: abonchauvin thisanso ding ngahin aumun, mitin asopi mandin lenthang toh anung delen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lung luttah-a akhut niuva thilse aboltheina dingu vin, pipuihon thilpeh angeh-un; Thutan hon nehguh angeh-un chule milenpa chun alung ngaichat dihlou chu aseidoh-in, chutichun amaho akithutoh soh uve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Alah uva miphapen chu khaogui lingnei bang ahin, mikitahpen jong chu meithai seltholing sangin ahemjoi; nakinga tup nikho leh nakivilna nikho chu ahung lhunge, tuhi amaho dinga lungdona hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Loi legol chunga natahsan ngam hih-in, lamhil chunga jong kingai hih-in, na-anga lumnu henga jong namuh kihupmin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu chapan apa ajatapon, chanu anu doudin akipan tan, mouvin atehpi adouvin, mihem dinga amelmaho chu ama insung miho tah ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun keiman Pakai henglam vengting, eihuh hingpa Pathen chu kanga ding ahi; ka Pathen'in kataona eingaipeh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo kamelma, kachunga kipah hih-in, keima kalhuh teng thou kitding kahi; muthima katouteng, Pakai chu keija dinga vah hiding ahi,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama douna kachonset jeh-in, kathu eiseipeh-a, kadinga thu atan masangsen, Pakai lunghana chu potange; aman khovah-a eipuidoh intin, achonphatna chu kamuding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai na Pathen chu koiham? tia sei kamelma nun amu ding, jachat na-in amanu akhuding ahi; kamit tenin amanu chu avetding, lamlena bonlhoh banga amanu chotpha-a umding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nabangho kisahna ding nikho, hiche nikho chule thupeh chu gamla tah-a kichondoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche nikho chule ama Assyria gama konle khopi det ho-a kon, chule kulpi-a pat vadung gei, twipi apat twipi gei, amol alhanga kona nahenga hungding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahijeng vangin, chuche gam chu asunga chengho jehle, athilbol ga hou jeh-a agohkeova umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Carmel gammang lailunga, lunghem tah-a achanga cheng nagoulo kelngoihonho, chule namite chu namoltumin vah-in; masang laija bang chun, Bashan le Gilead na kivah uhen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Egypt gama kona nahung potdoh laija banga chu ahenga thil kidangtah kavetsah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Namtinin hichu muvintin, athahatna jouseu chu ajachat pidiu; amahon akhutnuva akamu akisip diu, anao ngong ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon gul bangin leivui leh untin, leija ganhingho banga akohouva kona hung kitholdoh diu; amahon Pakai i-Pathen'u chu akichatnuva, nangma jeh-a agindiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang banga khangitlouna ngaidama Pathen koi uma, chule agoulo amoh chengse suhkhelna chelep sah-a koi umam? hepina akipapi jeh-in, alunghana a-itih-in aching jingpoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama hungkilekit nintin, ichunguva khotona aneiding, ikhangit lounao hochu anemse ding; chule nangman achonset nahou jouse twipi thuh tah-a nalelut ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangman khanglui laija kapu kapateu henga nathu tepsa, Jacob henga thutah le Abraham henga hepina chu namolso ding ahi.
  </para>
</usx>
