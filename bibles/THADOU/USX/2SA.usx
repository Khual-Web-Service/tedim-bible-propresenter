<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2SA" style="id">2 Samuel</book>
  <para style="h">2 Samuel</para>
  <para style="toc1">2 Samuel</para>
  <para style="toc2">2 Samuel</para>
  <para style="mt">2 Samuel</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Saul thinungin ahitin ahi, David'in Amalek mite athagamma ahung kinunglekit chun; David chu Ziklag'a nini ana umin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin anithumnin ahitin ahi, hichun veuvin mikhat apon teldehduh le alua leiset nat pumin Saul gebuh-a konin ahungdoh-in; chuin ahitin ahi, ama David kom ahunglhun phatnin tolla alhun chibai aboh tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David'in ajah-a, Hoija kona hunga nahim? ati. Chuin aman, Israel gebuh a kona hung hoidoh kahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David'in ajah-a, Thu iti tam? neisei peh-in, katao ahi, ati. Chuin aman adonbutnin, Miho galmuna konin ahung jamtaovin, chule mi tamtah jong alhun chule athitan; chule Saul le achapa Jonathan jong athitai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David'in gollhangpa henga, Nangman Saul le achapa Jonathan athi iti nahet ham? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin gollhangpa chun ajah-a, Keima Gilboa molsanga kaga umkhan ahile, ven Saul chu atengcha chunga ana opmin, chule ven sakol kangtalai hole sakol chung themho chun amachu nasatah-in ahindelun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman anunglam ahin vetna ahile keima eimun, chuin eihin kouvin ahi. Chuin keiman kadonbut nin, Hikoma kaume, kati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman kahenga, Nang koi nahim? ati. Chuin keiman kadonbut nin, Keima Amalek mi kahi, kati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman kahenga aseikitnin, Kachunga dingin lang neithatnin, ajehchu kachunga lunghemna ahunglhung tai; ajehchu kahinkhohi keima-a aum nalaijin ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun keima achunga kadingin, amachu kathat tai; ajehchu ama alhuh nunga ahinjou louding chu kahet ahitai; chule keiman alu-a um alal lukhuh le abanbul ho-a chaokolho chu kagalah-a, ka pakai nangma henga kahinpohlut ahitai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun David'in avonho abotkeh-in, hitima chun amatoh um miho jouse jong chun aboluvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amaho chu alunghemun, akapmun, hitichun amahon Saul le achapa Jonathan ding, Pakai miho jouse ding le Israel insung miho jouse dingin nilhah geijin an angolun ahi. Ajehchu amaho chemjam'a louva ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin David'in athuseipeh gollhangpa jah-a chun, Hoilang mi nahim? ati. Chuin aman adonbutnin, Keima gamchom mikhat chapa Amalek mi kahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin David'in ajah-a, Iti nangman Pakaiyin thao anusa khat chunga chu kichalouhela nakhut nalhah-a nasuhmang jengham? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin David'in gollhangho lah-a khatchu akouvin ajah-a, Nailutnin lang achunga chun, ati. Chuin aman ama chu athat tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin David'in ajah-a, Pakai thaonusa kathatne tia nakamtah-a naphon jeh-in, nangma thisan phuchu nachunga chuhen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin David'in Saul le achapa Jonathan ka-lan akachamin;
  </para>
  <para style="p">
    <verse number="18" style="v" />(Chuin aman Judah chate jongchu thalpi manje hilding ahi, tin thu apen, veuvin, hichehi Jasher lekhabua akisunin ahi).
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel loupina chu namunsangho-a akithat tai; i-atile ahat ho lhu-a hitam!
  </para>
  <para style="p">
    <verse number="20" style="v" />Gath mun'a seihih-un, Ashkelon lampi dunga phongle hih-un, achuti loule Philistine te chanuho kipah uvintin; chule cheptan louho chanute jong kichoisang getnunte.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gilbao molsang nangho, nachung uva daitwi lhahda henlang, gojong juhdahen, louhon jong aga soda hen; ajehchu mihatpa lumdal chu theng loutah-in lemangin aumin, Saul lumdal chu thao nulou bangin anaumin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Akithatpa thisana konle ahatpa thaova konin, Jonathan thalpi chu akile kitpon, chule Saul chemjam jong agoh keuvin ahung kilepon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinkho sung lhonin Saul le Jonathan hi ngailut umtah le dei um pentah ahilhonin; chule athilhonin jong akikhen lhonpoi; amani muvanlai sangin amangang jolhonin, keipi bahkaiho sangin jong ahat lhonin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangho Israel chanute, dei umtah ponsanthipma natompao, sana-a najempao Saul dingin kapmun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Iti ahat ho galmuna lhujenga hitam! Vo Jonathan, namun sangho chunga chun nangma nakithat tai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kasopipa Jonathan, nangma jeh-in kalung agenthei lheh-in ahi: Keima dingin kipa umtah chu nanahin, keima neingailutna akidangin, numei ho ngailutna sangin asangjon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahat ho iti lhuh-a, chule gal manchah ho iti manthah jenga hitam!
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche jouchun ahitin ahi, David'in Pakai adongin, Judah khopiho khatpena chu kachetou dingham? ati. Chuin Pakaiyin ajah-a, Chetouvin, ati. Chuin David'in hoilama kachetou ding ham? ati. Chuin aman, Hebron, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun David chukom mun jonin ajiteni Jezreel mi Ahinoam le Karmel mi Nabal jinu Abigail toh achetou tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule David'in aumpi amite, amitakip a-insung mite toh ahin puitouvin, chuin amaho Hebron khopiho-a chun acheng taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Judah miho ahungun, David chu hikoma chun Judah insung pumpi chunga leng dingin thao ahungnu taovin ahi. Chuin amahon David henga, Saul vuija pangho chu Jabesh-gilead miho ahi ti aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David'in Jabesh-gilead mite henga sottol ho asollin, ahenguva, Pakaiyin phatthei naboh uhen, ijeh inem itile nanghon hitobang lungset themna chu napakai pau Saul navetsah-un, navui jun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule tun Pakaiyin nangho-a lungset themnale thutah namusah taohen: Chule nanghon hiche thilhi nanabol jeh uva keiman jong nangho ding thilpha kabolding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun nabanthau hatdoh sah-un lang, chule hangsanun; ajehchu napakai pau Saul chu athitan; chujongle Judah insung miten achunguva leng dingin keima thao einutaovin ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Ner chapa Abner, Saul janel gal lamkaipa chun Saul chapa Ishbosheth chu Mahanaim'a ahinpuitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amachu Gilead Ashurim Jezreel, Ephraim chule Benjamin le Israel pumpi chunga lengin apansahtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Saul chapa Ishbosheth'in Israelte chunga vai ahomchun kum somli ahitan, chule kumni aleng changin ahi. Ahivangin Judah insung mi ten vang David ajuijun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule David Hebron khopi-a Judah insung pumpi chunga lenga apansung chu kum sagile lhagup ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Ner chapa Abner chule Saul chapa Ishbosheth soh ho chu Mahanaim'a konin Gibeon'a apotdoh-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Zeruiah chapa Joab le David soh ho akondoh-un, Gibeon twikul panga akisutou vin ahi: chuin khat ho chu twikul pang langkhatna atouvun, chule khat langho chu twikul pang langkhatna atouvun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Abner'in Joab jah-a, Tun gollhangho chu kipatdoh-u henlang, imasanguva kideluhen, ati. Chuin Joab'in, Amahochu kipatdoh-u hen, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Saul chapa Ishbosheth langa konin Benjamin mi somleni akipat doh-un, chule David sohte-a konin somleni akipat doh-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin mikhat chehchun agolpao luchang chu atuh-un, chule aloipa pangpeh chehchu chemjamin akisunto uvin; hitichun amaho thakhatnin alhutaovin ahi. Hijeh chun hiche munchu Helkath-hazzurim asahtaove. Hichu Gibeon'a um ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hiche nikho-a galkisat chu anasalheh jengin, Abner le Israel miho chu David sohte masanga agal lel taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule chumuna chun Zeruiah chapa thumho: Joab, Abishai chule Asahel ajaovun, chule Asahel kaljandan chu gamlah sakhipi tobang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Asahel chun Abner nungchu adelin, chule achepumin jetle veija kihei louvin Abner nungchu ajuipeh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Abner akinung heijin, Nangma Asahel nahilouham? ati. Chuin aman adonbutnin, Kahinai, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Abner'in ajah-a, Najetlam ahiloule naveilama kiheijin lang nagollhangho khatchu manin lang, agalvon chu lahpeh-in; ati. Ahinla Asahel chun ama ajuina-a konchun akiheidoh dehpon ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Abner'in Asahel jah-a aseikitnin, Keima neijuina-a konin kiheidohtan: keiman nangma ibola hiche munahi kathading nahim? Achutile kamai chu nasopipa Joab angsunga iti kalah dingham? ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahivangin ama kiheimang ding anompon; hijeh chun Abner'in atengcha lhumkeijin amapa nahgu ngachanna noitah chu asunin ahile anunglanga apaidoh jengin ahi: chuin ama alhun, hiche munna chun athitan ahi, chuin ahitin ahi, Asahel alhuh-a athina mun hin phapa chanchu adingden jengun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahin Joab le Abishai chun Abner nungchu adel lhonin: chule Giah masanga um Gibeon gamthip jotna lampia um Ammah lhang ahung lhunun nisa alhumtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Benjamin chate chu Abner nung chun akikhom khomun, chule amaho chu galsatmi honkhat akisouvin, lhang chunga adingun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Abner'in Joab chu akouvin, ajah-a, chemjam hin a-itih-a avallhum jingding hitam? Khonung akichaina le lungjinna ahung hi ding chu nahetlou ham? Namiho chu asopihou nung adelnauva kona akinungle kitna diuva naseipehna ding phat chu itih hiding ham? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Joab'in, Hingjing Pathen mina kasei ahi, Nangman ima na naseilou, hile thonlouva jingkah lama chu amitakipmin asopi nung adellou dingu ahitai, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun Joab'in sumkon amutnin ahile mijouse adingden taovin; chule Israel nung chu adeltapouvin, chule satjong akisatpi tapouvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Abner le aloiho chu hiche jan chun phaicham ajot peh-un, chule Jordan agalkaijun, Bithron pumpi achonsoh-un, Mahanaim'ah ahungtaovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Joab chu Abner ajuina-a konin ahung kinungle kittan, miho jouse chu akhop khoma ahile, David sohte mi somleko toh Asahel chu alhasamtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahinla David sohte chun Benjamin mi Abner miho chu jathum le somgup athatnun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin amahon Asahel longchu apuvin, Bethlehem'a um apa kivuina ding lhanna chun avuitaovin ahi. Chuin Joab le amite jankhon akitolun, jingkho vah-in Hebron ahunglhung taovin ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Saul insungle David insung miho kikah-a chun gal sottah aumtan ahi. Ahinla David chu ahatcheh ahatcheh-in, Saul insung chu ahatmo cheh ahatmo cheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Hebron khopi-a David'in chapa phabep ahingin: achapa apeng masapen chu Amnon ahin, Jezreel mi Ahinoam toh ahin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule achapa ni chana chu Chileab ahin, Karmel mi Nabal inneipi Abigail hin ahi: chule athum channa chu Absalom ahin, Geshur lengpa Talmai chanu Maakah chapa ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ali channa chu Haggith chapa Adonijah ahin, chule anga channa chu Abital chapa Shephatiah ahi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule agup channa chu Ithream ahin, David jinu Eglad hin ahi. Hichengsehi Hebron khopi-a David'in chapa ahin hochu ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, Saul insung le David insung kikah-a gal aum sungchun, Abner chu amatah Saul insung miho-a dingin akisuhat nin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Saul'in thaikem khat aneijin, amin chu Rizpah ahin, Aiah chanu ahi. Chuin Ishbosheth'in Abner henga Ipidinga kapa thaikemnu chu naluppi ham? atin aseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun Abner Ishbosheth thusei jehchun alunghang lheh jengtan, ajah-a, Keima hi Judah te uicha lu beh kahim? Tunin keiman napa Saul insung, asopiho heng, aloi agolho henga kitahna kamusah-in, chule David khutna jong kapedoh pon nahi; ahinla nangman numei khat chungchanga nei themosah nalai ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen ahenga akihahselna bang banga keiman David achunga kabol louva ahile, Pathen'in Abner chunga abolnom nom bol henlang, akalvalin jong bolhen;
  </para>
  <para style="p">
    <verse number="10" style="v" />Lenggam chu Saul insunga kona toldoh-a, chule Israel le Judah chunga David laltouna chu Dan'a pat Beersheba geija tundohna dinga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman Abner chu thusei cheng khatcha adonbut theipon ahi, ajehchu aman amachu akichan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Abner'in ama thalhengin David henga sottol ho asollin, ajah-a, Gamsung hi koijapen ham? aman aseiben, Keimatoh kitepna neijin, chule ven, Israel jouse nahenga hinpuilut nadinga kakhut hi nangma to pangkhom ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman, Aphai, keiman nangma toh kitepna kaneiding ahi: ahin keiman nahenga thilkhat kangaichat aume, hichu, Keimatoh kimuto dinga nahung tengle Saul chanu Michal nahin puimasat loule kamai namu louhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin David'in Saul chapa Ishbosheth henga sottol ho asolin, ajah-a, Philistine te chep jakhat mana kaji dinga kanahol kajinu Michal chu neipedoh-in, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Ishbosheth'in mi asolin, a-inneipu Laish chapa Phaltiel'a konin agapuidoh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ajipa chun kappumin amanu nungchu Bahurim geijin ahinjuijin ahi. Hichun Abner'in ama henga, Kinungletan, ati. Chuin ama akilekit tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Abner chu Israel upaho toh akihou khomin, ahenguva, Phat chomkhat masang jepchun nanghon David chu nachung uva leng dingin nanaholun;
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun hichu boltaovin; ajehchu Pakaiyin David chungchanga, Kasoh David khutna kona keiman kami Israelte hi Philistinte khutna kon le amelma jouseu khutna kona kahuhdoh ding ahi, tia asei ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Abner'in Benjamin mite henga jong aseijin ahi. Chuin Abner chu Israel le Benjamin insung pumpi-a dinga apha dinga kilomho seidingin Hebron khopi'a David henga achen ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun Abner chu Hebron khopi-a David henga mi somni toh ahungin ahi. Chuin David'in Abner le amatoh alhonpi miho-a ding chun golvah abolin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Abner'in David henga, Keima kipat in chengting, chule amahon nangma toh kitepna asemtheina dingu le, nalunggot jouse banga vai nahom theina dingin, ka pakai le ka lengpa dingin Israelte jouse gakhom khominge, ati. Hitichun David'in Abner chu asoldoh-in, ama lungnom tah-in achetan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin veuvin, David sohte hole Joab chu michoma achenaova konin ahung lhungun, chule thil kichomdoh tamtah ahinpouvin ahi: ahin Abner vangchu Hebron'a David toh anaum tapon ahi; ajehchu aman ama chu asoldoh ahitan, lungmong tah-a che-a ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Joab le aumpi mipi janel chu ahung phatnun, amahon Joab henga, Ner chapa Abner chu lengpa henga ahungin, chuin aman amachu asolmangin, chule ama lungmong tah-in achetai, atiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Joab chu lengpa henga ahungin, ajah-a, Nangma ipi bol nahi hitam? Ven, Abner nahenga ahungin; ipidinga amachu nalesol kitna, chule ama chemanga hitam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ner chapa Abner chu nalhemlha dinga, nahunglut napotdoh heding le, nabol jouse hedinga hunga ahichu nangman nahenai, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Joab chu David koma kona ahung potdoh nungin, Abner nunga chun sottol ho asolin, chuin amahon amachu Sirah twikul'a konin ahinlepui kitnun ahi; ahinla hichu David'in ahepon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Abner chu Hebron'a ahung kilekit phatnin, kotpi phunga chun Joab'in atumbeh-a kihou pidin apuijin, chuin asopipa Asahel thisan phulahnan, anahgu nga channa noitah chu asutna ahile, athitan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin chomkhat jouvin David'in hichu ajahdoh phatnin, hitin aseitai, Ner chapa Abner thisan chungchanga hin keima le kalenggam hi Pakai angsunga a-itih-in themona kaneipouve,
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichehi Joab chung le apate insung jouse luchunga lhungjohen; chule Joab insunga konin thisan longa damlou, aphah, tenggola kingai, chemjam'a louva, ahiloule changlhah lhahsam ma kichat hihhen, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hitichun Joab le asopipa Abishai chun sopipalhon Asahel chu Gibeon galmuna anatha jehchun Abner chu athat lhontan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin David'in Joab le ama umpi miho jouse henga chun, Naponhou jouse botkeh-unlang, nataiju chu khaodip ponin kigah-un, chule Abner masanga chun lunghemun, ati. Chule David amatah-in mithi kong chu ajuitan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin amahon Abner chu Hebron'a avui taovin: chuin lengpa awsang tah-in Abner lhanna chun akaptan, chule mipi jouse jong akaptan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin lengpan Abner chu akachamin, hitin ati, Abner hi mingol thia thiding hitam?
  </para>
  <para style="p">
    <verse number="34" style="v" />Nakhut teni la akikanpon, nakeng teni jongla akisom poi; miphalouho anga mihem khat alhuh jeng bangin, nangma nalhu jengtan ahi, ati. Chuin mipi chu ama chunga akapkit taovin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule sun ahipetna an nehsah ding mipi chu David henga ahung phatnun, David akihahselin, Nisalhum kah-a keiman changlhah le thildang katepma ahile, Pathen'in kachunga hitihin bolhen lang akhoh cheh-in jong eibolhen, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin mipi ho chun ahethemun, alunglhai taove; lengpan bol jouse-a chu mipi ho lunglhaija ahiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ajehchu hiche nikho-a chu mijousele Israelte chun Ner chapa Abner kitha chu lengpa lunglam ahilou chu ahetnu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin lengpan asohte henga, Tunia hi Israel sunga pipui le milen khat lhuh-a ahi ti helou nahiuvem?
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule keima lengdinga thao kinu kahi jeng vangin, tuni hin katha alhasam lheh-in ahi; chule hiche miho Zeruiah chapate hi keima dingin akhoh behseh jengun ahi. Pakaiyin thilphalou bolhohi aphatlounao natoh dungjuija alethuh dingu ahi, ati.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Saul chapan Hebron'a Abner athi tai ti ajah phatnin, akhut teni angoilhan, chule Israel pumpi jouse alunggim taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Saul chapan loilah-a gal lamkai mini aneijin: khatpa minchu Baanah ahin, chule khatjopa minchu Rechab ahi, Benjamin phunga Beeroth mi Rimon chapateni ahilhone, (ajehchu Beeroth jonghi Benjamin'a kisim ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Beeroth miho chu Gittaim'a jamlut uva, chule hiche munna chun tunikho geija khopemden ahitaove).
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Saul chapa Jonathan'in chapa khat aneijin amachu akengbai ahi. Jezreel'a kona Saul le Jonathan chungchang thu ahungchun amachu kumnga ahitan, ama jenlea pangnu chun amachu apuija ajampi ahi. Chule hitihi hija ahi, amanun mangang tah-a ajampi laitah-a amapa kiseplhu-a, akeng kibai ahi. Chule amapa minchu Mephibosheth ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Beeroth mipa Rimmon chapateni Rekab le Baanah chu akipat lhonin, hiche sun nisa noija chun Ishbosheth in'a ahung lhonin, amapa chu suna alupna-a ana lumin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amani suhlou chang hamding bangin insunga alutlhonin; amapa nahgu nga channa noitah chu asun lhonin: chuin Recab le asopipa Baanah chu ajamdoh lhontan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu amani insunga ahunglut lhonchun, amapa alupna dansung alupna-a analumin ahi, chuin amanin amachu avo lhonin, athat lhonin, alu atan lhonin, chule alu chu ahinchoi lhonin jankhovah-a phaicham lampia chun ahin jampi lhonin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amanin Ishbosheth luchang chu Hebron'a David henga ahinpo lhonin, lengpa henga, Ven, nahinkho lahdinga gopa namelmapa Saul chapa Ishbosheth luchang ahi; ka pakai le ka-lengpa dinga hi tunia Pakaiyin Saul le achilhahte chunga phu nalahpeh ahitai, atilhone.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin David'in Beeroth mi Rimmon chapateni Recab le asopipa Baanah chu adonbutnin, ajah lhona, Kaki lungdoupi ho-a kona kahinna huhdohpa, hingjing Pakai mina kasei ahi,
  </para>
  <para style="p">
    <verse number="10" style="v" />Mikhatnin kahenga kipana thupha hinlhut dana akingaitoa, Ven, Saul chu athitai atichun; athupoh jeh-a kipaman kapeh dinga kinempa chu keiman kamanin, Ziklag'ah kathat tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Achutile migilou hon michonpha khat a-insunga alupna chunga atha chungchanga hi ichana khohcheh-a kibolding hitam? Tu-a hi keiman amapa thisan hi nakhut lhona kangeh-a, leisetna kona kasuhmang lhonlou dingham? ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin David'in agolhangho chu thu apen ahile, amahon amani chu athatnun, akhutlhon le akenglhon atanbongun, Hebron'a um twikul chung khatna akhai taovin ahi. Ahin amahon Ishbosheth luchang chu alauvin, Hebron mun'a um Abner lhanna chun avuitaove.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israel phung jouse Hebron'a David henga ahungun, ahenga, Ven keihohi nagu le naphe jeng kahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule masanga Saul keiho chunga lenga anapan laija patna, Israel gamsunga keiho eipuidoh uva le eipuilut uva nahi; chule Pakaiyin nahenga, Ka kelngoi Israelte hi navah ding, chule nangma Israelte chunga gallamkai nahi ding ahi, tin aseijin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun Israel upaho jouse chu Hebron'a lengpa henga ahungun: chule David lengpan Hebron'a Pakai angsunga amatoh kitepna khat aneipin: chuin amahon David chu Israel pumpi chunga leng dingin thao anu taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />David alengchan kipatchun ama kum somthum ahitan, chule kum somli aleng changin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hebron'a Judah te chunga kum sagile lhagup aleng changin, chule Jerusalem'a chun kum somthum le kumthum Israel le Judah chunga aleng changin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin lengpa le amite chu chuche gama um Jebus mite chenna Jerusalem'a chun acheuvin; amaho chun David henga, Mitcho le elbai nalahdoh masat loule hichea hi nahunglut theilou diu ahi, atiuvin ahi; ajehchu amahon David chu khopi sunga hin hunglut jou ponte, tia anagelu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahijeng vanginla David'in Zion mundet pen chu alatan: hichu David khopi ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin hiche nikho chun David'in, Koi hijongle twilama kaltouva, Jebus miho le, David hinna-in adou mitcho le elbai ho gathat penpenpa chu lamkai pipuile gal lamkai hiding ahi, ati. Hijeh-a chu amahon, Mitcho le elbai insunga hunglut theilou ding ahi, atiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun David kulpi sunga chun achengin, chule hichu David khopi asahtai. Chuin David'in Millo'a pat asunglamsea chun kul akaikhum tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin David chu ahung khangtou chehcheh in, janel Pakai Pathen'in aumpin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Tyre lengpa Hiram'in David henga sottol ho, chule cedar thingho, thingthem bolhole, song kheng themho ahinsolin ahi: chule amahon David dingin in asahpeh uvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin David chun Pakaiyin Israelte chunga lengdinga atundoh ahichu ahetan; chule alenggam jong chu ami Israelte jal-in achoi lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ama Hebron'a kona ahungdoh jouchun, David'in Jerusalem'a konin aji dingle athaikem akipuiben: chule David'a dingin chapate le chanute apenbe nalaijun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hichengsehi Jerusalem'a aumsunga pengho achate minchu ahi, Shammuah, Shobab, Nathan le Solomon,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Ibhar, Elishua, Napheg le Japhia,
  </para>
  <para style="p">
    <verse number="16" style="v" />Elishama, Eliada, chule Eliphalet ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin Philistine ten David chu Israelte chunga leng dingin thao anutaove ti ajah phatnun, Philistinte jouse chu David holding chun ahung taovin; chule David'in hichu ajan, kulpidet lamma chun achesuhtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Philistinte jong chu ahungun Rephaim phaichama chun akithecheh taovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin David'in Pakai adongin, Keima Philistinte dou dinga kachetou dingham? Nangman amaho kakhutna neipeh doh dingham? ati. Chuin Pakaiyin David henga, Chetouvin; ijeh inem itile keiman tahsanlelna beihela Philistinte chu nakhutna kapeh dohding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin David chu Baal-perazima ahungin, chule David'in hilaija chun amaho chu ajouvin, chuin aman, Pakaiyin kamelmate chu kamasanga twi kiphijah bangin asukeh jengtan ahi, ati. Hijeh chun aman hiche munchu Baal-perazim asahtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon hia chun amilimhou chu adalha taovin ahile, David le aloihon ahalha taovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Philistine ho chu ahung kontou kitnun, chule amaho Rephaim phaichama chun akithecheh-un ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun David'in Pakai adongin ahile, aman, Nangma nakontou louding ahi; amavang nangman amaho nunglama kona nahin velkola, thingtheimi phungho maidon tah-a chu achunguva nachuh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hitiding ahi, nangman thingtheimi phungho chunga mipi kitol gin najah tengle, malam nanoding ahi; ijeh inem itile hiche phat chule Pakai chu Philistine janelho thatgam dinga namasanga cheding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin David'in jong Pakaiyin athupeh bangchun aboltan; hitichun aman Philistinte chu Geba'a pat Gezer geijin athat tan ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David'in Israel mi akilhengdoh sangthum hochu akhom khomin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun David akipatdoh-in, aumpi jouse toh Juda gam Baale'a konin, Cherubim teni kikah-a um janel ho Pakai minna kikou, Pakai thingkhong chu gapotou dingin ache taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahon Pathen thingkhong chu bongkang thah khat chunga akoijun, Gibeah kho-a cheng Abinadab in'a konchun ahin podoh taovin ahi. Hitichun Abinadab chapateni Uzzah le Ahio chun hiche bongkang thah chu ahintol lhonin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahon Pathen thingkhong chu Gibeah kho-a Abinadab in'a konin ahinpodoh-un; Pathen thingkhong chutoh ahung kilhonpeh-un, chule Ahio chu Pathen thingkhong masanga chun achen ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David le Israel insung mijouse chun Pakai masanga chun chahthinga kisem manchah jatchom chomho, selangdah, tumgingtheiho jouse, khongchaho, sumkon bineiho, chule thih khutbeh ho atum gingun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amaho Nacon pholmun ahunglhun phatnun, Uzzah chun Pathen thingkhong lama chun akhut ajahdoh-in, atuh-in ahi: ajehchu bongchal teni chun hichu athin lhon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakai lunghanna chu Uzzah chunga ahung koujah jengin; chuin Pathen'in athemona jeh-in hikoma chun ajepmin; chule ama Pakai Pathen thingkhong koma chun athitan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakai Uzzah chunga achuh jehchun David alung nommo lheh jengtan; hiche mun chu Perezuzzah asah-in, tunigeijin akisah tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin hicheni chun David'in Pakai akichan, Pakai thingkhong chu kahenga iti hung thei dingham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun David'in Pakai thingkhong chu ahenga David khopi sunga pohlut ding anomtapon; ahinla David'in hichu Gitt mi Obed-edom insunga chun apolut tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakai thingkhong chu Gitt mi Obed-edom in'a chun lhathum aumin; chuin Pakaiyin Obed-edom le a-insung pumpi chu phatthei aboh tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin David lengpa jah-a, Pathen thingkhong jal-in Obed-edom le a-insung pumpi le anei agou jouse phatthei achang tai, ti akiseipeh tan ahi. Hijeh chun David achen, Pathen thingkhong chu Obed-edom in'a konin kipah tah-in David khopi-a ahin potou tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin anahitin ahi, Pakai thingkhong puhon kalgup ason jouvun, aman bongchal le gan kivahthaova ganlhainan abolin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin David chu Pakai angsunga chun athanei chasunin alamin; chule David chun tupat ponnem thempu sangkhola atai akigah ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun David le Israel insung miho jouse chun aw thongjeju le sumkon ginto thon Pakai thingkhong chu ahin putouvun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Pakai thingkhong chu David khopi sunga ahung lhunto lhonin, Saul chanu Michal'in bangkotna konin ahinven ahile, David lengpa Pakai masanga akhut alea alam chu amutan; amanun alungthimin amuneo lheh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amahon Pakai thingkhong chu ahinpolut nun, aumna dinga David'in anasah ponbuh lailung tah-a chun akoitaovin ahi. Chuin David'in Pakai anga govam thilto le chamna thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin David'in athilto, govam thilto le chamna thiltoho achai phatnin, aman mipi hochu Pakai janel minin phatthei aboh tan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin David'in mijouse le Israel mite jouse chu, anumei apasal'in changlhah lum khatcheh le sachan khatcheh, chule lengpitheija kisem changlhah khatcheh ahoppeh'in ahi. Hitichun mijouse chu a-inlam cheh uva achetauvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin David chu a-insung miho phatthei bohdingin ahung kiletan ahi. Chuin Saul chanu Michal chu David kimupi dingin ahungdoh-in, ahenga, Tunia Israelte lengpa pannabei mijahmo tah khat asagoh-a aum banga, tunia asoh numei ho mitmu-a asagoh-a aum jengchu iti loupi hitam! ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin David'in Michal jah-a, Pakai mite Israelte chunga vaihom dinga eitungdohpa, napa le a-insung miho jouse khella eilhengdoh pa Pakai masang ahi; hijeh achu Pakai masanga lamding kahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hiche sunga kamelse cheh ding, chule kamitmu-a kakisuhnem ding ahi. Nangman nasei soh numei ho chungchanga vang, keima amaho jabola kaum ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun Saul chanu Michal chun athini geijin cha aneitapon ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, lengpa insunga atouva, Pakaiyin akimvela amelmaho-a konin choldona apeh phatnin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutichun lengpan themgao Nathan henga, Tun vetemin, keima Cedar in'a kachengin, ahin Pathen thingkhong chu ponbuh maimai sunga aumin ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Nathan'in lengpa henga, Chenlang nalunga umjouse chu gaboltan, ajehchu Pakaiyin na-umpinai, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin chuche janchun ahitin ahi, Pakai thu chu Nathan henga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chenlang kasoh David jah-a, Nangman keima dinga kachenna ding in khat neisahpeh dingham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman Israel chate Egypt gama kona kahin puidoh ni-a pat tuni geijin in'a kachengpon, amavang ponbuh sungle houbuh sungabou kachen ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima Israel chateto kana valena mun jouse-a, kami Israelte vahdinga kathupeh Israel phungho henga thu kanaseija, ahenguva, Ipi dinga nanghon keima dinga Cedar thinga in khat neisahpeh louvu ham tia kanasei khah-em?
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu tuahi nangman kasoh David henga hitia hi nasei ding ahi, Janel Pakaiyin hitin aseije, Keiman nangmahi kelngoi lhatna hamhing lah-a kelngoi najuina-a kona kamite Israelte chunga vaihom dinga kalhendoh nahi:
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keiman nachena chana kalhonpin, namitmu-a konin namelmate jouse kasumangin, leiset chunga miminthang ho minkhat bangin namin kathansah tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche chungvuma chu keiman kami Israelte dinga chu munkhat kalhendoh pehding, chule amaho agam mong monguva achenuva, akichon lele tahlou nadinguva kaphudet dingu; chule masanga banga migilou chaten jong asuhgenthei tahloudiu;
  </para>
  <para style="p">
    <verse number="11" style="v" />Kami Israelte chunga dinga thutan ho kana thupeh laija patna ana chutiu ahin; chule namelmate jouse-a konin kakicholdo sahtan ahi. Chujongle Pakaiyin nahenga na-insung katundoh pehding nahi ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nahin nikhoho ahunglhina, nangma napu napate toh nalupkhom tengle, keiman nanunga nachilhah, nangma taijola mong monga peng khat katundoh ding, Chule keiman alenggam kaphudet ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama chun kamina in khat asah ding, chule keiman alenggam chu atonsotna dinga kaphudet ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima apa kahi ding, chule ama kachapa hiding ahi. Aman khangit louna aneija ahile keiman amachu mihem sehgimna tenggol le mihem chate kajepna-a chu kasehgim ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amavang namasanga kona kachondoh Saul'a kona kalahmang banga, kami hepina chu ama-a kona kalahmang louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule na-insung le nalenggam chu a-itih a dinga namasanga kiphutdet ding; na laltouna jong a-itih-a dinga kiphutdet ding ahi, tin gaseipeh-in ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hicheng thuho dungjui le hiche gaothilmu ho dungjui hin Nathan'in David chu aseipeh tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin David lengpa chu alutnin, Pakai masanga atouvin, hitin aseije, Vo Pakai Pathen, keima koi kahi ham? chule ka-in chu ipiham hija nangman hichan geija neipuiham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule vo Pakai Pathen, hichehi nangma dinga thil neocha bou ahinalaijin; chule nangman khonungpeh-a nasoh insunga hunglhung ding jong naseijin ahi. Chule Vo Pakai Pathen, hichehi mihem chonna dan ngaimong hinam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule David'in nahenga ipi aseibe dingham? Ajehchu Pakai Pathen nangin nasoh hi nahenai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu nathu jal le nangmatah lung ngaito dungjuija, hiche thil loupitahhi nasoh-in ahetthei nadinga nabol ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun vo Pakai Pathen, nangma naloupin ahi: ajehchu keihon kanaova kajah dungjuijun nangma tobang aumpon, nangma tailou Pathen dang aumpoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule leiset chunga hi nami Israelte tobanga namkhat Pathen'in nangma-a hidinga Egypt gama kon, namtin le a-pathen hou lah-a kona, namite hiding le namin loupi sah ding, chule nangma dinga thil loupitahho le nagama dinga tijat umtahho boldinga nalhatdoh umkham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu nangma tah-in nami Israelte hi a-itih-a namite hidinga nanamdet ahitan: chule Pakai, nangma a-Pathen'u nahung hitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule tun, vo Pakai Pathen, nasoh chungchang le a-insung chung chang thua nasei thuhi a-itih a dingin phutdet ninlang, naseibang chun boltan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Janel Pakai hi Israelte Pathen ahi tin namin hi a-imatih chanin choisangin umhen lang: chule nasoh David insung hi namasanga kiphutdet hen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu nangma Vo janel Pakai le Israel Pathen'in nasoh henga naphong doh-in, Keiman na-insung katundoh ding ahi tin naseije. Hijeh-a chu nasoh hin hiche taona neina dinga hi alungsunga hansana amu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule tun, vo Pakai Pathen, nangma Pathen nahin, chule nathu hohi thutah ahin, chule nangman hiche phatna hi nasoh henga nahahsel in ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijeh chun tun a-itih-a namasanga aumjing nadin, nasoh insung phatthei naboh dinghi nalung lhaina hihen:ajehchu vo Pakai Pathen, nangman hichehi nasei ahitai; chule nangma phatthei bohna-a chun, nasoh insunghi a-itih-in phatthei changjing tahen.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche jouchun ahitin ahi, David'in a Philistinte chu asatnin, amaho chu asunemin ahi. Chuin David'in Metheg-ammah chu Philistinte khutna konin aladohtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman Moab asatnin, chule amahochu tolla alupsah-in, khaovin aten; thading ho chu golni in aten, chule hinghoi dingho chu golkhat lhingsetnin aten ahi. Chutichun Moab mite chu David soh-in ahung pangun, thilpeh ahinchoi jiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David Euphrate luidunga agamgi lelah dinga achea chun, aman Zobah lengpa Rehob chapa Hadadezer jong chu athatnin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David'in amapa-a konchun sakol kangtalai sangkhat le sakol sepai jasagi, chule keng sepai sangsomni ahinlan ahi. Chuin David'in sakol kangkai jouse chu asubaijin, ahinla sakol kangtalai jakhat kaiding vang akhendoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Damascus'a Syria mite chu Zobah lengpa Hadadezer kithopi dingin ahungun ahile, David'in Syria mite chu sangsomni le sangni athatnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin David'in Syria'a um Damascus'a chun sepai tampi akoitan ahi. Chuin Syria mite chu David soh-in ahung pangun, thilpeh ahinchoi jiuvin ahi. Chule Pakaiyin David chu achenna jouse-ah aveng jingin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David'in Hadadezer sohpa khutna um sana lumdal chu alan, Jerusalem'a ahin polut tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Hadadezer khopi Betah le Berothai'a konin, David lengpan sum-eng tamtah ahinpon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hamath lengpa Toi'in David lengpan Hadadezer janel jouse athattai ti ajah phatnin,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun aman Hadadezer asatna ajo jehchun, Toi'in ama chibai bohding le phatthei bohdingin achapa Joram chu David henga ahinsolin ahi; ajehchu Hadadezer chu Toi toh anakigal jinga ahi. Chule Joram'in dangka, sana, chule sum-eng kong le belho ahinpon:
  </para>
  <para style="p">
    <verse number="11" style="v" />Hicheho chengse chu David'in asuhnem namtin jouse-a kona alah dangka le sana jouse chutoh Pakai henga atohdoh-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hicheho chu Syria'a kon, Moab'a kon, Ammon chate'a kon, Philistinete-a kon, Amalek'a kon, Zobah lengpa Rehob chapa Hadadezera'a kon galthil kichomho ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin David'in chi phaicham mun'a Syria mite sangsom le sangget atha-a ahung kinunglekit chun amin athang tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman Edom'a sepai tampi akoijin, Edom gamsung jouse chun sepai akoisoh keijin, chuin Edom mite jouse David sohte ahung hitaovin ahi. Chule David chu Pakaiyin achena jouse-a avengbit jingin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin David'in Israel pumpi chunga vai ahomin; chule David'in amite jouse chunga chun phatah le dihtah-in na atongin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Zeruiah chapa Joab chun janel chunga vaipo ahin; chule Ahilud chapa Jehoshaphat chu thuching ahin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahitub chapa Zadok le Abiathar chapa Ahimelech chu thempu ahilhonin; chule Seraiah chu danthu sun ahin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Jehoiada chapa Benaiah chu Chereth mite le Peleth mite chunga vaihomin apangin; chule David chapate chu vaihom pipun apangun ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David'in, Jonathan khohsahna jala hepina kamusah ding Saul insungmi khatbeh akikhendoh umlou ham? ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Ziba kiti Saul insungmi lah-a soh khat aumin ahi. Chuin amahon amachu David henga akouvun, chuin lengpan ajah-a, Nangma Ziba nahim? ati. Chuin aman, Nasohhi amachu kahinai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpan ajah-a, Achunga Pathen mihepina kamusah ding Saul insungmi khatbeh umlou ham? ati. Chuin Ziba'in lengpa henga, Jonathan chapa khat aumin, amachu kengbai ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lengpan ajah-a, Amachu hoilaija umam? ati. Chuin Ziba'in lengpa henga, Ven amachu Lodebar kho-a um Ammiel chapa Machir in'a aumin ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David lengpan mi asolin, Lodebar kho-a um Ammiel chapa Machir in'a konchun agapuidoh tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun Saul chapa, Jonathan chapa Mephibosheth chu David kom ahunglhun phatnin, ama aboh khupmin jana apen ahi. Chuin David'in, Mephibosheth, ati. Chuin aman, ven nasohhi! tin adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David'in ajah-a, Kicha hih-in: ajehchu keiman thonlouva napa Jonathan khohsahna jala nangma hepina kamusah ding, chule napu Saul gam sese jong kalepeh kitna, nangma tanglou hela kadokhang chunga changlhah naneh jing ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ama akunin, Nasohhi ipi kahia, chule uicha thisa tobang keimahi nei khohsah ham? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin lengpan Saul sohpa Ziba chu akouvin, ajah-a, Saul neijouse le a-in jouse napakai pa chapahi kapeh ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh-a chu nangma le nachapate, chule nasohten amadinga leiset chu nalhopeh diu, chule napakai pau hin nehding an aneitheina dinga agasoh hochu nahin pohdiu ahi: ahin napakai pao chapa Mephibosheth hin phattina kadokhanga changlhah anehding ahi, ati. Tun Ziba'n chapa somle ngale soh somni aneijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichun Ziba'n lengpa jah-a, Ka pakai lengpan asoh athupeh dungjuija hi nasoh-in kabol ding ahi, ati. Mephibosheth chungchanga, lengpan hitin ati, aman kadokhang chunga chapateho khat banga an anehding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Mephibosheth'in chapa khangdong khat aneijin, amin chu Mica ahi. Chule Ziba insunga cheng jouse chu Mephibosheth soh ahi taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun Mephibosheth chu Jerusalem'a achengin ahi: ajehchu aman tanglou helin lengpa dokhanga anen; chule ama akeng ni-a baija ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche jouchun ahitin ahi, Ammon chateho lengpa chu athitan ahile achapa Hanun chun ama khelin lengvai apotan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David'in, Apan kachunga hepina eimusah banga, keima jong Nahash chapa Hanun chunga hepina kamusah ding ahi, ati. Hitichun David'in apa chungchanga ama lhamon ding chun asohte asoltan ahi. Chuin David soh ho chu Ammon chate gama chun ahunglut taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Ammon chate pipuho chun apakaipao Hanun jah-a, David hin napa ajana jala lhamonsah hohi ahinsol ahi hinte tia nagelem? David hin khopi hi ajotheina dinga akholtoh dingle, avelhi ding joh-a ahinsol hilou ham? atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun Hanun'in David soh ho chu amanin, akhamulu akeh langkhat avolhahpeh-in, chule aponchenu chu akimlaitah, ato don laitah-u chu achetanpeh-in; chuin amahochu asolmang tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin hichehi David aseipeh phatnun, aman amaho kimupi ding asolin ahi, ajehchu miho chu jahcha lheh jengu ahi: chuin lengpan, Nakhamulu asaodohkit kahsen Jericho-a umunlang, ahung saodoh tengle hung kinunglekit taovin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Ammon chaten David angsung kidah umtah ahiu amudoh phatnun, Ammon chate chun Bethrehob'a um Syria mite, Zobah'a um Syria mite keng sepai sangsomni, Maakah lengpa-a kon mi sangkhat, chule Ishtob'a kon mi sangsom le sangni athalah-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David'in hichu ajah phatnin, Joab le amihat janelho chu asoltan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Ammon chate chu ahung kondoh-un, kotpi phung lutna-a chun galsat dingin akigolun: Zobah'a um,Rehob'a um, Ishtob'a um le Maakah'a um Syria mite chu amaho le amaho loujaova aumun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joab'in galchu anung le ama-a aum amu phatnin, Israel mi lhentum cheh chu alhengdoh-in, amaho chu Syria te toh kisat dingin akigolsah-in:
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule adangho sese chu asopipa Abishai khutna Ammon chate toh kisat dinga agoltoh dingin apedoh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman, Syria te chu keija dinga ahat behseh uva ahile, nangman neikithopi ding; ahia Ammon chate chu nanga dinga ahat behseh uva ahile, keima kahunga kahung kithopi ding nahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hangsanun, eiho imiteu dingleh i-Pathen'u khopiho-a dingin pangu hite: chule Pakaiyin amitmu-a pha asah bang bangin bolhen, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Joab le aumpi miho chu Syria mite to kisat dingin galmun anailut taovin ahile, amaho chu amasanga chun ajam taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Ammon chate chun Syria mite jam chu amu phatnun, amaho jong Abishai masanga chun ajamun, khopi sungah aluttaovin ahi. Hitichun Joab chu Ammon chate-a konchun ahung kinunglen, Jerusalem'a ahungtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Syria miten Israelte masanga agal lel'u chu amuphatnun, amaho akikhom khom taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Hadadezer'in mi asolin, luipi galla um Syria mite chu agapuidoh-in ahi. Chuin amaho Helam'a ahungun, chule Hadadezer janel gal lamkai Shobach chu amaho masanga achen ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hichethu hi David aseipeh phatnun, aman Israelte jouse akhom khomin, Jordan agalkaijun, Helam mun'a ahungun ahi. Chuin Syria mite chu David doudingin amaho le amaho akigol toh-un, ama chutoh akisat taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Syriaho chu Israel masanga chun ajam taovin; chule David'in Syria miho sakol kangtalai tolmi jasagi le sakol sepai sangsomli, chule ajanelhou lamkai Shobach jong chu athatnin, hiche mun'a chun athitan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Hadadezer soh-a um lengho jouse chun Israelte masanga agal lel'u chu amu phatnun, Israelte toh chamna abollun, amaho jenle-in apang taovin ahi. Hijeh chun Syria miten Ammon chateho kithopi kit ding chu akicha taovin ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, kum ahung kichaina, lengho galkon phat laitah-in, David'in Joab le aumkhompi asote chule Israel mite chu asolin; chuin amahon Ammon chate asumangun, Rabbah khopi aum uvin ahi. Ahinla David Jerusalem'a aum jingin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin nilhah langin ahitin ahi, David chu alupna-a konin athoudoh-in, leng in chunga chun avahle len ahi. Chuin aman in chunga konchun numei khat akisilpet amun, chule hiche numeinu chu vetdinga melhoitah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David'in mi asolin amanu thudol agakholchil sah-in ahi. Chuin mikhatnin, Hichehi Hit mi Uriah inneipi Eliam chanu Bathsheba hilouham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David'in thupole ho khat asolin, amanu agapuisah tan; chule amanu ahenga ahungin, aman amanu aluppitan ahi; ajehchu amanu chu athen louna-a kona kisuthenga ahin: chuin amanu a-in lama akile kittan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amanun nao avop phatnin, David henga mi asolin, Nao kavoptai, agati sah-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin David'in Joab thu athotnin, Hit mi Uriah chu neihin solpeh-in, ati. Chuin Joab'in Uriah chu David henga ahin soltan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Uriah ahenga ahung phatnin, David'in Joab le mipite chu iti naovem, chule galchu itobanga machal jinga hinam tin adongin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin David'in Uriah jah-a, Na-in lama chesuh inlang, nakeng kisilin, ati. Chuin Uriah chu lengpa in'a konin akipatdoh-in, chule lengpa-a kona nehding thilpeh ho-in anung ajuisuh paijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin Uriah chu lengpa in kotkhah bula chu a-pakaipa sohte chutoh alum denin, a-in lama chun achesuhpon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amahon Uriah chu a-in lama achetapoi tia David aseipeh phatnun, David'in Uriah jah-a, Nakholjin na-a kona nahung hilouham? ipidinga na-in lama chu chesuh louva nahim? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Uriah chun David henga, Pathen thingkhong le Israel chule Judah pon in'a aumun; chule ka pakaipa Joab le ka pakaipa sohten gamlah-a gebuh akisonun; keima ane dingle adonding, chule kaji toh lumkhom dinga ka-in'a kache dingham? Nangma nahina nalhagao ahinlaisen keiman hiche tobang thil hi bolponge ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin David'in Uriah henga, Tunin jong hiche mun'a hin umkit tan, chule jing tengle keiman kipatdohsah nange ati. Hijeh chun Uriah chu Jerusalem'a hicheni chun chule ajing geijin aumtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin David'in ama akou phatnin, aman ama masanga chun anen adonin, chuin aman ama chu adonkhamsah tan ahi. Chuin nilhah lamin a-pakaipa sohtetoh jalkhuna lum dingin achen, ahin a-inlanga vang achesuh pon ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin jingkah-in ahitin ahi, David'in Joab henga dingin lekha khat asunin, hichu Uriah khutna athottan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman lekha chunga chun asunin, Uriah chu galmun khohpen masanga chun pansah-in, amachu akisuhkhah -a athitheina dingin, ama-a konin kinung chonun, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule ahitin ahi, Joab'in khopi chu aum laijin, Uriah chu galhat miho umna-a ahet munkhatna chun apansah-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin khopi sunga um miho chu apotdoh-un, Joab toh akisat taovin ahi: chule hiche mun'a chun David sohte mipi ho lah-a phabep khat alhutaovin; chule Hit mi Uriah jong chu athitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Joab'in gal chung chang thu jouse David gaseipeh dingin mi asoltan;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman thupolepa chu thu apen, Nangman lengpa henga gal umchan thuho jouse nagasei soh tengle,
  </para>
  <para style="p">
    <verse number="20" style="v" />Lengpa alunghana, nahenga, Ipidinga kisatpi dinga khopi chu nachuti nailut jengu ham? Banga kona nahin kap dingu chu nanghon nahetlouvu ham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Jerubesheth chapa Abimelech chu koiham athatna? Banga kona numei khatnin sumheisong halkhat aselhah khumleh ama chu Thebez mun'a thia hilouham? Ipi dinga nangho bang naija nacheu ham? tia asei tengle nangman, Nasoh Hit mi Uriah jong athitai, tia nasei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin thupolepa chu achen, Joab'in asol lona jouse chu David henga aseitan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin thupolepa chun David henga, Tahbeh-in miho chun keiho eihinjou jouvin, chule loujaova keiho lah-a lama ahungpotnun, keihon amaho chu kotpi phung lutna geijin kanung delun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin thalkap hon kulbanga konin nasohte lah ahin kapmun ahile lengpa soh phabep khat athitan, chule nasoh Hit mi Uriah jong chu athitan ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujouvin David'in thupolepa henga, Nangman Joab henga, Hicheho hin nangma nalungkham sah dahen, ajehchu chemjamin mikhat ahiloule adangkhat athateiji mong ahi: khopi douna-a chun nagalsat hatsah cheh inlang, khopi chu suse-in, tia naseija amachu natilkhou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Uriah jinun ajipa Uriah athitai ti ajah phatnin, ajipa pul adoutan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin alunghemna akichai phatnin, David'in amanu chu a-in'a agapuilut sah-in, chule amanu chu a-inneipi ahung hitan, chuin ama dingin chapa khat ahinpeh-in ahi. Ahin David thilbol chun Pakai alung lhaisah tapon ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin David henga Nathan asolin, chuin ama ahenga ahungin, ajah-a, Khopi khatna hin mini aumin, khatchu ahaovin, khatjohpa chu avaichan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihaopa chun kelngoi honle ganchahon tamtah aneijin:
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla mivaichapan akichoh-a avah kelngoinou anu khat tilouvin imacha aneipon ahi. Chule hiche kelngoinou amale achate toh thakhatna hungkhang len ahin, chule ama an ngei chu aneh-a, akhontah-a twi adona, ama angsunga lumma, chule amadinga chanu khat tobang hija ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin mihaopa koma chun kholjin vahlekhat ahungin, chuin aman akelngoi honho lah-a khatjeng chajong chu hiche kholjin ahung lhungpa thapeh dingchun aphalpon; ahin mivaichapa kelngoi chu alan, chuin aman ahenga hung mipa ding chun athapehtan ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche mipa chunga chun David lunghana chu akoujah jengin, chuin aman Nathan henga, Hingjing Pakai mina kasei ahi, hitobang thil bolla michu thiteiding ahi:
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hitobang abola, khotona anei loujeh-a, kelngoi chu ajatlia aleding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Natha'in David henga, Hiche mipa chu nangma nahi. Israel Pakai Pathen'in hitin aseije, Keiman nangmahi Israel chunga leng dinga thao kanua, chule Saul khutna kona kahuh doh-a;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule napakai pa insungle ajiteho chu nangma kapeh-a, chule Israel le Judah insung jong nangma kapeh nahin; ahin hiche chu lhombehseh ahia ahile, keiman nangma adang dang jong kapehbe nalai ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ipidinga nangman amitmua thilphalou bolna dinga Pakai thupeh chu nahsah louva nabol ham? Nangman Hit mi Uriah chu chemjamin nathatnin, a-inneipi chu naji dingin nakipuijin, chule ama Ammon chate chemjamin nathatnin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun tu-a hi na-insunga kona chemjam kiladoh louding ahi; ajehchu nangman nahsahmon neibolin, Hit mipa Uriah inneipi chu najidingin nakipuijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakaiyin hitin aseije, Vetan, Keiman nangma douna-a na-insunga thilphalou khat kasodohsah ding, chule najiteho chu namitmu-a kalahpeh-a, amaho chu na-inhengho kapeh ding, chule aman najiteho chu sunchang noija aluppi dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu nangman hichehi guhthima nabol ahin; ahinla keiman hichehi Israel jouse masangle sunchang noija kabol ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin David'in Nathan henga, Keima Pakai dounan kachonse tai, ati. Chuin Nathan'in David henga, Pakaiyin jong nachonsetna aladohtai, nangma nathi louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeng jongle hiche nathilbola konahi Pakai melmaten Pathen ataitomna ding uva phat gomkom napeh ahi jeh-in, nangma-a dinga penga nachapa chu thitei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Nathan chu a-in'a dingin akipatdoh tan ahi. Chuin Pakaiyin Uriah inneipin David ahinpeh chapang chu adengin ahile, hanatnin anatan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin David chapang dingchun Pakai henga ataovin; chule David'in an angolin, chuin insunga alutnin, jankhovah-in tolla alumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin a-insung upaho akipat doh-un, tolla kona ama gathoudoh dingin ahenga acheuvin ahi: ahinla ama thodoh ding anompon, chule amahotoh anjong anepon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, nisagi lhinin chapang chu athitan ahi. Chule David sohte chun naosen athitai tia ama seipeh ding chu akichalheh jengun ahi. Ajehchu amahon, Veuvin, chapang chu ahin laija bon ahenga thu iseijuva ahile, aman ithuseiju anangai lou ahin: chapang chu athi tin seipeh leuhen, khohjo cheh louding ham? atiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahin David'in asohho kihou lhih chu amu phatnin, David'in naosen chu athi ahi ahetai. Hijeh chun David'in asohte henga, Chapang chu athi hitam? ati. Chuin amahon, Ama athitai, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichun David tolla konin athoudoh in, akisilin, thao akinun, chuin avon akikhelin, Pakai in'a ahung lutnin, Pathen ahou tan ahi. Chuin a-in lama ahung kilen; chuin aman angaichat phatnin amahon a-angsunga an aluipeh-un ahile aman anetai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin asohten ahenga, Ipibola hitia hi chona nahim? chapang chu ahinlaisen ama dingin an nangolin nakapmin, ahin chapang chu athi phatnin nathou doh-in an nanen ahi, atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin aman, Chapang chu ahinlaijin keiman an kangol-in, kakapmin ahi: ajehchu keiman, Pathen'in eilungsetna chapang chu hunghing maithei ahi kon ija aseithei dingham? kati ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla tun ama athitai, ipidinga keiman an kangol dingham? Keiman ama kapuikit theiham? Keima amakoma kache ding ahin; ahinla ama keikoma hung kilethei louding ahitai, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin David'in a-inneipi Bathsheba chu alhamonin, chule amanu koma chun achen, aluppin ahi: chuin amanun chapa khat ahingin, amapan amin Solomon asahtai: chule Pakaiyin amachu angailun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman Nathan themgaopa khutna thu athotnin ahile; aman Pakai jal-in aminchu Jedidiah asahtan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Joab'in Rabbah-a Ammon chate dounan gal asatnin, chuin leng khopi chu alatan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Joab'in thupole ho chu David henga asolin, ahenga, Keiman Rabbah kasatnin, chule twipi khopiho chu kalatai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun tun mipi adang sese chu khom khomin, chule khopi douna ding chun gebuh kisonun lang, hichu laovin; achutiloule akhopi chu kalah-a kamin kalosah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin David'in mipi jouse akhom khomin, Rabbah-a achetauve, chule agasatnun, hichu alataovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman alengpao lallukhuh chu aluchanga konin aladoh-in, hiche agih dan songmantam toh kihal sana talent khat ahin; chuin hichu David luchanga akhuh peh-un ahi. Chuin aman khopi-a thil kichomdoh tamtah ahinpon ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman chua um mipi ho chu ahinpui doh-in, chule amaho chu thing-at, thih loukai le thih heicha semin apansah-in, chule cheh dengin apansah-in: hitichun aman Ammon miho khopi jouse-a chun abolin ahi. Chuin David le mipi ho chu Jerusalem'a ahungkile taovin ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hicheho jouse nunghin ahitin ahi, David chapa Absalom chun Tamar kiti sopi nungah hoitah khat aneijin, chule David chapa Amnon chun amanu chu adeicha lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Amnon chu anaonu Tamar jehchun agenthei lheh jengin anatlo tan ahi; ajehchu amanu nungah thengsel ahin; chule Amnon'in amanu chunga thilkhat abolding chu amadingin hahsa asalheh jengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin Amnon'in David sopipa Shimeah chapa Jonadab kiti gol khat aneijin: Jonadab hi mi lungthim themtah khat ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman ajah-a, Nangma lengpa chapa hija ipidinga ani ania nagon cheh cheh ham? neiseipeh louding ham? ati. Chuin Amnon'in, ajah-a, Keiman kasopipa Absalom naonu Tamar kadeichai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jonadab'in ajah-a, Najalkhuna luminlang kinatsah-in: chule napa nave-a ahung tengle, ajah-a, Nahenga katao ahi, kasopinu Tamar chu hunghen lang nehding eihung pehen, chule amanu khutna kona kaneh theina dingin kamitmu in nehding eihung sempeh hen, tin seijin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun Amnon alumin, chule akinat sahtan ahi. Chuin lengpa avedinga ahung phatnin, Amnon'in lengpa henga, Nahenga katao ahi, kasopinu Tamar chu hung henlang, akhutna kona kaneh theina dingin kamitmu-a changlhah phengni eihung sempeh hen, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun David'in in'a Tamar henga mi asolin, ajah-a, Nangma tun na-upa Amnon in'a chenlang, anehding an gagotpeh in, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun Tamar chu asopipa Amnon in'a achen ahile, ama analumin ahi. Chuin amanun changbong alan, ameh-in, amitmun changlhah phabep asemin, chuin changlhah chu akangin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman khangbel khat alan, chule hicheho chu a-angsunga asunglhan; ahinla ama nehding anompon ahi. Chuin Amnon'in, Pasal jouse kakoma konin soldoh-in, ati. Chuin amaho amitakip ama koma konin achedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Amnon'in Tamar henga, Nakhutna kona kaneh thei nadingin, nehding chu indan sunga hinchoi lutnin, ati. Chuin Tamar'in achanglhah semho chu alan, hicheho chu indan sunga a-upa Amnon henga ahinchoitan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amanun hicheho chu ama nehdinga ahinchoi phatnin, aman amanu chu amanin, ahenga, Kanaonu, hungin neiluppin, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amanun adonbutnin, Ahipoi, he-o, pumhatnin neibol hih-in; ajehchu hitobang thil hi Israelte lah-a akibol ngaipoi: hiche ngol hoitah thil hi bolhih-in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keiman kajumna hi hoija kachepi ding ham? chule nangma jong Israel sunga mingol khat banga naum ding ahi. Hijeh chun tun, nahenga katao ahi, lengpa henga seijin, ajehchu aman nangma dingin ei-it louding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin aman amanu thusei chu angaipeh pon: amanu sanga hatjoh ahijeh-in, pumhatnin abolin, amanu aluppitan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche jouchun Amnon'in amanu chu hahotnin ahotan, hitichun aman amanu ahotna chu angailutna sangin alenjotan ahi. Chuin Amnon'in amanu jah-a, Thoudoh inlang chemangtan, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amanun ajah-a, Hichehi angai ahipoi: hitia dihlou tah-a neisol mang hi kachunga nathilbol khatjo sanga chu phaloujo ahi, ati. Ahinla aman amanu thusei chu angaipeh pon ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun aman ama jenlea pang asohpa chu akouvin, ajah uva, Hiche numei nuhi kakoma konin kaidoh inlang, amanu nunga kot kamun, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amanu chun sangkhol jatchom choma pol khat aki-ah ahi: ajehchu hitobang sangkhol chu leng chanu nungahthengho von ahi. Chujouvin asohpa chun amanu chu ahinpui doh-in, amanu nunga kotchu akamtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Tamar'in aluchunga vut akinun, chule amanun asangkhol jatchom choma polchu abotkeh-in, alujanga akhut akoijin, kap pumin achemang tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin asopipa Absalom'in amanu jah-a, Nasopipa Amnon chun naum khompi ham? Ahinla tun, kasopinu lung mongin umin: ama nasopipa ahi; hiche thilhi lungnat nan neihih-in, ati. Hitichun Tamar chu asopipa Absalom in'a chun thomhao tah-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla David lengpan hicheho jousehi ajah phatnin, ama alunghang lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Absalom'in asopipa Amnon henga ase jong apha jong imacha aseipon ahi. Ahin Amon'in asopinu Tamar pumhatna abol jeh chun, Absalom'in Amnon chu ahon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin kumni lhingset jouvin ahitin ahi, Absalom'in Ephraim koma um Baal-hazor mun'a kelngoimul avouvin: chule Absalom'in lengchapaho jouse chu akouvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Absalom chu lengpa henga ahungin, Tun vetemin, nasoh hin kelngoimul kavo ding ahin; katao ahi, lengpa hu nasoh hito lhonin cheohite, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin lengpan Absalom henga, Ahipoi, kachapa, tun eiho ibonun chepou hite, achuti loule nanga dingin pohgih hikhao vinge, ati. Chuin aman amachu angeh kitnin, ahivangin ama cheding anompon, phatthei aboh jotan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichun Absalom'in, Chuti ahilou dingle, nahenga katao ahi, kasopipa Amnon hi keihotoh lhonkhom hen, ati. Chuin lengpan ajah-a, Ipidinga amachu nangma toh lhonkhom dingham? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla Absalom'in angeh teiteijin ahile, aman Amnon le lengpa chapateho jouse chu amatoh alhonkhom sahtan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tun Absalom'in asohho chu thu apeh-a, hitia asei ahi, Amnon lungthim chu ju-a akipasah tengleh nanghon melchih-un, chule keiman naheng uva, Amnon chu thatnun; kati tengle, amachu thatnun, kicha hih-un: keiman nangho kathupeh nahiu hilouham? hangsanun lang hatnun, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Absalom soh ho chun Absalom'in athupeh bangu chun Amnon chunga abol taovin ahi. Chuphatnin lengpa chapateho jouse akipat doh-un, amitakip asangan chunga atoudoh-un, ajam taovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ahitin ahi, amaho lampia achepetnun, Absalom'in lengpa chapate jouse athat gamin, amaho khatcha jong ahingdoh aumpoi, tithu David heng ahung lhungtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hichun lengpa akipat doh-in, aponsil abotkeh-in, tolla alumin; chule asohte jousenjong aponsilu abotkeh-un akoma adingun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin David sopipa Shimeah chapa Jonadab'in adonbutnin, Ka pakai amahon lengpa chapate khangthah jouse atha sohkeijin ngaito hih-in, ajehchu Amnon sehseh bou athin ahi. Ajehchu aman asopinu Tamar pumhatna anabol ni-a patna, Absalom thupeh dungjuija hichehi hung kigong pana ahitai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh chun tun ka pakai lengpan lengchapate jouse thia ahi tin nalungin ngaito hih-in: ajehchu Amnon sehseh bou thi ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hichun Absalom ajamtan ahi. Chuin gollhang khongah-a pangpa chu akhoda-a, avetna ahile, veuvin, anunglam molpang lampia chu mitamtah ahung amun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Jonadab'in lengpa henga, Ven, Lengpa chapate ahunguve: nasoh-in asei bangbang chu ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin ahitin ahi, aman thu asei joujou chun, veuvin, lengpa chapate ahung lhungun, chuin awsang tah-in akapmun ahi: chule lengpa le asohte jong hakan akap taovin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahinla Absalom chu ajam mangin, Geshur lengpa Ammihud chapa Talmai henga achetan ahi. Chuin David chu achapa jeh-in niseh-in alunghemin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hitichun Absalom ajamin, Geshur'a achen, chua chun kumthum aumin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule David lengpa hinna chu Absalom henga achenom lheh jengin ahi. Ajehchu ama Amnon thi chung changa ana lungmonga ahitai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Zeruiah chapa Joab'in lengpa lungthim chu Absalom heng lama aume ti ahetan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Joab'in Tekoah'a mi asolin, chuche-a um numei chingtah khat agapuisah-in, amanu henga chun, Nahenga katao ahi, alunghem khat bangin uminlang lunghemna von kivonin, chule thao jong kinu hih-in, ahin phatsottah thi-op numei khat bangin umin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutengle lengpa henga hungin lang, ahenga hitobanghin seijin, ati. Hitichun Joab'in amanu kamsunga aseiding thuho chu akoipehtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Tekoah numei nun lengpa henga thu aseichun, amai tolla asulutnin, jana apen, lengpa henga, Vo lengpa, neikithopin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lengpan amanu jah-a, Ipin nasuh genthei ham? ati. Chuin amanun adonbutnin, Tahbeh-in keima meithai kahin, ka-inneipu chu thia ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nasohnu hin chapa ni aneijin, chuin amani gamlah-a akidel lhonin, koimacha aphel khending aumpon, khatpan khatjopa chu avon, athattan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule, ven, insung pumpihi nasohnu doudin akipatdoh taovin, chule amahon, Asopipa thatpa chu asopipa athajeh-a katha theina diuvin neipedoh un; chule agou lodingpa jongchu kasuh mangdiu ahi, atiuve. Chule chutia chu akidalha-a kamei-am chu asuhmitnuva, kapasal chu min neilou le, leichunga chilhah himhim neilouva akoi dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin lengpan numeinu jah-a, Na-in lama chetan, keiman nangma chung chang thu hinhetsah nange, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Tekoah numeinu chun lengpa henga, Ka pakai, O lengpa, hiche khangitlouna chu keimale kapa insunga chuhen: chule lengpa le alaltouna vang themonabei hihen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin lengpan aseijin, koi hijongle nahenga ikhat seija aumle, amachu kahenga hinpuijin, chule aman avela natohkhah kit louding ahitai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichun amanun, Nahenga katao ahi, lengpan Pakai na Pathen hejingin lang, thisan phulapan asuhmangbe louna dingin phalna pehih-in; achuti loule kachapa sumang getnunte, ati. Chuin aman, Hingjing Pakai mina kasei ahi, nachapa samjang khatcha jong tolla lhalou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun amanun, Ka pakai ka-lengpa jah-a nasoh in thukhat seijinge, ati. Chuin aman, Seijin, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin numeinu chun, Chuti ahile ipidinga nangman Pathen mite douna hitobang thil chu nagelham? ajehchu lengpan anomangpa chu in'a apuilut kitloujeh-a, lengpan hichehi themona nei khat thusei banga nasei ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu eiho ithi teitei dingu ahin, tolla twi kisunglha kithaldoh kit theilou tobang ihi dingu ahi. Ahijeng vangin Pathen'in hinkho alamang pon; amavang aman anodoh hochu ama-a kona akipaimang lou nadingun lampi asemin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh-a chu, tu-a mipihon eikichatsah jeh uva, keima hiche seidinga hi ka pakai lengpa henga hunga kahi. Chule nasohnu hin, Ijemtia lengpan asohnu taona hi asanpeh khatle, tun lengpa koma thu gaseijinge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu lengpan eingaipeh intin, asohnu hi Pathen gouloa kona keima le kachapa suhmang dingpa khutna konin eilhatdoh inte, kati ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nasohnun, Tu-a hi ka pakai lengpa thusei chu lhamona hiding ahi: ajehchu ka pakai leng hi aphale ase sepkhen na-a Pathen vantil tobang hija ahi. Hijeh chun na Pakai na Pathen'in naumpi hen, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuphatnin lengpan numeinu chu adonbutnin; Nahenga katao ahi, keiman nangma kadoh dingho hi im hih-in, ati. Chuin amanun, Tun ka pakai lengpan seijin, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin lengpan, Hicheng jousehi Joab to kikhut jopna naneijam? ati. Chuin numei nun adonbutnin, Ka pakai lengpa hinna pana kasei ahi, ka pakai lengpan nathuseidoh hohi koimachan jetlam ahiloule veilama aheikon theilou ahi. Ajehchu nasoh Joab'in eisola, hiche thuho jousehi nasohnu kama akoi ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kivaihom danho akikhel nadinga nasoh Joab'in hichehi abol ahi; Pakai vantil chihna bangin, leiset thil umjouse hetna dingin, ka pakai hi achingin ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin lengpan Joab henga, Ven, tun hichehi kaboltan ahi: hijeh chun chenlang, gollhang Absalom chu gapuijin, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Joab aboh khupmin, tolla amai asulutnin, lengpa henga kipathu aseije: chule Joab'in, Tuni hin ka pakai vo lengpa, lengpan asohpa ngaichat asuh bulhitna konhin, nasoh keima namitmun lungsetna kachange ti kahetan ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun Joab akipatdoh-in, Geshur'a achen, Absalom chu Jerusalem'a ahin puitan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin lengpan, A-in lama kihei henglang, kamai muda hen, ati. Hitichun Absalom chu a-in lama akile heijin, lengpa mai chu amutapon ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla Israelte lah-a chun Absalom banga amel hoina pachat ding koimacha aumtapon ahi. Akengtoa pat aluchanga lallukhuh geijin ama achun nolna aumpon ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule aman asam avolhah tengle (ajehchu kumlhun sehle avolhahji ahi: ajehchu achunga asam chu agihjin, hijeh-a chu avolhahji ahi:) asam chu atejin, lengpa thiltena dungjuijin shekel jani aphajin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Absalom'a dingin chapa thumle, chanu khat apengin, achanu min chu Tamar ahi. Amanu chu numei melhoi tah ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun Absalom chu kumni lhingset Jerusalam'a achengin, ahinla lengpa mai amupon ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijeh chun Absalom'in lengpa henga soldingin Joab agakou sah-in; ahinla ama amahenga ahungpon ahi. Chuin aman aniveinan akouding asolkitnin, ahung dehpon ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh chun aman asohte henga, Veuvin, Joab lou khu kei lou komcha-a um ahin, chule aman hilaija chun sakol chang aneijin ahi; cheovinlang meija gahalun, ati. Chuin Absalom sohte chun louchu meijin ahaltaovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Joab akipatdoh-in, Absalom henga a-in'a chun ahungin, ajah-a, Ipidinga nasohten kalou chu meija ahalu ham? ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Absalom'in Joab chu adonbutnin, Ven, lengpa henga, Ipidinga keima Geshur'a kona hunga kahim? tuchan hin chukoma umleng keija dinga phajo ahi: tia seidinga kasol theina dinga hikoma hungin tia nangma kou dinga mi kahinsol ahi; hijeh chun tun lengpa maicha neimusah-un, chule kachunga khangit louna auma ahile, aman eithat jenghen, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh chun Joab lengpa henga ahungin, ahenga aseitai. Chuin aman Absalom akou phatnin, ama lengpa henga ahungin, lengpa angsunga tolla aboh khupmin: chuin lengpan Absalom chu achoptan ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche jouchun ahitin ahi, Absalom'in ama dingin sakol kangtalai ho le sakol ho, chule amasanga lhaiding mi somnga akigot tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Absalom matah-in athoudoh jin, kotpi phungkom lampia chun anadingjin ahi: chule ahitin ahi, mi khattouvin boina aneija, lengpa henga athu tansah dinga ahung teng, Absalom'in ama chu aheng lama akoulutjin, chule ahenga chun, Hoikom khopi-a kon nahim? atijin, chule amachun, Nasohhi Israel phungho lah-a hiche phung chu kahi, atijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuteng Absalom'in ajah-a chun, Ven, nathuho hi aphan adih-e; ahinla nathu ngailha dinga mopohna apeh koima aumpoi, atijin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hicheng tilou jongchun Absalom'in, Kaden keima gamsunga thutan dinga eikisem hitavele, chutile kiheh nading ahiloule boina neijouse kahenga hunguntin, chuteng keiman amaho them anachan ji tadinga! tin aseibejin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule ahitijin ahi, mi khattou chibai boh dinga akom anai tengleh, aman akhut alhangdoh jin, amapa chu atuh-in, achopjin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitobanghin Absalom'in lengpa henga athu tansah dinga hunga Israelte jouse chu anabolsoh keijin ahi. Hitichun Absalom'in Israel miho lungthim chu agumang sohtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin kum somli jouvin ahitin ahi, Absalom'in lengpa henga, Nahenga katao ahi, Pakai henga kitepnaho gasubulhit dingin Hebron'a neisolin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Syria gam Geshur'a kana umlaijin nasohhin kitepna khat kana neijin, Pakaiyin Jerusalem'a eipuilut kitna ahile, Pakai kajen ding ahi, tia kanasei ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin lengpan ajah-a, Lung mongin chen, ati. Hitichun ama akipatdoh-in, Hebron'a achetai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla Absalom'in Israel phungho jouse lah-a guhthimin mi asolin, ajah uva, Nanghon sumkon gin najah jah tengule, Absalom'in Hebron'a vai ahomtai, nati dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jerusalem'a kona kikoudoh mi jani chu Absalom toh alhonun; amaho imacha gellouva cheu ahin, imacha ahet louvu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Absalom'in David dinga thumopma pang Gilon mi Ahithophel chu ama khopi Gilon'a ganlhaina thilto abol laitah-in agakou sah-in ahi. Chule galguh chu ahatlheh jengin ahi; ajehchu Absalom dingin mi atamcheh cheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin David henga thupole khat ahungin, Israelte jouse lungthim chu Absalom lamma akaitaove, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Davidn'in Jerusalem'a amato umkhom asohte jouse henga, Kipatdoh-un, jamtaohite; ajehchu eiho Absalom'a kona ihoidoh loudiu ahi. Potdoh dingin mangang un, achutiloule aman hetman louvin eihin delkhum diu, chule eiho chunga thilphalou ahin lhutna, khopi hi chemjam'a asat ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin lengpa soh ho chun lengpa henga, Ven, nasohte hi ipihile ka pakai lengpan boldinga eithupeh chanu boldinga kigosa dema um kahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin lengpa apotdoh-in, chule a-insung miho jouse chun anung ajuijun ahi. Chuin lengpan inngah dingin athaikem numei som adalhan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule lengpa apotdoh-in, mipi jousen anung ajuijun, mun gamlatah khatna aumtaovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin asohho jouse chu amato akilhonun, chule Gath'a kona anung hinjui Cherth mite, Palet mite, chule Git mite mi jagup chu lengpa masanga acheuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin lengpan Gitmi Ittai jah-a, Ipidinga nangjong keihohitoh nalhon ham? Naumna lama kile kitnin lang, lengpa toh gaum khomin. Ajehchu nangma gamchommi nahin, chule nagam sunga kona kinodoh jong nahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nangma janhi vela bou hung nahin, tunia keima kachena thei thei na-a che ding kahin, iti nangma keiho toh lhonna kachesuh kachetou sah ding ham? nangma kilekittan, chule nasopi ho hi kipuijin: hepina le thutah-in naumpi jinghen, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Ittai'in lengpa adonbutnin, ajah-a, Hingjing Pakai min le ka pakai lengpa min pana kasei ahi, thonlouva hoikom mun hijongle ka pakai lengpa umna-a chu thina hihen, hinna hile, hichelai mun ngeija chu nasoh hi kaumding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin David'in Ittai jah-a, Chenlang galkaitan, ati. Chuin Git mi Ittai chu amite jousele aumkhompi chapang neoho jouse chutoh agalkai taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin gam pumpi chu awsang tah-in akapmun, chule mipihochu agalkai taovin ahi. Chule lengpa amatah jong Kedron vachadung chu agalkaijin, chuin miho jouse chu gamthip jotna lampi langa chun agalkai taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule veuvin, Zadok le ama koma um Levi hon jong Pathen kitepna thingkhong apouvin ahi. Chuin amahon Pathen kitepna thingkhong chu angaovin; chule mipi ho jouse khopi-a kona apotdoh kahseuvin Abiathar chu achetouvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin lengpan Zadok hengah, Pathen thingkhong chu khopi-a nungpoh kitnin: ijemtia Pakai mitmu-a lungsetna kachana ahile, aman eihin lepui kitna, anai-a hiche hile aumna mun chu eimusah kitding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla aman, Nachunga lunglhaina kaneipoi atia ahile; ven, hikoma kaume, aman kachunga pha asah bangbang chun bolhen, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin lengpan Zadok thempupa henga, Nangma mitvah nei nahi louham? Nangma to umkhom nachapateni, nachapa Ahimaaz le Abiathar chapa Jonathan toh lung mongin khopi sunga kiletaovin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ven nangma-a kona thu ahung kahse-a keiman gamthip phaichama kaum ding ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijeh chun Zadok le Abiathar chun Pathen thingkhong chu Jerusalem'a apokit lhonnin; chule hikoma chun amani aum lhontan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin David chu olive molsang kaltouna-a chun achetouvin, chule akap pum pumin achetouvin, alu akhu khumin, akeng keuvin lam ajotnin ahi: chule akoma um mipi jouse amitakipmin alu akhu khumun, kap pumin achetouvun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin mikhatnin David jah-a, Ahithophel chu Absalom galguh bolho lah-a ajaove, tin aseipeh-in ahi. Chuin David'in, Vo Pakai, nahenga katao ahi, Ahithophel thumopna chu ngolnan heidoh peh-in, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin ahitin ahi, David a-Pathen houna mun molchung ahunglhun phatnin, veuvin, Arch mi Hushai chu sangkhol chol kibotkeh le aluchanga leiset nat pumin ama kimupi ding chun ahungin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />David'in ama henga, Nangma keima toh lhon lehen, keima dinga pohgih nahi ding ahi:
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahinla nangma khopi-a nakile-a, Absalom henga, Vo lengpa, keima nasoh hinge; hichan geija napa soh-a kana um bangin, tunjong nangma soh hingkate, tia nagaseija ahile: nangman keima dingin Ahithophel thumop chu neijopeh ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule nangman nangma to pangkhom dinga Zadok le Abiathar thempu teni nanei hilouham? Hijeh-a chu hitiding ahi, Ipi hile nangman lengpa in'a kona najah chanchu, Zadok le Abiathar thempupa naseipeh ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ven, hikoma chun amani chutoh achapateniu Zadok chapa Ahimaaz le Abiathar chapa Jonathan aumlhone; chule nangman najah takip chu amani-a kona kakoma nahin thotding ahi, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hitichun David lengpa golpa Hushai chu khopi sunga ahungin, chule Absalom chu Jerusalem'a ahunglut tan ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David'in molsang chungvum phabep akhel nungin, veuvin, Mephibosheth sohpa Ziba'in sangan ni apho pumle achunga chanlhah pheng jani, lengpithei gop boh jakhat, chule nipilai theiga jat jakhat, chule ju haikhat toh ana kimupin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin lengpan Ziba jah-a, Hiche nabolhi ipi vetsahna ham? ati. Chuin Ziba'n, Sanganho hi lengpa insung mite touna ding ahin, chule changlhah leh nipilai theigahohi gollhangho nehding ahin, chule juhi gamthipma lhasamho donding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpan, Chuti ahile, napakai pa chapa lah-em? ati. Chuin Ziba'n lengpa henga, Ven, ama Jerusalem'a aume: ijeh inem itile aman, Tunia Israel insungin kapa lenggam eilosah dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche phatchun lengpan Ziba henga, Ven, Mephibosheth nei jouse chu nangma-a ahitai, ati. Chuin Ziba'n, namitmu-a lungsetna kachan theina dinga, ka pakai, vo lengpa, nahenga katao ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin David lengpa Bahurima ahung phatnin, veuvin, chua konchun Gera chapa Shimei kiti Saul insungmi khat ahungdoh-in ahi. Ama ahung potdoh-in, alamjot toh gaosap ahin koppeh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman David le, David lengpa sohte jouse chu songin ahin sepmin: chule miho jousele mihat ho jouse jet le veija aumun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Shimei'in agaosap laijin hitin aseijin ahi, Hung doh-in, hung doh-in, nangma thisan sopa le Belial mipa :
  </para>
  <para style="p">
    <verse number="8" style="v" />Akhela navaihom, Saul le a-insung pumpi thisan chu Pakaiyin nachunga ahinle lhunsah ahin; chule Pakaiyin lenggam chu nachapa Absalom khutna apehdoh ahitai: chule ven, nangma thisanso hat nahi jeh-a, nathemmona chu nachunga chua ahitai, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuphatnin Zeruiah chapa Abishai'in lengpa henga, Ipidinga hiche uicha thisa hin ka pakai lengpa hi agaosap ham? nahenga katao ahi, galkaijing ting, alu galange, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin lengpan, Nangho Zeruiah chapate, nangho le kei ikibahnao ipi umam? Eigaosap hen, ajehchu Pakaiyin ahenga, David khu gaosapmin, ati ahi. Chuti ahile, Ipidinga nangin hiti ahi nabol ham? tia aseidinga chu koiham? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin David'in Abishai le asohte jouse henga, veuvin, ka-oisunga kona hungdoh kachapa jengin kahinna lahdinga ahola ahile; tu-a hi hiche Benjamin miten ichan geija ahol dingu ham? Limsah hih-un, agaosap nom chanin gaosaphen; ajehchu Pakaiyin asol ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuti henlang hile Pakaiyin kagen theina hinve intin, tunia aman eisapset nahi Pakaiyin aphalama eilethuhpeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule David le amiho chu lampia ache laijun, Shimei chu molpanga chun ama dontah-a achen, achepum chun agaosapmin, chule songin asepmin leivui athekhumin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin lengpa le aumkhompi mihochun alel taovin; hijeh chun amaho hia chun akicholdo taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Absalom le Israel mite jouse chu Jerusalem'a ahungun, chule ama Ahithophel toh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahitin ahi, David golpa Arch mi Hushai chu Absalom henga ahung phatnin, Hushai'in Absalom henga, Pathen'in lengpa huhhing hen, Pathen'in lengpa huhhing hen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Absalom'in Hushai henga, Hichehi nagolpa nahepina ham? ipidinga nagolpatoh lhonlou nahim? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Hushai'in Absalom henga, Ahipoi, Pakai le hiche mite, chule Israel mipi ho jousen alhen paova chu kahi ding, chule keima ama toh kaumding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujongle, keiman koi kajen dingham? Achapa chu kajen ding hilouham? Napa kajen banga chu nangma kajending ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuphat chun Absalom'in Ahithophel henga, Ipi kabol dinguham neithumop uvin, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Ahithophel'in Absalom henga, Napan inngah dinga akoi athaikemho henga chun chen; chule Israel mipi ho jousen nangma napa-a dinga kidah umtah nahichu ajahdiu: chutengle nangma toh umho jouse khuttha chu hatdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun amahon Absalom dingin in chunga chun pon inkhat asongun, chuin Absalom chu Israel miho jouse mitmun apa thaikem ho henga aluttan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Ahithophel thumop, hiche nikho laija Ahithophel anathumopho chu, mikhatnin Pathen athudop banga ana gelu ahi. David le Absalom dinga jong Ahithophel thumop ho jouse chu hitobang chu anahija ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheng tilou chun Ahithophel'in Absalom henga, Tun keima mi sangsom le sangni lhendoh ingting, tujan mama hin kipatdoh ingting, David ganungdel inge:
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule ama athachola akhuttha alhompet tahle achunga kachuh ding, kasuh kichat ding: chutengle aumpi miho jouse chu jam mang untin, keiman lengpa bouchu katha ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule mipi jouse chu nahenga kahin lepuiding ahi. Nangman naholpa tailou adang jouse ahung kilekit teng, mijouse chu lung mong diu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule akisei chun Absalom le Israel upaho jouse chu alunglhaisah lheh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin Absalom'in, Tun Arch mipa Hushai jongchu kouvun, chule eihon ama thusei jongchu ngaiju hite, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Hushai chu Absalom henga ahung phatchun, Absalom'in akihoupin, Ahithophel'in hitihin aseije: aman asei bangahi iboldiu ham? Ahilouva ahile, nangman hinseijin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Hushai'in Absalom henga, Ahithophel thumop hi tuphatna dingin aphapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hushai'in aseiben, Ajehchu nangman napale amiho chu gal hat ahiu, chule vompi gamlah-a anou kilahpeh banga alungsung uva lungsa ahiu nahen ahi; chule napahi galsat mi ahin, miho lah-a jong gehlou ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ven, amahi tu-a leiko khat sung, ahiloule munchom dang khatna kisel ding ahi: chule hung hitiding ahi, amaho lah-a themkhat ahung lhuh masah tengule, hiche jaho jouse chun, Absalom nungjui miho lah-a kitha chapna aumtai atidiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutengle mihangsan tah, alungchang keipi lungchang tobang jong chu junlha ding ahi: ajehchu Israelte jousen napa chu mihat ahi ahetnu ahin, chule aumkhompi miho chu mihangsan jeng ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Dan'a pat Beersheba geija Israelte jouse luipikama neldi jat banga nahenga nakhop khoma, chule nangmatah chu gala nakon ding chu kathumop nahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiti achu eiho ama kimunathei ding mun'a chu ihungdiu, chule daitwi tolla alhah banga eiho ama chunga ichuh jeng dingu ahi. Chule amale aumpi miho jouse khatcha jong kidalha louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hicheng chungchona chu, ama khopi sung khat touva alutna ahile, Israelte jousen hiche khopi lama chu khao ahinchoidiu, chule khopi chu song halkhat cha akimulou kahse-a vadung sunga ikailut dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Absalom le Israel mipi jouse chun, Arch mipa Hushai thumop hi Ahithophel thumop sangin aphajoi, atiuvin ahi. Ajehchu Pakaiyin Absalom chunga thilphalou ahinlhun sahna dinga, Pakaiyin Ahithophel thumop phaho jona dinga tohgon ananeisa ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichun Hushai'in Zadok le Abiathar thempupa henga, Hiti khati hin Ahithophel'in Absalom le Israel upaho athumopmin; hiti tihin keiman kathumop in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun tun gangtah-in solin lang, David henga, Tujan gamthip phaicham ho-a chun gehhihhen, ahinla mangang tah-in galkaijin; achutiloule lengpa le aumpi miho jouse chu val lhuma umkha diu ahi, tin gaseisah-in, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tun Jonathan le Ahimaaz chu khopisung ahunglut lhon akimulouna dingin Enrogel'a aumlhonin ahi: chuin soh numei khat achen amani agaseipeh-in; chuin amani ache lhonin David lengpa agaseipeh lhontan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahijeng vangin pasal chapang khatnin amaho chu anamun, Absalom chu aseipehtan ahi. Ahin amani mangang tah-in achemang lhonin, chuin Bahurim'a ahongsunga twikul neikhat in'a ahung lhonin; hia chun akumlha lhontan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin numeinu chun twikul kamchu asingin, chuin achunga chun chang aphouvin ahile, hichu akihedoh pon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Absalom sohte numeinu in'a ahung phatnun, ahenga, Ahimaaz le Jonathan chu hoilama umham? atiuve. Chuin numei nun ajah uvah, Amani vachadung galkailhon tante, ati. Chuin amahon aholmo phatnun Jerusalem'a ahungkile taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ahitin ahi, amaho chedoh nungin, amani twikul'a konin ahungdoh lhonin, achelhonin David lengpa henga agaseipeh lhonin, ajah-a, Kipatdoh inlang mangang tah-in twi chu galkaijin; ajehchu Ahithophel'in nangma douna-a hitia hi athumop ahitai, atilhonne.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichun David le aumkhompi miho jouse chu akipat doh-un, Jordan agalkaijun: jingkho vah-in amaho Jordan galkailou khatcha aumtapouvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Ahithophel'in athumop akijuilou amuphatnin, asangan pho kigotnin, akipatdoh-in, akhopi a-in lama achen, a-insung asemtupmin, chuin amale ama akikhailih-in, athin, apa lhanna akivuitan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichun David Mahanaim'a ahung lhungin ahi. Chule Absalom le aumpi Israel mite jouse chu Jordan agalkai taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Absalom'in Joab khelin Amasa chu janel lamkaijin apansahtai: Hiche Amasa kitipa hi chu Joab nu Zeruiah sopinu Nasah chanu Abigail galuppi pa Israel mi Jithra kitipa chapa ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitichun Israel le Absalom'in Gilead gama chun pon in akison taovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ahitin ahi, David Mahanaim ahunglhun phatnin, Ammon mi Rabbah kho-a cheng Nahash chapa Shobi le, Lodebar kho-a cheng Ammiel chapa Machir toh, Rogelim kho-a cheng Gilead mi Barzillai'in,
  </para>
  <para style="p">
    <verse number="28" style="v" />Jalkhunho, twikhonho, leibelho, suhlou chang, sakolchang, changbong, changkanpoh, bepaiho, bechim, belheng kikangho,
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule khoiju, bongnoi thao, kelngoi le bongnoihaho chu David le aumpi miho nehdingin ahinpouvin ahi: ajehchu amahon, Mipi hi gamthipma gilkel, thachol le dangchah-a umu ahi, atiuve.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David'in aumkhopi miho chu asimin, chuin aman sangkhat chung lamkai le jakhat chunga lamkai ding alhengdoh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule David'in mipi hopthum-a hopkhat chu Joab khut noija asoldoh-in, hopthum-a hopkhat chu Zeruiah chapa Joab sopipa Zeruiah chapa Abishai khut noija asoldoh-in, chule hopthum-a hopkhat chu Git mi Ittai khut noija chun asoldoh-in ahi. Chuin lengpan mipi ho henga, Keima tahjong thonlouva nang hotoh kalhonkhom ding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla mipin adonbutnun, Nangma nakondoh louding ahi: ajehchu keiho jamta leoveng, amahon keiho gelkhoh-a einei loudiu; chule keiho akehkhat thijong leoveng, amahon keiho gelkhoh-a einei loudiu ahi. Ahinla tun nangma keiho sangsom toh kibang nahi: hijeh-a chu nangman tu-a khopi sunga naum hi phajo ahi, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lengpan ajah uva, Nanghon aphapen dinga nagelu chu kabol ding ahi, ati. Chuin lengpa kotpi phung koma chun adingin, mipi jouse chu jakhat cheng le sangkhat chengin ahungdoh-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lengpan Joab, Abishai chule Ittai chu thu apen, ajah uva, Keima ding ngaitonan gollhangpa, Absalom ngeichu lungneng tah-in hindemun, ati. Chule miho jouse chun lengpan Absalom chung changa ja lamkaiho athupeh chu ajaovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun mipi chu gamlah-a Israelte doudin achedoh taovin ahi. Chuin gal chu Ephraim gammanga kisat uva ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche mun'a chun Israel mipi ho chu David sohte masanga akithat chap taovin, chule hiche nikho chun mi sangsomni athin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu gal chu gamsung jouse-a akithechan soh-a ahitan: chule hiche nikho chun chemjam'a kithat sangin, gammang lah-a ohlih atamjouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Absalom'in David sohte chu atohkha tan ahi. Chuin Absalom chu sangan chung khatna touva ahin, chule sangan chu gangpi lentah abah kibom noija chun achen ahile, alu chu gangpi-a chun a-ohdentan; chuin ama vanle lei kikah-a akikhai denin; anoija um sangan chu achemang tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin mikhatnin hichu amun, Joab jah-a, Ven, keiman Absalom gangpi phunga akikhai kamun ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Joab'in aseipehpa henga, Ven, nangman ama namu ahin, ipidinga amachu tolla satlhalou nahim? chutile keiman nangma dangka Shekel somleh konggah khat nape tadinga, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin mipa chun Joab henga, Keiman dangka Shekel sangkhat kakhutna kasan ding hijongleh, keiman lengpa chapa dounan kakhut kalha louding ahi; ajehchu keiho jah tah-in lengpa nangma le Abishai chule Ittai nathu peh-un, Gollhang Absalom chu koimachan natohkhah louna dingun chingtheijun, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Achuti louva ahile kahinkho douna-a dihlou tah-a na katohding ahi: ajehchu lengpa-a kona ki-ima imacha aumpon, nangmatah ngeijong keima douva nahung panding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichun Joab'in, Keima nangma toh hitihin umthei ponge, ati. Chuin aman akhutna tengcha thum alan, Gangpi thing lah-a ahinga ana umnalai Absalom alungchang chu asun pailetnin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Joab galmanchah po-a pang gollhang mi somho chun Absalom chu a-umkimvelun, avouvin, athat taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Joab'in sumkon amutnin ahile, mipi chu Israelte anungdel naova konin ahungkile taovin ahi; ajehchu Joab'in mipi chu akhamtang ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amahon Absalom chu alauvin, gammang lah kotong lentah khat aseplutnun, chule achunga songlhuh lentah-in aseuvin ahi. Chuin Israelte chu amitakip ama ama ponbuh lam cheh-a ajamtaovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun Absalom'in ahinlaijin lengpa phaichama chun amadingin khompi khat anatung doh-in ahi. Ajehchu aman, keiman kamin geldoh jingna dinga koiding chapa kaneipoi, ati: chuin aman khompi chu ama-min aputsah-in ahi. Chule hichu tunigeijin Absalom mun tin akisahtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin Zadok chapa Ahimaaz'in, Tun keima lhaijing kating, Pakaiyin melmaho chunga iti phu analah hitam, lengpa koma athu hi galhut inge, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Joab'in ahenga, Tunia hi nangman thu napoh theilou ding, amavang nidang tengle napoh ding ahi. Tunia vanghi nangman thu napoh louding ahi, ajehchu lengpa chapa thia ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin Joab'in Cushi henga, Chenlang nathilmu hi lengpa gaseipehtan, ati. Chuin Cushi chu Joab anga akunin, alhaijeltan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichun Zadok chapa Ahimaaz chun Joab henga aseikitnin, Ahile hitante, nahenga katao ahi, Cushi nunga chun lhaijing kate, ati. Chuin Joab'in, Kachapa, athupoh ding umlouva ipi dinga lhaiding nakigot jengham? ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla aman, Ahile hitante, lhaijeng inge, ati. Hichun aman ajah-a, Lhaitan, ati. Hichun Ahimaaz chu phaicham lampia chun alhaijin Cushi chu akhelpatan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule David chu kotpi teni kikah-a chu touva ahi. Chuin khongahpa chu kotpi phung bang chunga chun akaldoh-in, akhodah in ahile, veuvin, mikhat achanga hunglhai amun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin khongahpa chun asamin, lengpa henga aseipehtan ahi. Chuin lengpan, Ama achang ahile, akama thu ahinpoh hinte, ati. Chuin ama kintah-in ahunglhaijin ahungnai chehcheh-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin khongahpa chun michom dang khat hunglhaija amukitnin: chuin khongahpa chun kotngahpachu akouvin, ahenga, Ven, michom dang khat jong ahunglhaije, ati. Chuin lengpan amajong thu ahinpoh ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin khongahpan, Keiman ahunglhai masapenpa chu Zadok chapa Ahimaaz lhai danin kahen ahi, ati. Chuin lengpan, Amachu mipha ahin, chule thupha toh hungtha ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Ahimaaz'in ahin samin, lengpa henga, Imajouse aphasoh keinai, ati. Chuin aman lengpa masang tolla chun amai asulutnin, Ka pakai lengpa douna akhut lamho jouse pedoh-a Pakai na Pathen chu nunnom hen, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin lengpan ajah-a, Gollhang Absalom chu hoidoh nam? ati. Chuin Ahimaaz'in adonbutnin, Joab'in lengpa sohpa le nasoh keima eisol lhonchun, keiman mipi boilah lah chu kamun, ahinla hichu ipi ahi kahepoi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin lengpan ajah-a, Kikhindoh inlang, hikoma hin dingin, ati. Chuin ama akikhindoh-in, ading thimbeh-in ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin veuvin, Cushi ahung lhungin; chule Cushi'n, ka Pakai lengpa thu kahinpoi; ijeh inem itile nangma doudinga kipatdoh ho jouse chunga tuni hin Pakaiyin phu alatai, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin lengpan Cushi henga, Gollhang Absalom chu hoidoh nam? ati. Chuin Cushi'n adonbutnin, Ka pakai lengpa melmaho jouse, chule nangma suhkhah nadinga nangma douna kipatdoh jouse chu gollhangpa chutoh bangcheh hen, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin lengpa chu alung analheh jengtan, kotpi phunga dan chunga chun akaldoh-in, akaptan ahi: chuin aman achepumin, Ohe! kachapa Absalom! kachapa, kachapa Absalom! Pathen'in nangma khela eithisah joh hile ong! ohe Absalom, kachapa, kachapa, atin ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Joab henga, Ven, lengpa chu Absalom dingin akapmin, alunghemin ahi tin aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hiche nikho-a galjona chu mijouse dingin lunghemna asohtan ahi. Ajehchu mipi jousen, Lengpa ichan geija achapa dinga lung gentheija hitam, tia kisei chu ajauvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule galmuna kona ajamdoh jeh-a jahchatah-a umho bangin, hiche nikho chun mipi ho chu guhthim chan khopi sunga chun ahung lutnun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin lengpan amai akikhun, awsang tah-in, Vo kachapa Absalom! vo Absalom kachapa, kachapa, tin akapmin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Joab chu lengpa in'a ahunglutnin, ajah-a, Nangman tunikho hin nangma hinkho, nachapate hinkho, nachanute hinkho, najite hinkho, nathaikem ho hinkho huhdoh-a nasohte jouse maihi najumson;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche-a hin nangman namelmate nangailun, naloi nagol ho nahotbolin ahi. Ajehchu tuni hin nangman leng chapate le soh ho hi ija naselouna naphongdoh tan: tuni hin Absalom chu hing henlang, keiho jousehi thileuveng nakipah ding ahi ti kamudohtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun kipatdoh-in, chedoh-in lang nasohte henga lungmona thu gaseijin: ajehchu Pakai mina kihahsel kahi, napotdoh louva ahile, tujan apat khatcha jong nangma toh umlou ding ahitai: chule hichu nakhangdon laija patna tuni geija nachunga thilse anachuho sanga khohjo ding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun lengpa akipatdoh-in, kotpi phunga chun atoutan ahi. Chuin amahon mipi ho jouse henga chun, Veuvin; lengpa chu kotpi phunga atoutai, atiuve. Chuin mipi chu lengpa masanga ahungun ahi: ajehchu Israelte amitakip ama ama pon-in lam cheh-a jamu ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Israel phung jouse lah-a mipi ho chu akiphinun, Lengpan imelmateu khutna konin eihuhdoh-un; chule Philistinte khutna konin eihuhdoh-un; chule tun ama Absalom jeh-in gamsunga konin ajamdoh tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule ichunguva dinga thao inupao Absalom chu galmuna athitan ahi. Hijeh chun tun ipidinga lengpa lepuikit nadinga thu changkhat beh nasei daoham? atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin David lengpan Zadok le Abiathar thempu henga mi asolin, ajah-a, Judah upaho henga hitin aseijin, Israelte thusei chu lengpa le a-insung ngei tah-a hunglhung tai ti namu nunguva, ipidinga nanghon lengpa a-in'a lepui kitnadinga anunung pena napan uham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangho kasopite nahiuvin, kaguhole kaphe nahiuve. Chuti ahile ipidinga nangho lengpa lepuina dinga anunungpen nahiu ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nanghon Amasa henga, Nangma kagule kaphe nahilouham? Nangma kamasang Joab khela janel gallamkai nahijom jing louva ahile, Pathen'in kachunga hitichun, chule akhohjo cheh-in eibolhen, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman mikhat lungsung bangin Judah miho jouse lungsung chu asunemin; hitichun amahon lengpa henga thu athotnun, Nangmale nasohteho hungkile taovin, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun lengpa ahungkilen, Jordan ahung lhungtan ahi. Chuin Judah chu lengpa kimutopi ding le Jordan galkaipi dingin Gilgal'a ahungtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Bahurim'a um Benjamin mi Gera chapa Shimei chu Judah miho toh David lengpa kimutopi dingin mangang tah-in ahungsuh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule ama chu Benjamin mi sangkhat to ahin, Saul insungmi sohpa Ziba le achapa somlenga toh, chule asoh somni toh ahiuvin: chuin amaho chu lengpa masanga chun Jordan agalkaijun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amaho lengpa insungmi le aman boldinga pha-a agel chu boldingin kongneo khatna agalkaijun ahi. Chuin ama Jordan ahung galkai kaijin, Gera chapa Shimei chu lengpa masanga abohkhup jengin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule lengpa henga, Ka pakaiyin khangitlouna chu keija simhih-in, chule ka pakai lengpan Jerusalem adalhah ni-a nasoh kanachonvalna jong chu geldoh danlang, lengpan nalunga jong vophih beh-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu nasoh hin chonse kahi ti kakihetne: hijeh chun ven, tunia hi Joseph insung miholah-a ka pakai lengpa kimutopi dinga hungsuh masapen kahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin Zeruiah chapa Abishai'in adonbutnun, aman Pakai thaonusa agaosap jeh-a Shimei chu thading hilouham? ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin David'in, Nangho Zeruiah chapate, nangho le keima ipi ikibahnao uma, tunia hi keima douva napan uham? Tunia Israel sunga mi kithat ding ham? tunia hi keiman Israelte chunga leng kahihi kahet louva nabolu ham? ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun lengpan Shimei jah-a, Nangma nathilou ding ahi ati. Chuin lengpa amahenga akiteptan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Saul chapa Mephibosheth chu lengpa kimupi dingin ahungsuh-in, chule aman lengpa akipatdoh ni-a pat lungmonga ahungkit nikho tokah-a hi akeng jong asillou, akhamul jong apolou, avonho jong asoplou ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin ahitin ahi, ama Jerusalem'a lengpa kimutopi dinga ahung chun lengpan ahenga, Mephibosheth ipidinga keima toh kilhonlou nahim? ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman adonbutnin, Ka pakai, vo kalengpa, nasohhi kengbai kahi jeh-in keima, Achunga katouva lengpa henga kache theina dingin sangan chu kigotninge kati ahi; hinlah kasohpan eijoulhep ahi
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule aman nasohhi ka pakai lengpa henga eihehsen ahi; ahinla ka pakai lengpa hi Pathen vantil tobang ahi. Hijeh chun namitmu-a pha masah dungjuijin boltan.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu kapa insung pumpiho ka pakai lengpa masanga athisa ahitan, hijongle nangman nasohhi nangma dokhanga neho lah-a napan sah-in ahi. Hijeh chun lengpa henga taokitna dinga ipi thaneina kaneijem? ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin lengpan ahenga, Ipidinga nangman nathu chu nasei nahlai ham? Keiman, Nang le Ziba gam chu kihomlhontan tin kanaseije, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Mephibosheth'in lengpa henga, Ka pakai lengpa lungmonga a-in'a hung kilekit ahitah jeh-in, abonin aman kilahtahen, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Gilead mi Barzillai chu Rogelim'a konin ahungsuh-in chuin, Jordan gal gei gathah dingin, lengpa toh Jordan agalkai lhonin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tun Barzillai chu mi kum upatah ahitan, kum somget ahitai. Chule aman lengpa Mahanaim'a aumlaija chu nehding ana khan ahi; ajehchu ama mihao tah ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin lengpan Barzillai henga, Kakoma hungin lang, Jerusalem'a kakoma na-umlaisen keiman navah nange, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Barzillai'in lengpa henga, Keima itih chanpi kahin nahlai ding hija, lengpa toh Jerusalem'a kachetou dingham?
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuhin keima kum somget kahitai. Chule keiman apha le ase kalhengkhen thei ding ham? Nasoh hin kaneh dingle kadon ding chu atwi atam kahetthei ding hinam? Numei lasathem le pasal lasathem ho lasah awgin chu kajah thei nalaiding hinam? chuti ahile ipi dinga nasohhi ka pakai lengpa dinga pohgih kibe nabep kahiding ham?
  </para>
  <para style="p">
    <verse number="36" style="v" />Nasoh hi lengpa toh Jordan gal themkhat chebeding kahi: ipidinga hitobang thilpeh-a hi lengpan neilethuh got ham?
  </para>
  <para style="p">
    <verse number="37" style="v" />Nahenga katao ahi, nasohhi kakhopia kathi-a kanule kapa lhanna kakivui theina dingin, neinungsol tan. Ahinla ven, nasoh Chimham hi; amahi ka pakai lengpa toh lhonhen lang, nangman apha hidinga kilom nasah dungjuijin achunga hin boltan, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin lengpan adonbutnin, Chimham hi keimatoh kilhon ding ahin, chule keima ama chunga hi apha hidinga kilom kasah dungjuija kabolding ahi. Chule ipi hitajongle keima-a kona nangaichat chu kabolpeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin mijouse Jordan agalkai taovin ahi. Chuin lengpa ahung galkai phatnin, lengpan Barzillai chu achopmin, chule phatthei aboh-in; chuin ama aumna lama akile kittan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chujouvin lengpa Gilgal'a achen, chule Chimham chu amatoh alhonin ahi. Chuin Judah mijouse le Israel mipi akehkhat chun lengpa ahin puijun ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin veuvin, Israel mipi ho jouse chu lengpa henga ahungun, lengpa jah-a, Ipidinga Judah mi kasopi hon nangma naguh manguva, lengpa le a-insungmi chule David'in aumpi miho jouse chu apui galkaiju ham? atiuve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Judah miho jouse chun Israel miho chu adonbutnun, Lengpa hi kakinaipiu ka-insungmiu ahijeh ahi. Chuti ahile ipidinga nangho hiche jeh-a hi lunghanga nahiuvem? Lengpa chohsa ne-a kahiuvem? ahiloule aman keiho thilpeh eipeh khah uvem? atiuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Israel miho chun Judah miho chu adonbutnun, Keihon lengpa-a chansom kaneijun, chule keihon nangho sangin David'a thaneina kaneijouvin ahi. Chuti ahile ipidinga lengpa galepui kitna dinga keiho thuhil chu masajo ahi chu i-sah louva bol nahiuvem? tiuve. Ahinla Judah miho thusei chu Israel miho thusei sangin ahatjon ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Benjamin Bikhri chapa Sheba kiti boinasem mikhat ana umin ahi. Chuin aman sumkon amutnin, Eihon David'a chan ineipouve, chule Jesse chapa-a konin jong goulo ding ineipouve: Vo Israel, naponbuh cheh uva chetaovin, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hitichun Israel mite jousen David adalhaovin, chuin Bikhri chapa Sheba chu ajuitaovin ahi. Ahivangin Jordan'a pat Jerusalem geija Judah mite vangchu alengpaova dingin apangdetnun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David Jerusalem'a a-in ahung lhungin, chuin lengpan a-inngah dinga adalhah, numei thaikem somho chu insung dan khatna akoijin, avah-in, ahin amaho koma chun alut tapon ahi. Hitichun amaho chu athi nikho geijun khakhumin aumun, meithai bangin ahing taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujouvin lengpan Amasa henga, Nithum sungin Judah mite neikhop khompeh inlang, chule nangma tahjong umin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Amasa chu Judah mite khom dingin achen: ahinla David'in atepeh phat sangchun ahung geijotan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin David'in Abishai henga, Tu-a hi Bikhri chapa Sheba hin Absalom'in eibolnao sanga khohjo cheh-a eiboldiu hitam? Napakai sohte kipuijin lang ama chu nungdelin, achuti loule khopi kul kikai khum khat kimuntin, eihoa konin sohcha getninte, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule ama nunga chun Joab miho, Chereth mite, Peleth mite le mihat ho jouse acheuvin; chuin amaho Bikhri chapa Sheba nung del dingin Jerusalem'a konin akipat doh-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho Gibeon mun songpilen phunga aumlaijun, Amasa chu amasanguva ahungin ahi. Tun Joab chu galvon'a kivon ahin, chule chu-a chu konggah um, chule akonga chu chemjam apaija kiheng kikhaija ahi; chuin ama malama achea ahile hichu ahung kitanglhan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Joab'in Amasa henga, Kasopi pa, nadam hinam? ati. Chuin Joab'in Amasa chop dingin akhut jetlama akhamulin amanin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin Amasa chun Joab'in akhutna chemjam achoi chu ahepon ahi. Chuin aman hichea chun a-oipoh asut peh-in ahile, agil tolla alonglhan, avelin asunkit tapon; chuin ama athitan ahi. Hitichun Joab le sopipa Abishai chun Bikhri chapa Sheba chu anungdel lhontan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Joab miho khat chu Amasa koma adingin, Joab khohsah jouse le, David langa pang jouse chu Joab nunga cheohen, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Amasa chu lamlhong lailunga athin achupmin ahi. Chuin mipa chun mipi adinden chu amuphatnin, Amasa chu lamlhonga konin gamlah-a achondoh-in, chule akom hinhopa jouse adin dennu chu amuphatnin, ama chu ponkhat akhukhumin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama lamlhonga akichondoh phatnin, mijouse Bikhri chapa Sheba nung del dingin Joab nunga acheuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule ama Abel gei le Beth-maachah geijin Israel phung jouse henga le Ber mite jouse henga achen ahi. Chuin amaho akikho khomun ama nung ajuitaove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amaho ahungun amaho chu Beth-maachah'a um Abel mun'a chun aumkolun, chule amahon khopi dounan leibang asepmun, chule hichu kiselna leiko-a dinga ahin: Joab toh umkhom mipi jouse chun kulbang chu suhchim dingin asusepan ataovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichun khopi-a konchun numei chingtah khatnin ahin samin, Ngaijun, ngaijun; Joab henga katao ahi, nangma toh kakihou theina din, hilam hin naijin, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amapa amanu henga ahungnai phatnin, numeinu chun ahenga, Nangma Joab nahim? ati. Chuin aman adonbutnin, Keima ama chu kahi, ati. Hichun amanun ajah-a, Nasohnu thusei ho hi ngaijin, ati. Chuin aman Kangaije, atin adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichun amanun, Masanglai chun min, Amahon thonlouva Abel kho-a thumop adoh teidiu ahi, tin anasei jiuvin: chule hitichun thu chu achai jiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima Israel sunga chamna deile tahsan ho lah-a khat kahi. Nangman khopi khat le Israel minu khat suhmangdin naholin ahi. Ipidinga nangman Pakai goulo chu naval lhum ding ham? ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Joab'in adonbutnin, Keiman kaval lhum ding ahiloule kasuhmang ding chu keija konin gamlahen, keija konin gamlahen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Athu chu chuti ahipoi: ahin Ephraim molsana kon mikhat Bikhri chapa amin Sheba chun David lengpa dounan akhut alamin ahi. Ama changseh chu hinpe doh-un, chule keiman khopi hi dalhatange, ati. Chuin numei nun Joab henga, Ven aluchang chu bang chunga kona kahin selhahpeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichun numeinu chu chingtheitah in mipi ho jouse henga chun achen ahi. Chuin amahon Bikhri chapa Sheba chu alu atanun, Joab henga asepdoh taovin ahi. Chuin aman sumkon amutnin, chuin amaho khopi-a konin ama ama pon-in cheh-a akile taovin ahi. Chuin Joab lengpa henga Jerusalem'a ahung kiletan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tun Joab chu Israel janel chunga ahin: chule Jehoiada chapa Benaiah chu Chereth mite le Peleth mite chunga ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Adoram chu kaidong pipu ahin; chule Ahilud chapa Jehoshaphat chu thuching ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Sheva chu danthusun ahin; chule Zadok le Abiathar chu thempu ahilhone.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Jair mi Ira chu David dinga vaihom pipu ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin David nikho laichun akum kum-in kum thum kel alhan ahile, David'in Pakai chu adongin ahi. Chuin Pakaiyin, Hichehi Saul le thisanso hat a-insung mite jeh ahi, ajehchu aman Gibeon mite chu ana thatnin ahi, tin adonbutne.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin lengpan Gibeon mite chu akouvin, ajah uva hitin ati; (tun Gibeon mite hi Israel chate ahipouvin, amavang Amor mite amoh ho ahiuve; chule Israel chate chu ahenguva ana kihahselu ahi: ahin Saul'in Israel le Judah chate-a dinga atompan nalama thadinga anahol ahi).
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun David'in Gibeon mite henga, Nangho dinga ipi kabolpeh diuham? chule Pakai goulo hohi phatthei nabohna diuva, ipi-a longlhena kabol dingham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Gibeon mihon ajah-a, Keihon Saul ahiloule a-insunga kon sana dangka kadeipouvin, chule keiho-a dinga jong Israel sunga mi khatcha natha louding ahi, atiuve. Chuin aman, Nanghon nasei seiju chu kabolpeh ding nahiuve, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amahon lengpa chu adonbutnun, Israel gamsung munkhat cha-a jong kaum louna diuva suhmang dingle thagam dinga eigopao thudola,
  </para>
  <para style="p">
    <verse number="6" style="v" />Achapate pasal sagi chu keiho eikipedoh-uhen, chule keihon amaho chu Pakai henga, Pakaiyin analhen Saul umna Gibeah'a chun khaisang uvinge atiuve. Chuin lengpan, Amahochu kapeh dingu nahiuve, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla lengpan Saul chapa Jonathan chapa Mephibosheth chu Pakai hahselna amaho kah, David le Saul chapa Jonathan kah-a aumjeh chun akhendoh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun lengpan Aiah chanu Rizpah'in Saul'a dinga ahinpeh achapateni Armoni le Mephibosheth le, Meholath mi Barzillai chapa Adriel dinga ahin Saul chanu Michal chapa ngaho chu alan,
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman amaho chu Gibeoh miho khutna apedoh-in, chule amahon amaho chu Pakai masanga lhang chunga akhaijun ahi. Chuin amaho abonchauvin mi sagi chu chang-at nikho masapen, sakolchang ki-at tillin thakhatnin athat taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Aiah chanu Rizpah'in khaodip pon khat alan, chang-at kipatna pat van'a kona hicheho chunga twi ahung chuh tokahse-a ding chun amanu-a dingin songpi chunga aphan; chule sunle chungleng vachaho, chule janteng gamlah-a gamsaho chu achunguva achuh sahpon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Saul thaikemnu Aiah chanu Rizpah'in athilbol chu David aseipeh taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin David achen, Saul le achapa Jonathan guho chu Jabesh-gilead mite koma konin agalan; hiche guho chu Philistine miten Gilbao mun'a Saul athajou uva, Beth-shan kholaija akhai naova kona ana guhdoh-u ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman hia konchun, Saul le achapa Jonathan guho chu ahinpodoh-in; chule amahon akhailih hou guho chu alohkhomun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amahon Saul le achapa Jonathan guho chu Benjamin gam Zelah mun'a apa Kish lhanna chun avuijun: chule amahon lengpa thupeh ho jouse atongdoh sohkeijun ahi. Chuin hiche jouchun Pathen'in gamsung mite taona chu angaipeh tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche chungchon chun Philistine ten Israelte dounan gal ahinbol kitnun; chuin David le asohte chu akonsuh-un, Philistine te toh akisat taovin: chule David chu achol lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin mihat chapate lah-a khat, atengcha chu sum-eng Shekel jathum-a gih Ishbi-benob kitipa chun, chemjam thah khat akikoijin, David chu thading agotan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin Zeruiah chapa Abishai'in amachu ahunghuh doh-in, Philistine mipa chu asatnin, athat tan ahi. Chujouvin David miho chu ahenga akihahselun, Israel meivah kisuhmit louna dinga, nangma keihotoh galkona nachekit louding ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin hiche jouchun ahitin ahi, Gob mun chun Philistine te toh akisat kit taovin; chuin Hushath mi Sibbachai chun Saph athatnin, amachu mihat chapate lah-a khat ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Gob mun'a chun Philistine te toh akisatpha kitnun, hilaija chun Benjamin mi Jaare-oregim chapa El-hanan'in Git mi Goliath sopipa chu athatnin, atenglung chu ponkhong ho pumlong te ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Gath mun'a chu gal akisat kitnun, hilaija chun mi atahsa lentah khat aumin, akhutjung gup chule akengjung gup, agoma somnileli ahin; chule mihat chihlhah ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman Israelte achou phatnin, David sopipa Shimea chapa Jonathan chun agathatnin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hicheng liho Gath'a mihatpa ding hungpeng ho, David khut le asohte khutna louho chu ahiuve.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pakaiyin amelmate jouse khut le Saul khutna kona ahuhdoh nikhon, David'in Pakai koma hiche lachengho hi aseijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman, Pakai hi kasongpi le kakulpi, chule eihuhhingpu ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Kasongpi Pathen ahin; keiman ama katahsan ding ahi: Ama kalum le kasochatna ki, ka-insang le kahoidohna, kahuhhingpu ahin; nangman pumhatna konin neihuhdoh tai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman pachat dinga lomtah Pakai chu kakou ding: hiti achu kamelmaho-a kona huhdoh-a kaumding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thina twi kinongin eium kimvel teng, Pathen heloute twisoh-in eikichatsah-e;
  </para>
  <para style="p">
    <verse number="6" style="v" />Thikholkhul lungkham nan eium kimvelin, thina thanghon eikimaitopi-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kagenthei tengle Pakai kakouvin, ka Pathen henga kapengin, Chule aman a-houin'a konin ka aw ahinjan, kapena chun anakhang sunga alutnin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun leiset akilingin akihotnin; van kibulphuna ho akihotnin, akilinge, ajehchu ama lunghanga ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin anah homa konin meikhu ahungdoh-in, chule akama kona meikong chun aval lhumin; hiche chun meihol ho chu ahal kong tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman van ho jong aloi nemin, chule ahung kumlhan; muthim chu akengto noija umin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ama Cherub chunga atouvin, alengin; chule amachu hui lhavingho chunga akimun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman akimvela muthim lhangkhal akihehsah-in, twi thimjeju le van'a meilom satah ho chu.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama masang vah-a kon chun mei-am ho ahung aldoh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakaiyin vangin bangin a-aw ahin sodoh-in; chungnung pen chun thu ahin seijin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman thalpi ho akapdoh-in, chule athe jal-in; kol aphet sah-in, amaho chu ajoutan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai phosalna le anahhoma ahu alhadoh-a konin; Twikhanglen toho chu akilangdoh-in, vannoi kibulphu naho jong akimudoh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman chunga konin ahinsolin, keima eiladoh-in; twi tamtah lah-a konin aman eikaidoh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka melma hattah ho-a konle eithetboltea konin eihuhdoh-in; ajehchu amaho keima dingin ahat behseh-un ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kahamsetna nikhon amahon eikimaitopi-un; ahinla Pakai chu kapanmun ahijinge.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman munlen tah-a jong eipuilutnin, kachunga akipa jeh-in eihuhdoh tai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakaiyin kachon phatna dungjuijin kipaman eipen, kakhut teni thenna dungjuijin aman eilethuh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu keiman Pakai lampiho kajuijin, chule ka-Pathen'a konin giloutah-in kapot pon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu ama thutan ho jouse kamasanga aumin: achonna dan kisunho thudola vang, keima hicheho-a konchun kapotdoh pon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Keima amasanga chondih tah kanahin; kakhangit louna-a konin kakikangsen ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun Pakaiyin kachon phatna dungjui eilethuh-a; amitmu-a kathena dungjuijin eilethuh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hepina neite henga nangman hepinanei nahi namusah ding; michondih ho henga nangma chondih nahi nakimusah ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mitheng ho henga atheng nahi nakimusah ding; milungkon te henga chingtah nahi nakimusah ding ahi
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule bolgentheija umte nangman nahuhdoh ding; mikiletsahte chu suhnema aumtheina dingun, namit chu achunguva aumin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu vo Pakai nangma kathaomei nahin; Pakaiyin kamuthim eisalvah pehding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajehchu nangma jala galmi honkhat douna kalhai ding; ka-Pathen jala bang kachop khup ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathen vang, alampi achamkimin; Pakai thu chu akipho chenin; ama tahsan te jouse dingin ama alumdalu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu Pathen tailou, Pakai koiham? chule Pathen tailou, koiham songpi?
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathen chu kathahatna le kathaneina ahin: aman kalampi achamkimsah-in ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman kakeng sajuhnu keng bangin asemin; kamun sangho-a eitousah-in ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kakhutnin thih thalpi ho ajetboh nadingin; Aman kakhut galbolje ahilin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nangman nahuhhinga lumdal neipetan; nanun nem nachun keima lentah-in eisemdohtai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangman kalhuh louna dingin, kanoija kakalsona ding neikeh letpeh-in ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Keiman kamelmate kadelin, amaho kasumangin; chule amaho kasuh manghel kahsen kahungkile pon ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Athokit theilouna diuvin keiman amaho kamavon, kasumang helin; henge, amaho kakengto noija alhusoh taovin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ajehchu nangman galsatn-a dingin thahat na-in katai neigah peh-in; keima douna-a kipandoh hochu kanoija nakoitan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nangman keima eihot bolte chu kasuhmang nadingin, kamelmate lolho chu neipedoh-in ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amahon aveovin, ahinla ahuhdohdiu koima aumpon; Pakai jengin jong amaho adonbutpon ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hichun keima amaho chu vutvai bangin kavongoijin, chule lamlen dunga bonlhoh bangin kachotphan, akithejalji taovin ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nangman kamite kiphinna-a konin neihuh doh-in, Pathen hephalouho luchang dingin neikoitai: kahet khahlou mihon eijen nadingu ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Gamdang miho kahenga hungkipelut dingu: amahon ajah jah ule kasei angai dingu ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Gamchom mihochu hung lhadah untin, chule akikul khupnao mun'a kona kicha ding ahiuve.
  </para>
  <para style="p">
    <verse number="47" style="v" />Pakai chu ahingjingin, chule kasongpi chu nunnom hen; huhhingna songpi Pathen chu choisangin umhen.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kaphu eilah peh-a, mihemte kanoija sunema Pathen ahin,
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule kamelmate lah-a kona eipuidoh-a chu Pathen ahi: keima douna-a kipandoh ho chungvuma neidomsangin: mihuham ho-a konin neihuhdoh tan ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hijeh-a chu vo Pakai, Pathen hephalouho lah-a nangma thangvah ingting, chule namin vahchoi La kasah ding sange.
  </para>
  <para style="p">
    <verse number="51" style="v" />Amachu aleng dinga sochatna insang ahin; chule athaonu David le achilhahte henga a-itih chanin hepina amusah-in ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hiche hohi David thusei nunungpen ahitai. Chungnung pena dopsanga umpa le Jacob Pathen'in thao anu, chule Israelte lah-a lathempen Jesse chapa David'in aseitai;
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai lhagao chun keija konin thu aseidoh-in, chule athu kaleija achengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel Pathen'in hitin aseijin, Israel songpin kajah-a hitin aseije, Mihem chunga vaihompa chu thudih ding, Pathen ging puma vai ahomding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amachu meibol kailouni jingkah, nisa ahungso doh-a khovah tobang hiding; gojuh jouva leisetna kona thengsela hungdon doh h amhing tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka-insung hi Pathen'a dingin chutobang chu hihih jongle; aman keimatoh tonsot kitepna asemin, thiljouse thonlou dingin kitoh tah-in akoijin ahi. Ajehchu aman hichehi kahuh hingna jousele kangaichat ho jouse chu ahi; aman akhantousah lou dingham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla Belial chapate chu ling kisatlha-a kipaidoh tobang hidingu ahi, ajehchu amaho khutna kiman theilou ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla amaho gatongkha-a michu thih le tenglung ki-um khumding; chule amaho hiche mun'a chu meija kihalvam ding ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichehohi David'in anei mihat ho minchu ahi. Tachmon mite touna-a tou, lamkaiho lah-a pipu chu Ezni mi Adino ahi: aman mi jaget dounan atengcha alamin, amaho chu khatvei tha-in athat gamin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule ama bantah-a chu ahile, David le amihat thumho lah-a khat, Ahoh mi Dodo chapa Eleazar ahin, amahon galsat dinga galmuna kikhom Philistine te agahchou laijun, Israel miho chu ajam mang taovin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ama akipatdoh-in, chemjam le akhut kikhen louvin, akhut angoi tokahsen Philistine te chu athatnin ahi. Chule hicheni chun Pakaiyin nasatah-in gal ajosah-un; chule mipi chu ama nunga thil kichom dingin akileuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ama bantah-a chu Harar mi Agee chapa Shammah ahi. Chuin Philistine te chu louthul dimsetna gambih khatna apunin akikhom khomun: chule mipi chu Philistinete-a konin ajamtaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla ama loujao lailunga chun adingin, ngahtupmin apangin, chule Philistine te chu athatnin ahi. Hichun Pakaiyin nasatah-in agaljo sah-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule lamkai pipui somthum lah-a thum chu achesuh-un, chuin chang at laijin Adullam songkoa David henga ahungun: chule Philistine te sepaiho chun Rephaim phaichama gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule David chu kosung khatna aumin, chule Philistine te sepaihon chu Bethlehem'a umuva ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin David'in ngaicha tah-in, Ohe Bethlehem kotpi phungkom twikul'a twi chu dondin mi khat touvin eihung pethei taveleh! ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin mihat thumho chun Philistine janelho lahchu aphujalun, Bethlehem kotpi phung koma um twikul'a twi chu athalun, chule David henga ahindomun ahi. Ahijeng vangin aman hichu adonpon, ahinla aman Pakai henga asunglhatan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman, Vo Pakai hiche kabol dinghi keija konin gamlahen: hiche ahinkhou tijat umtah-a dinga phaldoh miho thisan hilou ham? ati. Hijeh-a chu aman adon tapon ahi. Hiche mihat thumho hin hicheho hi aboldoh-u ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Zeruiah chapa Joab sopipa Abishai chu thumho lah-a apipuipen ahi. Chuin aman mi jathum dounan atengcha chu alamin, amaho chu athatnin, chuin thumho lah-a chun aminthang tan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amachu thumho lah-a ja umpen hilouham? Hijeh chun ama amaho gallamkai ahitai. Hijongle amasa thumho lah-a chun apang phapon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Kabzeel'a mihangtah khat chapa Jehoiada chapa Benaiah, thil tamtah tongdohpa chun, keipi bahkai tobang Moab mini athatnin ahi. Chule aman buh lhahlaijin achesuh-in, kotong sung khatna keipi bahkai khat jong athatnin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman Egypt mi miphatah khat athatne: Egypt mipa chun akhutna tengcha akichoi ahin, hinlah aman tenggol khat achoijin achesuh-in, Egypt mipa khutna konchun tengcha chu alahpeh-in, ama tengcha mama-a chun ama chu athatnin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jehoiada chapa Benaiah'in hiche thilhohi anabolin, chule mihat thumho lah-a chun ama aminthang tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amachu somthum hosangin ja aum cheh-in, ahinla amasa thumho chu aphapon ahi. Chuin David'in ama ngahtupho chungvuma akoitan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Joab sopipa Ashahel chu somthum holah-a khat ahin; Bethlehem'a um Dodo chapa Elhanan,
  </para>
  <para style="p">
    <verse number="25" style="v" />Harod mi Shammah, Harod mi Elika,
  </para>
  <para style="p">
    <verse number="26" style="v" />Palt mi Helez, Teko mi Ikkesh chapa Ira,
  </para>
  <para style="p">
    <verse number="27" style="v" />Anathoth mi Abiezer, Hushath mi Mebunnai,
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahoh mi Zalmon, Netophah mi Maharai,
  </para>
  <para style="p">
    <verse number="29" style="v" />Netophah mi Baanah chapa Heleb, Benjamin gam Gibeah'a kona Ribai chapa Ittai,
  </para>
  <para style="p">
    <verse number="30" style="v" />Pirathon mi Benaiah, Gaash vacha dungho-a kon Hiddai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Arbath mi Abialbon, Bahur mi Azmaveth,
  </para>
  <para style="p">
    <verse number="32" style="v" />Shaalhon mi Eliahba, Jashen chapate lah-a Jonathan,
  </para>
  <para style="p">
    <verse number="33" style="v" />Harar mi Shammah, Harar mi Sharar chapa Ahiam,
  </para>
  <para style="p">
    <verse number="34" style="v" />Maachath chapa, Ahasbai chapa Eliphelet, Gilon mi Ahithophel chapa Eliam,
  </para>
  <para style="p">
    <verse number="35" style="v" />Karmel mi Hezrai, Arbai mi Paarai,
  </para>
  <para style="p">
    <verse number="36" style="v" />Zobah'a Nathan chapa Igal, Gad mi Bani,
  </para>
  <para style="p">
    <verse number="37" style="v" />Ammon mi Zelek, Zeruiah chapa Joab galvonpopa Beeroth mi Naharai,
  </para>
  <para style="p">
    <verse number="38" style="v" />Ithrite mi Ira le Ithrite mi Gareb,
  </para>
  <para style="p">
    <verse number="39" style="v" />Hit mi Uriah ahiuvin, abonun mi somthum le sagi ahiove.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai lunghanna chu Israelte dounan ahung koujah kittan, chuin amaho douna-a David atilin, Chenlang, Israel le Judah gasimin, atisah-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu lengpan aumkhompi janel gal lamkaipa Joab henga, Amijat kahet theina dingin, tun chenlang Israel phungho jouse Dan'a pat Beersheba geijin gasimin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Joab'in lengpa henga, Ka pakai lengpa mitnin amutheina dingin, Pakai na-Pathen'in amaho ijat hijeng jongleu ajat jakhat-in punsah hen: ahinla ipi dinga ka pakai lengpan hiche hohi nangaichat ham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahijeng vangin lengpa thu chu Joable janel lamkaiho chu anehjou jotan ahi. Chuin Joab le janel lamkaiho chu lengpa mitmu tah-in Israel mipi ho sim dingin apotdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amaho Jordan agalkaijun, Gad vachadung koma uma khopi jetlam Jazer langsang Aroer mun'a chun ponbuh asong taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin amaho Gilead le Tahtim-hodshi gam ahung lhungun; chuin amaho Dan-jaan le Zidon veldung ahung lhungun,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Tyre kulpi dettah le Hiv mite khopi jouse le Canaan miho khopi jouse-a ahungun: chuin amaho Judah lhang lamsang Beersheba changeijin acheuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun amaho agamsung jouse-a acheleuvin, lhakole nisomni alhinin amaho Jerusalem ahung lhungun ahi
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Joab'in mipi akisimdoh jat chu lengpa apedohtan: chule Israelte lah-a chun mihangsan chemjam lamthei cheh sang jaget aumin, chule Judah miho lah-a chun mi sangjanga aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman mipi asimjou phatnin David chu alung nalheh jengin ahi. Chuin David'in Pakai henga, Kana thilbol chungahin kachonse lheh jengtai: chule Vo Pakai, tu-a hi nahenga katao ahi, nasoh khangit lounahi ladoh in; ajehchu keiman ngolhoi tah-in na kanatongin ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun David jingkah-a ahungtho phatnin, Pakai thu chu David mitvah neipa Gad themgao henga ahungin, aseije,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chenlang David henga, Pakaiyin hitin aseije, keiman nangma thil thum kapei, nachunga kalhunsah dingin, thumlah-a hin khat penpen kilhenin, tin gaseijin ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun Gad David henga ahungin, amachu aseipeh-in, ajah-a, Nagam sunga kum sagi kel hunglha ding ham? ahiloule nangma namelmate masanga lhathum najama amahon nanung adeldiu ham? ahiloule nagamsunga hiset nithum lang dingham? Tun eihinsolpa henga kakilea kadonbut theina dingin neihilin, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin David'in Gad henga, Keima nasatah in kagenthei tai; tun eiho Pakai khutna kipelut jenguhite; ajehchu amihepina alenin ahi: chule mihem khutna vang lutpou hite, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun Pakaiyin jingkah-a pat, aphat kitep geichun Israelte lah-a chun natset alhahsah tan ahi. Chutichun mipi lah-a konin Dan'a pat Beersheba geijin mi sangsomsagi athitan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Jerusalem suhmangna dinga vantil'in achunga akhut alap phatnin, Pakaiyin thilphalou abolgotna konin alung aheijin, mipi sumang ding vantil henga chun, Aphaset tai: nakhut chu tuhtang tan, ati. Chuin Pakai vantil chu Jebus mi Araunah pholla chun aumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin David'in mipi ho sumang dinga vantil chu amuphatnin, Pakai henga, Ven keima giloutah-in kanachonin, kachonse tai: ahinla hiche kelngoiho hin ipiham abollu? nahenga katao ahi, nakhut chu keima le kapa insung dounan chujohen, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hicheni chun David henga Gad ahungin, ajah-a, Kipatdoh-in, Jebus mi Araunah pholmuna khun Pakai dingin maicham khat gasemin, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakai thupeh le Gad seidung juijin David achetoutan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Araunah'in aven ahile lengpa le asohte chu ahenglama ahung amun ahi. Chuin Araunah chu achedoh-in, lengpa masanga chun tolla amai asulut tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Araunah'in, Ipi dinga ka pakai lengpa hi asoh henga hunga ham? ati. Chuin David'in, Mipi ho-a kona natset suhtanga aumna dinga, Pakaiya dinga maicham khat semna dinga nachangphol chodinga hunga kahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Araunah'in David henga, Ka pakai lengpan aman phante atibang chun kilah henlang pejenghen: Ven, hikoma hin govam thilto-a toding bongchal, chule thinga manding changphola manchah ho le bongchal manchah dangho aumin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hicheho jousehi Araunah'in lengpa dinga abola apehdoh ahi, ati. Chuin Araunah'in lengpa henga, Pakai na-Pathen'in nasanpehhen, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin lengpan Araunah henga, Ahipoi, keiman thonlouva nangma-a kona aman uma kachoh ding ahi: chule keiman imacha suhmang louhela Pakai ka-Pathen henga govam thilto katolou ding ahi, ati. Hitichun David'in changphol le bongchalho chu dangka shekel somnga in achotan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin David'in hia chun Pakaiya dingin maicham khat asemin, govam thilto hole chamna thiltoho atohtan ahi. Hitichun Pakaiyin gamsung taona chu angaipeh-in, chule Israelte lah-a konin natset chu akitolmang tan ahi.
  </para>
</usx>
