<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JON" style="id">Jonah</book>
  <para style="h">Jonah</para>
  <para style="toc1">Jonah</para>
  <para style="toc2">Jonah</para>
  <para style="mt">Jonah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Amittai chapa Jonah henga Pakai thu ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kipat in lang, khuche khopi lentah Nineveh'a khun chen, chule ama dounan hiche thuhi gasam phongin; ajehchu akhansetnao chu kahenga ahung lhung touve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin Jonah akipatdoh-in Pakai angsunga konin Tarshish lama jam dingin Joppa-a achesuh tan ahi; chuin aman kong khat Tarshish lam cheding amun: hitichun touna man chu apen, Pakai angsunga konin Tarshish lama chedingho toh chekhom din, asunga akumsuh tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin Pakaiyin twikhanglen'a chun hui hattah ahinsoltan, huile go kitho nasatah ahung chutan, hitichun chuche kong chu keh dingin aumtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin kong tol ho chu akicha taovin, amitin chu a pathen heng cheh uva ataovun, chule kong sunga um thil ho chu kong ajankhai theina din alauvin, twikhanglen'a aseplha taovin ahi. Ahin Jonah vangchu kong sung ning khatna ana kumsuh-in; hia chun alumin, a-imumil deltan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun kong pipuipa chu ahenga ahungin, ajah-a, Vo ihmumil delpa, nangma ipi ngaito nahim? thoudoh-in lang eiho imanthah louna diule Pathen'in ichunguva lunggel ahin neitheina din, na Pathen henga taovin ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amaho amitakipmin aloi agol kom cheh-a chun, Hungun, koipen jeh-a hiche thilse hi ichunguva chua ham ti ihetdoh theina diuvin vang sannu hite atiovin ahi. Hitichun amahon vang chu asantaovin ahile, Jonah chunga achutan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun amahon ajah-a, Nahenga kangeh-u ahi, neisei peh-un, koijeh-a hiche thilse hi ichunguva chua ham; ipi natonga nahim? hoija hungkon nahim? ipi gam mi nahi ham? chule ipi nam mi nahim? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman ajah uva, Keima Hebrew mi kahin, twikhanglen le leiset sempa Pakai van Pathen chu kakichan ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin miho chu nasatah-in akicha cheh taovin, ahenga, Ipi dinga hitobang hi nabol hitam? atiuvin ahi. Ajehchu amaho aseipeh jeh chun, Pakai angsunga kona jama mi ahi ti chu amahon ahetauvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon ajah-a, Twipi hi kadinguva athip theina dinga nachunga hi ipi kaboldiu hitam? atiovin ahi, ajehchu twipi chu akinongin hui leh go akithotai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman ahenguva, Neidom uvin lang twipia chun neiseplha taovin; chutile nangho dinga twipi hi thipding ahitai: ajehchu keima jeh-a hiche huipi gopihi nachung uva chua ahi ti keiman kahei, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahijeng vangin miho chun kong chu tolgo lam lhutna teidin hatah-in atolun, ahinla ajoutapouvin ahi. Ajehchu twipi chu akinongin, huipi leh gopi chu amaho chunga akhoh cheh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun amaho Pakai henga ataovun, Nahenga kataovu ahi, Vo Pakai, nahenga kahung taovu ahi; hiche mihempa hinkho jeh hin neimanthah sah hih-un, chule themona bei thisan chu kachunguva kikoi hihhen; ajehchu Vo Pakai, nangin nalungdei banga nabol ahi, atiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun amahon Jonah chu adomun, twipia aseplha taovin ahi: chutah-in twipi chu akinon na-a konin athiptan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amahon Pakai chu kichat mainan akicha tapouvin, Pakai henga ganlhaina abolun, chule kitepna aneijun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tun Pakaiyin Jonah val dingin ngapi lentah khat gotsan anakoijin ahi. Chuin Jonah chu ngapi oisunga ni thumle jan thum aumin ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Jonah ngapi oisunga konin Pakai a-Pathen henga ataovin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hitin aseije, Eikibol gimna jeh-in Pakai henga kataovin ahile, aman eingaipeh-in; keima thikholkhul tobang ngapi oisunga konin kataovin ahile, nangman ka aw neingaipeh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nangman twithuh tah, twipi lailunga neiseplut nin; twisoh ho chun eium kimveltan: natwi kidil hole twikinong ho chun eichuptan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujouvin keiman, Namitmu-a kona keima kipaimanga um kahitan; hijongle nahouin theng lam chu kahin galdot kit ding ahi, kati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Twihon keima eiumkimvelin, kahinna chan geijin; twithuh-in kakimvel akhah chah-in, hamdong hon kalu kimvel atomin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima molsang ho bul geijin kakumsuh-in, leiset le agol kijam ho chu a-imatih-a dingin kakimvela aume; hijongle Vo Pakai ka Pathen, nangman kahinkho hi thina kokhuh-a konin napui dohtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kasungila kahinna hi alhahlhop tengle Pakai kageldohjin; chule kataona hi nangma heng, nahouin theng sunga ahung lhungjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pannabei jouthu kisei nitna miho chun akihepinao chu adalhah-u ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla keiman vang thangvahna awging puma nahenga kilhaina kaneiding, chule kakitepna jong chu kapeh ding ahi. Huhhingna hi Pakaiya kon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Ngapi henga thu aseijin ahile, Jonah chu vapam leigo chunga ahin lodoh tan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin anivei channan Pakai thu chu Jonah henga ahungin, aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kipatdoh-in, khuche khopi lentah Nineveh'a khun chen, chule keiman seiphong dinga kapeh thuhi gaseiphongin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun Jonah akipatdoh-in, Pakai thu dungjuijin Nineveh'a chun achetan ahi. Tun Nineveh chu khopi lentah ahin, ni thum sung kijot ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jonah chu khopi sung alutnin, ni khat lampi ajot panin, aman, Tua pat nisomli joule Nineveh kisumang ding ahi, tin asamin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Nineveh miten Pathen chu atahsan taovin, an ngolna ding aphongun, amaho alenpenna pat aneopen chan geijin khaodip pon akisilun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule thu chu Nineveh lengpa henga ahung lhungtan, chuin ama alaltouna-a konin akipatdoh-in, alalvon chu akoilhan, khaodip pon akikhun, vut lah-a atoutan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman lengpa le amilalte minna Nineveh khopi pumpi-a phonjala sapphong dingin thupeh aneijin, hitin ati, Mihem hihen sahem hijongle, bonghon hihen kelngoihon hijongle imacha atep louhel diu ahi: amahon an jong anehlou diu, twi jong adonlou diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin mihem le ganchaho chun khaodip pon kikhu-u henlang, Pathen henga nasatah-in taovuhen. Ahi, amitin athilse bolna lampile akhutnuva pumhat thilbol ho-a konin hung kilekitnuhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eiho imanthah louna dinguva, ijemtia Pathen ahung kihei kitna alung aheija, alungsatna khohtah-a kona akiheimang kit thei ding kon aseithei ding ham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pathen'in anatoh hou, athilse bolnao lampi ho-a kona ahung kilehei kitnu chu amun; chule Pathen'in achunguva kabol ding ahi tia asei thilse-a kon chun alung aheijin, aboltapon ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla hiche hin Jonah chu hatah-in alunglhaisah tapon, ama alunghang lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama Pakai henga ataovin, Vo Pakai, nahenga katao ahi, kachenna gamsunga kaum petna kanasei chu hiche hi ana hilouham? Hijeh-a chu namasanga kona Tarshish lama kanajam ahi. Ajehchu nangma lungsetna dim Pathen, hepina dim, lunghang vahlou, khotona lentah nei, thilse-a kona lungheiji Pathen nahi kahet ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun tun Vo Pakai, nahenga katao ahi, keima-a konin kahinkho hi latan; ajehchu keima dingin hinsangin thi aphajoi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun Pakaiyin, Nalunghan hi pha nasah ham? ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Jonah khopi-a konin apotdoh-in, khopi solam sanga atouvin, hia chun buhkhat asongin, khopi chunga chu ipi hung lhungem ti amutheina din buhlim noija chun atouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakai Pathen'in umgui khat ahin kedohsah-in, alung hesohna-a kona huhdoh-a aumna dingle, aluchunga nilima pang dingin, Jonah chungvuma akhandoh sah-in ahi. Hitichun umgui jal chun Jonah akipah lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla akit nikho jingkah ahunghi phatnin, Pathen'in lung khat ahinsolin, hichun umgui chu anegamin ahile agolhatai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi, nisa ahungso phatnin, Pathen'in solam hui gimsetah-a sa chu ahin nunsah-in; chule nisan Jonah luchung chu ahinkhon ahile ama alha lhoptan, chuin aman thiding alhangai tan, Keima dingin hinsangin thi ding aphajoi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pathen'in Jonah henga, Umgui jeh-a nalunghan hi dih nasah ham? ati. Chuin aman, Thina chan geija dinga kalunghan hi dih kasai, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun Pakaiyin, Nangman natohgim jong hilou, nakhansah jong hilou, jankah-a hungkeh doh-a jankah-a mangthah-a umgui chunga bon hepina naneija ahile;
  </para>
  <para style="p">
    <verse number="11" style="v" />Achutile chuche Nineveh khopi lentah, asunga akhut jetlamu le akhut veilamu jong hekhen theilou mihem sangjakhat le sangsomni hole, gancha tamtah ho khu keiman khendoh louva kakoi ding ham? ati.
  </para>
</usx>
