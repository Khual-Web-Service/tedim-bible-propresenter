<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PSA" style="id">Labu</book>
  <para style="h">Labu</para>
  <para style="toc1">Labu</para>
  <para style="toc2">Labu</para>
  <para style="mt">Labu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen ngaisahlouho thumopma chonlou, michonse te lamlhah-a jong dingle lou, i-sah louho touna-a jong toulou michu anun nome.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amavang alung lhaina chu Pakai danthu-ah aumin; adanthu chu sunle janin angaito jin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amachu vadung panga thingphung kiphut tobang, aphatcha aga sodoh jia, anajong gop louding; chule abol jousea lolhing ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen ngaisah louho vang chutobang ahipoi. Ahin huijin amut mangji changvai tobang bou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Pathen ngaisahlouho chu thutan na-a ding jouloudiu, chujongle chonseho chu michonpha ho houkhom na-a pangloudiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Pakaiyin michonpha ho lampi chu ahen, hinla Pathen ngaisahlouho lampi vang mangthah ding ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ibola Pathen hephalouho lunghanga, chule mihon mohthu homkeo angaitou ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Leiset lengho atoukhomun, vaipoho akihoutoh-un, Pakai leh athaonu dounan hitin aseijuve,
  </para>
  <para style="p">
    <verse number="3" style="v" />Eihon akikana akhao holhou suhtanpeh-u hitin, akhaohou eihoa konin paimangu hite.
  </para>
  <para style="p">
    <verse number="4" style="v" />Van ho-a toupa chu nui jintin, Pakaiyin amaho chu nuisat inte.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutengle ahenguva lunghangin thu seijintin, lung nommo-a achunguva lunghang ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitajongle kalhang theng Zion chunga kalengpa katousah-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thupeh chu keiman phongdoh inge, Pakai chun kahenga, nangma kachapa nahin; tunia hi kahin nahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kahenga thumin, keiman namtin chu nagoulo dinga kapeh ding, chule leiset kolmong geichu nagouchan dinga kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangin amaho chu thih tenggola navohcheh-a; beldengpa bel banga ahal ahala nasuhchip ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun, vo nangho lengho, tuhin kichih theijun; nangho vannoi thutan ho kihilphaovin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai chu kichapumin jenunlang, kithing pumpumin kipah-un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chapa chu chopmun; achutiloule lunghang intin lamdunga konin mahthah getnun nate, alunghan chu neocha a deujahji ahi. Ama-a atahsan koiho chu anunnom ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Pakai, eidouhohi iti pun hitam! Eidouva kipanho chu atamlheh uve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen ama kithopi ding aumpoi, tia kahina thudol seija chu tamtah ahi. Selah
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla, vo Pakai, nangma chu keidinga lumdal nahin, kaloupi nale kalu eidop sangpeh-a chu nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima ka Pakai henga aw gingin kataovin, aman alhang thenga konin eihin houve. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Keima kalumin, ka-imujin; Pakaiyin eihoi damjeh-in, kahung thoudoh kitne.
  </para>
  <para style="p">
    <verse number="6" style="v" />Eidouva eium kimvel mipi sangsom hi kicha taponge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hung thouvin, O Pakai; vo ka Pathen, neihuh doh-in! Ajehchu kamelmate jouse chu abeng gu-u najep pehjin; Pathen ngaisah louho ha chu navoh pulpeh jie.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huhhingna chu Pakaiya ahi. Na phatthei bohna chu namite chunga um ahi. Selah
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo kachon phatna Pathen, kakou tengle neihouvin, gentheija kaum tengle nangin neipanpijie, ka chunga hepina neijinlang, kataona ngaijin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo nangho mihem chapate, kaloupi nahi itihchan jachatna a nahei diuham? Itih changei mohthu homkeo nangailut uva chule jouthu naholdiu ham? Selah
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla Pakai chun ama dinga Pathen ngaisahho chu amadin akhendohtai ti hethemuvin; keiman ama kakou tengle Pakaiyin ajahding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kichageuvin dingun lang, chonse hih un; najalkhun chunga lungthimin kihou unlang, thipbeh chan umun. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Chonphatna le ganlhainaho chu peuvinlang, chule Pakaiya natahsanu ngamdetnun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tamtah-in thilpha kon eimusah untem? atiuve; Pakai namaiso vah chu kachunguva hindomsangin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangin, midanghon changle lengpitwi tamtah aneilaijuva sanga chungnungjo kipana kalungsunga nakoije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keima lungmong tah-a kalupma chuleh ka-imut ding ahi: Ajehchu Pakai, nangma bou bitkeija eichensah nahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Pakai, kathusei neihin ngaipeh inlang, kalunggel neingaito peh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka lengpa leh ka Pathen, kakouna aw hi neingaipeh-in; ajehchu nahenga katao ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka-aw hi jingkah le najah ding ahi; O Pakai jingkahle chunglam vea nahenga taona kahin lhutding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nangma gitlouna-a kipahji-a Pathen nahipon; thilse tojong chengkhom thei nahipoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Namitmu-a mingol dingthei louding; nangin khansetna boljouse nahot ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman jou seiho chu nasuhmang ding; Pakaiyin thisanso hat le milhemlha chu athet ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla keivang, namilungset haotah jeh-in na insunga chun hunglut ingting; chule nangma kichapumin na houin theng lam ngan nahin houvinge.
  </para>
  <para style="p">
    <verse number="8" style="v" />O Pakai, kamelmate jeh-in nadihna-a chun neipuijin; kamasanga nalampi hinlhung jangin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu akam sunguva kitahna aumpon, asunglamu gitlouna adimin, alol homu lhan kihongsa ahin, aleijuvin amaho akiphatsei juve.
  </para>
  <para style="p">
    <verse number="10" style="v" />O Pathen, amahohi, sumangin, athu hiluva amaho lhuhsah-in, Nangma nadoujeh ule asuhkhel nao tamtah jehchun, mipi lah-a konin amaho paidoh jengin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla atahsanu nangma-a ngamdet jouse kipah uhen; Nangman amaho nahonbit jal-in kipanan ao vuhen, namin ngailuho jouse jong nanga kipah uhen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu Pakai, nangman, michonpha phatthei boh-in natin, khotona-a lum banga nadal kimvel ding ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai lunghangin neipho danlang, lungphamon jong neijep hih-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Pakai kalhahsam jeh-in nei hepin, vo Pakai, kaguhon eichi natsoh jeh in neidamsah in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kahinna jong agenthei behsehtai: ahinla, O Pakai, itihchan hiding ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />O Pakai, hung kinunglen lang kahinna huhhingin; oh nahepinaho jal-in neihuhhing in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu thina-a chun nangma geldohna aumtapon, lhankhuh sunga nangma kon nathangvah ding ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Kakhoisat satna-in kalel lhehtan; Janseh-in kajalkhun kijapnan kaneijin, kalupna kamitlhin kachap lhop-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kamit jong lungkhamna jeh-in angui lhatan, Kamelmaho jouse jeh-in atehsetan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin kataona eingaipeh tah jeh-in; khansetna bolteho jouse kakoma konin chemang uvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakaiyin kathumna eijah pehtan: Pakaiyin kataona eisanpeh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kamelmate jouse jahchao henlang thohgim lheh uhen. Hungkileu henlang photlot louvin jahchao hen.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai ka Pathen, nangma-ah katahsan kangame, eibol gentheiho jouse-a konin neihuh doh-in lang, neihoidoh in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Achutiloule, eihuhdoh ding umloupetnahi, keipi bahkai banga kahina abotela, ahal hala akoiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />O Pakai ka Pathen, hichehi kabol ahia, kakhutna khansetna uma ahile;
  </para>
  <para style="p">
    <verse number="4" style="v" />kaki champi khat chu thilse-a kalethuh-a ahileh, (henge, ajehbeija kaki champi khat chu kamelma dinga kapehdoh ahitan):
  </para>
  <para style="p">
    <verse number="5" style="v" />Melma chun kahinna hi bolgenthei henlang kilahjeng hen; henge, kahinkhohi, tolto lhobeh henlang, kaloupina hi leivui toh chil halhen. Selah
  </para>
  <para style="p">
    <verse number="6" style="v" />O Pakai, nalung hanna-a, hung kipat doh-in, kamelma teho lunghana jeh-in nangma hung kidomsangin; chule nangman nathupeh banga thutandin keima dingin hung thoudoh-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh-a chu mipi kikhomho chun nangma naum kimvel diu ahin; amaho khohsahna jal chun chungsang lama kiletan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin mihemte thu atanding ahi: O Pakai, kachon phatna dungjuile keija um dihna dungjuijin kathu tanin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Oh migiloute gitlouna chu kichai hen; ahinla midihte chu tung doh-in; ajehchu Pathen chonphatna chun lungsungle lunggel apatepjin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Eingah tupma chu, lungsung dihtah huhdohji-a Pathen'a kon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen chu michonpha ho thutan ahin, Pathen chu niseh-in migilouho chunga alunghangin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amachu akilehei louva ahileh, Aman achemjam anol hema, athalpi ajet kona, kigosa dema umding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thina manchah ho jong chu amandin agongtoh demin; misugenthei ho dounan athalchang ho asemtohtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Veovin, khansetna chu naosonat in anan, thilphalou chu avopmin, thujou chu ahung penglhatai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman kotong asemin, alaithuh in, akotong sema chun ama alhalutne.
  </para>
  <para style="p">
    <verse number="16" style="v" />Agitlouna chu ama luchang ngeija hungkilentin, a hunam thilbol chu alujanga hung chuding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Achonphatna dungjuijin keiman Pakai chu vahchoi jing ting, chungnung pen Pakai minin vahchoinan la sange.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai ka Pakaiyu, leiset pumpi sunga naminhi iti lula lul hitam! vanho chunga naloupina nakoijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangman melmate phulapa suhthipna dingle nangma melmaho jeh-in, naosen hole naonoichep laiho kama konin thahatna chu nasudet tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman nakhut junga nasemsa, navan munho kavetle-a, nangman nasuhdetsaho lha leh ahsi ho kavetji teng;
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihem hi ipi hija nangin hibanga nagelkhoh-a? chule mihem chapa hi ipiham hibanga nakhohsah?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu nangin vantil ho sangin themkhat bou nanoinun sah-in, chule jana leh loupina lallukhuh nakhuh peh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman ama chu nakhutsohho jouse chunga vaihomin nasemin; thiljouse ama kengto noija nakoije:
  </para>
  <para style="p">
    <verse number="7" style="v" />Kelngoile bongchal jouse, henge, gamlah a gamsaho;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chunga leng vachate, twikhanglen'a ngaho, chule ipi hijongleh twikhanglen'a lamlha ho jouse chunga vaipodin nasemin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pakai ka Pakaiyu, leiset pumpi sunga naminhi iti lulla lul hitam!
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, kalung pumpin nangma vahchoi jingting; nathilbol kidang jouse katah lang ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma-a kipah-in thanominge: Vo chungnung pen Pakai, namin vahchoilan sange.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kamelmate anungjam tengule, na-angsunga lhu uva mangthah diu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nangman kathemnale kachungthu navetup in; dihtah-a thutanin laltouna-a chun natouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangin Pathen hephalouho naphohjin, migilou chu nasumangin; aminu chu tonsotnadin nanoimang jin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo nangho melmate, manthah na ho chu kumkho-a din suhmangin aumin; chule nangin khopi ho nasumangin; amaho hetjingna chu amahoto amantha tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Pakai chu tonsotna umding ahin; Aman alaltouna chu thutanna dingin adotoh tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman chonphatna-a vannoi hi athu atanding, aman lungthengsela mipi ho thutanna aneiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Suhgentheija umte dingin Pakai chu kiselna ahin, lungkham laija kiselna mun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangma min heho chun atahsanu nanga angapdiu ahi. Ajehchu nangma holte chu, Pakai, nangman nadalha ngaipon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zion'a chenghon Pakai vahchoi La saovin; Athilbolho chu mipi lah-a phongdoh-un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman thisan kholchilna aneiteng amaho chu ahe jingin; aman mi kineosah ho ka awgin asumil ngaipoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />O Pakai, kachunga hepina neijinlang; thina kotpi-a kona eikaidohpa, eihot te-a kona kathohnahi neigel peh-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zion chanu kotpi phungho-a nangma thangvahna jouse kamusah theina dingin, nami huhhingna-a chun kipah inge.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathen hephalouho chu amaho sem kotong sunga alhalutnun; alenthang kamuva amaho keng mama a-oh jiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai chu athutan lhah natohna-a hetdoh-in aumjin, migilou chu ama khutsohho ngeija a-oh jiuve. Haggaion. Selah
  </para>
  <para style="p">
    <verse number="17" style="v" />Migilou chu damuna kilehlutding, chule Pathen sumil namjouse jong kilehlut ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu alhasama chu suhmilin umjing pontin, migenthei te kiholna tonsotnin mangpai ponte.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thouvin, vo Pakai, mihem kijosah hihhelin, namitmu tah-in Pathen hephalouho thu kitanhen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vo Pakai, namtinin mihem bou akihi ti ahettheina diuvin amaho chu kichatsah-in. Selah
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, ibolla gamlatah-a ding nahim? Lungkham laija ibola kisela nahim?
  </para>
  <para style="p">
    <verse number="2" style="v" />Migilou chun ahoithona lamin mivaicha asugentheijin; athilgonu chun amaho kipalsah jinghen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu migilou chun alung ngaichat asongin, Pakaiyin ahotlam kilosetna-a chun amaho anun nomui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Migilou chun ahoithona maiso-a konin Pathen holponte: Pathen chu ama ngaitona jouse-a aumpoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alamlhah jouse phattinin lungkhamna jeng ahin; nathutan lhahho chu sangtah-a um ahin, amuphapon; amelmate jouse chu anuisatnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman alungsunga, keima kiling ponge; ajehchu kidoupi kanei louding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Akamsung chu gaosapna, joulhepna, dohabolna adimsetnin; alei noija setnale mohthuhomkeu bou aume.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama khotina kichanlhih na munho-a atoujin; munthip ho-a themona neilouho athatjin: amit tenin panpibei ho guhthimin avelhin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Akosunga keipi bahkai bangin guhthimin akiselin achanglhi jin; migenthei chu matdin achangin, alensunga aloilutnin amanjitan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migenthei chu amihatpa koma alhuh nadin, ama akineosah-in tolla abohkhup jin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman alungthimin, Pathen'in asumilin, amai aseltai atin, aman itih-in mutaponte, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pakai, vo Pathen, thouvin lang nakhut domsangin, mikineosah ho chu sumil hih-in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ipidinga mikhang gilouvin Pathen anoise ham? Aman alungsunga, nangin hichehi ngaichapon nate atin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu ven thilphaloule thangthipna nakhutna phulahding chu nangin namutai. Migenthei chu nahenga ahung kipelutnin; nangma pabeiho panpi chu nahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi engsele miphalou banjang suhboh peh-in, agitlouna naholmohel kahsen holin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai chu atonsot atonsotna leng ahin; Agamsunga kona Pathen hephalouho amangthah uve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai nangin mi kineosah ho ngaichat najah peh-in, nangman alungthimu nagot pehding, chule najahna dinga nakol nasun ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Leiset mihemin abolgenthei kitlouna dinga, paneilou leh bolgentheija umho thu chu natanpeh ding ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiya katahsan ngaminge; iti dana nanghon kahinna jah-a, vacha bangin namolsang lama jamin neitiu ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu, veuvin, mikitah ho lungchang guhthima kapna dingin, migilou hon athalpiu ajebongun, athal changu akhaoto asuto taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abulpiho akisuh mangle, michonphan ipi abolthei tahding ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai chu a-houin thenga achengin, Pakai laltouna chu van'a um ahin, amit tenin ahinven, mihem chatehi apatepmin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin michonpha chu apatepjin, migiloule pumhat mangho chu ahinna in ahon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin migiloute chunga chu meihol, mei le kaat ajuhsah-a, chule kichat umtah khopihui anunsah ding; Hichehi achandiu khon chu hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu chonphatna Pathen chun chonphatna chu angailun; milungthengin ama mel amujin ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai, neipanpin, ajehchu Pathen he-a mi aumtapoi; ajehchu mihem chate lah-a konin tahsan um mi alosamjin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amitakipmin aheng akomah thumanlou jeng aseijun, pachat lhemna muh leh lungtho neipumin thu aseijui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin pachat lhemna muhle hoitho thu seina lei chu atanmui ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon, ileijun eihon jona neiju hite, imuhhoula eihoa ahin, ichunguva Pakai koiham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin, vaichaho kisuh gentheina jehle, lhasamho khoisatjeh-in, tun kipat ingting, noise-a nuisatpa-a konin amachu huhdoh-in koijinge atin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai thusei ho chu thu thengtah ahin; dangka leiset lhumpi sunga vel sagivei kisutheng tobang ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />O Pakai, nangman amaho chingjingin natin, amaho chu tukhanga pat tonsot geijin vetupnan nate.
  </para>
  <para style="p">
    <verse number="8" style="v" />Miphalouho chu akichoisang teng, khangitlouna chu muntina avahlen ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, itihchan neisuhmil ding ham? Tonsot geijinem? Keima-a kona namai itihchan nasel dingham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Niseh-a lungsunga lunggimna neija kahinna-a itihchan kagelgel dingham? Kamelmate kachunga itihchan choisanga umdiu ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pakai ka Pathen, ngaitonlang neingaipeh in, kamitteni vahsah in, ajole mithi ihmutnin ihmu khaget inge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajole kamelma chun ama kajoutai, tintin; chule kalonle tengle eidouva chu kipah getninte.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla nahepina ka tahsantan; nami huhhingna-a kalung kipahding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman thil ninglhing set eibolpeh jeh-in, Pakai vahchoinan keiman la sange.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mingolin alung thimin Pathen aumpoi, tin aseije. Amaho akisuboh-un, thil thet um abolun, thilpha bola khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahetoh them milungching leh Pathen hola aumkhatle, tin Pakai chun van'a konin mihem chate ahinvesuh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho ahilou lama achegam taovin, abonun aboh soh gamtaove: thilpha bola aumpouve, khat jengcha jong aumpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khangitlouna bolho jousen hetna himhim anei lou uham? Amahon achanglhah neh bangun kamite abahgamun, Pakaila akoupouvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chua chun amaho kichatah-in aummui; ajehchu Pathen hi michonpha khang sunga aumin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon migenthei thuhil chu najachat piuvin, hinla Pakai chu ama kiselna ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israelte kihuh hingna chu Zion'a kona hitavele o! Pakaiyin amite asohchan naova kona ahin lepuikit tengle, Jacob chu thanom intin, Israel chu kipah ding ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai nahoubuh-a koi aumin? nalhang thenga koi acheng tadem?
  </para>
  <para style="p">
    <verse number="2" style="v" />Lungdih-a chonale, chonphatna bola, chule alungsunga thudihsei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akama mi seise lou, aheng akom chunga jong thilse bollou, chule aheng akom i-sah louva douva bol hilou.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amitmua miphalou vetda, ahia Pakai gingho vang jabol; ama le ama kisuhkhah nadia kihahsel leh lungkhel kitlou.
  </para>
  <para style="p">
    <verse number="5" style="v" />Apung dinga sumpa hom ngailou, monabei chunga nehguh la ngailou mi. Hicheng thilho bolla chu imatih-a longlou ding ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen neiching phan, ajehchu nangah katahsan kangamin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo kahinna, nangin Pakai henga, nangma ka Pakai nahin, nangma kom tailouva thilpha kaneipoi, nati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla leisetna mithenghole milul ho henga, amaho-a chun kakipana jouse aumji-e nati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen dang nung del loiho chu alung hesohnao pungding; don thilpeh dinga apeh-u thisan jong katodoh louding, ahilouleh aminu jong kaphahpoh louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai chu kagouchanle kakhon ahi, nangman kachanvou chu neivettup peh-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tena khaoho chun munpha lai ho eikitedoh pehjin, henge, keiman gouphatah kaneitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima thumop eipepa Pakai chu phatthei boh inge, jan tengle kalungthimin eihiljin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman Pakai chu kamasanga kaumsah jingin, ama kajetlama aumjeh-in keima kiling ponge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun kalung akipah-in, kaloupina akipah-in; Katahsa jonghi kinepna-a choldo ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nangman kahinna hi damuna nadalhah lou ding; namitheng chu mon mangna jong namusah louding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangin hinna lampi neimusah-in; naumna chu kipanan adimin, nakhut jetna chu tonsot kipana uma ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, adihchu ngaijin lang ka kana hi ngailhin, alhem hilou ka kama kataona ngaina din nana hinsungin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kachunga thulhuhna chu nanga kon hihen lang, namit tenin thil kibangho chu vehen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangin kalungthim nakhol chilin, janteng nei vilin, nangman neipatep in, ima namu louding ahi; kakamin suhkhel aneilou dinghi kakigel lhahna ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihem natohho thudol, nakama thusoh jal-in, mi sumang jingho lampiho-a konin kakiveng tupmin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kakalsona kalhuh lounadin, nalampi ho kajotna-a neituh-in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Pathen, keiman nangma kakouvin, nangman neingaipeh innate; keima lama nakol hinsungin lang kathusei neingaipeh-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />O nanga atahsanu ngam jouse, amaho douho khutna kona khut jetna huhhingji-a chun, nangailut kidang chu neimusah-in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nalungset khat bangin neihongin lang, nalhalim noija neiselin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Eisumang thei migilouva konle, thitheina melma eium chahho-a konin neihongin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon alungthimu thaotah chu akhahtupmun; akamun kiletsah tah-in thu aseijuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon tun kakalsonao chana ei-umun; tollhanga suhngem dingin, amitnun eiveuvin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Keipi bahkaijin asatha apetel got bangle, keipi donglaijin munthip ho-a achanlhih abanguvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Pakai, thouvin, ama chu lunglhah sah-in, nachemjamin migilouva konin kahinkho huhdoh-in,
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo Pakai, nakhutna um mihemte-a konle vannoi mihem hiche hinkho-a chan neiho, atumpiu nagou sela nadip dimpeh ho-a konin kahinkho huhdoh-in; amaho chapang tamtah ahiuvin, athilu amoh chu achasen hou adalhahpeh taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman vang namai chu chonphatna-a kahinvet ding; Nangma bangtah-a kahungtho teng keima kalungna chimtante.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, kathahat nan, keiman nangma ngailunge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai chu kasongpile kakulpi chule eihuh hingpa ahi; ka Pathen, kathahatna, achunga katahsana kangap ding ahi; ka lumle, kahuh hingna ki, chuleh ka kulpidet ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vahchoi dia lomtah Pakai chu kou ingting, chutichun kamelma te-a konin huhdoh in umtange.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thina lung genthei nahon eiumkimvelin, Pathen nahsahlouho twisoh-in eikichatsah-e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thikholkhul lung genthei nahon eiumkimvelin, thina thangho chun ei kimaito pi-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kagen theina a Pakai chu kakouvin, ka Pathen kasamin; Aman a-houin'a konin ka aw ajan, kakana chu a-angsung geijin aluttan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujouvin leiset akilingin, akihottai; Ama lunghan jeh-in lhangbul ho chu achatnin akihottai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anah homa konin meikhu akitung doh-in, akama kona mei chun akavam heltan, hichun meihol a-al lenglung sah-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman vanho jong asonkunin, ahung kumlhan; muthim lhangkhal chu akengto noija aumin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama Cherub chunga atouvin, alenge, henge, hui lhavingho chungah alengin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman muthim lhangkhal chu ama munthip min asemin; akimvela apon in chu twipi thimjejule van'a meilhang satah chu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amasanga vahpem puma chun meilhang satah achen, gelchangle meikong alhan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakaiyin vanho jong thongjejun aginsah in, chungnung pen chun a-aw asodoh in ahile gelchangle mei alhan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Henge, aman athal changho chu asoldoh-in ahile akithe chehtai, aman kolpheho akapdoh in, chule amaho chu ajoutan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />O Pakai nangman napho-a nanah nakhon khum tengle twilona jouse akimujin, chule vannoi leiset bulpi jouse jong akilangdoh jin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman chunglama konin asolin, eituh in, twi tamtah lah-a konin eikaidoh-e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman kamelma hattah-a kon leh eihot bolho-a konin eihuhdoh-e; ajehchu amaho keidingin ahat lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hamsetna kato-nin amahon eikitopiuvin, ahinla Pakai chu kaki ngaina ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman mun lentah khatna jong eipuidoh-in, kachunga akipajeh-in eihuh dohtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kachon phatna dungjuijin Pakaiyin kipaman eipen, kakhut then dungjuijin eilethuhnai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu keiman Pakai lampiho chu kajui jingin, ka Pathen'a konin giloutah-in kapotdoh khapoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Athutan lhahna jouse kamasanga aumin, adan kisemho chu keija konin kapaidoh khapoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama anga chondih jong kahin, kakhan gitlouna-a konin kakihongbit jinge.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun Pakaiyin chonpha kahinale, amitmua kakhut athen dungjuijin eilethuh jin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihepi themho chu hepina musah-in natin; mi chondihho chu nachondihna vetsah-in nate;
  </para>
  <para style="p">
    <verse number="26" style="v" />Athenga chu nathenna musah-in natin, lung gilouho chu nalung gitlouna musah-in nate.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu nangin aki bolgenthei hochu huhdoh-in natin; akichoisangho chu nasotlhah ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu nangin kathaomei neivah peh-in natin, Pakai ka Pathen'in keija um muthim hi salvah-inte.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu nang jal-in sepaihon lah-a kalhaijin, ka Pathen jal-in kulbang kachopkhupme.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pathen dingin alampi apha chamkimin; Pakai thu chu patepmin aumin; Ama tahsan jousedin ama chu lumdal ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu Pakai tailou koiham Pathen? ahiloule i-Pathen'u tailou songpi koiham?
  </para>
  <para style="p">
    <verse number="32" style="v" />Hatna-a kakong eigehpeh-a leh kalampi sempha chamkima Pathen ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman kakeng chu sajuhpi keng bangin asemin, kamunsangho chunga eiumsahjie.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kaban teni-a thih thalpi kaheboh theinadin, aman kakhut teni gal bolje ahile.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nangin nahuhhingna lumdal jong chu neipen; nakhut jetlamin neikai doh-in nanun nemna chun lentah eisoi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kalhuh louna dingin, kakho lhahna ding neisem letpeh-in ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kamelmate nung kadelin, kaphan, amaho kasuh manghel kahsen kahungkile jipon ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amaho athodoh joulouhelna diuvin kamavon, kakengto noija alhusoh helun ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ajehchu nangin galsatna-a ding thahatna kong neigah peh-in; keima douna-a hungkipatdohho chu kanoija nasunem hele.
  </para>
  <para style="p">
    <verse number="40" style="v" />Eithetbol ho chu kasuhmang theinadin, nangman kamelmate ngong hochu neipetan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amaho apengun, ahinla ahuhdoh dingula khatcha aumpon; Pakai jengjong akouvun, ahinla aman adonbut dehpouve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chu jouvin huinung masanga vutvai bangin amaho kavogoijin; lamlena thilboh bangin kapai doh-in ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangin miho kisat tona lah-a konin neihuh doh-in; chule nangin keima Pathen hepha louho luchangin neisemin, kahetkhah lou mihon eijendiu ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kathulhut ajah jah-uleh eijoppai juntin; gamdang miho chu kahenga hungkipelut diu ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Gamdang miho chu hung lhasam untin, akulpi houva kona kithing pumpuma hung dohdiu ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Pakai ahing jinge; kasongpi chu nunnom hen; eihuh hinga Pathen chu choisangin umhen.
  </para>
  <para style="p">
    <verse number="47" style="v" />Kaphu eilahpeh-a, miho kanoija sunema chu Pathen ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Aman kamelma te-a konin eihuhdoh-e; henge, keima douna-a hung kipatdoh ho chung vuma neidom sangin; hunam mipa-a konin neihuh doh tai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Hijeh chun O Pakai, Pathen hephalou ho lah-a chun nangma na thangvah ingting, chutengle nangma min vahchoi la sange.
  </para>
  <para style="p">
    <verse number="50" style="v" />Aman huhhingna lentah chu alengpa apen, chule athaonu David leh achilhahte chunga chun ahepina tonsotna din amusah-e.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vanhon Pathen loupina aphong doh-un; chule vanthamjolin akhutsem amusah-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sunin sun jah-a thu aseijin, chule jan-in jan jah-a hetna amusah-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichea chun thu kisei aumpon, paole oginjong akijapoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Atena khao chu leiset pumpi-a chule athu uchu vannoi leiset kolmang geijin akikhon; Hicheho-a chun aman nisa dingin ponbuh khat asongin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichu moulang a-indana kona hungdoh tobang ahin, kilhaitetna-a lhaiding pasal hat bangin athanome.
  </para>
  <para style="p">
    <verse number="6" style="v" />Apotdohna chu van mong langkhatna kipan ahin, alhuna chu among langkhat chan ahi; chuche asatna-a kona kisela imacha aumpoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai dan chu achamkimin, hinna sempha-a ahi; Pakai thu hettohsah chu athengin, mimol ho achih sah-e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai dan kisemchu adih-in, lungsung akipasah-in; Pakai dan thupeh chu athengin, mit teni avahsah-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai ginchu athengin, a-imatih channa aumjingin; Pakai thutanlhahho chu thutah le chonphatna ahisoh keije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hicheho chu sana sangin jong dei aumjon, henge, sana thengsel sangin jong athengjoi, khoijule khoiphang sanga jong lhumjo ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukalvalin nasohhi nagihsalin; chule hicheho chintupna-a chun kipaman lentah aumin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama suhkhel ho kihetkhen jouva koiham? Guhthima kasuh khella konin neisuthengin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nasohhi kihoitho sahna chonset ho-a konin jong neituh-in; hitiho chu kachunga vaihomsah hih-in; chutengle keima kalung thenga, chule keima suhkhelna lentah-a kona monabei kahiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />O Pakai, kahatnale eilhandampu, kakama thupot hole kalungthim sunga kagelhi, namitmun santhei doltah hihen.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nalungkham nile Pakaiyin nadonbut henlang; Jacob Pathen min chun nahongbit hen!
  </para>
  <para style="p">
    <verse number="2" style="v" />Munthenga konin nakithopi hinsolhen lang, Zion'a konin natha hatsahhen;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nathilpeh jouse hejing henlang, chule na govam thilto jong sanghen. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman nalungdei dungjuijin nape henlang, chule nathilgon jouse nabulhit peh hen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiho nami huhhingna-a chun kipah-uving ting, ka Pathen'u minin kaponlap hou tungdoh-uvinge! Nathum jouse Pakaiyin nasuh bulhitpeh hen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin athaonu ho ahuhdoh-e ti tun kahetai; akhut jetlam huhhingna thahat chun, avanthenga konchun hin ngaipeh inte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abangin sakol kangtalai ho, chule abangin sakol ho atahsanun; keihon vang Pakai ka Pathen'u min chu kageldoh jingjeng diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho suhnem ahiuvin alhuve, keihovang kithoudoh uving ting, lungtheng sela kadindiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai, huhhingin! keihon kakou tengule lengpan neihin ngaipeh-un.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, nahatna-a lengpa kipah intin, nahuhhing na-a ama iti akipa tadem!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin alung ngaichat napen, akama athumho chu na-it pehpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Nangin ama chu phatnale phattheina ho in navengbit in, sana thengtah lallukhuh alua nakhuh peh-e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman nahenga hinkho athumin, nangin tonsot hinkho saona jengjong napetan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nami huhhingna jana loupi chu anasata ngeijin, janale lalna chu achunga nangam tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu nangman tonsotna phattheina chungnung changdin ama nasemin; na-umpina chun kipana chungnung apen ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu lengpan Pakai atahsanin, chule chungnung pen hepina jeh-in ama chu kiling ponte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nakhutnin namelmate jouse holdoh intin, nahote chu nakhut jetnin holdoh inte.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nalunghan tengle amaho chu lhumsung meikong banga nasemding; Pakaiyin alunghana-a aval lhumuva, chule meichun ahalvam gamdiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho ga chu leija konin, chule achilhah-u chu leisetna mihem chate lah-a konin sumangin nate.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu amahon nangma douna-in thilse bol agouvin; amahon aboldoh joulou dingu thilphalou angaitouvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun nangin nathal changho akhaoto nasuhto-a amai dungu nadoitengle, nangin amaho nakinungle sah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai, nathahatna achun, nangma kichoisangin, chutia chu keihon nathahatna chu vahchoina la-a kasahdiu ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka Pathen, ka Pathen ibola neidalhah hitam? Ipidinga eipanpi dingle gimthoh-a kapena awchenga kona nahiti gamlat hitam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo ka Pathen, suntengle nangma kasamjin, ahinla neijah pehpoi; chule jankhon jong thiptih kanei jipoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla nangma atheng nahin, Israelte pachatna-a chengjinga chu nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kapu kapa teovin nangma natahsan uvin, amahon natahsanun, chule nangin amaho nahuhdohjin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho nangma henga ataovun, nahuhdohji-e; amahon nangma natahsan jeh-uchun, akisudong jipouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla keima lungtol bep kahin, mihem kahipoi; chule mihemte i-sah loule mite nahsahlou kahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Eimu chanin nahsahlouvin einuisatnun; amuh aholpumun, alu athingun, aseijiuvin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman eihuhdoh-inte tin Pakai chu atahsanin; Achunga akipa amujeh-in aman ama huhdoh tahen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla nangma naobu sunga kona einaloi doh-a chu nahin, kanu anga kaumlaija neina kinepsahsa ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima naobu-a kona nachunga eina sekhumu ahin, kanu oisunga kona ka Pathen nahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keija konin gamlahih-in, ajehchu lungkhamna anaije; ajehchu eipanpi ding khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bongchal tamtah-in eiumkimvelun; Bashan bongchal hattahhon eiumkimvel sohtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keipi bahkai hangtah kitum bangin, akam eikat hom khumun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima twibangin eikisunglhan, kagu kachang jouse akikhensoh in; kalunghi khoilu bangin kagilpi sunga ajollha tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kathahat nahi leibel chipsa bangin agolhatan; chule kalei jong kadanga abehchah in, nangin thina leivuija neipuilut tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu uicha hon eiumkimvelun; khangilou mipi kikhom hon eium naijun, kakhutle kakenghohi asunun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kagujouse kasimtheijin, amahon eiveovin eigaldot uve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaho kavon jouse akihomun, chule kaponsil changding jong vang akisan taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Pakai nangma keija konin umgamla hih-in, vo kathahatna, eipanpi dingin kinon.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahinna hi chemjam'a konin huhdoh-in, kahinkho manlutah hi uicha thanei na-a konin huhdoh-in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keipi bahkai kamsunga konin neihuh doh-in, ajehchu sakol kinei kiho-a konin jong neina ngaipeh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kasopite henga namin phongleng ting; mipi kikhomho lah-a nangma kavahchoi ding nahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakai ginga nanghon ama vahchoijun, Jacob sonho jousen ama choi-anun, Israel sonho jousen ama chu gingun.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu aman bolgenthei thohho chu nahsahmole hotnin abol gentheipon, ama-a konin jong amai aselpoi; ahinla ahenga athumteng angaipehjie.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mipi kikhomho tamtah lah-a kapachatna chu nanga hintin, ama gingte angsunga kakitepna ho lhutninge.
  </para>
  <para style="p">
    <verse number="26" style="v" />Minunnem hon neovintin, lunglhaijunte; ama holho chun Pakai chu vahchoi unte; nalungthim chu tonsotna hingding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Leiset kolkimvelin Pakai ageldoh-a Pakai henga kilediu; chule chitin namtin jousen ama ahou dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu lenggam chu Pakaiya ahin; chule ama namtin lah-a vaihompa ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Leichunga khangtouho jousen neovintin chule ama ahoudiu; leivuija kileding jouse a-anga kuncheh ding; koimachan ama hinna akihuhjou louding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chilhah khatnin ama jenintin, hichu Pakai henga khangkhatna kisimding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amaho hunguva, ahung pengding miho henga hiche athilbol aumchan chonphatna hi aphondoh dingu ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu kelngoi chinna eichingpa ahin, keima lhasamponge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman hamhing lah-a eikolsah jin, twi damdidei pang dunga eipuilei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman kalhagao akiledohsah jin; amin jallin chonphatna lampiho-a eipuilei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Henge, keiman thina phaicham lim jotjongleng, thilse gingtaponge; ajehchu nangman nei umpin, namol lhon le natenggolin eilhamonjin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman kamelmate angsunga dokhang neigon peh-in; kalu thao nanun, kakhon alonglet tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thonlou hella phatnale hepina-in kahinkho lhungkeija eijuiding; chule atonsotna keima Pakai in'a kachenjing ding ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vannoi leisetle asunga cheng jouse, aboncha Pakaiya ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu aman twipiho chunga atundoh-a, twisohho chunga aphudet ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai lhanga kaldinga koi hija, amunthenga gading dinga koiham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Khut thengle lungtheng neija, ahinna pannabei dinga pedohlou, jouva kihahsel louhel mi chu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman Pakaiya kona vangbohna le, ahuhhingpa Pathen'a kona chonphatna amuding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Jacob hichehi ama holtele namai holte khanggui chu ahi. Selah
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo kotpi ho, nanghon nalu-u domsangun, chule tonsot kotpi nangho kikhang sangun, chutile loupina leng chu hunglut ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche loupina leng chu koiham? Pakai thahat tah le thaneitah, gal hattah Pakai chu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo kotpiho, nanghon nalu-u domsangun, chule tonsot kotpi nangho kikhang sangun, chutile loupina leng chu hunglut ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche loupina leng chu koiham? Janel Pakai, ama loupina leng ahi. Selah
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, na-anga, kalhagao kadom sange.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo ka Pathen, nangma katahsane, nei jachatsah danlang, kamelmate neijosah hihhelin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Henge, nangma ngahjinga um chanchu jumso hih-in, ajeh beija suhkhelna neiho vangchu jachatsah-in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Pakai, nalampi ho neimusah-in, na lamlhahho neihilin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nathutah-a neipuijin lang, neihilin, eihuh hinga Pathen nahi jeh-in nilhumkeijin nangma kangeh-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Pakai, masang laija anaumjingsa nahi jeh-in, nahepi khotonale nangailut lungsetna chu geldoh in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kakhang donlai chonset hole suhkhelnaho geldoh hih-in, Vo Pakai naphatna jehle nahepina dungjuijin neigeldoh in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Apha le akitah chu Pakai ahin; hijeh-a chu aman michonse te chu alampi ahilding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman milungnengho thutan na-a kaihoi jintin, milungneng chu alampi ahilding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Athulhunale athu hettohsahna tuhdet ho dingin, Pakai lamlhah jouse chu hepinale thutah ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />O Pakai, namin jal-in kakhan setna nasatah hi ngaidamin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai ginga mi chu koiham? Aman akilhending lampi chu aman ahilding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinkho-a nomtah-a chenga, achilhah ten leiset alodiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai thuguh chu ama gingho-a uma ahin, akitepna chu amaho amusah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman kakengteni lenna kona asutlhah ding jeh-in, kamitnin Pakai lamjeng akat jingin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaheng lama hung kiheijinlang kachunga khotona neineijin, ajehchu lung thomhaole thohgima um kahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kalunga lungkhamna ho anasa behsehtai; O kahesohna ho-a konin neipuidoh tan.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahesoh nale kathoh nat nahi hin venlang, chule kachonsetna jouse neingaidamin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kamelma tehi ngaito temin, ajehchu tamtah ahiuvin, nasatah in eihouvun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahinna hongbit ninlang, neihuhdoh tan, nangma-a katahsan kangapjeh-in, neijachat sah hih-in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangma ngah-a kahijeh-in, lungthen le dihcham kimna chun eivengtup hen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vo Pathen, alungkhamnao jouse-a konin Israel hi lhatdoh tan.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lungdet tah-a kachon jeh-in, Vo Pakai kathu tanin, katahsan jong Pakaiya kangaijin, hijeh-a chu keima kalhuh louding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Pakai, neikhol chilin lang neiphochenin, kalunggel leh kalungsung patepmin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nangailut lungsetna kamasanga aumin, chule nathutah-a kachonlen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moh mimaimaitoh katoukhom ngaipon, miphalhem ho henga jong lut hihhel inge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thilse bolho kikhopna chu kahot ahin, michonse tojong toukhom ponge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kakhut teni hi nolna beijin sopming ting, hitichun o Pakai, namaicham kimvela vahlenge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thangvahna awgina kaphondoh theina dingin, nathilbol kidang jouse hil lenge.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai, naumna in leh loupitah nachenna mun chu kangailun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kalhagao hi michonseho, ahiloule kahinkhohi thisanso ho toh umkhomsah hih-in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Akhut houva chonphat louna aumin, akhut jetlam uva nehguh adimsetnin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla keima vang lungdih tah-in vahleng ting, neilhatdoh inlang, neihin hepitan.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kakenghi muncham tah-a adingin, kikhopnaho-a Pakai choi-an inge.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu kameivah le eihuh hingpa ahin; koi kagin dingham? Pakai chu kahinkho-a kathahatna ahin; Koi kakichat dingham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Mikhangse, kamelmahole kagalte jengin jong, kasa hi nehgop dinga kachunga ahungchuh tengule akipalun alhuji taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Janel hon keima dounan gebuh songjong leu, kalung kicha pontin; eidoudin gal hungkon jongle hichea jongchu tahsan um kahiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman Pakai henga kadeichat thilkhat thuming ting; hichu kaholjing ding, chutileh Pakai insunga kahinkho lhungkeija kachen theija, Pakai melhoina kavetjing ding, chule a-houin sunga thu kakhol jingthei ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu kalungkham tengle apon insunga eiselintin, ahoubuh munthip sunga aman eisela, asongpi chunga eitousah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tunvang kakimvela kamelmate chungvuma kaluhi dopsanga umding ahitan; hijeh-a chu ahoubuh-a kipa ganlhaina ho kapeh-a, la kasah ding, henge, Pakai vahchoi La tumgingto tho-a kasah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai, ka aw gina kasap tengle neingaipeh-in, kachungah hepina neijinlang, neidonbut in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kamai holun nati laichun kalungin nahenga, Pakai namai holinge kanatin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keija konin namai selgamla hih-in, lunghanin nasoh hi notdoh hih-in, nangma eipanpi nahin, vo eihuh hinga Pathen, neidalhah danlang, neipaidoh hih-in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kanule kapan eidalhah tengle Pakaiyin eikipomding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai, nalampi neihilin, chule kamelmaho jeh-in lamjolsela neipuijin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kamelmate deilamin neipedoh loujenin; ajehchu keima dounan, nunset thujeng aseijun, chule hettohsah lhemho asohdoh tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing gama chu Pakai phatna muding tahsanlou anahileng vang alhasama kahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai chu ngahjingin, hangtah in umin, chutile nalungthim ahatsah ding ahi; Pakai chu ngahjingin, kati ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai le kasongpi, nahenga hungtaovinge, keima neithipsan le, kotong sung kijotlut ho tobang kahiding ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nahenga kaka-a, namun theng lam nga-a kakhut kahindop teng, kathumna aw neingaipeh-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Migiloule khanset bolho chutoh neikaimangtha hih-in, amahon aheng akom henga chamna thu aseijiuvin, ahinla alunguva thilphalou aumjinge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Athilbollu dungjuile athil gilou bollu dungjuijin pen, akhutnuva atoh bangun lethuh inlang, aset mannu musah-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon Pakai natohle akhutna athilbol angaisahlou jeh un, aman amaho sumang intin, semphakit ponte.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kathumna eingaipeh jeh-in Pakai chu vahchoijin umhen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai chu kathahatle kalumdal ahin; kalungin ama atahsanin, chule panpin kaumme; hijeh chun kalung akipah lheh-in, chule ama chu lan vahchoi tange.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai chu athahatnao ahin, ama chu athaonu dinga huhhingna thahat ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Namite huhhingin lang chule nagoulote phatthei boh-in; amaho chu vah inlang chule tonsotna din domsang tan.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoina peovin, vo, van mite Athahat aloupina chu vahchoijun, Pakai chu loupina leh thahatna peovin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiya amin loupina chu peuvin; athen hoina-in Pakai chu houvun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai aw chu twiho chunga aumin; Pathen loupinachu ahung kitumjah-in; Pakai chu twiho chunga chun aumin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai aw chu thaneitah ahin; Pakai awchu lal loupina-a dimset ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai aw chun Cedar thingho amanthah sah-in; henge, Pakaiyin Lebanon'a Cedar ho asumang gamtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman amaho bongnou bangin akichopsah-in; Lebanon le Sirion chu sakol kinei nou abahsah-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai aw chun meika al-lenglung aphelkhen-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai aw chun gamthip gam ahotlingjin, Pakai chun Kadesh ahotlingtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai aw chun sajuhpi bongnou asosahjin, gammangho jong achaisah in, a-houin sunga umho jousen aloupina aseijuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai chu twisohho chunga chun atouvin; henge, Pakai chu tonsot lengdin atouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakaiyin amite henga thaneina pentin, Pakaiyin amite chu chamna-a phatthei abohding ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai nangin neidopsanga, kachunga kamelmate nakipasah loujeh-in, keiman nangma choi-an inge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Pakai ka Pathen, nahenga kataovin, nangin neidamsah tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pakai, nangin kahinna lhankhuh-a konin napuitouvin, kokhuh-a kakumsuh lounadin, nangin neihinghoi tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo nangho amithengte, Pakaiya tumgingto thon vahchoi La saovin lang, athenna hetdohnadin ama thangvahna peovin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu alunghana chu chom chakhat bou ahin, alungsetna-a chun hinna aume; kana hi jankhatbou ahin, jingkah teng kipana ahunghiji tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule kaphatthei laijin, itih hijongle kiling ponge, kanatin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai, nei khohsahna jal-in, kamolsang nadindet sah-in, namai nanaselin, kana lungkhame.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai nangma kanasamin, chule Pakai henga kana thumin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kokhuh-a kakumlhah tengle, kathisan nahi ipi phatchomna umding ham? Leivuijin navahchoija nakitahna aphondoh ding ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Pakai ngaijin lang, kachunga hepina neijin, Pakai nangma eipanpia chu hin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangin kalung hemna lamnan naheidoh-in, kakhaodip pon nahohlhan, kipanan kong neigahpeh tan,
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaloupina beikahsea nangma vahchoi La tanglouva kasah ding, kathip louding ahi. O Pakai, ka Pathen, keiman atonsot atonsotnin nangma vahchoi jinge.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, nanga katahsan kangamin, imatih-in nei jachatsah hih-in, na chonphatna-a chun neihuh doh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahenglama nana hin sungin, gangtah-in neihuh doh-in, keidinga songpi dettahle eihuhhing dinga hoidohna in hunghin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nangma kasongpile kakulpi nahin, hijeh chun naminjalin neikaijinlang neilamkai jin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Guhthima lenthang eikampeh uva konin neiloidoh-in, ajehchu nangma kahatna nahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nakhutna kalhagao kapei; Vo Pakai Pathen dihtah nangin neilhatdoh tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mohseh thil ngaisahho chu kahon; Pakai vang chu katahsane.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nahepina-a kipah-ing ting thanominge, ajehchu nangin kalung hesohna neigelpeh in, kahinna hi vangsetna-a aume ti nahei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule eidouho khutna neikha khumpon, kakenghohi mun lentah-a nakoije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pakai, lungkhama kaum jeh-in neihepin, kamit hi lunggim na-in akhamtan, ahi, kahinna leh katumpi jong ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu hinkhohi lunggim na-in kamangin, kakum hohi khoisatna-in kamange; Kakhangitlou jallin katha abeijin, kaguho alhong lhatai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kamelmate lah, adeh deh-in kaheng kakomho lah-a i-sah louvin kaumin, chule kamel hetho din kichat kaumin; Eimuho chun eijamsan taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mithi bangin suhmilin kaumin, belkehsato kabangtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu mitam tah-in eihehsetna kanajan; Kakimvelah kichatna aumtai; keima douna-a akihoukhom laijun, kahinkho lah nadin doha abolui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla vo Pakai nangma kanatahsane, nangma ka Pathen nahi, kanatin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaphat ho nakhutna um ahin, kamelmatele eibolgiloute khutna konin neihuh doh-in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nasoh chunga namai hinvahsah-in, nahepina jal-in neihuhhing in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma kakou jeh-in, vo Pakai neijachat sah hih-in, migilouho jachatsah-in lang, thikholkhul sunga thipbeh-in umuhen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jouseinale midih ho chunga, musitnale hoithona thu tamtah seina kam chu paomon umhen.
  </para>
  <para style="p">
    <verse number="19" style="v" />O, naphatna, nangma gingte dinga nakhol khom, mihem chate masanga nanga atahsan ngamho dinga nanabol chu iti letna hitam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangin amaho chu mihoitho ho-a konin naumna munthipma naselding; nangin kinelkalna-a konin pon-in sunga koithipbeh in nate.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakai chu nunnom hen, ajehchu akhotona kidangtah chun khopi dettah sunga eimusahtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu namitmu-a konin paidoh-in kaumtai, kana tiloijin; hijengjongle lungset kangehna aw-a nangma kakou chun neina ngaipehtan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vo nangho amithengte jousen, Pakai chu ngailuvin, ajehchu tahsan umho chu Pakaiyin avetupmin, chule hoitho bol hochu lhingkeijin alethuhjin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hangtah-in umun, chutile nangho Pakaiya kinem jouse chu aman nalungu ahatsah ding ahi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Koihile asuhkhelna kingaidama, achonset kikhukhuma chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin achonset asimlou, chule alhagaova themona umlou mi chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thipbeh a kauma, nilhumkeija kasunga ka-ao na lammin kaguho manlou asohgam tai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sunle jannin nakhut gih-in eidelphan, kati lhop jong nipi laija gamgo asohjitai. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Nahenga kachonsetna kahetsah in, kakhan gitlouna kaselpoi. Pakai hengah suhkhelna phongtange katin, nangin kachonset khan gitlouna chu neingaidam tai. Selah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu, Pathen ngaisah jouse chu mutheija na-umpet hin nahenga taovuhen, tahbeh-in twilentah soh hon ahengu ahinnai louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangma ka kiselna mun nahin, lungkham na-a kona neiventup ding; huhdohna la ho-a nei-um kimvel ding ahi. Selah
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman nangma kahilchah ding chule nachena ding kahilding; keiman kamitna nangma kapuile ding nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hetna neilou, kamdal le thihkola kituhtangji sakol ahiloule sangan toh banghih-un, achuti loule naheng hinnai junte.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migilou din lung gentheina adimin, ahinla Pakai tahsan vang chu hepina-in aumkimvelin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangho michonpha ho, Pakaiya kipah unlang thanomun, milungtheng nangho jouse kipah-in ao-vun.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo nangho michonpha ho Pakaiyah kipah jingun, ajehchu milungtheng dinga pachat lasah hi lomtah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Selangdah in Pakai chu vahchoijun, manchah tumging khao somnei toh thon vahchoi La saovin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama vahchoina lathah khat saovinlang, aw thongin themtah-in tumging uvin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai thu chu adih-in, athilbol jouse chu dihtah-a kibol ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman chonphatna-a thutanlhah angailun; leiset hi Pakai phatna adimin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai thua vanhohi kisema ahin, chule amaho janelpihi akamsoh ahua kon ngen ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman twipia twiho chu lomkhat bangin akoikhomin, twi thuhtah chu khol khomna in'a akholkhome.
  </para>
  <para style="p">
    <verse number="8" style="v" />Leiset pumpin Pakai chu gingu hen, vannoi'a cheng jouse Pakai janan dimuhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu aman thu aseile akibol jengin, aman thu apehle aumden jenge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakaiyin Pathen hephalouho thuhil chu imahilou asosah in, mipi ho thilngaito chu phatchomna bei ahisah-e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai thumop chu tonsotnin ading jingin, alungngaito chu akhang akhanga ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen chu Pakaiya neija nam mite, chule ama agoulo dinga kilhen mihochu anun nom ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai chun van'a konin ahinven mihem chate jouse chu amui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman aumna mun'a konin leisetna chengho jouse chu ahinven ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman alungthim melputna akibahsah-in, athilbolhou jouseu agelpeh-e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mipi janelin ahuhhing thei leng aumpoi, mihat tah jong ahatjeh-a kihuhdoh aumpoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sakolhi hoidohna dingin pannabei ahin; athahatna jeh-a jong koima ahuhdoh louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Veovin, Pakai mit chu ama gingte chunga, chule ahepina-a kinemho chunga aumjingin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Thina-a kona ahinnao huhdoh dingle, kellhah teng ahinna diu akoipeh-e.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ihin naohin Pakai chu angah-in; ama eipanpiule ilumdalu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu ama mintheng itahsan jeh uva, ama-a ilungu kipahding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vo Pakai nanga kakinepnao dungjuijin hepina kachung uvah umhen.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Phat jousen Pakai chu vahchoi jingting: Ama vahchoina chu kakam toh kichat louding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahinna hi Pakaiya kisong ding, mi kineosah ho chun ajah uva kipahdiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />O, Pakai chu neichoi-atpiu vinlang, amin choi-an khom uhite.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai chu kaholin aman eingaipeh-in, kakichatna jouse-a konin eihuhdoh tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon ama lam aveovin ahile avah uvin; chule amaijuva jachatna-a aumpoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche migenthei hin akouteng, Pakaiyin angaipeh-in, alungdonna jouse-a konin ahuhhingtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama gingho chu Pakai vantil'in aumkim velin, chule amaho ahuhdoh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai phatje chu patepmun lang veuvin, ama tahsan michu anunnom ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />O mitheng teho Pakai chu gingun, ajehchu ama gingtedin lhahsamna himhim aumpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keipi bahkai donglaiho jong alhasamin, agilkel jiuve; ahin Pakai holte vang chu thilpha himhim lhasamloudiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hunguvin, chateho, kathu ngaijuvin; keiman Pakai ginje hiluvinge.
  </para>
  <para style="p">
    <verse number="12" style="v" />Phatna amutheina dinga nikho tamtah ngailu-a, hinkho ngailu-a michu koiham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Thilse-a konin nalei, chule lheplhah thusei na-a konin namuh tuhtangin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ase dalhanlang apha bolin, chamna holinlang hichu nungdelin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai mit chu michonpha ho chunga achun, ataonao ngainan ana asunge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai maichun thilse bolho dounale, leisetna kona amaho kigeldohna suhtanga aum nadin angat jinge.
  </para>
  <para style="p">
    <verse number="17" style="v" />Michonpha ho taona Pakaiyin ajahpeh in, ahesohna jouseuva konin ahuhdoh ji-e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lungthim kisihte henga Pakai anaijin, lhagaova kisihho chu ahuhhingin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Michonpha thohgimna atamin, ahinla Pakaiyin chucheho jouse-a konchun ahuhdohji.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman aguho jouse aching phan, khatcha jong abongpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thilphalouvin migilou athading; chule midih hotbola chu mangthah heldiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakaiyin asohte lhagao chu lhatdoh intin, ama tahsan ho chu mangthah loudiu ahi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, kakidoupi ho chu neiseitohpeh-in, eikisatpiho chu kisatpin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lumdal leh pho paninlang, ikithopidin dingin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tengcha jong satdoh inlang eidouva eisugentheiho lampi khah in, kalhagao jah-a, nahuhhingpa kahi tin seijin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kahinna suhmang dinga holho chu kisuh dongsah inlang jachat sah-in, suhset eigoho chu sunohphah inlang kinungle sah-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho hui nung masanga changsi bahsah-in, chule Pakai vantil nungdel sah-in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Alampiu thimhen lang nal hen, chule Pakai vantil'in amaho bolgimhen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu amahon ajeh beijin keidingin alen'u kotong sunga aselun, ajehbeija hichu hinna lahna dinga alaiju ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kigingman louvin manthah na achunga lhunghen lang, alenthang sela chun amatah ohhen, chuche manthah na-a chun lhalut hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutile kahinna Pakaiya kipah intin, ami huhhing na-a thanominte.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama dinga hatbeh sehpa-a kona migenthei pa huhdoh-a; henge, achomgam dingpa-a kona migenthei milhasam huhdohpa, Pakai nang tobang koi umem? tia kagu kachang houvin asei dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hettohsah lhemho akipat doh-un, kahet phahlouhel thil ho-a mo eichan uve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kahinna suhmang nadin apha khelin ase kipamandin eisan sah uve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keimavang amaho anat tenguleh kaponsil khaodip pon ahijin, an ngolin kahinna kasunemin, kataona ka angsung ngeija ahung kilahjin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kagol ham ahiloule sopi ham bangin kanaboljin, mi anu puldouho bangin kakhai khulele jin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla kahesoh tengle akipah-un akikhom jiuvin, ahin panna beijin eidou dingin akikhomun hichu kenla kahepon, tang louvin eisam seuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Golvahna-a phatlhem tothon, ahao eigel khumun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai itihchan navet thim ding ham? Kangailut tah kahinkhohi asumang ding keipi bahkaihoa konin huhdoh-in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mipi kikhopna munna chun nangma thangvahna peng kating; mi tamtah lah-a nangma vahchoi jinge.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kamelmate chu adihlou lamin kachunga kipa daohen, ajehbeija eihotbol teho chu amitnun kihou daohen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu amahon chamna thu him him aseipouvin; ahinla amahon gamsunga lungmonga um mongho dounan doha lungthim agongun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Henge, keima dounan amaho hatah-in akam kaovin, chule amahon aha, aha, kamitnun kamutaove, atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vo Pakai hichehi nangin namutan, thipbeh in umhih-in, vo Pakai keija konin gamla hih-in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka Pakai leh ka Pathen, kathu tan dingin nang le nang hung kitildoh-in lang, hung thoudoh-in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vo Pakai ka Pathen, chonphatna dungjuijin kathu tanin lang, amaho kachunga kipah hih uhen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Alunguvin amahon, kate! eiho ichandiu ahi tidaohen, eihon ama ival lhumtaove tidaohen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kakisuhkhah na-a kipahho chu jahchale lungdongin umkhom sah inlang, keima douna-a kiloupisah ho chu jachatnale jalounan kivonuhen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka chonphatna natoh-a lunglhaiho chu, kipahle thanomin ao-vin la saohen: asoh phattheina chunga kipahji Pakai chu, loupitah-in umhen tin seijom jing taohen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutile kaleijin chonphatna nilhumkeijin seitante.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migilou suhkhelna chungchanga kalungsunga kathusei; amitmua Pathen ginna himhim aumpoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu akhan gitlouna kidah umtah chu akimudoh kahsen, ama mitmun amale ama akiseiphajin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akama thusoh ho chu khangitlouna leh lheplhahna ngen ahin; chihnale thilpha bolding chu adalhatan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman jalkhun chunga thilse agongtoh-in, lampi phalou laitah a akitungin, thilse ahopon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pakai, na mihepina chu van ho-a aumin, chule nakitahna chun meilom lah aphan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nachon phatna chu molsang lenho abangin, nathutan lhahho chu athuhlheh-e, vo Pakai, nangman mihem le gamsa navengbit nin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai nangailut nahi itilutna hitam, hijeh-a chu mihem chaten na lhavingho limnoi atahsanu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na insung aninlhin jehchun amaho lunglhai lheh-untin, nalunglhaina vachadung twi chu amaho nadonsah ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu hinna twinah nanga aumin; navah-a chu khovah kamudiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma heho henga nangailutna chu umsah jinginlang, chule milung thengho henga chonphatna chu umsah-in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi kiletsah kengin ei chotkhahda henlang, migilou khutnin einodoh dahen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khukoma engse bolho alhulhop mun, lelhah ahiuvin, kithoujou tapouvinte.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thilse bolho jeh-in lungkham hih-in, khangitlouna bolho chunga jong thangset bolhih-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu amaho hampa banga kivatlhu loidiu ahin, hamhing banga goploi diu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai tahsanin lang, thilpha bolin, chutile nangma gamsunga nachen ding, chule tahbeh-a suhlung lhaija naum ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiya jong kipah thanomin, aman nalung ngaichat jouse napeh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nalampi Pakai henga pedoh jengin; ama jong tahsanin chutile aman nabolpeh nante.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutile aman nachon phatna chu vah bangin vahdoh sah intin, chule nathem chana chu sunlai bang ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiya cholngan, chule amachu lungneng tah-in ngah-in mi alamlhahna jouse-a akhantou jehle, thil gilou hinpodoh pa jeh-in lungkham hih in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lunghan na-a konin tanginlang, chule lungsatna chu dalhan; ase bolna ding poupouvah kisugim hih-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu thilse bolte chu kipaidoh hel ding ahiuvin; hinla Pakai ngah jingte vang chun leiset chung alodiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu chomkhat joule migilou umtalou ding, henge, lungthim themtah-in aum namun chu vele chun, ana umta ponte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla milung nengin vang leiset chung aloding, chule amaho chamna lhingset chunga kipah ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Migilouvin midih dounan thil agongjin, chule achungah aha agoiji.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakaiyin ama anuisat ding ahi; ajehchu aman anikho hunglhung ding chu amun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Migilouvin chemjam asatdoh-in, vaichale lhasam suhlhahna dingle thudih-a houlimho tha nadin athalpiu ajekonin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Achemjamu amahotah lungchanga lutnintin, athalpihou kihebohpeh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi chonphan lhomcha aneichu migilouho haona tamtah sangin aphajoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu migilou banjang kihebohpeh ding; midihtah ho vang Pakaiyin ageldoh jingding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Midih nikhoho chu Pakaiyin ahen, agoulo ding chu tonsotna ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho phat phatloulai jongle jahcha loudiu; Kel lhahlai jongle ninglhing diu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla migilou vang chu mangthah ding chule Pakai melmaho chu kelngoinou thao tahho bangdiu; amaho meikhu lah-a manghel diu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Migilouvin batnin alan, asakitjipoi, michonphan vang hepina amusah-in, ahomji-e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu ama phattheiboh changhon leiset chung louvintin; chule ama gaosap changte chu suhmanga umdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mipha kalsonnaho chu Pakai thusah ahin; alampia chun ama akipah lhehjin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama lhutajongle kilehlhapai louhel ding ahi; ajehchu Pakaiyin akhutnin atuhjinge.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khangdong kanahin, tunvang katehtai: ahivangin michonpha akinungsun kamukhapon, achilhahte khutdo-a apanlam kamukhapoi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama a-itih-a hepina dimle hongphalji ahin, achilhahte phatthei achangun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Setna dalhanlang chule thilpha bolin, a-imatih channin cheng jingtan.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu Pakaiyin thutandih angailun amithengte adalha jipoi, amaho tonsotna dinga kikheh ahiuve. Ahinla migilou chilhahte vang kisumang ding ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Michonpha hon gamsung louvintin, asunga tonsotna chengdio ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Michonpha ho kamsungin chihna thu aseijin, chule aleijin thutanlhah thu aseijin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A Pathen dan chu alungsunga aumin, akalsona channa alhonal khapoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Migilouvin michonpha avelhijin, chule thadin aholjin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pakaiyin amachu akhutna dalhapontin, athu kitanteng themosah ponte.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pakai chu ngah-in lang, alampi chu juijin, chutile gamsung lodinga nachoisang ding ahi: migilouho akisuhmang teng, hichu namu ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Migilou chu thanei tah-a, bong thinghing bahjamkai banga aum kamui.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahinla ama akitol mangtai, veuvin, aumtapoi; henge, kahol holin, ahinla akimujou tapoi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Michamkim chu melchih inlang, milungdih chu ven, ajehchu chuche mipa kichaina chu chamna ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahinla suhkhelna neiho chu thakhatna kisumang diu, mikhang gilou kichaina chu, suhmanga umding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahivangin michonpha huhhingna chu Pakaiya ahin; lungkham laija atha hatnao ama ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Pakaiyin amaho apanpi-a ahuhhing ding, aman khangitlouho-a kona ahuhdoh-a, chule ama atahsan jeh uva, amaho ahuhdoh ding ahi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai nalunghanna-a neiphoh hih-in; nalungsat natah-a jong neisehgim hih-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu nathal changho kasungah alutnin, chule nakhutnin eimeh nasabehseh jengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nalunghanna jeh-in katichung-ah damna himhim aumtapoi, kachonsetna jeh-in jong kaguho-a choldona himhim aumtapoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu kakhan gitlounahon eichuptan; poh gihsatah khat bangin keidin agihsa behseh taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kangolna jeh-in katina mahaho auijin amon lhasoh tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kalung akhamin, hatah-in kakunsuh in, nilhum keijin kalunghemin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu kakong dungho jouse adul soh gamin, chule kati chunga damna aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keima lhasamle akisugepma chu kahitan; Kalung montheilou jeh-a peng penga chu kahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai kangaichat jouse namasanga uma ahi, kakhoisat jong nanga kona kisellou ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kalung aphulin, katha abeitan; kamit vah jengjong, keija kon achemang tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Eingailuho leh kagolte katina-a kon ading gamlha taovin; ka-inkote jong gamlatah-a adingun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kahinkho suhmang dinga hol hon jong thang eikampeh uvin, chule kasetna ding hol hon jong lamvaina thujeng aseijun, nilhum keijin thilphalou jeng ageljiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin keimanla na-ngong bangin kajapon, akamka ngailou mipaomo kana bangtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiti chun kho jaloule, akama phona sohngailou bangin kana umin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu o Pakai, nangah kakinemin, o Pakai ka Pathen, nangin jan nate.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu keiman, nei ngaipeh-in, achuti loule kachunga kipah getnunte kati ahi, kakenga kalhonalteng keima dounan amaho kiloupisah getnunte.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu, kalung gentheinahi tanglouvin kamasanga aumin, chule alhu paiding kahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu kakhan gitlouna hi phonging ting, kachonsetna jeh-a kalung khamding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla kamelmate khu ahingtheijun, ahatnuvin, dihlou tah-a eihot bolte chu apunguve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thilse thilphato kilheh ho jong kakidoupi ahiuve; ajehchu keiman thildih chu kajuijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Vo Pakai, neidalha hih-in, vo Pathen, keija konin gamla hih-in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Eipanpi dingin hung kinon; Vo Pakai eihuh hingpa.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaleija kachonset lounadin kalampiho-a kihong phange, kati; migilouho kamasanga aumlaijun kakamhi kamdalin tuhchah inge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Apha-a konin jong thipbeh-in paolouvin kana umin; chule kalung gimna apong bepmin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kasunga kalungchang asadoh-in, lung kangaito laijin, meijin akongdohtan; chuin kaleija thu kaseijin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai, kanikhoho teptena le kaki chaina hedin neisemin, chutile itobanga thalhom kahi hetange.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vetan, kanikho hohi khutpeh chanbep bangin nasemin, chule kahinkhohi namasanga imacha hilou ahi; Tahbeh-in mitinhi aphat pettah laijong abona ahomkeo bou ahi. Selah
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahbeh-in mitinhi ahomkeova vahlea ahiuvin; tahbeh-in amaho ahomkeova lunglinglao ahiuve; aman haonaho ase khomin, chule kon ahin lokhom ding ahepon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Pakai tu-a hi ipi kanga em? Kakinepna nanga uma ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka suhkhelna jouse-a konin neihuh doh-in; mingol ho noisedin neisem hih-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangma bol anahijeh-in kana paomon, kakam kanakehpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Namivohna keija konin ladohtan, nakhut gua athipai ja kahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi akhangitlou jeh-a napho-a nasuhdih teng, ahoina chu nget banga nejoudin nasemji, tahbeh-in mitinhi pannabei ahi. Selah
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pakai, kataona ngaijin, chule kakounahi neijah peh-in; kamitlhi lonhi neithipsan hih-in, ajehchu keima kapu kapateu banga nangma toh kholjinle khopembou kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kachemanga, kaumtah lou ding masanga, katha akiledoh theinadin, O neikhongai tadin.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thohhat tah-in Pakai chu kangah-in; chule aman ana eisunpeh-in, kakouna ajatai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman kokhuh gimneitah-a konle bonlhoh lah-a konin jong eiloidoh-in, chule songpi chunga kakengin eidinsah-in, kachena dingho eisuhdet peh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman i-Pathen'u pachatna dingin jong lathah khat kakamsunga eikoipeh-in; mi tampin hichu amuva akichatdiu, chule Pakai chu atahsandiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihoitho hole joulama kiheite ngaisahlouva, Pakaiya atahsanna kisem mi chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pakai ka Pathen, thil kidang nanabol ho leh keiho lam nangaitona hohi atamlheh-in, hicheho chu nahenga kisimdoh joupontin; hicheho chu phondoh-a seiding tileng simjouhoi hilouding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ganlhaina leh thilpeh nangailu pon, kakolho neihonpeh tan; govam thilto leh chonset thilto jong nangailu poi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujouvin keiman ven kahunge kati; lekhajol bu-a chun kachung chang thu akisune,
  </para>
  <para style="p">
    <verse number="8" style="v" />vo ka Pathen, nalunglhaina bolding katha anomin; henge, nadan thu chu kalung sungah aume.
  </para>
  <para style="p">
    <verse number="9" style="v" />Houkhom na loupitah-a chun chonphatna thu kalhangsapmin; vetemin vo Pakai, kakamhi thip ponte ti nahei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nachon phatna kalungsunga kaselpon; nakitahnale nami huhhingna keiman kaphonglen; nalungset ngailutna le nathudihna chu mipi kikhom tamtah lah-a chun ka-im jipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai nami hepina lutah chu keija dingin it hih-in; nangailutna leh nathutah-in neivetup jingin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu simjoulou setna-in eiumkimvelin; kakhan gitlouna chun eituh-in, chutichun kadahdoh theitapoi; hicheho chu kalua sam jangho sangin atamjon, hijeh chun kalungthimin eilosam sahtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Pakai, lungset tah-in neihuhdoh in, vo Pakai, eipanpidin kikinno loijin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kahinna manthah sah ding go-a holho chu jahchale maimoh-in umhen, kasetna ding ngaitoho chu kinungno kitnu henlang jahchao hen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajachat manuva aha, aha, eitihou kipaman chu manthah na hihen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangma naholte jouse chu nanga kipah-uhen lang thanomuhen; nami huhhingna ngailuho chun tanglouvin Pakai chu choi-atnin umhen, tiuhen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla keivang vaichale lhasam kahi, ahinla Pakaiyin keimading agelnai, nangma eipanpile eihuhdoh-a nahin, vo ka Pathen, geisang loujenin.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migenthei khotopa chu anunnom ahi; Pakaiyin boina ato phatle ahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin ama chu ahonbitna ahinsah ding; chule leiset chunga phattheina chang ding; chule nangman ama chu melmate deilama napehdoh louding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lungkhamna jalkhun chunga chu Pakaiyin ama ahatsah ding; nangman ajalkhun chunga nasemthah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman Pakai neihepin, nei damsah-in, ajehchu nangma dounan kachonse tai kati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamelma ten keima eisamse jingun, itihle ama athin, amin amangdem? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule eivedinga ahung jongle, manlou thu jeng aseijin alungsunga khan gitlouna adimin, apotdohle teng aseithang sohjin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Eihotbol jouse chu keidounan akihou lhiuvin; keima dingin asecheh angaitouvin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nat phalou tah-in ama aphah ahitai, alupna-a kon thoudoh talou ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Henge, kagol ngaitah, katahsan pen, ka changlhah nepa tah-in jong kachunga akengto alamtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin vo Pakai, amaho kalethuh theina dingin neihepin lang neiphong dingin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kamelma ten eijolou jeh-un, nangma kachunga nalung lhaije ti hichea konhin kahei.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule keima vang, kadih chamkimna-a nangin neituh jingin, namai koh-a tonsotnadin neitousah tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai Israel Pathen chu tonsotna pat tonsot geijin nunnom jinghen, Amen chule Amen.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sitwi ngaija sakhichal haisama bangin, vo Pathen nangma ngaijin kahinna hi ahaisam-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahinna hi Pathen, Pathen hing ngaijin adangchah-e; itih tahle kahunga Pathen anga kakilah dingham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Kamitlhi hi sunle janna ka-an ahin; amahon kahengah tanglouvin na Pathen hoibaham? eitiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche thilhohi kageldoh tengle kahinna kasungah kabunglha ji-e; ajehchu mipi lah-a kachen, amahotoh kipana le vahchoina aw tothon Pathen in'a kacheuvin, nitheng nitna mihonpi chuto kahiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo kahinna, ipi dinga nangma kisonlha-a nahim? chule ipi dinga nangma lung olmoa nahin? Nangma Pathen'a kinemmin, ajeh chu amaiso-a kithopina jeh-a ama kavahchoi ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo ka Pathen, kasunga kahinna hi alengvaijin; hijeh chun Jordan gama kon, Harmon munsang ho-a kon, chuleh Mizar lhanga konin nangma geldoh inge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Natwi lon gin'a chun twithuh le twithuh akidongton, natwi kinong le husa gin chun eichuptan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijongle Pakaiyin alungset ngailutna chun sunle thu pentin, janle ala chun eiumpi ding, chule kahinna Pathen henga chu katao ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman Pathen kasongpi henga chu ibolla neisuhmil ham? kamelmate suhgentheina jeh-a ibola lunghemma vahlea kahim? katiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kagusunga chemjam um banghelin, kamelma ten i-sah louvin eibolun; niseh in kahenga na Pathen hoiba ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo kahinna, ibolla lengvaija nahim? Chule ipidinga kasunga lung olmoa nahim? Pathen'a kinemmin, ajehchu kamel eidamsahpa le ka Pathen, ama chu vahchoi nalaiding kahi.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen kathu neitan peh-inlang Pathen ngaisahlou nam mite chunga kathuhi neiseitoh peh-in, O milhem lhaho le midihlou ho-a konin neihuh doh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu nangma kathahatna Pathen nahin, ibolla neipaidoh hitam? Kamelmateho suhgentheina jeh-a, ibola lunghemma kavale dingham?
  </para>
  <para style="p">
    <verse number="3" style="v" />O navah le nathutah chu hinsol doh-in, hicheho chun eipuile henlang, chule hichun nalhang theng le na houbuh chu eilhut hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujou tengle Pathen maicham lamma kakipana chungnung Pathen henga chun chenge, henge, selangdah-in nangma vahchoi jinge, O Pathen, ka Pathen,
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo kahinna, ibolla lengvaija nahim? Chule ipidinga kasunga lung olmoa nahim? Pathen'a kinemmin, ajehchu kamel eidamsahpa le ka Pathen, ama chu vahchoi nalaiding kahi.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen kapu kapa teovin khangluilaija nanatoh nathilbol einahilu chu, kanakhang houvun kajauvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin nakhutna Pathen hephalouho chu nanano manga, chule kapu kapateu chu naphudetna, chuche gam miho chu iti nasuh gentheija, napaidoh jeng hitam.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu amahon achemjamuva gam chu alah uva alou ahipon, ahiloule aban thahatnuva kihuh hinga jong ahipouvin; hinla achunguva nakipa jeh-a nabanjet le namai vah-a konjoh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Pathen nangma kalengpa nahi, Jacob huhdohna dingin thu pe-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma jala kamelma teo kasot kundiu ahin; namin jala keiho douna-a kipatdoh ho chu kachotpha diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu kathalpi hi katahsan pon, ahilouleh kachemjamin jong eihuhdoh ponte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla kamelma teova konin nangin neihuhhing jouvin, chule eihot bolteu chu najumso jotan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nilhum keijin Pathen jenga kisongung kating, chule namin chu tonsotnin vahchoi uvinge. Selah
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla nangin neipaidoh-un, neijumso taovin; chule kagalsat mite toh nakondoh khom tapoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Melma-a konin nangin neikinung lesah-un, chule eihotbol teo chun amahodin thil akichomuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangin Pathen hephalouho lah-a neithe cheh-un, nehdinga kigong kelngoi bangin neipedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Namitehi imalouvin najohdoh-in, aman nu jong haonan nanei chom dehpoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangin kaheng kakomhou noise din neisemun, kakim vel uva miho musit le nuisat nin neiumsah taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangin Pathen hephalouho lah-a seichah dingle, miho lah-a lu thinkhum din neisem taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lunggimna tanglouvin kamasanga aumjingin, chule kamai jong jachatnan akhu tan ahin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu melmale phulapa i-sah louna le taitomna aw-so jeh chu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichengse chu kachunguva alhungin, ahinla nangma kasumilkha pouvin, chule nathu lhuna jong kapalkeh khapouvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kalungthimu akile hei pon, kakalseu jonghi nalampi-a konin apetmang khapoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin nangin dragonho mun'a neisuchip deh-un, thina le-lim chun neikhu uvin ahi
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka Pathen'u min chu kasuhmil uva, gamchom pathen henga kakhut kajahdoh uva ahile;
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen'in hiche chu aholdoh louding ham? ajehchu aman lungsung thuguhho chu ahen ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Henge, keiho nangma jeh-in nilhum keijin eikithat jingui, thadinga kigo kelngoi bangin eikisim taove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vo Pakai khangin, ibola imua nahim? kithouvin tonsotnadin neipaidoh loujenun.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ipijeh-a namai naselmanga, chule eikibol gimnaole eiki suhgenthei naohi nasuhmil hitam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu kahinnao hi leivui lah-a akunin, ka-oiju hi leisetna abehtan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Eipanpi diuvin kipatdoh-in, chule nahepina jal-in neilhat doh-un.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kalungthim sunghi thuphan akisun dimtan, lengpa chung changa thil kanabol chu kaseijin, kaleihi gotsa thusunpa lekhamol ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chate sangin nahoijon, lungsetnahi nakama akisunglutne; hijeh-a chu Pathen'in tonsotna phatthei naboh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo hat chungnung, nachemjam chu nataija kigah inlang, nalalna le ja naum na-a chun kivonin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule thutah le nunnem na chule chonphatna jal-in, nalalna-a chun khangtou tah-in touvin; chule nakhut jetnin thil gimneitahho nahilding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lengpa melmate lung sunga nathalmuh chu ahemin, hichea chun mite nanoija alhu jiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Pathen nalaltouna chu atonsot atonsotna ahin; nalenggam tenggol chu leng tenggol dihtah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman chonphatna nangailun, chule gitlouna nahot bolin; hijeh chun Pathen, na Pathen chun, nagol ho chung vuma kipana thao nanutan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Navonho jouse chu saiha-a kisa leng inpiho sunga konin myrrh le aloe chule cassia anam hiuheu vin hicheho chun nakipa sah-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lengho chanute chu numei ja-umtah ho lah-a aumun, najet lama lengnu chu Ophir sana-a kijemin adingin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo chanu, ngaiphan lang geltoh-in, chule nana sungin, namite le napa insung jong chu sumilin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutile lengpan nahoina nasatah chu adeichat ding ahi; ajehchu ama na Pakai pa ahin, chule nangman ama chu houvin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Tyre chanu chu thilpeh khat choija hungding, miho lah-a mihaoho jengin jong nalungsetna angeh diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lengpa chanu chu loupina adimin; aponsil chu sana-a kijempah ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanu chu lengpa henga pon kikhui pahsel kivona apuidiu; aloi anungjui nungah thengho chu nahenga ahinpuidiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kipahtahle thanom tah-in amaho hin kipuijintin, amaho leng inpi sunga lutdiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Leiset pumpi-a leng chapa-a nasem diuchu, napateu khela nachateo hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Akhang akhanga geldoh jing dingin namin seming ting, hijeh-a chu mihem ten atonsot, atonsotna navahchoi diu ahi.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen chu ikiselnao le itha hatnao ahin, lungkham pettah a eipanpiu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leiset hi kichon mang henlang, chule twikhanglen lailung-ah molsang hohi kipolut hen;
  </para>
  <para style="p">
    <verse number="3" style="v" />chu-a twiho chu ginglul lulin kinong henlang, chule molsangho kihotlingsoh jongle keiho kicha pouvinge. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Vadung khat aumin, chu-a luidungho chun Pathen khopi akipasah ding, Hatchung nungpen houbuh umna muntheng chu akipasah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alailunga chun Pathen aumin, ama longlou helding; jingpi tah-a Pathen'in akithopi ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen hephalouho alunghangun, lenggam ho akilongsoh-in; Aman a-aw aginsah le leiset ajunlha tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Janel ho Pakai chun eiumpiuvin, Jacob Pathen chu ikiselnao ahi. Selah
  </para>
  <para style="p">
    <verse number="8" style="v" />Leiset hi itobanga agohkeo asosah hitam, hungun lang Pakai thilbolhohi vetemun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman kolmong geija gal kisat asutangin, thalpi ahehbongin, tengcha asubongin, sakol kangtalai meijin ahalvamtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thipkhen chan umunlang Pathen kahi heuvin, Pathen helou namtin vaipi lah-a choi-at na kauma, leisetna choisanga kaum ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Janelho Pakai chun eiumpiuvin, Jacob Pathen chu ikiselnao ahi. Selah
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo nangho mipite jousen nakhut bengun, Pathen henga galjona aw thongin samun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu hat chungnung Pakai chu gimneitah ahin, leiset pumpi chunga leng loupitah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman mitin chu inoijuva asuh nemding, namtin chu ikengto noijuva akoiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman angailut Jacob loupina chu igoulo diuva alhending ahi. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen chu aw ging pumin, Pakai chu sumkon gin pumin akitol toutai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen vahchoi La tumgingto thon saovin, vahchoi La saovin ilengpao vahchoi La saovin, vahchoi La saovin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Pathen chu leiset pumpi leng ahin, hetnatoh thon tumgingin vahchoi La saovin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen chu namtin chunga aleng changin, Pathen chu alaltouna theng chunga atouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipi lah-a pipuho akikhom khomun, Abraham Pathen mite lah-a pipuho geijin akikhom khomun ahi. Ajehchu leisetna lumdal jouse Pathen'a ahin, ama chu nasatah-a choisanga uma ahi.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Alen na chu Pakai bou ahin, chule athenna molsang, i-Pathen'u khopi-a chu loupi tah-a vahchoi ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amun dinga hoitah, leiset pumpi kipana chu sahlam sanga Zion molsang, leng loupitah khopi chu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aleng inpiho sunga chun, Pathen chu kiselna-in akihei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu veuvin, lengho chu akikhomun achemang gamtaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon hichu amuvin, chutichun adatmouvin; amaho alung khamun ache mangloi taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuachun kichatle natna-in, numei anaoso natnin amat bangin amanchah taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman solama huijin, Tarshish kong inneiho chu nasumang gamtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keihon kanajah bangun, janelho Pakai khopi sung, Pathen khopi sunga chun kamu taovin; Pathen'in atonsotna dinga atundoh ding ahi. Selah
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pathen nahouin sung lailunga chun, nalungset ngailutna thu kana ngaitouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Pathen, namin dungjuija napachat na chu kolmong geija umding ahin, nakhut jetlam chu chonphatna-a dimset ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nathu tanlhah naho jal-in Zion lhang chu kipah henlang, Juda chanute chu thanomu hen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zion chu velkolun lang, akimvela kijotnun, chua insangho chu hilun.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahung umkitding khangho henga nahil theina diuvin, nanghon akulpiho chu melchih-un lang, aleng inpiho chu ngaito temun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu hiche Pathen hi tonsot atonsotna i-Pathen'u ahin; thi geija jong eipuihoi pau hiding ahi.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nanghon mipite jousen hichehi ngaijunlang, vannoi'a cheng nangho jousen nanau hin sungun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Misangle minem, ahaole avai, kigomin hichehi ngaijuvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kakamin chihna thu seijintin, chule kalung ngaito chu hetkhen themna thu hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thulem thuah kana sungin ting, kathugil sei chu selangdah-in hilchen inge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nikho phatlou lai, kakhotal ho-a khanset na-in eiumchah teng ibola kakichat ding ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Anei agouvu tahsan ho, chule ahaona houva kisongho chu;
  </para>
  <para style="p">
    <verse number="7" style="v" />koimachan iti nama jongle asopi alhat thei louheldiu, Pathen henga ama lhatdohna dingjong apehthei louheldiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />(Ajehchu alhagaovu lhatdohna ding chu manlutah ahin, hichu a-imatih chana dinga kikhah ahitai).
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama chu a-imatih chana hingjinga, chule thina jong atepkhah louding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu aman michingho jong athiu amun, hitobangma chun angola milungselho jong amangthah-in, anei agouho midangho adalhahpeh jiuve, ti amutan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A-in hou chu a-imatih chana umjing ding bangle achennao munho chu akhang houva umjing ding bangin, asunglamuva agelun, chule agamu chu amaho mincheh asah jiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeng jongle mihem hi jatah-in aumjing jipon, ama chu amangthah ji gamsa tobang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche alampiuhi angolnao ahin; hinla, asonhouvin amaho thusei chu aphochenun ahi. Selah
  </para>
  <para style="p">
    <verse number="14" style="v" />Kelngoi bangin lhankhuh-a alumin, thinan amaho chu avahding, chule jingkah lamle michondih hon achunguva vai ahomdiu; chule achen naova kona ahoinau chu lhankhuh-a mangthah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla Pathen'in kahinna hi lhankhuh thanei na-a kona alhatdoh ding ahi: ajehchu aman einasan ding ahi. Selah
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi khattou ahung haova, a-insung loupina chu ahungkhan cheh cheh tengle nangman kicha hih-in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu chu ama athi tengle imacha apohtheilou ding ahin, aloupina chun ajui louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Adamlaijin ahinna ho chu amale ama phatthei kiboh jongle, nangman nangmatah dinga thilpha nakibol tengle min navahchoi diu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama apateu chilhah ho henga chentin, a-itih-a khovah amulouding ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihem choi-at changa, ahia hetkhen themna neilou chu amangthahji gamsaho bangbep ahi.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hat chungnung Pakai Pathen chun thu aseitan, leiset hi niso-a pat nilhum geijin akouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zion'a konin Pathen hoi chamkimna chu avahdohtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />I Pathen'u chu hungintin thipbeh-in umponte; Amasanglam chu meijin halvam intin, chule akimvel chu huile go kitho hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman amite thu atan theina dinga, vanho chule leiset pumpihi chungsanga kona akoukhom ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ganlhaina-a keima toh kitepna nei kami thengte chu kahenga hinkhomin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule vanho hin achonphatna chu aphon doh ding ahi; ajehchu Pathen amatah chu thutan ahi. Selah
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo kamiteho ngaijun, keiman thu seijinge: vo Israel, chule nangma nahin hilchen inge, Keima Pathen, na Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kamasanga tanglouva umjing nagan lhainaho le nagovam thilpehho jeh-in nangma naphohsal ponge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na-in'a konin bongchal chule nahonga konin kelchal himhim ladoh ponge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu gamlah-a gamsa jouse chule lhangho jouse chunga gancha jouse keija ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Molsang ho-a chungleng vacha jouse kahesoh keijin, loulaija gamsaho jousehi keija ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kagil akela ahijongle nahenga seiponge; ajehchu vannoi leiset leh asunga thil um jouse keija ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bongchal ho sa kaneh-a ahiloule kelchaho thisan kadon ding ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathen hengah thangvahna peuvin, chungnung pen hengah nakitepnao lhutjouvin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule lungkham nile neikouvun, keiman huhdoh ingting chule nangin neichoi-at ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Pathen'in migilou hengah, kadan kisunho naphon doh-a ipi-a napan sah-a, ahiloule ija pang dinga kathulhun nakama nakoiding ham? ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kihilna nahotna kathuho nanung lama napaiji kamun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gucha namule ama chu najopmin, chule mijonghotoh chan nanei khomjin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nakam chu setna-a napedoh-in, nalei chu lhep lhahnan nasemtoh-e.
  </para>
  <para style="p">
    <verse number="20" style="v" />Natoumun in nasopi douna thu naseijin, nanu chapatah chu naseisejin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichehohi nabolin, keima kathipbeh-in, nangin nang tobangin neingaiton ahi. Ahinla keiman kaphosala hihochu namitmu tah-a katahlang ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun nangho Pathen sumiltehon, hichehi ngaito phaovin, achutiloule ahal halla kabotel uva, nahuhdoh diu umlou ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vahchoina thilto banga toh chanchun keima eichoi-at ahin; chule ahoulimna kisemtohpa henga chu Pathen mi huhhingna kavetsah ding ahi.
  </para>
  <chapter number="51" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai na ngailut phatna dungjuijin neihepin lang, nami hepi haotah dungjuijin kasuh khelnaho noimangin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kakhan gitlouna-a konin neisil ngim selinlang, kachonsetna-a konin neisuthengin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu kasuh khelnaho kakihet nin; chule kachonsetna chu kamasanga aumjingin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman thu naseiteng them nachan theina dingle, thu natan teng akichet theina dingin, nangmatah dounan kachonsen, hiche thilse hi namitmun kana boltan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vetan, gitlouna-a anakijila kahin, chule kanun chonset na-a einavop ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vetan, nangin asung gil lama thutah chu nangailun; chule lunggil lama chu nangin chihna thu neihetsah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hyssop'in neisuthengin chutile ngimtange; neisilin chutile buhbang sanga kaban joh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nasuh bohsa guho akipana diuvin, kipana le thanopna chu neijah sah-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kachonsetna ho-a konin namai selin, chule ka gitlouna jousehi noimangin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Pathen, keima-a lungtheng khumin lang, kasunghi lhagao dihtah-in semthah-in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naum na-a konin neipaidoh danlang, keija konin nalhagao theng ladoh hih-in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nami huhhingna kipana chu neipekit ninlang, chule nalhagao hongphal tah-a chun nei tuhdet jingin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutengle suhkhel neiho chu nalampi hil ingting, chule michonse hon alungu nangma heng lamma ahin aheidiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo Pathen, nang eihuh hingpa Pathen, thisanso mona-a konin neihuh doh-in chutile kalei hin nachon phatna aw thongin lan sante.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vo Pakai nangin kakamhi kat sah in, chutile kakamin navahchoina aphonjal ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu nangin ganlhaina nangaichapoi; chutilou hile kapeh ding nahin, nangma govam thilpeh-a jong nalunglhai pon ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen'in adei ganlhaina chu lhagaova kisuhchip hi ahin; Vo Pathen, lungsung pohkeh le kisih ho chu nangin nahsah louva nakoi louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zion dinga apha nadeilamtah chu bolin, Jerusalem kulbang chu saphan.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle chonphatna ganlhaina, govam thilpeh chule govam thilto pumpi-a chun lunglhai tan natin; chutengle namaicham chunga chun abongchal hou chu hintoh taovinte.
  </para>
  <chapter number="52" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo mithahatpa, nangmale nangma ibola thilphalou va naki thang-at ham? Pathen phatna chu tanglouva umjing ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nalei hin samchem hemtah bangin jonchihna na atongin, chule lamvaina chu agongin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangin thilpha sangin thilse nangailun, chule chonphatna seisangin jouthu nangailu jon ahi. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo lheplhahna lei, nangman bahgam thu jouse nangailun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutobanga chu Pathen'in a-itih-a dinga nagamsah-a nalahmang ding, chule na chenna mun'a kona nabodoh-a, mihing gama kona nakaldoh ding ahi. Selah
  </para>
  <para style="p">
    <verse number="6" style="v" />Michonphan jong amua, chule akichatna, anuisat ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veovin, Pathen chu ahatna-a semloupa, ahi-a ninglhing setna ahaonaho tahsan na, gitlouna-a kisuhat mipa chu amahi ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla keimavang Pathen insunga olive thinghing tobang chu kahin, keiman Pathen hepina chu a-imatih channa din katahsanin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichu nabol jeh-in a-imatih chanin nangma vahchoi jing ting, chule namin chu ngahjing tange; ajeh chu namithengte mitmu-a hichu phatah ahi.
  </para>
  <chapter number="53" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mingolin alung sungah Pathen aumpoi atijin ahi. Amaho akisuboh-un, chule thet umtah khan gitlouna aboluvin, koimacha thilpha bola aumpouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahethem le Pathen hola umkhat touvem tin, Pathen'in van'a konin mihem chate ahinvesuh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho abonun akinung heijin, abon chaovin abohgam taove; thilpha bola khatcha aumpoi, khatcha jong aumpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khan gitlouna natongho chun hetna himhim anei lou uham? amahon changlhah aneh bangun kamite abahgam taovin; Pathen la akou him him pouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kichat umlouna-a chun amaho akicha lheh-un ahi; ajehchu Pathen'in nangma douna-a gebuh sunga umpa guho chu athechehtan; Pathen'in amaho i-asahlou jeh-in, nangman amaho najachat sahtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen'in amite asohchan naova kon ahin lepui teng, Israelte huhhingna chu Zion'a kon hitavele, Jacob thanomin tin, Israel kipah ding ahi.
  </para>
  <chapter number="54" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, naminin neihuh hingin, chule natha hatnin kathu neitan peh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Pathen, kataona ngaijin lang, kakama thupot ho-a hin nana neisun peh-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu gamchom miho keima doudingin akigotaovin, chule misugenthei hon kahin nahi aholun; Pathen chu amasanguvah akoipouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vetan, Pathen chu eipanpia ahin; Pakai chun kahinna eituh peh ho aumpin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman kamelmate chu setna-a alelutding ahin; nangman amaho chu nathutah-a chun sumangin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nahenga manbeijin ganlhaina neijinge, O Pakai, hichehi thilpha ahijeh-in, namin vahchoi jinge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu aman lungkhamna jouse-a konin eihuh dohtan; chule kamelmate chunga kamitnin angaichat chu amutai.
  </para>
  <chapter number="55" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, kataona-a nana hinsungin; chule kathumna-a konin nangma kiselmang hih-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kakoma uminlang, chule kataona nei ngaipeh-in, kagenthei na-a kalunghemin, hichun eisunoh phah-in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Melma aw jehle migiloupa suhgentheina jeh-in na satah-in kamaovin ahi. Ajehchu khan gitlouna kachunga eisekhumun, chule lunghang tah-in eihot boluvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalungthim sunggil lamhi analheh jengin; chule thina kichat umtah chu kachunga achutai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kichatna le kithinna kachunga ahung lhungin, chule kichatna melse tah-in eichuptai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman kaseije, O keima vakhu banga lhaving nei hitaveleng! lengmang ingting gakicholdo tange.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veovin, gamla tah-a vah lengting, gamthipma kaumding ahi. Selah
  </para>
  <para style="p">
    <verse number="8" style="v" />Huipi hattah le khopihuija kona hoidohna dingin kikin nonge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pakai aleiju sukhen inlang, sumangin, ajehchu khopi sunga khun hunam le kinahna kamun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sunle jan-in chua kulbang chunga chun amaho avahle leuvin, asunga chun lungkhamna le thilphalou jeng aumin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Alah uva chun khan gitlouna aumin; lheplhahna le doha bolnan akhosung lamlen adalha khapoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu eiseisea chu melma ahipoi; hijo ngaple kathoh joujoh ding ahi. Keima douna-a ama kiloupi sahpa jong chu eihotbol ahipoi; hijo ngaple ama-a kona kiselding kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla kakibahpi mi, eipuija, chule kamelhet mi, nangma nahi,
  </para>
  <para style="p">
    <verse number="14" style="v" />kithu hilna ngeitah ingaikhom jin, chule Pathen houin'a ichekhomji-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thinan achungu lhunkhum hen, chule thikhol khulah kumsuh loijuhen, ajehchu gitlouna chu achennao le alah uvah aume.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keivangin Pathen kou vingting, Pakaiyin eihuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jingkah le nilhah, chule sunnin taovingting, hatah in saminge; Chule aman ka aw ajahding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Eidounao galmuna konin aman kahinna mongtah-in eihuhdoh-in ahi; ajehchu eidouho chu tamtah ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathen, khanglui laija umjingpa tahchun, ngaijintin, abol hesohdiu ahi. Selah Ajehchu amahon kikhelna aneilou jeh-un Pathen agingpouve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amatoh kichamna neiho dounan akhut alhangin, akitepna chu asukehtan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Akama thuho chu bongnoiha sangin analjon, alungsungla kidouna bou ahin; athuho chu thao sangin ajoljon, ahinla chemjam kisatdoh ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Napohgih Pakai chunga seplhan, aman napanpi ding ahi; Aman michonpha chu suhling dingin itih hijongle phal ponte.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla vo Pathen, nangin amaho chu manthah na kokhuh sunga napuisuh ding; thisanso mile milhem lhaho chu anikhou kehkhat jong hing joulou dingu ahi; Hijongle keiman nangma katahsan ding ahi.
  </para>
  <chapter number="56" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, neihepin, ajehchu min vallhum din eigon, aman niseh-in eikisatpin eisugenthei jinge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kamelma ten niseh in vallhum dingin eigouve; ajehchu eidouho chu tamtah ahiuve, vo chungnung pen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kakichat tengle nangma tahsan inge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen chu athu-in vahchoi jinge, mihemin i-eilo theiding ham? Pathen'a katahsan kangamtan kicha ponge
  </para>
  <para style="p">
    <verse number="5" style="v" />Niseh in kathuho alakoijun, alunggel jouseu keima douna le setna ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho akikhom khommun, kahinna ladinga eichan tengule, akiselun, kakholhah amelchih jiuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khan gitlouna-a kona ongthol diu hinam? Vo Pathen, nalunghanna miho chu seplhatan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangin kavalenaho namelchih-in, kamitlhiho nahai sungah nakhumin, hiho chu nalekhabu-a umcheh louham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Nahenga kaka phatle, kamelmate chu anungchon jiuve; hiche hi kahei, Pathen chu keija ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen chu athu-in vahchoi jinge; Pakai chu athu -in vahchoi jinge.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keima kicha taponge mihemin i-eilo thei dingham? Pathen'a katahsan kangam tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pathen, nakihahselnaho kachungah aumin; keiman, nangma vahchoinaho peng kate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu kahinna hi thina-a konin nahuhdoh tan; Pathen masanga hinna vah-a kavale theina dinga, kakenga kalhuh louna dinga nangin neihuhdoh lou ding ham?
  </para>
  <chapter number="57" style="c" />
  <para style="p">
    <verse number="1" style="v" />Neihepin, vo Pathen, neihepin, ajehchu kahinna-in natahsanin ahi. Hiche vangsetna ho kichai kahse-a, nalhalima kahoidoh na kasemding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen thil jouse eibol pehpa, chungnung pen Pathen henga chun taovinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vallhum dinga eigopa i-sah louva konchun, aman van'a konin hinsol intin eihuhhing ding ahi. Selah Pathen'in amihepinale athutah chu ahinsoldoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kahinnahi keipi bahkaiho lah-a aumin, chule mei kihal khumho lahle, ahahou tengcha le thallung bang, aleiju chemjam hemtah tobang mihem chapate lah jenga jong chun kalumjin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pathen, nangma vanho chungvuma kichoisangin, naloupina chu leiset pumpi chungvuma umhen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon kakholhah na din lenthang aphaovin, kahinna hi alhadah-in; kamasanga kokhuh alaijun, chuche-a chun amaho alhalutnuve. Selah
  </para>
  <para style="p">
    <verse number="7" style="v" />Kalungthim dettah ahi, vo Pathen, kalungthim dettah ahi, la sang ting chule vahchoina penge.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thoudoh-in, kaloupina, tumging le selangdah kithou vin, keima tah jong matah-in thouvinge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pakai, mipi ho lah-a nangma vahchoi jing ting; namtin lah-a nangma henga la sange.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nahepina chun vanho apha-in; chule nathudih chu meilhang ho aphan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pathen, nangma vanho chungvum geijin kichoisangin, naloupi chu leiset pumpi chungvum ma umhen.
  </para>
  <chapter number="58" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo mipi ho, nanghon tahbeh-a chonphat thu naseiju hinam? Vo nangho mihem chapaten, lungtheng sela thu natanu hinam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Henge, nalunguvin gitlou nabolun, leisetna hin nakhut-un hunam napan jiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Migilou chu naobu-a kona khensa ahin, apen penule jouthu seijin avahmangpai jitaovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Agu-u chu gulgu tobang ahin, amaho gulsum na-ngong kolseh tobang ahiuvin;
  </para>
  <para style="p">
    <verse number="5" style="v" />cheho chun guldoi themhon itobang themin lhim jongleu jou pouvinte.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Pathen, akamuva aha-u chu subongin lang, vo Pakai, keipi bahkai donglaiho hapiho chu subongsoh-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tanglouva longjing twi bangin amaho junmang sah-in, athalchang kapdoh dinga athalpi ajetkon teng, ahal ahala kisat bahsah jengin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Twilung ajunmang bangin amaho abonchauvin mangthah uhen, aphatlouva nupi naonei, nimel mutheilou bang hiuhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nabel houvin lingsut ahet masang uva, aman alunghana-a ahing le ago abona chimpeija alhohmang ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Michonpha chun phulahna amutenguleh kipah intin, migilou thisana chu akeng akisil ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutia chu mihemin michonpha din tohphat man aum mong monge atidiu ahin; tahbeh-a leiset chunga thutan Pathen chu ama ahi.
  </para>
  <chapter number="59" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo ka Pathen, kagalte-a konin neihuh doh-in, eidouva dinga kipatdoh ho-a konin neihuh doh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khan gitlou bolho-a konin neihuhdoh in, chule thisanso mi-a konin neihuh hingin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu vetan, amaho kahinna ngah-in aumjingun; Vo Pakai kasuhkhel jehle kachonset jeh jong hilouvin, mihat ho chu keima dounan akikhomun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kasetna beijin akigouvin alhaijun ahi. Ven kithoudoh inlang eipanpin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun vo janel Pakai, Israel Pathen, Pathen hephalouho vildin thouvin, mikitahlou suhkhel neihohi khatcha jong hepihih helin. Selah
  </para>
  <para style="p">
    <verse number="6" style="v" />Nilhahle ahung kileuvin uicha bangin apeng setsot jiuvin, chule khopi chu avelvel jiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veovin amahon akamuvin aphong doh-un; amuh uva chemjamho aumin; hitichun, koiham ajah-a? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla vo Pakai nangin amaho chu nuisatjon natin, Pathen hephalouho chu nuijat nan neijinate.
  </para>
  <para style="p">
    <verse number="9" style="v" />Atha hatna jeh-in nangma ngah inge; ajehchu Pathen kakihonbitna ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Eihepi Pathen chun eihoidoh intin, Pathen'in kamelmate chunga kangaichat eimusah inte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho chu that hih in, ajole kamiten sumil getnunte, vo Pakai kalum dalu, nathaneina in thecheh inlang loi nemin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu akamuva asetnao le amuh uva thuho jeh, chule athuseiju gaosapna le jouthu jeh-in, akiletsah naova matnin umuhen;
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho chu lung hana-a sumangin, aumlouna diuvin amaho chu sumangin, chule leiset kichaini geija Pathen'in Jacob'a vai ahomchu amahon heuhen. Selah
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nilhahle hungkile sah inlang; uichaho bangin peng setsot nuhen lang, chule khopi chu velleu hen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amaho chu nehding holin sahle lhanga vaveisah-in, chule achim louvule phunphun taohen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla keiman nathahatna chu lan sangting, henge, jingkahle nahepina la gingtah in sange; ajehchu nangma lungkham ni-a kahoina le kakiselna nahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo kathahatna, naheng-ah la sange; ajeh chu Pathen hi kahoina le eihepia Pathen chu ahi.
  </para>
  <chapter number="60" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen nangin neipaidoh-un nei thecheh taovin, nalung phamotai; O nangma keiho lammah hung kile kitan.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin leiset nahot lingin, nasukehjin; akhikeh jouse thoi bitnin, ajehchu akilingin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Namite hi thil hahsatah namusahtan; lungdonna lengpitwi neidonsah taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thutah jeh-a tah langa aumtheina diuvin, nangma gingho chu ponlap khat napetan ahi. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Nalungset ho nahuhdoh theinadin nakhut jetnin huhhingin lang, chule neingaipeh in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen'in athenna-in thu aseijin, keima kipah ingting, Shechem chu kahop khenna chule Succoth phaicham chu kahopdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gilead le Manasseh hi keija ahin, Ephraim jonghi kalu thahatna ahin, Judah chu ka danthu pepa ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Moab hi kakisilna bel ahin, Edom chunga chu ka kengkoh kaledoh ding; Philistia, keima jal-in jona changin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Edom'a chu kon eilamkaija, khopi dettah-a chu kon eipuilut ding ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Pathen, eina paidoh uva chu nang nahilou ham? chule kagalsat houtoh kondohji Pathen chu nang nahilou ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Lungkham na-a konin neipanpin, ajehchu mihem panpinahi ahomkeo ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen jala hangsan tah-a iboldiu ahi; ajehchu kamelma teo chotpha dinga chu ama ahi.
  </para>
  <chapter number="61" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, ka kana ngaijin lang, kataona neingaipeh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kalungthim alhahdah tengle, leiset kolmonga patnin hinkou vingting, kei sanga sangjo songpi-a chun neipuijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nangma bou kahoidoh na nahin, melma te-a kona insang det tah chu nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A-imatih chana keima nahoubuh sunga kaum jing ding; nalhaving noi kiselna chu tahsan inge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu vo Pathen, nangin kakitepna neijah pehtan; namin gingho gamlo ding chu neipetai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangin lengpa hinkho nasaosah ding; chule akumho chu khang tamtah tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama Pathen anga tonsotna umjing ding; ama vettup ahithei nadin hepina le thutah chu gongtoh-in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichun kitepnaho niseh-a kabol theina din, a-imatih chanin namin vahchoi La sajing tange.
  </para>
  <chapter number="62" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tahbeh-in kahinna hin Pathen angah-in, huhhing-a kaum nahi ama-a kona hung ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amabou kasongpile eihuh hingpa ahin, ama kahoidohna ahin, keima kiling louhel ding kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Itihchan mi khat douna-a thilphalou nangaito diuham? Nabon chaova kithatgam ding nahiuvin; bang on tobang le pal chim kon tobangbou nahidiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama athupina-a kona sotlhah dingbou akihouvun, jouseihi athanopnao lamtah ahin; akamun phatthei aboh-un asung gilun vang agaosapmun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kalhagao, na Pathen bou ngah-in, ajehchu kagin chatna chu ama-a konbou ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amabou kasongpi le eihuh hingpa ahi; ama kahoidohna ahin, keima longlou ding kahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathen'a kahuh hingna le kaloupina aumin, kahatna songpi, chule kahoina chu Pathen'a uma ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Phat tinin ama tahsanun lang nanghon nalung thimmu a-angah sunglhaovin, Pathen chu eiho dinga hoidoh na ahi. Selah
  </para>
  <para style="p">
    <verse number="9" style="v" />Tahbeh-in minoi nungte hi pannabei ahin, milenho jonghi jou thubuh ahibouve; khaikotna khaidin abonchauvin ahomkeo sangin ajang jouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Suhgentheina tahsan hih-un, chule mohseh-a mi chom jong bolhih-un, haona apunleh, hiche chunga chun nalung koihih-un.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen'in khatvei aseitan, hiche hi nivei kana jatai; thahatna hi Pathen'a ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />O Pakai hepina jonghi nangma-a ahije; ajehchu nangman mitin anatoh dungjui cheh-in lethuhna napejin ahi.
  </para>
  <chapter number="63" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, nangma ka Pathen nahin, jingpi matah-in nangma holinge; Twi beina gamgo dangchah na gama hin, kalhagao nang ngaijin adang chah-in, katahsan jong nangma nangaichan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nathuneinale naloupi munadin, munthenga chun nangma kana velen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nalungset ngailutna hi hinkho sanga aphat joh jeh-in, kakamin nangma navahchoi ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hitichun kahinlai chansen nangma vahchoi jingting; namina kakhut kadop sang ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kahinna hi lhin le thaova lunglhai ding, chule kakam hin kipah-in nangma navahchoi tante.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kajalkhun chunga nangma kageldoh teng, jankho lhonin nangma kangaito jin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu nangma eipanpi jia nahin, hijeh-a chu nalha limnoija keima kipah kahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kahinna hin nanung naichan ajuijin; nakhut jetlamin neituh jinge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kahinna sumang dinga holho vang chu, leiset noinung geija kumlha diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho chemjam'a loudingu ahiuvin; amaho sial ho chanvou dingbou hidiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla lengpa chu Pathen'a kipah ding, ama-a kihahsel takip chu loupi ding ahiuvin; ahinla jou thusei ho kam vang kisimbing ding ahi.
  </para>
  <chapter number="64" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, kataona-a ka aw ngaijin, melmate ginna-a konin kahinkho hi neiventup peh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mikhangse kithuhilna-a konle, khan gitlou natongho thilgona konin jong neiselin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahon aleiju chemjam bangin anol hemun, chule thu khatah ho kap nadin athalpihou ajekon uvin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Nolnabei mi chu guhthima akaptheina diuvin; amahon photlot louvin, kichalou helin ama chu akapmun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thilse lama amahole amaho akitil khouvun; guhthima thang kam nadin akihou jiuvin, kon amuding ham? atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon khan gitlounaho chu aholun, gunchu tah-a athil holu chu amolsouve. Amaho sunggil lam ngaitona le lungthimho chu thuhtah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Pathen'in amaho thalla akapding, photlot louva machangdiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun aleigui jeh uvin amaho mangthah-un tin, amaho mutapou chu jammang jengdiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule mijouse kichaovintin,Pathen natoh chu aphondoh diu ahi; ajehchu ama thilbol chu lungching tah-a angaitodiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Michonpha hochu Pakaiyah kipah untin, chule ama atahsan diu; milung dih ho jouse chu loupidiu ahi.
  </para>
  <chapter number="65" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Pathen, Sion'ah pachatnan na-ngah jingin, chule kitepna chu nahenga kimolso ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />O nangma taona sang nahin, tahsa phe jouse nahenga hungdiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khan gitlouvin eijou jing jengin; ka suhkhelnaho vang nangman nasop ngim ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na-in hong sunga achentheina dinga, naheng nailut dinga nalhentum mi chu anunnome. Na insung phatna na houin theng ngeija chu kalungnao chimding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo eihuh hingpao Pathen, chonphat na-a gimneitah thil kibol ho-a nei donbut nin natin; nangma kolkimvela jouse le, twipi chunga gamlatah-a miho tahsan chu nahin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Thanei na-a kong akigah-a, athahat na-a molsang ho tungdoh pa;
  </para>
  <para style="p">
    <verse number="7" style="v" />Twipiho husan le twikinong husan, chule mipi tamtah husa gin suthip pa nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kolmonga chenghon jong namelchihna ho chu akichauvin; nangman jingkahle nilhah jong thanom tah-a potdoh din nasemin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangin leiset hi navilin, chule twi nachap kot jin; naning lhinset sah-in, Pathen vadung chu twi dimset ahin, nangin chutabang chu napeh phat chun, chang ahung umdoh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangin damkom ho chu twi nanen sah-in, langkon mahaho naum sah-in, hichu gohongin nachapnemin, chua kehdohho chu phatthei naboh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangin kum chu naphatna-in nakhu-in, chule na lampiho chun sathao navat khumin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaho chu gamthipma hampaho chunga avalhan, lhang neoho chu amun cheh-a akipah un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hamhina mun jouse-a chun gancha hon adimin; phaicham ho jong changin akhusoh-in, thanomin a-aovun, lajong asauve.
  </para>
  <chapter number="66" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho gamjousen, Pathen na kipa aw thon sah-un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amin jana la saovin, ama vahchoi chu loupi sah-un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen henga, nathilbol chu iti gimnei hitam! nathilbol theina loupi jala, namelmate nahenga kipelut ding ahiuve, tin seijuvin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Leiset pumpin nangma nahouvun tin, chule nahenga la asah uva, namin vahchoi La asahdiu ahi. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen thilbol hohi hungvetemun, mihem chate chunga athilbol hohi tijat umtah ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman twipi tolgo asosah in, twisoh chu kengin apal galkaijun, hia chun ama-ah kakipah uvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman athaneina-in tonsotnin vai ahomin, amitnin namtin chu amui; dou bolho chu kichoisang daohen. Selah
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo nangho mipin, i-Pathen'u chu vahchoijun, chule apachatna awgin chu kijahdoh sah-un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman mihing lah-a ihinnao hi eituhdet peh-un, chule ikengu achaloh ding jong aphalpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu Pathen, nangin neipatep un, dangka bangin nei suthengun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangin len sunga chun neipui lutnun, kakong uvah suhgentheina nangame.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangin kalu chunguva mi natousah-in, keihon meilah le twilah kapal galkaijun; ahinla nangin munphatah khatna neipuilut taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima govam thilpeh choija na in'a kalut ding ahin; kakitepna ho chu nangma kapeh ding,
  </para>
  <para style="p">
    <verse number="14" style="v" />hichu kahesoh laitah-a kamuh-in aseidoh-a, ka kamin anaphondoh ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sathao tah-a govam ganlhaina le kelngoichalho gimnamtui chu nahenga toh ingting, bongchalho le kelcha hotoh tothange. Selah
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho Pathen gingho jouse, hung unlang ngaijuvin, chule kahinna dinga ipi eibol peh-em phongdoh inge.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kakamin ama kakouvin, kaleijin ama achoi anjin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman kalungthima gitlouna kangaitole, Pakaiyin eingaipeh ponte.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla tahbeh-in Pathen'in eingaipeh in, aman kataona aw eingaipeh tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kataona le amihepina keija kona heimanglouva Pathen chu nunnom hen.
  </para>
  <chapter number="67" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen'in eihepiu hen, phatthei eiboh uhen, chule amaivah chu ichunguva salvah hen. Selah
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichu leiset chunga nalampi akihetna ding, chule nahuhhingna damna chu namtin lah-a akihet nading ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pathen, mitinin navahchoi hen, mijousen nangma navahchoiju hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />O namtin kipah henlang kipanan la saohen, ajehchu nangin chonphatna-a miho thu natana, chule leisetna cheng namtin chunga vai napoh ding ahi. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pathen mitinin navahchoi hen, mijousen nangma navahchoiju hen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutengle leisetnin aga tampi sodoh intin, Pathen, ka Pathen'u chun, phatthei eiboh taovinte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathen'in phatthei eiboh-untin, chule kolkim vella mijousen ama ging taovinte.
  </para>
  <chapter number="68" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen chu kipat henlang amelmate kithecheh uhen, ama hote jong chu amasanga jamuhen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meikhu alencheh bangin, amaho lenmang sah-in, mei koma khoilu jollha bangin, Pathen anga migilouho chu mangthah uhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla michonpha ho kipah-u henlang, Pathen anga thanomuhen; henge, nasatah-in thanom uhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen henga la saovinlang, tumgingto thon amin vahchoi La saovin; vanho chunga touva amina JAH kitipa chu choisangun lang a-anga kipah un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Achenna munthenga um Pathen chu, pabeite pale meithaiho thutan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen'in michangkhat chu inko lah-a akoijin, akihenho alhadoh-in; golkehho vang chu gamgoa achensah-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pathen, namite nahin lamkaija, gamthip nahinjot laichun, Selah
  </para>
  <para style="p">
    <verse number="8" style="v" />Leiset akihotnin, vanho jong Pathen angah achimlhan, Israel Pathen anga chun Sinai jengjong chu akihot tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pathen, nangin go nengtah-in najuhsah-in, hichea chun nagoulote ahatmo laitah-un nasudet tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma mipi ho chu chua chun anachengun, vo Pathen nangin naphatna chu mivaichate dingin nagon peh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakaiyin thu apen; chuche thu phongjal ho chu hon lentah ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lengte galmiho chu gangtah-in ajamtaovin; chule in'a um numei ho chu galla kichom dohho akihom taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Belho lah-a lumji jongle chun, vakhu lha dangka-a kitom tobang le amul ho sana enga kitom tobang nahi nahlai dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hatchung nungin chua lengho athehcheh laichun, Salmon'a buhbang bangin abangin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathen lhang chu Bashan lhang tobang ahin, lhang sangtah chu Bashan lhang tobang ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho lhang sangho, ibolla kichom nahiuvem? Hichehi Pathen'in achenna dinga adei lhang chu ahi; henge, Pakai chu chukoma atonsotna chengding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen kangtalai chu sangsomni, vantil asang asangho ahin, Pakai chu muntheng Sinai'a tobang chun alah uva aume.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangma chungsanga nakaltouvin, gal hing chu gal hingin nakaijin, nangin miho din thilpeh nasangin, henge, doubolho-a dingin jong nasangin; hitia chu Pakai Pathen chu alah uva achentheina ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Niseh-a iphat chomna diu eipeuva Pakai, eihuh hingpao Pathen chu nunnom hen. Selah
  </para>
  <para style="p">
    <verse number="20" style="v" />I-Pathen'u chu huhhing-a Pathen ahin, thina-a kona hoidohna chu Pakai Pathen chun anei ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla Pathen'in amelmate luchang le, suhkhel na-a chejing pa samphatna lulei chu amavoding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakaiyin, Bashan gama konin hinpuikit ningting, kamite chu twikhanglen thuhtah-a konin pui kitninge, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitia chu nakengu namelmate thisanna nadelut uva, chule na uichateu lei jongchu chutima hiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vo Pathen, amahon nache chu amuvin, ka Pathen le kalengpa, munthenga nachelaitah chu amuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lasaho amasauvin, tumging tumhon anungu ajuijun, alah uva chun nungah khongcha bengho aumuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mipi kikhom lah-a Pathen vahchoijun, tonsot Pakai chu Israel twinah-a konchun vahchoijun.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chua chun Benjamin phungneo leh, avaipoteu; Judah pipuiho le avaipoteu, Zebulun pipuiho chule Naptali pipuiho chu aumuvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na Pathen'in nathahat chu thu apen; Vo Pathen, kadiuva neithil bolpeh-u chu hatsah-in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jerusalem'a na houin jala lenghon nahenga kipaman ahinchoi diu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mijouse dangka nongho to ahung kipehlut masang seuvin; tengcha choi mihon ho, mipi ho bongnou jaonan bongchal tamtah ho, chu phohsalin lang, galbol ding dei miho chu thecheh-in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Egypt'a konin pipuho hungdoh untin, Ethiopia'in Pathen lamah akhut jahdoh vah tante.
  </para>
  <para style="p">
    <verse number="32" style="v" />Leiset lenggam hon Pathen vahchoi La saovin, Pakai vahchoina la saovin. Selah
  </para>
  <para style="p">
    <verse number="33" style="v" />Golluilai vanho le, vanho chunga toupa henga chun; veuvin, aman a-aw, thaneitah aw ahin lhadoh-in ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pathen henga nahatnao chu peuvin, athupina chu Israelte chungah aumin, chule ahatna chu meilom ho lah-a aumme.
  </para>
  <para style="p">
    <verse number="35" style="v" />Vo Pathen, namun thengho-a kona nangma tijat umtah nahi. Ama Israelte Pathen ngeitah chu amite thahatna le thilboltheina peji-a ahi. Pathen chu nunnom hen.
  </para>
  <chapter number="69" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, neihuhhing in, ajehchu twi hohin kahinna gei ahin phatan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dinna ding umlou bonlhoh thuhtah-a chun kalhalut tan; twisoh in eichupmin, twi thuh lama chun kahunglut tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaka kanan katha acholin, kadang agotan; Ka Pathen kanga jing lai hin kamit alosam tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh beija eihotbol te chu kalua kasamho sangin atamjouvin; dihlou tah-a suhmang dinga eigo kamelmate chu hattah ahiuvin; hiti chun kalah khah louhel chu kalepeh jin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pathen, nangin kangolna nahen, chule kachonsetna ho nanga konin akiselpon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo tonsot Pakai, janel Pathen, nangma ngahte chu keima jeh in jachat sah hih-in, vo Israel Pathen, nangma holte chu keima jal-in maimoh daohen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu nangma jal-in keima i-sah louvin ka umin, jachatnan kamai akhutan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kasopite lah-a maljin kasohtan, chule kanu chate lah-a gamchom mi kahitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu na in dinga katom pana-in einechai jin, chule nahouse hon na housetnao chu keima chungah achutan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima kaka ka-a chule an ngola kahinna kasuhgim tengle, hichu eiki houset nabep ahijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khaodip pon jong kavonin kasemtan, amahodin thuchihbep kahijitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kotpi phunga touho chun keima douna thu aseijun, chule jukhamho la bou kanahi jin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla vo Pakai, keima vang lah phatchan nahenga kataojin, vo Pathen nahepina tamtah, nahuh hingna thutah jal chun nei ngaipeh-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bonlhoh-a konin neiloidoh inlang, neilhah lhumsah hih-in, eihot bolte leh twi thuhtah-a konin neihuh doh-in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Twisoh chu neichupsah danlang, twithuh chu neival lhumsah hih-in, chule kotongin jong akam eichikhum hih hen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo Pakai nalungset ngailutna hi aphatjeh-in, neingaipeh in, nahepi khotona chamkim dungjuijin kaheng lama hung kiheijin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nasoh-a konin namai sel hih-in, ajeh chu lungkhamin kaume; gangtah-in neingai peh-in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahinna hin naijin chule lhatdoh-in, kamelmate jeh-in neilhat doh-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangin eikisei setnale kajachatna chule eikija louna hohi nahen; kakidoupi jouse abonun namasanga aumuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Houset nahin kalungthim asukeh-in, chule lungkham na-a kadimset nin; ei khoto ding kaholin, khatchala kamupon, chule lhamon naho kaholin khatcha jong kamujoupon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka-an dingin gilkha eipeuvin, chule kadang chah-a kadondin lengpitwi thuh eipeuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Adokhangu chu amasanguva thang hihen, chule aphat theinadiu tahho jong chu, thang kisoh hen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amulouna diuvin amitnu thimhen lang, chule akongu chu tanglouvin kithin sah-in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nalungsat na chu achunguva bunglhan, chule nalunghan lungsatna chun amaho manchah hen,
  </para>
  <para style="p">
    <verse number="25" style="v" />achennao chu kamhel henlang, aponbuh uva koimacha cheng hihhen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu nangin navoh chu abol gentheijun, chule namavona-a lungkhamho chu houlim nan anei jiuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Akhan gitlounao chu khan gitlouna-in belapmin, chule amaho chu nachon phatna sunga hunglut hih-u hen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho chu hinna lekhabua konin noimangin, chule chonpha hotoh sunhal hih-in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahinla keima genthei tahle lunggimtah kahin, o Pathen nami huhhingna chun mun sang-ah eikoihen.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pathen min chu la khatnin vahchoi jingting, chule thangvah tothon choi-an inge.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiche hin ki le tin nei bong ahiloule bongchal sanga Pakai chu alung lhaisah joh ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi nunnemin hichu muntin chule kipahding; chule nangho Pathen hol ho, nalungthimu hingding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ajeh chu Pakaiyin migenthei te angaipeh-in, chule asoh changho nahsah louvin abolpoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Van le leiset, twipiho chule asunga achatle thei jousen, ama chu vahchoi cheh hen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ajeh chu Pathen'in Zion ahuhhing ding, chule amaho chua achenuva, gouloa anei na dinguva, Judah khopiho asahdoh ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Asohte sonho jong chun hichu ahinlodiu; Amin ngailuho chu asunga chu chengdio ahi.
  </para>
  <chapter number="70" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen eihuhdoh dingin kino-inlang, vo Pakai eipanpi dingin kikinno loijengin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahinna suhgep dinga holho chu, jahchao henlang maimoh uhen; kakisuhkhah ding deiho chu, kinungle sah inlang kisudongu hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aha, aha, tiho chu ajachatnau lethuh na-in nunglama kilesahtan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma holjouse chu nangma-a kipahle thanom muhen, na huhhingna ngailuho jouse chun tanglouvin, Pathen chu choi-at nin umhen tiuhen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla keivang vaichale lhasama kahi, vo Pathen, kahenga hungloijin, nangma eipanpi-ale eihuh hingpa nahi; vo Pakai, geisang loujenin.
  </para>
  <chapter number="71" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai nangma ah katahsan kangame, a-imatih chanin nei lungdonsah hih helin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na chonphat na-in neihuhdoh inlang, neihoidoh sah-in, kaheng lama nana hin sung inlang, neihuh doh-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma kachenna dettah, kapansat jom jingna nahin, keima huhhing dingin nangman thupeh napei; ajehchu nangma kasongpile kakulpi chu nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo ka Pathen, migilouho, chonpha louho, chule mi-engse ho khutna konin neihuh doh-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu vo Pakai Pathen, nangma kakinepna nahin; kakhangdon laijapat nangma katahsanpa chu nahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang jala naobu-a kona eina kituh-a ahin, kanu oisunga kona eiladoh-a jong nangma nahin; kavah choina tanglouva nanga hijing ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi tamtah-in kidang eisah-u ahin, ahinla nangma kakiselna dettah nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nilhum keijin kakamhi nangma vahchoina le jabolna-in dimset jing hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kateh nungle neipaidoh hih-in, kathabei phatle neidalha lou jenin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu kamelma ten keidouna thu aseijun, chule kahinna changlhiho akihou somun,
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen'in ama adalhatan, manin lang bolgen theijun, ajehchu ahuhdoh ding koima aumtapoi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pathen, keija konin gamla hih-in, vo ka Pathen, eipanpi din hung loijin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kahinna douho chu kisuh dongsah-in lang sumangin, kakisuh khah nading hol ho chu seisetle maimohna-in khukhum uhen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla keima vang kakinep jing ding, chule nangma kaha vahchoi cheh cheh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kakamin nilhum keijin nachon phatna le nami huhhingna phongdoh inge; ajehchu keiman ijat tah mong ahi kahepoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keima Pakai Pathen thahatna songin cheng ting, nangma chonphatna, nangma-a sehbou phapoh inge.
  </para>
  <para style="p">
    <verse number="17" style="v" />O Pathen, kakhangdon laija patnin nangin neina hilin, tugeijin nathilbol kidangho chu kaphong doh-in ahi,
  </para>
  <para style="p">
    <verse number="18" style="v" />kahatna hi hiche khang mite hengle, nathaneina hi ahung lhung dingho jouse henga kahetsah masangsen; vo Pakai tu kateh-a kalu akan phat jonghin, nangin neidalha hih-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Pathen, nang thil loupitah bolpa chu, nachon phatna jong asanglheh jenge, vo Pathen nang tobang koi umintem!
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangma Lungkhamna lentahle nasatah eina musah pan, neisuh hal kit ding ahin, leiset thuhtah-a kona neipuitou kitding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangin kaletna punsah-in natin, lamjousea eilhamon nin nate.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tumging tothon navahchoi jinge, Vo ka Pathen, na thutah ngeichu vahchoi jinge; vo nang Israelte mithengpen, selangdah in nangma vahchoi jinge.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangma henga la kasah tengle, kamuhhi hapan kipah intin, chule nalhatdohsa kahinna hi hapan kipah inte.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kalei jonghin nachon phatna nilhum keijin seijinte; ajehchu kasetna ding holho chu jachatna ah achutaovin ahi.
  </para>
  <chapter number="72" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, nathutanna chu lengpa penlang, nachon phatna chu lengpa chapa petan.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman namite chu chonphatna-a thu atanna, chule nami vaichaho chunga thudih-a thu atanding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Molsang hon namite henga chamna hinpou vintin, chule lhang neohon chonphatna ahinpoh dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman milah-a vaichaho chu athu-u atanna, milhasam ho chate chu ahuhdoh ding, chule misugenthei te chu ngemsela asuhchip ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon nile lha aumlaise-a akhang akhanga nagindiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama gohongin lei achapnou banga, hampa chunga goju banga hung ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama nikholaile chonphatna chu pungin tin, chule lha aumlaisea chamna bulhing setna umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman twikhanglen'a pat twikhanglen gei, chule vadunga pat leiset kolmong geija lengvai apohding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gamthipma chengho chu a-anga bohkhup muntin, chule amelma teovin leivui ale diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tarshish lenghole twikol gamhon thilpeh ahinchoidiu, chule Seba lengho le Seba'n thilpeh apehdiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Henge, lengjouse a-anga bohkhupdiu, nam jousen ama ajendiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu aman angaichaho, mivaicha le panpiding neilou mi chu atao tengleh ahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman mivaichale lhasamho ahoidoh ding, alhasamho hinna chu ahuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman amaho hinkho chu lheplhahna le hunam na-a kona alhatdoh ding, chule athisannu chu amitmua manlutah hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ama hingintin, ahenga Sheba sana chu kipe ding; amadinga taona tanglouva uma, niseh-a ama kivahchoi ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Leiset molsang ho chungvuma chun chang ga tamtah umintin, Lebanon banga aga chu kiling ding, khopi sunga miho chu leisetna hampa banga pungdiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amin chu tonsotna umding ahin; amin chu nisa umlaisea umjing ding ahi: chule ama-a mitin phattheina changding; Namtinin nunnom ati dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai Pathen, Israelte Pathen chu nunnom hen, ama bou thilkidang bolpa chu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amin loupi chu tonsotnin nunnom hen; leiset pumpihi aloupina in lodimhen, Amen chule Amen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesse chapa David taonaho akichai tai.
  </para>
  <chapter number="73" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dihtah-in Pathen hi Israelte dingin aphan, milung thengtah hodingin jong aphan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla keimadingin vang, kakengho amui lhagam kon ahitan, kakalsonho kalhonal ding koncha ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu migilouho phattheina kamuteng, mingol ho kathangse jin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu athi tengu jongle thohnatna himhim aneipouvin, ahin athahatnao adetjon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Midang bangin hahsatna imacha anei pouvin, midang bangin thohgimna jong aneipouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun kiletsahnan thihkhao bangin a-um kimvelu vin, hunam chun ponsil bangin atomuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Athao jeh un amitnu alotdoh-in, lungin angaitophah kalval aneijun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amahon nehguh abolun, giloutah-in suhgentheina thu aseijun, hoithotah in apaovui.
  </para>
  <para style="p">
    <verse number="9" style="v" />Van douna in akamkaovin, aleijun leiset pumpi achonsoh uvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun amite hilanga ahung akileuvin, chule twi khon dimset adon kangun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amahon, Pathen'in iti ahetna, chule chungnung pena chu hetna umam? atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Veovin, hiche hohi Pathen ngaisah louho ahiuve, amaho vannoi'a alolhingun, ahao cheh cheh uvin ahi,
  </para>
  <para style="p">
    <verse number="13" style="v" />Tahbeh-in keiman kalunghi mohseh-in kasuthengin, kakhut hohi mona beijin kasile.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu nilhum keijin kathohgimin, chule jingsehle eikisehgimjin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman, chutobang chun seijinge, tijongleng, vetan, nachate khanggui kipalsah kahiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman hichu hetdinga kangaito tengle, keidin anabehseh-in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen munthenga kagalutna, akichainao kaga hetthem masangsen, kachutin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Atahbeh-in nangin amaho mun nal ho-a nakoijin, manthah na-a napailhan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chomkah louva iti amaho mahthah hel jenga hitaovem! amaho tijat umtah-in akisumang heltaovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mangnei khat ahung khah doh banga; vo Pakai nakhahdoh tengle, chutobang chun alimu chu geldao tannate.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun kalungthim ahesoh-in, chule kalunggil asunalheh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keima mingol tah le kho hephalou kahin; namasanga gamsa tobangbou kahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeng jongle nang toh kaum khom jingin, kakhut jet lamin neituh jingnai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nathumop machun neipuijin natin, chujoule loupi na-ah neisangin nate.
  </para>
  <para style="p">
    <verse number="25" style="v" />Van'a nang tailou koi dang kaneijem? Chule leisetna jong nang tailou kangaichat dang aumpoi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Katahsa le kalungthim alosamtan; ahinla Pathen chu kalungthim thahatna le, tonsotna kachan ding chu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu vetan, nanga kona gamla ho mangthah diu ahin; nangma najon san jouse chu nasumang tan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Keidin vang Pathen naihi apha ahin; nathilbol jouse kaphondoh theinadin, Pakai Pathen'a katahsana kangam tan ahi.
  </para>
  <chapter number="74" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen ibola tonsotna dia neipaidoh hitam? Ibola nahamhinga kivah kelngoite douna-a nalung hanna khudoh-a hitam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Masanglaija nachoh dohsa namipi kikhomho, nalhatdohsa nagou nam mite le asunga nachenna hiche Zion molsang hi hingel doh-in
  </para>
  <para style="p">
    <verse number="3" style="v" />Kumkho-a manthah helna lama chun nakal hinsongin; melmaten engse tah-in munthenga na atongun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Namelmate chu namite kikhom ho lah-a chun akitumun, aponlap hou chu melchihnadin atungdoh taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thing lentah ho chunga aheichaho lamma mikhat tobang ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla tun athil suiho chu thakhat tah-in, heichale sehtumin asuchim taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namun theng jong meijin ahaluvin, namin chena ho tollah aseplhaovin, asuboh soh hel taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amahon alungthimun aseijun, eihon amaho abonchan sumangu hite; gamsunga Pathen hou khomna in jouse meijin ahalvam taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keihon kamelchihna hou kamu tapouvin, themgao himhim aumtapon; itihchan hiding ham he-a kalah uva khatcha jong aumtapon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Pathen, itihchan melman eihouset dingu ham? Namin chu tonsotna melmaten ataitom ding hitam?
  </para>
  <para style="p">
    <verse number="11" style="v" />Ipidinga nakhut natuhtanga, nakhut jetlam ngeichu ibola natuh tang ham? na-opma konin lhangdoh inlang amaho khu sumangin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu Pathen chu tonna patna kalengpa ahin, leiset lailunga huhhingna na tongji chu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangin nahatna-in twikhanglen chu nalheh khennin, nangin twilah-a Dragonho lu nasukeh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangin Leviathan luchang ahal halin navochip in, amachu gamthipma cheng miho anchah din napen ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangin twinah le twisoh nahom khenin, vadunglen ho jongchu nasukangin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sunhi nanga ahin, jan jong nanga ahi; Nangin vah le nisa nanasemin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangin leiset gamgiho jouse nakoijin, nipi le phalbi nasemme.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo Pakai, melmate i-sah louna le, mingolin namin ataitom naohi geldoh jingin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Oh, navapal hinna chu migilou mipi henga pedoh hih-in, a-imatih-in namigenthei kikhom hohi sumil hih-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kitepna neija peh-in, ajehchu leiset munthim laihohi engsetna adimin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />O, akibolgimho chu jachatnan kilesah hih-in, vaicha le lhasamhon namin vahchoi hen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vo Pathen, thouvin lang nathuhi seitoh-in, mingolin niseh-a iti nahouset nem geldoh jingin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Namelmate awgin chu sumil hih-in, nangma douna mipite husa chu tanglou helin akhang jingin ahi.
  </para>
  <chapter number="75" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangma kathangvah uve, Vo Pathen, nangma kathangvah uve, nathil kidang bolhon namin anaihi aphong doh-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phat kijenpet kalhendoh teng, dihtah-a thu katan ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Leisetle asunga cheng jouse ajunmang tan, keiman akhom chu dettah-in katungdoh tai. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Mingol ho henga chun ngolhoi tah-in umhih-un katin, migilou hengah naki domsang hih-in kati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Naki chu domsang hih-in, ngei pukonin thu seihih-in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu choisangna chu solama kon, lhumlama kon, ahiloule lhanglama kona jong hung hilou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Pathen chu thutan ahin; aman khat asotlhah-a chomkhat adopsangji ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Pakai khutna chun khon khat aumin, chule ju chu asan ahin; hichu akihalchop dimset ahin, hiche mama chu ahinsunglhan; ahinla leisetna migilouho jousen aning geija adon kanghel diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla kenvang a-imatih chanin phongdoh ingting, Jacob Pathen vahchoi La chu sange.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migilouho jouse ki kasuhlhuh ding, michonpha ho ki vang kichoisang ding ahi.
  </para>
  <chapter number="76" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah te lah a-Pathen chu hetnin aumin, Israelte lah-a amin chu aloupin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Salem'a jong ahou buh aumin, chule Zion'a achenna mun aumin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche mun'a chun aman thalpi thalchang ho, lumdal le chemjam, chule gal asubong gamin ahi. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma sadelna molsang ho sangin naloupin nachung nungjon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Milunglenho chu akisuse gamun, a-imut naova a-imulhu paijun; chule mihat ho koimachan akhut hou amujou tapouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Jacob Pathen, naphosalna jeh-in sakol kangtalai le sakol jong a-imu millhon tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang, nangmatah chu gindingtah nahin, chule nangma lunghan teng namitmu-a koiham ading theidinga?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangin nathutanna thu van'a konin najahsah-in, leiset akichan athip behtan,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen thutanlha dinga ahung kipat doh-a, leisetna gimbola um jouse ahuhdoh ding teng. Selah
  </para>
  <para style="p">
    <verse number="10" style="v" />Tahbeh-a mihem lunghanna chun nangma navahchoi ding, lunghanna amohchengse-a chu naki gah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai na Pathen nu henga kihahselun, chule peuvin; akimvella umjousen ginding dolpa henga chun kipaman hinchoijun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman pipuiho lhagao asuhmang ding; ama chu leiset lengho dinga kichat umtah ahi.
  </para>
  <chapter number="77" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka awn Pathen kakouve, ka aw-in Pathen ngei chu kakouvin, chule aman keilama ana asungin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kalung khamnin Pakai chu kaholin, kanatna kajanthoh lel-in, oltih kanei theipoi, kahinna jong lhepbi ding anompoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen kanageldoh-in, chuin kalungkhamin; kana kiphin in, chuin kalhagao lungdongin aumin ahi. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamit nahasah jingin, thusei theilou khopmin kalungkhame.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khangluilai thu, masanglai kumho chu kagah gelin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jana kalasah chu kageldoh kitnin, kalungsunga keile kei kakihouvin, kalhagaovin gunchu tah-in aholin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin a-itih-a dinga aledoh dingham? chule akhohsahna chu umkit louhel ding hitam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahepina theng chu a-itih-a dinga kichai hitam? Athutep chu atonsotna dinga thonna hitam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen'in lungsetna aneiding chu asuhmil hitam? ahepina lainatna chu alunghanin akhachah hitam? Selah
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hichehi keima lhahsam ahi kanatin, ahinla chungnung pen khut jetlam kumho chu geljinging kate.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai thilbolho chu kageldoh ding ahi; khanglui laija nathilbol kidangho chu geldoh tahbeh ingkate.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanatoh ho jouse jong ngaito ingting, nathilbol ho houlimnan neijinge.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Pathen, nalampi chu munthenga aumin; i-Pathen banguva lentah Pathen koiham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangma thil kidangho bolji Pathen chu nahin nangman nathahat mitin lah-a naphong doh-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nabanin namite, Jacob le Joseph chate chu nalhatdohtan ahi. Selah
  </para>
  <para style="p">
    <verse number="16" style="v" />Twiho chun namutaove, vo Pathen, twiho chun namutaove; amaho akichauvin, twi thuhho jong aki tihotsoh taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Meilhang hon twi ahinlha lha uvin, vanthamjol hon aw ahinsodoh-un, nathalchangho aleng lahlah jenge.
  </para>
  <para style="p">
    <verse number="18" style="v" />Navan ginchu van'a akithong lhungin, kolphen vannoi asalvah soh-in, leiset akithingin, akihotnin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nalampi twikhanglen'a aumin, nalam lhah twilenho sunga um ahi, chule nakhonung ho het ahipoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangin namite kelngoi hon bangin, Mosi le Aaron khutna nanapuijin ahi.
  </para>
  <chapter number="78" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo kamite kadanthu-a hin nana hinsungun, kakamsung thuho-a hin na-nakhangu hinsung uvin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thulem seinan kam kangting, malai thu ki-im ho seidoh-ing kate.
  </para>
  <para style="p">
    <verse number="3" style="v" />Inajah uva inahetsao, ipateovin eina hil hou chu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hicheho chu achateuva henga i-im loudiu, khangthah hung umdingho henga Pakai vahchoinaho le athahatna chule thilkidang ana boldohho chu ihetsah diu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Jacob hengah photchetna aphutdoh-in, chule Israelte lah-a danthu atungdoh-in, hichu achateu ahetsah diuvin ipu ipateu thu apen ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutia chu khang hunglhung dingho, chate hungpeng dingho chun ahet diu; chutia chu amaho chu thoudoh uva achateu ahilson jing dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Akinepnao chu Pathen'a angapmuva, chule Pathen natohho chu sumil louva, amavang athupeh ajui nadiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Apateu louchal le golkeh khangmite, alungputnu janglou khangmite, alhagaovu Pathen'a detlouho bang ahilouna diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ephraim chaten galvon akivonun, chule thalpi akikenun, galsat nikhon akiheijun akinungle taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon Pathen thutep chu achingtup pouvin, adanthua chonding anompouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman avetsah anatohho le athilkidang bolho asumilgam taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Egypt gam Zoan munah apateu mitmun, Pathen'in datmo umtahtah thil anabolin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman twikhanglen ahom khenin, chuin amaho chu agalkaisah-in, chule twiho chu alhuh-in adinsah-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho chu sunle meilhangin apuijin, janle meikongin apuilejin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gamthipma songpiho chu akhitkeh sah-in, chule thuhtah-a kon hungdoh bangin amaho donding twi apen ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman songpi-a konchun luiho alondohsah-in, vadungho bangin twiho alonlhah sah-e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule gamthipma chun chungnung pen phinsetnan achonset bebe nalaijun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amahon atahsao ngaichat an thumnan alungthimun Pathen apatepmun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Henge, amahon Pathen douna thu aseijun, gamthip mahi Pathen'in dokhang adothei dingham? atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Veuvin, aman songpi avon, twiho ahung kikhodoh-in, vachadung chu along letset tan; changlhah jong apetheidem? amitedin sa ape theidem?
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun Pakaiyin hichu ajan, chuin alunghangin; Jacob dounan mei akongdoh-in, Israel dounan jong lunghanna ahung kongdoh-e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathen atahsan lou jeh-u le, ahuhhingna atahsan loujeh-u ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman chunga kona meilhang ho thu apeh-a, van kot ho ahonjeng vangin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule aneh diuvin mana achunguva alhahsah-in, van an chu amaho anapen ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihemin vantil ho an aneuvin, amaho avaset nadiuvin an anapen ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman solam hui chu van'a anunsah-in, chule athaneina-in lhanglam hui ahin puilutne.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sa chu leivui jat bangin achunguva ajuhsah-in, vacha lhaving nei chu twikhanglen'a neldi jat tobang ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule achennao kimvel, agebuhhou lailunga alhahsah-in ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hitichun aneuvin, avasetnui; ajehchu mahon angaichat uchu ape ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amaho ngaichatna toh akikhendeh pouvin, akamuva asaneh-u aumpetlai chun,
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathen lunghanna achunguva achun, amaho lah-a athaopenho chu athatnin, Israel pasal lhendoh ho chu asumangtan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu chuche geijong chun achonse jing nalaijun, chule athil kidang bol ho jong atahsan pouve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh chun akumhou mohseh-in, chule anikhohou lungkham na-in asuhbei pehtan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman amaho atha phatnin amahon ahinholun, chule ahung kileuvin Pathen chu ahol loi uvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule amahon Pathen chu asongpiule, Pathen chungnung chu alhatdohpau ahi ahingeldoh uvin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahivangin akamuvin ama apahcha lhemun, chule aleijun amachu ajoulhep jiuvin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ajehchu alungu ama lama aum pon, chujongle akitepna-a chun jong alungdet pouvin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hijongle ama lungsetna dimset ahijeh-in, akhan gitlounao angaidamin, chule asumang pouve; henge, vel tamtah alunghana aheimangjin, alunghana jouse asodoh pon ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ajehchu tahsaphe bou ahiu ageldoh-in, khohui anunmanga hungkile kitlou ahiuchu ageldoh-in ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Gamthipma iti alunghansah jinguva, chule nelgama iti alung phatmosah jingu hitam!
  </para>
  <para style="p">
    <verse number="41" style="v" />Henge, akinung heijun Pathen alhemjiuvin, chule Israel mitheng pa chu asulung na-un ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amahon akhut ageldoh pouvin, melma-a kona alhatdohna nikho jong chu ageldohdeh pouvin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Egyp gama melchihna ho abola, chule Zoan phaija thil kidang iti abol hitam,
  </para>
  <para style="p">
    <verse number="44" style="v" />chule aman avadunghou thisan asosah-in, chule atuisoh hou chu adonthei tapouvin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Aman alah uva thousi jatchom chom asolin, hichun amaho anejouvun, chule uphoh chun amaho asumanguvin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Aman amuchi hou chu lungtol apen, chule atohgau chu khaokhopi ho apen ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Alengpi guihou gellin asusen, chule atheiba phunghou buhbangin asumangtan ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Aganchahou jong gelchang henga apen, chule akelngoihou keh nasatah henga chun apen ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Aman vantil engseho asolin, alungsatna kichat umtah, alunghana le lungthahna, chule thangtom nale gentheina chu achunguva achutan ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Alunghana lampi asem peh-in, ahinnao chu thina a konin akhendoh pon, ahinkhou chu hise apedoh jotai;
  </para>
  <para style="p">
    <verse number="51" style="v" />chule Ham Houbuh ho-a ahatnau chungnung pen, Egypt cha pengmasa jouse chu athatnin ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ahinla amite chu kelngoi banga chedoh dingin asemin, ganchahon bangin gamthipma chun alamkaijin ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chule akichat louna diuvin bitkeijin apuijin, ahinla amelmateu chu twikhanglen'in achupgam taovin ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chule aman muntheng gamgi gei, akhut jetlama anachoh molsang geijin, apuilhung tan ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Amasanguva Pathen hephalouho jong anodohpeh-in, chule agoulodin ahoppeh-in, Israel phungho aponbuh cheh uva achensahtai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Achuti vangin chungnung pen Pathen chu apatepmun, alunghansah uvin, aphotchetnaho achingtup pouvin ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Ahinla akinung heijun, apateu bangin tahsan umloutah-in akhangun, kitahlouna thalpi bangin akiheimang taovin ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hitichun amunsang houva alunghan nachu achoh thouvun, amilim semhouvin athangsetsah taove.
  </para>
  <para style="p">
    <verse number="59" style="v" />Pathen'in hichehi ajah phatnin alunghangin, Israelte chu akidah behsehtai:
  </para>
  <para style="p">
    <verse number="60" style="v" />chutichun aman Shiloh Houbuh, mihem ho lah-a akoi ponbuh chu adalha tan;
  </para>
  <para style="p">
    <verse number="61" style="v" />chuin aman athahatna chu sohchang din apedoh-in, chule aloupina chu melmate khutna apedoh tai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Amite chu chemjam'a loudin jong apedoh-in, chule agou lote chunga chun alunghangtai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Meikongin agollhanghou akavam gamin, chule anungah hou kichena himhima akipe tapouve.
  </para>
  <para style="p">
    <verse number="64" style="v" />Athempuhou chemjamin alouvun, ameithai houvin jong akapouve.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chujouvin Pakai chu mi a-ihmut na-a kona hungkhang bangin ahung khangdoh-in, chule lengpitwi jeh-a mihat tah khat hung kisen abangin ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Amelmate ale sat kitnin, kumkho-a i-sah louva umdingin akoitan ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Chulou jong chun Joseph houbuh chu adeitapon, Ephraim phung jong alheng tapoi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Ahivangin angailut Zion molsang, Juda phung chu alheng jotai.
  </para>
  <para style="p">
    <verse number="69" style="v" />Aman leiset a-imatih channa dinga atundoh bangin, amuntheng chu leng inpi sangtah ho bangin asadoh tan ahi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Aman asoh David chu, kelngoi honga konchun alheng dohtan ahi.
  </para>
  <para style="p">
    <verse number="71" style="v" />Anou tamtah kai kelngoipi ho juija konin, amite Jacob phungle agoulo Israelte vahdin apuitai.
  </para>
  <para style="p">
    <verse number="72" style="v" />Chutichun alungthim dihtah-in amaho chu avah-in, chule akhut themna-in amaho chu analamkaijin ahi.
  </para>
  <chapter number="79" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, nangma helouho nagoulona sunga ahung lutnun, na houin theng asuboh uvin, Jerusalem chu alhuh-in asetaove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amahon nasohte thilong chu chungleng vachate an dingin apeuvin, namithengte sa chu leija gamsaho apeuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Athisanu chu Jerusalem kimvela twi bangin alongin, chule avui dingu koimacha aumpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaheng kakomhou housetnin kaumun, kakimvel uvaho nuisatle totnop nabep kahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Itih channem, Pakai? Atonsotna nalunghang ding hitam? Nathangthipna chu mei banga kongding ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangma hephalou namho chung le, chule namin phapohlou lenggam ho chunga nalung hanna chu bunglha tan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu amahon Jacob chu abah gammun, achenna mun kamhelin alha taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Oh, masanglai kakhan gitlouna houchu geldoh hih-un, nahepinaho thahat chun neihoidoh loijun, ajehchu keiho hatah-a eikisu nemu ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo eihuh hinguva Pathen, namin loupina dingin neipanpi uvin, namin jal-in kachonsetnahou sungimin lang, neihuhdoh uvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ipidinga Pathen hephalouhon a-Pathenu hoibaham atidiuham? Sohte thisan kiso phulah na-in, kamitmuvin Pathen hephalouho lah-a hin amachu hetnin umhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Akihenho khoisatna chu na-angsung hung lhung hen, nathil bolthei natsat bangtah-in, thidinga gotsaho chu huhdoh-in;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule vo Pakai amahon nahouset nao chu, ajat sagin kaheng kakomte angsunga lethuh-in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuti chun namite keihole nahamhing lah-a kelngoiten, a-imatih chanin nangma thangvahna peuving ting, akhang akhangin napachat na musahjing taovinge.
  </para>
  <chapter number="80" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Israel kelngoi chinna chingpa, Joseph ganhon banga ana lamkaipa nangman, nana sungin, Cherubim ho kah-a chengpa nangma vah bangin vah doh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ephraim le Benjamin miho, chule Manasseh masanga nahatna chu hintildoh-in, chule hungin lang neihuh doh-un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pathen, neisemthah kitnunlang, namai vahsah-in, chutile huhhing-a kaum dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo janelho Pakai Pathen, itihchan namite taona douva nalunghang dingham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangin amaho chu mitlhi-a kisem changlhah-in navah-in, adon dingun tena lentah-in mitlhi napejin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangin kaheng kakomhou dingin kiphinna-in neisemun, chule kamelma teo lah-a nuisat kahitaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo janelho Pathen, neisemthah kitnunlang, namai vahsah-in, chutile huhhing-a kaum dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangin Egypt'a konin lengpigui khat nahinpon; Pathen hephalouho nanodoh-in, hichu naphut tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangin ama dingin mun nasem peh-in, ajung thuhtah-in nakikhosah-in, gam leiset alosohtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lhangho chu alimin akhusoh-in, chule hiche abahho chu cedar thing phatah abange.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abahkai hochu twipi geijin asolin, chule hiche abahho chu vadung lama asole.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ibola apal ho chu naphet lhah-a, chuche lampi jot chanin akilou hitam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Gamlah-a kon hungpotdoh ngalchangin asuse-in, chuleh gamlah-a gamsan anejou tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo janelho Pathen, katao ahi, hungkile kitnin, van'a konin hinvenlang, hiche lengpi guihi hinvilin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman nakhut jetna naphu lengpi leihi, chule nangma dinga dettah-a nasem abahchu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichehi meijin akihallhan akiphuh lhutan; namaiso-a phosal na-a amangthah taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nakhut chu najetlama mi, nangma dinga nahatsah mihem chapa chunga chun umhen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutichun nanga konin kinunghei tapouving ting; neisuhalun, chuteng keihon namin kakoudingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo janelho Pakai Pathen neisemthah kitnunlang, namai vahsah in, chutile huhhing-a kaum dingu ahi.
  </para>
  <chapter number="81" style="c" />
  <para style="p">
    <verse number="1" style="v" />Itha hatnao Pathen hengah gingtah-in la saovin, Jacob Pathen henga kipa aw thonsah-un,
  </para>
  <para style="p">
    <verse number="2" style="v" />vahchoi La saovinlang, khongcha tum gingun, selangdah ngeitoh, tumging toh tho uvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lhathah, kitepna phat, i-kutpi nikho houva sumkon mut uvin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Israelte dinga hichehi chondan kisem chu ahin, Jacob Pathen dinga dan chu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichehi Joseph chunga photchetsah na-a, Egypt gam sunga achedoh laija anasuhdet chu ahin, chu-a chun kahetlou paokhat kanajan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Alengkou chu pohgih-a konin kalahdohpeh in, akhut chu belho-a konin akihuhdoh tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lungkham nin neikouvin chule kahuh doh-e, keiman munthipma kithong lenglung ginin kahin donbutne, Maribah twija chun nangma kana patepme. Selah
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngaijuvin, vo kamite kapatep dingu nahiuve, vo Israel, kathu nangai uva ahile,
  </para>
  <para style="p">
    <verse number="9" style="v" />Nalah uva gamdangmi Pathen himhim umlou ding ahin, gamchom pathen himhim nahoulou dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keimahi Egypt gama kona napuidoh uva, tonsot Pakai na Pathen'u chu kahi; Nakam kalen uvin chule keiman kadipdim ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla kamiten ka aw angaipouvin, chule Israelte khatchan eideipouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun alung ngaichat nao lama kapedoh-in, chule amahotah kithumop dungjuijin achontauve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ohe, kamiten kathu ngaijuhen, chule Israel hi kalampi ho-a che hitavele!
  </para>
  <para style="p">
    <verse number="14" style="v" />Agalteu kasot kun loija, chule akidoupiteu chunga kakhut kanalap ding ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai hotbolte chu ahenga kipelut chehdiu; ahivanga aphatnu chu a-imatih channa umjing ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman suhlou chang tuipena amaho avahding; chule keiman songpi-a kon khoijua chu nangma ka lunglhaisah ding nahi.
  </para>
  <chapter number="82" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen chu thaneitah houkhom ho lah-a chun adingin, pathen ho lah-a thu atantai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Itihchan dihlou tah-a thu natan uva, chule migilouho chunga langneina nanei dingu ham? Selah
  </para>
  <para style="p">
    <verse number="3" style="v" />Vaichate le pabeite chu hongbitnun, bolgenthei thohho le lhasamte henga adih chu bolun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vaichate le ngaichate chu huhdoh-un, migiloupa khutna konin amaho chu lhadoh-un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon ahepouvin chujongle hetkhen themna jong aneipouve; muthima vahle jing ahiuvin, leiset bulho jouse akilongtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho pathenho nahiuvin, chule nabon uva chungnung pen chate nahiuve, kanatin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla mihem banga nathiuva, chule pipuiho khat banga nalhuh dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pathen thouvin lang leiset thuhi tanin, ajehchu namjouse hi nalo ding ahi.
  </para>
  <chapter number="83" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, paolouvin umdan lang, thip beh-in umhih beh hih-in, chule vo Pathen umthim hihbeh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu vetan, namelma ten thunoh aboluvin, chule nangma hotbolte akiletsah-un ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Namite dounan amahon lungthim phalou agelun, chule naselguhte dounan akihousom taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hungun namkhat ahinaova konin sumangu hitin, Israel minhi geldohkit louhel nadingin bolu hite, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu amaho lungkhat kisan akihoutoh-un, nangma dounan kiloikhomna akisem taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Edom le Ishmael mite houbuhho, Moab le Hagar mite,
  </para>
  <para style="p">
    <verse number="7" style="v" />Gebal la Ammon chule Amalek, Philistine te le Tyre'a chengho toh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Assur jong amahotoh apangkhom taovin, amahon Lot chate akithopiuvin ahi. Selah
  </para>
  <para style="p">
    <verse number="9" style="v" />Midian ho nabolna bang, Sisera nabolna bangin amaho chu bolin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho Endor'a amangthah taovin; leisetna din eh tobang ahitaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amilen hou chu Oreb le Zeeb bangin bolin; henge, apiputeu jong Zebah le Zalmunna bangin bolin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen inho chu eiho chan dingin kilah uhite, atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo ka Pathen amaho chu chimpei bangle, khohui masanga changpol bangin semin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meijin gammang akah bangle, molsangho mei kihal deujeju bangin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun nahuipi chun sugen theijin lang, nahuipi le gopi achun kichatsah-in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo Pakai namin aholna diuvin, amaiju jachatnan dipmin.
  </para>
  <para style="p">
    <verse number="17" style="v" />A-itih-in jahchale lungdongin umsah-in, henge, jahchao henlang mangthah jengu uhen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutia chu mihem ten, nangma bouseh Jehovah minpu, leiset pumpi-a chunga chungnung pen nahi ti ahethei diu ahi.
  </para>
  <chapter number="84" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo janel Pakai, na houbuh hochu iti ngaichat umtam!
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahinna hin alhangai jin, henge, Pakai inpi indan ngaijin kalhasam heltan, kalungthim le katahsa hi hingjing Pathen henga akapme.
  </para>
  <para style="p">
    <verse number="3" style="v" />Henge, vasoh injong in akimun, chule pelpan jong anou akoina dingin amading bu aneije; Vo janel ho Pakai, kalengpale ka Pathen hichu namaicham ho ngei chu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma in'a chengho chu anunnom ahiuve, amahon navahchoi jing taovinte. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanga hatna neipa chu anunnomin, alungthimu gamtheng jotna dinga pedoh hochu anunnome.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon Baca phaicham ajot lhungun, twikul asemun, gotwi jong chun twikhuh hochu adip dime.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho hat cheh, hatcheh-in acheuvin, Zion'a Pathen anga chun amichang cheh-in akilah-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai Janel Pathen, kataona ngaijin lang, Jacob Pathen, nana hinsungin. Selah
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo kalumdal'u Pathen, vetemin, nathaonu mai hi hinven.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nahong sunga chun nikhat chu kum sangkhat sangin aphajon; gitlouna pon buho-a chensangin, ka Pathen in kotngah-a pan kanomjoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Pakai Pathen chu nisale lumdal ahin, Pakai chun lungsetna le loupina apeh ding, thildih'a chonteho-a dingin thilpha himhim it ponte.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo janelho Pakai, nangma tahsana michu anunnom ahi.
  </para>
  <chapter number="85" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai nagam chunga lungsetna naneijin; sohchanga Jacob chu nahin lepui kittan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin namite khan gitlouna nangaidamin, achonsetnao jouse namelkhutan ahi. Selah
  </para>
  <para style="p">
    <verse number="3" style="v" />Nalunghanna jouse naladoh-in, nalungsat gimneitah chu nakihei mang khumtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo eihuh hingpao Pathen, neilehei jinlang, kachunguva nalunghan bangtan.
  </para>
  <para style="p">
    <verse number="5" style="v" />A-imatih channa kachunguva nalung hanjing ding ham? Nalunghan chu khangjousea naso dohsah jing ding hitam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman namite kakipana diuva, neisuhhal kit loudiu ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai nahepina chu neimusah unlang, nahuhhingna chu neipeuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai Pathen'in ahin thusei ding chu ngaijing kate, ajehchu amite le amithengte henga chamna thu aseiding ahin; ahinla amaho ngolna lama kiheikit daohen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Adihtah-in igam uva loupina aumtheina dingin, ami huhhing na chu ama gingte henga ahungnaijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hepina le thutah akimuto lhonin, chonphatna le chamna akichopto lhone.
  </para>
  <para style="p">
    <verse number="11" style="v" />Leisetna konin thutah kehdoh intin, chule chonphat na-in van'a kona ahinvet suh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Henge, Pakai chun thilpha chu hinpentin, chule igamuhin aga ahin punsah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chonphatna chu amasanga chentin, chule akholhahna lampia eichesah diu ahi.
  </para>
  <chapter number="86" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai nana hin sung inlang neingaipeh-in, ajehchu keima vaicha le lhasam kahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahinna hi neikheh peh-in, ajeh chu keima atheng kahi; vo ka Pathen, nangma tahsana nasohhi huhhingin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pakai neihepin, ajehchu niseh-in nangma kakoujinge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nasoh hinkhohi kipasah-in; ajehchu vo Pakai, nangma-a kahinna kapedoh-e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Pakai nangma naphan, ngaidam dinga kigojing nahin, nangma nakoute jouse chunga hepina dimset nahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Pakai kataona-a hin nana hinsungin, chule kathumna awcheng hi ngaiphan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kalungjina nikho leh nangma kakou ding nahi; ajehchu nangman neidonbut ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai pathen ho lah-a nangtobang khatcha aumpon; chujongle nathilbol tobang bola jong khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pakai nasemsa nam jouse chu hungintin, na-anga chibai aboh uva, namin achoi-at diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nangma naloupin, thil kidangtah naboljin; Nangseh bou Pathen nahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai, nalampi neihilin, na thutah-a chon inge, namin kagin theina ding lungthim pumkhat neipen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pakai ka Pathen, kalung pumpin nangma vahchoi jing ting; chule a-imatih chana namin kachoi-at jing ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu nahepina keidingin alenin; chule kahinna hi thikholkhul noinung penna konin nahuhdoh tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo Pathen, keima dounan mi kiletsahho akipanun, pumhat manga mipi kikhom mihon kahina aholun, chule amasanguva nangma nakoipouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla vo Pakai, nangma lainatpina le lungsetna, thoh hat, thutah, chule hepina dimset Pathen chu nahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />O, kahenga hungkiheijin lang neihin hepin, nasohhi nahatna penlang, nasohnu chapahi huhhingin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aphatna dingin melchihna neimusah-in, chutile eihot bolten hichu muvintin, chule jahcha taovinte; ajehchu Pakai nangman neina kithopin chule neina lhamonin ahi.
  </para>
  <chapter number="87" style="c" />
  <para style="p">
    <verse number="1" style="v" />Akibulphuna chu moltheng ho-a aumin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai chun Jacob chennaho jouse sangin, Zion kotpiho chu angailujoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pathen khopi, nachung chang thu loupitah-in akiseitai. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima eiheho henga Rehab le Babylon phapoh inge, Philistine le Tyre toh Ethiopia khu veuvin, hichepahi chua chu penga ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Zion chungchang thu hitia kiseiding ahi; hiche mipa le khuche mipa chu amanu-a peng ahin, chule chungnung penin amanu chu atun dohding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai chun mipi ho min chu asutdoh tengle, hiche mipahi chua chu peng ahi, tia asut ding ahi. Selah
  </para>
  <para style="p">
    <verse number="7" style="v" />Lasathemho le tumging themho chua umdiu, katwisam jouse chu nanga um ahi, ati dingu ahi.
  </para>
  <chapter number="88" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo eihuh hinga Pakai Pathen, sunle jannin na-anga kanataovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kataona na-angsunga hunglhung hen; kapenna-a hin nana hinsungin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu kahinnahi lungkham nan adimin; chule kahinkho hin lhan khuh lam anaitan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kokhuh sunga kumlha ho toh eikisimtha tan, thabei hel mitoh kabangtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangin nageldoh kit tahlou, Mithilah-a ongthol, akithatsa lhana lum tobang kahin chule amaho nakhutna kona kisatlha ahitaove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kotong noinungpen, muthim lah, mun thutah-a chun neikoijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nalung hanna kachunga agihsan, chule natwi kinonghon eibol gentheitan ahi. Selah
  </para>
  <para style="p">
    <verse number="8" style="v" />Kamel het ho chu keija konin gamla tah-a nakoimangin, amaho henga thet umtah in neisemin, khakhumin kaumin, kapotdoh theipoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thohgimna jeh-in kamit athimtai, Pakai, nitinin nangma kakouvin, naheng lama kakhut kajah jingin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mithi henga thil kidangho namusah-a, mithiho hung thouva navahchoi diu ham? Selah
  </para>
  <para style="p">
    <verse number="11" style="v" />Vuikhuh-a chu nalungset ngailutna kiphonga, ahiloule tahsan naumna hi manthah na mun'a kiphong ding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Muthima chu na thilkidang ho kihe theija, chule na nachon phatna chu suhmilna-a dim gama kihe ding ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla vo Pakai, nahenga kap pumin kangeh-e, chule jingkah teng kataona chu naheng ahung lhunge.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai idia kahinna hi naledoh-a, idia keija kona namai nasel hitam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Kakhangdon apat kathohgimin athikoncha kahitai, kichat naum naho kathoh laijin, kapangjou him himpoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nalunghan gin umtah kachunga achun, kichat naum naho chun eisumang heltai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hicheho chu twibangin niseh-in kavela ahungun, amahon eiumchah soh taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngailut gol le paihola keija konin agamlatan, chule kamel hetho chu muthim lah-a aumtaovin ahi.
  </para>
  <chapter number="89" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai hepinaho chu a-imatih chanin lan sangting; kakamin tahsan aumje khangjouse-a hetsah inge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu hepinahi a-imatih chana dinga kisadoh ding, nakitahna chu vanmun jouse-a naphudet ding ahi, kanatin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman kamilhen chutoh kitepna kasemin, kasoh David henga kaki hahsel in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Nachilhah a-imatih chana dingin phutdoh ingting, chule nalaltouna chu khangjousea dinga katundoh ding ahi. Selah
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule vo Pakai vanhon nathil kidang bolho avahchoi ding; nakitahna jong mitheng kikhomho lah-a umtante.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Pakai toh tepithei van'a koi uma? Mihat chapate lah-a Pakai kibahpi thei koi umjou ding ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Mithengte kikhopna sunga Pakai chu sangtah-a ginding, chule akimvelaho jouse lah-a jana sangpen peh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo janelho Pakai Pathen, nang tobang Pakai hat koiham? ahiloule nakimvelaho lah-a nakitahna phading koi umam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Twikhanglen chunga vai nahomin, hichu ahung kinon teng nasuthip jin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi khat kithat bangin, nangman Rahab chu ahal halin nasuchipmin, namelmate chu naban thahatnin nathe cheh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vanho nanga ahin, leiset jong nanga ahi; vannoi le asunga um jouse hi nangma phudoh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangin sahlam le lhanglam nasemin, Tabor le Hermon namina kipah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangin ban thahat tah naneijin, nakhut chu thahatna ahin, chule nakhut jetlam chu choi-atna achangin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chonphatna le thudih chu nalaltouna kibulphuna ahin; hepinale thutah chu namasangah aumin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kipana hethema mite chu anunnom ahiuve! O Pakai, amaho namaivah-a vahle diu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaho namina nilhum keija kipah diu; chule nachon phatna-a amaho choisanga umdiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu nangma athahatnao loupina nahin; chule naphatna jeh-a ka ki'u choisanga umding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu Pakai chu ihoidoh nao ahin, chule Israel mithengpa chu ilengpao ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin gaovin namitheng khat henga thu naseijin: mihat tah khat chunga panpina kangamin, milah-a kona kilhengdoh khat kachoi-an tai, nati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keiman kasoh David kamutan, kathaotheng chu ama kanutai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama-a chun kakhut hi thahatnin umintin, kabanin jong ama ahatsah ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Melman achunga hunam bolpontin, chujongle gitlouna chapan jong ama sugim ponte.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amaikohtah-a amelmate kavoh lhuh-a, chule ama hote chu kasuhgim ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amavang kakitahna le kahepinan ama aumpi ding; chule kamina aki chu choisanga umding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Akhut twikhanglen chunga kangapsah ding, chule akhut jetlam chu vadunglen hochunga kangapsah ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman kahenga, nangma kapa, ka Pathen, chule eihuhhing songpi nahi tia kikou ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kenjong ama kachapa masapenle, leiset lengho sanga chungnung jo-a kasem ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kahepinan atonsotnin kivoppintin, kakitepna-in ama dettah-a adinpi jingding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Achilhah jong atonsotna umdinga kasemding; alaltouna vangam nikhoho banga kasem ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Achate chun kadanthu apallhah uva, chule kathutan lhah banga achon lou uleh,
  </para>
  <para style="p">
    <verse number="31" style="v" />Amahon kadan kisemho asuhkeh uva, chule kathupeh ho anitlou-uleh,
  </para>
  <para style="p">
    <verse number="32" style="v" />Chutengle asuhkhelnau jeh-a mola kajep ding, chule akhan gitlounao jeh-a jepna-a kajep ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeng jongle ama-a konin kalungset ngailutna hi ladoh soh hel pongting, tahsan kaumna hi thonsah ponge.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kakitepna chu sukehpongting, chujongle kakamsunga sohsa jong khelkit ponge.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kathenna-a khatvei kaki hahselsa ahin, David henga jouponge.
  </para>
  <para style="p">
    <verse number="36" style="v" />Achilhah a-imatih chana umjing ding, chule alaltouna ka-anga nisa banga umding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hichu a-itih-a lha banga kiphutdoh ding, chule van'a hettohsah tahsan umtah banga kiphutdoh ding ahi. Selah
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahinla nangman napaidoh-in nakidah tan, nathaonu chunga chun nalunghangtan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nangman nasohpa kitepna chu imalouvin nabolin, alal lukhuh tolla naseplhan, nasuhminset pehtan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nangin apaljouse navoh lhuhpeh-in, akulpidet chu manghel-in nalhatai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuche lam hopa jousen amachu achom mun, a-inhengho-a dingin i-sah louvin aumtan ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nangman akidoupiho banjetlam chu nahatsah-in, amelmate jouse chu nakipa sahtan ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangman achemjam ha jong nalehei peh-in, chule galmuna chun nadindet sah tapoi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nangin aloupina nasutangin, chule alaltouna tolla naseplhatai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nangin akhangdonlai nikhoho nasuchomin, jachatna-in nakhutai. Selah
  </para>
  <para style="p">
    <verse number="46" style="v" />Pakai itih chanem? tonsotna nakisel mang ding hitam? nalung hanna chu meibanga kongding ham?
  </para>
  <para style="p">
    <verse number="47" style="v" />Kaphat hi ichana choma ham geltemin, ipidinga mijousehi panabeija nasemham?
  </para>
  <para style="p">
    <verse number="48" style="v" />Thina mulouva hingjing dinga mi koi umam? aman lhankhuh-a konin ahinna kihuhdoh thei jintem? Selah
  </para>
  <para style="p">
    <verse number="49" style="v" />Pakai malaija nalungset ngailutna, David henga nakitah na-a naki hahselna chu hoiba hitam?
  </para>
  <para style="p">
    <verse number="50" style="v" />Pakai nasohte kihouset nahi hingeldoh temin, mijouse housetna chu ka-anga kapoh hi geltemin;
  </para>
  <para style="p">
    <verse number="51" style="v" />Vo Pakai namelma ten anoisenao, nathaonupa kholhahna chana ataitom naohi geltemin.
  </para>
  <para style="p">
    <verse number="52" style="v" />Pakai chu atonsot atonsotnin nunnom tahen. Amen, chule Amen.
  </para>
  <chapter number="90" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai nangma khangjousea kachennao mun nahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Molsangho jouse kitundoh masang, leiset le vannoi jeng jong nasuhto masanga, tonsotna kipat tonsotgeija nangma Pathen nahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangin mihem chu manthah na-a nakilesah-in, nangho mihem chate kileuvin natin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nangma mitmun kum sangkhat jonghi akichai tengleh janhi bangbep ahijin, chule janna khongah ho phat dankhat bepbou ahijie.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangin twisoh bangin amaho nalhoh mangjin, a-ihmu bangbep ahiuvin; jingkah-a hampa khangdoh bangbep ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jingkahteng adon doh-in akhangtoujin, nilhah lamle akisatlhan agopjitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu nalungsat na-a suhmang kahiuvin, chule nalunghanna-a kalung khamun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kakhan gitlounao namasanga nakoijin, guhthima kachonsetnao namai vah-a natah langin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu kanikho hou jouse nalunghannan achemang gamtan; kakumhou jong thusim kiseibangin kamangtaovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kahin kumho nikho hou chu kum somsagi, chule atha hat ho chu kum somget jong ahitheije; hijongle ahatnau chu tohgimna le lungkhamna bou ahin, akisatlha loijin kalengmangji taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nalungsat thaneina he-a koiham? nangma gin naum bangtah ngeijin nalunghan jong chuti chu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun kalungthimu hi chihna-a kaman theina diuvin, kanikho hou simje neihilun.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hung kiheijin, vo Pakai itih chan em? chule nasohte chungchanga nalung hin heitan.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kahin laiseuva kakipauva kathanopna diuvin, O nahepinan neilunglhai sah loijun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Neisuh gentheinao nikhoho sungle, thilse kamu-u kumho sung dungjuijin neikipa sah-un.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nanatoh chu nasohte henga, chule naloupina chu achateu henga kilanghen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Pakai ka Pathen'u hoina chu kachunguva umhen, chule kakhutsoh-u natoh chu kachunguva tung doh-in, henge, kakhutsoh-u natoh chu tung doh-in.
  </para>
  <chapter number="91" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chungnung pen munthip mun'a chenga chu, hatchung nungpen dailim noija umding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman Pakai chu, kakiselna le kakulpi ahin, ka Pathen chule ama katahsan ding pa ahi, ting kate.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahbeh-in aman thangkampa thanga kon, chule hise phalou tah-a konin nahuhdoh-inte.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman amulho in nahui jintin, chule alhavingho noi natahsan ding, akitahna chu nalumdal le napho hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Janteng tijatna kicha tapon natin, chule suna thalchang hung lengji jong,
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahilou jongle muthima hise lang, chule sunlaija manthah na hungleng jong kicha tapon nate.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nasihlama sangkhat lhu-a, chule najetlama sangsom lhuding, ahinla hichun nahin nai ponte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Migilou kilethuhna chu namit sehseh-a navetna namu ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu nangman kakiselna Pakai, chungnung pen chu, nangma chennan naseme.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thilphalou himhimin nalhun khum pontin, hise himhimin jong nachenna hinnai ponte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu nalampi jouse-a nachingtup dinga, aman avantilte nangma chunga mopo dinga thu apeh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Songa nakeng nakisuh louna dinga, amahon akhutnuva nadop dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keipi bahkai le gulsum chung nachot ding, keipi gollai le dragon chu nakengto noija nachilding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu angailutna kachunga akoijeh-in amachu huhdoh ingting; kamin ahetjeh-a mun sanga kakoiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman eikou ding, keiman kadonbut ding; lungkham na-a kaumpia, kahuh doh-a, jabolna kachansah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinkho saona-in lunglhaisah ingting, kahuh hingna chu kamusah ding ahi.
  </para>
  <chapter number="92" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo chungnung pen, namin vahchoi La sah-a, Pakai henga thangvahna peh hi thilpha ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jingkah-a nalungset ngailutna, chule janseh-a nakitahna musah dingin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Manchah jang som nei toh, tumging leh, selangdah gin ngeija nangma vahchoihi thilpha ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakai nangin nathilbolla neikipasah ahin; nakhutsoh thilbolho-a jona la sange.
  </para>
  <para style="p">
    <verse number="5" style="v" />O Pakai nanatoh ho iti loupia hitam! chule nalunggel ho athuh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Milungsel hon hichu ahethei pouvin, mingolin jong hichu ahethem theipoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migilouho hampa banga ahung kedoh-a, khan gitlou bolho jouse aphat thei tengule, tonsot geija suhmanga umding ahitaove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Pakai, nangma vang tonsotna chungnung pen nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu, vo Pakai, namel mate khu vetan, ajehchu ven, namelmate khu mangthah untin, khan gitlou bolho jouse kithecheh diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla ka-ki hi sakol kinei banga nachoisang ding; keima thaotwi thah eikinuding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kamit hin kamel mate chunga angaichat chu muntin, chule kanakhang hin keima douna-a kipan khangitlou bolho ngaichat chu ajahding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Michonpha chu tum phung banga khangtou ding; Lebanon lhanga Cedar thing banga khangtou ding ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai in'a kiphut hochu i-Pathen'u hong sunga khangtou diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho atehgeijuva jong ga jinguva, amaho chu thao uva khang toudiu;
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai chu chondih ahi avetsah diu, ama chu kasongpi ahin, chule ama-a chun chonphat louna himhim umpoi.
  </para>
  <chapter number="93" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chun lengvai apon, ama loupina-in akivonin, Pakai chu thahat na-in akivonin, hiche-a chun aman atai akigah-e; leiset jonghi akilin louhelna dingin akitung detnin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nalal touna chu malaija kiphut doh-a ahitan; nangma tonsotna umsa nahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pakai twisoh akinong sangin, twisoh akinong gingin, twisoh akinong lenin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Twi tamtah gin sangin Pakai chungnung chu ahatjon; henge, twikhanglen kinong hattah sangin ahatjon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nathu hetoh sahna chu adihlheh-in; Vo Pakai a-imatih chanin thenna chu nangma in ahunghitai.
  </para>
  <chapter number="94" style="c" />
  <para style="p">
    <verse number="1" style="v" />Phulahna neija, vo Pakai Pathen, phulahna neija vo Pathen, hung kiphong doh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leiset chung thutanpa, nangmatah kichoisangin lang, mikilet sahho lethuhna pen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai itihchan migilou hon, itihchan migilou hon ajodingu ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Itihchan thil hahsaho aseidingu ham? chule khangitlou bolte chu amaho le amaho kiletsah dingu ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pakai namite ahal hallin aheh goijun, nagouloho asugentheijuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon meithaile kholjin asat lih-un, chule pa neilouho athatnun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahijeng vangin amahon Pakai chun mupontin, Jacob Pathen'in jong ngaisah hih inte atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mipi lah-a milungselho, nanghon hekhenuvin, chule mingol ho, nangho itihle nachih dingu ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Kol sempa kho jalouva uma? Mit sempa kho mulouva umding ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen hephalouho gimbolpan, asuhdih louding ham? Mihem chihna hilpa chun, iti ahet da ding ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai chun mihem lunggel ho chu pannabei ahi ti ahenai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pakai nasehgimpa, nadanthu-a kona nahilpa chu anun nome;
  </para>
  <para style="p">
    <verse number="13" style="v" />migilou dinga kokhuh kilai kahse-a, akidoupi ho nikho-a kona nacholnga sah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Pakaiyin amite paimang hel pontin, chule agoulo mite chu adalhah lou ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla thutanlhahna chu chonphatna-a hung kilentin, chule lungdihpu jousen hichu ajuidiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thilse bolho eidoupeh dinga koi kipatdoh-a, ahiloule khanset bolho eidoupeh dinga koi dingdoh dingham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai chu eipanpi anahilou hileh, kahinna hi thipbeh-a ana umding ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kakeng kalho nale katichun, vo Pakai nahepina-in nei natuh-e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kasunga lungkhamna tamtah kaneilai chun, nalhamona-in kahinna akipasah-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Danthu-a phatlouna semdohji khan gitlouna laltouna chun, nangma toh kiloikhomna neijin tem?
  </para>
  <para style="p">
    <verse number="21" style="v" />Michonpha hinna douna-in akikhom khomun, monabei thisan chu themo achanuvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amavang Pakai chu eihong bitna ahin, chuleh ka Pathen chu kakiselna songpi ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule aman akhan gitlounao chu amahotah chunga alhutna, chule agitlou naova chu asuh manghel diu ahi: henge, Pakai i-Pathen'un asuh manghel diu ahi.
  </para>
  <chapter number="95" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hungun, Pakai henga la saote, eihuh hingpao songpi henga kipana awthong tah-in samu hite.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thangvah tothon a-angsunga hungu hitin, kipana aw thongin la saohite.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pakai chu Pathen lentah ahin, pathen jouse chunga leng lenpen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Leiset mun thuhtah ho chu akhutna um ahin, lhangho thaneina jong ama-a ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Twipihi ama-a ahin chule asemsa ahin; chule tolgo chu akhutna asuhtoh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />O hunguvin, ama houvin kun-u hitin; eisempao Pakai anga dilsu-u hite.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama i-Pathen'u ahin, eiho aganlhatna mun'a amitele akhutna kelngoite ihiuve. Tunia a-awgin najah uva ahile;
  </para>
  <para style="p">
    <verse number="8" style="v" />Lunghansahna-a bangle, gamthipma kipatep ni-a bang chun nalungu tahsah hih-un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichelai chun napu napateu vin eipatepmun, eiphochenun, kathilbolho amutaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kum somli jen hiche nam mite chunga kana lungkhamin, alungthim uva lungdihlou gela mite ahiuvin, kalampi ahepouve, kanatin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun amaho kacholngah na-a lutloudiu ahi, tia kalunghan na-a kana hahsel ahitaove.
  </para>
  <chapter number="96" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiya lathah khat saovin, leiset pumpin Pakai henga la saovin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai henga la saovin, amin choi annun, ani anin ahuhhingna phongdoh-un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen hephalouho lah-a aloupi, mijouse lah-a thilkidang ho phongdoh-un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakai chu aloupi-in, loupitah-a vahchoi ding ahi; pathen jouse chungvuma ja ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu namtinho pathen jouse chu milim semthu ahin; ahinla Pakaiyin vanho asemin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amasanga janale lalna aumin, amuntheng sunga hatnale hoina aume.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo nangho phungtina miten Pakaiya peuvinlang, Pakai henga loupina le hatna peuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai chu achandia lom amin loupi chu peuvinlang, thilto hinchoijun lang, ahong sunga hunglut uvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />O, Pakai chu thenna le hoina-in houvun, leiset pumpi amasanga kichauvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen hephalouho lah-a chun Pakaiyin lengvai apoi tiuvin, vannoi leiset jong akilin louna dinga kiphutdet ding ahin, aman chonphatna-a mitin thu atanding ahi, tiuvin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vanho kipah uhen, leiset jong thanom hen, twipi le asunga umjouse aodoh uhen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Loujao le asunga um jouse kipah uhen, chuteng gammanga thingphung jouse jong Pakai masanga thanom diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu ama ahunge, amachu leiset thutan dinga hung ahi; aman vannoi chonphatna-a thu atanding chule mitin athudih na-a atanding ahi.
  </para>
  <chapter number="97" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin lengvai apotai, leiset thanom hen, twikol gamho jouse kipah uhen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meilhangle muthimin aumkimvelin; chonphatna le thutandih chu alaltouna kibulphuna ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amasanga meikong ache-in, chule akimvela amelmate akavamtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Akolphehon vannoi asalvah-in, leiset hin amun, akithing thinguve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Leiset pumpi Pakai anga, Pakai anga chun, lhangho chu khoilu bangin ajol lhan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vanhon achonphatna aphong doh-un, chule mijousen aloupina amuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Alim semthu jenjouse le milima kison na nejouse lungdonguhen, nangho pathen jousen, Ama houvun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zion'in ajan akipah-in, chule vo Pakai nathutanlhah jeh-in Judah chanute athanomuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Pakai, nangma leiset pumpi chunga chungnung pen nahin; pathen jouse chunga choisanga um nahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai ngailu-a nanghon thilse hotbolun, aman amithengte hinna akheh doh-in, amaho chu migilouho khutna konin ahuhdoh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Michonphate din kho ahungvah tan, milungdihho din kipana ahunglhung tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Michonpha ho Pakaiya kipah-un, chule athenna hetjingna-in ama-a thangvahna peuvin.
  </para>
  <chapter number="98" style="c" />
  <para style="p">
    <verse number="1" style="v" />Oh, Pakai vahchoinan lathah saovin, ajehchu aman thilkidang tah aboltai; akhut jetlam le abantheng chun jona achansah tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin ami huhhing na chu ahetsahtan; Pathen hephalouho mitmun achonphatna chu phongtah-in amusahtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel insung chunga amihepina le athutah chu ageldohtan; i-Pathen'u mihuhhing na chu leiset kolmong geija mijousen amusoh taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Leiset pumpin Pakaiya kipana aw thonsah-un, aw gingtah-in sam unlang, kipah-un, chule vahchoi La saovin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Selangdah tothon Pakaiya la saovin, selangdahle vahchoi awgin thouvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sumkon binei le pengkulto thon lengpa, Pakai anga chun kipana aw thonsah un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Twipi le asunga umjouse, vannoi leisetle asunga cheng jouse aodoh uhen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Twisoh hon akhutnu benguhen, lhangho jouse thakhatnin Pakai masanga kipah uhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu ama leiset thutanna hungding ahin; chonphatna a vannoi chule khanggilou mite thu atanding ahi.
  </para>
  <chapter number="99" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin lengvai apotai: Mitin kihot lhu hen, ama Cherub ho kah-a atouve; leiset kilinghen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai chu Zion'a aloupin, chule mijouse chunga chungnung pen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Namin loupile gimneitah chu vahchoi uhen, ijeh inem itile hichu atheng ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lengpa thahatna jongchun thutanlhahna angailun, nangin adih chu naphut doh-in, Jacob henga chonphat na-in thutanna naboldoh-e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon Pakai i-Pathen'u chu choi-an nun, chule akhophang bulla houvun; ijeh inem itile ama athengin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Athempuho lah-a Mosi le Aaron apangin, chule aman amina akouho lah-a Samuel apangin ahi; amahon Pakai akouvun, chule aman amaho chu adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Meibang khompi-a konin ahenguva thu anaseijin, ahettoh sahho le ahoudan thuho amaho anapeh chu achingtupmun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai ka Pathen nu, nangin amaho nana donbutnin; atohkhelnao chunga phu anala jongle chun, nangma amaho ngaidampa Pathen chu nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai i-Pathen'u chu choi-an nun, chule alhang thenga chun ama houvun, ajehchu Pakai i-Pathen'u chu athengin ahi.
  </para>
  <chapter number="100" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho gamjousen, Pakaiya kipa awgin thonsah-un,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kipahtah-in Pakai chu jennun, lasahto thon amasanga hunguvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon Pakai chu Pathen ahi ti heuvin, einasem uva chu ama ahin, eiho eiho-a tum ihipouve; eiho ama mitele ahamhing mun'a akelngoite chu ihiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thangvah pumin akotpi sunga lutnun, chule vahchoi pumin ahongsunga lutnuvin, ama thangvah unlang, amin vahchoijun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Pakai chu aphan, ahepina chu a-imatih chana umjing ahin; chule akitahna chu khangjouse geija umding ahi.
  </para>
  <chapter number="101" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hepinale thutanlhahna chu lan sange, Vo Pakai naheng-ah la sange.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chamkimna lampia chingthei tah-in chon ingting; O itihle kahenga nahung ding ham? ka-insunga lungthim phachamkim in choninge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thil gilou poupou kamitmun koiponge; vahkoiho thilbol chu kahon, hichu keija umlou ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lung gitlouna keija kona kiheimang ding; keiman khang gilou kahet louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aheng akom guhthima seise-a chu kasuhmang ding; mi kiletsah le hoitho lungpu chu kathohthei louding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keimatoh kachen khom theina dinguva, tahsan gamchu ngailutna mitna kavet ding; chamkimna lampia chepa chun, keima eijending ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lheplhahna thilbolla chu ka insunga chenglouding; jousei jong kamitmu-a umlou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thilgilou bolho jouse Pakai khopi-a kona kasuhmang theina dinga, gamsung migilouho jouse kasuhmang loiding ahi.
  </para>
  <chapter number="102" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai kataona ngaijin lang, kakouna naheng hunglhung hen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kalungkham nileh keija konin namai selmang danlang, keilam ngan nana hinsungin, nangma kakou nileh neidonbut loijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu kahin nikhoho hi meikhu bangin akitol mangin, chule kaguhohi thuhsunga mei bangin akan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalunghi agentheijin hampa bangin agolhatan, ka changlhah nehding kasuhmil lotan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kahimsat husa gin jeh-in, kaguho jong kavunna abehchah gamtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima gamthipma vamuhsao bang kahitan nelgama sumbupi bang kahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kahah jingin, intingvuma pelpa changlhat bangbep kahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kamelma ten eihouse nilhum jiuvin, chule kachunga kingolsah ho keima dounan akihahsel jiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu vut hi changlhah bangin kanejin, chule kadon ding chu ka-na toh kachoh haljin,
  </para>
  <para style="p">
    <verse number="10" style="v" />hichu nalung nopmo le nalunghan jeh ahi; ajehchu nangin neidom sangin chule neiseplhan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kanikhoho jong le-lim kiheimang bep ahin, chule hampa bangin kagopjitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla Vo Pakai nangvang a-imatih chana umding nahin, chule nangma khang jouse-a kigeldoh jingding nahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangma thouvinnatin, Zion chunga hepina nanei ding; ajehchu ama lungsetna phat, henge, phat kitepsa chu ahunglhung tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu nasohte amanu songho-a chun alunglhaijun, chule chua leivui chu akhohsah-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutia chu Pathen hephalouhon Pakai min chu agin diu, chule leiset lengho jousen naloupina chu agindiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakaiyin Zion asahdoh tengle, aloupi na-a hungkilah ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman milengvai ho taona angai ding, chule ataonao ngaisah louva akoi louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichehi khangkitna dinga kisun ding; chule ahung kisem ding miho chun Pakai chu avahchoidiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu aman amuntheng sanga konin ahin vesuh-in, Pakaiyin van'a konin leihi ahinmui;
  </para>
  <para style="p">
    <verse number="20" style="v" />Sohchangho himsatna ngaidingle, thidinga thu kitepsaho lhadohnadin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Zion'a Pakai min le Jerusalem'a ama pachatna chu phondohna dingin;
  </para>
  <para style="p">
    <verse number="22" style="v" />Lenggam ho le mitin Pakai jenna dinga akikhopkhom tenguleh, hichu hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman lamdunga kahatna asudoijin, kanikhoho asuchomin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Keiman, Vo ka Pathen, kahinna akimtuh in neilamang hih-in, nangma kumho chu khang jouse lhumkeija uma ahi, kati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Leiset bul kingapna chu malaija nakoisa ahitan, chule vanho jong nakhutsoh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amaho mangthah diu ahin, ahinla nangvang umjing ding nahi, henge, amaho ponlui banga sesohdiu, von banga nangin amaho nakhela, chutia chu amaho kikheldiu ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla nangvang angai nahi jingin, nakumin jong kichaitih aneilouding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nasohte chateho chu umjing uva, chule achilhahteu chu namasanga kitungdoh diu ahi.
  </para>
  <chapter number="103" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo kalhagao, Pakai chu choi-an nin, chule kasunga umjousen amintheng choi-an nun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo kalhagao Pakai chu choi-an nin, chule aphatchom naho jouse sumil hih-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nakhan gitlouna jouse ngaidama, nanatna jouse damsah-a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Nahinkho manthah na-a kona lhatdoh-a, ngailut phatna le hepina lal lukhuh banga nakhuh peh-a,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nakhang donlai muvanlai banga semthah ahina dinga, thilphaho-a nakamsung lunglhaisahpa chu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin chonphatna atah langin, suhgentheija umho jouse dingin thu adih-in atan peh-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman alampiho Mosi henga ahetsah-in, anatohho Israel chate ahetsah-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai chu hepina le lungsetna-a dim, lunghangvah lou chule ngailutna-a dimset ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman phatjousen eiho eiphohjing pouvintin; chujongle a-itih in alunghana chingjing ponte.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman ichonsetnao bangin eibol pouvin, chujongle ikhan gitlounao dungjuijin jong eilethuh pouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu leisanga van asan banga, ama gingte chunga ahepina chubanga chu lena ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Solam le lhumlam akigamlat banga, hichan gamla-a chu ikhan gitlounao eihoa kona achonmang ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mipan achate akhoto banga, Pakaiyin ama gingte akhoto ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu aman ikisuhto dannu ahen, eiho leivuibou ihiu aman ageldoh jingin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihem vang, anikhoho chu hampa bangbou; jaova pahcha bangbep bou ahin, hitichun ahung khangin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu huijin achung ahin mutle amang gamin, chule aumna mun chun ahepha ji tapoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla Pakai hepina chu ama gingte chunga atonsot atonsot geija umding, chule achonphatna jong achateu chateho geija;
  </para>
  <para style="p">
    <verse number="18" style="v" />Akitepna chingtupma, chule athupehho juidinga geldoh jingho chunga umding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakaiyin van ho-a alaltouna atungdoh-in, aleng gamin imajouse chunga vai apoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangho thahat chungnung nei, athupehho bola, a-thu ngaija avantil hon, Pakai chu vahchoijun.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangho ama janel ho, ama lhachaho, ama lunglhaina bolho jousen, Pakai chu vahchoijun.
  </para>
  <para style="p">
    <verse number="22" style="v" />A vaihomna muntina athilbolho jousen, Pakai vahchoijun. Vo kalhagao Pakai chu vahchoijin.
  </para>
  <chapter number="104" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo kahinna, Pakai chu vahchoijin. Vo Pakai ka Pathen, naloupi lheh jengin, janale loupina-in nakijeme.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vanho pondal banga kaijal pan, khovah chu ponsil bangin naki sile.
  </para>
  <para style="p">
    <verse number="3" style="v" />A-in danho-a inkamho chu twilah-a ajama, meilhang ho kangtalai jin akiseme, hui lhavingho chunga vahle pa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Avantilho lhagaoho sempa, alhachate jong meikong sosah jipa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma tonsotna akichon lounadinga, leiset bulho anaphut detpa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman hichu thutah-in ponsil bangin nakhu khumin, twiho chu molsangho vuma akiting uve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman naphoh-in ahile amaho ajamun, na van ginho-a amaho ajammang loiji taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho molsang ho-a akaltouvun, amaho dinga nagonpeh namun, phaicham ho-a chun achesuh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leiset chupdinga ahungkile louna diuvin, ahin khelthei loudiu gamgi nasempeh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman lhang ho-a twisam longho chu, phaicham lama asolin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hicheho chun gama saho jouse donding apeuvin; gam sangan dangchah hon dangnou nan aneijuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Apang chu chungleng vachaten chenna-in aneijun, thingbah holah-a chun la saove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman a-in danho-a konin lhangho achapnouvin, leiset hi nanatoh ga ho-a alunglhai uve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman leisetna kona nehding akondoh nadingin; ganchaho dingin hampa akedoh sah-in, chule mihem neh dingin anche akesah-in;
  </para>
  <para style="p">
    <verse number="15" style="v" />chule mihem lung kipasah lengpitwi, chule amaivahna ding thao, chule mihem lungthim hatsah-a changlhah jong ahinsodoh sah-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman Lebanon'a Cedar thing aphuho; Pakai thingphung ho chu twi akichap nou jinge;
  </para>
  <para style="p">
    <verse number="17" style="v" />Hia chun vachaten bu asaovin, twiva dingin vang chahthinglah chu a-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lhangsang ho chu gamkelcha ho ding ahin, jupi ho dingin songpiho chu kiselna ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Phatbih hetnading lhathah aumsah-in, nisan alhum phat akihetne.
  </para>
  <para style="p">
    <verse number="20" style="v" />Muthim nasemin hichu jan ahin, hia chun gammanga sajouse ahung kitholdoh jiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keipi donglaihon asamat dingu akitum khumun, Pathen'a konin anehdiu akiholuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nisa asoteng akikhom khomun, akulsung cheh uva akolji taove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Miho chu natong dingin akon doh-un, nilhah kahsen na atong jiuvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vo Pakai nathilsem hohi iti tamma tam hitam! abonchauva chihna-a nasem ahin, leiset hi nahaona-a dimset ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutia chu hiche twikhanglen lentahle jaotah hi uma, asunga akithol thoho simjoulou uma, ganhing alen le aneo agoma uma ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hia chun kong innei akitolin, chuche sunga kichem dinga nangin nasem Leviathan chu aume.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hicheho jousen aphatcha a-an'u napeh theinadin, nangahcheh uvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Napeh ho chu amahon akhom tupmun, nakhut najalin neh tuitah-in avaset uve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Namai naselin alungkham jiuvin, ahaitheinau na lahmang peh-in, athi jiuvin chule leivuijin akileji taove.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nalhagao nasoldoh-in amaho akisem doh jiuvin, chule leiset chunghi nasemthah kitjin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pakai loupina chu tonsotnin umintin, Pakai chu athil bolho-a kipahding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman leiset chung aven ahile akihot jengin; lhangho atongkhan ahile mei akhun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kahinlaisen Pakai henga la sangting, kahinpet nin ka Pathen vahchoi la sange.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama chung chang kangaito nahi ahenga lhumin tin, Pakaiya kipahding kahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Michonse ho chu leija konin suh mangin umhen, chule migilou ho umkit tahih uhen. Vo kahinna, Pakai chu choi-anin. Vahchoijun Pakai chu.
  </para>
  <chapter number="105" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai henga thangvahna peuvin! aminin taovun; mihemte lah-a athilbol hetsah-un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahenga la saovin, Ahenga vahchoi La saovin, athilkidang bol ho jouse thu kihoulimun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amintheng chu loupihen, Pakai holho lungsung kipahhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai le ahatna holunlang, tanglouvin amai chu holjingun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Akamsung thutan lhahho, athil kidangho, atohsa anatoh kidangho geldoh-un,
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo nangho Abraham chilhah asohte, alhentum nangho Jacob chaten sumil hih-un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amachu Pakai i-Pathen'u ahin, athutan lhahho chu leichung jouse-a aumme.
  </para>
  <para style="p">
    <verse number="8" style="v" />Atonsotnin akitepna ageldoh jingin, kum asang asang dinga aman anatep ahitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abraham toh asem kitepna, chule Isaac henga akitepna;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hiche mama chu Jacob dinga danthua din, Israel henga tonsot kitepna din asuhdetpehtan,
  </para>
  <para style="p">
    <verse number="11" style="v" />Kanaan gamchu nachan ding gouva nahenga kapeh ding ahi ati;
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaho lhomcha bou anahiuvin; henge, lhomcha khat le khopem mi anahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho nam khatna kona nam khatna, lenggam khatna kona midang henga achele laijun,
  </para>
  <para style="p">
    <verse number="14" style="v" />Koiman jouva aboldiu aphalpon, amaho jeh-in lengho aphohsaljin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Kathaonupa chu tongkha hih-un, chule kathemgao ho susehih-un, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Achung chonin chuche gama chun kel alhahsah-in; changkung jouse amanthahsah soh heltan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amasanguva mi khat asolmasan, sohdia kijoh-a Joseph chu ahin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Akengho chu bullin asunaovin, thihkul sunga ahenun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama thu aguilhun kahsen, Pakai thu chun ama apatepmin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lengpan mi asolin alhadoh-in, miho vaihompatah chun agalha dohtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman a-insung pakai jin apansah-in, chule aneijouse chunga vaihom din;
  </para>
  <para style="p">
    <verse number="22" style="v" />Pipuiho chu anop nopma kan dingle, vaihomho chihna hil din apansah tai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Israel jong chu Egypt'a ahungtan, Jacob chu Ham gama ahung jintan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman amite nasatah-in apunsah-in, amelmate sangin ahatsah jotai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Asohte doha thuhtah-a abolna dingun, aman alungu chu amite hotbol din aheimangpeh tai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman asoh Mosi, chule amilhen Aaron chu anasolin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanin amelchihnaho alah uva abol lhonin, chule thilkidang ho Ham gamsunga avetsah lhone.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman muthim asolin mu athimsahtan, chuin athu chu adou tapouvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman atwi hou thisan asosah-in, anga hou athat gamtai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Agamu chun uphoh tamtah ahin pendoh sah-in, leng teho indan sung geijin adimtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thu aseile thousi jatchom chom tamtah ahungun, chule kha jong agamkol sungu ahung dimtan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman amaho chu go khelin gel apen, chule agamuva meikou jengjung apen ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman alengpi guihoule atheichang phunghou jepna apen, agamkol sunguva thingphung ho amanthahsah gamheltai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman thu aseile khaokhoho ahunguvin, khaokho noute simjoulou ahungdoh uvin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin agamsung uva hampa louhing jouse anejouvun, aleisetnu theiga jouse anechai taovin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman agamsung uva athahatna jouse bulpi, apengmasa jouse jongchu asumang heltan ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman amaho sana le dangka pumin ahinpui doh-in, aphung sunguva chun achatmo khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amaho apotdoh uva chun Egypt akipah-e; ajehchu amaho kichatna chu achunguva chu-ah ahitai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Akhu diuvin meilhang apha jal-in, janteng asalvah diuvin meikong apen ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mipi hochun athumun, vengke ahinpen, van changlhah-in alungu alhaisah tai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Songpi ahonle, twi ahung kikhodoh-in, gamgo munho-a vadung lonin alongin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ajehchu aman athutep thengtah le, asoh Abraham chu ageldoh jing ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amite thanom tah-in ahin puidoh-in, chule amilhenho kipahtah-in apuidoh-e.
  </para>
  <para style="p">
    <verse number="44" style="v" />Aman Pathen hephalou te gam chu amaho apen; amahon chua miho tohdohsa chu alotauve;
  </para>
  <para style="p">
    <verse number="45" style="v" />Chutia chu amahon achondan kisemho ajuijuva, adan thupeh ho anit nadiuva apeh ahi. Pakai chu vahchoijun.
  </para>
  <chapter number="106" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijun. Oh, aphatna jeh-in Pakai chu thangvahna peuvin; ajehchu amihepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai natoh thahatna chu kon seithei jintem? Avahchoina jouse kon aphondoh jouding ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Thutandih tuhchah-a chule phat tinna chonphatna bolho chu anunnom ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />O Pakai, namite chunga nanei lungsetna-a chun neigeldoh jingin, O nahuhhing nan neivilin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutile nami lhentumte hamphatna kamuthei ding, namite kipana-a kathanop thei ding, nagou chan toh kaloupi ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kapu kapateu toh kana chonseuvin, kana khang gilouvun, kana khanse taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kapu kapa teuvin Egypt'a nathil kidangho ana hethei pouvin; nahepina tamtah chu ageldoh pouvin, amavang twipi le twipi san ngeija chun ama ana lungsat sah taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeng jongle athil boltheina loupitah chu hetdoh ahina din; amin jal-in amaho chu ana huhdoh-e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Twipisan jongchu apho-in ahile akang tan; chutichun amaho chu gamthip laija apui bangin, twi thuhtah-a chun apui galkai tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahotbolteu khutna konin ahuhdoh-in, melma khutna konin alhatdoh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuche twi chun amelmateu achupmin; khatcha asohcha aum pouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin athu chu atahsanun, ama vahchoi la asaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anatohho asumil loijun; athumop chu angah tapouvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Gamthipma chun tahsa ngaichatnin adimun, nelphaija chun Pathen apatep taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin athil thumu apen, ahivangin asunguvah gamna hise alansah in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amahon gebuh sunga Mosi, chule Pakai mitheng Aaron jong chu athangset taovin ahileh;
  </para>
  <para style="p">
    <verse number="17" style="v" />Leiset akhikeh-in Dathan aval lhumin, Abiram loiho akhukhum tai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aloi lah uva mei ahung kadoh-in, meikong chun migilouho chu akalihtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahon Horeb'a akilhajol bongnou lim asemun, alim semthu uchu ahou taove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutobang chun aloupinao chu bongchal hampane bangbepmin akhel taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Egypt'a thil loupitah tah bola Pathen, ahuhhingpao chu asumil taovin;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ham gama thilkidang tahtah le, twipisana kichat umtah bolpa chu asumil taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun mipi chu sumang khante tia alunghana heimang dinga alhentum Mosi chu amasanga chu akah uva ding louva hile, amaho chu sumang tange anati ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Henge, amahon gam nomtah chu i-sah louvin abulun, athu chu atahsan pouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin apon in sunguva aphunchel uvin, Pakai aw chu angai pouvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun gamthip laija amaho suhlhuhna dingin, amaho dounan akhut alam tan,
  </para>
  <para style="p">
    <verse number="27" style="v" />Achilhahteu jong namtin lah-a asuhlhuh nadingle, namtin lah-a athecheh nadinga akhut alap ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho Peor mun'a baal lama abeh-un, athiho dinga ganlhaina kibol chu anetaove.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutichun anatohho uva chun ama aphinseuvin, chule achunguva hise alengtai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chujouvin Phinehas adingdoh-in thu atantan; chuin hise chu atangtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hichu ama dingin a-imatih chana khang jouse-a dingin chonphatna-a sim ahitai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kinahna twiphunga jong chun alunghan sah-un, chutichun amaho jeh-in Mosi chunga thilse alhunlo helin;
  </para>
  <para style="p">
    <verse number="33" style="v" />Alhagao aphinset jeh-un, akamin thilsetah anaseitan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pakaiyin amaho thu apeh bangun, amahon namho chu anasumang pouve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahivangin Pathen hephalouho toh akihalun, athil bolhou chu ajil jotaovin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule amilimhou chu ajenun, hichu amaho dingin thang ahung hitai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Henge, amaho thilha henga achapateu le achanuteu chu ganlhai thilto dingin apedoh-un,
  </para>
  <para style="p">
    <verse number="38" style="v" />monabei thisan, achapateule achanuteu thisantah chu asouvin, hicheho-a chun Canaan milimho henga akilhaijun; chuche gam chu thisana suhboh-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chutichun anatohtah uchun akisuboh-un, athil boldoh uva chun noti'n apang taovin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hichejeh-a chu Pakai lung hanna chu amite chunga meikou banga anakou doh-a, chubang tah-a agoulote tah chu athet ahitai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin amaho chu Pathen hephalouho khutna apedoh-in, ahotbolteu chun achunguva vai ahomtai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amelmateu jongchun asugentheijun, akhut noijuva suhnemin aum taovin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amaho chu avel velin anahuhdoh-in, ahinla alung ngaitouvin alunghan sah-un, khangitlouna jeh-in suhnemin aumjiuve.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hijeng jongle aka-u ajah jiteng, ahesohnau akhohsah jin;
  </para>
  <para style="p">
    <verse number="45" style="v" />Akitepna chu amahodin ageldohjin, ahepina hao dungjuijin alung aheijitai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Sohchanga akaihou jouse jong chun amaho akhotosah-un ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />O Pakai ka Pathen'u, neihuhhing un, chule namin theng thangvah dingle navahchoi na-a galjou dingin, Pathen hephalouho lah-a konin neipui khom un.
  </para>
  <para style="p">
    <verse number="48" style="v" />Pakai Israel Pathen chu tonsotnapat tonsot geijin vahchoijin umhen: chule mijousen, Amen, tiuhen. Pakai chu vahchoijun.
  </para>
  <chapter number="107" style="c" />
  <para style="p">
    <verse number="1" style="v" />O aphatna jeh-in Pakai henga thangvahna peuvin, ajehchu ahepina a-imatih chanin aum jingin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Melmaho khutna kona alhatdoh, Pakai lhatdamsaten hitichun seijuhen;
  </para>
  <para style="p">
    <verse number="3" style="v" />chule gamtin solam le lhumlam, sahlam le lhanglama konin amaho kikhomuhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho gamthip mi chekhah louna lampia avahleuvin, chenna ding khopi khatcha amu pouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gilkel le dang chah-in, asunguva ahinnao alhasamtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuphatnin Pakai henga lungkhamin ataovun, aman ahesoh naova konin anahuhdoh tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi chenna khopi-a achetheina diuvin, lampi dih-a apuijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihemte hin mihem chate henga, aphatna jehle athil kidang bolho jeh hin Pakai chu vahchoi taveleu, o!
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu aman lhagao ngaichat alunglhai sahjin, lhagao gilkel an pha phan avahvajin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Muthim le thina le-lima touva, suhgentheina le thihkhaova kihenho chu,
  </para>
  <para style="p">
    <verse number="11" style="v" />ajehchu amahon Pathen thu douna-a gol akeh-un, chungnung pen thuhil anahsah pouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun alungu tohgimna-in ason kun-in, apanpidiu khatcha aumpon, alhasuh taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutengle lungkhamin Pakai henga apengun, aman ahesoh naova konin ahuhdoh jin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman muthima konle thina lima konin apuidoh in, chule akihen nahou chu asuchip jin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihemte hin mihem chate henga, aphatna jehle athil kidang bolho jeh hin Pakai chu vahchoi taveleu, o!
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu aman sum-eng kotpiho aphusen, thih banggolho asatkhen tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mingol ho chu asuhkhel nao jehle, akhanset jeh uvin suhgentheijin aumuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin naovin an jatjouse atheuvin, chule thina kotpiho lam chu anai jiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle lungkhamin Pakai henga apengun, aman ahesoh naova konin ahuhdoh jin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama thu asolin, amaho asudamjin, amanthah naova konin ahuhdoh jin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihemte hin mihem chate henga, aphatna jehle athil kidang bolho jeh hin Pakai chu vahchoi taveleu, o!
  </para>
  <para style="p">
    <verse number="22" style="v" />Amahon thangvahna ganlhaina-in ganlhaina neiju henlang, athilbolho chu thanom tah-in phongjal uhen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Twikhanglen lama kong inneija chesuh-a, twipi nasatah chunga sumkolvei ho,
  </para>
  <para style="p">
    <verse number="24" style="v" />Amahon Pakai thilbolho le, twi thuhtah sunga athilkidang bolho chu amuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu aman thu apeh leh huile go nasatah ahung kithojin, hichun twipi kinong chu adomsang jin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hicheho chu van lama akinongtou jin, twi thuhtah-a akumsuh kitjin; ahinnao lungkham jeh-in ajunlha jitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Suhle tungin akipeijun, jukham bangin alon lele uvin, achihnao kichaina-a um ahitaove.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutengle lungkhamin Pakai henga apengun, aman ahesoh naova konin ahuhdoh jin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman huile go athipsah-in, chutichun twipi kinongchu atangtan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin athiptah jehchun akipah-un, chutichun adeinau kaimun geichun apui lhungtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mihemte hin mihem chate henga, aphatna jehle athil kidang bolho jeh hin Pakai chu vahchoi taveleu, o!
  </para>
  <para style="p">
    <verse number="32" style="v" />Amahon amachu mipi kikhom lah-a jong choisangu henlang, upaho kikhopna-a ama chu vahchoi uhen.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman vadungho gamthip asosah-in, twisamho tolgo asosah-in;
  </para>
  <para style="p">
    <verse number="34" style="v" />Asunga chengho khangitlou jeh-in, gam phalai chu gamtem asosoh tan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman gamthip chu twikul asosah-in, tolgolai chu twinah putna asosah jin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chenna ding khopi akigon theina diuvin, chua chun gilkelho achensah-in;
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule ga tamtah punsah dingin, lou aboluvin, chule lengpithei aphut uvin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amaho nasatah-a apuntheina dingun phatthei jong aboh-in, aganchahou akemsuhsah nompoi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Avelin, amaho suhgentheina, hesohna, chule lungdona jeh-in, amuisuh tultulun suhnemin aumuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Aman lengchapate chunga noisena abunglhan, lampi kamhel gamthipma avale sahtai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahinla gentheiho chu hesohna-a konin munsanga akoijin, kelngoihon tobangin insung asempeh-in ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Michonpha hon hichu amu uva kipah diu, chule khan gitlouna jousen akam akihup diu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Michingho jousen hiche hohi anit dingu, chule Pakai mingailut khotona chu ahet dingu ahi.
  </para>
  <chapter number="108" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pathen, kalunghi adetne; keiman la sangting navahchoi jinge, kaloupina jengin jong.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tumging le selangdah ho khangun, keiman thingjangvah chu sukhang inge.
  </para>
  <para style="p">
    <verse number="3" style="v" />O Pakai mipi lah-a nangma vahchoi jingting, namtin lah jenga jong nangma vahchoi la sange.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nahepina vanho sangin asangjon, nakitahna chun meibol holah aphan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai nangma vanho chungvuma choisangin umin; chule naloupina chu leiset pumpi chungvuma umhen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nami ngailut ho chu huhdoh-a aumtheina dingin, nakhut jet lamin neihuhhing in lang, nei donbutnin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima kipah ingting, Shechem chu kahop khending, chule Succoth phaicham katedoh ding ahi, tin Pathen'in athenna-in anaseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gilead keija ahin, Manasseh jong keija ahi; Ephraim jonghi kalu thahatna ahin, Judah hi kadanthu pepa ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Moab kakisilna bel ahin, Edom chunga ka kengkoh kaselhah ding, Philistine chunga jona kanei ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khopi dettah-a koiham eipuilut dinga? Koijin Edom sunga eipuilut ding ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pathen, eipaidoh uva nang nahi hilou ham? Vo Pathen, kajanel houtoh nakondoh khom hilou ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Lungkham na-a konin neipanpi uvin, ajehchu mihem panpina chu pannabei ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathen jal-in hangtah-in pangu vinge, ajehchu kagalteo chotphading ama ahi.
  </para>
  <chapter number="109" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kavahchoi jing, vo Pathen, neithipsan hih-in;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu kei douna-in mi khang gilouhole mi lhemlha ho akamkaovin; aleijun keima dounan jou aseijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahon hotna thun eium kimvelun, ajeh beijin eikisat piuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu kangailut amaho kamelman apangun, ahinla keima taona lama kakipen ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon phatna chu setna-in, ngailutna chu hotnan eilethuh taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama chunga mikhang gilou koijin lang, akhut jet lama Satan dinghen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Athu kitan tengle themmo chansah inlang, ataona chu chonset soh hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin nikho lhom henlang, anatohna mun midang changhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Achate pabei hiuhenlang, ajinu meithai hihen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Achate chu tanglouva vahveile khutdo hiuhenlang, mun gohkeoho-a chun changlhah kihol uhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hunam thilchom hon aneijouse lahpeh hen, gamchom min atohgimga kichomhen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahenga hepina musah koimacha umhih hen, pabei chate lainatpi ding jong umda hen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aphattheina suhtanin umhen lang, khang hunglhung dinga aminu noimangin umhen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Apateu khan gitlouna Pakai anga geldoh-in umhen, chule anu chonset noimangin umhih hen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Leisetna kona amaho hetjingna asuhtan theina dingin, amaho Pakai anga umjomjing taohen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu hepina musah ding geltah sangin, vaicha lhasam abol gentheijin, aman alunghesohho jong chu athatnin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi gaosap ding adeibang chun, hichu amachunga chuhen, phattheiboh adeilou bangin, hichu ama-a konin gamlahen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ponsil banga gaosapna akivon ahin, chutichun hichu a-oi sunga twi bangin luthen, chule agu sunga thao bangin luthen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichu amadin akikhu khum ponsil bangin umhen lang, akigah jing konggah dingin umjing tahen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichu Pakaiya kona kamelmate leh, kahinna douna-a thuse seiho lethuhna hihen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla vo Pakai Pathen, namin jal-in neibol peh-in, ajehchu nahepina aphat jeh-in neihuh doh-in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu keima vaichale lhasam kahin, kalung thim hi mavo-a uma ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keima le-lim kiheimang banga chemanga kahitan; khaokhopi banga chungle noija kipeile kahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />An ngol jal-in kakhup angoijin, kasa hin thaona apu tapoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Keima jengjong amaho i-sah louvin kaumtan; eiveovin alu eithinkhum jiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Vo Pakai ka Pathen, neipanpin, nami hepina dungjuijin neihuhhing in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichehi nakhut ahi ti amahon ahet theijuva, Pakai, nangman nabol ahi, ti ahetna diu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amahon gaosap muhen, ahinla nangin phatthei boh-in, amaho ahungtho tengule, jahchao hen, ahinla nalhachapa kipahhen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Eidouho chu jachatna-in kivon henlang, sangkhol len ah bangin akisuhdong naova kikhu khumu hen.
  </para>
  <para style="p">
    <verse number="30" style="v" />Keiman kakamin Pakai chu nasatah-in vahchoi jinge, henge, mipi lah-a amachu ka vahchoi ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu ahinna themmo chansahho-a kona huhdoh dinga, ama migenthei ho jetlama ding ding ahi.
  </para>
  <chapter number="110" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin ka Pakai hengah, namelmate nakeng chotpha-a kaneisah masangsen, kajetlama toujingin, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai chun Zion'a kona nathahatna mol lhon chu ahinsolding ahi. Na melmate lah-a vaihomin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jingkah naobu-a kona thenna hoinaho-a, namite chu natha neina nikho-a kiphal tah-a kipedoh diu ahi, nangman nakhang donlai daitwi chu naneije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai chu akihahseltan, alung akhel kit louding ahi; Nangma Melchizedec banga tonsot thempu nahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai nakhut jetna umchun, alunghan nikho leh lengho chu avoh lhuhding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Pathen hephalouho lah-a thu tan intin, munjouse chu thilonga adipsetna, gam tamtah luchangho chu amavoding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman lampi dunga vachadung twi adonding, hijeh-a chu aman luchang chu adopsang ding ahi.
  </para>
  <chapter number="111" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijun; Mi kitah ho kikhopnale mipi kikhomho lah-a, kalung pumpin Pakai chu vahchoi jinge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai thilbolho chu alenin, chule akipah hon hihochu akholdoh sohkeijuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Athilbol chu ja umtahle loupitah ahin, achonphatna chu tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman athil kidang bolho chu geldoh jing dingin asemin; Pakai chu lungset them le lainatna-a dimset ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama gingho anneh apejin, akitepna chu tonsotna ahet jingding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen hephalouho gouchu amaho apeh theinadin, anatoh thaneije amite amusahtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Akhutna anatohho thutah le thutandih ahin, athupeh jouse chu atahbeh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hicheho chu tonsot atonsotna din dettah-in ading jingin, chuleh hicheho chu thutah le chondih na-a tohdoh-a um ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman amite henga lhatdamna ahinsolin, akitepna chu tonsotnadin thupeh apen, amin chu atheng le ja um ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai ginhi chihna kipatna ahi; athupeh bolho jousen hetthemna phatah aneijun, ama thangvahna chu tonsotnin aumjinge.
  </para>
  <chapter number="112" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijin umhen. Pakai ginga chule athupehho jouse-a kipah-a michu anunnom ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leichunga achilhahte hung hatdiu, mikitah ho khang chu phattheiboh changding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A-insunga neile gou le haona umding, achonphatna chu imatih chana umding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mikitah ho dingin muthim lah jenga jong kho avahjin; ama lungset them, milainatpina dimset le chonphatah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mipha chun mi asulunglhaijin, thilpha ahomin; chingtheitah-a akhosahdan akivetphat ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahbeh-a ama a-imatih chana longlou ding; michonpha chu atonsotna hetna umjing ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman thuse akichat louhel ding; alung adetnin, Pakai atahsanin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Alungthim kiphut detna ahin, amelmate chunga angaichat amukahse-a, ama kichalou ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman athe jal-in, mivaichate apen, achonphatna chu a-imatih chana umjing ding; aki chu jabolna-a choisanga umding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migilouvin hichu muntin lungkham ding, aha agela, junmang ding ahi; migilou ngaichat chu mangthah ding ahi.
  </para>
  <chapter number="113" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijin umhen; Vo Pakai sohten vahchoijun, nanghon Pakai minchu vahchoijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tua patnin tonsot geijin Pakai min chu nunnom hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Niso apat nilhum geijin Pakai min chu vahchoijin umhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai chu namjouse chunga asangpen ahin, aloupina chu van ho jouse chungvuma uma ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chungsanga cheng Pakai i-Pathen'u tobang koi umma,
  </para>
  <para style="p">
    <verse number="6" style="v" />van'a leh leija thil umho vedinga, ama tobanga kineosah jeng koi umintem!
  </para>
  <para style="p">
    <verse number="7" style="v" />Leivuija konin mivaicha akaithouvin, alhasamho vutbol lah-a konin aphong dingin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutia chu pipuiho toh, amite lah-a pipuiho ngeitoh atou khomsah thei nading ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chate neija minu kipahtah bangin, aman numei ching chu in apen ahi. Pakai chu vahchoijin umhen.
  </para>
  <chapter number="114" style="c" />
  <para style="p">
    <verse number="1" style="v" />Egypt'a kona Israel ahungpot doh-u, chule paomah ho-a kona Jacob insung mite apotlai chun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah chu amuntheng anahin, Israel chu alenggam anahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Twikhanglen'in hichu amun, ajam mangin, Jordan alelon kit tai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Molsangho chu kelngoichal bangin akichomun, lhangneohochu kelngoinou bangin akichomuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo nang twikhanglen, ipi nathohlela najam mang ham? Nang Jordan, ijeh-a nalelon kit ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho molsangho kelngoichal banga, chule nangho lhang neoho kelngoinou banga idia nakichopmu ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang leiset, Pakai Jacob Pathen anga chun kithingin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Songpi twikul'a heidoh thei, meituh song twinah sosah thei Pathen ahi.
  </para>
  <chapter number="115" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiho heng hilouvin, vo Pakai keiho heng hilouvin, amavang nami hepina le nathutah jal-in nangma minin loupina pen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ibola Pathen hephalouten, a-Pathen'u tu-a hoiba hitam? atiu ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla i-Pathen'u van ho-a uma ahin, aman adeichan abol ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amilimu chu dangka le sana ahin, mihemho khutsoh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon kam aneijun, apaothei pouvin; mit aneijun, ahinla kho amupouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon bil aneijun, ahinla ajapouvin; nah aneijun, ahinla imacha nam ajapouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon khut aneijun, imala akhoithei pouvin; keng aneijun, achethei pouvin, alolhomuva konin jong apaothei pouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho semho chu amaho bangbep ahin; amaho tahsan chan jong chutichu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Israel, Pakai chu tahsanun, ama chu apanpiule alumdalu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Aaron insung mite, Pakai chu tahsanun, ama chu apanpiule alumdalu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai ging nanghon, Pakai chu tahsanun, amachu apanpiule alumdallu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakaiyin eikhohsah jingun phatthei eibohdiu ahi; Aman Israel insung phatthei abohding, aman Aaron insung phatthei abohding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman Pakai gingho chu alen aneo agoma phatthei abohding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakaiyin nangho hapuna napunsahdiu, chule nachateo apunsah chehdiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangho chu vanle leiset sem, Pakai phattheiboh nahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vanle vanho tah chu Pakaiya ahin, leiset vanghi mihem chate anapeh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mithin Pakai avahchoipon, thipchetna chesuh-in jong avahchoipoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahivangin eihonvang tua pat tonsot geijin Pakai chu vahchoi ute. Pakai chu vahchoijun.
  </para>
  <chapter number="116" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiman Pakai kangailui; ajehchu aman ka aw leh kataona eijahpeh tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu aman kahenglama ana asungin, hijeh-a chu kahin laise-a ama kakoujing ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thina lung gentheina-in eium kimvelin, thilkholkhul thohlel nahon eimanin, lungkhamna le lungdonna katoh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujouvin keiman Pakai min kakouvin, vo Pakai, kangeh nahi, kahinna huhhingin, kati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai chu lungset themle chonphatah ahi; henge, i Pathen'u hi hepina-a dim ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin milhamho ahoitupmin, keima eiki sunem in, ahin aman eipanpie.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo kahinna nacholngahna-a kiletan, ajehchu Pakaiyin naning lhinsah tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu nangin kahinkho thina-a kon, kamit mitlhi-a kon, chule kakeng jong lhahmangna-a konin, nahuhdoh tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing gamsunga chu, Pakai masanga kavale ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman katahsanin, hijeh-a chu kasei ahi, nasatah-a bolgenthei kanahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mijouse hi ajouve, tin kana seiloi chelle.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keidinga aphatchom naho jeh-a, Pakai chu ipi kapeh ding hitam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Huhhingna khon chu domsang ingting, Pakai minchu kou ing kate.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun amite jouse masanga, Pakaiya kakitepna ho jouse peng kate.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai mitmu-a amithengte thichu manlutah ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo Pakai keima nasoh tahbeh kahi, nasohnu chapa nasohpa kahin, kakihen naho neisutlhah peh tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thangvahna chu kilhaina bangin nahenga toh ingting, Pakai minchu kouvinge.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun amite jouse angsunga, Pakai inpi hongsunga,
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Jerusalem, nalailung laitah-a, Pakai henga kakitepna chu kapeh ding ahi, Pakai chu vahchoijun.
  </para>
  <chapter number="117" style="c" />
  <para style="p">
    <verse number="1" style="v" />Oh, namtin jousen, Pakai chu vahchoijun, mijousen ama vahchoijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahepi lungsetna ichunguva aletjeh-in, chule Pakai thutah chu tonsotna umjing ahi. Pakai chu vahchoijun.
  </para>
  <chapter number="118" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu aphat jeh-in, thangvahna peovin, ajehchu ahepina a-imatih chana umjing ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahepina a-imatih chana umjing ahi, tin Israel'in tun seijuhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahepina imatih chana umjing ahi tin, tun Aaron insung miten seijuhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahepina a-imatih chana umjing ahi tin, tun Pakai gingten seijuhen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai chu lung gentheijin kakouvin, Pakaiyin eidon butnin mun lentah-a eikoije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai chu keilama pang ahin, keima kicha ponge, mihemin i-eilo thei ding ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai chu keimale eipanpi hoto pangkhom ahin; hijeh-a chu eihot bolte chunga kalungtup kamuding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihem'a kingai sangin, Pakaiya tahsan ngap aphajoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pipuho-a kingai sangin, Pakaiya tahsan ngap aphajoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nam jousen keima eiumkim velun; ahivanga keiman Pakai mina amaho kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon eiumchah taove, henge, amahon eiumchah taove; ahivanga keiman Pakai mina amaho kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khoi bangin eitomchah un, meisi lingnei banga suhmit ahiuve; ajehchu keiman Pakai mina amaho kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangin kalhuhna dingin hatah-in neihin sonin; ahinla Pakaiyin eikithopin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai chu kathahatna le kala ahin, ama kahuhhingpa ahung hitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kipanale huhhingna aw ginchu, michonpha houbuho-a chun aumin; Pakai khutjet nin hangsan tah-in aboljin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai khutjet chu choisangin aumtan, Pakai khutjet nin hangsan tah-in aboljin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keima thilouva kahin ding, chule Pakai thilbolho chu kaphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakaiyin eisehgim behsehtan; hinla thinagei lomin eina pedohpon ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chonphatna kotpiho chu neihon peh-in, asunguva lutning ting, Pakai chu vahchoi jinge.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichehi michonpha lut nading, Pakai kotpi ahin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangma vahchoi jinge, ajehchu nangman neingaipeh-in, kahuhhingpu nahunghitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />In sahon anot thapmu song chu, inning songpi penin ahung pangtai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichehi Pakai thilbol ahin, imitnuva kidangtah ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichehi Pakai sem nikho chu ahin, hichea hi ikipa thanop diu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tun huhhingin, vo Pakai, nahenga katao ahi, vo Pakai, nahenga katao ahi, tun phattheina hinsolin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakai mina hungpa chu anun nome, Pakai in'a konin phatthei kahinboh uve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathen hi vah eimusah-u Pakai chu ahi; ganlhaina chu maicham kiho-a khao ho-a chun henuvin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangma ka Pathen nahin kavahchoi ding nahi; nangma ka Pathen nahin kachoi sang ding nahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Oh, aphatjeh-in Pakai chu thangvah un, ajehchu ahepina a-imatih chana umjing ahi.
  </para>
  <chapter number="119" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lamlhah-a kisubohlou, Pakai danthua chonpa chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahettohsah naho tuhdetna, chule lungthim pumpi-a ama holla chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahon khangitlou jong abol pouvin, ama lamlhah-a chun acheuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chingthei tah-a nachon danho nitdingin, nangin thupeh neipeuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nachon danho kajuina dinga kachon dingdan eikihila hitavele o!
  </para>
  <para style="p">
    <verse number="6" style="v" />Nathupeh jouse kajabol tengle keima jahcha taponge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nachon phatna thutan naho kakihil tengle, lungtheng tah-a kavahchoi ding nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nachon danho kanitjing ding ahin; nangman neidalha manghel hih-in. BETH
  </para>
  <para style="p">
    <verse number="9" style="v" />Khangdongin alampi iti asuhtheng thei ding ham? Nathu dungjuija chingthei tah-a hinkho amana kon hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kalung pumpin nangma kanaholle, O nathupeh ho-a konin neilam vaisah loujenin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangma douna-a kachonset kit lou nadin, nathu kalung sunga kaselle.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pakai anunnom nahi, nadanthu kisunho neihilin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nakama nathutan lhahho jouse, kamuh-in kaphongdoh tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Haona jousetoh kikotnin, nathu hettohsah naho lampi achun kana thanomin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nachon danho keiman ngaito ingting, nalampi ho jabolinge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nachondan kisunho-a kipah jinging ting; nathu chu kasuhmil louding ahi. GIMEL
  </para>
  <para style="p">
    <verse number="17" style="v" />Kahin theina dingle, nathu kanit nadin, nasoh chunga hin kiphal tah-in na tongin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nachondan thua kona thilkidang ho kamu theinadin, kamit hasah inlang hin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leisetna kholjin kahin, nathupeh ho chu keija konin selhih-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nathutanlhah phattina lhangai na-in kahinna hi suhlam vaijin aumtan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nathupeh ho-a kon vahmanga, mikiletsah sapset changho chu naphohsalin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keija konin i-sah lounale housetna ho lamangin; ajehchu keiman nahettohsahna ho kanit jinge.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pipuiho jong atouvun chule eiseiseuvin, ahinla nasoh hin nadan kisunho kangaiton ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na hettohsahna jong chu kakipanale eithumopma ahi. DALETH
  </para>
  <para style="p">
    <verse number="25" style="v" />Kahinnahi leivuija abehchah tan; nathu dungjuijin neisuhalin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kalamlhah ho kaphong doh-in, nangin neijahpeh tai; Na danthu kisunho neihilin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nachondan lampiho neihet them sah-in; chutichun nathilbol kidangho seichoi lenge.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kahinna lungkhamin ajunlha tai; nathu dungjuijin neihatdoh sah-in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jouseina lampi keija konin chondoh-in; lungsettah in nadanthu neipejotan.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thudih lampi chu kana lhengin; Nathu tanlhah ho kamasanga kakoije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nathu hettoh sahho katuh jinge, O Pakai, neijumso hih-in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kalung nakhantou sah tengle, nathupeh lampia chun lhaijinge. HE
  </para>
  <para style="p">
    <verse number="33" style="v" />Vo Pakai na danthu kisunho lampi neihilin, chutile akhonna geija kachintup ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nadanthu kanit theina dingin hetkhen themna neipen, henge, kalung pumpin nit ing kate.
  </para>
  <para style="p">
    <verse number="35" style="v" />Na thupeho lampia neiche sah-in, Ajehchu hichea chu kipah kahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kiloset lam hilouvin, nathu hetohsahna lama chun neilunglut sah-in.
  </para>
  <para style="p">
    <verse number="37" style="v" />Manmo vetna-a konin kamit heimangin, chule nalampi-a neisuhalin.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nangma ginna-a lunglut, nasohpa henga nathu sudetnin.
  </para>
  <para style="p">
    <verse number="39" style="v" />I-eikisah louna kakichat hi heimangin, ajehchu nathu tanlhahna chu aphan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Vetan, nachondan thuchu kalhangai jinge, nachon phatna-a neisuhalin. VAU
  </para>
  <para style="p">
    <verse number="41" style="v" />Vo Pakai nami hepina kahenga hunghen, nathudih dungjuijin nahuhhingna jong hunglhung hen.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nathu katahsan jala, i-sah louva eibolho chu adonbutna kaneiding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kakama kona thutah thu chu lamanghel hih-in, ajehchu nathu tanna-a kinema kahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chutia chu nadanthu tanglouva, atonsot atonsot geija kanit ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nachondan thuho kahole jeh-in, keima chamlhat tah-in choninge.
  </para>
  <para style="p">
    <verse number="46" style="v" />Lengho angsunga jong nathu hettohsah ho seijing ting, chule keima jahchaponge.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule kanangailut jing, nathupeh ho-a chun kipah inge.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kanangailut jing, nathupeh ho lama chun kakhut jong domsang inting, nadan kisunho ngaitonge. ZAYIN
  </para>
  <para style="p">
    <verse number="49" style="v" />Achunga neikinep sahna, nasoh thusei chu geldoh-in.
  </para>
  <para style="p">
    <verse number="50" style="v" />Nathun hinna eipeh jala, hichehi kahesohna-a kalhamona hiding ahi
  </para>
  <para style="p">
    <verse number="51" style="v" />Mikiletsah-in nasatah-in einuisatnin, ahinla nadanthu-a konin kalhadah dehpoi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Vo Pakai malaija nathu tanlhah ho chu kahejingin, lhamon nan kaneijin ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Nadanthu nungsun mikhang gilouho jeh-in, kichatnin kadimtan ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ka kholjina insunga dinga la chu, Nadanthu kisunho chu ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Vo Pakai namin chu janteng kageldohjin, nadanthu chu kanit jingin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nachon danthu kavetup jeh-in, hichehi kanei ahi. HETH
  </para>
  <para style="p">
    <verse number="57" style="v" />Vo Pakai nangma keija nahi; nathu kanit ding ahi tin kanaseije.
  </para>
  <para style="p">
    <verse number="58" style="v" />Kalung pumpin nalungsetna kangeh-e; nathu dungjuijin hepina neineijin.
  </para>
  <para style="p">
    <verse number="59" style="v" />Kalampi ho kangaiton, nathu hettohsahna lama kakeng kahei tai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Nathupeh ho nitdingin kakinon, kageisangpoi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Mikhang gilou kiloihon eichomun; ahivangin nadanthu chu kasumil pon ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Nachon phatna thutan ho jeh-in, khangkim laijin thouving ting nangma thangvah inge.
  </para>
  <para style="p">
    <verse number="63" style="v" />Nangma ginghole nachondan thu nit ho jouse dinga loile gol kahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Vo Pakai, leiset hi nahepina dimset ahi; nadanthu kisunho neihilin. TETH
  </para>
  <para style="p">
    <verse number="65" style="v" />Vo Pakai nathu dungjuijin, nasohhi neibol phalheh jengin ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Thutan dihtah leh hetna neihilin, ajehchu nathupeh katahsanin ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Eiki bolgim masang chun kana vahmangin, hinla tunvang nathu kanit tai.
  </para>
  <para style="p">
    <verse number="68" style="v" />Nangma naphan, thilpha nabole; Nadan kisun ho neihilin.
  </para>
  <para style="p">
    <verse number="69" style="v" />Mi kiletsah-in kei dounan jou asemthun, kenvang kalung pumpin nadanthuho vetup inge.
  </para>
  <para style="p">
    <verse number="70" style="v" />Alungu sathao bangin athaovin, keivang nadanthu-a kipah inge.
  </para>
  <para style="p">
    <verse number="71" style="v" />Nadanthu kisun ho kahet theina dinga, eiki bolgim chu keidingin aphan ahi.
  </para>
  <para style="p">
    <verse number="72" style="v" />Sanale dangka sang tamtah sangin, nakama danthu sohdoh chu keidin aphajon ahi. YOD
  </para>
  <para style="p">
    <verse number="73" style="v" />Nangman nakhutna neisema neigontoh ahin; nathupeh kahet theina din hetkhen themna neipen.
  </para>
  <para style="p">
    <verse number="74" style="v" />Nathu-a kinema kaumjing jeh-in, nangma ginghon eimu tengule kipah unte.
  </para>
  <para style="p">
    <verse number="75" style="v" />Vo Pakai nathu tanlhah ho adih-in, tahsan umtah-a neibolgim ahi ti kahei.
  </para>
  <para style="p">
    <verse number="76" style="v" />Katao ahi, nasoh henga nathusei dungjuijin, nahepi lungsetna chu kalha mona hihen.
  </para>
  <para style="p">
    <verse number="77" style="v" />Kahin theinadin, nahepina thah chu kahenga hunghen; ajehchu nadanthu chu kakipana ahi.
  </para>
  <para style="p">
    <verse number="78" style="v" />Ajehbeija eibolval jeh uvin, mi kiletsahho chu jahchao hen, keiman vang, nachondan thuho chu kangaito jinge.
  </para>
  <para style="p">
    <verse number="79" style="v" />Nangma gingho, nathu hetohsah heho chu keima lama hungkihei juhen.
  </para>
  <para style="p">
    <verse number="80" style="v" />Kajachat louna din, kalunghi nadanthu kisun ho-a det hen. KAPH
  </para>
  <para style="p">
    <verse number="81" style="v" />Nahuhhingna ngaichan, kahinna alhasamtai; ahinla nathun kakineme.
  </para>
  <para style="p">
    <verse number="82" style="v" />Nathu-a dingin kamit alosamtai, itihle neilhamon ding ham? kati.
  </para>
  <para style="p">
    <verse number="83" style="v" />Meikhu lah-a hai um tobang kahitai; hijongle nadanthu kisun chu kasumilpoi.
  </para>
  <para style="p">
    <verse number="84" style="v" />Nasoh nikho hohi ijat-ham, eisugentheiho chunga itihle thu natan ding ham?
  </para>
  <para style="p">
    <verse number="85" style="v" />Mi kiletsah nadanthu banga umlouhon, kokhuh eilaipeh uvin ahi.
  </para>
  <para style="p">
    <verse number="86" style="v" />Nathupeh ho jouse tahsan um ahin, amahon dihlou tah-in eibolgimuve, neipanpin.
  </para>
  <para style="p">
    <verse number="87" style="v" />Amahon leiset chungahi eisuhmang konu ahitan; kenvang nachondan thuho kadalhapon ahi.
  </para>
  <para style="p">
    <verse number="88" style="v" />Nalungset hepina bangin neisem thah-in, chutichun nakamsung thu hettohsah chu juijinge. LAMED
  </para>
  <para style="p">
    <verse number="89" style="v" />Vo Pakai, nathuhi a-imatih chanin van'a aumjinge.
  </para>
  <para style="p">
    <verse number="90" style="v" />Nakitahna chu khang jouse-a aumin; nangman leiset naphut doh-in, hichu aumjingin ahi.
  </para>
  <para style="p">
    <verse number="91" style="v" />Nahou danthupeh dungjuijin amaho tulai geijin aumjinge; ajehchu abonchauva nasohte ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="92" style="v" />Nadanthu hi kakipana hilou hile, kalung hesoh-a chu anamangthah ding kahitai.
  </para>
  <para style="p">
    <verse number="93" style="v" />Nachondan thuho chu a-itih in sumil pong kate, ajehchu hicheho-a chu hinna neina peh ahi.
  </para>
  <para style="p">
    <verse number="94" style="v" />Nanga kahi, neihuhhing in, ajehchu nachondan thuho kanaholin ahi.
  </para>
  <para style="p">
    <verse number="95" style="v" />Mi khangilou chun suhmang dingin eingah-e, ahivangin nathu hetohsahna ho kagel jing ding ahi.
  </para>
  <para style="p">
    <verse number="96" style="v" />Chamkimna jouse akhonna kamutai; ahin nathupeh vang ajao lheh jengin ahi. MEM
  </para>
  <para style="p">
    <verse number="97" style="v" />Oh, nadanthu hi iti kangailut hitam! nilhumkeijin kangaitojin ahi.
  </para>
  <para style="p">
    <verse number="98" style="v" />Nathupeh ho-a kona kamelmate sanga chingjoa neisem ahi; ajehchu hichu keitoh aum jingin ahi.
  </para>
  <para style="p">
    <verse number="99" style="v" />Eihilho jouse sangin hetthemna kaneijoi; ajehchu nathu hettohsah naho chu kangaiton ahi.
  </para>
  <para style="p">
    <verse number="100" style="v" />Nachondan thuho kavet tup jal-in, malai miho sangin hetkhen themna kaneijoi.
  </para>
  <para style="p">
    <verse number="101" style="v" />Nathu kanit theina din, setna lampi ho-a konin kakeng kakangsen ahi.
  </para>
  <para style="p">
    <verse number="102" style="v" />Nathu tanlhah na-a konin kana kihei mangpoi; ajehchu nangma tah-in nei nahilsa ahi.
  </para>
  <para style="p">
    <verse number="103" style="v" />Nathuhohi keija dinga iti lhuma hitam! Henge, kakama khoiju sangin alhumjon ahi.
  </para>
  <para style="p">
    <verse number="104" style="v" />Nachondan thuho-a konin hetkhen themna kaneijin; hijeh chun lampi dih lou jouse kathen ahi. NUN
  </para>
  <para style="p">
    <verse number="105" style="v" />Nathuhi kakeng dinga thaomei ahin, ka lampi dingin vah ahi.
  </para>
  <para style="p">
    <verse number="106" style="v" />Keima nachonphat nathutan ho nit dingin, kaki hahsel in kaphut det tai.
  </para>
  <para style="p">
    <verse number="107" style="v" />Vo Pakai eiki bolgim behsehtan; nathu dungjuijin neisuhalin.
  </para>
  <para style="p">
    <verse number="108" style="v" />Vo Pakai kangeh ahi, kakama lungcham thilpeh hi sangin lang, nathu tanlhah naho chu neihilin.
  </para>
  <para style="p">
    <verse number="109" style="v" />Kahinna kakhutna aumjingin; hijongle nadanthu kasumil dehpoi.
  </para>
  <para style="p">
    <verse number="110" style="v" />Mi khang gilou chun thang eikampeh-in; hijongle na danthuho-a konin kavahmang dehpon ahi.
  </para>
  <para style="p">
    <verse number="111" style="v" />Nathu hettohsah naho chu katonsot goudin kakilah-e; ajehchu hicheho chu kalung kipana ahi.
  </para>
  <para style="p">
    <verse number="112" style="v" />Akhonna geija nadanthu kisunho tohdoh nadin, kalungthim kapetan ahi. SAMEK
  </para>
  <para style="p">
    <verse number="113" style="v" />Mohthil ngaitohi kahon, ahin, nadanthu vang kangailun ahi.
  </para>
  <para style="p">
    <verse number="114" style="v" />Nangma kakiselna munle kalumdal nahin, nathu-a kakineme.
  </para>
  <para style="p">
    <verse number="115" style="v" />Nangho khanset bolho, keijakonin potdoh-un, ajehchu ka Pathen thupeh ho chu kanga tup ding ahi.
  </para>
  <para style="p">
    <verse number="116" style="v" />Kahin theinadin nathu dungjuijin neituh-in, kakinepna-a neijachat sah hih-in.
  </para>
  <para style="p">
    <verse number="117" style="v" />Neituh detnin chutileh kahoidoh ding ahi; chule nadanthu kisun ho tanglouva kajabol ding ahi.
  </para>
  <para style="p">
    <verse number="118" style="v" />Nadanthu kisunho-a kona vahmangho jouse chu nachotpha tai; ajehchu amilhep lhahnao chu jou ahi.
  </para>
  <para style="p">
    <verse number="119" style="v" />Nangin migilouho jouse chu thih-eh bangin nasumangin, hijeh chun nathu hettohsah naho kangailun ahi.
  </para>
  <para style="p">
    <verse number="120" style="v" />Katahsa nangma ginan akihotnin, chule nathutannaho chu kakichan ahi. AYIN
  </para>
  <para style="p">
    <verse number="121" style="v" />Thutandih le chonphatna kabole, eibol gentheiho hengah eidalha hih-in.
  </para>
  <para style="p">
    <verse number="122" style="v" />Nasoh phatnadin kitungin lang, mihoitho chu eisuh genthei sah hih-in.
  </para>
  <para style="p">
    <verse number="123" style="v" />Nahuhhing nale nachon phatna thu holna-a konin, kamit hi alhasam tai.
  </para>
  <para style="p">
    <verse number="124" style="v" />Nami hepina dungjui jin nasoh hi bolin lang, nadanthu kisemho neihilin.
  </para>
  <para style="p">
    <verse number="125" style="v" />Keima nasoh kahin; nathu hettohsah naho kahet khen thei nadin, het themna neipen.
  </para>
  <para style="p">
    <verse number="126" style="v" />Pakai nang dinga natoh phat ahitai; ajehchu nadanthu anotthap taovin ahi.
  </para>
  <para style="p">
    <verse number="127" style="v" />Hijeh chun sana sangin nathupeh kangailun; henge, sana thengsel sangin kangailu jon ahi.
  </para>
  <para style="p">
    <verse number="128" style="v" />Hijeh chun nachondan thuho jouse, adih ding thil jouse kajabolin; lampi dihlou jouse kathen ahi. PE
  </para>
  <para style="p">
    <verse number="129" style="v" />Nathu hettohsahnaho chu kidangtah ahin; hijeh-a chu kahinna-in hiho chu anitding ahi.
  </para>
  <para style="p">
    <verse number="130" style="v" />Nathu lutna chun vah apejin, hichun milhamho hetkhen themna apejin ahi.
  </para>
  <para style="p">
    <verse number="131" style="v" />Kakam kan, kahaihai jenge; ajehchu nathupeh ho kangaichan ahi.
  </para>
  <para style="p">
    <verse number="132" style="v" />Namin ngailuho nabolnaji bangchun, keima neivenlang, neihepi tan.
  </para>
  <para style="p">
    <verse number="133" style="v" />Nathu-a kakholhah ho thu penlang, kachunga khansetna himhim vaipohsah hihbeh-in.
  </para>
  <para style="p">
    <verse number="134" style="v" />Mihem suhgentheina-a konin neihuh doh-in, chutichun nachondan thuho nit inge.
  </para>
  <para style="p">
    <verse number="135" style="v" />Nasoh chunga hin namai vahsah inlang, nadanthu kisun ho neihilin.
  </para>
  <para style="p">
    <verse number="136" style="v" />Amahon nadanthu anit loujeh-un, kamit lhi vadung twi bangin alonglhan ahi. TSADDE
  </para>
  <para style="p">
    <verse number="137" style="v" />Vo Pakai nangma chonpha nahin, nathutan ho chu dihtah ahi.
  </para>
  <para style="p">
    <verse number="138" style="v" />Nangin napeh nathu hettohsah naho chu, chonpha le kitah ahi.
  </para>
  <para style="p">
    <verse number="139" style="v" />Kamelma ten nathu asuhmil jeh-un, katompan na-in eisumang tan ahi.
  </para>
  <para style="p">
    <verse number="140" style="v" />Nathuhi athenglheh jengin, hijeh-a chu nasoh-in kangailun ahi.
  </para>
  <para style="p">
    <verse number="141" style="v" />Keima neochale isahlou kahin, hijongle nachondan thuho chu kasumil pon ahi.
  </para>
  <para style="p">
    <verse number="142" style="v" />Nachon phatna chu tonsot chonphatna ahin, nadanthu chu thutah ahi.
  </para>
  <para style="p">
    <verse number="143" style="v" />Lungkhamnale natthoh lel-in eituhchah-in, hijongle nathupeh ho chu kakipana ahi.
  </para>
  <para style="p">
    <verse number="144" style="v" />Nathu hettohsah naho chonphatna chu tonsotna ding ahin; hetkhen themna neipen, chule hingjing tange. KOPH
  </para>
  <para style="p">
    <verse number="145" style="v" />Kalung pumpin kakouve, neingaipeh-in, O Pakai, nadanthu kisun hi kanit ding ahi.
  </para>
  <para style="p">
    <verse number="146" style="v" />Nangma kakouve, neihuhhing in, chutia chu nathu hettohsah naho kanit ding ahi.
  </para>
  <para style="p">
    <verse number="147" style="v" />Khovah masangin kathouvin, chuin nang kakouvin, nathu-a kaki nem-e.
  </para>
  <para style="p">
    <verse number="148" style="v" />Nathu kagelthei nadin, jankhon mitsing louvin kaumin ahi.
  </para>
  <para style="p">
    <verse number="149" style="v" />Nalungset hepina dungjuijin ka aw ngaijin, vo Pakai nathutandih dungjuijin neisem thah-in.
  </para>
  <para style="p">
    <verse number="150" style="v" />Thilphalou nung juiho chun eihin naijui; amaho nadanthu-a kona gamla ahiuve.
  </para>
  <para style="p">
    <verse number="151" style="v" />Vo Pakai nangma nailamcha nahin, nathupeh jouse thudih ahi.
  </para>
  <para style="p">
    <verse number="152" style="v" />Nathu hettohsah chungchanga, nangman tonsotna dinga naphudetsa ahitai, ti malaija pat kahet ahitai. RESH
  </para>
  <para style="p">
    <verse number="153" style="v" />Kathoh gimje hi ngaitonlang, neihuh doh-in, ajehchu nadanthu kasumilpon ahi.
  </para>
  <para style="p">
    <verse number="154" style="v" />Kachungthu neisei lhahpeh inlang neihuh doh-in, nathu dungjuijin neisem thah-in.
  </para>
  <para style="p">
    <verse number="155" style="v" />Huhhingna chu migilou ho-a kona gamlatah ahi; ajehchu amahon nadanthu kisun aholpouve.
  </para>
  <para style="p">
    <verse number="156" style="v" />Vo Pakai nahepinaho chu nasatah ahi; Nathutanlhah dungjuijin neisem thah-in.
  </para>
  <para style="p">
    <verse number="157" style="v" />Eisugentheile kamelma atam lheh-un; hijongle nathu hetohsah na ho-a konin kalhasam dehpoi.
  </para>
  <para style="p">
    <verse number="158" style="v" />Suhkhel neiho kaven, nathu achintuplou jeh-un kalung akhamin ahi.
  </para>
  <para style="p">
    <verse number="159" style="v" />Ngaito temin, nadanthuho iti kangailut hitam; vo Pakai nalungset hepina dungjuijin neisem thah-in.
  </para>
  <para style="p">
    <verse number="160" style="v" />Atil abula pat nathu hi adih-in; chule nachon phatna thutan ho chu tonsotnin aumjingin ahi. SCHIN
  </para>
  <para style="p">
    <verse number="161" style="v" />Ajehbeijin pipuihon eisugentheijun; ahinla kalunghi nathu-a tijatah-in ading jingin ahi.
  </para>
  <para style="p">
    <verse number="162" style="v" />Thil tamtah chomdohho bangin, nathu-a hin katha anomlheh jie.
  </para>
  <para style="p">
    <verse number="163" style="v" />Jouhi kathen kakidah-in, Na danthu vang kangailun ahi.
  </para>
  <para style="p">
    <verse number="164" style="v" />Nachon phatna nathutan naho jeh-in, nikhatnin sagivei nangma kathangvah-e.
  </para>
  <para style="p">
    <verse number="165" style="v" />Nadanthu ngailuhon chamna loupitah aneijun; imachan amaho asuhmo louding ahi.
  </para>
  <para style="p">
    <verse number="166" style="v" />Pakai nami huhhingna-a kakinemin kangah-in, nathupeh ho kabolin ahi.
  </para>
  <para style="p">
    <verse number="167" style="v" />Kahinna-in nathu hetohsahna ho anitjingin, nasatah-in kangailun ahi.
  </para>
  <para style="p">
    <verse number="168" style="v" />Na danthu kisunhole nathu hetohsahna kanitjinge; ajehchu kalampiho jouse na masanga aumin ahi. TAU
  </para>
  <para style="p">
    <verse number="169" style="v" />Vo Pakai kakana nakom hunglhung hen, nathu dungjuijin hetkhen themna neipen.
  </para>
  <para style="p">
    <verse number="170" style="v" />Kataona na-ang hunglhung hen, nathu dungjuijin neihuhdoh in.
  </para>
  <para style="p">
    <verse number="171" style="v" />Kakamin navahchoina aphondoh ding ahi, ajehchu nangman nadanthu kisunho neihile.
  </para>
  <para style="p">
    <verse number="172" style="v" />Kaleijin nathuho aseiding ahi; ajehchu nathupeh jouse chonphatna ahi.
  </para>
  <para style="p">
    <verse number="173" style="v" />Nachondanthuho kalhen jeh-in, nakhut chun eiki thopihen.
  </para>
  <para style="p">
    <verse number="174" style="v" />Vo Pakai nami huhhingna kalhangaijin, nadanthu hi kakipana ahi.
  </para>
  <para style="p">
    <verse number="175" style="v" />Kahinna hinsah in, chuteng kavahchoi ding nahi, chule nathutan lhahna-a chun neipanpin.
  </para>
  <para style="p">
    <verse number="176" style="v" />Kelngoi mang bangin kana vahmang tai; nasohhi neihin hollin, ajehchu nathupeh kasumilpon ahi.
  </para>
  <chapter number="120" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kagenthei teng Pakai kakoujin, aman eingaipeh jin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Pakai jouseina kamle, lheplhahna leija konin, kahinna huhdoh-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jou seija leigui, nangma ipi kapeh-a, ahilouleh ipi kabolpeh dingham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihat thalchang ho hemtah leh makeithing meihol ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ohe ada kahi! Meshech gama kana kholjin le-a, Kedar ponbuh-a kanachen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kahinnahi chamna hotbolho toh sottah anacheng khomin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman chamna kadeijin, hinla thu kaseidoh teng, amahon galbol ding agojiuve.
  </para>
  <chapter number="121" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hoija kona eipanpi hung ham tin, lhangho lam ve-in khodah inge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vanle leiset sempa Pakaiya kona eipanpi hungah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman nakeng achaloh sah louding, nachingpa chu lulhu louding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vetan, Israel chingpa chu lulhu louding; imu jong imulouding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai chu nachingpa ahin; Pakai chu nakhut jetlam nalima pang ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sunle nisan nasangkha pontin, janteng jongle lha-in nasalkha ponte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin thilse jouse-a kona nahongbit ding; nahinna jong ahonbit ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin tua pat atonsot geija navaikon navailhun ahonbit ding ahi.
  </para>
  <chapter number="122" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihon kahenga, Pakai in'a cheu hite, atiu chun, katha anom lheh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Jerusalem, nakotpi sunga kakeng uva kadin dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jerusalem hi abilla chengkhom khopi banga kisem ahin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chukoma chu Israel hettohsah na-a phungho, Pakai phungho chu Pakai minna thangvahna pedinga, chetou jiuva ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu chumuna chu thutanna laltounaho, David insung laltounaho chu kido-a ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jerusalem'a chamna aum nadin taovun, nangailu hou chu khangtou dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nakulsunga cham lenghen lang, na leng-inpi sunga khantouna umhen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu tu-a hi kasopite le kaloiho jala, nalah uva cham lenghen katiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Pakai ka Pathen insung jeh-a, naphatnadiu kahol ding ahi.
  </para>
  <chapter number="123" style="c" />
  <para style="p">
    <verse number="1" style="v" />O nang van ho-a cheng, nangma henglam ven kakhodah-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vetan, sohte mitnin apakai teo khut avetjing bangle, sohnu mitnin a-pakainu khut avetjingji bangin, kachunguva hepina einei masang seuvin, kamitnuvin Pakai ka Pathen'u ave jingin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hepina neineijun, O Pakai, hepina neineijun, ajehchu noisena-in kadim behseh taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi kinomsahho mitaitomna, chule mikiletsahho midem na-in, ka hinnao hi nasatah-in adip tan ahi.
  </para>
  <chapter number="124" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Israel ten seijuhen, Pakai chu eiho lama anapanglou hileh:
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihon eina dou uva chu, Pakai chu eiho lama anapanglou hileh:
  </para>
  <para style="p">
    <verse number="3" style="v" />Ichunguva hatah-a alunghan laitah uva chu, eina vallhum diu ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuche laija chu twijin einachup manguva, ihinnao chungaho luidung analong ding ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuche laija chu hoithona twi chu ihinnao chunga hi analong ding ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aha uva dinga anneh-a eina pedoh louvu Pakai chu nunnom hen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thang kamho thanga kona vacha kitoldoh banga ihinnao hi kitoldoh ahitan, thangkhao atanin, ikitoldoh taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Eipanpiuva chu, Vanle lei sempa Pakai minna uma ahi.
  </para>
  <chapter number="125" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai tahsanna mite chu Zion molsang tobanga, suhlonghoi hilouva a-imatih channa umjing diu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Molsang hon Jerusalem a-umkimvel bangin, tua pat tonsot geijin Pakaiyin amite a-umkimvel jinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu miphalouho moltum chu michonpha ho chunga chulouding, achutiloule chonphaten khangitlou na-a khut lhang getnunte.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Pakai miphaho dingin thilpha bolin, alungthim dih ho-a din thilpha bolpeh-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alampia vahkoija kihei mangho vang, Pakaiyin thilse bolho toh puidoh thantin, Israelte chunga vang chamna umding ahi.
  </para>
  <chapter number="126" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin sohchangho Zion'a alepuikit laichun, eiho mang neiho toh ibangun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuche laichun ikamu chu nuinale ileijuva lasahna anadimin ahi. Chujouchun amahon Pathen hephalouho lah-a Pakaiyin amaho thil loupitah abolpeh uve, anatiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin thil loupitah einabolpeh-un, chua chun eiho ikipah uve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Pakai, lhanglam luidungho bangin, kasohchang hou hinlepui kitnin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mitlhi puma tu hochun kipahtah-a a-atdiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Muchi lutah choija, kapumma kondohpa chun, achangphal ahin kipoh-a, thanom tah-a hungkile kitding ahi.
  </para>
  <chapter number="127" style="c" />
  <para style="p">
    <verse number="1" style="v" />In sa-a Pakai apanlouleh, asaho tohgimna chu moh ahin; Khopi ngah-a Pakai apanlou leh, angahpa janha chu moh ahibouve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Matah-a natho-a, jan sottah natouva, lungkhamna changlhah neh chu, nangdinga pannabei ahi: ajehchu aman angailut chu a-imutsah jin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Veovin chatehi Pakaiya kon gouchan ahin, chule laigilga jonghi akipaman thilpeh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khangdon laija chate hi, Galhatpa khutna thalchang ho tobang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alivathei dimsetna hicheho neija mi chu anunnom ahi; amaho jahcha loudiu, ahivanga amelmateu toh kotpi phunga kihoujo diu ahi.
  </para>
  <chapter number="128" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai ging jouse leh alampiho-a chonchan chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu nakhutna natohgim ga naneh ding; nangman nomsan natin, chule hichu nang dinga phading ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na inneipi chu na-in vella lengpigui ga phatah bangintin; nachate chu nadokhang kimvela Olive phung tobang hidiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vetan, chutia Pakai ginga mi chu phatthei chang ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin Zion'a konin phatthei naboh intin; chule nahin laise-a Jerusalem phatna chu namu ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Henge, nachateo chatele Israelte chunga chamna chu namu ding ahi.
  </para>
  <chapter number="129" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuhin Israel ten seijuhen; kakhangdon laijapat tamtahvei einabol gimuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kakhangdon laijapat tamtahvei einabolgim uvin; hijongle amahon eijoudeh pouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Loukaihon katungtun chunga akaijun; akainau nung saotah-in akigolin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai chu chonphatna ahin; migilouho khaojang chu aman asatan tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zion hotbolho jouse chu jahchao henlang hung kinung leuhen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho chu akhandoh kah-a goppai jia in chunga hampa tobang bep hiuhen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche achun chang at pan akhut adip pon; chujongle changphal kanpan jong a-ang adip poi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Avahleho koiman, nangho Pakai phatthei boh changun, Pakai Minna phatthei kaboh nahiuve, tia seija aumpoi.
  </para>
  <chapter number="130" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, kokhuh thuhtah-a konin nangma kahinsamme.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai ka aw ngaijin, kangehna aw hi ngai nadin nana hinsungin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai nangin khangit lounaho namelchih-a ahile, O Pakai koiham adingjou dinga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla ginna naum theinadin nahenga ngaidamna chu aumme.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai chu kangah-in, kahinna hin angah jingin, athu-a chun kinemin kaume.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jingkhovah ngahho sangin nasajon, kahinna hin Pakai chu angah-e. Henge, jing khovah ngah ho sangin kamasajoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel chu Pakaiya kinemhen; ajehchu Pakaiya hepina leh lhatdamna chamkim aumin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman akhangit lounao jouse-a kona Israel chu alhatdoh ding ahi.
  </para>
  <chapter number="131" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai kalungthim hi akiletsahpon, kamit jong akichoisangpoi. Keidinga thil len hole thil sang behsehho-a jong kakijil ngaipoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tahbeh-in anu noichep bangsa naosen bangin, thip khinkhen chan kaumin, ka hinna hi naosen noichep bangsa tobanghel ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tu-a kipat a-imatih chana din, Pakaiya chun Israelte kinem uhen.
  </para>
  <chapter number="132" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai David leh athoh hahsatna jouse chu geldoh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai henga iti ama kitepma, chule Jacob Pathen hat chungnung henga iti ana kihahsela hitam.
  </para>
  <para style="p">
    <verse number="3" style="v" />Atahbeh-in ka insunga lutpong ting, kajalkhuna jong kicholdo din lutponge;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamit ho imutsah pongting, ahiloule lulhuh jong lulhuh sah ponge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiya dinga munkhat kamudoh kahsen, hat chungnung Jacob Pakai dinga chendetna in kamudoh kahsen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Veovin, hiche thuchu Ephratah'a kajauvin; gammang lah-a chun kamutaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama houbuh sunga eiho cheohitin; eihon akhophang bullah houvu hite.
  </para>
  <para style="p">
    <verse number="8" style="v" />O Pakai, thoudoh-in, nacholdona sunga lutnin; nangmale nathahatna thingkhong toh kipatdohtan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nathemputeu chonphat na-in kivonuhen; chule namithengte kipah-in ao vuhen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nasoh David jal-in, nathaonupa mai chu heimangpeh hih-in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai chu David henga thutah in akihahselin; chua kona kiheimang lou ding; nanga kona hung doh khat, nalaltouna chunga katousah ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman amaho kahilding kathu lhunle kathu hetohsah nahi, nachaten anit uva ahile amaho jongchu a-imatih chana nalal touna chunga touding ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu Pakaiyin achenna ding anadeitan; Zion chu analhengtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichehi a-imatih channa kacholngah na ahin; kadeitah anahijeh-in, hia hin chengjing tange.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aneh dingu nengtah-in phungvuh ingting; ami gentheite changlhah-in vah vange.
  </para>
  <para style="p">
    <verse number="16" style="v" />Athemputeu huhhingna-in von ingting, chule amithengte kipa aw-thonga ao dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chukoma chu keiman David ki kadotdoh sah ding; kathaonu dinga chun thaomei khat kaphudet pehtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amelmateu jachatna-in voning ting; ahinla ama tah chunga vang alallukhuh chu khangtou jing ding ahi.
  </para>
  <chapter number="133" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veovin, sopi kitohtah-a chenkhomhi iti phatna iti nopma hitam!
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichu luchunga thao mantam tah tobang ahin, khamula longlha-a, Aaron khamul geija longlhasuh tobang; aponchen mong geija jollha suhpeh tobang ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hermon daitwi bangle, Zion molsangho chunga hunglhajia dai twiho tobang ahi. Ajehchu chua chun Pakaiyin tonsotna hinna ding phattheina thupeh chu apen ahi.
  </para>
  <chapter number="134" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veovin, nangho Pakai sohte jouse, janna Pakai in'a dinghon Pakai chu vahchoijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Munthenga chun nakhut domsangun lang, chule Pakai chu vahchoijun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Van leh leiset sempa Pakai chun Zion'a konin phatthei naboh-uhen.
  </para>
  <chapter number="135" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijun, nanghon Pakai minchu vahchoijun, vo nangho Pakai sohte, amachu vahchoijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho Pakai insunga dingteho, Pathen in hongsunga dingteho,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai chu aphat jeh-in, Pakai chu vahchoijun, nomtah ahijeh-in, aminin vahchoina la saovin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakaiyin ama ding tumin Jacob akilhenin, chule agou tum mong dingin Israel akilhentai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Pakai chu loupitah ahi kahen, chule I-Pakaiyu hi Pathen jouse chunga ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin alunglhaina chan chu van'a, leija, twikhanglen sunga chule mun thuhtah ho jouse-a aboljin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman leiset kolmang ho-a konin twimeiho ajamdoh sah-in, go juhna dingin kolphe asemin, akholna in'a konin khohui ahin lhadohjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman Egypt gama mihem apeng masa mihem le gancha, agomin athat gamin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Egypt gam, Pharaoh chung leh asohte jouse chunga, aman melchihna le thil kidang nalah uva ahinsolin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Namlenho asumangin, chule leng hattaho athat gamin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amor mite lengpa Sihon leh Bashan lengpa Og, chule Canaan lenggam ho jouse;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule agammu chu goulo din, ami Israelte gouchan din apetan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Pakai, namin chu tonsotnin aumjingin, chule vo Pakai, nahetjingna chu khangjouse lhumkeijin aumjinge.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Pakaiyin amite thu atanding ahin, chule asohte chungchanga alung aheiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathen hephalouho milimhou chu dangka le sana, mihem khutna kisem ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amahon kam aneijun ahinla apaothei pouvin, mit aneijun ahinla kho amupouvin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon nakhang aneijun ahinla kho ajapouvin, akam sunguva jong haina himhim aumpon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hicheho semho chu amaho tobangbou ahin; Chucheho tahsan chan jong chu chutima chu ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Israel insung mite, Pakai chu vahchoijun; vo Aaron insung mite, Pakai chu vahchoijun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vo Levi insung mite, Pakai chu vahchoijun; Pakai gingte nanghon, Pakai chu vahchoijun.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jerusalem'a cheng Pakai chu, Zion'a konin nunnom hen, Pakai chu vahchoijun,
  </para>
  <chapter number="136" style="c" />
  <para style="p">
    <verse number="1" style="v" />O aphat jeh-in Pakai henga thangvahna peuvin: ajehchu ami hepina tonsotna umjing ahin,
  </para>
  <para style="p">
    <verse number="2" style="v" />O pathenho Pathen henga thangvahna peuvin: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />O pakaiho Pakai henga thangvahna peuvin: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amabou thilkidang loupitah bola ahi: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chihna-a vanho sempa henga chun: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Twipi chunga leiset phajalpa henga chun: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vah loupitah sempa henga chun: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sunna vaihom dinga nisa: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Janna vaihom dinga lhale ahsi ho: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Egypt'a apeng masa jouse thatgam pa henga: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amaho lah-a kona Israelte puidoh: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khut thahat tah le aban lhangdoh pa: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Twipisan hopni-a homkhenpa henga chun: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule chuche lailung Israelte palgal kaisahpa: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla Pharaoh le ami janelho twipi san sunga lehlutpa: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gamthip lhonlhunga amite puilhung helpa henga: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Leng loupitah ho sumang helpa henga chun: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule leng minthangho that gampa: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amor mite lengpa Sihon: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Bashan lengpa Og: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule agamu goulo dinga pe-a: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Asoh Israel henga goulo dinga pepa: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ilhahsam laitah uva eina geldoh pao: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule imelmateuva kona eilhat dohpao: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tahsa-a hung jouse nehding pepa: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />O van Pathen henga thangvahna peuvin: ajehchu ami hepina tonsotna umjing ahi.
  </para>
  <chapter number="137" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babylon vadungho pama chun katouvun, Zion kageldoh phatnun kakap taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huisum chungho-a chun ka selangdah hou kakhaijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu chukoma gal hinga eipuimang houchun la khat angeh-un; chule eibolgenthei houchun kipahtah-in eijolun, Zion la khat neisah peh-un atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi gama keihon Pakai la chu iti kasah dingu ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Jerusalem, nangma kasuhmila ahile, kakhut jetlam hin akhut themna sumil jenghen,
  </para>
  <para style="p">
    <verse number="6" style="v" />nangma kageljing louva, kakipana pipen sanga Jerusalem kalhenjoh loule, kaleihi kadang chunga behden jenghen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai Jerusalem chim nikho-a, Edom miten anatoh-u chu geldoh-in; suchimun, a-inbul songho chu suchimun, tin asamui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Suhmang dinga uma vo, Babylon chanu, keiho neibolnao banga nale thuhpa chu kipah hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nachasenho man khoma songho jepna-a neipa chu kipah hen.
  </para>
  <chapter number="138" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kalungthim pumpin nangma vahchoi jinge, pathenho masang-ah keiman nangma vahchoi La sange.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na houin thenglam ngan na houvingting, chule nalungset ngailutna le nathupeh jallin namin vahchoi jinge; ajehchu namin jouse chungvuma, nathu nachoisangtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Katao nikhon nangman neidonbut in, chule kahinna thahat napen, nahatsah tai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Pakai, amahon na kama thusoh ajah tengule, leiset leng jousen navahchoi diu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Henge, amahon Pakai lampiho lan saovinte; ajehchu Pakai loupi nachu nasatah ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai chu sanglheh jongle, mi noinungho ajaboljin, mi kiletsah vang gamlatah-in ahei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lungkhamna lah-a vahle jongleng, nangin neisuhalin, kamelmate lunghanna chunga nakhut nalhan ding, chule najetlama nei huhhing ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin kachung chang thu chamkimsah inte, vo Pakai, nahepina tonsotna umjing ahi: Na khuttah-a nanatoh ho chu nungsun lou jenin.
  </para>
  <chapter number="139" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai nangin neikhochillin neihetai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin katoulhah le kadindoh jong nahen, gamlatah-a konin ka lunggel ho jong nahen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangin kalampi le kaluplhah nakhol toh-in, chule kalampiho jouse nahechen sohkeije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu, vo Pakai, kaleija thu khatcha aumpon, ahinla vetan abonin na hesoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangin kanungle kama-a nei-um ton, kachunga nakhut nangamjin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutobang hetna hi keidin akidang behseh-in, asangin, kasoh phajou poi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nalhagaova kona hoilama kache-a, ahilouleh na-angsunga kona hoilama kajamding ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Van'a kaltou jongleng chu-a chun naumin, thikhol khul'a jalkhun kido jongleng, vetan, chumuna jong chun na-umme.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jingkah lhavingho kilah ingting, twikhanglen mongpeh-a gacheng jongleng,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chukom jenga jong chun nakhutnin neikaijin natin, nakhut jetna neituh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thonlouva muthimin eikhuding ahi tijongleng, jan jengjong chu kavela vah hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Henge, muthim chu nanga konin akiselpon, jan chu sun bangin avahjoi, nangdia muthimle khovah ania kibang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu kasungil jouse jong nangma gontoh ahin, nangin kanu naobu sunga neinakhu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kichat um le kidangtah-a kisem kahi jeh-in, nangma Kavah choije; nanatoh hohi datmo aumin, chule hichu kahina hin ahechen lheh-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aguh-a eikisema chun ka gong hi namasanga akiselpoi, kidang tah-a leiset noinung pena eikisem ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Katibah jouse hi khatcha aum masang, chamkim loulai ka gong hi namitnin namun; nalekhabu-a chu hicheho jouse hi akisemjou masanga kisun sohkei ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo Pathen nalunggel ho hi keidia iti mantam hitam! akisuhto khom chu iti natsatna hitam!
  </para>
  <para style="p">
    <verse number="18" style="v" />Kasimding hitale neldi sanga tamjo ahiuvin; kakhahdoh jengin jong nangto kaum khom nalaije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Pathen, migilou chu thonlouva nathatei ding ahin, hijeh chun nangho thisan sohatte, keija konin potdoh-un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu nangma dounan giloutah-in thu aseijun, chule namelma ten mohseh-in namin apanuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Vo Pakai nahote chu kahotbol louham? Chule nangma douna-a kipatdoh ho chunga kalungphatmo louham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Amaho chu hot atin kaho-in; kamelma-a kasimu ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />O Pathen, Neikhol chilin chule Kalungthim hi he-in; nei patepmin, chule kalunggel hohi hechenin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule ven keija hin khangitlouna lampi khattou aumdem, chule tonsot lampia chun neipuijin.
  </para>
  <chapter number="140" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, miphalouva konchun neihuh doh-in, hunam miho-a konchun neiveng tupmin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Alunguvin lheplhahna angaitouvin, tanglouvin galboldin akikhom khom jiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aleiju gul bangin anol hemun, alei noijuva gulsum gu aumme. Selah
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Pakai migilou khutna konin neingahphan, kachena suhboi ding eigo-a, hunam miho-a konin neihongphan.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi kiletsah hon thang le khaohol eikampeh-un, lamsih-a lenthang aphaovin, amahon thang eikam khumuve. Selah
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman Pakai henga chun, nangma ka Pathen nahi kati, vo Pakai kataona aw hi ngaijin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai Pathen, kahuh hingna thahat; nangman gal kisat nikhon kalu neikhu peh-e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai, migilou ngaichat chu phalpeh hih-in, aduha lungthim gilou chu pilhinsah hih-in, achutiloule kichoisang getnunte. Selah
  </para>
  <para style="p">
    <verse number="9" style="v" />Eium chahho luchang chu, amaho kamtah-a lheplhahna chun khukhumhen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mei am lenglung chu achunguva hungchu hen, ama ahung kithodoh kitna loudiuvin, kotong thuh tahle meikong lah-a chun kisep lutnu hen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thuse seija leisetna kitungdoh hihhen, hunam mang chu setna-in suhlhuh dia anungjui ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Akibol gentheite thu leh vaichate dihna chu, Pakaiyin suhdih peh inte ti kahei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Michonphan thonlouva namin athangvah ding; Midih chu na angsunga cheng ding ahi.
  </para>
  <chapter number="141" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai nangma kakouve, nangma kakou tengle ka aw-a hin nana hinsung loijin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kataona ginnamtui bangin na-anga kitungdoh hen, chule kakhut dopsanghi nilhah lam ganlhaina bang hihen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pakai, kakam kamdal neikoi peh in, kakam nei ngatup peh-in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalungthim hi thilse lama lutsah hih-in, khanset bol mihem natoh phalou kijildin nopsah hih-in, chule a-anneh tuihou neinehsah hih-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Michonphan eivohen, hichu lungsetna hinte, chule eiphohsal hen, hichu thao nasatah hiding ahi, hichun kalu suheh ponte, ajehchu avangsetnao sanna kataopeh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Athutanhou songhol lah-a akipailhah tengle, hiche hochu alhum jeh-in, kathu ngaitao vinte,
  </para>
  <para style="p">
    <verse number="7" style="v" />Khattouvin tolla thing atanna a-ea bangin, kaguhou lhankhuh kama akithecheh gamtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla vo Pakai Pathen, kamitnin nangma lam akatjingin, nangma-a katahsan kangame, ka hinna hi gentheijin dalha hih-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keidinga athang kamhouva konle, khangitlou bolho-a konin neihongbit in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima kakitoldoh laitah-in, migilouho chu amahotah lensunga lhalut uhen.
  </para>
  <chapter number="142" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka aw-in Pakai kakouvin, ka aw in Pakai henga ngehna kaneije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amasanga kalunglhai louna kasam phongin, a-angsunga kalung khamna kamusah-e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kasunga um lhagao agenthei tengle, nangin kalampi nahejinai. Kakeng lamlhahna-a guhthimin amahon keidin thang eikampeh-un ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kakhut jetlam kavetle, veuvin eihuhding mi khatchala aumpon; belding kaneipoi; Koimachan kahinna akhohsahpoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pakai nahenga kataove; Nangma mihing gama kakiselna ding le kachan nahi katin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Eikisuhneo behseh jeh-in, ka kana ngaijin, amaho kei sanga ahatjoh jeh-un, eibol gentheiho-a konin neihuh doh-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namin kavahchoi theinadin sohchan na-a konin kahinna puidoh in, nangman ninglhing keija neibolphat ding jeh-a, michonpha ten eiumkim veldiu ahi.
  </para>
  <chapter number="143" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai kataona ngaijin lang, kangehna-a nana sungin, nakitahna leh nachon phatna-a chun neidonbut in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nasohhi thutan na-a nei lutpi hih-in, ajehchu namitmu-a mihing khatcha chonpha aumpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu melman kahinna abolgimin, kahinkho hi tolla avolhun: sotna anathisaho bangin muthima eichen sah-e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun kalhagao kasunga athoh gimmin, kalungthim hi kasunga agoh ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khanglui nikhoho kageldoh in, nathilbol ho jouse kangaitojin, nakhut thilbolho kasutjin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nahenglam kakhutnin kahin sange, kahinna hi dangchah na gam bangin, nangma ngaicha-in adangchah-e. Selah
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai neidonbut loijin, kalhagao alhasamtai, leiko sunga kumsuh ho kabah lounadin, keija konin namai selmang hih-in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangma katahsan jeh-in, jingkah teng nalungsetna neijah sah-in, kahinna naheng lama kadop sang jing jeh-in, chena ding lampi neihetsah-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pakai kamelma te-a konin neihuh doh-in, nahenga kisel dinga hungjam kahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma ka Pathen nahi jeh-in nadeilam bolje neihilin, Na Lhagaohi aphai, chondihna gama neipuijin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai namin jal-in neihin sah-in, ajehchu nachon phatna jal-in, lungkham na-a konin kahinna hi puidoh-in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nahepina-a kamelmate subei jinlang, kahinna bol gentheiteho jouse sumangin, ajehchu nalhacha kahi.
  </para>
  <chapter number="144" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kakhutho galboldan, kakhut jungho galsatdan hillah; kahatna Pakai chu nunnom hen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahatnale kakulpi, ka insang le kakihuhdohna, kalumdal le katahsan kingapna, kamite kanoija kunsahpa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai, mihemhi ipi hija, nahiti lungvil tenna! ahiloule mihem chapahi ipi hija, nahiti khohsah ham!
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihemhi pannabei tobang ahin, anikhoho jong nisalim kiheimang bangbep bou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pakai navanho sonkunin hungkum lhan lang, molsangho chu tongkha lechun, meikhun lengunte.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kolphetsah inlang amaho sucheh-in, nathalchangho kapdoh inlang amaho sumangin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chunga konin nakhut hin lhangin lang, neilha doh-in, twipi nasatahho lah-a konle, gamdangmi chate-a konin neihuh doh-in;
  </para>
  <para style="p">
    <verse number="8" style="v" />Akamun thu manlou aseijun, akhut jetlamu chu joujou khut jetlam ahibouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pathen, nahenga lathah khat sange; tumging le manchah jangsom neijin nangma vahchoi La sange.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lengho henga huhhingna pe-a ama ahin, aman asoh David kisuhkhahna chemjam'a konin ahuhdoh-e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gamchom chate-a konin neilha doh-in, neihuh doh-in, akamun mohthu aseijun, akhut jetnu chu khutjet dihlou ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka chapateu khangdong ho chu thingphung khangtou bang uhen, ka chanuteu chu leng in ninga song kipotjola bang uhen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kachang inhou adima, akikholna jouse anenchet nadin, ka kelngoi teovin kakholai lamlen houva sang sangle sangsom cheng hinguhen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kabongchal hou natoh-a ahatnuva, kakholai houva thunoh asolouna din, golkeh louleh potdoh louvin umuhen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutobanga um miho chu avangpha ahiuve, henge, a-Pathen'u Pakai hia mite chu avangpha ahiuve.
  </para>
  <chapter number="145" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka Pathen, vo lengpa nangma vahchoi jingting, chule atonsot atonsotnin namin choi-an inge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aniseh-in choi-an ningting, chule atonsot atonsotnin namin vahchoi jinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai chu aloupi-in, sangtah-a vahchoi ding ahi; chule aloupinahi holdoh jouhoi ahipoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanatoh hohi khang khatnin, akhangkit geija avahchoija, chule thanei tah-a natohho aphon dohdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nalal loupina le jana chu keiman seijing ting, nathilbol kidangho seijing kate.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miten nathilbol gimneitahho thaneije seijuntin, chule keiman naloupina kaphonjal ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon lhingsetnin naphatna loupitah geldoh untin, chule nachon phatna chu la'n saovinte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai chu lungsetna le khotona-a dimset ahin, lunghang vahlou, chule hepina dimset ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai chu mitin din aphan; chule ahepina chu anatoh jouse chunga aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Pakai nathilbol jousen navahchoi juntin, chule namitheng ten nachoi-at dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon nalenggam loupije seijuntin, chule nathaneije asei dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Athilbol thahatje mihem chapate ahetsah ding; chule alenggam lal loupi ahetsah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nalenggam chu tonsot lenggam ahin, chule navai homna akhang khanga um jingding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakaiyin alhu jouse akaidingin, chule aki sonkunho jouse akaithouvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma velhijinga um mitjouse chu; aphatchan anehdiu napejin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangin nakhut najah-in, ahingthei jouse angaichat cheh-un nalung lhaisahjin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai chu alampi jouse-a chonpha ahin, anatoh jouse-a athenge.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakaiyin akoute jouse heng anaijin, dihtah-a ama koute jouse heng anaije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman ama gingte ngaichat suhbulhit peh intin, ataonao asan peh-a, ahuhhing diu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakaiyin ama ngailuho jouse hongbit nintin, migilou jouse vang asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kakamin pakai vahchoina thu asei ding ahi; tahsa mihing jousen amintheng atonsot atonsotnin vahchoi uhen.
  </para>
  <chapter number="146" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijun, Vo kahinna Pakai chu vahchoijin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahinlaisen Pakai chu vahchoi jingting, limle mel kanei laisen Pakai vahchoi la sange.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pipuiho chunga natahsana ngam hih-in; ama-a panpina umlou mihem chapate jong tahsan hih-in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahaina achedohjin ama aleisetnah akilejin; hiche ni chuleh alunggel jouse abeiji tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Akithopi dinga Jacob Pathen neikha-a; akinepna Pakai a-Pathen hikha-a michu anunnom ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vanle leiset chule twikhanglen le asunga umjouse sempa; a-imatih channa thutah tuhjingpa chu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman akijoulhepho thu atanlhah peh-in; aman agilkelho an apen ahi. Pakai chun sohchangho alhatdoh tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin mitcho ho ahasah-in; Pakaiyin akineosah hochu akaithouve: Pakaiyin michonpha ho angailui.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakaiyin kholjin miho ahongbitnin, aman pabeiho le meithaiho a-olsahtai; migilouho lampi vang akhup athallin alehjin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Zion na Pakai na-Pathen tah chun khangjouse chunga lengvai apoh ding ahi. Pakai chu vahchoijun.
  </para>
  <chapter number="147" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijun, ajehchu i-Pathen'u henga vahchoi la sah hi anomin; kipa aumin, chule vahchoi dinga lomtah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin Jerusalem asadoh-in; aman akinodohsa Israelte chu akhom khome.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman lungthima natna neiho asudamin; chule amaha puthou atompehjin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman ahsi ho jat aseijin; abonchauvin aminu avo soh keijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />I-Pakaiyu alenin, thahat tah ahi; ahetkhen themna chu akhonna bei ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin mi kineosah ho adomsangin; migiloute chu tolla aseplhan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thangvah pumin Pakai henga la saovin; i-Pathen'u henga selangdah tothon vahchoi la saovin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman van chu meilom'in atomin, leiset dingin go agongtoh-in, molsangho chunga kehdin hampa aseme.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman gamsaho a-an nehdiu apen; va-ah nou gilkelho aneh dingu apen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama sakol ho hatna-a akipahpon; mihem kenga jong kipana aneipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai chu ama gingte chunga akipah-in; ahepina-a kinemho chunga akipah-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Jerusalem, Pakai chu vahchoijin; vo Zion na Pathen chu vahchoijin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman nakul kotpi kotgol ho ahamsah-in; nasunga nachate phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nagam gi ho-ah cham alensah-in; suhlouchang phapenin nadipdim tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman leiset chunga athupeh ahinsol doh-in; Athu chu gangtah-in alhaijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman buhbang kelngoi mul bangin apen; buhlhah chu vutvam bangin athejaovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman abuhlhang ankong bangin athejalin; hiche adap masanga chu koi dingjou dingham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman thu apehleh hichu ajunlha tan; Ahui anunsah-in ahile twi ahung longtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman athu chu Jacob henga amusah-in; adan thuho le athutan chu Israel amusah tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman koima nam achutibol khapon; ama thutan lhahho jong amahon ahepha pouve. Pakai chu vahchoijun.
  </para>
  <chapter number="148" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijun, van ho-a konin Pakai vahchoijun; chungsang ho-a chun vahchoijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Avantil jousen, Pakai vahchoijun; ami janelten ama vahchoijun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nisa le lhathah-in ama vahchoijun; nangho ahsi vahho jousen ama vahchoijun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho vanlaijola vanhon ama vahchoijun; vanho chungvuma twipihon ama vahchoijun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon Pakai min vahchoi uhen; ajehchu aman thu apeh-a, amaho kisem ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman amaho tonsot atonsotna din aphutdetnin; apalkehlou diuvin thupeh apen ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangho dragon ho le twithuh ho jousen; Leisetna konin Pakai chu Vahchoijun;
  </para>
  <para style="p">
    <verse number="8" style="v" />Mei le gel, buhbang le meijun; khopi huijin athu aguilhunsah-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Molsangho le lhangho; thingphung ga phaho le cedar thingho:
  </para>
  <para style="p">
    <verse number="10" style="v" />Gamsaho le gancha jouse; tolla kitholho le chungleng vachaho:
  </para>
  <para style="p">
    <verse number="11" style="v" />Leija lengho le mihem jouse; pipuiho le leiset thutan ho jouse:
  </para>
  <para style="p">
    <verse number="12" style="v" />Gollhangho le nungah ho; tehse ho le chapangho:
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon Pakai minchu vahchoi uhen: Ama minbou chu chungnunpen ahin; aloupina leile van chungvuma uma ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mithengte jouse choi-at nan; Israel chate, ama kinaipi mite choi-at nan; Aman amite ki adomsangtai. Pakai chu vahchoijun.
  </para>
  <chapter number="149" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai vahchoijun. Pakai vahchoina lathah khat saovin lang; mithengte houkhom na-a ama vahchoina la saovin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chu ama hinsem Pa-ah kipah hen; Zion chate chu alengpao chunga thanomu hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lam to thon amin vahchoi uhen; khongchale selangdah-in avahchoila saohen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakai amite chunga alunglhaijin; Aman mi nunnem chu huhhingna-a ajephoi ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mithengte chu loupi na-in kipah uhen; ajalkhun hou chunguva gingtah-in la saohen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Akamuva Pathen sangtah-in vahchoi uhen; akhutnuva hemto chemjam kidop uhen;
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathen hephalouho chunga phulahna chuhsah dingle mitin chunga engbolna chuhsah ding;
  </para>
  <para style="p">
    <verse number="8" style="v" />Alengteu thihkhaova hen dingle, amilalteu thihbul tuh ding;
  </para>
  <para style="p">
    <verse number="9" style="v" />Thutanlhah kijihdohsa achunguva tongdoh dingin, hiche jana hi amithengte jousen aneijun ahi. Pakai chu vahchoijun.
  </para>
  <chapter number="150" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai chu vahchoijun. Amuntheng sunga Pathen vahchoijun, athil boltheina vanthamjol lah-a ama vahchoijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anatoh kidangtahho jal-in ama vahchoijun, alet loupina dungjuijin ama vahchoijun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sumkon ginnin ama vahchoijun, tumgingto selangdah-in vahchoijun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khongchale lamin ama vahchoijun, tumging tho-a manchah le semjang binei tho-in vahchoijun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khutbeh ginnin ama vahchoijun, khutbeh gin thong jejun ama vahchoijun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Haitheina neijousen Pakai chu vahchoi uhen, Pakai chu vahchoijun.
  </para>
</usx>
