<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="SNG" style="id">Solomon Labu</book>
  <para style="h">Solomon Labu</para>
  <para style="toc1">Solomon Labu</para>
  <para style="toc2">Solomon Labu</para>
  <para style="mt">Solomon Labu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Laho lah-a la, hichehi Solomon la ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman ami chopna akama chun eihinchop hen, ajehchu nangailutna chu lengpitwi sangin atuijon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma thaotwi phatah ho namtui jeh-in, na min chu thaotwi hung longdoh abangin; hiche jehchun nungah thenghon nangma nangailu uve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Neikai jin, keihon nanunga hung lhaijunge; lengpan keima a-indan sung eilhuttai. Keiho nangma-a kakipaova kathanop diu ahin, chule neingailut nao chu lengpitwi sanga kageldoh jingdiu ahi, lungdih tah-in nangma nangailu uvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keima kavome, ahinla vo nangho Jerusalem chanute, keima Cedar ponbuh ho le Solomon pondal hobangin kamellome.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kavom jehle, nisan eisah jeh-in, neive hih-un; kanu chapateho alung hangun; lengpilei ho eingah sah-un; ahinla keima tah-in lengpilei kangahpoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo kalhangai, nangman nakelngoi hon hoilaija navah-a, sun teng hoija nagakol sah jiham, neisei peh-in; ipijeh-a nagol ho kelngoihon lah-a mikhat vahlele banga kaum dingham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo numei ho lahlah a melhoipennu, nangman nahetlouva ahile, nakelngoihonho cheche nalama chenlang, chule kelngoi chingpa ponbuho komdunga chun nakelngoi nouho chu vah-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo kangainu, keiman Pharaoh kangtalai kai sakol honkhat toh nangma kahin tekah-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nabeng teni-a kijepna kigolho chu nakilompin, nangonga sana khivuiho chun namel lomsah-e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keihon sana-a kijepna kasem pehdiu, chule akilmatnaho dangka-a kasem dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lengpa adokhanga atou chun, kathao namtui namchu ahung potdoh-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kangaitah chu keija din myrrh lomkhat ahin, jankhovah-a kanoi teni kah-a lumding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kangai chu keijadin Engadi lengpilei honsunga ponlou thingphung abilla kehto bang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kangainu, ven, namel ahoije, ven, namel ahoije, namit teni vakhu mit abange.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kangaipa, ven, namel ahoije; henge, dei-umtah nahi! ijalkhun jong a-eng selin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />I-inkam jouse cedar thingjeng ahin, chule i-insung jouse jong chahthing jeng ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keima Sharon pah le, phaicham ho-a lily pah chu kahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />ling le khaoho lah-a Lily pah bangin, chutobang chun kangainu chu nungah ho lah-a aume.
  </para>
  <para style="p">
    <verse number="3" style="v" />Theithup thing gammang thinglah-a aumbangin, chutobang chun kangaipa chu golhangho lah-a aume. Keima alimnoija chun kipah tah-in katouvin, chule aga chu kateple alhum keijin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amapan keima nehkhom na ina eipuilutnin, chule kachunga apondal chu ngailutna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lengpitwi jin neilhon lang, theithup changhon neilung monin, ajehchu ngailut natna-a na-a kahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Akhut veilam kalu noija aumin, chule akhut jetlama chun eikoije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo nangho Jerusalem chanute, loulaija sakhigol anuho le achalho panna kathupeh nahiuve, ngailutna hi ama chamtah-a ahung um tilouvin, nanghon suhthou tho dingle suhkhah thoding gohih-un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kangaipa aw kajai! Veovin, ama molsang ho chunga kichom pumle, lhangho chopkhup pumin kaheng lama ahunge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kangaipa chu sakhigol ahiloule sakhinou tobang ahi; ven, ama kabang tomuva adinge, bangkot ho-a konin aven, bang vangkah-a konin ahung khodah-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kangaipa chun thu ahin seijin, chule keima henga: hungthouvin, kangainu, keija dia melhoinu, hungpot dohtan.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu vetemin, phalbi akichaitan, gojuh phat akichaijin chule kho aphatan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leiset chunga pahchaho ahung kilang doh-in, lasah phat ahung lhung tan, chule igam sunguva vahui ham gin akijatai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Theichang phung jong ahung gadohtan, chule lengpiguiho jong aga dongset toh agim namtuitah ahin pedoh tai. Thouvin kangainu, keidia melhoinu, hungpotdoh jengtan.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo ka vakhu, songpi khikehkah le, songkol kalbi kidona mungil laiho-a chengnu, namaiso neimu sah inlang, na aw neijah sah temin, ajehchu na aw angeijin, chule namaiso jong amel lomin ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lengpilei suse-a sial ho, chule sial nouho neimatpeh un, ajehchu kalengpigui gahou adongset nalaijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kangaipa chu keija ahin, chule kei ama-a kahi. Aman Lily pahho lah-a akelngoi hon avah-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kho ahung vah-a, chule le-limho akitolmang kahsen, hung kiheijin, kangaipa, Bether mol chunga lhale sakhi chalgol, ahiloule sakhinou bangin hung umin.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Janle kajalkhun chunga keiman kalhangaipa chu kaholjin; ama kahol lelen, ahinla kamu joupon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keima, tun thouving ting, khopi sunga vahleng ting, kholai dung le lamlen ho-a kalhangaipa gaholinge, katin; ama kahol lelen, ahinla kamu joupon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khopi vil le-a khongah ho chun eimuvin, keiman ahenguva, keiman kalhangaipa nanamu uvem? tin kadongin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho themcha khatbou kagahkhel panbep nalaijin, keiman kalhangaipa chu kakimudoh paitai: keiman amapa chu eihinga kanu in, eina vopna indan sung kalhut kahsen katuh detnin kalhakang pon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo nangho Jerusalem chanute, loulaija sakhigol anuho le achalho panna kathupeh nahiuve, ngailutna hi ama chamtah-a ahung um tilouvin, nanghon suhthou tho dingle suhkhah thoding gohih-un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Meikhu khompi banga, myrrh le thao namtui gim namsela, sumkolvei pa thao namtui jouse pumma gamthipma kon hungdoh-a khu koiham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Veuvin, Solomon talai ahi; chuche kimvella chun pasal hangsan cheh somgup aumuvin, Israel lah-a ahangsan cheh ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Galsat themsa cheh ahijeh-un, abonchauvin chemjam akichoijun; Jan kichat tijatna jeh-in, amijousen achemjamu ataijuva akiko cheh-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Solomon lengpan Lebanon thingin, talai khat akisemin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman akhom jouse dangka-in, alhong sana-in, chule achung khuse chu ponsandup min asemin, alailung chu Jerusalem chanuten dei umtah-in asemun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo nangho Zion chanute, potdoh unlang, ajinei nikho, alungsung kipa nikho-a anun lallukhuh akhuhpeh kikhuh-ah Solomon lengpa khu gaveovin.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ven, kangainu, namel ahoije! ven, nahoilheh jenge, namai khuna pon kah-a namit teni vakhu mit abangin, nasam jong Gilead molsanga kona hungkumlha kel hon abange.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nahaho chu kelngoipi hon amul akivojoutil akisil joutil uva ahungpot doh-u toh abangun; amaho asohkop cheh ahiuvin, alah uva nouneilou khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nane teni jong patsan abangin, nakam jong ahoilheh jengin; nadeh pang jong nasamlom lah-a kolbuthei uma abangin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na-ngong jong mihat ho lumdal sangkhat kikhaina, David'in galvon koinadinga asah insang abangin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na noi teni jong sakhinou ni pengkop, lily pah lah-a lhale abange.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kho ahungvah-a nilimho akitolmang kahsen, keima myrrh molsang lama chule bego molsanga gaum ingkate.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namel akilome, kangainu, natichung-ah nolnading ima aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Labanon'a konin chekhom hite, kajiholnu, Lebanon'a konin kilhon hite; Amana lhangvuma konin, Shenir le Hermon lhangvuma konin, keipi bahkaiho kul-a konin, chule lutnu molsang ho-a konin vetemin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kasopinu, kajiholnu, nangman kalungsung nalajoutai; nangman namitna khatvei neihinvet le, na ngonga khivui khatna konin kalungsung nalajoutan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kasopinu, kajiholnu, nei ngailutna hi iti noptam! na ngailutna hi lengpitwi sanga iti phatjoh hitam! Nathao kinujol jong gimnamtui jouse sanga iti namtui joh-a hitam!
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo kajiholnu, nane teni, khoiphanga kon khoiju tobangin ahung valhan; khoijule bongnoi naleigui noija aume; chule naponsil ho namtui dan Lebanon gimnamtui abang jengin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kasopinu, kajiholnu chu hon kiget khum ahin; twisam kiting, twinah kihuh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na thingphung ho jong kolbuthei hon, aga hoitah-a ga, ponlou namtui thing le thao namtui thing,
  </para>
  <para style="p">
    <verse number="14" style="v" />Thao namtui le thing namtui, Aigeju le thingthal, begothing jouse toh; myrrh le aloe, chule anamtui penhotoh,
  </para>
  <para style="p">
    <verse number="15" style="v" />Twiputna honleiho, hintwi twikhuh, chule Lebanon'a hungkona luidungho abang jengin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo sahlam hui, khangin, chule lhanglam hui, hungin; kahon sunghi gimnam tuihon alosohna dingin hung nungin. Kangaipa chu ahon sunga hunglut henlang, atheiga hoitahtah hohi hung nehen.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasopinu, kajiholnu, keima kahonsunga kahunglut tan; ka myrrh le ka gimnamtui kakikhol khomtan; kakhoibal le kakhoiju kanetan; kalengpitwi le kabongnoi kadontai. Neovin, vo loile golte; donun, nengtah-in donun, vo kangailut teho.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keima kalumin, ahin kalungthim akhangjinge; kangailutpa aw kajai, aman kot akiuvin, kot neihonin, kasopinu, kangailutnu, ka vakhu, keija dia chamkimnu; ajehchu kaluchang daitwijin atomin, kajang sam kisom jong jandaitwi lha-in adimtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kasangkhol chol kasutlha tai; iti kaki-ah ding hitam? Kakeng kakisop joutai; iti kasuhbohkit ding ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kangaipan kot-hom kah-a akhut ahin lhunglut nin, ama gelnan kalungsung akihot jengin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kangaipa kot honpeh dinga kathodoh leh, kakhutna myrrh avalha-in, chule kakhutjung ho-a gimnamtui avalhan, kotkilna chunga chun achu-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kangaipa chu kot kahonpehtan, ahinla kangaipa chu akihei mangin, anachetai. Aman thu aseichun kahinna alhasam jengin ahi. Keiman ama kahol holin, ahinla kamujou dehpoi; keiman ama kakouvin, ahinla eidonbut tapoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khopi sunga vahle khongah hon eimudoh-un, eivouvin, eimavo taove; kulpi ngahhon kaponlukhu eilah mangpeh uvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Jerusalem chanute, keiman thu kapeh-u nahi, nanghon kangaipa namu-ule, ama ngaina-a na-a kahitai, tin neinasei peh-un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Midangin adeipa sanga nangin nadeipa chungnungjo dehham, Vo nangma numei lah-a hoichungnung nu? Midangin adeipa sanga nangin nadeipa chungnungjo dehham, nangman chuto bangtah-a nei gahchah-u chu?
  </para>
  <para style="p">
    <verse number="10" style="v" />Kangaipa chu angou seh-in avouso asan heovin, sangsom lah-a achungnung penin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aluchang jong sana thengset abangin; asamho jong aboh litlet nin, chule va-ah bangin avomsetnin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amit teni jong vadung panga uma vakhu mit, bongnoija kisop thenga kitoh chetna kibut abangin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abeng teni jong gimnamtui kikholna, pahcha namtuitahho abangin; aneho jong myrrh gimnamtui tah valha le, lily pahcha abange.
  </para>
  <para style="p">
    <verse number="14" style="v" />Akhutteni jong sana khutjem achunga khisong engdum abangin; atahsa jong saiha kisuitoh bangleh khisong duma kilut abange.
  </para>
  <para style="p">
    <verse number="15" style="v" />Akengteni chu songval khompi bangleh sana thengset khom tunna chunga kitung abangin; Amelput chu Lebanon thing bangle cedar thing hoipentah toh abange.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akam jong aphata ngeijin, amachu lamjousea dei aumin ahi. Vo Jerisulem chanute, hichehi kangaipa chu ahi, hichehi kagolpa ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangaipa chu hoilamma chemanga hitam? Vo nang numei lah lah-a hoichungnung nu, keihon ama kaholhu theina diuvin, nangaipa hoilanga kihei manga ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Kangaipa chu Gimnamtui umna honsunga, aganhonho vah dingle, lily pahho loukhom dingin, ahon sunga achelutnin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima kangaipa-a kahi, chule kangaipa chu keija ahi; ama lily pah lah-a aganhon avah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo kangai Tirzah bangin nangma nahoije, Jerusalem bangin namellomin, ponlap dom galmi honpi bangin tijat na-ume.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keijakonin namit teni heidoh-in, ajehchu hiho chun eisuboije. Nasam chu Gilead'a kona hungkumlha kel hon abangin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nahaho chu kelngoipi hon amul akivojoutil akisil joutil uva ahungpot doh-u toh abangun; amaho asohkop cheh ahiuvin, alah uva nouneilou khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nadeh pang jong nasamlom lah-a kolbuthei uma abangin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lengnu somgup, thaikem somget, chule nungah theng simjoulou aume.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kavakhu, keija dia chamkim, keija dia khatseh bou ahi; anu-a dia cha changkhat ahin, chule ahingnu deilhenpen ahi. Nungah ho, lengnu ho chule thaikem hon amanu amuvin, nunnomnu atiuvin, chule apahchao vin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jingkah banga hung vahdoh-a, lhabanga hoi, nisa banga thengset, chule galmi ponlap domhon khat banga tijat umhi, koi numei ahitabep dem?
  </para>
  <para style="p">
    <verse number="11" style="v" />Phaicham theiga ho ve dingin, lengpiguiho mumtam ve dingle, kolbuthei ho pahtam ti ve dingin, keima beleilut honsunga kachesuh-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kahetmanlou hellin kahinna-in, Amminadib sakol kangtalai bangin eina semtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hungkilen, hungkilen, vo Shulam nungahnu; keihon nangma kavet theina dingun; hungkilen, hungkilen. Shulam nungah nu-a hi ipi navet dingu ham? Galsatmi hon ni umkhom banga?
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo leng chapa chanu, nakeng teni chu kengkoh naseteng iti hoija hoi hitam! namalbul teni kisuhtona jong sana-a kisem abangin mikhut themtah ho khutsem abange.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nalai jong jutuitah lhasam khalouhela dimjing khon bempel abangin; na-oi jong suhlouchang kihuivum lily pah-a kijem abange.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na noi teni jong sakhinou ni pengkop, lily pah lah-a lhale abange.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na-ngong jong saiha insang abangin; namit teni jong Heshbon'a Bath Rabbim kotpiphunga twikul abangin; nanah jong Lebanon insang Damascus lam nga-a abange.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nachunga naluchang chu Karmel abangin, naluchanga nasamjong ponsandup abangin; Nasam lom phatah chun lengpa soh henin ahenin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Iti hoija nahoija chule iti dei naum hitam, Vo kangainu, kipana dinga!
  </para>
  <para style="p">
    <verse number="7" style="v" />Natun jong tumphung bangin asangin, chule nanoi teni jong lengpiga bohthet abang jenge.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keima tumphung chunga kalingting, abahho gatuh inge, katin: Tun nanoi teni chu lengpiga lomho bangen lang, nanah-a hu hungpot gimnam chu theithup namtui banghen,
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nakam chung chu lengpitwi phapen tobang hihen. Lengpitwi chu kangaipa-a dingin tuitah-in alongsuh'in, a-imu pa muh chu nemheu chan achaloh sah-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima kangaipa-a kahin, chule angaichat chu keima-a uma ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hungo, kangaipa, loulama chedoh hitin; khoneo ho-a gageh hite.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jingpi matah-in lengpi hona chehitin; lengpigui mumtam gave hitin, lengpiga mumho pahlha tam gave hitin, chule kolbuthei ho pahtam gavetem hite; chua chu kangailut na kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kangaipa, Joldei-ai hon jong anam tuitah alhadoh-un, chule ka kelkot phunguva theiga tuitahtah namkim athah le alui nanga dia kakoisa aume.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Oh, nangma kanu noi hinchepma kapenpipa ana hitavele chun katitave! Pamlama kahinmu teng jongle kahinchop ding nahi; henge, i-sah louva kaumlou ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nangma kalamkaija kapui puiding eina hil jinga kanu insunga kapui lutding, ka kolbuthei twija kon kisem ju gimnamtui kadonsah ding nahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akhut veilam kalu noija aumin, chule akhut jetlama chun eikoije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo nangho Jerusalem chanute, keiman nangho kathupeh nahiuve, ngailutna hi ama chamtah-a ahung um tilouvin, nanghon suhthou tho dingle suhkhah thoding gohih-un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angainu chunga kingaija gamthipma kona hungdoh khu koi ahitadem? Theithup phung noija kathodoh nahi; chua chu nanun nanahin ahin, chua chu nahingnun nahin hindoh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Suhdetna kinamkhum bangin nalungsunga neinam detnin lang, nabanna jong neinam detnin; ajehchu ngailutna hi thina bangin athaneijin, thangthipna jong lhankhuh bangin a-engse-e; amei chu meikong ahin, meikong nasa pentah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Twi tamtah in ngailutna asudai joupoi, twisang lenho jengin jong alhoh joupoi; min ngailutna dingin a-insunga anei jouse pedohsoh jongle, ima-a simkham hilou lai ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keihon sopi numeinu khat kaneijuve, amanun noi aneihih laije; amanu min ahungdoh nikho teng kasopinu diuvin keihon ipi kabolpeh tadiuvem?
  </para>
  <para style="p">
    <verse number="9" style="v" />Amanu hi bang hitale, achunga leng inpi dangka-a kasah diu ahi. Chule amanu hi kotkhah hitale, cedar thingpeh-a katom dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima bang kahi, chule kanoi teni jong insang tobang ahi; chuin keima ama mitteni-a lungmonna mu-a tobang kahung hitai
  </para>
  <para style="p">
    <verse number="11" style="v" />Solomon'in Baal-hamon'a lengpihon khat ananeijin; aman lengpihon chu angahho angansen; mitinin ahonsoh ga man dangka sangkhat cheh ahin pehlutdiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kalengpihon keima angsunga aumme. Vo Solomon, nangma sangkhat nachan ding, chule aga ngahho chu jani changding ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho hon leilaija chengho, golle paiten na aw angai juve hichu keijong nei jahsah-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hung kikinsah in kangaipa, gimnamtui molsang ho chunga chun nangma sakhi chalgol ahiloule sakhinou tobangin hung umin.
  </para>
</usx>
