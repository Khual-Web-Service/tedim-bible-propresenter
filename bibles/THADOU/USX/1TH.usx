<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1TH" style="id">1 Thessalonica</book>
  <para style="h">1 Thessalonica</para>
  <para style="toc1">1 Thessalonica</para>
  <para style="toc2">1 Thessalonica</para>
  <para style="mt">1 Thessalonica</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Paul, Silvanus chule Timothy'n, Pa Pathen le Pakai Jesu Christa-a um Thessalonica houbung mite hengah: i-Pau Pathen le Pakai Jesu Christa-a kon lungsetna le chamna naheng uva umhen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Katao chanun nangho kamin phah uvin, nangho nabon chaova dingin Pathen kathangvah jingjiuve;
  </para>
  <para style="p">
    <verse number="3" style="v" />Keihon tahsana nathilbolu, ngailutna-a nathohgimu, chule I-Pakaiyu Jesu Christa-a kinepna neija nathohhatnau chu i-Pathen'u le i-Pau anga sumil louhelin kageldoh jingui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen'a sopi deitahho, lhendoh nahiu chu kaheuvin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Kathu hilu Kinepna Thupha hi thu keo jenga nahengu hung lhunga hilouvin, thilbol thei thahat le Lhagao Thenga hetna kichentah-a hungjoh ahi, keiho nangho dinga itobang mi kahiu nanghon nahenaove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangho hesoh gentheina nasatah lah-a Lhagao Theng Kipana-a thu chu anasanga, keihole Pakai umchan tho-a nahitaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutia chu Macedonia le Achaia gama um atahsanho dinga vettoh-a jui dinga uma nahitaove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu nangho-a kona Macedonia leh Achaia gam sunga Pakai thu chu jaldoh ahi, chule hiche jeng chu hilouvin, Pathen lama natahsan jeu chu gamtinah akithangtan ahi; keiho seisei angaipoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu amahotah-in keiho umchan thudol nangho kom kahung lutjeu umchan, chule nangho Pathen hingle dihtah chu hou dinga,
  </para>
  <para style="p">
    <verse number="10" style="v" />chule khonunga hung lhung ding lunghana kona eihuhdoh uva Achapa Jesu, athia kona akaithou chu, van'a kona ahung ding ngah dinga, milim houva kona Pathen lama nakiheijiu chu ahillhangleu ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti chu ahin, sopiteho, naheng uva kahungu chu moh ahipoi, ti nangho tah-in nahenaove;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin amasanga Philippi khopi-a hesoh genthei kathoh-a chule jachat umtah-a eikibol jenga jong, hichu nahetsao ahi; hangsana no-a Pathen Thupha chu nangho jah-a sei dinga ka Pathen uva hangtah-a kanapan-u ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu kathu hilu hi suhkhela kon ahipoi, thenlouva kon jong ahipoi, doha-a jong ahipoi:
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin Pathen'in aphai tia eitahsan jeh-a thupha vopsah dinga eigot bangtah-a thu kaseiju ahibouve; mihem lunglhaisah louva kalung sungu photoh Pathen lunglhaina kaseiju ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Imatih chana pachat lhem pan lou kahiuve, hichu nanghon naheuve, papset khuna-a jong mangji lou kahiuve, Pathen ahetoh ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Christa solchah kahiu hi, thu neitah hiding kahiuvin, ahivangin nangho nahiuvin, mi dang ahin koimacha-a konin ginle ja kahol pouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nalah uva nunnem tah numei anaonoi pelaijin achate akhoukhah banga,
  </para>
  <para style="p">
    <verse number="8" style="v" />nangho kakhoto jeh uva Pathen Thupha jeng hilouva, nangho kadeitah-u nahitah jeh uva, keihon kahinna chengu kisana nangho peh ding kalungu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu, sopiteho, katohgimle kagun chunao nalunguva aumnai; nangho koima chunga pohgih pohsah louna dinga, asun ajana na katoh jiuva najah uva Pathen Thupha kaseijiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule atahsan nangho lah-a thengtah-a, chonphatah-a, themona beija iti kachonum, ahetoh-a nangho nahiuvin, Pathen jong ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pathen gama dingle aloupina-a dinga nakou paova dinga lomtah-a nachonna dingu tia apan achate ahil banga,
  </para>
  <para style="p">
    <verse number="12" style="v" />Keihon jong nangho amichangkima thu kahiluva, katilkhoujiuva, chule kahet tohsahjiu nahiuve, hichu nanghon naheuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche jeh jong hin tang louhelin Pathen kathangvah jingui, nanghon keiho-a kona thu, Pathen thu najah uva chu, mihem thu ahi tia hilouva, Pathen thu tia nalah-u ahibouve; hichu tahmong ahi, chujongle hiche chun atahsan nangho lah-a na atonge.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu, sopiteho, nangho Juda gama Christa-a um Pathen houbung ho umchan joma nahitaove; amahon Juda miho-a kona athoh banguva nanghon jong nagam miteuva kona chuto bangma chu nathoh-u ahitai:
  </para>
  <para style="p">
    <verse number="15" style="v" />Amaho chun Pakai Jesu jong athemgaohou jong athaova, chule keiho jong einomangu ahin, Pathen alunglhaisah louvu ahi, chule mi jousetoh kilekal ahiuve:
  </para>
  <para style="p">
    <verse number="16" style="v" />Amahon keiho chidang namdangho huhhing-a aumna dinguva, thu kaseipeh dingu eikhamui; achonsetnao bukip molso jing ahiuve; ahinla lunghan khonna achunguvah achunai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin, sopiteho, lunga hilouva tahsa lama nang hotoh kikhena kaum tahdi jeh hin, kangai lutnun namaiju mu ding kaki habol chehjin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichena ding chun, keiho ahideh chu keima, Paul, khatvei, nivei nangho heng lama hung ding kakigot ahitai, ahin Satan'in eisumojin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu I-Pakaiyu Jesu ahung tengle a-angsunga kakinepnao, ahiloule kakipanao, ahiloule loupina lallukhuh chu ipi hiding ham? nangho nahi lou uham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh inem itile tahbeh-in kaloupinaole kakipana dingu nangho nahiuve.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jeh-a chu kathoh jou loutah phatnuva, Athen kho-a kachanga eikida lhah pha kasa taovin ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />hiche hesoh thoh jeh-a chu koima alunglao naum louna dinguva, nangho phutdet dingle tahsan thu lama nalungmon sah dinguva, Christa Thupha lama Pathen lhacha le isopiu chule itoh khompiu Timothy naheng uva kahinsolu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu hesoh thoh dinga pang kahiuve, hichu nanghon nahenaove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hesoh thoh ding ihiuve, tia masanga nangho koma kaum laijuva kaseisao ahi; chujouvin kati bang chun asohtan ahi, chule hichu nanghon naheuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche jehtah chun keiman jong kathoh theilou phatna, ajole lhem chun nangho lhemlha taleu chun katohgim nau moh hikhante, tia hiche jeh-a chu natahsan jeu chu he dinga kahinsolu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin tun Timothy nangho koma konin ahungin, Kipana Thupha, natahsan jeule nangailut jeu, chule nangho mu katup banga nanghon neimu nomu phatecha neigel doh jingu thu ahinpoh phat hin,
  </para>
  <para style="p">
    <verse number="7" style="v" />sopiteho, nangho tahsan thudola keiho kahesoh genthei naova kalung mongui;
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu tu-a nangho Pakaiya na-umdet jingule, keiho ahinga kahitaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu i-Pathen'u anga nachung uva kakipanao jouse jeh-a hi, nangho chungchanga Pathen itobang tah-a kathang vah dingu hitam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Namaiju kamu theina dingu le natahsan bulhin lounao kasuhbulhit theina dingun, asun ajanin kaha tao dehset jengui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun i-Pau Pathen'in chule I-Pakaiyu Jesu Christan nangho heng lama eipuijuhen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangho kangailut bangu hin, Pakaiyin nangho khatle khat kingailutna le mi jouse ngailutna-a nabelap uhen lang, naletset sah-u hen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutile I-Pakaiyu Jesu Christa amithengte jousetoh ahung tengle, i-Pau Pathen anga nalungthimu thenna lama themona beija aphudet ding ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahile, sopite, achaina keijin, keihon Pakai Jesu'a nangho chu kajoluva katilkhou nahiuve, chutia chu Pathen lunglhaisah nadinga iti chon dingham ti thudol chu keiho-a kona nalah bangu chun chon jom jingun, neiletset jing jengun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh chu Pakai Jesu'a nangho ipi thupeh kapeh-u nanghon nahenaove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho jon na-a kona nakikangse uva naki suhtheng dingu chu Pathen lunglam ahi:
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho amitakipmin thengsel le jabolin nabel cheh-u phatea kivopje heleu chun ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen helou chidang namdangho banga huh pan louvin:
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichun chonvalin koiman hiche lamdola hin asopi dohan boldahen; ajeh chu masanga nangho kaseipehsao, kahettohsahsao banga chu, hitiho phula-a chu Pakai ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathen'in eiho aboh dinga hilouva, atheng ding joh-a eikouvu ahibouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun ajop lou chun mihem ajop lou hita louvin, A-Lhagao Theng napepao Pathen chu ajop lou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kisopi ngailut thudola vang hinsun hih jong leng akhoh poi; ajeh chu khatle khat kingailut dingje Pathen'a kona kihilsate nahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Macedonia gama cheng sopite chunga hichu nabolu ahi. Ahivangin, sopite, katil nahiuve, haletnin neilet chehleu chun kati;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule kathu peh bangu chun kangkhen cha umje kichuh-un, nangma kincheh kibolun chule nakhut tah-a nakitoh kihabol leuchun kati,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutile polama um miho chunga ngeikeicha naumthei dingu ahi, chule lhahsamna nanei louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sopiteho, kinepna bei midangho banga nangho lungkhama naum louna dingun, a-imumil teho thudol helouva naum dingu kanompoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu athin athoudoh kit tai, ti hi itahsan uva ahile, Pathen'in Jesu'a ihmumil teho jong chu amatoh thakhatna ahinpui ding ahi, ti iheuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche jeh-a chu Pakai thua kona hiche thuhi kaseipeh nahiuve, eiho Pakai hung geija anahing nalai chengse hi, a-imusaho sanga iti nama jongle masajo lou ding ihiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajeh chu Pakai chu amatah a-awtoh, vantil pipui awgintoh, chule Pathen sumkon gintoh kitho-a van'a kona hung kumlha ding ahi; chule Christa-a thisaho chengse thoudoh ding ahiuve;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujoule eiho ahingnalai amoh chengse hi, amaho chengse chutoh vanlaijola Pakai lamto dinga mei kong'a toltouva i-um khom dingu; chule chutia chu a-imatih chana Pakai toh i-um khom jing dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche jeh chun hiti thu hin nangho khatle khat kilhamon touvin.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahivangin, sopiteho, hiche chu anikhole aphat thudol naheng uva hinsut ding angaipoi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh chu jana gucha ahung banga, Pakai nikho chu hung ding ahi, hichu nanghon kichenin naheuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihon, Chamnale lungmon, chule bitna aume, tia asei laitah-ule, numei naoso nat banga, phulou helouva manthah na chu achunguva hung chu phung jeng ding ahi; hitia chu amaho chu iti nama jongle sohcha louding ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin, sopiteho, gucha banga hiche nikho chu nachung uva ahung lhun ding chu, nangho muthima uma nahipouve;
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangho nabonchaovin khovahle sunlai chate nahiuve; eiho janle muthim mi ihipouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche jeh chun, sopiteho, midangho banga imu louvin, limgehchan kihongpha jingin umu hite.
  </para>
  <para style="p">
    <verse number="7" style="v" />A-imuho khu janlebou imujia ahiuve; chule jukhamho jong janlebou akhamjiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Eiho vang sunlai chate ihi jeh-un, tahsan leh ngailut ompho kivon thou hite, chule huhhinga um kinepna chu lukhuh-a neijin limgehchan hah jingin umu hite.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu eiho lungsat chuhna dinga hilouva, I-Pakaiyu Jesu Christa vanga huhhing chu ichan theina dinguva, Pathen'in eipansah-u ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Eiho hah jing jongleu hen imu jongleu hen, Christa toh ihinkhomna dinguva, ama eiho dinga thia ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun nabol bangu chun khatle khat kitilkhou touvin, kisadohton umun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sopiteho, naheng uva kahung tao ahi, nalah uva natong gima, chule pakaiya nachung uva kitunga nangho natilkhou ho chu heuvin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho chu anatoh jal-u chun ngailutna-in hajan jabolun. Nangho kitohdel chehchan umun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule, sopiteho, kahintil nahiuve, angai dol louva chonho chu phohsalun, hilchah-un, alung doija tilkhou vun, ahatmo athadoi huvin lang, mijouse koma kido hatnun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chingtheijun, koiman setna chu setnan thuh hihhen; ahin khatle khat chule mijouse phatna ding bolnan kihabol cheh-un.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kipah thanom jingun;
  </para>
  <para style="p">
    <verse number="17" style="v" />tantih neilouvin taojingun;
  </para>
  <para style="p">
    <verse number="18" style="v" />imajousea thangvah jingin umun; hichu Jesu Christa-a nangho chunga Pathen lunglam ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lhagao Theng chu sumit hih-un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lhagao thu seidoh ho chu musit hih-un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Imalam jouse patep cheh-unlang apha chu tuhdet jingun:
  </para>
  <para style="p">
    <verse number="22" style="v" />aphalou jouse-a konin kikhin mangun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule cham kona Pathen'in nangho kimkeijin thensah-un; chule I-Pakaiyu Jesu Christa hung tengle nangho chengse lhagao, nahinnao chule natahsao themona beijin koihen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangho nakoupao chu tahsan umtah ahi, ama chun hichu bolpeh naovin nate.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sopiteho, keiho dingin neitao peh-un.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kibengchop thengin sopite jouse salam-un.
  </para>
  <para style="p">
    <verse number="27" style="v" />Keiman nangho Pakaiya kahahsela hiche thuhi kapeh nahiuve, hiche lekha hi sopithengte jouse angah anasimun.
  </para>
  <para style="p">
    <verse number="28" style="v" />I-Pakaiyu Jesu Christa milungsetnan umpiuvin, amen.
  </para>
</usx>
