<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LUK" style="id">Luke</book>
  <para style="h">Luke</para>
  <para style="toc1">Luke</para>
  <para style="toc2">Luke</para>
  <para style="mt">Luke</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />I-lah uva tahsan umtah-a guilhung hiche thilho chu adungjui tah-a sun dinga mi tahtah-in akhut apat tah banguvin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Atil abula patna amit tah-a muho le athu seiphonga panghon eihil bangun,
  </para>
  <para style="p">
    <verse number="3" style="v" />Michung nung Theophilus, ijakai abula patna chamkim keija hetna kaneito lhonin, nangma henga adungjui tah-a hin sutding pha kasan ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma nakihilsa thilho chengse chu adihtah ahi ti nahetna dingin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Judah gam lengpa Herod lal laijin, Abia loi lah-a thempu khat amin Zachariah kiti aumin; chule a-inneipi chu Aaron chilhah ahin, amin Elizabeth ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ani lhona Pathen mitmu-a chonphatah, themona neilou Pakai thupeh jousele chonna danthu jouse jui kimkeija ahi lhone.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hinlah Elizabeth chu achiin jeh-in cha aneilhon pon, chule ani lhonin hateh-in ateh gel lhontan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi, aloite aban bana akilhah dungjuija Pathen anga thempu na atoh petnin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Thempu chonna ngaija Pakai houin'a alutchun thil namtui halding chu achang khatan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule thil namtui ahal pet chun mipi chu polama ataovun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche pettah chun Pakai vantil khat ahengah ahung kilah in, thil namtui kihalna maicham jet lama chun ahung dingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zachariah'in ama chu amu phatnin, alungkhamin, chule ki jong akichan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amavang vantil chun ama jah-a, Zachariah, kicha hih-in, nataona akisangtai; chule na-inneipi Elizabeth chun chapa khat ahin ding, chule nangman amin John nasah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nangma dingin thanopna le hapa kipana hintin, ama pena chu mi tamtah kipah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ijeh-inem itile ama chu Pakai mitmu-a lentah hiding ahin, chule ama chun lengpiga twile ju adon louhel ding ahi; chule anu oisunga auma patna Lhagao Theng dimset ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman Israel chate tamtah a-Pakai Pathen'u henga alehei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule kigosa dema umho chu Pakaiya dinga kigotsah dinga, apate lung achate lama heija, michonpha ho chihna thua nungloute chonsah dinga, aman Elijah lhagao le thahat akena ama masang sanga che ding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Zachariah'in vantil jah achun, Keila katehtan, kaji jongla atehtan, hiche thuhi iti kahet them thei dingham? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin vantil chun adonbutnin, Keima Pathen anga ding jing Gabriel chu kahi, nangma jah-a thusei dingle hiche thupha hi seipeh dinga hungkisol kahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule ven, aphatcha guilhung ding kasei thu natahsan lou jeh-a, athu guilhun ni kahse-a thusei thei louva paomo-a naum ding ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule miho chun Zachariah chu angah-un, Pathen houin sunga aum sotden chu adatmo lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ahungdoh phatnin ajah uva thu asei theitapon ahi; hichun amahon intheng sunga mu khat anei ahi ti ahetauve; ijeh inem itile amaho chu akhutnin ahoupi thon, paolouvin aumin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin athempu kin natohna nikho achai phatnin, a-in lama achetan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche jou chun a-inneipi Elizabeth agaitan, chule amanu lha nga akiselin,
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman mi lah-a mi i-sah lou kachan hi suhmangna dinga, Pakaiyin keima eivetna hitia hi eibol ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin alha gupna-in Pathen'a konin Gabriel vantil chu Galilee gama khopi khat Nazareth atiuva chun,
  </para>
  <para style="p">
    <verse number="27" style="v" />David son amin Joseph kitipa jihol nungah theng khat henga akisolin; nungah theng min chu Mariam ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin vantil chu amanu hengah alut-in, Chibai, sah chungnungnu, Pakaiyin naumpi; numei lah-a anunnoma nahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin amanun ama amuphatnin, alunggim lheh jengin, alungthimin, Itobang phatthei bohna ahitadem, atin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin vantil chun amanu jah-a, Kicha hih-in, Mariam, ijeh-inem itile Pathen lungdeilam nahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule ven, gaijin natin, chapa khat nahin ding, chule amin JESU nasah ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ama chu hung len ding, chule Chungnung pen Chapa kiti ding ahi: chule Pakai Pathen'in ama chu apu David laltouna apeh ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama Jacob sonho chunga leng changa, atonsot atonsot geija vai apoh ding, agamin itihchan hijongle kichaitih anei lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Mariam'in vantil jah-a chun, Hichu iti hi dingham, Pasal la kaneipon? ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin vantil chun adonbutnin, ajah-a, Lhagao Theng nachungah hung chuntin, chule Chungnung pen thilbol theinan nahin lekhu ding ahi: chule hiche jeh-a chu ahung peng ding athenga chu Pathen Chapa kiti ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule, ven, nasopinu Elizabeth'in jong ateh nungin chapa khat avoptai; achinga aseinu-u chu agaijin, tun lha gup ahitai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ijeh-inem itile Pathen na dinga ahitheilou imacha umlou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hichun Mariam'in, Ven, keima Pakai sohnu kahi, kachungah nasei bangbang chun lhunghen, ati. Chuphatnin vantil chu amanu koma konin achemang tan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hiche jou chun Mariam akipatnin, thinglhang gama Juda khopi khatnah acheloitan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Zachariah in'a alutnin, Elizabeth chibai aboh tan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin ahitin ahi, Elizabet'in Mariam'in achibai boh ajah phatnin, a-oi sunga naocha chu ahung kichomin, chule Elizabeth amatah Lhagao Theng adimin;
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule aw sangtah-in asamin, Numei lah-a nunnoma nahin, nalai gil ga jong nunnoma ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule ka pakai nu kahenga ahung hi, hoilam ipi thu hitam?
  </para>
  <para style="p">
    <verse number="44" style="v" />Ijeh-inem itile ven, nei chibai boh aw gin kanakhangin ajahjah-in, ka-oi sunga naocha athanomin ahung kichomin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule atahsan nu chu anunnom ahi; ijeh inem itile Pakaiyin ajah-a thu asei chengse chu hung guilhun ding ahi, ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Mariam'in, Kalungin Pakai achoi-anin,
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule kalhagao jong eihuh hinga Pathen'ah akipah-in ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ijeh-inem itile aman asohnu dinmun nemcha hi akhohsah-in; Hijeh chun vetan, tu-a lhah-a akhang akhanga mi jousen anunnom eiti dingu ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ijeh-inem itile Hatchung nungin keima thil loupitah eibol pehtan; Amin jong athenge.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule Ama gingte chunga akhang akhangin Alungset aumpeh jinge.
  </para>
  <para style="p">
    <verse number="51" style="v" />Aman abanin athahatje avetsahtan; Aman ama lungela kiletsah hoithoteho asuchehtai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Aman ahat apaoho atouna mun uva kon in asonlhan, namchom chagate atungdohtai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Agilkelteho thil phaphan avahvan, mihaote ho khut gohkeovin asolmangtai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Alungsetje chu ahetdoh jingnan, asoh Israel akithopin,
  </para>
  <para style="p">
    <verse number="55" style="v" />Tonsotna dingin Ipu ipateu Abraham, chule achilhahte henga athutep bang chun, ati.
  </para>
  <para style="p">
    <verse number="56" style="v" />Chuin Mariam amanu koma chun lha thum jen aumin, a-in lamah akiletan ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin Elizabeth aso phat ahung lhingtan ahile, chapa khat ahingin ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Chuin a-inhengho le a-inkoho chengsen Pakaiyin aha lungset behseh jeng chu ajah phatnun, amanu chu akipa athanop piuvin ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chuin ani get nin naosen cheptan ding chun ahungun; amaho chun apa min bangin Zachariah sah dingin agouvin ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Ahin naosen nu chun, Ahipoi, naosen min hi John sah ding ahi, tin amaho jah-a aseijin ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chuin amahon, Naphung lah uva koima min chutobang um louva, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chuphatnin amahon, Amin ipi nasah nom em tin mit heijin apa adongun ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chuin aman lekhasutna pheng athumin, Amin John ahi, tin asuntan ahi. Hichun ami jouse chun adatmo lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Chuin chupettah chun akam akihongin, alei akilhamin, Pathen avahchoi tan ahi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Hichun akimvela cheng chengse chungah kichat achutan, chule Juda gam thinglhang jouse-ah hicheng thusoh thu chu akiseithang tan ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chule aja jousen hichu alungin aching cheh-un, Hiche chapang hi ipi ahungsoh tadem! atiuvin ahi. Chule Pakai khutnin ama aumpin ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Chule apa Zachariah chu Lhagao Theng adimsetnin, gaothu aseijin, hitin ahi;
  </para>
  <para style="p">
    <verse number="68" style="v" />Pakai Israel Pathen chu vahchoijin umhen; Ijeh-inem itile Aman amite avilin, alhatdoh tan,
  </para>
  <para style="p">
    <verse number="69" style="v" />Chule asoh David insung mite lah-a, Eiho dingin huhhingna ki khat eitun dohpeh taove;
  </para>
  <para style="p">
    <verse number="70" style="v" />Leiset kisemtila pat Aman athemgao thengho kama anasei bangin;
  </para>
  <para style="p">
    <verse number="71" style="v" />Imelma teova konle, eihoteu khutna kona huhdoh-a i-um theina diuvin;
  </para>
  <para style="p">
    <verse number="72" style="v" />Iputeu ipateu henga anatep akhotona chu tohdohna dingle, akitepna theng chu geldoh nadingin;
  </para>
  <para style="p">
    <verse number="73" style="v" />Ipuluiju Abraham jah-a akihahselna bangtah-in,
  </para>
  <para style="p">
    <verse number="74" style="v" />Igalteu khutna kona huhdoh-a i-umuto lhona, kichalou hela ama kin iboluva,
  </para>
  <para style="p">
    <verse number="75" style="v" />Thengtah le chonphatah-a, Ihinlai sungseuva a-angsunga akin ibolna diuvin.
  </para>
  <para style="p">
    <verse number="76" style="v" />Chule nangma, naosen, chungnung pen themgao kiti ding nahi; ajeh chu alampi sem dinga nangma Pakai masang sanga che ding nahin;
  </para>
  <para style="p">
    <verse number="77" style="v" />achonsetnao suhbeija auma kona, amite chu huhhingna hetna pedingin,
  </para>
  <para style="p">
    <verse number="78" style="v" />I-Pathen'u nemheuva mikhotona vangin, chungnunga kona nisa soh chun ihungvil taovin;
  </para>
  <para style="p">
    <verse number="79" style="v" />Muthim le thina lima touho salvah dingle, Ikengu lungmonna lampia chesah dingin, ati.
  </para>
  <para style="p">
    <verse number="80" style="v" />Chuin chapang chu ahung seilenin, lhagaova hattah ahitan; chule Israelte henga akiphondoh ni gei chun gamthipmah aumin ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, hiche nikholai chun Caesar Augustus'in leiset chunga cheng jouse min sut ding thu apen ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichu Syria gama Cyrenius gamvaipo ahilaija min kisutna amasapen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun mi jouse chu amin sun dingin ama ama khopi cheh-a acheuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Joseph jong chu David inko le aphung ahi jeh chun, Galilee gama Nazareth kho-a konin, Juda gama David khopi Bethlehem atiuva chun,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajihol Mariam gaihamset chutoh amin sun dingin achetan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amani chukoma aumpet lhonin, Mariam aso phat alhingtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun achapa masapen ahingin; chuin ponin ajelin, jinlhun ina mun a-on lou jeh chun, gan ankong sunga alupsahtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hiche gama chun lou jaova tol lhanga geh kelngoi chingho aumun, jan-in akelngoi honu angah-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin, veuvin, Pakai vantil khat akomuvah ahung dingin, chule Pakai loupi chun akimvelu asalvah jengtan ahi: hichun amaho akichatangei jengun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin vantil chun ajah uva, Kicha hih-un, ijeh-inem itile, veuvin, keiman mijouse-a dinga hachangpa kipana thupha chu nangho kahin pohpeh nahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajeh chu tunin nangho dingin David khopi-ah Huhhing-a khat apengtai, ama chu Pakai Christa ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hiche hi nangho dinga amelchihna ding ahi: Nanghon naosen pona kijela gan ankong sunga lum nagamu dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin phulou helouvin vantil chutoh vanmi janel honpi ahung umun, Pathen avahchoijun,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chungnung pena Pathen loupi hen, chule leichunga miholah-a chamna le alunglhaina umhen, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahitin ahi, vantil ho chu amaho koma kona van'a achemang phatnun, kelngoi chingho chun, Cheovin, Bethlehem'a cheohitin, tu-a Pakaiyin eihetsah-u thusoh hi gaveo hite, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amaho acheloijun ahile, Mariam le Joseph toh gan ankong sunga lum naosen chu agamudoh taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin hichu amu phatnun, hiche naosen thudol ajah uva kisei chu ahetsah sonle taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ajah uva kelngoi chingho thusei chu ajapha jousen kidang asauvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mariam vang chun thu kisei jouse chu alungin angaiton, aching jingin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin kelngoi chingho chun ajah uva kisei bang banga thil amu chengseu le athil jah chengseu jal chun, Pathen choi-at le vahchoi tothon akiletaove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ani get nin cheptan ding nikho alhingtan, amin Jesu asahtaove, hichu naobu-a aum masanga vantil chun asahsa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Mosi thupeh dungjuija akisuhtheng nikho alhin phatnin, ama chu Pakai henga peh dingin Jerusalem'a ahin puijun,
  </para>
  <para style="p">
    <verse number="23" style="v" />(Pakai danthu bu-a, Naobu phukeh-a hung pengdoh pasal jouse chu, Pakaiya dinga atheng kiti ding ahi; ati banga chu;)
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Pakai danthua, vakhu kop khat hijongle vapal nou ni hijongle tia kisei bangin, ganlhaina toh dingin ahungun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin, veuvin, Jerusalem'a chun amin Simeon kiti mi khat aumin; amapa chu chonpha tahle Pathen ngaisahtah, Israelte lungmon nading chu ngah jinga ahin; achunga Lhagao Theng uma ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Pakai thaonu Christa chu amu masanga ama athi lou ding chu, Lhagao Thengin ahetsah-a aphondoh ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ama chun Lhagao puijin houin sunga chun ahung lutnin; chuin achung changa chonna dan ngaija bol dinga anule apan naosen Jesu chu apui phatnun,
  </para>
  <para style="p">
    <verse number="28" style="v" />Amapan naosen chu akhutnin alan, chule Pathen avahchoijin,
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakai, tun nangma thu dungjuija Nasoh hi lungmonga neilhahdoh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ijeh-inem itile nami huhhingna kamit nin amutai,
  </para>
  <para style="p">
    <verse number="31" style="v" />Miho jouse mitmu-a Nangman nagot
  </para>
  <para style="p">
    <verse number="32" style="v" />Chidang namdangte henga vah kilangdoh dingle, Nami Israelte loupina ding chu, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin naosen umchan ding thudol kisei chu anu le Joseph'in kidang asa lheh lhonin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Simeon chun phatthei achunguva aboh-in, anu Mariam jah-a, Ven, hiche chapang hi Israelte lah-a mi tamtah lhuhna le dindohna hung hiding, chule seiset kihetna melchih na-a kitung ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Henge, mi tamtah lunggel kiphon dohna dinga, nangma lung jong chemjamin asutpai ding ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Asher phung mi Phanuel chanu Hanna kiti themgao numei khat aumin, amanu chu hatah-a teh ahitan, anungah jineija patna ajitoh kum sagi chengkhom ahin,
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule amanu chu kum somget le kumli geija meithaija uma ahin, amanu chu houin'a kona potdoh louhela, an ngol le taona puma Pathen houva asun ajana um ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin hiche nidan tah chun ahungin Pathen athangvah-in, Jerusalem lhatdoh ding kat jinga umteho jouse jah-a chun Jesu umchan thu aseijin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Pakai danthu dungjuija thil abol chaisoh phatnun, Galilee gama akhopiu Nazareth kho-a akilekit taovin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin chapang chu akhangin, chule lhagaovin ahatdoh-in, chihna adimset tan; chule Pathen lungsetna achunga aumtan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin anule apa chu kumseh-in kalchuh kut tengle Jerusalem'a acheji lhonin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin ama kum somle kum ni ahi-in, kalchuh kut chonna ngaijin Jerusalem'a achetouvun;
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin kut achaijuva akile kit phatnun chapang Jesu anunguvah Jerusalem'ah aumdentan; chule hichu anule Joseph'in ahelhon hih-in;
  </para>
  <para style="p">
    <verse number="44" style="v" />Mihon lah-a chu uma ahi tin angaito lhonin, ni khat lam achetauvin; chuin amanin a-inkoteho le akihetpiho lah ahol lhonin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin amudoh lhonlou phatnin, Jerusalem lamah akile kit lhonin, aholpeh lhontan ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin ahitin ahi, ni thum jouvin ama chu houin sungah agamudoh lhonin, houhil ho lah-a anatouvin, thu anangaijin dong jong ana dongin;
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule athu jachan chun ahetjele athu donbut chu kidang asa lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin amu phat lhonin alungdongleu lhonin; chuin anun ajah-a, Chapa, ibola neihiti bol lhonham? Vetan napale keiman lungdong tah-in kahol lhone, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin aman amani jah-a, Ibola neihol lhonham? Keima ka-Pa in'a akin bola umding mong kahi helhon lou nahim? ati.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahin ajah uva athusei chu amahon ipi kiseina ham ahepouvin ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin amanitoh alhonin, Nazareth kho-ah achesuh-un; athu thu lhonin anungin; chule anun hicheng thu kisei jouse chu alungin achingtan ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin Jesu chihna le tahsa-a akhangtou touvin; chule Pathen le mihem deisah-in aumtan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Tiberius Caesar lengchan kal kum somle ngana-in, Pontius Pilate Juda gamvaipo ahia, chule Herod Galilee gam vaipo ahia, asopipa Philip Ituria le Trachonitis gamkai vaipo ahia, chule Lysanias Abilene gam vaipo ahi lai,
  </para>
  <para style="p">
    <verse number="2" style="v" />Anna le Caiaphas thempulen ahilhon laijin, Pathen thu chu gamthipma Zachariah chapa John hengah ahung lhungtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ama chu Jordan luipang jui kimvela gam jouse-a ahungin, chonset suhbeina dinga lungheija baptize chan thu alhangsam len;
  </para>
  <para style="p">
    <verse number="4" style="v" />Isaiah themgao lekhabua kisunbang chun, Gamthipma khosam aw khatnin, Pakai lamlen semtohsan koijun, alampi semjangun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Damkom chengse kidip chama, molsang jousele lhang jouse kisunem ding; chule lamkon chu kisujanga, aphon nachu kisunam ding;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule mi jousen Pathen mi huhhingna amu ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiti chun aman, ama khutna baptize chang dinga ahenga hunga mihonpi jah-a chun, Vo gulse sonho, khonunga lunghan hung lhung dinga kona jam ding lungthim koiham napeuvah?
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche jeh chun lungheitoh kilomin gadoh-un; chule nalah uva, Abraham kapu luiju aumnai titahih-un; ijeh-inem itile kaseipeh nahiuve, Pathen'in hiche songho-a kona hi Abraham son asodoh sah thei ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule tu jeng jongin thing bultinah heicha kikoija ahitai; chutiachu thingphung aga phalou chengse chu kiphuh lhu-a, meija kisep lutji ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin mihonpi chun, Achutile keihon ipi kabol dinguham? tin ama adongui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman adonbutnin, amaho jah-a, Sangkhol ni neijan anei louva chu kihoppi hen; chule anneh neijan jong chutima chun bolhen, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin kaidongho jong chu baptize chang dingin ahenga ahungun ajah-a, Mihil, keihonla ipi kabol dinguham? atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman amaho jah-a, Nanghon nakiteppeh kalvalun mi-a lahbe hih-un, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sepaiho injong adongun, Keihon jong ipi kabol dinguham? atiuvin. Aman amaho jah-a, Alam louvin koimacha acham louvin lahpeh hih-un; jouvin jong mi heh hih-un; chule nalo jat jat uvah lung lhaijun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin mihon agaldot jingu ahito lhona, Hiche John hi Christa ahi khat tadem, tia lungthima angaito laitah-un,
  </para>
  <para style="p">
    <verse number="16" style="v" />John'in adonbutnin, abonchauva jah-a, Keima vangin twija baptize kachansah nahiuve; ahivangin keima sanga hat chungnungjo ahunge, keima akeng chot khao sutlham dinga jong kilom kahipoi; amatah chun nangho Lhagao Thenga le meija baptize nachansah dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman akhutna godal akichoijin, aphol ajapngim sela, chule achang pang sunga akhum ding; asi vang chu mit theilou meija agovam ding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiti chun aman tilkhouna thudang tamtah aseijin, amaho jah-a chun Kipana Thupha ahil lhanglen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahin John'in Herod lengpa chu asopipa Philip inneipi Herodia jal leh athilbol phalouho jala apho jeh-in,
  </para>
  <para style="p">
    <verse number="20" style="v" />John chu songkul'a akhumin, chonset chunga chonset abolbetai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ahitin ahi, miho jouse baptize achanuva, Jesu jong baptize achan jouvin, ataovin ahile van akihongin,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Lhagao Theng tahsa vouvin vakhu bangin ahung kumlhan achunga achun, chule van'a konin aw ahung gingin, Nangma ka-Chapa deitah nahi; nachungah kalung alhai tangeije, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu amihil kipat chun ama kum somthum vel alhingin, mi ngaiton ama chu Joseph chapa ahin, Joseph chu Heli chapa ahin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Heli chu Matthat chapa ahin, Matthat chu Levi chapa ahin, Levi chu Melchi chapa ahin, Melchi chu Janna chapa ahin, Janna chu Joseph chapa ahin,
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph chu Mattathias chapa ahin, Mattathias chu Amos chapa ahin, Amos chu Nahum chapa ahin, Nahum chu Esli chapa ahin, Esli chu Nagge chapa ahin,
  </para>
  <para style="p">
    <verse number="26" style="v" />Nagge chu Maath chapa ahin, Maath chu Mattathias chapa ahin, Mattathia chu Semei chapa ahin, Semei chu Joseph chapa ahin, Joseph chu Juda chapa ahin,
  </para>
  <para style="p">
    <verse number="27" style="v" />Juda chu Joanna chapa ahin, Joanna chu Rhesa chapa ahin, Rhesa chu Zerubbabel chapa ahin, Zerubbabel chu Shealtiel chapa ahin, Shealtiel chu Neri chapa ahin,
  </para>
  <para style="p">
    <verse number="28" style="v" />Neri chu Melchi chapa ahin, Melchi chu Addi chapa ahin, Addi chu Cosam chapa ahin, Cosam chu Elmodam chapa ahin, Elmodam chu Er chapa ahin,
  </para>
  <para style="p">
    <verse number="29" style="v" />Er chu Jose chapa ahin, Jose chu Eleazer chapa ahin, Eleazer chu Jorim chapa ahin, Jorim chu Matthat chapa ahin, Matthat chu Levi chapa ahin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Levi chu Simeon chapa ahin, Simeon chu Juda chapa ahin, Juda chu Joseph chapa ahin, Joseph chu Jonam chapa ahin, Jonam chu Eliakim chapa ahin,
  </para>
  <para style="p">
    <verse number="31" style="v" />Eliakim chu Melea chapa ahin, Melea chu Mennan chapa ahin, Mennan chu Mattatha chapa ahin, Mattatha chu Nathan chapa ahin, Nathan chu David chapa ahin,
  </para>
  <para style="p">
    <verse number="32" style="v" />David chu Jesse chapa ahin, Jesse chu Obed chapa ahin, Obed chu Boaz chapa ahin, Boaz chun Salmon chapa ahin, Salmon chu Nahson chapa ahin,
  </para>
  <para style="p">
    <verse number="33" style="v" />Nahson chu Aminadab chapa ahin, Aminadab chu Aram chapa ahin, Aram chu Hezron chapa ahin, Hezron chu Peres chapa ahin, Peres chu Judah chapa ahin,
  </para>
  <para style="p">
    <verse number="34" style="v" />Judah chu Jacob chapa ahin, Jacob chu Isaac chapa ahin, Isaac chu Abraham chapa ahin, Abraham chu Terah chapa ahin, Terah chun Nahor chapa ahin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Nahor chun Seruch chapa ahin, Seruch chu Reu chapa ahin, Reu chu Peleg chapa ahin, Peleg chun Eber chapa ahin, Eber chu Shelah chapa ahin,
  </para>
  <para style="p">
    <verse number="36" style="v" />Shela chu Cainan chapa ahin, Cainan chu Arphaxad chapa ahin, Arphaxad chu Shem chapa ahin, Shem chu Noah chapa ahin, Noah chu Lamech chapa ahin,
  </para>
  <para style="p">
    <verse number="37" style="v" />Lamech chu Mathusala chapa ahin, Mathusala chu Enoch chapa ahin, Enoch chu Jared chapa ahin, Jared chu Mahalalel chapa ahin, Mahalalel chu Cainan chapa ahin,
  </para>
  <para style="p">
    <verse number="38" style="v" />Cainan chu Enos chapa ahin, Enos chu Seth chapa ahin, Seth chu Adam chapa ahin, Adam chu Pathen chapa ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jesu Lhagao Theng dimsetnin Jordan'a konin akilen, chule Lhagaovin gamthipmah apuijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nisomli diabol lhep patepmin aumin ahi. Chule hiche phat sunga chu imacha ne lou ahin; chule chuche alhin phatnin agil akeltan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun diabol'in ajah-a, Nangma Pathen Chapa nahile, hiche song hi changlhah asona dingin thu pen, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jesu'n adonbutnin, ajah-a, hitin akisune, mihem changlhah jenga hing louding ahi, Pathen thu chengsea joh hingding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin diabol'in molsang tah chunga apuitouvin, mitphet kah louvin vannoi leiset gam jouse avetsahtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin diabol chun ajah-a, hicheng jouse chunga thuneina le aloupina nangma penge; ijeh-inem itile keima eikipedoh-a ahitan; kapeh nomnom kapeh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun neihouva ahile aboncha nanga hi ding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Jesu'n adonbutnin, ajah-a, kanunglama chen, Satan: ijeh-inem itile, hitin akisune, nangman napakai, na-Pathen chu houvinlang ama jengbou jennin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jerusalem'a apuijin chule houin tingvuma adinsah-in; chuin ajah-a, Pathen Chapa nahile, hichea konhin nangma kichomlha jengin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh-inem itile, Aman nangma chungchanga avantilho nachang dingin thu pentin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amahon akhutnuva nadop dingu ahi, achutiloule songah nakeng kisuh khah-in nate, tin akisune ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jesu'n adonbutnin, ajah-a, Nangman Pakai na-Pathen chu lhem patep hih-in, tin akiseije, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin diabol'in alhep patepna chengse achaisoh phatnin, chomkhat dingin ama chu adalhatan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jesu Lhagao thahatnin Galilee'a akilekit tan; hichun akimvel gamtina chun athu akithangtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin akikhopnao in tinah ahillen, mi jouse pachat-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aseilet dohna Nazareth kho-a ahungin; chuin achon ngaibangin cholngah nin kikhopna in'ah alutnin, sim dingin adingtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Isaiah themgao lekhabu apeuvin ahi. Chuin aman lekhabu chu aphongin ahile, hitia kisun laitah amudoh-in ahi:
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai Lhagao chu kachunga aume, ajehchu aman keima mivaichaho jah-a kipana Thupha hillhang ding, alung naho damsah ding, sohchangho jah-a lhadohna thu phongdoh ding, mitcho ho khomusah dinga, suhnemna umho lhadoh dinga,
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakai lahthei kum seiphong dinga, thao einu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman lekhabu chu akhupmin, lhachale khutna ape kitnin, atoutan ahi. Hichun kikhopna in'a mi jousen ama jeng amit lhuh chehtauvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ajah uva, Hiche Pathen lekhabu thuhi tuni hin nanakhang sunguvah aguilhung tai, tin asei pantan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichun abonchauvin ama chu aseiphaovin, chule akam sunga soh lungsetna thu chu kidang asa lheh jengun; Hiche hi Joseph chapa hilouham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman amaho jah-a, Nanghon, Louthem nangma kiboldamin: Capernaum'a nathilbol kajah chengseu chu hikomah nangma gama jong hin bolin, ti thuchih hi kajah-a nasei tei dingu hina hi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman aseikitnin, Tahbeh-a najah uva kasei ahi, Themgao koima ama gam sungah min ajop ngaipoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin tahbeh-a najah uva kasei ahi, Elijah nikho laija van akikha-a, kum thumle lha gup gam jouse-a kel alhah chun, Israel lah-a meithai tamtah aumin ahi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahin adang koima henga Elijah kisol louvin, Sidon gama Zerapath kho-a meithainu henga akisol bouvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Elisha'n themgao phatlai chun, Israel lah-a aphah tamtah aum nan; ahinla Syria mi Naaman tilou, adang koima kiboldamtheng aumpoi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin amahon thu chucheng ajah phatnun, kikhopna in sunga mi jouse chu alunghang behseh jengun,
  </para>
  <para style="p">
    <verse number="29" style="v" />Akipat doh-un, khosunga kon chun asondoh-un, abungbua sotlhah dingin akho chennao koldeh lama chun apuitaovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin akah uva akihehdoh-in achemang tan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin ama Galilee gama khopi khat Capernaum'a achesuh-in, chule cholngah nin miho ahiltan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule thunei tah-a thu asei jeh chun, athuhil chu kidang asa lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin kikhopna in'a chun lhagao boh vop mikhat aumin; chuin ama chun aw sangtah-in asamin,
  </para>
  <para style="p">
    <verse number="34" style="v" />Neidalhao vin! Vo Nazareth Jesu, nangle keiho ikimatnao i-um em? Eisumang uva hunga nahim? Nangma koi nahi kahenai; Pathen Mitheng chu nahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Jesu'n ama chu aphoh-in, Thipmin, ama-a kon chun hung doh-in, ati. Chuin thilha chun ama chu alaijuvah ahehlhun, suna louvin asunga konin ahung potdoh tan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hichun abonchauvin kidang asa lheh jengun, amahole amaho akihouvun, hiche hi ipi thuham? Ijeh-inem itile thuneitah le thahat tah-a lhagao bohho thu apehle, amaho ahung potdoh jenguve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin chuche vel gama khotinah athu athangtan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin akipatnin, kikhopna ina kon chun apotnin, Simon in'a aluttai. Chuin Simon nupanu chu hatah-a khosih-a na ahin; amanu ding chun athumpeh taovin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin ama akomah adingin, akhosih chu aphoh-in ahile, alhatan ahi. Chuin amanu athoudoh paijenin, amaho jenlen apangtan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin nisalhum konin, hivei chomchom veija ana damlou neiho chun amaho chu akoma ahin puijun; chule aman achung cheh uva akhut angamin, aboldam gamtan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule thilhaho jong chu mi tamtah-a konin apotdoh-un, Nangma Pathen Chapa Christa nahi, tin asamun ahi. Chuin aman amaho chu aphoh thipmin, amahon ama Christa ahi chu ahet jeh-un, thu aseisah tapon ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin kho avah, phatnin apotdoh-in gamthip munah achetan; chule mipi chun aholun, ahenga chun ahungun, amaho adalhah louna dingin alho taovin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ahivangin aman amaho jah-a, Keiman kho dang danga jong Pathen lenggam Kipana Thupha kahil lhangle ding ahi; ijeh-inem itile hiche dinga chu hinkisol kahi, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hichun Galilee gama kikhopna in tinah thu ahilhanglen ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, mipin Pathen thu ngaidinga aneh chinto jeh-un, ama Genesaret dillen panga adingin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun aman dillen vaokama chun kong ni amun; ahivangin nga manho chu anapotdoh uva, alennu anasopmu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ama Simon kong joh-a chun alutnin, kong chu vaokama kona themkhat atollut din asolin, chuin atouvin, kong'a chun apangin mipi chu thu ahiltan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin athusei angah phatnin Simon jah-a, lithuhlam jonin, nga man dingin nalen seplhan, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Simon'in adonbutnin, Pipu, jan khovah keijin kabolun, imacha man louhel kahiuve; ahivangin nangma thusah-in len gahsep lhange, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin chutia abol phat chun, nga atama tam akhukha taovin; alennu chu akeh jengin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon kong choma um akikoppiho chu hunga ahung hu dingun agahjap taovin ahi. Chuin ahungun akong nin asung dimun ahile alhalut dehdeh jengin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin Simon Peter'in hichu amun, Jesu khophang bula aboh khupmin, Vo Pakai, kakoma konin chedoh-in; ijeh-inem itile keima mi chonse kahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche anga matnu chu amale aloiten kidang asah behseh jeh-u ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Simon kikoppi Zebedai chapate ni Jacob le John jong chun kidang asa lhonin ahi. Chuin Jesu'n Simon jah-a, Kicha hih-in; tua pat mihem mana napan ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon akongu vaokama ahintoldoh phatnun, abonchan adalhauvin anung ajuitaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ahitin ahi, ama khopi khatna aumpetnin, veuvin, mi khat apumchanga phah aumin; chuin Jesu amu phatnin tolla aboh khupmin, Pakai, nalung ahile neidam thengsah thei ahi, tin ataotan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman akhut alhangin, athamin, Kalung ahi, damthengtan, ati. Chupettah chun aphah chu apha paihel jengtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman koima jah-a asei louna dingin akhamchah-in, Chenlang thempu gakimusah-in, chule nakibol damtheng thu dol chu amaho hettohsahnan, Mosi thupeh dungjuijin thilpeh ding dol chu gapetan, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Achuti jeng vangin ama thu dol akithang chehjengin; mipi atama tam athu ngai dingle anat kiboldam dingin ahung kikhomun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin ama chang gamthip muntin-ah achomin achedoh-in, agataovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, hichelai chun nikhat thu ahil petnin, Galilee gama khoho le Juda gama khoho-a kon, chule Jerusalem'a kona hung Pharisai ho le danthu hilteho chu akoma atouvun ahi; chule mi boldam dingin Pakai thilboltheina chun ama aumpi ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin veuvin, mihon mi langthi khat ajalkhun pumin ahinpuvin; amahon ama chu put lutna, a-anga koi dingin agouvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin mipi jeh-a aput lutna ding kom amu lou phatnun, in chunga akaldoh-un, in chungkhu chehpheng vangkah-a chun alupna pumin alailunguva Jesu ang sungah agah khailhauvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin atahsanjeu chu amun, aman, Mipa nachonset naho kingaidam nahitai, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin danthu sunhole Pharisai hon, Taitomna thuseipa hi hoi koiham? Pathen tailou chonset ngaidam thei koiham? tin agel pantaovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin agelu chu Jesu'n ahen, adonbutnin, ajah uva, Nalunguva ipi nagelu ham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Nachonset naho kingaidama ahitai kitile, Thouvin lamjotnin ti hoijoh seibai jo-am?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahoi hita jongle leiset chungah Mihem Chapan chonset ngaidamna thahat aneije ti nahetna dingun,(langthipa jah-a chun,) Thou vin; nalupna kilah inlang, na-in'a chetan kati nahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin hiche pettah chun ama a-angsung uva athoudoh paijin, alupna chu akilah-in, Pathen vahchoi pumin a-in lama achetan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichun kidang asa lheh jengun, Pathen avahchoijun, Tunin thil kidangtah imuve, atiuvin akicha behseh jengtaovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin hiche jou chun ama apotdoh-in ahile, amin Levi atiu kaidong khat, kaidonna mun'a atou amun, ajah-a, Kanung hinjuijin, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman ijakai adalhan akipatdoh-in ajuitan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Levi chun ama vahnan a-in'ah golvah loupitah abolin; chule hia chun kaidongho le midang tamtah-in amaho chu ankong aumpiuvin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Pharisai ho le alekha sunteu aseijuiteho chunga aphunun, Ibola kaidongho le chonse hotoh nanehkhom nadon khomuham? atitaove.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Jesu'n adonbutnin, Ati damten louthem angaipouve; a damlouten bou angaijui.
  </para>
  <para style="p">
    <verse number="32" style="v" />Michonpha te kou-a hung kahipoi; alung heina dinguva michonse te kou-a hungjoh kahibouve, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin amahon ajah-a, Ipidinga John seijuiten an angol matchet jiuva, tao jong taojiuva chule Pharisai hon jong chuti boljiuva, nangma nungjui hon aneh uva adonjiu ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jesu'n amaho jah-a, Moulang chun aumpi laiseuva, aloite chu an na ngolsah thei ngaijum?
  </para>
  <para style="p">
    <verse number="35" style="v" />Amavang moulang chu akomuva kona akipuimang ni hung lhung ding ahi, chuche nile an angol dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin aman ajah uva thulem khatma aseijin, Koiman ponthah halchu ponluija abeh ngaipoi; chuti bolle athah chun asuhset ding; chule athah-a kona alah ahal jong chu alui chutoh kitoh lou ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule koiman lengpitwi thah savun peng luija akhum ngaipoi; ichuti bolle, atwi thah chun apeng chu tumkeh intin, atwi jong long jalintin, peng jong mang ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Lengpitwi thah chu peng thah-a khum ding ahibouve; chutile ania kikhehtup jia ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lengpitwi lui dona chun koiman athah don ding agopoi; ijeh-inem itile, Aluibou atuije, ati.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, amasa kichaijou anichanna cholngah nin changlei lai ajotnin ahile, aseijuiten changvui asih-un, akhutnun anoijun aneuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pharisai ho kimkhatnin, Cholngah ni-a bol ngailou ibola nabol uham? ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jesu'n adonbutnin, ajah uva, Nanghon David le aloihon agil akel phat uva abolu chu nasim khah louvu ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama Pathen in'a alutnin, thempu tailou adangin aneh ngailou vetsahna changlhah chu alan, anen, chule aloiho jong apen ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman ajah uva, Mihem Chapa chu cholngah ni Pakai ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, cholngah ni chom khatnin ama kikhopna in'ah alutnin thu ahilin; chule hia chun akhut jet lang ngoi mi khat aumin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin danthu sunho le Pharisai ho chun ahehsetna ding amu theina dingun, cholngah ni-a aboldam em, aboldam hih em tin achang lhiuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin aman alungthimu chu ahen, akhut langngoipa jah-a chun, Kipatdoh-in alaija hung dingdoh-in, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jesu'n amaho jah-a, Keiman thudoh khat neijung kate; cholngah ni-a apha bol angaiha, ase bol angaiham? Lhagao huhhing angaiha, suhmang angaiham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman amaho chu abonchauvin ave kimvelin, akhut lang ngoipa jah-a chun, Nakhut lhangin, ati. Chuin aman alhangin ahile akhut chu alangkhat bangin adamtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin amaho athangtom tuntun jengun, Jesu chunga ipi bolding ham akihoutoh pantaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ahitin ahi, hiche lai chun ama taona mang dingin molchunga akaldoh-in; jan khovah-in Pathen henga tang louvin ataovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin khovah phatnin aseijuite akouvin; chuin alah uva somleni alhengdoh-in, amaho chu aminu jong solchah asahtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Peter asah Simon, chule asopipa Andrew, Jacob le John, Philip le Bartholomew,
  </para>
  <para style="p">
    <verse number="15" style="v" />Mathew le Thomas, Alphaeus chapa Jacob, Zealot atiu Simon,
  </para>
  <para style="p">
    <verse number="16" style="v" />Jacob naopa Juda, chule ama matsah-a pang Judas Iscariot, hicheng chu ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amaho chutoh ahung kumlhan, jangcham-ah adingun, aseijui honkhat toh, Juda gam jousele Jerusalem'a kon, Tyre le Sidon gama twikhanglen panga kon mipi atama tam, athu ngai dingle ahiveiju kiboldam dinga hungho;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin lhagao boh suhgentheina aumnaova kona boldama umho toh ahin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ama-a kona thilboltheina ahung potna abonchauva aboldam jeh chun, mipi chun abonchauvin ama chu tohkhah agouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ama akhodah-in aseijuite aven, Mivaichateho anunnom nahiuve; ijeh-inem itile Pathen lenggam chu nangho-a ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tu-a gilkelteho anunnom nahiuve; ijeh-inem itile nangho nava dingu ahi. Tu-a kapteho anunnom nahiuve; ijeh-inem itile nanui dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihem Chapa jala min nahotbol uva, chule nachom khenuva, nahou setnuva, chule michonse tia naminu apaidoh tengule anunnom nahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche ni chule thanomun, kipah-in kichomum; ijeh-inem itile veuvin, van'a nasan dingu kipaman atame; ijeh-inem itile apu apateuvin jong themgaoho chutobang ma-a chu anabolu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amavang mihaosa ho, ada nahiuve! Ijeh inem itile nanghon lungmonna alhinga naneiju ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangho tu-a oivaho ada nahiuve! ijeh-inem nangho nagil keldiu ahi. Nangho tu-a nuiho ada nahiuve! ijeh inem itile nangho nalunghem dingu chule naka dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi jousen na-ochat uva naseiphat tengule ada nahiuve! ijeh-inem itile apu apateuvin chutima-a chu themgao lhemho anabolu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amavang keiman kathu ngaiho jah-a kasei ahi, Nanghon namelma teu chu ngailuvin; nahoteu chu phatbolun;
  </para>
  <para style="p">
    <verse number="28" style="v" />Nagaosapteu chu phatthei boh-un; nataitom teo dingin taovun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nabengphe langkhat benga chu langkhat jong dopeh-in; chule naponlen min nalahpehle nasangkhol jong alah ding it hih-in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nahenga thumchan chu pen; chule nanei nalah peh-a chu thum kit ta hih-in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Min nangho iti nabol leu nadeijum, nanghon jong chuti chun bolun.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nanghon nangailu teo jeng nangailut uva ahile, ipi pachat nachan dinguham? Ijeh-inem itile michonseho jengin jong angailuva chu amahon angailuvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule nanghon nadinguva phaho jengseh phatna ding bolleu chun, ipi pachat nachan dinguham? Ijeh-inem itile michonse hon jong achuti bolun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule lemu kit dinga nakinepna hou jengseh henga peleuchun ipi pachatna nachan dinguham? Ijeh-inem itile michonse hon jong michonseho hengah ajatma mu kit dingin apejiuvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nangho vangin namelma teu chu ngailuvin, aphatna dingu bolun, chule mu kit ding kinemlel louvin peuvin; chutile tohphat man nasan dingu len ding, chule Chungnung pen chate nahi dingu ahi. Ijeh inem itile ama kipaje helou le miphalouho ahepin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hijeh chun na-Pau mikhoto bangin, nanghon jong mi khotouvin.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule mi oimo hih-un, chutile nangho oimo-a naum lou dingu ahi; mi themmo chansah hih-un, chutile nangho jong themmo nakichan lou dingu ahi; mi ngaidamun, chutile nangho jong naki ngaidam dingu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nanghon peuvin, chutile nangho jong nakipe dingu ahi; phatah-in tentin, sonchahkheh intin, lohchah kheh-in tin, letsetna na-op uva nasunpeh dingu ahi; ijeh-inem itile nanghon nate bang banguva chu nangho kitepeh ding nahiuve, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin aman amaho jah-a thulem khat aseijin, Mitchon mitcho apui thei ngaijem? Ani lhona kokhuh-a lhalut lhonta lou dingham?
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahilpa sangin aseijui achungnung jopoi. Athep chamkim teng vangle ahilpa toh akibang bouve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule ibola nasopi mitna bohthem um chu navetna, nangma mitna thingtum umchu hedoh louva nahim?
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule nangman nangma mitna um thingtum chu mu louva, nasopi jah-a, Sopi, namitna bohthem um chu neilahdoh sah-in, iti nati theiham? Vo miphalhem, nangma mitna um thingtum chu kilahdoh masah-in, chutengle nasopi mitna um bohthem lahdoh ding chu namuchen ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ijeh-inem itile thingphung pha-a aga phalou agajipoi, thingphung phalouva jong aga pha agajipoi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Thingphung jouse aga-a kihe-a ahi. Ijeh-inem itile min ling phung-ah theichang aloujipoi, lingboh-a jong lengpiga aloujipoi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Miphan alung sung thilkholna pha-a konin thilpha asodoh-in; chule miphalouvin alung sung thil kholna phalouva konin aphalou asodohjin ahi; ijeh-inem itile alung sunga aletset teng akamin aphondohji ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule nangho kasei thua la chon louva ibola Pakai, Pakai, neitiu ham?
  </para>
  <para style="p">
    <verse number="47" style="v" />Koi hijongle kahenga hunga, kathusei ngaija, chule bola chu, ama chu koi tobang ham keiman nangho vetsah-unge.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ama chu in sa-a, thuhtah-a lei laija, chule abul songpi chunga phut tobang ahi: chuin twisang ahung lenin, chule luidung asoh-in, in chu hasuh-in asun ahile, guntah-a kisa ahi jeh chun asulhu joutapon ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ahin ja chu jana-a ahia bol louva vang chu, abul beija lei chunga in sa tobang ahi; luidung asoh-in, hasuh-in asun ahile hiche in chu alhupai jengtan ahi; hiche in chu aset anasa lheh jengin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin aman miho jah-a asei ding thu jouse aseisoh phatnin, Capernaum'a aluttan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin sepai jalamkai khat asohpa deitah hatah-in anan, athikon ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman Jesu thu umchan ajah phatnin, ahengah Juda mi upaho asolin, ahunga asohpa chu ahung damsah dingin angehtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amaho chu Jesu heng alhunun, pontho tah-in ataovun, Ama hi hiche hi nabolpeh-a lomtah ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile aman ivaipiu hi angailu lheh jengin, amatah-in kaki khopnao in jong hi eisahpeh-u ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Jesu amaho chutoh alhontai. Chuin inkom ageijin jalamkai javaipo chun agolho asolin, Jesu jah-a, Pakai, nangma hung kisugim hih-in: ijeh-inem itile nangma ka-in sunga nahung lut ding chu keima chutia kilom kahipoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutichu ahin keima jong nangma henga hung dinga kilomim kakingaito poi; thu chengkhat jengcha seijin, chutile kasohpa dam jeng ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh-inem itile keima jong mi thuneina noija um kahin, keima noija sepaiho aumin; chule keiman khatpenpen chu, Chen, katile, achen; achom khat, Hungin, katile ahungin: chule kasoh jah-a, Hiche bolin, katile, aboljin ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jesu'n thu chucheng ajah phatnin, ama chu kidang asan adatmon, anungjui mipi jah-a chun, Keiman nangho jah-a kasei ahi, Israel lah jenga jong hitobang tahsan len kamukhapoi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin asolteho chu a-in'a akile kitnun ahile, adammoa um sohpa chu damin amutauvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujou jou chun Nain atiu kho khatna achen, aseijuite le mipi nasatah khattoh alhonin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuche kho kotpi phung ageijun, veuvin, mithi khat ahung kipun, ama chu anu chapa changkhatseh ahin, amanula meithai ahin; akhoho mi tamtah-in alhonpiuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin amanu chu amu phatnin, alung ase behseh jengin, Kap hih-in, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman anaijin thilong kong chu athamin ahile, apuho chu adingtauvin ahi. Chuin aman, Gollhang, thouvin kati nahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin athipa chu atou doh-in, thu asei pantan ahi. Chuin aman amapa chu anu apetan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin abonchau chunga kichatna alhung tan; Ilah uva themgao chungnung khat asohdoh-e; chule Pathen'in amite aviltai, atiuvin Pathen avahchoi taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Judah gam jouse-a le akimvel gam jouse-ah achungchang thu chu athangdoh sohtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin John seijuiten chuti thu jouse chu ajah-a aseijiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin John'in aseijuite mi ni akouvin, Jesu hengah asolin, Ahung dinga chu nang nahi mong hinam? Ole achom dang khat kanga dinguham? agati sah-e.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin mite ni akom alhun lhonin, John Baptist-in, Ahung dinga chu nangma nahi mong hinam? Ole achom dang khat kanga dinguham? tia nahenga eihinsol lhon ahi, ati lhone.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche pettah-a chu Jesu'n anaho, hiseveiho, chule lhagao gilou vop tamtah aboldama, chule mitcho tamtah lungset tah-a kho amusah ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Jesu'n adonbutnin, ajah lhonah, Che lhoninlang nathilmu chengse lhon le nathujah chengse; Iti dana mitchon kho amu-a, elbaijin lam ajotna, miphah damtheng sah-a auma, chule na-ngongin kho ajah-a, mithisa kaithouva auma, chule mivaichate Kipana Thupha kiseipeh-a hitam John jah-a gasei lhonin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule koi hijongle keija kipal lhuhna kom nei lou chu anunnom ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin John thupo ho chu apotdoh phatnun, aman mipi jah-a chun John thudol asei panin, Ipi ve dinga gamthipma chu nachedoh-uham? Huijin peng amut lingham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Achutile, ipi ve dinga ba chedoh nahiuvem? Ponnem kisil miham? Veuvin, lultah-a kivonhole nomsa tah-a umho khu lengho inpi-a um ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahile, ipi ve dingaba nachedoh-uham? Themgao ham? Tahbeh-a kaseipeh nahiuve, themgao sanga chungnungjo ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Keiman kasottol nama sang-ah kasole, aman namasanga sang nalampi asem ding ahi, tia kisun chu ama hi ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangho jah-a kasei ahi, Numei sunga peng lah-a John Baptist sanga lenjo aumpoi; ahinla Pathen lenggama aneojo chu ama sangin alenjoi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin athusei ja-a mi jouse le kaidongho, John baptize chansah-a baptize changho chun, Pathen chu them achanun adihsahtauve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin Pharisai ho le danthu themho vang chun, ama chansah-a baptize chang louvin, Pathen'in amaho chunga alunggot chu apaidoh taovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Pakaiyin, Tukhanga miho hi ipitoh katekah tadem? chule ipi toh kilou uvam? ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaho chu chapang kaithel tolla touva, khatnin khat kou-a, ajah-a, Kuli kamutpeh ule nalam hih-un; kakau lela nakap pouve, tiho tobang ahiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ijeh-inem itile John Baptist ahungin, changlhah ne lou lengpitwi donlou ahin; nanghon, Ama chu thilhavop ahi, nati uve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mihem Chapa ahungin, anen chule adonin ahile, nanghon, Veuvin, nehhat le ju lop, kaidongho le mi chonseho jol le gol, nati uve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahinla chihna chu achate jousen athem chansah uvin ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Pharisai ho khatnin ama chu an nehpi dingin akouvin; chuin ama Pharisai pa in'a chun alutnin, an nedingin atoutan ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin veuvin, hiche khopi sunga um numei chonse khatnin Pharisai pa in'ah annen atouve ti ahet phatnin, songval bom khat thao namtui ahin choijin;
  </para>
  <para style="p">
    <verse number="38" style="v" />Anungah akengphang bulah adingin akapmin, akengphang chu amitlhin akotsah-in, aluchanga asam chun atheh ngim pantan, chuin akengphang chu achopmin thao chu anutan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin an ne-a kou-a Pharisai pa chun hichu amun, alungthima, Hiche mipa hi themgao ahin, hiche atongkha nu hi koi ahi le itobang numei ahi hetahta, amanula chonse ahin, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Jesu'n ama chu adonbutnin, ajah-a, Simon najah-a sei ding thukhat kaneije ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Aman, Houhil seijin, ati. Sumpahom mikhatnin sumba mi ni aneijin; khatpan dangka ja nile somnga abatnin, khatjopan somni le nga abat ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin amanin asahna ding anei lhon lou phatnin, ani lhonin angaidam tai. Chuti ahileh koijoh chun ama ha ngailutjoh lhonintem? ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Simon'in adonbutnin, Kei ngaiton atam ngaidamjoh chun, ati. Chuin aman, natan dih-e, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin numeinu lama chun akiheijin, Simon jah-a, Numeinu hi namu-em? Na-in'ah kahung lutnin nangman kakeng silna ding twi neipepoi, amanu vang hin amitlhin ka kengphang asukotnin, asamin atheh ngime.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nangman chopjong neichop poi, amanu vang hin kahung lut tila pat ka kengphang chop atangpoi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nangman kalu thao neinu pehpoi, amanu vang hin ka kengphang thao namtui anui.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hiche jeh-a chu kasei ahi, Amanu chonsetna tamtah akingaidam jeh-a hatah-a angailut ahi; amavang ngaidam lhom chun angailu lhomjin ahi, ati.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin numeinu jah-a chun, Nachonset ngaidam ahitai, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Hichun a-ankong um piho chun, Chonset ngaidam ama hi koi hingana? akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin aman numeinu jah-a chun, Natahsanin nahuhhing ahitai; lungmong tah-in chetan, ati.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, hiche joujou chun, ama khopile khoneo tinah avahlen, Pathen gam Kipana Thupha apolen ahillhanglen; somleni ho chu akomah aumun;
  </para>
  <para style="p">
    <verse number="2" style="v" />chule numei phabep, lhagao gilou vop kiboldam le anat kiboldamho toh ahiuve. Amaho chu Magdalene atiu Mariam thilha sagi potdohnanu toh,
  </para>
  <para style="p">
    <verse number="3" style="v" />chule Herod neiching Chuza inneipi Joanna toh, Susanna toh, chule numei dang tamtah toh ahiuvin; amaho chun amaho neija konin ama ajenun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin mipi tamtah ahung kikhom khomun, khotina konin miho ahenga ahung ahungun, aman thulemin thu aseijin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Muchi thepa muchi then achen, athe atheleh abang lamsih-a achun ahile min kengin achotphan, chule chunga leng vachaten alohgamtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abang songlheo chungah achun; chuin akedoh doh-in, jung akholou jeh-in agop paitan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule abang ling lah-a achun; chuin lingho chutoh akhanthan adeplih taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule adang leipha laijah achun, akhangin, ajat jakhat agatan ahi ati. Chuin thu chucheng aseijin, Angaina ding nakhang neijan ngaihen tin asamin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aseijuiten, Hiche thulem chu i-kiseina ham? tin adongun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, Pathen lenggam thuguh chu nahet dinguva kipe-a nahitaove; midangho dinga vang, vet chu avetnuva amuloudiu, jah chu ajah uva ahet louna dinguva thulema kisei ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thulem chu athu hiche ahi: Muchi chu Pathen thu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule lamsih-a ho chu, athu jaho ahiuve, chutengle amahon atahsan daova chule asochat louna dingun diabol ahungin, alung sunguva thu chu alahmang pehjin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule songlheo chungaho chu athu ajah-a, thanom tah-a joppaiho ahiuve; amahon jung aneipouvin, chomkhat atahsanun, chule lhepna aum tengle apul lhagamji taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule ling lah-a chuho chu hiche ahi, athu ajah nungle acheuvin, hinlai khankho lungkhamna, haona, nopsahna chun adeplihjin, aga bulhingji tapouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule leipha laija chua chu, thu chu ja-a, lung kituptah le phatah-a tuh detna, thohhat na-a ga sohdoh jiho chu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule koiman meivah avah-in belin akhukhum jipoi; jalkhun noija jong akikoi jipoi; alut chanin vah amu theina dingun atunna chungah atungji bouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ijeh-inem itile kiphong lou dinga imacha ki-ima aumpoi, chule hetdoh lou ding le kilangdoh lou ding akiselguh imacha aumpoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun iti nangaijum chingtheijun; ijeh-inem itile koi hijongle aneija chu kipehbe ding; chule koi hijongle anei louva chu aneija angaito chasun jong chu ama-a kona kilahpeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin anu le asopite ahungun, ahinla mipi jeh chun akom alhung theipouvin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ajah-a, Nanule nasopite inpoa adingun, nangma namu nomui, tin aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin aman adonbutnin, amaho jah-a, Kanule kasopite hicheho, Pathen thu ngaija bolteho hi ahiuve, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ahitin ahi, chulai chun ni khat aseijuite toh kong-ah atouvin; chuin aman amaho jah-a, dil gallang khatna galkaiju hite, ati. Chuin kong alhaovin akitol taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin akitol petnun ama a-imutan; chuin dila chun khopihui ahung nungin ahile akongu chu twi adim dehdeh jengtan, amaho setto kichatah-in aumtaovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amaho ahenga acheuvin, asukhangun, Pipu, Pipu, athigam kahitaove, atiuve. Chuin ama ahung khangin huipi le twikinong chu aphoh-in; hichun hiteni chu atanghel gelin, athiphel tan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman ajah uvah, hoibaham natahsanu? ati. Chuin amaho akichauvin, kidang asauvin, khatnin khat jah-a, Hichepa hi itobang mi ham! Huile twi thu apen ahile, athun anung jeng lhone, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Galilee gal ajontah-a um, Gerasene gam alhungun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ama kong'a kona leichung agah chot chotnin, khopi-a kon mikhatnin atoh-in; ama chu sottah thilha vop, apon apona sil lou, in'a jong umlou, lhankhuh lah jenga um ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama chun Jesu amu mun, a-ao san, a-angah aboh khupmin, aw sangtah-in, Vo Jesu, Chungnung pen Pathen Chapa, nangle kei ipi ikimatna umam? Nahenga katao ahi, keima neibolgim hih-in, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />(Ajehchu aman mipa-a kon chun hung doh-in tia lhagao boh chu thu apeh ahi. Ijeh-inem itile ama chu tamtah vei amat matchetji ahi: chule ama chu thihkhao le bula ahenjiu ahin, ahivangin aman akihennaho chu aphutanjia, thilhan gamthipmah apuimangji ahi).
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Jesu'n ama chu adongin, Namin ipiham? ati. Chuin aman, Janel kahi, ati; ijeh-inem itile asunga chu thilha tamtah lut ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Aman amaho chu leinoi lama asol lounadin thilhaho chun Jesu henga angeh taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule chukom molsang dunga chu vohcha hon atama tam lha-a ahin; thilhaho chun chucheho lah-a alut theina dingun angeh-un ahile; aman alutdiu aphalpeh tan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin thilhaho mipa-a kon chun ahung potdoh-un, vohchaho sunga chun alut taovin ahile, vohhon chu halhaijin alhaijun, kolah alhai lhauvin, dil'a alha lutnun athigam taovin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin vohcha vah hon hiche thusoh umchan chu amu phatnun ajamun, khopi sunga le loujaovah agaseijun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin ipi thusoh hitam tia ve dingin ahung potdoh-un; chuin Jesu kom ahung lhungun, thilha potdohna mipa chun pon akisila, chule lunglima Jesu kengphang koma atou amuvin, akicha lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin amuho chun thilha voppa chu iti kihuhdoh ahi chu amaho jah-a aseijun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Gerasene gam vela miho jousen, akomuva kona achedohna dingin ahenga ataotauvin ahi; ijeh-inem itile amaho chu kicha behseh jenguva ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin ama kong'a alutnin, akile kittan ahi. Ahin thilhaho potdohnapa vang chun ama koma umding athumin;
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahivangin Jesu'n, Na-in lama chenlang Pathen'in nangma itobang thil loupi nabol peh-em, hichu gaseilen, tin asolin ahi. Chuin akipatdoh-in, Jesu'n thil lentah abolpeh chu khopumpi jah-a lhang phongtah-in asamletai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin ahitin ahi, Jesu akile kit chun, mipin kipah tah-in ana lamtouvin ahi; ijeh-inem itile amaho abonchauva ama ngah jinga anaum ahiuve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin veuvin, amin Jairus kiti mi khat ahungin, chule ama chu kikhopna in vaihom ahi; chuin ama chu Jesu kengphang bulah alhun, a-in'a hung dingin ataotan ahi;
  </para>
  <para style="p">
    <verse number="42" style="v" />Ijeh inem itile ama chun chanu changkhatseh aneijin, kum somle kum nibep ahin, amanu chu athi koncha ahi. Ahin achen ahile mipi chun atom lellul jengun ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin numei khat kum somle kum ni athi long, louthem ho kijensah na-a anei jouse sumang, khatchan jong aboldam jou lounu chu,
  </para>
  <para style="p">
    <verse number="44" style="v" />anung lama ahungin, apon mongkai athamin ahi: chuin chupettah chun athi lon chu atangpai jengtan ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin Jesu'n, koiham eithama? ati. Chuin koimachan kei kahi atilou phatnin, Peter le akoma umhon, Pipu, mipin natoma chule naneh chintouva, iti dana koiham eithama? natiham, atiuve.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ahivangin Jesu'n, Koiham khatnin eithame; ijeh-inem itile keija kona thilboltheina thahat potdoh-a chu keiman kahei, ati.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin numeinu chun, Ki-imthei kahipoi ti ahen, kihot pumpumin ahungin, a-angah aboh khupmin, ijeh-a ama atham ahi chule chupet tah-a adampaihel chu mi jouse ang sungah aseitan ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin aman amanu jah-a, Chanu, lhamong tah-in umin, natahsanin nadamsah ahitai; lung mongin chetan, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Aman hiche thu chu aseina laijin, kikhopna in vaihompa in'a kon chun mi khat ahungin, ajah-a, nachanu athitai; houhil chu cholsah hih-in, ati.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahivangin Jesu'n hichu ajan, adonbutnin olmo hih-in, tahsanpou poutan; chutile amanu hingdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin in alhun phatnun aman Peter, John, Jacob chule chapangnu nule pa tailou adang koima alutsahpon ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chule miho jouse chun amanu chu akauvin, a-op abeng bengun ahi; ahin aman, nangho kap hih-un; ama athia ahipoi, a-imu ahibouve, ati.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin athitai ti ahet jeh-u chun, ama chu anuisat taovin ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ahinla aman amaho chu apotdoh sah-in, amanu chu akhutnin atuh-in akouvin, Boinu, thouvin ati.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin alhagao ahung kile kitnin, chupettah chun athoudohpai jengtan ahi; chuin aman amanu chu neh ding peuvin, tin thu apetai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Hichun anu le apa chun kidang asa lheh lhonin; ahivangin aman hiche thil kibol chu koima jah-a aseilhon louna dingin akham chahtan ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman somleni ho chu akou khomin, thilhaho jouse chunga thuneina le nat boldamna thahat apen,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen lenggam thu hil lhangle dingle adamlouho boldam dingin asolin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajah uva, Nakhol jinnauva dingin imacha keng hih-un, tenggol hihen, sakhao hihen, changlhah hihen, chule sum hijongle kiken hih-un; sangkhol thoni jong nei hih-un;
  </para>
  <para style="p">
    <verse number="4" style="v" />Nalut lutnau in'a chun umun, chule chua kon chun potdoh-un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nalhunsah lounao chanuva chu, chuche kho-a kona napotdoh tengule, amaho douna hettohsahnan nakengphang uva leivui thinglhau vin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amaho acheuvin, akho kho-a Kipana Thupha ahillhangun, adamlou aboldampeh taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun Herod gamvaipopan thil kibol jouse chu ajan, alunggim lhehtan ahi. Ajeh chu mi abangin, John athia kona thoudoh kit ahi, atiuvin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Abangin, Elijah hung kilah ahi, atiuvin; adangse vang chun, Malaija themgaoho lah-a khat thoudoh kit ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Herod'in, Keiman John lu katantan, ahinla hiche athu kajah hi hoi koiham? ati. Hichun ama mu atuptan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin solchah ho chu ahung kile kitnun, athilbol chengseu chu ama jah-a aseijun ahi. Chuin aman amaho chu apuijin, Bethsaida atiu khopi mun thip khatna amaho changseh apotdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin mipin hichu ahet phat uvin, anung ajuijun; chuin aman amaho chu anasangin, chuin ajah uva Pathen gam thu aseijin, chule boldam ngaiho chu aboldamtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin nilhum kon ahitan; hichun somleni ho chu ahungun ajah-a, Mipi hi acheuva khoho le loujao dunga genale anneh agakihol theina dingun soltan; ijeh-inem itile hikoma eiho gamthipma um ihiuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin aman amaho ajah-a, Nanghon nehding peuvin ati. Chuin amahon jah-a, Kacheuva hiche miho jouse dinga hi neh kagachoh ngal louvule, keihon changlhah pheng nga le nga ni kalval kaneipouve, atiuvin ahi
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh-inem itile amaho chu mi sangnga jen hiuva ahi. Chuin aman aseijuite jah-a, Amaho chu somnga cheng chengin aloi loijin tousah-un, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amahon achuti bolun, abonchauvin atousah-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin changlhah pheng nga chule nga chu alan, van lam aven, hiteho chu phatthei aboh-in, ahehbal balin; chuin mipi anga chu luipeh dingin aseijuite thu apen ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amahon aneuvin, abonchauvin avasoh keijun, chuin anehmoh-u anong chengse paipeh somle paipeh ni alohdoh-un ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, ama achanga atao petnin, aseijuiho akomah aumun; hichun aman amaho chu adongin, Mipi ho hin keima hi koi ahi eitiuvem? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahon adonbutnun, John Baptist ahi atiuve; abang vangin Elijah ahi atiuvin; chule adangsen, Malaija themgaoho lah-a khat thoudoh ahi tin aseijuve atiuvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman amaho jah-a, Nanghonla koi ahi neitiuvem? ati. Chuin Peter'in adonbutnin, Pathen Khrista chu, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin aman amaho chu hichu koima jah-a asei louna dingun hakhamin akhamchah-in;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajah uva, Mihem Chapa chun thil tamtah athoh-a, chule vaipo upaho le thempu pipuiho, chule danthu sunho pampaija uma, chule kithat tei ding, chule ni thum nile kaithouva umtei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman abonchau jah-a, Koi hile kanung eijui noma chu ama kingaitom hen, niseh-in athingpel kiput hen lang kanung hinjuihen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ijeh-inem itile koi hile ahinna huhhing noma chun achan ding; amavang koi hile keima jala ahinna chana chun ahuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ijeh-inem itile min vannoi leiset apumpin neihenlang, ama kisumanghen ahiloule paidoh-in umtale, ama dinga ipi phachom dingham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Ijeh-inem itile koi hijongle keima le kathu jachat chanchu, Mihem Chapan ama loupinale, Pa loupina, chule vantil thengteho loupina-a ahung tengle, amapa chu ajachatpi ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amavang tahbeh-a kaseipeh nahiuve, Hikoma dingho kimkhat hi, Pathen lenggam amu kahseuva, thina tepkha lou ding aumuve, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ahitin ahi, chucheng aseikal ni get jen jouvin Peter toh, John toh, chule Jacob toh apuijin, atao dingin mol chunga akaltouvun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ama ataopetnin, amaiso akikhelin, chule aponsil abanin abangin, aval lahlah jengin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin veuvin, mi nin akihoupin; amani chu Mosi le Elijah ahi lhonin,
  </para>
  <para style="p">
    <verse number="31" style="v" />Loupia hung kilah lhona, Jerusalem'a thina athoh chai ding thu chu asei lhonin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichun Peter le aumpiho chu a-imutsoh ngui ngui jengun, ahivangin hah jengin aumun, aloupije le akoma ding miteni chu amuvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin akikhenpi lhona akoma kona achedoh pet lhonin, Peter'in Jesu jah-a, Pipu, hikoma i-umu hi eiho dingin anome; chule lhambuh thum songung kate, khat nangma ding, khat Mosi ding, chule khat Elijah ding, atin; ipi asei ahijong ahepon ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin aman chucheng asei pet chun, mei lhang khatnin amaho chu ahinlekhun; chuin amaho mei lah-a alutnu chun akichauvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin mei lah-a kon chun aw ahung gingdoh-in, Hiche hi ka-Chapa deitah ahi; athu ngaijun, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin awgin akichai phat chun, Jesu achangin akimutan ahi. Chuin athipbeh-un, chulai chun athilmu-u chu koima jah-a asei pouvin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin ahitin ahi, akit ni-a mol chunga kona akumsuh phatnun, mipi atama tamin analam touvin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin veuvin, mipi lah-a kon chun mikhatnin ahin samin, Houhil, nahenga katao ahi, kachapa hi ven; ama hi kachapa changkhatseh ahi;
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule vetan, lhagaovin amanjin, phulou helouvin apengjahjin, chule aheh lhujin ahile achilphon akaijin, asuheh jin, lhakang manlouvin amavo jingin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule anodoh dinga naseijuite henga kataole, amahonla anodoh joupouvin ahi, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Jesu'n adonbutnin, Vo tahsanna nei lou khanglamvai mite, nakom uva itihchan kauma, chule kakhongai ding nahiuvem? Nachapa chu hilama hinpuijin, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin ahung petnin thilha chun ahehlhun, nasatah-in aveingoi jengin ahi. Ahivangin Jesu'n lhagao boh chu aphoh-in, chuin chapang chu aboldamin apa apetan ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin miho jouse chun Pathen thilboltheina loupije chu kidang asa lheh jengun ahi. Chutia chu athilbol jouse chu kidang asah pettah-un Jesu'n aseijuite jah-a chun,
  </para>
  <para style="p">
    <verse number="44" style="v" />Hicheng thuhi nana sunguvah lutsah-un, ijeh-inem itile Mihem Chapa chu mihemte khutna kipedoh dingkon ahi, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ahivangin hiche athusei chu ahedoh pouve; ijeh-inem itile amahon ahetdoh louna dinguva, amaho-a kona ki-ima ahin; chule hiche athusei chu ipi aseina ham doh dingla akichauvin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin alah uva koipen chu alenpen ahidem tin kinelna aumtan ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ahivangin Jesu'n alunguva chuche angaitou chu ahen, chapang neocha khat alan, akoma adinsah-in,
  </para>
  <para style="p">
    <verse number="48" style="v" />Ajah uva, Koi hijongle hiche chapang neocha hi keima mina sanga chun keima eisan ahi; chule koi hijongle keima eisanga chun eihinsolpa asan ahi. Ijeh-inem itile nalah uva aneopen chu alen ahi, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin John'in adonbutnin, Pipu, mi khat namina thilha nodoh kamuvin, chuin nangma kajuiju eijuipi lou jeh-un kakham taove, ati.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahin Jesu'n amaho jah-a, kham hih-un, ijeh-inem itile koi hijongle eidoulou tapouvu chu eiho lamma pang ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin ahitin ahi; ama lahtouva aum ding phat alhin konin, Jerusalem'a che dingin amai angat changmelin,
  </para>
  <para style="p">
    <verse number="52" style="v" />Amasangah thangkou asol masan; chule amaho acheuvin ama dinga gotsa anakoipeh dingin, Samaria miho kho khatnah aluttaovin ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ahivangin ama Jerusalem'a che dinga amai angat jeh chun, amahon anasang tapouvin ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chule asolchah teni, Jacob le John nin hichu amulhon phatnin, Pakai, Elijah'in anabol banga, van'a kona meikong ahung lhah-a amaho hi akahvamna dingu thu peleuveng nalung ham, ati lhone.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ahivangin ama akiheijin amani chu aphoh-in, ajah lhonna, Itobang lhagao neija nahi nakihet lhonpoi;
  </para>
  <para style="p">
    <verse number="56" style="v" />Ajeh chu Mihem Chapa hi mihemho hinkho sumang dia hung ahipon, ahuhhing diuva hunga joh ahibouve, ati. Chuin kho choma ache taovin ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin lampia ache petnun mikhatnin ajah-a, Pakai, Nachena chan-ah juijinge, ati.
  </para>
  <para style="p">
    <verse number="58" style="v" />Chuin Jesu'n ajah-a, Sial hon ko aneijun, chunga leng vachaten jong buh aneijun, Mihem Chapa vangin alu ngapna mun aneipoi, ati.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chuin aman achom khat jah-a, neijuijin, ati. Ahin aman, Pakai, amasan kache-a kapa kagavuina ding thu neipen, ati.
  </para>
  <para style="p">
    <verse number="60" style="v" />Hichun Jesu'n ajah-a, mithihon amithiu kivuinao vinte; nangma chenlang Pathen gam thupha gahil lhang letan ati.
  </para>
  <para style="p">
    <verse number="61" style="v" />Achom khatman jong, Pakai, keiman nanung juijinge, amavang amasan ka-inkote kaga lhahna dingin neilhan, ati.
  </para>
  <para style="p">
    <verse number="62" style="v" />Jesu'n ajah-a, Mi koi hile langkon tuhta-a, kiheija anunglam vea chu Pathen lenggama hoi ahipoi, ati.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chucheng jou chun Pakaiyin midang somsagi alhendoh ben, ama chena ding khopi chengsele muntina chun amasang sang-ah mi ninin asolin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ajah uva, Chang at ding atam lheh-in, ahivangin natonga alhome; hiche jeh chun achang atna-a dinga natongho ahinsoldohna dingin, chang neipu henga taovun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cheovin; veuvin, ngeihon lah-a kelngoi nou banga nangho kasol nahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon sumbom ahin, sakhao ahin, kengchot ahin, keng hih-un; chule lampia koima chibai boh hih-un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule in nalutna ding chanuva, amasatah-in, hiche in'a hin lungmon lhunghen, tiuvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chukoma chu lungmon umtah mi auma ahile, nalungmon chu achunga umding ahi; aum lou vangle nangho henga hung kile kit ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule ipi hijongle amahon napeh peh-u chu neuvin donun, hiche in'a chun umun; ijeh-inem itile natongan athaman asana lom ahi. In khatna konin in khatna kichon hih-un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ipi kho hijongle nalutnaova chu min nanasan uva ahile, na-ang uva akoi chanu chu neuvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chukoma um anaho chu boldamun; chule amaho jah-a chun, Pathen gam chu nakomu alhungtai, tiuvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amavang ipi kho hijongle nalutna uva chu min nana lhunsah louvangule, chedoh-unlang akho sung lamlenuvah,
  </para>
  <para style="p">
    <verse number="11" style="v" />Kakeng phanguva beh nakho sunguva leivui sana katheh lhah khum nahiuve; hijongle Pathen gam ahung naitai ti hi heuvin, tin seijun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Najah uva kasei ahi, chunileh chuche khopi thoh sanga chu Sodom thoh oljo ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ohe Chorazin! nada ahi, ohe Bethsaida! nada ahi; ijeh-inem itile nalah uva thilbol thahatna kidang kibol chengse chu, Tyre le Sidon khopi-a kibol hile, sotna pat chun achenghon khaodip pon kisilin vut lah-a touvuntin, alungu heitauvinte.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla thupi tan nile nangni thoh sanga Tyre le Sidon thoh oljo ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule vangeija choisanga uma nang Capernaum, damuna sotlhah-a umding nahi jobouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koi hile nangho thu ngai chan chun keima thu jong angai ahi; koi hile nangho pampaija chun keima jong eipampai ahi; chule keima eipampaija chun eisolpa jong apampai ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin chuche somsagi ho chu kipahtah-in ahung kileuvin, Pakai, nangma minin thilhaho jong kathu-uvin anunge, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman amaho jah-a, Van'a kona kolphe banga Satan ahunglhah kamui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Veuvin, gulle aipi chonpeh dingle, melmapa thilboltheina jouse chunga chu thuneina kapeh nahiuve; hitia chu imachan nangho nasuhset lou dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin lhagaoho nathuva anun jeh chun kipah hih-un, amavang naminu van'a akisut jeh chun kipah jouvin ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin hiche pettah chun Jesu Lhagao Thengah hapan akipah-in, hitin ati, Ka Pa, vanle lei Pakai, nangman mi chingtele lungthim themho henga hicheng thuhi na-ima, naocha ho henga naphon doh jeh hin nangma kathangvah-e; Pa, hiti chu nangma lunglhaina lam ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Imajouse ka Pan keima eipehdohsoh ahitai, chule Chapa chu koi ahi Pa tailouvin ahepoi; chule Pa chu koi ahi Chapa le Chapan Ama aphondoh aphondohna miho tailou koiman ahepoi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin seijuiteho lama chun akiheijin atumbeh-in ahenguva, Nathilmu chengseu namunao mit chu avangphai:
  </para>
  <para style="p">
    <verse number="24" style="v" />ijeh-inem itile kaseipeh nahiuve, nangho thil mu hi themgaoho tamtah le lenghon mu atup lheh-u ahin, ahivangin amupouvin ahi; chule nathu jah chengseu hi jah atupmun, ahinla ajapouvin ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin veuvin, danthu them khat adingdoh-in, apatep-in, Houhil, tonsot hin kemlou kanei theina dinga ipi kabol dingham, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman ajah-a, danthua ipi kisunem? Nangman iti nasimem? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman adonbutnin, Nangman nalung pumpin, nalhagao pumpin, nathanei apumpin, chule nalungthim pumpin Pakai na-Pathen chu ngailun; chule nangma naki ngailut bangin naheng nakoma ngailun, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman ajah-a, Nadonbut dih tangeije; hiti chun bolin, chutile nahin ding ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivangin ama them kichan agon, Jesu jah-a, Ahile kaheng kakom chu koiham? ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu'n adonbutnin, Mi koiham khat Jerusalem'a konin Jericho'a achesuh-in, gucha michomho lah atohkhatan, amaho chun apon alahpeh-un, avovin, athi konin adalha taovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin thempu khat chuche lampia chun achesuh-in; chuin amachu amu phatnin, lamsih lang khatna apeltan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin chutima chun Levi mi khatma chukom mun chu aphah phatnin, ahungin ama chu aven, lamsih lang khatna apeltai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahin Samaria mi khat vang chu akholchena lamah aumna mun chu ahinphan; chuin ama chu amun ahile alung asen,
  </para>
  <para style="p">
    <verse number="34" style="v" />Akoma achen, avohnao mahaho chu thaole lengpitwi asunkhumin, amahaho chu atomin, chuin amatah gancha chungah atousah-in, jinlhun in'ah apuilutnin, ajentan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin ajingin apotdoh ding konin, sumnong ni aladoh-in, inneipu chu apen, Ama hi phatechan anajenin, hiche kalval ijat hijongle nasuhmang jat chu keima kahung kile kit teng nangma sanange, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hicheng thum lah-a koipen chu gucha michom lah tohkhapa hengle kom nahisah-em? ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin aman, ama akhotopa chu, ati. Chuin Jesu'n ajah-a, Chenlang nangman jong chutobang chun gabolin, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin acheuva ahile ama kho khatna alutnin; chuin amin Martha atiu numei khatnin a-in'a alhunsah-in ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule amanu chun Mariam kiti sopi khat aneijin, amanu jong chu Pakai keng khophang bulah atouvin, athu angaijin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Martha vang chu lhachalen apangin akisalel lheh jengin, chuin ama henga ahungin, Pakai, kasopi nun keima jeng lhachale-a eichanglha hi ima nagel louham? Hijeh chun eikithopi dingin solin, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahin Jesu'n adonbutnin, amanu jah-a, Martha, Martha, nangma thil tamtah ngaito-a lungkhama lunggim nahi;
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahinla ngaichat akhoh chu khatsehbou ahin, chule Mariam'in chuche aphalai chu akilhen ahitai; hichu ama-a kona kilahpeh lou ding ahi, ati.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ama mun khatnah ataovin, ajo phatnin aseijuiteho khatnin ajah-a, Pakai, John'in aseijuite taoje ahil bang chun nangman jong keiho neihilun, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman amaho jah-a, nangho natao tengule, Van'a um ka Pau, namin kijahen, nagam hunglhung hen, van'a nalung chan akim bangin, leija jong nalungchan kimhen,
  </para>
  <para style="p">
    <verse number="3" style="v" />Tunin kaneh khop dingu anneh neipeuvin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalei bateu kangaidam bangun, keiho batjong ngaidamin. Chule lhepna-a neipuilut hih-un, agilouva konin neihuh doh jouvin; tiuvin ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman amaho jah-a, Nalah uva, koipen nahiuvem khatnin jol neihen, chule jankhang kimin ahenga chehen ajah-a, Jol, changlhah pheng thum apan neipen;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ijeh-inem itile kajol khat kholjin kahenga ahung lhunge; ahin keiman a-anga luipeh ding imacha kaneipoi, gatile:
  </para>
  <para style="p">
    <verse number="7" style="v" />Insunga pangin, Neisugim hih-in; tun kot akikhahtai, chule kachatetoh jalkhuna kalum khomui; nangma pe dingin kathou theipoi, tia donbut dinga?
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman nangho jah-a kasei ahi, ajol ahi jeh chun thouhen gape hih jongle, athum lunlun jeh chun thouvintin adei jat chu gapente.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keiman nangho kaseipeh nahiuve, Thumun, kipe ding nahiuve; holun, namu dingu ahi; kiuvun, kihonpeh ding nahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh-inem itile athumchan achangin; chule aholan amun; chule akiuva chu kihonpeh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nalah uva koipen nahiuvem, mipa hija achapan changlhah athumle song pe dinga? Ahiloule nga athumle nga khela gul pe dinga?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahiloule ahtui athumle aipi pe dinga?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun nanghobon migiloutah hiuva, nachateo thilpha pehje nahet ule; hiche sanga chu gam chenga van'a Pa chun ahenga thumte chu Lhagao Theng apeh lou ding ham? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman thilha paomo khat anodoh-in, chuin thilha chu apotdoh phatnin, mipaomopa chun thu aseitan ahi; hichun mipi ho chun kidang asa lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin alah uva mi kimkhat chun, thilhaho lengpa Beelzabul vanga thilhaho anodoh ahi, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Adang kimkhatsen ama patepnan van'a kona melchihna athumun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin aman amaho lung ngaito chu ahen, amaho jah-a, Gamsung khat amale ama kidoutoa kichom khen chan chu amang thahjin, insung khat kidou chu alhujin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Satan jong amale ama akidoule agam iti dindoh ding ham? Beelzabul vanga thilhaho anodoh ahi neitiula ahin,
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima Beelzabul vanga thilhaho nodoh kahile, nachateovin koi vanga anodohjiu hintem? Hijeh-a chu amaho cheng chu nangho thutana pang ding ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin keima Pathen khutjunga thilhaho nodohji-a kahi vangle, Pathen gam chu nahengu hung lhunga ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihat in manchah kimkeija akipatna a-in angalai chansen, anei bitkeijin aumji;
  </para>
  <para style="p">
    <verse number="22" style="v" />Amavang ama sang hatjon abulu-a, ajo tengle, akigina agalvon chu asutlhah pehjin, anei alahpeh chu ahomcheh jitan ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Koi hile keima lama pang lou chu eidouva ahi; chule eikhop khompi lou chu athecheh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lhagao boh chu mi sunga kona apotdoh tengle, twi beina muntin-ah avahle avahlen, cholngahna aholin; chule amu jou hih-in, Kahung potdohna ka-in mama-a chun chekit tange, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin ahungleh akitheh ngim le akijephoi amun,
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutengle achen ama sanga giloujo lhagao dang sagi agapuijin; chule amaho chua chun alutnun achengji taove; chule mipa umchan chu amasa sangin anununga akhohjoji tan ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ahitin ahi, aman thu chucheng asei chun, numei khat mipi lah-a kon chun aw sangtah-in ajah-a, Navopma naobu le nangman nachep noi chu anunnoma ahiuve, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla aman, Ahinai, ahivangin Pathen thu ja-a jopteho chu anunnomjo ahiuve, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin mipi ho ahenga ahung kikhopkhop phatnun, aman, Tulai hiche khang hi khanggilou ahin; melchihna aholun, ahinla Jonah themgao melchihna tailou adang kipe lou ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ijeh-inem itile Jonah Nineveh mite dinga melchihna ahi banga chu, Mihem Chapa jong tulai khanga ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lhanglam gam lengnun thupi tanna-a hiche tulai khang mite toh hung thoudoh khoma, amaho hi themmo ahinchan ding ahi; ijeh-inem itile aman kolmonga konin Solomon chih thu ngai dingin ahungin ahi; ahin, veuvin, Solomon sanga chungnungjo hikoma aume.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nineveh khopi-a miho chun thupi tanna-a tulai khang mite toh hung ding khoma, tulai khang hi themmo ahinchansah dingu ahi; ijeh-inem itile amahon Jonah thuhil chun alung aheijun ahi; ahin, veuvin, Jonah sanga chungnungjo hikoma aume.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mi koiman meivah avah-in ningchonga guhthimin akoi ngaipoi, lo jong akhukhum ngaipoi, mi aluttehon avah amu theina dingun atunna chunga atungji bouvui.
  </para>
  <para style="p">
    <verse number="34" style="v" />Namit chu natahsa vah ahi; namit achima ahile, nati apumpia vah ahi; aphat lou vangle nati pumpi-a thima ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hijeh chun nasunga vah um chu athim louna dingin kivet phatnin.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hiche jeh chun natahsa apumpia avah sohkeija, athimkom aum louva ahile, meivah vahtah-in nasalvah banga vah sohkei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin thu aseipet chun Pharisai khatnin an nehpi dingin akouvin; chuin ama alutnin, an nedingin atoutan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Pharisai pa chun an aneh masanga akisil lou chu amun adatmo lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Pakai chun ajah-a, Tun Pharisai ho, nanghon khonle lheng apolam nasil ngim naovin; ahin nasung lamu vang hunama lahle kiloset adimsetne.
  </para>
  <para style="p">
    <verse number="40" style="v" />Vo lungthim beiho, apolam sema chun asung lam jong asem hilou ham?
  </para>
  <para style="p">
    <verse number="41" style="v" />Hijongle thil nanei kham khamu chu vaicha gentheite tona dingin peuvin: chutile, veuvin; nangho dinga imajouse athenga ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahinla, ohe Pharisai ho nadau ahi! ijeh-inem itile nanghon pudina le lounakha chule anche louhing jouse somakhat natoh jiuvin; ahinla vaihom dihle Pathen ngailut nadonpouve; ahinla chutiho jong chu donda deh louva hicheng hi nabol dingu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ohe Pharisai ho nangho nadau ahi! ijeh-inem itile nanghon kikhopna in'a touna pipenle, kailhanga min chibai naboh dingu nadeijun ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ohe, danthusun ho, Pharisai ho le miphalhem ho nadau ahi! ijeh-inem itile nangho buikhuh kimu lou, mihon he louva achung ajotlejiu tobang nahiuve ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin danthu them ho khatnin adonbutnin ajah-a, Houhil, nangman chutia nasei chu keiho jong neihoutomu ahi, ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin aman, Ohe, danthu themho nangho jong nadau ahi! ijeh-inem itile nanghon poh-a kilom lou pohgih mi napohsah-un, nanghonla pohgih chu nakhut jung khatchan jong nakhoiji pouve.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nangho nadau ahi! ijeh-inem itile naputeu napateu vin themgaoho athatnun, nanghon alhanu nasempeh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chutichu ahi jeh-in hichu ahetoh nangho nahiuvin, napu napateu thilbol chu naphasah uve; ijeh-inem itile amahon amaho chu athatnun, nanghon alhan natungun ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Hijeh chun Pathen chihna-in jong ahiti seije, Keiman ahenguva themgaoho le solchah ho soling ting; chule amahon abang athaova abang abolset dingu ahi;
  </para>
  <para style="p">
    <verse number="50" style="v" />Chutia chu Abel thisan kiso-a pat, maicham le Pathen houin kikah-a Zachariah athaova athisan kisogei, vannoi leiset bul kiphu tila patna themgaoho jouse thisan kiso chu, hiche tulai khang mite chunga aphu kila ding ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ahi, nangho jah-a kasei ahi, tulai mite chungabou kila ding ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ohe, danthu themho nadau ahi! ijeh-inem itile nanghon hetna kot-heh nalamangun, nanghola nalutpouvin, mi alut dingla nakhamun ahi, ati.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin ajah uva thu chucheng asei phat chun, danthu sunho le Pharisai hon lunghan sah-a thu tamtah seisah din, hachang phinin aphin pan taovin ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Amoso theina diuvin akama kona phabep khat jahdingin aholun, chule achangun ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche pet chun mipi atama tam, khat chunga khat kal leuva ahung kikhop phat chun, aman amasa penin aseijuite jah-a, Pharisai ho chola chun kihong phaovin; hichu phatlhem ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla akiphongdoh lou ding akisela imacha aumpoi, chule hetdoh lou ding imacha aki-ima jong aumpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche jeh-a chu muthima naseichanu chu khovah-a kija ding ahi; chule indan sungnunga nabenga guhthima naseiju chu, in chunga kisam ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule kajol kagol nangho kaseipeh nahiuve, tahsa thattheija akal ima lo thei lou chu kicha hih-un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman nakichat dingu hilunge; atha nunga damuna lelutna ding thaneina neija ama chu kichauvin, najah uva kasei ahi; ama chu kichauvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vasilih nga khu paisa ni manna kilhaji louham? Ahin, alah uva khat jengcha jong Pathen angah suhmilin aumkhapon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin nalu chunguva nasamjang jouseu sana kisim sohkeija ahi. Kicha hih-un; vasilih tamtah sanga nangho lujo nahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule najah uva kasei ahi, Koi hile miho anga keima eiseidoh chan chu, Mihem Chapan jong ama chu Pathen vantil teho anga aseidoh ding ahi:
  </para>
  <para style="p">
    <verse number="9" style="v" />Amavang miho anga keima eiseileppa vang chu, Pathen vantil teho anga ama jong kiseilep ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Mihem Chapa chunga thuse sei jouse chu kingaidam ding ahi; Lhagao Theng taitoma vang chu kingaidam lou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amahon nangho kikhopna-a vaipoho hengle thunei ho henga nakai tengule, Ipi-a iti kadonbut dingham, ipi kasei dingham tin lungkham hih-un;
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijeh-inem itile apettah chule Lhagao Thengin nasei dingu nahil dingu ahinai, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin mipi lah-a kon chun mikhatnin, Mihil, nei le gou eikihoppi dingin ka-u jah-a seijin, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin aman ajah-a, Mihem, kon nangho chunga vaihomle neile gou hoppeh-a eisemem? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ajah uvah, Ching theijun, neipap kiloset jouse-a konin kikangseuvin; ijeh-inem itile mihem khat hinkho hi anei le gou haona-a chu uma ahipoi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman ajah uva thulem khat aseijin, Mihao khat gam sungah neh aput behseh jengin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun aman alungthimin, Kalousoh chengse kakoikhomna ding munla aumpon; i-kalo ding hitam? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman, hitin bolinge: kachangsal chengse phelhang ting, asanga lenjo cheh-in sangkate; chule kalousoh jousele kathil jouse chua chun koikhom inge.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle kalhagao jah-a, Lhagao, nangman kum sottah-a dinga thil tamtah nakikhol khom ahitai; kicholdon, nenlang donin, nomsa tah-in umin tinge, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla Pathen'in ama jah-a, Vo lungthimbei, tujana hi nahinna nanga kona kiladoh ding ahitai; chule nathil kholkhom chengse chu koija hitantem? ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen'a dinga haolouva ama dinga sum kikhola chu chutobang chu ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin aman aseijuite jah-a, Hijeh-a chu nangho jah-a kasei ahi, I-kaneh ding hitam tin nahinna dingule, i-kasila kachen ding hitam tin natahsa dingun lungkham hih-un.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ijeh-inem itile anneh sanga hinkho, nihchen ponsil sanga tahsa thupijo ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Va-ah hokhu ngaitouvin; amahon tula atupouvin, atla a-at pouvin; pang le changsal la aneipouvin; ahivangin Pathen'in amaho khu avahnai. Nangho vacha sanga iti nalutjoh-u hitam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nangho lah-a lungkham hatna ahinkho tongkhat jopsaobe thei koi nahiuvem?
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun nanghon aneopenbon nabol thei louvule, adangdang dinga ibola lungkhama nahiuvem?
  </para>
  <para style="p">
    <verse number="27" style="v" />Molhoipah khu iti khanham ngaitouvin: hiche ho khun tongla atonggim pouvin, patla akheh pouvin; ahivanginla keiman kaseipeh nahiuve, Solomon jeng jong aloupina jouse-a akivon chun, hiche molhoipah khattoh kibangin akijem hoi pon ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule jaova hampa tunia uma jinga lhum sunga kileh lutta ding jengbon Pathen'in achuti jeple, Vo tahsan lhomho, chusanga chu aman nangho najepjoh lou dinguham?
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule ipi naneh dingu, ipi nadon dingu, hichu hol hih-un, chule lung dongin jong um hih-un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ijeh-inem itile vannoi namtinin hitiho jouse chu aholjiuve: ahin hitiho chu nanghon nangai chaove ti na-Pau vin ahenai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahivangin nanghon Pathen lenggam joh chu holun, chutengle hicheng jouse hi naki pehbe dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hon lhomho, kicha hih-un; ijeh-inem itile nangho lenggam pehding hi na-Pau lungdei ahi lheh jenge.
  </para>
  <para style="p">
    <verse number="33" style="v" />Naneichan-u joh-unlang mivaicha gentheiho peuvin; chule guchan amaiphah louna, nget nin jong anehset louna, van'ah sumbom lui thei lou kisemun, kemlou sum kikholun.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ijeh-inem itile nagou umna-a chu nalungu jong umding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Natai kigeh-un, chule nathaomei vahsah jingun;
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule moupui na-a kona ahunga, kot ahin kiu phat phatle hongpai jeng dinga a-pakai lam kat jinga um mitoh bangun.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pakai ahunga soh kiging jinga um ahungtoho chu anunnom ahiuve; keiman nangho tahbeh-a kaseipeh nahiuve, Aman atai akigeh-a, amaho chu ankong aumsah-a, ahenguva hunga amatah ajenleuva pang ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule ama jan dan nina ahim, jan dan thumna ahima ahunga, chuto banga chu ahung to-a ahile, hitobang soh ho chu anunnom ahiuve.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule itih phatna gucha ahung ding inneipun ahet hile, kiging jingintin, phetvang dinga a-in chu adalhah louhel ding ahi, hichu nanghon heuvin.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nangho phasademin umum; ijeh-inem itile nagel lou pettah-ule Mihem Chapa chu hung ding ahi, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Peter'in, Pakai, hiche thulem chu keiho chang dinga naseiha, mi jouse dinga naseiham? ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Pakaiyin, Neiching tahsan umtah le chingtah, aphatcha achan cheh-u an hoppeh dinga a-pakaipan a-insunga jouse chunga apipua apansah ding chu koiham?
  </para>
  <para style="p">
    <verse number="43" style="v" />Apakai ahung tenga chutia bol ahungto soh chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nangho tahbeh-a kaseipeh nahiuve, Ama chu anei jouse chunga apipua apansah ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Amavang sohpa chun, Ka pakai ahung geije tihen, soh numei ho le soh pasal ho deng pan tahen, chule nehen, donhen khamtale,
  </para>
  <para style="p">
    <verse number="46" style="v" />Hiche sohpa chun aginchat lou nitahle, ahetlou pettah-a a-pakaipa chu hunga; ama chu tum ni asoa, achan chu tahsan louho lah-a akoi ding ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule soh a-pakai lung lam he-a, phasadema umlou, chule alunggot banga bol lou chu tamtah vei kivo ding ahi:
  </para>
  <para style="p">
    <verse number="48" style="v" />Ahin hetlouva voh ding dola thilbola vang chu kivo lhom ding ahi. Ijeh inem itile tamtah kipe henga chu tamtah kibeng ding; chule koi hile atamjocheh kivopsah henga chu atamjo cheh kingeh ding ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Keima vannoi leiset chunga mei lehlha dinga hunga kahi; tutah jeng jong hin kadohtale katinave!
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahivangin baptize chan ding kaneijin, chuche kamolso masangse-a iti kaningnoh hitam!
  </para>
  <para style="p">
    <verse number="51" style="v" />Lei chunga chamna lensah dinga hunga neingai touvem? Ahipoi, kaseipeh nahiuve, asukhen dingjoh-a hung kahibouve:
  </para>
  <para style="p">
    <verse number="52" style="v" />Ijeh-inem itile tukal insung khatna mi nga umchu ni-a kikhen diu, nin thum adouva, thumin ni adou ding ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Pan achapa adou ding, chapan apa adou ding, nun achanu adou ding; chanun anu adouding, teh-in amounu adou ding, mouvin atehpi adouva kikhento diu ahi, ati.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin aman mipi ho jah-a jong chun, Nanghon lhum lama mei soh namu tengule, go ju ding ahi nati paijen jiuvin; chule ahitahbeh jin ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chule lhang lama kona hui anunle, sa lheh ding ahi natiji uvin; hi jong chu achutijin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nangho miphalhem ho, nanghon leiset chungle van umjela nasuto thei naovin, tulai hiti thil umchan iti nasuhto thei lou uham?
  </para>
  <para style="p">
    <verse number="57" style="v" />Chule ibola nanghon adihlam chu nakingaito lou uham?
  </para>
  <para style="p">
    <verse number="58" style="v" />Ijeh-inem itile naheh patoh thutan vaipo henga nache tengule, lampia ama-a kona kiteldohna dingin kihabolin, achuti loule aman nang thutan vaipo henga nacham louva nakai ding ahi; chule thutan vaihom chun sottol miman khutna pen natin, sottol miman chun songkul'a nakhum ding ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Kaseipeh nahi, nangman paisa san khat geija nasahsoh masangse-a, iti jongle chua kona napotdoh louhel ding ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche pettah chun akoma um phabepmin, Pilate'in Galilee miho atha-a, athisanu a-Pathen hou nahou toh achopel thu chu ajah-a aseijun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jesu'n adonbutnin, ajah uva, Chutobang athoh jeh uva chu amaho chu Galilee miho jouse sanga chonse deh ahiuve, tia nangaitou vem?
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaseipeh nahiuve, ahipoi: nangho jong lung nahei louvule chutobangma chu namanthah dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Siloam insang achima mi somleget adel lihho jong chu Jerusalem'a cheng jouse sanga suhkhel neideh-a nangaitou vem?
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaseipeh nahiuve, ahipoi: nangho jong lung nahei louvule chutobangma chu namanthah dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman thulem hiche hi aseijin ahi: Mikhat hin alengpi leijah theichang phung khat kiphut aneijin; chuin aga ahung holin ahile, khatcha jong amupon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman lengpilei lhoupa jah-a, Ven, hiche kum thum sung hin kahungin, theichang phunga aga kahung holjin khatchala kamupoi; phuh lhutan; hiche hin idinga alei manmo aso dingham? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman adonbutnin ajah-a, Pakai, tu kum-in jong hoitadin; keiman akimvel lai jingting, bong-eh sunginge;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chukala agale apha; aga lou vangle phuhtan, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin cholngah nin kikhopna in khatnah thu ahilin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hia chun veuvin, kum somle kum get chamona lhagao vop numei khat aumin; amanu chu atingbonga, achama dingjang thei louhel ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jesu'n amanu chu amu phatnin, akouvin, ajah-a, Numei, nachamona-a kona kilhadoh nahitai, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amanu chungah akhut angamin ahile chupettah chun ajangpaihel jengin, Pathen avahchoitan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin cholngah ni-a Jesu'n adamsah jeh chun, kikhopna in vaipopa chun lunghang tah-in adonbutnin, miho jah-a, Mihemin na atohna ding ni gup uma ahin; hiche sung chun hungun lang kibol damuvin; cholngah ni vangle hungji hih-un, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla Pakaiyin ama chu adonbutnin, Nangho mi miphalhem ho, nanghon nabongchalu hijongle, nasangan'u hi jongle cholngah ni-a a-ankonga kona nasutlhah uva twi dona napui chehji hih-um?
  </para>
  <para style="p">
    <verse number="16" style="v" />Achutile Abraham son hiche numeinu hi, veuvin, kum somle kum get Satan'in ahen na-a kona cholngah ni-a sutlhah angai hilouham? ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thu chucheng asei phatnin adouho chu ajahcha taovin; mipi chengse vang chu athilbol loupi jouse jeh chun akipah sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun aman hitin seije, Pathen lenggam chu itobang ham? Ipitoh katekah ding ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Ankam mu chang khat mikhatnin alah-a ahona athea, akhandoh-a thingphung asoa, abah lah-a chunga leng vachaho age tobang ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman aseiben, Pathen lenggam chu ipitoh katekah ding ham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Numei khatnin chol alah-a, changbong dan thum lah-a aboncha apomsoh kahse-a avui tobang ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun aman khopihole khoneoho ajotnin, thu ahilpeh-in, Jerusalem ajonin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin mikhatnin ajah-a, Pakai, huhhing-a umding hohi lhom uvam? ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman amaho jah-a, Kot jima lut ding kichu-uvin: ijeh-inem itile keiman nangho kaseipeh nahiuve, mi tamtah lut kigo ding, ahivanga lut thei lou ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin a-inneipu akipatdoh-a kot akha nungle nangho polama nadin uva, Pakai, Pakai, kot neihonun, tia kot nakiu tengule; aman, Hoilam kon mi nahiu kahepoi ati ding;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutengle nanghon, Na-ang sungtah-a jong kaneuvin kadonun, chule kakhosung lamlenuva jong neihilui nati dingu;
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule aman, Keiman nangho hoilam kon nahiu kahepoi; kakoma konin chemangun, nangho chonset bolteho, ati ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham, Isaac, Jacob chule themgaoho jouse Pathen lenggama a-umu namuva, nangho pama nakiledoh-u namu tengule, hikoma chu kale hagel umding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule amaho solamle lhum lama kon, sahlam le lhanglama kona hunguva, Pathen lenggama tou ding ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule, veuvin, anukhahho chu masa ding, chule amasaho chu nukhah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiche pettah chun Pharisai ho phabep ahungun, ajah-a, Hikoma konin potdoh-in; chemangtan, ijeh-inem itile Herod'in tha dingin natupme, atiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin aman amaho jah-a, Cheovinlang chuche Sial jah-a chun gaseijun, Ven, keiman tunile jinga thilhaho kanodoh-a, anaho kadamsah ahin, athum ni leh kachaisoh ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahoi hijongle tunile jinga, chule akitni leh kachena dinga kachepeh ding ahi; ijeh-inem itile Jerusalem louva themgao thi thei ahipoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Vo Jerusalem, Jerusalem, themgaoho that le ahenga kisol teho songa seplih; ahpin anoute alha noija a-opkhum banga, keiman jong nachate ijatvei opkhum dinga kagot hitam! Ahin nangho nanompouve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Veuvin, na-in chu akamhel dinga nangho kidalhah peh nahiuve; chule tahbeh-a kaseipeh nahiuve, Pakai mina hungpa chu anunnome nati masang seuva, keima neimu lou dingu ahi, ati.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, cholngah nin Pharisai ho pipu khat in'a an nedingin achen, amahon avelhi jingun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin veuvin, amasanga chun akhut akeng pom khat aumin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jesu'n adonbutnin danthu themho le Pharisai ho jah-a thu aseijin, Cholngah ni-a boldam danngai ham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahola athipbeh-un ahi. Chuin aman ama chu alan aboldamin, chuin achesahtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman ajah uva, Nalah uva koi nahiuvem, asangan ahim abongchal ahim twikul'a lhalut tale, cholngah ni-a agaloidoh paijeng lou dinga? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amahon hicheng chu adonbut thei kit tapouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin akikouhon touna phapha alhenu amu phatnin, thulem khat aseijin ajah uva,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangho mi khattouvin moupui golvahna-a nakou tengule touna pipen-ah tou hih-un; ajole nangho sanga ja umjo akou umkhantin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Akoupa le ahungpa chu anilhonin hungintin najah-a, Hichepa hi mun otnin ati ding; chutengle nangma jahcha puma anoinung pena natou ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amavang nangma nakikou tengle, chenlang anempena touvin; hitichu hile nakoupa ahung tengle najah-a, Jol, sangjep-ah toutango tikhat nintin; hiteng chule ankonga natoupi jouse maija chu choi-atna naum ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijeh-inem itile ama kichoisang jouse chu kisunem ding; chule ama kineosah-a chu choisanga umding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman akoupa jah-a, Nangman sun hijongle jan hijongle golvah nabol tengle, najol, nagol jong, nasopi ho jong kou hih-in, nainkote le naheng nakom mihaoho jong kou hih-in; ajole amahon jong nangma kouvin natin sadoh getnun nate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin golvah nabol tengle, mivaicha, mi tikimlou, elbai, mitcho koujo bouvin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nangma nanun nom ding ahi; ijeh-inem itile amaho chun lesahna ding ima aneipouve: ajeh chu mi chondihho tho kit tengle nangma nakisa ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ankonga atoupiho khatnin hitiho chu ajan, ajah uva, Pathen lenggama changlhah ne dingpa chu anunnoma ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin aman ajah-a, Mi koiham khatnin jan golvah loupitah abolin; chule mi tamtah akouvin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin anneh phatnin aman akouho chu, Hungun, tun ijakai aphasadem cheh ahitai ti dingin asohpa asolin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amaho chu thakhat tah-in ana thuphaove. Amasapenpan ajah-a, Keiman lou kachon, kache-a kagavet lou akhoh-e; katao ahi, neilha ongin, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin khatpan, Keiman bongchal to nga kachon, aphat aset patep dinga che ding kahi; katao ahi, neilha ongin, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin khatpan, Keiman ji kaneijin, hijeh chun hung theiponge, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun sohpa chu ahungin hitiho chu a-pakaipa henga alhutnin ahi. Chutah-in inneipu chu alunghangin asohpa jah-a chun, Chedoh loijin khosung lamlen le khopi sung thokah juija gachen, chule mi vaicha, mi tibukimlou, chule mitcho, elbai hikoma gapuilutnin ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin sohpa chun, Pakai, neithupeh bangin kabolin, ahivangin mun a-ong nalaije, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin pakai chun sohpa jah-a chun, Nangma lamlhongle daipamah chen, chule ka-in adimna dingin, miho gajollut teiteijin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kaseipeh nahi, Kami kouho chu khatchan jong kagolvah an atepkhahlou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichun mipi hon tamtah amatoh alhonun; chuin ama akiheijin ajah uva,
  </para>
  <para style="p">
    <verse number="26" style="v" />Koi hijongle kahenga hunga apa, anu, aji, achate, asopipaho, asopinuho chule ama hinkho jeng jong itcha louhela bollou chu kaseijui hi thei lou ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koi hile athingpel kiputle-a kanung hin jui lou chu kaseijui hi thei lou ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh-inem itile insang sah ding go-an touva ijat lut dingham, chule ajojou ding hina ajo joulou dingham, tia sutoh masa lou nalah uva koi nahiuvem?
  </para>
  <para style="p">
    <verse number="29" style="v" />Ama chun abul phutdoh hen jouta hihle, ija kihe-am, amuho jousen ama chu nuisat untin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichepan asapanin, ajou joutapoi, ti getnunte.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahiloule leng khat leng chom khattoh kisatto dingan, asat dinga hung mi sangsomni chu mi sang soma ajo ding hina ajolou dingham, ti touva geltoh masa lou dinga koiham?
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajo lou dinga ahile, khat chu gamla tah-a aum petna kichamna thutep thum dinga palai asol ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hitobanga chu nangho lah-a jong anei chengse dalha louva chu kaseijui hi thei lou ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chi hi aphai, ahivangin chi jeng jong tamta henlang hile ipi-a ki-alsah dingham?
  </para>
  <para style="p">
    <verse number="35" style="v" />Leining dinla aphapon, bong-eh din jongla aphatna umlou ahitan; min hichu pam lama apaidohjin ahi. Angaina ding na neijan ngaihen, ati.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichun kaidongho jousele michonseho jouse athu ngai dingin ahengah ahung naijun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pharisaiho le danthu sunhon, Hichepan michonseho aloijin, amahotoh an ane khome atiuvin aphun gel taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman amaho jah-a thulem hiche hi aseije,
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho lah-a koi nahiuvem, kelngoi jakhat neija, alah-a khat amanle amanglou somko le ko chu gama dalha-a, avahmang khat chu amudoh kahse-a hol louva?
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amudoh tengle kipahtah-in alengkouva apujin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule in ahung lhun tengle agolho le a-inhengho akou khomin, ajah uva, Neikipa piuvin; ijeh-inem itile kakelngoi manga chu kamutai, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaseipeh nahiuve, chutobang chun alung hei ding khoh lou michonpha somko le ko chunga sanga, michonse khat lungheija van'a kipana umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahiloule numei koiham dangka som neija, khat amansahle meivah dea, chule in theh-a amudoh kahse-a gunchu tah-a hol lou dinga?
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amanun amudoh tengle agolhole a-inhengho akou khomin, Neikipa piuvin; ijeh-inem itile kadangka mansah chu kamutai, atijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaseipeh nahiuve, chutobang chun Pathen vantilte angah michonse khat lunghei chungah kipana aumjin ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman, Mikhatnin chapa ni aneijin:
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule aneojopa chun apa jah-a, Hepa, kagou chan ding chu neipen, ati. Chuin aman anei chu ahop pehtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ni chomkhat jouvin aneojopa chun abonchan achom khomin, khol gamlatah khatnah achen; chuin aman chukoma chun anei chengse chu kinomsahnan asumang sohtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aboncha asuhmang phatnin, chuche gama chun kel nasatah alhatan ahile, hichun ama chu alhasam pantan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ama achen, chuche gam miho khat agabelin; chuin amapa chun avoh vah dingin alou lama asolin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin voh neh imahoh hochu neh-a oiva ding ago lheh jengin, koimanla apepon ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin akhahdoh phatnin, Kapa in'a asoh thalah ho khujatpi nehkhop le nehval changlhah neija, keimala gilkela thiding kahi!
  </para>
  <para style="p">
    <verse number="18" style="v" />Keima kipat ingting kapa henga chengting, ajah-a, Pa, van douna le nangma mitmun kachonse tai;
  </para>
  <para style="p">
    <verse number="19" style="v" />Kei nachapa tihoi kahitapoi; nasoh thalah ho khat bangin neisemin gatitange, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ama akipatnin, apa henga ahungtai. Ahin ama gamlatah agei nalaijin, apan amun, alung asen, alhaijelin, angonga achun, achopchuh chuh jengin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin achapa chun ajah-a, Hepa, keima van douna le nangma mitmun kachonse tai: nachapa tihoi kahitapoi; nasoh thalah ho khat bangin neisemin, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin apan asohho jah-a, Pon phapentah galadoh loijunlang silpeh-un, chule khutjem akhutna bupeh-un, chule kengchot sepeh-un.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule bongnou kivah thao chu hinlaovin lang thatnun, chule neuhitin, nomsa tah-in umu hite:
  </para>
  <para style="p">
    <verse number="24" style="v" />Ijeh-inem itile hiche kachapa hi athisa hing kit ahin; chule amangsa kimu kit ahi, ati. Hitichun nop abol pantaove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiche petna chun achapa lenjo chu louva um ahin; chuin ahunga in kom ahung naijin, ima kitum ginle lam gin ajan;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman asohho khat akouvin, Hikhu ipi bola hiuvam? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman ajah-a, Nanaopa hunga ahile napan damsela amu kit jeh-a bongnou kivah thao chu atha ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichun ama alunghangin, in'a che ding anomtapon ahi. Hijeh chun apa apotdoh-in, agajolin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivangin aman apa adonbutnin, Ven, keiman kum hijat hi nangma kajenin, khatveicha jong nathu kapal lhahna aumpoi; ahivanginla kagol hotoh golnop kabolna dingin kelnou khatcha jong imatih-in neipekhapoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin hiche nachapa notiho koma nanei chengse nemanga sumanghela hi ahung hungin bongnou kivah thao nathapeh-e, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin apan ajah-a, Chapa, nangma kakoma umjing nahin, chule kanei jouse nanga ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hiche nanaopa vanghi athisa hing kit ahin; amangsa kimu kit ahi; hijeh-a chu nom satah leh kipahtah-a i-um dingu ahi, ati.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman aseijuite jah-a jong hiche hi aseije, Mihaotah khatnin neiching aneijin; ama chun anei asumange tin ahenga aheh taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman ama chu akouvin, ajah-a, Hiche nachunga thu kajah hi iti thuham? Naneichin sutoh sohkeijin lang neipen; ijeh-inem itile tukala neichinga napanthei louding ahitai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin neichingpa chun ama changin, Ka pakaipan neichinga kapan eihaisah ahitan; ipi i-kati ding hitam? Lei lai dingla katha ahatpon; thum dingla kajah achan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Neichinga kapan eihaisah tengle mihon a-in'a eilhunsahna dingun, kabol ding tun kahetai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman a-pakaipa sumbaho chengse chu akouvin, amasapenpa jah-a, Nangman ka pakaipa ijat nabat em? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amapan, Thao tena jakhat thao, ati. Hichun neiching chun ajah-a, Nalekha sut hin lanlang tou loijin, somnga sunin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin adang khat jah-a, Nangin ijat nabat em? ati. Chuin aman, suhlouchang tena jakhat, ati. Chuin aman ajah-a, Nalekha sut hin lanlang somget sunin, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuche chondihlou neiching chun chingtheitah-a abol jeh chun a-pakaipan apahchatan ahi: ijeh-inem itile hiche vannoi leiset chate hi amaho khang mite dingin khovah chate sangin aching jouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule kaseipeh nahiuve, Chonphat louna sumin jolle gol kisemun; na lhinlel tengle amahon tonsotna chenna in'a chu nachensah na dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Koi hijongle themcha chunga tahsan umchu, tamtah chunga jong tahsan aumjin; themcha chunga chondihlou chu, tamtah chunga jong chondihji lou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chonphat louna sum chunga bon tahsan naum louvule, sumtah kon nanganseuva nachinsah dinguham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi dang chunga bon tahsan naum louvule, nangho-a chu kon napeh dingu ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Soh khatnin pakai ni na atongkop theipoi. Ijeh-inem itile khat hotbolintin, khat angailut ding ahi; ahiloule khatna hakai jintin, khatjoh anahsahmo ding ahi. Nangho Pathen le sum soh nahikop thei lou dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin sum ngailu-a Pharisai hon hicheng chu ajauvin, ama chu anelpeh-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman amaho jah-a, Nangho mi mitmu-a kichonphat sahbou nahiuve; ahivangin Pathen'in nalungu ahenai; ijeh inem itile milah-a choi-atna um chu, Pathen mitmu-a thet umtah ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Danthu le themgaoho thu chu John phat geija ding ahi. Chuche kala chu Pathen lenggam thuhi kihil lhanga ahin, mitin chua chun thahatsanin alut cheh-ui.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin danthu halsicha khat manthah sangin, vanle lei kitolmang abaijoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aji da-a achom dang kichenpi chan chu ajonga ahi; chule a-inneipun ada numei kichenpia jong chu ajonga ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tun mihaotah khat aumin, ama chun ponsandup le tupat ponnem akisilin, loupitah-in niseh-in nomsa tah-in aumjin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule ati pumpi-a tina veija amin Lazarus atiu khat akotbulah alupsah-un,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche mihaopa dokhanga kona lhajah anmal chu neh-a oiva anomlheh jengin ahi. Achung chonin uicha hon atinaho chu ahung leh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ahitin ahi, khutdopa chu athitan ahile vantil hon Abraham anga din ahung potaove: chuin mihaopa jong chu athitan ahile avuitaove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin damuna ama genthei theija akibol athohlelin, akhodale gamlatah-a Abraham le a-anga tou Lazarus chu amutan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman agahsamin, Kapa Abraham, neilungset in, Lazarus chu akhutjung muh twija dekot henlang kalei dedap dingin hinsolin; ijeh-inem itile keima hiche meikongah gimthoh-in kaume, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin Abraham'in, Kachapa, nangin nahinkho lhumkeija thil pha namu-a, hiche banga chu Lazarus'in thilphalou amu chu geldoh temin: tu vanga ama lungmong tah-a uma, chule nangma gimthoh-a um nahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chucheng kalvalin jong keiho le nangho umna kah-a hi onghom lentah kikoidet ahin, chenom jongle hikoma kona nangho umna lama koima che thei lou; chule chua kona jong keiho lama koima hung galkai thei lou ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichun aman, Hijeh-a chu katao ahi, hepa, ama chu kapa in'a solin,
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh inem itile sopi pasal nga kaneijin, amaho khu gahet tohsah hen, achuti loule amaho jong hikom nat thohgimna mun'a hi hung dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahinla Abraham'in, Amahon Mosi le themgaoho anei naove; amaho thu chu ngaijuhen, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman, Ahipoi, kapa Abraham; mithi lah-a mi khatmong ahenguva gachele bou alung ahei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman ajah-a, Amahon Mosi le themgaoho thu angai louvule, mithi lah-a mi khat thoudoh jongle tahsandeh pouvinte, ati.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman aseijuite jah-a, kipal lhuh umlou thei ahipoi, ahinla kipal lhuh sahpa chu ada ahi!
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichepa chun hiche aneochaho lah-a khat akipal lhuhsah sangin, angonga sumhei song kikhaihen, twikhanglen'ah kileh lutle ama dinga phajo ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho kichih theijun, nasopi nangdouna-a achonsetle phoh-un; chua alung aheija ahile ngaidamun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ama nachunga ni khat sunga sagivei achonsetna, chule sagivei nahenga ahung kiheija, Kakisih-e, atile, ngaidamin ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin solchah hon Pakai jah-a chun, Pakai, katahsanu khansahben atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin, Nanghon tahsan na ankam-mu te beh nanei uva ahile, hiche thingtheimi phung jah-a hin, Kibotdoh inlang twikhanglen'a kiphut in tileu chun, nathuva nung ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla nangho lah-a koi nahiuvem, asohpan lou kaija, ahiloule gan chinga louva kona ahungleh henga, tule tuhin hungin, an nedingin touvin tia sei dinga?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutia titah sanga, Kaneh ding an neigot peh-in, keiman kaneh jou kadon jou kahsen natai kigeh-inlang neijenin; chujoule nangin naneh-a nadon dingbou ahi, atijoh lou dingham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuche sohpa chun thupeh dungjuija abol jeh-a chu a-pakaipan apachat ngaijem? Katahsanpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutobanga chu nanghon jong nakithupeh chengseu nabol jousoh tengule, Soh phachom lou kahiuve, kabol dingdol bep kabolu ahi, tiuvin, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, Jerusalem jonin achen ahile, Samaria le Galilee gam ajotpan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ama kho khatna alutnin ahile, miphah somin anakimutopin, amaho chu gamlata-a adingun,
  </para>
  <para style="p">
    <verse number="13" style="v" />Pipu Jesu, neilungsetnun, tin hasaptah-in asamun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman amaho chu amu phatnin, ajah uvah, Cheovinlang thempuho gakivetsah uvin, ati. Chuin ahitin ahi, acheuva ahile adam thengpa taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin alah uva khat chun adamthengtah chu ahet phatnin, akinunglen, aw sangtah-in Pathen avahchoijin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin akengphang bulah aboh khupmin, athangvah tai; ama chu Samaria mi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu'n adonbutnin, Som kisutheng hi louham? Mi ko hoibaham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche chidang namdangpa tailou adangho Pathen vahchoi dinga hung kinungle-a akimupoi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman ajah-a, Thouvin, chetan; natahsanin nadamsah ahitai, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin, Pathen lenggam itih-a ahung lhun ding Pharisai hon adongun ahile, aman adonbutnin, Pathen lenggam chu mu theijin ahungpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Veuvin, hikomah, ahiloule khukomah kiti lou ding ahi; ijeh-inem itile veuvin, Pathen lenggam nalah uva aume, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin aman aseijuite jah-a, Nanghon Mihem Chapa hinlai nikhoho khat beh namu nom dingu, ahivanga namu lou dingu nikho chu hung lhung ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutengle, veuvin, khukomah; veuvin, hikomah tia najah uva asei dingu ahi; ahivangin nangho che hih-un, amaho nung jong jui hih-un;
  </para>
  <para style="p">
    <verse number="24" style="v" />Ijeh-inem itile kolphe vannoi kolmong lang khat lama aphetna, kolmong lang khat geija asalvahji banga, Mihem Chapa hung ni jong chutobang ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin hiche masanga chu thil tamtah athoh ding, chule hiche khang mite paija umtei ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Noah hinlai thilsoh umchan bang chu, Mihem Chapa nikho jongle hi ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Noah kong'a alut ni gei chun amahon aneuvin, adonun, akichengun, chule akichensah-un; chuin twisang ahung lenin, abonchauvin asumang heltan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutobangma chun Lot hin laijin jong asoh-in: mihon aneuvin, adonun, thil ajoh-un, thil achouvin, aphutnun, chule in asauvin;
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivangin Sodom kho-a kona Lot apotdoh nitah-in van'a konin mei le kath ahung lhan, abonchauvin asumanghel tan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche tobanga chu Mihem Chapa hung kiphondoh ni jongle hi ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiche ni chule in chunga uma chu insunga athil um kilah dingin hungkum hihhen; chutima chun loujaova uma jong hung kinungle kit dahen.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lot inneipi chu geldoh-un.
  </para>
  <para style="p">
    <verse number="33" style="v" />Koihile ahinna huhdoh nading hola chun achan ding ahi; chule ahinna chana chun akihuhbit ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kaseipeh nahiuve, chuche jan chule mi ni jalkhun khatna lumding; khat chu kila-a, khat chu kidalha ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Numei nin sumhei khatna agoi khom ding; khat kila-a, khat kidalha ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mi ni louva umding; khat kila-a, khat kidalha ding ahi, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin amahon adonbutnun, ajah-a, Hoija-em, Pakai? atiuve. Chuin aman, Thilong umna-a chu muthong kikhom ding ahi, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin mihem chu lhadah louhela tao jing jeng ding ahi ti hetsahnan, ajah uva thulem khat aseijin:
  </para>
  <para style="p">
    <verse number="2" style="v" />Khopi khatna Pathen ging lou, mihem jong ja lou thutan vaihom khat aumin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuche khopi-a chun meithainu khat jong aumin; chuin amanu chu thutan vaihompa henga chun ahungjin, kakilung doupi chunga phu neilah peh-in tin ahung seijin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amapa chom khat chu anom hih-in; ahivangin ajo phasah-in ama changin akihouvin, keiman Pathen kagin louva, mihem jong kaja lou vangin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche meithai nun eisuh lunggim jing jeh hin, aphu lahpeh maitange, achuti loule ahung jingjeng hin eisu lungvai jinte, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin, thutan vaihom chondih loupa chun ipi aseijem, ngaijun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule achunguva lungdesot jeng jongle, sunle jana ama akou koujeng ami lhendoh ho phu chu Pathen'in alah lou dingham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaseipeh nahiuve, aman gangtah-a phu alah ding ahi. Ahivanginla Mihem Chapa ahung tengle, vannoi'a hin tahsan ahung mun'a dingem? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin michonpha kingaito-a ama kitahsana midang imacha sah louho jah-a jong, thulem hiche hi aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi ni houin'a Pathen lhai dingin ache lhonin; khat chu Pharisai ahin, chule khat chu kaidong ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharisai pa chu adingin achangin hitin ataovin ahi, Vo Pathen, keiman nangma kathangvah-e, keima midangho banga hunama la-a, chondihlou, jonga, chule hiche kaidongpa tobang jong hi kahipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman hapta khat sungin nivei an kangoljin; kamu jouse hop soma hop khat kapejin ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaidongpa vang chu gamlatah-a adingin, amit jong vandah nom louvin, Vo Pathen, michonse keima hi neilungset in tin a-op achum achumin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaseipeh nahiuve, khatjopa sang chun hichepa chu themchangin aumin a-in'a achesuhtai; ijeh-inem itile koi hile ama kichoisang chan chu kisunem ding; ama kineosah bou chu choisanga umding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin mi phabepmin aman atham dingin anaosenho jong ahengah ahinpuijun; ahin seijuiten amu phatnun, amaho chu ana phoh-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin Jesu'n amaho chu ahenga akouvin, Chapangho chu kahenga hung sah-un; jada hih-un: ijeh-inem itile Pathen gam chu hitobang teho-a bou ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tahbeh-a kaseipeh nahiuve, Koi hile chapangneo tobanga Pathen gam sang lou chu, iti nama jongle chua lut louhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin vaipo khatnin adongin, Houhilpha, tonsot hin kemlou channa dinga ipi kabol dingham? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Jesu'n ajah-a, Ibola apha neitiham? Pathen khatseh tailou koimacha apha aumpoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thupeh chengse, jon bol hih-in, tolthat hih-in, gucha hih-in, thujouvin mi heh hih-in, nanu napa jabolin, ti chu nahenai, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman, hichengse chu kachapan laija patna kahin nitpeh ahitai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Jesu'n hichu ajah phatnin ajah-a, Nalhin lelna khat aum nalaije; nanei chengse joh-inlang mivaicha gentheiho hoppeh-in, chutile van'a gou nanei ding ahi; chule hungin lang kanung hinjuijin, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin aman chucheng ajah phat chun, mihaotah ahi jeh chun alungnommo lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Jesu'n ama chu amun, Mihaoho hi Pathen gama alut-u iti hahsat hitam!
  </para>
  <para style="p">
    <verse number="25" style="v" />Ijeh-inem itile mihao Pathen gama alut sangin, heubil homa sangongsang lut abaijoi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin chuche asei jaho chun, Chuti ahile koi huhhing-a um jou dingham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahivangin aman, Mihem dinga hithei lou chu Pathen dinga hithei ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Peter'in, Vetemin, keihon kaneiju kadalhaovin nanung kahinjui taove, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman ajah uva, Tahbeh-a kaseipeh nahiuve, Pathen lenggam jala a-in, anu, apate, asopite, aji le achate hin dalha-a chu,
  </para>
  <para style="p">
    <verse number="30" style="v" />Tu hinlai sunga ajat tamtah mube loule, khonung hinkho-a tonsot hin kemlou chang lou dinga koima aumpoi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman somleni ho chu apuijin, ajah uva, Veuvin, Jerusalem jonin iche touvui, chule themgaoho-a kona thu kisun jouse chu Mihem Chapa chunga kichai soh ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ijeh-inem itile ama chidang namdangho khutna pehdoh-a umding, chule totnopna aneijuva, jachat umtah-a aboldingu, chule chil aset khum dingu;
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule avoh uva, atha dingu ahi. Chule ani thum nile thoudoh kit ding ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahivangin amaho dinga ki-ima ahi jeh-in, hitiho chu khatcha jong angainaje ahepouvin, ipi kiseija ahi jong ahepouve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin ahitin ahi, Jericho anaijin mitcho khat lam pama touva khutdo aumin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin lampia mipi ache chu ajan, Hichu ipiham, tin adongin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin, Nazareth Jesu chulama chu chea ahi, tin aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin aman, Jesu, David chapa, keima neilungset in tin asamtan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin amasanga cheho chun thipbeh-a umdingin aphoh-un; ahivangin ama chun, David chapa, neilungset in, tin ahasapcheh tan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Jesu adingin, ama chu ahenga pui dingin thu apen ahi: chuin ama akom ahung gei phatnin, adongin,
  </para>
  <para style="p">
    <verse number="41" style="v" />Keiman nangma iloleng nalungham? ati. Chuin aman, Pakai, kho muleng kati, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Jesu'n ajah-a, kho mutan; natahsanin nadamsah ahitai, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin chupettah chun kho amupai jengin, anung ajuijin, Pathen avahchoi avahchoijin: chuin miho jouse chun amu phatnun Pathen avahchoi taovin ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jesu alutnin Jericho lailung ajotnin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun veuvin, amin Zacchaeus atiu mi khat aumin; chule ama chu kaidong pipu ahin, mihao ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama chun hoipen khu Jesu ahidem tin mu tei agon, ahivangin ama minem ahi jeh-in mipi jeh chun amu theipon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ama masang lama analhai jel-in, ama anave dingin theiba chungah anakale; ijeh-inem itile aman hilam chu aho ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jesu chukom mun chu ageijin, chunglam agahven ahile ama chu amun, ajah-a, Zacchaeus, hung kum loijin; ijeh inem itile tunia na-in'a kalhun ding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ama ahung kum loijin, kipahtah-in a-in'a alhunsah tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin hichu amu phatnun, Michonse in'a lhungin acheta getne atiuvin, abonchauvin aphuntaove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Zacchaeus adingdoh-in, Pakai jah-a chun, Ven, Pakai, kanei jouse akeh khat mivaicha genthei pengkate; mi koija hile lepthol-a kalah aumle ajat li-in lenge, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jesu'n ajah-a, Tunin hiche in'a hin huhhingna alhungtai, ijeh-inem itile ama jong hi Abraham son ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh-inem itile amangsa chu holdoh-a huhhing dinga Mihem Chapa hung ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin mihon hicheng thu chu angai pettah-u chun, Jerusalem anaitah jeh-ule Pathen lenggam chu chupet tah-a chu kilangdoh paijeng dinga angaito jeh-u chun, aman aseibeben thulem khat aseijin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun aman ahiti seije, Miluntah khat lenggam gakilah-a chule hung kile kit dingin khol gamlatah-a achen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule ache kon chun asohte mi som akou khomin, talent som apen ajah uva, Kahung kahsen hiche-a hin ana kiveijun, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin agam miten ama ahotbolun, anunga palai asolun, kachunguva leng changa vaipo dingin hichepa hi kanompouve, agah ti sahtaove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahitin ahi, ama alengchana ahung kit phatnin, sum apeh asohteho chun ipipi ijat aveikan um ti hetna dingin, amaho kouna ding thu apetan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amasapa chu ahungin a-angah, Pakai, na sana sum chun talent som kaveikane, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman ajah-a, Nabol aphai, sohpha; nangma themcha khat chunga tahsan naum jeh chun, kho som chungah vaipon pangin, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin abanapa chu ahungin ajah-a, Pakai, na sana sum chun talent nga kaveikane, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama jah-a jong chun, Nang jong kho nga chunga vaipon pangin, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin khatpa ahungin, Pakai, ven, na sana sumchu hiche hi ahi, ultheh pona kachuna, kakoihe ahi:
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu nangma mikhel nahin, nakoina lou pouvah naladoh jin, natuna lou pouvah na-atjin ahile nang kakichan ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman, Vo nang soh gilou, nakama thupot dungjuija nathu katan ding ahi: kakoina louva kalahjia, katuna louva ka-atji nahet ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuti an kasum chu ibola sumkhol pungna-a nanakoida ham? Chutile keiman kasum athoitoh kilahtha tadinga, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman akoma dingho jah-a chun, Talent chu lahpeh unlang talent som neipa chu petaovin.
  </para>
  <para style="p">
    <verse number="25" style="v" />(Chuin amahon ajah-a, Pakai, aman talent som aneinai, atiuve.)
  </para>
  <para style="p">
    <verse number="26" style="v" />Najah uva kasei ahi, aneichana chu kipe ding ahi; anei lou vang chu aneichasun jong chu ama-a kona kilahmang pehding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche achunguva kavaipoh ding nomlou ho eimelmaho vanghi hikoma hinpuijun, ka-ang sunga thatnun, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin chucheng asei jou chun, Jerusalem lam jonin ama alamkaijin achetou taove.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, Olivet atiu molsang Bethphage le Bethany ahungnai phatnin, aseijuiho mi ni asolin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Namasang jon lhona khosunga khun lut lhonin; nalut lut lhonle sangan nou kihen koima touna khahlou laihel namu paijen lhon ding ahi; hichu sut lhonin lang hinkai lhonin.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule, Ibola nasut lhonham tia khattou nadong lhona aumle, Pakaiyin manna nom aneije, ti lhonin, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin akisolte ni chu ache lhonin ahile, ajah lhona aseibang bang chun agamu lhonin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin asut lhonle aneiten ajah lhona, Sangan nou chu ibola nasut lhonham? ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin amanin, Pakaiyin manna nom aneije, ati lhone.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichun Jesu henga ahinkai lhonin; chuin amahon aponu sangan nou chunga chun aphaovin, achunga Jesu atousah-un ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin achen ahile, amahon aponu lam dunga aphaovin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin ama ahung naija, Olive molsang kumlhahna ageijin, aseijuite mipi chu hapan akipah athanom un, thilbol kidang dang abol amu chengseu jal chun aw sangtah-in Pathen avahchoijun,
  </para>
  <para style="p">
    <verse number="38" style="v" />Pakai mina hunga lengpa anun nome, van'ah cham lenghen, chungnung penah loupina hihen, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin mipi lah-a kon chun Pharisai ho kimkhatnin ajah-a, Houhil, naseijuite phoh-in, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin aman adonbutnin; Najah uvah kasei ahi, Hiteho thipleu, songho ao doh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin ahung naija khopi chu amu phatnin, akachamin,
  </para>
  <para style="p">
    <verse number="42" style="v" />Ohe, nangma tah-in tuni hin lungmonna thuhi kihet tave le chun! Tunla nahet louna dinga ki-ima ahitai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ijeh inem itile nagalteuvin nakimvela kul aset sanga, naum kimvela, naum chah dingu nikho hunglhung ding ahi,
  </para>
  <para style="p">
    <verse number="44" style="v" />Nasunga nachatetoh nangma leiset toh kibanga abola, nalah-a song khat chunga khat um louhela alha dingu ahi; hichu nakivil laiju nahet lou jeh ahi, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin ama houin'ah alutnin, chuche sunga thil johho le thilchoho chu anodoh panin,
  </para>
  <para style="p">
    <verse number="46" style="v" />Ajah uva, Ka-in chu taona in hi ding ahi, tin akisune; ahin nanghon gucha michom kokhuh-in nasemtaove, ati.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin nisehle houin'a chun ahiljin ahi. Ahin thempu pipuiho le danthu sunho, chule miho pipuho chun ama suhmangna ding aholun;
  </para>
  <para style="p">
    <verse number="48" style="v" />Ahivangin mipi chengse chun aboncha ama thu angaijuva, ama jenga akai jing jeh-u chun alonaje ding aholmovin ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, chulai chun ni khat aman houin'a thupha ahil lhanga, miho thu ahil petnin, thempu pipuiho le danthu sunho toh upaho ahenga ahungun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajah-a, Ipi thunei na-a hitiho hi nabolham? Koiham hiche thuneina nape-a hi? neisei peh-un, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman adonbutnin, ajah uva, Keiman jong nangho thu khat donging kate; neisei peh-un;
  </para>
  <para style="p">
    <verse number="4" style="v" />John baptize chansah chu van'a konham, mihem'a konham? ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amaho akingai touvin, Van'a kon ahi tileuhenla, ibola ama natahsan lou uham tintin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihem'a kon ahi tileuhenla, miho jousen songa eise dingu ahin; ijeh-inem itile amahon John chu themgao ahi tia ajopsoh-u ahi, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon, Hoija konham kahepouve, tin adonbut taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Jesu'n amaho jah-a achutile ipi thuneija hicheng kabol ahi, keiman jong seipehdeh pouvinge, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman miho jah-a hiche thulem hi asei pantan ahi. Mikhatnin lengpilei abolin, leilhouho khutna apedoh-in, sottah gatham dingin mi gam danga achetan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aga lhun phatnin aman asoh khat aleilhouho henga, amahon lengpi leija ga chu ama ahinpeh dingun asolin; ahinla leilhouho chun ama chu avovin, khutgoh keuvin akilesah taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman soh khat asol nalaijin, ama jong chu avovin jachat umtah-in abolun, agoh keuvin asolmang taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin athumna asol kittan ahile, ama jong chu ana vovin, po lama apaidoh taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin lengpilei neipa chun, I kalo ding hitam? Kachapa deitah hi solinge: ama hi anajabol khatnunte, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin leilhou hon amu phatnun, amahole amaho akihouvun, Ama hi agou lo dinga chu ahi; hungun agou lo ding chu eihoa ahina dingin, ama hi thatnu hite, akitiuvin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin lengpilei po lama akaidoh-un, athat taovin ahi. Hijeh chun lengpilei neipa chun amaho chu ilontem?
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama hungintin aleilhouho chu sugamintin, lengpilei chu mi dang petante, ati. Chuin amahon hichu ajah phatnun, Chuti hihhen, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin aman amaho chu aven, Achutile, Insahon adeimoa apaiju song chu Aninga songpipenin apangtai, tia kisun hi ibaham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Koi hijongle chuche song chunga lhu chan chu ahal hala chip ding ahi; chule koi hile achunga chuche song chua chu leivui banga kithejal ding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin danthu sunho le thempu pipuihon, hiche thulem asei chu amaho gotna-a asei ahi chu aheuvin, chupet tah-a chu achunga khut lhah ding agouvin; ahinla miho chu akichauvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amahon achanglhi jingun, athuseija themmo chana gam vaipo thuneina le thunoija pehdoh theina dingin, chonpha limlhemin changlhi phabep khat asolun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon ajah-a, Houhil, nangman dihtah-a naseija mi nahil ahi, chule koima mai ve louhela dihtah-a Pathen lampi chu nahil ahi, hichu kaheuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Caesar kai kapeh-u hi dan ngai hina, hilouham? tin adongun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahivangin aman alungthim bolu chu ahen, amaho jah-a, Ibola neipatepmu ham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Denarius khat neivet sah-un. Koi lim le koi min chongam? ati. Amahon adonbutnun, Ceasar'a, atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman ajah uva, achutile Caesar'a chu Caesar peuvinlang, Pathen'a chu Pathen petangu, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amahon miho ang sunga athu seijin aman theita pouvin, athu donbut chu adatmo lheh jengun, athipbeh taovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin, mithi thokitna aumpoi tia Saddukai ho phabep ahenga ahungun ajah-a,
  </para>
  <para style="p">
    <verse number="28" style="v" />Houhil, koi hile sopi nei khattouvin ji aneija cha nei louva athile, asopipa chun ajinu chu kichenpi henlang asopipa ding chun chi khaipehhen tin Mosi'n lekha eisutpeh-un ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aphai, ucha pasal sagite khat aumun, amasa penpa chun ji aneijin chabeijin athitai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ani channapan amanu chu jin aneijin, amapa chabeijin athitai. Chuin athumnapan numeinu chu jin aneijin; chuti chun asagi uvin aneijun, chabeijin athi taovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Akhonna-in numeinu jong chu athitan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahile thokitna-a amanu chu alah uva koipen ji hitantem?
  </para>
  <para style="p">
    <verse number="33" style="v" />Ijeh-inem itile asagiuva amanu chu ji-a anei sohkeiju ahi, atiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jesu'n ajah uva, Hiche vannoi leiset chate hi akichengun, chule chen jong akichensah-un;
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahin chuche gam lodinga kilomho le athia kona thoudoh ho vang chu akicheng tapouve, chen jong akichensah tapouve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule amaho thi kit thei talou ahiuve; ijeh-inem itile amaho chu vantilte tobang ahiuvin; chule thoukit chate ahi jeh-u chun Pathen chate ahiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Mosi'n jong hamboh thua chun, Pakai chu Abraham Pathen, Isaac Pathen, chule Jacob Pathen, ati chun mithiho kaithouvin aumui ti aphongdoh-e.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ama athiho Pathen hilouvin, ahingho Pathen ahijo bouve; ijeh-inem itile mi jouse ama mitmu-a ahing ahicheh-e, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hichun danthu sunho abang bangin adonbutnun, Houhil, nasei apha lheh jenge, atiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ijeh-inem itile amahon ama hiche kal chu ima adong ngam tapouvin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin aman amaho jah-a, Christa chu David chapa ahi iti kitiham?
  </para>
  <para style="p">
    <verse number="42" style="v" />Ijeh-inem itile David amatah-in a-Labua, Pakaiyin ka Pakai jah-a, Nangma kajet lamah touvin,
  </para>
  <para style="p">
    <verse number="43" style="v" />Keiman namelmate chengse nakeng chotpha-a kaneisah masangsen, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hitichun David'in ama chu Pakai ati; achutile achapa iti hi thei dingham? ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin mi jouse jah dingin aseijuite jah-a,
  </para>
  <para style="p">
    <verse number="46" style="v" />Sangkhol choltah kiah-a vale noma, chule kailhanga min chibai aboh ding deija, chule kikhopna in le golvahna-a touna pipen deija danthu sunho-a konin kihong phaovin;
  </para>
  <para style="p">
    <verse number="47" style="v" />Amahon Meithaiho in abahgamun, chule alhema sot tahtah taojia ahiuve; amaho chu themmo chang chungnung ding ahiuve, ati.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ama akhodah-in ahile, mihao hon sumdolna boma athilto alelutnu amun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hia chun meithai vaicha khatman jong sumsan nongsi peh ni alelut amun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman, Nangho jah-a tahbeh-a kasei ahi, amaho dang jouse sangin hiche meithai vaichanun atam lelut pene;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ijeh-inem itile amahon aneivalu Pathen'a atouva alelutnu ahin, amanu vang hin ahinpi aneisun alelut jeng ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin mi phabep khatnin houin chu song phatahtah le thilto khomho-a akijephoi chu aseijun ahile, aman,
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon namu-u hicheng hi kisusuchim louva song khat chunga khat kisethop himhim aum louhel ding nikhoho chu hunglhung ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon adongun, Ahile, houhil, hicheng chu itihle hi dingham? Chule hiho chu ahung sodoh ding phat amelchihna ipi hintem? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman hitin aseije, Lheplhah-a puimanga naum louna dingun kichih theijun; ijeh-inem itile mi tamtah keima minin hunguntin, keima Christa kahi; chule phat anaije, ahung ti dingu ahi; hijongle amaho nung chu jui hih-un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nanghon gal kisatle thunoh najah tengule tija hih-un; ijeh-inem itile hicheng chu hungsoh masa tei ding ahi; hijongle akichaina chu hunglhung pai louding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman ajah uva, Vai khatle vai khat, gam khatle gam khat hung kidou vintin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule mun chom mun choma ling nasatahtah hung kihot intin, kel lhantin, gamna hise leng ding, chule van'a kona kichat tijat umtahle melchihna nasatah hung umding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amavang thil hicheng chu ahung sodoh masanga amahon nachung uva akhut alhah uva, nabolset dingu, akikhopnao le songkul'a dinga napehdoh dingu, chule keima min jala lengho le gamvaipoho anga nahin kailut dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hettohsahna naneina dinguva hicheng chu hung sohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche jeh chun iti donbut ding nagel masah louna dingun nalunguvah kisetnun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ijeh-inem itile namelmaho jouseuvin nadoudal thei lounaole, nanel lhah thei louna dingu kamle lungthim themna kapeh dingu nahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin nanu napau, nasopiu, na-inko, chule najol nagolu chu napedoh uva hung pang ding ahi; chule nalah uva abang bang ahin thasah dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule keima min jala nangho mi jouse hotna nahung umdingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahivangin nalu chunguva nasamjang khatchao jong mangthah lou ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanghon thohhatna nahinnao nakihuh doh dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang Jerusalem galmin aum kimvel teng vangle, amanthah nading anaitai ti heuvin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutengle Juda gama um chengse thinglhang lamah jamuhen; chule khopi sunga uma chu potdoh hen; chule gama umho chu asunga lutdauhen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ijeh-inem itile thu kisun jouse guilhun sohna dinga, hichu phulah nikho hija ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin, ohe, hichelai chule agaija le naonoi chepsahho ada nadinguve! Ijeh-inem itile gam leiset chunga hesoh genthei khohtah le hiche mite chunga hi lunghanna chu ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule amaho chemhema lou ding, chule chitin namtin lah-a gal hinga kikaimang gam dingu; chule chidang namdangte nikho lhin kahse-a Jerusalem hi chidang namdangte chotpha-a umding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nisa, lhathah, chule ahsihoa melchihna hung umding; chule twikhanglen kitum le kinon jeh-a lei chunga namtin lungdonga umteho chunga hesohna hung umding;
  </para>
  <para style="p">
    <verse number="26" style="v" />Mihemte chu kichatna jehle vannoi leiset chunga thil soh dingho ngaitona jeh-a haisam dingu ahi: ijeh-inem itile van thahatna ho chengse kihotling soh ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutahle Mihem Chapa chu thuneitah le loupi chungnung tah-a meibola ahung amu dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin thil chucheng ahung so kipat tengle, khodah unlang chunglam veuvin; ijeh-inem itile nakilhatdoh nadingu anaije, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman amaho jah-a thulem khat aseijin: Theichang le thing dang jouse khu veuvin;
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajih adotdoh namu tengule, nipi anaitai ti naheuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutobang chun nanghon jong hicheng chu aguilhun namu tengule, Pathen lenggam anaitai ti heuvin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tahbeh-a kaseipeh nahiuve, aboncha aguilhun masangse-a, hiche khangguija mite hi mang lou dingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Vanle lei mang ding ahin; keima thu vang mang lou ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Amavang kihong phaovin, achuti loule an mohneh nehle jukham, chule hinlai khankho ding thu ngaitonan nalungu lontin, chuche ni chu thang bangin phulou helouvin nachung uva hung chu phung getninte.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuche ni chu thang banga vannoi leiset gam jouse-a cheng mi jouse chunga chu ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hijongle thil hung soh ding jouse-a kona sohcha dinga lom le Mihem Chapa anga ding dinga lom nahina dingun, imatih chanin kiging jingin umun, chule tao jingun, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hichelai chun aman sun tengle houin'a thu ahiljin; chule janle apotdoh jin Olivet atiu molsanga agageh jin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule miho jouse chu athu ngai dingin jingkah matah le houin'a ahung hungjiuvin ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kalchuh kut atiu cholsolou changlhah kut chu anaitan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin thempu pipuiho le danthu sunhon ama chu atha theina dingje aholtauvin ahi; ijeh-inem itile miho chu akichauvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin somleni lah-a Iscariot atiu Judas sunga chun Satan aluttan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama chu achen thempu pipuiho le houvaipoho toh ama chu amaho amatsah theina dingje chu akihou taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amaho akipah-un, ama chu sum peh dingin atep taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichea chun ama anomin, chule mipi umlou petcha aman ama chu amaho henga pehdoh-a matsahna thei ding agomkom aholtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin kalchuh kutna kelngoi thana ding, cholsolou changlhah nikho chu ahung lhungtan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman Peter le John asolin, Chelhonin lang kalchuh kut ineh dingu gago lhonin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amanin, Hoikoma gago lhonleng nalungham? ati lhone.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman ajah lhona, Ve lhonin, nangni khopi sung nalut lut lhonle twibel pu-a mi khattoh nakisuhto lhon ding ahi; ama nung chu jui lhonin, alutna in'ah lut lhonin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hiche in neipa jah-a chun, Houhilin nangma henga hitin aseije, Kaseijuite toh kalchuh kut an kanehna ding indan chu hoilaiham? ati, gati lhonin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amapa chun in dan chungnung lentah gotsadem khat navetsah lhon ding ahi; hikoma chun anago lhontan, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amani ache lhonin, aman ajah lhona aseibang bang chun agatoh lhonin, kalchuh kut agagong lhontan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aphat alhinin, ankong aumtan, chule solchah somleni ho chun aum piuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman ajah uva, Kathohgim masanga nang hotoh kalchuh kut an nehkhom ding hi katup lheh jenge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ijeh-inem itile nangho jah-a kasei ahi, Pathen lenggama hiche hi aguilhun masangse-a kaneh lou ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman khon chu alan, athangvah-in, Hiche hi kilah unlang kihom-un;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijeh-inem itile kaseipeh nahiuve, Pathen lenggam hung lhun kahse-a, keiman tukala lengpiga twi kadon lou ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin changlhah alan, athangvah-in, ahehbal balin, amaho chu apen, Hiche hi nangho dinga kipe-a katahsa ahi; keima neihet jingna dingun hiche hi bolun, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin chutima chun khon chu alan a-anneh jouvun, Hiche khon hi kathisana kitepna thah, nangho dinga kisodoh chu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivanginla, veuvin, eipedoh-a pang dingpa khut chu dokhanga hin keitoh kaum khome.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihem Chapa chu akigon banga chonpeh ding ahi; ahivangin apedoh-a pang mipa chu adana-e! ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amahon alah uva chutobang thilbol ding chu koipen ahi dingu akidongto taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin alah uva koipen chu achungnung penin akiseidem tia kinelna asohdoh tan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman ajah uva, Chidang namdangho lengho khu achunguva alal lheh-un; chule achunguva thunei ho khu phatna bol akitiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangho vang nachuti lou dingu ahi; ahin nalah uva alenjo chu aneojo bangin umhen, chule apipen chu lhachale bangin umhen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ijeh-inem itile ankonga toule alhachale koijoh lenjo-em? Ankonga toujoh chu hilouham? Ahinla keima nangho lah-a lhachale bangin kaume.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin eiki patepna-a eiumpi jingpeh nangho nahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule ka Pan keima eigotpeh banga, keiman nangho lenggam khat kagotpeh nahiuve;
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutia chu kagam sunga kadokhang chunga naneh-a nadon uva, chule nangho lal touna-a natou uva Israel phung somle phung ni thu natan dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Pakaiyin aseijin, Simon, Simon, ven, chang kilhichil banga lhitchil dingin Satan'in nathume;
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahivangin natahsan alosam louna dingin kataopeh-e: chule nangman nalung nahei kit nungle nasopiteho jong naphudet ding ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin aman ajah-a, Pakai, nangma toh songkul le thina-a chetha dinga kigosa dema umjing kahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin aman ajah-a, Peter, kaseipeh nahi, nangman keima neihet hi thumvei naseilep masangse-a tunia ahchal khong lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin aman amaho jah-a, Keiman nangho kengchot selou, sumbom keng lou, chule sakhao keng louva kasoluva chu ima nalhahsam nao umji-am? ati. Chuin amahon, Aumjipoi, atiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin aman ajah uva, Tu vangin sumbom nei neijan kiken hen; chutima chun sakhao jong kiken hen; chule chemjam nei lou louvan asangkhol johhen, chemjam khat kichoh hen.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ijeh-inem itile kaseipeh nahiuve, Ama michonseho toh kisimtha ahitai, tia thu kisun chu kachunga guilhung sohkei ding ahi; ijeh-inem itile keima chungchang thudol chengse kichaisoh ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin amahon, Pakai, hikoma chemjam ni aume, atiuve. Aman, Hichu aphasetne, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin ama achonna ngai bangin apotdoh-in, Olivet molsanga achetan; aseijuiten jong anungnung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chukom mun chu alhun phatnun, ajah uva, Lhepma nalhah louna dingun taovun, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin ama songse phahna chan khat ache chonin, adilsun ataovin,
  </para>
  <para style="p">
    <verse number="42" style="v" />Hepa, naphatsahle hiche khon hi kakoma konin chon mangin; ahivangin keima lunggot bang hi louvin nangma lunggot bangjoh hihen, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin van'a konin vantil khat ahung kilah-in, thahat ahungpen ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin aman na asa behseh jengin, guntah-in atao kittan; chule thisan aloma tolla valha bangin, a-ul thisanin along jengtan ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin atao jouvin athoudoh-in aseijuite henga ahungin ahile, amaho lungkhama ana-imutlhuh-u ahungtoh-in,
  </para>
  <para style="p">
    <verse number="46" style="v" />Ajah uva, Nangho ibola ihmua nahiuvem? Lhepna-a nalhah louna dingun thouvun lang taovun, ati.
  </para>
  <para style="p">
    <verse number="47" style="v" />Aman chutia asei pettah chun, veuvin, mipi hon khat ahungin, solchah somleni lah-a Judas atiu chu ahung lamkaijin; chuin ama chun Jesu chop dingin akom ahin naijin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ahin Jesu'n ajah-a, Vo Judas, Mihem Chapa hi chopma matsah nagot ham? ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin akimvela umho chun ipi aso ding chu amuvin, ajah-a, Pakai, chemjam'a kasat dingu hitam? atiuve.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin alah uva khatnin thempu chungnung sohpa asatle, abilkol jetlam asatlhatan ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin Jesu'n ajah-a, Hichan beh hi phalun, ati. Chuin abilkol chu athamin aboldamtan ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin aman dinga hung thempu pipuiho, houin ngah vaipoho, chule upaho jah-a chun, Gucha michom man dinga kon banga chemjamle moltum tho-a nahung konu ham?
  </para>
  <para style="p">
    <verse number="53" style="v" />Nang hotoh niseh-a houin'a kaum lai chunla keima matnan nakhut nalha pouvin; amavang tu hi nangho phat le muthim thahat ahi, ati.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin amahon ama amanun, thempu chungnung in lama akaitaove; chuin Peter'in galkanga ajuipeh-in ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin amahon inpi leitol lailunga mei akitiuva atoukhom petnun, Peter jong amaho lah-a chun atouvin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ama meikoma atou pet chun soh nungah khatnin amun, hoitah-in aven, Hichepa jong hi akiloipi ahi, ati.
  </para>
  <para style="p">
    <verse number="57" style="v" />Ahivangin aman ama chu aseilepmin, Numei ama chu kahepoi, ati.
  </para>
  <para style="p">
    <verse number="58" style="v" />Ajo chomkhat jouvin, mi adang khatnin amun, ajah-a, Nang jong alah uva khat nahi, ati. Ahivangin, Peter'in, Mipa, keima kahipoi, ati.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chuin nidan khat jouvin michom dang khatnin atahti tenin, Tahbeh-in ama jong hi aloiho khat mong mong ahi; ijeh-inem itile ama hi Galilee mi ahi, ati.
  </para>
  <para style="p">
    <verse number="60" style="v" />Ahivangin Peter'in, Mipa, nasei chu keiman kahehih hele, ati. Hichu asei nalaijin, hiche pettah chun ahchal akhongtan ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chuin Pakai chu akiheijin, Peter lam aven ahi. Chuin Peter'in, Tunia ahchal khon masanga thumvei neiseilep ding ahi, tia Pakaiyin asei chu ageldoh-in,
  </para>
  <para style="p">
    <verse number="62" style="v" />Chuin Peter polama apotnin lhasetah-in hakan akaptan ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chuin Jesu manna tuhho chun ama chu totnopnan abolun, chule avovin ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Chuin ponin amit atomun, amai abehpeh-un, koiham nadenga chu gaovinlang seijin? atiuve.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chule ataitom ataitomun ama gotnan thu tamtah aseijun ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chuin jing khovah vah-in, miho upaho chengse, thempu pipuiho, chule danthu sunho chu ahung khomun, houvaipoloi kikhopna-a chun akaijun;
  </para>
  <para style="p">
    <verse number="67" style="v" />Nangma Christa chu nahim? neisei peh-un, atiuve. Ahivangin aman amaho jah-a, Keiman nangho seipeh jongleu veng, natahsan lou dingu;
  </para>
  <para style="p">
    <verse number="68" style="v" />Chule nadong jongleu veng, neidonbut lou dingu, lha jong neilhalou diu ahi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Ahivangin tua pat Mihem Chapa hi Pathen thilbolthei khut jet lama tou ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="70" style="v" />Chuin amahon abonchauvin adongun, Achutile nangma Pathen Chapa nahim? atiuve. Chuin aman ajah uva, Naseiju chu kahi, ati.
  </para>
  <para style="p">
    <verse number="71" style="v" />Chuin amahon, Thu hettohsah dang iding iti tah dinguham? Ijeh inem itile eihotah-in aman akamcheng tah-a asei ijataove, atiuve.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin mipi kikhom chengse chu akipat doh-un, ama chu Pilate henga akaitaovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahehse panun, Hichepa hin, Keima Christa leng kahi atia, Caesar kai peh ding akhama, kanampiu apuiset kamu uve, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pilate'in adongin, Nangma Judah te Lengpa nahim? ati. Chuin aman adonbutnin, Naseikhai, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pilate'in thempu pipuiho le mipi jah-a, Hichepa chunga khansetna imacha kamupoi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amaho ahapan cheh-un, Hichepa hin Galilee gama kipanin hiche kom geijin Juda gam khotinah ahille ahillen, mi jouse achohnoh jin ahi, atitaovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pilate'in Galilee thu ajah phah chun, Ama hi Galilee mi ham? tin adonge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin ama chu Herod thuneina gam mi ahi ahet phatnin, Herod hengah asoltan ahi; ijeh-inem itile hiche laija chu ama Jerusalem'a uma ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Jesu amu phat chun Herod akipah lheh jengin ahi. Ijeh-inem itile aman athu ajah jeh-a sotna pat ama chu mu atup ahitan; chule thil kidang abol khattou mu ding kinem lheh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Herod chun thu tamtah adongin, ahivangin aman imachan adonbutpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin thempu pipuiho le danthu sunho adingun, ama chu ahehheh jengun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Herod le asepaiten nahsahmon abolun, totnopnan aneijun, pon loupi asilpeh-un, chuin Pilate heng lama ahin solkit taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche nitah chun Herod le Pilate akihou thei lhontan ahi; ijeh-inem itile chuche masanga chu kidou jing ahi lhone.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pilate'in thempu pipuiho le vaipoho chule miho chu akou khomin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajah uva, Miho apuisei tia hichepa hi kahenga nahinkaiju ahin; veuvin, keiman amo amolou phatechan na-ang sunguvah kapatepmin, nanghon nahehnao thudola chun achungah themona kamupon;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Herod jengin jong amupoi: ijeh-inem itile aman ihenguva ahinsol kit tai; chule veuvin, aman athina theilom imacha abolpoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun keiman bolgim ingting, lhadohtange, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />(Hiche kut sunga chu amaho chu mi khat alhadohpeh tei ngai ahi).
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahivangin amahon thakhat tah-in asamun, Hichepa hi sumangin, Barabbas neilhadoh peh-un, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama chu khopi sung chonoh jehle atoltha jeh-a songkul'a kikhuma ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jesu chu alhadoh nom jeh-in, Pilate'in ajah uva thu asei kitnin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin amahon, Ama chu thingpel'a khenbeh-in, thingpel'a khenbeh-in, tin asamtauve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin aman athumvei na-in, Ibolin-em? Hichepan ipi suhset aneijem? Keiman thina theilom ama chunga ima kamupoi; hijeh chun bolgim ingting lhadoh tange, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahivangin amahon aw sangtah-in ahasapcheh-un, thingpel'a akhetbeh teina dingin athumun ahi. Chuin amahole thempu pipui aw chun anehjou jotai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin athum banguva bol dingin Pilate'in thu alhuh sahtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman khosung chonoh le tolthat songkul'a kikhum athumpau chu alhadohpeh-in; Jesu vang chu amaho lunggot banga dingin apedohtan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin akaimang phatnun, gama kona hung Cyrene gam mi Simon chu amanun, Jesu nung lama pu dingin achungah thingpel chu angamun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule mihonpi atamatam le a-op chum chuma kap numei mipi nasatah-in anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin Jesu akiheijin ajah uva, Jerusalem chanute, keima neika hih-un, nangho le nachateo dingjoh-in kapmun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ijeh-inem itile, veuvin, Achingho le chavop khalou naobu, chule naonoi chepsah khalouho anun nomui ati nadingu hitobang nikho chu hung lhung ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutengle amahon molsang jah-a, Neilhuh khumun, atiuva lhang jah-a, Neikhu khumun neiselun, ati dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ijeh-inem itile amahon thing hing bon hitia abolule, thing go i-aloda dinguham? ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichea chun amatoh thatha ding akhang gilou adang mi ni jong apuijun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Calvary atiu mun chu alhun phatnun, ama chu thingpelah akhenbeh-un, chule akhang giloute ni jong chu khat ajet lamah, khat avei lamah akhenbeh-un ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jesu'n, Pa, amaho hi ngaidamin; ijeh-inem itile amahon abolu hi ahepouve, ati. Chuin avangphapha changhen tin vang akiveuvin aponsil chu akihom taove.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule miho chu adingun ave jingun ahi. Chuin alah uva um vaipohon chun anelpeh-un, Midang bon huhhing-a chu; Pathen lhen Christa chu ahile, ama kihuh hinghen, atiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin sepaiho jong chun totnop nan aneijun, akoma ahungun, lengpiga twi thuh apeuvin;
  </para>
  <para style="p">
    <verse number="37" style="v" />Juda te lengpa nahile kihuh hingin, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule ama hi JUDA TE LENGPA AHI, tia Greek, Latin, chule Hebrew paova kisun hetsahna achung vumah aumin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin akikhaija khang gilou teni khat chun ajonhouvin, Nangma Christa chu nahile nangma kihuh hingin lang keini jong neihuhhing lhontang, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahivangin khatpa chun ama chu adonbutnin aphoh-in, Talent thakhat namat khom jenga jong, nangman Pathen jeng jong nagin louham?
  </para>
  <para style="p">
    <verse number="41" style="v" />Eini hi talent man ding dol mong ihi; ajehchu ithilbol manbou ikisan ahi: hichepa vanghi ima suhset neilou ahi, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin aman Jesu henga, Pakai nalenggam ma nalhun teng neihe jingin, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Jesu'n amapa jah-a, Tahbeh-a kaseipeh nahi, Tunia gam loupi-a keimatoh i-um khom ding ahi, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hichu nidan gup don ahin, chua pat chun nidan ko geijin gam jouse chunga thim ahung jingin;
  </para>
  <para style="p">
    <verse number="45" style="v" />Nisa athimtan, chule houin'a pondal len chu alailunga akeh lhan ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Jesu'n aw gingtah-in asamin, Pa, nakhutna kalhagao kapedoh-e, atin atantai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin sepai jalamkai chun thil soh umchan chu amun phatnin, Pathen avahchoijin, Hichepa hi michonpha tahbeh mong ahi, ati.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin vetchah chu ve dinga hung khom mipi ho chun thilsoh umchan chengse chu amuvin, a-op beng bengin akinungle taovin ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule akihetpiho le Galilee gama kona ahin kilhonpi numei ho jong chu galkanga adingun, chuti thilsoh hochu amu jingun ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin, veuvin, houvai poloi lah-a chun amin Joseph atiu mikhat aumin; amachu miphatah le chonphatah ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Aman amaho kihousomna le thilbol chu ajop pon ahi. Amahi Judah ho khopi Arimathea kho-a kon ahin, chule Pathen gam ngah jinga um ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hiche mipa hi Pilate henga ahungin, Jesu long chu athumtai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin along chu alalhan, tupat pon nemin atomin, amasanga koimacha koikhahna lou song kilai lhan sunga chun alupsahtan ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hiche ni chu kigot ni ahin, chule cholngah nikho jong anaitan ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin Galilee'a kona ahinlhonpi numei ho chun anung ajuijun, lhanle along chu iti akoiju agaveuvin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Chuin amaho kinungle uvin, lounam le thao namtui akigot uvin; chule danthupeh dungjuijin cholngah nin akicholngah-un, ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hapta nikho masapen jingpi matah-in agotsao thil namtui chu akichoijun, lhan lama chun midang phabep khat to lhonin ahungun, ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin lhankotna kona song chu tahdohsa anaum agamuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin asunga alutnun ahile, Pakai Jesu long chu agamu tapouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ahitin ahi, chuche jeh-a alungdon pettah-un, veuvin, pon avala val lahlah kisil mi ni akomuvah ahung ding lhonin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun amaho tijatah a akunchah pettah-un, chuche mite ni chun ajah uvah, Athiho lah-a ibola ahinga nahol uham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama hikoma aumtapoi, athoudohtai. Aman Galilee gama aum laija najah uva asei,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihem Chapa hi michonseho khutna pehdoh-a umtei ding, chule thingpel'a kikhenbeh ding, chule nithum nileh thoudoh kit tei ding ahi, ati chu geldoh-un, ati lhone.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun amahon athuseiho chu ageldoh-un,
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin lhana kon chun akileuvin, thu chucheng chu somlekhat le adangho jah-a agaseijun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hicheng thu chu solchah ho jah-a gaseija chu Magdalene Mariam, Joanna, Jacob nu Mariam, chule numei danghotoh ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin athuseiju chu amahon moh thu maimaijin anangaitou vin, ana tahsan pouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahivangin Peter akipatdoh-in, lhan lama chun alhai jel-in; chuin akunsuh-in, agahven ahile tupat ponho sehseh aum chu amun, thilsoh umchan chu kidang sapumin akile tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin, veuvin hiche nitah chun alah uva mi ni Emmaus kho-a ache lhonin; hichu Jerusalem'a kona ching somgup ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amani chu chuche thilsoh umchan jouse thudol akihoulim lhonin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahitin ahi, amani akihoulim lhona akidohto pet lhonin, Jesu tah-in ahinnai lhonin, amani chutoh alhonin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amavang amanin ahet lhon louna dinga amit lhon kiphel-a ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman ajah lhona, Nalamjot pum lhona khat le khat ipi thu kihoulim nahi lhona, nguichet nahi lhonham? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin khatjoh amin Cleopas atiu chun adonbutnin, Jerusalem'a kholjin tulai thusoh umchan helou nangma changsehbou nahim? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman amani jah-a, Ipi thu ham? ati. Chuin amanin, Pathen le miho jouse mitmu-a athu-a le athilbola themgao thahat neitah Nazareth Jesu chungchang,
  </para>
  <para style="p">
    <verse number="20" style="v" />Thempu pipuiho le kavaipo houvin tha dinga thu alhuhsah dinga apehdoh uva, thingpel'a athau thudol ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keihonla ama chu Israelte lhatdoh dinga kakineppiu ahi: ahin hicheng tailou chun, chuti thilso-a pat tuni hi anithum ni ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujongle kaloi lah uva jingpi matah-a alhan lama gache-a numei phabep khatnin eilungdon sah-ui;
  </para>
  <para style="p">
    <verse number="23" style="v" />Amahon along agoholmo phatnun, ahung kileuvin, Keihon vantil kamuvin, ama chun, Ama ahing kit tai atie, ahung tiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin kaloi lah uva phabep khat lhan lama agacheule, numei ho sei bangbang chun agamuvin; ama agamu pouvin ahi, ati lhone.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman ajah lhonah, Vo lungthimbei, themgaoho thusei jouse tahsan ding lung ngongkai ho:
  </para>
  <para style="p">
    <verse number="26" style="v" />Christa chun hicheng gim genthei chu athoh sohkeija, chule aloupina-a lut ding mong hilouham? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Mosi'a patle themgaoho jouse-a patnin Pathen lekhabu pumpi-a ama thudol kisun jouse chu amani ahilchentan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin achena dingu khokom ageijun, ama akala chepai ding bang akisai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin amanin alho lhonin, Keinitoh umnao hite; ni asaujo achetan; nilhahkon jong ahitai, ati lhone. Chuin ama amanitoh umdingin aluttan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin amanitoh an nedingin atouvin, aman changlhah alan phatthei aboh-in, chuin aheh balbalin amani chu apei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hitah chun amit lhon avah-in, ama chu ahedoh lhontan; chuin ama amitmu lhona konin amangtan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin amani chun khatnin khat jah-a, Lampi dunga eiki houlimpi lhona Pathen lekhabu thu eihilchen lhona chu ilung soulahlah jeng hih-am? akitito lhone.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiche pettah chun akipat lhonin, Jerusalem lama akile lhonin, chule chukoma somlekhat le aumpiho mun khatna anaum khomu agatoh lhonin;
  </para>
  <para style="p">
    <verse number="34" style="v" />Amahon, Pakai athoudoh tahbeh mongtai; chule Simon akimusah-e, anatiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin lam dunga thu umchan le changlhah ahebala amanin ahetdoh lhon, imajouse chu amanin jong asei lhonin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Thu chucheng asei pettah-un, Jesu alailung uvah ahung dingin, Nachung uvah lungmon umhen, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahivangin amahon thilha kamu ahi tin angaitouvin, akichauvin atija lheh jengui.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin aman ajah uva, Ibola lung olmoa nahiuvem? Chule ibola nalunguva ginchatlel sohham?
  </para>
  <para style="p">
    <verse number="39" style="v" />Kakhut kakeng veuvin lang heuvin, keima kahibouve; neithamun lang veuvin; ijeh-inem itile keima neimu bangu hin lhagaovin gu le phe aneipoi, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hitichun aseijin, akhut akeng avetsahtan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahivangin akipa jeh uva chuche-a jong atahsan lou laijuva alungdon pettah-un, aman ajah uva, Hikoma hi nehding ima them naneijum? ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin amahon nga kikang halkhat le khoibal khat apeuvin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin aman alan a-ang sunguvah anetai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin aman ajah uva, Keima nang hotoh iumkhom laijuva Mosi danthua, themgaoho lekhabua, chule Labu-a, keima thudol kisun jouse guilhung sohkei ding ahi tia najah uva kasei chu hiche ahi, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chutah chun Pathen lekhabua chu ahetdoh theina dingun alungu ahonpeh-in,
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule ajah uva, Hitin akisune, Christa chun gimle genthei athoh-a, anithum nileh athi lah-a kona athodoh kit ngai ahi:
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule Jerusalem'a kipan chitin namtin jah jouse-a ama mina lungheija chonset suhbeina kihil lhang ding ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hichengse chu aboncha ahetoh nangho nahiuve.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule, veuvin, ka Pa thutep chu keiman nangho chunga kahinsol lhah ding ahi; amavang chunga kona thahat na-a nakivon masangseuvin, Jerusalem khopi-a hin um jengun, ati.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin aman amaho chu Bethany khokeng geijin apuidoh-in, akhut ajahdoh-in, amaho chu phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin ahitin ahi, chutia phatthei aboh pettah chun, amaho chu akikhenpin, chuin van'a lahtouvin aumtai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin amahon ama chu ahouvun, kipah thanom tah-in Jerusalem'a ahung kile taovin;
  </para>
  <para style="p">
    <verse number="53" style="v" />Chule houin'a Pathen vahchoi le vangboh-in aum jomjing taovin ahi. Amen.
  </para>
</usx>
