<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MAL" style="id">Malachi</book>
  <para style="h">Malachi</para>
  <para style="toc1">Malachi</para>
  <para style="toc2">Malachi</para>
  <para style="mt">Malachi</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israelte henga Malachi'a kona kiseidoh Pakai thu pohgih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nangho kangailui tin Pakaiyin aseije, ahin nanghon iti neingailut nuham? nati uve. Esau chu Jacob sopi hilouham? tin Pakaiyin aseije. Ahinla keiman Jacob kangailun,
  </para>
  <para style="p">
    <verse number="3" style="v" />Esau vang kahon, amolsangho le agou chanho chu kasusen gamthipma dragonho dingin kakoitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Edom chun, keiho suhmangin umjong leuveng, kahung kilekit uva, agemsaho chu kasahphat kit diu ahi ati; ahinla janel Pakai chun hitin ati, amahon saovintin, hijongle keiman kasuhchim ding; mihon amaho chu khangitlouna gamgi, tonsotna Pakai lung hanna miteho atidiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule namit tah-un mu uvin natin, Israel gamgi-a kona Pakai chu choi-atna umding ahi, natidiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chapan apa ajaboljin, chule soh-in a pakai ajaboljin ahi. Chutia chu keijong pa kahia ahile, eiki jabolna hoiba ham? Chule Pakai kahile eikiginna hoibaham? tin Janel Pakaiyin nangho jah-a aseije, Vo kamin nahsahlou thempuho. Ahinla nanghon hoija chu kanahsah mouvem? nati uve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka-maicham chunga changlhah thenglou natoh-un, ahinla nanghon, hoilaija nangma kasuhboh uvem? nati uve. Pakai dokhang chu nahsahmo-a bolthei ahi tia nasei naova chu nasuh boh-u ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon ganlhaina dinga amitcho natoule, hichu ase hilouham? chule nanghon a-elbai le adamlou natoule, hichu ase hilou ham? tun nagam vaipopao chu hichu gapeuvin, nachunga alung lhaidem, ahiloule nangma nanasang nadem? tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eilungset theina diuvin, tun Pathen henga taovun tia kangeh nahiuve. Hichehi nangho themo ahin, aman nangma nana khohsah nadem? tin janelho Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka maichama moh jenseh-a mei natilou nadinguva, nangho lah ngeija moh jenseh-a kot khah ding koi nahiuvem? Nangho-a lunglhaina kaneipon, nakhut uva nathil peh-u jong laponge tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu nisa sona-a kipatna alhumna changeija, chidang namdangte lah-a kamin kithang ding ahin, amun tina gimnamtui le thilpeh theng kamina kitoh ding ahi. Ijeh inem itile Pathen heloute lah-a kamin kithang ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin nanghon hichu nasuboh-un, hia chun nanghon, Pakai dokhang chu suhboh ahitai; chukoma aga hole asaho sanin nahsahmon aumtai, tin naseijuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujongle nanghon, veuvin, iti ningkitel um hitam! nati uvin, nanah nakhon khumuve, tin janel Pakaiyin aseije; chule nanghon akibot telsa, elbai, chule adamlou chu thilto dingin nahin choijiuve; hichehi nakhut uva kona kasan dingham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla aganhon lah-a achal umjena, chule kihahsela, Pakaiya dinga nol-um toh-a chu gaosap changhen! ajehchu keima leng lentah kahin, chule kaminhi Pathen helouho lah-a kichat umtah ahi, tin janel Pakaiyin aseije.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule tun, vo thempuho, hiche thupeh hi nangho ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichehi nangai lou uva, kamin loupi sahna dinga, nalunga nachin louvule, Janel Pakaiyin aseije, nachung uva gaosapna kahin solding, naphatthei nahou chu kagaosap ding ahi. Nanghon nalunguva nachinlou jeh uva, amaho chu kagaosap sajong ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Veuvin, keiman nachilhah-u kasuhboh-a, namai uva eh kanu ding, na kut loupi houva eh ngeijong chu kanu diu; chule khatnin hiche puma chu napuimang diu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kakitepna Levi mite henga aumjing theina dinga, hiche thupeh hi naheng uva kahinsol ahi ti nahetdiu ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kakitepna hinna le chamna chu amatoh anaumin; aman eigin theina dingin hicheho chu ama kapen, chule kamin masanga akichan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thutah danthu chu akama aumin, amuh-a khangitlouna akimupoi. Lung mongtah le lungdih tah-in keima toh alhon khomin, mi tamtah akhan gitlou naova konin aleheije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh inem itile thempu muh chun hetna achintup ding, akama danthu aholding dol ahi. Ajehchu ama janel Pakai thupole ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin nangho lampia konin nakihei doh-un; mi tamtah dan thua nakipal lhuh sah-un, Levi toh kitepna chu nasuboh uve, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh-a chu nanghon kalampi najotlou dungjuiju le dan thua nalangneiju dungjuija, keiman jong nangho mi jouse anga nahsah mole noise umtah-a kasemu nahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ibonuva Pa khatbou ineiju hilou ham? Pathen khatnin eisem cheh-u hilouham? Ipi dinga ami takipmin asopi kitahlou tah-a iboluva, ipu ipateu kitepna isuhboh-u ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Judah'in kitahlouna ana mangin, Israel le Jerusalem'a thet umtah ana kibole; ajehchu Judah'in Pakaiyin angailut athen nachu asuboh-in, hetkhahlou pathen chanu ana kichenpin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitobang bolpa chu, mihilpa chule ajilpa hihen, janel Pakai henga thilto boljipa hijongle, Jacob houbuh-a kona Pakaiyin asatlhah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche jonghi nabolkit uve: Pakai maicham chu mitlhiho chule kana le pen na-in nakhu khum taovin, hijeh-a chu thilto chu aman ima agel da-a, nakhut uva chu kipah tah-a asanlou ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla nanghon ipijeh inem? nati uve. Ajehchu Pakai chu kitah loutah-a nabol, nakhangdon laija na-inneipi le nangma kikah-a ahetoh ahijeh ahi. Hijongle ama chu nakiloipi, chule kitepna-a na-inneipi hija ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Lhagao chu achunga aumsah-a, Aman amani chu khatna anasem hilouham? Ipijeh-a khat hijaham? Pathen ngaisah ding chilhah aholna ahi. Hijeh-a chu asenji chunga koimacha kitahlou tah-a aumlouna dingin, nalhagaovin ching theijun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Pakai, Israelte Pathen'in kida kaho-e tin aseije; ajehchu mihem khatnin aponsilin pumhat akhukhumin ahi, tin janel Pakaiyin aseije. Hijeh chun kitahlou tah-a nachon louna diuvin, nalhagaovin chingthei jun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nanghon nathuseijun Pakai chu nathachol sah uvin ahi. Hinla hoija kathachol sah-um? nati uve; nanghon, thilse bolchan chu Pakai mitmu-a apha ahin, ama hiche ho-a chun akipah jie nati uva, ahiloule thutan Pathen chu hoija umam? nati tengule nathachol sah-u ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veovin, keiman kasottol soling ting, aman kamasanga kalampi asem ding; nanghon naholu Pakai, achunga nakipanao kitepna thupole pa ngei chu, photlot louva a-houin'a hung ding ahi. Veovin, hungding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahivangin ahung ni chu koiham athohjou ding, ahungkilah teng koiham adingthei dinga? ama chu suhthengna meile sopthengna savon tobang ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama dangka lhahtheng le suthengpa banga touding; Levi chate chun chonphatna-a Pakai henga thilto atotheina diuva asuhthenga, sana dangka banga alhahtheng dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuteng khangluilai le kum masaho banga, Judah le Jerusalem ganlhaina chu Pakai dinga lunglhaina hikit ding ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman thutan dinga naheng kahin naiding: doichoiho, jon panho, jouva kihahsel ho, sum thalo ho le meithaiho chule pabeiho bolgimho, maljinho kiheimang khumho, chule keima eiging louho douna-a hettohsah gangtah kahi ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu keima kikhel lou Pathen kahin; vo Jacob chateho, hijeh-a chu nangho suhmanga umlou nahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Napu napateu nikholaija patnin kahoudan thupeh ho-a konin nache mangun, hicheho chu nitjong nanitpouvin ahi, kahenga hung kileovin, keima jong naheng uva hungkilenge, tin janel Pakaiyin aseije. Ahinla nanghon iti kahungkile diuham? nati uve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihem'in Pathen achom ngaijem? Ahin nanghon keima neichom uve. Ahinla nanghon hoija nang kachomun? nati uve. Hopsom le thilto-a neichomun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon neichom jeh-u leh, hiche nam pumpi jeng jonghin eichom jeh uva, gaosapna-a gaosap chang nahitaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka-in'a nehle chah aumna dingin, hopsom jouse thilkholna insung hinlhutnun, van kot ho kahona asunga akoina ding indan aumlou geija phattheina kahin buhlhah hih-em, tun hiche-a hin neipatep untin, janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nangho khohsahna jala bahgampa chu kaphosal ding, aman naleisetna gahou chu asuhmang tahlou ding; loulaija lengpiga injong aphat masanga aga apulsah louding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangma kipa umtah gam nahitah ding jeh-a, nam jousen anunnom nati diu ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nathu houchu kachunga akhouthei lheh-e, tin Pakaiyin aseije. Ahin nanghon nangma douna-a chutiloma ipi kaseibeh uvem? nati uvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanghon, Pathen kinbol hi pannabei ahi: eihon ahoudan thupeh initnuva, chule lunghem tah-a janel Pakai anga ivaleova ipi phachomam? nati uve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule tun nanghon mikiletsah ho chu akipah-e natiuvin; henge, khangilou tah-a lamlha ho chu choisangin aumin; Pathen lhem patep ho jengjong ahoidoh-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakai gingho chu khatle khat akihouvun; Pakaiyin angaijin ajatan; Pakai ginga, amin geldoh jingho dingin, a-angsunga geldoh jingna lekhabu khat akisunin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kasongmantam ho kasemdoh nikho leh, amaho keima-a hidiu ahi tin janel Pakaiyin aseije; chuteng mipa khatnin alhacha-a pang achapa akhendoh banga, keiman jong amaho chu kakhendoh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutengleh hungkile heijun natin, michonpha le mikhangilou nahet khendiu, Pathen jen le ajenlouho nahekhen diu ahitai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ajehchu, veuvin, meilhumpi banga kading nikho chu ahung lhunge; chule mi hoitho jouse le thilse bol ho jouse kipallhudiu ahi; hiche nikho hunglhung ding chun amaho akahvam heldiu, hichun ajungjong abah jong akhenlou ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla kamin ginga nangho din vang chonphatna nisa chu alhaving teni-a damna puma hungsoh ding; chule nangho bongkula bongnou kivah ho banga napotdoh uva, nakhandoh diu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche kabol ding nikho chule, mikhangilou ho chu nachot phaova, amaho chu nakengto noijuva leivui hidiu, ahi tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kasohpa Mosi dan, Horeb mun'a Israel mite jouse dinga ahenga kathupeh, dan kisunho le thutanna chu geldoh jingun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Veovin, Pakai nikho loupi le kichat umtah ahunglhun masanga Elijah themgao kahin solpeh ding nahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama chun pate lungsung chate lama, chate lungsung pate lama alehei ding ahi, achuti loule keima hungin ting leiset hi gaosap na-a kajep ding ahi.
  </para>
</usx>
