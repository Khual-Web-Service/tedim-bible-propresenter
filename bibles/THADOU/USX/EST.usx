<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EST" style="id">Esther</book>
  <para style="h">Esther</para>
  <para style="toc1">Esther</para>
  <para style="toc2">Esther</para>
  <para style="mt">Esther</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Ahasuerus nikho laijin ahung hitin ahi, (hiche Ahasuerus hi India'a kona Ethiopia changei gamkai jakhatle somni le sagi chunga analeng changin ahi)
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuche laichun, Shushan'a um leng inpia Ahasuerus lengpa alenggam laltouna-a atoujin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Alengchan kal kumthum channa-in, aman pipuiho le asohho jouse dingin golvah abolin; Persia le Media thaneina, gamkai pipuiho, chule milenho chu amasanga aumuvin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule aman alenggam loupitah haona, chule alal loupina nasatah jabola aumna chu nikho tamtah, nijakhat le nisomget sungin avetsah-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin hiche nikhoho chu akichai phatnin, lengpan leng inpi honsunga chun alen aneo khenlouvin, Shushan leng inpia mi jouse chu nisagi golnop abolpin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hia chun akang, a-engle aduma kisem pondal ho chu, tupat patngat le dangka sumkola akikhaijin, chule songval khompi ho-a chun akihenin; chule sanale dangka-a kisem tounaho chu songlhongnal sanpeh, adum, akang, avoma kisemho chunga chun akidon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon amaho chu sana khonin leng ju chu adon diuvin ahomun, (akhonho chu achomcheh ahi,) chule lenggam kipohna dungjuijin, ju aneng jengjung jengin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hichea adonu chu dan dungjuija kibol ahin; koima acham louva kibol aumpoi: ajehchu lengpan amijouse chu amacheh dei dungjuija abolpeh dinguva a-in'a vaipoho chu athupeh cheh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule lengnu Vashti jong chun lengpa Ahasuerus leng inpia chun, numei umjouse chu golnop abolpin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nisagi lhin ni-a, lengpan ju adona alung akipa petnin, aman Mehuman, Biztha, Harbona, Bigtha, chule Abagtha Zethar, chule Carcas, Ahasuerus anga kinbol nukiso sagiho chu asolin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Lengnu Vashti chu melhoitah ahijeh-in, mipile milenho vetsah dinga, aleng lukhuh puma lengpa anga ahinpui dingun thu apen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahivangin Vashti lengnu chu anukisoho-a kona leng thupeh-a hungding chu anompon; hijeh chun lengpa alung ahangtan, alungsa tuntun jengin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphatnin lengpan michingho, phat umchan hethemho henga chun aseijin, (ajehchu dan le thutanje heho chungchanga lengpa umdan ngai mong ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule ama bantah-a hochu Persia le Media'a milen sagiho Carshena, Shethar, Admathah, Tarshish, Meres, Mersena, chule Memucan ahiuvin, amaho chu lengpa angsunga lutmasapen le lenggam sunga alenpenho ahiuvin ahi;)
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahasuerus lengpan nukiso ho-a kona apeh thupeh amanun anittah loujeh-a, dan dungjuija Vashti lengnu chunga ipi ibol diu hitam? tin adonge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Memucan'in lengpa le pipuiho anga chun adonbutnin, lengnu Vashti in lengpa heng seh-a dihloutah abol hilouvin, Ahasuerus lengpa gamkai jouse-a, milen jousele mipi jouse chunga jong abolkhel ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Ahasuerus lengpan, Vashti lengnu amasanga hinpuidia thupeh apehle, amanu ahungpon ahi ti thuhi ahung kiseison tengle, lengnu natoh hi numei ho jousen hin hedoh-untin, amahon amitmuva ajiteu chu ajalou dingu ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche banga chu Persia le Media'a numei ho lengnu thilbol jajouse chun lengpa pipuiho jouse henga chu lengnu natoh ajah-u chu aseidingu ahi. Hitia chu kitaitom nale lunghana tamtah sohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lengpa lunglam ahile, Vashti chu Ahasuerus lengpa masanga hunglut talou ding ahi tin ama-a konin leng thupeh khat sohdoh hen, chule hichu khelkit tahlou dingin Media le Persia dan lah-a kisunlut hen; chule lengpan lengnu mun chu ama sanga phajo dangkhat pehen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule aman apeh ding leng thupeh chu alenggam pumpi-a akiphon dohteng (ajeh chu lenggam chu lentah hija ahi), numei jousen ajiteu chu alen hihen aneo hijongle jana apehcheh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin kithumopna hin lengpa le pipuiho chu alung lhaisah lheh-in; chule Memucan thusei dungjui chun lengpan aboltai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun lengpan gamkaiho jouse-a, agamkai jouse alekhajem cheh uva, amitakip apao cheh-un, Pasal tinin a-insung cheh-a vai ahom cheh dingu ahi tin, amitakip pao dungjuija phonjal dingin lekha athottan ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche hojouse nung, lengpa Ahasuerus alunghan na-a kon alungdam phatnin, Vashti le athilbol, chule achunga thupeh ho chu ahin geldoh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ajenlea pang asohho chun lengpa henga, Lengpa-a dingin nungah theng donglai melhoi kiholpeh hen:
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nungah theng donglai melhoiho jouse chu leng inpi Shushan'a, numei ho chingpa lengpa nukiso Hegai vettupna-a, numei ho umna in'a kholkhom dingin, lengpan alenggama gamkai jouse sunga vaipoho pansah hen. Chule amaho chu akisuhtheng nadinguva khoh thilho chu kipehen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule lengpa lunglhaina penpen nungah chu lengnu Vashti khel hihen, atiuve. Chule lengpan hichu pha asan, hitichun aboltai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tun Shushan leng inpi sunga chun Juda mi khat aumin, amin Mordecai akitin, Jair chapa, Shimei chapa, Kish chapa Benjamin mi ahin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahi Jerusalem'a kona Jeconiah toh kilhona sohchang dinga Babylon lengpa Nebuchadnezzar'in anapoh mangho lah-a chu jao ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule aman apangah chanu Hadassah, hichu Esther ahin, ahin khoukhah-in ahi: ajehchu amanu nulepa neilou ahin, chule nungahnu chu vetnom umle melhoitah ahi; Mordecai'in anu le apa thi nunga ama chanu dinga akilah ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahung hitin ahi, lengpa thupeh le thuphondoh chu jah ahi-a, Shushan leng inpi-a nungah tampi Hagai vetsuina noija khopkhom ahi phatnin, Esther jong chu lengpa in'a numei ho vesuipa Hagai vetsui ding chun ahinpui taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche nungahnu chun amapa chu alunglhaisah lheh-in, amapa hepina achangtan ahi; hijeh chun amapan akisuh thengna dinga thil ngaikhoh ho, achan dinga thil kigotpeh ho, chule leng inpia kona amanu jenleding nungah sagi kipeho chu amanu apeloi jengin: chule aman amanu le ajenleding numei ho chu numei ho in'a mun phalai pena chun akoitan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Esther'in vang amitele a-inkoho aseidohpon ahi: ajehchu Mordecai'in amanu henga seidoh hih-in tia aseipeh masah ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nisehle Mordecai chu numei ho umna in hong maija chun Esther iti uma, achungchanga ipi hungsoh doh dingham ti hetnadin avahle jingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun numei ho umdan dungjuija lhasomle lhani alhin jou chun, nungah ho chu leng Ahasuerus anga akilutlhah lhahdiu nikho ahung lhungtan ahi, (ajeh chu akisuhtheng nao nikho lhinga ahitan, lhagup myrrh thao kinu uva, lhagupma gimnamtui le numei ho kisuhthengna thildangho kinu uva ahi).
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun nungah ho jouse chu lengpa anga ahunguvin; chule numei khatcheh chu numei ho umna in'a kona lengpa in'a ache tengle adeichan chu akipe jin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nilhahle lutji-a, ajingle numei umna in nina, thaikem ho vetuppa lengpa nukisopa Shaashgaz vetsuina-a umdingin akile kitjin ahi. Amanu chu achunga lengpan lunglhaina aneija, amina akou tilouva lengpa henga avela lutkit talou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun achanu dinga hinkivahdoh, Mordecai pangah Abigail chanu Esther, lengpa henga alutna ding phat ahunglhun phatnin, numei ho vetuppa lengpa nukisopa Hagai'in agot teho tailou amanun imacha dang angaichapoi. Chule Esther chu ama hinvaho jouse mitmun lungsetna achangin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun alengchan kum sagi chana, lhasom channa, Tebeth lha-a chun lengpa Ahasuerus leng inpi sunga Esther chu ahin puilut taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin lengpan numei dangho jouse sangin Esther angailu penin, nungah theng dangho jouse sangin amitmun lungsetna le khotona achangtan ahi; hijeh chun aman amanu chu lallukhuh akhuh peh-in, Vashti khelin lengnun apansah tai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin lengpan pipuiho jousele asohte din golvah loupitah, Esther golvah ngei chu abolin; gamkaiho-a choldona aphongdoh-in, lengpa gamkai dungjuijin thilpehho apen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule aniveina-a nungahthengho chu akikhopkhom phatnun, Mordecai chu lengpa kotpi bulla atouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche geichun Esther'in Mordecai'in ahilna bangin, aphungle amite chu aseidohpon ahi. Ajehchu aman ahin vahlai bangbanga Esther'in Mordecai thupeh angai ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche nikholai, Mordecai chu lengpa kotpi bula atouji laichun, lengpa kotngah ho lah-a nukiso mini Bigthan le Teresh chu alunghang lhontan, leng Ahasuerus chunga khut lhah ding ago lhontan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin thil umdan chu Mordecai'in ahetan, aman lengnu Esther ahilin; chule Esther'in Mordecai minin lengpa henga ahetchen sahtan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin hiche thu chu akikholtoh phatnin, atahbeh ahi akihechentan, hijeh chun anilhonin thinga akhailih taovin ahi. Chuin hichu thusimbua lengpa masanga akisunlut tan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheng jouhin Ahasuerus lengpan Agag mi Hammedatha chapa Haman chu apanmun akalsah in, amasotsah in, chule apipui chankhompi jouse chungvuma touna adopehtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Lengpa kotpi phunga um asohte jouse akunun, Haman chu jana apeovin ahi: ajehchu lengpan ama thudola hitia chu thu apeh ahi. Ahin Mordecai vang kun jong akunpon, jana jong apepoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpa kotpi phunga um soh ho chun Mordecai henga, ibola leng thupeh nasuhkhel ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tun ahitin ahi, amahon ajah-a niseh-a asei seijuva, aman angaipeh lou phatnun, amahon Mordecai thu ache achelou hetnadin, Haman ahiltaove: ajehchu aman amaho henga Judah mi kahi tin aseijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Haman'in Mordecai chu kunjong akunlouva, chule jana jong apehlou chu amudoh phatnin, Haman chu lunghan na-in adimtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman Mordecai chungseh seh-a khut lhading chu imalouvin ageltan ahi; ajehchu amahon Mordecai jat mite chu ama ahetsah-u ahitai. Hiche jehchun Haman'in Ahasuerus gamsung pumpi-a Mordecai mite, Judah ho jouse chu suhmanghel ding agotan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahasuerus lengchan kal kum somle kumni lhinna-a, lha masapen, hichu Nisan lha ahin, amahon Haman angsunga pur kiti vangvetna khat, ani anin, chule alha alhan, lhasomle lhani channa, Adar lha geichun, asang asang jengun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Haman'in lengpa Ahasuerus henga, Nalenggam sung gamkai jouse mipi ho lah-a hin namkhat kithecheh-a le vahcheh-a aumun; chule adan uchu mijouse-a toh akitohpon; chule lengpa dan jong anit pouvin ahi. Hijeh chun amaho nomlhat sah ding chu lengpa dinga phatchomna bei ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lengpa lunglam ahile, amaho chu suhmang ding ahi tin kisunhen: chule keiman chuche tong dinga nganseho khutna chun, lengpa goukhol na-a din dangka talent sangsom penge, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin lengpan akhutna konin akhutjem aladoh-in, Judah te melmapa, Agag mi Hammedatha chapa Haman chu apetan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin lengpan Haman henga, dangka le miho chu naphatsah sah-a nabol dinga kipehdoh nahitai ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin lha masapen nisomle nithum lhin nin, lengpa lekhasunho chu akikou khomin, Haman thupeh dungjuijin, lengpa gal lamkaiho heng, gamkai jouse-a vaipoho heng, chule gamkai tina mipi chunga vaihomho henga alekha jem-u dungjui cheh le apaovu dungjui cheh-in Ahasuerus lengpa minin thupeh khat asunun, lengpa khutjem chu anam khumun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule lha somle lhani na, hichu Adar lha ahin, ni somle nithum ni lhin nikho leh, nikhat sunga, Juda te jouse khangdong le tehse, chapang le numei ho abonuva suhmang ding, thading, suhgamhel ding, chule anei agou jouseu chomgamhel dingin, lekhathot ho chu lengpa gamkai jouse-a lekhapole ho-a konin akithot tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuche nikho-a dinga akigot chehna dinguva, hiche lekha chu mijouse-a dinga kisun ahito lhonin, hichu sutsona gamkai jouse-a dan banga mijouse henga phondoh dinga thupeh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lengpa dinga athupeh dungjuijin lekhaho chu gangtah-in akihomdoh tan; chule thuphondoh chu leng inpi Shushan'a phondoh-in aumtai. Chuin lengpa le Haman chu judon dingin atoulhonin, ahinla Shushan khopi sung chu alungdong gamtaove.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mordecai'in thil kibol jouse amudoh phatnin, Mordecai'in apon jouse abotkeh-in, khaodip pon akiselin vut akinun, khopi sung laitah-a ahungdoh-in, hatah le lungna tah-in akapmin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule lengpa kotpi chan geijin ahunge: ajehchu khaodip pon kisila chu koimacha lengpa kotpi-a luttheilou ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule gamkai jouse-a, lengpa thupeh le thuphondoh lhunna chana chun, Judah teho lah-a lunghemna nasatah toh, anngolna, kana le penna aumin: chule mitam tah-in khaodip pon akisilun vut lah-a alumun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hitichun Esther soh numei ho le anukiso ho chu ahungun hichu ahunghil taovin ahi. Chuphatnin lengnu alungkham behseh jengtan, akhaodip pon chu aholhah-a akivon dingin Mordecai chu pon agah thotnin; ahinla aman hichu akisanpon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin Esther'in, ama vetup dinga kipansah, lengpa nukiso ho lah-a Hatach chu akouvin, Mordecai chungchanga ipi iti hija, chule ipidinga chuti umham? ti gahetoh din thupeh apen ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun Hatach chu lengpa kotpi maija khopi lamlena Mordecai henga chun achedoh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mordecai'in achunga thusoh jouse, chule Judah te suhmangna dinga Haman'in lengpa goukhol na-a sum pedinga akitepnaho chu ahilin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman Esther avetsah-a, ahenga ahilchetna, chule amanu lengpa angsunga galut dinga thu apeh-a, amanu ahenga agataova, chule amite dinga ngehna aganei theina dingin, amaho suhmang nadinga Shushan'a kona thutanlhah kithotdoh lekhat khat jong apen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Hatach chu ahungin, Mordecai thusei jouse chu Esther ahiltan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Esther'in Hatach henga aseikitnin, chule Mordecai henga hitia agasei dingin thupeh apen ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lengpa sohte jousele lengpa gamkai sunga um jousen, koi hijongle, numei hihen pasal hijongle, aman akou louva lengpa hongsung sungnunga hunglut ho chu, aman dan khatseh aneijin, amachu kithat ding, amavang lengpan sana tenggol ama lama adop khumho bou chu hingding ahi, ti ahesoh keijun ahi. Ahinla nisomthum sunghin lengpa henga lut dingin keima eikikou tapoi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon Esther thu chu Mordecai aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mordecai'in Esther hitia adonbut diuvin athupeh-in ahi, Judah te jouse sangin leng inpi sunga hoidoh nange tin kigel hih-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu nangma tuphatna hi nathipbeh-a ahile, mun danga kona Judah te letdohna le hoidohna um teiding ahin, nangmale napa insung vang namanthah diu ahi. Hitobang phatna dinga hi lenggam sunga nahungpan ahi kon ahetnem? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Esther'in hiche donbutna hi Mordecai hetsahdin amaho chu asolin:
  </para>
  <para style="p">
    <verse number="16" style="v" />Cheovin, Shushan'a um Judah te jouse kichomkhomu vinlang, keidingin an ngolun, chule nithum sung sunle jan-in nelou donlouvin umun: keimale kasoh numei hon jong hitobanga chu an kangol diu; chule dan hihih jongle lengpa koma kagalut ding ahi: kamanthahle mangthah tange, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitichun Mordecai chu achedoh-in, Esther'in athupeh jouse chu aboltan ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun anithum channin ahitin ahi, Esther'in alengpon akivonin, lengpa in jon tah-a lengpa hongsung sungnunga chun adingtan: chule lengpa chu in kotpi jontah, leng in sunga alaltouna-a chun atouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, lengpan Esther lengnu chu thutana hongsunga adin amu phatnin, lengpa mitmun amanu chu lungsetna achangtan; chuin lengpan akhutna um sana tenggol chun Esther chu ahin japmin ahi. Hitichun Esther ahung naijin, chule tenggol muh chu athamin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpan amanu jah-a, lengnu Esther, ipiham nadei? chule ipiham nathum? Lenggam akehkhat geija jong kipeding nahi, atitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Esther'in adonbutnin, lengpan pha asah-a ahile, tunia keiman ama dinga kagonpeh anneh khomna-a hin lengpa le Haman hunglhon le kati, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lengpan, Esther seibang aboltheidin, Haman chu hinpui loijun, ati. Hitichun Esther'in agon nehkhom na-a chun lengpa le Haman chu ahungtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin lengpan judon khomna-a chun Esther henga, ipiham nathum? nakibolpeh ding nahi, chule na-ngeh chu ipi ham? lenggam kehkhat hijengjongle kibulhitpeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Esther hin adonbutnin, kathum le kangeh chu:
  </para>
  <para style="p">
    <verse number="8" style="v" />Lengpa mitmu-a lungsetna kachana, kathilthum hi lengpan phalpeh dinga pha nasah-a, Kathil ngeh bulhitpeh dinga pha nasahle, lengpa le Haman kagonpeh ding nehkhom na-a hunglhonin lang, lengpa seibangin jingle bolnange, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun Haman chu hicheni chun lunglhaisel le thanom tah-in apotdohtai. Ahinla Haman'in lengpa kotpi phunga Mordecai ama jana-a adindohlou le achalohlou chu amuphatnin, Mordecai chunga alunghang lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahijengvangin, Haman akitimham hamin: in ahunglhun phatnin agolho le ajinu Zeresh koudin asolin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Haman'in amaho henga ahaona loupije, achate tamdan, lengpan adopsangna thilho jouse, chule lengpa pipuiho le asohte chungvuma amasotsah dan chu aseijin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chukalvalin Haman'in aseibe kitnin, Henge, Esther lengnun nehkhom na agonna-a chun lengpa le kei tailou koimacha alutsahpoi; chule jingle avelin lengpa toh eikou kit lhonin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla lengpa kotpi phunga tou Judah mi Mordecai kamu laisen, hicheho jousehin ima eiphatchom sahpoi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ajinu Zeresh le agolho jousen ajah-a, tong somnga sang thingpel kisem hen, chule achunga chu Mordecai akikhai theinadin nangman lengpa henga jingle hinseijin: chuteng lengpa to thanom tah-in nehkhom na-a chun chen, atiuve. Chuin Haman'in hichu pha asan, thingpel chu asemsahtai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jan chun lengpa a-imuthei hihbeh-in, chule thusoh ho kisutlutna thusimbu chu ahinchoi diuvin thupeh apen, chule hicheho chu lengpa angah asimun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Bigthana le Teresh lengpa kotngah-a pang nukiso tenin, Ahasuerus lengpa chunga khut lhahdia agotlhon, Mordecai'in ana seidohpeh thu kisun chu amudoh-un ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpan aseijin, hiche jeh-a hi ipi janale choi-atna Mordecai kibolpeh am? ati. Chuin ajenlea pang lengpa sohten, ima akibol pehpoi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lengpan, hong sunga koi umam? ati. Tun Haman chu lengpa aman asem thingpel chunga Mordecai khaiding thusei dingin, indan ponunga chun ahunglutnin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lengpa sohten ajah-a, vetan, hong sunga Haman adinge, atiuve. Chuin lengpan, hinlutsah un, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun Haman ahunglut tai. Chuin lengpan ajah-a, lengpan ajabol nompa henga ipi kibolpeh le phantem? ati. Tun Haman'in alungsunga, lengpan keisanga ajabolnom koi umding ham? tin agelin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Haman in lengpa chu adonbutnin, lengpan ajabol nom mipa ding chun,
  </para>
  <para style="p">
    <verse number="8" style="v" />Lengpan akivon lengvon, lengpa tounaji sakol, chule lengpa kikhuhji lallukhuh chu hin kilahsah hen:
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule lengpan ajabol dingpa chu ajep theina dingin, hiche von le sakol chu lengpa pipu lulpen ho lah-a khat khutna kipehen: chule amachun khopi lamlena sakol chunga chun ama chu puile henlang, amasanga chun: lengpan ajabol nom mi chu hiti ahi kibol ding ahi, tin samphongle hen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin lengpan Haman jah-a, kino-in, nasei bang chun von le sakol chu galan, chule lengpa kotpi phunga tou Juda mipa Mordecai henga khun gabolin: naseiho chu khatcha akipel umlou ding ahi, atitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun Haman'in von le sakol chu alan, Mordecai chu avonpeh-in, sakol chunga khopi sung lamlena ahinpuijin, amasanga chun, lengpan ajabol nom mi chu hitia hi kibol ding ahi, tin asampeh-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mordecai chu lengpa kotpi phunga ahungkit tan ahi. Haman vang chun ponlu akikhun, lunghem tah-in a-in lama acheloitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Haman'in ajinu Zeresh le agolho jouse henga achunga thilsoh jouse chu aseitai. Hichun amiching hole ajinu Zeresh'in ahengah, ama masanga nalhuhpatna Mordecai chu Judah te son ahile, nangman ama najo louhel ding, amavang thonlouva a-anga nalhuhtei ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho amatoh akihoulim nalai uvin, lengpa nukiso ho khat ahungin, Esther lengnun asem nehkhom na-a dingin Haman chu mangang tah-in ahung puitan ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun lengpa le Haman chu Esther lengnun agon nehkhom na-a chun ahung lhontan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule anini channi jong chun lengpan don khomna-a chun Esther chu adongin, Esther lengnu, nathum chu ipiham? nangma kinop peh ding nahi, chule na-ngeh chu ipiham? lenggam kehkhat pehding hijengjongle, kibolpeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengnu Esther'in adonbutnin, Vo lengpa namit mu-a lungsetna kachana, lengpa lung ahile, kathumna-a hin kahinkho hi eikipe henglang, kangehna-a hin kamite hinkho kipehen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu keiho, keimale kamitehi, suhmang ding, tha dingle, suhgamhel dinga eikijoh doh-u ahitai. Ahinla keihohi sohpa le sohnu dinga eikijohdoh maimaiju hilevang, melmapan lengpa thil suhmang ditdoh jouding hihih jongle, ima seilouva kaum jengding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Ahasuerus lengpan Esther lengnu adonbutnin, ajah-a, alungsunga jong chutobang gahgel ngama chu koihija, hoija uma ham? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Esther'in, doubol le melma chu hiche mi-engsepa Haman hi ahi ati. Chuin Haman chu lengpa le lengnu anga chun akichatan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin lengpa ju donkhom na-a kon chun lunghang tah-in adingdoh in, leng inpi honsung lama achetai. Chuin Haman chu adingdoh-in ahinkho kihuhna dingin Esther lengnu henga ataotai; ajehchu lengpan achunga setna angaito chu ahet ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin lengpa chu hona konin donkhomna mun'a akile kitnin, chule Haman chu Esther umna jalkhun chunga chun analhun ahi. Hichun lengpan, kamasang tah-a jong aman hiche insunga hi lengnu suhset ding agot ham? ati. Chutia lengpa thusei petchun, Haman chu amai atompeh taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin nukiso ho lah-a khat Harbonah chun, lengpa anga, Vetan, lengpa dinga thupha seipa Mordecai khailihna dinga Haman'in tong somnga sanga asem thingpel chu Haman in'a akitunge, ati. Chuin lengpan, hiche chunga chun ama khailih-un, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun amahon Haman chu Mordecai kikhaina dinga asem thingpel chunga chun akhai taove. Chujouvin lengpa chu alungdamtai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche ni chun Ahasuerus lengpan Judah te melmapa Haman in chu Esther lengnu apetan ahi. Chuin Mordecai lengpa masanga ahungin ahi; ajehchu Esther'in ama chu ama dinga a ipi ahi aseipeh ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin lengpa chun Haman'a kona alah akhutjem chu aladoh-in, Mordecai chu apetan ahi. Chule Esther'in Mordecai chu Haman insung vaipon apansahtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Esther'in lengpa anga thu aseikitnin, akengbula alhun, mitlhi pumin Agag mi Haman'in Judah te douna-a thilphalou agon chu alahdoh din angeh-e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lengpan sana tenggol chu Esther lama adomdoh-in ahi. Hitichun Esther athoudoh-in, lengpa anga adingin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitin aseije, Lengpan pha asah-a, amitmua lungsetna kachana, chule hiche thil hi lengpa anga adih-a akilah-a, amitmua alunglhaina kahile, lengpa gamkai jouse sunga um Judah te suhmangna dinga Agag mi Hammedatha chapa Haman'in anabol lekhaho chu akheldohna ding kisun hen:
  </para>
  <para style="p">
    <verse number="6" style="v" />Kanam mite chunga hunglhung ding setna chu ken iti kamu-a kadoujou dingham? Ahiloule kasopiho kisuh mangna ding chu iti kamua kadoujou dingham? ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Ahasuerus lengpan Esther lengnu le Judah mi Mordecai hengah, veuvin, Judah te chunga akhut alhah jeh-a thingpel'a akhailih-u Haman in chu, keiman Esther kapeh ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon nadeilam tah-un lengpa minin Judah te dingin jong lekha sunun, chule lengpa khutjema chun sinkhana nam khumun: ajehchu lengpa mina kisuna, chule lengpa khutjema sinkhana kinamkhum chu koimachan akhelthei louhel ahitai, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin chuche phatlai lha thumna, hichu sivan lha ahin, nisomni le nithum nin lengpa lekhasunho chu koukhom in aumun; abonchan Mordecai'in athupeh dungjuijin, India'a pat Ethiopia gei, agoma gamkai jale somni le sagi-a um Judah te heng, gal lamkaiho heng, gamvaipoho le pipuiho henga thotdin lekha asunun; gamkai jouse chu amaho lekhajem'in, mijouse chu apao cheh-in, chule Judah te dingin jong alekhajem dungjuile apao dungjuijun athot uvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman Ahasuerus lengpa minin asunin, lengpa khutjemin sinkhana anamkhumin, lekha chu lekha pole-a pang sakol chung, sangan chunga touho, sangongsang, chule sangongsang khangdongho apohsah-un ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hia chun lengpan khopi tina cheng Judah te jouse chu ahinkhou kihuhna dinga akikhop khomuva, amaho hindel khum ding thahatna jouse mihem le gamkai chu naosen le numei geija asumanguva, atha uva, asuhgamhel uva, chule anei agouhou chu galthil choma akichom diuvin aphalpeh-in,
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichu nikhat sung, lha somle lhani na, hichu Adar lha ahin, nisomle nithum nileh, Ahasuerus lengpa gamkai jouse-a tohdoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gamkai tina mijouse pehdinga thuphondoh kisunson chu, Juda te chu hiche nikho-a amelmateu chunga phula dinga kigosa dema aumna dinguvin, mijouse henga akihom jaltan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun kino dingle kikinsah dinga lengpa thupeh ahi jehchun, sangan le sangongsang chunga tou lekhahomho chu akipatdoh taove. Chule thuphondoh chu leng inpi Shushan'a kihomdoh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mordecai chu lengpa angsunga konin lengvon adum le akang, sana lallukhuh loupitah, tupat ponnem le ponsandup kivon pumin apotdoh-in: chuin Shushan khopi chu akipah-un chule athanomlheh jengun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Judah te chun vah, kipana, thanopna, chule jana aneitauvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin gamkaitin le khopitin, lengpa thupeh le thuphondoh lhunna channa chun Judah ten kipana le thanopna aneijun, golvah abolun chule akichol douvin ahi. Chuin gamsunga mitamtah chunga chu Judah te ginna achuh jeh-in, Juda mi asohgam taove.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun lhasom le lhani lhina, hichu Adar lha ahin, chuche lha nisomle nithum ni, lengpa thupeh le thuphondoh chu tohlhah-a aumding nikho, Juda mite chunga amelma teovin thaneina anei diuva akinepnao nikho chu ahung nai phatnin, (amaho ana hotbol ho chunga Judah te joh-in vai ahomna diuva thu chu akaleh-a heija aum vang chun)
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah te chu Ahasuerus lengpa gamkai sung jouse-a chun khopi jouse-a, achunguva thilse boldingho chunga khut lhadin akikhomun ahi: Chule koiman amaho atingjou pouve; ajehchu amaho kichatna chu mijouse chunga chua ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule gamkaija vaipoho jouse, gal lamkaiho, chule lengpa vaipoho chun Judah te akithopiuve; ajehchu achunguva Mordecai ginna achutan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Mordecai chu leng insunga alen lhehtan, chule aminthanna chu gamkai jouse-a akithang sohtan ahi; ajehchu hichepa Mordecai hi akhangtou tultul jengin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Judah ten amelmateu jouse chu chemjamin abansat gamun, athatnun, asumangun, chule ahotbolteu chunga boldinga lomtah chu abol taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Shushan inpia Judah ten mi janga athatnun asumangun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Parshandatha, Dalphon, chule Aspatha,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Poratham, Adalia, chule Aridatha,
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Parmashta, Arisai, Aridai chule Vaizatha.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hammedatha chapa Haman chapa som, Judah te melmaho chu amahon athatnun; ahinla galthil chu ima alapouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichenia Shushan leng inpia kithatho chu amijat lengpa angsunga ahinpolut nun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin lengpan lengnu Esther jah-a, Judah ten Shushan inpia mi janga athatnun, asumanguvin, chule Haman chapate misom jong chu athat taove: lengpa gamkai dang jouse-a ipi aboluvem? Tun ipiham nathum? Hichu kibolpeh ding nahi. Ahiloule ipiham nangehbe? Hichu kibolding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Esther'in, lengpa lunglam ahile, Shushan'a um Juda te chu tunikho-a dinga thuphondoh kibol banga, jing nikho jongle abol diuvin phalna kipehen, chule Haman chapate somho hi thingpel'a kikhai hen, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin lengpan chutia bolding chun thupeh apetan ahi. Chule thupeh apeh chu Shushan'a akipen; chule amahon Haman chapate som chu thingpel'a akhailih taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu Shushan'a um Judah te chu Adar lha, ni somleli nin akikhom khomun, Shushan'a mi jathum athat uvin; hinlah athilhou vang imacha alapouvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Juda mi adang dangho lengpa gamkai sunga umho chu akikhomun, ahinnao huhna-in apanguvin, amelmateuva konin akicholdo uvin, agalteu chu sangsomsagi le sangnga athatnun ahi; hinla anei agouhou chunga akhut alha pouve;
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche hi Adar lha ni som le nithum ni ahi. Chuin hiche lha mama nisomle nili channin amaho akicholdo uvin, hiche nikho chu golvah le kipa nikhon amanguvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla Shushan'a um Judah te chu chuche lha ni somle nithum ni, chuleh nisomle nili nin akikhomun; chule hiche lha mama nisomle ninga channin akicholdo uvin, hiche nikho chu golvah le kipa nikhon amanguvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh-a chu kulpi kikai khum lou khoneo ho-a Judah te chun, Adar lha nisomle nili ni chu kipa le golvah nikhon amangun, chule choldoni akilhaovin, khat lekhat thilpeh kipehto nikhon amanguvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Mordecai jin hichehohi asunin, Ahasuerus lengpa gamkaiho jouse-a um Judah te, naija le gamlha-a umho jouse henga lekha athotnin,
  </para>
  <para style="p">
    <verse number="21" style="v" />Adar lha nisomle nili le nisomle ninga ni hi kum seh-a anitdiuva alah uva phudoh-a,
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche nikho-a chu Juda te amelmateova kona acholdonao nikhou, chule chuche lha chu amaho dinga lunggim na-a kon kipana aso-a, chule lunghemna-a kona choldo nikho sodohna lha ahin: hitia chu amahon hiche nikho teni chu golvah le kipa nikho, khatle khat thilpeh kipehto nikho, chule gentheiho thilpeh peh nikho-a amandiuvin athotnin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Judah te chun amahon ana bolpatsao bangle, ahenguva Mordecai hinsut banga chu bol dingin asang taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu Agag mi Hammedatha chapa Haman, Judah te melmapa chun Judah te douna-a amaho suhmang ding anagotna, chule Pur anasana, hichu vangvetna ahin, amaho chu thagama, suhgam ding anagot ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla, Esther chu lengpa anga ahung phatnin, lengpan lekha-a thupeh apen, amapa lung ngaito phalou, Judah te douna-a abol hochu ahungkinung le-a, abona ama luchunga achuh-a, chule amale achapate chu thingpel'a khailih ahina dingin nathupeh tan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche jeh-a chu hiche nikhohi Pur mina konin Purim asah-u ahi. Hijeh chun hiche lekhathotna thucheng jousele, chuche chungchanga athilmu hou jouse, chule amaho chunga hunglhungho jeh chun,
  </para>
  <para style="p">
    <verse number="27" style="v" />Judah ten amaho chung le, asohteu chung, chule amaho jop chan chunga din, akisun dungjuija thonlou hela akitep dungjuija kumseh le hiche nikho ni hi anit dingun asudetnun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule hiche nikho teni hi geldoh jinga uma, insung tina, gamkai tina, chule khopi tina akhang akhanga kinit jingding ahi. Chule hiche Purim nikho teni hi Judah te lah-a kona kilamang louding, chule hicheho hetjingna jonghi achilhah teova kona mangthah louding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chujouvin Abihail chanu lengnu Esther le Juda mi Mordecai'in thaneina jouseto thon, Purim suhdetna dingin lekhathot aniveina asun lhonin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman lekhathot ho chu, Ahasuerus lenggama gamkai jakhatle somni le sagi-a cheng Judah te jouse henga, lungmona thu le thutah thu toh athot than,
  </para>
  <para style="p">
    <verse number="31" style="v" />Judah mi Mordecai le Esther lengnun ajui diuva aphatsah lhon dungjuile, a-an ngolu le akanao thudola amaho tah dingle achateu dinga thuphondoh anabol banguva, phat kitep dungjuija hiche Purim nikho hi suhdetna aumna dinga athot ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Esther thuphondoh chun Purim thudol chu asudet tan; chuleh hichu lekhabua akisunlut tai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin lengpa Ahasuerus'in leiset chungle twikol gamho chunga kai alatan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin athaneina le athilbol theina-a anatoh jouse, chule Mordecai loupina kiphondoh, lengpan amasot dan, Media le Persia lengte thusimbua kisunlut hilouham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Juda mi Mordecai chu leng Ahasuerus ban tah-a ahin, chule Judah te lah-a loupitah, asopi tamtah lunglhaina, amite phatna ding hol, chule achilhahte jouse henga lungmona thu aseijing ahi.
  </para>
</usx>
