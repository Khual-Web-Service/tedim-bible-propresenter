<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ZEP" style="id">Zephaniah</book>
  <para style="h">Zephaniah</para>
  <para style="toc1">Zephaniah</para>
  <para style="toc2">Zephaniah</para>
  <para style="mt">Zephaniah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengpa, Amon chapa Josiah nikho laija Hizekiah chapa, Amariah chapa, Gedaliah chapa, Kushi chapa Zephaniah henga Pakai thu hunglhung chu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leiset na kon thil jouse kasuhmang ding ahi tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem le gamsaho kasuhmanga; chungleng vachaho, twipia nga ho, chule kipal lhuhna chu migiloute toh kasuhmang ding; chule leisetna kona mihem kasuhgam ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman Judah chung le Jerusalem'a chengho jouse chunga kakhut kajahdoh ding; chule hiche mun'a kona hi Baal hou amoh chengsele, Chemarim ho min chu thempuho puma kapaidoh ding;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule in chung vum ho-a van janel ho chibai bohho; Pakai houva amin panna kihahsel ho, chule Malcham min pana kihahsel ho;
  </para>
  <para style="p">
    <verse number="6" style="v" />chule Pakaiya kona kinung heiho; chule Pakai hollouho le ama dong louho chu kapaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai Pathen anga chun thip chetnin umun, ajehchu Pakai nikho chu anaitai. Ajehchu Pakaiyin ganlhaina agongin, ajinho chu akoutai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Pakai ganlhaina nikhole hung hiti ding ahi, keiman pipuiho le lengpa chateho, chule gamchom miho vona kivonho jouse chu talen kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche ni mama chule chang phola kichom ho, apupao in pumhat le lheplhah na-a dipho chu talen kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hiche nikho chule hunghiti ding ahi, tin Pakaiyin aseije, nga kotpi-a kona ka awgin, kotpi nichana-a kona ka awgin, chule lhang ho-a kona thil kisukeh gin nasatah kijading ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Maktesh'a chenga nangho penguvin, ajehchu kivei miho jouse akisugamin; chule dangka choiho jouse akisugam tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuche phat chule hung hiti ding ahi, keiman Jerusalem chu thaomei mangcha-a kahol ding, juheh-a hingho, alunguva Pakai chun thilpha jong thilse jong bolponte tia seiho chu talen kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun athil hou chu thil kichomdoh soh intin, a-inhou chu kamhel ding: amahon in jong saovintin, alolou dingu, chule amahon lengpilei ho boluntin, hia kona chu lengpitwi adonlou diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai niloupi tah chu ahung naijin, ahung naijin, akikino lheh-in, chule Pakai nikho husa gin jengjong chu akinolheh-e; chuche nikho chule mihatpa jong chu haka-a kapding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuche nikho chu lungsat nikho, lungkham nikho le lung hesoh nikho, manthah na le kisuh kamhelna nikho, muthim le genthei nikho, chule meibol le muthim lhangkhal kiheh nikho ahin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule kulpi kikai khum khopi hole, insangho douna-a, sumkon kimut nikho le gal kisap phongna nikho ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule keiman mihemte chunga hesohna kapohlut ding, amahon Pakai douna-a achonset jeh uva, mitcho banga lam ajotdiu: chule athisanu chu leivui banga kisunglha-a, atahsao chu eh banga kisunglha ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai lunghan nikho lechun asana hou le adangka houvin alhatdoh theilou diu; amavang agam pumpi chu athang thipna meikongin ahalvam ding ahi. Ajehchu aman chuche gama cheng jouse gangtah-a asuhmang ding ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho kikhom khomun, henge, nangho kikhom khomun, vo dei umlou nampi mite;
  </para>
  <para style="p">
    <verse number="2" style="v" />Thupeh ahung kipohdoh masang, nikho chu changsi banga alen mang masang, Pakai lunghanna nasatah nachung uva ahunglhun masangin, nachung uva Pakai lunghanna nikho ahunglhun masangin, kikhom khomun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho leisetna mikineosah jousen, athutan dihna domsanga Pakai chu hollun; chonphatna holun, kineosahna hollun: chuti henlang hile Pakai lunghan nikho le sella naumthei dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Gaza chu dalhah-a uma, Ashkelon kamhel ding: amahon sunchang laija Ashdod anodoh diu, chule Ekron chu bodoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Twikhanglen panga cheng Chereth nam miteho, ohe ada nahiuve ahi! Pakai thun nangho nadouvun ahi; Vo Canaan, Philistine te gam, koimacha achenga aumlouna dinga, keiman nangma jengjong kasuhmang ding nahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Twikhanglen pang chu kelngoi chingho dinga chenna inle, kelngoi honho dinga hong hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Luipang chu Judah insung amohho ding ahin; chua chu amahon akelngoi honhou avahdiu: amaho Ashkelon inho-a chu nilhahle lumjidiu ahi. Ajehchu Pakai a-Pathen uvin aviluva asohchan nao aheimang ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman kamite i-sah louva abolnao, Moab mite i-sah louna leh, Ammon mite housetna kajan, chule agamgiu douna-in akichoisangun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun Israel janel Pakaiyin hitin aseije, keima kahin jing bangin, thonlouva Moab chu Sodom bang ding, Ammon chate chu Gomorrah bangdiu, ling nangbohle chi khuhlah hiuva, a-itih-a kamhela umdiu ahi. Kamite kim khat hon amaho chu achomuva, kami amoh chengsen amaho chu alodingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichehohi ahoitho jeh uva aneidiu ahi, ajehchu amaho janel Pakai mite dounale i-sah louna-in akichoi sangun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai chu amaho dinga tijat umtah hiding ahi: ajehchu Aman leiset pathen jouse asuhmanga, chule mihem ten ama ahou dingu, mitinin ama mun cheh-a konle twikol gam ho-a milim houho sanin ahoudiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangho Ethiopia mite jong, kachemjama kithat ding nahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman sahlam douna-a akhut alhana, Assyria asuhmang ding, chule Nineveh mite chu, gamthip gamgo banga akamhel sah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amanu lailunga chu kelngoi honle namtina kon gamsa jouse kol dingu ahi. Twikhanglen vacha hole twivamuhsao ho a-inkam chunga chenguntin; bangkot ho-a a-aw uvin la asahding; kotsangkil jong chu agohkeo hiding ahi; ajehchu aman Cedar thinga kisa jouse ahodoh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichehi alung sunga, keibou kahi, koima dang aumpoi, tia sei khohsahna neilou tah-a cheng kipahjing khopi ahi: iti dana ama ahomkeova hung uma, ganhingho kolnabep hungsoh-a ahitadem! ajotpa jousen ahuisat khumuva, akhut ajapkhum dingu ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi sugenthei khopi, athengloule akisuboh nu chu ohe ada ahi!
  </para>
  <para style="p">
    <verse number="2" style="v" />Amanun aw chu angaipon; suhdihna chu asangpon; Pakai chu atahsanpon; a-Pathen chu anaipon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amanu sunga um pipuiho chu keipi bahkai kitum tobang ahiuvin; athutanhou chu nilhah ngeiho jingkah geijin saguho nehmoh koilou tobang ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amanu themgaoho chu imacha hiloule tahsan umlou mi jeng ahiuvin; Athempuho chun muntheng asuhboh-un, amahon danthupeh chunga pumhat abolun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chondih Pakai chu alah uva aumin; aman khangitlouna abol louding ahi. Jingkah sehle athutana vah-a apodoh jin, ahinla midih lou chun jumlam ahepon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman namtinho kasugamin, a-insanghou akamhel tai: akhosung lamlenhou agoh-in kakoijin, koimachan ahotapoi, akhopihou kasumangin, koimacha aumtapon, acheng jong aumtapoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman, Tahbeh-in nangman neiging teijin natin, nangman hilna sangin nate; chutichun itobangin amaho talen pejongleng, achennao kisumang ponte, kati ahin; ahinla amaho jingpin athouvun, anatoh jouseu asuboh-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun achom gam dinga kahungkondoh nikho kahsen neingah-un, tin Pakaiyin aseije; ajehchu namtinho gop khoma, leng gamho khopkhom ding, chuleh kalung hanna le kalung satna jouse geija achunguva sunlhah dinghi kalung got ahi; ajehchu leiset pumpihi kathang thipna meija kahal vam ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu amahon Pakai min chu akouvuva, lung khat tah-a ama ajentheina diuvin, mipi ho chu paotheng ka pehding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ethiopia vadung ho gallama kona kahenga tao hole, anavah chehsa kachanu ngeijin jong, kahenga thilto ahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche nikho chuleh keima douna nasuhkhelna, nathilbol jouse jeh-a najachat louding ahi: ajehchu chuteng chule keiman nakiletsah na-a kipahho chu nalah uva kona kalahdoh ding, chule kamolsang theng jeh-a chu nangma nakihoitho sahkit louding ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman nalah uva migenthei le mivaichaho jong kadalhah ding, amahon Pakai minchu atahsan dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel amohho chun khangitlou abol loudiu, jou aseilou diu, akamuva kona lheplhah kimulou ding ahi: Ajehchu amahon akelngoi hou avah uva lum diu ahin, chule koimachan akichat sah loudiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo Zion chanu, La san; Vo Israel, kho hasapmin samin; Vo Jerusalem chanu, nalungthim pumpin kipah inlang thanomin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai chun nachung thu kitana ding chu aladohtan, namelmate anodoh tai: Israelte lengpa Pathen tahchu nalah uva aume; nangman thilse namukit louding ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheni chule Jerusalem henga, Kicha hih-in, tia kisei ding; chule Zion henga, nakhut ngoisah hih-in, kiti ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nalah-a um Pakai na-Pathen chu tha neitah ahin; aman ahuhhinga, nachunga kipah tah-a thanom ding; aman angailutna-a nacholdohsah intin, aman nachunga la asah-a kipah ding ahi
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman nalah-a um, i-sah louva akibolna chu ama dinga pohgih hia, kikhopna loupitah-a dinga lunghemho chu, kakhop khom ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Veovin, chuche phatteng chule nasugenthei ho jouse chu kalahdoh ding; elbai chu kahuh hinga, akidel mangho kachopkhom ding; jahcha tah-a akikoinao gamtina amaho vahchoina le minthana kamusah ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keiman kachopkhom phat tengu chule, nanho kalepuikit ding nahiuve; ijeh inem itile namitmu tah uva nasohchan naova kona kalepui kitteng, keiman leisetna mijouse lah-a minthana le vahchoina kabolpeh dingu ahi, tin Pakaiyin aseije.
  </para>
</usx>
