<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="HEB" style="id">Hebrai</book>
  <para style="h">Hebrai</para>
  <para style="toc1">Hebrai</para>
  <para style="toc2">Hebrai</para>
  <para style="mt">Hebrai</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masang laijin Pathen'in abung abungin got chom got chomin themgaoho kamin iputeu ipateu hengah thu aseijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />tulai ni nununga hin Achapan eiho hengah thu aseitai; hiche Achapatah chu imajouse gouloa atun ahitai, chule thilsem jouse jong hi ama khutna asemsah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche Chapa chu aloupina vah le aumje kibahpi ama limtah ahin, athahatna thua ijakai tuh dinga ahin, amatah chun chonsetna asuthengin chungnunga Lal Chungnung pen jet lamah atoutai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule aman vantil ho sanga min phajo gou alo bangtah-in amaho sangin achungnung jotai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile vantil ho koipen jah-a itih pena, Nangma ka-Chapa nahi, Tunia keiman kahin nahitai? chujongle, Keima a-Pa kahi ding ahin, Ama ka-Chapa hi ding ahi tia aseikhah-em?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin hiche apeng masapen chu vannoi leisetna ahinpui kit ding tenga ding chun, Pathen vantilte jousen ama chu chibai bohhen, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule vantilte chungchang thua hitin aseije, Aman avantilho lhagao asosahjin, Alhachate chu meikong asosahjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chapa chungchang thua vang chun hiti hin aseije, Vo Pathen, nalaltouna chu tonsot tonsot geija umjing jeng ahi; Chule chondihna tengdop chu nagam tengdop ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman chonphat nangailun, khan gitlou nahon ahi; Hijeh chun Pathen'in, na-Pathen'in, naloite chengse chungvumah kipana thao nanutan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule, Pakai, atil abula nangman vannoi leiset bul naphudoh ahi; Chule vanho jong nangma khutsoh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiteho chu mangthah ding ahi, nangma vang umjing jeng nahi; Hichengse chu ponsil banga lui ding ahi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiteho chu nangman ponlhe banga najel lom ding ahi; Hichengse chu ponsil banga kikhel ding ahi; Nangma vang nabang nahi jinge; Nakum jong bei lou ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahivangin keiman, Namelmate nakeng chotpha kaneisah masangsen, Kajet lamah tou jingin, tia vantil ho koipen jah-a aseikhah-em?
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho chengse chu lhachale lhagao, sochatna gouloding teho jenle ding hinkisoldoh hilouham?
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh-a chu ithu jah chengseu hi lunglut tah-a igut cheh dingu ahi; achuti loule ajole chucheng chu kitolmang sah khau hite.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ijeh-inem itile vantil ho kama asei thu chu dettah-a, chule suhkhelnale thua nunlouna jouse man adoltah cheh-a asanuva ahile,
  </para>
  <para style="p">
    <verse number="3" style="v" />huhhingna loupi hi nahsahmo leuhen eiho iti isochat dinguham? Hiche huhhingna hi amasa Pakai kama asei, ajahon eiho dinga aphudet ahin,
  </para>
  <para style="p">
    <verse number="4" style="v" />melchihna le thilmu kidang chule bolmo kidang got tamtah toh tho-a, alunggot doltah-a Lhagao Theng phathei kihoma chu Pathen'in jong ahettoh sahpiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh ham itile khonunga hung umding vannoi leiset thu iseiju chu aman vantil ho noijah akoipoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla khatnin mun khatnah ahettohsah-in, Mihem chu ipiham, nangman nalung viltenin? Chujongle Mihem Chapa chu ipiham, nangman navil jingin?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman ama chu vantil ho sangin themcha khatbou nanoinun sah-in ahi; Loupitah-in gunchena lal lukhuh-in najemin ahi; Nakhutsoh jouse chunga vaipon natungin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule imajouse abonchan akengphang noija nakoijin anoija na-umsahtai, tin aseijin ahi. Chutichun ijakai aboncha anoija akoi jeh chun, aman anoija akoi lou imacha aumtapoi. Ahivangin tu geijin eihon imajouse anoija alutsoh imu hih laijuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin vantil ho sanga themcha khat anoinunsah Jesu vang chu imutaove, Pathen lungset vanga mi jouse dinga thina atepkhah tei ding mong ahin, thina athoh jeh chun choi-at nale loupina lukhuh-in akijemtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh-inem itile ama dinga thil ijakai uma, ama vanga thil ijakai um, ama dinga chu chate tamtah loupina-a apuilut jouse-a chu, ahuhhingnau lamkaipa chun athohgima asuhchamkim ding thu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijeh-inem itile asuthengpale asuhthengho chu aboncha khatna konbou ahiuve. Hijeh chun aman amaho chu sopi sah ding jahcha louvin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman kasopite henga namin seiphong lengting, Houbung ho lah-a navahchoi la sange, atin;
  </para>
  <para style="p">
    <verse number="13" style="v" />mun chom khatna, Kagin chatna ama jenga kangah ding ahi, atin; chukitman, Ven, keimale Pathen'in eipeh chapangte hi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuti ahi jeh chun chapangteho chu thisanle tahsa chang khom ahi jeh-u chun, thina-a thina thu neipa, hichu diabol ahi, asuhpoi theina dingle,
  </para>
  <para style="p">
    <verse number="15" style="v" />thi kichatmana hinlai sungse-a soh-a umteho jouse chu ahuhdoh theina dinga, amatah jong hichu changa ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Atahbeh-in aman vantil ho umchan tho louvin Abraham chilhahte umchan athojotan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche jeh chun miho chonset thensona dinga, ama Pathen lama dinga thempu chungnung mi khototah le tahsan umtah ahina dinga chu, ijakaija asopite bangbanga ahung umding chu adoltah ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu aman lhepna atoa hesoh genthei athoh jeh chun, lhepna tohho phatna bola hu thei ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun, van kouna changkha sopi thengteho, itahsanu Solchah le Thempulen Chungnung Christa Jesu lam chu ha ngaitouvin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen insung jouse lah-a Mosi tahsan umtah ahi bang chun ama jong apansahpa lama tahsan umtah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu in sanga in sapa achoi-at joh bangtah-a chu, ama chu Mosi sanga gamchenga loupijo cheh dingdol ahi, tia kisima ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />In jouse chu mi khat sahdoh ahi cheh-in, ahin imajouse sadohpa chu Pathen ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin khonunga thu hung kisei dingho hettohsahna dinga, Mosi chu Pathen insung jouse lah-a lhacha panga tahsan umtah ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Christa vang chu chapa ahin, ama insung chunga tahsan umtah ahi. Akhon ni geija iha kat naole kinepna ikisonao hi ituhdet pou ule, eiho hi a-insung mite ihiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti ahi jeh chun Lhagao Thengin asei bangin, Tunia nanghon a-awgin najah uva ahile,
  </para>
  <para style="p">
    <verse number="8" style="v" />Lunghansah na-a bang chun nalungu tahsah hih-un, Gamthipma kipatep laija bang chu bol hih-un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chukoma chun naputeu napateu vin patepnan eideh-un ahi, Chule kathilbolho kum somli amuvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche jeh-a chu hiche phung mite chunga hi kalung lhai lou ahi, Amaho hi imatihchana lungchavai te mong ahiuve; Ahinla amahon kalampi ahepouve;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chua kalung hanga kahahsel ahi, Hiteho kacholngah na-a lut lou ding ahiuve, kati ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo sopiteho, chingtheijun, ajole ijemtin Pathen hinga kona pul lhahna dingin, nangho lah-a jong tahsanlou lung giloupo um khauvinate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin chonset lheplhah-a khattou lungtah chehcheh nalah uva aum louna dingin, Tuni kiti phat chu aumlai sungin khatle khat niseh-in kitilkhoutouvin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh-inem itile eihon ikinepnao tahbeh kipana hi akhon ni geija ituhdet jinguva ihipouvule, Christa kikoppi ihiu ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tunia a-awgin najah uva ahile, Lunghansahna-a bang chun nalungu tahsah hih-un, akitin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche ati hi, athu ajah jouva lunghansah chu koi koiham? Egypt gama kona Mosi khutna ahinpuidohho chengse chu hilouham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule kum somli sunga alung himona koi chungham? Gamthip laija along lum, hiche chonseho chunga chu hilouham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiteho kacholngah na-a lut lou ding ahiuve, tia ahahselna chu koi chungchang thua aseiham? Thu ngailouho chungchang thua hilouham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichea hin amahon atahsan loujeh uva lut thei lou ahitaove, ti chu imuvin ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jeh chun eiho kichau hite, achuti loule ajole ama cholngahna-a lut theina ding thutepsa aum jeng vangin, nalah uva khattou chua lut dinga kona athona umle akilome.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ijeh-inem itile Kipana Thupha ijah uva akisei chu eihon ijah mong mongu ahitan, amaho jong chutobangma chu ahi; ahivangin athu jahotoh tahsana akigop lou jeh-u chun, athujah-u chu amahon phatchomnan anei tapouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu atahsan eiho chengse vanghi cholngahna-a chu ilut laiju ahi; Kalunghana kahahsel banga chu, Kacholngah na-a lut lou ding ahiuve, tia, asei bang chu ahi: vannoi leiset bul aphudoh tila aman anatoh ajosohsa ahitah vangin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mun khatna aman ni sagini thudol aseijin, Chuin ni sagi nin Pathen anatoh jouse-a konin akicholngah tan ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukitman hikoma chun ahiti sei kitleuve, Hiteho kacholngah na-a lut lou ding ahiuve,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti ahi jeh chun mi kimkhat cholngahna-a alut dingu aumnahlai jeh chun chule masanga Kipana Thupha kisei jasa hon ajoplou jeh uva alut lou jeh-u chun,
  </para>
  <para style="p">
    <verse number="7" style="v" />khonung sottah nungin, Tuni tin nikho khat atep kittan, David kama masanga kisei bangma chun, Tunia nanghon a-aw najah uva ahile, Nalung tahsah hih-un, ati kitnin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Joshua'n amaho chu acholngahsah hitahenlang hile, khonunga nikho chom thu chu asei lou ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche jeh chun Pathen mite dingin cholngah ni-a kicholngahna aumnalai jinge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu Pathen anatoh-a kona akicholngah banga chu acholngahna-a lut jong chu anatoh-a kona kicholngah ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun koiman chuche thua nunlou umchan chu athoa alhua aum louna dingin, cholngahna-a chu lutna dingin ponpanu hite.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu Pathen thuhi hing jingle natonghat jing ahi, chule hemto chemjam jouse sanga jong hemjo ahi, hinna le lhagao gu kisuhtohna le lhin hichengse chu sukhen theihela sunthei ahi, chule lunggel le lungthim ngaito hetoh paijen jeng thei ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule thilsem ama mitmu-a langlou imacha aumpoi; ichon nao isuhtouva ilhutna dingpao mitmu-a chu imajouse asagohkeo le kihongsa ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vanho chengse jotpaija chea Pathen Chapa Jesu thempulen chungnunga inei jeh-u chun, itahsan iphonu hi ha tuh det jinguhite.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu ihatmonau eihetpia eithohpi phah lou thempu chungnung neija ihipouve, eibanga imalam jouse-a lhepnale patepna tohkha-a thohkha-a, ahi jenga jong chonsetna nei louheljoh ineiju ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche jeh chun hepina ichan theina dingule, panpina ingaichat phat ule lungset nale panpina imu theina dingun, hakattah-in lungsetna laltouna chu neijuhite.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ijeh ham itile thempu chungnung jouse chu chonset thensona-a thilto le gan kithat alhakop theina dinguva, mi lah-a kona kilachoma mihemte dinga Pathen lam thila chu kipansah ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amaho chu ima helouho le sukhelteho chunga nemheocha lungde thei ahiuve; ajeh chu amahotah jeng jong hatmona-in aum kimvel chehjiu ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />chuti chu ahin miho dinga abol banga chu, amahotah dinga jong chonset thensona dinga kilhaina abol louthei ahipoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hiche choi-atna chu Aaron banga Pathen'in akoulousen koiman ama chamin akilahpoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche bang chun Christa jongin thempu chungnung hi dingin amale ama akichoi anpoi; ajah-a, Nangma ka-Chapa nahi, Tunia kahin nahi, tipajoh chun achoi-at ahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutima chun mun chom khatnah, Melchizedec umdan banga Tonsot thempu nahi, tin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama chun tahsaphe-a aumlai ni chun thina-a kona ama huhdoh theipa hengah hapena pengle mitlhi lha-a taona le thumna atoh-in, chule a-Pathen gin jeh chun ngaipeh-in aumtan ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chapatah ahi jeng vangin athohna chengsea chu thua nunje kisinna ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ama chamkimsah sohkeijin aumin, athua nungho jouse dingin tonsot sochatna bulpi asohtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Melchizedec umchan banga thempu chungnung ahi, tin Pathen'in asahtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama thudol chu thu tamtah sei ding kaneijun, nakolsehtah jeh-un ahilchet jong ahahsai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitih chanpia hi, nangho mihil thei nahi dingu thu ahitan chutitah sangin, khat touvin Pathen thubul kipatna jemho nahildiu nangai chaovin ahi; chule anham hilouva, bongnoi ngainalai mitoh nabangtaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bongnoi anna neija chun, naosen ahi jeh-in, chonphatna lam thu hetna imacha ineipoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anham vang chu mi kikhan lhitho dingbou ahi, chuteho chun ahet theinao chu aman jing jeh-un, ase apha hetkhenin athem lhehtauve.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahi jeh chun Christa thuhil kipatna api lam donta louvin; chule natoh thisa-a kona lung heile, Pathen tahsan,
  </para>
  <para style="p">
    <verse number="2" style="v" />Baptize chan gotchom chom, chule khut ngap, athisaho hindoh kit, chule tonsot thutan vaihom thudol lam thuhilna bulphut kit ta louvin, pilhina lam dela masotna dingin kihaboluhite.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pathen'in eiphat sah uva ahile, hicheho chu ibol dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu khatvei khovah changsaho chun van thilpeh chu atep khataovin, Lhagao Theng changa ahitaovin,
  </para>
  <para style="p">
    <verse number="5" style="v" />chule Pathen thupha le khonunga hung soh ding thilboltheina chu tepkhasa ahitaovin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho chu alhuhtah uva ahile, alung heina dinguva semphat thah theihoi ahipouve; ajeh chu amahon Pathen Chapa chu amaho tuma thingpel'a khenbeh kit ahiuvin, chule lhangphong tah-ah taipongin aumsah jiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu leisetnin, achunga ju jing go twi tintang anadona, adinga lei kigitpehho dinga nehdol anche louhing apensah ahin, hiche leiset chu Pathen'a konin phattheina achangin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin ling phungle ham lingnei apendoh vangle, hichu pannabei ahin, chule sapset anaijin, akhonna chu meija govam ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin, deitahteho, chutia kasei vangun, nangho umchan chu hiche sanga phajo leh huhhing-a umnatoh kithokhom thilho nabol dingu kagingcha lheh jengui.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh ham itile nanghon mithengte nanajenleu ahitan; tun jong najenleuvin, hiche Pathen min lama natohgimnao le ngailutna kilanga nalhanao Pathen'in asuhmil ding chu, ama chutobanga chondihlou ahipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule akhon ni geija kinepna chamkim kichentah chu mu dingin, nahapan ngai bangu chun hapan cheh-un,
  </para>
  <para style="p">
    <verse number="12" style="v" />Thase louvin tahsan leh thohhat vanga thutep mun loho chu, amaho chonnung chu jui chehleu chun, kalungu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathen'in Abraham athutep chun kihahselna ding ama sanga lenjo aum lou jeh-in, ama changin akihahselin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Thon louva keiman nangma phatthei kaboh ding nahi, chule pun jong kapunsah ding nahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiti chun aman angahat, athohhat jeh-in thutep ga chu amutan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ijeh-inem itile mihon ama sanga chungnungjo chu kihahsel na-a aneijiu ahi, chule thu kichetna dinga akihahselu chu akinelnao jouse kichaina ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutobanga chu Pathen'in athutep gou lo dingho chu, alung ngaito long lou ahi chu nasacheh tah-a vetsah ding lung agotna, kihahselna chu asuhdet ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathen jou ahi louna kikhel lou thil ni vanga, eiho kihuh dohna dinga ima sang uva um kinepna kikoi chu tuh dinga lhaija eihon kitilkhou na nasatah ineina dinguva, abol ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche kinepna chu hinna thihhat-aija ineiju ahi; hichu kichentah, dettah ahin, chule pondal sung lam geija lut ahi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Hikom mun'a chu Jesu anamasa-a Melchizedec umchan dungjuija tonsot thempu chungnung hia, eiho dinga analut masa-a ahitai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche Melchizedec, Salem lengpa chu, Chungnung pen Pathen thempu ahin, chule Abraham'in lengho agatha jouva ahung kile kit chun lampia agalamton phatthei agaboh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama chu Abraham'in thil jouse hopsom-a hopkhat apen ahi. Amin chu amasa chonphat Leng kitina ahin, chuin Salem Lengpa ahi, hichu chamna lungmonna Lengpa kitina ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama chu nu neilou, pa neilou, chilhah guilhah neilou, ahinkho kipatle ahinkho lhinna bei ahin, Pathen Chapa banga kisem ahin, hiche Melchizedec chu a-imatih chana thempu-a umjing ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lung gelun ngaitouvin: ipului bulpiu Abraham'in athilchom aphalai chengse hopsom-a hopkhat apehpa chu itobanga len hitam!
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Levi chate lah-a thempu dinmun changho chun, danthu nungjuija miho lah-a kona, Abraham taiguija peng ahi jeng vangin asopitehoa kona, hopsom-a hopkhat lahna ding thu aneiju ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho phung guija kona akhanggui thu kisimtha loupa vang chun Abraham'a konin hop soma hop khat akilah-in, thutep neipatah chu phatthei aboh tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule mineojon achunga mi-a kona bou phatthei boh amu chu kinelna bei ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche hin hopsom-a hopkhat muho vang chu thina thu noija um ahiuve; khat joh hopsom-a hopkhat mupa vang chu hing jing jeng ahi, ti hettohna kineija ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hopsom-a hopkhat mupa Levi chun amatah-in Abraham'a konin hopsom-a hopkhat apei tilehen ti thei ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh iham itile Melchizedec chun apu agalamtoa chu Levi atai sunga umnalai ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuti chu ahin, Levi ho themputna chu chamkim sohkei thei hile (ajeh chu chua kona chu mihon chonna danthu amu-u ahi), Aaron umdan banga kisei louva, Melchizedec umdan banga ding thempu got chom khat umdoh lou i-khohta dingham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu thempu akikhele danthu jong khel tei ding thu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aumchan thu kiseipa chu phung chom mi ahi; chuche phunga mi koimacha maicham mun'a natonga aumpoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh ham itile I-Pakaiyu chu Juda phunga penga ahi chu kichentah-in akilange; ahin hiche phung thua chun Mosi'n thempuho thudol ima aseipoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule tahsaphe thupeh danthu dungjuija hilouvin, mantih neilou hinna thahat dungjuijoh ahin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Melchizedec lim banga thempu chombeh khat hung uma ahile, kathu seiju hi kichen cheh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh iham itile hichu hettohsahna chun, Melchizedec umdan dungjuijin, Nangma tonsot thempu nahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu ahatmole phatchomna bei ahi jeh-in chonna dan thupeh amasa chu amangthah tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh iham itile chonna dan thupeh chun imacha asucham kimpon ahi; ama mun'a chu kinepna pha chungnungjo kipolut ahitai; hiche chu eihon Pathen kom inailutnao ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule achuti jeng vang chun ama chu hahsel louva thempu-a kipansah ahipoi,
  </para>
  <para style="p">
    <verse number="21" style="v" />(ijeh-inem itile amaho chu hahsel louva thempu-a kisema anahitauvin; hijongle ama vang ajah-a, Pakai chun akihahsele alung hei kit lou ding ahi, Melchizedec umdan bangin nangma tonsot thempu nahi).
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuti chu ahi jeh-in Jesu chu kitepna chungnungjo-a panga ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amaho chu thina-in asuhmo uva apan jing thei lou jeh-un, thempu chu ana tamlheh-un ahi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama vang chu tonsot geija umjing ahi jeh chun khel louhel thempu mun changa ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun ama vanga Pathen kom nai lut teho chu, taopeh dinga ama hing jing jeng ahi jeh-a chu, amaho chu huhhing chamkimsoh thei ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ijeh ham itile chutobang thempu chungnung athena theng, lepthol neilou, boh behlou, chonsete lah-a kona kisepdoh, vanho sanga chungnung-jo-a kisema chu eiho dinga kilom mong ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama chun aniseh-a thempu chung nungho banga chu, amasa ama chonset thensona-a, gan kithat alha masah ding chu akin akhohpon ahi; ijeh ham itile aman hichu amatah akilha jeng jeh chun khat veijin aseibulhit sohkeitan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajeh chu danthun apansah thempu chung nungho chu hatmona nei mihem ahiuve; danthu nunga um hahselna thu chun tonsot geija dinga kisucham kimsoh Chapa chu apansah ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chunga thu kisei chengse lah-a athupipen hiche ahi, Van'a Chungnung pen laltouna jet lama tou,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule mihem tundoh hilouva, Pakai tundoh houbuh tahbeh le mun theng lhachale-a pang Thempu Chungnung ineijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thempu chungnung jouse chu thilto le kithensona ganlha dinga kitung cheh ahiuve; chuti ahi jeh chun hiche Thempu Chungnung jong hin ikhat khat todoh anei tei ding thu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama vannoi leiset chunga anaum hile, thempu hilouhel ding ahi; ijeh ham itile danthu dungjuija thilto tohdoh dinga chu aum naovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho lhachale-a apannau chu, Mosi'n houbuh sah dinga agot laija, Pathen'in ahilchah-a ajah-a, Chingtheijin, vetkah dinga mol chunga nakivetsah lim bang bang chun bol sohkeijin, tia asei banga chu van'a thil limdanle ale ahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu vangin kitepna phajo cheh palaija apan dungjuija, kitepna chu thutep phajo chunga ahisah-a, lhacha mun phachung nung jo-a panga ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu kitepna masah chu themona beihel hile, aninapa mun ding chu kingaito lou ding ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />ajeh iham itile amaho chu a-oimon, Veuvin, Pakaiyin hitin aseije keiman Israel phung mite leh Juda phung mite dinga, Kitepna thah kasemdoh ding nikho hung lhung ding ahitai,
  </para>
  <para style="p">
    <verse number="9" style="v" />Aputeo apateu Egypt gama kona puidoh ding ni-a akhutnuva katuh-a, Amahotoh kitepna kasemdoh, hiche kitepna tobang chu ahitapoi, Ajeh chu amaho kakitep naovah aum jompouvin ahi; Chuti ahi jeh-a chu keiman jong amaho kadon lou ahitai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche nikhoho nunga Israelte toh kitepna kaphudoh ding chu Hiche hi ahi, tin Pakaiyin aseije; Alungthim uva kachondan thupeh pengting, Chule alung sunguva kasut ding ahi; Chule keima amaho Pathen hingting, amaho jong kamite hi ding ahiuve;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amitakipmin aheng akom le asopite chengu, Pakai chu heuvin, tia ahil lou dingu ahitai; Ajeh chu aneopena pat alenpen geija eihetsohkei dingu ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Asuhkhelnauva jong kahepi ding ahi, Achonsetnao le akhangitlou nau jong geldohta lou ding kahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche kitepna hi aman athah ahi atia ahile, amasa chu aluisah ahitai. Chutichu ahin aluija le atehta-a chu, amang ding kon ahitai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule kitepna masa-a jong chu Pathen lhachale-a pandanle mun theng, hiche vannoi leisetna mun theng ana uma ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahoubuh semu chu adan masapena chu meivah tunna, dokhang, vetsahna changlhah to uma ahin, hichu Mun Theng atiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule pondal nina dan sunga chu houbuh Mun Theng Chungnung atiu chu uma ahin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Hikoma chu gimnam twi halna sana maichamle, kitepna thingkhong sana kilonkhum chu uma ahin, kitepna thingkhong sunga chu manna umna sana bel leh, Aaron tenggol pahmum, chule kitepna songpheng ni chu uma ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />chule achung vuma chu hepi touna lekhu-a Cherub loupitah ni uma ahin; hitiho thu chu tun akip akoijin sei joupouhite.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti chun thil hicheng chu akisemin, thempuho Pathen houna lhachale dingin houbuh masa sunga chun alut jingjiuvin ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Adan nina sungnunga vang chun thempu chungnung changsehbou kum khat sungin khatvei alutjin ahi; ahivangin ama dingle miho-a ding, het louva achonsetnao thensona ding, thisan chu choi louvin alutjipoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Houbuh masa chu aumlai chansea mun theng sunga lutna lam chu kilangsoh lou ahi, tin Lhagao Thengin aphonge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hichu tu laija dinga tekahna ahibouve; hiche dungjuija chu thilto le kithensona jong alhajiu ahin, hitiho chun ase apha hetna lama ahouho chu achamkimsah thei lou ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Neh dan, don dan, kisil gotchom chomtoh tahsa polam thudan jeng ahin, semphat kah-a dinga anakingaitoa ahibouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Christa vang chu khonunga hung umding thilpha thempu chungnunga hung panga khutna sah lou, hiche thilsem lah-a hilou, alen chungnung jole gamchenga chamkimjo houbuh-a chu lut ahin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Kelchale bongnou thisana hilouva, ama thisana Mun Thenga khatveiseh lutna, eiho dinga tonsot geija lhatdohna kemlou eipeh-u ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ijeh ham itile kelchale bongchal thisan chule bongla vutvam kithe khuminbon akisuboho atahsa polamu athensah-a ahile:
  </para>
  <para style="p">
    <verse number="14" style="v" />Christa tonsot kemlou Lhagaova, nolna beihela, ama Pathen'a kipedoh jenga thisan chun Pathen hing lhachale-a pang dinga, thina natoh-a kona ase apha nahetnao chu gamchenga asuhtheng cheh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hiche jeh-a ama chu kitepna thah palai hija, kitepna masa noija suhkhel neija themoho lhatdoh na-a athitah jeh-a chu, akikouho chu tonsot kemlou gou lo ding ahitaove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajeh chu kitepna umna-a chu kitepna sempa chu athi lounaje umlou ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu thi nunglebou thulhun chu hatjia ahi: athuteppa hinlaise vangin ahatjipoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche jeh-a chu kitepna masa jong chu thisan beija kiphut det lou ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mosi'n danthu dungjuija thupeh miho jah-a aseichai phatnin, bongnoule kelcha thisan chu twitoh ponsan toh hyssop toh alan, lekhabule miho jouse chu athekhumin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche hi Pathen'in nangho napeh-u thupeh kitepna thisan chu ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chucheng kalval jongin houbuh chule lhachaleho manchah chengse jong chu chutima chun thisan chu athekhumin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Danthu dungjuija chu imajouse aboncha thisana suhtheng soh himaija ahi, chule thisanso louva ngaidamna umlou ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche jeh chun hichenga chu van'a thil lima um chu hitia hi suhtheng dingdol mong ahi, van thil tahtah ho vang chu chucheng sanga longlhenna phajo cheh-a suhtheng dingdol thu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Atabbeh lima um khutna kisa mun thenga Christa alutpon ahi; ahin tun eiho jala Pathen anga ding dingin van'a alutjotan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thempu chungnungin kumtina ama thisan hilou achoija, Mun Thenga alutji banga chu, ama thensona gan lha dinga lut matchet ahipoi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuti chu hile vannoi kisemtila patna aman tamtahvei athohgim ding ahitai; ahivangin tun aman amatah longlhengin akitoh jengin chonset suhbeina dingin tu khang nunungpen hin khatveiseh ahung kilahtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule mihemte dinga khatvei thia chujoule thutanna hung umding chu gotsa ahin;
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche banga chu Christa jong mi tamtah chonset pomang dinga kitoh ahitan, aniveina-a chonsetna beihela ama ngah jingho huhhing dinga hung kilang ding ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Danthu chu khonunga thilpha hung umding lima hi umbou ahin, alim tahbeh ahi lou jeh chun, akumtina longlhenna alhajiu chun ahin naiho chu achamkimsah joupouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuti lou hile longlhenna alhajiu chu tangta lou dingham? Ahouho chu khatveija kisutheng hileu setna ahetnao chu umtalou ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla hicheng chun kumtin in achonsetnao ageldohsah jotaovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh iham itile bongchal le kelcha thisana chonset suhbeihoi hilou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Christan vannoi leisetna ahung lut laijin, Nangman longlhenle thilto nanadeipon, Ahin keima dingin tahsa neigot pehtan ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ganpumgo thilto le chonset thensona longlhenna chun nana lunglhai tapon ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin keiman, Ven, keima kahungtai (Lekhabua keima thudola hitin akisune). Vo Pathen, keiman nangma lungdeilam bol dinga hung kahi kati, tin aseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman hicheng chu aseijin, Nangman longlhenna le thilto chule ganpumgo thilto chule chonset thensona longlhen chu nanadeitapon, hichenga chun lung jong nana lunglhai pon ahi, (hichu danthu dungjuija kitoh ahi jeh-in):
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin, o Pathen Ven, keima nangma lungdeilam bol dinga hung kahi, ati. Hiche anunungjo hi aphudohna dinga amasajo alahdoh ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche lungdei lama chu Jesu Christa tahsa akitoa a-imatih chana dinga khatveija akitodoh jeng vanga chu eiho suhthenga uma ihitaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule thempuho chengse adingun niseh-in hou lhachalen apangun, imatih chana chonset sumang theilou longlhen chu avel avelin atohdoh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama vangin chonset thensona longlhen khatseh chu tonsot geija dingin atohdoh-in, Pathen khut jet lama atouvin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche kalse chun amelmaho akeng chotpha akisem masang seuvin angah jingin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh-inem itile suhthenga umho chu thilto khatseh-in tonsot geija dinga achamkimsah ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Lhagao Theng jongin eihet tohsah naove;
  </para>
  <para style="p">
    <verse number="16" style="v" />ajeh iham itile Chuteng chuche ninung le chun amahotoh kitepna Kaphudoh ding chu hiche ahi, tin Pakai chun aseije: Keiman alung sunguva kachondan thupeh pengting, Chule alunguva kasut ding ahi, tia aseijouvin, hiche aseijouma chun,
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule achonsetnao le asuhkhelnau geldoh taponge, ati kitleuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutia chu chonsetna chengse ngaidama um ahitan, chonset thensona thilto umtalou ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche jeh chun, sopiteho, Jesu'n pondal ajotpaija atahsa puma hinna lam thah eisempeh uva chu,
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu thisan vanga Mun Thenga lut ngamna ineiju ahin,
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen insung chunga kitung thempulen chungnung ineiju ahin,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule ase apha ihetnao ilung sunguva aphalou chengse atheh ngima, itahsao twi thenga kisilngima ahitah jeh chun, lung dihtah pun tahsan kichentah-in Pathen kom naiju hitin,
  </para>
  <para style="p">
    <verse number="23" style="v" />Itahsan, ikinepnao hi long louhelin tuh det jinguhite; (ajeh chu thutep pa chu tahsan umtah ahi.)
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule ngailutna le thilpha bolna lama lungsoudohna dingin kingaitopeh chehjiu hite;
  </para>
  <para style="p">
    <verse number="25" style="v" />Abang khattou chonna bangin ikikhop hai louvin, nikho chu ahungnai tultulle ti ihet chanun, khatle khat kitilkhouto chehjiuhite.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajeh chu eihon thutah hetna inei nungun, ihenasale ijanasan chonset bol leuhen, chonset jala longlhenna akikheh umtalou ahin;
  </para>
  <para style="p">
    <verse number="27" style="v" />Thutanna kichat umtah ngah jinga chule adouho kavam gam dingkon lungsatna meikong bou uma ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Koi hile Mosi danthu nahsahmo-a chu ahetoh mi ni le thum kam sung thua kona hepina beihela thia ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuti ahile Pathen Chapa akengtoa chotpha, chule akisuh thengna kitepna thisan chu atheng louva ngaito-a, chule lungsetna Lhagao nahsahmo-a bola chu nangho lunggela, hiche sanga chu ichana khoh chungchon talent man ding dola nakilomsah um?
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajeh iham itile, Phulah ding chu keija ahi; keimanbou phuba chu kasah ding ahi tin Pakaiyin aseije; chukitle, Pakai chun amite thu atan ding ahi, tia hicheng seija chu keihon kaheuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathen hing khutna chuh chu kichat umtah ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahi vangin nanghon masanga khovah namu nunguva hesoh genthei thoh hahsa nathoh laiju chu geldoh jingun.
  </para>
  <para style="p">
    <verse number="33" style="v" />Langkhatna housetle hesoh genthei thoh hahsa thoh laiju, chule alangkhatna hesoh genthei thoh lah-a nahung pannu chu geldoh jingun.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ajeh chu nanghon kakihenna ho-a jong neina khotouvin, chule gamchenga phajole imatih chana umjing van'a gou naneiju chu naheuvin, naneiju kichom chu kipahtah-in nanatoh jengtaovin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hiche jeh chun chonphatman lentah nei dinga nahakat nao chu pailha hihhelun.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ajeh iham itile nanghon thutep chu nasan theina dinguva, Pathen lung deilam nabol uva pontho tah-a nathohhat dingu angaije.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ajeh iham itile chomcha khat joule Ahung dinga chu hung ding ahi, Hung geisang lou ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Michonpha vang chu atahsan vanga hing ding ahi; Chule anungchon vangle achunga kalung lhai lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahin eiho vang manthah na lama nungchon ho lah-a mi ihipouvin, lhagao huhhing-a umna dinga tahsan ho lah-a joh ihibovui.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tahsan hi kinepna thilho hetchetna, mu lou thil aum monge ti photchena ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh chu hiche thua hi upahon hettohsahna ananeiju ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahsan vangin vannoi leiset hi Pathen thua kisuto-a kisema ahi ti iheuve; chuti chu ahin, thil kimuho chengse hi thil kilanghoa kona kisem ahipoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tahsan vangin Abel'in Cain sangin thensona longlhen phajo alhan, ama chu michonpha ahi ti hettohsahna ananeijin, athilpeh thudol Pathen'in ahettohsah-in: chule hiche vang chun ama athisa ahivangin thu aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tahsan vangin thina amu louna dingin Enoch chu lah mangin aumtan; Pathen'in alah mangtah jeh chun ama chu akimutapon ahi; lah manga aum masangin Pathen lungtoh mitah ahi ti hettohsahna ananeijin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin tahsan beija vang Pathen lung tohoi ahipoi; ajeh chu Pathen aume chule ama holte chu tohphat man apei ti chu ama kom naijan atahsan dingdol thu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tahsan vangin Noah'in mu loulai thilsoh ding thuah hilchahna thu amun, Pathen ngaisahna neijin akichan, ama insung mi huhhingna dingin kong innei khat asan ahi; chule hiche vang chun vannoi themmo achansah-in ama tahsana chonphat chu achangtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tahsan vangin Abraham, akikou chun, alo dinga um mun'a chu lut dingin potdohna ding thun anungin ahi; chule hoilama ache ding jong helouvin akipatnin achedoh jengtan anahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tahsan vangin gamtep gama chun mi gama pem bangin apem jengtan ahi; chuche gamtep chu alopi ding Isaac le Jacob toh pon in'ah acheng khomin anahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh iham itile aman, abul nei khopi, asemtohle asadoh Pathen, hichu anga jing ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tahsan vangin Sara'in jong ateh nungin, athuteppa chu tahsan umtah-a angaito jeh chun nao vop theina aneitan, chule chapang khat apengtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche jeh chun athikon khatna konin van'a ahsi jatle twikhanglen kama neldi jatna tam, simsenlou apengdoh jengtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiteho chengse chu tahsan neijin athigam taovin ahi, thutep thilteho chu achang lou ahitaove, ahivangin hiteho chu gamlatah-a pangin amuvin, akolchah-un, chule amaho chu leiset chunga kholjinle gamdang mi ahiu chu aseidoh uvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh ham itile chutobanga thusei ho chun amaho gamtum ding aholu ahi ti chu aphondoh-u ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon ahung kondohnao gam chu lunga agel jingleu, akile kitna dingu phat gomkom anei dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin tun amahon chuche sanga phajo nomjo khat atupmu ahin, hichu vangam ahi. Hiche jeh-a chu amaho Pathen tia kisei ding chu Pathen kijapi lou ahi; ajeh iham itile amaho dinga chu khopi khat gotsa akoi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham patepmin aumin ahile, tahsan vangin Isaac atoh jengtan ahi; chule kipahtah-a thutep changpa chun, ajah-a,
  </para>
  <para style="p">
    <verse number="18" style="v" />Isaac'a kona nachilhah kisei ding ahi, tia kisei achapa changkhatseh chu peh dingin ago jengin ahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh chu Pathen'in athi lah-a kona jong akaithou thei ahi ti agel ahi; chule tekahnan ama chu achang kittan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahsan vangin Isaac'in khonunga hung lhung ding thuah Jacob le Esau phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tahsan vangin Jacob chun athi konin Joseph chapateni phatthei aboh gelin ahi; atenggol chunga akingamin Pathen alhaijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tahsan vangin Joseph'in khonunga Israel chate Egypt gama kona apotdoh dingu thu aseijin ama gu thudolah thu apen ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosi apenin, naosen chu hoi asa lhonin tahsan vangin anule apan lha thum asel lhonin; chule lengpa thupeh jong akicha lhonpon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Mosi akikhanlhit phatnin, tahsan vangin Pharaoh chanu chapa tia kiminvo ding adan;
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman chomkhat chonsetna nomsah sangin Pathen mite toh bol hesoh thoh khom ding chu alhengjotan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Egypt gama gou jouse sangin Christa ahousetnau chu chung nungjon agelin ahi; ajeh chu aman tohphat man asan ding lam jeng chu avet ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tahsan vangin aman lengpa lungsat ding chu kicha louvin Egypt gam adalhan ahi; ajeh iham itile aman mu theiloupa chu amu bangin athoh lhumkei jengin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule asoh masa chengse that chun amaho asuhkhah louna dingin, tahsan vangin kalchuh kut asemin, chule thisan thekhum abolin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tahsan vangin amahon tolgo bangin twikhanglen San chu ajot gal kaijun, Egypt miten chutia bol ding chu agouvin ahile, twijin achuplih gamtaovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tahsan vangin Jeriko khopi kul, ni sagi avelun ahile, akulpi chu achimtai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tahsan vangin Rahab notinun gam velhiho lungmong tah-in a-in'a alhunsah-in ahile, thua nunglouho toh amantha tapon ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Akal ipi kasei dingham? Gideon, Barak, Samson, Jephthah, David, Samuel, chule themgaoho, hiteho thu umchan seisohkei leng phatnin ato lou ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amaho chun tahsan vangin gamtin loinemin alauvin, chonphat abolun, thutep ga achangun, keipi bahkai kam ahuh uvin,
  </para>
  <para style="p">
    <verse number="34" style="v" />Meihat achen daijun, chemhema konin asohchaovin, hatmoa konin ahat taovin, galsatnin hattah ahitaovin, apang khom agalteu anojam gamun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Numei hon amithisa chengu hingdoh kit akimu kit taovin ahi; chule adangho chu thokitna phajo chungnung aneina dinguva, ahuhdoh dingu chu anom pouvin ahile, bol gentheijin aumtaovin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Abang kimkhatman engbol le jep athoh-un, bulputle songkul'a khumin patepmin aumun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amaho chu songin asepjiuvin, thing atnin a-at tanun, patepmin aumun, chemjamin athatnun, kelngoi vunle kelvuna kivonin avahleuvin, lhasamle hesoh gentheijin bolsetnin anaumun
  </para>
  <para style="p">
    <verse number="38" style="v" />(vannoi leiset amaho umnahoi ahipon), gamthip laija, molle lhang-ah, songko ho-a, chule leiko homa avahleuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hicheteho chun tahsan vanga hettohsahna anei vangun thutep ga achang tapouvin ahi:
  </para>
  <para style="p">
    <verse number="40" style="v" />Ajeh chu eiho beija amaho chu suhchamkima aum louna dinguva Pathen'in eiho dinga thilphajo khat gotsa akoi ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahi jeh chun eihon jong hettohsahna meipi nasatah-in eium kimvel jeh-u hin einoh phahsah jouseule ichunguva kai jing chonsetna hi pailhau hitin imasanguva um kilhaitetna lampia hin thohhat tah-in lhaijuhite;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule itahsan suhchamkim leh lamkai pipuipen Jesu lam kat jingu hite; aman amasanga thanopna aum jeh chun jumle maimohna nahsah louvin, thingpel geijin athoh lhumkeijin Pathen laltouna jet lamah atoutan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun lhagao lama nalel uva nalhahdah louna dingun, chonse hon ama douna-a nelkalna thu aseiju thoh lhumpa chu gelun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho chonset douna-in thisan sohleuvin napang hih laijuve;
  </para>
  <para style="p">
    <verse number="5" style="v" />chule, tilkhouna dinga nangho chapate dolla nakiseipeh nao nasuhmilu ahitai. Kachapa, Pakai gimbolna ngaisah louvin bol lou jenin, Chule aman nasosal tengle lhahdah nan neihih helin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajeh chu Pakaiyin angailut chu agimbolji ahi, Chule aman alah chapa chengse chu ajepjin ahi, tia chapa houva nahounao tilkhouna chu nanghon nasumil taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon nathoh-u chu nakisungse nao ahi; Pathen'in achapate bola nabolu ahi; ajeh iham itile apa sungse lou chapa koiham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chate jousen athoh cheh sungsena-a chu naum louvule, nangho jaocha nahiu ahi, chatetah hilou nahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuche kalvalin, eihon tahsa lama eisungse dingu pate inaneijun, amaho chu inaging lhehji uvin ahi: chuche sanga chu ihinna dinguva, lhagaoho Pa thua chu ihanun cheh lou dinguham?
  </para>
  <para style="p">
    <verse number="10" style="v" />amaho chun ni chomcha khat dinga amaho phasah sah-a eina sungse tahbehjiu ahin, ama vang chun eiho phatchomna dinga, ama thenna chu ichan theina dinguva eigimboljiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gimbolna jouse hi apetle lungnopna ahipoi, lhasetnan akigelbove; ahivangin khonungle hichea kon chun chutia gimbolna umho ding chun aga lungmon umtah chonphat asohjin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche jeh chun nanghon khut kikhailha leh khup ngoite chu je jangun;
  </para>
  <para style="p">
    <verse number="13" style="v" />chule elbai lamvaite lampia kona nodoh-a um louva, boldama aumjohna dingun, nakho lhahna diu lampi kisem jangun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi jousetoh kichamdela umnale thenna chu delun, hiche thenna tailouva chu koiman Pakai chu amu lou ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kihong phaovin, ajole mikhat tou Pathen lungset changlel umkhantin; thilkha jung hungdon doh-in sumovin natin, mi tamtah suh boh-in umget inte;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahi loule khatvei neh mana apenpi agou lo ding joh-a Esau banga Pathen ja loule akideija, ajonga, umget inte.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu Esau chun khonungin phattheina gou chu lo ding alunggot tena mitlhi puma gunchu tah-a ahol vangin, lungheina gomkom amu lou jeh-in, paijin aumtan ahi, ti naheuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangho molsang tohkhah theile meija ka, meivom, muthim, khopihui,
  </para>
  <para style="p">
    <verse number="19" style="v" />sumkon gin chule thu kisei awginna-a hung nahipouve. Hiche awgin jateho chun ajah uva thu dang kiseibe louna dingin ataovun ahi:
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajeh chu ganhing jengin jong mol chu atohkhah-a ahile, songa selih jeng ding ahi loule tenga sutlih jeng ding ahi tia thupeh chu amahon athoh thei louhelu ahi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hiche thilmu chu kichat um behseh jeng ahin, Mosi'n, keima kakicha behseh jengin kakihot hot jengin ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin nangho vang Sion mol, Pathen hing khopi, van Jerusalem, vantil sangsom sangja umna mun'a hunga nahiuvin,
  </para>
  <para style="p">
    <verse number="23" style="v" />Van'a amin kisun apeng masaho khoppi len le houbung heng, mi jouse thutan Pathen heng, chule michonpha lhagao suhchamkima umho henga,
  </para>
  <para style="p">
    <verse number="24" style="v" />Kitepna thah palai Jesu henga, chule Abel'a sanga phatna chungnungjo thusei thisan thekhum henga hungjoh nahibouvui.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chingtheijun, thuseipa chu jopda khauvinate. Ajeh chu leiset chunga thupepa jop loubon asochat louva ahile, van'a kona van thupepa akon chun kiheimang leuhen, sohcha louhel ding ihiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichea chu a-aw ginin vannoi leiset aho ling jeng ahi; tu vangin aman thu atepmin, Keiman khatvei vannoi leiset jengseh hilouvin, van jong kaho ling kit ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichea, Khatvei kaho ling kit ding ati hin, long lou thilteho chu aum jingna dinga; thil kisem, thil longho chonmanga umding ahi, ti hetsahna ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh hin eiho long lou gam changa ihitah jeh-u hin, lungsetna neijuhite, hiche vanga chu eihon ginle ja tho-a Pathen lunglhaina lhacha ipan theiju ahi;
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajeh chu eiho Pathen chu kavamthei mei ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sopi kingailutna hi umjompeh jinghen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanghon maljin phatbol ding chu sumil hih helun; ijeh-inem itile chuti bola konin mi kimkhatnin het louhelin vantil alhunsah-un ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akihenteho chu nakihenpin gel unlang he jingun; nangho jong tahsa-a um nahiu heuvin lang hesoh genthei thohte chu he jingun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi jouse lah-a kichen hi ja umhen, chule ajalkhun jong suhboh-in umdahen; jonpanle miji toh jongho thu Pathen'in achung thu atan ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sum ngailut lung po hih helun; nanei sunuva chun lunglhaijun; ajeh chu amatah-in, Keiman nangma iti nama jongle lhaponge, changlha jong changlha pong-e, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun eihon, hakat tah-a, Pakai chu eipanpi ahi, keima kichaponge, Mihemin keima i-eilo dingham? iti thei dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathen thu nahiluva nachung uva navaipo teo chu geldoh jingun; chule amaho nunle khana kona sohdoh gelunlang, amaho tahsan umchan chu thovin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu Christa chu janhi, tuni, chule atonsotnin abang ahi jingin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thuhil kidang got chomchom kilhoh mangsah loujenun; lung hi lungsetna-a phudet aphai; anneh-a phudet ding ahipoi, hiti anneh thua chonna lungkhamteho chun phatchomnan aneidehpouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Houbuh sunga lhachalehon aneh thei lounao, maicham ineijun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thempu chungnungin chonset thensona-a Mun Theng sunga achoi lutji ganchaho long chu kulpi polama agouvam jiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche jeh-a chu Jesu'n jong ama thisan mihemte suhthengna dinga khopi kotpi polama thina athoh ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun hungun, ama ahousetnau chu pou hitin, kulpi polamah ama hengah cheohite.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh iham itile hikoma hin khomundet ineipouve, khonunga khopijoh chu iholu ahibouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti ahi jeh chun ama vangin vahchoina kithoina chu Pathen henga pe jinguhite, hichu amin jala kipathu iphon dohnao ikamuva kona aga chu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin phatna bolle thilpeh phala kihomdela thilbol chu sumil loujenun; ijeh-inem itile chutobang kithoina chunga chun Pathen alunglhai behsehjin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nachung uva vaipoho thun nungun, anoijuvah lutnun; amaho chu umchan thu seitoh-a pang ding ahi jeh-u chun, hichu lung nommo-a bol louva lunglhaisela abol theina dinguva, nangho lhagao ahon jingu ahi; lungnom mon nachung uvah thu seileu, nangho dinga khoh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiho neitao peh-un; ajeh chu keihon ase apha hetna thengtahle ijakaija kituptah-a chondih tup lung kaneijui, ti kakihet chenun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nangho heng lama eiki lhadoh vah chehna dinga eitaopeh dinga, nangho atumbeh-a kahin ha ngehdeh nahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chamna Pathen tonsot geija umjing kitepna thisana kelngoi ching pipu I-Pakaiyu Jesu chu athi lah-a kona puidoh kit chun, ama lunggot lam bol dingin,
  </para>
  <para style="p">
    <verse number="21" style="v" />nangho phatna lam jouse-a sucham kimun; ama mitvetna alunglhaina lam jouse-a Jesu Christa vang chun nangho-ah molsohen; loupina atonsot atonsot geijin umjing hen, Amen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sopite, naheng uva kahungtao ahi, kitilkhou na thuhi angai themun; ijeh-inem itile keiman nangho henga paltana kahinsut ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Isopiu Timothy alhadoh taove, hichu anaheuvin; ama ahung vah-a ahile, keima amatoh hung lhoningting nangho mutange.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nachung uva vaipoho le mithengho chengse chu kasalam anapeuvin. Italy gam mihon salam napeuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nabon chaova chungah lungsetna umhen. Amen.
  </para>
</usx>
