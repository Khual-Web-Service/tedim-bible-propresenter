<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JUD" style="id">Jude</book>
  <para style="h">Jude</para>
  <para style="toc1">Jude</para>
  <para style="toc2">Jude</para>
  <para style="mt">Jude</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu Christa soh, Jacob naopa Juda'n, Pa Pathen suhtheng chang teho chengse, chule Jesu Christa-a kikheh le kikouho chengse hengah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hepina, chamna, chule ngailutna nachung uva hapunin punghen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngaiteho, lhangpi huhhingna thudola naheng uva lekha hinsut kagot laijin, masanga mithengho anakipedohsa tahsan lama chu ponpan dinga nangho tilkhou na-a naheng uva hinsut ding khoh kasatan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu mi koi koiham guhthima hung kithol lut aumui; amaho chu hiche themona hi chang dingdol ahiuve tia masanga patna gotsa, Pathen ngaisah lou, i-Pathen'u milungset chu huhna lama sodoh ho, Pakai Pathen khatseh leh I-Pakaiyu Jesu Christa janomlou ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin Egypt gama kona amite ahuhdoh-a, chuche nunga atahsan louho asuhmang jeng thudol hi khatvei nahetsao hita jongle kahin geldohsah kit nomui.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule achanvou masa-u kolchah louva achennao dalha-a vantil ho chu, aman niloupi chungnung ni-a athu tan dinga tonsot muthim noija henna-a ahen ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sodom le Gomorrah, chule akimvela amaho tobang khopiho chengse, huhle jon thanhoi patna lama kipumpeh-a, chule tahsa lamdanna nung juiho chun vetton dinga phulahna tonsot meisa athohgim bangu chun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutobangma chun hiche mang kidah um manho jonghin tahsaphe asuboh-un, thuneina nahsahmon abolun, loupinaho chu aseiseuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla Mosi long chungchang thudola vantil pipuipen Michael diabol toh akinel chun, oimo-a houset ding angampon, ahin, Pakaiyin nahouse hen, atin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hinla hiteho vang hin ahettoh louhelu aseiseuvin ahi: ahin lungthim neilou gamsaho bangin, angaija ahetsao hitiho-a chun amaho le amaho akisuboh-un ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho chu ada ahiuve! ajeh iham itile amahon Cain lampi chu ahovin, kipaman duchatnan Baalam lamvaina lama loptah-in alhaijun, chule Korah golkehna-a chu amangthah taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaho chu nangho toh an naneh khom komu le nakidei vahnauva chu twi noija kisel songpi ahiuvin, kichatna neilou ama kivah kelngoi ching ahiuve; amaho twi ko lou meilhang, hui mut lonle; chavang kichai kona thingphung ga lou, nivei thi, ajunga kibotdoh ahiuve;
  </para>
  <para style="p">
    <verse number="13" style="v" />Twikhanglen kinong, ajachatnau twiphon sodoh; ahsi vahle ho ahiuvin, amaho dinga chu muthim lhangkhal tonsot geija dinga kikheh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Adam'a pat khang sagina Enoch jong chun hiteho chungchang thudola hi gaothu anaseidoh-in, Veuvin, Pakai chu amitheng sangsom sangja toh,
  </para>
  <para style="p">
    <verse number="15" style="v" />Mijouse chunga thutan dingle, alah uva Pathen ngaisah louho jousen Pathen angaisah lounao thudola a-Pathen ngaisah louna thilbolu, chule Pathen ngaisah lou chonse hon ama chunga thu hamtahtah aseiju chungchanga themmo chan dingin ahunge, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaho chu phunchel hat, oimo-a seiset hat, ama lung ngaichat lam cheh-a chona ahiuve; chule akam sungun hamhoitho thu aseijun, phatchom ngainan kam sungin mi ajabolun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin, ngaiteho, masanga Pakai Jesu Christa solchah hon aseisao thuho chengse chu nanghon geldoh jingun;
  </para>
  <para style="p">
    <verse number="18" style="v" />Amahon, Ni nunung lamle mi nuisat nelpeh hat, Pathen ngaisah louva ama ama lung ngaichat dungjui cheh-a chonteho hung umdoh dingu ahi, tia asei bangu chun:
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho chu loitum sem, tahsahing, Lhagao neilou ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin, ngaiteho, nangho vang natahsanu theng chungnung chunga chun nangmaho kisadoh-un, Lhagao Thengah tao taovun,
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen ngailutna-a chun kihongun, chule tonsot hin kemlouna dingin I-Pakaiyu Jesu Christa mihepina-a kinemin kat jingin umun.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule mi abang agingchalela chu hepiuvin,
  </para>
  <para style="p">
    <verse number="23" style="v" />Abang meija konin loidoh-un; tahsaphen asuboh nihchen ponsil sana thetbol pumin, kicha gehchan huhhingun.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tun nakipal lhuh louna dinguva nangho hongbit theile, ama loupina ang sunga themona beihela kipahtah-a lhut theija,
  </para>
  <para style="p">
    <verse number="25" style="v" />Eihuhhing pau Pathen ching khatseh henga chun, loupina, chungnunna, thahat thuneina, tu le atonsot geijin umjing tahen. Amen.
  </para>
</usx>
