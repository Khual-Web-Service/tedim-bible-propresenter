<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ROM" style="id">Rome</book>
  <para style="h">Rome</para>
  <para style="toc1">Rome</para>
  <para style="toc2">Rome</para>
  <para style="mt">Rome</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Paul, Jesu Christa soh khat, solchah khat hidia kikou, Pathen thupha seiphong ledia kisepdoh chun:
  </para>
  <para style="p">
    <verse number="2" style="v" />Malaija alekhabu thenga athemgaoho kama athutepsa,
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahsa lam dolla David chilhah-a kisim, I-Pakaiyu Jesu Christa, a Chapa thudol,
  </para>
  <para style="p">
    <verse number="4" style="v" />Thenna lhagao lama vanga chu athi-a kona athodoh kit chun Pathen Chapa chu thunei tah-a atun ahi chu aphongdoh tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chidang namdangte jouse lah-a mi tahsan thua nunsah dinga ama vangle ama min jala lungsetnale solchah mun changa kahitai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho jong amaho lah-a chu Jesu Christa kouna changho nahiuve;
  </para>
  <para style="p">
    <verse number="7" style="v" />Rome'a cheng mithenga kikou Pathen deite jouse hengah, i-Pau Pathen le Pakai Jesu Christa-a konin lungsetna le lungmon nalah uva umjing hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Natahsanu vannoi jouse-a akithan jeh-in, nabon chaova chungah Jesu Christa vangin ka-Pathen kathangvah masan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Katao chanin tang louvin naminu kapha jingin, Achapa Thupha thua lhagaova alhacha kapan Pathen chu ahetoh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tubeh-a hi naheng uva kahungna dingin, Pathen thusah-a phat kijen kom khat kato-a kahungjin teiteina dingin kathum jingjin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nadetna dinguva lhagao lam thilpeh phabep nangho kapeh theina dingun, nangho mu kangah lel lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichu nangho jong keima jong khat tahsana kona khat le khat ikitil khou touva, nangho lah-a lunghalna kanei theina dinga kati ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule sopite, chidang namdangte lah-a katohgim ga kamutah banga nangho lah-a jong kamu theina dinga, tamtahvei naheng uva hung ding kakigotji chu nahet louvu kanompoi, ahivangin tu masangsen eisumo aum jingjin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Greek mitele paomah ham mahte ahin, mithemle mimol ahin, abonchauva kabat ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutichu ahin, nangho Rome khopi-a um chengse jong Kipana Thupha kahil theichan hil dinga kigosa dema umjing kahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Christa Kipana Thupha hi kajachatpi hihhele, ajehchu koi hile atahsan chan chu huhhing na dinga Pathen thahat ahin, amasan Juda mi ahin, chule Greek mi jong ahunghi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh iham itile asunga tahsan le tahsana kona Pathen chonphatna kilanga ahi; hiche thudol chu, Michonpha vang chu atahsan vanga hing ding ahi, tin akisune.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu chonphat louna-a thutah doudal ho, mihemte Pathen ngaisah louna le chonphat louna jouse chunga van'a konin Pathen lunghanna ahung kilangin ahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh chu Pathen lam thudol het theina chu amaho-a akilangnai; ajeh chu Pathen'in hichu ahenguva amusah ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh ham itile leiset semtila pat Pathen athahat kemloule Pathen ahije mutheilou thilteho chu athilsema kihedoh-a, kichentah-a kimu ahi jeh chun, amaho athuphatna dingu aumpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu Pathen lah ahenauvin, Pathen bangin avahchoi pouvin, thang jong athangvahji pouve; athil ngaitou ahomkeo ahin, angol lungu athimtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Akichihsah nau lamah angoljo taove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule kemtheilou Pathen loupina chu, kemthei mihem le alha-a leng vachaho, akeng li nei gamsaho le a-opma kitholtho ganhing limin akhelun, ahou taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche jeh-a chu alah uva atiu ja umloutah-a bol dinga, amaho lunggot lam then louna lama, Pathen'in apehdoh ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amahon Pathen thutah chu jouvin alhengun, chule asempau khelin thilsemjoh ahouvun ajenleuvin ahi. Hiche Sempa chu tonsot geija nunnom jing ahi. Amen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche jeh-a chu Pathen'in amaho jachat umtah huhna lama apehdoh ahitai, anumeiho jongun apenpiu angai monga achonnau apaijun akaleh lamin achonun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Apasal-hou jong angai monga numeitoh achonnau apaijun, huh lama alipmun, pasal le pasal jachat umtah-in akibolun, achon gitlounao chu amahon ati chunguva akisan taovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Alunguva Pathen hetding amaho nom lou ahiuvin, hiche bangtah-a chu Pathen'in jong amaho lung chatvaina lama apehdoh ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amaho chonphat louna jouse; jonthanhoi, engset, papset, mi kisuhmo sah, thangset, toltha, minelnoh, dohabol, doulung poh, kihou lhih adimset nun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Guhthima miseise, mihoutom, Pathen hotlam, chonval, hoitho, kithang-at, chonset thah boldoh, nulepa thua nunglou,
  </para>
  <para style="p">
    <verse number="31" style="v" />Hetna neilou, thutep palkeh, hepina neilou, lhep lung damo, lungsetna neilou ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hitobanga chonho chu athi dinga lom mong ahiuve, hiche Pathen thutansa chu ahena saovin achuti chonun ahi, amaho chang jong hilouvin, chutia chonho chu aphasah-un ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jeh chun, Mi oimo-a pang, vo mihem, koi hile chun nangman jong nadonbutna ding aumpoi; ajeh iham itile nangman mi na-oimona lama nangma themmo kichanbou nahi, ajeh chu mi oimo-a pang, nangmatah jongin chutobang chu naboljin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutobanga chonho chunga chu Pathen'in thutah dungjuija athu-u atan ahi, ti iheuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo mihem, chutobanga chonte oimo-a pang nangman chutobang chu nabolji-a ahile, Pathen thutan na-a chun hoinange, tia nakiginchat mong hinam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ole Pathen phatna-in nalung heina dinga nangma napui chu helouva phatna, lungdehat, khongaisot ahao hi nahsah louva nahim?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nalungtahle lungheilou dungjuija chu, Pathen'in thudih atan ni hung kiphonle alunghan ni-a dinga chu nachunga lunghanna nakikhol khom ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen'in mi jouse atoh dungjui cheh-a asansah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thilpha bola pontho-a lungdesot hatna, loupina, jana, chule kemlou holte chu hin kemlou apeh ding ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Kichangchuna kichamsah, thutah thua nung louva chonphatlou thua nungho vang chu achunguva lungsatle lunghan chua,
  </para>
  <para style="p">
    <verse number="9" style="v" />Setna bol miho jouse lhagao chunga, amasa Juda mi chule abana Greek mite lhagao chunga, hesoh gentheile lungdonna khohtah chu ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thilpha bol chengse vang chun loupina, choi-atna, chule lungmonna kipe ding ahi, Juda mi masan tin chule Greek mi hi ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajeh chu Pathen'in mi dat aneipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu danthu neilouva chonseteho jouse chu danthu beija manghel ding ahiuvin; chule danthu noija chonseteho jouse chu danthua athu kitan ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh iham itile Pathen mitmu-a michonpha ho chu danthu ngaija jaho ahipouve; danthu dungjuija bolteho bouchu chonpha-a kisim ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Danthu neilou chidang namdangte jengbonin, apenpi lungpoh-in danthun anungun, danthu aneilou vangun amahole amaho danthun akisemun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Alung sunguva danthu natoh kisun ahi ti chu atahlangun, hiche ase apha ahetnao chun ahettohsah-un, chule alunggel uva chun themosah ahiloule khat le khat themmo kichan aumsah jiuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheng chu kathupha seiphongle dungjuija, Pathen'in Jesu Christa amanchah-a mihemte guhthim thu atan nikho leh chuti ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma Juda mi-a kisei nahi-a, danthua kinem nahi-a, Pathen'a kisong nahi-a,
  </para>
  <para style="p">
    <verse number="18" style="v" />Alungdei he-a, thilpha chu pha sa-a, danthua kona kihila het neija,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule danthua hetna le thutah umdan neija nakiginchat jeh-a, mitcho ho kaihoile leh muthim lah-a umho salvah-a,
  </para>
  <para style="p">
    <verse number="20" style="v" />Michinglou ho chihsah-a, naosen ho hila nakingaito ahin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuti ahile mihil-a panga nang, nangma jong nachanga kihil jilou nahim? Guchat louna dinga thu hila pang, nangman naguhji hilou ham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Jonthanhoi bol louna dinga thuseija, nangman jon nabolji hilou ham? Milim hou ho-a nangma, nangman milim houna in'a thil nachomji hilou ham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Danthu-a kisong nangman, danthu nasuhkeh-a kona Pathen nahsah mo-a nabolji hilouham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Akisun bang bangin, nangho jeh-in Pathen min chidang namgdangte lah-a taitomin aumin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangma danthua nanunle nacheptan chu phatchomna nanei ding ahin, danthua nanun lou vangle nacheptan chu tan lou ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuti ahi jeh-a chu cheptanlou chun danthua chonphatna thudol chu nit taleh, achep tanlou chu cheptana kisim lou dingham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Apena cheptanlou mong danthu nit soh chun, lekhajem'a thule cheptan dan neija jong danthu sukeh-a nangma, nathemmosah lou dingham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Apolama mi mu-a Juda mi hichu Juda mitah ahipoi, apolam ati chunga cheptan jong chu cheptan ahipoi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Asunggila Juda mi hibou chu Juda mi ahin, chule lekhajem'a hilouva lhagaova lunggil lam cheptanho chu cheptan ahi; ama chu mihem pachat lo-a hilouvin Pathen pachat alojoh ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahile Juda mi hi ipi phachomam? Chule cheptan jong iham aphatna?
  </para>
  <para style="p">
    <verse number="2" style="v" />Imalam jouse-a phachom tah ahi, abulpen chu, Pathen thu chengse amaho kipedoh-a kichinsah anahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khat touvin tahsan hih jongleu i-hiding ham? Amaho tahsan lou chun Pathen tahsan umje hi manlou asochom em?
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuti hihhen; Pathen chu dihtah hihen lang, mi jouse chu ajou hihen; hiche thudol hi, Nangma, nangma thuseija chonpha tia nakisima, Thupitan na-a jong najo theinan, tin akisunin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahivangin ichonphat lounao hin Pathen chonphatna chu akichetsah cheh-a ahile, ipi isei dingu ham? Lunghanga talen peji-a Pathen dihlou ham? (Mihem dan banga kasei ahi).
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti ahipoi, chuti ahile Pathen'in vannoi leiset thupi iti atan dingham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima jousei jeh-a Pathen dihje chu ama loupina khopma letset tah-a akihaphon cheh-a ahile, michonse tia themmo changa iti ka umnah lai dingham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiho neihehset uva, kimkhatnin kasei loubeh-u; phatna ahung umna dingin setna bolu hite, tin aseijuve, tia neingoh-u bangchun, eihonjong hiti chun seiju hite natijiu hilouham? Chutobang thusei ho themmo achanu chu dihtah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuti ahile, keiho Juda mi hi midang sanga phajo kahiuvem? Iti nama jongle kaphajo pouve. Ajehchu Juda mi chule Greek mi abona chonset noija um cheh ahi, tia kahilchah sa cheh-u ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiti jong hin akisune, Chonpha koima aumpoi, khatcha jong aumpoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Koima ahetoh thema aumpoi, Koima Pathen hola aumpoi,
  </para>
  <para style="p">
    <verse number="12" style="v" />Lam hilouva akihei sohkei taovin, abon chaovin manlou asohgam taove. Apha lama chona aumpoi, khatcha jong aumpoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Alol homu lhan kihong ahin; Aleijun lheplhahna thu jeng aseijun, Anel noijuvah gulse gu aumin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Akam sungula sapsetna le thugilouvin adimin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Akengu thisona ding lamah ajangin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Alampi jouseu-ah man naleh hesohna aumin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Lungmonna lampi aheta pouve;
  </para>
  <para style="p">
    <verse number="18" style="v" />Amitmuvah Pathen gin aumpoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi jouse kam binna dingle vannoi leiset pumpi Pathen thutana-a aum theina dinguva, danthun asei chengse hi danthu thua nungho jah-a kisei ahi, ti iheuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Danthu juija thilbola mi koima a-angsunga them changa umlou ding ahi, ajehchu danthua kona chonsetna kihedoh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin tu vangin danthua hilouhelin, danthule themgaoho thuhetsah Pathen chonphatna chu akilang dohtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuche Pathen'a kon chonphatna chu Jesu Khrista tahsan vanga mijousele atahsante jouse chunga kilanga ahi: koima imachom aumpoi:
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajeh chu mi jouse hi chonsea ahitan, Pathen loupina chu changlela ahiuve;
  </para>
  <para style="p">
    <verse number="24" style="v" />Khrista Jesu'a kilhatdohna aum jeh-a, Pathen lungset vanga chonphat moh chonbou ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathen'in alungdesot vanga masanga chonsetna kichaisaho talen pelouva aum jeh-in, achonphat vetsahna dinga tahsan vanga athisan chu kithoidamna hidinga apehdoh ahin;
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama chonpha ahina dingle, Jesu tahsan chan chu chonpha-a asim theina dinga, tulaija hi achonphatna avetsah ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuti ahile kisonna hoithona hoibaham? Kinotdoh-a ahitai. Itobang danthua ham? Danthu juija natoh naham? Ahipoi, tahsanna danthu-a joh ahibouve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuti ahi jeh chun danthu juija natoh vang hilouva, tahsan vanga mi chonpha kisim ahi, tia kangaitou ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathen chu Juda mite changseh Pathen ham? Chidang namdangte Pathen jong hilou ham? Chidang namdang te-a jong ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin Pathen khatseh ahi jeh chun, cheptanho chu tahsana kona chonpha asima, chule cheptan louho chu tahsan vanga chonpha asim ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuti ahile itahsan jeh uva hi danthu kisumanga ham? Ahipoi; danthu kiphudetjoh ahibouve.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahile tahsa lama ipuluiju Abraham'in amu chu ipi isei dingu ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh iham itile ama chu natoh vanga chonpha kisim ahile kisonna anei ahi, ahinla Pathen lamah aneipon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu Pathen lekhabun ipi aseijem? Abraham'in Pathen atahsan jal-in atahsan chu ama dingin chonphatnin akisimtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Natongte sum san hi lungsetman kiti louvin, asan ding abatnin akiseijon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla Pathen helou natoh beija chonpha chansahpa tahsana chu, atahsan chu chonphatna kisima ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Natong louva Pathen'in michon pha-a asimho chu phatthei achan dingjeu chu, David'in jong aseijin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Asuhkhelnau kingaidama, Chule achonsetna kikhu khumho chu anun nomui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin achonsetna asimlou dingpa chu anun nome, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuti ahile chuche phattheina chu cheptante chung jenga ham, cheptan louho chunga jongham? Ajeh chu eihon Abraham atahsan chu ama dinga chonphatna-a kisim ahitai, itiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Achutile iti aum petna chonpha kisim ham? Acheptan jouha, cheptan louva aum laija ham? Cheptana aum jou hilouvin, cheptan louva aum lai ahi:
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule cheptan louva uma atahsanho jouse pa ahi theina dingle, amaho dinga chu chonphatna-a akisim theina dinga, chule cheptan jeng jong hilouva ipuluiju Abraham cheptan louva aum laija atahsan chu,
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche tahsan nungjuija cheptanho pa jong ahi theina dinga, cheptan louva uma tahsan vanga chonphat chu hetna-a melchih na-a cheptan chu amu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu Abraham le achilhah chu, vannoi goulo ding ahi tia thutep chu danthua kon hilouvin, tahsana kona chonphat vanga joh ahibouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh iham itile danthua kona chonpha kisimhon alouva ahile, tahsan chu ahomkeo ahitai, chule thutep jong chu pannabei ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu danthun lunghan akonsah ahi; danthu beina-a chun suhkhel jong aumpoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh-a chu lungsetna-a ahi theina-a, danthu noija umho chang jeng hilouva Abraham tahsan noija um achilhahte jousen, hiche thutep alo dingu chu adet theina dinga, amahon alo dingu chu tahsan vanga alo dingu ahibouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mithiho hinsah theija, aum louho auma banga kou Pathen, Abraham'in atahsan chu, ama angsunga Abraham chu ibon chaova ikonnao ipuluiju ahi; chule hitin jong akisune, Keiman nangma vai tamtah kona puluija kasem ahitai, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule kiholna neilou ahivangin, nachilhah hijatpi khu hi ding ahi tia, asei thucheng dungjuija, khonungle vai tamtah pului ahung hi ding chu kiholin atahsanin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule kum jakhat jen alhina, athisa tobang atahsa le Sarah chin jong chu ngaiton, atahsan daideh louhelin aumin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathen thutep chu tahsan lellin aumpon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen'in athutep chu bol jong bol thei ahi ti ahechenin, Pathen avahchoijin atahsan ahat chehjotan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche jeh-a chu atahsan chu ama dinga chonphatna kisima ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tahsan chu ama ding jenga chonphatna-a kisima kisun ahipoi; eiho dinga jong kisun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakai Jesu Khrista athia kona kaithoupa tahsana eiho, eiho dinga jong chonphatna-a kisim ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiche Jesu chu eiho suhkhel jeh-a kipedoh ahitai; chule eiho chonpha ikisimna dinguva kaithouva uma ahitai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahin tahsan vanga eiho chonpha kisim ihitah jeh-un, I-Pakaiyu Jesu Christa vanga Pathen toh kichamdela um ihitaove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujongle ama vanga chu hiche lungsetna idin detnaova hi tahsan vanga lut ihitaove, chule Pathen loupina-a chu kinema kipah jinga um ihitaove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule chuti jengseh hilouvin, hesohna chun thohhat asosahji ihetbangun, ihesoh gentheinao jenga jong iloupi jiuve;
  </para>
  <para style="p">
    <verse number="4" style="v" />Thohhat chun aphat photchena asosahjin, photchena chun kinepna asosahjin ahi, ti iheuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hiche kinepna chun eijumso pouve, ajeh chu eipeh-u Lhagao Theng vanga chu ilung sunguva Pathen ngailutna long lut ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ihatmo laijuvin aphatchan michonseho khelin anathitan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Michonpha chung changah koima pouvin ahinna tohponte; mipha chungchanga ahinna toh ngam jong mi khattou umkhat nante.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin Pathen'in eingailutnau photchena eimusah-un ahi; ajeh iham itile eiho chonsetna i-um laitah-un Christa eiho khelin athitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuti ahi jeh chun eiho tun, Christa thisan vanga chonpha kisim ihitah jeh-u chun, achungchona ama vanga Pathen lunghan na-a kona huhhing-a umtei ding ihiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu adouva ipan laitah uva Pathen Chapa thi chun Pathen toh eisuhchamu ahitah-a ahile, akicham jeh-a chu achungchona ama hinna vanga huhhing-a umtei ding ihiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuti jeng jong hilouvin, tun Pathen toh eisuhcham uva, I-Pakaiyu Jesu Christa vanga Pathen'a pa jong ikipao ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiti chu ahin, mi khat jeh-a vannoi'a chonset lut, chule chonset jeh-a thina lut ahi; chutima chu mi jouse chonset jeh-a thina chu mi jouse chunga lhungsoh ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu danthu kipeh masang peh-a chu vannoi leisetna chonset anaumsa ahin; ahivangin danthu um louna-a chu chonset jong kisim lou ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin Adam'a pat Mosi geijin Adam suhkhel banga sukhel louho chunga jong, thina chun vai analosa ahi. Adam chu ahung dingpa lim banga um ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin manbeija thilpeh chu suhkhela toh kibang ahipoi; ajeh chu mi khat suhkhel jeh-a midang jouse athia ahile, achungchon cheh-a Pathen lungset le mi khat, Jesu Christa lungset vanga thilpeh chu mi tamtah chunga letsetna chua ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule thilpeh chu, achonsea mi khat jeh-a chutoh akibangpoi; ajeh chu mi khatna kona chu themmo channa lama thu kitan ahin, manbeija thilpeh vang chu suhkhelna tamtah-a kona them changa kisima ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu mi khat suhkhel jeh-a, mi khat vanga chu thina-in vai alotah-a ahile, lungsetna le chonphat thilpeh letset changho chu achungchon cheh-a, mi khat, Jesu Christa vanga hinna-a vai alo dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutichu ahin suhkhelna khat jeh-a mi jouse themmo chansahna thutana um ahi; chutima chu chonphatna thilbol khat vanga hinna lama them chansahna manbeija thilpeh chu mi jouse chunga hung uma ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh chu mikhatnin thupeh apallhah jeh-a mi tamtah chonse kisosah ahitan; chutima chu mikhatnin thupeh anit jeh-a chu mi tamtah chonpha kiso ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang suhkhel punna dinga danthu hung lutbe ahi. Ahinla chonset punna chana chu lungsetna hapun cheh-a ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutia chu chonsetnin thina-a vai alo bangtah-a chu, I-Pakaiyu Jesu Christa vanga tonsot hinkemlou geija dinga chonphat vanga lungsetna-in vai alo theina ding ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Achutile ipi isei dingu hitam? Lungsetna apun chehna dinga ichonset jing dingu ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutiponte! chonset lama athisa eiho, chonsetna iti ihin jing nahlai dingu ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Eiho Christa Jesu'a baptize chang chengse hi athina-a baptize changa ihiu hi nahet lou uham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche jeh-a chu Pa loupina vanga Christa athi lah-a kona akaithou banga chu, eiho jong hinkho thah lam chu ijot theina dinguva, baptize chana hi athina-a amatoh kivuitha-a ihi taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu ama thi lim banga ithiuva amatoh thikhom ihiule, atho kit lim banga jong itho kit dingu ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu nung kalsea eiho chonset soh-a i-um louna dinguva, chonset po tahsapum suhmanga aum theina dinga, imi luiju chu amatoh thingpel'a kikhetbeh tha-a ahitai, ti chu iheuve;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh ham itile athia chu chonsetna kona ongthola ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule eiho Christa toh ithiu ahitah-a ahile, amatoh ihin dingu jong ahi, ti chu itahsan un ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu athi lah-a kona kikaithou Christa chu imatihchanna thi lou ding ahi, thina-in achungah thu aneitapoi, ti iheuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Athi chu chonset lama tonsot geija dinga khatvei thia ahitai; ahin vang chu Pathen lama hinga ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche bang chun nangho jong chonsetna lamah athisan kigel unlang, I-Pakaiyu Jesu Christa jal-in Pathen lamah ahingin kigelun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun natahsa lung got lama chonna dingin, natahsa thithei chunga chun chonset vaipohsah hihhelun.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujongle natibah chengseu chonphat louna manchah-in chonsetna lamah pedoh hihhelun, ahin athi lah-a kona hingdoh kahi tin, Pathen'ah kipeuvin, natibah chengseu jong chu chonphatna manchah din Pathen'ah pedoh jovin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu chonset chun nachung uva thu neitalou ding ahi, ijeh ham itile danthu noija um nahitapouvin, lungsetna noija umjoh nahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Iti tantem ahile? Danthu noija um louva lungsetna noija um ihi jeh uva chu, ichonset dinguham? Chutiponte.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koi heng koi heng hijongle athua nung dinga asoh-a nalutna chu; thina dinga chonsetna lam hijongle, chonphatna dinga thua nunna hijongle, athua naumpa soh chu nahi, hichu nahet louvu ham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Masangin nangho chonset soh nanahiu ahin, ahivangin lunggiltah-a chutobang thu kihil chu nit dinga kipedoh-a athu noija um nahitaovin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule chonsetna kona kichoidoh-a chonphat soh nahiu ahitan, hiche jeh chun Pathen thangvah-in umhen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Natahsa pheu hatmo jeh-a keiman mihem thu banga kasei ahi; ajeh chu nanghon masang laija natibah chengu then louna dinga chonset chunga chonsetna lama soh banga napehdoh jiu ahin, hiche bangtah chun tun natibah chengseu chu thenna dingin chonphatna lamah soh bangin pedoh jengun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangho chonset soh nahi laijun chonphatna lam dola onga nahiuvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichu ahin tu-a najachat piu thulam dola hi hiche laija chu aga ipi namuji uvem? Ajeh chu hitiho chu achaina thina ahibouve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tu vangin nangho chonsetna kona onga Pathen soh nahitah jeh-un, thenna lamah ga naneitaove, chule aleh chu tonsot hin kemlou ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ijeh ham itile chonset man thina ahi, Pathen thil mohpeh vanghi Pakai Christa Jesu vanga tonsot hinna ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ole sopite, mihem ahinlai chansebovin danthun achungah thu aneije, ti nahet louvu ham? Danthu themho kahouna ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Numei jineija chu a-inneipu ahinlai chansea danthun a-inneipu toh akanbeh jing ahin, ajipa athi vangle, a-inneipu danthua kona chu ongdoh jia ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuti ahi jeh chun a-inneipu hinpetnin midang ji hitahen hile, chutengle amanu chu ajonga kiti ding ahi. A-inneipu thi teng vangle, danthua kona onga ahitan, pasal dang ji hijongle ajonga hita lou ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho chungchang thua jong chutima chu ahi, sopite, Pathen lama iga theina dingule achom khat, athi lah-a kona thoudohpa-a nahi theina dinguva, Christa tahsa vanga danthu lama thisah-a um nahitaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu tahsaphe-a i-um laiseu chun danthua kona chonsetna lama chalohna chun thina lama iga theina dinguva, itibah chunguva na anatohji ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin tu vangin lekhajem luija hilouva, lhagao thah-a ijen theina dinguva ithiuva, eikituhnao danthua kona kilhadoh ihiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Achutile ipi isei dinguham? Danthu hi chonsetna ham? Ahipoi; chonset chu ipi ahi anahe lou kahi, danthua kona kahetdoh ahibouve; ajeh chu, Papset bol hih-in, ti hi danthun asei lou hile, ipi ahi kanahet lou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla chonset chun agomkomcha atohkhan, chuche thupeh-a kon chun kalunga papset imajouse asosahtan ahi; ajeh chu danthu beija chonset chu athi ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Masanglai chun danthu um louva anahing jing kahin, chuche thupeh ahung um phat chun chonset chu ahingdoh kitnin keima kathitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hinna dinga thupeh chu thinajoh-in kananeitan ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijeh ham itile chonset chun agomkomcha atokhahjia, thupeh-a chu eilheplhah-a, hiche chun eitha ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichu ahin danthu athenge, thupeh jong athenge, adih lheh jengin aphai;
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahile apha chu keima dinga thina mongham? Ahipoi. Apha chu amanchah-a chonset chun kachunga thina asodoh-a kona chu, hichu chonset ahi tia akiphon dohna dinga chule thupeh vanga chonset chu setna chungnung tah ahi chu, akichetna dinga chonset jeh joh-a ahibouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu danthu chu lhagao lam thil ahi ti iheuve, keima vang tahsa lam mi chonset soh-a kijoh-a kahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu keiman ipi kaboldoh kahepoi, ajeh iham itile kalunggot lou lam jeng kaboljin; kahot lam jengbou kabol jin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kalunggot lou lam kabola ahile, danthu chu apha ahi tia oija kahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin tun abola keima hita louva keija cheng chonset chun abol ahitabouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu keima sunga kasa chunga hin phat achengpoi, ti kahei, ajeh chu lunggotna vang chu aumin thilpha boldoh najohbou umlou ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh iham itile apha kalunggot lam chu kaboljipon, aphalou kalunggot lou lambou chun kachon jingjitan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kalunggot lou lam kabolji ahile, abola chu keima hilouva keija um chonsetjoh chu ahibouve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichun thilpha bol kagot komle, setna chu kakoma ahung umjin, hiche umdanje hi kahetan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kami sungnungin Pathen danthua kathanom lhehji nan,
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahivangin kalung lam danthu douva katibah chunga um, chonset danthu, soh-a eipui lutji-a katibah chunga hin danthu chom khat aum kamujin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ohe! mi gentheitah chu kanahi! Hiche thina tahsa-a kon hin koijin eihuhdoh tantem?
  </para>
  <para style="p">
    <verse number="25" style="v" />I-Pakaiyu Jesu Christa vangin Pathen kathangvah-e. Chutichu ahi jeh-a keiman kalungtah-a Pathen danthu noija kauma, kasa-a chonset danthu soh na katoh ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun tuvangin, Christa Jesu'a umho, tahsa thua chonlouva lhagao thua chonho dinga themmo channa himhim umlou ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ijeh ham itile Christa Jesu'a um hinna Lhagao danthu chun chonsetle, thina danthua kona eilhatdoh-a onga kahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu tahsaphen asuh hatmo jeh-a danthun abol joulou chu, Pathen'in Achapa chu chonset jeh-a chonset po tahsaphe lim pu-a ahinsola; tahsaphe-a chonsetna chu themmo achan ahitan,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichu tahsaphe lam hilouva Lhagao lama chon eiho chunga, danthun angeh chonphatna chu aguilhun theina ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh iham itile tahsaphe lam dana chonteho chun tahsaphe lam thudol agelun; Lhagao lam dana chonho chun Lhagao lam thudol bou agelun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahsa lam lunggel chu thina ahin, Lhagao lam lunggel chu hinna le lungmonna ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu tahsa lam lunggel chu Pathen toh kidou ahi; ajehchu Pathen danthu noija um ahipon, umjong umthei louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun tahsa lama chonho chun Pathen alunglhai theipouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen Lhagao nasunguva achen vangle, tahsa lama chon hilouva Lhagao lama chon nahiu ahi. Christa Lhagao neilou vang chu Christa-a ahipoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Christa chu nangho sunga auma ahile, chonset vanga tahsa chu athia ahin, lhagao vang chu chonphat vanga hinna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule athi lah-a kona Jesu kaithoupa Lhagao chu nangho sunga achenle, Christa Jesu mithi lah-a kona kaithoupa tah chun nangho sunga cheng ama lhagao vanga chu, natahsao thi thei jong chu ahinsah ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun, sopite, eihon bat ineijuve, amavang tahsa henga, tahsa lama chonna dinga neija ihipouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu nangho tahsa lam dana nachonule, iti jongle nathi tei dingu ahi; Lhagaova tahsa natoh chengse chu natha vangule, nahin dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu Pathen Lhagao kaihoija umho chengse chu, Pathen chate ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh iham itile kichat kitna dinga sohchana lhagao hilouva, cha hina lhagao changjoh nahibouvui; hiche lhagao vanga chu, Abba, Hepa, tia ikoujiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lhagao chun amatah-in eiho lhagaotoh kitho-a Pathen chate ihiu eihetsah-u ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule chate ihiule gou lo ding ihiuvin, Pathen gou lo ding, chule Christa toh lo khom ding ihiuve; amatoh ithoh khomule, amatoh choi-atna iumkhom dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tulaija ithohnao hi khonunga ichan dingu loupina hung kilang ding chutoh kikot hoi themin kangaito poi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thilsem chengse kinem ngui nguitah-a Pathen chate hung kilah ding chu angalel lheh jengu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh ham itile thilsem chengse ahomkeo thu noija aumu hi ama chama um ahipoi, kinepna-a aumsahpa thusah-a um ahibouvui.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu thilsem chengse hin amahotah jong kemthei soh-a auma kona lhadoh-a aumuva, Pathen chate loupitah-a noma alenaova chu alut diu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin tugei hin thilsem jouse naosonat thoh banga gim thoh-a peng penga umkhom ahi ti iheuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaho jengseh ahipoi, Lhagao ga masa changa eihotah jeng jong, cha hina, itahsao lhatdoh-a umding chu ngah jinga, ilung sungu peng penga um ihiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajeh chu kinepna in eihuhhingu ahin; ahinla mu-a kinep chu kinep ahipoi; ajehchu mihemin amusa chu ipi dinga akineppi nahlai ding ham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Mu louva kinem ihiu vangle, lungdet tah-a ngah jinga ihiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutichun Lhagao jongin ihatmonauvah eikaihoijun eihu jingjiuve; ajeh chu eihon adol lamtah-a ipi-a dinga itao diuham ihepouve; ahivangin Lhagaovin eiho dingin seidoh thei louvin peng pengin eitaopeh jiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Pathen lunglam doltah-a mithengte dinga ataopeh jeh chun, lungthimgil kholtoh-a Pathen chun Lhagao lunglam chu ahejin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin Pathen ngailuho chengse, ama lunggot lam doltah-a kikouho ding vang chun, thiljouse hin aphat nadingu atongkhom sohkeije, ti chu iheuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ijeh ham itile sopihon tamtah lah-a Pathen Chapa chu apeng masapen ahina dinga, Pathen'in ahet masah ho chu Achapa lim banga agot masahsa ahitai;
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule agot masahsaho chu kou jong akou ahi; chule akouho chu them jong achansah ahitai: chule them achansahho chu choi jong achoi-at ahitai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuti ahile hicheng thua hi ipi isei dingu ham? Pathen eiho lama apanle, koiham eidou thei dinguva?
  </para>
  <para style="p">
    <verse number="32" style="v" />Achapa khen louhela eiho jouse dinga pedoh jengpa chun, eiho lungset mana ama chutoh thakhatna ijakai eipeh khom lou dingu ham?
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathen lhenchomteho chu koiham ahehse dinga? Them chansah-a Pathen ahibouve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Themmo chansah-a koiham? Athia, achungchon cheh-a athi lah-a kona kaithouva um Christa chu ahi; ama Pathen jet lama atouvin eiho dingin eitaopeh jinguve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Christa ngailutna-a kona koiham eikhen dinguva? Hesoh gentheile, lungdonna, bolsetna, gilkel, pon beija um, settona, chemjam, hicheng chun eikhen thei dingham?
  </para>
  <para style="p">
    <verse number="36" style="v" />Hiche dol jong hi akisune, Keiho nangma jeh-in nilhum keijin eikithat jingui; Tha dinga kigo kelngoi bangin eikisim taove.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahinla eingailupau vangin hicheng thua hin eiho galjou sanga galjou ihiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ajeh chu I-Pakaiyu Christa Jesu'a um Pathen ngailutna kon chun thina ahin, hinna ahin, vantil ahin, vaipo pipu ahin, thuneina ahin, tulai thudol le khonung ding thu ahin,
  </para>
  <para style="p">
    <verse number="39" style="v" />Chungsang ahin, noilam thuhtah hijongle, thilsem adang imachan eikhen thei lou dingu ahi, tia dettah-a katahsan ahitai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiman Christa-a thutahbeh kasei ahi, kajoupoi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Kalunga lunghesohna nasatahle thohlel tang louhela aum hi, ase apha kahetna kalungin Lhagao Thengah eihettohpin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu keimatah-in tahsa lama kanam mite, kasopite khela Christa-a kona manna lama dinga sedoh-a uma, sapset lhunna-a umhel jeng ding kanagot ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israelte ahiuvin; cha hina chu amauva ahin, loupina, thulhun jouse, danthu peh, Pathen houna, chule thutep jouse la amaho-a ahin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Pute pate jong amaho-a bou ahin, tahsaphe lama Christa jongla amaho lah-a kon ahibouvin, ama chu imajouse chunga chungnung pen Pathen ahin, akhang akhanga pachat tohtah ahi. Amen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin Pathen thu chu imacha hilouva um ahipoi. Ajeh chu Israel lah-a kon jouse Israel ahipoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Abraham chilhah ahisohkei vangun aboncha keijun achate ahipouve; Isaac'a kona bou nachilhah tia kisei ding ahi, tia asei ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichu hiti hi ahi, tahsa-a chate chu Pathen chate ahipoi; thutep chatebou chu chilhah tia kisim ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thutep chu hiche hi ahi, Hiti phattah hile kahung ding ahin, chutengle Sara'in chapa khat ahin ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chucheng jeng ahipoi, ahin Rebecca jong chu mi khatna kona, ipuluiju Isaac'a kona agai laijin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Achateni so masangin chule apha ase imacha abol masangin, toh vanga hilouva akoupa lunglam le Pathen'in alhen dungjuija, lunggotsa chu adetna dinga,
  </para>
  <para style="p">
    <verse number="12" style="v" />Amanu jah-a, A-upajo chun anaopa soh na atoh ding ahi, tia kiseija anahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche thudola hin, Keiman Jacob kana ngailun, Esau vang kanahot ahi, tin akisune.
  </para>
  <para style="p">
    <verse number="14" style="v" />Achutile ipi isei dingu ham? Pathen'ah chonphat louna aume iti dingu ham? Ahipoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman Mosi jah-a, Keiman kalungsetpa chu lungset ningting, kahepipa chu kahepi ding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuti ahi jeh chun hiche hi alunga tuppa vang jong hilouva, adelpa vang jong hilouva, alungsetpa Pathen vanga konjoh ahibouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen lekhabu thun Pharaoh jah-a, Nachunga kathilbol theina kavetsah theina dingle, vannoi leisetna kamin kiphon jalna ding monga nangma katundoh nahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutichu ahin Pathen'in ahepi nomchan ahepijia, alunggot chan chu alung asuhtahji ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichea hin nangman kei jah-a, Achutile ibola eithem mosah jiham, neitin nate. Ajeh chu alunggot chu koiham akham theija?
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahipoi, vo mihem, Pathen douna-a donbut nang koi nahim? Thilsem chun asempa jah-a, Ibola hitia neisem ham, tintem?
  </para>
  <para style="p">
    <verse number="21" style="v" />Bellei lhang khatna bel khat lutah-a dena, khat lulouva den ding, abel lei chunga chu beldengpan thu anei hilouham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin, Pathen'in alungsat vetsahnale athil bolthei hetsahna ding lung ngaito-a, mangthah dinga gotsa um lungsatna belho chunga alung adesotle;
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule loupi nikho-a dinga masanga patna agotsa, ahepi belho chunga aloupina hao chu hetsah dinga,
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman eiho jengjong, Juda lah-a kon jengseh hilouva, chidang namdangte lah-a kon jonga eikouvu hilouham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutobang chun Hosea lekhabua, Kamite hikhalouho chu keiman kamite kati ding, kadeilounu chu kadeinu kati ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangho keima mite nahipouve tia ajah uva kiseina laitah-a chu, Amaho Pathen hing chate kiti ding ahiuve, tia kisei bang chu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israelte thudol Isaiah'in asamlen, Israel chate twikhanglen kama neldi jatnin tam jongleu, amoh thembou sohcha ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu aman natoh chu achaija chule chonphatna-a phat asuh chom ding ahi; ajehchu Pakaiyin leisetna hi chomcha khat bou na atoh ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiche thudol hi Isaiah'in masangin aseije, Janel Pakaiyin chikhai ding einakhen louvu hile, Sodom dung isun diu ahin, Gomorrah toh ibah dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Achutile ipi isei dingu ham? Chonphatna del louhel chidang namdang ten chonphatna chu aphah-u ahitai; hichu tahsan vanga chonphatna ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahin Chonphatna danthu dela Israel ten, hiche chonphatna dan chu aphajou pouve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ijeh ham? amahon tahsana hollouva, dan thilbolla ahol jeh-u ahi. Kipal lhuhna songa kipal lhu-a ahitaove.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiche thudol jong hi akisune, Veuvin, keiman Sion'ah kipalna song le lung lhahna songpi kakoije; koihile ama tahsan chan chu jachatna-a chulou ding ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sopite, lunga kagotle Israelte dia Pathen henga katao nomna chu, huhhing-a ahung umtheina dingu hi, ahipene.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen lama agunchuve ti chu keiman kahetsah ahi; ahivangin hichu hetna neija gunchu ahipoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu amahon Pathen chonphatna ahetlou jeh-ule, amaho chonphatna phudoh ding agot jeh-un, Pathen chonphat na-ah alut tapouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Christa chu atahsan jouse dinga, chonphatna amu theina dinguva danthu chaina ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Mosi'n chonphatna danthu anahilchet na-a, chonphatna nitpa bou chuche achonphat vanga chu hing ding ahi, anatin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahsana chonphat vang chun hitin aseije, Nangman nalung thimin, Koiham van'a kal ding? (hichu Christa gapuilhah ding aseina ahi);
  </para>
  <para style="p">
    <verse number="7" style="v" />ahiloule, Koiham lei onga kumlha ding? (hichu athi lah-a kona Christa kaithou ding aseina ahi), ti hih-in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin ipi aseijem? hiche thu chu nakomah aume, nakam sungle nalung sungah aume; (hichu kasei phongleu tahsan thu chu ahi).
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitia chu nangman nakama Pakai Jesu chu naphon doha, chule Pathen nin ama chu athilah-a konin akaithouve ti nalunga natahsan le, asohcha ding nahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu chonphatna dinga lunga tahsan ahin, sochatna dinga kama phondoh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen lekhabu thun, Koi hileh ama tahsan chan chu jachatna-a chulou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijeh-inem itile Juda mitele Greek mite chu imacha chom ahipouve; abonchauva chungah Pakai khatsehbou aume, ahenga tao jouse dinga phatna haotah ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koi hile Pakai mina tao chan chu huhhing-a umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Achutile atahsan louvu chu iti akou dinguham? Athu ajahkhah louvu chu iti atahsan dinguham? Thusei phongle beija iti ajah dinguham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule akisol louvule iti asei phongle dinguham? hitijong hin akisune, chamna kipana thupha seiphong leho, thilphaho thudola kipana thu poleho keng iti hoi hitam!
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin mi jousen Kipana Thupha angaipouve. Ajeh chu Isaiah'in jong, Pakai, kathuphonle-u koiham atahsana, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti ahijeh chun, jah-a kona tahsan umdoh, chule jah chu Pathen thua kona hung umdoh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahileh amahon ajah lou uham? Ajanauve. A-awginu gamtina athangin, Chule athu uvin kolkimvel achansoh tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivanga kasei ahi, Israel miten ahetlou uham? Amasan Mosi'n aseijin, Keiman nangho vai neilou vai khat thangset sah-uving ting, Lungthim neilou vai khatna kona kalunghansah ding nahiuve, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isaiah'in jong hakattah-in aseijin, Eihol louten eimudoh-un, Eidong loute hengah kakiphongtai, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin Israel jah-a, thua nungloute le nel hatte chunga kakhut kajah nilhum keije, tin aseije.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Achutile Pathen'in amite chu apailhah hitam? Ahipoi. Ajeh chu kei jong Abraham chilhah-a Benjamin phunga Israel mi khat kahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen'in ahet masatsa amite chu apailhapoi. Pathen lekhabu thun Elijah thu asei hi nahet lou uham? Aman Israelte chungchang thu Pathen henga alhutnin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai, amahon nangma themgaoho athatgamun, nang houna maicham asuchimun, keima changseh kaumtai, kei jong tha dingin eitup jingui, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin Pathen'in adonbutna chu ipi aseijem? Keiman keija dingin Baal anga dilsu louhel mi sangsagi kakikhen nai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutobangma chun tulaijin jong lungsetna kilheng amoh moh aumnai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amavang hichu lungset man ahile, thilbol vanga ahipoi; chuti ahiloule lungsetna hi lungsetna hita lou ahi. Ahinla, hichu natoh vang ahile lungset vang ahitapoi, chuti ahiloule natoh hi natoh hitalou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Iti hitante ahile? Israel miten aholu chu amu louvu ahin, Pathen lhentehon bou amu ahi; adang chengse chu alung tahcheh taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen lekhabua hitin akisune, Pathen'in tuni gei hin amaho khu imutsetna lhagao apen, amu thei louna dingun mit apen, jah thei louna nakhang apen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />David jongin, A-an nehnao dokhang chu amaho dingin thangle pel hihen, Chule akipalnao le akiditnao hihen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amu mona dingun amitnu thimhen, Chule nangman atingu bonsah jingin, tin aseijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman, ahile alhuhna dinguva kipala hiuvam, kati. Ahinaisaipoi. Amavang amaho thangset sahna dinga, amaho suhkhel vanga chu chidang namdangte dinga sochatna ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amaho suhkhel chu vannoi'in haona-a aneija, chule amaho hakam chu chidang namdang ten haona-a aneija ahile, abulhin nau chu chusanga ijatna chungnung cheh ding hitam!
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman chidang namdang mi nangho jah-a kasei ahi, keima chidang namdangte dinga solchah-a kapan jeh hin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijem tia kanam chanpite kathangsetsah-a alah uva abang bang asochat theina dingun katin, lhacha kapana hi kaloupisah lheh jeng ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu amaho kipaidoh vannoi'in kichamna-a aneija ahile, amaho kilah kit chu athia kona hinna ding tailou, adang ipi hi dingham?
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule changbong lum amasa athena ahile, changlhah tum jouse apumpia atheng ahi; chule ajung athenle, abah chengse jong athenga ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla abah abang bang akiheboh-a ahile, nangho gam olive bou nahiuvin, abah lah-a kijoma nahiuve, Olive thingphung ajunga kona phattheina changkha nahitah-a nahile,
  </para>
  <para style="p">
    <verse number="18" style="v" />Abahho chungah kithang-at hih-in. Kithang-at jongle chun, ajung vah-a nang nahipoi, ajungbou chun nang navahjoh ahibouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichea hin nangman, Keima kijopna dinga abahho kisubonga ahitai, tin nate.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aphai, atahsan lou jeh-a hicheho chu kisubonga ahin, nangma natahsan jala nadindet ahi. Hoitho hih-in, kichajon;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu Pathen'in abah tahbeh bon akhen loule, nangma jong khenpon nate.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuti ahi jeh chun Pathen phatjele lungkhohje chu veuvin; alhuho dinga chu lungkhoh tah ahin, nangma ding vanga phatah ahi. Aphatna-ah um jingin, achuti loule nang jong naki satlha ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaho chu tahsan louva aum jing louvule, kijom kit ding ahiuve, Pathen'in amaho chu ajop kit thei ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajeh iham itile apena patna gam Olive phunga kona kisatlha-a nangma, angai louva Olive phung phatoh kijop nahile, apena patna abah tahbeh ho chu olive toh iti kiha jopmat cheh ding hitam!
  </para>
  <para style="p">
    <verse number="25" style="v" />Sopite, hiche thuguh hi helouva naum dingu kanompoi, ajole hung kichihsah khauvinate; chidang namdangte akimsoh kahse-a Israel mite kimkhat chunga lungtahna chua ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutichu ahin Israelte jouse huhhing-a um cheh ding ahi. Hiche thudol hi, Sion'a kona Huhhing-a hung ding ahin, chule Aman Jacob phunga kona Pathen ngaisah louna asuhmang ding ahi,
  </para>
  <para style="p">
    <verse number="27" style="v" />Achonsetnao kalahmang tengle, Hiche hi amahotoh kakitepnao hi ding ahi, tin akisune.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kipana Thupha thudola amaho khu nangho jala melmate ahiuvin, lhenchom lam thudola apu apateu jala deitahte ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ijeh ham itile Pathen'in manbeija athilpehho le akouho chu akhelkit theihoi ahipoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Masangin Pathen thua nunglou nahiuvin, tu vangin amaho louchal jeh-a lungsetna mu-a nahitaove.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule chutobangma chu amahon jong, lungsetna namu jaluva hi lungsetna amu theina dinguva, tu-a louchala ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ijeh ham itile Pathen'in mi jouse alungset theina dinga thua nunlou na-a akhumchah ahitai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathen chihna le hetna haoje hi athuh lheh jenge! Avaihom athutan hetphah hoi ahipoi, chule alampiho holdoh theihoi ahipoi!
  </para>
  <para style="p">
    <verse number="34" style="v" />Ajeh chu Pakai lungthim chu koiham ahea? Chujongle lungthim pe-a anapanga koiham?
  </para>
  <para style="p">
    <verse number="35" style="v" />Alepeh kit dinga thilpha anape masa koiham?
  </para>
  <para style="p">
    <verse number="36" style="v" />Ajeh chu ama-a konle, ama vanga, chule ama dinga thil jouse ana uma ahi. Loupina jouse atonsot geijin ama-a hi jinghen. Amen.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahi jeh chun, sopite, Pathen lungset vang hin natipum piu chu longlhen thengtah gan kihinglha bangin Pathen lah thei doltah-in Pathen'ah kipeuvin tia kangeh nahiuve, hichu natoh dinguva kilom tah chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nangho tulai vannoi leiset chon hin chon hih-un; Pathen lungdeilam, hichu apha, lah theile phat chamkim hi ipi ahi nahetdoh theina dingun, lung thah keng-unlang lim chom puvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun eipeh lungsetna vang hin nalah uva mi chengse jah-a kasei ahi, agel dingdol kalvalin koiman kalena ti gel hihhen, amavang Pathen'in apeh kham kham tahsanna dungjuijin kituptah-in ngaito henlang lung geltohhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tipum khatnah tibah tamtah ineijui, tibah jouse thakhat ahipoi, apanna akibangpon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hibang chun eiho jong tamtah ihiuvin, Christa-a ti khat ihiuve; khat chu khat tibah ihi cheh-un ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lungsetna eipeh bang cheh-un eithil peh-u achom cheh ineijun ahi. Thusei phongna apehpan atahsan dungjuijin seihen;
  </para>
  <para style="p">
    <verse number="7" style="v" />Sottola pang chu sottolin umhen; mihil chun mihil lamah;
  </para>
  <para style="p">
    <verse number="8" style="v" />Mitilkhou chun mitilkhouna lamah kipehen; thil homan it louhelin homhen; vaipo-a pang chun gunchu tah-in vai pohen; milungsetnan kipahtah-in lungset hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngailutna alem beihel hihen. Ase lam thet bolunlang apha chu kolchah jingun.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kisopi ngailutna lamah kideito kisato cheh-in umun; kiginle kijana lamah amasajo ding kichu-uvin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Gunchuna lamah thase hih-un; lhagao lamah al jingun; Pakai lhachan pangun;
  </para>
  <para style="p">
    <verse number="12" style="v" />Kinepna-ah thanomun; genthei hesohna-a thohhatnun; taona lamah pontho jingun;
  </para>
  <para style="p">
    <verse number="13" style="v" />Mithengho lhahsam huna-in kithopiuvin; jindot themun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nabolseteu chu phatthei boh-un; samse louvin phatthei bohjouvin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kipah thanomte chu kipa thanop piuvin; akapte chu kapiuvin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kitohdelin lungkhat nin chon cheh-un. Letna lam lung gel louvin aneo neotoh kiloijun. Nangma chang kichihsah hih-in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi setna chu setna-in thuh hih-un; mi jouse mitvetna apha chu bol ding gojouvin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ahi theija ahile, najochanun, mi jousetoh kihoutheijun kichamdelin umun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo deitahte, kiphulah hih-un, Pathen lunghanna chu otdoh jovin; ajeh chu Pakaiyin, Phulah chu keima kinbou ahi, keiman lethuh nange, ati, tin akisune.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin, namelmao chu agil akela ahile, an nehsah-un; adang achahle twi donsah-un; chuti bolleu chun alu chunga mei-am setkhompeh nahi dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Setna kijosah hihhelun, setna chu phatna-in joujovin.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thunei chungnungte thu thun mi jouse nungcheh hen; ajeh chu Pathen thusah louva thuneija aumpoi, chule aum chengse hi Pathen pansah cheh ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuti ahi jeh chun chuche thuneite douva chu Pathen thu douva ahi, chule adouho chun achunguva thutanna akiloikhum dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh iham itile vaipoho chu thilpha bolpa dinga kichat um hilouvin, ase bolpa dingabou kichat uma ahi. Thunei ho kicha louhelin umleng ti nagotnem? Thilpha bolin, chutile apachat nachan ding ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu nangma phattheina dinga ama Pathen sottola pang ahi. Ase nabol vangle kichan, aman chemjam adop khu moh-a adop ahipoi; ajeh chu ama Pathen sottol ahin, ase bolpa chunga lunghanga phula-a pang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun lunghanna ding ahipon, ase apha hetna jala jong athua nun ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche jeh-a chu kai jong napehjiu ahi; ajeh chu amaho Pathen sottol hiuva hiti chu abol jing jengu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Peh dingdol jouse chu peuvin; kai pehdol kai peuvin; se choina dolah se choijun; gin dingdol chu ginun; ja dingdol chu jauvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khatle khat kingailutto cheh tailouvin koima imacha bat hih-un; ajeh chu michom dang ngailu-a chun Pathen danthupeh chu asuhbulhit ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh iham itile, Jon bol hih-in, Tol that hih-in, Gucha hih-in, hetphotna dihlou mang hih-in, Papse hih-in, ti thupeh dang um jongle, Nangman nangma naki ngailut bangin naheng nakoma ngailun, tia hin akai khom sohkeijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngailutna-in hengle kom setna abolpoi; hijeh chun ngailut hi danthu bukipna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule chuche ti louvin phat umchan hi naheuve; tu hi nangho dingin imutna kona khah phat ahitai; ajeh chu eihon itahsan tiluva sang chun tu hin isochatnao anaitan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jan asotjo achetai, sun ahung naitai; hiche jeh chun khaije, muthim natoh pailhau hitin khovah vonin kivonuhite.
  </para>
  <para style="p">
    <verse number="13" style="v" />Suna bangin hoitah-in umu hite; juneh motchonle jukhama um louvin, huhle jonthanhoi nei louvin, kinahnale kithangset beihelin umu hite.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai Jesu Christa chu kivonjoh bouvun, naphe phatna dingu tahsa lam ngaichat suhbulhit ding imacha go hih-un.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tahsana hat louva chu nalah uva lauvin, amavang atahsan bukim louna chu oimo-a nol ding ahipoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mikhatnin imajouse neh theijin atahsanin, ahatmoa chun anche jengbou anei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anea chun anelou chu musit dahen; chule anelouvan anea chu oimo hihhen; ijeh ham itile ama chu Pathen'in alahsa ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi insung soh oimo-a nang koi nahim? Adinle alhuh a-pakaipa-a bou ahi. Ahi, Pathen chun adinsah thei ahijeh-a chu ama chu adinsah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi abang khatnin nikho khat nikho dang dang sangin ajabol tumin, abang kimkhatnin nikho jouse kibangin ajabolin ahi. Mi jousen ama lung sunga kihetchen chehhen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nikho jabola chun Pakai choi-atna-a ajabol ahin; nikho jabollou chun Pakai dinga ajabollou ahi. Chule ima ne-a jong chun Pathen alhai jeh chun Pakai choi-atna-a aneh ahi; anelou jong chun Pathen athangvah-a Pakai dinga anehda ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh ham itile eiho koima ama dinga hinga ihipouve, chule koima ama dinga thia ihipouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ihinle Pakai dinga hing ihiuvin, ithiu jongle Pakai dinga thia ihibovui; hijeh chun hing jong leuhen Pakai dinga hing ihiuvin, thi jong leuhen Pakai dinga thia ihiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu athi le ahing Pakai ahikop theina dinga, Khrista thia, chua thoudoh kitna, chule hing kitna ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin ibola nangin nasopi na-oimo ham? Chujongle nangin nasopi ibola musit nahim? Ajeh chu Khrista laltouna anga ibon chaova idin dingu ahinalaije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu, Pakaiyin aseije, Keima hingjing kahito lhonna, khup jouse ka anga dilsu cheh ding, chule lei jousen Pathen henga aphondoh ding ahi; tin akisune.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuti ahi jeh-a chu ibon chaova Pathen henga eima chonchan cheh ikisei dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun tukal ki-oimoto tapou hite; hiche sang chun hiche hi ngaito jovin, sopi anga lung lhahna le kipal lhuhna koi lou ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thil angai monga thenglou aumpoi, ti hi Pakai Jesu'ah kahechenin katahsan lheh jengin ahi; amavang mi khattouvin thilboh ahi tia angaito chu, ama dinga hichu athenglou ahiji.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na nehle chah chunga nasopi alung phatmole, ngailutna thua chonta lou nahi. Adinga Khrista thia ahitan, ama chu nangman naneh nachah-in sumang hih-in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun naphatnao chu seisetnin um hihhen;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu Pathen lenggam chu anneh twidon thua ahipoi; chonphatna, lungmonna, Lhagao Thenga kipana joh bou chu Pathen gam thupi ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh iham itile koi hileh chuti thua Khrista lhacha-a pang chu Pathen lung lamtah ahin, mihemin jong, Aphai, tia aphot chen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun kichamdela umna dingle khantou theina kibolpehto lam juiju hite.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nehle chah jeh-in Pathen natoh suse hihhelun. Thil jouse athengnai, ahinla ikhat neh-a lung lhahna chu anepa dinga setna ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sa neh hijongle, lengpitwi don hijongle, adang ipi hijongle, nasopi kipal lhuhna ahiloule lhasetna, ahiloule thalhomna chu bolda hela pha ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tahsana nanei jem? Nanei chu Pathen angah nangman hetnin nei jingin; aphalam ahi ti ngaito-a themo-a kingaito loupa chu mi nunnom ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amavang lungsa-ih puma nepa chu themmo changa ahitai; ajeh iham itile tahsanna neija aneh ahipoi; chule ipi hijongle tahsanna nei louva bol chu chonset ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahin eiho ahat cheng hin eima lunglhaina hol louva, ahatmote hatmona chu ipohhu joh dingu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Eiho khat cheh-in iheng ikoma houthu lama khantousahna dinga aphatna dingu ngaito-a, lunglhaisah ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu Christa jeng jong ama kilunglhai lou ahi; ahin, Nahouse hon nahouset nao chu keima chungah achutai, tia kisun bangjoh chu ahibouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu nidang laija thu kisun chengse chu, lekha kisun Pathen thua kona thohhat le lungmonna imuva kinepna inei theina dinguva, eiho kihilna dinga kisun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thohhat le lungmon kona Pathen'in, Christa lunglam doltah-in khatle khat lungkhat naputsah cheh-uhen;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutia chu nanghon lungkhat le kam khatna I-Pakaiyu Jesu Christa Pa Pathen nachoi-at theina dingun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichena ding chun Pathen loupi choi-atna dinga Christan nangho nalah bangu chun, khatle khat kilatouvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh-inem itile keiman hiche kisei hi, Iputeu ipateu athutep chu phutdet dingle Pathen lungset jala chidang namdang ten Pathen achoi-at theina dinguva, Pathen thu adih chu hetsah dinga, Jesu Christa chu cheptanho lhacha-a hung panga ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiti jong hin akisune, Hiche jeh chun keiman chidang namgdangte lah-a Nangma kipah-in phonging ting, Chule nangma minin la jong sange.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitin ati kitleuve, Vo chidang namdangte, amitetoh kipah thanom khomun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukitle, Vo chidang namdangte, nabonchaovin Pakai chu vahchoijun, Chule mi jousen ama vahchoi uhen, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Isaiah'in jong, Jesse jung chu umding ahin, Chule chidang namdangte chunga vaipo dinga hung sohdoh ding ahi; Ama chu chidang namdang ten kinepna-a anei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lhagao Theng thahat vanga kinepna nanei letset theina dingun, kinepna Pathen'in natahsan naochu kipa thanop le chamna lungmon na-in dip letset tahen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kasopite ho, nangho chungchang thua chun, nangmahotah phatna dimset le hetna bukip sohkei nahiuvin, khatle khat kitilkhouto thei nahiuve, ti keimatah-in kahetchen ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin Sopite, chidang namdangte lah-a Christa Jesu lhacha-a kapan theina dinga Pathen'in eipeh lungsetna vanga hi nangho geldohsahna dinga, akah lahlah-a hakat cheh-a naheng uva kahinsut ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutia chu chidang namdangte dinga Jesu Christa lhacha kahia; chidang namdangte kilhaina chu lahthei ahia, Lhagao Theng suhtheng ahina dinguva, Pathen Thupha lhacha-a kapan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun tun Pathen dinga natohna lama hin Christa Jesu'ah kisonna kaneije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu chidang namdangte Pathen thua nunsahna dinga Christan keima eimanchah-a, thu le natoh-a abol chengse tailou chu imadang kasei ngam poi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichu Pathen Lhagao thahat na-a melchihna thaneitah le thilbol kidanga kon ahi; hitichun Jerusalem le akimvela kipat Ilyricum geijin Christa Thupha kaphongjal tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahi, hijeh-a chu Christa min kiphah poh louna mun'a kipana thupha lhangsap dinghi kalungtup ahi, achuti loule midang bulphusa chunga insa kahi khah ding ahi:
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin Ama thudol kiseipoh khah lounate chun amu dingu: chule ajakhalou ten ahet dingu ahi, tia kisun bang ahi nading joh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche jehtah-a jong chu hijatvei naheng uva kahung dinga kon, hiche chun eisuhmo jingji ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tu vangin hiche gamkai sungah kanatohna ding mun aumtapoi; kum sotna patna nangho henga hung ding kagot jingma ahin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Spain gam lama kache phat phatle naheng uva kahung ding ahi. Ajehchu nangho mupa ding kakinemin, chule amasan nang hotoh chomkhat kivop khom ingting, chule kache teng jongle nanghon neihung thahleu chun kati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tu vang hin mithengte gahu dinga Jerusalem'a chetadi ding kahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajeh chu Macedonia le Achaia gama mihon Jerusalem'a um mithengte lah-a migenthei vaichaho huna-a sumto ding aphasah uvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahi, pha asah tahbeh-u ahin, chule abatnu jong hija ahi; ajeh chu lhagao lama chidang namdangte akikop piuva ahile, leiset thil lama jong amahon abatnu ahin, ahu dingdol mongu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuche jeh chun chuche kin chu kachai tengle asumdonu chu phatecha kapehdoh joule, nangho kom hinjot pangting Spain gam lama kachepai peh ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule naheng uva kahung tengle chun, Christa Kipana thupha-a kon phattheina chamkim keija hinpo-a hung ding kahi, ti kahei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sopite, Juda gama cheng sei ngailouho khutna kona kahoi theija, Jerusalem'a kin neija kachena hi,
  </para>
  <para style="p">
    <verse number="31" style="v" />Mithengten analah theina dingun, chule Pathen phatsah-a kipahtah-a nangho heng lama kahunga nang hotoh kakicholdo theina dingin,
  </para>
  <para style="p">
    <verse number="32" style="v" />Pathen henga taona-a hahun neihuvin tia Pakai Jesu Christa le Lhagao Thengin eipeh-u ngailutna vanga, nangho kahin ngeh nahiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chamnale lungmon kona Pathen'in nabonchaovin umpiuvin. Amen.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isopinu-u Phoebe, Cenchria houbung lhachanu hi Pakai minin mithengte chonna-in lomtah-a analauvin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nahunao angaichatna chan-ah anahuvin tia nangho amanu hitoh kakihettosah nahiuve; ajeh iham itile amanu hin mi tamtah ahun chule keimatah jeng jong eihun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu Christa-a katoh khompi kahinkho huhna-a alol do-a Priscilla le Aquila kasalam anapeuvin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kei chang hilouvin chidang namdangte lah-a houbung mi jousen jong apahchauvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule a-in'a kikhom houbung mite jong chu salam anapeuvin. Kasahtah Epaenetus Asia gama Christa tahsan masapen chu salam anapeuvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho dinga na hatoh-a tonggim Mariam jong kasalam anapeuvin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka-inkote kasoh chanpi Andronicus le Junia solchah ho lah-a minchepen keima sanga Christa-a lut masa amani jong chu kasalam anapeuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiya kasahtah Amplias chu kasalam anapeuvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Christa-a itoh gimpiu Urbane le kasahtah Stachys salam anapeuvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Christa-a mi kitah kichen Apelles salam peuvin. Aristobulus te insung miho jong salam peuvin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka-inko Herodion kasalam anapeuvin. Narcissus te inko Pakaiya um cheng chu kasalam anapeuvin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakaiya na hatohgim Typhene le Tryphosa salam anapeuvin. Dei umtah Persis Pakaiya na ahatoh lheh jengin, ama chu kasalam anapeuvin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakaiya lhen Rufus le kanu tobang anu chu salam anapeuvin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Asyncritus, Phlegon, Hermas, Patroba, Hermes, hicheng chule aumpiu sopite chengse salam anapeuvin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Philologus le Julia, Nereus le asopinu, Olympus, chule amahotoh kikhom mithengte chengse salam anapeuvin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khatle khat salam kiboh tovinlang thengtah-in kichopmun, Christa houbung mite jousen salam napeuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo sopite, kangehnao ahi, thu nakihil chengu chu akaleh-a, kikhen chehna dingle kipal lhuhna semteho chu anamelgel unlang, amaho-a konin anachom umun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijeh-inem itile chutobang miho chun I-Pakaiyu Jesu Christa lhacha na tong louvin, a-oisung dingu lhacha na tong jengbou ahiuve; chule kamthemle thungei ngeijin suhset neilouho lung dohan alhemlha jiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nasei ngaijeu chu vannoi'ah akithang dohtan ahi. Hiche jeh chun nachung uvah kakipah lheh jenge; amavang nangho apha lama chingunlang ase lamah lunglhom leu chun kalung ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule chamna lungmonna Pathen'in Satan chu nakengto noijuva achil ngemvah ding ahinai. Pakai Jesu Christa lungset chu nalah uva umjing hen, Amen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Katoh khompi Timothy chule ka-inko Lucius, Jason chule Sosipater hiteho chun salam nahinpeuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hiche lekhasun Tertius, keiman Pakaiyah nangho salam nahinpeuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keimale houbung mite jouse lhunna Gaius chun salam napeuve. Hiche khopi-a sumdol Erastus le sopi Quartus'in salam napeuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />I-Pakaiyu Jesu Christa milungsetna chun nabon chaovin umpiuvin, Amen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kathupha hille Jesu Christa thuphon bangtah-a, tonsotna patna ki-im thuguh chu tu-a akiphondoh bangtah-a,
  </para>
  <para style="p">
    <verse number="26" style="v" />Tahsan thua ahung nunna dinguva tonsotna Pathen thupeh dungjuitah-a, themgaoho lekhabun aphondoh-a, chitin le namtin jouse ahetsah ahitan;
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangho sudet thei Pathen chinga khatseh chu Jesu Christa vangin tonsot geijin loupi jinghen, Amen.
  </para>
</usx>
