<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JOB" style="id">Job</book>
  <para style="h">Job</para>
  <para style="toc1">Job</para>
  <para style="toc2">Job</para>
  <para style="mt">Job</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Uz gamsunga chun amin Job atiu mikhat anachenge. Amapa chu chamkimle mikitah anahin, chuleh Pathen ginga setna nungsun jing mi anahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman chapa sagile chanu thum ahinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman aneiho chu kelngoi sangsagi, sangongsao sangthum chule bongchal to janga chule sanganpi sanga ahin, chuleh insung lentah ahi; hijeh chun hichepa chu solam miho jouse lah-a milenpen anahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin achapate chun a-inhouva ama ama nikhosehle golvah bollin ache jiuve. Hichea chun nehkhom donkhompi ding chun asopi numei thum jongchu akoujiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Golvah nikho kitol chu akichai phatnin, Job'in mi asollin achate chu asuthengjin chuleh Jingpi tahle athoujin achate khatcheh ding chun govam thilto abolpehjin ahi; ajehchu Job'in, kachate Pathen douna-in chonse khaovintin, chule alungun Pathen chu gaosap khaovinte, ati ahi. Hitichun Job'in tanglouvin abol jingin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun nikhat Pathen chapate chu Pakai angsunga acham chama ahung kikhop nikhou ahung lhungin, alah uva chun Satan jong ahungpange.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Pakaiyin Satan jah-a hoija kona hung nahim? ati. Satan'in Pakai chu adonbutnin, leiset chunga suhle tunga kavalea chule chungle noi kakoptoa kahung ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakai chun Satan jah-a nangman kalhacha Job khu iti nagellem? Leiset chunga michamkim, mikitah Pathen ginga chule asetnalam nungsun jing amatobang aumdem? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuphatnin Satan'in Pakai chu adonbutnin, Job'in Pathen chu mohseh a agin hija ong? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangman amale a-insungmite chule aneijousele aveljouse pal nakaikhum hilouham? Nangman akhut tenin atoh jouse phatthei naboh in, chule hiche gamsunga hin anei agou apung chehcheh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla tun nakhut lhang inlang aneijousehi tongkha lechun, aman namaichang tah a nagaosap tante ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Pakai chun Satan jah-a, ven, aneijouse khu nangma thaneina ahitai; amatahsa chunga vang nakhut lha hih in. Hitichun Satan chu Pakai angsunga konchun achedohtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nikhathi a-upa pennu inna chun achapate achanute chun nehkhom donkhom abolpetnu chun:
  </para>
  <para style="p">
    <verse number="14" style="v" />thangkou mikhatnin Job henga thu ahung lhutnin, hitin aseije. Bongchal hon lou akaipetnu, chule sanganhon akomuva ham aneh petnun,
  </para>
  <para style="p">
    <verse number="15" style="v" />Seba miho chun ahindel khumuvin abonun akaimangun chule sohdangho jouse jong chu chemjamin athatnun, kei changseh bouhi nangma hildinga hung hoidoh kahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman hiche thuchu asei nalaijin, midang khatma ahung lhungin hitin aseije, Pathen meichu van'a konin ahungleng lhan, kelngoihole soh ho chu akataovin amaho meijin ahalvamtai. Kei changseh bouhi nangma hildinga hung hoidoh kahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman hiche thuchu asei nalaijin, midang khatma ahung lhungin, Chaldea miho loithumin akisemmun sangongsao ho ahindeluvin, amahochu akaimang taove. Kei changseh bouhi nangma hildinga hung hoidoh kahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman hiche thuchu aseinalaijin, midang khatjong ahunglhung paijin nachapate le nachanutehon a-upa penu in'a an aneh uva lengpitwi adonpet tah-un,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule ven, gamthipma konin khopihuijin in ningli chu ahinmutnin ahile, in chun khangdongho chu alhuh khumin, amaho athigam taove. Chule kei changseh bouhi nangma hildinga hung hoidoh kahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutah in Job chu akipatdoh-in, asangkhol lenchu abottelin, asam akivotolin, chuin tolla aboh khupmin, Pathen chu ahoutai,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hitin aseije, kanu naobu sunga kona kasagoh keova hungdoh-a kahin, sagoh keova kakilekit ding ahi. Pakai chun eipeh ahin, Pakai chun akile lahkit ahi; Pakai min chu nunnom hen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hicheng jouse-a hin Job'in chonset abolpon, Pathen jong ngol hoitah in oimo achanpoi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nikhathi Pathen chapate chu Pakai anga ahung kikhomkit taovin, chule amaho lah-a chun Satan jong Pakai angah ahunglhan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Pakai chun Satan jah-a, hoija hungkon nahim? ati. Satan'in Pakai chu adonbutnin leiset chunga suhle tunga kavalea chule chungle noi kakoptoa kahung ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pakai chun Satan jah-a, kalhachapa Job khu iti nagellem? Leiset chunga michamkim michondih Pathen ginga chule setnalam nungsun jing amatobang aumpoi. Nangman ajeh beija ama suhmang dinga ama douna-a neitildoh vangin, aman achondihna lhadeh louvin atuhchah jing nalaije, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Satan'in Pakai chu adonbutnin, vun khella vun, henge, min aneijouse ahinna lhengin pente.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin tun nangman nakhut lhangin lang agule aphe tongkha lechun aman namaichang tah-a nangma gaosap tannate, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai chun Satan jah-a, ven, ama nakhutna aume ahinla ahinna vang hoijin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun Satan chu Pakai angsunga konin achedoh-in, chule Job chu akengtoa pat alujang geijin uilut khohtah-in atomsah tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman akikhot nadingin bel halkhat alan, vut lah-a chun atoutai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ajinu chun ajah-a, nachondihna chu nakolchah nahlaijem? Pathen chu gaosap minlang thijengtan, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin aman amanu jah-a nangman numei ngolkhat thusei bangin thu naseije. Ipiham? einin Pathen'a kona apha jeng ikisana, aphalou kisan louva i-um dingham? Hicheng chunga hin Job'in akamin thuse aseipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun Job golte thumho chun hiche thilse jouse hi ama chunga achutai ti ajah phatnun, aumna cheh uva konin ahungun; amaho chu Teman mi Eliphaz, Shuh mi Bildad, chule Naamath mi Zophar ahiuve. Amaho chu ama lunghempi dingle lhamon ding chun akitem toh-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amahon gamlatah-a avetnuva amachu ahettheilou phatnun amaho awging tah-in akaptaovin; chule amahon asangkhol cheh-u chu abottelun, chule van lama aluchung uva leivui atheuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun amahon amachu ni sagi le jan sagi tollhanga atoupiuvin, koimachan kamcheng khatchan jong ahouloh pouve; ajehchu amahon athohgim nasatah chu amuvin ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheng jouhin Job akam kan apenni chu agaosaptai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Job apaodoh-in hitin aseije,
  </para>
  <para style="p">
    <verse number="3" style="v" />Kapenna nikho chu mangthah hen, chule naosen pasal khat akivoptai tia kiseina janchu mangthah hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche nikho chu muthim hihen, chunglama konin Pathen'in ngaisah dahen, hiche nikho chu vah injong salvah dahen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche nikho chu muthimle thina limmin kaikhumhen, meipin achung khukhumhen; muthim lhangkhal in hiche ni chu kichatsah hen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hiche janchu muthimin mangjeng hen; hichu kumsunga nikho lah-a jong pandahen, lha kisim nalah ajong panghih hen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veovin hiche janchu janlengvai hihen; hia chun kipa awgin hung lutdahen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Alunghem nao sodohgo-a nikho gaosaphon hichu gaosap muhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thingjangvah ahsi hochu thim taohen, hiche chun khovah velehen, ahin khatcha jong mudahen, khovahlhah jong mudahen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu hiche jan chun kanu naobu anasingpon, chujongle gentheina kamitna konin ana selmangpoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ipijeh-a naobu-a kona kanathi louham? Oisunga kona kahungdoh a chu ipijeh-a kahinna kanalha louham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ipijeh-a pheiphung in einasana? ahiloule, ipi dinga kachepding noi ana uma ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutile keima tu-a hi analuma thipbeh-a anaum tadinga, keima ana ihmu tadinga, hichepetna chu keima anacholdo hitaleng,
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho-a dinga khogemsa kisema leiset thumopthem ho le leiset lenghoto,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahiloule a-inhou dangka a sudima, sana neija leng chapatetoh,
  </para>
  <para style="p">
    <verse number="16" style="v" />ahiloule aphatlouva peng chapang kisel mahthah khat tobangla kana hitapon, vah mukhalouhel naosen ho tojongla kanabang tapon,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hikoma chun migilouho alungkham naova konin atangun, chule athacholla chu akitha oltai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hikoma chun songkul lut ho acholngaovin; mibol gentheina aw jong ajatapouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hikoma chun alen aneo aumun, chule sohjong apakaipa-a konin achamlhat tai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ipijeh-a genthei thohpahi vah chu anakipea, chule alha hesoh lengvaipahi hinna anakipeham;
  </para>
  <para style="p">
    <verse number="21" style="v" />Thina ngaicha lheh-a ahivanga hunglhung dehlou, chule gouthil kiselgu sanga nasajo-a holpa;
  </para>
  <para style="p">
    <verse number="22" style="v" />Amahon lhankhuh amutengule, hatah-a kipah thanomji hilou vuham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ipijeh-a alampi kisel mangpeh mipa hengle, Pathen'in kul akaikhum pehpa henga vah kipe aham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu ka anneh masangin kahai sammin eiphan, chule kapen ginhi twi bangin akibunglhai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu kakichat pentah thilchu kachunga alhungtan, chule kana ginjing thilchun eihin phatai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Keima kana hoidohpon, choljong kana choldopoi, chule thipbeh injong kana umpoi, ajehchu gimna chun eilhun khumtai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuphatnin Teman mi Eliphaz chun adonbutnin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />keihon nangma kihoulimpi talengu nalung phamo dem? ahinla koiham paolouva umthei dinga?
  </para>
  <para style="p">
    <verse number="3" style="v" />Vetan, nangman mi tamtah nahildoh-in, khut thalhom te chu nahatsah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nathun alhusapa chu atungdingin, khup ngoite chu nathahat sahtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin tun nachunga alhungtan ahile, nangma nalhasam tan; hichun nangma natongkhan ahile nangma nagenthei tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichehi nakichat, natahsan, nakinepna chule nalampi ho-a nadihna chu hilouham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Geldoh-in, katao ahi; suhkhel neilou mangthah-a koi umam? ahiloule mikitah ho koi kipaidoh kha-am?
  </para>
  <para style="p">
    <verse number="8" style="v" />Keimatah jengin jong kamudanin, khan gitlouna lou kaija kaiho chule khansetna muchi tu-a tuhon jong kibang bangin a-atnun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen hu-a amaho amangthah jiuvin; chule alunghana hu-a chun amaho ajunmang jitaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keipi bahkai kitum, chule keipi bahkai hang awgin, chule keipi donglai haho jong chu akisubong tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keipi bahkai teh chu nehding lhasamin amangthah jin, chuteng keipi bahkai nouho chu akithecheh jin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun thilkhat guhthim chan kakom ahung lhungin; chule kanakhangin thuguh kisei ajan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihemte chunga imutlhuhna achuh-a, jana gao thilmu ho-a kona kagel laijin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Kichatna kachunga ahungchun, kakithingtai; hichun kagu jouse ahot longin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin lhagao khat kamaikoh-a ahungin; katimul athoujenge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kading jingin, ahin keiman alimso kahe thempon; alim chu kamasanga aumin, athipchetnin, chuin keiman awkhat kajan hitin aseije,
  </para>
  <para style="p">
    <verse number="17" style="v" />Thithei mihem Pathen sanga dihjo thei ham? mihem chu asempa sanga thengjo theiham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Ven, aman asohte chunga ginchatna aneipon; chule avantil te jengjong themmo achane.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngetnin asuhmangji, bon in'a chenga, leivui lah-a kona kisemdoh leingan hohi, ichanna lhasamdiu ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaho chu jingkah-a patnin nilhah geijin suhmangin aumun, amaho chu i-sah loutah in atonsotnin amangthah jiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amaho-a thilphapen chu chemangjilou ham? chuteng amaho chu chihna beijin athiji taove.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangma nadonbut theiding khattou aumle tun kouvin; chule mithengho koi kom pena nakihei ding ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu lunghanin mingol chu athatjin, thangsetnan milungthim beipa chu athatjin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman mingol aki jungkho kamun; ahin phulou helouvin achenna kagaosap tai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Achate jong bitna-a konin agamlaovin, amaho kotpi phunga suhchipmin aumjiuvin, amaho huhdoh ding koimacha akimuji tapoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Achang atsajong agilkelten anejou taovin, chule linglah jenga jong alakhomjin, gucha michom hon aneijouseu chu avallhum jitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thohgimnahi leivuilah-a kona hung ahilou vangin, chule gentheina jonghi leisetna hungkon ahilou vangin;
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitajongle meisi chunglama alentou banga, mihemhi thohgim ding monga penga ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman vang Pathen holingting, chule Pathen henga kathuhi lhutning kate:
  </para>
  <para style="p">
    <verse number="9" style="v" />Amachun thil len tahtah le holdoh jouhoi hilou thilkidang tamtah simjoulou abole.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman leichunga go ajuhsahjin, loulaija twi ahinsolji:
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichun mi noinungte tundoh ahinadiule, alunghemte chu hoina-a choisang ahina dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman miduha thuh ho thilgon asumojin, hitichun atohgonu chu akhutnun atongtheiji tapouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman michingho chu adohaovin amanjin, milung gilouho thilgon chu abungbun achuhsahjin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho nisa vah noija muthim toh akitoh-un, sunchangnoija muthim lah bangin akimailele jiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin aman michaga chu ahatho khutna konle, akamuva kon chule chemjam'a konin ahuhdohjin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun mivaichan kinepna aneijin, khan gitlouna chun akam ahuptai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ven, Pathen'in asuhdih mi chu minunom ahi; hijeh chun hat chungnung gimbol nahi i-sah louvin koihih-in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu aman amavon, chule atompeh-in, asukhan, akhutnin adamsah kitji.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gentheina gup ma kona aman nahuhdoh ding; sagi na-a jong setnan natohkhah louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kellhah tengle aman thina-a kona nalhatdoh ding, chule galmuna chemjam thanei na-a kon nahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Miseiseho-a kona selthipma aum ding; gamna ahungteng jongle nakichat louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Suhgamna le kel lhahna chu na nuisat ding; leiset gamsaho jong nakichat louding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu loulai songhotoh nangman kiloikhomna nanei ding, chule gamlah saho chun nangma toh kichamna anei diu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule nahoubuh-a chamna aumding chu nahet ding, chule nachenna chu navil ding, chonset nabol louding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nangman nachilhah ho letding jong nahetding, chule nachilhah hou chu leija hampa tobang ding ahi, ti nahet ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aphatcha kiloh changvui banga, nakum kilhin tenglebou nalhankhuh najotding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ven, hichehi keihon kaholdoh-u ahi, hitichu ahi; ngaijin, nangma dinga pha ahi ti kihetnin.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin Job'in adonbutnin hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />O kagimna ho hi kito tohsel henlang, chule kahamsetnaho hi khaikotnin kilepto tavele!
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu, tunvang hicheng pihi twikhanglen panga neldi sangin gihjonte; hijeh-a chu kathuseiho vallhuma um ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu hat chungnungpa thalchang chu kasunga aumin; agu chun kalhagao adonjou heltan, Pathen'a tijatnaho keidou dingin akigoltoh taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gamlah sangan chu hamhing neisasa pengji-am? ahiloule bongchal anehding chunga bu ngainam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Atamset thilchu chi beijin akinethei nadem? ahiloule ahtui podala atuina umam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Kalhan jong atohkhah nomlou thilho chu, keija din lungkham na-a dim anneh tobang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />O keiman ngehkhat kaneithei ding hihen, chule Pathen'in kadei thilchu eiphalpeh theiding hitavele!
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen chun eisuhmang jenga lunglhai ding hijongle, chule aman akhut alha-a eitanboh ding hijongle!
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuteng keiman lhamona kanei nahlai ding, chule kagenthei na-a jong kakipa ding ahi; aman eihoidoh dahen, ajehchu keiman mithengpa thuho chu kana selgupoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kathahat nahi ipi hija kakineppi ding ham? chule kaki chaina chu ipihija, keiman kahinkho kakisuhsao dingham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Kathahi songho banga tah hija, kasaphe hi sum-eng tobang ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Keija hi panpina umlou ham? chihnahi keija kona kidelmanga hitam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Bolhesoh-a umpahi agolpa-a kona lungsetna chu vetsah ding ahi; ahinla aman Hat chungnung ginna chu adalhatai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kasopi hon vachadung bangin kitahloutah-in eijoubolun, chule luidungho bangin alongmang taovin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheho chu buhbang jeh-in avomin, chule asunga chun buhbangho kiselin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho akisahjun phatle amangjitan, hichu asat tengle aumnaova konin amangthah jitaove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Achenau lampi chu akiheimangin, amaho hoima lhungjilouvin amangthahji taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tema galsat mihon aveovin, Sheba kiloihon amaho chu angah-uve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amahon akineppina anei jeh-un akisumo taovin, amaho khulama ahungun akisujum taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu tun nangho ima nahi tapouvin, nanghon eikiselhah namuvin, chuleh nakichataove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kahenga hinchoijun tia kasei khah em? ahiloule nanei uva konin lhatdoh man neipeuvin tia kaseikhah em?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahiloule melma khutna konin neihoidoh-un; ahiloule hat chungnung khutna konin neilhat doh-un katikhah em?
  </para>
  <para style="p">
    <verse number="24" style="v" />Neihilun, chule keiman kalei tuhtang ingkate; chule hoikoma chu kasuhkhel ham neihetchet sah-in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thudih hohi itobanga thaneija hitam! ahinla naminel nahou hin ipi aphatsah em?
  </para>
  <para style="p">
    <verse number="26" style="v" />Thu kisei hohi suhdih dinga nagel hih uva, chule kinepna neiloupa thusei chu hui tobangbou hitam?
  </para>
  <para style="p">
    <verse number="27" style="v" />Henge, pa neilou chu nasugimun, chule nagol diuvin kokhuh nalaijun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun tun lunglhaijun, keima neiveuvin; kajou ahile kicheh-in heuvin nate.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hungkileuvin naheng uva katao ahi, khan gitlouna chu hidahen; henge, hung kile kitnun, kachon phatna chu hia chun aume.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kaleijahi khan gitlouna umam? kathil patepna hin hetkhena tha aneilou hitam?
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leiset chungahi mihem dinga phattep khat uma hilouham? anikhohi thalahpa nikho tobang hilouham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Soh-in nilim angaichat ten bangle, thalahpan atohman sanding avetlhih jing bangin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun panna beijin lha hijatpihi eiki chansah-in, thohgimna jan hijatpihi kadingin eikitep pehtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalupteng itihle kathou kitdem katin, chule janhi itihle abeitadem? katin, chule khovah kahsen nungle ma-a kakileh humhal jengjin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katahsa hi lungle leivuijin atomin, kavunhi akeh-in chule kidah umtah asohtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kanikho hi ponkhong khothei sangin aleng gangjon, chule kinepna beijin akimang chaitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Oh, kahinkho hi hui ahi ti geldoh jingun; kamitnin apha mukit taponte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Eimupa mitchun eimukit tapontin; chule namitnun eiventin, keivang ana um taponge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meilhang amanthah a abeihel bangin, thikholkhula chelutsa chu ahungdoh kitjitapoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A-in'a ahung kilekitji tapon; chule ama munin jong ama anaheta ponte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun keiman kakam hupta pong ting; kalhagao hesoh puma thu kasei ding, kahinna natna jeh-a chu kaphun ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keimahi twikhanglen kahia, ahiloule ngapi kahija, eingah ding kachunga nakoi ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Kajalkhun in eilhamon nintin, chule kalupnahin kalunglhai louna olsah dominte kati tengle;
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman mangin neikichat sah-in, munei na-in neitijat sah-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitia chu kahinna hin, hin sanga kimeh lihle thi alhenjoh theina dinga nabol ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichehi kakidah-e, kahinbe nompoi; neichang lhaovin, ajehchu kanikhoho hi pannabei ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihemhi ipi hija nangman nahiti choisanga, achunga nalungthim nakoijing ham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Jingkah sehle nangman amahi navil jinga, chule phattina napatep jingding ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Itihchan keija kona chemanglouva na-uma, chule kachil kaval lhah kahse dinga jong neichanglha louding ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Kana chonsetai; nahenga ikatiding hitam, Vo nang mihem hinkho chingtup pa? ipijeh-a nangma douna melchihna khatna neikoija, hitachu keimahi keima dinga pohgih kahi hitam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangman ibolla suhkhel ngaidamlouva, keima khan gitlouna nalahmang louham? ajehchu tun keima leivui lah-a ihmutang kating, chule nangman jingkah le neihol ding, ahia keima ana umlou ding kahitai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuphatnin Shuhit mi Bildad chun adonbutnin, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangman itih chanpi hiche hohi nasei dingham? chule itih chanpihi nakamsunga kona hungpotdoh thuchenghi, hui hattah hungbang dingham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen'in thutan lhahhi alehei khah-em? ahiloule hat chungnung chun thudih hi alehei khah em?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nachate ama douna-a achonsetnuva, chule asuhkhel jeh uva aman apaidohle,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman aphatcha Pathen chu naholkitna, chule hat chungnung henga chu taona nasemkitna ahile;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangma nathem channa chule nathenna ahile, thonlouvin tun ama nangma dingin hung thoudoh intin, chule nachon phatna munchu khantousah tante.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nakipatna chu neocha anahijongle, nakichai na chu nasatah-a pungding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu nahenga katao ahi, khanglui lama miho chu kholin, chule apatehou chung changhi holdingin kigon,
  </para>
  <para style="p">
    <verse number="9" style="v" />(Ajehchu eiho janhi mibou ihiuvin, chule ima ihepouve; ajehchu leisetna ihinkhou hi le-lim bou ahi.)
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon nangma nahil louvu, naseipeh louvu, chule alunguva kona thu naseipeh lou dingu ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Doplah louva phaipheng kehtheijam? twi beija peng kehthei ding hinam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Satlhah louvin ado hingpet jong, hamhing dangho sangin agoplha masaji taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathen sumilho jouse lamlhah chu hitichu ahin; chule miphalhem pa kinepna jong mangthah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amapa kinepna chu suhbeijin umintin, chule aginchatna chu maimom pan tobang ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama a-in'a kingai jintin, ahivangin hichu dingjou louding; aman hatah-in tuhchah intin, ahivangin pangjou louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama nisat masanga ahingsetnin, chule honsunga konin abah ajamdoh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajungho chu song lah-a ajam lutnin, chule songho lah-a chun mun aveove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman amuna konchun sumang taleh, hichun ama seilep mintin nangmahi kamukha hihbeh-e, tinte.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ven hichehi ama kipana lampi chu ahin, chule leisetna konin adangho hung kehdoh tante.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ven Pathen'in miphachamkim chu apaidoh louding; chujongle khanset bolpa chu akithopi louding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman nakam nuina-a adip dima, namuh kipana-a adipdim kahse-a,
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangma nahotbol teho chu jachatna-a kivona, chule mikhang gilou chenna munchu imalou hungsoh ding ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Job'in adonbutnin, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichehi thutah ahi ti kahei: ahivanga Pathen angsunga koiham them changjou dinga?
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman ama kinahpi goleh, sangkhat lah-a khat jong donbut theiponte.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama lungthima chingtah, tha-a hattah ahin, ama douna-a kilungtahsah-a khangtouva koi umam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Molsang ho achon mangin, amahon ahepouve; aman alunghan na-in amaho aleh khupmin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman leiset hi aumna mun'a konin ahot lingjin, chule chua akhomho chu akilingjin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman nisa thu apen nisa asohji tapoi; chule ahsi ho namdet anam khumjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amabou chu vanho phajala, chule twikhanglen kinongho chotpha a chu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman sahlam valpa, Juheisuhtun, Bombel, chule lhanglam ahsi umna jousehi asem ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman mudohjoulou thillen abolin; simjoulou thil kidangho jong abolin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ven, ama kakom tah-a achen, ahinla kamupoi; chule ama achepeh jengin, ahinla kahekhen theipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Veuvin, aman akilah mangleh koiham akhamtheija? koiham ajah-a ipi nabol ham tithei dinga?
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathen chun alunghana alahdohji loutengle, mi kiletsahte kithopi ho chu anoija akunjiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiman ijatna lhoma ama kadonbut dingham? chule amatoh kihouna dinga thucheng ijat kaki lhendoh dingham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima dihlheh jongleng ama donbut pongkating; ahinla keima kathutan dingpa henga taona neijo tange.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman ama kou ingting, aman eidonbut jongle, aman ka awchu einangai peh-e ti gingcha ponge.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu aman huipi le go kithon keima eisuchipmin, chule ajehbeijin kamaha put apunsahbe-e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman kahaina kalah ding eiphalpon, ahinla genthei na-in eidipme.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiman hatna thu seijong leng, ven, ama ahatne; chule thutanna tijongleng, koiham thu kasei theina dinga phat eipeding.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keima them kichan jongleng, kakam sungin mo-eichan intin; keima kacham kimme tijong leng, hiche jongchun kalhin lelna eiphot chetpeh bepding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keima ana chamkim nama jongleng, kahinna hi hedehpong kating, kahinkhohi nahsahmo bep ingkate.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichehi thilkhat ahi; hijeh-a chu hichehi kasei ahi, aman michamkim pa le mikhang giloupa asumang gele.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun phulou helouvin kijepna-in kijeplih jongle, aman themona neiloupa thukitan chu anuisat bepding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Leiset hi agiloupa khutna kipedoh ahin, aman thutan ho maichu atoma, hichu ahiloule, hoija, koiba hijaham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Tun kahin nikhohohi thangkouva lhaipa sangin aman gangjon, amaho aphajong muman louvin alengmang jitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kongho mangang tah-a akitolmang jeljel bangle, mulaopin anehding amat dinga amangan bangin agangin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Keiman kakiphin nahi sumiltange, kagihsatna hohi dalhang ting, chuleh keima kilhamon tange titaleng;
  </para>
  <para style="p">
    <verse number="28" style="v" />Keiman kagenthei naho jousehi kakichan, nangman themona beija neikoi deh louding ahi ti kahei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keima mikhang gilou khat kahile, ipijeh-a pannabei ja kakisuhboi ham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Buhbang twijin kisilha jongleng, kakhut hohi hibang tah-in thengkha hih jongle;
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijongleh, nangman kokhuh sunga neiphumlut teijin natin, chule kapon jengtah jonghin eithetbol ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu ama kadonbut theiding le, thutan na-a kache khompi theiding, keitobang mihem ahipoi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kachung cheh lhonna akhut lhathei ding, kakahlhona palai dingjong aumpon ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman amol lhon keija konin ladohhen; chule ama kichatna hin eitijatsah dahen;
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuteng keiman thu seijing ting ama kichataponge; ahin keima kachuti theipoi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kahinna in kahinkhohi acholpitai; kakiphin naho hi keima chungtah-a ngamingting; kahinna-in lungna tah-in thu seitange.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman Pathen henga themmo neichan hih-in tinge; Ipijeh-a neilungsat khumham neimusah-in tinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nakhutna nasemsa hi bolgentheija, nahsahlouva koija, migilou ho kihouna chungjoh salvah dinghi nangma dinga phajo hitam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Tahsa mit tobang naneija? ahiloule mihem thilmu banga nangman jong namuham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma hin nikhohi mihem hin nikho tobang ham? nangma hinkho kumho jonghi mihem hin nikho ho tobang hija ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiti achu nangman kakhan gitlouna ho nakhol jinga, chule kachonset naho naholjing ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />keima khanggilou kahilou hi nangman nahen; chule nakhutna kona eihuhdoh theija koimacha aumpoi tihi nahei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nakhut tenin einasema, chule kalimhi nasuhto-a neimehtoh ahin; ahijeng vangin nangman neisumang tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Geldoh in, nahenga kangeh ahi, nangman bonngan banga neisem ahin, chule leivui neisokit ding hitam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangman bongnoi banga neisunlhah hilou ham? chule bongnoiha banga neihatsah hilou ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangman vunle phen neitomin, chule gule thaguijin neikan chah-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman hinkhole panpina chu neipen; chule neivil jingna chun kalhagao aching tupmin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche thilhohi nalungsunga naselin; hichehi nangma-ah aume ti kahei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima kachonsetle nangman neimelchih-in, chule nangman kakhan setna jong don louvin neikoipoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima mikhangilou kanahile, ohe ada chu kahi! chule midih ana hijongleng khodah pong kate. Keima kiboina-in kadimtan; hijeh chun kahesohnahi hungvetan.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu hichehi apungcheh tai. Nangman keipi bahkai hangtah bangin neidelin, chule nangman kachunga kidang tah-in nakitahlang kitnin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman keima douna-in hettohsahna athah-in napodoh-in; chule kachunga nalunghanna napunbe sahsah-in; kikhelna le galkisat hi keimato aumkhom jinge.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ipijeh-a chu naobu-a kona chu neihinpuidoh hitam? Ohe, kalhagao chu kanalha hihen, mit khatchan jong einamu da hitale!
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima ana umkhalou tobang hitadinga, naobu-a kona lhankhuh-a eikipo tading ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kanikho hi lhomcha hitalou ham? themkhat beh jong lungmonga kaum theina dingin, khongai jinlang, neichang lhatan.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kilekit lounading mun, muthim gamle, thina le-lim gama kache masangin;
  </para>
  <para style="p">
    <verse number="22" style="v" />Muthim gam, athima thim, chule thina le-lim, thupeh umtalou; chule vah jong muthim banga athim namun ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Naamath mi Zophar chun adonbutnin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Thu hijatpihi donbut louva umthei dingham? chule mihem khatchu thusei tamjeh-a them kichanthei dingham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Najou hohin miho asuhthip thei dingham? mi i-sah louva nabol tengle koiman eijumso ponte natiham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nangman kathuhil hi athenge, chule namitmuva kangime natin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla, oh! Pathen'in thu seihen lang, chule nangma douna-in akam kataleh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutengle aman akisei chihna thuguh ho chu nangma namusah intin, hicheho chu hiche aumsa sanga hi achan ni-a tama ahin, Pathen'in nakhanset jala nathoh dingdol sanga lhomjo nachunga angeh ahi hi kihetnin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman Pathen chu nahol vanga namudoh theiham? hat chungnung chu chamkim keija naholdoh thei dingham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichehi van banga sanga ahin, ipi nalo theiding ham? thikholkhul sanga thuhjo ahin, ipi nahetjou dingham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Atena chu leiset sanga saojo ahin, chule twikhanglen sanga jaojo ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman tanbong hen, chule khahchah hen, ahiloule khomtup henlang hile koiham ama sutang jouding?
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu aman pannabei miho chu ahen; aman khan gitlounaho jongchu amunai; chuti ahileh aman hichu angaito louding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu gamlah sangan nou bangin mihem chu peng tajongle, pannabei mihem chu hungching ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangman nalungsung chu nagot tupma, nakhut teni-a ahenglam nasan dinga ahileh;
  </para>
  <para style="p">
    <verse number="14" style="v" />khansetna chu nakhutna auma ahile, gamlatah-a koimangin, chule khan gitlouna chu naponbuh sunga chensah hih-in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutengle nolna umlouvin namai dadohsah-in natin; chule kichalouva nadindet ding ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu nangman nathohgimna chu suhmilin natin, chule akitol mangsa twiho banga nagelding ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nahinkho hi sunlai sanga thengjoding, nangman navah nasodoh-a, jingkah toh nabahding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangma huhtupma naum ding ahi, ajehchu hichea chun kinepna aumtan; henge, nangman nachung chang nakikhol ding; chule kihuhtupna mun'a nangma nacholngah ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nangma lummin natin, koimachan nakichat sah tah louding, hiteng chule mitam tah-in nahenga ngehna anei diu ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla mikhangilou ho mitvang chu losam ding, chule amaho hoidoh loudiu; chule akinepna chu alhagaovu lhadoh ding bou ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Job'in adonbutnin, aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tahsanlel beihela nanghohi mipi chu nahiu ahitan, chule chihna toh nathitha diu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla keiman jong nangho bangin hetna kaneije, keima nangho sanga noinungjo deh kahipon; hiche hohi ahelou koi umem?
  </para>
  <para style="p">
    <verse number="4" style="v" />Keimahi Pathen kou-a amanjong ana donbutji, aheng akomaho i-sahlou mikhat tobang kahitan; midihtah nolnabei chu mi nuisatle ki-dah in aumtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alhudinga kigosa umpa chu nomsa tah-a umpan alunga adeilou thaomei tobang ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gucha michomho ponbuh sungchu akhangtouvin, chule Pathen sulunghang ho jong huhtup in aumun; akhutnu Pathen'in apeneng chetnin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla tun gamsaho khu dongun, chuteng amahon nahil untin; chule chunga leng vachaho jongkhu dongun, amahon naseipeh dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahiloule leiset koma seijin, aman nahil intin, chule twikhanglen'a nga hon nahenga aphondoh diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichehi Pakai khutnin atoh ahin, hicheng jouse-a kona hetheilou koiham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama khutna ahingthei jouse hinna aumin; chule mihem jouse haina hu aumme.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nakhangin thu jahding agotna, chule kammin a-anneh atepkhahji louham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Khanglui mite henga chihna aumin; chule hinkho sotna-a hetkhenna aume.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chihna le thahatna amatoh umkhom ahin, aman thumop le hetkhenthem theina aneije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ven, aman aphelhan, akisadohkit theitapoi; aman mi akhakhumjin, chule akihongdoh kit theiji tapoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ven, aman twiho atingin ahile ago gamtaovin; chule aman hicheho chu ahinsol doh-in ahile, amahon leiset achup jengun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chihna thahatna chu amatoh auma ahin, akilhem lhapa le alhem lhapa chu ama-a ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman thumopthem ho chu achomgamjin, chule thutan ho chu mingol jeng asojitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman lengho kikanna alhaplhah pehjin, chule konggah-in akongu agahpehjin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman pipuiho chu galthil kichom bangin apuimangjin, chule amihatteu chu asumangjin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman ginchat theitahpa thusei chu atolmangin, chule tehse ho hetkhen themna jongchu alahmang pehjin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman vaipoho chunga i-sah louna abunglhajin, chule mihatpa thahat chu alhahsam sahjin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman muthim lah-a thil kiselguh ho chu ahedohjin, chule thina le-lim chu vah-a ahin puidohjin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman namho apunsah-in chule asumangjin; namho chu asulenin chule apuijang kitjin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman leiset mihemte alamkaipao lungthim chu alahmang pehjin, amahochu lampi umlouna gamthip laija chun avamahthah sahjin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amaho chu vah beijin muthim lah-a chun akimailele jiuvin; chule aman amaho chu pasal jukham bangin avalon lelesah jin ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veuvin kamit tah-in hicheng jousehi amukhanai, kanakhangin ajan, chule hichu kahekhen tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ipi nahetnum, hiche jengjong chu keiman kahei, keima nangho sanga noinungjo deh kahipon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahbeh-in keiman hat chungnung hengah seijing ting, chule Pathen toh ngaito khomding kadeijin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin nangho jouthu bolho nahiuvin, nabonchao vin manlutna neilou louthem nahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Oh, nanghohi thipbeh-in umthei tave leuchun! hichu nachihnao hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun kalung ngaitohi ngaijun, chule kakam sunga kataonahi neingaipeh-un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon Pathen dinga gitlou na-a thu nasei dingu ham? chule amadinga lheplhahna thua nakihou dingu ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon amachu nasan dingu ham? nanghon Pathen dinga nelkalna nanei dingu ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman nangho naholdoh diuhi pha hinam? ahiloule mikhatnin michom dangkhat anelpeh banga, nanghon ama hitia chu nanelpeh dingu ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanghon guhthima miho nasan ule, aman nangho napho teidingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chungnunna hin nangho natijat sah loudingu ham? chule ama ginna hi nachung uva chulouding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Na kigeldohna jouseu chu vutvai tobangbou ahi, natahsao jong leingan tobang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho thipbeh un, thu kasei theina dingin neichang lhaovin, kachunga ipi hunglhung ding hijongle hunglhung hen,
  </para>
  <para style="p">
    <verse number="14" style="v" />Ipijeh-a kaha-a kasa hi kaketlhah-a, kahinkhohi kakhutna kakoi dingham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman eithat jongle katahsan jingding, ahin ama angsunga kalampihi katuhdet jingding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama kahuh hingna jong hiding ahi; ajehchu miphalhem koimacha a-anga lutlou ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kathuseihi phatechan ngai phaovin, chule kaphondoh hi nanakhangun ngaijun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun veuvin, kathuhi kagong tuptai; keima them eiki chanding ahi ti kakihetne.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima eiseihu ding koiham? ajehchu tun keima thiptaleng kalhagao kalhadoh ding ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kadingin thilni sehseh hi boldan, chutengle nangma-a konin keima kiselmang taponge.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keija konin gamlatah-in nakhut lamangin, chule natijat na-in neikichat sah hih-in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutengle nangman neikouvin, keiman donbut nange, ahiloule keiman seijing ting chule neidonbut in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kachonsetna le kakhan gitlounaho hi ijatloma tama hitam? Kasuh khelnale kachonsetna hohi neihetsah-in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ipijeh-a namai nasela, namelma-a neingaito ham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangin suhle touva huijin alhohle thingna chu nahe ngem ding ham? Chule chang kung gosa nadel lele ding ham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu nangman keima douna-in thilse tah najih-in, chule kakhang donlaija khangitlouna jouse chu neichansah tai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangman kakeng jong thinghom sung ho-a nakoijin; chule kalamlhah ho jouse hoitah-in navejingin, nangin kakengto teni-a din teptena nakoijin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule keima thil monsa tobang kahin, ngetnin aneh chaisa ponse tobang kahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Numeija hung penga mihem hinkho hi nichomcha bou ahin, chule lungkham nan adimsetne.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pahcha bangin ahung pahdoh jin, chule akisat tan jitai; ama nilim kihei bangin alhaijin, atangden jitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitobang bep mi khat hi nangin namit lhuh jinga, chule nahenga thu kitan dinga neipui lutjiham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kon thilthenglou lah-a kona thiltheng alahdoh theijem? koima cha aumpoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama hin nikho hi tepsa ahin, ahinkho lha ho jong nangkoma umah ahin? aman akhokhel louna din nangin agamgi nasempeh-in;
  </para>
  <para style="p">
    <verse number="6" style="v" />Thalah tobang ahin nikho hi, aman lhumkah-a acholdo theina din, ama-a konin kiheimangin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu thingphung khat chu kiphuh lhu jongle, ajih ahung dondoh kitding le, chule hiche abah kisepthah chu atanden louding kinepna aneijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajung chu leinoi'a motgam henlang, aphungbul chu leinoi'a thi jongle;
  </para>
  <para style="p">
    <verse number="9" style="v" />Twija konin hichu hung mumdoh kitnintin, chule thingphung banga abah ahinsepdoh nahlai ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin mihem athin, manthei louvin paimang ahijitai: henge, mihemin alhagao alhajin, hoija umji-a hitam?
  </para>
  <para style="p">
    <verse number="11" style="v" />Twipia kona twiho alhahsam bangle, twisoh lai akana agot jeng bangin;
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun mihem chu a-imu miljin, athoudohji tapoi; vanho jouse abeito kahse-a amaho khang taloudiu, alupnaova kona thou jong thou taloudiu ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />O nangin nalungsatna abeikah-a guh thima neikoija, lhan khuh sunga hi neisel ding hija; nangin keija dinga phat khat neitep peh-a, chule neigeldoh kit ding hitavele!
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihem khat athile ahingkit dem? kakikhelna ding nikho ahung lhun kah-a, keiman eikiteppeh phat nikho ho chu kanga ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman neikouvin natin, keima kahou ding; nangman nakhutsem chunga hi ngaichat nahin neiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu tun nangin kakalse jat nasima; chule kachonsetna hi navet lhih jing hilouham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Kasuhkhelna hi sakhao sunga khumtupmin aumin, chule kakhan gitlouna nangin nakhui chahjin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule thonlou hella molsang hung chimma ahal halla mang ding, chule songpi chu aumna-a kona kitoldoh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Twijin song ho alhoh mangin; nangin leivui lah-a kona hung kehdoh thil jouse chu twijin nasumangin, chule mihem kinepna chu nasumang tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangin ama a-imatih-a din najouvin, ama achetai; nangin amaiso nakhel peh-in chule nasolmangtan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Achapate chu jabolna pedin ahungun, ahin aman hichu ahetapoi; amaho suhnemin aumtaovin, ahin aman amaho ageldoh tapon ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla atahsa chun natna athoh ding, chule ama-a um hinna chun pul adou ding ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Teman mi Eliphaz'in adonbutnin, aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Michingin pannabei thu aseidohjia, chule solam huija asung asuhdim ji-em?
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman phatchomna umlou thu kisei chu anel ding ham? ahiloule thilpha bolna theilou thu aseiding ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahi, nangin kichatna napaimangin, chule Pathen anga taona nasutange.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu nakamin nakhangit louna aphondoh-a, chule doha lheplhahna lei chu nakilhen ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nakamin nangma themmo nachan ahin, keima kahipoi; henge, namuh-in nangma dounan thu ahettohsah-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ana peng masapenah mihem chu nangma nahim? ahiloule mol le lhangho masanga ana kisema chu nangma nahim?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangin Pathen thuguh chu najahkhah am? chule chihna hi nangma sehseh-in naneija nangaito ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Keihon kahet louvu nangin ipi nahet em? keiho-a umlou nangin ipi hetthemna naneijem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Kalah uvah napa sanga gamchenga upajo, lukangle, tehsejo a-umui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen'a kona lhamona hohi nadinga thilneo ham? nadinga aguh-a um thil ipi umem?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ipi dinga nalungin nangma napuimang hitam? chule namit nin ipi aphet lhap lhap piham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitia chu nalhagao Pathen douna-a naleheija, chule nakama kona hitobang thuho hi naso dohsah hitam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihem chu ipi hija theng tei ding hija ham? numeija kona penga chu chonpha teiding hija ham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Veovin, aman amithengte lah-a tahsana akoipoi; henge, ama mitmun van ho jong atheng pouvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khan gitlouna twi banga donna mihem hi, ichanna lenjo-a thet umle theng lou jocheh-a hitam?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngaijin, keiman navetsah-inge; chule kamu tah chu kaphon doh ding ahin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Miching hon apateova kona anaseiju, chule aselmang louvu;
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitobang miho henga bou chun leiset hi anakipen, gamchom mi alah uva vahlea aumpoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi khang gilou chun ahinkho lhum keijin natna athoh-in, chule ahinkho kum jat chu misugenthei pa-a akiselin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tijat umtah awgin chu anakhanga agingin; aphatthei laitahle mi sumangpa achunga hung lhung ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Muthima kona kiledoh ding kahi ti aman atahsan joupon, aman alouna ding chemjam chu angah-in ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama an holnan avah kimvelin, hoija uma hitam? atin, thimjin nikho gotsa chu ahungnai tai, ti ahen ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lungkhamna le lung genthei na-in ama akichatsah ding; leng khat galsat dinga akigot banga, amahon ama ajokhupdio ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu aman akhut Pathen dounan alhangdoh-in, hat chungnung pen douna-in amale ama aki suhatnin,
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama, ama chungle angong chang chung gei, chule alum satah ho chunga chun alhailen ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu aman amai chu athaovin atomin, ataija chun athao akikhol khome.
  </para>
  <para style="p">
    <verse number="28" style="v" />Suhmanga umdinga gotsa, koimacha chen khah louna, khopi kamhelsa-a um inho-a chun ama achengin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ama haodoh lou ding, anei agou jong umjing lou ding, aman leisetna hiche ho-a chu ninglhinna aneisot lou ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama muthima kona potdoh talou ding; meikongin abahho chu aleo got ding, chule akama ahaina hu-a chu ama jammang ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama chu ahomkeo tahsan dinga kilhemlha-a hihih hen; ajehchu ama kilethuhna ding chu ahomkeo ahibouve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hiche hi ama phat masanga kisu bulhit ding, chuleh ama bah chu ana hing lou ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman lengpithei banga amin lou agaho chu aholhah ding, chule apah chu olive banga apaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ajehchu miphalhem kikhomho chu kamhel ding, nehguhna houbuh chu meija kisumang ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amahon thilphalou naovop in avopmun, ahomkeo ahungsoh-in, lheplhahna chu a-oijuva akigongjin ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />chuin Job'in adonbutnin, aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman hitobang thil ho tamtah kajai, mi sugenthei dinga lhamon sah-a panga chu nangho nahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pannabei thuho hin akichaina aneijem? ahiloule ipin nasuh thouva hitia chu nadonbut ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nahinnao hi keima hinna khela hinga hileh, kenjong nangho bangin kaseithei ding ahin; nangho douna-a thuho kasei doh ding, chule kalu hi kathin khum ding nahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin kakamin nangho suhatning ting, kakama kona pot thu chun nahahsat nao angaijang ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman seijong leng kahesohna hi oldom dehponte, chule keiman thoh thoh jong leng ipiham kanopna ding?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin, tun aman eithacholsah ahitan, nangin kagol kapai ho jouse nasuh kamhel ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keima douna-a hettohsah din nangman kapuma tivoijin neikoijin; chule kamaija hettohsahna hidin, katahsa agong lhan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman alung hanna-a eibottelin, keima eihotai; aman kachunga aha eigel khumin; kamelman mitsal tengin eive-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon kachunga akamu lentah-in akah-un; isahlou tah-in kabengphe abengun; keima dounan amaho akikhom khomun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen'in ama ngaisah lou mite henga eipedoh-in, khang giloute khutna eipaidoh tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keima nom-in kana umin, ahin aman ahal halin eisuchiptan; aman kalollin jong eimanin, eithingin, ama bidoija din eitungdoh-e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Athal kap hon eium kimvelun, aman kakalteni khenlouhellin asukhenin; kathinkha tolla asung lhan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman setna chunga setna-in eisusetan, kachunga milen mihat tah bangin alhailen ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Katahsa vou chunga hin khaodip pon kakikhun, chule leivui lah-a hin kaki asuboh tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kamai hi kaka kanan asan dohtan, kamitgeiho hi thina le-lim alange.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kakhut tenihi thildihlou imacha-a din kamangpon; kataona jong hi atheng ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo leiset, nangin kathisan hi vuhmang hih-in, chuleh kaka nahin mun neihih hen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujongle tun, veuvin, keima hettohsahna chu van'a aume, chuleh kathu kichinna bu chu chungsanga aume.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kagol tehon nasahmon eibolun; ahinla kamit lhihi Pathen heng lama along jinge.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihem khat a-inheng dinga atao bangin, mihem khat dinga mikhat Pathen'a taopeh ding uma hile o!
  </para>
  <para style="p">
    <verse number="22" style="v" />Kum phabep ahung lhunteng, hung kile kit lounading mun'a chu keima kache ding ahitai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kahaina hi akemtan; kahin nikho hojong alhasuhtan, keima dinga lhan khuh ho chu gotsa ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi nelpeh ho chu kakoma um hilou ham? ami phin lunghang nao hi kamitnin avet lhih jing hilou ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun, keima nanga dinga kitepna khat nin nei umsah-in; keima to kikhutsan ding chu koiham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu nangman alung thimu chu hetthem theina-a konin nasel mangpeh-in; hijeh-a chu amaho nachoisang louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Agol apaiho henga pachat lhem thuseipa chu, achate mit ngeijong khomulouva umding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mite seichah thei din jong aman eisem dohtan; chule phat masalaija chu min achil aset khum mi tobang kana hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kahesoh na jeh in kamit jong hi athimin, katibah hojong nilim kihei abangtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Milungdih hochun hiche hi kidang saovintin, themona neilou michu miphalhem dounan amale ama kitildoh inte.
  </para>
  <para style="p">
    <verse number="9" style="v" />Michonphan alampi jong kituh chah intin, chule akhutho thengsella umsah jingpa chu hatcheh cheh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin nangho jouse vang, tun hungkile kitnun lang, hungun,; ajeh chu keiman nalah uva hin miching khat jong kamu doh joupoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kahin nikhoho achetan, kathil gon hole kalunga kagelho jeng jong abonin achavaitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hicheho chun jan chu sun aso-un; muthim jeh-in khovah achome.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman ngah taleng, lhankhuh chu ka-in ahitan; ka jalkhun chu muthim lah-a kakisemtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiman monmang thei jah-a chun, nangma kapa nahi; lung jah-a chun, nangma kanule kasopinu chu nahi, kati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Achutile tu-a kakinepna chu hoija umtam? kakinepna vangchu kon amuding hitam?
  </para>
  <para style="p">
    <verse number="16" style="v" />Leivui toh kichoh halla kicholdo kahung hitenguleh, amaho aki khahtup kotong lam jona chu chesuh ding ahiuve.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Shuh mi Bildad nin adonbutnin, aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Thuho nachaina ding chu itih chan hiding ham? melchih-in, chujouteng keihon seijuvinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ipijeh-a keiho gamsa-a eiki simuva, chule namitmu-a man mo-a eikigelu ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Alung hanna-a amale ama kimal teljia; nang dinga leiset hi kidalha ding ham? chule songpi chu aumna-a kona kichondoh ding ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Henge, mi khang gilou meivah chu kisumit ding, chule ameikonga meisi chu vahdoh louding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahoubuh sunga meivah chu thimding, chule athaomei chu ama puma kisuhmit thading ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Athahat lai kalsena ho chu kisu chom ding, amatah thumopna chun ama asotlhah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu amatah kengchun ama lenthang sunga akhumlutna, chule ama thang kikam chunga vahlea ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thangin akhotal jum-a akhi khah ding, chule gucha michompa chun ama ajo ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama dinga thang kikam chu leinoi'a akivuijin, athangchu lampia akidoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tijatna hon ning jouse-a ama akichatsah ding, akeng geija ahin no ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Athahatna chu gilkel thohna hung hintin, chule manthah na chu ama-a gotsa hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichun atichung vun thaneina chu aval lhum ding; thina peng masapen ngeichun athahatna avallhum ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama thil tahsana chu a houbuh sunga kona kila dohding, hichun ama tijat umtah lengpa henga ahin lhut ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichu ama houbuh sunga hung cheng inte, ajeh chu ama-a khatcha ahitapoi; ama chena chunga chu meile kaat kithejal ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajung ho chu noilanga gopgamin tin, chule chung langa abah chu kisat lha ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama kigeldoh jingna chu leisetna kona mangding, chule aman khopi lamlena min kiphah pohna aneilou ding ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama khovah-a konin muthim lah-a nodoh-in umintin, chule vannoi'a kona kideldoh hiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman amite lah-a achapa le asopiten ahin chapate aneilou ding, chujongle achena sung ho-a ahinga um umlou ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ana che masa hon tijatna ana nei banguva, ama nunga hung ho chu ama nikho nileh kidang asah diu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tahbeh-a hitobang hi mi khang gilouho chena chu ahin, chule hiche hi Pathen hepha louho mun chu ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Job'in adonbutnin, aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanghon itihchan kahina hi nasuhgenthei uva, chule thua ahal hala suhchip ding neigotnu hitam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche somvei jenhi i-sah louvin neibolun; kahenga hetkhah lou mibanga nachonu hi jachatnan naneipouvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule bolkhel kanei hijeng jongle, kadihlouna chu keima-a umding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tahbeh-a keidouna-a nangho kichoisang nahiule, i-sah louva eikibol nahi keima douna-a nelkalna mang nahiule;
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun heovin, Pathen'in keima eisot lhah ahitan, chule alen thang chun eiumkivel ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veovin, keiman dihlou na-a konin kasamin, ahin eikijah peh tapoi; hatah-in kasamin, ahinla thutana ima aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keima kache thei louna din, aman kalamlhah na-ah pal agenin, chule kalam lhahna-a thim ajin sah-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman kaloupina eiho lhah peh-in, chule kalua konin lallukhuh aladoh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman keima lam jouse-a eisumang tan, keima akichai kahitai, chule aman kakinepna hi thingphung banga abodoh ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman keima dounan alungsatna jong akoudoh sah-in, chule amelma holah-a khat bangin eisimtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Agalsat mite ahung khomun, keima douna din lampi akisemun, chule kahoubuh kimvela gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman kasopite keija konin gamlatah-in akoijin, chule keima kimel hetpi hojong tahbeh-a keija kona achoma umdoh ahitaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka-in kote alosamtan, chule kaki ngailutpi gol le paihon eisumil taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima in'a cheng mite le kasoh numei hon gamchom min eisim taovin; amitmu uvin gamchom mi kahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman kasohpa kakouvin, ahin aman eidonbutpon; kakam tah-in ahenga kataovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kahaina hu hi ka-inneipi-a dingin ajatchom tan, ka-insungmite dinga jong deimo-um kahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahi, khangdong chapanghon i-sah louvin eibolun; kakipatdoh in ahile, keidouna thu aseijun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaki ngailutpi tah golle paihon eihot bolun; kangailut ho chu keima douvin apang taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kagu hi kavunle kaphe toh akikamat tan, keima kahani vun sehseh toh hoidoh kahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />O nangho kagol kapaiten neilungset nun, neilungsetnun; ajeh chu Pathen khut chun eitong khatan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ipi dinga Pathen'in eibol genthei banga nanghon neibol genthei uva, katahsa thoh nahohi phaset nasah loulai uham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ohe, tun kathu hohi sutlutnin umtavele! Ohe, hiho chu lekhabua kitat doh-a hita vele!
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiho chu thih lekhabu sutna mol chule ngenin songpi chunga, a-itih-a dinga kigeitong hitavele!
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajeh chu eilhatdohpa chu ahingin, chule ninunung lamle leiset chunga hung ding ding ahi, ti kahei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule kavun bannin hiche katahsa hi lunghon ne manghel jeng jongleu, katahsa tah-a Pathen chu kamu ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kasunga kalung thimgil jun manghel tajongle, keima-a dinga ama chu kamu ding, chule kamit teni-a kavet ding, adang ima kamulou ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu keija thiljouse bul akimudoh chu namudiu ipidinga eihon ama isuh genthei diuham? nati diu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chemjam chu nanghon kichaovin; ajeh chu thutana aume ti nahet theina dinguva, lung hana chun gimbolna chemjam ahin lhut ding ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Naamath mi Zophar'in adonbutnin, aseije;
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun kalunggel hohin eidonbut sah-in, hiche thua ka kinon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima ima eikisahlouna thu kajan, kahetthem theina lhagao chun donbutnin eitin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Leiset chunga mihem aki koija pat, nangman hiche thului hi nahetlou ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitia chu migilou kichoisang na hi chomcha bou ahin, chule miphalhem kipana jong mitphetkah bou hilou ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Alul nachun vanho chan pha henlang, aluchun meibol ho lah phajongle;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama a-imatih chana a-eh banga mangthah ding; ama anamu kha-a miho chun, ama hoija um hitam? atidiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama mang banga leng manga, kimudoh lou ding ahitan; jana gaothilmu banga ama delmanga umding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama anamua mit jong chun ama amukit tah louding; chujongle ama ana-umna mun jong chun ama amukit lou ding ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Achaten mivaicha lunglhaina ding hin holuntin, chule akhutnin athilhou alepeh kitding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aguho chu akhang dong laija chonsetna adimin, hiche chu amato leivui lah-a luptha ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gitlouna chu a akam sunga lhumlheh henlang, aman hichu alei noija seljongle;
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman hichu khendoh hen, chule notthap dahen, akamsunga chuti koiden tajongle;
  </para>
  <para style="p">
    <verse number="14" style="v" />A-oija um anchu akikhelin, asungah gulse thinkha asohtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman haonaho aval lutnin, chule ahin lohdoh kit ding; Pathen'in a-oija kona ahin paidoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman gulseho gu achepding; gulse leijin ama atha ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman vadungho le twisohho, khoiju le bongnoi lona vachadung ho amulou ding ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman acholna man alepehdoh kitna, chule hichu aman aval lhum louding; athil nei dungjuija alepeh kitna jong hiding, aman hichea chu lung lhaina anei louding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh chu aman mivaicha agotchepmin, anungsunin; chule aman asahdoh hilou in chu pumhatnin alapeh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thonlou hella aman asunga damna aneilou ding, chule angaichat ho imacha ahuhdoh jou louding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A-anneh na-a amoh kidalha khatcha umlou ding; hijeh-a chu koiman aphatna amulouding ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aninglhina pentah chun ama agentheisah ding, khang gilou ho khut jouse chu achunga hung chuding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A-oipoh suhdim ding agot petle, Pathen'in alungsatna chu achunga ahin selhah-a, a-anneh laitah leh hichu achunga go banga julha ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama thih-a kisem manchah-a kona jam ding, chule thihtah-a kisem thal chun ama asut pailet ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Akiloidoh-in, atahsa-a kon chun ahung dohtan ahi; ahi, chemjam val lahlah chu athinkha-a konin ahung doh-in; tijat umtah ho chu achunga achutai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Muthim jouse chu guthim muna selmanga umding; huijin asemmit joulou meikongin akah vamding; aponbuh sunga kidalha chu ama dinga natna hiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Van'in ama khangitlouna chu hin phongdoh-in tin; chule leiset chu ama dou dinga hung thoudoh ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A-insung khantouna chun adalhah ding, chule athilkeo ho chu Ama lungsatna nikhole long mang ding ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiche hi migilou pa chanding Pathen'a kon chu ahin, chule Pathen'in ateppeh goulo chu ahitan ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla Job'in adonbutnin, aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Kathusei hi lunglut tah-in ngaijun, chule hiche hi nangho kilhamona hihen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman kasei theina din thoh hamham tadiuvin; chule kasei chai tengle nei nelpeh naovin nate.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima vang, kakiphina hi mihem lama ham? chuti chu hia ahile, ipi dinga kalhagao suhboija umlou ding ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Neimel chih unlang kidang saovin, chule nakhut nun nakam simun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman kageldoh teng jongle kati ajan, chule katahsa hi akithing jin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ipi dinga migilouhi hing jinga, hung tehji-a; chule thahat thaneitah hijiuva ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Achateu chu amaho mitmu tah-in amaho toh phudoh than aumin, chule achilhahteu chu amaho maikoh-a phudoh-in aume.
  </para>
  <para style="p">
    <verse number="9" style="v" />A-in hou chu kichatna-a konin ahoidoh-in, achunguva Pathen lungsatna moljong achujipon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abongchal houvin anou ahinsah-un, athona aumpon; abongpiu houvin anou ahingun, anou adalha khapon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon achateu chu ganchahon bangin asoldoh jiuvin, acha teo alam alam jiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon khongcha le selangdah akichoijun, tumging kitumgin na-a chun akipah-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon ahin nikhou chu haosatnan amang jiuvin, chom louvin lhan khuh-a achesuh ji taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun amahon Pathen henga, keiho-a konin potdoh tan; ajeh chu nalampi ho hetkhen theina chu keihon kangaicha pouve, atiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keihon kajendiu Hat chungnung amachu ipiham? Keiho ahenga kataovule ipi phatchomna kanei diuham?
  </para>
  <para style="p">
    <verse number="16" style="v" />Veovin, athilu chu akhutnuva aumpon; migilou thumopna chu keija konin gamla tah-in aumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mikhang gilou thaomei chu ichana kimutmit matchet jinga hitam! chule amanthahna chu achunguva ichana lhung matchet hitam! Pathen'in alungsatna-a lung gentheina hi ahom dohjie.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaho huipi masanga chang kong gosa tobang ahiuvin, chule hui leh gon apohmang changsi tobang ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathen'in amapa khansetna chu achateuva din akholpehjin, amapan ahetthei nadin lethuhna apejin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amit tenin ama kisuh mangna chu amuding, chule Hat chungnung lungsatna chu adon ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu ahin nikho lhajat ho akimlaitah-in sattanin umtaleh, anunga ipi nopna insunga anei ding ham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman mi chunglama umho thu atanji-e ti munasa-a, Pathen chu hetna kon ahil dingham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Mikhat chu lung nomsa chamkimin, athalhin laitah-in athi jin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anoi teni chu noitwi adimin, chule aguho chu lhintwi adimin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule mi abangchu hinkho hahsa tah-in athijin, kipah-in ima anekha pon ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amaho chu leivui lah-a thakhatna lumdiu, chule lungin amaho atomchah ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Veovin, keiman nalunggel hou, keima douna-a thilgon dihlou nangaito hou jouse chu kahen ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajeh chu nanghon, leng chapa in chu hoiche hija? chule migiloute chenna mun chu hoilai ham? nati uve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lampia chelea miho chu nanghon nadoh khah lou uham? chule amaho melchihna chu nahet lou uham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Mikhang gilou chu manthah nikho-a dinga kikoija hilouham? amaho chu lunghan nikho-a hung kipuidoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Koiham alampi ding amaikoh-a phondoh peh thei dinga? chule kon athilbol na chunga lethuhna apeh ding ham?
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeng jongle ama chu lhan khuh-a kipui ding, chule buikhuh sunga umding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Phaichama leilhang ho chu ama dinga lhumtah hiding, amasanga simjoulou miho ache banga, mitinin ama nungchu ajui ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Achutile nathil donbut naovahin jouthu aume ti namunasaova, ipi dinga pannabei ja neilhamonu ham?
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Teman mi Eliphaz'in adonbutnin, aseije;
  </para>
  <para style="p">
    <verse number="2" style="v" />Achinga jong chu ama dinga bou phachomthei ahijeh-in, Pathen'a dinga mihem hi phachom dingham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma chonphatna hi Hat chungnung dinga lunglhaina hinam? ahiloule nalampi ho nachamkim sahna hin ama aphatchom sah hinam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma nagin jeh-a aman napho ding ham? ama nangto thupi tanna-a lutkhom ding ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nakhan gitlouna hi lentah hilou hija, nakhansetna hohi akhon nabei hilou ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajeh chu nangin nasopipa-a konin pannabei jin kitepna thil nala-in, chule aponsil ho nahoh lhan sagoh keovin naum sah-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangin thachol techu donding twi napepon, chule changlhah chu agilkel ho-a dingin naphalpon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin mihatpan vang leiset aneijin, hia chun gin umtah mihem chu achengin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangin meithai ho chu khutgoh keovin nasol mangin, chule paneiloute thahat chu aki subong tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun nakim vela thangho akikamin, hetmanlou kichatnan nasuboi tai;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahiloule kho namu thei louna din thim ajingin; chule twisoh chun nachup tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen hi vanchung sanga um hilou ham? chule ahsi ho sandan khu vetemin, amaho iti sanna sang hitaovem!
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nangin, Pathen'in iti ahet hija? aman meipi thim lah-a thu iti atan theiham? tin naseijin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meilhang satah ho khu aman amuthei louna dinga akhukhuma pang ahin; chule ama van'a avahkimvel lejin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi khang gilouvin ajotji lamlui chu namel chihji em?
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiho chu aphatnu lhin masangin satlhah-in aumjin, akingapna bul chu twisoh-in achuptai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiho chun Pathen henga, keiho-a konin potdoh-in, Hatchung nungin amaho-a dinga ipi abol thei dingham? atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijongle aman a-in ho chu thilphan adippeh-in; mikhang gilou thumopna vang chu keija kona gamlatah ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Michonphan hichu amun akipahjin; chule themona neilou michun, i-sah loutah-in anuisat khumjin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichan chun eiho neilegou suhmangin aumpon, ahinla amaho-a amoh chengse meijin akavamtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tun nangma amatoh kiheton lang, chule lung mongin umin; hichun nangdinga thilpha ahin lhut ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nahenga katao ahi, akama kondoh danthu chu kisanin, chule athu chu nalungthim sunga khol khomin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hat chungnung pen henga nakile kitna ahile, nangma kisadoh-in natin, nangin khansetna chu nahoubuh ho-a kona gamla tah-a nakoi mang ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuteng sana chu leivui banga nakhola, chule Ophir sana chu vachadunga songho banga nakhol khom ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiteng chule Hat chungnung chu nahongbitna hintin, chule dangka ninglhing setna naneiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutengle nangman Hatchung nungpen nachun kipana neijin natin, chule Pathen lama namai nangat ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangman ahenga taona neijin natin, aman nataona angaiding, chule nakitepna chu napeh ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangman thupeh khat jong naphondoh ding, hichu nachunga tohdoh-a hung umding; chule vahchun nalampi ho asalvah ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mihem hi akisuh lhah tengle, kitundoh-na aum jie, tia naseiding; aman mi kineosah chu ahuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman themona neilou mi chu ahuhdoh ding ahin, nakhut teni thenna-a chu kihuhdoh ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Job'in adonbutnin, aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kakiphina hi tuni chanin akha-in; kakhoisatna sangin kahesohna hi agihjon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Oh ama touna mun ngeija kahung lut theina dingin; keiman ama chu hoijah kamu doh thei tadem?
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman amasanga kachung thu lhut ingting, chule kakam sung nelkal na-a kadip ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman eidonbutna ding thuho chu kihetning ting, chule kahenga asei ding chu ipi ahi, kahetchet ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman athahat thunei na-in kachung thu eiseipeh dem? Chutiponte, aman keija hi thahatna ahinkoijoh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Michonphan chua chu amato thu aseikhom ding; hitia chu thutana-a kona keima a-imatih-a dinga huhdoh kahiding ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Veovin, keima malama kachen, ahin ama hia chun aumpoi; nunglama kachen, ahin ama kahe dohpon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman akhut veilama na atongin, ahin ama kamupon; ama kamu theilouna dingin akhut jetlama akiselin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin aman kakalsena lampi ahen; aman eipatep teng keima sana toh kahungbah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kakeng phangin ama kholhahna ho achonin; ama lampi chu kaching jingin, kavah doh khapoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama thupeh-a konin keima nungjong kanungchon kitpon; ama kamsung thuchengho chu ka anneh thilkhoh pen sanga twijon kangai sangin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin ama lungthim khatseh pu ahin, aman angaitoa bolding ati chu kon aheikon jouding ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu keima dinga kitepsa thil chu aman atongdohjin, chule hitobang thilho chu akoma tamtah aume.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun lungkhamin amasangah kaumin; kangaiton ahile keiman ama kakichan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajeh chu Pathen'in kalung asu nemin; chule Hatchung nungin eilung khamsah-e,
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu keima muthima kona suhmang kanahipon, kamai jong muthim ana khu khum sahpoi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ipi dinga phat hi hat chungnung pa-a kona selmanga aumlou munasa-a, ama he-a miten ama nikho ho chu amulouvu ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi konkhat in gamgi achonji-un; amahon pumhatnin gancha hon alamang jiuvin, hia chun akivah jiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahon paneiloute sangan chu ahoi mangun, meithai bongchal chu kitepna thil dingin amang jiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon angaichate chu lampia konin anodoh-un; leisetna vaichate chu akisel mangji taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Veovin, nelgama gam sangan bangin, amaho anatoh naovadin apot doh-un; neh ding holin akipat doh-un; gamthip gam chun amaho dingle achateu dingin neh asodoh-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho amitakipmin louva chang aki-at cheh-un; chule amahon khansetna lengpiga chu aloh khomun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon sagohkeo chu pon beijin ajan gesah-un, hitia chu amaho daplaija silding neilou ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho molsang ho-a gotwijin akotnun, kiselna ding deinan songpi akolun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amahon pa neilou chu anu-anga konin asat lhaovin, vaichate-a konin kitepna thil ala jiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon pon beijin sagoh keovin ache sah-un; chule gilkelpa-a konin changphal alah mang peh-un;
  </para>
  <para style="p">
    <verse number="11" style="v" />Abang hou sunglama thao aheh-un, alengpiga hou achilun; dangchah athoh-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihem hi khopi sunga konin khoisan aumun, akimavo miho hinna ataovin; hijongle Pathen'in amaho chu ngaipeh-in aneipoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho khovah douna-a kiphin mite ahiuvin; alampihou ahethei pouvin, hiche lampia chun umjong aumthei pouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tolthat ho khovah le athouvun, vaichale ngaicha jingte athat jiuvin, janle gucha abangun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jonthanhoi bolnom mit jongchun khothim angah jingin, koiman eimu ponte tin, amaiso akikhelsah jin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sunteng melchihna akisemu in hochu janteng avut jiuvin; amahon khovah kiti ahepouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu amaho din jingkah chu thina le-lim toh abangin; khat touvin amaho ahetnule, thina le-lim kichan aumjiuvin ahi
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama twi banga ganga ahin; achanu chu leisetna gaosap ahin; aman lengpilei ho lampi chu amuphapon ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gamgot le nichang satnin buhbang twiho ajunsah tan, hitobanga chu lhankhuh-in jong michonse te chu abol ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Naobun amachu asuhmil ding; lungin amachu nomsa tah-a kivahnan neijintin; ama geldoh-a umtalou ding, chule khan gitlouna chu thingbanga phuhlhuh-a umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman cha neilou achinga chu kivahnan mangchan tin; meithai chunga thilpha abolpeh louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman mihatpa jong chu athaneinan akaijin; ama akipat dohjin, chule hinkho kicheh tah mihem koiman aneipoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Akicholdo nadin, bitkeicha aumna ding kipe jongle, amit chun alampi hou avetjing ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amaho phat chomcha dinga kichoisang ahiuvin, ahinla suh nemin aumin akichaijitaove; amaho alampiuva kona midangho banga kimandoh ahiuvin, changvuileh kisih tan banga kisattanji ahi taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule tun hichu ahilouva ahile, koiham keima eijousah-a, chule kathusei pannabei ahi tiding chu?
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Shuh mi, Bildad'in adonbutnin, aseitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vaihom nale kichatna chu ama-a aumin, aman amunsang ho-a chamna aumsah-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Agalsatmite ho ajat umthei ngaijem? chule achunguva avahsodoh louna mite umem?
  </para>
  <para style="p">
    <verse number="4" style="v" />Achutile mihem hi Pathen angsunga iti themchang thei dingham? ahilouleh numeija kona peng mihem chu iti thenjou ding ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Lha jeng jong khu veuvin, avahjipon ahi; henge, ama mitmu-a ahsi ho jong athengpon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lungtol bangbep mihem hi ichan geija lhasamjo ham? mihem chapa hi, lungtol bangbep hia hitam?
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla Job'in adonbutnin, aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin tha neilou mi chu iti nakithopi-a, tha neilou ban chu iti nahuhdoh-am?
  </para>
  <para style="p">
    <verse number="3" style="v" />Chihna neilou mi chu nangin iti nathumop ma? chule ahina banga thilchu iti lhingsetna naphondoh am?
  </para>
  <para style="p">
    <verse number="4" style="v" />Koi koma nangin thuho naseijam? Chule nanga kona koi lhagao hungdoh am?
  </para>
  <para style="p">
    <verse number="5" style="v" />Thil thiho jousele chuche-a chengho jouse chu, twinoija kona kisem ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Damun chu ama masanga agohkeo ahin, chule suhmangna chun akhu ding ima aneipoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman sahlam chu ahomkeo mun chunga ajah doh-in, chule leiset chu imacha umlouva akhaijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman twiho chu meilom satah-in atomchah-in; chule amaho noija chun meilhang chu akehpon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman alaltouna maichu akhukhumin, chule ameilhang chu achunga chun akijal sah-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sunle jan ahung kichai kahsen, aman twiho chu gikhatnin aumkim velin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman apho tengle van khompiho akithing jin, chule kidang asaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman athaneina-in twipi ahom khenin, chule ahetthem na-in kiletsah ajepjin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman alhagaovin vanho ajem hoijin, ama khut chun dihna neilou gul chu aseme.
  </para>
  <para style="p">
    <verse number="14" style="v" />Veovin, hiche hohi ama lampiho ahin, ahinla ama thudol hi ichana kija lhoma hitam? athaneina van kithing tobanghi kon ahetthem thei ding ham?
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche chung chon chun Job'in athulem sei ajomin, aseije;
  </para>
  <para style="p">
    <verse number="2" style="v" />Kathu kitana ding eilahmang peh-a hingjing Pathen, chule kahinna suboija Hat chungnung;
  </para>
  <para style="p">
    <verse number="3" style="v" />Kasunga haina thei aum laise le, Pathen lhagao kanahkohom teni sunga aum laisen;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kakamin khangitlouna thu sei pongting, kaleijin jong lheplhahna thu phongdoh ponge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma them kachansah ding Pathen anompoi; kathi kahse-a keiman kadinna kachondoh louding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kachon phatna hi tuhdet jinging ting, kalhaso louhel ding; kahin lai chansen kalung thim hin eithemmo sah louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kamelma chu mikhang gilou tobang hihen, keima dou dinga hung kipatdohpa chu chonpha louteto banguhen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Pathen'in ahinna alahdohteng, phatchomna neijongle mipha lhemin ipi kinepna aneiding ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Lungkhamna achunga ahung lhunteng ataona chu Pathen'in angaipeh na dem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Hat chungnungpa-a chun amatah alung lhaina dem? phattinin aman Pathen akou nadem?
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen khut thahat dan nangho seipeh-unge; Hat chungnungpa koma um chu keiman ka-imchah lou ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Veovin, nangho tah-in hichu namu taovin; achutile ipi dinga nangho nabon chaova hitia hi pannabei, nahiu hitam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche hi mikhang gilouvin Pathen'a achan chu ahin, misugenthei ho goulo ding, Hat chungnung pa-a kon amudio chu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Achateu apunna ahile hichu chemjam'a lou ding bep ahiuvin; chule achilhahteu chu changlhah-a oiva loudiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama nunga ana umnalai ho chu thi uva kivui diu; chule ameithai hou chun aka loudiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman dangka leivui bangin kholkhom henlang, kivona pon leiset bangin gong jongle;
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichu aman gong theijinte, ahinla hichu midih-in akivon ding, chule dangka chu themona neilou ho kihom diu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman a-in chu maimom bangin asan, thil ngah-a pangpan akisah lhambuh bangbep ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihaopa chu lumintin, ahin ama gopkhoma umlou ding; aman amit ahahsahle, ama anaum tapoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tijatna hon ama twibangin achuptan, huipin jan-in ama alhoh mangtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama solam huijin apomangin, ama achemang tan; chule aumna mun'a konin khopi huijin alhoh mangtan ahi
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu Pathen'in achunga ahin selhah-a, ama akhendoh louhel ding; ama khutna kona ama lhasama jamdoh ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihon ama khut abeh khumuva, chule aumna mun'a kona aphisanuva anodoh dingu ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tahbeh-in dangka-a dingin akhuh aumin, chuleh sana-a dingin akilhit thengna mun aumin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thih hi leisetna kona kiladoh ahin; chuleh sum-eng hi song lah-a kona kiladoh-a kilhajol ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama muthim akhona geijin achen, muthim le thina le-lim changei songho chu agaholin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman mihem umlouna-a le chotkhah louna mun'a leiko avutnin, mihem'a konin gamlha tah-in akikhaijun, suh le tunga akivat leuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Leiset hi ahileh, hichea konhin neh ahungdoh-in, anoilang vang meikong tobanga hungsoh doh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche mun'a songho chu khisongdum ahin, chule hia chun sana di aumin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chungleng vachan ahetkhahlou, muthong mitnin amukhahlou, lampi khat aumin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Keipi bahkai nouvin achotkhahlou, keipi hangtah-in jong ahokhahlou lampi khat aume.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman akhutchu songpi chunga akoidoh-in, aman molsangho chu abula konin alehkhup jenge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman songpiho lah-a vadung alaidoh-in, thil manlutah hojouse chu amitnin amun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman alonlet louna dingin twisoh ho chu atingin, chule anakisel thilho chu aman khovah-a ahinpodoh-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla chihna chu hoija kimu ding ham? Chule hetkhen themtheina munchu hoilai ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihemin hicheho manlut dan chu ahedoh joupoi, ahiloujongle mihing gamachun hichu akimudoh jou dehpoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche chu keija aumpoi, tin twi thuhtah chun aseijin, hiche chu keija aumpoi, tin twipin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche chu sana-a jong chohjou ahipon, ahilou jongle hiche manding chu dangka-a jong lepjou ahipoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ophir sana mantam tah ahilouleh khisongdum manlutna toh tethei ahipoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sana le songval toh kibanga ahipon, chule sana-a kilhatheng thil mantam tah tojong lhehthei ahipoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Songmantam san ahiloule twikohchang hojong gahmin phahthei ahipoi; ajehchu chihna manlutdan chu song mantam phapen sanga lujo ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ethiopia khi song engtoh kibanga jong ahipon, ahilou jongle sanatheng manlutna tojong kibanga ahipoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Achutile chihna hoija hungkon hija, hetthem theina munchu hoilaiham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahingthei jousele mitmu jouse-a kon kisel ahin, chungleng vacha jouse-a kona akiselmang ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Manthahnale thina-in, hiche chungchang thulhut hi kanakhang hona kajalhonin ahi, ati lhone.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathen'in hiche lampi chu ahekhenin, chule aman hiche laimun chu ahen ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajeh chu aman leiset kichaina ding gei aven, vannoi pumpihi amun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huidingin agih tena ding asemin, chule aman twiho chu agih tena-a aten ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman go henga thupeh anapeh-a, van ginle kolphe dinga lampi anasemachun:
  </para>
  <para style="p">
    <verse number="27" style="v" />Chua chun aman chihna chu amun, aphong doh-in; aman agongin, henge, chule hichu aholdoh-in ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule mihem jah-a chun aman aseijin, veuvin Pakai ginhi chihna chu ahin, chule setna a kona jamdoh chu hetkhen themna chu ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukal valin Job'in athulem ajompeh-in aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />O Pathen'in eichintup nikhoho, achesa lhaho-a chu keima ana uma hileng;
  </para>
  <para style="p">
    <verse number="3" style="v" />Kalu chunga athaomei anavah-a, chule amavah-a muthim lah kanajotle lai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kakhang donlai nikhoho, Pathen thuguh chu kahoubuh chunga aumlai;
  </para>
  <para style="p">
    <verse number="5" style="v" />Hatchung nungpen pan kakoma eiumpia, kachate kakimvela ahung umlaiju;
  </para>
  <para style="p">
    <verse number="6" style="v" />Kakholhah naho bongnoi thaova kana soplai, chule songpin kadinga thaotwi vadung long banga asodohsah lai;
  </para>
  <para style="p">
    <verse number="7" style="v" />Khopi sung kotpi phunga kapotdoh le-a, khopi lamlen laija katouna kadole laichun!
  </para>
  <para style="p">
    <verse number="8" style="v" />Khangdong hon eimuvin, akiseluvin, chule tehse ho chu akipat doh-un, ading jiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pipuiho chu ahoulim laiju atang jiuvin, chule akhutnun akam akisip jiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Milen milal ho athipchet jiuvin, chule aleiju chu adanguva abehjin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nakhangin eijahteng, phatthei eiboh-in, mitnin eimuteng, hichun keima hettohsahna eipen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu keiman mivaicha pengpenga umle, paneiloute, chule kithopi ding neiloupa chu kahuh doh-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mangthah dinga umpa phattheina chu keima chunga ahungchun, keiman meithainu lungsung chu kipanan la kasah sahjin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chonphatna chu kakivonin hichun eitomin, kathutan lhah chu sangkhol len le lukhuh tobang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mitchodin mit kanahin, kengbaiho din keng kanahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mivaichate din apau kahin, chule kahet khahlou thu chu kaholdoh jin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khang giloute khagu chu kasuhboh peh-in, chule akamuva konin anehdoh houchu kasadoh peh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin keiman, neldi banga kahin nikhohohi kapunsah-a, kabuh sunga kathi ding ahi, kati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Twipanga kajung ajamin, kabahho chunga jankhon daitwi alhan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaloupina chu keija athah jingin, chule kakhutna kathalchang chu akisuthah jinge.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihon kahenga anakhangu ado-uvin, chule angah jiuvin, kathumop teng athipchet jiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kathusei joutengle amahon aseikitji tapouvin, chule kathusei chu achunguva achun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gotwi angaichat bangun keima eingaicha jiuvin; gotwi nunung ngah bangin, amahon akamu akalen jiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Keiman amaho nuisat jongleng, amahon atahsan loudiu; chule kamaiso vah chu amahon asulha pouvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Alampihou kalhen peh-in, apipu uvin kapange, chule sepai lah-a lengpa bangin kaumin, lhasete lhamonsah khat bangin kaumin ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla tun, apateu kaganhon ngah-a uichate toh pangkhom dinga jong kadeilou, keisanga khangdongjoho chun i-sah louvin eibolun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Henge, akhut thahatnaova kona ken ipi kaphatchompi ding ham? athahatnao chu beija ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lhahsap jehle keljeh-in amaho achang lhatnun, masanga ana kamhel le agohkeo gamthipma chun ajamlutnun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon nangboh lah-a vandol, chule theimi jungchu anehdiuvin abotdoh un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho chu miho lah-a konin aki deldoh-un, (amahon gucha kihoh bangin hatah-in a-aovun;)
  </para>
  <para style="p">
    <verse number="6" style="v" />Phaicham khikah dungle, leiset kotong sung, chule songpiho lah-a umdin adeldoh-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hamboh lah-a amaho chu apengun, lingphung noi dunga amaho akisukhomun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho mingol chate le, milung lhomho chate ahiuvin, amaho leiset sangin aphamo jouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun keima amaho la chu kahin, henge, keima aseichah-u kahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon eihotaovin, keija konin gamlatah-a ajamun, chule kamai chil setkhum dingjong akiphalam pouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu aman kakhao alhanenga chule eisuhgenthei jeh-in, amahon jong ka-angsunga kamdal alha nengun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kakhut jetlama khangdongho akichoisangun, kakeng asonmangun, chule amanthahna lampihou chu keima dounan aboldoh uve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon kakeng lampi asuseuvin, kahamset nading kamasanga akoijun, amaho akithopi ding aumpoi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho twipi pohjah bangin kachunga ahungun, setna lah-a kachunga ahung kitoluve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tijatnaho kachunga ahung kihei lutnin, amahon kahinna chu huibangin ahin delun, kaphat theina chu meibol bangin achemang tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule tun kahinna kachunga akisunglhan, suhgenthei nikho hon eikolchah tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jantengle kaguhon eichipjin, katha junghon choldona aneipoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kanatna hoisetna jehchun kavon akikhelsah-in, kasangkhol chol ngong bangin eikanbeh tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman bonlhoh lah-a eileh lutnin, keima vutle leivui kabang jengtai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keiman nangma kakouvin, ahinla nangman neingai pehpoi: keima kading doh-in, chuleh nangman iman neigelpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangma keima dingin nahung giloutan: na bantha hattah chun nangman neidouve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangin huijin neidom touvin; achunga chun neitou sah-in, kahinnaho nasujun lhatan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu nangman thina-a neipuilut ding, chule ahing jouse dinga kitepsa ina chu neipuiding ahi, ti kahei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Itin iti jongle amaho kisuhgepna-a kapjongleu, aman lhan geija akhut ajahdoh louding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Boina neiho dinga kanaka hilouham? kahinna hi amaho dinga analungna-a hilouham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Apha kagaldot teng, kahenga setna ahungjin, khovah kanga tengle muthim ahung lhungjie.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kalung agimlheh jin, akicholdopoi, genthei hesohna nikhon eikimai topi jinge.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nisa beijin lunghemin kavahlen, mipi kikhomho lah-a chun kading doh-in kakapme.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keima dragon ho sopile, sumbupi ho kiloipi kahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Katichunga kavun adupmin, kaguhohin eileusa henhune.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ka selangdah jong lunghemna, chule kamut gingjong akapho ogin asohtai.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiman kamit tenitoh kitepna kasemin, achutile ibola nungah kageltah dingham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu chunga Pathen'a kona chanding ipi umam? chungsang Hatchung nunga kona gou chan ding ipiham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi khanggilou dinga manthah na um hilou ham? engbolna kidangtah chu khansetna bolteho-a ding hilou ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman kalampiho amulou hija, chule kakho lhahnaho asim hilouham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Keima pannabei ja kanavalea, ahiloule lheplhahnaho-a kakal kanason gangtah-a ahile,
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen'in kadihna ahettheina dingin, khaikotnin eilep hen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kakalson nahi lampia kona akiheimanga, kamitnin amuchu kalungin ajuile, anen khattou kakhutna abetahle;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutengle muchi tungting adangin nehen; henge, kason kapahho chu ajungah kibotdoh hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Numei khatnin kalung alheplhah-a, ahiloule ka-in heng kotphunga ka chanlhih-a ahile;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuteng ka-inneipin midang ding chang suhen, chule midangho amanu chunga bohkhup uhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu hichehi thet umtah khansetna ahin; henge, hichehi thutan hon engbolna apehding khansetna chu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu hichehi manthah na geija kavamtheija meichu ahin, chule kaphat touna jouse ajunga kibodoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kasohpa ahiloule kasohnu thu chu i-sah louva kabola, amahon keima eikinahpi tengule;
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathen ahung kipatdoh tengle ikatiding hitam? Aman aviltengle ipi-a kadonbut dingham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Naobu sunga keima einasempa chun ama asem hilouham? chule khatseh-in naobu sunga einasemu hilouham?
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman mivaichate ngaichat ka-itpeh-a, ahiloule meithainu mit chu kalosamsah khah-a ahile;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahiloule ka-an chu kachanga kakineh-a, chule paneilou ten hichu anehkhah loule;
  </para>
  <para style="p">
    <verse number="18" style="v" />(Ajehchu kakhangdon laijapat amachu keimatoh hung khanglen khom ahin, pa banga, kanu naobu sunga patna amanu kahin lamhil ahi);
  </para>
  <para style="p">
    <verse number="19" style="v" />Koihamkhat ponsil lhahsam jeh-a mangthah-a, ahiloule silding neilou mivaicha khattou kamua;
  </para>
  <para style="p">
    <verse number="20" style="v" />Alungin keima phatthei eibohlouva, chule kakelngoi mulla aman lum asah loule,
  </para>
  <para style="p">
    <verse number="21" style="v" />Kotpi phunga eikithopi kamua, paneiloute douna-a kakhut kalapma ahile,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuteng kabanhi kalengkouva konin lhonglha henlang, chule kaban guhi bonglha jeng hen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Pathen'a kona manthah na chu keidinga tijat umtah ahin, chule alalna jeh-in, kathoh joupon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Keiman kakinepna chu sana kahi sah-a, ahiloule sana theng jah-a, nangma katahsana nahi, kanati-a ahile;
  </para>
  <para style="p">
    <verse number="25" style="v" />Kagou tamjeh le, kakhut hin tamtah amujeh-a kakipa-a ahile;
  </para>
  <para style="p">
    <verse number="26" style="v" />Keiman nisa ahungvah kavetna, ahiloule lhathah vahtah-a ache kavetna;
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule kalungthimhi aguh-a jol lhah-a auma, ahilouleh kakamin kakhut achopleh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche jonghi thutanpan engbolna apehding khansetna chu ahi; ajehchu chunga um Pathen chu keiman kasanlou ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keima eithetbolpa kisuhmang nikho-a kakipa-a, thilsen alhunkhum teng kakichoi sanga ahile;
  </para>
  <para style="p">
    <verse number="30" style="v" />Kakamhi chonsetna, ama hinna sapset sahna dingin jong kaphalpon ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kahoubuh mihon, Oh atahsa chu kaneilouva ahile! kalungnao chimlou ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Gampam mi khopi lamlena agehpon, ahin kholjinleho dingin kakotho kahonpeh-in ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Keiman Adam banga kasuhkhelna leh, kakhan gitlouna chu ka-angsunga kakhu khuma ahile;
  </para>
  <para style="p">
    <verse number="34" style="v" />Keiman mihonpi kakichatna, ahiloule insung mite i-sah louna chun eikichatsah-a, thipbeh-a kauma, kotpama potlouva kaum-em?
  </para>
  <para style="p">
    <verse number="35" style="v" />O khattouvin eingaipeh hitaveleh! vetan, kangaichat chu, Hatchung nungin eidonbutna, chule kaki doupin lekha ajihding chu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Thonlouva hichu kalengkouva kaputna, chuleh lallukhuh banga kakhuh ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kakholhah jatchu ahenga kaphon doh-a, vaipo khat banga ahenga kahin nailut ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kagam chu keima douna-a apenna, ahiloule langkonho jong chu hitobanga chu akiphina ahileh;
  </para>
  <para style="p">
    <verse number="39" style="v" />Keiman hiche lougaho chu sum pelouva kaneh-a, ahiloule aneiho hinkho chu kachansah-a ahileh;
  </para>
  <para style="p">
    <verse number="40" style="v" />suhlouchang khelin meithai seltholing, sakol chang khellin hampa kehhen. Job thusei akichaitai.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun hiche mithumho chun Job chu ama le ama mitmu-a achonphat jehchun, adonbutnu chu anga taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin Ram inkon Buz mi Barachel chapa Elihu lunghanna chu akoujah-in, Job douna-a ama deojah-a ahi, ajehchu ama Pathen sangin akithem chanin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amagolte thum ho douna-in jong alunghan adeujah-e, ajehchu amahon adonbutna ding amujou pouvin, hinlah Job chu themmo achanun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tun amaho chu ama sanga upajo cheh ahijeh-un, Elihu'n Job thusei kichai chu angahjing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Elihu'n hiche mi thumho kamsunga donbutna aumlou amu phatnin, alunghana adeujah tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Buz mi Barachel chapa Elihu chun adonbutnin: keima khangdong kahin, nangho upatah cheh nahiuve; hijeh-a chu keima kakichatna, kalunggel nangho kavetsah ngamlou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Upaho chun seijuntin, chule kum tamtah ho chun chihna hilinte, katin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla mihem'a hi lhagao uma ahin, chule Hatchung nungpen hu haikhumna chun amaho chu hetkhenthem theina apeh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Milenho chu ching jing jengu ahipon, mi kumtam hon jong thutanlhah themna ahetdeh-u ahipoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun kathusei ngaijun, keiman jong kalunggel vetsah uvinge, kati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vetan, nathuho chu kangah-in, ipiseiding ham tia nanghon nahol laiju chun nakihoulim naova kanakhang kanasungin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Henge, lunglut tah-in nathuseiju kangaijin, chuleh veuvin, nalah uva Job noplhah sahthei, ahiloule athuho donbut theiding khatcha na-umpouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keihon chihna kamudoh taove, tin seikhaovin nate, mihem ahipon Pathen'in ama asuhlhuh ahibouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun aman athuho chu keima douna ahipon, hijeh-a chu nangho thusei ho-a chu ama kadonbut louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon kidang asauvin adonbutbe tapouve, thu asei tapouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman kanga-a chun, (ajehchu amahon thu aseitapouvin, ading dennun, adonbut be tapouve;)
  </para>
  <para style="p">
    <verse number="17" style="v" />Kadonbut dingdol chu donbut ningting, kalunggel jong vetsah ingkate, kanatie.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu keima thu-in kadimsetnin, kasunga kalhagao hin eisol teitei tan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Veuvin, ka oipoh hi akising chah ju toh abangtai, hichehi juhai thah pohkeh ding kigo tobang ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahaldoh kit theina dingin keiman thu seijinge; kakam kangting donbut ning kate.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nahenga katao ahi, mi koimacha langneina musah dang ting, Pachat lhem thucheng mihem'ah pejong peponge.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu keiman pachat lhem thucheng pehje kahepon, hitichun bol taleng eisempan eilahdoh loiding ahi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun Job, nahenga katao ahi, kathuseiho ngaijin, chule kathu jousehi neingaipeh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vetan, tun keima kakamkan, kalei hin kakama thu aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kathuhohi kalungsung chondih na-a kon hiding ahin, chule kakamin hetna chu thengtah-a aphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen lhagaovin einasemin, chule Hatchung nungpen haina hu chun hinna eipeh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman neidonbut thei dinga ahile, nathuho chu kamasanga koitoh inlang, dingdoh-in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vetan, keimahi nadeisah dungjuija Pathen khela um kahin, keijong leinganna kisemdoh kahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vetan, tijat kaumna-in nakichat sah pontin, kakhut jengjong nachunga gihponte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tahbeh-in, kajah theijin thu naseijin, chule keiman nathusei awgin chu kajatai;
  </para>
  <para style="p">
    <verse number="9" style="v" />Keima suhkhelna beija thenga kahin, themona neilou kahin, khansetna jengjong keija aumpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vetan, aman keima douna ajehho chu amun, aman keima amelma khatnin eisimtai,
  </para>
  <para style="p">
    <verse number="11" style="v" />aman kakengteni ahennin, kalampi jouse amelchih-e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vetan, hichea hin nangma nadihpon ahi; keiman nangma donbut-inge, Pathen chu mihem sanga lenjo ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ipidinga ama douna-a nakiphin ham? ajehchu aman ama chungchang thuho khatcha apepon ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Pathen'in khatvei thu aseijin, henge nivei, ahijeng vangin mihemin ahetheipon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jan manga, janna muneina-a, mihemte chunga imut lhuhna ahung chuh-a, lupna chunga imutsona alhun tengle;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuteng aman mihem nakhang ahonpeh-in, chule amaho kithupehna chu asinkhumpeh-in,
  </para>
  <para style="p">
    <verse number="17" style="v" />Athil gona kona mihem alahdoh theina dingle, mihem'a konin kiletsahna aselmangpeh jin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kokhuh-a konin ahinna, chule ahinkho chu chemjam'a amanthah nadinga konin ahuhdoh peh-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman ajalkhun chunga natna, chule agu achangho jouse hachang natna natna-in asugimin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hitia chu ahinkho chun changlhah, chule ahinna chun anneh ahot nadinga abol ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Akimutheilou nadingin, atipum chu ajunmang tan, chule agu anakimulouho chu adoh setsot tai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahi, ahinna chun lhankhuh lam, chule ahinkho chun suhmangna chu anaijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Achondihna chu mihem musahna dinga, thupole khat, paoledoh khat, sangkhat lah-a khat amatoh auma hileh,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuteng amachu ama lungset them ahin, hitin aseije, kokhuh-a lhahlutna dinga konin aman ahuhdoh-in, keiman lhatdohna kamutai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama tipum chu chapanga sanga noujo ding, ama akhangdonlai nikho-a kilekit ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama Pathen henga taoding, chule ama chu amadinga lunglhaina hiding, chule aman kipah-a amai amuding ahi: ajeh chu aman chonphatna chu mihem apehding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman mihemho aven, khattouvin, keima kachonsetan, adih-a konin kakiheimang tan, chule hiche hin eiphatchom sahpoi, atia ahileh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman ahinna chu kokhuh-a alhahlutna dinga kona alhatdoh ding, chule hinkho chun vah amuding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ven, hiche thil ho jousehi mihem dingin Pathen'in abol jingin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Kokhuh-a kona ahinna puidoh nading, hinna vah-a vahsah nading ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vo Job, phatah in melchih in, kathu ngaijin, thipmin, thu kaseiding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangin seiding khattou naneija ahile neidonbut in, seijin ajehchu keiman nangma kathem chansah nome.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahiloule kasei ngaijin, thipmin, chule keiman chihna kahil ding nahi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Elihun adonbut kitleuvin aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo miching nanghon; kathuhi ngaijunlang, hetnanei nanghon nanakhangu hinsung uvin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu kamin an atepbangin, nakhangin thu apatepmin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eihon thutanlhah dih kilhenu hitin, ilah uva apha chu ipiham kihetnu hite.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Job'in keima michonpha kahin, Pathen'in kadihna alahmang ahitai, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima kadihna chunga kajou ding ham? suhkhel bei kahivangin kamaput hi damtheihoi ahipoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Job banga mi-isahlouna twibanga dontheijah koi umam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama khangitlouna bolhotoh akiloijin, chule miphalou hotoh akilhonlen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu aman, mihem Pathen'a kipah-a aumhin imachan aphatchom pipoi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun hethem na nei mi nanghon kathuhi ngaijun; Pathen'in khansetna abol louding, chule Hatchung nungin khangitlouna abol louhel ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu mihem chu atoh dungjuija achunga alhunsah ding, chule mijouse achonna dungjui cheh a lethuhna amusah ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Henge, Pathen'in khan gitlouna abol louhel ding, Hatchung nungin jong thu akaleh-a atan louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Leiset chunga thunei dinga kon mopohna apeh ham? ahiloule vannoi pumpi kon achunga akoiham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman mihem chunga alung koihen lang, alhagao le ahaina hu chu kilah taleh;
  </para>
  <para style="p">
    <verse number="15" style="v" />Tipumpi mangthah khomuva, chule mihem leivuija kilekit ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun nangma hetkhen themna nei nahile, hichehi ngaijin: kathusei hohi ngaiphan.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thudih hotbolpa chun vai ahomding hija? chule kitah chungnung pen chu nangin themmo nachan dingham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Lengpa jah-a, nangma khangse nahin, chule pipuiho jah-a, Pathen helou nahiuve, tiding kilomnam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahin ama pipuiho langa alangnei chompon, chule mivaichaho sangin mihaoho ajachom dehpoi; ajehchu abonchauva akhutsem ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaho mitphetkah louvin thiuvintin, chule mipi ho chu jan khangkim le suhboija umdiu, chemang diu, chule mihat hochu mihem khutjao louva kaimanga umdiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu aman mihem lamlhah avejingin, achenachan amusoh keijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khangitlou bolho kiselna dingin, muthimle thina le-lim aumpon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Pathen angsunga thutana-a lutna dinga, aman adih kalval mihem chunga akoilou ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman simthei louva mihat ho chu asuhbonga, akheluva midangho atunding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun aman atohhou chu ahen, amaho chu suhmanga aumtheina dinguvin, jankhat sungin alehkhup heltan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman amaho chu migilouho bangin midangho mitmu tah-in ajepmin;
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu amaho ama-a konin akinung heijun, chule alampi khat jengjong agelphata pouve;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutichun ahenga amahon mivaichaho kana chu alhunsah-un, aman bolgentheiho kana chu angaipeh tan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman asuhcham tengleh koiham boina boldinga? nampi douna hihen lang mikhat douna-a kibol hijongle, aman asel tengle koiham amai muthei dingah?
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutiachu mipha lhemin vai ahomlou ding, achutiloule mipi ho thanga ohding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tahbeh-a mihemin Pathen koma, suhgimna chu kathohtan, doumah bolkit taponge,
  </para>
  <para style="p">
    <verse number="32" style="v" />Kamu khahlou chu nangman neihilin, keiman khan gitlouna kaboljongle, bolkit taponge, tia aseiding chu kilom ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Keima hilouvin nangma gel bang ahidem? nangma danlang nomjongle chun, aman nalethuh ding ahi; hijeh chun nahetchu seijin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hetthemna neihon eihilen, chule michingin kathusei ngaihen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Job'in hetna jaolouvin thu aseijin, athuseiho jong chihna jaolou ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Khang gilouho dinga adonbut jeh-in, Job chu akhona geija achungthu tanding hi kalung ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ajehchu aman achonsetna chunga akiphin ben, aman ilah uvah akhut abengin, chule Pathen douna athu apun sah-in ahi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche kalvalin Elihun aseiben, chule hitin aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Kachon phatna hi Pathen'a sangin asangjoi, tia nasei chu dih dinga nagellem?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nangman, kachonsetna kona theng kahile, nang dinga phachom ipi hiding hija, keiman aphachom ipi kamuding ham? tin naseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman nangmale naumpi naloiho chu donbut-inge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Van lama dah inlang vetemin; chule nangsanga sangjo meibol ho khu vetemin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nachonsetle, ama douna-a ipi nabol em? ahiloule nasuhkhelna apunbeleh, nangman ama henga ipi nabol ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nachon phatna ahile ama ipi napeh-em? ahiloule nakhutna kona ipi amu-em?
  </para>
  <para style="p">
    <verse number="8" style="v" />Naphatlouna chun nangtobang mihem khat asuna theijin, nachon phatna chun mihem chapa chu aphatchom sah thei ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Suhgentheinaho atamjeh-in, akisugen theiho aka sah-un, mihat ho ban thahat jeh-in, apeng doh-un ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla koimachan jong eisempa Pathen, janteng la eipepa chu hoija umam? atipouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Leija gamsaho sanga eiha hiluva, chungleng vachate sanga chingjoa eisempao chu, hoija umem? atipouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chua chun apengun, ahinla miphalouho kiletsah jeh-in, koimachan adonbut pouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tahbeh-in Pathen'in pannabei chu ngai pontin, Hatchung nungin jong nahsah-a aneilouding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangin amachu muponge tijongle chun, amasanga chu thutana umnalai ahin; hijeh chun ama chu tahsan nin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla tun hitichu ahilou jeh-in, lunghan na-in agavilin, hijongle nasabehsetnin ahehhih laijin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh-a chu Job hi pannabei ja kamka-a, hetna jaolouva athusei apunsah ahi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Elihun aseijompeh-in, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Neikhongai nalaijun, chule Pathen khella seiding kanei nahlai chu, vetsah-unge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamla tah-a konin kahetna galangting, eisempa chonphatna phongdoh inge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu kathuhi nolnabei jou hilouhel ding ahin, hetna chamkimpa chu nangma toh uma ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vetan, Pathen chu thaneitah ahin, koimacha nahsahmon akoipoi; Ama thahatna le chihna-a thaneitah ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman migilou hinkho ahoidoh pehpon, mi genthei chu dihna apen ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Michonpha ho-a konin amit aheimangpon, ahinla amaho lengho toh laltouna chunga atouvun; aman amaho chu a-itih-in atungdohjin, chule choisangin aumjiuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amaho bulkituh ahiuva, bolgentheina khaova kihen ahiule;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuteng aman athilbolule, asuhkhel nao chonvalna chu amusahjin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman abilkolu chu sehgimna angaina diuvin ahonpeh-in, khansetna kona ahungkile theina diuvin thu apejin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon thu angaijuva, ama ajenule, anikhohou phattheina, chule akumhou nopsahna-a amandiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinlah thu angailou vangule, chemjam'a mangthah uva, chule hetna beija thidiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla miphalhem hon lunghanna lungthima akikhol khomun, aman amaho ahen tengle atao jipouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho akhandon laijun athiuvin, ahinkhou chu mithenglouho lah-a aumjin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Migenthei chu bolgentheija aumna-a konin ahuhdoh-in, suhgentheina-a anakhangu ahonpeh-e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitima chun aman hahsatna-a konin napuidoh intin, suhboina umlouna mun lentah-a nachon lutding, chule nadokhanga kiluiding chu nehtuitah dimset ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla nangin migiloute thutanna chu nagui lhunsahtan, thutannale thudih chun namandet tai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lunghanna aumjeh-in chingtheijin, achutiloule ajepna-a chun nalhoh mang intin; chuteng lhatna loupitah chun nahuhdoh joulou ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman nahaona jabol intem? ajabol louding, sana ahiloule thaneina jouse jong angaisang louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Miho aumnao mun'a akisuhmangu janchu ngaicha hih-in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chingtheijin, khangitlouna ngaito hih-in, ajehchu gimbolna sangin hichehi nalheng jotai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vetan, Pathen'in athaneina-in achoisangtan, amabanga kon ahil theijem?
  </para>
  <para style="p">
    <verse number="23" style="v" />Alampi chu koijin aseipeh-am? ahiloule, nangin khangitlouna nabole, tia kon asei theijem?
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihon avetjingu, anatoh choisang dingchu geldoh jingin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mitinin hichu muthei jintin; mihemin gamlatah-a konin muthei jinte.
  </para>
  <para style="p">
    <verse number="26" style="v" />Veuvin, Pathen chu aloupin, eihon ama ihepouve, akum jatho jong holdoh jouhoi ahipoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu aman twi vatneocha cha anasemin, twimeija konin go ajulhajin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichu meibolin gomal asema, chule mihem chunga nengtah-a julhaji ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Meibol kithejal leho, ahiloule ahoubuh gingho khu mihemin ahetkhen thei jem?
  </para>
  <para style="p">
    <verse number="30" style="v" />Veovin, aman achunga chun avah ajalin, twipi todop chu akhu-in ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu aman hitiho-a konhin mipi thu atanin, an neh nengtah-in apen ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman vah chu meibolin atomin, akikah-a hungdoh meibola kona avahlou nadin thu apen ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chua hu gin chun aumdan chu avetsah-in, twimei umchan jong ganchaho ahetsah-e.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichea jonghin kalung chang akihotnin, chule achomdoh dehdeh jenge.
  </para>
  <para style="p">
    <verse number="2" style="v" />A-awgin le akama kona hungpot chu lunglut tah-in ngaijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman hichu van pumpi noi-a asolin, akolphe chu leiset kolmong geija dingin aphet sah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche jouhin aw khat ahung kitumin, aloupina aw-a chun ahung ging dumdumin, chule a-aw akijahteng jongle amaho chu atuhtang louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen chu kidang tah-in a-aw'in ahung kithongin; eiho hetjouhoi hilou thil loupitah abole.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu aman buhbang henga, leija umin atin; chubangma chun athahatna gophinle gohong henga jong aseijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mijousen athilbol ahettheina diuvin, aman mitin khutchu amelchih-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuphatnin gamsaho akul sunguva alutnun, amuncheh-a aumtaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lhanglama konin huise ahungnungin, sahlama konin dap ahunge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen hu-a konin buhbang aumin, chule twilentah jong akang jin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Meibol satah jengjong chu twihu achun asunouvin, ameibol bangleh chu athejalin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman athupeh jouseu vannoi leiset chung jouse-a abolna dingun, athumopma chun akipeikol lele-un ahi
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman suhdih nading ham, agam ding ham, ahiloule hepina ding hama hichu asosah ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo Job, hichehi ngaijin; dingdet jinginlang, Pathen natoh kidangho chu ngaiton.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathen'in itih-a amaho agoltoh-a, ameilom vah chu avahsah, nangin nahet em?
  </para>
  <para style="p">
    <verse number="16" style="v" />Meilhang ho gihdan, hetna chamkimpa thilbol kidangtah chu nahet em?
  </para>
  <para style="p">
    <verse number="17" style="v" />Lhanglam huija leiset athipsah teng, navon iti lummaham, nahet em?
  </para>
  <para style="p">
    <verse number="18" style="v" />Phatvet kilhajol bangtah-a nasa-a vanlaijol hi, nangin amatoh naphajal ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Muthim jeh-a kaseidiu kaseidoh theilou jeh-un, Ama henga kaseidiu neihilun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kathusei dingchu hilding kangaijem? mikhatnin thu seile, thonlouva ama vallhuma umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tun mihem hon meilhang ho lah-a vah vahtah chu amupouvin, ahinla huijin amuttheng jitan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sahlama konin van ahung thengselin, Pathen chu janale tijatnan adime.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hat chungnung thudol chu imudoh joupouve, ama thilboltheina, thutanlhahna, dihna-a chungnung pen ahin, aman sugenthei ponte.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh-a chu mihon aginu ahin, milungching khatcha aman ajabol aumpoi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin chimpei lah-a kon chun Pakaiyin Job ahindonbut nin, aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hetna bei thuho-a thumop thimsahpa chu koiham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pasal tah bangin nakong kigah-in; nangma thu kadoh ding nahin, neidonbut ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Leiset bul kaphupetna chu hoilai ja nana umem? hetkhen themna naneile phongdoh-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alet aneo koijin atotoh ham, nahet nam? ahiloule achunga khau chu kon ajandoh ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Abul chu ipi chunga kihendet naham? ahiloule aning song chu kon agaphu ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Itih tengle jing valpa hon La asah khomuva, Pathen chapate jouse kipah tah-a ao dingu ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahiloule naobu-a kon potdoh ding banga, alonjal dingteng twipi kotpiho kon akha ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Aponsil dingin meilhang kasema, chule akitomna dingin muthim satah kasema,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche dinga chu akhonna kasema, kotgol hole kotpiho kasema,
  </para>
  <para style="p">
    <verse number="11" style="v" />chule hichangei nahunga, nakhokhel louding; chule hilaija hi nahoithona twikinong chu kingading ahi kati louham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Nakhohetna patna jingkah hi thupeh napeh khah-a, chule jingphalvah hi amun kihetnin kitikha em?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitia chu leiset kolmong gei atuh theija, chua kona mikhangseho thinlhah ahi nadiu nabol khah-am?
  </para>
  <para style="p">
    <verse number="14" style="v" />Namdet namna henga bonngan bangin heidoh in aumun; chule ponsil bangin adinguvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Migilou ho-a konin avah uchu lahpeh-in aumin, chule banjang nasatah chu kihehbong ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Twikhanglen nahho-a nalutkhah tah-em? ahiloule athuhdan kholla nachekhah tah-em?
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang dinga thina kotpiho kihongtam? ahiloule thina lim kotkhah ho namukhah tah-em?
  </para>
  <para style="p">
    <verse number="18" style="v" />Leiset letdan hi nahet em? nahetsoh keile phongdoh temin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vah umna lampi chu hoilai ham? chule muthim aumna mun hoilai hija,
  </para>
  <para style="p">
    <verse number="20" style="v" />Agamgi geija chu cheding hitale chun, hiche a-in lampi chu naga hekhen nadem?
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche phat laija nanapen tahjeh-a chu nahet nam? ahiloule nanikho ho jong atamtah jeh-a nahet nam?
  </para>
  <para style="p">
    <verse number="22" style="v" />Buhbangho kikhol na-a nalut khah tah-em? ahiloule gel kikholna namu khah-a;
  </para>
  <para style="p">
    <verse number="23" style="v" />Genthei nikho, kidoule kisat nikho-a dinga kakheh hokhu namu khah-am?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ipi lampia vah chu kikhenna, nisolam huihi leichunga kithecheh ham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Twi lonlet nading twilam kon ahop khenna, ahiloule van ginle kehlhah nading lampi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi umlouna leichung, mihem umlouna gamthipma gojuh nadinga;
  </para>
  <para style="p">
    <verse number="27" style="v" />Akham helsa gam donlouva umchu kidodoh sah kitdingle, hamdong hindoh sah kitdinga alampi chu kon asem ham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Gotuijin pa aneijem? daitwi hohi koi hin ham?
  </para>
  <para style="p">
    <verse number="29" style="v" />Buhbanghi koi naobu-a hung pengdoh ham? chule van dai bang jonghi koi hin ham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Twiho chu song bangin atah-in, chule twithuh chungchu akanin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nangman bombel khu nakan khom theija, ahiloule Juheisuhtun khu nalhap lhah theijem?
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahsi somleng khu aphatna napuidoh theija, ahilou le sahlam Ahsilen le achate nalam kaithei jem?
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangman van chondanho nahet em? hicheho kivaipohna chu leisetna nachesah theijem?
  </para>
  <para style="p">
    <verse number="34" style="v" />Twi tamtah in nachup theina dinga, meilomho chu na awsoa nakou theiding ham?
  </para>
  <para style="p">
    <verse number="35" style="v" />Kolpheho chu achena dinguva nasol theija, chule nahenga, hilaija kaumuve ahinte thei dingu ham?
  </para>
  <para style="p">
    <verse number="36" style="v" />Sung gil lama chihna chu koijin akoi ham? ahiloule lungsung hetkhen themna chu koijin apeh ham?
  </para>
  <para style="p">
    <verse number="37" style="v" />Chihna-a meibol hokhu asimtheija koiham? ahiloule van twibom khu kon alheilhah thei dingham?
  </para>
  <para style="p">
    <verse number="38" style="v" />Itih-a leivui chu hungtah-a, chule alomho chu hung kimatchetna ham?
  </para>
  <para style="p">
    <verse number="39" style="v" />Keipi bahkai chu asaneh ding naholpeh theija, keipi bahkai nou gilkel chu navahva thei dingham?
  </para>
  <para style="p">
    <verse number="40" style="v" />Itihteng akosunguva koljiuva, achangpan naova itihleh changpang jiuham?
  </para>
  <para style="p">
    <verse number="41" style="v" />Va-ah noute khu Pathen henga apen penna, nehding lhasama alenlele tenguleh, kon neh apehji-ham?.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangin songpi lah-a gam kelchaho itih-a asoding phat nahetnam? ahiloule sajuh-in nou itih-a aneiding namelchih theijem?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin, avoplai lhaho nasim theijem? ahiloule itih phatna asodiu nahet em?
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho aboh-un, anouvu asoh-in, agentheinau akoidoh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anousenhou chu ahung maldoh-un, hamlah-a ahung khang doh-un, achedoh-un, ahungkile kitji tapouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gam sanganho chu kon alhadoh ham? ahiloule akihennao khao chu kon asutlhah ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Gamthip chu a-inding, chule gamtem gamchu achenna munin kasemin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman khopi-a mihonpi chu ima asahpon, ahoijipa husa jongchu ajajitapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Moljol ho chu ama lhatlena ahin, chule aman hamhingho jouse chu ahollen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sakol kinei chun nangma najennom ding hinam? ahiloule nagankula umnom ding hinam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Sakol kinei chu angonga khao nakhithei dingham? ahiloule loukaina nabuto-a, phaicham chu akaibot thei dingham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Athahat nasat jeh-a chu nangman ama chu natahsan dingham? ahiloule natohding chu ama nanot khum ding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Namuchi hochu na-in'a ahinpoh lutna, nachangsala kholkhom dinga natahsan ding ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Vahong hochu lhaving hoitah napeh hilou ham? ahiloule vachalen chu lhaving le amulho napeh hilou ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman leija atuiho adalhan, leivuijin alumsah-in,
  </para>
  <para style="p">
    <verse number="15" style="v" />chule mikhat touvin akenga alhokhah theiding, ahiloule gamsa khat touvin asukeh theiding ahi jong ageldoh jipoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama nou hilou bangtah-in anousenho chunga a-engsen, atohgimna chu kichatna beija mohseh ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Pathen'in amanu akonin chihna chu aladoh-in, ahetkhen themna jengjong amanu apepon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amanu ama le ama sangtah-a akidopsang phatle, sakol le achunga toupa chu ataitomjin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangman sakol khu thahatna napeh em? angonga along gingjeng jung navopeh ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangman khaokhopi ho banga nakichat sah theijem? anahko loupitah chu tijat umtah ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman tolgo atinin akhotjin, athahatna-a athanomin; gal manchah choiho to kimuto dingin apotdohjin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kichat chu anuisatnin, akicha pon, chemjam'a konin jong anungchon ngaipon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Livathei ama dounan aginglah lah-in, tengcha le lumho aval lahlah-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman leiset chu tijat-umtah le lunghang tah-in aval lhumin; hiche hi sumkon gin ahi tijong aman atahsanpoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman sumkon ginho lah-a chun, haha, atin; chule gamlatah-a konin gal husa ajan, gal lamkaiho husan leh akithong gin ajan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangma chihna jeh-a muthi chu lengji-a, alhaving teni chu lhanglam nga-a ajahji ham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Muvanlai chu nangma thupeh-a lengtouva, chule chungsanga abuh aset ham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama kol lah-a achengin, songkol chunga mundet tah-a chun acheng jin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hia konchun thading sa aholin, chule amitnin gamlatah amun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anousen houvin thisan achopmun, chule sa kithat umna mun'a chun, amanu aumjin ahi.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin Pakaiyin Job adonbutnin, aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Hatchung nungpen kinahpi pachun ama ahilding ham? Pathen themmo chansah pachun hichu donbut hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Job'in Pakai chu adonbutnin, aseije:
  </para>
  <para style="p">
    <verse number="4" style="v" />vetan, keima miphalou kahin, ipi kadonbut dingham? keiman kakhutnin kakam kisip tange.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khatvei kana seitan, ahinla donbut ponge, henge, nivei; hijongle seibe taponge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Pakaiyin chimpeija konin Job ahindonbut nin, aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pasal tah bangin nakong kigah-in; nangma thu kadoh ding nahin, neidonbut ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kathutan jonghi ima hilou neisopeh got ham? chonphat nachan theina dinga keima themmo neichan got ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangin Pathen banga ban naneijem? ahiloule ama awgin banga nangma aw naginsah theijem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun nangma lalnale chungnun na-in kijem inlang, hoina le loipina-in nangma kijemin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nalung hanna chungnung chu bunglhan lang, mikiletsah tapou chu venlang, sunemin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi kiletsah tapou chu venlang, loilha-in, chule migilou hochu aumnaova lholhan.
  </para>
  <para style="p">
    <verse number="13" style="v" />Leivui lah-a amaho selkhomin; chule guhthimin amaiju kanpeh-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutengle keiman jong nahenga nakhut jetlamin nahuhdoh jouding ahi tia kaphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun vetan, Behemoth khu nangma toh kasemkhom ahin, aman bongchal bangin hamhing anen ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun ven, athahat nachu akonga um ahin, chule ahatna chu a-oipoh laimu-a um ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amei chu Cedar thing bangin achaloh sah-in; akhelbuh-a aphelom hochu akitomchah kheh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Agu chu sum-eng hal tahbet tobang ahin, aguho chu thihlhon tobang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama Pathen lampiho lah-a alupen ahin, asempa chun ama nailut nading chemjam asem thei ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahbeh-in gamsaho jouse kichepna molhochun, a-an nehding ahin sodohpeh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama thingphung limnoi, pumpengle hamling neiho noija akoljin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thinglimho chun ale-limuva ama akhu-vin, vachadunga huisum hochun ama aum kimvelun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Veovin, aman vadung chu achipkangin, akinopoi; aman Jordan chu akama achipkang joudingin atahsanin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amit tenin alaji-in, anahkuijin thangho chu aphujalpai jin ahi.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngakoija Leviathan nakoidoh theiji em? ahiloule nakhao khaisuh-a chu alei nakhithei dingham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin anah kohom sunga ngakoi nakoithei dem? ahiloule linga akha nasunpai thei dem?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nahenga ngehna tampi anei ding ham? nahenga aw nemma thu aseiding ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman nangma toh kitepna asem dingham? a-imatih chana soh dinga nakipui thei dingham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman ama chu vacha banga nakicheppi dingham? ahiloule nasoh numei ho dinga nahending ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Agolhon golnop abolpeh dem? sumkolvei ho lah-a chu chan aneisahdiu hinam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangin avunchu thih hema nadimsah theija, ahiloule aluchu nga tenga nadimsah thei ding ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Achunga nakhut ngaminlang, galchu geldoh inlang, bolkit tahih in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Veovin, ama thajo dinga kinepna chu moh ahin; ama akimu sehseh jongleh mihem chu pailhah-a umji-a hilouham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama tildoh dinga kingapcha mihang koima aumpoi, achutile koiham Ka-anga dingjou dinga?
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama kalepeh kitna dinga koiham eikhamah? Vannoi pumpia thil umjouse hi keija ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman atibahho hihen, athahatna hihen, amellom naho hijongle selgu ponge.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koiham aponsil chungnung hohlhah thei dinga? ahiloule kamdal ni puma akoma hung ngamding koiham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahaho chu tijat umtah-a kigol ahin, amaichang kotkhah hong ngamdinga koiham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Alipho chu akiletsahna ahin, sinkhana kinamkhum banga kikha khuma ahibouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akah uva hu alutthei louna dingin, khat le khat hanaijin akinaijin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho suhkhen ahilouna diuvin, khatle khat kijom matnin, akilompelun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Achit tengle vah ahung kikapdoh jin, amit ho chu jingkah ninel toh abange.
  </para>
  <para style="p">
    <verse number="19" style="v" />Akama konin thaomei kong, chule meisi pahlahlah ahungdoh jin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Belle khangbela kona twi asou bangin, anah homa konin meikhu ahungdoh jin ahi
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahaina huchun meihol hochu ajap-am min, chule akama konin meikong apotdoh jin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angonga hatna aumin, amasanga lungkham nachu kipanan akilejin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aphe hal hochu akijop matcheh-in, amaho chu adet chetnun, suhlonghoi ahipoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Alung chu song banga tah ahin, song sumhei noinung banga tah ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama ahung kipatdoh tengle mihat hojong akichauvin, kichatna anatsat jehchun, ama hotah jong akisutheng jiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Min chemjamin sat jongle ajolou ding, tengcha, tuljum, tenghem injong anang joupoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman thih chu changpol bangin agelin, chule sum-eng jong thingmot bangin agel bepmin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thalpin ama ajamsah ngaipon, ahsongse jong ama dingin changkung tobang bep ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tenghem hochu poljang abahsah bepmin, tengcha akilo khumteng aman anuisat jin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Songhem hochu anoija aumin, aman bonlhoh chunga chun tenghem hochu athecheh jin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman twi thuhtah chu bela twibangin asou sah-in, aman twikhanglen jong chu lou theikhat tobang asosah-e.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman anunga lampi chu avahsah-in, min twithuh chu samkang bangin ageljiuvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Leichunga akibahpi ama tobang aumpoi, amahi kichat na beija kisema ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman thil sang kiti jouse amun, ama akiletsah chateho chunga leng ahi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Job'in Pakai adonbutnin, aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin ijakai nabol theijin, chule nalung ngaito jouse chu imachan adaltan theilou ahi, ti kahei,
  </para>
  <para style="p">
    <verse number="3" style="v" />Hetna neilouva thumop sella chu koiham? hijeh chun kahetkhen theilou, keija dinga thil kidang behsehho chu kanaseidoh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngaijin, nahenga katao ahi, keiman seijinge; keiman nahenga kangeh ding, chule nangin neiphondoh peh-in,
  </para>
  <para style="p">
    <verse number="5" style="v" />Kakhojah theina nakhanga konin nangma chung changthu kanajan, tunvang kamitnin nangma amutai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun keima le keima kaki ki-dah in, leivuile vutlah-a kakisih-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin hiche thuho Job henga aseijou phatnin ahitin ahi, Pakaiyin Teman mi Eliphaz henga aseijin, nangmale nagolteni dounan kalungsatna akoujahtai. Ajehchu nanghon kasoh Job bangin keima chungthua thudih naseipouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun tun nanghon bongchal sagile kelngoichal sagi kaijunlang, kasoh Job henga cheovin; nangho dinga govam thilto gatoh uvin; chule kasoh Job nangho dingin taovintin, ataona chu ama jeh-a kasanpeh ding ahi. Achutiloule kasoh Job banga kachung changthu adih-a naseilou jeh uva, nangolnao dungjuija kabolding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun Teman mi Eliphaz le Shuh mi Bildad chule Naamath mi Zophar chu acheuvin, Pakaiyin athupeh dungjuijin abolun, Pakaiyin Job chu asampehtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin agolho dinga atao phatnin Pakaiyin Job asohchanna-a konin akiledoh sahtan; Pakaiyin jong Job chu anei masah sanga ajatnia tamin abetan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin asopi pasal ho jousele asopi numei ho jouse, chule masanga ama kihetpiho jouse ahenga ahungun, a-in'a chun changlhah anekhom mun; chuin amahon alunghem piuvin, chule Pakaiyin achunga thilse abol hojouse jehchun alhamonun, amitakipmin jong sumle sana bilba khatcheh apeovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun Pakaiyin Job chu ahinkho masalama sangin, ahinkho nununglama phatthei abohjon ahi. Ajehchu aman kelngoi sangsom le sangli, sangongsang gup, chule loukaithei cheh bongchal sangkhat, sanganpi sangkhat aneijin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman chapa sagi le chanu thumjong aneijin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman apeng masapennu chu amin Jemima asah-in, chule aninanu minchu Kezia, cule athum nanu minchu Keren-happuch asah-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule gamsung pumpi-a chun Job chanute bangtah-a hoi aumpoi; chule amaho chu apauvin asopihou lah-a agouchan diu apecheh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche jouchun Job kum jakhatle kum somli ahingin, achapate le, achapate chate khangli geijin amun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitichun Job tehkem keile, nikho lhingsetnin athitan ahi.
  </para>
</usx>
