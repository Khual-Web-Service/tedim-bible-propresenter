<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MRK" style="id">Mark</book>
  <para style="h">Mark</para>
  <para style="toc1">Mark</para>
  <para style="toc2">Mark</para>
  <para style="mt">Mark</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen Chapa Jesu Christa Kipana Thupha kipatna;
  </para>
  <para style="p">
    <verse number="2" style="v" />Themgaoho lekhabua kisun bangin, Ven, keiman kasottol namasang sang-ah kasole; Ama chun nalampi anasem ding ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamthipma khosam aw khatnin, Pakai lamlen semtohsan koijun, Alampi semjangun, tia kisun bang chun,
  </para>
  <para style="p">
    <verse number="4" style="v" />John Baptist chun gamthipmah twi alutsah-in, chonset suhmangna dinga lungheija baptize chan ding thu lhangsamin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Juda gama mi jouse le Jerusalem'a mi jouse ama henga acheuvin, achonsetnu aphongun, Jordan luija ama khutna abonun baptize achang taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule John chu sangongsang mul ponin akivonin, savun konggah-in akong akigeh-in, chule a-anneh chu khaokho le gam khoiju ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule thu ahil lhanglen, Kanungah keima sanga hat chungnungjo ahunge, keima hi kuna akengchot khao sutlham dinga jong kilom kahipoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman nangho twija baptize kachansah nahiuvin; amavang Ama chun nangho Lhagao Thenga baptize nachansah dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hilai chun ahitin ahi, Galilee gam sunga Nazareth kho-a konin Jesu ahungin, Jordan luija John khutna baptize achangtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin twi lah-a kona ahungdoh doh-in, van akikehso-a, Lhagao vakhu bang achunga ahung kumlhah amun:
  </para>
  <para style="p">
    <verse number="11" style="v" />Van'a konin aw khat ahung gingin, Nangma ka-Chapa deitah nahi, nachungah kalung alhai tangeije, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Lhagao chun gamthipma apui mang paijin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chua chun nisomli Satan lhep patepmin aumin, gamsa lah-a aumin; chuin vantil hon ahung jenleuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin John songkul'a akikhum jouvin, Jesu Galilee gama ahungin, Pathen lenggam Kipana Thupha ahil lhanglen,
  </para>
  <para style="p">
    <verse number="15" style="v" />Phat alhingtai, chule Pathen lenggam jong anaitai; nalung heijun, Kipana Thupha hi tahsanun tin alhangsamin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Galilee dillen pang ajotpa na-a, Simon le asopipa Andrew dillena lensep amun; amani chu ngaman mi ahi lhone.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jesu'n amani jah-a chun, Kanung hinjui lhonin; keiman nangni mi man lensep hisah lhoninge, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amanin alen adalha lhonin, anung ajui pai jeng lhontai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin themkhat achechon jeple, Zebedee chapate ni Jacob leh anaopa John amani jong chu kong sunga len anakhui phat pet lhon amun;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amani chu akou paileuvin ahile, amanin apa lhon Zebedee chu athalah soh ho toh kong sunga chun adalha lhonin, ajui lhontai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amaho Capernaum'a achelutnun; cholngah nin kikhopna in'ah alutnin, thu ahil paijenin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman danthu sunho banga hil louva, thuneitah banga ahil jeh-in miho chun athuhil chu kidang asa lheh-un ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin akikhopnao in'a chun lhagao boh vop mi khat anaumin, chule ama chun ahinsam paijenin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Nazareth Jesu, nangle keiho ikimatnao i-um em? Eisumang uva hunga nahim? Nangma koi nahi kahenai, Pathen'a kon Atheng chu nahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Jesu'n ama chu aphoh-in, Thipmin, ama-a kon chun hung doh-in, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin lhagao boh chun mipa chu aheh-in, hapenin apengin, ahung potdoh tai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin mi jousen kidang asan alungdong lheh jengun; chutichun khatle khat akidongun, Hiche hi iti hintem? Hiche hi thuhil thah ahi! Aman thunei tah-in lhagao bohho thu apen, chule amaho jong athun anung jenguve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Galilee gam kimvel chengse-a amin akithang pai jengtan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule kikhopna in'a kona ahungdoh doh-in, Simon le Andrew insunga chun Jacob le John toh alut paijun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin Simon nupanu chu khosih-in anan analumin; chuin amahon anat thu chu Jesu ahetsah paijun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutichun amanu koma chun achen, akhutnin atuh-in, akaithou tai; hichun akhosih chun alha jengin, chuin amanu chu amaho jenlen apangtai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin nilhah ahia, nisa alhum jouvin, mihon ana damlou jouse le thilhavop ho ahin puijun;
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule khopi sunga mi jouse kotpi phung-ah akikhomun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Aman hiveichom chom veija damlou mi tamtah adamsah-in, chule thilha tamtahma adeldoh-in; ama Christa ahi chu ahet jeh-un thilhaho chu apao sahpon ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin jing khovah lhah masang peh-in athouvin, apotdoh-in gamthip munah achen, chua chun agataovin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Simon le agoldangho chun anung ajuijun,
  </para>
  <para style="p">
    <verse number="37" style="v" />Amudoh phatnun ajah-a, Mi jouse hinla nang nahol cheh-un, atiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Aman, Naidunga khopi dang danga jong kahil lhangle theina dingin cheohite; hiche dinga chu hung kahi, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin ama Galilee gamsese-ah achelen, akikhopnao in tinah thu ahil lhanglen, chule thilha adeldoh peh-in ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin miphah khat Jesu henga ahungin, ajah-a, Nalung ahile neidam thengsah thei ahi tin a-angah adilsun ataotan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Jesu'n alungset behseh-in, akhut alhangin, athamin, Kalung ahi; dam thengtan, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin hiche thu chu aseijou jouvin, chupettah chun aphah chun adalha paijin, athengsel tai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Aman amapa chu akhamchah kheh-in, asolmang paijin;
  </para>
  <para style="p">
    <verse number="44" style="v" />Ajah-a, Ven, koima jah-a sei hihbeh-in, ahin chenlang thempu gakimusah-in, chule nadam theng thu dol chu amaho hettohsahnan Mosi thupehsa thilpeh ding chu gapetan, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ahivangin amapa apotdoh-in, hiche thu chu asamlen, aha phonjal cheh tan; achuti jehchun chukalin Jesu lhangphong in koima khopi sungah alut theita hih-in, gamthip thipma aumjotai: chule muntina konin ahengah miho ahungjiuve.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni chomkhat jouvin Capernaum'a alut kitnin ahile, in'a aume ti akithang soh jengtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche pettah chun mipi tamtah ahung khomun ahile, aumna dingu mun kotphung jeng jong a-ong tapon; aman amaho chu thu ahiltan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin langthi khat mi lin ajongun ahengah ahinpuijui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin mipi jeh-a akom naija ahung lut theilou jeh-un, in chung chu Ama umna dontah aphet vangun, langthipa chu alupna pumin a-ang sungah agah khailha suh-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jesu'n atahsanjeu chu amun, langthipa jah-a chun, Chapa, nachonset naho kingaidam ahitai, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla danthu sunho phabep khat hia chu tou ahiuvin, alungthim uva,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichepa hin ibola Pathen taitom na-a hitobang thu aseiham? Pathen tailou chonset koiham angaidam thei ding? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin achuti gelu chu Jesu'n alungin ahepai jenin, ajah uva, Ibola nalunguva hicheng chu nagelu ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Langthipa jah-a hi, Nachonset naho kingaidama ahitai, kiti le; Thouvin, nalupna kilah-inlang lam jotnin, ti chu hoijoh seibai jo-em?
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijongle leiset chunga Mihem Chapan chonset ngaidamna thahat aneije ti nahetna dingun, atin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Langthipa jah-a, Thouvin, nalupna kilah-in lang na-in'a chetan kati ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ama chu athoudoh pai jengin, alupna akilah-in, japi mitmutah chun achedohtan; chuphatnin ajapiuvin kidang asa lheh jengun, Hitobang himhim kamukha pouve, atiuvin Pathen avahchoi taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin apotnin dillen pangah achekit tai; chuin mihonpi chu ahenga acheuvin ahile aman thu ahile.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin achena-a Alphaeus chapa Levi kaidonna mun'a atou amun, ajah-a, Kanung hinjuijin, ati. Chuin ama akipatdoh-in anung ajuitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti chun Levi in'a ankong aumpet chun, kaidongho le michonseho tamtah-in Jesu le aseijuiteho chengse chutoh ankong aum khomun ahi. Ijeh-inem itile amaho tamtah ahiuvin, ama nungjui cheh ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pharisai ho le danthusun hon michonseho le kaidongho toh an aneh khom chu amu phatnun, aseijuite jah-a, Iti dana kaidongho le michonseho toh an aneh khomham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichu Jesu'n ajah phatnin, ajah uva, atidamten louthem angaipouve, adamlouten bou angaijui; michonpha te kou-a hung kahipoi; lungheidia michonse te kou-a hungjoh kahibouve, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule John seijuite le Pharisai hon an angoljiu ahin; amaho ahungun Jesu jah-a, I-atile John seijuite le Pharisai hon an angol jiuva, nangma seijuiten an angolji louham? atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Jesu'n amaho jah-a, Aloite chu moulang chun aumpi laise-a an angol thei ngaijum? Moulang chun aumpi laiseuva an angol thei louvu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang moulang chu akomuva kona kipuimang ni hung lhung ding ahi, chuche nile an angol dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koiman pon sopnem loulai halin ponlui abeh ngaipoi; chuti bolle athahjoh chun alui chu akaiset ding, akehlai chu kehcheh joding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule koiman lengpitwi thah savun peng luija akhum ngaipoi; ichuti bolle alengpitwi chun asavun peng chu tumkeh intin, lengpitwi savun peng akopma mang ding ahi. Lengpitwi thah chu peng thah-a akhumji bouvui, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ahitin ahi, cholngah nin Jesu'n changlei lai ajotnin ahile, aseijuiten ache pumun changvui chu asih pantaovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pharisai hon ajah-a, Vetan, ibola cholngah ni-a bol ngailou aboluham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu'n adonbutnin, David le aloiho alhahsamuva, agilkel petnuva chu ipi abolu nasimkhah louvu ham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Abiathar thempu chungnung ahi laijin Pathen in'a alutnin, thempu tailou adangin aneh ngailou vetsahna changlhah chu anen, aloiho jong apen ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Jesu'n ajah uva, Cholngah ni chu mihem dinga kisem ahi, cholngah ni dinga mihem kisemjoh ahipoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuti chu ahin Mihem Chapa chu cholngah ni Pakai jong ahi, ati.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kikhopna in'a alut kitnin ahile, chuachun mi khutlang ngoi khat aumin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama chu ahehset theina dingun, cholngah ni-a aboldame aboldam hih-em, tin achang lhiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Aman khutlang ngoipa jah-a chun, Alaija hung dingdoh-in, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ajah uva, Cholngah ni-a apha bol angaiha, ase bol angaiham? Lhagao huhhing angaiha, suhmang angaiham? atin ahile, amaho athip chetchut jengun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Aman alungtah jeh-u chun alungphamon, lungsatenin amaho chu ave kimvelin, chuin mipa jah-a chun, Nakhut lhangin, ati. Chuin alhangin ahile, akhut chu alangkhat bangin adamtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pharisai ho chu apotdoh-un, amachu iti suhmang dingham ngaiton, Herod miho chutoh akihoutoh paitaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jesu aseijuite toh dillen lama chun achetauve. Chule mipi tamtah-in ajuijin, Galilee gama kon, Juda gama kon,
  </para>
  <para style="p">
    <verse number="8" style="v" />Jerusalem khopi-a kon, Idumia gama kon, Jordan gala kon, Tyre le Sidon gam kimvela kon chule mihonpi tamtah ahiuvin, athilbol loupitah ho ajah phatnun, ahengah ahungun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipi jeh chun kongneo gotsa koijin aseijuite asolin, achuti loule eineh khauvinte, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi tamtah adamsah ahitah jeh chun, natna nei jousen ama atohkhah theina dingun Ama aumchah jengun;
  </para>
  <para style="p">
    <verse number="11" style="v" />Lhagao boh chengse jong chun ama amuchanun a-angah aboh khupmun, Nang Pathen Chapa chu nahi, tin asamjiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin Aman ama chu aphondoh louna dingun amaho chu akhamchah-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin mol chunga akaltouvin, aman angaichat chengse chu akouvin, amaho ahenga ahungun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin akoma um dingle, thuhil lhangle-a asol dingin, somleni alheng doh-in,
  </para>
  <para style="p">
    <verse number="15" style="v" />Damlou ho damsah theina thahat neidingle, thilhaho nodoh theina thunei dingin:
  </para>
  <para style="p">
    <verse number="16" style="v" />Simon aman Peter asah-in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebedee chapa Jacob, chule anaopa John, amani chu amin Boanerges asah-in; hichu van gin chate, tina ahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Andrew, Philip, Bartholomew, Matthew, Thomas, Alphaeus chapa Jacob, Thaddaeus, Canaan mi Simon,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Ama matsah-a pang Judas Iscariot ahiuve. Chuin amaho insunga alut taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin mihonpi ahung kikhom kit taovin ahile, an tahbah jong anethei tapouvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichu a-inkoten ajahdoh phatnun, angola hitakhu atiuvin, ahung konun thahatsana mat dingin ahung gouvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Jerusalem'a kona hungsuh danthu sunho jong chun, Beelzabul vop ahi, chule thilha anodoh jong hi thilhaho lengpa vanga anodoh hija hi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Aman amaho chu akouvin, thulemin aseijin ajah uva, Satan'in Satan iti anodoh thei dingham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Gamsung khat amale ama kidouto hen kikhenle, hiche gam chu dingdoh thei louding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Insung khat amale ama kidouto henlang hileh, hite insung chu dingdoh thei pouvinte.
  </para>
  <para style="p">
    <verse number="26" style="v" />Satan jong amale ama kidouto henlang kisep khenle, dingdoh thei louva mangthahjo ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koiman mihat chu kanchom masa louvin, a-in'a alutnin athilkeu achompeh theipoi; akanchom masatna chutengle achom dingbou ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule tahbeh-a kaseipeh nahiuve, Mihem chate hi achonsetnao itobang hijongle, Pathen ataitom nao hijongle, taitomna jouseu chu kingaidam ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amavang koi hileh Lhagao Theng taitom vang chun imatih chana ngaidam amulou ding; tonsot themo channa-a chua ahitai, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lhagao boh vop ahi, ati jeh uva chutia chu asei ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin anu le asopite ahungun, inpoa adingun, ama kouvin mi asolun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule avela chu mihonpi touchah khet ahin, amahon ajah-a chun, Ven, inpoa khun nanu le nasopiten nahol uve atiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Aman ajah uva, Kanu le kasopite koi koi hiuvem? tin adonbutne.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin akimvela touho chu ave golin, Hiteho hi kanu le kasopite ahiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ijeh-inem itile Pathen lunglama chonpatah chu kasopipa le kasopinu chule kanu ahi, ati.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin dillen pangah thu ahilpan kittan ahile mihon tamtah akomah ahung kikhomun, chuin dillen chunga kong-ah alutnin atouvin; chule mipi chengse chu vapamah tolah aumuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amaho chu thulemin thu tamtah ahilin, athuhil lah-a chun aseije,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngaijun, muchi thepa muchi then achen:
  </para>
  <para style="p">
    <verse number="4" style="v" />chuin ahitin ahi, athe atheleh abang lamsih-a achun, chunga leng vachaten ahung lohgam taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule abang songlheo chunga leipatna-ah achun, alei asalou jeh-in akehdoh pai jengin:
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin nisa ahung soh-in ahile asanggon, jung anei lou jeh-in, agoptan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule abang ling lah-a achun, aling chu ahung khangin adeplihtan, aga himhim aumtapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin adangho chu leipha laijah achun, akehdoh-in ahung khangin chule agatan; abang somthum cheng, abang somgup cheng, abang ja khat cheng apungtan ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Aman ajah uva, Angaina ding na neijan ngaihen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin achanga aum petnin, akimvela umho le somleni chun athulem seiho chu adongun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Aman amaho jah-a, Pathen lenggam thuguh chu nangho kipe-a nahitaove; polama um mite jah dinga vang ijakai thulema kisei ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutia chu amahon muvang chu amudingu, ahetdoh lou dingu, jah vang chu ajah dingu, ahetkhen lou dingu ahi; achuti loule hung kihei kitnuntin, chule achonsetnao ngaidamin umgetninte, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Aman ajah uva, Nanghon hiche thulem hi nahet lou mongu ham? Achutile thulem dang jouse iti nahet dinguham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Muchi thepa chun thu athe ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hicheho hi thu kithena lamsih-a chuho chu ahi; amahon thu ajah jah-un, Satan ahung paijin, alung sunguva thu kithe chu alah mang peh tan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutobangma chun songlheo chung leipatna-a chua chu hicheho hi ahi; amaho chu thu ajah jah-a thanom tah-a joppai jengho hi ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin amaho chu jung nei lou ahiuvin, chomcha khat aumjiuvin ahi: chujoule thu jeh-a hesohna ahiloule bolsetna ahung umtengle, alhupaiji taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hicheho hi linglah-a muchi kithe ho chu ahiuve; amaho chun thu ajauvin,
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin leiset hinkho lungkhamna, lheplhahna dimset haosatna, chule ngaichatna dangdang alutnin, hichun thu chu adeplih jin, ga louvin aumjitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule lei pha laija chua chu; athu ja-a, jopteho chu ahiuvin, abang ajat som thumin, abang ajat som gupmin, chule abang ajat ja-in agapungin ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Aman ajah uva, meivah khu lo noi, ahiloule jalkhun noija tun dinga kihinchoi ngaijem? Akhom chunga tunding chu angaina hilouham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Ijeh-inem itile kiphong lou ding imacha ki-ima aumpoi; kilangdoh lou ding imacha akiselguh aumpoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Koi hileh angaina ding na neijan ngaihen, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ajah uva, Najah chengseu hi ipiham, kichihtheijun. Nanghon natebang banguva nangho jong kitepeh ding nahiuve; chule nangho aja chengse hi kipehbe dingbon nahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ijeh-inem itile aneija chu kipehbentin; chule anei louva chu aneichasun jong chu ama-a kona kilahpeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman ajah uva, Pathen gam umchan chu, mikhatnin amuchi leija athe-a:
  </para>
  <para style="p">
    <verse number="27" style="v" />Amachu sunteng imuji, janteng thouji, muchi chu hung kehdoh-a hung khangdoh, amatah-inla ajeh ahetlou tobang chu ahi
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh inem itile leisetnin achamin ama-a konin ahin ga sahjin, amasan akung, abanle ado, chujoule avui, chujou kitle avuija aga achanglhing jitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahin aga chu amin phatle, a-at phat ahitah jeh-in, aman koiten a-atpan jitai, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin hitin asei kitne, Pathen gam hi ipitoh kitekah ding hitam? ahiloule ipi thulema kisei ding hitam?
  </para>
  <para style="p">
    <verse number="31" style="v" />Ankam mu chang khat tobang ahi, hichu leija akithe-a ahile, vannoi leisetna muchi jouse lah-a aneopen ahin;
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahivangin akithe joule ahung kedoh-a, hung khanga, hampa dang jouse sanga hung lenjo; abah len tahtah hinso-a, chutia chu chunga leng vachate aboh lim noija age theiju tobang ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin chutobang thulem tamtah-in amahon ahetthei kham khamun thu ahilin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule thulem louvin ajah uva imacha aseikhapoi: ahin aseijuite chengse vang chu achanguva aumtengule ijakai ahilchen jin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin nilhah-in Aman amaho jah-a, Agal lang khatna galkaiju hite, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chutichun mihonpi chu asoldoh jouvun, ama aum bang bang chun kong'a akitolpi taovin, kong dang dangto jong alhonun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin khopihui ahung nungin ahile, twikinong chu kong sunga ahung kinong lut matchet jengtan, chuti ahi jeh chun kong chu dimpai ding ahitan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amala kong mei lamah lukhap akhapmin a-imun ahi: chuin asukhangun, ajah-a, Rabbi, kathigam dingu hi na ima lou louham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Akhah phatnin huipi chu aphoh-in, dillen jah-a, Umthimin, thipbeh chan umin, ati. Chuin hui chu ahaijin, athip heltai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Aman ajah uva, Ibola chuti kichat nahiuvem? Iti dana tahsanna himhim nanei louvu ham? ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuphatnin Ama chu kichat mainan akichata pouvin, Hichepa hi itobang mi hija, huipi leh dillen kinong sanin athu angaiham? tin akihouchut chut taovin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chutichun dillen gal langkhat agalkaijun, Garesene miho gama alhung taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin kong'a kona apotdoh doh-in, lhan lah-a kona hung lhagaoboh vop mikhatnin atoh paijenin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama chu lhan lah jenga chu cheng ahin, koimachan thihkhaova jong akan joulou ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu bul atuh jiuva, thihkhao vajong akanjiu ahin; ahivanga thihkhao chu asat tanjin, bul chu atumkehjin, koimachan abol ngoi jou louhel ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule sunle jan-in lhan lah le molchunga aumjin, chule a-aole a-ao lejin, songin ama le ama aki-at chenjin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin gamlatah-a kona Jesu ahinmu phatnin, ahung lhaijelin a-anga aboh khupmin chibai aboh-in;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin hatah-in asamin, Pathen chungnung pen Chapa Jesu, nangle kei ipi ikimatna umam? Pathen mina nahenga katao ahi, neibolgim hih-in; ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Aman ajah-a, Nangma lhagao boh, hiche mipa-a kon chun hung potdoh-in, ati ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Aman, Namin ipiham? tin adonge. Chuin aman, Tamtah kahi jeh-un kamin Janel ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin chuche gamkai sunga kona asoldoh louna dingun Jesu hengah hataovin ataotan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun akoma molsang panga chu vohcha hon tamtah lha-a ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin lhagaoboh jouse chu ahenga ataovun, Vohcha hon lah-a kalut theina dingun neisolun, ati taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Jesu'n phalna apetai. Chuin lhagao bohho chu apotdoh-un, vohchaho sunga chun alut taovin ahile, vohcha hon chu halhaijin alhaijun, kola alhai lhauvin, dillena chun alhalutnun, (voh honho chu sangni tobang hiuva ahin,) athigam taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin vohcha chingho chu ajamun, khopi sung le loujaovah agaseile taovin ahi. Chuin Ipi iti hitam, tia ve dingin ahungun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jesu kom ahung lhunun, thilha janel voppa chun pon akisila chule lung lima anatou chu amuvin, akicha lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin thilha voppa le vohchaho umchan achen achaija mu-a hetohhon ajah uva aseijun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun amahon agam sunguva kona potdoh dingin ahenga atao pantaovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin kong'a alut phatnin, masanga thilha voppa chun amatoh thakhatna umna dingin ataotai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin Jesu'n ajahdan, ajah-a, Na-in'a chenlang na-in kote hengah Pakaiyin itobang thil loupi nabolpeh-a, iti nakhoto hitam abonchan gaseitan, atijotai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin akipat doh-in, Decapolis kho jouse-a Jesu'n thil lentah abolpeh chu lhang phongtah-in asamle pantai; chuin mi jousen kidang asa lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jesu kong'a akitola agal lang khat pang akaidoh-in, mihon tamtah ahung kikhomum; ama dillen pangah aumin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin kikhopna in'a vaipoho lah-a mi khat amin Jairus chu ahungin, Jesu amu phatnin akhomuh-ah aboh khupmin;
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule ajah-a, Kachanu chapang neocha khat thi dingin alume; katao ahi, adamdoh nadingin hungin lang achunga nakhut hung ngamin tia katao ahi, tin hangeh-in angehtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Jesu ama chutoh alhonin achetai, chule mihonpi nasatah-in ajuijun atom lellul jengun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin numei khat kum somle kum ni athi longa damlou ahin,
  </para>
  <para style="p">
    <verse number="26" style="v" />Louthem tamtah-a kona thohgimna tamtah anatoh-a, anei jouse asuhmang ahitan, imala aphachom pon, ahin akhohcheh cheh jon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanun Jesu thudol ajah phatnin, anunga mihonpi lah-a chun ahungin, apon chu athamtan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amanu chun, Apon jeng jong hi thamleng kadam ding ahi, ati ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin chupetah chun athiput chu akangin atangtan; chule amanun kanat thoh lela konin kadamtai ti chu ati chunga akihet tan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chupettah chun Jesu'n ati chunga kona thilboltheina apot chu ahen, mipi lah-a chun akihei kimvelin, Kapon thama chu koiham? atin adong tan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aseijuite chun ajah-a, Mipi hijatnin naneh chinto mu jinga, iti dana Koiham eithama, natiham? atiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Aman chuche bola chu muleng tin avelelen ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahin amanu chun achunga thilsoh chu ahen, akichasasan akihot pumpumin ahungin, a-angah aboh khupmin, ajah-a thutah jouse chu aseidoh tan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Aman ajah-a, Chanu, natahsanin nadamsah ahitai, lung mongin chenlang nanatna-a kon chun damtan, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman hiche thu chu aseina laijin, kikhopna in vaihompa in'a kon chun mi ahungun, ajah-a, Nachanu athitai; ibola houhil hi nacholsah nahlai dingham? ahung ti.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jesu'n thukisei chu ajah jah-in, kikhopna in vaihompa jah-a chun, kicha hih-in, tahsana bou neijin, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Peter, Jacob, chule Jacob naopa John hicheng tailou chu, midang koiman ajui ding aphalpon ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin kikhopna in vaihompa in'a chun ahungun ahile, anaboi cheichoi jengu le mihonpi aka le maovu chu amun ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Ama insunga alutnin, ajah uva, Ibola poh cheichoi nahiuva chule kapma nahiuvem? Chapangnu chu athi ahipoi, a-imu ahibouve, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin amahon anuisat taovin ahi. Ahivangin abonchauvin anodohsoh-in, chapangnu nule pa toh, chule ama hinkilhonpi chengse toh, chapangnu umna-a chun alutnun ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Aman chapangnu khut chu atuh-in, ajah-a, Talitha cumi, ati: hichu, boinu thouvin tina ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chupettah chun chapangnu chu ahung thouvin, adingin lam ajotpai jengin ahi; ajehchu amanu chu kum somle kum ni hia ahitai. Chutah chun amaho chun kidang mainan kidang asapouve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ahin Aman hiche thuhi koima hetsah hih-un tin thupeh khaotah aneijin; chule amanu chu neh ding an apehna diuvin thu apen ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin chua konin achedoh-in, Ama gam lamah ahungin; chule aseijuiten ajuijun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin cholngah ni ahung hi phatnin, kikhopna in'a thu ahil pantan ahi. Chuin athuhil chu mi tamtah ajaho chun kidang asauvin, Hichepa hin hoija kona hichengpi hi akilah hingana? Ama kipe-a chihna hi ipi chihna hija, akhutnin hitobang bolmo kidang dang abol jeng hitam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama hi thingthem bol Jacob, Joses, Juda chule Simon sopi, Mariam chapa chu hilou ham? Asopinute jong hikoma ilah uva um hilou hiuvam? atiuvin, chule achunga alung himo taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin Jesu'n adonbutnin, ajah uva, Themgao ama gamsungle ama inkote lah, chule ama insung tailouvah jabol louvin aum ngaipoi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukoma chun ana adamlou phabep khat chunga akhut angapma adamsah tailou chu, thil kidang imacha abol tapoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule atahsan lou jeh-u chun adatmo lheh jengin ahi. Chuin khonainai dunga ache lelen thu ahil leletai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin somleni ho chu akouvin, mini nin asoldoh-in; chule lhagaoboh chunga thuneina apen;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ajin naova dingin tenggol tailou ima, changlhah jong, sakhao jong, dangka dip sunga jong sumthem aken louhel dingun thu apen;
  </para>
  <para style="p">
    <verse number="9" style="v" />Kengchot vang kiseuvin; sangkhol thoni ki-ah hih-un, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ajah uva, Hoikom hijongle nalhun lhunnau in'a chun, chua kona napotdoh kahseuvin umun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule koi hile nalhunsah louvu le nathu seiju ngailou chu, chuche-a kona napotdoh tengule ahettohsah nan nakeng phanguva leivui sanin thinglhau vin. Keiman nangho jah-a tahbeh-a kasei ahi, thupi kitan nile chuche kho thohding sanga chu Sodom le Gomorrah gam thohding chu baijo ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun akipat doh-un, mihem ten lung ahei nadiuvin ahil lhangle uvin;
  </para>
  <para style="p">
    <verse number="13" style="v" />Thilha tamtah anodoh-un, ana damlou tamtah thao anuvin, aboldamun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Herod lengpan athu chu ajatan, (Ijeh inem itile athu chu gamtina kithanga ahitai.) Chuin aman, John Baptist athia kona thoudoh kit ahi, chuche jeh-a chu chuti thil kidang boltheina chu ama-a uma abol ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Akim khatnin, Elijah ahi, atiuvin; adangin, ama hi themgao khat, ahiloule, Themgaoho lah-a khat ahi, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Herod vang chun chuche thu chu ajah phatnin, Alol katansa John ngei chu ahi: ama athi lah-a kona thou kit ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ijeh-inem itile Herod'in asopipa Philip jinu Herodias chu akichenpi ahin; amanu jala chu amatah-in mi asola John chu amatsah-a, akana songkul'a akhum ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijeh inem itile John'in Herod jah-a, Nasopipa jinu ji-a naneija nakichenpi hi dan ngai ahipoi, ati jeh ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuche jeh-a chu Herodias chun ama chu hahot tah-a ahotna, tha ding atup ahin; ahivanginla abol theipon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh-inem itile Herod chun John chu michondih tah le mithengtah ahi ti chu ahen, akichan, avenbit ahi; chule athuhil ajah teng alung dongjin, hinlah kipahtah-in angaijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin nikho agomkom cha khat ahung umin, Herod'in apen nikho ahung hi phatnin agam vaihomte, sepai lamkaite, chule Galilee gama milen milal chengse vahnan golvah abolin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Herodias chanutah chu ahung lutnin alamin ahile, Herod le atoukhompi chengse chu alung lhaisah sohtan ahi; chuphatnin lengpan nungahnu jah-a chun, Nagotchan kahengah thumin peng kate, atitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin akihahselin, Nathum chan kagamsung kehkhat geijin peng kate, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amanu apotdoh-in anu agadongin, Ipipen kathum dingham? ati. Anun ajah-a, John Baptist luchang thumin, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuphatnin amanu mangang tah-in lengpa hengah ahungloijin, John Baptist luchang tutah-in kong khatnin neipele chun kati, tin athumtai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin lengpa alunggimta lheh jengin, ahivanginla athuteple akihahselna, chule a-ankong umpiho jal chun amanu athutepsa chu asukeh nom pon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chupettah chun lengpa chun ama ngah sepai khat John luchang la dingin asoltai. Chuin ama achen, songkul sunga alol agatan dentan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aluchang chu kong khatnin ahindomin nungahnu chu apen, amanun anu agapetai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aseijuiten ajah phatnun, ahungun along chu ahung lauvin, lhana avuitaove.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin solchah ho Jesu henga ahung kikhomun, athilbol jouseule ami hilu umchan jouse aseijun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Aman ajah uva, Nangho chang hungdoh-unlang, munthip mah chomkhat hung kicholngah-un, ati; ijeh-inem itile ahungleh achele mi atambehseh jengin, an nehna ding jeng jong ong man lou ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin amaho kongin akitolun, gamthipma achomin achedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule mipichun acheu chu amun, tamtah-in Ama chu aheuvin, khopi ho-a kon chun kengin ahung lhaijun, akhelpauvin, chule ahenga ahung kikhomun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jesu ahung potdohle mipi tamtah amun, achingbei kelngoi hontoh abah jeh-u chun alung asen, amaho chu thu tamtah ahil pantan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichun nilhangkai lam ahitan ahile, aseijuite chu ahungun ahengah, hikom hi gamthip ahin, khomala agei lhehtan ahi;
  </para>
  <para style="p">
    <verse number="36" style="v" />Hiteho hi ikimvel uva loujao le kho ho-a acheuva neh ding imathem agakichoh theina dingun soltan, ajehchu amahon nehding imacha aneitapouve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahin Aman adonbutnin amaho jah-a, Nanghon neh ding peuvin, ati. Amahon ama jah-a, Kacheuva changlhah dangka jakhat man kagachoh uva kapeh dinguham? atiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman ajah uva, Changlhah pheng ijat naneijum? gave temun, ati. Chuin anei jatnu ahet phatnun, pheng nga leh nga ni aume, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin amaho chu abonchauvin hamhing chungah aloiloijin atousah dingun thu apen;
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule amaho agol agolin ja khat cheng, somnga chengin atoutaovin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin changlhah pheng ngale nga ni chu alan, vanlam aven, phatthei aboh-in, changlhah chu ahehbal balin, mipi anga aluipeh dingun aseijuite apen; nga ni jong chu ahoppeh sohkeijin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin amahon abonchauvin aneuvin, ava sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin changlhah-a kon le nga-a kon chun aneh valu paipeh somle paipeh ni aloh dimun ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Changlhah ne-a chu mi pasal cheh sangnga tobang ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin Aman mihonpi chu alhadoh lai sung chun, aseijuite chu gal lang khat lama Bethsaida anagalkai masa dingin kong'a chun alutsah-in, asolpaitan ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin amaho chu alhah dohsoh phatnin, tao dingin mol chunga akaltoutai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin nilhah ahung hi phatnin, kong chu dillen lailunga aumin, Ama achang seh-in tolla aumin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin huijin ale lama anuh jeh uva, amaho dillena alungdonu chu amun; khovah ding kon lamin akengin twi chunga lam ahinjotnin, amaho henglam ahinjonin, amaho chu kheldin agon ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ahin amahon twi chunga kenga lam ajotna aheng lamuva ahung amu phatnun, Joumi hinte, atiuvin, a-aosot jengun ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ijeh-inem itile abonchauva Ama chu amu soh keiju ahin, atija lheh jengun ahi. Ahivangin Aman amaho chu ahinhou paijin, ajah uva, Lungmong tah-in umun; keima kahi, kicha hih-un, ati.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin kong sunga amaho henga akalin ahile, hui chu athip jengtan ahi. Hichun amahon seitheilou khophelin kidang asalheh jengun ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ajeh chu changlhah thudol jong chu hephata louva, lungtah chehjoa ahitaove.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin agalkaijun Ganesaret gamsung alhungun, kong chu twipam chinah angataovin ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin kong'a kona apotdoh doh-un ahile, miho chun anahe paitaovin,
  </para>
  <para style="p">
    <verse number="55" style="v" />Agam sunguva alhai kimvel leuvin, chua aume ti ahetna chanuva ana damlouho chu alupna pumin ahinpuvin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Akho akhoa, khopiho-a, chule loujaovah alutna chan-ah, ana adamlou ho chu lamlena alupsah-un, apon mongkai beh atham dinguvin ahenga ataovun ahi. Chuin athamkha chan chu adam jengun ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jerusalem'a kona hunga Pharisaiho le danthu sunho lah-a phabep khat akoma ahung kikhomun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hiteho chun aseijuite kimkhatnin khutboh puma, khut sil louva, changlhah aneh-u amutauvin ahile themo achanun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ijeh inem itile Pharisaiho le Juda te jousen upate khanga ahung chonna dan amangun, khut phatecha silngim louva an ne louhel ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kailhang mun'a kona ahung tengu jongle kisil louvin an aneji pouve. Chule khonho, belho, sum-eng belho, chule dokhang ho sopding thudol le adang tamtah jong aneijun, atuhchah kheh-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pharisai ho le danthu sunhon adongun, Ibola naseijuite hi upate akhang akhanga ahung chonna dan manglouva, khutboh puma changlhah anehjiuham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman amaho chu adonbutnin, ajah uva, Isaiah themgaovin miphalhem nangho thudol aseije, Hiche phung mite hin akam sunguvin eichoi-anun, alungthimula keija konin gamlatah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahoi hitaleh amahon athu hilu hi mihem thupeh jeng ahilu ahi jeh-in, eihouvu hi moh ahi, tia kisun chu atahbeh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu nanghon Pathen thupeh tahbeh chu nakoi doh-un, mihem akhang akhanga ahung chonnao bel le khonho not theng danjoh naha tuh jouvin, chule hitobang thil adang tamtah nabolun, ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman ajah uva, Nanghon nangho akhang akhanga nahung chonnao dan namandet theina dingun, Pathen thupeh chu kichentah-in napai uvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh-inem itile Mosi'n, Nanu le napa jabolun; chule anu le apa hou se-a chu thihel hen, ati ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla nanghon nahiti seijiuve, Koi hileh anule apa jah-a, Kavanga naphatchomna dingu jouse chu Corban ahitai, (hichu Pathen henga peh ahitai tina ahi,) atile,
  </para>
  <para style="p">
    <verse number="12" style="v" />Anu dinga ahin, apa dinga ahin jong ima atohpeh ding najada jiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho chonna thu mi napehsonu chun, Pathen thupeh imalou nasouvin; hitobang thil chu tamtah naboljiuve, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin mihonpi chu ahenga akoukitnin, ajah uva, Nabonchaovin kathusei ngai phauvin lang hetoh-un;
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihem polama kona asunga lutna ama suboh thei imacha aumpoi. Asunga kona hungpotdoh chengse chun asuboh joh ahibouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angaina ding nakhang neija aumle ngaihen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Aman mipi adalhah-a insunga alutjouvin, aseijuite chun thulem chu adongchen taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Aman ajah uva, nangho jong hitobang loma hetna neilou nahinah laiju ham? Itobang hijongle pama kona mihem sunga lut chun ama asuhboh theipoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ijeh-inem itile alungsunga lut louva a-oisunga lutna, hitia chu a-anneh jouse asuthengji-a, aposona ah ahungdoh ji ahi nahet louvu ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Aman, Mihem lung sunga kon hungpot chun, hichetah chun mi asuboh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ijeh inem itile mihem sung, alung sunga kon lung gilou, jonthanhoi, guchat, toltha,
  </para>
  <para style="p">
    <verse number="22" style="v" />Miji toh jon, papsetna, gitlou engsetna, mi dohabol, huhna, kimit thipna, kitaitom, hoitho, ngolna;
  </para>
  <para style="p">
    <verse number="23" style="v" />hicheng thilphalou hi mi sunga kona hungpot doh-a, mihem asubohji ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin akipatdoh-in chukom mun chu adalhan, Tyre le Sidon gamkol sunga achen, hikoma chun in khatna alutnin, koima ahetsah nompon, ahinla akisel theitapon ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutichun numei khat achanu lhagao boh vop ahin, ama chungchang thu chu ajan, ahenga ahungin, akeng khopimuh-a abohkhup paijenin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Numeinu chu Greek mi ahin, anam lama chun Syro-Phoinicia mi ahi. Amanu chun achanu sunga kona thilha deldoh dingin ataovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahin Jesu'n amanu jah-a, Chate cheng vamasa tadihen; chate changlhah lahpeh-a uichate koma selhah aphapoi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin amanun ajah-a, Ahinai, Pakai, hijongle dokhang noija um uichan jong, chate changlhah neh hal anehkhahji khula-em, tin adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Aman ajah-a, Nathusei jeh chun chetan; thilha chu nachanu sunga konin apotdohtai, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin amanu a-in lamah achen ahile, thilha anapot doh-a, achanu jalkhuna analup agatoh-in ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Tyre gamkol sung chu adalhan, Sidon ajotnin, Decapolis gam ajotpeh-in, Galilee dillen alhungtai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin mi na-ngong pao jong paochen thei lou khat hi ahenga ahinpuijun, achunga akhut angap dingin ataovun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Aman mipi lah-a konin achangin apuidoh-in, akhutchalin anasung akhoijin; chuin achil asetnin, alei athamin;
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin vanlam aven akhoisan, ajah-a, Ephphatha, ati. Hichu, Kihongin, tina ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuphatnin ana avangin, aleigui jong akilhamtan, kichentah-in apao theitai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Aman amaho chun koima jah-a asei louna dingun akhamin ahi; ahinla Aman ahakham chehle, amahon ahaseiphong cheh-un;
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule kidang asabeh seh-un, Aman ijakai abolpha sohtai: na-ngongla kho ajahsah-in, paomola apaosah theije, atiuvin ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichelai chun mihonpi chu atamlheh jengtan, chule nehding ima aneilou jeh-un, Jesu'n aseijuite chu ahenga akouvin, ajah uva;
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihonpi hi kakoma aumnao ni thum alhingtan, neh dingla anei hih-un, kalung ase lheh-e;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule an ne louvin a-inlam cheh uva sollengla lhasampa ding ahiuve; ajehchu akimkhat hi gamlatah-a kona hung ahiuve, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aseijuiten adonbutnun, ajah-a, Hiche kom gamthip laija mi hichengpi ninglhinga vahna ding changlhah kon hoija kona alah dingham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Aman mipi chu adongin, ajah uva, Changlhah pheng ijat naneijum? ati. Chuin amahon, Pheng sagi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Aman mipi chu tolla tou dingin thu ape-in; chuin Aman changlhah pheng sagi chu alan, athangvah in, chujouvin ahehbal balin, a-anguva luipeh dingin aseijuite chu apen, amahon mipi anga chun aluipeh-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nga neocha cha phabep khat jong aneijun; hi jong chu phatthei aboh-in, a-anguva luipeh dingin asoltan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amahon aneuvin, ava sohkeijun, aneh moh-u ahal chu longkai sagi alohdoh-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche an neho chu mi sangli tobang ahiuvin ahi. Chuin amaho chu asol tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Ama aseijuite toh kong'a alutpaijun, Dalmanutha gam alhung taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pharisai ho chu ahungdoh-un, apatepnan thu adongun, van'a kona melchihna aholtauvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Ama alung sunga akhoisan, Tukhang mite hin ibola melchihna aholuham? Tahbeh-a kasei ahi, Hiche tukhang mite hi imacha melchihna kipe lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amaho chu adalhan, kong'a alut kitnin, lang khat panga dingin akipatdoh tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amahon changlhah akeng haijun; kong'a chunla pheng khat tailou adang aumhih helin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Aman amaho chu ahilchah-in, ajah uva, Chingtheijun; Pharisai ho chol le Herod chol lah-a kihong phaovin, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amahon, Hiche hi changlhah ineilou jeh-u ahi, tin akihou lhiuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichu Jesu'n ahetdoh phatnin, ajah uva, Changlhah nanei loujeh uva ibola kihouhou nahiuvem? Tugeija nalunguva hedoh loulai nahiuvem? Nalungu tahsah jing nalai nahiuvem?
  </para>
  <para style="p">
    <verse number="18" style="v" />Mit neijuva mu theilou nahiuva, nakhang neijuva ja thei lou nahiuvem? Gel jong nagel doh lou mongu ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi sangnga lah-a changlhah pheng nga kahop peh-a chu nehmoh ahal longkai ijat nalo dimum? atile, amahon, Somleni, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi sangli lah-a pheng sagi kahop peh-a chu nehmoh hal longkai ijat nalo dimum? atile, amahon, Longkai sagi atiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Aman ajah uva, Iti dana tu-a jong hedoh loulai nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Bethsaida'a ahungin; hikoma chun mitcho khat ahenga ahinpuijun, atham dingin Ama henga ataovun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Aman mitchopa chu akhutnin atuh-in, khosunga kon chun apuidoh-in; chuin amitna achil asetnin, achunga khut angamin, Kho namu-em, tin adongin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama adahdoh-in, Mihem chu thing tobangin kamun, avahleuve, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujouvin amit akhutnin atham kitnin, chuin adadoh sah-in ahile adamhel jengin, chule mi jouse kichentah-in amu theitan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Aman ajah-a, khopisunga jong lut hih-in, khopi sunga koima cha jong hetsah hih-in, tin a-in lama asolmang tai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Jesu le aseijuite apotdoh-un, Caesaria Philippi'a khoneo dunga acheuvin; lam dunga aseijuite jah-a, Mihon keima hi koi ahi eitiuvem? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin amahon, John Baptist ahi atiuvin; ahin abangin Elijah ahi atiuvin; adangsen Themgaoho lah-a khat ahi atiuve, tin aseijun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Aman amaho adongin, Nanghonla koi ahi neitiuvem? ati. Chuin Peter'in adonbutnin, Nangma Christa chu nahi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Aman ama thudol koimacha jah-a asei louna dingun hakhamin akhamin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Aman amaho chu, Mihem Chapan thil tamtah athoh-a, vaipo upa hole thempu pipuiho chule danthu sunho pampaija umding, kithatna chule ni thum joule thoudoh kit tei ding ahichu ahil pantan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman hichu phongtah-a asei ahi. Hiche chun Peter'in ama apuidoh-in ahousetan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahin Ama akiheijin, aseijuite aven, Peter chu aphoh-in, Kanung lama chen, Satan; nangman Pathen thulam gel louvin, mihem thulam jeng nagele, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Aman aseijuite le mihonpi chu ahenga akouvin, ajah uva, Koi hile kanung eijui noma chun ama kingaitom henlang athingpel kiput hen chule kanung hinjuihen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ijeh-inem itile koi hile ahinna huhhing noma chun achan ding; amavang koi hile keima jal leh Kipana Thupha jala ahinna chana chun ahuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ijeh-inem itile mihemin vannoi leiset apumpin neihenlang ahinna chantale, ipi phatchomna anei dingham?
  </para>
  <para style="p">
    <verse number="37" style="v" />Min ahinna khela ipi apeh dingham?
  </para>
  <para style="p">
    <verse number="38" style="v" />Koi hijongle tulai khang jonthanhoina le chonsetpan lah-a keima le kathu jachat chan chu, Mihem Chapan jong a-Pa loupina-a avantil thengtetoh ahung nile ama chu ajachatpi ding ahi, ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Aman ajah uva, Tahbeh-a kaseipeh nahiuve, Hikoma dingho kimkhat hi Pathen lenggam thanei tah-a ahung lhun amu kahseuva thina tepkha lou ding aumuve, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ni gup jouvin Jesu'n Peter toh, Jacob toh, chule John atumin apuijin, molsang chung khatna apuitouvin, chuin Ama amaho ang sungah avou akikhelin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule aponsil chu koimachan chutobang tah-a asopbang joulou ding khopmin abanglah lah jengin, buhbang sangin jong abangjon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Elijah leh Mosi ahengah ahung kilah lhonin, Jesu toh akihouvun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Peter'in Jesu jah-a, Rabbi, hikoma i-umu hi eiho dingin anome; lhambuh thum songung kate, khat nangma ding, khat Mosi ding, chule khat Elijah ding, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu akichat behseh jeh-a seiding hetmoa asei ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin meilhang khatnin amaho chu ahinlekhun; mei lah-a kon chun aw ahung gingin, Hiche hi Ka-Chapa deitah ahi; athu ngaijun, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin phulou helouvin akimvelu avetnuva ahile, koimacha amuta hih-un, Jesu changsehle amaho changbou aumtaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin molsanga kona ahung kumsuh phatnun, amaho chu hakhamin akhamin, Mihem Chapa athia kona athodoh kit kahsen koima jah-a seidoh hih-un, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Athusei chu alunguvah aching jingun, athia kona athodoh kit chu ipi aseina ahidem, tin akidongto jiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon adongun, Ibola danthu sunhon Elijah hung masa ding ahi atiuham? atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman adonbutnin, Elijah chu tahbeh-a hung masa-a, ijakai ahung semphat dingmong ahi; chule itidana Mihem Chapa thudol, Aman hesoh genthei tintang athoh-a chule mi nahsahmo-a aumding ahi, tia kisuna ham.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijongle keiman nangho kaseipeh nahiuve, Elijah chu ahungsa ahitai, chule akhanchan dingthu asut bangtah-u chun achunga anopnop aboltauvin ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aseijuite henga ahungin ahile akimveluva mi tamtah auma, chule danthu sunho chun thu adoh uva anakinelpiu amun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin mipi chun Ama amu mu-un kidang asa lheh-un, aheng lamah ahung lhaipaijun Ama chu alamtouvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Aman danthu sunho jah-a, Amaho khutoh ipi kinela nahiuvem? tin adonge.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin mipi lah-a khatnin ahindonbut nin, Pakai, kachapa nahenga kahinpui ahi, ama lhagao paomon avopmin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hoikom hijongle aman amat matna-a aheh lhujin; chule achilphon alhan, aha ageljin, chule apumin akangjin; chule einodohpeh nadiuvin naseijuite henga kaseijin; amahon ajou pouvin ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Aman adonbutnin, ajah uva, Vo tahsanna neilou khang mite, nakom uva itihchan kaumpi ding nahiuvem? Itihchan kakhongai ding nahiuvem? kahenga hinpuijun, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amahon ahenga ahinpuijun ahi. Chuin Aman ama chu amu phatnin, lhagaoboh chun amapa chu nasatah-in aveingoi paijenin ahile tolla alhun, achilphon alhalet lutnin akilihlelen ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jesu'n apa jah-a, Ahiti nahi itihchan hitam? ati. Hichun aman, Achapan laija pat ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule suhmang dingin abangle meijah, abangle twijah aleh lut lhoijin ahi: hijongle nangman alonaje nahetle, neilungset in neihutan, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu'n adonbutnin, Natahsan photle! Atahsan ding chun ijakai ahi thei sohkeije, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutah chun chapangpa pa chun, amitlhi pumin, Pakai, katahsane; katahsan lelna-a neihun, tin asamtai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Jesu'n mihonpi hung lhaikhom chu amun, lhagao boh chu aphoh-in, ajah-a, Nang lhagao paomole na-ngong, thu kapeh nahi, asunga kon chun hung potdoh-in, chule lutkit tahih-in, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichun lhagao chu apengin, hatah-in avei ngoijin, ama-a konchun ahung pottan ahi. Hichun chapangpa chu athi bangin aumtan, chuphatnin mi atamjopi chun, Athi hita khu, atiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahin Jesu'n akhutnin amanin, akaithouvin ahile, ahung thoudoh jengtan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Jesu insung agalut phatnin, aseijuiten guhthimin, I-atile keihon kanodohjou louvu ham? tin adongun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman adonbut-in, Hitobang hi an ngola taona tailouvin akinodoh theipoi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin chua kon chun achedoh-un, Galilee gam ajotnun, hichu min ahet ding Ama anompon ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ijeh-inem itile Aman aseijuite ahilpeh jin, ajah uva, Mihem Chapa chu mihemte khutna kipedoh ahitan, amahon atha dingu; chule akitha jouteng, ni thum nile Ama hingdoh kit ding ahi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahivangin athusei chu ahethei pouvin, Ama doh dingla akichauvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chutichun Ama Capernaum ahung lhungtan ahi. Chuin in sunga aumpetnin amaho chu adongin, Lampi'a chu ipi nakinel piu ham? ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahivangin amaho lampi'a chu, Ilah uva hin koi hi alenpen ahidem? tia akinel jeh-u chun athipchet jengun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichun atouvin, somleni ho chu akouvin ajah uva, Koi hijongle amasapen hinom chu nukhah pen ding ahi, chule mi jouse jenlea pang hi ding ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin chapang neocha khat akouvin, alaijuva adinsah-in; chuin apomin, ajah uva,
  </para>
  <para style="p">
    <verse number="37" style="v" />Koi hijongle keima mina hitobang chapangcha khat sanga chun keima eisan ahi; chule koi hileh keima eisang chan chun keima eisan hilouvin, eihinsolpa asanjoh ahi, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />John'in adonbutnin ajah-a, houhil namina thilha nodoh mikhat kamuvin, eijui pouvin ahi: chule eijuilou jeh uvin kakham taove, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahin Jesu'n, Kham hih-un; kamina thil kidang bola, keima eiseiseloi theija koima aumpoi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ijeh-inem itile koi hijongle eiho eidou lou tapou chu eiho lama pang ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Koi hijongle Christa mi ahi tia ama mina twi khon khat don ding napechanu chu, tahbeh-a kaseipeh nahiuve, iti nama jongle kipaman asan ding chu achanlou ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule koi hijongle keima eitahsanna hiche aneochaho lah-a khat kipal lhuhsah chan chu, angonga sumhei song lentah kikhai henlang, twikhanglen'a kileh lutle ama dingin aphajoi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule nakhutnin nakipal lhuhsah-a ahile tanbong jengin, khut ni neija damun meikong mitthei louva nache sangin, tibukim louva hinna-a lut nangma dingin aphajoi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Damun chu Alungla thimo ameikongla mitmo ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule nakengin nakipal lhuhsah-a ahile, tanbong jengin; keng ni neija imatih-a mittheilou damun meikonga nakilelut sangin, kengbaija hinna-a lut nangma dingin aphajoi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Damun chu alungla thimo ameikongla mitmo ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule namitnin nakipal lhuhsah-a ahile kaldoh jengin; mit ni neija damuna nakilelut sangin, mitlang cho-a Pathen lenggama lut nangma dingin aphajoi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Damun chu alungla thimo ameikongla mitmo ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ijeh-inem itile mijouse meija chisoa kiso ding, chule ganlhaina jouse chi kiso-al ding ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chi hi aphai: ahivangin chi jong hi a-al hi tamtahen lang hileh ipi-a na-alsah kit dinguham? Nasunguva chi neicheh-un, khat le khat kichamdel cheh-in umuvin, ati.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Ama chua konin akipatdoh-in, Jordan gal lama konin Juda gamkol sung ahungtan ahi. Chuin mihonpi chu ahenga ahung kikhom kit taovin, chutichun Aman angaijin amaho chu ahil kittan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pharisai ho ahenga ahungun, apatepnan thu adongun, ajah-a, Min aji ada hi dan ngai hinam? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu'n amaho adonbutnin, Mosi'n nangho thu iti napeh-um? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amahon, Mosi'n kidana lekha sutna, chule da ding aphasah ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu'n adonbutnin ajah uva, Nangho lungtah jeh-a aman hiche thupeh chu nangho dinga asut ahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin leiset kisemtila patna Pathen'in amani chu numei le pasal'a asemsa ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche jeh-a chu pasal'in anu apa adalhah-a ajia beh ding ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amani chu ti khat hilhon ding ahi. Hiti chu ahin amani pumni mi ni hita louvin ti khat ahi lhontai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun Pathen gopsa chu mihemin sukhen hihen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin in sungah aseijuiten hiche thudol chu adong kitnun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman ajah uva, Koi hileh aji da-a ji dang neichan chun ajinu chu ajonsan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Numei jin jong apasal ada-a mi dangtoh akichenle, ama jong chu ajonga ahi ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin atham dingin chapang neochaho ahenga ahinpuijun ahile aseijuiten anaphoh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin hichu Jesu'n amun, alung phamon, ajah uva, Chapang neochaho chu kahenga hung sah-un, jada hih-un; ijeh-inem itile Pathen lenggam chu hitobang tehoa bou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tahbeh-a kaseipeh nahiuve, Koi hile chapang neo tobanga Pathen lenggam sang lou chu, iti nama jongle chua lut louhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amaho chu apomin, achunguva akhut angamin, phatthei aboh tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Ama lampi dunga che dinga apotdoh pettah-in, mi khat ahung lhaijelin, a-angah adilsun, Houhil pha, itileng tonsot hin kemlou kachan thei dingham? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jesu'n ajah-a, Ibola apha neitiham? Pathen khatseh tailou koimacha apha aumpoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thupeh chengse, Tolthat hih-in, Jon bol hih-in, Gucha hih-in, Dohan mi bol hih-in, Nanu napa jabolin, ti chu nahenai, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin amapan adonbutnin, ajah-a, Houhil, hichengse chu kachapan laija patna kahin nitpeh ahitai, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jesu'n ama chu aven ahile angailun, ajah-a, Khat nabat nalaije; chenlang nanei chengse gajoh inlang mivaicha gentheiho petan, chutile van'a gou nanei ding ahi; chule cross kiput inlang kanung hinjuijin, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chucheng asei ajah phat chun amai athimkot jengtan, chuin gou haotah ahi jeh-in lungnom mo tah-in achemang tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuphatnin Jesu'n aseijuite ave kimvelin, Mihaoho hi Pathen gama alut dingu iti hahsat hitam! ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutia ati chu aseijuiten adatmo lheh-un, ahivangin Jesu'n aseikitnin, Chapangho, haona-a kingai miho Pathen lenggama alut dingu iti hahsat hitam!
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihao Pathen gama alut sangin heubil homa sangongsang lut abaijoi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amahon kidang asabehseh jengun, ajah-a, Chuti ahile, koi huhhing-a um jou dingham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Jesu'n amaho chu aven, Mihem dingin hitheihoi ahipon, Pathen dingin vang ahimopoi; ijeh-inem itile Pathen dingin ijakai ahitheije, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peter'in ajah-a, Vetemin, keihon ka-ima jouseu kadalhaovin, nanung kahinjui taove, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu'n, tahbeh-a kaseipeh nahiuve, Keima jal leh Kipana Thupha jala, a-in, asopipate, asopinute, anu, apa, aji, achate, chule agam leiset hindalha-a chu,
  </para>
  <para style="p">
    <verse number="30" style="v" />Tu ahinlai sungahi bolsetna thoh pumpuma ajat ja-a in, sopipate, sopinute, nu, pa, ji, chate, gam leiset changlou ding aumpon; chule ahung lhung ding khonung hinkho-a chu tonsot hin kemlou chang lou ding koima aumpoi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amavang amasa cheng tamtah nukhah intin, anukhah cheng masa ding ahi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Jerusalem chetou dingin acheuvin, lamdung ageijun Jesu amasan ahile adatmo lheh jengun; chule anunga cheho chu akicha taovin ahi. Chuin Aman somleni ho chu ahenga akou kitnin, ajah uva achunga ipi ahung lhun ding hichu aseipanin,
  </para>
  <para style="p">
    <verse number="33" style="v" />Veuvin, Jerusalem jonin ichetouvui; chukoma chu Mihem Chapa hi thempu pipui le danthu sunho khutna pehdoh-a umding, amahon themmo achansah uva chidang namdangte khutna apehdoh dingu;
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule amaho chun a-el ela aboldiu, avoh diu, achil asetkhum dingu, chule atha dingu ahi: chule nithum ni le ama thoudoh kit ding ahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Zebedee chapate ni Jacob le John ahenga ahung lhonin, ajah-a, Houhil, nahenga kathum chan lhonhi neibolpeh lhonle chun kalung lhon ahi ati lhone.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hichun Aman, Ipi bolpeh lhonleng nagot lhonem? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amanin adonbut lhonin, ajah-a, Naloupi na-a chun khat najetnah, khat naveijah neitousah lhonin, ati lhonin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahin Jesu'n ajah lhonah, Nathum lhon chu nahe lhonpoi: kadona ding khonna hi nadon ngam lhona chule kachan ding baptize hi nachan ngam lhon ding hinam? ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hichun amanin ajah-a, Kangame, ati lhonin ahi. Chuin Jesu'n, Kadon ding khonna vang nadon lhon ding ahin, chule ka baptize channa-a jong baptize nachan lhon ding ahinai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahivangin kajetle kaveija tousah ding vang chu keima peh dol ahipoi, gotsa kikoipehho kipe ding ahibouve, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hichun somho chun hichu ajauvin, Jacob le John chunga alung phamo pantaovin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahinla Jesu'n amaho chu akouvin, ajah uva, Chidang namdangte chunga vaipo tia kiseiho khu a-pakaiyun laltah-in aumun, chule amilen milaltehon achunguva athu neinao apanjiuve ti nanghon naheuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangho lah-a vang chu tichu ahipoi: ahin koi hile nangho lah-a alen hi noma chu nalhachaova pang ding;
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule nalah uva apipuipen hi noma chu mi jouse soh hi ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ijeh-inem itile Mihem Chapa tah jongchu jen dinga hung hilouvin, ajenle dingle mi tamtah lhatdoh nadinga ahinna toh dingjoh-a hung ahibouve, ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Jericho khopi ahung lhung taovin ahi. Chuin aseijuitele mihonpi toh Jericho khopi-a kona akipat doh-un ahile, Timaeus chapa Bartimaeus kiti mitchopa chu lamkenga khutdon anatouvin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nazareth Jesu ahi ti ahet phatnin, Vo David Chapa Jesu, neilungset in, tin asampantan ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Mitam tah-in ama chu thipbeh-a umdingin aphoh-un; ahivangin ama chun, David Chapa, neilungset in, tin ahasap chehtan ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin Jesu adingin, agahkou dingun thu apen ahi. Amahon mitchopa akouvun, ajah-a, Lung mongin umin, kipatdoh-in, nakouve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin ama chun apon aleh lhan, akipatdoh-in, Jesu henga achetai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin Jesu'n ama chu ahouvin, Keiman nangma iloleng nalungham? ati. Chuin mitchopa chun ajah-a, Rabbi, kho muleng kati, ati.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin Jesu'n ajah-a, Chetan, natahsanin nadamsah ahitai, ati. Chupettah chun kho amupai jengin, lamdung lhung chun Jesu ajuitan ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerusalem kho koma Olivet mola Bethphage le Bethany ageijun, aseijuite lah-a mi ni asolin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajah lhona, Namasang jon lhona kho sunga khun lut lhonin: kho sung nalut lut lhonle, sangan nou kihen koima touna khah loulai namu paijen lhon ding ahi, hichu sut lhoninlang hinkai lhonin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule mi khattouvin, Ibola nasut lhonham? tia donga aumle, Pakaiyin manna nom aneije, ajole hinthah vah kit paitante ti lhonin, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amani ache lhonin ahile, khopi sung lam lena inpoa kotphunga sangan nou kihen khat amu lhonin, hichu asut lhonin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukoma dingho kimkhatnin, Ibola sangan nou chu nasut lhon ham? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amanin Jesu'n ahilna lhon bangin amaho jah-a asei lhonin ahile, ahinlha taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amanin sangan nou chu Jesu henga ahinkai lhonin, chuin aponu achunga aphaovin, achunga Ama atouvin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin mi tamtah-in lampia aponu aphaovin, abangin loulaija theoboh asatnun aphaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amasa chengsele anungjui chengsen, Hosanna; Pakai mina hungpa chu anunnome;
  </para>
  <para style="p">
    <verse number="10" style="v" />I-pau David lenggam hung lhung ding chu anunnome; Chungnung pena Hosanna, tin asam asamun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jesu Jerusalem khopi-a houin'a chun agalutnin; chuin ijakai avetle soh phatnin, nilhah lam jong ahitan apotnin somleni ho chutoh Bethany'a achetan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ajingin, Bethany'a kona ahung potdohle agil akeltan;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin gamlatah-a hin theichang donei amun, aga kamu khatle tin achele ado tailou ima agamu tapoi; ijeh-inem itile theichang chu aga phat mong jong hilou ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jesu'n thingphung jah-a chun, Tukallin a-imatih chanin koiman naga ne hihhen, ati. Chutia ati chu aseijuiten ajauvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jerusalem ahung lhunun, Jesu houin'a alutnin, houin sunga thil johho le thil choho anodoh panin, chule sum lhengho dokhangle vakhu johho touna chu alekhup peh-in;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule houin sunga chun koiman thilkeo apohle ding aja nomtapoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ajah uva, Ka-in chu namtin dinga taona in kiti ding ahi, tia kisun hilouham? Ahin nanghon gucha michom kokhuh-in nasemtaove, tin aseitan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin thempu pipuiho le danthu sunhon hichu ajauvin ahile Ama suhmangna dingje chu aholtauve; ijeh-inem itile mipin athuhil chu kidang asah cheh jeh-u chun, Ama chu akichauvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin nilhah ahi phatnin, khopi sunga konin apotdohtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin jingkah-in ahopauvin ahile, theichang phung chu ajung geija ana goptah chu amuvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Peter'in ageldoh-in, ajah-a, Vetan, Rabbi, theichang phung nagaosap chu agopjoutai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Jesu'n adonbutnin, ajah-a, Pathen tahsanun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tahbeh-a kasei ahi, Koi hile hiche molsang jah-a, Kichondoh inlang twikhanglen'a kilehluttan tia; chule alunga tahsan lelna beihela, atiti hijeng ding ahi tia tahsan chu, atiti hi thei ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche jeh-a chu kati ahi, nataova thil nathum chanu chu namusan ngaitoleu chun namu dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule atao dinga nadin petle, van'a na-Pau jongin nasuhkhelnao angaidam theinan, koi itobang hijongle nalungdou chu ngaidamun.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nanghon mi suhkhel nangaidam lou vangule, van'a na-Pau vin nangho suhkhel jong angaidam lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Jerusalem'a ahung kitnun; chuin Houin sunga avahlelen ahile thempu pipuiho le danthu sunho chule upaho ahenga ahungun;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule amaho chun, Ipi thunei na-a hitiho hi nabolham? Hiti bol dinga hiche thuneina nape-a koiham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahin Jesu'n ajah uva, Keiman nangho thu khat donging kate, neidonbut un; chule keiman ipi thuneija hicheng kabol ahi seipehnao vinge.
  </para>
  <para style="p">
    <verse number="30" style="v" />John baptize bol chu van'a konha, ole mihem'a konham? Neidonbut un, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin amaho akingai touvin, Van'a kon ahi tileuhenla chuti ahile, Ibola ama natahsan lou uham? tintin;
  </para>
  <para style="p">
    <verse number="32" style="v" />Mihem'a kon ahi tileu henla; mi jousen John chu themgao tahbeh-a angaito cheh ahi jeh chun, mipi chu akichauvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuti chun amahon Jesu chu adonbutnun, Kaseithei pouve, atiuvin ahi. Hichun Jesu'n adonbutnin, ajah uva, Achutile ipi thuneija hicheng kabol ahi, keiman jong seipeh deh pouvinge, ati.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Aman ajah uva thulemin thu aseipanin, Mikhatnin lengpilei abolin, palin aumkimvelin, lengpiga chil lhahna pum alaijin, insang asan, chuin aleilhouho khutna apedoh-in, migam danga achemang tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aga lhun phatnin, ama chanding aga chu la dingin aleilhouho henga asoh khat asolin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun alei lhouhon amapa chu amanun, avovin, agoh-in akilesah taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman asoh chomkhat asol kitnin ahile, ama chu songin asepmun, alu anamavo uvin, chule jachat umtah-in abolun asolmang taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin achomkhat asol kitleuvin ahile, ama chu anathatnun, chule adang tamtah jong abang avovin, abang athatnun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman chapa deitah khat anei nalaijin, anunung penin, Kachapa hi anajabolunte, tin ama chu asoltai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla chuche leilhouho chu akihoutoh-un, Ama hi agou lo ding chu ahi, khaije that uhite, chutile agou lo ding eiho ichan dingu ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amanun athatnun, chuin lengpilei polama alehdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lengpilei neipa chun i-alo tadem? Ama hungintin aleilhouho chu sugamintin, lengpilei chu midang apeh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche Pathen lekhabua thuhi nasimkhah hih-um; In sahon adeimoa apaiju song chu Aninga songpipenin apangtai;
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche hi Pakai thilbol ahin, Chule imitmuvin akidang lheh jenge, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin chuche thulem asei chu amaho gotna-a asei ahi ti aheuvin, ahinla mipi chu akichauvin ahi; chuin Ama adalhauvin achemang taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichun athuseija kon man dingin, Pharisai ho phabep le Herod loi phabep ahenga asolun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho chu ahengah ahungun, ajah-a, Houhil, nangma mi dihtah nahin, koima gin naneipoi; nangman mimai navepon, dihtah-a Pathen lampi chu nahile ti kaheuve: Caesar kai kapeh-u hi dan ngai hina, hilouham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Kapeh dinguha, kapehlou dinguham? atiuve. Amanla aphatlhem bolu chu ahen, adonbutnin, Ibola neilung lah-uham? Denarius khat hinchoijun, neivet sah-un, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahinchoijun ahile Aman ajah uva, Hiche hi koilim le koimin ham? ati. Amahon, Caesar'a ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jesu'n ajah uva, Caesar'a chu Caesar peuvinlang, Pathen'a chu Pathen petangu, ati. Hiphat chun amahon adatmo lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Saddukai ho, Mithi thokitna aumpoi tiho chu ahenga ahungun, ajah-a thudoh aneijun,
  </para>
  <para style="p">
    <verse number="19" style="v" />Houhil, koi hile sopinei khattouvin cha nei louva aji athisana ahile, asopipa chun ajinu chu jin neihenlang, asopipa ding chun chi khaipehhen, tia Mosi'n lekha eisutpeh-u ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ucha pasal sagite khat aumun: amasapenpa chun ji aneijin chikhai louvin athitan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Abanapan amanu chu jin aneijin, chikhai louman athin, athumnapa jong chutima chu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun pasal sagi chun jin aneijun, chikhai lou ahitaovin; akhonna-in anumeinu chu athitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahile thokitna-a amanu chu alah uva koipen ji hitantem? Ijeh-inem itile asagiuva amanu chu ji-a anei sohkeiju ahi, atiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu'n amaho adonbutnin, ajah uva, Pathen lekhabu thu le Pathen thahatna nahetjoh sangu aum lou jeh-a nakheljiu hilouham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu mithiho athia kona athodoh tengule akicheng tapouvin, chen jong akichensah tapouve; ahin van'a vantilte tobang ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mithiho kaithouvin aumui ti thudola, Pathen'in, Keima Abraham Pathen, Isaac Pathen, Jacob Pathen kahi tia hamboh lah-a kona Mosi akihoupi chu Mosi lekhabua simkha lou nahiuvem?
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama athiho Pathen hilouvin, ahingho Pathen ahijo bouve; hakhela nakhelu ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin danthu sunho khatnin akinelnao chu ahung jan, chule Jesu'n amaho kichehtah-a adonbut chu ahen, Thupeh jouse lah-a hoipen hi thupipen ham? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu'n adonbutnin, Apipen chu hiche ahi, Vo Israel chateho, ngaijun, Pakai i-Pathen'u chu Pakai khatsehbou ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangman nalung pumpin, nalhagao pumpin, nalungthim pumpin, chule nathaneina apumpin, Pakai na-Pathen chu ngailun. Hichehi thupeh masapen ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anina hiche hi ahi, Nangma naki ngailut bangin naheng nakom ngailun. Hiteni sanga thupeh lenjo aumpoi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin danthu sunpa chun, Houhil, nasei dih tangeije, nangman thutah nasei ahi: Ajehchu ama khatsehbou ahi, ama ti lou adang aumpoi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule, Ama chu lung pumpi-a, hetna pumpi-a, hinna pumpi-a, thanei pumpi-a ngailut ding, chule eima ikingailut banga iheng ikom te ngailut chu pumgo thilto le ganlhaina jouse sanga gamchenga phajo ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Danthu sunpan hechentah-a adonbut ajah phatnin Jesu'n, Nangma Pathen lenggam toh nakilatpoi, ati. Chukal chun koiman thu adong ngamtapoi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Houin sunga athuhil petnin, Jesu'n adonbut-in, Danthu sunhon Christa chu David chapa ahi atiu hi itidana aseiju ham?
  </para>
  <para style="p">
    <verse number="36" style="v" />Ajeh chu Lhagao Thengin ahila konin David ama tah-in, Pakaiyin ka Pakai jah-a, Keiman namelmate chengse nakeng chotpha-a kaneisah masangsen, Kajet lamah tou jingin, tin aseije.
  </para>
  <para style="p">
    <verse number="37" style="v" />David amatah-in Pakai asah-in, achutile achapa iti hi thei dingham? ati. Milhamho chun Jesu thusei chu thanom tah-in angaijun ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Aman athuhilna-a chun ajah uva, Sangkhol choltah kiah-a kholai len noma, chule kailhanga min chibai aboh ding deiho,
  </para>
  <para style="p">
    <verse number="39" style="v" />Kikhopna in le golvahna-a touna pipen deiho,
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule meithaiho in bahgama, chule alhema sot tahtah taojia danthu sunho-a konin kihongphauvin; amaho chu themmo chungnung changding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Jesu'n sumdolna bom jona atouvin, mipin sumdolna boma sum alelut chu aven ahile, mihao tamtah-in tamtah aleh lutnun ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin meithai vaichatah khat ahungin, sumsan nongsi pehni aleh lutnin ahi, hichu paisa khattoh kikot ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin seijuite akouvin ajah uva, Tahbeh-a kasei ahi, Hiche meithai vaichanu hin adang jouse sangin sumdolna-a atam lelutpen'e.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ijeh-inem itile adangho jouse chun aneival atou ahin, amanu vang hin aneichasun ahinpi chengse alelut jeng ahi, ati.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Houin'a kona apotdoh-in aseijuite khatnin ajah-a, Houhil, vetan, asongho itobang song hija chule in kisah ho hi itobanga kisalul hitam, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu'n ajah-a, Nangman hiche in loupitah hi namu-em? Hikoma hi song suhchim louva khat chunga khat kisethop himhim umlou helding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pathen Houin jontah Olivet molsanga chun atouvin ahile Peter, Jacob, John, Andrew teho chun atumbeh-in ajah-a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hicheng chu itihle hi dingham? Chule hitiho chu ahung guilhun phat ding chu amelchihna ipi hintem? Neisei peh-un tin adong lhiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jesu'n adonbutnin hitin aseije, Koiman nangho nalheplhah louna dingun kichih theijun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tamtah keima minin hunguntin, Keima Christa kahi tiuvintin, mi tamtah alheplhah dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nanghon gal kisatle kidou thuthang najah tengule, lungdong hih-un; hicheng chu hung soh tei ding ahi; ahivangin achaina hiloulai ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh-inem itile vai khatle vai khat, gam khatle gam khat hung kidouvintin, mun chom mun choma ling hung kihot intin, kel hunglha-a gentheina hung lhung ding ahi; hicheng chu hahsatna kipatna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amavang kichih theijun; ajehchu vaihom upate khutna pehdoh-a nahung umdingu, kikhopna in'a nakivo dingu, chule keima mina vaipoho le lengho anga amaho douna-a hettohsah dinga nahung din dingu ahinalaije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kipana Thupha hi namtin vaipi lah-a hillhanga um masa tei ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nakaijuva napehdoh tengule, ipi iti kasei dingham tin amasangin lungkham hih-un; ahin aphattahle nakipeh chanu chu seibouvun; ijeh inem itile aseija chu nangho hilouvin, Lhagao Theng joh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule asopin asopi, pan acha tha dinga ahinpehdoh ding; chate kipatdoh uva anule apa adoudiu, amaho chu ahin thasah dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keima min jala nangho mi jouse hotna nahung umdingu ahi; ahinla akhon ni geija thoh lhumkeija pangdetpabou chu huhhing-a umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amavang themgao Daniel seibangin, misumang thet umtah chu adinna dol louva adin namu tengule (asim siman hehen), chutengle Judah gama um chengse thinglhang lamah jamuhen:
  </para>
  <para style="p">
    <verse number="15" style="v" />In chunga uma jong hung kumlha hihhen, athilkeo kilah dingin in sunga lut hihhen:
  </para>
  <para style="p">
    <verse number="16" style="v" />Loujaova uma jong apon kilah dingin kilekit dahen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin ohe, hiche lai chule agaija le naonoi chepsahho ada nadinguve!
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule najam nadingu phat chu phalbi ahi louna dingin taovun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuche nikho chu hesoh gentheina nikho hi ding ahi, chutobanga hesohna nasatah chu Pathen'in lei asema patnin tu geijin aumkha hihlaije, chule um jong umlou ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Pakaiyin chuche nikho chu asuhchom lou hileh, mihem himhim asohcha umlou ding ahi; ahivangin alhendohsa alhen chomte jala anikho chu asuhchom ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutengle najah uva khattouvin, Ven, hikomah Christa aume, atia; ahiloule, Ven, khukoma aume, atile tahsan hih-un.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ijeh-inem itile Christa lhemho le themgao lhemho hung sohdoh untin, melchihna le mu kidang dang ahin vetsah dingu; ahitheile lhenchomte jeng jong ahinlheplhah dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangho vang kichihtheijun; veuvin, ijakai kahil masah dem nahitaove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahivangin chucheng nikholai, hesoh genthei joule, nisa thimintin, chule lha jong vahta lou ding,
  </para>
  <para style="p">
    <verse number="25" style="v" />vanlaijola konin ahsi ho hung pullhantin, chule van'a hatnaho chengse kihot lingsoh ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutahle vanlaijola Mihem Chapa thunei Chungnung tah le loupitah-a meibola ahung amu dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutah chule aman vantil ho asola, leiset monga pat van mong geija kolkimvel li-a kona alhen chomte alon khom ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Theichang phung hin thulem kihilun; abah adona ajih akilhap tengle nipi anaitai ti naheuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutobang chun nangho jong hicheng chu aguilhun namu tengule, anaitai, kotbul hung geija ahitai, ti heuvin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tahbeh-a kaseipeh nahiuve, Hichengse chu aboncha aguilhun masangse-a, hiche tulai khanga mite hi mang lou ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vanle lei mang ding ahin, keima thu vang mang lou ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahivangin Pa tailou van'a vantilte jong, Chapa jong, koimachan anikhole ani dantah chu ahepoi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chingtheijun, kiging jingin umunlang tao jingun: ijeh inem itile aphat chu itih ahi ding nahepouve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ajehchu mihem Chapa hi mi khat asohte thuneina pedoh, abonchauva atoh ding cheh-u pe-a, chule kotngah kiging jinga umdinga thu apeh nunga, a-in dalha-a migam danga chemanga tobang ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hiche jeh chun kiging jingin umun, ijeh-inem itile inneipu chu itih-a ahung ding nahepouve, nilhah lam ahim, jan khangkim ahim, ahkhonphat ahim, jingkah ahim, ahung ding phat nahepouve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hetman louvin hungjeng tale na-imut petnu hungtoh khante.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangho jah-a kasei hi mi jouse jah-a kasei ahi, Kiging jingin umun, ati.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin nini jou chun kalchuh kut le cholsolou changlhah kut hiding ahin; thempu pipuiho le danthu sunhon iti doha-a bola matna, chule tha dingham tin ahol aholun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin amahon, Kut kiman sung hidahen, achutiloule mipi lah-a thunoh umget inte, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Bethany'a Simon miphahpa in'a aman ankong aumpetnin, numei khatnin songval bomin nard thao namtui theng mantam tah ahinchoijin, abom chu asukeh-in alua abunglhan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin alah uva akimkhat chu alungphamo uvin, Ibola thao hitia amoh suhmang jeng hitam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile hiche thao hi kijoh henlang hile dangka jale somnga kikhong dinga, chutile asum chu mivaicha gentheiho peh thei ahi, atiuvin; chule numeinu chu aphoh taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin Jesu'n amaho jah-a, Amanu chu limsah hih-un; amanu chu ibola nasuh lunggim uham? Amanu hin keima dinga thil phatah abol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh-inem itile mivaicha gentheite nakom uva aum jingnauve, nagotlai chanua nanghon nahu thei dingu ahi; keima vang nangho koma umjing ding kahipoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanu hin aboltheichan abol ahi; kalong hi vuidinga chu eihung nu masah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin keiman nangho tahbeh-a kaseipeh nahiuve, Vannoi leiset gam pumpi-a Kipana Thupha kihil lhangna chana, hiche numeinu thilbol jong hi amanu het jingna-a kiseipeh dinga ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Judas Iscariot, somleni lah-a mi khat chun, Jesu chu amaho amatsah theinan thempu pipuiho henga agachen ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon hichu ajah phatnun akipah-un, ama chu sumpeh dingin ateptaovin ahi. Chuin aman Ama chu pehdoh-a matsah theina agomkom aholtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule cholsolou changlhah kut kipatni, kalchuh kut kelngoi atha niuvin, aseijuiten ajah-a, Kalchuh kut naneh theina dinga hoikoma gagoleu veng nalungham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Aman aseijuite mi ni asolin, ajah lhona, Khopi sunga khun che lut lhonin, chule twibel pu-a mi khat nato lhon ding ahin; ama chu jui lhonin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule alutna in'a inneipa jah-a chun, Houhilin, kaseijuite toh kalchuh kut kanehna ding kajin indan chu hoilaiham? ati, gati lhonin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule amatah-in indan chungnung lentah gotsademle phasadem khat navetsah lhon ding ahi; hikoma chun ineh dingun anago lhontan, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin seijui teni chu akipatdoh lhonin, khopi sunga alut lhonin, ajahlhona aseibang bang chun agatoh lhonin: kalchuh kut chu agago lhontan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin nilhah ahi phatnin somleni ho chutoh ahungtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin atou uva an aneh laitah-un, Jesu'n ajah uva, Tahbeh-a kasei ahi, Nalah uva kaneh khompi mikhat hin eipehdoh-a eimatsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin alungkham pantaovin, khat khatnin, Kei kahim? tin aban banin adong taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Aman amaho chu adonbutnin, Lhenga kasokhompi, Somleni lah-a mi khat ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihem Chapa achonchan ding thu kisun bangtah-a chu cheding mong ahi; ahivangin Mihem Chapa pedoh-a matsah dingpa chu ohe, adana-e! Ama chu apena peng lou hile ama dinga phajo ding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin an aneh laitah-un, Jesu'n changlhah alan, phatthei aboh jouvin ahehbal balin amaho chu apen, ajah uva, Kilah-un, neuvin; hiche hi katahsa ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin khon alan athangvah jouvin amaho chu apen, chutichun abonchauvin adon sohkei taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Aman ajah uva, Hiche hi mi tamtah dinga kisodoh kitepna thah kathisan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tahbeh-a kaseipeh nahiuve, Keiman Pathen lenggam sunga athah kadon ni ahung lhun kahse-a, lengpiga twi hi kadon lou ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amahon la asah jouvun, apotdoh-un Olivet molsang lama ache taovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Jesu'n ajah uva, Nangho nabon chaova tujana keima jeh-a lungthoi sohkei ding nahiuve: ijeh-inem itile, Keiman kelngoi chingpa kavoh lhuh ding ahi, chutengle akelngoite chu jamcheh gamding ahi, tin akisune.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin kathodoh nungle Galilee gam lama namasang sang uva kache ding ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahin Peter'in ajah-a, Abonchauvin lungthoi jongleu, keivang lungthoi pong kate, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Jesu'n ajah-a, Tahbeh-a kaseipeh nahi, Nangman tuni, tujan mama-a hi ahchal nivei akhon kah-a thumvei neiseilep ding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Peter vang chun, Nangma toh thitha tei ding mong hijongleng, keiman nangma seilep hihhel ing kate, atichang melin ahi. Chule adangho jouse jongchun achuti sei cheh-un ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Getsemane atiu mun'a chun ahungun, chuin Aman aseijuite jah-a, Keima katao sungsen nangho hikoma hin anatou jingun, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Peter le Jacob, chule John hicheng chu apuijin, chuin alung hesoh behseh jengin, halung hemin alunghem pantan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin amaho jah-a, Thina khophelin kalung ahesoh behseh jengtai: hikoma hin umunlang kiging jingun, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin amasang lama phabep khat achechonin, tolah akhupbon alhun, ahitheile hiche phat chu ama-a kona akitolmang theina dingin ataovin,
  </para>
  <para style="p">
    <verse number="36" style="v" />Abba, ka Pa, nangma dinga ijakai hithei sohkei ahi; hiche khon hi kakoma konin chon mangin: ahivangin keima thu hilouvin, nangma thu thu hijohen, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin ahungleh khatteho chu a-imut lhuh-u ahungtoh-in, Peter jah-a, Simon, na-imut hitam? Nidan khat jeng jong kiginga um jou lou nahim?
  </para>
  <para style="p">
    <verse number="38" style="v" />Lhepna-a nalhah louna dingun kigingun, taovun. Lhagao vangin ago tahbeh nan, ahin tahsa hi alhasamin ahi, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin achemang kitnin, ataovin, aseingai bangman aseijin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin ahung kitnin ahile, amaho chu ana-imutlhuh-u ahungtoh kitnin, a-imutso behseh jeh-un, adonbutje ahe tapouve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin thumvei channa-a ahungin, ajah uva, Tun imuvinlang kitha ol taovin: aphasettai, phat alhingtai; Veuvin, Mihem Chapa hi michonse te khutna kipedoh ahitai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kipat un, chetao hite; veuvin, eipedohpa ahung naitai, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin hichu aseina laijin, somleni lah-a Judas chu thempu pipuiho, danthu sunho, chule upate koma kona chemjamle moltum toh hintho-a hungkonho mihonpi chutoh ahung kilhonin ahung paitan ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ama pedoh-a pangpa chun melchihna ahilmasan, Kachop penpen chu ama ahi; man unlang kitup keichan puimang taovin, ati ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin ahung lhun lhunin, ama ajonpai jenin, Rabbi, Rabbi, atin, achop tan ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin amahon akhut alhaovin amantaovin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hichun akoma dingho khatnin achemjam asatdoh-in, thempu chungnung sohpa asatjengle, abilkol langkhat asatlhan ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin Jesu'n adonbutnin ajah uva, Gucha michom man dinga kon banga chemjamle moltum tho-a keima man dinga nahung kon uham?
  </para>
  <para style="p">
    <verse number="49" style="v" />Niseh-in houin'ah i-um khomun thu kahiljin, chulaijinla neimanpouvin ahi: amavang Pathen lekhabua thu guilhun na-a hiti ahi, ati.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chutah chun aloi chengsen ama adalhauvin, ajamgam taovin ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Gollhang khat vangin asagoh keo chunga chu tupatpon akisila ama chu ajui ahin; khangdongho chun amanun ahile;
  </para>
  <para style="p">
    <verse number="52" style="v" />Aman aponsil chu adalhan, asagoh keovin amaho-a konin ajam mangtai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin Jesu chu thempu chungnung hengah akaijun; chule ama chutoh thempu pipui chengsele, vaipo upaho, chule danthu sunho ahung kikhomun ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Peter'in galkanga ajuipeh-in, thempu chungnung inpi leitol sungnung geijin ajui lutpeh-in, chuachun sottolho lah-a atouvin mei a-oijin ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin thempu pipuiho leh houvaipoloi chengsen Jesu chu tha theina ding achungah ahehsetnan hettohsah aholun; amu joupouvin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ajehchu mi tamtah-in jouthun ahehseuvin, ahivangin aseiju akitoh pon ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin mi phabep khat akipat doh-un, jouthun ahehseuvin,
  </para>
  <para style="p">
    <verse number="58" style="v" />Ama hin hiche khutna kisa houin theng hi suseng ting, nithum sungin khutna sahlou achomkhat kasahdoh kitding ahi, ati kajaove, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Ahivangin hiche ahehset naova jongchun akitoh kit pouvin ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Chuphatnin thempu chungnung chu alah uva adingdoh-in, Jesu chu adongin, Nadonbut lou dingham? Hitehon nahehsetna-a thu aseiju hi ipiham? ati.
  </para>
  <para style="p">
    <verse number="61" style="v" />Ahivangin Aman donbut louhelin thipbeh-in aumin ahi. Thempu chungnung chun adong kitnin, ajah-a, Nangma Nunnom Chapa, Christa chu nahim? ati.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chuin Jesu'n, Kahi: chule nanghon Mihem Chapa hi Thilbolthei jet lama atou le van meilah-a ahung namu dingu ahinalaije, ati.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chuphatnin thempu chungnung chun apon abot eh-in, Thu hettohsah dang iding iti tah dinguham?
  </para>
  <para style="p">
    <verse number="64" style="v" />Pathen ataitomna chu najataovin ahi; nanghon iti nagel uvem? ati. Chuphatnin abonchauvin athina theijin athemosah taovin ahi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chuin abangin achil aset khumun, chule amai atomun, achumun, ajah-a, Gaovinlang seijin, atiuvin; chule sottolleho chun akhut phanguva angeiphe abengun ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chuin Peter noilama leitola aum petnin, thempu chungnung sohnuho khat ahungin;
  </para>
  <para style="p">
    <verse number="67" style="v" />Peter'in mei ana-oi chu amuphatnin, amanu chun aven, ajah-a, Nang jong Nazareth Jesu toh kiloi nahi, ati.
  </para>
  <para style="p">
    <verse number="68" style="v" />Ahinla aman aseilepmin, Kahepoi, chule ipi nasei ahijong kahepoi, atitai. Chuin tol maijah apotdoh-in ahile ahchal akhongtai.
  </para>
  <para style="p">
    <verse number="69" style="v" />Chuin soh numei khatnin amun, akoma dingho jah-a chun, Hichepa hi amaho lah-a khat ahi, ati kittan ahi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Aniveina in aseilep kittan ahi. Chujou phabepin akoma dingho chun Peter jah-a, Amaho lah-a khat mong mong nahi; ijeh-inem itile nangma Galilee mi nahi hi nathuseijin aphongdoh-e, atiuve.
  </para>
  <para style="p">
    <verse number="71" style="v" />Ahivangin aman kigaosap le kihahsel athon, Keiman naseipao chu kahephapoi, atitai.
  </para>
  <para style="p">
    <verse number="72" style="v" />Chupettah chun aniveina-in ahchal akhongpaitan ahi. Chuphatnin, Jesu'n ahchal nivei akhon kah-a thumvei neiseilep ding ahi, atia ajah-a asei chu Peter'in ageldoh-in ahi. Chuin hichu ageldoh phatnin, akaptai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jingkah ahiphatnin thempu pipuiho, vaipo upaho, danthu sunho, chule houvaipoloi chengse akihoutoh paijun, Jesu chu akanun, akaijun Pilate khutna apedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pilate'in, Nangma Juda te Lengpa nahim? tin adongin ahi. Chuin Aman adonbutnin ajah-a, Naseikhai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin thempu pipuihon thu tamtah-in ahehseuvin; ahin aman imachan adonbutpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pilate'in adong kitnin, Nadonbut lou dingham? Ve tang, hijatna naheh-u hi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin Jesu'n adonbut hihhelin ahile Pilate'in adatmo lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun Kut sunga chu amahon athum penpen chu sohchang khat alhadohji angai ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin mi khat amin Barabbas atiu, khosung chohnoh hotoh kihen khom, khosung achonohna lamuva tol atha khah ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichun achonna ngaibang uva abolpehna dingun mipi chun hatah-in asamun angeh pantaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pilate'in adonbutnin, ajah uva, Juda te lengpa hi lhadohpehleng nalungu ham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama chun thempu pipuihon thangset suma apehdoh-u ahi ti chu ahet ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin thempu pipuihon Barabbas chu alhadoh pehna dingu joh-in mipi chu atilseuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pilate'in ajah uva, Achutile Juda te Lengpa ahi natipao hi i-kalo dingba hitam? tin adong kittan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amahon, Thingpel'a khenbeh-in, tin asam kit taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pilate'in ajah uva, Ibolinem? Ipi suhset aneijam? ati. Ahin amahon, Thingpel'a khenbeh tan, tin hasaptah-in asamuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuphatnin Pilate'in mipi lunglhaina ding chu angaiton, Barabbas alhadohpeh-in, Jesu chu ajep jouvin thingpel'a khetbeh dingin apedohtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin sepaihon ama chu Pretorium atiu inpi sunga chun apuilutnun, sepaiho jouse akoukhom sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jesu chu ponsandup asilpeh-un, ling lukhuh aphanun, alu-a chun akhuhpeh-un ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin, Vo Juda te Lengpa, tin chibai aboh pantaovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amaho chun peng tenggolin alu avo avovin, chule chil asetkhumun, chule adilsuvin chibai aboh-un ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu totnopna-a a-el ela abol jouvun, ponsandup chu ahoh lha uvin ama pon asilpeh-un, thingpel'a khetbeh dingin apuimang taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon kholjin hiche mun hinjotpa Cyrene gam mi Alexander le Rufus pa Simon chu acham louvin athingpel puding chun amanun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun Golgotha atiu mun'a chun apuitaove, hichu lugu mun tina ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin myrrh toh kihal lengpi theitwi apeuvin, ahinla Ama anom pon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin thingpel'a akhenbeh jouvun, aponsil hochu abonchauva achan cheh nadingun vang aveovin, akihomtaove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu akhetbehnao chu nidan thum don ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Achunga chun ahehnau hetsahna, JUDA TE LENGPA tia kisun aumin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin amatoh thakhatnin gucha michom mi ni, khat ajetlamah, khat aveilamah, thingpelah akhenbeh-un ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichun, Ama michonsehoto akisim thatai, tia Pathen lekhabun asei chu aguilhung tan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin achele, avahle jousen akhasuh khumun, ajah-a, Aha! Nang houin suse-a ni thuma sadohkit,
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangma kihuh hingin lang thingpel'a kon chun hung kumlha tangem, atiuvin a-el elin ahouvun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutobangma chun thempu pipuiho jong chun totnopnan abolun, danthu sunho chutoh, Aman midang ahuhhingjin Ama akihuhhing theipoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kamuva katahsan theina dingun, Israelte Lengpa Christa chu tutah hin thingpel chunga konin hung kumlha temhen, atiuvin ahi. Chule amatoh thingpel'a kikhetbeh tha teni jong chun ama ahouse lhonin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin nidan gup tah-in gam jouse chunga thim ajingin, nidan ko geijin mu athimtan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin nidan koh lhintah-in Jesu hapenin apengin, Eloi, Eloi lama sabachthani? ati. Hichu, ka Pathen, ka Pathen, ibola neidalhah hitam? tina ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule avela dingho lah-a abang bangin chutia ati chu ajauvin, Ngaijun, Elijah akouve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuphatnin mi khat alhaijelin lengpitwi thuh-a twichop phon adelhopmin pengtenggol leh-a atah-in, agah donsah-in, Limsah hih-un; adomlha dinga Elijah hunga hung hih-am veohite, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Jesu chu hapenin apengin, alhagao alhatai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin houin'a pondal len chu achunga pat anoi geijin a-ehlha paijin keh ni akisotan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Ama jona ding sepai jalamkai chun chutia apenna alhagao alha chu amutah-in, Hichepa hi Pathen Chapa tahbeh mong ahi, atitai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chukoma chun galkanga pangin numei hon khatnin jong ave jingun ahi; alah uva chun Magdalene Mariam, Jacob neojo le Joses nu Mariam, chule Salome; hiteho cheng chu aumun ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amaho cheng chu Galilee gama aumlaija ajuija ama jenlea pangho chu ahiuve. Chule numei tamtah Jerusalem'a ahinlhon toupiho jong chu ahiuve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nilhah ahi phatnin, kigot ni ahi jeh-in, hichu cholngahni masang ni ahin,
  </para>
  <para style="p">
    <verse number="43" style="v" />Arimathea kho-a mi Pathen lenggam ngah jinga um, vaipo ginle ja umtah Joseph chu ahungin, ngampelin Pilate henga achelutnin, Jesu long chu agathumtan ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Pilate'in chutia athivah jeng chu adatmo lheh jengin; chuin aman sepai jalamkai chu akouvin, Athina sottam, tin adongin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin sepai jalamkaija kona ahetchen phatnin, along chu Joseph apetai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin tupat ponnem ahin choijin, along chu alalhan, tupat ponnema chun atomin, song kilai lhan sunga chun alupsah-in, chujouvin lhan kotna chun song len khat atanglutnin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule Magdalene Mariam le Joses nu Mariam chun akoinau chu avejing lhonin ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin cholngah ni kichai phatnin Magdalene Mariam, Jacob nu Mariam, chule Salome hicheng chun ahunguva thao anu theina dingun, thao namtui ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin hapta ni masa ni jingpitah-in niso jou jouvin lhan lama chun ahunguvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahole amaho akihouvun, Lhankotna song chu kon eitahdoh peh taovinte? akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla agah vetnule song chu tahdohsa anaum amutaove; asong chu lentah hija ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lhan sunga alutnun ahile gollhang khat ponbangleh choltah kisila jetlam sanga tou amuvin; chuin amaho chu atija lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin ama chun amaho jah-a, Tija hih-un; thingpel'a kithat Nazareth Jesu chu naholu ahi: ama athoudohtai; hikoma aumtapoi: alupna hi hung vetaovin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amavang cheovinlang aseijuite le Peter jah-a gaseijun, Aman najah uva aseibangin Galilee gam lamah namasanguva achei; chukom chu nanghon Ama namu dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichun kidang satah-in akihot hot jengun; gangtah-in ahung potdoh-un, lhanphunga kon chun ajamtaove. Akichat jeh-un, koima jah-a aseipouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin hapta ni masapen ni jingpi-a athodoh jou chun, Magdalene Mariam, asunga kona thilha sagi anodohnu henga chun akilah masapenin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanu chun Jesu umpiji teho, ama thi jeh-a kapkaple kingaisese teho henga chun achen agaseijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin athoudoh-in, amanu chun amui ti ajah vanguvin atahsan pouvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Aman alah uva mi ni gamlam jona achena lhona limchom beh-in akimusah-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amani ache lhonin seijui dangho agahil lhonle, amahonla amani sei jong chu anatahsan dehpouvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin chujou kitman ankong aum laitah-un, somlekhat ho hengtah-a akilah-in; athodoh kit nunga amuho thusei atahsan lou jeh-u chun, atahsan louvule alungtah-u chu asosalin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Aman ajah uva, Nangho vannoi leiset gam jouse-a cheovinlang, thilsem namkim jah-a hiche Kipana Thupha hi gahil lhang leuvin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Atahsana baptize chang chu sohcha ding ahi; atahsan lou vang chu themmo changa umding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule atahsante chu melchihna hicheng hin ajuipeh dingu ahi; keima mina thilha anodoh dingu, paothah paothah-a pao dingu,
  </para>
  <para style="p">
    <verse number="18" style="v" />Gul akhutna adop dingu; thina thei ima donjong leu ima ti lou dingu; chule ana damlou chunga akhut angap diu, ana chu dam ding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakai Jesu'n ajah uva chucheng asei jouvin, van'ah lahtouvin aumin, Pathen jet lamah atoutai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amaho achedoh-un, muntin-ah ahillhang leuvin, anatohna chanuvah Pakaiyin akitho piuvin, chule melchihna-in ajuisah-in athu chu aphut detpeh-in ahi. Amen.
  </para>
</usx>
