<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="COL" style="id">Colossia</book>
  <para style="h">Colossia</para>
  <para style="toc1">Colossia</para>
  <para style="toc2">Colossia</para>
  <para style="mt">Colossia</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen lunggot lama Christa Jesu solchah Paul chule sopi Timothy'n,
  </para>
  <para style="p">
    <verse number="2" style="v" />Colossia'a um mithengte le Christa-a sopi ginchat tahho hengah, i-Pau Pathen le I-Pakaiyu Jesu Christa-a konin nachung uva lungset le chamna umhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keihon I-Pakaiyu Jesu Christa Pa Pathen chu kathangvah-un, a-imatih chanin nangho dingin katao jingjiuve,
  </para>
  <para style="p">
    <verse number="4" style="v" />Christa Jesu'a natahsanu chule mithengho jouse ngailutna naneiju thu chu kajauvin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Masanga kipana Thupha thutah-a kona najahsao, nangho dinga van ho-a kinepna koisa ahi jeh-a;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche kipana thupha chu najah niuva pat le Pathen milungsetna chu thutah-a nahet niuva pat, vannoi leiset pumpi kom alhuna ga asodoh banga, nangho-a kom jong hung lhunga ga asohdoh ahitai:
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche thutah chu kasahtah-u, kasohchan khompiu Epaphras'in nahilsao ahitan; ama hi nangho dinga Christa lhacha tahsan umtah ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama mama hin lhagaova ngailutna naneijeu chu keiho henga aphondoh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche jeh-a hi thu kajah pat niuva patna chu keiho jong nangho dinga taopeh le thumpeh tang louhel kahiuve; chutia chu nangho chihna le lhagao lam hetna tinchenga ama lunggot lam hetna-a nadim uva;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hichea chu Pakaiya dinga kiloma imalam jouse-a dei um lama nachon uva, thilpha bolna tintanga naga uva, chule Pathen hetna lama nakhantou uva;
  </para>
  <para style="p">
    <verse number="11" style="v" />Kipah thanoma thohhat le lungdehat phong dinga, aloupi athahat dungjuija nahatdohna dingun;
  </para>
  <para style="p">
    <verse number="12" style="v" />Vah-a cheng mithengte chan, chan khompia loma eiho eisemuva Pa chu thangvah jingun:
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama chun muthim thahat thunei na-a kona eihuhdoh uva, Achapa ngailut gam mi eisou ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama-a chu eihon athisan vanga kilhatdohna ineijuva, chonset ngaidamna jeng jong ineiju ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama chu mutheilou Pathen lima um ahin, thilsem jouse lah-a apeng masapen ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu ama-a chu thil jouse kisema ahi, van chunga hihen, leiset chunga hijongle, muthei hihen mumo hijongle, laltouna hihen, vaihomna gam hihen, piputna hihen, thahat thuneina hijongle: thil jouse ama sem ahin, ama-a dinga kisema ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule ama thil jouse masanga anaum jingsapeh ahi, chule ama-a chu thil jouse umsoh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama chu tahsa (hichu houbung) luchang ahi; ama chu abul ahin, imalam jouse-a chungnung pen ahina dinga, athiho lah-a apeng masapen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ijeh ham itile ama-a chu chamkimna tincheng aum ding chu Pa lunglam ahi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule athingpel thisana chu chamna asema, ama vanga leija um thil jouse hihen, van'a um thil jouse hijongle, amatah-in amatoh suhchama aumsah ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangho, masang nachon gitlounao jeh-a ama-a kona pampaija uma, nalung sungva melma nahiu ahin, hijongle tun,
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama mitmu-a athengle, boh beh louhel, chule nolna beija nadinsah theina dinguva, ama tahsa athi jala nakichampiu ahitai:
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangho tahsanna-a chu najung khouva, naki phudet uva, nanghon najahsao chule vannoi'a thilsemho jouse henga kiseiphong, chule keima Paul alhacha le-a kapana hichea kipana thupha kinepna'a kona hi kichondoh louva naum uva ahileh nadinsah dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tun keiman nangho dinga hesoh genthei kathoh hi kakipapin, chule Christan atahsa, hichu houbung ahin, khohsahna jala ahesoh genthei thoh bangkhai chu kasa-a hin kabulhit jingin:
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathen thu subulhit dinga, nangho-a dinga keima eikipe Pathen gouchin dungjui bangtah-a, chuche lhachale-a chu eikipansah ahi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuche thugil chu akhang akhanga ki-ima thuguh chu ahin, tu-a vang amithengte henga kiphong jala ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chidang namdangho lah-a chuche thuguh gou loupi chu ipiham ti chu Pathen'in amaho henga hetsah nom ahi; hiche gou loupi chu nangho-a um Christa chu ahi, ama chu kinepna loupi ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama thu chu kahilu ahi, mi jouse hi Christa Jesu'a aphat chamkima Pathen anga kadinsah theina dinguva, kachihna jouseuva amitakip kapholeuva ami jouse kahilu ahi:
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutia chu keima-a nasatah-a athilbol thei thahat dungjuija chu, keima jong thohgima hatah-a kiseh kahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ajeh chu nangho le Laodicea umho, chule tahsa-a kamel muloulai ho chengse dinga keima nasatah-a kaki habol hi heleu chun kalung ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutia chu alungu lhep lungmonga aumuva, ngailutna-a akikhi gom theijuva, hetchenna dimset gouva chu ahaodoh theijuva, Pathen thugil, Pa le Christa chu ahetdoh theina dingun;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama-a chu chihnale hetna gou jouse kisela ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche hi koiman seithema nalhep lhah louna dinguva kasei ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tahsa-a nalah uva kaum lou jeng vangin lhagaovin kaume, kipahtah-in nachondih jeule Christa-a natahsan detjeu kamu jinge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti ahi jeh chun nanghon Christa Jesu, Pakai chu, nalah bangu chun, ama jengah chonun;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama-a chun jungkhovin chule kisadoh-un, chule natahsan naova chun kiphut doh-un, nakihilu bang chun, hichea chun thangvahna dimin umun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chingtheijun, achuti louva ahile khat touvin Christa thua tobang hilouvin, mihem thugouchin le vannoi leiset lekhajem bul ho-a kon chihgut lekha themna le doha lhahna moh thua nasuse getnunte.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu Ama-a chu Pathen hina jouse chamkimna tahsa-a banga cheng ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangho hichea chu kisuchamkima nahiuve, ama chu piputle thuneina jouse luchang ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama-a chu nangho khutna cheptan hilouva cheptan nahiu ahi, tahsaphe chonset naho tahsa chu ponsil pailhah banga kipai lha-a, Christa-a cheptan nahiu ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na baptize chanuva chu amatoh lhana kivuitha-a nahitaove, chuche baptize chan vang mama-a chu athi lah-a kona ama kaithouva Pathen thilbol tahsan vanga amatoh kaithoutha-a um nahitaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule suhkhelna leh tahsa-a cheptan louva thia nangho chu, Pathen'in nathemmonao jouse angaidama, thakhat tah-a ama chutoh nahinsah thau ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule eidoudal uva ichunguva batna lekhasut danthua kisun chu anoimanga, athingpela thingkila akhetbehtha-a asuhbei ahitai;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule piputna le thu neina jouse alelhah-a, hichengse chu ajoa, amaho chengse chu kilangtah-a avetsah ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuti ahi jeh chun anneh thua ahim, don thua ahim, kut nikho thua ahim, lhathah nikho thua ahim, chule cholngah ni thua ahimin, koiman nangho na-oimo daohen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitiho jouse chu khonunga hunglhung ding thudol lim ahibouve: ahin tahsa chu Christa-a ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nasan dingu tohphat man chu chonnemna lhem le vantil ho hou, athil mulou houva chengdena, atahsa lungu ahomkeova kimoh choisang,
  </para>
  <para style="p">
    <verse number="19" style="v" />Atahsa pumpi kivah khangna, agu kisuhto na-a kikilmat tona, Pathen khansah-a akhana aluchang chu atuhdet louva mihem koimacha chom mangsah hihhelun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu vannoi leiset lekhajembula kona chu Christa toh thitha nahitah uva ahile, leiset hinna-a hingnalai banga ibola danthu noija lutna,
  </para>
  <para style="p">
    <verse number="21" style="v" />(Tham hih-in, tep hih-in, tongkha hih-in tiho;
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichengse chu imanchah laija mangthah jeng ahi;) mihem thuhil hole thupeh noija um nalai nahiuvem?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche thilho hin lungchama hou, chonnemna, chule tahsa khoto louna thilbola chihna aneijin; ahinla tahsa ngaichat kitimna lama imacha phatchomna aneipoi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun nangho Christa toh kaithoutha-a um nahiule, Pathen jet lama tou jinga Christa umna chung lam thu jengbou chu ha holun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leiset thu geldaovin, chung lam thu jengbou gelun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho athisa nahiu ahin, nahinnao chu Christa toh Pathen'a kisela ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ihinnao Christa ahung kilah tengle, amatoh thakhat tah-a nangho jong loupitah-a kilangdoh ding nahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun nanghon leiset chunga natibah chengseu: jon, thenlou, huh, gitlou lungtup, papset, hichu milim hou ahin, hicheng chu thisah gamun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hicheng jeh chun thua nunglou chate chunga Pathen lungsat achujin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Masanga nangho chuchenga nahin laijuva chu, nangho jong chutihoa chu anachonjia nahiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin tun lungsat, lunghan, mitthip, houset, taitom, kam sunga kona thujahmo sei, hicheng jong chu paimangun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khatle khat thujouvin kihou hih-un; ajeh chu nanghon hicheng chu anatoh puma mi lui chu ponse lelhah banga nalelhahsao ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nasempao lim banga hetna-a kona kisemthah mithah chu nakivonu ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichea chu Greek mi le Juda mi, cheptan le cheptanlou, paomah hammah, Scythia mi, soh le ongthol umlouva ahitai; Christa chu ijakaija ijakai ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche jeh chun Pathen lhenchom mithengte le deitahte bangtah-in, khotona, hepina, kineosah, nunnem na, thohhat, hicheng chun kivonun;
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho khatle khat kidemdaito cheh-un; khatnin khat chunga themosahna ding thu naneijule kingaidam touvin; Christan nangho nangaidam bangu chun nanghon jong ngaidamun;
  </para>
  <para style="p">
    <verse number="14" style="v" />Hicheng jouse chunga chun ngailutna kivonun; hichu kikankhomna chamkimpen ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Pathen lungmonna chu nalunguva vaihom hen; hiche dinga chu nangho tipum khatna kikou nahiuve; chule thangvahna dimin um jingun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chihna jouse-a Christa thu chu nasunguva cheng dimset jinghen; tumgingtoh tho lan, hou lan, chule lhagao lan khatle khat kihilun kitilkhou touvin, lungsetna thua nalung gilun Pakai choiatnan la saovin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule thu lam ahin, natoh lam ahin, nabol chanu Pakai Jesu minin bolun; chule ama vangin Pa le Pathen thangvah jingin umun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Numei ho, Pakaiya lomtah-in napasal teo thunoija umun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pasal ho, na-inneipiteu ngailuvin, chule nunbol hih-un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chateho, nangho imalam jouse-a nulepa thun nungun; hichu Pakai lunglam ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pateho, nanghon nachate chengu phin lunghang hih-un, ajole lunglhah nan neiget unte.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sohteho, nangho mitvet soh banga mihem lunglhaina hilouvin, lung thengsel le Pathen ging pumin, tahsa lam thudol ijakaija napakai te chengu thun nungun:
  </para>
  <para style="p">
    <verse number="23" style="v" />nabol chanu chu mihem dinga bol tobang hilouvin, Pakai dinga bol bangin lung gilin tah-in bolun;
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakaiya kona goulona thilpeh nachan dingu chu heuvin; ajehchu Pakai natong nahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amavang koi hijongle thil dihlou bola chun athilbol dihlou man chu asan ding ahi: hichea hin maiphavet na aumpoi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai teho, nanghon jong van'a Pakai khat naneiju chu heuvin lang, nasohteu dihkeicha le hoikeichan bolun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho taona-a pangdet jom jingin, thangvah toh thon kiging jingin umun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chujongle ajeh-a henna kaumna Christa thugil hi kaseiphong theina diuva Pathen'in kot eihonpeh nadingun keiho dingin jong neitaokop jingun;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutile kaseiding bangtah-a kaphonjal thei ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule phat kijenpet chu kichoh unlang, polama um miho lama chun chingtheijin chonun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule mijouse chu iti donbut ding ahi chu nahet theina dingun, nakihounao chu lungset thu beh jinghen, chi altoh bang jinghen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiya sopi deitah chule lhacha tahsan umtah le kasoh hikhompi Tychicus hin kaumchan jouse nangho hetsah naovin nate:
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaumchan thu nahetna dinguva, chule ama hin nalungu amonsah theina dinga, hichena dinga chu ama hi naheng uva kahinsol ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangho lah-a khat, tahsan umtah le sopi deitah Onesimus toh kahin solthan ahi. Amanin hikom thu umchan ijakai nahetsah naovinte.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kasoh chanpi Aristarchus'in salam napeuve, chule Barnabas tupa Mark jongin salam napeuve, (ama chungchang thua thupeh namutaovin; ama naheng uva ahunga ahile analemun;)
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Justus kiti Jesu'n jong salam napeuve, amaho hi cheptanho lah-a kon ahiuve. Hiteho bouhi Pathen gam chalna dinga kakithopi ahiuve; kalung monna amaho hi ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangho lah-a khat Christa soh Epaphras'in salam napeuve; nangho Pathen lunglam jouse-a bukimle tahsan kichenna napandet theina dinguva, ama nangho dinga taona-a ponpan tah ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu nangho dingle Laodicea chule Hierapolis'a umho dinga ama hi gunchu lheh jeng ahi, ama thudol kahettohsahna hichu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Louthem deitah Luke le Demas'in jong salam napeuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Laodicea um sopiteho, chule Nymphas le a-in'a kikhom houbung chu salam anapeuvin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangho koma hiche lekha nasimjou tengule, Laodicea-a um houbung jong anasim sah-un; chutobang chun nanghon jong Laodicea'a kona lekha jong chu anasimun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Archippus jah-a, Nangman Pakaiya namu lhacha natoh chu namolsona dingin chingtheijin, tin ana seijun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kasalam bohna hiche lekha hi keima Paul'in kakhut tah-a kasut ahi. Nanghon kabulput hi geldoh jingun. Lungsetna-in na-umpiu hen. Amen.
  </para>
</usx>
