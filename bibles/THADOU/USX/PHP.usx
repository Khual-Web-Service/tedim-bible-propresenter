<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PHP" style="id">PHILIPPIANS</book>
  <para style="h">PHILIPPIANS</para>
  <para style="toc1">PHILIPPIANS</para>
  <para style="toc2">PHILIPPIANS</para>
  <para style="mt">PHILIPPIANS</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu Christa sohteni Paul le Timothy'in Philippi'a um Christa Jesu'a mithengte jouse hengle aumpiu houvaipole lhachaho henga;
  </para>
  <para style="p">
    <verse number="2" style="v" />I-Pau Pathen le Pakai Jesu Christa-a konin lungsetle lungmon naheng uva umhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho kageldoh chanin a-imatih chanin Pathen kathangvah jingin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kataona jouse-a nangho nabon chaova dingin kipahtah-in kataojin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amasapen nikho-a patna tuni geija Kipana Thupha-a neikiloi khompi jeh-un;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho sunga thilpha pandoh-a ama chun Christa nikho ni geija abol molso ding ahi ti dettah-in kagingchai;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho nabon chaova thudola keiman lung kahiti gel hi adih lam ahi; ajeh chu nangho kalung sunga kavop jing nahiuve; hiche jeh-a chu keima bulput thudola chule Kipana Thupha lama pana kihonna thuseile phudetna lam thudola, nangho nabon chaova keimatoh lungsetna kachan khompi nahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Jesu Christa milungset na-a chu nangho nabon chaova iti kangaiju hitam ti eihettoh peh-a Pathen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keima hichena ding hin kataoji, nami ngailutnao chu hetna le gelkhen themna adima akhantou cheh akhantou cheh-a;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutia chu nanghon thil aphatah chu naphottoh theijuva; lung kitah-a chule suhkhel beihela Christa nikho ni geija naum uva;
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen loupina le vahchoina dinga Jesu Christa-a kona umdoh chonphat ga chu nadimsetna dingun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sopiteho, nanghon hiche thuhi heleu chun kalung ahi, keima chunga thu soh chengse hi Kipana Thupha chalna dingjoh-a hung soh ahi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Kabulput hi leng in jouse le mundang jouse-a Christa jala ahi ti chu akiphongtan ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule sopite atamjon kabulput amuvin Pakai tahsan dettah-in, kicha louhelin thu asei angamui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Atabbeh-in abangin mitthipna le kinelnan Christa chu aseiphong leuvin, chule abangin lungngeijin aseiphong leuvin ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Loikhat chun kabulput chunga hi bolgentheija kaumna ding ngaitonan, lungdihtah pu-a hilouvin, chonoh nadingin aseiphong leuvin:
  </para>
  <para style="p">
    <verse number="17" style="v" />Adangho vang chun keima hi Kipana Thupha honna-a kitung kahi hi aheuvin, ngailutna neijah abolun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Achutia itiam? Phatlhemin hihen, thutah-in hijongle, itihen iti jongle Christa chu kiseiphonga ahi: chule hichea hin kakipah-e, henge, kakipa ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu hiche hi nangho taona le Jesu Christa Lhagao thilpeh vanga huhhing-a kaumna hung hi ding ahi ti kahei;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutengle kalung tuple kakinepna dungjuija hi imacha-a kajachat louding ahi; ahinla a-imatih chana hakat tah-a kaum jingji banga chu tu-a jong kati chunga hi thina hihen hinna hileh, Christa chu choisanga umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu keima dingin hin chu Christa ahin chule thi chu hamphatna ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla tahsa-a hin hi keima ding tohga sona ahivangle, lhen dingjoh kahepoi:
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin ni kah-a lunggima uma kahi; kipatdoh-a Christa toh umkhom chu kalung ahi; ijeh-inem itile hichu gamchenga pha chungnungjo ahi:
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla tahsa-a um chu nangho dinga khohjo cheh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nakhantouna dingule tahsan na-a nakipana dinguva kaum nalaiding, nabon chaova kaumpi ding nahiuve ti ginchat hi kaneije;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutia chu nangho henga keima hung kit vanga keima-a dinga Christa Jesu'a nakipanao chu adimsetna dingin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nanun nakhannu, nakhosah danu chu Christa Kipana Thupha toh kitoh pou pouhen; chutichun keima hungin hung mu jongleng, ahiloule umhih jeng jongleng, na-umchanu lhagao khattah-a nadindet jinguva, lung khattah-a Kipana Thupha ginchatna lama kisehtena na-umu thu chu janange.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule nadouteu chu imachan kisuh lung linglausah hih-un; hichu amaho dinga manthah na photchena ahi; ahin nangho ding vangin Pathen'a kona huhhing-a umna ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajeh chu Christa-a tahsan jenga hilouva, ama dinga hesoh gentheisan thoh dinga jong, nangho lungsetna thilpeh kipe-a nahitaove.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nanghon masanga kagalsatje dan chu namusao ahin, tun jong najaove, nangho-a jong chutobang chu uma ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun Christa-a kitilkhou na auma, lungmonsah thei ngailutna auma, Lhagao pankhompina auma, lungnema lungsetna le khoto lainatpina auma ahile,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kakipana hi subukimun, chutichun Lungthim kithakhat, ngailut kithakhat hiuvinlang, thukhat kisaovin, lungkhat hiuvin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Kilung douna le kiloupisah na-a kona imacha bol louvin, lungnem heochan khatnin adang chu ama sanga phajoa gel cheh hiuvin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Amitakipmin nangma nangma-a cheh ding jenga thil ve louvin, adangho ding jong veuvin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Christa Jesu'a uma hiche lungput chu nangho sunga jong neijun;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama chu Pathen lima uma ahin, Pathen toh kikottena aum chu, kikolchah jing jeng lung angaitopoi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin ama akisunem min, soh limin aumin, mihem bangin akisemtan ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule alimso amelput umchan mihem'a bang bangin aumin, ama le ama akineosah-in, thina gei, thingpel'a thina geisanin thun anunge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh-a chu Pathen'in sangtah-a achoisanga, chule min jouse sanga min chungnung chu apeh ahitai:
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitia chu Jesu mina mijouse van'a cheng hihen, leisetna cheng hihen, leinoi'a cheng hijongle, akhup uva dilsu uva;
  </para>
  <para style="p">
    <verse number="11" style="v" />Pa Pathen loupina dinga lei jousen Jesu Christa chu Pakai ahi ti aphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun kangaitah te, nanghon sei nangai jing bangu chun, keima um petna bang hilouvin, tu keima umlou pet hin kicha le kithing thingin huhhing-a na-umnao chu tongdoh-un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu alung deilam tupna dingle tohdoh nadinga nasunguva natonga chu Pathen ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Phunchel louhel le kinel baotam louhelin imajouse bolun;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutia chu nolna beile suhsetbei Pathen chate nahidoh theijuva, khang lamvaile vahkoiho lah-a nolna beihela naum uva, vannoi'a alah uva meivah banga kilang nahina dingun,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinna thu chu dom sangun; chutia chu moh lhaija kahilou, moh tohgim jong kahilou chu Christa nikho nileh kisonna kanei theina dingin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahi, na ganlhaina chungu le natahsan pehdohna uva chun todoh-in um jongleng kipah ding kahi; chule nangho jouse toh kakipa ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule chutima chun nangho kipah-un, keima jong neikipa piuvin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangho umchan kahettoh-a keima jong kalungmon nadinga chomkhat joule Timothy naheng uva hinsol dinghi Pakai Jesu'a kakinepna ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu keima tobanga lungtheng sela nangho khankho ding gel ama tobang koima aumpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ijeh inem itile mijousen Jesu Christa-a ding hol louvin, amaho deilam cheh aholun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin nanghon ama chu kipatepma aphat kiphochen ahi chu naheuve, hichu chapan apa atohhu banga ama hi keimatoh kitho-a Kipana Thupha jala natong ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuti ahi jeh chun ikati akihet phat phatle ama hi hinsol leng tin kakineme;
  </para>
  <para style="p">
    <verse number="24" style="v" />Keima jeng jong chomkhat joule hunginge ti hi Pakaiya katahsan lheh jenge.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin kangaichat koma eijenlea pang nangho thupole, kasopi, kanatoh na-a kakithopi, kasepai chanpi Epaphroditus, ama hi naheng uva hinsol khoh kasatai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman jong nangho nabon chaova mu alunggot lheh jeng ahi; nanghon ama anai ti thu najah-u chu alunghimo lheh jenge.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule tahtah-a na-a thita vang ahi: ahivangin Pathen'in alungsetnin; ama chang jeng hilouva keima jong eilungset ahi; achuti loule keiman kagenthei hesohna chunga genthei hesoh kathoh ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh-a chu nanghon ama namu kitnuva nakipa theina dingu le, kalung hesoh jong alhomdomna dinga ama hi kahinsol loi jeng ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijeh chun kipana kimkeijin Pakaiyah analemun, chule hitobang mi hi jabolun;
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajeh chu keima neijenlenao lhinglou bangkhai chu subulhit dinga ama habola kibola, Christa natohna-a ahinkho jengjong khohsa louva thidehchet ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Achaina keijin, kasopite ho, Pakaiyah kipah thanomun. Thu thakhat mama chu hinsut kit ding hi keima kachimpoi; nangho dingin jong aphachome.
  </para>
  <para style="p">
    <verse number="2" style="v" />Uichate holah-a chun chingtheijun, kihongphauvin, achon gilou lah-a chun chingtheijun kihongphauvin, chule kitumsahho lah-a chun chingtheijun kihongphauvin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh iham itile eiho Lhagaova Pathen hou ihiuvin, chule Christa Jesu'a kipah, tahsa lama kingai lou cheptan chu ihiuve;
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima tahsa lama kingai jeng jongleng kingai thei kahi; midang tahsa lama kingai theija akingaitoa ahile chuche sanga chu keima kingai thei cheh ding kahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keima niget ni-a chepkitan, Israel chi, Benjamin phunga mi, Hebrew miho lah-a Hebrew; danthu lama Pharisai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Tomlahna lama houbung bolsele-a; chule danthu dola chonphatna-a themona neilou kahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin phatchomna kanei chengse chu Christa ding lama hakamna-a kangaito ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahi, tah mong mongin ka Pakai Christa Jesu hetna aphat jeh chun abonchan hakam nanbou kagel jing jenge; ama jala chu imajouse hakamna kathoh ahi, chule Christa chu phatchom na-a kanei theina dinga, hichu eh tobanga kagel ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama-a chu keima eikimudoh-a, danthua kona hidoh keima chonphatna chu nei louva, Christa-a tahsan vang, tahsana vanga Pathen'a kon chonphatjoh chu kaneija;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutia chu amale athokitna thilboltheina thahat chu kahet theija, athohgim naho chu kikoppia kahia, chule ama thitoh kithakhat kahidoh theija;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijem tia athia kona thokitna chu kachan khah theina ding kati ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman tu-a hi kanei ahitai, chule achamkima kahitai kati ahipoi; Christa Jesu'n keima eimat bangma chu keiman jong hichu kamat theina dinga hadela kadel ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sopiteho, keiman kamantai tin kakigel hih laije: ahin hiche thilkhat hi kabole, nung lama um thil chengse chu kasumilin, masang lama um thil chu kadelin ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu Christa-a Pathen kouna sang lama hatman sanna dinga abimun chu hadela del kahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti ahi jeh chun eiho apilhingsa chengse hitobang lung chu vop cheh-u hite; chule ijem tia lungchom vop na-umule hi jong chu Pathen'in nangho chungah phongdoh nante.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijongle eihon iphahna chan chengseu hin chonu hite, hiche chu lunga vop jinguhite.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sopiteho, nanghon keima umchan thovin, chule navetkah dinguva um keiho, keiho banga chonho chengse chu veuvin.
  </para>
  <para style="p">
    <verse number="18" style="v" />(Ajehchu mi tamtah achombeh-in achontan ahi: amaho umchan chu najah uva kasei matchetsa ahitai, tu-a jong kap pumpuma kaseipeh nahiuve, amaho chu Christa thingpel douva ahiuve;
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho chu akichainao manthah ahi, atumpiu chu amaho Pathen ahi, aloupinao chu ajachat naova uma ahi; amaho chun leiset thubou agelui).
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh-inem itile eiho vangam mite ihiuve; chule chua kona chu huhhing-a I-Pakaiyu Jesu Christa chu ahung ding kinema ngah jinga ihiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman athilbol theina-a ijakai athua anunsah thei ahi, hiche dungjuija chu eiho tahsa manmo hi akhela ama tahsa loupitah lima chu aumsah ding ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahi jeh chun kasopi deitahteho le kangaitah teho, kakipana le kalukhuh, sahtahteho, hiti hin Pakaiyah umdet jingun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman Euodias le Suyntyche chu Pakaiya lungkhat hi dingin kajole.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kanam koljon putkhompitah, nangma jong kangeh nahi, nangman hiche numei ho chu anahun; ajeh chu amaho hi Kipana Thupha-a keimatoh kitho-a tonggim ahiuve. Clement le katoh khompi dang danghon jong chutia chu abolu ahi, amaho min chu hinna lekhabua kisuna um ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho Pakaiyah kipah thanom jingun; ti kitleuvinge, Kipah thanom jingun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangho nachonnemu chu mi jouse het hihen. Pakai anaije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Imacha lungkhamna nei hihhelun; ahin imalam jouse-a taonale thumna mangin, thangvah toh thon, nathum jouseu chu Pathen hetsah-un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutengle Pathen lungmonna, hetna jouse khokhel sohkeija chun, nalungu le nalungthimu Christa Jesu'a ahon ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Achaina-in, sopiteho, thutah chacha, ja umdol chacha, adihlam chacha, atheng chacha, dei um chacha, seiphat chacha, phatna nei ima auma chule pachat channa auma ahile, hitiho dol chu lung gelun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon keija kona nakihil uva najopsao, najahsao, namusao chengse chu bolun: chutile lungmonna Pathen chun naumpi jing jeng dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitih chanpi nunga ka phatna ding nangaito nao nahin thahbol kitleuvu hi Pakaiya hapan kakipah lheh jenge; hiche dinga chu nagotsao vang ahinan, ahivangin hiche pet chun agomkom namupouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kalhahsam mana hichu kasei ahipoi, ajehchu keima itobanga iti kaum-em, kaum bang banga lunglhaija umje kakihet ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nemcha umje jong kahen, haotah-a ninglhinga umje jong kahei; imajousele thil jouse-a, vatah-a umle keltah-a umje, ninglhinga umjele lhasama umje thuguh chu kakihetdoh ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Eihat sahpa Christa vanga chu ijakai bol thei kahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahi jeng vangin kagenthei hesohna-a neikithopiu hi nabol pha lheh jengui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangho Philippi'a miho, Thupha hung lhun tila keima Macedonia gama kona kapotdoh lai chun, nangho tailou houbung khatcha jong pehle lah thudola eikithopia aumpoi ti nanghon nahenaove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajeh chu Thessalonica kho-a kaumlai jong chun, kalhah samna khatvei jeng hilouvin kakhohna nagelun eihunan neithot kit leuvun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thilpeh chu kahol ahipoi, aga nangho lama apung ding chu kaholjoh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijakai kaneikime, kahaove; nangho-a kona thil gimnamtui doija kilha-a Pathen lah theidol le lunglhaina chu Epaphroditus khutna kanamun, hiche chun kaning lhingset tan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule ka-Pathen'in loupina-in Christa Jesu'a ahao dungjuijin nangaichat jouseu pekim naovin nate.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tun i-Paule i-Pathen'u chu atonsot atonsot geijin loupi jinghen, Amen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Christa Jesu'a um mithengte chengse kasalam anapeuvin. Kaumpi sopitehon salam napeuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mithengte jouse, ahideh-in Ceasar insung mitehon salam napeuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakai Jesu Christa milungset chun nabonchaovin umpiuvin. Amen.
  </para>
</usx>
