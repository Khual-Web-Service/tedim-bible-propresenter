<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GAL" style="id">Galatia</book>
  <para style="h">Galatia</para>
  <para style="toc1">Galatia</para>
  <para style="toc2">Galatia</para>
  <para style="mt">Galatia</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihem'a kon hilou, mihem vanga jong hilou, Jesu Christa le athi lah-a kona kaithouva Pa Pathen pansah solchah keima Paul,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule kaumpi sopite chengsen Galatia'a um houbung ho hengah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pa Pathen le I-Pakaiyu Jesu Christa-a konin lungset le lungmon nachung uva umhen;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama chu i-Pathen'u le i-Pau lunggot bangtah-in, tulai vannoi phat louva kona hi eiho eihuh dohna dingun, eiho chonset manin ama akipetan ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Loupina chu a-imatih chanin ama-a hijinghen. Amen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tule tu kahseh-a Christa milungsetna-a nakou paova kona thupha chombeh lama nakai jengu chu kidang kasa lheh jenge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichu thupha chomdang jong ahisampoi; ahinla mi phabep khat aumun, amaho chun nangho nasuh boijuva chule Christa Thupha hi akaleh-a hei ding agotnu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin keihon nangho henga kahung seiju Kipana Thupha hilou, akalvala thupha chomdang hung seija aumle, keiho hiuving, van'a hungkon vantil khattou hijeng jongle, ama chu sapset chang hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Masanga kasei banguva kasei kit ahi, nanghon najopsao kipana Thupha chu hilouva, thupha chomdang naheng uva hung seija aumle, ama chu sapset changhen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima tu-a hi mihem jola kahim, Pathen jola kahim? Ole mihem lunglhaisah ding go-a kihabol kahim? Mihem lunglhaina ding holnalai kahile, Christa soh hilou kahi ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuti chu ahin, sopite, keiman kahil Thupha thudol hi kahetsah nahiuve, hiche hi mihem lam dol thu ahipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihem'a kona kamu jong ahipoi, min eihil jong ahipoi, Jesu Christan aphondoh-a kona kamu ahibouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Malaija Juda mite houdan-a kachon laija kanunchan kakhanchan thu chu najakhataove, Pathen houbung chu teptena kalvala bolsea sumang dinga bola kahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule kapu kapate hou lama katompan behseh jeh-a, Juda te hou danthu lama kanam sunga kakhang golpi tamtah kakho khel ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin kanu oisunga kaum laija pat eisepkhena leh amilungsetna-a eikou Pathen'in,
  </para>
  <para style="p">
    <verse number="16" style="v" />Kipana Thupha chidang namdangho lah-a kaphon jal ding adeija, achapa keija phondoh ding agotchun, keiman tahsaphe le thisan kadongpai jengpon,
  </para>
  <para style="p">
    <verse number="17" style="v" />Jerusalem'a keima sanga solchah himasaho henga jong kachepoi; ahin Arabia gama kachen, chuin Damascus'a kahung kile kittan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujou kum thum nungin Jerusalem'a Peter toh kimuto dingin kagache touvin, chule nisom le ninga akomah kaga ume.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin solchah ho lah-a khatcha kamupoi, Pakai naopa Jacob bou kamui.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thu hicheng naheng uva kahinsut hi, veuvin, Pathen maikoh-a kasei ahi, jou seija kahipoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche jou chun keima Syria le Cilicia gamkol sunga kachetan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hiche geija chu Juda gama Christa-a um houbung ho mel het louva umnalai kahi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Masanga eiho eibol sepao chun, tun khatvei suhmang dinga anagotsa tahsan thu chu alhang samlei, tibou chu ajah-u ahi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule keima jeh-a Pathen achoi-atnu ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujou kum somle kum li jouvin Titus jong kapuijin Barnabas toh Jerusalem'a kagachetou kit lhonin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule akilangdoh dungjuija gachetouva kahi; chuin Kipana thupha chidang namdangho lah-a kaseiphongle hi, chua um miho jah-a chun kakhelhan kaseitan ahi, ahinla ginle ja umho jah-a vang chun atum beh-in kaseijin ahi, hichu ajole kalhai hi ijem tia moh lhaija hikhange tia kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin kalhonpi Titus chu Greek mi ahi jeng vang chun, cheptansah ding agokhoh pouve;
  </para>
  <para style="p">
    <verse number="4" style="v" />chule hichu eisoh chansah theina dinguva, Christa Jesu'a ontholna ineiju velhiho dinga guhthima sopi lhemho hinpoh lut ahibouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kipana thupha thutah hi nangho-a aum jom jing theina dingin, nidan kah khat jengcha jong athu noijuva anakikhum lut louhel kahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin ginle ja uma kiseiho lah-a chun (itobang hijongleu, kei kakin akhohpoi; Pathen'in mi koima adatpoi), ginle ja uma kiseiho chun imacha eiseipehbe chompouve;
  </para>
  <para style="p">
    <verse number="7" style="v" />Seipehbe tah sangin cheptanho dinga Peter ahi banga, cheptan louho dinga keima kahia, Kipana Thupha chu ginchat tah-a eikipeh-a eikinganse chu aheuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />(Cheptanho solchah-a pang dinga Peter dinga thilbola chun, chidang namdangho solchah-a pang dinga keima dinga thil eibolpeh ahin);
  </para>
  <para style="p">
    <verse number="9" style="v" />Lungsetna eikipeh chu ahettoh phatnun, Jacob, Cephas, chule John aminche houbung khomho chengsen keimale Barnabas amaho kithopi tin, amaho cheptanho henga acheuve, keini cheptan louho henga kache lhonna dingin, akhut jet lamin eisangjovin ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Mivaichate geldoh jingna ding thu themkhat eiseipeh-un, hichu kei jong abolding kalunggot lheh ahinai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin Antioch kho-a Peter ahung chun themona anei jeh-in kanapho lon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu aman Jacob koma kona mi koi koiham phabep ahung masangun, chidang namdangho toh an anekhomjin; amaho hung phatnin, cheptanho akichan akinung khinin akitum sahtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Juda mi dangho chengse jong amatoh hitobangtah chun aphalhemun, aphat lhemnao chun Barnabas kisan jong amaho lamah akai tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin amaho Kipana Thupha thutah dola chu lungkitah-a achon louvu chu kamun, mi jouse maikoh-a Peter kasosalin, Nangma bon Juda mi hija Juda mi chona chon louva chidang namdangho chona chona chu, ibola chidang namdangho Juda mi chona chonsahtei go-a nahim? katin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Eiho apena Juda mi ihiuve, eiho chidang namdang michonseho ihipouve;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla eihon danthu lam thilbol vanga hilouva, Jesu Christa-a tahsan vangabou michonpha tia kisim ahi, ti iheuve; hiche jeh-a chu eiho jong Jesu Christa itahsanu ahi, chutia chu danthu lam thilbol vanga hilouva, Christa tahsan vanga chonpha tia ikisim dingu ahi; ajeh chu danthu lam thilbol vanga koima chonpha tia kisim lou ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin Christa vanga chonpha-a kisimna dinga ikihabol vanguva jong chonset na-a ilhahjiu ahin, ahile Christa chu chonset lhachaham? Ahipoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman kaphetsa chu sapha kitleng asukhela kahi, ti chu photchen sah kahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ijeh-inem itile Pathen lama kahinna dinga, danthu dola danthu lama athia kahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keima Christa toh thingpel'a kikhetbeh tha-a kahitai; keima ahinga kahitapoi, Christa chu keija hinga ahibouve; tu-a tahsaphe-a kahin hi keima eingailua, keima dinga kipedoh Pathen Chapa tahsan vanga chu hinga kahibouve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen milungset moh kahisahpoi; ijeh-inem itile chonphatna chu danthu lam thilbol vanga ahile, Christa chu ajeh beija moh thia ahitai, kati.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo lungthimbei Galatia miho, namitmu tah uva Jesu Christa thingpel'a akikhetbeh chu kichentah-a nalah uva kiphongdoh ahitai; thutah-a nunlou nadia koiham najol lha uva?
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nangho-a konin hiche thu maicha hi kahet nome, Lhagao nachanu chu danthua chona konham, tahsan thu najah uva konham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho chutobang loma chu lungthimbeija nahiuvem? Lhagaova kipanna tahsa phe-a kichaija nahiu hitam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon mohjen seh-a hesoh genthei nathoh-u hitam? hitichu ahile, moh jenseh tahbeh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lhagao napeuva chule nalah uva thilbol kidang boljia chun, danthua nachon jeh uva abol jiha, tahsan thujah jeh-a abolji ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutia chu, Abraham'in Pathen atahsana ahile, hichu ama dinga chonphat tia kisuna ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche jeh chun atahsanho chengse chu Abraham chate ahiuve, ti heuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen'in chidang namdangho chu tahsan vanga them achansah ding ahi ti chu ahemasan, Pathen lekhabun, Nangma-a kona chitinle namtin phattheina chang ding ahi, tia masang peh-a hiche thupha hi Abraham ana hetsahsa ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuti ahi jeh chun tahsana kon chengse chu mi tahsan umtah Abraham chutoh phattheina chang khoma ahitaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu danthua chon chengse chu sapset changa ahiuve; ajeh chu hitin akisune, Koi hile danthubua kisun chengse nitjom jinglou chu sapset chang ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin danthua chonin Pathen anga koima them achangpoi, ti akichene; ajeh chu, Michonpha chu atahsan vanga hing ding ahi, kitia ahi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule danthu chu tahsana kon ahipoi; ahinla danthu-a chona chu hichea chu hing ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Christa chun danthu sapset chana-a kona eiho eihung lhatdoh-u ahitai, ajeh chu ama eiho khela sapset hung changa ahi; ijeh-inem itile, Thinga kikhai sang tapou chu sapset chang ahi, tin akisune;
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichu Abraham phatthei chu Christa Jesu'a chidang namdangho heng alhuna, eihon tahsan vanga Lhagao chu ichan theina dinguva ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sopite, keiman mihem thu seija kasei ahi; mihem kitepna mai mai ahivangin, min aphudet nungle koiman moh ahisah jipoi, chule koiman jong abelap jipoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuti ahi, thutep ho chu Abraham le achilhah kipe-a ahi. Aman tamtah seina bangin, Chule nachilhah ho, atipoi; khatseh seina bangin, chule nachilhah, atibouve; hichu Christa ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tun hiche hi kasei ahi, Pathen'in amasanga kitepna khat Christa-a aphudetsa ahin, hichu kum jali le kum somthum nunga umdoh danthu chun kitepna chu moh ahi louna dingin, ason mangpon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Goulo ding chu danthu vanga ahile, thutep vanga hilouhela hi ding ahi; ahinla Pathen'in thutep vangin Abraham apetan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuti ahile danthu hi ipi phatchomna ham? Thutepna chilhah chu ahung kahse-a dinga, suhkhel jeh-a hichu kibelap ahi; hichu vantil teho kimanga palai khat khutna kitungdoh ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palai chu khat changa dinga palai ahipoi, Pathen vang khatsehbou ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuti ahile, danthu hi Pathen thutep douvaham? Chuti ahipoi. Hinna pethei danthu kipe-a hile, dih tah-a chonphatna chu danthua kon hitei ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin Jesu Christa tahsan vanga thutep chu atahsanho akipeh theina dinga, Pathen lekhabu thu chun ijakai chonset noija akhachah ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tahsan thu hung lhun masanga chu danthu noija eina kikoijuve, ahung kilang dinga um tahsan chu ngana-a kikha khuma inahiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hitia chu tahsan vanga chonphat ichan theina dinguva, Christa henga eipui dinguva, danthu chu eikaihoi juva anapanga ahibouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tahsan thu hunglhun kal vang hin, chuche eikaihoi juva noija chu ihi tapouve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Christa Jesu'a natahsan uva kona chu nangho nabon chaova Pathen chate nahiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangho Christa-a baptize chang chengse chun nabon chaova Christa chu nakivonu ahitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichea chun Juda mi Greek mi aumtapoi, soh leh sohlou aumtapoi, chule numei le pasal jong aumtapoi; Christa Jesu'a chun nabon chaovin pumkhat nahitaove.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule nangho Christa-a nahiule Abraham son nahiuve, thutep bangtah-a chu gou lo ding nahiuve.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin keiman kasei chu, goulo ding chu chapang ahi laisen, imajouse pakai ahi jeng vangin, ama chu sohtoh imachom ahipoi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin apan athutep alhin phat kahsen, akaihoile a-inngahho thu noija aumjin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Eiho jong chutobanga chu ichapan laijuva, vannoi leiset lekhajem bul noija sohchanga ina-umu ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin phat ahung lhintah-in, Pathen'in achapa chu numei sunga soh, danthu noija peng dingin ahin soltan;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chapate hina ichan theina dinguva, danthu noija umho lhatdoh dingin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangho chate nahi jeh uva chu, Abba, Hepa, tia kouji Achapa Lhagao chu Pathen'in nalung sunguva ahinsol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche jeh-a chu nangma soh hita louva, chapa nahi ahitai; chule chapa nahile, Christa vanga Pathen goulo ding jong nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahi jeng vangin Pathen nahet lou laijuva chu, apen umchana pathen hilouho soh nanahiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin tun Pathen nahet nunguva, ahiloule Pathen hetjong nahi nunguva, i-atileh lekhajem bul hatmotah soh-a lutkit dinga nakihei kit jenguham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanghon ni, lha, kum kihei, kum nanit jiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangho dinga katohgimna ijem tin moh hinte, ti nangho dingin katijan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sopite, keima nangho banga kaumtah banghin, nangho keima bang hin umun tia kangeh nahiuve. Nanghon ahilouvin neibol pouvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin katahsaphe hatmo jeh-a amasa-a Kipana Thupha nangho kahil chu nanghon naheuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kasa chunga nangho dinga lhepna um chu nahsahmon nabolpouvin, the jong nathe pouve; Pathen vantil khat bangle, Christa Jesu bang helin neinalem jouvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti ahile chuche laija naseiju vangpha nakisah nao chu hoilam hitam? Na-umchan dol thu-u kahettohsah-a kasei ahi, hi theile namitchang sanu nakaldoh uva neipeh dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuti ahile keiman najah uva thutah kasei jeh-a hi, nagalu kahi hitam?
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon apha lama tompan tah-a nangho naholu ahipoi; nanghon amaho nahol theina dinguva, nangho chu polama kha khumden ding angaitou ahibouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin a-imatih chana apha lam hola tompan hi aphai; nakom uva kaum pet jenga hilouvin, imatih chanin aphai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kanaote, nangho-a Christa lim asodoh kahse-a, keiman nangho dinga naosonat kathoh kit ahi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule tun nangho koma hunga aw chombeh-a thusei kanom ngeijin ahi; ajeh chu nangho chungchang thu kadatmoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Vo danthu noija umnom teho, seijun, nanghon danthu hi najah khah lou uham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitin akisune, Abraham'in chapa ni aneijin, asohnu sunga peng khat ahin, khat chu soh hilounu sunga peng ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sohnu-a chu tahsaphe lam dola peng ahin, chamlhatnu-a vang chu thutep vanga penga ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche thuhi tekahna ahi; ajehchu hiche hi kitepna ni ahi; khatjoh chu Sinai mola kon chule soh-a vul dinga cha hinga ahi; hichu Hagar ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Arabia gama min Hagar kiti chu Sinai mol kiseina ahi; chule tulaija um Jerusalem jong khu aseina ahi; amanu chu achate toh soh hitha-a ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chunga um Jerusalem vang chu ongthola chamlhatnu chu ahin; hichu ipiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu hitin akisune, Achinga chasoh lounu nangma kipah-in; Naosonat thoh lounu sangtah-in khosamin; Pasal neijonu sangin ahomkeova umnu chate atamjoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sopite, eiho jong Isaac banga thutep chate ihiuve;
  </para>
  <para style="p">
    <verse number="29" style="v" />Amavang chulai tahsaphe lam dola pengpa chun lhagao lam dola pengpa chu suhmang agot ahin, tu-a jong chutobang chu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla Pathen lekhabun ipi atim? Sohnu chu achapatoh kaidohtha tan; ajehchu sohnu chapa chun chamlhatnu chapatoh gou lokhom ponte, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuti ahi jeh chun, sopite, sohnu hin chate ihipouve, chamlhatnu hin chatejoh ihiuve.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Soh ihi louna dinguva Christan eilhatdoh-u ahitai: chuti ahi jeh chun dingdet jingun, soh namkoljona chun kihen oh kit hih-un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Veuvin, kei Paul'in kahinsei ahi, nanghon chep natan uva ahile, Christa chu nangho dinga imacha aphatchom sah louding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cheptan ho chengse hettohsah na-a kahinsei ahi, ama chun danthu apumpia bol ding abat jing ahi nalaije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho danthua chonphat chan goho chengse chu, Christa-a kona kisepkhen nahitaove; nangho lungsetna kona pul lha-a nahitaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh iham itile eiho Lhagao vanga tahsana chonphat chan kinema ngah ihiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajeh chu Christa Jesu'ah cheptan hi aphatsahna aumpon, cheptanlou jong hi ima ahidehpoi; ahin tahsan ngailutna-a tonga chu phachoma ahibouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangho nalhaiju aphaname; thutah thua nun louna dinga koiham nasumovah?
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitobanga kijol lhah hi nakou paova kon ahipoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chol themkhat chan changbong lum apumpia apomsah ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanghon lung adang imacha neipouvinate, tia Pakaiya katahsan lheh nahiuvin ahi; ahinla nangho nasulonguva chu koi hile, achunga thu kitanna talen athoh tei ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sopite, tu-a hi keima cheptan thu dol seile-a hileng, ibola bolsetna hi kathoh dingham? chutileh thingpel'a kipal lhuhna hi kisubei ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangho sulonga pangho chu amahole amaho kitanbongleu pha kasai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sopite, nangho soh hilou ongthol dinga kikou nahiuve; amavang soh nahilounao na-onthol nao chu tahsa lama dingin agomkomin neidaovin, ahin ngailutna-in khatle khat kijento uvin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Naheng nakoma nangma bangtah-in ngailun, ti thua hi danthu jouse bukimsoh keija ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amavang nangho kiketto saosaole kivalto saosao nahiu vangle, khat bola khat namanthah louna dingun chingtheijun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keima vangin, Lhagaovin chonun, kati ahi, chutile tahsaphe lam lungtup chu subulhit lou ding nahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ijeh-inem itile tahsaphe lam lungtup chu Lhagao douna ahin, Lhagao tup tahsaphe lam douna ahi; chutia chu nanghon nalunggot bangu chu nabol louna dinguva, hiteni chu kidouva ahi lhone.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin nangho Lhagao pui nahiu vangle, danthu noija um louva nahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule tahsaphe lam thilbol chengse vang chu akilange; hichu miji toh jon, jonthanhoi, thenlou, huh,
  </para>
  <para style="p">
    <verse number="20" style="v" />Milim hou, doichoi, kidou, kinah kinel, kimitthip, lunghan, kiloset, kibungkhen, tahsan dihlou,
  </para>
  <para style="p">
    <verse number="21" style="v" />Kithangset, toltha, jukham, eltol golnop bol, chule chutobang adang dang jong chu ahi; hichenga chu masanga kahilchah banguva chu masang peh-a kahilchah masah nahiuve, chutobanga chonho chun Pathen gam alo lou dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lhagao ga vang chu ngailut, kipa, cham, thohhat, mihepi, phat, tahsan umtah hi,
  </para>
  <para style="p">
    <verse number="23" style="v" />Lungneng, amachang kitim, hicheng hi ahi; hitobangho chunga vang danthu aumpoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Christa-a hiho chengse chun tahsaphe chu alungtuple, angaichat puma thingpel'a akhetbehthao ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eiho Lhagaova hinga ihiule, Lhagaovin chonuhite.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khatnin khat lunghan sah-in, chule khatle khat kithangset ton, panna beijin hoitho pouhite.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sopite, mi khattou suhkhel neija auma athemona kimandoh aumle, lhagao mi nanghon lungnem tah-in chutobang mi chu boldamun, nangma kiven ajole nangma jong lhepna-a lhakha nate.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho khatle khat pohgih kipohhu uvin, chutichun Christa danthu nit bukim sohkeijun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi khattou ikhat hia kingaito-a, imachala hilou chu, ama kilhemlha-a ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin, mitinin ama ama natoh kipatep chehhen, chutile ama changa thua kisonna ding mun anei ding ahi, mi dang thua hilouvin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu mitinin ama ama poh cheh akipoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen thu kihila mi chun ahilpa chu thilpha lam dol jouse chankhom pihen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangho dohan lha hih-un; Pathen chu nelpeh dan ahipoi; ajeh iham itile mihemin aman atu tu chu a-at ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu tahsa lam dola tupa chun tahsaphe-a kona kemmang thei ga alo ding; Lhagao lama tupa vang chun Lhagaova kona tonsot hin kemlou ga chu alo ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thilpha bolna lamah chimtih nei louvin umu hite, ilhahdah louvule aphatcha ilo dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche jeh chun hungun, aphat achang agomkom inei bang dol cheh-in, mi jouse chunga thilpha boluhite; ahideh-in eima insung mi atahsanho chungah haboldeh uhite.
  </para>
  <para style="p">
    <verse number="11" style="v" />Veuvin, keima kakhut tah-in jem khoutah-in nangho henga lekha kahinsune.
  </para>
  <para style="p">
    <verse number="12" style="v" />Atahsa vet hoisah goho chengsen cheptan dinga nabol khoh-u ahi; hichu imadang dinga ahipoi, Christa thingpel jala bolset chu athoh louna dinguva ahibouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu cheptan tah mongho jeng jongin danthu anitdeh pouve, natahsao chu kisonna-a anei theina dinguva, cheptansah dinga nagotjiu ahibouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keivang I-Pakaiyu Jesu Christa thingpel tailou chu thu dang imacha song hihhel ingkate; Ama vanga chu vannoi keima dinga chule keima vannoi dinga thingpel'a kikhenbeh kahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh iham itile cheptan chu imacha ahipoi, cheptanlou jong imacha ahipoi; Christa Jesu'a kisem thah bou chu thu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule chuto bang chona-a chonte chunga le, Pathen mi Israelte chungah lungmon chule lungset umhen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tu-a kalvang koiman eisulung gim tahih hen; ajeh chu kati chunga hi Pakai Jesu melchihna pole-a kahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sopiteho, I-Pakaiyu Jesu Christa milungset chu nangho lhagaotoh umhen. Amen.
  </para>
</usx>
