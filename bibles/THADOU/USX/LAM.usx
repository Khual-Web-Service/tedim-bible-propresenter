<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LAM" style="id">Kala</book>
  <para style="h">Kala</para>
  <para style="toc1">Kala</para>
  <para style="toc2">Kala</para>
  <para style="mt">Kala</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />I-ahungtile mipi dimsetna ana umna khopi chu thomhao tah-a hung uma hitam! I-atile amanu meithainu hung bangdoh-a hitam! namtin vaipi lah-a apipen chule gamkaiho lah-a leng chanu bang anahia chu i-ahungtile tu-a soh hungsoh-a hitam!
  </para>
  <para style="p">
    <verse number="2" style="v" />Amanu janteng hakan akapjin, abeng teni mitlhin achupjin, ama ngailuho lah jenga jong alhem lungmong ding khatcha aneijoupoi. Agolte jousen jong ama adoha bolun, amaho amanu melma asohgam taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah chu hesoh gentheina jehle, bolgentheina jeh-in gal hingin kaimangin aumtai. Amanu Pathen helouho lah-a achengin, olna himhim amujou tapoi. Amanu bolgim hon alungdon pettah in aman taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zion lampiho chu alhasetai, ajehchu kut loupitah mang dingin koimacha ahung tapouvin; akotpi phung jouseu akamheltai. Athempuhou akhoisan, anungah thenghou athohgimun, chule amanu jong lung gimin aumtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amanu kidoupiho apipu ahitaovin, amelmate ahung lolhing taovin ahi; ajehchu asuhkhel nao tampiho jeh-a Pakaiyin amanu asuhgenthei ahi. Achateho jong amelmateu masanga gal hingin achegam taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zion chanu-a konin ahoinaho jouse achemang tai. Amanu pipuiho jong sakhigol lhatna mun mujoulou abangtauvin, chule amaho adelpao masanga thabeijin achetauve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amelmate khutna amite alhuh-a, koimachan akithopi lou phatnin, akisuh gentheina nikhole avangsetna nikhoho chun Jerusalem'in masanglaija akut nopsahnahou chu ahingeldoh-e; akidoupihon amanu amuvin, acholngah nikho hou anuisat bepmui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jerusalem melse tah-in achonsen; hijeh-a chu amanu kiladoh-a ahi. Amanu anajabolho jousen i-asahtapoi, ajehchu amahon amanu sagohkeo ahina chu amudoh taove. Ahi, amanu akhoisasan chule akinunghei kit tai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amanu thenlounaho anih ho-a abeh-in; akhonung phat ding jong ageldoh poi. Hijeh chun kidang tah-in ama akemsuh-in, alhamonsah ding koimacha aneipoi. Vo Pakai, kahesoh gentheina hinven; ajehchu melma chu amale ama akiloupi sahtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Akidoupipan amanu thilpha neiho jouse chunga akhut ahinlhang doh-e, ajehchu nangman namite houkhom ho lah-a luttheilou dinga nanathupeh Pathen heloute chu, amanu muntheng mun'a alutnu amanun amutai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amite jouse akhoisa gamtaovin, neh akiholuvin; amahon akihinso theina diuvin thilpha aneijouseu chu akijoh doh gamtaove. Vetan, vo Pakai, chule ngaiton, ajehchu keima thet umtah kahung hitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khola vahle ho hiche mun hinjotpaho dinga hichehi imacha hilouva ham? Veuvin, chule heuvin, keima chunga gim gentheina hunglhung, Pakaiyin alunghan khaotah nikho-a eisuhgentheina tobang gim gentheina aum khapoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chunga konin aman kaguho sunga mei ahinsol lutnin, hichun kaguho achansoh keijin ahi. Aman kakeng teni-a dingin len ajah-in, keima eikinung heisah kitnin ahi. Aman nilhumkeijin keima eilunglhah sah-in, chule eilhah lhopsah-e,
  </para>
  <para style="p">
    <verse number="14" style="v" />kasuhkhelna namkoljon chu aman akhut tah-in atuh-in; hicheho chu aman khivuija athilin kangongchanga ei-o pehtai. Aman katha alhahsamsah-in, Pakaiyin amaho khutna keima eipedoh-in, amaho-a konin keima kathoudoh jou tapoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima angsung tah-a kamihat ho chu Pakaiyin achotpha tai. Aman keima douna-a kagollhang ho suhmang nadin mipi akhomin ahi. Judah chanu nungah theng chu Pakaiyin lengpiga chilna bangin achiltai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche thilho jeh hin kakaptai; kamit ngeihi twijin along lhatai. Ajehchu kahinna kidosah kit thei ding lhamonsah chu keija konin gamlatah-a aumtan; galte ahattah jeh-un, kachate jong athomhaosoh taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zion'in akhut teni ajahdoh-in, ahinla ama lhamonsah ding koimacha aumtapoi. Pakaiyin Jacob chungchanga chun akidoupiten aumkimvel diuvin thu anapen ahi. Amaho lah-a Jerusalem hi numei nihboh nei abang jengtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai chu chonpha ahi, ajehchu keiman athupeh kanadouvin ahi. Ngaijun, katao ahi, mipite, chule kalung gimnahi veuvin, kanungah thengle gollhangho jong gal hingin akikai taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiman kangailut ho chu kakoujin, ahinla amahon eijoulhep taove. Kathempuhole ka-upahon khopi sunga ahinnao kidokitna dinga neh ahol nalam uvin alhagao alhagam taove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vo Pakai neihin ven; keima lung genthei jin kaumtai; kasung akithing tai, kalung sung akipei jengtai. Ajehchu keiman nasatah-in kanadouve, polama chemjamin mihem athatnin, insung jong thina in tobang jeng ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amahon kakhoisat ajauvin, koimacha eilhamon ding aumpoi. Kamelmate jousen kalunggentheina ajasohkei juvin, nangman naboldoh na-a hin amaho akipah uve; nangman naphon dohsa nikho hinlhun sah-in natin, chutengle amaho keima tobang hung hitaovinte.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amaho gitlouna jouse na-anga hunglhung hen; chule kasuhkhelna ho jouse jeh-a kachunga nabol bangin amaho chunga jong bolin, ajehchu kakhoisatna atame, chule kalung jong alha lhoptai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Itobang tah-a Pakaiyin Zion chanu chu alunghana meiloma akhu khuma, chule Israel hoinaho chu van'a kona leisetna ahin lelhah-a, chule alunghanlai nikho-a akeng ngapna jeng jong ageldoh lou hitam!
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin Jacob chenna mun jouse aval lhumtai, chule khotona aneipoi, alunghana jeh-in aman Judah chanu kulpidet ho chu asonlhan, chule hicheho chu toltoh alhobehtai; aman agam sungle chuche sunga pipuiho jong asubohtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman tijat umtah alunghan na-in Israel ki jouse asubongin, amelmate maija konin akhut jetlam anung loidoh-in, chule akimvel dung meikong hattah bangin aman Jacob dounan mei akondoh sah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman melma khat bangin athal akamsalin, kidoupi khat bangin akhut jetlamin apangin, Zion chanu ponbuh sunga chun mitvetna hoijouse chu athatgamtai; aman alunghana chu mei bangin asunglhatan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai chu melma bang ahin; aman Israel avallhum tan, aleng inho jouse jong aval lhumtai; aman amaho amundet jouseu jong asuhset peh-in, chule Judah chanu ka nale maona jong asupung cheh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman honlei khat bangin ahoubuh chu pumhatnin alamang tai. Aman mipi akikhopnao munho jong asuhsetpeh tai, Pakaiyin kut loupitah hole cholngah nikho jong Zion sunga suhmilin aumsahtai, chule alunghana nasatah jeh-in lengle thempu jong i-asah tapon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin amaicham apaidoh-in, amun theng jong akidahtai. Aman leng inpi bangho jong melma khutna alehdohtan ahi; hitichun kut loupitah kibol nikho bang helin amahon Pakai insunga chun husa asosah taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin Zion chanu kulbang suhset ding agongtai, Aman gamgi khat alhungdoh-in, akhut jong suhsetna lama konin akihsah tapon, hijeh chun aman kul vumle kulbangho chu lunghem na-in asemin amaho lhanguijin aumtaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amanu kotpigolho leisetna alhalut tai, amanu thihlhonho chu asuhboh peh-in, asuhmangpeh-e. Alengpale apipuho chu chidang namdangte lah-a aumtaove. Dan thupeh jong aumtapoi, athemgaohon jong Pakaiya kona mu anei tapouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zion chanu upate chu tolla atouvun, thipbeh-in aumtaove. Amahon alujang uvah leivui akinuvin, khaodip pon jengin akivon taove. Jerusalem nungah thenghon jong alu-u tolah asulutnun akuntaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kamit lhi jeh-in kho kamuthei tapoi. Kasung akithingin, kamite chanuho kisuhmang jeh-in kalungthim jeng jong leiset chunga akisunglha tai. Chapanghole noichep laiho khopi lamlen ho-a anguilha gamtaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khopi lamlen ho-a gala kisukhaho banga ahaisamuva, anuteo phei chunga ahinnao abuhlhah lhah laiju chun amahon anuteo jah-a, bule lengpitwi hoibaham? atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Jerusalem chanu nangma hettohsahna dinga ipi thil kamana, katekah ding nahim? Vo nungah theng Zion chanu, ipitoh nakibange kati ding ham? Ajehchu nasetna twikhanglen banga len ahi, koijin damsah theijin natem?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nathemgao hon nang dingin pannabei le ngolhoi ngen namudoh peh uve. Chule amahon nasohchanna-a kona nakitoldoh theina dinga nakhanset naho amudoh dinghou chu amudoh pouvin, ahinla nangma dingin pohgih dihloule kikai mangna bou namudoh peh-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nahinjotpa jousen akhutnu nahin behkhumun, Jerusalem chanu chu anuisatnun, chule akhasuh-un, hiche khopihi hilouham, mihem ten hoina chamkimna, leiset pumpi kipana ahi atiu chu? atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Namelmate jouse nangma dounan akam kauvin, amaho a-eng hamun, aha-u agoijun, meihon amanu aval lhum jou taove, adihtah-in inanga jingu nikho chu hichehi ahitan, eihon ihol doh-un, imudoh taove, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakaiyin agon chu atungdohtai. Aman masang laija athupeh chu asubulhing tai. Aman aseplhan akhotopoi. Chule aman nachunga namelma kipana asosahtai, aman nakidoupi te ki chu atungdohtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Alungsungu Pakai henga apengin, Vo Zion chanu kulbang, sunle jan-in mitlhi lui bangin longhen, kicholdo hihbeh-in, namit lhi lon banghih hen, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thouvin janle pengdoh jengin: Jan phat ahung kipatle Pakai maija nalungsung twi bangin sunglhan lang, khopi lamlhah bul tina nachate chapang khangdongho gilkela lhasamho hinna dingin nakhut teni domsangin, ama lam chu sang jengin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vetan, vo Pakai, koi chunga hitobanghi nabol em, geltemin. Numei hon alaigilgau khap khat bep chapangho chu anehdiu hitam? Thempuho le themgaoho chu Pakai muntheng sunga kithattei ding hitaovem?
  </para>
  <para style="p">
    <verse number="21" style="v" />Ateh akhang lamlen ho-a tolla alumtaove, nungah theng kanei hole gollhangho chemjamin alougam taove, nangman nalunghan niho-a amaho natha ahitai. Nangman nathatnin khotona naneitapon ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangman nikho loupi ni-a bangin katijat naho nasam khomin, hitichun Pakai lunghanna nikhon koimacha ajamdoh theile aumden theija aumpoi. Keiman kahuiluma kavahdoh ho chu kamelma hon asumang heltai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Alungsatna tenggola hesohna ana mu-a chu keima kahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman vah hilouvin, muthima keima eipuilutnin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahbeh-in aman keima eikidoupin, nilhum keijin kachunga akhut alamin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman kaphele kavun avoilhah sah-in, kaguho jong asubongtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman kei dounan kul agenin, thoh hahsa nasatahle gimna-in eiumkhum tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman khanglui laipeh-a anathisaho bangin, munthim lah-a eiumsah-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman keima tho eikai khumin, kapot thei tapoi. Aman kakihenna thihkhao agihsah-e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keima kapma kepen teng jongle aman kataona akhahchah jitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman song kikheng ho-a ka lampiho akhah-in, kalampiho akonsah gam ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama chu keidin vompile keipi bahkai muthim laija um abange.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman kalampiho ahei mangin, chule eimaltel jengin; aman kamhellin eisotai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman athal akamsalin, thalchang chuhna ding lama keima eikoitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman alivatheija thalchang ho chu kalung changa chudin akaplutsoh tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima kamite jouse henga totnopna bep kahitan, chule nilhum keija alasah-u kahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman keima thil akhatna kha-in eidipmin, chule gamsai twijin eivahkham tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman songbong hemho mangcha-in kahaho eisuhboh peh-in, vutvaijin eivuhkhum tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule chamna-a konin kahina gamla tah-in nachon mangin, phattheina jong kasumiltai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman Pakaiya konin kathahat nale kakinep naho amang heltai, kati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kahesoh nale gentheina chule kathohgimna, gamsaile gil kha chu kagel doh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahin nahin hicheho chu ageldoh-in, chule keima suhnemin kaumin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichehi kalungin kagah gelin, keiman hichea chun kinepna kaneitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai khoto them naho jala bou suhgama umlou ihiuve, ajehchu amihepina chu alhasam ngaipoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hicheho chu jingkah seh-in athah jingin, nakitahna chu alenin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kachan ding chu Pakai ahi, hijeh-a chu ama-a kakinep ding ahi, tin kahinna hin aseije.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pakai chu ama ngahjing tele, ama holjing mite dingin aphan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mihem khat dinga Pakai mi huhhingna chu kinema thipbeh-a nga chu thilpha ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihem dingin akhandon laija namkoljon poh hi aphan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama achang seh-in thipbeh-in atouve, ajehchu aman hichu achunga apoh ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kinepna-a aumtheina dingin, aman leivui lah-a akam asulutnin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman adengpa chu abengphe adopeh-in; housetna-a jong adimin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu Pakaiyin a-imatih-a apaidoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amavang aman sugim jengjongle, amihepi themna tamtah jala chu hepina anei ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ajehchu aman, mihem chate chu aphat sah jeh-a asuhgentheija, ahiloule asuhgimji ahipoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Leisetna sohchangho chu akengtoa chil goija umding ahiuvin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Chungnung pen masang tah-a mihem khat thaneina lahdohna dinga,
  </para>
  <para style="p">
    <verse number="36" style="v" />Mihem khat ama hina noisehi, Pakaiyin pha asapon ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pakai jin thu apeh louleh, athusei lhunsah theija chu koiham?
  </para>
  <para style="p">
    <verse number="38" style="v" />Asele apha hungdoh nahi chungnung pen kama kon hilou ham?
  </para>
  <para style="p">
    <verse number="39" style="v" />Mihem khatnin achonset jeh-a talen amat chu, mihing khatnin ipi dinga aphunpi ham?
  </para>
  <para style="p">
    <verse number="40" style="v" />Eihon ilampihou kiholu hitin, chule kipatepmu hitin Pakai lama kihei kitnu hite.
  </para>
  <para style="p">
    <verse number="41" style="v" />Eihon ilungsung houle ikhut houvin van ho-a um Pathen lam sangu hite.
  </para>
  <para style="p">
    <verse number="42" style="v" />Keihon kana sukhelun, chule kanadoutaove, nangman neingaidam tapouve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangma lunghan na-in nakikhu-in, chule neisugimun ahi. Nangman nathatnin, khotona naneipoi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nangman kataona hou ahunglutpai thei louna din nangle nang meilom'in nakitomin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nangman miho lah-a keiho deiloule bohnen bangin neisem taove,
  </para>
  <para style="p">
    <verse number="46" style="v" />Kamel mate jouseu keiho dounan akam kataovin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tijat nale thangkol chule suhgamna le kachunguva kamhelna chu ahung lhungtai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kamipite chanu kisuh gamna jeh-in kamitlhi luijin along jenge.
  </para>
  <para style="p">
    <verse number="49" style="v" />Kamitlhi apulin, tanglou helin alongdoh doh jenge,
  </para>
  <para style="p">
    <verse number="50" style="v" />Pakaiyin van'a kona ahin suhvetna ahinmu kahsen,
  </para>
  <para style="p">
    <verse number="51" style="v" />Kakhopi sunga chanute jouse jeh-in kamitnin kalung atong khatan ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Kamelma ten ajeh beijin vacha bangin nasatah-in eidel lele jeng taove.
  </para>
  <para style="p">
    <verse number="53" style="v" />Amahon leinoi kotong sunga kahinkho asumangun, chule kachung song khatnin adelphaove.
  </para>
  <para style="p">
    <verse number="54" style="v" />Twiho kalu chunga alongin, hichun keiman amangthah-a kahitai, kati.
  </para>
  <para style="p">
    <verse number="55" style="v" />Vo Pakai leinoi kotong thuhtah-a konin keiman namin kahinsamin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nangman ka awgin najai, kakana le kahai ginna konin nanakhang heimang hih-in.
  </para>
  <para style="p">
    <verse number="57" style="v" />Keiman nangma kahinhou nikhon nahung naijin: kicha hih-in, neitin ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Vo Pakai, kalung sunga thil umho neisei hun, nangman kahinkho neilhatdoh pehtai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Vo Pakai, nangin kathemmona namutai, kathu neitan peh-in.
  </para>
  <para style="p">
    <verse number="60" style="v" />Nangman kei douna-a alunggel houle aphulahnao jouse namutan ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Vo Pakai, amahon eihouset naole eidehnaova alunggelu nangman najatai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Keima douna-a hung kipandoh ho muhle, nilhum keija keima dehna-a agonu abonchan nangman najasoh tai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Amaho toulhahle kipatdoh khu vetan, alasah-u jong keima jontai nabep ahitai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Vo Pakai, akhutnuva athilbolu dungjuijin amaho lethuhna pen.
  </para>
  <para style="p">
    <verse number="65" style="v" />Nangin amaho nasapsetna le lungthim natna chu pen.
  </para>
  <para style="p">
    <verse number="66" style="v" />Pakai vanho noija konin lunghanna in amaho bolgimin lang sumangin.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />I-atile sana mol lha-a hitam! I-atile sana thengtah kikhel jenga hitam! Munthenga songho chu lamlhah tin chenga akisunglha tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Manlutah Zion chapate chu sana thengtah toh tethei ahin, i-atile amaho beldengpan leibel aden bangbepma umu hitam!
  </para>
  <para style="p">
    <verse number="3" style="v" />Twi saiho jengin jong anoi adon, anoute avah-in ahi. Kamite chanuho hi gamthipma vacha lengho bangin alungselun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Noi cheplai naosen lei chu dang chah-in adanga abehden tai. Chapang khangdong laihon an athumun ahinla koiman apepouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Annem ne-a hung kivahho chu khopi lamlen ho-a amahthah gamtaovin; ponsanthip silla hung kivahdohho chun eh kisungvum adeijuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu kamite chanute khangitlouna talen chu mitphet kah louva kisumang Sodom chonsetna talen sangin alenjoi, chule amanu chunga chun koimacha khut achupoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amanu Nazire mi hina chu buhbang sangin atheng jon, bongnoi sangin abang jon, avouso chu songmantam sangin ahoijon, ahoidan chu Saphir song tobang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho mel chu meihol sangin avom jotan, lamlen ho-ah amaho hetphah-in aumtapouve. Avunhou chu aguhouva abeh-in, molkangto abang jengtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chemjam'a kithat ho chu kela thiding hosangin aphajotai. Ajehchu hichehohi lou gasoh ngaichatnan anguijin amangthah jitauve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khotona nei numei ho khut chun achateu achul chulun, kamite kisuh mangna-a chun amaho chu a-an uvin apang taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakaiyin alungsatna chu amolso tan; aman alunghana nasatah chu ahin bunglhatai, chule Zion'a mei akongdoh tai, chule hichun thil bulho chu asumangtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leisetna lenghole vannoi'a chengho jousen, akidoupi amelmau chu Jerusalem kotpiho sunga alut jou taove ti anaginchat louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu amanu lailung tah-a chu themgaoho chonsetna le thempuho khangitlou jeh-a chondihho thisan kiso-a ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho mitcho ho bangin khopi lamlen ho-a avah leuvin, mihon avonhou atohkhah nomlouna diuvin thisanin akisuboh-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon ajah uva, nangho chemangun, potdoh-un, potdoh-un, hiche hi tongkha hih-un, athengpoi tin asamui, amaho ajam manguva avalele phatnun, amahon Pathen heloute lah-a, amaho chua chun chele tapouvinte tin aseijuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai lunghanna chun amaho asukhentan, aman amaho khohsah kit taponte, amahon thempuho ajabol tapouvin, chule upaho jong angaisah tapouvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Eiho dingin vang, kithopi pannabei ivetna lamun imitnu athontai, ivetvet naovahin eihuhdoh jou louvu nam khat ivedoh taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amahon ikalson nao ahindel peh-un, ikhopi lamlen hou ijot thei tapouve, ikichainao anaijin, inikhohou alhingin, ajehchu ikichainao chu ahung lhungtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Eiho eisugenthei hou chu van'a mulaopi ho sangin agang jouvin, amahon lhangsang ho chunga eidelun, amahon gamthipma eiho eichang lhiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />In'ah homuva hu, Pakai thaonu, eihon ama lim noija Pathen heloute lah-a chenginge itiu chu, amahon akokhuh sunguva eikoi taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Uz gama chenga, vo Edom chanu kipah-in lang thanomin; khon jong chun nangma nahinphah ding ahi. Nangma nakham ngoldel ding; ahi, chule nangle nang sagohkeo nakiso ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vo Zion chanu, nakhangitlouna talen namu chu akimolso tai. Aman nangma gal hingin nakai kit taponte, aman nakhangit louna jeh-a gotna napehding ahin, Vo Edom chanu, aman nachonset naho ahung mudoh ding ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hingel doh-in, vo Pakai, kachunguva ipi hung lhunga hitam, ngaiton, chule ven keiho kiphosalnahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kagouhou le kainhou hetlou mite hengle gamdang miho heng lama akiheitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiho naochaga le paneilou kahitaove, kanuteu jong meithaiho abang taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Katwihou man neijin kadonun; kathinghou keiho henga akijoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kangonghou suhgentheina noija aumtan; katong gimun olna himhim kanei tapouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keihon neh le chah lonan kakhutnu Egypt mite leh Assyria mite henga kapetaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kapateu anachonseuvin, tun aum tapouve, chule keihon amaho khangitlouna kapouvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Soh hon kachunguva vai ahomun, amaho khutna kona eihuhdoh uva koimacha aumpoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gamthipma chemjam jeh-in thina geijin neh kakilouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kel hoisetah jeh-in kavunu jong lungthu bangin avom jeng tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon Zion'a numei ho le Judah khopiho-a nungah ho asuseuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leng chapate akhutnun akikhaisangin; upaho mai jong jana akipepoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon gollhangho sumhei hehdin apuijun, chule chapangho thing noija alhugam taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kotpi phunga kon upaho, chule tumging theija konin gollhangho abangtauve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kalung sunguva kipana abangtai, kalamnao jong lunghemna asohtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kalu uva konin lallukhuh alhatai; kanachonset jehu'n, Ohe ada kahiuve!
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichejeh hin kalungu alhamang tan; ajehchu hicheho jeh-a kamit hou thima ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zion molsang kamhela aumtah jeh-in, sial ho achunga avahleuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Pakai, nangma a-imatih chana umjing nahi, nalaltouna chu akhang akhanga umjinga ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu nangman keiho imatih chana dinga neisuhmilu hija, chule hitihchan pihi neidalhah-u hitam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Vo Pakai, naheng lama keiho neiheijun, chutile hung kihei taovinge, malaija bangin kanikho hou neisemthah peh-un.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla nangman keiho neipaimang hel taovin; keiho dounan kachunguva nalung ahanglhehtan ahi.
  </para>
</usx>
