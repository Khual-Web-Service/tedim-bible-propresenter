<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2PE" style="id">2 Peter</book>
  <para style="h">2 Peter</para>
  <para style="toc1">2 Peter</para>
  <para style="toc2">2 Peter</para>
  <para style="mt">2 Peter</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu Christa soh le solchah Simon Peter'in, Pathen le eihuh hinguva Jesu Christa chonphat vanga tahsan lutah kachan bang changho hengah:
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen le I-Pakaiyu Jesu hetna-a konin nachung uva lungsetle lungmon hapunin punghen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aloupina le aphatna-a eikoupau hetna vanga Pathen thahat chun hinna le Pathen ngaisahna lam thudolla thil jouse eipeh-u ahitai:
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hicheng vanga chu thutep lentah le manlutah chu eipeh jengu ahitai; hitia chu ngaichatna jeh-a vannoi leisetna um suhbohna-a kona chu nahoidoh uva, Pathen nunle khan chankhompi nahina dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche jehtah chun nanghon potthona kimkei pandoh-un, natahsanu chun phatna, naphatnao chun hetna;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nahetna-u chun tibah timthem, natibah timthemu chun thohhat, chule thohhat chun Pathen ngaisahna;
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathen ngaisahna chun sopi hepina, chule sopi hepina chun ngailutna sodoh hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu hichengse chu nangho-a auma, aum dimset jinga ahile, I-Pakaiyu Jesu Christa hetna thudolla nangho hatmo le ga beija naumsah lou dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin hicheng neilou chu amitchoa ahin, gamla mulou ahin, masanga achonset luiho chengse-a kona kisu ngim ahi chu asuhmil ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun, sopiteho, nangho nakikou nao le naki lhennao chu kichetsahna dingin kihabolun; nanghon hichu nabol uva ahile, a-imatih chana nalhuh lou dingu ahi:
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutia chu I-Pakaiyu le eihuh hingpao Jesu Christa tonsot lenggama chu lut theina thu letset tah-a nakipe dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche jeh chun nanghon hichenghi hejongleu chun, chule tu-a nangho-a uma thutah-a chun umdet jing jongleu chun, hicheng thudol hi nangho geldohsah jing ding ngaisah louva kaum louhel ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche pon in'a hi kaum laichanse-a, nangho chu geldohsah jinga hah jinga umsah dinghi adihlam in kagele.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu I-Pakaiyu Jesu Christan eihetsah banga, hiche pon in hi kadalhah vah ding ahi ti kahei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule kadalhah nung tengle hicheng thudol hi nageldoh jing theina dinguva jong kihabol kahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman Pakai Jesu Christa thuneina le ahung ding thu nangho kahetsah laija chu, lungthim thema suhto-a semthu thusim juija hilou kahipouve, Leng Chungnung loupitah ahije mittah-a mu-a hettohsahjoa kahibouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama hi ka-Chapa deitah ahi, achunga kalung alhai tangeije, tia Leng Chungnung loupina-a ahenga aw ahung lhuna chu, Pa Pathen'a kona choi-atle jabol changa ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Van'a kon hiche aw hung ging chu molsang theng chunga ama toh kaumuva kajah-u ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule themgaoho thu chu kichet chehna-a kahengu hung lhunga ahi; nangho chuche thua lunglut tah-a na-umu hi apha lheh jenge; jingkho ahung vah-a nalung sunguva jing niso ahung sodoh masangse-a, muthim lah salvah jing vah tobanga chingthei tah-a na-umu chu nabol hoi lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathen lekhabua gaothu kisei jouse hi koiman ama chang tuma ahilchet ahipoi ti hemasao vin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu malaija gaothu kiseidoh hochu mihem lungchama kona sohdoh-a ahipoi: ahin Pathen mitheng hon Lhagao Thengin amanchah dung juijuva aseiju ahibouve.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin miho lah-a themgao lhem asodohtah banga chu, nangho lah-a jong mihil lhem hung sohdoh-a, guhthima misumang thei thuhil ki dang ahinpoh lut dingu, amaho achopau Pakai tah jeng jong chu ajahda uva, chule poh phunga achunguva manthah na akiloi khum dingu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule mi tamtah-in amanthah nao lampi chu ahinjui dingu; amaho jeh-a chu thutah lampi hi seisetna hung umding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule kilosetna-a jou thua ki sumkol veina-a nahinnei dingu ahi; ahinla malaija patna achunguva thu kitan chu khongai sot lou, chule amanthah nau jong chu lulhu lou ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu Pathen'in vantil chonseho jengbon chu khen louhela, damuna ale lut jenga, athu-u kitan ding ngah-a kokhuh thima akhum jenga;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pathen ngaisah lou vannoi chunga twisang aletsah-a chu vannoi lui chu khen louhela, adang sagitoh chonphat thu seile-a Noah chubou akhena;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Sodom le Gomorrah khopi teni chu vutvai asosah-a, themmo chan na-a alekhupma, chule Pathen ngaisah louho chunga itobang ahung chuh ding vetsahna-a asema;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule mi engseho khan gitlouna-a kona thoh gentheija michonpha Lot chu ahuhhinga ahile:
  </para>
  <para style="p">
    <verse number="8" style="v" />(Ajehchu hiche michonpha chu amaho lah-a chenga, achonsetnao chu amua ajah-a, achonset jeh uva chu ama chonphat lung sunga chu niseh-a lungphamo lhehji-a ahi);
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakaiyin Pathen ngaisahho chu lhepna-a kona huhdohje ahen, chonpha louho chu thupi kitan ni kahse-a dinga talen matsah-a koije ahei:
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahideh-a kisuhbohna lam ngaicha-a tahsa lama chonteho le, gamvaipo nahsahmoho. Amaho chu ngol hanle ama lungchama chon ahiuvin, amahon loupina changho jengsan jong houset ding atijapouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vantil ho chu thahat le thilbol theija chungnungjo ahi jeng vangun, amaho dounan oimona thu Pakai anga alhut pouvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin hiteho vanghi lungel neilou sahemho tobanga achonnau dungjuija kimana kisumang ding ahiuvin, ahet phah louhelu thu chu aseiseu vin ahi; chule amaho asetnaova chu mangthah ding ahiuvin;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule amahon suna kivah nehnop hi nomsah na-a angaito jeh uva, chonphat louna tohman chu asan dingu ahi. Amaho chu boh beh le nol uma ahiuvin, nangho toh kivahna-a ankong aumkhom ji tengule adoha lungthim uva akisuboh jiuvin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Jon thanhoina dimset mit aneijun, chonsetna ngathei lou ahiuvin; mi lungdet louho ajol lhajiuve: alungu chu thangset bolna lama kichuh ahin, sapset chang chate ahiuve:
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon lamdih adalhaovin, lam hilouva avahmangun, chonphat louna thaman ngailu-a Beor chapa Baalam lampi chu ajuijun ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin ama chu achonkhel jeh chun pho sal-in aumin; pao theilou sangan chu mihem paova apaodoh-in themgaopa ngolna chu akhamtangin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitiho hi twi umlou twikul ahiuvin, khopi huijin asemmang meilhang ahiuve; muthim lhangkhal kiheh chu amaho dinga a-imatih chana dinga kikheh khol ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu amahon hamhoi thona thumanlou asei tengule, lamvaina-a umho lah-a kona hung jamdoh ho chu tahsa lam ngaichat huhna lama ajol lha jiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahon chamlen athutep jiuvin, ahinla amahotah kemmang soh ho ahiuve: ajeh chu mi jo-a aumna-a chun, soh-a akailut jiuvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai le huhhing-a Jesu Christa het vanga, vannoi leiset kisuhbohna tincheng ajamsan nunguva, chuche thenlouna-a akikhi oh kitnuva, jo-a aum kitnuva ahile, aumchan amasa sanga anunung chu sejocheh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajeh chu ahet nunguva, amaho kipe-a thupeh thenga kona akiheimang sangun, chonphat lampi chu ahet louhelu hile, amaho dinga phajoa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ui jin aloh lhahsa ajon kitjin, vohpi kisilngimsa jong bonlhoh lah-a kibolin akilejie, ti paochamtuh hi amaho chunga lhung ahitai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngaitahteho, keiman nangho lekha kahinthot hiche hi anina ahi; anigela chu nangho geldohsah na-a kona nalung thengu chu kahinsuh thou ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanghon malaija themgao thengho thusei chengsele, Pakai le Huhhingpa solchah keiho thupeh najahsao chu nageldoh jingna dinguva kahinsut ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amasan nanghon hiche hi heuvin, ni nunungle jontaina manga jontai hatteho hung umdoh ding ahiuve, amaho chu ama tahsa ngaichat lama chonuntin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahung dinga thutepna chu hoibaham? Iputeu ipateu athiuva kipat tu gei hin, thilsem jouse hila semtila aum ngai bangbangin aumnan, atiuva nahin jontai dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu amaho hicheho-a hi kihetmo sah uva ahin, malaipeh-a patna Pathen thusah-a vanho chengse le twi chunga le twinoija um leiset hohi um ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuche laija vannoi leiset chu twisanglen'in asuhmang ahitai:
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche thuma ma-a chu tulai van le leiset hi Pathen ngaisah louho thu kitanle akisuhmang niu geija dinga meija dinga kikheh kholla ahi ti hi,
  </para>
  <para style="p">
    <verse number="8" style="v" />ahin, sopi ngaiteho, nanghon hiche thuhi sumil loujenun, Pakai dingin ni khat chu kum sangkhat tobang ahin, kum sangkhat chu ni khat tobang ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi khattouvin geisang asah chu Pakai athutep lam dola geisang ahipoi, koima amangthah um louva mi jousen lung aheiman nading angaitoa, eiho jala khongai sot ahibouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amavang Pakai nikho chu janna gucha banga hung ding ahi; hiche ni chule vanho chengse ha gina ginglul lula manghel ding ahi, chule thilbul chengse meijin akah jola kavam gamhel ding ahi; chule vannoi leisetle asunga thil um jouse aboncha kavam sohkei ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chu chengse chu chutia mang ding ahile, nunle khan then lamle Pathen ngaisahna lama itobang mi nahi ding dol uham!
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen nikho hung lhung ding chu pontho tah-a kat jinga kinema umding dol ahi; hiche ni chu ahung lhun jeh-a vanho meija kong'a kavamhel ding, chule thilbul chengse meisa-a jolmang sohding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla eihon vang ama thutep dungjuija vanthah hole leithah kinema ingau ahi; hichea chu chonphatna chenga ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun, sopi ngaiteho, hicheng chu kat jinga nangho ama anga boh beh louhel le nolna beihela lungmonga nakimudoh theina dingun kihabolun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Pakai mi khongaisot hi huhhinga umna ahi ti gelun; isopiu deitah Paul'in jong ama kipe-a hetna dungjuija, chutobangma chu nangho henga ahinsutsa ahitai;
  </para>
  <para style="p">
    <verse number="16" style="v" />Alekhathot chengsea chu hiche thu chu aseija, chutobangma chu asut ahi, hichenga chun het hahsatahtah thu aume; hichu mi lunglhomho le lungdet louhon Pathen lekhabua thu dang dang angai koiji bangun, angai koijiuvin amale ama akisumang jiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun, ngaiteho, hichengse chu nahet masatsao bangin, kihongphauvin, achuti loule nangho jengjong michonseho lamvaina lama puimangin umun natin, napandet phapet lhaso khauvin nate.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin I-Pakaiyu le Huhhing-a Jesu Christa milungset le hetna-a khangtou jingun. Ama-a chun tu le tonsot geijin loupina umhen. Amen.
  </para>
</usx>
