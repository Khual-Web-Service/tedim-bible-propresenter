<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EZK" style="id">Ezekiel</book>
  <para style="h">Ezekiel</para>
  <para style="toc1">Ezekiel</para>
  <para style="toc2">Ezekiel</para>
  <para style="mt">Ezekiel</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun ahung hitin ahi, kum somthum lhinkum, lhali channa ani nga channin, sohchangho lah-a Chebar vadunglen panga kaumpet tah-in, vanho anakihongin chule keiman Pathen'a kon thilmuho kanamun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuche lhasung ninga channi, leng Jehoiachin sohchan kal akum nga channa-in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai thu chu kilangtah-in, Buzi chapa Ezekiel thempu henga, Chaldea miho gamsung Chebar vadunglen panga ahung lhungin, Pakai khut chu ama chunga ahung kingame.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin keiman kagahvetle, veuvin chimpei khat sahlama konin ahungdoh-in, meilom lentah khat achama vahjeng, akimvel vah pempum, chuche lailunga meilah-a kon chun a-eng dum banga vahjeng aumin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hicheho lailung tah-a kon chun ganhing toh kiloutah li ahungdoh-in, chule hichehi amaho melputdan chu ahi; amaho chun mihem melput tobang apuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule khatcheh-in mai li aneijuvin, chule khatcheh-in lhaving li aneijuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amaho keng khophang chu ajangpetnin, akeng khophang hou chu bongnou keng khophang tobang ahin; chule hicheho chu sum-eng kinotval bangin avalsetnin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amahon apang li uva alhaving hou noija chun mihem khut tobang aneicheh uvin; chule amaho li chun mai le lhaving aneicheh uve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Alhaving hou chu khatle khat akisumat cheh-in, amaho chu ache tengule kiheile louvin, abonchauvin jang petnin angat nalang uva ache jiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho li maiso melput dan chu, mihem maiso apucheh uvin, chule ajetlam panguva keipi bahkai maiso apu uvin; aveilam panguva bongchal maiso apu uvin; chule ali uvin mulaopi maiso jong apucheh uve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho maiso chu hitobang hi ahin, alhavinghou chu chunglam ngan akijal touvin, lhaving ni chu khatle khat akisumatnin, chule ni chun amaho tahsapum akhu khume.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amaho abonchauvin jangpetnin malama acheuvin, lhagao chena ding lam lama chun amaho acheuve; chule amaho ache tengule akiheile pouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ganhingho chu hitobang ahiuve, alimso dan chu song meihol kou lenglung abangin, chule thaomei vah jong abange. Hiche thaomei vah chu ganhingho lah-a achesuh achetouvin; chule meikou chu avahsetnin, meikouva kon chun kolphe asohdoh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule ganhingho chu kolphe vah bangin alhaijun, chule ahung kileuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun keiman ganhingho kavet petchun, veuvin leiset chunga um mai li nei ganhingho kom cheh-a chun, kangtalai kang khat cheh ahung ume.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche kangtalai kangho lim umdan le akisemdan chu khisong engdum abangin; chule amaho li hin kibahna khat aneijuve. Amaho limdan le amaho kisemdan chu, kangtalai kang lailung tah-a kangtalai kang um abange.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho ache tengule, apangli uvah acheuvin; amaho ache tengule akiheile pouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kangtalai kang kikol ho chu ahile, amaho chu asang behseh un tijatjat aum jengin; chule amaho li kimvela hiche kangtalai kang kol ho-a chun mit adimset jengin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule ganhingho chu ache tengule Kangtalai kang ho chun ajuijin, chule ganhingho chu leisetna kona dopsanga aumtengle, kangtalai kang hojong dopsangin aum jiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hoilam hile lhagao chenom nalam lama amaho acheuve; ajehchu chulam chu amaho lhagao chena ding chu ahin; chule amaho chutoh kangtalai kang chu dopsangin aume. Ijeh inem itile ganhingho lhagao chu kangtalai kang ho-a chu uma ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chucheho acheteng, hicheho acheuvin; chule chucheho adinteng, hicheho adinguvin; chule leisetna kona dopsanga aumteng, kangtalai kang ho chu amahotoh dopsangin aumuvin ahi. Ijeh inem itile ganhingho lhagao chu kangtalai kang ho-a chu uma ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule ganhingho luchunga vanthamjol banga umchu songval abangin, hichu alu chunguva akikhang jengin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hiche vanthamjol noija chun alhavinghou jangpetnin khatle khat akingat to uvin, atahsao pang khatlam chu lhaving nin akhu khumin, atahsao langkhat lampang chu lhaving ni ma-in akhu khumin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule amaho ache tengule, alhavinghou hugin chu twipiho gin tobang, Hatchung nungpen awgin tobang, thukisei awgin tobangle, janel ho husa gin tobangin kajan ahi. Amaho adin tengule alhavinghou chu amahon akoilha jiuvin ahin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amaho adinuva, alhavinghou atimlhah tengule, alu vumuva um vantham jola kon chun awgin khat ahung gingdoh jin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule alu vumuva vanthamjol um chunga chun laltouna tobang khat aumin, khisong dumjet to abangin; chule hiche laltouna tobang chunga chun mihem tobang khat aume.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule keiman akong chunglamse chu a-engdum tobang, asung akimvelse chu meikou bang jengin kamun; chule akonga pat anoilamse chu meikou tobang, akimvelse vah lenglung bangin kamun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Gojuh nikho-a meilhang lah-a lhagui lim kimu bang khun, akimvel chu avahpempum jengin ahi. Hiche chu Pakai loupi limso kilang chu ahi. Chuin hichu kamu phatnin, tolla kamai kasulut jengin, chule thu kisei awgin khat kajatan ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman kajah-a, Mihem chapa, nakengin dingdoh-in, chule keiman nahenga thu kasei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman kahenga thu asei phatnin lhagao chu kasunga ahung lutnin, chuin kahenga athusei chu kajah theina din, kakengin eidinsah-e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule aman kajah-a, Mihem chapa keima douna-a kiphinjing, thungailou Israel chate henga kasol nahi. Amahole apu apateuvin keima dounan tunikho geijin chonset abol jingun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu amahohi jumle jalam helou lungtah chate ahiuve. Keiman nangma kasol nahin, Pakai Pathen'in hitihin aseije, tia amaho naseipeh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahohin, ngaiju henlang ngaihih tajongleu, (ajehchu amahohi kiphin nom insung ahiuvin,) amaho lah-a themgao khat anaum nalaije ti ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangma mihem chapa, amaho chu kicha hih-in, athuseiju jong kicha hih-in; ling le khaovin nabom henlang, aipi lah-a cheng hijongle chun; amaho thungailou insung hijongleu, athuseijun kicha hih-in, chule amit vetnun jong lungthoi hih-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amahon ngaijuhen, ahiloule ngaihih jongleu, keima thuhi ahenguva naseitei ding ahi. Ijeh-inem itile amahohi mikiphin nomte mong ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin nangma mihem chapa, keiman nahenga kaseihi ngaijin; nangma chutobang thungailou insung bangin, thungailouvin umhih beh-in. Nakam hinkan, chule keiman kapehhi nen, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichun keiman kagahven ahile, veuvin, kahenga khut khat ahung kilhang doh-in, chule ven, hiche sunga chun lekhabu jol khat aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman hichu ka anga apha jal-in ahi, hichu asungle apoa kisun ahi. Hiche sunga chun kana le lunghemna chule dana thu akisune.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukal valin aman kahenga, Mihem chapa, namu chu nejengin; hiche lekhajol hi nen, chule chenlang Israel insung henga thu gaseijin, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hitichun keiman kakam kakan, chule aman chuche lekhajol chu einehsah tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman kahenga, Mihem chapa na oisunga lutsah-in, chule keiman kapeh hiche lekhajol hin nasung dimsah in, tin aseije. Hichun keiman kanen ahile, kakam sunga khoiju lhumin alhumin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman kahenga aseije, Mihem chapa, chen, Israel insung henga gachen, chule keima thuho hi amaho henga gaseijin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu gamdang paole pao hahsa mite henga kisol nahipon, ahinla Israel insung heng joh-a nangma kisola nahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu hetkhahlou paole ham tho nam mite leh pao hahsa nam mite henga kisola nahipoi. Tahbeh-in, amaho henga chun keiman nangma anasol leng, amaho chun nangma thu anangai diu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Israel insungin vang nangma thu angailou dingu ahi; ajehchu amahon keima thusei jong angailou dingu ahi. Ijeh-inem itile Israel insung pumpihi jachat helou ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ven, keiman amaho maitoh kitatto dinga namai kasuhtah-a, chule amaho chalpang toh kitatto dinga nachalpang kasuhtah ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman meituh song sanga tahjo thiltah bangin nachalpang kasempehtai. Amaho ginghih beh-in, amaho thungailou insung khat hijeng jongleu, amelput aumdanhou jeh-in nangma lunglhalou jenin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chukal valin, aman kahenga hitin asei kitnin, Mihem chapa, keiman nahenga kahinsei ding kathuho abonchan nalung sunga kisan lutnin lang, nanakhangin ngaijin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule chen, sohchanga um namite le achateu henga nangma galutnin lang, amahon ngaijuhen lang ngaihih jongleu, Pakai Pathen'in hitin aseije, tin amaho henga gaseijin lang gahilin, tin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin lhagaovin eilatouvin, kanung lama chun aw sangtah-a kisei thu khat kajan, hiche aw chun, Amun thenga Pakai loupi chu vahchoijin umhen, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujongle keiman ganhing ho lhavingho khatle khat akitoh khahto ginle, amaho koma um kangtalai kang ho kitol nasatah gin kajan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiti chun lhagaovin keima eilatoutan, chule eipui mangtan, chuin lung nommo tahle ka lhagao lunggim tah-in kachetai; ahivangin kachunga Pakai khut chu ahatnin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin keiman Chebar vadunglen panga cheng, Tel-abib'a sohchanga umho heng kalhungtan, chule keima amaho touna-a katouvin, kidang satah in amaho lah-a ni sagi kaumin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ni sagi kichainin ahitin ahi, hitichun Pakai thu chu kahenga ahung lhungin,
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihem chapa, keiman nangma Israel insung dinga avesui diuva kasem nahitai. Hijeh chun keima kamsunga kon thupot ngaijin, chule keima-a konin amaho gihsalin, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman mi khang gilou henga, nangma thonlouva nathi teiding ahi kati-a; nangman ama chu gihna pelouva, ahiloule agilou chu agitlouna lampiho-a kona ahinkho akihuhdohna dinga thu imacha ama gihna-a naseipeh loule; chutobang agiloupa chu akhansetna-a chu thitei ding ahin; amavang ama thisan chu keiman nangma khutna kahin ngeh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangman agiloupa chu nanagih nah-a, ama agitlouna-a konle agitlouna lampia kona akiheidoh loule, akhansetna-a chu thitei ding ahin; amavang nangman nahinna nakihuh doh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chukitle, michonpha chu, achonphatna-a kona kihei manga, gitlouna abolteng, keiman amasanga kipal lhuhna kakoija, ama thitei ding ahi; ajehchu nangman gihsalna nanapeh loujeh-a achonsetna-a thiding, chule achonphatna thilbolho chu kigeldoh lou ding ahitai; amavang ama thisan chu keiman nangma khutna kangeh ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeng jongle, nangman michonpha chu gihna napeh-a, chonphan chonset abolji poi nati-a, chonset bol louva aumle, thonlouva hingtei ding ahi; ajehchu ama chun kigihna asangin; nangman jong nahinna nakihuh doh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chukoma chun Pakai khut chu kachunga akingamin, chule aman kahenga, thoudoh inlang phaichama khun gachen, chule chukoma chu keiman nangma kakihoupi ding nahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin kakipatdoh-in, phaichama chun kachetai. Chuin veuvin, Chebar vadunglen panga kanamu loupina, Pakai loupina chu anadingin ahi. Hichun keiman tolla kamai kasulut tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichun lhagao chu kasunga ahung lutnin, kakengin eidin sah-in, chule keima eikihoupin, kajah-a, Chen, na insunga gaum chahbeh-in, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijongle Vo nangma mihem chapan, vetan, amahon nachunga khaohol ho ahinkoi diu, hicheho-a chu nakandiu ahin, chule amaho lah-a nagache dohle louding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keiman napaomona dingle amaho dinga aphohsalpao nahilouna dinga, nalei chu nadanga kabesah ding ahi. Ajehchu amaho thungailou insung ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla nahenga thu kasei tengle, keiman nakam kahona, chule nangman amaho henga, Pakai Pathen'in hitin aseije, tia nagasei ding; angainom pan angaiding, chule angainomlou pan angaida ding ahi. Ajehchu amahohi thungailou insung ahiuve.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihem chapa, nangman leingan kigoutah khat lanlang, hichu namasanga koijin, chule hiche chunga chun khopi lim, Jerusalem lim chu semin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hichu galmiho umkimvel sah inlang, hiche khopi dounan kulbang sah khumin, chule adounan molsang khat tundoh khumin lang, gebuh jong sah khumin, chule akimvela chun kulbang suhsetna manchah ho tung doh-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chukal valin nangman thihpheng tupeh khat lanlang, hichu nangmale hiche khopi kah-a chun thihbang kidal bangin dalin; chule hiche lam chu mai ngatnin, chule hichu ki-um kimvel ding, nangman naum kimvel ding ahi. Hichehi Israel insung dinga melchihna hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Naveilam pang delphan lumin, chule hiche chunga chun Israel insung khangitlouna ho chu koijin; chutobanga hiche chunga nalup nikho jat dungjuija chu nangman amaho khan gitlouna chu napohpeh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu anikho jat dungjuija ni jathum le somko, keiman nachunga akhansetnao kumho chu kakoi ahitai. Hitia hi nangman Israel insung khan gitlouna chu napoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangman hiho chu nasuhbulhit tengle, nangma najetlam panga nalup kitna, chule Judah insung khan gitlouna chu nisomli napoh ding ahi. Keiman nangma dinga nikhat chu kum khatna kasimpeh nahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh-a chu nangman Jerusalem ki-um kimvel lam chu namai ngat ding, chule naban chu nahodoh-a, hiche khopi douna-a chu gaothu naseiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ven, keiman khaohol ho-a kakanna, chule naki-um kimvelna nikhoho nasuhbei kahse-a, nangma langkhatna kona langkhatna kihei theilouva naum ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujongle nangman, suhlouchang le sakolchang, chule bepi le bepal, chule butun le lengmusel lan lang umbel khatna koijin, chule hicheho-a kon chun nasih-a nalup ding nikhoho dungjuijin changlhah kisemin, hichu nikho jathum le somko sunga chu nangman naneh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangman nikhatna nanehding anchu agihdan shekel somni hiding; chule aphat phatna hichu naneh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangman twi jong teptena neija nadon ding, hin dimkhat hopgupma kihom hopkhat hiding; hichu aphat phatna nadon ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman amaho mitmu dinga mihem'a kona hungdoh eh chu changlhah-a nakana, hichu sakol changa kisem changlhah banga naneh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin aseije, Hitobanga chu Israel chaten, keiman amaho kanodohna chidang namdangho lah-a chu suhbohsa changlhahho aneh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichun keiman, Pakai Pathen, vetan, kahinna suhboh-in ana um khapoi; ijeh inem itile kakhang dona pat tuchan geijin athikam, ahiloule akimaltelsa kiti kanehih laije; kakam sunga jong thet um saphe alutkha hih laijin ahi, tin kaseitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman kahenga aseijin, Ven, mihem eh khelin bong eh kape-e, nangman hichea chu changlhah nakisem ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chukalvalin aman kahenga aseijin, Mihem chapa, vetan, keiman Jerusalem'a changlhah hung kipohlutna bul chu kasuhtan ding; chule amahon changlhah agih-a ateova chule itcha tah-a aneh dingu; chule amahon twi jong teptena neija chule kidang satah-a adon dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutia chu amahon changlhah le twi ahin ngaichat uva, chule khatle khat kidatmoto diu, akhan gitlounao jeh-a mangthah diu ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule nangma, mihem chapa, chemcha hemthet khat kilah-in, samvoupa samchem kilah-in, chule hichun naluchang le nakhamul vouvin; chuteng atenadin khaikot lanlang, sam chu homkhenin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khopi akiumna nikhoho chu alhin tengle, hop thuma hopkhat chu khopi lailung tah-a meija nahal ding; chule hopthum-a hopkhat nalah-a, hichu chemcha khatna nasat bong ding; chule hopthum-a hopkhat chu hui lah-a nathejal ding; chule anungu chemjam'a kajui ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangman hicheho lah-a kona chu phabep khat nalah-a, chule hicheho chu naponsil monga nakhi ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuteng nangman hicheho chu nalahkit ding, chule hicheho chu meikong lailung tah-a naselutna, chule hicheho chu meisunga nahalvam ding ahi, ajehchu hichea kona chu meikou khat hungdoh-a, Israel insung pumpi sunga lutding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai Pathen'in hitin aseije, Hichehi Jerusalem ahi; Keiman amanu hi akimvela um namho le gamho lailung tah-a katundoh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amanun namdangho sangin kathutana hi gitlounan asodoh-in, chule akimvela um gamho sangin kadan kisunho chu gitlounan aha sodoh-in ahi. Ajehchu amahon kathutana hole kadan kisunho alapouvin, hicheho chu ajuipouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun Pakai Pathen'in hitin aseije, nangho nakimvel uva um namtin ho sanga napunjoh jeh-ule, kadan kisunho jong najui tahlou jeh-un; chule kathutanho jong nanit tahlou jeh-ule, nakimvel uva um namtin ho thutan ho dungjuija jong na natoh tahlou jeh-un;
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun Pakai Pathen'in hitin aseije, Ven, keima, keimatah ngeijong nangho douva pang kahitan, chule namtinho mitmu chang tah-a nalah uva thutanna kalhut ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keiman kanabol khahlou, chule atobang jong avela kabolkit louding chu, thet umtah nathilbol hou jeh-a nachung uva kabolding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh-a chu nalah uva paten chapate ahin neh uva, chule chapaten apateu ahin neh dingu; chule keiman nachunga thutanna kalhunsah ding, chule nalah uva ahingdoh amoh chengse chu abonchauva hui lah-a kathecheh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun, Pakai Pathen'in, keima hing jingjeng kahito lhonin, nangman kamun theng chu ningset umtahle, thilbohho jouse-a nasuhboh tah jeh-a, thonlouva keiman jong nangma ka kemsuh sah ding; kamitnin jong khen aneideh lou ding, khotona kiti imacha jong kaneilou ding ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangma-a hopthum-a hopkhat chu hise-a thidingu, chule nalah tah-a amaho chu kella suhmanga umdiu; chule hopthum-a hopkhat chu nakimvela chemjam'a lou dingu; chule hopthum-a hopkhat chu keiman huija kathecheh ding, chule chemjam'a kanungdel ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutia chu kalunghana chu kasuh bulhitna, kalungsatna achunguva chuding, chuteng kalungmon ding ahi, chutia chu kalungsatna achunguva kabulhit teng, Pakai kitipa keiman katom panna-a hichehi kasei ahi ahetdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chukalvala keiman nakimvela um namho lah le achele jouse mitmu-a, khopi chimsa le noise umtah-a kasemdoh ding nahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman lunghanna le lungsat na-a, chule lungsa tah-a phona-a nachunga thutanna kahinnei tengle, nakimvela um namtin ho dinga noise umtah le isahlou, kihilna le datmo um nahiding ahi. Keima Pakaiyin kaseidoh ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman amaho dinga manthah na, chule nangma sumang dinga kel lhahna thalchang giloutah kahinsol tengle; keiman nachung uva kel lhahna kapunsah ding, nachang lhah-u hungkondohna chu kasuhtan ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutia chu keiman kel le gamsa gilou nachung uva kahinlan sah ding, hicheho chun nachateo ahinsuhmang ding; chule hisele thisanin nangma nahinphah ding; chule keiman chemjam chu nachunga kahinchuhsah ding ahi. Keima Pakai Pathen'in kaseidoh ahitai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Israel molsang ho lam nganlang, amaho dounan gaothu seijin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho Israel molsang ho, Pakai Pathen thu ngaijun; Pakai Pathen'in molsang ho, lhangho, vadungho chule phaicham ho henga hitin aseije; Vetan keima, keimatah ngeijin nangho chunga chemjam kahin chuhsah ding, chule keiman namun sang hou chu kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule namaicham hou chu hung kamhel ding, semthu milimho jong suhsetna umding; chule keiman akithatsa namite chu namilimhou masanga kaselhah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman Israel chate thilongho chu alim semthuhou angsunga kalelhah ding; chule naguhou chu namaicham hou kimvela kathechap jeng ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Namaicham hou akeohel le akamhela aumna ding, na pathen semthuhou suhkeh le suhmanga aum nading, namilim semthuhou satlhah-a auma, chule nanatoh hou suhmanga aum theina dinga; nangho chenna mun jouse-a khopiho chu ahom keuva kilha ding, chule munsang jouse chu kamhela umding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule akithat ho chu nalah tah uva lhujeng ding ahiuvin, chuteng keima Pakai chu kahi nahetdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahijeng vangin nangho gamho-a thecheh-a nahung umtengule, namtinho lah-a chemjam'a asohcha phabep nanghon nanei theina dinguva keiman ahingdoh amoh honkhat kadalhah ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nalah uva asohchase vang chun gal hinga akikai lutna lam lamu namtinho lah-a chu keima eihin geldoh jing dingu ahi, ajehchu keija kona anapetmang jonlung poho lungsung, chule amit hou jonmit po-a alim semthuhou juiho chutoh kakikhen ahitai. Chule amaho akisuh bohnao jouse-a agilou anaboldoh jouseu jeh-a chu amahole amaho kikidah ding ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule keima Pakai kahi leh, hiche thilse amaho chunga kahinbol ding chu moh-a kasei ahipoi ti amahon ahetdiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai Pathen'in hitihin aseije, Nakhutnin jepmin, chule nakengin lhonlang seijin, ohe, ada ahiuve! ijeh inem itile Israel insung gilou thet umtahho jeh-a, amaho chemjam'a, kella, chule hise-a lougam ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Koihileh gamlatah-a umchu hise-a thitei ding, chule koihile anaija uma chu chemjam'a loutei ding, chule koihile aumden le umkimvel khuma uma chu kella thitei ding ahiuve. Hiti ahi keiman kalungsatna chu amaho chunga kamolso ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutengle amilimhou hou lah-a, amaichamu kimvela, lhangsung chung tina, molsang ho chungvum tina, chule thinghing phungnoi tina, gangpi phungnoi tina, amilimhou henga gimnamtui apehnao munho jouse-a chu akithat ho sechu ahung umtengle, nanghon keima Pakai kahi nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiti ahi keiman achunguva kakhut kalhah-a, agamu kamhela kalha ding; chule Diblath lama gamthip sanga jong kamhel jo-a kalha ding ahi. Chule amahon keima Pakai kahi chu eihin hetdoh dingu ahi, ati.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche chungchon chun Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma mihem chapa, Pakai Pathen'in Israel gam henga hiti jonghin aseije; Achaina, achaina chu gam ningliho chunga ahung lhungtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuhin achaina chu nangma chunga hunglhunga ahitai, chule keiman nachunga kalunghana kahin lhunsah ding, chule nalam lhah dungjuija nathu katan ding ahi, chule thet umtah nahinaho jouse chu nachunga kalethuh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule kamitnin nangma nakhehchah louding, khotona jong kaneilou ding ahi. Ahivangin nalam lhah ho keiman kalethuh cheh ding, chule thet umtah nahina ho chu nalah tah-a umding; chuteng nangman Pakai kahi chu nahetdoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitihin Pakai Pathen'in aseije, Veuvin, thilgilou, thilgilou sehseh bou ahunge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Achaina chu ahungin, achaina chu ahung lhungtan; hichun nangma navelhi jingin, ven, hichu ahung lhungtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo gamsunga cheng nangma, jingkah chun nahinphatan, phat chu ahung lhungtai; hamsetna nikho chu ahung naitai, molsang ho gin athongkit tapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tu-a chomlou kah-a nachunga kalungsatna kahinbuhlhah ding, chule kalunghana chu nachunga kamolso ding ahi. Chule keiman nalam lhah dungjuija nachunga thu katan ding, chule thet umtah nahinaho jouse jeh-a kalethuh ding nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule kamit nin nangma nakhehcha pontin, keiman khotona jong kanei louding ahi. Nalam lhah hole nalah tah uva thet umtah nahinaho dungjuija nangma kahinlethuh ding; chutengle nangman najepma chu Pakai keima kahi hi nahin hetding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vetan nikho chu, vetan ahunglhunga ahitai. Jingkah chu achemangtan; tenggol pahcha bangin apah lhatan, kiletsahna chu pahchamum bangin amum dohtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hunam nahi gitlouna tenggolin ahung umdoh tan; amaho khatcha umden loudiu, ahaona jouseu ahin, anei agou jouse jong khatcha umden louding; chujongle koiman amaho pul adou louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Phat chu ahung lhungtan nikho chu ahung naitai. Thil chopa chu kipah hihhen, thil johpa jong lunghem hihhen; ajehchu amihonpiu chunga lunghanna chua ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ijeh-inem itile amaho hingnalai jongleu, ajohdohsao chu ahenguva hungkile kit louding ahi. Ajehchu gaothilmu hin amihonpiu jouse atongkha cheh-in, hichu kile kit louhel ding ahi; chujongle khan gitlouna-a hingjouse koima ama le ama thahat kipethei louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amahon amijouse gotsa ahitheinan sumkon amut taovin; ahinla koimacha galmun jona chea aumpoi. Ajehchu kalunghana hi amihonpiu chunga chu chua ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chemjam chu polama aumin, natset le kellhah chu asunga aume; loujaova um chu chemjamin thintin, chule khopi sumga um chu kel le natsetna thiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla alah uva kona jamdoh ho chu sohchao vintin, phaicham vakhuho banga molsang ho chunga umdiu, abonchauva amacheh khan gitlouna alunghempi diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khut jouse chu ngoijin tin, chule khup jouse chu twi banga lhoplha ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amahon khaodip pon jong akigah dingu, chule tijatnan atoma, amaiju jum-a, aluchanghou tolsoh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahon adangka hou lamlena aselhah dingu, asana hou jong akiladoh dingu ahi. Pakai lunghanna nikho nile adangka houle asanahou chun amaho alhatdoh joulou dingu ahi. Hicheho chun ahinkhou jong alungkimsah joulou ding, a-oiju jong avasah joulou ding ahi. Ajehchu hicheho chu akhan gitlou naova akipalnao hija ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Akivona hoina dingun, amaho lultah in akijemun; ahinla hicheho-a chun akisuhboh nao amilimhou, chule kidah umtah thilho chu asemuve. Hijeh-a chu amaho-a kona kakoi gamlat ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule keiman hiche chu hetlou miho khutna kivahna dinga kapeh-a, chule leiset mikhang gilouho henga galthila kapeh ding; chule amahon hichu asuhboh dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kamai amaho-a kona kaheimang ding, chule amahon kamun theng chu ahinsuhboh dingu ahi. Ijeh inem itile gucha michomho hiche sunga chu lut uva, chule hichu asuhboh dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khaokol vuikhat semin, ijeh-inem itile gamsung chu thisan kisona gitlouna-in adiptan; chule khopi chu hunamin adiptai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh-a chu keiman Pathen helou lah-a aphamopen chu kahinpui ding, amahon a-inhou chu alodiu, athahatnao kiloupisahna jong kasuhbei ding; chule amuntheng hou chu suhboh-a umding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Manthah na ahung lhungtai; amahon chamna ahinhol dingu, amavang chamna umlou helding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Setna chunga setna hunglhung ding, chule thuthang chunga thuthang chuding; chuteng amahon themgao thilmu ahin holdingu; ahivanga danthu chu thempu-a kona, chule thumop chu upaho-a kona mangsoh ding ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lengpa chu lunghem ding, leng chapa jong manthah na-a kivon ding, chule gamsung mite khut ho chu ngoilha ding ahi. Keiman amaho achonnau dungjuija kabola, achan dinguva lom dungjuija athu-u katan ding; chuteng amahon keima Pakai kahi chu ahet dingu ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule kumgup channa, alhagup channa, chule hiche lhasung ninga nin, keima ka in sunga katouvin; chule Judah upaho ka-anga atou laijun, Pakai Pathen khut chu keima chunga ahung chun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun kaven ahile, veuvin, meikou limso bangjeng, akonga pat noilamse meikou; chule akonga pat chunglamse chu lhe lahlah-a a-engdum tobang vouso kamun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman khutlim khat ahin lhahdoh-in, chule kaluchunga kasam lomkhatnin eimanin; chule lhagaovin leile van kah-a eidom touvin, Pathen gaothil musahna-a Jerusalem'a kotpi sungnungjo sahlam nga kotphung, thangthipna milim touna, thangthipna dinga lunghansahna touna chu eihin lhuttan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule veuvin, phaichama gaothilmu kamu dungjuijin, Israel Pathen loupi chamkimna chu hia chun anaume.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun aman kahenga, Mihem chapa, tun sahlam ngan gakhodah-in, eiti. Hitichun keima sahlam ngan kagakhodah-in ahile, veuvin, maicham kotpi sahlam pang lutna-a chun thangthipna milim aume.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman kahenga aseibe kitnin, Mihem chapa, hiche hohin ipi abolu ahi namu em? Kamunthenga kona kagamlat nadinga Israel insungin nasatah-a thet um hilai mun'a aboluhi? Ahinla nangma gakihei kit nin, chutile nangman thet umcheh namukit ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman keima hongsung kotna chun eihin puijin, chuin keiman kagahven ahile, veuvin, banga chun ahom khat anaume.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin aman kahenga, Mihem chapa, bang chu lai temin eitin; chuin bang chu kalaija ahile, kotkhah kamu doh-e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman kahenga, Lutnin, chule hikoma chun khangitlouna thet umtah abolu chu gaven eiti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun keima kalutnin ahile, a-opma kithol ganhing jouse, chule thet umtah gamsaho, Israel insung semthu milimho akimvela bangho-a jihtho-a aum chu kagamun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amaho anga chun malaija Israel insungmi pasal somsagi hochu adinguvin, chule amaho lailung tah-a chun Shaphan chapa Jaazaniah chu adingin, mitinin akhutna ama lhengcheh akichoijun; chule gimnamtui meikhulom satah chu chunglama akal touve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin aman kahenga hitin seije, Mihem chapa, malaija Israel insung miten muthim lah-a ipi abol, chule mitinin ama ama lunggelna indan sunga ipi abolu namu em? Ajehchu amahon, Pakaiyin eimupouve, Pakaiyin leiset adalhatai atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman kahenga hitin jong aseije, Gah kiheikit tadin, chutile amaho thilbol thet umjocheh namu ding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin aman keima Pakai in kotpi sahlampang nga-ah kotna chun eihin puitan; chule veuvin, hia chun Tammuz dinga kap numei ho anatouvun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin aman kahenga aseijin, Vo mihem chapa, nangman hichehi namunah em? Nangma gakihei kitle chun hicheho sanga thet umjocheh namu ding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman Pakai indan sungnungjoa eipui lutnin ahile, veuvin, Pakai houin kotphung, hongcha le maicham kikah-a chun mi somni le nga, Pakai houin nung ngatna, amaiju solam ngacheh aumu vin; amahon solam ngan nisa ahouvun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin aman kahenga aseije, Vo mihem chapa, hichehi namutah em? Judah insungin hilai mun'a abolu thet umtahho hi thil neocha hintem? Ijeh inem itile amahon gamsung hi hunam adiptauvin, chule amaho keima phinse-a lunghansah din ahung kileuve. Ven, amahon abah chu anahkuiju toh asutouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh-a chu kenjong lungsa tah-a kabol ding; kamitna jong kadeplou ding, hejong kahepi louding; chule amaho awsang tah-in kana benga kap jongleu, kangaipeh dehlou dingu ahi, ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aman kana benga aw sangtah-in asamin, Khopi dunga thunei ho chu hinnailut sah-in, chule amitakipmin akhutna suhsetna amanchah cheh kichoihen, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule, veuvin, sahlam panga um kotpi sangjo lama konin mi gup ahunguvin, amitinin akhutnuva mithana manchah achoijun; chule amaho lah-a khat chu tupat ponin akivonin, chule apanga lekha jihho lekhatwi thei khat akikhaije. Chuin amaho achelutnun, sum eng maicham koma adingun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Cherub chunga um Israel Pathen loupina chu kotphung geijin akitol toutan ahi. Chuin aman tupatpon kivon apanga lekha jihho lekhatwi thei khai mipa chu agah kouvin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakai chun ama henga hitin aseije, Khopi lailung, Jerusalem lailung jotpaijin lang, alah uva thet umtah kibol jeh-a khoisa-a kap ho dehpanga melchihna nata ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keima jah dingin adangho henga aseijin, khopi sunga chun amanung juijun lang, nakhut lha uvin, chule namitnun demchah hih-un, khotona jong neihih un, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ateh akhang, numei ho le chapang neoho, chule nupiho thatgam keijun, ahinla koihile achunga melchihna umchan chu ganai hih-un; chule kamunthenga konhin panjengun, ati. Hichun amahon inmaija um tehse ho-a chun apanpai jeng taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman amaho henga, In chu suboh unlang, hongsungho chu akithat ho-a chun dipmun; chule nangho kondoh-un, ati. Chuin amaho akondoh-un, khopi sunga miho chu athat taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi, amahon amaho atha laitah-un, keima kahoidohtan, hitichun keima kaboh khupmin kalhun, kapengin, kaseije, O Pakai Pathen, Jerusalem chunga nalungsatna nasunlhah na-a hi, Israel lah-a amohho jouse jonghi nasuhmang sohding hitam? kati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichun aman kahenga, Israel le Judah insung khan gitlounahi alen valtai, chule gamsung thisan adimin, khopisung khelna-in adimtan ahi. Ajehchu amahon, Pakaiyin leiset adalhatai, chule Pakaiyin amutapoi, atiuve, tin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kei hijong leng, kamitnin adepchah lou ding, khotona jong keiman kaneilou ding, akiman chahnao alu chunguva kalethuh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule, veuvin, tupat pon kivon, apanga lekha jihho lakhatwi thei khai mipa chun, athu chu keima neithupeh bangin kaboltai, tin alhut tai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin keiman kagahven ahile, Cherub ho luchunga um vanthamjol lah-a chun, khisong dumjet laltouna lhehlheh khat aume.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amapa chun tupat pona kivon mipa jah-a chun thu aseijin, chule hitin ati, Cherub noitah-a kangtalai kangho kikah-a chun chelutnin, chule Cherub ho kah-a konin songmeihol nakhut dimsetnin hamdoh-in lang, hicheho chu khopi chunga gathe jah-in, ati. Chuin amapa chu kamuta-in achelut tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun mipa achelut phatnin Cherub ho chu chuche in jetlam panga chun adingtauvin; chule inhong sungnung chu meilom'in adimtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakai loupina chu Cherub'a kon chun akaltouvin, chule in lutna kotchunga chun adingtan; chule a-in chu meilom adimin, chule ahongsung chu Pakai loupina vah chun alosohtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Cherub ho lhaving gin chu Hat chungnung Pathen'in thu aseitenga a-awgin bangin, in ponung geijin akijan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Cherub hole kangtalai kang kikah-a kona mei-am galan tia tupat ponnema kivonpa henga thu apeh chun ahitin ahi; chujouvin ama alutnin kangtalai kangho koma chun agadingtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Cherub khatnin, Cherub ho kahlah-a kon chun Cherub ho kahlah-a um meikou lama chun akhut ahinlhang doh-in, chuin hichu alan, chule tupat ponnema kivon mipa khutna akoijin ahile, amapan hichu alan achedohtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin hiche Cherub ho lhaving noija chun mihem khut tobang khat ahungdohtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keiman kagahvet phatnin, veuvin, Cherub ho panga chun kangtalai kang li, Cherub khat panga kangtalai kang khat, chule Cherub dang khat panga kangtalai kang dang khat aume. Chule hiche kangtalai kang ho limdan chu khisong engdumtoh abangin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule kangtalai kangho limso dan chu, aliuvin kibahna khat aneijuve, hichu kangtalai kang khat lailung tah-a kangtalai kang khat kibut abangin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho ache tengule amaho apang li in acheuvin; amaho achepumun akiheile pouve, amavang aluchangun avetna lama lamu amahon ajuijuvin; amaho achepumun akiheile pouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amaho tahsa pumpi, atungtunhou, akhuthou, alhavinghou, chule kangtalai kang, chule ali uva aneiju kangtalai kangho geijin akimveluchu mitjeng adimsetnin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kangtalai kangho chu ahile, keima jah in, Vo kangtalai kang tin akisame.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule khatcheh in mai li aneijuvin; mai masa chu Cherub mai, mai nina chu mihem mai, chule athumna chu keipi bahkai mai ahin, chule alina chu mulaopi mai ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Cherub ho chu dopsangin aumtaove. Hiche ganhing hi Chebar vadunglen panga kanamu chu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Cherub ho chu acheteng kangtalai kangho chun amaho ajuijuve; chule Cherub hon leisetna kon kaltouving tia alhavinghou adoptou tengule, hiche kangtalai kangho jonghi amaho panga konin akiheile pouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho adin tengule hicheho adinguvin, chule amaho dopsanga aum tengule, hicheho jonghi amahole amaho akidomsang jiuve. Ajehchu ganhing lhagao chu amaho sunga uma ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin Pakai loupina chu chuche in kotphunga kon chun achemangin Cherub ho chunga agadingtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin kamitmu tah-in Cherub hon alhavinghou adomsangun, leisetna konin akaltou taove. Amaho achedoh phat chun kangtalai kangho jong apanguva abeh-in, chule khatcheh chu Pakai in solam kotpi phunga adingcheh uvin; chule Israel Pathen loupina chu amaho chunga aume.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichehi ganhing, Israel Pathen noija Chebar vadunglen panga keiman kanamu chu ahi. Chule amaho chu Cherubim ahi ti kahei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khatcheh in mai li aneicheh uvin, chule khatcheh in lhaving li aneicheh-un, chule alhavinghou noija mihem khut tobang aumcheh-e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule amaisou hung kilah chu Chebar vadunglen panga kamu tobang maiso mama chu ahin, chule amaho malama jangpetnin ache cheh uve.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin lhagaovin keima eidom touvin, chule Pakai in solam kotpi, solam maingatna chun eilhuttai. Chule veuvin, kotpi kotphunga chun mi somni le nga aumin, amaho lah-a chun keiman mipi ho pipui Azur chapa Jaazaniah chule Benaiah chapa Pelatiah chu kamun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun aman kajah-a aseijin, Mihem chapa, amahohi thilphalou gong miho, chule hiche khopi sunga thil gilou thumop leho chu ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahohin, phat chu anai hihlaije, eihon inho satadiu hite, hiche khopihi khangbel len chu ahin, chule eiho asaphe chu hiuhite, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun amaho dounan gaovin, Vo mihem chapa, gaovin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakai lhagao chu kachunga ahungchun, chule kajah-a aseijin, Seijin; Pakaiyin hitin aseije; Vo Israel insung, nanghon hitihin naseitaove; ajehchu keiman nalung sunguva hunglut thil chu abonin kahesoh keijin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon khopi sunga mihem tampi nathat taovin, chule nanghon khosung lamlen jouse mithi nadip taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun Pakai Pathen'in hitihin aseije; Nanghon namitha hou khopi lailung tah-a nalupsah hou chu sa chu ahiuvin, hiche khopi hi khangbel len chu ahi. Ahivangin keiman hiche lahtah-a kona nangho kapuidohtei ding nahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon chemjam chu nakichaove; chule keiman nangho chunga chemjam khat kahin chuhsah ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keiman hiche lailung tah-a kona nangho kapuidoh ding, chule nangho hetlou miho khutna kapeh doh-a, chule nalah uva thu katan ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangho chemjam'a nalou dingu; keiman Israel gamgi-a nathu katan ding, chule nanghon keima Pakai chu kahi ti nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche khopihi nangho khangbel chu hilouhel ding, alailungtah-a sa jong chu nangho nahilouhel dingu ahi; amavang Israel gamgi-a nachung thu katan ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nanghon keima Pakai chu kahi ti nahet dingu ahi. Ajehchu nangho kadan kisun ho-a nache tapouvin, kathutanho jong natongdih pouvin, ahinla Pathen helou nakimvel uva umho umdan bangin nanghon naboljo taove, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahung hitin ahi, keiman gaothu kasei petnin, Benaiah chapa Pelatiah chu athitai. Chuin kalhun kamai tolla kasulutnin, aw gingtah-in ka pengin, Ohe Pakai Pathen, nangman Israel ho lah-a ahingdoh amoh hohi nasuh manghel jeng ding hitam! tin kaseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai thu chu keima henga ahung kitnin, hitin ati,
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihem chapa, nasopi ho, nasopi ho mongmong, na-insung miho, chule Israel insung pumpi jouse chungchanga hi ahi Jerusalem'a cheng miten, Nangho Pakaiya konin gamlaovin: hiche gamhi keiho lodinga eikipeuva ahi, tia aseina chu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun seijin, Pakai Pathen'in aseije; Keiman amaho gamlatah-a Pathen helou miho lah-a lehdoh jengjong leng, chule keiman amaho gamdang danga thecheh jengjong leng, alhunao gamho-a chu amaho dinga keima muntheng neokhat tobang kahiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun seijin, Pakai Pathen'in hitihin aseije; keiman nangho mipi ho lah-a kona kachopkhom dingu, nakithe chehnao gamsungho-a kon kapuikhom dingu, chule keiman Israel gam chu nangho kapeh dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amaho khulama hungdingu, chule amahon hichea kona chu, chua um ningset umtah thilho jousele thet umtahho chu alahdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule keiman amaho chu lungthim khat kapeh ding, chule nasunguva lhagao thah khat kakoipeh dingu; chule keiman atahsaova kona song banga tah alungchangu chu kalah doh-a, chule amaho chu tahsa phe-a kasem lungchang kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu amahon kadan kisun ho ajuijuva, kachonna danho anitdiu, chule hicheho chu anatoh-a atohdoh dingu; chutengle amaho chu kamite hiuva, keima amaho Pathen kahi ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla ningset umtah le thet umtah thil ho lama alungu chesahho vang chu, keiman aluchung cheh uva achenau lampi chu kalethuh ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujouvin Cherub ho chun alhavinghou ajah touvun, chule kangtalai kangho apanguva abeh-in; chule Israel Pathen loupina chu amaho chungvuma aume.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakai loupina chu khopi lailung tah-a kon chun achetouvin; chule khopi solama um molsang chunga chun adingtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche nunghin lhagao chun eilatouvin, chule gaothil muna-in Pathen lhagaovin Chaldea gama gal hinga kikaiho henga eipuitan ahi. Hitichun keiman thilmu kanamu chu keija konin achetoutai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin keiman Pakaiyin eimusah thilho jouse chu gal hinga kikaiho henga kaseisoh keijin ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu jong kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, nangma kiphinjing insung lahtah-a chenga nahi; amahon mun'a ding mit aneijun, amuthei pouvin; jahna ding kol aneijun, ajathei pouve; ajehchu amaho kiphinjing insung ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun mihem chapa, nakichon doh nadingin nathilkeo kigon tupmin, chule amaho mitmun sunlai tah-in kichondoh-in; chule nangma naumna mun'a kona munchom dang khatna amaho mitmu-a nakichon doh ding ahi. Amaho thungailou insung hijongleu, angaito maithei dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujouteng nangman sunlai tah-a nathilkeuho chu amaho mitmu tah-a kichondohna thilkeu banga nahinpoh ding; chule nangma amaho mitmu tah-a nilhah tahle gal hinga kikailut ho che banga nachedoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman amaho mitmu tah-a bang chu natuh vang paiding, chule chutia chu napohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho mitmu tah-a nangman hichu nalengkou teni chunga napoh-a, chule hichu khomu chipchet tahle napohdoh ding, tol namuthei louna dinga nangman namai nakikhu ding ahi; ajehchu keiman Israel insung dinga melchihna khatna katun nahitai, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin keiman eikithupeh bangin kaboltai, keiman sunlaitah in kathilkeoho chu gal hinga kikaiho thilkeo bangin kahin podoh tan, chule nilhah lamin kakhut tah-in bang chu katuvang paijin, keiman hichu khomut chipchep nin kapodoh-in, amaho mitmu tah-in kalengkou chunga kapun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin jingkah in Pakai thu kahenga ahung lhungin, hitin ati,
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihem chapa, Israel insung thungailou insung chun nahenga, Ipi nabol ham tia asei hilouham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho henga nangman hitin seijin, Hitihin Pakai Pathen'in aseije; hiche pohgih hi Jerusalem vaipopa le, amaho lah-a um Israel insung pumpi vetsahna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Seijin, keima nangho dinga melchihna kahin; keiman kabol banga amaho henga jong kabolding ahi. Amaho chondoh-in umuntin, chule sohchang dinga cheding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule alah uva leng chapa chun khomut chipchep tengle athilkeoho alengkouva aputna chedoh ding; amahon hicheho chu pohdohna dinga bang chu atuhvangpai dingu; ama chun amitna tol amu theilouna dinga amai akikhu ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman kalen jong achunga kajal ding, chule ama chu kathangkola ohding; chule keiman ama chu Chaldea mite gam Babylon kalhut ding; chukoma chu ama thi ding, hijongle hichu amulou ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule keiman ama panpi dinga ama kimvela umho jousele, ama galsat mihon ho chu hui nunna channa kathecheh ding; chule keiman amaho chemjam'a kanungdel ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman amaho namtin lah-a kathecheh-a, chule gamsungho-a kasuhcheh tengle, amahon keima Pakai kahi chu akihet dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahijeng vanga amahon agalhun nahou Pathen helouho lah-a thet umtah ahinahou akiphondoh theina dinguva, keiman amaho lah-a themkhat chemjam'a kona, kella kona, chule hise-a kona kakhendoh ding; chule amahon keima Pakai kahi ahin het dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chukalvalin Pakai thu chu kahenga ahungin, aseije,
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihem chapa na-anneh chu kihot pumpumin nenlang, natwi chu kithing thingpumin, chingthei tah-in donin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule gamsung mipi ho henga seijin, Jerusalem le Israel gamsunga chengho Pakai Pathen'in hitin aseije; agam sunguva chengho jouse hunam thilbol jeh-a, asunga chengjouse-a kona kamhela aumtheina dinguva; a-anneh-u chingthei tah-a aneh dingu, chule atuiju kidangsa tah-a adon dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule mihem chenna khopiho chu manlou sohding, chule gamsung chu kamhel ding; chule nanghon keima Pakai kahi chu nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihem chapa, nanghon Israel gamsunga naneiju thuchih, Nikhoho chu akisaosah-in, chule thilmu jouse athontai, tia kiseija chu ipi kiseina ham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun amaho chu seipeh-in, Pakai Pathen'in hitihin aseije; Keiman hiche thuchih hi kasuhbei ding, chule amahon hichehi Israel sunga thuchih-a amankit tah loudiu ahitai; amavang, Nikhoho ahung naijin, gaothilmu jouse ahung guilhungtai, tin amaho seipeh-in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu pannabei gaothilmu le joule nala Pathen thu kisei kiti himhim chu Israel insunga umkit talou ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu keima Pakai kahin; keiman kaseiding, chule keiman kaseidoh ding thuho chu hung guilhungtei ding; hichu geisang louding ahitai. Ajehchu vo kiphinhat insung, nangho nikho sunga hi keiman athu chu kaseiding, chule hichu katohdoh ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakai thu chu avelin kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihem chapa, ven, Israel insung miten hitin aseijuve, Amapan gaova thil amuho ahunglhun nading nikho tampi avat nalaije, chule khonung peh-a hung guilhung ding thua gaothu aseimasah ahibouve, atiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun amaho henga seipeh-in, Pakai Pathen'in hitin aseije, kathuho khatchabeh jong kisuhsaobe louding, amavang keiman kaseidoh thu chu tohdoh-a umding ahitai, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai thu chu kahenga ahung lhungin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Gaothu seija Israel themgaoho, amaho lungdei deija gaothu seidoh ho dounan gaothu hitihin seijin, Nanghon Pakai thu chu ngaijun;
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai Pathen'in hitihin aseije, Ohe, ama lhagao lunggela chonna chule ima muneilou themgao ngol hochu ada nahiuve!
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Israel, nathemgao ho vang neldi gama sial ho bangbep ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangho a-onglaiho-a nachetou pouvin, chujongle Pakai nikho tengle galkisatna-a Israel insunga din theinadin tho nakai pouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon pannabei amuvin, jouva aisan ahiuvin, Pakaiyin aseije, atiuve: ahinla Pakaiyin amaho asolpoi. Chule amahon athusei houchu kisudet ding ahi tin midangho akinepsah uve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon pannabei gaothil namu-u hilou ham? Chule nanghon jouva aisan nathu nanaseileu hilouham? Nanghon hichu Pakaiyin aseije nati uvin; ahinla keiman kanaseipoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun Pakai Pathen'in hitin aseije, nanghon pannabei nana seijuvin, chule jouthu jeng namu uve; veuvin, hijeh-a chu keima nang hotoh kidouva kahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule kakhut hi pannabei jeng mu-a themgaoho chungle jouva aisanho chunga kachuhsah ding ahi. Amaho chu kamite kiloikhomna-a lhalou dingu, Israel insung kisutna-a jong amahohi kisun loudingu, chule Israel gamsunga jong lutlou dingu ahi; chutengle nanghon keima Pakai Pathen kahi nahetdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu amahon kamite chu chamna aume tin ajoulhep mun, ahin chamna aumpon; chule khatnin bang khat atungdoh-in, chule ven, adanghon hichu chilminlou leingan nin aloijol uve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chilminlou leingana loijol ho henga seipeh-in, Hichu lhutei ding ahi; gohong longlet hela hung juding; chule, O gelchanglen ho, nangho nahung lhah dingu; chule hichu huipi leh gopin asuhtel ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ven, bang chu ahunglhuh tengle, chilminlou leingana naloi bang chu hoilamba hitam? tia kiseilou dingham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; Keiman kalungsatna-a hichu gopi leh huipi-a kasuhchim ding ahin; hiche suhmangna dinga chu kalunghana gohong juh-a longlet hela juding; chule kalungsatna gelchang lentah ho-a juding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitia chu nanghon chilminlou leingana naloijolu bang chu kasuhchim ding akitunna chu holdoh-a aumna dinga hichu toltoh kasuhmat ding, chule hichu lhutei ding, chule hicheho lah-a chu nangho suhmanga naum dingu ahi. Chutengle nanghon keima Pakai kahi nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutia chu chuche bang chungle, chilminlou leingana loijol ho chunga chu kalunghana kasuhbulhit ding, chule nangho jah-a, Bang chu aumtapoi, chule chuche loijol ho jong chu aumtapoi, tia kasei ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheho chu Jerusalem chung chang gaothu seija themgaoho le, chamna umlou petna amanu dinga chamna gaothil mupehho themgaoho ahiuve, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutobangma chun nangma mihem chapa, namite chanute lam nganlang amaho lungdei lama gaothu seiho dounan amaho chunga gaothu seijin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Pakai Pathen'in hitihin aseije tin seipeh-in, Sangkhol tinchenga mitpheldoi khao kikhuibeh ho, mihem hinna sumang dinga kisalel milen tahtah ho delkop khuipeh numei ho, ada nahiuve! Nangho kamite lhagao chu nadel lele uva, naheng uva hunga lhagaoho chu nahinghoi diuham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nanghon kamite lah-a sakolchang khutdim khat, chule changlhah pheng halkhatna athilouding hinnaho thana dingle, ahing louding hinnaho huhdohna dinga, kamiteho najouseiju jaho henga, najou thu-u seija suhboh ding neigot-u ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuti ahi jehchun Pakai Pathen'in hitin aseije; Veuvin, nanghon hinnaho lenmang sah nadinga namanu mitpheldoi ho chu kaki doupin, chule amaho chu keiman nakhut uva kona kamaltela, hinnaho kalhadoh ding, chule lensah dinga nadelu hinnaho jeng jong chu kalhadoh ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na ultheh pon hou jong keiman kabotela kamite nakhut uva kona kahuhdoh ding, chule amaho chu nangho khutna dellea umkit talou ding ahiuve; chule nanghon keima Pakai kahi nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keiman kasuh gimlouho michonpha ho lungthim jong nanghon jouvin nasulung gimun, chule agitlounau lampia kona akilekit louna diuvin hinna anei dingun thutep nape-un, migilouho khut natha hatsah-un ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nanghon pannabei mu nanei tahlou diu, doile ai nasan kitlou dingu ahitai. Ajehchu keiman kamite chu nakhut uva kona kahuhdoh ding; chule nanghon keima Pakai kahi chu nahet dingu ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Israel mite upaho lah-a loikhat keima henga ahunguvin, ka-anga ahung touvun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem chapa, hiche miho hin asemthu-u milimho chu alungsung uva atundoh cheh uva, akhan gitlounao kipal lhuhna chu amasanguva akoiju ahitai. Keima amaho kholle ding kahim?
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun amaho henga hitihin thu seijin, Pakai Pathen'in hitin aseije; Israel insungmi amitakip alungsunga semthu milimho tungdoh-a, chule akhan gitlouna akipal lhuhna-a chu amaichanga koija, themgao henga hunga chu; Pakai keiman ahung penpen chu asemthu milimho tam dungjuija kadonbut ding ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Israel insung chu asemthu-u milimho jeh-a keija kona gamla ahitah jeh uva, keiman alunglam tah uva matding kati ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Israel insung henga seipeh-in, Pakai Pathen'in hitihin aseije; nalung heijun, nasemthu-u thilho-a konin kihei mangun, chule nangho thet umtah nahinnaova konin namaiju heimangun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Israel insung mitele gamdang mi Israel lah-a pemlut tapou, ama chama keija kona chom um, chule asemthu-u milimho alungsunga tungdoh-a, akhan gitlouna kipal lhuhna chu amaichanga koija, chule themgao khat henga keima thudol dong dinga hunga chu, Pakai keimatah-in ama chu kadonbut ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman amapa chu kakimaitopi ding, chule amachu melchihna khatle thuchih khatna kasemding, chule amachu keiman kamiteho lah-a kona kasatlhah-a, chule nanghon keima Pakai kahi nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule themgao chun thilkhat aseija lheplhah-a aumtahle, Pakai keiman themgao chu kalheplhah hiding; chule keiman ama chunga chu kakhut kajah-a, ama chu kami Israelte lah-a kona kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amahon akhan gitlounao talen chu akipohdoh dingu ahin; themgao talen chu ama gaholpa talen chutoh kibang ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutia chu Israel insung chu keija kona petmang kit talou ding, chule asuhkhelnau jouse-a kona jong suhboh-a umkit talou dingu; ahivanga amaho kamite hitheijuva chule keima amaho Pathen kahiding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai thu chu kahenga ahungkitnin, hitin ati,
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihem chapa, agam pumpi nasatah-a keima douna-a suhkhelna anei tengule, keiman achunguva kakhut kajah-a, changlhah hungkondohna chu kasuhtan ding, chule achunga kel kahin lhunsah-a, mihem le sahem agoma kasatlhah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hiche mi thumho, Noah, Daniel chule Job chu asunga umnama jongleu, amahohin achonphatnao jala amahon hinna akihuhdoh dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman gamsunghi gimneitah sahemho kapal sah-a, amahon asuhsetnuva, sahemho jeh-a chu gamsung chu koiman apalthei lou dinga akamhela ahile;
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche mi thum hohi asunga umnama jongleu, keima kahinjing jeh-in, amahohin chapaho le chanuho ahuhdoh loudingu; amaho vang huhdoh-a umuva, gamsung chu kamhel ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahiloule keiman mihemle sahem hichea kona chu kasuhmang nadinga, agam chunga chemjam kahin lhunsah-a, chule chemjam jah-a, agamsunghi satnin tia kaseija ahile;
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche mi thum hohi hiche sunga hin umnama jongleu, keima kahin jeh-in, amahohin chapaho hihen chanuho hijongle ahuhdoh loudingu, amavang amahole amaho bou kihuhdoh ding ahiuve, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahiloule keiman hiche gamsunga natset kahin lansah-a, hichea kona mihemle sahem sugam dinga kalungsatna chu thisana achunga kahin sunlhah-a ahile;
  </para>
  <para style="p">
    <verse number="20" style="v" />Noah, Daniel chule Job, asunga anaum nama jongleu, keima kahinjing jeh-in, amaho chun chapaho le chanuho ahuhdoh loudingu, ahivangin amahon achonphatnao jala amaho hinna akihuhdoh dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu Pakai Pathen'in hitin aseije; Mihemle sahem suhgamna dinga keiman Jerusalem chunga kathutana nasatah liho: chemjam, kel, hugingtah sahem chule natset kahinsol tengle, ichana nasading hitam?
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeng jongle, veuvin, hiche sunga kona puidoh-a umding chapaho le chanuho, ahingdoh amoh hung umdingu ahi. Veuvin, amaho nangho henga hungdoh dingu, chule nanghon amaho lamlhah le anatoh-u namu dingu ahi. Chule keiman Jerusalem chunga kilhut thil gilou chung chang le, amaho chunga kalhunsah jouse chungchanga hi lungmon sah-a naum dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nanghon amaho lamlhah le natoh ho namu tengule, amahon nangho nalhamon dingu ahi. Chule keiman asunga kabolho jousehi ajehbeija kahinbol ahipoi, ti nanghon nahet dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, lengpigui bah chu thingphung dang ahiloule gammanga um thingphung ho bah khat sanga, ipi hichom deh-a ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Chua kona chu thilkhat tou semna dinga thing kilatei ding ham? Ahiloule min chuche-a kona chu umle bel khattou khaina dinga alah ding ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Veuvin, hiche hi meikou sunga mei tikong nadingin akiseplutnin; meijin amongteni akavamin, chule akimlai chu akan ahi. Hichu thilkhat tou semna dinga kiloma hinam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Veuvin, hichu apum ahi petna bon thilkhat tou semna dinga alhinlela ahile, meijin akahvam tengle ichanna lhinglel cheh ding hitam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Pakai Pathen'in hitihin aseije; gamlah thingphung ho lah-a kona meija tidinga lengpigui bah kapeh banga, Jerusalem'a chengho chu kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule keiman amaho douna kamai kaheiteng; amaho meikou khatna kona potnuva, ahivanga meikou dang khatnin amaho akahvam ding; chutia chu keiman amaho douna-a kamai kaheiteng, nanghon keima Pakai kahi neihet dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amahon asuhkhel jeh uva, keiman agammu kamhela kalhading ahi, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu avelin kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Jerusalem thet umtah ahinaho kihetdoh sah-in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pakai Pathen'in Jerusalem henga hitihin aseije, tin seijin; Napenna le nagam mi hina chu Canaan gam ahin, napa chu Amor mi ahin chule nanu chu Hit mi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule napen dan chu ahile, nahung pen nikho chun nalaigui anakitanpon, twija jong silngimin nana-umpon; chi-in jong jutnin nana-umpon, chule ponin jong nana kitompon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nachunga hitobang bolpehna dinga amitna khotona nei koima anaumpoi; ahin nahungpen nikho-a kidah umtah nahi jeh-in, nangma gam onga paidoh-in nana umtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman nakom kahin hopa chun, nangma nathisana nana kisuhboh kamun, nangman nathisan lah-a nana umpet chun keiman nahenga, Hingin, tin kanaseije. Henge, nangma nathisan lah-a nana umpet chun Hingin, kanatin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman nangma gama thil mumdoh khat bangin kapunsah-in; chuin, nangma nahung khangin, nahung pilhingin, chule melhoitah nahunghin ahi. Nanoi teni ahung kigongdoh-in, chule nasam ahung khangin, ahin nangma sagoh le ponbei nahi nalaije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun keiman nangma kahinho pa-a, kahinvet chun, ven, nangma dei naum phat tah chu ahi; hijeh chun keiman kaponlha-a kahin khun, nasagoh hina kakhu khumpeh tai keima nahenga kaki hahsel in, chule nangma toh kitepna khatna kalutnin, chule nangma keija nahung hitai tin, Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin nangma twijin kasilin, henge, keiman nangma-a konin nathisan chu hoitah-in kasop thengin, chule thao kanun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman nangma ajemneija kikhui ponin kana vonin, chule satuilut vun kengchot kasepeh-in, tupat ponnemin natai kagah-in, lungpon kasilpeh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman nangma kijepnaho-in jong kajemin, nakhut teni-a chaokol kabupeh-in, nagonga sumgui ka-o peh tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule keiman nanahkuija sumkol kabapeh-in, nabil teni-a bilba kabapeh-in, chule naluchunga lallukhuh hoitah khat kakhuh peh-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun nangma sanale dangka-a nakijemin, chule navon chu tupat ponnem, lungpon, chule ajem neija kikhui pona kon ahin; na anneh chu changbong neljet, khoiju, chule thao ahi. Chule nangma nahoi lheh jengin, chule lenggam khat bangin nakhang toutan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule namelhoi chun Pathen heloute lah geija naminthan sahtai; ajehchu keima hoina nachunga kavonpeh jala chamkima nahi, tin Pakai Pathen'in aseijin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla nahoina chu nakisonpin, naminthan jeh-in noti'n napangin, chule najon thanhoina jouse chu nahinjotpa jouse chunga nabung lhatan, hichu ama-a ahijitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangman von phabep nakilah-in, nangma-a dingin munsang ho najem polin, chule hicheho chunga chun noti'n napangin ahi. Hitobang chu hunglhung kittalou ding, chutobang chu hikit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keiman nangma kanapeh ka sanale dangka kijepna hoitahtah ho chu nakilah-in, chule nangma-a dingin semthu pasal ho lim nakisemin, hicheho tochun nangman jongthan hoi naboltan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ajem kikhui navonho chu nalan, hicheho chu nakhu khumin; chule kathao le kagim namtui chu amaho anga nakoipeh tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima anneh nangma kapeh changbong neljet, thao, chule khoiju nangma vahna-a kanei jengjong chu, nangman amaho anga gimnamtuijin nakoipeh-in; hitichu anahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chukalvalin nangman nachapate le nachanute, keima dinga nahinho chu, nakipuijin chule amaho chu nangman ganlhaina-in napedoh tai. Hiche najon thanhoinahi thilneo ham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangman kachate nathat gamtan, chule amaho chu amaho dinga meikou palsah-a manchah dingin napedoh tai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule thet umtah nahinaho, najonnaho jouse-a, nangman nakhang donlai nikhoho, sagoh keole pon beija na-umlai, chule nathisana nangle nang suhboh nahilai chu nageldoh tapoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nakhan gitlouna jouse nungin ahung hitin ahi, (Ohe, ohe, ada nahi, tin Pakai Pathen'in aseije.)
  </para>
  <para style="p">
    <verse number="24" style="v" />Hitichun nangman nang dingin mun kilang khat nakisah doh-in, chule muntina munsang nakisemin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangman namun sangho chu lamthom tinna nakisah doh-in, chule namel hoina chu kidah umtah nason, koihile nahin hopa tapou henga nakeng teni nakah-in, chule najon thanhoinaho napunsah-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangman na inheng Egypt miho tahsapum lentah ho toh nanajongtan, Keima phinsetna lunghansahna dingin, najon thanhoina nasuh tamben ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vetan, hijeh-a chu keiman kakhut nachunga kajah-a, naneh ngai anneh kasuhlhom peh-a, jonthanhoi jeh-a jahcha-ah, naho-a Philistine chanute lunggot lama nangma kapehdoh nahitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangman najon thanhoina nakhoplou jeh-in, Assyria miteto jong najong khomin, henge, amaho dingin noti'n nakisan, ahinla nalungna achim joupoi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangma chukalvalin Canaan gamsunga Chaldea miteto najonben, ahijeng vangin chua jong chun nalunglhai dehpon ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangman hitiho thil jouse, jachat helouva numei jongthang hoi kimanchah bangin nakimangchan; ichana nalungthim lhasama hitam, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nangman lamthom tina namun kichoiho, chule lamlhah tinna namun sangho nasadoh-in, ahin nangman aman iman nalah loujeh-in, nangma noti bangin na-umpon;
  </para>
  <para style="p">
    <verse number="32" style="v" />Amavang inneipi khat a-inneipu khela hetlou miho jonpia tobang nahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amahon numei notiho thilpeh apeuvin; ahinla nangman nakingaipiho jouse nathanhoi na-a nahenga ahung theina diuvin thilpeh napen nathalah-in ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule najon thanhoi na-a nangma numei danghotoh nakibahlouna aumin, amaho koimachan jonpi dingin nangman nahinjui pouve. Nangman tohman napehji-a, chule nangma peh-a na-umlouhi mitoh nakibahlouna ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hijeh chun, vo notinu, Pakai thu ngaijin,
  </para>
  <para style="p">
    <verse number="36" style="v" />Pakai Pathen'in hitin aseije; nangma bohna sunlhah-a ahung umjehle, nakingaipi ho le thet umtah namilim semthuho toh najon thanhoina jeh-a sagohkeo nahina hodoh-a ahung um jeh, chule amaho napeh nachateho thisan jeh-a;
  </para>
  <para style="p">
    <verse number="37" style="v" />Ventan, keiman nakingaipiho jouse, nanopsah khompiho jouse toh, nangailut ho jouse toh, nana thet ho jouse chu kakhop khom ding; keiman amaho chu nakimvela kakhop khom ding, chule amahon nangma sagohkeo nahinaho amudoh theina dinguva, ahenguva sagohkeo nahina chu kahodoh ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule keiman nachung thu chu numei kichen sukeh ho le thisanso ho chungthu akitan banga katan ding, chule keiman lungsatna le thangthip na-a thisan kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule keiman nangma amaho khutna jong kapehdoh ding, chule amahon namun kichoilaiho chu asuhlhuh uva, chule namun sang laiho chu asuhchim dingu ahi. Chule amahon nangma naponho jouse naholhahpeh dingu, chule nasongmantam hoitahho chu nalahpeh uva, sagohkeo le pon beija nadalhah dingu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Amahon nangma doudinga honkhat jong ahinpui dingu, chule amahon nangma songa naseuva, achemjamuva nasutpai dingu ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule na-inhou chu meija ahalvamuva, numei tampi mitmu-a nachung thu atandingu; chule keiman nangma noti'a napanna chu kasuhtana, nangman thalah nabol louding ahitai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hitia chu keiman nachunga kalungsatna chu ka kicholdo sah-a, chule kathangthipna chu nanga kona chemanga, kathipbeh ding; chule kalung hangkit talou ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangman nakhangdon lai nikhoho geldoh louva, hiti thilho jouse-a neisuh lungjing jeh-a hi; vetan, hijeh-a chu keiman jong nachondan jouse naluchunga kalethuh ding ahi, tin Pakai Pathen'in aseije. Chutengle thet umtah nabolna jouse chungvuma jonthanhoi nabolkit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ven, koihile thuchih mangcha jouse chun nachunga hiche thuchih, anu hinabang banga, achanu jong hia ahi, kitihi amanchah dingu ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nangma nanu chanu, a-inneipu le achateho theida-a chu nahi, chule nangma a-inneipu teho le achateho theida nasopinu teho sopinu nahi; nanu chu Hit mi ahin, chule napa chu Amor mi ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule nasopi alenjonu nakhut veilama amale achanute chenga chu Samaria ahin, chule nasopi aneojonu nakhut jetlama chenga chu Sodom le achanu teho ahiuve.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ahijeng vangin nangman amaho lampiho najuipon, amaho thet umtah ahinao jong nabolpoi. Ahivangin hichu thilneo khat bangin, nalam lhah ho jouse-a amaho sangin gamchengin suhboh-in na-ume.
  </para>
  <para style="p">
    <verse number="48" style="v" />Keima kahing jinge, tin Pakai Pathen'in aseije, nanaonu Sodom le achanuten jong nangle nachanuten nabol tobang lomin abolpouve.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ven, hichehi nasopinu Sodom khangitlouna ahi, kiletsah, nehle chah ninglhing set, chule thasetna dimset chu amale achanuteu ho-a anaumin, chujongle vaichate le ngaichate khut chu anahatsah poi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule amaho akibolthei sah-un, ka-anga thil thet umtah anaboluve. Hijeh chun pha kasah dungjuijin amaho chu kalamangtan ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Samaria jengin jong nangma chonset naho keh khat jong anabolpon; ahinla nangman thet umtah nahinaho chu amahoa sangin napunsahtan, chule natohdoh thet umtah nahinnaho jouse-a chun nangman nasopinute them nachan sah-in ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Nasopinuteho chunga thutan nangma tah-in jong, amaho-a sanga tamjo thet umtah thil nanabol nachonset naho jeh-a jum na chu nakipoh ahi. Amaho nangma sangin adihjouve; henge, nangma kisudongin jong uminlang, chule nasopinute nathemchansah na-a chun jum na kipohtan.
  </para>
  <para style="p">
    <verse number="53" style="v" />Keiman amaho asohchan naova, Sodom le achanute sohchana, chule Samaria le achanute sohchan na-a kon kahin lepui kit teng, keiman nasohchanghou chu asohchan naova kona amaho lah-a kahin lepui kit ding ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chutia chu amaho dinga lhamona nahi tengle, nangman najachatna chu nakipoh ding, chule nanatoh ho jouse-a chu nakisuhdong ding ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Nasopinuteho, Sodom le achanu teho, malaija anachen nao munna ahung kilekit tenguva, chule Samaria le achanu teho malaija anachen nao munna ahung kile kit tengule, chutengle bou nangle nachanuteho malaija nanachen nao munna nakile kit diu ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ajehchu nasopinu Sodom chu nakiletsah nikho laitah chun nakamin jong nana phapoh pon;
  </para>
  <para style="p">
    <verse number="57" style="v" />Hichu Syria chanute le akimvela um jouse, nakimvela nangma nahsahlouva nabol Philistine chanuteho-a kon housetna natolai banga, nakhangitlouna kiphondoh masang chu ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Nangman na jonthanhoina le thet naum naho chu nanakipoh tai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="59" style="v" />Ajehchu Pakai Pathen'in hitin aseije; kihahselna nanahsah louva kitepna nasuhkeh jeh-a, nangin nabol bang banga ken jong kahinbol ding ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Hijeng jongle keiman nakhangdon laija nangma toh kitepna kanei chu kahingeldoh ding, chule nangma-a dinga tonsot kitepna katundoh ding ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chuteng nangman nachunga le nanoija nasopinuteho chu nakisan tengle, nachon danho chu nahin geldoh-a najachat ding ahi. Chule keiman amaho chu nachanute hidinga kapeh ding, nakitepna jeh-a vang hilou ding ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chule keiman nangma toh ka kitepna katundoh ding; chutengle nangman keima Pakai kahi nahinhet ding,
  </para>
  <para style="p">
    <verse number="63" style="v" />Chutia chu keima nanatoh ho jouse jala kalungdam teng, nangman nageldoh-a najah chading, chule najachat jeh-a nakam nakahkit louhel ding ahitai, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, hetmo thu phongdoh-in, chule Israel insung henga thulem khat seipeh-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pakai Pathen'in hitin aseije tin seijin; Lhaving lentah nei muvanlai lentah, lhaving saotah, amul dimset, vouso tintang nei khat Lebanon'a ahungin, chule Cedar thing bah sangpena chun ahung toutai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman hiche thingbah leh adonglai chu achu tanin, chule hichu sumkol veina gamsung khatna apolutnin; sumkolvei ho khopi khat sunga aphuttan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman agamsoh muchi khat jong alan, chule hichu ga tamtah so na loulai khatna atu-in; aman hichu twipiho panga akoijin, chule huisum thing khat bangin aphutnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin hichu ahung khangin, abahho ama henglama kikho-a, chule ajungho ama noija jam lengpigui nemcha ahung hitan, hitichun lengpigui ahung hi-in, chule bahho ahin neijin, chule adonho ahin sodoh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lhaving lentah le mul tamtah nei muvanlai lentah dang khat jong aumin, chule ven, akiphuna gamsung twilamho-a kon atuichap theina dingin, hiche lengpigui hin amapa lam ngan abahho aloi onin ajamlutsah-in, chule abahho jong amapa lam ngan akikhosuh-e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichu abahho ahungjam doh theina dingle, aga ahung umdoh theina ding, chule lengpigui pha ahunghi theina dinga, twipiho panga loumun phalaija kiphutna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman gaseijin, Pakai Pathen'in hitihin aseije; hichehi khangtou ding hinam? Aman hichu agopna dinga ajungho chu abodoh-a, chule aga jong chu apul lhahsah lou ding ham? Hiche ama-a dondoh anaho jouse chu goplha ding, ajung geija bodohna dinga, thaneina lentah le mi tamtah ngailou ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Henge, vetan, kiphut jongle lolhing nantem? Solam huijin ahin semkhah teng gop lhahel jenglou ding ham? hichu akhandohna honsunga chu goplha ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukal valin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun kiphinjing insung henga hitihin seijin; Hiti thil hohin ipi aseina ahi nanghon nahet uvem? Amaho seipeh in, veuvin, Babylon lengpa chu Jerusalem'a ahungin, chule chuche mun'a lengpa le pipuiho chu amanin, amato lhonin Babylon'a gal hingin akaitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule lengpa chilhah chu akaijin, amato kitepna asemin, ama chu akihahselsah-in, chule aman gam sunga thahat ho jong akai mangin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutia chu lenggam chu kisunema, achama kiphong dingthei talou ding, aman kitepna anit jala bou dingthei ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla aman, amahon sakol ho le mi tamtah apeh theina dingun apalaiho Egypt'a asol lutnin, ama chu adoutan ahi. Ama chu akhangtou nadem? chutobang thilho bola amachu hoidoh nantem? ahiloule huhdoh-a aumna dingin kitepna chu asukeh dem?
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai Pathen'in aseije, Keima kahinjing bangin, tahbeh-in akihahselna nahsah louva akoija, akitepna asuhkehpa, ama lenga anasem lengpa chenna mun'a chu, amatah chutoh Babylon lailung tah-a chu thitei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon mitha nadinga molsang banga kulbang asetnuva, pal akai tengule, Pharaoh'in agalsat sepai mihat hole mihonpi tamtah toh gal kisatna-a chu ima abolthei lou dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman kihahselna i-sah louna-a kitepna asuhkeh-a, chule vetan, aman akhut alapma hitiho jouse abol jeh-a hi, ama hoidoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; Keima kahinjing bangin, tahbeh-in kaki hahsel na aman i-sah louva abola, kakitepna asuhkeh ahin, keiman amatah lujang kalethuh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule keiman achunga ka lenthang kajal-a, kathanga ohding, chule keiman ama Babylon kahinlhut ding; chuteng hia chu asuhkhelna, keima dehna-a asuhkhelna thua ama chu kakihoupi ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amite jamleho jouse chu ama loiho chutoh chemjam'a loudingu, chule amaho aum nalaiho chengse chu hui nunna lam jouse-a kithecheh dingu; chutengle keima Pakaiyin kaseisa ahi ti nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai Pathen'in hitin aseije; Keiman Cedar thingphunga kon abah sangpen chu kalah-a, chule kaphu ding; ajih donho dongset khat kasilhah-a, hichu lhangsang akichoilai khatna kaphu ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Israel molsang chunga hichu kaphu ding, hichun bahho hinsepdoh intin, ga ahin neija, Cedar hoitah hung hiding; chule anoija chu lhavingnei vacha namkim chenga, abahho lima chu cheng ding ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule gama thingphung ho jouse chun, Pakai keiman thingphung sang chu kaloilhun, thingphung nem chu katung sangin, thingphung hing chu kagotlhahsah-in, chule thingphung go chu kahindohsah-e, ti ahin het dingu ahi. Pakai keiman kasei ahitan chule kabol ahitai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu avelin kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanghon Israel gamsung chungchanga naman chah-u thuchih, Paten lengpithei thuh aneovin, chate aha ajai kitihi ipi natinao ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima hinjing kahijeh-in, nanghon Israel sunga, hiche thuchih manchahna phat naneikit louhel dingu ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Veuvin, hinkho jouse chu keija ahi, mipa hinkho keija ahibanga, chapa hinkho jong keija ahi; chonset bolla hinna chu thitei ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla mikhat chu achondih-a, chule thilpha le adih abola,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule molsang ho chunga ima nelouva auma, Israel insung semthu limho jong amit teni-a khoda-a ve louva, a-inhengpa ji jong asuhboh louva, numei thichelai jong aganai louva,
  </para>
  <para style="p">
    <verse number="7" style="v" />Koimacha sugenthei louva, amavang abatpa henga athiltun alepeh-a, hunama koima achom louva, gilkelte achanglhah apeh-a, chule sagohkeo chu pon akhu-a,
  </para>
  <para style="p">
    <verse number="8" style="v" />Athoi dinga sumpa homlouva, apung jong lalouva, khangitlouna-a kona akhut atuhtanga, mihem le mihem kah-a thutan lhahna dihtah atohdoh-a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Kadan kisun ho ajuija, chule kathutanho adihtah bolna dinga anitna ahile; ama chu midih ahin, hingtei ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amapa chun chapa khat ahina, achapa chu gucha michom, thisanso hat ahi-a, chule hicheho lah-a hitobang khat penpen abola ahile,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule chutobang tohding dolho khat chabeh tonglouva auma, amavang molsang chung dunga ima aneh-a, chule a-inhengpa ji asuhboh-a,
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaicha le lhasamte asuhgentheija, hunama mi achoma, thil kitung lepehlouva, chule semthu limho chu amittah ngeija vea chun thet umtah chu abol ahin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Athoi dinga sumpa ahopma, apung akilah-a ahileh; ama chu ahing nadem? Hinglou helding ahi; aman hiche thet umtah ho jouse aboltan; ama thitei ding; ama thisan chu ama chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun, veuvin, aman chapa khat neihenlang, achapa chun apan abol chonsetna ho jouse muhen, hichu ngaitohen, chule chutobang chu bolda henlang,
  </para>
  <para style="p">
    <verse number="15" style="v" />Molsang ho chung dunga ima nelou, amitna jong khodah-a Israel insung semthu limho velou, a-inhengpa jinu suboh lou,
  </para>
  <para style="p">
    <verse number="16" style="v" />Koima jong sugentheilou, thil kitung jong itcha lou, hunama jong mi chomlou, achanglhah gilkel le lhasamte pejo-a, sagohkeote ponsil pe-a,
  </para>
  <para style="p">
    <verse number="17" style="v" />Vaichate-a kon akhut tima, sumthoi homa chule apung jong lalouva, kathutan atohdoh-a, kadan kisunho ajopma ahile; ama chu apa khangitlou jeh-a thilou ding, ama chu tahbeh-a hing ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Apa thudol ahile, aman engsetah-a anasuh gentheija, asopipa hunama anachoma, chule amite lah-a aphalou anabol jeh-a chu veuvin, amatah chu akhangit louna-a thitei ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahijengvangin nanghon, i-atile chapan apa khangitlouna apohlou ham? tin naseijuve. Chapa chun dandunguija adih chu abola, kadan kisemho jouse achintupma hicheho chu abolteng, ama tahbeh-a hing ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chonset bola hinna chu thitei ding ahi. Chapan apa khangitlouna apoh louhel ding, panjong chapa khangitlouna chu apoh louhel ding ahi. Chonphat nachu chonphapa chunga umding, chule agiloupa gitlouna chu ama chunga umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin agiloupa chu aman anabol achonsetnaho jouse-a kona ahung kileheija, kadan kisun ho jouse anitna, thilpha le adih chu abola ahile, ama hing teitei ding, thilou ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule aman anabolsa suhkhelna ho chu, ama henga kiphapoh louding ahin; aman anabolsa chonphatna-a chu hing ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keiman migilou athi ding chu kakipapi dingham? amavang ahina dinga achena lampiho-a kona ahungkile kit ding johchu kakipana hilouham? tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amavang michonpha chu achonphatna-a kona akiheimanga, setna abola, agiloupa thilbol thet umtah ho jouse chu abola ahile, ama hingin tem? Aman anabolsa chonphatna ho jouse chu kiphapoh talou ding ahi. Suhkhelna-a anabol suhkhelna leh chonset na-a anabol chonsetna jeh-a, ama thitei ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Achutijeng vangin nanghon, Pakai lampi chu akibangpoi, nati uve. Tun ngaijun, Vo Israel insung, Keima lampi kibanga hilou ham? nangho lampijoh hilouham akibang louva chu?
  </para>
  <para style="p">
    <verse number="26" style="v" />Chonpha khat chu achonphatna-a kona akihei manga, chule khangitlouna abola, chua chu athi dena ahile; khangitlouna anaboldoh jeh-a chu ama thia ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chujongle, migilou khatnin gitlou anabola kona ahung kihei manga, thildih le apha chu abola ahile, aman ahinna akihuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu ama kingaito-a, anabolsa sukhelna ho jouse-a kona akiheimanga ahin, ama tahbeh-a hingtei ding, thilouhel ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Achuti vangin Israel insung chun, Pakai lampi chu akibangpoi atiuve. Vo Israel insung, Keima lampiho kibanga hilouham? Nangho lampijoh hilouham akibang louva chu?
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh-a chu, Vo Israel insung, mitin achonna dungjui cheh-a athu-u katan ding ahi, tin Pakai Pathen'in aseije. Nalung heijun, nakhangitlou naova konin nangho le nangho kihei mangun, chutile chu setna chu namanthah nao hilouding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khan gitlouna nabolho jouseu nangho-a konin paimangun; chule lungthah le lhagao thah kengun, ajeh chu ipidinga nathi jeng diuham? Vo Israel insung.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu athipa thina-a chunga chun kipana kaneipoi, tin Pakai Pathen'in aseije. Hijeh chun kiheijun lang hinnan neijun.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujongle nangman Israel pipuiho dingin ka la bolin lang,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule seijin, Nanu chu ipi ham? Keipi bahkai nu ahin; keipi bahkai ho lah-a akolin, keipi bahkai chalgol ho lah-a anoute avah-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman anoute lah-a khat avahdoh-in; keipi bahkai chalgol ahung hitan, samatje ahinhetan, mihem ahin thattan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Namtinin ama thu aja taovin; ama chu akokhuh uva matnin aumin, chule amahon akihena thihkhao pumin Egypt gam alhut taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tun keipinu chun angah-in, akinepna abeitai ti amu phatnin, aman anouho lah-a achomkhat alakitnin, keipi bahkai chalgol-in asemtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ama chu keipiho lah-a atouche asuhchen, ama keipi bahkai chalgol ahung hitan, samatje ahung themin, chule mihem ahin that tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman akamhel aleng inpihou chu ahen, aman akhopihou chu manlou asotan; chule gamsung le asunga cheng dimsetho chu akitum gina chun akamheltai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin namtin chun lam tina konin ama ahindouvun, alenthangu chu ama chunga ahinjah taovin, ama chu akokhuh uva amantaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amahon thihkhaova akanun, ahentupmun, Babylon lengpa heng ahin lhutnun: a-awgin chu Israel molsang ho-a akijah kitlouna dingin, amahon ama chu kotong sunga ahentauve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanu chu twi panga kiphut, nathisana um lengpigui tobang ahin, twi tamjeh-in amanu aga aphan, abah jong tamtah ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amanun vaihomna leng tenggol dingin mol tahbet khat aneijin, chule amanu sanje chu thingbah tamtah lah-a dopsangin aumin, amanu sandan chu abah tamtah ho chuto ahung kilahdoh than ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahijeng vangin amanu chu lungsat na-a bodoh-in ahung umin, amanu chu tolla selhah-in ahung umtan, chule solam huipin aga chu agotlhah sahtai. Amanu mol tahbet chu akisu bongin, agoplhan meikouvin akavamtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tunvang amanu chu gamthipma, gamgole dangchah na gam leisetna akiphut tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amanu bahho lah-a mol khatna konin meikou ahungdoh-in, hichun agaho akavamtan; chuti chun amanun vaihomna tenggol ding mol tahbet aneitapoi. Hichehi kala ahin, chule kala khat hung hiding ahitai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kumsagi lhinna alha ngana nisom lhinnin ahung hitin ahi, Israel upaho lah-a konin loikhat Pakai henga thudoh nei dingin ahunguvin, ka-anga atouvun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem chapa Israel upaho henga seipeh-in, chule amaho henga seijin, hitihin Pakai Pathen'in aseije; Nangho keima dongdinga nahungu ham? Keima kahinjing bangin, tin Pakai Pathen'in aseije, nangho thudoh le-a kaumlou ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman amaho thu natan dingham, mihem chapa, nangman amaho thu natan dingham? Apu apateho thet umtah thilbolho chu amaho hetdohsah-in lang;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amaho henga seijin, Pakai Pathen'in hitin aseije; Keiman Israel kalhena, Jacob insung chilhah henga kakhut kadopsanga, Egypt gama Keima amaho henga kakihetsah-a, ahenguva kakhut kadopsanga, keihi Pakai na Pathen'u kahi tia kasei nikho,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuche Egypt gama kona hinpuidoh-a amaho dinga kavetpehna gam, khoiju le bongnoi lona gama, gamjouse loupina-a chu amaho puilut dingin ahenguva kakhut kadop sang nikho;
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche nikho chun keiman ahenguva, Mitinin namitmu uva thet umho paimang uvin, chule Egypt gam milim ho-ah kisuboh hih-un, keima Pakai na Pathen'u kahi, tin kanaseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla amahon eina douvun, chule kathu angaipouve. Amaho mitinin amitmuva thet umho anapaimang pouvin, Egypt gam milimho jong adalhadeh pouve. Hichun keiman Egypt gam lailung tah-a, achunguva kalunghana kamolso nadingin achunguva kalungsatna bung lhange, tin kaseijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla aumpihou Pathen heloute, Egypt gama kon kahinpuidoh uva kona ahenguva kakihetsahna miho anga kamin suhboh-a aumlouna dinga, kamin jala kanabol ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh-a chu keiman amaho Egypt gama kona kapotdoh sah-a, gamthip sung kahinlhut ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman kadan kisunho amaho kanapen, chule kathutanho kanavetsah-in, hichu min abola ahile ama chu hingding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chukalvalin, keiman amaho suthengpa Pakai kahi ahet theina dingun, keima le amaho kah-a melchihna khat hidingin kacholngah nikhoho kanapen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla Israel insung chun gamthipma keima einadouvun; mihemin hichu abola ahile, chuche-a chu ama hing ding ahi tia kanasei, kadan kisunho ajui pouvin, kathutanho angaisah pouvin; chule kacholngah nikhoho chu hatah-in asuboh-un ahi. Chuin keiman gamthipma amaho sugam dingin kalungsatna achunguva bung lhange kanatin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alah uva kon kahin puidohna Pathen hephalou mite mitmu-a kamin suhboh-a aumlouna dinga, kamin jala na katoh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Achuti vangin, keiman amaho kanapeh gam jouse lah-a gam loupi, khoijule bongnoi lonna gam chu kalhut louna din gamthipma kakhut kanadom sangin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu amahon kathutanho anahsah pouvin, chule kadanthu kisunho ajuipouvin, amavang kacholngah nikhoho asubohtauve. Ajehchu alungsungun amilimhou nung ajuitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeng jongle, kamitnin suhmangna dinga konin amaho anahoidoh-in, gamthip jenga jong chun kana subei pouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amavang gamthipma chun achateu henga hitin kanaseije, Nanghon napu napateu dan kisunho chu juihih beh-un, athutanhou jong nit hih-un, asemthu milimhouva jong kisuboh hihbeh-un
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima Pakai na Pathen'u kahin, kadan kisunho-a chonun, kathutanho nitnun lang bolun,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule kacholngah nikhoho jabolun, hiho chu keima le nangho kah-a melchihna khat hiding, chutia chu nanghon keima Pakai le na Pathen'u kahi nahet dingu ahi, kanati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahijeng vangin achateu keima dounan agolkeh-un; mihemin hichu abola ahile, chuche-a chu ama hing ding ahi tia kanasei kadan kisunho-a ajui pouvin, kathutanho angaisah pouvin; kacholngah nikhoho asuboh-un ahi. Hichun keima gamthipma achunguva kalunghana molsona din, amaho chunga kalungsatna bung lhange tin kana seijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahijeng vangin alah uva kon kahin puidohna Pathen hephalou mite mitmu-a kamin suhboh-a aumlouna dinga, kakhut kanatima, na kanatoh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keiman amaho Pathen heloute lah-a kasuhcheh nadingle, gamtina kathecheh-na dingin gamthipma jong chun kakhut kanalam in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu amahon kathutanho anatongdoh pouvin, kadan kisunho anahsah pouvin, kacholngah nikhoho asuboh-un, chule amit houchun apu apateu milimho ajuijun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun keiman amaho apha loutah chondan kanapen, chule hinna-a aneilou diu thutan naho kanapen;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keiman amaho kakamhel sah-a, akhonnale keima Pakai kahi ahetdoh theina dinguvin, naobu phukeh jouse meikou apal galkai sahnao, athilpeh uva chun amaho kasuboh-in ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun mihem chapa, Israel insung henga seijin, chule ahenguva, Pakai Pathen'in hitin aseije; Napu napa teovin hiche-a hin eina taitomun, khuche-a chun keima dounan suhkhel ananeijun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu, keiman amaho pehdinga kakhut kadop sangna gamsunga kapuilut phatnun, amahon lhangsang jousele thingphung lentah ho jouse amuvin, chua chun athiltohou chu apeuvin, athilto houva chun eilunghan sah-un ahi. Chua chun amahon agimnamtui hou jong ahalun, chule hia chun donding thilpehho alhei lha uvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin keiman amaho henga, Nagachenao munsang chu ipiham? tin kaseijin, hiche munchu tuni geijin Bamah akiti nalaije.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh chun Israel insung jah-a seipeh-in, Pakai Pathen'in hitin aseije; Napu napateu chonna dungsuna nakisuh boh-u hitam? chule thet umtah athilbol hou banga jonthanhoi nabolu hitam?
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu nathilpeh-u natouva, nachateo meikou napal galkaisah tengule, tuni changeija namilimho uva kisuboh nahiuve. Chuti ahile keima nangho gahdoh ding kahim, Vo Israel insung? Keima kahinjing bangin, tin Pakaiyin aseije, keima nangho dohding kahi louhel ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule nalungsunguva hunglut, Keiho Pathen heloute bang kahi dingu, gamsung miho insung tobang kahi dingu, thingle song kajendiu ahi, natiu chu guilhung louhel ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Keima kahinjing bangin, tin Pakai Pathen'in aseije; tahbeh-in khut thahat tahle, ban jahdoh-a, chule lungsatna sunlhah to tho-a, nachung uva vai kahomding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule keiman khut thahat tahle, ban jahdoh-a, chule lungsatna sunlhah totho-a, mipi ho-a kon le, nakithe chehnau gamho-a kona kahinkhop khom ding nahiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule mipi gamthip sunga nangho kahin puilutna, chukoma chu nangho kimaito-a kakihoupi ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Egypt gamthip sunga napu napateu to kanakihou banga, keiman nangho kakihoupi ding nahiuve, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule keiman nangho mol lhon noi kapalsah uva, chule nangho kikankhomna kitepna sunga kahinpuilut ding nahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule keiman nalah uva kona doumah bolho le keima douna-a suhkhel ho chu kasuhtheng ding, amaho chu agapemnau gamsunga kona kahin puidoh-a, Israel gam sunga lutlouhel ding ahiuve. Chutengle nanghon keima Pakai kahi chu nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nangho vang, vo Israel insung, Pakai Pathen'in hitihin aseije; Cheovin, tunung jongle kasei nangaisah lou dinguva ahile, mitinin namilim cheh gakijenun; tukallin nathilpeh hou le namilim houva chun kamin theng suboh tahih-un.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ajehchu kamolsang thengtah, Israel sanna molsanga chu, Israel insungho jouse, agamsunga um jousen chuachu eijen dingu ahi. Hia chu keiman amaho kasan ding, nathilpeh hou le nakipehdoh nau gamasapenho, chule nathil thenghou jouse kangeh ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="41" style="v" />Keiman nangho mipi ho-a kona kahin puidoh-a, nakithe chehnau gamho-a kona kakhop khom teng, keiman nagim namtuiju puma kasan ding; chule Pathen heloute angsunga nangho-a suhthenga kaum ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule keiman nangho Israel gamsung, napu napateu penge tia kakhut kanadop sangna gam chu kahinlut tengule, nanghon keima Pakai kahi neihin hetdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule hia chu nana kisuhbohnao nalampi hou le nathilbol jouseu nahin geldoh dingu; chule thilgilou nanabol hou jouseu jeh-a nangho mitmu ngeija jong nanghole nangho jong nakikidah dingu ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule keiman nakhangitlou nau dungjuija hilouva, nathilbol thenlou jeh-u jong hideh louva, kamin khohsahna jala nachung uva na katoh tengle, vo nangho Israel insung, keima Pakai kahi chu nahinhet dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chukalvalin Pakai thu chu kahenga ahungin, hitin aseije.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mihem chapa, lhanglam maingatnin lang, nathu chu lhanglam sanga phongdoh-in, chule lhanglam gammang dounan gaothu seijin,
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule lhanglam gammang henga chun seijin, Pakai thusei hi ngaijin, Pakai Pathen'in hitin aseije; Ven, keiman nasunga mei kachokonga, hichun nangma-a thingphung hing tinleh thingphung go tin chu ahalvam ding: meikou deojeju chu kiphelmit louding, lhanglama pat sahlam geija maichang jouse hichun akahvam sohding ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule tahsa-a hing jousen Pakai keiman hichu kachokou ahi ti amucheh dingu; hichu kiphelmit louhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin keiman, Vo Pakai Pathen, amahon keima thudol aseijun, Amapa khun thulem asei hilou ham? atiuve, kati.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Jerusalem lam maingatnin lang, nathu chu muntheng ho lama phongdoh-in lang, Israel leiset dounan gaothu seijin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Israel gamsung jah-a seijin, Pakaiyin hitihin aseije; Vetan, nangma kadou nahi, chule kachemjam apaija kona kasadoh ding, nangma-a kona michonpha le migilou kibanga kasatlhah ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman nanga kona michonpha le migilou kasuhbei ding ahitan, hijeh-a chu kachemjam chu apaija kona lhanglama pat sahlam geija tahsa-a hing jouse dou dinga kondoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutia chu tahsa-a hing jousen keima Pakaiyin kachemjam apaija konin kasatdohtai ti ahet dingu; hichu kilekit louhel ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun mihem chapa, nangma nakong bong pumin khoisan lang; amitmu uva lhasetah-in khoisan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hung hiteiding ahi, amahon nahenga ibola nakhoisat ham? ati tengule, nangman, thu jeh ahi, ajehchu hichu hunglhung kon ahitai: lungthim jouse junlha ding, khut jouse joilha ding, lhagao jouse lhasam ding, khup jouse twi banga lhasam ding ahi: ven, hichu ahunge, kimolso tei ding ahi, tin Pakai Pathen'in aseije, tia nadonbut ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai thu chu avelin kahenga ahungin, hitin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihem chapa, gaovinlang seijin, Pakaiyin hitin aseije; chemjam khat, chemjam khat akinol hemin, akinotval ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichu nasatah-a thagamna dinga kinol hem ahin; aduljetna dinga kinotval ahi. Achutile eihon eltol ibol jing diuham? hichun kachapa tenggol chu thingphung ho bangin ima asahpoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman hichu choithei ahina dingin, notval dinga apen: hiche chemjam hi mithatpa khutna pehdinga, kinol hema, kinotval ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihem chapa, kapmin lang peng lhuh lhuh-in, ajehchu hichu kamite chunga chuding ahin, Israel pipuiho jouse chunga chuding ahi. Chemjam le tijatnaho kamite chunga chuding ahin; hijeh chun naphei chung bengin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu hichehi patepna ahin, chemjam chun tenggol jengjong chu i-asah loule iti tantem? chemjam chu umlou ding ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun mihem chapa, gaovin, nakhut teni chu bengton, chule athumvei nan chemjam ajatni hisah-in, mithana chemjam chu: hichu akithat milenho chemjam ahin, achangvalu indan sunglama lut chu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman alungu lhahsamna dingle, amanthah nau punsahna dingin, chuche chemjam muhhemho chu akotpihou dou dingin kaphutne: O! hichu duljetna kisema, mithana dinga kichuntup ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangma lampi khat ahiloule adang khatna, jet lam hihen vei hijongle, namaijin angatna lamlama chetan.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keijong kakhut votongting, kalungsatna kingahsah tange; Pakai keiman kasei ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai thu chu kahenga ahung kitnin, hitin aseije,
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihem chapa, nangman Babylon lengpa chemjam ahunglhun theina dingin, lampi ni semdoh-in; hichu gamkhatna kona hungdoh hiding ahi; chule nangman lampi komuna khat semin, khopi sungjotna lambul tah-a chun semin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ammon mite kho Rabbath, chule aki umkul Judah gam Jerusalem'a chemjam chu ahunglhun theinadin, lampi khat gongin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu Babylon lengpa chu lampi kikhen nalaitah, lampi ni bomtah-a, aisan din anadinge. Aman athalchang ho anotvalin, milimho adongin, sathin chu avetan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Akhut jetlama chun gal lamkaiho pansahna ding, mithana-a kam katna ding, thong jeju-a ao na ding, kotpiho nolhuhnaho koina ding, kulbang setsangna ding, chule galkul khat sahdoh nadinga Jerusalem dinga aisan na aumin,
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule akihahsel ho dinga, amitmuva aisan lhem banga kilang ding; ahia amaho chu kaimanga aum theina dinguva, aman akhan gitlounao ageldoh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun Pakai Pathen'in hitihin aseije; nanghon nathemmonao geldoh-a naumsah kit jeh uva, hiche-a chu nasuhkhel nahou kihedoh-a, nabol jouseuva nachonset nao kilanga ahitai: Nangho geldoh-a nahung umtah jeh-un, khutna kaija umding nahitaove, tia kasei ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nang miboh khanggilou Israelte pipuipa, khansetnan kingahna aneiphatna, nanikho hung lhunga ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakai Pathen'in hitihin aseije, nalal delkop chu ladoh-in lang, nalal lukhuh hohdoh-in; hichehi angai banga umjing louding ahi: anema chu choisangin lang, asanga chu sunemin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Keiman hichu kalekhup ding, kalekhup ding, kelekhu ding; achang dingdol hungkahsea umkit talou ding ahi, chule keiman hichu ama kapehdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule mihem chapa, nangma gaovinlang seijin, Pakai Pathen'in Ammon chilhah mite thudolle, amaho seisetna thudola hitihin aseije: Nangmatah in seijin, Chemjam, chemjam chu akisatdoh tai, suhmangna dinga kisuval ahin, hichu mithana dinga kinot duljet ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amahon pannabei namupeh uva, doi aithemhon jouva nalhep uva, agilou kithat ho ngonga chuhsah ding nagot laijun, akhansetna houvin kingahna phat ahinnei tan, anikhou chu hunglhunga ahitai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Keiman hichu apaija kakile sahkit dingham? Keiman nakisem dohna mun, napen nagama nathu katan ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule keiman nachunga kalunghimona kasunlhah-a, kalungsatna meikou chu nangma lama kamutkhum ding, chule nangma mi engseho le misumang themho khutna kapehdoh ding nahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangma meikouna dinga kito thinga napan ding; gamsung lailung tah-a nathisan longding: nangma geldoh-a naum kit louding ahi: ajehchu keima Pakaiyin kaseidoh ahitai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Tun nangma mihem chapa, nangman thu natan ding hija, thisan lonna khopi thu natan ding ham? Henge, nangman amanu chu athet umnaho jouse namusah ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hitin seijin, Pakai Pathen'in hitin aseije, Amanu phat ahunglhun nadingin khopi hin alailungtah-a thisan ason, amale ama kisuhbohna dingin amato kidouding semthu limho akisemtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma nathisan nasona-a chu themmo chang nahitan, chule nasemthu limho-a chu kisuboh nahitai; chule nanikho ho jong nakisuh naijin, nakumho jengjong ahung lhungtai. Hijeh-a chu Pathen heloute henga seiset le gamsung jouse totnopna-a kasem nahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma kom naija umho le gamla umhon, aminse-a le hesohna-a dim banga nanuisat dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vetan, Israel pipuho, thisan sona thahat neijouse chu nangma-a um ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangma-a chun amahon nu le pate anoiseuvin, nalailung tah-a maljinho asugentheijun, nangma-a chun pabei le meithai chu asulung gimun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman kathil thengho nanahsahpon, kacholngah nikhoho nasuboh-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangma-a chun thisan sona ding thupole ho aumun, nangma-a um molsang ho chunga chun aneuvin, nalailung tah-a chun jonthanhoi abolun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma-a chun apateu sagohkeo hina ahohdoh-un; nangma-a chun numei boh kikoidoh hojong asuboh taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule khatnin a-inhengpa inneipito thet umtah abolun; adang khatnin jonthanhoi thet umtah-in amounu asuhboh tan; chule nangma-a chun adang khatnin asopinu, apa chanu asusen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangma-a amahon thisan sonadin thilpeh alauvin; nangman sumthoi nahomin apung nakilah-in, chule nangman papse tah-in suhgenthei tothon na inhengpa-a nalah peh-in, keima neisumil tai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vetan, hijeh-a chu keiman lamdih louva nanalambe hole, nalailung tah-a thisan kisoho chu kakhut kajel khumin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiman nangma kabolchah nikho teng nalungsungin athoh jouva, nakhut teni chu hatjou ding hinam? Pakai keiman hichu kasei ahin, chule hichu katohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman nangma Pathen heloute lah-a kathecheh-a, gamsungho-a kacheh chao sah ding, chule nanga kona nathenlounaho chu kasuh mangding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangmatah in nagou chu Pathen heloute mitmu-a nakilah ding, chule nangman keima Pakai chu kahi nahin hetdoh ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihem chapa, Israel insung chu keima dingin thih eh ahung hitai. Amaho abonchauvin lhum lailung tah-a um sum eng, langva, thih chule ngen ahitaove. Amaho chu dangka eh ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; nangho nabon chaova thih eh nahitah jeh-un, veuvin, hijeh-a chu keiman Jerusalem lailung tah-a nangho kachopkhom ding nahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amahon dangka, sum eng, thih, ngen chule langva, lhumsunga achunga mei amutnuva hichu suhjun dinga achopkhom banguva; chutia chu keiman kalunghan nale kalungsatna-a chu nangho kachopkhom dingu, chule keiman chua chu nangho kadalhah den dingu, kajunlhah sah dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Henge, keiman kachom khom dingu, nachung uva kalungsatna lhummei chu kamut am ding, chule hiche sunga chu nangho najunlhah dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lhummei lailunga dangka ajunlhah banga, chuche lailunga chu nangho najunlhah dingu; chutengle nanghon Pakai keiman nachung uva kalungsatna kasunlhah ahi chu nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihem chapa, amanu henga seijin, nangma lunghanna nikho-a achunga go jengjong julou, suhthenglou gam chu nahije.
  </para>
  <para style="p">
    <verse number="25" style="v" />Keipi bahkaijin anehding abotela akitum bangin, amanu lailunga themgaoho lah-a guhthim thilgon aumin; amahon hinna ho aval lhumun, haonaho le thil lutahho alauvin; chuin amahon amanu lailung tah-a meithai tamtah asemdoh uve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amanu thempuhon keima dan asukeh uvin, kathil thengho asuboh-un; amahon atheng le athenglou akhen pouvin, angim le anen jong akhen pouvin, chule kacholngah nikho ho-a konin amitnu aselmangun, alah uva suhboh-in kaumtai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanu lailunga pipuiho chu thisan sodingle, hinna ho sumang ding, chule alamlouva neibe nadingin, aneh dingu bottela ngeihon abangun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule amanu themgaoho chu chilminlou leinganin akijutnuvin, pannabei jeng amuvin, jouvin ai asanpeh uvin, Pakaiyin aseilou jongle, Pakai Pathen'in hitihin aseije, atiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Gamsung mipi ho chun suhgentheina amang chaovin, guchat michom abolun, vaicha le lhasamho chu asugimun; henge, amahon dihlou tah-in gamchom miho asugenthei jiuvin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule gamsung chu kasuhmang louna dingin, amaho lah-a khattou apal gending le, kamasanga gam huhna-a aonglaija dingding kanaholin, hinlah koima kana mujoupoi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh chun kalung himona achunguva kasunglhan; kalunghana meikonga amaho kasumangin; achonnau dungjuija lethuh nachu achunguva kapeh ahitai, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu kahenga ahung kitnin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, numei ni aumin, minu khat chanu ahilhone.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amanin Egypt'a jonthanhoi anabol lhonin, akhangdonlai lhonin jonthanhoi anabol lhone; hia chun anoi lhon ameh peh-un, nungah theng ahilhona anoimuh hon chu ameh peh-un ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amani min chu alenjonu Aholah ahin, chule asopinu chu Aholibah ahi; amani chu keija ahilhonin, amanin chapate le chanuteho anahing lhone. Amin lhon chu hitihi ahi; Samaria chu Aholah ahin, chule Jerusalem chu Aholibah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Aholah hi keija ahi laijin noti'n anapangin, chule amanun aheng akom Assyria miho akingaipin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho ponduma kivon gal lamkaiho le vaihomho, deichat umtah gal hang sakol chunga tou, sakol touthemho sakol chunga tou ngen ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun amanu chu amaho, Assyria lhendoh tum miho, chule akhohsahho jouse chutoh jonthanhoi anabolin; Alim semthuhou jouse-a chun amanu ana kisuboh tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanun Egypt'a ahin kondohpi ajonthanhoina chu apailhadeh poi: ijeh-inem itile amanu chu akhangdon laija amahon ana luppiuva, anungah theng hina anoi teni amehpeh uva, chule ajonthanhoinao chu amanu chunga ana buhlhah-u ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh-a chu keiman amanu chu akingaipiho khutna kapehdoh ahitan, akhohsah Assyria mite khutna kapehdoh ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiteho hin amanu sagohkeo chu ahoh lha uvin; achapate le achanu teho chu akilah-un, amanu chu chemjamin athat taove. Chutichun amanu numei lah-a ahung minthang tai; ajehchu amanu chunga thutanlhahna aneiju ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule asopinu Aholibah chun hichu amu nungin, amingaina chu asopinu-a sangin akhoh cheh-in, chule asopinu jonthanhoina sangin amanu jonthanhoina chu akhohcheh-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amanun aheng akomho Assyria mite, vethoi tah-a kivon lamkaiho le vaihomho, sakol chunga tou sakol touthemho, deidei um gollhangho jouse chu angaichan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin amanu suhboh-a auma, anilhona lampi khat ajuihon kanamui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amanun pasal ho lim banga kitah, Chaldea miho lim bangchunga sanpeh-a kijih-a amu phatnin, ajonthanhoi naho apunsahbe cheh-in,
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon ataija konggah akigah cheh-un, alu-a delkop hoitah akikop cheh-un, apennau Chaldea gam Babylon miho umdan dungjuija amaho gahvet dinga pipuiho mel pucheh ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amanun amaho amit teni-a agahmu mu chun, achunguva ngaichatna aneipai jengin, chule Chaldea gamsunga amaho henga thupo ho asoltan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Babylon miho chu amanu henga ahungun kingailutna jalkhuna alut uvin, amahon amanu chu ajonthanhoinao vin asuboh uvin; chuin amanu chu amahoto suhboh-in aumin, chule amanu lunggel chu amaho-a konin khendoh ahitan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hitichun amanun ajonthanhoina le sagohkeo ahina ahohdoh tan; hichun kalunggel asopinu-a kona khendoh-a anaum bang bangin, amanu-a konin khendoh-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Achutijeng vanginla, amanun akhangdonlai nikhoho, Egypt gama noti'a anakicheplai chu agahgeldoh kitnin, ajonthanhoina ho apunsah cheh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu amanun adongmaho, atahsao jong sangan tahsa tobang, chule abotwi ujong sakol botwi tobang ho chu angaicha lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun nangman nakhangdon laija najon thanhoina le, nakhangdon laija nanoi teni Egypt miten ameh chu nageldoh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun, Vo Aholibah, Pakai Pathen'in hitin aseije; Ven, keiman nakingaipiho, nalunggel khendoh-a anaum naho chu nangma dou dinga katundoh ding, chule nangma dou dinga gamkai jouse-a kona kahinpui ding,
  </para>
  <para style="p">
    <verse number="23" style="v" />Babylon miho le Chaldea miho jouse, Pekod, Shoa, Koa, chule Assyria mite jouse toh; abonchauva son umtah gollhangho, gal lamkaiho chule vaihomho, milenho le mi minthangho, abonchauva sakol chunga tou ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule amaho nangma doudinga sakol kangtalai ho, thilpo kangtalai ho, kangtalai kangho toh, mihonpi kiloikhom toh hungkon uva, amaho chun lum le pho, chule thih lukhuh atho uva naum kimvel dingu; chule keiman amaho masanga thutanna kapeh ding, chule amahon amaho thutanlhah dungjuija nachung thu atan dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule keiman nangma chunga kathangthipna kachuh sah-a, amahon nangma lunghang tah-a nabol dingu; amahon nanah lhongle nabil teni aloilhah dingu, chule nangma-a ahingdoh umnalai chu chemjam'a louding ahi. Amahon nachapa te le nachanute akilahdiu; chule nangma-a ahingdoh amoh umchengse chu meikouvin avallhum dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amahon naponho nahodohpeh uva, chule nasongmantam hoiho nalahpeh dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutia chu nangma amaho heng lama nakhodah louna dingle, Egypt mite jong nageldoh kit tahlou dinga; keiman najon thanhoina chule Egypt gama kona nahinpoh najon thanhoina chu nanga kona kasuhtang ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh inem itile Pakai Pathen'in hitihin aseije; ven, keiman nangman namuda ho khutna, amaho jeh-a nangma lungsung khendoh-a aumnaho khutna kapehlut ding nahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule amaho chun nangma thet umtah-a nahinbol dingu, chule nalodoh jouse nalahpeh dingu, sagohkeo le keohela nahinlha uva: chule najon thanhoina le nahuhna chu agoma sagohkeova kihohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Keiman hicheho hi nachunga kabol ding ahi, ajehchu nangma Pathen helouho bangin jonthanhoi nabolin, amaho semthu limho-a chun naki suhboh tai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nangma nasopinu lampia nachetan, hijeh-a chu amanu khon chu nangma khutna kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pakai Pathen'in hitihin aseije, Nangman nasopinu khon thuhtah le lentah chu nadonjou hel ding, nangma i-sah louva nuisatna chule nahsahmo-a naum ding ahi, hichun tamtah adol ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangma nasopinu Samaria khon, kidangsahna le thomhaona khona kon, lunggimna le lunghemna nadon ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangman hichu nadonna nachep kanghel ding, chule akhon chu teldeh-a nalha ding, chule na noi teni ngeijong chu naloidoh ding ahi. Ajehchu keiman kasei ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hijeh chun Pakai Pathen'in hitihin aseije, Nangman neisuhmila, nanung lama neipaitah jeh-in, nahuhna le najon thanhoi naho nangman kipohtan.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pakaiyin kahenga aseibe kitnin, Mihem chapa, nangman Aholah chule Aholibah chunga thu natan ding ham? Henge, thet aumnalhon ho chu phondoh pehtan.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amanin jon abol lhonin, akhut lhona thisan aumin, amilim hon hotoh ajonglhonin, chule amanin keima eihinpeh lhon achapatehou jong kahvam sahdin meikong apalsah lhone.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chukalvalin amanin hiche jonghi kahenga abolhone: chule hiche nikho mama chun kamun theng asuboh lhonin, kacholngah nikhoho asuboh lhontai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ajehchu amanin achateu alim semthu henga athajou lhon chun, hiche nikho mama chun ahunglhonin ka-intheng asuboh lhonin ahi; chule veuvin, amanin ka-insung laitah-a hitichun abolhonin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chubanin jong, gamlatah-a kona pasal ho ahungna dingun, ahenguva thupole khat nasolhonin; chule veuvin, amaho ahunguvin ahi. Chuin amaho dingin nangma nakisil theng selin, namit teni najemin, chule jephoina-a nakijemin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule jalkhun guntah khat chunga natouvin, hiche masanga chun dokhang khat nagongin, chule achunga chun nangman keima gimnamtui ho le thao chu natung doh-in ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule khohsahna bei mipi honkhat awgin amanu koma aumuvin; chule akhutnuva chao kibuho chule aluchung uva lallukhuh hoitahtah-a kikhuh gamthipma kona Sebia mite chu milham pasal ho toh ahin puijuvin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chujouvin keiman ajonthanhoi bolna-a tehtasa amanu chungchanga chun, Tun amahon amanu chutoh, amanun amaho chuto jonthanhoi aboldiu vem? kati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ahijeng vangin amaho chu noti numei khat henga lut bangin amanu henga alut taove. Hitichun amaho numei huh teni, Aholah le Aholibah henga alut taove.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule pasal chonphatah hon amanu chunga numei jongho chondan dungjui le, numei thisanso ho dungjuija athu-u atan dingu ahi; ajehchu amani numei jong ahilhonin, chule akhutlhona thisan abeh-in ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ajehchu Pakai Pathen'in hitin aseije; keiman mi honkhat amani chunga kahinpui ding, chule amani chu toldoh dingle chomgam dinga kapehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule hiche mihonpi chun amani songa ase dingu, chule chemjam'a atha dingu; amahon achapateu le achanuteu athagam dingu, chule a-inhou chu meija ahalvam dingu ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hitia chu gamsunga jonthanhoina kasuh tanga, najon thanhoina lhon chu ajuilouna dinguva numei ho jouse kihilchah ding ahiuve.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule amahon najon thanhoina lhon chu nachung lhona alethuh uva, nalim semthu lhonin chonset naho chu nakipoh lhon ding ahi; chutengle keima Pakai Pathen kahi nahet lhon ding ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Avelin, kumko lhinna, alha somna sunga nisom lhinni chun Pakai thu kahenga ahungin, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, nangman nikho min chu jihdoh-in, tuni nikho tah hin jih-in; hiche nikho-a hi Babylon lengpan Jerusalem adoupat ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule golkehjing insung henga thulem khat seipeh-in lang, ahenguva hitin seijin, Pakai Pathen'in hitihin aseije; Belkhat songin, hichu songdoh-in, chule asunga chun twi jong sunglutnin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sa halho asunga chun henglutnin, ahal aphalai jouse, apheipi le adahbul ngei chu asunga chun henglutnin; hichu agu phaho-a chun bel chu dip dimin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gancha hon lah-a konin deilhen ho chu lanlang, anoija chun aguho chu gouvin, chule hichu phatechan honin lang, hichun aguho chu honsouhen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Pakai Pathen'in hitin aseije, thisanso khopi, beltonat asunga umnalai, chule beltonat asunga kona lheidoh loulai chu, ohe ada ahiuve! asunga konin khat khatnin ladoh-in, vang sanin lheng hih-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh-inem itile amanu thisan chu amanu lailung tah-a aumin, hichu amanun songpi khat chunga atungdoh-in, leivuija khu dingin tollah alheilhapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutia chu hichun phula dinga lungsatna ahinsodoh sahna ding, chule amanu thisan chu khukhum ahilouna dinga, keiman songpi chunga kalonsah ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; thisanso khopi chu ohe adana-e! keiman nasatah-a meikou ahina dinga thing kasetvum ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thing sevumun, mei choh kongun, aphe chu phatechan honun, chule phatechan namtui sah-un, chule aguho chu gouvamun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutengle hiche sum-eng chu ahungsat doh-a akahtheina ding, chule asunga athenglou chu ajunlhah-a, atonat chu akahvam theina dingin, mei chunga chun belkeo chu songdoh-in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amanu jouvin akisuchol tan, chule amanu-a konin atonat nasatah chu apotdohpoi; atonat chu meikouva umden hen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nathenlouna-a chun huhna aumin ahi; ajehchu nangma kasuh thengin, hinla nangma nathengpoi, kalungsatna nachunga kangap kahse-a, nathenlouna-a kona nathen kit louding nahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai keiman hichehi kasei ahitai. Hichu hung guilhung ding, chule keiman hichu kaboltei ding, kakinungtol louding, khenjong kakhen louding, kisihjong kisih louding, nalampi ho dungjuile na natohho dungjuija amahon nachung thu atantei dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujongle Pakai thu chu kahenga ahungin, aseije,
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihem chapa, ven, keiman namit tenin avetnom chu khatvei jepmin nangma-a konin kaladoh tai; hijeng jongle nangma lungjong nalunghem louding, ka jong naka louding, namitlhi jong nalonlhah sah louding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kap hih-in, athiho dingin lunghem jong bolhih-in, nalukop nalu-a kikopmin, nakengto teni-a nakengchot kisen, nane jong huphih-in, chule mihem anneh jong nehih-in, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hitichun jingkah-in mipi ho henga thu kaseijin, nilhang kaijin ka-inneipi athitan; chule jingkah-in thu eikipeh bangin kaboltai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin mipi chun kahenga hitin aseijuve, hiche nathilbol hohi keiho dinga ipi ahiding neiseipehlou dingu ham? atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin keiman amaho kadonbut nin, Pakai thu chu kehenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel insung henga seipeh-in, Pakai Pathen'in hitin aseije; Veuvin, keiman kamun theng, nangho nathahat naloupi nao, namitnun avetnomhou, chule nahinnaovin akhoto chu kasuhboh ding, chule nadalhah-u nachapateo le nachanuteu chu chemjam'a loudingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule keiman kabol bang nabol dingu, nanghon namuh-u nahup loudingu, mihem anneh jong naneh loudingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nalu chunguva delkop nakikop uva, chule nakenguva kengchot nakise uva, nalunghem loudiu kajong nakalou dingu; ahia nagitlounaova nalhahsuh uva khatle khat nakilunghem to diu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hitia chu Ezekiel hi nangho dinga melchihna ahi; aman abol hojouse dungjui cheh-a nanghon naboltei dingu ahin; chule hichehi ahunglhun teng, nanghon keima Pakai Pathen kahi nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujongle nangma mihem chapa, keiman amaho-a kona athahatnao, aloupi naova akipanao, amit teniu deichat, chule amahon alunggelu kingapna-a aneihou, achapateu le chanuteu kalahmang nikho tengle,
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche nikho-a asohcha chapa chu hunga, nanakhanga nahung jahsah louding ham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche nikho chule ahung sohchapa henga nakam kihong ding, chule nangman thu naseidoh ding, chule paomo-a naum kit tahlou ding; chule nangma amaho dinga melchihna khat nahung hiding; amahon keima Pakai kahi ahinhet dingu ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu kahenga ahung kitnin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Ammon mite dounan namai ngatnin lang, amaho dounan gaothu seijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Ammon mite henga seijin, Pakai Pathen thuhi ngaijun; akisuhboh laija nangman kamun theng douna-a, chule akamhel laija Israel gamsung douna, chule gal hinga akikai mang laijuva Judah insung douna-a Aha, tia nasei jeh-in, Pakai Pathen'in hitin aseije,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ven, hijeh chun keiman solam mite alo diuva nangma kapehdoh teiding, chule amahon nangma insunga aleng inpihou atundoh dingu; nangma insunga achendetna inhou akisah dingu, amahon naga chu aneh uva chule nanoitwi adontei dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman Rabbah chu sangongsang ho gena buh, chule Ammon mite ganchaho kolna munkhat kahinso ding ahin; chutengle nanghon keima Pakai chu kahi nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Pakai Pathen'in hitin aseije; Nangman Israel gam douna-a nakhut teni nabeh-a, nakeng teni-a nalho-a, chule nalungthima i-sah louna jousetoh nakipa jeh-in,
  </para>
  <para style="p">
    <verse number="7" style="v" />Vetan, hijeh-a chu keiman nangma chunga kakhut kajah-a, chule Pathen helouho henga galthil chom dinga kapehdoh ding; chule keiman mipi lah-a kona kasatlhah-a, gamjousea kona kamanthah sah ding; nangma kasuhmang ding; chutengle keima Pakai kahi nahin hetding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai Pathen'in hitin aseije; Veuvin, Moab le Seir jengin jong, Judah insung chu Pathen heloute jouse tobang ahi tia, asei jeh uvin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun, veuvin, keiman Moab khopi jet le vei jouse, khopi sunga gam nomcheh Beth-jeshimoth, Baal-meon chule Kiriathaim-a jong kamhela kalha ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ammon mite chu namtin lah-a geldoh-a aumkit louna dinguva, solam mite chu Ammon mite toh alo dinguva kapehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman Moab chunga thu katan ding; chuteng amahon keima Pakai kahi akihet dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai Pathen'in hitihin aseije; Edom'in phulah na-a Judah insung douna abola, hatah-a asuhmoa, ama tah-in achunguva phu alah jeh-in,
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun Pakai Pathen chun hitin aseije; Kenjong Edom chunga kakhut kalapma, ama-a kona mi le sa katha gama, Teman kho-a patna kakamhelsah-a, Dedan'a miho chu chemjam'a louding ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Edom chunga kaphulahna chu kami Israel khutna kangap ding ahin, chule amahon Edom chunga kalunghana le kalungsatna dungjuija aboldingu; chule kaphulahna chu amahon ahet dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai Pathen'in hitihin aseije, Philistine ten phulahna anaboluva, chule taitomna lunggel totho-a malai kihotna jeh-a susehel khop dinga anakiphulah jeh-un,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; Veuvin, keiman Philistine te chunga kakhut kajahdoh-a, Cherethim ho chu kasuhtana, twipi panga um amohho chu kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule keiman lungsa tah-a phosalnaho toh tho-a amaho chunga nasatah-a phu kalah ding, keiman amaho chunga phulahna kachuhsah teng, amahon keima Pakai kahi chu ahet dingu ahi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kum somle kum khatna, lhasunga ni masapen nin ahung hitin ahi, Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Tyre'in Jerusalem douna-a, Aha, amanu mite kotpiho anahisa chu achimlhatai! amanun keilam ahin ngatai: tun amanu kitung thop ahitan, keima kapun theiding ahitai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; Vo Tyre, ven keiman nangma kodou nahi, twipin twi akinon tousah banga, nangma kidoupi dinga nam tamtah kahin toltou ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahon Tyre kulbang jouse asuhsetnuva, amanu insangho asuhchim diu, keiman amanu-a kona vutvai kaphet thenga, chule amanu chu songpi chungvum tobang kaso ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichu twipi lailunga lenho kijalna ding mun hung hiding ahi. Ajehchu keiman kaseidohsa ahitai, tin Pakai Pathen'in aseije, chule hichu namtin dinga kivahna hung hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amanu chanute loulaija umho chu chemjam'a kithat gamdiu, amahon keima Pakai kahi ahinhet dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Pakai Pathen'in hitin aseije; veuvin, lengho leng, Babylon lengpa, Nabuchadnezzar chu sakol ho, kangtalai ho, chule sakolchung touho, chule loi tampile mipi tamtah toh lhona sahlam sanga kona Tyre chunga kahinchuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama chun loulaija nachanute chu chemjam'a atha ding; nangma douna-a kulpi asahdoh-a, nangma douna-a molsang khat ase sang ding, chule nangma douna-a apho adop sang ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman nakul bangho douna-a gal manchah ho atundoh-a, chule aheichaho-a na insangho aphuh lhuh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama sakol ho atambehseh jeh-a amaho vutvai chun nangma nakhu khum ding; mihon kohom akisemuva khopi sung alut banguva, ama nakelkot ahunglut tengleh sakol chungtou mihole, kangtalai kangho, chule sakol kangtalai ho hugin-a nakul bangho chu kihot ling ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Asakolho kengin nakhopi lamlenho achotpha ding; aman namiteho chemjam'a atha ding, chule nagalsat miho umna mun dettahho chu chimlha ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amahon nahaonaho chu akichom diu, nakiveinaho anehmanguva, nakul bangho asuhchimdiu, na in nomtah ho chu asuhset dingu: amahon nasongho, nathingho, chule navutvai ho chu twi lailunga akoidiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuteng keiman nalasah ginho kasuhthip ding, chule naselangdah gin chu kijakit louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule keiman nangman songpi chungvum banga kasemding; miho lenthang jalna mun nahiding, sahphatna naum lou ding ahitai; ajehchu Pakai keiman kaphohdoh ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai Pathen'in Tyre henga hitin aseije; mahapuho apena, nalai lunga mithiho aumtengle, nangma lhuh ginna chu twikolho kihotlou dingu ham?
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuteng chule twikhanglen'a leng chapate jouse chu alaltounaova kona hung kumlha dingu, chule asangkhol hou akoidoh uva, akijephoinau avonhou chu asutlhah dingu ahi. Amaho chu kithing thinguva tol lhanga tou dingu, chule amaho tanglou hela kihot hot dingu, chule nangma nadatmo dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule amahon nangma dinga kala aboluva, hitia asei dingu ahi; Itidana twipi chunga lamlhale miho chenna mun, khopi minthang tah, twipi chunga hattah, amale asunga chengho, akimaitopi jouse tijatsah jeng nangma iti kisuhmang nahi hitam!
  </para>
  <para style="p">
    <verse number="18" style="v" />Tu-a nangma lhuhna nikho-a hi twikolho chu kihot hot dingu; chule twipi sunga um twikolho chu nadalhah jeh-a lunggim lheh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu Pakai Pathen'in hitihin aseije; keiman nangma chennalou khopiho, akamhel khopi khatna kahinsem teng; keiman twithuh chu kahinlah touva nachunga kahinlhutna, twi lentah ho chun nahinchup teng;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule keiman nangma kokhuh sunga lhalut ho leh, malaija mipi ho toh kapuilhah khoma, kokhuh sunga chelut ho toh thakhatna nangma chenlouna mun nahina dinga, malaija patna anakamdel leiset mun nempena kakoiteng; mihing gama chu loupina kaumsah ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman nangma tijatna khatna kasemdoh ding, chule nangma naum kit tahlou ding ahi; nangma nahung kihol jeng jongle, kimukit louding nahitai, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu kahenga ahung kitnin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Tyre dingin kala gabolin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Tyre henga hitin gaseijin, O nangma twipi lutna laitah-a um, twikol tamtah-a chengho dinga kiveina, Vo Tyre, Pakai Pathen'in aseije; nangman, Keima melhoi chamkim kahi, tin naseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma gamgi chu twikhanglen lailunga aumin, nasadoh hon nangma melhoi asuchamkim taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon nakong lhongho jouse chu Senir gamsung chahthingho ngenin asemun; amahon nangma ding kong khom kitung sangpen ho semna dingin Lebanon'a konin cedar thingho alauve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nakong kheho chu Bashan gangpiho-a konin asemun, Ashur mi kiloikhom hon Chittim twikolho-a kona kipodoh saiha mangchan tongkham saoho nasempeh taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Egypt'a kona kijempah tupatpon neljet chu nangman nakong ponjal dinga namang chan, Elishah twikolho-a kon pondum le ponsandup chu nangma nakhu-a chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nakong tol ho chu Zidon le Arvad'a cheng miho ahiuvin, vo Tyre nangma sunga um na michingho chu nakong tolho ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gebal'a upalui hole amaho lah-a michingho chu nangma sunga kong thoibit ho ahiuvin; twipia um kong jousele atol ho jouse chu nasumkol veina thilho najohpeh dingin nanga aumuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Persia le Lud chule Phut miho chu nasipai le nagalsat miho ahiuvin, amahon nangma lumle thih lukhuh navonpeh-un, amahon namel lomna atahlang uve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arvad miho chu nagalsat miho toh nakul bangho chung kimvela aumuvin, chule Gammadim miho chu na insangho-a aumui; amahon alumhou nakul bangho kimvel chunga akhaijun, nangma mel hoina achamkimsah-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Haona tincheng; dangka, thih, langva chule ngen atam jal-in Tarshish chu nangma sumkolveina ahin; nangma kailhang-ah akiveijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Javan, Tubal chule Meshech, amaho nasumkol vei miho ahiuvin; amahon nasumkol veina thilho toh mihem le sum-eng kongle bel ho alheh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Togarmah insunga kon amaho chu nakailhang munho-a sakol ho le sakol chung touho chule sangan hon akiveijun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dedan miho chu nasumkol veiho ahiuvin; twikul tamtah chu nangma khutna sumkolvei ahiuve. Amahon nangma saiha, sakiho le thinggai thilpeh-in nahinpohpeh-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Syria chu nangma thilsemdoh tincheng jal-in nasumkol veipa anahin; amahon khisong eng, ponsandup, ponjem kikhuipah, tupat ponnem, song mantam jolsel le song san joh-in nakiveina munho alouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Judah le Israel gam chu nangma sumkol veiho ahiuvin; amahon nangma kailhanga Minnith le Pannang suhlouchang, khoiju le thao, chule thingnailou namtuijin akiveijuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangma thilsem tam jal, Helbon'a ju le samul kang nahaona jouseho jal-in Damascus chu nangma sumkol veina ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dan le Javan nakailhang munho lodingin achesuh achetou lhonin; thih valset, thingle aigeju nakailhanga akimue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dedan chu pon lutahho kangtalai ho-a dinga nasumkol vei ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Arabia le Kedar pipuiho jouse chun kelngoiho, kelngoi chalho, chule keltah hon nakailhang alouvin; hiche thilho-a hi amaho nangma sumkol veiho hia ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sheba le Raamah'a sumkol veiho chu nangma sumkol veiho ahiuvin; amahon nakailhang ho chu song mantam jousele sana in nakailhang ho alotauve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Haran, Kanneh, Eden, chule Sheba sumkol veiho, Asshur chule Chilmad chu nasumkol veiho ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichehohi thil namkim nasumkol veina thilho lah-a pang ahiuve, pondum ho-a, thil kijempah ho-a, cedar thinga kisem, khao hola kikhit, thingkhongho sunga um von lutahho ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tarshish konghon nakailhangah nalachoijun; chule twipiho lailunga nangma nadimset tan, loupitah-a jabolin na-umtai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nakong tol hon twilen sung nahin lhuttan, solam huipin twipi lailunga nasukehtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nahaonaho, nakailhang ho, nakiveinaho, nakong tolho le nakong jap ho, nakong thoibit ho, chule nasumkolveina thil le loho, nasepai gal hat nangma-a umho, nasunga nakiloipiho jousehi, nakisuhmang nikhoteng twipiho lailunga lhalut soh hel dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Akimvela miho chu nakongtol ho pen hugin-a kithing thing ding ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule kongkhe tuhho jouse, kong jap ho, chule twipi chunga kongtol ho jouse chu, akonghouva kona hung kumlha uva tolla ding ding ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule amahon a-awginu nangma douna-a najahsah diu, lhasetah-a penguva, alu chungvum uva leivui athediu, chule leivui lah-a kilih lelediu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amaho nangma dinga kivou toluva, khaodip pon akigah diu, lungna tah le lhasetah-a nakapi diu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amahon kap puma nangma-a dinga kala ahin semuva, nama dinga kala asah dingu, twipi lailunga kisumang Tyre khopi tobang umkha am? tia aseidiu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nathil semdoh ho twipi ho-a kona akitoldoh teng, mi tamtah nadip dimjin; nahaonaho tamtah le nakiveina thilho chun leiset lengho nahaosahjin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Twipihon twi thuhtah ho sunga nahinsuhset tengule, nasumkolveina thilho le nangma lailunga nakiloipiho jouse lhutei dingu ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Twikol gamho-a chengho jousen nadatmo dingu, alenghou kicha lheh jenguva, amaisouva jong lunggim maiso kilang ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mipi ho lah-a sumkol veihon nachehsat khum diu, nangma tijat umtah khat nahi-a, chule imatih-a umkit louhel ding nahitai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu kahenga ahung lhung kitnin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Tyre pipuipa henga hitihin seipeh in, Pakai Pathen'in hitin aseije; Ajehchu nalungthim akichoi sangin, keima Pathen kahi, Pathen touna twipiho lailunga katouve tin naseije, ahin nalungthim Pathen Lungthim tobang hisah jongle chun, nangma mihem nahibouvin, Pathen nahipoi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ven, nangma Daniel sangin nachingjon, amahon nangma-a kona aseljouvu thilguh khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nachihna le nahet themna-in nangman haonaho nakimutan, chule sanale dangka nagouho lah-a nakoitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nachihna sangtah jal le nakiveina jal-in nahaonaho apungin, nahaonaho jeh-in nalungthim akichoisang tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; Nangman nalungthim Pathen lungthim tobang nahisah jeh-in;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ven, hijeh-a chu keiman nachunga gamchom mi namtin lah-a tijat umpenho kahin puilut ding: amahon nachihna melhoi kidoupi dinga achemjam asadoh uva, navah emsel chu asuhboh diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amahon nangma kokhuh sunga nasotlut diu, nangma twiho lailunga kithat ho thi banga nathitei ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nathatpa anga chun, Pathen kahi tin seijin natem? ahinla nathatpa anga chu Pathen hilouva mihem bou nahi ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gamdang miho khutna cheptan louho thia nathitei ding ahi: ajehchu keiman kaseidoh ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chubanin jong Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihem chapa, Tyre lengpa chunga kala bolinlang, ahenga hitin seijin, Pakai Pathen'in hitin aseije; Nangma chamkimna mahor, chihna dimset, hoina chamkim chu nahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangma Pathen hon Eden'a nana umtan; song mantam jat jouse, songsan, song-eng, song mantam, song engdum, songgel, chule song sanpol, song dum, song engdang, song santhip chule sana in nakitomin; chule nakhongcha le natheile ho akisemdan chu nangma nakisem nikho-a nangma-a kigonga ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangma akhukhuma pang thao kinu chu nahin; chutia chu katundoh nahi; nangma Pathen molsang theng chunga nana umin, meisong lah-a nachesuh nachetou vin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma nakisemdoh nikho-a pat, nangma-a themona akimudoh kahsen, nalampi ho-a chamkim nanahin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nasumkol veina thilho tamjeh-in hicheho chun nasunggil chu hunamin adipmuvin, nangma nachonse tai. Hijeh-a chu, Vo akhukhuma pang Cherub, nangma thilboh banga Pathen molsanga kona kapai doh-a; keiman nangma meisongho lah-a kona kasuhmang ding nahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nahoi jeh-in, nalungthim akichoisang tan, navah emsel jeh-in nachihna nasuboh tai; keiman tolla kalelhah ding, lenghon navet theina dinguva, a-angsung uva kajam ding nahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nakiman chahna-a nakhangitlouna tamtah hole, nakiveina khang gilouho-in, namun thengho chu nasuboh tan; hijeh-a chu nalah-a kona mei kahin kondohsah-a, hichun nakahvam ding, chule naveho jouse mitmu-a, vutvai kahin sosah ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mipi lah-a nangma nanahesa jousen nadatmo dingu; nangma tijat umtah nahiding, a-itih-a naum kit louding ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Avelin Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihem chapa, Sidon lam chu maingatnin lang, adounan gaothu seijin,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hitin seipeh-in, Pakai Pathen'in hitin aseije; Vetan, Vo Sidon, keiman kadou nahi, keima nalailung tah-a kaloupi ding ahi; chule keiman amanu chungthu katanna, amanu-a suhthenga kaum tengle, amahon keima Pakai kahi ahetdohdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu keiman amanu sunga hise, chule akhopi lamlen ho-a thisan kalhalut ding; chule maha puho chu amanu lailung tah-a chemjam'a lamjouse-a athu-u kitan ding; chutengle amahon keima Pakai kahi chu ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Israel insung dinga misunthei lingboh, ahiloule akimvela um amaho isahlou jouse-a kona asunna theiju ling kiti khatcha umtalou ding ahi. Chule amahon keima Pakai Pathen kahi ahinhet dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pakai Pathen'in hitihin aseije, Keiman Israel insung chu ana kithecheh nau mipi ho-a kona kahin khopkhom tengle, Pathen hepha louho mitmu-a alah uva suhthenga kaumding; chutengle keiman kasoh Jacob kapeh amaho gamsunga chu chengding ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule amaho hiche sunga chu bitkeija chengdio, inho akisahdoh uva, chule lengpi honho akibol dingu; henge, keiman akimveluva um amaho i-sah louva bolho jouse chunga thutannaho katohdoh tengle, amaho lung noma chengtei ding ahiuve, chule amahon keima Pakai amaho Pathen kahi ahin het dingu ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kum som channa, alhasomna, nisomle nini lhinnin Pakai thu chu kahenga ahung lhungin, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Egypt lengpa Pharaoh lam maingatnin lang, amale Egypt pumpi dounan gaothu seijin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Seiphongin, chule seijin, Pakai Pathen'in hitin seijin; Ven, ama vadungho lailunga lum dragon len, Egypt lengpa Pharaoh, keiman nangma kadou nahi, nangman, Kavadung chu keima-a ahin, keima dinga kakisem ahi, tin naseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin, keiman nakha teni-a ngakoi kabupeh-a, chule navadung ho-a nga jouse chu nalip ho-a kabedetsah ding, chule keiman nangma navadung ho lailunga kona kapuidoh-a, chule navadung ho-a nga jouse chu nalip sunga behden ding ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman nangmale navadung ho-a nga jouse chu, gamthipma kaselutna kadalhah ding; nangma gam ongho lah-a naga chuh-a, nangma nakiloh khom talou ding, nakichom khom talou ding ahi. Keiman nangma gamlah-a sahole, chunga leng vachaho henga a-anneh dinguva kapehdoh nahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Egypt'a chengho jousen keima Pakai Pathen kahi chu ahetdoh dingu ahi, ajehchu amaho chu Israel insung dinga peng tenggol ana hiuva ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon nangma nakhutna natuh uchun, nangman amaho dahbul jouse nasubongin, nabot telin; chule amaho nachunga akingaiju chun, nangman akongbuhhou jouse chu dingjang theilouvin nasubongin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun Pakai Pathen'in hitihin aseije; Ven, keiman nachunga chemjam kahin chuhsah ding, chule nangma-a kona mihem le sahem kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Egypt gam chu kamhela agohkeo hung hiding; chule amahon keima Pakai kahina chu ahin het dingu ahi. Ajehchu aman, Vadung chu keija ahin, chule keiman kanasem ahi, tin anaseijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ven, hijeh chun keiman nangmale navadung ho kadouvin, chule keiman Egypt gam chu Syene insanga pat Ethiopia gam pumpi geija kamhela agohkeohel kahisah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihem koimachan akenga ajot tah louding, sahem kengin jong apaltahlou ding, kum somli sung koima cheng louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule keiman Egypt gam chu agoh-a um gamho lailunga kakamhelsah-a, chule akhopiho chu ahomkeo lah-a kum somli kamhela umding ahi. Chule Egypt miho chu namtin lah-a kithecheh ding, gamho chansoh-a kathe thang ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahijeng vangin Pakai Pathen'in hitihin aseije, Kum somli ahung beitengleh keiman Egypt miho chu thecheh-a aumnao miho lah-a kona kachopkhom ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule keiman Egypt sohchana chu kahin lepui kitna, chule amaho chu Pathros gamsung, amaho chenkhum gamsungtah ngeija kakile sahkit ding; chule amaho hichea chu lenggam nemcha hiding ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichu lenggam ho lah-a anempen hiding, ahiloule namho chunga jong ama kichoisang joukit talou ding ahi. Ajehchu keiman amaho chu kasuhnem ding, chutia chu amahon namtin chunga vai ahom kit tah lou dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule amaho Israel insung dinga tahsanna umkit taloudiu, amavang amahon ajuigot tengule akhangit lounao geldohna bep hidingu ahitai. Chutengle amahon keima Pakai Pathen kahi ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, kum somni le sagi lhinna lha masapen, alhasunga nimasa pen ni chun Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihem chapa, Babylon lengpa Nebuchadnezzar'in Tyre dounan agalmiho natoh lentah anatohdoh sah-in; Luchang takip chu veltolin aumtan, chule lengkou takip akoh-in ahi. Ahijeng vangin ama ahin, agalsat miho ahiuvin, Tyre'a konin hiche douna-a anatohnauva hin tohman asangpouvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Pakai Pathen'in hitihin aseije; Ven, keiman Egypt gam chu Babylon lengpa Nebuchadnezzar henga kapeh ding; aman ahaonaho jouse chu alahding, galthil achomding, chule achomgam helding; hicheho chu agalmiho dinga thaman hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keiman atohman dinga Egypt gam chu ama kapeh ahitai, ajehchu keima dinga na eitoh peh-u ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche nikho tengchule keiman Israel insung ki chu kadondoh sah ding, nangma amaho lailung tah-a paodoh jouna kapeh ding; chule amahon keima Pakai kahi ahet dingu ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu kahenga ahung kitnin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, gaovinlang seijin, Pakai Pathen'in hitin aseije; Ohe hiche nikho chu adana-e!
  </para>
  <para style="p">
    <verse number="3" style="v" />Nikho chu ahung naitai, Pakai nikho ngei chu ahung naitai, hichu meikai nikho hiding, Pathen helouho phat hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Egypt chunga chemjam hung lhung ding, chule akithat ho Egypt'a alhuhgem phat teng, Ethiopia sunga thohnatna nasatah hung umdoh ding, chule amahon amanu mitampi ho chu alahmang uva, akibulphu naochu kisuchim ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ethiopia, Libya le Lydia, chule mipi choplopho jouse, Chub, chule gamsunga miho apangkhomho chu, amahotoh chemjam'a lhukhom dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin hitihin aseije, Egypt tuhdet hojong chu lhutei ding; chule amanu kiletsahna athaneina chu lhasuh ding ahi: Syene insanga kona amaho hia chu chemjam'a loudiu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule akamhel gamho lailunga amaho kamhel diu, chule akhopihou chu agohkeosa khopiho lailunga umding ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman Egypt gamsunga mei kati-a, chule apanpiho jouse kahin suhmang tengle; amahon keiman Pakai kahi ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche nikho chule mikituplou Ethiopia mite kichatsahna dinga, keija kona thupole ho kong inneija chedoh diu, chule Egypt nikho-a banga, thohnatna nasatah hunglhung ding ahi; ajehchu ven, hunglhung ding ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai Pathen'in hitin aseije, Keiman Egypt mihonpi jong chu, Babylon lengpa Nebuchadnezzar khutna katansah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amale aumpi mite, namtin lah-a kichat umtahho chu gamsung sumang dinga kapuilut ding, amahon Egypt douna-a achemjamu aloidoh uva, gamsung chu mithi adip dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule keiman vadungho kakansah-a, agam chu migilouho khutna kajohdoh ding ; chule agam chu asunga umho toh, gamdang miho khutna agoh-a kalha ding ahi; Pakai keiman hichu kaseidoh ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai Pathen'in hitin aseije; Keiman lim semthuho jong kasuhset ding, chule Noph gama amilimhou kasuhbei ding; chule Egypt gam pipui kiti chu umkit talou ding ahi. Chule Egypt gamsunga tijatna kachuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathros chu agoh-a kakoija, Zoan gamsung meija kahal ding, chule No khopi-a thu katan ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman kalungsatna chu Egypt thahatna Sin chunga kasunlhah-a; No mite tampiho chu kasuhbei ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keiman Egypt meija kahal ding; Sin'in nat genthei athoh ding, No chu kehso-a umding, Noph'in nitina gimgenthei naho anei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aven le Pibeseth'a gollhangho chu chemjam'a lou dingu, hiche khopiho hi sohchanga cheding ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Egypt namkoljon ho kavohboh teng, Tehaphnehes'a jong nisa thim ding; chule alungtahna thahat chu kisubei ding; amanu vang chu meibolin tomintin, achanute sohchanga chediu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitia chu Egypt sunga thutanna kabol ding, chuteng amahon keima Pakai kahi ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule kum somle kum khat lhinna, alha masapen nisagi nin Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihem chapa, Egypt lengpa Pharaoh khut chu kahehbong tai; chule ven, hichu adamdoh dinga kitom kitlou ding, akanjang nadinga molbong kimang louding, akhutchu chemjam tuhkit thei dinga kihatsah louding ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun Pakai Pathen'in hitihin aseije; Ven, keiman Egypt lengpa Pharaoh kadouvin, chule aban janga aban thahat kasuhboh kit ding; chule akhutna kona chemjam kalhah mangsah ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule keiman Egypt miho chu namtin lah-a kathecheh-a, gam jouse-a kathe thang ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule keiman Babylon lengpa ban teni kahatsah-a, kachemjam akhutna kakoi ding; amavang keiman Pharaoh ban teni kasuhboh-a, ama thina khopma mahapuho banga ama anga peng ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla keiman Babylon lengpa khut teni kahatsah-a, Pharaoh ban teni lhasuh ding; chule keiman kachemjam Babylon lengpa khutna kakoi teng, amahon keima Pakai kahi ahet dingu, chule aman hichu Egypt gam chunga ajah teng, Keima Pakai kahi ahetdingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Egypt miho chu namtin lah-a kathecheh-a, gam jouse-a kathe thang ding, chule amahon keima Pakai kahi ahet dingu ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule kum somle kum khat lhinna, lha thum channa, alhasunga nikho masapen nin Pakai thu chu kahenga ahungin, aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Egypt lengpa Pharaoh le amihonpi henga seipeh-in, Nalet na-a hi koito nakibah em?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ven, Assyria chu Lebanon'a um cedar thing ahin, abahho ahoija hoi, gam manglah limsah jou, chule sangtah ahin; ajihhui chu abahho jouse sangin asangjon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Twiho chun lentah ahisah ahin; leinoi'a twihon sangtah ahisah-a aphung kimvela chu avadung lenho longkimvela, chule gamlah thingphung jouse-a dinga avadung neoho alon sah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun asan chu gama thingphung ho jouse chungvuma akitung sangin, chule abohho jong apungin, twi atam jeh-in abahho ahung kikapdoh phatnule asaotheijun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chunga leng vacha jouse aboh lah-a abusan; chule abahho noija chun gamsa jousen nou aneijun, chule alim noija chun namlenho jouse achenguve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abahho saona chun aloupina chu aletna-a amel lomsah-e: ajehchu ajung chu twilenho panga kikho ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen hon sunga cedar thingphung hon ama aseljoupoi: chahthingho chu ama bahho tobang ahipon, belkanho jong ama bahho tobang ahipon; Pathen hon sunga thingphung khatcha jong ama tobanga hoi aumpoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eden'a thingphung jouse, Pathen hona kehho chun ama athang thipna dingun, keiman abah tamtah-a chun thingphung chu kasem hoijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; Nangma sangtah-a nakidop sanga, abah bit lah-a alehhui akikhodoh-a, asanna-a chu alungsung akichoi sang jeh-a;
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh-a chu keiman Pathen helou thaneitah khat khutna ama kapehdoh ahin; ama chun tahbeh-a ama abolset ding ahi. Keiman ama chu agitlouna jeh-a kadeldoh ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule gamdang miho, namtin lah-a tijat umchun ama asuhmanga, adalhah ahitai: molsang ho chungle phaicham jouse-a abahho jouse alhatan, chule abahkai hochu gamsung vadungho jousen asubongtan, chule leiset mite jouse alima konin apotdoh-un, adalha taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama manthah na chunga chu chungleng vacha jouse umden ding, chule gamsa jouse chu abahho chunga chu umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khonung le twiho panga thingphung ho jouse atunu asan vanga akichoisang louna diu, alehhui ju abahhou chunga adodoh louna ding, twi dona thingphung jouse hichan geija chu asanlouna dinga chutia chu uma ahi. Amaho leiset noilama kumsuh-a mihem chate lah-a kokhuh-a kumlha ho toh abonuva thina-a thakhatna kipelutna ahitaove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai Pathen'in hitin aseije; Ama thikholkhul sunga akumlhah ni chun kalunghemin ahi. Amaho dingin twi thuhlai kanakhu khumin, twi sohlai kanatuh tangin, twilen tahtah ho akitingden tai. Chule keiman ama dingin Lebanon kalunghem sah-in, gama thingphung jouse ama dingin angoilha-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman ama kokhuh sung lut ho toh thikholkhula kalelut tha phat chun, ama lhuh ginin nampiho kakithinsah-in; Eden'a thingphung jouse, Labanon'a thingphung pha jouse, chule twi don jouse chu, leiset noilam gambehho-a lhep lungmonga umding ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho jong chu amatoh thakhatnin chemjam'a kithatsaho henga thikhol khul'a akumsuh-un; chule amaho chu ama khutna pangho, Pathen helou lah-a ama le-lima chengho ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Eden'a thingphung hoitah ho lah-a hoichepen tochu nangma loupi le letna toh kibang am? hijeng jongle nangma Eden'a thingphung ho toh leiset noilama pohlhah-a naum ding; nangma cheptan louho lailung tah-a chemjam'a kithat ho toh nalup ding ahi. Hichehi Pharaoh le amihonpi jouse chu ahi, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kum somle kumni, lha somle lhani channa, alhasunga nikho masapen nin ahitin ahi, Pakai thu chu kahenga ahungin, aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Egypt lengpa Pharaoh dingin kala bolin lang, ahenga seipeh-in, Nangma nampiho keipi bahkai chal donglai tobang nahin, twipi noija ngapi tobang nahi: nangma na vadunglen hotoh nahung doh-in, nakengin twiho chu nachoh lingin, chule avadunglen hou nasuneh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai Pathen'in hitin aseije; Hijeh-a chu keiman nangma chunga mihonpi toh kalen kahinkhu ding, amahon nangma kalen sunga nahin kaidoh dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuteng keiman nangma tolla kadalha-a, gam onga kapaidoh ding, chule keiman chungleng vacha jouse nachunga kachuh sah-a, leiset pumpi-a gamsa jouse vahna-a kanei ding nahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman molsang chungho-a natahsa kalupsah ding, chule phaicham ho chu nalongin adip ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman natwi japna gamsung chu molsang ho geija nathisana kachap ding; chule vadungho chu nangma-a dim ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule keiman nangma kapuidoh tengle, van chu kakhu khuma, ahsi ho chu kathimsah ding; nisa meiloma kakhu-a, lhathah-in jong avah asodohsah louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Van'a vahho jousen nachunga thim ajinsah ding, nagamsunga thimjing ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman namtinho lah-a, nangman nanahet khahlou gamsungho-a nangma suhmangna kahin lhunsah teng, mihem tamtah kalungjin sah ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Henge, keiman mihem tamtah chu nangma kadatmosah-a, chule alenghou jong a-anguva kachemjam kapei tengle, nangma jeh-a hatah-a tija dingu; chule nalhuh nikhoteng chule amitakip ama amacheh hinkho dinga aphat tina kithing thing dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Pakai Pathen'in hitin aseije, Babylon lengpa chemjam chu nachunga hung chuding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Galhat ho chemjam'a namihonpi chu abonchauva, namtinin akichat penhou chu kalhuhsah gamdiu; amahon Egypt mite hoithona asuhbeijuva, chua mihonpi chu asuhmanghel diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman atuilen pangho-a sahem jouse kasuhmang ding; mihem kengton jong achotneh tahlou ding, sahem kengphangin jong achotneh tahlou ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuteng keiman atuiho kathuhsah-a, avadunghou chu thao banga kalonsah ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman Egypt gam chu agoh-a kahinlha-a, agam sunga dimsetna um thiljouse kalahdohpeh-a kasuh lamvaija, keiman chuche sunga chengho jouse kathagam tengle, amahon keima Pakai kahi ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichehi alunghempi dingu lunghemna chu ahi: namtin chanuten amanu alunghempi dingu: amaho amanu dinga lunghemdiu, Egypt dinga jong chule amanu mihonpi jouse dinga jong lunghemdiu ahi, tin Pakai Pathen'in aseijin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitijong hin kum somle kumni lhinna, alhasunga nisom le ninga ni chun ahung hitin, Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihem chapa, Egypt mihonpi ho dingin pengin, chule amaho ahin, amanu tahngei jong, chule nampi minthangho chanute chutoh, kokhuh-a chelut ho toh, leinoi gamleiset lama seplut khomtan.
  </para>
  <para style="p">
    <verse number="19" style="v" />Melhoina-a nangman koi nakhokhel em? kumsuh-in lang, cheptan louho toh lumkhom tan.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaho chu chemjam'a kithatsaho lah-a lhudiu, amanu chemjam'a kipedoh ahitai; amanu le amilhonpi jouse loilutnin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihat ho lah-a mihatpa chun thikholkhul lailunga kona, ama anakithopiho chutoh ama thu aseidiu: amaho akumsuh-un, chemjam'a kithat cheptan louho toh alumtaove, atidiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Asshur le amanu loiho hia chun aumun; amapa lhankhuh ho chu akimvela aumin; abonchauva akithatsa, chemjam'a lou ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Alhankhuhho kokhuh pangho-a aumin, chule amanu loiho chu amanu lhankhuh kimvela aumuve; abonchauva akithatsa, chemjam'a lou ahiuvin, mihing gama tijatna sosah ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuachun Elam aumin chule amihonpi chu alhankhuh kimvela aumun, abonchauva akithatsa, chemjam'a lou, leinoi gama cheptan louva kumsuh ho, mihing gama tijat sosah ho ahiuve: ahijengvangin amahon ajumnau chu kokhuh-a kumsuh ho toh apokhomun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amahon akithatsaho lailunga chun amihonpi toh amanu chu jalkhun adopeh-un ahi. Amanu lhankhuh ho chu akimvela aumin, amaho abonchauva cheptanlou, chemjam'a lou ahiuve: mihingho gama chu mi atijatsah jeng vangun, amahon ajumnau chu kokhuh sunga lhalutho chutoh apokhomun, amapa chu akithatsaho lailunga chun akoijun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuachun Meshech, Tubal chule amanu mihonpi chu aumin; amanu lhankhuh ho chu akimvela aumin, amahon atijatsahnau chu mihing gama asosah jeng vangun, amaho chu abonchauva cheptanlou, chemjam'a lou ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule amaho chu agalmanchah hou toh thikholkhula kumsuh cheptanlou thaneitah ho toh lumkhom louding ahiuve. Amahon achemjamhou akikhap cheh-un, amaho mihingho gamsunga thahat tahho tijatsah hijeng jongleu, akhangit lounao chu aguhou chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Henge, nangma cheptan louho lailunga suhgepma naum ding, chule chemjam'a kithatsaho toh nalupkhom ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chua chun Edom, amanu lengho le apipuiho jouse, athahat lheh vanguva chemjam'a kithatsaho alupsah naova chu lum ahiuve: amaho chu cheptan louho, chule kokhuh-a lhalut ho toh lumkhom dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sahlama pipuiho abonchauvin, chule Sidon mite jouse, akithatsaho toh kumsuh ho chu chua chun aumuvin; athahat jeh uva tijatna aboldoh-u chun amaho ajumso taove; chule amaho cheptan louvin chemjam'a kithatho toh alumkhomun, chua chun ajumnau chu kokhuh-a kumsuh ho toh athoh khomun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pharaoh chun amaho amuding, chule amihonpi jouse chunga Pharaoh tahngei le agalsatmi achemjama kithat ho jouse chu lhep lung monga umdingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu keiman kasuh tijatna chu mihing gamsunga kalensahtan; chule ama Pharaoh tahngei jong chule amihonpi jouse chu cheptan louho lailunga, chemjam'a kithatsaho toh kilupkhomsah ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Avelin Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, namite chate henga seijin, Keiman gamkhat chunga chemjam kahin lansah-a, agam sunga mipite chun amaho gamkol sunga mikhat alhendoh uva, chule ama chu amaho ngahtupma atundoh tenguleh, ama chu seipeh in;
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman gam chunga chemjam ahunglan amu-a ahile, sumkon chu amutna, chule mipi ho chu akiginsah ding;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutengle koi hileh sumkon gin chu jana-a, gihsalna donlou chu; chemjam chu ahung lhunna, ama chu alahmang tah-a ahile, ama thisan chu ama luchunga bou chuding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman sumkon gin chu jahenlang, ahinla kigin ding anadon tahihle; ama thisan chu ama chunga bou chuding ahi. Ahinla gihsalna anakisanpa chun ahinna akihoidoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla ngahtuppa chun chemjam hunglang ding chu amua, ahia sumkon amutlouva, chule mipite chu gihsal louva auma: chemjam chu ahunglhun tah-a, amaho lah-a khatpen pen chu alahtah-a ahile, ama chu ama khangitlouna-a kilamanga ahitai; ahinla ama thisan chu keiman ngahtuppa khutna kangeh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuobang chun nangma, vo mihem chapa, keiman nangma Israel insung dinga ngahtup pa-a katundoh nahitan; hijeh-a chu nangman kakama thu chu najah ding, chule amaho chu keija kona nagihsal ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman migiloupa henga, Vo migilou, nangma nathi teiding ahi, tia kasei teng; nangman migilou chu alampia kona akihei mangna dinga nagihsal louva ahile, ama chu akhangit louna-a chu thitei ding ahi; ahinla ama thisan chu nangma khutna kangeh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivanga nangman migilou chu alampia kona akihei mangna dinga nagihsala; ahivanga ama chu alampia kona akihei mang loule, ama chu akhangit louna-a chu thitei ding ahi; ahinla nangman nahinna nakihuh doh ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun, vo mihem chapa, nangman Israel insung henga seijin; nanghon, Keiho suhkhel naho le chonset naho chu kachung uva achuh-a, hicheho-a chu kichaipai ding kahiule, iti kahinjou dingu ham? tin naseijuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho henga chun seijin, Keima kahin bang ngeijin, tin Pakai Pathen'in aseije; Keiman migilou thina-a hin lunglhaina kaneipon; migilou chu alampia kona ahung kiheija hina anei dingjoh chu kalungdei ahi. Vo Israel insung, nangho kiheijun, nangho nagitlounahou lampia kon chun kihei mangun, ajehchu ipi dinga nathi diuham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun nang mihem chapa, namite chate henga chun seijin, michonpha chonphatna chun suhkhel nikho-a ama alhatdoh lou ding ahi. Migilou gitlouna chu ahile, agitlouna-a kona ama akiheimang nikho-a chu chuche jala chu ama lhulou ding; michonpha chu ahung chonset nikhole achonphat vanga chu hing louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman michonpha henga ama hingtei ding ahi, tia kasei tengle; aman ama chonphatna akisonpi-a, khangit louna abola ahile, achonphatna jouse chu kigeldoh lou ding; ahinla khansetna abol jeh-a chu, ama thitei ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule keiman migilou henga, Nangma nathitei ding ahi, tia kaseipeh tengle; ama achonsetna-a kona akiheimanga, chule danin aphal le adih chu abola;
  </para>
  <para style="p">
    <verse number="15" style="v" />Migilou chun thil kitung chu alepehkitna, achomdoh chu alepeh kitna, hinkho dan kisem ho-a chu achea, khangitlouna abolda le; ama tahbeh-a hingtei ding, thilou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chonset naho anabolho khatcha jong ahenga kiseipeh louding ahitai. Aman danin aphal le adih chu abol ahitan, ama tahbeh-a hingtei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijongle namite chaten, Pakai lampi chu akibangpoi atiuve, ahinla amaho-a dinga chu amaho lampi joh chu kibanglou ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Michonpha chu achonphatna-a kona akiheimanga, khansetna chu ahinbol le, hia chu ama thitei ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla migilou chu agitlouna-a kona akiheimanga, chule danin aphal le adih chu abola ahile, ama hichea chu hingtei ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahijengvangin nanghon, Pakai lampi chu akibangpoi nati uve. Vo nangho Israel insung mite, keiman nangho nabon chaova khatcheh-a nachonnao dungjuija nathu-u katan ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin kasoh channao kum somleni lhinna, lhasomna, chuche lha ani nga nin, Jerusalem'a kona hoidoh mi khat kahenga ahungin, Khopi chu achimtai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun nilhah lamin ahung sohchapa hung masangin Pakai khut chu kachunga ahung kingamin, chule kakam akihon sahtai; chutichun jingkah-a sohchapa kahenga ahung chun, kakam akihongin, paomon kaum tapoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihem chapa, Israel gam agohkeosa loho chun aseijun, Abraham chu khat ahin, aman agam chu gouva analo ahin; ahinla keiho tampi kahiuvin, gamsung hi keihon gouva kalodiuva eikipeuva ahi, atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun amaho henga seipeh-in, Pakai Pathen'in hitin aseije; Nanghon thisantoh naneh thaovin, chule namilim semthu-u henglam namitnun nagah veuvin, thisan nasouvin; achutile gam chu nalo dingu hinam?
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangho nachemjam chunguva nakisong un, thet umtah natong doh-un, chule amitakipmin a-inhengpa inneipi nasuboh-un; achutile gam chu nalo dingu hinam?
  </para>
  <para style="p">
    <verse number="27" style="v" />Amaho henga nangman hitihin seijin, Pakai Pathen'in hitin aseije; Keima kahinjing bangin, tahbeh-in akisuse gamsungho-a umho chu chemjam'a lhutei dingu, chule koihile gam onga uma chu keiman gamsaho vallhum dinga kapeh ding, chule kulpihole song kohom sunga umho chu hise-a thitei ding ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu keiman agam chu hatah-a kasuh kamhel ding, chule amanu hoithona chu kasuhtang ding; chule Israel molsang ho chu kamhel ding, koiman apalpa louding ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutengle keiman amahon atohdoh-u thet umtahho jouse jeh-a, agam chu kamhela kalha teng; amahon keima Pakai kahi chu ahinhet dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chujongle, nangma mihem chapa, namite chate chun bang panghole in kot ho sunga nangma dounan akihoulimun, chule khatnin khat henga, amitakipmin asopipa henga, Hungin, nahenga katao ahi, Pakaiya kona hungsoh doh thu chu ipi ahi hung jatemin, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule amaho nahenga mipi ho hung bangin ahungun, chule amaho kamite bangin namasanga atouvun, chule nathuseidoh ho angaijun, ahinla amahon hicheho chu abol loudiu ahi. Ajehchu amahon akam sungun hatah-in ngailutna avetsah-un, ahinla alungsunghou chu apapsetnao lama achegam tan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule vetan, nangma amaho-a dingin aw ngeitah neija, la ngeitah sa-a, chule tumging phatah-a tumthei tobangbou nahije; ajehchu amahon nathuseiho angaijun, ahinla hicheho chu abol pouve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule hichehi ahunglhun tengle, (ven hichehi hunglhung tei ding ahi,) chuteng amahon amaho lah-a themgao khat anaume ti ahet dingu ahi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Israel kelngoi chingho dounan gaothu seijin, gaovin lang amaho henga hitin seijin, Pakai Pathen'in kelngoi chingho henga hitihin aseije; Israel kelngoi chingho amahole amaho kivahho chu Ohe adau ahi! kelngoiching ho chun kelngoiho chu avah dingu hilouham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon athaothao nane uvin, chule amuluva chun nangho le nangho nakivon un, alah uva athao thao nathat uvin; hinlah kelngoi hon chu navah pouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Veise-a nathahatsah pouvin, adamlouva nasudam pouvin, akisukhaho jong natompouvin, akinomangho jong nahin lepui kit pouvin, amanga jong nagahol pouvin; ahinla hunam le engsetnin vai nahomjiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amaho kelngoi ching umlou jeh-in achehchau uvin; achehchau phatnun, gama gamsaho jouse anneh ahunghi taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kakelngoite molsang ho jouse le lhangsang tin chunga avahle taove: henge, ka kelgnoi hon chu leichung jouse-a akithe thangun, amaho chu gahol le-a gamudoh-a koimacha aumpoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun, nangho kelngoiching ho, Pakai thusei ngaijun;
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai Pathen'in hitihin aseije, Keima kahinjing bangin, Veuvin, kelngoi ching umlou jehle, kelngoi chinghon ka kelngoi ho ahol loujeh-u, chule kakelngoi honho vah tahsanga, amahole amaho akivahjoh jeh-un; kakelngoi honho gamsa tincheng anneh le anchah ahung hitaove;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun, vo nangho kelngoi chingho, Pakai thu ngaijun;
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai Pathen'in hitihin aseije, Keima kahinjing bangin; Veuvin, keiman kelngoi chingho chu kadou ahi; Keiman amaho khutna kakelngoi honho kangeh-a, kakelngoi hon avah naojong kasuhtang ding; kelngoi chingho chu amahole amaho kivahkit louding ahi; ajehchu, ka kelngoi ho chu amaho anneh ahilouna dinguva, kelngoihon chu akamuva kona kahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Pakai Pathen'in hitihin aseije; Veuvin, keima, keimatah-in, ka kelngoi ho chu kahol le-a, kamudoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kelngoi chingpan akelngoiho chehchau nikho-a akelngoi honho aholdoh banga; keiman jong ka kelngoi ho kaholdoh-a, meijinle thimjin nikho-a jong acheh chaunau mun jouse-a kona kahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keiman amaho milah-a kona kahinpuidoh-a, gamkaiho-a kona kahin chopkhom ding; amaho gamsung ngeija kahin puilutna, amaho chu Israel molsang ho chung vadungho panga le, mi chenna gamsung mun jouse-a kavah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiman amaho chu hamhing phalah-a kavah-a, Israel molsang ho chung chu amaho hongsung hiding ahi. Chuachu amaho hong phatah-a kol uva, Israel molsang ho chung hamhing phatna-a kivahding ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman kakelngoi honho vah ingting, chule amaho chu kakolsah ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman amangsa chu kahola, anakinomangsa chu kahin lepui kit ding, akeng anabongho chu katom kitna, chule ana-a chu kathahatsah ding ahi. Ahinla keiman athaoho le ahat ho chu kasuhmanga, amaho chu thutan na-a kavah ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule, Vo ka kelngoi ho, nangho chungthua Pakai Pathen'in hitihin aseije; Veuvin, keiman ganchaho le ganchaho kikah, chule kelngoi chalho le keltah chalho kah-a thu katane.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hamhing phatah gah nehchai jenga, hamhing pha nanehmoh chengse nakengtouva nachil dingu chu thil neocha-a nangaitouva, chule twi thuhtah ho-a kona nadon uva, amoh chu nakengtouva nasuhneh dingu chu thil neocha-a nangaitou ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima kelngoihon vang, nakengtouva nachilu hamhing chu aneh-u ahin, nanghon nakengtouva nasuhneh-u twi chu adonu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun Pakai Pathen'in amaho henga hitihin aseije; Veuvin, keima, keima tah-in, gancha athaoho le agongho kah-a thu katan ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nanghon napang hou le nalengkou uva nano uva, chule adamlou jouse gamtina achehchau kah seuva naki houva nata jeh-un;
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun keiman kakelngoi honho kahuh doh-a, anchah-a pangkit talou dingu; chule keiman gancha le ganchakah-a thu katan ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule keiman amaho chunga kelngoiching khat katundoh ding, aman amaho chu avah-a, kasoh David ngei jong avah ding; chule aman amaho chu avah ding, chule ama amaho chingpa hiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Pakai keima hi amaho Pathen kahia, chule kasohpa David chu amaho lah-a pipui hiding ahi; Pakai keiman hichehi kaseidoh ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule keiman amahotoh chamna thulhun khat kasem ding, chule agamsunga kona sahem gilouho kasuhthip ding; chule amaho gammang sunga ihmuva, gamthip sunga bitkeija cheng dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keiman amahole kalhangho kimvela munho chu phattheina khatna kasem ding; chule keiman gohong chu aphatcha kajuh lhah sah-a, phattheina gohong hungju ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule gama thingphungin aga ahinsosah ding, chule leisetnin aga ahinsosah-a, agam sunguva bitkei diu; keiman anamkoljon khaovu kasuhtana, soh-a bolho khutna kona kahuhdoh tengle, keima Pakai kahi chu ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule amaho Pathen heloute anchah hikit taloudiu, ahiloule gamsung sahon jong amaho abahgam kit tahlou dingu; amavang bitkeija chenguva, koimachan amaho asuh tijat lou dingu ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule keiman amaho dinga thingnou minthang tah khat katundoh ding, chule amaho chu gamsunga kelin athagam lou dingu; chule Pathen hephaloute khutna kon jum le ja athohkit lou dingu ahitai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutia chu amahon keima Pakai amaho Pathen kahin, amaho kaumpi ji-e ti ahet dingu, chule amaho, Israel insung ngei jonghi keima mite ahiuve, ti akihetdoh dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule ka kelngoihon, ka hamhing lah-a kelngoihon chu mihem ahiuvin, chule keima nangho Pathen kahi tin Pakai Pathen'in aseije.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin Pakai thu chu kahenga ahungin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Seir molsang chu maingatnin lang, ama dounan gaothu seijin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hitihin seijin, Pakai Pathen'in hitihin aseije; Ven, Vo Seir molsang, keiman nangma kadouvin, chule nangma douna kakhut jah-a, nangma kakamhelsah ding nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman nakhopihou agohkeova kalha-a, nangma nakamhel ding, chule nangman keima Pakai kahi chu nahet ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu nangman kumkho-a mudana naneijin, ahamset nikho laijun, chule akhangit lounao kichai phatnin jong nangman chemjam thahatnin Israel chate thisan nason ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun, keima kahinjing bangin tin Pakai Pathen'in aseije, nangma thisan sona lama kagontei ding nahin, thisanin nanungdel peh ding; nangman thisan jong nahot tahlou jeh-in, thisan ngeijin nanung delpeh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitia chu keiman Seir molsang chu kasuhkamhela, ama-a kona potdohpa le ahung kilekitpa chu kasuhbei ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman ama molsang ho chu ami kithat ho-a kadip ding; nalhangho le na phaicham ho, chule vadungho jouse sunga chemjam'a kithat ho chu lhudingu ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman nangma kumkho-a kamhela kalha-a, chule nakhopiho chu hungkile kit louding; chutengle nangman keima Pakai kahi chu nahetdoh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nangman, hiche nam teni le hiche gam tenihi keija hiding ahin, chule chua Pakai umnaho chu keihon kalo diu ahi, tin naseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun, keima kahing jinge, tin Pakai Pathen'in aseije, nangma amaho hotna-a namanchah nalunghan dungjuile nathangthipna dungjuija nachunga kaboltei ding ahin; chule keiman nathu katan tengle, alah uva keile kei kakihetsah ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman keima Pakai kahi chu nahet ding ahi. Chule Israel molsang ho douna-a, amaho agoh-a um ahitai, amaho suhmang dinga eiho eipeh-u ahitai, tia taitomna thu nanasei jouse chu kanajah ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiti chun nakam sungin keima dounan nahoithon, chule keima dounan nathusei napunsah-in, hicheho chu kajasohtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai Pathen'in hitihin aseije; Leiset pumpi ahung kipa tengle, keiman nangma kamhela kalha ding nahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel insung goulo akamhel jeh-a nakipa banga, nangjong kamhela kalha ding nahi. Vo Seir molsang, chule Edom mite jouse, nabon uva kamhel ding nahiuve; chutengle amahon Pakai kahi chu ahetdoh dingu ahi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujongle nangma mihem chapa, nangman Israel molsang ho henga chun gaothu seijin lang, chule hitin seijin, Nangho molsang hon Pakai thu chu ngaijun:
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai Pathen'in hitin aseije; Namelma ten nangma douna-a, Aha, khanglui laija mun sangho jeng jong eiho loding ahitai tin aseijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun, gaovinlang seijin, Pakai Pathen'in hitin aseije; Ajehchu Pathen heloute neile gouva pangdingle, thusei ho kam nopna le japi seithanga naum theina dinguva, amahon nangho kamhela nalhauva, chule muntin-ah naval lhum jeh-un;
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun Israel molsang ho nanghon Pakai Pathen thuseihi ngaijun; Pakai Pathen'in molsang ho henga, lhangho henga, vadungho henga, phaicham ho henga, ahomkeova moh-umho henga, akidalhasa khopiho henga, akimvela Pathen helouho anchah le nuisat bep hiho henga hitihin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; tahbeh-a lungthim kipahtah le hatah-a noisena lungthim puma kagam agoulo dinguva amahole amaho chanvou akihoma Pathen helou chidang namdangho le Edom mite jouse douna-a kathangthipna meikonga kasei ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Israel gamsung chungchanga gaovinlang, molsang ho henga, lhangho henga, vadungho henga, chule phaicham ho henga seipeh-in, Pakai Pathen'in hitihin aseije; vetan, nanghon Pathen heloute jum na chu napoh jeh uva, keiman kathangthipna le kalungsatna-a kasei ahi:
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun Pakai Pathen'in hitin aseije; Keiman kakhut kadomsangtan, tahbeh-a nakimvel uva um Pathen helouten ajumnau akipoh dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin nangho, vo Israel molsang ho, nanghon nabah hou chu nahin jam dohsah uva, nagao chu kami Israelte henga nasosah dingu ahi; ajehchu amaho ahung ding koncha ahitaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijeh inem itile, veuvin, keima nangho ding kahin, chule naheng lamuva hungkile heijing ting, chule nangho kaibot le tu-a umding nahitaove:
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Israel insung pumpile nabonchao chunga mihem kapunsah ding; chule khopiho chenna hikitna, achimsaho chu kisadoh kit ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman nachunga mihem le sahem kapunsah-a, amaho punguva ga ahinsosah dingu; chule keiman nachenna mun lui dungjuija kachensah-a, chule nahung kipat tila sanga phajoa kabol ding: chutengle keima Pakai kahi chu nahet ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Henge, keiman mihemte nachunga kachele sah ding, kami Israelte ngei chu nachung uva kachelesah ding; amahon nangma nahin lo dingu, nangma amaho goulo nahi ding, tua patna achate nasuhmang louding ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai Pathen'in hitin aseije; amahon nangma henga, Gamsung nangman mihem naval lhumin, nanam mihemho chate jouse nasumang tai, tia asei jeh-un;
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun nangman mihemho naval lhum kit louding, chule nanam mite chate jong nasuhmang kit louding ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman Pathen heloute jum na chu nangma-a um mite kajahdohsah louding, mipi ho seiset jong napoh kit louding, chule nanam mite lhuhna nasodohsah kit louding ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chukal valin Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihem chapa, Israel insung chu amaho gamsunga anachen laiju chun, amaho le amaho deija achonnau le athilbolun hichu anasuboh-un: achonnau chu kamasanga numei athinei laija thenglou bangin anaumuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh-a chu gamsunga thisan aso jeh-ule, semthu milim jeh-a gamsung asuhboh jeh uva, achunguva kalungsatna kasunlhah ahin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule keiman amaho Pathen heloute lah-a kathecheh-in, chuin gamdangho-a anakithe thangun ahi. Achonnau dungjuile anatoh-u dungjuija athu-u katan ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amaho achenna lamu, Pathen helouho gamsunga alut phatnun, chumuna miho chun amaho henga, Amahohi Pakai mite ahiuvin, ahivangin ama gamsunga kona potdoh ahitaove, ati tengule kamin theng asuboh-un ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla achena lam jouseuva, Pathen heloute lah-a asuhboh-u kamintheng chu khotona kaneijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun Israel insung henga seijin, Pakai Pathen'in hitin aseije; Hichehi nangho jala kabol ahipoi, ahinla vo Israel insung, nangho Pathen helouho lah-a nache nalam channuva nasuh boh-u kamintheng jala kabol ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Pathen helou lah-a kisuboh, nanghon amaho lah-a nasuhboh-u, kamin loupitah chu kasuhtheng ding; chule Pathen helouho mitmu-a keima nangho-a suhtheng kahi tengle, Pathen hephalouhon Pakai Pathen kahi ahet dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu, keiman nangho Pathen helouho lah-a kona kapuidoh-a, gamjouse-a kona kakhop khom ding, chule nagam uva kapuilut ding nahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutengle keiman nachung uva twitheng kachap khuma, nangho nangim dingu ahi. Nathen lounao jouse-a konle namilim semthu-u jouse-a kona keiman nangho kasuhngim ding nahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lungthim thah kapeh uva, lhagao thah nasunguva kakhum peh ding; chule keiman natahsaova kona song banga tah lungthim chu kalah doh-a, tahsaphe lungthim kapeh ding nahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule keiman kalhagao nasunguva kakhuma, kadan kisunho-a kachonsah dingu, chule nanghon kathutanho nanit uva, hichu nabol dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule napu napateu kanapeh gamsunga nachen dingu; nangho kamite nahiuva, chule keima na Pathen'u kahi ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keiman nangho nathenlounao jouse-a kona jong kahuhdoh dingu: chule changle mim kakouva kapunsah ding, chule nachung uva kel kachuhsah louding ahitai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Pathen heloute lah-a kellhah jeh-a jum na nato kitlouna dinguva, keiman thingphung ga le lousoh ga kapunsah ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutengle nanghon nagitlou nao lampiho, chule nanatoh-u phalouho chu nahin kigeldoh uva, chule nakhan gitlounao hole thet umtah nahinahou jouse jeh-a nangho le nangho mitmu jenga jong nakikidah dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangho jala hichehi kabol ahipoi, nanghon kihet un, tin Pakai Pathen'in aseije, Vo Israel insung, nachonnahou jeh-in jahchaovin chule kisudongun.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pakai Pathen'in hitin aseije; Keiman nangho nachonkhelna hou jouse-a kona kasuhtheng nikho tengle, keiman nangho khopi sungho-a jong kachensah uva, chule achimsaho jong kisadoh kit ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule apal leho jouse mitmu-a kamhel, akamhela um gam chu kilhou kit ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule amahon, Hiche akamhel anahisa gam chu Eden hon abang jeng tan; chule agoh-a um le anakamhel chule anakisusesa khopiho chu kul kikai khum le chenna ahung hitai, tia asei dingu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chutengle nakimvela um akidalha Pathen hephaloute chun, Pakai keiman akisuse munho chu kasemphatna, akamhelsa chu kaphudoh ahi ti ahet dingu ahi. Keima Pakaiyin kaseidoh ahin, chule hichu kaboltei ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pakai Pathen'in hitin aseije; keima hiche dingle, hiche hi amaho dinga tohdohpeh ahina dinga Israel insungin eidoh nahlai dingu ahi; keiman amaho chu kelngoihon banga mihem'a kapunsah ding ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kelngoihon theng tobanga, kut thupi laija Jerusalem'a kelngoihon tobanga; chutia chu agoh-a umsa khopiho chu mihem ahon honna kisudim ding; chutengle amahon keima Pakai kahi chu ahet dingu ahi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai khut chu kachunga ahung chun, chuin Pakai Lhagaovin eipuidoh-in, chule guho dimsetna aumna phaicham lailunga eikoijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin alah uva chun eiche kimvelsah len; chule veuvin, chuche phaichama chun gu atama tam aumin, chule veuvin, agoset jenguvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman kahenga, mihem chapa, hiche guhohi ahingthei diuvem? ati. Chuin keiman, Vo Pakai Pathen nangman nahenai, tin kadonbutne.
  </para>
  <para style="p">
    <verse number="4" style="v" />Avelin kahenga hitin aseije, hiche guho henga hin gaovinlang, ajah uva seijin, Vo nangho gu gosaho, Pakai thuhi ngaijuvin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai Pathen'in hiche guho henga hitihin aseije; veuvin, keiman nasunguva haitheina hu kalutsah ding, chule nangho nahin dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman nachung uva thagui ho kalhuna, phe kahin besah ding, chule nangho vunna kahintoma, nasunguva haitheina hu kakhum ding; chule nangho nahung hin uva, keima Pakai Pathen kahi chu nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun keima eikithupeh dungjuijin gaothu kaseitan ahi. Chuin keiman gaothu kasei chun, husa khat ahung gingin, chule veuvin ahung gingpoh sotsotnin, chuin guho chu ama ama gucheh-a ahung kisuto uvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin keiman kaven ahile, veuvin, thajung ho le phe chu achunguva ahung umin, chule vunin amaho chung chu ahin tomtan: ahinla amaho sunga chun haitheina hu aumpon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin aman kajah-a, mihem chapa, hui jah-a chun gaothu seijin, gaovin, hui jah-a chun seijin, Pakai Pathen'in hitin aseije; Kolning li-a konin hungin, vo haitheina hu, hiche thilongho hi ahin theina dingun hai khumin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun aman eithupeh bangin gaothu kaseitai, haitheina hu chu amaho sunga ahung lutnin, amaho ahung hingdoh taovin, ahung dingdoh uvin ahile, sepaihon tamtah ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman kahenga, Mihem chapa, hiche guhohi Israel insung pumpi chu ahiuve; Ven, amahon, kaguhou agolhan, chule kakinepnao amangtai, keiho ahal halla sattel kahitaove, tin aseijuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun gaovinlang ahenguva hitin seijin, Pakai Pathen'in hitihin aseije; Veuvin, Vo kamite, keiman nalhankhuh hou chu kahona, chule nalhanhouva kona nangho kahung dohsah dingu, chule nangho Israel gamsunga kahin puilut dingu nahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keiman nalhankhuh hou kahin honna, Vo kamiteho, nalhankhuh houva kona kahin puidoh tengule, keima Pakai kahi nahetdingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule kalhagao nasunguva kakhuma, nahin dingu, keiman nangho nagamsung tah uva kakoi dingu; chuteng nanghon, Pakai keiman hichu kasei ahitan, chule hichu kabol ahitai, ti nahet dingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai thu chu avelin kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="16" style="v" />Chukalvallin, mihem chapa, tenggol khat lanlang, achunga chun Judah le akiloipi Israel chate ding tin sunin; chujou tengle tenggol chomkhat lanlang, achunga chun, Joseph ding, Ephraim tenggol, chule akiloipi Israel insung pumpi ding, tin sunnin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hiteni chu khatle khat jopmin lang, tenggol khat hisah-in, chule hiteni chu nakhutna khat hungsoh lhon ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule namite chatehon nahenga, Hichehi ipi natina ahi keiho neivetsah lou dingu ham? ati tengule,
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahenguva seipeh-in, Pakai Pathen'in hitin aseije; Veuvin, keiman Ephraim le agolho Israel phungho khutna um Joseph tenggol chu kalah-a, hiho chu Judah tenggol ngei chutoh kakoikhom ding, hiche teni chu tenggol khat kasoa, hiteni chu kakhutna khat hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nangman achung najih tenggol teni chu amaho mitmu tah-a nangma khutna umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amaho jah-a seijin, Pakai Pathen'in hitin aseije; Veuvin, keiman Israel chate chu Pathen heloute lah-a agachenau munho-a kona kalahdoh ding, chule amaho ningtina kachom khoma, chule amaho chu amaho gamsung ngeija kalhut ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule keiman gamsunga chu, Israel molsang ho chunga amaho chu nam khatna kasema, leng khat chu amaho jouse dinga alengpau hiding; chule amaho chu nam ni hitalou ding, chule lenggam ni-a a-itih-a kikhen kit talouhel ding ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahiloujongle amaho chu asemthu-u milimho ningset umtah thilho le achonkhelna houva jong amahole amaho kisuboh talou dingu; anachon setnaova achennao munho-a kona keiman amaho kahuh doh-a, kasuhtheng dingu ahi. Chutia chu amaho kamite hiuva, keima a-Pathen'u kahi ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule kasoh David chu amaho chunga leng hiding; abonchauva kelngoiching khat anei dingu ahi. Amaho chu keima thutan danho-a chonuva, kadan kisunho anitdiu, chule hiho chu atohdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amaho chu keiman kalhacha Jacob kanapehna, napu napateu anachenau gama chu cheng diu; chule hia chu amaho, amahotah chule achateu, chule achateu chate a-itih-a chenguva, kasoh David chu a-itih-a apipu-u hiding ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chukalvalla keiman amahotoh chamna thulhun kasema, hichu amahotoh a-itih-a thulhun hiding; chule amaho kachensah-a, chule kapunsah-a, alah uva atonsotna kamun theng katundoh ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kahoubuh jong amahotoh umkhom ding; henge, keima amaho Pathen kahia, amaho kamite hidingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule kamun theng chu amaho lahtah-a a-imatih chana aumtengle, Pathen helouhon Pakai keiman Israel kasuhtheng ahi ahet dingu ahitai.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai thu chu kahenga ahungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem chapa, Meshech le Tubal vaipo pipen Magog gama Gog lam chu maingatnin lang, ama dounan gaothu seijin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule seipeh-in, Pakai Pathen'in hitihin aseije; Vo Gog, Meshech le Tubal pipu, ven, keiman nangma kadou nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keima nangma ka nungchon kitding, chule nakhalhang teni-a ngakoi kakoija, nangma galsat mihon jouse, sakol ho le sakol chungtouho, galvon jat kima kivonho jouse, lum le pho tho-a chemjam kichoija mihonpi ho chu aboncha keijuva kahin puidoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Persia, Ethiopia chule Libya toh pangkhom, abonchauva lumle thih lukhuh tho cheh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Gomer le aloiho jouse, sahlam sanga Togarmah insungmite le apankhom piho; chule mipi tampi tah-in aumpiho.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kigosan umin, nangle nang, nangmale nahenga kikhom naloiho jouse kigochaisan umun, chule nangma amaho ngahtupmin pangin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ni tampi joule nakivil ding; ninunung lamle, chemjam'a kona kinung puidoh-a, mipi tampiho lah-a kona kichom khom ho chenna mun, sottah kamhela anaum Israel molsang ho dou dinga nahung kon ding ahi; amaho chu namtin lah-a kona kihin puidoh ahin, amaho abonchauvin bitkeichan achengun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangma huipi le gopi banga nakal touva nahung ding, nangmale naloiho jouse, chule nangma toh um mihonpi chu agam khujouhel ding meilompi tobang nahidingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai Pathen'in hitin aseije; chule hung hitiding ahi, hiche nikhotah chule nalungsunga lunggel tamtah hungsoh doh ding, hiche phat mama chule lunggel gilou khat nahin gelding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuteng nangman seijin natin, Keima kulpibei khoho-a chetou vingting; mongtah-a uma, bitkeija chengho, aboncha keijuva kulbang bei, kotgolhole kotpiho jong neilouho henga chengting;
  </para>
  <para style="p">
    <verse number="12" style="v" />Galthil kichomdoh ho ladingle, anchah lading; chule agoh-a anaumsa tu-a mi chenna mun, namtin lah-a kona kichom khom mite chenna mun, gam lailung tah-a cheng, ganchale thilkeo haotahho, chunga kakhut kalap ding ahi nati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sheba le Dedan chule Tarshish sumkolvei ho, amaho keipi bahkai chal donglai jouse chun nahenga, Galthil chom dinga hung nahim? mihonpi chu thilkeo podinga nakou khom ham? sanale dangka pomang dinga, ganchale thilkeo pomang dinga, thilchom tamtah podinga nahung ham? atidiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun mihem chapa, gaovinlang Gog henga hitihin seijin, Pakai Pathen'in hitin aseije; Kami Israelte bitkeija achen nikho tengule, nangman nahetlou dingham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangma naumna sahlam gamho-a kona, nangle naumpi mipi tamtah, sakol chungtou cheh, mipi tamtah le galmi hattahho toh kilhona nahungdoh ding ahin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangma kami Israelte kidoupi dinga, meilhangin gamsung akhu banga nahung kon ding; ninunung lamle hiti ding ahi, Vo Gog, kagam doudinga nangma kahinpui ding, Pathen heloute mitmu-a nangma-a kona suhthenga kaumteng, amahon Pathen kahi ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai Pathen'in hitin aseije; malaija keiman kasoh Israelte themgaoho kama kanaseisa, amahon kum tampi nikhoho sunga gaothu anaseiju, amaho kidoupi ding kahinpui ding ahi tia kanaseipa chu nangma nahi louham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Israel gamsung doupi dinga Gog ahungtengle, chuche phattahchule hung hitiding ahi, kalungsatna chu kamaija hung kilangdoh ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu kathangthipna le kalunghana meikouva kasei ahi, tahbeh-in hiche nikho chule Israel gamsunga nasatah-a tijat umtah ling kihot ding ahin;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu twipia ngaho, chunga leng vachaho, gama gamsaho, a-opma tolla kithol ganhing jouse, leiset chunga um mihem kiti jouse chu kamai koh-a kihot hot dingu, molsang ho kisunema, kolho lhanem suh ding, chule kulbang jouse chimlha ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule keiman Gog kidoupi dinga kamolsangho jouse-a kona chemjam kakou ding, mijousen asopi chunga chemjam alap ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hise le thisanna athu katan ding; amale ahonho, chule aumpi tamtah ho chunga alonglet jeng gotwi, song lentah ho, meikou, chule kat kajuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutia chu keima kei le kei kakichoisanga, chule kakisuhtheng ding; namtin vaipi mitmu-a het kahi ding, chule amahon keima Pakai kahi chu ahet dingu ahi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun, nangma mihem chapa, Gog dounan gaothu seijin, chule hitihin seijin, Pakai Pathen'in aseije; Meshech le Tubal pipu pen O Gog, ven, keiman nangma kadou nahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nangma kanungno kitna, nangma-a um hop gupma hopkhat kadalhah sah-a, sahlam gambehho-a kona nangma nahungtouva, Israel molsang ho chunga kahinpuiding nahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keiman nakhut veilama um nathalpi chu kajepset peh-a, nathal changho chu nakhut jetna kona kakhehlhah sah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma Israel molsang ho chunga nalhuh-a, nangma le naloiho jouse, chule naumpi mipite jouse nalhuh dingu; keiman nangma sahingne vacha namkim le gama saho valhum dinga kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma gam ong laija nalhuh ding ahi: ajehchu keiman kasei ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Magog chungle twikol sunga olmo louva chengho lah-a meikou kasol ding; amahon keima Pakai kahihi ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutia chu keiman kamin thenghi kami Israelte hetna kaumsah-a; kamintheng chu amaho kasuhboh sah kit louding ahitai. Chule Pathen helou ten keima Pakai, Israel mithengpa kahi chu ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Veuvin, hichehi aguilhungin, akitong dohtai, tin Pakai Pathen'in aseije, hichehi keiman kanaseidohna nikho chu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel khopiho sunga chengho chu potdoh uva, gal manchah ho, lum le phoho, thalpi le thalchang ho, chule tengpaineiho le tengcha ho chu meija ahaluva, hiho chu kum sagi meija akiti dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutia chu gama kona thing achomlou dingu, gamanga kona jong thing khatcha atuhlhuhtah loudingu ahi: ajehchu amahon gal manchah ho chu meija akiti dingu; amaho sumangho chu amahon asuhmang dingu, amahon asuhsethou chu achomgam dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hiche niteng chule hung hiti ding ahi, keiman Israel gamsung, twipi solama vahle ho phaicham kiti chu, Gog lhankhuh mundinga kapeh ding; hichun vahle ho lampi ahuh ding, chule chuachu amahon Gog le amihonpi jouse avui dingu: hiche mun chu Hamon-Gog phaicham asah dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule gamsung chu suhtheng ahina dinga, lhasagi jen Israel insung chun amaho chu avui dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Henge, agama mipite jousen amaho avui dingu; keima choisanga kaumna dinga hichu amaho dinga minthana nikho khat hiding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule gamsung suhtheng nadinga, vahle ho to kitho-a gamsung chonchaija leichunga umnalai thilongho holdoh-a vuidinga, natoh-a neiding mi alhendoh diu; lha sagi joule akholpat diu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule gamsunga vahle ho mi khat touvin mihem gu amuteng, avui dinghon Hamon-Gog phaichama avui kahseuva melchihna khat atundoh dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chujongle chuche khopi min chu Hamonah hiding ahi. Hiti achu amahon gamchu asuhtheng dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nangma mihem chapa, nangman chungleng vachate jouse le gama gamsaho jouse henga hitin seijin, Nangho kikhom khomun lang hunguvin; kaganlhaina, nangho ding katodoh ganlhaina, Israel molsang ho chunga ganlhaina lentah kabolna-a, saphe naneh uva, thisan nadon theina dingun, nangho ningtina konin hung kikhom khomun, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nanghon mihat ho sa naneh uva, chule leiset vaipipo ho thisan, abonchauva Bashan'a kivah thaochet kelngoichalho, kelngoinou ho, keltahho, bongchalho thisan nadon dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nangho dinga ganlhaina-a katodoh ganlhaina chu nanghon navaset kahseuva athao naneh dingu, chule nakhamset kahseuva thisan chu nadon dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu nangho kadokhang chunga sakolhole sakol kangtalai ho, mihat ho le gal hat ho sa naneh vaset dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule kaloupina chu Pathen helouho lah-a katundoh ding; chuteng Pathen heloute jousen kathutana kamolso le achunguva kakhut kalhah chu amu dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiti achu Israel insungin chunikho-a patle akalsea chu Keima Pakai, amaho Pathen kahi chu ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Pathen heloute chun Israel insung chu akhangit lounao jeh-a gal hinga kikai anahiuve ti ahet dingu ahi. Ajehchu amahon keima dounan asukhelun, hijeh-a chu amaho-a kona kamai kasela, chule amaho chu amelmateu khutna kanapehdoh ahin; chutiachu amaho chemjam'a louva ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Athenlou nao le asuhkhel nao dungjuija kanabola, amaho-a kona kamai kanasel ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun Pakai Pathen'in aseije; tuahi keiman Jacob chu asohchanna-a kona kahinlepui kitna, Israel insung pumpi chunga hepina kanei ding, chule kamintheng dinga katompan ding ahi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Amahon ajachatnau, keima douna-a suhkhelna-a asuhkhelna hou jouse akipohjou uva, aleisetnuva bitkeija achen tengule, koimachan akichatsah lou dingu ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Keiman amaho mipite-a kona kahin puikitna, amelmateu gama kona kahin chopkhoma, chule nam tamtah mitmu-a amaho-a keima kahung umtengle,
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuteng amahon keimahi Pathen heloute lah-a amaho sohchang dinga pedohpa, ahivanga agamsung tah ngeijuva hin chomkhom kit, khatcha sohchanga dalhah-a umdensah loupa Pakai amaho Pathen kahi chu ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keiman amaho-a kona kamai jong kaselkit tahlou ding ahi: ajehchu keiman kalhagao chu Israel insunga kabuh lhah ahitai, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasoh channau kum somni le kum nga, alha sunga nisom lhin nikho, khopi suhsetna ahung umjoukal kum somle kum li lhin nikho tah-in, Pakai khut chu kachunga ahung kingamin, chule keima khulama eipuitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pathen'a kon muneinaho-a chun, aman keima Israel gamsunga eihin puitan, chule lhanglam sanga khopi khat bang jeng molsangtah khat chunga eitousahtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman keima chumun chu eilhuttan, veuvin, chuachun alimso sum-eng bang jeng, akhutna tupat khaojang khatle thil tena penglhon khat choi mipa khat anaumin, kotpi-a chun anadinge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin mipa chun kahenga, Mihem chapa, keiman nangma kavetsah dingho jousehi namit tenin ve-inlang, nanakhang tenin ja-in, chule kavetsah ding jousehi nalung gilin ngaiton; ajehchu hicheho chu nangma vetsah ding ngaitona-a nangma hilama kipui nahin; nangman namuho jouse chu Israel insung henga naphondoh ding ahi, tin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule veuvin, a-in kimvela chun bang khat aumin; chule mipa chun akhutna thil tena pengmol tong gupma sao achoijin, khatcheh chu tongkhat cheh mihem khut chan chet ahin; hitichun aman in bang sadan chu aten ahile pengmol khat ahin, chule asandan jong pengmol khat ahije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin ama solam maingat kotpi-a chun ahungin, chuche kalbiho chu ajot touvin, kotpi phung chu aten ahile, tena pengmol khatnin alenin, chule kotpi phung dang chu pengmol khatma-in alenin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule indan neo jouse chu pengmol khat asao cheh-in, pengmol khat alen cheh-in; chule indan neoho kikah chu tong nga ahicheh-in, chule kotpi sungnung hongcha-a kotpi phung chu pengmol khat ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman kotpi sungnung hongcha jong agaten, pengmol khat ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin aman kotpi hongcha chu aten, tong get ahin; chule hichea akhomho chu tong ni ahi. Kotpi hongcha chu sunglama aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule solam kotpi indan neoho chu hilam panga thum aumin, chule khulam panga thum aume. Hiche thumho chu akibang cheh uvin; chule akhomho chu alangto-in akibang cheh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman galutna lai kotpi chu availam aten ahile tong som ahin, chule kotpi dunglam chu tong somlethum ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Indan neoho maija chun mun ong aumin, hiche chu hilam panga tong khat, chule khulam panga tong khat ahi; chule indan neoho chu hilam pang tong gup, khulam pang tong gup cheh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin aman kotpi chu indan neo khat tingvuma patnin adang khat tingvum chan geijin aten ahile, kotle kot kikah letdan chu tong somni le tong nga ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman kotpi kimvela inhongsung khom gei tah-a chun khom tong somgup jong asemin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule galutna kotpi maitah-a kipat, kotpi sungung hongcha mai gei chu tong somnga ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kotpi sunglam kimvela khomho geijin indan neoho-a chun bangkot neoho aumpeh-in, kemho-a jong hitobangma chu ahi; asunglam kivela jong bangkot ho aumin, khom khat cheh chunga chu tumthing aum cheh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin inhong ponung lama eipuitan; veuvin hia chun indanho, chule inhongsung kimvel dinga kisem keng lampi aumim; indan somthumin keng lampi chu amaingatnin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule keng lampi kotpiho panga um ahin, kotpi sao dung juija kilhunga, hichu keng lampi noinung hija ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin aman kotpi noinung masang lama patnin sunglam inhong ponung geijin avai chu aten, solam pangle sahlam pang gei chu tong jakhat ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule inhong ponung sahlam nga-a kotpi khat aumin, aman adung le avai aten ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule chuche indan neochaho chu hilam panga thum, khulam panga thum aumim, chule chuche akhomhole kem kidoho chu adung avai kotpi masapena toh akibangin; hichu adung tong somnga, chule avai tong somni le nga ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule abang kot ho, kem kidoho, atumthingho chu solamsang nga-a kotpiho to kibang ahi; hichu kalbi sagi-a kaltou ahin, chule kem kidoho chu amasanga chun aume.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule inhong sungnung kotpi chu solam kotpi banga, sahlam ngat kotpi toh kimai ngat ahin, chule aman kotpile kotpi kah aten ahile, tong jakhat ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujou phatnin aman lhanglam sanga eipuitan; chule veuvin, chukoma chun kotpi khat aumin lhanglam sanga angan ahi. Chuin aman chuche-a akhomhole kem kidoho chu hiche tenaho dungjui chun aten ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule hiche sunga chun bangkot ho aumin, chule chuche bangkot ho tobang chun kemkidoho chu akimvela aume; adunglam chu tong somnga ahin chule avai tong somni le tong nga ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule chua chetouna ding chun kalbi sagi aumin, chule kem kidoho chu hicheho masanga chun aume. Chule chuche-a khomho chunga chun tumphungho aumin, hilam panga khat chule khulam panga khat aume.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule inhong sungnunga chun lhanglam sang nga-a kotpi khat aumin; chule aman lhanglam sang kotpi phunga pat kotpi phung chu aten ahile, tong jakhat ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman keima lhanglam kotpi-a inhong sungnunga eipuijin; chuin aman lhanglam sang kotpi chu hiche tenaho dungjui chun aten ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule indan neoho le akhompiho, chule kem kidoho chu hiche tenaho dungjuijin aten; hiche-a chun bangkot ho aumin, chule akimvela kem kidosangho-a jong chun bangkot aumin ahi; hichu tong somnga asaovin, chule tong somni le tong nga alenin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Akimvela chun kem kidosang aumin, tong somni le tong nga asaovin, tong nga alenin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuche kem kidosangho chun inhong ponung lam chu amaingatnin, chule akhompiho chunga chun tumthingho aumin, chule chua gakaltouna chun kalbi get aneije.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule aman keima solamsang nga-a inhong sungnung lama eihin puijin; chule aman hiche tenaho dungjuijin kotpi chu aten ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule indan neoho le akhompiho, chule kem kidosangho chu hiche tenaho dungjuijin aten ahi. Chule hiche-a chun bangkotho aumin, chule akimvela kem kidosangho-a jong chun bangkot aumin ahi; hichu tong somnga asaovin chule tong somni le tong nga alenin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule chuche kem kidosangho chun inhong ponung lam amaingatnin, chule akhompiho chunga chun tumthingho hilam pangle alangkhat panga aume; chule chua gakaltouna chun kalbi get aneije.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin aman keima sahlam kotpi-a eipuijin, chule hichu hiche tena ho dungjuija chun aten,
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule indan neoho le akhompiho, chule kem kidosangho jongchu aten ahi. Akimvela chun bangkot ho aumin, asaodan chu tong somnga ahin avai tong somni le tong nga ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule khompiho chun inhong ponung lam amaingatnin, chule chuche khompiho chunga chun tumphungho hilam pangle khulam panga aume; chule chua gakaltouna chun kalbi get aneije.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule indanhole chuche-a lutnaho chu kotpi khomho panga chun aumin, hia chun amahon govam thilto asop uvin agou jiuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule kotpi hongcha-a chun hilam panga dokhang ni, khulam panga dokhang ni, halvam thilto le suhkhel thilpeh chule suhkhel thilpehho thana ding aumin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule khattou sahlam kot galutna geija achetoule, polam panga chun dokhang ni aumin, chule kotpi hongcha lang khat panga dokhang ni aumin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kotpi pang hilam sanga dokhang li, chule khulam sanga dokhang li aumin; hiche dokhang getho chunga chun amahon aganlhaina hou athat jiuvin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chua chun govam thiltona ding songa kikheng dokhang li aumin, dokhangho chu tong khatle akeh asaovin, tong khatle akeh alenin, tong khat asangin; chuche chunga chun amahon govam thilto le ganlhaina athanajiu manchah ho chu akoijun ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule asung kimvela chun khutpeh tebep koikaho akilbeh kimvelun, chule dokhangho chunga chun thilto sa chu aumin ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuche kotpi sungnung polama chun inhong sungnunga lasaho dingin indanho aumin, khatchu sahlam kotpi panga umin lhanglam angan, chule khat chu lhanglam kotpi panga aumin sahlam angan ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin aman kahenga, hiche indan lhanglam maingat hi, hiche in ngahtupma pang thempu ho-a ahin;
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule indan sahlam maingat hi maicham ngahtup thempu ho-a ding ahi; amahochu Levi chapateho lah-a Zadok chapate, Pakai jen dinga aheng hin nailut ho chu ahiuve, tin aseije.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hitichun aman inhong chu aten, ningli ahin, tong jakhat asaovin, tong jakhat alenin ahi. Chule maicham chu in maija chun aumin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin aman keima houin hongcha-a chun eipuijin, chuin hongcha khom jouse chu aten, hilam sang tong nga chule khulam sang tong nga ahin; chule kotpi chu avai hilam sang tong thum, khulam sang tong thum ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Hongcha chu adung tong somni ahin, chule availam chu tong somle tong khat ahi. Chule aman amaho agakaltouna jiu kalbiho-a chun eihin puijin, chule khomho panga chun khompiho hilam panga khat chule khulam panga khat aumin ahi.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin aman keima houin'a eihin puijin; chule khomho chu aten ahile, hilam pang tong gupmin alenin, chule alang khat pang tong gupma-in alene; hichu houbuh letdan chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule kotvai chu tong som ahin, chule kot pangho chu hilam sang tong nga, chule khulam sang tong nga ahi. Chule aman adung aten tong somli ahin chule avai tong somni ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ama asunga alutnin, kotkhom chu aten, tong ni ahin; chule kotkhah chu tong gup ahin, chule kot vailam chu tong sagi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman adunglam aten ahile, tong somni ahin; chule avai lam chu tong somni ahi. Chule aman kahenga, hichehi muntheng chungnung pen chu ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin aman houin bang chu aten, tong gup ahin; chule indan pang jouse vailam, inpang jouse kimvel chu tong li cheh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule apanga indanho chu songthum ahin, khat chunga khat kisa, songkhat cheh-a chun dan somthum aumin ahi. Chule hicheho chu adet theina dingin in kolkhum soh-a panga indanho bang chutoh akisumatne; ahivangin a-in bangto vang akisumat pon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hiche indanho chu asancheh cheh phatchun apanga indanho chu akisulenin ahi; ajehchu inpanga lampi kihehtou chu achunglam peh geija a-in kimvela achedoh peh-in, hijeh chun a-in letdan chu asancheh chehle alet beben indan noinung pena patnin indan lailha le indan chungnung pen geijin alet beben ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman a-in sandan jong chu kamun; indanho pang inbulho chu pengmol lhon tong gup lhingset ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Indan ponung panga bang sadan chu tong nga ahin, chule akidalha chu sunglama um indanho panga mun chu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule a-in kimvel jousele indanho kikah-a chun mun ong tong somni-a len aume.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule indan pang kot ho chun akisei mun onglai chu amaingatnin, kotkhat nin sahlam, kot dang khatnin lhanglam angan ahi. Chule akidalha mun availam chu akimvel tong nga ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun mun kikhendoh masanga, lhumlam pang maingatna in kisa chu aletdan tong somsagi ahin, chule a-in bang kimvel chu tong nga-in asan, chule adung chu tong somko ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun aman houin chu aten, tong jakhat asaovin, chule mun kikhendoh le in kisa abangho jong tong jakhat asaovin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujongle houin mailam letdanle, solam sanga mun kikhendoh letdan chu tong jakhat ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman innung lama um, mun kikhendoh jonna in kisa chu adunglam aten, hilam pang le khulam panga indanho kem kidosangho, houin sungnung le ahongsunga kempum,
  </para>
  <para style="p">
    <verse number="16" style="v" />Kot khomho le bangkot neoho chan gei chu tong jakhat ahi. Chule kot jonna um kem kidosang dan thum chu tolla pat bangkot ho geijin thingpeh-in akikhenbeh-in; bangkot ho chu,
  </para>
  <para style="p">
    <verse number="17" style="v" />Kot chunglama pat indan sungnung le ponung changei, chule akimvela bang jouse apolam le asunglam abona kite-a ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiche chu Cherub hole tumthinga kisem ahin, Cherub le cherub kikah-a tumthing umah ahi. Cherub jouse chun mai ni cheh aneijun,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutichun mihem maiso pu-a chun tumthing lampang amaingatnin chule keipi bahkai chal khangdong maiso pu-a chun achom langkhatna tumthing lam chu amaingatnin ahi; chutia chu houin pumpi kimvel chu kisema ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Houin bang chung chu, tolla patna kotchung geija Cherub ho le tumthingho lim kisema ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Houin khomho chu ningli kitohchet ahin, chule muntheng mai chu khat limso chu adang khat limso tobang cheh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Maicham chu thinga kisem ahin, tong thum asangin, chule adunglam chu tong ni ahi. Chuche-a aninghole adung chule abangho chu thinga kisem cheh ahi; chuin aman kahenga, Tonsot Pakai anga kido dokhang chu hichehi ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule houin le muntheng chun kot ni aneije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule kot ho chun pehni cheh, akiheithei pehni, pehni kot khatna ding, chule pehni ma kotchom khatna ding, aneicheh-in ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule banga kisem banga chun, hicheho chungle houin kot ho chunga chun Cherub hole tumthingho akisem cheh-e. Chule hongcha ponung chunga chun thingpeh satah akibeh-e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule tumthingho hongcha pangho hilam pangle khulam panga chun bangkot neochaho aumin, chule hongcha panghole, insung danho pang chunga chun thingpeh satah ho akibeh-in ahi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin aman keima sahlam sanga patnin inhong ponunga eipui doh-in; chule aman keima in kisa maitoh kigalsai sahlam sanga mun kikhendoh indanho sunga eipuilut tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tong jakhatna sao masanga chun sahlam sang kotpi chu aumin, chule availam chu tong somnga ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Inhong sungnung tong somni maingat, chule inhongsung ponung keng lampi-a chun kempumle kempum kimai ngatnin dan thum cheh-in aumin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Indanho masanga, sunglam jotna-a chun lampi availam tong soma len le, adunglam tong khatna len aumin, chule akot ho chun sahlam angan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tun indan chungnung joho chu anemjep uve, ajehchu kem kidosangho chu in kisa anoinung le alailha penho sangin asangjon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu amaho dan thuma um ahiuvin, ahinla inhongsung khompiho bangin khomho aneipouve; hijeh chun in kisa indan chungnung pen chu tolla patna anoinungpen le alailha penho sangin ajum jouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule indanho toh kingatto chule indanho maija inhongsung ponung lam sanga bang ponung chu, adung tong somnga ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu inhong ponung sunga indanho adung tong somnga ahi, chule veuvin houin mai chu tong jakhat ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Inhon ponunga kona mihem dia aban chelutna ding hiche indan noiho-a kon chun solam sanga lutna chu aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Indanho chu mun kikhen doh jonna, chule in kisa masanga solam sanga inhong dung bang satah-a chun aume.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amaho masanga lampi chu sahlam sanga indanho asaojedan le aletdan limso bangin akilange, chule potdohna ho chu akot ho dungjui le alimsoho dungjuija um ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule indanho-a kot ho dungjui chun, lhanglam sanga lamlhongpia chun kot khat aumin, khattou chuche sunga agalut tengle solam sanga bang maitah-a chun lamlhah khat aume.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin aman kahenga, sahlam sanga indanho le lhanglam sang indanho, mun kikhen doh toh kingatto chu indan thengho, Pakai heng jotlutna thempu hon thiltheng chung nungho anehna dingu mun chu ahi; chuachu amahon thilthengpen, chule anneh thilpeh, chonset thilpeh, chule suhkhelna thilpeh chu akoi dingu ahi. Ajehchu amun chu muntheng ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hiche sunga chu thempuho alut tengule, amaho chu munthenga kona inhong ponung sunga potdoh lou dingu, amavang hiche laija chu amahon anaman chah-u avonhou chu akoilhah dingu ahi; ajehchu hicheho chu atheng ahin: chule amaho mipi anga ache masang uva amahon von dangho akivontei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun aman insung atejou phatnin, keima solamsang ngat kotpi lama chun eihin puijin, chule aning jouse chu aten ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman thil tena pengmolin solamsang aten ahile, pengmol janga alhinge.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman sahlam sang aten ahile, pengmol janga ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman lhanglam sang chu aten ahile, pengmol janga ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama lhumlam sanga agakihei kimvelin, pengmol kitena-a chun aten ahile, pengmol janga ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hitichun aman hichu aning li in aten ahi; hichun akimvela bang aneijin, munthengle milham umna mun kikah sekhena dingin, pengmol janga saole janga len aumin ahi.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin aman keima kotpi phunga solamsang ngat kotpi phung gei chun eipuijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin veuvin, Israel Pathen loupina chu solamsang lampia konin ahung kilah-in, a-awgin chu twi tamtah gin abangin, aloupina chun leiset asalvah-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hichu keiman kanamu gao thilmu tobangle, hiche khopi sumang dinga kahunglaija kanamu gao thilmu dungjui ngeijin akilangin ahi. Chule gaothil muho chu Chebar vadunglen panga kanamu toh akibangin; chuin tolla kamai kasulut tai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakai loupina chu solam sanga kotpi-a konin inpi sunga ahung luttai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun lhagaovin keima eiphong dingin, chule inhong sung lama chun eipui lutnin; chule vetan, insung chu Pakai loupina adimtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin keiman insunga kon chun kahenga thu kisei kajan, chule mipa chu kakoma anadingin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman kahenga, Mihem chapa, kalaltouna munle kakengto ngapna mun, a-itih-a Israel chate lah-a kachenna ding mun, chule Israel insung mite, amaho ahiuvin, alengtehou ahin, ajonthanhoi naova, ahilouleh amunsang houva alengtehou longin jong kamintheng asuhboh kitlou dingu ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akotbulu kakotbul ho koma aboluva, akhomu kakhomho koma atunuva, chule keimale amaho kah-a bang akigen tanin, amahon thet umtah abolu chun kamintheng asubohtauve; hijeh-a chu kalung hanna-a amaho kasuhmang ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun ajonthanhoi naole, alengtehou thilongho chu keija konin gamla tah-a koidoh taohen, chutengle a-itih-a akomuva kachen jing ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihem chapa, nangman akhanset naova ajachat theina dingun, in chu Israel insung vetsah-in, chule a-inlim chu amaho tesah-in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon athilbol jouseu chu ajachat piuva ahile, amaho chu in limle agong, chule apotdohna hole achelutnaho, chule alimpoh jousele amandan jouse, chule alimpoh jousele adanthu jouse vetsah-in; alimpoh pumpileh adanthu jouse anitnuva abolna dingun amitmuva hichu sunin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichehi in'a dinga dan ahin; molchung vum kimvel pumpi hop chu atheng chungnung hiding ahi. Veuvin hichehi in'a dinga dan chu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichehohi thil tena tong ho dungjuija maicham tena ahi; tong khat chu tong khatle khutpeh khat, atodop ngei jong chu tong khat hiding, aveilam tong khat, agei pumpi mong kimvel chu khap khat hiding, chule hichehi maicham sangjo mun chu hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Atodop tol chunga akitunna noinunga pat tong ni hiding, availam tong khat hiding, atodop neopa-a pat atodop lenpa gei chu tong li hiding, chule asalam pang tong khat hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiti achu maicham chu tong li hiding, maichama pat chunglam chu aki li umding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule maicham chu tong somleni sao, somleni len, aning li kibang hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule atodop chu tong somle tongli hiding, aninglia aletdan chu tong somle tongli hiding; akimvel geisihho chu tong kehkhat hiding, chule atodop kimvel chu tong khat hiding; chule akalbiho chun solam angat dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman kajah-a, mihem chapa, Pakai Pathen'in hitihin aseije; amahon govam thilpehho achunga chu aboluva, thisan athin khumni tengule, hichehohi maicham boldan thupeh hiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nahenga kalhacha kinbol dinga eihin naija Zadok chilhah, Levi thempuho henga, chonset thilto dinga bongchal gol khat nangman napeh ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nangman hiche thisan chu nalah-a, hiche aki liho chungle atodop ning liho chunga, chule ageisih kimvela nakoi ding; hiti achu maicham chu nasuh thenga nathenso ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangman chonset thilpeh bongchal jong chu nalah ding, aman hichu muntheng polam, lhendoh sa-a kikoi in'a chu agovam ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nini chan nileh nangman kelcha nou nolnabei khat, chonset thilto dinga nato ding; amahon maicham chu bongchala asuhtheng banguva, asuhtheng dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangman hiche suhthengna chu nachai tengle, nolnabei bongchalgol khatle, ahonlah-a nolnabei kelngoichal khat natodoh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangman hiho chu Pakai masanga natodoh-a, thempuhon achunguva chi atheova, Pakai henga govam thilto atodoh dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni sagi sunga chonset thilto ding niseh-a kelcha khat nagon ding; amahon jong bongchalgol khatle ahon lah-a nolnabei kelngoichal khat akigon dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amahon maicham chu ni sagi asopthenguva asuhtheng diu; chule amaho jong kithenso dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule hiche nikhoho kichai tengle, hiti ding ahi, niget channi chule aban banna thempuhon maicham chunga chu govam thiltoho le chamna thiltoho atodiu, chuteng keiman kasanpeh ding nahiuve, tin Pakai Pathen'in aseije.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin solam ngatna muntheng ponung kotpi lama chun eilepui kitnin; hichu anakikhah-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakai chun kajah-a, hiche kotpihi kikhah ding kihong louhel ding, koimacha hichea lutlouhel ding ahi; ajehchu Israel Pakai Pathen chu hiche-a hi hung lutna ahin, hijeh-a chu hichehi kikhah jing ding ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichehi leng chapa ding ahin, leng chapa chu Pakai anga an nedinga asunga tou ding; chuche kotpi hongcha lampia chu ama lutding, chule chuche lampi mama-a chu potdoh ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman keima sahlam kot lampi inmaija chun eipuijin; chuin kavetle, veuvin, Pakai in chu Pathen loupinan adimsetnin, chuin kamai tolla kasulutai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin kajah-a, mihem chapa, melchih phan lang, namitnin ven, Pakai insunga kimanchah ding dan jouse chungchang nahenga kasei jousele, dan jouse chu nanan ngaiphan; chule in'a lut jousele munthenga pot jouse chu phaten melchih in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangman thungailou ho, Israel mite ngei henga naseipeh ding ahi; vo Israel insung mite, thet um nabol jouseu chu ngataovin, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon kamun theng sunga gamdang mi, atahsao le alungsunga cheptan louho, kamunthenga nahinpuilut tengule ka in jengjong nasuboh-un, nanghon ka changlhah, thao, chule thisan nato tengule amahon kakitepna asukeh un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon kathil theng thupeh ho nachingtup pouvin; ahinla nanghon nangho khelin kathupeh nitding midang kamuntheng sunga nakoijo taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai Pathen'in, gamdang mi, lungsunga cheptanlou ahilouleh tahsa-a cheptanlou, Israel chate lah-a gamdang mi cheptanlou khatcha kamun theng lutlou dingu ahi, tin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Israel avaveija, keija kona amilim semthu nung ajuijuva avamang laijuva, keija kona gamla tah-a anavahmang Levi ho chun, akhangit lounao akipoh teidiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeng jongle amahon kamun theng sunga kin aboluva, inpi kotpiho ngah-a pang diu, inpia chu kin aboldiu; mipi ho dinga govam thilto ganlhainaho chu athaova, akinu bol dinga amasanguva dingdiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu amaho amilimhou masanga amaho dinga lhachana atoh uva, Israel insung khansetna achuhsah jeh uva; hijeh-a chu amaho douna-a kakhut kalhah ahin, akhangit lounao chu akipoh dingu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho kahenga thempu natoh tong dinga, kahenga hungnailut lou dingu, ahilouleh muntheng chungnung sunga kathil thengho khatcha anailut thei loudiu; amavang ajumnau leh thet umtah abolu chu akipohjoh dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla in'a bolding jousele asunga tohding jouse vetup dinga amaho chu kapansah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla Israel chate keija kona avavei laijuva, kamun theng vetupma anapang thempuho, Levi ho, Zadok chapate amaho chu kahenga kakinbol dinga hungnaijuva, thaole thisan tohdoh dinga kamasanga ding diu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaho kakinbol dinga kamunthenga lutnuva, kakin bol dinga kadokhang phung anailut diu, kathupeh achintup diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hung hiti ding ahi, amaho inhong sungnung kotpi ho-a alut tengule, tupat ponnem ho-a kivon diu; inhong sungnungle asung lama kin abol sunguva achunguva samul himhim kailou ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Alu uva tupat delnem akikopmuva, ataijuva tupat ponchol akichen diu; ulsa sona thei imacha akigah loudiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule inhong ponung, japi inhon ponunga ahungdoh tengule, akin bolnao vonho chu asutlhah uva dantheng sunga akoidiu, vondang akivon diu; mipi ho chu avonuva asuhtheng loudiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amahon asamu akivotol loudiu, ajangtelu jong ahoisao loudiu, alu-u akisemtup jing diu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Inhong sungnunga alut tengu jongle, thempu koimachan lengpitwi adon loudiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amahon meithai ahilouleh akidasa ji-a anei loudiu; Israel insung chilhah nungah, ahilouleh thempun ji-a ananeisa meithai akichenpi dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amahon kamite chu athengle akisuboh akibah louna chu ahildiu, chule athengle athenglou akibah louna ahetkhen sahdiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule kinelna aumteng, thutan na-a dinguva, kathutan dungjuija thu atan dingu; chule keima mina kikhop khomna jouse-a kadan thupeh le kadan kisunho anitdiu, kacholngah ni ajabol dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kisuhbohna dinga thilong phunga hung lou dingu; ahinla apa, ahiloule anu, ahiloule chapa, ahiloule chanu, ahiloule sopipa, ahiloule jinei loulai asopinu dinga vang kisuboh theiju ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama akisuhtheng jouteng, ama dinga nisagi asimdohpeh diu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule inhong sungnung, muntheng sunga kinbol dinga alut nikho tengle ama dinga chonset thilto ato ding ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule amaho agoulo dingdolu chu hiti ding ahi: Keimahi agoulou kahi; Israel insunga amaho gou napeh lou dingu ahi; Keimahi agouvu kahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amahon neh thilto, chonset thilto, suhkhelna thilto aneh diu ahin; Israel sunga Pathen'a dinga kitohho jouse chu amaho-a hiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thil jouse aga masapen lah-a gamasapen le thilto jouse lah-a nathiltou takip chu thempu ho-a ding ahi: aman na insunguva phatthei na aumdensah theina dinga, thempu chu nachanglhah lum masapenu jong napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thempuhon sa hihen lang vacha hijongle, akihehtel le achama thikam anehlou dingu ahi.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin nanghon vang vetna-a gamlo ding nakihop tengule, Pakai henga gambih theng khat natodoh dingu ahi. Adunglam chu pengmol sangsomni le sangnga hiding, availam chu sangsom hiding; hichehi gamsung kimvel jouse-a atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichehi muntheng dinga adunglam janga, availam janga kimvel hiding, chule akimvela gam ong tong somnga umding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hiche tena-a hi adunglam sangsomni le sangnga, chule availam sangsom natedoh-a, hiche sunga chu munthengle muntheng chungnung umding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Gambih theng chu muntheng kinbol, Pakai kinbol dinga hungnai thempuho chanding hiding; hichu a-inhou sahna ding mun hiding, chule munthenga dinga atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule adunglam sangsomni le sangnga, vailam sangsom jong chu in'a kinbola Levi mite chang diu, indan somni dinga alodiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gambih theng kipedoh chu khopi dinga adunglam sangsomni le sangnga, availam sangnga hiding, hichu Israel insung pumpi-a ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Leng chapa chanding chu gamtheng kitohdoh-a kona hilamle khulam panga umding ahin, chule khopi chanding chu, gamtheng kipedoh masanga aumin, chule khopi sungle lhum lama kon chu lhum lama, solama kon solama kijompeh ding; chule adunglam chu lhum lama pat solam gamgi ngahna, gambehho lah-a khattoh kigalsai chan gei chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichu Israel gamsunga ama chanding ahi; kapipui hon kamite asuhgimbe tahlou diu, chule gam amoh chu aphungu dungjuija Israel insung apeh dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitihin Pakai Pathen'in aseije; vo Israel Leng chapaho, phaset tahen; hunamle thilchom haijun lang, thudihle thutanna pandoh-un, kamiteho-a konin hunam haijun tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanghon khaikot dihho, ephah dihtah, bath dihtah naman diu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ephah le bath chu tena kibang hiding, bath chun homer hop soma hop khat adolding, chule ephah chun homer hop soma hop khat adolding, thil tena chu homer dungjuija teding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shekel chu gerah somni hiding, shekel somni, shekel somni le nga, shekel somlenga chu nangho dinga mina khat hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichehi Pathen'a thilto napehdiu chu ahi, suhlou chang homer khat le ephah hop gupma hop khat, sakol chang homer khat le ephah hop gupma hop khat napeh diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thaotwi chungchang dan thupeh chu ahile, thaotwi bath khat chu cor a kona bath hop soma hop khat ahin; cor khat chu homer ahiloule bath som ahi. Ajehchu bath som chu homer khat ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anneh thilto dingle govam thilto ding, chamna thilto dingle miho kichamna semna dinga Israel hamhing phatna ho-a kon, kelngoihon lah-a kon khat, jani lah-a kona kelngoinou khat napeh diu ahi, tin Pakai Pathen'in aseijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gamsunga mi jousen Israel sunga leng chapa-a dinga hiche thilpeh hi apehcheh diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hichehi leng chapa kin ding chu; lhathah nikho-a, cholngah nikho-a, Israel insunga lhentum kut jouse-a govam thilpeh, anneh thilpeh, don thilpeh, govam thilpeh, chule chamna thilpeh, Israelte insung dinga chamna thilpeh agon ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai Pathen'in hitin aseije, lhamasa alhasunga nimasa nileh, bongchal gol nolnabei khatna muntheng chu nasuhtheng diu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule thempu chun chonset thilto thisan chu alah-a, inkhom chunga, maicham kitunna ningli chunga, chule inhong sungnung kotpi khom chungchu anu ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule chuche lha nisagi ni chule suhkhel neitapou dingle milham dinga nabol ding; chutiachu insung nasuhcham diu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lha masapen-a chuche lha nisomle nili tengchule, nanghon kalchuh kut naman uva, nisagi golvah naboldiu, cholsolou changlhah naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hicheni chule lengchapan ama dingle gamsunga mipi jouse dinga chonset thilto dinga bongchal khat agon ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nisagi kut sunga chu Pakai henga govam thilto dinga aman nolnabei cheh bongchal sagile kelngoichal sagi niseh-a anisagi-a dinga chu agon ding, chule chonset thilto dinga kelchaho lah-a anou khat atoding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule aman anneh thilto dinga, bongchal khat dinga ephah khat, kelngoichal khat dinga ephah khat, ephah khat dinga thaotwi hin dimkhat agon ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lha sagi lhinna, alha sunga nisomle ninga nikho teng, nisagi kut kiman bang banga chu abolding, chonset thilto, govam thilto le, anneh thilpeh, chule thaotwi agon ding ahi.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai Pathen'in hitin aseije, solam ngat inhong sungnung kotpi chu nigup sunga kikhah jing ding, cholngah nikho le vang kihong ding, chule lhathah nikho nile jong kihong ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leng chapa chu apolama hongcha kotpi-a chu hunglutna, kotpi khom phunga chu ding dena, ama govam thilto le chamna thilto ding chu thempu chun agonpeh ding; ama kotpi bula chu chibai aboh-a, chuteng potdoh ding, nilhah kahse-a kotpi chu kikhah lou ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche banga chu gamsung miten hiche kotpi phunga hi choldo nile lhathah nikho ni-a Pakai anga chibai abohdiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule choldoni-a Pakai anga lengchapan atoding govam thilto chu, nolnabei kelngoinou gup le kelngoichal nolnabei khat hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule kelngoichal khat dinga anneh thilpehho chu ephah khat hintin, kelngoinou ho ding chu apehjou kham cheh, chule ephah khatna dinga thaotwi hin khat hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule lhathah nikho nileh nolnabei bongchalgol khat, chule kelngoinou gup, kelngoichal khat hiding, nolnabei cheh hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman anneh thilpeh apehding, bongchal khat dinga ephah khat, kelngoichal khat dinga ephah khat, kelngoinou ho ding vang atamto theichan hiding, chule ephah khat dinga thaotwi hin khat hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Leng chapa alut dingteng, hongcha kotpi lama chu lutna, hiche lampia chu potkit ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin Kutpi nikho-a gamsung mite Pakai anga ahung tengule, sahlam kotpi-a lutna chu lhanglam kotpi-a pot ding; lhanglam kotpi-a lutna chu sahlam kotpi-a pot ding, ahunglutna kotpi lama kilelouva, amalama chepaipai joding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Alah uva leng chapa chu, amaho alut tengule lutna; amaho achedoh tengule chedoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule kut sungle anipi niho-a anneh thilpeh chu bongchal khatna ephah khat, kelngoichal khatna ephah khat, chule kelngoinou ho dinga apehjou khambep, chule ephah khatna thaotwi hin khat hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun leng chapan ama chama govam thilpeh abola, ahiloule Pakai dinga ama chama thilpeh agon tengle, solam nga-a kotpi chu mikhatnin ahonpeh ding, cholngah nikho-a abol banga, aman agovam thilto le achamna thilpeh akigon ding; chuteng ama potdoh ding, ama potdoh joule kotpi khatnin akhading ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangman nolnabei kum khat lhingbep kelngoinou khat niseh-a Pakai dinga govam thilpeh nagon ding ahi. Hichu jingkah seh-a nagon ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche dinga hi jingkah seh-a anneh thilpeh nagon ding, ephah hop gupma hop khat le thaotwi hin khat hop thuma hopkhat chu changbongnel toh namehtha ding; Pakaiya dinga kumkho-a houdan anneh thilpeh jomjing chu hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiti achu amahon kelngoinou le anneh thilpeh, chule thaotwi chu jingseh-a tanglouva govam thilto dinga agon jing dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai Pathen'in hitin aseije; lengchapan achapate khattou thilpeh apehle, chuche goulo chu achapatea hiding ahi; hichu agoulou thilkeo hiding ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman agouloa kona asohte khattou thilpeh apeh ahilevang, achamlhat kum geija ama-a hintin; chuchejou tengle lengpa chapa kilepeh kitding ahi. Ahinla agoulo chu achapate bou changding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chukalvalin leng chapa chun mipi ho chu aneijuva kona nodoh nadinga, hunama agoulo-u chu alahpeh louding; amavang aman achapate chu aneija kona alahdoh-a agoulo dingu apeh dingjoh ahi. Chutile kamite jouse aneijuva kona kithecheh loudiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin aman kotpi panga um, lutna-a chun, sahlam sang nga-a thempuho indan theng sunga chun eipuilutin; chuin veuvin, lhumlam sihtenia chun mun khat kamun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman kajah-a, hichehi thempuhon suhkhel thilto le chonset thiltoho ahon nadiu mun chu ahin, hia chu amahon anneh thilto chu akandiu; chutiachu amahon inhongsung ponunga, mipi ho thensona dinga ahinpoh doh loudiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin aman inhong ponung sunga chun eipuidoh-in, inhongsung ning li-a chun eipuilen; chuin veuvin, inhongsung ning tina chun inhongsung khat cheh aumin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Inhongsung ning li-a chun tong somli sao, tong somthum len, inhongsung kijopmat aumin, hiche ning li hohi tena kibang ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Asungu kimvel, amaho li kimvela chun agola kisa in aumin, atogola chun mei tina thuhho akisemin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman kajah-a, hichehohi anhonho dinga munho ahin, hia chu houin'a lhachahon mipite kilhainaho chu ahondiu ahi, ati.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouchun aman inkot phung lama eipui kitnin; chuin, veuvin, solam ngat kotbul noija konchun twiho ahung longdoh-in ahi. Ajehchu inmai chun solam angat ahin, twiho chu maicham lhanglam sang, in jetlam sanga noija kon hung longlha ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuphatnin aman sahlam kotpi-a chun eipuidoh-in, polang lampia, kotpi ponung, pamlam solam ngat lampia chun eipuijin, chule veuvin, jetlam sanga chun twiho ahung longdoh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin akhutna khao choipa chu solam nga-a achedoh phatnin, tong sangkhat atedoh-in, twilah-a chun eipuijin ahile, twi chun kakeng khochong aphan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin tong sangkhat atedoh kitnin, twilah-a chun eipuijin ahile, twi chun kakhup aphan ahi. Chuin aman tong sangkhat atedoh kitnin, twilah-a chun eipuidoh kitnin ahile, twi chun kakong aphan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouchun tong sangkhat atedoh kitnin ahile; kapal galkai joulou vadung anahitai. Ijeh inem itile twi chu akhangin, ajapma japtho ding ahitan, palgalkai joulou ding vadung ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman kajah-a, mihem chapa, hichehi namu-em? eiti. Chuin aman eipuijin, vadung panga chun eikinung lesah tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun keima kakinungle phatnin, veuvin, vadung apang teni-a chun alangto-in thingphung tampitah akeh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman kajah-a, hiche twihohi solam gama longlha-a, nelgam lama longsuh-a, twipia longlut ahin; twi hin twipi aphah phahle, twi chu damding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hung hiti ding ahi, vadung lonna lamjousea, ahing theija chatloh thei jouse chu hing dingu ahi. Ajehchu twiho chu khulama ahunglon jeh-a, nga atama tam umding ahi; ijeh inem itile amaho kisudam dingu, chule vadung lon nalam jouse-a chu imajouse hingding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hung hiti ding ahi, Engedi apat Eneglaim chan geija ngamanho chu kipatdoh dingu, hiche munho chu len sena mun hung hiding; angahou chu amaho jat dungjuija twipi lenho-a nga banga hatama hung tamdiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla chua bonnganle bonlhoh munchu damlou ding ahi, amaho chi henga kipedoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule chua vadung pang, hilam pangle khulam panga chu, nehdinga thingphung jouse kehding, anaho pullou ding, agao jong beithei louding; atwi chu munthenga kona hunglong doh ahijeh-a, lhathah dungjuija gathah ahin sepdoh ding; atheiga chu anneh hija, athingna chu damna hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai Pathen'in hitin aseije; Israel phung somle phung ni dungjuija agam lo dingu gamtum chu hichehi hiding ahi: Joseph chu chan ni chang ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanghon hichu, khat cheh-in kibang cheh-a nalodiu; hiche thudol chu napu napateu pehdinga kakhut kanadopsa ahitan, hiche gamhi nangho goulo dinga hungum ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichehi sahlam sanga gamgi chu hiding ahi: twipilen'a pat Hethlon lampia, Zedad'a mi chena gei,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hamath, Berothah, Sibraim, hichu Damascus le Hamath kikah-a gamgi ahin, Hazarhatticon, hichu Hauran gamkol kom ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule twipia patna gamgi chu Hazarenan gei Damascus gamsung hintin, chunglam sahlam sanga um chule Hamath gamsung gei hiding ahi. Hichehi sahlam sang gamgi ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule solamsang chu nanghon Hauran'a pat Damascus apat, Gilead'a pat chule Jordan solam twipi gamgia pat le Israel gamgia pat nate diu ahi. Chule hichehi Solamsang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule lhanglam sanga lhanglam chu, Tamar apat Kadesh a twiho, twipilen vadung gei ngei chu hiding ahi. Chule hichehi lhanglam sanga lhanglam ngat chu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lhumlam sang chu gamgia pat twipilen, Hamath a mi hung galkai theina gei chu hiding ahi. Hichehi lhumlam sang ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiti-a hi Israel phungho dungjuija gam chu nakihop diu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hung hiti ding ahi, hiti achu vang vetna nangho goulo dingle nalah uva hung pemlut gamdang mi, nalah uva chate hinhing dingho chu nakihop diu ahi. Chule amaho Israel chate lah-a gamsunga pengden nalah uva um tobang hidiu ahin, amahon Israel phung lah-a nang hotoh gou alokhom dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hung hiti ding ahi, gamdang mi ipi phung sunga hung pemlut hijongle, nanghon ama chu chua agoulo ding napeh diu ahi, tin Pakai Pathen chun aseije.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichehohi phung minho chu ahiuve. Sahlam mong Hethlon gamkol lampi, Hamath'a chena, Hazarenan, sahlam sang Damascus gamsung le Hamath gamkol chan hiding ahi, ajehchu hichehohi solam le lhumlama ama gamkai ahin, Dan chanvou chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Dan gamsung, solama pat lhumlam gei chu, Asher chan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Asher gamsung, solama pat lhumlam gei chu, Naphtali chan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Naphtali gamsung, solama pat lhumlam gei chu, Manasseh chan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Manasseh gamsung, solama pat lhumlam gei chu, Ephraim chan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Ephraim gamsung, solama pat lhumlam gei chu, Reuben chan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Reuben gamsung, solama pat lhumlam gei chu, Judah chan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Judah gamsung, solama pat lhumlam gei chu, avai pengmol sangsomni le sangnga, gamchan dangho khat banga sao, solama pat lhumlam gei chu natodoh dinguva um natodoh-u chu hiding ahi. Hiche lailunga chu muntheng chu umding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai houna dinga natodoh dingu chu adung sangsomni le sangnga, avai sangsom hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amaho ding, thempuho ding ngei chu, hiche kipedoh theng chu hiding; sahlam sang sangsomni le sangnga sao, chule solamsang sangsoma len, chule lhanglam chu sangsomni le sangnga sao hiding ahi. Chule Pakai muntheng chu alailunga chu umding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichehi Israel chate anavavei laijuva, Levi miho anavavei banguva anavah veilou, kathupeh anaching tupma ana kisuthengsa Zadok chapate thempu ho-a hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hiche akipedoh gam chu, amaho dinga Levi mite gamsung thiltheng chungnung hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule thempuho gamsung jonna chu Levi miten gam adung sangsomni le sangnga, avai sangsom anei dingu ahi, adung jouse chu sangsomni le sangnga hiding, chule avai chu sangsom hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amahon hichehi ajoh loudiu, ahiloule alhet loudiu, gamga masaho jong midang apeh loudiu ahi; ajehchu hichehi Pakai dinga atheng ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule sangsomni le sangnga jonna avai sanga kidalha chu khopi dinga manchah thei hiding, chule mipi dinga chenna dingle khovel hiding ahi. Chule hiche alailunga chu khopi umding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hichehi akite dan hiding ahi: sahlam sang chu sangli le janga, lhanglam sang sangli le janga, solamsang sangli le janga, chule lhumlam sang sangli le janga hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule khopivel chu sahlam sangjani le somnga, lhanglam sangjani le somnga, solam sangjani le somnga, lhumlam sang chu jani le somnga hiding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule akipedoh gambih theng jona avalchu adunglam chu solamsang sangsom, lhumlam sang sangsom hiding ahi. Chule hichu akipedoh gambih theng jona umding ahin, chule chua aga sohdoh chu khopi kinbolho kivahna hiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khopi kinbol ho chu Israel phungho-a kona bou aboldiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Akipedoh pumpi adung avai chu sangsomni le sangnga cheh hiding ahi, khopi chan puma aningli kibanga akipedoh theng chu natodoh thadingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amoh akipedoh theng pang jetle vei chu lengchapa-a hiding, akipedoh sangsomni le sangnga solam gamsung jona, chule lhumlam sang gamsung jona sangsomni le sangnga, hiche chanho jongchu lengchapa-a ahi. Chule hichehi akipedoh theng chu hiding ahi. Chule hiche lailunga chu houin muntheng chu umding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche chungchona chu Levi mite chanvouho le khopi chanvouho-a pat alailunggei lengchapa-a hija, Benjamin gamsungle Judah gamsung kikah chu lengchapa-a ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aumnalai phungho thudol chu, solam sanga pat lhumlam gei chu, Benjamin phungin chan khat aneiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Benjamin gamsung, solama pat lhumlam geija Simeon'in chan khat aneiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Simeon gamsung, solama pat lhumlam gei chu Issachar chan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Issachar gamsung, solama pat lhumlam gei chu Zebulun chan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Zebulun gamsung, solama pat lhumlam gei chu Gad chan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Gad gamsung chu, lhumlam sanga lhanglam panga gamgi chu Tamar'a pat Kadesh'a longlut twiho geile twipilen lama long vadung gei chu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichehi nanghon Israel phung mite goulo dinga vangvetna nahoppeh dingu gamchu ahin, chule hiche hohi achanvou uchu ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichehohi khopi-a kona sahlam panga gamgi ngahna kilhungdoh ahin, tenaho-a sangli le janga ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khopi kotpiho chu Israel phungho min dungjuija sah ding ahin, sahlam panga kotpi thum aumin, Reuben kotpi khat, Judah kotpi khat, Levi kotpi khat ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule solam sanga sangli le janga, chule kotpi thum, Joseph kotpi khat, Benjamin kotpi khat, Dan kotpi khat ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule lhanglam sanga sangli le janga, chule kotpi thum, Simeon kotpi khat, Issachar kotpi khat, Zebulun kotpi khat ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lhumlam sanga sangli le janga, akotpiu thum toh, Gad kotpi khat, Asher kotpi khat, Naphtali kotpi khat ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Akimvel chu tena sangsom le sangget ahin, chuche ni-a patna chuche khopi min chu, chumuna Pakai aume, hiding ahi.
  </para>
</usx>
