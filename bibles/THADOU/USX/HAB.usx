<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="HAB" style="id">Habakkuk</book>
  <para style="h">Habakkuk</para>
  <para style="toc1">Habakkuk</para>
  <para style="toc2">Habakkuk</para>
  <para style="mt">Habakkuk</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Habakkuk themgaovin anamu pohgih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Pakai, itihchan kakouva, ngaipeh louva neikoi ding ham! hunam-a natoh chungchanga nangma kakouva, nangman huhdoh louva nakoi dingham!
  </para>
  <para style="p">
    <verse number="3" style="v" />Ipi dinga khangitlouna neimusah-a, gentheinaho neivetsah ham? Ajehchu gamna le hunama natoh kamasanga aumin, kinah nale kidouna ahung sohdoh tai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun danthu athahat jou tapon, chule thutana dih himhim aum tapoi: ajehchu migilou hon michonpha chu aumchah taovin; hijeh chun thutan dihlou amachaltan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon Pathen hephalou lah khu veovin, ngaitouvin lang, kidang satah-in datmouvin; ajehchu nanikho hou sunga na khat katohding, hichu nangho nakiseipeh jongleu, natahsan lou diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu, veuvin, keiman nam gangtah le engsetah, Chaldea mite katungdoh-e, amaho chun leiset chung achot leova, amaho-a hilou chena munho chu alo dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho chu kichat umtahle tijat umtah ahiuvin; athutan nule aja-umnao chu amahole amaho-a kona sohdoh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asakolhou jong lutnuho sangin akaljang jouvin, nilhah lam ngeiho sangin gin aumjouve; asakol chung touhou chu kithejal uva, asakol chung touhou chu gamlatah-a kona hungdiu; amaho chu an nedinga kinotah-a leng muvanlai banga leng dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abonchauva hunam-a natong dinga hungkon diu; amaiju chu solam hui banga hungdoh ding, chule amahon sohchangho chu neldi banga akhopkhom diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon lengho chu nahsahmon neijuntin, pipuiho chu amaho totnopna hidingu: amahon kuldet jouse chu anuisat diu; ajehchu leivui avuh khumuva alahjeng diu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuteng alungthim kikhel ding, apal galkal paipai ding, asuh lungjing ding athahatna chu a-pathen'a kona angaito ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pakai ka Pathen, keija athengpen, nangma atonsotna pat umjing nahilou ham? keiho thipou vinge. Vo Pakai, nangman amaho chu thutan dingin nana sudetnin; chule vo hat chungnung Pathen, nangman suhdih nadingin amaho natungdoh tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangma thilse vethei louhel mit thengpen, chule khansetna vetheilou nahin; iti danna dihlou tah-a chonho navetthima, mikhang gilouvin amasanga chonphajo michu suhmang ding atiteng thipbeh-a naum ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule iti dana mihemte hi twikhanglen'a ngaho, achunguva vaihom neilouho a-opma kithol thoho, bangbepma nasem ham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon amaho chu abonchan ngakoijin akoidoh-un, alennuva amanun, alen khon houva ahuikhomun; hijeh chun amaho akipah-un athanomun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun amahon alennu henga ganlhaina abollun, alen khonhou henga gimnamtui ahaljiuve; ajehchu hiche ho-a kona chu haodoh uva, anneh nenga ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh-a chu amahon alennu chu asuhthenguva, namtin vaipi chu khenlou hella athajom jingdiu ham?
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keima galvena mun'a kadina, insang chunga kapansat ding, aman kahenga ipi ahinseija, chule suhdih-a kaumteng, iti kadonbut dingham gavenge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin eidonbutnin, hitin ati, gaothilmu chu asimpan lhaipuma asimthei nadin, songpheng chunga kichehtah-in sunin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu gaothilmu chu phat kitepsa sunga ding ahin, hijongle achainale thu asei ding, jou louding ahi; geijep jongleh ngah tadin; ajehchu hunglhung teiding ahin, geisang louding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Veovin, ama kichoisanga chu, ahinna ama-a achondih poi; Ahinla midih chu atahsan vanga hing ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukitmale ama ju-a suhkhelna anei jeh-in, mikiletsah ahin, chule in'a jong aum pon, angaichat chu thilkholkhul bangin akehlenin, chule athi tobang ahin, chimtheilou ahi, ahinla nam jouse ahenga akhom khomin, mijouse chu ahenga asekhomin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hicheho jousehin ama douna-a thulem aseijuva, ama douna-a jontaina thuchih, ama-a hilou kholkhompa chule bonlhoh satah-a pohding kisempa chu ohe ada na-e! itih chanpi ahiti theidem? tia aseilou dingu ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangma napet dingho chu kipatdoh phunguva, nasugenthei dingho chu thoudoh uva, nangma amaho dinga gal thila kichomdoh nahilou ding ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman nam tamtah nachomgam jehle, miho thisan naso-a, gamsung, khopi le asunga cheng jouse chunga hunam namanchah jeh-a, mihem ahingdoh amoh chengsen nangma nachom dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thaneina dihlouva kona akihuhdoh theina dingle, abu sangtah-a akisah theina dinga, kilosetna phalouva a-insung dinga kilosepa chu ohe ada ahi!
  </para>
  <para style="p">
    <verse number="10" style="v" />Mitamtah nasuhgama konin na-insung najumsah-in, chule nahinna dounan chonsea nahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu banga kona song chu pengdoh ding, thinga kon inkam chun ahindonbut ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thisanna khopi sahdoh-a, khan gitlouna-a khopi tungdohpa chu ohe ada ahi!
  </para>
  <para style="p">
    <verse number="13" style="v" />Veovin, mihon meikong vahna dinga atohgimu chu, janel Pakaiya ding ahipoi; mipi ho chu pannabei dinga kisulung gim dingu ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu twijin twipi akhubanga, Pakai loupi hetna chun leiset hi alodim ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aheng akom asagoh keovu mutheina dinga ju pe-a, juhai tunpeh-a, kham jong khamsah-a michu, ohe ada ahi!
  </para>
  <para style="p">
    <verse number="16" style="v" />Loupina khelin jachatnan nadimtai: nangman jong don inlang, nachep jong chu kihohdoh hen; Pakai khut jetlam khon chu nangma douna-a hungkihei ding, naloupina chunga jachatna sangtah chu ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gamsung, khopi sung, chule asunga cheng jouse chunga pumhat naman jeh-a, Lebanon chunga pumhat thilbol, chule miho thisan kiso jeh-a gamsaho kichatsah suhgamna chun nangma nakhu khum ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Asempan asemthu milim, chule akilhah tho milim, jouthu hila pang, asemtengle asempa chun hichu atahsan, chuche paomo milim chu ipi-a phachom em?
  </para>
  <para style="p">
    <verse number="19" style="v" />Thingjah-a thouvin, song paotheilou jah-a kipat in, hichun ahilding ahi, tipa chu ohe ada ahi! Veovin, hichu sanale dangka-a kiloijol ahin, asunga haitheina hu umlouhel ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla Pakai vang chu a-houin theng sunga um ahin, leiset pumpi a-anga thipchet hen.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shigionoth chunga Habakkuk themgao taona ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai, nathusei kajan, kakicha lheh-e: O Pakai, kumho sunga hin nanatoh hinsuhalin, kumho sungin kihetdohsah in; lunghan na-a hepina geldoh in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen chu Teman'a konin ahungin, chule Athengpa chu Paran molsanga konin ahunge. Selah Aloupinan vanho atomin, leiset hi avahchoi na-in adime.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ama vahdan chu nisa vah abangin; akhutna konin vahgui akikhodoh in, chule hichea chun athahat akiselin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amasanga hise achen, akengtoa natset khohsetah apohdoh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama adingin leiset chu aten; aman aven, chule namtin chu anocheh-in; tonsot molsang ho chu akithe cheh-un, tonsot lhangho chu abohkhupmuve. Alampiho chu tonsotna ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman Cushan ponbuh gimthoh-a aum kamun, Midian gama ponjal ho chu akithingin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai chu vadungho chunga lunglhailou ham? Nalunghanna chu vadungho chunga uma hitam? Nalungsatna chu twikhanglen chung, nasakol ho, nahuhhingna sakol ho chunga natouna chunga chu uma hitam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Nathu dungjui, phungho kihahselna dungjuijin nathalpi chu akeoseh-in aumtai. Selah Nangman leiset hi vadungho-in nahomkhene.
  </para>
  <para style="p">
    <verse number="10" style="v" />Molsang ho chun nangma namun, akihot jenguve: twi longlet chu ahin jotpan ahi. Twi thuh chun a-aw ahinsodoh sah-in, chule akhut chunglama adomtouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nisa le Lhathah chu aumna-a adingden honin; athalpi chang vah leh, natengcha phelitlet vah-a chun ache honin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lungphamo pumin gamsung najotsoh-in, nalunghana-in Pathen hephalou mite nachilgoi tai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Namite huhhingna dingin nakon doh-in, nathao nusapa huhhing dingin nakondoh tai; abula pat angong geijin nahodoh peh-in, migiloupa inna konin alu namaputsah tai. Selah
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman ama tenggol ho-a chun akhosung lamkaiteo luchang navohpeh-in; keima sucheh dingin chimpei bangin ahungdoh uve: amaho kipana chu guhthima mivaichaho bahgam dingbou chu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman nasakol'in twikhanglen napal galkaijin, twipi kinong nasatah lah chu napal galkaije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman kajah phat chun ka-oipi akithingin; awgin chun kaneteni akihotnin; kagusunga monna alutnin, lungkhamna nikho-a kakicholdo theina dingin keima kakithingtai. Mipi ho henga ama ahungtou tengle, aman agalsat miho toh amaho chu asat ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Theichang phung pahhih henlang, lengpi gui aga umhih jongle; olive kibolna tohgimna chu thon henlang, phaileijin anneh sodoh hih jongle; ganhonga konin ganchaho kisugamhel henlang, gan inho-a gancha umhih jongleh;
  </para>
  <para style="p">
    <verse number="18" style="v" />Keivang Pakaiyah kipah jing inting, eihuh hingpa ka Pathen'a kathanop ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakai Pathen chu kathahatna ahin, aman kakeng hi sajuhpi keng banga asemding; chule aman kamun sangho-a eivale sah ding ahi. La lamkaipa henga, ka tumgingthei akhaonei mangcha-a sah ding.
  </para>
</usx>
