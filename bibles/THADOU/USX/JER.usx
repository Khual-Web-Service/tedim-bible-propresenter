<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JER" style="id">Jeremiah</book>
  <para style="h">Jeremiah</para>
  <para style="toc1">Jeremiah</para>
  <para style="toc2">Jeremiah</para>
  <para style="mt">Jeremiah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Benjamin gamsunga Anathoth'a um thempuho lah-a Hilkiah chapa Jeremiah thuho,
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah te leng Amon chapa Josiah nikholaija alengchan kal kum somle thumna in akoma Pakai thu ahung lhunge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah te leng Josiah chapa Jehoiakim nikholai jin jong, Judah te leng Josiah chapa Zedekiah kum somlekhat kichailam gei, Jerusalem gal hinga kikaimang lha nga lhinna geijin hiche thuhi ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakai thu chu kakoma ahung lhungtan,
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman nangma naobu sunga kasem masanga kanahetsa nahin, naobu-a kona nahung potdoh masanga kanasuh thengsa, chule namtin themgao dinga kapansah nahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin keiman, kate, Pakai Pathen! ven, chapang kahi jeh-in, ima kasei theipoi katin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Pakai chun, chapang kahi tihih-in, ajehchu keiman nangma kasolna jouse-a nache ding, keiman kathupeh chan naseidoh ding ahi, tin kajah-a aseitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman, amaho mai khu kicha hih-in, ajehchu keiman nang huhdoh dingin kaumpi e, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakai chun akhut alhangin, kamuh akhoije. Chuin Pakaiyin kajah-a, Ven, keiman kathuhohi nakam sungah kakhum luttai, tin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ven, tunia hi ajungho kaldoh dingle, aloilhu ding, asumang ding, asuchim ding, chule aphutdoh dinga namtin vaipihole lenggam ho chunga kapansah nahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukalvalin, Pakai thuchu kakoma ahung lhungin, Jeremiah, ipi namu em? eiti e, chuin keiman, Almond thing tenggol khat kamu e, katin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin kajah-a, namuchen lheh-e, ajehchu kathu tohdoh-a aumna dinga kavetlhih jing ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakai thu chu aniveinan kakoma ahung lhungin, ipi namu em? eiti e, keiman bel soulahlah amai sahlam ngat khat kamui, tin kaseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin kajah-a, sahlama pat thilphalou khat hungpotnintin, gamsunga chengho jouse chunga hung chuding ahi, tin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu ven, keiman sahlam lenggam ho jouse kakou ding, amaho hung dingu, Jerusalem lutna kotpiho phungle akimvele kulbangho, chule Judah khopiho jouse douna-a alaltounao atundoh cheh dingu ahi, tin Pakai jin aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keiman, keima eidalhah uva pathen dangho houna-a gimnamtui ahalu, chule akhut uva kisemho joh ahou uva, agitlounau chunga thutanlhahna kanei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun, nangman nakong kigah-in, chule kipatdoh-in lang, keiman kathupeh jouse chu amaho lah-a seijin, a-angsung uva meidoi hih-in, achutiloule keiman amasanguva nangma kisuh dongsah get inge.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijeh inam itile, ven, tunin keiman nangmahi kihuh dohna khopi kasema, chule thihkhompi, gamsung pumpi, Judah lengho, pipuiho, thempuho chule agam miteu douna sum-eng kulpi detna kasem nahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahon nangma nadou diu, hijongle najolou dingu ahi. Ajehchu nangma huhdoh dinga keiman kaumpi nahi, tin Pakaiyin aseije.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin Pakai thu chu kahenga ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chenlang Jerusalem nakhanga gasamin, Pakaiyin hitin aseije; tin seijin; nakhangdon laija namikhotonale, najite nangailutna, lholou gama, gamthipma kanung najuilai chu kahe jinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel chu Pakaiya atheng ahin; Ama puntheina ga masaho anahi. Ama vallhum jouse themo changa; achunguva thilse chuding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Jacob insungle Israel insungho jouse, Pakai thuhi ngaitemun,
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin hitin aseije, napateu vin kagitlouna ipi amu uva, keija kona chegam lhaova, pannabei nung ajuijuva, pannabei soh-u hitam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Egypt gama kon eipuidoh uva, gamthip nelgam lhunga, nelgamle kokhuhho lah-a, gamgo gama, thina limnoi, koima chekhah lounale mihem chenlouna gam lhungkeija einapuihoi leuva Pakai chu hoijaba um hitam? tin jong aseipouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule keiman nangho ninglhinna gam, chu-a gamga le aphatnaho nedingin kanapuilutnin; ahinla nangho chu-a nalut phatnun kagam nasuboh-un, kagouho chu kidah um nasosah taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thempuhon, Pakai chu hoija umtam? atipouve, dan tuhhon keima eiheta pouve. Hou lamkaiho jong kachunga achonkhel taove, chule themgao hon Baal thu aseijun phatchomna bei thilho nung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh achu, Pakai keiman nathu kasei jingding, chule nachateo chateho thu jong kasei ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu Chittim twikol gam chonsoh in lang ven, Kedar geijin mi solin, hitobang thilhi umnam, gunchu tah-in ngaiton.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nam khatnin pathen hilou a-pathen ho akhelkhah uvem? Kamiten vang aphachom lou dingin aloupi nao chu akikhel taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo nangho vanhon, hiche hi datmouvin, tijat umtah in kichauvin, nangho kamhelun, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu kamiten manthah na thil ni aboluve; amahon hinna twinah keima eidalhaovin, twi veithei louna twikul akilaijuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel chu soh khat ham? In le lou neilou soh hija ham? Ijeh-a ama suhsetna uma hitam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Keipibahkai chalgolin angih-in, ahamin chule agam chu asumangin; akhopiho acheng beihelin ahalvamin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Noph le Tahapanes chaten jong nalu-a lallukhuh asukeh taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichehi Pakai na-Pathen'in lamdunga napuihoile laija ama nadalhah jeh-a nangle nangin nakilamdoh hilouham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangin Egypt lampia hi Sihor twi dona dinga ipi nabol dingham? Ahiloule vadung twiho donna dinga Assyria lampia hi ipi nabol ding ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangmatah gitlouna chun nangma nasuhdih ding, nanungchona chun nangma naphosal ding ahi, hijeh achu Pakai na-Pathen nadalhah-a, keima ginna nasunga aumlouhi thilphaloule thilkha ahi, ti nahetna namu ding ahi, tin janel Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu sotlaipeh-a na namkoljon kasuhboh-a, naloiho kasuhmangthah ahitai. Chule nangin, keima chonval taponge natin, molsang chung takiple thingphung hing noi takipma numei kijoh bangin navahlen, nakijoh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla keiman lengpigui pha, muchi dihtah-a kanaphu nahi. Achutile ibola keidinga mansuhna, gamlah lengpigui keh naso jeng hitam?
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu nangma chang-alin kisopmin lang, sabon tamtah mangjong lechun, nakhangitlouna chu kamasanga kimelchih ahitai, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangman kakisuboh poi, Baal kajuipoi iti nati ngam ding ham? phaichama nalampi ven, ipi nabol kihetnin, nangmahi mangang tah sangongsang nu acham chama che;
  </para>
  <para style="p">
    <verse number="24" style="v" />Gamthipma um gamlah sangan anopnopma hui donlele, ahuhlai chu kon asuhkih thei ding ham? Aholte jouse lungkham daohen, alha lhinteng amutei dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kengchot beija naum louna din chule nadang gotlouna din umin, ahinla nangman, Kinepna aumtapoi, Aumtapoi, ajehchu keiman gamdang mi kangailun, anungu kajui ding ahi, tin naseije.
  </para>
  <para style="p">
    <verse number="26" style="v" />Gucha akimatdoh phatle ajachat bangin, Israel insung mite ajahcha taove. Amaho, alenghou, aleng chapatehou, athempuhou chule athemgao houvin,
  </para>
  <para style="p">
    <verse number="27" style="v" />Thingbul jah-a, nangma kapa nahin, song jah-a nangin neihin vahdoh ahi, atiuve. Ajehchu amahon eimaingat louvin einungsun taove. Ahivangin amahon agenthei phattah ule, kipat in, neihuh doh-un, tiuvinte.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla nangman nakisemthu na-pathen ho chu hoija umtaovem? Amaho chu kipatdoh uhen, nagenthei pet uva nahuhdoh jou uvem? ajehchu vo Judah, nakhopi jouse jatna na-pathen ho umsa ahije.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ijeh-a nangho keimatoh kinelkal ihiuvem? Nangho nabonchaovin keima dounan nachonkhel taove, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nachateo chu mohseh-a kajep bep ahitai, kisuhdihnan anei tapouve. Nangho chemjam maman nathemgao hou chu, misugam keipibahkai bangin asugamtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vo, khang mite, nangman Pakai thuhi veuvin, Keima Israel dinga gamthiple muthim gam kahi hitam? Ijeh-a kamiten, keihohi pakaiho kahiuve, nahenga kahunglou dingu ahitai, atiu hitam?
  </para>
  <para style="p">
    <verse number="32" style="v" />Nungah in akivona ho asuhmil theija, ahiloule, mouvin avonho asuhmil theijem? Hinla kamiten nikho simjoulou khopmin eisumil taove.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ijeh-a dongma holna-a nalampi nakisuhjol ham? Hijeh chun migilou chu nalampi ho nahiltan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule napon mongho-a jong chaga monabei hinnaho thisan beh akimun ahi. Keiman hichehi holguh-a kamu ahipon, phongtah-a kamudoh ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahinla nangman, themona bei kahi jeh-in alunghana keija konin kiheimang teijinte nati-e. Ven, keima kachonsepoi nati jeh-a nathu katan ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nalampi khelna dinga ibola vahle humhal nahim? Assyria-a najachat lheh banga Egypt jeh-a jong najachat ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahi, nakhut naluchunga nangapma, ama-a kona nachedoh ding ahi. Ajehchu Pakaiyin natahsan ho jouse chu alahlousa ahin, amaho-a chu lolhinna nanei lou ding ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amahon, pasal'in ajinu dahenlang, amanu ama-a konin pot hen, pasal chom khatna hitale, amapa chu amanu koma akilekit dem? Chuche gam chu hatah-a suhboh-a umlou ding ham? atiuve. Ahinla nangma dongma tamtah toh noti'n nakichemin, kahenga nahung kilekit nalaije, tin Pakai jin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Munsang ho lam ngan dah-in, pasal tincheng to nalup louna mun umam? Gamthipma Arab ho bangin, amaho din lam tinna natoulen, najon thanhoi nale nagitlou nan gamsung chu nasuboh tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun gohong tuhtangin aumtan, go nunung jong ajutapoi; noti dehpang naneijin, jachat ding nanompon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman tu-a patnahi, Hepa, nangma hi kakhangdon laija patna eipuihoija chu nahi, tia neikou louding ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama a-itih-a lunghang jing ding ham? Akhonna geija akoiding ham? vetan, hihochu naseijin thilse najo chanin naboltan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Leng Josiah nikholaijin Pakai chun keikoma jong anaseijin, Israel kinungchonin abolkhu namu tah-em? Amanu molsang chung jousele thingphung hing noi tina achelen chule akijoh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin keiman, amanun hicheho jousehi aboljou phatnin, keilama hungkilen, kanatin ahi. Ahinla ahung kihei dehpoi, mikitahlou asopinu Judah'in hichu amutan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman, kinungchon Israel chu jonthanhoi jouse jeh-a kapaidoh-a, kadana thu kapeh jing vangin, mikitahlou asopinu Judah chu kichadeh louva, noti'a akichepjing jong kamun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ahitin ahi, numei kijoh ahina jalchun gamsung chu asubohtan; chule thingle songhotoh ajongin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hicheng jouse jeh-in tahsanbei asopinu Judah chu alung pumpin kahenga ahung kilehei dehpoi; akilepjo bouvin ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakaiyin kajah-a, nungchon Israel chu mikitahlou Judah sangin them akichanjoi, tin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chenlang hiche thuho hi sahlam sanga seiphonglen, tin Pakaiyin aseije, Kitahna neilou Israel, hungkinungle kitnin, chule kalunghana nachunga chuhsah taponge. Ajehchu keima mikhoto them kahin, a-itih-in lunghang jing ponge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nakhangitlouna bou kihetnin, nangma Pakai na Pathen dounan nasukheltai. Chule nalampi ho chu gamchom miho ding thingphung hing noi tina nathe jah-in, keima aw nangai pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo, nungchon chate hung kileuvin, ajehchu nangma kakichenpi nahin, keiman nangho khopi khatna kon khat, insung khatna kon ni ladoh ingting, Zion'a kapui ding nahiuve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman kalungtoh kelngoiching ho peuvinge, amahon chihnale hetthemna-a nangho navah dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hung hiti ding ahi, chuche nikho laiteng, chuche gama nahung punuva, nahungtam phatnile, amahon Pakai thulhun thingkhong tia aseitah lou dingu, geljong ageldohtah lou dingu, viljong avillou diu chule semphatna jong umtalou ding ahi, tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuphatle Jerusalem chu Pakai laltouna atidiu, namtin jouse chu, Jerusalem'a Pakai mina kikhom dingu, alungu gitlouna ngaitona banga chontalou ding ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chu nikho chule Judah insung chu Israel insungtoh lhakhom uva, sahlam gama kona hungpot khomdiu, napateu vin alodiuva kapeh gam lamchu ahin jot dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla keiman chate lah-a nangma iti kaumsah-a, namtin janelho gouhoile gam nom chu kapeh ding ham? kanatin ahi. Chule nangin, Hepa tia neikouva, keija kona nakihei mang lou ding ahitai, kanatin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahbeh-in mikitahlou in-neipi khat, ajipa-a kon apotdoh bangin, Israel insungin jong keima angsunga gilouna aboltai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel chate kanale taona munsang ho chunga akijadoh tan ahi, ajehchu amahon alampio akaleh-in akisemun, Pakai a-Pathen'u chu asumil taove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hung kileuvin, nungchon Israel chate, chutile nanung chon nao suhdampeh tange. Ven, keiho nahenga kahunguve, ajehchu nangma Pakai ka Pathen'u nahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Adihtah-in, lhang ho-a konle mol tamtah ho-a kona huhhingna mudin kakinem kheluve. Dihtah-in, Pakai ka Pathen uva Israel huhhingna chu aume.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu kakhang donlai juva pat kapateule achapateu, achanuteu le aganchahon hou chu jachatnan avallhumtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eiho jahchan i-umun, lungnoh phahnan eikhu taove. Ajehchu eihole ipateu, ikhangdon uva pat tuni geihin Pakai i-Pathen'u dounan ichonseu vin, Pakai i-Pathen'u awchu inangai tapouve.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin, Vo Israel nangma nahung kile-a, kahenga nahunga nalampi kidah umho chu kamitmu-a kona naheidoh leh, nangma kichonle tapon nate, tin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nangman, Pakai chu thutah-a, thutan na-a chule chonphatna-a hinga ahi tia nakihahsel ding ahi. Chutengle namtinho chu ama-a phatthei changa, ama-a loupi ding ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pakaiyin Judahte le Jerusalem jah-a, hitin ati, naleiset lholouhou chu kal let uvin, chule ling lah-a tu hih-un, tin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho Judah mitele Jerusalem'a chengten Pakaiya nachep tanunlang, nalungsung chep kitanun, ajole nathilbolu phatlou jeh-in, keima kalungsatna phelmit joulouvin mei bangin kongdoh getninte, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Judah'a seichoijin lang, Jerusalem'a phongjalin, gamsunga sumkon mut un pengun lang kikhom khomun, khopi kulneiho-a lutnuhite, tiuvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zion lama ponlap tahdoh-un, kikhin unlang umden hih-un, ajehchu keiman sahlama kona thilphalou, manthaina kahin pohlut ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keipibahkai chu aumna hamthing lah-a konin ahungdoh-in, chule chidang namdangte sumang dingpa ahung pheitai, nagam sungu kamhelsah dingin aumna-a konin akipatdoh tai. Chule nakhopihou chu chenna louva agoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh hin khaodip pon kisilun, kapmun lang pengun, ajehchu Pakai lungsat tijat umtah chu eihoa kona kiheimang lou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuni chule hung hiti ding ahi, lengpa le pipuiho lungthim mang intin; thempuhon adatmouva, themgao hon kidang asahdiu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin keiman, hekate, Pakai Pathen! nangman hiche mitele Jerusalem hi nalhep tahbeh ahitai. Chamna naneidiu ahi natin, hinlah chemjamin ahinnao chu asunkhatai, katin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuchephatle hiche mitele Jerusalem jah-a, gamthip munsang ho-a huigo chu kamite chanu umna lama, ajap ngim dingle athehngim ding hilouhel,
  </para>
  <para style="p">
    <verse number="12" style="v" />chuche munho-a kona huipi hattah kahenga hungnung ding; tu-a jong keiman achunguva thu katanlhah ding ahi, hung kiti ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ven, amachu meibol ho banga hung touva, akangtalai chu chimpei bang ding, asakolho chu mulaopi ho sanga gangjo ding ahiuve. Suhmanga um ihi jeh-un, ohe idau ahi!
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo Jerusalem, huhhing-a naum theina din, gitlouna-a konin nalung sopthengin. Nalung ngaito pannabei ho chu itihchan nasunga umding ham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu Dan-a konin awkhatnin aphongdoh-in, Ephraim mola kon suhgentheina hung lhading aphongjale.
  </para>
  <para style="p">
    <verse number="16" style="v" />Namtinho jah-a seilen; veuvin Jerusalem dounan phongdoh-un, gamlatah-a konin galbolho ahungun, Judah khopiho dounan ahinsam uve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keima eidou jeh uvin, loujao hongho bangin, amahon dounan a-umkimvel taove, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nachonnale nathilbolin hichehohi nachunga ahinsodoh ahin; hichehi nagitlouna ahin, anasalheh jenge, ajehchu hiche hin nalungsung ahinphah ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo kalungsung, kalungsung! kalungchang tah anai; kalungphut husa aginge; kigalgin husa sumkon ginchu, vo kahinna, nangin najah jeh-in kaumthim thei tapoi,
  </para>
  <para style="p">
    <verse number="20" style="v" />suhmangna chunga suhmangna in kho asamin, gamsung pumpi chu suhsetnin aumin, photlotnin kaponbuh, mitphet kahin kapondal akisusetai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Itih chanpi hiche ponlap hi kavetna, sumkon gin chu kangai jing ding ham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Kamitehi angol jeh-un eiheta pouvin, ju-ngolvei chate ahiuvin, hetchet aneipouve. Thilse bolna din achingun, thilpha bolnadin hetna aneipouve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leiset chu kagahven, vetemin, alimle agong bei ahin; chule vanho chu, amahon vah anei pouve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Molsangho kagahven, vetemun, akihot hotnun, lhang jouse kangchan akitol tolun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kagahvetle, vetemun, mihem aumtapoi, chungleng vachate jouse alengmang gamtaove.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kagahvetle, vetemun, gamphalai chu gamthip asohtan, khopiho jouse chu Pakai le alungsatna tijat umtah anga chun achimlha gamtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu gamsung pumpi chu kamhel ding; achainahel vang kahisah loulai ding ahi, tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche jeh ahi leiset lunghema, chunga vanho hung thim ding ahiuve; hichehi kaseisa ahijeh-in kalunggot ahin, kisih ponge, nungjong kinung heideh ponge.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sakol chung touhole thal choiho husa-a khopi jamgam diu ahin; hamhing lah-a lutnuva, songpiho chunga kaldiu ahi, khopi tin kidalha-a, chua koimacha cheng lou ding ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangma nakisuhmang phatle ipi nabol ding ham? Ponsandup min kivonin lang, sana jemin kijemin lang, namai jempol jongle chun, mohseh-a kihoisah nahiding ahi, nadongma hon nanah sahmo uva, tha dinga nahol diu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu numei naosonat thoh tobangle, chanei masapen natthoh pet banga Zion chanu aw kajai, amanu natthoh in apengin, akhut ajahdoh-in, ohe tuhin ada kahitai! ati. Ajehchu tolthat ho jeh-in kahinna alhasamtai, ati.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho Jerusalem kholaiho-a suhle tungin lhaijun, tun veuvin lang heuvin, chule munlen ho-a holun, dihtah'a thutan mi khattou namule, keiman amanu ngaidaminge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amahon, Pakai chu ahinge tinama jongleu, jouva kihahsel tahbeh ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pakai, thutah chu navet lhihjing hilou ham? Nangin amaho chu najepjin; amahola alunghem pouve; nangin nachaihel tan, ahinla kisuhdihsah ding anomdeh pouve, amaiju songpi sangin atahsah cheh-un, kile ding anompouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh achu keiman, hitehohi vaicha tahbeh; mingol tahbeh ahiuve kati ahi. Ajehchu amahon Pakai lampi le a-Pathenu thutanna ahepouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keima miloupiho henga chengting, ajah uva thu seijinge; ajehchu amahon Pakai lampi, a-Pathenu thutanlhahna ahethemun, ahinla hiteho hin anamkoljon'u ahehbongun, akikan gomnahou atumtan taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh achu gamlah-a keipibahkai'in athaova, nilhah lang sial'in asuhmang diu, lutnu in akhopihou anga-a, chua kona vahdoh tapou chu asitel jeng ding ahije. Ajehchu asuhkhel nao atamin, anungchon nao apungin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh-achu nangho iti kangaidam diu ham? Nachateovin eidalhaovin, pathen hilouho-ah akihahseluvin; amaho kavahva petnin jonthanhoi abolun, ahon honin notiho ina akikhomun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho jingkah kivahva sakol ho abangun; mitin aheng akom inneipi henga angih lhehlhut-uve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitiho jeh-a hi kavil lou dingu ham? Hitobang nam mitehi kahinnan aphulah lou ding ham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Akulbang hou chunga kaltouvin lang suchimun; achaina helvang hisah hih-un; apal hou lamangun; ajehchu hiho chu Pakaiya ahipouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Israel le Judah insung chu keima dounan akhangse lheh taove, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon Pakai chu ajoulhep mun, amahi ahipoi, ichunguva thilse jong chupontin; chule chemjam ahiloule kellhah jong tohpouhite atiuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule themgaoho chu hui hungsoh uva, asunguva thu umlou ding ahi; hitia chu amaho kibol ding ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun janel ho Pakai Pathen chun hitin aseije, nanghon hitia nasei jeh-un, veuvin, kathuhohi nakam uva mei kahisah-a, hiche mitehi thing hiuva, meichun akahvam dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ven, vo Israel insung, gamlatah-a kona vaipi khat kahinpoh khumding ahi, tin Pakaiyin aseije. Ama chu nam hattah ahin, khangluilai nam, a-pauvu jong nahetlou, chule ipi aseiju jong nahethei lou nam hiding ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Alivatheiju lhankot kihong tobang ahin, amaho mi hattah jeng ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nachanuteu le nachapateo nehding, nalousohle changlhah chu aneh chaidiu, nakelngoi hon, nagancha hon aneh chaijuva, natheichang phung hou anehjou dingu, natahsan tah-u kul kithodet nakhopihou chu chemjam'a asuhchatvai dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijengta jongle, chuche nikhoho-a chu kichaihel loulai dingu nahiuve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Pakai i-Pathen'un ibola hicheho jousehi ichunguva alhunsah ham? tia nasei tengule hung hiti ding ahi, Chuteng amaho chu nadonbutna, nanghon neidalhah uva, nagamsunguva gamchom pathenho nahou banguva chutobanga chu nangho-a hilou gamchom khatna midangho najen diu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichehi Jacob insunga phongdoh unlang, Judah gama phongjalun lang, hitin seijun,
  </para>
  <para style="p">
    <verse number="21" style="v" />Tun hichehi ngaijun, lungthimbei, mit neija mulou; nakhang neija jalou; vo mingol ho,
  </para>
  <para style="p">
    <verse number="22" style="v" />neigin louvu ham? tin Pakaiyin aseije. Agalkai joulouna dinga, twipi gamgi dinga, a-itih-a thupeh-a neldi umsahpa keima anga nakithin loudiu ham? Twinong chu kinuh nuh jongle ajolou ding, kitum lullul jongle achunga galkaijou loulai diu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla hiche mite hin dounale lungchang huhel aneijuvin; dou apanun, achemangji taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amahon alungthim uva, go masale go nunung aphatcha eipeuva, eiho dinga chang-at phat ho eikheh tuppeh uva Pakai i-Pathen'u ama chu tun gingtao hite, tinjong aseidoh pouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nakhan gitlouna houvin hiche hohi aheimanga, chule nachonsetna houvin nangho-a kona thilpha ho atuhtang ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu kamite lah-a, migilouho aumin, thang kam bangin mi achang lhiuvin, thang akamun, mi apojiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bom sung vachaho adimset abangin, a-in jouseu lheplhahna adimsetne, hijeh chun amaho alendoh-un, chule ahaodoh gamtaove.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho athaovun, akiti theijun; chule amahon khang gilouho natoh chu akhokhelun, pabeiho ding agelpouve, ahinla aphatheijun, alhasamho chanding agelpeh pouve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hitiho jeh-a hi kabolgim louding ham? Hitobang nam chungahi kahinna-in phu alah louding ham? tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="30" style="v" />Datmo umtahle tijat umtah thilkhat gamsunga hin akiboltai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Themgaoho jouvin agaovun, themputen anopnop mun vai apouvin, kamiten chutia bol ding adeijuve, ajonale ipi nabol diu hitam?
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Benjamin chate, Jerusalem lailunga kona jamdoh dingin kikhomun lang, Tekoah'ah sumkon mut un chule Beth-haccerem 'ah melchih mei domsangun. Ajehchu sahlama konin thilphaloule suhmangna lentah khat ahung kilang doh-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman Zion chanu chu numei hoitah le nouchet toh kakilo sah-e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kelngoi chingho chu akelngoihon utoh amanu henga hungun tin, amanu doudinga akimvela ponbuh asondiu, amahon ama ama muncheh a avahdiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amanutoh kisatdin kigouvin, kipat un, chule sunin kontouvuhite. Ohe! idau ahitai; ajehchu sun achemangin nilhah lam alep heihoi tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kipat un, janle cheohitin, aleng inpihou gasuseu hite.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu janel Pakaiyin hitin aseije, thingho phuhlhu uvin lang, Jerusalem dou nadin kul khouvin, hichehi hunama gotna kipeding khopi chu ahi. Amanu apumpia kisugenthei ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Twinah in twi asodoh bangin, agitlounaho ahinsodoh jin ahi. Hunamle suhmangna amanu-ah akijadohin, kamasanga hin thohgimnale maha aum jingin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Jerusalem, kichih theijin, ajole nanga konin kahinna kichondoh khantin, chennalou gam akamhel kaso lounadin, gamgoh-in umsah khange.
  </para>
  <para style="p">
    <verse number="9" style="v" />Janel Pakaiyin hitin ati, amahon Israelte amoh-aumsun chu lengpigui khai banga alokhumuva, lengpiga loupan pochaho sunga alelut banga nakhutnu ale kaleh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajahtheina diuva koi henga kaseija kagihsal dingham? Veuvin, akol aseh-un, ajathei pouve, veuvin, Pakai thu chu isahlou vin aneijun, kipanan anei pouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Pakai lunghanna chun kadimsetnin, kakitim timnan kacholtai. Keiman hichehi pama um chate chungle khangdong kikhomho chunga kabuh lhah ding ahi, ajehchu ajipa ajinu geija, tehse le atehkem geija kikaidoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />A-inhou chu alouhou puma midangho kipe ding ahiuve. Ajehchu gamsunga chengho chunga kakhut kalhandoh ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu amaho aneopena pat alenpen geija, amitakip kilosetna lama akipeuvin, chule themgaova pat thempu geijin dihloutah in akimangun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amahon chamna umlou petnin chamna, chamna atiuvin, amite chanu kisuhkhahna chu adamsah bolluve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon thil thet um abol tengule jahcha jiuvem? achutipoi, ajahcha naisai pouve, amaiju jong asanji poi. Hijeh chun amaho alhu ho lah-a lhu-u vintin; keiman amaho kagasuh gim phat tengle amaho sotlhah-a umdiu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai chun hitin aseije, keng lampiho-a dingun lang, veuvin, chule lamluiho chu dongun, hia chun lampha aume, nahinnaova choldona namu dingu ahi. Ahinla amahon, hichea chun chepouving-e, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nachung uva khongah ho jong katundohpeh un, sumkon gin chu ngaijun, atiuve. Ahivangin amahon ngaipou vinge, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun nangho namtin hon ngaijun, chule vo Houkhom ho, alah uva ipi um ahi, heuvin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngaijin, vo leiset, ven, hiche mite chungahi thilphalou, alungputnu ga thilse kalhutkhum ding ahi. Ajehchu amahon kathule kadanthupeh nitlouvin, anotthap jotaove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ipi ngaitona-a Sheba'a kon bego le gamlatah-a kona kolchu lhum kahenga hung kipolut ham? Nagovam thiltoule naganlhai nao tuitah jong chu kei dinga santhei ahitapoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun Pakaiyin hitin aseije, vetan, hiche mite anga kipal lhuh naho kakoipeh ding, achunga chu pate le chapate lhukhom diu, aheng akomle agolhou mangthah diu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai chun hitin aseije, Veuvin, sahlam gama kon mipi ahung kitolin, leiset ningtin ho-a kona namlentah khat tundoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vo Zion chanu, amahon thal le teng apat diu, mi engse le hepinabei ahiuvin, ahusao twipinong abangin, nangma dounan galsat miho bangin sakol chunga atou vun akigoltoh taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aminthanjeu kajataovin, kakhut hou angoilha gamin, hesohnan kadimtauve, chule numei naosonat bangin kanasoh taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Loujaova potdoh hih-un, lampia jong vahle hih-un, ajehchu melmate chemjamle tijatna-in ningtin alotai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Vo kamite chanu, khaodip pon kigah-in, vut kinun, chapa changkhat jeh-a lunghem lheh jeng bangin lunghemin, ajehchu michomgampa chu phulou helouva ichunguva hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangin alampiu nahetna, napatep theina dinga kamite lah-a inchungsang khatle kulpidet khatna katun nahitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho abonchauva lunggim umtah chohchi bol, miseisea vahlea, sum engle thih ahiuvin, abonuva misuboh ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pumlong teni akatan, ngen chu meijin ahaljol lhan, asuhthengna bul chu amoh junlhah jengin ahi, ajehchu migilouho akipaidohpoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amaho chu mihon dangka lahtheilou asahdiu ahi. Ajehchu Pakaiyin amaho chu adeilou ahitai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiya kona Jeremiah henga thu hung lhung chun, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin kotpi phunga dingin lang, hiche thuhi phongjalin chule seijin, nangho Judah mijouse, Pakai hou dinga hiche kotpi phungho sunga lut hon Pakai thu chu ngaijun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Janelho Pakai, Israelte Pathen chun hitin aseije, nalampiule nanatoh hou kisem phatnun, chule keiman hiche munahin chensah unge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai houin, Pakai houin, Tonsot Pakai houin tia jouthu seiho chu tahsan hih-un;
  </para>
  <para style="p">
    <verse number="5" style="v" />ajehchu nanghon nalampiu chule nathil bolhou chu apuma nakisem phatnuva, mikhatle aheng akom kah-a thudih nasodoh uva,
  </para>
  <para style="p">
    <verse number="6" style="v" />kholjin mi, pabeiho leh meithaiho sugenthei louva, hiche munahi monabeiho thisan nasodauva, chule nasuse dingu pathen dangho jong najoulhepmuva ahile,
  </para>
  <para style="p">
    <verse number="7" style="v" />chutengle keiman napateu kanapeh nagam hiche munahi atonsot atonsotna kachensah ding nahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Veuvin, phatchomna bei thujouho chu natahsanun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon guchat, toltha, jouva kihahsel, Baal houna-a gimnamtui hala, nahetlouvu pathen dangho najuijuva,
  </para>
  <para style="p">
    <verse number="10" style="v" />chule naheng uva kamina kivo hiche in'a kamasanga nadin uva, chule thet umhohi bol dinga eikipedoh uva ahitai, nati dingu ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />kamina kivo hiche inhi nangho mitmu-a michomho kokhuh hitam? Veuvin, hiti chun kamubepme, tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla tun nangho kamina kaphudoh masahna Shiloh-a kaumna mun'a chun cheovin, chule kami Israelte gitlou jeh-a chua ipi kanabolem gaveovin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Pakaiyin aseije, nanghon hitobang jousehi naboltah jeh-un, chule matah-a katho-a kanaseipeh vanguva nangaitahlou jeh-un, chule kakou vang uva neina donbut tahlou jeh-un,
  </para>
  <para style="p">
    <verse number="14" style="v" />hijeh achu nanghole napu napateu kanapehna mun, nanghon nana tahsanu, kamina kivo hiche in'a hi Shiloh a kabol tobang chu kabol ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman nasopiteu Ephraim chilhah apumpia kana paidoh banga nangho jong kamitmu-a kona kapaidoh ding nahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun, hiche mite dingin taohih-in, amaho dingin kho samhih-in, taojong taohih-in, kahenga jong thumpeh hih-in, ajehchu kajahpeh louding nahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon Judah khopiho sungle Jerusalem lamlen ho-a ipi abolu chu mulou nahiuvem?
  </para>
  <para style="p">
    <verse number="18" style="v" />Chaten thing achomun, paten mei atih-un, numei hon changbong ameh-un van lengnu din changlhah asem gouve, chule keima phin lunghan theinadin pathen dangho din donthei thilto alheilha jiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahon keima eiphin lunghanu ham? Amaho maiso kisuhmona ding bepma amahole amaho kiphin lunghangu hilouham? tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun tonsot Pakai Pathen'in hitin aseije, veuvin, kalunghana hiche mun chunga, mi chunga, sa chunga, thingphung ho leiset gaho chunga kabuh lhah ding, hichun akah-a kasuhmit tahlou ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israelte Pathen janel Pakaiyin hitin aseije, naganlhai naova govam thiltoho chu kikoijun lang apheho chu neuvin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu napateu Egypt'a kona kipuidoh nichun govam thilto le ganlhai thudol amaho jah-a kanaseipon, thupeh jong kananeipon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla hichehi amaho thu kanapen, ka aw ngaijun chutile keima na Pathen'u hing ting, nangho kamite nahi dingu ahi. Nangho thu kapeh jouse-a chun chonun, chutile nangho dinga phathei ding ahi, katin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla angai hih-un, anau asungpouve, alung gilou ngaitonaole alunggelun achon jouvin, machon louvin anungchon jotaove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Napateu Egypt gama kona ahung potdoh uva pat tuni geihin kasoh themgao jouse naheng uva, kahinsolin, jingkah matah-in athouvun kasolen,
  </para>
  <para style="p">
    <verse number="26" style="v" />Hinla amahon kathu angai hih-un, anau jong asungpouve, angei apukonun, alouchal uvin, apateu sangin asejouvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun, nangin ajah uva thu jousehi seijin natin, na ngaipeh loudiu, Nangin amaho kouvin natin, amahon nadonbut louding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla nangin ajah uva hiti ahi nasei ding ahi, hiche nam mitehi Pakai a-Pathen aw ngailou, hilna jong sangdeh lou nam ahiuve, thutah chu amanghelin, akamuva konin pailhah helin aumtai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Vo Jerusalem, nasam kitanin lang, munsang ho-a kapmin, ajehchu Pakaiyin alunghana khang mitehi adeitapon, adalhatai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajehchu Judah chaten kamitmun thilphalou aboluve, tin Pakaiyin aseije. Kamin kivona insung suhbohna dingin, athet umtah hou chu apolut taove.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule keiman kanathupeh louhel, kalung sunga jong umlouhel, achapateule achanuteu meija gona dingin Hinnom chapa phaicham, Topheth munsang ho asadoh taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun Tonsot Pakaiyin, veuvin hiche munchu Tophet kiti talou ding, Hinnom chapa phaicham jong kitikitlouva, tolthana phaicham kiti johna ding nikho ahung lhunge, Ajehchu mun abeihel kahse-a Topheth'a kivuigam ding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiche mite thilongho chu chungleng vachaho, tolla gamsaho an hiding ahi. Chule koimachan amaho anomang lou ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chutahle Judah khopiho-a chule Jerusalem lamlen ho-a thanopna aw chule kipana aw, moulang le Mounu aw beisoh ding ahi. Ajehchu gamsung chu kamhel ding ahitai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche phatchule amahon Judah te lengho, leng chapateho, thempuho, themgaoho chule Jerusalem'a chengho guho chu abuikhuh uva kona ahinpoh doh dingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amaho chu nisa le lhathah chule vanmi janel jouse, amahon anangailutnu, anajenu, anajuijuva, anaholu chule anahouvu ho angsunga ahinthejah dingu ahi. Amaho kigomlou ding, kivuilou ding ahiuve, chule leiset chunga eh-a umding ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keiman kanodohna mun jouse-a hiche insung phalou sunga umden amohho jouse chun hin sanga thina akilhenjoh dingu ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche kalvalchun, nangman amaho jah-a nasei ding ahi, Pakaiyin hitin aseije, amaho lhuva thoudoh talou diu ham? Aman aheimanguva, hung kinungle lou dingu hitam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuti ahile, hiche Jerusalem mitehi ijeh-a tanglouhel nungchon na-a nungchon uva ham? Thujou atuhchah-un, hung kinungle ding anompouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman kangaijin kajai, ahinla thudih aseipouve. Ipi kabol beh em? atiuvin agitlou naova kona kisih-a koima aumpoi. Sakol galmuna alhailut jeng bangin, mitin ama ama lampia akiheitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahi, van'a leng twiva injong ama phat kitepsa akihetnin, vakhu, vakengsang chule vasilih hon amaho hungna phat akihet uve. Ahivangin, kamiten Pakai thupi tanlhahna dinghi ahepha pouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon kachinge, Pakai dan chutoh kaum khomnai, iti natiu ham? Veuvin tahbeh-in, aman hichehi mohseh-a abol ahin, danthupeh sunho lekhamol chu moh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Michingho chu ajahchauvin, alungthoijun, akiman taove, veuvin, amahon Pakai thu chu athetbolun chule amaho-a ipi chihna umem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun a-inneipi teo midangho kapeh-a chule alouhou chu ahinlo dinghou kapeh ding ahi. Ajehchu amitakip aneopena pat alenpen geijin kilosetna-a akipeuvin, themgaova pat thempu gei sanin jou aboluve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu amahon kamite chanu kisuhkhahna chu adamsah boluvin, chamna umlou helin, chamna, chamna, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thet umtah thil aboluva chu jahchabeh uvem? Achutipoi, ajahchahih beh uve, amaiju jong asan sinpoi. Hijeh chun alhuho lah-a lhuhtha diu, gotna akipeh phatnule kipailha ding ahiuve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman amaho kasuhmang tei ding, lengpiguiho-a aga umlou ding, theichang phungin jong ga neilouva, ado pulding, amaho kapeh thilho chu amaho-a kona kitol mang ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ibola itou thim beh-u ham? Hung kikhomun, kul kikhodet khopiho-a lutnu hite. Ajehchu Pakai douna-a ichonset jeh uva Pakai i-Pathen'un thipchetna eikoijuva, donding thinkha twi eipeh-u ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lungmona kaholun, ahin thilpha ahungpoi, chule damtheina phat kaholun, veuvin gentheina bou ahi!
  </para>
  <para style="p">
    <verse number="16" style="v" />Asakolho nahkhon gin Dan'a pat akijan, asepai hat ho kholhah ginin gam pumpi akihottai. Ajehchu amaho ahungun, gamsungle asunga umho jouse, chule khopihole asunga chengho jouse abahgamuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu veuvin, keiman nalah uva, gulho chule suhngoi theilou gulsumho kahin sollutna amahon nachuh dingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lungdona-a kona kilhamon kagot teng kalungsung alhoplha jitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Veuvin, gamlatah-a chengho jeh-a kamite chanu ka awgin khu, Pakai chu Zion'a umlouva hitam? Alengpa asunga umlou hitam? Amahon ipijeh-a semthu milimhole mohthil kidangho-a eiphin lunghangu ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Chang-at phat akichaijin, nipi phatla akichaitan, eihola huhhingin i-um tapouve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kamite chanu kimavo jeh-in mavon kaumin kadup lhatai, lungdona-in eikolchah-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Gilead gamsunga damna dinga, nuding thingnai lou umlou hitam? Achutile ipijeh-a kamite chanu chu suhdam louva uma hitam?
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ohe, kamite chanu kithajeh hin sunle jana kaka theina din kalu twijeng hihen lang chule kamit tenihi mitlhi luipi sohjeng tavele kati!
  </para>
  <para style="p">
    <verse number="2" style="v" />Ohe, kamite dalha-a, amaho-a kon kapotdoh theina dinga gamthipma chele vahle ho gebuh khat kanei hitavele! ajehchu abonchauva mijong ngen, misumang kisukhom bou ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amahon jou seinan athalpiu bangin aleiju amangun, ahinla leiset chunga thutah dingin ahangsan pouve. Ajehchu amahon aphalouva konin aphalou asodohun, keima eiheta pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mitin aheng akoma chingtheihen, asopi tahsan hih hen, ajehchu sopi takipmin ahinson manghel ding, henglekom chu misumin se-a vahle ding ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho mitinin ahenglekom cheh alheplhah diu, thutah aseilou dingu ahi; Aleiju jou seije ahilun, dihloutah bolna-in akisuchol uve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nachenna chu lheplhahna lah ahin; lheplhahna jeh-in keima eihetnom pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun janelho Pakaiyin hitin aseije, veuvin, keiman amaho junlhahsah ingting, kapatep ding ahi, ajehchu kamite chanu chu iba kalo ding ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Aleiju thalchang kikapdoh abangin, hichun lheplhahna thu aseije. Khatnin aheng akom jah-a akamin chamna thu aseijin, hinla alungsungin achanglhi keovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitiho jeh ahi keiman amaho gotna pelouva kakoi dingham? Hitobang namho chungahi hitia hi kahinna-in phu alahlou ding ham? tin Pakai jin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Molsangho dinga kaka-a kamao ding, gamthipma umho dinga kalunghem ding ahi. Ajehchu amaho akavamtan, koimachan ajotpai thei tapon, ganchaho hamgin jong akijatapoi. Chungleng vachate le gamsaho ajamun, achemang taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman Jerusalem chu ingem jeng kasoa, dragon kokhuh-a kasem ding, chule Judah khopiho chu acheng beihela kakam helsah ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche hekhenthem thei dinga miching koiham? Hiche gam chu amanthaija, gamthip banga akahvama, koimachan ajotpai thei louding ahi, tia phongdoh dinga Pakai kamin aseinapa chu koiham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Pakaiyin aseije, ajehchu amahon amasanguva kakoipeh kadan thupeh chu adon tapouve, chule ka aw angaipouve, hia chun chonjong achonpouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho lungsuhto-a bou achonjo taove, apateuvin anahilu, Baal houna nung ajuijo taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun janel Pakai, Israel Pathen'in hitin aseitai! Veovin keiman amaho, hiche miho tahhi thinglungin vah ingting, thinkha twi kadonsah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman amaho chu, apateule amahon anahetkhah louvu, Pathen helouho lah-a kathecheh ding, chule amaho kasuh manghel kahse-a anungu chemjam kajuisah ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitihin janel Pakai chun aseije, nanghon ngaitouvin, ahung theina dingun numei lunghemho chu kouvun lang, ahung theina dingun numei dohathuh ho gakou sah-un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaho chu kinouhen lang, chule eiho dingin himsao hen, chutiachu imitnuva kon mitlhi alonlhah-a, imit nel uva kona twiho akikhodoh jeng nadingin,
  </para>
  <para style="p">
    <verse number="19" style="v" />ajehchu Zion'a konin maon'a aw chu akijan, suhmanga iti i-umu hitam? Igamu idalhah uva ichendetna houvin einotthap jeh-un, ikisumo lheh taove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla, vo numei ho, Pakai aw chu ngaijun, nanakhang uva akam thucheng chu lutsah-un, chule nachanuteu chu maoje, chule amitakipmin aheng akomho lunghemje hilun.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ijeh-inem itile chate polama umhole khangdong lamlen ho-a umho sumang dingin, thina chu bangkot ho-ah ahungkal touvin chule ileng inpihouva ahung luttan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Seijin, Pakaiyin hitin aseije, Mihem thilongho chu gam onga eh tobanga pul lhadiu, chule chang atpa nunga khutdim khat chang kidalha banga koiman amaho aga chomkhom lou ding ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakaiyin hitin aseije, michingho chu achihnauva, mihat ho chu ahatnauva, chule mihaoho chu ahaonauva kithang-at daohen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla akithang-at michu hichea hin kithang at-uhen, keimahi leiset chunga ngailut lungsetna, thutanlhahna, chule chonphatna a vaihom Pakai chu kahi ti hehen chule hethemhen, ajehchu hitiho ahin keima kakipahjie, tin Pakaiyin seije.
  </para>
  <para style="p">
    <verse number="25" style="v" />Veovin Pakaiyin hitin aseije, keiman cheptanho jouse chu cheptan louho toh kagimbol thading nikho ahung lhunge!
  </para>
  <para style="p">
    <verse number="26" style="v" />Egypt, Judah, Edom, Ammon chate, Moab chule gam ningchong penaho, gamthipma chengho jouse chunga, ajehchu hiche nam miho jousehi cheptanlou loi chu ahiuvin chule Israel insung jouse jong lungsunga cheptanlou ahiuve.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel insung naheng uva Pakai thusei chu ngaijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hitihin Pakaiyin aseije, Pathen hephalouho lamlhah chu kihil hih-un, van melchihna ho jeh-in jong lungthoi hih-un, ajehchu Pathen helouho hitiho ahin alungthoi jiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu miho puchon pachon chu moh ahi. Ijeh-inem itile khatnin gammanga konin thing aphuh-in, hichu heicha-a natongpa khutsoh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon hichu dangkale sanan ajemuvin, akilonlou nadin thihkille seh-in amandetnuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho lusu thingphung bangin akitung jangpetnun, ahinla apaothei pouve. Achetheilou jeh uva poh ngaitei ahiuve. Amaho ginghih uvin, amahon thilse abolthei pouve, thilpha bolna dingjong amaho-a aumpoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Pakai, nangma tobangtah koimacha aumpoi, nangma loupitah nahin, naminhi thanei na-a loupi ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo namtin vaipi lengpa, nangma kichalou ding koi ham? Ajehchu nangma-a hichu uma ahin, ajehchu nampiho michingte jouse lahle alenggamhou jouse-a, nangma tobang khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho lungselle angol ahiuvin, lim semthu ahouvu jong chu manthah na lhongpi ahibouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tarshish'a konin dangka kikhen pheng chule Uphaz'a konin sana ahinpouvin, khutthemho khutsohle thihkheng themho khutsohho, adumle asandup akivonun, aboncha chu doha thuh khutthemho khutsoh ngen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai vang chu Pathen dihtah ahin, ama hingjing Pathen le tonsot leng ahi. Alunghana-a leiset kihot ding! athangtomna chu namtin vaipin anan joulou diu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiti ahi nanghon ajah uva, vanle lei sem hilou pathenho, amahotah chu leisetna konle hiche vanho noija konahi mangthah ding ahiuve, natidiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman athaneina-in leiset asemin, achihna-in vannoi atungdoh-in, ahetthem na-in vanho ajandoh-e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw aso tengle, van'a twi tamtah aging lullul jin, kolmonga pat twimei ajamtousah jin, kolphele gotwi asemin, agou boma konin hui ahin nundoh sah jin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mitinhi ahetna-a lungsel ngen ahin, asemdoh takip milim kilhah tho-a akisudongun ahi. Ajehchu amilim kilhahtho hochu jouthubuh ahin, asunguva haitheina aumpoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amaho pannabei le natoh dihlou ahiuvin, gotna akipeh tengule mangthah ding ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jacob chan chu hicheho bangchu ahipoi; ajehchu Ama thil jouse sempa hin; Israel hi agoulo nam tenggol ahin, amin chu janel Pakai ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo kulpi sunga chengho, gamsunga konin nakiveina thilho chom khomin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu Pakaiyin hitin aseije, vetan, agamsunga chengho chu khatveihi hinpaidoh inting, amahon chutia amutheina diuva amaho kasuhgenthei ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kakisuh natna jeh-in ada kahitai, kamaha put hi analheh jenge, ahinla keiman, hichehi thohgimna tahbeh ahin, chule kathoh teiding ahi kati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahoubuh asetan chule kakhao jouse atantai. Keija konin kachate achedoh-un, aumtapouve chule kahoubuh songdoh dingle kapondal ho tungdoh ding koima aumtapoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu kelgnoi chingho la alungsel ngen ahiuvin, Pakai hola aumpouve. Hijeh-a chu lolhing loudiu, akelngoiteu jouse chehchao ding ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Veuvin, Judah khopiho kamhelsah dingle, Dragon ho kokhuh sosah dingin, sahlam gama konin thuthang le husa nasatah ahunge.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vo Pakai mihem chondanhi ama-a um ahipoi ti kahetai, akalson hil dinga chu mihem sunga um ahipoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aw Pakai imacha hilou munna neilhut louna dingin, nalunghanna-a hilouvin nathu tan najoh-in neisu dih-in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangma hephalouho chungle, namina taolou insungho chunga nalungsatna bunglha tan, ajehchu amahon Jacob anejouvun, abahgamun, asumangun, chule achenna mun kamhelin alhauve.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jeremiah henga Pakai thu hunglhung chun aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />hiche thulhun thuhi ngaijun lang, Judah mitele Jerusalem'a chengho henga seipeh-un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangman amaho jah-a seijin, Israel Pathen Pakai chun hitin aseije, hiche thulhun thuho ngailoupa chu sapset changhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichu napateu Egypt gamma thih meilhuma kona kahin puidoh ni-a kana thupeh a kanasei, Ka aw ngaijun lang chule kathupeh ho dungjuijin bollun. Hitia chu nangho kamite nahiuva, chule keima na Pathen'u kahi ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutia chu napateu henga, khoijule bongnoi lonna gamkhat pehdinga tunia bangahi kakitepma kahahselna chu katohdoh thei ding ahi, ati. Chuin keiman, hihen, Pakai tin kadonbutne.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Pakaiyin kahengah aseije, Judah khopihole Jerusalem khopi lamlen ho-a hiche thuho hi phongjalun lang, hiche thulhun thuho hi ngaijunlang, boluvin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Egypt gama kona amaho kanapuidoh nikhon napateu henga hatah-in kana kiphin in, tuni chan geijin jong, matah-a kipatdoh pumin kagihsal lin, ka-aw ngaijun katijingin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla angaipouvin, anau jong sunglouvin, amitakip alungaito gitlouna-a achonun, hijeh chun abol dinguva kana thupeh-a, ahivanga ana bolou-u, hiche thulhuna thucheng ho jouse hi achunguva kahin lhunsah ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin kajah-a, Judah mitele Jerusalem'a cheng mite lah-a thilguh kigong akimudoh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Apu apateu, kathu ngainomlouho khangitlouna lama akilehei gamun, pathen dangho jen dingin anungu ajuijun, Israel insungle Judah insungin, apateutoh kanasem thulhun chu asukeh taove, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Pakaiyin hitin aseije, veuvin, ahoidoh theilou hel nadiu thilse achunguva kalhunsah-a, kahenga hungpeng jongleu kangaipeh louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuteng Judah khopihole Jerusalem'a chengho chu, gimnamtui ahalnau pathenho henga chun cheovintin, ahenguva pengdiu, hijongle alungdon petnuva hiho chun ahuhdoh louhel diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu vo Judah, nakhopihou jat dung juijin pathen naneijun, Jerusalem khosung lamlen jat dung juijin jachat umtah Baal henga gimnamtui halna maicham natung doh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun hiche mite dinghin taohih-in, kanale thumna jong bolhih-in, ajehchu alungkham jeh uva kahenga atao tengu jongle kangaipeh louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kangainun thil thet um tahtah bolpumle, nanga kona tahsa theng achemang munasasa a ka-insunga ipi abol nahlai dingham? Nangin aphalou nabol tengle nakipah jilheh-e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakaiyin namin chu Olive thingphung hing, ga hoitahle phatah tin nanaminvon, mipi hugin thong chu achunga meijin akongin, ahin abahho chu abong gamtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Kei phinset na-a lunghansahna dia Baal henga gimnamtui hal Israel insung le Judah insung setna jeh'in, Janel Pakai nangma phutpa chun, nachunga thilgilou ahinbol ding aphongdoh tai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pakaiyin eihetsah-in, kahetan, chuphatnin nangin athilbolu neimusah tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla keima kelngoinou, ahiloule bongchal tha dinga kikai bangbou kahin, amin kihetkit louhel nadin mihing gama konin ama chu sumangu hitin, thingphung chu aga pumin subeiju hite, tia kachunga adoha bolu chu kanahe hihhelin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla Vo janel Pakai dihtah-a thutanpa, lungsung gille lungthim sung patep jipa, achunguva naphulahna chu neimusah tan, ajehchu kachung chang thu nangma-a kaphondoh ji ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kakhut uva nalou louna dingin Pakai minin gao thu seitahih-in tia kahin na suhmang dinga chang lhijing Anathoth mite chungchanga Pakaiyin hitin aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun janel Pakai chun hitin aseije, vetan, amaho chu talen pengting, gollhangho chu chemjam'a louvuntin achapateule achanuteu chu kela thidiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amaho amoh himhim umpou vinte. Ajehchu Anathoth mite chunga thilse kalhunsah ding, gotna achan kum-u jong hiding ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nahenga kaphun teng jongle vo Pakai, nangma chonphatah nahin, hijongle nathutan dol neiseisah tadin, ipi dinga migiloute lamlhah lolhinga? hatah'a kitahlouhon nom asahsoh keiju ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma phu ahiuvin, henge, ajungkho gam taove, akeh-un, henge, ga asodoh taove. Amahoto naichan naumin, alung giluva konin nagamlan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla Vo Pakai keima neihetan, neimutan, chule nangma lama kalung napatep ahitai. Amaho chu tha dinga kigo kelngoi bangin kaidoh'in lang, athana ding nikho gotpeh tan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chua chengho gitlouna jeh-a gamsung chu itihchan lunghema loujao tina hampaho golha dingham? Aman kaki chainao amulou ding ahi ati jeh-un, gamsahole vachate amangthah gamtaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma kenga lhai miho toh nalhaikhoma amahon nachol sah-u leh, sakolto iti naki lhaitet thei ding ham? Nangman natahsan, Chamna gama bon amahon nachol sah-u leh, achutile Jordan kinonga chun iti tan natem?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu nasopihole napa insung mite tah-in jong, kitahloutah-in nabol uve; henge, amahon nanungsanga mipi akouvuve. Amahon nahenga thungei tah seijongleu tahsan hih-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka-inle kagoulo kadalhatai, kahinna ka-itchah kangaitah chu amanu melmate khutna kapedohtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei dinga kagoulo chu gammang sunga keipi tobang ahin, keima dounan apengdoh-in, hijeh-a chu kahot ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kagoulohi vacha pol litlet tobang ahin, akimvela um vachaten ama adouvun ahi, hunguvin, gama gamsa jouse hung kikhomun lang anegamdin hungtauvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kelngoiching tamtah-in kalengpilei asumangun, kachan achotphauvin, kachan deitah chu gamthip gohkeo asosah taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon hiche akamhel sah-un, hichu kahenga alunghemin, agam pumpi agohkeo asotaove, ahinla koimachan anahsah poi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gamthip lhonlhung munsang jouse-a thilsuseho ahunglhung taove. Gammong langkhatna pat gammong langkhat gei Pakai chemjamin bahgam intin, mi koimachan chamna aneilou ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon suhlouchang atheuvin, hijongle lingho bou a-atdiu, amahole amaho akisucholun, ahinla phachom ponte, Pakai lungsat nasatah jeh-a chu, nalhosoh-u ajachatpi diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kami Israelte losah dinga kagotsa gou tongkha-a, ka-inheng gilouho jouse douna-in Pakai chun hitin aseije, vetan, keiman agamuva konle Judah insung mite lah-a kona kalolhah ding ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hung hiti ding ahi, amaho kalolhah joutengle kahung kile-a, amaho kalungsetna, amitakip agoulo nale agamcheh-a kalepui ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hiti ding ahi, Baal henga kamite kihahselje ahil banguva, ahingjinga Pakai kamina, kihahselna dinga kamite chondan gunchu tah-a akijiluva ahile, chuteng amaho kamite lah-a kisadoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla amahon kathu angailou vangule, hiche nam mite chu kabodoh-a, kasuh manghel ding ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin kahenga, tupatpon konggah gakilah-in lang, twija sukot louvin, nakonga kigah-in, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hitichun Pakai thu dungjuijin konggah khat kaga kilah-in, kakonga kaki gah-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin anivei channan Pakai thu chu kahenga ahung lhungin aseije,
  </para>
  <para style="p">
    <verse number="4" style="v" />Nagalah nakonga um konggah chu choijin lang, kipat in, Euphrates lama chenlang, chukoma songpi kosung khatna gaselin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Pakaiyin thu eipeh bangin kachen, Euphrates koma kagaseltai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ni tamtah jouvin Pakaiyin kajah-a, kipat in Euphrates lama chenlang chua konin, chukoma sel dinga thu kanapeh konggah chu hinchoijin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Euphrates lama kachen kalaidoh-in, kaselna mun'a kon chun konggah chu kaladoh-in, chule vetan, konggah chu anangot tan, imachan aphachom tapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakai thu kahenga ahung lhungin aseije,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai chun, Judah hoithonale Jerusalem hoithona chu hiti ahi kasuhset ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kathu ngailouva alung ngaito to-a chonna, pathen dangho jenna, chule houva, hiche nam phaloutehi imacha phachom lou konggah tobang bepbou chu ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu konggah mikonga abechah banga Israel insung pumpile Judah insung pumpi chu keima-a kabechahsah ahi, tin Pakaiyin aseije, hitia chu amaho kei dinga kamitele kaminthana, kahoinale kaloupina dinga kasem ahin, ahinla amahon angainom pouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu ajah uva hiche thuhi naseija, Israelte Pakai Pathen'in hai jouse chu lengpitwi sung dimun, ati, nati ding ahi. Chuteng amahon najah-a, hai jouse lengpitwi dim dinghi kahetchen lou uham? atidiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuteng nangin ajah uva, Pakai jin hitin aseije, vetan, hiche gama chengho jouse David laltouna-a tou lengho, thempuho, themgaoho, chule Jerusalem'a chengho jouse chu khamna-a kadip ding ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule keiman amaho khatle khat, pate leh chapate tahjong kahin tato ding, kalainat louding, kakhen louding, ahiloule kahepi louhel ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngaijun, nanau sungun, kithahatsah hih-un, ajehchu Pakaiyin thu aseitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman kho ajinsah-a, chule molchung muthim lah-a nakipal lhuh masangin, Pakai na Pathen chu loupina peuvin, chule vah nangaichat laitah-un, thina le-lim asosah-in, muthim lhangkhal in aseme.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla hichu nangailou diule, nahoitho jeh uva kahinna sunthipma kap kapmin tin, Pakai kelngoite gal hinga kikaimang jeh-a kamit teni jong mitlhin achupding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lengpa le Lengnu jah-a, kineosah lhonin, toulha lhonin, ajehchu nathupina lhonle naloupina lallukhuh lhon jengjong lhamang ding ahitai, tin aseije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lhanggam khopi lenho kikhah chah gamintin, koimachan ahontheilou ding, Judah aboncha gal hinga kikaimanga, apumpiuva gal hinga kikaimang diu ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dahdoh-un lang sahlama kona hungho khu veuvin, nangma kipe kelngoihon, nakelngoi hon hoitah ho chu hoi hitam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman nangma na-engbol teng ipi nasei ding ham? Ajehchu nangin gal lamkai dia nanahil chu, nachunga vaipon apangtai. Numei naosonat banga na nasah louding ham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangin nalunga hiche thilho ibola kachunga hung lhung ham? tia naseile, hichehi nangma nakhansetna alet behset jeh ahin, hijeh-a chu nanih kihoh-a, nakhotal doh-a ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ethiopia min avun akheltheija ahiloule lutnun ajem akhel theijem? Achutile angaina-a thilse boljing nanghon jong thilpha nabol thei diu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun gamthipma huijin pol amutcheh banga chu kathecheh diu nahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichehi keija kona nakite-a navang chanchu ahi, tin Pakaiyin aseije, ajehchu nangin neisumilin, joubulom joh natahsan tai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh-a chu najachat kilahna dinga, namai changa nanih kahodohpeh ding nahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Loujao lhangchung dunga najon thanhoina, nanahkhon, nahuhna awgin, na noti chon naho, nathet um thilbolho chu kamutai. Ohe Jerusalem, nada ahi, naki suhtheng louding ham? Itih tahle ahitadem?
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Twihah thudola Pakai thu chu Jeremiah henga ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah alunghemin, akotpihou chu anguije, amaho tolla aduplha taovin, Jerusalem khopi ka ogin akitol toutai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amilal houvin asohteu twikhaijin asolun, luikhuh-a ahungun, twi amupouve. Atuibelu keo pumin akileuvin, amaho jahchan akisujumuvin ponlu akikhuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Leija go juhlou jeh-a, leiset akhit jeh-in, loukaiho ajahchauvin ponlu akikhuh taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Henge, sajuh pin jong hamlah-a nou aneijin, hamhing umlou jeh-in adalhatai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gam sanganho munsang ho-a adingun, dragonho bangin hui ahoplut helhol-un, hamhing umlou jeh-in amitnu athabei gamtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai kakhangitlou naovin eilansan jongleu, namin jal-in hichu boljengin, ajehchu kakinungtol nao atamin, nangma dounan kachonse taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Israel kinepna pa, lungkham laija huhhingpu, ibola gamsungahi kholjin banga jankhat gehdia kiheimang lamjot nabah ding hitam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ibola milungthoile pasal hat kihuh hing theilou bang bepma naum ding ham? Vo Pakai kalah uva naum nalaijin, naminin katao jiuve, neidalha hih-un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakaiyin hiche mite thudol hitin aseije, amahon vavei ding adeijun, akengu atuhtang pouvin, hijeh chun Pakai jin amaho asang tapouve. Tu-a aman akhang gitlounao ageldoh-a, asetnao jeh-a gotna apehding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin kahenga, hiche mite phattheina dingin taopeh hih-in,
  </para>
  <para style="p">
    <verse number="12" style="v" />an ngola apennau kangaipeh louding, govam thilto atotengu jongle kasanpeh louding, chemjamle kela chule hise-a kasuhmang johdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin keiman kaseije, Pakai Pathen vetan, themgaoho chun ahenguva, chemjam nato loudiu, keljong nahet loudiu, chamna mong mong kapehjoh ding nahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuphatnin Pakaiyin kahenga, themgaoho chu kamina jouva ahiuve, keiman kasolpon, thujong kapepoi, houjong kakihoupi poi. Naheng uva thilmu dihloule, gaothu chule mohthu pannabei aseijuva, alungu alheplhah-u ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun hiche gama hin chemjamle kellhah chuponte tia, keiman kasol louva gaothusei themgaoho chungchang chu chemjamle kellhah in hiche themgaoho chu asuhmang ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule agao thuseinao miho chu kel lhahle chemjam jeh-a, Jerusalem khosung lamlena kipaidoh diu, amaho ajiteu ahiloule achapateule achanuteu vuiding koimacha aneilou diu ahi. Ajehchu agitlounau achunguva kabuh lhah ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh-a chu nangin hiche thuhi ajah uva nasei ding ahi: sunle jan-in kamitlhi longhen lang, kanghih behhen. Ajehchu kamite chanu nungah theng chun mavona hoisetah, manthah na nasatah athohtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keima loujaova kagapot dohle, chemjam'a kithat ho pikhu vetan! chuin khopi sunga kagalut le kel lhah naho pikhu vetan! henge, themgaoho le thempuho chu ahetlou nau gama avah leuve, nati ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Judah chu napaidoh hel hitam? Zion chu nahinnan akidah hitam? Kadamna diu umlou hela ibola neivoh-u hitam? Chamna kaholun apha imacha aumpoi, damna ding phat chu, vetan lungkhamna bep ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vo Pakai kagitlou naole kapateu khangitlou naho kakihet taove. Ajehchu nangma douna-in kachonse taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Namin jal-in neithet bol hih-un, naloupina laltouna chu jaboldan umhih hen, keihotoh nasem nathulhun chu hejingin lang, sukeh hih-in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chidang namdang pannabei ho lah-a, go juhsah theija umam? ahiloule van'in gohong ajuhsah theijem? Vo Pakai ka Pathen ama chu nangma nahilou ham? Hijeh-a chu nangma kanga diu ahi. Ajehchu hicheho jouse nangma sem ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuphatnin Pakaiyin kahenga, Mosi le Samuel ka-anga dinglhon jongle kalunghi hiche mite lama umthei ponte. Kamitmu-a konin paidoh-un lang chemang taohen, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hung hiti ding ahi, amahon nahenga hoilama ipotdoh diuham? atiuva ahile, nangman amaho chu naseipeh ding ahi, Pakaiyin hitin aseije, athidingho chu thina-a, chemjam'a loudingho chu chemjam'a, kelhah-a thiding hochu kelhah-a, sohchang dingho chu sohchan na-a,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule achunguva thil jatli, athana diu chemjam, abottel diu uichate, abahgam diule asumang dingu chungleng vachate le gamsaho chu kasol ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keiman Judah leng Hezekiah chapa Manasseh in Jerusalem'a athilbol jeh-a, leiset lenggam jouse-a amaho kachao lesah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Vo Jerusalem, koijin nangma nakhotoa, koijin nalhasetpi-a, ahiloule iti nahi hitam tia dongle dinga koi chedohle dingham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai chun, nangin neidalhan, nanung chontai, hijeh-a chu nachunga kakhut kajah-a, kasuhmang ding nahi, kakitimtim jong kakhoptai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahohi gamsung kotpiho-a changjapmin japming ting, achonnau akhel loujeh uva, chate-a kona kakhena, kamite kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Twipi lah-a neldi sanga tamin ameithaihou apungin, sunchang laijin gollhangho nute chunga misumang kapuilut khumin, chucheho leh khopi chunga chun photlotnin tijatna kachuhsah jin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha sagi hingnun, alhagao alhan, sun ahipetnin nisa alhumin, ajah achan akisudongtai. Amoh umnalai ho chu amelmateu chemjam'a kapehdoh ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Leiset pumpi-a kinahnale kikalsetna-a neina hinhi, Ohe heno, kadatave! sumthoila kalha khapon, minjongla sumthoi eilahsah khapon, ahinla amitakipmin eigaosap uve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakaiyin, tahbeh-a nunga naphatna ding hintin, tahbeh-a melmaten phat hahsat laile genthei laija nabolphatna diu ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thih-in sahlam thihle thihtah chu asuhboh dingham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Nachonsetna jouse jeh-a, naneile nagouho, nagam pumpi sung jouse geija, gallaija thil kichom khom banga manbeija kapehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nahetlou gama namelmate toh kachesah ding nahi, ajehchu kalunghana mei akongin, hichun nakahvam ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vo Pakai nangin nahenai, neigel doh-in lang neivilin, eibolgimho phu neilahpeh-in, nathahatna-a neipuimang hih-in, nangma jala houset kato neihet peh-in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nathu kamun, keiman kanetai, nathu chu keidin kipanale lungsung thanopna ahi. Ajehchu vo janel Pakai Pathen, keima namina kikou kahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Minelpehho kikhopna-a katoupon, pahjong kakipah poi; nakhut jeh-in kachangin katouve, ajehchu nalung hilouna-in neina dipsettan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ibola kanat kumkho sotna, katina damthei louva damding nomlou ham? Nangma kei dinga mijoule akangthei twi tobang nahi ding hitam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Pakaiyin hitin aseije, nahung kile-a ahileh keiman puikit ningting, kamasanga nadin ding ahi. Thilse-a kona thil lutah nasodoh-a ahile, kakam sung bang ding nahi. Amaho nahenga hungkileu hen, nangvang amaho henga kile hih-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule keiman nangma hiche mite dinga sum-eng kulbang kigena kasema, amahon nakisatpi diu ahi. Ajehchu keima nahuhhing dingle nahuhdoh dinga um kahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule keiman migiloute khutna kona kahuh doh-a, tijat umtahho khutna kona kalhatdoh ding nahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai thu chu kahenga ahunglhung kitnin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin hiche munnahi ji naneilou ding, chapate chanute jong naneilou ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pakaiyin, hiche munna pengho chapatele chanute thudol, chule ahinguva anuteo thudol le hiche gama ahinguva apateu thudol hitihin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho hesohtah-a thiuva, kikalou diu, vuijong kivui louva tollhanga ehbang bep hidiu, amaho chemjamle gilkela mangthah uva alongu chu chunga leng vachate le leija gamsaho anneh hiding ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Pakaiyin hitin aseije, lunghemna insunga lut hih-in, akapi dingle alunghempi dingin jong che hih-in, ajehchu keiman hiche mite-a konin kacham nale kahebolna chule kahepina kaladohtai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Alen aneu hiche gamahi thicheh diu, amaho kivuilou diu, minjong aka loudiu, atahsao jong ki-at pop louding, luchaija jong umlou diu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thi jeh-a lhamonsahna dinga mite kapma lhisoh lou ding, koimachan anu ahiloule apa lungmonsahna dinga donding khon apeh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang jong amaho toh nedingle dondinga golvahna insunga nalut louhel ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Israel Pathen janel Pakai chun hitin aseije, vetan, namitmule nahinkho uva hiche nuina oginle kipana ogin, moulang nopna oginle mounu ogin katansah hel ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hung hiti ding ahi, thu jousehi hiche mite nahetsah tengle, amahon najah-a, ipijeh-a Pakaiyin thilse nasatahhi keiho douna-a aphondoh hitam? Pakai ka-Pathen'u douna-a kakhangit lounao leh kachonsetnau ipiham? ati dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuteng nangin ajah uva nasei ding ahi, ajehchu napateu vin eidalhaovin, pathen dangho nung ajuijun, amaho ajenun, ahouvun keima eidalhaovin, kadan thupeh anitpouve, tin Pakaiyin aseije, natiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanghon napateu sanga sejocheh nabol taove, ajehchu veuvin, amahon kathu angaida theina diuvin amitakip ama ama lunggel gilou dungjuijin achonuvin,
  </para>
  <para style="p">
    <verse number="13" style="v" />hijeh-a chu keiman hiche gama kona nahetkhah louvu, nanghole napateu vin ahetkhah louvu gama kapaidoh-a, chua chu sunle jana pathen dangho najen diu, hia chu lungsetna kamusah loudiu nahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun vetan, Egypt gama kona Israel chate puidoh-a Pakai chu ahing jinge, tia akiseikit tahlouhel na nikho hochu ahung lhunge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla, Israel chate sahlam gama konle, aman anochehna gamho-a kona hinpuidoh-a Pakai chu ahing jinge. Chule apateu kanapehsa amaho gama chu kahin lepuikit dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ven, ngamanho tamtah kasol ding ahi, tin Pakaiyin aseije, amahon ahinmat dingu, chujoule sadelho tamtah solingting, amahon moltinle lhangtin chule songkoho-a kona adel lele dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu alampiu jouse kamitnin amun, amaho kamaija konin akisel pouvin, akhangit lounao kamitmu-a konin akiselpoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amasatah-a keiman akhangitlou naole achonsetnao ajatnia kalethuh ding ahi. Ajehchu amahon kagam asuboh un, kagoulo chu ki-dah le thet umtah athilongu chun adipset taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Pakai kahatnale kakuldet, chule bolgenthei ni-a jamlutna, leiset kolmonga konin chidang namdangte nahenga hunguntin, ipateovin jouthule ahomkeo phatchomna beihel ana kisan-u ahi atidiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathen la hilou, pathenho mihemin akisem dingham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun vetan, keiman amaho hichehi khatvei hetsah ingting, kakhutle kathahat hetsah inge, chutile amahon kamin hi Pakai ahi ti hetao vinte.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah chonset nahi thih lekhamol le song mantam muhhema kisunlut ahin, alungsungu dokhang chungle namaicham sakiho chunga kikhenga ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Achateuvin thinghing phungho leh molsang chungho-a amaicham hou leh adoikhom hou ageldoh jiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo gama kamolsang, naneile nagou jouse gal laija thil kichom banga kapehdoh ding chule nagam pumpi lhung keija namun sangho, chonset mana kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nangma, nangma ngeijin, nagoulo kapehsa chu nalo jomlou ding, nahetphah lou gama namelmate jena kapansah ding nahi. Ajehchu kalunghana meikong nakou sah-un, a-itih-a kongjing ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin hitin ati, mihem'a atahsan na ngama, atichunga abantha kisema, chule Pakaiya kona alungthim petmang mipa chu sapset chenghen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu ama nelphaija phaipheng keh banga thilpha ahungteng amulou ding, ahinla gamthipma gambeh neoho chi umna gamle mihem chenlouna gama cheng ding bou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai tahsana, akinepna Pakai hia mipa chu anun nom ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu ama twipanga thing kiphut, vapanga ajung jamdoh-a, nisa satnin sangkha louva ana jong hingjing tobang chu hiding ahi, gamgot kum-a olmo louva, aga jong geongai louding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lungthimhi thil jouse chunga joulhepna dimset, gitlouna-a sesoh hel ahin, hichehi kon hethei jintem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Mitin ama ama lamlhah dungjuile atohga dungjui cheh-a kapeh theina dingin, keima Pakaiyin lungsung kakholin, lunggil ho kapatepjin ahi,
  </para>
  <para style="p">
    <verse number="11" style="v" />vabuh-in atwi athah-a khelouva adalhah banga, adihlouva haojong chu chutobang ahin; chule ahinkho kimtuh-a adalha-a, akichaina chu mingol hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Atila pat laltouna sang loupi khat umchu kamun theng laiju chu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Israelte kinepna Pakai, nangma dalha jouse jahchaova keija kona kidalseho chu tolla kijihlut ding ahiuve, ajehchu amahon Pakai hinna twi longjing chu adalha taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Neidam sah-in, Vo Pakai, chutile dam tange, neihuh-in chutile huhhing hitange, ajehchu nangma kavahchoi jing pa nahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vetan, amahon kajah-a, Pakai thusei chu hoiba ham? Tuhin hung guilhung hen, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keima vang, kelngoichingpu kahina-a nakoma kon kavah mangpon, dana nikho jong kangaichapoi, namasanga kakama thupot chu, adih ahi nangin nahenai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kei dingin manthah na hihih-in, nikho phalou ni-a kakinepna nahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Eibolgimho jahchaohen lang, keivang nei jachatsah hih-in, amaho lungthoijuhen lang, keivang neilungthoi sah hih-in, achunguva nikho phalou lhunsah inlang, manthah na jatni-in sumangin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakaiyin kajah-a hitihin aseije, Jerusalem kotpi jouse, Judah lengte lutle potlena, mihem chate kotpi phunga khun gadingin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule ahenguva, hiche kotpi-a lutji nangho Judah leng tele, Judah mite, chule Jerusalem'a chenghon Pakai thusei hi ngaijun.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakaiyin hitin aseije, kichihtheijun lang cholngah nin pohgih pohdaovin, chule hichu Jerusalem kotpi-a jong hinpolut hih-un.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na inhouva konin jong cholngah nile pohgih podoh hih-un, najong imacha tong hih-un, napateu thu kapeh bangin cholngahni chu jabol uvin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla amahon ajuipouve, anaujong asungpouvin ahi, ajahlouna diule hilchahna asanlouna diuvin alouchal uve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hung hiti ding ahi, Pakai jin cholngah ni-a hiche khopi kotpi-a pohgih pohlut louna dingle, na imacha tohlouna dinga choldoni najabol joh uva, lunglut tah-a neijop ule,
  </para>
  <para style="p">
    <verse number="25" style="v" />David laltouna-a tou lenghole lengchate, kangtalai le sakolchung chongho, amahole amilenteu Judah mitele Jerusalem'a chengho chu, hiche khopi kotpi sunga lutnuntin, hiche kotpihi a-imatih-a umjing ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule amaho Judah khopiho-a konle, Jerusalem kimvela konin, Benjamin gama konle phaichama konin molsang ho-a konle, lhanglama konin govam thil tole ganlhaiho Pakai ina hinpouvinte.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla nanghon choldoni jabolna dingle, choldoni-a Jerusalem kotpi-a lutna-a, pohgih pohlouna dinga kathu nangai lou uleh, chuche kotpiho phunga chu mei kakonsah-a, hichun Jerusalem'a leng inpiho akahvama, mitlouhel ding ahitai, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiya kona Jeremiah henga thu hung lhung chun hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />kipat in, beldengpa ina chesuh-in, hikoma chu kathu kajahsah ding nahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin beldengpa ina kachesuhle, vetan, aman bel dena akang kikola chun na anatonge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin bonngana abelden chu beldengpa khutna chun asedentan, hitichun beldengpan den dinga aphatsah bangin, belchom khatnin adengtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin Pakai thu chu kahenga ahung lhungin aseije,
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Israel insung, beldengpa banga kabolmo nahiu vem? tin Pakaiyin aseije. Veuvin, beldengpa khutna bonngan banga khu kakhutna um nahilouvu ham? Vo Israel insung.
  </para>
  <para style="p">
    <verse number="7" style="v" />Itih phat hama namkhat ham ahiloule lenggam khat ham chungchanga, bodoh ding, suhlhuh ding, suhmang ding tia kaseija,
  </para>
  <para style="p">
    <verse number="8" style="v" />adouna-a kana seisa, chuche nam chu asetnaova kona akisih uva ahile, achunguva thilse bolding kagotsa-a kona kalung kakhelkit ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Itih phat hama namkhat ham ahiloule lenggam khat ham chungchanga semdoh dingle phudet dinga kaseina ding techun,
  </para>
  <para style="p">
    <verse number="10" style="v" />kamitmu-a thilse aboluva, kathu angailou-ule, phatchom sah-u vinge kana tisa, thilpha-a kona chu kalung kisihkit jengding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun tun, Judah mitele Jerusalem'a chengteho henga Pakai jin hitin aseije, veuvin, nangho dounan thilse kagongin, nangho dounan thil gilou kagonge. Tuhin mitin nakhangitlou naova konin hung kileuvin lang, nachonnaole nathil bolu aphacheh hisah-un, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon, kinepna aumpoi, kalung gotnu bang chehle mitin ama lung gilou ngaito bang cheh-a kachonjoh dingu bou ahi atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun Pakaiyin hitin aseije, tun nanghon Pathen helouho lah-a dong temun, hitobang chu kon ajah khah em? Israel nungah theng chun thil tijat umtah khat aboltai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Loujao songpi-a kona Lebanon buhbang hunglong chu, min dalhantin, twidap jenjen munchoma kona hunglong chu kidalhan tem?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu kamiten eisumilun, pannabei jin gimnamtui ahalun, chule keng lampiho-a chena din, lamluiho-a konin apetnun alampi houva akipalun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Agamu kamhelna dingle, a-itih-a leihit khongleu dingin asemun, ajotpa chanchu king vutna alu apei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Melma masanga solam hui thecheh banga amaho kathecheh uva, ahamset niule ang-ngat louva kanungsun ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amahon, hungun, Jeremiah dounan thilgon khat gong-u hite, ajehchu thempu-a kona danthupeh chu manglou ding ahin, miching ho-a kona thumop, themgaova kona jong thu beilou ding ahi. Hungun kamsungin ama vouhitin, athu khatcha ngaipou hite, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Neikhoh sah-in, Vo Pakai, eikinahpiho ogin khu ngaitemin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ase chu aphan kilethuh intem? Ajehchu amahon kei thana dingin ko alaitauve. Amaho-a kona nalunghana nalahdohna dinga, amaho dinga thupha kisei chu geldoh-in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun achate chu kellhah na-a pedoh-in lang, athisanu chemjam hatna-a bunglha tan, chule ajiteu chu meithai soh uhen, apasalteu thisah inlang, agollhanghou gala chemjamin lousah-in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Photlot louva achunguva galmihon napuilut tengle, a-inhouva jong kana kijahen, ajehchu kei thana din ko alaijun, kakeng o-nadin thang akamuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahijengvangin Pakai kei thana dinga kachunga akihousomu nangin nahenai, akhangit lounao ngaidam hih-in lang, achonsetnao jong namitmu-a konin noimang hih-in. Namasang-ah gal lelsahjon lang, nalunghan tengle hitichun bolin.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin hitin aseije, chenlang beldengpa lei halkhat galanlang, miho lah-a tehse ho le thempu luiho gapuijin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Solam kotpi lutna-a Hinnom chapa phaicham lama potdoh-in lang, kaseipeh ding thuho chu gaphong jal-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Vo Judah lengte le Jerusalem'a cheng nanghon, Pakai thu chu ngaijuvin, janel Pakai Israel Pathen'in hitin aseije, vetan, hiche mun chungahi thilse kalhunsah-a, ajachan akolu thah tuntun ding ahi, tin seijin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu amahon eidalhaovin, hiche munhi ahotbolun, asunga chun amahole apateu chule Judah lengten anahetkhah louvu pathen dangho din gimnamtui ahalun, hiche munhi setna neilouho thisan adiptauve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon kei thupeh loule kei seilou, kalunga jong lutkhalou Baal henga govam thilpeh nadingle, achateu meija gona dingin Baal munsang ho jong asemun,
  </para>
  <para style="p">
    <verse number="6" style="v" />hijeh chun vetan, hiche munhi Tophet, ahiloule Hinnom chate phaicham kiti talouva kithana phaicham joh kitina ding nikhoho hunglhung ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule keiman hikoma Judah le Jerusalem kithumopna moh kahisah-a, amelmateu masangle ahinnao holte khutna chemjam'a kalousah-a, alongu chu chunga vachate le leija ganhingho anneh hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman hiche khopiho akamhel le leihit khongleuva kasema, hiche suhgamnaho jouse jeh-a chu ajotpa chan king vutna chesa diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule achapateu sa leh achanuteu sa kanehsah-a, khopi kiumkim vel sunga mitinin agolpa sa aneh uva, hikoma chu amelmateule ahinnao holten ano chinto diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutengle nangman nalhonpi ho mitmu-a hai chu nasuhkeh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ajah uva, janel Pakaiyin hitihin aseije, min beldengpa bel bitkit theilou dinga asuhkeh tobang ngeija hiche mitele khopihi kivuina ding abeihel kahse-a kasuhsetna Topheth'a kivui ding ahiuve, nati ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiti achu hiche khopile asunga chengho chunga kabola, Tophet khopi kabahsah ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon inho jouse chunga van janelpi houna-a gimnamtui ahal uva, pathen dangho henga don thilpeh asunlhah jeh uvin Jerusalem inhole Judah lengte inho chu Tophet mun banga kisuboh ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuphatnin Topheth'a konin Jeremiah chu Pakaiyin gaochanga asolna lama chun ahungin, Pakai inhong sunga chun adingin, mijouse henga aseitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israelte Pathen'in hitin aseije, amahon kathusei ngailouna dinga angongu avaiput jeh-un, veuvin, hiche khopile akhopi jouse adouna-a kaseisa thilse jouse chu kalhunsah ding ahi, ati.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Pakai insunga vaipo pipuija pang Immer chapa Pashhur Thempu'n, Jeremiah hiche thuho-a agao chu ajatan,
  </para>
  <para style="p">
    <verse number="2" style="v" />chuin Pashhur in Jeremiah Themgao chu avon, Benjamin kotpi sunga soulah-a ahenin, hichu Pakai inkom ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ajingin ahitin ahi, Pashhur in soulah-a kon chun Jeremiah chu ahin puidohtai. Chuin Jeremiah in ajah-a, Pakaiyin namin Pashhur hilouvin “Magor-missabib” asahtai, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakaiyin hitin aseije, ven, nangma tahle nagol ho jouse dinga tijat umtah-a kasem ding nahin, amaho chu amelmateu chemjamin louvuntin, nangin namitna navet ding, chule Judah te jouse Babylon lengpa khutna kapeh-a, aman gal hinga Babylon'a akaija, amaho chu chemjam'a atha ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukalvala chu hiche khopi haona jouse, atohdoh jouseu, thil manlu jouse, Judah lengte gou jouse chu amelmateu khutna kapehdoh-a, hichu asuh chatvaijuva akilah uva, Babylon'a apoh diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nang, Pashhur na-insunga cheng jousetoh gal hinga Babylon gama nacheuva, chuachu nathi ding, nangle jouthu nanaseipeh nagol ho jousetoh chu-a nakivuiden diu ahitai, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai, nangin neijou lhepmin, joulhep kahitai, nangma kei sangin nahatjon, neinajou tai. Keima nisehle i-sah louvin kaumin, mitinin eitotnop naove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kathusei chanin kapeng doh-in, hunamle suhmang jeng katijin ahi. Ajehchu Pakai thu chu kei dingin niseh-a mihouset nale i-sah louna ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin keiman ama chu phahpoh dangting, aminin jong thu seitaponge kati. Ahinla ama thu chu kalungsunga hin, kaguho sunga meikong kilhakhum abangin, kathohlel behsetnin kaumthei tapoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla mi tamtah-in eiminset sahnao kajan, ningtina tijatna adime, amahon hehseuvin, hehseuhite akitiuve. Kakihet gilpiho jousen eichanglhi uvin, ijemtin lheplhah-in umintin, eihon ama jouvuhitin, achunga iphu kilah uhite akitiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla Pakai chun mihangsan tijat umtah bangin eiumpin, hijeh achu eibolgimho kipal lhuva eijo lou diu, alolhin loujeh uva chu jahcha lheh diu ahin, tonsotna akisuh dongnao chu suhmila umlou ding ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla Vo janel Pakai, midih patepna lungsungle lunggil muletsohji, achunguva naphulahna neimusah-in. Ajehchu kachung chang thu nahenga kakhe lhahsoh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai henga la saovin, Pakai chu vahchoijun, ajehchu aman thilse bolho khutna konin migenthei ho hinna-a ahuhdoh-e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kapenni chu sapset hihen lang, kanun eihin ni chu vangboh hidahen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kapa henga nang dingin chapa khat apengtai tia thu hung lhutna, kapa kipasah pa chu sapset changhen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche mipa chu Pakaiyin asuhchim, lungheilou khopiho toh banghen lang, jingkahle kana, sunphatle kho kisap jahen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu kanu chu kalhankhuh anahi theina dingle, chule phattina anaobu keima dinga alet jingna dingin, aman naobu-a konin einathat tapon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahinkho jachatna-a lhum mang ding, tohgimna le lunggimna mubep dinga, ibola naobu-a kona kahung pendoh hitam?
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zedekiah lengpan Jeremiah henga Melchiah chapa Pashhur le Maaseiah thempu chapa Zephaniah asol laija Pakaiya kona Jeremiah henga thu hunglhung chun aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kangeh nahi, keiho dingin Pakai chu neidoh peh-un, ajehchu Babylon lengpa Nebuchadnezzar'in kachunguva gal abolin, chuti ahile athilbol kidangho jouse dungjuijin Pakaiyin eihuvintin, ama keiho-a konin chetouthei nante, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jeremiah'in ajah lhona, nangnin Zedekiah henga hitin seilhonin:
  </para>
  <para style="p">
    <verse number="4" style="v" />Israelte Pakai Pathen'in vetan, kul polama nangho na-umkol khumuva, Babylon lengpa le Chaldea mite nadouna diu, nakhut uva gal manchah ho chu kanung heiding, chule amaho chu hiche khopi sungahi kahin khopkhom ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keimatah-in khut lhangdoh le banthahat toh, lunghangle lungsa tah-a, chule lungnatah puma nangho kasatdiu nahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hiche khopi sunga chengho mihem le ganhing agoma katha ding, hise nasatah-a kona thiding ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichejou chun Pakaiyin aseije, keiman Judah lengpa Zedekiah le asohte, chule mipi ho, chule hiche khopi-a hise-a, chemjam'a, kela kona hoidohho chu Babylon lengpa Nebuchadnezzar khutna, amelmateu khutna, ahinnao holte khutna kapehdoh ding, aman amaho chemjam'a atha-a, akhenlou diu, achunga hepina anei louhel ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hiche mite henga hiti ahi nasei ding ahi, Pakaiyin hitin aseije, veuvin, keiman namasanguva hinna lampile thina lampi kakoije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche khopi sunga uma chu chemjam'a, kela, hise-a thiding: ahinla chedoh-a nangho hin um khuma Chaldea miho henga kipelutpa chu hingintin, chule ahinna chu ama dinga gala kichomdoh bangbep hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu keiman hiche khopi hin thilse atona dinga kamaingat ahitai, thilpha dinga ahipoi, tin Pakai jin aseije. Hichehi Babylon lengpa khutna kipedoh-a, aman meija ahalvam ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Judah lengpa insung thudola, Pakai thu ngaijun, tin seijin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo David insung mite, jingkahle thu tannun lang, misugenthei pa khutna konin hunama kichompa chu huhdoh-un, ajole thilse nabol jeh uvin, koima phelmit theilou kalunghana meikong tobang potdoh getninte, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vetemin, eidou diuva koi hungsuh-a, ichen naova koi hunglut dingham? tia seija, vo damphaija chengpa, chule phaicham songpi, Pakai keiman nangma kadouve, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla Pakaiyin natohga dungjuija kabolgima, gammang sunga mei kakousah-a, hichun akimvela thil jouse akahvam ding ahi, ati.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin hitin aseije, Judah lengpa ina chesuh-in lang, hiche thuhi gaseijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo David laltouna-a tou Judah lengpa, nangle hiche kotpiho sunga lut nasohte le namite, Pakai thu chu ngaijuvin:
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin hitin aseije, nanghon thutan nale chonphatna bolunlang, nanghon mibolgima konin hunama kichompa chu huhdoh un: gamdang mi paneilou ahiloule meithai henga adihloule pumhat boldaovin, hiche mun'a hin setnabei thisan jong sohih-un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nanghon hitichu nabol uva ahile, kangtalai le sakola amale asohte, chule amite hiche kotpi ahi hunglut uva, David laltouna-a toudiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla hiche thuho hi nangai louvule, keimatah kaki hahsel ahi, tin Pakaiyin aseije, hiche inhi akeohela hung umding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla Pakaiyin, Judah leng insung jah-a hitin aseije, nangma kei dinga Gilead nahin Lebanon luchang nahi: hijengjongle gamthiple mi chenlouna khopi-a kasem teiding nahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nadou ding misumang ho, gal manchahto kithocheh kagona, na cedar thing deichomho aphuh uva, mei sunga aselut dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nam tamtah-in hiche khopihi ahin hopaova, amitakip min aheng akom henga, ibola Pakaiyin hiche khopi lentah hi ahitibol hitam? atidiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuteng amahon, ajehchu amahon Pakai Pathen thulhun adonpouvin, pathen dangho ahouvuva ajen jeh-u ahi, tia adonbut dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangho mithi dingin kaphih-un, lunghempi jong bolhih-un: apotdohpa ding joh-in lhasetah-in kapmun, ajehchu ama hung kilekit talou ding, apenna gam jong mukit lou ding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Pakaiyin hitin ati, hiche mun'a kona potdoh apa Josiah khela lengchang Judah leng Josiah chapa Shallum thudola, ama chulama hung kilekit louhel ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla gal hinga akaina lamu mun'a chu thia, hiche gamhi amukit louding ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chonphat louna-a a-in kisah-a, adihlouva a-indan kisempa, aheng akom manbeija goija, atohman peloupa chu, Ohe! ada ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />In lentahle indan lentah chule bangkot ho umin kisah inge, tia cedar thinga sa-a, sandul jetna naloi ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangin cedar jenga najo jeh-a chu nalengchan ding ham? Napa chun aneh-a, adonna, thutannale thudih anabolla, hichu ama dinga anaphalheh hilou ham?
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman vaicha lhasamho thu anatandih jin, hichu amadin anaphalheh ji-e: hichehi keima hetna hilou ham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla namitle nalungthim chu nakiloset na dingle, setnabei thisan sona, suhgenthei nale pumhat manna ding bep ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun Pakaiyin, Judah leng Josiah chapa Jehoiakim thudol hitihin aseije, amahon Vo kasopipa, vo kasopinu tia alunghempi loudiu, amahon ama dinga, vo pakai, ahiloule vo jana-a aloupina, tia alunghempi loudiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama sangan kivui banga kivui ding, Jerusalem kotpi kallama kikaija kipaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lebanon'a chetouvin lang, gakap temin, chule Bashana gakisenin lang, Abarim'a konin gakapmin. Ajehchu nangai jouse kimanthahsah ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman naphatna ding kasei ahin, ahinla nangman ngaiponge nati. Hichehi naneolaija na-umchan ahin, hitia chu kathu nangailou ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huijin nakelngoi chin jouse semlih intin, nalungsette gal hinga chediu, nagitlouna jouse jeh-a najachat ding, chule nakisuhdong ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vo cedar phunga bu kiset, Lebanon'a chengte, numei naosonat banga natna nachunga ahungchuh phungteng, iti lungset naum tadem?
  </para>
  <para style="p">
    <verse number="24" style="v" />Keima kahing jinge tin Pakaiyin aseije, Judah leng Jehoiakim chapa Koniah chu kakhut jetlama melchihna hijongle chun, kasutlhah ding nahin:
  </para>
  <para style="p">
    <verse number="25" style="v" />Nahinna holtehole amaiju nagin jingho, Babylon lengpa Nebuchadnezzar khut ngeija, chule Chaldea miho khutna kapehdoh ding nahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keiman nangmale nahinga nanu chu napenna hilou gamchombeh-a kapuilutna, hia chu nathi ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla amaho akilekit nomnao gama chu kilekit louhel ding ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche mipa Koniah hi mi isahlou milim chipsa chu hijam? Amahi deilouhel hitam? Ibola amale achilhahte kipaidoh-a, amahon ahetlouvu gama kipaidoh-a hiuvaham?
  </para>
  <para style="p">
    <verse number="29" style="v" />Vo leiset, leiset, leiset, Pakai thu chu ngaitemin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pakaiyin hitin aseije, hiche mipahi chaneilou, ahinkho sunga lolhing lou ding ahi, tin suntaovin: ajehchu achilhah khatcha lolhing lou ding, David laltouna-a touva Judah gama vaihom umlou ding ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kakelngoite hamset na-a sugamle thecheh-a kelngoiching ho adau ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun kamite vah-a kelngoiching ho douna-in Israelte Pakai Pathen'in hitin aseije, nanghon ka kelngoi hon nathe cheh-un, nano mangun, navil pouve: veuvin, nathil gilou bolu chunga gotna kapeh ding nahiuve, tin Pakai jin aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ka kelngoi hon amohho chu kadeldohna gamho jouse-a kona kachom khoma, ahong sunguva kalepui kitna, amaho gatheijuva pungthei diu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman amaho vahdinga achunguva kelngoiching ho katundoh ding, amaho kichatalou ding, lungjong lungthoitalou diu: imacha jong lhasam talou diu ahi, tin Pakai jin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vetan, keiman David dinga chonphatna bah khat katundoh-a, leng khatnin vai ahoma lolhing ding, leisetna thudih-a thu atan ding nikhoho ahung lhunge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama nikho sunga Judah kihuh hinga, Israel bitkeija cheng ding ahin: chule ama kikouna ding min chu Ichon phatnao Pakai kitiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun ven, Egypt gama kona Israel chate hinpui dohpa Pakai chu ahing jinge, atikit louna diu nikhoho chu ahung lhunge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin sahlam gamkaija kona kanadelmangna gamkaiho jouse-a kona, Israel insung chilhah hinpui touva, kaihoipa chu ahing jinge, chule amaho agamtah uva cheng dingu ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Themgaoho jeh-in kalunghi kasunga apohkeh tan, kagu jouse akilong gamin, Pakai jehle athenna thuho jeh-in, jukhampa jun ajo mipatoh kabangtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu gamsunghi jonthanhoi adimsetnin, kihehsetna jeh-in gamsung alunghemin, gamthip nomlaiho agolhan, alamlhah-u asetan, ahetnao adihtapoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Themgaole Thempu agomin aboh geltan ahi; henge, ka-insunga jong agitlounau kamudohtai, tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu alampiu chu amaho dinga muthima lamnal tobang hintin, amaho kino lele uva, chua lhugam diu: achunguva thilse kapohlut ding, gotna achan kum-u hiding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Samaria Themgaoho lah-a ngolna kamudoh-in, amaho Baal jenga agao vun, kami Israelte achonsetsah taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jerusalem themgaoho lah-a jong tijat umtah thil kamu doh-e: amahon jonthanhoi abolun, jou amangun agitlounauva kona khatcha ahung kile louna din, thilse bolho khuttha ahatsah-un, amaho abonun kei dingin Sodom abangun, chule asunga chengho chu Gomorrah tobang ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun janel Pakaiyin themgaoho thudol chu hitin aseije, ven, keiman amaho thinglunga kavah-a, thinkha twi kadonsah diu ahi. Ajehchu Jerusalem themgaoho-a konin gamsung pumpi-a kisuhbohna ajaltai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Janel Pakaiyin hitin aseije, naheng uva gao thusei themgaoho thu chu ngaihih-un, amahon manmo nasouva agaothu seiju jong amaho lunggela kon ahin, Pakai kamsunga kon ahipoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon einahsah louho henga, Pakaiyin asei ahi, nanghon chamna nanei diu ahi, atiuve. Chule amahon amaho lungngaito banga chonho mitin henga chun, nachunga thilse imacha chuponte, atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu Pakai thumop na-a koi gadinga, athu ja-a koiham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Vetan, Pakai lungsatna chimpei khohtah ngeichu ahung nunge, hichu migilou luchunga khohtah-a chuding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai lunghanna chu atohdoh kahsehle, alung ngaito amolso kahse-a kilekit louding ahin, ninunung tengle chamkimtah-a nahet them diu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche themgaohohi kasol ahipon, hijongle alhaijun, kenla amaho thu kamoppon, ahinla agaochanguve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla amaho kathumopna-a dinga hiuhenlang, kamite kathu ajahsah-u hile, amahon alampiu phalouva kon chule athilbolu phalouva kona alehei diu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keima naitah-a um Pathen, gamlatah-a umlou Pathen chu kahilou ham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kamuthei louna dinga munthipma kiseljouva mi umintem? Pakai jin ati. Keima vanle leisetna dimsoh kahilouham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kamina jouva gaova themgaoho thusei kajan, mang kaneije, mang kaneije, atiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jouva gaothusei themgaoho lungsunga itih chanpi hichehi umding ham? Henge, amaho alungsung uva mijoulhep themgaoho ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Apateuvin Baal jeh-a kamin asuhmil banguva, aheng akomuva mitinin amang aseijuva, kamite chu kamin suhmilsahna ding angaitou ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mangnei themgaovin mangthu seihen lang, kathu neija chun kathu tahsan umtah-in seihen: suhlouchang dinga asi chu ipi ham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kathuhi meikong tobang hilou ham? tin Pakaiyin aseije. Songpi disela vokeh sehtum tobang hilou ham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh chun vetan, keiman aheng akoma kona kathu gumang themgao takip chu kadou ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Veovin, aman aseije, tia aleiju mangcha-a themgaoho chu keiman kadouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="32" style="v" />Veovin, mang dihlou gaothua seija miho hille-a, ajounaole anahsahmo naova kamite puise-a, keisola hilou, thu kapeh jong hilouho chu kadou ahi, tin Pakaiyin aseije. Hijeh achu hiche mitehi aphatchom sah louhel diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiche mitele themgao, ahiloule thempu khattouvin, Pakai pohgih chu ipiham? tia nadoh ule, chuteng nangin ajah uva, ipi pohgih ham? Nangho tahhi kapaidoh ding nahiuve, tin Pakaiyin aseije, tin seijin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Pakai pohgih, tia seiding themgaole thempu mipa thudol chu, chuche mipa tahle a-insung chu talen kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mitinin aheng akomchehle asopipa cheh henga, Pakaiyin ipi adonbut nem? Chule Pakaiyin ipi aseijem? tia nasei diu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Pakai pohgih tia naphahpoh kit loudiu ahitai. Ajehchu amitakip thu chu ama pohgih hiding, ajehchu i-Pathen'u janel Pakai Pathen hingjing thu chu akaleh-in nahei gamtaove.
  </para>
  <para style="p">
    <verse number="37" style="v" />Themgaopa henga chu hiti ahi nasei ding ahi, Pakaiyin ipi nadonbut nem? Chule Pakaiyin ipi aseijem?
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahinla Pakai pohgih chu, nati uva pat hiche thu nasei jeh-un, Pakaiyin hitin aseije, Pakai pohgih chu tia nasei jeh-un, Pakai pohgih chu natikit loudiu ahi, tia naheng uva thu kahinthot ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hijeh chun, ven kei keimatah-in nangho kasuhmil uva, nanghole napateu kapehsa khopi chu kapaidoh-a, ka-angsunga kona kaledoh diu nahiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule a-itih-a nachung uva housetnale tonsot jachatna kahin pohlut khumuva, hichu suhmiltih umtalou ding ahi, ati.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babylon lengpa Nabuchadnezzer in, Judah leng Jehoiakim chapa Jeconiah le Judah milenho, thingthem hole thihthem ho Jerusalem'a kona Babylon'a apuimang nungin Pakaiyin Pakai houin maija chun theichang pocha ni einamu sah-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pocha khat chu theichang phatah, theichang gamasapen tobang hel ahin, pocha khatjoh chu theichang phaloubeh, nehthei louhel, phamo behseh jeng ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chujouvin Pakai chun kajah-a, Jeremiah ipi namu em? eiti, chuin keiman theichang ho kati; theichang phaho chu aphalheh-in, chule phaloutah nehthei louhel, chuti phatmo jeng ahi, kati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakai thu chu kahenga ahung lhungin aseije,
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai Israelte Pathen'in hitin aseije, hiche theichang phamoho bangahi Judah mite, hiche mun'a kona Chaldea gama kasoldohho, gal hinga kikaiho chu aphatna diuva kahet ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu achunguva aphatna diuva kavet lhih jinga, hiche gamahi kahinlepui ding: kasahdoh-a kasotlhuh lou ding, kaphudetna kabodoh lou ding ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima Pakai kahi ahetdohna diu lungthim khat kapeh-a, amaho kamite hiuva, keima a-Pathen'u kahi ding ahi. Ajehchu amaho alung pumpiuva kahenga hungkile diu ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Theichang phalou, nehthei hilou, chuti phatmo bang chun tahbeh-in Pakaiyin hitin aseije, Judah lengpa Zedekiah le amilenho Jerusalem'a umden, hiche gama amohho, chule Egypt gamsunga chengho chu, chutia chu kapehdoh ding:
  </para>
  <para style="p">
    <verse number="9" style="v" />chule kanomangna ding mun jouse-a, seisetle thuchih dinga seichahle gaosap dinga, leiset lenggam jouse-a akisuh khahna diuva chaulele dinga kapehdoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule keiman amahole apateu kanapehsa gama kona amanthah hel kahseuva alah uva chemjam, kellhah, hiset kasolpeh ding ahiuve.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengpa Josiah chapa Jehoiakim lengchan kal kumli channa-a, Judah mite jouse chungchang thudol Jeremiah henga hung lhung chu Babylon lengpa Nebuchadnezzar lengchan kumkhatna ahin,
  </para>
  <para style="p">
    <verse number="2" style="v" />hichu Jeremiah themgaovin Judah mite jousele Jerusalem'a chengte jouse henga aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah leng Amon chapa Josiah kum somle kumthum na-a pat tuni geijin hichu kum somni le kumthum ahin, Pakai thu chu kahenga ahung lhungin, keiman naheng uva kaseijin, matah-in kathouvin, kaseijin, ahinla nangaipouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Pakaiyin naheng uva asohte themgaoho jouse ahinsolin, jingpi-a thouvin ahinsolin, ahinla nanghon nangaipeh pouvin, jahdin jong nanau nasung pouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon aseijun, amitakip tuhin alampi phalouva konle thilphalou nabol uva konin hungkileu hen lang, Pakaiyin nanghole napateu atonsot tonsotna dinga anapeh gama chun chengtauvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule pathen dangho chu jendingle hou dingin juidaovin lang, nakhutsoh uva lunghansah din neiphinse hih uvin, chutile bolsetda taovinge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahijengvangin kathu nangaipouvin, hitichun nakisuh khahna diuva nakhutsoh uva lunghansah din neiphinse uvin, ahi tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun janel Pakaiyin hitihin aseije, nanghon kathu nangailou jeh un:
  </para>
  <para style="p">
    <verse number="9" style="v" />Veuvin, mi solingting sahlam gama insung jousele kasoh Babylon lengpa Nebuchadnezzar hiche gam dou dingle asunga chengho, chule akimvela namho jouse sumanghel dinga kahinpuija, amaho chun kidang asah-va cheh sasa diu, chule a-itih-a kamhela kalha ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chukalvala amaho-a kona kipana ogin, thanopna ogin, moulang ogin, mounu ogin, sumhei song kiheh gin, chule thaomeivah kasuhbei ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche gam pumpihi kamhelle datmotah-a umding, hiche namho chun Babylon lengpa chu kum somsagi ajendiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule kum somsagi lhinteng hiti ding ahi, akhangit lounao jeh-a Babylon lengpa chule hiche Chaldea mite gam chu talen kapeh-a a-itih-a dinga kamhela kalha ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche gam douna-a kaseisa thuho jouse nam jouse douna-a Jeremiah themgaovin anasei, hiche lekhabu kisun jouse ngei chu kahin lhunsah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu amahon nam tamtah le leng lenho ajendiu, atoh-u dungjuile akhuttah uva athilbolu dungjuija kalethuh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu Israelte Pathen Pakai chun kahenga hitin aseije, kakhutna lunghanna khonhi lanlang, kasolna ding namho jouse chu donsah in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule amahon adonuva alah uva kasol ding chemjamho jeh-a chu lonle leuva ngoldiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakai khutna khon chu kalan, Pakaiyin eisolna namho jouse chu kadonsah in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jerusalem le Judah khopiho, chua lenghole milenho chu tulai bangahi kamhela, datmo uma, leihit khongleuva gaosapma umsah dingin,
  </para>
  <para style="p">
    <verse number="19" style="v" />Egypt lengpa Pharaoh le asohte, chule amilentele amipite:
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi kichoh hal ho jousele Uz gamsunga lengho jouse, Philistine gamsunga lengho jouse, chule Ashkelon, Azzah, Ekron chule Ashdod na amoh um jouse,
  </para>
  <para style="p">
    <verse number="21" style="v" />Edom le Moab, chule Ammon chate,
  </para>
  <para style="p">
    <verse number="22" style="v" />Trye lengte jousele Zidon lengte jouse, chule twipi gala twikol gamho lengte,
  </para>
  <para style="p">
    <verse number="23" style="v" />Dedan, Tema, Buz chule gamningkoi kikhonnaho jouse,
  </para>
  <para style="p">
    <verse number="24" style="v" />Arabia lengho jousele nelphaija cheng michoplop ho jouse,
  </para>
  <para style="p">
    <verse number="25" style="v" />Zimri lengte jousele Elam lengte jouse, chule Media lengte jouse,
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule naija gamla sahlam gamkai lengho jouse khat khatna, lei chunga vannoi lenggam jouse, chule amaho nunga chu Sheshach lengpan adon ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh achu ajah uva Israel Pathen janel Pakaiyin hitin aseije, donun lang kham uvin, chule phidohun lang lhu uvin, thoukit tahih un. Nalah uva kahinsol ding chemjam jehchun, tia nasei ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule hiti ding ahi, amahon nakhutna khon chu lah-a donding adaova ahile, nangman ajah uva, janel Pakaiyin nadon teidiu ahi ati, nati ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu ven, kamina kivo hiche khopi chunga thilse kahin pohlut patding ahitan, nangho talen manlouvin umun natem? Nangho talen manlouvin umpouvin nate: ajehchu leiset chung cheng jouse chunga chemjam kakou ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh chun amaho jouse dounan hiche thuho hi gaovin, ajah uva seijin, chunga konin Pakai hung kitumin tin, achenna munthenga konin a-aw hinsodohin tin, thanei tah-a muntheng chunga kituma, lengpiga chilho banga, leiset chunga cheng jouse douna-a aoding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Leiset kolmong geija aw khat kitollele ding ahi, ajehchu Pakaiyin nam jouse toh kinelna aneijin, aman tahsa hing jouse thu atanna, migiloute jouse chemhema apehdoh ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="32" style="v" />Janel Pakaiyin hitin aseije, vetan, setna chu nam khatna kona nam khatna kitollele ding, chule leiset kolmonga kona chimpei nasatah hungnung ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule chuche ni-a Pakai mitha chu leiset kolmong langkhatna pat langkhat gei hiding ahin, amaho chu kilunghempi louding, kichom khom lou dingu, vui jong kivui louding, amaho leichunga eh-a pangdiu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangho kelngoiching ho pengun lang kapmun, nangho kelngoihon lah-a pipuiho vut lah-a kilih leuvin, ajehchu nakithana diule naki thecheh na diu nikho abulhing tai. Chule dei umtah um le bel banga nalhahmang diu ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kelngoichingpan jamna ding ahetlou ding, kelngoihon lah-a pipuipan jong hoidohna ding aneilou ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kelngoiching ho ka awgin le, kelngoihon pipuipa pen awgin kija ding ahi. Ajehchu Pakaiyin ahamhing jouse asuhmang pehtai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule tijat umtah Pakai lungsat jeh-in mongtah-a chennaho akisumang tai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman keipibahkai chal bangin akiselna adalhatai. Ajehchu suhgentheina tijat umjehle, alungsatna tijat umtah jeh-in gamsung chu akamheltai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengpa Josiah chapa Jehoiakim lengchan kipat in, Pakaiya konin hiche thuhi ahung lhungin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin hitin aseije, Pakai houin leitola dingin lang, Pakai insunga chibai boh-a hung, Judah khopiho jouse jah-a, ajah uva sei dinga kathupeh thujouse chu cheng khatcha lhajah louvin seijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiti achu amahon angaijuva, alampi phalouva kona amitakip akileheijule, amaho thilse bol jeh-a achunguva bol dinga kagotsa thilse akona kalung kisih thei ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nangin ajah uva, Pakaiyin hitin ati, nanghon namasanguva kakoi kadanthupeh najuidinguva;
  </para>
  <para style="p">
    <verse number="5" style="v" />naheng uva kahinsol kasohte themgaoho, matah-a thouva hungkisol ho thuho ngai ding golouva nadon daole,
  </para>
  <para style="p">
    <verse number="6" style="v" />chuteng hiche inhi Shiloh kabahsah-a, leiset nam jouse gaosap kahisah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun thempuho le themgaoho chule mijousen Pakai insunga Jeremiah thusei chu ajataove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun ahitin ahi, mipi ho jouse henga sei dinga Pakaiyin athupeh Jeremiah in aseichai phatnin, thempuho le themgaoho, chule mijouse chun ama chu amanun, nathitei ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ibola nangma Pakai mina nagao chana, hiche inhi Shiloh bang ding, chule hiche khopiho chenna louva kamhel ding ahi natiham? atiuve. Chuin mipi ho chu Pakai insunga chun Jeremiah dounan akikhom taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Judah milenhon hiche thu chu ajah phatnun, leng ina konin Pakai ina ahung touvun, Pakai in lutna kotpi thah-a chun atoutaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin thempuho le themgaoho, milenhole mipi jouse jah-a chun, hichepahi thi dinga lom ahi. Ajehchu nanghon nanauva najah bangu chun hiche khopi dounan gaothu aseije, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jeremiah in milenho jousele mipi jouse jah-a, Pakaiyin hiche inle hiche khopi douna-a nanghon najah-u thu jousehi gao dinga eihinsol ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun tun nalampiule nathil bolu kisem phatnun lang, Pakai na-Pathen'u thu ngaijun, chutile Pakaiyin nangho douna-a thilse aphondohsa chu alung kisih kit ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keidin vang, veuvin, nakhut uva um kahi. Pha nasah bangule nadei bangun neibol taovin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla kichentah-in heuvin, keima neithauva ahile nanghotah leh hiche khopi chule asunga chengho chungahi setnabei thisan nakipohlut teidiu ahi. Ajehchu hiche thu jouse naheng uva sei dinga Pakaiyin eihinsol tahmong ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chujouvin milenhole mipi jousen thempuho le themgaoho henga chun, hichepahi thi dinga lom ahipoi. Ajehchu aman ihenguva Pakai i-Pathen'u mina thu asei ahi, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin gamsunga upa phabep akipatdoh- un, mipi akikhomho jouse henga chun aseijun,
  </para>
  <para style="p">
    <verse number="18" style="v" />Judah lengpa Hezekiah nikho laijin Morasthih mi Micah anagao changin, Judah mite jouse jah-a janel Pakaiyin hitin anati, Zion chu lou banga kikaija, Jerusalem chu alhuh-a umding, chule insahna mol chu gammang munsang bang ding ahi, anatin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Judah lengpa Hezekiah le Judah mijouse chun anatha beh monguvem? Aman Pakai agingin, Pakai chu angeh in, Pakaiyin amaho douna-a thilse anaphondohsa chu alung kisih kit hilouham? Hiti achu ihinnao douna-a thil setah ikilhut khumdiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Kirjath-jearim mi, Shemaiah chapa Urijah kiti mi khat jong Pakai minin anagaovin, aman hiche khopi dounale hiche gam douna in, Jeremiah thusei dungjuijin anagaovin:
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jehoiakim lengpan, agal hat ho jousele milenho jousen ajah phatnun, lengpan ama chu thadin aholtai. Ahinla Urijah in hichu ajah phatnin, akichatan, ajamin Egypt gama achetai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Jehoiakim lengpan Achbor chapa amin Elnathan chu mi phabep khatto Egypt gama chun asolin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Urijah chu Egypt gama konin agamandoh-un, Jehoiakim lengpa henga ahinpuijun, aman chemjamin athatnin milhamho lhan sunga athilong chu asepluttai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahijengvangin amahon ama chu mipi khutna tha dinga apehdoh louna dingun Shaphan chapa Ahikam khut chun Jeremiah chu aumpin ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah leng Josiah chapa Jehoiakim lengchan kipat in Pakaiya konin Jeremiah henga hiche thuhi ahung lhungin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin kahenga hitin aseije, namkoljon kisemin lang nangonga kivonlang,
  </para>
  <para style="p">
    <verse number="3" style="v" />hiho chu Edom lengpa, Moab lengpa, Ammon lengpa, Tyre lengpa, Zidon lengpa henga, Jerusalem'a Judah lengpa Zedekiah henga palai hungjiho khutna gahthot temin,
  </para>
  <para style="p">
    <verse number="4" style="v" />chule apakaiteu henga asei diuvin thu pen, janel Pakai Israelte Pathen'in hitin aseije, tia apakaiteu henga nasei diu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman kathilboltheina nasatahle kaban lhang doh-a, leiset chule achunga um mihemle ganhinghohi kasema, hichu pha kasahsah kapehji ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule tuahi keiman hiche gamhohi kasohpa Babylon leng Nebuchadnezzar khutna kapehdoh ahitai. Chule gamlah-a, ganhingho jong ama jen dinga kapehtha ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule ama gam mongmong chu ahunglhun kahsen nam jousen ama, achapa, achapa chapa ajen diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hung hiti ding ahi, Babylon lengpa Nebuchadnezzar jen nomlou chuche namle lenggam, chule Babylon lengpa namkoljon noija angong donomlou, chuche nam chu chemjam'a, kela, hise-a, ama khutna chu kasuh manghel kahse-a talen kapeh ding ahi, tin Pakaiyin aseijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun nathemgao hou, na-aisan hou, namang neihou, ailhim themho, doithemho, naheng uva Babylon lengpa najen lou diu ahi, tiho thu ngaihih-un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu amahon, nagam uva kona gamlatah-a nakichona diu, kanomangna diu, namanthaina diuva thujouva gaova ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla Babylon lengpa namkoljon noija angong do-a, jenho chu, agamuva kaumden sah-a, aleisetnu akilhouva, chengden diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche thuho jouse banghin Judah lengpa Zedekiah henga jong kaseijin, Babylon lengpa namkoljon noija na-ngong donlang amale amite jenin lang, hingin tin kaseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Babylon lengpa jen nomlou nam douna-a Pakaiyin anasei chemjam, kel, chule hise-a kona nanghole namite ibola nathi jeng diuham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun, Babylon lengpa najen lou diu ahi, tia themgaoho thusei chu ngaihih-un, ajehchu amahon naheng uva jouva gao ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu keiman amaho kasolpoi, tin Pakaiyin aseije; ahijengvangin amahon kaminin, nangho kanomang theina dingule namanthah theina dinguva, nanghole naheng uva gaochangho, namanthah theina dinguva jouthu-a gaochang ahiuve, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman thempuho le hiche miteho jouse henga jong kaseijin Pakaiyin hitin ati, veuvin, Pakai ina umle belho chu Babylon'a kona hung kiletol vahding ahitai, tia gaova themgaoho thu ngaihih-un, amaho thujouva gao ahitaove, kati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho thu ngaihih-un, Babylon lengpa jenun lang, hinguvin, ibola hiche khopi kamhela umding ham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla amaho themgao ahiuve, Pakai thu amaho-a auma ahile, janel Pakai henga tuhin Pakai ina kidalha umle bel ho, chule Judah lengpa insungale Jerusalem'a ho Babylon'a akitol louna dingin, tuhin taovuhen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu khomho, twikongho, akitun naho, chule hiche khopi sunga um le bel amoh kidalha ho chungchang thu chu janel Pakaiyin aseijin;
  </para>
  <para style="p">
    <verse number="20" style="v" />Babylon lengpa Nebuchadnezzar'in, Jerusalem'a kona Babylon gamgeija Judah lengpa Jehoiakim chapa Jeconiah le Jerusalem'a umle bel ho, milenho jouse gal hinga akai laija anapoh lou ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakai ina kidalha, Judah lengpa inle Jerusalem'a umle bel ho chungchang thu chu janel Pakai Israel Pathen'in hitin aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitiho chu Babylon'a kipoding, keiman amaho kavil kahse-a, chuachu umdiu ahi, tin Pakai chun aseije; chujoule keiman kale poh-a hiche munahi avela kakoi kitding ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Judah lengpa Zedekiah lengchan kipat, kum mama chun ahitin ahi, akumlina lha nga lhina-a chun, Gibeon'a mi Azur chapa Hananiah themgao chun, Pakai insunga thempuho le mipi ho angsung tah-a kahenga thu aseijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Janel Pakai Israel Pathen'in hitihin aseije, keiman Babylon lengpa namkoljon kasubong tai, atie ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Babylon lengpa Nebuchadnezzar'in hiche mun'a kona alahdoh-a, Babylon'a apoh Pakai ina umle belho jouse chu, kumni lhin sunga hiche munahi kahin pohlut kit ding ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima Judah leng Jehoiakim chapa Jeconiah le Judah mi sohchang jouse Babylon'a cheho chu, hiche munahi kahin puikit ding ahi, tin Pakaiyin aseije, ajehchu Babylon lengpa namkoljon kaheboh ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jeremiah themgaovin Hananiah themgao henga chun themgaoho le Pakai insunga ding mipi jouse mitmu tah in aseijin:
  </para>
  <para style="p">
    <verse number="6" style="v" />Jeremiah themgao tahchun, hihen, Pakaiyin chutin bolhen, Pakai ina umle belhole gal hinga kikai jouse chu, Babylon'a kona hiche mun'a hinlelhut kit dinga nagaona thu chu Pakaiyin molsohen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijongle tu-a hiche nangle mijouse nakhanga jah dinga kaseihi ngaitemin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangle kei masanga themgao luiho chun, gam tamtah le lenggam tamtah douna thule thilse chule hise thu anagao jiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Themgao chamna thu gaopa chu, chuche themgaovin asei chu aguilhun tengle, themgaopa chu Pakai hinsol tahbeh ahi akihejie, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Hananiah themgaovin Jeremiah themgao ngonga kona namkoljon chu alan, ahehbongtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Hananiah-in mijouse anga chun, Pakaiyin hitin aseije, Babylon lengpa Nebuchadnezzar namkoljon chu nam jouse ngonga kona kumni lhingset sunga hiche bang ngeijahi kasuhboh ding ahi ati. Chuin Jeremiah themgao chu alampia akichetai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jeremiah themgao ngonga namkoljon chu Hananiah themgaovin aheboh jouvin Jeremiah themgao henga Pakai thu chu ahung lhungin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chenlang Hananiah gahilin, Pakaiyin hitin aseije. Nangman thing namkol ho chubou naheboh ahin, hicheho khela chu keiman thih namkol kahin semdoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu janel Pakai Israel Pathen'in hitin aseije. Amahon Babylon lengpa Nebuchadnezzar kin aboltheina diuva hiche namho jouse ngonga thih namkoljon hi kabucheh ahitai. Amahon ajencheh diu ahi, gamsa jouse jong kapeh ahitai, ati ahungtin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jeremiah themgaovin Hananiah themgao henga, ngaijin tun Hananiah, Pakaiyin nang nasolpoi, nangin hiche mitehohi jou khat natahsan sah ahibouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun Pakaiyin hitin ati, vetan, leiset chunga kona kapaidoh ding nahi: Pakai douna-a douna thu nahil jeh-in, tukuma nathitei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitichun Hananiah themgao chu chuche kum mama lha sagina in athitan ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Nebuchadnezzar'in Babylon gama gal hing akaimangho, sohchang upaho, thempuho, themgaoho chule mipi ho jouse henga Jeremiah themgaovin Jerusalem'a kon lekha athot thuchengho chu hichehohi ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />(Jeconiah lengpa le lengnu, nukiso ho, Judah le Jerusalem'a milenho, thingthemho, thih suho, Jerusalem adalhah nungu chun):
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaphan chapa Elasah, Hilkiah chapa Gemariah khutna lekha chu apohsah-in ahi (amani chu Judah lengpa Zedekiah'in Babylon lengpa Nebuchadnezzar henga asol ahin):
  </para>
  <para style="p">
    <verse number="4" style="v" />Janel Pakai Israel Pathen'in Jerusalem'a kona Babylon gama puimanga aumsah, akipuimang sohchangho henga hitin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon in kisah-un lang, hia chun chengun, chule hon kibolun lang aga chu neuvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ji neijun lang chanu chapa hingun, nachapateo jiding puipeh unlang, nachanu teo inneipu ho peovin, chutile chanu chapa hinguntin, hia chun pungun natin kemsuh pouvin nate.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sohchanga kapuimang sahna lama khopi ho-a chun chamna chu holun, chule hiche ding chun Pakai henga taovun, ajehchu chukom cham na-a chu nanghon jong chamna nanei diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu janel Pakai Israel Pathen'in hitin aseije, nalah uva um nathemgao hou le na-aisan hou chu kilheplhah sah hih helun; nahin mangmat diu namang hou jong nahsah hihhelun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu amaho thujouva kamina aisan ahiuvin, amaho kasol ahipouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu Pakaiyin hitin aseije, Babylon'a kum somsagi alhin jouteng, kahin viluva hiche munahi nahung kilekitna dinguva, nangho dinga kathupha kasuh bulhit ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu nangho dinga kagon chu thilse hilou chamna, khonunga peh dinga kagon chu kahenai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuteng neikouvun natin, kahenga hung taovun natin, keiman sanpeh taovinge.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanghon neiholun natin, nalung pumpi-a neihol tengule neimu diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Namudoh-u hitange, tin Pakaiyin aseije, chule kadel mangnao mun jouse-a konle nam jouse-a konin chomkhom ungting, nasoh chanao kaheimang ding, kasoh chansah naova kona kahin lepui kit ding nahiuve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu nanghon Babylon gama jong Pakaiyin themgao eitundoh peh uve, nati uve.
  </para>
  <para style="p">
    <verse number="16" style="v" />David laltouna-a tou lengpa le hiche khopi sunga cheng mijouse, chule nang hotoh sohchanga chekhom lou nasopiteu Pakai chun hitin aseije, tiuvin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Janel Pakai chun hitin aseije, vetan, amaho chunga chemjam'a, kel lhah-a, chule hise kasola, nehthei hilouhel aphatna phamo theichang banga kasem diu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amaho chu chemjam, kel lhah-a, hise-a kasuhgentheija, leiset lenggam jouse-a chaulele dinga keiman kanochehna nam jouse lah-a chu gaosap dinga, datmo umleh chehsatna, seisetna tohding bepma kapehdoh diu:
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu jingpi-a thouva kisoldoh kasohte themgaoho-a kona ahenguva kathu kathotho chu angaipouve, tin Pakaiyin aseije. Ahinla nangainom pouve, tin Pakai jin aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun Pakai thu chu, nangho Jerusalem'a kona Babylon'a sohchang hon ngaijun,
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel Pathen janel Pakai chun Kolaiah chapa Ahab le Maaseiah chapa Zedekiah kamina jouthu-a gaoho chungchang thua chun hitin aseije, veuvin, Babylon lengpa Nebuchadnezzar khutna amaho chu kapehdoh ding, aman namitmu tah uva atha diu:
  </para>
  <para style="p">
    <verse number="22" style="v" />Amanu thu chu Babylon'a Judah sohchang jousen, Babylon lengpan meija asahgop Zedekiah le Ahab bang helin Pakaiyin nachunga bolhen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Israel gama setkhona hel amahon abolun, aheng akom jiteutoh ajongun, kathupeh louva kamina jou asei jeh-un, keima ngei ahe ale hettohsah kahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nehelam mite le Shemaiah henga jong hiti ahi nasei ding ahi, atin:
  </para>
  <para style="p">
    <verse number="25" style="v" />Janel Pakai Israel Pathen'in hitin aseije, ajehchu nangin Jerusalem'a um mijouse hengale Maaseiah chapa Zephaniah thempu chule thempu jouse henga naminin lekha nathotnin hitin naseije.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakaiyin Jehoiada thempu khelin thempun napansahtan, Pakai insunga vaipole-a pang ding nahin, ngolla kithemput sah tapou chu songkul'a nakhuma nahen ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun tun ibola amale ama neheng uva kithemput sah Anathoth mi Jeremiah chu napholou ham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu Babylon gama kahenguva sohchana hi asotnin, in kisah unlang asunga chengun, hon kibolun lang aga neuvin, tin thu eihin thotnuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Jephaniah thempun Jeremiah themgao jahdia lekhathot chu asime.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Pakai thu chu Jeremiah henga ahung lhungin, aseije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sohchangho jouse henga chun Nehelam mi Shemaiah thudol chu Pakaiyin hitin aseije, Shemaiah'in kasol louva naheng uva jouthu natahsan sah jeh uvin:
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun Pakaiyin hitin aseije, veuvin, keiman Nehelam mi Shemaiah le achilhah ho talen kapeh-a, hiche mite lah-a cheng ding khatcha aneilou ding, kamite dinga thilpha kabol ding jong chu amulou ding ahi, tin Pakai chun aseije. Ajehchu aman Pakai dounan thu anahilin ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jeremiah henga Pakaiya kona thu hunglhung chu,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai Israel Pathen chun hitin aseije, nahenga kathusei jouse chu lekhabu khatna sunin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vetan, nikhoho chu ahung lhunge, tin Pakaiyin aseije, kamite Israel le Judah sohchangho chu kalepui kit ding ahi, tin Pakaiyin ati. Apateu kapehna gama kakilesah kitna hichu alo dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichehohi Israel le Judah chungchanga Pakai thusei chu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Pakaiyin hitin aseije, keihon chamna thu hilou tijatna, awgin kithing selsul khat kajauve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dong leuvin lang veleuvin, pasal'in nao avop ngaijem? I-atile pasal tapouvin numei naosonat thoh banga atai akisot cheh uva, amaiju dangdih deh-a sohdoh gama hitam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ohe, hiche nichu aloupi lheh-in, hitichun akibahpi aumpon, hichu Jacob hesoh phattah chu ahin, ahinla hichea kona chu ama huhdoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu hiche ni chule hiti ding ahi, nangonga kona namkoljon chu kaheboh-a, ahennaho kasuhtan ding, chule gamdang min amaho soh-a aneitah lou diu ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla Pakai a-Pathen'ule, katundohpeh ding alengpao David ajenjoh diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun Vo kasoh Jacob, kicha hih-in, chule vo Israel, lungthoi hih-in, ajehchu ven gamlatah-a kona nangmale nachilhahte kahuhdoh ding, Jacob chu hungkile kitna koimachan akichatsah lou ding ahitai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu nahuhhing dingin kaumpi jinge, tin Pakaiyin aseije: nangho kathecheh nao nam jouse akichainao boljong leng nangho kichaina vang bolhih laijing ting atin, ahinla thutah-a kasuhdih ding nahin, hijongle talen pelouva kalhadoh louhel ding nahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakaiyin hitin aseije, nakimavona chu damdoh theilou namaput chu nase behset ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nakikanchah theina din nathu seilhap pehdinga khatcha aumpoi, damna ding lou nanei hihhele.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangailu jousen nasumil tan, nadon tapouve; nakhangitlouna atam behset jeh le nachonsetna punbe jing jeh-in, melma kimavona in kamavon, mi engse gimbolna in kagimboltai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ibola nagim jeh-a kap nahim? nakhangit louna tambehset jeh-a, nalungkham nachu suhdam theihoi hilou ahitai. Nachonsetna apun jeh-a hichehi kabol ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh achu nabahgamho jouse chu kibahgama, nakidoupi jouse khat khatna sohchanga chediu, chule nachomgam ho kichomgama, anchah-a nanei jouse chu anchah-a kapehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu nachunga damna kalhunsah kitna, namaha ho kadamsah ding ahi, tin Pakaiyin aseije. Ajehchu amahon nangma akinodoh ahi nati uvin, hichehi koimachan adonlou Zion chu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakaiyin hitin ati, Ven keiman Jacob ponbuh sohchangsa chu kahin puikitna, achenna mun'a kahepi ding, akisetvumna chunga chu khopi chu kasahdoh-a, leng inpi chu aumdan bang banga umkit ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho-a kon chun thangvahnale kipana husa gingdoh-in tin, amaho chu punsah ingting, lhomcha hilou diu, loujong loupisah ingting, neocha hilou diu ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Achateu jong masanga bangin umuntin, akikhopnao kiphutdet ding, chule amaho sugenthei hojouse talen kapeh ding ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amilunhou chu amaho-a kontah hiuvintin, avaipopau chu amaho lah-a hung hiding, ama chu kinaisah ingting, aman eihin naija hung lutngam jengthei ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuteng nangho kamite nahiuva, keima na-Pathen'u kahi ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ngaijun Pakai lungsatna huipi, tanglouva nungjing huipi chu ahung nunge, hichun migiloute luchang asuhnat ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichu abolchai kahsehle alunggot phalou chu amolso kahse-a, Pakai lungsat tijat umtah chu dailha louhel ding ahi. Ninunung lamteng hin ngaito taovinate.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche phat tah chule, keihi Israel pumpi Pathen hingting, amaho jong kamite hitaovinte, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel choldosah dia kachelaitah chun, chemjam'a thimoh hochun, gamthipma lungsetna akimutaove, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masangin Pakai kahenga akilah-in, hitin aseije, keiman nangma tonsot lungsetna-in kalungsetnin: hijeh chun lainatna-in kakaile jinge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo nungah theng Israel, keiman nasaphang ting sahphat nahi ding ahitai: na cha'ngeng ho-a nakijephoi kitna, kipah thanop bolho lamna-a nachedoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Samaria molsangho chunga lengpigui nakiphuna laija aphuthon aphuva, agachu aneh diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Ephraim mol chunga khongah hon, nangho kipat un Pakai i-Pathen'u heng, Zion'a chetou vuhite, tia asapna diu nikho khat hungum ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin hitin aseije, Jacob din kipah-in la saovin lang, namtin haosaho lah-a aodoh-un: phongjalun, vahchoijun lang, Vo Pakai, Israel amoh umsun namitehi huhdoh-in, tiuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Veuvin, sahlam gama konin hinpuijing ting, leiset kolmonga konin khoming ting, alah uva chun mitcho elbai, numei naovop, numei naoso natna na, mihon atama tam hung kilekhom diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kappum pumin hunguntin, kalhep lhepma kapui ding, vadunglen twilah lamdih tah-a chesah ungting, hia chu kipalhu loudiu ahi. Ajehchu keima Israel pa kahin Ephraim chu kachapa lenpen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo nangho namtinho, Pakai thusei ngaijun lang, twikol gam gamlatah-a phongjalun, Israel thechehpa chun achopkhom kitna, kelngoi chingpa banga amaho chu achin ding ahitai, tin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Pakaiyin Jacob alhatdoh-in, asanga hatjopa khutna konin alhatdohtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh achu hunguva Zion chungvuma la ahinsah diu, Pakai phatna, suhlouchang, lengpitwi, thaotwi, kelngoihon noutele ganchahon noute chunga kipah uva, ahinkhou chu hon twi kichapnou jing bang hiuva, lunghem kit talou hel ding ahitaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuteng nungah theng chu gollhanghole tehse ho toh lamna-a kipah khomdiu ahi. Ajehchu alunghem nao kipana-a kaheidoh-a, kalhamona, alunghem naova kona kakipasah ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thempuho hinna chu tahsa damtheina-a kalunglhai sah-a, kamite chu kaphatna-a lunglhai diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakaiyin hitin ati, Ramah-a lunghemnale nasatah-a kana awgin akijai, Rachel'in achate aka akan, aumlou jeh uvin lhepbi ding anomtapon ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakaiyin hitin aseije, naka awginle namitlhi lonna-a konin haijin, ajehchu nathilbol kipaman umding ahi, tin Pakaiyin aseije, chule amaho amelmate gama kona hung kilekit diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nakhonung ding thua kinepna aume, tin Pakaiyin aseije, chutia chu nachate agamsung lamuva hungkit teidiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman Ephraim kagin kaja monge, nangin neiseh gimin, bongchal namkoljon pokhalou bangin neiseh gimtai. Nei lehei lechun kihei kit tange, ajehchu Pakai ka Pathen nahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tahbeh-in kakilehei nungin kakisih tai. Eikihil nungin kapheipi kabengin, kajah achan, kaneo laija minsetna chu kapohjing jeh-in, kakisudong heltai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim kachapa deitah ham? Ama kalungtoh kacha ham? Ajehchu ama douna-a thu kasei chanin lungset tah-in kageldoh jing nalaije, hijeh chun ama dingin kasung akithingin, ama kahepi mongding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lampi melchihna kisemin lang, sangtah-in kiset vumin, nagachena lampi, lamlhongpi lam geljingin, Vo nungah theng Israel, hung kihei kitnin, hiche nakhopi lama hung kiheijin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vo nang chanu nungchonnu, itihchan navale ding ham? Pakaiyin leisetna thilthah khat asemin, numei jin pasal adei ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Janel Pakai Israel Pathen'in hitin aseije, asohchan naova kona kalepui kit tengle, Judah gamle akhopiho-a chu hitobang kamso, Vo thudihtah chenna, Vo thenna mol, Pakaiyin phatthei boh-in, tihi amankit diu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuachu Judah tele akhopi jouse-a mite, loubol mihole kelngoihon vahho chengkhom diu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu cholte kavahva-in, lungkhamte kahaldohsah tai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche thua hin kahung khangin, kavelen, chule ka-imut chu anomlheh-e.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vetan, Israel insungle Judah insunga mihem muchile sahem muchi katuna ding nikho chu ahung lhunge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule hiti ding ahi, amaho botdoh-a, subonga, pailha-a, sumanga chule suhgenthei dinga kachan jing bangahi, sadoh dingle phutpha dinga kachan jing ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiche nichule paten lengpiga thuh aneuvin, chate ha ajatai atikit louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla amitakip ama amacheh khangitlouna-a thia, lengpi ga thuh nechan chu, ama hacheh jading ahitai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vetan, Israel insungle Judah insungtoh thulhun thah khat kasemna ding nikho ahung lhunge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="32" style="v" />Keima amaho dinga ajipau hijongleng, apateu Egypt gama kona puidoh dinga akhutnuva kakai ni-a thulhun kanasem asuhkeh-u tobang chu hilou ding ahitai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahinla chuche nikhoho jouva Israel insungtoh thulhun kasem ding chu hichehi ahi, tin Pakaiyin aseije. Asunguva kadanthupeh koijing ting, alungsung uva kasutlut ding, chule a-Pathen'u kahia, amaho kamite hidiu ahitai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule koimachan aheng akomle asopi takip jah-a Pakai chu hen, atilou diu ahitai. Ajehchu aneopena pat alenpen geija eihet soh hel diu ahitai, tin Pakaiyin aseije. Ajehchu akhangit lounao kangaidam-a, achonsetnao kageldoh kit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Suna vahdinga nisa pe-a, jana vahdinga lhathahle ahsi ho vahding dan sempeh-a pepa, twipi kinong ginglul lula homkhenpa, Pakai chun hitin aseije, janel Pakai chu amin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hiche danho chu kamasanga keija kona achemangle, Israel chilhah jong namkhat ahina-a kona, a-itih-a dinga kamasanga beihel ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pakaiyin hitin aseije, chunga van khu akite theija, noija leiset kingapna hohi holdoh thei ahilebou, kenjong Israel chilhah jousehi, athilbolhou jouse jeh-a kapaidoh diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="38" style="v" />Vetan, Hananeel insanga patna kul ning kotpi geija Pakai khopi kisahdohna ding nikho chu ahung lhunge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule thil tena khao chu Gareb lhangchung jona kilhung jangpetna chule Goath akolkhum ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Thilonghole vut kinotna damphai pumpile Kidron luipi gei loujao jouse, solam sanga sakol kotpi, ning geija chu Pakai dinga atheng hiding ahin, a-imatih-a kibotdoh-a kiseplha kit louhel ding ahitai.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengpa Zedekiah lengchan kum som lhin kum, hichu Nebuchadnezzar lengchan kal kum somle kum get lhin kum chun, Jeremiah henga Pakaiya konin thu ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu hichelai chun Babylon lengpa sepaihon Jerusalem aumkulun, Jeremiah chu Judah lengpa inhong sunga, mihenna ina akulkhupmun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Judah lengpa Zedekiah chun ama chu ahentupma hitia asei ahi, ibola nangman gaothu naseija, Pakaiyin hitin aseije, Veuvin, keiman hiche khopihi Babylon lengpa khutna kapeh-a, aman ahinlah ding ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Judah leng Zedekiah chu Chaldea miho khutna kona hoidoh lou ding, Babylon lengpa khutna kapehdoh joh-a, akamtah-a akihoupia, amitnin ama mit avet ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Zedekiah chu Babylon'a apuija, keiman kavil kahse-a chu umding ahi, tin Pakaiyin aseije. Chaldea miho chu kisatpi jongleu chun lolhing pouvinte, tin Pakaiyin aseije, tia naseiham? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Jeremiah chun Pakai thu chu kahenga ahung lhungin hitihin aseije, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vetan, napangah Shallum chapa Hanameel nahenga hungintin, Anathoth'a um kalou kichoh-in, ajehchu chohna ding lhatdohna thahat naneije ati ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun kapangahpa chapa Hanameel chu, Pakai thu dungjuijin kihenna hongsunga kahenga ahungin, kajah-a aseije, Benjamin gama Anathoth a kalou chu goulo thei nahijeh-a nalhatdoh ding ahi, nang dingin kichoh-in, ati. Hichun hichehi Pakai thu ahi kahetai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin kapangahpa chapa Hanameel lou, Anathoth a um chu kachon, sumchu katepeh-in dangka shekel somlesagi jen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin lekha kajih-in kamin kasunin, namdet kanamun ahetoh kakouvin, sumchu agihdan katepehtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin kichohna lekha chu chondanle angai dungjuijin, akichohdan kisutna namdet kinamsa lekha chu kaladoh-in hichu akiphong dohsa ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin kichohna lekhabu chu Maaseiah chapa Neriah chapa Baruch chu, kapangahpa chapa Hanameel mitmule akichohna-a minchong ahettohho mitmun chule kihenna hongsunga tou Judah te jouse anga chun kapetan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amasanguva Baruch chu thu kapen,
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel Pathen janel Pakaiyin hitin aseije, hiche kichohna lekha, sinkhana kinamle kichohna lekha kihonghi akopmin lanlang, sottah aumtheina dingin leibel sung khatna koijin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu janel Pakai Israel Pathen'in hitin ati, hiche gama inho, louho, lengpilei ho hi hinkilo kit ding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun kichohna lekha chu Neriah chapa Baruch kapeh phatnin Pakai henga kataovin,
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo Pakai Pathen, vetan, nathilboltheina nasatahle naban jahdoh-in, leile van nasemin, nangma dingin ahahsa ima aumpoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Asang asang henga lungset le khotona namusah-in, chule pate khangitlouna chu anunguva achateu chunga nalethuh jin: Loupitah, Pathen Hattah, janel Pakai chu amin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thumop themtah, thilbol hattah, mihem chapate jouse atoh dunjui cheh-a lethuhna pedinga alamlhah jouseu vejing nahi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Egypt gama melchihna le datmo bola, tuni geija Israel le midangho lah-a boljom jinga, tunia bang banga min khat hin kiboldoh-a,
  </para>
  <para style="p">
    <verse number="21" style="v" />Egypt gama kona nami Israelte melchihna hole datmoho-a, khut thahattahle banjahdoh-a, chule tijatna nasatah puma hinpuidoh-a,
  </para>
  <para style="p">
    <verse number="22" style="v" />hiche khoijule bongnoi lonna gam, apateu pehdinga anakihahsela, amaho anapepa,
  </para>
  <para style="p">
    <verse number="23" style="v" />chuin ahung lutnun alotauve, ahinla nathu angai hih-un, nadanthupeh-a jong achonpouve. Aboldiuva napeh jouse khatcha abolpouve. Hijeh achu hiche thilse jousehi achunguva nalhunsah ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mol ho khu vetemin, khopi lodingin amaho ahungtaove, chemjamle kellhah, chule hise jeh-in, galla hinsatna Chaldea mite khutna khopihi pehdoh-in anaumtan, naseisa chu aguilhung tai, vetan, nangin namun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Vo Pakai Pathen, nangin kahenga, lou chu sumin kichoh inlang, khopihi Chaldea mite akipehdohtah jeh-in, ahetoh ding mi kikoijin, natin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakai thu chu Jeremiah henga ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="27" style="v" />Ven, keima Pakai tahsahing jouse Pathen kahi, keima dinga thil hahsa behseh ipi umam? ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun Pakaiyin hitin aseije, vetan, hiche khopihi Chaldea mite khutna, Babylon lengpa Nebuchadnezzar khutna pengting, aman alah ding ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule hiche khopi hinsat Chaldea mite chu hunguntin, hiche khopihi ahal uva, lunghansahna dinga eiphinset nao, Baal dinga gimnamtui ahalnau, inchunghole Pathen dang dinga don thilpeh asunlhah nao chu akahvam gamding ahitai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajehchu Israel chatele Judah chaten aneulaijuva pat kamasanga thilse jengbou aboluve. Ajehchu Israel chaten akhutnuva athilbol jaluvin eiphin lunghang jinguve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu hiche khopihi asahdoh uva pat tuni geija kalunghana le kalungsatna dinga phinsetna khopi anahin, kamasanga kona kachon mang ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel chatele Judah chate amaho, alengteu, amilenhou, athempuhou, athemgaohou, chule Judah mihole Jerusalem'a chengten, keima lunghan sah-a phinsetna dinga thilse abol jeh-u ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Matah-a thouva kahil vangin, akihilnao kisanding agelkhoh pouve, anung eingatnun, eimaingat pouve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kamina kivo in chu suhbohna dingin, thet umhou chu atunglut jiuvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amahon Hinnom chapa phaicham, kathupeh louhel kalunga jong chengkhalou, Judah chonsetsah nadingin thil thet umtah abolun, achapateule achanuteu Molech henga meija pehdohna dingin Baal munsang ho asadoh-un ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hijeh chun tuhin Pakai Israelte Pathen'in, hiche khopihi chemjam, kel, hiset jeh-a Babylon lengpa khutna kipedoh ahitai, natiu thudola chun hitin aseije,
  </para>
  <para style="p">
    <verse number="37" style="v" />Vetan, keiman amahohi kalungnatna, kalungsatna, kalunghana nasatah jeh-a, kana nomangna gamtina kona kakhop khom kitna, hiche munahi kahinpui kitna, mongtah-a kachensah ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule amaho kamite hiuva, Keima a-Pathen'u kahi ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Keiman amahole amaho nunga achateu phatna dinga, a-itih-a eigin theina diuva lungthim khatle lampi khatseh kapeh diu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule amaho phatna ding kabolpeh-a kona kakiheimang louna dinga, amahotoh tonsot thulhuhna kasemdoh-a, amaho keija kona akiheimang louna diuva, alung sunguva eikichatnao kakhum peh dingu ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahi, aphatnao bolpeh chu kakipana lam hintin, kalung pumpile kahinna pumpi-a hiche gamhi kaphudet mongding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ajehchu Pakaiyin hitin aseije, hiche mite chunga thilse nasatah jouse kahin pohlut khum bangahi, amaho kanateppeh thilpha jouse chu kahin pohlut peh ding ahiuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nanghon mihemle ganhing beina gamgo hi, Chaldea mite khutna kipedoh ahitai, tia nasei laiju gamho chu kichodoh soh ding ahitai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Benjamin gamle Jerusalem khopi vel munho-a, chule Judah khopiho-a, lhang gama khopiho-a, chule phaicham khopiho-a louho chu mihon suma achoh uva, kichohna lekha asutnuva, namdet anamuva, hettohsah ho akoicheh diu ahi. Ajehchu keiman asohchannau chu kakilesah kit ding ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvalin kihenna hongsunga akulkhup laijun Jeremiah henga, Pakai thu chu aniveina in ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Leiset hinsempa, ijakai hingong tohpa Pakai chun hitin aseije, Pakai kiti chu ama min ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Neihin kouvin, keiman donbut-ing ting, nahetkhah louvu thil lentahle loupitah vetsah inge,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu molhole chemjam'a kisuchim hiche khopi inhole Judah lengte inho chungchang thudol chu Pakai Israel Pathen'in hitin aseije,
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho Chaldea mite toh kisat dingin ahungun, ahinla kalungnatnale kalungsatna-a kathagam thilongho chun adipjoh dingu, chule agitlounahou jouse jeh-a hiche khopi-a kona kamai kasel ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vetemin, damtheina le damdohna hinpong ting, amaho damsah ingting, chamnale thudih lhingset kamusah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman Jadah le Israel sohchana chu kinunglesah ingting, amasa-a banga kasahphat kitding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keima douna-a achonsetnao, athemo nao jouse-a konin thensah ingting, akhangit lounao jouse kachunga achonsetnao leh kachunga asuhkhelnau jouse ngaidam tange.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche khopihi leiset nam jouse, adiuva kabolphat jouse muho masanga chu, kei dinga kipanale vahchoina, chule loupina hintin, phatnale khantouna kalhunsah jouse jala kicha-a kithing thing diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakaiyin hitin aseije, hiche mun, nanghon mile sa umlouna ahomkeo ahi natinao mun Judah khopihole Jerusalem khosung lamlen mile sa, acheng beina natiu mun ahi,
  </para>
  <para style="p">
    <verse number="11" style="v" />thanopnale kipana aw, moulangle mounu aw, janel Pakai chu vahchoijun tia aseidiu aw, ajehchu Pakai chu aphan, ahepina itih-in aumjinge, chule Pakai in'a vahchoina ganlhaina hinchoiho hugin kija kit ding ahi. Ajehchu masanga banga, gamsunga sohchangho chu kakinungle sah ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Janel Pakaiyin hitin aseije, mile sa umlouna gamgoh, hiche munahi, chule chuche khopiho jouse sung chu, kelngoihon ho kolsah nale kelngoiching ho chenna mun hung hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mola khopiho-a, phaicham khopiho-a, lhanglam khopiho-a, Benjamin gamsunga, Jerusalem kimvel munho-a, Judah khopiho-a chu ahilteu khutnoija kelngoihonho kijotjot jengdiu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vetan, Israel insungle Judah insung chungchanga thilpha kathutep chu kamolso ding ahi, ati nikhoho chu hunglhung ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuche nikhoho-a, chuche phatteng David dinga chonphatna bah kajamdohsah-a, aman gamsunga chu thutannale chonphatna apohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche laichule Judah huhhingin umintin, Jerusalem bitkeija umding ahi; chule akihouna ding min chu Ichon phatnao Pakai kitiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Pakaiyin hitin aseije, Israel insung laltouna-a touding chu David lhasamkha louhel ding ahi,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahiloule thempuho, Levi ho jong kamasanga govam thilto chule anneh thilto le tanglouva ganlhaina bolding lhasamkha louhel ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakai thu chu Jeremiah heng ahung lhungin, aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakaiyin hitin aseije, nanghon sun le jantoh kakitepna nasukeh jou uva chule hiti achu sunle jan aphatcha aumthei louva ahile,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuteng kalhacha David toh kakitepna jong kehthei bouvinte, alaltouna-a touding chapa aneilou ding bou ahin, Levi ho thempuho, kalhachaho toh kakitepna jong chuti ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Van janelpi kisim joulou bangle, twipi neldi kitejoulou banga, kasoh David chilhahle kahenga kinbol jing Levi te chu, hitobanga chu kapunsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chukalvalin Pakai thu chu Jeremiah henga ahung lhungin, aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Insung ni Pakaiyin alhen chu apaidoh geltai, tia hiche miten aseiju chu nangaito khahlouvu ham? Amahon kamite i-sah louvin abolun, chutia chu amaho masanga namkhat hikit louhel diu ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pakaiyin hitin aseije, sun le jantoh kakitepna chu aumdet louva, leile van umding dan kana gontoh lou hile,
  </para>
  <para style="p">
    <verse number="26" style="v" />Jacob chilhahhole kasoh David chu kapaidoh hella, Abraham, Isaac chule Jacob chilhah chunga vaihom ding achilhah khatcha kalhen louding ahi. Ajehchu keiman asohchannau kakinungle sah-a, achunguva hepina kanei ding ahi, ati.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiya kona Jeremiah henga thu hunglhung chu, Babylon lengpa Nebuchadnezzar le asepaite jouse alengvai pohna leiset lenggam jousele amijousen, Jerusalem le khopiho jouse chu asatnun, aseijui.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai, Israel Pathen'in hitin aseije, Judah lengpa Zedekiah henga chenlang hitin gaseijin, vetan, hiche khopihi Babylon lengpa khutna kapeh ding, aman meija ahallhah ding ahi, tin Pakaiyin aseije gatin ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangma akhutna kona nahoidoh louhel ding, nakiman na, ama khutna kipedoh ding nahi, namitnin Babylon lengpa mit chu avetna, aman akamtah-a nakihoupi ding, chule Babylon'a nache ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla Vo, Zedekiah, Judah lengpa, Pakai thusei ngaijin, Pakaiyin nachung thu hitin aseije, chemjam'a nathi lou ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lungmong tah-a nathi ding ahi, namasanga leng masaho, napate gimnamtui ahalpeh banguva, nangma dinga jong gimnamtui ahaluva, ohe hepu atiuva, nakacham diu ahi. Ajehchu keiman thu kaphongdohtai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Jeremiah themgaovin, thujousehi Jerusalem'a um Judah te lengpa Zedekiah henga aseitan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Babylon lengpa sepaihon Jerusalem le Judah khopi aumuva, Lachish le Azekah asat laijuva chu kulpi kikai khum hichengse chu Judah khopiho lah-a umnalai ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zedekiah lengpan Jerusalem'a um mipi jouse toh, jalenna thu phongdoh dinga thulhun asem jouva Pakaiya kona Jeremiah henga thu hunglhung chu hichehi ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitihin mijousen asohnu ham, asohpa ham chu Hebrai numei ham, Hebrai pasal ham ahile lha-ong hen, asopipa Hebrai mi kijensah-a koimacha umlou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun mitinin asohpale asohnu alha-ong ding, koimachan amaho akijensah kit louding ahi, ti ja-a thulhuna-a lut milen ho jousele mipite jouse chun ajuijun, alhadoh taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla khonungin akileheijun, alhadohsao soh pasal hole soh numei ho chu avelin soh na atohsah kitnun, sohpa le sohnu hidingin thununna noija akoitaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun Pakai thu chu Pakaiya konin Jeremiah henga ahung lhungin aseije,
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai Israel Pathen'in hitin aseije, keiman Egypt gama sohchana in'a kona amaho kapuidoh ni chun, napateu toh thulhun kanasemin, hitin kanaseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitihin asopipa, Hebrai mi, ahenga kijohsa, kum gup ama anajensa chu kum sagi kichaile alha-ong ding ahin, chule aman kum gup najen tengle nanga kona nalha ong ding ahi, kanatin: ahinla napateu vin kathu angaihih un, anau jong asungpouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin nangho nahung kiheijun, adih chu nabolun, mitinin asopi henga jalenna naphongun: kamina kivo in'a kamasanga chun kitepna nasem uvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla nakilehei kitnuvin, kamin nasuboh-un, anoptah uva nalha-ong nungun, nasohnule nasohpao chu napuipha kitnun, nasohpaole nasohnu hidingin thununna noija napuilut kitnuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun Pakaiyin hitin aseije, mitinin asopipale aheng akom henga chamlhatna thu phong dingin kathu nangai hih un, veuvin, keiman chemjam'a din, hise-a din, chule kel lhah-a din, chamlhatna kaphong doh-e. Leiset lenggam jouse-a kichonlele dingin semtao vinge, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule keiman thulhun suhkeh-a, kamasanga kitepna asemsao nitlouho chu, bongnou kihapsatna, akah-a mi kijotpai jengtheija uma,
  </para>
  <para style="p">
    <verse number="19" style="v" />bongnou kihapsat kah-a kijotpai Judah milenhole Jerusalem'a milenho, nukiso ho, thempuho, chule gamsung mipite jouse;
  </para>
  <para style="p">
    <verse number="20" style="v" />Keiman amelmateu khutna, chule ahinnao holte khutna amaho chu kapehdoh-a, athilongu chu chunga leng vachate le, leija ganhingho anneh dingbep hiding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Judah lengpa Zedekiah le amilenho chu, amelmateu khutna, ahinnao holte khutna, chule nangho-a kona kinungtol louva Babylon lengpa sepaiho khutna kapehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vetan, keiman thu kapeh-a, amaho chu hiche khopi-a kahin kilesah kit ding ahi, tin Pakaiyin aseije. Amahon hiche khopihi ahinsat naova, alahdiu chule meija ahaldiu, chule keiman Judah khopihohi chenna louva kamhela kalha ding ahi, ati.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengpa Josiah chapa Jehoiakim nikho laija, Pakaiya kona Jeremiah henga thu hung lhung chun hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Rechab mite insunga chenlang, kihoupinlang, Pakai insunga indan khatna amaho chu puilut inlang, lengpitwi donding pen, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Habazziniah chapa, Jeremiah chapa Jaazaniah le asopite, achapate jouse, chule Rechab mite insung pumpi kapuijin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai insung kotngah-a pang Shallum chapa Masseiah indan chunga, milenho indan koma um, Pathen mi Igdaliah chapa, Hanan chapate indan-a kapuilutnin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Rechab mite insung chapate anga chun lengpitwi dimset cheh belhole, khonho katungin, ajah uva, lengpitwi donuvin, kati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla amahon lengpitwi donpou vinge. Ajehchu kapau Rechab chapa Jonadab'in, nanghole nachapa teovin a-itih-a lengpitwi nadon louhel diu,
  </para>
  <para style="p">
    <verse number="7" style="v" />in nasah loudiu, muchi natu loudiu, lengpilei jong nabol louhel diu, imacha nanei loudiu, napennao leisetna nitamtah nachen theina dinguva, nahinkhou lhumkeija pon in'a bou nachen diu ahi, tin thu eipeuve atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keihon kapau Rechab chapa Jonadab'in, kahinkhou lhumkeija, keiho, kajiteu, kachapa teole kachanu teovin lengpitwi don louhel dinga eithupeh-u kanitnun,
  </para>
  <para style="p">
    <verse number="9" style="v" />Kachenna diuvin in jong kakisah pouvin, lengpilei hihen, loumun hihen, muchi hijongle kaneipouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kapau Jonadab eithupeh-u jouse banga kaboluva, kanit uva, pon in'a bou kachenu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla ahitin ahi, Babylon lengpa Nebuchadnezzar gamsunga ahunglut phatnin, Chaldea mihole Syria miho kichat jeh-in, hungun Jerusalem'a cheohite katiuvin, hitia chu Jerusalem'a kachenu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakai thu chu Jeremiah henga ahung lhungin, hitin aseije;
  </para>
  <para style="p">
    <verse number="13" style="v" />Janel Pakai Israel Pathen'in hitin aseije, kathu ngaina dinga kahilna nasan loudiu ham? tin Pakaiyin aseije, tin Judah mitele Jerusalem'a chengho gahilin, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rechab chapa Jonadab thu achate henga apeh, lengpitwi donlou ding chu anitnun, tuni geijin imacha adon hih-un, apau thupeh bou chu anit tup chetnun, ahijengvangin naheng uva thu kaseijin, matah-a kathouvin kahilun, ahinla neingaipeh pouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kalhachate themgaoho chu matah-a thouvin naheng uva kasolin, pasal tapou alamlhah phalouva konin tuhin hung kileuvin lang, nachonnao kisem phatnun, pathen dangho jen dingin anung lejui hih-un, nanghole napu napateu kapeh gamachu nachen diu ahi. Ahinla nanau nasung hih-un, ngai jong neingaipeh pouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Rechab chapa Jonadab chapaten, apau thupeh amaho thu apeh chu anit-uvin, hiche miten vang hin kathusei angai pouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun, Pakai Israel Pathen'in hitin aseije, ahenguva thu kaseija angai louvu, amaho kakouva eidonbut lou jeh-un, vetan, Judah le Jerusalem'a chengho jouse chunga, kaphondohsa thilphalou jouse chu achunguva kahin lhunsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jeremiah chun Rechab insung mite jah-a chun, janel Pakai Israel Pathen'in hitin aseije ati, napau Jonadab thupeh nanit uva, adanho naman uva, aman thu napeh-u jouse dungjuija nabol lun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun janel Pakai Israel Pathen'in hitin aseije, Rechab chapa Jonadab chu a-itih-a kamasanga ding ding mi lhasam louhel ding ahi, ati.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />1 Judah lengpa Josiah chapa Jehoikim lengchankal kumli lhina in ahitin ahi, Pakaiya konin Jeremiah henga hiche thuhi ahung lhungin, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lekhajol bukhat lanlang, nahenga Israel thudol, Judah thudol, chule nam jouse thudol Josiah nikho laija patna tuni geija nahenga kanasei jouse chua chun sunlutnin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Achunguva thilse bol dinga kagot jouse Judah insung miten ajah theina diuva, hiti achu mitin achonphatlou naova kona akiletheijuva, akhangitlou naole achonsetnao kangaidam theina diu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jeremiah chun Neriah chapa Baruch chu akouvin, Baruch chun Pakai thu jouse ahenga anaseisa chu Jeremiah kama konin lekhajol bukhatna ajihlut tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jeremiah chun Baruch chu akouvin, keima kikulkhup kahin, Pakai insunga kache theipon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun chenlang, kakama kona najah Pakai thu lekhajol nasut chu anngol nile, Pakai ina mipi ho jahdin gasim doh-in, akhopiuva kona hungdoh Judah te jouse jahdia nagasim doh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutile ataonao Pakai angsung hung lhungintin, amitakip achonphatlou naova kona hung kilehei thei diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Neriah chapa Baruch chun Jeremiah themgao thupeh jouse bangtah chun, Pakai in'a Pakai lekhabua thu chu asimdohtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Judah leng Josiah chapa Jehoiakim lengchankal kum nga lhina lhako na-in ahitin ahi. Jerusalem'a mijousele Judah khopiho-a kona Jerusalem'a hungho jouse jahdin Pakai masanga, anngol thu aphong taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Baruch in Pakai in'a chun Jeremiah thu chu lekhabua, lekhasun Shaphan chapa Gemariah indan-a, inhong chungnung jo-a, Pakai in kotpithah lutna-a chun, mijouse jahdin asimdohtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaphan chapa Gemariah chapa Michaiah chun, Pakai thu jouse lekhabua kona ajahdoh phatnin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Lengpa insunga lekhasunpa indan sunga chun achesuh-in ahile, vetan hia chun milen jouse lekhasun Elishama tahjong, Shemaiah chapa Delaiah, Achbor chapa Elnathan, Shaphan chapa Gemariah, Hananiah chapa Zedekiah chule milen jouse anatouvun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphatnin Michaiah chun mipi ho jahdinga lekhabu asim, athu jouse chu ajah uva aphongdoh tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun Kushi chapa, Shelamiah chapa, Nethaniah chapa Jehudi chu milenho jousen Baruch henga asolun, mipi jahdinga nasim lekhajol bu chu hinchoi jinlang, hungin, atiuve. Hitichun Neriah chapa Baruch chun lekhajol chu ahenguva ahinchoijin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amahon, tun touvin lang, keiho jahdin hinsimin, atiuve. Hitichun Baruch chun amaho jahdin asimtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun ahitin ahi, amahon thu jouse chu ajah phatnun, amaho khatle khat akicha taovin, Baruch jah-a chun keihon hiche thu jousehi lengpa kaseipeh tei dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amahon Baruch chu adongun hitin aseijuve, hiche thu jousehi akama kona itijong najih ham? neihilun atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Baruch chun, hiche thu jousehi akamin eihilin, lekhatuija lekhabua kasutjeng ahi, tin adonbutne.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin milenho chun Baruch henga, chenlang nangle Jeremiah kisel lhonin, koiman na-umnao hetdahen, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin inhong sunga lengpa henga alut lhonin, lekhajol vang chu lekhasunpa Elishama indan sunga adalha lhonin, thu jouse chu lengpa jahdin ahil lhone.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun lekhajol ladin lengpan Jehudi chu asolin, lekhasunpa Elishama indan-a konin agaladoh tai. Chuin lengpa le lengpa vela ding milenho jah dingin Jehudi chun asimin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun lhako na-in lengpa Phalbi laile aumjina insunga atouvin, amasanga meikhuh-a chun mei akongin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ahitin ahi, Jehudi'n phengthum phengli asimjouvin, chemcha khatnin a-at tanin, thuh-a mei chun akahvamhel kahsen, thuh meija chun asepluttan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla lengpa le akinbolho, hiche thu jouse ngaiho koimacha akicha pouvin, apon bottela jong aumpouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahijengvangin lekhajol chu ahal louna din Elnathan, Delaiah chule Gemariah chun lengpa chu angeh un, ahinla amaho thu angaipehpoi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahin lengpan lekhasun Baruchle Jeremiah themgao mandin, Hammelech chapa Jerahmeel, Azriel chapa Seraiah, Abdeel chapa Shelemiah thu apen, ahinla Pakaiyin amani chu aseltai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin lekhajol le Jeremiah kama kona Baruch in ajih thuho jouse lengpan ahalvam jouvin, Pakai thu chu Jeremiah henga ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lekhajol bu adang lanlang, lekhajol bu masa-a thu jouse, Judah lengpa Jehoiakim ahalvam saho chu jihdoh kitnin ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Judah lengpa Jehoiakim henga chu hiti ahi nasei ding ahi. Pakaiyin hitin aseije, Babylon lengpa chu hungtei ding hiche gamhi asuhmanga, hichea patna chu mile sa kisubei ding ahi, tia kijihna chu, ibola chutobang thu najih ham? natin lekhabujol kisun chu nana halvamtan.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh chun Judah lengpa Jehoiakim thudol chu Pakaiyin hitihin aseije, aman David laltouna-a touding, koimacha aneilou ding, along jong sun nisatah noile jan buhdap lah-a kipaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Akhangit lounao jeh-a, amale achilhah chule asohte talen kapeh-a, amahole Jerusalem'a chengho, chule Judah mite chunga chu, achunguva kaphondohsa anahsah louvu, thilphalou jouse chu kalhunsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Jeremiah chun lekhabujol dang alan Neriah chapa Baruch chu apen, hia chun aman Jeremiah kama kona lekhabu jihsa jouse, Jehoiakim'in meija ahalsa thuho chu ajih-in, chuche tilou jong akibahpi tamtah abelapme.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Josiah chapa Zedekiah chu Babylon lengpa Nebuchadnezzar'in Judah gam lenga anasem Jehoiakim chapa Koniah khelin alengchang tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla ama ahin, asohte ahin, gamsunga mite ahin, Jeremiah themgao kama asei Pakai thuho chu angai pouvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Zedekiah lengpan Shelemiah chapa Jehucal le Maaseiah chapa Zephaniah thempu chu Jeremiah themgao henga Pakai ka Pathen'u henga tuhin neitao peh-un, ti dingin asole.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tun Jeremiah chu mipi ho lah-a chun alutle apotle in ahi. Ajehchu ama songkul'a akhum loulaiju ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pharaoh sepaiho Egypt'a konin ahung kondoh taove; chuin Jerusalem kul-a Chaldea miten amaho thulhut ajah phatnun, Jerusalem adalha taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakai thu chu Jeremiah themgao henga ahung lhungin aseije;
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai Israel Pathen'in hitin aseije, eidop dinga nahinsolpao Judah lengpa henga hitihin seijun, vetan, nahu dinga hungkondoh Pharaoh sepaiho chu, agam lamu Egypt'a kilekit diu ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Chaldea mite hungkit uva, hiche khopihi ahin satnuva, meija ahallhah diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakaiyin hitin ati, Chaldea mite chun eidalhah teidiu ahi, tin nanghole nangho kilhemlha hih-un, nadalhah louhel diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nahin dou uva Chaldea sepai pumpihi satchai jongleu chun, alah uva machang umnalai ho jengjong, apon ina kona kipatdoh uva, hiche khopihi meija ahaldiu ahi, tin seijin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, Pharaoh sepaiho ginna Chaldea sepaiho Jerusalem'a kona akitoldoh phatnun,
  </para>
  <para style="p">
    <verse number="12" style="v" />Jeremiah chu, mipi ho lah-a kona chom umdingin, Jerusalem'a konin apotdoh-in, Benjamin gam lama achetai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Benjamin kotpi agei phatnin, chuche veng lamkai khat, Hananiah chapa, Shelemiah chapa, amin Irijah chu anaumin, ama chun Jeremiah chu amanin, Chaldea miho henga jam nahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jeremiah chun, jou ahi, Chaldea mite henga jammang kahipoi ati. Ahinla aman angaipeh hih-in: hitichun Irijah chun Jeremiah chu amanin, lamkaiho henga apuitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun pipuiho chu Jeremiah chunga analunghang lheh-un, avouvin, lekhasun Jonathan insunga songkul'a chun akhumtaove. Ajehchu hichu songkul'a akisemu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jeremiah chu leinoi'a, lhambuh sunga alutphatnin, chua chun nisottah aumtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin Zedekiah lengpan mi asolin, Jeremiah chu agapuidoh tai. Chuin lengpan a-insunga guhthim chan adongin, Pakaiya kona ipi thu umam? ati. Chuin Jeremiah chun, aume, atin ahi; ajehchu Babylon lengpa khutna kipedoh ding nahi, tin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chukalvalin Jeremiah chun Zedekiah lengpa henga, nangma chungle nasohte chunga, ahiloule namite chunga ipi kasuhkhel uma songkul'a neikhum ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Babylon lengpa nangma satdin ahiloule hiche gam satdin hungponte tia gaochangho nathemgao ho chu tu-a hoijaba um hitaovam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun tun, ngaijin, katao ahi. Vo kapu lengpa, katao ahi, kangeh nahi na-angsunga neisanpeh in, hitichun lekhasun Jonathan ina neikilesah hih-in, ajole chukoma thidenget inge, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Zedekiah lengpan Jeremiah chu songkul hongsunga akoina dingun, chule changlhah semho lamlena kona changlhah halkhat, khopi sunga changlhah abeihel kahse-a niseh-a apehjing diuvin thu apen ahi. Hitichun Jeremiah chu songkul hongsunga chun aumdentan ahi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Mattan chapa Shephatiah, Pashhur chapa Gedaliah, Shelemiah chapa Jucal, chule Malchiah chapa Pashhur in mijouse henga Jeremiah thusei ho chu ajaovin,
  </para>
  <para style="p">
    <verse number="2" style="v" />hiche khopi sunga umdenpa chu chemjam'a, kella, chule, hise-a thiding ahi. Ahin Chaldea miho henga chedohpa chu hingding ahi. Ajehchu ahinkho chu gal anchah-a anei ding ahin, hijeh-a chu hingding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin hitin aseije, hiche khopihi Babylon lengpa sepaiho khutna kipe-a, amahon alahdiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun pipuiho chun, lengpa henga, kangeh-u nahi, hiche mipahi thatjengin, ajehchu aman hiche khopi sunga umnalai ho henga chutobang thu sei jeh-in sepaiho khutle mipi ho jouse khut hi angoisah-e, hiche pan hiche mite phatna ding aseipon, akisuhmona diu bou aseije, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Zedekiah lengpan veuvin, ama nakhut uva um ahi. Lengpa hi nabolgot-u sutang thei ahipoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin amahon Jeremiah chu amanun, songkul hongsunga Hammelech chapa Malchiah leiko-a chun alehlutnun ahi. Ahin leiko-a chun twi aumpon, bonngan bou aumin, hitichun Jeremiah chu bonngan lah-a alhalut tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu-a lengpa in'a um Ethiopia mi, nukiso ho lah-a mi khat Ebed-melech chun, amahon Jeremiah chu leiko sunga akhum taove ti ajatan, hiche petna chu lengpa chu Benjamin kotpi phunga touva ahin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ebed-melech chu leng in'a konin apotdoh-in lengpa akihoupin aseije;
  </para>
  <para style="p">
    <verse number="9" style="v" />Kapu lengpa, hitehon Jeremiah themgao chunga abol jouseu khu thilsetah abolu ahitai. Amahon leiko sunga alehlutnun, aumna mun'a chu thiding kon ahitai. Ajehchu khopi sunga changlhah umlou ahitai, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chujouvin lengpan Ethiopia mi Ebed-melech chu thu apen, hia konin mi thum kipuijin lang Jeremiah themgao chu, athi kah-in leiko-a konin gapuidoh un, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun Ebed-melech chun miho chu akipuijin, lengpa ina thil kholna noija chun achen, ponlui ehsaho chu ahinlan, hicheho chu Jeremiah henga leiko-a chun khaovin agah khailhan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Ebed-melech Ethiopia mipa chun Jeremiah henga hiche ponluihole asesahohi najahnoija khaohi ngapsah-in, ati. Chuin Jeremiah chun chutichun aboltai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun Jeremiah chu khaovin aloidoh-un, leiko-a kon chun aladoh-un, Jeremiah chu songkul honsunga chun aumdentai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Zedekiah lengpan Jeremiah chu akouvin, Pakai in-lutna thum na-a chun ahenga apuilut tai. Chuin lengpan Jeremiah jah-a, thilkhat donging ting, keija konin imacha imhih-in, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jeremiah'in Zedekiah jah-a, nahenga kaphondohle neithada mongding hinam? Chule thu kamopma nahile neingaipeh mongding ham? atin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun Zedekiah lengpan Jeremiah henga guhthim tah-in hiche hinna eisempeh pau, Pakai chu ahinlaisen, nangma that ponge, nahinna hola hiche mite khutna jong pedoh ponge, tin akihahselin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuphatnin Jeremiah chun Zedekiah henga Pakai, janel Pathen Israel Pathen'in hitin aseije, nangma Babylon lengpa pipuho henga nakipehlut poupouva ahile hingin natin, hiche khopi jong meija kihal lou ding, nangle na-insung mite nahindiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla Babylon pipuiho lengpa henga nakipehlut loule vang, hiche khopihi Chaldea mite khutna kipedoh intin, meija ahaldiu, amaho khutna kona nahoidoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Zedekiah lengpan Jeremiah henga, Chaldea miho khutna lutsa Judah ho khu kakichai, ajole amaho khutna eipedoh khauvintin eijapi getnunte, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla, Jeremiah chun pedoh pouvin nate, najah-a kasei Pakai aw hi juijengin, kangeh nahi, chutile nang din phantin, nahin ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nakipehlut nomloule vang, hichehi Pakaiyin thu eimusah chu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule vetan, Judah lengpa ina numei um jouse chu Babylon lengpa pipuho henga kipuija, hiche numei ho chun, aseidio ahi, nagolten natung doh-un, amahon najou taove. Nakengho bon lah-a alhalut tan, amaho akinungle taove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiti achu najite jousele nachate jouse Chaldea miho henga apuidoh diu, akhutnuva kona nasochat louhel diu, Babylon lengpa khutna kikaijo ding nahin, nang jeh-a hiche khopihi meija kihal lhading ahitai, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Zedekiah chun Jeremiah henga, hiche thuho hi koimacha hetsah hih-in, nangma nathi lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla pipuhon nangma kakihoupihi heleu, nahenga hunguva, najah-a, lengpa henga naseijouse leh lengpan nakoma aseijouse tun keiho henga phongdoh-in, keiho-a konin imhih-in, nangma that pouvinge,
  </para>
  <para style="p">
    <verse number="26" style="v" />chuteng nangin ajah uva, Jonathan in'a eikilesah da-a, chua kagathiden louna dinga lengpa henga ngehna kanei jeng ahi, nati ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chujouvin pipuho jouse Jeremiah henga ahungun, ama adong taove. Aman amaho chu lengpan thu apeh jouse bang chun ahiltai. Hitichun akihouvu chu anga taove. Ajehchu amani kihouna chu ajahlou-u ahitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun Jeremiah chu Jerusalem kilahni geijin songkul hongsunga chun aume. Chule Jerusalem kilahni geijin aumin ahi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengpa Zedekiah lengchan kal kumko lhinna, lha som alhinna chun, Babylon lengpa Nebuchadnezzar le asepaite Jerusalem satdin ahungun, aumkul taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Zedekiah lengchankal kum somlekhat lhina, lha li na-a ni ko lhinnin, khopi chu akeh tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Babylon pipuiho jouse ahung lutnun, Nergal-sharezer, Samgar-nebo, Sarsechim, Rab-saris, Nergal-sharezer, Rabmag, Babylon lengpa pipuiho dang jouse toh kulpi lailha penachun atoutaove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ahitin ahi, Judah lengpa Zedekiah le asepaiho jousen, amaho amu phatnun, jan-in khopi-a kon chun apotdoh-un, lengpa honlei lampia acheuvin, kulbang teni kikah-a kotpi-a chun ajamdoh taove; chule ama phaicham lampia achetai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla Chaldea sepaihon anung delun, Zedekiah chu Jericho phaichama aphapao vin, ama amat phatnun Hamath gama Riblah ah Babylon lengpa Nebuchadnezzar henga apuijun, hia chun aman athu atanlhatai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Babylon lengpan Riblah'a Zedekiah mitmu tah-in achapate chu athatnin, Babylon lengpan Judah milun jouse jong athatgam heltai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chukalvalin Zedekiah mitchang teni jong akaldoh-in, Babylon gama kaidin thihkhaova ahentai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Chaldea mihon lengpa inle mipi ho inho chu ahalun, Jerusalem kulbangho asuchimgam taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin sepaiho lamkai Nebuzaradan chun khopi-a mipi umnalai ho, ahenga hungkipelut hole mipi amoh chengse chu Babylon'a sohchang din akaitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin sepai lamkai Nebuzaradan chun, Judah gamsunga imacha neilou mivaichaho chu adalhan, amaho chu apetpetnin lengpilei le loumun apen ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun Babylon lengpa Nebuchadnezzar'in Jeremiah chungchanga sepai lamakai Nebuzaradan henga,
  </para>
  <para style="p">
    <verse number="12" style="v" />amahi puijin lang, vetupmin, bolse hihhelin, nahenga asei ding bang bangin bolpeh-in, tin thu apei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun sepai lamkai Nebuzaradan chun Nebushazban, Rab-saris, Nergal-sharezer, Rabmag chule Babylon lengpa pipuiho jouse asolin,
  </para>
  <para style="p">
    <verse number="14" style="v" />amaho ngeijin Jeremiah chu songkul hongsunga konin mikhat agapuidoh sah-un, Shaphan chapa, Ahikam chapa, Gedaliah chu a-in'a puidin anganse uvin, hitichun miho lah-a achengtai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun songkul hongsunga akulkhup laijun Jeremiah henga Pakai thu ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="16" style="v" />Ethiopia mi Ebed-melech henga janel Pakai Israel Pathen'in hitihin aseije, vetan aphatna ding hilouva, hiche khopi setna ding joh-a kathu kahinlhut ding ahi. Hicheho chu namasanga hicheni chule guilhung ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hicheni chule nangvang huhdoh nange, chule nakichat miho khutna kipedoh pon nate, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu tahbeh-a kahoidohsah-a, chemjam'a naloulou ding, nahinkho chu gal anchah banga naneijoh ding ahi. Ajehchu kachunga natahsan na-ngap ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah le Jerusalem'a kon sohchang jouse, sepai lamkai Nebuzaradan chun Babylon gama sohchang dia kikaiho lah-a Jeremiah chu thihkhaova kihenpuma apuija Ramah a kona alhadoh nungin Pakaiya konin Jeremiah henga thu ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin sepai lamkaipan Jeremiah apuijin ajah-a, Pakai na Pathen'in hiche mun'a thilphalouhi aphondoh ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun Pakaiyin ahinlhun sahtan, asei bangin aboltai. Pakai douna-a nachonset uva, athu nangailou jeh uva hiche thil hi nachung uva hunglhung ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule tun, vetan, tuni hin nakhutna thihkhaova konin kalha-ong tai. Babylon'a kei toh hung nanople hungin, ken nangma vetup nange, ahinla Babylon'a kei toh hung nanop loule hung datan, ven, gam jouse namasanga aume, nang dinga phale kitup nasahna lama chun chejengtan, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tun ama akilekit masangin, Babylon'a lengpan Judah khopiho-a vaipo dinga atun Saphan chapa Ahikam chapa Gadaliah toh gacheng khomtan; ahiloule pha nasah-a nache nomna lam lama chetan, ati. Hitichun sepai lamkai chun nehtheihole tohphat man apen asoltai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Jeremiah chu Ahikam chapa Gedaliah heng Mizpeh-ah achen, akidalha miho lah-a ama toh achengtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun gamlah-a um sepai gallamkai jouse le amiteuvin, Babylon lengpan Ahikam chapa Gedaliah chu gamsung vaipon apansah-in, pasal ho, numei ho, chapangho chule Babylon'a sohchanga kipuilou gamsung vaichaho vetupdin angansetai ti thu ajah phatnun,
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho Nethaniah chapa Ishmael, Kareah chapa teni Johanan le Jonathan, Tanhumeth chapa Seriah, Netophah mi Ephai chapaho, Maachath mi chapa Jezaniah, amahole amiteu chu Mizpah'a um Gedaliah henga ahung taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Shaphan chapa, Ahikam chapa Gedaliah chu amahole amiteu henga akihahselin, Chaldea mite jending kicha hih-un, gamsunga chengun lang, Babylon lengpa kin bolun, hichu nangho dinga phading ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keidin vang veuvin, ihenguva hung ding Chaldea miho jendin Mizpah a cheng ingting, nangho vang lengpitwi, nipilai theiga ho le thao holkhom unlang nabel sunguva kikoijun, chule nalahsao khopiho-ah chengtauvin, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hibang chun Moab'a Judah te jouse Ammon mite lah-a umho, Edom mite lah-a umho chule gamsung jouse-a umhon, Babylon lengpan Judah mi phabep adalhan, achunguva vaipodin Shaphan chapa, Ahikam chapa Gedaliah apansah-e, ti ajah phatnun,
  </para>
  <para style="p">
    <verse number="12" style="v" />Judah te jouse akino mangnao gamho-a konin, Judah gama, Gedaliah heng Mizpah-ah ahungun lengpitwi le nipilai theiho tamtah akiholkhomun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chukalvalin Kareah chapa Johanan le gama um sepaiho gallamkai jouse, Gedaliah heng Mizpah a ahungun,
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahenga, Ammon lengpa Baalis chun Nethaniah chapa Ishmael chu nangma that dinga asol chu nahet chennem? atiuve. Ahinla Ahikam chapa Gedaliah chun amaho atahsanpon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin Kareah chapa Johanan chun Mizpah a Gedaliah henga, katao ahi, neisol jengin, Nethaniah chapa Ishmael chu gathat jeng'inge, koiman heponte, Judah mi nahenga umkhomho jouse acheh chauna dingle Judah'a amohho manthah na ding bepma ibola aman nangma natha ding ham? tin guhthim chan ahung seije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Ahikam chapa Gedaliah chun Kareah chapa Johanan henga, nangin hichehi nabol lou ding ahi; ajehchu Ishmael thu naseihi adihlou ahi, ati.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun lha sagi lhinin ahitin ahi, lengte chilhah lah-a Elishama chapa, Nethaniah chapa Ishmael le lengpa pipuiho, amatoh mi somjen, Mizpah ah Ahikam chapa Gedaliah henga ahungun, chukom Mizpah a chun changlhah anekhomuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Nethaniah chapa Ishmael le alhonpi mi som akipatnun, chemjamin Shaphan chapa, Ahikam chapa Gedaliah Babylon lengpan vaipo-a apansah chu athat taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ishmael'in Mizpah a Gedaliah toh um Judah miho jousele chua anaumkha Chaldea te sepai jong athatgam helin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman Gedaliah athajou nini na-a chun ahitin ahi, chule hichu koiman ahetlou ahin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Shechem'a kon, Shiloh'a kon, Samaria'a konin mi somget jen, akhamul hetsa cheh aponsilu kibot tela, amale ama ki-atchen chenna, akhutnuva thilpehle gimnamtui choija, Pakai in'a tohdoh din ahunguve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Nethaniah chapa Ishmael chu Mizpah a konin amaho kimupi din, kappum pumin ajah uva, Ahikam chapa Gedaliah henga hungun, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichu anahin, khopi lailung ahunggei phatnun, Nethaniah chapa Ishmael'in, amipuiho toh amaho chu athatnun kotong lailunga alehlut taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla alah uva, mi somho chun Ishmael jah-a, neithat hih-un, ajehchu keihon suhlouchang, sakol chang, thao, chule khoiju selguh kaneijuve, atiuve. Hitichun ama atangin, amaho chu asopihou lah-a chun athat tapon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun Ishmael'in Gedaliah jeh-a amithaho long apaina kotong chu Asa lengpan Israel lengpa Baasha agin jeh-a alai ahin, Nethaniah chapa Ishmael'in amithaho longin adippeh in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Ishmael'in Mizpah a amoh umsun leng chanute, Mizpah a sepai lamkai Nebuzaradan'in Ahikam chapa Gedaliah apehdohho, Mizpah a um jouse apuimangin, Nethaniah chapa Ishmael'in amaho chu sohchangin akaimangin, Ammon mite gam kalpeh-a din akipatdoh tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla Kareah chapa Johanan le aumpi sepai gallamkai jousen, Nethaniah chapa Ishmael thilbol phalou jouse ajah phatnun,
  </para>
  <para style="p">
    <verse number="12" style="v" />mijouse apuijun Nethaniah chapa Ishmael satdin akonun, Gibeon'a twi tamtah umna-a chun aphapa taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, Ishmael umpi mi jousen Kareah chapa Johanan le ahinpui sepai gallamkai jouse amu phatnun akipah behseh jenguve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun sohchanga Mizpah a kona Ishmael'in apuimang mi jouse ahung kinunghei cheh uvin, Kareah chapa Johanan heng lama achetauve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nethaniah chapa Ishmael vang chu mi get toh Johanan'a konin ahoidoh-un Ammon mite henga achetauve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Kareah chapa Johanan le aumpi sepai gallamkai jouse chun, Nethaniah chapa Ishmael'in Ahikam chapa Gedaliah atha jouva Mizpah a kona Nethaniah chapa Ishmael''a kona Johanan'in ahuhdoh mijouse, gal hat ho, numei ho, chapangho, nukiso ho, chu Gibeon'a konin ahin lepuisoh kit tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Akipat doh-un, Egypt jotlutna Bethlehem koma Chimham achun acheng taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu, gamsunga vaipo dinga Babylon lengpan anapansah Ahikam chapa Gedaliah chu, Nethaniah chapa Ishmael'in anatha jeh-a chu Chaldea miho akichatnu ahi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin sepaiho gal lamkaiho le Kareah chapa Johanan, Hoshaiah chapa Jezeniah, chule mipi ho jouse, chule mijouse aneopena pat alenpen gei ahung naijun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Jeremiah themgao jah-a nahenga kangeh-u ahi, kataonaohi neisan peh-un lang Pakai na Pathen henga neitao peh-un, ajehchu neimu-u banga hi keihohi tamtah lah-a themcha bou kidalha kahitao vin;
  </para>
  <para style="p">
    <verse number="3" style="v" />chutia chu Pakai na Pathen'in kachena diu lampile kabol diu thil eihil theina diuvin, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jeremiah themgaovin ajah uva, nathu-u chu kahei, veuvin, nathu-u bangin Pakai na-Pathen'u henga thuminge, chule hiti ding ahi, Pakaiyin nadonbutna diu thil chu ipi hijongle naheng uva phongdoh nange, nangho-a konin imacha imponge, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amahon Jeremiah henga Pakai na-Pathen'in kahenguva nasolna thu jouse banga kabol louvule kalah uva Pakai chu hettohsah dihtahle tahsan umtah hihen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahenga kasolnapao Pakai ka-Pathen'u aw chu apha hihen ase hile juinao vinge, hitia chu Pakai ka-Pathen'u aw kajui tengule keiho dinga phattheina hiding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin nisom jouvin ahitin ahi, Pakai thu chu Jeremiah henga ahungtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Kereah chapa Johanan le aumpi sepaiho gallamkai jousele sepai jouse, aneopena pat,
  </para>
  <para style="p">
    <verse number="9" style="v" />alenpen geijin akouvin, ajah uva, Pakai na Pathen'u a-anga nathumnao lhut dinga neisolna pao chun hitin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche gamahi tuni geija naum jing nahlai diule, tungdoh ungting sonlhu ponge, chule naphutnu vingting, botdoh pouvinge, ajehchu nachung uva thilphalou kalhunsah chu kakisih tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Babylon lengpa naginnu chu ging tahih-un, tin Pakai Pathen'in aseije, ajehchu ama khutna kona huhhing dingle huhdoh dinga kaumpi nahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nachung uva hepina anei theina dinga, naheng uva hepina kavetsah-a, nangho naleiset uva kakilesah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla nanghon, hiche gama cheng pouvinge, Pakai na Pathen thu jong ngai pouvinge, nati uve,
  </para>
  <para style="p">
    <verse number="14" style="v" />kanom pouve, Egypt gama chejovinge, chua galthu jata pouvinge, sumkon gin jong, changlhah-a gilkelna jong umta ponte, chua kache diu ahi, nati uve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun tun, nangho Judah te amoh chengin Pakai thu chu ngaijun, janel Pakai Israel Pathen'in hitin ati, Egypt'a lutdingle chua pem dinga namaiju napum ngat helu ahitahle,
  </para>
  <para style="p">
    <verse number="16" style="v" />hung hiti ding ahi, naginnu chemjam chun Egypt gama nahinphah diu, chule nakichatnu kel chun naitah-a Egypt gama nahin juijuva, chua chu nathi diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Egypt gama pem dinga amaiju pumngat hel ho chunga chutobanga chu umding ahi. Amaho chemjam'a, kela, hise-a thiuva, achunguva thilse kalhunsah dinga kona chu khatcha amohle asohcha umlou helding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu janel Pakai Israel Pathen'in hitin aseije, kalunghana le kalungsatna Jerusalem'a chengte chunga kasunlhah jeng banga chu, nachung uva kalungsatna chu Egypt gam nalhun tengule kasunlhah-a ki-dah le datmo, sapsetle mi houset nahiuva, hiche gamhi namukit loudiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo nangho Judah amoh chengse, Pakaiyin nachung chang thu-u hitin aseije, Egypt'a che hih-un: tunia kahin hilchah naohi kihet chenun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai ka-Pathen'u henga neitao peh-un tia Pakai na Pathen'u henga neisol petnu chun nalung gelu na-im uvin, Pakai ka-Pathen'un asei ding jouse dungjuijin, neiphondoh peh-un, juijuvinge, nati uve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman tuni hin naheng uva kaphongdohtan, Pakai na Pathen'u aw ahiloule naheng uva eihinsol lona khatcha najui pouvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun tun pemna dinga nache nomnao mun'a chu chemjam'a, kela, hise-a nathi teidiu ahi ti kihetchen jotaovin, ati.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jeremiah chun miho jouse henga Pakai a-Pathen'u thu jouse Pakai Pathen'in sei dinga asolna thu, hicheng thu jouse chu aseichai phatnin ahung hitin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Hoshaiah chapa Azeriah le Kereah chapa Johanan chule mihoitho ho jouse chun Jeremiah henga, Pakaiyin Egypt gama pem dinga nache loudiu ahi tia sei dingin nasolpoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tha dinga Babylon'a eipui theina diuva, Chaldea miho khutna pedoh dinga, Neriah chapa Baruch in natun ahibouve, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hitichun Kareah chapa Johanan le sepaiho gallamkai jouse chule mipite jouse chun, Judah gama chenna dingin, Pakai thu chu angai tapouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Kareah chapa Johanan le sepaiho gallamkai jouse chun; amoh umsun Juda ho jouse, Judah gama cheng dinga akinomang nao namtin lah-a kona hungkileho,
  </para>
  <para style="p">
    <verse number="6" style="v" />pasal ho, numei ho, chapangho, leng chanute chule Shaphan chapa, Ahikam chapa, Gedaliah toh sepai lamkai Nebuzaradan'in adalhah amitakip, chule Jeremiah themgao le Neriah chapa Baruch jaonan abonchauvin apuidoh taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun Egypt gamsung ahung lhung taove. Ajehchu amahon Pakai thu angai pouvin, hitichun Tahpanhes mun ngei chu ahung lhung taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Tahpanhes achun Jeremiah henga Pakai thu ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="9" style="v" />nakhutnin songchang len hochu lanlang Juda mite mitmu tah-in Tahpanhes a Pharaoh inlutna lampi-a kipha songpeh noija khun gavuijin,
  </para>
  <para style="p">
    <verse number="10" style="v" />chule ajah uva hitin seijin, janel Pakai Israel Pathen'in hitin aseije, ngaijun kalhacha Babylon leng Nebuchadnezzar chu kakouva, hiche songchang kivuisaho chungahi alaltouna atundoh-a, chule aleng pondal loupi chu ajahdoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ama ahung teng Egypt gam ahin bolset ding athi dinga chu thina-a, sohchang dinga chu sohchan na-a, chemjam'a loudingho chu chemjam'a apehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule keiman Egypt gama pathenho insunga mei kachokaija, hichun ahallhah ding, amaho chu sohchanga akaimang ding, kelngoichingpan avon chunga hit le kha aphetngim banga amanjong Egypt gam chu asuhtheng hella, chua kona mongtah-a potdoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman Egypt gama Beth-shemesh'a um song milimho jong chu asuhchima, Egypt mite pathen inho chu meija ahallhah ding ahi.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Egypt gama Judah umjouse Migdol gama chengho, Tahpanhes chule Noph khoho, Pathros gama chengho chungchanga Jeremiah henga thu ahung lhungin hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Janel Pakai Israel Pathen'in hitin ati, Jerusalem le Judah khopi jouse-a thilphalou kalhunsah jouse chu namutaovin, chule veuvin, amaho tuhin akamhelun, chuachun koimacha acheng tapouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lunghansahna dinga eiphinset uva, agitlou jehu'n, amahon ahetphah louvu amahole nangho, chule napateu vin jong ahetkhah louvu pathen dangho jen dingin gimnamtui hal dingin acheuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijengjongle naheng uva kalhacha themgaoho jouse chu, Ohe, hiche thil thet um kakidah tahhi bolhih helun, tidingin matah-a thouvin kahinsolin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla amahon angaideh pouve, Pathen dangho henga gimnamtui ahallouna dingule, agitlounauva kona akileheina dingun anao jong asungdeh pouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun kalunghana le kalungsatna chu Judah khopihole Jerusalem khopi lamlena kabunglhan, akadohtai. Chule hichu tunia banghin akisumangin, akamheltan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun Pakai janel Pathen, Israel Pathen'in hitin aseije, ibola nalah uva kona pasal le numei, naosen le nao noicheplai Judah gamsunga kona paidoh-a aum nading bepmin hiche thilsehi nabol uve,
  </para>
  <para style="p">
    <verse number="8" style="v" />chenna dinga nachenao Egypt gamsunga pathenho henga gimnamtui nahal uva, leiset chunga nam jouse lah-a sapsetle seiset nachan theinadiu le satlhah nahitheina diuva nakhutsoh tah uva neiphin lunghangu ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah gamsungle Jerusalem khosung lamlena napateu leh Judah lengte gitlouna, ajiteule nanghotah gitlouna, chule najiteuvin gitlouna anabolhou chu nasuhmilu hitam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho tuni geijin jong akineo sahdeh pouvin, akichadeh pouve, nanghole napateu masanga kakoijing keima danthu le chondan ho-a jong achon pouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun janel Pakai Israel Pathen'in hitin ati, keiman nangho douna-a thilse dingle Judah te satlhahna dinga kamaingat diu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Egypt gamsunga pem dinga maingat Judah amoh umsun chu kamatna kasuh manghel soh ding, Egypt gama lhalut uva, chemjam le kela thigamhel diu, aneopena pat alenpen geija chemjam le kela thidiu, thet le datmoa, gaosap le seisetna umdiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman Jerusalem chu chemjam'a, kela, chule hise-a talen kapeh banga Egypt gamsunga chengho chu talen kapeh ding ahin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun Egypt gamsunga cheng dinga che Judah mi a-umsun hochu, chenna dinga angaitun tunu Judah gama chu kilekit dinga khatcha ahoidoh le avaldoh umlou ding, aguh-a jamdoh ho tilou khatcha akilekit umlouhel dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule pathen dangho henga ajiteuvin gimnamtui ahaluve ti he-a mijousen akoma ding numei jouse mihonpi atama tam, Egypt gama cheng mijouse, Pathros-a chun Jeremiah chu adonbutnun, aseijun,
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai mina kahenguva nathusei chu ngaipou vinge, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keihole kapateu, kalengteo le kapipui houvin, Judah khopihole Jerusalem khopi lamlen dunga anabol banguva, van lengnu henga gimnamtui hal le, ahenga don thilpeh sunlhah ding kakamsung tah uva kaseinao bangcheh-a kaboltei teidiu ahi. Ajehchu hichelai chun nehding tamtah kaneijun, aphan, thilse imacha kamupouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla van lengnu henga gimnamtui halla don thilpeh sunlhah katan uva pat ijakai kalhasamun, chemjam le kelin eiki sumangun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule van lengnu dinga gimnamtui kahal uva, don thilpeh kasunlhah laijuva chu, kapasalteu thu louva amanu houna dinga changlhah kasemuva, don thilpeh kasunlhah-u hibeh-em? atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujouvin Jeremiah chun mijouse hengale pasal ho, numei ho, ama donbutho jouse henga chun aseijin,
  </para>
  <para style="p">
    <verse number="21" style="v" />Judah khopihole Jerusalem khopi lamlen ho-a, nanghole napateu nalengteu chule gamsunga miten, gimnamtui nanahalu chu, Pakaiyin ahetlou hija alungsunga akhumlou hibeh-am?
  </para>
  <para style="p">
    <verse number="22" style="v" />Nathilse boljeh-u le nathilbolu kidah um jeh-a, Pakaiyin athohjou tahlou ahin, hiche jeh-a chu, nagamu tu-a bangahi kamdela, datmo uma, sapset changa achenga umlouhel ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gimnamtui nahal uva, Pakai douna-a nachonset uva, Pakai thu nangai daova, adan kisun thupeh le achondan najuilou jeh uva, hiche jeh-a chu tu-a bangahi nachung uva hiche thilsehi hungchua ahitai, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chukalvalin Jeremiah chun mijousele numei jouse jah-a aseijin, Egypt gama um Judah te jousen Pakai thuhi ngaijun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Janel Pakai Israel Pathen'in hitin aseije, nanghole najiteuvin van lengnu henga gimnamtui hal le don thilpeh sunlhah ding, kanakitepnao banga kabol teitei dingu ahi, tin nakamun naseijun, nakhut un namolso taove. Nakitepnao bulhitnun lang, nakitepnao molsouvin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun Egypt gama cheng Judah te jousen Pakai thu chu ngaijun, veuvin, Egypt gamsung pumpi-a Judah mi koimachan kamin aphahpoh tahlou ding ahi tia kamin thengtah pana kakitep ahitai, tin Pakaiyin aseije, Pakai ahing jinge.
  </para>
  <para style="p">
    <verse number="27" style="v" />Veuvin, aphatna ding hilou, asetna dinga kachan jingding, Egypt gamsunga Judah mijouse akichai soh hel kahseuva chemjam le kel lhah-a kisumanghel ding ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla chemjam'a sohcha themcha khat Egypt gama konin Judah gama kileuvintin, Judah mi umsun jouse Egypt gama cheng dinga chesate chun, kei thuham, amaho thuham, koi thujoh atah ahiding hetaovinte.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichehi nangho dinga melchihna hiding ahi, tin Pakaiyin aseije, hiche munahi nangho talen kapeh uva, nanghon kathuhi nangho douna-a, aselama dingjing ding ahi ti nahet theidiu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pakaiyin hitin aseije, vetan, Judah leng Zedekiah chu ama thadinga holjing amelmapa, Babylon lengpa Nebuchadnezzar khutna kapeh banga, Egypt lengpa Pharaoh hophra jong amelmate, ama that dinga holjingho khutna kapehdoh ding ahi, ati.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah leng Josiah chapa Jehoiakim lengchankal kumli channa-a Jeremiah kama hiche thuho asutlaija Keriah chapa Baruch henga Jeremiah themgaovin asei thu chu,
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Baruch, Pakai Israel Pathen'in nahenga hitin aseije,
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangman Ohe, tun ada kahitai, Pakaiyin kalungkhamna chunga lung gentheina eibelappeh-in, khoisatna-in kalhutan, choldona kaneipoi, nati-e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangin ajah-a hiti ahi nasei ding ahi, Pakaiyin vetan, keiman kasah chu kaphelhan, kaphu chu hiche gam pumpi geijahi kabodoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangin thil lenlen nachangseh dinga nahol ham? Bol hih-in, ajehchu mihing jouse chunga thilse kalhunsah ding ahi, Pakaiyin nahinkho hi nachena muntina nangma dinga anchah bepma bou kapeh ding nahi, ati.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chidang namdangho chungchanga Jeremiah henga Pakai thu hunglhung chun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Egypt chungchang Euphrates luipi kama Karchemish kho-a chun, Judah leng Josiah chapa Jehoiakim lengchankal kumli lhinna in Babylon lengpa Nebuchadnezzar chun Egypt lengpa Pharaoh-Neko sepaiho chu anajoutan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pho leh lum kigotnun lang, gal lam nailutnun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sakol phoho semtupmun lang, nangho sakol chungchongho kipatdoh-un, nathih lukhuh-u toh dingdoh uvin, tengcha kinol hemun lang, thih sangkhol ki-ah uvin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ibola lungthoija anungjamu kamuham? Agal hatteu alhugamun, nunglam velouvin gangtah-in ajamuve. Avelu tijatnan alotai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Akaljanga jammang dahen, mihat jong sohcha hihhen, amaho Euphrates luipi kom sahlama kipat uva lhugam diu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vadung banga atwi pomtultula, twisoh banga hung kinong lullul khu koiham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Egypt hi twisoh atuiho pomtultul luipi abangin, kakhan touva leiset kalosoh ding, akhopile asunga chengho kasuhmang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sakol nangho hung touvun, kangtalai nangho kino uvin, mihat ho hungdoh-u hen, lum choija Ethiopia mite le Egypt mite, thalpi kaosa-a choija Lydia mite.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu hichehi janel Pakai Pathen nikho phulah nikho ahin, akidoupiho chunga phu chu alah theina ding ahin, chemjamin aneh chaija, lungnachima athisanu adonkham ding ahi. Ajehchu Euphrates luipi pang sahlam gamkaijah janel Pakai Pathen'in ganlhaina abolin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Egypt chanu nungah theng, Gilead'a chetouvin, nuding thingnailou gakilah-in, ajehchu nadampi louding loule ai tampi naman ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Namtin vaipin najachatna ajauvin, nakana in gamsung alosohtai. Mihatle mihat atatton, tolla alhugel lhontai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Babylon lengpa Nebuchadnezzar iti ahunga Egypt gam ajo ding thudol chu Pakai chun Jeremiah henga aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Egypt gama seichoijun lang, Migdol le Noph chule Tahpanhes ah phongjalun, dingdet unlang, kigal ginun, ajehchu chemjamin nakimvel uva miho ahinsatgam ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ipi jeh-a namihatteu kiphet manga hitaovam? Amaho Pakaiyin anojeh uva ding joulou ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman mi tampi alhuhsah-in ahi, khat chunga khat alhuvin, amahon, kipat un, suhgentheina chemjam'a konin imiteu heng, igam lamuvah chekit taohite, atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hia chun amahon asamun, Egypt lengpa Pharaoh vang ahu gin keubou ahin, phat kitepsa amoh suhmange, atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amin janel Pakai lengpa chun keima kahing jinge, tahbeh-in mol ho lah-a Tabor bangle luipi panga Karmel banga ama hung ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Egypt'a cheng chanu, nangma sohchanga chedin kigojengtan, ajehchu Noph chu keuhela chenna louva kamhel ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Egypt hi bongla hoitah abangin, ahinla manthah na ahungin, hichu sahlama kona hunga ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bongchal thaotah bangin amithalah houjong chu alah uva aumin, ajehchu amaho jong akinung heijun, ajamkhom taove. Ajehchu amanthah nau nikhole atosetnao phat achunguva ahung lhun jeh-a ding joulou ahitaove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chua husa chu gul kitholgin abangin, amaho chu gammang thingtuho banga heicha kenga galmiho toh hungdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaho khaokhoho sanga tam ahiuvin, simjouhoi ahilou jehu'n, kholtoh hoi hihih jongleu agammang chu atuhchaihel diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Egypt chanu kijumso-a, sahlam gamkai mite khutna kipedoh ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Janel Pakai Israelte Pathen'in aseije, vetan, Amon mi No mihonpi, Pharaoh le Egypt chu a-pathenho le alengteu puma, Pharaoh amatah le ama tahsan jouse talen kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Keiman amaho chu ahinnao holtele Babylon lengpa Nebuchadnezzar le asohte khutna kapehdoh ding, chujou tengle masanga banga Egypt gama chu mi cheng ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla Vo kalhacha Jacob, nangma kicha hih-in, ajehchu vetan, nangma gamlatah-a kona chule nachilhahte asohchannau gama kona kahuhdoh ding, Jacob chu hung kinungle-a ongthol tah-a choldoa, koimachan akichatsah lou ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kicha hih-in, Vo kalhacha Jacob, tin Pakaiyin ati, ajehchu keiman kaumpinai, keiman nangma kadel mangna namho jouse kichaina chu kabolpeh ding ahin, nangma kichaina vang kabolpeh lou ding, tena-a vang kasuhdih ding nahi, hijengjongle talen manlouva vang kakoi louhel ding nahi, ati.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pharaoh'in Gaza ajo masangin Philistine te thudola themgao Jeremiah henga Pakai thu ahung lhunge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin hitin aseije, vetan sahlama kona twisang hunglena, gamsungle asunga um jouse akhopile asunga chengho achup gamhel ding, chuteng miho chu kapmuva gamsunga chengho jouse pengdiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Asakol hat hou kholhah ginin, akangtalai ho lhaiginle akangho kipei pohlahlah chun, pate khut ngoisah-in tin, achateu cheng nungvet pouvinte.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichu Philistine te kisuhgamna le Tyre le Zidon'a panpi umsunho suhmanghel nikho ahijeh in, Pakaiyin Philistine te Caphtor gamsunga amoh umsun chu asuhmanghel ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gaza chunga luchaina alhungin, Ashkelon chu phaicham amoh umsun pumin akisumang heltai. Itihchan naki-at chenchen ding hitam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo nangma Pakai chemjam, itihchan mong nathip dingham? Napaija kikhumlutnin lang, kicholdon lang thipchet tan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin Ashkelon le twipi pamma ho sat dinga thu apeh-a, apansah ahile, iti umthim thei ding ham? ati.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Janel Pakai Israel Pathen'in Moab dounan hitin aseije; Ohe Nebo, ada ahi, ajehchu akisusea nahitai; Kiriathaim akijumson, akilatai; Misgab ajahchan, alungthoi tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Moab kivahchoina umta ponte, Heshbon dounan thilse agonguve, hungun, namkhat ahina-a konin sutanhel uhite. Vo Madmen namho, nangho jong kisatlha ding nahiuvin, chemjamin najuidiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Horonaim'a kona chomna le suhmangna nasatah kana awgin sohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moab akisumang tai, achasen hou ka-na akijan,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Luhith chetouna-a kap kapmin acheuvin, Horonaim kumsuh na-a melmaten asuhmangna jeh-a kana ajaove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jamun, nahinna kihuhhingun lang, gamthip hamhing bangin umun,
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu nathilbol le nahaona natahsan jeh-a, nangma jong kiman ding nahin, Chemosh chu athempuhou le apipuiho puma sohchanga chediu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khopi tina misumang hungintin, khopi khatcha hoilou ding, Pakaiyin asei banga damphai jong mangthah-a phaicham jong kisumang ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Alenmang theina din Moab chu lhaving peuvin, ajehchu acheng beija akhopi chu kamhel ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jonchihtah-a Pakai na tonga chu sapset changhen, thisan sona dinga achemjam tuhkihpa jong chu sapset chenghen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moab hi aneuva pat nomsa ahin, ajuninga kivah-a, ajubel khatna khat jong keukhalou, ama jong sohchanga chekhalou ahi, hijeh achu atuina ama-a umden dena, anamtui jong kikhel lou ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun veuvin, nikho chu hunglhung ding ahi, tin Pakaiyin aseije, ahenga vahveiho kasola, amahon avaveisah dingu, chule jubelho avoh chippeh uva ahaihou asuhchippeh diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel insungin atahsan Bethel ajachatpiu banga Moab miten Chemosh ajachatpi diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiho gal hat le mihang kahiuve, iti natiu ham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Moab akisumang tan, akhopiho-a konin abeidoh tai. Alhentum khangthah ho jong akithat ho lah-a apanggam taove, tin amin janel Pakai hija lengpa chun aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Moab hamsetna chu hunglhung vah ding ahitai, chule athohgimna chu kinoloi chela ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangho avela um jousen lunghem piuvin, amin heho jousen, mol lhon hamtahle moltum hoitah chu iti boh-a hitam? tiuvin!
  </para>
  <para style="p">
    <verse number="18" style="v" />Dibon'a cheng chanu nangma, naloupi na-a konin hungsuh-in lang, dang chah-in touvin, ajehchu Moab sumanga chun nahin satna, nakulpi det ho asuhmang diu ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Aroer'a cheng lampia dingin lang velhin, ajampale ahoidoh nu chu ipi soh-a hitam? tin dongin lang seijin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Moab chu achimlhah jeh-in ajahchatai. Pengchoi choijin kapmun, Moab akisumang tai tin Arnon hilleuvin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Phaicham gama Holon le Jahazah chu chule Mephaath chunga, thutanlhahna aumin,
  </para>
  <para style="p">
    <verse number="22" style="v" />Dibon le Nebo, chule Beth-diblathaim chunga,
  </para>
  <para style="p">
    <verse number="23" style="v" />Kiriathaim le Beth-gamul, chule Beth-meon chunga,
  </para>
  <para style="p">
    <verse number="24" style="v" />Kerioth le Bozrah chule Moab khopiho jouse naijale gamla-a chunga thutanna ahung lhungtai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Moab ki akisatlhan, abanjang akihehbongtai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakai douna-a akiloupisah jeh-in, ama chu khamsah uvin, Moab jong alohlhahna-a kibola anuiho totna jong ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israel chu nang dinga nuijatna bep hilou ham? Ama gucha lah-a kimukha am? Ama thudol nasei poupoule kipah-in nakichom chomjin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Vo Moab gama chengho, Khopiho dalhauvin, songkoa chengun, kohom panga bu kiset vakhu bangin umun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keihon Moab kiletsahna thu, ama akiletsah lheh-e; akichoisangin, ahoithoji-e, akiletsah jeh le alung hoithodan kamuvin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Alungsatna chu kahei, tin Pakaiyin aseije; ahinla chutilou ding ahi, ajounaho chun ima sodoh ponte.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh chun Moab din penging ting, Moab pumpi din kapdoh inge, Kirheres mite chu lunghem pinge.
  </para>
  <para style="p">
    <verse number="32" style="v" />Vo Sibman lengpigui Jaazar ka-na in nangma dingin kapminge, naguiho twipi ajam galkaijin, Jaazar twipi chan geihel ajame, na nipitheile lengpiga sumangpa nachunga achutai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Neh nenna le Moab gama konin thanopnale kipana akilamang tan, lengpiga chilna-a konin lengpiga kabeisahtai. Koimachan kipa awgin to tho-a achiltah louding, a-ao nau chu kipana hitalou ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Heshbon'a kona Elealeh gei peh-a kho kisam chu Jahaz gei peh-in a-awginu athongin, Zoar apat Horodnaim geijin kum thum bongla abangin, ajehchu Nimrim twiho jong kamhel ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chukalvalin Moab'a munsang ho-a thilto bolpale a-pathen hou henga gimnamtui halpa kasuhthip ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hijeh chun kalunghi Moab te dingin thih bangin gingintin, kalunghi Hirheres mite dingin theile ho bangin ginginte, ajehchu aman anei haonaho beigama ahitai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ajehchu lu jouse chaija, khamul jouse kivou ding, khut jouse-a ki-at ding, kongho chunga khaopon akiveitai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Moab intingvum jousele khosung lamlen ho-a tanggola lunghemna jeng umding ahin, ajehchu asunga lunglhaina umlouhel bangin kavochiptai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="39" style="v" />Amaho penguva, iti hichu kisu chipma, Moab chu jahcha geuva iti kinungheija hitam atidiu ahi. Hitia chu Moab chu nuisat le akimvella umho dinga lungthoina hiding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ajehchu Pakaiyin hitin aseije, Veuvin, ama mulaopi bangin hunglengin tin, Moab chunga alhaving ahinjah ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kerioth chu akila ahitan, akuldet hou achim sohtan, chuche ni-a Moab mihangsan ho lungthim chu numei naonei pet lungthim tobang bep ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Moab chu Pakai douna-a amale ama akichoisang jeh-a mite khat ahinaova kona kisumang ding ahitai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Vo Moab'a cheng, nachunga tijatna le kokhuh chule thang hungchu ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tijatna-a kona jam-a chu kokhuh-a lhalutnin tin, kokhuh-a kona hungdoh-a chu thanga ohding ahi. Ajehchu achunga Moab chungtah-a talen kapeh kum kalhunsah ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="45" style="v" />Heshbon lim noija galmiho jeh-in ajamho adingden taovin; ahinla Heshbon'a konin mei chule Sihon'a konin meikong hungintin, Moab ningkoile samel mula umho lallukhuh akahvam ding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Vo Moab ada nahitai! Chemosh mite amangthah taove. Ajehchu nachapate sohchangin akikaijin, nachanute asohchang taove.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hijongle ninunung lamle Moab sohchangho chu kahinlepui kit ding ahi, tin Pakaiyin aseije. Hichan geihi Moab thu kitanlha chu ahi.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ammon mite thudol chu Pakaiyin hitin aseije, Israel'in chapa aneilou ham? Aman goulo aneilou ham? achutile ibola alengpauvin Gad alo-a, amite akhopiho-a chenguva ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun Pakaiyin aseije, Vetan, nikho ahung lhunge, Ammon mite kho Kabbah a galkisat thuthang kajahsah ding, hichu agohkeo kisevum hija, achanuteu meija kigou ding; chuteng ama gouloho chu Israel ten alodiu ahitai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Heshbon, Ai kisuhmang jeh-in pengun, Rabbah chanute kapmun, khaodip pon kigah-un lang lunghemun, hamkhul lah-a suhle tungin lhaijun, ajehchu alengpaule athempuhou chule apipuiteu agoma sohchanga chediu ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo chanu nungchonnu, ibola na phaichamm phalai chuleh phaicham ho-a nakiloupi sah-a nagoukhol ho-a nakisona, kahenga koi hung ding hija? nati ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Vetan, nachunga tijatna, navela umho jouse-a kona kahinlhunsah-a, nangho amitakip kinomang jeng ding, alamvaipa chu koimachan akhopkhom lou ding ahitai, tin janel Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khonungle Ammon chate sohchangho kalepui ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Edom thudol chu janel Pakaiyin hitin aseije, Teman'a chihna beihela hitam? Milungchinga kona thumopna mangthah-a hitam? ahetkhen themnao mangdela hitam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Dedan'a chengte, jamun, kinung leuvin, chengdetnun, ajehchu keiman Esau chunga hamsetna kahinlhut ding, ama gotna kapeh ding phat kahin lhunsah ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lengpiga louho nahenga hungleu akhai themkhat dalha pouvintem? Jan-in guchaho hungu le achim kahseuva aneh mang loudiu ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla Esau ahomkeovin kalhan, amunthip ho kahohdoh gamtan, kisel thei lou ding ahitai. Achilhahte leh asopiho, chule aheng akomho akisumang sohtan, ama abeihel tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Paneilou nachateho chu dalhan, keiman hinso nange, chule nameithai hon eitahsanu hen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu Pakaiyin hitin ati, Vetan, khona kon adonlou dinga athu kitanlhah hon adonjeng tah-ule, talen manlou ding pa chu nangma nahim? Talen manlouvin chepon nate, ahinla hichea chu nadon tei ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima kaki hahsel tai, tin Pakaiyin aseije, Bozrah chu kamhela, seisetna uma, keohela, sapsetna umding; chuche khopi jouse a-itih-a keohel ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakaiya konin thuthang khat kajan, Pathen helouho henga palai khat akisolin, kipun khomun, chule ama satnun, galbol din kipatdoh-un.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu vetan, keiman nangma Pathen helouho lah-a kaneosah-a, mite nahsahmo-a kasem ding nahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo nang lhangsanga song khikah-a cheng, kichat umtah banga nakigelna le nalunga kiletsahna chun nalheplhah ahitai. Nangman muvanlai banga sangin nabu sepjongle chun, chua kona kaloilhah ding nahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Edom jong kamhel intin, koi hile ajotpa chan atosetna jeh-a chehsa diu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sodom le Gomorrah chule avela khopiho akisuhmang helbanga, chua koimacha umlou ding, mihem chapa jong cheng louhel ding ahi, tin Pakaiyin ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Veuvin, Jordan twisoh akonin ama chu kuldet nokhum dingin keipibahkai bangin hungtouvintin, ahinla ama-a kona hetman louva kadelmang ding ahi, chule achunga vaipo dinga kalhenthei pasal lhentum koiham? Kei tobang koi umam? Koijin phat eiteppeh ding ham? Ka anga dingding kelngoi chingpa chu koi ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun Edom douna Pakai thumopte, Teman'a chengte chunga athilgon, bol dinga agot ho chu ngaijun, thonlouva ganhon neopen geija kilhoh manga amaho puma achennao akamhelsah tei ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Alhuh-u ginin leiset ahot lingin, aka ginu jong twipi geijin akijaphan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Veuvin, mulaopi bangin ama hungleng touvintin, Bozrah chunga alha ajah ding ahin, hiche nikho chuleh mihat te lungthim jong numei jin naosonat athoh petna alungthim tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Damascus thudola chun Hamath le Arpad akisudongtai; amahon thuse ajah jeh-un alungu alha lhoptai; twipi chunga lungkhamna aumin, hichu athip thei tapoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Damascus hi angoilhatan, jam dingin kigon akiheijin, tijatna-in amanchomtai; lungkhamnale natnan numei naosonat bangin abomtai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kanopsahna khopi, vahchoina khopi chu iti kikhen louva ham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijehchu agollhanghou khosung lamlena chu lhugama, hicheni chule agal hat hou jouse kithatgam hel ding ahiuve, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Damascus kulbanga mei kachokonga Benhadad leng inpi akahvam ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Babylon lengpa Nebuchadnezzar'in asuhmang ding Kedar thudolle Hazor lenggam thudol chu Pakaiyin hitin ati. Kipat un Kedar a chetouvun lang, solama miho chu gachomun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aponbuh houle agancha honnu atol manguva, apondal houle aumlebel jouseu, asangongsao ho akilah uva, amahon ajah uva, ningtina tijatna jeng ahi, tia ahenguva asap diu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Vo Hazor a cheng mite, jamun, gamlatah-a umun lang, chengdetnun, tin Pakaiyin aseije. Ajehchu Babylon lengpa Nebuchadnezzar'in nachung thu agel lhutan, nangma douna-in ngaito aneitai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kipat un, khohsah louhela cheng kul kotpile thih kotgol jong neilouva achanguva cheng, nam haotah ho sat ding khun kontouvun, tin Pakaiyin aseijin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Asangongsao ho chu galthil chomding hija, aganchau tampi chu chomgam dingbep hintin, kolmong geija hui jouse-a amaho kathecheh-a, ningtina kona ahamsetnau kahinpoh ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hazor chu dragon ho chenna hiding, a-itih-a kamhel ding ahin, chua mihem khatcha umlou ding, mihem chapa khatcha jong cheng lou ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Judah lengpa Zedekiah leng chantila Elam douna-a Jeremiah themgao henga Pakai thu hunglhung chun hitin aseije.
  </para>
  <para style="p">
    <verse number="35" style="v" />Janel Pakaiyin hitin aseije, Veuvin, Elam thalpi athahatnao kona pen chu kaheboh ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Elam dounan chua van ningli-a konin huilhi hinlhun sah ingting, chuche huiho lama chu kathecheh ding, akinodoh Elam mite lhunlouna nam umlou ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ajehchu Elam mite chu amelmateu masangle ahinnao holte masanga kalungthoisah-a, achunguva thilse kalunghana, tijat umtah ngeichu kapohlutna, kasuh manghel kahse-a, anung nunguva chemjam kasol ding ahi, tin Pakaiyin ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chua kona lengpa le pipuiho kasuhmanga, Elam'a chu kalaltouna kado ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahinla ninunung lamle hung hiti ding ahi, Elam sohchangho chu kalepui kit ding ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babylon le Chaldea te gam chungchanga Jeremiah themgaova kona Pakai thusei chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Namtin lah-a phongjalun lang thejah-un, ponlap domsangun, thejah-un, imhih-un, Babylon akilatai, Bel akisudongtai, Merodach ahal halin achiptai; asong milimhou ajahchatan, amilimhou ahal hallin achiptai, tiuvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sahlama konin nam khatnin ahinsatnun, hichun agam akamhelsah-a, koimacha chua chenglou ding, mile sa agoma kichonuva adalhah diu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />chuche nikhole chuche phatna chu, Israel chate, amahole Judah chate chu kappuma hungkhom uva, Pakai a-Pathen'u chu agahol diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zion lam amaingat uva alampi adoh dingu, hungun, suhmil kit louhel dingin tonsot thulhunna eihotah-in Pakai chu jomuhite, atidiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamite chu kelngoi mang ahiuvin, achinghouvin alamvaisah-uvin, molchung ho-a akihei manguvin, mola konin lhang danga acheuvin, ahongsungu asumil taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amuchanin amaho avallhumun, akidoupihouvin hitin aseijuve, keihon kasukhel pouve, ajehchu amaho thudihtah chenna Pakai, apateu kinepna Pakai ngei douna chun achonseuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Babylon lailunga konin potdoh unlang, Chaldea te gama konin chedoh-un, chule kel hon lah-a kelchal bangin umun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu, veuvin, Babylon satding sahlama konin namho loupitah-a kikhom khom chu choh thouving ting, ama dou dinga kigoltoh uva, chua patna alah diu ahin, athalchangu chu mihat galbol thema tobang hintin, khatcha kimohle lou ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chaldea chu kichom ding ahin, achom jouse chu lunglhaisel diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nakipa jeh-un, nathanop jeh-un, Vo kagoulo sumanga nangho, hamhing ne bongla banga hung thaodoh-in bongchal bangin naham lutlut jenge.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanu chu hatah-a kijumsah ding ahi, nahingnu chu jahcha lheh ding ahi; Veuvin, namho lah-a anukhah pen chu gamthip gam, gamgo, chule neldi gam hiding ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai lunghan jeh-a chenna mun hilou ding, apuma kamhel joding, Babylon'a chechan asetnaho jouse jeh-a adatmouva chehsasa cheng ding ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Babylon kimvela kigolun lang, thalpi kamsa kichoi jousen ama chu kapmun, thalchang khatcha khen hih-un; ajehchu Pakai dounan achonsetai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Akimvela hatah-in aovun, aman akhut apedohtai, akhopibul jouse alhutan, akulpihou achimlhatai, Pakai phulah ahijeh in achunga phu lauvin, aman abol bangin ama jong bolun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Babylon'a konin muchi thepa chule chang atlaija koite choipa sumang uvin, suhgentheina chemjam jeh-a amaho amitakip amite lamcheh-a kiheija, amitakip agamcheh-a jamdiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israel hi keipin adelmang kelngoi vahcheh chu ahin, Assyria lengpan abahgam masapenin, achainan Babylon lengpa Nebuchadnezzar'in aguho asubongin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun janel Pakai Israel Pathen'in hitin aseije, Veuvin, Babylon lengpa le agam chu Assyria lengpa talen kapeh banga talen kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Israel chu aumna-a kapuikitna Karmel le Bashan'a kivah-a, Ephraim le Gilead mol chunga ahinnao lunglhaisel ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakaiyin, chuche nikhole chuche phat tengle Israel khansetna chu kikhola, khatcha kimu lou ding, Judah setna jong kimu lou ding ahi. Ajehchu keiman kakhehho chu kangaidam ding ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Merathaim le Pekod'a chengho tah chu doudin kontouvun, amaho chu thatnun, sumanghelun, kathupeh jouse bangin bolun, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuche gama gal kisatle suhmangna nasatah husa aginge.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leiset pumpi sehtum iti kikehso-a, kisu bonga hitam? Namtinho lah-a Babylon iti hung kamhela hitam?
  </para>
  <para style="p">
    <verse number="24" style="v" />Vo Babylon thang kakampeh-in, na-ohtan, nangin nakihetpon; nangma nakiholdoh-in nakimantai. Ajehchu Pakai nakisatpin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pakaiyin agalvon kholna chu ahongin, alungsatna galvonho aladohtai. Ajehchu hichehi Chaldea te gamsunga janel Pakai Pathen natoh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Gamgi monglhapena konin adouvin hungun, athilkholna inho hongun, sepkhomun lang sumang helun, a-imacha khen hih-un.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abongchal jouse akisuhmang nao nikho ahunglhun jeh-in, Ohe adao ahi!
  </para>
  <para style="p">
    <verse number="28" style="v" />Pakai i-Pathen'u phulahna, a-houin dinga phulahna Zion'a phongdoh dinga Babylon'a kona hungjamdohho awgin khu ngaijun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Babylon doudin thalthem ho koukhom un; thalkap jousen akimvela ponbuh kisonun, koimacha hoidohsah hih-un; athilbol dungjuijun lethuh un, athilbol jouse dungjuijin achunga bolun, ajehchu ama Pakai dounale, Israel mithengpa douna-a ahoithon ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Agollhanghou kholaija lhulhop diu, chuche nile agal hat jouseu kisumanghel ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vetan, mihoitho penpa, kadou nahi, ajehchu nangma gotna kapeh ding phat, nanikho chu ahung lhungtai, tin janel Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mihoitho pen chu kipala lhuding, koimachan akaithou lou ding ahi. Chule akhopi sunga mei kachokonga, akimvel jouse akahchai ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Janel Pakaiyin hitin aseije, Israel chate leh Judah chate suhgentheijin aumkhomun, sohchanga kaiho jousen atuhdetnun, lhadoh ding anompouve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Alhatdohpao chu ahatnin, janel Pakai chu amin ahi. Gamsunga olna aumtheina dingle Babylon'a chengte asuhboi theina dinga, ama amaho lama pang ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chaldea te chungle Babylon'a chengte chule apipuiteu, amichingteu chunga chemjam achutai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mijouho chunga chemjam achun, amaho lunglhom diu; amihatteu chunga chemjam achun, amaho lungthoi diu ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A sakol houle akangtalaihou, chule alah uva michoplop ho chunga chemjam achutan, amaho numei ho bang diu ahitai. Agoukhol hou chunga chemjam achun, chule hicheho chu kichom mang ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Atuiho chunga twikana alhungin, hichu kanghel ding ahi. Ajehchu milim semthu gam ahin, asong milimhouvah angolgam taove.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hijeh achu nelphai gamsahole twikol gamsaho chua chenguva, sumbupi jong cheng ding ahin, a-itih-a kilokit talou ding, akhang akhanga kilo talouhel ding ahitai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Pathen'in Sodom le Gomorrah chule nai vela khopi ho asuhmang banga, chuachu koimacha umlou ding, mihem chapa jong khatcha cheng louhel ding ahitai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="41" style="v" />Veovin, sahlama kona mipi honkhat hunguntin, chule nam lentahle leng tamtah, leiset kolkimvela konin hung kitol touvunte.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amahon thalle teng apatdiu ahi. Engsetahle hepina beihel twipi kinong banga kitum lenglunga, sakola touvuva, mitin galbolmi banga kivona, Vo Babylon chanu, nahin satdiu ahitai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Babylon lengpan athulhutnu ajan, akhut tha angoilhatai. Numei naosonat bangin, hesohnale natna-in naman chomtai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Veuvin, ama Jordan twi kinonga kona mihat umna lama keipibahkai banga hungtou ding, ahinla keiman ama-a kona kajam mangsah paiding ahi. Achunga vaihomna katun ding pasal lhentum koiham? Keitobang koi umam? Koijin phat eiteppeh ding ham? Ka anga dingding kelngoichingpa chu koiham?
  </para>
  <para style="p">
    <verse number="45" style="v" />Hijeh chun Babylon douna-a Pakai thumop, Chaldea te douna-a alunggot, anangaito chu ngaijun, kelngoihon lah-a aneopen jong kikai manga, thonlou hella aumnao chu amaho toh kamhela alhatei ding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Babylon kilah dohna hu-ginin leiset ahot lingin, akanao namtin vaipi lah-a akijai.
  </para>
  <chapter number="51" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin hitin aseije, Babylon chunga chule alah uva cheng Keima eidouva pangho chunga, suhmangna huipi katildoh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman Babylon'a chang jap ho kasola, amahon ajap childiu; ajehchu lungkham nile aveluva adouvuva pang ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama douva thal choile ama douva janel lah-a kisong thal hemin athal lhahen; agolhanghou khen hih-un, ajanelpi chu sumangsoh helun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hitia chu Chaldea gamsungle khosung lamlen ho-a akithatho lhuchap ding ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Israel mithengpa douna-in agamu chonsetnin dimjongle, Israel le Judah chu a-Pathen'u janel Pakaiyin adalhapoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Babylon na konin jamdoh un lang, mitinin ahinna kihuh hinghen; akhangit lounao thipi hih-un, ajehchu hichehi Pakai phulah phat ahin, aman alethuh ding mong ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Babylon chu leiset pumpi khamsah, Pakai khutna sana khon chu ahi, namtin vaipin aju chu adon khamuva, hichea chu ngolgama ahitaove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Babylon chu alhu phungin akisumang tai; ama chu kouvin, ama chu damthei ding ahile, anatna nuding thingnailou lauvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Babylon chu kadamsah nom-in, ahinla adam chompoi; dalhauvin, igam cheh-a kicheo hite. Ajehchu athu kitan lhah na-in van asun, vandum gei sana kidomsang ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakaiyin ichon phatnao aphongdoh tai. Hungun, Pakai i-Pathen'u thilbol Zion'a seichoi juhite.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thalchang ho notvalun, lumho chom khomun, Pakaiyin Mede lengte lung asuthoutai. Ajehchu atup chu Babylon dinga suhmang ding chu ahi, ajehchu hichu Pakai phulah, a-houin phulahna ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Babylon kulbang vuma ponlap tungdoh-un, khongah hatsah-un, khongah ho tungdoh-un, ajehchu Babylon mite douna-a Pakaiyin asei chu agongtoh-in, atong chaitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo nang twi tamtah chunga chenga, gou haotah pa, nakichainale nakiloset tetohna chu ahung lhungtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Janel Pakai chu amatah akihahselin, aseije, khaokhoho tobang hela mihem'a kahindip teitei ding nahi, amahon nangma douna-a ahin aodiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathen'in athaneina-a leiset asema, achihna-a vannoi atundoh-a, ahetchetna-a kona jong aphajal ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman a-aw asodoh teng, van ho-a twipi tamtahpi ahung umjin, kolmong ho-a konin twimei akaltou sahjin, kolphele go asemin, hui chu akikholna-a konin alhadoh jin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mitin ahetnaova ngola ahiuvin, thil podoh takip semthu milima kijumso ahiuve. Ajehchu amilim semthu uchu joubulom ahin, amaho-a haitheina hu aumpoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hicheho chu mohseh, thilbol dihlou ahin, gotna akipeh phat tengule mangthah cheh diu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jacob chanvang hicheho tobang chu ahipoi, thil jouse kipatna ahi. Israel chu agoulo moljol ahin, amin chu janel Pakai ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangma kagal heichale kagalvonho chu nahi. Ajehchu namdangho chu nangma-a kasuhchipma, nangma-a lenggam ho kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangma-a sakolle achunga toupa kasuh chip ding, chule nangma-a kangtalai le achunga atoupa kasuhchip ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangma-a pasal le numei kasuhchipma, tehse le khangthah kasuhchip ding ahi, chule nangma-a nungah le gollhang jong kasuhchip ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangma-a kelngoichingpa le akelngoihon jong kasuhchip ding, nangma-a loubolpa le abongchalho koljon, chule agal lamkaiho le vaihomho kasuhchip ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule nangma mitmu tah-a Zion chunga athilsebol jouseu chu Babylon'a le Chaldea te chunga kachuhsah ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="25" style="v" />Leiset pumpi sumanga vo suhmangna mollen, vetan kadou nahi, tin Pakaiyin aseije, nachunga kakhut kalhan doh-a, songpi ho-a kona kejel lhah-a, akavamsa mol kaso ding nahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nanga kona in-ning song dingle inbul song ding alah lou diu ahitan, ahinla a-itih-a kamhel ding nahitai, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gamsunga ponlap khat tahdoh-un lang, namtin vaipi lah-a sumkon mut un lang, ama doudin namho gongun lang, Ararat, Minni, chule Ashchenaz lenggam ho ama doudin gallamkai semun lang, khaokhoho bangin sakol ho hungtou sah-un.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama doudin namho, Mede lengte, agal lamkaihou, avaihomho jouse, aloinehna gam jouse gonguvin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuche Babylon gam chu kihot hotna lungdong diu ahi. Ajehchu Babylon gam chu chenna louva akamhelna dinga Pakai thilgon jouse guilhung ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Babylon gal hat ho galsat ahaijun, akul sunguva aumden taove. Ahatnau adailhatan, numei asohgam taove. Achendetnau ahal lha uvin, akotgol hou abong gamtai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thusep khat chu achomto kisuto ding, thangkou khat chu achom khatto kisuto-a, akhopi chu among khatna konin akilatai ti hil dingin Babylon gama alhaijun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lampiho atutanun, pumpeng aneihou meija akihal lhan, gal hat ho akichagam taove.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ajehchu janel Pakai, Israel Pathen'in hitin aseije, Babylon chanu chu phol tobang ahin, ama kivoh phat ahitai. Hijengjongle chomcha khat joule achang atphat hunglhung ding ahitai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Babylon lengpa Nebuchadnezzar'in einechaijin, eisugoijin, belhomkeo eisotai, dragon bangin eival lhumin, kasa atuilai jouse anevasetnin, aman eipaidoh tai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Keile katahsa chunga hunama eikibol naho, Babylon chunga umhen tia Zion'a chengten aseijuva, Jerusalem in kathisan Chaldea te chunga chuhen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hijeh-a chu Pakaiyin, Veovin, nangma lama pangin ting, naphu lahpeh inge, chule atuipi gotsah ingting, atuinah kansah inge, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Babylon chu hung kilhu vuma, dragonho chenna mun, datmo umle chehsatna, mi chen louna hung hiding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amaho keipiho banga kitum khomuva, keipibahkai nouho banga ngih ngihdiu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Akhampetnule agolvah-u kabolsah-a kakhamsah ding, hitia chu kipah thanomuva, a-itih-a ihmuva, thoukit talouhel ding ahiuve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="40" style="v" />Athat dingpa henga kelngoinou kakaisah-a, kelngoi chalto kelchal kikai banga amaho chu kapuisuh ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Sheshach chu iti kimat ham? Leiset pumpi vahchoipa chu iti datmo um hitam? Babylon chu datmo um iti hungsoh hitam?
  </para>
  <para style="p">
    <verse number="42" style="v" />Babylon chu twipin achuptan, chuche twinong tamtah chun akhutai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Akhopiho chu akamhelin, gamgo, gamthip, mi khatcha chenlouna gam, mihem chapa khatchan ajotpa louhel asohtai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule Babylon sunga Bel chu talen kapeh-a, aval lhumsapa kamsunga kona kiloidoh ding; chule namtin vaipi chu ahenga hung kilhonlut khomkit talou ding ahiuve, Babylon kul chu chimlha ding ahitai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kamite, alah-a konin potdoh-un lang, Pakai lungsat tijat umtah-a konin nangma cheh hinna kihuhhingun.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ajole nalungu hopmintin, chuche gama kijading thuthang jeh in tijagetnun nate, kum khatle thuthang khat hung lhungin tin, chujou kum khatle thuthang khatma, chule gamsunga hunam patna, vaipole vaipo kidouna hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hijeh chun veuvin, Babylon'a milim kikhengho thu katanna ding nikho ahung lhunge, agam pumpi jahcha-a, ami kithat jouse agamlaija lhuchap ding ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuteng vanle lei, chule asunga umjousen Babylon jeh-a penga la asahdiu ahi. Ajehchu sahlama kona asumangho ahenga hung ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="49" style="v" />Babylon'in Israel atha-a alhuhsah banga chu, leiset pumpi kithat chu Babylon'a chudiu ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Nangho chemjam'a hoidohho chemangun, dingden hih-un, gamlatah-a konin Pakai galdoh un, nalunguva Jerusalem chu geldoh jingun.
  </para>
  <para style="p">
    <verse number="51" style="v" />Houset kajah jeh-un kajum-un, jachatna-in kamaiju akhutai. Ajehchu Pakai ina muntheng sunga gamdang mi ahung lutnuve.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hijeh chun veuvin, nikho alhunge, Pakaiyin aseije, amilimhou chunga thu katan ding, chule agam pumpi-a mapuho peng ding ahiuve.
  </para>
  <para style="p">
    <verse number="53" style="v" />Babylon chu van'a kaltouhen lang, akulsung chu detsah jengjongle, keija kona ahenga misumang ho hungnalai diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="54" style="v" />Babylon'a kona kana le Chaldea gama kona suhmangna nasatah husa athongin,
  </para>
  <para style="p">
    <verse number="55" style="v" />Pakaiyin Babylon asim jeh-a, a-awginu nasatah chu athipsah-a, akinon ginu chu twi tamtah nasatah kinon gin tobang ahin, a-awginu chu a-ong jeju jengin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ajehchu misugam ahenga ahungin, Babylon chungtah-a chun achun, amihatteu aman gamun athalpiu cheh-u abong gamtan, ajehchu lethuhji Pakaiyin alethuh tei ding ahitai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chule apipuitele amichingte, agal lamkaiho le avaihomte, chule amihatte kakhamsah gam ding ahi, amaho tonsot imutna ihmuva, thoukit talouhel ding ahiuve, tin lengpa amin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="58" style="v" />Janel Pakaiyin hitin aseije, Babylon kul nasatahho chu chimsoh hela, akotpi bangho kavamsoh ding ahi, miten mohseh-a atohgimuva, amahon mei dinga bou acholpi dingu ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Judah lengpa Zedekiah Alengchan kal kum lina-a Maaseiah chapa Neriah Chapa Seriah, Zedekiah to Babylon lama achepet lhona Jeremiah themgao'in athupeh; chule hiche Seriah hi lenga thil le lo ching pipuipen ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Hitichun Jeremiah chun Babylon chunga thilse hung chuding jouse, Babylon chungchang thu kisun jouse jong lekhabu khatna asunlutne.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chuin Jeremiah chun Seriah jah-a, Babylon'a nahunga, hiche thuho hi namu ding, chule aboncha nasimding ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chuteng nangman nasei ding ahi, Vo Pakai, nangman, asunga mile sa khatcha jong umlouhel dinga kisumang hela, a-itih-a kamheljo ding ahi, tin hiche mun douna-a thu naseitan ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chule hiti ding ahi, lekhabu hi nasim joutengle, song khat toh nakanbeh-a, Euphrates lailunga naselut ding ahi:
  </para>
  <para style="p">
    <verse number="64" style="v" />Achunga kahinpohlut ding thilse-a kona thoudoh lou dinga, hiti ahi Babylon lhalut ding ahitai, nati ding ahi. Chule amaho chollheh diu ahi. Hichanhi Jeremiah thuho chu ahi.
  </para>
  <chapter number="52" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zedekiah chu leng ahung channin kum somni le khat ahin, Jerusalem'a kum somlekhat alengchange, anu min chu Hamutal ahin, Libnah kho-a Jeremiah chanu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman Jehoiakim boljouse bangin Pakai mitmun thilse abolin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun Pakai lunghanna konin Jerusalem le Judah gamsung chu amasanga kona apaidohhel kahsen ahung hitin ahi, Zedekiah chu Babylon lengpa dounan akiphinin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin alengchan kumko lhinkum, lhasom channa, nisom na-a chun ahitin ahi, Babylon lengpa Nebuchadnezzar chu asepaite jouseto Jerusalem satdin ahungun, amaidon na chun ponbuh asongun, akhopi kimvela galkul akaikhum taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Zedekiah lengpa lengchankal kum somlekhat lhin geijin khopi chu aumchah taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin lhalina niko nin khopi sunga chun kel akhohtan, gamsung mite din nehding abeitei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin khopi chu akehtan, galbol miho jouse chu khopi-a konin jan-in, kulbang ni kah-a lengpa hon lampi kotpi-a chun ajamdoh-un, (tun Chaldea te chu khopi pam kimvela panga ahiuvin) Phaicham lampi chu ajon taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Chaldea sepaiten lengpa chu anungdelun, Jericho phaichama Zedekiah chu aphapao vin, asepaite jouse ama-a konin akithecheh taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin lengpa chu amanun, Hamath gama Riblah a Babylon lengpa henga apui taove. Hia chun achunga thu atanlhatai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Babylon lengpan Zedekiah chapate chu amitmu tah-in athatnin, Judah pipuiho jouse jong Riblah a chun athat gamtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin Zedekiah mitchang teni chu akaldoh peh-in, Babylon lengpa chun thihkhaovin akanin, Babylon lama akaijin, athi nikho geijin songkul'a ahentai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun lhanga na, chuche lha nisom na-a chun, hichu Babylon lengpa Nebuchadnezzar lengchan kum somleko lhinna ahin, Babylon lengpa kinbol, sepai gal lamkai Nebuzaradan chu Jerusalem'a ahungin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakaiyin le lengpa in, chule Jerusalem'a in ho ahalin, milenho in jouse jong meijah ahalvam soh heltai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin sepai gal lamkai toh hung kilhon Chaldea sepai jouse chun Jerusalem kimvela kulbang jouse avochim soh hel taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin sepai gal lamkai Nebuzaradan'in miho lah-a migenthei phabeple khopi sunga umnalai amohho, Babylon lengpa henga kipelut ho, chule mipi dangho chu sohchangin akaimangtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla sepai lamkai Nebuzaradan'in gamsunga genthei phabep chu lengpilei lhoudingle ngahdin adalhatai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai insunga um sum-eng khompihole akitun naho, Pakai insunga sum-eng twikong jong chu Chaldea ten avoseovin, asum-eng jouse Babylon'a apotaove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khangbel lenho jong, vutloho, chaicheho, kongtong ho, meivah khomho, thihkheho, akinbolnao sum-eng lheng, lhengkong ho apomangsoh taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule khon neoho le vutloho, kongtong ho, khangbel lenho, meivah khom ho, thihkhe ho, chule khon ho, sana-a kisem chu sana in, dangka-a kisem chu dangka-in, sepai lamkaipa chun akilah-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khompi ni, twikong khat, atunna noija sum-eng bongchal somleni, hichu Solomon lengpan Pakai insunga asem ahin, hiche lheng le khonho jouse sum-eng chu te jouhoi ahipoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khompi thudol; khompi khat chu asandan tong somleget, akimvel tong somlenin akol khumin, hichu bel li sa-a ahin, asung hom ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Achunga sum-eng luboh khat aumin, aluboh khat chu tong nga sanga, alubohho chung chu kolbuthei lima themneltah-a kijempah ahin, aboncha sum-eng jeng ahi. Sutpi nina jong chu hiche tobangahi kolbutheija kijempah ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Apang khatna kolbuthei somko le gup cheh aumin, themneltah-a kijem chunga chu kolbuthei jakhat-in akimvel ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin sepai lamkaipan thempulen Seraiah le thempu ni channa Zephaniah chule kotngah thumho chu akaijin;
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman gal hat ho chunga vaipo nukiso pa, khopi sunga um lengpa koma umjing le akivoppi jing mi sagi, sepai janelho lekhasunpa, khopi lailunga kimudoh gamsung mi somgup jong khopi-a konin akaidoh in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitichun sepai lamkai Nebuzaradan'in amaho chu Babylon lengpa henga Riblah ah akaijin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Babylon lengpan amaho chu ajepmin, Hamath gama Riblah mun'a athatgamtai. Hitobang chun Judah chu amatah gama konin sohchangin akaimangtan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichehi Nebuchadnezzar'in sohchanga akaimangho chu ahi. Alengchan kum sagina chun Judah te sangthum le somni le thum ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nebuchadnezzar lengchan kum somlegetna in Jerusalem'a konin mi jagetle somthumle ni akaimangin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nebuchadnezzar lengchan kum somni le thum lhinna in sepai lamkai Nebuzaradan'in Judah te jasagi le somli le nga akaimangin, abonun mi sangli le jagup ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Judah lengpa Jehoiachin sohchan kum somthumle sagi lhinna, lha somlenina, chuche lha nisomni le nga nin ahitin ahi, Evil-Merodach Babylon lengpa chu alengchan kum khatna chun, Judah lengpa Jehoiachin lu chu adomsangin, sohchan na-a konin apuidoh-in ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ama chu lungset tah-in ahoupin, Babylon gamsunga alengchanpi ho laltouna vuma alaltouna adosangpeh penin,
  </para>
  <para style="p">
    <verse number="33" style="v" />asohchanna vonho akhelpeh-in, ahinkho lhumkeijin amasangah changlhah anejom jingpehtan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule aneh le chah dingin, Babylon lengpan tahsa phatnading anpha ape jingin; ahinkho lhumkei, athini geijin tanglouvin niseh-in apejing tan ahi.
  </para>
</usx>
