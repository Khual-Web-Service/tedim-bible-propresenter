<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JAS" style="id">Jacob</book>
  <para style="h">Jacob</para>
  <para style="toc1">Jacob</para>
  <para style="toc2">Jacob</para>
  <para style="mt">Jacob</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen le Pakai Jesu Christa soh Jacob'in, akithe cheh-a phung somle phung ni henga, salam.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasopiho, nangho patepna tintanga nachuh tengule, hichu kipanan gelun;
  </para>
  <para style="p">
    <verse number="3" style="v" />Natahsanu kipatep chun thohhat asosah chu heuvin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin nangho lhahsamna beihela nacham kimuva, napum lhin theina dingun, thohhatna chun anatoh tong chamkim molsohen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nalah uva khattou chihna-a lhasama aumle, it louhel le house louhela peji-a Pathen henga thumhen; chuteng kipe ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amavang ginchat lelna neilouhelin, tahsanna neitah-in thumhen; agingcha lela chu twikhanglen kinong hui mut lonle tobang ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutobang mi chun Pakaiya konin ima mu neijinge tin kinepda hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungtho nei michu achonna lam jouse-a detna nei lou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dinmun nemcha neija sopi chun choisanga aum jehchun kipah hen;
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin mihao chun suhnema aum jehchun kipah hen: ajeh chu hampa pah banga ama chu mangthah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu nisa satah-a ahung soteng, asat chun hampa louhing asanggojin, chule apah apul lhan, alimso hoi jong chu amangthah jitan ahi; chutobanga chu mihao jong alamlhah tinchenga molmang diu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lhepna thoh ham hama chu anunnom ahi; ajeh chu lhep patepna chu ajoa them achan jouva ahile Pakaiyin ama ngailuho peh dinga athutepsa hinna lallukhuh chu apeh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin lhepna-a nachuh tengule, Pathen'in eilhep ahi tin koiman seida hen: ajehchu Pathen chu ase lama kilhem patep theilou ahin, chule amanjong koimacha alhep patep lou ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi ama ama lung ngaichat thillin ajol lhah-a, aloi lutji-a, lhepna-a chujia ahibouvui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule alung ngaichat phalou chu naovop banga avopji teng chonset ahinji ahi; chule chonset chu apilhin tengle thina sohjia ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kasopi ngaiteho dohan lhalou jenun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thilpeh pha jousele phattheina chamkim chu chunga kon ahi, chule kikhelna le le-lim banga kihei jilou vahho Pa-a kona hung kumlhaji ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Athilsemho lah-a eiho hi aga masa loi khat ihi theina dinguva, aman ama lunggot doltah-a thutah-a chu eihinu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun, kasopi ngaitahho, amitakip angaina lama gang cheh hen, thu sei lama ngaikham cheh hen, chule lungsatna lama jong ngaikham cheh hen;
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihem lunghanin Pathen chonphatna asodoh sahpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche jeh chun nanghon thenlouna jousele chon gitlouna long let chu puilhau vinlang, nalhagao huhhing theija thu kiphutsa chu lungnemin sangun.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin nangho nangmale nangma kilhem lha-a thu chu angai mai jeng hilouvin, thu chu abolajoh hiuvin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ijeh ham itile thu angai mai mai hia abola hilou mi khattou aumle, ama chu phatvet maija apenpi alim vea mi tobang ahi:
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajeh chu ama akiven achemangjin, chule ama chun alim itobang ahi apettah chule asumil jitan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahin chamkimkei chamlenna danthu chu vea, chua aum jom jinga, athu chu ngaija sumil mi hilouva, abola pang mi vang chu, hiche mipa chu athilbola chu nunnom ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nalah uva mi khattou ama hou ngaisah mi-a kingaito-a, alei tuhtang louva, ama lungthim kilheplhah-a aumle, hiche mipa chun ahou chu moh ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pa le Pathen anga houdan thengle kisuhboh lou chu: Nulou palouho le meithaiho agenthei ahesoh naova vila, chule vannoi leisetna kona boh beh louhela kithenso chu ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasopite ho, loupi Pakai, I-Pakaiyu Jesu Christa tahsanna chu mi dat neilou jennun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu naki khopnao in'a mi khat sana khutjem kibua, ponhoi lul kisil hunghen lang; chule pon sedihdeh kisil mivaicha khat jong hunghen lang;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon ponhoi lul silpa chu jabolun lang, Nangma hilaija hin nomtah-in touvin, tiuvinlang, mivaichapa jah-a chun, Nangma khukoma khun gadingin, ahiloule, kakeng todopma hin touvin, tileu chun:
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho nanghole nangho lah-a mi dat nanei uva, lung gilou pu-a vai nahomu hilou dingham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Kasopi ngaiteho, ngai phaovin, vannoi leisetna mi vaichaho chu Pathen'in tahsan na-a hao dingle, ama ngailuho peh dinga atepsa gam chu lo dinga alhendoh hilouham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla nanghon mivaicha chu noise tah-in nabol uvin ahi. Mihaoho chun nabolset jiuva, thutan na-a nakai lutjiu hilou ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amaho chun nakikou nao min ja umtah chu ataitomu hilouham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen lekhabu dan thu dungjuija, Naheng nakoma chu nangma naki ngailut bangin ngailun, ti Leng dan chu subulhit nahiu vangle, nabolu apha lheh jenge;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin dat naneiju vangle achonsea nahiuvin, chule dan sukhel tia danthu dungjuija themmo changa nahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin mikhatnin dan thupeh chengse nitsoh hen, khatpenah kisumo taleh, aboncha chunga themmo changa ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu, Jon pan hih-in tia seipa chun, Tolthat hih-in, tia jong asei ahi. Hijeh chun tun nangman jon panhih-in lang, ahin tolthat lechun, nangma danthu suhkeh chu nahi ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chamlenna danthu-a athu kitan dingho thusei bangin thu seijun lang, chutima chun bolun.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi chunga hepina neilou chu, hepina neilou hela athu kitan ahi; hepina chun thutanna chunga jona anei ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kasopite ho, mi khattouvin katahsan aume tihen lang, anatohla um hihhen hile, hichu ipi-a phachom dingham? Hiche atahsan chun huhhing theijintem?
  </para>
  <para style="p">
    <verse number="15" style="v" />Sopipa khat ahim, sopinu khat ahim pon beijin umhen, chule anikho anneh lhasamin umhen,
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho khatnin amaho jah-a chun, Lung mongin chen, lum sanlang vaset tan, tiuvin; amaho chu tahsa ngaichat thil pe louvin umleu chun, hichu ipi-a phachom dingham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche banga chu tahsan jong anatoh beija chu achanga athisa ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin mi khattouvin, Nangma natahsan aumin, keima kanatoh aume tinte: nanatoh beijin natahsan chu neivetsah temin, chule keiman natoh-a konin katahsan vetsah inge.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangman Pathen khatseh aumme ti natahsane; nabol hoije: thilhahon jong atahsanui, agina kihot hot ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin, vo mi gichanglou, nangman anatoh beija tahsan athisa ahi chu nahet nom em?
  </para>
  <para style="p">
    <verse number="21" style="v" />Ipuluiju Abraham'in achapa Isaac maicham chunga atodoh-a chu, hiche anatoh chu ama dinga chonphatna-a kisima hilou ham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Itobanga tahsan chun anatoh chu ahua, chule natoh vanga tahsan chu kisu chamkima ahi ti namuvem?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichea chu, Abraham'in Pathen atahsanin, chule ama dingin hichu chonphatnan akisimtan ahi, ti Pathen lekhabua thu chu guilhunga ahi; chule ama chu Pathen jol tia kikou ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tahsan jengseh vang hilouva, natoh vanga mi chonpha tia kisim ahi chu namuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule chutobangma chu Rahab notinu jong chun thupole ho chu a-in'a alhunsah-a, chua lam chom danga asolmanga ahile, hiche anatoh vanga chu amanu chu achonpha-a kisima hilouham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Lhagao beija tahsa athisa ahi banga, tahsan jong natoh beija athisa ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasopite ho, midangho sanga eiho gihsajoa mo ichan dingu chu heuvin lang, tamtah mihil-in pang hih-un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh chu eiho ibon chaovin thil tamtah-a ikipaljiuve. Thua kipalna neilou chu mipha chamkim ahi; ama chu ati apumpia jong tuhtanga athua hei thei ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Veuvin, sakol khu ithu nun theina dinga akama kamdal ivo-u ahi; chuteng apumpia igot gotna-a kihei thei ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kong-innei jong khu veuvin, lentah ahia, hui hat nasatah-in atol ahivangin, hichengpi chu ahehna neocha-a chu aheh heipan agotna lam lama aheile ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutobanga chu lei jong hi tibah neocha khat ahi jeng vangin, hoithona thu nasatah aseijin ahi. Veuvin, mei themhal chan gam lentah iti akahsetji hitam!
  </para>
  <para style="p">
    <verse number="6" style="v" />Lei hi mei ahi; tibah lah-a lei hi chonsetna dim vannoi leiset ahi; hichun ti pumpi hi asuhbohjia, penpi hinkho lampi chevelkolna hi akahsetjia, chule amatah damun meija kaji-a ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sa namkim, alha leng vacha namkim, ganhing namkim, gul namkim, twija cheng ganhing namkim vahngoi thei ahi sohkeijun, mihem vahngoi jin aumun ahi:
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin lei vanghi koiman avahngoi theipoi; ama hi umthim thei lou gitlouna le thina gu dimset ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichea chun Pathen le Pa chu ivahchoi jiuvin; hiche mama chun Pathen lima kisema mihemho isamse jiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kamsung khatseh-a kon chun pachatna le sapsetna asoh khomjin ahi. Kasopite ho, hichu chuti dingdol ahipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Twinah kohom khatseh-a khu twi atwi le akha put khomji am?
  </para>
  <para style="p">
    <verse number="12" style="v" />Kasopite ho, theichang phunga Olive ga theijam? lengpi guija theichang ga theijam? hitichun twinah khat na konin chitui le twitheng aput khom theipoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nalah uva michingle hetthem theina nei koiham? Ama chun umchan themin anatoh chu nunnem na le chihna-in vetsahhen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla nalung sunguva kithangset hat le kilungdou naneiju vangle, kithang-at loujenun, chule thutah douna jou seihih-un.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutobang chihna chu chunga kona hung kumlha-a ahipoi; amavang leiset le tahsa-a chule Diabol'a kon ahibouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kithangset le kilungdou umna-a chu kinahna le gitlouna um tei ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chunga kona hung kumlha-a chihna vang chu amasapena atheng ahin, chule abana kichamdel, lungnem, houlung dambai, hepina-a dim, chule ga pha, dat neilou le, phatlhemna umlou ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule chonphatna ga chu chambolteho chunga kichamdela kitu-a ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nalah uva gal kisatle kinahna hi hoija konham? Natibah lah uva nomsah ngaichatnaho kisatto-a kon chu hilouham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanghon nangaichauvin ahinla naneiji pouve; tol nathat jiuvin, neiding nagojiuvin, nanei theiji pouve; nakinaovin nakisatto jiuvin, ahinla nathumji lou jeh-un naneipouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nathumun ahinla namu pouve; nangma nangma nomsah-a manchah nagotji jeh uva, nathumu nakhel jiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo numei le pasal jongho, vannoi toh kihouthei hi Pathen to kigalna ahi ti helou nahiuvem? Hijeh chun koihile vannoi toh kihouthei go-a chu Pathen melma ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isunguva cheng Lhagao hin thangthipna angaichat ahi, tia Pathen lekhabua kisei khu kimohsei hija nangaitou ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti sangin lungsetna eipehbe jobovui. Hijeh-a chu aman, Pathen'in mi kiletsahho chu alethuhjin, mi kineosah ho lungsetna apei, tia asei ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti ahi jeh chun nangho Pathen henga kipelut un. Diabol vang chu lethuh-un, chutile nakom uva konin jammang tante.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen kom naijun, chutile Ama nangho kom hung nai ding ahi. Vo michonseho, nakhut suthengun; chule lungtho neihon, nalung sungu suthengun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kisih-un, lunghemun, chule kapmun; nanuiju chu kana chule nakipao chu lungkhamna soh hen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai mitmu-a kisunem mun, chutile aman nachoi sang dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kasopite ho, kiseiseto hih-un. Koi hile asopi seise-a chule asopi thu khola oimo-a chu, dan thupeh seise-a, dan thupeh khola oimo-a ahi: ahin nangman danthu chu nakhola na-oimo vangle athu nit hilouva athu tanjoh nahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Danthu pe-a khatsehbou aume, Ama chu huhhing thei jong sumang thei jong ahi. Ahin nangma koi nahi-a, midang thu natan ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Tun veuvin, nangho mi kimkhatsen, Tunin ahim, jing ahimle, hiche khopi-a khun cheohitin kum khat gathamu hitin, kiveiju hitin, kivei kanu hite, nati uve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jinga ipi ahung so ding nanghon nahepouve. Nahinkhou chu ipiham? Twimei chomkhat kimu-a chujoule kimujita lou tobang khu nahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chusangin, Pakai lunglam ahile, hingjing ungting, hiche na hi, khuche na khu tonging kate, tijovin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla tun nanghon naham hoithonao chu naki thang-at piuve; hiche kithang-at naho chu phalou ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche jeh chun mi koi hile thilpha bolje hena-a bol lou chu achonse ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun, veuvin, mihaoho, nangho chunga hesoh gentheina hung chu ding chengpi jeh hin kapmun lang pengun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanei chengseu amon mangtai, naponu lungin anese joutai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nasana nadangkau thih-eh souvin aneheng gamtan; chule chuche thih-eh chu nathemmonao hettohsah-a hungpanga, chule mei banga nasao aneh ding ahi. Nanghon ni nununga dinga gou nakholu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Veuvin, nalouva chang at sum thalo ho thaman, doha nabol uva napeh dahou chun kho asamun; chule chuche sum thalo chang at teho khosap chu Janel Pakai nabeng sunga aluttai
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangho vannoi leiset chunga nomsa le ninglhinga nachengun; kitha nikho-a bangin nalungu nasuthao vun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon michonpha chu themmo nachanun nathatnun; chule aman nangho nadou thuhpouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti ahi jeh chun, sopiteho, Pakai hung masangsen lungdehat jingun. Veuvin, loulhou mi khun aleiset ga lutah chu angahjin, gotwi lha masale gotwi lha nunung amu kahsen alungdehat jin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangho jong lungdehat jingun; nalungu detsah jingun: ajeh chu Pakai hungna ding anaitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo sopiteho, oimo nachan louna dingun khatle khat kiphun loujenun; veuvin, thutanpa chu kot bula ading jinge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo sopiteho, Pakai mina thu seidoh themgaoho chu hesoh genthei thoh le lungdehatna lama vettonin neijun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Veuvin, dingdet jinga thoh lhumho khu eihon anunnom itiuve. Nanghon Job thohhat thu chu najaove; chule Pakaiya achaina umchan jong namu taove; Pakai chu khotonale mihepina-a dimset ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin, sopiteho, imajouse lah-a apipen chu hiche ahi, kihahsel hih-un, van panin hijongle, leiset panin hijongle, kihahsel hih-un; chusang chun ahi natiu chu ahi hihen, hilou natiu chu hilou hijenghen; achuti loule themmo changin umkhaovin nate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nalah uva athohgima umam? Ama chu taohen. Kipah thanoma umam? Vahchoina la Sahen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nalah uva ana damlou umam? Ama chun houbung upaho kouhen; chule amahon Pakai minin ama chu thao nu-uhen, achunga taovuhen;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutile tahsana taona chun anapa chu damsah-intin, chule Pakaiyin ama chu akaithou ding; chule achonse ahi jongle, hichu suhbeija umding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun nadam theina dingun, khatnin khat komah nasuhkhelnao phongun, khatle khat kitaopeh jiuvin. Michonpha mi taopehna chu thil nasatah bol thei ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Elijah chu eiho penpi ngai banga hesoh genthei thoh mi ahivangin, gojuh louna dinga lunglut tah-a ataole, leiset chunga kum thumle lha gup gam sung go ajutapon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin atao kitnin ahile, van'a konin go ahin juhsah-in, leijin aga asodohtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kasopite nalah uva khattou thudih-a kona lamvaija auma, ama chu khattou ahinlepui lut kit aumle,
  </para>
  <para style="p">
    <verse number="20" style="v" />Michonse alamvaina-a kona hinlepui kitchun thina-a kona lhagao khat ahuhhing ding ahin; chule chonset tamtah akhu ding ahi, ti kihet hen.
  </para>
</usx>
