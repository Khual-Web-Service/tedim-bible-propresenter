<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="REV" style="id">Thuphon</book>
  <para style="h">Thuphon</para>
  <para style="toc1">Thuphon</para>
  <para style="toc2">Thuphon</para>
  <para style="mt">Thuphon</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu Christa thuphondoh, Pathen'in asohte hetsah dinga apeh, thil hung sohvah dingho chu; aman avantil asola asoh John ahetsah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama chu Pathen thudol le Jesu Christa hettohsah thudola athil muho jouse thu umchan chu ahettohsah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche lhagao thuseidoh ho sima, chule ja-a, chule asunga kisun thuho chengse nitna chu anunnoma ahi; phat anai jeh hin.
  </para>
  <para style="p">
    <verse number="4" style="v" />John'in Asia gama um houbung sagiho hengah: Auma, Aumsa, chule Ahung umdinga konin; chule alal touna anga kona Lhagao sagi-a konin; chule athiho lah-a kona peng masapen, leiset lengho jouse vaipo;
  </para>
  <para style="p">
    <verse number="5" style="v" />athu hettohsah ginchat umtah Jesu Christa-a kon chun lungsetle lungmonin umpiuvin. Eiho eingailua athisana ichonset chengseova kona eisoptheng uva,
  </para>
  <para style="p">
    <verse number="6" style="v" />chule avaipohna gammi le a-Pathen le a-Pa thempu-a eisemuva chu, loupinale vaipoh thuneina atonsot atonsot geijin ama-a hi jinghen, Amen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veuvin, ama meihotoh kilhonin ahunge; chule mit jousen, asunhotah jong chun amu dingu ahi; chule leiset namtinle phungtin-in a-op achupchup dingu ahi. Chuti chu ahi, Amen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Auma, Aumsa, chule Ahung umdinga, Hat chungnung Pakai chun, Keima Alpha le Omega, apatna le achaina kahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu'a um thohhatle leng gam chule hesoh genthei nathoh khompiu nasopiu, John, keima Pathen thule Jesu Christa thu hettohsah jeh-a Patmos twi twikol'a chu um kanahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai nikho ni-a chu keima Lhagaova kaum ahi; chule sumkon gin tobang awgin nasatah khat kanung lama kajan,
  </para>
  <para style="p">
    <verse number="11" style="v" />Keima Alpha le Omega, amasa le anunung, kahi: Nathil mu chengse lekhabu-ah sunin lang, hichu Asia sunga um houbung sagi-a: Ephesia, Smyrna, Pergamos, Thyatira, Sardis, Philadelphia chule Laodicea-a gahthotnin, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin kajah-a thuseija aw chu ve dingin, keima kakiheijin ahi. Chuin kakiheitan ahile, sana meivah khom sagi kamui;
  </para>
  <para style="p">
    <verse number="13" style="v" />chule meivah khomho lah-a chun khat mihem chapa tobang, aponsil akhophanga lenglha, sana konggah a-opkonga kigah;
  </para>
  <para style="p">
    <verse number="14" style="v" />aluchangle asam kelngoi mul banna banga, buhbang tobang ahin; amit meikong tobang ahi;
  </para>
  <para style="p">
    <verse number="15" style="v" />akengho chu lhum sunga kigoujol sum-eng kinotval tobang jeng, chule a-awgin chu twi tamtah gin tobang jeng ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule akhut jet lama ahsi sagi achoijin, akam sunga konin hemto chemjam ahema hem ni ahungdoh-in ahi; chule ama melso chu nisa hasattah-a asat pettoh abangin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ama kamu phat chun keima athitoh kabang jengin akhophang bulah kalhu jengin ahi. Hichun aman akhut jet lamin eithamin, kajah-a, Kicha hih-in; keima hi amasale anukhah kahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ahing jinga chu kahi; keima athisa kahi; ahinla, ven, a-imatih chana dingin kahinge, amen; chule thinale damun kot-heh kaneije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun nathilmu chengsele aum chengse chule ahung umding chengse abonchan sunin;
  </para>
  <para style="p">
    <verse number="20" style="v" />kakhut jetna ahsi sagi namuho chule sana meivah khom thuguh hi sunin. Ahsi sagi chu houbung sagi solchah ahin, meivah khom sagi chu houbung sagi ahi, ati.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ephesia'a um houbung solchah hengah hiti hin sunin: Akhut jet lama ahsi sagi choija sana meivah khomho lah-a vahlea chun hitin aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nanatoh ho jouse, chule nathohgimle nathohhat chu kahei; chule, Solchah kahi, tia solchahla hilou, amaho jong chu napatep-in, nakholjin ajou namandoh jengin ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />chule thohhat tah-a kamin jala thoh thoh-a lhadah lou nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin nachunga demna kaneije: nangman nangailut masa chu nalhatai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche jeh chun nangma hoija kona nalhuh ham; hichu geldoh-in, chule nalung heijin, nanatoh masah ho chu tongin; achuti louva nalung nahei loule, nahenga gangtah-a kahunga nameivah khom chu aumna-a kona kachon mang ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla Nicolaitan ho chon keiman kahot chu, hicheho chu nangman jong nahon ahi, hiche phatna chu naneije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nakhang nei chanin houbung ho jah-a Lhagao thusei hi ngaihen. Ajouva chu keiman Pathen ollim daija um hin thingga kanehsah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Smyrna-a um houbung solchah hengah hitin sunin: Amasale anukhah, thitasa hing kit chun hitin aseije:
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman na natoh nagenthei, nahesoh chule navaichat kahenai (ahin nangma nahaonai), Juda mi kahi, tia Juda mi hilou, Satan vaipi kikhopnajoh ahiuva, hou thu ataitomu jong chu kahenai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thil nahinthoh dingho hi kicha hihhelin; ven, napatep na-a nalah uva mi abang bang chu diabolin songkul'a akhum ding koncha ahi; chule hesoh genthei ni som nathoh dingu ahi. Nangman nathi geijin tahsanin; chule keiman nangma hinna lallukhuh kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nakhang nei chanin houbung ho jah-a Lhagao thusei hi ngaihen. Ajouva chu thi nina chun asuhnat lou ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Pergamos'a um houbung solchah henga hitin sunin: Hemto chemjam ahema hem nei Pan thu hicheng hi aseije:
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangma na natoh chule hoi laija cheng nahi kahenai, Satan laltouna muntah chu ahi; chule nangman kamin natuh det jinga, chule Satan chenna nangho lah-a ginchat umtah, kathu hettohsah Antipas, atha laiju sana jong keima tahsana seilep lou nahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin nachunga demna thil themkhat kaneije, ajeh chu Israel chate masanga kipal lhuhna koija, milim houna sa nehsah dingle jonsahna dinga, Baalak lungthim pe-a hila, Baalam thuhil choija hikoma chun naneijui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutobangma chun kathil ki-dah pen Nicolaitan ho thuhil choija jong naneijui.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun nalung heijin; achuti loule nahenga gangtah-a hung ding kahi; chule kakam sung chamjama amaho chu gala kasat ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nakhang nei chanin houbung ho jah-a Lhagao thusei hi ngaihen. Ajouva chu guhthim manna kapeh ding ahi; chule songkang khat jong kapeh ding; hiche songa chu min thah khat kisuna ahi; asangpa tailou koimacha dangin hiche min chu ahepoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thyatira-a um houbung solchah hengah hitin sunin: Amit meikong tobanga, akhophang sum-eng kinotval bangah Pathen Chapa chun hitin aseije:
  </para>
  <para style="p">
    <verse number="19" style="v" />Nathilbol jousele, nangailut chule natahsanje, chule nalhacha natoh hole, nathoh hatje, chule nathilbol masah sanga nathilbol nunung anasatjoh chu kahenai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin nachungah demna kaneije, nangman Jezebel kithemgaosahnu chu navethim in naum sah-in ahi, ama chun jonthanhoi dingle milim houna sa neh din thu ahilin, kasohte alhemlhan asulamvaijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman hinu chu alung heina ding phat kapeh ahi; ahinla aman ajon thanhoija konin alung ahei nompoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Veuvin, keiman amanu chu ajalkhuna kajamhel ding ahi; chule ajonpiho chengsen jong amanu chonna-a kona atanuva alung ahei louvule, hesoh gentheina chungnung tah-a kalelut ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule thi gamna-a achateho katha gam ding ahi; chuteng chule houbung jousen keima lungthim gille lungsung kholtoh soh kahi, hi ahet dingu ahi; chule keiman nangho nathilbol dungjui uva kapeh cheh ding nahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahivangin Thyatira-a amoh nalah uva um, hiche thuhil chu jop lou aumin, mi abanghon thugil atiu, Satan thugil chu helouho chengse chu, najah uva kasei ahi, nangho chunga pohgih imacha dang belap ponge.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahin nanei sun-u chu kahung kahsen tuh det jingun.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule ajouva akhon ni geija kathilbol chengse nit chu, keima pa-a kona kamu banga, ama chu namtin vaipiho chunga thuneina kapeh ding ahi;
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutengle ama chun thih tenggola vai ahoma beldengho bel akea ahal hala aum banga, abolding ahi;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule keiman ama chu Jing Valpa kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nakhang nei chanin houbung ho jah-a Lhagao thusei hi ngaihen.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Sardis'a um houbung solchah henga hitin sunin: Pathen Lhagao sagile ahsi sagi neija chun hitin thu aseije: Keiman nathilbol kahenai, nangma amina ahinga nahin, hinla athisa nahibouve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khangin lang hah jingin umin; chule adang athikonho chengse chu suhalin din detsah-in; ajeh chu Pathen mitmu-a nathilbol achamkimsa imacha kamupoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun nangman atila iti natahsana, iti najah ham, hichu geldoh-in, hichu nitphan, chule nalung heijin. Hah jinga naum louva ahile, gucha banga nahenga kahung ding ahi, chule itih phatle naheng kahinsuh nahet louhel ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla apon kisuhnen lou mi phabep khat Sardis'a aumui; amaho chu ponbang vamleh silla keimatoh kavale dingu ahi; ajeh chu amaho hiche dinga chu kilomtah ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajouva chu ama jong chutia chu ponbanga kijem ding ahi; chule keiman ahing lekhabua kona ama min chu kathaimang louhel ding ahi; ahin ka Pa angsungle avantil chengse angsunga ama min chu kaseidoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nakhang nei chanin houbung ho jah-a Lhagao thusei hi ngaihen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Philadelphia'a um houbung solchah henga hitin sunin: Athengale adihtah, David kanglong heh neija, aman ahonle koiman khah thei lou, chule aman akhale koiman hong thei lou, ama chun hitin thu aseije:
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman nathilbol chu kahenai; ven, koiman akha thei lou kot honsan na-anga kakoije; natha vang alhome, chule kathu nanit jingin kamin naseilep poi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ven, Satan loi kihou khomna-a miho chu, Juda mi kahi tia Juda mi hilou, thu jou sei ahiuve; ven, chutobang miho chu abang bang nakhophang bula kalhuhsah-a chibai kabohsah dingu ahi; chutile keiman nangma kangailut chu amahon ahetdoh thei dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangman keima thohhat thu chu natuh det jeh-a hi, vannoi leiset chung cheng miho patep kholchilna-a vannoi leiset chunga hung lhung dingkon, hiche phatna kona chu keiman jong nangma kahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ven, Hung vahjet ding kahi; nalal lukhuh chu koiman nalahpeh louna dingin nanei sun chu tuh det jingin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajouva chu ka Pathen houin khoma kasem ding, chule chua kona chu potdohta louhel ding ahi; chule achunga, ka Pathen min, chule ka Pathen khopi Jerusalem khopi thah, van'a kona ka Pathen koma kona hung kumlha ding, hiche min chutoh keima min thah kasut ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nakhang nei chanin houbung ho jah-a Lhagao thusei hi ngaihen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Laodicea-a um houbung solchah henga hitin sunin: Amen, tahsan umtah chule hettohsah dihtah, Pathen thilsemho bul chun hitin thu aseije:
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman nathilbol kahenai, nangma votla navotpon, sala nasapoi; navotle votngalin, nasatle sangal lechun pha kasah ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiti chun sala nasapon, votla navotpon, alum dapdap bep nahi, hiche jeh-a chu kakama kona kakhondoh dingkon nahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman, Kahaove, sum kakholle, imachan kalhasampoi, natin ahi; ahinla nangmatah ada pen, khoto umtah, vaichatah, mitcho chule sagohkeu nahi chu nakihetpoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun nahaona dingin, meija kisong jola kilhatheng sana, chule sagohkeu nahi najachat kiphon louna dingin, ponbang sil ding nanei theina dingin, mit nu ding mitlou, hicheng chu keija konin kichoh-in, tia kathu mop nahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiman kangailut chan chu kaphosala kasehgimji ahi; hijeh chun nangma tompanin lung heijin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ven, keima kotkhah bulah kadingin kot kakiu jinge, mi khattouvin ka-awgin ajah-a kot ahona ahile, keima kasunglhah-a ama chu an kaneh khompi ding ahi; chule aman jong keima an eineh khompi ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman kajo-a ka Pa koma alaltouna-a katou banga hi ajouva chu kakoma kalaltouna-a katousah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nakhang nei chanin houbung ho jah-a Lhagao thusei hi ngaihen.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jou chun keiman kaven ahile, veuvin, van'a kot khat akihon kamun ahi, chule keima eikihoupia sumkon gin tobang aw amasa kajah, aw khat chun, Hiche lama hin hung kaltouvin, tu nunga thil hung soh tei dingho chengse chu kavetsah ding nahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichetah chun Lhagaovin kaumtan ahi; chuin, veuvin, van'ah laltouna khat akidon ahi, chule hiche laltouna-a chun mi khat atouvin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche-a toupa chu jasper songle sardion song bangin alange; chule laltouna kimvela chun lhagui aumin, emerald songtoh abangin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule laltouna kimvela chun laltouna somnileli aumin; hiche laltounaho chunga chun ponbang kisila alua sana lukhuh kikhuh upa somnileli atouvui.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule chuche laltouna-a kon chun kolphe, aw, chule van gin ahung sohdohjin ahi; chule laltouna maija chun meija kong jing jeng meivah sagi aumin, hichu Pathen Lhagao sagi chu ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />chule laltouna maija chun crystal songvala val phatvet twikhanglen tobang khat akimui; chule hiche laltouna ningtin le laltouna kimvela chun ganhing li aume; amaho chu amalam anunglam amit jeng amit jeng dimset ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ganhing amasapen chu keipitoh abangin, anina chu bongnou toh abangin, athumna chun mihem mai apui, alina chu alengle mulaopi tobang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche ganhing liho chun lhaving gup cheh aneijui; akimvel le asunglam amit jeng amit jeng dimset ahi; chule amaho chun, Athenge, athenge, athenge, Pakai Pathen, hat chungnung, aumsa auma, chule ahung umdinga chu, tin asun ajanin cholnga louhelin, ati, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche ganhingho chun a-imatih chana hing jing, laltouna-a toupa chu, avahchoi juva, ajaboluva, athangvah tengule,
  </para>
  <para style="p">
    <verse number="10" style="v" />upa somni le liho chun laltouna-a toupa anga chu lhujiuva, a-imatih chana hing jingpa anga chu, alallukhuh aselhah jiuva chibai abohjiuva,
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai, nangma bou vahchoile choi-at chule thilbol thei thahat changa lom nahi. Ajeh chu imajouse nangma sem ahi; chule nangma phatsah-a hicheng chu uma chule kisema ahi, atiji dingu ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin laltouna-a toupa khut jet lama chun, asunglam apolam alangtoa kisuna, sinkhana sagi-a kisinkha lekhabu khat kamun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin vantil hattah khat kamun ama chun, Hiche lekhabu hi phonga asinkhana lhamlha dinga lom koiham, tin hasap tah-in asamlen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin van'ah, leijah, lei noijah lekhabu chu aphong theile ave theija koimacha aumtapon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lekhabu chu aphong dingle asim dinga khatcha jong akiholmo jeh chun hakan kakaptan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun upaho lah-a khat chun, Nangma kap hih-in; ven, Juda phung Keipi chule David Jung chu hiche lekhabu phong dingle asinkhana sagi chu honglha dinga ajosohsa ahitai, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin keiman kaven ahile, veuvin, laltounale ganhing liho lailung-ah chule upaho lailunga chun Kelngoinou kithatsa lheh lheh khat adin kamui; ama chu aki sagile amit sagi ahi; hichu vannoi leiset pumpi-a kisol Pathen Lhagao sagi ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama chu ahungin laltouna-a toupa khut jet lama lekhabu chu alan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichu alah phat chun ganhing liho chule upa somni le liho chu Kelngoinou anga chun abohkhup taovin ahi; amaho chun akhutna selangdah khat chehle sana sumlheng, mithengho taona, gimnam twi dimset akichoi cheh-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amaho chun la thah khat asauvin, Lekhabu chu ala dingle asinkhana lhamlha dinga lom nangma bou nahi; ajeh chu nangma kithattasa nahi; phungtin leh chitin namtina mi, paotin paotanga mi, gamvaipi nam jouse-a mi Pathen'a dinga nangman nathisana nachoh doh ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen dinga amaho chu gamsung mile thempu-a napansah ahitai; chutia chu amaho chun vannoi leiset chunga vai apoh dingu ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin kagahvetle, chuche laltounale ganhingho chule upaho kimvela chun vantil asang aja aw kajan ahi; amaho chu sangsom tamtah jat sangsom, sang tamtah jat sang tamtah ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaho chun aw sangtah-in, Akithatsa Kelngoinou chu thahatna, haona, chihna, thaneina, choi-atna, loupina, chule pachatna chang dinga lom ahi, atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin van'a, leija, lei noija, chule twikhanglen'a thilsem jousen, chule chucheho lah-a um chengsen ahiti seiju aw hi kajai, Laltouna-a toupale Kelngoinou chu pachatle choiat, chule loupinale thunei vaipoh atonsot atonsot geijin chang jinghen, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ganhing liho chun, Amen, atiuvin ahi. Chule li ho le upa somni ho chengse chu aboh khupmun a-itih-a hingjing chu chibai abohtauvin ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Kelngoinou chun asinkhana sagi lah-a khat chu ahon kamui, chule ganhing liho lah-a khat chun van ginga bangin, Hungven, ati kajan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh-a chu kagah vetle, veuvin, sakol kang khat ka mun, achunga toupa chun gophel achoije; ama chu lukhuh khat apeuvin ahi; chule ama chu ajoupehle ajoupeh dinga hung kondoh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin sinkhana anina ahonle, ganhing nina chun, Hungven, ati chu kajan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun sakol chom khat ahungdoh-in, hichu asan ahi; chuin miho chu amahole amaho akithatona dinga, achunga toupa chu, leisetna kon chamna lah mangna kipe-a ahi; chule ama chu chemjam lentah khat jong kipe-a ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman sinkhana athumna ahon phat chun ganhing athumna chun, Hungven, ati kajan ahi. Chuin, veuvin, sakol vom khat kamun ahi; chule achunga toupa chun khaikot achoijin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ganhing liho lah-a kon chun, suhlouchang khai khat man makhai, chule sakolchang khai thuma makhai ahi; chule nangman thaole lengpitwi vang chu sumang hih-in, ti aw kajan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman sinkhana alina ahon phat chun, Hungven, ti ganhing alina aw kajan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun kavetle, veuvin, sakol engdang khat kamun; chule achunga toupa chu amin Thina ahi; chule damunin anungnung ajuijin ahi. Chule chemhema, gilkela, thina-a, chule gamsa-a atha dinguva amaho chu vannoi leiset hop li-a hop khat chunga thuneina kipe-a ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin sinkhana angana chu ahon phat chun, Pathen thu jalle hettohsahna aneiju jala kithatteho lhagao hing chu maicham phung noijah kamun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho chun aw sangtah-in asamun, Vo Pakai thengle kitah, thu tanna chule leiset chung chengho chunga keiho thisan asou phulah ding chu itihchan nakhongai dingham, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichun amaho chu ponbang ape chehtauvin ahi; chule amaho chu, asohchanpiho chengseole asopite chengseu amaho banga atha dingu chu akim masangse-a, chomkhat anga tahdi dingu ahi, tin ajah uva aseijun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chunin sinkhana gupna chu ahon phat chun, veuvin, ling nasatah ahung kiho kamun; chule nisa chu samul khaodip pon bangin adumtan, chule lhathah pumpi thisan abang jengtan ahi;
  </para>
  <para style="p">
    <verse number="13" style="v" />chule van'a ahsi ho chu hui hattah-in, theichang amut linga ahut apul lhah bangin, leijah apul lhagamtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule van chu lekha kijel bangin akijelin amangheltan ahi; chule molle lhang jousele twikol gam jong ama ama mun'a konin akichon mang gamtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule leiset lengho, milenho, sepai lamkai pipuiho, chule mihaoho, chule ahatteho, chule soh ho chengsele soh hilou ongthol chengse, kokhuh sunga le molsanga songpiho a chun akiselun;
  </para>
  <para style="p">
    <verse number="16" style="v" />chule molsang ho le songpiho jah-a chun, Kachung uvah hunglhun lang laltouna-a toupa maikoh-a konle Kelngoinou lunghan na-a konin neiselun;
  </para>
  <para style="p">
    <verse number="17" style="v" />ajeh chu alunghan nikho chungnung chu ahung lhungtai; koiham ading thei ding, atiuvin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujou chun vannoi leiset ning li-a vantil li dinga, vannoi leiset chungle twikhanglen chunga chule thing chunga hui anun louna dinga, vannoi leiset hui li tuhtanga kamun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pathen hing melchihna choija, niso lama kona hung kaltou vantil chomdang khat kamun; ama chun hatah-in asamin, leisetle twikhanglen suhsetna ding thu kipe-a vantil liho jah-a chun,
  </para>
  <para style="p">
    <verse number="3" style="v" />I-Pathen sohteho chala melchihna kanam masangseuvin, nanghon leisetle twikhanglen chule thingho suse hihtadiuvin, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin melchihna kinama chu amijat kajan; Israel phung chengsea melchihna kinama sang ja khatle sangsomli le sangli ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Juda phunga melchihna kinam sangsom le sangni; Reuben phunga melchihna kinam sangsom le sangni; Gad phunga melchihna kinam sangsom le sangni;
  </para>
  <para style="p">
    <verse number="6" style="v" />Asher phunga melchihna kinam sangsom le sangni; Naphtali phunga melchihna kinam sangsom le sangni; Manasseh phunga melchihna kinam sangsom le sangni;
  </para>
  <para style="p">
    <verse number="7" style="v" />Simeon phunga melchihna kinam sangsom le sangni; Levi phunga melchihna kinam sangsom le sangni; Issachar phunga melchihna kinam sangsom le sangni;
  </para>
  <para style="p">
    <verse number="8" style="v" />Zebulun phunga melchihna kinam sangsom le sangni; Benjamin phunga melchihna kinam sangsom le sangni; Joseph phunga melchihna kinam sangsom le sangni ahin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hicheng jou chun kavetle, chitin namtina kon, phungtina kon, chule mite tinchenga konle paotin paotanga kon, koima simsen lou mipi atama tam abang jenga kivon, lusuna kichoija laltouna angle Kelngoinou anga dinga kamun;
  </para>
  <para style="p">
    <verse number="10" style="v" />chule amaho chun, Huhhingna chu laltouna-a tou i-Pathen'ule, Kelngoinouva ahi, tin aw sangtah-in asamui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule vantil jouse chu, laltounale upaho, chule ganhing liho kimvela chu ding jinga ahiuve; amaho chu laltouna anga aboh khupmun Pathen alhaijun,
  </para>
  <para style="p">
    <verse number="12" style="v" />Amen: pachatna, loupina, hetna, chihna, thangvahna, choi-atle thuneina, chule thahat atonsot atonsot geijin i-Pathen'uva hi jinghen. Amen, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin upaho lah-a khat chun eihin houvin kajah-a, Hiche ponbang jenga kivonho hi koi hiuva chule hoija hung kon hiuvam, ti eidongin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiman ama jah-a, Ka pakai, nangman bou nahei, kati. Hichun aman kajah-a, Hiteho hi bolgim hesoh genthei chungnunga kona chu hung ahiuve; amahon Kelngoinou thisana chu avonu akisop bangu ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh-a chu amahohi Pathen laltouna anga umuva, asun ajana a-houin'a chu ama lhachale-a panga ahiuve: chule laltouna-a toupa khu amaho lah-a cheng ding ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />amaho hi itihchan hijongle gilkel, dangchah kit talou ding ahiuve; nisan jong sangta lou ding, sat jong thohta louhel ding ahiuve;
  </para>
  <para style="p">
    <verse number="17" style="v" />ajeh chu laltouna lailunga um Kelngoinou khun avah diu, chule hin twinah dunga chu apuihoile ding ahi; chule Pathen'in amitlhi jouseu athehhul ding ahi, ati.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman sinkhana sagina ahon pat chun van'ah nidan keh khat kahset athipchet jengtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pathen anga ding jing vantil sagi kamun; chule amaho chu sumkon sagi chu apeuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chujouvin gimnamtui halna sanabom choija vantil khat ahungin maichama chun ahung dingin; laltouna maija um sana maicham chunga chu mithengho jouse taona abelap peh dingin gimnamtui tamtah apeuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun mithengho taonatoh thakhatnin vantil khut chunga kon chun gimnamtui khu chu Pathen angsung geijin akikhodohtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun vantil chun gimnamtui halnabom chu alan, maichama mei chu akhumin leiset chunga agah seplhatan ahi. Chutah chun van agingin, aw agingin, kol aphen, chule ling akihotan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin sumkon sagi choija vantil sagi chu sumkon mut dingin kigosa demin aumtaovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amasapenpan amutle, thisantoh kihal gel le mei ahung umpaijen jengin ahi; chuin hichengse chu leiset chungah agah seplhaovin ahile, chutah chun thingho hop thuma hop khat akavamin, chule hamhing jouse jong akavamtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujou chun vantil nina chun amutle, meija ka mol lentah tobang khat twikhanglen'ah asep lut taovin ahile, chutah chun twikhanglen chu hop thuma hop khat thisan asohtan ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />chule twikhanglen'a cheng thilsem lah-a ganhing hop thuma hop khat agamtan ahi, chule kongho jong hop thuma hop khat suhmangin aumtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin vantil athumna chun amutle, meisel banga al-lenglung ahsi lenpi khat van'a konin ahung lhan, luiho hop thuma ho khat chungle twinahho chungah achun ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />chule ahsi amin chu Gamsai akiti; chule twi hop thuma hop khat chu gamsai asohtan ahi; akibol khat jeh chun twija kon chun mi tamtah athi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin vantil lina chun amutle, nisa hop thuma hop khat, lha thah hop thuma hop khat, ahsi ho hop thuma hop khat athimna dingin akivosen, athima khovah beihelna dingin sun hop thuma hop khat akivosen ahi; jan jong chutima chu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin kavet jingle, vantil khat vanlaijola lengle-a hiche hi hasaptah-a sama aw kajan ahi, Khuche vantil thum sumkon mut dinga kigoho khun asumkon mut banu amut tengule, leiset chung chengho chu adanauve, adanauve, adanauve, ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin vantil ngana chun amutle, ahsi khat van'a kona lha-a leija chua kamun ahi; chule ama chu lei-ong kokhuh hehna chu kipe-a ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman lei-ong kokhuh chu aheh hongin ahile, kokhuh sunga kon chun pummei nasatah-a bangin meikhu ahung khudohtan ahi; chule kokhuh sunga kona hung khudoh meikhu chun nisale van athimsahtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule meikhu-a kon chun khaokhote lei chunga ahung sohdohtaovin ahi; amaho chu leiset chunga aipi thanei tobang thaneina kipe-a ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule leiset chunga hampa louhing, anche dong chule thing khatcha suse louhela, achala Pathen mi melchihna kinamlou mihobou chu nasuhset dingu ahi, tia kiseipeh ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahon hiteho chu tha chu atha lou dingu, lha nga geija agenthei agentheija agimbol dinguva bou kipe-a ahiuve; chule amibolgimu chu aipin mi ape tenga bolgimna tobang bolgimna ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche lai teng chule mihon thina ahol dingu, chule iti hol jongleu amu lou dingu ahi; chule thi alung ngai dingu chule thina chu amaho-a kona jammang ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche khaokhoho limso chu galsat dinga gotsadem sakol abangin ahi, chule alu chunguva chu sana tobang lukhuh aumin, chule amaiju chu mihem maitoh abangin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule asamu chu numei samtoh abangin; chule ahau chu keipi hatoh abange.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule a-omphou chu thih ompho tobang ahin, alhaiju gin galsat dinga lhaija sakol kangtalai tamtah lhai gintoh abangin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aipi mei bangin ameiju aumin, amidena ajang jong aumin ahi; chule amaijuva chu lha nga geija mihemte agenthei theija gimbolna athao uma ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lei-ong solchah chu alengpao ahi; amin chu Hebrai paovin Abaddon ahin, Greek paovin Apollyuon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dana masa kichaija ahitai; veuvin, tu nunga hi dana ni hung lhung ding ahina laije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin vantil gupna chun amutle, Pathen anga um sana maicham saki ho-a kon chun aw kajan ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />khat chun sumkon choija vantil gupna pa jah-a chun, Euphrates luipi-a vantil li kihenho chu lhan, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichun mihem hop thuma hop khat that dinga, anidan, anikho, alha, akum phasadema kigotpeh vantil liho chu akilhadoh taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule sakol chungchong galmiho chu ami jat sangsom jat ni sangsom jat ahiuve; ami jat chu kajan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule kathil mu-a chun, sakol chengsele achunga chongho chu hiti hin kamui; a-omphou chu kamsan sung abangin, a-engdumin, chule sakol ho chu alu keipi lutoh abangin ahi; amaho kamsunga kon chun mei, meikhu, chule kath ahung sohdohjin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuteho kamsunga sohdoh mei, meikhu, chule kath chucheng thum chun mihem hop thuma hop khat akithat gamtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Akam sungule ameijuva chu athaneinao uma ahi; ameiju chu gul lheh lheh abangin, alu aumin; hichea chu mi agimbolu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Suhgamna chuchenga kithat moh ho chengse chu akhut tham athilbol uva konin alungu aheipouvin ahi; hichu amahon thilhahole khomu theilou, khoja theilou, vahle theilou, sana, dangka, sum-eng, song chule thinga asemu milimho hou atang pouvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amahon toltha mitphel doi choi, jon thanhoi, guchat, hichenga kon chun alungu aheipouvin ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin vantil chomdang hattah khat meija kitom, van'a kona ahung kumlhah kamun, alu chunga chun lhagui akiveijin; amai chu nisatoh abangin, chule akeng chu meikong khomtoh abange;
  </para>
  <para style="p">
    <verse number="2" style="v" />chule akhutna chun lekhabu neocha kiphonga khat achoijin ahi, ama chun akeng jet lamin twikhanglen achonin, vei lamin leiset chun achonin ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />chule keipi kitum banghelin hatah-in kho asamin ahi; akhosap chu van gin sagin ahindongin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule van gin sagi chun thu asei phat chun lekha-a sun ding kakigo tan ahi; chuin van'a aw ahung gingin hitia hi kajah-a asei kajan ahi. Van gin sagi thusei chu imchah-in sun hih-in, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule twikhanglen le leiset chunga dinga vantil kamu chun van lama akhut jetlam adom sangin,
  </para>
  <para style="p">
    <verse number="6" style="v" />vanle vanlaijola thil um chengsele, leiset chule asunga um chengse, chule twikhanglen le asunga um chengse, aboncha sema a-imatih chana hing jing, ama min chu apanin ahahselin, Sotta lou ding ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />ahin vantil sagina chu sumkon mut akigot tengle, hichu agin phat phatle, Pathen thuguh, asoh themgaoho henga anaphondoh banga chu guilhung ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun van aw kajah chu kaja kitleuvin eihouvin kajah-a, Khuche twikhanglen khule lei chunga dinga vantil khutna um lekhabu neo kiphonga khu chenlang galan, eitin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin keiman vantil henga chun kachen ajah-a, Lekhabu neocha chu neipen, kati. Chuin aman kajah-a, Lanlang nejou jengin; hichun na-oisung akhatsah ding ahi; ahin nakama vang khoiju banga lhum ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun keiman vantil khut chunga kon chun lekhabu neocha chu kalan, chuin kanetan ahi; hichun kakamah khoiju lhumin alhumin ahi; ahin kaneh jou phat chun ka-oisung akhatan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amaho chun kajah-a, Miho, chule chitin namtinle, paotin paotang, chule lengho tamtah chungchang thu naseidoh kit tei ding ahi, ati.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichun tenggol lheh lheh pengmol khat keima eipeuvin, vantil chu adingin kajah-a, hitin aseije, Kipat inlang nangman Pathen houin le, amaicham, chule asunga um ahouho chengse khu gaten.
  </para>
  <para style="p">
    <verse number="2" style="v" />Houin polam aleitol chu khendoh-in te hih-in; ajeh chu chidang namdangte kipedoh ahitai; chule amahon lha somli le lhani geija khopi theng chu achotpha dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keiman kathu hettohsah ni thuneina kapeh ding, chule amani chun khaodip pon akisil lhona ni sangkhat le ni jani toh ni somgup sunga thu aseidoh lhon ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amani chu vannoi leiset Pathen anga dinga Olive thingphung ni chule meivah khom ni chu ahi lhone;
  </para>
  <para style="p">
    <verse number="5" style="v" />hiteni chu mi khattouvin bolgim dinga agot jouse-a, akamsung lhona kona mei potna amelma chengseu chu akah vam jengji ahi; chule hitia chu koi hile amani chu bolset go-a chu kithat jeng ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amani chu athu seidoh lai lhona chu go ajuh louna dinga, van khahchah thei ahi lhone; chule amanin suhgamna tintanga leiset asuhgam lhona, twi thisan asosah nomchan lhona, asosah lhon dinga twi chunga thuneina anei lhon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amani chun athu hettohsah achai lhon tengle, lei-onga kona hung pot sahem chun amani chu akisatpia amani chu ajoa atha ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuteng Sodom le Egypt, hiche lhagao lam min umna khopi, a-pakaiyu thingpel'a akhetbehnao, khopi sung lamlena chu along lhon kijam ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mitehon, chitin namtinle phungtina min, paotin paotanga min, chule namtin vaipin ni thumle akeh geija along lhon chu avet avet jeng dingu ahi, chule along lhon chu vuiding thu apeh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule vannoi leiset mite, amani chungchanga chu kipah thanom ding ahiuve, khatle khat kipaman kithotto ding ahiuve; ajeh chu hiche themgao teni chun leiset chung chengho agimbol lhon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ni thumle akeh jou chun asung lhona Pathen'a kona hinna lhagao alut jeh chun, amani akengin ading gel lhontan ahi; chuphat chun ave veho chu akichata lheh jengtaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin, Hilama hung kaltou lhonin, tia van awgin nasatah aja lhonin ahi. Chutah chun amani chu mei kangtalai jin van'a akaltou lhontan ahi. Chule amelmateu chun amu jingu ahi lhone.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche pettah chun ling nasatah ahung kihottan ahi, hichun khopi chu hop soma hop khat achimtan ahi; hiche ling kiho chun mi sangsagi athin, chule athimoh chengse chu atijatlot jeh-un van Pathen chu avahchoi taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dana nina chu kichaija ahitai; dana thumna chu hung lhung vahjet ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin vantil sagina chun amuttan ahi, chule van'ah aw nasatah atama tamin ahinjomin, Vannoi gamvaipoh hi I-Pakaiyu le a-Christa-a ahitai; chule aman atonsot atonsot geija vai apoh ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin upa somni le liho Pathen anga alaltouna cheh-a touho chu akhupbon alhuvin Pathen chibai aboh-un,
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo Pakai Pathen Hat chungnung, Auma, Aumsa, Ahungding nangma kathangvah-ui; ajeh chu nangman nathuneina chungnung chu nakilah-a vai napoh ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Namtin vaipi lunghanga ahiuvin, chuin nangma lunghanle, athiho thutan phat, chule nasoh themgaoho le, mithengho, nangma min gingho alen aneo, tohphat man peh phat, chule leiset sumangho suhmang phat chu, hung lhunga ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin van'a um Pathen houin mun theng chu akihongin, chule a-houin Mun Theng sunga chun kitepna thu thingkhong chu akimun ahi; chule kol aphen, aw agingin, van agingin, ling akihottan ahi, chule gel len nasatah alhan ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin van'ah melchihna chungnung khat akimun ahi; numei khat nisa-a kijema, akengto noija lhathah uma, chule alu chunga ahsi somle ni-a kijem lallukhuh kikhuh ahi:
  </para>
  <para style="p">
    <verse number="2" style="v" />chule amanu chu naovop ahi; chule naoso nat thohgima ham hama ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin van'ah melchihna kidangtah achom khat akimu kittan ahi; veuvin, dragon san lentah, alu sagi, chule aki som chule aluho-a chu lallukhuh sagi kikhuh, khat ahung umin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amei chun van'a ahsi ho hop thuma hop khat aloilhan leiset chunga aseplhan ahi; chule dragon chu asoh dingkon numeinu anga chun asolhah tihtih acha chu aval lhum jeng theina dingin ading jing jengin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amanun chapa khat ahingtan ahi; ama chun namtin vaipi jouse chunga thih tenggola vai apoh ding ahi; chuin acha chu Pathen hengle alaltouna-ah lahtouvin aumtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin numeinu chu gamthip lama ajam mangtan ahi; hikoma chu ni sang khatle ni jani leh ni somgup geija akivahna dinga, amanu chu Pathen'in mun agotpehsa ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin van'ah gal akisattan ahi; Michael le avantil ho chengsen dragon chu asat taovin ahi; hi chun dragon le asolchah ho jong chun asat thuhtaove;
  </para>
  <para style="p">
    <verse number="8" style="v" />ahivangin ajoutapouve; chujongle van'ah amaho mun akimu kittapon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin dragon len chu gul lui, Diabol le Satan kiti vannoi pumpi lhemlha-a chu, ama chu leijah lelhah-in aumtan ahi; chule asolchahho jong chu amatoh lelhah than aumtaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun keiman van'ah aw nasatah khat kajan ahi; Hichun, Tun huhhing, thahat lenggam i-Pathen'uva, chule thuneina chu a-Christa-a ahitai; ajeh chu isopiteu hehsea chu akilehlha-a ahitai, ama chun i-Pathen henguva amaho chu asun ajana ahehset jingji ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amahon Kelngoinou thisan vangle ahettohsah thu-u vanga ama chu ajokhup dingu ahitai; chule amahon thi geija ahinkho itcha louhel ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun, Vo vanho chule asunga cheng chengse, kipah thanomun; leisetle twikhanglen chu ada naove; ajeh chu diabol nahengu hung geisuh ahitai, phat chom chabou anei chu ahen, lunghan chungnunga lunghanga ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin dragon chun leija akilelhah chu amun, hichun acha soh-a chapa khat hinga numeinu chu abolsetan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin numeinu chu ama mun gamthip lama chu gul chun amu phah louna-a alenmang theina dingin, mulaopi lhaving ni akipen ahi; hikoma chu phat khat, phat ni chule phat keh khat geija kivahdoh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichun gul chun twi lhohsah theina dingin akamsunga konin numeinu nungsanga chun luipidung tobang leuvin twi aphidoh tan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla vannoi leisetnin numeinu chu anahun, chuleh leiset in akam anakahomin, gul'in akamsunga kona aphidoh twi luipidung chu anaval jouhel tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutah chun gul chu numeinu chunga chun alunghangin, amanu chilhah ho Pathen thupeh nitle Jesu Christa thu hettohsah jop amoh chengse chutoh kisat dingin akondohtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule achen twikhanglen nel chunga agading tan ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chutia keima twikhanglen neldi lah-a kadin chun twikhanglen'a kona sahem khat ahung kipatdoh kamui; ama chu aki som ahin, alu sagi ahi; akihoa chun lallukhuh som aume, chule aluho-a chun Pathen taitomna minho aume.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche sahem kamu chu lutnu toh abangin, akengho chu vompi kengtoh abangin, chule akam chu keipi kamtoh abange; chule dragon chun athahatle alaltouna chule athuneina chungnung ama chu apetan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chujou chun keiman kamui, chuche aluho lah-a khat chu thihela kisat lheh lheh ahi, ahin thihela akisatna chu kiledoh ahitai; chule vannoi pumpin kidangin amuvin ajuitaove;
  </para>
  <para style="p">
    <verse number="4" style="v" />chule sahem chu athuneina apeh jeh chun mihon dragon chu ahouvun, Hiche sahem tobang koiham? Koiham amatoh kisat thei dinga, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun hamhoithonale Pathen taitom na-a thuseina kam apeuvin; chule lha som lile lha ni geija thilbol dingin thahat thuneina apetaovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutah chun Pathen taitom na-in akamkatan ahi, aminle, achenna, chule van'a chengho jouse ataitomtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule mithengho toh kisat dingle amaho chu jou dinga ama chu thahat kipe-a ahi; chule ama chu phungtin leh mite tincheng chule paotin paotangle chitin namtin chunga thuneina kipe-a ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule leiset chunga chenga mi jousen ama chu ahou dingu ahi; leiset bul kiphudoh tila patna akithatsa Kelngoinou hinna lekhabu sunga amin kisun louho chengse chun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nakhang neija aumle ngaihen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gal hinga kaidol gal-hinga kikai ding; chemhema mithat aumle chemhema lou ding ahi. Hichea hi mithengho thohhatle tahsan kilanga ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin sahem chom khatma leisetna kona ahungdoh kamun ahi; ama chu kelngoinouva tobang aki ni ahin, chule dragon bang bangin thu aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ama chun sahem masapa thuneina jouse chu ama angsunga amangchan ahi. Chule ama chun vannoi leisetle asunga chengho jouse, thihela akisat kiledoh kit sahem masa chu ahousah tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ama chun melchihna thil nasatahtah abolin, miho mitmun van'a kona leija mei lhahsah geijin abolin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutia chu sahem mitmu-a chu melchihna tintang bolna ding thahat ama chu kipe-a ahi, hichea chu aman vannoi leiset chung chengho asuhlamvai ahi; ama chun leiset chung chengho jah-a, Chemjam'a kisat lem kiledoh kit sahem chu alim khat semun, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule sahem lim chun thu asei theina dinga, chule chuche sahem lim chu ahou lou jouse akitha theina dinga, ama chun sahem lim sunga chu hinna hu akhum ding, hichan geija chu thaneina kipe-a ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule ama chun aneo alen, ahao avai, chamlenle soh, hicheng jouse chu akhut jet lamu ahim, achaluva ahima, melchihna chu aban neisah ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />chule chuche sahem melchihna, amin chu ahiloule, amin number neilou chun, cho theita lou, joh theita lou ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichea hin hetna chihna akilange; lungthim theman hiche sahem number chu simhen; ajeh chu hichu mihem number ahi; chule hiche number chu Ja gup le somgup le gup ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujou chun, veuvin, Kelngoinou chu Sion mol chunga chu adin kamun, mi sang ja khatle sangsomli le sangli toh ahi; amaho chu achaluva ama minle a-Pa min kisuna ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin van'a konin twi tamtah gin lheh lheh le van gin lheh lheh aw kajan; ka-aw jah chu selangdah tumhon aselangdah cheh atumu gingtoh abangin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amaho chun laltouna ang le ganhing liho chule upaho anga chun la thah khat asauvin ahi; chule vannoi leisetna kona achohdoh mi sang ja khatle sangsomli le sang liho tailou chu, adang koimacha hiche la chu kichuh them thei lou ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho chu numei chunga kisuboh louhel ahiuve; amaho chu suhkhah loulaihel nungah thengsel ahiuve. Amaho chu kelngoinou chena chana anung nung juileho chu ahiuve. Pathen'a dingle Kelngoinou dinga aga masa tia, amaho chu mihemte lah-a kona kichodoh ahitaove;
  </para>
  <para style="p">
    <verse number="5" style="v" />chule amaho chu akam sunguva thujou pot kihekha louhel ahiuvin; Pathen laltouna anga monabei ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin keiman vanlaijola vantil leng lele khat kamui; ama chun leiset chunga cheng, chitin namtinle, phungtin, chule paotin paotangle, miteho henga seiphongle dinga tantih neilou Kipana Thupha anei ahin,
  </para>
  <para style="p">
    <verse number="7" style="v" />ama chun aw nasatah-in asamin, Pathen gingun, aloupije chu vahchoijun; ajeh chu athutan avaihom phat ahung lhungtan ahi; chule vanle, lei, twikhanglen, twinah jouse, hichengse sema chu houvun chibaijun, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin vantil anina achom khat ama nung nunga chun achelen, Ajonthanhoi jeh-a lunghanna lengpi ju chitin namtinle phungtin donsah-a Babylon khopi chungnung tah chu achimtai, achimtai, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuche jou chun vantil thumna chun amani nung nung chu ajuijin hatah-in asamin, Koi hile sahem chule alim chu houva chibai boh-a, chule achala ahim, akhut ahima, amelchihna kinamdoh chu kilah-ah aumle,
  </para>
  <para style="p">
    <verse number="10" style="v" />ama jong chun Pathen lunghanna khona chu alunghana lengpi ju imatoh hal louhel gotsa kikoi chu adon tei ding ahi; chule vantil thengho mitmule Kelngoinou mitmu-a chu meile kath kah nat athoh gim dingu ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />amaho nat thohgim meikhu chu a-imatih chana kitungdoh jing jenga ahi; chule chuche sahem chule alim chu houva chibai boh-a chule koi hile amin melchihna kilah chan chu, asun ajana oltih nei louhel ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichea hin Pathen thupeh hole Jesu tahsan thu nit mithengho thohhatje thu akilangin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin van'a aw ahung gingin, Sunin, tukala Pakai mina thiho chengse chu anunnoma ahiuve; ahi, amaho chu atohgim naova kona cholnga ding ahiuvin, anatoh chengun anungu ajui ahi jeh chun, tia Lhagaovin kajah-a asei chu kajan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin kavetle, veuvin, meibang khat chule achunga chu mihem chapa lheh lheh, alua sana lukhuh kikhuh-a, akhutna koite hemtah khat kichoija tou kamun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin houin sunga kon chun vantil chom dang khat ahung potdoh-in meibang chunga toupa jah-a chun aw sangtah-in asamin, Nakoite paninlang chang attan, nang dingin a-at phat ahitai; vannoi leiset chang aminin akoitai, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin meibang chunga toupa chun vannoi leiset chungah akoite alamtan ahile, hichun vannoi leiset chang aki-at tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin van'a houin sunga kon chun vantil chom khat ahung potdoh kitleuvin; ama jong chun koite hemtah khat aneijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin vantil chomdang khat mei chunga thuneija chu maichama konin ahung potdoh-in, koite hemtah choipa jah-a chun aw sangtah-in asamin, Nakoite hemtah chu paninlang vannoi leiset lengpiga abohho at khomtan; aminsoh ahitah jeh khun, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuphat chun vantil chun akoite apanin vannoi leiset lengpiga abohho chu a-at khomin, Pathen lunghanna lengpiga hehna len chungnung khuh sunga chun asep luttan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule khopi polama lengpiga hehna khuh sunga chun achilun ahile, lengpiga hehna khuh sunga kon chun thisan ahung sohdoh-in, ching sang khatle ching ja gup geijin sakol kamdal chan gei aphan ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujou chun keiman van'ah melchihna thil kidang chungnung tah achom khat suhgentheina nukhah sagi neija vantil sagi kamun; hicheng chu suhgentheina kichaina ahi; ajeh chu Pathen lunghan hichenga chu kichaisoh ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin meitoh kichoh hal phatvet twikhanglen tobang khat kamun; sahem chule alim chule amelchihna chule amin Number chu neh jouva, chuchenga kona kihuh dohho chengse chu Pathen selangdah akichoijuva, phatvet tobang twikhanglen panga chu adin jingu kamun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho chun Pathen soh Mosi la chule Kelngoinou la chu asauvin, Vo ijakai, bol thei Pakai Pathen, nangma thilbol hi aloupin akidange; Vo mithengte Lengpa, nangma lampi adih-in akitah-e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai, koiham nakicha lou dinga? Chule nangma min vahchoi lou dinga koiham? Ajeh chu nangma jengbou atheng nahi; ajeh chu nangma chonphat thilbol kiphon jeh-a hi chitin namtin nangma anga hung kun cheh ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche jou chun, veuvin, van'a hettohsahna houin dan sungnung Mun Theng chu akihon kamun;
  </para>
  <para style="p">
    <verse number="6" style="v" />chule houin'a kon chun suhgentheina sagi chunga thuneija vantil sagi chu ahung potdoh-un, tonjih ponnem manlutah athena thengin akivonun, sana konggah a-om uvah akikouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin ganhing liho lah-a khat chun vantil sagiho chu a-imatih chana hing jing Pathen lunghanna dimset sana sumlheng sagi apetan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun Pathen loupinale thunei na-a kon meikhu chu houin sung chu adimset jengtan ahi; chule vantil sagi chun suhgentheina sagi chu abulhit masangseu chun koimacha houin sunga chun alut theipon ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin houin sunga kon chun vantil sagiho jah-a, Nangho cheovinlang Pathen lunghanna sumlheng sagi chu vannoi leiset chungah gabung lha uvin, tia hasaptah-a kisam aw kajan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun vantil amasapen chu achen vannoi leiset chunga asumlheng chu abunglhatan ahi; hichun sahem melchihna neile alim houva chibai boh miho tichunga chun anat hoisetah tina achutan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin vantil anina chun twikhanglen'a asumlheng abunglhan ahile; hichu mithi thisan bangin thisan asohtan ahi; chule ganhing jouse abonchan athigamtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin vantil athumna chun luidungle twinahho jouse-a asumlheng abunglhan ahile; hichun hichu thisan asohtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuphat chun twi vantil chun hitia asei kajai, Vo Pakai, Nang Auma, Aumsa, chule Thengtah, Dihtah nahi; hicheng jeh-a chu nangman hitia hi thu natan ahitai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajeh chu amaho mithenghole themgaoho thisan anasou ahi; hijeh-a chu nangman jong amahon adon dinguva thisan napeh ahitai; hichu amaho chandia lomtah ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujou chun maichama kona hitia kisei chomkhat kajan ahi, Ahi, Pakai Pathen, Hat chungnung, nangma thutan vaihom chengse hi akitah-in chule adihsoh keije, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin vantil alina chun nisa chunga asumlheng abunglhan ahile; hichun miho chu meija asahgop dingin thuneina apetaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin miho chu asajapjappi chun asanggoptan ahile, hiche suhgentheina sagi chunga thunei Pathen min chu ataitomun, aloupina chu vahchoi dingin alungu aheipouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin vantil angana chun sahem laltouna chunga asumlheng abunglhan ahile; hichun agamsung mu athimsohtan; chule amaho chun anat thohlel jeh-un alei apettaovin ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />chule anat thohgim ule atina thohlel jeh-u chun van'a Pathen ataitomun, achonnau athilbol uva konin alung aheipouvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin vantil agupna chun Euphrates luipi-a asumlheng abunglhan ahile; hichun nisona lama kona hung ding lengho dinga lampi gotsa aum theina dingin, chuche luipi dung twi chu akangtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphat chun dragon kam sunga konle sahem kam sunga kon chun, chule themgao lhem kam sunga kon chun uphoh tobang lhagao boh thum ahungdoh kamun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitiho chu thilhaho lhagao ahiuvin, melchihna kidang dang, vetsah ahiuve; amaho chun imajouse bolthei Hat chungnung Pathen, nikho loupi chungnung ni-a galsat dinga vannoi leiset pumpi-a lengho kikhopsah dinga, amaho henga chu chea ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Veuvin, keima gucha bangin kahunge. Koi hile kihong jinga sagoh-a auma ajachat kiphon louna dinga aponsil kivetphat jing mi chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amaho chun Hebrai paova Armageddon atiu mun laija chun amaho chu akikhopsah taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin vantil asagina chun vanlaijola asumlheng abunglhan ahile, hichun van houin'a konle laltouna-a konin, Akichaitai, tin aw sangtah ahung soh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichun kol aphen, aw agingin, van agingin ahitai, chule vannoi leiset chunga mihem umtilla patna chutobang lingpi kihotkha louhel, hitobangtah chun ling akihottan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichun khopi chung nung chu hop thum akisotai, chule chidang namdangte khopi chengse chu achim lhagamtan ahi; chule Pathen lunghan chung nungna lengpiga ju khon chu peh dingin, Babylon khopi chungnung chu Pathen anga geldoh jingin aumtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule twikol gam jouse ajam manggam tan, molle lhangho jong akiholmotan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin mihemte chunga, van'a konin agih talent khat toh kikot gel len nasatah alhan; hiche gelpi chun asuhgam jeh-u chun mihem ten Pathen ataitom taovin ahi; ijeh ham itile hichu nasa behseh jenga ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin sumlheng sagi choija vantil sagiho lah-a khat chu kahenga ahungin, eikihoupin, kajah-a, Hungin, twi tamtah chunga tou notinu matding talen chu vetsah ingkate;
  </para>
  <para style="p">
    <verse number="2" style="v" />Amanu chutoh leiset lengho ajong taovin, chule ajonthanhoina lengpiga ju-a vannoi leiset chung chengho akham ngolsah soh gamtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche chun ama chun, Lhagaovin gamthip lama eipuitan ahi. Hichun, Pathen taitomna min dimset, chule alu sagi, aki som nei, sahem santhip chunga tou numei khat kamun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche numeinu chun pon sanduple ponsanthip asilin, sana, khisong mantam jengle twikohchangin akijemin; chule akhutna chun thil thet umtahle ajonthanhoina bohnen dimset sana khon khat akichoijin ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />chule achala chun hiche min hi akisune, THUGIL, BABYLON KHOPI CHUNGNUNG, VANNOI LEISET NOTI HO LE THILTHET UMTAHHO NU.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule numeinu chu mithengho thisanle Jesu thu hettohsah ho thisana kham ngolin kamun ahi. Amanu chu kamun kidang kasa behseh jengin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun vantil chun kajah-a, Ibola kidang nasah ham? Khuche numeinu le apuilea, alu sagi, aki som nei, sahem thuguh khu seipeh-inge.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sahem namu khu aumsa ahin, umtalou ahi, ama lei-onga kona hung kaltouna manthah na-a che ding ahi. Chule vannoi leiset kisem tila patna hinna lekhabua amin kisun lou, leiset chung chenghon aumsa, tu-a umtalou, khonunga hung umding sahem chu amu tengule, ama chu adatmo lheh dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichea hin chihna lungthim them thu aume. Alu sagi chu mol sagi ahi; hicheng chunga chu hiche numeinu chu touva ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />chule hicheng chu leng sagi jong ahiuve; amaho lah-a nga chu alhusa ahitan, khat aumpet ahi, chule khat vang chu um loulai ahi; ama chu um jongle chomcha khatbou umding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule chuche sahem, aumsa, umtalou chu, amatah chu agetna ahi, chule sagiho loija mi mama khat ahi; ama chu manthah na lama che ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman aki som namu chu leng som ahi; amaho chu tua gam nei loulaiho ahiuve; ahinla nidan kah khat sunga dinga sahem chutoh thakhat tah-a gam vaipohna thu anei khom dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho chu thu khat akisauvin athahat naole athuneinau hiche sahem chu apeuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho chu Kelngoinou chutoh kisat ding ahiuve; hintin Kelngoinou chun amaho chu ajo ding; ajeh chu ama pakaiho Pakai le lengho Leng ahi, chule aumpiho chengse jong akikoule lhenchom chule tahsantah cheh ahiuve, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ama mama chun kajah-a, Nangman namu twi tamtah notinu touna chu twiho chu mitehole mipi chule namtin vaipi, chule paotin paotangho ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule namu ki som chule sahem chun notinu chu ahot dingu, chule imacha nei louhel le sagohkeova alha dingu, chule meija agovam dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu Pathen thu guilhun kahse-a alunggot suhbukimna dinga amaho chu lung khat ahiuve, agam cheh-u sahem chu apehna dinguva, Pathen'in alungu achothou ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangman namu numeinu chu, vannoi leiset leng jouse chunga vaipo, khopi chungnung chu ahi, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jou chun vantil thuneitah achom khat van'a kona ahung kumlhah kamun; aloupi chun vanle leiset asalvah soh jengin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama chun aw sang chungnung tah-in, Babylon khopi chungnung chu achimtai, achimtai; thilhaho chennale lhagao bohho jouse kihen khomna, chule vacha boh thet umtahho kihenna bom asohtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh iham itile amanu ajon thanhoija kona lung hanna lengpiga ju-a chu chitin namtin kisep lhu gama ahi; vannoi leiset lengho amanu chutoh ajong thanghoi jun, chule amanu nomsah vala kona vannoi leiset sumkolvei ho haodoh gama ahiuve; tin asamin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujou chun van'a kona hitia kisei hi aw achom khat kajan ahi, Vo kamite, nangho amanu chonsetna chu nachan khah louna dingule, amanutoh nakisuh gamtha louna dingun, amanu-a kon chun hungdoh-un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu amanu chonset van'ah akidong heltan ahi; athemona chengse Pathen'in ageldoh ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amanun napeh bang bangu chun nanghon jong amanu chu lethuh-un; chule ama thilbol dungjui jin ajat ni-a ajat nin phulah-un; achopolna khona chun ajat nin chopol peh-un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Akiloupi sahle akinomsah val bang bangin sugenthei jun, sulunghemun; ajeh iham itile amanun alungthimin, Keima lengnu-a tou kahin, meithai kahipoi; itihchan hijongle lunghem ni mu lou ding kahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu thina, lunghem, chule gilkel, hicheng chun asuhgentheina-a amanu chunga ni khat lhuna lhung ding ahi; chule amanu chu meija kigouvam ding ahi; ajeh iham itile amanu chunga thutana Pakai Pathen chu chungnung tah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule vannoi leiset lengho, amanu jonpiho chengsele nomsahpi ho chengse chun, amanu kigona meikhu chu amu tengule, amanu chu kacham-untin a-op achup chup jeng dingu ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />chule amanu nat thoh gim chu kicha-a gamlatah-a dinga, Ohe! Ohe! Babylon khopi chungnung, khopi dettah, nadanave! Nidan kah khat sungin nachunga thu kitanna alhungmai jengtai, ati dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule vannoi leiset sumkolvei ho jousen amanu akauvin, alhasetpi lheh jengun ahi; ajeh chu amaho kiveina thil:
  </para>
  <para style="p">
    <verse number="12" style="v" />sana, dangka, khisong mantam, twikohchang, tonjih pon, ponsandup, lungpon, ponsanthip, thing namtui mantam jouse, chule thing kongle bel jouse, chule thing manlu-a, sum-enga, thihle, songvala kisem kongle bel jouse;
  </para>
  <para style="p">
    <verse number="13" style="v" />thingthal, aisaga, thingnai gimnamtui, kinu ding thao namtui, bego, lengpiga ju, Olive thao, changbong, suhlou chang, bongle kelngoi, sakol, kangtalai, soh, chule mihem hinkho hichengse chu koiman achohpeh tahlou jeh chun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nangaichat nalhangai gaho chengse chu nanga kona chemang gama chule ahoile thilval chengse kisuhmangpeh nahitai; mi koiman hitiho chu itihchan hijongle amu lou ding ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thil chuchenga amanu haova kona haodoh sumkolvei ho chengsen amanu nat thohgim chu kichan, gamlatah-a adingun amanu chu akachamun alhaset piuvin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Ohe! Ohe! tonjih ponnemle ponsandup chule ponsanthip kisila, chule sana khisong mantam chule twikohchanga kijem, khopi chungnung nadanave!
  </para>
  <para style="p">
    <verse number="17" style="v" />Nidan khat sungin nei le gou hijatpi amanghel jengtan ahi, atiuve. Chule kongtol miho jouse, kong'a kitolla muntina vahlehole kong khao lhaleho chule twikhanglen'a kilonho chengse, hiteho chengse chu gamlatah-a adingun,
  </para>
  <para style="p">
    <verse number="18" style="v" />amanu kigona meikhu chu amuvin, Hiche khopi chungnung toh kibang hoija ipi khopi umam, tin asamun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amaho chun alu chunguva leivui akithe khumun kapkaple lhasetah-in, Ohe! Ohe! khuche khopi sum hao vanga twikhanglen'a um kong neoho haodohna khopi chungnung chu adanave! Nidan khat sungin amangdel jengtan ahi, tin asamui.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vo nangho, vanle mithengho chule solchah ho le themgaoho, nangho amanu chungchanga khun kipah thanomun; ajeh chu nangho chunga thu kitan chu Pathen'in amanu chunga thu atan ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin vantil hat chungnung tah khatnin sumhei lheh lheh song lentah khat adomin twikhanglen'ah aseplhan, Hiche banga hi Babylon khopi chungnung chu hase-a kiseplha ding ahi; khonungle itihchan hijongle kimu kit talouhel ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule selangdah tumho selangdah tumgin, lathemho lasah, sumkuli mut teho mutgin, chule sumkon mut teho sumkon gin a-imatih chana nalah uva kijata louhel ding ahi; chule khut thema khut them nalah uva kimuta louhel ding ahitai; sumhei gin jong nalah uva kijata lou ding ahi;
  </para>
  <para style="p">
    <verse number="23" style="v" />a-imatih chana nalah-a meivah kivahta louhel ding ahi, chule nalah-a mounule moulang aw kijadohta louhel ding ahi; hichu nasumkolveiho chu vannoi leiset pipuho milen milal ahiuva, chule nangma doi choija namtin vaipi alamvai jeh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule themgaoho le mithengho thisan chule leiset chunga kithat jouse thisan aboncha hiche sunga hi kimudoh ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheng jou chun van'ah mipi atama tam aw gin lheh lheh nasatah kajan, Halleluijah; huhhingnale loupina chule thahat thuneina Pakai i-Pathen'uva ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />ama thutan vaihom akitah jehle adih jeh ahi; ajeh chu ajon thanhoija leiset suchavaija noti lennu chu aman athu atanin, amanu khutna atanin, amanu khutna kon asohte phu chu alatan ahi, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin avel velin, halleluijah, atiuve. Chule amanu khu chu tonsot geija kitungdoh jing jeng ding ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujou chun upa somni le liho chule ganhing liho chun laltouna-a tou Pathen chu ahouvun, Amen, Halleluijah, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin laltouna-a kon chun aw khat ahung sohdoh-in, Vo Pathen sohteho, ama ginga nangho chengse alen aneo nabonchaovin, Pathen chibaijun vahchoijun, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujou chun mipi atama tam aw gin tobangle twi tamtah lon gin tobang, chule van gin tobangin kajan, Halleluijah; I-Pakaiyu Pathen, Hatchung nungin, vai apohtah jeh hin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hungun, kipa thanop boluhitin, aloupina vahchoi uhite; ajeh chu Kelngoinou chu ajineina ding aphat ahitai; aji dingnu chu kigosa dema uma ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aji dingnu chu akijepna ding tonjih ponbang, ngimsel val lailai, kipe-a ahitai; hiche tonjih ponnem chu mithengho chonphatna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ama chun kajah-a Kelngoinou ji kipuina golvahna-a kikouho chu anunnom ahiuve, tin sunin, eiti. Chuin ama mama chun kajah-a, Hicheng hi Pathen thu dihtah ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun keima ama chu hou dingin akho bulah kaboh khuptan ahi. Chuin aman, Chingtheijin, hitobang chu bol hih-in; keima nasoh chanpi chule Jesu thu hettohsah nasopiteho soh chanpi kahibouve; Pathen jengbou nahou ding ahi, ajeh chu Jesu thu hettohsah chu gao thu seidoh lhagao ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin keiman van kot kihon kamun ahi; chule, veuvin, achunga toupa chu amin Tahsan umle Dihtah akitin ahi; ama chu chon dihtah-a thutan vaihoma chule galsat ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama chu amit meikong ahin, alua lallukhuh tamtah kikhuh ahi, chule amin khat akisunin, amin chu ama tailou koimacha dangin ahepoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aponsil chu thisan kithe khuma ahi; chule amin chu Pathen Thu kitia ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule van sepaiho chengse tonjih ponneljet vamleng le ngimsel akisilun, sakol kang chunga anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin namtin vaipi asatna dingin akam sunga konin chemjam hemtah khat ahungdohtan ahi; ama chun achunguva thih tenggola vai apoh ding ahi; chule Hat chungnung, Pathen lunghanna kichat umtah lengpiga hehna-a jong chu aman achilji ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aponsil chungle amalbuh laija, LENGHO LENGLE PAKAI HO PAKAI, tia min kisun khat aume.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin keiman nisa chunga dinga vantil khat kamun; chule ama chun vanlaijola lengle-a vachate jouse jah-a,
  </para>
  <para style="p">
    <verse number="18" style="v" />Hungun, nanghon lengho sa, sepai lamkaiho sa, ahat apaoho sa, sakolhole achunga touho sa, chamlenle soh ho sa, aneole alenho jouse sa, nedingin Pathen golvahna chungnungah hung kikhomun, tin asamin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin sakol chunga toupale asepaiho chutoh kisat dingin, sahem chule leiset lengho chule asepaite chengseutoh akikhomun kamui.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin sahem chu amantaovin; chule themgao lhem, amitmua melchihna kidang dang bola sahem melchihna kilahhole alim chibai bohho lhemlha-a sulamvaija chutoh amattha taovin ahi; chuin kath meika al-lenglung jing jeng mei dilah ahingin alehlut taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule adang amoh chengse chu sakol chunga toupa kam sunga kona hung potdoh chemjam chun athat gamtan ahi; chuin vachate jouse ahungun asao chu ahung neuvin avaset taovin ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin lei-ong hehnale thihkhao khat choija vantil khat van'a kona ahung kumlhah kamun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama chun dragon, gul lui chu, hichu Diabol le Satan ahin, amanin, chuin akanin kum sangkhat geija dingin lei-onga chun asep luttan ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />chule chuche kum sangkhat chu alhin kahse-a, namtin mite alheplhah thei louna dingin akhachah khumin, asinkhana anam khumtan ahi; chujoule chomkhat dinga kilhadoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin keiman laltouna phabep khat kamun; achunga touho chu thutan vaihom apedoh-un ahi; chule Jesu thu hettohsah jalle Pathen thu jala alu kitanho, chule sahem chule alim chibai boh lou, achal le akhutnuva melchihna kilah-a kichin lou amaho chengse lhagao hing chu kamun ahi; amaho chu ahinga ahitaove, chule kum sangkhat Christa toh vai apo khomui;
  </para>
  <para style="p">
    <verse number="5" style="v" />hiche kum sangkhat chu alhin masangse-a chu mithiho amoh chengse chu hingdoh lou ahiuve, hichu thokit masa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Koi hile hiche thokit masa changkha chu minunnomle atheng ahi; amaho chunga chu thi nina chun thu aneilou ahitai; ahin amaho chu Pathen le Christa thempu hiuva amatoh kum sangkhat vai apoh dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule kum sangkhat chu alhin tengle, Satan chu akihena-a kona kilhadoh-a,
  </para>
  <para style="p">
    <verse number="8" style="v" />vannoi leiset ning li-a cheng namtin, vaipi, twikhanglen'a neldi jat, Gog le Magog chu, doha lhemlha-a galsat dinga, kikhopsah dinga hungdoh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amaho chu leivai khahtanin aleilimin akonun mithengho ngahphol le khopi deitah chu aum kimvel taove; hichun van'a Pathen na konin mei ahung lhan amaho chu akavam gamtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amaho lhemlha-a diabol chu meile kath meika dil sunga chun asep lut taove; hiche koma chun sahem chule themgao lhem jong chu aumui; chule amaho cheng chun tonsot tonsot geija asun ajana thohgim nasatah athoh jing dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin laltouna len chungnung abana bang khatle achunga toupa chu kamun; ama angsunga kon chun vannoi leisetle van ajam mangtan ahi; hiteni ding chun mun akimutapon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen anga chun mithiho jouse alen aneo adin kamun; chujouvin lekhabu phabep khat aphongui; chuin hinna lekhabu atiuvin achom khat jong aphongun ahi; chuin chuche lekhabua kisun dungjui chun mithiho chu ama ama thilbol dungjui cheh-in athu atantaovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphat chun twikhanglen'in ama-a um mithiho jouse chu ahinleh doh-in; chule thinale damunin jong amithiho chengse ahinlehdoh sohkeitaove; chuin athilbol dungjui cheh-in athu atan taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin thinale damun chu mei dil sunga chun aleh lut taove, hiche chu, thi nina ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hinna lekhabu sunga amin kiholdoh louse chu mei dil sunga chun aleh lut taove. Hiche chu, thi nina ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujou chun keiman van thah lei thah kamun ahi; ajeh chu van masale lei masa chu kitol manga ahitai; twikhanglen jong aumtapoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule a-inneipu henga dinga kijema kigosadem mounu banga khopi theng, Jerusalem thah chu, Pathen kom van'a kona ahung kumlhah keima John nin kamun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin keiman van'a kon chun, aw sangtah-a thu kisei kajan, Veuvin, Pathen chenna chu mihem lah ahung hitai, chule ama amahotoh cheng khom ding; amaho chu ama mite hi ding ahiuve; chule Pathen amatah mongin aumpi dingu, chule a-Pathen'u hi ding ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />chule amit uva amitlhi chengseu atheh ngim ding; chule thina umta louhel ding; chule lhasetnale kana chule nat thohgim umtalou ahi; thil masaho chengse chu kitol mangsoh ahitai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin laltouna-a toupa chun, Veuvin, keiman ijakai kathahsem sohkeije, ati. Chuin ama chun, kajah-a, sunnin; ajeh chu hicheng hi tahsan umle thutah ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ama chun kajah-a, Hichengse chu kichaija ahitai! Keima Alpha leh Omega, akipatna leh akichaina kahi. Adangchah-a chu hinna twinah-a twi chu manbeijin penge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajou chanin hicheng hi alo ding ahi; keima a-pathen hingting, ama kachapa hi ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin mi kichaseho, tahsan neilouho, thet umho, tolthat teho, jon panho, doi choiho, milim houho, chule mijouho jouse meile kath meika al-lenglung jing jeng mei dila chu achan dingdol cheh chang ding ahiuve; hiche thi nina ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin suhgamna nukhah dimset sumlheng sagi nei vantil sagiho lah-a khat chu kahenga ahungin, kajah-a thu aseijin, Hilama hin hungin; keiman nangma Kelngoinou inneipi ding mou chu vetsah inge, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ama chun keima Lhagaovin molsang lentah chungah eilhoh touvin, Pathen kom van'a kona hung kumlha-a, Pathen loupina nei khopi len, Jerusalem theng chu, eimusahtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Avahje dan chu khisong man tamtah abangin, jasper song lheh lheh ahin, songval valin avalin;
  </para>
  <para style="p">
    <verse number="12" style="v" />akul chu lentah chule sangtah ahin, akot somleni ahi; kot somle ni-a chun vantil somleni aumin; chule min phabep khat chua chun akisunin; hichu Israel chate phung somle phung ni min ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Akot chu thumin niso lam angan, thumin sah lam angan, thumin lhang lam angan chule thumin nilhum lam angan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule khopi kul chu akhombul somleni ahin; hicheho chunga chu Kelngoinou solchah somleni ho min chu kisuna ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule khopi chule akotle akul chu tena dingin, kajah-a thuseipa chun gamtena sana tenglhon achoijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khopi chu aning li kitoh, adung avai kibang ahin ahi. Chuin gamtena tenglhona khopi chu atele, mail sang khatle mail ja nga ahi; adung, avai, atun kibang sohkei ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin kul chu aten ahile, tong ja khatle tong som lile li ahi; vantil thiltena chu, mihem thil tena jong ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule kul kiget chu jaspi songa kigen ahi, chule khopi chu phatvet thengtah tobang sana thenga kisa-a ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khopi khombul song chu khisong mantam jat chom jat choma kijema ahi. Khombul masapen chu jasper khisonga kijem ahin, abana chu sapphir khisong ahin, athumna Chalcedon khisong ahin, alina emerald khisong ahin;
  </para>
  <para style="p">
    <verse number="20" style="v" />Angana sardonyx khisong ahin, agupna sardius khisong ahin, asagina chu chrysol khisong ahin, agetna beryl khisong ahin, akona chu topaz khisong ahin, asomna chu chrysopras khisong ahin, somlekhatna jacinth khisong ahin, somle nina chu amythyst khisong ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Akot somleni chu twikohchang khat khatna kisem ahi. Chule akho sung lamlen chu phatvet thengsel tobang sana theng ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule asunga chun houin kamupoi; Pakai Pathen Hat chungnung chule Kelngoinou chu a-houin ahi jeng jeh chun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule khopi chun asalvah dinga nisa jong ngaita lou, lhathah jong ngaita lou ahi; ajeh chu Pathen loupi chun avahsah jeng ahin, chule Kelngoinou chu ameivah hi jenga ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule huhhingsa namtin vaipi avah-a chu vahle ding, chule leiset lenghon aloupinao asunga chu ahinpoh lut dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule akotkhahho chu a-imatih chana suna kikhah lou ding ahi (chua jan umtalou ding ahi jeh chun);
  </para>
  <para style="p">
    <verse number="26" style="v" />chule namtin vaipin loupinale jabolna asunga chu apoh lut dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule iti nama jongle thil aboh pou poule thet um thil bola chule jou pana lut louhel ahi: Kelngoinou hinna lekhabua amin kisunho chengsebou chu lut ding ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ama chun Pathen le Kelngoinou laltouna-a kona put hintwi theng luidung crystal songvala val, khosung lamlen lailunga chu eivetsah tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule luidung chu apang langto-a hinthing keh ahin aga jat chom chom somleni ga-a, alha seh-a ga jing jeng ahi; chule thingnaho chu namtin vaipi boldamna ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule sapset umta louhel ding ahi. Chule Pathen le Kelngoinou laltouna chu asunga chu umding ahin, chule asohten ama chu ajen dingu;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahon amai amu dingu, chule achaluva amin umding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule jan umta louhel ding ahi; chule amahon thaomei vahle nisa vah ngaita louhel ahiuve; Pakai Pathen'in amaho asalvah ding ahi jeh chun; chule amaho chun atonsot atonsot geija vai apoh dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman kajah-a, Thu hicheng hi tahsan umle dihtah ahi; chomkhat joule hung soh ding hichengse chu themgao thengho Pakai Pathen'in asohte vetsah dinga avantil asol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule, ven, kahungvah ding ahi; hiche lekhabua lhagao thuseidoh ho chengse nitpa chu anunnom ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei John tah-in hichengse hi kajah chule kamu ahi. Kajah-a chule kamu phat chun hichengsepi eivetsahpa vantil anga chun, ama chu chibai boh dingin kaboh khuptan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichun aman kajah-a, Chingtheijin, hitobang chu bol hih-in, keima nangma soh chanpile nasopi themgaoho sohchanpi chule hiche lekhabua thu nit teho sohchanpi kahibouve; Pathen joh chibai bohtan, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman kajah-a, hiche lekhabua lhagao thu kiseidohho hi imchah hihhelin; phat anaitah jeh hin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Achonpha lou chun chonphat lou bol jinghen; aboh chu boh jinghen; chule achonpha chun chonphat bol jinghen; athenga chu athengin umjing hen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Veuvin, keima kahungvah ding ahi; chule athilbol achonna dungjui cheh-a lethuhna kapeh ding tohman kakoma aume.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima Alphale Omega kahin, amasale anukhah kahi, chule abul leh aleh kahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinthing chu lo theina dingle kotpi-a lutna khopi sunga lut theina dinga, athupeh nit ho chu anunnom ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Uicha hole doi choiho, chule jon thanhoi panhole tolthat teho, chule milim houho, chule thujou sei ngailu-a semdoh ho pamah aumui.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kei, Jesu'n, houbung ho-a dinga hicheng thuhi nangho hettohsah dinga kavantil kahinsol ahi. Keima David jungpile achilhah, Jing Valpa vahtah chu kahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lhagao le mouvin, Hungin, ati lhone; ajachanin, hungin, tihen; chule adangchah chan hunghen; ago chanin manbeijin hintwi chu kilahhen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche lekhabua lhagao thuseidoh hi ajachan kahet tohsah-a kaseipeh ahi, Koi hile hicheng hi abelap aumle, Pathen'in hiche lekhabua kisun suhgam naho chengse hi achunga abelap ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule koi hile lhagao thuseidoh hiche lekhabua thuho lamanga aumle, Pathen'in hiche hinna lekhabua kisun hinthinga konle khopi thenga kona chule hiche lekhabu sunga kisun thilho-a kona hi achan alahmang ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hicheng thu hettohsah chun, Ahi, kahungvah ding ahi, ati. Amen, hitichun Pakai Jesu, hungin.
  </para>
  <para style="p">
    <verse number="21" style="v" />I-Pakaiyu Jesu Christa milungset nachun, mithengte nabon chaovin umpiuvin, Amen.
  </para>
</usx>
