<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EPH" style="id">Ephesia</book>
  <para style="h">Ephesia</para>
  <para style="toc1">Ephesia</para>
  <para style="toc2">Ephesia</para>
  <para style="mt">Ephesia</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen lungchama Christa Jesu solchah Paul'in Ephesia'a um mithengho chule Christa Jesu'a tahsanteho hengah.
  </para>
  <para style="p">
    <verse number="2" style="v" />I-Pau Pathen le Pakai Jesu Christa-a konin lungsetnale lungmon naheng uva umhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />I-Pakaiyu Jesu Christa Pale Pathen vahchoijin umhen; aman eiho lhagao phattheina tintangin Christa-a vanho-ah phatthei eichanui;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu aman vannoi bul phudoh masanga pat, ama anga ngailutna le thenga chule nolna beihela i-um theina dinguva, eiho einalhen dohsao ahin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu Christa vanga alamcha dinga einagot masahsao ahi; hichu ama lunggotle lungdeilam bang dungjuija,
  </para>
  <para style="p">
    <verse number="6" style="v" />Amilungset loupi vahchoi dinga, hichea chu adeitah te hidinga, lahtheija eisemu ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche alungdei vanga chu eiho, athisana kilhatdoh ihiuva, lungsetna ahao dungjuija, ichonsetnao jouse ngaidam ichanu ahitai;
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche lungsetna-a chu, aman chihnale lunggel themtah chu eivuhdimu ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutia chu aman alung ngaitole alung deilam dol dungjuija, alunggil thuguh chu eiho eihetsah-un, aphat lhin tenga dinga ama-a gotsa akoi ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichu van ho-a thil chengsele leija um thil chengse, ania Christa-a gop khomsohna dinga ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule masanga patna Christa-a kinema kingaija eiho, eihoa kona ama loupi vahchoina aso theina dinga,
  </para>
  <para style="p">
    <verse number="12" style="v" />Alunggot dungjui tah-a ijakai bolpa chun, ama lunggot dolla einagotsao ahijeh-in, eihon jong ama jal-in goulo theina imutaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama chu nanghon jong thutah, huhhing-a umna Thupha chu najah uva, ama natahsan uva, thutepsa Lhagao Thenga mohor kinama nahitaove;
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichu, achohsa ho lhatdoh nikho kahse-a, aloupi vahchoi dinga, igoulo diu khamgahna ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun Pakai Jesu'a natahsan naole, mithengte nangailut nao thu kajan,
  </para>
  <para style="p">
    <verse number="16" style="v" />keiman jong nangho jal-in katao chanin tang louvin kathangvah jinge;
  </para>
  <para style="p">
    <verse number="17" style="v" />I-Pakaiyu Jesu Christa Pathen, loupina Pa chun, ama hetna lama chihnale, thukilah hetdoh them theina lhagao napehna dingun,
  </para>
  <para style="p">
    <verse number="18" style="v" />Eikounao kinepna hi ipi ahi, mithengho lah-a goulo ding loupina ahaoje chu ipi ahi,
  </para>
  <para style="p">
    <verse number="19" style="v" />atahsana eiho dinga athahat, athilbolthei chungnunje nahet theina dinguva, nalung mitnu vahsah-a auma, athahat athilbol theina dungjuija,
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman Christa-a abola, athiho lah-a kona akaithouva van ho-a ama jet lama atousah ahitai;
  </para>
  <para style="p">
    <verse number="21" style="v" />Vaipipu hi, thuneina, thahat thilboltheina, vainei, chule min kisah jouse chunga chungnung pen ahi, tu hiche vannoi leiset jenga hilouva, khonunga hung lhung dinga jong ahi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule aman thil jouse ama thu noija akengto noija akoisoh ahi, chule houbung chu thil jouse luchang hina apeh ahi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichu ama tahsa ahia, ama dimset banga ijakaija ijakai adimsah ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule nangho nathemmo naole nachonset naova nathi pettah uva Pathen'in nahinsah-u ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichenga chu hiche vannoi leiset chon ngai dola hinga, vanlaijola thuneitah vaipo, tulai thua nungloute lah-a natonga lhagao, puilea chu masang laise-a chu anachonle-a nahiu ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Hicheho lah-a chu eiho jong ibon chaova tahsaphe lamle ilunggot chan suhbukima, tahsaphe ngaichat thu lama inachonu ahi; chule adang dangho banga apen monga lunghanna chate inahiu ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin mihepi khotona haotah Pathen'in ngailutna lentah-a eingailutnu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche jeh-a chu themo-a ithi laitah uva Christa toh thakhatna einahin sah-u ahitai; lungsetna vanga huhhing-a umna naneiju ahitai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Christa Jesu vanga eihepiu hi, khonunga phat hung lhung dinga chu amilungset hao chungnunje phongdoh dinga,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche nadinga chu Christa Jesu vanga amatoh thakhatna eikaithouvu ahitai, chule vanmun ho-a eitousah-u ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungset mana tahsan vanga huhhing-a uma nahitaove; hichu nangho-a kon ahipoi, Pathen thilpehjoh ahibouve;
  </para>
  <para style="p">
    <verse number="9" style="v" />Koimacha kison thei louna dinga, hichu thilbol vanga hilou ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu eiho ama khutsoh ihiuve; chule ichonphatna dinguva, masanga patna Pathen'in agotsa chuche chonphatna dinga chu Christa Jesu'a kisema ihiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche jeh chun tahsaphe dola chidang namdang mi, tahsa-a khutna cheptana kona cheptan min poho lah-a cheptanlou tia kisei nangho,
  </para>
  <para style="p">
    <verse number="12" style="v" />nangho masang laija chu Christa-a kona achom nahiu ahin, Israelte toh kitimat lou nahiuvin, thutep chonna danho chengsetoh kinepna beile Pathen beija hiche vannoi leisetna hi uma nahiuve, hichu geldoh-un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tu vangin masanga nagamlat vangun, Christa Jesu'a naum jeh uva Christa thisan vanga chu anaija nahitaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu ama chu eiho kichamna ahi, aman daltanna banglai chu aphetlhah-a, ania chu pumkhat aso ahitai,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chonna ngaidan thupeh chu, kidouna chu atahsa-a asuhbei ahitai; chutia chu aman ama-a mi ni chu mi thah khat asosahna dinga asuhcham ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule chutia chu kidouna chu thingpel'a atha-a, ania chu Pathen'a dinga akichamsahna dinga abola;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule ama hunga, gamlatah nangho hengle anaiho henga chamna ahung seile ahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh iham itile ama vanga chu eiho iloiniuva, Lhagao khatna Pa anga umna thei thu ineiju ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche jeh chun tu-a kalin nangho maljinle khopem nahitapouve; mithengte chenkhompi, chule Pathen insung mite nahitaove;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Christa amatah inning song ahin, solchah ho le themgaoho songset chunga nangho kisadoh nahiuve;
  </para>
  <para style="p">
    <verse number="21" style="v" />In kisa jouse chu amatoh kijop cheh ahin, houin theng hidinga Pakaiya khangtou in nahiu ahi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama-a chu nangho chengse jong thakhatna kisakhom nahiuvin. Lhagaova Pathen chenna khat hidoh-a nahiuve.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jeh-a chu chidang namdang hija nangho, nangho dinga keima Paul Christa Jesu sohchang hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />nangho dinga Pathen lungset eikichinsah ahia,
  </para>
  <para style="p">
    <verse number="3" style="v" />thu kilah-a kona athugil chengse keima eikihetsah chu najahsao ahitan, (hiche banga chu chunga paltana kahinsut ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon hichu simleu chun Christa thugil kahetje dan hi heuvin nate);
  </para>
  <para style="p">
    <verse number="5" style="v" />Tu-a solchah thenghole athemgaoho henga Lhagaova kona akiphondoh banga hi, malaija mihem chate henga chu ana kihetsah lou ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche thugil chu Kipana Thupha vanga chidang namdangho, Christa goulo khompiho, tahsaphe-a kihoppi thutep chan khompi ahiuvin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Athilbol theina-a anatoh dungjuitah-a, man beija Pathen lungsetna eikipeh bangtah-a, Kipana Thupha lhacha-a pang kahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Holdoh hoi hilou Christa haona chu chidang namdang ho henga seiphongle dinga, mithengte lah-a alhumpen sanga jong neojo keima hiche lungsetna hi eikipea ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu Christa jala thil jouse sema Pathen na, leiset semtila patna kisella um thuguh chu mijouse musah dinga,
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen chihna jat chom chomhi van munho pipule thuneina neiho, tu-a houbung'a kona hetsahna dinga,
  </para>
  <para style="p">
    <verse number="11" style="v" />I-Pakaiyu Christa Jesu'a tonsotna dinga angaitoa aphudet dungjuija chu,
  </para>
  <para style="p">
    <verse number="12" style="v" />eihon ama itahsan vanguva ama-a chu lung ngama, chule ginchat neitah-a lut theina thu aneiju ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche jeh-a chu hiche hi kataona ahi, nangho dinga kagenthei kahesohna jouse jal hin lungthoi hih-un kati ahi: hichu naloupi nao ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche jeh-a chu van'a le leija um phungtin-in, Pa-a kona kiminvona aneiju,
  </para>
  <para style="p">
    <verse number="15" style="v" />hiche I-Pakaiyu Jesu Christa Pa anga chu dilsua, hichenga hi taojia kahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman loupina ahao dungjuija, Alhagaova athahat athilbol theina-a mi sungnung chu ahatsah-a,
  </para>
  <para style="p">
    <verse number="17" style="v" />chule tahsan vanga Christa chu nangho lung sunga achensah theija, nangho ngailutna-a najungkhova nabul neijuva,
  </para>
  <para style="p">
    <verse number="18" style="v" />chule mithengte jousetoh ajaojele asaoje asanje, athuhje, nahettoh theina dinguva,
  </para>
  <para style="p">
    <verse number="19" style="v" />hetphahhoi hilou Christa ngailutna chu nahet theijuva, Pathen chamkimna jouse-a nangho nachamkim theina dingu ahi, kati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutihen lang athahat thilbol thei eihoa natongjia chun, athahat athilbol theina dungjuija, ithumule ilung ngaito jouseu sanga nasajo-a abol theina dingin,
  </para>
  <para style="p">
    <verse number="21" style="v" />houbung'a le Christa Jesu'a atonsot atonsotnin akhang akhangin loupin umjing hen. Amen.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahi jeh-a chu Pakaiya sohchang keima naheng uva kahung tao ahi, Nangho nakikou naotoh kitoh-in chonun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chonnemna bukimin, lung nemtoh, thohhattoh thon chonun; ngailutna-in khatle khat kingaithemun,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chamna-in kikanun, Lhagaova pumkhat hina dingin kihabolun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tipum khat ahin chule Lhagao khat ahi; hiche banga chu nakikouvu jong chu kinepna khatna kikou nahiuve;
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai khat, tahsan khat, baptize chan khat ahi,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule mi jouse Pa leh Pathen khatsehbou ahi; ama imajouse chunga ahin, hoima jouse-a um ahi, chule nangho sung jouse-a um ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Christa thilpeh teptena dan dungjuija eiho khat cheh lungsetna eipeh-u ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun Pathen lekhabun aseije, Ama chung sanga akaltou chun, Gal-hinga kiman mihonpi gal hingin akaitan ahi, Chule miho jong thilpehho apen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahile, Akaltouvin, ati hi leiset noinung geijah akumlha masan ahi, ti lou adang ipi kisei naham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Akumlha-a chu ijakai subukipsoh dinga vanho jouse chung vuma kaltouva ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman abang solchah, abang themgao, abang Kipana Thupha lhangsam, abang chinghoi kaihoi, abang mihil hina apeh ahi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichu lhacha natong dinga mithengho pi lhinsahna ding, Christa tahsa chu khantousahna dinga,
  </para>
  <para style="p">
    <verse number="13" style="v" />Eiho tahsan thakhat ihiuva, Pathen Chapa thudola hetna ineijuva, mi khan kilhit ihiuva, Christa pilhin dungchan iphah masangseuva dinga ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutia chu miho gitlou lungthim doha lha-a suhkhelna dinga, puichat vaija uma chule thuhil hui lhoh lonle chapang ihi thei lou dingu ahitai;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti sang chun luchang hija Christa ama-a chu imalam jouse-a ikhan touna dingun, ngailutna-in thutah seijuhite;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama-a kona tahsa pumpi hi kitoh cheh-a kisuto-a kikilmat khom ahin, hichea chu gu kisuhtona chengsen tibah dangdang ho natohna apeh dan dungjui cheh-a, tahsa pum chu ngailutna-a kisadoh dinga akhantousah ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh-a chu hiche hi kasei ahi, Pakaiya hiche hi kahettohsah nahiuve, chidang namdang ten lungchavai aput dungjuijuva achon bangun chonta hih-un;
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaho chu ahetna lungu thima ahin, Pathen hinna peh chu chang lou ahitaove, asunguva het louna auma, alungu tah jeh chun;
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho lungmoh hiuva ahile, thilthenglou tincheng bolna dinga, lop lamle papset lama kipe-a ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangho vang chutia chu Christa kihilla nahipouve,
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu'a uma thutah dungjuija chu athu chu jatasa nahiuva ama-a kihila nahiule;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun nanghon masang laija chonna dol lama chon, doha lheplhah, gitlou lung gula haset chehcheh mi lui chu pailhauvin;
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule chutichun nalhagao lungthimun kithah semun,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Pathen lim banga chonphatna le thenna dihtah-a kisem mithah chu kivonun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun nanghon jou pailhauvin, amitakip aheng akomtoh thutah jengchan kihou cheh hen; ajeh chu eiho khat khat hi khat tibah hicheh ihiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lung chu lunghangun, ahin chonse hih-un; nalunghan nao chu nisan lhumkhum hihhen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule diabol chu mun ot hih helun.
  </para>
  <para style="p">
    <verse number="28" style="v" />Agucha-a gucha kit ta hihhen; ahin alhasama ato theina dingin, akhut tah-in napha tong gimhen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nakam uva konin thuse soh hihhen, ahin aja chan lungsetna hop theina dingin, ngaichat doltah-a hou thu lama khantou theina dingin thupha sohjohen.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lhatdoh nikho-a dinga mohor nakinam nao Pathen Lhagao Theng chu, lungphat mosah hih-un.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lung damlouna jouse, lunghan, lungsat, kinah, kitaitom, hichengse chule gitlou engsetna jouse nangho-a konin koimangun;
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule nangho kihepito cheh-un; lungnemun Pathen'in Christa-a nangho nangaidam bangu chun, khatle khat kingai damun.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahi jeh chun chate dei bangtah-in, Pathen umchan jom hiuvin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Christan nangho nangailut bangu chun, ngailutna-in chonun; ama nangho dinga Pathen lama maichama thilpeh gimnamtui banga kipe-a ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin mithengte chonna doltah-in, jon thule thenlouna tintang chule papset nalah uva kiphapoh hihhen;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule jamo, thumotsei, totthanghoi, hicheng jong chu nalah uva um hihhen; Pathen thangvahna umjohen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu Christa le Pathen gam sunga chu mi jonpan, mi thenglou, mi papse, milim hou, hicheng chu ima achan dingu aumpoi, ti chu kichenin naheuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mohthu ahomkeovin koima kilhep lhahsah hih-un; hitiho jeh chun thua nunglou chateho chungah Pathen lunghan achujin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun nanghon chutiho chu kikoppi hih-un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh-inem itile nangho khatvei chu muthim nahiu ahin, tu vangin Pakaiya khovah nahiu ahitai; khovah chate bangin chonun;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu Lhagao ga chu phatna jouse, chonphatna, chule thutah ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai lunglhaina ding lam photoh-un;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin muthim natohho ga neilou chu kikoppi hih-un; amaho chu sosalun phohsal jovin;
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu amaho guhthim natohho chu sei ding jong jachat umleu ahi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu ijakai phongjala khovah ahijeh chun, akisosal jouse chu khovah chun aphongjal jitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun aman, Vo imumil, khangin, chule athi lah-a konin thoudoh-in; chutengle Christan nangma nasalvah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun iti nachonum, chingtheijun kihongphauvin; mi lung beiho banga chon louvin, michingho bangin chonun;
  </para>
  <para style="p">
    <verse number="16" style="v" />Tulai nikho hi aphat lou jeh hin, phat kijen petcha hi kichoh-un.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche jeh chun lungthim beijin um hih-un, Pakai lunglam ipi ahi heuvin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule lengpitwi jin kham hih-un; hichea chun setna aume; ahin Lhagaovin dimset jovin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Tumging toh tho lan, hou lan chule lhagao lan kihoulimun; nalunggilun Pakai dingin kitohdelin longdelin la saovin;
  </para>
  <para style="p">
    <verse number="20" style="v" />Imatih chanin imalam jouse-a dingin I-Pakaiyu Jesu Christa minin Pa Pathen thangvah jingun;
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen janan khat thun khat nungun.
  </para>
  <para style="p">
    <verse number="22" style="v" />Numei ho, nangho Pakai thu noija bangin na-inneipu chengu thu noija umun;
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajeh iham itile Christa houbung luchang ahi banga chu, inneipu jong numei luchang ahi; ama tahsa huhhing-a jong ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahin houbung Christa thu noija aum bang chun, numei ho jong imalam jouse-a a-inneipu cheh-u thunoija um cheh-u hen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Inneipu ho Christan houbung angailut bangle, ajeh-a ama akipehdoh jeng bangtah chun, nanghon jong na-inneipite chengu ngailuvin;
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman twija asilngima, thua asuhthengna dinga, ama kipedoh jeng ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichu boh beh louhel le avoi kom beihela, thengtah le nolna beihela, a houbung chu loupitah-a ama anga aumsahna dinga ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuti ahi jeh chun innei puhon jong a-inneipite chengu, ama ama tahsa banga angailut dingu ahi. Koi hile a-inneipi ngailu-a chu ama kingailua ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajeh chu imatih chanin koiman ama tahsa ahotbol khapoi; avah khangin ahebol bouve. Pakaiyin houbung abolna bang chun.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajehchu, eiho aphele agu-a kon, atibah ihiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh-a chu min anu apa adalhah-a ajia beh ding ahi, chule amani chu tikhat hilhon ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hiche thugil hi giltah ahi; ahivangin keiman Christa le houbung thua kasei ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijongle nangho changval cheh-in na-inneipi chengu nangma naki ngailut bangin ngailuvin; chule inneipi chun a-inneipu aja ding sumil hihhen.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chateho, Pakaiyah nanu napau thun nungun; hichu chondih ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanu napa jabolin; hichehi thutep togoma thupeh masa ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutile naphat theija leiset chunga nahinkho sotding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule pateho, nanghon nachate chengu sulunghang hih-un; Pakai thuhila chon kichuhna le tilkhouna lamin seiletsah jovin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sohteho, nangho Christa thu noija naum bangu chun, kichatle kitihot pumpumin, lung jangkeijin tahsa lama napakai te chengu thu noija umun;
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihem lunglhaisah nadinga mitmu soh hilouvin, lungsunga kona Pathen lunglam bola Christa soh bang hiuvin;
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihem lama hilouvin, Pakai lama phatna lunggela napha tong hiuvin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Amitakip, soh hihen, soh hilou hijongle, koi hile thilpha bol chan chun, hiche mama chu Pakaiya kona asan kit ding chu heuvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule pakaiho, chutobangma chun amaho chu bolun, amahole nangho nagom uva na-Pakaiyu chu van'ah aumin, chule aman mi koima datle langkaina aneipoi, ti heuvin lang, hutum gihsal boldaovin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Achai nakeijin, sopite, Pakaiyah chule athahat athilbol theina-a chun hatnun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Diabol lungthim gilou tincheng masanga nadin jou theina dingun, Pathen galvon chengse kivonun,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu eiho tahsaphe le thisantoh kibon ihipouve; pipuho toh, thahat thuneiho toh, hiche vannoi muthim vaipoho toh, vanmun ho-a lhagao gilou engsehotoh kibonjoh ihiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun nikho phalounia nalethuh jouna dingule, ijakai nabukip sohkeijuva nadindet theina dingun, Pathen galvon chengse panun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiti chun thutah-in kong kigah-un, chonphatna ompho kiah-un;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule gotsa chamna Kipana Thupha kengchot kiseuvin dingun;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chucheng chunga chun tahsan lum panun, agiloupa thalpi meikong tobang ho jouse chu nasuhmit jouna dingun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule huhhingna lukhuh chu kilah-un, Lhagao chemjam panun, hichu Pathen thu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Taona jousele thumna tintangtoh thon a-imatih chanin Lhagaovin tao jingun, chule hichena ding chun mithengte jouse dingin thohhat le thumna jouse thon hichea chun kiging jingun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule keima dingin jong paodohna dingdola thuseidohna eikipeh theija, chutia chu Kipana Thupha thugil hi hakat tah-a kaseiphonga, kahetsah theina dingin, neitaokop jingun;
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche dinga chu thihkhaova kihena leng palai natonga kahi, hichea hi hakat tah-a kaseidol kasei theina dingin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keima thudol, iti kaum ipi kabol, nahetna dingun Pakaiya lhacha tahsan umtah sopidei Tychicus, ama hin ijakai nahetsah naovinte.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keima umchan dol thu nahetna dingule, aman nangho nalhamon theina dinguva, hiche lungngaito-a chu keiman ama hi naheng uva kahinsol ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pa Pathen le Pakai Jesu Christa-a konin, sopite henga lungmonle tahsan chule ngailut umkhom hen.
  </para>
  <para style="p">
    <verse number="24" style="v" />I-Pakaiyu Jesu Christa kemthei louva ngailuho chengse chu lungsetna hin umpihen, Amen.
  </para>
</usx>
