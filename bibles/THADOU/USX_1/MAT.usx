<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MAT" style="id">Mathew</book>
  <para style="h">Mathew</para>
  <para style="toc1">Mathew</para>
  <para style="toc2">Mathew</para>
  <para style="mt">Mathew</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham chapa, David chapa, Jesu Christa khangui thubu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham'in Isaac ahingin; Isaac'in Jacob ahingin; Jacob'in Juda le asopiteho ahingin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Juda'in Tamar toh Pharez le Zera ahingin; Pharez'in Esrom ahingin; Esrom'in Aram ahingin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Aram'in Aminadab ahingin; Aminadab'in Nahson ahingin; Nahson'in Salmon ahingin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Salmon'in Rahab toh Boaz ahingin; Boaz'in Ruth toh Obed ahingin; Obed chun Jesse ahingin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesse'in David lengpa ahingin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David'in Uriah inneipi toh Solomon ahingin; Solomon'in Rehoboam ahingin; Rehoboam'in Abijah ahingin; Abijah'in Asa ahingin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Asa'in Josaphat ahingin; Josaphat'in Joram ahingin; Joram'in Uzziah ahingin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Uzziah'n Jotham ahingin; Jotham'in Ahaz ahingin; Ahaz'in Hezekiah ahingin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hezekiah'in Manasseh ahingin; Manasseh'in Amon ahingin; Amon'in Josiah ahingin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Josiah'in Jechoniah le asopiho Babylon gama atolmang laijun ahingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Babylon'a atolmang nungun, Jekoniah'in Shealtiel ahingin; Shealtiel'in Zerubbabel ahingin;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerubbabel'in Abiud ahingin; Abiud'in Eliakim ahingin; Eliakim'in Azor ahingin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Azor'in Sadoc ahingin; Sadoc'in Akim ahingin; Akim'in Elihud ahingin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Elihud'in Eleazer ahingin; Eleazer'in Mathan ahingin; Mathan'in Jacob ahingin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin, Jacob'in Joseph ahingin, ama chu Christa kiti Jesu penna nu Mariam inneipu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitichun khang agomin Abraham'a pat David geijin khang somle khang li ahin, David'a pat Babylon gama atolmang geijin khang somle khang li, chule Babylon gama atolmanguva pat Christa pen gei khang somle khang li ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu Christa pen umchan chu hiti ahi. Anu Mariam chu Joseph'in aji dinga ahol ahin, akigop masang lhonin amanu chu Lhagao Thenga kona agai akihedohtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin a-inneipu Joseph chu michonpha tah ahi jeh-in, lhang phonga japi seithangin aumsah nom hih-in, guhthima kikhenpi ding lung angai totan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman lung achuti ngaito laitah-in, veuvin, Pakai vantil khatnin amangin akimusah-in, ajah-a, David chapa Joseph, na-inneipi Mariam gakipuilut ding olmo hih-in; ijeh-inem itile ama Lhagao Thenga kona gaija ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amanu soh intin chapa khat ahin ding ahi, chule amin Jesu nasah ding ahi; ijeh-inem itile amatah chun amite achonsetnuva kona ahuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakaiyin Themgao kama asei thu,
  </para>
  <para style="p">
    <verse number="23" style="v" />Veuvin, nungah theng chu hung gaijintin, chapa khat ahin ding ahi, Chule amin Immanuel asah ding ahi, ati, (Hichu Pathen'in eiumpiuve tina ahi) tia asei chu guilhuna dinga thu hicheng chu soh-a ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Joseph a-imut akhangin, akipat in Pakai vantil'in thu apeh bang chun abolin, a-inneipi chu akichenpin ahi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin amanun chapa peng masapen anei kahsen kitohkhahpi louhelin aumin; chuin acha chu amin Jesu asahtai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Herod lengpa lal laijin Judah gama Bethlehem khopi-ah Jesu apengtan ahile, veuvin, niso lama konin ahsi lekhathem ho phabep Jerusalem'a ahungun, Judah te lengpa apengin ahi, ama chu hoilamham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Keihon niso lamah ahsi kamuvin, chibai bola hung kahiuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Herod lengpan chuche thu ajah phatnin, amati Jerusalem miteti alungu ajingtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuphatnin thempu pipuiho leh miho danthu sunho chu akhomin, Christa hoija peng dingham, tin adongin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon ajah-a, Judah gam Bethlehem'a peng ding ahi; ijeh-inem itile,
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Judah gama um Bethlehem, Judah vaipote lah-a nangma iti nama jongle aneopen nahipoi; Ijeh-inem itile nalah-a kona vaipo khat, Kamite Israelte ching ding chu pengdoh ding ahi; tin themgao seija konin akisune, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Herod in ahsi lekhathem ho chu guhthimin akouvin, ahsi so phat chu kichentah-in ahetoh tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amaho chu Bethlehem'a asolin, Cheovinlang naosen chungchang thudol chu chentah-in gadongtoh uvin; chule namudoh tengule keima jong kache-a chibai kagaboh theina dingin thu hinpo kit uvin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lengpa thu ajah phatnun amaho akipatdoh taovin ahi; chule, veuvin, niso lama amu-u ahsi chu amasanguva achepeh-in, naosen umna chunga chun akingan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahsi chu amu phat uvin athao anomin, hapan akipah-un ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amaho in sunga alutnun ahile naosen chu anu Mariam toh amu thaovin, aboh khupmun ama chu ahou taovin ahi; chuin athil lu bom cheh-u asolhaovin, kipamanin, sana, bego, myrrh ama chu apetaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin amanguva Herod heng lama akile kit louna dinguva Pathen'in ahilchah jeh uvin, lam chom ahovin agam lamuva achemang taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amaho chedoh nungin, veuvin, Joseph amangin Pakai vantil khatnin, Thouvin, naosen leh anu puijin lang Egypt gama jam lutpitan, chule thu kapeh kahsen chua chun um jingin; ijeh-inem itile Herod'in naosen chu suhmang dinga ahol ding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ama athoudoh-in, jan-in naosen leh anu akipuijin, Egypt gam ajontan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Herod thi kahsen hia chun aumin ahi: Pakaiyin themgao kama asei, Egypt gama konin ka-Chapa kakouve, ati chu guilhuna dinga chuti ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahsi lekhathem hon alhim lhah-u ahi akihetdoh phatnin, Herod alunghang behseh-in, mi asolin, ahsi lekhathem ho-a kona aphat ahetchen dungjui chun, Bethlehem le akimvel sese-a pasal chapang kum ni-a lhah noilamse athattan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun themgao Jeremiah thusei,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ramah-a akaple amao aw akijai; Rachel'in achate aka akan, Aum lou jeh uvin lhepbi ding anomtapon ahi; ati chu guilhunga ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin Herod athi phatnin, veuvin, Pakai vantil khatnin Egypt gamah Joseph mangin akimusah-in,
  </para>
  <para style="p">
    <verse number="20" style="v" />Thouvin lang naosen leh anu kipuijin, Israel gam lama chetan; naosen tha dinga goteho chu athitaove, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ama kipatdoh-in, naosen leh anu akipuijin, Israel gam lama ahung kit tai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin Judah gamah Archelaus apa Herod khelin vai apoi ti ajah phatnin, chulama ache ngamta hih-in; amanga akihilchah jeh-in, akipatnin Galilee gamah akileheitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule ama chu Nazareth mi kiti ding ahi, tia themgao hon asei chu guilhun theinan, achen Nazareth khopi-ah achengtan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chulai chun John Baptist chu ahungin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nalung heijun; van lenggam anaitai, tin Judah gam gamthipmah thu alhang samlen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Isaiah themgaovin, Gamthipma khosam aw khatnin, Pakai lamlen semtohsan koijun, Alampi semjangun, tin aseije, tia asei chu ama hi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />John chu apon-ah sangongsang mul ahin, akongah savun konggah akigah-in, chule a-anneh chu khaokho le gam khoiju ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuphatnin Jerusalem le Judah gam jouse-a mi, chule Jordan vel gamkol sung jouse-a mi ahenga ache acheuvin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Achonsetnao cheh aphongun, Jordan luidunga chun ama khutna baptize achang taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin Pharisaiho le Saddukai ho mi tamtah ama khutna baptize chang dinga ahungu amun phatnin, ajah uva, Vo gulse sonho, Khonunga lunghanna hung lhung dinga kona jamna ding lungthim koiham napeuva?
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun lunghei toh kilomin gadoh-un;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nalah uva, Abraham kapului'u aumnai, tin ngaito hih-un; ijeh-inem itile tahbeh-a kaseipeh nahiuve, hiche songho-a kona hi Pathen'in Abraham chate asodohsah thei ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule tu jenga jong thing bultina heicha kikoija ahitai. Chutiachu thingphung aga phalou chengse chu kiphuh lhu-a, meija kisep lutji ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lungheina dinga keiman twija baptize kachansah bou ahi; amavang kanunga hungpa keima sanga chungnungjo ahi; keima akengchot choi dinga jong kilom kahipoi. Amatah chun nangho Lhagao Theng le meija baptize nachansah dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman akhutna godal achoije; aman aphol jap ngimsel intin, achang apang sunga akhum ding; asi vang chu mit theilou meija agovam ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche pet chun Jesu John khutna baptize chang dingin, Galilee'a konin John hengah Jordan lamah ahungin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin John anathuphan, Nangma khutna kachan ding johsih-a, nangma kahenga hung nahim? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jesu'n adonbutnin, Tun hisah poupoutan; ijeh-inem itile chonphatna jouse abancha hitia hi ibulhit dingdol ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Jesu baptize achan jouvin, twilah-a konin apotdoh paitan ahi; chuin, veuvin, ama dingin van kot akihongin, chule Pathen Lhagao vakhu banga ahung lenlhah-a achunga ahungchuh amun;
  </para>
  <para style="p">
    <verse number="17" style="v" />chuin, Ama hi ka-Chapa deitah ahi, achunga kalung alhai tangeije, tin van'a konin aw ahung gingin ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichun Jesu diabol lhep patepma umdingin gamthipmah Lhagao puitouvin aumtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin nisomli le jansomli an ngola aum jouvin, agil keltan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin alhempa chu ahenga ahungin, ajah-a, Nangma Pathen Chapa nahile, hiche songho hi changlhah asona dingin thu pen, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin aman adonbut-in, Mihem changlhah jenga hing lou ding ahi, Pathen kam sunga kona thu pot chengsea bou hing ding ahi, hitichun akisune, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuphatnin diabol'in ama chu khopi theng lama apuijin, Pathen houin tingvuma chun adinsah-in, ajah-a,
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen Chapa nahile, nangma kichomlha jengin; ijeh-inem itile hitihin akisune, Aman nangma chung changah avantilho thu pentin, Amahon akhutnuva nadop dingu ahi; Achuti louleh songah nakeng sukhan nate, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu'n ajah-a, Hiti jonghin akisune, Nangman Pakai na-Pathen lhem patep hih-in, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Diabol'in ama mol sangtah chunga apuikitnin, vannoi leiset gamle aloupina jouse jong avetsah-in; chuin ajah-a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Nakhupboh-a nalhuh-a neihouva ahile, hichengse hi penge, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutah-in Jesu'n ajah-a, Chemangin, Satan; ijeh-inem itile hitin akisune, Pakai na-Pathen chu houvin lang ama jengbou jenin, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin diabol in ama adalhatai; chuin, veuvin, vantil ho ahungun ama chu ahung jenle taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jesu'n John amantaove ti ajah phatnin, Galilee gam lama achen;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Nazareth adalhan, Zebulun le Naphtali gamkai sunga dillen panga, Capernaum kho-a achen agachengin ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Isaiah themgaovin asei,
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebulun gam le Naphtali gam, Jordan gal lang khat gamkol dillen panga cheng, Chidang namdangte Galilee;
  </para>
  <para style="p">
    <verse number="16" style="v" />Muthim lah-a touho chun vah loupitah amutaove, Chule thina gamle alima touho chunguva kho avahtai, ati chu guilhuna dinga chuti ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche laija pat chun Jesu'n thu ahil lhanglen, Nalung heijun; vangam anaitai, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin Jesu Galilee dillen panga avale petnin, Peter kiti Simon le anaopa Andrew dillena len ase lhon amun; amani chu nga man mi ahi lhone.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman amani jah-a, kanung hinjui lhonin, keiman nangni mi man len sepmin sem lhoninge, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amanin apet petnin alen adalha lhonin, anung ajui lhontai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ama chukoma konchun achepaijin ahile, midang ucha nima, Zebedee chapa Jacob le anaopa John apau Zebedee toh kong sunga alennu anakhui phatnu amun; amanima chu akouvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amanin apet petnin akongle apalhon adalha lhonin, anung ajui lhontai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Jesu Galilee gamse se-a avahle avahlen, akikhopnao in tinah thu ahillen, Pathen lenggam Kipana Thupha ahil lhanglen, miho ahivei jouseu chule adamlou jouse adamsahtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichun Syria gama amin akithangin; thilhavop, abuhthi, langthi, ima hivei chomchom veija anat thohlel jouse ahenga ahinpuijun, aman amaho chu aboldam sohkeijin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Galilee, Dicapoli, Jerusalem, chule Judah gama konle Jordan gal lang khat lama konin mihon tamtah-in anung ajuitan ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aman mipi chengse chu amun, molvum chungah akaltouvin; chuin ama atouvin ahile aseijuite chu ahengah ahungun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama apaodoh-in, amaho chu hiche thuhi ahil pantan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lhagaova vaichaho anunnom ahiuve; ijeh inem itile van lenggam chu amaho-a ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Alhaseteho anunnom ahiuve; ijeh inem itile lhep lungmonga umding ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi lungnengteho anunnom ahiuve; ijeh inem itile amahon leiset chung alo dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chonphatna lama gilkel le dangchah ho anunnom ahiuve; ijeh inem itile amaho chu vading ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Milungset teho anunnom ahiuve; ijeh inem itile amaho chu kilungset ding ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Milungthengho anunnom ahiuve; ijeh inem itile amahon Pathen amu dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Misucham ho anunnom ahiuve; ijeh inem itile amaho chu Pathen chate kiti ding ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chonphat jala bolsetna thohho anunnom ahiuve; ijeh inem itile van lenggam chu amaho-a ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keima jala mihon nahouset uva, nabolset uva, chule nachung uva jouthu-a thugilou asei tengule anunnom nahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kipah-un, hapan kipah-un; ijeh inem itile van'a nasan dingu kipaman atame; ijeh inem itile nangho masanga anaum themgaoho jong chu mihon chutobangma chun abolseuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho leiset chi nahiuve: ahin chi khu tam tahenlang hile, ipi-a ki-al sah dingham? Chukalle apanna umtapontin, paidohle mihemte chotpha dingbou ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangho vannoi vah nahiuve. Lhang vuma khopi chu akisel theipoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Min meivah avah-in, lo akhukhum ngaipoi, atunna chunga akoijin; chuteng in sunga um chengse chu asalvah bouvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche bang chun navah-u chu miho angah kilanghen, chuteng amahon nachon phatnao chu mu theijuntin, chule van'a um na-Pau chu avahchoi dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keima danthu le themgaoho thu sumang dinga hungin neingaito hih-un; asumanga hung hilouvin, asubulhit dingjoh-a hung kahibouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijeh-inem itile tahbeh-a kaseipeh nahiuve, Vanle lei aman kahse-a, danthu chu jemsipah penle ajem halsicha jong aboncha abulhin masangse-a mang lou ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun koi hijongle hiche thupeh neopen lah-a khat suse-a, chule chutobanga bol ding hila chu, van lenggama aneopena kisei ding ahi; chule koi hijongle anitna, chule chutobanga hila vang chu, van lenggama alenpena kisei ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh-inem itile kaseipeh nahiuve, Nangho danthu sunho le Pharisai ho sanga nachon phatnao achung nunjoh louva ahile, van gama nalut louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tolthat hih-un; koi hijongle tolthat chu thupi tanna-a dinga kicha jinga umding ahi, tia malai mite jah-a kisei thu chu najataove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin keiman nangho jah-a kasei ahi, Koi hijongle ajeh beija asopi lunghan khuma chu thupi tanna-a dinga kicha jinga umding ahi; chule, koi hijongle asopi, Raca, tia chu houvaipoloi kikhopna-a dinga kicha jinga umding ahi. Chule koi hijongle asopi, Mingol, tia chu damun meidila dinga kicha jinga umding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche jeh chun maicham mun'a thil to ding nachoija nahunga, nasopi nachunga alung himona nahetdoh-a ahile,
  </para>
  <para style="p">
    <verse number="24" style="v" />Nathil to ding chu maicham koma chun dalhanlang, chen, nasopi chutoh gakicham masan, chujoule hungin nathil to ding chu toh-in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nahehpa chu lampia naum petnin kichampin, achuti loule nahehpan thutan vaihom henga leh lutnin natin, thutan vaihom chun sottolle khutnah pedoh-in natin, chuteng aman songkul'a nakhum ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tahbeh-a kaseipeh nahi, Nangman achai nakei paisa keh khat geija nasahsoh masangse-a, iti jongle chua kona napotdoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jonthanhoi bol hih-in, tia malaija kisei chu nanghon najataove;
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin keiman nangho kaseipeh nahiuve, koi hijongle numei jonlunga vea chu amanu chutoh alunga jonga ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule namit jetlamin nasuhmo le, kaldoh inlang paimangin; ijeh-inem itile natahsa pumpi damuna lelutna aum sangin, natibah khat aman ding nang dingin aphajoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule nakhut jetlamin nasuhmo le, hi jong chu satlhan lang paimangin; natahsa pumpi-a damuna nachuh sangin, natibah khat aman dinga nang dinga phajo ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule, Koi hijongle aji da-a chun, dana lekha pehen, kitisa ahi;
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahivangin keiman najah uva kasei ahi, Ajon jeh tailouva thu dang jeh-a aji da-a chun, ajinu chu ajonsah ahi; chule koi hile akidasa numei chu akichenpia jong chu ajonga ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chukitle, jouvin Kihahsel hih-un, naki hahselna chu Pakai henga molson, tia malai mite jah-a kiseisa chu najataove;
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahivangin keiman najah uva kasei ahi; Imachan kihahsel hih-un, van min panin kihah sel hih-un, Pathen touna ahi jeh-in;
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule lei min panin kihahsel hih-un, ijeh-inem itile hichu akengto ngapna ahi. Jerusalem min panin kihahsel hih-un; ijeh-inem itile hichu Leng chungnung khopi ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Naluchang panin kihahsel hih-un; ijeh-inem itile nangman nasam jang khat jengcha jong nakansah navomsah theipon ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahin nasei chu ahile ahi, ahiloule ahilou hijenghen; hicheng kalval chu agilouva kona bou ahitai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mit khela mit, ha khela ha, tia kisei chu najataove;
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahivangin keiman nangho jah-a kasei ahi, Migilou thuh hih-un; amavang koi hile nangeiphe jetlam benga chu, lang khat jong dopeh-in.
  </para>
  <para style="p">
    <verse number="40" style="v" />Koi hile heh dinga nago-a nasangkhol sungnung lah dinga go-a chu, naponlen jong chu pe jengin.
  </para>
  <para style="p">
    <verse number="41" style="v" />Koi hile apoh po dinga nacham louva bola mile khat napuija chu, mile ni chepin.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nahenga thuma chu pen, nahenga thilpa thuma chu kihei mangsan hih-in.
  </para>
  <para style="p">
    <verse number="43" style="v" />Naheng nakom ngailunlang, chule namelma teu hotbolun, tia kisei chu najataove;
  </para>
  <para style="p">
    <verse number="44" style="v" />Ahivangin, keiman nangho jah-a kasei ahi, namelma teu ngailuvin, nagaosap teo chu phatthei boh-un, nahoteu chu phatbolun, chule nadangdat teole nabolseteu dingin taopeh-un;
  </para>
  <para style="p">
    <verse number="45" style="v" />Chutilebou van'a na-Pau chate nahithei dingu ahi. Ijeh-inem itile aman migiloule mipha chunga anisa asosah gelin, chule michonpha le michonse chunga go ajuhsah gelin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ijeh-inem itile nanghon nangailu teo jeng chu nangailut uva ahile, ipi kipaman nasan dinguham? Kaidonghon jong chutima chu abolu hilouham?
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule nasopiu jengmai salam naboh uva ahile, midang ipi-a nakhelnao umam? Kaidonghon jong chutia chu abol louham?
  </para>
  <para style="p">
    <verse number="48" style="v" />Hijeh chun van'a um na-Pau aphat chamkimsoh bangin, nangho jong chamkimun.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nathilphabolu chu mihon amuna dinguva amasanguva nabol louna dinguvin chingtheijun; chutia nabol ule van'a na-Pau koma san ding kipaman nei lou nahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun mi thil napeh tengule, mi pachat ding ngaitonan miphalhem ho bangin kikhopna in tinleh lam dungah namasang sang uva sumkon mut hih-un; tahbeh-a kaseipeh nahiuve, Amaho chun kipaman akisanu ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma vangin mi thil napeh teng, nakhut jetlamin abol chu nakhut veilam hetsah hih-in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutilebou nathilpeh chu guhthim hintin, guhthima mu-a na-Pan phongtah-a nangma nasah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangho Pathen henga natao tengule miphalhem hotoh bang hih-un, amahon mi mu dingin kikhopna intina le lamkontina dina tao adeijun ahi. Tahbeh-a kaseipeh nahiuve, Amaho chun kipaman akisanu ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang vang natao tengle, na-insung dana lutnin lang chule kot khah-in, guhthima um na Pa henga taovin; chuteng guhthima mu-a na-Pan nangma phongtah-a nasah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amavang chidang namdangte bangin naseisa velsei kit hih-un, ijeh-inem itile amahon thu tamtah asei jeh uva chu jahpeh-a umdinga angaitou ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun amahotoh bang hih-un; ijeh-inem itile nathum masangun, nadei nangai chanu chu na-Pau vin ahenai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun hitihin taovun; Van'a um ka-Pau, namin kijahen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nagam hung lhunghen. Van'a nalungchan akim bangin, leija jong nalungchan kimhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tunin kaneh khop dingu anneh neipeuvin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kalei bateu kangaidam bangun, keiho bat jong ngaidamin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule lhepna-a neipui hih-un, agilouva konin neihuhdoh jouvin: ajehchu lenggam, thahat, chule loupina atonsotna nanga ahi, Amen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh-inem itile nanghon mi suhkhel nangaidam uva ahile, van'a na-Pau vin jong nangho suhkhel angaidam ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amavang nanghon mi suhkhel nangaidam lou vangule, na-Pau vin jong nangho suhkhel angaidam lou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nanghon an nangol tengule, miphalhem ho bangin kinguisah hih-un; ijeh-inem itile amahon an angolu min ahetna dingin, amaiso achom ahisah jiuvin ahi. Tahbeh-a kaseipeh nahiuve, Amahon kipaman akisanu ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma vangin an nangol tengle, nalu thao kinunlang, namai jong kiphet in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutile mihem mitmu hilouva, guhthima um na-Pa mitmu-a an ngol nabah ding ahin; chuteng guhthima mu-a na-Pan phongtah-a kipaman napeh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngetle twi eh-in asuhmang theina, guchan aphet vanga chule aguhmang theina leiset chungah gou khol hih-un;
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang ngetle twi eh-in asuhmang thei louna, guchan jong aphetvang theilou nale aguhmang thei louna van'ah nagou kholun;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ijeh-inem itile nagou umna-a chu nalung jong umding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mit hi natahsa meivah ahi; hijeh chun namit achima ahile, nati pumpi vah ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amavang namit phata hihle, nati apumpi thim ding ahitai. Hijeh chun nasunga um vah chu athima ahile, hiche thim chu ichana thimding hitam!
  </para>
  <para style="p">
    <verse number="24" style="v" />Koima pakai ni soh ahi theipoi; ijeh-inem itile aman khat hotbolintin, khatjoh angailut ding ahi; ahiloule khatna hakai jintin, khatjoh anahsahmo ding ahi. Nangho Pathen le sum soh nahikop thei lou dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh-a chu nangho jah-a kasei ahi, i-kaneh ding hitam, i-kadon ding hitam, tin na hinna dingun; ahiloule, i-kasila kachen ding hitam, tin natahsa dingun lungkham hih-un. Anneh sanga hinkho, chule nihchen ponsil sanga tahsa thupijo hilouham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Chunga leng vacha khu ngaitouvin, amahon tula atupouvin, atla a-at pouvin, ahinla van'a um na-Pau vin amaho khu avahnai. Nangho khuteho sanga lujo nahi lou uham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangho lah-a lungkham hatna ahinkho tong khat jopsaobe thei koi nahiuvem?
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule nihchen ponsil jeh-a ibola nalung kham uham? Jaova molhoipah khu iti khanham ngaitouvin. Hicheho khun tongla atonggim pouvin, patla akhehpouve;
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivanginla keiman najah uva kaseipeh nahiuve, Solomon jeng jong aloupina jouse-a akivon chun, hiche molhoi khattoh kibangin akijem hoipon ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule jaova hampa tunia uma, jinga lhum sunga kileh lutta ding jengbon Pathen'in achuti jeple, vo tahsan lhomho, chu sanga chu Aman nangho najepjoh lou dinguham?
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh chun, I-kaneh dinguham? I kadon dinguham? I kasil dinguham, tin lungkham hih-un;
  </para>
  <para style="p">
    <verse number="32" style="v" />Ijeh-inem itile chidang namdang ten hitiho chu aholu ahin; chule nanghon jong hicheng chu nangaichaove ti van'a na-Pau vin ahenai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahivangin amasatah-in Pathen lenggam le chonphatna hol masaovin; chuteng hichengse jong chu naki pehbe dingu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hijeh chun jinga dingin lungkham hih-un; jing chun aman hinki ngaito nante. Ni khat hesohna chu ni khatna dingin atohbepmin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Oimo-a naum louna dinguvin, mi oimo hih-un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na-oimo bang cheh-a chu oimo-a naum dingu ahin; chule nanghon nate bang banguva chu nangho kitepeh dinga nahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma mitna thingtum uma chu ngaito louva, ibola nasopi mitna bohthem chu navet ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ven, nangma mitna thingtum uma, nasopi jah-a, namitna bohthem umchu neilahdoh sah-in nati theiham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo miphalhem, nangma mitna um thingtum chu kilahdoh masatnin; chutengle nasopi mitna bohthem chu lahdoh dinga namuchen dingbou ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Uichaho khu thiltheng pe hih-un, vohcha anga natwikoh changu seplha hih-un; amahon hitiho chu akengun chonuntin, chule hungkile heijuntin nangho jengjong nalhehtel dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thumun, kipe ding nahiuve; holun, namu dingu ahi; kiuvun, kihon peh ding nahiuve;
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh-inem itile athumchan achangin; aholan amun; chule akiuva chu kot kihon peh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Achapan changlhah athumle song pe-a,
  </para>
  <para style="p">
    <verse number="10" style="v" />Nga athumle gul pe dinga, nalah uva koi naum uvem?
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun nanghobon migiloutah hiuva, nachateo thilpha pehje nahet ule, hiche sanga chu gamchenga van'a na-Pau vin ahenga thumte chu thilpha apeh lou dingham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun ima jouse-a min nangho iti nabolle nadeijum, nanghon jong chutobang chun bolun; ijeh-inem itile hichu dan thupeh le themgaoho thu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kot jima lutnun; ijeh-inem itile manna lam chu akot jatah ahin, alampi jong lentah ahi, chule chua lut chu tamtah ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinna lam chu akot jong ajimin, alampi akichin, chule hichu amua alhome.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kelngoi von kivona asunglamla ngei hangtah hia themgao lhem, naheng uva hungjiho-a konchun kichih theijun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaho chu agauva nahet jeng dingu ahi. Mihemin lingphunga lengpiga aloa, ahiloule meithai seltho linga theichang alo ngaijem?
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche bang chun thingphung pha jouse aga aphan, thingphung lungvei chun ga phalou asepdoh jin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thingphung pha-a aphalou gathei lou; chule thingphung phalouva jong apha gathei lou ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thingphung aga phalou chengse chu kiphuh lhu-a meija kisep lutji ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun nanghon amaho chu agauva nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakai, Pakai, eiti chan chu van lenggama lut ding ahipoi; koi hileh van'a um ka Pa lunglam bolpabou chu lut ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche ni chule mi tamtah-in kajah-a, Pakai, Pakai, keihon nangma mina thu kasei lou uham? Chule nangma mina thilha kanodoh lou uham? Chule nangma mina bolmo kidang kabol lou uham, ati dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiteng chule keiman amaho chu phongtah-a kaseipeh-a, Keiman nangho imatihchanin kahekhapouve; vo chonset bolteho, kakoma konin chemangun, kati ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun koi hijongle kathu hicheng hi ja-a, bola chu, song chunga in sa milungthim phatah toh kitekah ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin go ahung jun, twi ahungsoh-in, hui ahung nungin, chuche in'a chun achun; ahin song chunga kibulphu ahi jeh-in alhupon ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule koi hijongle kathu hicheng hi ja-a, bol lou chu, nellei chunga in sa milungthim bei toh kitekah ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin go ahung jun, twi ahungsoh-in, hui ahung nungin, chuche in chu ahin nuhtan ahile alhutai; chule alhuh chu nasatah ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Jesu'n thu chucheng asei jouvin, mihonpi chun athuhil chu kidang asa lheh-un ahi,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ijeh inem itile Aman amaho danthu lekha sunho mihil banga hil louva, thuneitah banga amaho chu thu ahil ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin ama molsang chunga konin akumsuh-in ahile, mipi tamtah-in anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin, veuvin, miphah khat ahenga ahungin, chibai ahung boh-in, Pakai, nangma nalung ahile keima eingimsah thei nahi, ahungtin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jesu'n akhut alhangin, athamin, Kalung ahi: ngimtan, ati. Chupet tah chun aphah chu adamtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jesu'n amapa jah-a chun, Ven, hiche thuhi koima jah-a sei hih-in, amavang chenlang thempu gakimu sahtan, chule amaho hettohsahna dingin Mosi thupehsa thilto ding chu gatohtan, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jesu Capernaum alutnin ahile, sepai jalamkai khat ahenga ahungin, ngehna aneijin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai, kasohpa alangthin in'a alumin, anat athohlel lheh jenge, atin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jesu'n ajah-a, Hunging ting hung damsah nange ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin hiche sepai jalamkai chun adonbutnin, Pakai, nangma ka-in sunga nahung lut ding chu, keima chutia kilom kahipoi; nangman thuchengcha khat seile chun, kasohpa dam jeng ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijeh-inem itile keima jong mi thuneina noija um kahin, keima noija sepaiho aumun; chule keiman khatpenpen chu, Chen, katile, achen; achomkhat, Hungin, katile, ahungin; chule kasoh jah-a, Hiche bolin, katile, aboljin ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu'n chuche thu ajah phatnin, kidang asan, anunga hungho jah-a chun, Keiman tahbeh-a nangho jah-a kasei ahi, Israel lah jenga jong hitobang tahsan len khatcha jong kamu khapoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman nangho jah-a kasei ahi, Niso lama konle nilhum lama konin mi tamtah hungintin, Abraham, Isaac, chule Jacob toh van lenggama toukhom ding ahiuve;
  </para>
  <para style="p">
    <verse number="12" style="v" />Amavang lenggam chate polam muthim lah-a kipaidoh ding ahiuve; hikoma chu kale hagel umding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Jesu'n sepai jalamkai jah-a, Nangma chetan, natahsan bangin nachunga lhunghen, ati. Chuphattah chun achapang chu adamtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin Jesu Peter in'a alutna ahile, anupanu khosih veija na analup amun;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman amanu khut agah thamin ahile, akhosih chu adalhatai. Chuin ahung thouvin, amaho jenlen apangtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin nilhah-in mihon thilha vop mi tamtah ahenga ahinpuijun; aman thilhaho chu anodoh-in, chule ana jouse adamsah tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Isaiah themgaovin, Amatah-in ihatmonau alan, inat jouseu apomangtai, tia asei chu guilhuna dinga chuti ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin Jesu'n akimvela mipi tamtah chu amun, gal lang khat lama che din thu apetai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche pet chun danthu sunho khat ahenga ahungin, Houhil, nachena chan-ah juijinge, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu'n amapa jah-a, Sial hon ko aneijun, chunga leng vachaten jong buh aneijun, Mihem Chapa vangin alu ngapna ding mun aneipoi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aseijui dangho lah-a khatnin ajah-a, Pakai, amasa kache-a kapa kagavuina din thu neipen, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu'n ama jah-a, Nangman kanung hinjuitan: mithihon amithiu kivui naovinte, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin ama kong'a atouvin ahile, aseijuite chun anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichun, veuvin, dillen'a chun khopihui hanunin anungin, twi kinongin kong chu ahin khu jengtan ahi; ahivangin ama a-imun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aseijuiho ahenga ahungun, asukhangun, Pakai, neihuhhing un: athigam ding kahitaove, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman ajah uva, Vo tahsan lhomho, ibola kicha-a nahiuvem? ati. Chutah-in ama athouvin, huipi le dillen chu aphoh-in ahile, athip heltai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin miho chun adatmo lheh jengun, Ama hi iti mi hingana, huipi le dillen sanin athu angaije, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ama agalkaija Gargesenes gam alhunin, thilhavop mi ni lhankhuh-a konin amatoh kitoh dingin ahung lhonin; amani chu khohtah ahi lhonin hilam chu koimachan ahothei louhel ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichun, veuvin, amani chu a-ao jah lhonin, nangma Pathen Chapa, Jesu, Nangle keiho ipi ikimatnao umam? Ni kitep lhin masanga eibolgim dinga hunga nahim? ati lhone.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hipet chun aumnao gallampeh-a chun vohcha hon khat alhan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hichun thilhaho chun Jesu henga, Keiho neikaidoh ule, khuche vohcha hon lah-a khun neisol uvin, tin angeh taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin aman ajah uva, Cheovin, ati. Chuin apotdoh-un, vohchaho sunga chun alut taovin ahi; chuin, veuvin, ahonchangpin halhaijin alhaijun, kolah alhai lhauvin, dillenah alha lutnun, twijah athigam taovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin achingho chu khopi sung lama ajamlutnun, thu umchan jouse le thilhavop miteni thu chu agaseijun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin, veuvin, khosunga mi jouse Jesu toh kimuto dingin ahungdoh-un; chuin ama amu phatnun, agam sunguva kona chedoh dingin angeh taovin ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin kong'a atouvin, agalkaijin, akhopi ah alut tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin, veuvin, mihon alupna khun pumin langthi khat ahenga ahinpu uvin; Jesu'n atahsanjeu chu amun, langthipa jah-a chun, Chapa, lungmong tah-in umin, nachonset kingaidam ahitai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun, veuvin, danthu sunho kimkhatnin alungthimun, Hipa hin Pathen ataitome, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun Jesu'n alung gelu chu ahen, Nanghon nalunguva ibola lungilou navopmu ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nachonset naho kingaidama ahitai, tileh thouvin lamjotnin, ti, hoijoh seibaijo-am?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahoi hita jongle Mihem Chapan leiset chunga mihemte chonset ngaidam theina thahat aneije ti nahetna dingu ahi atin, hichun alangthipa jah-a, Thouvin, nalupna kilah-inlang na-in'a chetan, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amapa athouvin, a-in lama achetai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin mipin hichu amu phatnun, kidang asauvin, hitobang thuneina mihemte pe-a Pathen chu avahchoi taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jesu chua konin achen ahile, mi khat amin Matthew kiti, akaidonna mun'a atou amun, ajah-a, Kanung hinjuijin, ati. Chuin ama akipatdoh-in, anung ajuitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, Jesu chuche in'a an nedingin atouvin ahile, veuvin, kaidongho le michonseho tamtah ahungun, Jesu le aseijuiteho chutoh ankong aum khomun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pharisai hon chuche amu phatnun, aseijuite henga, Nahilpauvin ibola kaidongho le michonsehotoh an aneh khomham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin Jesu'n chuche ajan, Atidamten louthem angaipouve; adamlouten bou angaijui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman kithoina kangehpoi, kikhoto nabou kangeh-e, ti hi ipi kiseina ahi gakihilun; ijeh-inem itile keima michonpha te kou-a hung kahipoi, alungheina diuva michonse te kou-a hungjoh kahibouve, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chupettah chun John seijuite ahenga ahungun, ajah-a, Keiho le Pharisai honla an kangol matchet jiuvin, ibola nangma seijuiten an angolji louvu ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jesu'n amaho jah-a, Moulang chun aloite aumpilai sungse-a aloite chu kingaise thei ngaijuvem? Amavang moulang chu akomuva kona kipuimang ni hung lhung ding ahin, chuteng chule amahon an angol dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koiman ponthah halin pon lui abeh ngaipoi, ijeh inem itile abehna chun apon chu loisentin, secheh joding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule mihemin lengpitwi thah savun peng luija akhum ngaipoi; achuti loule apeng chu tumkeh intin, atwi longjal ding, apeng jong mahthah ding ahi: amavang lengpitwi thah chu peng thah-a akhum jiuvin, chule anin akihuh bitjin ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hicheng thu chu asei pettah-in, veuvin, vaipo khat ahungin, ama chibai ahung boh-in, Kachanu tutah chun athin ahi; ahivangin nangma hungin lang achunga nakhut hung ngamle chun amanu hing jeng ding ahi, ahungtin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Jesu akipatdoh-in, anung ajuijin, chutichun aseijuiten jong ajuijun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin veuvin, kum somle kum ni athi longa na-a numei khat anung lama ahungin, apon mongkai chu ahung thamtan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ijeh inem itile amanun alungthima, Apon jengcha hi thamkha jongleng kadam ding ahi, ati ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Jesu akiheijin, amanu chu amun, Chanu, lungmong tah-in umin; natahsanin nadamsah ahitai, ati. Chua pat chun amanu adamheltai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin Jesu vaipopa in ahung lut phatnin, sumkuli mut teho leh mipi poh vengvung chu amun,
  </para>
  <para style="p">
    <verse number="24" style="v" />Amaho jah-a chun, Potdoh-un; ijeh-inem itile chapangnu chu athi ahipoi, a-ihmu ahibouve, ati. Chuin amahon anuisat taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin miho chu akisoldoh phatnin, in sunga alutnin, chapangnu khut atuh-in ahile amanu athoutai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichun hiche gamsesea chun hiche thu chu akithang sohtai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Jesu chua konin achedoh-in ahile, mitcho ni anung nunga ache lhonin, Vo David chapa, neilungset in, tin asam lhonin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ama in sung alut phatnin, hiche mitcho teni chu ahenga ahung lhonin; Jesu'n ajah lhonah, Kei hin hichu bolthei jinte ti natahsan lhonem? tin adongin ahi. Amanin, Henge, Pakai, ati lhonin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutah-in aman amit lhonchu akhoijin, Nathsan bang lhonin nachung lhonah chutahen, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichun amit lhon ahahtai. Chuin Jesu'n amani chu hakhamin akhamin, Chingthei lhonin, koima hetsah lhon hih-in, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahivangin amani apot lhonin, chuche gamsese-a chun ama min chu aphongjal lhontai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin acheuvin ahile, veuvin, lampia thilhavop mi paomo khat ahengah ahinpuijun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thilha chu akideldoh phatnin, paomopa chu apaotai. Hichun mipi chun kidang asauvin, Israel lah-a hitobang akimukha hih-e, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pharisaiho vangin, Thilha ho lengpa mina thilhaho adeldoh hichu, atiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chujouvin Jesu khotinle vengtina avahle avahlen, akikhopnao intin-ah thu ahillen, lenggam Kipana Thupha ahil lhanglen, hivei namkimle nat namkim adamsahtan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahin miho chu achingbei kelngoi banga, lhasamle chehchao tah-a aumu amu phatnin, alung selheh-in ahi
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuphatnin aseijuite jah-a, Chang-at ding tam lheh-in, ahivangin natonga alhome.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hijeh chun achang at dinga natongho ahinsol nadingin, louneipu henga taovun, ati.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman aseijui somleni chu akoma akouvin, lhagao boh nomang dingle, hivei namkim le nat namkim damsah dingin, amaho chu thuneina apen ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche solchah somleni ho chu aminu hicheng hi ahi: Amasan Peter kiti Simon le anaopa Andrew, Zebedai chapa Jacob le anaopa John,
  </para>
  <para style="p">
    <verse number="3" style="v" />Philip le Bartholomew, Thomas le kaidong Matthew, Alphaeus chapa Jacob le Lebbaeus aminchom Thaddaeus;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Canaan mi Simon le ama matsah-a pang Judas Iscariot ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hicheng somleni chu asolin, thu apen, ajah uve, Chidang namdang koima lampi jot hih-un, chule Samaria ho khopi sung khatcha-a jong lut hih-un;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amavang chu sangin Israel insung mi amangsa kelngoi henga cheovin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nache pumun, Vangam anaitai, tin hillhang leuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anaho damsah-unlang, athi thouvun, aphahho suthengun, chule thilha nodoh-un; manbeija nasanu ahin, manbeijin homun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon nadangka dip sunguva sana, dangka, sumsan kiken hih-un;
  </para>
  <para style="p">
    <verse number="10" style="v" />chule najinnaova dingin sakhao ahiloule sangkhol thoni, kengchot, tengol kiken hih-un; ijeh-inem itile natongan aneh ding amua lom ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nacheuva khopi sung hile khoneo sung hile nalut tengule, lhunna-a kilom koi umam phatechan ngaitouvin; chule chua kona napotdoh kahseuvin hikoma chun umun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule in khatna nalut tengule, hiche in chu phatthei boh-un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche in chu phatthei changhoi ahile, nalungmonnau chu achungah umhen; achanghoi ahi louvangle hiche lungmonna chu naheng uva hung kile kittahen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule koi hile nalhunsah louvule nathu seiju ngai lou chu, chuche in'a konle chuche kho-a kona napotdoh tengule, nakengphang uva leivui sanin thinglhau vin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman nangho jah-a tahbeh-a kasei ahi, Thupi kitan nile chuche kho umchan sanga chu Sodom le Gomorrah gam umchan thohbai joding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Veuvin, keiman nangho ngeihon lah-a kelngoi banga kasol nahiuve; hijeh chun nangho gul bangin lungthim themun, vakhu bangin suhset neilou hiuvin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin mihem lamah kichih theijun; ijeh-inem itile amahon nangho thutan vaihom kikhopna-a pedoh-un natin, chule akikhopnao in'a navoh dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amahole chidang namdangte hetsahna dinga, gamvaipote le leng teho anga keima jala hung kikai ding nahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin min napehdoh tengule, ipi iti nasei dingu lungkham hih-un; sei ding chan chu apettah-le nakipe dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh-inem itile thuseija chu nangho hilouvin, na-Pau Lhagaovin nalung sunguva asei ahibouve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule asopin asopi, pan acha tha dinga ahinpehdoh ding; anu le apa douna-a chate dingdoh diu, chule athi nadiu ahin boldoh dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule keima min jala nangho mi jouse hotna nahung umdingu ahi; ahin akhon ni geija thohlhum keija pangdetpa bou chu huhhing-a umding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche khopi-a min nabolset tengule, khopi dangah jam lutnun; ijeh-inem itile tahbeh-a kaseipeh nahiuve, Mihem Chapa ahung masanga, Israelte khopi jouse nachotsoh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahilpa sangin aseijui achungnung jopoi, a-pakai sangin jong asoh achungnung jopoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aseijui chu ahilpa toh, chule soh a-pakaipa toh akikotle aphaset ahi. Amahon a-inneipu pen bon Belzabul atiule, a-insung mite chu iti atida dingu ham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun nanghon amaho chu kicha hih-un; ijeh-inem itile akiphongdoh lou ding akisela imacha aumpoi, chule hetdoh lou ding imacha aki-ima aumpoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Keiman nangho jah-a muthima kasei chu, nanghon khovah-a seijun; nanauva najah-u chu, in chunga saptho uvin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule natahsao thatna, lhagao that theilou ho chu kicha hih-un; lhagaole tahsa akopma damuna sumang theipa bou chu kichaovin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Vasilih ni paisa khat manna kilhaji louham? Achuti vangin na-Pau thu louvin hitiho chu khatcha jong tolla lha lou ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nalu chunguva nasam jang jouseu jong kisim sohkeija ahi;
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh chun kicha hih-un; vasilih tamtah sanga nangho lujo nahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun koi hile miho anga kei eiphongdoh chan chu, keiman jong van'a ka Pa anga kaphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amavang koi hile miho anga keima eiseileppa vang chu, keiman jong van'a ka Pa anga kaseilep ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Leichunga chamna hinpo dinga hungin neingaito hih-un; chamna hilouvin chemjam hinpo joh-a hung kahibouve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ijeh-inem itile achapa chu apa dousah ding, achanu chu anu dousah ding, amounu chu atehpi dousah dingjoh-a hung kahibouve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule mihem amelma chu ama insung mitetah hi ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Koi hile keima sanga anu le apa ngailujo-a chu keija hoi ahipoi; chule koi hile keima sanga achanu le achapa ngailujo-a chu keija hoi ahipoi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule koi hijongle athingpel kiputna kanung hinjui lou jong chu, keija hoi ahipoi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Koi hile ahinna mu-a chun achan ding; chule keima jala ahinna channa chun amu ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Koi hile nangho lhunsah-a chun keima eilhunsah ahin; chule koi hile keima eilhunsah-a chun eisolpa alhunsah ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Themgao mina themgao lhunsah-a chun themgao kipaman asan ding; chule michonpha tia michonpha lhunsah-a chun, michonpha kipaman asan ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Koi hile hiche neochaho lah-a hi seijui ahi tia twi dap khon khat jengcha don dinga pechan chun, tahbeh-a kaseipeh nahiuve, iti nama jongle kipaman asan ding achan louding ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun Jesu'n aseijui somleni ho chu thu apeh jouvin, chukom mun'a kon chun akhotin uva thu hille dingle seiphongle dingin achetan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin John'in songkulah Christa thilbol umchan thu ajan ahileh, aseijui mini asolin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ajah-a, Ahung dinga chu nangma nahimong hinam, ole achom dang khat kanga dinguham? agatisah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jesu'n adonbutnin, ajah lhona, Nangni chelhonin lang nathujah chengse lhon le nathilmu chengse lhon hi John jah-a gasei lhontan:
  </para>
  <para style="p">
    <verse number="5" style="v" />Mitchon kho amutai, elbaijin lam ajottai, miphah suhthengin aumin, chule na-ngongin kho ajatan, mi thisa kaithouvin aumtai, chule mivaichate Kipana Thupha akiseipeh tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule koi hijongle keija kipal lhuhna nei lou chu anunnom ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amani chu ache nungin aman mipi jah-a chun, John thudol asei panin, Ipi ve dinga gamthipma chu nachedoh-uham? Huijin peng amut lingham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Achutile ipi ve dingaba chedoh nahiuvem? Ponnem kisil mi ham? Veuvin, ponnem sil hokhu leng in'a um ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ibola nachedoh uham? Themgao ve dinga ong? Ahi, kaseipeh nahiuve, themgao sanga chungnungjo ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ven, keiman kasottol namasang sanga kasole; Aman namasang sanga nalampi asem ding ahi, tia kisun chu ama hi ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Najah uva tahbeh-a kasei ahi, Numei sunga peng lah-a John Baptist sanga lenjo koima asohdoh khapoi, ahivangin van lenggama aneojo chu ama sanga lenjo ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule John Baptist nikho-a pat tugeija hi van lenggam hin gimbolna athoh ahin, chule mi gimbol hochun pumhatnin alauvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ijeh-inem itile themgaoho jouse le danthun John phat geija chu gaothu aseiju ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nanghon hiche hi sanding nanop uva ahile, amachu ahung dinga kisei Elijah chu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angaina ding na neijan ngaihen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tu khanga mite hi koitoh katekah tadem? Chapangho kaithel tolla touva, aloiho kou-a,
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajah uva, kuli kamutpeh-ule nalam hih-un; kakaule na-op nabeng pouve, tia seiho tobang nahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijeh-inem itile John ahungin ne lou don lou ahin, hichun mihon thilhavop ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihem Chapa ahungin anen adonin ahile, Veuvin, nehhat le julop, kaidongho le mi chonseho jolle gol ahi, atiuve. Ahinla chihna chu anatoh hon them achanan ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuphatnin thilbol kidang ahabol dehna khoho chun alung ahei lou jeh-u chun, aphohsal pantan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ohe Chorazin, nada ahi! Ohe Bethsaida, nada ahi! Ijeh-inem itile nalah uva thilbol thahatna kidang kibol chengse chu, Tyre le Sidon khopi-a kibol hile, sotpia pat chun achenghon khaodip pon kisilpum le vut kinu pumin alungu heitao vinte.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla keiman kasei peh nahiuve, Thupi tan nikho le nangho thoh ding sanga Tyre le Sidon thoh ding oljo ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule vangeija choisanga uma nang Capernaum, damuna notlhah-a umding nahi; ijeh-inem itile nalah uva thil kidang kibol chengse hi Sodom kho-a kibol hileh, tugei hin umnalai jinte.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujongle tahbeh-a kaseipeh nahiuve, Thupi tan nile nangho thoh ding sanga Sodam thoh ding oljo ding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiche pet chun Jesu apaovin, Vo ka Pa vanle lei Pakai, nangman michingte le lungthim themho hengah hicheng thuhi na-ima, naocha ho henga naphondoh jeh hin nangma kathangvah-e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahi, Pa, hiti chu nangma lunglhaina lam ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Imajouse ka-Pan keima eipehdohsoh ahitai; chule Pa tailou Chapa chu koimachan ahepoi; chule Chapa tailoule aman aphondoh nomnapa tailou koimachan Pa chu ahepoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tong gimte le pohgih te, kahenga hungun; keiman nangho cholngah sah-unge.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keima lungneng tah le nunnem tah kahi; hijeh chun kanamkoljon laovin lang keima-a kihilun; chutile nalunguva olna namu dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ijeh-inem itile kanamkoljon nomtah ahin, kapoh jong jangtah ahi, ati.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichelai chun cholngah nin Jesu'n changlei lai ajotnin; aseijuite agil keltaovin ahile, changvui asih-un, anepan taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin Pharisai hon hichu amuvin, ama jah-a, Vetan, naseijui ten cholngah ni-a bol ngai lou abolui, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman ajah uva, David'in aloitetoh agilkel uva abol chu nasim khah lou uham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen houin'a alutna, thempu tailou aman jong, aloiten jong neh ngai lou, vetsahna changlhah to aneh jengu chu!
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahiloule houin'a um thempuhon cholngah ni nit louva aum jongun themmo achang pouvin ahi, tia danthubua kisei chu nasimdoh khah lou uham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin nangho kaseipeh nahiuve, Hikoma hin houin sanga chungnungjo khat aume.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule, Keiman gana lhai kangehpoi, lungsetnabou kangeh-e, tia kisei hi ipi kiseina ahi anaheleu chun, themona nei louho chu nanathemmo sahlou dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh-inem itile Mihem Chapa chu cholngah ni Pakai jong ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin chua konin achedoh-in akikhopnao in'ah alut-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin, veuvin, hia chun mi akhutngoi khat aumin ahi. Chuin ahehset theina dingun, Cholngah ni-a hi boldam dan ngai hina hilouham, tin Jesu adongun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Aman ajah uva, Nalah uva khattouvin kelngoi khat neihenlang, hichu cholngah nin kokhuh-a lhaluttaleh, gamana galoidoh lou ding koi naum uvem?
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuti chu ahile kelngoi sanga mihem iti manlutjoh hitam! Hiche jeh chun cholngah ni-a thilpha bol angai ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphatnin mipa jah-a chun, Nakhut lhangin, ati. Mipa chun akhut alhangin ahile, alang khat bangin adamheltai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin Pharisai ho apotdoh-un ama suhmangna thei ngaiton akihoukhom taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin Jesu'n hichu ahet phatnin, chukoma kon chun achemang tai. Chuin mi tamtah-in anung ajuijun, Aman abonchauvin aboldam sohkeijin;
  </para>
  <para style="p">
    <verse number="16" style="v" />chule, ama aphondoh louna dinguvin amaho chu akhamin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Isaiah themgaovin asei:
  </para>
  <para style="p">
    <verse number="18" style="v" />Veuvin, kalhentum kasottol, kadeitah achunga kalung lhainapa khu, Keiman achunga kalhagao kakoi ding, chule ama chidang namdangte henga dandih-a thutan na aphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman mi anel lou ding, aw sanga thu asei lou ding, Khosung lamlena koi man a-aw ajah louhel ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajosoh keija dandih-a thutan achaisoh masangse-a, pumpeng kihehchip kihehbong pai lou ding, chule thaomei pat khao jong athamit lou ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Ama min chu chidang namdang ten Kinepna-a anei dingu ahi, ati chu guilhuna dinga chuti ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichepet chun thilhan avop jeh-a paomo le mitcho khat ahenga ahinpuijun; Aman aboldamin ahile, paomopa chu apao theijin, kho jong amutai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin mipi chengse chun kidang asa lheh-un, Ama hi David Chapa hilouham, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahin Pharisai ho vang chun hichu aja-un, thilhaho lengpa Beelzabul toh kitho louvin hichepan thilha anodohpoi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Jesu'n alunggelu chu ahen, ajah uva, Gamsung khat amale ama kidoutoa kichom khenchan chu amangthah jin, chule khopi khat hijongle insung khat hijongle kidoutoa kichom khenchan jong chu dingdoh lou ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Satan'in Satan anodoh-a ahile, amale ama kidouva kichom khen ahin; achutile agam iti dingdoh dingham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Chujongle keiman Beelzabul vanga thilhaho kanodoh ahile, nachateovin koi vanga anodohjiu hintem? Hijeh-a chu amaho cheng chu nangho thutana pang ding ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin Keima Pathen Lhagao vanga thilhaho nodohji-a kahivangle, Pathen lenggam chu nahengu hung lhunga ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuti ahi loule kon mihat chu kan masa louva a-in'a lutna, iti achom thei ngaijem? Akan masah-a chutengle achom jibou ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Koi hile keima lama panglou chu eidouva ahi; chule eikhop khompi lou chu athecheh ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh chun kaseipeh nahiuve, mihemte achonsetnao le Pathen ataitom nao jouse kingaidam ding ahi; Lhagao Theng taitoma vang chu kingaidam lou ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule koi hijongle Mihem Chapa douna-a thuseija chu kingaidam ding ahi; Lhagao Theng douna-a thuseija vang chu, tu hinlaijin jong, khonunga hinkho hung lhung dinga jong kingaidam louding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thingphung chu aphai nati ule, aga jong aphai tingalun, thingphung aphapoi nati ule, aga jong aphapoi tiuvin; ijeh-inem itile thingphung chu agan akihei.
  </para>
  <para style="p">
    <verse number="34" style="v" />Vo gulse sonho, nanghon nagitlou pumpiuva thupha iti nasei thei dinguham? Ijeh-inem itile lung sunga aletna kona kamin aseidohji ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Miphan thilpha bom lungthima konin thilpha asodoh-in, chule misen thilse boma konin thilse asodohjin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahin kaseipeh nahiuve, Mihemin manlou ding thu asei chengse hi, thupi kitan nile asuhto cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangma nathun them nachansah ding ahin, chule nathu maman themmo nachansah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuphatnin danthu sunho le Pharisai ho phabep khatnin adonbutnun, Houhil, nanga konin melchihna kamu nomuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahin Aman adonbutnin, ajah uva, Migilou le mijong khanga miten melchihna aholui, ahinla Jonah themgao melchihna tailou adang kipe lou ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ijeh-inem itile, Jonah ni thum le jan thum ngapi oisunga aum banga, mihem chapa jonghi ni thum le jan thum leigila umding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nineveh khopi-a miho chu thupi tanna-a tulai khang mite toh hung ding khoma, tulai khang hi themmo ahinchan dingu ahi; ijeh-inem itile amahon Jonah thuhil chun alung aheijun ahi; ahin, veuvin, Jonah sanga chungnungjo hikoma aume.
  </para>
  <para style="p">
    <verse number="42" style="v" />Lhanglam gam lengnu chu thupi tanna-a tulai khang mite toh hung ding khoma, tulai khang hi themmo ahinchan ding ahi; ijeh-inem itile aman kolmanga konin Solomon chihna thu ngai dingin ahungin ahi; ahin, veuvin, Solomon sanga chungnungjo hikoma aume.
  </para>
  <para style="p">
    <verse number="43" style="v" />Lhagao boh chu mi sunga kona apotdoh tengle, twi beina muntin-ah avahle avahlen, cholngahna aholin, mula amujipoi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chutengle aman, Kahung potdohna ka-in mama-a chun chekit tange, atin; chuin ahunga ahile, hichu agohkeo, akitheh ngim, chule akijephoi chu amun;
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin achen, ama sanga giloujo lhagao dang sagi agapuijin, chule amaho chua chun alutnun, acheng taove; chuin mipa umchan chu amasa sangin anununga akhohjo chehtan ahi. Tulai khang migiloute chunga jong hi chutobang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Aman mipi lah-a thu aseina laijin, veuvin, anule asopiten ama hou nom-in aholun, inpo-ah adingun ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin mikhatnin ajah-a, Ven, nanu le nasopite nangma hou nom-in naholun, inpo-ah ading jinguve, ati.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ahin Aman chutia seipa chu adonbutnin, Kanu koiham? chule koiham kasopi? ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin aseijuite lama akhut ajah-in, Veuvin, hiteho hi kanule kasopite ahiuve!
  </para>
  <para style="p">
    <verse number="50" style="v" />Ijeh-inem itile van'a um ka Pa lung lama chonna chu, amatah chu kasopipa le kasopinu, chule kanu ahi, ati.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche nikho mama chun Jesu in'a konin apotdoh-in, dil pangah atouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahengah mipi tamtah ahung khomun, hijeh chun ama kong khatnah alutnin atoutai; chule mipi chengse chu vaokamah adingun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amaho chu thulemin thu tamtah ahilin, Ngaijun, muchi thepa khat muchi the dingin achen,
  </para>
  <para style="p">
    <verse number="4" style="v" />Athe atheleh muchi chu abang lamsih-a achun ahile, vachaten ahung lohgam taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abang songlheo chung leipatna-ah achun, alei asa lou jeh-in akehdohpai jengin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin nisa ahung soh-in ahile, asanggon; jung anei lou jeh-in agoptan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abang ling lah-a achun, aling chu ahung khangin adepmang tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Adangho vang lei pha laijah achun, abang ajat jakhat, abang ajat somgup, abang ajat somthumin agan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angaina ding na neijan ngaihen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aseijuite ahenga ahungun ajah-a, Ibola amaho jah-a chu thulema naseiham, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu'n adonbutnin, Nangho vang van lenggam thuguh chu nahet dinguva kipe-a nahitaove; ahin amaho hi kipe lou ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijeh-inem itile koi hijongle aneija chu kipehbentin anei letset ding ahi, aneilouva chu aneichasun jong chu ama-a kona kilahpeh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche jeh-a hi ajah uva thulema kasei ahi; ijeh-inem itile amahon amu vangun amu hih-un, ana-a ajah vangun aja hih-un, angainaje jong ahepouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Isaiah themgaovin khonunga thusoh ding asei: Nanghon ja vang janaovin natin, angainaje nahet lou dingu, mu vang munao vin natin, nahetdoh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ijeh-inem itile hiche nam mite hin Amitnuva amuva, anauva ajah uva, alunga jong ahetdoh uva, chule ahung kihei kit uva, keiman amaho chu kadamsah louna dinga, alungu thaovin atoma, chule akolseh uva, chule amit asinu ahi, tia asei chu achunguva guilhunga ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho mitnin vang amu jeh-in mit nunnom ahin, nanau vin jong ajah jeh-in nakol nunnom ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ijeh-inem itile tahbeh-a kaseipeh nahiuve, Themgao tamtah le michonpha tamtah-in nangho thilmu hi mu atup lhehji uvin, ahivangin amupouvin ahi; chule nathu jah chengseu hi jah atupmun, ahinla ajapouvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche jeh chun muchi thepa thulem chu ngaijun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Koi hile gamsung thu ajah tenga angainaje helou chu, hiche pettah chun agilou chu ahungin, alung sunga kithesa chengse chu alah mangpeh jitan ahi. Hichepa chu akithe lamsih-a chua chu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Akithea songlheo chunga leipatna-a chua chu, thu ajah jah-a thanom tah-a joppai jenga chu ahi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin alung sunga ajung anei lou jeh-in, ni chomkhat aumjibouve; ijeh inem itile thu jeh-a genthei hesohna le bolsetna aum phat phatle, alhupai jitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule akithea linglah-a chua chu ahile, thu chu ajan, hinla leiset hinkho lungkhamna le lheplhahna dimset haona lungthim chun thu chu adeplihjin, ga louvin aumjitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule a kithe-a leipha laija chua vang chu, thu ja-a, angainaje he-a chu ahi; ama chu aga tahbeh-in, chule abang ajat jakhat, abang ajat somgup, abang ajat somthumin aga pungjin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman amaho jah uva chun thulem chomkhat asei kitnin, van lenggam chu mi khat aloulaija muchipha the-a toh kitekah ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahin miho imut petnin, amelma chu ahungin, achang lah-a chun changlhem athepeh-in, achemang tan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin chang kung chu ahung khangtouvin, avui adoh-in ahile, chuphatnin changlhem jong chu akilahdoh-in ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aneipa sohte ahenga ahungun ajah-a, Hepu, nalouva khu muchi pha nathe louham? Ahile hoilam kona changlhem kehham, atiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman ajah uva, Melma khattou bol hija chu, ati. Chuin asohten ajah-a, Achutile cheovinlang changlhem chengse gachom khom leuveng nalungham? atiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahin aman adonbutnin, Angaipoi, chutile changlhem nabodoh khomna lamuvin, changtah jong bodohtha getnun nate.
  </para>
  <para style="p">
    <verse number="30" style="v" />A-at phat kahsen khantha nante, chang at tengle keiman chang at dingho jah-a, Changlhem chu govam dingin khomun lang kankhomun, changtah vang chu kachang pangah koilut taovin, tinange, ati, tin aseije.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thulem dang khat ajah uva asei kitnin, van lenggam chu mikhatnin alah-a, chule alouva athe, ankam mu tobang ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichu muchi dang dang sangin aneopenin, ahivangin akedoh-a akhandoh phatnin, hampa dang sangin aphung lenjon, thing asohtan, chutichun chunga leng vachaho abah lah-a ahung gehjitai, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amaho jah-a thulem khatma asei kitnin, van lenggam chu numei khatnin alah-a, chule changbong dan thum lah-a avuija, aboncha apomsoh kahse-a abil, chol tobang ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu'n mipi jah-a hichengse chu abonchan thulemin aseijin; chule thulem louvin ajah uva imacha aseipon ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Themgao thu seisa, Keiman thulem seinan kakam kangting leiset kisemtila patna thuguh chengse kaphondoh ding ahi, ati chu guilhuna dinga chuti ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chujouvin Jesu'n mipi chu asolmangin, chuin insunga alut tan ahi. Chuin aseijuite ahenga ahungun, loulaija changlhem ke thulem chu neiseidoh peh-un ahungtiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Aman adonbutnin, Muchi pha the-a chu Mihem Chapa ahi;
  </para>
  <para style="p">
    <verse number="38" style="v" />Lou chu vannoi leiset ahi; muchi pha chu lenggam chate ahiuvin; changlhem chu migiloupa chate ahiuve;
  </para>
  <para style="p">
    <verse number="39" style="v" />Melma athea chu diabol ahi; changkhop phat chu vannoi leiset kichai ni ahin, chang atteho chu vantilte ahiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hijeh-a chu changlhem chengse achop khomuva meija ago banguva chu, vannoi leiset kichai ni jongle chuti ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mihem Chapan avantilte solintin, chule amahon gamsunga konin midoudal te chengse le akhang giloute jouse chomkhom untin,
  </para>
  <para style="p">
    <verse number="42" style="v" />Lhum sunga aselut dingu ahi; hikoma chu kale hagel umding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chutengle michonpha te chengse a-Pau lenggama nisa banga vah ding ahiuve. Angaina ding na nei neijan ngaihen.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chujongle van lenggam chu loulaija kiselgu thillu tobang ahi: hichu mi khattouvin amudoh-in, aselgun; chule kipahtah-in achen anei jouse ajoh-in, hiche louchu achon ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule van lenggam chu sumkolvei mi twikokchang phatah hola toh abange.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ama chun twikokchang man tamtah khat amun, chuin achen anei jouse ajoh-in hichu achon ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule van lenggam chu len khat twikhanglen'a kisep ngatin ngatang huikhoma tobang ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hiche len chu adim phatnin, mihon vaokamah akaidoh-un; hikoma chun atouvun, apha chacha alheng khomun bomah akhumun, aphalou chengse apaitauve.
  </para>
  <para style="p">
    <verse number="49" style="v" />Hiche banga chu vannoi leiset kichai ni jongle chuti ding ahi: vantilte hunguntin, michonpha lah-a konin michonse lakhenuntin, amaho chu lhum sunga aselut dingu ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hikoma chu kale hagel umding ahi, ati.
  </para>
  <para style="p">
    <verse number="51" style="v" />Jesu'n ajah uva, hicheng chu angaije nahettah uvem? tin adongin ahi. Chuin amahon ajah-a, Henge, Pakai, atiuve.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin Aman ajah uva, Chuti ahi jeh chun danthusun van lenggam seijui chengse chu, athil manlu lah-a kona thil athahle alui sodoh-ah inneipu khat tobang ahiuve, ati.
  </para>
  <para style="p">
    <verse number="53" style="v" />Jesu'n thulem hicheng chu asei jouvin, chukoma kon chun akipat dohtai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin ama gam lamah ahungin, miho chu akikhopnao in'ah ahiltan ahi; chuti chun amahon kidang asa lheh jengun, Hichepa chihna le thil kidang boltheina hi hoija kon hijaham?
  </para>
  <para style="p">
    <verse number="55" style="v" />Ama hi thing thembol chapa hilouham? Anu min Mariam, chule anaote min Jacob, Joses, Simon, chule Judas hilouham?
  </para>
  <para style="p">
    <verse number="56" style="v" />Chule asopinute jong hi koma ilah uva cheng hilouham? Achutile hichengpi hi hoija akilah ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chutichun achungah alung himo taovin ahi. Hijeh chun Jesu'n ajah uva, Themgao chu ama gamsung le ama a-insung tailouvah jabol louvin aum ngaipoi, ati.
  </para>
  <para style="p">
    <verse number="58" style="v" />Atahsan lou jeh-u chun aman chukoma chun thil kidang atam boltapon ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche laitah chun Herod lengpan Jesu thu kithan chu ajan,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajenleho jah-a, Hiche hi John Baptist ahi; ama athia kona thoudoh kit ahitai; chuche jeh-a chu chuti thil kidang boltheina chu ama-a uma abol ahi, ati;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ijeh-inem itile Herod chun anaopa Philip jinu Herodia jala, hiche masanga chu John amatna, akana, songkul'a akhum ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu John'in ajah-a, Amanu chu ji-a naneiding chu dan ngai ahipoi, anati ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche chun lengpan ama chu tha dinga agot vangin, mihon John chu themgao ahi tia angaito jeh-un, miho chu akichan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin Herod aso nikho alhinin, Herodia chanu chu amasanguva ahung lamin, Herod chu alung lhaisah tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun amanu chu ipi hijongle athum chan pe dingin akihahsel leuvin ateptan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amanu chun, anun ana thuhilsa ahi jehchun, John Baptist luchang kong khatnin hilaija hin neipen, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuphatnin lengpa alungdongtan ahi; ahivangin akihahselna le a-ankong umpiho jal-in, peh ding thu apetai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin mi asolin, songkul sunga John lu agatanden sahtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aluchung chu kong khatnin ahin domun, nungahnu chu apeuvin; chuin amanun anu henga ahin choitan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuphatnin aseijuite acheuvin, along chu agapuvin avuitaove. Chuin ahungun thusoh chu Jesu henga ahung seijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu'n chuche ajah phat chun, chukoma kon chun apotnin kongin akitolin, gamthipma achoma achetai. Ahin mihon hichu ahet phatnun, khopi chengsea konin acheuvin akengin anung ajuitaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jesu vaokama ahung potdohle mipi tamtah amun, amaho chu alung asen, adamlouho chu aboldamtai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin nilhah ahi phatnin, aseijuite ahenga ahungun, ajah-a, Hiche komla gamthip ahin, nilhah jongla ahitan, miho hi akho kho-a chea aneh dingu gakichoh dingin sol mangtan, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin Jesu'n ajah uva, Che louleu akhohpoi; nanghon nehding peuvin ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amahon ajah-a, Hikoma changlhah pheng nga le nga nisehbou kaneijuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman, Hikoma kahenga hinchoijun, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin miho chu hampa chunga tou dingin asolin, changlhah pheng nga le nga ni chu alan, vanlam aven, phatthei aboh-in, chuin changlhah chu ahehbal balin, aseijuite khutna apen; aseijuiten mipi chu ahoppeh-un ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin abonchauvin aneuvin, ava sohkeijun; anehmoh-u anong chengse chu paipeh somle paipeh ni aloh dimun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anea chu numeile chapang sim louvin, mi sangnga jen ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Jesu'n mipi chengse chu alhahdoh lai sungsen, gallang khat lama anagalkai masa dingin aseijuite kong'a alutsah-in, asolpaitan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin mipi chu alhahdoh jouvin, tao dingin mola chun achomin akaltai. Chuin jan ahi phatnin, ama hikoma chun achang seh-in aumin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichepet chun kong chu dillen lailung-ah aumin, hui alelama anun jeh-in, twi kinongin kong chu alehle jengin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin khovah ding konin, Jesu ahenglam uva ahungin, twi chunga lam ahin jotnin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman chutia twi chunga lam ajot chu aseijuiten amuvin, Joumi ahi, tin atijauvin, akichauvin a-aosot taovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahin Jesu'n ahin houpi paijin, ajah uva, Lungmong tah-in umun, keima kahi, kicha hih-un, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Peter'in adonbut-in, Pakai, nang nahile twi chunga nahenga kahungna dingin thu neipen, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman, Hungin ati. Chuin Peter kong'a konin akumlhan, twi chunga lam ajotnin, Jesu henga achetai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla huinun hattah chu amu phatnin akichatan, chuin lhalut ding akigotan ahile, Pakai, neihuhhing in, tin asamtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Jesu'n akhut alhan, amanpaijin, Vo tahsan lhom, ibola natahsan lelham, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chujouvin kong'a akal phat lhonin, hui chu athip tai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin kong'a umho chu ahungun, Tahbeh-in nangma Pathen Chapa nahi, atiuvin chibai abohtauvin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin agalkaijun, Genesaret gamsung alhung taovin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin chuche gam miho chun ama chu ahetdoh phatnun, agam kimvel uva mi asolun, adamlou jouse ahengah ahinpuijun;
  </para>
  <para style="p">
    <verse number="36" style="v" />Apon mongkai beh atham dingu chun ahenga ataovun, athamkha chan chu adamhel helun ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche pettah chun Jerusalem'a konin Pharisaiho le danthu sunho phabep ahungun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu jah-a, Ibola naseijui ten upate akhang akhanga ahung chonna dan apalkeh-u ham? ijeh inem itile amahon an aneh ding tengule khut asopji pouve, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin Aman adonbutnin, ajah uva, Nanghon jong ibola nangho chonna dan jeh-a Pathen thupeh napalkeh uham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ijeh-inem itile Pathen'in, Nanu napa jabolun, chule koi hile anule apa gaosapma chu thihel hen ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla nanghon, Koi hileh anule apa jah-a, Kavanga naphat chomna dingu jouse chu Pathen kipe-a ahitai, tia seija;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule anu le apa jabol lou chu, chamlhat ding ahi, nati uve. Chutichun nangho chonna thu jal-in Pathen thupeh chu imacha hilou nasouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miphalhem ho, Isaiah'in nangho khanchan ding thu aseija:
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche mite hin akamuvin einaijun, athuseijun eijabolun, Alungula keija kona gamlatah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amahon athu hilnaova mihem thupeh jeng thua ahil jeh uvin, eihouvu jong moh ahi, ati chu adihtangeije, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jesu'n mihonpi chu ahenga akouvin, ngai phaovin lang hetoh-un:
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi kam sunga lut chun ama chu asubohpoi; mi kam sunga kona hung potbou chun asuboh-e, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutah-in aseijuite ahengah ahungun, ajah-a, Pharisai hon chuche thu ajah uva, alung phatmo-u khu nahet em? atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Aman adonbutnin, Van'a um ka Pa phu hilouva keh thingphung jouse chu kibotdoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiteho khu limsah hih-un, amaho khu mitcho lamhil ahiuve. Mitchon mitcho lamkaile ani lhona kokhuh-a lhalut lhonding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Peter'in adonbutnin, ajah-a, Hiche thulem thuhi neihilchet peh-un, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Jesu'n, Nangho jong tugeija hetna nei louva naum nahlaiju ham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Kam sunga lut chu oisunga alhalutnin, posona-ah apotpai jitai, ti heloulai nahiuvem?
  </para>
  <para style="p">
    <verse number="18" style="v" />Kam sunga kona hung pot vang chu lung sunga kona hung pot ahin; hichun mi asuhboh ji ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ijeh-inem itile lung sunga konin lunggilou, tolthana, miji toh jon, jonthanhoi, guchat, thujousei, taitomna, hicheng chu apotjin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichengho chu ahi mi suboh ji-a; khut sop louva an neh vangin mi asubohpoi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jesu chukoma konin apotdoh-in, Tyre le Sidon gamkol lamah achetai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin, veuvin, chuche gamkaija cheng Canaan numei khat ahengah ahungin, Pakai, David chapa, neilungset in; kachanu thilha phalou tah-in amane, tin ahin samin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin aman kam khatchan jong adonbutpoi. Chuin aseijuite ahengah ahungun, ajah-a, Amanu hi solmangtan, ijeh inem itile kanungsang chenguvah asam asamin ahi, tin ahung seijun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman adonbutnin, Israel phunga amangsa kelngoi heng tailou adanga dinga kisol kahipoi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahin numeinu chu ahungin, Pakai, neihutan, tin chibai aboh-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Aman adonbutnin, Chate changlhah lahpeh-a uichate koma selhah chu adihpoi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin amanun, Ahinai, Pakai; ahivangin uichaten jong apu dokhang chunga kona anmal lhajah chu anekhaji, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutah-in Jesu'n adonbutnin, Numei natahsan alene; nalunggot bang chu hitahen, ati. Chuin chuche pettah-a pat chun achanu chu adamtai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chujouvin Jesu chukoma kon chun achen, Galilee dillen kom ahung lhungin, mol chungah akaltouvin, hikoma chun atoutai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichun mipi tamtah ahenga ahungun, amaho chun elbai, mitcho, paomo, lhemvei le adang tamtah ahinpuijun, Jesu kengphang bulah alehlhauvin; chuin aman amaho chu aboldam sohtai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutichun mipi chun paomon thu aseija, lhemvei adamhela, elbaijin lam ajot, mitchon kho amu chu amuvin, kidang asauvin, Israel Pathen avahchoi taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Jesu'n aseijuite chu ahenga akouvin, ajah uva, Hiche mihonpi hi kalung asei; ijeh-inem itile keima toh aumkhom naohi ni thum ahitan, chule neh ding imacha aneipouve. Chule amaho an nelouvin kalhadoh nompoi; achuti loule lampia lhasampa getnunte, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin aseijuiten adonbutnun, Mi hijatpi nehva khop ding hikom gamthip laija changlhah hoija kila dingham? atiuve,
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jesu'n ajah uva, Changlhah pheng ijat naneijum? ati. Amahon, Pheng sagile nga neo themkhat aume, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Aman mipi chu tolla toudin asoltai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin changlhah sagile nga chu alan, thangvahna aneijin, chuin ahehbal balin, aseijuite apen, aseijuiten mipi chu ahoppeh-un ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin abonchauvin aneuvin, ava sohkeijun, anehmoh-u ahal chu longkai sagi aloh dimun ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Anea chu numeile chapang tailouva mi sangli ahiuve.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin aman miho chu alhahdohsoh jouvin, kong sunga alutnin Magadala gamkai lama ahungtai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pharisaiho le Saddukai ho ahenga ahungun, apatepnan van'a kona melchihna khat avetsahna dinguvin athumun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman adonbutnin, Nanghon nilhahle, Van san asoh-e; kho phading ahi, nati uvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule jingkahle, van san asoh-in van anime; kho phalou ding ahi, nati uve. Vo nangho miphalhem ho, nanghon van umchan suhtoje vang naheuvin, phat umchan melchihna nasuto theipouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Migilou le mijong khanga miten melchihna aholuve, ahinla Jonah themgao melchihna tailou adang kipelou ding ahi, ati. Chuin amaho chu adalhan achemang tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aseijuite gal lang khat agalkaijun, changlhah ahin pohai taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichun Jesu'n ajah uva, Pharisaiho le Saddukai ho chol lah-a chingtheijun lang kihongphauvin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho chun, Changlhah ikenlou jeh-u ahi, tin akihou lhiuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu'n hichu ahedoh-in, ajah uva, vo tahsan lhomho, changlhah nahinpoh loujeh uva ibola kihouhou nahiuvem?
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi sangnga changlhah pheng nga-a chu paipeh ijat nalodoh uvem ti hedoh loulai le geljong geldoh loulai nahiuvem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule mi sangli changlhah pheng sagi-a chu longkai ijat nalodoh-uvem?
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman nangho jah-a changlhah thu kasei ahilou chu ibola helou nahiuvem? Pharisaiho le Saddukai ho chol lah-a kihongphauvin, kati ahibouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutah chun changlhah chol lah-a ati hilouvin, Pharisaiho le Saddukai ho thuhil lah-a chingtheijun, ati ahi chu ahedoh taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Jesu Caesaria Philippi gamkolsung ageijin, aseijuite jah-a, Mihon Mihem Chapa hi koi ahi atiuvem? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho, Kimkhatnin, John Baptist ahi, atiuvin; kimkhatnin Elijah ahi, atiuvin; kimkhatnin Jeremiah ahi, ahiloule themgaoho lah-a khatpen ahi, atiuve; tin aseijun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman amaho jah-a, Nanghonla koi ahi neitiuvem? ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Simon Peter'in adonbutnin, Nangma Pathen hing Chapa Christa chu nahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jesu'n adonbutnin, ajah-a, Jona chapa Simon, anunnoma nahi; ijeh-inem itile tahsaphe le thisanin aphondoh hilouvin, van'a um ka-Pan aphondoh joh ahibouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule keiman jong nangma jah-a kasei ahi, Nangma Peter nahi, chule hiche songpi chunga hi kahoubung kasahdoh ding ahi; chule mithi kho kul kotpin aneh jou lou ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiman nangma van lenggam kot-heh kapeh ding nahi; chule leiset chunga nangman nakha chan chu van'a jong kikhah ding; chule leiset chunga nangman nahon chan chu van'a jong kihong ding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujouvin ama Jesu chu Christa ahi koima jah-a seidoh hih-un, tin aseijuite chu ahilchah-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche jou chun Jesu Jerusalem'a achea, upaho le thempu pipuiho chule danthu sunho-a kona thil tamtah athoh-a, chule akitha-a, chule ni thum ni-a kaithouva aum tei ding danje chu aseijuite ahil pantan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Peter'in ama chu apuidoh-in, Pakai, hichu nanga konin gamla hen, chutobang chu nachunga chulouhel ding ahi, tin aphoh pantan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin Ama akiheijin Peter jah-a, Kanung lamah chen, Satan, Nangma keima dingin kipal lhuhna nahi. Nangman Pathen thulam gel louvin mihem thulam jeng nagele, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuphatnin Jesu'n aseijuite jah-a, Koi hile kanung eijui noma chu ama kingaitom hen, chule athingpel kiput henlang kanung hinjuihen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ijeh-inem itile koi hile ahinna huhhing noma chun achan ding ahi; amavang koi hile keima jala ahinna chana chun akimu ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ijeh-inem itile min vannoi leiset apumpin neihenlang ahinna chantale, a-ipi phachom dingham? Ahiloule min ahinna lhenga ipi apeh dingham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Ijeh-inem itile Mihem Chapa a-Pa loupina-a avantil tetoh hung ding ahin; chule chutengle aman mijouse athilbol dungjui cheh-a tohman asansah ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tahbeh-a kaseipeh nahiuve, Hikoma dingho kimkhat hi Mihem Chapa aleng gama ahung amu kahseuva thina tepkha lou ding aumuve, ati.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ni gup jouvin, Jesu'n Peter toh, Jacob toh, chule anaopa John toh apuijin, achomin molsang chung khatna apuitouvin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Ama amaho ang sungah avou akikhelin; Amai nisa bangin avah-in, aponsil chengse chu khovah bangin avamleng jengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin, veuvin, Mosi le Elijah ahenguva ahung kilah lhonin, amatoh akihou lhonin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Peter'in Jesu jah-a, Pakai, hikoma i-umu hi eiho dingin anome; naphatsahle nang ding khat, Mosi ding khat, chule Elijah ding khat, lhambuh thum songuving kate, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Asei pettah chun, veuvin, meibang lhang khatnin amaho chu ahinle khutan; chuin meilhang lah-a kon chun aw khatnin, Hiche hi ka-Chapa deitah ahi, achungah kalung alhai tangeije, athu ngaijun, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aseijuiten chuche ajah phatnun, aboh khupmun amaiju tolla asulutnun, atija lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jesu ahenguva ahungin akhoijin, Thouvun, kicha hih-un, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin akhodah-un ahile, Jesu changseh tailou adang koima amuta pouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin molsanga kona akumsuh phatnun, Jesu'n amaho chu ahilchah-in, Mihem Chapa athia kona kaithouva aum masangsen, hiche nathilmu-u hi koima jah-a sei hih-un, tin akhamtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aseijuiten, ibola danthu sunhon, Elijah hung masa tei ding ahi atiuham tin adongun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jesu'n adonbutnin, ajah uva, Elijah chu hung masan tin ijakai ahung semphat ding mong ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin kaseipeh nahiuve, Elijah chu ahungsa ahitai; hinla ama chu ahetlou jeh-un, achungah anopnop aboltauvin ahi. Mihem Chapan jong chutobangma chu amaho khutna athoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitah chun aseijuiten John Baptist thu asei ahi ti chu ahetauvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin mipi lah ahung lhunun, mi khat ahungin a-angah adilsun, ajah-a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai, kachapa lungsetnin, ajehchu abuhthi ahin, athohgim behseh jenge; abangle meijah alhalutjin, abangle twija alhalut jin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule naseijuite henga kahin puilela aboldam joupouvin ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jesu'n, Vo tahsanna neiloule khanglamvai mite, itihchan kaumpi dingu nahiuvem? Itihchan kakhongai ding nahiuvem? Ama chu kahenga hinpui tangu, tin adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jesu'n thilha chu aphoh-in ahile asunga konin apot tai. Chuche-a pat chun chapang chu adamtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuphatnin aseijuite Jesu henga ahungun guhthimin, I atile keihon kanodoh jou louvu hintem? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jesu'n, Natahsan lhom jeh-u ahi, ijeh-inem itile tahbeh-a kaseipeh nahiuve, Nanghon tahsanna ankam mu tebep nei hileuchun, hiche molsang jah-a hin, Hikoma konin khukoma khun kichonin tileuchun, kichon jeng ding ahi. Nangho dinga imacha bolmo umlou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin hitobang hi an ngol le taona beijin apotdoh jipoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Galilee gamsunga aumlaijin, Jesu'n ajah uva, Mihem Chapa hi mihemte khutna kipedoh dingkon ahi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amahon atha dingu ahi, chule ni thum nile kaithouva umding ahi, ati. Hiphat chun alungdong lheh jengtaovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Capernaum ahung geijun, kai dongho ahungun Peter jah-a, Nahilpau khun makhai kai ateji louham, tin adongun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Peter'in, Atiji nai ati. Chuin Peter insung agalutle, Jesu'n ajah-a, Iti nagelem, Simon? Leiset lengte hin kai hijongle sum lamman hijongle koi lah-a adon jiuvem? Achateu lah-a adon uvem, midang lah-a adon uvem, tin anahou masatai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin, Midang lah-a, tia adonbut phatnin, Jesu'n, Ahile, acha anaote cheng onga hija chula.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hitajongle, nangma dil lamah chenlang nga gakoijin; nga nakoidoh masahpen chu lanlang akam keh-le chun dangka cheng khat namu ding ahi. Hichu choi jinlang igom-a dingin gapetan, achutiloule lung himosah get hite, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche pettah chun seijuite Jesu henga ahungun, van lenggama hi koi alenpen ham? tin adongun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jesu'n chapang neocha khat ahengah akouvin, alaijuva adinsah-in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajah uva, Tahbeh-a kaseipeh nahiuve, Nangho nakile heijuva chapang neochahotoh nabah kit louvule, iti nama jongle van lenggam nalut lou dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche jeh-a chu hiche chapang neocha banga kineosah chu, van lenggama alenpen ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule koi hijongle hitobang chapang khat keima mina sanga chun keima eisan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin koi hijongle keima eitahsan hiche aneochaho lah-a khat kipal lhuh sah chan chu, angonga sumhei song lentah kikhaihen, twikhanglen thuhtah sunga kileh lutle ama dingin aphajoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ohe kipal lhuh jeh-in vannoi leiset adana-e! Kipal lhuhna chu umtei ding mong vang ahi, ahinla ohe kipal lhuh sah-a chu koi hile adana-e!
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nakhut ahim, nakeng ahim, khatjo sangin nakipal lhuh sah-a ahile tanbongin lang paimangin; khut ni, keng ni neija tonsotna mit theilou meikonga nakilelut sangin, tibukim loule kengbaijin hinna-a lutle chun nang dingin aphajoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule namitnin nakipal lhuh sah-a ahile, kaldoh-in paimangin; mit ni neija damun meikonga nakilelut sangin, mitlang chon hinna-a lutle chun nang dingin aphajoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kihong phaovin, hiche aneochaho lah-a khatcha jong nahsahmo hih-un; ijeh-inem itile kaseipeh nahiuve, Avantil teovin van'a um ka Pa mai chu ave jingun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu amangsaho huhhing dinga mihem Chapa chu hunga ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule iti nangai touvem? Mikhatnin kelngoi ja khat aneija, alah-a khat ava mangthah-a ahile, aman somko le ko chu adalhah-a, molsang chung lama chea avah mangthah khat chu agaholji louham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule ahol chu amua ahile, tahbeh-a kasei ahi, amapa chun avah mangthah lou somko le ko chunga sang chun, hiche khat chunga chun akipahjon ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutobang chun hiche aneochaho lah-a khattou amanthah ding hi van'a um na-Pau lunglam ahipoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nasopi nachunga achonset tah-a ahile, chenlang nangle ama changseh hetnin asetna chu phoh-in; chua angaija ahile sopi chu nanei ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angai lou vangle, ahetoh dingin mi nile thum kama thu jouse akichetna dingin, ni hile thum hile kipuijin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule chucheng sei jong angai loulaija ahile, houbung henga lhutnin; chua houbung thu jong angaisam louva ahile, ama chu nangho dingin chidang namdangle kaidongho banghen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tahbeh-a kasei ahi, itobang hijongle leiset chunga nakha-u chu van'a jong kikhah ding, leiset chunga nahonu chu van'a jong kihong ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tahbeh-a kaseipeh kit nahiuve, Leiset chunga nalah uva mi nin kilungthoh tah-a thilthum neija atao lhonle, van'a um ka Pan abulhitpeh lhon ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh-inem itile hoikom hijongle mi ni hile thum hile kamina akikhopnao chana chun, alah uva kei kaumnai, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chupettah chun Peter ahenga ahungin, ajah-a, Pakai, kasopin kachunga ijatvei achonsetle kangaidam dingham? Sagivei geijinem? ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu'n ajah-a, Najah-a sagivei geijin katipoi; amavang sagi munsom sagivei geijin katijo bouve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun van lenggam thuhi lengpa khat asohtetoh sum sutoh dinga kigo-a toh kitekah thei ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Asuto pantan ahile, alah uva mikhat ama talent sangsom batpa chu ahenga ahinkai taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Apeh ding ima anei lou jeh-in a-pakaipa chun amatoh, aji achate toh, anei chengse joh-a chule dit dingin thu apetan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Achuti phatnin asohpa chun aboh khupmin, chibai aboh-in, Pakai, neikhongai tadin, abonin sadoh nange, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichun a-pakai pan alungsetnin, alhadoh-in, asumbat jong chu abeisah-in angaidam tai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin chuche sohpa chu apotdoh phatnin, asohchanpi khat dangka somnga bat amun; amanin alol ameh-in, ajah-a, Neipeh ding chengse chu neipen, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Achuti phatnin asohchanpipa kengbula aboh khupmin, ahenga ataovin, Neikhongai tadin, keiman nang abonchan sanange, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin ama anom hih-in, apeh ding chengse chu apeh kahsen songkul'a agakhumtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin asoh chanpihon achuti umchan chu amuvin, alung phamo lheh-un, a-pakai pau henga ahungun thu umchan jouse chu ahung hiltaovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuphatnin a-pakai pan akoma akou lutnin ajah-a, Vo soh nunse, kahenga natao jeh-a kangaidam ahitai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Achutile keiman nang kalungset banga, nangin jong nasohchanpi nalungset ding thu hilouham? ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin a-pakaipa alunghangin, abat chengse asah chaisoh kahse-a dingin, mi bol gentheiho khutna apedohtai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nanghon nasopiteu suhkhelna chu lunggiltah cheh-a nangaidam louvule, van'a um ka Pan nangho chutobanga chu nabol dingu ahi, ati.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Jesu'n thu hicheng chu asei jouvin, Galilee'a patnin akipatdoh-in, Jordan gal Juda gamkai lamah ahungin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule mi tamtah-in ajuijin, hikoma chun amaho chu aboldamin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pharisaiho ahenga ahungun, apatepnan, Ima jouse-a jeh-a min aji ada dan ngai hinam? tin adongun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman adonbutnin, Asempan asemtila amaho numei le pasal'a asemsa ahitai, ti thu chu nanghon nasimkhah lou uham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hiche jeh-a chu pasal'in anu apa adalhah-a, ajia beh ding ahi; chule amani chu ti khat hi lhon ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiti chu ahin amani pumni mi ni hita louva, ti khat hilhona ahitai. Hiche jeh chun Pathen gopsa chu mihemin sukhen hihhen, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon ajah-a, Ahile ibola Mosi'n kidana lekha peh-a da ding tia thu apeh ham? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman, ajah uva, Nalungtah jeh uva Mosi'n naji da dingu aphal ahibouve; ahivangin atilin chuti chu ahipoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keivangin kasei ahi, Koi hijongle mitoh ajon jeh tailouva aji ada-a ji dang nei chan chu ajonga ahi, chule akidasa kichenpi kitna jong chu ajonga ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun aseijuiten ajah-a, Chutia numei le pasal kiloimat dolthua pasal chunga chutobang thu ahile, jinei hi aphapoi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin aman ajah uva, Hiche hi mi jouse jop thei ahipoi, akipete bouvin ajop thei ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi anu sunga nukiso sa-a penga aumin, abang mihem semthu-a nukiso aumin, adang van lenggam khosahna jala amaho le amaho nukiso-a jong aume; ajop theipan jophen, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin achunguva akhut angap-a ataopeh dingin chapangho ahenga ahinpuijun, hinla aseijuiten anaphoh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jesu'n ajah uva, Chapangho chu kahenga hung sah-un, jada hih-un; ijeh-inem itile van lenggam chu hitobang tehoa bou ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutichun Aman achunguvah akhut angamin, chukom mun'a kon chun akipatdoh tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin veuvin, mi khat ahenga ahungin, ajah-a, houhilpha, tonsot hinkemlou kanei theina dinga thilpha ipi kabol dingham, tin adongin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Aman ajah-a, ibolla apha neiti ham? Apha koima aumpoi, khat sehbou aume, ama chu Pathen ahi: ahinla nangma hinna-a chu nalut nomle thupeh chengse nitnin ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mipa chun, Thupeh hoihoi chu-em? ati. Jesu'n adonbutnin, ajah-a, Tolthat hih-in, Jon bol hih-in; Gucha hih-in, Thu jouvin mi heh hih-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanu napa jabolin, Nangma naki ngailut bangin naheng nakom ngailun, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gollhangpa chun adonbutnin, Hichengse chu kachapan laija patna kanitsa ahitai; ipi kabatnah laijem, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu'n ajah-a, Nangman chamkimsoh ing natile, chenlang nanei chengse gajoh inlang mivaicha gentheiho petan, chutile van'a gou nanei ding ahi: chule hungin lang kanung hinjuijin, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin gollhangpa chun chuche thuhil ajah phat chun, gou haotah ahi jeh-in lungnom mo tah-in achemang tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun Jesu'n aseijuite jah-a, Tahbeh-a kaseipeh nahiuve, Mihao dingin van lenggama lut ahahsai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kaseipeh kit nahiuve, Mihao Pathen gama alut sangin, heubil homa sangongsang lut abaijoi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin chuche ajah phatnun, aseijuiten kidang asabehseh jengun, Chuti ahile, koi huhhing-a um jou dingham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichun Jesu'n amaho chu aven, ajah uva, Mihem dingin vang hitheihoi ahipoi, ahin Pathen dingin ijakai ahitheije, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuphatnin Peter'in adonbutnin, Jesu jah-a, Vetemin, keihon ka-ima jouseu kadalhaovin, nanung kahinjui taove; achutile keihon ipi kasan dinguham? ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu'n adonbutnin, ajah uva, Tahbeh-a kaseipeh nahiuve, Ijakai akisemthah-a Mihem Chapa aloupina laltouna-a atou tengle, nangho eijui chengse jong hi laltouna somlenia natou uva, Israel phung somle phung ni thu natan dingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Keima min jala, a-in, asopipate, asopinute, anu, apa, achate chule agam leiset hindalha chan chun, ajatja tamtah amube ding, chule tonsot hinkemlou chang ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amavang amasa cheng tamtah nukhah intin, anukhah cheng masa ding ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ijeh-inem itile van lenggam chu inneipu khat jingpitah-a alengpi leija goi ding natong ding hola che tobang ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama chun natong dingho chutoh ni khatna seki ni lo dinga akihoutoh phatnun, alengpi leija asoltai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vai nungin apotdoh-in, kaithela mohseh-a dingho amun,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajah uva, Nangho jong lengpi leija konun; adoldolin napenao ving kate, ati. Chuin amaho chu achetauvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin sunkimvel le ni kiheijin apotdoh-in chutobangma chu abol kitnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin vaiche phattah-in ama apotdoh-in ahile, midang dingleho chu amun, ajah uva, Ibola sun nilhumkeija mohseh-a nadinu ham? ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon adonbutnun, Koima eigoijuva aumpoi, atiuve. Aman ajah uva, Kalengpi leija konun, adol dola nakisan diu ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nilhah ahi phatnin, lengpilei neipa chun asum chingpa jah-a, Natongho kou inlang athamanu pen, goi nukhahpena patnin goi masahpena chaijin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin vaiche phatna kigoipanho chu ahung phatnun, seki ni cheh asangtaovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin goi masahpenho chu ahung phatnun, kisangtam cheh-inte tin angaito uvin; amala amahon jong seki ni bou asang taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin hichu akilah nungun, inneipu chunga chun aphun taovin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Anununghon nidan kah khatbou na atongun, nangman keiho nisa hahlai thoh-a tonggim chengtoh neikibah sah-un ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin aman alah uva khatpa chu adonbutnin, Kajol, nachungah kakhelna aumpoi; seki ni dinga ikihou hilouham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nathaman sum kilah-in chetan, anunung penpa hi nang kapeh jatma chu kapeh nom-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kanei nahnah kanopnopma kabol chu kadih louham? Ole kaphat jeh-a hi neimit thip hitam?
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutobang chun anukhah masan tin, amasa nukhah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jesu Jerusalem lama achetou konin, somleni ho chu atumin gam choma apuijin, lam dungah ajah uva,
  </para>
  <para style="p">
    <verse number="18" style="v" />Veuvin, Jerusalem jonin ichetouvui; chule Mihem Chapa hi thempu pipuiho le danthu sunho khutna pehdoh-a umding; chule amaho chun athina dinga themmo achansah dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule a-el ela aboluva, ajepmuva, thingpel'a khetbeh dinga chidang namdangte khutna apehdoh dingu ahi; chule ni thum nile ama kaithouva umding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche petah chun Zebedee chapate anuvin achateni chu ahin kipuijin, Jesu henga ahungun, chibai aboh-in, ahenga ikhat thumnan ataovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman amanu jah-a, ipi nangaichat ham? ati. Chuin amanun, Nagam sunga kachate ni hi khat najetna, khat naveija atou theina lhon ding thu pen, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu'n adonbutnin, Nanghon nathumu chu nahet louvu ahi. Kadon ding khonna hi nadon lhona, chule baptize kachan ding hi nachan ngam lhon ding hinam? ati. Chuin amanin, Kangame, ati lhonin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman, Kadona ding khonna vang chu nadon lhona, chule ka baptize chan banga hi nachan theihon ahinan; kajetle kaveija tousah ding vang chu keima peh dol ahipoi; ka-Pan adinguva agotsaho bou chu kipe ding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichun somho chun hichu ajauvin, uchateni chunga chun alung phamo taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla Jesu'n amaho chu akouvin, ajah uva, Nanghon naheuve, chidang namdangte chunga vaipoho khu a-pakaiyu vin apangun, chule milen milaltehon achunguva athuneinau apanjiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangho lah-a vang chuti chu ahipoi; ahin koi hile nangho lah-a alen hi noma chu, nalhachaova pang ding;
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule nalah uva apipuipen hi noma chu, nasoh-u hi ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutobanga chu Mihem Chapatah jong chu jen dinga hung hilouvin, ajenle dingle mi tamtah lhatdoh na-a ahinna toh dingjoh-a hung ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Jericho khopi-a kona akipatdoh-in, mipi tamtah-in anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule, veuvin, mitcho ni lampamah atou lhonin, amani chun lampi chu Jesu'n ajotne ti ahet phat lhonin, Pakai, David chapa, neilungset lhonin, tin asam lhonin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin mipi chun, Thipbeh-in um lhonin, tin aphoh-un ahi; ahivangin amanin ahasapcheh lhonin, Pakai, David chapa, neilungset lhonin, ati lhonin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Jesu adingin, amani chu akouvin, I-lolhon leng nalung lhonham? ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amanin, Pakai, kamit lhon hasah-in, ati lhone.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jesu'n alung asen, amit lhon akhoipeh-in ahile amanin kho amupai jeng lhonin, chule anung ajui lhontai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jerusalem ahung naijuva, Olive molsanga um Bethphage ageitah-un, Jesu'n aseijuite mi ni asolin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajah lhona, Namasang jon lhona kho sunga khun lut lhonin, chule sangan anoutoh kihen namu paijen lhon ding ahi; hiteni chu sut lhoninlang kahenga hinkai lhonin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi khattou ikhat sei aumle, Pakaiyin hiche teni hi manna nom aneije ti lhonle chun, aman ahinsolpai jeng ding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Themgaovin anasei guilhuna dinga hiche ho jouse hi soh-a ahi,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon Zion chanu jah-a, Ven, nalengpa lungnem tah-in sangan chungah, sangan nou chungah atouvin naheng-ah ahunge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti chun aseijuite ni chu ache lhonin, Jesu'n asei bangbang chun abol lhonin;
  </para>
  <para style="p">
    <verse number="7" style="v" />Sangan le sangan nou chu ahinpuijun, achunga aponu aphaovin; achunga chun Jesu atousah-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin mipi lah-a atamjon lam dunga aponu aphaovin, adangsen theoboh alhamun, lam dunga aphaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule mipi amasang lama che chengsele anungjui chengse chun, David chapa, Hosanna, Pakai mina hungpa chu anunnome; Chungnung pena Hosanna! atiuvin asam asamun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jerusalem alut phatnun, Hiche hi koiham? tin khopi pumpin akilohsoh jengun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin mipi chun adonbutnun, Hiche hi Galilee gam Nazareth kho-a kon themgao Jesu ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jesu Pathen houin'ah alutnin, houin sunga thil johho le thil choho abonchan anodoh-in, chule sumlheng ho dokhangle vakhu johho touna chu alekhup peh-in,
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajah uva, Ka-in chu taona in kiti ding ahi, tin akisune; ahin nanghon gucha michom kokhuh-in nasem uve, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin houin'a chun mitcho le elbaiho ahungun, aman amaho chu aboldamin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin thempu pipuiho le danthu sunhon athilbol kidangle houin'a chapanghon Hosanna, David chapa, tia asap chu amuvin, alungphamo lheh jengtaovin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Amahon ajah-a, Hiteho hin ipi aseiju najah nah-em? atiuvin ahi. Chuin Jesu'n, Kajanai; Naosen leh chapang noi cheplai kamin jong vahchoina nachamkim sahtai, ti chu nasimdoh lou uham? ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutichun aman amaho chu adalhan, khopi-a konin apotdoh-in Bethany'a achen; chua chun agehtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin jingkah-in khopi lam ahinjon kitnin ahile, agil akeltan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Aman lamkenga theichang phung khat amun, aphunga achen ahile ana tailou imacha aga mupoi; Chuin Aman, Imatih chanin naga gakit tahih hen, ati. Chuin chupettah chun theichang phung chu agoppai jengtai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichu aseijuiten amu phatnun, alungdong jengun, I-atile theichang phung chu goppai jenga hitante! atiuvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jesu'n adonbutnin, ajah uva, Keiman tahbeh-a kaseipeh nahiuve, Nanghon gingchalel louhela tahsan naneijule, hiche theichang phung hitia bolseh hilouvin, hiche molsang jong hi, Hikoma konin kichondoh inlang twikhanglen'a kileh luttan, ti jongleu chun hi thei ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule ipi hijongle tahsan tah-a taona-a nathum chanu chu aboncha namusoh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin Houin'a alutna thu ahil petnin, thempu pipuiho le upaho ahenga ahungun, ajah-a, Ipi thunei na-a hitiho hi nabolham? Kon hiche thuneina hi napeh ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu'n adonbutnin, Kenjong nangho thu khat donging kate; hichu naseijule kenjong ipi thuneija hicheng kabol ahi seipeh naovinge:
  </para>
  <para style="p">
    <verse number="25" style="v" />John baptize bol chu hoija konham? van'a konha ahiloule mihem'a konham? ati. Chuin amaho akingai touvin, Van'a kon ahi, tileu henla, chuti ahile, Ibola ama natahsan lou uham? tintin;
  </para>
  <para style="p">
    <verse number="26" style="v" />Mihem'a kon ahi ti dingla, mipi jousen John chu themgao ahi tia angaito jeh-un ikichaovin, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutichun amahon Jesu adonbutnun, Kahepouve, atitaove. Chuin Aman jong amaho jah-a, Achutile ipi thuneija hicheng kabol ham keiman jong naseipeh deh pouvinge, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin iti nangai touvem? Mi koiham khatnin chapa ni aneijin, khatpa henga achen ajah-a, Chapa, tunin lengpi leija konin lang na gatongin, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman, Kanompoi; chepong-e, tin adonbutnin, ahivangin khonungin alung aheijin, achetan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin khatjopa henga achen, ajah-a chutobangma chun agaseijin ahi. Aman, Hepa, chenange, tin adonbutnin; chela achetapon ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hite ni chu koijoh chu apa lunga chonham? ati. Amahon, Amasajoh chu, atiuvin ahi. Chuin Jesu'n ajah uva, Tahbeh-a kaseipeh nahiuve, Nangho sanga kaidongho le notiho Pathen lenggam sunga lut masajo ding ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ijeh-inem itile John chu chonphatna lampia naheng uva ahungin, nanghonla nanatahsan pouve; kaidongho le notihon bou anatahsan uvin ahi. Nangho vangin chuche namu-u jong chun, ama chu natahsan theina dingun, khonungin nalung naheichom dehpouvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thulem chom khat jong ngaikitnun: inneipa khat hin lengpilei abolin, palin aum kimvelin, lengpiga chil lhahna pum alaijin, insang asan, chuin alei lhouho khutna apedoh-in, gamdanga achemang tai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin aga phat anai phatnin, atheiga la dingin aleilhouho henga asohte asoltan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahin aleilhouho chun anamanun, khat avovin, khat athatnun, athum napa songin asepmun ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Asohte dang amasaho sanga tamjo asol kitnin ahile, amahon angaina bepmin anabolun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Akhonna-in aman, Kachapa hi anaja domunte, atin achapa ahenguva asoltai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahinla lengpi leilhou hon achapa chu amu phatnun, amahole amaho akihouvun, Ama hi agou lo dinga ahi; hungun, thatnu hitin, agou lo ding eiho changuhite, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin ama chu amanun, lengpilei polamah akaidoh-un, athat taovin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hijeh chun lengpilei neipa chu ahung teng, chuche aleilhouho chu i-lontem? ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amahon ajah-a, Chuche migilouho chu aman engsanin sugamintin, aga phatseh-a atheiga ape ding leilhou dang khutna alengpi lei chu pedoh tante, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu'n ajah uva, In sahon adeimoa apaiju song chu aninga songpi penin apangtai; Hiche hi Pakaiya kon ahin, chule imitmuvin akidange, ti Pathen lekhabua thuhi nasimdoh khah lou uham?
  </para>
  <para style="p">
    <verse number="43" style="v" />Hiche jeh-a chu keiman nangho jah-a kasei ahi, Nangho-a kona Pathen lenggam kilamanga, agadohsah namdang mite kipe ding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Koi hijongle hiche song chunga lhu-a chu ahal hala chip ding; chule koi hile achunga chuche song chua chu leivui banga kithejal ding ahi, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin thempu pipuiho le Pharisai hon hiche athulem sei chu ajah phatnun, amaho chunga thusei ahi chu ahedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin ama chu mat dingin agouvin, ahivangin themgao ahi tia angaito jeh-un, mipi chu akichauvin ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jesu'n adonbutnin, ajah uva thulemin asei kitnin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen lenggam chu Lengpa khat achapa jineina dinga golvah bol tobang ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman agolvahna-a dinga kouna changho chu hungtaovin tia kou dingin asohte asolin; ahinla amaho chu ahung nompouvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman asohte asol kitnin, Akikouho henga cheovin lang, Veuvin, golvahna an aphasadema kagot ahitai: kabongchal le kagancha thao ho akithat tan, chule abonchan phasademin gotsan aumsohtai; nangho moupui golvahna-a hunguvin, tin gaseijun, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahivangin amahon dona neipeh louvin, achemang gamuvin, khat alouva achen, khat sumkol veijin achen;
  </para>
  <para style="p">
    <verse number="6" style="v" />Adangsen asohte chu amanun, nahsahmo tah-in abolun, athat taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin lengpan hichu ajah phatnin, alunghang tan; asepaite chengse asolin, chuche tolthat ho chu asumanghelun, akhou jong ahalpeh taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutah-in asohte jah-a, Golvahna an gotsa ahitai, ane dinga kakou tehola anehoi ahipouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun lamka lamthoma cheovinlang, mi namu chanu golvah an nedingin gakouvun, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutichun asohte chu apot-un lampi dunga acheuvin amu chanu mipha mise apui khomun ahile, golvahna indan chu jin adimset tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin lengpa chu jinho velen ahungin ahile, moupuina vona kivon lou mi khat amudohtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman, Kajol, moupuina vona kivon louva hikoma iti nahung lutham? tin adongin ahile, amapa sei ding helouvin aumtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphatnin lengpan asottolleho jah-a, Akhut akeng kanun lang, kaidoh-un, chule polam muthim lah-a paidoh taovin; hikoma chu kale hagel umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Akikou vang tamtah ahin lhendoh vang lhomcha bou ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pharisai hon athuseija kona mat theina ding doha abolun akihou taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aseijuiteu chu Herod miho toh asolun, amaho chun ajah-a, Houhil, nangma mi dihtah nahi, dihtah-a Pathen lampi chu nahil ahin, chule koima gin naneipoi ti kaheuve; nangman mimai navepoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun Caesar kai kapeh-u hi, dan ngai ham, hilouham? iti nagelem? neisei peh-un, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu'n alunggilou vop-u chu ahen, ajah uva, Vo miphalhem ho, ibola neilunglah uham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Kai kidon na-a sum kipeji chu neivet sah-un, ati. Chuin amahon dinarii khat ahinchoi jun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Aman, Hiche hi koi lim le koi minham? tin adonge.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amahon, Caesar'a ahi, tin adonbutnuve. Chuphatnin Aman, Caesar'a chu Caesar peuvinlang, Pathen'a chu Pathen peuvin, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuche ajah phatnun, adatmouvin, ama adalhauvin, achemang taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuche nimama chun, Mithi thokitna aumpoi ti Saddukai ho ahenga ahungun, thu ahung dongun,
  </para>
  <para style="p">
    <verse number="24" style="v" />Houhil, mi khatcha nei louva athile, asopipan anumeinu chu akichenpia, asopipa dinga chu chi akhaipeh ding ahi, tin Mosi'n eihilun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahile tun kalah uva ucha pasal sagi aumun; amasapenpa chun ji aneijin athitai; ahin ama chu chikhai lou ahitah jeh chun, a-inneipi chu asopipa adalhah pehtai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuti chun abanapa jong, athumnapa jong, asaginapa geijin chutima chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Akhonna-in anumeinu chu athitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahile thokitna-a amanu chu sagi lah-a koipen ji hitantem? Amahonla ji-a anei sohkeiju ahin, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu'n adonbutnin, Pathen lekhabua thu le Pathen thahatna nahetlou jeh uva nakheljiu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thokitna-a chun amaho akicheng tapouvin, chen jong akichensah tapouve; van'a Pathen vantilte tobang ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahinla mithi thokit dol thu Pathen'in najah uva asei,
  </para>
  <para style="p">
    <verse number="32" style="v" />Keima Abraham Pathen, Isaac Pathen, chule Jacob Pathen kahi, ati chu simkha lou nahiuvem? Ama athiho Pathen hilouvin, ahingho Pathen ahijo bouve, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mipi chun hichu ajauvin, athuhil chu kidang asa lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman Saddukai ho anelkhup hel jeng chu ajah phatnun, Pharisai ho akikhomun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule alah uva danthuthem khatnin apatepnan thu adongin,
  </para>
  <para style="p">
    <verse number="36" style="v" />Houhil, chondan thupeh lah-a apipen hoiche ham? ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Jesu'n adonbutnin, Nangman nalung pumpin, nalhagao pumpin Pakai na-Pathen chu ngailun.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hichu thupeh pipen le amasapen ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule chutobanga chu anina hiche ahi, Nangma naki ngailut bangin naheng nakoma ngailun.
  </para>
  <para style="p">
    <verse number="40" style="v" />Thupeh hichete ni-a hin thupeh jouse le themgaoho thu kikhai cheh ahi ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Pharisai ho akikhop petnun, Jesu'n amaho thu adongin, ajah uva,
  </para>
  <para style="p">
    <verse number="42" style="v" />Messiah thudol hi iti nagel uvem? Ama koi chapaham? atin ahile amahon, David chapa, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Aman ajah uva, Chuti ahile,
  </para>
  <para style="p">
    <verse number="44" style="v" />Pakaiyin ka Pakai jah-a, Keiman namelmate chengse nakeng chotpha kaneisah masangsen, kajetlama tou jingin, ati tia David chun Lhagaova ama chu Pakai iti atiham?
  </para>
  <para style="p">
    <verse number="45" style="v" />Chutia David'in ama Pakai asahle, achapa iti hi dingham? ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin koimachan cheng khatchan jong adonbut thei tapouvin, chuche ni-a pat chun koimachan thudang khatcha jong adong ngam tapouvin ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichun Jesu'n mipi jahle aseijuite jah-a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Danthu sunho le Pharisai ho Mosi touna mun'a tou ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche jeh chun athupeh chengseu abonchan bolunlang nit sohkeijun; ahin athilbol bangun vang bol hih-un; ijeh-inem itile amahon asei chu aseijun abolji pouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon doutheilou pohgih akanun miho lengkouvah asep-un, amahonla akhutjung khatchan jong thamloh ding anompouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin amahon athilbol jouseu khu mi mu dingabou abolu ahi; ijeh-inem itile amahon thuchinbom akibu ule akibehho chengu khu apeh aletsah-un; chule aponmongu acholsah-un,
  </para>
  <para style="p">
    <verse number="6" style="v" />Golvahna-a mun pipen chule kikhopna in'a touna pipen,
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai lhanga min chibai aboh dingule, min Rabbi, Rabbi, ati dingu adeijun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon vang mi Rabbi kitisah hih-un; ijeh-inem itile nangho nahiluva khat, Christa jengtah chu aumnai. Chule nangho nabonchaovin sopikhat cheh nahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vannoi leiset chunga koima pa sah hih-un; ijeh-inem itile van'ah na-Pau khat aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nanghon mi lamkai kitisah hih-un; ijeh-inem itile nalamkaija khat, Christa jengbou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nalah uva alenpen chu najenleuva pang ding ahibouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Koi hile ama kichoi sang chu kisunem ding; chule koi hile akineosah-a chu kichoi sang ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla ohe, Danthu sun le Pharisai miphalhem ho, nadau ahi! Ijeh-inem itile nanghon miho masanga van lenggam nakhah-un; nanghola nalutpouvin, chule lut dinga kigoho jong nalutsah pouvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo danthu sunho le Pharisai miphalhem ho, nadau ahi! Ijeh-inem itile nanghon meithaiho in napum valun, kilepnan sot tahtah natao jiuve; hijeh-a chu nangho themmo chungnung nachan dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ohe, Danthusun le Pharisai miphalhem ho, nadau ahi! Ijeh-inem itile mi khat Juda hou housahna dingin twikhanglen le leiset chunga nache kimvel leuvin, chule koi hile najopjop chu nangho sanga ajat ni-a damun mi nahisah jiuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ohe, lamhil mitcho ho, nadau ahi! Ijeh-inem itile nanghon koi hile houin pana kihahsel imathu aumpoi; koi hile houin'a um sana pana kihahsel bou chu leiba ahi, nati uve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo lungthimbei le mitcho ho, sana suthenga houin le sana chu hoijoh chungnung-jo-a ham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nanghon, Koi hile maicham pana kihahsel imathu aumpoi, maicham chunga um thilto pana kihahsel bou chu leiba ahi, nati uve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo mitcho ho, thilto suthenga maicham le thilto chu hoijoh chungnung-jo-a ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun koi hile maicham pana kihahsela chun, maicham le achunga um thilto aboncha apatna kihahsela ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule koi hile houin pana kihahsela chun, houin le achengpa chu agoma apatna kihahsela ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule koi hile van pana kihahsela chun, Pathen touna le achunga Toupa agoma apatna kihahsel ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ohe, Danthu sun le Pharisai miphalhem ho, nadau ahi! Ijeh-inem itile nanghon pudina le pathikhom, chule jira hicheng chu somakhat natohji uvin, danthupeh lah-a alupen, thu adih-a tan, milungset, chule tahsan hicheng chu nalhadah-un ahi. Ahin hicheho hi naman uva, hitiho jong chu nalha lou dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vo lamhil mitcho ho, nanghon thouvaisi nalhiuvin, sagongsang napumval-ui!
  </para>
  <para style="p">
    <verse number="25" style="v" />Ohe, Danthu sun le Pharisai miphalhem ho, nadau ahi! Ijeh-inem itile nanghon khonle lheng apolam nasil ngimun, asunglam hunama lah le kitimlouna adimsetnin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Vo Pharisai mitcho, khonle lheng chu asunglam silngim masale chun, apolam jong ngim dingbou ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ohe, Danthusun le Pharisai miphalhem ho, nadau ahi! Ijeh-inem itile nangho lhan bangleh-a kiloi tobang nahiuve; hitiho chu apolam hoilheh-in akimun, asunglam mithi gu le imanen aboh jouse adimsetnin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutobang chun nangho jong napolamu mi mu dingin chonphatah nahiuve; ahin nasunglamu vang phatlhemna le khangitlouna adimsetnin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ohe, Danthu sun le Pharisai miphalhem ho, nadau ahi! Ijeh-inem itile nanghon themgaoho lhan nasemun, chule michonpha ho lhan najemun,
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule, Kapu kapateu hinlaija chu keiho uma hileuveng, themgaoho thisan sona-a chu pan kalahlou dingu ahi, nati uve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutichun nangho themgaoho that teho son nahiuve ti chu, nangho le nangho ahetoh-a nahiu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Napu napateu thil tena dan chu bulhit pai ngaltaovin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Vo gulteho, gulse sonho, nangho hi damun thutan na-a kona iti nahoi thei dinguham?
  </para>
  <para style="p">
    <verse number="34" style="v" />Veuvin, keiman naheng uva themgao, miching, chonna danthuhil kahinsole; amaho lah-a chu abang nathauva thingpel'a nakhetbeh uva, abang kikhopna ina najep uva, chule khotina nabolset dingu ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichu michonpha Abel thisan kiso-a pat, houin le maicham kikah-a natha-u Barachiah chapa Zekariah thisan kiso geija, leiset chunga michonphateho thisan kiso themona jouse aboncha nangho chunga achuh theina dinga ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tahbeh-a kaseipeh nahiuve, Hicheng chu aboncha tulai mite chunga chu ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Vo Jerusalem, Jerusalem, themgaoho that le ahenga kisol teho songa seplih, ahpin anoute alha noija a-opkhum banga keiman jong nachate ijatvei opkhum dinga kagot hitam! Ahin nangho nanompouve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Veuvin, na-in'u chu akamhel dinga nangho kidalhah peh nahitaove.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ijeh-inem itile kaseipeh nahiuve, Pakai mina hungpa chu anunnome, nati masangseuva, tukala keima neimu lou dingu ahi, ati.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jesu houin'a kona apotdoh-a achele; houin kisahdan ho chu vetsah dingin aseijuite ahenga ahungun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin Jesu'n adonbutnin, ajah uva, Nanghon hicheng hi namu lou uham? Keiman tahbeh-a kaseipeh nahiuve, Hikoma hi song suhchim louva khat chunga khat kisethop himhim umlou helding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Olive mol chunga atou petnin aseijuite guhthimin ahenga ahungun, Hicheng chu itihle hi dingham? Chule nangma hung kit ding phatle vannoi leiset kichai ni ding melchihna ipi hi dingham? neisei peh-un, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jesu'n adonbutnin, ajah uva hitin aseije, Koiman nangho nalheplhah louna dingun kichih theijun,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile mi tamtah keima minin hunguntin, Keima Christa kahi tiuvintin, mi tamtah alheplhah dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nanghon gal kisatle kidou thuthang najah dingu ahi; chingtheijun, lungdong hih-un; ijeh-inem itile hicheng chu hungsoh tei ding ahi; ahivangin achaina hiloulai ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh-inem itile vai khatle vai khat, gam khat le gam khat hung kidouvintin, mun chom choma kel lhantin, nat set lengin tin, ling kihot ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitiho jouse chu naosonat kipan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche phat teng chule genthei hesoh thoh dinga mihon nangho nahinpehdoh dingu ahi; chule keima min jala nangho namtin jouse hotna nahung umdingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiteng chule mi tamtah lunglha ding ahi, chule khatle khat kipedoh tontin, chule khat le khat kihoto ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule themgao lhem tamtah sohdoh-a, mi tamtah alheplhah dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule chonset puncheh cheh jeh-a, mi tamtah ngailutna-a lhadai dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla akhon ni geija thoh lhumkeija pangdetpa bou chu huhhing-a umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule namtin jouse hetsahna dinga hiche gamsung thupha hi vannoi leiset pumpi-a kihil lhang ding ahi; chutahle kichai dingbou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti ahijeh chun mi sumang thet umtah thil thudol Daniel themgao sei chu mun thenga adin namu tengule, (asim siman hehen,)
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutengle Juda gama um chengse thinglhang lamah jamuhen;
  </para>
  <para style="p">
    <verse number="17" style="v" />In chunga uma jong a-in'a athilkeo kilah dingin kumdahen;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule louva um jong apon kilah dingin kile kitdahen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahin ohe, hiche lai chule naovop hole nao noichepsah ho ada nadinguve!
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule najamnao chu phalbilai ahiloule cholngah ni ahi louna dingin taovun.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ijeh-inem itile hiche teng chule hesoh genthei khoh chungnung umding ahi; chutobang hesoh gentheina chu leiset umtilla pat tu geijin aumkha hihlaije, um jong umlou ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hiche nikho chu kisuchom lou hileh, mihem himhim ahinga sohcha umlou dinga ahi; ahinla lhenchomte jala anikho chu kisuchom ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutengle, khat touvin najah uva, Ven, Christa hikoma aume, ahiloule, khukomah, tijongle tahsan hih-un.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ijeh-inem itile Christa lhemho le themgao lhemho hung sohdoh untin, melchihna loupi tahtah le mu kidang ahinvetsah dingu ahi; ahitheile lhenchomte tah jeng jong ahinlheplhah dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Veuvin, Keiman kahil masah dem nahitaove.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun mihon najah uva, Ven, gamthipmah aume atiuva ahile, chedoh hih-un, ahiloule, Ven, indan sungnunga aume, atiu jongle tahsan hih-un.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ijeh-inem itile kolphe niso lama ahung phetdohle, nilhum lam geijin asalvah-in; Mihem Chapa hung kit jong chutobang ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thilong um umna-a bou muthong kikhom ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivangin chutenga hesoh genthei joutah chule nisa thimintin, lha jong vahta lou ding, vanlaijola ahsi ho pullhantin, chule van thahatna ho chengse kihot lingsoh ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutahle vanlaijola Mihem Chapa melchihna hung kilang ding; chuteng tahle vannoi leiset phungtin-in a-op achupchup dingu ahi, chule vanlaijola Mihem Chapa thuneitah le loupi chungnung tah-a meilom lah-a ahung amu dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule aman avantilte sumkon gin nasatahtoh asoldoh ding; chule amahon van mong khatna patna van mong khat geija, kolkimvel li-a kona alhen chomte alon khom dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Theichang phung hin thulem kihilun. Abah adona ana ahungnou tengle, nipi anaitai ti nanghon naheuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chutobang chun nangho jong hichengse chu aboncha namusoh tengule, anai tai, kotbul hungeija ahitai ti heuvin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Keiman nangho tahbeh-a kaseipeh nahiuve, Hichengse chu aboncha aguilhun masangse-a, hiche khangguija mite hi mang lou ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Vanle lei mang ding ahin; keima thu vang mang lou ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahivangin ka Pa changseh tilou van'a vantilte jong, koimachan anikho le anidan tah chu ahepoi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahinla Noah nikho tobang chu Mihem Chapa hungkit nijong hiding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ijeh-inem itile twisanglet masangin, Noah kong'a alut ni geijin, mihon aneuvin adonun, akichengun, akichensah-un,
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule twisang ahung letna abonchauva alhohmang gam kahse chun ima hepha louvin aumun ahi; Mihem Chapa hung ni jongle chutobang ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chutengle mi ni louva um, khat kila-a khat kidalha ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Numei ni sumheija chang goikhoma, khat kila-a khat kidalha ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hijeh chun kiging jingin umum; ijeh-inem itile na-Pakaiyu ipi nikho le nidana ahung ding nanghon nahepouve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Itih phatna gucha ahung ding inneipun ahet hile, kiging jingintin, a-in aphetvangsah lou ding ahi; hichu nanghon heuvin
  </para>
  <para style="p">
    <verse number="44" style="v" />Hijeh chun nangho phasademin umun; ijeh-inem itile nagel lou pettah-ule Mihem Chapa chu hung ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ahile, a-pakaiyin aphat phatcha achan dingu an hoppeh ding a-in sunga jouse chunga apipua apansah, soh tahsan umtah chingtah koiham?
  </para>
  <para style="p">
    <verse number="46" style="v" />A-pakai ahung tenga chutia bol ahungto soh chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tahbeh-a kaseipeh nahiuve, aman ama chu anei jouse chunga apipua apansah ding ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Amavang soh gilou chun alungthimin, Ka pakai ahung geije, tihen,
  </para>
  <para style="p">
    <verse number="49" style="v" />Asoh chanpiho dengpan tahen, chule ju khamho toh ne khom don khomtale,
  </para>
  <para style="p">
    <verse number="50" style="v" />Hiche sohpa chun aginchat lou nitahle ahetlou pettah-a a-pakaipa chu hunga;
  </para>
  <para style="p">
    <verse number="51" style="v" />Ama chu tum ni asoa, achan miphalhem ho lah-a akoi ding ahi; hikoma chu kale hagel umding ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiteng chule van lenggam chu thaomei kikenna mou in neipu lamto dinga potdoh nungah somtoh kitekah ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Alah uva nga chu lungthim bei ahiuvin, nga chu lungthim pha ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ijeh-inem itile lungthim bei chengse chun, thaomei akikenu chun thaotwi akentha pouvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin lungthim pha chengse vang chun, thaomei akenu chun atheija thaotwi akentha uvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin mou inneipu chu ahung gei jeh-in abonchauvin alulhuvin, a-imulhu gam taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin jan khang kimim, Veuvin, mou inneipu ahunge! Alamto dingin potdoh-un, tin akisamtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutah-in hiche nungah ho chu athouvun, athaomei cheh-u akigot taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun lungthim beiho chun lungthim phaho jah-a chun, Nathao twi'u themkhat neipeuvin; ijeh-inem itile keiho thaomei mit ding kon ahitai, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin lungthim phaho chun adonbutnun, Keihole nangho igomuva dingin lhingponte; chusangin ajohho henga cheovinlang nangho ding gakichoh taovin, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla acho dinga ache kah-un mou inneipu chu ahungtan; chule kigosa dema umho chu amatoh mou puina in'ah thakhatnin alut taovin; chule kot akikhah tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin nungah dangho chu ahungun, Pakai, Pakai, kot neihonun, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla aman adonbutnin, Tahbeh-a kaseipeh nahiuve, Keiman nangho kahepouve, atitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun kiging jingin umun, ijeh-inem itile Mihem Chapa hung nading anikhole anidan tah chu nanghon nahepouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh-inem itile van lenggam chu asohte kou khoma anei chengse amaho khutna pedoh-a, khol gama chemang mi khat tobang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman khat chu talent nga apen, khat talent ni apen, khat talent khat apen, athan ajokhop cheh-in sum apen, akipat dohtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin talent nga sangpa chun chupettah chun achen hiche chun akiveijin, talent ngama aveikanben ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutobangma chun talent ni sangpa chun talent nima aveikanben ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin talent khat sangpa vang chun achen, leiko alaijin, a-pakaipa sum chu agasel mangtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin phatsot tah nungin hiche soh ho pakaipa chu ahungin, amaho chutoh sum asutoh taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin talent nga sangpa chun talent nga ahinchoiben, Pakai, nangman talent nga neipeh ahin; ven keiman talent nga kaveikan ben ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin apakai pan ajah-a, Soh pha tahsan umtah, nabol aphatave; nangma themcha khat chunga tahsan umtah nahin, keiman nangma tamtah chunga kapansah ding nahi; nangma na pakai kipana-ah luttan, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin talent ni sangpa jong chu ahungin, Pakai, nangman keima talent ni neipeh ahin; ven keiman talent ni kaveikan ben ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin a-pakaipan ajah-a, Soh pha tahsan umtah, nabol aphatave; nangma themcha khat chunga tahsan umtah nahin, keiman nangma tamtah chunga kapansah ding nahi; nangma napakai kipana-ah luttan, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujouvin talent khat sangpa chu ahungin, Pakai, nangma hi mikhel nahin, natuna louvah na-atjin, nathejalna lou pouvah nahuikhomjin ahi; hichu kahen;
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangma kakichan, kachen nasum talent chu leiah kaseltan ahi: ven, nangma-a ma chu nakimu ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahin a-pakaipan adonbutnin ajah-a, Soh giloule thase, katuna louva ka-atjia, kathe jalna louva kahui khomji nahet ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuti an kasum chu sum veipung na-a anakoi tangem, chutile kei kahung phatna asumthoi puma keiman kasum muta dinga.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun hiche talent chu lahpeh-un lang, talent som neipa chu petaovin,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ijeh-inem itile anei chana chu kipehbe-a, aneiletset ding ahi; anei lou vang chu aneichasun chu ama-a kona kilah mangpeh ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche soh pannabei hi polam muthim-ah gapaimang-un; hikoma chu kale hagel umding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mihem Chapa vantil thengte jousetoh aloupina-a ahung tengtah le, Ama aloupina lal touna-a tou ding ahi;
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule namtin vai jouse Ama anga chu kikhom ding; chule kelngoi chingpan keltah-a kona kelngoi achomkhen banga, aman khatna kona khat achomkhena,
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman kelngoi chengse ajet lama akoija, keltah chengse vei lama akoi ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chutengle lengpa chun ajet lama umteho jah-a chu, Hungun, ka Pa phattheiboh changho, vannoi leiset kiphudoh tila patna nangho dinga gotsa kikoi lenggama hung lotaovin.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ijeh-inem itile kagil akelin ahile, nanghon neh ding neinapeuvin; kadang achah-in, donding neinapeuvin; kamaljinin ahile neilhun sah-un;
  </para>
  <para style="p">
    <verse number="36" style="v" />Kasagoh keova kaumin, pon neinasilpeh-un; kadam mon ahile, eiven nahungun; chule kasoh changin ahile, hikoma jong chun kahenga nahungun ahi, ati ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chutengle michonpha te chun, keihon itih-a nagilkel kamuva, an nehding kapeh khah-um? Ahiloule itih-a nadangchah kamuva, kadon sah-um?
  </para>
  <para style="p">
    <verse number="38" style="v" />Keihon itih-a namaljin kamuva, kalhunsah-um? Ahiloule nasagoh keova naum kamuva, pon kasil pehkhah-um?
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule keihon itih-a nadamo kamuva kahung vetnuva; nasohchan kamuva nahenga kahung uvem? ati dingu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule lengpan amaho jah-a, Tahbeh-a kaseipeh nahiuve, Hiche kasopite ho lah-a aneopen khat nabolna chanseu chu, keima neibolnao ahi, tia adonbut ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chutengle aman avei lama umho jah-a chu, Vo gaosap changho, kakoma konin chemangun, diabol le avantilte dinga kikoi meilhum sunga lut taovin;
  </para>
  <para style="p">
    <verse number="42" style="v" />Ijeh-inem itile kagil kelin, nanghon neh ding neipe pouvin; kadang chah-in, don ding neipepouvin;
  </para>
  <para style="p">
    <verse number="43" style="v" />Kamaljinin, neilhunsah pouvin; sagoh keovin kaumin, pon neinasilpeh pouvin; kadammole kasoh chanin, neihungve pouvin ahi, ati ding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chutengle amahon jong, Pakai, keihon nangma itih-a nagilkel, nadangchah, namaljin, sagoh keova naum, nadammo le nasohchan kamu uva kajenle daovem? tia ama adonbut dingu ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chutengle Aman amaho jah-a, Tahbeh-a kaseipeh nahiuve, Nanghon hiche aneochaho lah-a khat nabol louvu chu, keima neibol louvu ahi, tia adonbut ding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule amaho chu tonsot kemlou talent man dinga cheova, michonpha ho chu kemlou tonsot hinna-a che ding ahiuve.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chutichun Jesu'n hichengse chu asei jouvin, aseijuite jah-a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nini joule kalchuhkut hi ding ahi; chule Mihem Chapa hi thingpel'a khetbeh dinga melmate khutna kipedoh ding ahi, ti chu nanghon naheuve, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutah chun thempu pipuiho le danthusunho, upaho chu thempu chungnung Caiaphas atiu inpia chun akikhomun,
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu chu doha bola matna, thana dingin akihou khomtaovin ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Amavang, Kut sung chun hidahen, ajole mipi lah-a thunoh umgetninte, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Jesu Bethany kho-a Simon miphahpa in'a aumpetnin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Numei khatnin songval bomin thao namtui manlutah ahinchoijin, ahenga ahungin, a-ankong um pettah-in alu chunga asunglhan anun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin aseijuiten hichu amuvin, alungnom mo uvin, Ibola hitia amoh suhmang jeng hitam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijeh-inem itile hiche thao hi aman tamtah-a joh-a, mivaicha gentheiho peh thei ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin Jesu'n hichu ahetdoh phatnin, Ibola numeinu hi nasuh lunggimu ham? Kachunga hi thil phatah abol ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijeh-inem itile mivaicha gentheite chu nakom uva aum jingnauve, keimavang nangho koma um jinga kahipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche thao namtui eisunkhum hi, eikivui nikho-a dinga chu eigot ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman nangho tahbeh-a kaseipeh nahiuve, Vannoi leiset gam pumpi-a hiche Kipana Thupha kihil lhang nachana, hiche numeinu thilbol jong hi, amanu het jingna-a kiseipeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuphatnin somleni lah-a khat, Juda Iscariot atiu chu, thempu pipuiho koma achen,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajah uva, Ama khu matsah leuveng ipi neipeh diuham? ati. Chuin amahon ama chu dangka somthum ateppeh taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chupet tah-a pat chun aman ama chu pedoh-a matsahna thei dingje agomkom aholtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin cholsolou changlhah kut ni masa nin aseijuite Jesu hengah ahungun, Kalchuhkut nanehna ding hoikoma goleuveng nalungham, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Aman ajah uva, Khopi sunga cheovinlang mi khat jah-a, Houhilin, Kaphat anaitai; kaseijuite toh nangma in'a kalchuhkut an kanehkhom dingu ahi, ati, tin gaseijun, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Jesu'n ahil bangbangu chun abolun, aseijuiten kalchuhkut chu agago taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin nilhah ahi phatnin, aseijuite somleni chutoh atou taovin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin a-anneh laitah-un aman ajah uva, Tahbeh-a kasei ahi, nalah uva khatnin eipehdoh-a eimatsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin alungdong lheh jengtaovin, ajah-a, Pakai, kei kahim? aticheh taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman adonbutnin, Lhenga kaso khompipa tah chu eimatsah dinga ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihem Chapa achonchan ding thu kisun bangtah-a chu cheding mong ahi, ahivangin Mihem Chapa pedoh-a matsah dingpa chu ohe adana-e! Ama chu apena peng lou hile ama dinga phajota ding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichun apedoh-a pang ding Juda Iscariot chun adonbutnin, Pakai, kei kahim? ati. Chuin aman, Nakisei khai, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin an aneh laitah-un, Jesu'n changlhah alan, phatthei aboh jouvin ahehbal balin, aseijuite apen, Kilah-un, neuvin; hiche hi katahsa ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin khon alan, athangvah jouvin amaho chu apen, ajah uva, Nabonchaovin don sohkeijun;
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh-inem itile hiche hi chonset suhbeina dinga mi tamtah dinga kisodoh kitepna thah kathisan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule keiman nangho jah-a kasei ahi, Ka Pa lenggam sunga nang hotoh athah-a kadonkhom ni ahunglhun kahse-a, tu kala hiche lengpiga twi hi kadon kit lou ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin amahon la asah jouvun apotdoh-un, Olive molsang lama achetauvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutah chun Jesu'n ajah uva, Tujana hi nangho nabon chaova kachunga lungthoi sohkei ding nahiuve; ijeh-inem itile, Keiman kelngoi chingpa kavoh lhuh ding, chutengle kelngoihon chu chehgam ding ahi, tin akisune.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahin kathodoh nungle, Galilee gam lam namasang sang uva kache ding ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahin Peter'in adonbutnin, ajah-a, Abonchauvin nachungah lungthoi jongleu, keima vang itihchan hijongle lungthoi ponge, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu'n ajah-a, tahbeh-a kaseipeh nahi, tujan ah khon masanga thumvei neiseilep ding ahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pater'in ajah-a, Nangma toh thitha ding mong hijongleng, keiman nangma seilep hihhel ing kate, ati. Aseijuite jousen jong chuti chun asei sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hichun Jesu amaho chutoh Gethsemane atiu mun khat alhunun, aman aseijuite jah-a, Keima khukoma khu kache-a kagatao sungsen, nangho hikoma hin anatou jingun, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Peter le Zebedai chapate ni chu akipuijin; chule alunghem lheh jengin alungkham pantan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chutah chun aman amaho jah-a, Thina khophelin kalung hesoh behseh jengtai; hikoma umunlang neikigin piuvin, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin amasang lama phabep khat ache chonin, akhupbon alhun tolah amai asulutnin, ataovin, Ka Pa, ahi theile, hiche khon hi keija konin kitolmang jenghen; ahivangin keima lunggot bang hilouvin, nangma lunggot bang hijohen, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin aseijuite henga ahungin ahile, amaho chu ana-imut lhuh gamu ahungtoh-in, Peter jah-a, Nanghon nidan khat jengjong nei kiginpi jou lou uham?
  </para>
  <para style="p">
    <verse number="41" style="v" />Lhepna-a nalhah louna dingun kigingun, taovun; lhagao vangin agonan tahsan ajoupoi, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin aniveina-in ache kitnin, ataovin, Ka Pa, hiche khona kadon louva kitolmang thei lou ahile, nangma thuthu hihen, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin ahung kitnin ahile, amaho chu a-imut lhuh-u ahungtoh-in ahi; ijeh-inem itile amaho chu a-imutsoh lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chutichun amaho chu adalhan, athumvei na-in ache kitnin, ataovin, aseingai bangma chu asei kitnin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chutah-in aseijuite hengah ahungin, ajah uva, Ahile, tun imuvinlang kitha ol taovin; veuvin, phat alhingtai, chule Mihem Chapa hi michonse te khutna kipedoh-a ahitai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kipat un, chetao hite; veuvin, eipedohpa ahungnai tai, ati.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin hichu asei nalajin, veuvin, somleni lah-a Juda Iscariot chu thempu pipuiho le upaho koma kona chemjam le moltum hintho-a hungkon mipi nasatah chutoh ahung kilhonin ahungtan ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ama pedoh-a pangpa chun amaho chu melchihna ahil masan, Keiman kachop penpen chu ama ahi, ama chu man-un, ati ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin aman Jesu heng ajon paijin, Rabbi, chibai, atin achoptan ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin Jesu'n ajah-a, Kajol, Ibola hunga nahim? ati. Chutah-in amaho chun akom ahin naijun, Jesu chungah akhut alhaovin, amantaovin ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin, veuvin, Jesu loiho khatnin akhut alamin, achemjam asatdoh-in, thempu chungnung sohpa asatle abilkol lang khat asatlhan ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuphatnin Jesu'n ajah-a, Nachemjam chu akoina-a koi kitnin; ijeh-inem itile chemjam panteho chu chemjam'a lou ding ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ole tutah jenga jong hi ka Pan avantil janel somleni sanga tamjo eihin solpehna dinga kathum thei louva nangaito ham?
  </para>
  <para style="p">
    <verse number="54" style="v" />Ahinla chutin kibole hitia hi thu soh tei ding ahi, tia Pathen lekhabua kisun chu iti guilhun thei dingham? ati.
  </para>
  <para style="p">
    <verse number="55" style="v" />Hichepet chun Jesu'n mipi chengse jah-a chun, Gucha michom man dinga kon banga chemjamle moltum nahinthova, keima man dinga nahung kon uham? Keima houin'ah niseh-in katouvin thu kahil jingin, chulaijinla neiman pouvin ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Amavang themgaoho lekha sut thu guilhuna dinga, hichengse hi aboncha soh-a ahitai, ati. Chutah chun aseijuite jousen ama adalhauvin, ajamgam taovin ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin Jesu manho chun danthu sunho le upaho kikhopna, Caiaphas atiu thempu chungnung henga chun akaijun ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Peter vang chun galkanga ajuipeh-in, thempu chungnung inpi leitol geijin ajuijin, hikoma chun alutnin, Achaina munge, tin sottolho lah-a chun atouvin ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Hichun thempu pipuiho le houvaipoloi chengsen Jesu thana dingin achungah hettohsah jouthu aholun;
  </para>
  <para style="p">
    <verse number="60" style="v" />Jouthu hettohsah tamtah ahung vangun, amupouvin ahi. Akhonnan mi ni ahungin,
  </para>
  <para style="p">
    <verse number="61" style="v" />Hichepa hin, Keima Pathen houin suse-a ni thum sunga sadoh kit thei kahi ati, ahung ti lhonin ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chuin thempu chungnung chu adingdoh-in, ajah-a, Nadonbut lou dingham? Hitehon nahehsetna-a thu aseiju hi ipiham? ati.
  </para>
  <para style="p">
    <verse number="63" style="v" />Ahivangin Jesu thipbeh-in aumin ahi. Chuin thempu chungnung chun ajah-a, Keiman nangma Pathen hing mina kahahsela kasol nahi, nangma Pathen Chapa Christa chu nahim? Neisei peh-un, ati.
  </para>
  <para style="p">
    <verse number="64" style="v" />Hichun Jesu'n ajah-a, Naseikhai, chukalvala kaseipeh nahiuve, Tunung kalle nanghon Mihem Chapa thahatna jet lama atoule, meilom chunga ahung namu dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chutah-in thempu chungnung chun apon abotkeh-in, Hiche hi Pathen ataitom ahi; eihon thu hettohsah dang iding iti tah dinguham? Veuvin, nanghon tun Pathen ataitomna najataovin ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Nanghon iti nagel uvem? ati. Amahon, Thi dinga lom ahi, tin adonbutnun ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Chutah-in amahon amaijah chil asetnun, akhut tumun akhenun; chule kimkhatnin abengun,
  </para>
  <para style="p">
    <verse number="68" style="v" />Vo Khrista, gaovinlang seijin, koiham nabenga chu, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Hichepet chun Peter polamah leitolah atouvin ahi; hichun sohnu khat ahenga ahungin ajah-a, Nangma jong Galilee mi Jesu toh kiloi chu nahi, ati.
  </para>
  <para style="p">
    <verse number="70" style="v" />Ahivangin aman japi angsungah aseilepmin, Nathusei chu kahepoi, atitan ahi.
  </para>
  <para style="p">
    <verse number="71" style="v" />Chuin kelkot phung lamah apotnin ahile, sohnu achom khatnin ama chu amun, chukoma umho jah-a chun, Hichepa jong hi Nazareth Jesu koma uma chu ahi, ati.
  </para>
  <para style="p">
    <verse number="72" style="v" />Chuin aman aseilep kitnin, Hiche mipa chu kahepoi, tin akihahseltan ahi.
  </para>
  <para style="p">
    <verse number="73" style="v" />Chujou phabepmin chukoma um miho chu ahenga ahungun, Peter jah-a, Tahbeh-in nangma jong amaho lah-a khat mongmong nahi; ijeh-inem itile napao chun nangma naphong doh-e, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="74" style="v" />Hiphat chun aman, Hiche mihempa chu kahe hih hele tin kigaosaple kihahsel athopantan ahi. Chupettah chun ahchal akhongtan ahi.
  </para>
  <para style="p">
    <verse number="75" style="v" />Hichun, Ahchal khon masanga thumvei neiseilep ding ahi, tia Jesu thusei chu Peter'in ageldoh-in; chuin polamah apotdoh-in, lhasetah-in hakan akaptan ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin jingkah ahi phatnin, thempu pipuiho chengsele upaho jouse Jesu thana dingin akihoutoh taovin ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Ama chu akanun, akaijun, gamvaipo Pontius Pilate khutnah apedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutah-in apedoh-a panga Juda Iscariot chun athi dinga themmo achansah-u chu amun ahile akisih-in, dangka somthum chu thempu pipuiho le upaho alepeh kitnin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Themona neilou thisan kapehdoh chu kachon kheltai, ati. Ahinla amahon, Hichu keiho ka ithu-u umam? Nangman nalo nomnom lotan, ati taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun aman dangka chu houin sunga asep lhan, chukoma kon chun achemangin, ama akikhai lihtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin thempu pipuihon hiche dangka chu alauvin, Hiche hi thisan man ahi jeh-in, housum kholna-a koi angai ahipoi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun amaho akihoutoh-un, gamdang miho vuina dingin, hichun beldengpa leiset achou vin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche jeh chun tugeijin hiche leiset chu thisan leiset akitin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichu themgao Jeremiah thusei, Israel chate lah-a kona aman asahsao, aman kisahpa man chu dangka somthum alauvin ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule, Pakaiyin eithupeh dungjuijin, beldengpa leiset manin apetaovin ahi, ati chu guilhunga ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin Jesu chu gamvaipo angah adingtan ahi: chuin gamvaipo chun adongin, Nangma Juda te lengpa nahim? atin ahile, Jesu'n ajah-a, Naseikhai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin thempu pipuiho le upahon ahehsetna thu ijat asei vangun, aman imachan adonbutpon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutah-in Pilate'in ajah-a, Hitehon nangma douna hettohsahna asei chengseu hi najah louham? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin Aman cheng khatcha jong adonbut lou jeh chun, gamvaipo chun adatmo lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche kut sunga chu sohchang koi hile mihon agotpen penu chu gamvaipo chun alhadohji angai ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichepet chun sohchang amin Barabbas atiu, sohchang minthang tah khat aumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun amaho akikhop phatnun, Pilate'in amaho chu adongin, Koijoh lhadoh pehleng nalungu ham? Barabbas ha, Christa kiti Jesu joh ham? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijeh-inem itile thangset suma apehdoh-u ahi chu aman ahen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ama thutanna mun'a atoupetnin, a-inneipin thu ahin thotnin, Hiche michonpha pa chu limsah hih-in; ijeh-inem itile Ama jeh chun tunin kamangin kathohgim lheh jengin ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla thempu pipuiho le upahon Barabbas chu angeh uva, chule Jesu chu asuhmangsah dingin mipi chu atilse taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin gamvaipo chun adonbutnin, Hichete ni hi koijoh lhadoh pehleng nalungu ham? atin ahile; amahon, Barabbas, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pilate'in ajah uva, Achutile Christa kiti Jesu hi i-kalo dingba hitam? ati. Chuin amahon, Thingpel'a kikhenbeh hen, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman, Ibolinem, ipi suhset aneiham? ati. Ahivangin amahon hasaptah-in asamun, Thingpelah kikhenbeh hen, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pilate'in ananlela abol ima phatsahna ahilou, thunoh baotam asojoh chu amu phatnin, twi alan, mipi angsungah akhut asillhan, Hiche michonpha pa thisan kisona-a themona nei lou kahi; nanghon nalolo lotaovin, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin mihon abonchauvin adonbutnun, Ama thisan phu chu keiho le kachateu chungah chuhen, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutah-in aman amaho chu Barabbas alhadohpeh-un; Jesu vang chu ajepmin, thingpel'a khetbeh dingin apedohtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutah-in gamvaipo sepai ho chun Jesu chu Pretorium sungah apui lutnun, akomah sepaiho jouse akikhom sohkeijun;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule aponsil chu ahoh lha uvin, ponsandup asilpeh taovin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule ling lukhuh aphanun, alu-a akhuhpeh-un, chule akhut jet lamah pengtenggol khat achoisah-un, a-angah adilsuvin, Vo Juda te Lengpa, Chibai, atiuvin, totnopnan ael-elin abolun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin chil asetkhumun, apumpeng choi chu alauvin, alu avoh naovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutia chu totnopna-a a-el ela abol jouvun, pon san chu ahoh lha uvin, ama pon asilpeh-un thingpel'a khetbeh dingin apuitaovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chujouvin apotdoh uva acheule, amin Simon atiu, Cyrene gam mi khat amuvin, ama athingpel puding chun acham louvin amanun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Golgotha (Hichu lugumun tina ahi) atiu mun chu alhunun,
  </para>
  <para style="p">
    <verse number="34" style="v" />Amahon Jesu chu gilkhatoh kihal lengpitwi thuh adonsah-un ahile, aman atepmin adon nomtapon ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chujouvin amachu thingpel'a akhenbeh-un; themgao thusei, kapon akihom taovin, chule kasangkhol chol vang vetnan amang taove, atichu guilhun nan, apon chu akihomun, chule vang avetaove.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule hikoma chun atouvun, ama chu angah taovin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule HICHEPA HI JESU JUDA TE LENGPA AHI, tin ahehnau hetsahna asunun, alu chungah atah-un ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hiche pet chun amatoh thakhatnin gucha michom ni, khat ajet lamah khat avei lamah thingpelah akhen beh-un ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin achele avahle jousen akhasuh khumun, a-el elin ahouvun,
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang houin suse-a ni thuma sadoh kit, nangma kihuh hing tangem! nangma Pathen Chapa nahile, thingpel'a konin hung kumlhan, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Thempu pipuihon jong, danthu sunho le upaho toh chutima chun totnopnan abolun,
  </para>
  <para style="p">
    <verse number="42" style="v" />Aman midang ahuhhingjin; ama akihuhhing theipoi. Ama Israelte Lengpa ahileh, tun thingpel'a konin hung kumlha temhen, achutile tahsanunge.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aman Pathen asongin; Pathen'in adei ahile tun huhhing hen; ijeh-inem itile aman, Pathen Chapa kahi ati, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule amatoh thingpel'a kikhetbeh tha gucha michomte ni jong chun, chutobangma chun ahouse lhonin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin nidan gupma pat Nidan ko geijin, gam jouse chungah mu athim tan ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin nidan ko donin Jesu'n, Eli, Eli, lama sabachthani, tin hapenin apengin ahi. Hichu, Ka Pathen, ka Pathen, ibola neidalhah ham, tina ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chukoma dingho lah-a abang bangin chutia ati chu ajauvin, Hichepan Elijah akouve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chupettah chun alah uva khat alhaijelin, twichop phon khat alan, lengpitwi thuh adelhopmin, pengtenggol leh-a atah-in, agahdonsah-in ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ahin adangho chun, Limsah hih-in; Elijah ahuhhinga hunga hung hih-am, veohite, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin Jesu hapenin apengin, alhagao alhadohtan ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin, veuvin, houin'a pondal len chu achunga pat anoi geijin a-ehlha paijin keh ni akison; chule ling akihotnin, songpiho akeh-in ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chule lhankhuh ho akihongin, a-imu mithengho long tamtah kaithouvin aumin ahi;
  </para>
  <para style="p">
    <verse number="53" style="v" />Chule ama thokit nung chun amaho chu lhankhuh-a konin apotdoh-un, khopi thenga ache lutnun, mi tamtah akimusah uvin ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin sepai jalamkai le aumpi Jesu ngah-a pangho chun ling kihot le thilsoh umchanje chu amuvin, akicha lheh jengun, Hichepa hi Pathen Chapa tahbeh mong ahi, ati taovin ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chule Galilee gama kona Jesu nung hinjuija ajenlea pang numei tamtah aumun, amaho chun galkanga pangin ave jingun ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Alah uva chun Magdalene Mariam, Jacob le Joses nu Mariam, chule Zebedee chapate ni nu aumun ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin nilhah ahi phatnin, Jesu seijuija pang Arimathea kho-a amin Joseph atiu mihaotah khat Pilate henga ahungin, Jesu long chu athumin ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hichun Pilate chun apeh dingin thu apetan ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chuin Joseph chun along chu alan, tupat ponnem ngimseh chan atomin, song alaihom ama lhan thah sunga chun alupsah-in,
  </para>
  <para style="p">
    <verse number="60" style="v" />Lhan kotna chun song lentah khat atanglutnin, achemang tan ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chule Magdalene Mariam le Mariam chom nu chu hikoma chun aumun, lhan maija chun atou jingun ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Ajingin, hichu kigot ni ahin, thempu pipuiho le Pharisai ho Pilate hengah akikhomun,
  </para>
  <para style="p">
    <verse number="63" style="v" />Ajah-a, Kapu, hiche milhemlhapa chun ahinlaijin, Ni thum joule thoukit ding kahi, ati chu tun kalunguva alange.
  </para>
  <para style="p">
    <verse number="64" style="v" />Hijeh chun ni thum geija alhan ngah ding thu pen; ajole jannin aseijuite hunguntin, gumang untin, miho jah-a, Athi lah-a konin athoukit tai tiget nunte; chutile suhkhel masah sanga suhkhel nunung chu setchehna hi ding ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Pilate'in ajah uva, Nanghon santri hon khat naneiju chu; cheovinlang nanga thei theijun ganga phatsah taovin, ati.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chuin amaho angah ding santri hon chutoh alhonun, song chunga chun mohor anamun, lhan chu phatah-in angasah taovin ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin cholngah ni kichaija Hapta kipat ni masa ni khovah thenthenin, Magdalene Mariam le Mariam chom nu chu lhan ve ding chun ahung lhonin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule, veuvin, ling hahon akihot tan ahi; ijeh-inem itile Pakai vantil van'a konin ahung kumlhan, song chu akotna konin atangdoh-in, achungah atouvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Avouso chu kolphetoh abangin, aponsil chu buhbang bangin abangin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ama akichat jeh-un angah ho akihot akihotnun, athi-a toh abang jengun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin hiche vantil chun numei ho chu ahin houvin, ajah uva, Nangho kicha hih-un, ijeh-inem itile thingpel'a kithat Jesu chu naholu ahi kahenai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama hikoma aumtapoi; ijeh-inem itile aman asei bang chun athoudohtai. Hungun lang Pakai lupna hung vetaovin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho cheloijun lang aseijuiteho jah-a hiche hi gaseijun, Ama athi lah-a konin athoudohtai; chule, veuvin, Galilee gam lamah namasanguvah achei; chukoma chu nanghon ama namu dingu ahi, gatiuvin; veuvin, najah uva kaseitai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amaho kichat toh gomin hapan akipah-un, lhan phunga kon chun achedoh loijun, aseijuite henga thulhut ding chun alhaijel taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amaho aseijuite seipeh dinga acheule, veuvin, Jesu'n amaho chu akimupin, ajah uva, Damselun, ati. Hichun amahon aheng ajonun, akeng atuh-un chibai abohtauvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun Jesu'n ajah uva, Kicha hih-un, cheovin, kasopite jah-a gaseijun, amaho Galilee gam lama cheohen, chukoma chu amahon eimu dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin amaho acheu chun, santri'a dingho phabep khopi sunga ahungun, thusoh umchan jouse ahung lhutnun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amaho upaho toh akikhomun, akihoutoh jouvun, sepaiho chu sum tamtah apeuvin, ajah uva,
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka-imut kah-un aseijuite ahungun, agumang taove, tiuvin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche thuhi gamvaipon ajah-a ahile, keihon ama hou lungdam ungting, nangho lung olmosah pouvinge, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichun amahon sum chu akilah-un, ahil bangu chun aboltauvin ahi; chule hiche thu chu Juda miho lah-a akiseison sonin tugeijin aumin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chujouvin seijui somlekhat chu Galilee gama Jesu'n atepnao mola chun achetauvun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Ama amu phatnun, chibai aboh-un; ahivangin abang bangin agingcha pouvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jesu ahenguva ahungin amaho chu ahoupin, ajah uva, Van'a le leija thuneina jouse keima eikipea ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche jeh chun nangho cheovin, namtina mi jouse seijuijin gasemun, a-Pa, a-Cha chule Lhagao Theng minin amaho chu baptize gabolun;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule keiman nangho kapeh thu jouse hi aboncha anit dinguvin gahilun; chule, veuvin vannoi leiset kichaini geijin keiman nangho kaumpi jing naove, ati. Amen.
  </para>
</usx>
