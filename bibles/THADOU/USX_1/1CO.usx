<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CO" style="id">1 Corinth</book>
  <para style="h">1 Corinth</para>
  <para style="toc1">1 Corinth</para>
  <para style="toc2">1 Corinth</para>
  <para style="mt">1 Corinth</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen phasah-a Christa solchah dinga kikou Paul leh sopi Sosthenes,
  </para>
  <para style="p">
    <verse number="2" style="v" />Corinth-a um Pathen houbung, Christa Jesu'a kisuthenga, mitheng dinga kikoute henga, gamtina I-Pakaiyu (amahole eiho Pakai) Jesu Christa min pan chengsetoh;
  </para>
  <para style="p">
    <verse number="3" style="v" />I-Pau Pathen le Jesu Christa-a konin lungsetna leh lungmon naheng uvah umhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Christa Jesu'a Pathen lungset nangho henga kipeh jeh chun nangho chungchang thuah Pathen kathangvah jinge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijakai-ah, thuseina tincheng leh, hetna tichenga aman nahaosah-u ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho lah-a Christa thu kahettohsah chu kiphut det ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutia chu nangho thilpeh lhasam louhela, I-Pakaiyu Jesu Christa hung kit ngah-a umjing nahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman nangho akhon ni geija nakoidet jing dingu, chutengle nangho I-Pakaiyu Jesu Christa nikho ni chuleh themona beihela naum dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen tahsan umtah ahi, aman Achapa I-Pakaiyu Jesu Christa kithopi dinga nakoulut-u ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun sopite, nangho thukhat kisaovin, nalah uva kikhen telna umlouvin, lungkhat le lung ngaito khat na lolhing tah-in kipunkhom mun, tia I-Pakaiyu Jesu Christa mina katem nahiuve,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijeh-inem itile, kasopite ho, nachung chang thu-u nalah uva kinel noh baotam aume, ti Chloe te inko seinan kajai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tu-a kasei chu hiche ahi, nangho amilipmin, Keima Paul'a kahi, keima Apollo'a kahi, keima Cephas'a kahi, keima Christa'a kahi, nati sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Christa chu nahop khen khenu hitam? Paul chu nangho dinga thingpel'a kikhenbeh mongam? Ole Paul mina baptize nachan mongum?
  </para>
  <para style="p">
    <verse number="14" style="v" />Crispus leh Gaius tailou, adang koimacha baptize kachansah lou jeh chun Pathen kathangvah-e;
  </para>
  <para style="p">
    <verse number="15" style="v" />Achuti loule keiman keima mina baptize kachan ahi, tia sei umkha ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keiman Stephanas insung mite chu baptize kachansah ahin, chuche tailou chu adang koima baptize kachansah kahepoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Baptize chansah dinga hilouva, Kipana Thupha hille dinga bou Christan eisol ahi; chihna thua seiding hilouvin, achuti loule Christa thingpel chu imacha hilou sohkha ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thingpel thu chu amangthai dingho dingin ngolna ahi; asohcha eiho ding vangin Pathen thahat ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiti jong hin akisune, Keiman michingho chih chu kasuhmanga, Lungthim themho lungthim moh kahisah ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Miching hoiham? Lekha sun mihil hoiham? Tukhanga minel kala hoibaham? Vannoi leiset chihna chu Pathen'in asuh ngol hilouham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu Pathen chihna-in, leiset mihem ten amaho chihna-a Pathen ahetlou phatnuva, ngolhoi thu hila atahsanho huhhing chu Pathen'in pha asah ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Juda ten melchihna angeh jiuvin, chule Greek miten chihna aholjiuve;
  </para>
  <para style="p">
    <verse number="23" style="v" />Keihon vang thingpel chunga Christa kikhetbeh thu kahilleu ahin, hichu Juda te dingin kipal lhuhna ahin, chule Greek te dingin ngolna ahi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Amavang Juda hihen Greek hileh, akikouho ding vangin Christa chu Pathen hatna le Pathen chihna ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ijeh-inem itile Pathen ngolna chu mihem sanga gamchenga chingjo ahin, chule Pathen hatmona chu mihem sanga gamchenga hatjo ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ijeh-inem itile, sopite, nanghon nakikou dolu hi ngaito temun, leiset tahsa phe lama miching tamtah, thanei tamtah, chule milun tamtah akikou pon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahivangin Pathen'in michingho jachat sahna dinga, vannoi'a angolteho alhena; ahat apaoho jachat sahna dinga, vannoi'a hatmoteho alhen ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Vannoi leisetna thil kidah um le thil noinung cheng chu Pathen'in alhena, chule aumlou jong chu aumsaho imacha hilou sona dinga alhen ahi;
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichu ama angsunga leiset mihem akisonga koima aum louhelna ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangho vang chu ama vanga Christa Jesu'a um nahiuve, amachu Pathen'a kona eiho dinga chihna, chonphatna, kithensona, kilhatdohna-a kisem ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A kisun dung juijin, Koi hile akisonga chu Pakaiya kisonghen, ati.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule, sopite, keima vang naheng uva Pathen thu hettohsah seiphonga kahung chun, thusei themna le chihna toh thon kahungpoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu Christa thu le thingpel chunga akikhetbeh thu tailou, nalah uva thudang hehih helinge tia kangaito ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keima nalah uva hatmotah, kichatah, chule kihot hot jinga kana um ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kathusei le kathu lhangsap chu mihem chihna-a jollhah themna ahipon, amavang Lhagao le athahatna-a phot tohna ahijon ahi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutia chu natahsan naochu mihem chihna-a dinga hilouva, Pathen thahatna joh-a ding ahina ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amavang apilhing saho jah-a vang chihna thun jong kaseiji naove, ahivangin hiche vannoi leiset chihna thu ahipoi, hiche vannoi leiset vaipo mangthah dingho chih thu jong ahipoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin Pathen chihna thuguh, iloupina dinguva Pathen'in vannoi leiset um masanga agot masah chihna thu ki-im chu, kaseijoh-u ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichu hiche vannoi leiset vaipoho him himin ahetoh pouve, heleu loupina Pakai chu thingpel'a akhetbeh louhel dingu ahi. Hijongle,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin mit mukhah lou, na jahkhah lou, Mihem lunga lutkha lou, Pathen'in angailuho dinga agotsa chengse chu, tin akisune.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin Pathen'in eiho hengah Lhagaovin aphongdoh tai, Ajehchu Lhagaovin imajouse akholdoh jia, Pathen thuguh jong akholdohji ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi lung sunga thu um mihem'a um lhagao tailou adang mihem koiham ahea? Chuche bang chun Pathen thu jong Pathen Lhagao tailou koima dangin ahepoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun Pathen'in manbeija eipeh chengseu hi hetna dinga, eiho vannoi leiset lhagao changa hilouva Pathen'a hungkon Lhagao changa ihiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitiho chu mihem chihna-in ahil thua sei louva, Lhagao Thengin ahil thu chu, lhagao le lhagao tekah-a kahilu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tahsa lam mihem ten Pathen Lhagao thuhi alajipouve; ajehchu amaho dinga ngol thu ahi, chule hichu lhagaova hetkhenbou ahi jeh chun athudol chu ahekhen thei himhim pouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lhagao mi vang chun thil ijakai ahekhenjin, ama chula koiman ahekhen jipoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Pakai lungthim he-a, ama hil thei dinga koiham? Eiho vang chu Christa lung pu-a ihiuve.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sopite, keiman lhagao lam mite henga sei bangin nangho henga kasei theipon, tahsa lam mite henga sei banga, Christa lama naosen ho jah-a seibanga kasei ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nangho an guma vah louva noitwija kavah-bou nahiuve, ajehchu tuchan hin nane thei hih-un, tu jengin jong nane thei hih laijuve;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho tu geijin tahsa mi nahi nalaijui. Ijeh-inem itile nalah uva kithangset to, kinah kiphun kikhentel aum nalaije; ahile, natahsa chonu hilouham? chule mi chon chona chon nahi lou uham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ijeh inem itile khatnin, Keima Paul'a kahi, nati uva; adang khatnin, Keima Apollo'a kahi, nati laiseuva chu; tahsa-a nahi lou uham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Apollos chu koiham? Chule Paul chu koiham? Pakaiyin mijouse apeh dungjuija, alhacha-a pang, amani-a kona nanghon natahsanu ahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman kaphu ahin, Apollon twi achap ahi, Pathen bouvin akhansah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti ahin aphutpa jong ima ahipon, atwi chappa jong ima ahidehpoi; akhansah-a Pathen chubou ahipen ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun aphutpa le atwi chappa chu thakhat ahi lhone, ahivangin atohgim lhon dungjui juija tohman asan gel lhon ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu keini Pathen tohkhompi kahi lhonin, nangho Pathen lou nahiuve, Pathen in-sah nahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen lungset vanga eikipeh dungjuija insa themtah banga abul kaphu ahitai, achunga chu midangin asah ahi. Amavang chuche chunga sa ding chengsen asah danje ding chu chingthei chehhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijeh inem itile abul phudohsa tailou chu abul dang koiman aphutdoh theitapoi, chuche abul kiphut chu Jesu Christa ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuche bul kiphut chunga chun koi hijongle sana-a sanoman sahen, dangka-a sanoman sahen, song mantama sanoman sahen, thinga sanoman sahen, bi-a sanoman sahen, pola sanoman sahen;
  </para>
  <para style="p">
    <verse number="13" style="v" />Atoh cheh-u chu hung kiphongdoh cheh ding ahi; ijeh-inem itile nikho chun aphondoh ding, hiche ni chule meija kiphongdoh ding ahijeh chun, meijin mijouse anatoh aset aphat apatep ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Achunga insaho chu koi koi hile a-insah chu adin jinga ahile, ama chun toh phatman asan ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule koi hile a-insah akahvama ahile, ama chu hakam ding; amatah vang huhhing-a umding ahi, ahivangin meikong lah pal galkaija bang ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathen in theng nahiuva chule nasunguva Pathen Lhagao achen chu nahet lou uham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen in theng suhboh-a chu Pathen'in ama chu asuhmang ding ahi. Ijeh-inem itile Pathen in chu thengtah ahi, nangho jong chutichu nahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Koimacha amale ama kilhemlha hihhen. Nalah uva khattou, tulai khang thua hi kachinge, ti aumle, ama chu achihna ding chun ngol hen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh chu hiche vannoi leiset chihna hi Pathen dinga ngolna ahi. Ajehchu, aman michingho chu ajonchih naovah amanjie, tin akisune.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujongle, Pakaiyin michingho lunggel le thil ngaito chu moh ahi ahenai, ati kitleuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun koima mihem'a kisong hihhen. Ijeh-inem itile thiljouse nangho-a ahi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Paul hihen, Apollos hihen, Cephas hihen, vannoi leiset hijongle, hinna hihen, thina hihen, tupetle khonung hijongle, aboncha nangho-a ahi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangho jong Christa-a nahiuve, Christa chu Pathen'a ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiho hi Christa lhacha le Pathen thuguh chingin min eingaitou hen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gou ching jenga jonghi, tahsan umtah mi ngaija ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahivangin, nanghon kaumchan nakhol diu, ahiloule mihem thutan na-in akhol ding chu keima dinga thilneocha bou ahi. Henge keiman jong kaumchan kaki kholpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu keiman kachungah imacha kakihetpoi, ahinla hichea hin them eichanpoi; ajeh chu kaumchan khola Pakai joh ahibouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuti ahi jeh chun Pakai hung kahsen aphat masangin thu tanloi hih-un; aman muthima thilsel chu khovah-a ahinphondoh ding, chule mihem lung sungin ipi agelem hi jong chu aphondoh ding ahinai. Hiche teng chule amitakipmin pachatna achan ding dol cheh Pathen'a kona asan ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sopite, akisun chengse kalvala koiman angaito louding; chutia chu nalah uva khatnin khat asona, achomkhat chunga hoithona aneilou ding ti thuhil hi keinia kona nahetdoh nadiuva, keima le Apollos hi tekah na-a kahinsei ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu koiham midanga kon nachom khenuva? chule nakisan louvu thil ipi nanei juvem? Nasan uva ahile ibola asang lou banga hoithoa nahiu vem?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangho tun nava taove, tun nahautaove, keiho beija lengho banga vai nahomu ahitai. Keiho jong nang hotoh thakhatna vai ihomkhom theina dinguvin, vai hom tahtah hileu chun kati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen'in keiho solchah ho hi, athi dinga kigo-a banga anukhah pena eikoiju hinte tin kangaitoi; hijeh-a chu vannoi le, vantil teho, chule mihem vetchah-a um kahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiho vang Christa jala angola kahiuvin, nangho vang Christa-a achinga nahiuve; keiho kadoijun, nangho vang nahatnui; nangho mi jatah nahiuvin, keiho vang mi nahsahmo kahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tugei jong hin kagilkel, kadang chah-un, ponsil nihchen bei kahiuvin, jepmin ka-umuvin, chennabih neilou kahiuvin;
  </para>
  <para style="p">
    <verse number="12" style="v" />Kakhut uvin na kakitoh uvin; eihouseuva phatthei kabohjiuvin, eikibolset tengule kathoh hamhamun;
  </para>
  <para style="p">
    <verse number="13" style="v" />Eikihehset tengule kalhem lungdamjiuvin ahi; keiho vannoi bohsele thil jouse nen bangin tu geijin kaum nalai uve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangho jachat sahna dinga hicheng thuhi kahinsut ahipoi, kacha deitahte banga hilchahnajoh-a kasut ahibouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu nanghon Christa-a chun nahiluva sangsom nei jeng jongleu chun, pa khat kal naneipouve; ajeh chu Kipana Thupha vanga Christa Jesu'a kahinsa kachate nahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun kangeh nahiuve, keima dungsun hiuvin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche dinga chu Pakaiya tahsantah kachapa deitah Timothy naheng uva kahinsol ahi; keiman muntina houbung tina kahil banga, Christa-a kaum thudol aman nangho nageldohsah dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun nangho lah-a kimkhat keima hi naheng uva hungponte, tin nahoitho taovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin Pakai lunglam ahile naheng uva hung vahnange; chutengle chuche ahoitho cheng thu hilouvin athaneinao henang kate.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathen lenggam chu thua hilouvin, thanei na-a ahibouve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hoiche ham nadeijoh-u? Naheng uva mol kachoija kahung dingha, ngailut neija lungnempu-a lhagaova kahung dingham?
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nalah uva jon thanhoi aume, ti kichentah-in akijan ahi, chidang namdangte lah jenga jong kiminphah khalou jon thanhoi aume; mikhatnin apa ji jin aneije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutobanga chonpa chu nalah uva kona nodoh-a aum ding lhadaina-a neitah sangin, hoithonan naneijo taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keimatah katahsa alhah lou vangin kalhagao nalah uva alhan, chutobanga chonpa thu chu katanin, hitihin kaki chaisah tai;
  </para>
  <para style="p">
    <verse number="4" style="v" />I-Pakaiyu Jesu Christa mina, keima lhagaotoh, I-Pakaiyu Jesu Christa thaneina toh nakikhop tengule,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutia chon mi chu atahsa manna dinga Satan khutna pedoh-un, I-Pakaiyu Jesu nikho nileh alhagao huhhing-a aum theina dingin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho nakisonnao chu aphapoi; chol themchan changbong lum apumpin achansohjin ahi ti nahet lou uham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu-a nangho cholsolou nahi bangu chun, changbong lum thah nahina dingun chol lui chu then ngimun paidoh-un. Ijeh-inem itile ikalchuh kut satha dingun Christa tah chu akithat tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun chol lui mang louvin kut boluhite, engsetle khan gitlou chola kut bol louvin lung thengselle kitahna-in cholsolou changlhah-in kut boluhite.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman nangho kahinthot lekha-a chun jon panhotoh kivopkhom hih-un, tin kahin suntan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Achutinai tin vannoi'a jon panho neipap kiloseho, misumang ho, thilha houho toh nakivop khom louhel dingu ahipoi, chutile vannoi leiset hi nachanhel dingu ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amavang sopi-a kisimsa khattou ajona, neipap kiloset abola, thilha ahouva, ataitoma, ju akhama, mi anam bola ahile, ama chu kivoppi hih-un, hitobang mi chu an jeng jong neh khompi hih-un, tia kahinsut ahibouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Polamaho thu tanding ka-ikin tahham? Houbung sunga mite thu natanji hih-um?
  </para>
  <para style="p">
    <verse number="13" style="v" />Polama miho thu vang chu Pathen'in bou atan ahi. Hijeh chun nalah uva konin chuche michonse chu paidoh-un.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho khatnin khat chunga boina thu naneijule, mithengho anga hehta louva michonpha lou anga gaheh ji nangam um?
  </para>
  <para style="p">
    <verse number="2" style="v" />Mithengten vannoi thu atan dingu hi nahet louvu ham? Chule vannoi thu nangho tanding ahile, thu neopen tan dinga kilom lou nahiu ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Eiho hin vantil teho thu kisan itan dingu ahi hi helou nahiuvem? Achutile tulai hinkho chungchang thuhi itanda dingu ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutia chu tu hinlai thudola thu tan ding nahiule, houbung in imacha-a asimlouho chu thutan na mun'a itousah dinguham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Najachatna dinguva hiche thuhi kahinsei ahi. Sopicha kah-a thu tanlha thei nalah uva miching khatcha beh jong umlou hellaham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla nangho asopin asopi chunga thuboi neija heh-an jong atahsan louho angabou nahehjiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangho khatle khat nakiheh tou chu nangho dingin losamna lentah ahitai. Themmo nakichan joh jenguva pha hilouham? Lheplhah-a naum joh jenguva phajo hilouham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Achutipoi, nangho mama-in aphalou nabolun chule mi nalhem uvin, chule hicheho chu nasopi hou chunga nabol uve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ole michonpha lou hon Pathen lenggam alo lou dingu ahi, ti hi nahet lou uham? Nangho lheplhah-in um hih-un; mijong, milim hou, mijigem, mihuh, palepa kikoi,
  </para>
  <para style="p">
    <verse number="10" style="v" />Gucha, neipap kilose, jukham, mihanse, minambol; hiteho chun Pathen lenggam alo louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangho abang hiti chu nahiuvin, ahivangin Pakai Jesu Christa minle Pathen Lhagaova kisil ngim nahitaovin, akisuthenga, them changa nahitaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keima dingin ijakai bol ngai ahi, ahivangin ijakai aphasohkei poi; imajouse keima dingin bolngai ahi, ahivangin imacha noija umponge.
  </para>
  <para style="p">
    <verse number="13" style="v" />Oisung dinga an, an dinga oisung ahi; ahivangin Pathen'in agoma beihela ahinlha ding ahi. Chule itahsao hi jonna ding ahipoi, Pakaiya ding joh ahin, chule Pakai jong tahsa-a ding ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Pathen'in athahatna-a Pakai chu akaithou ahin, eiho jong eikaithou dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Natahsao chu Christa tibah ahi ti nahet lou uham? Chuti chu ahile Christa tibah ho chu kalah manga noti tibah ho-a kasem dingham? Chutiponte.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule noti'a beh chu amanu chutoh ti khat ahi ti hi nahet lou uham? ajehchu Pathen'in, amani chu tikhat hilhon ding ahi, ati ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin Pakaiya beh-a vang chu amatoh lhagaova khat hia ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jon thanhoija konin jamun. Mihem chonsetna jouse hi atahsa polama ahi; jonthanhoi bol vang chu koi hile ama tahsa chunga chonsea ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahilou jongle Pathen'a kona naneiju Lhagao Theng nalung sunguva chenga chu natahsao hi a-in theng ahi ti nahet lou uham? Nangho nangho-a tum nahipouve;
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangho man kipe-a kicho dohsa nahitaove, hijeh chun natahsao le na lhagao un Pathen choi-an nun, hichu Pathen na ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun imama thudola kahenga dinga nahin lekha sutnu chu kahindon butna hiche ahi, Pasal'in numei atohkhah louvin aphai;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahivangin jon louna dingin pasal'in numei khat cheh jin neihen, chule numei khatcheh injong pasal khatcheh jin neihen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajipan ajinu chu achan dingdol chansahhen, chutobang machun ajinun jong ajipa chansah hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Numei chun ama tahsa chunga imacha thu aneipoi, apasal'in bou aneije; chutobangma chun pasal jong ama tahsa chunga thu aneipoi, anumeijin bou anei ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />An ngolla taona-a nakipeh theina dinguva, chomcha khat kikhena chule kivop khomloi kit dinga nakiphasah geluva ahi tailouvin, kikhen kah hih-un; achuti loule kitimlel jeh-in Satan'in lhemlha getnun nate.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin hiche hi thupeh bangtah-a kasei ahipoi, kaphatsah thua kaseijoh ahibouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi jouse keima tobang cheh hile kati; ahivangin mikhatnin achom, khatnin achom dang, hitobanga chu min Pathen'a kona Phattheina chom cheh anei ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jinei louva umho dingle, meithaiho dinga hiche hi kahinsei ahi, amaho chu keima banghin umleu phante.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amavang akitim jou lou ule ji neiju hen; ajehchu huh-a jon sangin jinei aphajoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ji neisaho vang hiche thuhi kapeh ahi, keima kahipon Pakaiyin apeh ahi, numei jin ajipa dalha hihhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Adalhah tahjongle jinei louvin umhen, ahiloule ajipatoh kihoucham kit hen. Chule pasal'in ajinu da hihhen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule adangho thu dingdol vang chu Pakai hilouvin, keima sei ahi: Sopi khat touvin numei atahsanlou ji aneija, a-inneipu chutoh umkhom anople, ama chu a-inneipun da hihhen;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule numei khattouvin pasal atahsanlou aneija, ajipan amanutoh chenkhom ding anople, ama chun a-inneipu chu da hihhen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh-inem itile chuche tahsanlou pasal chu ajinu jala chu kisuthenga ahitai; chule numei tahsanlou jong chu ajipa jala chu kisuthenga ahi; chutilou hile nachateo jong aboh ding ahiuve, tunla amaho athenguve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijongle atahsanlou chun adalhahtah-a ahile achele chetante; sopipa ahin ahiloule sopinu ahin hitobang thudola hin kikana aumtapoi; hijongle Pathen'in lungmonga umdinga eikouvu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu, Vo numei, nangman na-inneipu huhhing-a naumsah jou ding iti nahetnam? Ahiloule pasal, nangman jong na-inneipi huhhing-a naumsah jou ding iti nahetnam?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin Pathen'in mijouse ahoppeh bangle, Pakaiyin mijouse akou bang cheh-in, chon cheh-u hen. Chule hitobanga chu houbung jouse-a kathupeh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cheptansa kikou umam? cheptan chun chuti umhen. Cheptan louva kikou umam? Cheptan louvin chuti umhen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cheptan chu imacha ahipon chule cheptanlou jong ima ahidehpoi; Pathen thupeh nitbou hi thupipen ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mijouse akikouva aum bang bang cheh-in um chehhen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Soh nahi puma kikou nahim? hichu khohsa hih-in; amavang ongthol nahung hithei ding vangle, hichu mangchajon.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ijeh inem itile soh hipuma Pakaiya kikou chu, Pakaiya dinga ongthol ahi; chutobang chun a-ongthola kikou chu Christa soh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangho aman kipe-a kichoa nahitaove; miho soh hihih-un.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sopite, mijouse akikou uva aum bang cheh-un, Pathen to umkhom cheh uhen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nungah thengho thudol vang, keiman Pakaiya kon thupeh mong kaneipoi; hijongle tahsan umtah hidinga Pakaiya kona lungsetna mu-a kahi dungjuija, kangaito danje kasei ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutichu ahin tu laija hesohna jeh hin, hiche hi phante tin kagingchai, mi aum ngaijin um chehhen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Numeitoh kicheng nahim? Ondoh ding ngaito hih-in. Numeija kona ongdoh nahim? Jinei lung gul hih-in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin jinei jongle chun achonsea nahipoi, nungah theng jong chun ji neijongle achonsea ahipoi. Amavang chutobang miho chu tahsa lama hesoh genthei athoh dingu ahi; hijongleh thohda leuchun kati ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivangin, sopite, hiche phat chu kisuchoma ahitai; tu-a kalin jineija chu jineilou bangin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Akapte akap lou bangin, akipahte akipah lou bangin, thil cho-a anei lou bangin umuhen,
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule leiset chonna mangcha-a chun avala mang lou bangin umuhen. Ijeh-inem itile hiche leiset umchan danhi achemang jinge.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahin ima khohsah louhelin umleu chun kalung ahi. Jineilou chun itile Pakai chu kalung lhaidem tin, Pakai lam thil jengbou akhohsah-in ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahin jineija vang chun hiche leiset thil, itile ka-inneipi kalunglhai theidem, ti jengbou akhohsah-in ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Numei jinei le nungah theng kikah-a jong akikhehna aume. Numei jineilou chun tahsale lhagao agoma thengsela um theina dingin Pakai lam thil jengbou akhohsah jin ahi; jinei vang chun leiset lam thil, itile ka-inneipu kalunglhai sah theidem, ti jengbou ageljin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichu nangho thangkola khina dinga kasei hilouvin, naphatchomna dinguva kaseijoh ahi, umchan phakeicha naum uva, baotamna beija Pakai kin nabol theinajoh dinguva kasei ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amavang mi khat touvin acha nungah theng khat kathilbol hi adihpoi tia agela, amanu chu akul ahitah-a, aji neilou akhohsah-a ahile, alung got gotnin bol jenghen; hichea chun setna aumpoi; jineisah jeng hen.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amavang koi hile lung dettah po-a, khohsahna neilouva, alungthim aki thunun jouva, achanu thenna tuhdet peh jingdinga gelha-a chun, thilpha abol ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hijeh chun achanu jineisah-a chun apha abol ahin; ahivangin jineisah loujo chun aphajo cheh abol ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />A-inneipu ahin lai chansea a-inneipi chu danna kihen jinga ahi, a-inneipu athi teng vangle amanu a-onga ahitan, Pakai tahsan ahipou le anop nop napa chutoh kicheng thei ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Amavang keima ngaito danin, achuti um jeng theija ahile, amanu chu minun nomjo ahi, kei jong Pathen Lhagao changin kakingaitoi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Milim houna-a kikatdoh thilho thudola chun: ibon chaovin hetna inei cheh uve ti iheuve. Hetna-in mi ahoitho sahjin, ngailutna hin mi akhantou sahjin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi khat tou, ijakai he-a akingaitoa ahileh, ama chun ahet ding dol imacha ahetlou ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amavang khat touvin Pathen angailut le, amatah chu Pathen het ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Milim houna-a kikatdoh thil nehding thudol vang chu, vannoi'a hin milim hi imacha ahipon, chule Pathen khatseh tailou chu Pathen dang aumpoi, ti iheuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile vanlaijola jong, leiset chunga jong, Pathen tia kiminvoho uma ahi, (chutia chu pathen tamtah uma, pakai tamtah uma ahi;)
  </para>
  <para style="p">
    <verse number="6" style="v" />Eiho ding vangin thil jouse kona, eiho jong ama-a ihiu, Pa, Pathen khatbou aumin, chule thil jouse kona, chule eiho jong ama vanga ihinu, Pakai Jesu Christa khat bou aume.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin mi jousen chuche hetna chu aneipoi, chuti chun akimkhatnin tu geija masanga achonnau milim hou thu chu achin jeh-un, amaho chun milim houna-a kitohdoh thil ahi tin anejiuvin; chua chun ase apha hetkhenna alungu ahat lou jeh chun, akisubohji taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin an neh hin Pathen to eikinaisah dingu ahipoi; eihon ineh uleh aphajep ihi pouvin, ineh louvule jong aphamopen ihideh pouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin chingtheijun, nachamlhatnao hi ijem itile ahatmo ding chun kipal lhuhna higet ninte.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hetna neija nangma milim houna-a ankong naum chu khat touvin muhen lang hileh, sele pha hetkhenna-a lhasam ama chun milim houna-a kikatdoh thilchu neh ngam nadinga hansanna aneilo louding ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutile ajala Christa thia chuche sopi hatmo chu, nangma hetna nei jeh-a manthah lo louding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla sopite chunga nangho chutia nachonset uva, ase le pha hetkhennau hatmo chu namavo tengule, nangho Christa douna-a chonse nahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun an neh-in kasopi akipal lhuhsah-a ahile, kasopi lhuh louna dingin, a-imatih chanin sa-a san nehdange.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Solchah khat hilou kahim? Chamlhat hilou kahim? I-Pakaiyu Jesu Christa mulou kahim? Nangho jong Pakaiya kanatoh nahi lou uham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Adang dangin solchah hilou jongleng, nangho dingbeh-in kahi; Pakaiya solchah kahi het kichetna mohor nangho nahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche hi kathem kathemlou eikholtohho lekalna kihonna-a kasei ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nehna ding le donna dinga thuneina neilou kahiuvem?
  </para>
  <para style="p">
    <verse number="5" style="v" />Solchah danghole, Pakai sopite, chule Cephas banga khu sopinu khattou ji-a neija kipuile mo kahiuvem?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahiloule Barnabas le kei bouhi kanatoh lhonna-a kon haimo kahi lhonem?
  </para>
  <para style="p">
    <verse number="7" style="v" />Koiham ama sum kineh-a sepai na tonga? Lengpithei hon sema aga nelou koiham? Gancha honpi vula anoi ne lou koiham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chucheng chu mihem ngaidan jenga kasei ham? Danthun jong hicheng chu asei hilouham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosi danthua, Bongchal chang chil pet amuh kan hih-un, tin akisune. Pathen'in bongchalho ding jengbou agel ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahiloule eiho dinga jong asei ham? Eiho ding monga hiche thuhi kisuna ahi; lou kaija chun kinepna neija akai ding; chule kinepna neija chang vo-a chun akinepna banga amu ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keihon nangho dinga lhagao muchi katu uva ahile, na tahsalam thilu ga kalo dingu chu thil lentah hajaham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Midanghon nachung uva thuneina chu aneija ahile, keihon kahanei chehjoh lou uham? Hijongle hiche thuneina chu kamang pouve; Christa Kipana Thupha thu kadoudal louna dingun, ijakai abonchan kathoh hamham jovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thiltheng lhacha-a panghon houin'a thilho chu anehjiuva, chule maichama lhachahon maichama kitoh chan aneijiu khu nahet lou uham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutobangma chu, Kipana Thupha lhangsama panghon, Kipana Thupha-a kona aneh dingu ahi, tia Pakaiyin chonnadan asem ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin keiman hicheng chu khatcha jong kamangchapoi; chule chutia chu eikibolna dinga hicheng thuhi kahinsut jong ahipoi; kakisonna hi khattouvin ahomkeo asosah sangin, keima thimaleng keima dingin aphajoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman Kipana Thupha thu kahille vangin kisonna ding ima kaneipoi; bollou theilou kinkhoh kachunga eikisekhum ahijeh-in; Kipana Thupha lhangsamle lou hileng kachung gih ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keima lungchama bola kahile tohphat man kasan ding ahi; keima lungchama bola kahilou vangle, Kipana Thupha gouchinga eikipansah hinte.
  </para>
  <para style="p">
    <verse number="18" style="v" />Achutile tohphat man kasan ding chu iham? Kipana Thupha kalhangsap leteng Kipana Thupha-a hi kathuneina kamanchah khel louna dinga, Christa Kipana Thupha man beija kahopjal hi ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima mi jouse-a kona ongthola kahi vangin, mi tamcheh kalah lut theina dinga, mi jouse soh-a kakisem ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutichun Juda te kalah lut theinan, Juda te henga Juda mi um bangin kaumjin: danthu noijate kaloi lut theinan, danthu noija umte hengah, danthu noija um bangin kaumjin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dan neiloute kaloi lut theinan, dan neiloute hengah, dan neilou bangin kaumjin, ahin Pathen dan mang louva um kahipoi, Christa danthu noija um kahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahatmote kaloi lut theina dingin, ahatmote henga ahatmo kahi: itilam hijongle themkhat beh kahuhhing thei teina dinga, mi jouse dinga ijakai kasoji ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kabolchan hi Kipana Thupha khohsah na-a kabol ahin, nangho toh chan kaneikhom theina ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lhaitet golsehna-a khu mi jouse lhaicheh ji-a ahi, ahivangin khatbouvin hatman asangjin ahi, hichu nanghon nahet lou uham? Nasan theina dingun lhaijun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule koi hijongle golseh jouving tia guttena chu, ijakaija akitim hatjin ahi. Amaho chun lallukhuh kem mangthei lona-a abolu ahin, eihovang kemmang theilou lallukhuh lo-a ihiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh-a chu hitia chu lhaija kahi, abidoi kichen nei louva lhaija kahipoi; hitia chu chuma kahi, onghom lai chuma kahipoi,
  </para>
  <para style="p">
    <verse number="27" style="v" />Kati hi kachup kachupjia kathua kanunsah ahi; achuti loule midangho thu kahille nungin, keimatah ijemtin paidoh-in um khange.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo sopite, hiche hi helouva naum dingu kalung anompoi, Ipute Ipateu chu abonchauva meibol noija ana umuva, chule twikhanglen apal galkaiju ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abon chaovin Mosi-a chun meibol le twikhanglen'ah baptize achangun,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule abon chaovin lhagao an thakhat aneuvin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Abonchauvin lhagao twi thakhat anadonun ahi. Hichu anungsang chenguva chea lhagao songpi-a kona chu amahon adonu ahi; chule hiche songpi chu Christa ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahivangin amaho atamjo chunga chun Pathen alunglhaipon ahi; ajeh chu gamthip gama chun alhukam gamtaovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thilphalou alunggot banguva chu eihon jong thilphalou ilunggot louna dinguva, chuti chu eivetsah nau ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amaho lah-a kimkhat milim hou ahi bangu chun nangho um hih-un; hiche thudol chu hitin akisune, Miho chu an neding le don dingin atouvun, chuin alam dingin akipatdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amaho lah-a kimkhatnin jon apat uva, nikhat sunga sangsomni le sangthum athilo bangu chun, eihon jong jon pan pouhite.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amaho lah-a kimkhatnin apatep jeh uva gul'in asumang bangun; eihon jong Christa patep pouhite.
  </para>
  <para style="p">
    <verse number="10" style="v" />Alah uva kimkhat aphunchel jeh-un, suhmang na-in asumangun ahi; chutobang chun phunchel hih-un.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tu-a thil hicheng hi avetsahna dinga achunguva soh-a ahi; chule vannoi leiset kichaina hung lhun nading eiho, kithuhilna dinga kisuna ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche jeh chun koi hile adinga kingaito-a chu alhuh louna dingin chingtheihen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihem dou thei kalval lhepna nachung uva achukhapoi; Pathen tahsan umtah ahin, nathan adou jou kalvalin lhepna nachung uva chuhsah ponte; hijeh chun nathoh jouna dingun, lhepna chutoh kilhona nakihuhdohna dingu lampi jong nasempeh dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun, kasopi ngaiteho, milim hou jamsanun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman nangho mi lungching nahiu kahetna kasei ahi, kathusei hi nanghon kikhollun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Phatthei channa khon phatthei iboh-u khu, Christa thisan ikiloi khompi nau hilouham? Chule changlhah ihebaljiu khu Christa tahsa ikiloi khompi nau hilouham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ijeh-inem itile eiho mi tamtah hi changlhah lum khat ihiuvin, ti khat ihiuve; ajeh chu changlhah lum khatna chu ibon chaova chan ineiju ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tahsa lama Israelte khu veuvin, kithoina sa neho khu maicham toh chan neikhom hilouham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Achutile ipi kaseijem? Milim houna an chu ikhat ahi, ahiloule milim hou jong hi ikhat ahi, katim?
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuti ahipoi, chidang namdang ten akithoinao chu Pathen lama atou hilouvin, thilha dingjoh-a atou ahibouve; nangho thilha toh nakiloikhom dingu chu kalung nahipeh pouve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nanghon Pakai khon le thilha khona nadonkop thei lou dingu ahi, Pakai ankong le thilha ankong na-umkop thei lou dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ole thangset sahna dinga Pakai chu isuh lunghangu ham? Ama sanga hatjobeh ihiuvem?
  </para>
  <para style="p">
    <verse number="23" style="v" />Thil ijakai keima din bol ngai ahin, ahivangin ijakai phatna ahipoi; ijakai keima din bol ngai ahin, ahivangin ijakai phattouna ahipoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Koiman ama chang phatna hol louvin, aheng akoma dingjoh hol-hen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kailhanga kijoh thiljouse chu ne jengun, sele pha hetna jeh-in ima dong hih-un;
  </para>
  <para style="p">
    <verse number="26" style="v" />Ijeh-inem itile leiset le asunga umjouse hi aboncha Pakaiya ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Atahsan louho khattouvin an ne-a nakouva nache nomle, sele pha hetna jeh-in ima dong hih-un, na-anga alui chan chu ne jengun.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amavang khattouvin, hiche hi milimho henga kithoina kitoh ahi, tia naseipeh-a ahivangle, ahetsahpa jeh le sele pha hetna jeh chun nehdaovin, ijeh-inem itile leiset le asunga thil um jouse hi Pakaiya ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangma sele pha hetna kati hilouvin ama-a joh chu kati ahi. Kacham lhatna chu midang sele pha hetna-in ibola ei-oimo dingham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajehchu thangvahna neija kaneh leh, ibola thangvahna kanei chunga chu oimo-a um kahim?
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuti ahi jeh chun naneh jongule, nadon jongule, nabol jouseu Pathen loupina ding jengin bolun.
  </para>
  <para style="p">
    <verse number="32" style="v" />Juda mi hihen, Greek mi hitale, Pathen houbung mite hitale, akipal lhuhna dingun ima bolhih helun,
  </para>
  <para style="p">
    <verse number="33" style="v" />Keiman keichang phatchomna ding hol louva, huhhing-a aum theina dinguva mi tamtah phatchomna holnajoh-a, thil jouse-a mi jouse kalung lhaisah banghin, nanghon jong bollun.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keima Christa dungsuna kaum bang hin nangho keima dungsuna umun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tun sopite, nanghon imajousea keima neigeldoh jinguva, chonna ding thugou kapeh bang banga dettah-a nachin uva nanit jeh-un kapahchauve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahivangin Christa chu pasal jouse luchang ahia, pasal chengse numei luchang ahi, chule Christa luchang Pathen ahi chu, heleu chun kalung ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Koi hile pasal lukhuh khuhpuma taova ahim, lhagaova thu seidoh ahim chun alu ajabol lou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin numei lukhuh khuh louva taole lhagaova thu seidoh chun alu ajabol lou ahin, alu chu akiveltol tobang ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Numei lukhuh khuh lou aumle kivomui ngal hen; alu veltol le asam kivomui chu numei dinga jachatna ahile, lukhuh kikhuh hen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pasal vang chu Pathen lim bangle aloupina ahi jeh chun lukhuh khuh lou dingdol mong ahi. Numei vang chu pasal loupina ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu pasal hi numeija kona ahipoi; numei joh hi pasal'a kona jo ahibouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujongle pasal hi numei dinga kisem ahipoi; numei bou pasal dinga kisemjoh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuti ahi jeh chun vantil teho jala numei jin thaneina alua achin ding dol thu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin Pakaiyah pasal beijin numei aumpon, numei beijin pasal aumpoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pasal'a kona numei ahi banga chu numeija kona pasal uma ahi; ahivangin thil jouse Pathen'a kon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nalungin gelunlang ngaitouvin, numei jin lukhuh khuh louva Pathen henga atao hi kilomnam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pasal'in asam akihoisaova ahile, ama dingin minah sahmo aume, ti hi chonna ngaimong jongin nahil lou uham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Numei vang asam asaole ama dingin hichu aloupina ahi; ajehchu asam chu akhu dinga kipe-a ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin anela aumle, eihon hitobang dan mong chu ineipouve; Pathen houbung miten jong aneipoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amavang hiche thu kahilchah naova hin kapahcha pouve; nangho phatcheh nadinga kikhomji nahipouvin setna cheh joh dinga kikhomji nahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu amasa penin, nangho houbung'a nahung kikhop tengule, nalah uva loitum tumin nakikhen jiuve ti kajan, chule tah jong katahsan thim thime.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nalah uva mikitahtah ho ahung kiphondoh theina dinga, ginchat chom chom nei jong umding mong ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuti ahi jeh chun nangho mun khatna nakikhop tengule, Pakai jan anjon nehna hoi ahijipoi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Amikipmin adang neh masangin ajan an akineh masahjiuvin, chule khat gilkelin aumin, khat ju akhamjin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanehna dingule nadonna dingu na-in'u um louham? Ole Pathen houbung chu nahsahmo-a bola chule ima neiloute chu jachatsah nahiuvem? Ipi kaseipeh ding nahiuvem? Hiche thua hin nangho pahchau vingem? Pahcha pong kate.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakaiya kona kalah nangho kapehsonu thuhil chu hiche ahi, Pakai Jesu amatsah ding jan-u chun, hiche janlele chun aman changlhah alan,
  </para>
  <para style="p">
    <verse number="24" style="v" />Athangvah jouvin ahehbal balin, kilah-un, neuvin, Hiche hi katahsa nangho dinga kihehbal chu ahi; keima neigeldoh jingna dingun hichehi bolun, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutima chun, a-anneh jouvun khon jong chu alan, Hiche khon hi kathisana kitepna thah ahi; nanghon nadon chanuva keima neigeldoh na dingun bolun, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu hiche changlhah naneh uva, hiche khona nadon lai chanuva, ahung kit kahse-a Pakai thina chu naphondoh jingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun koi hile anehoi hilouva changlhah chu ne-a ahim, khona chu dona ahim chu, ama chu Pakai tahsale athisana themmo chang ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amavang mi ama kikholtoh chehhen, chule changlhah chu nehen, khona jong chun donhen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuche Pakai tahsa chu geltoh lou hella, chule lomlou hella ne-a donna chun, oimo achana dinga adonna, aneh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche jeh chu ahi, nalah uva mi tamtah lhasama chule veise-a ahin, chule nena nen a-imumil tapouve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Eimale eima kikholtoh cheh vangleu hen oimo ichan lou dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Oimo ichan tengule, vannoi toh themmo ichantha louna dingun, Pakaiya konin engbolin iumjiuve,
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiche jeh chun, kasopite, ane dinga nahung kikhop tengule khatle khat kingah kimun.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nahung kikhopnau chu oimo-a aum louna dingin, khattou agilkela aumle a-in'a hin nehen. Adang chengse vang kahung tengle sujang soh nange.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule, sopite, lhagaolam thilpeh thuho chu nahet lou dingu kanompoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chidang namdang nahi laiju chun, puilea naumna chanuva milim pao theilou anga chu puimanga na-umjiu ahin, hichu naheuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche jeh chun nangho kahetsah nahiuve, Pathen Lhagao thuseija chun koiman Jesu chu sapset chang ahi, atipoi, chule Lhagao Thenga kon louvin, koiman, Jesu chu Pakai, ati theipoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thilpeh chan gotchom chom tamtah ahi, ahivangin Lhagao khatsehbou ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule lhacha gotchom chom tamtah ahin, ahivangin Pakai khatsehbou ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule natoh gotchom chom aumin, ahivangin ijakaija ijakai bola chu Pathen khat jengbou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin mijousen aphattoupina dinga, mi khatcheh chu Lhagao phondohna khat cheh kipe-a ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh-inem itile Lhagaova kona mikhat chu chihna thu kipe-a, chuche Lhagao mama-a chu khat hetnanei thu kipe-a ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />hiche Lhagaoma-a chu khat tahsan kipe-a; chule chuche Lhagaoma-a chu achom khat mi damsah theina thilpeh kipe-a;
  </para>
  <para style="p">
    <verse number="10" style="v" />Achom khat bolmo kidang bol theina kipe-a; chule achom khat lhagao thusei dohna; chule achom khat Lhagaoho hetkhen theina; chule achom dang khat paotin paotang tho theina; chule achom dang khat pao ledoh theina kipe-a ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin hicheng na kitong jouse chu, Lhagao khatmama chun abolsah ahi; aman ama lunglam dola achom choma miho khat khatna ahoppeh cheh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tipum khatseh ahin, tibah tamtah ahi, tipum khatna tibah tamtah aum vangin, tipum khatbou ahi; Christa jong chutobang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu eiho Juda mi ahin, Greek mi hijongle, soh hihen, chamlhat hi jongle, ibon chaova tipum khat ihi theina dinguva, ibon chaova tahsapum khat sunga umdinga Lhagao khatna iki baptize-u ahi; chule ibon chaova Lhagao khat eiki don khom sah-u ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu tipum hi ti khatseh ahipoi, bah tamtah ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kengphang hin, Keima khut kahi lou jeh-in tipuma kahipoi, tile hiche jeh-a chu tipuma hida dingham?
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule bilkol jong hin, Keima mit kahi lou jeh-in tipuma kahipoi, tile hiche jeh-a chu tipuma hida ding ham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Tipumpi abonchan mit hisohkei tale, hoija khojahna umta dingham? Tipumpi khojahna hisohkeile hoija gimnam jahna umta dingham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla Pathen'in tibah chengse hi, alung deilam cheh-a tipuma akoi ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule aboncha hin tibah khatseh hitale, tipum hoija umtantem?
  </para>
  <para style="p">
    <verse number="20" style="v" />Tun vang tibah tamtah, ahivangin tipum khatsehbou ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule mit hin khut jah-a, Imacha kangaichatna na-umpoi, ti theilou ahi; luchangin jong kengteni jah-a, Imacha kangaichatna naum lhonpoi, ti thei lou ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Titah sangin, tibah hatmoa kigel chengse hi, akhohpena pang cheh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nahsahmo-a igelu tibah ho chengse hi gamchengin ijabolun; chule itibah hoilouho chengse hi gamchengin ahoijoji tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule itibah hoiho chengseu hin hicheng chu angaipoi, ahinla Pathen'in tipum hi asuhto khoma alhing lou alhasama chu gamchenga jabola aumsah ahi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Hitia chu tipum sunga hi akitumkhen um louhela, kitumkhen tah sanga tibah ho chengse hi thakhat tah-a akikhohsah to sohkei dingjoh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutia chu tibah khatnin athohgima ahile, tibah dang chengsen jong athoh gimpi jiu ahi; chule tibah khat choi-at achanle, tibah dang chengsen akipapi jiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangho Christa tipum nahiuvin, mi khat khat chu atibah khat cheh nahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Pathen'in houbung-ah amasatah-a solchah ho, anina themgaoho, athumna thuhil ho, abana bolmo kidang bolthei, chua mi damsah theina thilpeh, kithopina, vaipohna, chule paochom paochom thona apeh ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aboncha solchah hiuvam? Aboncha themgao hiuvam? Aboncha thuhil hiuvam? Aboncha bolmo kidang bola hiuvam?
  </para>
  <para style="p">
    <verse number="30" style="v" />Abonchauva midamsah thilpeh chang hiuvam? Abonchauva paochom tho hiuvam? Abonchauva pao hilchena pang uvam?
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahin thilpeh pha chungnung deho chana dingin kihabolun. Chule akalvala pha chungnung lampi kavetsah ding nahiuve.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiman mihemho paole vantil ho paovin thu sei jeng jongleng, ngailutna kanei loule, sum-eng kivogingle khutbeh kibeng bangbou kahi ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lhagao thu seidoh theina thilpeh neijingting, thugil jouse hettohna le hetna jouse nei jongleng, chule mol tolmang theina tahsan nei jongleng, ngailutna kanei loule imacha kahilou ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule mivaicha gentheiho vahna dingin kanei jouse toh jeng jongleng, govam jeng dingin katahsa pumpi toh jeng jongleng, ngailutna kanei loule imacha phatchomna aumpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngailutna hin ni sottah athohjin, he jong ahepin ahi; ngailutna hin thangset abolpoi; ngailutna hin kichang vahchoi abolpoi, hoi jong ahoithopoi,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nunset abolpoi, amachang phatchomna abolpoi, alungsa baipoi, setna agelpoi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chonsetna kipah louhelin thutah akipapiji;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ima jouse-a athoh hatnin, imajouse atahsanin, imajousea akinemin, imajouse athoh hatjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngailutna hi imatih chana mangthah lou ding ahi; lhagao thu seidoh vang chu mangthah ding ahi; paochom het jong chu mang ding ahi; hetthemna jong chu mang ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijeh-inem itile eihon kim louva ihetnu ahin, kim louma lhagao thu iseidohjiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abulhing chamkim ahung tengle, akim lou chengse hi kisubeisoh ding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kachapan laijin chapang paovin kapaojin, chapang lunggelin kageljin, chapang thu ngaiton kangaiton ahi; kakhanlhit phat vangin chapang thu jouse chu kapailhatai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijeh-inem itile tu-a hi eihon phatvet sunga kichen louva imu-u ahi; chuteng vangle kimaito-a imu dingu ahi. Tunvang kahet akimpoi, chuteng vangle eihet kimsoh banga hi kahet kimsoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tun tahsan, kinep, ngailut hicheng thum hi aumin; ahin hicheng lah-a hin ngailut achungnung pene.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngailut chu delun; ahin lhagaolam thilpehho chengse chan ding ponpanun, adeh setnin lhagao thu naseidoh theina dingun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Paochom dangkhat tho-a thuseija chu mi jah-a seidoh hilouva, Pathen jah-a seijoh ahi; ajeh chu koiman ahetpehpoi, ahinla aman lhagaova thugil chengse chu asei ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lhagao thu seidoh vang chun miho khan tousah nale, tilkhouna, chule lungmon sahna thu asei ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Paochom dangkhat tho-a thuseija vang chu ama changa khantouna-a anei ahi; lhagao thu seidoh vang chun houbung chu akhantou sah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon nabon chaovin paochomin thu seileu chun kalung ahi; ahivangin chusang jong chun lhagao thu seidohleu chun kalung ahijoi; chule paochom tho-a thuseija chun houbung khantou sahna dinga, athusei chu aledoh louva ahile, chusanga chu lhagao thu seidoh chu chungnungjo ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun, sopite, keiman naheng uvah hunging ting paochom hung tholeng; thu phondoh ahim, hetna ahim, lhagao thu seidoh ahim, thuhilna lam ahim, kasei loule ipi phatchomna nanei ding uham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Thil gingthei lah jenga jong kuli ahim, selangdah ahim, aginteng a-aw akikhel loule; kuli ahi, selangdah ahi kon ahetkhen dingham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahiloule sumkon gin akichet loule, koiham gal kon dinga kigothei dinga?
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutobangma chun nanghon mihet bai ding pao natho louvule, ipi naseiju ahi iti kihet dingham? Nangho huijah-a thu sei tobang nahiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ija kihem, vannoi'a hin paochom paochom tamtah aume, ahivangin ikhat kiseina hilou khatcha jong aumpoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuti ahijeh chun chuche pao chu ipi kiseina ahi kahet louva ahile, athusei ngaija keima chu ama dinga paomah kahiding, thuseipa jongchu keima dinga paomah tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuti chun nangho jong, lhagao thilpeh chan chom chom nei ding naha lunggulu ahin, hichu houbung in khantou na-a aneina dingin aletsetna nanei theina dingun holun.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche jeh chun paochom tho-a chun athu jong ale theina dingin taohen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Paochomin taoleng, kalhagao chu taova ahinan, ahinla kahetna hin ga aso jipon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti ahile apipen iham? Keima lhagaovin taovingting, hetna-a jong taovinge; lhagaovin jong la sangting hetna-in jong la sange.
  </para>
  <para style="p">
    <verse number="16" style="v" />Achuti loule nangman lhagaovin thangvahna seile chun, amuna tou ima he loulaiho chun nathang vahna chu, Amen, iti ati thei dingham? Nathusei chengla he louva?
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma vang chun phate tah-a thangvahna nanei ahin, ahivangin midang akhantou sahpoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangho nabonchao sanga paochoma thu kasei tamjoh jeh hin, Pathen kathangvah-e;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin houbung sunga midangho kahil theina dingin, paochoma thu cheng sangsom kasei sangin, hetna-a thu cheng nga seidoh ding kadeijoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sopite, nangho hetna-a chapang hihih-un; amavang nunsetna lama chapang hiuvinlang, hetna lama pilhingun.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dan lekhabua hitin akisune, keiman hetphah lou paochom thohole gamdang miho kama, hiche mite jah-a hi thu kasei ding ahi, hiti chun bol jongleng amahon kathu angaideh lou dingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche jeh chun paochom tho hi atahsan dinga hilouvin, atahsan louho dinga melchihna ahi; lhagao thu seidoh ho vang chu atahsan louho dinga hilouvin, atahsanho dinga melchihna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche jeh chun houbung chengse kikhom henlang, chule ami takipmin paochom thohen, chu-a chun mi maimaile tahsanna neilouho khattou hung lutle, Nangho chu angola ahi, ati lou dinguham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Amavang nabonchaovin lhagao thu seidoh sohkeileu chun, atahsanlou ahim, milham ima helou khattou hung lutle, hichengpi chun asetna sosal intin, hichengpi chun oimo achan ding;
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule chutia chun alunggila thuguh jouse chu kiphong doh sohkei ding; chule chutia chu akhupbo-a lhu-a Pathen ahou ding, nangho lah-a Pathen aum chu aphonjal ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Achutile, sopite, iti danham? Nangho nakikhop tengule khat cheh-in la ahim, thuhil ahim, thuphondoh khat ahim, paochom tho ahim, chule khatnin athu aledoh ding nanei chehjiove. Hitiho jouse chu khantouna dinga kibol hihen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khattouvin paochoma thu aseija ahile, ni hijongle atampena thumin, kilhah lhah-in seijuhen, chule khatnin athu ledoh hen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Athu ledoh ding aum lou vangle, ama chu houbung'a thipbeh chan umhen, ama chang jahle Pathen jah ding maijin thu seihen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lhagao thu seidoh nile thumin thu seihen, chule adang chengse ngaitohen;
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin akoma touho khatpen pen henga thu kiphong aumle, amasapa chu umthim hen.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ijeh-inem itile mi jouse athep theina dingle mi jouse alungmon theina dinga, khatchenga kilha kilha-a lhagao thu naseidoh theiju ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Themgaoho lhagao chu themgaohobou thua nung ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ijeh-inem itile Pathen chu thunoh lungjin kona ahipoi, mithengte houbung ho jouse-a ahi banga, lungmon kona ahibouve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na numei hou chu houbung kikhop na-ah thipbeh chan umthim uhen; ijeh-inem itile amaho chu thusei kipe-a ahipouve, chusang chun danthua kisei bangin, thu noija umuhen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amahon ikhat het nom aneijule, a-inmun uvah ajite cheh kidoh uhen, ajeh chu houbung kikhopna-a numei dinga thusei hi jachat umtah ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Iham? Pathen thuhi nangho-a kona hung sohdoh ham? Ahiloule nangho changseh heng jengabou hungaham?
  </para>
  <para style="p">
    <verse number="37" style="v" />Khattou ama themgaova akingaitoa ahiloule lhagao mi-a kingaito aumle, naheng uva kalekhasut chengse chu Pakai thupeh ahi ti hehen.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amavang khattouvin ahet loutah-a ahile, ahe louvin um jenghen.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hiche jeh chun, kasopite, Pathen lhagao thu seidoh guttenin ponpanun, paochoma thusei jong kham hih-un.
  </para>
  <para style="p">
    <verse number="40" style="v" />Amavang imajouse hoitahle kituptah-in bolcheh-un.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo sopite, kahetsah nahiuve, najah uva kalhangsap Kipana Thupha chu san jong nasanu ahitan, chujongle hia chu nadinu ahitai;
  </para>
  <para style="p">
    <verse number="2" style="v" />Najah uva kathu lhangsap chu nachin jingule, hichea chu huhhing-a um nahitaove; chuti ahi lou vangle natahsanu chu moh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu amasapena Pathen lekhabu dungjuija eiho chonset jala Christa thia ahitai, ti thuhil pipen kamu chu nangho kapehdoh ahitai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ama avuijun, ani thumnin Pathen lekhabua kisei dungjuijin athoudoh kittan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ama Cephas henga akilah masapenin, chuin somleni ho henga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin mi janga valjen sopiteho henga khatvei lah-in akilah-in ahi; amaho atamjo tu gei hin aum nalaijui, akimkhat vang a-imu taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jacob henga akilah-in, chujouvin solchah ho chengse henga akilah-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akhonna-in aphat louva peng tobang keima henga ahung kilah-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keima solchah ho lah-a alhumpen kahin, chule Pathen houbung kabolset jeh chun solchah min pu dinga jong kilom kahipoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin Pathen lungset vangin kahibep chu kahinai; chule ama lungsetna eitona chu moh-in aumpoi, amaho chengse sangin katong gim jon ahi; ahivangin keima kahipoi eiumpia, Pathen lungsetna chu ahibouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla keima kahin, amaho ahiuvin, hitia chu thupha chu samphong cheh kahiuvin, nanghon chutia chu natahsanu ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin tu-a, Christa chu athi lah-a konin kaithouvin aumtai tia kilhangsama ahile, nalah uva mi kimkhat chun, athi thokit himhim aumpoi, iti nati uham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Athi thokitna himhim aum loule, Christa jong chu kaithouva umlou hinte;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Christa chu kaithouva umlou ahile, kathu hil lhangleu jong hi moh ahin, natahsanu jong moh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mithi thokitna umlou ahileh, keiho hi Pathen lama jouthu hettohsah-in kakilangui; ajehchu keihon Pathen'in akaithoulou Christa chu akaithouve tin, kahettoh sah-un ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ijeh-inem itile mithi thoukit lou ahile, Christa jong chu thoukitlou ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Christa chu thoukit lou ahile, nanghon natahsanu jong moh ahi; nangho tu-a jong chonsetna umjing nalai nahi dingu ahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuti chu ahile Christa-a imu milteho chu amangthahgam ahitaove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tu hinlai sung ding jenga Christa chu kinepna ineiju ahile, mi jouse sanga khoto umpentah ihi dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin tun Christa chu a-imuho lah-a aga masapenin apangin, athiho lah-a konin athoudoh tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihem'a kona thina aum jeh chun, Mihem'a kon maman thokitna aumtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ijeh-inem itile Adam'a mi jouse athi banga chu, Christa-a mi jouse hinsah-a umding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahivangin, mijouse ama phatdol cheh-a umding ahi, Christa agamasa hintin, chu joule Christa ahung teng amite hidiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujoutah chule kichai ding ahi; chutengle aman vaipoh, thuneina, thahatna jouse asuhmang sohkeija, Pa Pathen khutna gam apehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman agalte jouse akengto noija akoi masangse-a, aman vai apoh ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Gal nukhah pen thina ahi, hi jong chu asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajeh chu aman, imajouse akengto noija akoi ahitai. Ahin, imajouse athu noijah akoije, atia hin, athu noija koipa chu chucheho lah-a chu kisimthalou ahi, ti kichenin akilange.
  </para>
  <para style="p">
    <verse number="28" style="v" />Imajouse ama thu noija aum phat chule, Pathen chu ijakaija ijakai ahi theina dinga, ijakai athu noija umsahpa thu noija chu Chapa jong umding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutobang chu ahiloule athiho dinga baptize changho iti taovintem? Athiho kaithouva aum louhel uva ahile, chuteho chu amaho dinga ibola baptize changji hiuvintem?
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule keiho jeng jong ibola nidan takipma settoh-a kaum jinguham?
  </para>
  <para style="p">
    <verse number="31" style="v" />Sopite, Pakai Jesu Christa-a nangho chungchanga kakisonna kapatna kanela kasei ahi, keima niseh-in kathi jinge.
  </para>
  <para style="p">
    <verse number="32" style="v" />Keiman mihem ngai banga Ephesia gamsaho toh kisat kahile, phat chomna-a kanei dingham? Athiho kaithouva aum loule, hungun, neuhite donuhite; jingle kithita dingan.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lheplhah-in um hih-un: kivoppi phalouvin mi nunphat asusen ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chonphatna lama khangun lang, chonse hih-un; ijeh-inem itile abang khat Pathen hetna nei lou ahi. Hiche hi jahcha naovin nate tia kasei ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahin mi khat touvin, Athiho kaithouva iti umham? Itobang tahsa vou po-a hungji aham, tinte.
  </para>
  <para style="p">
    <verse number="36" style="v" />Vo lungthimbei, nangman muchi natu chu athi loule akehpoi;
  </para>
  <para style="p">
    <verse number="37" style="v" />Khonunga akung abah ahung umding chu nangma tu ahipoi; kolbu hihen, chang dang hijongle, nangman achangbou natu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pathen'in alung chama tahsa apeh ahibouve; achang takip chu ama dol cheh tahsa apehji ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Amavang sa jouse akithakhat poi, mi-a hihen, sa-a hijongle, vachale nga-a hijongle, got chomcheh ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Van vou aumin, leiset vou jong aume; ahivangin van tipum loupina achom ahin, leiset vou loupina achom ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nisa loupina achom ahin, lhathah loupina achom ahi; chule ahsi loupina jong achom ahi, ahsi le ahsi jong aloupina achom chom ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chutobangma chu athiho thokit jong hi ding ahi. Monmang theija kitu-a ahin, monmang thei louva kikaithou ahi;
  </para>
  <para style="p">
    <verse number="43" style="v" />Manmo-a kitu-a ahin, loupia kikaithou ahi, hatmoa kitu-a ahin, thahat tah-a kikaithou ahi;
  </para>
  <para style="p">
    <verse number="44" style="v" />Tahsa vou kitu-a ahin, lhagao vou kikaithou ahi. Tahsa vou uma, lhagao vou jong uma ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule hitihin akisune, mi masa Adam chu mi hing anahi; Adam nunung joh vang chu hinna pe-a lhagao ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ahivangin lhagao lam chu amasajopoi, mihing joh chubou aum masai; chujouvin bou lhagao lam chu aume.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mihem masa chu leija kisem leija kon ahin, mihem nina vang chu van'a hungkon Pakai ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Leija kisem mite jong hi leija kisem mipa chutoh bang cheh ahi; van mite chu van'a Pa tobang cheh ahiuve.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule leija kisempa lim ilo banguva chu, van'a Pa lim jong ilo dingu ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahivangin, sopite, Tahsale thisan hin Pathen lenggam alo theipoi, monmang thei hin monmang thei lou chu alo theipoi, tia kasei ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Veuvin, keiman nangho thugil khat kaseipeh nahiuve, ibon chaova ina-imut lou dingu ahi;
  </para>
  <para style="p">
    <verse number="52" style="v" />Ahinla sumkon gin nunung pena chu, hai khat sunga, mitphet kah louva, ibon chaova ikikhel sohkei dingu ahi; ajeh chu sumkon hung ging ding, chule athiho chu monmang thei louva kaithouva umding, chule eiho ikikhel dingu ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ijeh-inem itile hiche monmang thei hin monmang thei lou chu akivona, thi thei hin thi thei lou chu akivon ding ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chutia chu monmang theijin monmang thei lou chu akivona, thi theijin thi thei lou chu akivon tengtah chule, jona-in thina chu aval lhumtai, tia kisun thu chu guilhung ding ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Vo thina, namidena hoiham? Vo lhankhuh, na jona hoiham?
  </para>
  <para style="p">
    <verse number="56" style="v" />Thina mide-na chu chonset ahi, chonset thaneina chu dan thupeh ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Ahinla I-Pakaiyu Jesu Christa vanga jona eipeuva Pathen chu thangvah-in umhen.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hijeh chun, sopi deitahte, dettah-in suhlong hoi hilouhelin pangun, gunchu tah-in Pakai na tong jingun; natohgimnao chu Pakaiya moh ahipoi ti naheuve.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule mithengte dinga tolom thudol vang chu, Galatia houbung ho thu kapeh bang chun, nanghon jong bolun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule kahung teng tolom donna aumlouna dingin, hapta nimasa ni leh Pathen'in phatthei aboh dungjuijin, amitakipmin atojoukham chehi-in dong khomun, anakhol khomun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima kahung phatle, koihijeng jongle pha nasah penpenu chu nathilpeh hou gathah dingin, nalekha thot utoh Jerusalem'ah solnange.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima chea alom jongle, amaho chu keitoh lhonnao vinge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Macedonia kachotsoh phatle, naheng uva hung ding kahi; ajeh chu Macedonia gam chonle ding kigo-a kahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kachena channa neithah le thei na diuva naheng uva phat chomkhat kacham ding, ijem itile phalbi sungse-a bon kacham den ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu chunga palama kimuto kanompoi; Pakai phatsah ahile, nangho koma chomkhat chamleng ti kakineme.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin Pentecost geijin Ephesia kho-a hin chaming kate.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu kadingin kot lentah toh machal theina tah akihonge, chule eidouva atame.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Timothy chu ahunga ahile, kicha louhela nalah uva aum theina ding ana ngaito uvin; ajeh chu ama keima toh bang banga Pakai na tonga ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun koiman nahsahmon bol hihhen. Kaheng ahung lhun theina dingin, achena-a lungmonga avalena dingin thahleuvin; ijeh-inem itile sopite toh ahungna ding lam kat jinga um kahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule sopi Apollos thu vang chu, sopite toh kilhona naheng uva hung dinga katem jing ahi; ahin tupettah-a hung ding vang anompoi, ahivangin ahung thei phat phatle hung ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kihongun, tahsanna-a dingdet jingun, pasal pha bangtah-in pangun hatnun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nabol jouseu chu ngailutna-a kibol hihen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sopiteho, Stephanas inkote sung hi Achaia gama Pathen thua ga masapen ahiuvin, mithengte jennan akipeuvin ahi, ti naheuve;
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho jong hitobangho le keiho natoh huna-a tong gimho chengse thu noija umun, tia naheng uva katao ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Stephanas, Fortunatus, chule Achaicus teho hilama ahungu hi kakipah lheh jenge; ajeh chu amahon nangho lhinlelna chu asubulhit taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amahon keima lung jong, nangho lung jong akidosah ahi. Hitobang mite hi hethemuvin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Asia gama houbung hon salam naboh-ui, Aquila le Priscilla le a-in lhona kikhom chengsen Pakaiya salam tamtah naboh-uve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sopite jousen Salam naboh-uve. Kichop thengin khat le khat kisalam to cheh-un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kasalam bohna hiche hi keima Paul'in kakhut tah-a kasut ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khattou Pakai Jesu Christa ngailu lou aumle, ama chu Anathema hihen, Maranatha .
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakai Jesu Christa lungsetna chun umpiuvin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu Christa-a kangailut nao chu nabon chaova chunga umhen. Amen.
  </para>
</usx>
