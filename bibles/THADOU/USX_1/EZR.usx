<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EZR" style="id">Ezra</book>
  <para style="h">Ezra</para>
  <para style="toc1">Ezra</para>
  <para style="toc2">Ezra</para>
  <para style="mt">Ezra</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Persia lengpa Cyrus lengchan kum khat alhinin, Jeremiah kama Pakaiyin athumopsa chu aguilhun theina dingin, Persia leng Cyrus lung chu Pakaiyin achoh thouvin ahi. Chule jihtho-a koidingin aseijin alenggam pumpi-a thu aphongdoh tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Persia leng Cyrus chun hitin aseije, leiset lenggam jouse chu keima khutna van Pakai Pathen'in phatthei eiboh-in eipen; chule aman Judah gam Jerusalem'a a-in sadingin thu eipetai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho amite jouse lah-a koi umam? ama chu a-Pathen'in umpihen, chule Judah gam Jerusalem'a chetou henlang, Pakai Israel Pathen (ama chu Pathen ahi) in chu gasahen, hichu Jerusalem'a um ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule apemna mun'a chengdena koi hijongle aumna muncheh-a chun lungcham thilpeh tilouvin; dangka-in, sana-in, thil lelo-in, gancha-in Jerusalem'a Pathen in sahna dingin kithopiu hen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin Judah le Benjamin phunga apateo lah-a alamkaiho, thempuho, chule Levi ho, Jerusalem'a um Pakai in sadinga chetou dinga Pathen lhagaovin alung asuhthouho chutoh akipatdoh taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho chu akimveluva umho chun lungcham thilpeh-a apeh-u tilouvin, dangka umle belho, sana, thil le loho, ganchaho chule thillu tahtah ho apeuvin, atha hatsah-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Cyrus lengpan jong Nebuchadnezzar'in Jerusalem'a kona anapoh-a, a-pathen in'a anakoi, Pakai in'a umle belho chu ahinpodoh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitihohi Persia leng Cyrus chun neichingpa Mithredath alahdohsah-in, chule ajat asimun, Judah gama vaipipo Sheshbazzar khutna apetai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitiho asimdoh-u chu: sana kong somthum, dangka thih-a kisem kong sangkhat, chemcha somni le ko ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sana khondal somthum, dangka khondal jatchom jali le som, chule um le bel adang sangkhat toh,
  </para>
  <para style="p">
    <verse number="11" style="v" />Um le bel sana le dangka-a kisem chu aboncha sanga le jali ahi. Sohchangho Babylon'a kona Jerusalem'a ahintoltou laichun, hitiho jouse jonghi Sheshbazaar in ahintolthan ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Babylon lengpa Nebuchadnezzar'in gal-hinga Babylon'a anakai mangho, asoh channao gama kona Jerusalem le Judah, ama ama khopi cheh-a hung kilekit ho chu ahiuvin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Hitehohi Zerubbabel, Jeshua, Nehemiah, Seraiah, Reelaiah, Mordecai, Bilshan, Mispar, Bigvai, Rehum, Baanah toh hungkilhon Israel mitejat chu ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Parosh chilhah chu sangni le jakhat toh somsagi le ni ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shephatiah chilhah chu jathum le somsagi le ni ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Arah chilhah chu jasagi le somsagi le nga ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pahath-moab chilhah lah-a Jeshua le Joab chate chu sangni le jagetle somleni ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Elam chilhah chu sangkhat le jani leh somnga le li ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zattu chilhah chu jakole somli le nga ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zaccai chilhah chu jasagi le somgup ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bani chilhah chu jaguple somni le thum ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bebai chilhah chu jaguple somni le thum ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Azgad chilhah chu sangkhat le jani leh somnileni ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Adonikam chilhah chu jaguple somgup le gup ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bigvai chilhah chu sangni le somnga le gup ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Adin chilhah chu jali leh somnga le li ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ater son lah-a Hezekiah son hochu somko leh get ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bezai chilhah chu jathum le somni le thum ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jorah chilhah chu jakhatle somleni ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hashum chilhah chu jani leh somni le thum ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gibbar chilhah chu somko le nga ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bethlehem chilhah chu jakhatle somni le thum ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Netophah mite somnga le gup ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anathoth mite jale somni le get ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Azmaveth chilhah chu somlileni ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kirjath-arim, Chephirah le Beeroth chilhah chu jasagi le somli le thum ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ramah le Geba chilhah chu jaguple somni le khat ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Michmas mite jakhat somnileni ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bethel le Ai mite jani leh somni le thum ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nebo chilhah chu somnga le ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Magbish chilhah chu jakhatle somnga le gup ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Michom Elam chilhah chu sangkhat le jani leh somnga le li ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Harim chilhah chu jathum le somni ahiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lod chilhah, Hadid le Ono chilhah chu jasagi le somni le nga ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jericho chilhah chu jathum le somli le nga ahiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Senaah chilhah chu sangthum le jaguple somthum ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Thempuho: Jeshua insung mi Jedaiah chilhah chu jakole somsagi le thum ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Immer chilhah chu sangkhat le somnga le ni ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pashhur chilhah chu sangkhat le jani leh somli le sagi ahiuve.
  </para>
  <para style="p">
    <verse number="39" style="v" />Harim chilhah chu sangkhat le somlesagi ahiuvin,
  </para>
  <para style="p">
    <verse number="40" style="v" />Levi ho: Jeshua chule Kadmiel Hodaviah chilhah chu somsagi le li ahiuve.
  </para>
  <para style="p">
    <verse number="41" style="v" />La saho: Asaph chilhah jakhatle somni le get ahiuvin,
  </para>
  <para style="p">
    <verse number="42" style="v" />Kotngah ho chilhah: Shallum chilhah Ater chilhah Talmon chilhah, Akkub chilhah Hatita chilhah Shobai chilhah abonchauvin jakhatle somthumle ko ahiuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nethinim ho: Ziha chilhah Hasupha chilhah Tabbaoth chilhah,
  </para>
  <para style="p">
    <verse number="44" style="v" />Keros chilhah, Siaha chilhah, Padon chilhah,
  </para>
  <para style="p">
    <verse number="45" style="v" />Lebanah chilhah, Hagabah chilhah, Akkub chilhah,
  </para>
  <para style="p">
    <verse number="46" style="v" />Hagab chilhah, Shamlai chilhah, Hanan chilhah,
  </para>
  <para style="p">
    <verse number="47" style="v" />Giddel chilhah, Gahar chilhah, Reaiah chilhah,
  </para>
  <para style="p">
    <verse number="48" style="v" />Rezin chilhah, Nekoda chilhah, Gazzam chilhah,
  </para>
  <para style="p">
    <verse number="49" style="v" />Uzza chilhah, Paseah chilhah, Besai chilhah,
  </para>
  <para style="p">
    <verse number="50" style="v" />Asnah chilhah, Mehunim chilhah, Nephisim chilhah,
  </para>
  <para style="p">
    <verse number="51" style="v" />Bakbuk chilhah, Hakupha chilhah, Harhur chilhah,
  </para>
  <para style="p">
    <verse number="52" style="v" />Bazluth chilhah, Mehida chilhah, Harsha chilhah,
  </para>
  <para style="p">
    <verse number="53" style="v" />Barkos chilhah, Sisera chilhah, Thamah chilhah,
  </para>
  <para style="p">
    <verse number="54" style="v" />Neziah chilhah, Hatipha chilhah.
  </para>
  <para style="p">
    <verse number="55" style="v" />Solomon soh ho chilhah: Sotai chilhah, Sophereth chilhah, Peruda chilhah,
  </para>
  <para style="p">
    <verse number="56" style="v" />Jaalah chilhah, Darkon chilhah, Giddel chilhah,
  </para>
  <para style="p">
    <verse number="57" style="v" />Shephatiah chilhah, Hattil chilhah, Pochereth, Zebaim chilhah, Ami chilhah.
  </para>
  <para style="p">
    <verse number="58" style="v" />Nethinim jousele Solomon soh ho chilhah chu abonchauvin jathum le somko le ni ahiuve.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chule hitehohi Tel-melah, Tel-harsha, Cherub, Addan chule Immer akon chetou ahiuvin ahin amahon apu apau insung Israel mimong mong ahinao avetsahthei pouve.
  </para>
  <para style="p">
    <verse number="60" style="v" />Delaiah chilhah, Tobiah chilhah, Nekoda chilhah, chu jaguple somnga le ni ahiuve.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chule thempuho chilhah: Habaiah chilhah, Koz chilhah, Barzillai chilhah (Barzillai in Gileadite mitejin aneijin achilhah chu amin dungjuijin asah-in ahi).
  </para>
  <para style="p">
    <verse number="62" style="v" />Mi hichenghi phunggui thu kisut na-a chun aminu aholun, ahin amujou pouve. Hijeh chun amaho chu akisuboh tobang ahiuvin, athemputnao ahaisah taove.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chuin Tirshatha chun ahunguva Urim le Thummim kivon thempu khat chua adindoh kahsen amahon thilthengtah chu anehthei loudingu ahi tin aseije.
  </para>
  <para style="p">
    <verse number="64" style="v" />Mipi kikhomho jouse chu sangsomli sangni toh jathum le somgup ahiuve.
  </para>
  <para style="p">
    <verse number="65" style="v" />Asohteo pasal hole numei ho mi sangsagi le jathum le somthumle sagi simlouvin, lasaho pasal le numei jani aumun ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Asakolho chu jasagi le somthumle gup, sangan jani leh somli le nga ahin,
  </para>
  <para style="p">
    <verse number="67" style="v" />Asagonsangu jali leh somthumle nga, asanganu sangguple jasagi le somni ahi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Jerusalem'a Pakai in ahung lhunun, amun mama-a akisahdoh kitna dingin, phung lamkaiho phabep min kipehna thilto aneijun ahi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Ajokham cheh apeuvin, thilkholna-a akholdoh-u chu sana dram sangsomgup le sangkhat chule dangka sangnga le thempu von jakhat ahi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Hitichun thempuho le Levi ho chule mi phabep khat lasahile kotngah ho, chule Nethinim ho chule Israelte jouse akhopi cheh-a acheng taove.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin lhasagi ahunglhina, Israel chate khopiho-a aumlaijun, mipi ho chu mikhat bangin Jerusalem'a akikhom khommun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jozadak chapa Jeshua le asopi thempuho, chule Shealtiel chapa Jerubbabel le asopiho chu ading doh-un, Pathen mi Mosi dan thupeh-a kisun banga achunga govam thiltona ding Israel Pathen maicham chu asataove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amun mama-a chun maicham chu asemuve; ajeh chu chuche gamkaija miho jeh-a chun achunguva kichatna chu-a ahitai. Chua chun amahon Pakaiya dingin govam thilto atoh uvin, jingkah nilhah seh-in jong govam thilto atoh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anakisunsa bangin amahon Houbuh kut jong abollun, chule niseh-a bolding jat danthua kisun dungjuijin nisehle govam thilto chu atohjiovin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hiche nunghin govam thilto aboljompeh-un, lhathah ho chule akithenso Pakai kut ho jouse-a, Pakai dingin mitinin kiphal tah-in lungcham thilpehho chu atoh-un ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lha sagina nimasa ni-a patnin Pakai dinga govam thilto atoh panun ahi. Ahinla Pakai houin chu abul akiphutdoh hihlaijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Persia lengpa Cyrus'in apeh dung juijun, amahon songkheng hole thingthem bol hochu sum apeuvin, Lebanon'a pat Joppa twipi geijin Cedar thingho hinpo-a Sidon le Tyre miho chu anneh, twidon chule thao apeovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun Jerusalem'a Pathen In ahunglhunu kum nina, lhani na-in, Shealtiel chapa Zerubbabel le Jozak chapa Jeshua, chule asopite thempu dangho jouse le Levi ho, chule asoh channauva kona Jerusalem'a hungkileho chun natoh apanuvin, Levi ho kum somni-a lhah achunglamse chu Pakai in sahna-a mopo dingin apansah-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Jeshua chu achapate le asopite, Kadmiel le achapate, Judah chapate Pathen in'a natong dinga kisepdoh ho toh thakhatnin adingun, Henadad chapateleh asopite Levi chapate toh ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin insahon Pakai houin chu abul aphudoh phatnun, amahon thempuho chu sumkon leh von akivonsah-un, chule Asaph chapate Levi ho chun khutbeh akichoijun, Israel lengpa David houdan thupeh dungjuijin Pakai chu avahchoijun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon kilhang lhah-in vahchoina le thangvah nachu Pakaiya apeuvin: Ajehchu Pakai aphai, ijeh inem itileh ahepina a-imatih chanin Israel chunga aum jinge, tin asaovin ahi. Chule Pakai in abul akiphudoh tahjeh chun, mipi chun Pakai avahchoijun, awsang tah-in asamun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla thempu tamtah le Levi ho chule phunglah-a lubohho, milui tehse houin masa anamukha ho chun, amit mutah uva hiche Pakai in khom akiphu amutah-un, aw thong jejun akapmun, chule mitamtah kipah tah-in a-aosot sot jengun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun mipi chun kipana jeh-a awgin leh mipi ka awgin chu ahekhenthem tapouve. Ajeh chu mipi chu thong jejun a-aovun, aw gin kithong chu gamlatah-a akijan ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Judah le Benjamin mite kidoupihon, gal hinga kikaihon Israel Pakai Pathen houin ding asauve ti ajahphat uvin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Amaho Zerubbabel leh pate lamkaiho henga ahungun, ajah uva, keihon nasah khompiu vinge; ajehchu nangho bol bangin, keihon jong na Pathen'u kahol ui; chule hichan geija eihinpui toupao Assyria leng Esarhaddon nikho-a pat ama henga chu ganlhaina kana pehjiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahivangin Zerubbabel le Jeshua chule Israel lah-a pate lamkai dangho chun ajah uvah hitin aseijun, Ka Pathen'u in kisahna-a hin nangho ima nakikum nadiu aumpoi; ahinla Persia leng Cyrus'in thu eipeh banguva keihotah in Israel Pathen in kasahpeh dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuphatnin chuche gama miho chun Judah mipi khut tha chu ahatmosah-un, a-insah-u chu asunohphah taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Persia leng Cyrus nikholai sungsele, Persia leng Darius vaihom chan geijin, athilgonnu sunoh dingin amaho dounan thumopthem ho athalah-un ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Ahasuerus leng vaipoh kipattil lamin, amahon Judah gamsungle Jerusalem'a chengho hehna lekha asunuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Artaxerxes nikho laijin Bishlam, Mithredath, Tabeel chule akiloipi dangho Persia leng Artaxerxes henga lekha ajih-un; chule lekhathot chu Syria paova kisun ahin, Syria paova kiledoh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vaipo pipui Rehum le danthu sunpa Shimshai'in Jerusalem douna-in Artaxerxes lengpa henga hitobanghin lekhathot asun lhonin:
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin vaipo pipu Rehum, danthu sunpa Shimshai, chule akiloipi dangho: Dina mite, Apharsath mite, Tarpel mite, Apharsith mite, Archevite mite, Babylon mite, Susan mite, Dehavi mite, chule Elam mite,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule ginle ja umtah Asnapper'in ahinpuidoh-a, chuche phat laija Samaria gamsung achensahho leh luigallam gamdanga cheng adang chengsen, hitihin asunun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Alekha thotnu chu hiche hi ahi: Artaxerxes lengpa henga, luigal langkhatna chengho leh adang dangho-a kon nalhacha tehon:
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangma-a kona Judah mi hungkitol dohho chu kahenguva Jerusalem'a ahungun, amahon baotamna le phaloutah khopi asauvin, abangho atungdoh-un, chule abulhochu asuto taove tihi lengpan anahe tan.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche khopihi akisah phatna, chule abangho akitundoh kitna ahile, amahon gam man, thilpoh man, lamlen man ho apehlou dingu ahitan, chule hitia chu lengho sum mun'a asuhset dingu ahi, tihi tun lengpan anahe tan.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu keiho leng inpia kona kivah kahi jalun, lengpa kijabol louna mu hi keiho dinga vet thada umtah ahin, hijeh-a chu keihon hiche thuhi lengpa kahin hetsah-u ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Napu napate thuchin lekhabua chun kiholhen; chutile thuchin lekhabua kona chu, hiche khopihi kiphinna khopi, lengho le agamkaiho dinga kisuhkhah nathei, chule phat masa-a patna ana kiphin jing ahi jeh-a hiche khopi chu kisumanga anahi, ti namudoh-a nahetdoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche khopihi akisahphat kitna, chule abang akitundoh kitleh, hichejeh-a hi hilam pang vadung gal sese-a hi nangman chanvou nanei louhel ding ahi, ti lengpa kahin hetsah-u ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuphatnin lengpan adonbutna alethot nin: Vaipo pipu Rehum le danthu sunpa Shimshai, chule Samaria'a cheng akiloikhompi dangho le vadung lama chengho henga chun, chamna umhen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahenguva nahin thotnu lekha chu, kamasanga kichentah-in akisim doh-e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule thu lhahna kapen, aki khol toh-in; hiche khopihi masanga patna lengho douna-a thunoh baotam boljing, asungah kiphinna le kiphin dinga mijollhahna ana umjing ahi, ti mudoh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jerusalem'a hin leng thahat tahtah ana umin, amaho chu vadung gal gamjousea jong vai anahom uvin, chule amaho henga chun gam man, thilpoh man, lamlen man anapeuvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tun hiche miho chun anatoh-u angahna diu le keiman thupeh dang kanei kit masangse-a khopi chu akisah kit louna dingin nanghon thu peuvin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichehi boldoh louva aumlouna dingin tun nangho chingtheijun; ipidinga lengho setnading kiboldoh becheh ding ham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Tun Artaxerxes lengpa lekhathot chu Rehum le danthu sunpa shimahai le akiloipiho masanga asimjouvun, kinotah in Jerusalem'a Judah te henga acheuvin, thuneitah le thahatsanin anatoh-u chu angahsah taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuphatnin Jerusalem'a Pathen Houin kisa chu atang tan ahi. Hitichun Persia leng Darius vaihom kum ni lhinna geijin atangdel tan ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuchephat laichun Themgaoho, Haggai Themgao le Iddo chapa Zakariah'in, Judah le Jerusalem'a chengho Judah te henga Israel Pathen minin gaothu asei lhonin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin Shealtiel chapa Zerubbabel leh Jozadok chapa Jeshua chu Jerusalem'a Pathen in chu sadingin akipan lhontai. Amani chu Pathen Themgaoho toh ahiuvin, amaho chun akithopiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichephat laitah chun vadung hilamsang vaipopa Tatnai le Shetharbozenai, chule aloihotoh ahenguva ahungun, ajah uvah, hiche in sadingle abangho sajoudinga thu napeuvah koiham? tin ahung seijun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuphatnin keihon ajah uvah hitin kasei taove, hiche in saho min chu ipiham? katiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahivangin Pathen mit chu Judah upaho chunga chun aumin, hiche thudol hi Darius leng heng alhun masangsen anatoh-u chu asutang theipouve. Chuphatnin hiche thudol hi lekhathot nin ahindonbut taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche hi Tattenai'in athot lekhathot chu ahi: Vadung hilamsang vaipopa Tatnai le Shetharbozenai le akiloipi Aphreachi mite, vadung hilam sanga umhon, leng Darius henga:
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon ahenga lekha athotnun, asunga hitin akisune: Darius lengpa henga, lungmona jouse umhen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiho Judah gamsunga kacheuvin, Pathen in loupitah, song lenpipi-a akisah le abang thing lenpipi-a kigen, chule hiche natoh hi amachal lheh-a, akhut tah uva akhantouvu hi lengpan anahen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin keihon upaho henga chun, hiche in sading le abangho tungdoh dinga koijin thu napeh uham? tin kadongun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma henga alamkai hou min kichehtah-a kahin jih theina dingun, aminu jong kadongun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon hitin eidon butnun, keihohi van le lei Pathen lhacha kahiuvin, kum tamtah masanga anakisa, Israelte leng loupi khatnin anasahdohsa in chu kasah-u ahi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla kapu kapa teovin van Pathen chu ana sulunghangun, Aman Chaldea mi Babylon lengpa Nebuchadnezzar khutna amaho anapen, aman hiche in hi anasusen, miho chu Babylon gama anapuimang tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahivangin Babylon leng Cyrus lengchan akum khat na-in, leng Cyrus hin hiche Pathen in sah ding thupeh anapen ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Jerusalem'a um Pathen houin'a kon, sanale dangka-a kisem khonle bel jouse, Nebuchadnezzar'in analahdoh-a Babylon houin'a apohlut chengse chu, leng Cyrus chun Babylon houin'a konin aladoh kitnin, mikhat amin Sheshbazzar gam vaipo-a apansahpa henga chun apedohtan;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ahenga, hiche kong leh bel hohi lanlang, chen, Jerusalem'a um houin'a polutnin, Pathen houin chu akisahna ngaima-a kisa hen, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuphatnin Sheshbazzar chu ahungin, Jerusalem'a um Pathen houin sahnading khombul chu atungdoh-in, chule hichea patna chu tuni geija kisa jing ahin, chule tuchan hin akisajou hihlaije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichejeh chun tun lengpan pha asahlam ahile, Jerusalem'a hiche Pathen in kisahna dinga leng Cyrus'in thutanlhah apehmong hinam ti hetdoh nadin, Babylon'a um lengpa goukholna in chu kikholtoh hen, chule hiche chungchang thudolla hin lengpan alungdeilam eihin hetsah taohen.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuphatnin lengpa Darius chun thupeh apen, Babylon'a goukholna, thusimlui jouse kikoina in chu akhol toh uvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichea hin Media gamkai, Achmetha khopi leng inpia lekhabujol amuvin, chule hiche sunga chun hitihin akisunin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Leng Cyrus lengchan kumkhat alhin kum-in, hiche Cyrus lengpa hin Jerusalem'a Pathen houin thudola chun hitihin thupeh apei; ganlhai thilto aboljinao in chu kisapha hen, chule akhombul chu dettah-in kiphut hen, asanlam chu tong somgup, chule availam jong tong somgup hihen;
  </para>
  <para style="p">
    <verse number="4" style="v" />Songtum len tahtah golthum min kigol hen, chule thingpeh thah gol khatnin kigol hen, chule akimang jouse chu leng ina kona kipeding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pathen in'a kon sana le dangka-a kisem khonle lheng jouse, leng Nabuchadnezzar in Jerusalem houin'a kona alahdoh-a Babylon lama anapohho chu, kilepehkit henlang Jerusalem houin'a chun kipolutkit hen, chule Pathen in'a akikoina muncheh-a kikoi kit hen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun tun vadung gal lama gam vaipo Tatnai, Shetharbozenai le vadung gal lama um naloiho Apharsach mite chu, chukoma konchun ana kikhindalun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche Pathen in kisahi limsah hih-un, Judah te gam vaipopa leh Judah upaho chengsen hiche Pathen houin hi amun mama-a saohen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chukalvallin hiche Pathen in kasahna dinga, Judah upaho chunga ipi naboldingu thupeh kapeh nahiuve; amaho natoh atanlouna diuva lengpa thilholeh vadung lama kaiho chu, hiche miho hin amanchah diuva pehding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule van Pathen dinga govam thilto ding angaichat jouseu, bongchal golho, kelngoichalho, kelngoinou ho, suhlou chang, chi, lengpitwi le thao ho chu Jerusalem'a thempu hon angaichat khoh dungjuijuva aniseh-a amaho thonlouva napeh teitei dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutileh van Pathen henga namtui tahtah-a ganlhaina aneitheijuva, chule lengpa le achate hinkho dinga ataopeh theidingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche thupeh jonghi kapeh ahi: koihile hiche thuhi akhela aumle, a-in lhungpi kiloilha hen, chule hichu kiphut hen, achunga chun kikhailih hen; chule a-in chu eh notnan kineihen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule chemuna amin umsah Pathen chun, Jerusalem'a Pathen in suhsetgo-a, chule hiche thu kheldoh ding go-a khut lama chu lengho hihen, mipi ho hijongleh suhmang hihen, keima Darius in thu kapeh ahi; gangtah in kitongdoh hen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin Darius lengpan thu ahinthot dungjuijin, vadung hilamsanga vaipo Tatnai le Shetharbozenai chule aloihon gangtah in aboltauve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Judah upaho chun asaovin, Haggai themgao le Iddo chapa Zekeriah gaothusei vangin amachallheh jenguvin ahi. Hitichun Israel Pathen thupeh dungjuile, Persia leng Cyrus, Darius, chule Artaxerxes thupeh dungjuijin asauvin, ajoutaovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin hiche in chu Darius alengchan kumgup lhinna, Adar lha nithum channin ajou taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Israel chate, thempuho, Levi ho, chule sohchang chate danghon, hiche Pathen in thensona chu kipahtah-in amangun,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche Pathen houin thenso na-a hin, bongchal jakhat, kelngoichal jani, kelngoinou jali, chule Israel pumpidin chonset thilpeh-a dingin Israel phungjat dungjuijin kelchal somleni apeuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mosi lekhabua kisun dungjuijin, Jerusalem'a Pathen kin bolna dingin thempuho chu aloiloijin chule Levi ho chu agolgolin ahomkhenun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule lha masapen nisomle nili lhinin, gal hinga kikai chaten kalchuh kut amangun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu thempuho le Levi ho chu akisutheng khomun, abonchauvun atheng taovin, chuin sohchang chate jouse dingle asopiteu thempuho chule amaho ding ngeijin kalchuh kut satha aboltauve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Israel chate gal hinga kikai hungkilekit hole, Pakai Israel Pathen holdinga chuche gama Pathen helou thenlouna-a kona kikangse jouse chun aneuvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun cholsolou changlhah kut chu thanom tah-in nisagi amanguve. Ajehchu Pakaiyin amaho chu akipasah in, Pathen, Israel Pathen insahna-a akhuthou hatsah dingin, Assyria lengpa lungthim chu amaho lam angatsah-in ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hicheng nunghin Persia leng Artaxerxes alengchan laijin, Ezra: amachu Seraish chapa, Azariah chapa, Hilkiah chapa,
  </para>
  <para style="p">
    <verse number="2" style="v" />Shallum chapa, Zadok chapa, Ahitub chapa,
  </para>
  <para style="p">
    <verse number="3" style="v" />Amariah chapa, Azariah chapa, Meraioth chapa,
  </para>
  <para style="p">
    <verse number="4" style="v" />Zerahiah chapa, Uzzi chapa, Bukki chapa,
  </para>
  <para style="p">
    <verse number="5" style="v" />Abishua chapa, Phinehas chapa, Eleazar chapa, thempu chungnung Aaron chapa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche Ezra hi Babylon'a kon achetouvin, chule Pakai Israel Pathen'in apeh Mosi danthu sunthem tah ahin, Pakai a-Pathen khutchu achunga aumjeh-in angeh chanchu lengpan apejingin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule leng Artaxerxes alengchan kum sagi alhinnin, Israel chate phabep, thempuho, Levi ho, Lasaho, kotngah ho, chule Nethinim ho Jerusalem'a agache touvun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule lengpa lengchan kal kum sagina, alha ngana-a chun Ezra Jerusalem ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu lha masapen nikho masapen ni-a Babylon'a kona hung kipatdoh ahin, a-Pathen khutchu achunga aum dungjuijin alha chaina nikho masapen nin Jerusalem ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh inem itileh Ezra chu Pakai dan thupeh ho chu hol ding le tongdoh dinga, chule tepna dan kisun hole thutanlhahna chu Israel lah-a hildingin, alunggila akigo chaisa ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun, leng Artaxerxes in Ezra thempu, danthu sun, Pakaiyin Israelte apeh dan thupeh ho le danthu kisunho hethempa, henga apeh lekhathot chu hichehi ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lengho leng Artaxerxes Ezra thempu, van Pathen danthusunpa henga: lungmona chamkim tu le khonungin umjinghen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaleng gamsunga Israel mipi jouse, thempuho le, Levi ho, Jerusalem'a chetou nom jouse chu nangma toh kilhondin thu kalhuhsahtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nakhutna um Pathen dan dungjuija, Judah gam le Jerusalem chungchang thudol kholtoh dinga lengpa le athumop mi sagihon nangmatah nasolu ahin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Jerusalem'a cheng Israel Pathen henga, lengpa le athumop hon achamtah uva atou, sanale dangka thah dinga;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Babylon gamkai jouse sana le dangka namu jousetoh, Jerusalem'a Pathen in dinga kiphal tah-a mipi hole thempuhon atodoh-u, lungcham thilpeh hojong thah dinga kisol nahi:
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutia chu nangman hiche suma chu bongchalho, kelngoichalho, kelngoinou ho, anneh thilto hole donthei theilto ho chu gangtah-a nachoh-a, Jerusalem'a um na Pathen houin maichama chu natoding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule sanale dangka amoh chengse chu nangma le nasopi hon naphatsahna lam lamun, na Pathen lungdeilamin mangtaovin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na Pathen in'a akinbolna dinga nakipe kong leh bel hojong, Jerusalem'a Pathen angsunga napehlut ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule na Pathen in'a dinga akhohna chana pehding aum nahlaileh, lengpa nei khol khomna in'a kona napehding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule keima Artaxerxes leng keimatah-in, vadung gal lama um neiching ho jouse henga; ipi hijongle Ezra thempu, van Pathen danthu sunpan naheng uva athumchan chu gangtah-a nabolpeh dingu ahi, tin thulhah kaneijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dangka talent jakhat, suhlou chang tena jakhat, lengpitwi atena jakhat, thao atena jakhat, chule chi ijatmong ti umlouva napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Van Pathen thupeh chanchu, van Pathen in dinga thanom tah-a pehding ahi. Ajeh chu ipidinga lunghanna chu lengpa le achapate lenggam douna-a umding ham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujongle thempuho, Levi ho, tumginga lasaho, kotngah ho, Nethinim ho, ahiloule Pathen in'a lhachaho chunga thilpohman kai, ahiloule thilho kai lah hi danto kitohlou ahi, ti kahin hetsah nahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Ezra nangman, nakhutna Pathen chihna nanei dungjuija, vadung gala mipi jouse thutan dinga, na Pathen dan heho lah-a kona thutan dingle vaihom ding nalhen ding, chule ahelouho chu nahil ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Koihile na Pathen danle lengpa dan joplou chu: thading ham, nodoh dingham, ahiloule athilkeo lahpeh dingham, songkul'a khumding ham, gangtah-a dan dungjuija athu-u tanding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jerusalem khopi'a Pakai in jephoina dinga lengpa lungsunga hitobang lunggel khumpeh-a ipu ipateu Pakai Pathen chu nunnom hen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule aman lengpa le athumopho, chule lengpa pipui loupitahho masanga hepina eina pejingin ahi. Chule Pakai ka Pathen khut kachunga aumjeh-in keima katha ahatdoh-in, Israel lah-a konin mithupiho keima kilhontoupi din kakhomkhomin ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichehohi leng Artaxerxes vaihom laija Babylon'a kona keitoh hung kilhontou aphung sunga upa chengse phunggui chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phinehas chapate lah-a Gershom, Ithamar chapate lah-a Daniel, David chapate lah-a Hattush.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shecaniah chapate, Parosh chapate, Zekeriah chapate chule amatoh phunggui kisimna-a pasal jakhatle somnga alhinguve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pahath-moab chapate, Zerahiah chapa Elihoenai ahin, chule amatoh jani ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shecaniah chapate, Jahaziel chapa chule amatoh pasal jathum ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Adin chapate, Jonatham chapa Ebed chule amatoh pasal somnga ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Elam chapate, Athaliah chapa Jeshaiah chule amatoh pasal somsagi ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shephatiah chapate, Michael chapa Zebadiah chule amatoh pasal somget ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joab chapate, Jehiel chapa Obadiah chule amatoh pasal jani leh somleget ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Shelomith chapate, Josiphiah chapa chule amatoh pasal jakhatle somgup ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Bebai chapate, Bebai chapa Zekeriah ahin chule amatoh pasal somni le get ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Azgad chapate, Hakkatan chapa Johanan chule amatoh pasal jakhatle som ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Adonikam chapate anunung lamho lah-a, aminho chu Eliphelet, Jeiel, Shemaiah, chule amatoh pasal somgup ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bigvai chapate jong Uthai le Zabbud chule amatoh pasal somsagi ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule amaho chu keiman Ahava luidunglen lama long vadunga chun kakhom khomin, chule hiche mun'a chun pon in'a nithum kaumun, chule mihole thempuho chu kagahven ahile Levi chapate khatcha jong kamupoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuphatnin mithupiho, Eliezer, Ariel, Shemaiah, Elnathan, Jarib, Elnathan, Nathan, Zekeriah, Meshullam koudin mi kasolin; chule hetkhenna nei Joirib le Elnathan jong kakouvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule keiman amaho chu Kasiphia mun'a lamkai Iddo henga thupeh pumin kasollin, chule ka Pathen in'a lhachading kahenguva ahinpuina dingun Kasiphia mun'a um Iddo le asopipa Nithinim jah-a ipi aseidingu kaseipeh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ka Pathen khut phatah kachunguva aumjeh-in, milung chingtah khat: Mahli chapate lah-a, Levi chapate lah-a, Israel chapate lah-a kon Sherabiah kitipa chu achapate le asopite somleget toh kahenguva ahinpuijun ahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Hashabiah, amatoh Merari chapate Jeshaiah, asopite leh achapate toh somni ahiuvin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujongle David le pipuhon Levi ho kin boldinga anapansah-u, Nethinim lah-a Nethinim mi jani leh somni ahiuvin, amahohi amincheh-a kiphongdoh ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuphatnin Ahava vadunglen'a chun, ka Pathen'u anga keihole keiho kaki gimbol uve, ama-a kona lamdih kamutheina dingun, keiho dingle kacha tediu chule kathilnei jouseu diuvin, an ngolding thu kaphongin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ijeh inem itile sepai honkhat, chule sakol sepaiho lamkah-a melma ho-a kona eikithopi diu lengpa henga thumding chu kajah achai. Ajehchu keihon lengpa henga, ka Pathen'u khutchu ama holho jouse chunga aphatna diuvin aumjin, ahinla ama nungsun ho jouse chunga athahatna le alunghana chujia ahi, tia kanaseiju ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun hiche dingin an kangol taovin, ka Pathen'u henga kathum un, eijahpeh-un ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin thempuho lah-a lamkai somleni, Sherabiah, Hashebiah, chule asopiho somtoh kasep khentan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule lengpa le athumopho, a-pakai ho, chule chua Israel aum jousen anato doh-u sanale dangka, umle bel, ka Pathen'u in'a thilpehho jengjong chu amaho katedoh pehtan:
  </para>
  <para style="p">
    <verse number="26" style="v" />Keiman dangka talent jaguple somnga, dangka umle bel talent jakhat, chule sana talent jakhat,
  </para>
  <para style="p">
    <verse number="27" style="v" />Chujongle sana twikong somni, dram sangkhat, chule sana tobanga lu sumsantheng bel ni, akhutnuva katedoh in ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule ajah uvah nangho Pakai dinga atheng nahiuvin, umle bel hojong atheng ahin, chule sanale dangka hohi napu napateu Pakai Pathen henga lungcham thilto ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jerusalem'a Pakai indan ho-a, thempuho le Levi ho lamkai, chule Israel pateho lamkaiho angsunga hicheho hi natedoh masang seuvin, vetupmun lang chingphaovin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hitichun thempuho leh Levi hon todohsa dangkale sana chule um le bel ho chu, Jerusalem'a ka Pathen'u in'a pohdingin alataovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chujouvin lhasomle lhani na nimasanin, Ahava vadunglen'a konin Jerusalem'a chedin kakipan taove. Chule ka Pathen'u khutchu kachunguva aumin, lampi dunga eichanglhi ho leh melmaho khutna konin eihuhdoh uve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Jerusalem'a kahungun, chule hia chun nithum kanichong taove.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tun anili channin, dangka le sana chule umle bel ho chu ka Pathen'u in'a thempu Uriah chapa Meremoth khutna katedoh taovin; chule amato chun Phinehas chapa Eleazer aumin, chule amanitoh Levi mi Jeshua chapa Jozabad le Binnui chapa Naodiah aumin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thil jouse chu simsoh keile tesohkei ahin; chule akite jouse chu hiche petchun akisunlut sohkeije.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chujongle anakikai manga sohchana-a kona hungkilekit chatehon, Israel Pathen henga bongchal somleni, kelngoichal somko le gup, kelngoinou somsagi le sagi, govam thilto din, chule kelchal somleni chonset thiltodin atoh uve. Hicheho jousehi Pakai henga govam thilto ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin amahon lengpa thalheng ho, chule vadunglen hilam sanga gam vaipoho henga, lengpa thutanlhah hochu apedoh taove. Chule amahon mipileh Pathen houna in chu akithopi jomjing taovin ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hiti thil jouse akitoh chai phatnin, milenho chu eikimuto pidingin ahunguvin, kajah-a; Israel mite, thempuho, chule Levi ho chense chu, hiche gama cheng Canaan mite, Hit mite, Perizz mite, Jebus mite, Ammon mite, Moab mite, Egypt mite chule Amor mite thilbol thet umtah tahho-a konin amaho le amaho akikangse pouve, tin aseijun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu amahon achanu teu chu achapateu jidingle, amaho jidin akipuijun; hitichun muchi theng chu amaho le amaho agam miho toh akihalsoh taovin, hiche suhkhelna chu lengho le vaihomho khut ahahi dehsetne.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche thilsoh kajah apat hin, kavon holeh kaponsil kabot telin, kasam le kakhamul kabot doh-in, kidang satah-in katou lhatai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sohchanga kikaiho thil suhkhel jeh-a Israel Pathen thua ati kithingleu hochu kahenglama ahung khomun; chuin nilhah lam ganlhaiphat channin kidang satah-in katoutai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nilhah lam ganlhai phatnin lungkham tah-a katouna-a konin kathoudoh-in, kavonle kapon kabokeh tolhonin kaboh khupmin, chule Pakai ka Pathen lama kakhut kajah-in,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hitin kati, Vo Ka Pathen, nahenglam hinngat dinghi kajah achan kamaimoh lheh jenge, vo Pathen; ajehchu kachonset naohin kaluvumu achup jengin, chule kasuhkhel naohi van chan phahelin akitungdoh-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kapu kapateu nikho laija pat tuni chanin suhkhelna lentah kanei jingun; kakhan gitlou jeh-un keiho, kalengteo, chule kathempu hou gamsunga lengho khutna, chemjam'a, sohchang dinga, chomgam dinga, jumle ja thoh dinga, tunia banga hi eikipedoh-u ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule tunvang ka Pathen'un kamit hou ahadohsah theina dingle, soh-a kaum naova kona halna neokhat eipeh theina diule, asohcha amoh themkhat beh kaum theina dingun, chule amunthenga eiumsah theina dingun, Pakai ka Pathen'un chom khatbeh lungsetna eimusah nalaiju hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu keihohi soh kihen kahibouvun, ahijeng vangin ka Pathen'un kakihen naova eidalha pouvin, ahivangin keiho halna peh kit dingle, Pathen in tungdoh ding, chule aselaiho sempha dingle, Judah gamle Jerusalem'a kulbang sempha dingin, Persia lengte mitmu-a hepina eimusah-un ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Vo ka Pathen, tu-a keihon hicheho jouse nunga ipi kasei dingu hitam? keihon nathupeh ho kanung ngatsan taovin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Nalhacha themgaoho mangcha-a, hitia nanasei, nagalo dingu gam chu, agama chengho thenlounale, thil kidah umtah abolhouva kona bohtin bohtanga among langkhat napat among langkhat geija asuhboh-u, gam thenglou ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun tun nathahat na dingule, gamsunga anpha naneh nadingu, chule nachateo gou ding nadalhah peh theina dingun: nanghon nachanuteu chu achapateu pedoh hih-un, chule achanuteu chu nachapateo dingin puipeh hih-un, chuleh a-imatih chanin amaho-a konin chamna le neile gou hol hih-un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule ka-eng khan jeh-uleh, kasuhkhel nau jeh-a, kachung uva hitobang thil ahunglhun nungin jong, nang ka Pathen'un kakhan gitlounau jeh-a kathoh dingu sanga lhomjo-a gotna neipeh uva, hitobang tah hin neihoidoh nahlai jeh-un:
  </para>
  <para style="p">
    <verse number="14" style="v" />Neithupeh hou chu kasuhkehkit uva, chule hiche thet umtah miho hi kaki guijoppi kit dingu ham? Ahoidoh-a le ajamdoh-a beihela neisuh mang kahseuva, kachunguva nalunghang lou ding ham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Vo Israelte Pakai Pathen, nangma chonphatah nahi; ajehchu keiho tunikho-a banghin kahoidoh nalaijun ahi. Ven kasuh khelnao pumin namasanga kaum uve; ajehchu hiteho jeh-a hi nama sanga dingthei lou kahiuve.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Ezra chu ataova, chonset naho chu aphongdoh-a, kapuma Pathen in masanga chun atoulhah jeng phatchun, Israel mite lah-a kon pasal le numei chule chapang mipi kikhom nasatah ahenga ahung kikhomun, mipi chu lhasetah-in akap taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Elam chate lah-a kona Jehiel chapa Shechaniah chun adonbutnin chule Ezra keihon i-Pathen angsungah thil kasukhel taovin, chule hiche gama gamchom numei ho chu jin kaneijun ahi; ahinla hiche thua hin Israel mite din kinepna aum nalaijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun tun ka pakai thumop dungjuile, danthu dungjuijin, Pathen danthupeh ginga kihot hotna umjousen, gamdang numei ji-a kinei jouse le amaho-a kon peng jouse koidoh nadingin, i-Pathen'u toh kitepna khat semu hite.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thoudoh-in, ajehchu hichehi nangma khutna um ahi, keiho jong nangma to kaum khom dingu ahi; hangsanin, tong jengin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutah-in Ezra athoudoh-in, thempulen leh Levi ho chuleh Israel mijouse chu akisei thu banga boldingin akihahsel sah-in ahileh, amaho jong akihahsel taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Ezra Pathen in masanga konchun athoudoh-in, Johanan kiti Eliashib chapa indan sunga alutnin: chule hiche mun ahunglhun chun, aman changlhah anepon twi jong adonpoi; ajehchu soh-a kikai mangho thilsuhkhel jeh-a lunghema uma ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Judah gam le Jerusalem'a um sohchangho jouse henga chun, Jerusalem'a kikhop sohkei dingin kouna thu alha taovin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Koihile milen holeh vaihom upaho thumop dungjuija, nithum sunga hung kikhom louva aumleh, athilkeu jouse kilahpeh-a, amatah jongchu soh-a kikaimang mipi ho lah-a kona chomkhen hiding ahi, ti thu akiphongtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Judah le Benjamin mite sese chu nithum sungin Jerusalem'a akikhom kimsoh-un ahi. Hichu lhako channa hichelha nisomni alhin nikho ahi. Chuin Pathen in lamlenna chun mipi jouse chu atouvun, athu akhoh jehle go ajuh nasat jeh-in mipi ho chu akithing thing jengun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichun thempu Ezra chu adingin, mipi henga chun: nanghon nasukhel taove, nanghon Israel mipi suhkhel belap nadingin jatdang numei jin naki puijun ahi ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun tun Pakai napu napateu Pathen henga chun nachonset phongun lang, alunglhaina boluvin; chule hiche gama jatdangho-a konle, anumei houva konhin kikangse uvin ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutah-in houkhom ho mijouse chun adonbutnun, awging tah-in, nasei bangin bolnao vinge.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla mipi hi atamlheh jengin, go hajuh laima ahin, chule polanga kading jing thei pouvin, chumale nikhat nini natoh jong ahipoi: ajehchu hiche thu ahin achonkhela jong katam taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun mipi kikhomho jouse chunga eivaipohou chu dingdoh uhen, chule hiche chungchanga Pathen lunghanna nasatah hi eiho-a kon akiheimang kahsen, ka khopi hou jouse-a jatdang ji-a nei jouse chu, khopi jouse-a upaho leh vaihomho toh akitep nikhon hunguhen, atiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Asahel chapa Jonanthan le Tikvah chapa Jahaziah'in bouvin anelkal lhonin, chule Levi mi Meshullam le Shabbethai'in akithopi lhonin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin gal hing kikai chilhah hon hitichun aboltauve. Chuin Ezra thempu le, apu apateu lhah-a, insunga phung upa akilhengdoh hotoh ahin, amaho amin cheh-a kilheng doh ahiuvin, akihom khenun, chule hiche thu ngaito dinghin lhasom channa nikho masapen nin atou khomtaove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule lhakhatna nikhatnin jatdang ji-a neiho jousechu akholdoh chai taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule thempu chate lah-a jatdang ji-a ananei ahetdoh houchu: Jozadak chapa Jeshua chapateho le asopiho; Maaseiah, Eliezer, Jarib chule Gedaliah hichenghi ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahon ajiteu akoidohna dingun akhutnu apedoh-un; chule themo ahi jeh-un, suhkhel thilto dingin kelngoi honlah-a kelngoi chal khat atoh-un ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Immar chapateho-a kon; Hanani le Zebediah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Harim chapateho-a kon; Maaseiah, Elijah, Shemaiah, Jehiel chule Uzziah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pashhur chapateho-a kon; Elioenai, Maaseiah, Ishmael, Nethaneel, Jozabad chule Elasah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chumaleh Levi lah-a kon; Jozabad, Shimei, Kelaiah (Kelita akiti), Pethahiah, Judah le Eliezer.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule lasa loi lah-a kon jong; Eliashib, chule kotngah ho lah-a Shallum, Telem le Uri.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israel dangdang ho lah-a kon: Parosh chapateho; Ramiah, Jeziah, Malchiah, Miamin, Eleazar, Mechijah chule Benaiah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Elam chapateho-a kon; Mattaniah, Zechariah, Jehiel, Abdi, Jeremoth chule Eliah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zattu chapateho-a kon; Elioenai, Eliashib, Mattaniah, Jeremoth, Zabad le Aziza.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bebai chapateho-a kon jong; Jehohanan, Hananiah, Zabbai le Athlai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Bani chapateho-a kon; Meshullam, Malluch, Adaiah, Jashub, Sheal chule Ramoth.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pahath-moab chapateho-a kon; Adna, Chelal, Benaiah, Maaseiah, Mattaniah, Bezalel, Binnui chule Manasseh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Harim chapateho-a kon; Eliezer, Ishijah, Malchiah, Shemaiah chule Shimeon,
  </para>
  <para style="p">
    <verse number="32" style="v" />Benjamin, Malluch, chule Shemariah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hashum chapateho-a kon; Mattenai, Mattatthah, Zabad, Eliphelet, Jeremai, Manasseh chule Shimei.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bani chapateho-a kon; Maadai, Amram chule Uel,
  </para>
  <para style="p">
    <verse number="35" style="v" />Benaiah, Bedeiah, Chelluh,
  </para>
  <para style="p">
    <verse number="36" style="v" />Vaniah, Meremoth, Eliashib,
  </para>
  <para style="p">
    <verse number="37" style="v" />Mattaniah, Mattenai chule Jaasau,
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Bani, Binnui chule Shimei,
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule Shelemiah, Nathan chule Adaiah,
  </para>
  <para style="p">
    <verse number="40" style="v" />Machnadebai, Shashai, Sharai,
  </para>
  <para style="p">
    <verse number="41" style="v" />Azareel le Shelemiah, Shemariah,
  </para>
  <para style="p">
    <verse number="42" style="v" />Shallum, Amariah le Joseph.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nebo chapateho-a kon; Jeiel, Mattithiah, Zabad, Zebina, Jaddau, Joel, chule Benaiah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hiteho jousehin jatdang numei ji'n aneijun; chule abangin ajiteuva konin cha aneijuve.
  </para>
</usx>
