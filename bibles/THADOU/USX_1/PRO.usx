<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Thuchihbu</book>
  <para style="h">Thuchihbu</para>
  <para style="toc1">Thuchihbu</para>
  <para style="toc2">Thuchihbu</para>
  <para style="mt">Thuchihbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel leng David chapa Solomon thuchih ho;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chihna leh kihilna hetna ding, hettheina thuho kimudohna ding;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chihna, thutah, thutan lhahna chule thudih kihilnaho kisana ding:
  </para>
  <para style="p">
    <verse number="4" style="v" />Milhamho gelchet theina, khangdongpa hetnale thil hetkhen them theina pehnading ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Michingin ngaijin tin ahetna kibeding, chule hetthem theina nei michun themna akimuding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thuchih le aledohna hetnading; miching thusei ho le giltah-a thu kiseiho hetkhenthem theina ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai gin kitihi hetna bulpi kipatna ahin, ahinla mingol hon vang chihna le kihilna asang pouvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kachapa napan nahilna ngaijin, chule nanu thupeh chu nahsahmon koihih-in,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu hicheho chu naluchanga dinga kijep hoina hiding, chule nangonga dinga khivui tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kachapa, michonse hon jollhah ding nagot tenguleh nomhih helin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon naheng-ah, hungin keihotoh thisanso ding ngah-u hitin, mona neilouho chu ajeh beijin guhthimin changu hite atiuva ahileh,
  </para>
  <para style="p">
    <verse number="12" style="v" />Kokhuh sunga lhalut ho bangin, eihon amaho khu ahing sanun, apumchangin lhankhuh sunga vallutnu hite.
  </para>
  <para style="p">
    <verse number="13" style="v" />Eihon chutia chu thillu jouse ikimudoh dingu, thil kichom doh-a chu i-in'u idipdim dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiholah-a navang hung kisanin; ibonun sumdip khat neikhomu hite.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kachapa amahotoh alamlhah uva chekhom hih-in; amaho lampia konin nakeng tuhtangin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu akenghou chu aselama alhaijin; chule thisan sona lamah ajangkai uvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tahbeh mongin vacha jouse mitmun panna beijin len chu akijal tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amahon amahole amaho thisan kiso dingjoh angah-un; amahole amaho hinkhojoh chu guhthimin achangun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mipapseho lampi chu chutobang ding ahibouve; hichun aneiho tah hinkho jongchu alamangjin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chihnan lamlhong dunga asamlen, amanun lamkon tinchenga awthongin asamlelen ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amanun lamthompi dungle kotpi lutna ho-a alhang samlen, khopi sunga amanun thu hitihin aseije,
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangho milhamhon, itihchan milhama umding nangai nahlai dingu ham? chule mitaitom ho amitaitom naova thanom jinguva, chule mingolten hetna ahotnahlai dingu ham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Kaphosalna hi nanghon ngaijun: veuvin, keiman nachung uva kalhagao kahin buhlhah ding, chule kathu kahin hetsah ding nahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu keiman kakouvin, nangho nanom pouve; Keiman kakhutnin kahinsangun, koiman nei ngaisah pouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla kahilna jouse nanghon lahlou nahisah taovin, chule kaphosalna jong iman nasep pouve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Keiman jong nangho hamsetna chu kanuisat ding, natijat nao ahunglhun teng nahsah-a kaneilou ding;
  </para>
  <para style="p">
    <verse number="27" style="v" />Natijat naochu manthah na banga ahunglhuna, chule nakisuhmang naochu chimpei banga ahung lhunteng, gentheina le lungdonna nachung uva ahungchuh tengleh khohsahna kanei louding nahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutengle amahon thonlouva keima eihinkou dingu, hijongle keiman kadonbut louding; amahon keima eihinhol loi dingu, hijongle eimudoh loudingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Achuti theina dinga amahon hetna chu anahotnu ahin, chule Pakai gin kitichu anakilhen louvu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amahon kathumop angainom pouvin, amahon kiphosalna jong anahsah pouvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh-a chu amahon achonnau ga akineh dingu, chule athil gonhouva chu dimding ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu milhamho chu akihei mangnao chun atha dingu, chule mingol ho chu aphat theinao chun asuhmang dingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahin koi hijongleh keima sei ngaija chu bitkeija cheng ding, chule thilphalou kichatna-a kona hoidoh teiding ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kachapa, nangman kathuseiho nakisana, chule kathupeh ho nakichin tupma ahile;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutia chu chihna lama nanakhang nasun geh-a, hetkhenthem theina lama nalung naman chah-a;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangman hetna ding gunchu tah-a nahola, hetkhenthem theina dinga aw thong jena nasapma;
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman amanu chu dangka banga nahola, chule gou kiselu banga nakhol chila ahileh;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuteng nangman Pakai gin kitihi nahet khending; chule Pathen hetna hi nakimudoh teiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Pakaiyin chihna apen, akam sunga konin hetna leh hetkhenthem theina asodoh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman michonpha ho dingin chihna phatah akoipeh-in; dihtah-a chonteho dingin ama chu lumdal'in apangin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman thu adih-a kitana lampiho chu aching tupmin, chule amithengte lampi chu aveng tupmin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuteng nangman chonphatna, thutandih, thildih, chule lampipha ho jouse hethem tan nate.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chihna nalung sunga alutna, chule hetna chu nahinna-a dinga kipana ahunghi tengle;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chihtheina chun nangma nahoitup ding, hetkhenthem theinan nangma naventup ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichun migiloupa lampia konle, jouthu thilho seipa akon;
  </para>
  <para style="p">
    <verse number="13" style="v" />Milungdih lampiho peldoh-a, muthim lampiho joh-a chepa-a kon;
  </para>
  <para style="p">
    <verse number="14" style="v" />Thilse bolna-a kipah-a, chule khangitlouna le engsetna-a thanom ho-a kon;
  </para>
  <para style="p">
    <verse number="15" style="v" />Alampihou koile-a, chuleh alampi houva vahlon leho-a kona, huhdoh-a naum ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangma numei phalounu-a konle, numei phalou akama pachat lhem seinu-a kon;
  </para>
  <para style="p">
    <verse number="17" style="v" />Akhan donlaija apuihoipa dalha-a, chule Pathen toh akitepna sumildelnu a kona huhdoh-a naum ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu amanu in chun thina lama apuijin, chule lampi chun thina alhutnin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amanu koma lutapou chu koima ahung kinungle pon, amahon hinna lampiho jong chu atuhdet pouve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu nangman miphaho lampi najot theiding, chule michonpha te lampiho nakichin tup thei ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu milungdih chu gamsunga chengintin, chule michamkim chu chua chengden ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin migilouho vangchu leisetna kona suhgama umding, chule suhkhel neiho chu chua kona kaldoh-a umding ahiuve.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kachapa keima danthu sumil hih-in, ahinla kathupeh ho nalung thimin kichintup jingin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun nahin nikho, nahin kumkho, chule lungmona napehbe ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hepinale thutah chun nangma nadalha hihhel hen; hiteni chu nangonga khivui on ki-onlang, nalungthim sunga lekhajem kijihlut bangin jihlutnin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutiachu nangman Pathen leh mihem mitmu-a, khohsahna le hetkhen themna chu nakimudoh teiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nalungthim pumpin Pakai chu tahsanin; chule nangma chang hetkhen themtheina-a kingai hihbeh-in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nalampi jouse ama hetsah-in, chutile aman nalampi ho nahil ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangma chang mitmu-a kichihsah hih-in; Pakai chu gingin, chule agilouva konin jammangin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichu nalaimu dinga damna, chule nagu nachang jouse dinga lhintwi hitei ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nathil lupen le nalhosoh ga masapen chu, Pakai janan tohdoh jengin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutile nachangsal ho kidip letsetna; chule nalengpiga hehna-a chu lengpitwi thah hung longlet ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kachapa Pakai gimbolna chu nahsahmo loujenin, aman mi asuhdihna jong chu chimchah hih-in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu mipan alunglhaina chapa abolna bangin, Pakaiyin angailut mi chu asudihjin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chihna kimudoh-a, chule hetkhenthem theina kisanpa chu anun nom ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu hichea kivei chu dangka-a kiveina sangin aphan; chule ahung gadoh chu sana thengsel sangin jong aphajon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amanu chu songmantam ho sangin alujon; chule nangai chat thilho jouse jongchu amanu chutoh tekah hoi ahipon ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amanu khut jetlama hinkho saona aumin; chule akhut veilama haona le jana aume.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amanu lampiho chu nopna lampijong ahin, chule alampiho jouse chu chamna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amanu kituhchah khahte dingin amachu hinna thingphung ahin; chule amanu kichinjing tapou chu anunnome.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakaiyin achihna-in leiset anaphutdoh-in; ahetkhen themna-in van ho anatung doh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman ahetna-in munthuh ho ahong jal-in; chule meilomho daitwijin ahin lhahsah-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kachapa hiche hohi namit mu-a konin jam mangsah hih-in; gellhuh them theina le chihna chu ngah tupmin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichu nalhagao dinga hinna, chule na-ngong chang dinga kijepna hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuteng nangma nalampi-a bitkeija nava le-a, chule nakeng jong kipal louding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangma nalup tengle nakichat tahlouhel ding, chule nangma lumin natin, nomsa tah-a na-imut ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Photlot louva tijatna, ahiloule khang gilouho chunga manthah na ahunglhun teng jongle kicha hih-in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu Pakai chu nakisonna hintin; chule nakeng chu akisuh khahna dinga kona nachintup pehding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nakhutna boltheina thahat aum petnin, amahon thilpha amudingu chu suhtangpeh hih-in,
  </para>
  <para style="p">
    <verse number="28" style="v" />Nahenga gahpehpai jengthei thil aumle, na-inhengpa jah-a, chetan, jingle hungkitjon, petei nange tin seihih beh-in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ama nakoma mongtah-a achen namu manin, na-inhengpa chunga thil gilou gonghih beh-in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman nangma chunga setna abol louva ahile, ajeh beijin mikhat kidoupi hih-in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nangman misugenthei pa chu thangse hih-in; chule alampiho chu kilhen ding gohih-in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu milung dihlou chu Pakai dinga thet umtah ahin, hinla ama thuguh chu michonpha te henga aumme.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pakai sapsetna chu khan gitlouna insunga achun: ahinla aman midihtah chenna chu phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tahbeh-in aman mi i-sah louva bolho chu i-sah louvin abolin; ahinla mi kineosah ho chu khotona apen ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Miching chu loupina changding, hinlah mingol hon vang jum na ato dingu ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngaijun, chateho, hetkhen themtheina nakimudoh theina dingun, napan nahilnao hi ngai phaovin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu keiman nangho thuhilpha kapeh nahiuve, ka danthu dalha hih beh-un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu keima kapa chapa kahin, khangnou chitchet le kanu mitmu-a ngailut khatseh chu kahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman keima hiljong einahilin, chule kahenga hitin anaseije; nalungin kathuho chu kichintup min, kathupeh ho kituh detnin lang hinnan neijin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chihna kimun, hetkhen themtheina kimun, sumil hih beh-in; kakama thusohdoh ho-a konin jong kiheidoh hihbeh-in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amanu dalha hih-in, chule amanun nangma nahoitup ding ahin; amanu ngailun chutile amanun nangma navettup ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chihna hi thil lupen ahi, hijeh chun chihna chu kimun; chule nathil mu jouse chu hetkhen themtheina toh mudohtha teijin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanu choisangin, chutile amanun nangma nadopsang ding ahi. Nangman amanu nakikolchah teng, amanun nangma jabolna mun'a nalhut ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amanun naluchang chu ngailutna-a ajepding; amanun loupina lallukhuh nahenga ahinlhut ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngaijin, vo kachapa, chule kaseihohi kisanin; chutile nahin kumkho sot ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman nangma chihna lampi kahiltan, keiman nangma lamdih ho-a chun kalamkai tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangma nachele teng nakalson kisudong pontin; chule nalhaiteng jongle nangma kipal lhu ponnate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hilchahna chu tuhdetkheh-in, amanu chu lhaso hih in; kivet tupmin, ijeh inem itile amanu chu na hinna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khang giloute lampia nangma lut hih-in; chule miphaloute lampia cheloujenin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Peldoh-in, anaija chehih in, chua konin kihei mangin, chule chemang jengin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu thilse abol louvule amaho a-imu pouvin; chule amahon khattou lhuhna ding abol masang seuvin a-imuthei pouvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu amahon khan gitlouna changlhah chu aneuvin, chule thisan sona lengpitwi adonun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amavang midihtah te lampi chu vah bangin a-emselin; nikho hoitah asodoh changeija vahcheh cheh tobang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mikhang giloute lampichu muthim tobang ahin; amaho ipi-a kipal lhu hiuvem aheji pouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kachapa kathuseiho phaten ngaijin; kathusei ho-a nanakhang hin sungin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hicheho chu namitmu-a konin jam mangsah hih-in; hiche chu nalunggil sunga kichintup min.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu hiche chu akimudohte dinga hinna, chule atahsa pumpi diuva damna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chingthei tah-in nalungsung kivet tupmin; ajehchu chua kona chu hinkho-a thilsoh ho hungsoh doh ji ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nanga konin jouthu sei chu koimangin; chule alam louva muhthem nachu gamla tah-in koijin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Namit chun vejangpet henlang, chule namitnel honjong namasang vejang keihen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nakeng phangin achot nading lampi kivet phatnin; chule nalampi jouse chu semtupmin umhen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jetlam ahiloule veilama kiheidoh hihbeh in; setna a konin nakeng sepdoh jengin.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kachapa kachihna hi lunglut tah-in ngaiphan; chule kahetkhen themtheina lama hin nanakhang hin sungin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutile thil datkhen je nahetding, nakamin jong hetna achintup thei ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu miphalou nu muh chu khoiju abangin; chule amanu kamsung chu thaosangin analjon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla amanu kichaina chu gamsai bangin akhan, hemto chemjam bangin ahemin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amanu kengin thinalam ajonsuh in; akalseho chun thikholmun achonlut tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman hinna lampi chu lunggil tah-a nangaito louva ahile, amanu lampiho chu kikhel thipthap ahin, chutia chu nangin lampiho chu nahet theilou ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun chateho tun kathu ngaijun, chule kakamsung thuho-a konin nangho kiheimang hih-un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanu-a konin nalampi khin gamlan, chule amanu kotphung jong hin nailut hih-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Achuti louleh jabola naumna chu midangho kipedoh intin; chule nahinkumkho chu engseho henga kipedoh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nahaona jouse jong gamdang mihon haonan neijuntin chule natohgim ga jouse jong gamdang mi inna lut ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Natahsa leh naphe suhmanga aumteng, achaina keija lunghema naum ding;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman seijin natin, itobanga hilchahna kana hotna, chule kalungin phona donse louva anakoi hitam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule jilkung hon eihilnao kana ngaida-a, eithumop ho thupeh-a kanakhang kanasunlou hitam!
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima houkhom nale khoppi lah-a jong, agilouva mangthah paidin kana ume nati ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma twibel'a konle nangma twikhuh-a kon hung longdoh twiho bouchu donin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Natwinah ho chu thejalin umhen lang, chule vadung twiho chu lamlhongpi dunga longhen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho chu nangma changseh-a bou hihen lang, naum khompi gamdang miho-a hida hen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Natwinah chu phatthei boh-in umhen; chule nakhang donlai na-inneipitoh kipahkhom lhonin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amanu chu dei umtah sajuh leh lunglhai umtah sajuh chal tobang hihen, amanu anglum chun phatjousen nalung lhaisah hen; chule amanu ngailutna chun nangma a-imatih chanin lung mongin nakoi jinghen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule kachapa ipi dinga hetkhahlou numei khat toh nakikolchah-a, chule hetkhahlou khatchu nangman nakikoipi ding ham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu mihem lampi jouse Pakaiyin amu sohkei ahin; chule aman amapa chena jouse chu avelhi jingin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khan gitlouna bolpa chu athepmonan amatchah ding, chule amatah chonsetna chun khao banga akanchah ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amachu hilchahna beija thiding, chule angol behseh jeh-a vahmang ding ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kachapa nangma nagol dinga kitepna thila kitung nahi tah-a, gamdang mitoh kikhutsan nahitahle,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nakam sunga kon naseidoh thuchengho chun nangma namat den ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kachapa, tun hichehi bolin, nangma le nangma kihudoh-in; nagolpa khutna chu naum tengle, chen, gakisunem min, nagolpa chu galung lhaijin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Namit chu nguisah hih-in, chule namitteni jong kisin sah hih-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gamlengpa khutna kon sajuhchal akitol doh bangle, thangkampa khutna kona vacha khat akitol doh bangin, nangma kihuhdoh in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo mithase, sihmi henga gachen, alamlhah ho ngaiton lang, chihnan neijin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman apuihoi, avesui, ahiloule vaihom aneipon;
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman nipilai leh nehding akisuh tupmin, chule chang at laile neh le chah akikhol khomjin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo mithase, itihchan na-imut nahlai ding ham? Itihle na-imutna-a kona nahung kithodoh ding ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Chom chakhat na-imun nalulhu kitjin, imudingin nakhut nalhepton;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutia chu vaichatna-in kholjin vahle banga, chule lhahsamna-in hem le thal kikenpa banga nahin lhunkhum ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Seingailou mi, mikhang gilou chu jouthu seijin avah lejin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman amit teni asat lhaplhap jin, akengin thu aseijin, akhutjunghon mi ahilji;
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman alungsunga jouthu jeng agelin, thilphalou chu agongjom jingin, kitolouna atun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh achu achunga vangsetna phulou helouva hunglhung ding; phulou helouva ama jendam thei louva kisuse ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche thil gup hohi Pakaiyin ahot ahi; Henge, sagi chu amadinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kiletsah maiso, jouseina leigui, chule mona neilou thisan sona khut,
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil gilou gongji-a lungthim, agiloulam delna-a kaljanga keng,
  </para>
  <para style="p">
    <verse number="19" style="v" />Hettohsah lhem jouthu seija, chule sopite lah-a kitolouna muchi banga tulut jia mihem.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kachapa napa thupeh nitnin, chule nanu danthu lhaso hih-in,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hicheho chu nalungsunga kichin jingin; chule nangonga khivui on ki-o jingin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nachele teng hichun nalamkai ding, na-imut teng hichun nachintup ding; chule nakhahdoh tengle hichun nakihou limpi teiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu thupeh chu meivah ahin, danthu chu vah ahi, chule kihila kiphosalna chu hinna lampi ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hicheho chun numei gilounu-a konle, gamdang numeinu pachat lhemna thuho-a kona nahoitup ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amanu hoina chu nalungin ngaicha hihbeh in; chule amit hadan jong kilhep lhahsah hih-in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu jonthanhoi bol numeinu chu pasal khatnin changlhah halkhatna akichoh thei ahin; chule mijongnu chun hinkho manlu tahchu asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mikhatnin a-opma mei achoija, apon kalouva um theijem?
  </para>
  <para style="p">
    <verse number="28" style="v" />Mikhat song meihol kitih-am chunga chea, akeng kalouva um theijem?
  </para>
  <para style="p">
    <verse number="29" style="v" />Hitia chu a-inhengpa inneipi henga galutna michu, koihile amanu tongkha chan chu themo changding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mikhat touvin agilkel pet tah-a ahinna suhlunglhai nadinga guhchat abola ahileh, min guchapa chu amusit ngaipoi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Akimatdoh vangle amachun ajat sagi-a aditding; a-insunga thiljouse apeh ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahinla koihile numei khat toh jonga vangchu het themna lhasama ahin, chutobang bolla chun ama hinkho akisuhset ahitai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amachun mavo nale kijumsona akimuding; chule ama i-sah louva aumna chu kitheh mang joulou ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ajehchu kithangset hi mihem lunghanna ahin; hijeh-a chu phulahna nikho ahung lhunteng aman khen aneilouhel ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman kilhatdohna thil khatcha adonpeh louding; thilpeh tamtah pejongle chun, ama lunglhai louding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kachapa kathuho kichin tupmin, chule kathupeh ho kikhol khom minlang hin,
  </para>
  <para style="p">
    <verse number="2" style="v" />kathupeh ho kichintup minlang hingin, chule ka dan chu namit mu-a alupen hihen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hicheho chu nakhut jungho-a kibunlang; nalungsunga kijih lutnin,
  </para>
  <para style="p">
    <verse number="4" style="v" />nangman chihna henga chun kasopinu nahi tin, chule hetkhen themtheina chu na inkonu hisah-in,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutile hicheho chun gamchom numei nu-a konle, gamdang mi pachat lhem seinu-a kona nahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu ka-in bangkotna bangvang kah-a kagah ven,
  </para>
  <para style="p">
    <verse number="7" style="v" />milhamho lah chu kaven, khangdongho lah-a chun, hetkhenthem theina neilou golhang khat kagah lhengdoh theijin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanu umna ningkoi lamlhah-a achepai jengin, chule amapan amanu inlam ajonjelin,
  </para>
  <para style="p">
    <verse number="9" style="v" />nilhah lam, khothim chipchep in, jan muthim jing noija,
  </para>
  <para style="p">
    <verse number="10" style="v" />veuvin, numei kijoh vona kivonle, dohathuh numei khatnin amapa chu ana kimupi tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />(Amanu chu husetah le louchaltah ahin, akengchu a-in'a angaman hihbeh-in;
  </para>
  <para style="p">
    <verse number="12" style="v" />abang komle amanu apama aumin, abang komle lamlhah-a aumin, chule ningkoi tinchenga achanglhi jingin ahi.)
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun amanu chun amapa chu amanin, achopmin, chule jah motah in amapa henga aseije,
  </para>
  <para style="p">
    <verse number="14" style="v" />keiman chamna kilhaina thilto kaneije, tuni hin keiman kakitepna ho kapetan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichejeh-a chu nangma kimupi dinga, gunchu tah-a namaiso holdinga kahung vadoh ahin, chule nangma kamudohtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kajalkhun jemhoitah khaodip ponin, akigeitho thilho-in, chule Egypt tupat ponnemjetnin kajem joutan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kajalkhun chu myrrh, aloes chule thingthal gimnamtuiho-a keiman kasu namtuisoh keijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hungin jingkhovah kahsen eini chimsetnin kinou hitin, mongtah-in kinou chimset hite.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka inneipao la ina aumpoi, gamlatah-a jindoh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman sum dip khat akisemin, nikho atepni lebou in hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amanun thu ngeitah seijin, amapa chu ajol lhatan, amuh nal-heu pachatna lhemin amapa chu athujo tan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bongchal khatnin akithana ding mun, ahiloule mingol khatnin bul akituh nading bangin; amapan amanu nungchu ajuijel tan;
  </para>
  <para style="p">
    <verse number="23" style="v" />Thalchangin athinlung asutpai bangle; vacha khat kikin sah tah-a thanga a-o tobangin, amapan ahinkho manthah ding akihet pon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun vo nangho chapangho kaseihi kingaijun; chule kakama hungsoh doh thuho hi kigel phatnun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amanu chena lama chun nalung onsah hih-in; amanu lampiho a chun kiheimangin lut hihbeh-in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu amanun mi tamtah ama put sahtan; chule mihat tamtah jong alousahjou ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanu in chu thikholmun jotna lampi ahin; thina indanho jotsuhna ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chihna chun kholhang asapji hilouham? chule hetkhen themtheina-in a-aw ahin sodohji hilouham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Amanu munsang vumlai tah-ah, lamthom tina adingin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amanun kotpi phungho, khopi lutnaho chule kotna hung lutna ho-a asamlen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo miho kahinkou nahiuve, chule ka awgin hin mihem chapate chu akou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo nangho milhamte, chihna kihet themun; chule nangho mingolte, hetkhen themtheina lungthim neijun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngaijun, ajehchu thilpha chung nungho kahinsei ding ahin; chule kakamsoh chun thilpha ngen aseiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu kakamin thutah aseiding, chule phatlouna chu kakam dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kakama kon sohdoh thucheng jouse chu chonphatna ahin, hicheho-a chun khan gitlouna leh vakoina aumpon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahekhen themtheipa dingin hicheho chu akicheh-in; chule hetna kimudoh tedin adih chu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dangka sangin hilchahna chu kisanin lang, chule sana deitah sangin jong hetna chu kisanin,
  </para>
  <para style="p">
    <verse number="11" style="v" />ajehchu chihna hi songmantam sangin aphajon; chule deithei thilho jouse chutoh tekah theihoi ahipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chihna kiti keima hi datkhenthem natoh kacheng khomin, chule keiman hetna leh chihnaho kamudoh in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai gin kitihi thilse hot bolding hi ahin; Kiletsahna, hoithona, setna lampi, chule jou seina kam hi keiman kahot ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chihna giltah leh thumop chu keija ahin, keima hetkhenthem theina chu kahin, chule thahatna kaneije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima jal-in lenghon vai apouvin, chule pipuihon dihtah-in thutana abolun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keima jal-in pipuiho, milal ho, leiset pumpi-a thutan ho jengin jong vai ahomun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keima eingailute chu kangailun; chule matah-a eiholte chun eimudiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Haonahole jana keija aumin, henge, haosatna le chonphatna jong keijah aume.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaga hi sana sangin aphajon, ahi, sana phapen sangin aphajoi, katoh dohsa jong hi dangka lhentum sangin aphajoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chonphatna lampi-a kalamkaijin, Thutanna lampiho lah-a kalamkaije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutia chu eingailute chu keiman gou kalosah ding; chule agouho chu kadimsetsah ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khanglui laija Pakaiyin na anatoh masang, chule alampiho kipat tilla, aman keima einanei ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keima tonsotna pat, abula pat, ahilouleh leiset ana kisemdoh masanga pat eina kitungdoh ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Munthuh tah anaum masang, twinengtah-a akikholna twinaho ana um masanga pat, keima anakipodoh kahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mol le lhangho anaum masanga, keima einakipo doh-a kahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman leisetle gamho, vannoi leiset sangpen asemdoh masang peh-a jong anaum kahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman vanho anagona, munthuh akolkhum laichun, keima kana ummin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman chunga meilomho anaphudoh-a, twinah thuhho anahatsah laichun,
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman twiho akiveina kalval akhokhel louna dinga, leiset bul aphudoh a chu twikhanglen thupeh ananei ahitai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuti chun amatoh thilkhat hung kikhoukhah bangin ama koma kana ummin; chule ama anga kipah jingle, nitinna ama dei kanahin,
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathen semsa leiset chen nathei munkhatna chun kanakipah-in; chule kalunglhaina chu mihem chapate chunga anaumin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun tun vo chateho, kathu sei hi kichintup mun; ajehchu kalampiho nit chan chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hilchahna kingaijunlang, chihnan neijun, hichu pampai hih-un.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kathusei phatecha ngaija, nitina kakotpiphung velhijing, kakot bulho-a ngahjingpa chu anunnom ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ajehchu koihile keima eikimudoh-a chun hinna akimudoh ahitan; chule Pakai lunglhaina chu changding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahinla keima douna-a chonsepa vang chun, amatah hinkho chu dihlouva akibol ahi. Keima eihotbol chanchun thina joh angailut ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chihna in a-in akisah doh-in, chule khompi jong sagi atungdohtai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amanun aganchaho akitha-in; ajuho jong ahaltoh-in, adokhangho jong ajem joutai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amanun asoh numei ho asoldoh joutai; amanun khopi sunga munsangpena kon asamin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Milham koi hile hilama hungkile heihen, hetthem theina ngaichaho henga chun amanun aseijin,
  </para>
  <para style="p">
    <verse number="5" style="v" />hungin, ka changlhah nenlang, kahalsa juhi hungdonin ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngolna chu dalhanlang hingin; chule hetkhen themtheina lampia chen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mitaitom hat ho phoh-a, adih bolsah ding gopa chu ama le ama akijumso jin, chule agilou phohsala chun gimna akimun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mitaitom hatchu suhdih ding gohih-in; aman nahot loding ahi. Miching chu phoh le chun aman nangailut ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Miching chu hilchah lechun ama ching cheh ding: Midihtah pa chu hil lechun, chutile ama hetna lama khangtou ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai gin hi chih kipatna chu ahin; Mithengpa het kiti jonghi hetkhen themna chu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu keima-a nahin nikhoho kipunsah-a; chule nahinkumho kisutam ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangma aching nahile, nangma dingabou ching nahin; ahinla nangman nataitomle, hichu nangman nachanga nakipoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Numei ngolchu akam atamin, mimol ahin, chule hetna imacha aneipoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanu akotphunga atouvin, khopisunga munsang ho-a touna-a jong atouji-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Achena ding lampia jangpetna chehon ahin jotpa tengule akoujin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Milham koi hile hilama hungkile heihen, hetthem theina ngaichaho henga chun amanun aseijin,
  </para>
  <para style="p">
    <verse number="17" style="v" />Twi kigu chu alhumin, chule changlhah aguh a kine chu atuije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla amapan hia chun thina aume, chule amanu jinho chu thikholmun thuhlaija um ahiuve ti ahepon ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chapa chingin apa akipasah in; amavang chapa ngol chu anu dinga hesohna bep ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khan gitlouna gouho chun koima aphatchom sahpon; ahinla chonphat na-in thina-a konin ahuhdoh theije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin michonpha hinkho chu kel thoh dinga asuhgenthei louding; amavang khan giloute thil le lo vang asuhmang peh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khut thase tah-a natongpa chu ahung vaichan, hinla migunchu khutnin haona amujie.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nipi laija kikholkhoma chu chapa ching ahin, ahinla chang at laija ihmupa vangchu jachat konsah chapa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Phattheina chu michondih tah luchunga aumin, migiloute kamsunga vang hunama thuseijin atomchah-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Midihtah hetjingna chu phattheina ahin, amavang mikhangilou chu amin mangthah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Milungching chun thupeh ho akisan ding, mingol moh paopao vangchu lhutei ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dihtah-a kalsongpa chu mongtah-in achejin; alampiho-a vahveija chu hetdoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amit satlaplap pachun gimna asosah-in; ahinla mingol moh paopao vangchu lhuding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Michonpha kamchu hinna twikhuh ahin; migiloute kamsunga vang hunama thuseijin atomchah-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kihotna-in kinahna akondoh sah-in; ahivangin ngailutnan chonset jouse akhujin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hetkhenthem theina neipa kamsunga chun chihna akimudoh in; ahinla mol chu het khenthem theina neiloupa tungtuna ding ahibouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miching hon hetna akikholun, ahinla mingol kam vangchu manthah na toh naicha ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahaopa haona chu akhopidet ahin; migenthei ho suhgemna chu avaichatnau ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Michonpha te tohgimna chun hinna asodoh in, agiloute toh ga vang chonsetna ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hilchahna kichintup pa chu hinna lampia aumin, ahinla phona sangloupa chu avahthai jin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ami hotna selgu chanchu mijou ahin, chule thujouva mi seise-a chu angol ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thucheng tamna-a chun chonsetna alhasampon, ahin akam kihupthem thei michu miching ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Midihtah lei chu dangka thengsel tobang ahin; migilou lungthim vang pannabei ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Michonpha kam chun mi tampi avah-in; ahinla mingol hovang chihna lhahsam jeh-in athijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai phattheiboh na-in haosatna asodoh sah-in; chule hiche-a chun gimna abelap pon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gitlouna hi mingol dingin kichep golseh tobang ahin; ahinla hetkhenthem theina neipan chihna aneijin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Migilouvin akichat jing kichatna chu amachunga hunglhung ding; ahinla michonpha ngaichat chu kipeding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chimpei kitolmang bangin agiloupa chu aumtapon; ahinla michonpha chu tonsotna kiphutdet ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ha dinga lengpitwi thuh, mit dinga meikhu ahibangin, mithase chu asolleho dingin chutobang chu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pakai ginna chun nikhoho asaosah-in ahi, ahinla agiloute kumho vangchu kisuchom ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Michonpha te kinepna chu kipana hintin, migiloute kinepna vang manthah na hiding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakai lampi chu midih dingin thahatna ahi, ahinla khansetna tongho dinga suhgemna hiteiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Michonpha te chu imatihchana suhlonga umlou helding, ahinla migilou ten leiset alo loudingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Midih kamsungin chihna asodohsah-in; ahinla jouthusei lei vangchu ki-atdoh ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Michonpha kamsung chun santhei ahen; ahinla mikhang gilou kamin vang jouthu bou aseijin ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khaikot dihlouva kite hi Pakai dinga thet umtah ahin, ahinla dihtah-a kite chu ama lunglhaina ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kiletsahna ahunglhun teng, jum na ahung lhungin, ahinla mi kineosah koma chihna aum jinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mikitahte phatna chun amaho apuihoi ding, ahinla suhkhelna neiho louchalna chun amaho asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lungsat nikhoteng haonaho pannabei ahin, chonphat na-in vang thina-a konin ahuhdoh-e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chamkimsel mihem chu achonphatnan lamdih-a apuiding; amavang khanggilou chu akhangit louna-a lhuding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Milungdih ho achonphatnao chun amaho ahuhhing ding, amavang mi kitahlouho chu amahotah suhkhelna chun amatden diu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migilou athiteng akinepna chu mang ding ahin; chule midihlou ho kinepna chu amangjitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Michonpha chu lungkham na-a konin huhdoh-in aumin; chule migiloupa chu michonpha pa thakhelin lungkham na-a ahunglutjin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipha lhemin aheng akom chu akamin asumangin, ahinla hetnavanga midihtah chu huhdoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Michonpha ho akhantou tengle khopi akipahjin, amavang mikhangilou amanthah teng min a-eu jie.
  </para>
  <para style="p">
    <verse number="11" style="v" />Midih phatthei achan jal-in khopi choisangin aumjin; ahinla migilouho kamso jeh-in suhchimin aum jitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chihna notthapma koi mihem chun a-inheng iman agelpon; ahinla hetkhenthem theina neipa vang chun chamna akituh chah-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Guhthima thuseijin thuguhho aphong dohjin, hinla tahsan umtah mihem vang chun thuguh chu a-imjouvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kithumop umlouna-a chun mipi alhujin, ahinla mithumop tamna a chun hoidohna aume.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gamdang mikhat dinga bat thila ama le ama kitunga chun lunggimna akimu teiding, hinla midinga bat thila kitunding nomlouva chu hoidoh teiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lungsetna dim numei jin jana akilamdoh-in chule pasal thahat hon haonaho akilamdoh ji-e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hepi nadim pasal'in alhagaodin napha atongin; mi engsepa vangin atahsatah ngeijong asugime.
  </para>
  <para style="p">
    <verse number="18" style="v" />Agiloupan lheplhahna dimset na atongin, ahinla chonphatna muchi tupa ding chun thonlou kipana aumme.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chonphatna in hinna apuilut bangin, thilse delpa chun amatah thina dinga adel ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khangitlouna lung puho chu Pakai dinga thet umtah ahin; chutobanga chu nolnabei miho lamdih-a acheu chu ama lunglhaina ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Migiloute khat le khat akhutnun kituhto jongleu talen manlouva umloudiu; ahinla michonpha chilhah vang kihuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Numei melhoitah hetthem theina neilou chu, vohpi nahkuija sana thengsel kibapeh tobang bep ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Michonpha lungdei chu aphalam jengbou ahin; amavang migilou kinepna chu lungsatna ahibouve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihem khatnin manbeijin ahomdohjin, hinlah akhangtouvin ahaocheh cheh jin; mihem khat apehdingdol jong pelouva it aumin, hinlah hiche chun vaichatna lam alhutjon ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihongphal hinna chu suhthaova umding; chule midinga twi chappeh chan chu ama jong kichap pehding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahop ding chang itna michu mipin agaosap ding, ahinla chuche johdohpa lujanga chu vangbohna chuding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gunchu tah-a apha holpa chun khohsahna akimudoh-a, thilphalou holpa henga vang ase hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahaona-a kisongpa chu lhutei ding ahin, ahinla michonpha vang thingbah banga khangtou ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ama insungtah suboipa goulo chu hui hiding; chule mingol chu milungchingpa soh-a pangding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chonphat ga chu hinna thingphung ahin; chule lhagaoho huhhingpa chu miching ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Veuvin, chonphate chu leisetna lethuh-a umding ahiuvin, migiloute leh chonsete jongchu chuche sanga tamcheh-a kilethuh ding ahiuve.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Koi hile hilchahna ngailu-a chun hetna angailut ahin, kiphona hotbolpa vangchu mingol ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipha chu Pakai khohsahna achangin, ahinla khangitlou thil gongpa vangchu themmo achanding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Phatlouna-in mikhatcha atundoh louding, ahinla michonpha te kijung khona vangchu suhlonghoi hilouding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Numei chonchan pha chu a-inneipu dinga lallukhuh ahin, hinla jachatna hinlhut numei vangchu amapa ding aguho monlha tobang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Michonpha lunggel ho chu adih-in, amavang mikhangilou thumop chu kijou lhepna ahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mikhang giloute kamcheng vang thisanso ding chanlhih ding thu ahin; ahinla midihte kamsungsoh vang chun amaho ahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Agiloute chu lekhupmin aumin, abeiji taovin, ahinla michonpha in vangchu dingjing ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mikhat chu ama lungsung chihna dungjuija pachat hintin, ahinla lungdihlou kengpa vangchu isahlou hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama le ama kijabola nehding lhasampa sangin mi i-sah louva um, ahia soh neija michu aphajon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Michonphan agancha hinkho akhoh sah-in; ahinla migiloupa nemheuva mikhotona chu engsetna ahibouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Agam kilhopa chun nehle chah lhingsetna amuding, ahinla pannabei miho juilepa vangchu hetthem theina lama ahomkeo ahibouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mikhangilou vin miphalouho lenthang adeichan, ahinla chonphatna jungchun ga asodoh-e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mikhang gilou chu ama thusei dihlouva chun a-oh jin, ahinla midihtah pachu boina-a kona ongdoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Akamsunga thupot vanga mikhat chu aphalama lunglhai ding, chule akhut tah-a natongpa chu atohga ama kipetei ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mingolin achena lampi chu ama mitnin adih-in amun; ahinla hilchahna ngaipa chu miching ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mingol khat lungsatna chu apettah-a kihedoh ahin, milungchingin vang jum na akhukhumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thutah seidohpa chun chonphatna atah langin, ahinla hettohsah lhem vang chun lheplhahna avetsah-e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chemjam'a kisun banga thusei aumin, ahinla miching thusei chu damna ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thutah sei kamsung chu a-imatih chana kiphutdoh ding ahin, ahinla thujou seina leigui vangchu chomkhat kah dingbou ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lheplhahna hi ase gelho lunga aumjin, ahinla chamna thuhil ho-a vang kipana aume.
  </para>
  <para style="p">
    <verse number="21" style="v" />Midihtah chunga thilse sohlou ding ahin; ahinla agilou chu setna-a dimding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thujou seina kamchu Pakai dinga thet umtah ahin, ahinla thutah a kimangchaho vang chu ama lunglhaina ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Michingin hetna akikoi tupmin, ahinla mingol ho lungin vang ngolna asamlen ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gunchupa khutnin vaihomna achoiding ahin, hinla thasepa vangchu hunama na kitohsah ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lungsung pohgih na-in mi alungkham sah-in, ahinla thupha cheng khatnin akipasah-e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Michonpha chu aheng akom sangin gamchengin apha chung nungjon, hinla migilou lampi chun amaho apuimangji-e.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mithase chun agam lenna-a atha sa chu agou jipoi, hinla agunchupa thil vang chu manlutah ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chonphatna lampia chun hinna aumin, chule chuche lampia chun thina himhim aumpoi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chapa chingin apa thuhilna angaijin, mi i-sah loupan vang phona angaipon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Min akamsoh ga tuitah akineh ding ahin, hinla suhkhelna neiho hinna-in vang hunama kibol anehdiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akam kituh tuppan ahinkho akivettup ahin, hinla akamtampa vang chun suhgemna ato teiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mithasen alungin angaichan hinla aneijipoi; ahivangin migunchu pa hinna chu haosatah-a umding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Michonphan joule nala thu kisei aho-in; hinla migilou vang kidah umtah ahin, jachatnan achuji-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lamdih-a chepa chu chonphat na-in avetupmin, hinla gitlou na-in michonse alehkhup jin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama kihaosah-a, imacha neilou aumin, ama kivaichatsa-a neile gou tamtah neijong aumin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihem khat hinkho chu haona-a kilhatdoh ahin, hinla vaichahon vang kiphosalna chu angai pouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi chonphate vah chu akipah-in; migiloute thaomei vang kisumit ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kiletsah nahin kidouna alhunsahjin, hinla kihilna pha umna-a chun chihna aume.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lamdih louva kimu neile gou chu kemsuh teiding ahin, tohgimna-a kona kikholdoh neile gou vang chu pung ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kinepna thonin lungsung adammo sah-in, hinla ngaichat akimolso teng vangleh, hichu hin thingphung ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koi hile thu i-sah louhela koija chu suhmanga umding, hinla thupeh gingpa vangchu kipaman kipeding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miching dan thupeh chu hinna twinah ahin, hichu thina thangho-a kona hoidohna ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thilpha hetthem theina chun khohsahna akimun; hinla suhkhelna neiho lampi chu ahahsan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Milung chingin hetna akisah lelpi-in; hinla mingolin vang angolna chu atahlangin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thupole-a pang migilou chu boina-ah alhalut jin; hinla tahsan umtah palai chun damtheina ahinpolut jin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vaichatna le jum na chu hilchahna kisan nomloupa chanding ahin; hinla phona kichin thempa vang chu ja-a umding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngaichat khat suhbulhit hi hinkho nopna ahin; hinla thilse-a kon kiheimang dinghi mingolte dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Miching toh chekhom chu chingding ahin; hinla mingol hotoh kiloija chu suhmanga umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Setna-in michonseho anungdeljin; hinla michonpha chu phatna-a kilethuh ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mipha chun achate chate ding neile gou adalhah pehjin; chule michonse te neile gou vangchu midih ho dinga kikhol khom ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vaichate loulhona-a neh tamtah aumin, hinla thutanna lhahsam jeh-a suhmanga umjong aumin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mol panlou chun achapa ahot ahin; hinla achapa ngailupa vang chun asehgimjin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Michonphan alungnachim setnin anen; hinla agiloupa vangchu gilkel ding ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Numei chingin a-in akisahdoh-in; hinla numei ngolin vang akhutnin aloilhuji-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chondih tah-a kalsongpa chun Pakai agin ahin; hinla alampiho hokhelpa chun Pakai chu i-sah louva abol ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mingol kamsunga konin kiletsahna jeng apotnin; hinla miching kamin vang amaho ahoidoh sah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bongchal umlouna-a gan ankong chu athengin; hinla bongchal thahat vanga ga tamtah kiso ji ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tahsan umtah hettohsah chun jou seipontin; hinla hettohsah lhemchun joule nal jeng seijinte.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi i-sah loupan chihna aholin, ahivangin amupon; hinla hetna kitihi ahekhenthem theidingin bailamtah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mingol kamsunga chihna aumlou nahetdoh tengle, ama-a konin chedoh jengin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Milungching chihna chu alampi akihetkhen themtheina chu ahin, hinla mingol ho ngolna chu lheplhahna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mingol hon chonset hi totnan amangun; hinla chonphaho lah-a vang khohsahna aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lungsungin amatah hesoh genthei chu akihetnin, chule midangin akipana-a jong chan aneipi poi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Migilou in chu lekhupma umding ahin, hinla mikitahpa ponbuh vangchu khangtou jing ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihem dingin adihtobang lampi khat aumin, hinla achaina le hiche lampi chu thina lampi ahiji-e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nuina jenga jong lungsung gimna aumin, chule hiche thanopna kichaina chu lunghemna ahijin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lamdih-a kon kinunghei pa chu ama lunggot lampi jenga achen, chule mipha chu chunga kon kilunglhaisah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mimolin thujouse atahsanin, hinla mi chingtheipan vang achena ding akivettup jingin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Miching akichajin, setna adalhan, hinla mingol vangchu alungsajin chule amale ama akisong ji-e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lunghangbai mi chu ngolhoi tah-in akimang chajin, chule thil gilou tamtah gongpa chu hotnin aumjitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mimolin ngolna goulo bangin alon, hinla miching vang hetna chu kikhuhpeh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Migilou chu mipha anga bohkhup ding, chule migiloute chu michonpha te kotphunga bohkhup ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mivaicha chu aheng akom jengin jong ahon, hinla mihao chun gol le pai tamtah aneijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aheng akom noise-a chun chonset abol ahin, mivaicha hepina neipa vangchu anunnom ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thilse gongho chun asuhkhelu hilou ham? hinla hepina leh thutah chu thilpha gongho-a ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tohgimna jouse-a aphat chomna aumin, hinla kama seitho maimai vang chun vaichatna alhutjin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Michingho lallukhuh chu ahaonau ahin; hinla mingol ho ngolna chu angol naohi ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hettohsah tahsan umtah chun hinkho ahuhdoh-in; hinla hettohsahna lhem chun jou le nal jeng aseije.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakai ginna-a chun kisona dettah aumin, chule achate chun kiselna ding mun aneiteidiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pakai ginhi hinna twinah ahin, thina thanga kona hoidohna ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mipi tamtah umhi lengpa-a dinga loupina ahin; hinla mihem lhahsamna-a vangchu lengchapa-a dia manthah na ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Milung nengchun hetkhenthem theina lentah anei ahin; hinla mikino thethun angolna achoisang ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lungdamsela umhi tahsa dinga hinna ahin, hinla kithang thipna hi gule chang monsahna ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mivaicha bolgentheija chun ama sempa anoise ahin, hinla ama jabol chanchun vaichate chunga khotona anei ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Migilou chu ama gitlouna a delmangin aumin, hinla michonphan vang thina chunga jong kinepna aneijin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hetkhen themtheina neipa lungsunga chun chihna achengin, hinla mingol ho lungthim sunga umchu akihedoh teijin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chonphat na-in namkhat achoisangin, hinla chonsetna hi nampi dinga themmo chana ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lengpa khohsahna chu sottol milung chingpa chunga aumjin, hinla alunghana chu jachatna sodohsahpa chunga aumin ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw nemheuva kidonbutna hin lungsatna aheimangin; hinla thucheng ngeimotah chun lunghanna asuthouve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Miching leijin hetna chu dihtah-in amangcha jin; hinla mingolte kamin ngolna ngen aphongdoh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin munjouse amusoh keijin; ase leh apha ave jingin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamdam awnema thu kisei chu hinna thingphung tobang ahin; hinla thugilou sei leigui vang lhagao suse-a ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mingolin apan ahilchahna i-sah louvin akoijin; hinla phona kisanthem michu miching ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Michonpha te insunga chun neile gou tamtah aumin; hinla migilouho phatchomna vangchu boinabou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miching kamin hetna athejalin; hinla mingol lungin vang chutin abolpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Migilouvin kilhaina abol chu Pakai dinga thet umtah ahin; hinla milungdih taonachu ama lunglhaina tah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Migilou lampi chu Pakai dinga thet umtah ahin; hinla chonphatna nung juipachu aman angailun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Suhdihna hi achena lampi dalhapa dingin athohhah-in; chule phona nahsah loupa chu thiteiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thikholkhul leh manthah na chu Pakai anga aumin; achutile mihem chate lungthim jong chusanga khohcheh louding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi i-sah loupa chun aphohpa chu angailupon; ama michingte koma jong cheponte.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lungsung kipana chun kipana maiso asosah-in; hinla lungjin nahin lhagao asusen ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hetkhenthem theina neipa lunggil chun hetna aholin; hinla mingol ho kam vangchu ngolna-in akivah-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Suhgentheija umte dingin nikhojouse chu aphalou jeng ahin; hinla lungkipah-a umten tanglouvin golnop anei jinguve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai gingpuma themcha neichu, neile gou tampi boina toh neitha sanga phajo ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kidou puma bongchal thaotah neh sangin; ngailutna puma anche me neh aphajoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lungsat kengpan kinahna achoh thouvin; hinla milung nengin kinahna asuchamin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mithase chenalampi chu lingtho kikaitobang ahin; hinla michonpha lampi chu lamphei ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chapa chingin apa akipasah-in; hinla chapa ngolin anu anoise-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngolchon kitihi chihna-a lhasampa dingin thanopna ahin; hetkhen themna neipa vang dihtah-in achon jinge.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thumopna umlouna-a thil kigongho chu alhasamjin; hinla thumopthem tamna-a chun hicheho chu akimolso jin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihem chu dihtah-a donbutna akipeh jallin thanopna aneijin; chule thucheng khat aphatcha kiseidoh chu iti phatna pha hitam!
  </para>
  <para style="p">
    <verse number="24" style="v" />Noilam thikhol khul'a kona akiheimang theina dingin; hinna lampi chu milungching dingin chunglama aume.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi kiletsah insung chu Pakaiyin alhuhsah ding ahin; hinla aman meithainu gamgichu aphudoh ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Migilou lunggel ho chu Pakai dinga thet umtah ahin; mitheng thusei ho vangchu thucheng ngeitah ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mikilose chun a-insung asuhboi bep ahin; hinla nehguh thilho thetbolpa chu kihinso teiding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Michonpha lungin adonbutna ding akigeltoh in; migilou kam invang thilseho asodoh jingin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakai chu migiloute-a konin agamlan; hinla michonpha taona vangchu aman angaipeh-in ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mit ha hoi selin lungsung akipasah-in; chule thulhut phatah chu gule chang ho dinga damna ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinna dinga kiphona ngailha nakhang chu michingte lah-a achengin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hilchahna donloupa chun amatah-in hinna chu i-sahlouva akoi ahin; phona kingaipa vang chun hetthem theina akimudoh-in ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chihna hilchahna chu Pakai ginding hi ahin; chule jana masanga chun kineosahna aume.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihem in alungthimin tohgon aneijin,; hinlah kamsunga kon donbutna chu Pakaiya konbou ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem khat-in ama mitvetnin alampi jouse chu athengselin amun; ahinla Pakaiyin lungsung chu akholchilin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanatoh jouse chu Pakaiya pedohjengin, chutile nalunggel ho chu lolhingtei ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin thiljouse ama dinga asem ahi, henge, migiloute jengjong nikho phalou ni-a dinga asem ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lungsunga kiletsah tapouchu Pakai dinga thet umtah ahin, khutle khut kituhmat to jengjongle, ama chu talen manlouva umlou helding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hepina leh thutah-in khangitlouna asuthengin; chule Pakai ginna jal-in mihem ten setna adalhaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi achondanin Pakai akipasah tengle, amelmate jengjong amatoh akichamsah-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chonphatna puma thil themcha khat neichu, alamlouva kimu thil tamtah sangin aphajoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihem khat lungsungin ama lampi agongin, ahinla Pakaiyin vang amapa kalsonna dingho akopeh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen thutanlhahna chu lengpa kamsunga konin apotnin; akamin jong thu atankhel louding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Agih dihtah leh khaikot dihtah chu Pakaiya ahin; dip sunga um thilgih kitedoh jouse jong ama boljeng ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Phatlouna tohdohhi lengte dinga thet umtah ahi, ajehchu laltounahi chonphatna-a kitungdoh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dihtah-a thu kisei chu lengho lunglhaina ahin, chule amahon thudih seija chu angailuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lengpa lunghana chu thina thupole tobang ahin, ahinla michingin vang hichu asulungdam jin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lengpa maiso vah-a chun hinna aumin, chule aman akhohsah mi chu gotuilha nunung twimei tobang ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sana sanga chihna kimudoh hi iti phatna pha hitam! chule dangka sanga hetkhen themtheina kilhenjohhi iti phatjoh hitam!
  </para>
  <para style="p">
    <verse number="17" style="v" />Midih lamlhongpi chu agilouva kona kiheimang hi ahin, alampi kituhdetpa chun ahinkho akivettup ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Manthah na masanga kilet sahna achen, chule lhuh nading masanga hoithona achen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mikiletsahho toh thil kichomdoh kihop sangin, kineosah puma minoinung hotoh umkhom aphajoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Koihile hilchahna ngaipha-a chun thilpha akimudoh-in; chule koihile Pakai tahsan chanchu anunnom ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Alungsunga chihna nei mi chu thil hekhen them kitiding ahin, chule nemheuva thu kiseijin hetna apunsah-e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hetthem theina hi aneijoupa dingin hinna twinah ahin, ahinla mingol ho hilchahna chu ngolna ahibouve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Michingin alungsunga chihna mangchan thu aseijin; chule amuh dingin kihilna abepeh-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngainom um thuchengho chu khoiju tobang ahin, hinna-a dinga lhumkei le gule changho dinga damna ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihem dingin adih tobang lampi aumin, ahinla chuche lampi chu akhonna thina ahijin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Natong gimma chun amadinga atohgim ahi, ajehchu agilkel chun atohsah ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathen ngaisahlou michun setna alaidohjin; chule athusei jong meikong tobang ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jon lunggelin kinahna atun, guhthim thu seile pan golcha phatah ho asukhenjin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hunam panpa chun aheng akom atilsejin; chule lampi phalouva apuilutjin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman hoitho thil mitsing leuvin agongjin, akam achaloh sah-in thilse ahinlhutjin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tehse samkang hi loupina lallukhuh ahin; Hichu chonphatna lampia kon bou kimu ahi
  </para>
  <para style="p">
    <verse number="32" style="v" />Lunghan nalama ngaikhampa chu thahattahpa sangin aphajon, chule alungsung kivaihom joupa chu khopi khat lapa sangin aphajon ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pheichunga chun vang akisang jin; hinla thulhahna jouse chu Pakaiya ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lunglhai sela an-gum kamkhat neh hi, kinah puma insung dimset golvah an neh sanga phajo ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Soh chingtah-in jachatna semdoh chapa chunga vai ahop ding; chule sopiho goulona lah-a chu chan aneiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dangka dingin lhit thengna bel, chule sana dingin lhummei akimangin; ahinla Pakaiyin vang lungsungho apatepjin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khanset bolpa chun jouthu jeng angaijin, chule mijouvin thil gilou ngaina dingin ana asunge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Koihile mivaicha daichavaija chun ama asempa i-asahlou ahin, chule midang vangsetna chunga kipahpa chu talen manlouva umlou helding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Achate chate chu tehse hodinga lallukhuh ahin, chule achateu loupina chu apateu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mingolin thugiltah aseidohle akilompon; chusanga chu leng chapan jou aseiding chu kilommo cheh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kipamana kipe thil hi aneipa mitna songmantam tobang ahin, amachu akiheinalam tina akhangtouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Suhkhel khukhumpa chun ngailutna ahol ahin; ahinla thilkhat velphoh jingpa chun golphatah jong asukhenjin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mingol khatnin jakhatvei jepna atosangin, miching khatnin khatvei kiphona chu na asajon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi gilouvin kiphinna ding jengbou aholin, hijeh-a chu mi engse thupole khat ama doudinga kisol ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mingol khat angolpet tosangin, vompi anouho kilohpeh khat toh kimaito abaijon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koi hile apha chu ase-a lethuh chanchu, insunga kona ase kichoidoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kinah kipatnahi mikhatnin twi agah londohsah tobang ahin, hijeh chun kinahna asodoh masangin kinelna chu dalhan.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miphalouho themchan sah-a, chule midihtah ho themmo chansah-a chu anilhona Pakai dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chihna-a alunglut lou mingol chun, ipikhoh-a chihna chohna dinga akhutna sum achoi dingham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Loile gol chun phat jousen angailun, sopi vang genthei nikho-a dinga peng ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hetthem theina neiloupa chun akhut abengton, chule loile gol anga kitepna neija dingpa-in ahungpang jitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Suhkhelna ngailupa chun kinahna adei ahin, chule akotpi choisanga chun manthah na ahol ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khangitlouna lung neipa chun thilpha amupon; chule joule nal seijingpa vang thilphalou va alhalut jitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mingol chu ahingpa din gimna ahin; chule mingolpa pa chun kipana aneipoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lungsung kipana hi loule ai phatah abangin; ahinla lung gentheina vang hin gu le changho agotsah-in ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Migilouvin thutanna lampiho heikoina dingin, guhthima thilpeh akilahjin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hetkhenthem theina neipa masanga chihna aumin, ahinla mingolpa mit vang chun leiset mong gei ave lelen ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chapa ngolchu apa dinga gimna ahin, chule anu dinga hesohna bep ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chujongle midih gotna peh-a, ahiloule thu adih-a tanjeh-a pipuiho jepna kipe jongchu dihlou ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hetna neipa chun ngaikham tah-in thu aseijin; chule hetkhenthem theina neija michu milungchingtah ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mingol jengjong thipbeh-a aum tengleh michinga sim ahin; chule akam kihup pa chu hetkhenthem theina neimi ahi tin akive sange.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mipi lah-a kon kikangse mihem chun, ama phatchomna ding maimai bou aholin, thudih jouse douvin apangin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mingol chun chihna le hetna-a kipana aneipon, hinlah ama lunggel jengbou phondoh ding adeije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Migilou ahungtengle i-sah louna jong ahung jin, chuleh minsetna ahungteng jum na ahungjin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihem khat kamsunga kon thupot chu twithuh tahho tobang ahin, chihna twinah jonghi vadung longjing tobang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thutanna munna migiloupa panpi-a, chuleh michondih pa themmo chansah jongchu phaloutah ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mingol thusei chun kinelna asosahjin, chule akamsungin ama kijepnading akiseidoh ji-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mingol kamsungsoh chu amadinga manthah na ahin, chule athusei chu ahinkho kisuh mangna dinga thang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Guhthima kisei thucheng chu nehle chah tuitah tobang ahin, chule oisunggil lampeh a alutjin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anatoh na-a thasepa chu, ijakai susepa toh sopi khat ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai minchu insang dettah ahin, hia chun michonpha te alhailut alhailutnun ahoijuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihaopa dinga anei agouchu akhopi dettah tobang ahin, chule akiletsahpi tah kulpi sangtah tobang ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Suhmangna masanga chun mihem lungthima hoithona aumin, chule jana masanga kineosahna aumin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thu angailhah masanga donbut jengpa chu, amadinga ngolna leh jachatna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihem lhagao chun mihem adammo na-a kon adamsah jou ahin, ahinlah koiham lhagao damlouna thohjou dinga?
  </para>
  <para style="p">
    <verse number="15" style="v" />Milung chingin hetkhena akimudoh-in, chule miching nakhangin hetna aholin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihem khat chu athilpeh-in ama dingin mun asem peh-in; chule amachu milen, milal ho masanga ahin puilut jin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama chungthu kisei masatpa chu adihtah danin akilangin; ahinla aheng akom chu ahungin ama ahung kholchiljin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vang san nahin kinelnaho asuthipmin, chule mithahat te jong asukhenin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sopi kisunohsa jollut kitna chu khopi dettah lahsangin ahahsajon; chule amaho kibaona chu kulpi pal kigenho bangjeng ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihem chu akamsung soh jala oiva setna umding, athusei phatchomna jala ama vaset ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Leigui hin thina le hinna thahatna aneijin, chule chuche ngailuho chun aga akineh dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Koihile jinu kimu-a chun thilpha akimu ahin; chule Pakai khohsahna chu changa ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mivaichan taona jeng amangchan, ahinla mihaovin vang hoithotah-in adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Golle pai tamtah nei mikhat chu amajong agolho dinga golphatah hiding, hinla sopi tah sanga ikinaipi goljong aumin ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Genthei jongle kitah tah-a hinkho mangpa chu, thugilou seija mingolpa sangin aphajon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hetna beija umhi aphapon, chule chonset na-a kaljangpa jongchu aphadeh pon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem angolna chun alampi aheimangpeh-in, chule alungthim sunga Pakai adouvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Neile gouvin loile gol tampi asemdoh-in, ahinla vaichapa chu aheng akom jengin jong adalha jitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hettohsah lhem chu talen manlouva umlou ding ahin, chule jou le nala thusei jongchu hoidoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pipuiho khohsahna chu mitam tah-in angeh dingu ahin, chule thilpepa din mitin chu agol apai ahijitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mivaicha chu asopite jousen jong ahot boluvin, agolho chu ama-a konin iti agamlat tadiuvem? Aman amaho chu ngehna le taona pumin anung delpeh-in, hinlah amahon adon tapouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chihna kimudohpa chun ahinna angailut ahin, hetkhen themtheina kichin pachun thilpha amuteiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hettohsah lhem chu talen manlouva umlou helding, chule jouthu seipa chu mangthah teiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nomsa tah-a hinkho mandinghi mingol dingin akilompon, soh khatnin pipuiho chunga vai ahomding jong akilompoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihem lunggel themnan alunghana asudamin, chuleh ama douna-a thil kibol angaidam jouchu aloupina ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lengpa lungsatna chu keipi kitum tobang ahin; ama mikhohsahna vang chu hampa chunga daitwi lha tobang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chapa ngol chu apadinga hamsetna ahin; chule kinel kalna dimset inneipi chu tanglouva vajing gotwi tobang ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Inle lou, chule neile gou jouse hi pate-a kon kilason gou chu ahin, chule numei ji phatah vanghi Pakaiya kon ahi
  </para>
  <para style="p">
    <verse number="15" style="v" />Thasetna hin mihem a-imut lhuhsah-in; chule mi thase chun kel athoh ding mong ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thupeh nitpa chun ahinkho akichintup ahin, ahinla alamjot na-a chingtheilou chu thitei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mivaicha chunga khotona neipa chun Pakai apeh ahin; chule aman anapehdohsah chu alepeh kitding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kinepna aumpetnin nachapa bolgimin, chule suhmanga aumding jong gel hih-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Milungchomin talen amat teiding ahi; ajehchu nangman ama huhdoh jengle chun avela abolkit teiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khonunga nachih theina dingin, hilthemnale hilchahna hi ngaijin lang kisanin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihem lungsunga thilgon tampi aumin, ahijeng vangin Pakai thilgon leh phatsah bouchu kiphutdet ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihem khatnin angaichat chu lungsetna chan hi ahin, chule joule nal sei mihem hisangin mivaicha hiding aphajoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakai ginna-in hinna-a apuilutnin, chuche Pakai ging mi chu lunglhai ding ahin, thilsen alhunkhum louhel ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mithasen akhutnin abukong asohlut jin, akam sung geija hin dop ding jong angapcha poi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mitaitompa akijepleh, mimolpan chih theinan aneijin, chule hetkhenthem theina neipa chu phohsal lechun hetna-a khangtou ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Apa lamlouva engbola chule anu delmanga chu jum nale jachatna hinpolut chapa chu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kachapa, hetkhen themna-a kon nachekhelsah thumop ho chu ngaita hih hellin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathen jalou hettohsahpan thutanlhahna dihtah chu ataitomin, chule migilou kamsungin khangitlouna chu avalhume.
  </para>
  <para style="p">
    <verse number="29" style="v" />Gotna hohi mitaitom ho dinga kisem ahin; chule kijepnahohi mingol ho tungtuna ding ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ju hi midai chavai ahin, chule akidontho khamnathei jong kinahna ahibouve. Hicheho kipui mangsah chu miching ahipoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lengpa lungsatna hi keipi kitum tobang ahin; koihile ama lunghan sah-a chu amatah hinkho achanlo teiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem khat dinga kinahna-a kon akikangse thei chu, ja achan na ahin; ahinla angol tapouvin kinahna asosah theije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thasepan daplai ahijeh-in lou alhoupon, hijeh-a chu chang at tengle aman khut adolea imacha neilouva umding ahije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihem lungsunga um hilthem theina hi twi thuhtah tobang ahin; ahinla hetkhentheina neipan akithaldoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mitam tah-in ama changseh phatna aphongjal len, ahinla mi kitah tah chu kon amu jouding ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Midih chu ama kitahna-a achon lejin, ama nunga achate jong phat theina achanguve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thutanna laltouna a tou lengpan amit tenin thil gilou jouse chu athecheh-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koiham kalungsung kakisop thengtan, kachonsetna-a konin kathengtai, tia aseithei ding?
  </para>
  <para style="p">
    <verse number="10" style="v" />Thilgih kibanglou leh thilgih tena dihlou chu, kibangtah-a Pakai dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chapang khat jengjong anatohchu atheng ham, adih ham, athilbola konin akihekhen jenge.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khojah theina kol leh, khomutheina mit jengjong, ania Pakaiyin asem cheh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Imut dingjeng ngailu hih-in, vaichatlo getnin nate, namitteni hasah jingin,chutile changlhah-a naneija, nalunglhai ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thilchopan hichehi apanna aumpoi, hichehi apanna ding aumpoi, tin aseijin, ahin achedoh tengle vang akithang-at jie.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sana aumin chule songmantam tampi aumnai, ahinla hetna hungsodohna kam vangchu songmantam lutah khat ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gamdang mikhat dinga kitepna thilla kitungpa ponsil chu lahpeh un; chule gamdang numeinu khat dingin kitepna thilin mangun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihem khat dingin lamdih louva kimu changlhah hi atuijin; ahinla chomkhat joutengle akamsunga chu songbong dimding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thilgon tapouhi thumopna in aphudoh ahin; chule kihilna phatah in gal asat ahibouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Guhthimthu seija vahlelepa chun thu ki imho aphongdoh jin; hijeh chun akama thuphalou seile hotoh kitimat hihbeh in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Koihile apa ahiloule anu samse-a chu; ameivah muthim lah-a kisuhmit pehding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Neile gou chu abul lang gangtah-a gahlothei ahinai; ahinla akichaina chu phattheibohna hilouhel ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keiman setna chu kalethuh teiding ahi, tin seihih beh in; amavang Pakai chu ngah-in, aman nangma nahuhdoh teiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thilgih dihlou chu Pakai dinga thet umtah ahin; chule thilgih tena dihlou jongchu thilpha ahipoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihem chenahohi Pakaiya kon ahin, achutile mihemin ama lampi iti akihet khenthei ding ham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Kinotah-a thilkhat chu atheng ahi tia, chule kitepna ineijouva nungkhol kitding kiti hi mihem dinga kipal lhuhna thangkol ahibouve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Leng chingtah chun migilouho athe cheh-in, chule achunguva changvohna kanglum chu atangjin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihem lhagao chu Pakai meivah ahin, hichun mihem lungsung jouse akhol chilsoh ji-e.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hepinale thutah-in lengpa chu achingtup jingin, chule ngailutna-in alaltouna chu achoisang jinge.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khangdongte loupina chu athahatnao hi ahin; chule tehse ho melhoina chu asam kannu hi ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thoh hahsatah kijepnan agilou chu asopthengjin; hibang chun kijepna-in sunggil laiho jouse asuthengin ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lengpa lungsung chu Pakai khutna um ahin, twi lonna vadungho bangin aman agot nalam lama aheijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihem khat mitmun ama lampi tapouchu adih-in amun, ahinla Pakaiyin lungsungho joh akholchil jin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dihtah-a thil kibole, dihtah-a thutan nahi, kilhaina sanga Pakaiya dinga santhei joh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eima chang kivetsangna leh kiletsahna lungsung, chule migilou chalohna jousen chonset aboldoh jin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gunchupa lunggel ho chun ninglhin namun alhunsah-in, ahinla kikinsah tapou chu lhasam dingbou ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Joule nala kimu neile gou chu thina holho dinga pannabei suhle tunga lengle ahibouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migilou ten aguhdoh-u thil hochun amaho asuhmang teiding ahi; ajeh chu amahon thudih ajuinom pouve
  </para>
  <para style="p">
    <verse number="8" style="v" />Chonsepa lampi chu alam jangpon, hinlah chonphapa natoh vang adihjeng ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Inn lentah sunga numei nelhat khatto chenkhom sangin, in chung ningkoi khatna chen joh aphajoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migilou lunggel chun thilse adeijin, aheng akomin ama mitna khohsahna amujoupoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mitaitompa gimbolna akipeh tengle milhamin chihtheina aneilo jin; chule miching chu akihil teng aman hetna akimujin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Michonpha pan agiloute insung chu alungthima chingthei tah-in angaitojin; hinla Pathen'in agiloutechu agitlounau jal-in alehkhup jitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koi hijongle vaichate kapetna akol kisipma chu, amajong hungkap mintin hinla kijahpeh talou ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aguh-a thil kipe hin lunghanna adailhah sah-in; chule pon noija nehguh kipe hin lungsatna nasatah asudaijin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thu dihtah-a tanding hi midihte kipana ahin, Hinlah thilgilou bolte chunga manthah na hung lhungding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hetthem theina lampia kona vahmangpa chu, athiho kikhop khom nalah-a umding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nopsahna ngailu-a chu vaicha teiding ahin, koihile jule thaova lop chu haosa louhel ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Migiloute chu michonpha te dinga kilhatdohna-a pangdiu, chule mikitahloute jong mikitahte lhatdoh na-a pangdiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Numei nelhat jingle lunghang jingtoh chenkhom sangin, gamthipma chending aphajoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Michingtah chenna in'a chun deichatthei neile gou, chule thao aumin, ahin mingolin vang akisuhmang joujitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koi hile chonphatna le hepina juija chun hinna, chonchan phatna chule jana akimudoh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Miching chun mithahat ho khopi jong atedoh jouvin, chule amahon akisonpiu athahatnao jousejong asuchim jouvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Koi hile akamle alei kitimthem chun, alhagao lungjinna-a kona akivenbit ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kiletsah tah-a lunghangpa minchu kiletsah leh taitomhat ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mithase chu angaichat nan athatjitan ahi, ajehchu akhutnin na atonggim nompoi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nilhum keijin aman neipap leh kiloset abolin, ahinla chonpha pan vang apedoh in khen ima aneipoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khangitloute kilhaina chu thet umtah ahin, aman lungthim phalou puma ahinchoi teng iti thet umcheh ding hitam?
  </para>
  <para style="p">
    <verse number="28" style="v" />Hettohsah lhem-a pang michu mangthai teiding ahin, hinla thukisei ngaithempan vang tanlouhela thu aseiding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Migiloupa chu akimoh hansan sah-in, hinla mi kitahpa vangin alampi akigeltoh jingin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chihna hihen, hetkhen themna hihen, thumopthemna hijongle Pakai douthei dinga aumpoi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sakol chu gal kisat nikho-a dinga gotsa ahitan, hinla galjona chu Pakaiya kon bou ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Minphatna hi haona tamtah ho sanga kilhending aphajon, chule ngailutna a kikhohsah nahi dangkale sana sanga kilhenjoh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahaole avai aumkhomin, abonuva sempa chu Pakai ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Milung chingin thilse hunglhung ding chu amu masan, hijeh chun akiselin, ahinla mimolhochu achepaijun talen amanjitaove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kineosahnale Pakai ginna-a chun haona, jana chule hinna aumin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khanggilouho lampia chun lingle thang aumin, ahinkho kichintuppa vang hicheho-a kona chu gamlading ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chapang chu achena dingdol lampia khoukhah-in; chutile ama ateh teng jongle hia kona chun kiheimang taponte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihaovin mivaicha chunga vai ahomin, chule abatpa chu abatsahpa soh-in apangin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khangitlouna tupa chun ahomkeo aki at ding ahin, chule alunghana mol chu thon ding ahije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihongphal chu phatthei kiboh teiding ahi; ajehchu aman achanglhah jengjong vaichate din apedoh jin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mitaitompa chu deldoh un chutile kinelna beitante; henge, kinahnale kihousetna jong tang tante.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lungthenna ngailupa chu akamdam jeh-a lengpa gol hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai mit tenin hetna avetupmin, chule aman suhkhelna neipa thusei ho chu alehkhup helin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mithasepa chun, polama keipibahkai aumin, lampi kahlah ho-a keima eithat ninte, tin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hetkhahlou numei ho kamsung chu kotong thuhtah ahin, Pakai hotna umpa chu chua chu lhalutding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chapang khat lungsunga chun ngolna aumin, ahinla sudihna molchun ama-a kona gamlatah-a anomang ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahaonaho puntheina dinga vaichaho joulhepma, mihaoho pehbepa vangchu thonlouva lhasam teiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nanakhang hinsungin lang miching thuseihohi ngaijin, chule keima hetna lama nalungthim hinmang chan.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu nangman nasunga hicheho chu nakichin tupma ahile, lunglhaina ahin, hicheho chu nakama jong naseiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakaiya natahsana aumtheina dinga, tuni nikho-a keiman nangmatah henga hetsahna kabol ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hetna thu hihen thumop phatah hijongle, thilpha chungnung chu keiman nahenga kahinsut hitalou ham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Thudihho chu thutahbeh mong ahi nangma kahetchetsah nadingle nahenga hungkisol ho henga thutah hochu nadonbut theina dinga keiman nahenga kahinsut hitalou ham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Mivaichaho chu chomhih-un, ajehchu ama mivaicha ahi; kotpi phunga jong gentheiho chu bolgim hih-in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Pakaiyin amahothu chu aseitohpeh-a, chule vaichaho chomho hinna chu aman achom ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Milung hang jingtoh kigolcha hih-in; chule milungkhoh toh nangma chekhom hih in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Achuti loule nangman ama lampiho hekhan natin, chule nahinkho-a din thang hikhante.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kitepna chunga khut lhaho lah-a nangma khat nin jong pang hih-in, ahiloule sum kibat jeh-a midinpeh ho lah-a jong pang hih-in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangman pehding imacha naneilou ahitahle ipi dinga aman nalupna jalkhun chu alahmang dingham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Gollui laija napu napateu vin anatun dohsao, gamgi chu chon mang hih-un.
  </para>
  <para style="p">
    <verse number="29" style="v" />Atohna lama gunchu mi namu em? amachu lengho anga dingtei ding, mi maimai anga dinglou helding ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangma thunei vaihomho khat toh an nedinga natoutengle, na anga ipi ummam ti phatechan gellin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule an dutah mi nahile nalol la chemcha kidojingin.
  </para>
  <para style="p">
    <verse number="3" style="v" />A-anneh tuitahho chu ducha hih-in, ajehchu hicheho chu kilheplhahna an ahibouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Haoding tupnan kisulung gimval hih-in, nangma chang kichihsah hih-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman aumlou thil chu namit teni-a navet dingham? Ajehchu thonlouvin haona hohin lhaving akisemun, van lama muvanlai bangin alengmangji taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Michip pa changlhah chu nangman nehih beh-in; ama antuiho jong ducha hih-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu amachu alunga agel bangbang hija ahin; nenlang donin tin nahenga aseijin, ahinla alungthim chu nangma toh aumkhom pon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman nanehsa anchu nalohdoh ding; chule thu ngeitah naseiho jong pannabei hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mingol nakhanga imacha seihih beh-in, ajehchu chihna thu naseiho jong i-sah louva akoiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gollui laija gamgi lui melchihna ho chu ladoh hih-in, chule pabei ho gamsunga jong lutdan.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu amaho lhatdohpa chu thaneitah ahin, aman athuchu nahenga aseitoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hilchahna lama nalungsung mangchan lang; chule nanakhang teni chu hetna thu lama mangchan.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chapang kisuhdih nahi tuhtang hih-in, ajehchu nangman ama molin jep jongle chun thiponte.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman ama mola najepding, chutile ama lhagao thikhol khul'a kona nahuhdoh johding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kachapa nalung achih-a ahile, kalung kipahlheh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Henge, nangman nakama thil dihho naseidoh tengle, kalung gilla kakipa ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nalungin michonseho thangse hih-in, ahinla nangman nilhumkeijin Pakai chu gingin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu tahbeh a akichaina khat uma ahin, chule nakinepna chu kisei tanlou ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kachapa nangman ngaijin lang chihnan neijin, chule hiche lampia chun nalung puihoijin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Judon hole saneh hat ho lah-a nangma lhahih in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu jukhamho leh milopho chu vaicha teiding; chule imutsona chun mipa chu ponse avonpeh ding ahije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nahinga napa thu kingai jinlang, nanu ateh phatteng jongle nahsahmon bolhih-in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thutah chu kichoh-in, chule chihna, hilchahna hetkhen themtheina, jong kichoh inlang johdoh tahih-in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Michonpha chu apa hapah-in kipah intin; chule chapang ching hingpa chun amajalla kipana aneiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nanu leh napa kipah inte, chule nahinga nanu chu kipah thanom ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kachapa nalungthim neipen, chule namitnin kalampiho vetupmin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu notinu chu kokhuh thuhtah tobang ahin; chule hetlou numeinu chu kokhuhjim ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amanun jong gucha michom bangin mi achanglhin; chule mihem ho lah-a chun suhkhel neiho apunsah-in ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Koiham dana nei? Koiham gimna nei? Koiham kinahna nei? Koiham kiphina-a nei? Koiham ajehbeija tina maha pu-a? Koiham mit san dehduh neija?
  </para>
  <para style="p">
    <verse number="30" style="v" />Amaho chu juphola khongaisotna ju kihalna hola vahle ho chu ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ju chu asanphat laitah vetdan, khonjong asansah-a achama naljella alonlhah jongle nangman vehih-in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Akhonnale hichun gul bangle gulsum gu hattah bangin achujin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Namit tenin hetkhahlou numei ho avetna, chule nalunggilla jong thildihlou jeng nagelding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangma twipi lailunga lumpa nabahding, ahiloule kongsunga kitungdoh khom sangtah leh-a lumpa nabah ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amahon eivouvin ahinla keima kanapoi; amahon eidengun ahinla kahephapoi; itihle kei kakhangdoh tadem? Kaholbekit nahlaiding ahi, tia naseiding ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migilouho chu thangset hih-in, amahotoh umkhom ding jong ngaicha hihbeh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu amaho lungsungin manthah na lamjeng agelin; chule akam sungun aphalou aseijuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chihna vangin in akisahdoh-in, chule hetkhenthem theina jal-in akiphutdetne.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hetna jala indanho chu manlutah thil le lo, chule lungdei umtah neile gou dimsetna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miching chu atha ahatnin; henge, hetna neipa thahatna chu khangtou ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu chihna puma thumopthemna vanga nangman gal nasatding ahin, thumopthem ho tamna lah-a hoidohna aume.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mingol dingin chih gilnahi asang behsetnin, aman kotpi phunga akam akehpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thilse bolding gongdohpa chu, miphaloupa kitiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lunga ngolhoi thu geljing hi chonset ahin, chule mitaitompa chu miho dingin thet umtah ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kidouna nikho-a nalung alhah-a ahile, natha chu lhoma ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangman thina lam jonna kijot hole, akithat dinga gotsa umteho huhdohna dinga pohnatna nanei louva;
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman, keihon kanahepha pouve nati vangle, ven, ama milungsung vetuppa chun hichu agelkhoh louding ham? chule nahinkho hoituppa chun ahetlou dingham? chule aman mijouse chu anatoh dungjuija lethuhna apehlou ding ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Kachapa khoiju chu ne-in, ajeh chu tuitah ahi, chule khoiju phang jongchu ne-in, nakam sung dinga lhumtah ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chihna le hetna jong chu nalhagao dinga khoiju tuitah tobang ahin, nangman hichu nakimudoh teng kipaman nasanding, chule nakinepna jong thon louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vo migiloupa, michonpha chenna mun dounan changlhi hih-in, akicholngahna munchu suse hih in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Midihtah pa chu sagivei lhu jongle athoudohkit jin, ahinla migilou vangchu setna-a lhalut teiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Namelmapa alhuhteng nangma kipah hih-in, chule ama akipal lhuh tahjongle nalung kipasah hih-in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Achuti loule Pakaiyin hichu muntin, hichun ama alung hansah-a, chule ama-a kona alunghana aheimang louding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thil gilou bolte jeh-in nangma lungkham hih-in, migiloute umchan jong thangse hih-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu thil gilou bolpa dinga kipaman umlou helding, chule migiloupa meivah chu kisumit ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kachapa Pakai le lengpa chu gingin, chule vaihom gilouho lah-a jong kikumlut hih-in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu amaho chunga hamsetna photlot louva hungsoh ding ahin, amani manthah na hinlhut ding chu kon ija ahet em?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche thilho jonghi miching ho-a ahi. Thutan na-a sihnei langnei bolding apha poi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Migiloupa jah-a, nangma michonpha nahi tia seipa chu, amachu mipin asapset ding, namtinin ahotbol dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla migilou phohsalho chunga chu kipana umtei ding, chule phattheina chu achunguva chuding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dihtah-a donbutna pepa chu mijousen abengchop ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Polama nanatoh ding gotsan koijin, chule naloulaija nanatohna ding jong kigottup masatnin, chujou tengle na in kisah-in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajeh beijin naheng nakom dounan hettoh sah-in panghih-in, chule nakamin koima lhemlha hih-in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman eibolna bangin keiman ama bolinge tin seihih-in, anatoh dungjuijin keiman lethuh inge tin seihih-in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Keiman mithasepa loumun leh, hetthem theina neiloupa lengpilei chu kagah jotpan:
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule ven, apumpin lingle khaovin adipsohtai, chule sachih-in apheng alhangin akhujeng tan, chule songtho kisejong achimlha joutai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin keiman hichu kamu phatnin, phatechan kagelin, hiche kavetna-a konchun hilchahna kachangin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chom chakhat imutna, chom chakhat lulhuh-a, chom chakhat khut gahlhepto-a imut;
  </para>
  <para style="p">
    <verse number="34" style="v" />Hitobanga chu kholjinpa banga vaichat nan nangma nahin lhunkhum ding, galmanchah choipa banga gentheinan nahin phah ding ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheho jonghi Solomon thuchihho; Judah lengpa Hezekiah mitehon anasutdoh-u chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen'in thilkhat aselguh hi ama loupina ahin; ahinla thilkhat holdohhi lengho ja achan nao ahije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Van asan bangle leiset athuh banga hi, lengho lungsung jong holdoh hoi ahipoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dangka-a konin a-eh ladohle chun, thih khengpa dinga bel hung sohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lengpa angsunga konin mikhang gilou chu puidoh lechun, alaltouna chu chonphatna-a kiphutdet ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lengpa angsunga nang le nang gavahlut hih-in, chule milen milal ho umna mun'a gading hihbeh-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu namitna namu lengchate masanga suhnema naum sanga, hilama hungtouvin tia nahin kou diuchu nang dinga phajo ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kinah nadinga kino tah-in che hih-in, ijemtin naheng nakomin najumso khale, achainale nangma jong bolding helouvin umkhaget in nate.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nachung chang thuchu na inhengpa toh seikhom lhonin, chule midang henga thuguh himhim seidoh hih-in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Achutiloule hiche thuguh hedoh chanchun nahin jumson tin, chule naminsetna chu mang talouhel ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thu dihtah-a kisei hi dangka kigol lah-a sanatum tobang ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thu kisei ngaipa dinga kiphona dihtah hi, sana bilba le sanathenga kisem kijepna tobang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tahsan umtah thupole-a mihem chu, asolpa dinga chang at laija buhbang dapjen tobang ahi; ajehchu aman alamkaite hinna asunou vin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Koi hile thilpeh dihlou kithang atpi-a michu, meibol jingleiloi le hui nunga go julou tobang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thohhat na-in vaihom khat ajol lhajouvin, chule awnema thu kiseihin gule chang jong asubong theijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangman khoiju namu em? naneh jou khambep ne-in; achutiloule vavalin natin lodoh khagetnin nate.
  </para>
  <para style="p">
    <verse number="17" style="v" />Naheng nakom insung hachot lut behseh hih-in, injole natheichim valintin, nahotlo khante.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aheng akom douna-a hettohsah lhem-a pangpa chu, moltum lentan, chemjam chule thalchang hemtah tobang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lungjinpetna kitahna neilou mikhat chunga kinep hi, habongle kenggu kipel tobang ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lunggim gentheija umkhat henga la sapa chu; daplaitah-a mi ponsil lahmang pehpa tobangle, lengpitwi thuhtah kisuhkhahna maha chunga kisunglha tobang ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Namelma chu agil akela ahile nehding penlang, adang achahle donding twi pe-in;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutia chu nabola ahile nangman ama lujanga mei-am nasunlhah peh hiding ahin, Pakaiyin nangma tohphat man napeh teiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sahlam huijin go asem mangin, hitobang chun kiseisetna hin lunghanna maiso asodohsah-e.
  </para>
  <para style="p">
    <verse number="24" style="v" />Numei hansetah toh inlen khatna chenkhom sangin, in chung ningkoija chending aphajoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gamlatah-a kona thupha hunglhung hi, adangchahpa dinga donding twidap tobang ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Migilou angsunga michonpha abohkhup dinghi, twinah phalou le twinen putna twisam tobang ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khoiju tampi neh aphatlou bangin, mihem hon amachang loupina akiholu jonghi aphapon ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amatah lhagao thunun jouloupa chu, khopi chimlhasa le kulpi umlou tobang ahibouve.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nipilaija buhbang alhah bangle, chang-at laitah-a go ajuh bangin, jana hi mingol dingin akilompoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vacha lengle le pelpa lengle bangin, ajehbeija kisapsetna jong atang deh poi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sakol dinga jepna, sangan dinga kamdal, chule mingol tungtun dinga mol uma ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mingolpa chu angol dungjuijin donbut hih-in, amatoh bang khagetnin nate.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mingol chu ama mitmu-a akichihsah louna dingin, angol dungjuijin donbutnin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mingol khat khutna thuthotpa chun, amatah keng akitanboh-a chule setna twi adon tobang ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kengbaipa keng tenichu akibang ngaipon, mingol ho kamsunga kon kisei thulem jong chutobang chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mingol jana pepa chu, ahsongse-a songchang khitpa tobang ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mingol ho kamsunga kon hungpot thulem chu, ling hemjet khatnin jukham khat akhut adotlut tobang ahibouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thiljouse sema Pathen loupitah chun, mingol hole chonkhelte tohman apecheh-e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Uichan aloh lhahsa anehkit ji bangin, mingol jong angolna-a akile kitjin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihem ama mitmu-a kichang chihsah namu khah em? hichepa sangchun mingolpa din kinepna aumjoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mithasepan, lampia keipi bahkai aumin, khopi lamlen ho-a keipi bahkai aume, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kotkhah chu akikam na-a akiheilele bangin, mithase chu ajalkhuna akiheilelejin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mithasen akhutnin abukong asohlut jin, akam sung geija hin dop ding jong angapcha poi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil hethem le lunggel them mi sagi sanga, mithase chu ama mitmu-a chingjo-a kigel ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Akikumna ding jong hilouva kikumma kinahna-a jaopa chu; uicha abila manpa tobang bep ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Milung chavai thingkho-am, thalchang, chule thina, seplele pa chu,
  </para>
  <para style="p">
    <verse number="19" style="v" />aheng akom lhemlha-a, chule katot ahibouve, tia mitobang ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thing umlouna-a mei amitji bangin, misuto umlouna-a kidouna atangji tai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Songmeihol-am min songmeihol akahvam bangle, meijin thing akahvan ji banga; minelkal hatpa chu kinahna sosah-a pang ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Misuto hat thusei ho chu tina maha tobang ahin; oisunggil lampeh-a jong hiche hochu alutjin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Muhnaljetle lungsung gilouchu, leibel dangka-a kitomjol tobang ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Koi hile mihotbola chun akamin aseithem jin, hinlah alungsunga lheplhahna ngen akikhol khom ahin;
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman damheocha thu aseidohteng, tahsan hih-in, ajehchu alungsunga thet umtah thil sagi aumin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi ahotbolna chu joulhepna-a atomkhum hijongle, mipi kikhom khom masanga kitahlang ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koi hile kokhuh laija chu, chua chu ama lhalut teiding; chule song tangpa chunga chu, asong tah chu hungkilekit ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jousei leiguijin asuhgim ho chu ahokit jin, chule pachat lhem seidoh kamsung hin manthah na atongdoh-e.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jing nikho-a din kithang at hih-in, ajehchu hiche nikho chun ipi ahinlhun sah ding nangman nahepoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang le nang nakamsunga nakivahchoi sangin, gamdang mikhatnin nangma navahchoi johen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Song agih in chule neldi agihcheh-e, ahinla mingol lungsatna chu hicheteni sanga chu gihjonalai ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lungsatna hi thil phaloutah ahin, chule lunghana hi thil nasatah ahi; ahinla thangthipna masanga dingjou ding koiham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Guhthima kingailut sangin phongtah-a kiphosal aphajoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gol le paijin amavona chu tahsan umtah ahi, amavang melman eichop chu lheplhahna ahibouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />An vasa hodin khoiju jengjong kidah aumin, ahinla agilkel dingin vang thilkha jouse jong alhumjie.
  </para>
  <para style="p">
    <verse number="8" style="v" />A-in'a kon vahmangpa chu, vacha abuh-a kon lengmang tobang ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thaole gimnamtuijin lungsung akipasah-in, chutobang chun lungsunga kona kihilna phatah chun loile gol akipasah theije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma loile gol ahin, napa loile gol ahin jong dalha hih-in; hamset nikhoteng jongle nasopipa in'a chelut hih-in; ajehchu gamlatah a um napenpipa sangin na-in hengpa aphachomjoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kachapa limgeh inlang, eitamsepa kadonbut theinadin kalung kipasah-in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Milung chingin thilse hunglhung ding amumasan, hijeh chun akiselin, ahinla mimolhochu achepaijun, talen amanjitaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gamdang mikhat dinga kitepna thilla kitungpa ponsil chu lahpeh-un; chule gamdang numeinu khat dingin kitepna thilin mangun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jingkah matah-a thouva awsangtah-a agolpa phatthei bohpa chu, amadinga gaosapna-a kilading ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gohajuh nikho-a gomal lha jengjung toh, numei nelhat tahchu kibang bep ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koihile amanu tuhtang jouva chun huipi jong atuhtang jou ahin, chule akhut jetlama thao jong asip thei ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thih in thih mama anol hemthei bangchun, mihem khatnin agolpa maiso chu avahsah theijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Koihile theichang phung kivettupma chun theichang ga chu aneh teiding ahin; chutobangma chun a-pakaipa ngahjingpa chu jana changtei ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Twilah ivet le ilim akimudoh ji bangin, mihem lungthimin jong mihem hina aphongdoh jin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thikholmun le manthah na chu imatih-in adim ngaipon, chutobang chun mihem mitnin jong chimtih anei ngaipoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dangka dinga sontwina bel, chule sana dinga lhummei ahin; hinlah mihem chu mi apachat nadung juija kipatep ji ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mingol khatchu nangman sum sunga changbong toh suhtha jongle chun, angolna chu ama-a konin beichomdeh ponte.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nakelngoi hon umdan nahet nadingle, nagancha hon phatecha navettup nadingin pontho tah-in pangin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu haonahohi tonsotna ding ahipon, lallukhuh jeng jonghi akhang akhanga umding ahipoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Changpol akilahdoh teng hamjing ahung nouthah-in, chule molsang ho-a hamhingho akichomkhom jin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kelngoiho chu navonding ahiuvin, chule kelchaho chu louman ding ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule nangman nadon khopset le na-insungmi nehkhop set, chule nanungah umpi chengse khoukhah nadinga lhingset kelcha noi nanei ding ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migilou chu koimacha dellouvin ajamin, midihtah pa vangchu keipibahkai bangin ahang san-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gamkhat suhkhel jeh-in pipui tamtah ahung umji, ahinla hetkhen themtheina le hetna nei mikhat jala gamsung chu chesotding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mivaicha khatnin mivaicha khatma asuhgenthei chu, nehding khenlou hela lhohmang jeng goju tobang ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dan pailhaho chun migilouho chu apahchaovin, ahin dan juiho chun amahochu akinelpi jiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miphalou hon thutanlhah nahi ahekhen themthei jipouvin, Pakai holte vang chun thiljouse ahekhen them jiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mivaicha chondih na-a lamjotpa chu, alampi ho-a vahkoi le mihaopa sangin aphajoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Koihile dan tuhdetna chu chapa ching ahin; ahinla boina semho toh kivoppa vang chun apa ajumsahjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lamdih louva sumpung lajia chule adihlouva nejipa chun anei apunsahbejin; hinla amapa chun vaichate khotothempa ding-a akhol khompeh ahibouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dan thupeh ho-a kon anakhang heimangpa taona jengjong chu thet umtah ahibouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Koihile midih aselama kiheimangsahpa chu, amatah-in asem kokhuh sunga chu lhalutteiding; ahinla midihpa vang chun thilphaho aneiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihao chu amachang mitmun akichih sah-in, ahinla hetkhenthem theina nei vaichapan ama akholdoh sohjin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Michonpha te akipa tengule loupina nasatah aumjin; ahin migiloute ahung letdoh tengle mi akisel gamjitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koi hile achonsetna selguh-a chu lolhing louding; amavang koihile hicheho phongdoh jenga chule dalha jenga chun hepina akimuding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathen ging jinga umpa chu anunnom ahin; ahinla alung tahsahpa vangchu vangsetna-a chuding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mivaichate chunga vaihom gilou chu, keipi bahkai kitumle vompi midel hat tobang ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hetkhen themtheina neilou pipuichu misugenthei tah jong ahin, hinla papsetna hotbolpa chun ahinkho akisuhsao ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pumhatna thisan so-a chu kokhuh-a jamlut ding; chule koiman apanpi louhel ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Koihile nolna beija chonlea chu huhhing-a umding ahin; alampiho-a vahkoilepa vangchu lhupai ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Alou kilhopa chun nehle chah ninglhingsetna aneiding ahin, ahinla pannabei miho nungjuipa vang chun vaichatna akimutei ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mikitah chu phattheiboh changintin, ahinla hetman louva haoding gopa chu themmo changtei ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sihnei langnei bolhi aphapoi, ajehchu changlhah halkhat jeh-a jong mi chonkhelji-a ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mikilosen hetman louva haoding jeng agelin; achunga vaichatna ahunglhun ding agelpha jipon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Akama pachatna lhem seipa sanga, miphohsal pa chun nungtengle khohsahna akimutam johding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Koihile anule apa choma hichehi chonset ahipoi tipa chu, misugampa toh golcha ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kiletsahna lungthim neipan kidouna achoh thouvin, Pakaiya atahsanna koipa vangchu phatthei changding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama chang lunggela kisongpa chu mingol ahin; ahinla chingtah-a kalsongpa chu huhdoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koihile mivaicha kithopi-a chu lhasam louding; mivaicha kimumosah vang chun sapsetna tampi akimuding ahije.
  </para>
  <para style="p">
    <verse number="28" style="v" />Migilou adindoh teng miho akiseljin, amaho amanthah tengule vang midih apungjin ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tamtahvei akihilchah nunga jong louchal nalaipa chu, hetmanlouva manthah na-a chuding, chule boldamo hella umding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Michonpha te vaihoma apanteng mipi akipah-in; ahinla khang gilouten vai ahomteng mipi alunghem jiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Koihile chihna ngailu-a chun apa akipasah-in, notiho toh kivopma vang chun anei agou jouse asuhmang ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lengpan thutandih na-in agam aphutdetnin, ahin nehguh kilahpan vang agamchu alehkhup jin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A-inheng pahcha lhempa chun akeng dinga thang akampeh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Migilou chu asuhkhelna-a a-oh jin, ahinla michonpha hon la asaovin akipah uve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Michonphan mivaicha khankho ding angaitopeh-in, ahinla migilouvin hetpeh dingjong agopoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Midaichavai hon khopi chu meijin ahal vamun, ahinla miching hon lungsatna aheidoh-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Miching khatnin mingol khat chu kinahpi henglang, mingolpa chu kitomhen lang nuijongle chamna umdeh louding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thisan sohatpan milungdihpa ahotbolin, ahinla midihtah pan vang alhagao huhdoh ding agon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mingolin alungthima agel jouse aseidoh sohkeijin, miching pan vang akichintup-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaihom khatnin jouthu jeng akhohsah-a ahileh, asohho jouse jong migilou asohji taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mivaichale milhem hatpa akimuto lhonnin, amitlhon jong Pakai hasah ahicheh-e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dihtah-a mivaichate thu tanpeh lengpa laltouna chu, atonsot geija kiphudet ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mol le phosal na-in chihna ape-in, ahinla achama kilha chapang chun anu ajumson ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Migilou apunteng dan suhkhelna apungjin, ahinla michonpha ten amaho lhuhchu amudiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nachapa nathun nunsah-in, chutile aman nangma olna napehding; chule aman nalung akipasah ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khonungthu i-atiding ngaitophah louna achun mipite amangthah jitan; ahinla dan kituhchahpa chu akipah-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Soh chu kamcheng keovin akisudih theipoi, ajehchu aman hethem jongle adonbut louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngaikham le geltoh umlouva thusei namu em? amasangin mingol din kinepna atamjon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Asoh aneovapat demchatah-a hinkhou khah-a chun, khonung teng hiche sohpa chu chapa-a ahin neiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Milung chompan kinahna achoh thouvin, chule milungkhoh pan suhkhelna ahaolo jitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihem khat kiletsahna chun ama anoinunsah teiding, ahinla jana chun lungsunga kineosahpa chu atundoh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Koihile migucha toh kithokhompa chun ama hinna jong ahot ahin, sapsetna ajanan ahin imacha aseipon ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihem ginna hi thangkol kido ahibouvin, ahinla koihile Pakai tahsanna chu hoidoh ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mitamtah in vaihompa khohsahna chu aholun, ahinla amitakip chunga thutanna chu Pakaiya kon ahibouve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mikitah loupa chu midihpa dingin thet umtah ahin, chule achena lampia nolnabei michu agiloupa dinga thet umtah ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakeh chapa Agur thusei ho, themgao thusei ngeichu: hiche mipan Ithiel henga, Ithiel le Ucal heng ngeija thu aseijin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Tahbeh-in hi midang sangsanga ngoljo kahin, mihem khatnin hetna aneibangin keiman kaneipoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chihna kitijong kajil khapon, mithengpa hetnajong kananeipon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Koiham van'a kaltouva ahiloule hungkum lha-a? Koiham hui akhutna huikhom theija? Koiham twi ponna chuntheija? Koiham leiset kolkimvel anaphut detna? Ama minchu ipi hija, chule achapa minchu ipiham, nangman nasei theijem?
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen thu jousehi atheng ahin, chule ama tahsan ho jouse dingin ama chu lumdal ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman athuho chu belap hihbeh-in, achuti loule aman nangma phohsalin natin, thujou seipa nahilo ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman nanga konin thilni kangeh-in, kathi masangin hiche teni chu nei-itpeh hihbeh-in;
  </para>
  <para style="p">
    <verse number="8" style="v" />Keija konin thumanlou le jouthu gamlatah-a neikoi mangpeh jengin; vaichatna ahin haona hijongle neipehdan, keima dinga kakitopibep an achun neivah-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Neng behsehleng nangma seilep inting, Pakai chu koiham? katiding; ahiloule vaicha behseh leng kaguhchat ding, ka Pathen min chu mohseh-a kaphah pohding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Apupa henga asottolpa chu hehse hih-in, aman nasapset lontin themo changkhan nate.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihem tamtah apa gaosapma, chule anu jong phatthei bohlou aumin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihem tamtah ama mitmu-a athenga kigel aumin, ahinla athenlou naova chu kisoptheng lou ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihem tamtah aumin, Oh, amit houchu ichana sanga hitam! amit gei ujong dopsangin aumin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihem tamtah aumin, amaho hachu chemjam tobang, chule aha noinung houchu chemcha hemthet tobang ahin; leiset chunga kona vaichate vallhum dingle, mihem lah-a kona lhasamte sugam dinga kigo ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Votnin chanu ni aneijin, neipen, neipen tin apengin ahi. A-itih-a chimjoulou thilthum aumin, henge, aphatai, tilouhel thil li aume.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lhankhuh le nao neilou naobu; twi dim theilou hel leiset, chule aphatai tilouhel meikou ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Apa noisena mitna vea, chule anuthua nunding i-sah loupa mit chu,, phaichama va-ah hon achuhdoh ding, chule mulaopi nouhon anehdingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keima dingin datmo umtah thil thum aumin, kahetlou thil li aume;
  </para>
  <para style="p">
    <verse number="19" style="v" />van'a mulaopi lenna lampi, songpi chunga gul kithollena lampi, twikhanglen lailunga kong kitolna lampi, chule pasal khatle nungah khat chena lampi ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Notinu lampi jong chutobang chu ahi; amanun anen chule amuh akitheh-in, agilou kabol hihbeh-e, atin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thilthum jeh in leiset athip theipon, chule thil li athoh theipoi:
  </para>
  <para style="p">
    <verse number="22" style="v" />Soh khatnin vai ahinpoh-a, mingol khat-in sa vasetna ahin neh-a;
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi hotbol jing numei khatnin ji ahin neija, chule soh numei khat apinu goulo dinga ahung umhi ahi
  </para>
  <para style="p">
    <verse number="24" style="v" />Leiset chunga neocha cha thil li aumin, ahinla hicheho chu aching cheh ahiuve;
  </para>
  <para style="p">
    <verse number="25" style="v" />Sihmi hohin mihem sanga thalhomjo ahivangun, nipilaile amahon anehdiu akigonun;
  </para>
  <para style="p">
    <verse number="26" style="v" />Jupihohi lhasam tah ahivangun, songpiho-a buh akisah uvin;
  </para>
  <para style="p">
    <verse number="27" style="v" />Khaokhohon leng aneipouvin, ahijeng vangin abonchauvin ahonin achelejiu ve;
  </para>
  <para style="p">
    <verse number="28" style="v" />Maimom in akhutnin atuh-in, chule leng inpiho-a aumin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Phatah a chekhom thilthum aumin, chule thil li kitoh della chekhom jong aume;
  </para>
  <para style="p">
    <verse number="30" style="v" />Keipi bahkaihi gamsa jouse lah-a ahatpen ahin, koima otdohlou ahi;
  </para>
  <para style="p">
    <verse number="31" style="v" />Uichal ahin, kelchal ahin, chuleh ama dou dinga koima dingdoh khalou lengpa ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangle nang kichoisang na-a ngolhoi tah-a nachon khah-a, ahiloule nangman thilphalou nagelleh, nakhutnin nakam kisimin.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bongnoi khu icho thipthap le bongnoiha asohjin, inahlhong iheh jongle thisan apotjin, chutobanga chu ilung ihansah jingle kinahna asohjin ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lemuel lengpa thusei ho, anun ahung guilhung dingthu anahilho.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ipiham kachapa? Iham kanaobua kon peng kachapa? Chule ipiham kakitepna ho-a kahin kachapa?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nathahatna chu numei ho pedoh hih-in, nalampi ho jongchu lengte sumangho pedoh hih-in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichehi lengho ding ahipoi, Vo Lemuel, lenghon ju adonding ahipon, leng chateho dingin jong juchih donding ahipoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon donnu henlang danthu sumil taleu, suhgentheija umte chungchang thua lamdih louva thutan na aneikhah diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amangthai ding hochu juchih donsah-un, chule lunggimho chu ju donsah-un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman don henlang avaichatna sumil hen, chule agimnaho geldohda tahih hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mangthah dinga lhuhsahsa umho chungchanga, paomoho dingin nakam keh-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihem apaomo amadia thu kisei theilou jeh-a suhmanga umtadingho panpinan, nakam keh-inlang seipeh-in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Numei chondihtah koijin akimujou tadem? ajehchu amanu manlutdan chu songmantam ho sangin asangjon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A-inneipu chun lungmong selin atahsanin, hitichun amapa dingin lhahsamna kitimong mong umponte.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amanun ahinkho lhumkeijin amapa dingin thilpha bolin tin, chule thilse bolpeh ponte.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amanun samul le tupat aholin, alungcham tah-in akhut tah-in na atongin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanu chu sumkolvei ho kong innei tobang ahin, gamla tahtah-a konin aman nehle chah ahin polutjin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amanu janlai jengin jong athoudoh jin, chule a-insungmite chu nehding sa apen, aumpi soh numei ho jong achanding apejin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amanun loumun khat avechilin, hichu achon, akhutsoh mangchan lengpilei abolin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amanun thahat na-in atai akigeh-in, chule abantha ahatsah-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amanun aveipungho chu aphai ti ahen, amanu meivah jong janle amit ngaipoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amanun akhutnin muikung atuh-in, chule akhutnin patkong kung atuh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amanun vaichate le, lhasamte dingin akhut alhangdoh jin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amanun a-insungmite dingin buhbang hunglha dingjong akichapoi; ajehchu a-insungmite jouse chu ponsanthip cheh-a kivon ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amanun amadingin ponsil jemnei akikhonin, amanu von chu lungpon le ponsandup ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A-inneipu chu gamsung upaho toh khopi kotpiphunga atouteng mijouse het ahijin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amanun tupat ponnemjet akhongin, ajohjin; chule konggah jong sumkolveipa henga akijoh jin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amanu chu thahatna le jana-in akivonin, ahunglhung ding phatna jong ama kipah thanom ding ahi
  </para>
  <para style="p">
    <verse number="26" style="v" />Amanun chingthei tah-in thu aseijin, athusei jong khotona dimset ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanun a-insung chena lampiho phatechan aven, chule thasetna changlhah jong anepon ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Achate ahung thoudoh-un anunnom nahi atiuve; a-inneipun jong amanu apahcha lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chanu tamtah-in chonphat abolin, ahinla nangman amaho chu nakhokhel sohkeije.
  </para>
  <para style="p">
    <verse number="30" style="v" />Deisahna hi kilhep lhahna ahin, chule hoinahi pannabei ahi; ahinla Pakai gingjing numei vangchu, choi-atna umding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Akhutsoh chu amanu peuvin, chule kotpi phunga anatoh jousechun amanu vahchoi cheh hen.
  </para>
</usx>
