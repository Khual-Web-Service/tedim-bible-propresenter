<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="RUT" style="id">Ruth</book>
  <para style="h">Ruth</para>
  <para style="toc1">Ruth</para>
  <para style="toc2">Ruth</para>
  <para style="mt">Ruth</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun thutan ho vaihomho nikho laijin, gamsunga kel analhan ahi. Chuin Judah gam Bethlehem'a pasal khat a-inneipi le achapa teni toh Moab gama phat chomkhat cheng dingin anacheuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pasalpa minchu Elimelech ahin, a-inneipi minchu Naomi ahi, chule achapa teni minchu Mahlon chule Chilion ahin, Judah gam Bethlehem kho-a um Ephrath mi ahiuve. Amaho Moab gama acheuvin agaum taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Naomi inneipu Elimelech chu athitan; amanu le achapateni adalhatan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin achapa tenin Moab numei ji-in akipui lhonin; Khatnu minchu Orpah ahin, khajonu minchu Ruth ahi. Chutichun hiche gama chun kumsom tobang anachengun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Mahlon le Chilion jong ani lhonin athi lhontan; hitichun Naomi chu a-inneipu le achapa tenin adalhatan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Naomi Moab gama kona kilekit dingin amou tenitoh akipat dohtan ahi. Ajehchu Pakaiyin amite nehding apen aviltai ti Moab gama konin ajan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun amanu amou teni toh aumna-a konin akipatdoh-in; Judah gam kilekit nading lampi-a chun achetauve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Naomi in amouteni jah-a, chelhonin, nanuteni incheh-a kinungle lhontan; nangnin athiho le keima neibolna lhon bangin Pakaiyin lungsetna-in nabol lhonhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na-inneipu teni incheh-a lung kicholdona namulhon nadingin, Pakaiyin phatthei nape lhonhen, ati. Chujouvin abenglhon chu achopmin, athummun aw sangtah-in akap taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanin amanu jah-a, keini namite henga nangma toh kakile tei lhonding ahi, atilhon tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin Naomi'in, kachanu teni kinungle lhontan; Ibola keima toh nakilhon hon dingham? Kanaobua ji-a nanei theilhon ding chapa um nalaija ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Kinungle lhonin, kachanu teni, chelhontan; ajehchu ji neikit dingin kateh behsehtai. Keiman kinepna kaneije tin seijing ting, tujan mamahin ji neijingting, chapate hingkit jongleng;
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangnin amaho kikhan lhit gei nangajou lhonding hinam? jineilouva amaho nangalhon dingham? Hitheiponte, kachanu teni; ajehchu Pakaiyin akhut keima douna-a alapjeh hin, nangni-a ding gelnan kalung ana tangeije, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutichun amaho aw sangtah-in akap kit taove. Chuin Orpah in atehpi lhahnan achopmin; Ruth vang chun akolchahtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Naomi in hitin aseije, ven na-unu amitele a-pathenho henga akilekit tai. Nangjong na-unu nung juijin kiletan, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Ruth'in, nangma dalha dingle nanung kajuina-a kona kinungle kit dingin neijol hih-in: ajehchu nache che na-a kache ding, nachen chenna-a kachen ding; namite chu kamite hia, na Pathen chu ka Pathen hiding;
  </para>
  <para style="p">
    <verse number="17" style="v" />Nathi thi na-a kathi-a, hiche munna chu eikivui ding ahi. Thina tilouvin thil dangin eikhen lhonna ahile, Pakaiyin kachungah abolnom nom bolhen, achungnung jo cheh-in jong chuhsah jenghen, tin aseitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Naomi'in amounu amatoh kilhon dinga dettah-a apan amu phatchun, ajah-a imacha aseitapon ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun amani Bethlehem alhunlhon kahsen achepeh lhontan ahi. Chuin ahitin ahi, Bethlehem alhunlhon phatchun, khosung pumpi chu amani jeh-in akiling soh jengin; chule numei hon, hichehi Naomi hilouham? atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amanun ajah uva, Naomi neiti hih-un, Mara neitijouvin; ajehchu Hatchung nungin nasatah in eisugenthei tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ninglhinga potdoh-a kahin, Pakaiyin ahomkeovin in eihin lepui kit tai. Pakaiyin keima douna ahet tohsah-a, Hatchung nungin kachungah gentheina achuhsah namu nunguva, ipi dinga Naomi neiti nahlaiju ham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun Naomi chu ahung kile kitnin, Moab numei amounu Ruth toh Moab gama konin ahung kile lhontan ahi. Chuin sakol chang ki-at patlaijin Bethlehem ahunglhung lhontai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun, Naomi'in a-inneipu sopi mihaotah khat aneijin; ama chu Elimelech insunga kon ahin, amin chu Boaz ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Moab numei Ruth'in Naomi jah-a, tun keima louva cheng kating, koihile amitmua lungset eichan penpen louva changkhai gaholinge, ati. Chuin Naomi'in ajah-a, kontan kachanu, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amanu apotdoh-in, achen, louva chang at-ho nunga changkhai aholtan ahi. Chule amanu chu Elimelech insungmi Boaz loulaija avahlut khatan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin veuvin, Bethlehem'a konin Boaz ahungin, chang at-ho jah-a, Pakaiyin na-umpiu hen, ati. Chuin amahon jong Pakai;in nangma phatthei naboh hen, tin adonbutnuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Boaz in chang at-ho vesuija pang sohpa jah-a, hichenu hi hoi koi nungah ham? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin chang at-ho vesuija pang sohpa chun adonbutnin, amanu hi Moab gama kon Naomi toh hung kinungle khangdong Moab nungahnu chu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amanun, katao ahi, chang at-hon adalhah-u changphal lah-a changkhai neihol khom sah-in, atin; hitichun amanu ahungin, in'a chomcha akicholdo tilouvin, jingpi-a pat tuchan geihin achomkhom peh-in ahi, tin adonbutne.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin Boaz chun Ruth jah-a hitin aseije, kachanu, kathusei nangai nah louding ham? Midang louva changkhai holdin chehih-in, hikoma konin jong potdoh hih'in, ahin ka numei ho toh kikhen louvin kivop jingin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amahon a-atnao loulai chu velhin lang, anungu juijin. Gollhang hon nangma natohkhah louna dinga thu kapeh louva nabol ham? nadang achah teng twibel phunga chenlang, gollhang hon ahinkhaiju twi chu donjin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanu tollah aboh khupmin, amapa jah-a, keima gamdang mi kahi munasa-a, ipijeh-a neihet thema, namitmu-a hibanga lungsetna kachan ham? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Boaz'in adonbutnin, amanu jah-a, na-inneipu thinunga natehpi najennaho; nanule napa, napenna gam nahin dalhah-a, masanga nahet khahlou miho lah-a nahung thu kichentah-a eikihetsah ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakaiyin natohna chunga lethuhna napehen lang, chule kicholdo nadinga alhaving noi nahinjot Pakai Israel Pathen chun, kipaman lhingsetnin napehen, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amanun, ka Pakai, na mitmu-a lungsetna changjing inge; ajehchu nasoh numei ho lah-a khatbeh hihih jongleng, nangman neilhamon in, nasohnu hi lungset tah in nei kihoulim pitai, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin an aneh phatnun, Boaz'in amanu jah-a, hungin lang an hungnen, chule nachanglhah halchu lengpitwi thuh-a hin hung kide-in, ati. Chuin amanu chu chang at-ho koma atoutan; amapa chun amanu chu changkanpoh apen, amanun ane vasetnin, amoh phabep akhenin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amanu changkhaiho lohkhom dingin akipatdoh phatnin, Boaz'in asoh pasal ho athupeh-in, ajah uva, hichenu hi changphal ho lah jenga jong kilokhom sah-un, phohsal hih-un.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule changphal loma konin jong amanu kilokhom dingin phabep lhahsahthu jiuvin lang, phoh hih-un, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti chun amanun nilhah geijin loulaija chun changkhai aholin, chule changkhai alokhom chengse chu avolhan ahileh, hichu sakol chang ephah khat tobang ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amanun hichu apon khopi sungah alutnin; atehpin achangkhai hinpoh chu amutan ahi. Chuin amanun anehvaset jouva anehval akhen chu atehpi apetan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin atehpin ajah-a, tunia hoilama changkhai nahol em? hoija na nagatoh em? Nangma nahin hethempa chu nunnom hen, ati. Chuin Ruth'in aloukona mipa chu atehpi jah-a aseipeh-in, ajah-a, tunia kakonna louneipa chu Boaz ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Naomi'in amounu jah-a, Athiho le ahing nalaiho chungah lungsetna nungsun lou Pakai chu nunnom hen ati. Chuin Naomi'in ajah-a, hiche mipa chu eiho dinga isopiu, inko ikinaipi penhou lah-a khat ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Moab numeinu Ruth'in, amapa chun kahengah, kachang a-at jou kahseovin, ka gollhangho toh kikhen louvin ummin, tin aseije ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Naom'in amounu Ruth jah-ah, kachanu, amapa numei ho toh nakon khomchu aphai. Ajehchu midang louva kon le chun hitabang chu namu louding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun amanu Sakol chang le suhlou chang ki-atchai kahsen changkhai holdingin Boaz numei ho toh kikhen louvin aumkhomin; chule atehpi toh achengkhom lhontan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin atehpi Naomi'in amanu jah-a, kachanu, nangdia thilpha asotheina dinga, nakicholdo nading kangaito peh louding ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nangman anumeiho nakivop piji Boaz khu i-inkopau hilouham? Ven, tujan tengle phola sakolchang ajapchil ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun kisilngimin lang, thao kinun, navon phapen kivonin lang, pholla chesuh-in: ahin amapan neh le don achai masangsen akoma chun kiphong hih-in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hitiding ahi, alupna ding munchu melchih inlang, ama aluptengleh, chu-a chun lutnin, chule akeng hohdoh inlang chu-a chun lumin; chutengle aman nabolding nahil nante, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Ruth'in amanu jah-a, kahenga nasei jouse kabolding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amanu pholla achesuh-in, atehpin asei bangin agaboltai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Boaz'in nehle don achai phatnin, lung kipah tah-in chang kisevum banna chun lum dingin achetan ahi; chuin amanu kangchan ahungin, amapa kengchu ahohdoh-in, chu-a chun alumtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin khangkimin ahitin ahi, amapa chu akinin, agah kiheileh; ven, numei khat akeng todopmah alumin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amapan koi nahim? ati. Amanun adonbutnin, nasohnu Ruth kahi; hijeh chun nasohnu hi naponmong neisilpeh in; ajehchu nangma kasopi kinaipi nahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, kachanu, Pakaiyin phatthei naboh hen; ajehchu gollhang ahao hihen, avai hijongle anungu najuilou hin, amasalama sangin ajona lamah khotona namusah cheh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule tun, kachanu, kicha hih-in; keiman na-ngeh jouse kabolpeh ding nahi: ajehchu kakhopi sunga kamite jousen numei chondihtah nahi ahesoh keijuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun keima nakinaipi nasopi kahichu adih-e; ahin keima sanga sopi kinaipi aumnalaije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tujan gehden tan, jingkah tengle hitiding ahi, amapa chun sopi khat boldingdol kinchu nangma chunga abola ahile, aphai; sopi boldingdol kinchu bolhen. Amavang aman hiche sopi boldingdol kinchu nangma chunga abol louva ahile, Pakai ahinjing bangin, keiman sopi boldingdol kinchu nangma chunga bolnange. Jing khovah kahsen gehdentan, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutichun amanu chu amapa kengdopmah jingkah geijin alumtan; jingkah phalvah then masangin athoudohtan ahi. Chuin amapan, pholla numei ahunge ti koiman hetdahen, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman amanu jah-a, naponsil chu hinchoijin lang, do-in, ati. Chuin aman ponchu adon ahile sakol chang tena gup atepeh-in, apohsahtai. Chuin amanu khopi sunglama aluttan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amanu atehpi kom agalhun phat chun, atehpin, kachanu, ito nahungbah hinam? ati. Chuin amanun mipa chun ama dinga abolpeh jouse chu aseipehtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule amanun, hiche sakol chang tena gup hi amapan eipeh ahi; ajehchu amapan kajah-a, natehpi henga khut gohkeovin chehih-in eiti, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amanun, kachanu, hiche thua hi ipi ahungso nahetchet kah-in khongaijin; ajehchu tunia hiche thuhi asuhchet masangse-a amapa kicholdo louding ahi, ati.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Boaz kotpi phung-ah achetouvin, chua chun atoutan ahi. Chuin ven, Boaz'in anasei akinaipi asopipa chu ahungin; Boaz'in ajah-a, golpa hung kiheijin lang, hikoma hin hungtouvin, ati. Chuin amajong akiheijin atoutai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman khopi sunga upa som akouvin, ajah uva, hikoma hin touvun, ati. Chuin amaho atou taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun aman akinaipipen asopipa jah-a, Moab gamma kona hungkile kit Naomi'in, isopipao Elimelech gam behkhat ajoh-in:
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche thuhi nangma hetsah dinga kagel ahi, hikoma chengho le kamite upaho anga hichu kichohtan. Nangman nalhat dinga ahile, lhatnin; nalhat louding ahile, kahet thei nadin neisei peh-in; ajehchu nang tailou hiche lhatding chu koimacha aumpon, Keihi nang bantah-a kahi, ati. Chuin amapan, hichu lhatnange, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Boaz'in, Naomi khutna kona louchu nachoh ninile, agoulo chunga athipa min chu aumjing theina dinga, athipa inneipi Moab numei Ruth jong nachohtha ding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichun asopi kinaipipa chun, keima dingin lhat thei ponge, atiloule keima neilegou ngeijong kisuh chatvai ding ahi. Lhatdohna tha kanei jonghi nangma chang maijin, ajehchu keiman kalhat thei louding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Masanglaijin Israelte lah-a lhatdohna le kilhet tona chung changa chonna ngai dan chu hiti ahi: ipi thu hitale suhchetna dinga chu, pasal khatnin akengkoh asutlhah-a, michom khatpa chu apehji ahi: hichu Israelte lah-a suhdetna hija ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun asopi kinaipi penpa chun Boaz jah-a, nangma dingin kilhattan, ati. Chuti chun aman akengkoh asutlhan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Boaz'in upaho le mipi jouse jah-a, tunia hi nangho hichehi ahetoh nahiuve, keiman Naomi khutna konin Elimelech gou jouse, chule Chilion le Mahlon neijouse aboncha kachoh ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche chungvum chun, athipa minchu agouva aumjinga, hitia chu athipa min chu asopiho lah-a kon leh aumna mun kotpi phunga kona kahlhah-a aumlouna dingin, Moab numei Ruth, Mahlon inneipi jong kajidingin kachoh thatai; tunia hi ahetoh-a nangho nahiuve, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin kotpi phunga um mijouse le upaho chun ajah-a, keiho ahetoh kahiuve. Pakaiyin na-insunga hunglut numeinu hi Israel insung tungdoh teni, Rachel le Leah tobang hisah hen; chule nangma jong Ephrathah'a phathei jin lang, Bethlehem'a namin kithang hen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakaiyin hiche khangdong numeinu chilhah-a kona napehding na-insung chu, Judah dinga Tamar ahinpeh Pharez insung tobang chu hihen, atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun Boaz'in Ruth akipuijin, ji-in aneitai. Chuin ama amanu koma alut phatnin, Pakaiyin amanu chu nao avopsah-in, chapa khat ahingtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin numei hon Naomi jah-a, Tuni tah ngeija sopi kinaipi beija nadalha louva Pakai chu nunnom hen; chule amapa hi Israel sunga amin kithang hen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule amapa hi nahinkho kiledohsah le nateh nunga navah-a hungpang hen; ajehchu nangma nangailu-a, nangma dinga chapa sagi sanga phachomjo namounun amahi ahin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Naomi'in naosen chu alan, a-angah apomin, adonin apangtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin a-inheng numei hon naocha min asah-un, Naomi'a dingin chapa khat apenge, atiuvin; Obed asahtaove. Amahi David pa, Jesse pa ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun hicheho hi Perez chilhah ahiuve. Perez in Hezron ahingin,
  </para>
  <para style="p">
    <verse number="19" style="v" />Hezron'in Ram ahingin, Ram'in Amminadab ahingin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Amminadab'in Nahshon ahingin, Nahshon'in Salmon ahingin,
  </para>
  <para style="p">
    <verse number="21" style="v" />Salmon'in Boaz ahingin, Boaz in Obed ahingin,
  </para>
  <para style="p">
    <verse number="22" style="v" />Obed'in Jesse ahingin, Chule Jesse'in David ahinge.
  </para>
</usx>
