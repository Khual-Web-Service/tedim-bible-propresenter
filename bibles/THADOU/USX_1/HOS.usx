<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="HOS" style="id">Hosea</book>
  <para style="h">Hosea</para>
  <para style="toc1">Hosea</para>
  <para style="toc2">Hosea</para>
  <para style="mt">Hosea</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel lengpa Joash chapa Jeroboam nikho laile, Judah lengte ho Hezekiah, Ahaz, Jothan, Uzziah nikho laijin, Beeri chapa Hosea henga Pakai thu ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hosea henga Pakai thu hung lhung kipatna chu ahi. Chuin Pakaiyin Hosea henga, chenlang numei noti ho chate lah-a konin noti numei khat naji dingin gakipuijin; ajehchu gamsung hi Pakaiya kona petmanga, noti'a pang gamma ahitai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun ama achen, Diblaim chanu Gomer chu aga kipuijin; amanu agaijin, chapa khat ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakaiyin ahenga, amin Jezreel sah-in; ajehchu chomkhat joule keiman Jehu insunga Jezreel phu kalahna ding ahin, chule keiman Israel insung leng gam hi kasuhbei ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuche nikhole hung hiti ding ahi, Israel thalpi chu Jezreel phaichama kaheboh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amanu agaikitnin, chanu khat ahingin ahi. Hichun Pathen'in ahenga, amanu min chu Lo-ruhamah sah-in; ajehchu keiman Israel insung chunga hi hepina kaneilou hel ding ahitai; keiman amaho aboncha kalahmang hel ding ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin keiman Judah insung chunga vang hepina neijing ting, Pakai a-Pathen'un amaho chu ahuhhing ding ahin, chule amaho chu thalpi, chemjam, gal, sakol ho, chule sakol chunga tou miho mangcha-a ahuhdoh louding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun Lo-ruhamah'in anoichep aban phatnin, amanu agaijin, chapa khat ahingin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Pathen'in ajah-a, amin Lo-ammi sah-in; ajehchu nangho kamite nahi tapouvin, keima na Pathen'u kahitapoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin Israel chate chu twikhanglen'a neldi jat, tejoulou le simsenglou hung hidiu; chule hung hiti ding ahi, amaho kamite nahitapouve tia ana kiseipehnao mun'a chu, nangho Pathen hing chapate nahiuve tia kiseipeh ding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutengle Judah chatele Israel chate chu kigom khom ding, alamkaidiu khat apansah diu, chule amaho gamsunga kona chu hungpotdoh ding ahiuve: ajehchu Jezreel nikho chu loupitah hiding ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nasopipa Ammi le nasopinu Ruhamah jah-a seijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanu henga ngehna neijun, ngehna neijun; ajehchu amanu kaji ahipoi, keijong ama inneipu kahipoi: amanun amitmua konin akijohnaho, chule anoi teni kah-a konin ajonthanhoina chu paimang hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Achuti loule amanu sagoh kahodoh ding, apenlhah nikho banga kakoiding, chule amanu gamthip banga kasema, gamgo banga kakoiding, chule dangchah-a katha ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keiman amanu chate chunga hepina kanei louding ahi; ajehchu amaho kijohnu chate ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu anu-u chu noti'n apangtan: amaho oisunga vopnu chu jachat umtah in achontai: Ajehchu amanun, ka changlhah le ka twi, ka samulpon le ka ponnem, ka thaotwi le ka donding eipe-a kakideipi ho nung juijinge, tin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun, veuvin, keiman nalampi-a ling tho kagetding, chule amanun kenglampi ho amuthei louna dinga pal kaget ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amanun adeiho nungjui jintin, hijongle amaho chu aphah jou louding; chule amanun amaho chu holintin, hijongle amu louding ahi. Chutahle, amanun, Chengting kaji masapa koma kile kittange; ajehchu hiche phatlai chu keija dingin tu sangin aphajoe, ati ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu amanun Baal houna dinga agot chang, ju, chule thaotwi chu keima peh ahi ahepon, chule adangka le sana chu keiman kapunsah ahilam ahepon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh-a chu keima kaki nungle-a, ka chang chu a-at phat tengle kanung lah-a, ka ju jong alhophat tengle kanung lah ding, chule asagoh selna dinga kapeh kasamulpon, chule ponnem jong kanung lahpeh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule akideipiho mitmu-a amanu jamo kahodoh pehding, chule koimachan kakhutna kona amanu ahuhdohlou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman anopsahna jouse, akut nikhoho, alhathah niho, acholngah nikhoho, chule akut thupi ho jouse kasuhbei ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amanun, Kakideipi hon katohman dinga eipeh-u ahi tia asei alengpiguiho le atheichang phungho chu keiman kasuhmang ding: keiman hicheho chu gammang kasosah-a, chule gamsa hon anehdiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keiman Baal doi houna-a gimnamtui ahal nikhoho jeh, bilba le sana jempah-a akijepma akideipiho nung ajuija, keima eisuh mil jeh-a amanu chunga gotna kapeh ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun, veovin, keiman amanu chu jolingting, gamthipma kapuiding, chule lungdam sella akoma thu kasei ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman chukoma chu amanu alengpileiho kapeh-a, chule akinepna kot dinga Achor phaicham kapeh ding ahi: chule chumuna chu amanun akhangdon laile Egypt gama kona ahung potdoh nikholai banga la asah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuche nikho chule hitiding ahi, tin Pakaiyin aseije; Nangman Ishi tia neikou ding, Baali tia neikou tahlou ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu keiman amanu kamsunga kona Baal doi minho chu kalah dohding, chule aminhou chu geldoh-a umkit louding ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche nikho chule keiman amaho dinga gamsaho, chungleng vacha ho, chule leiset chunga akithol thoho toh kitepna kasemding; chule thalpi, chemjam, chule gal kisat leisetna kona kasuhmang ding, chule amahochu bitkeicha kaumsah dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule keiman nangma a-itih chana keima-a dinga kajihol ding; keiman nangho chonphatna-a, thutan dih-a, ngailut phatna-a, chule hepina-a keima-a dinga kajihol ding nahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keiman nangma kitah tah-a keima-a dinga kajihol ding; chule nangman Pakai chu nahet ding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hicheni chule hung hitiding ahi, keiman kangai pehding ahi tin Pakaiyin aseije, keiman vanho thu kangaipeh-a, chule amahon leiset thu angaipeh diu ahi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule leisetnin changle mimho thu, lengpitwi thu chule athaotwi thu angaija, chule amahon Jezreel thu angaidiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amanu chu keimadin leisetna tu-ingting, hepina changlou amanu chu kahepiding, chule keima mite anahilou ho jah-a, nangho kamite nahitaove katiding; chule amahon, Nangma ka Pathen nahi, eitidiu ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Pakaiyin kahenga aseijin, Pathen dangho velhijinga, lengpiga changlhah ho ngailujing Israel chate Pakaiyin angailut jing bangin, chekitnin lang angailu pan angailut mongmong numei jonthan hoija kichem khat ga ngailun, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutichun keiman amanu chu keija dingin dangka somlenga, suhlou chang homer khatle akeh manin kakichoh tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin keiman amanu jah-a chun, nitamtah keima dinga naum ding, noti'a napan louding, chule pasal danga ding nahilou ding; chutima-a chu keima jong nangma-a kahiding ahi, kati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Israel chate chu nikho tamtah leng le pipui beija, gan lhaina neilouva, milim neilouva, thempu boitong sangkhol le milim houna beija umding ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khonung tengle Israel chate chu hung kilehei juntin, Pakai a-Pathen'ule David alengpau ahinhol dingu; chule ninunung tengleh Pakai le aphatna chu ahin gin dingu ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho Israel chaten Pakai thuhi ngaijun; ajehchu gamsunga chu thutah, hepina, chule Pathen hetna aumtahlou jeh-in, Pakai chun chuche gama chengte toh kinelkalna aneitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amaho akihahselun, ajouvun, athatnun, aguvin, chule jon apanun, achonkhel taovin, chule thisanin thisan asouvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh achu gamsung chu lunghem ding, chua cheng jouse gamsaho le chungleng vachaho puma lhasam ding; chule twipia ngaho tolmanga umding ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla mi koima kinah dahen, khatnin khat phosal dahen; ajehchu namiteu chu thempu kinahpijiho tobang ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh-a chu nangho sunlaija nalhuh diu, themgao jong chu nangho toh janle lhuhtha diu; chule keiman nanu chu kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamite hetna alhahsam jehu'n suhmangin aumtaove: ajehchu nanghon hetna chu napampai tahjeh uva, keiman jong nangho kapampai ding, chutia chu nangho keima thempu nahilou diu; nanghon na Pathen'u danthu peh nasuhmil tah jeh uva, keiman jong nachateo kasuhmil ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho apuncheh cheh ule, keima dounan achonse chehcheh-un; hijeh-a chu keiman jong aloupi nao chu jachatna-a kakhel pehding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amahon kamite chonsetna anechai helun, chule amahon akhangitlou nao chunga alungthimu akoijun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hitiding ahi, mipi le thempu kibang diu, keiman alamlhah hou jeh-a talen kapeh ding, chule atohmanu kasansah ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu amahon neovintin, valoudiu; amahon jonthanhoi boluntin, punglou ding ahiuve: ajehchu amahon Pakai ngaisah ding chu adalha taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kijohnale lengpitwi chule lengpitwi thah-in alungu alamangtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kamite chun amilim hou koma thumop angeh jiuvin, chule atenggolun amaho henga aphongdoh jie: ajehchu kijoh lungput chun amaho achonkhel sah taovin, chule a-Pathen'u thunoija konin apotnun kijoh-in apang taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon molchung ho-a ganlhaina aneijun, chule lhangvum ho-a gangpi phung, belkan phung, chule penal thingphung noiho chu alim anop jeh-in, gimnamtui ahaluvin ahi: hijeh chun nachanuteu kijoh dingu, chule naji teovin jonthanhoi aboldiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nachanu teo akijoh uva, chule naji teovin jonthanhoi abol tengule, keiman talen kapeh louding ahi: ajehchu amaho kijoho-a konin akikhin doh-un, chule mijongho toh ganlhaina anei khomuvin ahi: hijeh-a chu ahethemlou mite chu lhuding ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel nangman jonthanhoi panjong lechun, Judah kipal lhuhsah hih-in; chule nangho Gigal'a hunghih-un, Beth-aven'a jong chetouhih-un, chule Pakai ahing jinge tin jong kihahsel hih-un.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu, bongla nungkih bangin Israel anungkih tai: Pakaiyin tuahi amaho chu munlen khatna kelngoinou banga avahding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ephraim'in milimho ajoptai: aum umin umsah-un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amahon adonu chu athuh-in; amahon kijoh hinkho amang jingun ahi: avaihomhou vin jong jachat umtah-in angaichaove, nanghon peovin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huijin alhaving teni-a amaho achepchah-in, chule akithoi nahou jeh-a jahcha ding ahiuve.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo thempuho, hichehi ngaijun; chule nangho Israel insung mite, ngaijun; vo leng insung mite, nanau hin sungun; ijeh inem itile thupi tanna chu nachung uva chuding ahi: ajehchu nangho Mizpah chunga thang nahiuvin, Tabor chunga lenthang kijah chu nahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keima amaho jouse phoh-a kahung panpeh vangin, thununglou ho chu tolthat hattah ahigam taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman Ephraim kahenai, chule Israel chu kakoma konin akiseldehpoi; ajehchu tun, vo Ephraim nangma kijoh-in napangin, chule Israel suhboh-in aume.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon a-Pathen'u heng lama kihei lutna dinga anatoh jouseu chu asemphat lou diu ahi: ajehchu noti hina chu amaho lah-a aumin, chule amahon Pakai chu ahepouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Israel kiletsahna chun amaikoh-a ahettoh sah-in: hijeh-a chu Israel le Ephraim chu akhangitlou naova lhuding; Judah jong amani toh lhuhtha ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho aganchahou le akelngoi honhou toh Pakai holdinga chediu; hijongle amulou dingu ahi: Ama chu amaho-a konin akichon dohtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon Pakai chunga kitahlou tah-in achon taove: ajehchu amahon gamchom chate ahing taovin ahi; tu-a hi amaho chu anei agou houtoh lhakhat sunga vallhuma umding ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanghon Gibeah'a sumkon binei mut un, Ramah'a sumkon mut un: chule Beth-aven-a hasapmin samun, nanunglam ven, Vo Benjamin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kiphona nikhole Ephraim chu kamhel ding ahin; ahung umtei ding thilchu Israel phungho lah-a kahetsah ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Judah pipuiho chu gamgi chon mang hotoh abangun ahi: hijeh achu achunguva kalung hana twibanga kabuh lhah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lung thanom tah-a danthupeh ajui jeh-in; Ephraim aki suhgentheijin, thutan na-a suhsetnin aumtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh achu keima Ephraim dinga nget kabah ding, chule Judah insung dinga lung kabahding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ephraim'in anatna amua, Judah'in amaputna amuphatnin, Ephraim chu Assyria te koma ache-in, chule leng Jareb koma akisolin ahi: ahinla aman nadamsah joupon, chule namaha hojong asudam joupon ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu keima Ephraim dinga keipi bahkai tobang kahia, Judah insung dinga keipi bahkai khangdong tobang kahiding ahi: Keima, keima tah-in kabotela kache mang ding; kalah manga, koiman ahuhdoh louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahon agitlounau akihetdoh uva chule kamai ahinhol tokah seuva, keima kache-a kaumna mun'a kakile kitding ahi: agenthei naova keima eihin hol paidiu ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hunguvo, Pakai koma kile taohite, ajehchu aman abotel ahin, aman eidamsah dingu ahi; aman eijepmu ahin, aman eitompeh diu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nini joule aman eisuhhal diu ahi; nithum nile eikai thoudiu, chule eiho ama mitmu-a ihindiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Eihon Pakai chu het dinga ijuijuva ahile ihet diu ahi; ama vaikon doh chu jingkah banga gontupsa ahin; leisetna go masale go nunung ajuh banga, ama ichunguva go banga hung juding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Ephraim, keiman nangma i-kalo ding nahim? Vo Judah, keiman nangma i-kalo ding nahim? Ajehchu naphatna chu jingkah meibol tobang ahin, chule jing daitwi bangin achemang jitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh achu keiman amahochu themgaoho mangcha-a kalhamlhah ahitan; kakamsung thuchenga amahochu katha ahitai: chule nathu tanhou chu khovah kikhodoh tobang ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu keiman ganlhaina sangin hepina kadei jon; govam thilto sangin Pathen hetna chu kadeijon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin amahon mihemte bangin kitepna apalkeh-un; keiman dounan kitahlou tah-in achonuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gilead chu khangitlou bolho khopi ahin, chule thisanin akisuhboh-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gucha michom hon mi angailhih bangun, hiti chun thempu hon Shechem lampia athatnun ahi: ajehchu amahon jonthanhoina abolun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman Israel insunga tijat umtah thil kamui; chua chun Ephraim kijohna aumin, Israel suhboh-in aume.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujongle, Vo Judah, keiman kamite sohchan na-a kona kahin lepui kit phatle, aman nangma dinga chang atding nakoipeh ding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiman Israel kasuhdam phat tengle, Ephraim khangit louna le Samaria gitlouna chu kimudoh ding ahi: ajehchu amahon jou abolun; chule gucha alutnin, chule michom hon polama achomun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule keiman akhansetnao abonchan kahei tihi alungun ageldoh pouve; tun athilbol houchun amaho aumchah-u ahitai; amaho kamai koh-a akilange.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahon akhansetna houvin lengho akipa sah-un; chule pipuiho chu ajousei uvin akipasah uvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho abonchauva mijong ahiuvin, changlhah kangpan achangbong ameh jouva, chol achansoh masangse-a, thingkho chumlouva thuhsung ahulsat tobang ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kalengpao nikholaijin pipuihon amachu juhaijin ana natsah-un; aman mijontai ho toh akhut ajahkhomin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu amahon alupmuva mi angailhih sungun, alungsungu chu thuhsung bangin kigosa demin akoijun: achanglhah kangpao chu jankhovah-in a-imun; jingkah-in meikong bangin ana ka-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho abonchauvin thuhsung bangin asa-un, athutanhou aval lhumun; alenghou alhu gam taovin: amaholah-a keima eikouva khatcha aumpon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ephraim amatah miho toh akichohhal tai; Ephraim chu changlhah kilehlou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gamchom mihon athahatna aval lhumpeh-un, ahin aman hichu ahepon ahi: henge, achunga samho adon donna akhangtan, ahinla aman ahedoh dehpon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel akiletsahna chun amai koh-a ahettohsah-in; ahin Pakai a-Pathen'u henga chun akile pouvin, chule hicheng jeh hin holjong aholdeh pon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ephraim jonghi lungthimbei vakhu ngoltah tobang ahi: amahon Egypt akouvun, Assyria henga acheuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaho ache phatnule, achunguva kalen kajahkhum ding; amaho chu chungleng vachaho banga kahin puilhah ding, chule houkhom hon ana jahsao banga, amaho chu kasehgim ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ohe amaho ada ahiuve! ajehchu amaho keija konin ajam mangun ahi. Manthah na chu amaho-a ahi! ajehchu keima dounan asukhelun: keiman amaho kalhatdoh vangin, amahon keima dounan jouthuho aseijun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho ajalkhun chunguva apenu chun, alungsung tah-un keima eikou pouvin; amaho nehle chah le ju ngaitonan akikhomun, chule keima dounan akiphinun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman amaho gotna kapeh-a abanthau kahatsah vangin, amahon keima dounan thilphalou lungin agelun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaho ahung kiheijun, ahivangin hat chungnung pa lam ahipoi; amaho lheplhahna dim thalchang tobang ahiuve. Apipui houchu aham hoithou jeh-a chemjam'a lhuding ahiuve. Hichehi Egypt gamsunga amaho kinuisatna hiding ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sumkon chu namuhto suton. Ama Pakai insung douna-a muvanlai banga hungding ahi; ajehchu amahon kakitepna apalkeh-un, chule ka danthu dounan asukhel taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Pathen, keihon nangma kaheuve, tia Israel chu kaheng lama hung pengding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel'in thilpha chu alemang ahitan; melma chun ama anungdel ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima-a kon hilouvin, amahon lengho akitundoh uvin; amahon apipuiho akisemun, hichu keiman kahepha poi; paidoh-a aum nadiuvin, adangka le sana houvin milim akisemun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Samaria, nabongnou vin nangma napampai ahitan; kalung hana nangma douna-a koudoh ahitai: monabei ahina dingu chu itih chan hinalai dingham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Israel'a kona jong chuti ahi: khutthem miho thilsem ahin, hijeh chun Pathen ahipoi: ahin Samaria bongnou chu ahal hala kisu chipding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu amahon hui chu muchi tu-a atu-u ahin, chimpei aki-at diu ahi: hichun kung aneipon, adonjong chun nehding agadoh sah louding ahi: hung gadoh nama jongle, hichu gamdang mihon avalhum ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel vallhumin aumtai; tun amaho chu vannoi'a chidang namdangho lah-a lunglhaina umlou bel tobang hiding ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu amaho gamlah-a sangan changlhat bangin, Assyria heng lama achetouvun ahi: Ephraim'in kideipi ding akithalah-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Henge, amaho namtinna kon thalah lajongleu, tu-a hi keiman amaho kapuikhom ding, chule leng le pipuiho pohgih jeh-a phat chomkhat lunghem ding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ephraim'in chonsetna dinga maicham tamtah asem jeh-in, maicham hochu amadinga chonsetna ding ahung hitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman ama henga kadan thu lentah ho chu kasut ahitan, hijongle hicheho chu hetphahlou bangin akingaito tai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon kahenga ganlhai thilto dingin sa atoh-un, chule hichu amahon aneuvin; ahinla Pakaiyin hihochu asanpeh pon ahi. Tun aman amaho khangitlouna ageldoh-a, chule achonset nau chunga thu atanding ahi. Amaho Egypt'a kinung leding ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Israel'in asempa sumilin, houin ho asan; chule Juda'in kulpi nei khopi apunsah-in ahi; hijongle keiman akhopihou chunga mei kasol ding, hichun chua aleng inpihou akahchai ding ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Israel, midangte kipa bangin kipah hih-in; ajehchu nangma na Pathen'a konin napotdoh-in nakijoh-in, changphol takip chunga tohman nangai chan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Changphol le lengpitwi chilna chun amaho avasah louding, chule amanu-a chu lengpitwi thah thonding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahochu Pakai gamsunga cheng louding ahiuvin; Ephraim vangchu Egypt gama kile ding, chule Assyria gamsunga thilthenglou anehdiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon Pakaiya dinga lengpitwi thilto atoloudiu, chujongle amaho ama-a dinga lunglhaina hideh loudingu ahi. Aganlhaina hou jong amaho dinga lunghemho changlhah bangding; anejouseu suhboh-a umding ahi: ajehchu achanglhah-u chu ahinna dingu maimai hiding, hichu Pakai insung hunglut louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon chuche niloupi, Pakai kut loupi nikho chule ipi boltauvin natem?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu, veovin, amaho kisuhgamna jeh-a chemang ahitaove: Egypt'in akhop khomuva, Memphis in avuidingu ahi. Adangka kholnau mun nomho chu sachah ling dimding, chule ahoubuh sung houva lingho kehding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gotna kipeh nading nikhoho ahung lhungtan, kilethuhna nikhoho ahung lhungtai; Israel'in hichu ahet ding ahi: nakhan gitlounao dimset jehle, hotna lentah umho jeh chun, themgao chu mingol ahin, lhagaomi chu angol ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ephraim khongahpa chu ka-Pathen toh umkhom ahin, amavang themgao chu alampi jouse-a vachathang kampa thang ahin, chule kihot bolna a-Pathen insunga aume.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sibeah nikholaia bangin amahole amaho akisuseuvin: hijeh-a chu aman akhan gitlounao amelchih ding, chule achonsetnao chunga gotna apeh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman Israel chu lengpithei ga banga gamthipma kanamu ahin; napateu chu theichang phunga ga min masa banga kakimudoh ahi. Ahivangin amaho Baal-peor lama acheuvin, chule hiche jachat umtah mun'a chun akikhinlut taove; amaho thet umtah ahinao chu adeichat banguva umdoh ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ephraim dinga vang, apen napat, naobu sunga pat, chule akijila pat, aloupina hochu vacha banga lengmang ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon achateu lentah-in vahdoh jongleu, keiman amaho chu kalahmang ding, hitia chu mikhat jengjong kidalha lou ding ahi: henge, keima amaho-a kona kapotdoh tengle, ohe amahochu ada ahiuve!
  </para>
  <para style="p">
    <verse number="13" style="v" />Tyre kanamu banga, Ephriam chu leimun nom laija kiphut ahin; ahinla Ephraim'in achate chu tolthatpa koma apuiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo Pakai amaho chu pen; nangin napeh ding chu ipiham? amaho chu naojul lhahna naobu le noitwi kanna chu pen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Agitlouna jouseu chu Gilgal'a aume: ajehchu hiche mun'a chu keiman amaho kanathet ahi. Agitlounau jeh-a keiman amaho ka-in'a kona kanodoh ding, kangailut kit tah louding ahi: apipuihou abonuva thununglou ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ephraim chu akivon, ajungu jong agolhatai, amahon ga aneilou diu ahi: henge, hinsepdoh jongleu, angailut alaigilgau jengjong kathading ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon athu angailou jeh uva, ka Pathen'in amaho apaidoh ding ahi: chule amaho namtin lah-a vahvei dingu ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel chu agabei lengpigui ahi, aman agachu ama dingseh-in asosah-in ahi. Aga atam dungjuijin maicham ho apunsah-in; agamsung phatna dungjuijin milim hoitahtah akisemuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Alungthimu akikhen tai; tu-a hi adihlouna kimudoh ding ahi. Aman amaicham hou asuhkeh ding, amilim semthuhou asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu tu-a hi amahon, Pakai chu igin tahlou jeh-un eiho leng bei ihiuve, achutile lengchun eiho ipi eibol pehdiu ham? tia asei dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon thu aseijun, kitepna asemun jouvin akihahselun ahi. Hijeh chun thutanna chu lou kikaina nunga kehdoh hampa gunei bangin, ahung kehdoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Samaria chengho chu Beth-aven'a bongnouho jeh-a kicha ding ahiuve. Ajehchu chuche-a kona loupina kitoldoh jeh-a chu, mipi ho lunghemuva, thempuhon hichu akipapi dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichu leng Jareb pehdinga Assyria henga kipuiding; Ephraim jachat changding, chule Israel jong amatah thumop jeh-a jahchading ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Samaria ahile, alengpa chu twi chunga twiphon banga kisat lhading ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel chonsetna, Aven munsang ho jong chu kisumang ding: amaicham hou chunga lingle meithai sel tholing hung kehdoh ding; chule amahon molsangho jah-a, neikhu khumun; chule lhangho jah-a, neilhuh khumun, ati dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Israel, nangho Gibeah nikholai japat chonsea nahitaovin; amaho chuachun ading jingun ahi. Khanggilou chate douna-a Gibeah mun'a gal kisat chun amaho anaphapon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho sehgim dingchu keima lungdei ahi; chule amaho achonkhelnao thil ni jeh-a akikan tengule, amaho doudinga mipi hung kikhom ding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Ephraim bongla lahsa tobang ahin, chang childing atha anomin ahi; ahinla keiman amanu ngong hoitah chung chu kapal galkaijin ahi: Ephraim chu achunga touna dinga kasema; Judah'in lou akaiding, chule Jacob'in aleilhangho asuhbong ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangma nangma-a dingin chonphatna muchi tun kitun, hepina in at-nin; naleiset khoikeh louchu khoikeh-in: ajehchu ama ahunga chonphatna nachunga gojuh-a ajuhsah masangse-a, tuhi Pakai holphat tah chu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanghon gitlouna lou kaijin nakaijun, khangit louna na-at nun; lepche ga naneuve: ajehchu nanghon nangho lampi sehsehle, namihat tamtah hou bou natahsanun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh-a chu namite lah-a lungling laona khat hung sohding, Shalman'in galsat nikho-a Beth-arbel asuhmang banga, nakulpiu det jouse kisuseding ahi: Minu chu achate chunga ahal halin akitat kehtai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche banga chu nakhan gitlouna aletjeh-a Bethel'in nachunga na atoh ding ahi; jingkah lamle Israel lengpa chu kisumang helding ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel chu chapang cha ahilaijin, keiman kana ngailun, chule Egypt gama konin kachapa kakou doh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amahon akou bangun, chutichun amaho-a konin achemangun; Baal henga ganlhaina anabolun, chule semthu limho henga gimnamtui ahalun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman Ephraim jong akhut uvin katuh-in, cheje dan kana hilin; ahivangin keiman kadamsah-u ahilam ahepouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman amaho pasal khaohol le, ngailutna khaoguijin kanakaije: keima amaho dinga angong uva kona anamkoljon'u lahdoh pehpa tobang kanahin, chule anehdiu kana luipeh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama Egypt gama kinungle louding, amaho hung kile ding ada jeh uva, Assyria te chu alengpa hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule akhopihou chunga chemjam umding, amaho le amaho kithumopna jeh-a, abahho jouse akahvama, asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule kamite keija kona kinungtol kitdin akonsuh uvin: amahon amaho chu hat chungnung penpa koma dinga akou vangun, khatchan jong achoisang pouvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ephraim, keiman nangma iti kadonda dingham? Israel, keiman nangma iti kapehdoh dingham? keiman nangma iti Admah tobang kasosah dingham? keiman nangma iti Zeboiim tobanga kakoi dingham? Kasunga kalungthim akileh-in, kakisih naho meijin akonge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman kalungsat tijat umtah chu sodohsah pongting, Ephraim sumang dingin hung kinungle ponge: ajehchu keima Pathen kahin, mihem kahipoi; nalah uva Atheng chu kahi: chule khopi sunga lutponge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho Pakai deija chonding ahiuvin: ama keipi bahkai banga kitumding ahi. Ama akitum phatle, lhumlama kona achate kithing puma hungding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho Egypt gama kona vacha bangle, Assyria gama kon vakhu banga kithing puma hungding ahiuve. Chule keiman a-incheh uva kachensah ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ephraim chun joule nalin, chule Israel insungin lepchenan eikim velun ahi. Ahin Judah vang Pathen toh avaihom khomin, chule mitheng hoto tahsana-in aumin ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ephraim huijin akivah-in, chule solam huichu anung ajuije: aman niseh-in joule gamna apunsah-in, amahon Assyria te toh kitepna asemun, chule thaotwi Egypt gama apolut uve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin Judah to jong kinel kalna aneijin, chule Jacob chu achonnaho dungjuija talen apehding; atoh dungjuija alethuhding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman naobu sunga aumpetnin asopipa khotaljum atuh-in, chule athahatna-in Pathen toh akibonin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Henge, aman vantil toh akibonin, ajouvin; ama akapmin, ahenga ngehna ananeije: aman amachu Bethel'a amudoh-in, chule aman hia chun eiho henga thu aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Janel ho Pakai Pathen ngeichu, Pakai kiti chu ama hetjingna min ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun, na-Pathen heng lama kiheijin; hepina le thutana nitnin, chule na-Pathen ngahjing jengin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amachu sumkolvei ahin, lepchena khaikot akhutna aume; aman mi suhgenthei ding adeijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Ephraim'in hitin aseije, keima kahaotan, thilpha kakimu dohtai; chule katoh naho jouse-a amahon keima-a chonset kiti khangitlouna amudoh loudingu ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Egypt gama kipatna keima Pakai na-Pathen hia kahin, kut loupi nikho laiho banga, houbuh sunga kachensah ding nahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman themgao ho-a konin jong thu kaseijin, chule themgao thilmuho kapunsah-in, chule themgaoho lhacha natoh na-a konin, limle mel kibahpiho kamangchan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gilead gamsunga khangitlouna umem? tahbeh-in amaho ahomkeo ahiuve. Amahon Gilgal'a bongchalin ganlhaina aboluvin; henge, amaicham semhou chu louva leilhang kisetoh abanguve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Jacob Syria thinglhang lama ajamlutnin, Israel jiding lonan sohna atongin, chule jiding lonan kelngoi chingin apange.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin themgao amangchan Israel chu Egypt gama konin apuidoh-in, chule themgao mangchan venbitnin aume.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ephraim'in amachu nasatah-in alunghan sah-in: hijeh-a chu athisan chu amachunga adalhah ding, chule ami phosalna chu Pakaiyin ama alepeh ding ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ephraim'in kithing pumpuma thu asei laijin, amale ama Israel sunga akidomsangin; ahivangin Baal houna-a akipal phatnin, athi tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule tun amaho achonse chehcheh-un, adangka hou milim din akisemun, chule ahetnao dungjuijin alim semthu akisemun, aboncha chu khut themhon asemu ahi: chule amahon, ganlhaina neihochun hiche bongnou limho chu chophen, tin aseijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh-a chu amaho jingkah meibol, amangloi chelji matah-a um daitwi, changphola kona chimpeijin alhohmangji changsi, chule thuhsunga kona potdoh meikhu tobang hiding ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla keima Egypt gama kona Pakai le na-Pathen'u hunghipeh kahin, chule nanghon keima tailou Pathen dang nahetlou dingu ahi. Ajehchu keima tailou huhhingpu dang aumpoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman nangho gamthip gam, nasatah-a gojuh louna gama kanahetsa nahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Agamuva hamhingho dungjuijin, amaho a-oiva uvin, amaho a-oiva uvin, alungthimun akichoisangun; hijeh chun keima eisumil taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh-a chu keima amaho dinga keipi bahkai toh kabah ding, chule lampi-a lutnu banga kavet lhihdiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman anou kilahpeh vompi banga amaho kakimaito piding, anahgu bomlah-u kabo jalding; chule chumuna chu keipi bahkai banga amaho kabah gamding: gamsa hon abotel dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Israel, nangmale nangma kisumang nahi; ahivangin keima-a nangma panpi ding aume.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima nalengpau kahiding: nakhopiu pumpi sungahi nahuhhing theidiuva koidang hoija umem? chule, lengpa le pipuiho neipeuvin, tia naseinao navaipo hou chu hoija um hiuvem?
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman kalunghana-in nangho lengkhat kapeuvin, chule kalungsatna-in amachu kalahmang peh uve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ephraim khansetna chu kanchah-in aumin; achonsetna chu selin aumin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Numei naovop hesohnaho chu amachunga hung lhungding ahi. Ama chapa chinglou ahi; ajehchu ama chate hungpen dohna mun'a chu umsot louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiman amahochu lhankhuh thanei na-a kona man kapeh-a kachoh dohding; keiman thina-a kona kalhatdoh dingu ahi. Vo thina, keima nanatna kahiding, Vo thikholkhul keima nakisuh manga kahiding ahi! kamit mu-a kona lungheina chu kiselmang ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama asopite lah-a ga phatah hijongle, solam hui hungnung ding, gamthip gama kon Pakai hui chu hungnung ding, chule atuisam putna hung kanga, chule atuibul hung kangding: aman agou kholnau bel hoitahho jouse asuhset ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Samaria kamhel ding ahi; ajehchu amanun a-Pathen adouvin ahi. Amaho chemjam'a lhudiu, achasen hou ahal hala kitat chipding, chule anumei naovop hou chu kikhejal ding ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Israel, Pakai na-Pathen koma kile kitnin, ajehchu nangma nakhan gitlouna-a lhu nahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thuho chu ponlang, Pakai henga kile kitnin. Ahenga, Khangitlouna jouse lamangin, lungset tah-in nei sangun: hitia chu keihon kakamuva kilhaina kapeh dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Asshur in eihuhhing pouvintin; keiho sakol ho chunga tou pouvinge: chule kakhutsoh hou henga chun, nangho ka-pathen'u nahiuve tinjong seitapou vinge. Ajehchu nangma-a bou panei louten hepina amuvin ahi, tin seijun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman akinung tolnao chu kasuhgampeh-a, manbeija amaho kangailut dingu ahi; ajehchu kalungsatna amaho-a konin akihei mangtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keima Israel dingin daitwi tobang hing ting; ama lily pahcha banga khang tou ding, chule ajungho chu Lebanon banga jamdoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abahho chu jamdoh-in tin, ahoina chu olive thingphung bang hiding, chule Lebanon banga namtui ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama lhalim noija chengte chu hung kileuvintin; chang banga kidodoh kitnuva, lengpitwi banga khang dingu ahi. Chule chu-a anamtui chu Lebanon'a lengpitwi tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ephraim'in, alim semthu ho-a hi ipi-a kapansah nahlai ding ham? Keiman athusei kajan, chule ama kamutai. Keima theichang phung adohing tobang kahi, atiding ahi. Keima-a kona naga kimu-a ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koiham miching? chule hiche thil ho hi hethem hen. Koiham milungching? hicheho chu hehen; ajehchu Pakai lampi ho chu adih ahin, chule midih chu hiho-a chu lamlha ding ahi. Ahinla suhkhelna neihochu hiche-a chu lhuding ahiuve.
  </para>
</usx>
