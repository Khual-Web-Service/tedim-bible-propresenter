<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="OBA" style="id">Obadiah</book>
  <para style="h">Obadiah</para>
  <para style="toc1">Obadiah</para>
  <para style="toc2">Obadiah</para>
  <para style="mt">Obadiah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Obadiah gao thilmu chu ahi. Edom chung changa Pakai Pathen'in hitin ati; keihon Pakaiya konin thuthang khat kajaovin, palai khat Pathen hephaloute henga akisolin: Nangho thoudoh-un, chule amanu douva galla satdin kipatdoh-u hite.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ven, keiman nangma Pathen hephalou ho lah-a neocha kasem nahin; nangma isahlou tah-a kibol ding nahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nalung sunga kiletsahna chun nalhemlhatan, nangma song khikeh kah-a chenga, mun sangtah lo-a chu nahin; nangman nalungin, koijin tolla eiloilhah thei ding ham? tin naseijin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma muvanlai bangin kichoisangin lang, ahsi ho lah-a nabuh gase jongle chun, hia kona chu nangma kaloi lhah ding nahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gucha ho nahenga hungu henglang, michom ho jan-in hungleu, (ichana suhmanga naum ding hitam!) amaho aninglhin tokah uva thil chu akichom lou diu ham? lengpi ga loujiho chu nahenga hungleu, amahon lengpiga phabap beh adalhah lou dingu ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Esau thil ho chu iti kiholdoh theija, athil akisel ho chu iti kikhol doh ding ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman nakiloipi miho chun nangma gamgi chan geija nahin lhutnu ahitan; nakichampi miho chun nalhep lhah-u ahitan, jojong najou ahitai. Nachanglhah neho tah jong chun nanoija mahaput theina akoijun; ama-a het themna aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Edom'a kona miching ho kasuhmang louding hija, Esau molsanga kona hetthemna kasuhmang louding ham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Teman, Edom molla amitin chu tolthatna pang hon akhona channa athagam theina diuva, nami thahat tahtah hochu lunglha diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nasopipa Jacob douna-a pumhat tah-a nathilbol jeh-a jum nan nahinkhu ding, chule a-imatih channa dinga nangma sat lhah-a naum ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangma agal lang khatna nadin nikho, gamchom mihon agalmiteu gal hinga akaimangu nikho, chule gamdang miho chu akotpi ho-a alutnuva, Jerusalem chunga vang asanuva chun, amaho lah-a khat bangin nangma napangin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla nasopipa gamchom mi akiso nikho chu, nangman navet louding; chujongle Juda chate kisuhmang nikho-a chu nakipa lou ding; chule hahsatna nikho-a chu kiletsah tah-a thu jong nasei louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho vangsetna nikho-a chu nangma kamite kotpi-a nalut lou ding; chule amaho hamsetna nikho-a chu nangman akibol gentheinao navet lou ding, avangsetnao nikho-a chu athilkeu hou chunga jong nakhut nasuhnat lou ding ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangma ajamdoh-a miho suhmang dinga lamthom ho-a jong nanadin lou ding; hahsatna nikho-a hoidoh-a umden ho chu peh jong nanapeh doh louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu Pakai nikho chu Pathen hephaloute chunga chu din ahung naije; nangman nabol bang banga nachunga hung kibol ding; natohman chu nangma tah luchunga hungkile ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu nangman keima molsang theng chunga nana don banga, chutobanga chu Pathen hephalouten adon jing jengdiu; chule amahon adonuva, avallut diu, chule a-itih-a ana umkhalou banga umdiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla Zion molsang chunga chun kihuh dohna umintin, chule hia chu thenna umding, chule Jacob insungin agouvu chu akilo kitdiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Jacob insung chu mei hunghi ding, Joseph insung chu meikou hunghia, Esau insung vang polkung hungsoh ding, amahon amaho chu meija ahal dingu, Esau insunga chu amoh ahinga khatcha umlou ding ahi; ajehchu hiche hi Pakaiyin asei ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule lhanglam sang miho chun Esau molsang chu ahin lodiu; chule phaicham mihon Philistine alodiu; amaho chun Ephraim phaileiho le Samaria phaileiho ahinlouva, chule Benjamin'in Gilead ahinlo ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule sohchanga hiche janel Israel chate hin Kanaan gam alodiu, Zarephath chan gei ngeija ahinlo diu ahin; chule Sepharad'a um gal hinga kikai Jerusalem mite chun, lhanglam sang khopi ho chu alodiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Esau molsang chunga thutan dinga huhhingpu chu Zion molsanga kon hungdoh ding; chule lenggam chu Pakaiya hiding ahi.
  </para>
</usx>
