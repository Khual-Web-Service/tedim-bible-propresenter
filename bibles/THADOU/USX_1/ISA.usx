<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ISA" style="id">Isaiah</book>
  <para style="h">Isaiah</para>
  <para style="toc1">Isaiah</para>
  <para style="toc2">Isaiah</para>
  <para style="mt">Isaiah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengho Uzziah, Jotham, Ahaz chule Hezekiah nikholaija Judah leh Jerusalem chungchang thudolla, Amoz chapa Isaiah munei;
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo, vanho ngaijun, chule vo leiset, nana hinsungin. Ajehchu Pakaiyin thu aseitai: keiman chapangte chu kahinkhoukhah-a kahinseilet dohsah ahitan, hinlah amahon keima dounan na atong taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bongchal'in apu akihetnin, chule sanganin apun an apehna kong akihet-in; ahinla Israel'in vang ahepon, kamiten angaitopha himhim pouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ohe chonse nam mite, khansetna pohgihpo mite, thilsebol chilhahte, manthah sah chate; amahon Pakai chu adalhaovin, Israel dinga Mithengpa chu lunghan sahdin achoh thouvun, nunglama akitolmang taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ipidinga nangho kivoto jingjeng nalai nahiuvem? Nakisatto nahlai ding'uham? luchang apumin anatan, chule lungthim apumin acholtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kengto apat luchang geijin adamkom aumtapon; ahinla mapule kivodup, chule tina monsa ahin; amahon jenla ajen pouvin, tomla atom pouvin, thaojong anu pouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nagam sungu akamdeltan, nakhopihou jong meijin akihalha gamtai. Gamdang mihon nagamu na-angsung tah uva abahgamun, chule akamhelin, gamdang mihon alehkhuphel taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zion chanu chu lengpi leija buhcha bangle changmai leija buh kisong bang, khopi kiumkim vel tobang ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Janel Pakai chun amoh themcha khat eikhen louvu hileh, Sodom toh ibah uva, Gommorah dung isun jengdingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sodom kho-a vaihomten, Pakai thuhi ngaijun! Gommorah mite nanghon i-Pathen'u danthupeh-a nanau hinsung uvin!
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai chun, naganlhai nao hijatpihi keidia iphatsah naham? ati. Keiman kelngoichal govam thilto lhingset le gancha kivah thao tahtah kaneije. Keima bongchalho thisan hihen, kelngoinou ho thisan ahilouleh kelchate thisan'ah kalunglhaipon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangho ka-angsunga nahung kilah tenguleh, ka inpi chonthanghoi dinga koiham nangai chaovah?
  </para>
  <para style="p">
    <verse number="13" style="v" />Thilto pannabei ho chu hinchoikit tahih hel'un; gimnamtuijong keidia thet umtah ahibouvin; lhathah nikhoho le cholngah nikhoho chule khoppi kikouho jong kadou theipon, chujongleh khoppitheng kikouho jong gitlouna ngen ahibouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nalhathah nikhohoule naphat kitepmu kutho chu kahin nan ahot ahi. Eilunggim sahbep ahiuvin abonchan kapochim set tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nakhut nahin lhandoh tengu jongle, nangho-a kona kamit kaselding, tamtahvei taona hinnei jeng jongleu chun kangaipeh louding nahiuve; ajehchu nakhut hou thisan dimset ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kisilthengun lang, kisuthengu vin; kamitmu-a konin nathilbol phalouhou chu koimang unlang; thilse bolda taovin,
  </para>
  <para style="p">
    <verse number="17" style="v" />thilphabol kithemchuh-un, thu adih-a tanding gouvin, akibol gentheiho panpiuvin, panei loute thu tandih unlang, meithaiho seihuvin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakaiyin hitin aseije: tun hungun lang gelkhomu hite, Nachonset nao santhip bangjongle, buhbang banga bangding; sandup jeju tajongleh kelngoimul bangding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangho nanop uva thu nangai ule, gamsung phatna chu nanehdiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla nadaova nadeh uvangle, chemjam'a nalou gamdiu ahi. Ajehchu Pakai kamin aphondoh ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khopi tahsan umtah chu i-atile noti hungsoh-a hitantem! Thudih tanna anadimin, chonphatna analengin; hinla tun tolthat jeng ahitaove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nadangka thih eh asoh in, nalengpi twila twitoh kihal ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Napipui houla dou lungpu jeng ahiuvin, chule guchaho kiloipi ahiuve. Amitin-in pehguh angailuvin, chule kipaman del le ahiuve. Amahon panei loute thu atanpeh pouvin, meithaiho thujong atan diuvin ahengu ahunglhung khatapoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun janel ho Pakai, Israel dia mihatpa chun hitin aseije; Ahi! Keiman kakidoupi teho lhadoh ingting kamelmate phu kalah teiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Keiman nachungah kakhut lam ingting, chule nathih eh chu thengtah a kalhah thenga, nasum lhahjol jouse kalah mangding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keiman nathutan ho kaki ledoh sah-a, chule nathuhil ho jong akipat tilla banga kaumsah kitding ahi. Chuche joutengle chonphatna khopi, tahsan um khopi tia naki minvo ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zion chu athu kitanlha-a kilhatdoh ding, chule amanu kisihna chu chonphatna hiding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin doumah bolteho le achonseho chu mangthah khomintin, chule Pakai dalhahho chu suhmang hela umdiu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu nangaichatnu gangpi phungho chu ajachat piuvin, naki lhensao honlei chu nalungjinpi diu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajehchu nangho gangpido pulsa bangle, twi umlouhel honlei tobang nahi dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule mihat chu saikhao nem bangintin, hiche sempa chu meisipah bangding, chutia chu kavam lhonding, koimachan aphelmit louding ahitai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amoz chapa Isaiah'in Judah le Jerusalem chungchang thudol chu anamu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ninunung lamle hitiding ahi, Pakai inmun molsang chu molsang chung vum ho-a hung kiphutdoh ding ahin, lhang vum ho-a kichoisanga; chutengle namtin vaipi chu kijotlutdiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiteng chule chitin, namtin hunguva hitia aseidingu ahi; hungun Pakai Molsang chunga kaltouvu hitin, Jacob Pathen inna chun cheu hite; chutia chu aman alampi thudol eihil uva, ama lampia chu ichediu ahi, tiuvinte. Ajehchu Zion'a kona dan thupeh le Jerusalem'a kona Pakai thuchu hungpotdoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutia chu aman namtin vaipi kah-a thu atana, mitamtah aphosalding; amahon achemjamhou loukaina, chule atengchahou kangkuija akikhendiu; namkhat douna-a namkhat nin chemjam lamtalou ding, galbolje jong kijilna umlou ding ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Jacob insung miteho, hunguvin, Pakai vah-a chun cheleu hite.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu nangman nami Jacob insung chu napaitai, ajehchu amaho solam mite chona dimset ahiuvin, Philistine ho bangin gaothu aseijun chule gamdang mite chate toh kipa thanop abolkhom jiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Agamujong sanale dangka adimsetnin, chule agou khol hou jong angahna bei ahin; agamsungu jong sakol adimset'in, chule asakol kangtalai hou jeng jong akichaitih aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Agamsung jong milim semthu adimsetnin; akhut tah uva aboldoh-u akhutjung ngeijuva asemsao chu ahouvun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Milham hon chibai aboh-un, milen ama le ama akisuneovin, hijeh chun ngaidam changlou diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thahat tah Pakai ginna le alal loupi masanga chun songko sunga lutning lang leivui lah-a gakiselin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihem kivetsangna chu kisunem intin, mihem kiletsahna chu kisulha ding, chule Pakai changsehbou chuche niteng chule choisanga umding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu ahoithole akiletsah chan chule akichoisang chan chunga chu janel Pakai nikho hunglhung ding, chule amaho chu kisunem ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lebanon Cedar thingsang hole adoh sangho jouse chung le Bashan gangpiho jouse chunga,
  </para>
  <para style="p">
    <verse number="14" style="v" />molsang ho jousele lhang kichoisangho chunga,
  </para>
  <para style="p">
    <verse number="15" style="v" />in-song sangtin hole galpal kikaiho chunga,
  </para>
  <para style="p">
    <verse number="16" style="v" />Tarshish kong inneiho jouse chungle, khutthem kisem thilho jouse chunga hunglhung ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule mihem kichoisang nachu kisulhantin, mihem kiletsahna chu kisunem ding ahi. Chule chuche ni chule Pakai changsehbou choisanga umding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutengle semthu milimho jouse asuhmanghel ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tijat umtah a leiset hotling dinga akipatdoh tengle, Pakai ginjehle alal loupina jeh-a, amahochu songpiho kohomsung le leikoho sunga lutding ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hicheni chule mihon adangka milimhou le asana milimhou, ama ama houding cheh-a akisem houchu, bui hole bah ho henga ahinse manguva,
  </para>
  <para style="p">
    <verse number="21" style="v" />tijat umtah-a leiset hotling dinga ahung kipatdoh tengle Pakai ginjehle alalna loupijeh-a songpiho khikeh sungle songpiho pohkeh sunga chu lutdiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihem anah-a hai maimaipa-a konin kikangseuvin, ajehchu ama ijapang dingham?
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ijeh-inem itile, veuvin, Pakai janel Pakai chun, Jerusalem'a konle Judah a konin, anehnao lampile adonnao lampi jouse aladohsoh heltai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihatpa le gal hatpa thutanpa le themgao, milungching le upapa ahin,
  </para>
  <para style="p">
    <verse number="3" style="v" />mi somnga kaihoipa le mija umpa, thumopthempa le khutthempa, chule kamthem mitpheldoi thempa ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keiman chapangho chu apipuiho diuva kapeh ding, naosen hon achunguva vai ahomdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule mipichu suhgentheija umding, amitakip chu midangin chule amitakip aheng akomin asuhgenthei ding; Chapang chu upa chunga chule pannabei michu ja-umtah chunga kiletsah tah-a umding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Min apa insungmi asopi khat atuh-a, nangin ponsil naneijin, kavaihom-un panginlang hiche amangsahi nakhut noija umhen atitengle,
  </para>
  <para style="p">
    <verse number="7" style="v" />hiche nikhoteng chule aman asap phonga, keima midamsah hiponge; ajehchu ka in'a nehdingle ponsil ding aumpoi. Mipi vaihomin neipansah hih-in, hin tinte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu athuseijule anatoh-u chu Pakai dounale aloupi mithipsah bou ahitah jeh-in, Jerusalem kipal lhu-a chule Judah chu lhu-a ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amel lhona kilang chun amaho adou ahettohsah-in; hicheho chun Sodom'a tobang achonsetnao aphongjalin, aselpeh pouve. Amanitah-in thilse akilamthu lhon jeh-in ahinna lhonchu ohe ada na-e!
  </para>
  <para style="p">
    <verse number="10" style="v" />Michonpha chu seipeh-un, hichu ama dinga apha ahi, Ajehchu amahon atohgao chu anehtei dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Migilou chu ada ahi! amadin hamsetna ahi. Ajehchu akhut teni-a atohdoh chu kipeding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kamitehi amaho bolgentheija pang chate jeng ahitaovin, numei hon achunguva vai ahom uve. Vo kamite, napuihouvin napuiseuvin, nachennao lampiho asumanguve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai chu thutan din ahung kipanin, miho thutan ding chun adingtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai chu amite upaho le milen milal ho toh thutanlha dinga lutding ahi. Ajehchu nanghon lengpilei chu nanejouvun; migenthei ho thil kichomdoh chu na-in uva aumme.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kamite navoh ngem uva migenthei te maichangtah sumheija natahgoijiu chu ipi natinao ham? tin janelho Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuche kalvallin Pakaiyin aseije; Zion chanute chu hoithotah-a aumuva, ngong vaiputna le jonmit puma avaleuva, akengu jangjet jetna chule gingdet detna achejeh-u ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche jeh-a chu Pakaiyin Zion chanute lujang khichet chutna ajepma, Pakaiyin atahsao aselguh laihou chu ahodoh pehdiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche nikho chule Pakaiyin akenguva jephoina gingselsel, haona a alukophou, lhathah tobang angong ou chu asutlhah ding ahin,
  </para>
  <para style="p">
    <verse number="19" style="v" />Sumgui ho, chaojangho chule ngongvei ho,
  </para>
  <para style="p">
    <verse number="20" style="v" />Lutomna ho, keng jephoina ho chule lukanna ho, gimnamtui ho bomho, chule bilba ho,
  </para>
  <para style="p">
    <verse number="21" style="v" />khutjem ho le nahkuiba sana ho,
  </para>
  <para style="p">
    <verse number="22" style="v" />von khelthei ho, sangkhol chol ho, ponsil ho chule dipho,
  </para>
  <para style="p">
    <verse number="23" style="v" />phatvet ho, tupat ponnem ho, delkop ho chule ponlukhuh ho, asutlhah peh diu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hunghiti ding ahi: gimnamtui khella a-ui; konggah khella khaojang; sam pojolsel khella lutol leolou; ponchol hoitah sanga khaodip pon; melhoina sanga meikah umjoding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Napasal hou chemjam'a, namihat hou galla thigamdiu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule amanu kul kotpiho chu lunghema kapdiu; amanu ahomkeo ahitahjeh-a tolla touding ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule hiche nikho chule numei sagin pasal khat atuh uva, keihon ka-annu kineh uving ting, kaponnu kisil naovinge; eiki housetnao lahmangna dingin namin sehseh neiput sah-un, atidiu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche nikho chule Pakaiya kona abah jamdoh chu hoitahle loupitah hiding ahin, chule Israel, ahoidoh hodinga leiset gachu nasatahle hoitah hiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hunghiti ding ahi, Zion'a kadalha-a, Jerusalem'a umdenpa chule Jerusalem'a ahingho lah-a kisunlut chasun geija chu atheng kitiding ahin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin Zion chanute nen asoplhah-a, chule Jerusalem lailunga patna lhagao thutanlhah nale, lhagao meikonga Jerusalem'a thisan behho chu asopthengsoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pakaiyin Zion lhanga chenna jouse chungle, akikhopnahou chunga chun, sunle meilhangle, meikhu janle meikong vahtah asempeh ding ajehchu loupi jouse chunga chu ahongah umding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutengle sun nisatna kona limding le belding khopihuile gellhah a kona hoinading houbuh khat umding ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun keima kangailutpa henga alengpilei thudollin kangailut nan la sange. Kangailuttah pan thinglhang leiphalaija lengpilei khat aneije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman alhou ngimin, chua songho alohdoh in lengpigui phapentah aphutnin, alaitah-a insang khat asan, asunga chun lengpiga chilna khatjong asemin; chule aman hichun lengpi ga hinsepdoh teijinte tin angah jingin; ahin hichun gam lengpi ga ahin sepdoh tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule tun, vo Jerusalem'a chenghole, Judah pasal ho keile kalengpilei kah-a thuhi neihin tanpeh temun tia kangeh nahiuve,
  </para>
  <para style="p">
    <verse number="4" style="v" />kalengpilei dinga bolthei kanabol loulai ipi uma ham? Lengpithei ahung gadohding kingah-a ibolla gam lengpithei ga ahinsepdoh ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule tun, kalengpi leija kabolding chu hil unge; alingtho kaphetlhah'a, min anehjou ding; asongpal chu kasuhchima, michot pha-a umding ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman agoh a kakoija, lho-ngimlou le lailouva uma; lingle khao hung kehdoh ding ahin; meibol ho jong thu kapeh-a achunguva go ahinjuhsah louhel ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu janel Pakai lengpilei chu Israel insungle adeitah a aphu Judah mitehi ahiuvin; aman thudih joh aven, ahinla veuvin bolset najoh ahin; chonphatna chu veuvin ka najoh ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ohe! ada ahiuve, in le in jopmatho, lou keh bebe ho, mun beihela koiho, leiset lailunga achangseh uva chengding ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Janel Pakai chun kanabenga aseitai, atahbeh-in; in tamtah, lentah tahle hoitahtah chu achengding beija kamhel gamding, ahi tin aseije,
  </para>
  <para style="p">
    <verse number="10" style="v" />chule lengpilei ching soma bath khatbou sohding, muchi homer khat kituna ephah khatbou soh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ohe! ada ahiuve, Khamnathei dondinga jingkah matah-a thouva, lengpitwi jin achupkah seuva jankhang geija touho.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon selangdah chule semjang, khongcha, kuli, chule lengpitwi jin golnop abollun; ahinla Pakai thilbol lah akhohsah pouvin, akhutna atohdohho jong angaito himhimpouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun kamiten hetna aneilou jeh-un sohchangin acheuvin, amija-umteu agilkelun, amipiteu dangchah in adango gamtaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun, te joulou khopma lenin thikholkhul chu akam akahommin; aloupinahou, amipiteu, akichoisangho, chule athanompa jengjong chuche sunga chu kumsuh diu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Minoinung chu kisonkun ding, mithaneipa jong kisunem ding, mikiletsah te mit jong nguilha ding ahi
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla janel Pakai chu thutanlhahna-a choisanga umding ahin, chule Pathen, athenga chu chonphatna-a suhthenga umding ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuteng kelngoinou ho chu hamhing lah-a lhaleuvintin, chule mun gohho-a leiphalaiho chu gamdangmin anehdiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ohe! ada ahiuve, imacha hilou khaoholla khangitlouna chule kangtalai khaova kiheh chonsetna kaikhomho.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keihon kamutheina diuvin kigansah henlang, anatoh kino hen; chule kahet theina diuvin Israel mithengpa thumopna chu hungnai hen, tia seiho chu!
  </para>
  <para style="p">
    <verse number="20" style="v" />Ohe! ada ahiuve, aphalou apha tia, apha aphalou tia; khovah dinga muthim koija, muthim dinga khovah koiji, alhum dinga akha koija, akha dinga alhum koiho.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ohe! ada ahiuve, ama mitna ching kisa-a, ama mitmu-a lungching kisaho.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ohe! ada ahiuve, lengpitwi donna mihat tah hija, khamnathei donding halna-a thahat tah ho.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuho chun migilouho kipaman peh them achanun, midihtah dohna chu ama-a konin aladohjiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun meijin chang ki-atna kung akahvam bangle, meikongin changsi aleumang banga, chutia chu ajungu monlha a, apah-u leivui banga kitungdoh diu ahi. Ajehchu amahon janel Pakai danthupeh apaimangun, Israelte mithengpa thu chu anahsahpouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh-a chu Pakai lunghan amite douna-a deujah jeng ahi. Amaho douna-a chun akhut alamin adengtan, chule athi longu khopi lamlen laidunga akisat telin ahi. Ajehchu hiche jousehin alunghan naho chu abeidehpon, akhut chu akilamjing nalaije.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman gamlatah-a kona namtin dinga ponlap atahsang ding, kolmonga kona amaho asapkhom tengle amaho gangtah-a hung lhungloi jengdiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Alah uva athacholle akipalhu khatcha umpou vinte; khatcha alulhu, a-ihmu umpontin, akonguva konggah kikang ahiloule akengkoh khao tanna umlou helding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Athalmuh-u ahemthet-in, athalpi jouseu kaosan akichoijun, asakol tin houchu meituh song bangjeng, chule asakol kangtalai kanghou chu chimpei kiheh bangding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Akitum ginu keipibahkai bang hiding, keipi noute banga kitumdiu; hitia chun kitum muntin, sahing kimat untin, phatecha alhoh manga, koimachan ahuhdoh louding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche nikho chule amaho twikhanglen kitumgin banga amaho douna-a kitumdiu ahi. Khatouvin hiche gamchu gahvele, veuvin muthimle lung hesohna, khovah chu van'a muthimin ahin lekhuding ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Uzziah lengpa athikum chun Pakai chu laltouna sangtah chunga atouva alalpon chun houin alodimset chu kana mun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Achunga chun alha gupcheh nei Seraphim'ho anadingun; alhaving ni in amai akhun, ni in akengteni akhun, ni in alengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule khatchun khat henga, ATHENG, ATHENG, ATHENG, chu janelho Pakai chu ahi. Leiset pumpihi aloupina adimsetne tin asamin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ahinsampa Ogin chun kotpi khomho akihotnin, chule in chu meikhun adimtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin kaseitai: ohe ada kahi! ajehchu keima kamtheng lou kahin, mi kamtheng loute lah-a cheng kahi. Ajehchu kamitnin leng janel Pakai chu amutai, kati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin maicham-a kona akhutna mei-am chaichea hinchoija, Seraphim holah-a khat kahenga ahung lengin,
  </para>
  <para style="p">
    <verse number="7" style="v" />chuin kakam-ah ahinkoijin aseitai; ven, hiche hin nane teni atongkhatan; nakhansetnaho akilamangin nachonset naho jong suhthengin aumtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun Pakai awginin hitia asei kajai: keiho dinga koi chedingham? Hichun keiman kaseijin; keima hia kaume, neisolin kati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman chenlang, hiche mitehi gahilin, nanghon jaovin natin, ahinla nahetkhen theilou dingu; chule mu uvin natin, ahinla nahetdoh loudiu ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche mite lunghi thao tomsah inlang, anao ngonsah in, chule amitnujong kisinghen; achutiloule amitnun muvintin, anaovin jauvintin, alungun hekhen-uvintin, lung heijuntin, chule damget nunte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin keiman Pakai itih chan hiding ham? Katile aman eidonbutnin; khopiho acheng beija agohkeo ahikahsele, inho-a mi acheng abeihela, agamchu akamhel kahse-a,
  </para>
  <para style="p">
    <verse number="12" style="v" />chule Pakaiyin mite chu gamlatah a achon manga, agamlailunga mun kidalha lentah umding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla hiche sunga chun somlah-a khat umintin, hichu kile-a kinejouding, chahthing phungle gangpi thing ana apultengle akungbul umnalai banga muchi theng chu akungbul umjing ding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Jotham chapa, Uzziah chapa, Judah lengpa Ahaz lallaijin, Syria lengpa Rezinle lengpa Pekah Remaliah Israel lengpa chapa chu Jerusalem satdingin akontou lhonin, ahivangin anajou joulhon tapoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Syria chu Ephraim toh apangkhome ti David insungmite akihiltai. Chuin amale amite lungchu gammang thingho huijin amutling bangin alinglao gamtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun Pakaiyin Isaiah henga, nangle nachapa Shear-jashub chu twikul sahnung twilam monga ponsoppa lamlhonga khun Ahaz to kimutodin potdoh lhoninlang;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahenga, chingtheijin lang thipbeh-in Syria toh Rezin le Remaliah chapa engset lunghanna maiso mei khuthethu ni tobang chu kicha hih-in, lunglhah nanjong neihih beh-in ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu, Syria, Ephraim, chule Ramaliah chapan nangma dounan thil gilou angaitouvin aseijuve,
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah doudingle nokhum dingin chetou uhitin, khopi chu suchimu hitin, chutengle alaija chun Tabel chapa chu lengin tung uhite.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai Pathen'in hitin aseije, hichu ding joulou ding, guijong guilhung louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu Syria luchang chu Damascus ahin, Damascus luchang chu Rezin ahin; kum somgup le kumnga sunga Ephraim chu namkhat hiloudinga kisucheh ding ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Ephraim luchang chu Samaria ahin, Samaria luchang chu Remaliah chapa ahi. Natahsan lou uleh atahbeh-a naki phudet louhel ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chukalvalin Pakaiyin Ahaz henga aseijin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangman Pakai na Pathen henga melchihna kithumin; hathuh-a thuh ahiloule hasana sangkhat kithumin, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla Ahaz in, keiman thumponge, Pakai jong patep hihhel ing kate, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman aseitai, David insung mite, tun nanghon ngaitemun! mihem cholsah hi thilneova nagel uva, ka Pathen sana nacholsah jeng dinguham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun Pakai amatah-in melchihna khat hinpeu vinate; veuvin, nungah theng khat gai jintin chapa khat ahinding, aminchu Immanuel kitiding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman bongnoi thaole khoiju aneh ding ahi, chutia chu aman aselam hotbola aphalam lhenje ahetding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu chapang chun aselam thetbol dingle aphalam kilhen dingje ahetthei masanga nanaginu gamhochu aleng teniu chun adalhah diu ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Judah'a kona Ephraim achemanga patna ana lhungkhalou nikhoho chu Pakaiyin nangle namite chung, chutengle napa insung mite chunga Assyria lengpa nahin lhutpeh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiche nikho teng chule hung hiti ding, ahi. Pakaiyin Egypt vadunga thousi ho mutkhom minintin, chule Assyria gamsunga khoiho akoukhom ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amaho hunguntin, abon chaova phaicham gohkeu laija songpi kohomho-a, lingho chung jouse-a, chule hamhing ho chung jouse-a umdiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hicheni mama-a chu Pakaiyin samchem alap'a vadung gal lamho toh Assyria lengpa chu aluchangle akengmul ho ahet namding ahi; chule akhamul sanna jong ahet chaiding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche nikhole hung hitiding ahi, pasal khatnin bongla khatle kelngoi ni avulding ahin;
  </para>
  <para style="p">
    <verse number="22" style="v" />chule hung hiti ding ahin, chuche teng chule bongnoi nengtah-a apehdiu jeh-a amapan bongnoi thao anehji ding ahi. Ajehchu chuche gama kidalha chanchun bongnoi thaole khoiju jeng anehdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule chuche nikholai chule hung hitiding ahi, dangka sangkhat man cheng, lengpilei sangkhat umna munchana chu lingle khao jengbou kehding ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Agam pumpi lingkhaole lingphung ahung dimtah ding jeh in chulama chu thalpi le thalchang puma miho hungdiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule tuphenga kilai lhang jouse chunga linglekhaoho ginna-a chulama hunglou ding, ahin, bongchalho le ganchaho lhatna hung hiding ahitai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukalvallin Pakaiyin kahenga Maher-shalal-hash-baz chung thudol, lekha jol lentah khat lanlang asunga chun mihem twi-mollin sunin eiti.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin thuching ding hettohsah tahsan umtah Uriah thempulen le Jaberekiah chapa Zekeriah chu kapansah in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin themgaonu henga kagachen; ahile amanu ahung gaijin chapa khat ahinge. Chuin Pakaiyin kahenga amin Maher-shalal-hash-baz sah-in ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu naosen chun hepa heno tije hetna anei masanga, Damascus haonale Samaria thilchomdohho chu Assyria lengpa anga kipomang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai chun kahenga thu ahinsei kitnin,
  </para>
  <para style="p">
    <verse number="6" style="v" />hiche mite hin Shiloah twi longdel delho adeimouva, Rezin le Remaliah chapa akipapi jeh uvin;
  </para>
  <para style="p">
    <verse number="7" style="v" />hijeh tahchun tun vetan, Pakai chun vadung twiho hattahle tamtah, Assyria lengpa le aloupina jouse jengjong achunguva alonvuhsah ding, twilam jouse ahinchupma avakam jouse-a letlha ding,
  </para>
  <para style="p">
    <verse number="8" style="v" />chule Judah gama longlutna achupsoh-a letlha ding, ngong geihel aphahding chule alhaving jahchun nagamu avai akhokhong ding ahi, vo Immanuel, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo miteho nangho ahal hala chiplhading nahiuve! gamlhatah miho nabonchaovin nanau hinsungun, natai kigah-uvin, achutiloule ahal halla nachipdingu ahi,
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngaito khomun phachomponte, thuchu seijun dingjou pouvinate. Ajehchu Pathen'in eiumpiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu khut thahat tah-in, Pakaiyin kahenga aseijin, hiche mite lamlhah a kavale lounadin eithumop in, hitin aseije;
  </para>
  <para style="p">
    <verse number="12" style="v" />hiche miten guhthima thilphalou agonu ahi tia asei-ujong guhthim tohgon ahi tin seidao henlang, agihnao jong kichat nale gentheinan neidaohen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Janel Pakai amatah chu thensah-un lang, naginnu ama hisah unlang, natijat naochu ama hihen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amachu muntheng hiding, Israel insungteni dinga vang kipalna songle kisuhmona songpi hiding, Jerusalem'a chengho dinga thangle pel hidingbou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Alah uva mi tamtah kipala lhuhna le kisuhgepna hiding; thanga oh-uva kimandohdiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hettohsahna chu kantup minlang danthupeh chu kaseijuite lah-a namdet jengin,
  </para>
  <para style="p">
    <verse number="17" style="v" />chule keiman Jacob insunga kona amai selmangpa Pakai chu ngah ingting, amabou vengkate.
  </para>
  <para style="p">
    <verse number="18" style="v" />Veuvin keile Pakaiyin eipeh chapangtehi, Israel insunga melchihna leh thilkidang hidinga Zion molla cheng janel Pakaiya hungkon kahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amahon naheng uva mithisa lha kouho le doithemho guhthima vea, phuisam ho chu hollun atitengule miten athi khella ahina dinga a-Pathen'u chu ahollou dingu ham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Amahon dan thupeh le hettohsahna thu dungjuija asei lou uleh, asunguva khovah umlou ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amahon hesohtahle gilkeltah in gamchu jotpaovintin, chule hitiding ahi. Gilkella aumtenguleh, lungsa tuntun untin, alengpaole a-pathen'u gaosap untin chunglam avetdiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiteng chule amahon tollam hinveuvintin, lungkhamnale muthim, lungnat khojin amudiu chule amahochu muthim lah-a kinolutding ahiuve.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahijeng vangin lunglha-a ana um amanu dingin nguina umta ponte. Phatmasa laija chu aman Zebulun gam le Naphtali gam chu olla ana gimbol ahin, chule khonungle Jordan gal, twikhanglen lampi-a namdangte Galilee chu nasatah-a abolgim be cheh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Muthima vahle mihochun vah loupitah amutaove, thina lim gama chengho chunga chun kho avahtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangman namtin vaipi chu napunsah-in, kipana napunsahtai; nangma masanga chang-at laija kipana bangin akipah-un, chule thilkichom akihoptenguva akipau bangin akipah uve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nangman amapa pohgih namkoljon le alengkouva mol lhon, chule sugentheipa moltum chu Midian ho nikho laija bangin nasuhbohpehtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu gal hatpa galbol jouse ginchu kisuhnohna awginin ajuijin, chule galvonho chu thisan abehjin, ahinla hichehi kavama meikhu sohding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ijeh inem itile eihodingin naosen khat apengin, chapa khat eikipeuve, chule vaipohna chu alengkouva aputding, chule aminchu kidangtah, thumopthem, hat chungnung Pathen, tonsot Pa, chamna leng chapa kitiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />David laltouna chung leh alenggam chunga avaipohna le chamna khangtou ding, akichaitih umlou ding ahi. Tua pat atonsot geija thutanna le thudih atundoh ding ahi. Janel Pakai tompanna chun hichehi abolding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin Jacob thukhat athotnin, hichu Israel chunga alhungtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule mijousen hichu aboncha ahetdiu ahin, Ephraimle Samaria'a cheng hoithotah le kiletsah tah-a seija:
  </para>
  <para style="p">
    <verse number="10" style="v" />cheh ho achimlhatan ahinla song kikheng in kisah taovinge; Theiba akiphuhlhun ahinla cedar thingin kheltao vinge, tihochun hetao vinte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Pakaiyin Rezin kidoupiho chu ama doudin tungdoh intin, amelmate chu apankhompi ding ahin;
  </para>
  <para style="p">
    <verse number="12" style="v" />amasanga Syria ho, anunglama Philistine hon kamka-a Israelte avallhumdiu ahi. Hicheng jouse jehhin alunghan abeidehpon akhut alamjing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuteng jongleh mipi ho chu abolgimpao heng lama akihei dehpouvin, janel Pakai jongchu aholdeh pouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun Pakaiyin Israel'a kona alu le amei, abah le apumpeng chu nikhatleh asatlhah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miluile mija-um, amachu alu ahin. Jouthuhil themgao amachu amei ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu hiche mite lamkaihon asuhkhelsah uvin, chule alamkai houchu suhmangin aumuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun agollhangho chunga chun Pakai chu akipahpon, apabeiho le ameithaiteu hepinajong anei louhel ding ahi. Ajehchu amitakip aphalhemle khansetbol ahiuvin, akamuvin ngolthu aseicheh uve. Hicheng jouse jehhin alunghan abeidehpon, akhut alamjing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu dihlou nahi mei bangin akadohjin; hichun lingle khaoho akahvam ding, chule gammang thim letlut lah-a kongdoh a; chule meikhu kitungdoh banga kaltou diu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Janel Pakai lunghan na-a kona gamsunga thim jinga, mihochu meija tiding thing tobang hidiu ahin, koimachan asopipa jong akhen louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman akhut jetnin manloi chelintin, hijongle agilkel phachom louding; Chule akhut veilamin nentin, oivadeh louding ahi, amitakipmin ama banphe cheh akineh dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Manasseh, Ephraim; chule Ephraim, Manasseh: pangkhoma Judah te adoudiu ahi. Hicheng jouse jeh hin alunghana abeidehpon akhut alamjing nalaijin ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ohe! ada ahiuve, adihlouva thu lhuhsahhole athu gonsao dihloutah a sun miho;
  </para>
  <para style="p">
    <verse number="2" style="v" />Alhasamho thutanlhah dih-a kona hoidoh a, kami gentheite-a kona achanu suhchatvaipeh, meithaiho abahgam theina diule paneiloute chomding goho chu!
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule vilna nikhoteng chule gamlatah-a kona suhmangna hung nikhotengle ipipen naboldiuvem? Napanpi diu, koipen henga najam uva naloupi nao hoija nadalhah diuham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima beija amaho sohchangho noija kun uva, chule akithat ho noija lhumat diu ahi, Hicheng jouse jehhin alunghan abeidehpon, akhut alamjing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo, Assyria, kalunghana moltum? akhut uva um tenggol khu kathangtomna ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman kiphat lhemsah nam mite le kalunghana mite doudinga, chule thil suhchat vaisaho ladingle bahgam dinga, chule hicheho chu kholai bonlhoh banga chotpha dinga amachu kasolding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />I-hijongle aman chutobang chu atup ahipon, alungin jong chutin agelpon; ahinla namtin chu themkhat hilouva suhmang hel dinghi hiche-a alunggel chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu aman aseije, kalengchapate chu abonchauva lengho hilou uham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Kalno chu Karchemish tobang hilou hija? Hamath chu Arpad tobang hilou hija? Samaria chu Damascus tobang hilouham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Kakhut hin amilim houho lenggam, Jerusalem le Samaria ho-a sanga nasajo ahin holdohtan;
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiman Samaria le ahou milimhou kabolna banga chu, Jerusalem le amilim houho kabollou ding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu hunghiti ding ahi, Pakaiyin Zion molchungle Jerusalem chunga anatoh pumpi achai tengle, Assyria lengpa lung hoithona ga, chule akichungvet loupina-a chu talen kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu aman, hetkhenna kathemjeh-a kakhut thahatna le kachihna a hichehi kanabol ahin, miho gamgi kachonpeh in, agou khollu kanachom in, mihangtah bangin achengho chu kanasonlhan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule kakhutnin mite haona chu vacha buh bangin amudoh-in; chule min vacha tui kidalha alokhom bangin leiset pumpi kachom khom sohkei tai; Ahin alhaving hinjapma le akam ka-a avelhia jong khatcha aumpon ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Heicha chu amangpa chunga kithang-at ngaijem? Ahiloule thing-at chu a-atpa chunga kichoisang ngaijem? Moltum chu adomsangpa khutna kon akithinlhah got banga, ahiloule tenggol chu thing hilou, adomsang beija akikhantou banga chu!
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun Pakai, janel Pakai chun, amithaote lah-a chun gonna solintin, chule aloupi na noija chun meikong bangin ama meijin konginte.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Israelte salvah chu mei hung hintin, mitheng chu meikonga hung pangding ahin chule hichun nikhatle lingle khaohi akahvama aval lhumding ahin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule gammang loupi nale agamphalai hinna le tahsa agoma asuhmanga, amaho chu ponlap dompa tha angoilhahpet bang hidiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule agam manga thing aumsun chu chapang lekha jih-in ajih kham bepma lhom hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule hiche nikholai chule hung hitiding ahi, Israel amoh chengsele Jacob insungmi asohchaho chu amaho sumangpa chunga kingaikit louheldiu Israel mithengpa Pakai chung joh-a dihtah-a kingaidiu ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amoh chengse Jacob mite amoh chengse chu Hat chungnung Pathen henga hungkilediu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu nami Israelte chu twikhanglen neldi bangjongleu alah uva amoh chengbou hungkilediu ahi. Amangdinga umsaho chu chonphatna-a longletdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu janel Pakai Pathen chun suhmangna ahinlhun sah ding hichu gamjouse lailung tah-a bol dinga agelhuh ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun janelho Pakai Pathen'in hiti hin aseije, Zion'a cheng kamite, Assyria ho chu kicha loujenun, aman Egypt mite abol banga chu moltum khatna navoh uva nachung uva atenggol alapsang ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu chomkhat kahlouva lung hilouna hi kichaija, kalungsatnahi amaho manthah na hiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu janel Pakaiyin Oreb songpi-a Midian ho athachaplai banga chu mivohna achothouva; chule amoltum twikhanglen chunga adopma, chutia chu Egypt'a banga chu adopsang ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule hiche nikholai chuleh hunghiti ding ahi. Ama pohgih chu nalengkouva kona chule anamkoljon chu nangonga kona kilamang ding ahi. Chule thao kinujeh-a chu anamkoljon chu kisumang ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama Aiath'a ahungin, ama Migron'a agalkaijin; Michmash'a apoh asekhomin;
  </para>
  <para style="p">
    <verse number="29" style="v" />Amahon lampi ajot galkaijun, amaho Geba'a ajangeh taove, Ramah ho akichan; Saul khopi Gibeah mite ajamtaovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Vo Gallim chanu, awging tah-in samin, Laish lama kijahsah-in, vo khoto um Anathoth.
  </para>
  <para style="p">
    <verse number="31" style="v" />Madmenah ho akichontan; Gebim'a chengho jamdingin akichomkhom taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuche ni chuleh ama Nob'a anaumden nalaijintin; Jerusalem lhang Zion chanu molsang douna-a akhut athin khum ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Veovin, Pakai, janelho Pakaiyin tijat umtah a abah chu asatlhah ding ahin; adunglang sangtah kiphuh lhu-a, chule akiletsah kisunem ding ahitai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule aman thih-a gammang thimletlut chu atuhlhuh-a, Lebanon chu mihat tah-a kona lhuding ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesse phungbula konin adon khat hungdoh intin, ajunga kona abahkhat hung khangdoh ding ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Pakai lhagao chihna le hetkhenna lhagao, thumopthem le hatna lhagao, hetnale Pakai ginna lhagao achunga hung chuding ahin;
  </para>
  <para style="p">
    <verse number="3" style="v" />chule amachu Pakai ginna-a hetna gangtah asem ding, chule amitna amubanga thu atan louding, anakhanga ajahbang maimaija jong aphosal louding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amavang chonphatna-a vaichate thu atanding, leisetna mi nunnem te chu dihtah-a aphoding ahi. Chule aman leiset hi akamsung molla ajepma migiloute chu akam hu-a athading ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chonphatna chu akonggah hintin, kitahna chu alunggil gahna hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngeile kelngoinou chengkhom intin, lutnu chu kelnoutoh kolkhom ding ahin; chule bongnoule keipibahkai gol chule gan kivahthaoho lhakhoma; chapang neuchan apuilediu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule bongpile vompi kivahkhomintin; anouteo kolkhom ding ahin; chule keipi bahkai jengin jong bongchal banga changpol ahin nehding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nao noicheplai gulse ko kotna kichema, noichep bang naosen in gulsum kosung asoding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amaho kalhangthenga chu kisukha louhel le kisumang louhel ding ahiuve. Ajehchu twijin twikhanglen akhusoh banga leiset hi Pakai hetna-a dimset ding ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hicheni chule Jesse jung hung umdoh intin; hichu mitin melchihna dinga hung dingdoh-a, chidang namdang hon ahinholdiu ahi. Chule acholdona chu loupitah hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hicheni chule hitiding ahi, Pakaiyin amite amoh chengse, akidalha dingho, Assyria'a kon Egypt, Pathros, Kush, Elam, Shinar, Hamath'a kon, twikol gamho-a kona lakit dingin aniveina-a akhut alhankit ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule namtin vaipi dingin aman melchihna tungdoh intin, Israel nodohsa ho achomkhoma, chule leiset ningli-a kona Judah mi kithecheh ho chu akhopkhom ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ephraim mite thangsetna jongchu kitol manga, Judah te douho chu kisatlha ding, Ephraim min Judah thangset dantin, Judah'in jong Ephraim sutan taponte.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla amaho lhumlang sanga Philistinte lengkouho chunga leng uva, kigomuva solam miho achom dingu ahi, amahon Edom le Moab chunga akhutnu alhah uva, chule Ammon chaten amaho thu angai dingu ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Pakaiyin Egypt vadunglen Lei chu asuh manghela chule huipi hattah-a luipi chunga akhut athinkhuma, luidung sagiho chu ajepma, chutengle achunga chu mihon kengto kot louva lam ajot dingu hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Egypt gama kona ahungdoh niuva Israel ten lampi ahin jui banguva; amite amoh kidalha ho dinga chu, lamlhongpi khat Assyria'a kona hungki lhung ding ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheni chule nanghon vo Pakai keiman nangma vahchoi jinge, kachunga analunghang tajongle chun nalunghanna akichonmangin neilhamon tai;
  </para>
  <para style="p">
    <verse number="2" style="v" />Vetan Pakai chu eihuh hinga ahin; keiman tahsaning ting kichataponge, Ajehchu Pakai Jehovah chu kahatnale kala ahin; amachu eihuh hingpa jong ahunghitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh-a chu huhhingna twikul'a kona kipahtah-a twi nathaldiu ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche nikhoteng chule nanghon Pakai chu vahchoijun lang aminin taovun, athilbolho mitinlah a phongjalun lang aminchu choi-atnin aumtai, tin seijuvin, natidiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman thil loupitah aboltahjeh-in Pakaiya la saovin; hichehi leiset pumpi het ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho Zion'a chengten kho sam unlang aovun ajehchu nalah uva um Israelte mithengpa chu loupitah ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babylon pohgih, Amoz chapa Isaiah'in amuchu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Milalte kotpi phunga aluttheina diuvin, molsang chunga chun ponlap domsangun lang, awsang tah-in sam unlang, khutnin japmun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kathensosa mihochu thu kapen, Kalunghana-a dingin kamihat ho jong kakouvin, kaloupina eikipapiho jengjong kakouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Molchunga mitamtah husan chu mipi nasatah husan tobang ahin; namtin lengam kikhomkhomho kinah kisao husan toh abangin ahi. Janel Pakai chun galmi janel ho chu galmuna din akhomtup tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho gamlatah gama kon, van monga konin, Pakai amatahle lung hilouna manchah hotoh chuche gampumpi sumang dingin ahunguve atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Penguvin, ajehchu Pakai nikho chu ahungnai tai; Hatchung nunga kona manthah na tobang chu hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh-a chu khut jouse ngoilha-a mitin lungsung junlhading ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amaho kichaovintin; natna le lungkham na-in manchom untin; numei naosonat thoh banga thohgima umdiu amaho khatnin adang chu adatmouva, amaiju meikong bangjeng ding ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vetan, Pakai nikho lunghanale lungsatna khohtah toh kithokhom engsetna, chuche gam sugamhel dingchu ahunglhung tai. Aman chuche-a kona michonseho chu asuhmang helding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu van'a ahsi ho le chua bombel ho chun avah-u apehtahloudiu, nisa chu asodohna-a thimdeldul jengding ahitan, chule lhavah injong avahchu asalvah louding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman vannoihi asetnao jeh-a chule migiloute chu akhansetnao jeh-a talen kapeh ding; mikiletsahho ahoithanau kasuhbei ding, chule kiletsahna tijat umtah chu nemcha kakoipeh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman sanatheng sanga lujo mihem khat, Ophir sanahal sanga lujohel mihem khat kasemding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh-a chu janel Pakai lunghan ni-a alungsat khohtah nikho chule vanho kaho lingsoh-a, leiset jong amuna kona kichondohding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hichu sakhi nung kidel bangle, ahoitupbei kelngoi tobang hiding ahin; mitin chu amaho mite cheh lama, kiheija, ama gamcheh-a jamlutdiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koihile akimudoh chanchu kidot kamhel helding, chule amaho jopchan chu chemjam'a loudiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Achateu jong amitmu tah uva kichil ngema a-inho kichom theng ding, chule ajiteu jong achamlou uva kisusedingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vetan, amaho doudin Mede mite tildoh ingting, amahon dangka angaisah loudiu; chule sana-a jong kipahlouding ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Athalpihou chun gollhangho hinkaplih untin; laigil gaho chunga khotona himhim aneilou diu; amitmuva naosen ho jong akheh louheldiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Babylon lenggam ho loupina Chaldea mite melhoina chungnung chu Pathen'in Sodom le Gomorrah asuhmang tobang chu hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A-itih a jong koima cheng talouhel ding, akhang akhanga jong chengkit talouhel ding. Arab miten jong chuche munna chu apon innu asonloudiu; kelngoi chinghonjong chua akelngoi hongu asemlouheldiu ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amavang nelgama gamsaho chua chu koldiu; a-inhou chu kichat um ganhingho dimsetna; sumbupi ho chua chu chenga, lhomiho hunglam diu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A-in homhou sunga chu twikol gamsaho chule aleng in nomhou sunga chu Dragonho hung hamdiu ahin; chule amanu phat hunglhun nading chu anaitan, anikhoho jong kijopsao talouhel ding ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ajehchu Pakaiyin Jacob hepintin, chule Israelte chu lheng nalaijintin, agamsung tah uva achensahdiu chule gamdang mihon amaho ahinjopmuva, Jacob insunga behdiu ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule mihochun amaho ahinpuijuva, apate mun ahinlhut ding, chule Israel insung chun Pakai gama amahochu sohpale sohnu-a avuluva; chule gal hinga akaihouchu gal hinga akaijuva; asugentheiteu chunga chu vai ahomdingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nalungkham na-a konle nakichat na-a kona chule soh suhgenthei natoh hahsa naki tohsah na nasohchanna-a kona Pakaiyin nacholdosah nile hung hitiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutia chu nangman Babylon lengpa douna-a hiche thuchih hi naman chah-a naseiding ahi. I-atileh misugenthei pa chu iti beija hitam! sana khopi chu kichai hitam!
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin mikhang giloupa tenggol le vaihomho laltengdop chu aheboh pehtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miho lunghanna tanlouva veijingpa, lungsa tah-a namtin chunga vaihompa chu bolgimin aumin, koimachan asutangpoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Leiset pumpi akicholdon, athipdeltan; amahon la asadoh-uvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahi, nachunga chah thinghole Lebanon'a cedar thingho akipah-un, suhlhah-a na-uma patnin eiphuh lhudiu khatcha kahenguva ahungtapoi, atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Noilama konin thikholkhul chu nahunglhun lamdot dingin ahung kichonnin; hichun nangma dingin mithihole leiset pipui jouse jong achoh thouvin; namtin lengho jouse alaltounaova konin akaithou tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon nahenga, nangjong keiho banga nahung lhahsam hitam? keihotoh nahungbah hitam? atidingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naloupina le naselangdah husa chu lhankhuh-a poh lhah-in aumin; lungtol chu nanoija akiphan, hiche lung chun natomchah tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Lucifer, jingkah chapa! van'a kona iti hunglhahmanga nahim! namtinho hatmosahpa chu leisetna iti nahung kisatlhah jeng hitam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu nangin nalungsunga keima van'a kaltouving ting; Pathen ahsi ho chungvuma kalaltouna kidopsanging katin; mipi kikhomho lhangchung sahlam sanga touving kate, natin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meilhang ho chungvuma kaltouving katin; chungnung penpa toh banging kate, nanatin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla nangma kotongthuh lama thikholkhula kipui lhading nahijobouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Namu jousen neochan namuvintin, leiset kithinsah-a lenggam ho hotlinga ngaito-a chu hiche mipahi hijaham? tin ngaitouvinte;
  </para>
  <para style="p">
    <verse number="17" style="v" />Amachun vannoihi gamthip banga asema, chule akhopihou sumanga sohchangho in honpehlou chu hiche mipahi hilouham? atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Namtin vaipi lengho jouse abonchauvin, ama ama insungcheh-a loupitah-in alum ihmuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla nangma thet umtah abah khatna hungkon chemjam'a kisatlih, akithatsaho ponsil, kokhuh-a songho lah-a kipailha, kenga kichonpha thilong bangin, nalhana konin paidoh-in na-umtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangin nagam nasuhmanga, namite nathagam jeh-in, amahotoh nakivuitha louhel ding ahi. Khanset bolho chilhahte chu kiminphah kitlouhel ding ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amaho akipatdoh lounadiule, gam alo lounadiu, leiset chung khopiho achendim louna diuvin apateu khansetna jal-in achateu chu thagamdin gotan.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu janel Pakaiyin amaho dounan kipat ingting, Babylon'a konin kachapa le katupa amohchengse minchu kasuhtan ding ahi, ati, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keiman vakang chenna mun le twikulho-a kasema, manthah na muntheh-a katheh doh ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kangaito bang banga guilhunga, kagon bang banga ding teiding ahi; tin janel Pakai chu aki hahselin aseitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutia chu keiman kagamsunga Assyria mite kasuhmanga, kamolsangho chunga kachotpha ding; chujou tengle anamkoljon chu amaho-a kona kiheimanga, apohgih-u alenguva kona aselhah dingu ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche thilgonhi leiset pumpi chunga thilgon ahin; chule hichehi namtin vaipi jouse chunga kijahdoh khutchu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Janel Pakai gonsa ahin, koiham ajahda dingah? Chule akhut kijahdohsa chu kon atimsahkit dingham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahaz lengpa thi kum-a chu hiche pohgih hi uma ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangma kivohna mol abohtah jeh-in, nang Palestine pumpi kipah hih-in, ajehchu gul sonna kona chu gulsum hungsoh-a, chule ama guchu meija lengthei gul hunghi ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutengle migenthei cha pengmasa kivah intin, milhasam mongtah-in lumintin; najung chu kella katha-a, nami amoh chengchu aman athading ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vo kotpi samin; vo khopi pengin; nangma Palestine pumpi najun lhatai. Ajehchu sahlama kona meikhu hungdoh-a; aphattep sunga chu koimacha achanga umlou ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nampi thupole ho chu khatnin iti adonbut dingham? Pakaiyin Zion aphutdoh tan, hijeh-a chu mivaichaten hichu atahsan dingu ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moab gam pohgih chungchanga, chuche jana chun Moab khopi Ar chu suhmangle kamdelin akilhan; chuleh Moab gama Kir khopi jong kamhel leh thipdelin akikoitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bajith le Dibon munsang ho-a chun ama kapdingin achetoutan: Nebo chungle Medeba chunga Moab peng pengding, aluchung jouseu chaijin tin akhamulhou jouse kivou ngim ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akhopi lamlen dunguva amahon khaodip pon akigah uva, a-inchunghou le alamlen houva amitin penguva haka-a kapdingu ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Heshbon le Elealeh te kapmuva, Jahaz geisana a-aw kijading ahi. Hijeh-a chu galvon kivon Moab sepaiho chu awsangtah-a pengdoh uva; ahinna chu amadinga lungkham umtah hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kalungsung Moab dingin kapdoh intin; ajamleleho chu kumthum kijoma Zoar'a jamlutdiu ahi. Ajehchu Luhith kaltouna-a chu kap puma chetoudiu chule Heronaim lampia chu suhmangna-a pengjahdiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nimrim twiho akangin, hamdongho agopmin; hampa akehpon; hamhing himhim aumtapoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun amahon amujouseu le akholkhom jouseu chu huisum vachadung lama akipoh mangdiu ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Moab gamgi muntina kana aumin. Eglaim le Beerelin'a jong apen ginu chu akithangsoh tai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Dimon twiho thisan dimding ahin, ajehchu Dimon chunga chu akhoh jocheh kalhunsahbe ding, Moab gama hoidohnale chuche gama amoh chengse chunga keipi bahkai kalhalut ding ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Gamsung vaihomho dingin, Sela a konin, gamthip lam Zion chanu lhanga chun kelngoinou ho chu hinsolun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutia chu Moab chanute chu vacha abuh-a kona kinodoh leng lele banga, Arnon kaimuna chutidiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thumop unlang, thutan boldoh-un; sunkim laija nalelim chu jan bangin seminlang; akinodohsa selinlang; vahvei chu matsah hih-in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Akinodohho chu chenkhompin, Moab misumang pa maija akiselnao hitan, hunama lapa chu akichaija, migamsah pa akingah jehchun gamsunga konin misugenthei ho akisumang tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hepina-in laltouna chu kitungdet nintin, hiche chunga chu thudih-a David ponbuh sunga vai ahomding, thu atanding, thutana dih aholding chule chonphatna-a kinoding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moab hoithonahi thu kanajaovin; ama ahoitho lheh jengin; akiletsah nale ahoithona chule alunghan naho jengjong kanajaovin; ahinla ajounaho chu chutilou dingdol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun Moab pengjah hen, mitinin Moab ka cheh hen. Ajehchu Kirhareseth kiphudoh jala nalunghempiu; amaho chu akivolhu tahmonga ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Heshbon loujao le Sibmah lengpigui alhasamtai, aphung lhungpiho chu Pathen hephalou pakai hon anasubongun, Jazer alhung taove. Chuin gamthip lailunga ajamle leuvin ahi. Abahho ajamdoh un, twikhanglen galla ajamgalkai taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun Sibmah lengpigui chu Jazer chunga kana bangin kacham-inge; vo Heshbon le Elealeh kamitlhi-in twichap nange; nanipi lai theiho dingleh nachang at nadinga khosap chu athip tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule lou phatah-a kona kipanale thanopna akilamang tan; lengpilei laija penga lasah le khosap jong umlou ding ahitai. Achilhon jong lengpitwi achildoh loudiu ahitai. Alengpiga lonao khosap jong atansahtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun kagiljang hohi Moab te dingin, chule kasung hohi Kirhares dingin selangdah bangin ging'inte.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hitiding ahi. Moab chu munsanga alungkham akimutengle munthenga tao dingin hungintin, hijongle lolhing louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichehi Pakaiyin chuche laija patna Moab chungchang thu aseichu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla tun Pakaiyin ana seijin, natongho kumsim dungjuija, kumthum sung Moab loupina chu amipite tamtah puma kinoise ding; amoh umsun chu lhomchale doitah hidiu ahi, ati.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Damascus pohgih veuvin, Damascus hi khopi khat ahina-a konin akilamang tan, in-gem kiselom hunghidingbou ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aroer khopichu dalhah-in aumtan, kelngoihonte kolna ding maimaibou hung hintin, koimachan akichatsah loudiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ephraim'a konin kulpidet beijintin, Damascus'a lenggam le Syria amoh chengjong beiding ahitai. Amaho chu Israel chate loupina tobang hidiu ahi, atin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hicheni chule hitiding ahi. Jacob loupina chu kemsuh-in tin, chule atahsa thaotah chu jol lha-a gongding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche chu chang atpan changho ahuikhom, akhutna changvuiho a-at banga Rephaim phaichama changvuiho alokhom tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla olive thingphung kihotlinga, abah sangpen tah vuma aga nile thum umdenna, abah ga phapena lile nga umden bep banga lengpigui kidalha ding ahi, tin Israel Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hicheni chule min asempa ahinvet ding, chule amitnin Israel mithengpa chu ajabol ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman amakhutsem maicham ho chu avet tahlou ding, akhutna asemsa thingbomho hihen, milimho hijengjongle, ajaboltah louhel ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hicheni chule akhopi dettahho chu thingbah kidalha Israelte jeh-a abah chungnung pen adalhah-u tobang hiding ahin, hikom chu kamdel ding ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nahuhhingpa Pathen nasumilin, nahatna songpi nageldohtapoi. Hijeh chun thingkeh hoihoi kiphun natin, hetkhah lou kiselhuhna koijinate.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naphuni maman khandohsah in natin, natu jingkah mama chun khantul tulsah-in nate, ahinla aga lokhomchu lungkhamna kisekhomle lungdon ngahnabei hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mipi tamtah twikhanglen kitumging banga ahusao kitol guiguile, twipi kinong lullul banga kinonga, namtin kinongho chu ohe adau ahi!
  </para>
  <para style="p">
    <verse number="13" style="v" />Namtin vaipi chu twipi kinong tamtah bangin kingong untin, hijongle Pathen'in amaho phoh intin, amaho gamlatah-a jamdiu; chule lhanga huipin changsi amutlonle bangle chimpei masanga thil kipeimang bangdiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule vetan nilhah lamle lungkhamna ahijin, jingkah masangin ama anaumjitapon ahi. Hichehi eisuchavai hou chanchu ahin chule eigumang hou vangchan chu ahi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen'in Sudan Jepna Apehding:
  </para>
  <para style="p">
    <verse number="2" style="v" />Nam thechehsa le ahomsa henga, akipatnuva lhah tugeija tijat umtah mite henga, twikhanglen le vadunglen chunga lekha thing kongsaova palai kisolho tedohsa le kengto chotbehsa, twijin agamu asuhsette nam henga chun thupole kaljangho cheovin ati-e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho vannoi'a umho jouse le leichunga chenghon, lhang chunga galponlap ahung kidopsang tengle, veovin lang aman sumkon ahinmut tengle ngaijuvin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakaiyin kahenga, keima kicholdong ting, kachenna mun hampa louhing chunga hin chang-at kholum laija daitwi meikai bangin hingel nange ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu aga lophat masang, amum ahung pilhina, apahjong lengpiga minsa ahunghi tengle, aman abah sipah jam hole abah lenho chu agoma hampa vatna chema abahho asat lhah-a, apaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hicheho chu molsang ho-a vachaho dingle leisetna ganchaho kidalhah peh ding ahiuvin, vachate chun hichehochu nipilai man na-a, chule gamsaho chun phalbilai man na-a, aneidingu ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichephat teng chule janel Pakai heng, Janel Pakai min umna Zion lhanga a chu: mipi thechehsa le ahomsaho-a kon, akipat uva lhah tugeija tijat umtah mite-a kona, tedohsa le kengtoa chotbehsa nam mite-a kon, twijin agamu asuhsetho-a kona, thilpeh chu hung kipelut ding ahitai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Egypt pohgih chu veuvin, Pakai chu mei kitol gangtah chunga touva, Egypt gama hungding: chule ama angsunga Egypt gama milim ho chu kichon diu, Egypt mite lungchang chu asunga jun lhading ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman Egypt mite doudin Egypt mite ma tilingting, amitakipmin asopi adoudiu, amitakipmin aheng akom adouva, khopile khopi, lenggamle lenggam hungkidouto diu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichesung chule Egypt mite lhagao chu hungthon nintin, chule hilchahna chu kasuhbei ding ahi. Chutengle amahon milimho le ailhimho, lhakou ho le doithemho henga aholdiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keiman Egypt mite chu vaipo engsetah khat khutna kapehdoh-a; kichat umtah pakai khatnin achunguva vai ahomding ahi; tin Pakai janel Pakai chun aseitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule vadunglen ho-a kona twiho hungkanga; vadungho longmanga gothetding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amahon vadunglen ho chu gamlatah-ah heimang untin, kinga tupna luidunga chu kanga gothet ding: Pumpeng hole aigeho jong golha ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Luidung pang le vapangho akeova kijamding; chule luidung panga kithe chanchu golha-a huija lengmang ding; umkit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngamanho jong lunghemuva, luidung ho-a ngakoiho jouse lunghem untin; chuhtwi chunga lensep ho lhasamdiu ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche chungchon chun tupat pon khongho le ponvang khongho chu lungjing diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Akibulphuna songho kisubong ding; natong dinga kigongho jouse jong lungjinga umdiu ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thonlouva Zoan lengchapate chu ngoldiu; Pharaoh thumopthem michingho thuhil chu lungsetna neilou ahung hitai. Keima miching cha leng luiho chapa kahi tia, Pharaoh henga iti naseiju ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaho hoilamba hitaovam? namichingho hoiba hitaovam? Amahochu tun kihilsah inlang, Egypt chunga janel Pakaiyin ipi agon chu amaho hetsah in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zoan lengchapate chu angoltaovin, Noph lengchapate akilhemlha gamtai; amahon jong Egypt mite, chuche phung mite chendetnaho geijin apuimanguve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alah uva chun Pakaiyin lamvaina lhagao achoh halin; chutichun jukhama alohna-a lonlele bangin Egypt mite chu atohnao channa asuhkhelsah uve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Egypt dingin alu hihen amei hijongle, lusu bah hihen phaipheng phung hijongle, abolpeh theiding aumpoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheni chule Egypt chu numei tobang hidiu ahin; janel Pakai khut thin chu achunguva athin ahijeh-a kichaova tijading ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Judah gamchu Egypt tedin tijat umtah hintin, chuche douna dinga janel Pakaiyin agontoh athuhiljeh-a aminphah chu kichacheh diu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche nikho chule Egypt gama khopi nga in Kanaan pao athouva, janel Pakai henga chu kihahsel ding ahiuvin; khatchu manthah na khopi kitiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hicheni chule Egypt gamlailunga chu Pakai maicham khat, chule agamsunga chu Pakaiya songphu khat umding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Egypt gamsunga janel Pakai dinga hichu melchihna le hettohsahna hiding ahi; ajehchu misugenthei ho jeh-a Pakai henga taoding ahiuvin, chule aman huhhingna le hat chungnung khat ahinsolpeh-a, amahochu ahuhdoh ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutengle Pakai chu Egypt ho het hitantin, hiche nikho chule Egypt ten Pakai chu ahetdohdiu, chule ganlhaina le thilpeh aneidiu ahi; ahi, Pakai henga kitepna khatna kitep uva asuhbulhitdiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Pakaiyin Egypt ajepding, ajepna-a asuhdam ding ahi. Amaho Pakai hengtah-a chu hungkileuva, chule aman ataonao angaipeh-a, chule aboldamdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche nikho chule Egypt'a kona Assyria geija lamlhongpi khat umding Assyria te Egypt'a, Egypt Assyria a, hunguva Egypt mite chun Assyria mite toh ajenkhomdiu ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche nikho chule Israel hi Egypt le Assyria bana athumna hiding, chule gamlailunga phattheiboh changtah hunghi ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Janel Pakai chun kami Egypt te leh kakhutsoh Assyria te chule kagoulo Israelte chu phattheiboh changu hen tia aseiding ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tartan Ashdod na ahunga (Assyria lengpa Sargon in asol lai) Ashdod asatna alah kumchun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichephat mama chun Pakaiyin Amoz chapa Isaiah hengah aseijin, chenlang nataija khaopon chu sutlhan lang, nakeng phanga konin nakengkoh sutlhan, ati. Chuin aman chutichun abolin, asagoh-in akeng keuvin lam ajottai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutin Pakaiyin, kasoh Isaiah Egypt le Ethiopia te chunga melchihna le thilkidang dinga kumthum sunga sagohle akeng keuva aumbangchun;
  </para>
  <para style="p">
    <verse number="4" style="v" />chutia chu Assyria lengpan Egypt te sohchang dinga, Ethiopia gal hing ding, khangdong laile tehse cheng, sagohkeu le kengkeuva Egypt mite jachatsah dinga akhelbuhgei san uva kihohdoh-a, apuimang ding ahi, tin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amaho akinepnao Ethiopia le aloupinao Egypt jala kichaova jahchadiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hiche twikol gama umho hin hicheni chule, vetaovin ikinepnao chutichu ahi, Assyria lengpa-a kona ikihuhdoh nadiuva kithopina hola hoilama ijamdiu hija, iti ihoidoh diuham? atidiu ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Twipi nelgam pohgih, lhanglam chimpei hungkipei bangin chutichun nelgamle tijat umtah gama konin ahunge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lungkham umtah thilmu khat kahenga akiphongin, kitahlou bolpan kitahlouvin abolin, misumang pan mi asumange. Vo Elam kaltouvin, vo Media gaum kimvelun, khoisatna jouse kasuhtang ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun kataihohi natna-in adimin; numei naosonat in aheh bangin, natna chun eiman chomtai. Hichu kajan kakunin kho mutheilou jennin kalungkhamtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalungsung ahaisamtan, thil gimneitah khatnin eikichat sahtai. Kanopna janchu aman kadingin kichatnan aleheitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dokhang chu dovin, daiveina insanga chun ve jingin, neuvin, donun; kipat un, nangho pipuiho, lumdal chu thao uvin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu hitihin kajah-a aseijin, Pakaiyin kahenga, chen, khongah khat koijin amu muchu phondoh sah-in ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman kangtalai khat sakola tou mi kopkhat toh, sangan kangtalai khat, sangongsao ho kangtalai khat amun, chuin gunchu tahle lunglut tah in angaijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ama keipi bahkai bangin apengin, Pakai keima insang chunga kading jingin, chule jankhovah in kapansatna-a kaume.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule vetan, hiche munahin miho kangtalai khat, sakol chungtou kopkhat toh ahungin ahi. Chuin aman ahindonbut nin, Babylon achimtai, achimtai, amanu pathen semthu milim jouse aman tolah avobong gamtai, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo kachang mola kavohsa kaphola kachang ho, Israel Pathen, janel ho Pakaiya kona kanajah chu naheng uva kaphondoh ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dumah pohgih chu, Aman Seir'a konin eihin kouvin, khongahpa, jana ipi soh am? Khongahpa jana ipi soh am? ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khongahpa chun jingkah, chule janjong ahung naitai. Nakholtoh nomule kholtoh-un, hungkileuvin, hungun, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Arabia te pohgih chu, Vo Dedanim kholjinho, nangho Arabia gammang sunga nagedingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tema gama chengho chun adangchahpa twi ahindop peh-un, galjampa chu amahon changlhah-in avah uve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu amaho chemjam'a kon, chemjam kisatdohsa-a kon, chule thalpi kijebongsa-a kon, chule gal nasatah-a kona hungjam ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Pakaiyin kahenga hitihin aseije; kithalah kumho dungjuija kumkhat sunga Kedarte loupina jouse beisohding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Kedar chate thal kapthem le galhat hochu kilhomsah ding ahi. Ajehchu Pakai Israel Pathen'in hichehi aseisa ahitai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thilmuna phaicham pohgih. Tu-a ipi hahsatna uma, in chunga nabon chaova nakalu hitam?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangma husagin na dimset, khopi pohcheichoi, kipahtah khopi; napasal kithat ho chu chemjam'a kithat le galsatna a thi ahipouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Navaihom hou abonun ajamkhomun, thalthem hon amaho akan khomun; nanga kona gamlha tah-a jamdoh jouse chu abonin akangomun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh-a chu kati ahi, keija konin achomlam veuvin; kamite chanu kisuhmang jeh-a haka-a kakading ahi, lhepbi dingin neigo hih-un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu tuni hi lungkhamna le kengto-a kichil thangna chule gao thilmuna phaichama janelho Pakai Pathen dinga lungnohphahna le, kul bangho kisuhchimna le mol chungho-a kana nikho chu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Elam mihon livathei akengun, mihem touna sakol kangtalai le sakolchung touhotoh alhonuvin, Kir mihon lumdal chu ahohdoh-uvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hung hitiding ahi, Na phaicham deichungnung chu kangtalai dimset ding ahi, sakolchung touho chu kotpiphunga galvonpuma kigoldiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman Judah pondal kikhuna chu ahohdoh-in, chule hiche nikho chun gammanga galmanchah in chu navetai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon David khopi selaiho jongchu namutaove, hichu tamtah ahi. Chuin twikul noinunga twiho chu nagom khom taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jerusalem in hochu nasim uvin, chule in hochu kulbang semna dingin naphe lhaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Twikul luija hunglong dingin kulbangho kah-a chun twilam khatjong nalaijun; ahinla chuche sempa lamchu nave hih-un, sotna patna hingong tohpa jong chu nanahsah pouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche laichun janel Pakai Pathen'in akapdin, alunghemdin, alu voutoldin chule khaodip ponna atai kigahdin mi akouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule ven thanopnale kipanaho, bongchal ho kithana le kelngoi ho kithana, sanehna le lengpitwi dona hohi hungun neuhitin, donuhite, ajehchu jingle ithidiu ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hichehi janel Pakaiyin kanabenga anaphondohsa ahin, thonlouhella hiche khansetnahi nathi kahseuva nangho-a kona kisutheng louhel ding ahi, tin janel Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Janel Pakai Pathen chun hitin aseije, chenlang hiche neichingpa hengle insung chunga vaipo, Shebna heng ngeija chun gaseijin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama dinga sangtah-a lhan kilaija, amadinga songpi sunga chendetna in kisem banga, hichemunahi ipi naneija, koi naneija lhan nakilai ham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Vetan, Pakaiyin thahat tah-a gal hinga nakaimanga, nakhu khum teiding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman nangma thonlouva pumhatna gamlen lama lumbeng banga kipeibong bonga napeiding ahin, chua nathiden ding, chua chu naloupina kangtalai chu napupa insung jachatna sohding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiman naum na-a konin nangma deldoh ingting, napipui na-a kona aman naloilhah ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule hiche nikho chule hitiding ahi: Keiman kalhacha Hilkiah chapa Eliakim chu kakouding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman nasangkhol chol ama ahpeh ingting, nakonggah-in ama hatsah ingting navaipoh na akhutna kapeh ding ahi. Chule ama Jerusalem'a chenghole Judah insung mite pa-a pangding ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule David insung kot heh alengkouva kakhaija, chutia chu aman ahonle koimachan akha theilou ding, aman akhale koimachan ahontheilou ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule keiman amachu mundet tah-a kikilbeh banga kasuhdet ding; amachu apa insung dinga laltouna loupi chu hiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule amahon amachunga chu apa insung loupina jouse, atu achate le asonho, bel neocha jouse belcha khonho-a pat twipai geija achunga akhaidiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Janel Pakaiyin aseije, hiche nikho chule, mundet tah-a kikildet thihkil chu kibotdoh intin, kisatlha-a lhamang ding ahi. Chule achunga um pohgih chu kisatlhading ahi. Ajehchu hichehi Pakaiyin aseisa ahitai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tyre pohgih. Nangho Tarshish kongho, pengun! Ajehchu in umlou hel, alutna ding umlouhel ahinadinga hiche chu kisukamhela ahitai. Chittim gama kona hichehi ahenguva hung kiphonga ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Twikol gama cheng nangho thipchetnin umun, Zidon mi sumkolvei, twikhanglen palgalkai lehon alodimsoh taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule twilenho panga Sihor muchi, luipang dunga chang ki-at chu amanu chanding ahin, amanu chu namtin kailhang ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo Zidon, jahchan umin; ajehchu twipin thu aseijin, twipi hatna ngeichun naoso natna kathoh khapon, chate jong kahingkhapoi, gollhangho jong kavahdoh khapoi, nungahthengho jong kaseiletsah khapoi, atin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Egypt thudol thulhut kijabanga chu, Tyre thulhut na chu amaho lungna lhehdiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho twikol'a chengte, Tarshish a galkai junlang samun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichehi gollui khanglui nikho-a mi chuham? Akengphangin gamlatah-a chedinga alhohmang ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lallukhuh khuh khopi, chua sumkolvei ho pipuiho jeng hija chua kiveihojong leisetna ja umtejeng hija, hiche Tyre khopi douna gong'a chu koiham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Janel Pakai chun leisetna kiletsah le ja-umtah ho suhnemna dinga hichehi anagon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Tarshish chanu, vadung khat bangin nagamsung chu jotpaitan, nahatbe nading dang aumtapoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman twikhanglen chunga akhut ajah-in, lenggam ho ahotlinge. Pakaiyin chuche sumkolveipa khopi douna kulpidet suhmangna dingin thu apetai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman vo genthei thoh nungah theng, Zidon chanu, nangma nakipajom louhel ding ahi. Kipat inlang, Chittim'a galkaijin, chua jongchu choldona namulouhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chaldea gamhi vetan! Assyria miten amaho dinga gamthipma chengho amu kahseuvin hiche mitehi aumtapouve. Amahon insangho leng inpiho asauvin, ahin hichun manthah na-a ahin lhuttai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangho Tarshish kong inneiho; pengun, ajehchu nathahatna beihela suhmang ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hiche nikho chule hitiding ahi, lengkhat nikhoho dungjuija Tyre chu kum somsagi suhmila hung umding, kum somsagi kichaitengle noti banga Tyre'in la asahding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Suhmila anaum notinu, nangman selangdah choi jinlang, khopichu velin, nangma geldoh-a naum theina dingin aw nguiheu vin, la tamtah san.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule kum somsagi akichai joutengle hung hitiding ahi. Pakaiyin Tyre chu vilintin, amanu athalahnu henga hungkile ding, chule leiset chunga vannoi lenggam ho jouseto jong hungchonthanghoi ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amanu kiveina thilho le athalah chu Pakaiya dinga atheng hiding: hichu kikhol louding, koijong kikoikhom louding ahi; ajehchu kiveina thilho chu Pakai masanga chenghon nengtah-a anehdiu chule sottah aneidiu ponsiljoh hiding ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veuvin, Pakaiyin leiset hi keuhel le agoh-in anasemin, chule akhup athalin aleh-in, chua chengho chu athecheh tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutia chu, mipi aum banga thempu uma; sohpa aum banga pakaipa uma; sohnu aum banga pakainu uma; achopa aum banga ajohpa uma; ahompa aum banga abatpa uma; sumthoi lapa aum banga sumthoi pepa uma; batna lapa aum banga batna pepa umah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Leiset chu keuhela suhchatvai gam hela umding ahi; ajehchu Pakaiyin hiche thuhi anasei ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vannoihi alunghemin agolhatai. Vannoihi akemsuh-in agolhatai. Leisetna mikiletsahho akemsuh taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Leiset hi achengho noija suhboh-in aumtai; ajehchu amahon danho chu asukhelun, chondanthu akhelun, tonsot thulhun asukehtaove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun leiset hi gaosapmin avalhumtai, asunga chengho chu akamdeltai; hijeh chun leija chengho akavamun, mi lhomcha bou aumtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lengpitwi thah alunghemin, lengpitwi alhasamin, lungsunga kipahho jouse akhoisataove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khongchaho thanopna akichaijin, kipahtah-a umho husa chu abeijin, selangdah thanopna atangtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amahon judon le lasah akop loudiu ahi; khamnathei donhi adonho dinga khatah ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lung nohphahna khopi chu akisumang tai; Koimacha alunglut thei louna dingin in jouse akikhahchahtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ju jeh-in lamlhongpi ho-ah kho akisame; kipana jouse athimin, gamsung thanopna jouse abeitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khopisung ahomkeovin akidalhan, chule kotpi chu manthah na-in akivosen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gam lailung miholah-a hitia ahung um tengtah le, Olive thingphung kihotling tobangle lengpiga loujaova apul kilohkhom tobanga chu hung umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amahon a-aw hinsam doh-un tin, Pakai loupina lan saovintin; twikhanglen'a kona gingtah-a asapdohdiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun nanghon Pakai, Israel Pakai Pathen min ngeichu mei le twipi chule twikol gamho-a chun choi-an uvin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Leiset kolmonga konin la kisaho ijaovin, michonpha te henga loupina umhen. Ahinla keima kalhasam tultul, kalhasam tultul tai; ohe! ada-a kahi, jouva mibol hon jouvin eiboluvin; adihlouva mibol hon jouvin eihabol lheh-un ahi, katin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo leisetna chengho, kichatna le kokhuh, chule thang nachung uva aume.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hitiding ahi: Tijatna husa-a kona jam-a chu kokhuh-a lhalutding, chule kokhuh-a kona hungdoh-a chu thanga ohding ahi; ajehchu chungsanga bangkot ho akihongin, chule leiset bulho akihotlinge.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leiset nasatah-in akehlhan, leiset hi ajunlha thengin, leiset hi nasatah-in akilong tai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Leiset hi jukham banga kipei lonle-a, buh neocha banga kichon mangding ahi. Chule chua suhkhelna chu gihsatah-a achunga umding, chule hichu lhu-a kiphongkit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hicheni chule hitiding ahi, Pakaiyin chunga um janel le leiset lengho chu talen apehding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule sohchangho kokhuh sunga akikoikhom banga, amaho kikhom khomdiu, songkul sunga kikhachah khumdiu, nitamtah joule amaho kivil ding ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutengle janel Pakai chu Zion lhang le Jerusalem'a chule upaho anga loupitah-a alengchan tengle lha thimintin, nisa maimoh ding ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Pakai, nangma ka Pathen nahin, nangma choi-an ningting, namin vahchoi jinge; ajehchu nangin datmo um thilho nabolin; malaija nathumop ho chu tahsan umle thudih ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu khopijong leivui nasosah-in, hoidohna khopi chu nasumangin, khopi umlouna dinga gamdang mite leng in-piho chu nasusen, hichu kisadohkit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun mihatten nangma loupisah-un natin, tijat um namtin vaipiho khopi'n nagindiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nangma vaichate din thahatna nahin, alhasamte hesoh laija thahatna nahin, khopihui hatlaija belding nahin, nisa noija lim nahin, khopihuijin kulbang anuh tobangkhu nahije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gamdang miteho husa chu mun go laija nisa sat banga nasuhnem ding; meilhang lima asa jengjong chu nasuhnem ding ahi. Kichat umtah abahho chu kisunem ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche molsanga hi janel Pakaiyin, lengpituichih-a mijouse golvah, thil thaova golvah, thil thao lhintwi dimsetna, lengpitwi chih kilhithengsella golvah abolding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman hiche molsang hi namtin jouse chunga kikhukhum maikhule, namtin jouse chunga kidah ponlukhuh chu asuhmang ding ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman thina chu jona-a aval lhuma; chule Pakai Pathen'in mai jouse-a kona mitlhiho atheh hulding, chule leiset pumpi jouse-a kona amite kiphona alahmang ding ahi: ajehchu Pakaiyin hichehi asei ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche nikho chule hitia kisei ding ahi. Veuvin, hichehi i-Pathen'u eihon ingao, eihuhhing dinguva amahi ahi. Hichehi eihon ina ngajingu Pakai chu ahi. Ami huhhing na-a eiho ikipaova itha nopdiu ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu Pakai khutchu hiche lhanga hi kingama, changpol eh-molla kon akilholhah banga, ama noija Moab chu chotbeh-a umding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Twijap pan twijapna dinga akhut ajah banga, aman alah uva akhut ajahding ahi. Chule aman akiletsah naochu akhutnuva achomdoh houtoh asotlhahtha ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule akulpidet kulbang sangho chu asuhnempeh-a akoinema, tolgeija, leivui changeija asotlhah ding ahi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuche nikho tengchule hiche la hi Judah gamma kisading ahi; keihon khopi dettah khat kaneijun; Pathen'in huhhingna chu kulbanghole kulpiho dinga agetding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nam chonphate, thutah nit mite alut theina dingun, nanghon kotpi chu hong lennun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nachunga alungthim chensah chu chamna kimkeija navet tupding ahi. Ajehchu aman nangma natahsanin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon Pakai chu a-imatih chanin tahsanun. Ajehchu Pakai Jehovah'a chu tonsot thahatna chu uma ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu sangtah-a chengho chu aman ahinpolhan; khopi sangtah chu akoinemin, tol geija akoinemtai; aman leivui geijin ahinpolhai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mivaichate kenghole, lhasamte kalsonho, ngeichu akenga achotbeh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Michonpha te lampi chu kitahna ahin, nang, lungdihpen chun mikitah lampi chu naleptohjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahi, nathutanlhahna lampia chun, vo Pakai, nangma kangah jingui; kahinnaovin alha ngaipen chu namin le nangma geldohjing ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Janteng kahinna-in nalhangaijin ahi. Ahi, kasunga um lhagao chun jingkah matah-in nangma nahol inge. Ajehchu nathutanlhahnaho leija aumteng, vannoi'a chengten chonphatna chu kijil unte.
  </para>
  <para style="p">
    <verse number="10" style="v" />Migilou khohsahna musah jengle chun chonphatna kimudoh dehponte; lungdihna gama chun aman dihlou tah-in thilbol'intin Pakai lalna chu mudohponte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai, nakhut nadopsang tengle amahon mupouvinnate. Ahinla mihochunga athangset jeh-un mudoh untin; jahchadiu ahi. Ahi, namelmate meichun amaho akahlih gamdiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai, nangman keiho dinga chamna neisuhdet peh dingu ahi. Ajehchu nangman kanatoh jouseu jong neitohpeh taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Pakai, ka Pathen'u nang hilou pakai danghon kachunguva vai ahomtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho athi ahiuvin, hing loudiu ahiuve: Amaho athi ahiuvin, thou talou ding ahiuve. Hijeh chun nangin amaho navilin, nasumangin, ahettheinao jouse jong naman sah-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche nam mite chu napunsah-in; O Pakai, nangman hiche nam mite chu napunsah tan; Nangma choi-atnin na-umtai; Nangin hichu gamlatah leiset kolmang geijin nakithan sahtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai, lungkhamin amahon nangma naholun, nagimbolna achunguva aumteng hatah-in ataovun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nupi naovop asophat ahung naija, anatna nachoi choija ahung pendoh bangin; Vo Pakai, nangma mitmun chutobang chu kanahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keihon nao kavopmun, kana-uvin, hui lhohdohle kabangui, leijahin huhhingnadol ima kabolpouvin; vannoi'a cheng hojong lhujong alhupouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Namithiho chu kamithilong toh thoudoh uva, hing khomdiu ahi. Leivuija cheng nangho thou vunlang la saovin. Ajehchu nadaitwi chu hampa louhingho daitwi bang ahin, leijin mithiho chu ahinledoh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hungun kamite, na-indan sunguva lutnun lang, nakotnu kikha khum uvin; lungnat natah akichai kah-in, chomkhat tobang kiselmang uvin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu veuvin, leisetna chengte akhansetnao jeh-a talen pedingin Pakai chu aumna mun'a konin ahung potdoh tai. Leisetnin jong athisan chu asellou ding ahin; chule amithiho jong akhutah louding ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche nikho chule Pakaiyin achemjam hemtah lentahle lhoutah-a chu leviathan gul ngongle leviathan gul kiveikol ngeng nung chu talen apeh-a; chule twikhanglen'a um dragon chu athading ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche nikho chule; lengpitwi san lengpilei, amanu henga la saovin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai kiti keimahi, tuhdetpa kahin; phat tinin twichapminge, achutiloule min sukhante, tia sunle jana kavettupding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keija lungsatna aumpoi, galla eidou dinga koijin lingle khao chu akoiding ham? Keima alah uva kache-a, kahalchap ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahiloule eikichampi theina dingin, kahatnahin kivonhen, chutile eikichampi ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Jacob mite ahungho chu ajung khosah ding ahin; Israelte mum doh-a pahlhading, chule leiset chunghi aga dimset ding;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama jepho ajep bangtah a chu avoh hitam? Ahiloule ama thatte kitha banga chu amachu kithatna hitam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Solam hui anun banga, nangman amanu chu nalungsat na-a nanodoh-a, chule gal le sohchan na-a naumsah ding ahi
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun hiche hin Jacob khansetna chu asop ngima, hichehi achonset lahmangna ding chu ahin, ngunsong kivochip jengjung banga maicham songho abol tengle thingbong hole, milimho dingdoh talou ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kulpi kikhokhum khopi jongchu kamhel intin, chenna munchu kidalha-a gamthip banga umding; chua bongnou kivah-a, chua chu kolding, hichea thingbaho chu anehjou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abahho chu agot tengle mangthah intin, numei ho hunga meija atidiu ahi. Ajehchu hetkhen themna neilou mite ahijeh-un, asempao chun achunguva hepina aneilouding, agongdoh paovin khohsahna amusah louhel ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hiche nikho chule hitiding ahi: Pakaiyin vadunglen kama pat Egypt vachadung geijin long'intin, chule vo Israel chate nangho khat khatna naki khopdiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche nikho chule hitiding ahi: Sumkon lentah chu hung kimut intin, Assyria gama mangthah dehdeh hole, Egypt gama akinodohho chu hunguva, Jerusalem lhangthenga Pakai chu ahoudiu ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ohe Ephraim, jukhamho hoithona lallukhuh chu ada ahi! Ahoina loupi chu pahcha pultheibou ahin, hichu phaicham gampha ho-a anemsesa ho luchung chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vetan, Pakaiyin thahat le hat chungnung khat aneijin, hichu huile gelin, thil sumangthei khopihui tobang, twilen nasatah let thethu banga akhutna tolla aselhah ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ephraim jukhamho hoithona lallukhuh chu kengtonoija kilhobeh ding ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule damphai, amel hoina loupitah chu pahcha pullha hung hintin, nipi masanga theiga masa pulbang hiding; hichu avepan amua akhutna um nalaija anehjoupai tobang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche nikho chule janel Pakai chu loupina lallukhuh le, amite amoh umcha sun dinga hoina lallukhuh-a hungpang ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule thutanlhahna-a toupa dinga thutanna lhagao le, kotpi phunga gal lenokit ho dinga thahatna hungpang ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla amahon jong ju-a konin jong setna aneijun; jukhama konin lampama apetnun, thempuho le themgao hon ju-a konin setna aneijun; jukhama konin lampan apetnun amaho athilmuhouva aseuvin, amaho thutan na-a akipaluve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu dokhang jouse chu loh le thilboh adimin; hitichun muntheng aumtapoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koichun hetna ahila, koichun tahsan lhongpi ahetkhensah dingham? Noichep banghole noija kona kiloidohho chu ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu chondan chunga chu chondan, umtei ding, chondan chunga chodan, thugol chunga thugol, thugol chunga thugol; hia themkhat khu-a themkhat.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu hiche mite hengahi aman kam-oh le paochoma thu aseiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman ahenguva, hichehi thachol te nakicholdo sah theinao choldona chu ahin, hichehi kilha jangna ahi. Amahonla angaisahdeh pouve, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla amaho henga Pakai thu vangchu; chondan chunga chondan, chondan chunga chondan; thugol chunga thugol, thugol chunga thugol; chule hia themkhat, khu-a themkhat, amaho cheova nunglhuh uva, chule mangthah diu, thanga oh-uva akimatdoh theinadiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichejeh chun nangho nahsalou mite, Jerusalem'a chengho chunga vaihomten Pakai thuchu ngaijun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu nanghon thina toh kitepna kasemun, thikholkhul toh kitepna kaneitaovin; kivohna twipi alonlet teng jongle kahengu ahinphah tahlou dingu ahi. Ajehchu keihon jouthu beldingin kamangun, jouthun kakisel uve nati uve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun Pakai Pathen'in hitin ati, veuvin keiman Zion'a inbul songkhat patepna song, manlutah in-ning song, inbulphu tahbeh khat kakoije, atahsanchan chu kicha louding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thutandih chu gol kaina-a kaman ding, chonphatna chu thil vettohna-a kaman ding ahi. Gellin jouthu umna mun chu alhohmang ding, kiselna ding munchu twijin achup mangding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule thina toh nakitepnao chu kisubeija, thikholkhul toh nakinopto nao chu dinglou ding ahi; vohna twipi alonlet tengle hiche chun nachotpeh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichu ahung kitola patna, hiche chun nalah khah jing dingu ahi. Ajehchu jingkahsim jingkah seh-a; asun ajanna hung kitolding; thulhut hetkhen dingchu kisuh boina bou hiding ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu jalkhun chu mikhat kilhon nathei sangin achomjon; akichuna jongchu ama kijelnathei sanga neojo ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu aman anatoh kidangchu atohthei nadingle, athilbol kidangchu amolso theina dinga; Pakai chu Perazim molsang banga hungthouva, Gibeon phaija banga chu lunghang ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun tun nelpeh hat ho chu hidaovin, nakihen nao lhoucheh sah getninte, ajehchu janel Pakai Pathen'a konin, leiset pumpi geija suhmang nading kigong chu kajatan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nana sung unlang, ka aw ngaijun; ngaijunlang, kathusei jaovin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Muchi thena dinga loukaipan nilhum keija akai hinam? Aman aleilhangho akaldoh-a avohngem hinam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman atol alaicham tengle lengmusel le Pathikhom athehih-a, sakol changpi le suhlouchangpi, chule butun jong amuncheh-a athe hilou ham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu a-Pathen'in ama ahila, gellhuh theinadia amachu ahilchah ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu lengmusel ho chu changmola kivo ngailou; pathikhom chunga chu kangtalai kang kitang jilou ahi. Ahinla lengmusel chu tenggola chule pathikhom chu moltuma bou kivoji ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Changlhah ding changchu akisubongjin; ajehchu a-itih-a vohtho louding, akangtalai kanga jong kitangkeh louding, asakol chungtouho jong asuh bongsah deh louding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiche jonghi thumopthem kidangtah; thilbol lama nasapenpa janel Pakaiya hung kondoh ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ohe Ariel, Ariel, David chenna khopi nada ahi! Akum kum-in belap unlang, ganlhaina sa thasah uvin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ariel chu kabolgentheija, chua gihsalnale lungdonna umding ahin, chule hichu keija dinga Ariel tobanga hiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangma dounan nakimvela ngahmun sangting, galkul sangtah kakaikhuma, kulpiho kakhokhum ding nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutia chu kisulha ding nahin, tolla kona nahung paodoh-a nathusei chu leivuija konin olcha gingding, na aw chu tolla kona thilhavop khat aw bang hintin, nathusei chu leivuija kona aw thopma gingdoh dingbou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukalvalin nagamchom mipi ho chu leivui sipahbep hintin, tijat umtah mipite chu changsi lengmang bangbep hintin: henge, gangta-a chutiphung ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Janel Pakaiyin van ginna, chule inlingle husa kithong, hui le go chule khopihuija, chule kavam helthei meikonga nahungvil ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Ariel douna-a galsat namjouse-a kon mipi ho, amale agal manchah sat ho jouse, chule abolgenthei jouse geija janmang bangbep hiding ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule mi gilkelin mang aneija, chule veuvin, amanga chu an aneh-a, ahivanga akhahdoh phatna la vachom dehlou: ahiloule midangchah in mang aneiteng vetan twi ana donna, ahivanga akhahdoh phatna la ngoideh jeng, asunga adangchah abangbep ahijing jeng banga: Zion lhang douna-a galsat namjouse mipi chu chutobangbep hiding ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghotah khongai unlang, datmouvin; kapmun lang, pengdoh uvin; amaho akhamun, ju-a konvang ahipouve; alon lele uvin khamnatheija konvang ahipoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu Pakaiyin nachung uva imutsetna lhagao abuhlhah-a, namitnu asinsah ahitai. Themgaoho le navaipo hou, mitvah neiho akhuchahtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nanghodin mu neijousehi lekhabua thuchengho kisinkha khum tobang ahung hitan, hichu lekhathem khat henga kichoija; hichehi simin, tia nahenga katao ahi: Chule aman akisinkha jeh-in kasimtheipoi, ati tobang ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin lekhabu chu athemlou khat akipen, katao ahi, hichehi simtemin atile, aman keima kathempoi, atin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun Pakaiyin aseije: hiche mite hin akamuvin einaijun, amuh uvah eijabollun, ahinla alungu vang keija kona gamlatah ahin, keima eiginu jong mihem chondan thuhila konbou ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun ven, hiche mite lah-a hi thilbol kidangtah, thilbol kidangle datmo umtah jong kasodoh ding ahi. Ajehchu amichingteu chihna chu mangthah ding, chule ahegilho hetnachu kiselding ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakaiya kona selding giltah-a holtechu ohe adau ahi. Anatoh-u chu muthim lah ahin, kon eimuvem? kon eihetnum? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tahbeh-in thil akhup athala naleu chu beldengpa khutna hahlei banga naki ngaitou ahi. Ajehchu athilsem chun asempa chu aman eisem hibeh am? atia ahiloule thil gontohsa chun agongtohpa chu aman hetkhenna aneipoi atiji em?
  </para>
  <para style="p">
    <verse number="17" style="v" />Lebanon chu leiphatah sosah-a aumdingle, leiphatah chu gammang banga akigelding chu chom chakhat kahbou hung hitalou dingham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche nikho chule na-ngongin lekhabua thuchu ajah-a, mitcho ho mitnin khojinle muthim lah-a kona jong amudiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Minunnemho jong Pakaiya halna-a akipanao pungding, milah a mivaichate jong Israel mithengpa-a kipahdiu ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu gin umtah khatchu imalou akisotan, mi i-sah loupa chu akisutanin, khan-gitlouna velhi jingho chu akisubeitan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hicheho chun thu cheng khatnin mi akipalsahjin, kotpi phunga phosal achan nadin thang akampehjin, midihtah chu ima hilouhela koijin aumtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun hitihin Jacob insung thudolla Abraham lhatdoh-a Pakai chun aseitai, tu-a Jacob jahcha talou ding, amaijong dang talou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla achate kakhutsohho chu alah-a amutengle, kamin thensah-un tin, Jacob'a mithengpa chu athen sah uva, Israel Pathen chu agindiu ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lhagaova suhkhel neihon jong ahin hetkhen themuva, aphunchel ho jong tahsan lhongpi kihildiu ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin doubolnom chate, midang kithumop kisan-a, keija nahsahlouva koiho, chonset chunga chonset bolbe theina dinga keima lhagaova hilouva khukhumna dang khatna khukhum ho; ohe, adau ahi!
  </para>
  <para style="p">
    <verse number="2" style="v" />Kathusei ngaicha louva Egypt'a chengdinga chesuh ho, Pharoah hatna-a kihatsah dingle, Egypt le-lim tahsan dinga cheho, ohe, adau ahi!
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh-a chu Pharoah hatna chu najachat nao hungsoh-a, Egypt le-lim tahsan nachu nakisuhmo nao hung hiding ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu amilenteu Zoan'a aumun, apalaihou Hanes-a ahunguve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho jousen amaho phatchomsah joulou miho chu ajachat piuvin, panpina le phatchomna hilouvin jachatnale housetna joh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lhanglam gamsaho pohgih; lungkhamnale lungnatna gam, chua konchun keipi noule keipitah, gulse le gulsum ahungin, amahon aphatchom sah loudiu miho henga, sangan golho lengkou chunga ahao naole, sangongsao tinghem chunga agouho chu pouvinte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Egypt miten pannabei jin panpiuvintin, chule apanajong umponte. Hijeh-a chu keiman hiche thua kasei ahi, athahatnao chu thabei pannabei ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun chenlang, atonsot atonsot phat hunglhung dingin, amasanguva dokhanga chun suninlang, lekhabua chingin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichehohi kiphin mite, joubol chate, Pakai danthupeh ngailouding chate ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon mitvah neiho jah-a, muhih un; themgaoho henga thildih neigaopeh hih-un lang, kahenguva thungei ngei neisei peh-un alhembou neigaopeh-un.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lampi dalhan, lamsih-a kiheidoh unlang, Israel mithengpa chu keiho masanga konin phapoh tahih-un atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijehhin Israel mithengpan aseitai, nangho hiche thu nanah sahmo uva suhgenthei nale golkehna natahsan uva chua na-umden jeh un;
  </para>
  <para style="p">
    <verse number="13" style="v" />hiche jehchun hiche khangitlouna chu nachung uva bang sangtah aselai pohjah dingkon, photlot mitphet kahlouva hung chimlha ding tobang nahidiu ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman hiche beldengpa bel suhkeh ahal halla achip banga asuhchipma; akhen louding, apokehna halchu meithuh-a kona mei-am lonading, ahiloule kokhuh-a kona twi thaldohna ding jeng jong kimulouding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu Pakai Pathen Israel mithengpan, hungkilea choldona chu huhhing nachan na hiding; thipbehnale tahsanna chu nahatnao hiding ahin, nangho nanompouve, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla nanghon ahipoi sakol chunga katou uva kajamdiu ahi, nati uvin, hijeh-a chu nangho najamdiu, chule gangtah-a kajamdiu ahi nati uvin, hijeh-a chu nanungdel hou jong gangtah hidiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mikhat phosala; sangkhat jamding, minga phosala; molvum'a melchihna kitah bangle, lhang chunga galponlap banga nakidalhah kahseuva najamdiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh-a chu nangho nakhoto theinadiuva Pakaiyin nangao ahi, ajehchu nachung uva hepina aneitheina dinga ama kichoisang ding ahi. Ajehchu Pakai chu thutan Pathen ahin; ama ngahte jouse anunnom ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu mitechu Jerusalem'a Zion'a chenguntin: nakakit louheldingu ahitan; napennao awginna chu aman nakhoto lheh dingu ahin; aman hichu ajahtengle nadonbut jengdiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Pakaiyin hesohna changlhah, suhgimna twi napejeng jongleu, nahil hou chu ningchonga kichonlut louheldiu, namitnun nahil hou chu amujoh dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangho nakijet heijuva chule nakiveihei tengule, nanunglam uva thakhatna hichehi lampi ahi, jotnun, tia nanunglam uva thukhat kiseichu nanauva najahdiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanghon dangka milim kikhegho tomnale, sana milim kilhaho kijepna nasuhboh diu ahin, pon thenglou napai uva, ahenguva hia konin chemangin tia naseidingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutengle aman namuchi diuvin gotwi hinpeuvin natin, chutia chu nangin leisetna nathe-a, leija anneh pungding, hichu phatahle nengtah hiding ahin; chuche nitengle na ganchate chu ganlhaina munlen tah-a kivahdiu ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutobangma chu bongchal hole sangan nou lou kaihon, chang japnale changlona-a kijapchilsa ngen gancha antheng anehdiu ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule kithana nasatah nikho-a insangho chimtengle, molsang chungle lhangsang chung tina, vapile vadungho chule luidungho hung longdiu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chukalvala jong Pakaiyin amite maput atoma, akijepnau mahaho adamsah nitengle, lhavah chu nisa vah bangjenga, nisa vah chu ajat sagi jenna nisagi vah kigom bangkhopma vahding ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Veuvin Tonsot Pakai minchu gamlatah-a konin lunghang tah-in ahunge, chule hiche pohgih chu gihtah ahi. Akamsung chu thangtomna adimsetnin; alei chu kavamjengthei meikong tobang ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahu hai chu ngong geija longlet vadungsoh abangin, namtin vaipi manthah na tengsa-a lochildin agon, chule suhkhelsah nadinga mitin kama kamdal umcheh ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nanghon kutpitheng kimanjan banga la khat najah dingu ahin, chule mikhat kuli mutpum ma; Israelte thahatpa Pakai molchunga chebanga lungkipa najong nanei dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pakaiyin a-aw loupitah kijahna ding bolintin, lunghan nasatah toh, halvam thei meikong toh, huipi le gopi toh, chule gel'a alunghana khut chu alhahding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu Pakai awgin'a kona Assyria te chu molla kinolhu ding kisumang ding ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Pakaiyin achunga angapding kivohna tenggolin aphahding, munjouse-a chu khongchale selangdah kithoding ahi. Aman gal mun kihotling mun'a chu akisatpi ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ajehchu Tophet hi malaija anakisudetsa ahitan; ahi, hichu lengpa dinga kigongsadem ahin; thuh tahle lentah-a asem ahi. Chua kikhol chu meile thing tamtah ahin, Pakai hu-hai chu meile kaat luija long deujeju bang ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Panpi hola Egypt'a chesuh-a, sakol ho chunga kingaija, sakol kangtalai ho tamjeh-a tahsan; sakol touthemho hatbehseh jeh-a tahsana, Israel mithengpa lam velou, Pakai hollou helho chu, ohe! ada ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Achuti vangin amajong michingtah ahin, thilse hinlhun sah intin, athu ho chu alekou louding: thilsebol insungho douva hung kipana, khanset bolte panpiho chu adoujoh ding ahibouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun Egypt mite chu mihem bou ahiuvin, Pathen ahipouve; Asakol-hou jong tahsaphe bou ahin, lhagao ahipouve. Pakaiyin akhut ahinlhandoh tengle mipanpipa chu lhu-a, chule akipanpipa jong lhuding ahin, ania lhukop lhonding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakaiyin aseitai, keipi bahkai chule anou asaneh hon chunga akitumhon banga, kelngoi chingho tamtah adou dinga akikoudoh tengle, a-aw uchu kichadeh pontin, ahusaova jong nemlha deh louding ahi. Chutia chu janel Pakai chu Zion mol le alhang dinga galsatna hung kumlha ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vachate alenlele banga, chutia chu janel Pakaiyin Jerusalem ahonbit ding ahin; ahonbitna ahuhdoh ding; chule akalchuh-a akhehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel chaten nasatah-a adoupao heng lama hung kilekit teijuvin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh inem itile, hiche nikho chule mitinin nadangka milimhou le nasana milimu chonsetna dinga nakhut tah uva nakisem muchu ahin paimang cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutengle Assyria chu chemjam'a louding, mihatpa chemjam jong hilou, minoinung pa chemjam jong hilou chun ama avallhum ding; ahinla ama chemjam'a kona jamdoh-a, akhangdongteu chu suhnohphah-a umding ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman tijatna-a akulpidet akalchuh-a, chule pipuihon ponlap chu akichatdiu ahi, tin Zion'a ameikong uma, Jerusalem'a alhumpi umpa Pakai chun aseije.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veuvin, leng khatnin chonphatna-a vai ahomding, chule pipuihon thutan dihtah-a vai ahomdiu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule mikhat chu khohuija kona kiselna munle huipi le gopi-a kona kivenbitna hiding; gamgolaija twi umna vadung le cholna gama songpi lenkhat lim tobang hunghi ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule khomuho mit chu thimlouva, khojaho chun angaidiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lungkinon jong hetkhen themtheina hetna aneija, pao oh hon jong kichentah-a thu aseidingu ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mikhangse chu mihongphal kiti talou ding, migenthei chu ninglhing dehlouhel ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Migilou chun gitlou thujeng aseijin, ajehchu phatlhemna kijil dingle, Pakai douna-a adihlou seidingin, gilkelte oisung akeova umsahdingle dangchah te donding thonsah dingin mi nunse chun thusese seijintin, alungsunga khan gitlou abolding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migenthei chu amanchahho jong phaloutah ahin, milhasam hon thudihtah aseiteng jongle, mivaichaho suhmang hela aum nadingin, thujouva jona thet umtah lungthim giloutah apodohjin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla mihongphal tah-in hongphalin, hongphalna thilho agongdohjin; ama hongphalna thilho-a chu ding jingding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangho numei ho thoudoh uvin; khohsahna bei chanuten ka-aw ngaijunlang; kathusei jahin nana sungun.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khohsahbei numei nangho nikhoho le kumho tamtah-a nalungkham diu ahi. Ajehchu lengpithei hungga louding, aga lona hung umlou ding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Numei nangho kithinguvin, khohsah bei nangho lungkham mun, kihoh lhaovin, nakeuvin umun lang, nakong uvah khaodip pon kigah-un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Loumun pha le, lengpigui gapha dinga, lunghem ding ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kamite gama lingle khao hungpou doh ding ahin; henge, khopi kipana pena insung kipah jouse-a jong chutiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu leng inpiho kidalha-a; mitamna khopi chu dalhah-a umding; galkul hole daivei insangho jong a-itih-a dinga gam sanganho, kinomtol nale ganchahon ho hamnehna mun hung hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chunga kona lhagao ichunguva ahung kibuh lhah-a, gamthip lou mun pha ahungsoa, lou mun pha gammanga akigel kahse-a;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutengle gamthipma chu thutan lhahna uma, loumun pha-a chu chonphatna umden ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chonphatna natohchu chamna hintin; chule hiche chonphatna chun a-itih-a ol-heuna le aphotchena asodohsah ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kamite chu chamdela umnale dettah-a chendetna inmun, chule ol-heuva choldona mun'a cheng taovintin;
  </para>
  <para style="p">
    <verse number="19" style="v" />gellhah tengle gammang chunga hunglhantin; chule khopi chu mun nema kikoiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Twipang dunga muchi tu-a nangho anunnom nahiuvin; chukoma bongchal le sangan lhatlutsah-a nangho anunnom nahiuve.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangla kichom khalouva michompa; amahonla nangma tahsanlel louva, mikitahlou pa; nada ahi. Michom nangah phatle, nangma nakichom ding; nangman kitahlouna nangah phatle, amahon nangma natahsan leldiu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Pakai, neilungset in, keihon nangma kangah jinguve, jingkahsehle aban nu hinlang, thohgenthei laile eihuh hingpao vin hung pangin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thunoh husagin chun miho ajam mangun; nangma nakichoi sangna-a chun namtin thecheh-in aumtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nathil chomdoh chu lungmul kikhol khom banga kikhol khom ding ahi. Khaokhopi suhle tunga achoplele banga achunguva lhai lele ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chungsanga um ahijeh-in Pakai chu akichoisangtai. Aman Zion chu thutandih nale chonphat na-in adipsohtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chihnale hetna chu nahinkhodetna le nahuhhingna thahat hunghi ding ahin, Pakai gin chu ama-a dinga goukhol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veuvin, amihangsan hou pama penguntin; chamna palaiho chu lhasetah-in kapmunte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lamlhongpiho chu akeoheltan, chule vahlea athipdeltai. Aman thulhuna asukeh-in, khopiho i-asahpon, koimacha anahsahtapoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leiset hi alunghemin ahesoh-e, Lebanon ajahchan lhamlhah ahitai, Sharon chu gamthip abangin; Bashan le Karmel'in aga hou ahotpul taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tonsot Pakaiyin; tun keima thouving ting; tun kichoisang inting; tun kidomsang tange; ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanghon changsi navop uva, chang kung nahindingu, nahaiju husa chun mei tobanga nakahvam dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mitin chu ngunsong kihal kong banguntin, ling kisatlha-a meija kihal tobang hidiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gamlatah-a um nanghon ipi kabol em ngaijun; chule naicha umhon jong kathahatdan heuvin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zion'a michonseho akichauvin, miphalhem ho tijatnin alungdongun ahi. Ilah uva halvamna meikongto chengdinga koiham, ilah uva tonsotna kongjing meito chengdinga koiham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Chonphatna-a vahlea dihtah-a thuseipa, bolgentheija kona phatchomna i-sah loupa, nehguh lahna-a kona akhut thinglhapa, thisona ding thu jah-a kona akol kisipma, thilse mu-a kona amit singpa chu;
  </para>
  <para style="p">
    <verse number="16" style="v" />amachu chungsanga chengintin; akihuhna munchu songa kisem kulpi hiding, nehding changlhah ama kipe-a adonding twi jong amuteiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Namitnin lengpa hoina amu-a, gamlatah-a um gamchu amudoh dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nalungsungin kichatna nasatah nangaito ding ahi. Danthusunpa hoiba hitam? Alalutpa hoiba hitam? Daivei insangho simtohpa hoiba hitam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangin kichat umtah mi namutahlou ding, giltah-a paodoh mi nahetchen theilou lei-oh mi namutah louhel ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kut loupiho kiman nading Zion khopi chunglam chu vetemin, namit tenin mongtah-a chenna Jerusalem; phetlhah louding houbuh kisonna akhom khatcha kibotdoh louhel ding; akhaojang jong khatcha kibottan louding chu munnate.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla loupi Pakai chu eiho dinga luidung lenho le luidung neoho hiding ahin, Chua chu kong innei kongtol ho chelouding ahin, kong innei hattah jong chelouding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai chu ithu tanpao ahin, Pakai chu danthu eipepao ahin, Pakai chu ilengpao ahin; aman eihuh hingdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nakong tolna ponkhao ho akikangin; apondalu khombul chu ahendet theipouvin, pondal chu ajahthei pouve. Chuin gala thil kichom tamtah akihomun, elbaijin jong akilah-e.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule chua chenga chun kadampoi atilouding, chua cheng mitechu akhansetnao kingaidam ding ahi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Namtin vaipi thungaidin hungnai junlang, nangho mipite ngai phaovin, leisetle asunga cheng jousen, vannoi le ama-a kon hungkondoh thiljousen ngaijuhen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu Pakai thangtomna chu namjouse chunga, chule alunghana chu agalsat jousete chunga aumtan, amaho chu asumangsoh helin, thagamheldin mithat ho hengah apedohsohtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amiteu kithat ho jong kipaidoh ding, chule athilonguva kona a-uiju kikhong doh-a, lhangho chu athisan utoh junlhah thading ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule vanlaijola thil um jouse junlha-a, vanho chu lekha kijelbanga hung kijelding; chule avan janel jouse chu lengpiguija kona ana pulbanga, chule theichang phunga aga apulhah banga pullha diu ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu kachemjam chu van'a notvala umding, veuvin, hichu Edom chungle kagaosap te chunga thutanlha dinga hung khumlha ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai chemjam chu thisanin adimtan, chule chemjam chu thaovin atomtan; hichu kelngoi le kelchal thisanto, kelngoichal kal thao ahi. Ajehchu Pakai chun Bozrah'a ganlhaina aneijin, Edom gama kithana nasatah aume.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule gambongchal kineiho chu amahotoh hungsuh thantin, bongchal til kilalouho chu bongchal atil kilaho toh, chule agamu chu thisanin chup mintin, aleivui chu thaova jollha ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu hichehi Pakai phulahna nikho ahin, chule Zion kinepna le khohsahna kum chu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule chua vachadung ho chu thingnaivom hungsoh-a, chule aleivuiho chu kaatsong hungsoh ding, chuche gamchu thingnaivom kadeujeju hungsoh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichu sunle jana mitlouhel ding, ameikhu chu tonsotna kitungdoh ding, akhang akhanga agoh-a uma, atonsot atonsotna koimachan ahopa louhel ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla twivamuhsao le vakeng'in lo intin; sumbupi le vavom asunga chengdio ahin; hiche chunga chu lungnohna khaole khaidihna songho kikhaiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chua milal ho chu lenggama dingin kou untin; koimacha vang umtalou ding, chule aleng chapate jouseu imacha hilouding ahitaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amanu leng inpiho-a lingphung, chule akulpidet hou sunga sachah le theimi hung kehdoh ding, Dragonho chennale sumbupi ho honsung hung hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Neldi gam, gamsaho jong twikol gama gamsahoto kitoh untin, chule lhomi chun agol kou intin, sumbupi chu chua chun kicholdontin, amadinga choldona mun amuding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chua chu sumbupi lentah-in buh ase-a, atwi athah ding, alhaving noija ahuikhom ding ahi. Chua chu muthong ho jong akopcheh-a hung kikhom ding ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai lekhabu holdoh-un lang simun; hichehohi khatcha thonlou ding ahi; akopto lhasam umlou ding ahi. Ajehchu kam'in thu apeh-a ama lhagao ngeichun akhopkhom ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman amahodin vang asanin, akhut tah-in khaovin aten, ahopkhen pehtai. Amahon hichu atonsotna alouva, akhang akhanga hichea chu chengding ahiuve.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Gammang lah le gamthip lah chu amaho dingin hungkipah intin, chule neldigam chu thanoma pahchapah banga pahding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nengchetnin pah-intin, kipah le lasah-in thanominte. Lebanon loupina ama kipeding, Karmel le Sharon ahoinapen, Pakai loupina le i-Pathen'u gunchena chungnung penchu amudingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khut hatlouho hatsah-un lang, khup ngoiho chu dindet sah-un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi meidoite chu hitin seipeh-un, kicha hih-un! veuvin, phula dingle lethuh dinga na Pathen'u hungding; ama hunga nangho nahuhdoh diu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutengle mitchote mit kihasah intin, chule na-ngongte kho kijahsah ding ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutengle elbai chu sakhi banga kichoma, paomo leichun la asahding, ajehchu gamthipma twiho chule neldi gama vachadung ho hungput doh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule tolgo chu twikul hungsoh doh-a, chule dangchah na gama chu twisam hungsoh ding, Dragon ho chenna le akolnaova chu hampa toh pumpeng le phaipheng hungkeh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chua chun lamlhongpi khatle lampi khat umintin, chuche lampi chu thenna lampi kitiding ahi. Atheng louvin achung aho louding; amavang hichu amaho ding ahi. Chule vahle ho ngoljong leu hichea chu adihlou abolloudiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chua chu keipi khatcha umtalou ding; sahingne gamsa khatcha jong hichea chu kaltou louding; hichea chu kimulouhel ding ahitai. Ahinla hichemun chu lhatdamsaten bou aho dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Pakai lhatdohsate hungkileu vintin, Zion'a hunguva tonsot kipana aluchung uva umding ahi. Amahon kipanale thanopna aneijuva, lungdon nale khoisatna jam mangding ahitai.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun, Hezekiah lengpa lengchankal kumsom le kumli alhinin, ahitin ahi, Assyria lengpa Sennacherib chu Judah gam khopi satdin ahungtouvin, alasohtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Assyria lengpan Lachish'a konin Rabshakeh chu sepai tamtah toh Jerusalem'a Hezekiah lengpa henga asoltan ahi. Chuin ama ponsoppa lou lamlhongpia twikul sahnung twilam panga chun anadinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuphatnin insung vaipo Hilkiah chapa Eliakim le Danthusunpa Shebna chule thuchingpa Asaph chapa Joah toh ahunguve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Rabshakeh-in ahenguva aseijin, tun nanghon Hezekiah jah-a, leng loupitah Assyria lengpa chun hitin aseije, natahsan kingapna chu ipi ham? ati, tin gaseijun ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman kati ahi, nangin (ahinla hicheho chu mohthu maimaibou ahi) galsatnadin lunggelna le thahatna kaneije natin ahi. Tun koichunga natahsana, keima douna-a gal naboljeng hitam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ven, nangin hiche peng tenggol chipsa Egypt mitehi natahsan ahin, achunga chu mi akingaile akhutna lutna asutding ahi. Egypt lengpa Pharoah chu ama tahsan jouse chunga chutiji ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla nangin kahenga keihon Pakai ka Pathen'u katahsanu ahi, tijongleu chun; ama chu Hezekiah'in amunsangho le amaichamho alahmangpeh-a, Judah le Jerusalem mite jah-a nanghon hiche maicham masanga bou nahoudiu ahi ati hilouham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun tun kangeh nahi, ka Pakai pa Assyria lengpa henga kitepna neijin, nangin achunguva touding mi naneiding poule sakol sangni pengkate.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kapu sohte sepai lamkai neopen khat maichu iti naheimanga, sakol kangtalai le sakol galmiho jeh-a Egypt chunga natahsan na-ngap jeng ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tu-a keima Pakai panglouva hiche gam douva sumang dinga hungtouva kahiham? Pakaiyin kajah-a hiche gam doudin chetou vinlang, gasumangin eiti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin Eliakim le Shebna, chule Joah chun Rabshakeh jah-a nahenga katao ahi, nasohte hengahin Syria te paovin thu seijin; ajehchu hichu keihon kaheuve, palvuma um miho hetthei Judah paovin seihih-in, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla Rabshakeh chun kapu chun napule nang hengabou hiche thuho seidinga eihinsol ham? Aman palvuma touho khun aeh-u akineh theina diule, ajunu akidon theina diuva ahenguva eihinsol hilouham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Rabshakeh adingin gingtah-in, Juda te paovin asamin; lengloupi Assyria lengpa thuseihohi ngaijun:
  </para>
  <para style="p">
    <verse number="14" style="v" />Assyria lengpan hitihin aseije; Hezekiah'in nahuhdoh jouloudiu jeh in ama kilheplhahsah hih-un.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hezekiah chun nangho Pakaiyin thonlouvin eihuhdoh untin hiche khopihi Assyria lengpa khutna kipedoh louhel ding ahi, tin natahsan sah daohen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hezekiah thu ngaihih un; Assyria lengpan thilpeh khatnin kinoptona neipeuvinlang, kahenga hungdoh-un; nalengpilei cheh kineh unlang, natheichangphung cheh kineh-un, chule mitinin natwikula twicheh kidonun;
  </para>
  <para style="p">
    <verse number="17" style="v" />keiman nagam tobangu gam khatna changle lengpitwi umna gam changlhah le lengpitwi umna gam khatna kahungpui kahseuvin ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chingtheijun, achutiloule Hezekiah'in Pakaiyin eihuhdoh naovinte tintin najollha getnunte. Assyria lengpa khutna kona namtin vaipi pathenho khattou agam huhdohpeh-a umkha tam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Hamath le Arphad mite pathenho hoiba ham? Sepharvaim pathenho chu hoija umam? Amahon kakhutna kona Samaria ahuhdoh beh-um?
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche gamho pathen lah-a kakhutna kona agamu huhdoh-a koiham? Hitia chu Pakaiyin kakhutna kona Jerusalem ahuhdoh dingham? ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla amaho athipchetnun, thucheng khatchan adonbut pouve, ajehchu amachu donbut hih-un tin lengpa thulhahna aumtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun insung vaipo Hilkiah chapa Eliakim le lekhasunpa Shebna chule thuchingpa Asaph chapa Joah chun aponu kibottel pumin, Hezekiah henga ahungun Rabshakeh thusei ho chu ahung seipeh un ahi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Hezekiah lengpan hiche thuho chu ajah phatnin, apon abottelin, khaodip pon akikhuh-in, Pakai insunga aluttai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin insung vaipo Eliakim le danthusunpa Shebna, chule upa thempuho chu khaodip pon silpumin, Amoz chapa Isaiah themgao henga asoltai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahon ajah-a, Hezekiah'in hitin aseije, tunihi hesoh nikho, kipho nikho chule taitom nikho ahi. Ajehchu chate pengding ahitan, ahinla apenlhah nadiu thahat aumpoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai na Pathen'in Rabshakeh thusei ho ajah theina dinga, amachu apu Assyria lengpan Pathen hing jumso dinga ahinsol ahin, Chule Pakai na Pathen'in athujahho chu abehlhah ding ahi. Hijeh chun akidalha amoh chengse dingin hatah-in taovin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutichun Hezekiah lengpa sohte chu Isaiah henga ahungtaove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Isaiah'in, ahenguva, napupao henga hiti ahi nasei dingu ahi, Pakai chun hitin aseije, Assyria lengpa sohten eitaitom nathu najah hou jehchun kichahih beh-un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veuvin, keiman achunga hui hattah solingting, chule aman thuthang khat jantin, agamlama kilekit ding, ama agamsung tah-a chemjam'a kalousah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichun Rabshakeh chu akilekitnin ahile Assyria lengpa Libna douna-a agalsatpet agatohtai. Ajehchu aman Lachish adalhatai ti thu anajatan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Ethiopia lengpa Tirhakah nangtoh kisatdin ahung kondoh-e ti chungchang thukisei ajatai. Hichu ajah phatnin Hezekiah henga thupo khat asollin, ajah-a;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitia hi Judah lengpa Hezekiah henga naseiding ahi. Assyria lengpa khutna Jerusalem kipedoh louding ahi tin nangin natahsan pa Pathen chu kilheplhahsah hihbeh-in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Veuvin, Assyria lengten gamjouse iti asuhmang hellem, tithu najatai. Hichu ahile nangma huhdohna hideh ding hinam?
  </para>
  <para style="p">
    <verse number="12" style="v" />kapateuvin anasuh mangho Gozam, Haran, Rezeph chule Telassar'a anaum Eden chate banga chu namtin vaipite pathenho chun amaho chu anahuhdoh nah um?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hamath lengpa, Arpad lengpa, Sepharvaim khopi lengpa Hena chule Ivah khopi lengpa hoija umtam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Hezekiah'in lekhathot chu thupole ho khutna konchun alan hichu asimtai. Chuin Hezekiah Pakai inlama achetouvin Pakai angsunga chun aphajaltai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Hezekiah Pakai henga ataovin aseije,
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo janel Pakai, Israel Pathen, Cherubim ho kah-a chengjing pa, leiset lenggam jouse-a nangma Pathen nahin; nangma ngeibou nahi. Nangin vanle lei nanasemme.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo Pakai, nana sungin lang ngaijin, vo Pakai, namit hasah inlang hinvetan, chule Senacherib'in hingjing Pathen housetna-a ahinthot thu jousehi ngaijin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Atahbeh in Pakai, Assyria lenghon namjousele agamsunghou ahomkeovin akoi gamtaove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule apathenhou meilhum sunga alehlutnuve, ajehchu amaho pathen hilouva mihem khutsem thingle songbou ahiuvin, hijeh-a chubou asuhmangu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun tuhin, vo Pakai, ka Pathen nu, akhutna konin nei huhdoh-un, chutile leiset lenggam jousen nangma Pakai, nangma sehbou Pakai nahichu hethei taovinte, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin Amoz chapa Isaiah chun Hezekiah henga mi asolin, Assyria lengpa Sennacherib douna-a kahenga nataona chu, Israel Pakai Pathen'in hitin aseije,
  </para>
  <para style="p">
    <verse number="22" style="v" />ama chungchang Pakaiyin aseithu chu hichehi ahi. Nungah theng Zion chanun nangma nanoisen, nahsahmonan nanuisat in, Jerusalem chanun alu nathin khume.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangin koi nahousetna nataitom ham? Koi douna-a na aw nasansah-a chungsang lam nangatna navettou ham? Israel mitheng patah douna ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nasohte-a konin Pakai chu nahousen hitin naseije, ka kangtalai tamtah toh molsang ho geijin Lebanon lhang pangho-a hungtou vingting, cedar thingphung sanghole chahthing hoiho phuhlhung ting, agamgi munsang ho le Karmel gammanga kalhut ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Keiman kotong kalaijin twi kadontai. Chule kakengton aki-umkul munho-a vadung jouse kalho kangtai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichehi iti kanabol hija, malaija patna iti kagontohsah-am, tichu sotna nanajah hitalou ham? Tu-a hi kagui lhunsah ahitai, Kulpi kikaikhum khopi ho akeova umsah-a, manthah na-a sevum dinga chu nangma nahiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun achengho chu thalhom tah ahiuvin, amaho alungthoijun alungdonguve. Amaho chu loujaova hampa tobangle chang aphung lhin masanga huise semgot tobang ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hinla keiman naumna, napotdoh, nahunglut chule kachunga nalunghan kahenai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu kachunga nalunghannale, nahusa ginchu kanasunga ahunglut tai. Hijeh chun ka ngakoi nanah homa sutongting, nakama kakamdal kabuding, nahungna lampia chu kalehei kitding nahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichehi nangdinga amelchihna hiding ahi. Tukum achama kehho naneh ding, kum nina jongle chuche-a dondoh chu nen natin, chule kumthum nateng nanghon kitun lang, ki-atnun, chule lengpilei kibolin lang aga nen.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Judah insungmi asohcha ahoidoh chengsen, jung akhosuh-a chule achunglamin ga aneiding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu Jerusalem'a kona ahoidoh chengsele Zion'a kona asohchaho hung sohdoh ding ahiuve. Janel Pakai tompana-in hiche aboldoh ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh chun Pakaiyin Assyria lengpa thudol hitihin aseijin, ama hiche khopi sunga hunglut louding, thalchang khatjong akap louding, amasanga lumdal puma jong hunglou ding, hiche satna dinga leikul jong asetlouding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahungna lampi mama-a chu kinungle-a, hiche khopiahi hung louhel ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ajehchu hiche khopihi keimajeh le kasoh David jeh-a kahuhdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Pakai vantil chu apotdoh-in, Assyria ho ngahmuna sang jakhatle sangsomget le sanga athattai. Chuin jingpi-a ahungtho phatnun vetan; mithilong jeng anahitaove.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chutichun Assyria lengpa Sennacherib chu apotdoh-in achen akilekitnin Nineveh'a achengtai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chutichun ahitin ahi. Aman a-pathen Nisroch insunga pathen ahoupetnin achapateni Adram-melech le Sharezer'in chemjamin athatlhonin, Armania gama ajamlut lhontai. Chuin achapa Esar-haddon chu akhelin alengchang tai.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichelai chun Hezekiah chu thidingin anatan ahi. Chuin Amoz chapa Isaiah themgao chu ahenga ahungin, ajah-a, Pakaiyin hitin aseije, na-insung kisemtuptan, ajehchu nangma damdoh joulouva nathiding ahitai, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin Hezekiah'in banglama amai aheijin, Pakai henga ataovin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Pakai kengeh nahi, namasanga thutah le lungdih po-a, chule namitmu-a thilpha kanabolho chu tun neigeldoh peh tan, ati. Chuin Hezekiah hakan akaptai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakai thuchu Isaiah henga ahung lhungin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hezekiah henga chun chenlang gaseijin, Pakai napa David Pathen'in hitin aseije, nataona kajan, namitlhi lon kamutai; vetan, keiman nahinkho kum somle kumnga kajopbe ding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman nangmale hiche khopihi Assyria lengpa khutna kona kahuh doh-a hiche khopihi kahonbit ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakaiyin aseisa chu aboltei ding ahi, tihi Pakaiya kona namelchihna ding chu ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Vetan, keiman nisa lim chu hinlepui kitningting, Ahaz maikoh-a lhumsuhsa chu kalsoma kanungchon ding ahi. Chutichun alhumsuhsa-a konchun nisa chu kalsom anungchontan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah lengpa Hezekiah damlouva auma ahung damdoh phatna athilsut chu hichehi ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kahin nikho kisumanga thikholkhul kam jonding kahitan, kahin kumkho umnalai ho chu lahpeh kahitai, kanatin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai muponge, chule mihing gamachun Pakai le vannoi'a cheng mihemchu mukit taponge kanatin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kakhanghi achemangin, kelngoi chingpa pon in bangin akichonmangtai. Kahinkhohi pon kikhong bangin akijel doh tai. Natah-a kisuh natna-a eisuhmang ding ahi. Sun-apat jankhang geija neikichai sah ding ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jingkah geijin kakou kouvin, keipi bangin chutichun kagu jouse subongintin, sun-apat jangeija neikichai sah ding ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule pelpa le vakengsang bangin kaham hamin, vahui bangin kamao maove. Chunglam vetnan kamit teni akhamtai. Vo Pakai eiki sugenthei tai, neivesui jin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ipi seitang em? Aman kahenga aseijin, ama maman abolchai tai. Kahinna hi gimtah-in kahinkho lhumkeijin oltah-in chejingjeng tange.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo Pakai hitiho jal hin mite ahingjingin, hicheng thil jouse-a hi kalhagao hinna hi uma ahi. Chutichun nangin neidamsah kitnin natin, neihinsah kitnin nate.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vetan chamnahi kana hotbol lheh-e; Ahinla kalhagao hi ngailutna-in setna kokhuh-a konin nahuhdoh tai. Ajehchu kachonsetna jouse nanung lama nasep mangtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu thikhol khulin navahchoi theipon, thina in nakipapi theipoi. Kokhuh-a kumlha hon jong nathudih akineppi theipouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihing, mihingin vang tunia kabol banghin vahchoi jinnate, pan chate chu nathudih hetsah unte.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai chu eihuhhing dinga phasadem ahi. Hijeh chun tumging tothon kahinkho lhumkeijun Pakai insunga la saovinge.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu Isaiah'in theichang bohkhat laohen lang uilut chunga chun louvin nu-uhen chutile damkit tante, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hezekiah'in Pakai inna kachetou nading melchihna ipiham? tinjong anaseije.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichelai chun Babylon lengpa Baladan chapa Merodach-baladan'in Hezekiah anan adamkit tai, ti thu ajah jeh-in lekhathot tampile thilpeh agahthotnin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Hezekiah'in hicheho chu akipapin, amaho chu athil lu ho in chu avetsah sohkeijin; sana, dangka, gimnamtui mantamho chule agal manchah ho in, chule agou kholna-a umjouse avetsahsoh heltan ahi. A-insung le avaihomna sunga Hezekiah'in avet sahlou khatcha jong aumtapoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Isaiah themgao chu Hezekiah lengpa henga ahungin, ajah-a, miho hin ipi aseijuva? hoija kona nahenga hunga hiuvam? atin ahi. Chuin Hezekiah'in, amaho gamlatah Babylon gamlampeh-a kona kahenga hunga ahiuve, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman, amahon na-insunga ipipi amuvem? ati. Chuin Hezekiah'in adonbutnin, amahon ka-insunga umjouse amuvin, kagou thil lah-a amaho kamusahlou khatchabeh aumpoi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Isaiah'in Hezekiah henga, janel Pakaiyin asei thuhi ngaijin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vetan, na-insunga umjouse le napu napaten tunigeija akhol khomho jouse Babylon'a akipoh mangna nikho hung lhungding ahi; imacha akikhena umlou helding ahi, Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nachate, nanga kona pengdoh dingle nangin nahindingho jong apuimangdiu ahin; chule amahochu Babylon lengpa inpisunga nukiso hiding ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Hezekiah'in Isaiah henga, nangin naseidoh Pakai thuchu aphai, ati. Aman chukalvalin keima hinkho sungin chamnale thudih lenghen, ati.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho lungmongun, nangho lungmongun, kamite, tin na Pathen'un aseijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jerusalem henga damheochan seijun, agalbol lah molso ahitan, akhan git louna akingaidamtai tin ajah-a samun, ajehchu amanun achonsetna jouse jal-in Pakaiya konin ajat ni akimutai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamthipma khosam aw chun nanghon Pakai lampi semtoh-un, nelgama chun i-Pathen'uva din lamlhongpi semjangun, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Damphai jouse kidomsanga, molsangtin le lhang jouse kisunem ding ahi. Akonlai kisujanga, aphonlai chu kisunamding ahi
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuteng Pakai loupinachu hungkilang intin, tahsaphe jousen amukhom sohkei diu ahi. Ajehchu Pakai kamin hichu asei ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ogin chun samin, atin ahi. Chuin aman ipi kasap dingham? ati. Tahsaphe jousehi hampa tobang ahin, aphatna jouse jong loujaova pahcha pah tobang bou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hampa agopjin, pahcha apuljie, ajehchu Pakai lhagaovin ahinsemji ahi. Tahbeh mongin mihem hi hampa tobang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hampa agopjin, pahcha apuljie, ahinla Pathen thu vang atonsotna ding jingjeng ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kipana thupha hinpo-a, vo Zion, molsanga khun kaltouvin; kipana thupha hinpo-a, vo Jerusalem, nathanei chasunin na aw sansah-in, sansah-in; kicha hih-in, Judah khopiho henga, veuvin, na Pathen'u khu? tiuvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Veuvin, Pakai Pathen chu khut thahat tah-a hungding ahi, chule abantha-a avai ahomding, atohphat man chu akoma uma chule anatoh chu amasanga umding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman kelngoi chingpa banga aganchahon avah ding ahi. Aman abana akelngoiho chu ahoikhoma, a-opma akipomding, anousen puma hicheho chu olchacha apuile ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Akhut phang tonga twivei ho tetheija, akhapma van tethei, leija leivuiho tena khatna hedohtheija, tena-a molsangho tedoh-a, chule lhangho khaikotna khaija koiham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai Lhagao chu hila, thumopma panga, hilchah-a koiham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Koito kithumoptoa, ama kon ahila, thutandan lampi kon ahila, chule chihna thu ahila, chule hetkhen themna lamlhah kon ama amusah khah-em?
  </para>
  <para style="p">
    <verse number="15" style="v" />Vetan, namtin vaipihi baltina twi vatkhat bangbep ahin, chule khaikotna leivui sipah bangbepma asim ahin, vetan, twikol gamho chu thil neochakhat bangin alan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Lebanon chu meija tikham ahipon, asunga ganhingho jeng jong govam thil to-a tokham ahipouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Namtin vaipi a-angsunga ima ahipouvin; amaho chu amadinga imacha hilou, agohkeo ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Achutile Pathen chu koito nakibahsah uva? Ipi akibahpito natekah dingu ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Mikhut themin milim asemjin, sana khengin achunga sanan atomjin, chule dangka sumgui akhengjin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Todoh ding neiloi mivaicha tah chun amotlouding thing akilhenin; achatloh theilou ding semthu milim semsah dingin, mikhut themtah akiholjin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nahet khah, najahkhah loulai uham? Semtila patna kihilkha loulai nahiuvem? Leiset bulkiphu-a pat nahetkhen thei loulai uham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Leiset kikol lum chunga touva ama ahin, asunga cheng ho jong khaokhopi tobang ahiuvin; vanho ponjal banga jeldoh-a, chenna inding pon-in banga jahdoh-a ama ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman leng chapate imalouvin akoijin; aman leiset thutan ho agohkeovin asemtai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Henge, amaho kiphut lou ding ahiuvin; tu jong kitulou dingu; aphungu leija jungkho manlou ding; chule Aman amaho amut teng jongle amaho gop lhading, chule changpol banga chimpeijin apeimang dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Achutile koito neikibah sah uva, ahiloule koito kakibah dingham? tin mithengpan aseijin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Namtinin chungsang lam nganlang, hichengse sempale ajanelu ahon hona puidohpa khu vetemun; aman aletnale athahatnan amincheh-in akouvin, Ama thanei na-a hattah ahijeh in khatcha akhenpoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vo Jacob, vo Israel, kalampihi Pakaiya kona kisel ahin, kathutanhi ka Pathen'a kon ahipoi tia ipidinga naseiham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathen, Pakai, leiset kolmong geija sempa, nahetkhah-a najahkhah louham? Lhasam khalou, choljong cholkhalou, ama hetkhen themna holdoh jouhoi hilou ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman milhasam chu hatna apen; chule thaneilou chu athahat nao akalsahjin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khangdongho jengjong lhasama choldingu, gollhangho jong kipala lhuding ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahinla Pakai ngahjingho chun athao kisem thah-un tin; muvanlai bangin alhaovin lengtou untin; amaho lhaijuva chollou dingu; chule vahleuva lhasam louding ahiuve.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo twikol gamho, ka-anga thipchetnun; miten athao semthah-uhen; amaho hungnaiju henlang, chuteng thu seijuhen, thutanna mun chu naicheh-u hite.
  </para>
  <para style="p">
    <verse number="2" style="v" />Solama kona michonpha pa chu hintungdoh-a, akhophang bulla kou-a, namtin vaipi a-angsunga pe-a, lengho chunga ama vaihomsah chu koiham? Amahochu leivui kisoh dingin chemjam ma apedoh-in; changpol kithethang bang thethang din athalpi henga apedoh tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho chu anungdelin bitkeijin agalkaijin; lampia chun akengin jong achepoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichehi koijin atoh-a chule abol hintem; semtila patna akhang akhanga miho kou-a natong jouva chu koiham? Keima Pakai amasale anukhah, ama chu keihi kahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Twikol gamhon hichu amuvin, akichauve; leiset kolmangho jong akitihot hot-un, ahung kikhin naijun ahing taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho amitakipmin aheng akomcheh akithopiuvin; chule amitakipmin asopipa jah-a, hangtah-in pangin, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutichun khut thempan sana khengpa atilkhouvin, chule sehcha-a khenpan thihnoidou khenpa atilkhouvin, ajah-a, solmat dinga phasadem ahitai atin, akilon lounadin thihkilin akildetne.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla, Israel nangma kagolpa Abraham chilhah-a kalhacha Jacob chu nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leiset kolmonga kona kalah-a, chukoma milenho-a kona kakouva, najah-a kasei ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma kaumpi jeh-in kicha hih-in, keima na Pathen kahijeh-in lunglha hih-in; henge, keiman kahatsah ding nahin; Keiman nakithopi nange, chule keiman nangma kachon phatna khutjetna katuh ding nahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vetan, nangma douva lunghansah jouse chu jahchaova, kisudongdiu ahi. Amaho imalouhel banguntin, nakinahpiho chu mangthah ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman amahole nakinahpiho ngeichu nahola namu louding; nangma douva galbolho chu imalouhel leh pannabei sohding ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu keima Pakai na Pathen'in nakhutjetna katuh-a, kicha hih-in, keiman nangma panpi nange kati ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangma lungtol Jacob, chule nangho Israel mite kicha hih-un; keiman panpinange, tin Pakai nalhandam pu Israel Mithengpan aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vetan, keiman nangma chang chilna manchah hanei hemtah-a kasemthah ding nahi. Nangin mol ho nachila, navoh ngemding, chule lhangho chu changvai nabahsah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangin amaho najapma, huichun alhoh mangdiu, chule chimpei chun athecheh diu ahi. Chule nangma Pakaiya halna-in kipah-in natin, Israel Mithengpa-a chun loupitan nate.
  </para>
  <para style="p">
    <verse number="17" style="v" />Avaichale alhasamin twi athuma, koimachan pelouva aleiju dangchah-a agotteng, Pakai keiman nousah ingting, Israel Pathen keiman amaho kapaidoh louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman munsang ho-a vadunglen holeh phaicham lailunga twinahho kahonding ahi. Keiman gamthiplai twikul'a chule gam golai twisam putna-a kasemding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiman gamthipma cedar thing, thinggi thing, le pahcha thing chule thao thing kaphua; neldi gama chahthing, phan thing chule thingkhang thing kaphu ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu amahon amuva, ahetnuva, angaitouva, chule ahetthem cheh theina diuva Pakai khutnin hichu abola, chule Israel mithengpan hichu anasem ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakaiyin nakibaonao hinpolutnun ati; nathu hahsao hinpolutnun tin Jacob dinga lengpan aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amahon hicheho chu hinpolutnu henlang thil hunglhung ding eimusah uhen; amahon thil masaho chu ipiham? kangaitouva, akichaina kahet theina dingun eimusah-uhen; ahiloule ahunglhung dingho eiphon dohpeh uhen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangho pathen ho nahiuve ti kahet theina dingun, tununga thil hunglhung dingho tahlangun; ahi, kalung thoijuva kamucheh nadiuvin apha ham aseham boluvin.
  </para>
  <para style="p">
    <verse number="24" style="v" />Veuvin, imacha hilou nahiuvin, natoh-u jong pannabei ahi. Naki lhanpao chu thet umtah ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Keiman sahlam gama konin mikhat katungin, ama chu hungding ahi: aman niso-a pat kamin akouding; Songchung kichonpha tobangle beldengpan leingan achil banga ama pipuiho chunga hungchu ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ihettheina diuleh ama chonpha ahi iti theina diuva abula patna kon aphonkhah-em? ahi, khatchan atahlangpon; ahi, khatchan aphongdoh poi; ahi, nathu ja-a khatcha ana umpoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amasan Zion henga, ven, ven, amahokhu tinnate; Jerusalem chu kipana thupha pole-a khat kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu kagah vetleh koimacha kamupon; amaho kadohjongle thukhat donbut theijong alah uvah kamupoi, khatcha aumpouve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Vetemun, abonun pannabei jeng ahiuvin; atoh-u jong mohseh ahin; amilim kilhajol ujong hui lhi le ahomkeo ngen ahiuve.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veovin, kasottol, katuhjing, kalhentum; achunga kalung kipanakhu; achunga kalhagao kakoijin; aman chidang namdang ho henga thutanna anei ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman kho asaplouding, a-aw asodoh louhel ding, khopi lamlena jong a-aw kija louhel ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pumpeng kihehchip ahebohpai louding, thaomei patkhu athamit pailou ding ahi. Aman thudih-a thutanna apohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Leiset chunga thutanna aumsah masangse-a losam louding chule lungjong lunglhalouding; twikol gamhon ama danthupeh angaidiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vanho sema jahdohpa, leiset le asunga kona hungsoh ho phajaopa; chule achunga mite henga haina hule asunga vahle miho henga lhagao pe-a Pakai Pathen chun hitin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima Pakai hin chonphatna-a kakou nahin, nakhut katuh-a kavet tupma, mitin dinga kitepna chule chidang namdangte vah hidinga kasem ding nahin;
  </para>
  <para style="p">
    <verse number="7" style="v" />mitcho ho mit hasah ding, sohchangho songkulla kon puidoh ding, chule songkulsung muthim lah-a touho puidoh dinga kapansah nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keima Pakai chu kahin; hichu kamin ahi. Kaloupina chu midang kapehlouding, eiki vahchoina jong milim semthuho henga pelouding kahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Veuvin, phatmasa thilho chu ahung lhungtan, thilthah ho kaphong doh-in; ahung dotdoh masanga athu dollu kahil masatdem nahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangho twikhanglen'a kumsuh hole asunga umho jousen; twikol gamle asunga cheng, leiset kolmonga patnin Pakai henga lathah khat saovin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gamthip le akhopiho Kedar chan geija kho ho pengu hen a-aw sansah uhen, songpi-a chenghon kipa la saohen lang, molsang hon chungvuma konin samu hen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon Pakaiya loupina peuhenlang, twikol gamho-a chun a thangvahna phongjal uhen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai chu mihat tah bangin kondoh intin, galsat mi banga thangthipna acho thouva, kholhang asapding; ama hat tah-a kituma, amelmate ajoding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sottah thipbeh-in kaumtan; kathipbeh-in, kakitimkit hamhame, tunvang naosonat thohlel bangin peng ingting; kasuhmanga kavalhum ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mol le lhangho agoh-in koi jingting, ahampaho gotsah gaming ting, vadungho twikol gammin semingting, chule twikulho kansah soh inge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mitcho ho chu ahetkhah lounao kenglampia puijing ting; ahetkhah louvu lampia kaijinge; amasanguva muthim chu vahsah ingting, akonlaiho ka jansah ding ahi. Hicheng hi ahenguva kabolding, kadalhah louding ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Milim semthu tahsan ho, milimho jah-a, nangho kapathen'u nahiuve tiho chu hung kinungle uva, jahcha lheh ding ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na-ngong ho, nanghon ngaijunlang, nangho mitcho hon namutheina dinguvin veuvin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mitcho koiham, kalhachapabou hilouham? atiloule kasottol kasolpa banga nangonga koiham? michamkim pa banga mitcho koi hijam? Pakai sohpa banga mitcho koiham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Thiltampi namun ahinla najuipoi; nakhangho chu avangnan ahinla ajapon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Achonphatna jal-in Pakai alunglhai tangeije; aman danthupeh chu aloupisah-a ja uma asemding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla amahohi agumanga leh asuthanghoi ahiuvin; amaho jouse kohoma thangkol ho ahiuvin, songkul inho-a kisela ahiuve. Amaho akithatgam ding ahiuvin, ahuhdoh dingu khatcha aumpon; suhchatvai ding ahiuvin, lepeh kitnun tia khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichea nakhang sungdinga nalah uva koi nahiuvem? Ahunglhung ding phat ho dinga kon nangai uva, najahdiu ham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Galthil kichom banga chomdinga Jacob pe-a, guchaho henga Israelte pedoh-a koiham? chonset iboluva idoupao Pakai chun apehdoh hilouham? ajehchu amaho alampiho-a achenom pouvin, adanthu jong ajuipouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh-a chu achunguva alunghana meikongle galkisat hattah chu abuhlhah khum ahi. Hichun akimvel meija ahalin, ahin amanla ahethei dehpon; hichun aka-in, ahivanga alungsungah aching dehpon ahi.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla tun, Vo Jacob, nasempao Pakaiyin, vo Israel natungdoh paovin kicha hih-un atin ahi. Ajehchu keiman kalhatdoh nahin, naminin kakouvin, keija nahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Twipi napalteng jongle umping ting; vadunghon jong nachup louding; meilah najot teng jongle, nakah louding ahi. Meikou deujejun jong naleogop louding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu keima Pakai na Pathen, Israel mithengpa nahuhhingpa chu kahi nangma lhatnadin Egypt kapen, nangma khelin Ethiopia le Seba kapei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamitmu-a lutah nahin, ja-umtah nahina jeh-in kangailun ahi. Hijeh chun nakhelin miho pengting nahinna dinga mitin kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kicha hih-in, ajehchu keiman kaumpi nai, nachilhah solama konin hinpui jingting, lhumlama konin dongkhom inge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman sahlam jah-a, hin pedoh-in, lhanglam jah-a, henden hih-in; gamlatah a konin kachapate, leiset kolmonga konin kachanute hinpuijin tinge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kamina kikouchan chu kaloupina dinga kasema kagon ahin; henge, keiman ama kasem ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mit neija khomulou leh, nakhang neija khojalou ho chu hinpui doh-un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Namtin vaipi jouse kikhom khomuhen, chule mipite kikhom khomuhen, alah uva koiham hiche phongdoh dingle thil um masa cheng eivetsah thei uva koiham? Athem chana dingun ahettohsah ho hinpuijuhen; ahiloule ngaijuhen chule adih ahi, tiuhen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangho keima hettohsah nahiuve tin Pakaiyin aseije: chule kalhendohsa kalhacha nahi; hitia chu keima neihet uva neitahsan uva, keimahi Ama kahi neihet nadinguva: keima masanga Pathen dang akisempon, keima nunga jong khatcha kisem louding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kei, keima bou Pakai chu kahi, keima tailou huhhingpu dang aumpoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nalah uva gamdang pathen aum masangin keiman kaphong doh-in, kahuhhingun, chule kamusah-un ahi. Hijeh chun nangho keima hettohsah nahiuve, tin keima Pakaiyin aseije, keima Pathen kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahi, nikhoho umasanga keima Ama chu kahi; kakhutna kona ladohjou khatcha ana umpoi; keiman katohding chu koiham ajada dinga?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai na lhatdampu Israel mithengpan hitin aseije; nangho khohsahna jal-in Babylon'a sepai kasolin, amilaltehou jousele Chaldea ho kong-innei sunga peng jenjunin kahin puisuh-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima Pakai na Mithengpao, Israelte sempa nalengpao chu kahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai twikhanglen'a kenglampi semaleh twihat sunga lampi sempan hitin aseije;
  </para>
  <para style="p">
    <verse number="17" style="v" />Sakol kangtalai le sakol, sepaiho le athahat ho puidohpa Pakai chun hitin aseije. Amaho lumkhom uva thoutaloudiu ahin; amaho amit adelun, thaomei pat bangin akimutmit taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil masaho geldaovin lang, tonlai thil jong ngaito daovin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Veuvin, keiman thilthah khat kabolding ahin, tu-a hungpotdoh ding ahitan; nahetlou diuham? Gamthiplai geija lampi khat kasema, nelgama jong vadungho kalonsah ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kamite, kalhentumho dondinga gamthipma twiho chule nelgama vadung ho kapeh jeh-a, gamlah-a gamsaho, dragon ho chule sumbupi hon eijabol dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche mitehi keiding tumtah-a kasem ahin; amahon keima vahchoina atahlang lediu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla Vo Jacob, nangmanla neikou pon, Vo Israel, nanghon neitheichim un ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nagovam thilpeh-a din ganchaneo neihin choipehjipon, ganlhaina injong neijabol jitapon ahi. Thilpeh-in nangma kana kijenkhahsah pon, gimnamtui jinjong kasugim khapoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangin sumin kolchulhum nachokhapon, naganlhai na sathaovin jong neivahva khapon ahi. Ahinla nachonset nao neipohsah-un, nakhangitlou naova neisugimun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kei, keimong monghin, keile kei kikhohsah najala nasuhkhelnao thehmanga chu kahin, nachonset nahou kageldoh kit tahlou ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Neigeldoh jingun; hungun ngaito khomu hite; them nachan theina dingun kisei phongun.
  </para>
  <para style="p">
    <verse number="27" style="v" />Napa masapen anachonsen, chuin nahil hou keima douna-in anasukhelun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun munthenga pipuiho chu kanasuboh-in, Jacob chu sapsetna-a, Israel chu i-sah louvin kana umsah tai.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuvangin Vo kalhacha Jacob, Vo kalhenchom Israel, ngaijun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Nasema leh naobu-a kona nahin gonga napanpi ding Pakai chun hitin aseije; Vo kalhacha Jacob chule vo kalhenchom Jerusalem, kicha hih-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu adangchah chunga twi kasuna, tolgolaija twi kasosah ding ahi. Nachilhah ho chunga kalhagao chule nasonho chunga kaphat theina kabuh lhah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho hampalah banga hungdon doh diu, twipanga huisum thingho bangdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khatnin, keima Pakaiya kahin; achomkhatma Jacob mina kikou ding; chule adang khatnin akhut tah-a Pakaiya ding tia ajih ding, chule Israel mina kiminvo ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai Israelte leng, alhatdampu janel Pakai chun hitin ati; Keima amasale anukhah kahin, kei tailou Pathen dang aumpoi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Malai miho katundoh laija chu keima bolbanga koiham aboldingle aphongdoh dinga? chule abancha umsah ding? chule thil ahunglhung dingle ahunglhung saho chu amaho musah-u hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tija hih-un, kijong kicha hih-un; chuche laija patna kahilkhahlou, kaseipeh khahlou nahiuvem? Nangho kathu hettoh sahmong nahiuvin ahi. Keitailou Pathen dang umem? ahi, Pathen dang aumpoi, khatcha jong kahepoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Alim semthuho abonun ahomkeo ahiuvin; anopsahnao thilho jong pannabei ahin; amaho chu amaho hettohsah ahiuve, ajachat theina diuvin amahon amupouvin, hejong ahepouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aphat chomna bei pathen le alim semthu milim sema koiham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Vetan, aloiho jouse jahchao vintin, chule anatong amaho jong mihem bou ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thih khengpan achoiche toh meihola agouvin, sehcha'n avotoh-in, aban thahatnin atongjin ahi; henge, ama agilkelin, ahatna angoilhajin, twila adonpon, alhadahjitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thingthem bolpan agolkaina ahinladoh-in; gol akaijin, amelchih-in; tolnam na-in atoltoh-in, vettohna-in amelchih-in, mihem gong bangin mihem hoina dungjuijin a-insunga aumden nadingin amelchih-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman cedar thingho aphuh lhun, khengthing le gangpi thing amadingin gammang lah-a akhansah-in ahi. Aman meila thing aphutnin gotuijin achapnoujin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujoule hichu mihem dinga tiding hintin; ajehchu aman thing lah-a akehkhat chu akitikouvin a-oilumjin; changlhah akangjin; a pathen lim sem angsunga chun abohkhupmin ahoujin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman phabep chu meija atih-in; sa go nan aneijin oiva nan anen; meisa chu a-oilumin, katejo, keiman lum kasatai, meimu-a kahitai atijin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule thing moh chu pathen khatnin semthu milim ngeijin asemjin, a-anga aboh khupmin, ahouvin, ahenga ataovin, ka-pathen nahi jeh-in neihuh doh-in atijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amahon anahepouvin, hetjong ahethem pouve; ajehchu amulouna diuva amitnu achotsah-a, ahetkhen themlouna diuva alungthimu akhachah ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abang meija katih-in, henge, chua mei mama chun changlhah kakangin, sa kakigon kanei; achutile amohchu thet umtah khatna kasema, thingbul khat anga kabokhupma kahou diham? tin koiman alungin chihnale hetkhenna injong angaitopoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama vutna kivah ahin; lheplhahna lungthimin aheikon ahin, ahinna aman ahuhdoh theilouna dia kakhutjetna jou uma hilouham, atin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangma kalhacha nahi jeh-in vo Jacob, le Israel hichehohi geldoh-in; kasemsa nahin, kalhacha nahi, Vo Israel, nangma kasuhmil theihoi nahipoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keiman meilhang satah tobang nasuhkhelnaho le nachonset naho meibol tobang chu katheh mang tai; kahenga hung kile kitnin, keiman kalhatdoh nahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vo vanho hichu Pakai ahijeh-in la saovin; lei noilama umhon aovun; nangho mol ho, Vo gammang chule chua thingphung tinnin la san aodoh uvin, ajehchu Pakaiyin Jacob alhatdoh-in, Israel lentahle loupitah-in akichoi antai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakai nalhatdohpao naobu-a kona nagongtoh paovin hitin aseije, keihi thiljouse sema, Pakai achangseh-a vanho jahdoh-a, leiset phajaopa chu kahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi jouho melchihna imalou so-a, doi-aithemho ngolsah-a; michingho nungnokit na, ahetnao ngolna-a sosah-a;
  </para>
  <para style="p">
    <verse number="26" style="v" />Asohpa thusei sudetpa, asottol ho thumop molsopeh-a; Jerusalem jah-a nangho chenna ding ahin; chule Judah khopiho jah-a, nangho kasahdoh kitna, alhusa munho kaphoh ding kitding ahi atipeh-e.
  </para>
  <para style="p">
    <verse number="27" style="v" />Twithuh jah-a kangin, navadung ho jong kakansah kitding ahi tipa,
  </para>
  <para style="p">
    <verse number="28" style="v" />Cyrus jah-a, ama kakelngoi chingpa ahin, kadeijouse asuhbulhit ding ahi, Jerusalem heng jenga jong nangma, kisapha ding nahi tin, chule houin jah-a, na-inbul kisem phading ahi tipa chu kahi, ati.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin hitin aseije, athao nu Cyrus jah-a namtin vaipi a-anga sunem dingle, lengho konggah lhamkang ding, amasanga pehni kisuto kotpiho hongdingle, khahkit loudingin, akhut jetna katuh chahpa henga chun hitin aseijin;
  </para>
  <para style="p">
    <verse number="2" style="v" />keima namasanga chengting, akonlaiho kajansah ding; sum-eng kotpiho kavohchima, thih kotgol ho kasatkhen ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keima Pakai, namina nakoupa, Israel Pathen chu kahin, keima neihet theina dinga goukhol le munthipma kiselgu sumjong kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalhacha Jacob le kalhen chom Israel jala namin monga kakou nahi, nangin neihetlou vanga keiman kaminvo nahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keihi Pakai chu kahin, adang aumpoi, kei tailou Pathen dang himhim aumpoi; neihetlou vanga nakong kagahpeh nahin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Kei tailou adang aumpoi. Keima Pakai chu kahi, adang him him aumpoi, ti nisolama pat nilhum lam geija miten ahet theina diu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman khovah kagong doh-in, muthim jong kaseme, chamna kasemin, setna jong kaseme, kei Pakaiyin hitiho jousehi kabol ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangho vanho, chunga konin hung julhaovin, chule vandum hon chonphatna hinsunglhaovin, leiset kihonghenlang huhhingna sodoh-u hen, chonphat nato hung kedoh thaohen; keima Pakaiyin hichu kasem ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Asempa kinelpi chu ohe! ada ahi: beldengpa bel hal chu leiset bel hal to kinel hen. Bon nganin asempa henga, ipi sema nahim? ahiloule nathilbol chun aman khut kaneipoi tintem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Apa jah-a ipi hinga nahim? ahiloule anujah-a ipi nana hindoh hitam? tiachu ada ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai Israel mithengpa le asempaovin hitin ati, kachate chungchanga thil hunglhung dingchu neidongun, chule, kakhut natoh chungchang thu neipeuvin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leiset hi kasem ahin, achunga mihem jonghi kasem ahi, Kakhut ho-a vanho kajahdoh-a, janelho jong kathupeh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama chu chonphat na-in kakhou khah-in, alampi jouse hilinge. Aman kakhopi asahdoh-a, kasohchang ho alhadoh ding, kipamanle tohphat man thil peh-a ding ahipoi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakaiyin hitin, ati, Egypt tohgimna le Ethiopia le Sabea mite sumkolvei ho, misang tahtah ho chu naheng lama hunguva nanga hidiu ahitai. Nanung ahin juijuva, thihkhaova kihenpuma hung galkaijuva, na-anga bohkhup uva, chibai nabohdiu, nahenga lungsetna angeh uva tahbeh-in Pathen nangma-a aum monge, adang aumpoi, Pathen dang himhim aumpoi atidiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vo Israel Pathen, huhhingpa kisel thipbeh Pathen tahbeh mongchu nahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amaho jahchaova abonchauva kisudongdiu; milimsem amaho chu lungnoh phah puma lutkhom diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israel vangchu Pakaiya tonsot huhhingna-a huhhing-a umdiu ahin; nangho tonsot geija jahchalouva akhonna beija kisudong louding nahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu vanho sempa, Pakai, leiset sutoh-a, sema tungdohpa, aman agohkeo asem hilouva chenna dinga anagong dohpa Pathen amatah chun hitin ati; Keima Pakai chu kahin koima cha dang aumpoi,
  </para>
  <para style="p">
    <verse number="19" style="v" />keiman leiset munthim mun'a guhthimin thu kaseipoi, keiman Jacob chilhahte henga agohkeovin neiholun katipoi, Pakai keiman chonphatna kaseijin, thudih bou chu kaphondoh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangho namtin lah-a asohcha chengse kikhom munlang, hungun, hinnai cheh-un. Thing semthu milim tungdoh-a, ahuhhing theilou diu Pathen henga taoho, amahonla hetna aneipouvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Seipeh unlang hinpui naijun; thu kimopna chu sang uhen, masang laija patna kon aphondoh khah em? chulai apat kon nanahil um? Pakai keimahi kahilou ham? Pathen dihle huhhing-a Pathen dang aumpoi, kei tailou adang aumpoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Leiset kolkimvela mi jousen keilam hinveuhen lang huhhingin umuhen; keima Pathen kahin, koimacha dang aumpoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keile kei kaki hahsel in, kakama kona chonphatna thu potnachu hungkilekit louding ahi. Chutia chu khup jouse ka-anga dilsua, lei jouse kihahsel ding ahi,
  </para>
  <para style="p">
    <verse number="24" style="v" />dihtah-in min Pakaiya chun chonphat nale thahatna kaneije tin seijinte; ama henga mi hunga; ama douva lunghansah jouse chu jahcha ding ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israel chilhah jouse chu Pakaiya them changa loupidiu ahi.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bel chu akunin, Nebo chu abungin, amilim hou chu sahole aganchahou chunga aumuve; nathilpoh-u pohgih tah ahin, gancha thachol dinga pohgihsa ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amaho abungun, akuncheh uve; amaho pohgih-a chun ahoidoh pouvin, gal hinga kaimangin aumjo taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo Jacob insungle Israel insung amohchengse, ka-oisunga patna kavopma, naobu-a kona kapensah hon kathu ngaijun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nateh geija jong kei Ama chu kahin; nasamkan geija jong kapoh ding nahi; kasemsa nahin, chule keiman vop ingting kapoh-a; kahuh hingding nahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Koito kilo neisah uva, neikibah sah uva, neitekah uva, chule kakibah thei dinguham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho dipma kona sana anopnopma manga, dangka akitena-a kitedoh-a, sana khengkhat thalah-a; pathen akisemsah-a, a-anga bohkhup jia chibai bohjia ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon hichu aleng kou uva adomdoh uvin, apojiuvin, ama munna atungjiove, ama akitung denin; aumna-a konin akichon jitapon ahi. Ahi, min ama kou intin, amanla donbut theilou ding, agimna-a kona jong ahuhdoh theilou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo suhkhel neiho, hichehi geldoh-un; miho kimusah unlang lungin geldoh kitnun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khanglui laija thilmasaho geldoh-un, keima Pakai kahijeh in adang khatcha aumpoi, keima Pathen kahin, keitobang himhim aumpouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abula pat akichainagei, chule masang laijapat akibol loulaiho jong kaseiphong ahitai, kathumop ding jingintin, kanopchan kabolding ahitai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Solama kona vacha lol hattah khat gamlatah-a kona kathumopsa tongdoh dingpa chu kouvin; henge, kaseisa ahin, kagui lhunsah ding ahin, kangaitosa ahin boljong kaboldoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chonphatna-a kona gamla-a lungtah-a nanghon kathu ngaijun;
  </para>
  <para style="p">
    <verse number="13" style="v" />kachon phatna hi kahinpo naitan, hichu gamla talou ding, ka huhhingna jong umjing louding ahi. Kaloupina Israelte dinga huhhingna chu Zion'a kakoiding ahi.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo nungah theng chanu, hungkum lhanlang leivuilah-a touvin, laltouna aumpon, Vo Chaldea mite chanu; ajehchu nangma nouchetle nomsa kitikit talou ding nahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sumhei songho lanlang chang goijin napon lukhuh hoh-inlang, kengkeuvin umin, na pheipi hohdoh inlang, vadungho palgalkai jin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nasagohkeo chu khulouvin umintin; najamo kisel chu kimuding ahi. Phu langting, mihembanga nangma kakimupi louding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eilhatdohpao chu Israel mithengpa, janelho Pakai chu amin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chaldea te chanu thipbeh in touvin lang, muthima lutnin, ajehchu lenggam ho pakainu kitijom louding nahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamite chunga kalungsan, kagouloho kasuboh-in, amaho chu nakhutna kanapeluttai; nanginla hepina nanamusahpon; golluiho chunga napohgih tah namkoljon chu na-ngapkhum tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangin imatihchanna pakainu kahijing ding ahi nanatin; chutichun nangin hiche hohi nalunga nanakoi pon khonunga akichaina diujong nanageldoh him himpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun tun anop nopma uma, chavaitah-a chengnu, alungsunga keitailou adang aumpon, keibou kahin; meithai banga toulou ding kahi, chate thi thu jong hehih helinge, tia seinun ngaijin;
  </para>
  <para style="p">
    <verse number="9" style="v" />ahinla hiche thilni, chate thinale meithai hinahi nikhatsunga hetmanlouva nachunga hungchu ding ahi. Hicheho chu namitpheldoi ho tamjeh le, kilhim ngolna bulhin lheh jeh-a nachunga lhingsetna hungchu ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu nakhansetna natahsanin, koiman eimupoi natin ahi. Nachihnale nahetna in naheimangtan; nalungsunga keima kahi keitailou adang himhim aumpoi natin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh-achu thilse nachunga hungchua hi hoija hung kipan ahi nahetlouding; setna nachunga hungchu ding; hichu nasuhmang joulou ding; chule nahet loubeh ding manthah na nachunga hung chuphung ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun naki lhim ngolnale namitpheldoi themna tamtah, naneolaija patna nahinjilna chun naphat theipi jouva, najo thei khattou dingle dinpi tan,
  </para>
  <para style="p">
    <verse number="13" style="v" />nathumop tamjeh-in nacholtan ahi. Tun ahsi lekhathem ho, ahsi velhi jingho, lhatina khonunga hunglhung ding melchih themho dingdoh uhenlang, nachunga hung chudingho-a konin kihuhdoh sah-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Veuvin, amaho changpol bangbep hiuvintin; meijin akahvamdiu; meikong thahat na-a kona amahole amaho kihuhdoh loudiu; kisahlum nading mei-am tobang hilouva, amasanga tounangam mei tobang jong hilouding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangdinga naneolaija patna nasumkol veipiho, chule nanatoh gimpi amaho jengtah jong chutichu hintin, amaho khatcheh-a a-inlam cheh-a vahmanga, koimachan nahuhhing louding ahi.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Jacob insung Israel mina kivo-a Judah twiho-a kona sohdoh-a, Pakai mina kihahsel, thutah le chonphatna-a hilouva Israel Pathen min panho: hichehi ngaijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu amahole amaho khopitheng mi akihisah-un, Israel Pathen chunga akingaijui; ama minchu janel ho Pakai ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masanglai thilto chu abula patnin kaseiphongin; kakama kona sohdoh ho chu amaho kamusahtai; hiche ho chu kabol phunga guilhung jeng ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu nangma milouchal nahi ti kahen, na-ngong chu thih khao ahin, nachalpang chu sum-eng ahin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichu atila patna nahenga kaseija, ahung guilhun masanga kamusah nahitai. Achutiloule nangin kahou milim, alim semthu, kamilim kilhajolin abol ahi tikhan nate,
  </para>
  <para style="p">
    <verse number="6" style="v" />nanghon najataovin, hicheho jousehi namutaovin; chule naseiphong loudiu ham? tua patnin thilthah ho, thil kisel ho, nanghon nanahetlouho chu kamusah ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho tun akisemtai, abula patna ahipoi; najah masang nikho jongchu ahipoi; achutiloule nangin, veuvin, ken amaho kahei, tikhan nate.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahi, nanaja khapon, nanahe khapoi; hichelaija patchun nanakhang ana kihongpon ahi; tahsanlel nahin, naobu-a patna suhkhelnei nakiti dingchu kanahen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu kamin jala kalungsatna-a kakitima, eikipachat nading jeh-a nangma kasuhtana dinga kona kitima kahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vetan, keiman nangma kalhah theng nahitai, sum-eng bang hilouvin, suhgentheina meilhum sunga kalhah nahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keimajal leh keimatah jala kabolding ahi; Ajehchu kaminhi ibola suhboh a umding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Jacob le kakou Israel, kathu ngai phaovin; keihi amachu kahin; amasale anukhah jong kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kakhutnin leiset bul jong hi aphudoh ahin, kakhut jet hin vanho chu akaijala, amahochu kakoutengle dingdoh khom jengjiuva ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangho nabon chaovin kikhomun lang ngaijun; hiche thil ho hi alah uva koipenin aphondoh khah em? Pakaiyin ama alungsetnin; aman Babylon chunga anopnop abolin, akhut chu Chaldea miteho chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei, keimatah mongin kasei ahitai; amachu kakouvin; kahinpuijin, aman alampi akhantousah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nanghon neihin naijun lang hichehi ngaijun; atila patnin keiman guhthimin thu kaseipon; phat aumtila patnin hia chun keima kaumin; chule tuhin Pakai Pathen le alhagaovin eisoltai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai nalhatdohpao Israel mithengpan hitin aseije, keihi Pakai na Pathen, naphatnadiuva hila, nachenadiu lampia puihoipa chu kahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo nanghon kathu peh ho chu nangaiju hitavele! nachung uva chamna vadung banga longa, nachon phatnao twikhanglen kinong bang hitading!
  </para>
  <para style="p">
    <verse number="19" style="v" />Nachilhah-u jong neldi jat phantin, nalaigilgao sonho jong nel bongsilsel bang ding, kamasanga kona aminu kithai mang louding, suhtanga jong umlouheldiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Babylon'a konin potdoh-un, Chaldea mite-a konin jam mangun, hichehi lasah ginnin phongjal unlang, leiset kolkimvel geijin seiphongun, Pakaiyin asoh Jacob chu alhatdohtai tiuvin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman nelgam jotpaija apuilaijin adangchah pouvin; songpi-a konin amahodin twi alondohsah-in, songpijong akesah-in, twi chu ahung kikhodoh jengin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakaiyin migiloute dingin chamna himhim aumpoi, ati.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo twikol gamho, kathusei ngaijun; gamlatah-a konin miten ngaijuvin; Pakaiyin naobu-a kona einakouva; kanu oisunga kona kamin anasah sa ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman chemjam hemtah bangin kakam anasemin; chule aman akhut lima einaselin, thalchang kinot dulin einasemin, alivathei sunga einaselin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kahenga, Vo Israel, nangma kalhacha kaki choi-atna dingpa chu nahi anatin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin keiman, mohseh-a tonggima kahitan, kathahatna imacha hiloule mohseh-a kaman ahitai. Hitajongle kathutana chu Pakai toh um ahin, kathilbol chu Pathen to uma ahi, kati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule tun Israel chu anakikhom khomlou hitajongleu, naobu-a patna alhacha-a pangdinga einagonga, Jacob chu ahenga hinlepuikit dinga, Pakai mitmu-a keima loupinalai dingle ka Pathen chu kathahat hidinga einagongpa Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman Jacob phungho tungdoh dingle, Israel vetupma lepehkit dinga kalhacha-a napanding chu thil jangkhaicha ahi, ati. Leiset kolmong geija nangma kahuhhing nahiding, chidang namdangte salvahna dingjong kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tahsan umtah Israel lhatdohpale, amithengpa, mite i-sah loupa, namtin hotbolpa, vaipoho sohpa henga chun Pakaiyin hitin aseije; Tahsan umtah Pakai Israel mithengpa aman nang nalhendingjehin: lenghon amuteng thoudohdiu, leng chapatenjong chibai abohdiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin hitin aseije, lahphat chan natao nao kangaijin, huhhing nikhon nangma kapanpin, chule nangma nahongbit ningting, Leiset tungdoh dingle goulo kamhelsa gam lodinga miho thulhun hidinga kapeh ding nahin;
  </para>
  <para style="p">
    <verse number="9" style="v" />chutia chu sohchangho jah-a potdoh taovin, chule muthima umho jah-a hungkilahdoh un natiding ahi. Lamdunga kivah-untin, munsang jouse-a alhatlenao mun umding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho gilkel dangchah talou ding; alumle nisanjong akahnat loudiu ahi. Ajehchu ahepi paovin puihoi jintin, twisam putna pang dunga apuilediu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule kamolsang jouse lampin semingting, kalamlhongho kadop sang ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Veovin, hiche hohi gamlatah-a kona hungdiu ahin; chule vetan, hiche hohi sahlamle lhumlama kon; chule hiche hohi Sinim gama kona hungdiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo vanho; kipala saovin; Vo leiset, thanomin umin; Vo molsang ho awthong jeju-a lasahnan pohjah-un. Ajehchu Pakaiyin amite alhamonin, akibol gentheinao chunga ahepiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla Zion'in, Pakaiyin eidalhan, ka Pakaiyin eisumil tai, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Numei jin anao noicheplai asuhmiljouva, ataijola peng achapa lainat louva umthei dingham? henge, amahon sumil theijunte, hijengjongle kenvang nangma kasuhmil louhel ding nahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ven, kakhut phang chunga kasemdoh nahin, nakulbang ho kamasanga aumjinge.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nachate chu ki kino uvintin; nasumanghole panabeija nakoi houchu nanga kona potdoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khoda-in lang nakimvel vetemin, hiteho jousehi akikhom khomun, nahenga ahunguve. Pakaiyin keima kahingjingnai, nangin amaho jousehi thonlouhela kijepna-a naneiding, mounu kijep banga nachunga kijepna-a nanei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu mun ongle namun kamhelsa ho, chule namanthah nao gamhochu tu-a chengho dinga chu neo behseh ding ahin, chule naval lhum hou chu gamlatah-a kitolmangdiu ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adangho namansah nunga nacha nahin dingho chun, munhi kadingin aneubehseh-in, kachenna ding mun neipen tia nanakhanga aseikitdiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuteng nangin nalungsunga, kon eihinpeh hitantem? Kachatela kachan joutan, akamhela kahin, sohchanga suhle tunga kichonlea kahilouham? vetan, kachang seh-a eikidalha-a, amahohi hoija anaum hiuvintem? natiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai Pathen'in hitin aseije, veuvin chidang namdangho chunga kakhut kadopsanga, miho dinga kaponlap katundoh ding; chule amahon nachapateo akhutnuva ahinpuijuva, alenguva nachanuteu ahinkitot dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lengho chu nadontup uva pate hung hiuvintin, chule lengnu ho jong chu nadontup nu-u hiding ahiuve. Amaho na-ang uva amaiju tolam ngatna bohkhup uva, nakenga leivui ahinle ngimdiu ahin; chutia chu keihi Pakai chu kahi ti nahet jengding ahi. Ajehchu keima eingah ho chu jahcha louhel ding ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihatpa-a kona anehban kilahpeh theija, ahiloule dandih-a gal hinga kikai chu, sohchathei ding ham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin Pakaiyin hitin aseije, sohchang mihat tahho jeng jong kilamanga, gin umtah nehban jong kisalhah peh ding ahi. Ajehchu nangma kinelpipa chu kinelping ting, nachate chu kahuhhing ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule nangma sugenthei hochu amaho tahsa tah-a kavah-a, ju lhumtah banga amaho thisantah chu adonkhamdiu ahi. Chutengle tahsa hing jousen keima Pakai chu nahuhhingpa, nalhatdohpa le Jacob mihatpa kahi ahetdiu ahi.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin hitin, ati, nanu kadana lekha chu hoija umtam? ahiloule kalei-bapa koipen koma kajohdoh nahiuvem, veuvin nakhangitlou jeh uva nanghole naho nakijoh uva, chule nasuhkhelnao jeh-a nanu kida ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ipijeh-a kahunga chu pasal khatcha naum lou uham? Kakouva chu eihouding khatcha umlou ham? Kakhut hin mi ahuhdoh lelhel nadinga kisuchoma ham? veuvin, twipi kaphoh-in agohelin, vadungho chu gamthip kasosah-in, anga'u hochu twi beijeh-in a-uijin, dang chah-in athiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman vanho avomin kajemin, akhunaovin khaodip pon kaseme.
  </para>
  <para style="p">
    <verse number="4" style="v" />Athachol ho chu aphatcha thukhat seipehje kahetnadin Pakai Pathen'in seithemna lei eipen; jingseh-in eisukhangin mithem banga ngainadin kakol avansah-e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai Pathen'in kakol eihonpeh in, kahuhelpon, kakinung heikit tahih helle.
  </para>
  <para style="p">
    <verse number="6" style="v" />Katungtun mivoho kadopeh-in, sambot ho kabengteni kadopeh-in, jachatnale chil setkhuma konin kamai kaselpoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Pakai Pathen'in eipanpin tin, hijeh chun kisudong ponge. Hijeh chun kamaihi meituh song bangin kadon, jachatna kato louding chu kahei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Them eichan sahpan einaije, koiham eikinelpi dinga? Eiho dingkhomu hite; koiham eikidoupia chu? kahenga hungnai hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vetan, Pakai Pathen'in eipanpi ding ahin; themmo eichan dinga amachu koiham? Veovin, amaho abonuva pon banga chuldiu ahin, ngetnin aneh chaidiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nalah uva Pakai ginga alhachapa thusei jopma, muthima vahlea, vah himhim neilouva chu koiham? Pakai minchu tahsan henlang, a-Pathen chunga kingaihen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Meisel de-a meisia kiumkim vel nangho jouse; nameivah-ule nameisel detnu mei sipahlah-a chun vahleuvin. Hichehi kakhutna namudingu chu ahin, lungkham tah a nalup dingu ahi.
  </para>
  <chapter number="51" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chonphatna nung juija Pakai holte nanghon kathu ngaijun; nakikhendoh nao songpile nakilaidoh nao kokhuh lamchu veuvin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Napao Abraham le nahingu Sarah lam veuvin; ajehchu achang seh-in kakouvin, phatthei kanaboh-in kapunsah-e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pakaiyin Zion lhamon nintin, amunthip jouse lhamon inte, agamthip chu Eden bangin semintin, chule aneldigam chu Pakai hon bangin semintin, asunga chu kipanale thanopna, thangvahnale la ngei gin kijading ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamiten kathu ngaijunlang, Vo kanam mite nanakhang hinsung uvin; ajehchu keija kona danthu hung kondoh-a, mitin salvah dinga kathutan na chu kakicholdo sah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kachon phatna nikho ahungnaijin; kahuh hingna apotdohtan, kabantenin mitin thu atanding; twikol gamhon eingah untin, kabanna hi atahsan nao angap dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Van lama khodah-un lang, chule noilam leiset chung hinveuvin; ajehchu vanho chu meikhu banga jam manga, leiset hi ponsil banga chulding ahin, chutobanga chu asunga chengho thidiu ahin, kahuh hingna vang atonsotna umjinga, kachon phatna kisumang louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chonphatna he-a alunga kadanthu he-ah nanghon kathusei ngaijun; mihem seiset ginghih-un, ahousetnau jong kicha hih helun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu ponsil banga amaho ngetnin aneh uva, samul banga lungin anehdiu ahin, kachon phatna vang a-imatih chana uma, kahuh hingna akhang akhanga umding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />O Pakai banjang; Khangin, khangin, thahat na-in kivonin; masanglai nikhole khanglui laija bangin khangin, Rahab sat na, Dragon mavo-a chu nang nahilouham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanghi twipi thuh nasatah twikhanglen kansah-a, lhatdohsate galkai nadinga twikhanglen thuhtah laija lampi sema chu nahilouham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh-a chu Pakai lhatdohsate hungkileuva, lasahpuma Zion lama hungdiu, aluchung uva tonsot kipana chu umding ahi; amaho kipanale thanopna chang-un tin; lungkhamnale lunghemna jam mangding ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keima, keimong monghi nangho lhamon na chu kahin; athiding mihem, hampa bangbepma kisem mihem chapa kichading koi nahiuvam;
  </para>
  <para style="p">
    <verse number="13" style="v" />Vanho kijaldoh sah-a, leiset bul phutdetpa, nasempa Pakai na Pathen sumila, suhmang dinga nanago jing misugenthei pa lungsatna jeh-a niseh-a tanglouva kichajing nang koi nahim? Misugenthei pa lungsatna chu hoiba hitam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Kokhuh sunga athilouna dingle anehjong alhahsap lounadingin, gal hinga kikaimang chu lhadoh-a aumna din ama akinon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla akinong ginglellul twipi homkhenpa Pakai na Pathen chu kahin, kamin janelho Pakai ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vanho kaphudetna, leiset bul kavui detna, Zion henga nangma kamite nahi kati theina din, kathuho nakam sunga kakhumin, kakhut limmin nangma kakhu khumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai khutna alungsatna khona dona, vo Jerusalem, khangin, khangin, dingdoh-in, kichat jeh-a kitihona khona kon aningkai geijin nadonin, nadon kang hele.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amanun ahindoh chapa jouse lah-a, amanu puihoi ding khatcha aumpoi; ahin vahdoh chapaho jouse lah-a jong akhutna akaile khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche thilni hin nahin lhunkhum ding ahin, kon nalungkham peh tantem? Gamnale suhmangna, kel lhahna le chemjam; koijin nang nalhamon tan tem?
  </para>
  <para style="p">
    <verse number="20" style="v" />Nachapate alhadah taovin, gam bongchal len thanga oh bangin khosung lamlen laija alumchap mun; amaho Pakai lungsatnale na Pathen'u phosalna dimset changa ahitaove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun tun lengpitheija hilouva, suhgentheina-a khampan hichehi ngaijin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai na Pakai, amite thu seitohpeh-a na Pathen chun hitin ati, vetan, lamvaina khonle, kalungsatna ningkai khontah chu nakhutna konin kaladohtai; nadonkit tahlouhel ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla nahinna jah-a, nachunga kache theinadiuvin bohkhupmin, tia nasugenthei ho khutna chun tollhang bangle kholai lamlen bangin nachunga lamjot ho dingin natahsa nadotan ahi.
  </para>
  <chapter number="52" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khangin, khangin, vo Zion nathahatnin kivonin; Vo Jerusalem, khopitheng navon hoijin kivonin; ajehchu tua pat cheptanloule aboh nasunga lutlou hel ding ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo Jerusalem, leivuija konin kithing ngimin, thoudoh-in lang, toulhan. Vo sohchang Zion chanu, nangonga nakihenna khaoho-a konin kisut lhamin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pakaiyin hitin ati, ima hilouhel dinga kijoh nahiuvin, sumbeija kilhatdoh ding nahiuve, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakai Pathen'in hitin ati, masangin kamite Egypt'a khopemdin anachesuh uvin; ajeh beijin Assyria ten abol gentheijun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun tun Pakaiyin aseitai, hikoma hi keiman ipi kanei tah-em? Kamitela ima hilouhelin apuimang taovin, achunguva vaipoten la apensahsah uvin, chule ka min jong niseh-in tanglouhelin ataitom jinguve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun kamiten keima min heovintin; hicheni chule amahon thuseipa chu keima kahi hetaovinte; veuvin keima kahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Molsang chungho-a kipana thupha pole pa kengphang chu iti hoi hitam? chamna thu phongle; thupha-a kipana thupha pole-a, huhhingna thu phonglea, Zion henga, na Pathen alengchang tai, tia seilepa chu!
  </para>
  <para style="p">
    <verse number="8" style="v" />Khopi ngahhon aw sangtah-a asapdohdiu ahi: thakhat tah-a penga la asahdiu ahi; ajehchu Pakaiyin Zion ahinpuikit tengle amitcheh uva akimudiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jerusalem mun kamhelsa ho thanomun lang, kipa la sakhom un, ajehchu Pakaiyin amite alhamonin Jerusalem alhatdohtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakaiyin abantheng chu namtin jouse mitmun agohkeo ahisah-in; chule leiset kolmong jousen i-Pathen nu mihuhhing na amudiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Potdoh-un, potdoh-un, hiche-a konin chedoh-un lang, thilboh tongkha hih-un; alah-a konin potdoh-un, Pakai manchah ho choija nangho kisuthengun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu kintah-a, napotdoh loudiu, jamtho-a jong nache louheldiu, ajehchu Pakai nama sang uva chentin; Israel Pathen'in nanungu adelding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vetan, kasohpan chingthei tah-in bolintin, ama choi-at le choisanga uma, sangtah-a umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mitam tah-in adatmou bangin, amaiso mihem dang jouse-a sangin ase-in, chule apendan amelput mihem chapate ngaija sangin suhmelsetnin aumin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutia chu aman namtin vaipi tamtah athe khuma; ama chungchanga leng hon akamu akisip dingu ahi. Ajehchu akihil khahlouhelu amuva, ajahkhah louhelu jong agelthem dingu ahi.
  </para>
  <chapter number="53" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kathulhut nu kon atahsana? Pakai bantha koihenga kilah-am?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu ama amasanga chun hamdong kehthah bangle leigo-a ajung kikhodoh bangin hungkhangdoh-in tin, aman limle melhoina himhim aneipon, ideina diu hoina himhim aumpon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama chu mihemte nahsahmole paidoh-in aumin; lungdon le lung genthei he mi ahin; eihon ama-a konin imaiju ina selmangun, amachu nahsahmon ana umin, eihonjong ina gelsangdeh pouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Atahbeh-in aman ilungkhamnahou apon, chule ilung gentheinahou apotai, ahinla eihon aki engbol, Pathen vohle sugentheijin ingaitouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla ama eiho suhkhel jeh-in akimavon, eiho khangitlou jeh-in akisugepmin, eiho lungmona dingin gimbolna chu amachunga achutai. Ama kijepna chun eidamsah taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Eiho ibon chaovin kelngoi bangin ivah mangun, eiho amitakip inop nalam cheh-a ikiheijun, ahin Pakaiyin eiho khangitlouna jouse achunga angamtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama akisugen theijin, ama akibolgimtai, ahijeng vangin ama akamkapoi. Ama thadinga kikai kelngoi bangin akaijun, kelngoi amulvouho anga athipbeh bangin chutichun akamkapoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama sohchan nale thutan na-a konin akilamang tai. Kon ama khanggui thu asut thei dingham? Ajehchu ama mihing gama kona kisumanga ahitai. Ajehchu kamite suhkhel jeh-a ki-engbola ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman hunamin ima abolpon, akamin jong lheplhahna thu khatcha aseikhapoi; aman alhankhuh chu migiloute-a toh asemgomin, athi-a chun mihaopa toh aumkhom me.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitajongle suhgep dingchu Pakai lunglam chu ahitan; aman natna athohsahtai. Nangin ahinna chonset thilto-a nasemtengle, aman achilhah kimuntin, anikhoho asaosah ding, Pakai lunglhaina chu akhutna khangtou ding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman ahinna thohgimna chu amua, lunglhai ding ahitai. Aman agitlounau apohpeh dingjeh-a kasohdih tah chun ahetna-a mitamtah them achanding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu keiman amachu milenhotoh chan kahop peh-a, aman mihat ho chu thil kichom akihoppi ding ahi. Ajehchu aman thina geijin ahinna abunglhan ahi. Chutichun ama suhkhel hotoh akisimthatan; mitamtah chonsetna apon, achonkhelho dingin ataopeh-in ahi.
  </para>
  <chapter number="54" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo achinga chaneilou nun kipah-in la san lang, hatah-in samin; naosonat thohkhalou nu nangma, ajehchu jineiho chate sangin achingnu chate atamjoi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Napon in mun kehlenin lang, chule nachen detna pon in chungchu kijalsah-in, khen neilouvin nakhao chu saosah-in lang, chule ahenna mol ho chu khendetnin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu jetle veija kithejah intin, nachilhah hon chidang namdangte chu louvintin, khopi gamho chu chenna-a aneidiu ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kicha hih-in; ajehchu najachat louding, nakisuhdong louhel ding ahi. Ajehchu naneo laija najachatna nasuhmila, na meithai nahsah louva aumna chu nageldoh kit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu nasempa chu najipa ahin, janelho Pakai chu amin ahi. Nalhatdohpa chu Israel mithengpa ahin, ama chu leiset pumpi Pathen kitiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu akidalha lhagaova lungnatah neogol ji kideitalou numei khat tobanga Pakaiyin nakoukit ahitai, tin na Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Phat chomcha dinga kadalhahsa nahitan, ahinla hepina lentah-a kakhopkit ding nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungkhamna neochakhat jeh-in mitphehkah louvin nanga kamai kanaselin, ahinla tonsot khotona-a kahepi nahi, tin nalhat doh-a Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu keidin hichu Noah nikho tobang ahi, Ajehchu Noah twi chun leiset achupkit louding ahitai, tia kahahsel bangchun nachunga lunghangkit, phohsal kit taponge tia kaki hahsel ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu lhangho kitoldoh-a, mol ho kitolmang ding ahin, ahinla kakhotona chu nanga kona kitoldoh louding; kachamna jong nanga kona kichondoh louhel ding ahi, tin, nahepi-a Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo nang bolgenthei khopi hui mutlon lele, lhamong lou, vetan, nasongho chu ajemhoija kaphua, na inbul chu saphir songa kaphu detding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nabangkot ho song sandang, chule nakotpiho song santhip, chule nagamgi jouse song hoitah-a kasemding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nachate jouse chu Pakai hildoh hidiu, nachate chamna chu nasatah hiding ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chonphatna-a naki phudetna, suhgentheija kona gamlatah nahiding ahi. Ajehchu tijatna-a kona nakichat louding ahi. Ajehchu hichun nahin nailouding ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vetan, amaho kikhom khom teidiu ahin, keija konvang hiloudiu ahi. Nangma douna-a kikhom chanchu nangma vanga lhudiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vetan, keiman pummeija meihol japma, thihkhengpa anatoh nading manchah kikhendohpa chu kanasem ahin, asumang ding thilsumanghelpa jongchu kanasem ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma douna-a galmanchah kigon ho chu lolhing louding; chule thutan na-a nangma douva leigui takipchu themmo nachang ding ahi. Hichu Pakai sohte goulo ahin, achonphatnao chu keija ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="55" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khaije, adangchah channin twiphung hinjon hen, chule sum neilou chan hungun lang kichoh-un, chule neovin; henge, hungun, lengpitwi le bongnoi sum beija manbeijin hung kichoh-un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ipijeh-a changlhah hilouva sum nasuh manguva? chule van'a louhella natohgim uham? Kaseihi lunglut tah-in ngaijun, nanghon apha chu neuvin, chule nahinnao chu thaona-a chun kipah hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanakol-u hinsungun lang kahenga hungun; ngaijun, chutile nahinnao chu hing ding ahi. Chutile David kihepina tahbeh chu naheng uva tonsot kitepna-a kasem ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vetan, miho dinga hettohsah hidingin amachu kapen, miho dinga lamkainale thuneina amachu kapei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ven, nahetkhahlou namkhat kouvin natin, Pakai Pathen vangle Israel mithengpa jala nangma hekhalou namhochu nahenga hungjam diu ahi. Ajehchu aman nachoi-at ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mutheija aumpetnin Pakai chu hollun, nailama aumpet nin amachu kouvun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migilouvin alampi dalha hen chule chonpha loupan alungngaito dalhahen; Pakai hengle i-Pathen'u henga hung kilehen, chutile hepina changa chamkimtah-a ngaidam hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ijeh inem itileh kangaito hohi nangho ngaito ahipon, nalampi hou jong kalampi ahipoi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu leiset sanga vanho asanjoh bangin, keima lampiho jong nangho lampi ho sangin asangjon, chule keima ngaito hojong nangho ngaito ho sangin asangjoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu gotwi le buhbang van'a kona ahunglhah-a, chunglama kilekitlouva, leiset achapnou joh-a thil akedohsah-a chule amumdohsah ahin, muchi thepa muchi-a apeh nadingle, anneh-a hingpa changlhah apehnadinga ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kakam sunga kona potdoh thuchu chutiding ahin, hichu agoh-a hungkile louhel ding, kadeichu asuhbulhitna, kasolna thilla chu lolhingjo ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu kipah-a kondoh a chamdela nakipuidoh diu, molle lhanghon namasanguva penga la asahdoh jenguva, chule loujaova thingphung jousen khut abehcheh diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lingthing khella chahthihg kehdoh-a, khao lingnei khella lenmuipah phung kehdoh ding, chule Pakai dinga minphatnale suhtan hi louhel ding tonsotna melchihna ding chu hiding ahi.
  </para>
  <chapter number="56" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tonsot Pakaiyin hitin ati, thukitan chu nit uvin lang, adih chu bollun; ajehchu keima mihuhhing na hunglhung loiding ahitai, chule kachon phatna hungkiphong doh ding ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche bolpa hi anunmon ahi; mihem chapa hiche tuhchah jingpa; suboh louva cholngah nikho nitjingpa, chule akhut thilse bolna-a kona tuhtang jingpa chu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamdangmi chapa, Pakai to kijop matsa chun Pakaiyin amite-a konin eichom khomheltai tin seida hen, nukiso jongchun, vetan, keima thinggo kahitai tin seidahen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakaiyin hitin aseije, nukiso keima choldo nikho jouse nitjinga, kalungdeilam kilhenna, chule kakitepna tuhjingpa chu;
  </para>
  <para style="p">
    <verse number="5" style="v" />keiman amahotah chu ka-insungle kakulbang sunga munkhat, chapate le chanute sanga phajohel munkhat le minkhat kapeh ding ahi. Keiman amaho amangkit louheldinga tonsotna umjing ding min kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gamdang mi chapate Pakai toh kijopmat ho, ama jenna dingle Pakai min ngailutna dinga, ama soh hidinga, choldoni suhbohlouva nitjinga, chule kakitepna tuhchah chanjong chu;
  </para>
  <para style="p">
    <verse number="7" style="v" />amaho ngei chu kalhangthenga kapuija, kataona insunga kipana kadimsah ding; agovam thiltohoule akithoina houchu ka maicham chunga sanpeh hiding ahi. Ajehchu ka-in chu mijouse dinga taona in kitiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel kinodohho chomkhom Pakai Pathen chun aseije, ahenga kichomsaho tailouva, adangho jong ahenga kachom khombe nahlai ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Loujaova gamsaho jousen hungne jouvun; ahije, nangho gam manga gamsaho jousen jong hungneovin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Akhongah hou chu mitcho ahiuve, ima heloucheh, abonchauva uicha hamma hamtheilou, mijong haptheilou cheh ahiuvin; lumma ihmunom ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahi, amaho chimtih neilou uichalop le hetkhenna neitheilou kelngoiching ahiuvin; abonun achennaova koncheh-in, ama deilam chehle aphat chomna dingcheh akivet taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon, hungun keiman lengpitwi galangting, khamnatheija idimsoh diu ahin, jing jongkhu tuni tobang hintin, nengjocheh ding ahi, atiuve.
  </para>
  <chapter number="57" style="c" />
  <para style="p">
    <verse number="1" style="v" />Michonpha amangthah jin, koiman lunga akoipoi. Mihepiho akipui mangin, thilphalou hunglhung dinga kona michonpha kipuimanga ahi, tin koiman agelpoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama chamna-a lutnintin: amaho ajalkhun uva choldodiu, ama dihsahna-a lamjotcheh ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho gaothusei them chapate, mijigem le mijong sonho hilama hungnai jun,
  </para>
  <para style="p">
    <verse number="4" style="v" />koi douna-a golsehbol nahiuvem? Koi douna-a kamka-a leilha doh-a nahiuvem? Nangho suhkhel neiho chate, mijouho son nahi lou uham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Thing hing phung noi tina milim hotoh Nachon thanghoi juva, phaicham dunga songpi khikeh ho noija naosen ho thatgama nahilou uham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Vachadung song jolpet ho lah-a nachan aumin; amaho, amahotah chu navang chan ahin, amaho hengtah-a chun donding thilto nalhei lhan anneh thilto natohji-e. Hicheho-a hi lhamon na kamu ding ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangin munsangle molsang chunga najalkhun nadon; chulamtah-a chun ganlhaina tohdingin nakaltouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kot hole khomho nunglama chun naki melchihna natung doh-e; ajehchu keisanga achom nahi chu nangle nangin neikhe doh-in, nakaldoh-e. Nangin najalkhun nakeh lenin amahotoh kitepna nasemin ahi, nangin nagahmu ajalkhun hou chu nangaichan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nangma lengpa henga nuding thao nachoijin nachen, nanamtui behseh-in, chule nasottol gamlatah-a nasolin, thikholkhul geijenin naki suneme.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nalampi saojeh-in nachol lhehtai, ahinla nangin kinepna aumpoi natidehpoi. Nangin nakhutna hinna nakimutai; hijeh chun nalungkham poi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule koi nakichat na ahiloule naginna jou nasei hija, keima neigeldoh louva, nalunga jong koilouva nahim? sottah kathipbeh hilou hija neigin louhel ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Nachon phatna le nanatoh phongdoh inge, ajehchu hicheho chun phatchomsah ponnate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nakatengle naloihon nahuhdoh-u hen; ahinla amaho abonuva huijin alhohmang gamuva, mohseh-a alenmang pidiu, ahinla atahsan keija ngampan bou gamsung chu aneija, kalhangtheng chu aloding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule sepsangun, sepsangun, lampichu semtoh-un, kamite-a konin kipalna bul ladoh-un tinte.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu tonsot munlo-a asangle chungnung pen amin atheng chun, hitin aseije; keima munsangle mun thenga cheng kahi, lhagaova lungnempa suhal dingle, chonset lungkham pipa lung suhhalna dingin, chonset lungkhampipa le lhagaova lungnempa kachen khompi-e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu tonsotnin doujing pongting, lungjong lunghang jingponge, ajehchu kasemsa lhagaole hinna chu kamasanga hungthon getnunte.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu akhangit louna kilosetna-a chun kana lunghangin, kanavon ahi; kamai kasela kalunghan ahin, amachu alung gotna lampia seingailou hella chepeh-a, ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman alampiho kamutan, kadamsah ding ahi, ken amajong chu kapuija, amale alhaset piho chu lhamona kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiman kamsung ga chu kasem ahin, gamlatah-a umpale naija umpa henga chamna, chamna umhen, keiman ama kadamsah ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla migilouho chu twikhanglen kinong tobang ahiuvin, aumthimbeh louteng bonlhohle bohse jong anuhdohjin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka Pathen chun migilouho dinga chamna himhim aumpoi ati.
  </para>
  <chapter number="58" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khenlou helin ging tah-in kho samin, sumkon bangin na aw sansah-in, kamite suhkhelnale Jacob insung mite chonsetna chu musah-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chonphatna bolla, a-Pathen chondanho dalhakhalou namkhat tobangin, amahon nitinin eihol holun, kalampiho hetding anomuve. Amahon thutah chondan ho angeh jiuvin, Pathen hinnai dingjong athanomun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ibolla an ka ngolule neimupeh daova, ibola kahinnao kasuh gentheijule neihetpeh daoham? atiuve. Veuvin, na-anngol niuchun nopsahna naholun, namigoihou jouse nabolseuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Veuvin, nanghon kinahnale kinelnan, chule gitlouna khut tuma kisuhto nan an na ngoluve. Chunglama na aw kijahna dinga, tunia banga hi an na ngol loudingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman kalhen chu hitobang an ngol hi hija ham? mikhatnin ahinkho asuhgentheiding nikho chu hibanghi hia ham? Lekha phaipheng banga alu kun-a, anoija khaodip pon le vut pha chu an ngol kiti theija ham? Chule hichu Pakai dinga santhei nikho hiding hinam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman kanalhen an-ngolchu hitihi hilouham? Khansetna-a kikanho lhaplhah ding, pohgih poho doplhah ding, suhgentheija umho jalensah ding, namkoljon tincheng suhboh dinghi hilouham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Agil kelho nachanglhah nahoppeh-a, genthei inna kon kikaidoh ho na-inna napuilut ding hilouham? asagoh-a um namuteng pon nasilpeh-a, nangma tahsa tobang neiho-a kona nakiselmanglou chu hilouham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutengle jingkah bangin navah kikhodoh-in tin, nadamtheina gangtah-in hung kilang doh-intin, nachon phatna namasanga chentin, Pakai loupina chu nanungdal hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuteng nangin kouvin natin, Pakaiyin nahouding, nangin samin natin, aman hikoma kaume atiding ahi. Nangin nalah uva kona namkoljon le khutjunga kikotona, chule pannabei thu kisei nalah manga;
  </para>
  <para style="p">
    <verse number="10" style="v" />Nahinna chu agilkelte henga nabuh lhah-a, akibol gentheiho nalung lhaisah leh, navah chu athimlah-a vahdoh intin, navela muthim jong sunlai bangding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pakaiyin tanglouvin puijin natin, nahinna chu gamgo laija jong lunglhaijintin, naguho athaosah ding: nangma twi kichapnou jing honsung bangin natin, twinah banga atuichu kanglou ding ahi,
  </para>
  <para style="p">
    <verse number="12" style="v" />chule nangma-a hidingho chun munsesa luiho chu sephaovintin, khang tamtah-a inbul kiphut chu natundoh ding ahin; nangchu aselai semphapa, chena ding lampiho semphapa nakitiding nahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangin nakeng chu cholngah nikho kanitheng ni-a nadeilam bolna dinga kona naheimanga; cholngah nichu kipani nati-a, Pakaiya atheng chu ja-uma nagela, ama najabola, nangma nopna lam bolouva, nangma nopsahna dinglam holouva, nangma thu seilouva na-umle:
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakaiyah kipah-in natin, leichung munsang ho-a chun tousah ingting; napa Jacob gou lo-a chu kavahding nahi. Ajehchu Pakai kamin hichu aseidoh ahitai.
  </para>
  <chapter number="59" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veuvin, Pakai khutchun mi ahuhhing joulou dingin akisuchompon; anakhang jong kho ajah theilouna dingin angong hih hele.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla nakhansetnao chun nanghole na Pathen'u kikah-a nachomkhenu ahin, nachonset nao chun ajahlouna dinga nangho-a kona amai asel ahibouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nakhut hou thisanna, chule nakhut junghou khansetna-a kisuboh-ah ahitai; namuh-un thujou aseijin, naleigui uvin jong thukaleh jeng asodoh jin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Koiman adihtah aseipon, koima thutah dinpi aumpoi. Amahon ahomkeo atahsanun, thujou aseijuve. Amahon umchan phalou avopmun, khansetna ahin jiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon gulse tui a-opkeuvun, maimom pan akhongjiuve; hiche tui nechanchu athijin, akikhedoh penpen chu gulse-in akeujiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amompan ho chu ponsil sohdoh louding, athilbollu chu kihuina anei louheldiu ahi. Athilbol hou khansetna thilbol ahin, hunam thilbol chu akhutnuva um ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Akengu thuphalou lama alhaijin, amaho thisan sonan akinojiuve. Angaitou chu suhmangna ngaito ahin, alampiuva gamnale manthah na aumme.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amahon chamna lampi ahepouvin, achele naova thudihtah aummong mongpoi. Amahon lampikon akisemun, chua che chanchun chamna ahet loudingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun thutah chu eihoa konin agamlan, thudih-in jong eipha joupouve. Eihon khovah ingah-un, ahinla muthim akimui, khovah khelin muthim lah joh-a ivahle taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keihon mitcho bangin bang kachulun, mit neilou bangin kakimai lele uvin ahi. Janlai bangin sunlai tah-in kakipalun; mithiho bangin mungemsa laitah-a kaum jiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vompi bangin kakitum letlut cheh-un, vakhuho bangin lhasetah-in kamao mao-uve, thutanna kangah-un, khatcha aumpoi. Huhhingna kangah-un, keiho-a kona gamlatah ahijoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu kakhangit lounao namasanga apungcheh cheh-in, kachonsetnu hin eiphochen jiuvin ahi. Ajehchu suhkhelna hoto kaum khomun, kakhan setnao dolchu kakihetnun ahi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai douna-a chonkhelnale thujouva, ka Pathen uva kona chemangin, suhgenthei nale kidouna thuseijin, jouthu kalunguva kavopmun, kasodoh jiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule thutanna chu akinung chonin, thudih chu gamlatah-a adingtai. Thutah chu lamdunga alhupan, adih chu alut joutapoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahi, thutah chu athonjin, aphalouva kona kikangse chu anchah-in apangjitai. Hichu Pakaiyin amun, thudih tanna himhim umlou chun alung phamotan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin mi aumlouhel chu amun, midinga taopeh abeihel chu adatmo lheh-e, hijeh chun abantenin huhhingna apohpeh-in; ama chonphatna chun adinsahtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichechun aman chonphatna ompho bangin akivonin, alua huhhingna lukhuh akhuh-in, phulahna ponin akivonin, tompanna chu sangkhol chollin aki ah-e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anatoh-u dungjuijin kibang tah-in lethuh unte, akidoupiho chu lungsat na-in, amelmate lethuh inte, twikol gamhojong lethuhna-in lethuh inte.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kichaovintin, chutia chun amahon lhumlama konin Pakai minchu, chule nisolama kona aloupisah diu ahi. Melma chu twisoh banga ahung kondoh tengle chuche douna-a Pakai lhagao chun ponlap khat atundoh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule lhatdampu chu Zion huhdoh dingle Jacob sunga suhkhelna-a kona kilete henga hungding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keidin vang hiche hi amahotoh kakitepna ahi, tin Pakaiyin aseije. Nachunga um kalhagao chule nakamsunga kathuho chu, nachilhahte kama konle nachilhahte chilhahte kama kona jong tua pat atonsot ageija potdoh louding ahitai, tin Pakaiyin aseije.
  </para>
  <chapter number="60" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thoudoh inlang Salvah tan; ajehchu navah chu ahunge, Pakai loupi chu nachunga ahungsohtai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu ven, muthimin leiset ahinkhu-a, muthim lhangkhal in amite ahinkhu ding; hijongle nachunga Pakai chu hungsohdoh-intin, aloupina chu nachunga hungkilang ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule chidang namdangte chu navah-a hungun tin, chule lengho navah dohna vah-em lama hungdiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khodah inlang vekimvel temin, chule vechenin; akichom khomun, nahenga ahunguve. Nachapate gamlatah-a konin hunguntin, nachanute chu nakoma kijending ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuteng nangin munatin, hicheho chu thakhatnin hungsoh doh inte. Chule nalungsung kicha-a, suhjaova umding ahi. Ajehchu twikhanglen ninglhina chu nahenga hungding, chidang namdangte hatna chun nahinphah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sangongsao tamtah le, Midian le Ephah gam sangongsao golbepho chun nahinlonvuh ding ahin; abonuva Sheba-a kona hungdiu ahin, amahon sanale gimnamtui ahinchoidiu; abonuva Pakai loupina chu atahlangdiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kedar te gancha honho jouse nahenga hung kichom khomuntin; Nebaioth kelngoichal hon najendiu ahi. Amahochu ka-maicham chunga santhei doltah-a hungtou uva, chule ka loupina in chu kachoi-at ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Meilhang banga lengle-a, vakhuho banga abangkot dunguva lengle-a hichehohi koi hiuvaham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman loupina-a nachoi-at tahjeh-in, Pakai na Pathen mindingle, Israel mithengpa ding jala nachapate chu adangka hou le asana houtoh gamlatah-a kona puidinga, thonlouhela twikol gamhon einga dingu ahin, Tarshish konglen ho chu masapen dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule gamdangmi chapaten nakul banghou hinsa doh-uvintin, chule alenghouvin jong nangma najendiu ahitai. Ajehchu kalunghana-a kajep nahin, hijeng jongle khohsah na-a nachunga kanahepi nahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun miten chidang namdangte thaneina chu nahenga ahinpoh lutnuva, alenghou ahinpui theina diuvin nakotpiho tanglouvin kihong intin, sunle jana kikhah louhel ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu nangma jenlou ding nam le lenggam chu mangthah diu ahin; henge, hiche namho chu mahthah helding ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kamun theng jephoina dinga Lebanon loupina chu nahenga hunglhunga, chahthing, phanthing, meila thingho kehkhoma, kakeng ngapna munchu loupina-a kaki choi-atna ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nabolgenthei ho chapate nahenga kun uva, i-nasahlouho jousechu nakengto noija hungkun uva chibai nabohdiu ahi. Amahon Pakai khopi Israel mithengpa Zion chu nangma nahi, atidiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koiman nahin jotpa lou khopma dalhahle hotna nana um ahin, tonsot chungnunna khangtamtah kipana-a kasemding nahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangin chidang namdangte noitwi jong nachepma, lengho noijong nachep ding ahi. Nangin keima Pakai chu nahuhhingpa le nalhatdohpa Jacob mihatpa kahichu nahetding ahi,
  </para>
  <para style="p">
    <verse number="17" style="v" />keiman sum-eng khela sana, thih khela dangka, thing khela sum-eng chule songho khela thih kahinpohlutpeh-a, navaipo te jong chamna kapeh-a, navaihom te chonphatna kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nagamsunga thuse kija louding, chule nagamgi sunga gamna le suhmangna kijalouhel ding ahitai. Nangin nakulbang ho chu huhhingna ahin, nakotpiho chu pachatna ahi, nahin tiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sun teng nisa chu navah-a pangchom talouva, vahdinga lhathah-in jong vah napehchom louding ahitai. Ahinla Pakai chu natonsot vah leh na Pathen loupina-a pangding ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na nisa lhumtalouhel ding, na lhathah mangtalouhel ding ahi. Ajehchu Pakai chu natonsot vah hija, nalunghemna nikhoho kichaisoh ding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Namite jouse michonpha hiuvintin, atonsotna gamsung alodingu ahin, choi-atna kaum theina dinga amahochu kathingphu bah kakhutsoh chu hiuva ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lhom chakhat chu sangkhat hungsoh intin, aneucha khat chu nam hattah khat hunghi ding ahi. Keima Pakaiyin aphatcha kalhunsah loiding ahi.
  </para>
  <chapter number="61" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai Pathen lhagao chu kachunga aume; ajehchu Pakaiyin milung nengte henga kipana thupha seiphong dinga thao einu ahin; lungna teho suhdampeh dinga eisol ahi, sohchangte henga chamlen nathu lhangsam ding, chule sohchang ho henga songkul kihondoh thu hillhang dinga eisol ahin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai santhei kumle, i Pathen'u phulah nikho hillhanga, alunghemte jouse lhamonsah dinga;
  </para>
  <para style="p">
    <verse number="3" style="v" />Zion'a lunghemte henga lhamonsahna, vut khella hoina, lunghemna khella kipana thaotwi, lhagao pohgih khella pachatna ponsil pe dinga, hitia chu amaho Pathen thingphu, chonphatna thingphung tia akikouna diu, hitia chu ama choi-atna amutheina dinga eihinsol ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahon agamlui sesao asah phatnuva, masanga akamhelsa atundoh kitdiu, chule khopi gamsaho khangtamtah-a kamhelsa asemphat dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule gamdangmi hung kipatdoh uva nakelngoi honnu avah uva, gamdangmi chapate chu nalou kaijule nalengpilei lhouvuva hungpang ding ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla nangho Pakai thempuho nakisah uva, mihon Pathen kinbolho natidiu ahin; nanghon chidang namdangte haona naneh uva, aloupinao chu nakisonpi diu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Najachat nao khella ajatni namudiu, chule lungnoh phah khella achanuva kipahdiu ahin, hijeh-a chu agamsung uva chu chan nijen alodiu, achunguva tonsot kipana umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu Pakai keima hin thutah kangailun, govam thilto dinga thil kichom kimangcha kathen; chule dihtah-a anatoh-u lamkai jingting, amahotoh tonsot kitepna kasemding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule achilhahteu chu chidang namdangte lah-a hetna uma, chule achateu chu mipite lah-a hetdoh-a umdingu ahi. Amaho mujousen amaho ahetkhendiu, hitia chu Pakai phatthei boh chilhahte hidiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima Pakaiya hapan kipah ingting, kahinna ka Pathen'a kipah inte. Ajehchu aman huhhingna pon eisilpehtan, moulang akijep bangle, mounu sana vona akivon bangin aman chonphatna ponlenin eihuije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu leisetnin apahmum ahinsodoh bangle, honin asunga thil kituho adondohsah banga, hitia chu Pakai Pathen'in chonphatna le vahchoina namjouse masanga ahinsepdoh ding ahi.
  </para>
  <chapter number="62" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ajehchu chonphatna chu vah banga asodoh-a, huhhingna chu meivah banga akondoh masangsen, Zion jal-in umthimbeh pongting, chule Jerusalem jallin cholnga ponge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule chidang namdang ten nachon phatna, leng jousen naloupina amuteidiu, chule nangma Pakai kama kisah minthah khatna nakikou ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma Pakai khutna loupina lal lukhuh leh, na Pathen khutna leng lukhuh jong nahi ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangma akidalha naki tikit talou ding, nagam jong agohkeo kitikit talouhel ding ahi. Ahinla nangma Hephzi-bah nakisah-a, chule nagam Beulah kisah ding ahi. Ajehchu Pakai nangma chunga akipah-in, chule nagam chu hung jineiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu gollhangin nungah theng khat akichenpi banga, hitia chu nachapaten nahin kichenpi diu ahin; chule moulang mounu chunga akipa banga hita chu na Pathen nachunga kipahding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Jerusalem, nakulbang ho chunga khongah ho kakoije, amahon sunle jana thiptih aneiloudingu, Pakai geldoh jinga nangho thip hih helun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman Jerusalem atundoh-a, leisetna phatthei chang khatna asemdoh kahsen, kicholdosah hihhelun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai chu akhutjetlam leh aban thahatnin akihahseltai. Tahbeh-a nachang chu namelmate an dinga kapehkit tahlou ding ahi, chule gamdang mi chapaten natohgim ga lengpitwi chu adonloudiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla alhoh khom hon hichu aneh uva, Pakai chu avahchoidiu ahin, chule ahin pokhom hon kathenna in hongsunga adondiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jotpaijun, kotpiho chu jotpaijun; mipi ho lampi gontohpeh uvin; dipsangun, dipsangun lamlhongpi chu; song hochu loh doh-un, mipidin ponlap khat domsangun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Veuvin, vannoi leiset kolmong geijin Pakaiyin ahillhangtai. Nanghon Zion chanu jah-a seijun ven, nahuhhingna ahung lhungtai; vetan, atohphat man le anatoh ahin kengin a-anga aume.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amahon amaho chu mithengho Pakai lhatdamsate atidiu, chule nangma holdohsa, dalhahlou khopi khat kitiding nahi.
  </para>
  <chapter number="63" style="c" />
  <para style="p">
    <verse number="1" style="v" />Edom'a kona hungpa Bozrah-a kona ponsandup kisila hungahi koiham? Akivon na loupi tah, thahatna nasatah banga hunga chu, Keima chonphatna-a thuseija, huhhingna dinga hattah chu kahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ipidinga naponsil hitisan hija; chule naponsil chu lengpithei chilpa-a tobanga ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman kachangin lengpithei kachillin, miholah-a khatchan eihupoi. Ajehchu amaho chu kalunghana-a kachotpha-a, chule kalungsatna-a kachil ngem ding; athisannu kaponsil ho-a kithekhuma, kavon jouse-a kasuhmat ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu phulahna nikho chu kalunga uma ahin, kalhatdam kum chu ahung lhunge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin keiman kaven, eipanpi ding koimacha aumpon, eikai ding ding koimacha aumlou chu kalungdonge: hijeh chun kakhut tah-in keima dingin huhhingna eihin pohpeh-in, kalunghan na chun eikaiding tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule kalung hana-in miho chotphang ting, kalunghan na-in amaho khamsah ingting, ahatnau tolsena kanei ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ichunguva Pakai thilpeh jouse dungjuile, Israel insung mite dinga aphatna nasatah dungjuija, amihepina dungjuija athilpeh ho jalleh, ami lungset phatna ho jallin; keiman Pakai lungset phatna chu seijing ting, Pakai vahchoina thu kaseiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu aman aseije, amahohi keima mite mongmong, chule jouloubeh ding chate ahiuve, ati. Chutichun ama amaho huhhingpu anahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amaho kibol gimna channa ama jong kibolgimji ahin, a-anga um vantil chun amaho ahuhhing tai. Aman angailutna leh akhotona-in amaho chu alhatdoh-in; aman khangluilai jousen amaho avopmin, apolen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla amahon adouvun, alhagao theng chu ana lungphatmosah-ui. Hijeh chun ama amaho melmadin ahung kihei doh-in, amatah-in amaho akisatpitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin aman khanglui lai, Mosi le amite ageldoh-in, twikhanglen'a kona akelngoihon chingpatoh puidohpa chu hoija umham? asunga A-Lhagao Theng khumpeh pachu hoija umtam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Loupitah-a Mosi khut jetlama amaho puilea, tonsot amin aumjing nadinga amasanguva twipi sukhenpa hoilam ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaho akipal louna dinguva gamthip laija sakol banga twi thuhtah laija puigalkai pa hoiba hitam?
  </para>
  <para style="p">
    <verse number="14" style="v" />Phaichama gancha kumsuh bangin, Pakai lhagaovin ama acholdosah-in; chutichun namin loupina dingin namite nakaihoijin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Van'a konin hinvesuh inlang, chule nathen nale naloupina umna mun'a konin hinven; natompan nale nagunchuna keidinga nalainatnale nahepina hoi hitam? kituhtanga hitaovam?
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham'in eihe hih-u henlang, Israel'in eihehih jongleu, nangma kapau nahi-e. Vo Pakai nang kapau eilhandampu nahi; naminhi a-itih-a patna umjing ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo Pakai ibolla nalampi ho-a kona nei chekhel sah uva, nangma kakichatna diuva kona neilungtah sah-u ham? nagoulo phungho, nasohte jal-in hungkiletan.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nathenna miten hichu chomcha khatbou aneijun; kakidoupi teovin namun thengchu achotpha taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keiho nanga kahiuvin, amaho chunga vai nahom khapoi; amaho namina kikou ahipouve.
  </para>
  <chapter number="64" style="c" />
  <para style="p">
    <verse number="1" style="v" />Molsang jouse chu na-angsunga twi lonna alonlhah suh theina dinga, O nangin van ho chu nasatella, nahung kumlhah nom hileh,
  </para>
  <para style="p">
    <verse number="2" style="v" />nakidoupi ho namin hetsahna dingle, na angsunga namtin kithingthinga aumna diuva, meijin akahjola akonbanga, meijin twi asousah bangin!
  </para>
  <para style="p">
    <verse number="3" style="v" />Kakinep pilouvu tijat umtah thil naboltengle, nahung kumlhajin na-angsunga molsang ho alonglha jeng jiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu vannoi kipatna pat nangma tailou Pathen dang, ama ngah ho dinga natonga; mihemin aja khapon, nakhangin jong ajahkhapon, mitnin jong amukhapoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kipahtah-a uma chonphatna bolpa, nangma hejing puma nalampi jotpa nakimupin, vetan, kachonset jeh-un, nalung ahangin, chuho-a chun kaum jom jingun, huhhing kahidiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla kabonun thilboh kabang sohkeijun, kachon phatna jouse jong ponsenen bangbou ahin, kabon chaovin nathel bangin kamol lhaovin, kakhanset naovin huibangin eilhohmang gamtaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule namin panna nangma kolchah dinga kitilkhouva khatcha aumtapoi, ajehchu keiho-a konin namai naselin; kakhan setnao jeh-in neisumangtaovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla tun, vo Pakai, nangma kapao nahin; keiho bel kiden na leiset kahiuvin, nangma beldengpa nahi; chule keiho kabonun nang khutsoh jeng kahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Pakai, lunghang behseh hih-in, khanset najong tonsotnin geldoh jinghih-in; ngaijin, vetemin, kangeh-u nahi, keiho namite jeng kahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nakhopi thengho gamthip asohgamin, Zion jong gamthip ahin, Jerusalem jong akamheltai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kapu kapa teovin nangma navahchoi nao ka-inthenghou leh ka inhoi houjong meijin akavam gamtan; kathildeihou jouse jong manlou asoh gamtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vo Pakai, hicheho-a dingahi nangma nakitim ding hinam, nangma nathip beh-a, neisuhgenthei teitei diuham?
  </para>
  <chapter number="65" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kahenga thumlou hon eiholun, eihol louhon eimuve; kamina kikoulouhel nam mite henga chun, neiveuvin, neiveuvin, kati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amaho lunggella achona lampi phalou houva vahlea, doupanho chunga chun kakhut kajah nilhum lhumjin ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Tanglouva lung hansah dinga kamaija eilung phatmo sah-a; honsunga kithoija, chehsong maicham chunga gimnamtui hal mite;
  </para>
  <para style="p">
    <verse number="4" style="v" />Lhanho lah-a umdena, songko sung ho-a geh-a, vohsa ne-a, Abel sunguva thet umtah satwi kitunna;
  </para>
  <para style="p">
    <verse number="5" style="v" />Nachang seh-in dingin, neihin nai hih-in; ajehchu keima nang sangin kathengjoi, tiho chu ahiuve. Hicheho chu kanahko homsunga meikhu jing ahiuvin, nilhumkeija kongjing meikou ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Veuvin, hichehi kamasanga akisune: Thipbeh in umponge. Ahinla lethuh ingting, a-opkong sungtah uva kalethuh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nakhanset naole napu napateu khansetna agoma, molsang ho chunga gimnamtui ahal uva, lhangho chunga eitaitomu ahin, hijeh-a chu anatoh masah hou chu a-opkong sunguva katepeh ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakaiyin hitin ati, lengpiga lomlah-a kon lengpitwi akimu bangin, mikhat touvin asungahi phattheina aumjeh-in sumang hih-un ati banga: chutobanga chu kasohte jala abonchauva kasuhmang louding ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keiman Jacob'a kona sonkhat, chule Judah'a kona kalhangtheng loding khat ka hinpuidoh ding; chule kamilhen hon hichu lovintin, chua kasohte chengden diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Sharon chu ganchahon dinga hongsung hintin, chule Achor phaicham chu ganchaho dinga kolna mun hiding; ajehchu keima eihola kamite jong chutobang ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla nangho Pakai dalha-a, Ka molsang theng sumila, chuche sepaihon ho dinga dokhang gonpeh-a, chule chuche mijat ho donding thilpeh bulhitpeh nahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun chemjam'a kasimding nahiuvin, athatpa anga nakundiu ahi. Ajehchu kakoupetnin neihou pouvin, kahoupet un neingaipeh pouvin; ahinla kamitmun thilse nabol jouvin, keima deilou joh nakilhen taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun Pakai Pathen'in hitin ati, veuvin, kasohten anehdiu, nangho vang gilkela naum diu; veuvin, kasohten adonuva, nangho vang nadangchah diu ahi. Veuvin, kasohte kipah untin nangho vang najachatdiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Veuvin, kasohten lungsung kipa la saovintin, nangho vang gentheijeh-a nakadiu ahi. Chule lhagao bolsetjeh-a napenjah diu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule naminu chu kamilhendohpa henga sapsetna-a nadalhah diu ahi. Ajehchu Pakai pathen'in nangma natha-a, asohte minchoma akouding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Leisetna amale ama phatthei kiboh-a chu, Pathen dihna-a amale ama phatthei kiboh ding ahin, chule leisetna kihahsela chu Pathen dihna-a kihahsel ding ahi. Ajehchu lungkhamna masaho akisumilin, chule kamitmu-a konin akisel mang taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu veuvin, vanho leh leithah kasemin ahi. Chule thilmasa chu kiheta louhel ding, lunga jong langtalouhel ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla kathilsema chun nangho a-itih-in halna in kipah unlang thanomun; ajehchu veuvin keiman Jerusalem chu kipa na-in, amite chu thanop na-in kasemtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Jerusalem'a chun kipah ingting, chule kamite lah-a jong thanominge, Chule hia chu kana aw gin, penna aw gin jong kijalouding ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuteng chua chun naosen nikho lhomcha bou hinga leh tehse adamsung hin nikho lhinglouho umta ponte. Ajehchu chapang chu kum jakhatna thiding; ahinla michonse kum jatamtah hingho chu sapset chang hiding ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amahon inho saovintin, hiho-a chu chengdio, chule amahon lengpihon bolluntin, aga anehdingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />In asah uva midang cheng talou ding; thingphung aphu uva midangin aneh tah louding: Ajehchu thingphung khat hinkho banga chu kamite hinkho jong hiding, kalhendohten akhut tah uva atohgao phatsotpi anopsahpidiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amahon moh-a atohgim loudiu, lungjina dingbepma jong cha ahinloudiu ahi, ajehchu amaho Pakai phattheiboh son ahiuvin, ason apah houtoh umkhoma ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hung hitiding ahi, amahon keima eikou masang uva kahouding, chule thu aseijing nahlai uva jong kajahpai ding ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kamkeile kelngoinou lhakhoma, bongchal banga keipin changpol anehding, leivui chu gulho dinga sa hiding ahi. Kalhangtheng chung jouse-a chu amahon asukhah-u, asuhmangu umlou ding ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="66" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin hitihin aseije, vanhi kalaltouna ahin, leihi kakengto ngapna ahi. In nei sahpeh-u chu hoi ham? Kacholdona ding mun hoiba ham?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu thiljouse chu kakhutna kasema, thiljouse chu uma ahi, tin Pakaiyin aseije. Ahivangin hiche migenthei pa, lungsung kisih-a kathua kihot hotpa bouhi kavet ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bongchal thatpa chu mithat tobang ahin, kelngoinouva kithoipa chu ui ngong sattan tobang ahi; Pathen'a thilpeh toh-a chu vohcha thisan tobang ahin, gimnamtui halpa jong chu milim semthu pathen phattheiboh tobang ahi. Ahi, amahon alampidiu akilhenun, thet umtah ahinaova chun alungu akipah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman amaho bolgentheina lhenpeh ingting, chule achunguva akichatnao chuhsah inge, ajehchu kakoupetnin khatchan eidonbut pouvin, thu kaseipetnin angaipouve. Ahinla kamitmun thilse bou abollun, kakipana louhelbou akilhenuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai thuhi ngaijuvin, athua kithing thinga nangho, nasopiu nangho nahotbol houle keima min jeh-a nangho napaidoh hou chun, Pakai chu choisangin umhen tiuhen; ahinla ama nakipa naova hung kilah-in tin, chule amaho jahchajo ding ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khopi-a kona husagin, houin'a kona husagin chu Pakai husagin ahin, amelmate lethuhna dinga Pakaiyin hiche chu asodoh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Naosonat athoh masangin cha ahingin, anat thohgim masangin, naosen pasal khat ahingtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitobang chu kon ajahkhah-a, hitobang chu kon amukhah-em? Leiset nikhat sunga kisemdoh-a, namkhat hi khatvei so-a sohjeng theijem? Ajehchu Zion hin naosonat athoh thoh-in achate ahingdoh jenge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakaiyin cha kahindoh sah-a, kapen lhahsah louding ham? ati. Keiman kasolhah sahji ahin, naobu kakha-ji dingham? tin na Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangho ama ngailu jousen Jerusalem kipa thanop piuvin lang, ama lunghempi nanghon halna-in kipa thanop piuvin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitia chu nangho ama lunghempi ho jousen alhepbina noitwi chu nachep uva, nachim theina diuva, aloupi chamkimna lhingset chu nakipapi theina dingun, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu Pakaiyin hitin ati, veuvin, amanu henga chamna vadung long banga, chule chidang namdangte loupina chu twilong banga kalonsah-a, chuteng nachep uva nangho amanu pangteni-a nakipoh uva, akhup chunga nakichop diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anun alhepbi mikhat banga hitia chu kalhepbiuva, Jerusalem'a lhamonga naum dingu ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichehi namu tengule nalungu kipah-a, nagu nachang jouse jong hamhing banga nouding, Pakai khutchu asohte lama kilanga, alung himona amelmate chunga kilangding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu vetan, Pakai chu meikong banga, huipi nung tobanga akangtalai ho puma, alunghana lungsatna sodoh dingle, aphosalna meikong banga hungding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Pakaiyin meile achemjama tahsahing jouse thu atanding, chule Pakai mitha chu tamtah hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaho acham chama kisuthenga, chule honsung lailunga thingphung khat nunglama amale ama kisuthenga, vohsa phe thet umtah chule juchasa neho chu mangthah khomdingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu athilbol houle alung ngaitohou kahenai, keiman namjousele paojouse kakhopkhoma, kaloupina amunadiuva hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle keiman alah uva melchihna khat koijing ting, chuleh alah uva asohcha hochu namtin vaipi keima minthan jakha louhel ho, kaloupina mukha loulaiho: Tarshish lam, Put lam, chule thalthem Lud lam ahin, Tubal leh Javan lam chule gamlatah twikol gamho geija kasolding ahiuve. Chuteng chule amahon chidang namdang lah-a kaloupina aphonjal dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amahon, Israel chaten Pakai insunga lheng thengsel sunga thilto ahinchoi banguva, nasopiteu jouse Pakai henga thilto toh dinga namtina kona, sakol kangtalai chunga, talaija, sakol pol ho chunga, ganhing gangho chunga ka mol theng Jerusalem'a ahintollut dingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule kenjong alah uva chu thempuho dingle, Levi ho ding kalhen ding ahi, tin, Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Van thah hole leithah kasem dingchu kamasanga aumjing bangin, nasonhoule naminu chu umjing ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hung hitiding ahi, lha ahungthah-a patna ahungthah kitchan, choldoni-a patna choldoni kit chan mijouse kamasanga keima hou dinga hung dingu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutengle amaho chedoh uva, kachunga chonkhelna neiho thilong chu avetjing dingu ahi. Ajeh chu alungu thilouhel ding, ameikong jong mitlouhel ding, chule amaho tahsa hing jouse dinga kidah umtah hiding ahiuve.
  </para>
</usx>
