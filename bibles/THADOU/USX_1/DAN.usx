<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="DAN" style="id">Daniel</book>
  <para style="h">Daniel</para>
  <para style="toc1">Daniel</para>
  <para style="toc2">Daniel</para>
  <para style="mt">Daniel</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah lengpa Jehoiakim leng chan kal kum thum lhinna-in, Babylon lengpa Nebuchadnezzar chu Jerusalem lama ahungin, ahung umkimvel tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin Judah lengpa Jehoiakim chu ama khutna, Pathen insunga kongle bel phabep toh apehdohthan; hichu aman Shinar gamsunga a-pathen insunga apolutnin; chule aman kongle bel ho chu a-pathen'u thillu koina insung alhut tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpa chun nukiso ho lamkaipa Ashpenaz jah-a chun Israel chate, leng chilhah, leng chapate lah-a kon mi phabep ahinpui dingin ahetsah-in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho chu, ama-a nolna kimulou golhang, ahivanga melhoi, chihna lam jouse-a bulhing, hetna giltah nei, ijakai hethem bai, lengpa insunga dingthei ding, Chaldea mite themna le pao hilthei dingho ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule lengpan amaho chu lengpa anneh le adonji ju chu nitina achan diuvin agotpeh-in: chutia chu kum thum khoukhah-a aumjou tengule lengpa anga akilah diuvin agongtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun hiche miho lah-a hin Judah chate, Daniel, Hananiah, Mishael chule Azariah apanguve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho chu nukiso pipupa chun aminvon: hitichun aman Daniel chu Belteshazzar, Hananiah chu Shadrach, Mishael chu Meshach, chule Azariah chu Abednego asahtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin Daniel'in lengpa anneh le adonji ju-a akisuhboh lou dingin alungsunga kigel lhahna aneijin: hijeh chun aman akisohboh louna dingin nukiso pipu henga chun ataotan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun Pathen'in Daniel chu nukiso pipupa mitmu-a khohsahna le ngailutna giltah ahin chansah tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin nukiso pipupa chun Daniel henga, Nangho dinga nehding le donding hinteppeh ka pakai lengpa chu keiman kaginge. Ajehchu ibola nakhangol golhangho maiso sanga nangho maiso phamo jo-a amu ding ham? Chuti taleh nanghon lengpa henga kaluchanghi tijat um nasodiu ahi, tin aseitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin Daniel'in nukiso pipupan Daniel, Hananiah, Mishael chule Azariah vesui dinga akoipa Melzar henga aseitai;
  </para>
  <para style="p">
    <verse number="12" style="v" />Nisom sungin nasohte neipatep un tia kangeh nahi, chule amahon keiho neh dingin anche, chule don dingin twisih eipeuhen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujou tengle nangma angsunga keiho mel leh lengpa an neh ne-a golhangho mel vet kah-in umhen; chule namu dungjuijin nasohte chunga hin boljengin, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun hiche thua hin amapan aseiju chu anoppehtan, chule amaho chu nisom sung apatep tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin nisom ahung kichaijin, lengpa an neh ne-a golhangho jouse sangin amaho chu mel hoijo le tahsa phajon ahung kilangtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun Melzar'in achan dinguva kipe, aneh diu an le adon diu ju chu alamangin; chule amaho chu anche apejotan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche golhang liho vangchu, Pathen'in themna jouse le chihna lam jouse-a hetna le boltheina apen; chule Daniel'in gaothilmu le mangho jouse lama hetthem theina ananeijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun lengpan amaho nahinpuilut ding ahi tia asei nikho alhun phatnin, nukiso pipupan amaho jouse chu Nebuchadnezzar anga apuilut tan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin lengpan amaho chu akihoupin, chule amaho lah-a chun Daniel, Hananiah, Mishael chule Azariah tobang akimupon ahi. Hijeh chun amaho lengpa anga ading taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule chihnale hetthem theina lam jouse-a lengpan amaho chu adongin ahile, alengvai pohna gam pumpi-a mitpheldoi choiho le ahsi lekhathem ho jouse sanga chan soma sangjon amutan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun Daniel chu Cyrus lengpa lengchan kum masapen geijin ahung umpeh tan ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nebuchadnezzar lengchan kum ni alhin na-in, Nebuchadnezzar'in mangho aneijin, hichun alung asugimin, a-imut asuboitan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin lengpan doithemho, ahsi lekhathem ho, aisanho chule Chaldea miho chu amangho hilchen dinga kou dingin thu khau tah-in apetai. Hitichun amaho ahungun lengpa anga ahung ding taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin lengpan ajah uva, Keiman mang khat kaneijin, hichu hetdohna dingin kalung agimlheh tai, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Chaldea mihon Syrian paovin lengpa henga, Vo lengpa, hing jingin: mang chu nasohte neisei peh-un, chutile keihon aledohna navetsah naovinge, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lengpan adonbutnin Chaldea miho henga chun, Athil chu keija kona chemanga ahitai: nanghon mangle aledohna chu keima neihetsah louvule, nangho ahal hala tanboh-a naum dingu, chule na-inhou jong eh kikholna kasosah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla nanghon mang le aledohna chu nahilchet thei vangule, keija kona manbeija thilpeh le kipaman chule jana lentah namu dingu ahi. Hijeh chun mangle aledohna chu neimusah-un, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon adonbut kitnun hitin aseijuve, Lengpan amang chu asohte eiseipeh uhen, chule keihon hiche aledohna chu vetsah-ung kate, atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lengpan adonbutnin, Nanghon thil chu keija kona achemang namu jeh uva, phat mube theina ding bouva naseiju ahi, ti keiman kahechentai, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin nanghon mang chu keima neihetsah louvule, nangho dingin dan thupeh khat bou uma ahi: ajehchu aphat akikhel theina dinga ka-anga jou le thudihlou sei dinga nakigotnu ahi. Hijeh chun mang chu neisei peh-un, chule keiman hiche aledohna chu neimusah theidingu ahi ti kahet ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chaldea miho chun lengpa anga adonbutnun, hitihin aseijuve, Leiset chunga lengpa thu musahthei mihem khatcha aumpoi: hijeh-a chu chutobang thilchu mitphel doithem, ahiloule ahsi lekhathem, chule Chaldea mi anadongjia leng, pakai, ahiloule thuneija khatcha ana um khalou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule lengpan angaichat hi thil kikhat ahin, lengpa anga hichu tahlang jou ding tahsa-a hing hilou pathen ho tailou adang koimacha aumpoi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichejeh hin lengpa alunghangin chule alungsalheh tan, chule Babylon'a miching jouse suhmang dingin thupeh apetan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin michingho thagam dinga dan thupeh kipe chu hopjalin aumtan; chule amaho Daniel le aloiho chu tha dingin aholtauve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin Daniel'in thumop le chihna to thon lengpa ngahtupho lamkaipa, Babylon michingho that dinga chedohpa Arioch chu adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman lengpa sepai lamkaipa Arioch chu adonbutnin, ipi dinga lengpa-a kona hiche dan thupeh hi hung hiti ganna ham? ati. Hichun Arioch-in athil umchan chu Daniel ahetsah tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chujouvin Daniel alutjelin, aledohna chu lengpa amusah theina dinga, lengpan ama phat apehna dingin agathum tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Daniel a-in'a achen, athil umdol chu aloiho Hananiah, Mishael chule Azariah henga ahetsah-in ahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche thuguh chungchang thua hi Babylon michingho jouse toh thakhatna Daniel le aloiho chu suhmanga aumlouna dinguva van Pathen hepina athum theina dingun ahetsah-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin thuguh chu jan-in gao thilmu in Daniel henga phondoh-in ahung umtan ahi. Chujouvin Daniel'in van Pathen chu athangvah tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Daniel'in adonbutnin, Atonsot atonsotnin Pathen min chu vahchoijin umhen, ajehchu chihna le thahatna chu ama-a ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule aman phat hole kum kiheichinho akheljin; aman lengho aladoh-in, lengho atungdoh-in, aman achingho henga chihna apen; chule hetthem theina neiho hetna apei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman thugille thuguhho aphongdoh-in; muthima ipi aum aman ahen, chule vah chu amatoh aum khomin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chihna le hatna eipe-ah, chule keihon nangma-a kona kangeh-u keima eihin hetsah-a, Vo Nangma kapate Pathen, keiman nangma kathangvah-in, kavah choije: ajehchu nangman tun lengpa ngaichat chu keiho neihin hetsah taove, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun lengpan Babylon michingho thatgam dinga athupehsa Arioch henga chun Daniel achelutnin: ahenga, Babylon michingho sumang hih-in; lengpa anga keima neipuilut nin, chule keiman aledohna chu lengpa vetsah ingkate, tin agaseije.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Arioch-in Daniel chu lengpa anga kintah-in apuilutnin, ajah-a, Keiman lengpa henga ledohna pe-a hilchen ding mi khat Judah sohchangho lah-a konin kamutai, agati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lengpan adonbutnin, Belteshazzar tia kiminvo Daniel chu adonbutnin, Keiman kananei mang le aledohna chu neihetsah thei ding ham? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lengpa angsunga Daniel'in adonbutnin, hitin aseije, Lengpan na-ngeh khoh thuguh chu michingho, ahsi lekhathem ho, mitpheldoi choiho, chule khonung thusei ho chun lengpa avetsah thei pouve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla thuguhho phongdoh jia van'a Pathen khat aumin, ama chun ninunung lamle ipi hungsoh dingham tichu Nebuchadnezzar lengpa ahin hetsah ahi. Namang le najalkhun chunga naluchang nangapma na gaothilmu chu hichehohi ahi:
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangma vang, vo lengpa, najalkhun chunga naum chun, tunungle ipi hunglhung ding ham ti ngaitona nalungthima ahung umin ahi. Chule thuguhho phongdoh ji-a ama chun ipi hunglhung ding ham ti nangma nahin hetsah ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla keima hina-in vang, hiche thuguhhi keiman midang jouse sanga chihna kaneitam jeh-a kahenga kiphonga ahipon, amavang lengpa henga aledohna hetsah dingho jal leh, chutia chu nangman nalungsunga nalunggel chu nahetdohna ding joh ahibouve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vo lengpa, nangman milim lentah khat nanamun chule nanaven ahi. Hiche milim lentah avah-a vah pempum jeng chu na-angsunga adingin; chule alimdan chu tijat umtah ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hiche milim luchang chu sana thengsel ahin, a-ople abanho chu dangka, a-oile apheiho chu sum-eng,
  </para>
  <para style="p">
    <verse number="33" style="v" />Akeng teni chu thih, akengphang teni chu thih le leiset kihala kisem ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangman mihem khutna kisem hilou song khat ahungdoh-a, hichun milim chu akengphang teni thih le leiset kihala kisem laitah ase khah-a, hiho chu ahal hala achipsoh nanamun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichun thih, lei, sum-eng, dangka chule sana chu abonin thakhatnin ahal halin achiplhan, chule nipi laija phola changsiho bang ahunghitai; chule huijin hicheho chu amut mangin, agei nalamu akihe tapoi. Chule milim sepma song chu mol lentah ahung soh-in, chule leiset pumpi alodim tai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hichehi mang chu ahin; chule chuche ledohna chu lengpa masanga keihon seijung kate.
  </para>
  <para style="p">
    <verse number="37" style="v" />Vo lengpa, nangma lengho leng nahi; ajehchu van Pathen'in lenggam, thaneina, thahat, chule loupina nangma napen ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule aman mihem chate chenna jouse, gama saho chule chunga leng vachaho nangma khutna napedoh-in, chule amaho jouse chunga thuneijin nasemtai. Nangma hiche sana luchang chu nahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule nangma nungtengle nangma sanga hatmojo lenggam khat, chule athum channa sum-eng lenggam adang khat hung umdoh ding, hichun leiset pumpi hi vai apoh ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule lenggam lina chu thih banga hat ding; thih in thil jouse ahal hala asuhgema anoija akoi banga; chule thih-in hitiho asuhngem banga, hichun asuhngema asuhchip ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule nangman akengphangho le kengjungho, akehkhat beldengpa lei abang thih-a namu bang ngeija hi, lenggam chu hung kikhen ding; ahinla nangman thihle leingan kihal namu bang ngeija, hiche chun thih tha aken ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule keng jungho chu abang thih-a chule abang leija ahibanga, hiche lenggam chu akeh khat hatnintin, akeh khat chu lhasam ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule nangman thihle leingan kihal namu banga, amaho mihem chilhah ho toh kichoh hal dingu; ahivanga thihle lei akihalthei lou banga, amaho khatle khat kitimat thei lou diu ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule hiche lengho nikholai tengchule van Pathen'in lenggam khat atundoh ding, hiche chu a-imatih chana suhmanga umlou ding ahitai. Chule hiche leggam chu midangho kidalhah peh lou ding, amavang hichechun hiche lenggam ho jousehi ahal hala asuhngema chule asuhmang ding, chule hichu a-itih-a ding jing ding ahitai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nangman khutna hilou molsanga kona khendoh-a song manu-a, chule hichun thih, sum-eng, lei, dangka chule sana ahal hala asuhngem namu banga; loupi Pathen'in tununga ipi ahungso ding lengpa ahinhetsah ahi. Chule mang chu atahbeh ahi, chule aledohna chu thonlou ahi, ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Nebuchadnezzar lengpan tolla amai asulutnin, Daniel chu chibai aboh-in, chule amahon ama henga thilto le gimnamtui apeh diuvin thu apetan ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Lengpan Daniel chu adonbutnin, Hichehi thutah ahimonge, hitichun nangma Pathen hi pathen ho Pathen le lengho Pakai ahin, chule nangman hiche thil kisel guhho naphondoh thei jal-in, thil kisel guhho phongdoh-a chu ahi, ati.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin lengpan Daniel chu miloupi tah-in asemin, chule thilpeh tamtah ho chu apen, chule Babylon gam pumpi chunga thuneile, Babylon'a michingho jouse chunga vaihomho pipui ahisah tai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chujouvin Daniel'in lengpa henga ngehna aneijin, hitichun aman Shadrach, Meshach chule Abednego chu Babylon gamkaiho chunga vaibolin apansahtai. Ahinla Daniel vang chu lengpa kotpi phunga atouvin ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nebuchadnezzar lengpan sana milim khat asemin, hichu tong somgup asangin, chule availam chu tong gup ahi. Aman hichu Babylon gamkai sunga Dura phaichama chun atungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin Nebuchadnezzar lengpan pipuiho, gamvaipoho, chule gal lamkaiho, thutan ho, gouchingho, thumopthem ho, kho vesuiho, chule gamsungho-a thunei ho jouse chu khopkhoma, Nebuchadnezzar lengpan atundoh milim thensona-a hunglha cheh dingin thu athot tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun pipuiho, gamvaipoho, chule gal lamkaiho, thutan ho, gouchingho, thumopthem ho, kho vesuiho, chule gamsungho-a thunei ho jouse chu Nebuchadnezzar lengpan atundoh milim thensona-a ding chun khopkhomin ahung um taovin; chule Nebuchadnezzar'in atundoh milim maija chun adingun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujouvin khosam khatnin gingtah-in ahinsamin, Vo mipiteho, namtin, chule paotin paotangho, hichehi naheng uva thupeh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitia chu nanghon sumkon binei, theile, selangdah, sumkonsao, tumging, chule agingthei jouse gin najah phatnule, nabohkhup uva Nebuchadnezzar lengpan atundoh milimhi nahou dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule koihile bohkhupma hou louva chu chuche nidan mama chu meilhum sunga kiseplut ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun mipi ho jouse chun sumkon binei, theile, selangdah, sumkonsao, tumging, chule agingthei jouse gin ajah jah-un, mipi ho jouse, namtin, chule paotin paotangho chu aboh khupmun, chule Nebuchadnezzar lengpan atundoh sana milim chu ahou taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuti ahin chuche pettah chun Chaldea mi phabep ahung naijun, chule Judah miho chu ahung hehseuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amahon Nebuchadnezzar lengpa henga, Vo lengpa, hingjingin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo lengpa, nangman mitinin sumkon, theile, selangdah, sumkonsao, tumging, chule agingthei jouse gin ajah tengule bohkhup cheh uva, chule sana milim chu ahou diuvin thupeh nanapen ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule koihile bohkhupma houlou chan chu meilhum deujeju sunga kiseplut ding ahi, natin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman Judah mi phabep Babylon gamkai sunga vaipo-a natun aumun, amaho chu Shadrach, Meshach chule Abednego ahiuvin; vo lengpa, hiche miho hin nangma nahsah-in nanei pouvin ahi. Amahon nangma pathen ho ajen pouvin, chule nangman natundoh sana milim jong ahou pouvin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Nebuchadnezzar'in lungsatah le lunghang tah-in, Shadrach, Meshach chule Abednego ahinpui diuvin thupeh aneitai. Chuin amahon hiche miho chu lengpa anga ahinpui taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nebuchadnezzar'in ahenguva, Vo Shadrach, Meshach chule Abednego, nanghon keima pathen ho najen pouvin, chule keiman katundoh sana milim jong nahou pouve, kitihi tahbeh ham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Tu-a hi nanghon sumkon binei, theile, selangdah, sumkonsao, tumging, chule agingthei jouse gin najah phatnule nabohkhup uva chule keiman katundoh milim chu hou dinga kigosa um nahi vangule, aphai: ahinla nanghon nahou louvule vang, apetpetna nangho meilhum deujeju sunga kiseplut ding nahiuvin; chule kakhut teni-a kona nahuhdoh thei diu Pathen chu koi ham? tin aseitan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shadrach, Meshach chule Abednego'n lengpa adonbutnun, ajah-a, Vo Nebuchadnezzar hiche thua hin keihon nangma donbut ding ngaikhoh kasapouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitichu ahi tah-a ahi jongle, Vo lengpa, kajenpao keiho Pathen hin keiho meilhum deujejua kona eihuhdoh theiju ahin, chule nangma khutna kona jong eihuhdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla achutilou jongle, Vo lengpa nangman hichehi he-in, keihon nangma pathen ho kajenlou diu, chule nangman natundoh sana milim jong kahoulou dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutahchun Nebuchadnezzar chu lungsatnan adimtan, chule Shadrach, Meshach, chule Abednego dounan amel akikhel jengtai. Hijeh chun aman meilhum chu asatdan ajat sagi-a sajo-a satsah bena dingin thu apetai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman agalsat miho lah-a hatdang lhadeh ho chun Shadrach, Meshach, chule Abednego akantumuva, chule meilhum deujeju sunga alelut diuvin thu apetai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin hiche miho chu asangkholchol hou, asangkhol sungnung, alukhuhhou, chule avonu adang dangin akantumun, meilhum deujeju sunga chun aseplut taovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun Lengpa thupeh chu mangang tah ahi jehle, lhum chu asat behseh jeh-in, chuche meikong chun Shadrach, Meshach, chule Abednego seplutna miho chu akalihtan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hiche pasal thumho Shadrach, Meshach, chule Abednego chu, meilhum deujeju lailunga chun kantum san alhalut taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujou chun Nebuchadnezzar lengpan kidang asan, gangtah-in akipatdoh-in, chule athumop themho henga chun, Eihon meilhum sunga chu pasal thum ikantum uva iselutnu hilou ham? ati. Amahon adonbutnun, lengpa jah-a, Ahinai lengpa, atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman adonbutnin, Veuvin keiman pasal li kilhamlha-a mei lailunga avaleu kamun, chule amaho ima ati pouve; chule ali channapa lim khu Pathen chapa abangin ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chujouvin Nebuchadnezzar chu meilhum deujeju kot koma chun ahungin, ajah uva, Nangho chungnung pen Pathen sohte, Shadrach, Meshach chule Abednego, hungdoh-un, chule hilama hungun, ati. Chuin Shadrach, Meshach chule Abednego chu mei lailunga konin ahungpotdoh taove.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin pipuiho, gamvaipoho, gal lamkai, chule lengpa thumopthem ho, khopkhoma umho chun hiche pasal ho meikouvin atahsao chunga tha aneijou lou, asamu jang khat jengjong kinlouva, asangkholhou jong kikhel dehlou, chule meikhu gim himhim jong achunguva anamlou chu amutaove.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Nebuchadnezzar'in hitin aseitai, Avantil ahinsola, ama tahsan-ah asohte ahuhdoh-a Shadrach, Meshach chule Abednego Pathen chu nunnom hen: amahon amaho Pathen tailou pathen adang anei loudiu le ahoulouna dinguvin lengpa thupeh jengjong apalkeh-un, atahsao apedoh jengun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijeh-a chu keiman thupeh kapeh ahi, amitakip, namtin, chule paotin paotangin Shadrach, Meshach chule Abednego Pathen douna-a seikhel khat neija chu, ahal hala kichenna, chule a-inhou jong chu eh kholna kiso ding ahi. Ajehchu hitobanga huhdoh jou Pathen adang aumpon ahi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chujouvin lengpan Shadrach, Meshach, chule Abednego chu Babylon gam sunga chun atohmunu adomsangtan ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nebuchadnezzar lengpan, Mipi, namtinho, chule paotin paotang, leiset pumpi sunga chengho henga; nachung uva lungmona punghen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chungnung pen Pathen'in kachunga melchihna le thilkidang atohdohho phondoh ding pha dingin kagelin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amelchihnaho iti loupia hitam! chule athilbol kidangho itobanga thaneija hitam! alenggam chu tonsot lenggam ahin, chule avaihomna chu akhang akhanga umjing ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima Nebuchadnezzar hi ka-in sunga kakicholdon, chule kaleng inpia sunga khangtou tah-in kaumin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman mang khat kananeijin, hichun eikichat sah-e, chule kajalkhun chunga kalunggelho le kathilmu chun eilungkham sah lheh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun keiman ka-anga Babylon michingho jouse puilutna aumuva, amahon kamang ledohna eihetsah diuvin thupeh khat kaneitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun mitpheldoi themho, ahsi lekhathem ho, Chaldea miho, chule khonung thusei ho ahunguvin: keiman amaho anga kamang chu kanaseijin, ahinla amahon kamang aledohna chu eihetsah thei pouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla akhonna-in Daniel keima anga ahunglutnin, ama min chu ka-pathen min dungjuijin Belteshazzar kisah ahin, chule ama-a hi pathen thengho lhagao chu uma ahin; chule ama anga keiman kamang chu kaseijin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Belteshazzar, mitpheldoi themho pipui, keiman nangma-ah pathen thengho lhagao aume, chule thuguh imachan nangma nasulung jingpoi ti kahet jeh-in, kamanga kathilmuho chule hiche aledohna chu keima neisei peh-in kati ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hicheho hi kajalkhuna mu kananeiho chu ahi; Keiman leiset lailung tah-a thingphung khat kanamun, chule asanlam chu asang tangei jenge.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thingphung chu ahung khangin, ahung det lheh-in; chule asan chu van aphan, leiset mong jouse-a konin hichu akimu phan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ado ho chu ahoijin, chule aga atam lheh-in, chule hichu ahingthei jouse dinga an ahi: gama saho alim noija aumun, chule chungleng vachaho abahho-a achengun, chule tahsa hing jouse hichea kon chun khoukhah-in anaumin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman kajalkhuna kalupma mu kanei chun, veuvin, angahpa, mitheng khat van'a kona hungkumlha kanamun;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama chun gingtah-in asamin, thingphung chu phuhlhu uvin, chule abahho jong tanbongun; anaho malngim un, chule aga chu thecheh-un: anoija konchun gamsaho chu chedoh uhen, chule abahho-a konin vachaho chu lengdoh uhen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijengjongle abul le ajung chu leija thihle sum-eng khaovin kanunlang, gamlah-a hamdongho lah-a dalhauvin; chule hichu van daituijin chapkot hen, chule ama chan chu hampa lah-a saho chan toh umtha hen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Alungthim chu mihem lungthima konin kikhel henlang, sahem lungthim kipehen: chule achung chu phat sagin lhunkhum hen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche thuhi angahho thupeh jal leh, mithengho thun angehkhoh jal ahi: mihemte lenggam sunga hin Chungnung pennin vai ahomin, chule hichu koihile alung lhainapa chu apen, chule mihemte lah-a anoinungpen jong chu hiche chunga chun atungdohjin ahi, ti mihing hon ahet theina dinguva kibol ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche manghi keima lengpa Nebuchadnezzar'in kanamat ahi. Tun nangma, Vo Belteshazzar, aledohna phongdoh-in, kalenggam sunga michingho jousen aledohna keima eihetsah jou pouve: amavang nangman naledoh theiding ahi; ajehchu nangma-a pathen thengho lhagao aumin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichun Belteshazzar kitipa Daniel chu nidan khat jen kidang satah-in aumin, chule aluggel chun asulung gimin ahi. Hichun lengpan, Belteshazzar, mang le aledohna chun nasulunggim hihhen, tin aseije. Belteshazzar'in adonbutnin, Ka pakai mang hi nahot te-a hihen, chule aledohna jonghi namelmate ho-a ding hijo hileh!
  </para>
  <para style="p">
    <verse number="20" style="v" />Thingphung nanamu-a, khang cheh cheh, hung kiphutdet, asan van gei phajeng, chule kolmong geija kimupha;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche thingdo hoisel ho, ga tamtah nei, chua ahingthei jouse dinga an aumna, anoija gamsaho achen na, chule abahho-a chungleng vachaho achen nachu:
  </para>
  <para style="p">
    <verse number="22" style="v" />Vo lengpa, hiche hung khang cheh cheh-a chule kiphut detna chu nangma nahi. Ajehchu naletna ahung khangin, chule van aphan, chule navaihom nan leiset mong aphatan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule lengpan angah-a mitheng khat van'a kona ahung nanamu-a, Thingphung chu phuhlhu uvin, chule sumangun, ahinla leija abul chu thihle sum-eng khaovin kanun lang, gamlah-a hamnou lah-a dalhauvin, chule hichu van'a daitwi chapkotnin umhen lang, chule achung chu phat sagin alhunkhum masangsen, ama chan chu gamlah-a saho chan hithahen, tia asei chu ahile,
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichehi aledohna ahi, Vo lengpa, hichehi chungnung pen thupeh, ka lengpa pakai chunga hunglhung thupeh chu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hitia chu amahon nangma mihem lah-a kona nadel mang dingu, chule nachenna mun chu gamlah-a gamsaho toh hitha ding, chule amahon bongchalho banga nangma hampa nanehsah dingu, chule amahon nangma van daitwija nasuhchet dingu, chule hiti achu nachunga phat sagi lhungding; nangman chungnung penin mihemte lenggama vai ahomin, chule hichu aman apehnompa chu apen ahi ti nahet masangse-a chuti ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule amahon hiche thingbul chu hoidenun tia athupeh chu, vanhon vai ahomna aneijui ti nahetdoh jou tengle nalenggam chu nangma-a hikit tei ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun, Vo lengpa, kathumop nahi nangma dingin santhei hihen; chonphat na-in nachonset naho subeijin, chule vaichate hepina-in nakhan gitlou naho subeijin. Chuti henlang hile nalung olna suhsaova umthei maithei ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hicheho jousehi leng Nebuchadnezzar chunga ahung lhungtan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lha somle lhani ahung kichaijin ama Babylon lenggam leng inpia avahlen ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lengpan thu aseijin, Hiche Babylon loupitah hi, kalenggam in dinga keiman kathahat kathaneina-a, chule kalalna hi jabola aumna dinga kasahdoh hilouham? ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lengpan thu asei nalaijin, van'a konin aw khat ahung gingin, Vo Nebuchadnezzar lengpa, hichehi nangma henga kisei ahi; lenggam hi nangma-a kona kitol manga ahitai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule amahon nangma miho lah-a kona nadeldoh dingu, chule nachenna chu gamsaho lah hiding, amahon bongchalho banga nangma hampa nanehsah dingu, chule mihemho lenggam-ah Chungnung penin vai ahomin, chule hichu aman apehnompa chu koihile apejie, ti nahet tokahse-a phat sagi nachunga lhung ding ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiche nidan mama chun hichu Nebuchadnezzar chunga aguilhungin ahi. Chule ama chu mihem lah-a konin delmangin aumin, chule bongchalho bangin hampa anen, chule amulho muvanlai mul abah-a, chule atinho vachaho tin banga akhan geijin, atahsa chu van'a daitwi suhchetnin aumtan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin nikhoho chu ahungbei phatnin, keima Nebuchadnezzar van lama kakhodah-in, chule kahetthem theina chu keima-a ahung kilekit tan, keiman chungnung pen chu kathangvah-in, chule keiman a-imatih chana hingjing, alengvai homna tonsotna lengvai homna hia, chule alenggam chu akhang akhanga hijingpa chu kavah choijin, jana kapen ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule leisetna chengho jouse chu imacha hilouva sim ahiuvin; Chule aman van'a galsat miho lahle, leisetna chengho lah-a alung deilam abolin: chule koimachan ama khut akhamtang joupon, chule ama henga, ipi nabol ham? jong ati theipon ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hiche phat mama chun kalunggel theina chu kahenga ahung kilekitnin, chule kalenggam loupina dingin, jabol kahinale kaloupina chu kahenga ahung kilekitnin: chule kathumop themho le kapipui hon keima eihung holdoh-un; chule nasatah-a jabolna chu keima-a eikibe peh-in ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tunvang keima Nebuchadnezzar'in van lengpa chu kavah choijin, kachoisangin, chule jana kapetai, Ama natoh jouse thutah ahin, chule alampiho jouse thudih ahi. Chule koihile kiletsahna-a kalsongho chu, aman asunem theijin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Belshazzar lengpan semang sangkhat ho din golvah lentah khat anabolin, chule chuche sangkhat maija chun ju adonin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Belshazzar'in ju atep pumchun, apa Nebuchadnezzar'in Jerusalem houin'a kona anapohdoh sana le dangka khonho chu; lengpa, chule apipuiho, a-inneipiho, chule athaikemhon ju adonna diuva agalahdoh diuvin thu apetan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahon Jerusalem'a um Pathen houin'a kona anakiladoh sana khonho chu ahinpodoh taovin; chule hicheho-a chun lengpa, chule apipuiho, ajite le athaikemho chun ju adon taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon ju adonun, chule sana, dangka, sum-eng, thih, thing chule songa kisem pathenho chu avahchoi taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche pettah chun mihem khutjungho ahung kilah-in, lengpa inpi bang kiloijol meivah gahsalna laitah chu ahin jihtan; chule lengpan bang hin jih-a khut keuseh chu amutan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin lengpa maiso akikhel jengtan, chule alung gimlheh jengtan ahile, akong kisuhtonaho akilong gamin, chule akhup teni khatle khat akitatto jengtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lengpan ahsi lekhathem ho, Chaldea miho, chule khonung thuseidoh ho chu ahinpuilut nadiuvin awging tah-in asamtan ahi. Chule lengpan thu aseijin, Babylon michingho jah-a chu, koihile hiche akijih simdoh-a, chule aledohna eivetsah theija chu, ponsandupma kivon ding, chule angonga sana vui ki o-peh ding, chule lenggam sunga thunei thum channa-a kipansah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin lengpa michingho jouse chu ahunglut taove. Ahinla amahon akijih chu asimdohthei pouvin, chule aledohna jong lengpa ahetsah thei tapouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichun Belshazzar lengpa chu hatah-in alungkham chehtan, ama-a chun amaiso akikhehtan, chule asemanghon kidang asataovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun lengnu chu lengpa le asemangho thusei ho jeh-in golvah insunga ahunglutnin, chuin lengnun hitin aseije; Vo lengpa, hing jingin: nalunggel ho chun nangma nagimsah hihhen, chule namaiso jong kikhelsah hih-in:
  </para>
  <para style="p">
    <verse number="11" style="v" />Nalenggam sunga hin pathen thengho lhagaoho umna pasal khat aumin ahi. Chule napa nikho laijin ama-a chun pathenho chihna tobang, salvahna, hetthem theina, chule chihna akimudoh-in; kaseipeh nahi, amachu Nebuchadnezzar lengpa, napa lengpa chun mitpheldoi choiho, ahsi lekhathem ho, Chaldea miho chule khonung thusei ho pipuija anapansah ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu lhagao kidangtah, hetna, hetthem theina, mangho ledohna, thulhuh hahtahho mudohsahna, chule lung opkai naho suhbeina chu, lengpan amin Belteshazzar anasah Daniel'a chun ana kimudoh-in ahi: tun Daniel chu kousah-in, chule aman aledohna navetsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Daniel chu lengpa anga puilutnin aumtai. Chuin lengpan Daniel henga aseijin, Judah gama kona kapan ahinpuidoh, Judah sohchangho chate lah-a Daniel kiti chu nangma nahim?
  </para>
  <para style="p">
    <verse number="14" style="v" />Keima nangma-a pathenho lhagao nangma-a aumin, vah le hetthem theina chule chihna nasatah nangma-a akimue, ti kanajan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule tutah chun michingho le ahsi lekhathem ho chu hiche akijih simdoh dingle, aledohna keima eihetsah dingin ka-angsunga ahung kipuilut un; ahinla amahon hiche thil ledohna chu avetsah thei pouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangman ledohnaho nabol theijin, chule lung opkai naho jong nasubei theije, ti nachung chang thu keiman kanajan ahi. Tun nangman hiche akijihhi nasimdoh theija, chule hiche aledohna chu neihetsah theija ahile, nangma ponsandup naki silpeh ding, nangonga sana khivui naki-o pehding, chule lenggam sunga thunei thum na-a nakipansah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin Daniel'in lengpa adonbutnin, lengpa angsunga hitin aseije, Nathilpeh ho chu nangma-a hihen, chule nakipaman ho chu midang khat pejon; hijeng jongle lengpa henga keiman akijih chu kasimdoh ding, chule akoma aledohna kahetsah ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo nangma lengpa, Chungnung pen Pathen'in napa Nebuchadnezzar chu lenggam, lalna, loupina, chule jana anapen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule aman lalna anapeh jalchun, mipi ho, namtin, chule paotin paotang jouse amasanga anakithing thingun, chule anakichauvin ahi. Aman athanom athatnin, chule ahinghoinom ahinghoijin, chule atundoh nom atungdoh-in, chule asuhlhuh nom asulhun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin ama alungsung ahung kichoi sanga, chule kiletsahna-in alungthim atahsah phatnin, ama aleng laltouna-a konin sotlhah-in ana umin, chule amahon ama-a konchun loupina ana lahdoh peh-un ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ama chu mihem chate lah-a konin deldoh-in ana umin; chule ama lungthim chu gamsaho lungthim tobangin akisemtan, chule achenna jong gam sanganho chenna chu anahi. Chule Chungnung pen Pathen'in mihem lenggam chunga hin vai ahomin, chule aman koi hile alunggot chanchu chuche chunga thunei dingchun atungdohjin ahi ti ahetdoh kahsen, amahon ama chu bongchalho bangin hampan avah-un, atahsa chu van'a kon daitwi suhchetnin aumin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule achapa, vo Belshazzar, nangman hitiho jousehi nahet jeng vangin, nalungsung nasunempoi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangma van Pakai dounan nakichoi sangin, chule amahon Pathen in'a khonho chu namasanga ahinchoijun, hicheho-a chun nangma le nasemangho, najite le nathaikem hon jun adonun; chule nangman khomulou, khojalou, chule, khohelou, dangka, sana, sum-eng, thih, thing, chule song pathen ho chu navahchoi jin: chule nahaina hu akhutna choipa, chule nalampi jouse neipa Pathen chu loupina napepon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pathen'a konin khut khat ahung kisolin, chule akijihhi ahinjih-in ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule hiche hi akijih ahung kisundoh chu ahi, MENE, MENE, TEKEL, UPHARSIN.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichehi athil ledohna ahi: MENE; Pathen'in nalenggam chu asimin, chule akichai sahtai.
  </para>
  <para style="p">
    <verse number="27" style="v" />TEKEL; khaikot ho-a nangma nakilep in, nalhahsamna akimudoh tai.
  </para>
  <para style="p">
    <verse number="28" style="v" />PERES; nalenggam akihom khenin, chule Medes te leh Persia te akipetai, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichun Belshazzar'in thupeh apen, chule amahon Daniel chu ponsandup asilpeh-un, chule sana khivui angonga a-opeh-un, chule ama chu lenggam chunga chu thunei thumna hiding ahi tin ama chungchang chu aphongjal taovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche jan tahchun Chaldea mite lengpa Belshazzar chu akithat tai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Media mi Darius chun kum somgup le kumni vel ahi-in lenggam chu alatai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Darius'in lenggam pumpi hopsoh-a, lenggam chunga chu pipui jakhatle somni koiding pha asan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lengpa chun kisuhmona aneilouna dingle, pipuiho chun suhtohna apeh theina dingun, hicheho chunga chun vaipipo thum akoijin, amaho lah-a chun Daniel hi akhatna ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ama-a chu Pakai lhagao dihtah aum jeh-in, hiche Daniel hi vaipipo hole pipuiho jouse chunga deitumin ahung umtan; chule lengpan ama chu gam pumpi chunga tundoh ding tia agel ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuphatnin vaipipo hole pipuiho chun lenggam chungchanga Daniel themona mudohna dingin agomkom aholtauvin; ahinla amahon phat gomkomle amona amujou pouve; ajehchu ama tahsan umtah ahin, suhkhel le mona jong ama-a akimulou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin hiche miho hin, a-Pathen danthu chungchanga ama douna-a athemmo nading imulou ngalule, eihon Daniel douna-a athemona imulou dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin hiche vaipipo hole pipu ho chengse chu lengpa henga ahung kikhomun, chule ahenga hitin aseijuve, Darius lengpa, hing jingin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lenggam sunga vaipipo ho, gamvai poho, chule pipuiho, thumopthem ho, chule gal lamkai ho jousen, Vo lengpa, koihile nisomthum sunga lengpa nangma heng tailou Pathen le mihem dang henga taona neichan chu, keipi bahkai hong sunga selut jeng dingin, leng thupeh khat phudoh-a, thugahna dettah semdingin kihoukhomna kaneijun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun, Vo lengpa, thupeh chu phutdoh-in, chule kikhel ngailou Mede le Persia mite thupeh dungjuija khela aum louna dingin, akijih chu soi kai khumin, atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun Darius lengpan akijih le thupeh chu soi akai khum tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun Daniel'in akijih chu soi akikai khumtai ti ahet phatnin, ama a-insunga alutnin; chule aumna indan bang kot ho chu Jerusalem lam nga-a kihong ahito lhonin, nikhatnin thumvei akhupma adilsun, ataovin, chule masanga abolji bangin, aman Pathen anga thangvahna aneijin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin hiche mihem hohi ahung kikhomun, chule a-Pathen ang sunga Daniel'in taona le thumna anei chu amudoh taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amaho ahung naijun, chule lengpa angsunga chun lengpa thupeh chung changthu aseitaovin; Vo lengpa, nangman koihile nisomthum sunga nangma heng tailouva, Pathen le mihem dang koma taona neichan chu, keipi bahkaiho kosunga selutna umding ahi, tia na soi nakai hitalou ham? atiuve. Lengpan adonbutnin, kikhel ngailou Mede le Persia mite dan dungjuijin, akisei chu adih-e, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichun amahon adonbutnun, lengpa anga chun, Vo lengpa, Judah sohchang chateho lah-a Daniel'in nangma, chule soi nakaikhum nathupeh chu nahsah-in aneipon, amavang nikhatnin thumvei taona anei jinge, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin lengpan hiche thuho hi ajah phatnin, amale ama aki oimo lheh jengin, chule Daniel huhdoh tei nading lungthim angaiton; chule nilhum kahsen ama huhdohna dingin athohgim lheh-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin hiche mihohi lengpa henga ahung kikhomun, lengpa henga, Vo lengpa, thupeh hile dankisun hile lengpan aphudoh chu kikhel thei lou ahi tia Mede mite le Persia miten dan anei ahi, tihi he-in, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichun lengpan thu apen, amahon Daniel chu ahinpuijun, keipi bahkaiho hong sunga aseplut taovin ahi. Tun lengpan Daniel jah-a, Tantih neilouva najen jing na-Pathen chun nahuhdoh hen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin song khat ahin domun, keipi bahkai hongsung akama chun akoijun; Daniel chungchanga tohgon chu akikhel thei louna dingin, lengpa amatah-in akhutjema sinkhana le asemangho khutjema sinkhana chu anam khum tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin lengpa chu aleng inpia achen, chuche jan chu an ngolna-in amangtan; tumging thei manchah ho jong ama anga akipolut thei tapon; chule a-imu tapon ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin lengpa chu jingkah matah-in athoudoh-in, chule keipi bahkaiho hong sung lam jonin gangtah-in achetai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule keipi bahkai hong chu agah phah phah-in, Daniel henga lunghemtah aw chengin agahsamin, Daniel henga, Vo Daniel, hingjing Pathen sohpa, nahinjen jing na-Pathen chun keipi bahkai ho-a kona nahuhdoh jou hinam? ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Daniel'in lengpa henga, Vo lengpa, hing jingin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ka Pathen'in avantil ahinsolin, amahon keima eisukhah louna dingun, keipi bahkaiho kam asip peh-in ahi: Ama angsunga monabei kahi akimu bangin, vo lengpa nangma angsunga jong keiman thilse kabolpon ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichun lengpa chu akipah tangeijin, chule Daniel chu keipi hongsunga kona agalahdoh dingun thupeh apetai. Hitichun Daniel chu keipi hongsunga kon chun aladoh-un, chule aman a-Pathen atahsan jeh-in, achunga kisuhkhahna imacha akimupoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin lengpan thupeh apen, amahon Daniel hehseho chu agapuijun, amaho toh, achateu toh, chule a-inneipi teo chu keipi bahkai hongsunga aseplut taovin; chuin keipi bahkai hon amaho chunga thanei tah-in, aguho jouseu tol chuman louvin asungemsel taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujouvin Darius lengpan leiset pumpi-a cheng mipite, namtinho, chule paotin paotangho henga hitihin lekha ajihtan ahi; nachung uva lungmonna punghen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Keiman thulhah khat kanei ahitai, kalenggam le kalalna gamsungse-a mihemte jouse Daniel Pathen anga kithing thingle ging geh-a naum dingu ahi. Ajehchu ama hingjing Pathen ahin, chule tonsotna longlou, alenggam chu suhmanga umlou ding lenggam ahin, chule alalna jong akhonna geija umjing ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman alhatdoh-in ahuhdoh-in, chule vanle leiset chunga melchihna ho le thil kidangho abolin, keipi bahkaiho thanei na-a konin Daniel ahuhdoh-in ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun hiche Daniel hi Darius lallai sungse, chule Persia mipa Cyrus lal laijin anaphatouvin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babylon lengpa Belshazzar kum masapenin, Daniel'in ajalkhun chunga alupna-a mang le gaothilmu ho aneijin: chuin aman amang chu ajihdoh-in, chule athilho umdol chu aseijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Daniel'in hitihin aseije, jana gaothilmu kamu chun jan ahin, chule veuvin, van'a kon hui li chu twipilen chun achoh thouvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin twipia kon chun sahem len tahtah jatchom cheh li ahungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amasapen chu keipi bahkai toh abangin, chule muvanlai lhavingho aneijin; alhavingho chu bodoh-a auma, chule ama chu leisetna kona dopsanga auma, mihem khat banga akenga akidinsah, chule mihem lungchang akipeh gei chu kanaven ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule veuvin sahem chomkhat, anichanna chu vompi toh abangin, chule amale ama alang khatna ahung kidom sangin, chule akam sunga ahakah-a chun nahgu thum aumin ahi: chule amaho chun chuche henga, thouvin lang saphe tamtah nen, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche jouchun keiman kaven, veuvin atungtuna vacha lhaving li neija lutnu tobang achomkhat kamui; hiche sahem chun luchang li jong aneijin, chule thuneina chu ama akipen ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche jouchun jana kathilmuho-a chun, Veuvin, sahem lina, tijat le kichat umtah, nasatah-a hat kamun; hichun thih-a kisem ha lentah aneijin; hichun anen ahalhalin achip bongin, chule amoh chu akengton achilin: hiche sahem chu amasa-a sahemho sangin achombeh-in, chule ki som aneijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman akiho chu kangaiton ahile, veuvin, alah uva chun kineo chom khat ahung mum doh-in, chuche masanga chun ki masa thumho chu ajunga konin bodoh-in aumin: chule veuvin, hiche ki-a chun mihem mit ho tobang aumin, chule thulen tahtah seidohna kam jong aume.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman laltounaho tundoh-a auma, chule khanglui laija patna umpehpa, avon buhbang banga bang, chule aluchang sam jong samul thengseh bang jengpa ahungtou geijin kagahmun ahi. Ama laltouna chu meikou deujeju, chule akang kolho jong chu mei-al tah toh abangin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Meikou luidung bangin ahung longdoh-in chule ama angsunga konin ahungdoh-in ahi. Asang asangin ama ajenun, chule sangsom jat sangsom ama anga adingun: thutanna chu gonsa ahitan, chule lekhabu ho chu akiphong kehtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin keiman hiche ki chun thu len tahtah aseiho jeh-in kagahven: chule sahem akitha-a, atahsa suhmanga, meikou deujeju henga akipehdoh geijin kaven ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sahem dangho sechu ahile, amaho thuneina chu lahdoh-in aumin; ahijeng vangin ahinkhou vang chu phatbihle phat khatna dingin akisusaovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman jana thilmuho kaneija chun, veuvin, mihem chapa tobang khat van meilomho toh ahungin, chule khanglui laija patna umpehpa koma ahungin, chule amahon ama chu ama anga ahinpui naijun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin mitin, namtin, chule paotin paotang jousen ajen theina dingin, ama chu thuneina le loupina chule lenggam khat akipei: ama thuneina chu tonsot thuneina ahin, chule hiche chu mangtalou ding, chule alenggam chu suhmanga umlou ding ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima Daniel hi katahsa lunggila lunggimin kaumtai, chule kalupna-a thilmu kaneiho hin eisugenthei jin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman adingho lah-a khat chu kagahnaijin, hicheho thudol jouse-a thutah chu ama kadongtan ahi. Hichun aman keima eiseipeh-in, chule thil ho ledohna chu keima eihetsahtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche sahem lentah lihohi, leisetna kona hung umdoh ding, leng liho ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla chungnung penpa mithengte chun lenggam chu alahpeh ding, chule amahon lenggam chu tonsot, atonsot chule tonsot geija alo dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin keiman sahem lina, adang jouse sanga chomdeh-a, tijat umtah, aha thih-a kisem, chule atinho sum-enga kisem; ahal halla chipgoija, chule amoh akengho-a chila;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule alua ki som umho, chule adang khat hungkeh doh-a, chule amasanga thum lhu-a; chule aki mitnei, chule akama thulen tahtah seidoh, akibahpiho sanga thahatjo thudola thutah chu het kanomin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman kaven ahile, hiche kimama chu mithengte toh akisatna, chule amaho chu ajoa,
  </para>
  <para style="p">
    <verse number="22" style="v" />Khanglui laija pat ana umpa ahunga, chule chungnung penpa mithengho themchan na-a thutanna akibol masangse chu kaven; chule mithengten hiche lenggam chu alo phatnu ahung lhungtan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman hitihin aseije, sahem lina chu leiset chunga lenggam lina chu hiding ahin, hichu lenggam ho jouse sanga achombeh hintin, chule leiset pumpi avallhum ding, chule achotnem ding, chule ahalhalla asuhngem ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche lenggama kona ki som hung umdoh chu leng li hung umdoh dingho ahiuve: chule amaho nunga chu adang khat hung umdoh ding, hichu amasapa toh banglouva achombeh hiding, chule aman leng thumho chu asuhlhuh ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule ama chun chungnung pen douna-a thu len tahtah aseidoh ding, chungnung pen mithengho chu asuhgenthei ding, chule phathole danho khelding ahinngaito ding ahi. Chule mithengho chu ama khutna phat khat, phat ho, chule phat kehkhat sunga kipedoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla thutanna chu toutei ding ahin, chule amahon athuneina chu akhonna geija suhgam dingle suhmanghel dinga alahpeh dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuche lenggam le thuneina, vannoi pumpi-a lenggam loupina chu chungnung penpa mithengte hochu kipe ding, chuche lenggam chu tonsot lenggam ahin, chule lenggam jousen ama ajenuva athu angai dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichanhi athu kichaina ahitai. Ahin keima Daniel vang, kalunggel hin eisugim lheh-in, chule kamel jong akikhel jengin ahi; hijongle athuhi keiman kalunggil sunga kakichin tupmin ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Belshazzar lengpa lengchan kal kum thum lhinna-in, keima Daniel, keima tah henga thilmu khat, amasa hung kilangdohpa nungin, ahung kilangdoh kitnin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin keiman gaothilmu-a chun: chule ahitin ahi, keiman kamu-a chun, keima Elam gamkai sunga um Shushan leng inpia kana umin; chule keiman gaothilmu-a chun, keima Ulai vadung kama kanaum kamun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin keima kakhodah-in, chule veuvin, vadung panga chun aki ni nei kelngoi chal khat anading kanamun: chule chuche ki teni chu asangin; ahin khat chu khat sang chun asangjon, chule asangjopa chu ahungdoh nunung jon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin kelngoi chal ama anga gamsaho khatcha ading thei aumlouna dinga lhumlam, sahlam, lhanglama, ano-a; imacha ama khutna kona huhdoh jou aumlou; ahivanga aman alung deilam lam abola, ahung letdoh lheh jengchu kamun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman kalung kagel laitah-in, veuvin, lhumlama konin keltah chal khat leiset pumpi chunga ahungin, chule amachun tol atongkha pon: chule hiche keltah hin amit teni kah-a ki kilangtah khat aneije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule ama chu keiman kamu aki ni nei kelngoi, vadung panga anading heng lama chun ahungin, chule aman athaneina pumpin ama chu adel jengin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule aman kelngoi chal henglam ahinnai kamun, chule achunga alunghang lheh jengin, kelngoi chal chu atatnin, aki teni asuhbohpeh tan ahi. Chule kelngoi chal chun ama anga din jouna ding thaneina aneipon, ahinla aman ama chu tolla asulhun, achungu chu achilin: chule ama khutna kona kelngoi chal huhdoh ding koima aumpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun keltah chal chu ahung loupi lhehtan: chuin ama ahunghat phatnin, aki lentah chu abongtan; chule akhelin kilangtah ki li van'a hui li nunna lam ngan ahung kehdoh-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amaho lah-a khatna konin kineo khat ahungdoh-in, hichu lhanglam, solam, chule gam nomtah lam ngan hatah-in ahung lenin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin hichu van janel ho lah geijin ahung lenin; chule hichun janel phabep le ahsi phabep tolla ahin pailhan, achungu chu achilin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Henge, amale ama chu janel ho pipupa toh kibang khopmin akichoi anin, chule aman nitin ganlhaina thilpeh chu alamangin, chule Ama muntheng umna jong chu asulhun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ama chu, suhkhel jeh-a nitin ganlhaina thilpeh douna dingin janel khat akipen, chule hichun thutah chu tolla aseplhan: aman hichu abolin, chule aphatouvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin keiman mitheng khatnin thu asei kajan, chule mitheng dang khatnin mitheng thuseipa henga chun, nitin ganlhaina, suhkhelna jeh-a manthaina, muntheng le galmi janel agoma kenga chotpha-a umdinga pehdohna phat chungchanga gaothilmu hi itihchan hiding ham? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman kahenga, ni sangni le ni jathum gei hiding; chujouteng muntheng chu kisutheng ding ahi, tin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahung hitin ahi, kei, Daniel keimatah ngeijin thilmu chu kanamua, chule ipi kiseina ahi kahol chun, hichun veuvin, ka-ansunga mihem melput tobang pu khat anadingin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keiman Ulai vakam chekah-a mihem khat awgin kajan, awgin chun akouvin, ahenga, Gabriel, hiche gaothilmu hi hiche mipahi hetthem sah-in, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitichun ama kadinna mun koma ahungin ahi: chuin ama ahung phatnin kakichatan, kalhun tolla kamai kasulut tai. Ahinla aman keima henga, Vo mihem chapa, hethemin: ijeh inem itileh gaothilmu hi phat kichai tenga ding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun aman eihoupi laijin, keima kamai tollam ngan nomtah-in ka-imun ahi. Ahinla aman eihin tongkhan, chule eidindoh sah-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman kahenga, ven, keiman nangma lungdamlouna akichaina lamle ipi hunglhung ding ham ti kahetsah ding nahi: ajehchu akitep phatna chu achaina hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kelngoi chal ki ni nei namu chu Media le Persia lengte ni ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule keltah sousetah chu Greek lengpa chu ahi: chule amit teni kah-a ki lentah um chu leng masapenpa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun hiche ki kisuhbong le akhela li hung dondoh chu, hiche nam'a kona chu lenggam li hung umdoh ding; ahivang ama thahatna vanga hilou ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amaho lenggam kichailam, suhkhelna neiho ahung pilhin teng, amel tijatjat umtah le thuguh hetthemna nei leng khat hung dingdoh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule ama thaneina chu lenlheh ding ahin, ahinla amatah thaneina jal ahipoi. Chule aman kidangtah-a asuhmanga, chule khangtou ding, chule hitia chu abola thahat hole mithengho asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule ama thilgon jala jong akhut noija doha le joule nal apunsah ding; chule alunggil sunga amale ama kichoi-an ding, chule chamna-a kona mi tamtah asuhmang ding ahi. Ama chu pipuiho pipuipa douna-a hung dingdoh ding, ahivanga ama chu khut panglouva kisubong ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule nilhah le jingkah gaothilmu-a kimu kisei chu atahbeh ahi. Hijeh chun nangman gaothilmu hi imchah-in, ajehchu nikho tamtah nunga hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichun Daniel keima lhasamin kalhu-in, ni ijat ham damlouvin kaumtan; chujouvin keima kathoudoh-in, chule lengpa na chu katong kit tai. Chule hiche gaothil muhi kidang kasan, ahinla koimachan ahethempoi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chaldea gam pumpi chunga lenga kipansah, Medes chilhah Ahasuras chapa Darius lengchankal kum khatna-in,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman lengvai apoh akum khatna-in, Daniel keiman Pakai thu Jeremiah themgao henga ahunga, Jerusalem manthah na-a kum somsagi aman asuhbulhit ding ahi tia aseina lekhabu ho-a akumho jat chu kahechentan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin keiman an kangol-in, khaodip pon kakisil in, vut kakinun, taona le thumna neidingin Pakai Pathen lam kangatnin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin keima Pakai ka Pathen henga kataovin, chule kamona kaphongin, kaseije; Vo Pakai, loupitah le tijat umtah Pathen, ama ngailuho le athupeh ho nit te-a dinga kitepna le hepina koipa;
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiho kachonse taovin, kachonkhel taovin, giloutah-in na katongun, chule kakiphin un, nadan thupeh ho le nathutan naho geijin kajamsan taove:
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangma mina kaleng hou, kavaipo hou, kapate hou, chule gamsunga miteho jouse henga thu hinsei nalhacha themgaoho thusei jong ngaisah-in kaneipeh pouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Pakai, chonphatna chu nangma-a ahin, hinla keiho, Judah mite, Jerusalem'a cheng miho, chule Israel pumpi naija hihen gamla-a hijongle, amahon nangma douna-a dan asuhkeh uva, adan suhkehna hou jeh uva nangman nana nodohna gam jouse-a umho dingin vang, kachanu hi tunikho-a banghin mai jum na ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai, nangma douna-a kachonset jeh uvin, keiho, kalenghou, kavaipohou chule kapu kapatehou ahin, mai jum na kachang taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama kadou jeng vanguvin, hepinaho le ngaidamna chu ka Pakai Pathen uva ahin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman alhacha athemgaoho-a kona kamasanguva akoi dan thupeh ho-a kalamlha pouvin, ka Pakai Pathen'u aw jong chu kanangai pouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahi, Israelte jousen na aw angailouna dingun nadan thupeh apalkeh-un, achemangun; hijeh-a chu sapsetna le Pathen soh Mosi dan thupeh-a kisun hahselna chu kachunguva kisunglha ahitai, ajehchu ama dounan kachonse taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule aman kachunguva thilse nasatah alhunsah-in, keiho le kathu-u tana kathutan hou douna-a athusei dohho chu kachunguva asuhdetnin ahi; ajehchu Jerusalem chunga kibol tobanghi vannoi pumpi-a anakibol khapon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi danthupeh-a kisun bang ngeija, hiche thilse jousehi keiho chunga lhunga ahitai. Ahijeng vangin kakhan gitlouna houva kona kakiheidoh theina dingule, nangma thutah kahetthem theina dingun, Pakai ka-Pathen'u anga keiho kanatao pouvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun Pakaiyin thilse chu aven, kachunguva alhunsahtai. Ajehchu Pakai ka-Pathen'u chu aman atohdoh thil jouse-a chonphatah ahi: keihon athu kangailou jeh-u ahibouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule tun, Vo Pakai ka-Pathen'u, khut thahat tah-a namite Egypt gama kona hinpuidoh-a, chule tunia banga amin ana kithangpa; keiho kachonse taovin, chule giloutah-in na katong taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo Pakai, nachon phatna ho jouse dungjuija kangeh nahi, nalunghanna le nalungsatna chu nalhang theng, Jerusalem khopi-a konin kiheidoh tahen: ajehchu keiho chonset jehle kapu kapateu khan gitlou jeh-in, Jerusalem le namite hi kaveluva umho jouse i-sah louvin kaum taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun tun, Vo ka Pathen'u, nasoh taona le athumna hi ngaipeh-in, chule amangthahsa namun theng lama hin Pakai jal-in namaiso chu hinvah sah-in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo ka Pathen, nana hinsungin lang ngaijin; namit teni hin hasah inlang, kaman thainao le namina kivo khopi hi hinven: ajehchu kachon phatnao jeh-a na-anga kathumna hou hi hinlhutna kahipouve; ahinla nami hepina haotah jaljoh ahibouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Pakai, ngaitemin; vo Pakai, ngaidamin; vo Pakai, ngaijin lang tongdoh-in; Vo ka Pathen nangma jal-in geisang hih-in, ajehchu nakhopile namitehi namina kivo kahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin keiman thu kaseija, kataova, chule keima chonsetna le kami Israelte chonsetna kaphona, chule ka Pathen lhangthenga dinga kathumnaho Pakai ka Pathen ang kalhut petchun;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahi, keiman taona-a thu kasei petnin, keiman gaothilmu kanei tila kipatna kamu mikhat Gabriel chu gangtah-in ahung lengin, nilhah ganlhaina phat velin keima eihung thamin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin aman keima eihetsah-in, eiki houlimpin, aseije, Vo Daniel, tuahi keima nangma hetgilnale hetthem theina pedinga kahungdoh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangman thumna naneipat tila chu thupeh chu hung kipedoh-a, chule nangma hetsah dinga keima hunga kahi; ajehchu nangma ngailut umtah nahi. Hijeh chun thil umdan hi hethemin lang, na gaothilmu chu ngaitophan.
  </para>
  <para style="p">
    <verse number="24" style="v" />Suhkhelna kichaina ding, chonset suhbeina ding, khan gitlou jeh-a kichamna kisem nading, tonsot chonphatna hinpohlutna ding, gaothilmu le gaothu kisei sinkhana ding, chule theng chungnung pen thao kinuna dinga, namite chungle nakhopi theng chunga hapta somsagi kiteppeh ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun henlang chule hethemin, Jerusalem sahphatna aumkit dingle akiledoh kitna dinga thupeh ahungdoh-a patna leng chapa Messiah gei chu, hapta sagile hapta somgupleni hiding ahi. Khopi lamlen le kulbang chu phat hahsa sunga kisadoh kit ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule hapta somgupleni jouteng Messiah chu kisatlha ding, ahinla ama le ama ding ahipoi: chule ahung umding mipiteho leng chapa chun khopile muntheng chu asuhbei ding; chule hichu twisangletna hung kichai ding, chule gal hungkichaina geija dinga manthaina kiteppeh ahitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule aman kitepna chu mi tampi toh hapta khatna dinga asudet ding, chule chuche hapta kimtuhtah chule aman ganlhaina le thilpeh asuh haiding, chule thet umtahho akithejal behseh jeh-a aman akhonna geija suhmanga aumsah ding, chule hiche gotsa suhmangna chu amanthainao chunga kisunlhah beding ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Persia lengpa, Cyrus lengchan kal kum thum na-in thilkhat Daniel, Belteshazzar tia kimin vopa henga phondoh-in ahung umin; chule athil chu tahbeh ahin, ahinla aphat kitep vang chu asaove. Chule aman athil chu ahethemin, chule athilmu chunga chun hetthem theina aneije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuche laichun keima Daniel'in hapta thum lhingset kana lunghemin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman hapta thum alhin kahsen, anneh tuijong kanepon, jule sa jong kakama alutpon, chule hapta thum alhin kahsen thao jong kakinu khapoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule lha masapen nisomni le nili nin keima Hiddekel kite vadung lentah panga kana ume.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin kagakhoda-a, kagahvetle, pasal khat tupat pona kivona, uphaz sana thengsetna atai kigeh khat kamun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Atahsa chu songmantam engdum abangin, chule amaiso chu kolphe abangin, amit teni chu meikou kide abangin, abanho le akengphangho chu sum-eng kinot valset abangin, chule apaodoh gin jong mipi tamtah awgin abang jengin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima Daniel'in bou thilmuhi kamun; kana umpi pasal hon thilmuhi amupouve; ahinla kichatna nasatah achunguva achun, chutichun amaho gakisel dingin ajammang gam taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun kachangin eikidalhan, chule hiche thilmu loupitah hi kamun, tha himhim kanei tapoi; ajeh chu kamel lomna jouse asesoh-in, katha jouse jong abeiheltan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Achutijeng vang chun keiman ama thusei awgin chu kajan; chule ama thusei awgin kajah petchun keima nomtah-in ka-imun, kamai tolla kasulutnin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin veuvin, khut khatnin eihin thamin, hichun kakhup teni le kakhut phang teni kingamin eidindoh sah-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman kahenga, ngailut umtah, vo Daniel, nahenga kathuseiho hethemin, chule ding jangin: ajehchu nangma henga keima eihin kisol ahi, tin aseije. Aman hichu asei phatnin, keima kithing pumpumin kadingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin aman kahenga, Daniel kicha hih-in: ajehchu nalunga nahet them theina dinga chule na Pathen angsunga kisehgim dinga nalung napehpat nikho-a patna chu nathuseiho kingaipeh-a nahitan, chule nathuseiho jala chu keima hunga kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla Persia lenggam pipuipan nisomni le nikhat eina lamtine; ahinla veuvin, pipuiho lah-a khat Michael eipanpi dingin ahungin, chule chua chun Persia lengho toh kanaum khome.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuahi phat nunung lama namite chunga ipi hunglhung ding ham ti nangma hetsah dinga keima hunga kahi: ajehchu gaothilmu chu nikho tamtah nunga ding ahinalaije, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman hiche thuho kahenga asei chun, kamai tollam kangan, chule keima paomon kaumtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule veuvin, mihem chapate kilopi khatnin kamuh ahin thamin ahi: chuin keima kakam kan, ka-anga dingpa henga chun, Vo ka Pakai, thilmu hin kachunga lunggimnaho eihinlhut peh-in, tha himhim jong kanei tapoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu hiche ka pakai sohpa hin ka pakai hi iti akihoupi theiding ham? Keima kahile vang, hiche pettah chun keima-a tha le haina thei himhim aumtapoi, katitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin mihem melput tobang pu-a khat ahung kitnin, eithamin, eihatsah-in,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule kajah-a, Vo ngailut umtah mihem, kicha hih-in; nachunga lungmon umhen, hatnin, henge, hatnin ati. Aman kahenga thu ahinsei phatnin kahung hatdohtan, chule ahenga, nangman neisuh hattah jeh-in, ka Pakaiyin seitan, kati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujouvin aman kahenga, nahenga kahung lona ajeh nahet em? Chule tuahi keima Persia pipuipa toh kisat dinga kakile kit ding ahi: chule keima kachedoh nungle, veuvin, Greek pipuipa hung ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla thutah thutheng bu-a kijihlutsa anaum chu keiman nangma kavetsah ding nahi. Chule hiche thilho-a hin napipui pao Michael tailou keima eipanpi koima aumpon ahi, ati.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mede mipa Darius lengchan kum masapa sungin, keima ngei jong ama sudet dingle suhat dingin kanadingin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule tu-a hi keiman thutah chu nangma kahin vetsah ding ahi. Veuvin, Persia gama leng thum hung dingdoh kit nalai ding; chule amaho jouse sanga alina chu gam chenga hung haosajo ding ahi. Chule aman ahaonaho le athahatna jala Greek lenggam doudinga mijouse achothou ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule leng thahat tah hung dingdoh-in tin, ama chun thaneina lentah toh tho-a vai ahinhoma, aman alungdei dungjuija abolding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ama ahung dindoh teng, alenggam chu hung kehding, leiset kolningli-a hopkhena umding; ama sonle pahho henga hilou ding, chule ama vaihomna gamkai dungjuija jong hilou ding ahi. Ijeh inem itile hicheho chengse tilouva adangho dinga jong ama lenggam chu suhlhah-a umding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule lhanglam lengpa chu hung hatdoh ding, chule apipuiho lah-a khat toh; chule ama chu amapa sanga hung hatjoa, lenggam anei ding; alenggam chu lenggam lentah hung hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule kumho ahung kichai lamteng amahole amaho hungkigom khom ding ahi; ajehchu lhanglam lengpa chanu chu sahlam lengpa henga kinoptona sem dinga hung ding; hijongle amanu chun ban thahatna chu atuhden lou ding; amapa ahia, chule amapa ban ahia ding lou ding ahi. Amavang amanu chu amanu hinpuiho, amanu hingpa, chule hicheho phat laija amanu ana suhatpa toh pehdoh-a umding ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijongle amanu jungho bahkhatna kona amapa mun lo ding khat hung dingdoh intin, ama chun galmi hon khat ahin kilhonpia, chule sahlam lengpa kulpi sunga hunglut uva, amaho akidoupi dingu, chule ajo dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Egypt gama sohchang dinga a-pathen hou, apipuihou toh, sana le dangka-a kisem akong le belu manlutah ho chu apohlut ding; chule amapa chu sahlam lengpa sanga kum tamjo umpeh nalai ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutia chu lhanglam lengpa chu amapa lenggama chu hunglut ding, chule ama agama kilekit ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla achapate chu suh thouvin hung umuntin, chule galsatmi mihonpi nasatah ahin khopkhom dingu: chule khat chu thonlouva hunga, ahinlonvuh ding, chule ajotpai peh ding: chuteng akulpi-a hungkile kitna, kitomona asuhthou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuteng lhanglam lengpa chu alaigil kisun bangin tin, chule hungkon doh-a sahlam lengpa chu akisatpi ding: aman mihon tamtah ahintoldoh ding, hijongle mihonpi chu ama khutna kipelut ding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman mihonpi chu apuimang teng, alungsung hung kichoisang ding; chule aman sangsom tamtah asuhlhuh ding: hijongle hichun ama asuhhat chom louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ijeh-inem itile sahlam lengpa chu hung kile kitnin tin, chule amasa-a sanga mihonpi tamjocheh ahintoldoh ding, chule thonlouva kum phabep joutengle galsat mi nasatah le haona tamcheh toh hungtei ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche phatlai teng chule mi tamtah lhanglam lengpa kidoupi ding dingdoh dingu ahi. Namite lah-a gucha michomho jong agaothilmu-u guilhunsah dinga hung kichoisang dingu; hijongle amaho lhuding ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun sahlam lengpa chu hungintin, chule molsang khat atundoh ding, chule kulpi kikai khum dettah khopiho chu alah ding: chule lhanglam mite hatna ananjou louding, alhentum mihon jong anan joulou dingu, nanjouna tha himhim aneilou dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijongle ama kidoupi dinga hungpa chun alungdei deija abolding, chule koimacha ama anga dingjou umlou ding ahi. Chule ama gam loupitah sunga chu hung ding ding, hichu akhut ngeija asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama chun alenggam pumpi thahatna le chondihho toh kitho-a hung lutding agot ding, hitia chu ahinbol ding ahi. Chule aman hiche sumang dinga chu numei ho chanu chu amapa apehding; ahivanga amanu amapa langa panglou ding, chule amapa-a ding jong hilou ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichejou tengle aman twikolho lam ahin maingat ding, chule tamtah ahinlah ding ahi. Ahivanga pipui khatnin ama kihousetna chu asuhtang ding; ama kihousetna umlouva hichu amapa chunga chukit ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle amapan amatah gamsung kulpilam chu ahin maingat ding: ahivanga ama chu kipal lhuding, chule kimu lou ding ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujou tengle amapa mun'a chu lenggam loupina-a kai dong khat hung dingdoh ding ahi. Hijongle ni phabep sunga lunghanna jeh le gal kisatna jeh-a jong hilouva, ama chu suhmanga umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ama mun'a chu thet umtah mi khat hung dingdoh ding, lenggam jana chu amahon ama apeh lou dingu ahi: ahinla ama chu chamna choijin hungintin, chule lenggam chu aman phatlhem na-a akimu ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule amaho chu a-angsunga kona twisanglen thahatnin alonvuh uva, chule suhsetna umding ahiuve; henge, kitepna pipuipa jong chutiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amato kiloikhomna akisem joujoule aman jonchihtah-a na ahintoh ding ahi. Ajehchu ama hung kipandoh-in tin, mi phabep khat toh hunghat dohding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama chu gamkai sunga mun phatah ho-a chu chamna ahin choija hungding; chule ama chun apate, chule apate pateuvin jong anabolkhah louvu chu ahinbol ding ahi. Aman galthil kilaho, galthil kichomdoh ho, chule haonaho chu amaho lah-a ahinthejal ding ahi. Henge, phat khat sunga dinga mundet ho douna dinga thilgonho angaito ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman lhanglam lengpa kidoupi dinga galsat mihonpi nasatah toh kitho-a athaneinale ahansanna chu ahinsuhthou ding; chule galsat mihonpi nasatah le thahat tah toh kidou dinga lhanglam lengpa chu suhthouva hungum ding; hijongle ama dingjou lou ding ahi. Ajehchu amahon ama douna-a thilgon tampi ahinnei dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Henge, ama chan anneh neho chun ama asuhmang dingu, chule agalsat miho chu lonvuh-a hungum uva, chule tamtah tha-a umding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule hiche leng teni lungthim chu setna bolna dinga hung kipeding, chule amanin dokhang khatna jouthu aseilhon ding; ahivanga hichu lolhing lou ding ahi. Ajehchu akichaina chu phat kitep alhun teng guilhung ding bou ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chujou tengle ama haona thil tamtah toh agamsunga kile kitnin tin; chule alungsung chu kitepna theng douna hung hiding; chule aman suhsetna na atoh-a, ama gamsung ngeija kile ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Phat kitepsa ahunglhun tengle ama hung kilentin, chule lhanglam jonna hung ding; ahivanga hichu amasa ahiloule anunungjo tobang hilou ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ijeh-inem itile Chittim kong inneiho chu ama toh kidou dinga hungding ahiuve. Hijeh-a chu ama lungphamo ding, hungkile kit ding, chule kitepna theng douna-a thangtom lhehding; chutia chu abolding ahi. Ama hungkile kitna, chule kitepna theng jamsanho khohsahna ahinnei ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule galsat miho chu ama lama hung dingdoh uva, chule amahon thahatna muntheng chu ahin suhboh dingu, nitin ganlhaina chu alahmang uva, chule chumuna chu suhgamna boldoh-a thet umtah chu akoi dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule kitepna douna-a gilou tah-a thilbol hochu aman pachat lhem-a asuhboh ding: amavang a-Pathen he-a mipi hochu hatdoh uva, chule natoh lentah ho atohdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule mipi lah-a ahethemho chun mi tamtah ahilchet dingu: ahijeng vanga amaho nikho tamtah chemjam'a, meikouva, sohchan na-a, chule galthil kichomna-a lhuding ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule amaho ahunglhuh tengule kithopina themcha bou amu dingu: ahivanga mi tamtah chu pachatlhema amaho-a beh dingu ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule hetthem theina neiho lah-a phabep chu akichaina phatchan geija lhitchil, suhtheng, soptheng, chule bansah ahi nadinguva lhuding ahiuve; ajehchu aphat kitepsa chu ngah jinga umnalai ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule lengpa chun ama lunglam lamin thil ahinbol ding; chule ama chu amale ama hung kidomsanga, chule amale ama pathenho jouse sanga hung kichoisang ding, chule pathen ho Pathen douna-a thil kidang dang ahinseidoh ding, chule thangtomna chu suhbulhit ahi kahse-a phatou ding ahi. Ajehchu ahidinga kigel lhusa chu kitongdoh tei ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ama chun apu apa teho Pathen ahin, numei ho lungdeilam ahin, chule ipi pathen hijongle ngaisah-a aneilou ding ahi. Ajehchu imajouse chunga amale ama kichoisang ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahivanga aman aumna mun'a hatna Pathen chu jana apeh ding; chule apu apa tehon anahet khah louvu pathen khat chu aman sana, dangka, chule songmantam ho chule dei umtah thilho-a jana apeh ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chutia chu aman gamdang pathen toh kitho-a kulpidet ho douna-a na atohding, aman hichu ahetpeh-a chule aloupina aphatou sah ding: chule aman amaho chu tampi chunga thuneina aneisah-a, chule leiset chu man neija ahopkhen ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule akichaina phat teng lhanglam lengpan ama chu ahin nokhum ding: chule sahlam lengpa chu ama doudinga chimpei banga, sakol kangtalai ho toh, sakol chung chongho toh, kong innei hotoh hung dingu; chule ama chu gamsungho-a hunglut ding, chule alonvuh khuma, chepai ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ama gam loupi sunga jong hunglut ding, chule gam tamtah suhlhuh-a umding ahi. Ahinla hiche Edom, Moab chule Ammon chateho bulpi ngeihi ama khutna kona hoidoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Aman gamho chunga jong aban ahinjah ding: chule Egypt gam hoidoh lou ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aman Egypt gam thil manlutah ho, sana le dangka gouho jouse chunga tha aneiding; chule Libya mitele Ethiopia mite chu ama kalsona channa umding ahiuve.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hijongle solamle sahlama kona thusoh ho chun ama alungkhamsah ding: hijeh achu ama lungsa tah-a asumang dingle mihem tampi gamsahhel dinga kipandoh ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule aman aleng inpi houbuhho chu twipiho le loupitah molsang theng kikah-a ahin tundoh ding: ahijeng vanga ama akichaina hunglhung ding, chule koimachan ama akithopi lou ding ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule chuche phat teng chule namite chate-a dinga dingjing pipui lentah Michael chu hung dingdoh ding; chule nam khat ahung umdoh-a patna chuche phat changeija ana umkhalou gim hesohna phat khat hungum ding ahi. Chule chuche phat teng chule namite chuche lekhabua amin kijih kimuse chu huhdoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule leivui lah-a imuho chu, kimkhat tonsot hinna, chule kimkhat jachatna le tonsot themmo na-a hung thoudoh dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule michingho chu vanthamjol vah banga vah ding ahiuvin; chule mi tamtah chonphatna lama lepuite hochu atonsot atonsotna ahsi ho toh bangdiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla Vo Daniel, nangman phat kichai tokah-a din thuho hi khah chah-in, chule lekhabu chu sinkha khumin: mi tamtah hung suhlhai hungtou lhaijuntin, chule hetna hung khangtou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin keima Daniel'in kaven ahile, veuvin, achomdang ni ana dingin, khat chu vadung pang hilam sanga aumin, chule khat chu vadung pang khulam sanga aumin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin khat chun tupat pona kivona vadung twiho chunga umpa henga chun, hiche thil kidangho kichaina ding chu ichan sot nalai dingham? ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin keiman tupat ponna kivon vadung twiho chunga umpa chun akhut jetlam le veilam chu van lama adop sanga, atonsotna hingjingpa mina akihahsela, Hiche thilho jouse kichaina dingle, aman mithengho thahat asuhcheh nading phat lhina ding chu phat khat, phat ho, chule phat keh hiding ahi, tia asei kajan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin keiman thu kisei chu kajan, ahinla kahetheipon ahi: chujouvin keiman, Vo ka pakai, hiche thilho kichaina dinghi ipi hintem? kati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman, Daniel nachena dinga chetan: ajehchu phat kichai kah-a dinga thuho hi kikhah-a, kisinkha-a ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mitamtah kisuhthenga, bangsetna ki-umsah-a, chule kisuchil ding ahi; hijongle khanggilou chu gilou jing ding: khanggilou koimachan ahetthem louding; amavang michingin ahetthem ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nitin ganlhaina lahmanga ahung uma, chule suhgamna thet umtah ahung kitundoh-a patna chu ni sangkhat le nijani le somko umding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni sangkhat le ni jathum le somthumle nga ngah jinga, chua hunglutna michu anunnom ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla akhonna ni ahikah-in nangma nachena dinga chetan; ajehchu nangma nakichol do-a, chule nikhoho kichaini leh navang channa-a nadin ding ahi, ati.
  </para>
</usx>
