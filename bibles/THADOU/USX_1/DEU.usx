<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="DEU" style="id">Danbu</book>
  <para style="h">Danbu</para>
  <para style="toc1">Danbu</para>
  <para style="toc2">Danbu</para>
  <para style="mt">Danbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche thuho hi Mosi'n Israelte jouse henga Jordan gal gamthip hilam sang, twipisan gal Paran le Tophel, Laban le Hazeroth, chule Dizahah kikah phaichama asei ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />(Seir molsang lampi jotna-a ichele Horeb'a pat Kadesh-barnea gei chu nisomle nikhat lam ahi.)
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin kum somli lhin na-in ahitin ahi, lhasom le lhakhat lhina, chuche lha nimasa nichun, Pakaiyin amaho peh dinga ahenga athupeh jouse dungjui chun Mosi'n Israel chate henga aseijin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichu Heshbon'a cheng Amor lengpa Sihon le, Edrei sunga Astaroth'a cheng Bashan lengpa Og atha jou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Moab gam sung Jordan pang hilam sanga, Mosi'n hiche danthu hi aphongdoh panin, hitin ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai i-Pathen'un Horeb molsanga chun ijah uva aseijin, Nangho hiche molsanga nachamsot behseh taove:
  </para>
  <para style="p">
    <verse number="7" style="v" />Kiheijun lang, nakholjin ban jom taovin, chule Amor mite molsang le akom naija um mun jouse-a, phaichama, thinglhanga, dama, lhanglama, chule twilen panga, Canaan mite gama, chule Lebanon gei, twipi, Euphrate vapi geijin cheovin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Veovin namasanguva gam kakoi peh uve; Pakaiyin napu napateu Abraham, Isaac, Jacob henga pehding le amaho nunga achilhahte peh dinga ana kihahsel nagam chu galo taovin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche laichun naheng uva kana seijin, Keiman kachang seh-in nangho napojou pou vinge;
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai na Pathen'un nangho napunsah taovin, chule veuvin, tunvang natam danu chu van'a ahsi ho jatjen nahitaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />(Napu napateu Pakai Pathen'u chun athutep bangin tu-a sanghin ajat sang khatnin napunsah beu henlang, phatthei naboh-u hen.)
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei changseh in naboinao, napohgih-u, nakiphin nao iti kapohjou dingham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanghon naphung sunguva michingho, ahethemho, chule mihet ho lhengdoh unlang, keiman amaho chu nachung uva vaihomin seminge, tin kanaseijin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nanghon, Nangman naseiho hi keihon kabol dinguva pha ahi, tin neidonbut un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun keiman naphung pipuihou, michingho, mihet ho chu kalheng doh-in, nachung uva vaihomin kapansah-in, sangkhat chunga, jakhat chunga, somnga chunga, chule somkhat chunga lamkai dingleh, naphung sunguva vaipon kapansah tan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hiche laichun keiman nathutan vaihomhou chu thu kanapen, ajah uva, Nasopi ho kah-a aboina hou chu ngaipeh unlang, mijouse leh asopipa kikah, ahiloule nalah uva um gamdangmi kikah-a chun chonphat na-in thu tanun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thutan na-a maipha navetlou dingu; amavang alen thu nangai banguva aneo thujong nangaidiu; mihem maija kichatna naneilou dingu ahi; ajehchu thutanna chu Pathen'a ahi. Chule nangho dinga thuhahsa behsetho chu kaheng hinlhutnun, keiman ngailha nange, tin kana seijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiche laichun keiman naboldiu jouse kana thupeh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakai i-Pathen'uvin thu einapeh bangun, Horeb molsanga kon ikipatdoh-un, Amor mite molsang lampia namu-u gamthip lentah le gimneitah jouse chu ijot lhung keijun, chuin Kadesh-barnea iga lhung taove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin keiman naheng uva, Nangho Pakai i-Pathen'uvin eipehnao Amor mite molsang chu nalhung taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Veovin, Pakai na Pathen'un namasanguva gamchu nakoipeh uve. Chetou vinlang napu napateu Pathen'in naheng uva aseibangin galo jengun; kicha hih-un, lungjong lungthoi hih-un, tin kanaseijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule amitakip kahenga nahungnaijun, kajah-a, Keihon imasanguva mi solung ting, amahon gam chu gakhol toh-uhen lang, ipi lampia ichetou uva, ipi khopi-a ilut diuham? tithu hinpo hen, nati uvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule akisei chun eilung lhaisah lheh-in; chuin keiman nalah uva mi somleni, phung khatna mikhat cheh kalheng doh-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amaho akiheijun, molsang lama chun akal touvun, Eshcol phaichama ahungun, akholle taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amahon agamga akhutnun ahin loh-un, ihenguva ahin pohsuh peh-un, chule thu ahinpouvin, Pakai i-Pathen'un eipeh-u chu gampha ahi, atiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Achuti vangin nangho chetou ding nanom pouvin, Pakai i-Pathen'u thupeh chu nadou jouvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule napon in sunguva naphun chelun, Pakaiyin eithet jeh uva suhmang dinga Amor mite khutna pehlut dinga, Egypt gama kona eipuidoh-u ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hoilama ichetou diuham? Isopihou vin, Miho chu alentheijun, eiho sangin asang jouvin, khopi hochu alentheijin, van geija pal akikho touvin ahi; chukal valin chua chun Anakim chapate kaga mu uvin ahi, tin ilungu asudoijun ahi, nati uve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chujouvin keiman najah uva, Amaho chu ginghih-un, kijong kicha hih-un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Namasanguva che Pakai na Pathen'u chun namitmu tah uva Egypt gama nangho dinga nabolpeh hou jouse dungjuijin gal satpeh naovin nate.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule gamthipma min acha apoh banga, Pakai na Pathen'un hiche munhi nalhun kahseuva, lampi jouse-a iti napoh-u ham chu namu taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahin hichan geihin jong Pakai na Pathen'u chu natahsan pouvin;
  </para>
  <para style="p">
    <verse number="33" style="v" />Naponbuh son nadiu mun holdohpeh dingle, nachenao lampi musah dinga, jan le meikonga, sunle meilhanga namasang uva chepa chu natahsan deh pouve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Pakaiyin nathu seiju ajan, alungsatan, akihah selin, hitin ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tahbeh-a hiche khang gilou mite khatchan jong napu napateu pehdia kahah selna gampha chu amulou heldiu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jephunneh chapa Kaleb tailou: aman hichu amuding, chule agachotsa gam chu amale achilhahte kapeh ding ahi; ajehchu aman Pakai chu ajuikim helin ahi, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangho jal-in Pakai chu keichunga alung hangin, Nangma jengjong chumuna chu nalut louding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahin namasanga ding Nun chapa Joshua, amachu lutding ahi. Ama chu tilkhouvin; ajehchu aman hiche gam chu Israel alosah ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chukal valin, Anchah dingbep ahi natiu nachasen houleh, chuche laija sele pha hekhen loulai nachateo hochu chua lut dingu, chule keiman kapeh-a, amahon alo dingu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahin nangho vang kiheijunlang, twipisan lampi gamthip lama nakholjin ban jom taovin, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuphatnin nanghon nei donbutnun, kahenga, Pakai dounan kachonse taove, Pakai ka Pathen'un eithupeh jouseu dungjuijin chetaoving ting, galsatnu vinge, nati uve. Chuin amitakip min agalvon nakivoncheh phatnun, thinglhang lama kaldin phasademin na-umtaove.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahin Pakaiyin kahenga, Chetou hih-un, chule galjong gasat hih-un; ajehchu keima nalah uva kaumpoi: achutiloule nagalteu masanga gal lel getnun nate, tin seipeh-in eiti.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hijeh chun najah uva kaseipeh-un; chule nanghon nangai pouvin, ahin Pakai thupeh dounan nagolkeh-un, hangtah-in thinglhang lama nakaltou taove.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin hiche molsanga cheng Amor mite chu nangho dou dingin ahungkon doh-un, khoihon mi adel bangin nahin delun, Seir gei le Hormah geijin nathatnun ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin nahung kileuvin, Pakai masanga nakap-un; ahinla Pakaiyin na-aw-u nangaipeh pouvin, anakhang jong nasunpeh pouve.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuti chun chuche mun'a nagasuhmangu nikhoho dungjuijin Kadesh mun'a nisot tah naum denun ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Pakaiyin kahenga asei bangin iki heijun, twipisan lampia gamthiplam jonin ikhol jinun, chule Seir molsang chu nikho tamtah ivelkolun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin kahenga aseijin, hitin ati;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon hiche molsang hi navelsot behset taove; sahlam sanga kiheijun,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nangman mipi chu thu penlang, Seir'a cheng nasopi hou Esau chate gamsung najotdiu; amahon nakichat diu ahi; hijeh chun nangho chingthei tah-in umun;
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho toh kina hih-un, ajehchu keiman agamu chu nangho kapeh louding, kengphang te jong kapeh louhel ding nahiuve; ajehchu Seir molsang chu Esau lodia kanapeh ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon naneh dingu an-neh chu amahoa kona suma nakichoh uva nanehdiu, chule nadon diu jong suma nakichoh uva nadondiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Pakai na Pathen'un nakhut uva natoh jouseu phatthei aboh-in, chule gamthip lentah najotnu chu ahen ahi. Hiche kum somli sunghin Pakai na Pathen'un na-umpiuvin, lhahsamna imacha nanei pouvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Eloth le Ezion-gober'a pat phaicham lampi jotna-in Seir'a cheng Esau chilhah isopiteu gamchu ipal pouvin, ikiheijun Moab gamthip lampia iki tolun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin kahenga, Moab chu sugim hih-un, gal'in jong kisatpi hih-un; ajehchu agamu chu nalodiuva kapeh louding nahiuve; ajehchu Ar chu Lot chilhahte kapeh ahitai, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Masangin chua chun Anakim te banga len, tam le, sanga Emim mite ana chengun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho jong chu Anakim ho banga mihatna sim ahiuvin; Moab miten vang, Emim tin amin sah-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Masangin Seir'a hin Hor miho jong anachengun; ahinla Pakaiyin amaho apeh gam Israel'in analo bang chun, Esau chaten amasanguva konin asumangin, alopaijun, amaho khelin acheng taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tun kipatdoh-un lang Zered vachadung chu galkaijuvin, tin kaseijin; chuin Zered vachadung chu igalkai taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Kadesh-barnea idalhah uva pat Zered vacha igalkai geiju, Pakaiyin ahahsel nao banga janel lah-a kona gal hat ho khang kichaihel tokah chu kum somthum le kumget ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu amanthah hel tokah uva, janel lah-a kona sumang dinga Pakai khut chun amaho anadou tahbeh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun ahitin ahi, eiho lah-a kona galsat ho jouse amanthah heluva, chule athigam phatnun,
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakaiyin kahenga hitin aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="18" style="v" />Tunia hi nangman Moab gamsung Ar najotpaija nagalkai ding ahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Ammon chate naija nahung tengle, amaho chu sugenthei hih-in, chule kinah jong kinahpi hih-in; ajehchu Ammon chate gamchu nalodinga kapeh louding ahi; ajehchu Lot chate lo dia kanapehsa ahitai, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />(Hiche gam jongchu mihat ho gama anakisim ahin; hia chu mihat ho masang laija anacheng ahiuve; chule amaho chu Ammom miten Zamzummim anasah-uvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anakim ho banga len, tam le sang ahiuve: ahinla Pakaiyin amaho chu amasanguva asumangin, amahon alopaijun, chule chu-a chun achengun:
  </para>
  <para style="p">
    <verse number="22" style="v" />Seir'a cheng Esau chate-a dinga amasanguva kona Hor mite asuhmangpeh bangin abolpeh-in ahi: chuin amahon alopaijun, tuni geihin amaho khelin achengun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Hazerim le Azzah geipeh-a cheng Avim miho chu Caphtor-a kona hungdoh Caphtor miho chun asumangun, chule amaho khelin acheng taove).
  </para>
  <para style="p">
    <verse number="24" style="v" />Kipatdoh-un, nakholjin ban jomun lang, Arnon vapi galkaijun: veuvin, Amor mi Heshbon lengpa Sihon le agam chu nakhut na kapeh ahitai. Hichu lopanun lang gal'in kidoupiuvin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tunia hi vannoi pumpi-a um namho chunga nangma kichatna le ginna kakoi patding ahin; amahon nangma chungchang thu kilhut jaovintin, nangma jeh-a kithing uva, lung gentheidiu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Kedemoth gamthipma konin Heshbon lengpa Sihon henga chamna thu kengin sottol kasolin,
  </para>
  <para style="p">
    <verse number="27" style="v" />Nagam sungu neijotpai sah-in, lamlhonga bou chengkatin, jet le veija jong kiheiponge;
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangman kaneh ding an sumin neichoh sah inlang, chule kadon ding twi jong sumin neichoh sah-in: kenga bou kagalkai dingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />(Seir'a cheng Esau chate le Ar'a cheng Moab chaten eibolna bangin,) Pakai ka Pathen'un eipehnao gam Jordan kagalkai kahseuva dingbou ahi, kati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla Heshbon lengpa Sihon'in agam ijot galkai diuchu eiphalpeh pouve. Ajehchu Pakai na Pathen uvin tunikho-a banga hi nakhut nuva apehlut theina dinga alungu asuh tah-a, alouchal sah ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Pakaiyin kahenga, Vetan keiman Sihon le agam chu namasanga kape pantai: agama nachenthei nadin lo pantan, eiti.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chujouvin Sihon amale amite jouse Jahaza'a eiho douna-a galsat din ahung kondoh taove.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Pakai i-Pathen'un amaho chu imasanguva ahinpedoh-in, chuin eihon ama le achapate, chule amite jouse ithatgam taove.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin hiche petchun akhopi jouseu ilaovin, khopi tinna mihem jouse pasal, numei, chule naosen ho isumang helun, khatcha jong ihinghoi pouvin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Eiho-a dingin aganchahou le akhopihouva kichomho bou ilaovin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Arnon vapi pamchina um Aroer'a pat, vapi chinna um khopi-a kipat Gilead chan geijin, eiho dinga hetbeh seh khopi khatcha aumpoi. Ajehchu Pakai i-Pathen'un abonchauvin eiho eipe soh hel taovin,
  </para>
  <para style="p">
    <verse number="37" style="v" />Ammon chate gam sese le Jabbok vapi gamkaiho, molsang ho-a khopiho le Pakai i-Pathen'un eijahda nao mun ho-a bou chu nahunglut louvu ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin ikiheijun, Bashan jotna lampia ichetouvun, chuin Bashan lengpa Og le amite jouse eihotoh Edrei mun'a kisatdin ahung konun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin kahenga, Amachu kicha hih-in; ajehchu keiman amale amite jouse, chule agam nakhutna kapeh ding ahin; chule Heshbon'a cheng Amor lengpa Sihon nabol banga amachu nabolding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutichun Pakai i-Pathen'un Bashan lengpa Og le amite jouse jong ikhutnuva eipeuvin; mikhatcha jong hinghoi louvin ithat gamun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hichepet chun akhopiho jouse ilaovin, Bashan'a Og lenggam Argob gamkai jouse-a khopi somgup lah-a ilah louvu khatcha aumpon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche khopi jousehi kulbang sangtah tah-a kiget khum le, kotpi neicheh, chule kotgol ho-a kikam ngen ahin; hiche tilouvin kul kiget khumlou khopineo tamtah jong ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Heshbon lengpa Sihon ibolnao bangin khopi tinna pasal hole numei ho chule chapangho isumang hel jengun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gancha jouse le khopiho-a thil kichomho vang eiho chantumdin ikilah-uve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hichepet chun Amor mite lengni-a konin Jordan hilam panga galla um gam Arnon vapi'a pat Harmon molsang geijin ilaovin;
  </para>
  <para style="p">
    <verse number="9" style="v" />(Harmon chu Sidon miten Sirion asah-un, Amor miten Shenir asah-un),
  </para>
  <para style="p">
    <verse number="10" style="v" />Phaicham khopi jousele, Gilead gam jouse, chule Bashan gam jouse Salcah le Edrei geijin, Bashan'a Og lenggam sunga khopiho chu inalaovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Bashan lengpa Og bou chu mihat milenho lah-a ahingdoh amoh hija ahi. Veovin, ajalkhun chu thih jalkhun ahin, Ammon chate kho Rabbath-a um hilou ham? mihem tong dungjuijin adung chu tongko ahin, avai tongli ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuche petna inalo-u hiche gamhi Arnon vapi panga um Aroer'a patna Gilead molsang kehkhat le, asunga khopi hochu Reuben mite le Gad mite kana petan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gilead gam adang sese le Og lenggam Bashan pumpi chu Manasseh phung kehkhat kanapen; Argob gamkai jouse le Bashan pumpi chu mihat le milenho gam anakiti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh chapa Jair'in Argob gam pumpi, Geshuri le Maachathi gamgi geijin alan, hichu ama min aputsah-in, tuni geijin Bashan Havoth-jair akiti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Gilead chu Machir kanapetai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Reuben mite le Gad mite henga Gilead'a pat Arnon vapi phaicham kehkhat, chule agamgi diuvin Jabbok vapi geijin kapen, hichu Ammon chate gamgi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Phaicham jong, Jordan le apanga um gamho, Chinnereth'a pat Ashdoth-pisgah solam sanga um phaicham twipi, chituipi geijin kanapen ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche laichun nangma thu kanapen, Pakai na Pathen'un hiche gamhi nalodiuva anapeh ahi. Nasopi hou Israel chate masanga namihang hou jouse chu galvon vonpuma nagalkai diu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla najiteu, nachasenhou, chule nagancha hou, (ajehchu gancha nahao lheh-uve ti kahen,) keiman kapeh-u nakhopi houva chu umden dingu,
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangho banga Pakaiyin nasopiteu acholngah sah kahseu le Jordan galla Pakai na Pathen'un napeh-u gam alo kahseuva umdingu ahi. Chujou tengle amitakipmin keiman kapeh gamchu nahung lokit chehdiu ahi, kati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hiche laichun Joshua thu kapen, Pakai na Pathen'un hiche lengteni abolna jouse chu namitnin namutan, chutobang ma-a chu Pakaiyin nalo dingu lenggam ho chu abolding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai na Pathen'un nangho dinga gal nasatpeh ding jeh-un, nanghon amaho chu kicha hih-un kati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hiche laichun Pakai henga ngehna kana neijin, hitin kati;
  </para>
  <para style="p">
    <verse number="24" style="v" />Vo Pakai Pathen, nangman nasoh hi nalet je le nakhut thahat je neimusah pantai; ajehchu leile van'a nathilbol bang le thahat bang bolthei Pathen koi umam?
  </para>
  <para style="p">
    <verse number="25" style="v" />Katao ahi, neigalkai sah inlang, Jordan galla gam phatah molsang hoitah le Lebanon chu neimusah-in, kanati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla nangho jeh-in Pakaiyin eina lunghan khumin, eingaipeh nompoi: chule Pakaiyin kahenga, Phaset tante, hiche thuhi kahenga seikit tahih-in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pisgah molvum'a kaldoh inlang lhumlam, sahlam, lhanglam chule solama khodah-in lang, hichu namit-in ven; ajehchu nangma hiche Jordan hi nagalkai louding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin Joshua ngansen lang, tilkhouvin, chule hatsah-in; ajehchu ama hiche miho masanga hi galkaija, nagamu ding gamchu amaho alosah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuti chun Beth-peor maijon phaichama chun i-um taovin ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun tun, vo Israel, nahin theijuva, napu napateu Pakai Pathen'in napeh-u gamchu nagalo theina dingun, najui diuva kahil masah dem chondanho leh thutannaho hi ngaijuvin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nangho kathupeh hi nakoibe loudiu, chule chua kona jong nalahdoh louhel diu, chutia chu keiman kapeh-u Pakai na Pathen'u thupeh chu nanit diu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Baal-peor jeh-a Pakai thilbol chu namitnun namutaove. Ajeh chu Baal-peor jui jouse chu Pakai na Pathen'un nalah uva konin asumangtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla nanghon Pakai na Pathen'u heng lama behho vang amitakip tunigei hin nahingjing naove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Veovin, Pakai Pathen'in eithupeh bangtah chun, lodinga nachenna diu gama naboldiuvin, keiman chondan le thutanna chu kahil taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun hicheho chu nit unlang bolun; ajehchu hichu namtin ho mitmu-a nachih naole nahet them nao ahin, amahon chondan kisun jouse hi ajah uva, Tahbeh-in hiche nam lentehi aching le ahechen mite ahiuve, atidiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ikouna chanuva einaijiu Pakai i-Pathen'u tobanga amaho naiji Pathen nei chutobang namlen koi umam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule tulaija namasanguva kakoi dan kisun jouse banga hititah-a chondan hole thutan na nei namlen dang koi umam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Kichih thei pou pouvun lang, gunchu tah-in nalhagaovu hongphaovin, achuti louleh namitnun amu thilho chu sumilun natin, nahinlai nikho sungseuvin nalungsunguva konin mangthah get ninte: ahin nachapate le nachapate chate chu hiljouvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Adeh deh-in Horeb molsanga Pakai na Pathen anga nadin nikhou, chule Pakaiyin kahenga anasei, Mipi ho chu neikhop khompeh-in, leiset chunga ahinlai nikho sungseuva keima ginje akihil theina diule, achateu ahiltheina diuvin kathu jahsah inge ati nikho chu.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin nahin naijun molsang bula nadinguvin, chule molsang chu vanlaijol geijin muthim, meilhang, chule thimletlut nin meijin akan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin meikong lah-a konchun Pakaiyin naheng uvah thu aseijin, a-aw cheng chu najaovin, alim vang namupouve; a-aw sehseh najaovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman naheng uva thuson, najui diuva athupeh akitepna chu aphongdoh-in, song pheng ni chunga asunin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin hichepet chun lodinga nachennao gama nabol diuvin, chondan kisunho le thutan naho chu nangho kahil diuvin eina thupeh-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun nangho kichihtheijun, ajehchu Horeb'a meikong lah-a Pakaiyin naheng uva thu asei nikho chun, nanghon alim namu pouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Achutiloule nakisuhboh uva, alim semthu, ipi lim hamkhat toh kilou, pasal ham, numei ham tobang kisem getnun natin,
  </para>
  <para style="p">
    <verse number="17" style="v" />Leichunga um ganhing khat tou tobang, vanlaijola lengle alhanei vacha khat tou tobang,
  </para>
  <para style="p">
    <verse number="18" style="v" />Leichunga a-opma kithol ganhing khat tou tobang, leinoi twilah-a nga khat lim tobang, kisemthu getnun nate.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule achutiloule namitna vanlam navet uva, nisa, lhathah,ahsi ho, chule van janelpi namu tengule, Pakai na Pathen'un vannoi pumpi-a nam jouse-a dinga apeh chu houding le jendingin kiheilut getnun nate.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla Pakaiyin tunikho-a nahi nao banga hi agoulo ama mite hidinga nalah uva, thih meilhum sung, Egypt gama kona nana puidoh-u ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chukalvalin nangho jeh-in Pakai keima chunga alunghangin, Jordan kagalkai louna dingle, Pakai na Pathen'un lo dinga napeh-u gam phatah-a chu kalut louna din akihah selin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keima vang hiche gama kathi-a, Jordan hi galkai louding kahitai; ahin nangho nagalkaijuva chuche gam phatah chu nagalo diu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangho kichih theijun, ajole Pakai na Pathen'un nang hotoh akitepna sumil khaovin natin; Pakai na Pathen'un ajahda alim semthu ham, ahiloule ipiham khat toh kilou kisemthu getnun nate.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu Pakai na Pathen'u hi kavamhel mei ahin, thangthip tah Pathen ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nanghon chate le chateho chate nahin neijuva, gamsunga chu sottah nachen uva, nakisuhboh uva, alim semthu, ahiloule ipihamkhat toh kibang lim nakisem thuva, Pakai na Pathen'u mitmu-a thilse nabol uva, nalung hansah uva ahile,
  </para>
  <para style="p">
    <verse number="26" style="v" />Lo dinga Jordan nagalkai nao gama kona chu naman thah helnadiuva, tunikho-a hi nachung uva ahetoh dinga van le lei kakou ahin; chukoma chu nachensot loudiu, suhmang hela naum johdiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Pakaiyin namtin lah-a nathe cheh uva, Pakaiyin napuinadiu Pathen helouho lah-a chu lhomcha naphah diu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule chua chu mutheilou, jatheilou, netheilou, thilnam jalou, mihem khutsem thing le song pathen lhachana natoh dingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijongle chua kona Pakai na Pathen'u chu nahol uva, nalungthim pumpiu le nahinnao pumpi-a nahol ule, namu dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hesoh genthei natouva, ni nunungni le hicheng thil jouse nachung uva achuhteng, Pakai na Pathen lama nakiheijuva, a-aw nangai uva ahile,
  </para>
  <para style="p">
    <verse number="31" style="v" />(Ajehchu Pakai na Pathen'u chu hepina-a dim Pathen ahi,) aman nadalhah loudiu, nasuhmang louheldiu, napu napateu henga akihahselna le akitepna chu asuhmil louhel ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu nikho che masaho, nangho masanga Pathen'in leichunga mihem asem nikho-a pat, chule van langkhatna pat alangkhat geija, hiche tobang thil nasa adang anaum kha-a, ahiloule hitobang hikija khatam? dong temun.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nanghon najah uva nathilou banguva, meikong lah-a kona Pathen thusei aw min ajahkhah em?
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahiloule Pakai Pathen'in Egypt gama namitmuva abol hojouse dungjuija, Pathen'in lhepna-a, melchih na-a, thil kidang, khut thahatna, ban jahdoh-a, tijatna nasatah-a, namkhat lah-a kona namkhat lahdoh dinga cheding agot khah-em?
  </para>
  <para style="p">
    <verse number="35" style="v" />Pakai chu Pathen ahi ti nahet theina dinguva, naheng uva kimusah ahi. Amalou koima dang aumpoi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman nahil theina diuva, van'a kona a-aw najah sah uva; chule leichunga ameikou loupitah chu namusah-u ahi; chule nanghon meikou lah-a konchun athu najaovin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule napateu angailut jehchun, amaho nungin achilhahte alhengin, chule Egypt gama konin athahat thilbol theina-a chun amitmu-a konin napui doh-un;
  </para>
  <para style="p">
    <verse number="38" style="v" />Tunikho-a banga hi nangho puilutna, agamu gouva lodinga peh dingin, nangho sanga lenjole hatjo namho namasanguva konin anodoh-in ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hijeh chun Pakai hi vanchung le leichung Pathen ahi ti hi tuni hin heuvin lang, nalungun ngai touvin; Amalou adang khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hijeh chun nangho le nanung uva nachateo aphatthei na dingu leh, a-itih-a dinga Pakai na Pathen'un napeh-u leiset chunga hi nahinkhou asotna dingin, tunikho-a kathupeh-u ama chona dan kisemho le athupehho hi nit jingun, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chujouvin Mosi'n Jordan hilam pang nisolam panga khopi thum akhendoh-in,
  </para>
  <para style="p">
    <verse number="42" style="v" />Tolthat ho, gutuhna neilou, masanga jong hotna neilou tosoija aheng akom that ho ajamlutna ding; chule hiche khopiho khatna ajamlut le ahintheina din akhendoh-in:
  </para>
  <para style="p">
    <verse number="43" style="v" />Hicheho chu Reuben mite-a dingin phaicham gamthipma um Bezer ahin, Gad mite-a dingin Gilead gama um Ramoth ahin, chule Manasseh mite-a dingin Bashan gama um Golan ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule hiche hi Mosi'n Israel chate angsunga apeh danthu chu ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hicheho hi Egypt'a kona ahungdoh nunguva Mosi'n Israel chate jah-a anasei, hettohsah le, dan kisemho, chule thutan ho chu ahin,
  </para>
  <para style="p">
    <verse number="46" style="v" />Mosi le Israel chaten Egypt gama kona ahung potdoh nunguva anatha-u Hesbon'a cheng Amor mite lengpa Sihon gamsung Jordan pang hilam sang, Beth-peor maijona um phaichama apeh ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin amahon ama gam le Bashan lengpa Og gam, Jordan hilam pang nisolam sanga cheng Amor mite lengni gamchu alouvin,
  </para>
  <para style="p">
    <verse number="48" style="v" />Arnon vapi panga um Areor'a pat, Hermon'a um Sion molsang chan,
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule Jordan hilam pang solam sanga phaicham jouse, Pisgah twinah phung noija um twikhanglen phaicham geijin alouvin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi'n Israelte jouse akouvin, ahenguva, Vo Israel, nakihil uva, nachintup uva, chule nabol diuvin, tunia naheng uva kasei chonna danho leh thutannaho hi ngaijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai i-Pathen'uvin Horeb'a eihotoh kitepna khat anaseme.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin hiche kitepna hi ipateu toh abol ahipon, tunia ahingnalai jouse eihotah tojoh abol ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin nang hotoh kimaiton molsanga chun meikong lah-a konin thu anaseijin,
  </para>
  <para style="p">
    <verse number="5" style="v" />(Hiche pet chun Pakai thu chu nangho hetsah dingin Pakai le nangho kah-a kana dinge. Ajehchu meikong jehchun nana kichauvin, molsanga chun nakaltou pouvin;) hitin ati,
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima Pakai na Pathen kahin, nakihenna in, Egypt gama kona nahin puidohpa chu kahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman Keima ansunga Pathen dangho nanei louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman alim semthu, chung van'a um hihen, ahiloule noi leisetna um hihen, ahiloule leinoi'a twisunga um hijongle, akibahpi ima lim nasem louding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangma hitobangho anga nakun louding, alhacha-a jong napan louding ahi. Ajehchu keima Pakai na Pathen hi thangthip tah Pathen kahin, keima eihot bola pate khansetna chu achate khangthum khangli chan geija vila, achunguva phulajia kahin,
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima eingailua chule kathupeh nit chu sang tamtah ho chunga khotona musah-a kahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangman Pakai na Pathen minchu mohseh-a napat louding ahi. Ajehchu mohseh-a amin pana chu Pakaiyin themona beija alhalou ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai na Pathen'in nathupeh banga cholngah ni chu athengin mangin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nigup sunga na natoh-a, natohding jouse chu natoh ding,
  </para>
  <para style="p">
    <verse number="14" style="v" />Amavang nisagi ni chu Pakai na Pathen cholngah ni ahi. Hiche nikho-a hi nangma nahin, nachapate ahin, nachanute ahin, nasohpa ahin, nasohnu ahin, nabongchal ahin, nasangan ahin, nagancha poupou ahin, nakotpi sunga um namaljin hijongle ima natoh loudiu; nangma bang banga nasohpa le nasohnu jong kicholdodiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Egypt gama soh-a um nanahin, chule Pakai na Pathen'in chua kona khut hattah le ban jahdoh-a nahin puidoh ahi chu geldoh-in. Hijeh-a chu Pakai na Pathen'in cholngah ni nitdinga nathupeh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai na Pathen'in thu nathupeh bangin nanu napa jabolin, chutile Pakai na Pathen'in napehna leisetna chun nahinkho sotnintin, naphatthei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tol natha louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jon jong nabol louding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gujong naguchat louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Naheng nakom chunga hettohsah dihlouva jong napan louding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naheng nakom ji jong nadeichat louding, naheng nakom in ahin, alou ahin, asohpa ahin, asohnu ahin, abongchal ahin, asangan ahin, naheng nakoma thilpou pou chu nathangset louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche thuho hi Pakaiyin molsanga meikong lah-a kon, meilom lah-a kon, chule muthim satah lah-a kona aw gingtah-a houkhom ho nabon uva henga anasei ahin; abelap tapoi. Chule hicheho chu songpheng ni-a asunin, kahenga einapen ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ahitin ahi, nanghon muthim lah-a kona aw najah-u chun, (ajehchu molsang chu meikonga ka ahi,) nangho nahiuvin, naphung uva aluchangho ahiuvin, chule nalamkai jouseu ahin kaheng neihin naijun,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hitin naseijui, Vetemin, Pakai i-Pathen'un aloupina le aletna eimusah-un, chule meikong lah-a konin a-aw ijaovin ahi. Tunikho hin eihon Pathen'in mihem akihoupia, ahivanga ahin chu imu taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun tu-a ibola ithijeng diuham? Ajehchu hiche meikou nasatah hin eikahvam dingu ahi; eihon Pakai i-Pathen'u aw jahbe leuhen ithi teidingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu eiho banga meikong lah-a kona hingjing Pathen aw ja-a, hing nalai tahsa pujouse lah-a koi umam?
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangman ganai jinlang, Pakai i-Pathen'uvin asei ding chu gangai jin; chule Pakai i-Pathen'uvin nahenga aseijouse chu nangin kabonchao jah-a seijin lang, keihon ngai ungting, bolu vinge, nati uve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule kahenga nathusei petnuchun Pakaiyin nathuseihou chu ajan; Pakaiyin kahenga, Keiman mipin nahenga athuseiju aw chu kajan ahi. Amahon athuseihou jouse chu aseidih lheh uve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kaden, amaho ding le achateu dinga a-itih-a aphalheh jing nadin, a-itih laijin jong hitobang lungchu pujingu henlang, eigingu henlang, kathupeh jouse anit jing jeng taveleu!
  </para>
  <para style="p">
    <verse number="30" style="v" />Chenlang ahenguva, Napon in nuva lutkit taovin, gatipeh-in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nangma vang kakoma dingin lang, alodiuva kapehna gama abol theina diuva amaho nahil dinga thupeh jouse, chonna dan kisemho, chule thutanna ho nahenga kasei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun Pakai na Pathen'un nathupeh banguva nabolna diuvin chingtheijun; nangho jetle veija nakihei mang lou dingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nalodiu gama naphat theijuva, nahinkhou asotna dinga, Pakai na Pathen'un nathupeh-u lampi jouse chu najot sohkei dingu ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichehohi nacheuva nagalo diu gama naboldiuva Pakai na Pathen'un nangho hil dinga thupeh eipeh dan thupeh ho, chondan ho, chule thutanna hochu ahi,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutia chu nahinkhou asotna dinga keiman nangma le nachapa chule nachapa chapate kathupeh achondanho le athupehho chu nahinkho lhumkei uva nanit uva, Pakai na Paten chu nagin dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun, vo Israel, Pakai napu napateu Pathen'in athutep banga khoiju le bongnoi lona gama chu naphat theijuva chule hatah-a napun nadiuvin, ngaijin lang, naboldoh nadin chingtheijin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngaijin, vo Israel, Pakai na Pathen'u chu Pakai khat seh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nangman Pakai na Pathen chu nalung pumpi-a, nalhagao pumpi-a chule nathaneina pumpi-a nangailut ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule tu nikho-a nangma kathupeh hohi nalung sunga nachin jing ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangman hicheho hi nachate henga tomngai tah-a nahilding, na-insunga natoupet tengle, lamdunga nachepet tengle, naluppet tengle, chule nathodoh teng jongle naseipeh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hicheho chu melchihna dinga nakhutna nabua, chule namit teni kikah-a thuchihbom tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hicheho chu na-in khomhou le nakotpi hou chunga nasut dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hung hiti ding ahi, Pakai na Pathen'un napu napateu Abraham, Isaac chule Jacob henga pehdinga akihahselna gam, nangma sahdoh hilou khopi lentah le phatah ho-a chu nahin puilutna,
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangma dimsah hilou thilpha jouse dimna inho, nangman nalai hilou twikul kilaiho, nangma phu hilou lengpilei le Olive thingphung ho chu nangman naneh-a nava teng le,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuteng chingtheijin, ajole Egypt gam kihenna in'a kona nahin puidoh Pakai chu sumil getnin nate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai na Pathen chu nagin na, ama najena, chule ama minna nakihahsel ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanghon pathen dang, nakimvel uva cheng miho pathen nung najui loudiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />(Ajehchu nalah uva Pakai na Pathen chu thangthip Pathen ahin,) ajole Pakai na Pathen lungsat nachung uva koujah-intin, leiset chunga konin nasumang hel getnunte.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nanghon Massah mun'a nana patep banguva Pakai Pathen chu na patep loudiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nanghon Pakai na Pathen'un thupeh napeh-u adan thupeh ho, ahettohsah ho, chule achonna dan kisunho chu gunchu tah-a nanit dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Pakaiyin napu napateu henga ana kihahselna gama nagacheuva naga lona dingu le naphat theina dinguva Pakai mitmu-a adih le apha chu nabol diu,
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakaiyin anasei banga namelma teu jouse chu namasang uva kona nomanga umdingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule ahunglhung ding phat teng nachapan nahenga, Pakai i-Pathen'un nana thupeh hettohsah ho, dan kisunho, thutanna ho chu ipi kiseina ham? tia nadoh tengleh,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuteng nachapa henga chu, Keiho Egypt'a Pharaoh soh kana hiuvin, Pakaiyin Egypt'a kona khut thahat tah-a eipuidoh-u ahi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakaiyin kamit mutah-un Egypt chung leh Pharaoh chung, chule a-insung pumpi chunga, melchihna ho, thilkidang ho, thina, chule thohtheilou hel lungkhamna eimu sah-un ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule pehdinga ipu ipateu anahahselna gama eipuilut theina diuvin, hia konchun eina puidoh-un ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule tunikho-a banga hi eihinghoi theina dingu le, a-itih-a iphat theina dingu, chule Pakai i-Pathen'u igin na dinguva, Pakaiyin hiche chondan jousehi ibol diuva eina peh-u ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule aman eithupeh banguva, Pakai i-Pathen'u masanga hiche thupeh ho jouse chu initnuva ahile, hichu ichon phatnao hiding ahi, tia naseipeh dingu ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule lodinga nachenao gama chu Pakai na Pathen'un napuilut nuva, na angsunguva nam tamtah Hit mite, Girgash mite, Amor mite, Canaan mite, Perizz mite, Hiv mite chule Jebus mite nangho sanga tamjole hatjo nampi sagi anodoh tengle,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Pakai na Pathen'un amaho chu namasanguva apehdoh tengle, nanghon amaho chu natha uva nasuhmang heldiu, amahotoh kitepna nasem loudiu, hepina jong namusah louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho tojong nakichenlou ding, nachanu jong achapa dinga napehlou diu, chule achanu jong nachapa ji dinga nalah louding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu amahon nachapa chu pathen dangho lhacha-a apan theina dinga keima eijui na-a kona aheimangdiu: chutia chu Pakai lungsatna chu nachungah deujah-a, photlotna nasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla nanghon amaho chu hitia hi naboldingu ahi: amaichamu nasuhmang pehdiu, amilimhou nasuhboh diu, athingbom hou chu naphuh lhuh pehdiu, chule alim semthu milimho chu meija nahalvam dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Pakai na Pathen uva dinga namtheng nahiu ahin, Pakai na Pathen'un leiset chunga nam jouse chungvuma ama-a dinga nam tumbeh hidinga nalhen doh-u ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namdang sanga natamjoh jeh uva Pakaiyin nachung uva ngailutna akoija, nalhenu ahipoi; ajehchu nangho nam jouse lah-a alhompen nanahiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Pakaiyin nangailut jeh-u le, napu napateu henga akihahselna asuh bulhit nom jeh-a Pakaiyin khut thahat tah-a napui doh uva, soh channa in'a konleh, Egypt lengpa Pharaoh khutna kona nalhatdoh-u ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun Pakai na Pathen chu Pathen ahin, kitahtah Pathen, ama ngailuho le athupeh nit ho henga khang sangkhat geija akitepna le akhotona koijing,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule ama hotbolpa chu sumang dinga amai uva lethuh jia Pathen ahi: ama ahotbol pa chu adep jing louding, amaikoh tah-a alethuh ding ahi, ti kihetnin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh-a chu nangman tunikho-a kathupeh danthupeh ho, chonna dan kisunho, chule thutanna ho hi nanit ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutengle hung hitiding ahi, nangman hiche thutanna hohi nangaija, nanitna, chule nabola ahileh, Pakai na Pathen'in napu napate henga akihahselna, akitepna le ahepina chu anit jingding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman nangma nangailutna, phatthei naboh ding, chule napunsah ding; nangma pehdinga napu napateu henga akihahselna leisetna chu nalaigilga le naleiset ga, nachang, nalengpi thei, nathao nabong hole kelngoihon ho phatthei abohding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangma nam jouse chungvuma phatthei nachan ding; nangho lah-a kon, ahiloule nagancha lah uva kona anu hijongle apaham hijongle achinga umlou helding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakaiyin nangma-a kona natna jouse alahmanga, nangman nahet Egypt hiveiho jouse chu nachunga khatcha akoilou ding; nangma nahot bolte jouse chunga akoijoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Pakai Pathen'in napehdoh ding miho jouse chu nasuhmang hela, achunguva khotona naneilou ding, a-pathen'u jong najen louding ahi; ajeh chu hichu nangma dinga thanga hungpang ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman nalungthima, Hiche namho hi keisangin atamjon, iti kanomang jou ding ham? nati-a ahile,
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaho chu nakichat louding; amavang Pakai na Pathen'in Pharaoh leh Egypt mite jouse chunga anatoh jouse chu nageldoh joh-a,
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangman namitna namu patepna nasatah ho, melchihna ho, thil kidangho, khut thahat tah le ban jahdoh-a Pakai na Pathen'in napuidoh chu nageldoh ding ahi: Pakai na Pathen'in nakichat miho jouse chunga chutobanga chu abolding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chukal vala jong Pakai na Pathen'in nangma-a kona kisel ahingdoh amoh ho chu asuhmang kahse-a alah uva khoi-ngal alhakhum ding ahinalaije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangman amaho chu nakichat louding ahi: ajehchu tijat umtah le hat chungnung Pakai na Pathen'u nalah uva aume.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Pakai na Pathen'in namasanga hiche namho chu athem thema anodoh ding ahi. Nangman khatvei phulsuh-a nasuhmang thei louding ahi; achuti loule gamsa ho nachunga hungpung getnunte.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla Pakai na Pathen'in amaho chu nangma henga hinpe doh intin, chule suhmang hela aumkah seuva manthah na-a nasatah-a asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule aman aleng hou chu nakhutna ahin pehdoh ding, nangman amin'u vannoi'a kona nasuhmang ding ahi. Amaho nasuhmang hel tokah se-a koimacha namasanga dingjou louding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Alim semthu pathen ho chu meija nahalding, achung kai sana ahiloule adangka ho chu nadeichat louding, lah jong nakilah louhel ding ahi; atiloule chua ohkhan nate: ajehchu Pakai na Pathen dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule na-insunga thil thet um napohlut louhel ding ahi; atiloule hiche tobang chun sapsetna-in umkhan nate. Amavang nangman hichu nasatah-a nathetna, nakidah johding ahi: ajehchu hichu sapset thil ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nahin uva, napun uva, napu napateu henga Pakaiyin ana hahselna gama chu nalut uva nalotheina dingun, tunia kapeh thupeh jouse hi nabolna dingun chingtheijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nangho suhnem nading, photchetna ding, nalungsunguva ipi umam hetdohna dingle, aman nathupeh hou chu najuidiu najui loudiu hetna dinga, Pakai na Pathen'un kum somli sung gamthipma nahinpui nao lampiho chu geldoh-un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem changlhah seh-in ahingpon, Pakai kamsunga kona hungpotdoh thucheng jouse-a bou hingding ahi ti nangho nahetsah theina dinguva, aman nasuhnem uva, gilkel nathoh dingu aphala, nangho nahiuva, napu napateu ahia jong ahet khahlouvu manna-a navah-u ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche kum somli sunghin natahsa chunguva navonu achulpon, nakengu jong apom pon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihemin achapa asehgim jibanga, Pakai na Pathen'in nasehgim chu, nalunga jong nangaito ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh-a chu alampia nachena dingu le, ama nagin na dinguva Pakai na Pathen'u thupeh ho chu nanit dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Pakai na Pathen'un gamphatah, thinglhang le phaichama kona hunglong doh twinah le twisam putdohna gam, vachadung ho lona gama napuilut uva,
  </para>
  <para style="p">
    <verse number="8" style="v" />Suhlou chang, sakol chang, lengpigui ho, theichang phungho, kolbuthei ho, Olive thao le khoiju lona gam,
  </para>
  <para style="p">
    <verse number="9" style="v" />Lhasam louva changlhah naneh nadingu, asunga chu imacha nalhahsam loudingu; asong ho thih hija, alhangho-a kona sum-eng laidoh theina gamphatah-a napuilut dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanghon naneh uva nava tengule, aman gam phatah napeh jeh uva Pakai na Pathen'u chu nathangvah dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tunia nangho henga kathupeh; adan thupeh ho, athutan naho, achonna danho hi nanit daova, Pakai na Pathen'u chu nasuhmil louna dingun chingtheijun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Achuti loule naneh-a nava tengle, chule in hoitah nakisah-a asunga nachen tengle,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nagancha honu le nakelngoi hon hou ahung puna, nasanao le nadangka hou ahung puna, naneijouseu ahung punteng,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuteng le nalungthimu hung kichoisanga, henkola na-umnao in, Egypt gama kona nahin puidoh-a Pakai na Pathen chu sumil khaovin natin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Gulse le aipi umna, Twi umlouna gamgo gamthip lentah le tijat umtah lhungkeija nahin pui galkaija, meituh songpi-a kona twi nape pao;
  </para>
  <para style="p">
    <verse number="16" style="v" />Nahinkho nunung lamle naphat theina diuva nasuhnem theina diule naphotchet theina diuva gamthipma napute napateu vin ahetkhah louvu manna-a navahpao chu sumil khaovin natin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nangman nalungthima, Kathil boltheina le kakhut thahat na-in hiche haona hohi eilampeh ahi, tigetnin nate.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amavang Pakai na Pathen chu nageldoh ding ahi: ajehchu tunikho-a banga hi napateu henga ana kihahselna akitepna chu aphudet theina dinga thahat nape-a chu ama ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hitiding ahi, Pakai na Pathen'u chu nasuhmil heluva, Pathen dang nung najuijuva, alhacha na natoh uva, nahou uva ahile, tunikho-a hi kagihsal nahiuve, nangho namanthai teidingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai na Pathen'u aw najuinom loujeh uva, namasanguva namdangho asuhmang banga, chutobanga chu namanthah dingu ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngaijun, Vo Israel: Tunia hi nangho sanga nasajo le hatjo, khopi lentah le van geija akulbang kisaho lodinga Jordan nagalkai ding ahin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangin nanahetsa-u Anakim chate, Anak chate masanga koiham ading joudinga? tia miseina-a nanajah sao milentah tah le sangtah ho masanga nachedingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun tunikho hin namasanguva che-a chu Pakai na Pathen'u ahi ti heuvin; aman amaho chu kavamthei mei banga asuhmanga, na-angsung laitah uva asuhnem dingu ahi. Hitia chu Pakaiyin najah uva asei banga, amaho chu nanodoh uva, nasuhmang loi jeng dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai na Pathen'in namasanga kona amaho anodoh nung tengle, Kachon phatna jeh-a Pakaiyin hiche gam lodinga eipuilut ahi, tin seihih-in; hiche nampiho gitlou jeh joh-a Pakaiyin namasanguva kona amaho anodoh ahibouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nachon phatna jeh, ahiloule nalungthima chondihna nanei jeh-a agamu lodia nache ahipoi: amavang hiche nam mite gitlou jeh le, Pakaiyin napu naputeu Abraham, Isaac, chule Jacob henga akihahselna asuh bulhitna dinga, Pakai na Pathen'un namasanguva kona amaho anodoh joh ahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun hiche gampha hi nachon phatnao jeh-a Pakai na Pathen'un nalodiuva napeh-u ahipoi ti kihet un; ajehchu nangho milouchalte nahi bouvui.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gamthip laija chu iti dana Pakai na Pathen'u nalunghansah-u ham geldoh-un lang, sumil hih-un; Egypt gama kona nakipat doh nikhouva pat, hiche mun nahunglhun geijun, nangho Pakai dounan nkiphinun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Horeb'a jong Pakai chu nalunghan sah uvin, chutichun nangho suhmangna ding khopmin Pakai chu alungsan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Songpheng teni, Pakaiyin nang hotoh akitepna songpheng teni chu ladinga molchunga kakaltou chun, nisomli le jan somli kaga umin, an kanepon, twi jong kadonpon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Pakaiyin Pathen khutjunga kisun songpheng ni eipen; hichea chun kikhoppi nikho-a Pakaiyin molsanga meikong lah-a kona nangho jah-a athusei jouse dungjuijin achunga chun akisunin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin nisomli le jan somli kichai nichun ahitin ahi, Pakaiyin songpheng ni, kitepna songpheng teni ngei chu eipen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin kajah-a, Kipatdoh-in, hikoma konhin chesuh loijin; ajehchu Egypt'a kona nahin puidoh namite khu amaho le amaho akisuboh-un; kathupeh lampi-a konin gangtah-in akihei mangun, amaho dingin akilhajol milim akisem taove, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chukal valin Pakaiyin kahenga, Hiche mitehi kaven ahile, vetan, milouchalte ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho hi kasuh manga, aminu vannoi'a kona kanoimang nadin kalolo neilosah jengin; chule nangma-a kona amaho sanga nasajole hatjo namkhat kasem ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun kakiheijin molsanga konin kahung kumlhan, chuin molsang chu meijin akan; chule kitepna songpheng teni chu kakhut teni-a aumin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin kaven ahile, veuvin, Pakai na Pathen'u dounan nachon seovin, bongnou lim kilhajol nana kisemun; Pakaiyin nathupeh-u lampia konin gangtah-in nakihei mangun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin songpheng teni chu kalan, kakhut teni-a konin kaseplhan, namitmu tah-un kasuchip min ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amasa-a bang chun nisomli le jan somli Pakai angsunga kaboh khupmin; ama lunghansah dinga Pakai mitmu-a giloutah-a chonset nabol hou jouseu jehchun, an neloule twi donlouvin kaumin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu nangho sumang dinga nachung uva Pakai lunghanna, alungsatna le alunglhai louna chu kakichan ahi. Ahivangin Pakaiyin hichepet jong chun kathu angaijin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakai chu Aaron chunga suhmang na ding khopmin alunghangin; Aaron dinjong hiche petchun kataovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin nachonset nao, na bongnou kisemu chu kalan, meija kagouvin, leivui banga adi kahsen kachil goijin; chule adi chu molsanga kona longlha vachadunga chun kalehlut tai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Teberah'a, Massah'a, Kibroth-hatta-avah'a jong Pakai chu nalunghansah-uvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutobang chun Pakaiyin Kadesh-barnea'a kona nasol uva, Chetouvun lang keiman kapehnao gamchu galo taovin ati chun; Pakai na Pathen'u thupeh dounan nakiphin un, ama natahsan hih-un, athujong nangai pouvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nanghohi kahet nikhouva patnin Pakai dounan nakiphin un ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutia Pakaiyin nangho suhmang ding ahi atijeh chun, amasa-a kabohkhup bangchun, nisomli le jan somli Pakai anga kaboh khupmin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun Pakai henga kataovin, Vo Pakai Pathen, naloupina vanga nalhat doh-a, khut thahat tah-a Egypt'a kona napuidoh nam mite le nagoulote hi sumanghih-in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nasoh Abraham, Isaac, chule Jacob chu geldoh inlang, hiche mite lungtahna, agitlouna le, achonset naohi vehih beh-in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Achuti loule neihin puidohnao gam miten, Pakaiyin ateppehna gama apuilut theilou jeh le, aman amaho ahot jeh-a, gamthipma thagam dinga ahin puidoh-u ahi, tigetnunte.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amavang nathahat thilboltheina le naban najahdoh-a nahinpuidoh namite le nagoulote ahiuve, katin ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche laichun Pakaiyin kahenga, Amasa-a bangin songpheng ni khengin lang, molsang chunga kaheng lama hungtouvin lang, thing thingkhong khat semin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nangin nasechip songphenga kisun thucheng hochu songpheng teni chunga chu kasutding, chule hichu thingkhong sunga nakoiding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Shittim thingin thingkhong kasemin, chule amasa bangin songpheng ni kakhengin, chule songpheng teni chu kakhutna choipumin molsanga chun kakal toutai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin songpheng chunga chun akisun masa bangin, khoppi nikho-a molsanga meikong lah-a kona Pakaiyin naheng uva asei thupeh som chu asunin; chule hichu Pakaiyin keima eipetai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin kaki heijin molsanga konin kahung kumlhan, songpheng chu kasem thingkhong sunga chun kakhumin; Pakaiyin eithupeh bangin chua chun aumjing tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Israel chate chu Jaakan chate kho Beeroth'a konin Mosera alhungun; chua chun Aaron athin, chumun mama-a chun avui taovin; chule ama khelin achapa Eleazer'in thempu tohmun lhachana chu atongtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chua konchun amaho Gudgodah'a alhungun, Gudgodah-a konin vapi twiho umna gam Jotbath alhungun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche laichun Pakai kitepna thingkhong puding le, Pakai angsunga dinga lhachana tong dingin, chule tunichan geija amin phatthei boh dingin Pakaiyin Levi phung chu achom khenin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh-a chu Levi'n asopite lah-a chan jong, gou jong aneilou ahi; Pakai na Pathen'un athupeh banga, Pakai chu agoulo hija ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin phat masa-a bang chun nisomli le jan somli molsanga chun kaumin; chule hichepet jong chun Pakaiyin eingaipeh-a, Pakaiyin nangho nasumang tapouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin kahenga, Kipatdoh-in, Apu apateu pehdinga kaki hahsel na gamchu alutnuva agalo theina diuvin, mipi ho chu lamkaijin, eiti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule tun, Israel, Pakai na Pathen'in nanga kona angeh chu ipiham, Pakai na Pathen chu naginna, alampi jouse-a najuija, ama nangailutna, nalung pumpi le nathaneina pumpi-a Pakai na Pathen najena,
  </para>
  <para style="p">
    <verse number="13" style="v" />Naphat theina dinga tunia kathupeh, Pakai thupeh hole achonna dan kisunho nanitding hi hilouham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Veuvin, van le vanho jouse van, chule leiset le asunga umjouse jonghi Pakai na Pathen uva ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla napu napateu ngailut ding bou chu Pakai lunglhaina ahin, amaho nunga achilhahteu, nangho jeng jong tunia nahinao bangahi mijouse chungvuma nalhenu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun nalungsung chep tanun lang, louchal tahih-un.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Pakai na Pathen'u hi pathenho Pathen, pakai ho Pakai, Pathen loupitah, hat chungnung, tijat umtah, mihem mai velou le, lepthol lalou ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman paneilou le meithai thu dihtah-in atanin, gamdangmi nehding le vonding apen angailun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun nanghon gamdangmi ngailuvin; ajehchu nangho jong Egypt gama gamdangmi nanahiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangman Pakai na Pathen nagin ding; ama najena, ama-a nabe ding, chule amina nakitep ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amachu navahchoi dingpa ahin, chule namit teni-a namu hiche thil loupile tijat umtahho nangma dinga ana bola na Pathen chu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Napu napateu chu Egypt gama mi somsagi toh anachesuh-un; chule tun Pakai na Pathen'un natamdanu chu van'a ahsi ho banga tamin nasemtaove.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh-a chu nangman Pakai na Pathen chu na ngailutna, aman nanganse na ho, achona dan kisunho, athutanna ho, chule athupehho nanit jingding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule tunikhon heuvin, ajehchu Pakai na Pathen'u gimbolna, aloupina, akhut thahat, chule aban jahdohna hekhalou le mukhalou nachateo henga thu kasei ahipoi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Egypt mite lailung tah-a Egypt lengpa Pharaoh chung le agamsung pumpi-a athilkidang bol ho le anatohho,
  </para>
  <para style="p">
    <verse number="4" style="v" />Egypt sepai ho chung le asakol hou chung, chule akangtalai chunga anabol ho, amahon nahin nungdel naova twipisan iti achupsah-u, chule iti dana Pakaiyin amaho tunigeija asuhmang ham,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hiche munna nahunglhun kahseuva gamthipma chu naheng uva ipi abol,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Reuben chapa Eliab chapateni Dathan le Abiram chunga ipi abol, leisetnin akam iti ahinkah-a amaho le a-insungu pumpi, chule apon inhou le Israelte lah-a anei jouseu aval lhum ham ti hekhalou le mukhalou nachateo henga thu kasei ahipoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin nangho mitnin vang Pakai thilbol loupiho jouse chu amun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu nahat theijuva, lodinga nachennao gam chu nagalo theina dinguvin, keiman tunia kathupeh, dan thupeh ho jousehi nanit dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutile Pakaiyin napu napateu leh achilhah teo pehdinga ahahselna, bongnoi le khoiju lonna gama chu nahinkhou sot thei ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu galo dinga nachenao gamchu nahungdohnao Egypt gam, anche louhing hon, muchi natheuva nakenga twi nachap jinao tobang ahipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla galo dinga nachenao gam chu thinglhang le phaicham umna, van gotuijin achap nou jingna gam,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai na Pathen'un avettup jingna gam, Pakai na Pathen'u mit chu kum kipatna pat kum kichaigeija achunga aum jingna gam ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hung hitiding ahi, Pakai na Pathen chu nangailutna nalung pumpi le nalhagao pumpi-a ama jen dinga tunia kapeh thupeh hi chingthei tah-a nangaija ahile,
  </para>
  <para style="p">
    <verse number="14" style="v" />Nachang, na lengpithei, chule nathao twi naki khoptup theina dinga van gotwi masale gotwi nunung aphatcha kapeh dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule naneh uva nava theina dinguva, nagancha teo dinga nagamsunguva hamhing kaphatsah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nalungsungu lheplhah-a aumlouna dingle, nakihei manguva pathen dang ho najen uva nahoulou nadingun chingtheijun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutile Pakai lunghan nachunga koujah intin, gojuh louna din van khah intin, leijin aga asodoh louding,Pakaiyin napeh-u gam phatah-a konin mangthah loi getnun nate.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun hiche kathuho hi nalungthim le nahinna-in vop inlang, namit teni kah-a thuchih bom tobang ahitheina din, nakhut chunga melchihna hidingin kanbeh-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hicheho chu nachateo nahil dingu, na-in'uva natou petnu, nalam jot petnu, nalup petnu chule natho tengu jongle nahil jingdiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule na-inkot khomho chung le nakotpiho chunga hichehi nasut dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutia chu napu napateu pehdinga Pakaiyin ahahselnau gama chu nahinkhou le nachateo hinkhoho chu leichunga vangam nikhoho banga sotding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu Pakai na Pathen chu ngailut ding, alampi jouse jotdinga chule ama-a behjing dinga kathupeh ho chu chingthei tah-a nanitna ahile,
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakaiyin namasanguva konin hiche nam jousehi anodoh ding, nangho sanga nasajole hatjo namho nahin lodiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nakeng phanguva nachot phahna chanu chu nangho-a hiding, gamthip le Lebanon'a pat, luipilen, Euphrates luipi-a pat twikhanglen mong gei sana nangho-a hiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Namasanguva ding ngam koimacha umlou ding ahi. Ajehchu aman naheng uva anasei banga, nachot phahdiu gamjousea chu Pakai na Pathen'un nangho gin nale kichatna akoiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Veuvin, tunin namasanguva phattheina le gaosapna kakoije.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pakai na Pathen nu thupeh ho, tu-a kapeh hohi nanit nuva ahile phattheina hintin,
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Pakai na Pathen'u thupeh nanit lou uva, nahetkhah lou pathen dangho houdinga, tunia kathupeh lampia kona nakihei manguva ahile gaosapna hiding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule hung hiti ding ahi, galo dinga nachenao gama chu Pakai Pathen'in napuilut tengu le, Gerizim molsang chunga chu phat theina nakoi uva, Ebal molsang chunga gaosapna nakoi dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichu Jordan gal langkhat, nisa lhumna lamsanga Moreh phaicham kom, Gilgal maijon muncham dunglaija Canaan mite chena gama chu uma hilouham?
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu Pakai na Pathen'un napehnao gamchu galo dinga Jordan nagalkai diu ahin, chule hichu nalouva, asunga nachendiu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule tunia namasanguva kakoi chonna dan kisun hole thutanna hochu nanitna dinguva nachihthei dingu ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichehohi napu napateu Pakai Pathen'in leisetna nahin laiseuva nalodiuva anapehnao gama nanitdiu chonna dan le thutan naho chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nagalo diu gama namhon molsang ho chung le lhangho chunga, chule thinghing phung engsel noitina, a-pathen hou anajen nau munho jouse chu nasuhmang soh heldiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amaicham ho nasuh chimuva, asong phu hou navohboh uva, athingbom hou meija nahaldiu, semthu milim pathenho naphuh lhuh uva, chuche munna kona chu aminu nasuhmang diu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai na Pathen'u henga vang chutia nabol loudiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla Pakai na Pathen'un naphung jouseu lah-a kona amin umna dinga alhendoh ding mun, hiche mun ngeichu nahol diu, hiche mun'a chu nahung diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hilama chu nagovam thiltohou, naganlhai na hou, na somakhat hou, nakhutjap thilpeh hou, nakitep nahou, nalung cham tah uva thilto natohou, nagan honu le na kelngoi hon lah uva apeng masapen ho chu nahin choidiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule chua chu Pakai na Pathen'u masanga naneh uva Pakai na Pathen'in nanatohna jouse-a phatthei nabohna chung changa nangma le na-insung mite jouse nakipa diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tunikho-a hilai mun'a mitinin ama mitmu-a dih asah chan abol banga hi nabol loudingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Pakai na Pathen'un napeh-u choldona le gou lona munchu nalhung hihlai tadiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla nangho Jordan nagalkaijuva, Pakai na Pathen'un lodinga nana peh-u gama nachen tengule, chule nakimvel uva namelma teu jouse-a kona choldona napeh tengule, bitkeija nachendiu ahitan;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutengle Pakai na Pathen'un amin umna dinga alhending munkhat umintin; hilama chu kathupeh jouse, nagovam thiltohou, naganlhai nahou, nahopsom hou, nakhutjap thilpeh hou, Pakai henga nakitepnao deilhen kitepna jouse nahinchoi dingu ahi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangho Pakai na Pathen'u masanga, nangho le nachapateo le nachanuteu, nasoh pasal ho leh nasoh numei hou, chule nakotpi sunguva um Levi miteho toh nakipa khomdiu ahi; ajehchu amaho nang hotoh chan le gou neikhomlou ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mun namuna jouse-a govam thilto nato louna dingin chingtheijin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla Pakaiyin naphung sungu khat penpena kona alhendoh ding munna chu govam thilto nato uva, chua chu kathupeh jouse nabolding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivanga Pakai na Pathen'u phattheiboh dungjuija aman napeh jouseu chu nalungin angaichat dungjuija nakotpi phung jouse-a natha-a, asa naneh theiding ahi. Mi atheng le atheng louvin jong, sapengchal le sakhichal hijongle aneh theiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thisan bou naneh loudiu, twibanga tolla nasunlhah diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nakotpi hou sunga chu nachang hopsom-u, nalengpi gao hopsom, nathao twi'u hopsom, nagancha houlah-a apeng masaho ahiloule nakelngoi hon lah uva apeng masaho, kitepna-a nakitepna hou, nalungcham thilto hou, nakhutna najap thiltohou chu naneh theilou dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amavang Pakai na Pathen'un alhending mun'a chu Pakai na Pathen'u masanga vang ,nang le nachapate le nachanute, nasoh pasal le nasoh numei ho, chule nakotpi hou sunga um Levi hotoh naneh teidiu ahi. Chule Pakai na Pathen'u masanga nakhut nangapna jouse-a chu nakipa diu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leichunga nahinlai chansea Levi mite nanot thap lounadin chingtheijin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai na Pathen'un nana teppeh-u banga nagamgi akehletna, chule, Nahinna-in sa nehding ngaichat jeh-a sa nenge nati tengle, nahinnan aduchat sa chan chu naneh thei ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakai na Pathen'in amin koina dinga analhen munchu nanga kona agamlat behsetna ahile, keiman kathupeh banga, Pakaiyin napeh nagancha hon le nakelngoihona kona natha-a, nakotpi phunga chu nahinna-in aduchat channa naneh ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sapeng chal leh sakhichal kineh banga naneh ding ahi; athengle atheng louvin kibanga aneh dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thisan bou chu naneh louhelna dingin chingtheijin; ajehchu thisan chu hinna ahin; chule hina chu asa toh naneh koptha theilou ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nanghon hichu naneh loudiu, twibanga tolla nasunlhah dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pakai mitmu-a thildih nabol tengle, nangma le nanunga nachate naphat theina dinguva hichu naneh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nathil theng neiho le nakitep naho bou chu nachoija, Pakaiyin alhending mun'a chu nache ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule na govam thilto chu asa le athisan agoma Pakai na Pathen'u maicham chunga na nato-a, chule aganlhaina thisan chu Pakai na Pathen maicham chunga kisung lhading, asachu naneh ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pakai na Pathen mitmu-a apha le adih nabol tengle, nangma le nanunga nachate dinga a-itih-a naphat theina dinguva, nangman kathupeh jouse hi lunglutna nangaija nanitding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakai na Pathen'in galo dinga nachenao gama nampiho chu namasanguva kona asuhmanga, nanghon amaho najo uva, agamuva nachen tengule;
  </para>
  <para style="p">
    <verse number="30" style="v" />Namasanguva kona akisuhmang banguva, amaho nung najuina-a na-o louna ding le, hiche namhohin itobanga a-pathen'u ajenum? amaho bolbangin eihon jong bolute, tia a-pathen'u thudol hou nakhol louna dingun chingtheijun.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hitobanga chu Pakai na Pathen'u henga nabol loudingu ahi. Ajehchu amahon Pakaiya thet umjouse, ahot ho chu abol jiuvin, achapateu le achanuteu san a-pathen dingun meijin ahal jiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Boldinga thu kapeh chanchu nabolding ahi; hichea kona chu nabelap louding, lah jong nalahdoh louding ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nalah uva themgao ham, mang neiham asodoh-a, melchihna ham, thil kidang namusah uva,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule melchihna ham, thil kidang ham chu aguilhuna, chule naheng uva, Nahet khahlouvu pathen dangho juiju hitin, amaho jennu hite tia aseile;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon chuche themgao ham, mang neipa ham thuchu ngaihih-un; ajehchu Pakai na Pathen'in nalung pumpile nalhagao pumpiuva Pakai na Pathen'u chu nangailut nangailut lou hetna dia napatepmu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon Pakai na Pathen'u nung najuijuva, naginuva, athupeh ho nanit uva, athu naman uva, ama najen uva, chule ama-a nabediu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule chuche themgao ham, mangnei ham pachu tha jengding ahi; ajehchu Pakai na Pathen'u Egypt gama nahinpuidoh uva, sohchana in'a kona nalhatdoh paova kona kihei mangna ding thu aseijin, Pakai Pathen'in chedinga thu napehnao lampia kona kiheimang ding nagouvin ahi. Chutia chu nanghon agilou chu nalah uva kona chu nasuhmang diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanu chapa nasopipa ham, nachapa ham, nachanu ham, na-angkoi na-inneipi ham, nagol napai ham, nahinna tobang hela nagel khatnin guhthima najola, nahenga, Nangman nahetkhah lou, nangma le napaten ahetkhah louvu pathen dangho gahouvu hite;
  </para>
  <para style="p">
    <verse number="7" style="v" />Nakimvel uva mite, nakom naiham, gamlatah-a umham, kolmonga pat kolmong langkhat gei pathen ho chu gahouvu hite tia aseija ahileh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman amachu nanoppeh louding, ngaijong nangaipeh louhel ding; namitnin jong akhotolou ding, kheh jong nakheh louding, chule imjong na-im mang lou ding;
  </para>
  <para style="p">
    <verse number="9" style="v" />Amavang natha teitei joh ding; nangman ama thana dinga achunga nakhut nalhah masat pending, chujoule mipijouse khut chu achunga chuding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule ama chu songa nase-a naselih dingu ahi; ajehchu aman Egypt gamsunga sohchana in'a kona nahin puidoh Pakai na Pathen'a kon heimang ding nagon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutia chu Israel jousen ajah uva, kicha diu, chule nalah uva hitobang gitlounahi abolkit tah loudingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai na Pathen'in chenna dinga nanapeh khopiho khatna thu kisei;
  </para>
  <para style="p">
    <verse number="13" style="v" />Nalah uva kon mi phabep, Belial chate achedoh-un, akhopi sunguva mite chu ajol lhaovin, ajah uva, Nanahet khah louvu pathen dangho lhachana tong dingin cheohite, tia kisei najah-a ahile;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuteng nangman nadoh toh ding, nakhol ding, gunchutah tah-a nadoh ding, chule ven, hichu thutah ahia, chutobang thet umchu nalah uva akibol tahbeh ahi-a ahile;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuche khopi-a chengho chu chemjam hema natha teiding, chua cheng jousele, chua ganchahon chu chemjam hema nasuhmang hel ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule chua galthil kichom jouse chu kholai lamlena nakhop sohkeija, chuche khopi le thilkichom takip chu Pakai na Pathen dinga meija nahalding ahi. Chule hichu a-itih-a dinga kisevuma, avela kisadohkit louhel ding ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nakhutna gaosap thil natohkhah louding ahi: chutile Pakai chu tijat umtah alungsatna-a kona akileheija, napu napateu henga anamusah banga hepina namusah-a, nachunga lainatna aneija, napunsah ding ahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu Pakai na Pathen mitmu-a adih bolna dinga tunia keiman thu kapeh ama thupeh jouse nanitna dingin, Pakai na Pathen aw nangaijin ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho Pakai na Pathen'u chate nahiuve: mithi puldou na-a nangho le nangho naki-at chen loudingu, chule namitmulu jong nahet tol louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu nangho Pakai na Pathen uva dinga mitheng nahiu ahin, chule Pakaiyin leichunga um nam jouse chungvuma ama-a tum hidinga achombeh-a nalhenu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon thet um kiti mongmong naneh louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon naneh dingu saho chu: bongchal, kelngoi, chule kelcha.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sakhichal, sapengchal, sajuh, gamkel, gambongchal chule gamkelngoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule sa jouse lah-a kon akengtin kikhena atin ni-a kika, chule anehsa ihdoh kitna lhaikit tapou chu naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijongle anehsa ihdoh kit ahiloule atin kikhenkah lah-a kon sangongsang, telep, jupi, hichehohi naneh loudiu ahi; ajehchu amahon anehsa a-ihdoh-un alhaikit naovin ahin atinnu vang akika pon ahi. Hijeh-a chu nangho dinga athenglou hiuva ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule vohcha jong atin akikah vangin anehsa a-ihdoh-a alhaikit lou jeh-in nangho dinga athenglou ahi. Nanghon asao naneh loudiu, athilongu jong natohkhah loudiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Twilah-a ganhing nenehthei houchu hichehohi ahi: alha nei le alipnei jouse naneh diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule alha le alip neilou jouse chu naneh loudingu ahi; hicheho chu nangho dinga thenglou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vacha theng jouse naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin naneh loudiu hochu: muvanlai, mungagal, muthong
  </para>
  <para style="p">
    <verse number="13" style="v" />Muvom, mubong, chule muthong toh kilimlo jouse.
  </para>
  <para style="p">
    <verse number="14" style="v" />Va-ah le amatoh kilimlo jouse,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule sumbu, vabah, kakhut, chule mu toh kilimlo jouse.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sumbuchanglit, sumbupi, twivatot,
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule twivamuhsao, muthong lhem, vatot muhkon
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule twilungva, twivakang le akilimlo jouse, vakhong lhu le bah,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule a-opma kitholtho-a lengthei takip nangho dinga athenglou ahi: hicheho chu nehlou ding ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla vacha thengho jouse chu naneh theiju ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nanghon athikam imacha naneh loudingu ahi: hichu nakotpi phunga um kholjin mihon anehdiuva napeh ding; ahiloule gamchom mi henga najohthei ahi. Ajehchu nangho Pakai na Pathen'u dinga mitheng nahiu ahi. Nanghon api noitwija kelnou nahon loudingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Akumtina nalouvin asodoh namuchi-a kona hungpeng doh jouse hopsom-a hopkhat thonlouva napeh ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakai na Pathen ginje nakihil jing theina dinga, nachang hopsom, nalengpi theiga hopsom, nathao twi hopsom, nabonghon le nakelngoi hon na kona peng masaho chu amin umna dinga alhendohna munachu Pakai na Pathen angsunga naneh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakai na Pathen'in phatthei naboh teng, Pakai na Pathen'in amin umna dinga alhendohna mun chu nanga kona agamlhat behsetna, ahiloule alampi chu asao behsetna, chutia chu napoh joulouva ahile;
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangman athil chu sum nasosah-a, sum chu nahin choija, Pakai na Pathen'in alhendohna mun'a chu nacheding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule hiche sum chu nahinna-in angaichat jouse bongchal ham, kelngoi ham, lengpithei ham, ahiloule zuchih ham, nahinnan angaichat jouse chohna-a namana; chukoma chu Pakai na Pathen angsunga naneh-a, nangma le na-insung mite kipah tah-a naum dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule nakotpi sunga um Levi mite chu nanot thap louding ahi; ajehchu aman nangma toh chan le goulo aneikhom pon ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kumthum akichai sehle chuche kum-a nathilsoh jouse hopsom nahin choija, nakotpi sunga nasetkhom ding,
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Levi mite (ajehchu amahon nangma toh chan le goulo aneikhom lou ahi,) le na kotpi sunga um namdang mi, pabeiho, chule meithaiho chun aneh uva vading ahiuve; chutile Pakai na Pathen'in nakhutna natoh jouse chu phatthei abohna ding ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kum sagi kichai sehle lha ongna nabolji ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule lha ongna umdan chu hichehi hiding ahi: aheng akom batna pechanin alha-ong ding ahi; aheng akom ahiloule asopi batna homa chun alahpeh teitei louding ahi; ajehchu hichehi Pakai lha-ongna kiti chu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamdang mi batna napeh vang chu nalelah kit thei ahi, ahinla ipi hile nangma-a nasopi henga umchu nalha-ong ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche jeh-a chu nalah uva koima avaicha umlou ding ahi; ajehchu lodinga Pakai Pathen'in napeh gama chu Pakaiyin nasatah-a phatthei naboh ding ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Tunia thu kapeh hiche thupeh ho jouse jui dinga Pakai na Pathen aw chu kituptah-a nangaija ahile.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu aman nana thutep banga Pakai na Pathen'in phatthei naboh ding ahin: nangman nam tamtah henga nahop ding, amavang nangman apa nalah louding; nam tamtah chunga vai nahom ding, amavang amahon nang chunga vai ahomloudiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai na Pathen'in napehna gama nakotpi sunga chu nasopite khattou nalah uva vaicha auma ahile, nangman nalung natahsah louding, nasopi vaicha-a kona nakhut nakihsah louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amavang ahenga naphalna khut nalhana, alhahsamna-a angaichat lhingsetna napehjoh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman nalungsung gilouva chun Kum sagina lha ongna kum anaitai tia nagel louna dingle; nasopi chunga namit thipma ima pelouva naum louna din chingtheijin; chutile nangma dounan Pakai kou intin, nadingin chonset hikhante.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangman ama napeh teitei ding; chule ama napeh tengle nalung nanatsah louhel ding ahi. Ajehchu hiche-a ding tah-a chu Pakai na Pathen'in natoh jouse le nakhutna nabol jouse chu phatthei aboh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu gamsunga kona migenthei beitih umlou ding ahi. Hijeh-a chu nagamsunga nasopipa, nami vaichapa, namilhasampa chunga nakhut hongphalin tia thu kapeh nahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nasopi Hebrew mi pasal ham, ahiloule numei ham nahenga hung kijoh auma, kumgup nangma najentah-a ahile; akum sagi lhinnale nanga kona ongthola nalhadoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nanga kona ongthola nasoldoh tengle, agohkeova nachemang sah louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nakelngoi hona kon, nachang phola kon, nalengpi ga chilna-a kona itlou hella napeh ding; Pakai na Pathen'in phatthei naboh na-a kona chu ama napeh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangman jong Egypt gama soh nanahi-a, Pakai Pathen'in nalhatdoh ahi chu nageldoh ding ahi; hijeh-a chu tunia hichehi kathupeh nahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hitiding ahi, nangma le na-insungmi angainat jeh, nangma toh umkhom nop asah jeh-a, amachun nahenga, Nanga konin chemang ponge ati-a ahileh;
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman thih hemkhat nalah ding, kotkhah phunga abil navuding, chule amachu a-itih a dinga nasoh hiding ahi. Chule nasoh numei chunga jong chutobang ma-a chu nabol ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nanga kona ongthola nasoldoh chu nang dinga thil hahsatah tobang hilouding ahi; ajehchu thalah soh natoh chan ni atoh-a kum gup set nangman najen ahi. Chutia chu Pakai na Pathen'in natohna channa phatthei naboh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nagancha hole nakelngoi hon lah-a achal pengmasa ho jong chu Pakai na Pathen dinga nathenso ding: nabongchal peng masapen chu na natoh sah louding, nakelngoi honlah-a apeng masapen jong chu amul navo louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule hichu nangma le na insung miten kumsehle Pakaiyin alhenna mun'a chu Pakai na Pathen angsunga naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule alah-a nolna nei auma, akengbai ham, amitcho ham, deimotah-a nolna nei umtapou chu Pakai na Pathen henga ganlhaina-a nato louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangin hichu nakotpi ho sunga naneh ding: mi aboh le athengin kibang tah-a sapeng chal le sakhichal sa kineh banga anehdiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Athisan bou chu naneh louding, twi banga tolla nasunlhah ding ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abib lhachu nit inlang, Pakai na Pathen henga kalchuhkut bolin: ajehchu Abib lha jan laija chu Pakai na Pathen'in Egypt'a kona nahin pui ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh-a chu Pakaiyin amin umna dinga alhena mun'a chu ganchahon le kelngoi hon lah-a kona Pakai na Pathen henga kalchuh kut ganlhaina nabol ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangman hichu chol kiso changlhah toh naneh louding; Egypt'a kona nahung dohlai nikho chu geldohna dinga nahinlaise-a cholsolou changlhah, gimbolna changlhah ngei chu nisagi naneh ding ahi; ajehchu Egypt gama kona kinotah-a hung doh-a nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nagamsunguva chu nisagi sung chol kiso changlhah himhim kimulouding; chule nimasani nilhah lama naganlhai sa chu jankhovah jingkah geija umlou ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakai na Pathen'in napehna kotpi sung khat penpena chu kalchuhkut ganlhaina nabolthei louding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amavang Pakai na Pathen'in amin umnadia alhending mun'a chu, Egypt gama kona hungpotdoh phattah, nilhumdon, nilhah lama chu kalchuhkut ganlhaina nabolding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Pakai na Pathen'in alhending mun'a chu asa chu nago-a naneh ding, jingkah le nakile-a, naponbuh-a nache ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nigup sunga cholsolou changlhang naneh ding; nisagi nile Pakai na Pathen'a dinga kikhop loupi umding ahi. Hiche sunga chu na natoh louding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman hapta sagi nasimdoh ding: hapta sagi chu chang-atna dia koite nalap pat ni-a patna nasim ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai na Pathen henga nakhut tah-a lungcham thilto nato-a haptaho kut chu nanit ding, Pakai na Pathen'in phatthei naboh dungjui bangtah-a Pakai na Pathen henga napeh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pakai na Pathen'in amin umna dinga adeilhen mun'a chu Pakai na Pathen angsunga nangma nahin, nachapa ahin, nachanu ahin, nasohpa ahin, nasohnu ahin, nakotpi sunga um Levi mite ahin, nangma to umkhom namdang mi ahin, pabeiho ahin, meithai ahin, nakipa dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangma tahjong Egypt gama sohchanga ana um nahi nageldoh-a: hiche dan kisunhohi nanitna nabol ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nachang le nalengpi ga nakhoptup jou tengle, nisagi sung lhambuh kut naman ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule na kut sunga chu nangma nahin, nachapa ahin, nachanu ahin, nasohpa ahin, nasohnu ahin, chule nakotpi sunga um Levi mite ahin, gamdangmi ahin, paneilou ahin, meithai ahin nakipa dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakaiyin adeilhen na ding mun'a chu Pakai na Pathen'u henga nisagi sung kut loupi nabol dingu ahi. Ajehchu Pakai na Pathen'in nalhosoh jouse le nakhutsoh jouse chunga phatthei naboh ding ahin, hijeh-a chu nakipa teiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kumkhat sunga na pasal jouseu Pakai masanga aman adeilhen mun'a chu thumvei gaki lulah dingu ahi; cholsolou kutna, haptaho kutna, chule lhambuh kutna: chule Pakai masanga khutgoh keova kilulah loudingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mitinin Pakai na Pathen'un apeh phatthei bohna dungjuija ajokham cheh apehding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai na Pathen'in napeh nakul kotpi jouse-a, naphung jouse-a thutan hole vaipoho natundoh ding: chule amaho chun mipi thuchu dihtah-a atanpeh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dihlou tah-a thu natan louding; mihem mai vea jatum na neilou ding; nehguh jong nalah louding ahi: ajehchu nehguh chun miching mit asuchon, michonpha ho thusei jong aheikon jin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai Pathen'in napehna gam chu nalo theija, nachen theina dinga, adih bouchu najui ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakai na Pathen maicham nasem nading vella chu ipi thing hitaleh thingbul naphu louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai na Pathen'in ahot milim tapou natundoh louding ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bongchal ahiloule kelngoi chunga nolna nei, ahiloule deimona um tapou chu Pakai na Pathen henga ganlhaina-a nato louding ahi. Ajehchu hichu Pakai na Pathen dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai na Pathen'un napeh-u kotpi sung hoichepen hijongle, nalah uva Pakai na Pathen thutep sukeh-a amitmua gitlouna bol pasal ahiloule numei akimu doh-a,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen dangho agajena, keiman kathupeh hilou nisa ham, lhathah ham, van janel khattou ahouva;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hichu nangma nakisei peh-a, nangman najah-a, gunchu tah-a nadoh toh-a, chule ven, hichu adih ahia, Israel sunga chutobang thil thet um bolla aum chu akiphotchetna ahile:
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutobang thilse bol pasal ahiloule numei chu nakul kotpi phunglama napui doh-a, chuche pasal ahiloule numei ngeichu, chule athikah seuva songa nase dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahetoh mini, ahiloule mi thum kama kona thidinga lompa chu tha hiding ahi; ahin ahettohsah mi khat kama vang amachu kithat louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama thana dinga chu ahettohsah hon akhut alap masat pen dingu, chujoule mipi jousen khut alhahdiu ahi. Chutia chu nalah uva thilphalou chu nasuhmang diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thisan kiso thu, them kichu thua, kivohto thu, nakotpi sunga kinel nohphah na thu nang dinga ageltoh hahsa behseh ahung sodoh-a ahile: nakipat doh-a, Pakai na Pathen'in adeilhen ding mun'a chu nache ding;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuche laija Levi thempuho le thutana pang ding pa henga nahunga, nadoh tohding; chule amahon athutan lhuhnao chu namusah dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Pakaiyin adeilhen ding mun'a mihon namusahdiu dungjuija chu nabolding; chule nahetsah-u jouse dungjuija nabolna dinga nachih theiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amahon thulhuh dan nahil dungjui le, thutan dan nahil dingu dungjuija nabol ding; amahon namusahdiu thu lhuhsah-a kona chu jetlam le veilama napeldoh louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Pakai na Pathen anga kinbola pangji thempu thu le thutanpa thu ngailouva ama kisongpa ngei chu thi ding ahi: chule Israel lah-a kona aphalou chu nasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutile mijousen jaovintin, kichaovintin, ama le ama kisongin ima boltapou vinte.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai Pathen'in napehna gam chu nahung lhuna, hichu nalo-a, asunga nachenna, Avela namho jouse bangin kachunga lengkhat kisem inge nati tengle;
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai na Pathen'in alhendingpa tahchu iti jongle lenga natunding ahi: nasopite lah-a kona mikhat chu nachunga lenga natunding ahin; nasopi hilou namdang mi chu nachunga natunlou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla aman ama dinga sakol apunsah louding, ahiloule sakol apunsahna dinga mite chu Egypt gama akilesah louhel ding ahi: ajehchu Pakaiyin naheng uva, Nangho hiche lampia chu nakilekit louheldiu ahi, anatin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Alung kiheimang louna dinga jijong tampi anei louding; chule sana dangka jong nasatah-a apunsah louhel ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiti ding ahi, ama alenggam laltouna-a atouteng, Levi mite le thempuho angsung um hiche dan thuhi lekhabu khatna akijih dohding:
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hichu amatoh umkhom ding, ahinkho lhum keija asimding ahi: chuti henglang hile Pakai ginje ahetna, chule hiche danthu-a thuchengho le dan kisunho chu atohdoh na dinga chingthei ding,
  </para>
  <para style="p">
    <verse number="20" style="v" />Asopiho chunga alungthima akichoisang lou ding, chule thupeh-a kona jetlam ahiloule veilama akihei manglou ding; achaina geija Israelte lah-a ama ahin achate ahin alenggam sunga ahinkho sot thei ding ahi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thempuho le Levi ho, chule Levi phung jouse chun chanle gou Israel toh aneikhom theilou diu ahi; amahon meija kigou Pakaiya dinga thiltoho le Ama chanho chu aneh dingu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh-a chu amahon asopite lah-a gou aneiloudiu ahi: aman ahenguva aseibanga, Pakai chu agoulou ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule mipi-a kona thempu chanding chu hicheho hi ahi, bong ahiloule kelngoija ganlhaina thilto hintoh hochun thempupa chu adah, akhalhang, chule agilpi apeh dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman na chang ga masapen, lengpitwi masapen, thaotwi masapen, chule na kelngoimul kivou masapen jong ama napeh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Pakai na Pathen'in amale achapate chu a-itih-a Pakai mina lhacha na tong dinga naphung jouseu lah-a kona ana lhendoh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Levi mikhat chu akhopemna Israel jouse lah-a khopi khatpen pena kona ahunga, Pakaiyin alhending mun chu alungpumpia ngailutna neija ahunga ahile;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuteng Pakai anga dingjing asopi Levi hon abol bang banga Pakai a-Pathen mina lhacha-a pangding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Agouchan kijohna-a kona amu tilou amahon nehding chan kibang aneicheh dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai na Pathen'in napehna gam chu nalhun tengle, chuche namho chonna thet umtah hochu boldinga naki themchuh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nalah uva achapa ham ahiloule achanu ham mei pal galkaisah, ahiloule ailhim mangcha, gaothusei, mitpheldoi mangcha, ahiloule doichoi,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahiloule milhimthei, lhagao bohtoh kijol, doi-aithem, mithilha koutheiho chu nalah uva umloubeh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu hiche thilho boljouse chu Pakai dinga thet umtah ahin; chule hiche thet umtahho jeh-a hi Pakai na Pathen'un na-angsung uva kona amaho anodoh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangma Pakai na Pathen angsunga pha chamkim nahiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu naloding hiche namhohin gaothusei ho le aisan ho thu angaiju ahin; nangma vang Pakai na Pathen'in chutia boldin naphalpoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai na Pathen'in nalah uva kon, nasopite lah-a kona keima tobang themgao khat nahin tundoh pehdingu ahin; amathu chu nangaidiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Horeb mun'a kikhopi nikho-a, Kathi louna din Pakai ka Pathen aw neijah sahkit danlang, hiche meikong nasatah hi neimusah kit hih-in, tia Pakai na Pathen nangaichatna jouse dungjui chun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakaiyin kahenga, Amahon aseiju chu aseikha lheh-uve ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keiman asopiteu lah-a konin nangma tobang khat themgao khat tundoh peh ungting, akamsunga kathu kakhum ding; keiman ama kathupeh ding jouse chu aman ajah uva aseipeh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hitiding ahi, aman kamina aseiding kathu hohi angailou chanchu, keiman ama-a kona hichu kangeh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla aseidinga thu kapehlou kamina achama thusei themgao, ahiloule pathen dangho mina thusei chanchu, chuche themgao ngeichu thiding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangman nalungthima, Thu chu Pakaiyin asei ahipoi ti iti kahet ding ham? nati-a ahile,
  </para>
  <para style="p">
    <verse number="22" style="v" />Themgao khatnin Pakai mina thu aseija, aseidoh thilho chun anung ajui louva, ahung guilhun louva ahile, hiche thilchu Pakaiyin asei hilou ahin; amavang themgaopa chun hichu ama lungchama asei ahi: nangman ama chu nakichat louding ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai Pathen'in agamu napeh amaho chu Pakai na Pathen'in asuhmanga, chule nangman agamu natoupha-a, akhopi hou le a-inhouva nachen tengle;
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai Pathen'in lodinga napehna gam lailunga chu khopi thum nakhendoh ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai Pathen'in lodinga napehna gam pumpi chu hopthum-a nahopkhen na, tolthat takip jamlut theina dinga lampi nagon ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule tolthat ahintheina dinga chumuna jamlut dingho thudol chu hichehi ahi: amasanga kihot tona umlouva tosoija aheng akom that ho;
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi aheng akom toh gam manga thingphuh dinga achea, thingchu phuhlhuh nadinga aheicha chu alap donga, achang chu aga-a kona alendoh-a, aheng akompa chunga achuh-a, athi-a ahile; hiche khopiho khatna chu jamlutna hingding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amasa hotna aneiloujeh-a ama chu thidinga lom ahilou vangin, thisan phu lapan tolthatpa chu alungsat petnin nungdel intin, lampi asaojeh-a phapantin, that getninte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh-a chu khopi thum nakise khen ding ahi, tia thu kapeh nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Pakai na Pathen'in napu napate henga peh dinga anahahselna gamchu akehletna, napu napate pehdinga athutep gam apumpi chu napeh-a ahile;
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai na Pathen chu ngailut ding le alampi jot jing dinga, tunia thu kapeh hiche thupeh jousehi nanitna ahile; hiche khopi thum tilouva khopidang thum jong nakibelap thei ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutia chu Pakai Pathen'in lodinga napehna gamsunga chu thisan phu nachunga aumlouna dinga, monabei thisan kiso umlou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla khat touvin aheng akom ahotna amachu achanlhih-a, ama douna-a akipatdoh-a, thina theija avoh-a, athitah-a, hiche khopiho sung khatna chu ajamlutna ahile;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuteng akhopi upaho chun mi asola chua kona ahinpuijuva, athi theina dinga thisan phulapa khutna chu apehdoh diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Namit nin ama chu akhoto louding, amavang aphatna dinga themona bei thisan kiso chu Israel'a kona nasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai Pathen'in lodinga napeh nagoulona gamsunga malaija mihon anaphu sao, naheng nakom gamgi chu nachondoh louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihem khat themona ahin, ahiloule chonsetna ahin, itobang chonsetna bola hijongle, mikhat douna-a hettohsah khat kipanlou ding ahi. Hettohsah mini ham ahiloule mi thum ham kama bou athudol chu kisudet ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hettohsah lhem khatnin mikhat thilbol adihlouva ngoh dinga ahung kipatdoh-a ahile;
  </para>
  <para style="p">
    <verse number="17" style="v" />Akinel teni chu anilhona chuche nikho laija thempu le, thutanpa masang Pakai angsunga chu ding lhonding;
  </para>
  <para style="p">
    <verse number="18" style="v" />Thutanpa chun gunchu tah-a kholtoh ding: chule veuvin hettohsah chu hettohsah lhem ahia, asopi chunga dihlou tah-a ahettohsah ahile;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle asopi chunga bolding agot bang banga chu, amachunga naboldiu ahi. Hitia chu nalah uva kona thilse chu nasuhmang diu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule aumnalai ho chun ajah diu, kichadiu, chukalle chutobang thilse chu nalah uva abolkit loudiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule namitnin akhoto louding; hinkho khela hinkho, mit khela mit, ha khela ha, khut khela khut, chule keng khela keng kila ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Namelmate sat dinga nakon doh-a, sakol ho, akangtalai ho, mipi nang sanga tamjo namuteng, amaho chu kicha hih-in; ajehchu Egypt gama kona nahinpuidoh-a Pakai na Pathen chun naumpi jingnai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hitiding ahi, gal nasatdiu konle, thempu chun mipi ho chu anailutna akihoupi ding,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ajah uva, Ngaijun, Vo Israel, tunia hi namelma teu satdia nahung naiju ahita: nalungu lhahsah hih-un, kicha hih-un, hot jong kihot hih-un, chule amaho jeh-in tijong tija hih-un;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Pakai na Pathen chu nangho huhhing dinga, nangho dinga namelma teu satdinga nangho toh lhonkhoma ahi, atiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule gal lamkai ho chun mipi jah-a, Inthah sa-a thensolou mi koi naum uvem? Ama chu a-in lama chedin kilekit tahen, achuti loule gala thi intin, midangin kithenso getninte.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule lengpihon sema aga neloulai naum uvem? Ama jongchu a-in lama chedin kilekit hen, achuti loule gala thi intin, midangin aga kineh getninte.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule jihol neija kichenpi loulai naum uvem? Ama chu a-in lama chedin kilekit tahen, achuti loule gala thi intin, midangin kichenpi getninte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule lamkai ho chun mipi ho henga asebe nahlai ding, Akichale alungthoi naum uvem? Ama chu a-in lama chedin kilekit tahen, achuti loule ama lungbang bangin asopite lungthoi getninte, atidiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hitiding ahi, lamkai hon mipi henga thu aseichai tengule, agalsat lamkaiho chu mipi amakaisah ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khopi khat satdinga nahungnai tengle, ahenguva chamnathu seiphongin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hitiding ahi, chamna thua nahin donbut nuva, nahenga ahung kihon uva ahileh, hiti ding ahi: chua um mijouse chu nanoija hiuva, nangma najen dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin nakichampi nomlouva, nangma nanasat thuh-a ahi vangle, nangman hichu na-umkhum ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Pakai na Pathen'in nakhutna napehdoh tengle, chua pasal jouse chemjam'a monghema nathagam ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla numei ho le naosen ho, ganchaho le khopi sunga umjouse, chua thil kichom jouse geija nakilah ding; Pakai na Pathen'in nanapeh namelma teu thil nachomho chu naneh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche nam miteho khopi hilou, nanga kona gamlatah-a um khopiho jouse chunga chutia chu nabol ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla Pakai na Pathen'in nagou loding napeh hiche khopi ho-a mite chu, ahaithei khatcha nahinghoi louding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hit mite, Amor mite, Canaan mite, Perizz mite, Hiv mite, Jebus mite chu Pakai na Pathen'in nathupeh banga nasuhmang helding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutia chu amahon a-pathen hou chunga abolu thet umtah chonnaho chu nahil louna ding ahi; achuti loule Pakai na Pathen'u chunga nachonset khah ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khopi khat lah dinga achunga gal nabola, phat sottah na-umkhum teng, chukoma thingphung ho chu heicha-a naphuh-a nasuh manglou ding ahi. Ajehchu naneh thei ahin, kulpi umna-a pangdinga naphuh lhuh louding ahi, (ajehchu loujaova thingphung ho hi mihem hinkho ahi).
  </para>
  <para style="p">
    <verse number="20" style="v" />Nemse ahikah seuva nangma kisatpi khopi chu umkhum na dinga, aga kinelouva nahet thingho bou chu nasuhmanga naphuh lhuh ding ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai Pathen'in lodinga napeh gamsunga chu mikhat kithatna, loujaova along luma, koitha ahi kihelouva aumle:
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuteng na upahou le nathutan hou hunguva, akithatpa-a kona akimvela khopiho chu atediu;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hitiding ahi, akithatpa-a kona khopi naipen, hiche khopi-a um upaho ngeichun bongla natong loulai, koljon kaikha loulai khat ahinkaijuva;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule chuche khopi upaho chun bongla chu loukikai loulai le ima tuloulai phaichama chu akai lhah uva, chuche phaichama chu angong atan lhahdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule thempuho Levi chapaten ahin nai dingu ahi; ajehchu amaho chu Pakai na Pathen'un akin bol dingle, Pakai mina phattheiboh dinga alhendoh ahin; kinohphahna tin le kivohtona thutin chu athuva kona kitan ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule akithatpa-a kona khopi naipen upaho jouse chun phaichama angong kitan bongla chunga chu akhutnu akisop uva,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amahon hitia hi adonbut uva aseidingu ahi, Kakhut uvin hiche thisan hi aso ahipon, chule kamitnun jong amupon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai, nalhatdohsa nami Israelte henga hepina neijinlang, chule themona neilou thisan kiso hi nami Israelte chunga nga hih-in, atidiu ahi. Chutile thisan kiso chu ngaidama umding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutia chu Pakai mitmu-a apha naboltengle, nalah uva kona mona neilou thisan kisochu nakoimang dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Namelmate chunga galbol dinga nakon doh-a, Pakai na Pathen'in amaho chu nakhutna napeh doh-a, gal hinga nakaija,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule sohchangho lah-a chu numei melhoi namu-a, deichatna naneija, naji dinga nangaito-a ahile;
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman amanu chu na-in lama napui ding, alu akivo tolding, chule atinho atan ding;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule amanun asoh channa von chu ama-a kona aholhah-a, na-inna umden ding, lhakhat lhingset anu le apa pul adou ding ahi: chujouteng amanu henga nalutna, a-inneipu nahi-a, chule amanu na-inneipi hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hitiding ahi, nangman amanu-a kipana naneilouva ahile, anop nopna-a nasolding; amavang sum manavang najoh louhel ding, kiveina-a nanei louhel ding ahi; ajehchu amanu nasuhnem ahitai. Chapa Lenpen Goulo Thudol;
  </para>
  <para style="p">
    <verse number="15" style="v" />Pasal khatnin jini aneija, khat angailutna, khat ahotna, amani adeinu le ahotnu chun chate ahinpeh gel lhona; achapa masapen chu ahotnu hin ahile,
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuteng hitiding ahi, aman anei agou chu chapate losah dinga agot teng, ahotnu chapa apeng masa sanga chu adeinu chapa apeng nukhahjo chu apengmasa-a asem louhel ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aneijouse lah-a channi apeh-a kona ahotnu chapa chu apeng masa-a asim ding ahi. Ajehchu amapa chu thahat kipatna ahin; pen masatna chanvou chu ama-a hija ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mikhatnin chapa louchal le kiphinhat aneija, apaham anuham thu ngailouva, gimbolna apeh teng jongle athuhon angailouva ahile,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuteng anu le apan amatlhona, akhopi upaho heng le aumnao kotpi phunga ahinpuidoh lhonding;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amanin khopi upaho henga chu, Hiche kachapa lhonhi louchal le kiphinhat ahin, kathulhon ngaiding anompoi; amahi neh hatle julop ahi atilhonding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule akhopi sunga pasal ho jouse chun athina dinga songa asediu ahi. Chutia chu nalah uva kona agilou chu nakoi mangdiu; Israelte jousen ajah uva, kichadiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule pasal khatnin thinalom chonset abola, amachu thading ahia, amachu thinga nakhai lih-a ahile;
  </para>
  <para style="p">
    <verse number="23" style="v" />Along chu jankhovah-a thing chunga umden louding, hiche nima ma chu navuitei ding ahi; (ajehchu akikhai chu Pathen gaosop changa ahi;) Pakai Pathen'in goulo dinga napeh gamchu akisuboh louding ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nasopipa bongchal ahiloule kelngoi vahmang namu-a ahile nakimu mosah louding ahi: iti nama jongle nasopite henga nahinpuilut teiding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nasopipa chu nanaija umlou ahia, ahiloule nahetlou ahia ahile, na-in'a nahin kaija, nasopin ahinhol kahse-a naumpi-a, chule amachu nalepeh kitding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutobang ma-a chu asangan chunga nabolding; aponsil chunga nabol ding; nasopipa mansah thil mang jouse nangin namu chasun chu chutobanga chu nabolding; nangman nakiselden louding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nasopi ho sangan ahiloule bongchal lamsih-a lhu-a namu-a ahile nakimu mosah louding ahi: nangman amaho akaidoh-a aumkitna dinga nakithopi tei teiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Numei jin pasal von akivon louding, pasal'in jong numei von akivon louding ahi. Ajehchu chutia boljouse chu Pakai dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lamdunga nache na-a vachabuh thingchung ham, tollhang hama anou ham atwi ham um nato-a, apin anou ham, atuiham chu aopkhuma ahile, api chu anou toh nalahkop louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amavang api chu itijong le nalhadoh-a anou vang chu nakilah ding ahi; chutile nangdin phantin, chutia chu nahinkho sotding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />In thah nasah teng, chua kona mikhatou alhah-a na-in chu thisan sona-in ahilouna dinga, na-in chungdal nasem ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nalengpi leija muchi dang chomchom natulou ding ahi; achuti loule namuchi tu ga chun nalengpi theiga chu asuboh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bongchal le sangan mang kopma lou nakai louding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangin samul le tupat kihal tobang, pat jatchom chom kihal ponsil nasil louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman nakivon ponsil mongchep munlia chun ponjem semin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mikhatnin ji aneija, amanu henga alutna, avetda-a,
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanu chunga nolna thusei phat akipeh-a, amanu asuh minsetna, Hichenu hi kakipuijin, ahenga kahung phatnin nungah ahipoi ti kamu doh-e atia ahile;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuteng nungahnu nule pa chun chuche khopi-a kotpi phunga upaho henga chu nungah theng ahina melchihna amusah lhonding;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nungahnu pa chun upaho jah-a chu, Hichepa hi aji dinga kachanu kanapen ahile, amapan ahotbol tan;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule veuvin, amapan amanu chunga nolna thu aseijin, Nachanu anungah hina kahepoi ati; ahinla hichehohi kachanu nungah theng ahina melchihna ahi, atiding ahi. Chule khopi upaho angsunga chu ponchu aphajal lhonding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule chuche khopi upa hochun mipa chu amatnuva asehgimdiu;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amahon amapa chu dangka shekel jakhatna agapmuva, hichu nungahnu pa apeh diu ahi; ajehchu aman Israel nungah theng khat aminset sah ahi: chule amanu chu amapa ji hikit ding; aman amanu ahinlaisea ada louhel ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla hichu adih ahia, nungahnu dinga chu nungah theng ahina melchihna akimulouva ahile,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutengle nungahnu chu apa inkot phunga akaidoh uva, khopi pasal hon amanu chu athina dinga songa ase ding ahi; ajehchu amanun apa insung jonthanhoi apatna, Israel sunga ngolhoi thil abol ahi: chutia chu nalah uva kona thil gilou chu nasuhmang dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Numei aji um luppi pasal akimule, anilhona numei luppi pasal le numei chu thikop ding ahi. Chutia chu Israel lah-a kona thil gilou chu nasuhmang diu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pasal khat dinga jiholsa nungah theng chu mikhatnin khopi sunga amua, amanu aluppia ahile,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuche khopi kotpi polama anilhona nahin kaidoh uva, athilhonna dinga songa nase dingu ahi; numeinu chu khosunga umngala apen loujeh, chule pasalpa chu aman aheng akom ji asetpi jeh ahi. Chutia chu nalah uva kona thil gilou chu na suhmang diu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahin mikhatnin loujaova mijihol amua, mipa chun acham louva abola, aluppi le; amanu luppi mipa bouchu thiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amavang nungahnu chu imacha nalo louding ahi; nungahnu chunga chu thina theilom chonset umlou ahi: ajehchu hiche thudol hi mikhatnin aheng akom adouva atha tobang ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu aman amanu loujaova amu ahin, mijihol nungah chu apengin, ahuhhing ding koimacha aumpoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Min nungah theng mijihol hilou amua, amanu amatna, aluppia, chule amani chu akimudoh-a ahile,
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutengle aluppi mipa chun nungahnu pa chu dangka shekel somnga apeh-a, amanu chu aji hiding ahi; ajehchu aman amanu asuhboh ahitan, ahinlai sungse-a amanu adathei louding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Min apaji akichenpi louding, apa deljong ahodohpeh louding ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi atilchang keh, ahiloule ajang ki-at tan chu Pakai houkhom na-a lutlou ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai houkhom ho lah-a jaocha kiti lutlou ding; ama khangsom changei jenga jong Pakai houkhom holah-a lutlou ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ammon mi ahiloule Moab mi chu Pakai houkhom na-a lutlou ding; khangsom geija jong Pakai houkhom na-a a-imatih channa lutloudiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Egypt gama kona nahung doh-un lamdunga chun changlhah le twisih jengchan jong nana lamdot pouvin; chule Mesopotamia gam, Pethor kho-a Beor chapa Balaam chu nangma douna-a nagaosap dinga athalah jeh-u ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeng jongle Pakai na Pathen'in Balaam thu angaipon; ahinla Pakai na Pathen'in nalungset jeh-in, Pakai na Pathen'in gaosapna chu nangma dingin phattheiboh na-in aheidohtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nahinlaisea a-itih-a amaho dinga chamna le aphattheina dingu nahol louhel ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman Edom michu nathet louding ahi; ajehchu ama nasopipa ahi. Nangman Egypt michu nathet louding ahi; ajehchu agamsung uva kholjin mi nanahi ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho chate chu akhang thum channa teng Pakai houkhom ho lah-a lutdiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Namelmate doudinga janel akon tengle, thil gilou tin chenga konin kitimin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nalah uva mikhattou janlaija thenlounan aphah jeh-a aboh-a aumle, amachu janna gebuh-a kona potdoh-a, gebuh sunga hunglut louding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amavang hitiding ahi, nilhah lam ahunghi tengle twija kisila; nisa alhum tengle gebuh sunga hunglut kitding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangin gebuh pamlama jong eh thahna munkhat nanei ding, chua chu nacheji ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule namanchah lah-a chu lei lona khat naneiding; chule hitiding ahi, nangma pamlama naposo tengle hichea chu lei nalaija, nakiheija nanga kona hungpotdoh chu navuh khum ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Pakai na Pathen chu nahuhdoh ding le namelmate pedoh dinga nagebuh lah-a vahle jia ahi; hijeh-a chu nachunga aboh ima amu louva, nanga kona akiheimang louna dinga, nagebuh chu atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Soh apu-a kona kiteldoh nahenga hunga chu apu henga napehdoh kit louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nakotpi hou sunga akilhen ding adeinapen na mun'a chu nalah uva nangma toh chengding ahin; ama nasuh genthei louhel ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israel chanute lah-a noti, ahiloule Israel chapate lah-a Sodom mi umthei louhel ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Noti man le uicha man chu Pakai na Pathen in'a kitepna khattouva dinga nahin poh louding ahi. Ajehchu hiteni chu Pakai na Pathen dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nasopi henga apung dinga thilpa napeh louding; sum pung ahin, neh le chah-a apung ahin, chule ipi hijongle apung dinga kipe thil himhim napeh louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Namdang henga vang apung dingin thil napeh thei ahi; amavang nasopi henga apung dinga thil apa-a napeh louding ahi. Hitia chu nagoulo ding gama nakhut lhahna pou pouva Pakai na Pathen'in phatthei naboh theina ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangman Pakai na Pathen henga kitepna-a nakitep teng, pe dinga nangongkai louding ahi; ajehchu Pakai na Pathen'in thonlouva nahenga angeh ding ahin; hichu nadinga chonset hiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla kitepna lama nakikangse-a ahile, hichu nanga dinga chonset hilouding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nakama nakihahsel sa lungcham thilto ngei chu, Pakai na Pathen henga nakitep dungjuija, nakama kona potdoh sachu nanitna nabol ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naheng nakom lengpi leija nahung tengle, lengpiga chu nagot channa navasetna nanehthei ahin; amavang nabella nakoi louding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Naheng nakom changkung ding lah-a nahung tengle, changvui chu nakhutna nakisi thei ahin; amavang naheng nakom chang dinglai chu koite-a na-at theilou ding ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pasal khatnin ji akipuija akichenpia, amanu chunga thenlouna amujeh-a amitmua lunglhaina achan joulou tah-a ahile; amapan kidana lekha asutna, amanu khutna apeh-a, a-in'a kona asoldoh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amanu a-in'a kona apotdoh teng, che-a pasal chomkhat ji hithei ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule a-inneipu nunung joh chun ahotna, kidana lekha asutna, akhutna apeh-a, a-in'a kona asoldoh ham; ahiloule ajidinga amanu akipuija a-inneipu nunung chu athia ahile;
  </para>
  <para style="p">
    <verse number="4" style="v" />Amanu ana soldoh-a a-inneipu masa chun, amanu kisuhboh nunga chu jidinga akipuikit thei lou ding ahi; ajehchu hichu Pakai anga dinga thet umtah ahi. Chule Pakai na Pathen'in lodinga napeh gamsunga chonset nalutsah louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pasal khatnin ji anei tille galsatna konlouding, natoh khatpou pouva tong dinga jong goi hilouding ahi. Amavang in'a ongthol tah-a kumkhat uma, ajinu alunglhaisah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Koimachan sumhei song anoinung ahiloule achungnung thil mana kitungchu alah louhel ding ahi; ajehchu aman mihem hinkho chu thil mana alah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi khattouvin Israel chate asopiho aguh-a, akiveina anei ham, ahiloule ajoh ham akimudoh-a ahile; chuche gucha chu thiding ahin; chule thilse chu nalah uva kona nasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Phah hise thudolla Levi thempuho jousen nahil dingu dungjuija pontho tah-a nitna dingin chingtheijun; keiman amaho kathupeh banga nangman boldinga nanit ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Egypt gama kona nanahung doh jou uva, lampi-a Pakai na Pathen'un Miriam abolna chu geldoh-un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nasopi thil khattou apa-a napeh tengle, athil tun ladinga a-in sunga nalut louding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangma inpoa nadinding, apa-a napeh mipa chun athiltun chu nahenga ahinchoidoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amapa chu mivaicha ahile, athiltun chu najan gepi louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutia chu apon noija nomtah-a alupma, phatthei naboh theina dinga, nisa alhum tengle athiltun chu iti nama jongle ama napehkit ding ahi. Hichu Pakai na Pathen angsunga nachon phatna hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman soh kithalah avaicha le alhasam chu nasopi hihen lang, ahiloule nagam sunga nakotpi sunga um namaljin ho hijeng jongle, nasuh genthei louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Atoh ni-a chu alo napehding, nisan alhumkhum louding ahi; ajehchu genthei ahin, hichea chu alung angah ahi; achuti loule nangma dounan Pakai henga peng tale, hichu nang dinga chonset hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chate jala pate kithat louding, pate jala chate kithat louding ahi. Amitakip chu ama ama chonset jeh-a kithat ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman kholjin mi le paneiloute thu dihlouva natan louding, meithai ponsil jong thiltun mana nalah louhel ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla nangma Egypt gama sohchanga nana um ahin, Pakai na Pathen'in chua kona nalhatdoh ahi chu nageldoh ding ahi. Hijeh-a chu hichehi naboldinga kathupeh nahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangman nalouva chang na-atna, loulaija changphal nahaimil tengle, gala dinga nachekit louding ahi: hichu kholjin miho, paneilou ho, meithai ho-a ding ahi. Chutile Pakai na Pathen'in nakhut natoh jouse phatthei abohding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangman na Olive thing navoh tengle, abahho chu naveiboh louding ahi: hichu kholjin mite, paneiloute chule meithai ho ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangman na lengpi leija aga nalokhom teng, akhai nahol louding ahi: hichu gamdang mite, paneiloute chule meithai ho ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nangma Egypt gama sohchang nana hichu nageldoh ding ahi. Hijeh-a chu hiche boldinga hi kathupeh nahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pasal ho kahlah-a kinahna auma, thutan ho henga athu-u tansah dinga ahung tengule; amahon michonpha ho chu them achanuva, migilou chu themmo achan dingu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hitiding ahi, migilou chu vohdinga lom ahile, thutanpa chun alupsah-a, ama angsung laitah-a ijatvei ham athemona dungjuija vohding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman somlivei avohding; avala avoh thei louding ahi; avalin vohen, hicheng kalval chun tamtah vei votaleh, nasopipa chu namit mu-a kijumso behseh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bongchal chang chilpet amuh nakan louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sopiho achenkhomuva, alah uva khat athia, cha aneilouva ahile, athipa jinu chu pama midangtoh kichenglou ding ahi. A-inneipu sopipan avetna, akichenpi ding, amanu chunga chu asopipa tohding kin chu atohding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hitiding ahi, amanun cha ahin masah pen chun Israelte lah-a amin manlouna dinga asopi thisapa munchu aloding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule mipa chun asopipa jichu akichenpi nomloule, asopipa jinu chu kotpi phunga upaho henga chea, ka-inneipu asopipa Israelte lah-a asopipa min tundoh ding anomhih-in, ka-inneipu sopipa kin abol nompoi agati ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutengle khopi upahon amapa akou uva, akihoulimpi diu, chule ama ada teiteija, kakichenpi nompoi ati-a ahile,
  </para>
  <para style="p">
    <verse number="9" style="v" />Asopipa jinu chu upaho angsunga amapa henga hungding, amapa kenga kona kengkoh chu asutna, amaija chil asetkhuma, Asopipa insung atungdoh nomloupa chu hitia hi bolding ahi, tia adonbutna aseiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amapa minchu Israel lah-a, Akengkoh kisutpehpa insungmi kisah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pasal ho kahlah-a kina auma, khatjopa jinu chun a-inneipu chu avopa khutna kona huhdoh dinga ahung naija, amanun akhut alhandoh-a, amapa chu ajanga amatna ahile,
  </para>
  <para style="p">
    <verse number="12" style="v" />Amanu khut chu natanboh peh-a, amanu chu nakhoto louhel ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nadipma khaikot jatni, agihle ajang naneilou ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na-insung jong thil tena jatni, alen le aneo naneilou ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla Pakai na Pathen'in napehna gamsunga nahinkho asotna dinga agih tena le asao tena chamkimle dihtah naneiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu chutobanga bol ho jouse le chonphat louna thil boljouse chu Pakai na Pathen dinga thet umtah ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Egypt'a kona nahungdoh laijuva lamdunga Amalek ten nabolnao,
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathen jong ginglouva, nalhahsam le nachol laitah-a iti nakimaito pia, nanunga hung achatmo jouse, anu nungpen geija iti atha gam ham chu geldoh-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh-a chu hitiding ahi, Pakai na Pathen'in gouloa nanei dinga napehna gama chu, Pakai na Pathen'in nakimvela namelmate jouse-a kona nacholdosah tengle, vannoi'a kona Amalek kihetna chu nanoimang ding ahi. Hichehi nasuhmil louding ahi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule hitiding ahi, Pakai na Pathen'in goulo dinga napehna gam chu nahung lhuna, nalo-a, nachenlut tengle,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai na Pathen'in napehna gama kona leiset ga jouse lah-a kona amasapen chu pocha sunga nakoija, Pakai na Pathen'in amin umsahna dinga adeilhen mun'a chu nahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule chuche nikho-a thempu hidingpa henga chu nache-a, ajah-a, Eipeh dinguva ipu ipateu henga Pakaiyin anahahsel leimuna chun kahung lhuntai tia tunia hi Pakai na Pathen henga kaphondoh ahi, tia nagasei ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuteng thempu chun nakhutna kona pocha chu alah-a, Pakai na Pathen maicham masang tah-a chu aluiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pakai na Pathen anga chu thu naseija, hitia hi nasei ding ahi, Mangthah dinga gotsa Syria mipa chu kapa ahin, Egypt ma anachesuh-in, milhomcha toh anapem lutnin, chuin chua chun nam lentah, thaneitah, chuleh tamtah ahung hidoh-in;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Egypt miten eina bolseuvin, eibol gimun, sohna hahsatah kachunga akoijun;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakai kapu kapateu Pathen henga chun kakapmun ahile, Pakaiyin kakounao aw ajan, kathohnatna houle kathoh gimnao, eikisuh genthei naochu aven;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Egypt'a konin khut thahat tahle ban lhang doh-in, tijat nasatah hole melchihna ho, chule thil kidangho pumin eihin puidoh taovin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche mun'a hin eina puilutnun, hiche gam khoijule bongnoi lonna gam ngeihi eipe taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule tun, vetan, vo Pakai, nangman neipeh leiset ga masapen chu kahinchoi tai, nati ding ahi. Chule hichu nangin Pakai na Pathen masanga natuna, Pakai na Pathen chu nahou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pakai na Pathen'in nangma le na-insungmi napeh thilpha takip chunga chu, nangma le nalah uva um Levi te, chule kholjin miho nakipa cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hopsom peh kum, nalhosoh hopsom jouse napeh jou kum thumna, Levi ho, namdang miho paneilouho, meithaiho chun nakotpi hongsunga aneh uva, avatheina diuva napeh joutengle,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuiteng nangman Pakai na Pathen henga, Ka-in'a konin thil thengho kahinpodoh-in, chujongle Levi ho, kholjin miho, paneilou ho, meithai ho jong nangman neipeh thupeh dungjuijin kanapen, nathupeh ho jouse kasukhel pon, sujong kasumil pon:
  </para>
  <para style="p">
    <verse number="14" style="v" />Hia konchun kalunghem petnin kana nepon, hia konchun thil aboh tapouva mandingin jong kana lamangpon, chule hia konchun mithi ho dingin jong kana pepoi: amavang Pakai ka Pathen aw joh chu lunglutnin kana ngaijin, chule nangman neina thupeh jouse dungjuijin kaboltan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nachenna theng, van'a konin hin vesuh-in lang, nami Israelte le kapu kapateu henga khoiju le bongnoi lonna gam pehdia nanahahsella neina peh-u gamhi phatthei hinboh-in, natiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tunikho-a hi Pakai na Pathen'in hiche chon dan kisunho le thutan ho nabol dinga nathupeh ahi. Hijeh-a chu nangin hicheho chu nalung pumpile nahinna pumpi-a nanitna, najui ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tunia hi nangin Pakai chu na Pathen hidinga, alampiho-a chedinga, adan kisunho, athupeh hole, athutan naho nitna dingle, athu ngaidinga naphondoh ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule tunikho-a hi Pakaiyin nana thutepsa banga ama mite chombeh hidingle, athupeh jouse nitding,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule vahchoina, minthana le, jabolna-a asemsa nam jouse chungvuma choi-at dingle, aman aseisa banga Pakai na Pathen henga vaipi theng khat hidinga naphondoh ahitai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi'n Israel upaho toh mipi chu thu apen, Tunia nangho kapeh thupeh jouse hi nit uvin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Pakai na Pathen'in napeh gam Jordan gal nakai nitengleh hitiding ahi, song lentah ho naphu-a, hiho chu songlou nanu ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule napu napateu Pakai Pathen'in nathutep jouse banga, Pakai na Pathen'in napeh-u bongnoi le khoiju lonna gamchu nalut theina dinga, nagalkai tengle achung ho-a chu hiche danthu thucheng jouse hi nasut dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh-a chu Jordan nagalkai joutengle hitiding ahi, tunia kathupeh hiche song hohi Ebal molsanga naphu-a, songlouva naloijol ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule chua chu Pakai na Pathen henga maicham, song maicham khat nasem ding; achunga chu thih manchah imacha nalap louhel ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai na Pathen maicham chu khetlou songho-a kona nasem ding ahi. Hiche chunga chu Pakai na Pathen henga govam thilto nato ding;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule chamna thilto nato-a, chua chu naneh ding, chule Pakai na Pathen anga nakipa ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule songho chunga chu hiche danthu jouse hi kichehtah-a nasut ding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi le Levi thempuhon Israel jouse lah-a aseijun, Vo Israel, chingthei jinlang ngaiphan; tunia hi Pakai na Pathen mite nahung hi ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh-a chu Pakai na Pathen aw nangai ding, tunia nangma kathupeh thupeh ho le adan kisunho hi nabolding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin hiche nikho mama chun Mosi in mipi thu apen, hitin aseije,
  </para>
  <para style="p">
    <verse number="12" style="v" />Jordan nagalkai tengule mipi ho phatthei bohdinga hiteho Simeon, Levi, Judah, Issachar, Joseph, chule Benjamin hi Gerizim molsang chunga dingden dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiteho Reuben, Gad, Asher, Zebulun, Dan, chule Naphtali hi agaosap dinga Ebel molsang chunga ding dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Levi hon thu aseijuva, Israel mite jouse henga aw sangtah-a asapmuva,
  </para>
  <para style="p">
    <verse number="15" style="v" />Khutthemho khutna kisem, Pakai dinga thet umtah alim semthu ahiloule lhahtho ham anakoigu aumle gaosap changin umhen, atidiu; chule mipi jousen, Amen, atiuva adonbut dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anu ahiloule apa jabol louva chu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aheng akom gamgi chondohpa chu sapset changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mitcho lampia kona vaveisah-a chu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kholjin mi, paneilou, chule meithai thutana akaleh-a heidoh chanchu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Apa ji luppi-a chu gaosap changhen, ajehchu aman apa del ahopeh ahi, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gancha poupou jonpia chu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Asopinu, apa chanu, ahiloule anu chanu luppi-a chu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A-inneipi nu luppi-a chu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aheng akom guhthima philla chu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Monabei mi thana dinga thilpeh la-a chu gaosap changhen, atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche danthu jouse boldinga sudet loupa chu gaosap changhen atidiu; chule mipi ho jousen Amen, atidiu ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule hung hitiding ahi, tunia nangma kathupeh jouse nitna dingle juina dinga Pakai na Pathen aw chu gen ngaitah-a nangaija ahile, Pakai na Pathen'in leiset chunga nam jouse vuma nachoisang ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai na Pathen aw nangaija ahile hiche phattheina jouse hi nachunga hung chua, nachuphel ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangma khopi sunga phatthei nachan ding; nangma loujaova phatthei nachan ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nachilhah, naleiset ga, nagancha hon, nabongpi hon, chule nakelngoi hon ho phatthei changdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na palbom le nathil kholna jong phatthei changding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nahung vailhun teng phatthei nachan ding, navaikon doh teng jong le phatthei nachan ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangma doudinga hungkon namelmate chu Pakaiyin namai koh-a athagam ding: nangma dou dinga lampi khatna hungdoh uva, namai koh-a lampi sagi-a jamcheh diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai chun nathil kholna in le nakhut natoh jouse chunga phattheina chu thu apeh ding; Pakai na Pathen'in napeh gamsunga chu aman phatthei nabohding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman Pakai na Pathen thupeh ho nanitna, alampiho-a nache-a ahile, aman nahahsel na banga Pakaiyin ama ding tuma namtheng khatna natundoh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule leiset mite jousen Pakai mina nakikou chu amuva, nangma nakichat dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pakaiyin napu napate henga nangma pehdinga anahahselna gama chu, Pakaiyin thil le lo, nachilhah, nagancha, naleiset ga-a nanen jengjung sah ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakaiyin nangma dinga nagamsunga aphatcha gotwi peding le, nakhutna nanatoh jouse phattheiboh dinga, agou kholna phatah vanchu nahonpeh ding; nangman nam tamtah henga thil apan homin natin, nangin thil apa-a nalah louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tunia kathupeh Pakai na Pathen thupeh hohi nitding le juidinga nangaija ahile, Pakaiyin amei hilouva alua nakoija, chule anoinung hilouva achunga bou nakoiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule tunia kathupeh thuho-a kona pathen dangho jenna dinga anungu juina-a jetlam ahiloule veilama nakihei louhel ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amavang hung hitiding ahi, tunia kathupeh athupeh jouse le, achonna dan kisunho jouse juidinga Pakai na Pathen aw chu nangailouva ahile; hiche gaosapna jouse hi nachunga hungchua, nachup helding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khopi sunga gaosapna nachan ding, chule loujaova jong gaosapna nachan ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na palbom le nathil kholna jong gaosap changding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nachilhah, naleiset ga, nabongpi hon, nakelngoi honho jong gaosap changding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nahung vailhun tengle sapset nachana, navai kondohteng jongle sapset nachan ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nathilbol gitlouna-a kona neidalhah jeh-a nangma nakisuh manga namanthah hel loi kahse-a Pakaiyin na natohna chunga, nakhut lhahna jouse-a, gaosapna, suhnohna, housetna jouse ahinchuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Galo dinga nachena gama kona aman nasuhmang hel kahse-a, Pakaiyin nachunga natset alenden sah ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakaiyin hihet, khosih, tipom chetchut, tisat val, chemjam, huise, chule motna-a najepma, namanthah hel kahse-a hicheng hin najuiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Naluvuma um van chu sum-eng soh-a, nanoija leiset chu thih hungsoh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakaiyin nagama gotwi chu leivui le vutvai aso-a, namanthah hel kahse-a nachunga van'a kona hung julha ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Namelmate masanga Pakaiyin gal nalelsah ding; amaho sat dinga lampi khatna nakon doh-a, amasanguva lampi sagi-a najam ding ahi. Chule leiset lenggam jouse-a nakichonle ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule nalong chu chungleng vacha jouse le leiset gamsa dinga anneh hiding, chule koimachan anomang loudiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pakaiyin Egypt gam uilutna, thilona, tinakhih neija, tithah na-a najep natna, chuho-a kona chu nadamdoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pakaiyin ngolna-a, mitchot na-a, lungkidanna-a najepding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Muthim noija mitcho akimai banga sunchang noija nakimai ding, nalampi-a nalolhin louding: a-itih-a bolgenthei le chom mangbou nahi-a, koimachan nahuhhing louding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangin jihol neijin natin, midangin amanu aluppi ding: nangin in kisah-in natin, nangla chua nachen louding: nangin lengpilei kibolin natin, chua kona lengpiga nalo louding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Namitmu na-angsung laitah-a nabongchal kithat ding, hichu nanehlou ding: namaikoh tah-a kona nasangan pumhatna kikai mang ding, nakilepeh louding: nakelngoi chu namelmate kipe ding, ahuhdoh ding koimacha naneilou ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nachapate le nachanute midangho kipe ding, namitna navetna, nilhumkeija amaho lhangai na-a natha beiding: nakhutna hatna himhim umlou ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Naleiset ga le natoh gim ga jouse chu nahet khahlou nam khatnin anehchai ding; nangma suhgenthei le noigep vou nahiding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chutia chu namitnin avet nathilmu ho jala chu nangolding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pakaiyin suhdam theilou uilut khohtah-a nakhup teni le kengteni, nakengto-a pat nalujang gei anatsah ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pakaiyin nangma le nachunga atunding nalengpa chu nangma le napu napateu jong anahet khahlou beh namkhat henga napuilut dingu ahin; chuachu thih le song pathen dangho bou nagajen dingu ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule Pakaiyin napuina ding namtin lah-a chu nangma datmo umtah, paochamtuh, chule seichah bep nahungso ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nangman muchi tamtah loujaova napohlut ding, amavang themcha bou nalokhum ding ahi; ajehchu khaokhopin anehchai ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nangman lengpilei nabola, nalho ngim ding, amavang alengpitwi chu nadonlou ding, chule lengpiga jong nalo khom louding ahi; ajehchu lungin anehdiu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nangman nagamsung jouse-a Olive thing nanei ding, amavang athao chu nakinu louding ahi; ajehchu na Olive chu aga pulgam ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nangman chapate le chanute hingin tin, ahinla nanopsahna hilouding ahi; ajehchu gal hinga chegamdiu ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nagamsunga thingphung jousele aga jouse chu khaokhon anehgamhel ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nalah-a um namdang mi chu nang vuma hatah-a hung kichoisang ding; nangma hatah-a nanemsuh ding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Aman nangma apa-a napeh ding, nangman vang ama apa-a napeh louding: ama aluchangin pangintin, nangma ameija nahung panding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chukal vala jong Aman nathupeh athupeh ho le adan kisunho nitna dinga Pakai na Pathen aw nangailou jeh-a, namanthah hel kahse-a hiche gaosap nahohi nachunga hungchua, nanung ajuija, nachup mangding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule hicheho chu nangma le nachilhahte chunga a-itih-a dinga melchihna le thil kidanga umding ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Thiljouse anen jeh-a Pakai na Pathen chu lungsung thanom tah le kipah tah-a najenlou jeh-a;
  </para>
  <para style="p">
    <verse number="48" style="v" />Hijeh-a chu Pakaiyin nangma doudinga ahinsol ding namelmate chu gilkel le dangchah-a, sagohkeu le ijakai lhasama najending: aman nangma nasuhmang hel kahse-a nangonga thih namkoljon napohsah ding ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Pakaiyin nangma doudinga gamlatah-a kon,leiset kolmanga kon namkhat, mulaopi banga gangjet; apaovu jong nahetlouhel nam khat ahinpui ding ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Kichat umtah melpu, tehse ja-ngaina neilouhel, chapang jong lungset chomlou nam;
  </para>
  <para style="p">
    <verse number="51" style="v" />Chule amachun namanhel kahse-a nagancha hon le nagamga aneh ding: aman nasuhmang hel kahse-a chang, lengpithei, thao, nabongnou, ahiloule nakelngoi hon ho-a kona apungdoh hojong nakhenpeh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Natahsan nangapna nagamsung pumpi-a kulpi kikai khum sangtah ho chu achimlhahsoh kahse-a, aman nakotpi jouse-a na-umkul ding: Pakai na Pathen'in napeh gamsung pumpi nakul kotpiho jouse na-umkul khumdiu ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Namelmate bol hesohna-a naki-um kul le nakineh chintona-a chu, Pakai na Pathen'in napeh nangmatah chilhah, nachapate le nachanute sa chu nanehding:
  </para>
  <para style="p">
    <verse number="54" style="v" />Chutia chu nalah-a um lungnem le hongphal pa jongchun asopipa le a-angkoi ajinu, chule achate lah-a, ahinghoi ding amohpen jeng jong chu amuset ding:
  </para>
  <para style="p">
    <verse number="55" style="v" />Chutia chu amaho khatcha jong anehding achate sa chu apehlou ding ahi: ajehchu nakotpi phung jouse-a namelma ten umkulna le nehchep na-a nasuhgenthei ding jeh-a imacha akikhenlou ahitai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nalah uva um numei lungnemle lungneng pen, alung nemle alungnet behseh jeh-a akengkho taljum jong tolla chuhsah nomlou numei jong chun a-angkoi ajipa le achapa chule achanu chu amuset ding,
  </para>
  <para style="p">
    <verse number="57" style="v" />Chule akengteni kah-a hung pengdoh-a chasen le ahin hinding achate jong, amuset ding ahi: ajehchu umkulna le gotchep na-a namelma ten nakotpi phung jouseuva nasuh genthei jeh uva, ijakai lhahsap jeh-a amanun amaho chu guhthima anehgam ding ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />PAKAI NA PATHEN kiti min loupitah le tijat umtah hi nagin theina dinga hiche lekhabu sunga kisun danthuho jouse chingthei tah-a najui louva ahile;
  </para>
  <para style="p">
    <verse number="59" style="v" />Pakaiyin nangma hise le nachilhahte hise chu hise kidangtah, hise nasatah, sottah umding hise, natna khohtahden, sottah umjom jingding asosah ding ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Chukalvala jong nangman nagin Egypt gama hise jouse chu, nachung uva alensah ding; hicheho chun nakolchah ding ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chule hiche danthu lekhabu sunga kisun lou natna tincheng le hise tincheng ho jong chu Pakaiyin namanthah hel kahse-a nachunga ahinlhut ding ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chule natam jeh-un van'a ahsi jat ana hijongleu chun, lhomcha bou kikhen ding nahiuve; ajehchu Pakai na Pathen aw nangaipon ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chule hung hitiding ahi, naphatna bolding le nangma suhpung ding chu Pakai kipana ahi banga; chutia chu nangma suhmang dingle manlou soding chu Pakai kipah hiding ahitai; chule galo dinga nachena gama kona chu nakibotdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Chule Pakaiyin mijouse lah, leiset kolmong langkhatna pat langkhat geija nathe cheh uva; chua chu nangma nahi-a napu napate ahiuva jong anahet ngailou thing le song pathen ngeichu najending ahi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chule hiche namho lah-a chu choldona namu louding, nakengto jengin jong olna amulou ding: Pakaiyin lungsung linglaona, mit setna, chule lungkhamna napeh johding ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chule namalam hinkho chu lung opkaina hiding, sunle jana nakichat na, nahinkho dinga dettah-a ngamna nanei louding ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Kichatna nalunga nagel ding jeh le namitna namu ding thilmujeh-a, jingkah teng, Pathen'in nilhah hisah taveleh! nati-a, nilhah teng, Pathen'in jingkah hisah taveleh! natiding ahi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Chule hichehi namukit louding ahitai tia kaseina lampia chu Pakaiyin Egypt gama kong inneija nale puilut kitding: chua chu namelma te henga sohpa le sohnu-a vuldinga nakijoh diu ahin, koimachan nakichoh loudiu ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichehohi Horeb'a amahotoh kitepna asem tilouva, Moab gama Israel chate toh neidinga Pakaiyin Mosi athupeh kitepna thuchengho chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Mosi'n Israelte jouse akouvin, ajah uva, Nanghon Egypt gama Pharaoh chung, asohte jouse chung, chule agampumpi chunga Pakai thilbol jouse chu namitmu tah uva namu taovin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Patepna nasatah ho, melchihna ho, chule thilkidang nasatah ho chu namit uva namutaovin:
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahijeng vangin Pakaiyin hetchetna lungthim, muchetna mit, chule jahchetna nakhang tunigeijin napehih laijuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman gamthipma kum somli kana lamkaijun: nachung uva naponsilu achulpon, nakenguva nakengkoh-u jong aluipon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima hi Pakai na Pathen'u kahi nahet theina diuvin, nanghon changlhah nane pouvin, lengpitwi le khamna thei jong nanadon pouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin hiche mun'a nahunglhun phatnun, Heshbon lengpa Shihon le Bashan lengpa Og chu eiho satdin ahung kondoh lhonin, eihon ina joutaove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule agamhou ilaovin, Reuben mite, Gad mite, chule Manasseh phung kehkhat goulodin ipetaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun nabol jouseuva nakhantou theina diuvin, hiche kitepna thuho hi nitnun lang juijun.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tunin nabonchaovin, naphung lamkai hou, na-upahou, napipu hou, chule Israel mite jouse toh Pakai na Pathen'u anga nading sohkeijun,
  </para>
  <para style="p">
    <verse number="11" style="v" />Nacha senteu, na-inneipi teu, napon in sunguva um nakhopem hou, na thing tuh houva pat twikhai ho geijin:
  </para>
  <para style="p">
    <verse number="12" style="v" />Tunia Pakai na Pathen'un nangho toh asem, Pakai na Pathen to akitepna le akihahselna sunga nalut theina dingun;
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman nahenga aseibanga le, napu napateu Abraham, Isaac, Jacob henga anakihahsel banga, Tunikho-a hi aman nangho ama mite hidinga natundoh theina dingu le, ama nangho Pathen ahitheina ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche kitepnale kihahselna hi nangma changseh toh kasem ahipon,
  </para>
  <para style="p">
    <verse number="15" style="v" />Tunia Pakai i-Pathen'u anga ilah uva hikoma umpa, chule tunia hikoma ilah uva umloupa to jong ahi:
  </para>
  <para style="p">
    <verse number="16" style="v" />(Ajehchu Egypt gama iti ina chen uva, chule ihin jotpao nampiho iti ihin palpao ham naheuvin,
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule alah uva um athet umtah hou, amilimhou, thing le song, dangka le sana hochu namuvin ahi.)
  </para>
  <para style="p">
    <verse number="18" style="v" />Ijemtia nalah uva pasal ham, numei ham, insungham, inkoham, phungham, Pakai i-Pathen'uva kona, hiche nam mite pathenho gajen dinga alunghei manga ummaithei ahin; achuti loule nalah uva thingkha le hampa kha jungnei hung umdoh getninte;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hung hiti ding ahi, hitobang michun hiche gaosapna thuho hi ajah tengle, Dangchah chu khamna-a akibelap bangin, kalung ngaito dandanin umjong leng chamna neinange, tin alungsunga ama le ama phatthei kiboh henlang hileh,
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakaiyin amachu akhen louhel ding, ahinla Pakai lungsatna le athang thipna chu amapa chunga chu meikhu-a kitungdoh-a, hiche lekhabua kisun gaosapna ho jousehi achunga chuding, chule Pakaiyin aminchu vannoi'a kona hi anoimang ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Pakaiyin amachu hiche dan lekhabu sunga kisun kitepna chunga gaosapna ho jouse dungjuija, Israel phung jouse-a kona hamsetna chang dinga akhendoh ding:
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutia chu nanunga hung pengdoh ding nachate khang hunglhung dingho le, gamlatah-a kona hung ding namdang mi hon Pakaiyin achunga achuhsah chuche gamna hise le natna ho chu amutengule;
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuche gam pumpi chu kath, chi, meikah, ima kitu lou, ima galou, asunga hampa jong kehlou, Pakaiyin alungsatna le alunghana asumangsa Sodom le Gomorrah, Admah le Zeboiim tobang ahi atidiu:
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule namtinho jouse jengin jong, Ipibola Pakaiyin hiche gamhi ahitibol hintem? hiche lunghanna nasatah hi ipi tina ahidem? atidiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutengle mihon, Egypt gama kona amaho ahinpuidoh laijuva amaho toh anasem, apu apateu Pakai Pathen kitepna chu adalhah jeh-u ahi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu Aman amaho henga apeh hilouho pathen dangho, ahetkhah louvu pathen ho henga acheuvin agajenun, ahou jeh uva;
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche lekhabu sunga kisun gaosapna jouse pohlut khum dinga Pakai lunghanna chu hiche gam chunga koujah-a ahitai;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Pakaiyin amaho chu lungsatna, lunghanna, chule lungphatmona nasatah, tunikho banga hi, agamma kona ajung aja-a abodoh-a mi gamdanga aselut ahitai, atidiu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thil kiselho chu Pakai i-Pathen uva ahin: ahin akiphongdoh saho chu hiche danthua thuho jouse hi ijuitheina diuva a-itih-a dinga eihole ichateuva ding ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule hung hitiding ahi, namasanga kakoi hiche phattheina le gaosapnaho jouse hi nachunga ahung lhuna, Pakai na Pathen'in nadel lutna namho jouse lah-a kona chu nahin geldoh-a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Pakai na Pathen henga nahung kile-a, nangma le nachaten nalung pumpiu le nahinna pumpiuva tunia nangma thu kapeh jouse dungjuija hi a-aw nangai uva ahile;
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai na Pathen'in gal hinga nakikaina chu aleheija, nachunga lainatna aneija, chule hung kileheija Pakai na Pathen'in nathe chehna namho jouse lah-a kona nachopkhom kitding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na mi khattou chu van mong geija ana kinodoh-a ahijongle, chua kona Pakai na Pathen'in nalonkhoma, chua kona nahin puidoh ding ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pakai Pathen'in napu napateu vin alonao gamsunga chu nahin puilutna, nangman hichu naloding; Aman nabol phatna, napu napateu chungvuma napunsah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Pakai na Pathen'in nahin theina ding, nalungthim pumpile nahinna pumpi-a Pakai na Pathen nangailutna dinga, nalungsung le nachilhahte lungsung chep atan ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Pakai na Pathen'in hiche gaosapna jousehi namelmate le nahotbol te, chule nabolsete chunga akoiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangma nahung kile-a Pakai aw chu nangaiding, tunia nangma kathupeh ama thupeh jouse hi nabolding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Pakai na Pathen'in nakhutna athilbol jouse, nachilhahte, nagancha ho, chule nagamga aphatna dinga hatah-a asuhpung ding ahi: ajehchu Pakai chu napu napateu chunga athanop banga, naphatna dinga nangma chunga thanom kitding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche dan lekhabu sunga kisun athupeh hole adan kisunho nitna dinga Pakai na Pathen thu nangaija; chule Pakai na Pathen henglama nalungthim pumpile nahinna pumpi-a nakihei ja ahile chuti ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu tunia nang kathupeh hiche thupeh hi nanga kona kisel ahipon, chule gamlapi-a umjong ahipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijah uva, ibol theina diuva, eiho dinga van'a koi gakal touva, eiho henga ahin pohlhah ding ham? natina diuva hichu van'a uma ahipoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ijah uva, ibol theina diuva, eiho dinga twikhanglen galla koi gachea, ihenguva ahinpoh galkai ding ham? natina diuva hichu twikhanglen galla um jong ahipoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla thuchu nanit theina dinga, nakom naicha, nakam sungle nalungsung um ahibouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ven, tuni hin namasanga hinna le thilpha, thina le thilse kakoipeh-e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai na Pathen chu nangailut nading, alampiho juina ding, athupeh hole achondan ho chule athutan ho nitna dinga tunia kathupeh hohi nanitna ahile nahina, napuntheina ding: chule lodinga nachenna gama chu Pakai na Pathen'in phatthei nabohding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amavang najahlouna dinga nalungthim akihei manga, puimanga naum joh-a, pathen dang nahouva, najena ahile,
  </para>
  <para style="p">
    <verse number="18" style="v" />Namanthah teidiu ahi tia tunia hi kaphondoh ahi; galo dinga Jordan nagalkaina gama chu nahinsot louheldiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Namasanguva hinna le thina, phattheina le gaosapna kakoije ti nangho douna-a ahetoh dinga tunia hi van le lei kakou ahi; hijeh chun nangma le nachilhahte nahinthei dingu hinna kilhenun:
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutia chu Pakai na Pathen nangailutna, a-aw nangaija, chule ama nakolchah theinadin: ajehchu ama nahinna ahin, nahinkho sotna ahi: chutia chu Pakaiyin napu napa te Abraham, Isaac chule Jacob peh dinga ahahselna gama chu nachen theiding ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi achen, Israel miho jouse henga chun hiche thuho hi aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ajah uva, Tuni hin keima kum jankhat le kum somni kalhingtan; kalut le kapot le joutapon ahi: chujongle Pakaiyin jong kajah-a, Nangma hiche Jordan hi nagalkai louding ahi, eiti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai na Pathen'u chu namasanguva lamkaijin tin, aman hiche namhohi namasanguva kona asumang ding, chule nanghon amaho gamchu nalo dingu ahi. Chule Pakaiyin ana seibanga, Joshua'in nalamkai dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Pakaiyin amaho chu Amor miho lengteni Sihon le Og abol banga abolding, chule aman asuhmang gamho banga abolding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman nangho thu kapeh-u thupeh ho jouse dungjuija ahenguva nabol theina dinguva, Pakaiyin amaho chu namaikoh uva napehdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hatnunlang hanguvin, kicha hih-un, amaho khu ging jong ging hih-un: ajehchu Pakai na Pathen'u, nangho nalhonpia chu ama ahi; Aman nalosam sah loudingu, dajong nadalhah louheldiu ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mosi'n Joshua akouvin, Israelte jouse mitmu-a chun ajah-a, hatninlang hangin; ajehchu nangma Pakaiyin apu apateu pehdinga anahahsel gama chu hiche mipite hitoh nalhona, nangman amahohi nalosah teiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule namasanga chea amachu Pakai ahi, aman aumpi ding, aman nalosamsah louding, dajong nadalhah louding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n hiche danhi asunin, Pakai kitepna thingkhong poleji Levi chapate thempuho le, Israel upaho jouse henga apen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Mosi'n amaho thu apen, ajah uva, Kum sagi kichaiseh, kilhadohna kum le lhambuh kut laile,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama deilhen nading mun'a Israel chate jouse Pakai na Pathen anga kilah dinga ahung tengule, hiche danthu hi Israelte jouse masanga ajahdiuva nasimpoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon ajah uva, ahetnuva, Pakai na Pathen'u chu aginuva, hiche danthu-a um thu jouse hi anitna dingun, mijouse, numei ahin, pasal ahin, chapang ahin, nakotpi sunga um gamdang mi ahin khomkhom soh keijin:
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule imacha heloulai nachateo chun lodinga nachenao Jordan gal gamsunga chu nachen laiseuva Pakai na Pathen ginje ahettheina diuva ajahdiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Mosi jah-a, Ven, nathi nading nikho ahung naitai; mopohna kapehthei nadin Joshua chu kouvin lang houkhom na pon in sunga hung kilah lhonin ati. Chuin Mosi le Joshua ache lhonin, houkhom ho ponbuh sunga agakilah lhontai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakai chu houbuh sunga meibang khomin ahungkilah-in: meibang khompi chu houbuh kotchung tah-a chun adingden tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin Mosi jah-a, Vetan, nangma napu napate toh nalupkhom ding ahitan; hiche mipihohi kipat uva, aga umnadingu mite lah-a gamdang mite pathenho nung ajuijuva noti'a gapangdiu, chule keima eidalhah uva, amahotoh kanabol kitepna chu apalkehdiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuteng hiche nikho chule achunguva kalungsatna deujah ding, amaho kadalhah-a, amaho-a kona kamai kasel ding, amaho bahgama umdiu, thilse tamtah le hesohnahon alhun khumdiu; chutia chu hiche nikho chule, I-Pathen'u ilah uva aumloujeh-a thilse hohi ichunguva hunglhung hilouham? atidiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathen dangho lama akihei nalam uva thilse jouse ahin boldiu ho jeh-a chu, hiche nikho chule kamai kaseltei ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun tun hiche la hi nangma dingin kisut in lang, Israel chate hilin; hiche la hi Israel chate chunga keima dinga hettohsahna dingin akam sunguva khumpeh-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu apu apateu kahahselna, bongnoi le khoiju lona gama amaho kapuilut teng, amahon aneh uva, vaset uva, chule hungthao diu; chutengle pathen dangho lama kiheijuva, hiho chu ajendiu, keima eilunghan sah uva, kathupeh apalkehdiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hung hitiding ahi, thilse tamtah le lungkhamna tamtah-in aphah tengule, achunguva hettohsah khat banga hiche la hin ahettohsah ding ahi; ajehchu achilhahteu kama kona hiche la hi suhmila umlou ding ahi: ajehchu tujeng jonghin kahahselna gama kapuilut masanga achele nadinguva alung ngaitohou chu kahen ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun Mosi'n hiche la hi hiche ni mama chun asunin, Israel chate chu ahiltai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Aman Nun chapa Joshua chu mopohna apen, ajah-a, Hatninlang hangin, ajeh chu nangman Israel chate chu amaho kahahselna gama chu napuilut ding ahi; keiman nangma ka umpi ding nahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ahitin ahi, Mosi'n hiche danthu hohi lekhabu khatna asutchaija, jo ahi phatnin,
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi'n Pakai kitepna thingkhong pu-a pang Levi ho chu thu apen, hitin aseije,
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche danthu lekhabu hi laovinlang, nachung uva hettohsah dingin Pakai na Pathen'u kitepna thingkhong koma chun koijun.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu nakiphin hat danule nalouchal danu kahei: veuvin, tunikho-a nang hotoh kahin khomlai petna bon Pakai douna-a nakiphin uva ahile; kathinung teng ijat nabolbe tadiuvem?
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche thuho hi anakhang uva kaseija, ahetoh dinga vanle lei kakou theina dingin, naphung houva upaho le nalamkai hou jouse kahenga hinkhomun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu kathi nungle nangho le nangho nasatah-a nakisuhset nuva, nangho kathupeh-u lampia kona nakihei mangdiu; chule ninunung lamle thilphalouvin nalhah khumdiu ahi; ajehchu nakhut soh-u thilbola kona suh lunghangna dinga Pakai mitmu-a thilphalou nabol dingu ahi ti kahei, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Mosi'n Israel houkhom ho jouse nakhanga chun hiche lacheng hi akichai kahsen asei pehtan ahi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo vanho, nana hinsungun, keiman thu seijinge; chule vo leiset, kakama thupot ho ngaijin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kathuhil hi gotwi bangin juntin, kathusei daitwi bangin chimintin, hamnel chunga gophin bangle, hampa chunga gohongju banginte.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pakai min kaphongdoh ahi: Nanghon Pathen loupina seichoi leuvin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama songpi ahin, anatoh ho achamkime; ajehchu alamlhah jouse thudih ahi: khansetna beihel le thutah Pathen, chondih le chonpha chu ama ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama hole amaho akisuboh-un, amonao chu achate mona ahipoi: amaho khanglamvai le lungput janglou khang ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo mingol le mitanangte, chutia chu Pakai nalethuh diuham? Ama nachodoh pao napao hilouham? Ama nasem paole natungdoh pao hilouham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Gollui lai geldoh inlang, khang tamtah-a kumho chu ngaito temin; napa dongle chun navetsah ding ahin, na upate dongle chun naseipeh taovinte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hatchung nungin namho agoulo diu ahoppeh lai, aman Adam chapate asekhen laichun, Israel chate ajatnu dungjuijin mipite gamgi chu anasepeh-e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Pakai chanvou chu amite ahin, Jacob hi agouchan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman amachu neldi gam, agohkeo gamthip ginghou hou lah-a amu ahi; Aman ahinpuidoh-a, ahila, ama mitchang banga avettup ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mulaopi in abuh aphetlhah-a, anou chunga akijapma, alha ajahkhuma, amat ji-a, alha chunga apoh banga;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutia chu Pakai bouvin ama apuile-a, gamdang pathen toh umkhom lou ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Louvin asepdoh ga aneh theina dingin leiset mun sangho chunga atousah-in; songpi-a konin khoiju achepdoh sah-in, meituh songa konin thaotwi aputdoh sah-in;
  </para>
  <para style="p">
    <verse number="14" style="v" />Bongnoiha le kelngoi noi, kelngoinou thaotah, chule Bashan kelngoi chalho, le kelho, suhlou chang phapen tah; chule lengpitwi thisan thengtah ju in nadonin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin Jeshurun athao behsettan, akeng apeh pehtai; nathaovin, nasalha jengin, thaovin natome; chuin asempa Pathen adalhan, alhatdamna songpi chu totnopnan aneitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amahon namchom pathenho jeh-in athangthip sah-un; thet umtah ho-a konin alunghan sah-un ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amahon Pathen kom hilouvin thilha ho, ahetkhah louvu pathenho, napu napateu vin anagin louva athah beh-a hungpot pathen thah ho henga ganlhai abolun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nahinga Songpi chu iman nagelpon, nahin semdoh-a Pathen chu nasumil tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakaiyin hichu amuphatnin, Achapate le achanuteu suhlunghan sahna jeh chun amaho chu akidahtai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman, amahoa kona kamai kaselding, akichainao ipi soh mongam kavet ding ahi: Ajehchu amaho khang lamvai mite ahiuvin, tahsanna umlou chate ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amahon Pathen hilouho-a eithangthip sah-un; apannabei houva eichou lunghangun; kenjong nam hilouho-a kona athangthip nadiuva kachouthou uva, nam ngoltah-a kona kachou lunghang dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu kalunghana-a mei akongdoh-in, thikholkhul geija akahlhah ding, hichun leiset le asunng keh jouse akah lhah-a, molsang bulho jouse meijin akahding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Achunguva setna kaset thopma, achunguva kathal chang ho kamanchah ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amaho gilkelin akah uva, meika nasatah le suhgamna nasatah-in aval lhum diu ahi: leivui lah-a kitol gulgu toh kilhona achunguva gamsaho ha hemtah kasolpeh ding ahi
  </para>
  <para style="p">
    <verse number="25" style="v" />Polama chemjamin, sunglama tijatna-in, gollhang le nungah theng, noicheplai le samkangsa jong asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aning ninga kathecheh-a, mihem lah-a kona hetjinga aumnao kichaina kabolding ahi, kati;
  </para>
  <para style="p">
    <verse number="27" style="v" />Akidoupi houvin agelkhel uva, Kakhutnu hi choisangin aumin, hiche ho jouse hi Pakaiyin abol ahipoi, tia aseiuva melma lunghanna chu kaginlou hile.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu amaho thumopbei nam ahiuvin, chule amaho-a hetkhena himhim aumpon ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />O, hichehi ahetkhen na dinguva ching hitaveleu, khonunga akichaina dingu angaito dingu hija!
  </para>
  <para style="p">
    <verse number="30" style="v" />A songpiuvin amaho akijohdoh-a, Pakaiyin amaho akhakhum ahilou ngale; mikhatnin sangkhat iti adela, minin sangsom iti adeljam ding ham?
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu amaho songpi chu eiho Songpi tobang ahipon, imelmateu amaho le amaho jengjong thutan ho ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu alengpi guiju chu Sodom lengpigui le Gomorrah loujaova kon ahi: alengpi ga houchu gilkha lengpiga ahin, aga bohho chu akhan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Alengpitwi houchu dragon gu le gulgu phaloutah ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hichehi kakoma kikhol hilou hija, kagou ho lah-a kikha khum hilou ham?
  </para>
  <para style="p">
    <verse number="35" style="v" />Phulahna le lethuhna chu keima-a ahin; aphat tahle akengto-u kithol ding ahi: ajehchu amanthah nao nikho anaitan, achunguva hunglhung ding thilho chu gangtah-a hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ajehchu athahatnao abeisoh-a, akikhu khumle akidalha abeihel tengule; Pakaiyin amite thu tan intin, asohte-a dinga alung aheiding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule aman hitia aseiding ahi, A-pathenhou, atahsanu angapnao asongpiu chu hoiba hitam?
  </para>
  <para style="p">
    <verse number="38" style="v" />Aganlhainao sathao ne-a, adon thilto lengpitwi donho chu? amaho chu hung thoudoh uhenlang nakithopiu hen, chule nahongbit nun pangu hen.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tun veuvin, kei, keimamong monghi Ama chu kahi, Keima toh pathen hikhom adang aumpoi: Keiman kathatjin, chule kahinsah jin; Keiman kamavojin, chule kadamsah kitjin ahi: kakhutna kona huhdoh jouding koimacha aumpoi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ajehchu Keiman van lama kakhut kadom sangin, tonsotna kahing jinge katin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kachemjam duljeju chu kanola, kakhutnin thutanna atuh-a ahile; kamelmate chunga phu kalah ding, eihot bolte kalethuh ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Akithatho le sohchangho thisan le, melmate lamkaiho luchanga kon, Ka thalchang ho thisan kadonkham sah-a, kachemjamin saphe avalhum ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Vo namtinho, hiche amitetoh hin kipah-un: ajehchu aman asohte thisan phu alah-a, akidoupi ho chunga phu alah ding, chule agam le amite chunga hepina anei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Mosi amatah chu Nun chapa Hoshea toh ahungin, hiche la thu jouse chu mipi ho nabenga aseijin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin Mosi'n hiche thuho jouse hi Israel pumpi jah-a asei aseichaijin,
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin amaho jah-a, Tunia nalah uva kaphondoh thu jouse-a hin nalungu koijun lang, hiche danthu jouse hi chingthei tah-a ajuidiuva nachateo nathupeh dingu ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hichehi nangho-a dinga mohthil ahipoi; ajehchu hiche hi nahinkhou ahi: chule hicheho jala hi lodinga Jordan nagalkai nao gama chu nahinkhou sotding ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin hiche nikho mama chun Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="49" style="v" />Jericho toh kigalsai, Moab gama um Abarim molsanga um Nebo molsanga khun kaltouvin lang; Israel chaten alo dinguva kapeh Canaan gamchu gaven:
  </para>
  <para style="p">
    <verse number="50" style="v" />Nasopipa Aaron Hor molsanga athia amitetoh akigop bangin, nakaltouna lama chun hungthiden ninlang namite toh kigomtan.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ajehchu Zin gamthip, Kadesh mun Meribah twiphunga Israel chate lah-a keima douna in nachonkhela; Israel chate lah-a neijabol loujeh ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hijeng jongle agam chu namasangtah-a nagamu ding, amavang Israel chate kapeh gamsunga vang chu nalut louding ahi, ati.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule hichehi Pathen mipa Mosi'n athi masanga Israel chate phatthei abohna, phattheina chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman, Sinai'a konin Pakai ahungin, Seir'a konin ahenguva dingin akipatdoh-e; aman Paran molsanga konin asalvah-in, mitheng sangsom to ahunge: akhutjet lama konin amahodin danthu khaotah apotne.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahi, aman mipi angailun, amithengte jouse nakhutna aumui: chule amaho nakengbulla atouvun, mitinin nathu akisandiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jacob mipite agoudiuva apeh danthu chu Mosi'n einapeuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mipi lamkaiho le Israel phungho akikhop khom phatnun, ama Jeshurun'a aleng changin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Reuben hingjing henlang thihih hen; chule amite jong lhomcha hihih hen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichehi Judah phatthei kibohna ahi, chuin aman, Pakai, Judah aw hi ngaijin lang, amite henga puijin; amadin akhut teni hi bulhingset henlang, amelmate-a kona kithopi-a chu nangma hin, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Levi thudolla aman, Massah mun'a naphotchet pa, Meribah twiphunga nakibaopi pa, na mithengpa henga na Thummim le na Urim chu umhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman anu le apa henga, Keiman ama kanamupon, aman asopite jong ahekhenpon, chule achate tahjong ahepoi: ajehchu amahon nathu amangun, nakitepna anitnun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon nathutanna chu Jacob ahiluva, chule na danthu chu Israel ahil dingu; namasanga gimnamtui akoijuva, na maicham chunga pumgo ganlhai aboldiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai, anei agouhou phatthei boh-inlang, akhutna anatohhou sanpeh-in; ama mudaho le ama douna-a hung kipan hochu akipat doh kit louna diuvin akongu jeppeh-in, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Benjamin thudolla aman, Pakai ngailutna chu akoma bitkeija chengding; chule Pakaiyin nilhum keija akhu-a, alengkou teni kikah-a chengding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Joseph thudolla aman, Agam chu van thilluho-in, daitwi ho-in, leinoi thuhtah-a umho-in Pakai phattheiboh changhen,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nisan asodoh ga thillu ho le lhathah-a asodoh thil luho-in,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule tonlai molsangho thilgun holeh kemlou lhang ho-a thil manlu ho,
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule leiset le athil manlu holeh, asung dima umho-in; chule hamboh lah-a chengpa lungdeijin: Joseph lamkaipa luchang le asopite-a kona kikhendohpa luchanga phattheibohna hunglhung hen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aloupina chu abongchal sohmasa pen abangin, akiho chu gambong ki ho abange: hicheho-a chu aman mite chu kolmong geija anokhom ding; chule amaho chu Ephraim mi sangsom le Manasseh mi asang sang chu ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Zebulun thudolla aman, Zebulun nangma napotdoh na-a kipah inlang, chule Issachar nangma naponbuh sunga kipah-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahon miho chu molsang lama akoudiu, hia chu chonphatna ganlhai atodiu ahi. Ajehchu amahon twikhanglen ninglhina le, nellah-a kiselgu gou ho chu achopdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Gad thudolla aman, Gad kehlena chu nunnom hen: ama keipi bahkai bangin achengin, banjang le lu-a lallukhuh chu amaltelin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule chua danthu pepa chanvou mun'a chu ama atou jeh-in, ahop masapen ama akichantan: chule mipi lamkaiho chutoh ama ahungin, aman Pakai dihna le Israelte chunga athutanna atongdoh-in ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Dan thudolla aman, Danhi keipi bahkai nou ahin, Beshan'a kona hungchom doh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Naphtali thudolla aman, Vo Naphtali, lungdeija lunglhaile Pakai phatthei boh-a dim, lhumlamle lhanglam gam lotan, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Asher thudolla aman, Asher hi chilhah in phatthei changhen lang, asopite henga lahthei dol hihen, chule akeng thaotwija dehen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nakengchot thih le sum-eng hiding, nahinlai nikhoho banga nahatna jong umding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangma napanpi dinga vanlaijola touva, chule aloupina-a meibol chunga um Jeshurun Pathen tobang khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tonsot Pathen chu nakiselna ahin, chule noilama atonsot bannang aumin ahi: Aman namasanga kona melmate adelmang ding, amaho chu sumangin atiding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutengle Israel changseh bitkeija chengding, Jacob twinah chu changle lengpithei gama umding; chule avanin jong daitwi alhahsah ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Vo Israel, anunom nahi: nangma tobang koi umam, Vo napanpi nao lumdal le na loupina chemjam, Pakai huhhing mite! Namelmate nahenga ajounao kimuntin, nangman amun sanghou nachotpha ding ahi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Mosi Moab phaicham konin Nebo molsang, Pisgah vuma akaldoh-in, hichu Jericho jontah ahi. Chuin Pakaiyin Gilead gam jouse chu Dan geijin avetsah-in,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Naphtali gam jouse, Ephraim gam, Manasseh le Judah gam pumpi, twikhanglen mong geijin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule lhanglama Jericho phaicham, tumthing kena khopi Zoar geijin avetsahtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakaiyin ajah-a, Nachilhah te kapeh ding ahi tia Abraham, Isaac chule Jacob henga kana kihahselna gamchu hichehi ahi: keiman hichehi namitnin ka musahtan, amun vang nalhun louding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuti chun Pakai thu dungjuijin, Pakai soh Mosi chu Moab gama chun athiden tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Aman Moab gamsunga phaicham khat Beth-peor jona chun avuijin, ahinla tuni geihin alhan chu koimachan ahepoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Mosi athichun kum jakhat le kum somni ahitan; amit athimpon, athahat jong alha dehpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Moab phaichama chun Israel chaten Mosi chu nisomthum akauvin; chuti chun Mosi dinga kana le lunghemna chu akichaitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Nun chapa Joshua chu Mosi'n achunga akhut angap jeh-in, chihna lhagao adimset tan: Israel chaten athu angaijun, Pakaiyin Mosi thu apehbangin abolun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule chucheng nunga pat chun Pakaiyin kimaito tah-a anahet Mosi tobang Israel sunga themgao khatcha asohdoh kit tapon,
  </para>
  <para style="p">
    <verse number="11" style="v" />Egypt gamsunga Pharaoh heng le asohte jouse heng, chule agamsung pumpi-a, melchihna ho le thil kidangho jouse chu boldinga Pakaiyin anasol,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Israel jouse mitmu tah-a Mosi'n anavetsah chuche khut thahat tah jouse-a le chuche tijat umtah jouse boldoh-a khatcha asohdoh kit tapon ahi.
  </para>
</usx>
