<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1KI" style="id">1 Lengte</book>
  <para style="h">1 Lengte</para>
  <para style="toc1">1 Lengte</para>
  <para style="toc2">1 Lengte</para>
  <para style="mt">1 Lengte</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun leng David chu ateh-in kum tamtah ahitan, chuin pon tamtah asilpeh-un, ahinla lum asajoupoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun asohten ahenga, ka pakai lengpa dingin khangdong nungah theng khat kihol hen, amanu lengpa anga dinghen lang, vesuihen lang, chule ka pakai lengpa tilumthei nadin, na-anga lumjihen, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutichun amahon Israel gamsung pumpi-a nungah hoitah khat aholuvin ahile, Shunam mi Abishag amuvin, lengpa henga ahinpui taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nungahnu chu ahoilheh jengin, lengpa chu avesuijin, ajenletan ahi. Ahinla lengpan amanu chu akitimatpi pon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuphatnin Haggith chapa Adonijah chu ama akichoisangin, keima kalengchan ding ahi, tin kangtalai ho le sakol touthemho, chule mi somnga amasanga lhaidin akigottan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule apan, ibola hitobang nabol ham? tin adongin alungnatsah khapoi. Amapa hi mi melhoitah jong ahin, anun Absalom nunga ahin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule aman Zeruiah chapa Joab le Abiathar thempu chu ana kihoutoh pin, chule amanin Adonijah ajoplhonin, akithopi lhonin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Zadok thempu, Jehoida chapa Benaiah, Nathan themgao, Shimai, Rei chule David mihangsan ho vangchu Adonijah toh apangkhom pouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Adonijah'in kelngoiho, bongchalho, chule gancha thao ho Enrogel koma um Zohaleth songpi chunga chun athatnin; leng chapate asopiho jouse le Judah gama lengpa lhachaho jouse akouvin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin Nathan themgao, Benaiah, mihangsan ho le asopipa Solomon vang akoupon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Nathan'in Solomon nu Bethsheba jah-a, Haggith chapa Adonijah alengchana, ipu David'in ahetlou khu najahdoh louham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun tun hungin, katao ahi, nangmatah hinkhole nachapa Solomon hinkho huhdoh theina din thumopming kate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Leng David henga lutnin lang, ajah-a, kapu vo lengpa nasohnu henga thonlouva nachapa Solomon kakhela lengchanga, kalaltouna-a touding ahi tia nana kihahsel hilouham? Ibola Adonijah lengchanga hitam? tin gaseijin ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vetan, lengpa toh nakihou laitahle, keima jong nanunga hunging ting, nathusei kahung suhdet ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Bethsheba chu lengpa henga indan sunga chun aluttai. Lengpa chu atehlheh jengtan, chule Shunam mi Abishag chun lengpa chu ajenlen ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Bethsheba chu aboh khupmin, lengpa chu janan chibai abohtai. Chuin lengpan, ipi nangaichat ham? anati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amanun ajah-a, ka pakai, nangman nasohnu henga Pakai na Pathen min panin, kanungle nachapa Solomon thonlouva lengchanga, kalaltouna chunga touding ahi, tin nana kihahsel in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule tun, vetan, Adonijah alengchang tan; chule tun, ka pakai lengpan hichu nahepoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman bongchalho, gancha thao ho, chule kelngoiho nengtah-in athatnin; lengpa chapate jousele Abiathar thempu chule sepai janel gallamkai Joab akouvin, ahin nasoh Solomon vang akoupon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nangma, ka pakai, vo lengpa, nangma nunga ka pakai laltouna-a chu koi hungtou dingham ti naseipeh dingu ngah-in, Israel chate jouse mit chu nangma chunga aume.
  </para>
  <para style="p">
    <verse number="21" style="v" />Achutiloule hung hitiding ahi, ka pakai lengpa hi apu apate toh ahung lupkhom tengle, keile kachapa Solomon hi mi kisuhmosah-a eiki simlhon ding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule veuvin, amanu lengpa toh akihou petnin, Nathan themgao jong chu ahunglut tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amahon lengpa ahilun, Nathan themgao ahunge, atiuve. Ama lengpa ang ahunglut phatnin lengpa anga akunin amai tolah asulut tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Nathan'in aseijin, ka pakai, vo ka lengpa, nangman kanungle Adonijah hi kalaltouna-a touding, chuleh vai ahomding ahi tia naseikhah ham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu ama tuni hin achesuh-in, bongchalle gancha thao chule kelngoi nengtah-in athatnin, leng chapate jouse, janel gallamkai, chule Abiathar thempu akouvin; chule vetan, amasanga aneuvin adonun, Pathen'in Adonijah lengpa huhhing hen atiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla keima, nasoh keimatah jengjong, chule Zadok thempu, Jehoida chapa Benaiah, chule nasoh Solomon vang akoupon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche thilhi kapu lengpan nabol hija, kapu lengpa nunga alaltouna chunga koi atouding nasohpa henga nahetsah lou khattou ham? atin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuphatnin David lengpan adonbutnin, Bethsheba chu kahenga dingin hinkou lutnun, ati. Chutichun amanu lengpa angsunga ahunglutnin, lengpa angah adingtai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin lengpa akihahselin, lung gentheina jouse-a kona kahinna eilhatdoh jingjeng Pakai chu ahinjing bangin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Keiman nahenga Pakai Israel Pathen mina kana kihahsela, thonlouva nachapa Solomon keima nunga lengchanga, keima khela kalaltouna chunga touding ahi, tia kanasei banga, tunikho-a hi chutia chu kabol tahbeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuphatnin Bethsheba'in amai tolah asulutnin, lengpa jana apen, kapu David lengpa a-imatih-in hingjing hen, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin David lengpan Zadok thempu, Nathan themgao, chule Jehoiadah chapa Benaiah chu kahenga dingin hinkoulut nun ati. Chuin amaho lengpa henga ahungtaovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lengpan jong amaho henga, napu sohte hi puijun lang, kachapa Solomon chu kasakol chunga tousah unlang, Gihon'a puisuh-un;
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Zadok thempupa le Nathan themgaovin hikoma chun Israel chunga leng dingin thao nulhon hen; chule nanghon sumkon mut un lang, Solomon lengpa Pathen'in huhhing hen, tiuvin.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chujoule ama kalaltouna-a atoutheina dingin, nanghon anung hinjui touvun; ajehchu kei khella ama lenga pangding ahi. Chule keiman ama Israel le Judah chunga vaipo dinga katun ahitai, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Jahoiada chapa Benaiah chun lengpa adonbutnin, Amen, kapu lengpa Pakai Pathen'in jong chutichun seihen.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pakaiyin kapu lengpa anaumpi bangin, Solomon jong umpi henlang, alaltouna chu kapu David laltouna sanga lenjon sempeh hen, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hitichun Zadok thempu, Nathan themgao, Jahoiada chapa Benaiah, Chereth mite, chule Paleth mite achesuh-un, David lengpa sakol chunga chun Solomon atousah-un, Gihon'a ahinpui taovin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Zadok thempu chun houbuh-a konin thao koina saki khat aladoh-in, Solomon chu anutai. Chuin amahon sumkon amutnun; mijouse chun, Pathen'in Solomon lengpa huhhing hen, atiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin mipi jouse anunga akitol touvun, mipin kuli amutnun, hachangpan akipah-un, hitichun ahusaovin leiset akithing leovin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Adonijah le ajinho jousen a-anneh jouvun hichu ajataovin ahi. Chuin Joab'in sumkon gin ajah phatnin, ipidinga khopi sunga awgin kithong lenglung ham? atin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Aman hichu asei nalaijin, veuvin, Abiathar thempu chapa Jonathan ahunge; chuin Adonijah'in ajah-a, hunglutnin, nang mihangsan nahin, kipanathu nahinpoi, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Jonathan'in Adonijah adonbutnin, tahbeh-in ipu David'in Solomon lengin asemtai, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule lengpan Zadok thempu, Nathan themgao, Jehoiada chapa Benaiah, Chereth mite, chule Peleth mite chu amatoh asolin, amahon amachu lengpa sakol chunga atousah-un;
  </para>
  <para style="p">
    <verse number="45" style="v" />Zadok thempu le Nathan themgaovin amachu Gihon'a lengdin thao anulhonin, amaho chua kona thanom tah-a hungtou uva, hijeh-a chu ahusan uva khopi kithonga ahi. Nanghon najah-u hi hiche husa chu ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule Solomon jong lenggam laltouna achun atoutan ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chukalvalin lengpa sohte chu ipu David lengpa phattheiboh dingin ahungun, Pathen'in nangma min sangin Solomon min chu kithansah johenlang, chule alaltouna chu nangma laltouna sanga lenjon semhen atiuve. Chule lengpa chu alupna chunga akunjin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule lengpan jong, kamitnin amu petna, tunikho-a kalaltouna-a touding mikhat eipe-a Israel Pakai Pathen chu nunnom hen, tin aseije, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin Adonijah toh umkhom ajinho jouse akicha taovin, akipat doh-un, mijouse amadoncheh-a achedoh taove.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule Adonijah chu Solomon jeh-in atijan, akipatnin, achen, maicham ki hochu atuh dentan ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin hichu Solomon aseipeh-un, veuvin, Adonijah'in Solomon lengpa akichatai; ajehchu, vetan, aman maicham ki hochu atuh-in, Solomon lengpan asohpa chemjam'a atha louna dingin tuni hin kahenga kihahsel hen atie, atiuve.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin Solomon'in, aman mi tahsan um ahina avetsah-a ahile asamjang khat jong tolla lhalou ding ahi; amavang ama-a khangitlouna akimu dohle, thiteiding ahi, ati.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chutichun leng Solomon chun mi asolin, amahon maichama konin ahin puisuh taove. Chuin ama ahungsuh-in Solomon henga chun abohkhuptan; chuin Solomon'in ajah-a, na inlama chetan, ati.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun David thi nading nikho chu anaitan; aman achapa Solomon chu athupeh-in, ajah-a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Keima leiset pumpi chena lampi-a chu cheding kahitai; hijeh chun hatninlang, pasal nahina chu tahlangin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pakai na Pathen thupeh chu nit jingin; Mosi lekhabua kisun bangin alampiho juijin, adan kisunho, adan thupeh ho, athutan lhahho le, ahetthohsahna ho nitjingin; chutile nakihei nalam jouse le nabol jouse-a naphatthei ding;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutiachu Pakaiyin keima chungchanga, nachaten alung pumpiu le ahinna pumpiuva kamasanga thutah-a achonna dinguva, akalsona lampi houva achihthei uva ahile, Israel laltouna-a touding kiphasam louva nanei ding ahi, tia anaseichu aguilhunsah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukal vallin Zeruiah chapa Joab'in kachunga athilbol, chule Israel janel gallamkai teni, Ner chapa Abner le Jether chapa Amasa atha-a, achung hona athilbol; chamna aumlaija gal thisan aso-a, akonga agah konggah chungle akenga akibu kengkoh chunga gal thisan anu chu nangman nahen ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun nachihna bangtah-in bolinlang, alukan nung hijongle lungmong tah-in lhankhuh-a chesuhsah hih-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Gilead mite Barzilai chapate henga chun lungsetna chu musah inlang, nadokhanga an neho lah-a chun amahochu ankong umsah-in; ajehchu nasopipa Absalom jeh-a kajamle laijin kakoma ahungun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ven, Mahanaim'a kache petna gaosapna khohtah eina gaosap, Bahurim'a cheng Benjamin son Gera chapa Shimei chu nahenga uma ahi. Ahinla Jordan'ah eikimupidin ahungsuh-in, keiman Pakai minin kahahselin, chemjamin that ponge kanatin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun tun ama mona beijin koihih-in; ajehchu miching nahin, achunga ipi bolding ahi nahenai; Ahin alukan nung hijongle thisan puma lhankhuh najotsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutichun David chu apu apate toh analum khomin, David khopi-a anavuitaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule David'in Israelte chunga lengvai anapoh sung chu kum somli ahin, Hebron'ah kum sagi analeng changin, Jerusalem'a kum somthum le kumthum ana lengchange.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Solomon chu apa David laltouna-a atouvin; chule alenggam lentah-in anaki phutdoh tai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Haggith chapa Adonijah chu Solomon nu Bethsheba henga ahungin ahi. Amanun ajah-a, chamdela nahung hinam? tin adongin ahile, amapan, chamdelin kahung nai, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chukalvalin aman amanu jah-a, nahenga seinom themkhat kaneije, ati. Amanun ajah-a, seijin, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichun amapan, lenggam chu keija ahi-a, chule Israelte jousen jong keima lengvai poding ahi tia eivet cheh-u ahi ti nangman nahenai; hijongle lenggam chu akiheidoh-in, kasopipa-a ahunghitai. Ajehchu Pakaiya kona hichu ama-a hija ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule tun nahenga ngehnom khat kaneijin, nei itpeh hihbeh-in, ati. Chuin amanun, seijin, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman katao ahi, Solomon lengpa henga Shunam mi Abishag khu kaji dingin neithum peh-in, (ajeh chu aman nathu nelponte,) ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Bethsheba'n, aphai, lengpa henga nangma-a dingin seipeh nange, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Bethsheba chu Adonijah'a dinga seipeh dingin Solomon lengpa henga achetai. Chuin lengpa amanu kimuto pidin akipatdoh-in, a-anga akunin, chuin alaltouna-a atouvin, chule lengpa nu-a ding chun laltouna ado sah-in; akhutjet lama chun atoutai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amanun ajah-a, nangma henga ngehna neokhat kanei nome; katao ahi, kanompoi neitipeh hih-in, ati. Chuin lengpan amanu henga, thumin, kanu, ajehchu kanompoi tipeh ponge, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amanun, Shunam mi Abishag hi nasopipa Adonijah ji dingin kipehen, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin leng Solomon'in anu adonbutnin, ibola Shunam mi Abishag chu Adonijah ji dinga nathum ham? ama dingin lenggam jonghi thumin; ajehchu ama ka upa ahi; amadingin, Abiathar thempu dingin, chule Zeruiah chapa Joab dinjong thumin, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin Solomon lengpa Pakaiya akihahselin, Adonijah'in ama hinkho douna-a hiche thuhi aseilou hileh, Pathen'in kachunga chutichun bolhen, chukalvallin jong bolhen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun tun, Pakai ahin jing bangin, athutep bangtah-a eitungdoh-a, kapa David laltouna-a eitousah-a, insungkhat eisempehpa mina kahahsel ahi; tunikho-a hi Adonijah thi teitei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Solomon lengpan Jehoiada chapa Benaiah chu asolin, ama achunga achun athat tai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin lengpan Abiathar thempu henga, nangma Anathoth kho na inle lou mun'a kichetan, athidinga lom nahi; kapa David masanga Pakai Pathen kitepna thingkhong naput jehle, kapa kibolgimna chana kibolgim nahi jeh-in, tuchunghin thatponge, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutichun Pakaiyin Shiloh'a Eli insung thudol anaseichu aguilhunsah theina dingin; Solomon'in Abiathar chu Pakai thempu ahina chu ahaisahtai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chujouvin Joab henga thu ahung lhungtai: ajehchu ama Absalom lama kiheihih jongle Joab chu Adonijah lama akiheija ahi. Hijeh chun Joab chu Pakai houbuh lama ajamin, maicham sakiho chu atuhchah tai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin, Joab chu Pakai houbuh lama ajamin, chule ven, maicham koma aume, tin Solomon lengpa aseipeh taove. Hichun Solomon'in Jehoiada chapa Benaiah asolin, chenlang gathatnin, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Pakai houbuh phunga Benaiah ahungin, ahenga, lengpan hung doh-in ati, tin agaseijin ahi. Ahin aman, kanompoi, hikoma hin thijonge, ati. Chuin Benaiah'in lengpa thu ahetsah kitnin, Joab'in hitin aseijin, hitin eidonbutne, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin lengpan ajah-a, aseibang bangin boljengin, that inlang vuitan; chutile keima le kapa insunga kona monabei thisan Joab'in asochu nalahmang theiding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule ama sanga dihjo le phajo mini, Ner chapa Abner Israel janel gallamkai le Jether chapa Judah janel gallamkai Amasa chu kapa David hetlouva achemjama athajeh-a, Pakaiyin athisan chu ama luchung tah-a achuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh-a chu amani thisan chu Joab luchangle achilhahte luchunga a-itih-a dinga hungkile ding ahin; ahinla David chungle achilhahte chung, insung mite chungle alaltouna chunga vang Pakaiya kona a-itih a chamna leng ding ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hitichun Jehoiada chapa Benaiah achetouvin, achunga achun, athattai. Chule gamthipma amatah in'a akivui tan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin lengpan Jehoida chapa Benaiah chu ama khelin janel chunga vaihomin akoijin; chule Zadok thempu chu Abiathar mun'a akoitan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin lengpan Shimei kouding asolin, ajah-a, Jerusalem'a inkhat kisah-in lang chuachun chengin, chua konin hoima danga chedoh hih-in.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ajehchu hitiding ahi, nangma nachedoh-a Kidron vachadung nagalkai ninile, nangma thonlouva nathi teiding ahi ti kihetnin; nathisan chu nangmatah luchunga chuding ahi, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Shimei'in lengpa henga, akiseichu aphai; kapu lengpan nasei bangin nasohpan bollinge, ati. Chuin Shimei Jerusalem'a nitamtah achengtai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin kumthum jouvin ahitin ahi, Shimei sohte mini Gath lengpa Maachah chapa Achish henga ajammang lhontai. Chule Shimei koma, ven, nasoh teni Gath'a aumlhone, tin aseipeh taove.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Shimei akipatnin, asangan chunga atouvin, Gath'a Achish henga asohteni hollin achetai; chuin Shimei achen, asohteni chu Gath'a konin ahinpuitai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule Shimei Jerusalem'a konin Gath'a achen, ahungkile kit tai tin Solomon aseipeh taovin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin lengpan Shimei kouding mi asolin, ajah-a, keiman Pakai mina kaki hahsel sah-a, nangma napotdoh-a, mundanga navadoh ninileh nathi teiteiding ahi, chentah-in kihetnin, tia kagihsa nahi hilouham? chule nangman kajah-a, kathujah hohi aphai natin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Achutile ibola Pakaiya kihahselna le, thupeh kapeh chu nitlouva nahim?
  </para>
  <para style="p">
    <verse number="44" style="v" />Chukal valin lengpan Shimei jah-a, kapa David nabolna gitlouna jouse nahen, nalung gilin nahetpeh-e; hijeh chun nagitlouna chu Pakaiyin nangmatah luchunga achuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule Leng Solomon vang nunnom mintin, chule leng David laltouna chu Pakai angsunga tonsotna phudetna umding ahi, ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuti chun lengpan Jehoiada chapa Benaiah thu apen; ama apotdoh-in, achunga achun, athat tai. Chule lenggam chu Solomon khutna akiphutdet tai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Solomon'in Egypt lengpa Pharoah toh kihet them tona abolin, Pharoah chanu akichenpin, ama inding, Pakai inding, chule Jerusalem kimvella bang asah chaisoh kahse-a dingin, David khopi sunga chun akipui luttai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai mina in akisah loulai jeh-in, hiche nikho geija chun mihon munsang ho-a kilhaina abol jiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Solomon'in Pakai angailun, apa David chonnadan anitjingin; amavang munsang ho-a kilhainale gimnamtui halna aboljin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lengpa Gibeon'a ganlhaina boldin achetai; ajehchu hikom munchu munsang thupipen ahi. Solomon'in hiche maicham chunga chun govam thilto sangkhat jen atoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gibeon mun'a Pakai chu jan-in Solomon manga ahung kilah-in; chule Pathen'in, thumin ipi kapeh ding nahim, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Solomon'in, Nangman nasoh kapa David namasanga thutah-a, chonphatna-a, chule lung dihtah pu-a nangma toh aum jeh-in, achunga hepina lentah nanamu sah-in; ama khohsahna jal-in hiche hepina chu nakoi jom jingin, tunikho-a banghin alaltouna-a touding chapa khat nanapetan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule tun, vo Pakai ka Pathen, nangman nasohhi kapa David khelin lengin neisemtan, hinla keimala chapang neocha kahin; vaikonje vailhunje helou kahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nasohhi nalhendoh mite, mipi tamtah, atamjeh uva simjouhoi hiloule ajat hetjouhoi hilou lah-a hin kaumme.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun nasohhin, asele apha kakhentoh theija, namite vai kahom thei nadin, hetkhen themna lung neipen; ajehchu hibanga tam namite hi kon vai ahom thei dingham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Solomon'in hiche thil athumna-a athuseihin Pakai alunglhaisah lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pathen'in ajah-a, nangman hiche thil nathuma, na hinkhosot nading, nahao nading, ahiloule namelmate hinkho ding thumlouva, nangman vaihom themna dinga hetkhenthem theinajoh nathum jeh-in,
  </para>
  <para style="p">
    <verse number="12" style="v" />Vetan, nathusei bang bangin kabolpeh tai. Ven, chihna le hetkhenthem theina lungthim kapeh nahitai; chutia chu namasanga jong nangma tobang ana um khalou, chule nanunga jong nangma tobang himhim hung umkit talou ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nahin laise-a lengho lah-a nangma tobang himhim aum louhel nadingin, nangman nathumlou haonale jabolna jong kapehthan ahi
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule kadan kisunho le kadan thupeh ho nanitna, napa David'in ajui banga, kalampiho najuija ahile, nahinkho kasotsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Solomon akhangtan ahileh, veuvin hichu amang anahi. Chuin ama Jerusalem'a ahungin, Pakai kitepna thingkhong masanga adingin, govam thilto le chamna thiltoho atoh-in, asohte jouse golvah khat abolpeh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chujouvin lengpa hengah numei kijoh ni ahunglhonin, chule a-angsunga ading lhonnin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin numei khatnu chun, Vo ka pakai, keile hichenu hi inkhatna kacheng lhonin; insunga amatoh kaum petnin cha khat kahingin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, kacha hinjou anithumnin, hiche numeinu jonghin cha ahingin ahi. Hitichun ka umkhom lhonin, hiche insunga chu keini tilou midang koimacha toh kaum khom louvu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hichenun anaocha chu adelpha khah jeh-in, jan-in ana thitan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin jankhangin amanu athouvin, nasohnu ka-imut petnin kachapa kakoma konin akilah-in, apotnin a-anga alupsah-in, ama cha athisa chu keima angngah analupsah tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin kanao noi chepsah dinga jingkah-a katho phatnin, vetan, athisa anahitai. Ahinla jingkah-a hoitah-a kavetchetna ahile, vetan, keiman kahin kachapa chu anahitapon ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin numei khatjonu chun, ahipoi; ahingjoh chu keichapa ahin, athi chu nang chapa ahi, ati. Chuin amasanu chun, ahipoi; athijoh chu nang chapa ahin, ahing chu kei chapa ahi, ati. Hitichun anilhon chun lengpa angsunga asei lhontan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin lengpan, khatnin ahinghi keicha ahin, athi hi nang chapa ahi natilhon in; chule khatnin, ahipoi, athijoh chu nang chapa ahin, athilou chu keichapa ahi natilhone, tin aseije.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin lengpan, chemjam khat neihin peuvin, ati. Chuin lengpa anga chun chemjam khat ahinchoi taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin lengpan, naosen ahingjoh chu bongni souvin, bongkhat lamchu khat peuvinlang, chule bong khat lamchu khat jonu peuvin, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuphatnin naosen hingnu johchun lengpa jah-a, achapa alaigilga akhotona jeh-in, vo ka pakai, naosen hing chu amanu chu petan, thathih beh-un, ati. Ahinla khatjonu chun, keija jong hida henlang nanga jong hida hen, bongni souvin, atitai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuphatnin lengpan adonbutnin, naosen hingchu amasajonu, that hih beh-un tinu chu peuvin, amanu chu ahinga anu ahi, atitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Israelte jousen lengpa thutanlhah danchu ajataovin; lengpa chu akichataove; ajehchu amahon thutan nadinga Pathen chihna ama-a aumchu amutaovin ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chutichun Solomon lengpa Israel pumpi chunga leng anahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hichehohi amilen neiho chu ahiuve: Zadok chapa Azariah chu Thempu ahin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Elihoreph, le Shisha chapa Ahijah chu lekhasun ahin; Ahilud chapa Jehoshaphat chu thuching ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Jehoiada chapa Benaiah chu janel gallamkai ahin; chule Zadok le Abiathar chu thempu ahilhone.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nathan chapa Azariah chu lamkaiho chunga ahin; Nathan chapa Zabud chu thempu le lengpa golpa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahishar chu insung vaipo ahin; Abda chapa Adoniram chu sele kai choiho chunga vaipo ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Solomon'in Israel pumpi chunga chun lamkai somleni aneijin, amaho chun lengpa le a-inkote dinga nehle chah angaito jiuvin; mikhatnin kumkhatna lhakhat sung nehding angaito cheh jiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichehi aminu ahi: Hur chapa chun Ephraim molsang apon,
  </para>
  <para style="p">
    <verse number="9" style="v" />Derek chapa chu Makaz, Shaalbim, Bethshemesh chule Elonbethhanan mun apon;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hesed chapa chu Aruboth, Sochoh le Hepher gamsung pumpi apon;
  </para>
  <para style="p">
    <verse number="11" style="v" />Abinadab chapa chun Solomon chanu Taphath jin aneijin, Dor gamkol apumpi apon;
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahilud chapa Baana chun Taanach, Megiddo, Bethshean pumpi, Jezreel noija Zarthanah koma um Bethshean'a pat Abel-meholah gei, Jokmeam gallam mungeijin apon;
  </para>
  <para style="p">
    <verse number="13" style="v" />Geber chapa chun Ramoth-gilead, Gilead'a umho Manasseh chapa Jair khopiho chu ama-a ahin, Bashana um Argob gamkai jong ama-a ahin, banghole akotgol ho sum-enga kisem cheh khopilen somgup ahin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Iddo chapa Ahinadab'in Mahanaim apon;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahimaaz'in Naphtali apon; Solomon chanu Bashemath chu jidin akipuijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hushai chapa Baanah chun Asher le Aloth-a apo-in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Paruah chapa Jehoshaphat'in Issachar gamsung apon;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ela chapa Shimei chun Benjamin gamsung;
  </para>
  <para style="p">
    <verse number="19" style="v" />Uri chapa Geber chun Gilead gamsung, Bashan lengpa Og chule Amor mite lengpa Sihon gamsung chu apon ahi. Chule agamsunga chu ama sehseh bou gamvaipo hia ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Judah le Israel chu luipi kama neldi bangin atamlheh-un, aneuvin adonun, chule nop abollun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Solomon chu luipi apat Philistine gamgi, chule Egypt gamgi chin geija lenggam jouse chunga chun vai ahomin; amahon thilpeh ahinchoijun, Solomon chu ahin laisen ajenun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Solomon nikhat anneh chu changbong neljet tena somthum, chule changbong an tena somgup ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sakhi chalho, sapeng chalho, sakhi gol, chule vacha kivahthao ho tilouvin; bongchal thao som, hamdonga kivah bongchal somni, chule kelngoi jakhat ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu aman luipipang hilamsang gamkai pumpi, Tiphsah apat Azzah gei, luipang hilamsang lengho jouse chunga lengvai apoh ahin; akimvel jouse toh chamna aneijin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Judah le Israel chu Dan'a pat Beersheba geijin Solomon hinlaisen amitakip alengpi phungle atheichang phung noija mongtah-in achengun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Solomon'in asakol kangtalai koinadin in sangsomli aneijin, chule sakol touthem mi sangsom le sangni aneije.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule vaipiho chu amitakipmin alha seh-in Solomon dingle, Solomon lengpa dokhanga hungjouse dingin nehding ahin peuvin; amaho ima alhasam pouve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amitakipmin akinganse dungjuijin sakolhole gancha kaljangho ding chun, sakolchang le changpol ahinpo jingun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Pathen'in Solomon chu chihna le hetthem theina nasatah, chule lungletna twipi panga neldi banghela tamin apen ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Solomon chihna chun solam gam chate chihnale, Egypt pumpi chihna jouse akhokheltan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu ama mijouse sangin achingin; Ezrah mi Etham, Heman, Chalcol chule Derda, Mahol chapate sangin achingjon, chule akimvela namjouse lah-a akithangtan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman thuchih sangthum aseijin; chule la anabol chu sangkhat le nga ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule thingphung jouse, Lebanon'a um cedar thinga pat, kulbanga kona hung kehdoh hyssop changeijin anaseijin; aman gamsaho, vachaho, a-opma kitholho, chule ngaho thu jong anaseije.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama chihna anajakha-a leiset lengho jouse-a konin, Solomon chihna ngai dingin namtin ahung jiuvin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule apa indan sunga amahon amachu lengdin thao anuve ti ajah jeh-in, Tyre lengpa Hiram'in asohteho Solomon henga asoltan ahi. Ajehchu Hiram chu a-itih-a David ngailu jing anahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Solomon'in Hiram henga mi asolin, ajah-a hitin aseije,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin amaho akengto noija akoi masangse-a, galmiten ama aumkimvel jing jeh uva, kapa David'in Pakai a-Pathen mina in iti anasah joulou ham ti nangman nahen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla tun Pakai ka Pathen'in ningtina konin choldona eipetan, hijeh chun kidoupi jong hamsetna jong aumtapoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule, vetan, Pakaiyin kapa David henga anasei, na indan sung nalaltouna-a katousah ding nachapa chun, keima mina in eisahpeh ding ahi, anati bangin, Pakai ka Pathen mina in sah ding kagon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun tun Lebanon'a kona cedar thingho aphuh nadiuvin thu penlang; kasohte hi nangma sohte toh pangkhom untin, chule nanganse dungjuijin nasohte thaman keiman penange. Ajehchu Sidon mite banga thing tuthem kalah uvah aumpoi ti nahei, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin ahitin ahi, Hiram'in Solomon thu ajah phatnin akipah lheh jengin, hiche mipi tamtah chunga chapa ching David pepa Pakai chu tuni hin nun nomhen, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Hiram'in Solomon henga mi asolin, neihin solnaho chu kangaiton, cedar thingle chahthing chungchanga nangaichat jouse chu bolnange.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kasohten Lebanon'a konin twipi geijin hintol lhaovintin; nangin neitepeh ding mungeijin twipia hintoling ting, chule chua chun sodohsah ing-katin, chua kona chu nangman nana kilah ding ahi. Chule ka insung nehding neipeh-a, kangaichat neisuh bulhit pehding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutichun Hiram'in Solomon chu angaichat jouse dungjuijin cedar thingle chahthing apetan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Solomon'in Hiram chu a-insung anneh dingin suhlou chang tena sangsomni, chule thaotheng tena somni apen; hitichun Solomon'in akum akumin Hiram apejin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin akitepna bangin Solomon chu chihna apen; chutichun Hiram le Solomon kah-a chamna aumin; amanin kiguijopna aneigel lhonne.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Solomon lengpan Israel jouse lah-a konin natong honkhat aphutdoh-in; natonghon hochu pasal sangsomthum ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman amaho chu Lebanon'a asolin, lhakhatna sangsom cheh-in akilhahsah-in; Lebanon'a lhakhat umjiuva, in'a lhani umji ahiuvin; chule Adoniram chu natongho vesuija pang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Solomon'in molsang ho-a chun thilgih poho mi sangsomsagi aneijin, chule songkheng them mi sangsomget aneijin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Natohnaho chunga Solomon vaipo pipuiho tilouvin, natohna-a mipi ho chunga vaihom dingin mi sangthum leh jathum aneijin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin lengpan thu apen, inbul setna dingin song len tahtah, chule manlutahtah song kikhengho ahinpouvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Solomon insaho, Hiram insaho, chule Gebal mi song khengho chun hicheho chu akhengun, chutichun insah nadin thingle songho chu agong uvin ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Israel chate Egypt gama ahungpot doh-u kum jali le kum somget lhinkum, Israelte chunga Solomon alengchan kum li na, Zif lha, hichu alha ni chana ahin, Solomon'in Pakai houin ding chu asapan tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai dinga Solomon lengpa houin sahchu adunglam tong somgup, availam tong somni, chule asanlam tong somthum ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule houin mailama ahongcha chu a-invai adungjuija adunglam tongsomni ahin, invailam amaichu tongsom ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule houin dinga chun bangkot jim vah lutna asemin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule houin bang kimvela chun indan ahoi kimvelin, houin bangho jon kimvel, houin le houna mun'a chun indan ahoi kimvele.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dan noinungpen chu tong nga-in alenin, alai chu tong gupmin alenin, chule athumna chu tong sagin alenne. Inkamho chu inbangho-a akihendet lounadin inbang sunglama chun akingapna din akimvela chomcha adosah-e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule houin kisah sunga chu seh le heicha, ahiloule thih manchah gin insunga chu akijah louna dinga, insah na-a kimangcha songho chu kikheng tohsa-a hin kipolut ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuche danlai kotkhah chu houin jetlam sanga aumin; amaho chu kalbi-a danlailha-a chiu kaltoujiu, danlaija kona chu athumna-a kaltou jiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun houin chu asan, ajouvin, houin chu cedar thingtum le thingpeh-in atomin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman houin jonna chun indanho asa-in, tong nga-a cheh-a sangin asan; hicheho chu houin chunga cedar thingtuma kingamin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakai thu Solomon henga ahung lhungin, hitin aseije;
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman nasah houin chungchanga hin, kachonna dan kisunho najuija, kathutanho najopma, kathupeh ho jouse nanit na, hichu najuija ahile; napa David henga kanasei thu chu nachunga kalhunsah-a,
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel chate lah-a kachena, chule kami Israelte kanungsun louding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chutichun Solomon'in in chu asan ajoutai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule houin sunglam bang ahin, lhong ahin, chuleh in chung ahin ceder thingpeh-in atomin; hiche chunga chun asunglam chu thingin atomin, inlhong chu chahthingpeh-in atomin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule inbangho chu tongsomni cheh-in lhongle bangho chu cedar thingpeh-in asan; houna mun, muntheng chungnung jenga jongchun asunglam hititah chun abolin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule chuche houin mai chu tong somlia saova ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule insung lama chun apah mumle apahlha pahcha banga kijem cedar thing aumin; aboncha cedar thinga kisem ahi, song khatcha muding aumpon ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Pakai kitepna thingkhong koina dingin insung lama chun Pathen houna muntheng agongin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule houna mun sunglam chu tong somni, atoa tong somni, alet tong somni, asan tong somni ahin, hichu sanathengin alonkhum cheh-in, chule cedar thing maicham chu chutima chun alonkhumin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichun Solomon'in insunglam chu sanathengin alonkhum sah-in; chule houna mun maicham chu sanaguijin indan khenna asemin, hichu sanatwi jin alonkhum sah-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin houin pumpi chu injouse ajosoh kah-un sana alonkhumin, houna mun koma maicham pumpi jongchu sana-in alonkhumin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule houna mun sunga chun olive thingin Cherubim ni, tongsom cheh-a sangin asemin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Cherub khatpa lhavingchu tong nga ahin, Cherub chompa lhaving chu tong nga ma ahi; khatpa lhaving monga pat, achompa lhaving mong geichu tongsom ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Cherub chompa chu tongsom ahin, Cherub teni chu alet aneu kibangchet ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cherub khat sandan chu tongsom ahin, Cherub khatpa jongchu chutima chu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Cherub teni chu insung nunga chun atungin, Cherubim teni lhaving chu akijahdoh gelin; chutima chun Cherub khatpa lhavingin bang langkhat chu atongkhan, alhaving lhonchu inlailung tah-a akigotkhan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Cherub teni chu sanatwijin kilonkhumin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule inbang jouse kimvel chu Cherubim le lusuphung, pahcha, chule pahcha pahlhan asungle apo ajem hoijin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule inlhong asungle apochu sanatwijin alonkhumin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule houna mun lutnadin olive thingin kot asemin; kotchungle kotbang hochu bang hopnga-a hopkhatjen ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule kot teni chu olive thing ahigelin; achung lhonchu Cherubim le lusuphung, chule pahchapah phungin ajempolin, hihochu sanatwijin alonkhumin, Cherubim le lusu phungho chung chu sanatwi athekhumin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chutima chun houin kotbengho chu, bang hop li-a hopkhatjen olive thingin asemin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule kot teni chu chahthinga kisem ahin; kotkhahpeh tenichu akilhepthei ahin, kot pheng chompa peh teni jongchu akilhepthei ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hiche chungchu Cherubim le lusuphung, chule pahcha pahlhan ajemin; akijempah chungchu sanan atom nalaijin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Houin sungnung chu song kikhen jolsa golthum, chule cedar thingtum golkhatnin asan ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kum li lhina, Zif lha-a Pakai houin bul chu kiphutna ahin;
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule kumsomle khatna, Bul lha, hichu lha getna ahin, houin pumpi chu akigon dungjui cheh-in akijou sohtan ahi. Chutichun hiche sahna-a chun kum sagi alutnin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin Solomon'in amatah in sahnan kumsomle kumthum alut sah-in, a-in chu abonchan ajoutai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman Lebanon gammang in jongchu asan: hichu adung tong jakhat, avai tong somnga, asanlam tong somthum ahin, cedar khom gol li kiphutna, hiche khomho chunga chu cedar thingtuma kisa-a ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule thingtumho chunga chu ceder thinga kikhu-a, khom somlenga cheh-a kigol, khom somli le nga chunga kisa-a ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule golthum na-a bangkot aumcheh-in, vahle vah chu golthumin akidongto cheh uve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule kotpi jousele khomho chu ningli cheh ahin, bangkot hotoh vahle vah chu golthumin akidongto cheh uve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman khomho neijin thutanna hongcha jongchu asemin, hichu asaodan tong somnga ahin, chule avai chu tong somthum ahi. Chule hongcha chu amai lama aumin, khom dangho leh inkam lentah chu amailam sanga aumin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujouvin thu atan theinadin, laltouna hongcha asemin, thutanna hongcha jong asemin; hichu lhong langkhatna patna langkhat gei cedar thinga kikhu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule achenna in hongcha sunga chun inhong chomkhat aneijin, hiche jongchu chutobang ma-a kisa ahi. Solomon'in hiche hongcha tobanghin, ajidinga akipui Pharoah chanu dingin jong inkhat asahpeh-in ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hicheho jousehi akikheng songho, song atna-a ki-at, song mantam tah jenga kisa ahin, a-inbula patna aleh gei, asung apo, chule inpilen hongsung apolam geija chutia chu kisa ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule inbulchu song mantam tah ho, song len tahtah, tongsom chenga sao le tong get sao ho-a kise ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule achunglam chu song mantam tah ho, song kitetoh-a kikhengtoh ho, chule cedar thinga kisa ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule inlen chu akimvela song kikheng golthum le cedar thingtum golkhat kigola kisa ahin; Pakai indan sungnung le ahongcha jongchu chutobang ma-a chu kibola ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Solomon lengpan Tyre'a konin Hiram agapuisah-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama chu Naphtali phunga meithai khat chapa ahin, apa chu sum-eng kheng Tyre mi ahi. Amachu chihna le hetkhen themna dimset ahin, sum-eng khenalama thepna nei ahi. Chuin ama Solomon lengpa henga ahungin ana jouse chu atoh pehtai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman tong somle tong getna sang sum-eng khomni alhan; chule aletdan chu tongsomle tongni cheh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule khom teni vuma tundin, sum-eng kilhajol khom alujum ni asemin, khomjum khatchu tongnga asangin, khomjum khatpa jong tong ngama ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule khompiteni vuma khom lujum teni jeppahna dingin sum-eng guilen polchit chet asemin; khom lujum khatdin sagi ahin, chule khom lujum khatpa dingin jong sagima aseme.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman khompiho asemin, avuma khom lujum teni khunadin kolbuthei lim lenvang golni asemin, chutimachun khom lujum khatpa jong abole.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hongcha khom vuma ajumchu molhoipah-in akijemin, tongli ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule khom lujum teni chunga apoh dontah-a avang silsel koma chun kolbuthei lim asemin; khom lujum ni kimvella chun kolbuthei lim jani agolin aumin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin khom hochu houin hongcha-a aphutnin; jetlam khom aphutdoh-in, hiche minchu Jachin asah-in; chule veilam khom chu aphutdoh-in, hiche minchu Boaz asah-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule khompi vuma chun molhoipah lim achongin, chutichun khom natoh akichaitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin twibem khat asemin, ageikhatna pat langkhat gei tongsom ahin; apuma kikolsoh ahin, asanlam tong nga ahin; chule akimvela kikolchu tong somthum ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche ageinoi kimvel chu pahmun limin avelsoh-in, tongkhat sunga pahmun som cheh asemin, twibem chu pahmunin akolkhumin ahi; pahmunchu akisun chun golnin akisungin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichu bongchal somleni chunga kingam ahin, thumin sahlam angan, thumin lhumlam angan, thumin simlam angan, thumin solam angat ahi. Twibem chu amaho chunga kikhang ahin, ameiju chun sunglam angat cheh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichu asalam khutphang te-a sa ahin, ageichu khon gei tobang ahin molhoipah-a kijemin; asung chun twitena bath sangni adolin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman sum-eng khomtodom som asemin, khomtodom khat chu adung tongli ahin, avai tongli, chule asan chu tong thum ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule khomtodom boldan chu hiti ahi: hicheho chun agei anei cheh-un, hiche ageiho chu akoho kikah-a kikhumlut cheh ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule ageiho kikah-a akoho-a chun keipi bahkaiho, bongchalho, Cherub ho lim aumin; ageiho chunga chun tunsonna aumin, keipi bahkai le bongchalho noilam chu khut thema jephoina akisemin akibelap cheh-in ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tunsonna tinin sum eng kangtalai li cheh, sum-eng kong licheh aneijun, aninglia kingapna aumcheh-in, kisilna bel noija kingapna kisung aumin, aning cheh-a belapna umcheh ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Alujum kikol sung akam chu tongkhat lha ahin, hiche akam vangchu tunsonna abem banga kikolbem ahin, tongkhat le akeh ahi. Chule akam gei kimvel chu kigeihoi ahin, aningli ahin, abem ahipoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ageiho noija kangtalai li aumin, kangtalai ajolpi chu tunsonna toh akimatnin; akeng khatchu tong khatle akeh-a sang ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule akang boldan chu sakol kangtalai kiboldan bang ahin, ajolpiho, alaibohho, akaldet naho, ajangho chu akisuntho cheh ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule tunsonna ningli cheh-a akingapna licheh uma ahin; hiche akingapna hochu tunsonna toh pumkhat ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tunsonna chungvuma chun tong keh-a sang velkol khat aumin, tunsonna chunga ageihole akoho chu thakhat ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ajehchu chuche ageipehle akoho chunga chun ahithei bang bangin Cherub ho, keipiho, tumthingho lim achonsah-in, akimvela ajephoina aumsoh keijin,
  </para>
  <para style="p">
    <verse number="37" style="v" />Hiche tobang cheh hin tunsonna som abolin; abona pumkhatna kisung ahicheh-in, tena thakhat, alet thakhat cheh ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chujouvin kisilna belson sum engin asemin, kisilna bel khatnin twitena dim somli adolin; bel jouse chu tongli cheh ahin, tunsonna som chunga kisilna bel khat akitung cheh-e.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule tunsonna nga houin jetlama atungin, ngama houin veilama atunge. Chule twibem chu houin jet lama niso lamngan atungin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Hiram'in kisilna belho, vutloho, maiphet kongho asemin ahi. Chutichun Hiram'in Pakai houin'a dinga Solomon'in asemsah ho jouse chu ajousoh heltan:
  </para>
  <para style="p">
    <verse number="41" style="v" />Khomni, khom ni chungvum alujum chunga kisem twithol teni, chule khom teni chungvuma alujum teni-a twidol tobang kikoi khuna-a kisem lenvang ni;
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule chuche lenvang dinga kibol kolbuthei jali, khomteni chunga twidol khuna ding lenvang khatna kolbuthei vui ni;
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule tunsonna somle tunsonna chunga kisilna bel som,
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule twibem khatle twibem noija bongchal somleni,
  </para>
  <para style="p">
    <verse number="45" style="v" />Belho, vutloho le maiphetna kongho, chule kongle belho jouse, Pakai houin'a dinga Solomon lengpan Hiram asemsah hochu sum-eng duljet cheh ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jordan phaicham, Succoth le Zarthan kikah leilai mun'a lengpan hicheho chu asun sah ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule kongle belhochu atam behseh jeh-in Solomon'in telouvin amoh koitan, sum-eng gih jong hetsoh jouhoi ahipoi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule Solomon'in Pakai in'a um kong leh bel jouse asemin: sana maicham le vetsahna changlhah koina sana dokhang,
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule houna mun masanga kikoi thaomei khom; jetlama nga, chule veilama nga, pahchaho leh meivah ho chule sana cheichaho,
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule khonho, meivahpon, chena ho, maiphetna kongho, thihkheho, sanatheng sela kisem lhengho; insung gilla muntheng pentah kotkhah ho le houin kotkhah ho kibutona ho chu sana ngenin asemin ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chutichun Solomon lengpan Pakai in'a dinga asem jouse chu achaisoh tai. Chuin Solomon'in apa David pehdohsa dangka, sana, chule kong leh bel ho geijin ahin polutnin, Pakai in'a gouho lah-a chun akoitan ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun Solomon'in Israel upaho, phungho jouse upaho, Israel sonho lah-a upaho chu, David khopi Zion'a kona Pakai kitepna thingkhong potou dingin Jerusalem'a akhomin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun Israel mijouse chu lha sagina, Ethanim lha-a kut kibola chun Solomon lengpa henga amaho le amaho ahung kikhomun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun Israel upaho jouse chu ahungun, chule thempuho chun kitepna thingkhong chu apuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amahon Pakai kitepna thingkhong, houkhomhole houbuh pon, chule houbuh-a um kong leh bel thengho chu ahin potouvun; hicheho jouse chu thempuho le Levi hon apotouvun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Solomon lengpa le Israel mipi kikhomho, ama henga hung kikhomho jouse chu amatoh kitepna thingkhong masanga aumuvin; kelngoile bongchal atamval jeh-a simjou hilou le ajat hetthei jouhoi hilouvin ganlhaina aneijuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule thempuhon Pakai kitepna thingkhong chu aumnading mun, insunggil houna mun, muntheng pentah sung, Cherub teni lhaving noija chun akoi taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Cherub teni chun kitepna thingkhong umna chung chu alhateni ajahkhuma, Cherub teni chun kitepna thingkhong le achunga moljol teni chu ahop sohkei ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule moljol teni chu agasao doh-in, houmun masang munthenga konchun akimu phan ahi, ahin polama konin vang akimupoi; chule hichu tunichan geijin chua chun aumjingin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kitepna thingkhong sunga chun Egypt'a kon ahung potdoh laijuva, Pakaiyin Israel chate toh kitepna anei laija, Mosi'n Horeb molsanga anakoi songpheng ni tailou imadang aumpon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, thempuho munthenga kona ahungdoh phatnun, Pakai in chu meipin ahinkhu dimtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun thempuho chu meipi jeh-in kinbolin adingthei tapouve. Ajehchu Pakai loupina-in Pakai in chu alodim sohtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Solomon'in hitin aseije, Pakaiyin muthim satah-a chu kaumding ahi ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman tahbeh-in nachen nading in kasah peh-in, Tonsotna naum nading mun kasahpeh-e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin lengpa akile heijin, Israel houkhom ho jouse chu phatthei aboh-in, (Israel houkhom ho jouse chu ading sohkeijun ahi.)
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman, Israel Pakai Pathen chu nunnom hen, aman kapa David henga akam ngeijin anaseijin, akhut ngeijin asubulhitnin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman kami Israelte Egypt gama kona kapuidoh nikho-a pat, kamin umna ding in sah nadingin Israel namjouse lah-a khopi khatcha jong kanalheng khapon; ahinla kami Israelte chunga vaipodin David kana lhenge, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti chun kapa David'in Israel Pakai Pathen min dinga in sah ding chu alungelin anatupmin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin Pakaiyin kapa David jah-a, nalung gillin kamin dinga in sah ding natup lheh-in, hitobang lung naput hi aphalheh-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeng jongle nangman in chu nasah louding ahi; amavang nachapa, nataiguija hung pengdoh dingchun kamin dinga in chu asah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin athusei chu asudetnin, Pakai thutan bangin kapa David munchu kahinlotan, Israel laltouna-a chun kahung toutan, Israel Pakai Pathen min dingin in chu kahin satan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hia chun, Egypt gama kona ana puidoh laija, Pakaiyin ipu ipateu to ana kitepna, hiche thingkhong umna ding mun chu kagongin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Solomon chu Pakai maicham masang, Israel houkhom ho jouse masanga adingin, van lama akhut ajahdoh in:
  </para>
  <para style="p">
    <verse number="23" style="v" />Vo Pakai, Israel Pathen, nasohte alung pumpiuva nangma masanga lamlhaho henga akitepna le khotona musah-a, nangma tobang Pathen himhim chunglam van'a le noilam leija aumpoi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangman nasoh kapa David nathutep jouse nanit in; nangman nakamin thu naseijin, tunia banghin nakhutnin naguilhun sah-in ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun tun, Israel Pakai Pathen, nasoh kapa David henga nanasei, nangma kamitmu-a nalam lhah banga, nachate achih theijuva alamlhah uleh, Israel laltouna-a keima angsunga touding losam ponte, tia naseichu nitnin.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule tun, vo Israelte Pathen, katao ahi, nangman nasoh kapa David henga nanaseisa chu sudet teijin.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeng jongle Pathen chu leija hin acheng mong nadem? vetan, vanle vanho van'in nadol joulou ahin; ka houin sah hi ichana lhasamjo hitam?
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin, vo Pakai, ka Pathen, nasoh taona le thumna hi nei jabolpeh-in lang; nasoh tunia ataona, nahenga angehna le ataona hi ngaipeh-in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hitia chu hikoma hi kamin umding ahi tia nanaseina mun, hiche houin lam hi namitnin sunle jana avet jinga, chutia chu nasoh-in hiche houin munlam nga-a ataona nangaipeh theina ding kati ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule nasoh, chule nami Israelte ngehna ngaipeh inlang, hiche munlam nga-a atao tenguleh; nachenna mun van'a konin ngaipeh inlang, chule najah teng, ngaidamin.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khattouvin aheng akom chunga asuhkhella, acham louva kihahsel dinga auma, hiche houin'a maicham masanga kihahsel dinga ahungleh;
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuteng nangman van'a konin ngaipeh inlang, kipanin, nasohte thu tanpeh-in; migilou chu anatoh lampi chu aluchunga chuhsah inlang, chule michonpha chu achonphatna dungjuijin themchan sah-in.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nami Israelte hin nang douna-a achonset jeh uva, melmate anga vohlhuh a aumuva; chuteng nangma lam ahin ngat kitnuva, namin aphondoh uva, hiche houin'a hi taona le ngehna aneijuva ahileh,
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuteng nangman van'a konin ngaipeh inlang, nami Israelte setna chu ngaidamin, chule apu apateu napehna gamsunga lepui kitnin.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nangma douna-a achonset jeh uva van akikha-a, go ajuhlou teng, hilam nga ataovuva, namin aphondoh uva, chule nangman amaho nabolgenthei jeh-a achonset naova kona alungu aheijuva ahileh,
  </para>
  <para style="p">
    <verse number="36" style="v" />Chutengle nangman van'a konin ngaipeh inlang, achenadiu lampipha nahila, chule namite goulo dinga napehna gama hi go najuhsah nadingin, nasohte le nami Israelte setna chu ngaidamin.
  </para>
  <para style="p">
    <verse number="37" style="v" />Gamsunga kel alhah-a, hise alanna, huise, thingtam, khaokho, ahiloule lungmul alana, amelma teovin akhopi houva aumkol uva, itobang suhgamna le itobang natna ahunglhuna ahijongle,
  </para>
  <para style="p">
    <verse number="38" style="v" />Khat touvin, ahiloule nami Israelte jousen, itobang taona hihen, itobang ngehna hijongle, alungsunga hahsat nei ahi akihetna, hilam nga-a akhut ahin jah-a ahile;
  </para>
  <para style="p">
    <verse number="39" style="v" />Chutengle nachenna mun van'a konin ngaipeh inlang, ngaidamin, kipan inlang, mitin alamlhah dungjui cheh le alung gelu nahet bangin lethuh-in, (ajeh chu nangma jengbou mihem chapate lungsung he-a nahi.)
  </para>
  <para style="p">
    <verse number="40" style="v" />Chutiachu nangman kapu kapateu napeh gamsunga hi achenlai seuva nangma nagin theidiu ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chukalvalin, nami Israel hilouho gamdangmi, namin jala gamlatah-a kona hung kalsongho chungchanga;
  </para>
  <para style="p">
    <verse number="42" style="v" />(Ajehchu namin kithangtah le nakhut thahat tah, chule naban najahdohna chu ajah dingu ahin;) hiche inlam nga-a ahunga atao tengle;
  </para>
  <para style="p">
    <verse number="43" style="v" />Nami Israelte banga leiset mijousen nangma nagin theina dinguva namin ahetnuva; hiche ka insah hin namin apui ti ahet theina dinguvin, nangman nachenna van'a konin ngaijin lang, gamchom mihon athum bangu chun bolpeh-in.
  </para>
  <para style="p">
    <verse number="44" style="v" />Namite nangman nasol nalam lama amelmateu satdinga acheuva, chule nalhentum khopi lam leh, namin dinga kasahpeh hiche in lam nga-a Pakai henga ataovuleh;
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuteng nangman van'a konin ataonao le angehnao ngaipeh inlang, chule athu uchu gelpeh-in.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nangma douna-a achonsetnuva, (ajehchu koima chonselou aumpoi,) achunguva nalunghanna, melmate khutna napeh doh-a, amahon gamlatah ham ahiloule naicha gal hinga akai manguva;
  </para>
  <para style="p">
    <verse number="47" style="v" />Gal hinga akikai mangnao gama akingaito doh uva, akisih uva, chonset kabolun, lamvaijin, khangitlouna kaboltaove, tia gal hinga akaiteu gamachu nahenga thumna ahin neijule,
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule chutia chu nahenga alung pumpiule alhagao pumpiuva gal hinga kaimanga aumnao, amelmateu gama kona, apu apateu napehna gam, nalhentum khopi, namin dinga kasahpeh houin lam nga-a ahung kileheijuva ataovule;
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuteng nangin nachenna mun van'a chun ataonao le angehnao ngaipeh inlang, athu uchu gelpeh-in.
  </para>
  <para style="p">
    <verse number="50" style="v" />Namiten nangma douna-a chonset abol jouseule, nangma douna-a khangitlouna aboljouseu chu ngaidamin; chule soh-a akaimang houvin khotona aneitheina diuvin, a-angsunga khotona musah-in.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ajehchu amaho Egypt gama thih meikonga kona nahin puidoh, nangma mite le nagoulote ahiuve.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chutia chu nasoh ngehna le nami Israelte ngehna lama hi namit nahasah-a, chule nahenga atao chanuleh nangaipeh ding ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ajehchu vo Pakai Pathen, nangman kapu kapateu Egypt gama kona napuidoh laija, nasoh Mosi-a kona nasei banga, nagou lodinga vannoi mijouse lah-a kona amaho chu nakhendoh anahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chule chutichun Solomon'in Pakai henga taonale ngehna jouse achai phatnin, Pakai maicham masanga adilsuh na-a konin, akhut teni-a vanlam sangpumin ahung dingdoh tan ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin adingin, Israel houkhom ho jouse chu aw gingtah-in phatthei aboh-in, hitin aseije;
  </para>
  <para style="p">
    <verse number="56" style="v" />Athutep dungjuija ami Israelte olna pepa Pakai chu nunnom hen, asoh Mosi khutna athutep phajouse chu thucheng khatcha athon aumpoi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Pakai i-Pathen'un ipu ipateu anaumpi bangchun, eiho jong eiumpiu hen; Aman eidalha hih-u henlang, nungjong einungsun hih-u hen,
  </para>
  <para style="p">
    <verse number="58" style="v" />Chutile alampi jouse jotdingle, iputeu thu anapeh banga athupeh ho, adanthuho, athutanho nitna dinga ilungthimu ama lama eiheilut peh dingu ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chule phattina asohte ngaichatna le ami Israelte angaichat dungjuija angaitopeh theina dingin, Pakai anga kangehna hiche thucheng hohin, asun ajanin Pakai i-Pathen koma umjing hen;
  </para>
  <para style="p">
    <verse number="60" style="v" />Chutia chu leiset mijousen Pakai chu Pathen ahin, adang khatcha aumpoi ti ahet dingu ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Hijeh chun tunikho-a banghin adanthuho mangdingle, athupehho nitdingin, Pakai i-Pathen'u henga nalungthimu phachamkim hen, ati.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chuin lengpa le aumpi Israelte jousen Pakai masanga ganlhaina apeuvin ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chuin Solomon'in chamna thiltoho, ganlhaina Pakai henga atochu, bongchal sangsomni le sangni, chule kelngoi sangjakhat le sangsomni ahi. Hitichun lengpa le Israel chate jousen Pakai in chu athenso taovin ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Hiche nikho chun lengpan Pakai in masanga um hongcha lailung chu asuthengin ahi; ajehchu aman govam thiltoho, anneh thiltoho, chule chamna thiltoho thao chu atoh-in ahi: ajehchu Pakai masanga um sum-eng maicham chu govam thiltoho, anneh thiltoho chule chamna thiltoho thao sanna dinga chu neo behset ahi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chuin hiche petchun Solomon le Israelte jouse, Hamath kho lutna-a pat Egypt vapi geija houkhom mipi tamtah ho chun, nisagi, chule nisagi ma, ni somle nili sungin kut abolun ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Anigetnin mipi ho chu asolmangin, chule amahon lengpa chu phatthei aboh-un; Pakaiyin asoh David dingle ami Israelte dinga aphatna jehchun aponbuh lamuvah kipahtah le lungkipah tah-in achetauve.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Solomon'in Pakai in le leng in, Solomon'in ama lunglhaina bangtah-a boldinga atup jouse chu aboljou phatnin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuti chun Gibeon'a ahenga akilah bangchun, aniveinan Pakai chu Solomon henga ahung kilah-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakaiyin ahenga, ka-anga nataona le nathumna chu kangaipeh tan; a-imatih chana kamin umna dinga nasah hiche in hi kasu thengtan, kamit teni le kalungthim hia chu umjing ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nangma jong kathupeh jouse bangle napa David umchan banga, lungthim dihtah le chondih tah-a kamit mua na-uma, kadan thuho le kathutanho najui jinga ahile,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutengle Israelte laltouna-a touding mi kisudong ponte tia napa David henga kana kitepna bangin, Israel chunga nalenggam laltouna chu a-itih-a dinga kaphudet ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amavang nangma le nachaten keima neijui naova kona nakihei manguva, najuidaova na-ang uva kakoi kathupeh ho le kachonna dan kisunho najuidaova, pathen dangho kin nagabol uva, nagahou vuleh,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutengle keiman amaho kapehsa gama kona chu Israelte chu kasuhmang ding; chule kamin dinga kasuhtheng hiche in hi kamitmu-a kona kapaidoh ding, chule Israel hi mijouse lah-a thuchih le paochamtuh-a pangding ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hiche in hi, kichoisang tah hijongle, ajotpa jousen adatmouva, akhoisat khumdiu; iti dana Pakaiyin hiche gamsung le hiche in hi hititah-a abol hitam? atidiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amahon, Pakai a-Pathen'u, apu apateu Egypt'a kona puidohpa chu adalhah uva, pathen dangho akolchah uva, ahou uva, akinu aboltah jeh-uva Pakaiyin hiche thilse jousehi achunguva alhunsah ahi, ati dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Solomon'in in ni, Pakai in le leng in asah kum somni akichaijin, ahitin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />(Tun Tyre lengpa Hiram'in Solomon chu cedar thingho, chahthingho, sanaho, angaichat dungjuijin apen,) chule Solomon lengpan Hiram chu Galilee gama khopi somni apen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Hiram Tyre'a konin Solomon'in apeh khopiho vedin ahungdoh-in, ahin hicheho chu alunglhaina ahipon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman kasopipa, nangman neipeh hohi itobang khopi bepseu hitam? ati. Chule aman hicheho chu Cabul gam asah-in, tuni geihin akisahden tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Hiram'in lengpa chu sana talent jale somni athotnin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Solomon lengpan natong honkhat asemlona ajehchu hiche ahi: Pakai in le ama in chule Millo sah nading, chule Jerusalem, Hazor, Megiddo, chule Gezer kulbang sahna ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Egypt lengpa Pharoah chu achetouva, Gezer khopi agalah-a, hichu meijin ahala, chule khopi-a cheng Canaan miho chu atha gama, achanu, Solomon jinu chu kipaman thilpeh dinga apeh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Solomon'in Gezer le Beth-horon lhangnung chu asan,
  </para>
  <para style="p">
    <verse number="18" style="v" />Baalath chule chuche gamthipma Tadmor,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Solomon'in anei thilkhopna khopiho jouse, akangtalai ho ding khopiho, asakol chung touho ding khopiho, chule Solomon'in Jerusalem le Lebanon, chule ama gamvai pohnaho sunga sahdinga agot chanchu asaovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Israel chate hilou, Amor mite, Hit mite, Perizz mite, Hiv mite, Jebus miteho-a kona kidalha mijouse,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche gama amaho nunga kidalha-a achateu, Israel chaten jong asuhmangsoh joulouho chu, hicheho chunga chun tuni chanin Solomon'in hunama soh natongin anasemin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israel chate vang Solomon'in soh-in anasempon, ahinla amaho chu galbol mi, ama lhachate, ama pipuiho, agal lamkaiho, chule kangtalai ho le sakol chung touho vaipon apansah-in ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichehohi Solomon natohna chunga pipui dehho ahiuvin, nakitoh na-a mipi ho chunga vaipoho chu janga le somnga ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla Pharaoh chanu chu David khopi-a konin Solomon'in amanu dinga in asahpeh-a chun ahungtoutan ahi. Chuin aman Millo chu asan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pakai dinga asem amaicham chunga chun Solomon'in kumkhat sungin govam thiltoho le chamna thiltoho thumvei atohjin, chule Pakai masanga um maicham chunga chun namtui ahalin ahi. Hitichun houin chu ajoutai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Solomon lengpan Edom gama, Twipisan pang, Eloth koma um, Ezion-geber mun'a chun kongho asemin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Hiram'in asohte, twipi lampanga thepna neiho chu Solomon sohte toh natongkhom dingin, kong khatna ahin solin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin amaho chu Ophir'a ahungun, chua konchun sana talent jali leh somni ahin lapaovin, hichu Solomon lengpa henga ahinpouvin ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakai min chungchanga Solomon minthanje chu Sheba lengnun ajah phatnin, thudoh hahtahho to achihna phochendin ahungin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amanu anungjui tamtah toh, sangongsang ho-a gimnamtui ho, sana tamtah, song mantam tamtah po pumin Jerusalem'a ahungin; chuin amanu Solomon henga ahunglhun phatnin, alungsunga umjouse a chun ama akihoupitan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Solomon'in amanu thudoh jouse chu adonbutsoh keijin, amanu aseipehlou lengpa-a kona kisela thil imacha aumpon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Sheba lengnun Solomon chihnaho jouse, chule a-insahho;
  </para>
  <para style="p">
    <verse number="5" style="v" />Adokhanga annehho, asohte toudanho, chule ajenho umjedan hole akivondan hou, chule akhon domho, chule Pakai in'a achetouna lampiho amuphatnin, lunggel dang himhim aneitapoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amanun lengpa jah-a, nanatoh ho le nachihna kagam lama kanajah chu thuthang dihtah mong ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin keima kahunga, kamit tah-a kahungmu kahsen, thuho chu kana tahsanpoi; chule vetan, akehkhat jong einahil pouve. Nachihna le naphattouna hin thuthanga kanajah chu akhokhelin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na anga tanglouva dingjinga, chule nachihna thu ngaijinga namite le nasohte hi anunnoma ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangma-a kipah-a, Israel laltouna-natousahpa, Pakai na Pathen chu nunnom hen; ajehchu Pakaiyin Israel hi tonsotna angailut ahin, hijeh-a chu dihtah-a thutan dinga lenga natun ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanun lengpa chu sana talent jale somni toh, gimnamtui tamtah le, songmantam ho apen; Sheba lengnun Solomon lengpa gimnamtui apeh, sanga tamjo ahung lutbe khatapoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Ophir'a kona sana hinpo-a Hiram konglen jongchun, Ophir'a konin almug thingphung ho le songmantam ho ahinpon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin lengpan almug thingho chu Pakai in le leng in'a khompiho ding, chule lasaho dinga selangdahle tumgingho semnan amangin; chutobang almug thing himhim chu ahunglut tapon, tugeijin mujong akimukit tapoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Solomon lengpan Sheba lengnu chu angaichat chanle athumchan apen, chuche tailouvin Solomon'in athumlousan hongphal tah-in apei. Chutichun aumna gamlama amanule asohte akiletaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun Solomon henga kumkhat sunga sana hunglut chu agih talent jaguple somgup le gup ahin,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche tiloujong chun aman sumkolvei mihole thiljoh ho, chule Arabia gama lengho jousele gamsung vaipoho aneijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Solomon'in sana kikheng peh-in lumdal lentah jani asemin, lumdal khatna chu sana shekel jagup lutna kisem ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule sana kikhengpeh lumdal jathum asemin, lumdal khatna chu sana mina thumthum lutna kisem ahi. Lengpan hicheho chu Labanon gamthipma in'a chun akoijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chukalvallin lengpan saiha laltouna lentah khat asemin, hichu sana phapen twi alonkhumin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laltouna chun kalbi gup aneijin, laltouna chungvum nunglam chu akikolin, atouna sihteni-a chun ban ngapna aumgelin, ban ngapna panga chun keipi bahkai ni adinge.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule kalbi gup chunga asih langto-a chun keipi bahkai gupcheh, alangtoa somleni adingin; chutobang chu koimacha lenggama akisem khapoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Solomon lengpa twi donna khonho jouse jong sana ngen ahin, chule Lebanon gamthip in'a kongle beljouse jongchu sana theng ngen ahi. Dangka-a kisem khatcha aumpoi; Solomon nikholaijin dangka chu imachan akigelpoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu lengpan twipia chun Hiram kong inneiho le Tarshish kong inneiho aneijin; Tarshish kong inneiho chun kumthum halin sana dangka, saiha, jongho chule vahongho ahin pojiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutichun Solomon lengpan leisetna lengho jouse chu haonale chihnan nasatah-in akhelsoh keijin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Pathen'in alungsunga akhumpeh chihna thu ngaidingin, leiset pumpin Solomon ahol holjin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amaho amitakipmin thilpeh ahinchoijun; dangka kongle belho, sana kongle belho, vonho, galvonho, namtuiho, sakol ho chule sanganho, kumtin in abineija ahin peuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Solomon'in sakol kangtalai ho le sakol touthemho akhom khommin, chule sakol kangtalai sangkhat le jali, sakol touthem sangsom le sangni aneijin; hichehochu kangtalai koina khopiho le Jerusalem'a leng umna-a chun aumsah in ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule lengpan dangka chu Jerusalem'a song bolin abolin, chule cedar thingchu atamjeh-in phaichama theiba thing bolin abole.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Solomon'in Egypt gama kona hung kipodoh sakolhole tupat ponnel ho aneijin; lengpa sumkolvei ho chun tupat ponnel chu aman apeh uva achohjiu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sakol kangtalai khat Egypt'a kona hungtouva potdoh chu dangka shekel jagup man ahin, chule sakol khat chu jakhatle somnga man ahi. Chuti chun Hit lengho le Syria lengho din ahin toldohpeh jiuvin ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla Solomon lengpan gamdang numei tamtah adeichatan, Pharaoh chanutoh kigomin, Moab numei ho, Ammon numei ho, Edom numei ho, Zidon numei ho chule Hit numei ho;
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin Israel chate jah-a, ahenguva nachelou dingu, amahojong naheng uva hunglou diu ahi; ajehchu thonlouva amahon nalungthimu a-pathen lamuva aheikoi dingu ahi; anatina miho chu Solomon'in ngailutna-in akolchahtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun aman leng chanute jasagi ji-in aneijin, chule thaikem jathum aneijin; ajiten alung ahei mangpeh taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu ahitin ahi, Solomon ahungteh phatnin, ajiten pathen dangho lama alung aheikonpeh-un, chule apa David lungput bangin Pakai a-Pathen lama alungput aphachamkim tapon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Solomon'in Zidon mite pathen Astorath, chule thet umtah Ammon mite pathen Milchom lama chun akiheitan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Solomon'in Pakai mitmun thilse ahinboltan, apa David bangin Pakai chu ajui bukim tapoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun Solomon'in Jerusalem masang lhanga chun thet umtah Moab mite Chemosh dingle, thet umtah Ammon chate Molech dingin munsang khat asemin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutobang machun gamdang numei ajite jouse pathenho dingin gimnamtui halna le ganlhaina aseme.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakai Israel Pathen, ahenga niveijen kilahpa-a kona akiheimang jehchun, Solomon chunga Pakai alunghang tan,
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman pathen dang ahoulou nadinga, hiche thudola hi thu anapehsa ahin; ahinla aman Pakaiyin ana thupeh chu anitpon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Pakaiyin Solomon henga, hitobang tah-a hi na-uma, nangma kathupeh kathulhun le kachondanho nanit loujeh-in, lenggam chu thonlouva kabotela nasohpa kapeh ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahijeng vangin napa David jal-in nahin sungin bolponge; ahinla nachapa khutna kona kalhe khending ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeng jongle lenggam jouse chu lhehkhen pongting, kasoh David jal leh kalhentum Jerusalem jala phungkhat vang nachapa kapeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Solomon doudingin Edom mi Hadad chu ahintildoh-in, amachu Edom leng chilhah ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu ahitin ahi, David Edom gama auma, janel gal lamkai Joab chun Edom gama pasal takip atha nungin, amithaho vuidin ache touvin ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />(Ajehchu Edom pasal takip athagam soh kahseuvin, Joab chu chua chun Israelte jousetoh lhagupjen aga umun ahi,)
  </para>
  <para style="p">
    <verse number="17" style="v" />Hadad chu apa sohte lah-a Edom mi phabep toh Egypt gama dingin ajamun; Hadad chu chapang neocha bou ahinalaije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaho Midian gama konin akipat doh-un, Paran'a ahungun; Paran'a konin mi akipuijun, Egypt gama, lengpa Pharoah henga ahungun; amachun in apen, nehlechah angaitopeh-in, gamjong anapen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Hadad chu Pharoah mitmun lungsetna lentah achangin, chutichun amatah jinu sopinu, Tahpenes lengnu sopinu chu ajidin apen ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahpenes sopinu chun chapa Genubath ahinpeh-in, amachu Tahpenes'in Pharoah in'a noichep abansah-in; Genubath chu Pharoah insungmi, Pharoah chapatetoh alhakhomin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Hadad'in Egypt gama konin, David chu apu apatetoh alumkhom tan, chule sepai vaipipo Joab athitai ti ajah phatnin, Hadad'in Pharoah henga, kagamlama kachethei nadin neipotdoh sahtan, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuphatnin Pharoah'in ajah-a, kakoma naumhi ipi lhahsamna naneija, hitia chu phulou helouva nagam lama cheding nagot ham? ati. Chuin aman adonbutnin, imacha kalhasampoi, ahin neichesah pou pouvin, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pathen'in akidoupi chomkhat, Eliadah chapa Rezon, a-pakaipa Zaboh lengpa Hadadezer'a kona jamdohpa atildohpeh kitnin;
  </para>
  <para style="p">
    <verse number="24" style="v" />David'in Zobah kho miho athagam laija chu, amapa hin ahenga mi anakhopma, chule honkhat chunga gal lamkaija hungpanga; chule amaho Damascus'a acheuva, chua chu gachenguva, Damascus'a vaipo-a panga ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Hadad'in thilphalou anabol tilouvin jong, Solomon hinkho lhumkeijin amapa chu Israel kidoupi ahijingin; Israelte aho lheh-in, Syria gamchunga vai ahomin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Zerada kho-a Ephrath mi, meithai khat amin Zeruah kitinu chapa, Solomon sohpa, Nebat chapa Jeroboam jongchun, lengpa dounan akhut alamin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lengpa chunga akhut alapna ajehchu hiche ahi: Solomon in Millo asa-in, apa David khopi aselaiho asemphan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Jeroboam kiti mipa hi hattahle hangsantah ahin; chule Solomon'in chuche gollhang chu miphachom tah ahi ahetjeh-in, Joseph insung natohjouse chunga vaihomin apansah-in ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin chuphat laitah chun ahitin ahi, Jeroboam Jerusalem'a kona apotdoh-a ahile, Shilon mi Ahijah themgaovin amachu lamdunga akimupin; amachun pon thahbeh akivon ahin, chule gamlah-a chu amanibou umlhona ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Ahijah chun achunga pon thahbet-a chun amanin, halsomle halni in abottelin,
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman Jeroboam jah-a, nangman halsom kilah-in, ajehchu Pakai Israel Pathen'in hitin aseije; vetan, keiman Solomon khutna kona lenggam chu kalhekhena, phung som chu nangma kapeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />(Ahinla kasoh David jalle Israel namjouse lah-a kalhendoh khopi Jerusalem jala, namkhat vang aman aneiding ahi.)
  </para>
  <para style="p">
    <verse number="33" style="v" />Ajehchu amahon eida lhaovin Zidon mite pathen nu Astoreth, Moab mite pathen Chemosh, chule Ammon chate pathen Milcom ahouvun, apa David bangin kalampiho ajuipon, kamitmu-a thildih abolpon, kachondan kisunho le kathutanho anitpon ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ipi hitaleh gam pumpi vang akhutna konin lahpeh ponge; ahinla kathupeh ho le kachondan kisunho nitpa, kalhendohsa kasoh David jal-in, ahinlaisen leng khatnin pansah nange.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amavang lenggamhi achapa khutna kona kalah-a, phung somho chu nangma kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule kamin koina dinga kalhentum khopi Jerusalem, kasoh David'in kamasanga a-imatih chana vah aneitheina dinga, namkhat chu achapa kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangma tungdoh-ing kating, nalunggot bangtah-a vai nahom ding, Israel chunga lenga napanding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule hitiding ahin, kathupeh jouse nanitna, kalampiho najotna, kasoh David banga kachondan kisunhole kathupeh ho nanitna, kamitmu-a adih chu nabola ahile; chutichun nakoma umjinging ting, David dinga kasahpeh banga nangma jong insung dettah kasahdohpeh ding, chule Israelte hi kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule hiche jeh-a hi David chilhahte kabol genthei ding ahin, ahinla tonsotna ding ahipoi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hijeh chun Solomon'in Jeroboam thadingin aholtan ahi. Chuin Jeroboam akipat doh-in, Egypt gama Egypt lengpa Shishak henga ajamlutnin, Solomon thi kahsen Egypt'a aumtai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tun Solomon thilbol dangho jouse, anatohho jouse, chule achih naho chu, Solomon thilbolho kijihna lekhabua kisun hilouham?
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule Jerusalem'a Israel pumpi chunga Solomon analengchan sungchu, kum somli anahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Solomon chu apu apate toh alumkhomin, chule apa David khopi-ah akivuitai. Chule Rehoboam achapa chu akhelin alengchang tan ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Rehoboam Shechem'a achen ahi: ajehchu Israelte jouse ama lengchansah dinga Shechem'a hunga ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, Egypt gama umnalai Nebat chapa Jeroboam'in hichu ahinjatan, (ajehchu ama Solomon lengpa-a kona jam-a ahin, chule Jeroboam Egypt gama chenga ahi;)
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitichun amahon ama agakousah taovin ahi. Chuin Jeroboam le Israel mipi ho jouse chu ahungun, Rehoboam henga thu aseijun, hitin aseijuve,
  </para>
  <para style="p">
    <verse number="4" style="v" />Napan kanamkol jonu agihsah behseh-in, hijeh chun tun napa kinbol hahsatahle kachunguva angap anamkoljon gihchu jansah-in, chutile nangma kin bolnao vinge, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman ajah uva, nithum sunga din kikhin kang tadiuvin, chuteng kahenga hungkitnun, ati. Chuin mipi chu akikhin kangtaove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Rehoboam lengpan apa Solomon hinlaija ahenga dingjing upaho chu akihoulim pin, hiche miho kadonbut theina ding thu iti neipeh diuham? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon ajah-a, tunia hiteho soh-a napana, najenna, amaho nadonbutna, chule thungei tah naseipeh-a ahile; amaho a-itih-a nasoh hijingdiu ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla aman tehse hon apeh-u thumop ho chu anot thapmin, amatoh khandohtha-a, amasanga dingjing khangdongho chu adong jotan;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman ajah uvah, kahenga, napan kachunguva angap namkoljon hi jansah-in, tia seija mipi ho idonbut theina dinguva itobang thumop neipeh dingu ham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amatoh khandohtha khangdongho chun ajah-a, nahenga, napan kanamkol jonu agihsah behseh-in, nangman vang jansah dommin, tia seiho koma chu hitia hi naseiding ahi; kamecha hi kapa taibuh sanga sajo ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule kapan namkol jon gihtah nasepeh-u ahin, keiman nanamkol jonu kasebe ding; kapan khaohola najepmu ahin, keiman vang aipi-a kasuhgim ding nahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun lengpan nithum nile kahenga hungkitnun tia anateppeh bangchun, anithumnin Jeroboam le mipi jouse chu Rehoboam henga ahung kitnun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin lengpan mipi ho chu khautah-in adonbutnin, chule tehse hon athumop naochu anot thapmin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule khangthah ho thumop dungjui chun, kapan na namkol jonu agihsah ahin, keiman na namkol jonu kabelap ding: kapan khaohola najepmu ahin, kenvang aipiho-a kasuh gimding nahiuve, tin ahenguva aseitan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu thilsoh chu Pakaiya kon ahin, Nebat chapa Jeroboam henga Shilon mi Ahijah mangcha-a Pakaiyin anaseisa chu tohdoh theina dinga, lengpan mipi ho thusei chu angaipeh lou ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun Israelte jouse chun lengpan athu angaipeh lou amu phatnun, mipi chun lengpa adonbutnun, eihon David'a ipi chan ineijum? chule Jesse chapa-a jong gouloding inei pouve. Vo Israelte, napon in cheh kijotnun; vo David, tun nangmatah in kivetan, atiuve. Hitichun Israel ten apon in cheh akijot taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinala Judah khopiho-a cheng Israel chate chunga vang Rehoboam'in lengvai apotai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin Rehoboam lengpan kaidong vaipo Adoram chu asolin ahile; Israelte jousen songin anasepmun, athitai. Hijeh chun Rehoboam lengpa Jerusalem'a jamdin akangtalaija kinotah-in akaldoh-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun Israel'in tunigei hin David insungmite adouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ahitin ahi, Israelte jousen Jeroboam ahungkit ahet phatnun, mipi kikhomho hengadin akou asolun, Israelte jouse chunga dingin lengin atungtaove. Judah phung tailou David insung nungjuija khatcha aumpouve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Rehobaom Jerusalem'a ahungphatnin, Israel insung kisatpi dingle, lenggam chu Solomon chapa Rehoboam dinga lelahkit dingin, Judah insung jousele Benjamin phunga gal hat hangsan cheh mi sangsom le sangget hel akhomin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla Pathen mi Shemaiah henga Pathen thu ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="23" style="v" />Judah lengpa Solomon chapa Rehobaom hengle, Judah le Benjamin insung mijouse, chule mipi amoho henga chun seijin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakaiyin hitihin aseije; nangho nachetou loudiu, nasopiu Israel chate chu nasat louheldiu ahi; amitakip a-incheh-a kileuhen, ajehchu hiche thil hi keijakon ahi. Amahon Pakai thuchu angaijun, Pakai thu dungjuijin akileuvin akikhen taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Jeroboam'in Ephraim molsanga chun Shechem kho asemin, hia chun achengin; chua konin achedoh-in, Penuel kho asemin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Jeroboam'in alungsunga, tun lenggam chu David insung mite henga kilekit khaget nunte;
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche mitehi Jerusalem'a Pakai in'a ganlhaina bola acheuva ahile, chuteng hiche mite lungthimhi a-pakai pao, Judah lengpa Rehoboam lama kiheijintin, chutengle keima eitha uva, Judah leng Rehoboam lama chekit diu ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuti chun lengpan mi aki thumop sah-in, sana bongnou lim ni asemin, ajah uva, nanghodin Jerusalem kaltou ahahsa behseh-e; vo Israel mite, veuvin, Egypt gama kona nahin puidoh uva na-pathen'u hi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin khat Bethel'a akoijin, khatchu Dan'a akoijin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin hiche thilhi chonset ahunghitai; ajehchu mipichu khatjoh chu houdingin Bethel'a acheuvin, khatjopa houdingin Dan'a ache jiuvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule aman munsanga in asan, Levi chapate hilou, jalhang lah-a minoinungpen hochu thempun apansah-in ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Jeroboam'in Judah gama kut bangin, lhagetna-a chuche nisomle ninga ni chu kut nikho din asudetnin, maicham chunga chun atoh doh-in ahi. Chutichun Bethel'a jong abolin, asem bongnou henga chun ganlhaina abolin ahi. Chutichun aman munsang asem ho-a thempuho chu Bethel'a akoijin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chutichun aman alungdei bangtah-a agot, lhagetna nisomle ninga ni chun, Bethel'a amaicham asemin ahi. Chule Israel chate dingin kut asudetnin, chule maicham chunga chun thilto atoh-in, gimnamtui ahalin ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule veuvin Pathen mikhat Juda gama konin Pakai thusah-in Bethel'a ahungin, Jeroboam chu maicham pangah gimnamtui haldin anadinge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakai thun maicham douna asap khumin, vo maicham, maicham Pakaiyin hitin aseije; vetan David insunga chapa khat, amin Josiah kiti hungpeng ding; nachunga gimnamtui haljia munsanga thempuho nachunga atodoh ding, mihem guho chu nachunga kihalding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hiche nikho mama chun melchihna apen, hichehi Pakaiyin asei melchihna chu ahi; vetan maicham hi khikeh intin, achunga um vutvamhohi kisung lhading ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ahitin ahi, Pathen mipa thusei, Bethel'a maicham douna-a athusei chu leng Jeroboam'in ajah phatnin, man-uvin, tin akhut maichama konin ahinlhangin ahi. Ahin amapa heng lama ahinlhandoh akhutchu agoheltan, hitichun akhut chu aleloi theitapon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen mipan Pakai thua melchihna asei bangchun, maicham jongchu akhikeh-in, meivamho chu maichama konin akisung lhatai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin lengpa chun adonbutnin Pathen mipa jah-achun, kakhut hi ahungdamkit theina din Pakai na Pathen maikoh-a neitao peh-in, ati. Chuin Pathen mipa chu Pakai henga ataovin ahile, lengpa khutchu adamkit tan, atila toh ahungbang kit tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin lengpan Pathen mipa jah-a chun, keimatoh in lama hungin lang, hungkichol don, chule keiman kipaman napenge, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pathen mipa chun lengpa jah-a, na in kehkhat neipehding hijongle nangma toh lhonin hung pongting, hikoma jonghin anneh twidon himhim jong bolponge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu changlhah nehih-in, twi himhim jong donhih-in, chule nahung nalam mama-a jong kilekit hih-in, tia Pakai thua thupehsa kahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuti chun lamchoma achen, Bethel jona ahungna lampia chun akiletapoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun Bethel'a chun themgao tehsepu khat achengin, chuin achapate chu ahungun, chuchenia Bethel'a Pathen mipa thilbol jouse chu ahilun; lengpa henga athuseiho jong chu apau ahilun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin apauvin ajah uvah, hoilama che am? ati. Ajehchu Juda gama kona hung Pathen mipa chena lampia chu achapaten anamu-u ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman achapate jah-a, sangan neigon peh-un, ati. Hitichun amahon sangan agonpeh-un, achunga chun atoutan,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathen mipa nunga chu achele gangpi phung noija atou agamun ahi. Chuin aman ajah-a, nangma Juda gama kona hung Pathen mipa chu nahim? ati. Chuin aman kahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman ajah-a, keitoh in'a chehitin an hungnen, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman, keima nangtoh kilethei pongting, nangto jong na-in lutthei ponge; hiche mun'a hin nangtoh anneh twidon himhim bolponge;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu kajah-a Pakai thuchun, hikoma chu an naneh-a, twi nadon louhel ding; nahungna lampia jong nakilekit louhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman ajah-a, keijong nang bang bang themgao khat kahin, chule Pakai thun vantil khatnin kajah-a, aman an aneh-a, twi adonthei nadin na in'a hinlepuitan eiti, ati. Ahin aman ajou asei ahibouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun ama amapa chutoh anungchen, a-in'a an anen, twi adontan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ahitin ahi, amani dokhang phunga agatou lhona ahile, ama lepui themgaopa henga chun Pakai thu chu ahung lhungin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Juda gama kon Pathen mipa jah-a chun ahin samdoh-in, Pakaiyin hitin aseije, Pakai kamsung thu ngailouva, Pakai na Pathen'in nathupeh nanitda-a,
  </para>
  <para style="p">
    <verse number="22" style="v" />Nahung nung hunga, Pakaiyin nahenga an nehih-in, chule twi jong donhih-in atinamuna, an naneh-a, twi nadon jeh-in; nalonghi napu napate lhan hunglhung louhel ding ahi, atin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ahitin ahi, aman an aneh jouva, twi adonjou phatnin, themgao ahin lepuipa chunn sangan agonpeh-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ama achephatnin, keipi bahkai khatnin lampia ana kimaito pin, athat tai. Chule along chu lamdunga selhah-in aumin, sangan chu akoma adingin, keipi bahkai jongchu thilong koma chun adinge.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin veuvin, mihon ahin jotpaovin, chule lamdunga along kiseplha-a, keipi bahkai thilong koma adinchu amuvin ahi. Chuin amaho ahungun themgao tehsepu chenna khopi-a agasei taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin lampia kona galepui themgao chun ajah phatnin, Pathen mi, Pakai thusei ngailoupa chu ahije; hijeh-a chu Pakaiyin ahenga asei athu bangtah-a, Pakaiyin keipi bahkai apeh doh-a, keipi bahkaijin amaltela atha ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman achapate jah-a, sangan neigotpeh un, ati. Chuin amahon agotpeh taove.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ama achen ahile along lampia kiseplha chu agamun, chule sangan le keipi bahkai akoma adinlhon chu amun ahi. Keipi bahkai chun thilong chu anepon, sangan jongchu abot telpon ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin themgao chun Pathen mipa long chu adomin, sangan chunga akoijin, ahinlepoh tai. Chule themgao tehsepu chu lunghem dingle avuidin khopi-a chun ahunge.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman thilong chu amatah lhanna alupsah-in; ohe, kasopipa! tin achunga alunghem uvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin ahitin ahi, ama avuijou phatnin achapate jah-a, keima kathiteng Pathen mipa kivuina lhan nahin neihin vuijun lang, ama gu koma kagu hinkoijun, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu Bethel maicham chungle Samaria khopi-a um munsanga in jouse douna-a Pakai thua anaseidohho chu hung guilhung teiding ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hicheng thilsoh nung jonghin Jeroboam setna lampia konin akilehei dehpon, ahinla minoinung dehho chu munsang ho thempun asemin; anomchan aman asuthengin, amatah munsang ho thempu khatnin apangin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hiche thilhohi Jeroboam insung dinga chonsetna, kisuhgamna, chule leisetna kona suhmang helna ahung hitai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche laichun Jeroboam chapa Abijah adampon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jerobaom'in ajinu jah-a, nahenga katao ahi, kipat in lang Jerobaom jinu ahi ti ahetlouna diuvin na-umdan khelin lang, Shiloh'a gache temin; ven, hia chun Ahijah themgao, hiche miho chunga lenga kahungpan ding kachung chang thuseipa chu aume, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule changlhah somle changlhah lum neocha cha, chule khoiju haikhat kenginlang ahenga gachen; aman chapang umdan ding nahinhil teiding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jeroboam jinun chutichun abolin, akipatnin, Shiloh'a achen, Ahijah in'a ahungtai. Ahin Ahijah chun atehjeh-in kho amutheipoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin Ahijah henga, ven, Jeroboam jinu nahenga achapa dinga thilkhat thumdingin ahunge, ajehchu ama adamlou ahi. Chule hitiding ahi, amanu ahunglut tengle, numei dangho bangtah-a hung umding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, Ahijah'in amanu kotphung ahunggeija akhodap gin ajah phatnin, amanu jah-a, nangma Jerobaom jinu hunglutnin; ibolla midang kihisah-a nahim? ajehchu keima thuhil phaloutah hildinga nahenga eikisola ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chen, Jeroboam jah-a gaseipeh-in, Pakai Israelte Pathen'in hitin ati, ajehchu mipi ho lah-a kona kachoisanga, kami Israelte chunga vaipo-a kapansah-a,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule David insunga kona alenggam kalhe khena, nang kapeh nahin; ahivangin nangma kathupeh ho nitna, chule kamitmu-a adih jeng bolna dingin alungthim pumpi-a eijuija, kasoh David bangin na-umpon;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin nangman keima lunghansah nadingin, namasanga mijouse sangin thilse nabol dehsetne; ajehchu nachen Pathen danghole milim kilhajol nakisemin, nanung lama neipaitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun vetan, keiman Jeroboam insung chunga thilse kalhunsah ding, chule Jeroboam'a kona pasal tapou akihen hihen, ongthol hijongle, Israel gamsunga kona kasuhmang ding; chule Jeroboam insungmi ahingdoh amoh chengse chu, min eh abeikahse atheh banga katheh ngim ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jerobaom insungmi khopi sunga thitapou chu ui jin aneh ding, gama thitapou chungleng vachaten anehdiu ahi; ajehchu hichu Pakai seisa ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun kipat in, na inlama chetan; khopi sunga nakho nalhah lutlutleh chapang chu thiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutia chu Israel jousen apul adouvuva, avuidiu ahi. Ajehchu Jeroboam insung mi amabou lhana kivui hiding ahi, ajehchu Jeroboam insunga amabouhin Israelte Pakai Pathen lama phatna themkhat aneijin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chukal vala Pakaiyin Jeroboam insung sumang dinga Israel chunga lengkhat atundoh ding; tujenga jong, ahile itiding hitam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu Pakaiyin twilah-a peng kilingling banga Israel ajepding, chule Pakai lunghansah nadinga milim akisemthu jeh uva, aman Israel chu apu apateu anapeh hiche gam phatah-a kona hi abodoh-a, chule vadunglen gala athecheh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jeroboam chonset naho jehle chonset anabola Israel achonsetsah jeh-a, aman Israel apaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jeroboam jinu akipat doh-in, apotnin, Tirzah ahunglhung tai. Chuin kotbul kempum agaphah phah-in chapang chu athitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amahon avuitaovin; Pakaiyin asoh Ahijah themgao henga anasei, Pakai thu dungjui chun avuijun, Israelte jousen apul adoutaove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jeroboam thilbol adang jouse, gal iti asatna, lengvai iti apoh thuho chu, veuvin, Israel lengte thusimbua hihochu akisunin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jeroboam lengchan nikhoho chu kum somni le kumni ahi. Chuin ama apu apate toh alumkhomin, achapa Nadab chu ama khelin alengchang tai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Solomon chapa Rehoboam Judah gama aleng changin ahi. Rehoboam ahung lengchan patchun kum somli le kumkhat ahitan, Pakaiyin amin umna dinga Israel phung jouse lah-a kona analhentum khopi Jerusalem'a chun kum somle kumsagi aleng changin ahi. Anu minchu Naamah ahin, Ammon mi ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Judah te chun Pakai mitmun thilse abolun, apu apateu jouse sanga chungnung-jo-a chonset abolnaova chun, Pakai chu thangsetna dingin achoh thouvun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu amahon munsang jouse, chule thinghing phungnoi tinna munsang ho, milimho, khomho, chule thinga kisem milim atungdoh-un ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule gamsunga chun Sodom mijong aumun; Israel chate masanga Pakaiyin anapaidohsa thet umtah namho bolbangchu anabolun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Rehoboam lengchan kum ngana-a chun ahitin ahi, Egypt lengpa Shishak chu Jerusalem doudin ahung touvin,
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Pakai in'a gouho le lengpa in'a gouho chu alan, abonchan apomangin; Solomon'in anasem sana lumdal ho chu abonchan apomangtai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Rehoboam lengpan hicheho khelchun sum-eng in lumdal asemin, hicheho chu lengpa kot ngah-a pang, ngahtup pipui khutna apedoh-in ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule hitihi anahi, lengpa chu Pakai in'a achetengle, ngahtup pachun hicheho chu ahinkengjin, chujou tengle ngahtup indan sunga alekoi kitjin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tun Rehoboam thilbol danghole anatoh jouse chu, Judah lengho thusimbu ho-a kisun soh hel hilouham?
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Rehoboam le Jeroboam kah-a chun ahinkho lhumkei lhonin kidouna aumjinge.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Rehoboam chu apu apate toh alumkhomin, apu apateu toh David khopi-a avuitha taove. Chule anu minchu Naamah ahin, Ammon numei ahi. Chuin achapa Abijam akhelin alengchang tai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Nebat chapa Jeroboam lengchan kum somle kumget na-in, Judah gam chunga Abijam aleng changin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama Jerusalem'a kumthum alengchange. Chule anumin chu Maachah ahin, Abishalom chanu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule apan masanga anabol chonsetna jouse-a chun achonin; alungthim chu apa David lungthim bangin Pakai a-Pathen'a apha chamkimpon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeng jongle David khohsahna jal-in Pakai a-Pathen'in ama nunga achapa tundoh nadingle, Jerusalem phudoh nadingin, Jerusalem'a meivah khat anapen ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Hit mi Uriah chungchang tilouvin, David'in Pakai mitmun thildih jeng anabolin, ahin laisen athupeh khatcha-a konin akihei mangpon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Rehoboam chu Jeroboam toh ahin laisen akidou jing lhonin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun Abijam thilbol danghole anatohho Judah lengho thusimbu ho-a kisun soh hel louham? Chule Abijam le Jereboam kah-a chun kidouna anaumin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Abijam chu apu apate toh alumkhomin, David khopi-a avuitaove. Chule achapa Asa chu ama khelin alengchang tai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Israel lengpa Jeroboam lengchan kum somni na in Juda gamsunga Asa aleng changin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule ama Jerusalem'a kum somli le kumkhat alengchange. Anu minchu Maachah ahin, Abishalom chanu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Asa chun apa David'in anabol bangin, Pakai mitmun adih chu abolin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman gamsunga jonthanhoi bolhochu anodoh-in, chule apatehon anasem milim jouse asumang soh-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule anu Maachah, apena anu jengjong Asherah lim anasemjeh-in lengnu ahina ahaisah-in; Asa'in amanu milim chu asumangin, Kidron vapanga ahalvamin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla munsang ho vang asumangpon, ahijeng vangin Asa lungthim chu ahinlai chansen Pakai lama achamkimin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule apan asuhthengsa thilhole, amatah-in apeh thengsaho dangka le sana kong leh bel hochu, Pakai in'a apolutnin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Asa le Israelte leng Baasha kikah-a ahinkho lhungkei lhonin kidou kinahna aumjinge.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Israel lengpa Baasha chu Judah doudin achetouvin, Judah te lengpa Asa henga dinga koima alut le apot aumlouna dingin, Ramah kho asadoh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuphatnin Asa'in Pakai in'a anakidalhaho le lengpa in'a gouho, dangka le sana jouse chu alan asohte khutna apetai. Chuin lengpa Asa chun Damascus kho-a cheng Syria lengpa, Hezion chapa, Tabrimon chapa Benhadad henga chun aseijin,
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima le nangma kikah, kapale napa kikah-a kinoptona aumin, ven, keiman nangma dangka le sana kipaman thilpeh kahinthotne; hungin lang, keija kona apotdoh nadingin, Israel lengpa Baasha toh nakinoptona hungsu keh-in, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Benhadad'in Asa lengpa thu angaijin, Israel khopiho doudingin janel gal lamkaiho asolin, Israel khopiho Ijon, Dan, Abel-beth-maachah, Cinneroth gam pumpi, chule Naptali gamjouse pumin asumangin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ahitin ahi, Baasha'n hiche thuchu ajah phatnin, Ramah'a kho asah banchu adalhan, Tirzah'a achengtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujouvin lengpa Asa chun Judah gam pumpi-a thu athejalin, koimacha ahoi doh-a aumpoi. Baasha'in anasah Ramah'a songhole thingho aphedoh-un, chule hicheho chu Asa lengpan Mizpah le Benjamin gama Geba kho sahnan aneijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Asa thilbol dang jouse, athibol theina jouse, chule anatoh jouse, akhopi sahho chu Judah lengho thusimbu ho-a kisun hilouham? Hijeng jongle ateh lamin akhut akenga natna aneitan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Asa chu apu apate toh alumkhomin, apa David khopi-a apu apate toh avuitaove. Chuin achapa Jehoshaphat'in ama khellin lengvai apotai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Jeroboam chapa Nadab chu Judah lengpa Asa lengchan kal kum nina-in Israelte chunga vaipon apangin,Israelte chunga kumni alengchange.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Pakai mitmun thilphalou abolin, apa lampia achen, achonsetna-a chun Israelte achonsetsah-e.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Issachar insung mi lah-a Ahijah chapa Baasha chun ama dounan thilphalou agongin, Philistine ho gam Gibbethon'ah Baasha'n amachu athat tai. Ajehchu Nadab le Israelte jousen Gibbethon aumkol petnu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Judah leng Asa kumthum channa'in Baasha'n Nadab chu athatnin, amakhelin alengchang tai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, ama alengchan phatnin Jeroboam insung pumpi athatnin; Shilon mi asoh Ahijah henga Pakai thusei dungjuijin, asuh manghel kahsen Jeroboam'a dingin ahingthei khatcha akhenpeh poi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jeroboam'in anabol chonset naho jehle, Israel achonsetsah jeh, chule Israel Pakai Pathen chu asuh lunghang jeh ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tun Nadab thilbol danghole atoh jouse chu Israel lengte thusimbua kisun hilouham?
  </para>
  <para style="p">
    <verse number="32" style="v" />Asale Israel leng Baasha kah-a ahinkho pumpi lhonin kigalna anaum jingin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Judah leng Asa lengchan kal kumthum lhina-in, Ahijah chapa Baasha chu Tirzah'a kum somni le kumli Israelte chunga aleng changin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule aman Pakai mitmun thilse anabolin, Jeroboam lampia chun anachen, aman achonsetna-a chun Israelte achonsetsah-in ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Pakai thuchu Baasha dounan, Hanani chapa Jehu henga ahungin, hitin aseije.
  </para>
  <para style="p">
    <verse number="2" style="v" />Leivuija kona nangma kachoi sanga, kami Israelte chunga vaipo-a kapansah; chule Jeroboam lamlhah najuija, achonset naova eilung hansah nadinguva, kami Israelte nachonset sah dungjuijin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Vetan, keiman Baasha phattheina le a-insung phattheina kasuhmanga, chule Nebat chapa Jeroboam insung banga kasemding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Baasha mi khopi sunga thia chu uichan aneh-a, loujaova thipa chu chungleng vachahon anehdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tun Baasha thilbol danghole, ipi abol, chule athahatna chu Israel lengte thusimbu ho-a kisunlut hilou ham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun Baasha apu apate toh alumkhomin, Tirzah'a avuitaove. Chuin achapa Elah akhelin alengchang tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jeroboam insung tobanga Pakai mitmu-a thilsetah abola, akhutsoh-a Pakai achunga alunghansah jeh, chule amachu atha jeh-in; Hanani chapa Jehu themgaova konin Pakai thuchu, Baasha le a-insung dounan ahung lhungtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah lengpa Asa lengchan kal kum somni le kumgup lhinna-in, Baasha chapa Elah chu Tirzah'a Israelte chunga alengchang panin, kumni alengchange.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin akangtalai kehkhat chunga vaipopa, asohpa Zimri chun ama dounan thil agongin; ama Tirzah'a um ahito lhonin, Tirzah'a a-insung gouchingpa Arza in'a chun ju adonkhamin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Zimri chu agalutnin avon, athatnin, akhelin alengchang tan ahi. Hichu Judah leng Asa alengchan kal kum somni le kumsagi lhinkum ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, Ama ahung lengchan patna, alaltouna chunga atou touchun, Baasha insungmi jouse athatnin; a-insungmi chule agol apaite chapaho pasal tapouchu khatcha khen neilouvin asumangin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun Jehu themgaova kona Baasha chungchanga Pakai thusei dungjuijin, Zimri'in Baasha insung mijouse chu athat gamheltai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu apannabei houva Israel Pakai Pathen alunghansah uva, Baasha chonset naho jousele achapa Elah chonset naho jouse, hiche achonsetna ho-a chu Israelte achonset sah-u anahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun Elah thilbol danghole anatoh jouse Israel lengte thusimbua kisunna hilouham?
  </para>
  <para style="p">
    <verse number="15" style="v" />Judah lengpa Asa lengchan kal kum somni le kum sagi lhinkum chun, Zimri chu Tirzah'a nisagi aleng changin ahi. Chuin mipi chun Philistine gama um Gibbethon dounan gebuh asongun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin gebuh songho mipi chun, Zimri'in thilphalou agongin lengpa jong atha ahitai, tia kisei aja taovin; hijeh chun Israelte jouse chun janel gallamkai Omri chu Israelte chunga chun alengchansah taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Omri le Israelte jouse chu Gibbethon'a konin achetouvun, Tirzah chu aumkimvel taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, Zimri chun khopi chu akilatai ti ahet phatnin, leng inpi sunga alutnin, leng inpi akihal khumin, athitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu Pakai mitmu-a thilsetah abola achonsetnaho jehle, Jeroboam lamlhahho ajotna, achonsetna-a Israel chate achonsetsah jeh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tun Zimri thilbol danghole ami philguhna thuho chu Israel lengte thusimbu ho-a kisunlut hilouham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin Israel mipi chu hopni in akihom khenun; mipi akeh khatnin Ginath chapa Tibni ajuijun, akeh khatnin Omri ajuitaove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin Omri jui mipi ho chun Ginath chapa Tibni juiho chu ajoujovin; hitichun Tibni athin Omri alengchang tai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Judah lengpa Asa lengchan kal kum somthumle kumkhat alhinin, Israelte chunga Omri kum somle kumni alengchang pannin; Tirzah'a kumgup alengchange.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman Samaria lhang chu Shemer'a konin dangka talent ni in achon, lhang chunga chun khopi asemin, akhopi sem minchu lhang neipa Shemer min dungjuijin Samaria asahtai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla Omri chun Pakai mitmun chonset abolin, ama masanga ho jouse sanga sejocheh-in abolin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu aman Nebat chapa Jeroboam lamlhah ajuijin, chule achonsetna-a chun Israel achonsetsah-in, apannabei houva Israel Pakai Pathen alunghan sah-un ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tun Omri natohdoh athilbol dangho le athilbol theina atahlangho chu Israel lengte thusimbua kisun hilouham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun Omri chu apu apate toh alumkhomin, Samaria'a akivuitai. Chuin achapa Ahab ama khelin alengchang tai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Judah lengpa Asa lengchan kal kum somthumle kumget alhinin, Israelte chunga Omri chapa Ahab alengchang panin; Omri chapa Ahab chun Israelte chunga Samaria'a kum somni le kumni alengchange.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Omri chapa Ahab chun Pakai mitmun ama masanga ho jouse sangin thilse abolin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin ahitin ahi, Nebat chapa Jeroboam chonsetna juichu amadingin ima hilou bangtah-in, Zidon mite lengpa Ethbaal chanu Jezebel akichenpin; Baal agajenin, ahoutan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Samaria gama Baal dinga in asahna-a chun, Baal ding maicham khat aseme.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Ahab chun thingin milim asemin; ama masanga Israel lengho jouse sangin Ahab chun Pakai Israelte Pathen lunghana abol betan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama nikho laichun Bethel'a Hiel chun Jericho khopi chu anasan ahi. Nun chapa Joshua'a kona Pakaiyin anaseidoh bangin; a-inbul agon patnin achapa lenpen Abiram hinkho achanlon, akotpiho atungdoh-in achapa lhumpen Segub achanin ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Gilead gama cheng Tishbi mi Elijah'in Ahab henga, A-anga kadinjing Pakai Israel Pathen hingjing mina kasei ahi, kum ijat-ham kathulouva daitwi le gotwi long louhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakai thuchu ahenga ahung lhungin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Hia konin kipat inlang solam sanga kiheijin; Jordan masanga um Cherith vachadunga gakiselin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hitiding ahi, nangman vachadung chu nadon ding; chukoma chu nangma vah dinga va-ah ho thu kapehsa ahitai, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun ama achen Pakai thudungjui chun aboltai; ajehchu ama achen Jordan masanga um Cherith vachadung panga agachengtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin va-ah ten jingkahle changlhah leh sa, chule nilhahle changlhah leh sa ama ahin pohpeh jiuvin; vachadung twi chu adonin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin chomkhat jouvin ahitin ahi, gamsunga go ajuh louhel phatnin, vachadung chu akangtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakai thuchu ahenga ahung lhungin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Kipat in, Zidon gama Zarephat'a chenlang hiche munachun gachengin; vetan, keiman nangma nanavah dingin meithai khat thu kapetai, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun ama akipatnin Zarephat'a achetai. Chuin ama khopi lutna kotpi ahunglhun phatnin, veuvin, meithainu chu chua anaumin, thingkang anachome. Chule aman amanu chu akouvin, ajah-a, kadon ding bela twi themkhat neipen tia nahenga katao ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amanu twidom dinga achen ahile, amanu chu akouvin, kangeh nahi, changlhah kamkhat nakhutna neihin choipeh than, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amanun, Pakai na Pathen hingjing mina kasei ahi, changlhah kaneipon, ahin bel'a changbong khutdim khat le thao theija thao themcha vang aume; chule ven, kagalutna keima le kachapa dinga kasemtheina dinga thingkang ni kachom ahin, hitia chu kaneh lhona kathi lhonding ahitai, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Elijah'in amanu jah-a, kicha hih-in, nasei bangchun gaboltan; ahin hichea konchun keima-a ding changlhah neocha hinsem masan lang, kahenga hinchoijin; chujoule nangle nachapa ding semin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Israel Pakai Pathen'in hitin aseije, Pakaiyin leichunga go ahinjuhsah nikho kahse-a, bel'a changbong chu kemlou ding, thao thei jong kanglouhel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amanun Elijah thusei bangchun agaboltan; amanule amapa chule a-insung miten nitamtah aneuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin Elijah'a kona asei dungjuijin, bubel chu akempon, thao umjong chu akangpon ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin hicheho jouchun ahung hitin ahi, numei inneinu chapa chu ahung natan; anat chu alel lheh jengin ahile ama a chun haina hu aumtapoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amanun Elijah henga, vo nangma Pathen mipa, nangma i-kalo ding nahim? Ka chonsetna geldohsah dingle kachapa thatdinga hunga nahim? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman amanu jah-a, nachapa chu neipen, ati. Chuin anun a-angsunga apomna-a konin aladoh-in, ama umna chung dana chun apomtouvin, ajalkhuna alupsah-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman Pakai chu asamin, vo Pakai ka Pathen, kakholjina meithainu chunga jonghi, achapa thapeh-a kona thilse nahin lhunsah hija hitam? ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin chapang chunga chun thumvei akijah-in, Pakai chu akouvin, vo Pakai ka Pathen, kangeh nahi, hiche chapangpa hinna hi ama-ah hinkilesah kitnin, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakaiyin Elijah aw chu angaipeh-in; chapangpa hinna chu ama-a ahungkile kitnin, ahaldoh tai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Elijah'in chapang chu alan, a-indana konin insunga apuisuh-in, anu henga apen ahi. Chule Elijah'in amanu jah-a, ven, nachapa ahingtai, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin numeinu chun Elijah henga, tun hichea konhin nangma Pathen mikhat nahin, nakamsunga Pakai thuchu adih ahi ti kahetai, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin nikho tamtah jouvin ahitin ahi, Pakai thuchu akum thum na-in Elijah henga ahung lhungin, chen Ahab gakimusah-in, leichunga go kajuh sah ding ahitai, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Elijah Ahab kimusah dingin achetan; chule Samaria gama chun kel akhoh lheh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Ahab min a-insung vaipopa Obadiah chu akouvin ahi (tun Obadiah hi Pakai gingtah ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu hitichun, Jezebel'in Pakai themgaoho athagam laichun, Obadiah'in themgaoho jakhat apuijin, songkoa somnga ngan aselin, chule amaho chu changlhah le twijin avah-in ahi.)
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Ahab'in Obadiah henga, gamsunga twinahho jousele vachadung jouse-a gachen; ganchaho jouse manghel louva ijemtia hampa imuva, sakol ho le sanganho ihuhhing theina dingun, atin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun gamsung chu chotsoh nadin amani akihomlhonin, Ahab amatah akipatnin langkhat lama achen, Obadiah amatah akipatnin lamchom lama chun achen ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Chutia Obadiah lampia achepet chun, veuvin, Elijah'in akimupin; chule amapa chun ahen, amai tolla asulutnin, nangma kapu Elijah nahim? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman adonbutnin, kahi; chen, napakai pa jah-a, ven, Elijah hikoma aume, tin gahilin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman, ipi chonsetna kabola nasohhi thadinga Ahab khutna neipeh hitam? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pakai na Pathen ahinjing banga kasei ahi, ka pakaiyin nangma holdinga asol louna mun le gam aum tapoi. Chule ama khu-a aumpoi ati tenguleh; nangma namu lounao thuah lenggam le namchu akihahsel sahjin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule tun nangman, chen, napakai pa jah-a, ven, Elijah hikoma aume, tin naseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hung hitiding ahi, keima nakoma kona kachedoh dohleh, Pakai Lhagaovin kahetlouna gama napuimang tantin; chutia chu kache-a Ahab kaga hila, aman nangma namudeh louteng, eitha ding ahi. Ahin nasoh keiman kakhangdon laijapat Pakai kanagin jing ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jezebel'in Pakai themgaoho athalaija kathilbol, Pakai themgaoho somnga nga-a mi jakhat songkoa kaselguh-a, changlhah le twija kavah chu ka pakai hi naseipeh louvu hijaham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun nangman, chen, napakai pa jah-a, ven, Elijah hikoma aume, tin gaseijin neiti; aman eithatei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Elijah'in, a-anga kadinjing janel Pakai hingjing mina kasei ahi, tunikho-a hi thonlouva kakimusah teiding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Obadiah Ahab kimupi din achen, amachu ahiltai. Chuin Ahab Elijah kimupi dingin achetai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, Ahab'in Elijah amuphatnin ajah-a, nangma Israelte sulungjing pachu nahim? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman, keiman Israelte kasulung jingpoi; nangma le napa insungmiten Pakai thupeh ho nadalhah uva, Baal nung najuijuva kona nasuh lungjingu ahi bouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun tun Israelte jouse, Baal themgaoho jali, chule Jezebel dokhanga an nejing Asherah themgao jali chu kahenga Carmel lhanga gakoukhom sah-in, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hitichun Ahab'in Israel chate jouse akoukhomin, Carmel lhanga themgaoho chu akou khomin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Elijah chu mipi jouse henga chun ahungin, ahenguva, itihchan lunggel ni saikah-a naum jing diuham? Pakai chu Pathen ahile, juijun; ahin Baal joh ahi nati ule, amachu juijun, ati. Ahin mipin chengkhat chanjong adonbut pouve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujouvin Elijah'in mipi jah-a, kei, keima bouhi Pakai themgao umnalai kahitan; Baal themgaoho vang mi jali leh somnga aumuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun amahon bongchal ni eipeuhen; chule amahon bongchal khat kilhen uhen, chen bongselu henlang, thing chunga koijuhen, anoija mei tih hih-u hen. Chule bongchal chomjoh chu ken sem ingting, thing chunga koi jingting anoija mei kati louding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule nanghon na pathen hou minchu kou unlang, chule keiman Pakai min kakouding; chule meija hindonbut Pathen chu, Pathen hiding ahi, ati. Chuin mipijouse chun adonbutnun, nathusei chu apha lheh-e, atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Elijah'in Baal themgaoho jah-a, nangho dingin bongchal khat kilhenun, chule kisem masatnun; ajehchu nangho natam uve; chule na pathen hou min chu kouvun, anoijavang mei natilou diu ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amaho kipe bongchal chu athatnun, asemun, chule jingkah-a pat sunkim geihel Baal minchu akouvun, vo Baal, neihouvun, atiuve. Ahinla awgin ahiloule ahin donbutna khatcha aumpoi. Chuin amaicham semu chunga akichomchom jenguve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin sunkimin ahitin ahi, Elijah'in amaho a-eng houvin, hapenun, ajehchu ama pathen ahin; aman thu aseiham, minung ajuiham, kholche ham, ahiloule a-ihmu khat touham hintin, suhkhah ngaiding ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin hasapmin asamun, achonnau ngaibangin chemchan chule thih hemin aki-atnun, achunguva athiu alonlhah kahsen aki-atnun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, nilhangkai ahi phatnin, amahon nilhah lam ganlhaina anneh thilto phat geijin gaothu aseijun; hinlah aw khatcha aumpon, chule donbutna khatchala aumpon, koima chanjong ijin asepeh pouvin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Elijah'in mipi jouse jah-a, neihin naijun, ati. Chuin mijouse chu akoma ahung naijun ahi. Chuin Pakai maicham akivochimsa chu asemphan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Elijah'in, namin Israel hiding ahi tia Pakai thu hunglhuna Jacob chapate phungjat dungjuijin, songtum somleni alan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Songho-a chun Pakai minin maichan khat asemin, maicham kimvela chun muchi tena dimni doljou dinga lenin leiko khat alai kimvelin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman thingho agol golin akoijin, bongchal chu achenbongin, thingho chunga ajamin; chuin ajah uva, bel li chu twi sungdim munlang, govam ganlhaina le thing chunga chun sungun, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin aman, aniveinan bolkitnun, ati. Chuin aniveina-in abolkitnuve. Chuin aman athumvei na-in bolkitnun, ati. Chuin amahon athumvei na-in jong abolkit taove.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin twi chu maicham kimvela alongin, aman leiko jongchu twija adipmin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin nilhah lam ganlhai phat ahiphatnin, Elijah themgao ahungnaijin, hitin aseije; Abraham, Isaac chule Israel Pakai Pathen, nangma Israel Pathen nahi-a, chule keima nasoh kahia, chule hiche thiljousehi nangma thua kabol ahi ti tuni hin kihedoh hen, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Neihin ngaipeh-in, vo Pakai, neihin ngaipeh-in, chutile hiche mipihohin nangma Pakai Pathen nahi-a, chule nangman alungu nalehei ahitai ti ahet dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chujouvin Pakai meikong chu ahungleng lhan, govam ganlhai, thingho, songho, leivuiho chu akavamin; chule leiko a twi chu ahulsahtan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin mipi jousen hichu amuphatnun, amaiju tolla asulutnun, Pakai, amachu Pathen ahi; Pakai, amachu Pathen ahi, atiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Elijah'in ajah uvah, Baal themgaoho chu man-un; khatcha hoidoh sah hih-un, ati. Chuin amahochu amanun; Elijah'in Kishon vachadunga apuisuh-in, hiche munachun athatgamtai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Elijah'in Ahab jah-a, chetouvin, nenlang donin, ajehchu go hajuh-a juhding husa aume, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hitichun neding le dondingin Ahab achetoutai. Chuin Elijah chu Carmel lhangvuma akaltouvin, tolla akunchah-in, akhupteni kah-a amai asulutnin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin asohpa jah-a, tun chetouvin, twikhanglen lam ven, ati. Chuin ama achetouvin, agahven, imacha aumpoi, ati. Chuin ajah-a, sagivei chekitnin, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin asagivei lhinnan, aman Elijah henga, vetemin, mihem khut tobang twikhanglen'a konin meilhang neocha ahung kitungdoh-e, ati. Chuin aman chetouvin, Ahab jah-a, nakangtalai kigotnin lang, gon nahen lounadin chesuh-in, tin gaseipeh-in, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin chomkah louvin, van chu meilhang le huijin athimletlut jengin, go nasatah in ajutan ahi. Chuin Ahab kangtalai ja atouvin Jezreel lama achetai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule Pakai khut Elijah chunga aumin; aman atai akigah-in, Ahab masanga Jezreel lutna lama alhaitai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Ahab'in Elijah thilbol, Baal themgaoho jouse chemjam'a athajedan jouse chu Jezebel ahilin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jezebel'in Elijah henga thupole asolin, jingle tuphat vela amaho khatpen hinkho banga nahinkho kabol louleh, pathen hon kachunga hitobang chun bolhen, chule akalvalin jong bolu hen ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin hichu amuphatnin, akipatdoh-ni, ahinnadin ajamdoh-in, Judah gama um Beersheba-a ahung lhungin, hikoma chu asohpa chu adalhatai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin amatah vang gamthip sunga nikhat lama achen, chuin ahungin juniper thingphung noikhatna atoutai. Chuin athina dingin athumin, tun aphaset tai, vo Pakai, kahinna ladohtan, kapu kapate sangin kaphachom jopoi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ama juniper thingphung noija alupma a-imut chun, vetan, vantil khatnin athamin, thouvin, an kineh-in, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin avetle, vetan, mei-am chunga changlhah khatle twi umkhat alu lhuna anaumin ahi. Chuin aman anen adonin, alumkit tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakai vantil chu aniveinan ahungkitnin, ahinkhoijin, ajah-a, thouvin lang nen; ajehchu nakholjin nading chu nangma-a dingin asao behsetne, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ama athouvin, anen adonin, chule hiche an thahat chun Pathen Molsang Horeb lama nisomli le jansomli achen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin chulama songko khatna alutnin, chua chun agehden tai. Chule vetan, Pakai thu ahenga ahung lhungin, ajah-a, Elijah hikoma ibol nahim? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, keima janelho Pakai Pathen dinga tompan behseh jeng kanahi; ajehchu Israel chaten nakitepna adondauvin, namaicham ho asuchimun, nathemgao ho chemjamin athatnun; kei, keima sehseh bouhi asohcha kahi; chule amahon kahinnahi lahmang dingin aholun ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman, potdoh-in, chule molsang chunga khun Pakai anga gadingin, ati. Chuin veuvin, Pakai ahungin, chule Pakai angsunga chun huipi hattah le nasatah-in molsang ho chu asemkeh-in, songpiho ahal halin asuchipmin; ahin huilah-a chun Pakai aumpoi; chule hui akichai phatnin ling akihotnin; ahin inlinga chun Pakai aumpoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ling kiho jouvin mei akan; ahin meija chun Pakai aumpoi; chuin meikah jouvin aw ngatselin ahung gingin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, Elijah'in hichu ajah phatnin, aponin amai akitomin, apotdoh-in songko lutna-a chun adingtan ahi. Chuin vetan, ahenga awkhat ahung gingin, Elijah hikoma hi ipibol nahim? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman, keima janelho Pakai Pathen dinga tompan behseh jeng kanahi; ajehchu Israel chaten nakitepna adondauvin, namaicham ho asuchimun, nathemgao ho chemjamin athatnun; kei, keima sehseh bouhi asohcha kahi; chule amahon kahinnahi lahmang dingin aholun ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakaiyin ajah-a, chen Damascus gamthip lama kilen lang, nahung lhunteng Hazael chu Syria chunga leng dinga thao nu-in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Nimshi chapa Jehu chu Israel chunga lengdinga thao nanuding; chule na indan sunga Abel-meholah khomi Shaphat chapa Elisha chu themgao dinga thao nanuding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hung hitiding ahi, Hazael chemjam'a kona hoidohchan Jehu'n atha ding; Jehu chemjam'a kona hoidohchan Elisha'n athading ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijongle Baal anga akhupma bohkhup khaloulai, chule amuh-a ama chopkha louhel Israel gamsunga mi sangsagi kakikhen nalaije, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun hichea konchun apotnin, chule Shaphat chapa Elisha amun, amachun lou anakai jin, ama masanga bongchal tosomleni achen, chule ama somleni chana tochun alhonkhomin ahi; chuin Elijah'in ama agah jotpan, achunga apon agah sekhumin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman bongchalho chu adalhan, Elijah nunga alhaijin, katao ahi, kanule kapa gachop tading ting, chutengle juinange, ati. Chuin aman ajah-a, kinungle kitnin; ajehchu keiman nangma ipi kabolpeh em? ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ama ama-a konin akinunglen, bongchal tokhat akaijin, athatnin, asa ho chu bong manchah ho-a chun ahonin, miho chu apen, aneovin ahi. Chuin ama akipatdoh-in, Elijah nung ajuijin, ama ajenletai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Syria lengpa Benhadad'in asepai janel jouse akhom khomin; amato pangkhoma chu leng somthumle ni ahin, amaho chu asakol kangtalaiju toh ahitha cheh-u ahi. Chuin ama achetouvin Samaria aum kimvelin, achunga gal aboltai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman khopi sunga Israelte lengpa Ahab henga thupo ho asolin, hitin agasei sah-e, Benhadad'in hitin aseije,
  </para>
  <para style="p">
    <verse number="3" style="v" />Nasana le nadangka ho chu keija ahin; najite le nachate, aphapen ho geija keija ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Israel lengpa chun adonbutnin, ka pakai, vo lengpa, nathusei bangin keima le kaneijouse abonchan nanga ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin thupo ho chu ahungkitnun, hitin aseijuve, Benhadad'in hitin aseije, nahenga nadangka ho le nasana ho, najite le nachate neipeh ding ahi, tia mi kahinsol vangin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Jingle tuphat donahi kasohte kahinsola, amahon nangma inle nasohte inho aholdiu; chule hitiding ahi, ipi hile namit lachanchu, akhutnuva kona alah uva achoimang diu ahitai, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Israel lengpan gamsung upaho jouse akouvin, kangeh nahiuve, hichepan thilse aboldanhi melchih unlang vetemun; ajehchu kahenga kajite le kachate, kadangka le kasanaho ahin thumin; kana itpehlou ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin upa jousele mipi jousen, athu ngaihih-in, nopjong noppeh hih-in, atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun aman Benhadad thupo ho henga, ka pakai lengpa chu seipeh-un, nasoh henga mi nahinsola na-ngeh masat jouse chu kabolding ahi: ahin hiche vanghi bolthei ponge. Chuin thupo ho chu akipat doh-un, hiche thuchu agalhut taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Benhadad'in ahenga mi asolin, kanungjui mipi ho jouse-a dinga khutdim khat cheh tohding Samaria leivui kakhen poupoule, hitobang chun pathen hon kachunga lhunsah hen, chule akalvalin jong lhunsah hen, agati sah-e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Israel lengpan adonbutnin, galvon kivonpa chu akisutlha sapa bangin hoitho hihhen, tin gaseipeh un, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ahitin ahi, Benhadad'in hiche thu chu ajah phatnin, ama le aleng chankhompi hon pon insunga ju adon petnu ahin, asohte jah-a, kigouvin, ati. Chuin amaho akhopi satdingin akigo taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin veuvin, themgao khat Israel lengpa Ahab henga ahungin, ajah-a, Pakaiyin hitin aseije; mipi tamtah hohi namu em? ven, tunia hicheho hi nakhutna kapehdoh ding ahin; chutengle keima Pakai chu kahi neihetding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Ahab'in, keija konin em? ati. Chuin aman, Pakaiyin hitin ati, gamkaiho-a pipui gollhang ho-a konin, ati. Chuphatnin aman galsatdinga koijin thu apeh dingham? ati. Chuin aman, nangman, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin aman gamkaiho-a pipui gollhangho asimin, amahochu jani leh somthumle ni ahiuvin; chuin amaho nunga mijouse, Israel chate jouse asimle, sangsagi ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amaho sunkimin akipatdoh taove. Benhadad vang pon inho sunga, amale akithopi leng somthumle ni chun ju adonun, anakham tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin gamkaiho-a pipui gollhangho apotdoh masaovin; chuin Benadad'in mi asolin, chule amaho chun, Samaria konin miho ahung potdoh uve, tin aseipeh uve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman, cham boldinga hung ahijongle ahingin man-un; ahiloule galbol dinga ahung ahiu jongle ahingin man-un, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun gamkai lenho-a pipui gollhangho chu khopi-a konin ahungdoh uvin, galsatmi hochun anungu ahinjuijun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amitakipmin atokhahcheh-u athatnun ahile, Syria te chu ajam taovin; Israelte chun anung delun ahi; chuin Syria lengpa Benhadad chu sakol chunga atouvin, sakol tou them hotoh ajamdoh tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Israel lengpa chu apotdoh-in, sakolhole kangtalai ho chu asusen, Syria te chu tamtah athatnin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin themgaopa chu Israel lengpa henga ahungin, ajah-a; chen, natha hatsah inlang melchih-in, chule ipi nabolding kingaiton; ajehchu kum kitle Syria lengpa nangma dou dinga hungding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Syria lengpa sohten ajah-a, a-pathen hou chu thinglhang pathen ho ahin; hijeh-a chu eihosanga amaho hatjoa ahiuve; ahin eihon amaho phaichama kisatpiu hite, chutile amaho sanga thonlouva ihatjoh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hitiho hi bolin, lengho chu amitakip ama muncheh-a konin ladoh-in, amaho mun'a chun sepai gal lamkaiho pansah-in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangman namansah sepaiho tobang sepaiho, sakol khela sakol, kangtalai khela kangtalai kisimdoh-in; chule keihon phaichama amaho kisat piuvinge, chule amaho sanga thonlouva kahatjohdiu ahi, atiuve. Chuin aman athu-u chu angaijin, hitichun aboltai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin akum kitnin ahitin ahi, Benhadad'in Syria mite chu asim toh-in, Israelte satdingin Aphek'a achetou tan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Israel chate chu akisim taovin, abonun ahungcheh-un, amaho satding chun ache taove. Chule Israel chaten amaho masanga chun kelnou hon neocha ni bangin pon-in akisonuve; Syria te vang chun gamsung alodimsoh jengun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Pathen mikhat ahungin, Israel lengpa henga thu aseijin; Pakaiyin hitin atie, Syria te Pakai chu thinglhangho pathen ahin, phaicham pathen ahipoi atiuvin, hijeh-a chu mipi atama tamho jousehi nakhutna kapeh ding, chutia chu keimahi Pakai chu kahi ti nahetdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin amaho chun khatle khat kigalsai ton ponbuh akisonun ahi. Chuin ahitin ahi, nisagi nin gal akipanin, Israel chaten Syria mite chu nikhat sungin mi sangjakhat athatnun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin adangho vang Aphek khopi sunga ajamlutnun; aumnalaiho mi sangsomni le sangsagi chu kulpin achim khumin ahi. Chuin Benhadad chu ajam mangin, khopi sunga, indan sungnunga ajamlut tai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin asohten ajah-a, tun vetemin Israel insunga lengho khu hepina-a dim lengho ahiuve ti kanajaove. Katao ahi, ikong uvah khaodip pon kichenu hitin, chule ilu uva khaokol kikhiu hitin, Israel lengpa henga gacheu hite; ijem itile aman nahinkho huhhing khatninte, atiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hitichun akonguvah khaodip pon akingah-un, aluva khaokol akikopmun, Israel lengpa henga ahungun, ahenga, nasoh Benhadad'in, katao ahi, neihing hoijin, atie, atiuve. Chuin aman hingnalaija ong? kasopipa hijachu, atin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tun mihochun ama-a kona thu hungpot chu lunglut tah-in anitnun, chule ajoploi chelun; nasopipa Benhadad, atiuve. Chuin aman, gapuijun, ati. Chujouvin Benhadad ahenga ahungtan; chuin aman kangtalai ja akaldoh sah-in ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Benhadad'in ajah-a, kapan napa-a kona analah khopiho chu kalepeh ding nahi; chule kapan Samaria'a abolbang chun nangman jong Damascus khosung lamlen kisemin, ati. Chuin Ahab'in keiman hiche kitepna hotoh nasoldoh tha nange, ati. Hitichun aman amatoh kitepna asemin, asolmangtai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin themgaoho chapate lah-a mikhatnin Pakai thu-in aheng akompa jah-a, nahenga katao ahi neivotem in, ati. Ahin mipa chun avonompoi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin aman ajah-a, Pakai thu nangailou jeh-in, vetan, keija kona napotdoh dohle, keipi bahkaijin nathading ahi, ati. Chuin ama-a kona apotdoh doh-in, keipi bahkai khatnin amun, athat tai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chujouvin michom khat amun, katao ahi, neivotem in, ati. Chuin amapan avotan, chutichun avohna-a chun amavotan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hitichun themgaopa chu apotdoh-in, lengpa chu lampia angah-in, amai vutvai anun alim achomsah-in ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin lengpa ahungphatnin, aman awsang tah-in lengpa jah-a chun; nasohhi galmun laitah-a kagachen; chule vetemin, mikhat akiheidoh-in kahenga mikhat ahinpuijin, hichepa hi chingphan; itihama amanle ahinkho khela nahinkho nachan ding, ahiloule dangka talent khat napehding ahi, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule nasohhi hilamle khulama kakisahlel kah-in amapa ana achemang tai, ati. Chuin Israel lengpan ajah-a, hitobanga chu nathu kitanlha ding ahi; nangma le nangman nakitan lhah ahitai, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin aman amaija kona vutvai chu aladoh loijin ahileh, Israel lengpa chun ama themgaoho lah-a ahi chu ahedohtan ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin aman ajah-a, Pakaiyin hitin aseije, suhgamhel dinga kagotsa chu nakhutna kona kakitol dohsah tahjeh-a, nahinkho chu ama hinkho khela, namite chu amite khela cheding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Israel lengpa chun nguitah le lunghimo tah-in a-inlam jonin achen, Samaria ahung lhungtai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hicheng jouchun ahitin, Jazreel mi Naboth'in lengpi hon khat aneijin, hichu Jazreel mun'a um ahin, Samaria'a lengpa Ahab inpi bantah-a uma ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Ahab'in Naboth jah-a, nalengpi leihi ka in komcha-a um ahijeh-in, ka anche leidin neipetan, hiche khelchun asanga phajo hondang khat nape nange, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Naboth'in Ahab jah-a, kapu kapate gou nang kapeh ding chu Pakaiyin ajanompoi, atin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jezreel mi Naboth thusei jehchun Ahab chu nguichet le lunghimo tah-in a-in'a ahung tan ahi; ajehchu aman, kapu kapate gou nangma peponge ati ahi. Chuin ama ajalkhuna alumin, amai aheimangin, imacha anenom tapon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla a-inneipi Jezebel ahenga ahungin, ajah-a, ibola nachuti lunggima, annelouva uma nahim? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman amanu jah-a, ajehchu keiman Jezreel mi Naboth henga, nalengpilei chu sumin neikichoh sah-in; ahilouva nalung lhaina ahile, hiche khelchun lengpilei chomkhat nape nange kanatin ahi. Ahinla aman, keiman kalengpilei nangma peponge, tin einadon butnin ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin a-inneipi Jezebel'in ajah-a, nangma Israel lenggam vaipo nahilouham? thouvin lang an nen, nalung kipasah-in; keiman Jezreel mi Naboth lengpilei chu nangma kapeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun amanun Ahab minin lekhathot khat asunin, lengpa mohor chu anamkhumin, lekhathot chu Naboth toh chenga khopisunga upa hole milal ho chu athotnin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amanun lekhathot ho-a chun, an ngol ding phongjalun lang, mipi lah-a chun Naboth chu domsangun;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule mini, Belial chapateni chu amapa douna hettohsah dingin dinsah-un, nangman Pathen le lengpa nataitome, tin seisah-un; chujouteng puidoh unlang athina dingin songin sepmun, tin asunne.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin akhopi sunga miho, akhopi sunga cheng upaho, milen milal ho chun, Jezebel'in ahenguva ahinthot lekhathotna kisunbang chun abol taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon an ngolthu aphongjalun, mipi lah-a Naboth chu adomsangun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin mini, Belial chate pasal ni ahunglut lhonin, amasanga atoulhone. Chuin Belial mi teni chun ama douna, Naboth dounan mipi anga chun ahettohsah lhonin, Naboth'in Pathen le lengpa ataitome, atilhone.Chujouvin amahon khopi-a konin akaidoh-un, songin asepmun ahile athitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jezebel henga, Naboth songin asepmun, athitai tin agah hetsah taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahitin ahi, Jezebel'in Naboth songin asepmun athitai ti ahet phatnin, Jezebel'in Ahab henga, kipat in, Jezreel mi Naboth lengpilei suma chohdinga aphalou chu galotan; ajehchu Naboth chu ahingtapoi, athitai atin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Ahab'in Naboth athitai ti ajah phatnin, Ahab chu Jezreel mi Naboth lengpilei galo dingin akipat doh-in, achesuh tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Tishbi mi Elijah henga Pakai thu ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="18" style="v" />Kipat doh-in, Samaria'a um Israel lengpa Ahab kimupi din chesuh-in; ven, galo dinga achesuh lona Naboth lengpi leija aume.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nangman ajah-a, Pakaiyin hitihin aseije, nangman natha-a, agam hi nalo hilouham? chule nangman ajah-a, Pakaiyin aseije, uichan Naboth thisan alena mun'a chu, uicha hon nangma thisan ngeitah jong ale dingu ahi, tin jong gaseijin, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Ahab'in Elijah jah-a, neimudoh hitam, vo kamelma pa? ati. Chuin aman adonbutnin, kamudoh nahitai; ajehchu Pakai mitmu-a thilse boldinga nangle nang kijoh nahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Vetan, keiman nachunga thilse kahin lhunsah ding, nachilhah kalah mangding, Israel gamsunga Ahab chilhah pasal jouse, akihen hihen, ongthol hijongle kasuh manghel ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nangman neilung hansah-a, Israelte nachonset sah jeh-a, na-insung chu Nebat chapa Jeroboam insung bangle Ahijah chapa Baasha insung banga kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jezebel chungchang thujong Pakaiyin aseijin, kulpanga uichaten Jezebel anehdiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahab insung mite khopi sunga thichan chu uichaten anehdiu; chule gama thichan chu chungleng vachaten anehdiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla a inneipi Jezebel tildoh-a Pakai mitmu-a thilse tongdinga amale ama akijohdoh-a Ahab tobang koimacha aumpoi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakaiyin Israel chate masanga ana nodoh Amor mite thilbol jouse bangin, thet umtah in milimho nung anajuijin ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ahitin ahi, hiche thuhochu Ahab'in ajah phatnin, apon abottelin, khaodip pon akisilin, an angolin, khaodip pon silin alumin, kangchan achedohtan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Tishbi mi Elijah henga Pakai thu ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ven ichana Ahab kamasanga amale ama kineosah hitam? kamasanga akineusah jeh-in ama hinkho sungin thilse lhunsah taponge; ahin achapa hinkho sungin vang a-insunga thilse kalhunsah ding ahi, ati.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israel le Syria kikah-a chun kumthum sungin gal ana umpon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, akumthum na-in Juda lengpa Jehoshaphat chu Israel lengpa henga ahungsuh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Israel lengpan asohte jeh-a, Gilead gama Ramoth kho khu eihoa ahin, Syria lengpa khutna konin akiladoh hihlaije ti nahet lou uham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman Jehoshaphat jah-a, Ramoth-gilead gal neisat hu ding ham? ati. Chuin Jehoshaphat'in Israel lengpa jah-a, keima nangma tobang kahin, kamite jong namite tobang, chule kasakolte jong nasakol tobang ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jehoshaphat'in Israel lengpa jah-a, kangeh nahi, tunin Pakaiyin ipi thu aseijem dong photnin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuphatnin Israel lengpan themgao mi jaliho akhom khomin, ajah uvah, Ramoth-gilead satdinga kakon dingha, kakon louding ham? ati. Chuin amahon, kontouvin, ajehchu Pakaiyin hichu lengpa khutna apehding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jehoshaphat'in, eihon idohthei dingu Pakai themgao dang khattou hia hi umlou ham? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Israel lengpan Jehoshaphat jah-a, Pakai thu idoh theina diu mikhat, Imlah chapa Micaiah aum nalaijin, hinla amapan keima chungchang ase tailou apha aseikhah louhel jeh-a kahot ahi, ati. Chuin Jehoshaphat'in, lengpan chuti chun seihih hen, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Israel lengpan vaipo khat akouvin, Imlah chapa Micaiah hin puiloi temin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Israel lengpa le Judah lengpa Jehoshaphat chu aleng vona kivon pumin, laltouna-a Samaria lutna kotpi phung mun ong laija atoulhonin; amasang lhona themgao jousen gaothu aseijuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Chenaanah chapa Zedekiah chun thih-in ki phabep asemin; chuin aman, Pakaiyin hitin ati: hiche-a hi nangman Syria mite chu nasuh manghel kahse-a nanoding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule themgaoho jousen chutobang machun gaothu aseijun, Ramoth-gilead'a chetouvin lang galolhing teijin; ajehchu Pakaiyin lengpa khutna hichu apehdoh ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Micaiah kou-a che thupopan ajah-a aseijin, tun vetemin, themgaoho chun lengpa-a dingin kitohtah-in akamuva thupha aphong jalun ahi; katao ahi, nangma thu jong amaho khatpenpen thu tobang hihen lang, apha chu seijin, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Micaiah in, Pakai hing jing mina kasei ahi, Pakaiyin kahenga aseibou chu kaseiding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitichun lengpa henga ahungtai. Chuin lengpan ajah-a, Micaiah Ramoth-gilead satna kache diuha, kachelou diuham? ati. Chuin aman adonbutnin, chenlang galolhing taohiti: ajehchu Pakaiyin hichu lengpa khutna pedoh navehta, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin lengpan ajah-a, thutah tailou kahenga Pakai mina naseilouna dinga ijatvei nangma kaki hahsel sah ding nahim? ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman, Israelte jouse chu achingbei kelngoiho banga, lhang dunghoa achehchau gamhelu kamun; chule Pakaiyin, hihohin aching ding aneitapouve; mitin a-in lama lungmong tah-in kile taohen, atie, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Israel lengpan Jehoshaphat jah-a, kachung chang thu ase tailou apha himhim seiponte tia kahil nahilouham? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Micaiah'in, hichejeh chun nangman Pakai thuhi ngaijin; Pakai chu alaltouna chunga atouva, vanmi janel ajetlam le aveilama adinu kamui.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakai chun Ahab hi Ramoth-gilead'a achea agathi nadinga kon agalhep ding ham? atin ahi. Chutichun khatnin hitin aseijin, chule adang khatnin khutin aseijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin lhagao khat ahungdoh-in, Pakai anga adingin, keiman lheminge, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakaiyin ajah-a, iti danin em? ati. Chuin aman gache ingting, athemgaoho jouse kama chun jousei lhagaovin gapanginge, ati. Chuin aman ajah-a, nangman nagalhep ding, chule jojong nagajoding ahi; hijeh chun gachenlang hitobang chun gaboltan, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun tun, vetan, Pakaiyin hiche nathemgao ho jouse kama jousei lhagao akoijin, chule Pakaiyin nachung changa thilse aseitan ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla Chenaanah chapa Zedekiah'in aganaijin, Micaiah ngeiphe chu abengin, Pakai lhagao chu nahenga thu seidinga keija kona hoiche lampi-a potdoh-a ham? ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Micaiah'in, vetan, indan sungnunga kisel dinga nalut niteng hetan nate, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Israel lengpan, Micaiah hi puijun lang, khopi vaihompa Amon le leng chapa Joash henga lepuijun;
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule hitin gaseijun, lengpan hitihin aseije, hichepahi songkul'a khumun lang, lungmonga kahung kahsen, gentheina an le gentheina twijin vah-un, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Micaiah'in, lungmonga nahung kile pou poule, Pakaiyin kajah-a thu aseilou hinte, ati. Chuin aman, mipi ho, nangho kichih theijun, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hitichun Israel lengpa le Judah lengpa Jehoshaphat Ramoth-gilead'a achetou lhontai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Israel lengpan Jehoshaphat jah-a, keiman kalim kheling ting galmuna lutninge; nangman vang nalengvon kivonin, ati. Chuin Israel lengpan alim akhelin, galmuna alut tai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahinla Syria lengpan kangtalai chunga vaipo gal lamkai somthumleni chu thu apen, Israel lengpa tailou alenjong aneojong kisatpi hih-un, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin ahitin ahi, kangtalai sepai vaipoho chun Jehoshaphat amuphatnun, amahon, amachu Israel lengpa ahimonge atiuvin ahi. Chuin ama satdingin akiheijun ahile, Jehoshaphat chu ahung pengjah-in ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin kangtalai sepai vaipipo ho chun Israel lengpa ahilou ahet phatnun, ama anungdel uva konin akinungle taovin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahin mikhatnin athal ajebongin amoh kapmin ahileh Israel lengpa galvon thokah akhan ahi. Hijeh chun akangtalai tolpa jah-a chun, kaiheijin lang mipi lah-a konin neipotdoh pin, keima machanga kahitai, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hicheni chun gal kisat akhohcheh chehtan, Syria mite lamngan lengpa chu kangtalai chunga akingaijin, nilhah lamin athitai. Chule amaha-a kona thisan along doh-in kangtalai sunga chun along lutnin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin nilhum ding konin sepai janel lah-a konin, amitakip akhopile agamsung cheh-a chetouhen, tin ahung kisamin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hitichun lengpa chu athin, Samaria'a ahinpouvin; chuin lengpa chu Samaria'a avui taove.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin mikhatnin kangtalai chu Samaria twikul'a chun asopmin; Pakai thusei dungjuijin, uicha hon athichu aleh-un; agalvon chu asopmun ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tun Ahab thilbol danghole anatohho jouse, saiha-a a-in sah, chule ama sahdoh khopiho jouse chu Israel lengte thusimbua kisuna hilouham?
  </para>
  <para style="p">
    <verse number="40" style="v" />Hitichun Ahab chu apu apate toh alumkhomin, ama khelin achapa Ahaziah alengchang tai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Israel lengpa Ahab lengchan kal kum li na-in, Asa chapa Jehoshaphat chu Juda gama alengchang panin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jehoshaphat alengchan kipat chun kum somthumle kum nga ahitan; Jerusalem'a kum somni le kum nga alengchange. Chule anu minchu Azubah ahin, Shili chanu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin aman apa Asa lampi jouse chu ajotnin, chua kona kiheimang louvin Pakai mitmu-a adih jeng abolin ahi. Ahivangin munsang ho vangchu akiladoh dehpoi; ajehchu munsang ho-a chun mipin thilpehle gimnamtui halna aneijing nalaijun ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule Jehoshaphat'in Israel lengpa toh chamna asemin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tun Jehoshaphat thilbol danghole ahatna avetsahho, chule agalbol danho chu Judah lengte thusim buho-a kisuna hilou ham?
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule apa Asa nikhoho-a jonthanhoija kimangcha ahingdoh amoh umsun chu, gamsunga konin anodohsoh helin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chulaichun Edom'a leng ana umpon; gamvaihom chu leng anahijenge.
  </para>
  <para style="p">
    <verse number="48" style="v" />Jehoshaphat'in Ophir'a sana gapoding Tarshish kongho asemin, ahinla Ezion-geber'a kongho chu akegam jeh-in achetapoi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuphatnin Ahab chapa Ahaziah chun Jehoshaphat jah-a, kasohte hi nasohtetoh kongho-a konkhom sah-u hite, ati. Ahinla Jehoshaphat anompon ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin Jehoshaphat apu apate toh alumkhom tan, apu apate toh apa David khopi-a avuitaovin ahi. Chuin ama khelin achapa Jehoram alengchang tai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin Judah lengpa Jehoshaphat lengchan kal kum somle kumsagi alhinin, Samaria gama Israelte chunga Ahab chapa Ahaziah alengchang panin; Israelte chunga kum ni alengchange.
  </para>
  <para style="p">
    <verse number="52" style="v" />Aman Pakai mitmun thilse abol jingin, apa lamlhah le anu lamlhah, chule Israelte chonsetsah-a Nebat chapa Jeroboam lamlhah chu ajotpeh-in ahi;
  </para>
  <para style="p">
    <verse number="53" style="v" />Ajehchu apan anabol bangin Baal ajenin, ahouvin, Israel Pakai Pathen lung hansahna dingin aphinsen ahi.
  </para>
</usx>
