<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NAM" style="id">Nahum</book>
  <para style="h">Nahum</para>
  <para style="toc1">Nahum</para>
  <para style="toc2">Nahum</para>
  <para style="mt">Nahum</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nineveh khopi pohgih. Elkosh mi Nahum themgao thilmu lekhabu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen hi thangthip tah le phulaji Pakai ahin; Pakaiyin phu alanjin, chule alungsajin ahi; Pakaiyin akidoupite chunga phu alahding, chule amelmate din alunghana akholin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai hi lunghang vahlou, thahat nasatah nei ahin, chule mi khangilou chu talen pelouva akoilouhel ding ahi. Pakaiyin chimpei le khopi hui lah-a lampi aneijin, chule meilhang hohi akeng phang dinga leivui tobang ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman twipi aphoh-in, akansahjin, vadung jouse akansah jin ahi; Bashan le Karmel agolhatan, Lebanon pahcha amol gamtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amasanga molsang ho akihotnin, lhangho ajunlha tan, chule a-angsunga leiset akalhan, vannoi leiset le asunga cheng jouse jong ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Alunghana masanga ding thei dinga koiham? chule alungsatna khoh tah-a um thei dinga koiham? alungsatna chu meikong bangin ahung kibung lhan, chule songpi ho chu aman asonlha jin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai hi apha ahin, lungkham nikho-a kulpidet ahi; ama tahsanna mite chu aman ahejingin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla twisoh longlet lhaleova amun chu akichaihel sah ding, chule muthimin ama melmate chu adelding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon Pakai douna-a ipi nagelu ham? Aman akhonna hela achaina asemding; anivei chana dinga kisuh gentheina sohdoh kit lou ding ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu ling banga amaho thakhatna akihelkop laijule, jukham ho banga ju akham laijuva, changkong gosel banga amaho mahthah ding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai douna-a thilse ngaito jing, mi khanggilou thumopthem khat, nanga kona hung peng doh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakaiyin hitin ati; amaho lung mongin umu hen, chutobang chun tamtah hijongleu, aman alah-u ahinjotpa tengle chutobang ma-a chu suhmanga umding ahiuve. Keiman nangma nanasulunggim jongleng, kasuh lunggim kit louding nahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu tu-a hi keiman ama namkoljon chu nanga kona kaheboh ding, chule nakihena chu kasa tanding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule namin hi a-itih-a akiphah pohkit louhelna dingin, Pakaiyin nachung changa hin thupeh apen ahi. Na pathen ho insunga kona akikhentho le akilhahtho milim ho chu kasuhmang helding; nangma thet umtah mi nahijeh-a, nalhan kasempeh ding nahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vetan molsang chung ho-a chamna thu phonglea, kipana thupha polepa keng chu! Vo Judah, na kut thupi ho chu phaten nitnin lang, nakitepna ho chu tong doh-in. Ajehchu mikhang gilou chu nahenga hung louhel ding ahitai; ama chu mit hella kisumanga ahitai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahal halla suchipjipa chu namasanga ahungtai: kulpi chu kiven phatnin, nalampi vephan, natai kigah detnin, nathahatna chu nasatah-in kisem phatnin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu Pakaiyin Israel chungnunna alahmang banga, Jacob chungnunna jong alahmang ahitai: ajehchu michom gam hon amaho achomgamu ahitan, chule alengpigui bahhou chu suhmanga uma ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amihat hou lum chu aki susan gamtan, mihangsan ho von chu asanthip tan ahi; akigot nikho le asakol kangtalai hou chu meikou vahleng lung tobang hiding, chule chah thingphung ho chu tijat umtah-a kihot ling ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sakol kangtalai ho chu khopi lamlen ho-a lung hang tah-a lhaile diu, amaho khatle khat lam lhongpi ho-a kineh todiu: amaho meivah lengle bangdiu, chule kolphe banga lhaile diu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman amilen ho chu ahetdoh ding; amaho alamjot naova kipal lhudiu; amaho kulbang lam jona chu kino tah-a chediu, kivenbitna chu kisemtup ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vadung ho-a kotpi ho hondoh-a hung umding, leng inpi chu suhmanga umding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Huzzab chu gal hinga kipui mang ding, khoukhah-a hung umding, chule asoh numeiten a-op achup dingu, vakhu aw banga maopuma apuilediu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Nineveh hi masang laija chu twikul tobang anahin, hijongle amaho jam mang ding ahiuve. Dingun, dingun tia amahon asapdio, hijongle koiman anungvet lou ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon akichom doh dangkale sana chu kilah-un; ajehchu neile gou hin beitih aneipon, Thil manlut tahtah honjong beitih aneipon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama ahomkeo, pannabei le man theilou chu ahitai: Chule lungthim ajunlha tan, khup teni akitatton, tai jouse-a natna khohtah achun, chule amaiju abonchan adup gamtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Koimachan asuh linglaolou keipi bahkai, keipi teh, chule anou valena mun, Keipi bahkai ho chenna mun le keipi donglai ho kivahna mun chu hoilai hitam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Keipi bahkaijin anoute ding khambep-in ahal hallin asat telin, chule keipi nu-a din alolla apet lih-in, akosungho chu asamat ho-a adipmin, chule akulsung chu sa adimin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ven, keiman nangma kadouve tin janel ho Pakai chun aseije, keiman asakol kangtalai ho chu meikhu-a kahal lhah ding, chemjamin na keipi bahkai donglai ho chu asat chapding: chule leisetna kona nasamat ho chu kasuhmanga, nathupolepa awgin chu kijakit louhel ding ahitai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thisan sona dim khopi chu ohe adana-e! hiche-a chun mijoule michom ho adimsetnin, thil kichom ho abei khapon;
  </para>
  <para style="p">
    <verse number="2" style="v" />Molla kijepna husa, kangtalai kang lhaigin, sakol ho lhaigin le sakol kangtalai ho kichop gin atangpon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sakol chunga tou mihon achemjamu val lahlah le atengcha hou pahlahlah chu adomsangun; akithatna mihem tamtah aumin, mihem thisa long simjoulou akijamin; alongu kiphong chu abeitih aumpon, amithi long hou chunga chun akipalun;
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichu kihoisah-a jonthanhoi bol simjoulou notiho, ajonthanhoi bolna-a namtin johmanga doichoi nu, chule adoi choina-a a-insung johmangnu jeh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ven, keima nangma douva kahi tin janel ho Pakai chun aseije; keiman nanih chu namaikoh chunga kahodoh pehding; chule nasagohkeo hina chu namtin kamusah ding chule najumna chu lenggam ho kamusah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman kidah umtah thilboh nachunga kahin selhah-a, jachat umtah-a kasoding, chule nangma vetset umtah-a kakoiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hung hiti ding ahi, mihem namu jouse chu nanga konin jamuntin, chule Nineveh ahomkeovin akijamtai atidiu ahi: chutengle koijin ama akapi ding hitam? Nangma nalhamon dinga chu hoija kahol ding hitam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Vadungho lah-a ana chengah, akimvel twijin aumkol, twipilen chu akulpia panga, chule akulbang twipilen'a kona umdoh miminthang No-amon mite sanga nangma phajo nahim?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ethiopia le Egypt chu amanu thahatna ahin, hichu akhonna bei ahi; Put le Lubim chu napanpi-a ahilhone.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijongle amanu puimangin aumin, gal hinga kaimangin aumtan ahi. Achate donglai hojong chu khopi lamlen ho chungvuma ahal halla chilngemin aumtaove; chule amahon ja um miho-a din vang asanun, chule amilen hou chu thihkhaovin akanun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang jong ju nakham ding; nangma sela naum ding, melma jeh-a jong nangman thahatna nahol ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Namundet ho jouse chu theichang phunga amin masapen theichang ho tobang hiding; hicheho chu akiholinga ahile, anedingpa kamsunga chu khelut dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vetan, nalah-a um namite hi numei ngen ahiuvin; nagamsunga um kotpi ho chu namelmate ho-a dinga lentah-a hung kihong ding; nabanggol ho meijin akahvam ding ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Umkhuma naum nikho-a dingin twi kithalin, namundet ho chu khodetnin, leingan umna-a chenlang bon ngan chilin, chule cheh kiseho chu sudetnin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chua chu meijin nakahvama, chemjamin nasat tanding, hichun nangma thinglung banga naneh chaiding ahi. Nangma thinglung banga tamin kisemin, khaokhote banga tamin kisemin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangman nasum kolvei ho chu van'a ahsi ho sanga tamjon nasupung tan; thinglungin anesen, aleng mangtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Napipui hou jong khaokhote bangbep ahiuvin, nagal lamkaite chu nilhah nidaija honpal chunga umji-a khaokhopi ho abangun ahi. Ahin nisa ahungso tengle alengmangun, hoilaija aumu akiheji tapoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo Assyria lengpa, nakelngoi ching ho a-imulhu gamtaove: namilen namilalte chu vutvai lah-a cheng ding ahiuve: namite hi molle lhang chung dungho-a akithecheh gam taovin, chule amaho koiman apui khom pouvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nakisuh khah na hin damna aneipon, namaput hi asesoh tan; nakisuh khah thu jajousen nachunga akhut abehdiu ahi. Ajehchu nakhangitlou boljingna koichunga alhun khah louna umem?
  </para>
</usx>
