<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2TH" style="id">2 Thessalonica</book>
  <para style="h">2 Thessalonica</para>
  <para style="toc1">2 Thessalonica</para>
  <para style="toc2">2 Thessalonica</para>
  <para style="mt">2 Thessalonica</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Paul, Silvanus, chule Timothy'n i-Pau Pathen le Pakai Jesu Khrista-a um Thessalonica houbung mite hengah:
  </para>
  <para style="p">
    <verse number="2" style="v" />Pa Pathen le Pakai Jesu Khrista-a konin naheng uva lungsetna le lungmonna umhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sopiteho, natahsanu hakhana akhantouva chule nangho khatle khat kingailutna aletset tahjeh hin, nangho chungchanga Pathen kathangvah dingu hi kabol ding dolu ahin, kakin mongu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichea chun nanghon bolsetnale bol hesohna nathoh chengseova nathoh hatnaule natahsan jeh-u chun, keihon Pathen houbung ho chengsea nangho paopin kaneijui.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen lenggama dinga lomma sim nahitheina dinguva, Pathen gam jeh-a nanghon hesoh genthei nathoh-u ahin, hichu Pathen chonphatna thutan dihtah kiphon dohna melchihna ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nahin sugenthei hochu gimhesoh na-a lethuh ding chu Pathen'a dinga thil dihtah mong ahi:
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho suhgentheija umho chu, Pakai Jesu athahat loupina vantil chengsetoh van'a kona ahung kilah teng, keiho toh thakhatna icholdo khom dingu;
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen helouhole I-Pakaiyu Jesu Khrista Thupha joplou chengse chunga meikong deujeju-a phu alah ding,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai ang sunga konle athahat aloupina-a kona amaho chun tonsot manthah na talent athohgim dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche nikho chule ama amithengte-a loupi dingle atahsanho chengsea (Keiho thu hettohsah natahsanu ahitan) kidangtah-a choi-atna umdinga hungding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichejeh chun i-Pathen'un nangho nakikou nao toh kilom ahi tia ataija, chule thilpha jousele tahsan natohho jouse athahat athilbol theina-a alolhinsah theina dingin, keihon nangho dingin kataopeh jingui;
  </para>
  <para style="p">
    <verse number="12" style="v" />chule i-Pathen'ule I-Pakaiyu Jesu Khrista milungsetna dungjuija, I-Pakaiyu Jesu Khrista min chu nangho-a choi-atna auma, chule nangho jong ama-a choi-atna naum theina dingu, katiu ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sopiteho, I-Pakaiyu Jesu Christa hung dingle ama koma ikikhop dingu thudola hichea hi naheng uva kangeh ahi,
  </para>
  <para style="p">
    <verse number="2" style="v" />lhagao khattou sei ahiloule, keiho sei hi ahi, tia thu kiseija konin hijongle, keiho sut hi ahi, tia kei lekhathot khattou ahima kon hijongle, lunglinglao loi hih-un; Christa nikho chu ahung lhunga ahitai ti gel loujenun; lung jong lunggim hihhelun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Koima imachan kilhep lhahsah hih-un; ajeh chu lhahmang na hung lhung masa ding, chule dan suse-a chonsepa, mangthah chapa chu, hung kiphongdoh ding,
  </para>
  <para style="p">
    <verse number="4" style="v" />ama chun dou apat ding, Pathen minpu jousele hou jouse chunga ama kichoi sanga, Pathen houin kisana jong hung touva hung ki pathen sah ding ahinalaije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nakom uva kaum laija hiti thuho kasei jouse chu nageldoh lou uham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule ama chu ama phattah-a akiphondoh ding, ipin akham ahi nanghon naheuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu dan suhsetna thuguh chun tu-a jong hi na atoh jingsa ahi; lahmanga aum kahse-a hi atuhtanga khat uma ahibouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hiche teng chule dan suse-a chu hung kiphongdoh ding ahi; ahinla Pakai kama kon lhagao chun ahalvam ma chule ama hung kilah-a chu asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichepa hung chu Satan natoh dungjuija thilbolthei thahat le melchihna chule jouthil kidang bol chengsetoh hung kitho ding ahi,
  </para>
  <para style="p">
    <verse number="10" style="v" />chule amangthahho chengse chu chonphat louna jouse-a doha lhep lhah-a um ahiuve; hichu amahon huhhing-a aumna dinguva, ngailutna thutah chu alah lou jeh-u ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hichena dinga hi Pathen'in amaho chunga chu suhkhel lamvaina natoh alhunsah ahi; chutia chu amahon thujou chu atahsan dingu;
  </para>
  <para style="p">
    <verse number="12" style="v" />thutah tahsan louva chonset alunglam hijoho jouse thu kitan ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amavang, Pakai ngailut sopiteho, nangho chungchanga imatihchana Pathen thangvah hi kakinu kabol ding dolu ahi; ajeh chu Lhagaova kona thenna-a chule thutah chu tahsan vanga atil abula pat Pathen'in huhhing-a umdinga nangho nalhenu ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule chuche lung ngaito-a chu I-Pakaiyu Jesu Christa loupina chu chang thei dinga kathuhil-u Kipana Thupha-a nakouvu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh chun, sopiteho, pangdet jingun, kathuseiju hijongle, lekha thot hijongle, kahilna chengseu hi abonchan tuhdet jingun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun I-Pakaiyu Jesu Christa amatah-in, chule eingailua tonsot lungmonnale kinepna phatah lungset tah-a eipe-a, Pa Pathen chun nalungu monsah hen,
  </para>
  <para style="p">
    <verse number="17" style="v" />chule thilpha bolna lam jouse-ale thupha seijah nalungu chu phutdet jingun.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ajona-in, sopiteho, nangho lah-a banga chu Pathen thu gangtah-a achala aloupidohna dingin,
  </para>
  <para style="p">
    <verse number="2" style="v" />michonsehole migilouho khutna kona kasochat theina dingun, keiho dingin neitaopeh jiuvin; ajeh chu koijakai jousen tahsan na aneipoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahivangin Pakai chu tahsan umtah ahi; amatah chun naphudet dingu chule agilouva kona chu nahuhdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule kathupeh chengseu chu nanit jingui, chule nit jong nit jingunate, ti Pakaiyah nangho thudol ginchat kaneijui.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pakai chun nalungu Pathen ngailutna lamale Christa thohhatna lama kaihoihen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sopite, I-Pakaiyu Jesu Christa mina nangho hiche thuhi kapeh nahiuve, sopi koi hile dan ngailouva chona, chule keiho-a kona nakihilnao banga chon lou chu kivoppi hih-un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon keiho umchan natho dingu adol ahi chu nanghon nakihet naove; ajeh chu keiho nangho lah-a dan ngailouvin kachonpouve;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman beijin koimacha an kanepouvin ahi; ahin nangho koima chunga poh gih pohsah louna dingin, sunle jan-in katong gimun pontho tah-in na katongun ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichu kahi thei lou jeh-u ahipoi; nanghon keiho umchan nathona dingu, nangho anga vettoh-a tho dinga kachuti chonu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Natong nom lou chun an jong nehdahen, tia nalah uva kaum laija nangho thu kapehsa nahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajeh chu nangho lah-a abang khat dan ngailouvin achonun, natong louvin mi natoh sinmon avahlen ahi, ti kajauve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitobang mi chu Pakai Jesu Christa mina thu kapeh-a katil nahiuve, thipkhen chan na tonghen lang ama an kinehhen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sopiteho, nangho vang thilpha bol chimtih nei hih-un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hiche kalekha thot sunga kisun keiho thu ngailou chu nanghon ama chu melgelun, ama chu kivoppi, kiloipi daovin, ajachatna dingin;
  </para>
  <para style="p">
    <verse number="15" style="v" />ahivangin melmah lungin gel hih-un; sopi tin tilkhoujovin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun chamle lungmon kona Pakai amatah-in imajousea nangho chamle lungmon pe jingun. Pakai chun nabonchaovin umpi jingun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kasalamna hiche lekha hi keima Paul'in kakhut tah-a kasut ahi; lekha thot jouse amelchihna ahi, hitia hi kasutji ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />I-Pakaiyu Jesu Christa milungset chun nabonchaovin umpi jingun, Amen.
  </para>
</usx>
