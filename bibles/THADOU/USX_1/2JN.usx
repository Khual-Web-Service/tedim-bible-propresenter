<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2JN" style="id">2 John</book>
  <para style="h">2 John</para>
  <para style="toc1">2 John</para>
  <para style="toc2">2 John</para>
  <para style="mt">2 John</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Upa keiman thutah-a kangailut numei kilhengnule achateho; keima changseh hilouva, thutah heho chengse jong;
  </para>
  <para style="p">
    <verse number="2" style="v" />Eiho sunga uma, chule eiho toh tonsot geija umjing ding thutah jala chu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pa Pathen le Pa Chapa Pakai Jesu Christa-a konin lungsetna, hepina, chule lungmona chun, thutah le ngailutna-in naumpi jing taohen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pa-a kona eihon imu-u thupeh bangtah-a, nachateho lah-a kimkhat thutah-a achonu kamun kakipah tangei jenge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule tu-a hi, numei pha, keiman nahenga thupeh thah hinsun tobang hilouva, atil abula ineisao, khatle khat ikingailut tocheh dinguva nahenga kahung tao ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hiche hi ngailut ahi, eiho athupeh dungjuija ichon dingu ahi. Chule hiche hi thupeh ahi, nangho atil abula najahsao banga chu, hichea chu nachon dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu Jesu Christa chu tahsa-a hunga ahi ti janomlou vannoi'a hin doha milhem lha-a tamtah ahung sohdoh tai. Hiche hi milhem lha-a le Christa dou chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Iboldohsa chengseu chu mansah louhela tohphat man isan bukimna dingun, kive phaovin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koi hile dan palkeh-a le Christa thuhila um louva chun Pathen aneilou ahi. Christa thuhila uma vang chun Pa le Chapa chu ania aneikop ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Koi hile hiche thuhil hinpolouva naheng uva hunga aumle, amachu na-in uvah lhunsah hih-un, chule kamphan jong lem hih-un:
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajeh chu koi hile kampha-a lema chun achon gitlou ho jouse achan khompi ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Naheng uva hinsut ding thu tamtah kaneije, ahivangin lekhapheng le lekha twija sut kanompoi; ahin ikipanao achamkim theina dingin, naheng uva hunging ting kimaiton kihoulim naohite ti kakineme.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nalhen tumtah nasopinu chaten salam napeuve. Amen.
  </para>
</usx>
