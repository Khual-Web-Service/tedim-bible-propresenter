<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2TI" style="id">2 Timothy</book>
  <para style="h">2 Timothy</para>
  <para style="toc1">2 Timothy</para>
  <para style="toc2">2 Timothy</para>
  <para style="mt">2 Timothy</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Christa Jesu'a um hinna thutep dungjuija Pathen lunggot tah-a kipansah Jesu Christa solchah, Paul'in,
  </para>
  <para style="p">
    <verse number="2" style="v" />kacha ngaitah Timothy hengah; Pa Pathen le I-Pakaiyu Christa Jesu'a konin lungset, hepi chule lungmon nachungah umhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kapute kapatea kona sele pha hetna thenga kahou Pathen chu thangvah jia katao lai chana nangma geldoh jinga um kahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Namit lhi lon chu kageldoh jingin, kipana kadim theina dinga, nangma mu noma asun ajana tao jing jeng kahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tahsan kijentah nanga aum chu kageldoh jinge, masanga napi Lois lung sungle nanu Eunice lung sunga chenga chu, nang lung sunga jong achen kagingchai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh-a chu keima khut ngap vanga Pathen thilpeh nanga umchu nakonsah jing theina dinga, kahin geldohsah kit nahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu Pathen'in eiho kichatsetna lhagao eipepouve, thilbolthei thahat le ngailut, chule lungthim themna lhagaobou eipeh-u ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun I-Pakaiyu thu hettohsah thulam dolle asohchang keima chungchang thudola jong jahcha hih helin; ahin Pathen thilbolthei thahat dungjuijin Kipana Thupha jala thoh hahsa hi neithohpin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Amatah chun eihuhhingu ahi, chule kouna thenga eikouvu ahi; eiho natoh dungjuija ahipoi, ama lunggotle amilungset dungjui-a bou ahi; hiche lungsetna chu tonsot tonsot masang peh-a Christa Jesu'a eiho eina pehsao ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahin tu-a vang Eihuh hinga Christa Jesu hung kilah-a kona kilangdoh ahitai, aman thina asubeijin Kipana Thupha-a hinna le thilouna chu vah-a ahinpoh ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche Kipana Thupha lama chu keima chidang namdang te henga lhangsamle solchah chule houhila panga kahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu hesoh genthei hichengpi hi kathoh ahi; ahinla kajahchapoi; ajeh chu katahsan chu keiman kahei; chule avop dinga akhutna kapehdoh chengse chu chuche nikho-a dinga chu voppha-a hongbit thei ahi, ti katahsan kichene.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima-a kona najah thupha kichehho vettoh-a jui ding dol chengse chu Christa Jesu'a um ginchatnale ngailutna chun tuh jingin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangma kipe-a thilpha chu eihoa chenga Lhagao Theng chun hongphan.
  </para>
  <para style="p">
    <verse number="15" style="v" />Phygellus le Hermogenes teho Asia gama um chengsen einung ngatsoh taove, hichu nangin nahenai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Onesiphorus insung mite chu Pakaiyin hepihen; ajeh chu aman kalung asuhal matchet jingjin ahi; chule kabulput jong ajachat pipoi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin Rome kho-a ahungin jong gunchu tah-in eiholin eihung holdoh jengin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakaiyin ama chu hiche phattheina hi pehen, hiche nikho ni chule Pakai koma hepina changhen; chule Ephesus kho-a alhacha natoh nasatje chu nangman nahenai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti ahi jeh chun, kacha, nangma Christa Jesu'a uma lungsetna-a chun thilboltheina thahat neijin umin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule ahetoh tamtah ang sunga keima-a kona najah chengse chu ginchat um miho chu pedoh-in, amaho jong chun midangho ahil thei dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangman Christa Jesu sepai phatah bangin ahahsa kathohgim hi neithohpin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sepai galsat pet koima tu hinkho-a khankho ding gelnan akisunoh jipoi, pha sa-a sepaija apansahpa lunglhaisah dingbou alung ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule golseh kitetna jenga jong khattouvin gol jona dingin kihabol nama jeng jongle, dan ngaitah-a abol loule, lal lukhuh akhuhjipoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Loubol mi natongima chu agam ga chang masapen dingdol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kasei hi ipi ahi geltohin; ajeh chu Pakaiyin imalam jouse-a lungthim napeh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kathuhil Kipana Thupha dungjuija, athi lah-a kona thoudoh kit, David chilhah Jesu Christa chu geldoh jing jengin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche Kipana Thupha jeh-a chu keima akhanggilou banga bulput geija hesoh genthei kathoh ahi; ahivangin Pathen thu chu akihentang dehpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh-a chu keiman lhenchom ho dinga, amaho Christa Jesu'a um huhhingna chu achan theijuva tonsot loupina chutoh anei theina dinguva, hichengpi hi kathohgim ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche kisei hi ginchat umtah kisei ahi, Athina-a ithiule ahinna-a jong ihin dingu;
  </para>
  <para style="p">
    <verse number="12" style="v" />Athoh chu ithohpiule avaipoh jong ipohpi dingu ahi; eihon ama seilepleu hen, aman jong eiseilep dingu ahi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Eiho ginchatna bei ihiule, ama chu ginchat umtah hijing ahi; ajeh chu ama kiseilep thei lou ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman thu hicheng hi geldohsah jingin; phatchomna bei moh thu pouva akinel baotam louna dingun, Pakai anga hilchahjin; amaho dinga mansuhna ahibouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma kipatep themchang banga Pathen'a kipehna dingin, gunchun ponpanin, jachatna beihel natong mi hin, thutah thu chu jangkeichan homjallin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amavang Pathen jalouna, hou seisetna, moh thu mai maija konin kihei mangin; ajeh chu chutobang deiho chu Pathen ngaisahmo na lama chal tou cheh cheh ding ahiuve;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule athu-u jong chun masemon nehkem banga aneh dingu ahi: alah uva lha-a chu Hymenaeus le Philetus ahilhone;
  </para>
  <para style="p">
    <verse number="18" style="v" />Amaho chu thutah lampia kona petmanga ahiuvin, amahon Thokitna chu kichaisa ahitai atiuvin, mi kimkhat tahsanna alehei taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla Pathen khombul phu dettah chu ading jingnai; achunga hiche thuhi Kinama ahin, koi koi ama-a ahi Pakaiyin ahenai. Chule, koi hile Christa min pana chu chonphat louva konin kikhin manghen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang inpi sunga khun sanale dangka bel jeng uma ahipoi, thingle leibel jong aumin, hicheho chu abang sahlut dol aumin, abang sahlut lou dol aume.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichenga kona kithensodoh chu ama chu sahlut doltah ahi, akisutheng ahin, Pakai natonga lomtah ahin, chule thilpha bolna lam jouse-a dinga kigosa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangma vang gollhanlai lungtup lungngaija konin jamin; chule chonphatna, tahsan, ngailut, lungmon, chule lungthengsela Pakai henga taoho toh pumkhat hina hicheng chu hadelin,
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahin ngolkaile lungthimbeiho kinelna-a lhah ding nom hihhelin; hichea kon chun kinahna asohjin ahi, nahei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakai soh chun doubol angai ahipoi; chusanga chu mi jouse dinga nunnema, mihil thema, lungdehat ding,
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule lungnema adouho chu apuijang dingjoh ahibouve; chutia chu Pathen'in ijem tia thutah hetna lama lungheina apeh khatle;
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama lunggot lama Diabol'in gal hinga amatnao thangkola kon chun kiteldoh thei khat nunte.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amavang hiche hi heuvin, ni nunung lamle phat hahsa khohtah hung lhung ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche teng chule mi amachangmai kingailua, sum ngailut, nomham, huset le hoitho, taitomhat, nu thu pa thu ngailou, phatna ngaisah lou, then louna,
  </para>
  <para style="p">
    <verse number="3" style="v" />Lungsetna neilou, kihou champi mohel, hehset hat, ti kitimlou, kichat um, phatna ho-a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Tahsan pailha, kichamsah,kiletsah, chule Pathen ngailut sanga nopsah ngailut johna;
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen ngaisah lhem-a athahat athilbol thei janom lou, hicheng chu hung umding ahi; hichenga kon jong chun kihei mangin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho lah-a kimkhat doha lungthimin mi ina alutjiuvin, chonset pohgih po-a, lung ngaichat tamtah puilonle,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule akihil jing vanga thutah hetheilou numei lungthimbeiho chu alhem lhaovin, gal hingin amanjiovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Jannes le Jambres in Mosi adoudal lhon bang banga chu hiteho jong hin thutah chu adoudalu ahi; lungput sesa, tahsan lam thua Pathen deimo mi ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin amaho chu gamlatah mason lou ding ahiuve; khatteni banga chu amaho jong angolnao chu mi jouse jah-a kisei phongle ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangma vang kathuhil, kanun kakhan, kalunggot, tahsan, thohhat, ngailut, lungdehat, bolsetna tintangle, hesoh genthei kathoh nungjuija nahi tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Antioch kho-a, Iconium'a chule Lystra kho chengsea kachunga itobang thu sohtam, bolsetna ijat kathoh hitam, ahin Pakaiyin chutiho jouse-a kon chun eihuhdoh tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule koi hile Pathen ngaisah kijentah-a Christa Jesu'a hinding lung go chan chun bolsetna athoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin migilouho chule milhemlhaho vang chu setna lama khangtou cheh cheh ding ahiuve; amaho doha kilhemlha ahiuvin, doha alheplhah dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin nangma vang nakihilsa chengsele naphotchensa chengsea chun dingdet jingin; koi koija kona kihila nahi nangman nahenai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule huhhing-a umna dinga nachihsah thei Pathen lekhabu theng chu nachapan laija patna nahin hetsapeh ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathen'in ahaikhum Pathen lekhabua thu kisun chengse chu kihilna-a, kiphona-a, kipuijangna-a, chonphat kisinsahna dinga phatah ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />chutia chu Pathen mi chu pha chamkim keija, thilpha bolna lama chamkim keija kigosa dema um thei ding ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh-a chu keiman Pathen anga ahingle athiho thu tan dinga Pakai Jesu Christa anga, ama hung kilahna le alenggam chu pana guntah-a kahilchah nahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Thu chu hil lhanglen; aphatle aphat louva jong kigosan umjing jengin; lungnengin hiltoh thonlang, athemo nao hetsahjinlang, sosaljin chule tilkhoujin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu hitobang phat hi hung lhung ding ahi, mihon thuhilpha kicheh chu angai thei lou ding, akolu thah tuntuna ama ama lung ngaichat dungjuija, mihil akikhop khom dingu ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule thutah-a kona anau ahei manguva, moh thusim lama lamvai dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin nangma vang imalam jouse-a limgehchan um jingin; thohhahsa thoh-in, evangelist na chu tongin; nalhacha natoh chu bulhit molson.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajeh chu tu-a hi keima eikipedohsa ahitai, kapotdoh phat hung lhunga ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Golseh phatah chu kaseh joutai, kalhaitetna kachaitai, tahsan chu kamolsoi,
  </para>
  <para style="p">
    <verse number="8" style="v" />tu-a kipat hi keima dinga chonphatna lal lukhuh chu koisa uma ahitai; chondih-a thutan Pakai chun hiche nikho ni chule eipeh ding ahi; keima chang jenggoh hilouva, ama hung kilah ngailu chengse jong chu apeh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaheng lama hungvahna dingin hung kihabolin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Demas'in tulai vannoi leiset angailut jeh-in, keima eidalhan Thessalonica'a achetai; Crescen Galatia lama achen, chule Titus Dalmatia lama achei;
  </para>
  <para style="p">
    <verse number="11" style="v" />Luke changseh keimatoh kaume. Mark hinpuijin hung lhonin; ama chu lhacha natohna-a kadinga phachom tah ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tychicus vang Ephesus lama kasoltai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Troas khopi-a Carpus khutna kasangkhol len kadalhah chule lekhabu ho, ahideh-a savun lekhabu ho chu, nahung tengle hinpon.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alexander sumsan kheng chu kachunga akhang gilou lheh jenge; athilbol dungjuijin Pakaiyin lethuh nante.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangjong ama lama chun hung kihongphan; ama chun ithu-u hi hadouvin adoudalin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keima kakihona thu kasei masahpen chun koimacha eipanpi aumpon, mijousen eidalha sohkeijun ahi; hichu amaho themon kisim hihhen tia Pathen henga katao ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Achuti vangin keima vanga thu chu hillhanga aum sohkeija, chidang namdangho jousen ahet theina dingun, Pakai chun eidinpin eihat sahtai; hichun keipi kam sunga kon chun kasohchatan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai chun gitlou thilbol jouse-a konin eihuh doh-intin, avan gama dingin eihuhhing nante; Minlet loupi chu tonsot tonsot geijin ama-a hi jinghen. Amen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Priscilla le Aquila chule Onesiphorus insung mite chu salam'in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Erastus Corinth-a aumdentai; Trophimus vang anat jeh-in Miletus-a kadalhatai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangma phalbi kah-a hung dingin hung kihabolin. Eubulus teho, Puden teho, Linus teho, chule sopite jousen nasalamui.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai Jesu Christa'n nalhagao umpihen. Nabonchao chunga Pathen lungsetna umhen, Amen.
  </para>
</usx>
