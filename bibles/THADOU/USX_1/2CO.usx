<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2CO" style="id">2 Corinth</book>
  <para style="h">2 Corinth</para>
  <para style="toc1">2 Corinth</para>
  <para style="toc2">2 Corinth</para>
  <para style="mt">2 Corinth</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen lungcham tah-a Jesu Christa solchah-a pang Paul leh, sopi Timothy'in Corinth-a um Pathen houbung te, chule Achaia gam sunga um mithengte jouse henga,
  </para>
  <para style="p">
    <verse number="2" style="v" />i-Pau Pathen le Pakai Jesu Christa-a konin, lungsetnale lungmonna chun umpiuvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen, I-Pakaiyu Jesu Christa Pa chu vahchoijin umhen, Ama lungsetnaho Pa leh lungmonna jouse Pathen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keihon Pathen'a kona lungmonna kaneiju, hiche lungmon na-a chu hesoh gentheija umteho kalungmonsah theina dingun, hesoh gentheina lah-a jong aman eilung monsah jingjiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Christa thohgimna chengse keiho-a adimset bangin, Christa vangin lungmon na-a kadimset jingui.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin keihon hesoh genthei kathoh-u aumle, hichu nangho lungmonna dingle huhhing-a naumna dingu ahi; lungmonga kaumu jongle, hichu nangho lungmonna dingle huhhing-a naumna dingu ahi; hichu keiho thohjiho tobang hesoh gentheina lungneng tah-a nathoh naova kona nahetdoh-u ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nanghon hesoh genthei thohna lama chan naneiju banga, lungmonna lama jong chan nanei jingu chu kahen, kakineppi nau adet jinge.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sopite, Asia gama kachunguva hesoh genthei chua chu nahet lou dingu kanompoi, thohjouhoi hilou kathauvin ajo kalvalin nasatah-a eidelpha jengu ahin, hing dinga jong kakihol louvu ahitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin keihon kalung sungun, keihole keiho-a kitahsan louva athiho kaithouva Pathen chu katahsan johna dingun, kathina dingu ahung lhunge, katiu ahitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama chun chutobanga len thina-a kona chu eina huhdoh-u ahin, chujongle eihuhdoh dingu ahi; ama chun tu-a jong eihuhdoh dingu ahinalaije, tia ama-a chu kakinepnao phutdet kahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi tamtah vanga lungsetna thilpeh eikipeh jeh uva hi, mi tamtah-in keiho chungchanga athangvah theina dinga, nangho jong nataonaova eikithopia nahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijeh-inem itile kakisonnao chu hiche hi ahi, kalung sunguva ase apha hetnan eihettohsah-u chu, vannoi mite hengah, chule atamjo cheh-a nangho lamah, tahsaphe lam chihna hilouva, Pathen lungset vanga Pathen thenna le kitahna-a kanachon jingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanghon sim jong nasim uva, het jong nahetchet sao thu tailou chu keihon nangho henga thu dang ima kasunpouve. Chule akhon ni geijin heuvin nate tin kakineme.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanghon keiho neihet phot thimu banga chu, Pakai Jesu nikho nileh nangho kisonna ding keiho kahiu banga, nangho jong keiho keisonna ding nahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hiche tahsanna-a hi, nivei phatchomna nanei theina dinguvin, nangho henga hung masaleng kati ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Macedonia kacheteng nangho kom hin hopangting, Macedonia'a konin nangho henga hungkit ingting, chule nanghon Juda gam lama neithah leuchun kati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh-a chu, hitia lung kaput hi, thil neocha dana kalahham? ahiloule kalunggot chengse hi, tahsaphe dungjuija, ahile ahi, ahi loule ahilou, tia kahim?
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla Pathen athutah bangin, nangho lama kathu-u chu, ahile ahi, ahi loule ahilou, ahipoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajeh iham itile nalah uva keihon, keimatah le Silvanus chule Timothy'n, kalhangsap leu Pathen Chapa Jesu Christa-a chun, ahi leh ahilou, aumpoi, ama-a chun Ahi aumbouve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajeh chu Pathen thutep jouse chu Ama-a chu Ahi chu uma ahi; hijeh-a chu keiho-a kona Pathen loupina dinga, ama vanga Amen hijia ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Christa-a nang hotoh eiphutdoh, chule thao einua chu Pathen ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama chun namdet einam khumuva, chule ilung sunguva Lhagao khamgah na-a eipeh-u ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangho hoidohna dinga tu geija Corinth-a hung louva kahitai, hiche thua hin kahinna chunga ahetoh dingin Pathen kakouvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Keiho nangho tahsanna chunga vaipo-a kahipouve, nakipanao chu hujoa kahibovui. Ijeh-inem itile nangho tahsana-a nading detnaove.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin keima changtumin hiti hin kangaitoi, tukallin lungphamon naheng uva hungtaponge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh chu keiman nangho lung phatmo sahleng, kalung phatmo sahte tailou chu keima eikipasah dinga koiham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima kipana-a nangho kipah uvin nate ti kagingchan, eikipasah dingho chengse chun kahungteng eilung phatmosah khante tia, hiche thu chu kahinsut ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nalung phatmona dinguva hilouvin, keiman nangho kangailut jeu hi nahetdohna dinguva, lunghesoh, lungkham chule mitlhi tamtah puma hiche thu chu kahinsut ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla, lung phatmo sah-a mi khattou auma ahile, keima eilung phatmosah ahipoi, kahabol khoh behseh louna dinguva, ichanham khatna nabon uva nalung phatmo sah-u ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi atamjoa kona chutobang mihemin talent amuchu, ama dinga phaset ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti ahi jeh chun nanghon nangaidam uva, nalungmonsah joh uva pha ahi; ajole chutobang mi chu lungphatmo behseh-in val lhum getninte.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu naheng uva katao ahi, nanghon ama nangailut nao chu sudetnun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangho imalam jouse-a thungai nahiule, nahilouvu photchetna dinga jong kahinsut ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanghon nangaidamu chu keiman jong kangaidam ahi. Keiman kangaidam-a ahile, Christa maikoh-a nangho jala kangaidam ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichu Satan'in ichunguva machalna thei agomkom atokhah louna ding ahi; ajeh chu eihon ama doha lungthim ihaiju ahipoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Christa Kipana Thupha hila Troas'a kahunga, chule Pakaiyin keima dinga kot khat ahon chun,
  </para>
  <para style="p">
    <verse number="13" style="v" />Kasopi Titus chu kamudoh lou jeh-in, lung olna kaneipon ahi; ahin amaho-a konin kakilha doh-in, Macedonia gam lama kachetan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin a-imatih chana keiho Christa-a galjona-a eipuile jinguva, Pathen chu thangvah-in umjing hen; aman keiho eimangun ama hetna gimnam chu muntin-ah aphong jallen ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huhhing-a umhole amangthahho dingin, Pathen lama Christa gimnamtui kahiuve;
  </para>
  <para style="p">
    <verse number="16" style="v" />Loi khat dinga thina-a kona thina gimnam kahiuvin, loi khatte dingin hinna-a kona hinna gimnam kahiuve. Chule hicheng dinga lhinga koiham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi tamtah-in Pathen thuhi miho doha bola sumkolveinan amang chaovin, keiho vang chutobang kahi pouve; kitahtah-a Pathen thupeh bangbanga, Christa-a Pathen mitmu-a thu kaseiju ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiho kiseipha pan kit kahiuvem? Ahiloule midangho banga, nangho henga ahim, nangho-a kon ahima, seiphatna lekha ngaija kahiuvem?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanghotah chu kalung sunguva kisun kalekha thotnu, mi jouse het le sim nahiu ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho Christa lekha thot nahiuve, keiho lhacha natoh-a kon; lekha twija kisun hilouva, Pathen hing Lhagaova kisun; songphenga hilouva, lungthim tahsa phenga kisunjoh nahiuve ti kichentah-in akilange.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Christa vanga Pathen lama hitobang tahsan hi kaneiju ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichehi keiho-a kona ahi ti dingin keiho chang kalhingjou pouve, kabulhinnao hi Pathen'a kon ahibouve;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amatah-in kitepna thah lhachale-a eibulhin sah-u ahi; lekhajem'a hilouvin lhagao kitepna lhachajoh ahi. Ajehchu lekha jem chun athatjin, lhagao vang chun ahinsahji ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin thina lhacha-a panna, songa kikhena kisun jengbon chubang tah-a chu aloupi-a, avah kemsuhsuh ding Mosi mai chu avahpempum jeh-a Israel chatehon hoitah-a avet thei lou uva ahileh;
  </para>
  <para style="p">
    <verse number="8" style="v" />Achutile Lhagao lhacha natoh chu iti haloupi johcheh louding ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijeh-inem itile themmo channa lhacha natoh bon aloupi-a ahile, chonphatna lhacha natoh chu nasajo cheh-a loupia ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ijeh-inem itile loupi kisa-a chu loupina nasajo chun akhokheltah jeh chun, hichea hin loupina aneitapon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amang theija bon chutia aloupi-a ahile, imatih chana umjing ding chu gamchenga loupijo cheh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutobang kinepna kanei jeh uva, hakat tah-a thu kaseijiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Akemsuhsuh chu Israel chaten avet lhumkei louna dinguva ponlu kikhua, Mosi tobang chu kahipouve;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla amaho chu alungu atahjo chehtan ahi: ajeh chu tulai gei jong hin Kitepna lui chu asimlai chanun chuche ponlukhuh chu hodoh louvin aumjing nalaije; ajehchu hiche ponlukhuh chu Christa-a lahdoh-a uma ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin tuni gei hin Mosi lekhabu asimlai chanun, alunguva chuche ponlukhuh chu aum jinge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin mihem khat chu Pakai heng lama akihei teng, aponlukhu chu kilamangji ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tun Pakai chu Lhagao ahi; chule Pakai Lhagao umna chana chu, chamlhatna uma ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Eiho chengse vang, maikhu louva phatvet sunga kive-a banga, Pakai loupina chu ivet jinguva, Pakai Lhagaova kon, loupina-a kona loupina lima kikhela ihiuve.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche jeh-a chu keiho hepina kachan uva, hiche lhacha-a panna kaneiju hi, keiho kalhadah hihhelui;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin jachatna thil kisel chengse kapai lhaovin, doha lungthimin kachonpouvin, chule Pathen thu chu mi lhep lhahnan kamangpouve; ahin thutah chu kaphongjalun, Pathen mitmu-a amitakip sele pha hetna henga kaum chanu photchena musah kahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule kakipana Thupha jong hi maikhu kikhua ahile, amangthahho dinga maikhu kikhua ahin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen lima um Christa Kipana Thupha loupitah chun amaho chu asalvah louna dinga, amaho sunga chu hiche vannoi pathen'in atahsan louho lungmit asuhchot ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu keihon keiho hilouva, Christa Jesu chu Pakai ahi tia, chule keiho Jesu jala nangho soh kahiu chu kalhang sapleu ahibouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu, Muthim lah-a kona vah hung vahdoh dinga thupeh neijachu Pathen ahin, Jesu Christa maija Pathen loupi hetna chu avahdohna dinga, ama chun kalungu asalvah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin thilboltheina chungnung tah chu keiho-a kon hilouva, Pathen'a konjoh ahina dinga, hiche gou chu keihon leibela kachinu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hoima lam jouse-a nehchinton kaum un, ahinla kisudongin kaumpouve; lungdongin kaumuvin, ahinla kalunglha pouve;
  </para>
  <para style="p">
    <verse number="9" style="v" />Suh gentheijin kaumun, ahivangin dalhah-in kaumpouve; eikivolhu vin, ahivangin suhset helin kaumpouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kavalena chanuva katichung uva Jesu hinna chu akiphon theinan, katichungu vah Pakai Jesu thina chu kapole jingui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijeh-inem itile keiho ahing chengse hi katahsao thi theija hi Jesu hinna akiphondoh theina dinga, Jesu jala athi dinga pehdoh jinga um kahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutia chu keiho-a hi thinan na atoh ahin, nangho-a hinnan atoh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Katahsan jeh-a thu kasei ahi, tia kisun banga chu, hiche tahsanna lhagao mama chu kaneijuva, keihon jong katahsan jeh uva thu kaseiju ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai Jesu kaithouva chun, keiho jong Jesu toh thakhatna eikaithou dingu, chule nang hotoh a-anga eidinsah dingu ahi chu kaheuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu mi tamtah thangvahna jala Lungsetna ahapuna, Pathen choi-atna-a aumna dinga, imajouse nangho jala kibol ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun kalhadah hihhelui; kami ponungu akem jing jeng vangin, kami sungnungu aniseh-in athah cheh athah cheh jon ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ijeh-inem itile chomkhat jengcha dinga kathohjiu hesoh gentheina jangkhai hin, tonsot kemlou loupina chu hasema eisempehbe jing jengu ahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Muthei thilho ve louvin, mulou thilho chu kave jouve; muthei thil chu chomcha khat dinga ahin, mulou thil vang chu tonsotna dinga ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche pon in tobang kaleiset inu hi kiphelha jongle, khutna kisa hilou tonsot in, Pathen'a kona kisa indet chu van'ah kaneijuve, ti kaheuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keihon van'a kachenna dingu in chu kivon ding ngai tun tuna, hiche sunga hi peng penga um kahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuche-a kakivon tengule, sagoh keova kaum lou dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu pon in'a kachen uva pohgih kapoh jeh uva peng penga kahiuve; hichu pon beija kaum nom jeh-u hilouva, athoa kakisil uva, thi theina hi hinna chun aval lhumna dinga peng penga joh kahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hiche dinga eigo uva chu Pathen ahin; khamgah na-a Lhagao eipeuva jong ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh-a chu lungngama kaum jingu ahi, chule hiche tahsa ina kachen laiseuva hi Pakaiya kona gamla kahiuve, ti kaheuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />(Ajeh chu keiho polam mu theija chon hilouva, tahsan vanga chona joh kahiuve);
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungngama kaumu ahi, tahsa-a um louva Pakai koma um kanomjouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh-a chu umu jongleng, umhih jongu leng, kadoiju chu ama lunglhai na-a um kahatup tenu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mitinin tahsa-a athilbol apha hile, ase hile, athilbol dungjui cheh-a atohman asan cheh theina dinga, eiho ibon chaova Christa thupi tanna anga chu ikilah cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh-a chu Pakai kichat umje kahet jeh uva miho kajolleu ahi; ahivangin Pathen anga kilang jingin kaum naove; chule nangho sele pha hetna-a jong kakilang jingui, tin kakinemui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu nangho henga keiho kichang vahchoi kit kahipouve; lungthim thua hilouva kamsung lama kisongte chu nadonbut theina dinguva, keiho lama kisonna naneina dingu phat kapehjoh nahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu kangol-ule Pathen'a ding ahin, kachih-ule nangho-a ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Christa ngailutna chun kachamlou uva eisolu ahi, hiti hin kagelui: mi jouse thi khela khat athia ahile, mi jouse chu athia ahitai;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ahingho chu amaho dinga hing hitalouva, athi kheluva thia thoukitpa ding joh-a hing ahi theina dinguva, mi jouse thi khela thia ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuti ahi jeh chun tukala lhah-in, tahsa lam dola koima kahetapouve; chuti chu ahin masangin Christa chu tahsa lam dolin he jonguleng, tunvang hitobang chun kahetapouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun koi hile Christa-a um chu akisemthah ahi; alui chengse chu amang gama ahitai; veuvin, athah ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule thil jouse hi Pathen'a kon ahin, Aman Jesu Christa jala eikicham piuva, chule kichamna thu lhachale-a chu eipansah-u ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitia chu Pathen chu Christa-a uma, vannoi leiset mite themona-a sun louva, amatoh kichamna aboljoh ahi; chule chuche kichamna thu chu keiho eipehdoh-u ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche jeh-a chu Keiho Christa palai kahiu ahin, Pathen'in keiho-a kona naheng uva angeh banga, Pathen toh kichamun tia, Christa thalhenga naheng uva kangeh-u ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama-a chu Pathen chonphatna ichan theina dinguva, chonset helouhelpa chu eiho khela chonsea asem ahitai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Christa toh natong khom kahiuvin, Pathen lungsetna chu phatchomna beija mu-a nahi louna dinguva kajolu nahiuve;
  </para>
  <para style="p">
    <verse number="2" style="v" />(ijeh-inem itile aman hitin ati, Keiman san phatchan, nataona kasange; Chule huhhing nikho nin nangma kahun ahi. Veovin, tuhi lahphat tah ahi; tuhi huhhingna nikho ahi).
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche lhachale-a kapannau hi nolna aum louna dingin, keihon ilam ilam thu hile kipal lhuhna ding kaumsah pouvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin imalam jouse-a Pathen lhacha kahiu hi, hatah-a lungdehat nin, hesoh gentheina thoh-in, lhasama umin, setto lungkhamna toh-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kijepna thoh-in, songkul'a kihenin, thunoh lungjinna thoh-in, thohgimna thoh-in, imulouva umin, an ngola umin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Thenin, hetna in, thohhat sotnin, hepina neijin, Lhagao Thengin, alhem hilouhel ngailutna-in,
  </para>
  <para style="p">
    <verse number="7" style="v" />Thutah thun, Pathen thahatnin, jetle veija chondihna galvon kivonin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Gunchuna le jalouna-in, seisetle seiphat chanin, aphot chenna kavetsah jingui; mi lhemlha ho kabangun ahinla kitahtah kahiuve;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hetkhamlouho kabangun ahinla minchetah kahiuve; athikon kabangun ahinla, veuvin, kahingnaove; engbolin kaumun ahinla eikithat pouve;
  </para>
  <para style="p">
    <verse number="10" style="v" />Lunghemtah kabangun, ahinla kipah thanom jing kahiuve; vaichatah kabangun, ahinla tamtah kahaosah taove; imacha neilouhel kabangun, ahinla imajouse kanei kimui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Corinth miteho, nangho dingin kakamu akan kalungu akihonglene.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangho keiho-a nehchinto-a uma nahipouve, nangho kichang lunggela nehchinto-a na-umu ahibouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuti chu ahin kapeh bang neipeh theina dingun (chate jah-a sei banga kasei ahi) nangho jong kihong lennun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Atahsan louho toh kitoh louvin namkoljon pokhom hih-un; chonphat le chonset akikopna ipi umam? Muthimle khovah akibahna ipi umam?
  </para>
  <para style="p">
    <verse number="15" style="v" />Belial le Christa akitona ipi umam? ahiloule atahsanan atahsanlou toh ipi chan anei khomem?
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Pathen intheng le milimho kihoutohna ipi umam? Ijeh-inem itile nangho Pathen hing intheng nahiuve. Chutichun Pathen'in jong hitin aseije, Keima amaho lah-a kachena chule kavale ding ahi; chule keima amaho Pathen kahi ding, amaho kamite hi ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti ahi jeh chun Nangho amaho lah-a kon chun hung potdoh-un, chule achomin umun, tin Pakaiyin aseije; Thilboh tongkha hih-un; Chule keiman nangho kasan ding nahiuve,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule keima napau hingting, chule nangho kachapate le kachanute nahi dingu ahi, tin hat chungnung Pakai chun aseije.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun, sopi ngaite, thutep hicheng chu ineiju ahi jeh chun, lhagao le tahsa kisuh bohna jouse-a konin kisuthengu hitin, Pathen gingin thenna-a chamkimin umu hite.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiho-a dingin nalungthimu hongun; keihon koimacha alam louvin kabolpouve, koima kasuse pouve, koima dohan kalhemlha pouve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho themmo sahna dinga hiche hi kasei ahipoi; ithile thikhomsap, ihinle hingkhom dingin kalungsung uva nacheng uve tia, masanga kaseisa ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho lama kahakat lheh jenge, chule nangho lama kakisonna jong anasai; chuti chun kahesohna jouseuva lungmonna kadimsetnin, chule kipana-in kaletset jingin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile Macedonia gama kahungu jong chun, tahsa-a choldona neilou kahiuve; hoima lam jouse-a hesoh genthei toh jinga umjing jeng kahiu ahi; polama eidouva, lung sunga kichat kanei jing jengjiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla mi kisunemte lungmonsah Pathen'in, Tita hung lhun vang chun eilung monsah taove;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule ama hung vang jenggoh jong hilouvin, aman nangho-a lungmonna anei, hiche lungmonna chun eilung monsah taovin ahi; nanghon neingaichat jeu, neilhaset piu, kei dinga nagunchujeu, thu ahung seijin ahile, hichea chun hatah-in kakipah kathanom lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu keiman kahin lekhathotna chu nangho kasuh lunghem jeng vangun kakisihpoi; kana kisih jeng vangin; ajehchu kalekhathot chun nangho chomkhat kahsung hijongle, nalunghemsah lheh jengun ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Keima tun kakipah kathanome, nangho suhlunghema naum jeh-u chu hilouvin, nalunghem nao chun lungheina aso jeh chu ahi. Ijeh inem itile nanghon keiho-a hakamna imacha nanei louhelna dinguva, Pathen lam dola kisu lunghema nahiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu Pathen lam dola lunghem chun huhhing-a umna dinga lungheina asoji ahi; hichun kisihna asojipoi; vannoi leiset lam dola lunghem chun thina asojin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajeh chu, veuvin, Nalunghem nao chu Pathen lunglam dol ahi; nangho-a itobanga kihatup chehna asodoh hitam! nangho dingin: nakisuh thengnao, lungsouna, kichatna, ngaichatna, gunchuna, chule phulahna, asodoh-in; hiche thiljouse-a hi nangho thengsoh nahiu chu naphot chetnu ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche naheng uva kahinsut jeng vang chun, alam louva bolpa jeh-a kahinsut ahipon, alam louva kibolpa jeh-a jong kahinsut ahidehpoi; Pathen mitmu-a nachunga kagun chujeu chu naheng uva akiphon dohna dinga, kahinsut joh ahibouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun nalungmon naova lung mongin kaum taove. Chule Titus kipana-a kaha kipa cheh-un ahi; nanghon nabon chaova alung nakidosah jeh-u chun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu ama komah nangho-a kakisonna ima a-umtah jeng jongle, jachatnan kaneitapoi; ahin nangho henga kathu sei jouseu thutah ahi banga chu, Titus anga kakisonao jong chu thutah mong ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangho nathu nunnao, itobanga kichatah le kithing thinga nanalem jengu hitam, ti ageldohjile nangho nakhoto nao anasacheh cheh jengin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun thiljouse-a nangho chunga tahsana kanei hi kakipah thanomin ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sopiteho, Macedonia houbung ho kipe-a Pathen lungsetna chu nangho kahetsah nahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh chu hesoh gentheija kipatepna nasatah lah jenga jong akipanao adimin, avaichat thuhlheh jeng vangun, athilphal uva kon aletset jengtaovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman kahet tohsah-a kasei ahi, amahon athao toh kithuh-in, athaovin ajokalvalin jong, amaho lungcham tah-in apeuvin;
  </para>
  <para style="p">
    <verse number="4" style="v" />Athilto-u chu kasan nadingu leh, mithengte lhachakin bolna-a akithokhom theina dingun eino gangun ahi
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hichu kakinepna bangu hilouvin, Pathen lunglamin amaho-a Pakaiyah akipe masaovin, chuin keiho henga akipeuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichun Titus'in masanga abol pat banga chu, tu-a jong chuche lungsetna chu nangho lah-a abulhit sohna dingin katiltil jiuvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amavang, tahsanna, seidohna, hetna, gunchuna jouse le keiho ngailutna nanei letset banguva chu, hiche lungsetna jong hi nanei letsetna dingu gelun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche hi thupeh bangtah-a kasei hilouvin, midangho kihabolna-a kona, nanghon ngailutna tahbeh naneiju chu patepna-a kasei ahibouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajeh chu ama vaichat vanga nangho nahaodoh theina dinguva, ahaonasa nangho jala vaicha jenga, hiche Pakai Jesu Christa lungset chu nanghon naheuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche thudola hi lungthim kapehbou nahiuve; achuti chu nangho dinga apha ahi; kum khat masanga bol pan masa nangho nahiuve, nabol pat jenggoh-u hilouva bol jong nabolphat nomu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin bol ding nalung got bangu chun, than ajochanin bulhit sohkeija aum theinan, tun jong bol bulhingun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu lung got masah auma ahile, aneija chu anei dungjuija, chule aneilou chu aneilou dungjuija kilajia ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi dang noma aumuva nangho hesoh-a naum dingu katina ahipoi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chamgola umna ding ahi, amaho nei letset chu nangho lhahsam bulhitna-a ahung hi theina dinga; tu-a nangho neiletset hi amaho lhahsam bulhitna-a chamgola umna dinga kitoh ahibouve;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitia chu, atam lokhoma chu aval aum chomdehpon, chule alhom lokhoma jong chu alhasampoi, tia kisun bang chu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin Tius lungsunga chutobanga gunchu tah-a nangho khotona neisah Pathen chu thangvah-in umhen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu keiho tilkhouna jop chu ahinan, ahinla amatah mong lunggut tena ama lung chama nangho henga hunga ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Kipana Thupha lama houbung ho jouse lah-a akipachatna kithangsoh chu, amatoh lhon dingin kahinsol thaove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuti jenggoh chu hilouvin; Pakai loupina dingle, kalunggot tenjiu hi vetsahna-a alhachalea kapanu, hiche lungsetna thu lamdola hi kalhonpile dinguva, houbung in agotsa mongu jong ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Alhachalea kapanu hiche thilpeh letset thudola hi koiman eidem louna dinguva, chingtheitah-a chona kahiuve;
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakai mitmu jenga hilouva mihem mitmu-a jong thil ja umdol chu kangaitou ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule keihon tamtah vei thil tamtah-a agunchuje kaphottohsao isopipao chu, amaho toh kahinsol thaovin ahi, ahin tun nangho-a tahsan dettah anei jeh-in ahagunchu cheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Titus thudol hi kiseile, ama hi nangho chungchanga kakivopi le katoh khompi ahi; chule sopi niteni vanghi, houbung ho solchah chule Christa loupina ahi lhone.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuti ahi jeh chun nangailut nao le nangho jeh-a kisonna kaneiju photchetna chu, amaho kom le houbung ho angsunga amaho chu kivetsah-un.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mithengte kinbol thudol vang naheng uva kahinsutlo angaipoi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ijeh-inem itile nalunggot danu chu kahenai, hiche dol chu, Achaia kigosa aumna kumkhat ahitai, tia Macedonia mite anga nangho kapaopi ahi; chule hiche nagunchu nau chun mi tamtah achoh thouvin, agunchu sahtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hitilam thudola nangho kakisonpinao chu ahomkeo ahi louna dinga, kasei banga chu kigosa dema naumna dingun, tia sopiho phabep khat kahinsolu ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Achuti loule ajole Macedonia mi khattou kei lhonpi dingin hunghen, kigo louva na-umu hungtoh tale, keiho chang jenggoh hilouva, kinep pitah nangho dinga jong jachat umding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh-a chu masanga pat nakitep nasao thilpeh kitoh chu cham louva lah hilouva, hongphal tah-a peh ahia, gotsadema nakoina dinguva; aphat masanga naheng uva hung dinga sopiho chu tilkhou angaije tia kageltoh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin hiche thudola hin alhom tu-a chun alhom at ding, chule atam tu-a chun atam at ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lung phatmo pumpumle peh louva, phamo tia pe louvin, nalung got bangtah cheh-in peuvin; ijeh-inem itile lunglhai sela pe-a chu Pathen'in angailui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule imalam jouse-a imatih chana ijakaija bulhingsoh nahiuva, natohpha tintang natoh theina dinguva, Pathen'in lungsetna letset nangho napeh theiju ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche thudol chu hitihin akisune, Aman athejalin, mivaichate atoi; Achonphatna chu a-imatih chana umjing ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule muchi tu-a chu muchi pe-a chule anneh dinga changlhah pepa chun, nangho muchi napeuvintin apunsah ding, chule nachon phatnao ga chu akhantou sah ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thil phal dinga imalam jouse-a haodoh-a nahitaovin, alhacha-a keiho vangin Pathen vahchoijin aume;
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh chu hiche phatna dingbol lhachale-a panna vanga hi, mithengte lhahsamna bulhinsah jenggoh hilouva, thangvahna tamtah-a kona, Pathen lama jong letset jenga ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche lhacha kin kibola kon, nangho Christa Kipana Thupha phondohna dinga nathu man-ule, amahole adangho jouse tona-a nathilpeh-u jehchun amahon Pathen avahchoijui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amahotah jong nangho dingin Pathen henga atao ataovun, nachung uva Pathen lungset lentah chuh jeh chun nangai lheh jengui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Athilpeh sei theilou jeh hin Pathen thangvah-in umhen.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keima, Paul, naum naova lungnem chule naum lounaova nangho lama hakat chun, Christa chonnemna le nunnem na-a keimatah-in katem nahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijongle keiho hi tahsa lam thua chon ahi tia eingaitoho mi koi koiham chunga, hakat tah-a chon dingdol ahi tia kageltoh chu, kaum tengle hiche hakat chu kamanchah louna dinga, naheng uva katao ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ijeh-inem itile keiho tahsa-a chonle kahivangun, tahsa lam thudolin gal kasatpouve;
  </para>
  <para style="p">
    <verse number="4" style="v" />(Ajeh chu kagalsatnau manchah hi tahsa-a ahipoi, ahivanga, kulpi suhjalna dinga Pathen lama hattah);
  </para>
  <para style="p">
    <verse number="5" style="v" />Keihon, lungsuhto-a mi nel na, chule Pathen lam hetna douna-a kigel thil sangtah tah kasuh chim jiuva, lungthim ngaito jouse gal hinga kamat jiuva, Christa thua kanunsah jiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangho thua nanun bulhin tengule, thua nunglouho phula dinga jong kigosa jing kahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon namaikoh uva um thil chu navet uvam? Koi hile mi khattou ama, Christa-a kahi tia amachang kitahsana aumle, ama chun hiche hi ngaito kit-hen; ama Christa-a ahi bang chun keiho jong kahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu nangho phet lhahna hilouva sahphatna dingjoh-a Pakaiyin eipeh-u kathuneinao hi hatah-in song jongleng, kajachat lou ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lekhaho-a chun nangho tijatsah tobang hidange.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu alekhaho athu agihsan, hat jong ahat ngeije, ahinla amunah atahsa ahatmon, athusei taimo aume, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutobang miho chun heuhen, keiho kaum lou tenguva lekha-a thu banga chu, kaumu jongle thilbola chutima chu kahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajeh iham itile amachang kivahchoi mi abang khattouho toh kisimtha dingle kitekah ding kangampouve; amaho vang chu amahole amaho akitekah jiuvin, imacha helou helin aumui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiho vang eikitepeh kalvalun kisong pouvinge, Pathen'in gamkol eitepeh bang bangabou kisong ding kahiuve, gamkol chun nangho jong nahomui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajeh chu keiho nangho kom hung lhunglou toh kabah jeng vangun, eikitepeh kalvala kilhonsao kahipouve, ajeh chu Christa Kipana Thupha hille-a, nangho kom geipeh jong kahung lhunu ahi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Eikitepeh kalvaluva midang tohnasa-a kisonga kahipouve; natahsanu akhantoule kavai hom dungjuiju hin nangho vangin hatah-a keh let cheh-in umunge, ti kakineme.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho gam kalpeh geija Kipana Thupha hi kaseiphongle theina dinguva, kakhut uva dinga gotsa um thil dola hi mi gamkol sung kason louna dingu, katiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin khattou akisonga aumle Pakaiyah kisonghen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu ama kiseipha-a chu hilouvin, Pakai seiphat chubou apha tia kisei ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kangolna themthema neinangai themleu chun kalung ahi; ahin neinangai themsam naove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen tomlah na-a nachung uva katomlah ahi, nungah theng banga Christa khutna kapeh theina dinguva, nangho inneipu khatseh Christa dinga kaholsa nahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahivangin gul chun alepthol doha-a Evi alheplhah bangchun, Christa lama nalungput dihnauva nalung gelu chu ijemtin suchavai getnun nate ti kakichai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu keihon athu kasei louvu Jesu chom dang khat thu ahung seija auma, ahiloule nachankhah ngai louvu lhagao chomdang changa auma, ahiloule najop khah ngai louvu Kipana Thupha jop auma, ahile ama chu angai themleu chun aphai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile solchah pipui chung nungho sanga neokhat chajong neojo-a kingaito lou kahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla thuseija kalhahchom vangin hetna lama chun kalhachom poi. Ahin imalam jouse-a nangho henga tahlangin kaumun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ole, nangho choisanga naumna dinguva, keima kaki suhnema, lo beija nangho Pathen Thupha kahilu hi achonsea kahim?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangho kinbolna dinga, houbung dangdang kachoma, amaho-a kona lo kasan ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nangho koma kaum laisen kalhahsamna aum jongle, koima dinga gihsatna hilouhel kahi; ajeh chu Macedonia konin sopiho ahungun, kangaichat chengse ahung subulhittaove; chule imalam jouse-a nangho gihsatsah louna dinga kihongdoh jing kahin, kihongdoh jing ding kahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Christa thutah jouse keima-a aum jehchun, Achaia gamkol sunga kakisonna chu koiman eikhahtan thei ponte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ipi jehham? nangho kangailut lou jehham? Pathen'in ahenai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla agomkom holteho chu, akisonao chu keiho tobangbang ahung hi theina dinguva, agomkom atokhah dingu chu kasuhhai theina dinga, kabol hi kaboljom jing ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ijeh-inem itile chutobang miho chu solchah lhem ahiuve; doha bola milhemlha natong ahiuve; amaho Christa solchah ho lima kisema ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichu thu kidang ahipoi, ajeh chu Satan'in amatah jengin jong avah-a vah vantil mel aputji ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti chu ahin, alhachahon chonphat lhachaho mel aput chu thupi ahipoi; ahivanga akichainiu chu athilbol dungjui cheh-u hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman kasei kit ahi, koiman angolin eingaito hihhen; ahin neingaito ujongleh, themkhat beh kakison theina dingin mingol bangin neisangun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hicheng kasei hi Pakai thuseija kasei hilouva, hiche kisonna-a hi kisonga, mingol thusei banga kasei ahibouve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi tamtah tahsaphe lama akison jeh-a, kei jong kakison ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangho achinga nahi jeh uva, mingol ho chu kipahtah-a nangaithem-u ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nasohchan sah uva jong, nabah gamuva jong, gal hinga naman uva jong, ama le ama kichoisanga jong, chule nangeipheu benga jong, nangai themu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiho hichea ding chun kalhasamui tia jahcha puma kasei ahi! Ahivangin ilam ilam thua hile, midang ngamna-a chun (Mingol thuseija kasei ahi)kei jong kangame.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amaho Hebrew mi hiuvam? kei jong kahi. Amaho Israel mite hiuvam? kei jong kahi. Amaho Abraham chilhah hiuvam? kei jong kahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaho Christa lhacha hiuvam? (Mingol thuseija kasei ahi) keima kaha hidehjoi, na hatohgimin, songkul lut tamin, teptena kalvala kivoh tamin, thina thei setto tamin;
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngavei Judah ho-a konin somli-a khat lhan eiki jepmin;
  </para>
  <para style="p">
    <verse number="25" style="v" />Thumveina molin eikivon; khatvei songin eikisepmin, thumveina kongke kathoh, jan khatle sunkhat twi thuh laija kaumin;
  </para>
  <para style="p">
    <verse number="26" style="v" />Kakholjin lena-a, tamtahvei luipi-a setto, gucha michoma setto, kanam chanpite-a kona setto, chidang namdang ho-a kona setto, khopi sunga setto, gamthip dunga setto, twikhanglen'a setto, sopi lhemho lah-a setto;
  </para>
  <para style="p">
    <verse number="27" style="v" />Tohgimle hesoh gentheijin, hah jinga imu louva umin, gilkel dangchah thoh-in, an ngola umin, khosih thoh-a pon sillouva umin, hicheng chu kaha hidehna ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hicheng vang chu chutitante, ahivangin apipenin houbung chengse kakhohsah hi niseh-a eidelpha-a ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Koi hatmona kahatmopi lou umam? koi kiselhuh na-a katompi lou umam?
  </para>
  <para style="p">
    <verse number="30" style="v" />Kithang-at go-a hileng, kahatmona tamtah-a hi kakithang-at ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jou sei lou kahi, I-Pakaiyu Jesu Christa Pa-le Pathen tonsot nunnoma chun ahenai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Damascus-a Aretas lengpa noija gamvaipopan, keima man dingin Damascus miho khopi chu angasah jeng ahi;
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahivangin bangkot homa bomin kulpanga eikhai lha uvin, akhutna konin kasohchatan ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keima dingin kiletsahhi ima phachom hihjongle, gaothilmu le Pakai kilahna thuho seijinge.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman Christa-a mi khat kahei, kum somle kum li ahitai (tahsa pumaham kahepoi, tahsa puma hilouham kahepoi, Pathen'in ahei) van athumna geijin lahtouvin aumin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman hitobang mi chu kahei (tahsa pumaha, atahsa pum hilouham, hi chu kahepoi, Pathen'in ahei).
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama chu gam loupi-a lahtouvin aumin, tho thei louhel paochengho agajai, hichu mihem dinga thodoh hoi dan hilouhel ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutobang mi dinga chu kisong ding kahi; keima chang thua vang, kahatmo naho tailouvah kisongponge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kison ding lung go jongleng angolla hiponge, keiman thutahbeh kasei ding ahi; min keima eimu-a chule kathu ajah-a itobanga eingaitom, hi sanga chu chungnung-jo-a eingaito louna dinga, kakitim ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule thil kilahho anatsat behseh jeh-a chu kakichoisang behseh louna dingin, Satan thangkou khat eichum dingin, kakichoisang louhelna dingin, kati chungah ling khat eikipen ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keija kona achemangna dingin Pakai anga thumvei kataotan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutah chun aman, Kalungsetna hi nangma dinga lhingset ahi; ajehchu hatmona-a kathahat kisucham kimjia ahi, ati. Hijeh-a chu Christa thahat keija achen theina dinga, kahatmona-a hi kipahtah-a kakison johding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuti ahi jeh-a chu Christa jala hatmona tincheng, suhlema umna, vaichatna, bolsetna, settona hichenga hi lunglhaija um kahi; ajeh chu kahatmo komle kahatjin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kison na-a ngol kanahi ahitai; nanghon ngollou theijin neilhapouve; ajeh chu nangho choi-at dingjoh kahi; ijeh inem itile keima solchah pipuiho sanga imacha-a nunung jolou kahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tahtah-a seijin, solchah hina melchihna ho jouse nangho lah-a thohhattoh kitho-a, melchihna tintang kibola, mu kidang dang chule thilbol theina-a kiboldoh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahile houbung dangho sanga noinungjo-a na-umnao ipi umam, keiman nangho gihsatsah louva kaum ti lou chu? Hiche kasuhkhel chu neingaidam un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Veuvin, nangho henga hung kakigot hiche hi athumveina ahi; chule nangho gihsatsah lou ding kahi; ajeh chu keima nangho-a ima hola hilouvin, nangho bou kahol ahi; ajeh chu anule apa dinga chatehon sum akhol chu adol ahipoi, anule apanbou chate dinga akhol ding dol ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman kipahtah-a nangho hinna dinga kakiman ding, chule kakiman jouhel ding ahi. Keiman nangho kangai lutnao asanlheh jeh-a, nangho neingailut nao lhasam dingham.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahoi hitale ahihi hitante, keiman nangho pohgihsa kapoh sahpoi; ahin lungthim thema doha kamat nahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Naheng uva kahinsol teho lah-a khattou nangho doha bolna-a kaman chah umam?
  </para>
  <para style="p">
    <verse number="18" style="v" />Titus chu keiman kajola, sopiho chu amatoh kahin soltha ahi; ole Titus'in doha nabolnao umam? Keiho lhagao khat hilou kahiuvem? kalson kibanga sepkhom hilou kahiuvem?
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuchan geija hi keiho kithenhon na-a najah uva thuseija neingaito nahlaiju ham? Keiho Pathen maikoh-a Christa thu seija kahiuve. Chule, ngaitahte, imajouse hi nangho sadoh-a phattou sahna-a kabollu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajeh chu nakomu kahung lhun tengle, ajole kamu nom bangin muhih khau vingting, chule nanghon jong neimu nom bangin neimu hih khauvinate, ti kagingmoi; ijem itile nalah uva, kibaotam, kithangset, lunghan, kilungdou, kiseiset, kihou lhih, hamhoitho, thunoh lungjin umkhante kati;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ajole kahung kit tengle, ka-Pathen'in keima nangho angah eisunem khantin; chule tu masanga chonsea, thenlouna, jonthanhoi, huh aboluva kon lungheilou mitamtah hochu lhasetpi khagetning kate.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangho henga kahung tu chunga hi athum veina ahi. Ahetoh ni ahim, thum ahim, kama thu ijakai tun dinga umding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amasanga kanaseisa ahi, chule aniveina-a kaum petna kanaseisa banga chu, tu-a kaum louva jong, tu masanga chonse hole adang dangho jouse henga kasut ahi, kahung kit tengle, khen nei lou ding kahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon Christan keima-a thu asei photchena nahol jeh-u chun; ama chu nangho lama hatmoa ahipoi, nangho-a hattah ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ijeh-inem itile hatmona jeh-a thingpel'a akikhetbeh jeng vangin, Pathen thahat vangin ahing jinge. Ajeh chu keiho jong ama-a hatmoa kahiuve; ahinla Pathen thahat vanga nangho lama amatoh hingkhom ding kahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tahsana um nahiu nahi louvu nangho kikholun; photchena dingin nangho kikholun. Ahiloule Jesu Christa nangho-a aum chu nangho tah-in helou nahiuvem? aphai tia lah hilou nahilou ngaluleh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla keiho hi aphai tia lah hilou kahilou hi nanghon nahet dingu kakineme.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin nangho thilphalou nabol louna dingun Pathen henga kataojiuve; hiche aphai tia lah kahiu chu kilahdohna ding hilouva, keiho aphai tia lah hiloutoh kabah jeng vangun, nanghon thil ja um chu nabolna dingu ahijoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu keiho thutah-a ding tilou, thutah dounan ima kabol thei pouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ijeh-inem itile keiho kahatmo uva nangho nahat tengule kathanom jiuve, chule nachamkim na dingun jong, kataojiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche jeh chun asuse ding hilouvin, houthu lama khantou sahna dinga Pakaiyin thuneina eipeh hi, kathunei bangtah-a kahung tengle, kabol khoh louna ding lungthima kahung masanga hicheng hi kahinsut ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Achaina keijin, sopite, nangho kipah thanomun, chamkim keijun, lungmongun, lungkhat hiuvin, kitohdelin umun; chutile ngailutle lungmon kona Pathen'in naumpi dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thengtah-a kibeng chop cheh-in khatle khat kisalam un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mitheng jousen nasalamui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai Jesu Christa lungsetnale, Pathen ngailutna, chule Lhagao Theng kithopina chun nabonchaovin umpiuvin. Amen.
  </para>
</usx>
