<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ACT" style="id">Solchah</book>
  <para style="h">Solchah</para>
  <para style="toc1">Solchah</para>
  <para style="toc2">Solchah</para>
  <para style="mt">Solchah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Theophilus, lekha masa-a chun Jesu thilbol le athuhil kipattil thudol jouse,
  </para>
  <para style="p">
    <verse number="2" style="v" />Asolchah lhenho Lhagao Thenga thu apeh jouva lahtouva aum ni geija thu chu kanasunin ahi:
  </para>
  <para style="p">
    <verse number="3" style="v" />Gim genthei athoh jouvin, chuche solchah ho chu thontheilou hetphotna tamtah toh thon ahingin akimusah in, nisomli geijin ahenguva akilah jin, Pathen lenggam thudol aseijin:
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahotoh aum khomin, amaho chu hiche thuhi apen, Nanghon Jerusalem dalha hih-un; Pa thutep keija kona najah-u chu ngah jingun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile John chun twija baptize achansah ahin, nangho vang tukal ni phabep joule Lhagao Thenga baptize nachan dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichun amaho ahung kikhomun ajah-a, Pakai tu-a hi Israelte gam nakiledoh sah kit dingham? tin adongui.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman ajah uva, Pan athuneina-a angaitoa agot phat le nikho chu nangho het dingdol ahipoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amavang Lhagao Theng nachung uva ahung lhun tengle nanghon thahat nanei dingu ahi; chule nangho Jerusalem'a jong, Juda gamsung le, Samaria gamsung, chule leiset chung gam jouse-a, kolmong geija kathu hettohsah-a napan dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin thu hicheng chu asei jouvin, amahon avet vet pettah-un ama lahtouvin aumin; amitmuva konin meilhang khatnin atolmangtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin akaltouva van lam avet vet pettah-un, veuvin, ponbang sil mi ni akenguvah ahung dingin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Miteni chun, Nangho Galilee gam miho, ibola nadin uva van lam navet jinguham? Hiche Jesu nangho koma kona van'a kilatou hi, van'a akaltou namu bang banguva hi hung ding ahi, ati lhone.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutah-in Olivet molsanga kon chun Jerusalem'a akiletaove; hichu Jerusalem komcha ahin cholngah ni lampi bou ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin alhunun, aumnao indan chungnunga chun aluttou taove. Peter, le Jacob, John le Andrew, Philip le Thomas, Bartholomew le Matthew, Alphaeus chapa Jacob le Zealot Simon, chule Jacob chapa Judas; hicheng chu ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiteho chengse chu numei phabep toh, Jesu nu Mariam toh, asopiteho toh, lungkhat tah-in taona le ngehna ajomjing taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche nikho lai chun Peter seijui ho lah-a adingdoh-in (mipi akikhoma chu mi jale somni jen ahiuve,)
  </para>
  <para style="p">
    <verse number="16" style="v" />Sopiteho, Jesu manho lamkaija pang Judas chungchang thudol, Lhagao Thengin David kama aseisah Pathen lekhabua thu chu guilhung ding mong ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ijeh-inem itile ama chu eiho lah-a kisimtha ahin, chule hiche lhacha natohna mun jonghi changa ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tun heche mipa hin khan gitlou man sumin leimun khat alamin, akhupbon achun, atumpi apohkeh-in, chule agil jouse ahungdoh tan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche thuhi Jerusalem'a cheng jousen ahesoh keije; hiti chun amaho paovin chuche leimun min chu Aceldama asahtaove; hichu thisan lei tina ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh-inem itile Labu-a, Ama chenna mun chu agoh keuvin umhen, chua chun koima cheng hihhen; chule apanmun chu midang changhen, tin akisune.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun, Pakai Jesu eiho lah-a achele ahungleh phatlai sungse,
  </para>
  <para style="p">
    <verse number="22" style="v" />John'in baptize achansah-a pat, Pakai Jesu eihoa kona lahtouva aum ni geija ikiloi khompiu hiche miho lah-a khat hi, ama thodoh kit hettohsah-a eipanhu diuva lhentei ngaiding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin mi ni, Barsabas atiu Joseph (amin chom Justus), le Matthias chu alheng doh-un ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amaho ataovun, Vo mijouse lung hesoh Pakai, hiteni koijoh hi
  </para>
  <para style="p">
    <verse number="25" style="v" />Chonset jala Judas'in ama mun'a achena dinga alha hiche lhacha na le solchah panmun chu lo dinga nalhenem neivet sah-un, atiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amahon vang asanun ahile, avang sanu chu Mathias chunga achutan; hitichun ama chu solchah somlekhat chutoh akisimtha tai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pentecost ni lhingkeija ahunglhun phatnin, abonchauvin lungkhat tah-in munkhatna ana umkhomun ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin phulou helouvin van'a konin hui hattah nung gin tobang ahung gingin, atounau in chu adimsoh jengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin meikong bangin lei ahung kilah-in, akikhen jal-in, alu chung cheh uva achongin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amaho abonun Lhagao Theng adimset taovin, Lhagaovin aseidohsah bangun paochom paochomin thu asei pantaovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichea chu vannoi leiset gamtina chitin namtin lah-a kona hou gut Juda miho Jerusalem'a umuva ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin chuche thu akiseithang phat chun mipi ahung kikhomun, amitakipmin ama ama pao cheh-a thukisei ajah jeh-u chun, alung kichih lah jengun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amaho chun adatmouvin kidang asauvin, khatle khat akihouvun, Veuvin, thu seiho hi abonchauva Galilee gam mi hilou hiuvem?
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule i-atile eihon amikipmin ipenna gam cheh paova thu kisei ijah-uham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Eihola abang Parthia mi, Media mi, Elam mi ihiuvin, abang Mesopotamia gama cheng, Juda gamale Cappadocia gama cheng, Pontus gamale Asia gama cheng,
  </para>
  <para style="p">
    <verse number="10" style="v" />Phrygia le Pamphylia gama cheng, Egypt gama cheng, chule Cyrene gam vela Libya gama cheng ihiuvin; abang Rome'a kona hung kholjin, Juda ho le Juda chona chonho,
  </para>
  <para style="p">
    <verse number="11" style="v" />Crete mile Arabia gam mi ihiuvin: ahivangin eima pao cheh-a Pathen thilbol loupi thu aseiju thakhat jah-in ijauvin, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin abonchau chun kidang asauvin adatmo lheh jengun, Itina ahidem, tin khatle khat akidongto taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahivangin adangho chun ajontaijun, Hiteho lengpiga twithah khama hiuva hi, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin Peter somlekhat chutoh adingin, aw sangtah-in asamin, ajah uva, Juda gam mite le Jerusalem'a chengho, nanghon nabon chaovin hiche hi heuvin, chule kathusei lungna changin ngaijun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ijeh-inem itile hiteho hi nangho ngaito banga lengpitwi khama ahipouve; tu hi vai ahinalai bouve;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin hiche hi Joel themgaovin anasei;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ni nunungle hiti ding ahi, tin Pathen'in aseije Mi jouse chunga kalhagao kabuh lhah ding; nachapa teo le nachanu teo vin gaothu aseidoh dingu, nakhangdong houvin mu aneijuva, na-upa houvin mang amat dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahi, hiche niteng chule kasoh pasal hole kasoh numei ho chunga jong Kalhagao kabuh lhah ding, chule amahon lhagao thu aseidoh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule van'a thil kidang dang, noi leisetna melchihna ho; thisan, mei, meikhu kamusah ding;
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai nikho loupitah le min thangtah chu ahunglhun masanga; Nisa chu muthim soh-a, Lha thisan soh ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hiti ding ahi, Koi hijongle Pakai mina tao chan chu huhhing-a umding ahi, tia aseichu guilhunga ahibouve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangho Israel mite, hiche thuhi ngaijun: Nazareth Jesu, Pathen'in amanchah-a nalah uva, bolmo kidang, datmo umho, chule melchihna ho abola kona chu Pathen'in nangho henga aphotchet ahin, hichu nanghon naheuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ama chu Pathen'in ageltohsa le ahet masahsa bangin pehdoh-in aumtan ahile, nanghon namanun, lungsetna beihel khutho chun thingpellah nakhen beh-un, nathat taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahin thina-in ama chu atuhden hoi ahilou jeh chun, Pathen'in thina-in akan chu asutlhap peh-in, akai thoutai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ijeh-inem itile David'in ama thudola chun, Keiman Pakai chu kamaikoh-a kamu jinge, Ajeh chu keima kalon louna dingin, kakhut jet lamah aume.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun kalung akipah-in, chule kalei athanome; chuche kalval chun katahsa jong kinema cholnga ding ahi;
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajeh chu nangman kalhagao damuna nadalhah lou ding, namitheng jong mon mangna namusah louding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangman keima hinna lampi neihetsah ahitan, namaiso-a kipana neidip ding ahi, tin anaseijin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sopiteho, iphung bulpiu David thuhi olmo louhelin najah uva kasei theije, ama chu athin, akivuijin abuikhuh tu geijin ilah uva aum jinge.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama chu themgao ahijeh-in, tahsalam dola ataiguija kona alaltouna-a toudinga Christa chu ahin tundoh ding ahi tia, Pathen kihahsela athutep chu ahen;
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutia chu khonung thu ahet masah jeh chun Christa thokit ding thu aseijin, thikhol khul'a dalhah denin aumpoi, alongin jong mon mangna amupoi, tia asei ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hiche Jesu chu Pathen'in akaithou kittan, ahetoh-a keiho kabonchao kahiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh chun Pathen khut jet lamah choisangin aumin, athutepsa Lhagao Theng chu a-Pa-a konin amun, hichu ahin buhlhah-a, tu-a namu-u najah-uhi ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />David chu van'ah akalpoi, ahivangin amatah-in hiti hin aseije, Pakai chun ka Pakai jah-a, Kakhut jet lamah tou jingin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Keiman namelmaho nakeng chotpha kaneisah masangsen, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hijeh chun Israel insung mi jousen kichentah-in heuhen, hiche Jesu nanghon thingpel'a nakhetbeh-u chu, Pathen'in Pakai le Christa-a atun ahitai, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amahon thu hicheng chu ajah phatnun, alungu hema kisun abangin, Peter le solchah dangho jah-a, Miho chule sopite, keihon ipi kabol dingu ham? atiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Peter'in ajah uvah, Nalung heijun, chule chonset suhbeinan Jesu Christa minin nabonchaovin baptize changcheh-un, chule Lhagao Theng kipe-a hi nachan dingu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ijeh-inem itile thutep chu nangho dingle nachateo ding, chule gamlatah-a umho, Pakai i-Pathen'un ama henga akou dingho jouse dinga ahi, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule thu dang dang tamtah ahettohsah-in, chule amaho chu atilkhouvin, Tulai khang lung gilou ho-a konhin kihuh doh-un, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chutah chun kipahtah-a athu jop chanchu baptize achang taove; chule hiche nilele chun amaho chu mi sangthum jenin abetauve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin amaho chu solchah ho thuhila jong, kithokhomin jong, changlhah semkeh-in jong, chule taovin jong gunchu tah-in apang det jingtaove.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hichun mitin chunga kichatna ahungchun; chule solchah ho chun thil kidang tamtah le, melchihna aboltauve.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule atahsan jouse chu aum khomun, thil jouse neilhangin aneijun:
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule anei agouhou le athilkeovu ajoh-un, abonchauvin angaichat akin tohkhambep cheh-in akihom jiuvin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule niseh-in lung khattah-in houin'ah gunchu tah-in aumdet jingun, in tina changlhah asemkeh-un, kipahle lung khatseh pun an anejiuvin,
  </para>
  <para style="p">
    <verse number="47" style="v" />Pathen avahchoijun, chule mi jouse lungdeijin aumun ahi. Chuin Pakaiyin huhhing-a umho chu niseh-in houbung'a chun abe jingtan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni khat Peter le John tao phatnin, hichu ni kihei ahin, houin'a achetou lhonin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin mi khat anu sunga apena elbaija peng ahinpouvin, houin alut jouse henga khut adoa thil akithum dinga, houin'a kotkhah hoi atiuva chu nisehle akoijiu ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama chun Peter le John houin'a alut ding lhon amu phatnin, thil eikipele tin anathumin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Peter'in ama chu ave changmelin John toh ahin, Keini neive lhonin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun aman ikhat mu akinemin lung lut tah-in avetan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin, Peter'in, Dangka sana kaneipoi; ahivangin kaneisun penge: Nazareth Jesu Christa minin thoudoh-in lang lam jottan, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman akhut jetnin amanin, akai dingin ahile, chupettah chun akengphang le a-ah khomit guho ahatdohtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun amapa chu akichomin adingin, lam ajotnin, amani chutoh houin'ah alutnin; avahlen, akichom akichomin, Pathen avahchoijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin mi jousen avalea Pathen avahchoi chu amuvin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule houin Kotkhah hoi phunga touva khut dopa chu ahi aheuvin; chule achunga thil soh chu kidangle datmo um asa lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin elbai akidamsah pan Peter le John atuhpet chun, miho jouse chun kidang asa behseh-un, Solomon kempum atiuva chun ahenguva ahung lhai khomun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin hichu Peter'in amu phatnin miho chu adonbutnin, Vo nangho Israel mite, ibola hichepa chunga hi kidang sa-a nahiuvem? Ole keihon keiho thahat le houdih vanga ama hi lam kajotsah theijuva nangaitouva, neivet vet jenguham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham, Isaac, Jacob Pathen, ipu ipateu Pathen'in achapa Jesu chu achoi-at ahi; ama chu nanghon napedoh-un, Pilate angsung tah-a aman lhadoh dinga agotsan jongin napedoh jengui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahi, nanghon Athengpa le Chondihpa chu naleh doh-un, tolthat joh chu nalhadoh pehna dingun nathumun,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hinna Bulpi chu nathat taove; ahinla ama chu Pathen'in athiho lah-a konin akaithou kittan; ahetoh keiho hi kahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule ama min tahsan vanga amin chun nanghon nahet jingule namu jingu hichepa hi ahatsah ahitai: ahi, Ama-a kona tahsan chun hichepa hi nangho jouse mitmu-a adamsah hel ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule tun, sopite, hichu nahetlou jeh uva nangho le navaipo pipuhovin nabolu ahi kahei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahivangin Pathen'in athemgaoho jouse kama aseisah, Christa chun gim genthei athoh ding ahi, ati chu hitia hi aguilhunsah ahibouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun nachonset nao chulmanga aum theina dingin nalung heijun, hung kilehei kitnun, chutile Pakai anga konin haldohna kiledohna phat chu hung lhung theijin tin;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule naheng uva aphondohsa Christa Jesu chu naheng uva ahinsol thei ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amavang imajouse akiledohsah kit phat kahse-a chu, van'in ama chu alahlut tahdi ding mong thu ahi; hiche thuhi Pathen'in atil abula patna athemgao thengho kama ahin seisahpeh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mosi'n apu apateu jah-a, Pakai Pathen'in keima eitundoh banga hi, nangho dinga nasopiteu lah-a khat themgaova atundoh ding ahi; ama chun najah uva thu asei jouse chu nangai dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hiti ding ahi, koi hijongle chuche themgao thusei ngailou lou chu miho lah-a kona kisumanghel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahi, themgaoho jousen, Samuel'a pat anunga abanjom chengsen jong, thusei jousen tulai thusoh umchan ding hi anasei masatnu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangho themgaoho le Pathen'in napu napateu atepna thutep chate chu nahiuve, Pathen'in Abraham jah-a, Nangma chilhah-a kona vannoi leiset phung jouse phatthei chang ding ahi, tia atep chu.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pathen'in achapa Jesu chu akaithouvin, nagitlou nao chengseova kona lehei dingle, phatthei chansah dingin, nangho henga ahinsol masapenin ahi, ati.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin miho jah-a athusei pet lhonin, thempuho, houin vaipopa, chule Saddukai ho chu achung lhonah achuvin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi thu ahilhon le, Jesu vanga athi lah-a kona thokit thu ahil lhon jeh chun, alungphamo lheh jengui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amani chu amanun, nilhah ahitah jeh chun, ajinga dingin mihenna in'ah akhumtaove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin athu jaho mi tamtah-in atahsanun; chule amijat chu sangnga jen ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ahitin ahi, ajingin avaipoho chengseutoh, a-upaho chengseu, chule danthu sunho,
  </para>
  <para style="p">
    <verse number="6" style="v" />Anna thempu chungnung toh, Caiaphas, John, Alexander, chule thempu chungnung inkote chengse toh Jerusalem'a akikhom khomun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin alailung uvah amani chu atungun, Ipi thuneina le koi mina hiche hi nabol lhonham, tin adongui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutah-in Peter Lhagao Thengin adimsetnin ajah uva, Nangho, miho chunga vaipoho le Israel upaho,
  </para>
  <para style="p">
    <verse number="9" style="v" />Tunia hiche michatmo pa phatna dinga thilpa kibol thua, hichepa ipi-a iti kiboldam hela hitam, tia eikidonga ahitah-a ahile,
  </para>
  <para style="p">
    <verse number="10" style="v" />Nabonchaovin kihet cheh-un, chule Israel mi jousen hecheh hen, nanghon thingpel'a nakhetbeh-u Nazareth Jesu Christa, Pathen'in athiho lah-a kona akaithou, ama mina chu ama hi na-ang uva dama dinga ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangho insahon nadei mouva napaiju song, aninga apipena panga chu, ama hi ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule koima dangah huhhingna aumpoi; ijeh-inem itile vannoi'a mihemte lah-a huhhing-a iumna dinguva kipe-a min dang aumpoi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Peter le John hakatje chu amu phatnun, lekha themlou ahi lhonle mimol ahi lhon chu aheuvin, adatmo lheh jengui; chule amani chu Jesu toh kivopsa ahi lhon chu ahedoh taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule mi akiboldampa chu amahotoh adin khom jing chu amuvin, adounan imacha aseithei tapouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin amaho chu akikhop naova kona chu achoma gaumdoh dingin asoldoh-un, amahole amaho akihouvun,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche miho hi iba ilo dinguham? Amahon thil bolmo kidang datmotah abolu hila Jerusalem'a cheng mi jouse hetnin akiphong dohtan; eihon jongla ahipoi tin inel theipouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijongle hiche hi miho lah-a achal cheh cheh louna dingin, tukala Jesu mina hi thu asei kit louhelna dingun hagih-in gihsal uhite, akitiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amani chu akouvun, Jesu mina thu aseija asei louhelna dingule, mi ahil louhelna dingun akhamchah taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin Peter le Johan in adonbut lhonin ajah uva, Pathen thu sanga nangho thu ngaijoh chu Pathen mitmu-a dihnam, nanghon geltoh-un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keiho vang thil kamu chengseu le kajah chengseu sei louvin kaum theipouve, ati lhone.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon agihsal kitleuvun alhadoh taove, mipi jeh chun talent pehnaje ahepouve; ijeh-inem itile thil kibol jeh chun mi jousen Pathen avahchoijun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajeh iham itile bolmo kidangtah kibolna-a kiboldam mipa chu kum somli chunga mi ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin akilhadoh phat lhonin, aloiho henga ahung lhonin, ajah uva thempu pipuiho le upaho thusei chu alhut lhonin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amahon hichu ajahtah-un, aw sangtah-in, lungkhat tah-in Pathen asamun, Vo Pakai, nangma vanle lei chule twikhanglen, chule asunga um jouse sema Pathen nahi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangman nalhacha David kamsunga, Namtin vaipi ibola lunghanga hiuvam? chule ibola mihon mohthil angaitou ham?
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakai le a-Christa chunga chun, Leiset chunga lengho apang golun, Chule avaipoteu akikhomui; tia nasei dohsah ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Atahbeh-in, nangma thaonu nalhacha Theng Jesu dounan, Herod le Pontius Pilate, chidang namdangte toh Israel miho toh,
  </para>
  <para style="p">
    <verse number="28" style="v" />Hung guilhung dinga nakhutle nalung thimin agonmasah chengse chu boldingin akikhomun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tun, Pakai, ami gihsalnao hi vetan; chule nasohte hin hakat tah-a nathu aseina dingun;
  </para>
  <para style="p">
    <verse number="30" style="v" />Nalhacha Theng Jesu mina melchihna le bolmo kidang dang abolna dingun, mi damsahna dingin nakhut lhangin atiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin amaho atao jouvun, akikhopnao chu ahung kilingin, abonchauvin Lhagao Thengin adimun, hakattah-in Pathen thu aseitaove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin mipi atahsan chengse chu lungkhatle thakhat ahiuvin; khatchan jong anei chu keija tum ahi tilouvin; thil jouse abonchan neilhangin aneitauve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin solchah ho chun thahat chungnung tah-in Pakai Jesu thokit thu ahettohsah jiuvin; abonchauva chungah lungsetna nasatah aumtan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Alah uva jong koima alhasama aumpouve; ajeh chu gam ahiloule in nei jouse chun ajoh-un, chule athil joh manhou chu achoijun,
  </para>
  <para style="p">
    <verse number="35" style="v" />Solchah ho keng bulah ahung koijiuvin, akin toh khambep cheh-in akihom jiuvin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Levi phung mi, Cyprus twikol gam mi Joseph, solchah hon Barnabas asah-u (hichu lungmonna chapa tina ahi) chun,
  </para>
  <para style="p">
    <verse number="37" style="v" />Lou ching khat anei chu ajoh-in, sum chu achoijin solchah ho keng bulah ahung koijin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin mi khat amin Anania kitipa chun a-inneipi Sapphira toh anei khat ajoh lhonin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman alang akikoijin, hichu a-inneipin jong ahet ahin, alang chu ahin choijin solchah ho keng bulah ahung koijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla Peter'in, Anania, ibola gam man chu alang kikoija, Lhagao Theng najoulhep dinga Satan'in nalung sung alodim hitam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Aum laija chu nanga tum hilouham? Chule najoh nunga jong chu nangma thu neina-a um hilouham? Ibola hitobang hi lunga vop nahim? Nangman mi najoulhep ahipon, Pathen najoulhep ahibouve, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin thu chucheng chu ajah jah chun Anania chu alhun athitai. Chuin aja jouse chunga chun kichatna nasatah achutan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin gollhangho akipat doh-un atomun, apudoh-un, agavui taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin chuche jou nidan thum tobang nungin a-inneipi chu thilsoh umchan hepha louvin, ahung lutjelin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Peter'in adonbutnin, ajah-a, Hijat manseh bouva hi gam chu najoh lhonham? atile amanun, Ahi, hijatbou chu ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla Peter'in amanu jah-a, I-atile Pakai Lhagao patep dinga naki thukop lhon hitam? Ven, na-inneipu vuiho kot bul ahung geitaove; amahon nang jong naputdoh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanu chu chupettah chun akeng bulah alhun athipaitai. Chuin gollhangho chu ahung lut ule amanu athi chu ahung mu uvin, apudoh kitnun, a-inneipu komah agavui taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin houbung pumpi chungle chucheng thu jaho jouse chungah kichatna nasatah achutan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule mipi ho lah-a melchihna le thil kidang tamtah solchah ho khutna konin akibol jengtan ahi. Amaho chu lungkhat tah-in Solomon kempum'a chun aumun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin midang koimachan amaho lah-a lhah ding chu angapchapon ahi: ahinla mipin amaho chu avesang lheh-ui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule atahsana numei le pasal Pakai henga akibelap jengun;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutitah chun Peter avale komle ale beh mi phabep chunga achuhna dingin, damlouho khosung lamlenah ahinpouvin jalkhun le talaijah alupsah jiuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Jerusalem kimvela khopiho-a konin mipi chu ahung khomun, adamlouho le lhagaoboh bolgimho ahinpuijun ahile, abonchau chun boldamin aumjitaove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin thempu chungnungle aloiho jouse (amaho chu Saddukai loi ahiuvin), lunghan nan adimun,
  </para>
  <para style="p">
    <verse number="18" style="v" />Akipat doh-un, solchah ho chu amanun, jalhang henna-a ahentauve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla jan-in Pakai vantil'in kot ahongin, amaho pamah apuidoh-in, ajah uva,
  </para>
  <para style="p">
    <verse number="20" style="v" />Cheovinlang houin'ah gadingun, hiche hinna thu jouse hi miho gahilun, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin hichu ajah phatnun, ajing khovah matah-in houin'a alut paijun athu ahiltaove. Ahin thempu chungnung chu aumpi aloihotoh ahungin, houvaipoloile Israel chate a-upaho chengseu akou khomin, khatteho chu gapui dingin songkul in'a chun mi asoltan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla sottol hochu ahunguva songkul sunga ahung mulou phatnun, amaho akileuvin ahenguva,
  </para>
  <para style="p">
    <verse number="23" style="v" />Songkul inla bitkeijin akikhahchahnan, angahho jong kotphunga adin jingu kagatoh-un, kot kahonule asungah koima kamutapouve, agatiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin thempu chungnungle houin vaipo, chule thempu pipuihon thu hicheng chu ajah phatnun, hichea kon chun ipi ahung sohdoh tadem, tin achung changuvah alung dong lheh jeng taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin mi khat ahungin ajah uva, Veuvin songkul'a nahenhou chu houin'ah adingun miho thu ahilui, ahung ti.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutah-in vaipo chu sottol hotoh akonun kangchan agapuijui; ajehchu miho chun songin eisep getnunte ti akichatnu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin apuilut phatnun, amaho chu houvaipoloi ang sungah adinsah-un: chule thempu chungnung chun amaho chu adongin,
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche min hin mi hildaovin, tia hachang khama kakhamu nahiu hilouham? ahin veuvin, nathuhilu Jerusalem nadipsoh taove; chule hichepa thisan phu hi keiho chunga chuhsah dingin nagouve, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivangin Peter le solchah ho chun adonbutnun, Mihem thu sanga Pathen thua kanunjoh dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ipu ipateu Pathen'in nanghon thinga nakhai uva natha-u Jesu chu akaithou tan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama chu Pathen'in Israelte lungheina dingle chonset ngaidamna dinga, Pipui le Huhhingpu hidinga akhut jetna achoisang ahitai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule hitiho-a hi Ama dinga ahetoh-a keiho kahiuve; chule athua nungho dinga Pathen'in apeh Lhagao Theng jong chu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahivangin amahon hichu ajahtah-u chun alungchang kikaldoh abang jengun, tha dingin agotauvin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahivangin houvaipoloi lah-a mi khat, Pharisai mi, amin Gamaliel, danthuhil, mijousen ajalheh ahin, adingdoh in, solchah ho chu chom chakhat soldoh dingin thu apetan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin aman ajah uva, Nangho Israel mite, hiteho chunga nathil bol gotnu hi chingthei jun.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ijeh-inem itile tumasang lai chun Theudas kiti mi khat asohdoh-in, ama chun milen kahi atin; ama henga chun mi ja li jen akaijin; chuin ama chu athat taovin ahile, athua nungho jouse chu acheh gamun, ima hilou asohtaove.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hichepa jouma chun, min kisut laijin, Galilee gama Judas aumdoh kitleuvin, ahenga mi kimkhat aloimangin; ama jong chu amangthah-in, athua nungho jouse jong acheh gamtaovin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule tu-a kaseipeh nahiuve, Hiche miho-a kon khun kikhin dalun, limsah daovin; ijeh-inem itile hiche thil kingaito le thil kibola hi mihem phudoh ahile, suhmangin hung umnante.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahivangin Pathen'a kon ahile, sumangjou pouvin nate; ajole Pathen kidoupi hikha getnun nate, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin ama sei chu aphatsah-un, solchah ho chu akouvun, avovin, Jesu minin thu sei kit hihhelun tin akhamun, alhataove.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hitichun houvaipoloi anga kon chun achedoh-un, Amin jala jachatna thoh dinga kiloma sim ahi jeh-un, akipah lheh-un ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin niseh-in houin le in tinah Jesu Christa thuhil le seiphong atangdeh pouve.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche lai chun seijui ho amijat apunbe cheh cheh phatnun, niseh thil kihoma ameithaiteu adon lou jeh-un, Hebrew ho chunga Greek gam Juda ho aphun taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin somleni ho chun seijui mipi chu akou khomun, Keihon Pathen thu pailhah-a anneh thulam jeng kangaito dingu chu adol ahipoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun, sopite, hiche kina hi kapansah thei dingu, nalah uva konin seiphat chang, Lhagao Theng le chihna dimset mi sagi lhengdoh-un;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin keiho vang taona le thu lhacha-a kapandet jing jeng dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche thua chun mi jouse chu alunglhaijun, tahsan le Lhagao Thenga dimset Stephen toh, Philip toh, Prochorus toh, Nicanor toh, Timon toh, Parmenas, chule Juda chona chon Antioch kho-a Nicolas, hicheng chu alheng doh-un,
  </para>
  <para style="p">
    <verse number="6" style="v" />Solchah ho angah adinsah-un; chuin atao jouvun, achunguvah akhut angam taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pathen thu chu ahung chaljal tan, chule Jerusalem'a seijui ho amijat hapunin apung lhehjeng taovin; thempuho jong tamtah tahsan thun anung taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Stephen chu tahsanna le thilboltheina dimin, mi lah-a thil kidang le melchihna loupitah aboljin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin Libertine kikhopna atiu kikhopna-a miho phabep, (Cyrene mi, Alexandria mi, chule Cilicia mihole Asia gam miho) akipat doh-un, Stephen chu akinelpi taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin aman Lhagao le chihna-a athusei chu anelthei tapouvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon mi atilgu uvin, Hichepa hin Mosi le Pathen ataitom kajauve ati sah-un ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon mipi ho, upaho, chule danthu sunho chu atilseuvin, Stephen chunga achuvin, amanun, houvaipoloi henga akaijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon hettohsah lhem asemun, hicheho chun, Hichepa hin hiche Intheng hile dan hi tanglouva ataitomjia;
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche Nazareth Jesu hin hiche Intheng hi aphet lhah-a, Mosi danthu peh hi abol lamdang ding ahitai, tia asei kajauve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin vaihom na-a touho jouse chun, amachu ave veuvin ahile, amaiso vantil maiso bangin amuvin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Thempu chungnung chun, Hiche thuho hi atahbeh ham? ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Stephen'in, Sopite le pate, ngaijun: Ipuluiju Abraham Haran kho-a achen masanga Mesopotamia gama aum laijin, loupi Pathen ahenga akilah-in ajah-a,
  </para>
  <para style="p">
    <verse number="3" style="v" />Nagam sunga kon le na-insung mite lah-a konin kipatdoh-in, chule keiman kavetsah ding gama hungin, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutah-in ama Chaldia gama konin ahungdoh-in, Haran'ah achengtan ahi; chuin hia kon chun apa thi nungin, Pathen'in, tu-a nachennao, hiche gama hin achenlut sahtai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin chua chun Pathen'in akengto ngapna kham jong mun alo ding apepoi. Ahivang chun amale anunga asonho geijin alo dinguva kapeh ding ahi tin, chapa anei loulai peh chun athutep tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pathen'in, asonho chu hetlou gama pem ding, chule amahon soh-a aloilut dingu, chule kum jali jen kinomsahna anei dingu ahi, tin anaseijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule asohchan nateu vaipi chu keiman athu-u katan ding; chuche joule hung potdoh uva, hiche kom mun'a hi keima eijen dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin kitepna cheptan thu apen; chutichun Abraham'in Isaac ahingin, aniget nin achep atanin; chuin Isaac chun Jacob ahingin, Jacob'in pului somleni chu ahingin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin puluiho chun Joseph chunga thangset abolun, Egypt gama ajoh mangun; ahinla Pathen'in ama chu aumpin,
  </para>
  <para style="p">
    <verse number="10" style="v" />Agim agentheina jouse-a konin ahuhdoh-in, Egypt lengpa Pharaoh ang sungah khotonale chihna apen, chuin aman Egypt gam chungale, ama insung jouse chunga gamvaipon apansahtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Egypt gam sung jousele Canaan gama kel alhan, gentheina chungnung tah alhungin ahile; ipului teovin neh ding amu tapouvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahivangin Jacob chun, Egypt gama anneh aume ti ajah jah-in, ipu ipateu chu amasa penin agah soldoh-e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aniveina-in Joseph chun asopite chu akihetdoh sahtan ahile, Joseph insungmi chu Pharaoh hetchenin aumtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Joseph'in mi asolin, apale a-inkote abonchan mi somsagi le nga chu ama heng lamah agakou sahtai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jacob Egypt lama achesuh-in; chuin athitan, ipu ipateu jong athi taove;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin alongu chu Shechem'a apo galkaijun, Abraham'in Shechem'a Hamor chapatehoa kona dangka-a achoh lhana chun alupsah taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pathen'in Abraham athutep chu aguilhun aphat alhin konin, miho chu Egypt gama apungun atamcheh atamcheh jengun,
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph hephalou leng chom khat Egypt gam chunga avaipoh gei chun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichepa chun ivaiju dohathemin abolin, ipu ipateu chu abol gentheijin, achasen hou chu ahin louna dingin apaidoh sah jin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche lai chun Mosi apengin ahile, Pathen'a dingin ahoi lheh jengin; apa in'ah lha thum avah-un;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ama akoidoh phatnun, Pharao chanun akilahdoh-in, achapa dingin akivahtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Mosi chu Egypt miho chihna le themna jouse ahilun; chuin ama chu thu le thilbolin thahat tah ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ama chu kum somli alhin phatnin, asopiho Israelte chu gavil ding alunga aumtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin alah uva khat alam louhela bolgenthei thoh amun ahile ahuh-in, bolgenthei thohpa phu chu alan Egypt mipa chu avolih tai;
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman, Pathen'in ama khutna amaho chu ahuhdoh ding ahi chu asopiho chun henaovinte ati ahin; hinla amahon ahepouve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin ajingin alah uva mi ni akidelin ahile ama ahenguva agachen, suhcham ding agon; Vo miteni, nangni sopicha nahiuve; ibola nanghole nangho ahilouva nakiboltou ham? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahivangin aheng akom ahilouva bolpa chun ama chu asondoh-in, Keiho chunga vaipole thutana koiham natunga?
  </para>
  <para style="p">
    <verse number="28" style="v" />Jani-a Egypt mipa natha banga chu tha dinga neigot ham? ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiche aseija chun Mosi ajamin, Media gama apemin, chukoma chun chapa ni ahinge.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin kum somli alhin phatnin, Sinai mol gamthipmah, Pakai vantil'in hamboh-a meikongin akimusah-in;
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Mosi'n hichu amu phatnin, athilmu chu kidang asan; chuin agavechen dingin agache naijin ahile, chua chun Pakai aw ahung gingin,
  </para>
  <para style="p">
    <verse number="32" style="v" />Keima napu napate Pathen, Abraham Pathen, Isaac Pathen, Jacob Pathen kahi, ati. Hichun Mosi akihot hot jengin ave ngam tapoi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Pakai chun ajah-a, Nakenga konin nakengchot chu sutlhan; ijeh-inem itile nadinna mun chu mun theng ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Egypt gama um kamite hesoh genthei chentah-in kamun, apenu kajan, ahuhdoh dinguva hung kumlha kahi; tun hungin nangma Egypt gamah solinge, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hiche Mosi, Keiho chunga vaipole thutana koiham natunga, tia aledohpa tah-u chu, Pathen'in hamboh-a akimusah vantil chu akithopin asemin, vaipo le huhdoh hikop dingin asoltan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ama chun Egypt gamah, chule twikhanglen san le gamthipmah kum somli sungin thil kidang dangle melchihna abolin, amaho chu apuidohtai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pakai na Pathen'un nangho dinga, nasopiteu lah-a kona keima tobang themgao khat asodoh sah ding, athu nangaidiu ahi, tia Israel chate jah-a seija hiche Mosi chu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Sinai molsanga ajah-a thuseija vantil le ipu ipateu toh gamthip gama houbung'a umkhoma, chule eiho pehson ding hinna thu mu-a ama chu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ipu ipateovin ama thua nun ding chu anom hih-un, ama asondoh-un, Egypt lama alungu aheijun,
  </para>
  <para style="p">
    <verse number="40" style="v" />Aaron jah-a, eilamkai dingu pathenho neisem peh-un; ijeh-inem itile Egypt gama kona eipuidoh uva Mosi la hoija itia ahi kahepouve, atiuve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin amahon hiche pet chun bongnou lim asemun, milim houna ding chun gan athatnun, amaho khut sema chun athanomun ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hijeh chun Pathen'in akiheimang sanin, van janelpi hou dingin amaho chu alhatai. Themgaoho lekhabua, Vo Israelte, gamthip gama chu kum somli sunga sa kithat le ganlha-a keima neihou jiuvem?
  </para>
  <para style="p">
    <verse number="43" style="v" />Nanghon Molok Ponbuh le pathen Rephan ahsi hou dinga alim nasemu napoleji bouvui. Hijeh-a chu keiman nangho Babylon kal lampeh-a Katol mang ding nahiuve, tia kisei bang chu ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Alim kigon namu bang bang chun houbuh san, tia Mosi hilpa thupeh dungjuija kisa hettohsahna houbuh chu, gamthip gama chu ipu ipateovin ananeiju ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chujouvin ipu ipateu le Joshua'in hichu aneisonpeh-un, ipu ipateu masang sanga Pathen'in anodohho vaipiho gam alo laiju chun apo lutpeh-un, David nikho lai geijin aumin;
  </para>
  <para style="p">
    <verse number="46" style="v" />Ama chun Pathen mitmu-a deisahna amun, Jacob Pathen umna ding athumin;
  </para>
  <para style="p">
    <verse number="47" style="v" />Ahinla in chu Solomon'in asahpeh jobove.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ahi jeng vangin, Chungnung pen chu khutna kisa houin'a chun achengpoi; themgaovin,
  </para>
  <para style="p">
    <verse number="49" style="v" />Pakaiyin, Van katouna ahin, lei ka kengphang ngapna ahi; itobang in neisahpeh dingham? Kacholngahna mun hoikom ham?
  </para>
  <para style="p">
    <verse number="50" style="v" />Thil jouse hi aboncha kakhut sem hilouham? ati, tia asei banga chu.
  </para>
  <para style="p">
    <verse number="51" style="v" />Nangho milouchal teho, lungsung le nakhanga chep tanlou teho, nanghon a-imatih chanin Lhagao Theng nadoudal jingui; napu napateu bol bang chu nanghon nabolui.
  </para>
  <para style="p">
    <verse number="52" style="v" />Themgao koipen chu napu napateu vin abolset lou umam? Chondihtah hung ding thu sei masaho athatgamun; tun amatah chu amatsah le athatnin nangho napangui;
  </para>
  <para style="p">
    <verse number="53" style="v" />chule vantil thupeh ahi tia nalah sonu danthu chu nanitpouve, ati.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin thu chucheng ajahtah-un, alungchang kikaldoh abang jengun, aha agoi khumun ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ahivangin ama Lhagao Theng adimsetnin, van lam ave aven ahile, Pathen loupile, Pathen khut jet lama Jesu adin chu amun,
  </para>
  <para style="p">
    <verse number="56" style="v" />Veuvin, vanho akihona Pathen khut jet lama Mihem Chapa adin kamui, ati.
  </para>
  <para style="p">
    <verse number="57" style="v" />Ahivangin amaho hatah-in a-aosot jengun, akol asimun, thakhat tah-in anovin;
  </para>
  <para style="p">
    <verse number="58" style="v" />Chuin khopam lama anodoh-un, songin asep aseptaove. Ahetohho chun Saul atiu gollhang khat keng khophang koma apon chengseu akoijun ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chutia chu amahon Stephen songa ase pettah-u chun ama ataovin, Pakai Jesu, kalhagao lan, ati.
  </para>
  <para style="p">
    <verse number="60" style="v" />Chuin adilsun hatah-in asamin, Pakai, hiche chonsetna hi amaho minin sun hih-in, ati. Chuin hiche chu aseijin a-imu damdel tai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Saul jong chun athao chu aphatsah ahi. Chuche ni-a pat chun Jerusalem'a um houbung suhmangna dinga bolsetna khohtah aum pantan ahile, solchah ho chengse tailou adang chengse, Juda gamle Samaria gamah avahcheh taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen'a kipetum ho chun Stephen chu avuijun hakan akauve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Saul vang chun houbung suhmangna habolin abolin, intin-ah alutnin anumei apasal'in ajandoh-in, songkul'a akhum akhumin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun avahchehho chu gamtinah avahleuvin, thu chu ahille taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Philip Samaria khopi-a achesuh-in, ajah uva Christa chu aphongjal letai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin melchihna abol ho chu amuva athuseiho ajah phatnun, mipi chengse chun Philip thusei ho chu lungkhat tahle lunglut tah-in angaitaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu lhagao boh vop mi tamtah-a konin lhagao bohho chu hapen nin apengun, ahung potdoh-un; chule langthi le elbai jong tamtah boldama um ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin chuche khopi sunga chun kipa thanop nasatah aumtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin hiche khopi-a chun amin Simon kiti mitpheldoi choi khat anaumin, ama chun milen khat kahi tia Samaria miho chu kidang satah-a anaumsah ahi:
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon ama thu chu anangai lheh jengun, aneopena pat alenpen geijin, Hichepa hi Pathen thahat chungnung chu ahi, atiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sotpeh-a pat aman amitpheldoija amaho chu kidang satah-a aumsahsa ahi jeh-a, athu angai lheh jengu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahivangin Philip'in Pathen lenggam thu le Jesu Christa min ahillhang atahsan phatnun, anumei apasal'in baptize achang taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Simon, amatah jongin atahsantan, baptize achan jouvin Philip toh aum khomjom lhonin, melchihna le bolmo thil kidang kibolho chu amun, kidang asa lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Jerusalem'a um solchah hon Samaria mihon Pathen thu ajoptaove ti ajah phatnun, Peter le John agahsol taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amani chu alhunsuh phat lhonin, Lhagao Theng achan theina dingun amaho ding chun ataopeh lhone;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu hiche geija chu alah uva khatchabeh chunga chu loulai ahin; Pakai Jesu mina baptize changmai maibou anahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutah chun alu chunguva akhut angam lhonin ahile, Lhagao Theng achang taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Simon'in solchah ho khut ngap vanga Lhagao Theng kipeh chu amun, amani chu sum peh agon,
  </para>
  <para style="p">
    <verse number="19" style="v" />Koi chung koi chung hijongle kakhut kangaple ama chu Lhagao Theng achan jeng jengna dingin, keima jong hiche thilboltheina hi neipeuvin, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin Peter'in ajah-a, Nangman Pathen thilpeh suma choh dinga nangaito jeh chun, nasum chu nangtoh manthan!
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen mitmu-a nalungput adih lou jeh chun, hiche thua hin lhahna naneipoi, chan jong naneipoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun hiche nagitlouna-a konhin nalung heijin, nalung sunga gitlou natup chu angaidam theikhat le Pathen henga taovin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Chonsetna khatveng vungna thinkha-a lhalutna, chule gitlouna-a kikan nahi chu kahedohtai, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Simon'in adonbutnin ajah-a, Nathuseiho chu khatcha jong kachunga alhun louna dingin, Pakai henga neitao peh-un, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiche chun amanin Pakai thu ahettohsah lhona asei jou lhonin, Jerusalem lama akile kit lhonin, Samaria kho tamtah-ah Kipana Thupha chu ahil lhangpeh lhontai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakai vantil khatnin Philip jah-a thu aseijin, Kipatdoh inlang lhang lama Jerusalem'a kona Gaza jotna lampi-a khun chesuh-in; chumun chu gamthip ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ama akipatdoh-in achetai; chule veuvin, Ethiopia gama mi khat nukiso, Ethiopia lengnu Candace noija thunei chungnung tah, agou jouse chunga vaihom, Jerusalem'a Pathen hou dinga chea ahin;
  </para>
  <para style="p">
    <verse number="28" style="v" />Akile kit lama kangtalai ja akitol puma themgao Isaiah lekhabu chu asim ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Lhagaovin Philip jah-a, Khuche kangtalai khu naijin lang kiloipin, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Philip ahenga alhaijin ahile, Isaiah themgao lekha chu asim ajan, ahengah, Nasim chu nahet nah-em? ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman, Mi khattouvin eihilchet loule iti kahet thei dingham? ati. Chuin Philip chu kangtalai chunga kaldoh-a akoma tou dingin akoutai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amapan Pathen lekhabu anasim asimmun lai chu hiche hi ahi: Ama chu tha dinga kikai kelngoi bangin akaijun; kelngoi nou amul vouho anga hampoh louhela aum bangin, Ama jong akam kapoi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Akineosah nalamin achunga thutan dih aki subeijin; akhang thu koiham aseiphong dinga? ijeh-inem itile leisetna kona ahinna asuhmangu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin nukiso chun Philip adonbutnin, Themgao chun hiche hi koi thudola aseiham? Ama thudola aseiha, midang thudola aseiham? ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Philip akamkan, chuche Pathen lekhabua thua chun apanin, Jesu thu aseitan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuti chun lampi-a chu ache che lhonle, twi umna mun khat agei lhonin; chuin nukiso chun, Ven, hikoma twi aume; baptize kachanmona ding ipi umam ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Philip'in, nangman nalung pumpi-a natahsan le chang thei jin nate, ati. Chuin aman adonbutnin, Jesu Christa chu Pathen Chapa ahi ti katahsane, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin akangtalai chu angahsah-in, Philip le nukiso chu ani lhonin twijah akumlha lhonin, chuin Philip'in ama chu baptize achansah tai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin twija kona ahungdoh lhon phatnin, Pakai Lhagaovin Philip chu alhohmang tan ahile nukiso chun amukit tapon, kipah thanom tah-a achena dinga achepaitan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Philip vang chu Azotus khopi-a amudoh-ui. Chuin aman ajotpaijin, Caesaria alhun kahsen khopitinah Kipana Thupha chu ahillhang pehtan ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Saul vang chu Pakai seijui ho gihsal le that dingin ahai haina laijin, thempu chungnung henga achen,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuche lampi tahsan chan chu koi hijongle amu mu numei jong pasal jong akana Jerusalem'a ahinkai theina dingin, Damascus-a kikhopnaho-a dingin lekha agathume.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun achele Damascus kho alhun ding konin, phulou helouvin van'a kon vah khatnin avel asalvah soh jenge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ama tolah alhun, chule ajah-a, Saul, Saul, nangin ibola suhmang dinga neibolset jingham? tia kisei aw ajan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman, Pakai, nang koi nahim? ati. Chuin Pakai chun, Suhmang dinga nabolset Jesu chu kahi, nang dingin thihtul monghem lho ahahsai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule aman kithing pumle lungdong tah-in, Pakai ipi neibolsah nom em? atin ahi. Chuin Pakai chun ajah-a, Thouvin lang khopi sunga luttan; chule nabol ding nakiseipeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule alhonpiho chu pao louvin adingun, aw vang chu ajauvin mi koima amupouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Saul tolla kon chun athouvin, chuin amit ahasahle ima amutapoi. Hichun akhutnin akaijun Damascus'a chun apuilut taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin khomu lou leh an ne lou twi don louvin ni thum aumin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun Damascus-a chu amin Ananias atiu seijui khat uma ahin; Pakai chun gaovin akimusah-in ajah-a, Vo Ananias, atin ahile, aman, Ven, Pakai, hikoma kaumnai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin ajah-a, Kipatdoh-in, Lamjang atiu khosung lamlena khun gachenlang, Judas in'ah Tarsus kho-a mi amin Saul atiu chu gaholin; ijeh-inem itile ven, ama atao pettah ahi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule aman mi khat amin Ananias ahunga, kho amu theina dinga alu chunga akhut angap amui, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahivangin Ananias'in adonbutnin, Pakai, keiman chuche mipa umchan, Jerusalem'a nangma mithengho itobanga khoh-a abolsetje thu chu mi tamtah-a kona kajah ahitai;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hikoma jong nangma min pan jouse kan dinga thempu pipuiho-a kona thu anei ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin Pakaiyin ajah-a, Chen: amakhu chidang namdangho henga, lengho henga, chule Israel chate henga kamin polutle dinga kamanchah lhen hija ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ijeh-inem itile aman keima min jala ichana genthei hesoh athoh ding ham kavetsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Ananias chu agachen, in'a chun alutnin, chuin alu chungah akhut angamin; Sopi Saul, nahunga lampia nakimusah Pakai Jesu chun kho namu theina dingle Lhagao Thenga nadimna dinga eihinsol ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin chupettah chun amitna konin lip tobang ahung pullhan ahile kho amutai; chuin ama akipatdoh-in baptize achangtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin an anen, atha ahattai. Chujouvin ni ijat-ham Damascus-a seijui ho toh aum khomtaove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin kikhopna intin-ah Christa chu Pathen Chapa ahi thudol ahillhang paitan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin athusei ja jouse chun kidang asa lheh jengun, Jerusalem'a hiche min panho jouse sucheh-a chu ama hi hilou hija, Chule amaho chu kanchoma thempu pipuiho henga kailut dinga hikoma hunga hilou ham? atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Saul chula athahat akhang cheh cheh-in, hiche Jesu hi Christa ahi mong monge ti photchena aseijin, Damascus-a um Juda ho chu anel khupjin akisuh dongsah jitan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ni tamtah jouvin, Juda ho chu Saul that dingin akihousom taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahivangin agutuhnau chu Saul'in ahedohtai. Chuin amahon ama chu atha theina dingun sunle jan-in kotpiho jong chu angahjiuvin ahi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahinla aseijuihon jan-in apuijun, bomin kul pangah akhailha taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin ama Jerusalem alhunin, seijuiho toh kiloi ding agon ahile, amahon ama chu seijui khat ahi ti atahsan lou jeh-un, akichao vin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahin Barnabas'in apuijin solchah ho henga apui lutnin, ajah uva, Lampia Pakai amua, ajah-a thu asei, chule Damascus-a hakat tah-a Jesu min ahillhangle chu aseitan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ama amaho chutoh Jerusalem'a alutle apotleuvin,
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakai Jesu minin hakattah-in ahillhanglen, chule Greek gam Juda ho chu anelkalin; ahinla amahon ama tha dingin agotauvin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin sopiten hichu ahet phatnun, Caesaria-a apuilhasuh-un, Tarsus kho-a asolmang taove.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutichun Judah gam sungse-a, Galilee gam sungse-a, chule Samaria gam sungse-a houbung chu adet chehcheh-un, mongtah-in aumtaove; chule Pakai gingpuma hinkho mangin, Lhagao Theng lungmonsahna achangun, amaho apung tultul taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin ahitin ahi, Peter gamtina avahle avahlen, Lydda'a um mitheng ho heng geijin agalhung suh tai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chukoma chun, mi khat amin Aeneas atiu, alangthi jeh-a kum get ajalkhuna lum agamudoh-in ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Peter'in ajah-a, Aeneas, Jesu Christan nadamsah ahitai: thouvin lang nalupna kisemin, ati. Chuin chupettah chun ama athoudoh paijenge.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Lydda'a cheng jousele Sharon'a cheng jousen ama chu amuvin, Pakai lamah akihei taove.
  </para>
  <para style="p">
    <verse number="36" style="v" />Joppa-a chu seijui khat amin Tabitha atiu aumin, hichu Dorcas tina ahin, amanu chu thilphabol le mi thilpeh-a bulhingtah ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule ahitin ahi, hiche laichun ama chu anan ahile athitai; chuin amahon asilun, indan chungnunga alupsah taove.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Lydda chu Joppa kom nai ahi jeh chun, seijui hon chua chun Peter aume ti ajauvin, geisang louva ahenguva ahung nadingin, ahenga mi ni asolun ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Peter akipatdoh-in amani chutoh alhontai. Chuin alhunin amahon indan chungnunga chun apuijun; meithaiho jouse chu akimvela adingun kap pumin, Dorcas'in ahin laija abolpeh-u sangkhol le ponsil hochu avetsah-un ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahivangin Peter'in amaho chu abonchauvin apotdoh sah-in, adilsun ataotai. Chuin along lama chun akiheijin, Tabitha, thouvin, ati. Chuin aman un amit ahinha sah-in; chuin Peter amu phat chun atoudoh tai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin aman akhut apen akaithou tai; chuin mithengho le meithaiho akouvin, amanu chu ahingin apetai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin hichu Joppa kho-a jouse chun ahesoh taovin, mi tamtah-in Pakai chu atahsan taove.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin ahitin ahi, Peter chu Joppa kho-a savun sem Simon in'ah ni tamtah aumin ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Caesaria-ah mi khat amin Cornelius atiu aumin, Italy loi atiu sepai jalamkai ahin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen ngaisahtah le a-insung mi jousetoh Pathen gingtah, miho ngailut thilpeh tamtah peji-a, chule Pathen henga tao jingjia ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni khat kolbunoi hon phat donin, Pathen vantil khat ahenga kichen tah-a gaova ahunga, Cornelius, ahung ti amun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman ama chu ave aven, akichan, Ipiham, Pakai, ati. Chuin ama chun ajah-a, Nataonaho le nami thilpehho chu geldoh jing dingin Pathen angah alhung toutai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule tun nangman Joppa-a mi solinlang, Simon amin chom Peter asah-u chu gakousah-in;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama twikhanglen panga Simon atiu savun sem mi khat in'ah alhunge; aman ipi nabol ding nahil nan nate, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Cornelius jah-a thusei vantil chu achedoh phatnin, a-insung lhachaho lah-a mi nile ajenlea pang jingho lah-a Pathen ngaisahtah sepai khat akouvin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Thu jouse chu abonchan ajah uva aseisoh phatnin, Joppa-a asoltan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajingin amaho ache acheuva khopi chu alhun ding konun, Peter chu tao dingin sunkim donin in chungah akaltouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin hatah-in agilkeltan an aneh nom-in ahi; ahinla aneh ding agotpeh laitah-un agaochangin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Van akihona bom khat ponlhe lentah banga aning li-a kikhit, tolla ahung kikhai lhah amun;
  </para>
  <para style="p">
    <verse number="12" style="v" />Asunga chun leiset chunga akengli sa namkim, tolla vah ganhing namkim, chule chunga leng vacha namkim aumin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahenga aw khat ahungin, Thouvin, Peter; kithanlang nen, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin Peter'in, Chutiponte Pakai! ajeh chu keiman imatih chanin thilboh le athenglou kanekhapoi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aniveina-in aw khat ahung kitnin, Pathen'in asuhthengsa chu nangman aboh ti hih-in, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin hitichun thumvei ahung umin, bom chu van'ah akikhaitou kittan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Peter'in agaochana amu chu ipi tina ahidem tia alunggim pettah chun, veuvin, Cornelius mi sol hochun Simon in ahin holun, kelkot phunga adingun;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule akouvun, Simon amin chom Peter chu hikoma chu lhungam tin adongui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Peter'in agaochanna amu chu angaito pettah-in Lhagaovin ajah-a, Ven, mi thumin nahole.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun thouvin lang kumlha suh-in, lung sa-ih louhelin amaho khutoh lhonin; ijeh-inem itile amaho khu keima sol ahiuve, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Peter Cornelius-a kona ama henga hungkisol miho henga chun akumlha suh-in, Veuvin, naholu chu keima hi kahi; ibola hunga nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amahon, Mi chondihtah, Pathen ging, Juda vaipin aseiphat, Cornelius sepai jalamkai chu nangma hung kousah-a a-in'a nathusei ngai dingin, Pathen'a konin vantil theng khatnin ahilin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman amaho chu akou lutnin alhunsahtai. Ajingin Peter amaho chutoh alhondoh-in, chule Joppa-a konin sopiho koi koihamin alhonpiuvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ajingin Caesaria aluttaovin, chule Cornelius chun a-inkote le ajol agol chengse anakou khomin, amaho chu anangah jingun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Peter agalutnin ahile Cornelius'in agalamton, akengphang bulah aboh khupmin, ahoutan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahivangin Peter'in akaithouvin, Dingdoh-in, keima jong mihem kahibouve ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ama chutoh ahoulim lim pumin agalutnin ahile mi tamtah kikhom agamun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman ajah uva, Juda min jat dang mi khat akiloipia, chule namdang henga ache chu dan ngai ahilou chu nanghon naheuve; ahinla Pathen'in keiman mi koima aboh le athenglou kati louna dinga eimusah ahitai:
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijeh-a chu keima jong thupha louhela eikou nahinsolle kahung jeng ahi. Hijeh chun ipi dinga neihung kousah ham? tia kadoh nahi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Cornelius'in, Ni li masangin tuphat gei hin an kangol-in, chule kolbunoi honphat donin ka-insunga kataovin ahile, ven, ka-anga pon bang kisil mi khat ahung dingin;
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin kajah-a, Cornelius, nataonaho kisanga ahitai, chule nami thilpehho jong Pathen mitmu-a geldoh jinga kineija ahitai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun Joppa-a mi solinlang Simon amin chom Peter chu gakousah-in; ama twikhanglen panga savun sem Simon in'ah alhunge, ama chu ahungtengle nahil tante, eiti.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiche jeh-a chu nakou kahinsol pai jeng ahin, tun nangma nahungin aphalheh jenge. Hijeh chun tun Pathen nin nangma thu napeh ho chengse chu ngai dinga, Pathen mitmu-a kabon chaova hikoma kikhoma kahiuve, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Peter akamkan Tahbeh mongin, Pathen'in mi dat aneipoi, ti kahei;
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahin namtin lah jouse-a mi koi hijongle ama ginga, chule chonphat bola chu ama dinga lah thei ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pathen'in Israel chate henga thu athot, Jesu Christa'a chamna thu alhangsap, (ama chu mi jouse Pakai ahi);
  </para>
  <para style="p">
    <verse number="37" style="v" />John'in alhangsap baptize chan nunga, Galilee'a kipanin Juda gam pumpi-a chalsoh thuhi nanghon naheuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hichu hiti hi ahi, Pathen'in Nazareth Jesu chu Lhagao Theng le loupina-a thao anu ahin, ama muntin-ah avahlen, thilpha abollen, Satan bolgenthei hesohho abonchan aboldamin ahi; hichu Pathen'in aumpi jeh ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule Juda ho khotin le Jerusalem'a athilbol jouse hetoh keiho kahiuve; ama chu thinga akhaijun athat taove.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ama chu Pathen'in anithum nin akaithouvin, lhangphong tah-in akimusah tai;
  </para>
  <para style="p">
    <verse number="41" style="v" />Mi jouse heng hilouvin, amasanga Pathen'in alhendoh ahetohho, athodoh nunga amatoh nekhoma donkhom keiho heng ahibouve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin, Ama chu ahingle athi thutan dinga Pathen'in atun ahi ti thu miho hille-a hetsah dingin eithupeh uve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ama min vanga, ama tahsan chan chu achonset suhbeija umding ahi, tia ama thudol chu themgaoho jousen ahettoh sah sohkeiju ahi, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Peter'in thu chucheng asei pettah chun, athu jaho jouse chunga chun Lhagao Theng ahung chutan ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin cheptanho lah-a atahsanho Peter hinlhonpi chengse chun, Lhagao Theng kipe chu chidang namdangho chunga jong akibuh lhah jeh chun adatmo lheh jengui.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ajehchu amahon paochom choma thu aseijuva, Pathen avahchoiju chu ajah-u ahi. Hichun Peter'in adonbutnin,
  </para>
  <para style="p">
    <verse number="47" style="v" />Eiho banga Lhagao Theng changa hiteho baptize chan louna dinga twi kham theija koi umam, ati.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin aman Pakai mina baptize chang dingin amaho chu thu apetai. Chuin ni ijat-ham nichong dingin alhotauve.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin solchah ho le Juda gama um sopihon chidang namdang hon jong Pathen thu ajoptaove, ti ajataove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Peter Jerusalem agalhun touvin, cheptanhon ana-oimovin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Cheptan louho in'a nalutnin amahotoh nane khome, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla Peter'in abula panin abanchan ajah uva ahilchenin, hitin ati:
  </para>
  <para style="p">
    <verse number="5" style="v" />Joppa kaumin kataovin, chuin gaochanin mu kaneijin, ponlhe lentah tobang bom aning li-a kikhit van'a konin ahung kikhailhan, keima komlele ahung geijin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin keiman hichu hoitah-a kavetna kangaitoa ahile, leiset chunga akengli saho, gamsaho, tolla vah akhupbo-a kithol, chule vanlaijola lengle vachaho kamui.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin kajah-a thusei aw khat kajan, Thouvin, Peter; kithanlang nen, eiti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin keiman, Ahipoi, chutiponte Pakai; keiman imatih chanin thilbohle athenglou kanekhapoi, kati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin aniveina-in aw chun van'a konin eidonbutnin, Pathen'in asuhthengsa chu nangman athenglou ti hih-in, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin hitichun thumvei akibolin, abonchan van'ah akikhaitou kit tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin veuvin, Caesaria kona kahenga hinkisol mi thum chu, kaumnao in kot maija anading jinga ahitaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Lhagaovin koima dat bih nei louva amaho chutoh lhon dingin eisole. Hiche sopiho gup jong hin eilhonpiuvin, chuin mipa ina chun kalutnun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amachun a-in'a vantil adin amua ajah-a, Joppa-a mi solinlang, Simon amin chom Peter chu gapuisah-in;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama chun nangmale na-insung mi jouse huhhing-a naumna dingu thu naseipeh ding ahi, tia asei umchan chu kajah uva, aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin thu kagah sei patna ahile, atila eiho chunga achuh bang chun Lhagao Theng achunguvah ahung chutai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin keiman Pakai thusei, John'in twija baptize achansahji ahin, nangho vang Lhagao Thenga baptize nachan dingu ahi, ati chu kagel doh-e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutichu ahin, Pakai Jesu Christa itahsan uva eiho eithilpeh banguva chu amaho Pathen'in apehtah-a ahile, kei koi kahia Pathen kakham thei dingham, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amahon thu chucheng ajah phatnun athip taovin, Pathen avahchoijun, chuti ahile Pathen'in chidang namdangho jong hinna dinga lungheina aphalpeh ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun Stephen chunga hesoh genthei ana sohdoh jeh-a vahcheh hochu Phoenicia, Cyprus chule Antioch geijin acheuvin, koima dang henga sei louhelin Juda ho heng jenga thu chu aseiletaovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin alah uva mi abang chu Cyprus le Cyrene gam mi ahiuvin, Antioch alhunun Greek miho henga jong thu aseijun, Pakai Jesu asei phongle taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Pakai khut chun akithopiuvin; chuin atahsana mi atama tam Pakai henglama akihei taove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amaho umchan thu chu Jerusalem'a um houbung mihon ajataovin; chuin amahon Barnabas chu Antioch geija che dingin asolun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ama chu alhunin, Pathen milungset chu amun ahile akipah-in; chuin amaho chu Pakaiya abechah jingna dingu lung ngaiton, abonchauvin atilkhouvin ahi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Ijeh-inem itile ama chu mipha ahin, Lhagao Theng le tahsanna-a dimset ahi; chuin miho atama tam Pakaiyah alutbe taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin ama Saul hol dingin Tarsus kho-a achen;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amudoh phatnin, Antioch-a chun ahinpuitai. Chuin ahitin ahi, kum khatjen houbung ho chutoh akikhomji lhonin, mi tamtah ahilji lhonin ahi. Chule Antioch-a chu seijui ho Christian tia kikou masapen ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin hiche lai chun themgao koi koiham Jerusalem'a konin Antioch-a ahungun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin alah uva khat amin Agabus chu adingdoh-in, Lhagaovin aphondoh-a konin vannoi gam jouse chunga kel lha ding ahi, ati; hichu Claudius Ceasar nikho laijin aguilhungin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin seijui ho chun ajokham cheh-a Judea gama cheng sopiho chu huna thot dingin akilol taovin;
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichun boljong abolun, Barnabas le Saul khutna upaho agahthot taove.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche lai vel chun Herod lengpan houbung ho lah-a phabep bolset dingin agon, akhut alamtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin John upa Jacob chu chemjamin athat tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche abolchun Judah ho alunglhaisah chu amun, Peter jong chu amatbetan ahi. (Hiche lai chu cholsolou changlhah kut lai ahi).
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ama chu amanin, songkul'a akhumin, angah dingin sepai loi li hochu apedoh-in; kalchuh kut joule miho henga puidoh ding alung got ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiti chun Peter chu songkul'a akhumun angahtauve: ahin houbung min ama ding chun Pathen henga lunglut tah-in ataopeh-un ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Herod chun kaidoh dinga agot jantah chun, Peter sepai ni kah-a thihkhao ni-a kihena imua ahin; angahho jong chu kotbula dinga songkul chu ngah jinga ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin veuvin, Pakai vantil khat akoma ahung dingin, chule vah khatnin aumna mun chu asalvah-in; chuin ama chun Peter chu apang abengin, asukhangin, Thoudoh loijin, ati. Chuin akhutna konin akihena thihkhaoho chu akhelha tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin vantil chun ajah-a, Nakong kigeh-inlang, nakengchot kisen, ati. Chuin aman hitichun aboltai. Chuin ama chun ajah-a, Napon kisilin kanung hinjuijin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ama apotdoh-in ajuitai; hichu vantil'in abol tahbeh ahi chu he louvin, gaochana mu nei jin akingaiton ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanin kot ngah masale anina akhel lhona, khopi sunglam jotna-a thih kot phung chu agei lhon phatnin, kot chu amani ding chun achamin akihong jenge: chuin achedoh lhonin khosung lamlen khat ajot lhung lhonin; chule chua konchun vantil chun ama adalha tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Peter akhahdoh phat chun, Pakaiyin avantil ahinsola, Herod khutna konle Juda mite kinepna jouse-a kona eihuhdoh ahi ti tun chentah-in kahetai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin akingaito jouvin mi tamtah akikhop uva ataonao Mark atiu John nu Mariam in'a chun agachen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Peter'in hongcha kot akiuvin ahile, nungah khat amin Rhoda atiu chu adonbut dingin ahunge.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman Peter aw ahi ahet phatnin, akipa manin kot hongta louvin alhai lutjelin, Peter kot phunga adin chu aga seije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amahon amanu jah-a, angola nahi, atiuve. Ahivangin, Aman ahimonge, ati changsalin ahi. Chuin amahon, a-vantil hichu, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin Peter'in akiu akiuvin; amahon kot chu ahonule ama amuvin, adatmo lheh jengui.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin aman athipbehna dingun akhutnin ajapmin, Pakaiyin songkul'a kona ahin puidohje umchan chu aseitan ahi. Chuin, hiche thuho hi jacob le sopiho seipeh-un, ati. Chuin ama apotdoh-in mun danga achetai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin khovah vah-in, sepaiho chu, Peter hoija um hitam, atiuvin lungjin mainah-in alung jing pouve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Herod chun aholin amutapon ahile, angahho chu achunguva thu atanin, amaho chu tha dingin thu apetai. Chuin ama Juda gama konin Caesaria ache suh-in, chukoma chun aumdentai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche laija chu Herod Tyre le Sidon miho chunga ha lunghana lunghanga ahin; ahivangin amaho thu khat akisauvin, ahenga acheuvin, lengpa insung vaihom amin Blastus chu akihouthei piuvin, kichamna ding athumui; ajeh chu lengpa gama kona amaho gama anneh hungji-a ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin akinitep niuvin, Herod chu leng vonin akivonin, alal touna-a atouvin ajah uva chun thu aseijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin miho chun, Mihem awso ahipoi, pathen awso ahi, tin asamui.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman loupina chu Pathen apeh lou jeh chun, Pakai vantil'in chupettah chun adengin ahile, lungin anen athi tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathen thu vang chu achal jal-in, akhangtou chehchehtai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Barnabas le Saul akin lhon achai phat lhonin, Jerusalem'a konin akile lhonin, John amin chom Mark chu apui lhone.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Antioch houbung'a chun themgaole mihil phabep aumun, amahochu: Barnabas, Niger atiu Simeon, Cyrene mi Lucius, Herod lengpa toh kivahdoh tha Manahen, chule Saul ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amaho chu Pakai lhachale-a apanuva an angol laijun Lhagao Thengin, Kakouna natong dingin Barnabas le Saul neise khenpeh-un, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin an ngola atao jouvun, achung lhona akhut angamun asoldoh taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutichun Lhagao Theng soldoh-in amani Seleucia achesuh lhonin; chuin chua kon chun Cyprus lama akitol lhontai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Salamis kho alhun phat lhonin, Juda ho kikhopna inho-a chun Pathen thu ahillhangle lhontai. Amanin akithopi lhon dingin John jong akipui lhone.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichun twikol gam sung chu Paphos geijin achonsoh lhonin, Bar-Jesu atiu Juda mi, mitpheldoi choile, themgao lhem khat amudoh lhone.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama chu milung ching, twikol gamvaipo Sergius Paulus chutoh uma ahi. Gamvaipo chun Saul le Barnabas akouvin Pathen thu chu ngai ding agotan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin mitpheldoi choipa Elymas chun (hichu amin kiledohna ahi) gamvaipo chun atahsan louna dingin, amani chu adoudalin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Saul'in, (Paul jong akitin,) Lhagao Thenga dim pumin ama chu ave aven,
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo nangma jouva lheplhah le minambol dimset diabol chapa, chonphatna jouse melmahpa, nangin Pakai lampi dihho akaleh-a hei natat lou ding ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule tun, ven, Pakai khut nachunga achui; chule phat chomkhat sung nisa mu louva mitcho-a naum ding ahi, ati. Chupettah chun meijinle muthim achunga ahung chupai jengin; chuin aman akhutna kai ding mi ahol letai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutah-in gamvaipo chun thil kibol umchan chu amu phat chun, Pakai thuhil chu kidang asa lheh jengin atahsantai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Paul aloihotoh Paphos'a konin akitolun, Pamphylia gama Perga alhung taove; chuin John'in amani adalhan Jerusalem lama akile kit tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amani vang chu Perga'a konin achepeh lhonin, Pisidia gama um Antioch alhung lhonin; chuin cholngah nin kikhopna in'ah alut lhonin atou lhontai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin danthu le themgaoho thu asim jouvin, kikhopna in vaihomhon akom lhona mi asolun, agahseijun, Sopiteni, miho-a dinga tilkhouna thu ima nanei lhonle sei lhonin, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Paul adingin akhut ajah-in thu aseijin, Vo Israel miho, chule vo Pathen gingho, ngaijun:
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche Israelte Pathen hin ipu ipateu alhengin, amaho Egypt gama apem laiju chun amite chu achoisangin, chuin aban thahat chungnungin amaho chu ahin puidohtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin kum somli jen gamthipma achonnau chu ana thoh hamhamin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Canaan gama vaipi sagi asumangin, amaho gam chu alo dingun ahop pehtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin hiche jou chun kum ja lile kum somnga sungin, Samuel themgao nikho lai gei chun thutan vaihomho apejin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon leng athumun ahile Pathen'in amaho chu Benjamin phunga Kish chapa Saul apen, kum somli geijin akoije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin aman ama chu achon mangin, aleng dingun David atungdohtai; ama thudol chu ahettohsah-in, Keiman keima lungdoltah mi khat, Jesse chapa David kamudohtai; ama khun kalunggot jouse abol bulhit ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuchepa sonho lah-a chun Pathen'in thutep dungjuijin Israelte hengah Huhhing-a khat, Jesu chu ahinlhut tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama hung masangin John'in Israel miho jah-a lungheija baptize chan ding thu ahillhang tan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />John'in anatoh achaiding konin, Nanghon keima koi kahia neingai touvem? Keima ama chu kahipoi. Ahin, kanunga mi khat ahunge; keima akengchot sutlham dinga jong kilom kahipoi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Vo miho chule sopiteho, Abraham chateho, chule nalah uva Pathen gingho, hiche huhhingna thuhi nangho henga hinkithot ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ijeh-inem itile Jerusalem'a chengho le avaipoteuvin ama chu ahetlou jeh-ule, cholngah niseh-a kisimji themgaoho thu ahettoh lou jeh-un, hiche thu chu bulhitnan ama chu themmo achansah taove.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule athina thei ajeh aholmosan jongun, Pilate henga athana ding athumui.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aumchan ding thudol kisun masa jouse chu asuh bulhit sohkei phatnun, thing chunga konin alalhauvin, lhanah alupsah taove.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin Pathen'in ama chu athi lah-a konin akaithou tai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Galilee'a kona Jerusalem geija alhonpiho chun ni tamtah geijin amu jingjiuvin, amaho tulaija miho henga athu hettohsah-a pangho hi ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule ipu ipateu henga thutep thudola Kipana Thupha chu keihon nangho kahung hetsah nahiuve;
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathen'in Jesu akaithouva kona achateu eiho dinga thutep chu amolso ahitai. Chujongle hiche thudol hi Labu bung nina-a jong, Nangma ka-Chapa nahi, tunia hi kahin nahi, tin akisune.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman monmang na-a kilekit talou dinga athi lah-a kona akaithou ding thudol chu, hitin aseije, David phattheina thon loule athenga chu keiman nangho kapeh dingu nahiuve, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hijeh chun aman Labu mun danga, Namitheng chu mon mangna namusah lou ding ahi, ati kitleuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ijeh-inem itile David chun Pathen lungdei bangin ama khanga miho ding na atoh jouvin, a-imu miltan; chuin apu apate koma alupsah-un ahile mon mangna chu amutai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahin Pathen'in akaithoupa vang chun mon mangna amupoi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hijeh chun hiche hi heuvin, miho chule sopiteho, Ama vanga chu chonset ngaidamna thu najah uva kiseija ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Koi hijongle atahsan chan chu Mosi danthua them nachan jou lounao imajousea kona, ama vanga chu them changa ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hijeh chun chingtheijun, achuti loule ajole themgao thusei ho chu nachung uva lhungkha getninte;
  </para>
  <para style="p">
    <verse number="41" style="v" />Vo nahsahmoho, nanghon veuvin. Kidang saovinlang mangthah-un; nanikho laijun thilkhat kabole, hiche thil chu min seipeh jongleu chun natahsan louhel dingu ahi, ti hi, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Juda ho chu kikhopna in'a kona apotdoh phatnun, chidang namdangho chun cholngah nikit jongle chuche thuchu aseipeh kit diuvin ajolun ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin akikhomho chu akikhen phatnun, Juda mi tamtah le Juda houva lut Pathen ngaisahho lah-a mi tamtah-in Paul le Barnaba nung ajuitaove; chuin amanin amaho chu ahoulimpi lhonin, Pathen lungsetna-a umdet jing dingin atilkhou lhontai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Cholngah ni kitnin akhopi pumpiuvin Pathen thu ngai dingin akikhom taove.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ahivangin Juda hon mipi chu amu phatnun athangseuvin, Paul thusei chu adoudalun, ataitomun, chule anelkal taove.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Paul le Barnaban hakattah-in, Pathen thuhi nangho henga sei masah ding dol mong ahin; ahivangin nanghon napam paijuva, tonsot hin kemlou changa kilom louva nakigot jeh-u chun, veuvin, chidang namdangho henga kakiheiju ahitai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ijeh-inem itile Pakaiyin hiti hin keiho thu eipeuve, Vannoi leiset kolmong geija sochatna hi dinga, Keiman nangma chidang namdangho salvah-a kapansah nahi, ati tin asei lhontai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chidang namdang hon hichu ajah phat uvin akipah athanomun, Pakai thu chu achoi-an taove, chule tonsot hinkemlou chang dinga gotsa um chengse chun atahsan taove.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin Pakai thu chu chuche gamkol sungse-a chun achalsohtai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahivangin Juda hon Pathen ngaisah numei lal hole, khopi sunga pipuiho atilseuvin, Paul le Barnaba chu abolsetsah-un, agamgi sunguva konin adelmang taove.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin amanin amaho douna-in akengphang lhona leivui athinglha lhonin, Iconium kho lama ache lhontai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin seijui ho chu kipana le Lhagao Thengin adimset taove.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Iconium kho-a chun ahitin ahi, amani Juda ho kikhopna in'a alut lhonin, thu asei lhonin ahile, Juda miho le Greek mi atama tamin atahsan jengtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahivangin thua nunglou Juda hochun chidang namdangho atilseuvin, sopiho chu amuda sah taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun sottah aum lhonin, alungsetna hettohsah-a akhut lhona thil kidangle melchihna bolsah Pakaiya chun hakattah-in thu aseiji lhonin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun khopi-a mipi chu akikeh khenun, akimkhat Juda ho lama, akimkhat solchah ho lama apangtauve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin chidang namdangho le Juda hon avaipohou to kitho-a amani chu nahsahmo-a bola songa seding agouvin ahile,
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichu amanin ahedoh lhonin, Lycaonia gama Lystra le Derbe kho, chule akimvelah-a ajam lut lhonin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chua chun Kipana Thupha agahil lhangle lhontai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lystra kho-a chun imatih chana lamjot lou, akenga tha himhim umlou, apena elbaija peng khat atouvin, Paul thusei angai jingin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman ama chu ave aven, boldama aum ding atahsan chu ahen,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hatah-in asamin, Nakengin pansan ding jangin, ati. Chuin ama akichomin adingin lam ajottai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutah chun mipi chun Paul thilbol chu amu phatnun, Lycaonia paovin, pathenho mihem lima ihenguva hung kumlha ahiuve, atitaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon Barnaba chu Jupiter asah-un, chule Paul chu thuseija apipui ahi jeh chun Mercury asah taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin khopi kotmaija a-houin uma Jupiter hou thempupa chun bongchal le pahchavui kotpi phunga ahin choijin, mipi chutoh amani houna-a chu tha dingin agotauvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin solchah teni, Barnabas le Paul chun hichu ajah lhon phatnin, apon asat-eh lhonin, mipi heng lama chun alhaijel lhonin, asam lhonin,
  </para>
  <para style="p">
    <verse number="15" style="v" />Vo miho, ibola hitobang hi nabol uham? Keini jong nang hotoh kithakhat mihem kahilhon bouve; chule hiti mohthil ho-a kona hi vanle lei twikhanglen chule asunga thil um jouse sema Pathen hing henga nakiheina dinguva, Kipana Thupha kahung lhutpeh nahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche Pathen chun malaija chu namtin vaipi jouse hi aningnop cheh-a analhatsah ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin ama hettohsahna beijin anaumpoi, Hitichun phatna abol jingin, van'a kon gotwi le ima ga phatle anneh eipeuvin, ilungthimu kipa thanop na-in adimsahjin ahi, ati lhone.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thu hicheng chu asei lhona konchun, nah nah-in amani houna-a gan tha ding go-a mipi chu akham jou lhonin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Antioch le Iconium'a konin Juda mi phabep hilama chun ahungun, mipi ho chu atilseuvin, Paul chu songin asesah-un, athi ahitai tin, khopi pam lama akaidoh taove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin seijui ho akimvela adin pettah-un, ama athoudoh-in, khopi sungah aluttai. Chuin ajing nikhon Barnabas toh Derbe jondin akipatdoh lhontai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amanin chuche khopi-a chu Kipana Thupha ahillhangle lhona, mi tamtah ahil lhon jouvin, Lystra, Iconium, chule Antioch lama akile kit lhonin,
  </para>
  <para style="p">
    <verse number="22" style="v" />Genthei hesoh tamtah thoh-a Pathen lenggama ilut dingu ahi tin seijui ho chu tahsana aumdet jing dingun thu ahil lhonin, alungu aphut detpeh lhontai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule amanin houbung tina upaho apansah lhona, an angola atao jouvun, atahsanpao Pakai henga chun amahochu apedoh lhontai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pisidia gam achonsoh lhon phatnin, Pamphylia'a ache lhonin,
  </para>
  <para style="p">
    <verse number="25" style="v" />Perga-a thu ahil lhon jouvin, Attalia lama ache lhontai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin chua kon chun kongin akitol lhonin, ahin tohchai lhon chu tong dinga Pathen lungsetna-a akipehdohna lhon Antioch kho-a chun ache lhontan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chukom alhun lhon phatnin, houbung miho akhom lhonin, Pathen'in amani mangcha-a athilbol jouse le chidang namdangho dinga tahsan kot ahonpeh umchanje chu ahetsah lhontan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin amani chu seijui ho toh sottah aumkhom lhontai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Juda gama konin mi phabep ahungsuh-un, Mosi chonna danthu peh dungjuija chep natan louvule huhhing-a naumthei lou dingu ahi, atin sopiho ahung hilun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun Paul le Barnabas chu amahotoh hatah-in akinel baotam jingtaovin ahile, hiche thudola chun Paul le Barnabas chu alah uva mi phabep toh Jerusalem'a solchah ho le upaho henga gacheuhen tin thu alhuhsah taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin houbung mihon amaho chu agathah-un ahile, amahon Phoenicia le Samaria gam ajotpeh-un, chidang namdangho lunghei thu chu aseijun, sopite jouse abonchauvin hapan akipasah taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jerusalem alhunun, houbung le solchah ho, chule upaho chengsen amaho chu anasangui; chuin Pathen'in amani mangcha-a thil abol umchan chu asei lhontan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahivangin atahsana Pharisai loi koi koiham akipat doh-un, hiche miho chu thonmo-a cheptana, chule Mosi danthu peh nitsah ding ahi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin solchah ho le upaho hiche thu ngaito ding chun akikhom taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin tamtah-in akinelun ahile, Peter akipatdoh-in ajah uvah, Miho chule sopiteho, chidang namdang hon keima kama kona kipana thupha ajah uva atahsanna dingun, masangpeh chun Pathen'in eiho lah-a keima eilhengdoh chu nanghon naheuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule milungsung he-a Pathen'in eiho eipeh bangun, amaho jong chu Lhagao Theng apen, amaho chu ahettoh sahtan;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule eihole amaho kah-a dat nei louvin, tahsan vangin alungsungu asuthengin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutichu ahile ipi dinga ipu ipateovin jong, eiho jengin jong nipoh jou louvu namkoljon chu seijui ho lenga naseuva Pathen napatepmu ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin amaho bang chun eihon jong Pakai Jesu Christa lungset vanga huhhing-a umding itahsan ui, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuphat chun mipi chu athipbeh-un, Barnabas le Paul'in Pathen'in amani amanchah-a, chidang namdangho lah-a melchihna le thil kidang dang abol thu asei lhon chu angaijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin athusei athiplhon phatnin Jacob'in adonbutnin, Miho chule sopiteho, kathusei ngaijun;
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathen'in amasa-a chidang namdangho avila, alah uva kona ama min pudin mi alhendoh thu Simon'in aseitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hiche hi themgaoho thuhotoh akitoh-e,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheng nung chule keima kakinungle kitna, David houbuh alhusa chu kasahphat ding, Asekom jouse kasah phat kitna, Chule katundoh ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi amoh chengse, chule chidang namdang kamina kikouho jousen Pakai chu ahol ding ahi, tin, hicheho jouse bolla Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Leiset kisem tilla patna anatohho jouse Pathen hetnin aumme.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun hitin kangaitoi, chidang namdangho lah-a Pathen henga kiheiho chu bol genthei pouhite;
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin milim houna thilboh neh, jonthanhoi, chule alol kimeh-a kithat saneh, chule thisan neh, hichenga kona chu akikangsena dingun sunjo leuhen kati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu masang laija patnin Mosi'n khotinah athu hillhangle aneijin, cholngah niseh-in houin'a asimji naove, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin solchah ho le upahon houbung pumpi chutoh, alah uva mi lhendoh-a Paul le Barnabas toh Antioch-a sol ding pha asauvin, sopite lah-a apipu Barsabas atiu Juda le silas alheng doh-un;
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin hiti hin lekha asunun, amaho khutna chun athot taove: Solchah ho, upaho, chule sopite jousen, Antioch, Syria, chule Cilicia gama um chidang namdang sopiho kasalamui.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kalah uva konin koi koiham ahungun, chep natandiu chule dan ho nanit teidiu ahi, ahungtiuvin; thun nahung sulung jingun, nalungu asuchavaijui ti kanajaove; amaho chu keihon thu kapepouve;
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun lungkhat pu-a kaki khopmu tolhonin, mi lhendoh-a, ideitah-u Barnabas le Paul,
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakai Jesu Christa min jala ahinkho settoh jinga um teni toh naheng uva hinsol ding pha kasaovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun Judas le Silas kahinsol uvin; amanin jong hiche thu mama hi kamcheng tah-a nahil dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh-inem itile Lhagao Thengin pha asan, keihon jong pha kasauve, hicheng akhohlai chengse tailou hi pohgihsa dang pohsah lou ding katiuve;
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangho milim houna sa neh, thisan neh, alol kimeh-a kithat sa neh, chule jonthanhoi, hichenga kon hin kikangseleu chun katiuve; hichenga kon chun kikangseleu chun nangho dinga phading ahi. Anadamselun.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin amaho chu asoldoh phatnun, Antioch'a ahungsuh-un ahi: chuin mipi chu akhopkhom phatnun, lekhathot chu apedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin amahon hichu asim jouvun, lungmonsahna thu jeh chun akipah taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Judas le silas chun, (amani jong themgao ahi lhonin,) amanin jong thu tamtah-in sopiho chu alungmonsah lhonin, aphutdet lhonin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin chua chu chom khatset aum jou lhonin, solchah ho henga ding chun sopihon lung mongin alhadoh taove.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahin silas vang chu chukoma umden ding anomin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Paul le Barnaba jong chu Antioch kho-a chun aumden lhonin, mi tamtah toh, Pakai thu chu ahil lhonin aseiphong lhontai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin ni phabep jouvin Paul'in Barnabas jah-a, Chen, Pakai thu ihilna khopiho chenga chun chehitin sopite gakimutopi hitin, iti um naovam gavehite, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Barnabas'in Mark atiu John jong chu puiding lung angaiton ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahivangin Paul'in Pamphylia'a amani dalha-a, chule amanitoh lhona natonga cheta lou chu puiding pha asapon ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin akihanel ten taovin ahile, khat le khat akikhenlo taovin ahi; chuin Barnabas'in Mark chu akipuijin kongin kitolin Cyprus lama achetai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Paul'in silas akilhen doh-in, Pathen lungsetna-a sopite phatseina to thon akipatdoh tai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Syria gam le Cilicia gam ajotpeh-in, houbung ho aphutdet pehtai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ama Derbe le Lystra alhungin; chuin veuvin, chu koma chun seijui khat amin Timothy kiti khat aumin, amachu atahsana Juda numei khat chapa ahin, apa vang chu Greek ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama chu Lystra le Iconium'a um sopihon aseiphat lhehjengu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Paul'in ama chutoh lhondoh ding lung angaito jehchun, apuijin chuche dunga um Juda ho jeh chun achep atanin ahi; ijeh-inem itile apa Greek ahi chu abonchauva ahetsoh keiju ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amaho akho akhoa avahle avahleuvin, Jerusalem'a um solchah ho le upaho phudoh thupeh chu anit dingun asei phongle taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutichun houbung ho chu tahsana-a akiphut detnun, niseh-in amijat apung chehcheh tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Phrygia le Galatia gam achotsoh phatnun, Lhagao Thengin Asia gama thu agalhangsap dingu akhamin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mysia kom ageijun Bithynia lut akigouvin, ahinla lhagaovin ajahnom pouvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin chutichun Mysia ajotpaijun, Troas kho ajonsuh taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin jan-in Paul'in mu aneijin, Macedonia mi khat adingin ahenga ataovin, Macedonia hung galkaijin lang neihung panpiuvin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutichun aman mu anei phat chun, Pakaiyin amaho chu Kipana Thupha hil dinga eikouvu ahi ti kaheuvin, chupettah chun Macedonia gama che ding kasompai taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Troas'a konin kongin kakitolun, jangkeijin Samothrace kajon-un, chuin ajingin Neapolis kalhungun,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin chua kon chun Philippi kalhungui; hichu Macedonia gamkol sunga khopi lenpen ahin, Rome miten alo-u khopi ahi. Chuche khopi-a chun ni ijat-jen ham kaumui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin cholngah nin kulpi kot polama lui pangah, angaija taona kiman jina mun'a chun kacheuve; chuin kataovun, numei hung kikhomho jah-a chun thu kaseitaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amin Lydia atiu, ponsandup joh numei khat, Thyatira khopi-a kon, mi Pathen hou ahin, amanu chun kathuseiju ajatan; chuin Paul thusei ho chu lunglut tah-a angaina dingin Pakaiyin alung kot ahonpehtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amale a-insung mite baptize achan jouvun, Pakai tahsan tahbeh-a neingaitou ahile, ka-in'ah hung lhungun, tin eijolun, kacham louhelun eilhunsah taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahitin ahi, taona mun'a chu kacheuva ahile lhagao vop soh nungah khatnin eikito piuvin; ama chun khonung thusoh ding aseija, a-pakaite chu aphatchom sah lheh jeng ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama chun Paul le keiho eijuile eijuileuvin, Hiteho hi chungnung pen Pathen sohte ahiuvin, sochatna lampi nahung hilu ahi, atin asam asamjin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amanu chun chutia chu ni tamtah abol ahi. Ahin Paul alung phamon, akiheijin lhagao jah-a chun, Jesu Khrista mina amanu sunga kona chu hungdoh dinga kathupeh nahi, ati. Chuin chupettah chun apotdohpai jengtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin apakaite chun phatchom ding akinepnao abeitai ti ahetdoh doh-un, Paul le Silas chu amanun, kailhang-ah vaipoho hengah akaijun,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin thutan vaihomho henga ahin puijun, Hiteni hi Juda mi ahi lhonin, ikho sungu achohnoh lheh jeng lhonin,
  </para>
  <para style="p">
    <verse number="21" style="v" />Eiho Rome miten isandiu le ijop dinguva dan ngai hilou chonna dan sodoh ago lhone, atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin mipi chu thakhat tah-in amani dounan akipatdoh taove: chuin thutan vaihomho chun apon lhon ahoh lha uvin, chule mola jep dingin thu apetaove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin tamtah vei ajep jouvun songkul'a akhumun, songkul ngahpa chun bitkeija angana dingin thupeh anei taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutitah-a thupeh amu jehchun, aman kihenna sungnunga akhumin, akenguva bul atuhtai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahin jan khangkimin Paul le Silas Pathen henga atao lhonin, la asa lhonin ahile, sohchangho chun angai ngaijun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin phulou helouvin ling hatah-in ahung kihot in, chutichun songkul chu abul ahot longgamin; kotkhah jouse akihong paijin, chule akihennao bul akilhamlha gamtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin songkul ngahpa chu a-imut ahung khangin, songkul kotkhah ho akihon amuphatnin, sohchangho ajama ahitai atin, chemjam alan ama kithat akigotai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahivangin Paul'in, hasapmin asamin, Nangma kisuse hih-in, keiho kabon chaovin hikoma kaum naove, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman meivah athumin, songkul sungah alhailut jel-in, kithing thing pumin, Paul le Silas angah alhu jengin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin amani chu apuidoh-in, Puteni, huhhing-a umna dinga ipi kabol dingham, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin amanin, Pakai Jesu Christa tahsanin, chutile huhhing-a naum ding ahi, nangma le na-insunga chengsetoh, ati lhone.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin amanin amale a-insunga umho chengse jah-a Pakai thu asei lhontai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin aman hiche pettah chun jan laijin amani chu apuijin, ajepnau maha chu asoppeh-in; chule a-insunga chengsetoh hiche pettah chun baptize achangpai taove.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin amani chu a-in'a apuitouvin, a-ang lhonah nehding aluipeh-in; Pathen atahsan jeh chun ama chu a-insunga chengsetoh akipah lheh jengun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin ni aso phatnin thutan vaihomhon sottol mimanho chu asolun; Miho chu lhatauvin, agatisah-ui.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin songkul ngahpa chun hiche thu chu Paul jah-a aseijin, Thutan vaihomhon nangni lhadohna ding thu ahin petaove; hijeh chun lung mongin che lhontan, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahivangin Paul'in amaho jah-a chun, Keini Rome mi kihia, themna themona photoh louva japi ang sunga eivoh uva, songkul'a eikhumu ahin; tu-a guhthima lhadoh ding eigotnu ham? Chuti theiponte; amaho mong hunguhen, amahotah-in eihung lhauhen, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin sottol mimanho chun thutan vaihomho hengah hiche thu chu agalhut taove; hichun amani Rome mi ahi lhon chu ahetdoh phatnun akicha taove.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin amaho ahungun amani chu ahung jolun, khopi-a kona chedoh dingin ajoltauve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hitichun songkul'a konin apotdoh-un, Lydia in'a chun alut taove; chuin sopiho chu amulhon phatnin, amaho chu alungmonsah lhonin, akipatdoh lhontai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Amphipolis le Apollonia ajotpaijun, Juda ho kikhopna in umna Thessalonica alhungun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Paul achon ngai bangin ahenguva achen, cholngah ni thum Pathen lekhabua konin akihoulimpin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Christa chun gim genthei athoh-a athi lah-a kona thoudoh kit ding mong ahi tin aphongdoh-in, avetsah-in chule ahilchenin; chuin, Najah uva kasei Jesu hi hiche Christa chu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin alah uva mi kimkhat le, Pathen ngaisah Greek miho, chule numei pipuiho tamtah-in ajoptaovin, Paul le Silas lama akaitaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahivangin Juda atahsanlou hon thangset lungin kailhanga migilou thasehon koi koiham akipuijun, mipi hon khat akhomun, khopi sung chu achohnoh-un, Jason in abuluvin, amani chu miho henga hinkaidoh dingin aholtauve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin amani chu amulou phatnun, Jason le sopite koi koiham chu khopi sung vaipoho henga akaijun, kho asamun, Vannoi chohseho chu hikoma jong ahung lhungtaove;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hiche Jason hin a-in'a alhunsah-in, chule Jesu atiu leng chom khat aume atiuvin, Ceasar thupeh nelkal lenan achon sohkeijui, atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hicheng thu chu ajah phatnun, mipi chengsele khopi sung vaipoho jong chu aboi lheh jengtaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jason le adang danghoa kon chun amaho khelin jamin alauvin alhadoh taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin sopihon geisang louvin ajan jan-in Paul le Silas chu Beria khopi lama asoltaove. Amani chukom alhun lhonin Juda ho kikhopna-a ache lhonin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho chu Thessalonica miho sang chun aphajovin, lung kipahtah-in thu chu asangun, hichu hinam hilouham ti hetna dingin, niseh-in Pathen lekhabu-ah aholjiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun alah uva tamtah-in atahsan taovin, Greek miho lah-a ja-um numei le pasal tamtah-in jong atahsan taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin Beria-a jong Paul'in Pathen thu ahiltai ti Thessalonica Juda hon ajauvin, chukom gei chun ahungun, mipi chu ahung tilseuvin achohnoh kit taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche pettah chun sopihon geisang louvin Paul twikhanglen lama che dingin asolpai taove; Silas le Timothy vang chu chukoma chun aumden lhone.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Paul gathahho chun Athen geijin apuijun; chuin Silas le Timothy chu agan nathei pena kahenga ahungloi lhon nading thupeh apouvin, akile kit taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Paul'in Athen kho-a amani chu anga sungin, khopi-a chu semthu milim adimset amun, alung asoujahtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun kikhopna in'ah Juda hole Pathen ngaisahho akinelpijin, kailhang mun'a jong amuchan chu aneljin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Epicurean mile Stoic mi lah-a mithem miching koi koihamin jong ama chu akinelpi jiuvin; chule abangin, hiche kamtam belbul hin ipi sei ding agot hinganai, atiuvin; adang kimkhat chun, Jesu thule thokit thu aseile jeh chun, gamdang houho thuhil hile akilome, atiuve;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ama chu apuijun, Areopagus'ah ahin puilutnun, ajah-a, Hiche thuhil thah thu nasei hi, kahet thei dinguham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh-inem itile nangman datmo thil kidang dang kana uvah neijah sah-ui; hiche thil hi ipi tina ahi aumje chu kahet nomui, atiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />(Ajehchu chuche Athen miho chule chua cheng gamdang miho jouse chu akiman chanuva imadang bol louva, thu thah seina ahiloule ngaina-a aphat amanjiu ahi).
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Paul Areopagus lailunga adingin, hiche thuhi aseije, Nangho Athen miho, imalam jouse-ah nangho hi hou ngaisahtah nahiuve ti kahedoh-e.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ijeh-inem itile nahouho chengseu kavetle-a ahile, HETPHAHLOU PATHEN DING tia kisun maicham khat kamui. Hijeh-a chu nanghon het louva nahoujiu chu keiman nangho kaseidohpeh nahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vannoi leiset le asunga thil um jouse sema Pathen chu van le lei Pakai ahin, khutna kisa houin'ah achengpoi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule ngaichat neija banga, mihem khutna jenle ding jong ahipoi; ajehchu amatah imajouse hinna, haina, chule ijakai pe-a joh ahibouve;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule leiset chung jouse losoh-a cheng dingin, thisan khatna konin vannoi mi chitin namtin asemin, amaho chu phat ateppeh-in, achennao jong gamgi asepeh-e,
  </para>
  <para style="p">
    <verse number="27" style="v" />Amahon Pakai chu aholuva, amai amaijuva ijem tia amudoh theina dinguva chutia chu abol ahin; ama chu eiho koimacha-a kona gamlat umlou ahi:
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh-inem itile eiho ama-a hinga, chatloh-a, chule uma ihiuve; nangho lah-a thuchih chom sun themho lah-a koi koiham jengin jong, Eiho jong ama son ihiuve, tin aseijuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hijeh chun eiho Pathen son ihi jeh-u chun, Pathen chu mihem lung suhto-a sana, dangka, song kikheng milim tobanga ingaito ding dolu ahipoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ihet lou laiju chu Pathen'in einavet thimu ahin; tu vangin gam jouse-a mi jousen alung aheina dinga thu apeh ahitai:
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman nikho khat atep ahin, hiche ni chule ami tun chun chonphatna-a vannoi hi athu atan ding ahi; Ama chu athia kona akaithouva kona mi jouse ahet kichensah ahitai, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Athi thokit thudol ajah phatnun, abangin anuisat taovin, chule adangho vang chun, hiche thudol hi nanga konin ngai kitnaovinge, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hitichun Paul amaho lah-a kon chun apotdohtai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahinla mi kimkhat ama henga akaijun atahsan taove. Amaho lah-a chun Areopagus mi Dionysius le numei khat amin Damaris atiutoh, chule adang dangho jong ahiuve.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuche nung chun Paul Athen'a konin apotdoh-in, Corinth-a achetai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche lai chun Aquila kiti Pontus gama peng Juda mi khat, a-inneipi Priscilla to Italy gama kona hunglut til chu amun, (ajehchu Claudius'in Juda ho jouse aboncha Rome'a kona potdoh dinga thu apeh ahi): chuin amani henga chun achen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amani chutoh akhut them natoh-u thakhat ahi jeh chun, amani koma chun alhungin, na atong khomjiuve; anatoh-u chu pon in sem ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule cholngah nisehle kikhop na-ah thu asuhtopin, Juda ho le Greek miho chu atahsan dingin ajoljin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Silas le Timothy Macedonia gama kona ahung lhunsuh lhon phat chun, Paul chu lhagaovin apanpin, Jesu chu Christa ahi ti Juda ho henga chun ahettohsah tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin amahon adoudaluva, ataitom phatnun, Paul'in apon athingin ajah uva, Nangho thisan nangho lu chungah chuhen; kei kangime; tu kalin chidang namdangho henga chetange, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin chua kon chun achen, Pathen ngaisahtah amin Titius Justus atiu in'a chun alut tai; ama in chu kikhopna in kom cha ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin kikhopna in vaipo pipu Crispus chun a-insung mi jousetoh Pakai atahsantai; chuin Corinth miho lah-a mi atama tamin ajauvin, atahsanun, baptize achang taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin jan-in Pakaiyin Paul gaovin akimusah-in, Kicha hih-in; thu sei jing jengin; umthim hih-in;
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu keiman nangma kaumpi jingnai, chule suhset dinga koiman nabulu lou ding ahi; ijeh-inem itile hiche khopi sunga hin mi tamtah kaneije, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ama hikoma chun kum khatle lhagup aumin, amaho lah-a chun Pathen thu ahilin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin Gallio Achaia gam vaipo ahi laijin, Juda ho lungkhat akisauvin Paul dounan akipat doh-un, thutanna munah akaijun,
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichepa hin chonna dan ngailouva Pathen hou dingin miho ajol lhai, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Paul pao ding akigotle Gallio chun Juda ho jah-a, Vo Juda ho, hiche hi suhkhel ahiloule khan gitlou thu hile, keiman namihehnau kangaipeh ding nahiuvin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin thu mai mai, min mai mai ahiloule, nangho chonna dan thu kibaona mai mai ahivangle nanghon kitan un, ajehchu keiman chutobang thu chu katan nompoi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amaho chu thutanna mun'a kon chun anodohtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun Greek ho chun kikhopna in vaipo pipui Sosthenes chu amanun, thutanna maitah-a avotaove. Ahivangin hitiho chu Gallio chun donin aneipoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Paul chukoma chun sottah aum jouvin, sopitetoh akilhan, Priscilla le Aquila toh kilhonin Syria gam lama kongin akitoltai. Paul'in kitepna anei jeh-in Cenchria'a asam avouvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Ephesia khopi alhunun, amani chu chukoma chun adalhatai: ahivangin ama chang kikhopna in'a alutnin Juda ho chu thu asuhtopin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin chukoma chu um sot jep dingin alhovin ahile ama anom hih-in,
  </para>
  <para style="p">
    <verse number="21" style="v" />Amaho chu alhan, Iti jongle kut ahunglhung dingpa hi Jerusalem'a kaman tei ding ahi; Pathen lunggot lam ahile naheng uva hung kitnange atin, Ephesia kho adalhan, kongin akitoltai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Ceasarea-a akumin, achetouvin houbung chu salam agapen, Antioch-a ahung kilesuh kit tai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chukoma chun chom khat aumin, chua kon chun Galatia le Phrygia gam ajotpeh-in, seijui ho jouse aphutdetle tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche lai chun amin Apollos atiu Juda mi, Alexandria-a peng ahin, thuseija themtah le Pathen lekhabua thua hattah, Ephesia'a ahungin;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama chu Pakai lampi thu kihila ahin, alungin agunchu lheh jengin, Pakai umchan thudol kichehtah-in aseijin, ahivangin aman John baptize chan thu bouchu ahen ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin kikhopna in'ah hakattah-in thu asei pantan ahi; chuin Priscilla le Aquila'n athuhil chu aja lhonin, a-in'a apui lhonin, Pathen lampi thu chu dihtah-in ahilchen lhontai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ama chu Achaia gama ache nomtan ahile sopihon atilkhouvun, chuin ama chu anasanna dingun seijui ho hengah lekha asuntaove. Chukom alhunin lungsetna vanga atahsanho chu nasatah-in akitopin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijeh-inem itile Jesu chu Christa ahi, ti chu aman Pathen lekhabua konin aphot tohna avetsah-in, hakattah-in japi ang sungah Juda ho anel khup jengtan ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Apollos Corinth khopi-a aum pet chun Paul'in sahgam lam achonlen, Ephesia ahung lhungin ahile seijui phabep amun ajah uva,
  </para>
  <para style="p">
    <verse number="2" style="v" />Natahsan uva chu Lhagao Theng nachannah-uvem? tin adongin ahi. Hichun amahon ajah-a, Lhagao Theng aume ti jong kajapouve, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman, Ahile ipiaba baptize changa nahiuvem, atile, amahon, John baptize chanin, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Paul'in John chun miho jah-a chu, kanunga hunga Christa Jesu chu tahsanun atia lung heina dinga baptize achansah ahibouve, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin thu hiche chu ajah phatnun, Pakai Jesu minah baptize achang taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Paul'in achunguvah akhut angamin ahile Lhagao Theng achunguva achutai; chutichun paotin pao tangin thu aseijun, lhagao thu jong aseidoh taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho chu abonchauvin mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutah chun Paul kikhopna in'ah alutnin, hangsan tah-in lha thum sungin thu ahilin, amaho chu Pathen gam thudol asuhtopin ajol lutnin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin mi kimkhat alouchala, tahsan louva, mipi angsunga chuche lam chu aseiset joh phatnun, amaho chu adalhan, seijui ho atum huijin, tyrannus school-ah niseh-in akihoulim pitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun kum ni aumin ahile Asia gama chengho Juda hole Greek hon jong Pakai Jesu thu chu aja sohkei taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen'in Paul khutnin thil kidang mainah abolsahpoi:
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun ati chunga konin ultheh hijongle pon hijongle alauvin adamlou henga achoi jiuvin ahile, ahiveijun adalha jengun, lhagao bohho jong chu apotdoh jengji taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Juda vahvei doithema kivei koi koihamin lhagao boh vopteho chunga Jesu min apanun, Paul'in athu ahil Jesu mina thu kapeh nahi, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Juda thempu pipui Sceva chate pasal sagi ho jongchun chutobang chun aboluve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin lhagao boh chun adonbutnin, Keiman Jesu kahenai chule Paul jong kahenai, nangho koi nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin lhagao boh voppa chu achomin, amaho chunga achun, ajouvin, achunguva athanei jotan ahile, amaho chu chuche in'a kon chun asagoh keole mahapun ajamdoh taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin hichu Ephesia cheng mi jouse Juda min jong, Greek min jong ahesohkei taove; chule abonchauva chungah kichat achutan, Pakai Jesu min choisangin aumtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Atahsanho jong tamtah ahungun, athilbolu aseidoh-un aphongdoh taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule doichoiho tamtah-in jong alekhabu chengseu ahinchoi khomun, mi jouse mitmun agouvam taove. Chuche agolhah hou chu asuhtoule dangka sangsomnga man ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutichun Pathen thu chu thahat tah-in akhangtouvin, athanei jotai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin chucheng thu kichai jou chun, Macedonia le Achaia gam chu chotsoh-a Jerusalem'a che ding lung angaiton, Chua kache jou chule Rome jong kagaphah teiding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun alhachateni Timothy le Erastus chu Macedonia gama asolin, ama Asia gamah chomkhat aumdene.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche lai vel chun chuche lampi thudola chun thunoh mainah asohpoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajeh chu amin Demetrius atiu dangka kheng mi khat aumin, ama chun dangka'in Diana lim akhengin, khutthemho ding chun kiveina phabepcha aumdoh sahpoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin hiche mipa chun amaho chu amaho tobang natongho chengsetoh akou khomin, ajah uva: Miho, hiche ikiveiju hi ihao dohnao ahi, nanghon naheuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Ephesia goh hilouva, Asia gam pumpi-a hiche mihempa Paul hin, miho khutna kisemho chu Pathen ahihih hele tia ajola, miho tamtah aheimang gamhi mu jong namuvin, he jong naheuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichea hin ikhut themu manlou ahung so ding kichat um jenggoh ahipoi; pathen lennu Diana houin jong hi nahsahmo-a hung kibola, chule Asia gam pumpile vannoi'in ahou amanu jeng jong hi, alet aloupina-a kona hung kiloilha khong ding ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin chuche thu ajahtah-un, alunghang behseh jengun, Ephesia mite Diana alene! tin asam asam jengun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutichun akho thingin akilohsoh jengun, Macedonia gam mi Gaius le Aristarchus, Paul'in akholjin na-a alhonpi teni chu amanun, thakhat tah-in tot bolna in'ah alhailutpi jengui.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Paul miho lah-a chu lut ding akigon ahile seijui hon achesah pouve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Asia gamma hou lamkai Paul kiloipi khenkhatnin mi ahinsolun, tot bolna ina chu gakilulah louhel dingin akham chah kheh jengun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin akikhomho chu aboilahlah jengun, mi atamjon akikhopmu chu ajeh ahepouve; hijeh chun kimkhatnin thu khat asamun, kimkhatnin thu chom asamun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin mipi lah-a kon chun Alexander ahinkai doh-un ahile Juda hon malama asonui. Chuin Alexander'in mipi lama chun akhut ajah-in, akihona thu sei akigon ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahivangin ama chu Juda mi ahi aheuvin, Ephesia te Diana alene! atiuvin; hichu nidan ni geijenin asam asam jengun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin khosung thusunpa chun mipi chu aphoh thipmin, Vo Ephesia mite, Ephesia mite khopi hi Jupiter-a kona hunglha pathen nu Diana le alim hou ahihi ahelou koi ummam?
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuti chu ahin hichenghi seilep thei ahilou jeh hin, thipbeh-a naum uva, chule thu doptoh louva ima nabol dingu ahipoi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ijeh-inem itile nanghon nahinkaiju miho hi houin chomma jong ahipouvin, eiho pathen nu seise-a taitoma jong ahipouve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hijeh chun Demetrius le atohpi khut themhon mi koiham chunga thu aneijule, kihehna in honsan aume, chule gamvaipoho jong aumnaove; hikoma khun gakiheh taohen.
  </para>
  <para style="p">
    <verse number="39" style="v" />Thu dang ima naholu ahivangle, angaija kikhopna-a seitoh ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tunia thunoh so thua hi ichunguva thu ahung umding kichat aume; hiche ikikhop lona penu chu hiche hi ahi tia idonbut thei nadiu aumlou jeh-in, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin hichu aseijin, mipi ho chu alhadohtai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin thunoh chu akichai jouvin Paul'in seijui ho chu agakou sah-in, amaho chu akoijin, Macedonia gama chedin akipat doh tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin chuche gamkai sungse chu achonsoh-in, amaho chu thu tamtah-in atilkhouvin, Greek gam alhungtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin chukoma chu lha thum acham jouvin, Syria gam lama kong'a kitola che ding agotle Juda hon achanlhih jeh-un, Macedonia jotpai ago kittan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Asia gam geijin Beria kho-a Sopater, Thessalonica'a Aristarchus le Secundus, Derbe kho-a Gaius le Timothy, Asia gama Tychicus le Trophimus, hicheng chun alhonpiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiteho chu keiho masang-ah anacheuvin, Troas kho'ah eina ngah jingui.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiho vang chu cholsolou changlhah kut jouvin Philippi'a konin kongin kakitolun, ni nga nin Troas kho'ah ahengu kalhungui. Chua chun ni sagi kanichongui.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin hapta kipat nikho masa ni changlhah hehbal dinga solchah ho ahung kikhop phatnun, Paul ajinga cheding akigot jehchun amaho chu akihoulimpin, khangkim geijin sottah thu aseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akikhopnao indan chungnunga chu meivah tamtah uma ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin bangkotna tou gollhang khat amin Eutychus kitipa chu ana-imu lhutai; Paul'in athusei aseisot jeh chun ana-imulhun, chung dan thum na-a konin noi lamah alhatan ahile athisan agaphongdoh-ui.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin Paul akumlhan achungah aboh-in, apomin, Lungdong hih-un, anuhkai nalainai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Paul akaltou kitnin, changlhah ahehbalin, anen, sottah ahoulimin, khovah geijin ajah uva thu aseijin, chutichun akipat dohtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon gollhangpa chu ahingin ahinpuijun, lungmon mainah-in alungmong tapouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin keiho kong lama chun kanache masaovin, Paul lalutpa dingin Assos jonin kongin kakitol taove; aman akenga che agot jeh-a aman chutia chu agontohsa ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Assos kho-a eikisuhtopi phatnun, kong'a kalalutnun, Mitylene kahunglhung taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin chua kon chun kakitolun, akit nin Chios jon kalhungun, anikit nin Samos kalhungun, Tragyllium'a kakichol paovin, akit nin Miletus kalhungtaove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajeh chu Paul'in Asia gama umsot ding anop lou jeh-a, kong'a kitola Ephesia khopi chu jotpai ding lunga agot jingsa mong ahin, ahitheile Jerusalem'a Pentecost mang dinga, kin loija che kigo-a ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Miletus-a kon chun Ephesia'a mi asolin, houbung upaho agakousah-e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aheng ahung lhun phatnun ajah uva: Keima Asia gama kahungtila pat, nangho koma kaum lai sungse-a kaumchan chu naheuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lungnem tah le mitlhi pumin, chule Juda hon eichanlhih jinguva kona kachunga chua thohhesoh pumin, Pakai lhacha na katongin;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule phatchomna ding thil imacha nangho dinga ka-im beihelin kavetsah sohkeijun, jalhang le a-in tinah kahiljiuvin,
  </para>
  <para style="p">
    <verse number="21" style="v" />Juda ho hengle Greek miho henga jong, Pathen lama lunghei thule, I-Pakaiyu Jesu Christa lam tahsan dingdol kahetsahjin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule tun, veuvin, lhagaova kisoma Jerusalem'a che ding kahi, chua chu kachunga ipi alhun ding kahepoi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Kikan le hesoh gentheijin eingah jinge ti Lhagao Thengin khotina eihetsah jingbou hi kahei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahivangin Pakai Jesu'a kona kanamu lhacha natoh, Pathen lungset kipana thupha hettohsah ding, chule ka tohding hi kipah tah-a kachai molso thei ding poule hiche hohin eisulinglao pouvin, chule kahinkho jonghi ka-itchapoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Pathen lenggam thu kaseilea kavale kavalena nangho hin, kamai namu kit lou dingu ahi, ti hi kahei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche jeh-a chu mi jouse thisana kona ngima kahi, ti tunia kahetsah nahiuve;
  </para>
  <para style="p">
    <verse number="27" style="v" />Ijeh-inem itile Pathen thil ngaito jouse najah uva im kanei aumpoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun Pathen'in athisana achohsa houbung vesui dingle ching dinga Lhagao Thengin napan sah-u, kelngoi hon chengse chungle nangmaho chung changah chingtheijun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kache nungle ngei gilou nalah uva alutna, ahon hi ahoi lou ding kahei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule nangho lah-a kona jong abang bang hung kipatdoh-a, amaho nung jui dinga seijui ho chu thu akaleh-a hila hung umding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh chun nangho kigingpha jingun; chule keiman kum thum sunga mitlhi puma asun ajan nangho nabon chaova tilkhou kahai louhel chu geldoh jingun,
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule tun, sopiteho, nangho sadoh-a khantousah theija, chule mi akisuthengho lah-a nangho gou chansah theija, Pathen le alungsetna thu henga kakhumu nahiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Koimacha dangka, sana, nihchen ponsil kadei chapoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahi, kakhutteni hin keimale kaloiho ngaichat chan kaboldoh ji-e ti nanghon naheuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Keiman ijakaija navettoh uva natho dingu kavetsah sohkeije; nanghon chutobanga chu natohgim uva ahatmoho phatna nabol dingu thu ahi. Lah sangin peh ochat aumjoi, tia Pakai tah-in asei jong chu geldoh jingun, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Thu hicheng chu aseijin adilsun, abonchauvin atao khomun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin abonchauvin hakan akapmun, Paul angong koijun, achopmun,
  </para>
  <para style="p">
    <verse number="38" style="v" />Kamai namu kit lou dingu ahi, atijeh tahchun alungse deh-un; kong mun geijin agathah taove.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, keiho amahotoh kakikhen jouvun kongin kakitolun, jangkeijin Coos twikol kalhungun, akit nin Rhodes twikol kalhungun, chua konin kache paijun Patara kho kalhungui.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Phoenicia gama jonding kong khat kamuvin, achunga katouvun, kakitol taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Cyprus twikol akimu phatnin, veilam ngan kapelun, Syria gama kache paijun, kong'a thil solhah ding aum jeh-in Tyre kho-a kaki ngaove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chukom mun'a um seijui ho kaholdoh-un, chukomah ni sagi kanichongui. Lhagaovin ahetsah dungjuijun, amahon Paul chu Jerusalem'a che hihhen, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ni hijat chu kaum jouvun, kakipatdoh-un kachena dingu kamasot taove; chuin amaho abonchauvin ajiteu le achateu pumin khopi kulpam geijin eihung thah-ui; chuin twikhanglen kama kadilsuvin kataovun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin khat le khat kakilhah jouvun keiho kong'a kakal taovin, amaho vang a-in lamuva akilekit taove,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin keiho Tyre'a kona twija kakholjinu kachai phatnun, Ptolemais kalhungun, twija kacheu kachaijui; chuin sopiho salam kaboh-un, amaho komah ni khat kaumui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajingin keiho Paul to kiloise chua kon chun kakipatdoh-un, Ceasaria kahung lhungun; sagiho lah-a kipana thupha seile-a khat, Philip in'a kalhungun, amato kaum taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama chun chanu li aneijin, nungah theng ahiuvin, Pathen thu seiphonga pang ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chukoma chu ni ijat-ham kaum petnun, Juda gama konin amin Agabus atiu themgao khat ahungin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama chu kahenguva ahung lhun phatnin, Paul konggah chu alan akhut akeng akikanin, Lhagao Thengin hiti hin aseije, Hiche konggah neipa hi Jerusalem'a Juda hon hitia hi akanuva, chidang namdangho khutna apehdoh dingu ahi, ahung ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin hiche thu chu kajah phat uvin, chukoma umhole keihon Paul Jerusalem'a che lou dingin kajol taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman eidon butnun, nanghon ibola neika ka-uva kalung nasuhset nuham? Ijeh-inem itile Jerusalem'a kikan ding keogoh hilouva, Pakai Jesu min jala thi dinga jong kigosa dema um kahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman keiho thu alah lou jeh-in Pakai lunggot got hihen katiuvin, kathip taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin kathilkeovu kakigot un, Jerusalem'a kachetou taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Ceasaria'a konin seijui koi koihamin eijuijun; amaho chun amin Mnason atiu Cyprus twikol'a seijui lui, lhunna-a kanei dingpao chu ahinpuijui.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jerusalem kagalhunun, sopihon kipahtah-in einasangui.
  </para>
  <para style="p">
    <verse number="18" style="v" />Akit nin Paul keihotoh Jacob henga kalutnui; chua chun houbung upaho jouse jong abonchauvin aumui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Paul'in amaho chu salam aboh jouvin, alhacha natoh-a kona Pathen'in chidang namdangho lah-a thil abolsah jouse chu abanchan aseitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amahon thu hicheng chu ajah phatnun Pakai avahchoi jun; chuin ajah-a, Sopi, Juda ho lah-a atahsan sang tamtah ahihi namui; chule amaho khu danthu lama gunchutah ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin amahon nangma thudol, nangma hin chidang namdangho lah-a Juda ho chu Mosi dan thu pailhah ding thu nahilin, chapang chep atan lou dingu, chule chonna dan ngaija chon lou ding tin, nahil lei ti ajaove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh-a chu iti ding hitam? Nangma hung ajah-ule mipi hung kikhom teidiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun thu khat seipeh-unge, hichu bolin; kitepna neija mi li hikoma hin kaneijui;
  </para>
  <para style="p">
    <verse number="24" style="v" />Amaho chu puijin lang nangma toh kisuthengun, chule asam vona dingu nangman sum toh-in; chutile nangma thudola athu jah-u chu ima hilou ahi, nangmatah chonna dan ngaija nachon chu amahon ahetsoh dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chidang namdang atahsanho thudol vang, chutobang thil chu nitlouva, milim houna thil neh, thineh, akimeh lihtho sa neh chule jonthanhoi ja kona akikangse nadiuva kasut nuva kathotsao ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chutah-in Paul'in miho chu apuijin, akit nin amaho chutoh akisuthengun, amaho khat cheh-a dinga thilto akito kahse-a akisuh thengna dingu nikho kichaina ding chu thempu gahetsah dingin houin'a alutnin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ni sagi alhin ding konchan Asia gama Juda ho chun houin sunga Paul amu phatnun, mipi chu abonchan atilseuvin ama chu amanun,
  </para>
  <para style="p">
    <verse number="28" style="v" />Israel miho, neihuvin; hichepa hi ahi gamtina mi jouse henga, Juda mite le danthu, chule hiche mun seisele-a chu: chule chuche jeng hilouvin, houin'a Greek mi alutpin, hiche intheng hi asuboh-e, tin asamtauve.
  </para>
  <para style="p">
    <verse number="29" style="v" />(Hichu masanga khopi sunga Ephesia mi Trophimus toh amuva ahile, Paul'in ama chu houin'a alutpia angaitou ahi).
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin akhothingin akiloh jengun, miho chu alhai khomun; Paul chu amanun, houin'a konin akaidoh-un; kotkhah ho chu akhahpai jengui.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin ama chu tha dinga agot laijun, Jerusalem khopi-a mi jouse aboije ti thu sepai vaipipo heng alhungtai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin ama chun sepaiho le sepai ja lamkaiho apuijin, ahenguva alhaisuh taove. Chuin amahon sepai vaipipo le sepaiho chu amu phatnun, Paul avoh-u chu atangui.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin sepai vaipipo chun ahin naijin, Paul chu atuh-in, thihkhao ni-a kan dingin thu apen; amahi koi hija chule ipi asuhset ham, tin adongtai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin mipi lah-a chun akimkhatnin thuchom asamin, adang kimkhatnin thuchom asamun ahi. Chuin husan jeh-a thutah chu ahetdoh theilou phatnin, kulpi sunga pui lut ding thu apetai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Paul leikalbi ageijin, mipi asousang behseh jeh chun sepaihon ama chu adoptho taove.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ajeh chu mihonpi chun, sumangin, sumangin, tia asapmuva ajui lellul jengu ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Paul kulpi sunga apui lut ding konun aman sepai vaipipo jah-a chun, najah-a thu kaseithei dingham? ati. Chuin vaipo chun, Greek pao nahet em?
  </para>
  <para style="p">
    <verse number="38" style="v" />Masang laija miho tilsea, mithat mi sangli gamthipma puidoh-a, Egypt gam mi chu nahilouham? ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahinla Paul'in, Keima Cilicia gama Tarsus khopi-a Juda mi kahi, khopi maimaija mi kahipoi: chule nahenga katao ahi, miho jah-a thu kaseina dingin phalna neipen, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin aman athusei ding aphalpeh phat-in, Paul leikalbi chunga chun adingin miho chu akhutnin ajapmin ahi. Chuin athipchet phatnun, ajah uva chun Hebrew paovin thu aseijin:
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Miho, Sopitele Pateho, tu-a kakihona thu kasei ding hi ngaijun, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />(Chuin aman ajah uva Hebrew paova thu asei ajah phatnun, ahathip chehtauvin ahi).
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima Juda mi, Cilicia gama Tarsus khopi-a penga, hiche khopi sunga hi Gamaliel khophang bula seilena, iputeu ipateu chonna dan kikheltah dungjuija kihildoh-a, tunia nangho banga hi Pathen lama gunchutah kahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hiche Lampi mihohi thina geijin kabolsen, anumei apasal'in kakanin songkul'a kakhum jin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujongle thempu chungnungle gamsung upaho jousen jong hiche thu chu eihetpiuvin; amaho-a kon chun sopiho henga dingin lekha kalan, Damascus-a um jouse talent peh dinga hinkana Jerusalem'a hintol dingin kachen ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, kachele Damascus khokom kageijin sun kim dontah-in, phulou helouvin van'a kon vah nasatah khatnin kavel ahinsalvah soh jenge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun keima tolah kalhutai, chuin kajah-a, Saul, Saul, nangin ibola keima eibolsea nahim? tia seija aw khat kajai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin keiman kadonbut nin, Pakai, Nang koi nahim? kati. Chuin aman kajah-a, Keima nabolset jing Nazareth Jesu kahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin kalhonpi ho chun vah chu amuvin, chule akichauvin, kajah-a thusei aw vangchu ajapouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin keiman, Pakai, ipi kabol dingham? kati. Chuin Pakai chun kajah-a, thoudoh-in Damascus kho-a lutnin; chukoma chu nabol dinga kigo jouse aboncha kiseipeh ding nahi, eiti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin vah loupi jeh-a chu kho kamu lou phatnin, kalhonpihon khutnin eikaijun, Damascus kaluttai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin mi khat Anania, danthu dungjuija Pathen ngaisah, chule chukoma cheng Juda ho jouse seiphat chu kahenga ahungin, kakoma adingin kajah-a,
  </para>
  <para style="p">
    <verse number="13" style="v" />Sopi Saul, kho mutan, eiti. Chuin hiche pettah chun ama chu kamutan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman, Ipu ipateu Pathen'in ama lunggot lam he dingle, Michondih tah chu mu-a, Akam sunga kon sohdoh a-aw ja dinga napansah ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ijeh-inem itile nangman namule najah thua chu mi jouse hettohsah-a napan ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule ipi dinga khongai nalai nahim? Kipatdoh inlang baptize changin, Pakai minin taovin, nachonset kisop lhah-in, eiti.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, Jerusalem'a kakile kit phatnin, houin sunga kataole kagaochang tai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin, kino-in, chule Jerusalem'a konin potdoh loijin: ijeh-inem itile amahon keima thudola nangma thuhil alah lou dingu ahi, tia kajah-a thuseija chu kamun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin keiman, Pakai amahotah-in nangma tahsan ho songkul'a kakhuma kikhopna intina kavohji chu aheuve,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nathu hettohsah Stephen thisan aso pettah uva jong akoma kadina, thadia kaphatsah-a athat teho ponho kanachin ahi, kati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman kajah-a, Kipatdoh-in, Keiman nangma gamlatah-a chidang namdangho henga kasoljoh ding nahi, eititai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin chuche thu gei chun angaijun, chuin aw sangtah-in, Hitobang mi hi vannoi leisetna konin sumangin, ahinga umhoi ahipoi, atitaove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin kho asamun, apon alehlhauvin, van lama leivui atheuvin ahile,
  </para>
  <para style="p">
    <verse number="24" style="v" />Sepai vaipipo chun ama chu kulpi sunga pui lut ding thu apen, achunga chutobang tah-a akhosapmu chu ajeh hetdohna dingin, jepma patep dingin asoltai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin savun khaova akantah phatnun, Paul'in akoma ding sepai jalamkai jah-a chun, Themmo sahna bei Rome mi jepding chu nangma dinga dan ngai hinam? ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sepai jalamkai chun thu hichu ajah phatnin, sepai vaipipo henga chun agachen, Nathil bolgot nahin chigtheijin; ajehchu mipa khu Rome mi ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin sepai vaipipo chu ahungin ajah-a, Rome mi nahim? neisei peh-in, ati. Hivhun aman, Kahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin sepai vaipipo chun, Keiman sum tamtah kapeh-a chamlhatna hi kachan ahibouve, ati. Chuin Paul'in, keivang ahisa penga kahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutah-in athem amo hetdohna-a bolgim dinga kigosadem hochu hiche pettah chun akoma konin achemang taove; chule sepai vaipipo chun Rome mi ahi ahedoh-in, amatah-in akansah jeh chun akichatai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Akit nin Juda hon Paul ahehnau thu chu hetchenna dingin sepai vaipipo chun ama chu alhamin, thempu pipuiho leh houvaipoloi aboncha kikhom dingin thu apen, Paul ahinpuilhan a-anguvah adinsahtai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Paul'in houvaipoloi chu ave changmelin, Sopiteho, tuni geija hi imalam jouse-a ase apha hekah sohkeija Pathen anga lung thengsela um kahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anania thempu chungnungin akoma dingpa chu akam bengin asole.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutah-in Paul'in ajah-a, Vo bang kiloibang, Pathen'in nang nadenjoh ding ahi; nangma dan ngaitah-a kathu tan dinga touva chuche dan chu napal lhah-a kei deng dinga mi nasol ham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin akoma dinghon, Nangman Pathen thempu chungnung chutia chu nahouset ong, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Paul'in, sopite, thempu chungnung ahilam kahet lou ahi, ijeh-inem itile, nangin namite chunga vaipo chunga thuse sei hih-in, tin akisune, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin Paul'in amaho chu keh khat Saddukai ahia, keh khat Pharasai ahi ahet phatnin, houvaipoloi lah-a chun asamin, sopite, keima Pharasai chapa, Pharasai kahi; athiho thodoh kit kinep thua kathu kitana ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin thu hiche chu asei phat chun Pharasai hole Saddukai ho akinelun, mipi chu akilangkhen taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajeh chu Saddukai hochun thokit, vantil, chule lhagao hicheng chu aumpoi, atiu ahin, Pharasai hovang chun hicheng chu aume tia a-oiju ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun apoh vengvung jengun; chuin Pharasai mi danthu sunho phabep adingdoh-un, anelun, Keihon hichepa agitlouna imacha kamupouve; lhagaovin ahim, vantil ahimin, ajah-a thu asei hikhat hihdem, Pathen to kidoupou hite, atiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin hachang nela akinel phatnun, amaho chun Paul chu sattel unte tin sepai vaipipo chu akichan, kumlha suh-a alah uva kona lahpeh-a kulpi sunga pui lut dingin sepaiho chu asoltai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin hiche jan chun Pakai akoma adingin, kicha hih-in Paul; ijeh-inem itile Jerusalem'a keima thudol nahettohsah banga hi Rome khopi-a jong nahettohsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin khovah phatnin Juda ho akihou somun Paul itha masangseuvin anneh twidon bolpouhite, tin kihahsel in akihanlho taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutia miphil dinga ki hou soma chu mi somli val hiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho chu thempu pipuiho le upaho henga acheuvin, Keiho kihahsel khohtah-a kaki hahsel uva, Paul katha masangseuva imacha tep louhel dinga kihan lho-a kahitaove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche jeh chun tun nangho houvaipoloi toh athudol chu kichen cheh-a hettoh-a bolphat ding ngaitobeh kisao vinlang, jingle naheng uva ahinpuina dingin sepai vaipipo henga seijun; aman nangho kom ahinphah kah-a that dinga kigosa dema um kahiuve, agatiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin achanlhih-u thu chu Paul sopinu chapan ajan, ahungin kulpi sunga chun alutnin Paul jah-a ahung seitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Paul'in sepai ja lamkaiho khat ahenga akouvin, hiche gollhang hi sepai vaipipo henga puijin; ajehchu seinom khat aneije, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman apuijin sepai vaipipo henga achen, Hiche gollhang hin najah-a seinom aneije tin, sohchang Paul'in eikouvin nangma henga hin puijin eiti, tin agaseije.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutichun aman akhutnin atuh-in achoma apuidoh-in guhthimin adongin, Kajah-a sei ding ipi thu naneijem, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman, Paul thudol hi kichen cheh-a dongtoh ding ngaito banga, jingle houvaipoloi kikhopna-a napuina dinga nahenga thum dingin Juda ho akilol taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin nangman amaho thu la hih-in; ijeh-inem itile mi somli valin, Paul itha masang seuvin anneh twidon bolpouhite, tin akihahselun, achanglhi jingui, chule tu-a hi kigosa dema uma, nangma thupeh mai ngah jinga um ahiuve, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun sepai vaipipo chun gollhangpa chu ahilchah-in, Kajah-a naphondoh thu hicheng hi koima jah-a sei hih-in, atin alhadohtai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman sepai jalamkai ni ahenga akouvin, hiche thuhi apei: Jan nidan ko-a Ceasaria che ding akenga che sepai jani, sakol sepai somsagi chule tengchoi sepai jani gotsan koijun;
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Paul Felix gamvaipo heng bitkeija pui lhungna dingin, ama tousahna ding sa jong gotsademin koijun, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin hitihin lekha asune;
  </para>
  <para style="p">
    <verse number="26" style="v" />Claudius Lysias'in Lal chungnung pen Felix gamvaipo henga: Salam.
  </para>
  <para style="p">
    <verse number="27" style="v" />Juda hon hiche mipa hi amanun, atha ding konun keima sepaihotoh kakonin, ama hi Rome mi ahi ti kahen kahuhdoh tai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ipi jeh-a aheh-u ahi ahehnao hetdohna dingin houvaipoloi kikhopna-a kapuije.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hia chun thina theihoi le kikanna theihoi thudolin ahehpouve, amaho chonna dan thua asuhkhel amatdoh-u ahitoh-e.
  </para>
  <para style="p">
    <verse number="30" style="v" />Juda hon ama hi thadinga agot uva achanlhih-u kahetdoh phatna, khongai louhela apettah-a nangma henga kahinsol pai jeng ahi, chule ahehho jong nangma ang sunga ahehnau thu sei dingin thu kapei. Damtan.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin sepaihon thupeh dungjui chun ajan jan-in Paul chu apuijun, Antipatris lama achepi taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahin ajingin sakol sepaiho chu amatoh alhonsah-un, amaho kulpi lama akiletaove.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin amaho Ceasaria alhunun, lekha chu gamvaipo chu apeuvin, Paul jong chu adinsah taove.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin aman lekha chu asimin, hoi gampoh mi nahim, tin adongin, chuin Cilicia gam mi ahi ahetdoh phatnin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Naheh ho jong ahung tengule nathu ngainange, ati. Chuin Herod inpia koi dingin thu apetan ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ni nga jouvin thempu chungnung Anania chu upaho phabep toh, chule Tertullus atiu thukalthem khattoh acheuvin, Paul ahehnau thu chu gamvaipo jah-a chun aseijui.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Paul agakouvun ahile Tertullus'in ahehnan achunga thu aseipanin, Nangma vanga lungmon chungnunga kalung monuva, chule nangma vaihom them vanga hiche nam mite hi imalam jouse-a phatdoh sah-a aumu kamu jeh-in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Vo lal chungnung pen Felix, a-imatih chanin hoikom hoikoma jong lung kipahtah-in kasangui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin nangma dinga theida um hiding kanompoi, kathu-u themcha kasei dingu hi nami lungsetna-a neingaipeh dinguva kataovu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile keihon hichepa hi mi sugam, chule vannoi leiset chung jouse-a Juda ho lah-a vaipi chohsea, chule Nazareth chona chonho lamkai pipu ahi kaman doh-un:
  </para>
  <para style="p">
    <verse number="6" style="v" />Chumale houin suhboh dinga jong agot jeh-a kamatnu ahin, kadannu dung juija athu katan diu dol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin sepai sang lamkai Lysias'in in eihung buluvin, thahat sanna kakhut nuva konin ahung lahmangin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahehho nahenga hung dingin thu apen ahi. Amatah chu nangman dongtohle chun kahehnao hi adih adihlou abonchan hesoh keinan nate, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Juda ho jong chun ajomun, hicheng chu ahicheh-e, atiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin gamvaipo chun thu sei dinga Paul akhasuh phatnin, Paul'in adonbutnin: Kum sottah nangma hiche nam mite thutana panga nahitai ti kahen, lung kipahtah-in kakihona thu seijinge;
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangman henan natin, Pathen hou dinga Jerusalem'a kachehi ni somle nini aval hihlaije:
  </para>
  <para style="p">
    <verse number="12" style="v" />Houin sunga mi khattoutoh kakinel, ahiloule kikhopnale kho sunga mihonpi katilsetna imacha eimupouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tu-a eihehnao chengse jong chu aphotchenna hiche ahi ati theipouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin keiman nangma jah-a kaseidoh hiche hi ahi, Amahon houdan chom asah-u lam dungjuija keiman kaputeu kapateu Pathen chu kahouva, danthua le themgaoho lekhabua kisun dungjuija chu thil jouse katahsana,
  </para>
  <para style="p">
    <verse number="15" style="v" />Amaho jongin michondih jong michondih lou jong athi thokit umding ahi tia akat jingu, hitiho chu keiman Pathen lama kinepna kanei ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche jeh-a chu Pathen le mihem lama suhkhel beija, ase apha hetkahna neija umdinga a-imatih chana kihabol jing kahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin kum tamtah nunga kanam vaipiu min ahunau thilpeh le thilto hinpo-a hunga kahin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichea chun Asia gama Juda hon houin'a kakisuh theng chu eimuve; mihonpi toh kaumpoi, chule thunoh baotam imacha jong aumpoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho chu hikoma nangma anga hin umuhen, kachunga thu eihehna ding aneijule seijule hi ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahiloule hiteho hin seijuhen, houvaipoloi anga kadina chu kasuhkhel ipi amatdoh-um,
  </para>
  <para style="p">
    <verse number="21" style="v" />Alah uva kadina kho kasapma, athiho thokit thua tunia na-ang sunguva eikikouva eikidonga ahitai, tia kasei tailou chu, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin Felix'in chuche Lam thudol chu ahetchet jeh-in, athu tan ding chu akhongaijin, Lysias sepai vaipipo ahung tengle nathu-u ngaito chen nange, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman Paul chu sepai jalamkai khat anga sah-in, chamlhat tah-a aumsah-a, ahenga hung ajenle dingle agol apaiho jong akham lou dingin athupeh-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ni ijat-ham jouvin Felix chu a-inneipi Juda numei Drusilla toh ahungin, Paul agakou sah-in, Christa tahsan thudol asei chu angaijin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman chonphatna, kitim them, chule khonunga hung lhung ding thupi kitan thudol asei phatnin, Felix atija jahtan, adonbut nin, Tun chetan; keiman ka-on phatle nangma hungkousah nange, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chujongle Paul chun sum eipentin kilhadoh tante tijong akinem min, phiveng vungin akousah-in ahoulim pijin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahivangin kum ni nungin, Porcius Festus'in Felix panmun chu ahinkhel tai; hichun Felix chun Juda ho deija umding ngaitonan, Paul chu akanin adalhatai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Festus chuche gamkai sunga ahunglhun, ni thum jouvin Ceasaria'a konin Jerusalem'a achetouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin thempu pipuiho le Juda miho pipuhon ajah-a Paul chungchang thu ahilou lamin anaseijun;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule lampia anachanlhih uva anatha theina dingu lungthim ngaiton, ama chunga chu amaho alungsetnuva Paul chu Jerusalem'a ahinpuina dingin ataovun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin Festus'in adonbutnin, Paul Ceasaria kikoija ahi, chule keima khu lama chevah ding kahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun ama khun suhkhel anei ahile, nalah uva thunei chengse keimatoh kilhonin hungsuh-uhen, hung heh-u hen, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amaho lah-a ni som val anichon nungin Ceasaria achesuh paijin, akit nin thutan na-a atouvin, Paul gapui dingin thu apetai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin ama ahung lhun phatnin, Jerusalem'a kona hungsuh Juda ho akimvela adingun, Paul dounan thu gilou tamtah-in aheh-un, ahivanginla aphotchenna avetsah theipouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Paul'in ama kihonna thu aseijin, Juda ho danthu ahin, houin ahin, ahiloule Ceasar douna ahin, keiman imacha kasuhset kasuhkhel aumpoi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin Festus chun Juda ho deija umding angaiton, adonbutnin, Paul jah-a, Nangma Jerusalem'a chetouva khukoma keima ang sunga hicheng thudol hi ngaito-a umding nanop em, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla Paul'in, Keima kathu kitanna dingdol Ceasar thutanna anga dinga kahi. Keiman Juda ho ima kasusepoi, nangman jong nahe sohkeinai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutia akhang gilou kahia, thina theiloma suhset nei kahile, thi ding kadapoi; amavang hicheng eihehna chengseu hi tahbeh ahiloule koiman amaho khutna eipedoh thei ponte, Ceasar henga ngehna kabole, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutah-in Festus vaibol chengsetoh akihoutoh phatnin adonbutnin, Nangman Ceasar henga ngehna nabol ahitan, Ceasar heng nache ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ni ijat-ham jouvin Agrippa lengpa le Bernice chu Ceasaria ahung lhung lhonin, Festus chu salam ahung boh lhone.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin chua sottah anichong lhonin ahile, Festus'in lengpa jah-a chun Paul thu umchan aseijin, Felix dalhah sohchang kihen khat aumin,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama chun Jerusalem'a kaum petnin thempu pipuiho le Juda upahon athu eihetsah-un, athu tana chai dingin kahenga athumui.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akihehpale ahehho kimaito-a akihona thule ahehnau thudol seina neisah masanga mi koi hile thidinga pehdoh chu Rome mi chonna ngai ahipoi tia, amaho chu kana donbut ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amaho hikoma ahung kikhomun ahile, keima jong chom khatcha geisang louvin akit ni maman thutan na-a katouvin, amapa chu kagakou sahtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahehho chu akim vela adingun, akhan gitlouna thun heh-unte, tia kaginchat bang chu achunga thukhoh imacha aseipouve;
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho hou thudol leh Jesu atiu mithisa khat Paul'in ahing kitne ati thudola kinel ahibouvui.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin chutobang thu chu atannaje kahevah hih-in, Jerusalem'a chea chuche athu chu tan ding anop anop lou kadongin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla Paul'in ama chung changthu Leng chungnung tandinga ngehna aneiphatnin, Ceasar henga kasol thei ding kahse-a koi dingin thu kapetai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Agrippa'in Festus jah-a, kei jong keimatah-in hichepa thu chu jaleng kalung ahi, ati. Aman, Jingle janavehta chun, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutichun ajingin Agrippa Bernice toh loupitah-a ahunga, thu ngaina inpia sepai Vaipipo hotoh khopi sunga miho pipu chengsetoh ahung lut phat lhonin, Festus thusah-in Paul chu ahin puilut taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Festus'in, Lengpa Agrippa chule hikoma kaumpi mi jousen hichepa hi namuve, ama hi Juda mihonpin Jerusalem'a jong, hikoma jong kahenga aheh-un, ahinga umhoi ahitapoi, tin asamui.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahivangin athina theilom ima akhan gitlouna keiman kamudohpoi; chule aman leng chungnung henga ngehna abol jeh-in sol dinga kagot ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahin achungchang thudol ka pakai henga gahsut ding thu kichentah ima kaneipoi. Hiche jeh-a chu na-ang uva, Vo Agrippa lengpa, nangma ang sungtah-a kahinpuidoh ahi, ijem tia athu dohtoh nunga sutding themkat kanei theina dingin:
  </para>
  <para style="p">
    <verse number="27" style="v" />Ijeh-inem itile akihehna thu sun louva sohchang gahsol chu kitoh kasapoi, ati.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Agrippa'in Paul jah-a, nakihonna thu seitheijin nate, ati. Chutah-in Paul'in aban ajah-in, akihona thu aseijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Lengpa Agrippa, Juda hon eihehna jouseu thua tunia nangma anga kakihona thu sei dinga kaum hi lungnom kaki salheh jenge,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehpen chu nangman Juda ho lah-a chonna danle kinelna thunoh jouse nahet sohkeija, nathemsoh jeh chu ahi. Hijeh chun khongai themin kathu ngaijin tia katao ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kachapan laija patna kanam mite lah-a, chule Jerusalem'a kanunchan kakhanchan chu Juda hon ahe sohkeijui;
  </para>
  <para style="p">
    <verse number="5" style="v" />Atila patna ahet sohkeisao ahi jeh chun, kahou danuva chondan khelpentah dungjuija kachona Pharisai chona kachon chu sei nomleu asei thei dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule tu-a hi kapu kapateu Pathen'in athutep chu kineppi jeh-a athu kitan dinga hikoma ding kahi:
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche thutep chu mu ding kinema, phung somle phung ni hin gunchu tah-a asun ajana Pathen ahouvu ahi; hiche kinepna jeh-a chu, Lengpa Agrippa, Juda hon eiheh-u ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen'in athiho akaithouve ti ibola nanghon tahsan umlouva nangaitou ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman jong Nazareth Jesu min douna hin thil tamtah akaleh-a bol ding ahi tin kangaiton ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hichu Jerusalem'a bol jong kabolin, chule thempu pipuiho-a konin thuneina kamun, mithengho tamtah songkul'a kakhumin, chule athao jong chun kaphasah-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule kikhopna in jouse-a talent kape jingjin, engsanin kataitomsah-in, achunguva chun kalungsa tuntun jengin, migam dang khopi gei sanin kabolsen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitichun thempu pipuiho-a konin thuneina le eisolnao lekha kamun, Damascus lama kachen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichun, vo lengpa, sunkim tah-in lampia chun van'a kon vah khat nisa sanga vahjo kamun, hichun kakimvel le kalhonpiho chengse asalvahsoh jenge.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin tolla kalhuh gam phatnun, keiman Hebrew paova kajah-a, Saul, Saul, ibola nangin neibolset jingham? nang dingin thihtul monghem lho ahahsai, eitia aw khat kajai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin keiman, Pakai, nang koi nahim? katile Pakai chun, Keima nabolset jing Jesu kahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahivangin thouvin chule nakengin pansan dingin; nangman thil namusa chengse le khonunga nahenga kaphondoh ding chengsea kathu hettohsah dingle kalhacha-a pansah dinga, hiche dinga chu nahenga kahung kilah ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Kamiteho-a konle, tu-a kasolna chidang namdang ho-a kona kahuhdoh ding nahi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Amitnu hadohsah dingle muthim lah-a kona khovah-a, chule Satan thuneina noija aumuva kona Pathen henga akihei theina dingule, achonsetnao akisuhbeija, keima eitahsan vanga kisuthengho lah-a gou alo theina dinguva ahenguva kasol ding nahi, eiti.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun, vo lengpa Agrippa, keima vanthil kamu thua chu nung louvin kaumpoi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin amasan Damascus-a umho jah-a, chuin Jerusalem le Juda gam pumpi, chule chidang namdangho henga jong lung aheijuva Pathen lama akiheijuva, lungheitoh kilom thil abolna dingun kaseiphong letan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh-a chu Juda hon houin sunga eimat uva tha dinga eigotnu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathen'a kona panpina kanei jeh-a tuni geija kadina, alen aneo kahetsah ahi, thu dang ima kaseipoi, themgaoho le Mosi'n hung ding ahi tia aseiju,
  </para>
  <para style="p">
    <verse number="23" style="v" />Christa chun gim genthei athoh tei dingje, athiho lah-a thoudoh kit amasapen ahia; amite le chidang namdangho henga vah aphondoh dingje kaseibou chu ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman chutia akihona thu aseija adonbut chun, Festus chun aw sangtah-in, Vo Paul, angola nahi; nalekha them sangin nasuhngol ahitai, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahin Paul'in, Vo michung nung Festus, angola kahipoi; thudihtah le chihna thu kaseijoh ahibouve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ijeh-inem itile lengpan jong hiche thudol hi ahei; hijeh-a chu ama ang sunga ngamtah-a kasei ahi; ajeh chu hiche hi ningkoija kibol ahilou jeh-in, ama jah-a ki-ima imacha aumpoi ti chentah-in kahei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Leng Agrippa, nangman themgaoho thuhi natahsan em? Natahsane ti kahei, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Agrippa'in Paul jah-a, thu themcha-a jollhah-a Christian hisah ding neigoi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Paul'in thu themchan hihen thu tampin hile, nangma chang hilouvin, tunia kathusei ja jouse hi kakikan naho tailou hin, abonchan keimatoh bangleu tin Pathen henga kathume, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman chutia aseiphat chun, lengpa, gamvaipo, Bernice chule atoukhompi ho setoh akipat doh-un,
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin achoma acheuvin akihouvun, Hichepa hin thina hoile kanna dingdol thil ima asuhkhel aumpoi, atiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Agrippa'n Festus jah-a, Hichepa hin Ceasar henga ngehna abolou hile, lhadoh thei ahi, ati.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kong'a kitola Italy gama kache dingu thu akichet phatnin, Augustus sepai loi lah-a Julius atiu sepai jalamkai khutnah Paul le sohchang dangho apedoh taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Asia gamkolvel muntina kitol dinga kigo Adramyttium kong'a kalutnun kakitol taove; chule Macedonia gama Thessalonica mi Aristarchus toh kalhonui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akit nin Sidon kho-ah kong kangaove. Chule Julius'in Paul alungsetnin, agol apaiho henga chea gakithado dingin asole.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin chua kon chun twi chunga kacheuvin, hui akaleh lama anun jeh-in Cyprus twikol le lam lamah kakitol taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Cilicia le Pamphylia depma twikhanglen kakhelun, Lucia gama Myra khopi kalhungui.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chukoma chun sepai jalamkai chun Italy gam jon ding Alexandria kong khat amudoh-in, hi chun eikhum taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin sottah olchachan kakitolun, hahsa tah-in Cnidus jon kagei hamhamui, huijin einan jeh-un Salmone gam Crete twikol le-a kakitolui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun nahnah-in Lasea khopi kom Kaimunhoi atiu mun khat kalhungun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin akisot behseh tahjeh le kong'a kitol setto kichat aum jeh chun (hichu an ngol kichai jou ahitan), Paul'in amaho chu akhamin,
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo miho, hiche twi chunga icheuva hin setto hakamna inei dingu ahi kamui; hichu thilkeole kong keo jeng hilouvin, eiho ding jengin jong setto kichat aume, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahivangin sepai jalamkai chun Paul thu sangin kong pipu thule akong neipa thu ahajop jotan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin phalbi-a umna dinga kongkai mun chu akijen lou jeh-in, mi atam jon hikoma kona chu kitoldoh-a Phoenicia lhun teiteija, chukoma chu phalbi sunga umding asomtaovin ahi. Phoenicia chu Crete twikol gama kongkai mun khat ahin, lhumsah le lhumlhang angatto ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin lhang hui olchachan ahung nungin ahile, alunggot bangu hin angaitouvin, kong chu alhaovin Crete pam chin chinah atoltauve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin chujou chomkhat jouvin, chua kon chun Euroclydon atiu huipi hattah ahung nungsuh tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin kong'a chun ahung chutan ahile malama atoljou tapouvin, kamoh lhatauvin ahile eilhoh eilhoh jengtaove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amin Clauda atiu twikol neocha khat-ah kalhaijun, hahsa tah-in kongneo chu kahuhbit nahnah-un ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin hichu akhaidoh-un ahunan amangun, khaovin kong noi lamah akanbeh taove. Chuin ajole Syrtis nel lah-a kileng lut getninte ti akichauvin, pondal kikhainaho alalhauvin ahile eimoh lhoh lhohtaove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin huipi chun eisuhgim behseh jeh-u chun, akit nin thil apaidoh pantaove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anithum nin keihotah-in kakhut tah-un kong manchah ho chu kapai taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ni tamtah nisa chule ahsi ho eisalvah-u beihela huipi hat nasatah tang louhela anun anun phat chun, hichea pat chun kisohcha inte ti kinepna aumtapon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ni tamtah an nelouva aum phatnun, Paul alah uva adingin: Vo miho, nanghon hiche settole hakamna hi to louna dinga kathu nangai uva, Crete'a kona chu kong hi nalha lou dingu thu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin tu-a jong lungmong tah-a umdinga katil nahiuve; nalah uva koiman nahinnao nachan lou dingu ahi, kong vanghi mang ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajeh chu Ama-a kahia, alhacha kapan Pathen chu a-vantil tujan chun kakoma adingin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Vo Paul, kicha hih-in; Ceasar anga nadin tei ding ahi; chule ven, nalhonpi ho chengse hi abonchauva Pathen'in nangma napehdoh ahitai, eiti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiche jeh chun, vo miho, nangho lungmongun; ijeh-inem itile Pathen katahsanin, kajah-a asei bang banga chu hung soh tei ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amavang twikol khatna ichuh tei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Adria twikhanglen'a huijin eisuhtol eitoutolu ajan somle ajanli jan-in, khangkimin kong mihon gamlei kinaija hitante ti agingchauvin,
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichun twi athuh chu ateule lam somni atedoh-ui; chuin phabep ache chonun ate kitleuvun ahile lam somle lam nga atedoh-un,
  </para>
  <para style="p">
    <verse number="29" style="v" />Song lah-a kikisunte ti akichauvin, kong tom lamah thihhat li aseplhaovin, khovah angahtauve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin kong miho chu kong mai lama thihhat seplha ding beh akisauvin, kongneo twikhanglen'a adomlhauvin, jam ding lungthim angaito taovin ahile,
  </para>
  <para style="p">
    <verse number="31" style="v" />Paul'in sepai jalamkai le sepaiho jah-a, amaho khu kong'a aum louvule nangho changin sohchathei pouvin nate, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chutah-in sepaihon kongneo ho khao chu asattan un, twi lah-a alhataove.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin jing khovah konin Paul'in miho chu annen asolin, nanga nangaova an ngola imacha ne louhela na-umnao tuni nisom le nili ahitai,
  </para>
  <para style="p">
    <verse number="34" style="v" />Hijeh-a chu an ne-a kasol nahiuve, hichu nakihinsona dinguva phachom ding ahi; ijeh-inem itile nalu chunguva nasamjangu khatcha jong lou louding ahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hitia chu asei jouvin, aman changlhah alan mi jouse ang sungah Pathen alhaijin, changlhah ahehbalin ane pantai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chutah chun miho jouse chu abonchauvin alung ngamun, an anecheh taove.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kong'a uma chu mihing jani le somsagi le gup kahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin miho chun an anehva phatnun, suhlouchang chu twi lah-a apaijun, kong chu asujangkhai taove.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin khovah phatnin agamlei chu ahetapouve; ahivangin twipang kong ngahna thei khat amudoh-un, ahitheile kong chu chukoma tol lut ding tin akihousom taove.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin thihhat ho alhalhaovin, twikhanglen'a adalha taove; chuin hichutoh thakhatnin kongkhe kanna chu alham lha uvin, hui chena lama kong ponjal chu atungdoh-un, twipang lam chu ajon taove.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin twikinong ni kisuhto na-a kalut khataovin ahile, kong monghem chu leija akiphut dentai; chuin kong mai lam chu long louhelin a-ohdentan, kong meilam chu twikinong chun hasuh-a asuhle akeh pantai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin sepaihon sohchangho chu twi jap gal kaija ajama umget inte atiuvin, tha dingin agotauve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ahivangin sepai jalamkai chun Paul chu huhhing agon bol dinga alung gotnu chu akhamin, twi jap thei theijan twi jap galkaihen, vapam anakai masahen;
  </para>
  <para style="p">
    <verse number="44" style="v" />Adang amohse kong'a um khunpehle thil dang dangin kitol galkaihen, tin thu apetai. Chutichun abonchauvin bitkeijin asohchaovin, tolgo alhung taove.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin kasochat phatnu chun twikol chu Malta kiti ahi ahedoh taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule paomah hammah ho chun khoto mainah-in eikhoto pouve; hiche pet chu gojuh lai ahin adap jeh chun mei eitipeh-un eilhunsah sohkeijui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin Paul'in thing lom khat achoma meija chu agahtoleh, meisahula kon chun gulse khat ahungdoh-in, akhut achun akikhaiden jengin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin paomah hammah hochun gul akhutna akikhaiden jeng chu amuvin, khatle khat akihouvun, Hichepa hi tolthat mong ahi, twikhanglen'a asochat jeng vanga hi, thudih tannan ahinghoi dehlou ahi, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman gul chu mei sunga chun athinglhan, a-ima aloupoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin amaho chun hung pomintin, ahiloule phulou helouvin lhuntin, thi ding ahi, tin angah jingun ahi. Ahinla sottah angauva avet jouvun a-ima alou lou chu amuvin, alung gelu akhelun, ama chu pathen ahi atitaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche mun koma chu twikol gam pipu amin Publius atiu chun gam anei ahin; ama chun eila lutnun, khotona nei tah-in ni thum a-in'a eilhun sah-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Publius pa chu khosih le ehthit veija luma ahin; chuin Paul akoma agalutnin, achunga akhut angamin ataovin adamsahtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutia abol jou chun, chuche twikol gam sunga midang ana nei jouse ahungun ahile adam gamtaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho chun lamchom chomin eijabol lheh jengun, kong'a kakitol phatnun thil kangaichat ding dolchanu kong-ah eihung koipeh-ui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin lha thum jouvin phalbi sungse-a twikol'a chu cham, amelchihna Ucha Sohkop atiu Alexandria kong'a chun kakitoldoh taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Syrakuse'a kakingaovin, chukoma chun ni thum kaumui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin chua kon chun kache velkolun Rhegium kalhungui; chuin ni khat jouvin lhanghui anungin ahile akit nin Puteoli kalhung taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hikoma chun sopiho kamudoh-un, akomuva ni sagi nichong dingin eijolui. Chuin chutichun Rome lam ngan kachetauve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin chua kon chun sopihon keiho thu ajah phatnun Appii kailhang le Jinlhun In Thum geijin eilamto diuvin ahungui. Chuin Paul'in amaho chu amu phatnin Pathen athangvah-in alung ngamtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Rome khopi kahunglhun phatnun, sepai jalamkai chun sohchang ho chu angahho jalamkai khutna apedoh-in, ahin Paul chu achanga sepai angahpa chuto umdingin thu apetaove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, ni thum jouvin Juda ho lah-a apipuho chu akou khomin; chuin amaho ahung kikhop phatnun ajah uva: Sopiteho, keima inam miteu dounale ipu ipateu dan douna-a ima kasuhset aum lou vangin, Jerusalem'a kona Rome mite khutna sohchanga pehdoh-a um kahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kathem kathemlou aholtoh-un, thina hoi ima kachunga amudoh lou jeh-un, lhadoh dingin eigotaovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahivangin Juda hon hichu anel jeh-un, kacham louvin Ceasar henga ngehna kaboltan ahi; hichu kanam mite hehna dinga ahipoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche jeh-a chu nang hotoh kimuto-a kihoulim dinga kakou nahiuve, ijeh-inem itile Israelte kinepna jeh-a thihkhaova hi kihen kahibouve, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon ajah-a, Keihon nangma thudol Juda gama konin lekha kamupouve; chule sopiho lah-a jong koima hikoma ahungin nangma chung changa khan gitlouna thu hung lhut aumpoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin nangma lung ngaito thudol hi nanga konin kajah nomui: ijeh-inem itile hiche houchom thudol hi gamtina seisetna aum kaheuve, atiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin nikho ateppeh-un, aumna-a chun ahenga atama tam ahungun, aman jingkah-a pat nilhah geijin Mosi danthu le themgaoho lekhabua konin thu asodoh asodoh-in, Pathen lenggam thu ahettohsah-in, Jesu thudola ajoltan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin athuseiho chu abangin atahsanun, abangin atahsan pouve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amahole amaho akilol thei lou phatnun, Paul'in thu khat asei jouvin apotdoh taove; athusei chu hiche hi ahi. Lhagao Thengin themgao Isaiah kama napu napateu jah-a, asei chu adih lheh jenge,
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche mite henga hin chenlang gaseijin: nanghon ja vang ja naovin natin, nahet them lou dingu; muvang munao vin natin, nahetdoh lou dingu ahi;
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu hiche mite lungthim hi thaova kitom ahin; ana khangun kho ajathei pon, amitnu asingun ahi, chutilou hile amitnun muvintin, anakhangun ja-intin, alunguvin hetdoh untin hung kilekit khaleu, Keiman amaho chu kadamsah khahding ahi; tia, asei chu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche jeh chun hiche hi kihet un, hiche Pathen mihuhhing na hi chidang namdangho henga kisola ahitai; amahon ngai jong angai dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin thu hicheng chu aseiphat nin, Juda ho apotdoh-un amaho le amaho hatah-in akinel taovin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman inman apeh-a achenna-a chun kum ni lhingset aumin, ahenga hung jouse chu anasangjin,
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathen gam thu ahil lhangjin, hakattah-in Pakai Jesu Christa thudol ahiljin, koimachan akhampon ahi.
  </para>
</usx>
