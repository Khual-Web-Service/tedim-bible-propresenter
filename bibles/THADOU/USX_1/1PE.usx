<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1PE" style="id">1 Peter</book>
  <para style="h">1 Peter</para>
  <para style="toc1">1 Peter</para>
  <para style="toc2">1 Peter</para>
  <para style="mt">1 Peter</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu Christa solchah Peter'in; Pontus gam, Galatia gam, Cappadocia gam, Asia gam, chule Bithynia gama kithecheh khopemho,
  </para>
  <para style="p">
    <verse number="2" style="v" />Thua nung dingle Jesu Christa thisan thekhuma umdinga, Pa Pathen lunggot masah dungjuija, Lhagao suhtheng na-a kilhengdohho hengah: nachung uva lungsetnale lungmonna punghen.
  </para>
  <para style="p">
    <verse number="3" style="v" />I-Pakaiyu Jesu Christa Pa Pathen chu vahchoijin umhen; Jesu Christa athia kona athokit vanga amihepina chungnung dungjuija kinepna hing chang dinga eihinu ahin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Gou setheilou, thengsel, chule toi theilou nangho chan dinga van'a kikheh khola,
  </para>
  <para style="p">
    <verse number="5" style="v" />Huhhing-a umdinga tahsan vanga Pathen thahat na-in achintup, phat nunung lamle hung kilangdoh dinga gotsa nahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu chomcha khat dinga, akhoh dungjuija, lhepna tintang jeh-a nalunghem jeng vangun, hiche-a hin hatah-in nakipah-un ahi:
  </para>
  <para style="p">
    <verse number="7" style="v" />Meija akipatep jeng vanga jong mang thei sana sanga manlujo, natahsan nao kipatepna chu, Jesu Christa hung kilah teng vahchoina, choi-atna, chule loupina-a akimu theina ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama chu mukha louhela ngailu-a nahiuve; tun jong ama chu namu louhel vangun natahsanun, kipana seitheilou le loupina-in nadimun ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Natahsan nao bulhina, nalhagaovu huhhingna ngeichu namu jeh-un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nachung uva lungsetna hung chuding hiche huhhingna thudol hi, gaova anaseidoh themgaoho chun akholuva, chule gunchu tena anaholuva;
  </para>
  <para style="p">
    <verse number="11" style="v" />Christa thohgim dingje le nungle loupina-in ajom ding thudol Christa Lhagao amaho lung sunga uma chun aseipeh masah laijuva chu, itobang mi ahiloule itobang phat ahi ding anakholu ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche chu amaho henga kiphong doh-a ahin, amaho le amaho changa dinga hilouva, tu-a van'a kona hinkisol Lhagao Thenga kona Kipana Thupha hillhang lehon najah uva aseiju thil chengsea hi amaho eiho lhachale-a pangjo-a ahiuve; thil hitiho hi vantil ten jong vet atupmu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun nalung kong kigah-unlang lung limgehchan umun, Jesu Christa ahung kilah tengle nachung uva lungsetna hung kilhut ding chunga chun nakinepnao ngaichamkimun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Malai nangol laijuva nalung ngaichat dungjuija nachonjiu banga chu chon louvin; sei ngaija thua nung chate chon doltah-in chonun;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin nakoupa athen bangin, nangho jong nunle khan jouse-a thengun;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajeh chu, Keima kathen jeh hin nangho thengun, tin akisune.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule dat nei louhela mi jouse ama ama natoh dungjui cheh-a thutana chu Pa tia nakouvu ahile, hiche mun'a nakholjin lai sungseu hin ging khenchan hinkho mangun;
  </para>
  <para style="p">
    <verse number="18" style="v" />Napute napateuva kona kilason chonna homkeova kona namu-u mangthei thil, sana le dangka-a kilhatdoh nahipouve;
  </para>
  <para style="p">
    <verse number="19" style="v" />Amavang boh beh louhel le nolna beihel kelngoinou, Christa thisan lutah-a chu kilhatdoh jo-a nahi bouvui:
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama chu leiset kiphudoh masanga gotmasah sa anahin, amavang hiche phat kichai kona hi nangho dinga hung kilah ahi,
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama vanga chu nangho athi lah-a kona ama kaithou le loupina pe-a Pathen tahsan mite nahiu ahi; hichu natahsanu le nakinepnao chu Pathen'a aum theina ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lhagao jala sopi ngailutna daithei lou dinga, thutah thua nanun uva kona nahinnao nasuhthengu ahitah jehchun; khohsahna neitah-in khatle khat lungtheng selin kingailuto cheh-un;
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajeh chu nangho kem mang thei chia kon hilouva, kem mang theilou chi, tonsotna hingjing le umjing Pathen thua kona thah penkit nahiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajeh chu, Mihem jouse hampa tobang ahi, Aloupina jouseu jong hampapah tobang bep ahi. Hampa agopjin, apah jong apuljitai;
  </para>
  <para style="p">
    <verse number="25" style="v" />Pakai thu vang tonsot geija umjing jeng ahi. Najah uva kihil lhangle-a Kipana Thupha chu hiche hi ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh chun gitlouna jouse, doha lheplhahna jouse, phatlhemna, thangset, chule kiseisetna jouse pailhauvin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Naosen sohthah bangin, thua kon bongnoi thengset chu ngaijin umun, hichea chu nakhan tou theina dingun;
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon Pakai chu milungset them ahi chu natep khah-u ahitah-a ahivangle.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihem paija um hijongle, Pathen dinga lhentum le manlutah ahin, Ama henga chu songpi henga hung banga nahungu ahi,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangho jong songhing ho banga, Jesu Christa vanga Pathen san thei doltah-a lhagao ganlhaina tohdoh-ah thempu theng hidinga, lhagao in'a kisadoh nahitaove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Pathen lekhabua hitin akisune, Veuvin, Sion'ah inning song pipen, lhentum, man lutah chu kadoi; Ama tahsana chu iti nama jongle jachatna-a chu lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichu atahsana nangho dinga man lutah ahi; atahsan louho ding vanga hiti hi ahi, Insahon apaiju song chu Aninga apipena panga ahitai;
  </para>
  <para style="p">
    <verse number="8" style="v" />chule, kipalna songle suhkhelna songpi soh-a ahitai; amahon thu chu angai loujeh uva kipala ahiuve; hiche dinga chu amaho gotsa jong ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin muthima kona ama vah kidangtah sunga lut dinga nakoudohpao phatna chu naphondoh theina dinguva, nangho nam lhenchom, leng thempu, vaipi theng, chule ama-a tum hi dinga Pathen mite nahiu ahitai:
  </para>
  <para style="p">
    <verse number="10" style="v" />Masanga chu mite hilou nahiu ahin, tu vangin Pathen mite nahitaove; hepina changlou nahiu ahin, tu vangin hepina changa nahitaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngaitah teho, nangho mi gama cheng le kholjin tobang nahijeh uva naheng uva kahungtao ahi, tahsa ngaichat thil chengsea konin kikangseuvin; hitiho chu lhagaotoh kidou ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule chidang namdangho lah-a nanun nakhanu phatsah-un; chutile akhang gilou tia amahon nangho naseisetnao chu amittah-in nathilpha bolu chu muvintin, hiche thudol chu vettoh-a aum nile Pathen avahchoi dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai jal-in mihem phudoh chondan thun nungun: mijouse chunga vaipo ahito lhonin, Lengpa thu ahin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahiloule mikhang gilouho chunga phula dingle, mi thilpha bolho pachatna pedinga ama hinsol gamvaipoho thun nungun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu nanghon nathilpha boluva konin lungthim beiho ngolna chu thiphelin lhaleu chun, hichu Pathen lunglam ahi:
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho chamlen chonin chonun, ahivangin hiche nacham len nao chu gitlou khunan nei hih-un; ahin Pathen sohte um doltah-in umjouvin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi jouse jabol sohkeijun. Sopi tapou chu ngailuvin. Pathen gingun. Lengpa chu jabolun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sohteho, nangho gingkhen chan napakai te chengseu thunoija umun; apha le anunnemho heng jenga hilouvin, lunggilou puho thunoija jong umun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi khattou Pathen ahet jeh-in thohdol louhel thohgimhen, dihlou tah-a akibolna thohham hamle, Hichu pachat umtah ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nathemmona jeh-in min navo henlang, lungneng tah-in thohle chun, ipi pachatna nachan dingham? ahin thilpha nabola, hiche jeh-a chu nahesoh gentheija, lungneng tah-a nathoh-a ahile, hichu Pathen deilam ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu hiche-a dinga chu kikou nahiuve: ijeh inem itile Christan jong eiho dinga hesoh genthei athoh ahin, nangho akhonung jui nahina dinguva, hichu vettoh-a jui ding akoija adalhah ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama chu achonsepon, akam sunga jong doha lheplhahna kimulou ahi:
  </para>
  <para style="p">
    <verse number="23" style="v" />Houset achanin ahouse thuhpon; athohgim pet jong chun koima agihsalpon; ahin chonpha tah-a thutanpa khutna akingaijon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Eiho chonset lama ithiuva chonphat lama ihinna dingun, Aman eiho chonset jouse atahsa chunga apon, thingleh geijin apodohtan ahi: ama kijepna maha-a chu nangho kiboldama nahitaove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajeh chu nangho kelngoi hon banga lamvaija nahiu ahin, tu vanga hi nalhagao chingpao le nakaihoipao henga hung kile kit nahitaove.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche bang chun, inneipiho jouse na-inneipute cheh-u thunoija kipelut un; amaho abang khattou thua nunglou hijongleu, thua hilouva, a-inneipite chengu khanthem vanga akijo theina dingun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho ging gehcha na-umu nanun nakhannu thengsel chu amit tah-a mu-u hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sampheh hoi, sana khi-o, nihchen ponsil got chomchom tho-a polam jem-a kijem louvin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Lung sunga guhthim mi, nunnem le lungnem kem theilou jem chun kijem jouhen; hichu Pathen mitvetna man lutah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu malaija numei theng Pathen'a kingaiho jong chu chutia chu kijema, a-inneipute chengu thunoija kipelutnu ahiuve:
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitia chu Sara'in Abraham chu pakai asah-a athua ananun banga; nanghon kichase louhela thilpha nabol uva ahile, ama chanuteho nahiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutobangma chun, inneipu teho, natao nao daltana aumlouna dingin, hinna lungsetna nachankhompiu ahiuto lhonin, numei chu belkehbai bangin jabolun lang, hetna dungjuijin amaho chu chenkhom piuvin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Achainan, nangho nabonchaovin lungkhat hiuvin, kilainatto cheh-un, sopi khat bangin kingailuvin, kilungsetto themun, nunnem tah hiuvin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Set phu lahnan set bolhih helun; chule houset phu lahnan house thuh hih-un: chusangin phatthei bohjouvin; ajeh chu phattheina chu lo dinga nangho kikouva nahiuve ti heuvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu Mi koi hile hinkho ngailut ding noma, nikho phaho mu noma chun Gitlouna-a konin alei, chule milhep lhahna thu seija konin amuh tuhtanghen;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama chu gitlouna konin kileheihen, thilpha bolhen; Chamna hol henlang, hichu nungdel peh hen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu Pakai mit chu michonpha ho chunga aumin, Ataonao ngaina-a ana asungin ahi; Ahin Pakai mai chun thil gilou bolho lam angat jingin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho apha chu juija nahi vangule, koiham nabol engse dinguva?
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla chonphat jala hesoh genthei thoh nahi vangule, anunnom nahiuve: chule amahon nasuh kichatnao chu kicha loujenun, lung jong lungdong hih-un;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chusangin nalunggil uvah Pakai Pathen chu sutheng jouvin: khattou nasunguva um kinepna thudol chu adonga auma ahile, amaho chu lungnemle ging gehcha donbut dingin phasademin um jingun:
  </para>
  <para style="p">
    <verse number="16" style="v" />Sele pha hetna pha neijun; chutile Christa-a nahinkho manu adihlou tah-a seisehon thilphalou bol banga nachung uva athuseiju chu jahchatna anei dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu thilphalou nabol jeh uva genthei hesoh thoh sangin, Pathen lunggot lam ahile, thilpha nabol jeh uva nathoh gimu chu gamchenga phajo ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu Christa'n jong chonsetna chengse jeh-a, chonphatah chun chonpha louho dinga, eiho chengse hi Pathen kom eilhut theina dinguva, khatvei hesoh genthei athohgim ahi; ama chu tahsa-a kithat ahin, amavang lhagaova hinga ahi:
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujongle lhagaova chea kul-a kihen lhagaoho henga thu agasei ahi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaho chu phatkhat lai, Noah nikho laija kong kisem lai sungse-a, Pathen lungdehatna-in anga laija chu thua nunglou anahiuva ahin, hiche kong'a chu mi themcha khat, miget sehbou twija anasohcha-a ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichu Jesu Christa thokit vanga isochatnao baptize channa lima kibol (hichu tahsa nen pailhah hilouva, Pathen heng lama sele pha hetna pha donbutna ahi;)
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama van'a akaltouvin Pathen jet lama aumtai; vantil chengsele, thuneina, chule thilboltheina thahat jouse ama thu noija uma ahitai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti chu ahin, Christa'n tahsa-a eihodia athohgim jeh chun, nangho jong chutobang lungput chun kivonun; ajeh chu tahsa-a thohgima chun chonsetna adalhah ahin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutia chu aphat umnalai chengse chu mihem lung ngaichat lama tahsa-a hing talouva, Pathen lunggot lama ahin johna ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu nomsahna lung ngaichat, huh, juneh hat, julhang neh, nehkhom, thet umtah milim houna-a i-um laijuva chu, chidang namdangho lunggot lam bolna dinga iphatnu tamtah inamanu ahitan;
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon setna lama amaho chu nachon khompitah loujeh uva kidang asah uva, nahouset jiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahingle athi thutan dinga kigopa anga chu amahon achonnau asuhtoa apeh cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche jeh-a chu amaho mihem dola tahsa-a athu-u akitana, lhagaova Pathen lungdeija ahin nadinguva, athisaho jahdinga jong Kipana Thupha chu kiseija ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla thil jouse hi abeina ding nikho anaitai; hiche jeh chun lunglim gehchan umun lang taojing dingin chingtheijun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Imajouse chungvuma gunchu tah-in khatle khat kingailutto nalah uva habolun; ajeh chu ngailutna hin chonset tamtah akhujin ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Phunchel louhelin khatle khat kilhun sahton umun:
  </para>
  <para style="p">
    <verse number="10" style="v" />Amitakip lungsetna thilpeh achan dungjui cheh-in, Pathen milungsetna gotchom chom tamtah gouching phaho bangin, khatle khat kijento jingin umun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thuseija aumle, ama chun Pathen kamsoh seijin seihen; chule mi jenlea aumle, Pathen'in apeh thahat dungjuijin jenlehen: chutia chu thil imajousea Jesu Christa vanga Pathen vahchoija aum theina dingin; Vahchoina le thuneina tonsot geija ama-a ahi. Amen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngaiteho, nangho patepna ding patepna meikong chu thil kidang nachung uva hung chua bangin kidang sahih-un;
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho Christa hesoh genthei thohgim thoh khompi-a nahiu bangtah chun kipahjo uvin; chutia chu aloupina hung kilah tengle, kipana nasatah-a nakipa theina dingun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangho Christa min jala houset nachanuva ahile, anunnom nahiuve; ajeh chu loupina Lhagao chule Pathen Lhagao chu nachung uva aume: amaho jal-in Ama seiset nin aumin, nangho jallin Ama choiat nin aume.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nalah uva koiman toltha jeh ahim, guchat jeh ahim, khan gitlou jeh ahim, midang tohna chunga khut lha jeh ahimin, hesoh genthei thoh hihhen;
  </para>
  <para style="p">
    <verse number="16" style="v" />Christian hi jeh-a hesoh genthei thohgima aum vangle, ama chun jachatnan nei hihhen; ahin hiche min jehchun Pathen choi-an johen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajeh chu Pathen insunga kona thutanna ahung kipat nading phat chu ahitai: chule hichu eihoa akipatna ahile, Pathen Kipana Thupha thua nunglouho kichaina chu iti tantem?
  </para>
  <para style="p">
    <verse number="18" style="v" />Michonpha bon huhhing-a aum ahahsatna ahile, Pathen ngaisah louho le michonse hon hoija amaiju alahdoh dingu hitam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuti ahi jeh chun Pathen lunglam dola hesoh genthei thohgimho chun thilpha bolin alhagaovu chu tahsan umtah asempa henga bangin ama henga pedoh-u hen.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nalah uva um upaho chengse chu, Christa hesoh gentheina hettohsah-a, chule loupina hung kilang ding chankhompi, na-upat chankhompiu keiman kahin til nahiuve:
  </para>
  <para style="p">
    <verse number="2" style="v" />Nalah uva Pathen kelngoi hon umho chu phaten chingphaovin, bollou phamo tia bol louvin, lung chamin bolun; alam louva phatchom ngaichatna-a jong hilouvin, lung guttenin bolun;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pathen gouloho chunga kipipuisah louvin, ahon chun avettoh-a ajui dingu joh-in umun, kaihoijun.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutile Aching pipupa hung kilah tengle, nanghon chul theilou loupina lallukhuh chu nasan dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutobangma chun khangdong ho, nangho upaho thunoija kipelut un. Chule nangho nabonun khatle khat kithununto cheh-un lang, kineosah na-in kivonun: ajeh chu Pathen'in mikiletsah ho adoudalin, mi kineosah ho lungsetna achanjin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Aman aphatcha nangho nachoisang theina dingun, Pathen khut thahat tah noija chun nem heochan umun:
  </para>
  <para style="p">
    <verse number="7" style="v" />Nalungkham najouseu ama chunga sep lha uvin; ajeh chu aman nakhankho dingu agelnai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Limgehchan umun, kihongphauvin, ajehchu nakidou piu diabol chu keipi bahkai kituma banga, koi kaval lhum theidem, tia hollea vahlea ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Tahsan dettah-in ama chu douvun; vannoi leiset chunga um nasopi ho chengseu chunga jong chutobang thohgim chu chusohkeija ahi chu heuvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule lungsetna jouse Pathen, tonsot tonsot geija um aloupina-a dinga Christa Jesu jala nakoupao tahchun, chomkhat nathohgim jou tengule, nasuh chamkimuva, naphudet uva, nahatsah uva, chule nachendet sah dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tonsot atonsot geijin loupinale thuneina chu ama-a hijinghen, Amen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tahsantah sopi-a kangaito Silvanus khutna, nangho tilkhouna le hiche idin naohi Pathen lungset dihtah ahi ti jong hettohsah na-a, chomcha kahinsut ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nakilhen khompiu Babylon'a um houbung le, kachapa Mark'in nasalamui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kingailut na-a kichopton khatle khat kisalam un. Christa Jesu'a um nangho, nabonchaova chungah lungmona umhen. Amen.
  </para>
</usx>
