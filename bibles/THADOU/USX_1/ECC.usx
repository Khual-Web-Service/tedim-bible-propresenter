<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ECC" style="id">Thuhilpa</book>
  <para style="h">Thuhilpa</para>
  <para style="toc1">Thuhilpa</para>
  <para style="toc2">Thuhilpa</para>
  <para style="mt">Thuhilpa</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerusalem lengpa David chapa thuhilpa thusei ho.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pannabei ho pannabei ahi tin thuhilpan aseije, pannabei ho pannabei; ijakai pannabei ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem khatnin nisa noija atohgimna jouse-a kona ipi phatchomna aneinah em?
  </para>
  <para style="p">
    <verse number="4" style="v" />Khang khat achemangjin, chule khangchom khat ahunglhung kitji-e; ahinla leiset a-imatih-in aum jingin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nisa jong ahung sohdoh-in, nisa alhumkit jin, chule ahung sodohna lam mama-a akileloi jitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hui chu lhanglam ngan anungin, chule sahlam ngan ahung lennun jin; tanglouvin akipei pei jengin, chule anundan kisem dungjuijin ahunglenun kitjin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vadung jouse twipia alonglut nun, ahijeng vangin twipi chu adimdehpoi; vadungho chu ahung londohna lama chun akile kitnun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thil jousehi tohgimnan adimsetnin, mihemin aseidoh theipoi; mitla thilmu achinpon, nakol jong athujah-a adim theipoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thil anaumsa chu, ahung um kitding mama chu ahin; chule anakibolsa chu, ahung kibol kitding chu ahije; chule nisa noijahin thilthah ima aumpoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ven thilkhat chungchanga, hichehi athah ahi-e, tia gahsei thei umem? Eiho masangpeh, gollui laija ana umsa jeng ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Masanglai thilho geldohna aumpon; khonunga hung umding honjong ahunglhung ding thil ho geldohna neideh pouvinte.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thuhilpa keima hi Jerusalem'a Israel chunga leng kanahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keiman vannoi'a thil kitongdoh ho jouse chung changhi chihna-a hola kholdoh nadin kalung kanapen ahi; hichehi Pathen'in akisinsah nadiuva mihem chapate chu thohgimna nasatah hi anapeh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Keiman nisa noija nakitongsa jouse chu kamutai; chule veuvin aboncha keijin pannabei le lhagao sunohphah ahibouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Akonsa chu kisujang thei louding; chule akisama chu kisimtha theilou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kalungthimin keima le keima kakihoulim jin, hitin kati; veuvin, keiman mun jaotah chu kahin phatai, chule Jerusalem'a keima masanga anaumho jouse sangin chihna kakimube tai: Tahbeh mongin kalungin chihna le hetnalam hetdohna lentah aneitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keiman chihna, ngolna, chule ngolchona hetdoh nadin kalung kanapen; hiche jonghi lhagao sunohphah ahi ti kamudoh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu chihna tamna-a gimna atamin; chule hetna haopa chun lungkhamna ahaove.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiman kalung sunga, tun chen, keiman nangma thanop na-in napatep inge, hijeh chun nopsahna hinkho mangin, tin kaseije: ahin, veuvin, hiche jonghi pannabei ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman nuina hi, ngolna ahi kati; chule thanopna hi, ipin ahin sodoh ham?
  </para>
  <para style="p">
    <verse number="3" style="v" />Chihna toh kalungsung kiheto-a kakoi jeng vangin, keiman kalung sunga ju lama kakipeh nading; chule mihem chapatehon ahin nikho lhumkei uva, vannoi'a amaho ding atohdoh uva pha kamudoh kahsen, ngolchon nalama kipenge tin, kangaiton ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman natohlen len katongin; keima din in tampi kakisah-in; chule lengpigui hon tampi kakibolin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman hon le theilei tampi kakibolin, hiche sunga chun thei namkim kaphutnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman gammang hinsodoh-a thingphung ho twichap dingin, twikul tampi jong kakilaijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keiman soh pasal le soh numei tampi kaki choh-in, ka-insunga pengden soh tampi kaneijin; keima masanga Jerusalem'a anaum ho jouse sangin gancha alenle aneo kanei tamjon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman dangka le sana, chule lengho le gamkai ho neile gou kidang dangho jong kakichom khomin; Keiman numei lasathem le pasal lasathem, chule mihem chapate kipana thei, tumgingthei manchah ho jatkim keijin kakichom khomin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun keima kanaloupi-in, chule kamasanga Jerusalem'a ana umho jouse sangin kanakhang touvin; chule ka chihna jong aum aumpeh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule kamit tenin amunom tapou chu musah louvin kakoipon, kipana-a konin kalungthim kakham chah poi; ajehchu katohgim najousea kalung akipah-in, chule hiche chu katoh gimna jouse-a kona kachan chu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin keiman kakhut teni-a kanatohdoh ho jousele, tohgimna-a katohdoh ho kaven; chule, veuvin, aboncha chu pannabei le lungthim kisuhboina anahi bouvin, chule nisa noija hin imacha aphachom aumpoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin keima chihna le ngolna chule ngolchona ngaitodin kakiheitan ahi: ajehchu lengpa nunga hungpa chun ipi aboldoh dingham? ana kiboldoh sajeng bou hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujouvin keiman vah-in muthim akhokhel banga, chihna-in ngolchon na akhokhel chu kanamudoh tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Michingpa mit teni chu aluchunga aumin; ahinla mingol vang chun muthim lah-a lam ajotnin ahi. Chule thilsoh khatchu abonchau chunga asoh-e ti keima tah-in kamudoh tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin keiman kalung sunga kaseijin, mingol chunga thilsoh tobang, keima chung jenga jong asoh-in; achutile ipidinga ching jep kahim? kati; chuin kalung sunga, hiche jonghi pannabei ahi kati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu a-imatih chanin miching chu mingol sangin geldoh-in aumdehpoi; tu-a umho jousehi ahunglhung ding nikho hole suhmila umsoh keiding ahi. Chule mi michingpa chu iti thi ham? mingol tobanga thi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun keiman hinkho kahon ahi; ajehchu nisa noija nakitong doh hi keima dingin lungkhamna jeng ahi. Ajehchu imajouse pannabei le lungthim kisuhboina ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dihtah-in keiman nisa noija katoh gimna jouse kahon ahi; ajehchu keiman kanunga hungpa dinga kadalhah pehding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amapa chu miching ahi mingol ahiding koijin ija ahetnem? hijeng jongle keiman nisa noija kachihna vetsahna-a, gimtah-a katohdoh ho jouse chung, aman vai ahop ding ahi. Hiche jonghi pannabei ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun nisa noija katohgimna ho jouse-a chun kalung kathoi sah-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu chihna, hetna chule thudih-a tong gima mi aumin; ahijeng vangin amapan tonggim louhelpa chan dinga adalhah pehding ahi. Hiche jonghi pannabei le thil phaloutah ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu mihem khatnin atohgimna jousele, alunggimna chule nisa noija atohgim naho-a ipi amu-em?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu anikhoho jouse chu gentheina ahin, chule athohgimna jong lunghemna ahi; tahbeh-in, janteng jongle alungsung aolpoi. Hiche jonghi pannabei ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihem khatnin an aneh-a, twi adona, chule ahinna-in atohgimna chunga nop asah sanga phajo aumpoi. Hiche jonghi Pathen khutna kon anahi ti, keiman kana mudoh-e.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu keima sanga koijin an neh akimu joh-a, ahiloule koijin nom asah joh-am?
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu Pathen'in ama mitmun mipha chu chihna le hetna chule kipana apen; ahinla michonse vang chu, Pathen ang sunga miphapa peh ding chomkhom ding le sevum dingin, thoh hahsa apen ahi. Hiche jonghi pannabei le lungthim kisuhbohna ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thil jouse din phat aumcheh-in, chule vannoi'a chule thil kigong jousen phat anei cheh-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Penphat aumin, chule thi phat aume; aphu phat aumin, chule akiphutsa bodoh phat aume.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thaphat aumin, chule boldam phat aume; phetlhah phat aumin, chule sahdohna phat aume.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka phat aumin, chule nui phat aume; lunghem phat aumin, chule lam phat aume.
  </para>
  <para style="p">
    <verse number="5" style="v" />Songho paidoh phat aumin, chule songho lokhom phat aume; kikolchah phat aumin, chule kilhakang phat aume.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amu phat aumin, chule mansahna phat aume; chintup phat aumin, chule paidoh phat aume.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bo-eh phat aumin, chule khuibit phat aume; thipchetna umphat aumin, chule paodoh phat aume,
  </para>
  <para style="p">
    <verse number="8" style="v" />Kingailut phat aumin, chule kimuda phat aume; kigal phat aumin, chule kicham phat aumin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Atongpa chun atohgimna-a kona ipi phatchomna aneijem?
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman mihem chapate kisinsahna dinga Pathen'in apeh thoh hahsat nachu keiman kamutai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman thil ijakai jouse aphatchan hoitah-in asemin ahi: chujongle koimachan Pathen'in abula patna ajona geija ipi atoh doh-em ahetdoh joulouna dingun, alungthim sunguva vannoi thu akhumpeh tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla mihem chu akipa thanopma, ahinkho-a thilpha abol tilouvin, amaho-a thilpha aumpoi ti keiman kahen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujongle mihem jousen aneh-a, adona chule atohgimna jouse-a kona thilpha nomtah-a amanchah ding ahi, hichu Pathen thilpeh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathen'in abol tapou chu a-imatih chana ding ahi, ti keiman kahei; chuche chunga chu belapthei, chule lahdohthei jong aumpoi. Chule hichehi Pathen'in mihemte ama angsunga kicha tah-a aumna diuva abol ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ana umsa chu tu-a umhi ahi; chule ahung umding jong chu anaumsa chu ahin; chule Pathen'in achesa chu anung holin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule chuche chungchon chun keiman nisa noija thutan na mun chu kamun, chua phatlouna aum; chule chonphatna mun'a khangit louna aum kamun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen'in michonpha hole migiloute chung thu atanding ahi; ajehchu thil kigong le thil kiboldoh chengse dingin phat khat aumcheh-e, tin keiman kalungsunga kaseijin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihem chapate umdan chungchanga hin, Pathen'in amaho hinphong doh henlang, chule amahotah in jong sahem ahiuhi kimudoh theileu, tin kalung sunga kaseijin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu mihem chapate chunga thil lhungchu sahemho chunga alhungin; thilkhat jeng jong amaho chunga alhung gellin ahi: khat athi bangin, khatjong athin; tahbeh-in, abonchauva haitheina kibang neicheh ahiuve; chutichun mihemin sahem chunga chungnunna aneipoi. Ajehchu aboncha pannabei ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abon chaovin munkhat ajon cheh-un, abon chaova vutvaija kon ahiuvin, chule abon chaovin vutvai asoh kit jiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihem lhagao chunglama kaltouva, chule sahem lhagao leisetna akumsuh koijin ahet khah-em?
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh chun mihem chu anatoh ho-a kipah thanoma aumding sanga phajo adang aumpoi ti keiman kahedoh tai; ajehchu hichu ama chan ahin; chule ama nunga ipi asoding ve dinga koijin ama apui ding ham?
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti chun kahung kilen, nisa noija suhgentheina jouse chu kangaitoi: chule veuvin, joulhepma umte mitlhi chu, amahon lhamonsah aneipouvin; chule amaho sugentheite henga chun thaneina aume, ahinla amahon lhamonsah aneipouve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun keiman ahingho tu-a hing nalaiho sangin, athiho tu-a athisaho kapah chajon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahbeh-in, amani sangin, tuchan geija umkha loulai, chule nisa noija thilse kibol mukhalou laipa chu aphajoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Avelin, keiman mihem khat aheng akomin amit thip lona thohgimnaho jouse le natohphaho jouse chu kangaiton; hiche jonghi pannabei le lungthim kisuhboina ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mingolin akhut asim tumin, chule ama le ama tahsa akineh jin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thohgim tahle lungthim kisuhboi puma khut ni dimsei neisangin, lungdam sella tah-a khut khat dim nei aphajoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujouvin keima kahung kile kitnin, chule nisa noija pannabei chu kamu doh-e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khatsehbou aumin, anina aumpoi: henge, aman cha aneipon sopi pasal jong aneipoi; ahinla atohgimna aki ngahtih aumpon; amit jong chu haonaho-a alunglhai joupon; koidinga katoh-a, chule kahinna thilpha kachansah louham? tin aseidehpoi. Hichejonghi pannabei ahin, nasatah-a thohgimna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khat sangin ni aphajoi; ajehchu atoh gimna lhona kipaman phatah amulhonin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu alhuh hon jongle, khat chun aloipa aphohding ding ahi; ahinla achanga umpa chu alhuh teng ada ahi; ajehchu aman akithopi ding aneipon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chukitle mi ni alupkhom lhonle, akinehlum to lhonin; ahinla khat changseh chu iti kisuh lum thei ding ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule khat touvin ama hindou taleh, mi nin amapa chu anan jouding ahi; chule khaohol thum kiheh kop chu atanbai pon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Leng tehse ngoltah, thumop sangthei lou hisangin; chapang vaichatah le chingtah hi aphajoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu amachu songkul'a konin leng chang dingin ahungpot doh-in; hijongle ama lenggam sung mama-a peng khatchu ahung vaicha theije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman nisa noija kalsong hinna neiho jouse chu, ama khela lenga hung pangding cha ni lhinna chutoh kagah ngaito khomin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mipi jouse leh amaho masanga anaumho jouse kichaitih aumpoi; nunga hung dingho jong ama chunga kipah deh loudingu ahi. Tahbeh-in hiche jonghi pannabei le lungthim kisuhboina ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen in'a nache tengle nakeng kivet phatnin, chule mingol ho longlhenna thilpeh sangin thu ngai dingin kigo jingin umjon; ajehchu amahon thilse aboluve ti angaito phapouve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nakam tamsah hih-in, chule Pathen angsunga thilkhat phongdoh dingin nalung kino dahen; ajehchu van'a Pathen aumin, nangma leiset chunga uma nahi; hijeh chun nathu seidoh chu lhom sah-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ijeh inem itile kisah lelna tamtah jala mang umji ahin, chule mingol aw chu athu tamseija konin akihen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen henga kitepna khatna nakitep teng, peh ding ngongkai hih-in; ajehchu aman mingol ho-a kipana aneipoi; nathutep chu pe jengin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nakitepna pelouva naum sangin, nakitep louma apha jon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nakam chu natahsa chonsetsah nadingin phal hih-in; vantil masanga jong hichehi suhkhel ahi tin seihih in. Ipidinga Pathen chu na aw-soa lunghanga, nakhutsoh thilho asuh manghel dingham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu mang tamnale thu tamna-a chun pannabei tampi jong aumjie; ahinla nangman Pathen chu gingin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman gamsunga mivaichate kisuh gentheina, chule thutanlhahna le thudih pumhatna akibol namu-a ahile hichu datmo hih-in; ajehchu asang penpa sanga sang jopan akhohsah nan; chule amaho sanga sangjo aumnai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche chungchon chun leiset phatchomna hi mijouse dinga ahi, lengpa tah jengjong louma-a hinga ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dangka ngailupa chu dangka-a lunglhai joulou ding, ninglhin na ngailupa chu punbe na-a lunglhai louding ahi; hiche jonghi pannabei ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thil le lo apunbe teng, aneding jong apunben; chule chuche neiho dinga chu, amitnuva amu-u tilouva aphat chomna ipi umam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Tamtah nehen lhomcha nejongle natong gimpa imut chu anomin; ahinla mihaopa haosatna chun ama a-imut sahpon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman nisa noija thil phaloutah khat kamu aume; hichu haonahi aneipa kisuhkhah nadinga kikoija ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla chuche haonaho chu thoh hahsatna phaloutah jeh-in amangthah jin, chule aman chapa khat ahingin, chule imacha akhutna aumpoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amapa anu naobu-a kona ahungpot banga chu, ahung bang banga sagoh keova kile kitding, chule akhutna akichoi mang thei, atohgimna-a kona ima aki kenthei louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hiche jonghi thilsetah ahin, lamjouse-a ahung bang banga, kinungle cheh ding ahi. Chule ahomkeo dinga tonggimpan ipi phatchomna aneijem?
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman ahin nikho jousen muthim lah-a an anen, chule hesoh tampi, lungsatna tampi chu anatna to athoh than ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Veovin, keiman kamudoh hi; Pathen'in mihem khat apeh ahinkho lhumkeija; nisa noija atohgimna jouse-a, an aneh-a, twi adona, akipa thanop dinghi thil phatah le kilomtah ahi; ajehchu hichu ama chan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amitakip henga Pathen'in haona le neile gou apen; chule chuche-a kona chu neding le, achan kilah nading, chule atohgimna-a akipa theina dingin thaneina apen ahi; Hichehi Pathen thilpeh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ijeh inem itile aman ahinlai nikhoho chu hageldoh theiponte; ajehchu Pathen'in alungsung kipana-in adonbut tan ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nisa noija thilse khat keiman kamui; chule hichu mihemte lah-a umjing thil ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen'in mihem khat ahinan angaichat jouse imacha alhahsam louna dinga haosatna, neile gou, chule jana apen, ahijeng vangin Pathen'in chuche ho-a kona chu aneh theina ding tha apepon, ahinla gamdang min bou anen ahi. Hichehi pannabei, nat phaloutah ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihem khatnin cha jakhat hinghen lang, chule kum tampi hing hen, hitichun ahin nikhoho tamtah hihen lang, ahin ahinna chun thilpha-in lungkimna neihih hen, chule vui louvin jong umtaleh; keiman amapa sangchun aphat louva pen aphajoi kati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu ama pannabei to ahung lutnin, chule muthim lah-a achemang tan, chule aminchu muthimin akhukhum ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukal valin aman nisa anamu pon, imacha jong anahe poi; aman khatjopa sangin olna akimu joh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Henge, kum sangkhat nivei hing henlang, thilpha mu hihleh, mijouse abonchauva munkhatna checheh hilouham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihem tohgimna jousehi akamsung ding ahin, ahijeng vangin aduchat achim dehpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu michingin mingol ho sanga ipi atamnei deh em? ahing nalaiho masanga kalsonje he-a vaichaten, ipi aneideh em?
  </para>
  <para style="p">
    <verse number="9" style="v" />Gamtin ngaichat sangin, mitna mu joh chu aphajoi; hiche jonghi pannabei le lungthim kisuhgimna ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aumsa chu minvosa ahitan, chule hichu mihem ahije ti akihen; ama sanga thahatjo toh ama kitet theihoi ahideh poi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pannabei punsah-a thil tampi akimudoh tolhonin, mihem dinga hichu ipiham aphat chomna?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijeh inem itile mihem hinkhon nisa lim banga kitol mang loithei sung ajot laija, ama dia aphachom koijin ahetdoh ding ham? Ajeh chu ama athi nungle hiche nisa noija ipi ahungso ding koijin aseitheijem?
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Minphat hi thao mantam tah sangin aphajon; chule thi nikhohi pen nikho sangin aphajon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lunghemna in'a gachehi, golvahna in'a gache sangin aphajoi; ajehchu hiche chu mijouse hinkho kichaini ahin, chule ahing nalai chun alung sunga achin jing ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hesohna hi nuina sangin aphajoi; ajehchu lunghemna melput vangin lungsung semphat cheh in aum jie.
  </para>
  <para style="p">
    <verse number="4" style="v" />Miching lungsung chu lunghemna insunga aumin, ahinla mingol ho lungsung vang chu kipana inabou aum jie.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihem dinga michingin mi aphona jah chu, mingol lasah kijah sangin aphachom jon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu mingol nuigin chu linga belto kikhot gin poh lenglung tobang ahin; hiche jonghi pannabei ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tahbeh-in suhgentheina hin miching asungolin, chule nehguh thilpeh hin lungsung asusen ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thilkhat kichaina chu akipatna sangin aphajoi; chule lhagaova thohhat chu lhagaova kiletsah sangin aphajoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lunghang dingin nalungthima kino loihih-in, ajehchu lunghan hi mingol ho angsunga bou auma ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tulai sanga malai nikho ho aphatjoh chu ipi jeh hintem, tin nangman seihih-in; ijeh inem itile nangman hiche chung changhi chingthei tah-in nakhol pon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chihna hi gou kilo bangin dingin aphan; chule hiche jal hin nisa mute dingin phatchomna aume.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu sum hi kihon bitna ahibangin, chihna jonghi kihon bitna ahin; ahinla hetna achungchon na chu, chihna hin ama neiho chu hinna ape-in ahe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathen natoh hohi gah ngaiton, ajehchu aman akhonsa-a asem chu, kon ajansah thei dingham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Hamphat nikhon kipah thanomin, ahinla hahsat nikhole ngaiton; mihemin khonung leh amanunga imacha amudoh louna dingin, Pathen'in mihem khatjoh banga achom joh jong chu asem cheh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keiman pannabei nikhoho sunga hin imajouse kamusohtai. Midih khat achonphatna-a mangthah aumin, chule migilou khat agitlou vanga sottah hinga aumin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tamtah chunga kichon phatsah hih-in; chih jong kichihsah hih-in; ipidinga nangma nangle nang nakisuhset dingham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Phatlou bolval hih-in, ngoljong ngolval hih-in; ipidinga naphat masanga nathi jeng ding ham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichehi nangman nakimat khah a pha ahi; henge, nakhut jong hichea konchun loidoh hih-in: ajehchu amaho jouse lah-a kona Pathen ginga chu hungdoh teiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khopi sunga um mithahat som sangin, chihna hin miching athahatsah jon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu leiset chunga thilpha bolla, chonselou, midihtah khatcha aumpon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujongle thu kiseiho jousehi abonchan ngaikhoh hih-in, ajole nasohpan nasapsetna kijah getnin nate.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu chutobanga chu nangman jong midangho masapsetji chu nalung sungin ahe matchet jin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitiho jousehi keiman chihna-a kaphot chet ahitai. Keiman ching taveleng kanatin, ahinla chihna chu keija konin anagamla lheh-e.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gamlatah-a um, chule hathuh-a thuh chu, kon amudoh jou dingham?
  </para>
  <para style="p">
    <verse number="25" style="v" />Hetna dingle kholchil nading, chule chihna holdohna ding le thilho umjedan holdoh nading, ngolna phatlou dan hetdohna dingle ngolna le lung chatvaina hetdoh nadingin, keiman kalungthim kana mangchan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keiman alungsung Thangkol le Len ho ngen hia, chule akhut teni khaohol ho bangjeng, thina sanga khajo numei kamudoh-in ahi. Koi hileh Pathen lung lhaisahpa chu amanu-a kona hoidoh jouding, ahinla chonse vangchu amunun amat khahding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Veuvin, hiche hi kamudoh ahi, tin thuhilpan aseije: thil ahung kipat dan mudoh ahina dingin, khat khatnin kasimin;
  </para>
  <para style="p">
    <verse number="28" style="v" />Kahinnan ahol nahlai pentah chu keiman kamudoh poi. Sangkhat lah-a pasal khat kamudoh-in; ahinla amaho jouse lah-a chun keiman numei khat jengjong kamudoh poi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Veovin, hibouhi kamu doh-e, Pathen'in mihem dihtah-a asem ahin, ahinla amahon semdoh thu tamtah aholdoh-un ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Miching tobang ding koiham? chule thilkhat aledohna he-a koiham? mihem khatchu achihna-in amai avahsah-in; chule amai ngalna jongchu kikhel jengding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keiman, nangma kathumop nahi, Pathen'a nakitepna jalchun, lengpa thupeh chu chingtupmin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amitmua kona chedoh dingin kikinsah hih-in; thilse-a pang teitei hih-in; ajehchu aman adeichan chu aboljeng ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lengpa thu umna-a chun thahatna aumin; chule amahenga nangman ipi nabol ham tia seithei dinga koiham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Koi hileh ama thupeh nitchan chun thilse atolouding ahi; Chule michingpa lungthim chun phat le thu tanlhahna adatkhen theije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thil kigong jouse-a dingin phat le thutanlhahna aumcheh-in, hijeh chun mihem hamsetna hi amachunga lentah in aumjingin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh inem itile aman ipi ahung soding ahepoi; ajehchu itih phatna ahungso ding koijin ama aseipeh theidem?
  </para>
  <para style="p">
    <verse number="8" style="v" />Lhagao henden na dinga lhagao chunga tha neija mihem koimacha aumpon; thi nikhon jong aman thaneina aneideh poi. Chule hiche gal kisat sunga jong chun ontholna aumpon; khangit louna-in jong chuche-a kipelut hochu ahuhdoh louding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hicheho jousehi keiman kamutan, chule nisa noija thil kibol jouse gelnan kalungsung kamangchan; mikhatnin ama le ama kisuh khahna dinga midang khat chunga thunei phat khat aumjin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitichun keiman migilou akivui kamun, amaho chu munthenga kona hunglut uva potdoh-u ahin, chule amaho chu chutobang abolnao khopi sunga chun suhmilin aumun ahi. Hiche jonghi pannabei ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Natoh phalou chunga thu kitanlha chu gangtah-a tohdoh-a aumloujeh-in, mihem chapate lungsung chu thilse boldingin kigojou depmin aumjin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Michonse khatnin thilphalou jakhat veijen bolhen lang, chule ahin nikho kisaosah jongleh, Pathen ginga, ama anga gingkhen cha umho vang chun phatna amutei dingu ahi ti keiman kahei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla migilou dinga vang phalou helding ahi; ajehchu aman Pathen anga kichatna aneilou jeh-a, nilim tobang ahin nikhoho chu sao louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Leiset chunga pannabei ja kitongdoh thil aume; hichu mihem khat chu midih tah ahivanga, migiloute chunga thilsoh tobang achunga soh umin; chukitle, migilou tah ahivanga, michonpha te chunga thilsoh tobanga achunga soh aumin ahi. Hiche jonghi keiman pannabei ahije kati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin mihemin aneh-a, adona, chule nomtah-a aum sanga phajo nisa noija aneilou jeh-in, keiman nopsahna kalheng jotai. Ijeh inem itile Pathen'in nisa noija apeh ahinkho lhumkeija, hiche hi atoh gimna-a umjing ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keiman chihna hetna dingle, leiset chunga kin kitongdohho mun'a dinga kalungthim kimanchah phatnin; (ajehchu sun hile jan hijongle amitsing lou aume);
  </para>
  <para style="p">
    <verse number="17" style="v" />Keiman mihem khatnin nisa noija na kitonga kona amudoh joulou, Pathen natoh jouse chu kamun ahi. Ajehchu mihemin tonggim tah-in holdoh ding go jongle, amudoh louding ahin, chukal valin; miching khatnin het dingin ngaito jongle, aman amudoh joulouhel ding ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ajehchu hitiho jouse hi gah phondoh jeng dingin keiman kalungin kagelin, michonpha te le michingho chule anatoh houchu Pathen khutna um ahin; mihem koimachan amaho angsunga thil umho jouse jal-in kingailutna hile kihotna hile ahedoh thei pouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil jouse kibangin mijouse henga alhung cheh-e: michonpha le migilou chunga; apha chung le atheng chung chule athenglou chunga; ganlhai bolpa le ganlhai bol loupa chunga thilkhat alhung khom cheh-in ahi: michonse pa jong miphapa tobang ahin; chule akihahselpa jong kihahsel kichapa tobang ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nisa noija kitongdoh jouse lah-a hin ase khat aumin, mijouse henga thilsoh khat aumin ahi: Tahbeh-in mihem chapate lungsunghi setna-in adimsetnin, chule ahinlai jengun jong alungsung uva lung chatvaina aumin, chujouteng amaho athiho henga acheji taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla mihingho jousetoh kijopmat pa dingin kinepna aume; ajehchu uicha hingchu keipi bahkai athisa sangin aphachom jon ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh inem itile ahingho chun athidingu akihetnuve; ahinla athihon vang imacha akihet pouvin, amahon tohman jong anei tapouve. Ajehchu amaho suhmila um ahi taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujongle tu-a hi amaho mingailutna, mihotna, chule mi mitthipna chu manga ahitan; Nisa noija kitongdoh thil ipi hileh, amahon a-imatih chana dinga chan anei louvu ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chen, kipah thanomin na an kineh inlang, chule lungnom selin nalengpi twi kidonin; ajehchu tun Pathen'in nanatoh ho asangtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Naponsil ho chu bangleh jing jenghen; chule nalujanga jong thao lhasam hihhel hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen'in nisa noija napeh, pannabei nahinkho lhungkeijin, nangailu tah na-inneipi toh kipah thanomin chengkhom lhonin; ajehchu hichehi nahinkho sunga nisa noija nanatoh gimna-a nachan chu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ipi hijeng jongle nakhutnin tohdinga amaiphah chan chu, natha jesal teh-in tongin; ajehchu nangman najot jing lhankhuh asunga chun, tohding jong, tohgon jong, hetna jong, chihna jong aumtapoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keima kahung kile kitnin, nisa noija kamudoh tai: kilhaitet jong alhai ajangkhaipa-a ahipon, gal kisat jong ahatpa-a ahipon, changlhah jong michang pa-a ahipon, haona jong hetthemna neipa-a ahipon, khohsahna jong khut thempa-a ahipoi; Ahinla abonchauva dinga phat le phatpha kitoh khaji ahibouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu mihemin ama phat akihet theipoi: thina thei lenthang giloutah sunga ngaho akimat bangle, vachaho thangkol sunga oh bangin; hicheho chu photlot louva achunguva achuhteng, mihem chapate chu phat phalouva a-ohji taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche chihna jonghi keiman nisa noija kamu ahitan, hichehi keidin sangtah abange.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khopi neocha khat ana umin, chule asunga jong mi lhomcha anachenge; chuin leng lentah khat hiche khopi dou dingchun ahungin, aumkim veltan, chule pal nasatah tampi atungdoh tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun hiche khopi sunga chun mivaicha miching khat anaumin, amapan achihna jal-in hiche khopi chu ahuhdohtan ahi. Achuti jeng vangin koimachan chuche mivaichapa chu geldoh-in aneipoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichun keiman kanaseije, chihna hi thahat sangin aphajoi; ahijeng vanginla mivaichapa chihna chu i-sah louvin anaumin, chule athuseiho jong ngaipeh louvin aume.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mingol ho lah-a vaihompa khosap awgin sangin, michingho thusei chu thipbeh chan akingaipeh jon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chihna hi galmanchah tampi sangin aphachomjoi; ahinla michonse khatnin thilpha tampi asusen ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thousi thisahon thao namtui sempa thaonam a-uisah-in, chutobang chun ngolna themkhat-in achihna le aja umna jeh-a kijabolpa chu asuminsen ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Miching lungthim chu akhut jetna aumin, ahinla mingol lungthim chu aveilama aume.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mingol chu alampia akalsonteng jongle, achihna chun alosam sah-in; chule mijouse henga mingol kahi tin aseilen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vaihompa lungthim chu nangma douna-a ahung kipatdohle, nangman naum namun dalha hih-in, ajehchu kipehlutna hin suhkhelna lentah asemphan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vaihompa-a kona suhkhel hungdoh banga, keiman nisa noija thilse kamudoh aume:
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngolchon nahi jatah-in akikoi sangin; chule mihao chu mun nema atouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sakol ho chunga soh ho atouva, chule pipuiho tolla soh ho banga avaleu kamun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Koi hile khuh laija chu, akokhuh laija ama lhalut ding; chule koi hile tho kikai tumsepa chu, gul'in achuhding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koihile songho ladoh-a chu, chua chu kisukha ding; chule koihile thing chenna chu, chua chu kisukha ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Heicha chu amola, amangcha pa chun aha chu akinol hem loule, atha ahaje ding ahi; ahinla chihna hi lamhil dinga phatah ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tahbeh-a gul'in lhimlouva achuh pai bangin, kamtam jonghi aphat chomna aumpoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miching kamsoh thuchengho chu lungsetna ahin, hinla mingol kamsoh vang chun amatah aval lhum ding ahi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Akamsoh thubul hochu ngolna ngen ahin, ahoulim kichaina chu lung bulhinglou setna ngol thubuh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mingol jong chu thua dim ahi; mihemin ipi ahunglhun ding asei theipon, chule ama nunga ipi ahunglhung ding kon aseipeh theijem?
  </para>
  <para style="p">
    <verse number="15" style="v" />Mingol tohgimna chun amaho jouse asulung jing game; ajehchu aman khopisung jona iti che dingham ti ahepoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo gamsung, nalengpa chapang neocha ahia, chule napipui hon jingkah-a nehkhom na aneijule, ohe ada nahi!
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo gamsung, nalengpa chu milunlaiho chapa ahi-a, chule napipui hon khamna ding hilouva, thaneina dingjoh-a, aphatcha nehkhom na aneijule, anunnoma nahi!
  </para>
  <para style="p">
    <verse number="18" style="v" />Thaset behset jeh-in in angot lhajin, chule khut thaset vangin in alhujin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Golvah hi nuina dinga kibol ahin, chule ju hin mi akipa sah-in ahi; ahinla sumin thiljouse ahisah theijin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nalungthim jengin jong lengpa chu samse hih in; chule nalupna dansunga jong mihao samse hih-in: ajehchu chungleng vachan na aw po khan tin, chule lhaving neikhatnin athu galhut khante.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nachanglhah twi chunga seplhan; ijeh inem itile nikho tamtah jouteng namu kitding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi sagi henga, chule get henga jong chanvou pe-in; ajehchu nangman leiset chunga itobang thilse ahunglhun ding nahe poi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Meilomho go adimset tengle, amaho le amaho leiset chunga ahung kilhei-ong jiuve; chule thingphung chu lhanglam ngan, ahiloule sahlam ngan lhutaleh, alhuhna mun laitah-a chu, kijamden jengding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huinun vejing pa chun muchi atulouding, chule meilomho khohsah jing pa chun chang a-at louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman hui chena lampi nahetlou bangle, numei naovop sunga aguho iti khanlet ham nahetlou bangin; ijakai sema Pathen natoh ho jong nahepon ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jingkah lamle namuchi kitun, chule nilhah lam jongle nakhut umthimsah hih-in; ajehchu hichepa ham, khuchipa ham, hoichepen chu hung phatou dingham, ahiloule ania kibanga phading ham ti nangman nahepoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tahbeh-in vahhi anomin, chule mit dingin nisa vet hi anomta ngeije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijongle mihem chu kum tampi ahina, hicheho jouse-a chu akipa le; muthim nikhoho chu kigeldoh hen, ajehchu hicheho chu tamtah hiding ahi. Ahunglhung jouse chu pannabei ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo gollhang, nakhangdon na-a kipah-in; chule nakhangdon lai nikhon nalung thimin nakipasah jinghen, nalungin adeilam le namitnin amu nomna lam chu juijin; amavang thil hichengse jeh-a hi Pathen'in thupi tanna-a napuilut ding ahi, tihi nangman kihet nin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun nalungthima konin hesohna koidoh in, chule natahsa-a konin aphalou koimangin; ajehchu chapanlai le khangdonlai hi pannabei ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nikho phalouho hunglhun masang, hicheho-a hin thanopna himhim kaneipoi, tia nasei nading kum phalouho ahung nai masangin; tu nakhangdon lai nikho sunghin nasempa geldoh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nisa ahin, vah ahin, lha ahin, ahsi ho ahin, athimsoh masang, meilom ho jong gojuh jouva akilekit masang;
  </para>
  <para style="p">
    <verse number="3" style="v" />In ngahho kithing thinga ahung um nitengule, mihat ho amaho chama ahung kunlhah diu, sumhei hehhon alhom behseh jeh uva atoh-u angahdiu, chule bangkotna kona khodahho thimdela umdingu,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule khopi lamlena kot ho kha-a hung umding, sumhei kiheh gin anemsuh teng, chule mihem khat chu vacha husa-a hung thoudoh ding, chule lathem chanuho jouse suhnema hung umdingu ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujongle amahon munsang akichat tengule, kichatna lamtina hung umding, almond thing hung pahdoh ding, khao khopi chu pohgih hung hiding, chule ngaichat hungbei ding ahi. Ijeh inem itile mihemin atonsot in chu ajot ahin, chule lunghemho chu lamlhah ho-a acheleuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahiloule dangka khao ahung kilhap, ahiloule sana lheng ahung kisuhkeh masang, twinah phunga bel ahung kisukeh, ahiloule twikhuh phunga twikhai dohna kang ahungbal masangin, nasempa geldoh-in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuteng leivui chu ahina ngai leisetna kile kitding; chule lhagao chu apepa Pathen henga kilekit ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pannabei ho pannabei, ijakai pannabei ahije, tin thuhilpan aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule achungchonin, thuhilpa chu miching ahi jeh-in, miho chu hetna anahil nalaijin; henge, aman phatah-in alungin angaiton, aholdoh-in, chule thuchih tamtah asutoh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thuhilpan, santhei thuho, chondihna thu kisunho, thutah ho jengjong anaholdoh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miching thusei ho chu thihtul monghem tobang ahin; kelngoi chingpa khatnin apehdoh-a, khoppi lamkaihon akhet detnu thingkil tobang ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujongle, kachapa, hicheho-a hin kitil khouvin; lekha tamtah semsem jong achaina aumpon, chule lekha hasim behset jonghi tahsa cholna ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Eihon athu pumpi khumkhana chu ngaiju hite: Pathen gingin, chule athupeh chengse nitsoh keijin; ajehchu hichehi mihem tohding pumpi chu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Pathen'in nakitong jouse chu, thil kiselguh jouse toh, apha hihen ase hijongle, thupi tana-a ahin pohlut ding ahi.
  </para>
</usx>
