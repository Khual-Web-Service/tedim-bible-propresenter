<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CH" style="id">1 Thusimbu</book>
  <para style="h">1 Thusimbu</para>
  <para style="toc1">1 Thusimbu</para>
  <para style="toc2">1 Thusimbu</para>
  <para style="mt">1 Thusimbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Adam, Seth, Enosh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Kenan, Mahalalel, Jared;
  </para>
  <para style="p">
    <verse number="3" style="v" />Henoch, Methuselah, Lamech;
  </para>
  <para style="p">
    <verse number="4" style="v" />Noah, Shem, Ham, chule Japheth.
  </para>
  <para style="p">
    <verse number="5" style="v" />Japheth chapate chu: Gomer, Magog, Madai, Javan, Tubal, Meshech chule Tiras ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Gomer chapate chu: Ashkenaz, Riphath chule Togarmah ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Javan chapate chu: Elishah, Tarshish, Chittim chule Dodanim.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ham chapate chu: Cush, Mizraim, Put, Canaan ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cush chapate chu: Seba, Havilah, Sabtah, Raamah chule Sabtecha ahiuve. Chule Raamah chapate chu: Sheba le Dedan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Cush'in Nimrod ahingin; Amachu leisetna mihat masapen ahunghitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Mizraim'in Ludim, Anamim, Lehabim, Naphtuhim,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathrusim, Casluhim (ama-a kona Philistine te hungdoh ahi), chule Caphthorim ahinge.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Canaan'in chapa masapen Sidon, abana Heth,
  </para>
  <para style="p">
    <verse number="14" style="v" />Jebush miho, Amor miho, Girgas miho,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiv miho, Ark miho, Sin miho,
  </para>
  <para style="p">
    <verse number="16" style="v" />Arvad miho, Zemar miho, chule Hamath miho ahingin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shem chapate chu: Elam, Asshur, Arphaxad, Lud, Aram, Uz, Hul, Gether chule Meshech ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Arphaxad'in Shelah ahingin, Shelah'in Eber ahinge.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Eber'a konin cha pasal ni apengin, khatpa minchu Peleg ahi, ajehchu ama nikho laijin leiset ana kikhena ahi; chule asopipa minchu Joktan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Joktan'in Almodad, Sheleph, Hazarmaveth, Jerah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hadoram jong, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Ebal, Abimael, Sheba,
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Ophir, Havilah le Jobab ahingin ahi. Hichengse hi Joktan chapate ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shem, Arphaxad, Shelah;
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber, Peleg, Reu;
  </para>
  <para style="p">
    <verse number="26" style="v" />Serug, Nahor, Terah;
  </para>
  <para style="p">
    <verse number="27" style="v" />Abram; hichu Abraham ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham chapateni chu: Isaac le Ishmael ahilhone.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichehohi akhangguiju ahi: Ishmael chapa lenpen chu Nebaioth ahin, chejouchun Kedar, Adbeel, Mibsam,
  </para>
  <para style="p">
    <verse number="30" style="v" />Mishma, Dumah, Massa, Hadad, Tema,
  </para>
  <para style="p">
    <verse number="31" style="v" />Jetur, Naphish, chule Kedemah ahiuve. Hichehohi Ishmael chapate ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tun Abraham thaikem Keturah chapate chu: amanun Zimran, Jokshan, Medan, Midian, Ishbak, chule Shuah ahinge. Chule Jokshan chapateni chu: Sheba le Dedan ahilhone.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule Midian chapate chu: Ephah, Epher, Henoch, Abida chule Eldaah ahi. Hichehosehi Keturah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Abraham'in Isaac ahinge. Isaac chapateni chu Esau le Israel ahilhone.
  </para>
  <para style="p">
    <verse number="35" style="v" />Esau chapate chu: Eliphaz, Reuel, Jeush, Jalam chule Korah ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Eliphaz chapate chu: Teman, Omar, Zepho, Gatam, Kenaz, Timna chule Amalek ahiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reuel chapate chu: Nahath, Zerah, Shammah chule Mizzah ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Seir chapate chu: Lotan, Shobal, Zibeon, Anah, Dishon, Ezer chule Dishan ahiuve.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule Lotan chapateni chu: Hori le Homam ahilhonin, Timna chu Lotan sopinu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shobal chapate chu: Alian, Manahath, Ebal, Shephi, chule Onam ahiuve. Chule Zibeon chapateni chu Aiah le Anah ahilhone.
  </para>
  <para style="p">
    <verse number="41" style="v" />Anah chapa chu Dishon ahi. Chule Dishon chapate chu: Amran, Eshban, Ithran chule Keran ahiuve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ezer chapate chu: Bilhan, Zavan chule Jakan ahiuve. Dishan chapateni chu Uz le Aran ahilhone.
  </para>
  <para style="p">
    <verse number="43" style="v" />Israel chate chunga leng khatchan vai ahom masanga Edom gama analengchangte lengho chu tun hichehohi ahiuve. Beor chapa Bela ahin; chule akhopi minchu Dinhabah ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule Bela athiphatnin Bozrah'a um Zerah chapa Jobab ama khelin analeng change.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule Jobab athiphatnin Teman ho gama Husham ama khelin aleng changin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule Husham athiphatnin Bedad chapa Hadad, Moab phaija Midia ho joupa chu ama khelin aleng changin, chule akhopi minchu Avith ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule Hadad athiphatnin Masrekah'a um Samlah ama khelin aleng changin ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule Samlah athiphatnin vadung panga Rehoboth'a um Shual ama khelin analeng change.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule Shual athiphatnin Achbor chapa Baalhanan ama khelin aleng changin ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule Baalhanan athiphatnin ama khelin Hadad alengchange; chule akhopi min Pai ahi, chule ajinu minchu Mezahab chanu Matred chanu Mehatabel ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hada jong athitan ahi. Chule Edom leng noidouho chu: leng noidou Timna, leng noidou Aliah, leng noidou Pinon,
  </para>
  <para style="p">
    <verse number="52" style="v" />Leng noidou Aholibamah, leng noidou Elah, leng noidou Pinon,
  </para>
  <para style="p">
    <verse number="53" style="v" />Leng noidou Kenaz, leng noidou Teman, leng noidou Mibzar,
  </para>
  <para style="p">
    <verse number="54" style="v" />Leng noidou Magdiel, leng noidou Iram, hichehohi Edom leng noidouho ahiuve.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel chapate chu hichehohi ahiuve: Reuben, Simeon, Levi, Judah, Issachar, Zebulun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Dan, Joseph, Benjamin, Naphtali, Gad chule Asher.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah chapate chu: Er, Onan chule Shelah ahiuvin, amaho thum chu Canaan mi Shua chanu-a kona peng ahiuve. Judah chapa lenpen Er chu Pakai mitmun agilou lheh jengin, hitichun Pakaiyin athattan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amounu Tamar'in Pharez le Zerah ahinpeh-in ahi. Judah chapate chu abonun mi nga ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pharez chapateni chu Hezron le Hamul ahilhone.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerah chapate chu: Zimri, Ethan, Heman, Calkol chule Dara ahiuvin, abonun mi nga ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Carmi chapa chu Akar ahin, Israel sunohphah-a sapset thila suhkhel nei ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Ethan chapa chu Azariah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hezron'a kona hungpeng achapate chu: Jerahmeel, Ram chule Chelubai ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Ram'in Amminadab ahingin; chule Amminadab'in Judah chate pipu pa Nahshon ahingin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Nahshon'in Salma ahingin, chule Salma'in Boaz ahinge.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Boaz'in Obed ahingin, chule Obed'in Jesse ahingin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Jesse'in achapa peng masapen chu Eliab ahin, anina Abinadab, athumna Shimma,
  </para>
  <para style="p">
    <verse number="14" style="v" />Ali channa Nethaneel, anga channa Raddai,
  </para>
  <para style="p">
    <verse number="15" style="v" />Agup channa Ozem, asagi channa chu David ahinge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Asopiu numei teni minchu Zeruiah le Abigail ahilhone. Chule Zeruiah chapate chu: Abishai, Joab chule Asahel ahin, mi thum ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Abigail'in Amasa ahingin; chule Amasa pachu Ishmael mi Jether ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Hezron chapa Caleb'in ajinu Azubah le Jerioth'a konin chate ahingin, achapate chu: Jesher, Shobab chule Ardon ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Azubah athi phatnin Caleb in Ephrath akichenpi kitnin Hur ahinge.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hur'in Uri ahingin, chule Uri'in Bezaleel ahinge.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche nungchun Hezron Gilead pa Machir chanu henga ache-in, kum somgup ahinungin akichenpin; chule amanun Segup ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Segup'in Jair ahingin, aman Gilead gama khopi somni le thum aneije.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman amaho'a konin Geshur le Aram, Jair khopihotoh, chule Kenath toh akhopiho, khopi somgup jen alahpeh-in ahi. Hicheho jousehi Gilead pa Machir chapate-a ngen ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuche nunga Caleb-ephrathah mun Hezron'a athi phatnin, Hezron inneipi Abijah'in Tekoa pa Ashur chu ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hezron chapa masapen Jerahmeel sonho chapate chu apeng masapen Ram ahin, chule Bunah, Oren, Ozem le Ahijah ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jerahmeel'in jidang jong aneijin amin Atarah ahi: Amanuhi Onam nu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jerahmeel chapa masapen Ram chapate chu; Maaz, Jamin chule Eker ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Onam chapateni chu Shammai le Jada ahilhonin; chule Shammai chapateni Nadab le Abishur ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abishur inneipi min chu Abihail ahin, amanun Ahban le Molid ahinpeh-e.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nadab chapateni chu Seled le Appaim ahin, Seled vang chahing louvin athitan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Appaim chapa chu Ishi ahin; Ishi chapa chu Sheshan ahi. Chule Sheshan chapa chu Ahlai ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shammai sopipa Jada chapateni chu Jether le Jonathan ahilhone. Chule Jether chu chabeijin athitan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jonathan chapateni chu Peleth le Zaza ahilhone. Hichehohi Jerahmeel chapate ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tun Sheshan'in chanuho tailou cha pasal aneipon ahi. Chule Sheshan'in Egypt mi Jarha kiti soh khat aneijin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sheshan'in asohpa Jarha jidingin achanu apen, amanun Attai ahinpeh-e.
  </para>
  <para style="p">
    <verse number="36" style="v" />Attai'in Nathan ahingin, chule Nathan'in Jabad ahingin,
  </para>
  <para style="p">
    <verse number="37" style="v" />Jabad'in Ephlal ahingin, chule Ephlal'in Obed ahingin,
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed'in Jehu ahingin, chule Jehu'n Azariah ahingin,
  </para>
  <para style="p">
    <verse number="39" style="v" />Azariah'in Helez ahingin, chule Helez'in Eleasah ahingin,
  </para>
  <para style="p">
    <verse number="40" style="v" />Eleasah'in Sisamai ahingin, chule Sisamai'in Shallum ahingin,
  </para>
  <para style="p">
    <verse number="41" style="v" />Shallum'in Jekamiah ahingin, chule Jekamiah'in Elishama ahingin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tun Jerahmeel sopipa Caleb chapate chu: achapa masapen chu Mesha ahin, amachu Ziphte pa ahin; chule Hebron pa Mereshah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hebron chapate chu; Korah, Tappuah, Rekem chule Shema ahiuve.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shema'in Jorkeam pa Raham ahingin, chule Rekem'in Shammai ahinge.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shammai chapa chu Maon ahin; chule Maon chu Beth-zur pa ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Caleb thaikemnu Ephah'in Haran, Moza chule Gazez ahinge, chule Haran'in Gazez ahingin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Jahdai chapate chu; Regem, Jotham, Geshan, Pelet, Ephah chule Shaaph ahiuve.
  </para>
  <para style="p">
    <verse number="48" style="v" />Caleb thaikemnu Maachah'in Shebor le Tirhanah ahinge.
  </para>
  <para style="p">
    <verse number="49" style="v" />Amanun Madmannah pa Shaaph toh Machbenah pa Sheva chule Gibeah pa ahingin: chule Caleb chanu chu Achsah ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Caleb chilhah ho chu: Ephrathah chapa masapen Hur chapate, Kirjath-jearim pa Shobal,
  </para>
  <para style="p">
    <verse number="51" style="v" />Bethlehem pa Salma, chule Beth-gader pa Hareph ahiuve.
  </para>
  <para style="p">
    <verse number="52" style="v" />Kirjath-jearim pa Shobal'in chapate aneijin: Haroeh le Manaheth miho akehkhat ahiuve.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kirjath-jearim insungmiho chu Ithra miho, Puth miho, Shumath miho, chule Mishrai miho ahiuve: amaho-a konchun Zareath miho le Eshtaul miho ahungdoh uve.
  </para>
  <para style="p">
    <verse number="54" style="v" />Salma chapate chu; Bethlehem chule Netophah miho, Netophah miho, Joab insungmi Atroth, chule Manaheth mite akehkhat le Zor miho ahiuve.
  </para>
  <para style="p">
    <verse number="55" style="v" />Jabez'a cheng danthusunho insung mite chu; Tirath miho, Shimeath miho, chule Suchath miho ahiuve. Hicheho hi Rechab insung pa Hamath'a kona hungdoh Ken mite ahiuve.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichehohi David chapate Hebron'a pengho ahiuve: Acha masapen chu Amnon ahin, Jezreel numeinu Ahinoam'a kon ahi; anina Daniel ahin, Karmel numeinu Abigail'a kon ahin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Athum channa chu Geshur lengpa Talmai chanu Maachah chapa Absalom ahin, ali channa chu Haggith chapa Adonijah ahi:
  </para>
  <para style="p">
    <verse number="3" style="v" />Anga channa chu Abital chapa Shephatiah ahin; agup channa a-inneipi Eglah'in ahinpeh Ithream ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche guphohi Hebron'a peng ahiuvin; chule ama hia chun kum sagi le lhagup alengchange. Chule ama Jerusalem'a kum somthum le kumthum aleng changin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Ammiel chanu Bath-shua'in Jerusalem'a ahin achapate li hochu: Shimea, Shobab, Nathan chule Solomon ahiuve:
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujongle Ibhar, Elishama chule Eliphelet,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Nogah, Nepheg le Japhia,
  </para>
  <para style="p">
    <verse number="8" style="v" />Elishama, Eliada chule Eliphelet, mi ko ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichengsehi athaikemho chapate tilouvin David chapate ngen ahiuvin, chule asopinu-u Tamar toh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Solomon chapa chu Rehoboam ahin, Rehoboam chapa chu Abia ahin, Abijah chapa chu Asa ahin, Asa chapa chu Jehoshaphat ahin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Jehoshaphat chapa chu Joram ahin, Joram chapa Ahaziah ahin, Ahaziah chapa chu Joash ahin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Joash chapa chu Amajiah ahin, Amajiah chapa Azariah ahin, Azariah chapa chu Jotham ahin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Jotham chapa chu Ahaz ahin, Ahaz chapa chu Hezekiah ahin, Hezekiah chapa chu Manasseh ahin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh chapa chu Amon ahin, Amon chapa chu Josiah ahin,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Josiah chapate apeng masapen chu Johanan, anina Jehoiakim, athum channa Zedekiah, ali channa chu Shallum ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Jehoiakim chapateni chu: Jeconiah le Zedekiah ahilhone.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Jeconiah chapate chu; Assir, achapa Salathiel,
  </para>
  <para style="p">
    <verse number="18" style="v" />Malchiram, Pedaiah, Shenazar, Jekamiah, Hoshama chule Nedabiah ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Pedaiah chapateni chu Zerubbabel le Shimei ahilhonin; chule Zerubbabel chapateni chu Meshullam le Hananiah ahilhonin, asopinulhon chu Shelomith ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Hashubah, Ohel, Berechiah, Hasadiah chule Jushabhesed mi nga ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hananiah chapate chu Pelatiah le Jesaiah ahin, Rephaiah chapate, Arnan chapate, Obadiah chapate, Shechaniah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Shechaniah chapa chu Shemaiah ahin, Shemaiah chapate chu Hattush, Igeal, Bariah, Neariah chule Shaphat, mi gup ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Neariah chapate chu Elioenai, Hezekiah chule Azrikam, mi thum ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Elioenai chapate chu Hodaiah, Eliashib, Pelaiah, Akkub, Johanan, Delaiah chule Anani, mi sagi ahiuve.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah chapate chu; Perez, Hezron, Carmi, Hur chule Shobal ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shobal chapa Reaiah'in Jahath ahingin, chule Jahath'in Ahumai le Lahad ahinge. Hichehohi Zorath miho insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hichehohi Etam pa chapate ahi: Jezreel, Ishma chule Idbash ahiuvin, asopinu-u minchu Hazzelelponi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Gedor pa Penuel le Hushah pa Ezer toh, hichehohi Bethlehem pa Ephrathah cha masapen Hur chate ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Tekoa pa Ashhur'in ji ni, Helah le Naarah aneijin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naarah'in Ahuzzam, Hepher, Temeni chule Haahashtari ahinpeh-in ahi. Hichehohi Naarah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Helah chapate chu Zereth, Zerer chule Ethnan ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Coz'in Anub, Zobebah le Harum chapa Aharhel insung mite ahinge.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jabez vangchu asopi dangho sangin ja aumpenin, anun lung hesoh puma kavop ahi atijeh-a amin Jabez asah ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jabez Pathen henga ataovin, O, nangman phatthei neiboh teiding hihen lang, kagamsung nasuh letna, nakhut chu kakoma umjinga, thilphalouvin eilungdon sahlou nadinga hiche-a kona chu neihuhdoh ding hitavele! ati. Hichun Pathen'in angeh chu aphal pehtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Shuah sopipa Chelub'in Eshton pa Mehir ahingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Eshton'in Beth-rapha, Paseah chule Irnahash pa Tehinnah ahinge, hichehohi Rekah mite ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kenaz chapateni chu: Othniel le Seraiah ahilhone; chule Othniel chapa chu Hathath ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meonothai'in Ophrah ahingin, Seraiah'in Charashim phaicham semdohpa Joab ahinge. Amahohi khutthem mi ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jephunneh chapa Caleb chapate chu: Iru, Elah chule Naam ahiuvin; chule Elah chapa chu Kenaz ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jehalelel chapate chu: Ziph, Ziphah, Tiria chule Asareel ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ezrah chapate chu: Jether, Mered, Epher chule Jalon ahiuvin; chule Mered inneipin Miriam, Shammai chule Eshtemoa pa Isbah ahinge.
  </para>
  <para style="p">
    <verse number="18" style="v" />A-inneipi Jehudijah chun Gedor pa Jered, Socho Pa Heber, chule Zanoah pa Jekuthiel ahingin ahi. Hichehohi Mered'in akichenpi Pharaoh chanu Bithiah chapate hochu ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Naham sopinu Hodiah inneipi chapate chu; Garm mite pa Keilah ahin, chule Eshtemoa mite pa Maachath ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shimon chapate chu: Amnon, Rinnah, Ben-hanan chule Tilon ahiuvin; chule Ishi chapateni chu Zoheth le Benzoheth ahilhone.
  </para>
  <para style="p">
    <verse number="21" style="v" />Judah chapa Shelah chapate chu: Lecah pa Er, Mareshah pa Laadah, chule Ashbea inkon tupat ponnem khong insung miho,
  </para>
  <para style="p">
    <verse number="22" style="v" />Jokim le Chozeba mite, Joash, Moab gam chunga thuneina ananei Saraph, chule Jashubi-lahem ahiuve. Tun hichehohi khanglui thu ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichehohi beldengho ahiuvin, amaho chu thingbil lah-a achengun; hiche mun'a chu lengpa natong dinga cheng ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simeon chapate chu: Nemuel, Jamin, Jarib, Zarah chule Shaul:
  </para>
  <para style="p">
    <verse number="25" style="v" />Achapa Sahllum, achapa Mibsam, chule achapa Mishma ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mishma chapate chu: achapa Hamuel, achapa Zaccur, achapa Shimei ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shimei'in chapa somlegup le chanu aneije, ahivangin asopihon cha tampi aneipouve, Judah chate bangin a-insung miteu apungpon ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho Beersheba, Moladah, chule Hazarshual'ah achengun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bilhah, Ezem chule Toladah,
  </para>
  <para style="p">
    <verse number="30" style="v" />Bethuel, Hormah, chule Ziklag'ah,
  </para>
  <para style="p">
    <verse number="31" style="v" />Bethmarcaboth, Hazarsusim, Bethbirei, chule Shaaraim'a jong achengun ahi. Hicheho chengsehi David lengchan geija akhopihou ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule akhohou chu; Etam, Ain, Rimmon, Tochen chule Ashan, khopi len nga ahin;
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuche Baal changeija khopilenho kimvela um khoho jouse ahi. Hichehohi achennao chule akhangguiju ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Meshobab, Jamlech le Amaziah chapa Joshah,
  </para>
  <para style="p">
    <verse number="35" style="v" />Joel le Joshibiah chapa Jehu, Seraiah chapa, Asiel chapa,
  </para>
  <para style="p">
    <verse number="36" style="v" />Elioenai, Jaakobah, Jeshohaiah, Asaiah, Adiel, Jesimiel chule Benaiah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Shiphi chapa Ziza, Allon chapa, Jedaiah chapa, Shimri chapa, Shemaiah chapa:
  </para>
  <para style="p">
    <verse number="38" style="v" />Hiche amin kikut hohi a-insunguva pipui ngenchang ahiuve, chule apu apateu insung chu ahapun lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Agan honu lhatnading holin solam phaicham langsang Gedor lutna mun geijin acheuvin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hitichun gan hon lhatnading mun phatah, nehding hamhing tamna, gam lentah, munthip le gamhoina mun agamudoh-un ahi; ajehchu masanga chu hiche munna chu Ham mite anacheng uva ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hiche amin kisunlut hohi Judah lengpa Hezekiah nikho laijin ahungun, aponbuh hou asuseuvin, chuche munna anachengho chu tunichan geijin asugam helun, amaho munna chun acheng taove: ajehchu chuche munna chu agan honu lhatnading hamhing mun uma ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Alah uva Simeon chapate ngeija kon mi janga chu, Ishi chapate Pelatiah, Neariah, Rephaiah le Uzziel lamkaina-in Seir molsanga acheuvin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule amahon ahoidoh Amalek mite amohse chu asatgamun, hitichun tunichan geijin chuche munna chun achengden taove.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Israel cha masapen Reuben chapate chu, ama chu (cha masapen hijeng jongle, apa jalkhun asuhboh tahjeh-in upa hina chu Israel chapa Joseph chapate chu kipe ahitan; chule akhanggui thu chu upa hina dungjuija kisut talou ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin Judah chu asopite sangin achung nungin, hitichun ama-a konin vaipo pipu ahungkon doh-in: ahivangin upa hina chu Joseph'a hijaa hi.)
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel cha masapen Reuben chapate chu: Hanoch, Pallu, Hezron chule Karmi ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joel chapate chu: achapa Shemaiah, achapa Gog, achapa Shimei,
  </para>
  <para style="p">
    <verse number="5" style="v" />Achapa Micah, achapa Reaiah, achapa Baal,
  </para>
  <para style="p">
    <verse number="6" style="v" />Achapa Beerah, ama chu Assyria lengpa Tilgath-pilneser in gal hinga akaimangpa ahin; Reuben mite lamkaipa ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Akhangu khanggui thu akisutlaija a-inko ko-a asopihou lah-a pipui chu Jeiel le Zekeriah,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Aroer, Nebo le Baalmeon geija cheng Joel chapa, Shema chapa, chule Azaz chapa Bela ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amaho chu solamsang Euphrates vadunglen'a pat gamthip ma lutnachan geijin anachengun ahi. Ajehchu Gilead gama chu agancha honu punglheh jenga ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Saul damlaijin Hagar mite toh akidouvun, amaho chu anajouvun, Gilead solam sese-a aponbuh uva anachengun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Gad chu Bashan gamsunga Salcah changeijin amahotoh akigalsaijin achenge.
  </para>
  <para style="p">
    <verse number="12" style="v" />Apipuiju chu Joel ahin, aban Sapham chule Bashan, Jaanai le Shaphat ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Apu apateu insunga asopihou chu: Michael, Meshullam, Sheba, Jorai, Jachan, Zia chule Heber; mi sagi ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichehohi Buz chapa, Jahda chapa, Jeshishai chapa, Michael chapa, Gilead chapa, Jaroah chapa, Hur chapa, Abihail chate ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Guni chapa, Abdiel chapa Ahi hi apu apateu insunga pipupen ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amahohi Bashan gama Gilead le akhopihou, chule Sharon kimvel changeijin achengun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hicheho sesehi Judah lengpa Jotham nikholai le Israel lengpa Jeroboam nikholaija akhanggui thubu houva ana kisun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Reuben chapate le Gad mite chule Manasseh phung kehkhat, mihang cheh, chemjam le lum thothei, thal kapthem le galdou them, galla kontheiho chu sangsomli le sangli le jasagi le somgup ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahohin Hagar mite, Jetur, Naphish chule Nodab chunga gal abolun,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amaho douna-in panpi achangun, Hagar mite le apankhompi jouse chu akhutnuva akipelut taove: ajehchu kidouna munna Pathen akou jeh uva aman ataonao asanpeh ahi. Ajehchu amahon Ama-a atahsanao angamun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun aganchahou, asangonsangu sangsomnga, kelngoi sangjani le sangsomnga, sangan sangni, chule mihem sangjakhat akai mangun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kidouna chu Pathen'a ahijeh-in mitamtah athiuvin ahi. Chule amaho gal hinga akikaimang kahseuvin agamuvah chun acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Manasseh phung kehkhat chate chu chua chun anachengun; Bashan'a kipat Baal-hermon le Senir chule Hermon mol geijin anapunguve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hichehohi apu apateu insunga apipupen cheh ahiuve: Epher, Ishi, Eliel, Azriel, Jeremiah, Hodaviah chule Jahdiel, amahohi mihatle hangsan, mi minthang le apu apateu insunga aluchang cheh ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amaho apu apateu Pathen douna-in achonkhelun, amaho masanga Pathen'in anasuh mangsa, chuche gama miho pathenho chu ajon thanghoipi taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh chun Israel Pathen'in Assyria lengpa Pul, hichu Assyria lengpa Tilgath-pilneser ahin; amachu ahintildoh-in, aman Reuben mite, Gad mite chule Manasseh phung kehkhat chu gal hingin akaijin; Halah, Habor, Hara chule Gozan vadunglen geijin ahinpuijin, tunigeijin achengden taove.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Levi chapate chu: Gershom, Kohath chule Merari ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kohath chapate: Amram, Izhar, Hebron chule Uzziel ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Amram chate chu: Aaron, Mosi chule Miriam ahiuve. Aaron chapate jong chu: Nadab, Abihu, Eleazar chule Ithamar.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eleazar'in Phinehas ahingin, Phinehas'in Abishua ahingin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Abishua'in Bukki ahingin, Bukki in Uzzi ahingin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Uzzi'in Zerahiah ahingin, Zerahiah'in Meraioth ahingin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Meraioth'in Amariah ahingin, Amariah'in Ahitub ahingin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahitub'in Zadok ahingin, Zadok'in Ahimaaz ahingin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahimaaz'in Azariah ahingin, Azariah'in Johanan ahingin,
  </para>
  <para style="p">
    <verse number="10" style="v" />Johanan'in Azariah ahinge, (amahi Jerusalem'a Solomon'in asah houin'a thempu tohmun hintongpa chu ahi.)
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Azariah'in Amariah ahingin, Amariah in Ahitub ahingin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahitub'in Zadok ahingin, Zadok'in Shallum ahingin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Shallum'in Hilkiah ahingin, Hilkiah'in Azariah ahingin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Azariah'in Seraiah ahingin, Seraiah'in Jehozadak ahingin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Pakaiyin Judah le Jerusalem Nebuchadnezzar khutna akaimang laichu Jehozadak hi gal hinga kikai ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Levi chapate chu: Gershom, Kohath chule Merari ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Gershom chapateni minchu Libni le Shimei ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath chapate chu: Amram, Izhar, Hebron chule Uzziel ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari chapateni chu: Mahli le Mushi ahilhone. Chule hichehohi apu apateu dungjuija Levi insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gershom'a konin achapa Libni, achapa Jahath, achapa Zimmah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Achapa Joah, achapa Iddo, achapa Zerah, achapa Jeaterai apengin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kohath chapate chu: achapa Amminadab, achapa Korah, achapa Assir,
  </para>
  <para style="p">
    <verse number="23" style="v" />Achapa Elkanah, achapa Ebiasaph, achapa Assir,
  </para>
  <para style="p">
    <verse number="24" style="v" />Achapa Tahath, achapa Uriel, achapa Uzziah, chule achapa Shaul ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Elkanah chapate chu: Amasai le Ahimoth ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Elkanah ahile; Elkanah chapate chu: achapa Zophai, achapa Nahath,
  </para>
  <para style="p">
    <verse number="27" style="v" />Achapa Eliab, achapa Jeroham, achapa Elkanah ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Samuel chapateni chu: Apeng masa Vashni le Abiah ahilhone.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari chapate chu: Mahli, achapa Libni, achapa Shimei, achapa Uzzah,
  </para>
  <para style="p">
    <verse number="30" style="v" />Achapa Shimea, achapa Haggiah, achapa Asaiah ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule hichehohi David'in Kitepna thingkhong akikoihe nunga Pakai houin'a la lama natohna neidinga akoiho chu ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Jerusalem'a Solomon'in Pakai houin asah masangsen houkhom ho houbuh umna masanga chun amahon la asajiuvin, atohding kinu chu aban banin atong jiuvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hichehohi achateu toh kinbola pangho ahiuve. Kohath miho chapate-a kon: lathempa Heman, Heman hi Joel chapa, Shemuel chapa,
  </para>
  <para style="p">
    <verse number="34" style="v" />Elkanah chapa, Jeroham chapa, Eliel chapa, Toah chapa,
  </para>
  <para style="p">
    <verse number="35" style="v" />Zuph chapa, Elkanah chapa, Mahath chapa, Amasai chapa,
  </para>
  <para style="p">
    <verse number="36" style="v" />Elkanah chapa, Joel chapa, Azariah chapa, Zephaniah chapa,
  </para>
  <para style="p">
    <verse number="37" style="v" />Tahath chapa, Assir chapa, Ebiasaph chapa, Korah chapa,
  </para>
  <para style="p">
    <verse number="38" style="v" />Izhar chapa, Kohath chapa, Levi chapa, Israel chapa ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule ajet lama ding chu asopipa Asaph ahin, Asaph hi Berechiah chapa, Shimea chapa,
  </para>
  <para style="p">
    <verse number="40" style="v" />Michael chapa, Baaseiah chapa, Malchiah chapa,
  </para>
  <para style="p">
    <verse number="41" style="v" />Ethni chapa, Zerah chapa, Adaiah chapa,
  </para>
  <para style="p">
    <verse number="42" style="v" />Ethan chapa, Zimmah chapa, Shimei chapa,
  </para>
  <para style="p">
    <verse number="43" style="v" />Jahath chapa, Gershom chapa, Levi chapa ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule veilama ding chu asopi Merari chapate lah-a kon Kishi chapa Ethan ahin, Kishi hi Abdi chapa, Malluch chapa,
  </para>
  <para style="p">
    <verse number="45" style="v" />Hashabiah chapa, Amaziah chapa, Hilkiah chapa,
  </para>
  <para style="p">
    <verse number="46" style="v" />Amzi chapa, Bani chapa, Shemer chapa,
  </para>
  <para style="p">
    <verse number="47" style="v" />Mahli chapa, Mushi chapa, Merari chapa, Levi chapa ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule asopiteu Levi mite dangho chu Pathen in Houbuh-a tohding tincheng tong dinga kipansah ahiuve.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ahivangin Pathen'in alhacha Mosi ana thupeh jouse dungjuijin Aaron le achapate chun maicham chunga govam thilto atoh-un, gimnamtui ahalun, muntheng chungnunga tohding jouse tongding le, Israel dinga longlhena bolpeh dinga pansah ahiuve.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule hichehohi Aaron chapate ahiuve: achapa Eleazar, achapa Phinehas, achapa Abishua,
  </para>
  <para style="p">
    <verse number="51" style="v" />Achapa Bukki, achapa Uzzi, achapa Zerahiah,
  </para>
  <para style="p">
    <verse number="52" style="v" />Achapa Meraioth, achapa Amariah, achapa Ahitub
  </para>
  <para style="p">
    <verse number="53" style="v" />Achapa Zadok, achapa Ahimaaz ahiuve.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tun hichehohi Kohath mite insung miho, Aaron chapate agamsung hop sunga achennao ahi. Ajehchu hichehi achannu ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chule amaho chu Judah gamsunga um Hebron le khopipam kimvel sese anapeuve.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ahinla khopi naija gamho le khoneoho chu Jephunneh chapa Caleb anapeuvin ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chule Aaron chapate chu Judah khopiho, hoidohna khopi Hebron, Libna le khopi kimvel, chule Jattir le Eshtamoa le akhopi kimvel ho sese toh anapeuve.
  </para>
  <para style="p">
    <verse number="58" style="v" />Chule Hilen le akhopi kimvel ho, chule Debir le khopi kimvel ho,
  </para>
  <para style="p">
    <verse number="59" style="v" />Ashan le akhopi kimvel ho, chule Bethshemesh le akhopi kimvel sese anapeuve.
  </para>
  <para style="p">
    <verse number="60" style="v" />Chule Benjamin phunga konin: Geba le akhopi kimvel ho, Alemeth le akhopi kimvel ho, chule Anathoth le akhopi kimvel ho sese anapeuve. A-insung pumpiuva akhopihou chu khopi somlethum ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chule Kohath phunga chapa dangho chu, Manasseh chapate phung akehkhatna konin vang sanin khopi som apeuvin ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chule Gershom chapate chu a-insungu dungjuijin Issachar phunga kon, Asher phunga kon, Naphtali phunga kon chule Bashan'a Manasseh phunga konin khopi somlethum apeuve.
  </para>
  <para style="p">
    <verse number="63" style="v" />Merari chapate henga chun a-insungu dungjuile vangkivet dungjuijin Reuben phunga kon, Gad phunga kon, chule Zebulun phunga konin khopiho somleni akipen ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Israel chaten hiche khopi somleni hohi akhopiu kimvel ho pumin Levi mite anapeuve.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chule vangvet na-in Judah chate phunga kon, Simeon chate phunga kon, chule Benjamin chate phunga kon, hiche aminuva kivo khopihohi anapeuvin ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chule Kohath chapate insung mi amohho chun Ephraim phunga konin gam le khopilen aneijuvin ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Chuin amahon amaho chu Ephraim molsanga hoidohna khopi Shechem chu akhopi kimvel ho to apeuvin, chule Gezer le akhopi kimvel ho,
  </para>
  <para style="p">
    <verse number="68" style="v" />Jokmeam le akhopi kimvel ho, chule Beth-horon le akhopi kimvel ho,
  </para>
  <para style="p">
    <verse number="69" style="v" />Aijalon le akhopi kimvel ho, chule Gathrimmon le akhopi kimvel sese apeuvin ahi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Manasseh phung kehkhatna konin, Kohath chapate insung amoh ho-a dingin Aner le akhopi kimvel ho, Bileam le akhopi kimvel sese apeuve.
  </para>
  <para style="p">
    <verse number="71" style="v" />Manasseh phung kehkhat insungho-a kona Gerahom chapate kipe chu Bashan'a um Golan le akhopi kimvel ho, chule Ashtaroth le akhopi kimvel sese ahi.
  </para>
  <para style="p">
    <verse number="72" style="v" />Issachar phunga konin Kedesh le akhopi kimvel ho, Daberath le akhopi kimvel ho,
  </para>
  <para style="p">
    <verse number="73" style="v" />Ramoth le akhopi kimvel ho, Anem le akhopi kimvel sese apeuvin:
  </para>
  <para style="p">
    <verse number="74" style="v" />Chule Asher phunga konin Mashal le akhopi kimvel ho, Abdon le akhopi kimvel ho,
  </para>
  <para style="p">
    <verse number="75" style="v" />Hukok le akhopi kimvel ho, chule Rehob le akhopi kimvel sese apeuvin ahi.
  </para>
  <para style="p">
    <verse number="76" style="v" />Chule Naphtali phunga konin Galilee gama um Kedesh le akhopi kimvel ho, Hammon le akhopi kimvel ho, chule Kirjathaim le akhopi kimvel sese apeuvin ahi.
  </para>
  <para style="p">
    <verse number="77" style="v" />Zebulun phunga kona Merari chate amohchengse henga kipe chu Rimmon le akhopi kimvel ho, Tabor le akhopi kimvel sese ahi.
  </para>
  <para style="p">
    <verse number="78" style="v" />Chule Reuben phunga kona amaho kipedoh chu Jordan gal langkhat Jericho kom Jordan solamsang gamthipma um Bezer le akhopi kimvel ho, chule Jahzah le akhopi kimvel ho,
  </para>
  <para style="p">
    <verse number="79" style="v" />Kedemoth le akhopi kimvel ho, chule Mephaath le akhopi kimvel sese ahi.
  </para>
  <para style="p">
    <verse number="80" style="v" />Chule Gad phunga kon Gilead'a um Ramoth le akhopi kimvel ho, chule Mahanaim le akhopi kimvel ho,
  </para>
  <para style="p">
    <verse number="81" style="v" />Chule Heshbon le akhopi kimvel ho, chule Jazer le akhopi kimvel sese apeuvin ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Issachar chapate chu: Tolla, Pu-ah, Jashub chule Shimron, mi li ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Tolla chapate chu: Uzzi, Rephaiah, Jeriel, Jahmai, Jibsam chule Shemuel, Tolla sonho apu apateu insunga luchang cheh ahiuvin; akhanguva mihat le mihangsan cheh ahiuve: David nikholaijin amijatnu chu sangsomni le sangni le jagup alhinguve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Uzzi chapa chu Izrahiah ahin chule Izrahiah chapate chu: Michael, Obadiah, Joel, Isshiah, mi nga ahiuvin, abonchauvin pipui jeng ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amaho le akhanguva chu, apu apateu insung dungjuija galdouthei sepaihon ngen ahiuvin, mi sangsomthum le sang gup ahiuve: ajehchu amahon ji tamtah tah le chapa tamtah tah aneiju ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Issachar insung mite jouse lah-a asopiteu chu mihat mihangsan cheh ahiuvin, akhangthu sutna dungjuija sutnin abonun sangsomget le sangsagi ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benjamin chapate chu: Bela, Becher chule Jediael, mi thum ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Bela chapate chu: Ezbon, Uzzi, Uzziel, Jerimoth chule Iri, mi nga ahiuvin; apu apateu insunga luchang cheh, mihat mihangsan ngen ahiuve;, akhangguithu sutna dungjuijin sangsomni le sangni le somthum le li ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Becher chapate chu: Zemira, Joash, Eliezer, Elioenai, Omri, Jeremoth, Abijah, Anathoth chule Alemeth ahiuvin, hicheho chenghi Becher chapate ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amijatnu, akhangu khanggui thu kisutna dungjuijin apu apateu insunga luchang cheh, mihat mihangsan cheh sangsomni le jani ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jediael chapa jong chu Bilhan ahin; chule Bilhan chapate: Jeush, Benjamin, Ehud, Chenaanah, Zethan, Tarshish chule Ahishahar ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichehohi Jediael chapate, apu apateu insunga luchang chehho sima mihat mihangsan cheh sangsom le sangsagi le jani ahiuvin, galmuna galsatna konthei cheh ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shuppim le Huppim chu Ir chapateni ahin, chule Hushim chu Aher chapa ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naphtali chapate chu: Jahziel, Guni, Jezer chule Shallum ahin, Bilhah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh chapa chu Asriel ahin, amahi athaikemnu Aram numei nun ahinpeh ahi; (amanuhin Gilead pa Machir jong ahinge.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Machir'in Huppim le Shuppim sopinu Maakah chu ji in aneije;) chule anichanna pa chu Zelophehad ahin, chule Zelophehad'in chanu jengbou aneijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Machir inneipi Maakah'in chapa khat ahingin, amanun amin Peresh asah-in ahi; chule asopipa minchu Sheresh ahin, chule achapateni chu Ulam le Rakem ahilhone.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ulam chapa chu Bedan ahi. Hichehohi Manasseh chapa Machir, Machir chapa Gilead chapate ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule asopinu Hammoleketh in Ishod, Abiezer chule Mahalah ahingin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shemida chapate chu Ahian, Shechem, Likhi chule Aniam ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim chapate chu: Shuthelah chule achapa Bered, achapa Tahath, achapa Eladah, achapa Tahath,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule achapa Zabad, achapa Shuthelah, chule achapa Ezer le Elead, aganchahou gudinga ahungsuh jeh lhona agama peng Gath mihon anatha teniu chutoh ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun apau Ephraim chun nitamtah alunghempi-in, hijeh chun asopite ama lhamon dingin ahunguvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin ama a-inneipi henga alutnin, amanun nao ahinvop min, chule chapa khat ahingin a-insunga thilse aumtahjeh-in amin Beriah asahtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />(Chule achanu Sherah ahin, Beth-horon noinung le chungnung chule Uzzen-sherah sadohnu ahi).
  </para>
  <para style="p">
    <verse number="25" style="v" />Achapa Rephah ahin, Resheph jong ahin, Resheph chapa Telah chule Tahah chapa Tahan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tahan chapa Laadan, Laadan chapa Ammihud, Ammihud chapa Elishama,
  </para>
  <para style="p">
    <verse number="27" style="v" />Elishama chapa Nun, Nun chapa Joshua ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule aneiju le achennahou chu Bethel le akhopihose, solam sanga Naaran, lhumlama Gezer le akhopihose toh, Shechem le akhopiho, chule Gaza le akhopiho changei ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Manasseh chapate gamgi china um Bethshean le akhopise, Taanach le akhopise, Megiddo le akhopise Dor chule akhopise ahi. Hicheho ahin Israel chapa Joseph chate achengun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Asher chapate chu: Imnah, Ishuai, Ishuai, Beriah chule asopinu-u Serah ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Beriah chapateni chu Heber le Birzavith pa Malchiel ahilhone.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Heber'in Japhlet, Shomer, Hotham chule asopinu-u Shua ahingin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule Japhlet chapate chu: Pasach, Bimhal chule Ashvath ahiuve. Amahohi Japhlet chate ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shemer chapate chu: Ahi, Rohgah, Jehubbah chule Aram ahiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule asopipa Helem chapate chu Zophah, Imna, Shelesh chule Amal ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zophah chapate chu: Suah, Harnepher, Shual, Beri, Imrah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Bezer, Hod, Shamma, Shilshah, Ithran chule Beera ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Jether chapate chu: Jephunneh, Pispah, chule Ara ahiuve.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule Ulla chapate chu: Arah, Hanniel chule Rezia ahiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hicheho chengsehi Asher chate, apu apateu insung luchang cheh, lhendoh le mihat mihangsan ngen, lamkai pipui cheh ahiuve. Chule akhanggui thu apumpia kisutna dungjuija galdouna-a gala konthei chu mi sangsomni le sang gup ahiuve.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Benjamin'in acha masa Bela, anina Ashbel, athumna Aharah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Alichana Nohah, chule anga chana Rapha ahinge.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Bela chapate chu: Addar, Gera, Abihud,
  </para>
  <para style="p">
    <verse number="4" style="v" />Abishua, Naaman, Ahoah,
  </para>
  <para style="p">
    <verse number="5" style="v" />Gera, Shephuphan chule Huram ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hichehohi Ehud chapate ahiuvin: Geba'a chengho pate luchang cheh ahiuvin, chule amahon amaho chu Manahath'a atolmangun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Naaman, Ahiah, chule Gera, amahohi atolmangin, chuin Uzza le Ahihud ahingin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Shaharaim'in ajiteni Hushim le Beera asolmang nungin, Moab gama chate ahingin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman a-inneipi Hodesh'a konin; Jobab, Zibia, Mesha, Malcham,
  </para>
  <para style="p">
    <verse number="10" style="v" />Jeuz, Sachia chule Mirma ahingin ahi. Hiche achapateho hi apu apateu insunga luchang cheh ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Hushim'a konin Abitub le Elpaal apengin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Elpaal chapate chu: Eber, Misham, chule Ono le akimvela khopiho sadohpa Shema.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gath'a chengho nodoh-a, Aijalon'a chengho pate luchang cheh Beriah le Shema;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahio, Shashak le Jeremoth,
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebadiah, Arad le Ader,
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Michael, Ishpa le Joha, amahohi Beriah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Zebadiah, Meshullam, Hizki chule Heber,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ishmerai, Izliah le Jobab, hichenghi Elpaal chapate ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Jakim, Zichri, Zabdi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Elienai, Zilthai le Eliel,
  </para>
  <para style="p">
    <verse number="21" style="v" />Adaiah, Beraiah chule Shimrath, hichenghi Shimhi chapate ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ishpan, Heber le Eliel,
  </para>
  <para style="p">
    <verse number="23" style="v" />Abdon, Zichri, Hanan,
  </para>
  <para style="p">
    <verse number="24" style="v" />Hananiah, Elam le Anthothijah,
  </para>
  <para style="p">
    <verse number="25" style="v" />Iphdeiah chule Penuel, hichenghi Shashak chapate ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shamsherai, Shehariah le Athaliah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Jaresiah, Eliah chule Zichri, hichengsehi Jeroham chapate ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichehohi apu apateu insunga aluchang cheh, akhanguva pipui ngen ahiuve. Amahosehi Jerusalem'a cheng ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Gibeon'a Gibeon pa achengin, a-inneipi min chu Maachah ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule achapa peng masapen chu Abdon ahin, chule Zur, Kish, Baal, Nadab,
  </para>
  <para style="p">
    <verse number="31" style="v" />Gedor, Ahio chule Zecher ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Mikloth'in Shimeah ahinge. Amaho jonghi asopihou toh kigalsaijin Jerusalem'a achengun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule Ner'in Kish ahingin, Kish in Saul ahingin, Saul'in Jonathan, Malchishua, Abinadab chule Eshbaal ahingin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jonathan chapa chu Merib-baal ahi, chule Merib-baal'in Micah ahingin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Micah chapate chu; Pithon, Melech, Tarea chule Ahaz ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Ahaz'in Jehoadah ahingin, chule Jehoadah'in Alemeth, Azmaveth, chule Zimri ahingin, Zimri'in Moza ahingin,
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule Moza'in Binea ahingin, Binea chapa chu Rapha ahin, Rapha chapa chu Eleasah, Eleasah chapa chu Azel ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Azel'in chapa gup aneijin, hicheho minchu: Azrikam, Bocheru, Ishmael, Sheariah, Obadiah, chule Hanan ahi. Hicheho jousehi Azel chapate ahiuve.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule asopipa Eshek chapate chu Ulam acha masa, Jehush anichanna, chule Eliphelet athum channa, ahiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Ulam chapate chu mihat mihangsan, thal kapthem mi ahiuvin, chapate tamtah aneijun, achapateu chapate mi jale somnga ahiuve. Hicheho jousehi Benjamin chapate ahiuve.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hitichun Israelte jouse akhanguijuva konin akisimin; chule veuvin, amaho chu Israel lengte le asuhkhel jeh uva Babylon'a kikaimang Juda lengte lekhabua akisune.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tun achanu khopiho-a cheng masapen ho chu; Israelte, thempuho, Levi ho, chule Nethinim ho ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Jerusalem'a Judah chate, Benjamin chate, chule Ephraim le Manasseh chate achengun; amaho chu:
  </para>
  <para style="p">
    <verse number="4" style="v" />Judah chapa Pharez chapate lah-a kon Bani chapa, achapa Imri, Imri chapa, Omri chapa, Ammihud chapa Uthai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shilon mite lah-a kon; acha masa Asaiah le achapate.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Zerah chapate lah-a; Jeuel le asopite mi jaguple somko.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Benjamin chapate lah-a kon: Hasenuah chapa Hodaviah, Hodaviah chapa Meshullam, chule Meshullam chapa Sallu,
  </para>
  <para style="p">
    <verse number="8" style="v" />Jeroham chapa Ibneiah, Michri chapa Uzzi, Uzzi chapa Elah, Ebnijah chapa Reuel, Reuel chapa Shephatiah, Shephatiah chapa Meshullam,
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule akhangu dungjuija asopiteu jakole somnga le gup ahiuve. Hicheho sesehi apu apateu insunga aluchang cheh ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule thempuho lah-a kon; Jedaiah, Jehoiarib le Jachin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pathen in'a vaihompa Ahitub chapa Meraioth, Meraioth chapa Zadok, Zadok chapa Meshullam, Meshullam chapa Hilkiah, Hilkiah chapa Azariah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Malchijah chapa Pashhur, Pashhur chapa Jeroham, Jeroham chapa Adaiah, chule Immer chapa Meshillemith, Meshillemith chapa Meshullam, Meshullam chapa Jahzerah, Jahzerah chapa Adiel, Adiel chapa Maasia,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule asopiteu, apu apateu insunga luchangcheh sangkhat le somgup ahiuvin, Pathen insunga kinbolna-a natong hatcheh ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Levi ho lah-a kon: Merari chapate lah-a Hashabiah chapa Azrikam, Azrikam chapa Hasshub, Hasshub chapa Shemaiah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Asaph chapa Zichri, Zichri chapa Micah, Micah chapa Mattaniah, Galal, Haresh, chule Bakbakkar,
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Jeduthun chapa Galal, Galal chapa Shemaiah, Shemaiah chapa Obadiah, chule Netophah mite khoho-a chengho Elkanah chapa Asa, Asa chapa Berechiah ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule kotngah ho chu Shallum, Akkub, Talmon, Ahiman chule asopiteu jong ahi. Shallum chu apipuipen ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lengpa solam kotpi chu tumasang sen angah jiuvin, amahohi Levi chate kiloikhom lah-a kotngah ho chu ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Korah chapa Ebiasaph, Ebiasaph chapa Kore, Kore chapa Shallum le asopite, apa insunga kon Korah mite chu Houbuh kotngah-a panga, kinbolna-a natonga pang ahiuve. Chule apu apateu chu Pakai janelho ngahmun lutna ngahtupma anapang ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Eleazar chapa Phinehas chu tumasanga amaho chunga vaihoma pang ahin, Pakaiyin aumpin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Meshelemiah chapa Zakariah chu Houkhom ho Houbuh kotngahpa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kotphungho ngahdinga lhendoh ho jousehi mi jani leh somleni ahiuve. Hichehohi akhohouva akhangguiju kisut dungjuija David le themgao Samuel'in atohmunu tongdinga anasuhdetsa ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun amahole achateu chun Houbuh Pakai in kotphungho chu avetup mun, angahtup mum ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kotngah ho chu aningli: solam, lhumlam, sahlam chule lhanglama umuva ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule asopihou akhoneo houva umho ni sagi sehle aphat phatna amahotoh umdinga hungji dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche Levi mi ngahtup pipui li hochun akingansenao Pathen in indanho le goukholna indanho chu avetupmun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule jingkah seh-a kot hongdinga kinganse ahijeh-un Pathen in kimvela chun ageh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule alah uva abang um le bel kinbol ahiuvin, akoilut alahdoh tengule asimcheh jiu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amaho abang chu um le bel ho le munthenga manchah ho jouse: changbong, lengpitwi, sathao, bego chule gimnamtui ho vetup dinga kipansah ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule thempuho chapate phabep chun nuding gimnamtui asemun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Korah mi Shallum chamasa Levi mikhat Mattithiah kitipa chu khangbel ho-a kikang thilto chunga natohna neidinga kinganse ahitai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule asopihou loikhat Kohath mite chapate chu vetsahna changlhah chunga tohmun nei ahiuvin, cholngahni seh-a asemdingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule hichehohi lasaho ahiuvin, Levi ho pate lah-a pipui, indan sunga um a-ongthola umjingho ahiuve; ajehchu amahon chuche nachu sunle jana atoh-u ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Levi pate pipui hohi akhangu lhumkeija pipui ahiuvin; amaho Jerusalem'a achengun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Gibeon'a chun Gibeon mite pa Jehiel achengin, a-inneipi minchu Maakah ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule achapa masapen chu Abdon ahin, Zur, Kish, Baal, Ner, Nadab,
  </para>
  <para style="p">
    <verse number="37" style="v" />Gedor, Ahio, Zekeriah chule Mikloth toh ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Mikloth'in Shimeam ahinge. Chule amaho jong asopihou toh kikotmai ngatnin Jerusalem'a achenguve.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule Ner'in Kish ahingin, Kish'in Saul ahingin, Chule Saul in Jonathan, Malchishua, Abinadab chule Eshbaal ahingin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Jonathan chapa chu Merib-baal ahin, Merib-baal'in Micah ahingin ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule Micah chapate chu; Pithon, Melech, Tahrea chule Ahaz ahiuve.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule Ahaz'in Jarah ahingin, Jarah'in Alemeth, Azmaveth chule Zimri ahingin, chule Zimri'in Moza ahinge.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule Moza'in Binea ahingin, Binea chapa chu Rephaiah ahin, Rephaiah chapa chu Eleasah ahin, Eleasah chapa chu Azel ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule Azel'in chapa gup aneijin, aminu hiche ahi: Azrikam, Bokheru, Ishmael, Sheariah, Obadiah chule Hanan. Hicheho jousehi Azel chapate ahiuve.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Philistine ten Israelte ahinsatnun; Israel mite chu Philistine te masanga ajam taovin, chule Gilboa molsanga chun mi tamtah athiuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Philistine ten Saul le achate chu hadelin adelun; hitichun Philistine te chun Saul chapate Jonathan, Abinadab, chule Malchishua chu athat taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin gal chu Saul dingin ahahsalheh jengtan, chuin thal themhon ahinkap khauvin, thalthem hon amavotaovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Saul'in agalvon popa jah-a, Nachemjam satdoh inlang, hiche cheptan louho khu ahunguva eihung jumso louna dingun, neisun pailet jenggin, ati. Ahivangin agalvon popa chu anompoi; ajehchu ama akichalheh jengin ahi. Hijeh chun Saul'in achemjam alan, achung chu abotan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule agalvon popan Saul athi amuphatnin, chutobang machun achemjam chungchu abon, athitan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun Saul le achapate thum, chule a-insung jouse chu athikhom taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin phaichama um Israel miho jousen, amaho ajamuva, chule Saul le achapate athiu chu amu phatnun, akhopihou adalhauvin ajamtaovin ahi. Chuin Philistine te ahungun, hicheho-a chun acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ajingin ahitin ahi, Philistine te mithiho von sutlha dinga ahunguva ahile, Saul le achapate Gilboa molsanga anathiu chu amudoh taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin avon asutlhah phatnun, aluchang le agalvon alauvin, amilim semthuhou le mipite henga thupha pole dingin Philistine te gamsunga athot kimvel taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule agalvonho chu a-pathen houin'a akoijun, aluchu Dagon houin'a atah-un ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jabesh-Gilead mite jousen Saul chunga Philistine te thilbol jouse ajah phatnun,
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihangsan sese akipatnun, Saul le achapate longchu agalamangun, Jabesh'a ahinpouvin, aguhou chu Jabesh'a gangpi thing noija chun avuijun, chule nisagi an angolun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun Saul chu Pakai thu angailou jeh le, lhakou ho henga thumop adoh-a, Pakai douna suhkhelna aneitah jeh-in athitan ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman Pakai adongpon: hijeh chun aman ama chu athatnin, chule alenggam chu Jesse chapa David henga apetan ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israelte jouse David henga Hebron'a ahung kikhom khomun, ahenga, Ven keiho nagule naphe kahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujongle tumasanga Saul lengchanlaijin jong Israel puidoh'a puilutjia chu nangma nahin: chule Pakai na Pathen'in naheng-ah, Nangman kami Israelte navah-a, kamipi Israelte chunga vai napoh ding ahi, ati'e atiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun Israel upaho jouse Hebron'a lengpa henga ahungun; David'in Hebron'a chun amahotoh Pakai masanga kitepna asemin; chuin Pakaiyin Samuel mangcha asei thucheng dung juijin, David chu Israel chunga leng hidingin thao anutaovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin David le Israelte jouse Jerusalem'a acheuvin, hichu Jebus ahin; chuche gama anachengho chu Jebus mite ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jebus'a chengho chun David hengah, Nangma hilama nahunglou helding ahi, atiuve. Ahijeng vangin David'in Zion kulpi chu alan, hichu David khopi ahung hitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin David'in, Koihile Jebus mite gasat masapen pen chu lamkaiho pipui hiding ahi, ati. Hitichun Zeruiah chapa Joab chu akontou masapenin, apipuipen ahitan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David chu kulpi-a chun achengin; hijeh chun amahon hichu David khopi asahtaovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman khopi chu Millo'a pat akimvelse geijin asadoh-in; chule Joab'in khopi amohse chu asemphan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun janel Pakaiyin aumpi jeh chun; David akhangtou chehcheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hicheho hi Israelte chungchanga Pathen'in anaseidoh dungjuija David'in anei mihat pipuiho, alenggam sunga ama le Israel pumpi to kisuhat hochu ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hichehi David'in anei mihat jat ahi: gal lamkaiho pipuipen Hachmon mi Jashobeam ahin: aman atengcha alamin phat khatseh'in mi jathum jen athatgam helin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ama bana chu Ahoh mi Dodo chapa Eleazer ahin, amahi mihat thumho lah-a khat ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama David toh Pasdamim'a umkhom ahin, chule hiche mun'a chun Philistine te galsat dingin anakikhom khomun, chule hiche mun'a chu sakol chang dimsetna akena leiset beh khat aumin ahi. Chuin mipi ho chu Philistine te masanga konin ajamtaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho chu loulaija chun dettah-in apangun, ahuhdoh-un, chule Philistine te chu athatnun; chule Pakaiyin amaho chu huhdohna loupitah-in ahuhdohtai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun gal lamkai somthum lah-a mi thum chu, songpi lama Adullam songko sunga David henga chun achesuh-un; chule Philistine sepai janel chun Rephaim phaichama chun pon in akison uvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hichepetna chu David kulpi-a uma ahin, chule Philistine te galsat miho chu Bethlehem'a pansaova ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin David'in ngaicha tah-in, Oh Bethlehem kotpi phung twikul'a twi chu dondinga eipethei khattou umtave leh! ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin mi thumho chun Philistine sepai janel chu aphu vangun, Bethlehem kotpi phung twikul'a konin twi agakhaijun, ahin domun, David henga ahinchoijun ahi: ahinla hiche donding chu David anompon, ahinla Pakai henga asunglha jon,
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitin ati, Hiche kabolding hi ka Pathen'in eijahda maihen: ahinkhou tosetna-a dinga pedoh hiche miho thisanhi kadon dingham? Ajehchu ahinkhou tosetna puma ahinchoiju ahi, ati. Hijeh-a chun aman adon tapon ahi. Hichehohi mihat chungnung thumho bol ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Joab sopipa Abishai hi thumho pipui ahi: ajehchu aman mi jathum chunga atengcha alamin, athat gamhelin, thumho lah-a minphatna achangtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi thumho lah-a chun ni teni sangin amachu ja-aumjon ahi; ajehchu ama alamkaiju ahi. Hijongle amasa mi thumho chu aphajoupoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kabzeel kho-a mihangsan pa chapa Jehoiada chapa Benaiah chun tohdoh tampi aneijin; keipi bahkai tobang Moab mi ni athatnin; chule achesuh-in buhbang lhah laijin kokhuh sunga keipi bahkai khat jong athatnin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule aman milen pitah, tong nga-a sang Egypt mi khat athatnin; chule Egypt mipa chun ponkhong ho talhang tejen tengcha khat akichoi ahin; chule aman atenggol akichoijin ajonsuh-in, Egypt mipa khutna konchun atengcha asalhah peh-in, ama tengcha mama chun athattan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichehohi Jehoiada chapa Benaiah thilbol ahin; mihat chungnung thumho lah-a chun minphat achangtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Veuvin, ama somthum lah-a jana achangin, ahin amasa mi thumho vang chu aphadehpoi; amachu David'in ama ngahtupho chunga apansah-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chujongle agalsat ho lah-a mihangsan ho chu, Joab sopipa Asahel, Bethlehem'a Dodo chapa Elhanan,
  </para>
  <para style="p">
    <verse number="27" style="v" />Haror mi Shammoth, Pelon mi Helez,
  </para>
  <para style="p">
    <verse number="28" style="v" />Teko mi Ikkesh chapa Ira, Anathoth mi Abiezer,
  </para>
  <para style="p">
    <verse number="29" style="v" />Hushath mi Sibbecai, Ahoh mi Ilai,
  </para>
  <para style="p">
    <verse number="30" style="v" />Netophah mi Maharai, Netophah mi Baanah chapa Heled,
  </para>
  <para style="p">
    <verse number="31" style="v" />Benjamin chapate gama um Gibeah mi Ribai chapa Ithai, Pirathon mi Benaiah,
  </para>
  <para style="p">
    <verse number="32" style="v" />Gaash vadung ho-a cheng Hurai, Arbath mi Abiel,
  </para>
  <para style="p">
    <verse number="33" style="v" />Baharum mi Azmaveth, Shaalbon mi Eliahba,
  </para>
  <para style="p">
    <verse number="34" style="v" />Gizon mi Hashem chapate, Harar mi Shage chapa Jonathan,
  </para>
  <para style="p">
    <verse number="35" style="v" />Harar mi Sacar chapa Ahiam, Ur chapa Eliphal,
  </para>
  <para style="p">
    <verse number="36" style="v" />Mecherathmi Hepher, Pelon mi Ahijah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Carmel mi Hezro, Ezbai chapa Naarai,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nathan sopipa Joel, Haggeri chapa Mibhar,
  </para>
  <para style="p">
    <verse number="39" style="v" />Ammon mi Zelek, Zeruiah chapa Joab galvon popa Beroth mi Naharai,
  </para>
  <para style="p">
    <verse number="40" style="v" />Ithri mi Ira, Ithri mi Gareb,
  </para>
  <para style="p">
    <verse number="41" style="v" />Hit mi Uriah, Ahlai chapa Zabad,
  </para>
  <para style="p">
    <verse number="42" style="v" />Reuben mi Shiza chapa Adina, Reuben mite gal lamkaipa le amatoh um somthum ho,
  </para>
  <para style="p">
    <verse number="43" style="v" />Maakah chapa Hanan, Chule Mithni mi Joshaphat,
  </para>
  <para style="p">
    <verse number="44" style="v" />Ashterath mi Uzzia, Aroer mi Hotham chapate Shama le Jehiel,
  </para>
  <para style="p">
    <verse number="45" style="v" />Tiz mi Shimri chapa Jediael le asopipa Jaha,
  </para>
  <para style="p">
    <verse number="46" style="v" />Mahav mi Eliel, chule Elnaam chapate Jeribai le Joshaviah chule Moab mi Ithmah,
  </para>
  <para style="p">
    <verse number="47" style="v" />Mesoba mi Eliel, Obed chule Jasiel ahiuve.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichehohi Kish chapa Saul jeh-a akikulkhup laija Ziklag'a David koma hungho chu ahiuve: chule amaho chu galsatna-a kithopi-a pang mihat ho ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amahon thal akichoijun, song senale thal kapdohna dinga akhut jetlamle veilam thothei cheh ahiuvin, Benjamin phunga Saul sopite ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Apipuipenu chu Ahiezer ahin, aban Joash, Gibeath mi Shemaah chapateni ahilhonin; chule Azmaveth chapateni Jeziel le Pelet, chule Anathoth mi Berachah le Jehu,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule somthum chungle somthum lah-a mihat Gibeon mi Ismaiah, chule Gederath mi Jeremiah, Jahaziel, Johanan chule Josabad,
  </para>
  <para style="p">
    <verse number="5" style="v" />Haruph mi Eluzai, Jerimoth, Bealiah, Shemariah chule Shephatiah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Korah mi Elkanah, Jesaiah, Azareel, Joezer chule Jashobeam,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Gedora Jeroham chapate, Joelah chule Zebadiah ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Gad miho gamthip kul sunga David henga behho chu mihat mihang ngen, chule galsatmi galsat dinga lhingset, lumle pho thothem cheh, amaiju keipi bahkai mai banghel, akaljan danu molsanga sakhi banga gang ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Akhatna Ezer, anina Obadiah, athumna Eliab,
  </para>
  <para style="p">
    <verse number="10" style="v" />Alina Mishmannah, angana Jeremiah,
  </para>
  <para style="p">
    <verse number="11" style="v" />Agupna Attai, asagina Eliel,
  </para>
  <para style="p">
    <verse number="12" style="v" />Agetna Johanan, akona Elzabad,
  </para>
  <para style="p">
    <verse number="13" style="v" />Asomna Jeremiah, asomlekhat na Machbannai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichehohi Gad chapate sepai janel gal lamkai cheh ahiuvin: alah uva aneopen chu jakhat chunga thunei, chule alenpen sangkhat chunga thunei ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amahohi lha masapen sung, luikam khela twi let leuva Jordan asolaitah-a palgalkai ho ahiuvin; amahon phaichama chengho chu lhumlamle solama agadel jamun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin David kulpi-a chun Benjamin le Judah miho ahunguvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amaho kimupi din David apotdoh-in ajah uva, Eipanpidia chamna-a hung nahiule, kalungthim hi nangho-a kijopmat ding; amavang kakhut teni-a thildihlou kabolkhahlou munasa-a, kamelmate henga eipedoh dinga hung nahiule, ipu ipateu Pathen'in hinvehen lang, nathu-u tanhen, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuphatnin gal lamkaiho pipui Amasai chungah lhagao ahungchun, hitin ati, Keiho nanga kahiuve David, nangma lama panga kahiuve Jesse chapa: lungmon, nachunga lungmon umhen, chule napanpi ho chunga lungmon umhen: ajehchu na Pathen'in napanpi, ati. Chuin David'in amaho chu asangin, honho lamkaijin asemtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Saul doudinga Philistine te toh ahunglaijun, Manasseh mi phabepmin David anajopmun: ahinla amahon ana kithopi pouve: ajehchu Philistine te pakaiho kihoutoh uva, Ama apu Saul lama lutnintin, iluchang diuvin tosetna hibep ding ahi, atiuva asolmangu ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ziklag'a achen ahile Manasseh mi Adnah, Jozabad, Jediael, Michael, Jozabad, Elihu chule Zilthai Manasseh miho asang sang lamkaiho ama lama alutnun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon michomgamho loi douna-in David akithopiuvin ahi; ajehchu amaho mihat mihangsan, sepai janel lamkai cheh hiuva ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu chuche laija chu ani ania Pathen janel tobang sepai janel nasatah ahikahsea, David kithopi dinga hunghung jenguva ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hichehohi Pakai thu dungjuija, Saul lenggam chu ama-a hisah dinga Hebron'a David henga hung, galsat dinga galvon puma kigosa dema umjing sepaihon honho jat ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Juda chate lumle tengcha choi, galsat dinga galvon puma kigosadem chu sangguple jaget ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Simeon chate galsat dinga mihat mihangsan cheh sangsagi le jakhat ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Levi chate-a kon sangli le jagup ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aaron mite lamkai chu Jehoiada ahin, amatoh sangthum le jasagi ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Zadok, gollhang mihat hangsanle apa insunga gal lamkaiho somnileni ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Saul insungmi, Benjamin miho chu sangthum ahiuvin, amaho atamjo Saul insung lama panga ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Ephraim chate apu apateu insung pumpi-a minthang cheh sangsomni le jaget ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Manasseh phung kehkhat-a kon David lenga semdinga hungdia kiminkut cheh chu sangsom le sangget ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Issachar chate-a kon phat hetthemna nei, Israel'in ipi abolding hethem; aluchang cheh-u jani ahiuvin, asopihou jouse chu amaho thu thu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zebulun chate gal kondohthei, gal manchah tincheng tho-a galsat them, panmun neithei cheh sangsomnga ahiuvin: amahohi lungtho neilou ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Naphtali'a kon gal lamkai sangkhat, chule lumle teng toh tho-a amahotoh umkhom sangsomthum le sangsagi ahiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Dan'a kon galsatna konthei cheh sangsomni le sangget le jagup ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Asher'a kon galsatna konthei cheh, galbol them sangsomli ahiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule Jordan gal langkhat lama um Reuben mite, Gad mite chule Manasseh phung kehkhatna kon, gal mun'a galmanchah tincheng mangthem cheh mi sangjakhat le sangsomni ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hicheho jousehi galsat mi, panmun tuhthei cheh, Israel jouse chunga David lenga semdinga lungthim chamkim tah-a Hebron'a hunga ahiuvin, chule Israel adang amoh chengse jong chu David lenga semdinga lungkitoh sel ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hitichun hiche mun'a chun amaho David toh nithum aumun, anekhom adonkhomun ahi: ajehchu asopihouvin amaho ding anagonpeh-u ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chukalvalin amaho nai vela um Issachar, Zebulun, chule Naphtali ho jengin jong sangan ho, sangongsang ho, sakolpol ho, chule bongchal hochun sa, an, theichang changlhah, lengpithei gop bohho, lengpitwi, sathao chule bongchal ho le kelngoi ho atama tam ahinpo uvin ahi: ajehchu Israel sunga kipa thanop uma ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David'in asangsang le ajaja gal lamkaiho le vaipoho jouse akihou khompin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule David'in Israel mipi ho jouse jah-a, Hichehi nanghon pha nasah uva, chule Pakai i-Pathen'uva kon ahile, Israel gamsung jouse-a kidalha, muntina um isopihou heng, chule amaho toh akhopihoule akimvela cheng thempuho le Levi mite jouse jong, hitichun eiho henga ahung kikhop khom theina dingun mi solkimvelu hitin:
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule eihon i-Pathen'u thingkhong chu ihenguva polut kit taohite: ajehchu eihon Saul nikho laijin hichu inadon tapouvin ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin mipi kikhomho jouse chun chutia chu aboldiuvin aseitaove: ajehchu hichu mi jouse mitmu-a dih sohkeija ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun David'in Egypt gam Shihor'a pat Hamath lutna geija Israelte jouse chu, Kirjath-jearim'a kona Pathen kitepna thingkhong podingin akhom khomtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin David le Israelte jouse chu Judah gama um Baalah kiti Kirjath-jearim'a um Cherub teni kikah-a cheng, Amin kiphon dohna, Pakai Pathen thingkhong podingin achetouvun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon Pathen thingkhong chu bong kangtalai thah khatnin Abinadab in'a konin apodoh-un, Uzza le Ahio in bong kangtalai chun atol lhone.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule David le Israelte jousen ajochanun Pathen anga lasah pumin, selangdah le tumging toh, khongcha le khutbeh, chule sumkon ho mut pumin alamuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Chidon changchilna phol ahung geitah-un, Uzz'in akhut alhangdoh-in thingkhong agah tuh go-in ahi: ajehchu bongchal chu kipala ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Uzza chunga Pakai lunghanna ahung koujah tan, aman thingkhong akhutna atuhjeh chun adengin; chuachun Pathen masanga athitan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Uzza chunga Pakaiyin akhut alhajeh chun David alunglhaitapon: hijeh chun tuni geijin chuche munchu Perez Uzza akitin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule chuche nikho chun David'in Pathen akichatan, Pathen thingkhong hi iti in'a kahenga kapohlut ding ham? ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun Davidn'in thingkhong chu David khopi ama in'a alhutapon, Git mi Obed-edom in'a chun apolut jotan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Pathen thingkhong chu Obed-edom insungmi tetoh ama in'a lhathum jen aumdentan ahi. Chule Pakaiyin Obed-edom insung chu aneiho jouse toh phatthei aboh tan ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Tyre lengpa Hiram'in David koma thupole ho toh lhonin, cedar thingtumho, songkheng themho chule thingthemho a-in sahpeh dingin asolin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ami Israelte jala alenggam choisanga aumtahjeh chun, Pakaiyin Israelte lenga atundet ahichu David'in akihet tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David'in Jerusalem'a chun ji akipuibe nalaijin: David'in chapate le chanute ahinbe nalaije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tun hichehohi Jerusalem'a anei achate minho chu ahi: Shammua, Shobab, Nathan chule Solomon,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Ibhar, Elishua chule Elpalet,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Nogah, Nepheg chule Japhia,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Elishama, Beeliada, chule Eliphelet ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Philistine miten David chu Israel jouse chunga leng dingin thao akinutai ti ajah phatnun, Philistine mite jouse David holdingin achetou taovin ahi. Chuin David'in hichu ajan, amaho kisatpi din akondohtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Philistine te ahungun Rephaim phaichama akithecheh taove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin David'in Pathen adongin, Philistine te satna kakontou dingham? Chule kakhutna amaho chu neipeh ding hinam? ati. Chuin Pakaiyin ajah-a, Kontouvin, amaho chu nakhutna kapehdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun amaho Baal-perazim geijin ahung touvun, David'in chuachun amaho ajoutan ahi. Chuphatnin David'in, Twi kivocheh bangin kamelmate chu Pathen'in kakhutna avochehtai, ati. Hijeh chun amahon chuche mun chu Baal-perazim asahtaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon chukoma a-pathen hou adalhah phatnun, David'in thupeh apen, meijin ahalvam taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Philistine te chu avelin phaichama chun ahung kithecheh kitnuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun David'in Pathen adongkitnin ahile, Pathen'in ajah-a, Amaho nunga khun chetou hih-in; amaho-a konin kihei mang inlang, thingtheimi phung jonna khun achunguva hung chun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hunghiti ding ahi; thingtheimi thing chunga akitol ginu najah teng, galsatdia nakondoh ding ahi: ajehchu Philistine galmi janel that dinga namasanga Pathen kondoh-a ahitai, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun David'in Pathen'in thupeh bangchun abolin; amahon Philistine galmi janel chu Gibeon'a pat Gazer geijin athatpeh taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin gam jouse-a David min athangtan; chule Pakaiyin nam jouse chunga ama ginna achuhsah tan ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule David'in David khopi-a chun a-inding ho asan, chule Pathen thingkhong dingin mun khat agongin, ponbuh asonpeh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun David'in, Levi mite tailouvin Pathen thingkhong apohthei louhel dingu ahi; ajehchu Pakaiyin amaho chu Pathen thingkhong pole ding le atonsotna ama jendinga alhendoh ahiuve, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David'in aumna dinga agonpehna mun'a chu Pakai thingkhong potou dingin, Israelte jouse chu Jerusalem'a akhom khomin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule David'in Aaron chate le Levi mite akhomin:
  </para>
  <para style="p">
    <verse number="5" style="v" />Kohath chapate lah-a kon; pipui Uriel, chule asopite jakhat le somni,
  </para>
  <para style="p">
    <verse number="6" style="v" />Merari chate lah-a kon; pipui Asaiah, chule asopite jani le somni,
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershom chapate lah-a kon; pipui Joel, chule asopite jakhat le somthum,
  </para>
  <para style="p">
    <verse number="8" style="v" />Elizaphan chapate lah-a kon; pipui Shemaiah, chule asopite jani,
  </para>
  <para style="p">
    <verse number="9" style="v" />Hebron chapate lah-a kon; pipui Eliel, chule asopite somget,
  </para>
  <para style="p">
    <verse number="10" style="v" />Uziel chapate lah-a kon; pipui Amminadab, chule asopite jakhatle somleni ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin David'in thempu teni Zadok le Abiathar, chule Levi mite Uriel, Asaiah, Joel, Shemaiah, Eliel chule Amminadab akouvin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajah uva, Nangho Levi ho pate pipuiho nahiuve: aumna dinga kasemsa mun lama Israel Pakai Pathen thingkhong nahinpoh theina dingun, nangho le nasopite cheng kisuthengun.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu amasa chunga chu hichu nabollou jeh-u le, abolding dan ama idohlou jeh uva, Pakai i-Pathen'un ichunguva akhut analhah ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun thempuho le Levi te chu Israel Pakai Pathen thingkhong podingin akisutheng taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Levi chate chun Pakai thu dungjuija Mosi thupeh bangin, achunga moljola chun Pathen kitepna thingkhong chu alengkouvun apuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin David'in Levi pipuiho chu ahoupin, asopihou chu lasahna manchah pum, tumgingho le selangdah ho pum, chule khutbeh to tho-a, aw sangtah-a lasa dinga alhendoh diuvin aseipeh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitichun Levi hon Joel chapa Heman, chule asopite lah-a Berechiah chapa Asaph, asopihou Merari chapate lah-a Kushaiah chapa Ethan chu apansah-un;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amaho kitho-a aloi ni-a pangding asopihou chu; Zekeriah, Ben, Jaaziel, Shemiramoth, Jehiel, Unni, Eliab, Benaiah, Maaseiah, Mattithiah, Elipheleh, Mikneiah chule kotngah-a pang teni Obed-edom le Jeiel toh ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitichun lasathem, Heman, Asaph chule Ethan chu sum-eng khutbeh bengin apansah uvin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Zekeriah, Aziel, Shemiramoth, Jehiel, Unni, Eliab, Maaseiah chule Benaiah chu Alamoth dungjuija tumging toh thoding ahiuvin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Mattithiah, Elipheleh, Mikneiah, Obed-edom, Jeiel chule Azaziah chu Sheminith dungjuija selangdah toh thoding ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Levi te pipui Chenaniah chu labul-in apangin ahi; ajehchu ama athep jeh-in lahil in apangin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Berechiah le Elkanah chu thingkhong kotngah-in apang lhonin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule thempuho Shebaniah, Joshaphat, Nethaneel, Amasai, Zekeriah, Benaiah chule Eliezer chu Pathen thingkhong masanga sumkon mut ahiuvin; chule Obed-edom le Jehiah chu thingkhong umna kotngah ahilhone.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hitichun David le Israel upaho, chule asang asang chunga gal lamkaiho chu Obed-edom in'a kona Pakai kitepna thingkhong kipahtah-a gapotou din ache taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule ahitin ahi, Pakai kitepna thingkhong pu-a pang Levi ho chu Pathen'in akithopi phatchun, amahon bongchal sagile kelngoichal sagin ganlhaina aboluvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule David le kitepna thingkhong jonga pang Levi ho jouse, chule lasaho le lalamkaipa Chenaniah chu tupat ponnemin akivonun; David'in jong tupat ponnem boitong sangkhol aki-ah in ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun Israelte jousen a-ao tothon, sumkon binei ginle sumkon gin, khutbeh gin, tumging le selangdah gin to thon Pakai kitepna thingkhong chu apotou taovin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, Pakai thutep thingkhong chu David khopi sung ahunglhun tah-in, Saul chanu Michal'in David lengpa lamle chople chu bangkotna konin amutan: alungsunga amuneo lheh-in ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chutichun amahon Pathen thingkhong chu ahin pouvin, David'in chuche dinga anason ponbuh lailung tah-a chun angauvin; chule Pathen angsunga govam thilto le chamna thilto atoh-un ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David'in govam thilto le chamna thilto aboljou phatnin, Pakai minin mipi ho chu phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Israelte amitakip apasal anumeijin, mitin changlhah tumkhat, saphehoi lhang khat, chule lengpitwi pai khat apecheh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule aman Levi te mi phabep chu Pakai thingkhong masanga lhacha ding, thu ching ding, chule Israel Pakai Pathen thangvah le vahchoi dingin apansah-in;
  </para>
  <para style="p">
    <verse number="5" style="v" />Pipui Asaph, chule amabana Zekeriah, Jeiel, Shemiramoth, Jehiel, Mattithiah, Eliab, Benaiah chule Obed-edom ahiuvin: chule Jeiel chu tumgingle selangdah thoding ahin, hinlah Asaph chu thih khutbeh bengin apangin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Thempu Benaiah le Jahaziel'in Pathen kitepna thingkhong masanga chun sumkon amutjing lhonin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hiche nikho chun David'in amasapen dingin hiche Pakai thangvahna la Asaph le asopite khutna apedoh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai henga vahchoina peuvin lang, aminin taovun, mihemte lah-a athilbol hetsah-un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahenga la saovin, Ahenga vahchoi La saovin, athil kidang bolho jouse seijun.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amintheng chu loupisah-un; Pakai holho lungthim kipah hen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai le ahatna holunlang; tanglouvin amai holjingun.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman ana tohdohsa anatoh kidangho, athil kidangho, akamsunga athutanho chu geldoh-un;
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo nangho Israel chilhah asohte, vo alhentum nangho Jacob chate,
  </para>
  <para style="p">
    <verse number="14" style="v" />Amachu Pakai i-Pathen'u ahin; athutanho chu leiset chung jouse-a aume.
  </para>
  <para style="p">
    <verse number="15" style="v" />Akitepna chu a-itih-in geldoh jingun; khang sang sanga dinga athupeh thuho chu;
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham henga akitepna ngei le, Isaac henga akihahselna chu;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hiche mama chu Jacob henga danthu-a dingin asudetnin; chule Israelte henga tonsotna kitepna dingin asuhdetnin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahenga, Canaan gam chu nangma dinga, nachan ding gouva kapeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangho hiche gamahi lhomcha bou, tahbeh-a lhomcha bou khopem nahilaiju chun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amaho nam khatna kona nam khatna, lenggam khatna kona midang henga achele laijun,
  </para>
  <para style="p">
    <verse number="21" style="v" />Koiman adihlouva aboldiu aphalpon; chule amaho jeh-in lengho aphohsal jin;
  </para>
  <para style="p">
    <verse number="22" style="v" />Kathaonupa hi tongkha hih-un, chule kathemgao ho chunga khangse hih-un, atin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leiset pumpin Pakai vahchoi La saovin: anitinin ahuhhingna phongjalun.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aloupi na chu Pathen helou ho lah-a; chule anatoh kidangho chu namtin lah-a phongjalun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu Pakai hi loupitah ahin; loupitah-a choiat ding ahi: Ama Pathen dang jouse chung vuma ginding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajehchu miho pathen jouse chu milim bou ahin; Pakaiyin vang vanho asemin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Loupina leh jana ama-a aumin; thahatna le kipana ama munah aume.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pakai henga peuvin, nangho phungtina miho, Pakai henga loupi na le thahatna peuvin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakai henga aminto kithuh loupina peuvin: thilto hin choi jinlang a-angsung hungun; athenna hoina-in Pakai chu houvun.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lei pumpi a-anga kichauvin; vannoi jong akilon louna dinga detding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vanho kipahhen lang leiset thanom hen: chule Pakai alengchang tai, tin miten namtin lah-a seijuhen.
  </para>
  <para style="p">
    <verse number="32" style="v" />Twipi le asunga umjouse ginglellul henlang: gamho le asunga umho jouse thanomuhen.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chujou tengle gammang thing jousen Pakai anga la asahdoh dingu ahi, ajehchu ama leiset thutan dingin ahunge.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aw Pakai henga thangvahna peuvin; ajehchu ama aphan; ahepina atonsotnin aumjinge.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule nanghon, Vo eihuh hinguva Pathen, neihuhhing un, namin theng kathangvah uva, napachat na-a loupina kapeh theina dingun, neikhom khomun lang, Pathen helouho-a konin neihuh doh-un, tiuvin.
  </para>
  <para style="p">
    <verse number="36" style="v" />Israel Pakai Pathen chu atonsot atonsotnin nunnom hen, ati. Chuin mipi jouse chun AMEN, Pakai chu vahchoijun atiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chutichun aman Asaph le asopite cheng chu Pakai kitepna thingkhong masanga chun, niseh-a tohding angai dungjuija kitepna thingkhong masanga tanglouva kinbol jing dingin;
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Obed-edom toh asopite somgup le get, Jeduthun chapa Obed-edom chu Hosah toh kotngah-a pang dingin;
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule thempu Zadok le asopite thempuho chu Gibeon'a um munsanga Pakai Houbuh masanga,
  </para>
  <para style="p">
    <verse number="40" style="v" />Aman Israelte ana thupeh, Pakai danthua kisun jouse dungjuija boldingle, tanglouva jingkah nilhah seh-a govam thilto maicham chunga govam thilto pejing dingin;
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule amaho chutoh Heman le Jeduthun, chule amin kiminkutna kilhengdoh adangho sese chu ahepina tonsotna aumjing jeh-a Pakai henga thangvahna pedingin;
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule amaho chutoh Heman le Jeduthun chu sumkon ho le thihkhutbehho chule Pathen tumgingtheiho tumging dingin adalhan ahi. Chule Jeduthun chapate chu kotngah ahiuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin ami jouse chu a-inlam cheh-a akile taovin: chule David jong a-insung vangboh dingin akiletan ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, David chu a-in'a atoupetnin Nathan themgao jah-a chun David'in, Ven keima cedar thinga kisa in'a kachengin, ahivangin Pakai kitepna thingkhong chu pon in noija aumnalaije, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuphat chun Nathan'in David jah-a, Nalunga um jouse chu boljengin; ajehchu Pathen'in na-umpinai, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin chuche jan mama chun ahitin ahi, Nathan henga Pathen thu ahung lhungin, hitin ati,
  </para>
  <para style="p">
    <verse number="4" style="v" />Kasoh David henga chenlang hitin gaseijin, Pakaiyin hitihin aseije, Nangman kachenna ding in neisahpeh louding ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ijeh-inem itile Israel kapuidoh nikho-a pat tuni geihin in'a kacheng khapon; ponbuh-a kon ponbuh, chule Houbuh khatna kon achom khatna kakichon lele bouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israelte jouse toh kachelena jouse-a, ka mipite vahdinga kathupeh Israel vaipoho khatpenpen jah-a chu, Ipidinga cedar thinga in neisahpeh lou uham, tia kasei khah em?
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun kasoh David jah-a hitia hi naseiding ahi, Janel Pakaiyin hitihin ati, kelngoihon lah-a kon, kelngoi nung najuina ngeija konin kami Israelte chunga leng dingin kapuidoh-in:
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nachelena lam jouse-a kalhonpi jingin, namasanga konin namelmaho jouse kasatlhah peh-in, chule leisetna um miloupi tahtah ho min bangin namin kathansah tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujongle kami Israelte dinga munkhat kagonpeh ding, kaphulut uva, amaho amunuva cheng diu, chule kichonle talou dingu; chule abultil lai banga gitlouna chaten asuhgim kit tahlou dingu,
  </para>
  <para style="p">
    <verse number="10" style="v" />Kami Israelte chunga vaihom dinga thutan ho kathupeh lai banga chu. Chujongle namelmaho jouse kasuhnempeh ding nahi. Chukit jongle Pakaiyin insung khat natundoh pehding ahi ti kaseipeh nahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hunghiti ding ahi, nanikho ho ahung beija napu napate toh umkhom dinga nacheteng, nanunga nachilhah khat katundoh ding, amachu nachapate lah-a kon hiding; chule alenggam kaphudet ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama chun in eisahpeh ding, chule keiman tonsotna dinga alaltouna katundoh pehding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima apa kahiding, chule ama kachapa hiding: nangma masanga ana umpa-a kona kalahmang banga, ama-a kon kahepina kalahmang louding:
  </para>
  <para style="p">
    <verse number="14" style="v" />Amavang atonsotna dinga ka insungle kalenggam sunga kachensah ding: chule alaltouna chu a-imatih chana dinga katundoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiche thuho jouse dungjui le, hiche gaothil muho dungjuijin, Nathan'in David hengah aseitan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin David lengpa chu ahungin Pakai angah atouvin, hitin aseije, Vo Pakai Pathen, keima koi kahia, chule ka insunghi ipi hija, nangman hichangei jen neihinpui hitam?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla vo Pathen, hichehi nangma mitmun thil neocha bou ahi nalaije; ajehchu nasoh insunga khonung peh sottah jouva hunglhung ding jong naseijin, chule vo Pakai Pathen, nangman keimahi dinmun sangtah nei miho tobangin neikoije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nasoh najabolna chunga hi David'in nahenga ipidang aseibe thei nahlai ding ham? Ajehchu nangman nasoh hi nahenai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vo Pakai, nasoh khohsahna jal le, nangmatah lunggel dungjuija, hiche thil loupiho jouse pihi hetsahna dinga, hiche thilloupitah jouse hi nabol ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vo Pakai, kakol uva kajah-u jouse dungjuijin nangma tobang koima aumpon, chule nangma tailoujong Pathen dang khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nami Israelte tobanga Pathen'in amite hidinga aga lhatdoh, Egypt gama kona nahuhdoh namite-a dinga amasanguva kona namtin nanodoh-a, namin kithan nadinga thil kidangtah le loupitah nabolna nam khatbeh leiset chunga hi umkham?
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu nami Israelte hi tonsotna namite hidingin nasemtan; chule Pakai, nangma a-Pathen'u nahunghi tai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun tun, Pakai, nasoh chung chang le a-insung chungchang thua nasei thil chu atonsotna dingin sudet inlang, chule naseisama bangin hinboltan.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakai janel Pathen hi Israel Pathen ahin, Israel Pathen ngeichu ahi: tia tonsotna namin choisanga aumna dingin kiphut det hen; chule nasoh David insunghi nangma angsunga phudetnin umhen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu vo ka-Pathen, nangman nasoh henga insung khat natundoh pehding ahi tin naseipeh tan ahi: hijeh-a chu nasohhin na-anga taona ding lungthim amu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule tun, Pakai, nangma Pathen nahin, chule hiche phatnahi nasoh henga nateppeh ahitai:
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun tun, na-angsunga tonsotna a-umjing theina dingin, nasoh insung vangboh dinghi nalung lhaina hihen: ajehchu vo Pakai, nangman phatthei naboh ahitan, atonsot geija phatthei boh hiding ahitai, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hiche jouhin ahitin ahi, David'in Philistine te ajouvin, chule asunemin, chuin Philistine mite khutna konin Gath le akhopiho alatan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Moab ajouvin, Moab mite chu David soh-in apangtauvin, chule thilpehho ahinpouvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David Euphrates vadung geija alenggam tungdet dinga achena-a, Hamath langa Zobah lengpa Hadarezer chu ajoutan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule David'in ama-a konin sakol kangtalai sangkhat, sakol chunga tou sepai sangsagi, chule keng sepai sangsomni ahin lan: chuin David'in kangtalai kai sakol ho jouse chu akeng asat baijin, alah uva konchun sakol kangtalai jakhat kaiding bou akhenin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Damascus'a kona Syria miho Zobah lengpa Hadarezer kithopi dinga ahung phatnun, David'in Syria miho chu mi sangsomni le sangni athatnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuphatnin David'in Syria gamsung Damascus'a sepai atousah in; chule Syria miho chu David soh-in apanguvin, thilpeh ahin choijun ahi. Hitichun Pakaiyin David chu achenalam jouse ah avengbit jingin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin David'in Hadarezer soh ho chunga um sana lumho chu alan, Jerusalem'a ahinpo tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutobang machun David nin Hadarezer khopiho Tibhath le Chun akonin sum-eng atama tam ahinlan; hicheho-a chun Solomon'in sum-eng twikong le khom, chule sum-eng belho asemin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun Hamath lengpa Tou'in Zobah lengpa Hadarezer sepaihon jouse David nin ajousohtai ti ajah phatnin,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hadarezer chu akisatpi-a ajotah jeh chun, ama chibai bohdingle kipapi dingin, achapa Hadoram chu David lengpa henga asolin ahi: (ajehchu Hadarezer le Tou chu ana kidou jingsa ahilhone) chule aman sana, dangka chule sum-eng um le bel namkim ahin solthan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />David lengpan jong hicheho chutoh nam dangdang ho: Edom'a kon, Moab'a kon, Ammon chate-a kon, Philistine miho-a kon chule Amalek mite-a kona ahinpohho dangka le sanaho chu Pakai henga apedohtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chukalvalin Zeruiah chapa Abishai'in chi phaichama chun Edom mite Sangsom le sangget anathatnin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman Edom'a sepai akoijin, Edom mite jouse chu David soh-in apangtauvin ahi. Hitichun Pakaiyin David chu achenalam chenga aveng bitnin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun David Israel mite jouse chunga aleng changin, chule amipi jouse lah-a thudih le chondih na-in vai ahomin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule sepai janel jouse chunga vaihoma chu Zeruiah chapa Joab ahin; chule Ahilud chapa Jehoshaphat chu thuching ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Ahitub chapa Zadok le Abiathar chapa Abimelech chu thempu ahilhonin; chule Shavsha chu danthusun ahin;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Jehoiada chapa Benaiah chu Chereth mite le Peleth mite chunga vaibol ahin; chule David chapate vang lengpa kimvela pipuipen ahiuvin ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hiche jouhin ahitin ahi, Ammon mite lengpa Nahash athitan ahile, ama khelin achapa alengchang tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David'in, Apan kachunga hepina anamusah jeh-in ken jong Nahash chapa Hanun chunga hepina vetsah inge, ati. Hitichun David'in apa chungchanga ama lhamon dingin thupole ho asole. Hitichun David sohte chu Ammon chate gama Hanun henga alhamon din ahungun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla Ammon chate lah-a pipuihon Hanun jah-a, David'in napa ajajeh-a nahenga lhamon ding miho ahinsol hidinga nagelem? Asohhohi nahenga gamsung kholtoh-a lehkhup dinga, avelhi dingin hunga hilou uham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun Hanun'in David sohte chu amanin, akhamulu ahettol peh-in, chule avonhou chu akimlaitah atobuh-u phabep bepmin atanpeh-in, asolmang tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuphatnin mi phabep David henga acheuvin, miho kiboldanho chu aseipeh taovin ahi. Chule aman amaho kimu pidingin mi asolin ahi: ajehchu miho chu ajahcha behseh jenguve. Chuin lengpan, Nakhamulu ahung khandoh kit kahsen Jericho'a umunlang, chujou tengle hungkile taovin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Ammon chaten David dinga thet umtah-a akisemdoh-u amu phatnun, Hanun chule Ammon chaten Mesopotamia'a kon, Syria-Maachaha kon, chule Zobah'a kona kangtalai ho le sakol touthemho goina dingin dangka talent sangkhat athot taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun amahon kangtalai sangsomthum le sangni le Maachah lengpa le amipiho chu atha lah un: amaho ahungun Medeba masanga ponbuh akisonun, chule Ammon chateho akhopilen houva konin ahung kikhom khomun, galsat dingin ahung taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin David'in hichu ajah phatnin, Joab le sepai hangsan janel jouse asoltan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Ammon chate ahungdoh-un, khopi lutna kotpi-a galsat dingin akigolun; chule ahunga lengho jong loujaova chun apangun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun Joab'in anung ama-a adouding aume ti amu phatnin, Israel lah-a konin lhentum cheh phabep alhengdoh-in, Syria te doudingin agoltohtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule mipi adang sese chu asopipa Abishai khutna apedoh-in, chule amaho chu Ammon chate doudingin akigol taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman, Syria mite keidinga ahatbeh seh-u le neihin huding ahi: ahinla Ammon chate chu nang dinga ahatbeh seh-ule keiman nangma kahin huding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hangsan tah-in uminlang, imipiteu le I-Pathen'u khopiho dingin hangtah-in umhite; chule Pakaiyin amitmua pha asah bangtah-in hinbol tahen, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun Joab le amatoh umkho mipite chu Syria miho doudingin anailut taovin; chuin amaho ama masanga ajamcheh taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Ammon chaten Syria te ajamtaove ti amuphatnun, amaho jong chutobangma chun asopipa Abishai masanga konin ajamcheh-un, khopi sunga chun alut taovin ahi. Chujouvin Joab Jerusalem'a ahungtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Syria ten Israelte aleluchu amuphatnun, sottole ho asolun, vadung gala um Syria mite chu agatoldoh taovin: chuin Hadarezer sepai janel gallamkai Shophach chu amasanguva alamkaijin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin hiche chu David aseipeh taovin ahile, aman Israel jouse akhomin, Jordan agalkaijun, achunguva achun, kisatpi din akigol taovin ahi. Chutia Syria te doudinga David nin asepaiho agoltoh phatnin, amahon akisatpi taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla Israelte masanga Syria te ajamcheh taovin, David'in Syria te kangtalai ja galsat ho mi sangsagi, chule keng sepai sangsomli athatnin, chule janel gallamkai Shophach chu athattan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Hadarezer sohten Israel masanga amaimoh-u amuphatnun, David toh chamna asemun, hitichun asoh-in apang taovin; chule Syria ten Ammon chate chu apanpi kit tapouvin ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, kum ahung kichaija, lengho galsatna achedoh phat laitah-un, Joab'in sepaihon thahat tah chu apuidoh-in, Ammon chate gam chu asusen, chuin ahungin Rabah ahin umtan ahi. Ahin David vangchu Jerusalem'a aume. Chuin Joab'in Rabbah ajouvin, asusetan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule David'in alengpao luchanga konin lallukhuh alalhan, hichu sana talent khatna gih ahi amudoh-in, chule hia chun song mantam jong ajaovin; chuin hichu David akhuhpeh taovin: chule khopi-a kon chun gala kichomdoh thil tamtah jong ahin pon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin chua um mipihochu apuidoh-in, thing-at, khenchi, chule heicha mangin na atohsah-in ahi. Chutobang tahchun David'in Ammon chate khopiho jouse chu abolin ahi. Chuin David le mipite jouse Jerusalem'a akile taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin hiche jouhin ahitin ahi, Philistine te toh Gezer'a kidouna aumin; hichepet hin Hushath mi Sibbechai'in milen chate lah-a khat Sippai kitipa chu athatnin: chuin amaho chu suhnemin aumtaovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Philistine te toh kidouna aumkitnin, chuin Jair chapa Elhanan'in Git mi Goliath sopipa, atenglung jong ponkhong ho talhang tejen hijah, Lahmi chu athatnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Gath'a kidouna aumkitnin, hia chun mi sangtah khat, akhut langto-a khutjung gup le akeng langto-a kengjung gup cheh, agoma khutjungle kengjung somnileli nei aumin: ama jong chu milen chapa ahije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla aman Israelte ataitom phatnin, David sopipa Shimeia chapa Jonathan'in ama chu athattan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichehohi Goth mun'a milen ho-a kona pengho ahiuvin, ahin amaho David le asohte khutna alougam taove.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israelte dounan Satan adingdoh-in, Israelte simsah din David chu atildohtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David'in Joab le mipi vaipoho jah-a, Cheovin, Beersheba apat Dan geipeh-in Israel jat simunlang, kahet theina dingin kahengah ajatnu hin lhutnun, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Joabmin adonbutnin, Pakaiyin amite chu ajat jakhatna tamjon punsah hen: ahinla ka pakai lengpa, amaho chu ka pakaipa sohte ngen hilouham? Ipidinga ka pakaiyin hiche thilhi angaichat hija ham? Ipidinga ama Israel themmo channa hunghi dingham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahijeng vangin lengpa thusei chun Joab chu ajoujotan ahi. Hijeh chun Joab akipatdoh-in Israel achonsoh keijin, Jerusalem'a ahungkile kit tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Joab'in David hengah mipi asimdoh jat chu apei. Chule Israel lah-a chemjam lamthei cheh chu mi sang sangkhat le sangjakhat ahiuve: chule Judah lah-a chemjam lamthei cheh chu mi sangjali le sangsomsagi ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahivangin Levi le Benjaminte chu alah uva akisimtha poi; ajehchu lengpa thusei chu Joab dinga thet umtah ahije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hiche thil la hin Pathen alunglhai tapon, hijeh chun Israel chunga jepna achuhsah tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin David'in Pathen hengah, hiche thil kabol jeh hin keima nasatah-in kachonse tai: ahin tun, nahenga katao ahi, nasoh khangit louna hi lamangtan; ajehchu ngolhoi tah-in kana chontai, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin David mitvah neipa, Gad henga thu ahin seijin, hitin ati,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chenlang David hengah hitin gaseijin, Pakaiyin hitihin aseije, keiman nangma thil thum kagonpeh-e: nachunga katoh theina dingin alah-a khat kilhenin gatin, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun Gad chu David hengah ahungin, ajah-a, Pakaiyin hitihin ati, Nangman kilhenin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Kumthum kel lhah ham; ahiloule namelmate masanga lhathum sunga suhmanga naum ding, hiche sunga chu namelmate chemjamin nadelding; ahiloule nithum sunga gamsunga Pakai chemjam, hise ngeichu gamsunga uma, chule Pakai vantil'in Israel gamkol jouse asuhmang ding nalhenam. Hijeh chun tun, eihin solpa henga ipi thu kalhut dingham kilhen temin, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuphatnin David'in Gad jah-a, Keima kalung adonglheh jengtai: tun Pakai khutna lhalut jenging kate; ajehchu amihepina nasatah-in alenin ahi: mihem khutna vang neilhahlut sah hihbeh-in, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitichun Pakaiyin Israel chunga hise alansahtan, Israel lah-a mi sangsomsagi athi taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Pathen'in Jerusalem sumang dingin vantil asoltan: chule aman asuhmang laitah-in, Pakaiyin aven, chule thilse atohgotna konchun alung aheijin, asumang vantil henga chun, Aphasettai, tun nakhut tuhtang tan, ati. Chuin Pakai vantil chu Jebus mi Ornan phola chun adingtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin David akhodah-in ahile, Pakai vantil chemjam kidopma Jerusalem lam nga-a, leile van kikah-a adin amutan ahi. Chuphatnin David le Israel upaho khaodippon kisila umho chu tolla abohkhup taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Davidn'in Pathen hengah, Mipi ho simding thu pe-a chu keima kahi hilouham? Achonsea khanset bola chu keima ngeihi kahi; ahin hiche kelngoi ho vanghin ipi aboluvem? Vo Pakai ka Pathen, nahenga katao ahi, nakhut chu keimale kapa insungah chujohen; ahin hiche namite hin natset atona dingun chuhda hen, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin Pakai vantil'in Gad hengah David chu achetouva, Jebus mi Ornan phola Pakai dinga maicham agasem nadinga David aseipeh dingin athupeh-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Gad'in Pakai mina aseibang chun David achetou tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Ornan chu akinung heija ahile vantil chu amutan; chule akoma um achapa liho akisel taovin, ahin Ornan chun suhlouchang chu achil jingin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin David Ornan koma ahung laichun, Ornan'in ahinven ahile David chu amutan, chuin phola konchun achedoh-in, amai tolla asulutnin David anga chu abohkhuptan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun Davidn'in Ornan jah-a, Mipi lah-a kona natset atan theina dingin, hiche phol munhi Pakai henga maicham kasem theina dingin neipen; aman lhingsetna dinga neipeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Ornan'in David jah-a, Kilah jengin, chule ka pakai lengpan pha asah bang bangin boljeng hen; ven, govam thilto dingin bongchal, thing dingin changchilna manchah ho, chule anneh thilto dingin suhlouchang kapei: abonahi kapeh sohkei nahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin David lengpan Ornan jah-a, Ahipoi, aman lhingsetna kachohtei ding ahi: ajehchu nangma-a chu Pakaiya dinga kalah louding, imacha suhmang louva govam thilto kato louding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hitichun David'in Ornan chu chuche mun man ding chun sana shekel jagup-a gih apen ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin David'in chumunna chun Pakai dingin maicham asemin, govam thilto hole chamna thiltoho apen, Pakai henga ataovin ahi; chuin aman meijin van'a konin govam thilto maicham chunga chun ahindonbut nin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Pakaiyin vantil chu thu apen, chuin achemjam chu apaijah akhumkit tan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule David'in Jebus mi Ornan chang chilna phol mun'a Pakaiyin adonbut amu phatnin, hia chun ganlhaina aboltai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu gamthipma Mosi'n asem Pakai Houbuh le govam thilto maicham chu chuche petna chu Gibeon munsanga uma ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin hiche masanga chu Pakai dong dingin David ache ngampon ahi; ajehchu Pakai vantil chemjam jeh-a chu kicha-a ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin David'in hichehi Pakai Pathen in ahin, hichehi Israel dinga govam thilto maicham ahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David'in Israel gamsunga gamdang mi umho chu khopkhom dingin thupeh apen; chule Pathen in sahna dingin songkheng hochu song akhensah-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin David'in kotpi ho kotkhah kilna dingle akisuhto naho kilna-a thihkila man dingin thih atamatam agongin; chule sum-eng chu tejoulou khopma tam,
  </para>
  <para style="p">
    <verse number="4" style="v" />Cedar thing jong atama tam akhol khomin ahi: ajehchu Sidon miho le Tyre mihon David hengah cedar thing tamtah ahinpoh-u ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule David'in, Kachapa Solomon hi chapang cha le ima heloulai ahin, chule Pakai dinga kisading in hi gamjousea minthana le loupina-a choisanga umding ahin: hijeh chun tun keima hiche-a dingchun kigotna neijing kate, ati. Hitichun David'in athi masangin thil tampitah agongtup min ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichun aman achapa Solomon akouvin, Israel Pakai Pathen in sahdingin ngansena apetan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule David'in Solomon jah-a, Kachapa, keima kalungthimin Pakai ka Pathen min dinga in khat sah ding kanagelin ahi:
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla Pakai thu kahengah ahung lhungin, Nangman thisan naso tamlheh jengin, gal nasatah tahho nasat ahin: nangman kamin dinga in nasah louding ahi, ajehchu kamitmu-in leiset chunga thisan tamtah nasotai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ven, chapa khat hingin natin, ama chu chamna mi hiding; chule akimvela amelmaho jouse-a kon choldona kapeh ding ahi: ajehchu amin Solomon hiding ahin, chule ama nikho laija chu Israelte henga chamnale lungmonna kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman kamin dinga in asahding; chule ama kachapa hia, keima apa kahiding ahi; chule keiman atonsotna dinga Israel chunga alenggam laltouna katundoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun kachapa, Pakaiyin naumpi hen; nangma khangtouvin lang, aman nachung changa asei bangtah-in Pakai na Pathen in chu sa-in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai na Pathen danthu chu nanit theina dingin, Pakai sehseh-in bou chihna le het themna, chule Israel chung changa ngansena nape hen ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutengle Israel chung changa Pakaiyin Mosi ana thupeh tepna danho le thutan lhahnaho chu chingthei tah-a najuija ahile kakhantou ding ahi. Hatnin lang hangsanin; kicha hih-in, lungjong lungthoi hih-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun, ven, boipum pumin keiman Pakai in sahna dingin sana talent sangjakhat, dangka talent sang sangkhat; chule sum-eng le thih jong tejoulou khopma tam; chule thingtum le song jong kagong tupmin; nangman nakibelap thei ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chukalvalin natong mi, songkheng them le thing thembol, chule natoh tinchenga khutthem tamtah nakoma aume.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sana, dangka, sum-eng chule thih ajat simjoulou aumin ahi. Hijeh chun kipatdoh-in lang tong jengin; chule Pakaiyin naumpi hen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />David'in jong Israel pipuiho chu achapa Solomon kithopi dingin thu apen:
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai na Pathen'un na-umpiu hilou ham? Chule ningtina cholngahna napeh-u hilou ham? Ajehchu chuche gama chengho chu kakhutna eipeh ahitan ahi, chule agam chu Pakai le amipite masanga suhnema uma ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tun nalungthimu le nahinao chu Pakai na Pathen'u holnan neijun; hijeh chun kipatdoh-un, chule Pakai kitepna thingkhong le, Pathen um le bel thengho chu Pakai mina kisa ding insunga chu napohlut theina dingun Pakai Pathen muntheng sadoh-un, ati.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David ahung teh-a akum ahung tamlheh phatnin, achapa Solomon chu Israel chunga leng dingin apansahtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman Israel pipuiho jouse chu thempuho le Levi ho toh akhomkhom soh keijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun Levi mite kum somthuma lhah achunglamse akisimin ahile: akisim dungjuijun mi pasal cheh sangsomthum le sangget alhinguve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hicheho lah-a sangsomni le sangli hohi Pakai in kisah vetup ding ahiuvin; chule sanggupho chu milenho le thutan ho ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chukalvalin sangli chu kotpi ngahho ahiuvin; chule sanglima chu Pakai vahchoi nadinga kasem manchah ho chu amanuva, Pakai chu avahchoi dingu ahi, tin David'in aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule David'in Levi chapate lah-a Gershon, Kohath chule Merari loi tin amaho chu aloi loijin akhenin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershon mite-a kon Laadan le Shimei;
  </para>
  <para style="p">
    <verse number="8" style="v" />Laadan chapate chu; apipen Jehiel ahin, Zetham, chule Joel, mi thum ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shimei chapate chu; Shelomith, Haziel, chule Haran, mi thum ahiuve. Hiche hohi Laadan pate insung pipui ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Shimei chapate chu; Jahath, Zina, Jeush, chule Beriah ahiuve. Hiche mili hohi Shimei chapate ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Jahath chu apipen ahin, Zizah anina ahi: ahinla Jeush le Beriah'in chapa tampi anei lhonpoi; hijeh-a chu amahohi apu apateu insung dungjuija insung khatna kisim ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kohath chapate chu; Amram, Izhar, Hebron, chule Uzziel, mi li ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amram chapate chu; Aaron le Mosi ahi: Aaron vang chu amale achapate a-itih-a dinga thiltheng chung nungho chu sutheng dingle, Pakai anga gimnamtui halding, ama jending le, a-itih-a ama mina phatthei bohdinga khendoh ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun Pathen mi Mosi thudol chu, achapate chu Levi phunga kiminvo ahitaove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi chapateni chu Gershom le Eliezer ahilhone.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gershom chapate lah-a pipui chu Shebuel ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Eliezer chapate lah-a pipui chu Rehabiah ahin, chule Eliezer'in chapa dang himhim aneipon, Rehabiah'in vang chapa tamtah aneije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izhar chapate lah-a pipui chu Shelomith ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hebron chapate lah-a kon; amasapen Jeriah ahin, anina Amariah, athumna Jahaziel chule alina Jekameam ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uzziel chapate lah-a kon; amasapen Michah ahin, anina chu Jesiah ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Merari chapateni chu; Mahli le Mushi ahilhone. Chule Mahli chapateni chu; Eleazar le Kish ahilhone.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Eliezar chu chapa neilouvin athitan, chanuho bou aneijin: amaho chu asopiteu Kish chapaten akichenpiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mushi chapate chu; Mahli, Eder chule Jeremoth, mi thum ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichehohi apu apateu insung dungjuija Levi chapate ahiuvin, a-insungu kisimna dungjuija kisimdoh, apu apateu lah-a pipui cheh, Pakai in'a kintheng bolna-a pang, kum somni-a lhah achunglamse ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ajehchu David'in, Israel Pakai Pathen'in amite chu Jerusalem'a atonsotna achentheina dingun choldona apei, atin;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Levi mite jah-a jong, Houbuh ahiloule kin bolna-a manchah dinga umle bel ho apohleu ngaitalou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu David thusei nukhahpenho dungjuija Levi mite chu kum somni apat achunglamse kisima ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu atoh dingu chu, Pakai in lhacha natohna-a hongsungho le dansungho-a Aaron chapate kithopi ding, thil thengho jouse sutheng ding, chule Pathen in'a lhacha natoh toh ding;
  </para>
  <para style="p">
    <verse number="29" style="v" />Vetsah changlhah le anneh thilpeh ding changbong nel chung, cholsolou changlhah phengho chung, khangbela agoa kikangmin chule thaova kikangmin chung, chule atam alhom alet aneo chunga mopoh ding,
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule jingkah nilhah seh-a, Pakai thangvah le vahchoina la sadinga dingding,
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule cholngah nikhoho, lhathah nikho ho, chule kut kitep nikho ho-a chu amaho tohding thu kipeh dungjuija, mijat chun Pakai henga govam thilto jouse, Pakai masanga abol jingjeng ding;
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Pakai in'a kintheng bolna-a asopiteu Aaron chapate akithopi ding, chule munthengle mipi Houkhom ho Houbuh vetupma pangding chu ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichehi Aaron chapate kihop khen dan chu hiche hi ahin. Aaron chapate chu; Nadab, Abihu, Eleazar, chule Ithamar ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla Nadab le Abihu chu apao sangin athimasa lhonin, cha anei lhonpoi: hijeh chun Eleazar le Ithamar'in thempu natoh atong lhontan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule David'in Eleazer chapate lah-a Zadok, chule Ithamar chapate lah-a Ahimelech chu alhacha natoh naova atoh dingu ahop peh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ithamar chapate lah-a sangin Eleazer chapate lah-a pipui atamjon, hijeh chun amaho chu akihom khen ahi. Apu apateu insung dungjuijin Eleazer chapate lah-a pipui somlegup aumin, chule apu apateu insung dungjuijin Ithamar chapate lah-a pipui get aumuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun vang vetna konin amaho loikhat le loikhat chu ahomtoh uvin ahi; ajehchu muntheng vetup le Pathen in vetup hochu Eleazer chapate le Ithamar chapate ahigelun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Levi miho lah-a khat, lekhasun Nathaneel chapa Shemaiah chun aminhou chu lengpa le milenho, thempu Zadok le Abiathar chapa Ahimelech angsung, chule thempuho le Levi ho apu apateu insunga apipen cheh angsunga chun asunlut tan: apu apateu insunga abulpen dingin Eleazer dingin mi khat, Ithamar dingin mi khat akilan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun, vang masapen chu Jehoiarib chungah achun, anina Jedaiah chungah,
  </para>
  <para style="p">
    <verse number="8" style="v" />Athumna Harim chungah, alina Saorim chungah,
  </para>
  <para style="p">
    <verse number="9" style="v" />Angana Malchijah chungah, agupna Mijamin chungah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Asagina Hakkoz chungah, agetna Abijah chungah,
  </para>
  <para style="p">
    <verse number="11" style="v" />Akona Jesuah chungah, asomna Shechaniah chungah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Asomle khatna Eliashib chungah, asomle nina Jakim chungah,
  </para>
  <para style="p">
    <verse number="13" style="v" />Asomle thumna Huppah chungah, asomle lina Jeshebeab chungah,
  </para>
  <para style="p">
    <verse number="14" style="v" />Asomle ngana Bilgah chungah, asomle gupna Immer chungah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Asomle sagina Hezir chungah, asomle getna Aphses chungah,
  </para>
  <para style="p">
    <verse number="16" style="v" />Asomle kona Pethahiah chungah, asomnina Jehezekel chungah,
  </para>
  <para style="p">
    <verse number="17" style="v" />Asomnile khatna Jachin chungah, asomnile nina Gamul chungah,
  </para>
  <para style="p">
    <verse number="18" style="v" />Asomnile thumna Delaiah chungah, asomnile lina Maaziah chungah achun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche hi Pakai Israel Pathen'in apau Aaron ana thupeh dungjuija, anoija atoh ding danu, Pakai insunga ahunglut uva alhacha natoh dingu kihop khen dan chu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Levi chapate amohse chu hichehohi ahiuve: Amram chapate lah-a kon, Shubael; Shubael chapate lah-a kon, Jehdeiah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rehabiah chungchang chu: Rehabiah chapate lah-a kon, amasapen Isshiah ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izhar mite lah-a kon, Shelomoth: Shelomoth chapate lah-a kon, Jahath.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Hebron chapate chu: akhatna Jeriah, anina Amariah, athumna Jahaziel, alina Jekameam ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Uzziel chapate lah-a kon, Michah; Michah chapate lah-a kon, Shamir ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Michah sopipa chu Isshiah ahin: Isshiah chapate lah-a kon, Zekeriah ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Merari chapateni chu Mahli le Mushi ahilhone; Jaaziah chapa chu Beno ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Merari chapate Jaaziah' akon chu Beno, Shoham, Zaccur chule Ibri ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mahli'a konin Eleazar apengin, aman chapa aneipoi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kish chungchang chu: Kish chapa chu Jerahmeel ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chujongle Mushi chapate chu; Mahli, Eder chule Jerimoth ahiuve. Hitehohi apu apateu insung dungjuija Levi ho chate ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amahohin hitima chun asopiteu Aaron chapate bangin lengpa David, Zadok, Ahimelech chule thempuho le Levi ho insunga apu apateu lah-a pipui cheh angsunga chun vang aveovin ahi. Insung pate pipuiho chun asopiu neojoho bolbang bang chun aboltauve.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukitle David le asepai janel lamkai hon, lhachana tong dingin Asaph chapate, Heman chapate, chule Jeduthun chapate lah-a konin phabep achomkhenun; amaho chun selangdah, tumging, chule thih khutbeh toh tho-a gaothu aseidingu ahi. Chule chutobanga tongding ho mijat chu:
  </para>
  <para style="p">
    <verse number="2" style="v" />Asaph chapate lah-a konin: Zaccur, Joseph, Nethaniah, chule Asarelah ahiuve, achapate sehi Asaphmin alamkaijin lengpa thupeh dungjuijin gaothu aseijuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jeduthun'a kon: Jeduthun chapate chu, Gedaliah, Zeri, Jeshaiah, Hashabiah chule Mattithiah, mi gup ahiuvin; apau Jeduthun tumgingtoh tho gaothusei khutnoija Pakai loupisah dingle vahchoi ding ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Heman'a kon: Heman chapate chu: Bukkiah, Mattaniah, Uzziel, Shebuel, Jerimoth, Hananiah, Hanani, Eliathah, Giddalti chule Romamti-ezer, Joshbekashah, Mallothi, Hothir chule Mahazioth.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiteho jousehi Pathen thu dungjuija saki mutding lengpa mitvahnei themgao Heman chapate ahiuve. Chule Pathen'in Heman chu chapa somleli le chanu thum apen ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hicheho jousehi lengpan Asaph, Jaduthun chule Heman athupeh dungjuija apau khut noija, Pakai in'a thih khutbeh le, chule selangdah tho-a Pathen in'a kintheng kibolna-a kimang cha-a lasa loi ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun amaho amijatnu chu, asopihou Pakai la ho kihil themsa cheh pumin mi jani leh somget le get ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule atohding chanu chu akibah cheh nadingin, alen jong aneo jong, mihil jong jillai jong abonchauvin vang aveovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun vang masa chu Asaph chapa Joseph chungah achun: anina chu Gedaliah chungah achun, amale asopite chule achapate somleni ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Athumna chu Zaccur chungah achun, amale achapate, chule asopite somleni ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Alina chu Izri chungah achun, amale achapate chule asopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angana chu Nethaniah chunga achun, amale achapate chule asopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Agupna chu Bukkiah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Asagina chu Jesharelah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Agetna chu Jeshaiah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akona chu Mattaniah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Asomna chu Shimei chungah achun, amale achapate chule asopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Asomle khatna chu Azareel chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Asomle nina chu Hashabiah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asomle thumna chu Shubael chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Asomle lina chu Mattithiah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Asomle ngana chu Jeremoth chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Asomle gupna chu Hananiah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Asomle sagina chu Joshbekashah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Asomle getna chu Hanani chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Asomle kona chu Mallothi chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Asomnina chu Eliathah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Asomnile khatna chu Hothir chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Asomnile nina chu Eliathah chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Asomnile thumna chu Mahazioth chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Asomnile lina chu Romamti-ezer chungah achun, amale achapate chule sopite mi somleni ahiuve.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kotngah ho kihopdan thudol: Kor mite-a kon Asaph chapate lah-a Kore chapa Meshelemiah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Meshelemiah chapate chu; apeng masapen Zechariah ahin, anina Jediael, athumna Zebadiah, alina Jathniel,
  </para>
  <para style="p">
    <verse number="3" style="v" />Angana Elam, agupna Jehohanan, asagina Elioenai ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chukitle Obed-edom chapate chu; apeng masapen Shemiah ahin, anina Jehozabad, athumna Joah, alina Sacar chule angana Nethaneel,
  </para>
  <para style="p">
    <verse number="5" style="v" />Agupna Ammiel, asagina Issachar, agetna Peullethai ahi; ajehchu Pathen'in ama phatthei aboh-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujongle achapa Shemaiah'a konin chapate, apateu insunga vaipoho apenguve; ajehchu amaho chu mihat hangsan ngen anahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shemiah chapate chu; Othni, Rephael, Obed, chule Elzabad ahin, asopiteniu Elihu le Samachiah chu mihat ahilhone.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hicheho jousehi Obed-edom chapate ahiuvin; amahole achapateu chule asopiteu jouse kinbolna dinga mibulhing cheh chu, Obed-edom kon mi somgup le mini ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Meshelemiah chun chapa le sopi mihat cheh somleget aneijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Merari chate lah-a Hosah'in jong chapate ahingin, Simri chu apipen (apeng masapen ahilou vangin ama chu apan apipui penin anasemin) ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anina Hilkiah, athumna Tebaliah, alina Zekeriah ahin, Hosah chapate le asopite jouse chu somlethum ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hicheho lah-a amaho loihi apipuiho lah jenga jong Pakai in'a natong dinga chan neija, houin kot ngah dinga kihom khen ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amahon alen aneo abonin, apateu insung dungjui cheh-in, kotphung jouse-a dingin vang asang uve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin nisolama dinga vang chu Shelemiah chunga achutai. Chujouvin thumopthem milungching chapa Zechariah dinga vang asanuva ahile sahlam sanga din alhatai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Obed-edom dingin lhanglam alhan, achapatea dingin thil koikhomna mun alhai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shuppim le Hosah dinga vang kisan chu lhumlam, khonga nale khongahna kikah lampi kaltouna-a um Shallecheth toh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Niso lamah Levi mi migup aumun, sahlama nikhat in mi li aumin, lhang lamah nikhat in mi lima aumin, chule thil koikhomna mun'a mi nini aumin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lhumlam inhongsung lutna song lampia mi li, chule inhongsungah mi ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichehohi Kore chapate lah le Merari chapate lah-a kotngah ho kihop khen dan chu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Levi ho lah-a Ahijah chu Pathen in'a gouthilho le thilthengho chunga vaihom ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Laadan chapate chungchang ahile, Laadan chu Gershon chapate lah-a khat, apu apate insunga aluchang ahin, Laadan chate lah-a chu Jehieli ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jehieli chapate; Zetham le asopipa Joel chu Pakai in'a gouho chunga ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amram mite, Izhar mite, Hebron mite chule Uzziel mite lah-a;
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosi chapa Gershom chapa Shebuel chu gouho chunga vaipo ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Eliezer'a kona asopite chu: achapa Rehabiah ahin, Rehabiah chapa chu Jeshaiah ahin, Jeshaiah chapa chu Joram ahin, Joram chapa chu Zichri ahin, chule Zichri chapa chu Shelomith ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche Shelomith le asopite hi David lengpa le insung pateho luchang, sepai sang lamkaiho ja lamkaiho, chule sepai janel gal lamkai hon atodoh-u gouho chunga vaipo ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kidouna munho-a thil kichom phabep chu Pakai in'a manchah dingin atohdoh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule mitvahneipa Samuel, Kish chapa Saul, Ner chapa Abner, chule Zeruiah chapa Joab tehon atodoh jouseu chule koihile ato channu chu Shelomith le asopite khutnoija um ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Izhar mite lah-a kon Chenaniah le achapate chu Israel chunga polam kin mopo ahiuvin, milenle thutan ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Hebron mi Hashabiah le asopite mihangsan cheh mi sangkhat le jasagi ho chu Jordan vadung lhumlama vaipole vetupmin apangun, chule Pakai kin bol le lengpa natong ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hebron mite lah-a Jerijah chu apu apateu khanggui dungjuijn Hebron mite lah-a apipu pen ahi. David kum somli alengchan kum-in amaho chu akholuvin ahile, Gilead gam Jazer kho-a alah uva mihat hangsanho chu phabep amudoh-un ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule asopite chu mihangsan le pipui cheh mi sangni le jasagi ahiuvin, amaho chu David lengpan Reuben mite, Gad mite, chule Manasseh phung kehkhat chunga, Pathen lam thil tintang le, lengpa kinbolna-a, vaipo-a apansah-u ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Israel chate amijatnu chu, apipui cheh, pate pipuiho le sepai sangkhat lamkaihole ja lamkaiho, chule akihop dungjuija lamjouse-a lengpa natong kum lhung keija alha alha-a ahung lhungle apotdoh jing jengho chu mi sangsomni le sangli ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aphat kihop dungjuija alha masapena lamkai chu Zabdiel chapa Jashobeam ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama chu Perez chate lah-a apipui pentah, alha masapena sepai janel jouse lamkai pen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule alhani channa loi lamkai chu Ahoh mi Dodai ahin, aloi lah-a chun Mikloth jong vaipo khat ahin, ama hon lah-a jong chun mi sangsomni le sangli ma aumui.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alhathum channa sepai janel jalamkai thumchanna chu thempu pipui khat Jehoiada chapa Benaiah ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche Benaiah hi ahi mihat somthum lah-a panga, chule somthum lah-a achungnung pen chu: ama loija chun achapa Ammizabad apange.
  </para>
  <para style="p">
    <verse number="7" style="v" />Alha lina-a gallamkai lina chu Joab sopipa Asahel ahin, chule ama bana achapa Zebadiah ahi; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Alha ngana-a gallamkai ngana chu Izrah mi Shamhuth ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="9" style="v" />Alha gupna-a sepai jalamkai gupna chu Teko mi Ikkesh chapa Ira ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="10" style="v" />Alha sagina-a gallamkai sagina chu Ephraim chate lah-a Pelon mi Helez ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="11" style="v" />Alha getna-a gallamkai getna chu Zarh mite lah-a Husath mi Sibbecai ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Alha kona-a gallamkai ko nachu Benjamin mite lah-a Anetoth mi Abiezer ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Alha somna-a gallamkai somna chu Zarh mite lah-a Netophah mi Maharai ahi; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alha somle khatna-a gallamkai somlekhatna chu Ephraim chate lah-a Pirathon mi Benaiah ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Alha somleni na-a gallamkai somlenina chu Othniel chate lah-a Netophah mi Heldai ahin; ama loi lah-a chun mi sangsomni le sangli aumui.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chukalvalin Israel phungho chunga: Reuben mite chunga vaipo chu Zichri chapa Eliezer ahin; Simeon mite lah-a, Maachah chapa Shephatiah ahin,
  </para>
  <para style="p">
    <verse number="17" style="v" />Levi mite lah-a, Kemuel chapa Hashabiah ahin; Aaron mite lah-a Zadok ahin:
  </para>
  <para style="p">
    <verse number="18" style="v" />Judah mite lah-a, David sopite khat Elihu ahin; Issachar mite lah-a, Michael chapa Omri ahin:
  </para>
  <para style="p">
    <verse number="19" style="v" />Zebulun mite lah-a, Obadiah chapa Ishmaiah ahin; Naphtali mite lah-a Azriel chapa Jerimoth ahin:
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim chate lah-a, Azaziah chapa Hoshea ahin; Manasseh phung kehkhat lah-a, Pedaiah chapa Joel ahin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Manasseh phung kehkhat lah-a Gilead'a Zekeriah chapa Iddo ahin; Benjamin phung lah-a, Abner chapa Jaasiel ahin:
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan mite lah-a, Jeroham chapa Azareel ahin. Hichehohi Israel phung sunga pipuiho ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahivangin David'in kum somni-a pat anoilamse chu ajat anasim thapoi: ajehchu Pakaiyin Israelte chu van'a ahsi ho banga apunsah ding ahi tia anaseisa ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeruiah chapa Joab'in ana simpantan, ahinla ana simjou manpoi,;ajehchu Israelte chungah lunghanna achutan, David lengpa thusimbua jong ajat akisut tha tapoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule lengpa gouho chunga vaipo chu, Adiel chapa Azmaveth ahin; chule loujaoho-a le khopiho-a, kho neoho le kul sangho-a thilkeo koikhomnaho chunga vaipo chu Uzziah chapa Jonathan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule loujaova loukaija pangho jouse chunga vaipo chu Chelub chapa Ezri ahi:
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Lengpilei ho chunga vaipo chu Ramath mi Shimei ahin; lengpitwija dinga lengpigaho chunga vaipo chu Shiph mi Zabdi ahi:
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule phaicham munnem ho-a Olive thingho le theichang thingho chunga vaipo chu Geder mi Baal-hanan ahin; chule thao kholkhomnaho chunga vaipo chu Joash ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Sharon'a kivah ganchahon ho chunga vaipo chu Sharon mi Shitrai ahin; chule phaichama ganchahon ho chunga vaipo chu Adlai chapa Shaphat ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sangongsang ho vetup chu Ishmael mi Obil ahin; chule sanganho vetup chu Meronoth mi Jehdeiah ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule kelngoihon vetup chu Hager mi Jaziz ahi. Hicheho jousehi David lengpa neichunga vaihomho ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule David pangah Jonathan chu thumop ahin, michingtah chule lekhasun ahi: chule Hachmoni chapa Jehiel chu lengpa chapate toh umkhom ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule Ahithophel chu lengpa thumop ahin, Arch mi Hushai chu lengpa kiloipi ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Ahithophel bana chu Benaiah chapa Jehoiada le Abiathar ahilhonin, chule lengpa Galsat ho gallamkai lenpen chu Joab ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin David'in Israel pipuiho jouse, phung pipuiho, chule aphat kihop dungjuija lengpa nehle chah sutupma pang loi lamkaiho, asang sang chunga lamkaiho, aja aja chunga ja lamkaiho, chule lengpa neile gou jouse vetupma pang neiching ho, achapate le milen milal ho jouse, chule mihangsan ho jouse chu Jerusalem'a akoukhom sohkeijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin David lengpa chu adingdoh-in, Kasopite le kamiteho, kathuseihi ngaijuvin, keiman Pakai kitepna thingkhong kicholdona ding le, i-Pathen'u kengto ngapna ding in sah ding kalungin kana ngaiton, in sahna ding jong kagongtoh soh hel tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla Pathen'in kajah-a, Nangman kamin dingin in nasah louding ahi, ajehchu nangma galsat mi nahin, thisanso mi nahije, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeng jongle Israel Pakai Pathen'in kapa insung jouse lah-a atonsotna Israel leng hidingin eina lhengtan ahi; ajehchu aman Judah phunga kapa insung alhengin, chule kapa chapate lah-a konin Israel jouse chunga leng hidingin keima eina deilhentai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule kachapate jouse lah-a jong, (ajehchu Pakaiyin chapa tamtah einapen,) Israelte chunga Pakai leng laltouna-a tou dingin kachapa Solomon hi alhengtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule aman kajah-a, Nachapa Solomon, aman ka in le kahong sungho asah ding ahi; ajehchu amachu kachapa dinga kalhendoh ahitan, keima apa kahi ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujongle aman kathupeh ho le kathutan lhahho chu tunia banga hi anit jinga ahile, ama lenggam chu atonsotna dinga kasemdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun tun, Pakai mipi ho Israel jouse mitmule, Pathen jah tah-a kasei ahi, Pakai na Pathen'u thupeh ho jouse chu holunlang nitnun; chutile hiche gampha hi nalouva, nangho nunga nachateo goulo ding a-imatih chana dinga nadalhah peh thei dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nangma, kachapa Solomon, nangman napa Pathen hi hejingin lang, lungsung chamkimkei le lungthim thanom tah-in jenin; ajehchu Pakaiyin lungsung jouse akholin, lungsunga lunggel ho jouse jong ahesoh keije. Ama nahola ahile namu ding: amavang amachu nadalhah-a ahile, aman atonsotna dinga nanotthap ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun chingtheijin, ajehchu Pakaiyin muntheng sadinga nalhendoh ahitai: hatninlang hichu tongin, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin David'in achapa Solomon chu hongcha lim, in lim, asumkholna in lim, inchungdan lim, indan sungnung lim, chule hepi touna mun lim kigongho chu apen,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule lhagaova kona agontoh lim jouse, Pakai in hongsung, chule akimvela indanho jouse, Pathen in'a goukhol khomna, chule akikatdoh thilho kholkhom lim chu apen;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujongle thempuho le Levi mite aloi aloija aumna dingu mun limho, Pakai in'a kinbolna ding jouse limho, chule Pakai in'a kinbolna-a kimangcha ding um le bel limho jong,
  </para>
  <para style="p">
    <verse number="14" style="v" />Kinbolna-a sana kimang ding jouse chu sana-a kisem din atedohpeh-in apen, kinbolna-a dangka kimang ding jouse jong chu akin jatna manchah dingin dangka atedohpeh-in;
  </para>
  <para style="p">
    <verse number="15" style="v" />Sana meivah ho geijin, sana meivah khom ho ding, sana-a kisem meivah ho takip ding: chule dangka meivah ho ding jong atepeh cheh-in, meivah dingle ameivahkhom dingin jong, ameivah dungjuijin atedohpeh cheh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule vetsahna changlhah dokhangho semna ding le dokhang jouse-a dingin sana ape-in; chule chutima chun dangka dokhangho semna ding dangka agih tesan apen ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujongle satul kaho ding, lhengkong ho ding, khonho dingin sana thengsel atepeh-in; chule sana kongdal ding ho-a dingin, sana kongdal khatcheh dingin sana tesan apen; chutobangma chun dangka kongdal khat khat ding jong dangka tesan apecheh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule gimnamtui maicham ding sana kilha thengsel, chule Pakai kitepna thingkhong khukhum na-a alha jah Cherub kangtalai dingin sana apen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />David'in, Hicheho jousehi Pakaiyin ama khutna kachunga suttho-a, nakitoh dingdan lim jouse hi eihetsah ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule David'in achapa Solomon jah-a, Hatninlang hangsanin, chule hichu tongin; kicha hih-in, chule lung jong lungthoi hih-in; ajehchu Pakai Pathen, ka Pathen ngeichun naumpi ding; aman nalosam sah louding, Pakai in kinbolna natohho jouse nachaidoh kahse-a da jong nadalhah lou ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ven, aloi aloija kihomtoh thempuho le Levi mite chun Pathen in'a kin kibolna jouse-a dinga naumpi jing dingu ahin; chule ipi kinbolna hijengjongle natohna jouse-a thanom tah natong themgil mihon naumpi dingu: chujongle pipuiho le mipi ho jouse chu nathupeh-a umdiu ahi, ati.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chukit jongle leng David'in mipi ho jouse jah-a chun, Pathen bouvin alhendoh kachapa Solomon hi achapang nalaijin ima ahenaipon, anatoh ding hila alen lheh jengin ahi. Ajehchu hiche leng inpihi mihem'a ding ahipon, Pakai Pathen'a ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tun kahatna jousen ka Pathen in dingin sana-a kisem thilho dingin sana, chule dangka-a kisem thilho dingin dangka, chule sum-enga kisem thilho ding sum-eng, chule thih-a kisem thilho dingin thih, chule thinga kisem thilho dingin thing: Song engdang songho, setding songho, avahthei songho, ajem chomchom le song mantam jat chomchom, chule songkang atama tam kagotan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chukalvalin, ka Pathen in kangailut behseh jal-in, hiche in theng dinga kagot ho chungvumin jong, keima tuma dinga kanei sana le dangka jong ka Pathen in dingin kapen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abangho jephoina dingin Ophir sana, sana talent sangthum, chule dangka thengsel talent sangsagi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Amanchahna ding jat chomchoma natong themhon amanchah dingun, sana thil manchahna dinga manchah dingin sana, chule dangka manchahna dinga dangka kapen ahi. Ahile tunia Pakaiya natohna-a dinga kiphal tah-a kipenom koi umem? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun apu apateu pipuiho, chule Israel phungho lah-a pipuiho, chule sangkhat chungle jakhat chunga lamkaiho chun lengpa natohna-a vaipo sese toh kiphal tah-in,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pathen in sahna dingin sana talent sangnga le dram sangsom, chule dangka talent sangsom, chule sum-eng talent sangsom le sangget, chule thih talent sangjakhat apeuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule song mantam neiho chun Gershon mi Jehiel khutna Pakai in gouthil kholkhom na-a dingin apeuvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun mipi ho chu Pakai dinga alung pumpiuva kiphal tah-a thil apehjeh-u chun athanom lheh jengun, chule leng David jong kipa mainah-in akipahpon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun houkhom ho jouse masang-ah David'in Pakai chu avahchoijin: chule David'in hitin aseije, Kapu kapau Israel Pakai Pathen, nangma atonsot atonsotnin nunnom jingin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai, letna, thaneina, loupina, galjona, choi-atna jouse nanga ahi: ajehchu van'a le leija thil jousehi nangma-a ahin, Vo Pakai lenggam chu nangma-a ahin, ijakai chungvuma aluchang hidinga choisang nahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Haonale jana agoma nanga hungkon ahin, chule nangma ijakai chungvuma vaihom nahi; chule nakhutna thilbol theinale thahat aumin; chule nakhutna mijouse dinga loupisah nading le thahat pehtheina aume.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun tun, ka-Pathen'u, nangma kathangvah-un, namin loupi kavahchoi juve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijongle keimahi koi kahia, ka mipite jonghi ipi hiuva, hitobang khopma kiphal tah-a kapeh theiju hija ham? Ajehchu thil jousehi nanga hungkon ahin, chule nangma-a mama chu kahin lepeh kitnu ahibouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu keiho hi nangma angsunga kapu kapatehou jouse banga maljin le khopem bou kahiu ahi: chule leiset chunga kahinkhouhi le-lim tobang bou ahin, aumden ding imacha aumpoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vo Pakai ka Pathen, namin theng dinga in kasahpehna diuva, kakigot nao hiche thil hijatpi hi nangma khutna kon bou ahin, abonchan nangma-a ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka Pathen, nangman lungsunghi napatep jin, chondihna chunga nalunglhaije tijong kahei. Keijong kalungsung chondih na-in thilho jousehi hongphal tah-in nangma kanapetan: tun kipah tah-in namite hilaija umho hin kiphal tah-a nahenga athilpehhou kamutan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo Pakai, kapu kapateu Abraham, Isaac chule Israel Pathen, hitobang lunggel hi namite lungthima a-itih-a aumjing theina dingin koijingin lang, nangman alungsungu gongtoh-in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule kachapa Solomon hin nathupeh ho, nathu hettohsah ho, nachon danho anitna, hicheho jousehi abolna ding le, chule kana ngaito in loupi hi asahthei nadingin lungsung phachamkim hinpen, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin David'in mipi ho jouse jah-a, Tun Pakai na Pathen'u chu vahchoijun, ati. Chuin mipi ho jouse chun apu apateu Pakai Pathen chu avahchoijun, chule akunun, Pakai le lengpa chu chibai aboh-un ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin chuche nikho jou ajingin Pakai hengah ganlhaina asemun, chule Pakai henga govam thilto din bongchal sangkhat le kelngoichal sangkhat, chule kelngoinou sangkhat toh, donding thiltoho toh Israel pumpi dingin ganlhaina tampitah asemun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hiche nikho chun kipah thanom tah-in Pakai angsunga chun aneuvin adontauvin ahi. Chule amahon David chapa Solomon chu anivei channa-in leng dingin asemkitnun, chule Pakai henga vaipo pipuipen hidingin thao anuvin, chule Zadok chu thempun asemun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun Solomon chu apa David khelin Pakai laltouna-a chun lengin atoutan, chule akhangtouvin; chule Israelte jousen athu angaijun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule pipuiho jouse, mihangsan jouse, chule Leng David chapaho jouse jongchu leng Solomon henga chun akipelut taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Pakaiyin Israel jouse mitmun Solomon chu nasatah-in achoisangin, chule Israel gamsunga ama masanga leng khatchan jong aneikhah louvu leng hina loupina achansah tai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitichun Jesse chapa David chu Israel jouse chunga chun lengvai apon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama Israel chunga alengchan sungchu kum somli ahin, Hebron'a kum sagi aleng changin, chule Jerusalem'a kum somthumle kumthum aleng changin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ama upatah le tehkem keijin, chule haotah le jabol changpumin athitan ahi; chule ama khelin achapa Solomon chu alengchang tan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tun, David lengpa natohho abula patna achaina gei chu, veuvin, mitvahnei Samuel lekhabu le Nathan themgao lekhabu, chule mitvahneipa Gad lekhabu ho-a akisunsoh keijin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Alengvai poh thu jouse le athahatje, chule ama chungle Israel chung, chule gamjousea lenggam jouse-a thilsoh jouse chu achongsoh keijin ahi.
  </para>
</usx>
