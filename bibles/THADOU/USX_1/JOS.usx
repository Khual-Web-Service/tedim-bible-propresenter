<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JOS" style="id">Joshua</book>
  <para style="h">Joshua</para>
  <para style="toc1">Joshua</para>
  <para style="toc2">Joshua</para>
  <para style="mt">Joshua</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai soh Mosi athijouvin ahitin ahi, Mosi lhacha Nun chapa Joshua henga Pakaiyin hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasoh Mosi athitan, hijeh chun tun kipat in, nangmale hiche mipi jouse, amaho Israel chate dinga kapeh gam jondingin hiche Jordan hi galkaijun lang cheovin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi henga kana seibangin, nakengton achotphana chanchu nang kapeh nahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Gamthiple hiche Lebanon apat Euphrates vadunglen, Hit mite gamjouse chuleh nilhum lama twikhanglen gei nangma gamsung hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nahinlai sungse-a koimacha namasanga ding joulou ding, Mosi kana umpi banga nangma jong kaumpi ding nahin, nangma nadalha pongting, nujong nanuse ponge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hatninlang hangsanin, ajehchu apateu pehdinga kana kihahsel gam chu alodiuva hiche mitehohi nahoppeh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kasoh Mosi juidinga kapeh dan jouse nabola nachintup theina dingin, nangma hatpou pouvin lang hangtah-in umin. Nachena channa naphattheina dingin, chua kon chun jet le veija kihei mang loujenin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche danthupeh buhi nakamtoh kikhenkah hih hen, amavang asunga kisunho dungjuija nabola nachintup theina dingin sunle jan-in lunggiltah-in ngaiton. Chutile nalampi lamjangpeh a nalolhinsah ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman nangma kanathupeh hilouham? hatninlang hangin, kicha hih-in, lungjong lungthoi hih-in. Ajehchu Pakai na Pathen'in nachena chana naumpi jinge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Joshua chun mipi vaipoho jouse chu thu apen aseije,
  </para>
  <para style="p">
    <verse number="11" style="v" />Gebuh lailunga cheovinlang mipi jah-a nehlechah kigot tupmun, ajehchu Pakai na Pathen'in lodinga napeh-u gamchu che-a galodinga, nithum sunga hiche Jordan hi nagalkai dingu ahi, tin mipi thu gapeuvin, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Reuben mite, Gad mite chule Manasseh phung akehkhat ho henga Joshua'n hitin aseijin,
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai na Pathen'un nakicholdo sah un, chule hiche gamhi napetaove, tia Pakai lhacha Mosi'n nangho henga napeh-u thuchu geldoh un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na-inneipiteu, nachasenhou chule nagancha hou Mosi'n napehnao Jordan gal hilama umden hen. Ahinla manchah choi miho galhangho jouse, masanga anacheuva, amaho na kithopi diu,
  </para>
  <para style="p">
    <verse number="15" style="v" />nangho napeh banga Pakaiyin nasopi hou akicholdosah masangse-a, chule Pakai na Pathen'in amaho apeh-u gamchu alo masangseuva naki thopi diu ahi. Chujoule Jordan solama umna gam nalo diuva Pakai soh Mosi'n napeh-u gama chu nakile uva nalodiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amahon neithupeh jouseu chu bolungting neisolnao channa cheovinge tin Joshua adonbutnun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Imajousea Mosi thu kanangai bangun nangma thujong lunglut tah-in ngai uvinge, Pakai Pathen'in Mosi aumpi bangin nangma jong naumpi teihen atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nathupeh douva chule nathupeh ngailou koi hijongle kithat ding ahi, hang pou pouvin lang hattah-in umin, atiuve.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nun chapa Joshua'n Shittim'a konin mini guhthimin gam velhi dingin asollin, chelhon inlang gamchu adeh-in Jericho gave lhonin tin aseipeh-in ahi. Chule amani amin Rahab kiti notinu in'a chun ahunglhonin, ageh lhontai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule veuvin, tujanhin gam velhi dingin Israel chilhah ho hikoma ahunguve, tin Jericho khopi lengpa chu thu ahilun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun Jericho lengpan nahenga na-inna hunglut miteni chu hinpui doh-in; ajehchu amani gamjouse velhi dinga hunglhon ahi ti seidingin Rahab henga mi asolle.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin numeinu chun miteni apuidoh-in, asellin, henge kahenga mini ahunge, ahinla hoija hungkon ahilhon vang kahepoi, tin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule ahitin ahi, kotpi khachah phat don, khothim phatnin, miteni chu achedoh lhontan, hoija achelhon kahepoi. Mangang tah-in amani chu nungdelun, ajehchu phapaovin nate ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla amanun, amani chu in chunga apuitouvin, akisetoh changpol lah-a chun aseltai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin mihochun miteni chu Jordan kaimun lampi geipeh chun anungdellun, chule anungdelho chu apotphatnun kul kotkhah chu akhah taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amani ahung kumlhon masangin in chunga amanu akaldoh-in,
  </para>
  <para style="p">
    <verse number="9" style="v" />chule amanun Pakaiyin hiche gam napeh-u ahitai, nangho gin nahi kachunguva achun, chule nangho jeh-a hiche gama chengho jouse kihotlhugam dingu ahitai ti kahei, tin miteni chu aseipehtai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu Egypt'a kona nahungpot doh uva Pakaiyin twipisan chu nangho dinga iti akansah-a, chule nanghon nathagamhelu Jordan gal langkhatna um Amor leng teni Sihon le Og chunga ipi nabolu chu kanajaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hichehi kajahjah-un kalungu ajunlha tai, nangho jeh-in koimacha chunga hanna himhim aumtapoi. Ajehchu Pakai na Pathen'u chu chunga leh noija Pathen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun tun kangeh nahi lhone, Pakai minin kahenga kihahsel lhonin, keiman nangni lungsetna kamusah tah jeh-in, Nangnin jong kapa insung chunga lungsetna neimusah lhoninlang, melchihna dihtah neipe lhonnin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuti chun, kanule kapa, kasopi numei ho le pasal ho, chule aneijouseu neihinghoi peh-un lang, kahinkhouhi thina-a konin neihuhdoh peh-un, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin miteni chun amanu jah-a, kathilbol lhonhi naseidohlouva ahile nanghodin kahinna tohlhoninge. Chule hung hitiding ahi, Pakaiyin hiche gamhi eipeh tengule lungsetna neitahle dihtah-in nangma nabollunge tin adonbut lhone.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin amanun amani chu bangkotna konin khaovin akhailhatai. Ajehchu amanu in chu khopi kulchunga kisa ahin, chule ama kul chunga chu chenga ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amanun, amani jah-a, mol langa lampia khun chelhonin, nanungdel hon mugetnun nate. Chule nanungdel ho akilekit kahseovin nithum sung gakisel lhonin, chule chujou tengle chethei lhontan nate.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichun miteni chun amanu jah-a, neiki hahsel sah nalhon kitepna achun mona neilhon hih inge.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vetan, keiho hiche gam kahunglut tengule, hiche neikhai lhah nalhon bangkotna hi patkhao santhip nakhiding, chule nanule napa nasopi pasal ho, chule napa insungmite jouse na-inna anapuikhomin,
  </para>
  <para style="p">
    <verse number="19" style="v" />chule hitiding ahi. Koi hijongle na-inna kona kholaija potdoh aumleh mona thisan chu aman akipoh ding, keiho themmo hilouding ahi. Chule koihile na-inna naumpi chunga khutlha aumle athisan chu kaluchunguva chuhen,
  </para>
  <para style="p">
    <verse number="20" style="v" />chule kathilbol lhonhi naseidoh a ahile, neiki hahsel sah lhon kitepna-a kona chu mo kachan lhon louding ahi atilhone.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amanun nasei bang banglhon chu hitahen, ati. Chuin amanun amani chu asolmangin apotdoh lhontai. Chuin amanun pat santhip chu bangkotna akhaitan, ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amani mollama chun achelhonin, anungdelho akinungle kahseovin chua chun nithum agaum lhone. Chuin anungdelho ahung kinungle uvin lamjousea aholun amutapouve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichun miteni chu molla konin ahung kumsuh lhonin, agalkai lhonin akilekit lhontai. Chuin Nun chapa Joshua henga ahunglhonin, achung lhona thilsoh jouse chu ahenga aseipeh lhontai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amanin tahbeh-in Pakaiyin gamjousehi ikhutnuva eipehdoh-u ahitai. Ajeh chu agama cheng jouse chu eihojeh-in akihot lhugam taove tin Joshua henga aseipeh lhone.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Joshua jingpitah in athouvin, chule Shittim'a konin akipat doh-un, Jordan lui ahunglhung taove. Amale Israel chate jouse agalkai masangun chua chun ageh taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi. Nithum jouvin lamkaiho chu gebuh lah-a chun acheuvin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amahon mipi ho chu Pakai na Pathen thulhun thingkhong chu Levi thempuhon aput namu phat tengule naum naova konin kichon unlang chuche nungchu najuidingu ahi, tin thu apeuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla nanghole hiche kikah chu tong sangni tobanga nakigamlat diu, nachenadiu lampi nahet theina dingun, nai hihhelun. Ajehchu tumasangin hiche lampia hin nanache khapouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Joshua'n mipi jah-a, nangho kisuthengun ajehchu Pakaiyin jingleh nalah uva thilkidang abolding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Joshua'n thempuho jah-a, thulhun thingkhong chu puvinlang mipi masanga chun cheovin, ati. Chuin amahon thulhun thingkhong chu apuvin mipi masanga chun achetauve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Pakaiyin Joshua jah-a, keiman Mosi kana umpi bang banga nangma jong kaumpi ding nahi, ti amahon ahetheina dingun tunia hi Israel pumpi mitmu-a kachoi sang panding nahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangman thulhun thingkhong pu-a pang thempuho jah-a, Jordan vapam chin nagei phat nule Jordan'a nadindendiu ahi, tin thu pen, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hitichun Joshua'n Israel chate jah-a, hilama hungun lang Pakai na Pathen'u thuhi ngaijun, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Joshua'n hia konahi hingjing Pathen nalah uva aume ti nahet dingu ahi. Chule aman Kanaan mihole Hit miho, Hiv miho Perizz miho, chule Girgash mihole Amor miho chule Jebus miho thonlou hela namasanguva adeldoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Veovin, leiset pumpi Pakai thulhun thingkhong chu namasanguva Jordan lui galkai ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun tun phung khatna mikhatcheh Israel phungho-a konin somleni lhengdoh-un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hung hitiding ahi. Pakai leiset pumpi Pakai thulhun thingkhong pu-a thempuho kengin achot chot nuleh Jordan twipi chu kiting tanding sahlama kona hunglong twipia kona chu kikhendoh ding, chule hichu aloma kiting dending ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ahitin ahi, mipihole mipi masanga thulhun thingkhong pu-a thempuho Jordan galkai nadinga aponbuh uva kona akipatdoh phatnun,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule thingkhong puho Jordan lui aga lhunuva, thingkhong pu thempuho keng chun twi agahchot lutnule, (ajehchu chang atlai sungsele Jordan luihi longletji ahi).
  </para>
  <para style="p">
    <verse number="16" style="v" />Sahlama kona hunglong suh twi chu akiting denin, Zarethan koma um Adam khopi geijin gamlatah-in akidilin ahi. Chule phaicham gamlatah twipi lamsanga chi twipi lama longsuh laichu atantan, hitichun mipi ho chu Jericho khopi dontah-a chun agalkai taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakai thulhun thingkhong pu-a thempuho chu Jordan lui mipi ho chu agalkaisoh kahseovin, Jordan lailunga tolgoa chun ading detnun, chule Israelte jouse chu tolgoa agalkai taovin ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi. Mipi jouse Jordan agalkai sohkei phatnun, Pakaiyin Joshua henga,
  </para>
  <para style="p">
    <verse number="2" style="v" />Phung khatna konin Pasal khat cheh, mipi lah-a pasal somleni lhengdoh-in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ajah uva, thempuho dettah a adinnau mun Jordan lailunga konchun song somleni laovin. Chule hicheho chu pogalkai junlang tujana nagenadiu munachun koijun, tin thu pen, tin aseipeh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Joshua'n Israel chate lah-a phung khatna kon mikhat cheh analhendoh mi somleni chu akouvin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Joshua'n ajah uva, Jordan lailung Pakai na Pathen'u thulhun thingkhong masanga chun gacheuvin lang Israel chate phungjat dungjuijin nangho mikhatnin, song khat cheh nalenguva hinpuvin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiti achu hichehi nalah uva melchihna hunghia, khonung tengle, nachateovin apateu henga hiche songhohi ipi kihetna ham? tia nadoh tengule
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon Pakai thulhun thingkhong masanga Jordan lui alonglai adinjeh ahi. Jordan agalkai laijun Jordan twi chu akangtanin, chujeh-in hiche songhohi Israel chate dinga a-itih a dinga hetjingna hiding ahi, tia amahochu nadonbut diu, ahi ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Israel chaten Joshua thupeh bangin abollun, Pakaiyin Joshua jah-a anasei bangin, Israelte phungjat dungjuijin alauvin, agenao mun geijin apogal kaijun, chuachun akoitauvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Joshua'n thulhun thingkhong pu-a thempuho dinna Jordan lailunga chun song somleni aphutnin, hihochu tunichanin aumjinge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu tulhun thingkhong pu-a thempuho chu Mosi'n Joshua henga thu anapeh jouse dungjuijin mipi henga seipehdin Pakaiyin Joshua jah-a thu anapeh chu akichai kahsen Jordan lailunga chun adingdenun ahi. Chuin mipi chu kinotah-in agalkai taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ahitin ahi, mipi ho chu agalkai sohkei phatnun Pakai thulhun thingkhong le thempuho chu mipi mitmun agalkai taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Reuben chate, Gad chate chule Manasseh phung kehkhat gal manchah pumin, Mosi'n ahenguva aseipeh bangin Israel chate masanga anagalkaijun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Galvona kivonjousadem mi sangsomli tobang gal satdingin Jericho phaicham ho-a Pakai masanga akitolun, ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hicheni chun Pakaiyin Israel pumpi mitmu-a chun Joshua achoisangin ahi. Chuin amahon Mosi agin bangun amachu ahinlai sungsen agingun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Pakaiyin Joshua henga aseijin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hettohsahna thingkhong pu-a thempuho chu Jordan'a kona ahungdoh nadiuvin thu pen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun Joshua'n Jordan'a konin hungdoh taovin, tin thempuho thu apetan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ahitin ahi, Pakai thulhun thingkhong pu-a thempuho chu Jordan lailunga kona ahungdoh uva, chule tolgo akaidoh phatnun angai bang bangin Jordan luichu alongkittan, vadung pangho chu aletkittan, ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin mipi chu lha masapen nisom channin Jordan luija konin ahungdoh un, Jericho gam solamsang Gilgal'a chun gebuh asong taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule song somleni Jordan luija kona alahdoh uchu Gilgal'a chun Joshua'n aphuttan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule aman Israel chate jah-a, khonung tengle nachateovin apateu henga, hiche songhohi ipi kihetna ham? tia nadoh tenguleh,
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanghon nachateo henga, Israel chu hiche Jordan'a hin tolgon anagalkaijun ahi, ti nahetsah dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Pakai na Pathen'un twipisan kagalkai kahseuva kamasanguva agotsah bangchun, Pakai na Pathen'un Jordan twi chu nagalkai kahseovin akansah-in, ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiti achu leiset mite jousen Pakai khut chu hattah ahi, ti ahetheijuva, nanghon Pakai na Pathen'u chu a-imatih chana nagin theina dingu ahi tin aseipeh-in ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuleh ahitin ahi, Jordan gal lhumlam sanga um Amor mite leng jouse le, twipi panga um Kanaan mite leng jousen Israel chate masanga Jordan agalkaisoh kahseovin Pakaiyin Jordan luichu akansah-e, ti ajah phatnun alungu ajunlha gamtan, Israel chate jehchun amaho-ah hanna lung him him aumtapoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichepet chun Pakaiyin Joshua jah-a, chemcha hem hinsem munlang, Israel chate chu aniveina-a din achepmu tanpeh kitnin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Joshua chun chemcha hem asemin, Israel chate chu achepmu atanpehtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Joshua'n chep atanna ajehchu hichehi ahi. Egypt'a kona ahungdoh nungun mipi jouse galmiho jengjong, Egypt'a kona ahungdoh jouvun, gamthip lampia athigam taovin, ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Egypt'a kona hungpotdoh jouse chu cheptansa ahiuvin ahi. Ahinla ahungdoh nunguva gamthipma lamkah-a pengho jouse chu chep tanlou ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Egypt'a kona hungdoh Israel chate galmi jousen Pakai aw lunglut tah-a angailou jeh-un, suhmanga aumkah seovin gamthipma kum somli athammun, Pakaiyin apateu pehdinga anatepsa khoijule bongnoi lonna gam chu amaho musahlou dingin ana kihahselin, ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun akheluva atundoh achateu chu Joshua'n achepmu atanpehtan ahi. Ajehchu amaho lamdunga chep ana tanpeh loujeh-un, chep tanlou anahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ahitin ahi, mipi jouse chep akitanjou phatnin, adam kahseovin aumnao gebuh a chun aumun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Pakaiyin Joshua jah-a, tunia nangho-a kona Egypt te i-sah louna chu katolmang ahitai, ati. Hijeh chun tuni geihin hiche munchu Gilgal akisahtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Israel chaten Gilgal'a chun gebuh akisonun, hiche lha nisomlenili channi nilhah lamin Jericho phaicham ho-a chun kalchuh kut anit taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule kalchuh kut jou ajing nikhotah chun amahon hiche gama mimle chang leija kona cholsolou changlhah chule changkanpoh chucheni mama chun anetaovin, ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule chuche gam changvui anehjouvu ajing chun Mana chu akichaitan, Israel chaten Mana chu nejong anetapouve. Ahinla amahon hiche kum-a pat chun Kanaan gam gachu anetaovin, ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, Joshua Jericho naija aumpet chun akhodah-in aven ahile, veuvin, amasanga mikhat achemjam sadohsan akhutna achoijin adingin ahi. Chuin Joshua'n akom anaijin ajah-a, keiho lama pang nahim, ahiloule kamelmate lama panga nahim? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman ahipoi, Pakai janel lamkaija hungjoh kahi ati. Chuin Joshua tolla aboh khupmin ahouvin, ajah-a, Pakaiyin nasoh henga ipi seinom naneijem? atin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakai janel gallamkai chun Joshua jah-a, nakengchot sutlhan, ajehchu nadinna mun chu muntheng ahi, ati. Chuin Joshua'n chuti chun aboltan, ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Jericho chu Israel chate jehchun akikhahchahtan, koimacha alutle apotle aumtapoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin Joshua jah-a, vetan, Jericho le alengpau chule mihat mihangsan tamtah hohi nakhutna kapeh ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangho galmi jousen khopihi naum uva, hitia chu khatvei navelsoh diu ahi. Chule chutobangma chu nigup sunga naboldingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule thempu sagin kelngoichal ki-a kisem sumkon sagi kitepna thulhun thingkhong masanga achoijuva, chule anisagi ni-a chu khopi chu vel sagivei navelsoh dingu, chuteng thempuhon sumkon ho chu amutdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hung hitiding ahi. Amahon kelngoichal ki-a kisem sumkon chu amut huilhung jenjunu gin najah tenguleh mipi chun ha-aova na-aodiu, chutahle khopi kulchu chimlhading ahi. Chule mipi chu ama ama majon cheh a jangjela kaltou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Nun chapa Joshua'n thempuho chu akouvin, ajah uvah, thulhun thingkhong hi jong unlang, thempu sagin Pakai kitepna thingkhong masang lama chun kelngoichal ki-a kisem sumkon sagi choijuhen ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman mipi jah-a, chepeh unlang khopi chu velkolun lang, chule galvona kivonta pouchu Pakai kitepna thingkhong masanga chun cheohen, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi. Joshua'n mipi henga thu aseijou phatnin, kelngoichal ki-a kisem sumkon sagi choija thempuho chun Pakai masanga achoiju sumkon ho chu amut taovin, chule Pakai thulhun thingkhong chun anungu ajuitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule galvon kivon hochu sumkon ho mut thempuho masanga chun acheuvin, chule anungthop ho chu thulhun thingkhong nunga ahungun, thempuho chun ache pumu chun sumkon ho chu amutnun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Joshua'n na aona dinguva thu kapeh ding nikho alhin tokahse-a, na ao-loudingu, chule nahusat loudingu ahi. Chule thujong nasei loudingu, thu kapeh tenglebou na aodiu ahi, tin mipi chu thu apetan, ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutichun Pakai thulhun thingkhong chu khopi chu khatvei avelsah un, chule gebuh a ahung kilekitnun, agehjiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Joshua jingpitah-in athouvin, thempuho chun Pakai thulhun thingkhong chu apuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakai thingkhong masanga kelngoichal ki-a kisem sumkon ho choija thempu sagiho chu tanglouvin acheuvin ahi. Chule galvona kivonho chu amasanguva acheuve. Ahinla anungthop ho chu Pakai thulhun thingkhong nunga ahungun, thempuho chun chepumin sumkon ho amut jingun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin anini channin khopi chu velkhat avellun gebuh a ahungkile uvin ahi. Chutichun nigup abolluve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin anisagi channin ahitin ahi, khovah then thenin athouvun, abol ngaima bangun khopi chu vel sagi avelun ahi. Hichenia bou chu khopi chu vel sagivei avelu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin avel sagi chana-in ahitin ahi, thempuhon sumkon ho amut phatnun Joshua'n mipi jah-a hatah-in aovun ajehchu Pakaiyin khopihi nangho napeh-u ahitai atin, ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule khopile asunga umjouse ngeichu sapsetna dinga Pakaiya kipedoh ahitai. Rahab noti le a-insunga aumpi chengse bouchu sohcha ding ahi. Ajehchu amanun imisolte niu anaselin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule sapset thilho-a konin kikang seuvin. Achutiloule sapset thilho chu lakhaovin natin, sapset changkhaovin nate. Chule Israel gebuh a jong sapsetna lhungintin, boina umgetninte.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla sana dangka, thihle sum-eng bel jouse Pakai dinga kisuthenga ahi. Hicheho chu Pakai goukhol na-a kikoiding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutichun thempuhon sumkon ho amutphatnun ahitin ahi. Mipin sumkon ho gin ajah phatnun ha aovin a-aovun ahileh, kulpi chu achimlhatan, chuphatnin mipi chu amaho doncheh a jangjelin alhai touvun khopi chu alataove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon khopi sunga um numeile pasal nungah le gollhang abonin, ateh akhang chule bongchal le kelngoi, chule sangan abonchan chemjamin athat gamhel taovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla Joshua'n gamvelhi teni jah-a, notinu in'a chun lut lhonin lang amanule aneijouse chu ahenga nana kihahselna lhon bang chun gapuidoh lhonin, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin gollhang gamvelhi teni chu ahunglhonin, Rahab, anule apa, asopiho chule aneijouse toh apuidoh lhontan, ahi. Chule amanin a inkote jouse apuidoh lhonin Israel gebuh pama adalha lhontan, ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amahon khopi chu asunga thil umjouse toh meijin ahalvamun, sana dangka, thihle sum-eng belho bouchu Pakai in'a gou kholna-a akoitaovin, ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Joshua'n Rahab notinu le aneijouse, chule apa insung ahuhhingin ahi. Chule amanu tuni geijin Israelte lah-a acheng nalaije. Ajehchu amanun Joshua'n Jericho gavelhi dinga asolteni chu ana selin, ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuti chun Joshua'n amaho chu ahahselin, hitin aseije: hiche Jericho khopi hintungdoh kitna chu Pakai masanga sapset chenghen. Abul phutna chun achapa lenpen achan ding, chule akotpiho atundoh tengle achapa lhumpen achan ding ahi,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hitichun Pakaiyin Joshua aumpin, gam jouse-a amin chu akithangtan ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin Israel chaten sapsetna thil chungah asukhel taove. Ajehchu Judah phunga Zerah chapa Zabdi chapa Karmi chapa Achan'in sapsetna thilchu alan ahi. Chuin Israel chate chunga Pakai lunghana chu akoudoh jahtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Joshua'n Jericho akonin Bethel solam Bethaven koma um Ai kho-a mi asolin, ajah uvah, chetou vunlang gamchu gaveovin tin aseijin ahi. Chuin miho chu acheuvin Ai khochu agave taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amaho chu Joshua henga ahung kilekitnun, ajah-a, mijouse kontousah datan, ahinla sangni sangthum tou kontouvu henlang Ai khochu nokhumu hen, mijouse suhthachol datan, ajeh chu lhomcha bou ahiuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun mipi ho lah-a mi sangthum tobang akontou taove. Ahin amaho Ai miho masanga ajamtaovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Ai miten amaho mi somthumlegup tobang athatnun ahi. Ajehchu kotpi-a kona Shebarim geipeh a ahindelsuh uva, ajamsuh nalam uva athao ahi. Hijeh chun miho lung chu alhoplhatan, twibang ahijengtai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Joshua'n avonho abottelin Pakai thulhun thingkhong masanga chun nilhah geijin aboh khupmin, tolla amai asulutnin, amale Israel upaho chun, aluchung uva leivui akinutaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Joshua'n, vo Pakai Pathen, ipidinga hiche mipihohi Amor mite khutna napeh doh-a thagam dingbepma Jordan napui galkai mongham? Jordan gal langkhatna lungmonga kanaum hitaleh!
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Pakai, Israelte hi amelmate masanga kinungchon jing tale ipi seitang em?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Kanaan mihole hiche gama cheng jousehin hichu jaovintin, eium kimvel untin kaminuhi leisetna kona asuhmang diu ahitai. Chutengle Namin loupitah hi inaloding hitam? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Joshua jah-a, thoudoh-in, ipi dinga hiti achu nabohkhupma nalup ham? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel achonvaltan, kathupeh kathulhun jong eisuhkeh peh-un, amahon sapsetna thil jengjong alauvin, aguvin, aselguvin, athilkeo lah uva aselun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiche jeh-a chu Israel chate amelmateu masanga ding joulouva galte masanga nungjam joh ahiuve. Ajehchu amaho chu sapset changa ahitaovin, nalah uva kona sapset thilchu nasuhmang lou uleh kaumpi louding nahitaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kipat in mipi ho sutheng inlang ajah uva, jing nikho-a dingin kisuthengun; ajehchu Pakai Israel Pathen'in hitin ati, Israel nalah uva kona sapsetsa thilchu nasuhmang kahseuva namelma teu masanga nadin jouloudiu ahi, tin seipeh-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche jehchun jingkah tengle naphungu dungjuija naki khopdiu, chule hitiding ahi. Pakaiyin alhendoh phung chu abom dungjuija hungdiu ahi. Chule Pakaiyin alhendoh bom chu a-insung dungjuija hungdiu, chule Pakaiyin alhendoh dungjuija amichangcheh hungdiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hitiding ahi, sapset thiltoh kimattha pen penchu amale aneijouse meija kigouvam ding ahi. Ajehchu aman Pakai thulhun asukhelin, Israel lah-a chonval tah-in thil abole, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Joshua jingpitah-in athouvin, Israelte chu aphung phungin ahinpuijin ahile Judah phungchu alheng dohtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman Judah sunga abom bomin ahinpuijin, Zarhi bom chu alhengdoh-in ahi. Chuin Zarhi bom chu mikhat khatnin ahinpuijin ahile Zabdi chu alheng dohtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin a-inkouvin mikhat khatnin ahinpuijin ahile Judah phunga Zarah chapa Zabdi chapa Karmi chapa Achan chu amandohtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Joshua'n Achan jah-a, kangeh nahi, kachapa Pakai Israel Pathen chu loupi chamkim jana penlang nachonsetna phongin, chule ipi nanabol tun imlouvin kakoma seijin, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Achan'in Joshua chu adonbutnin, ajah-a, tahbeh mongin Pakai Israel Pathen dounan kana chonsetan, hitihin kanaboltai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman thil kichomho lah-a chun Babylon von hoitah khatle dangka shekel jani, chule shekel somnga-a gih sana lhon khat kamun ahile, kavejou tahih-in, kakilahtan ahi. Chule vetan, hicheho chu kaponbuh lailung leinoi'a kaselin, dangka chu anoija aume, atin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Joshua'n mi asolin, amaho chu ponbuh lama alhaijun, chule vetan, hichu aponbuh sunga anaselin, dangka anoinunga anaume.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amahon ponbuh a konin hicheho chu aladoh-un, Joshua le Israel chate jouse henga ahinchoijun Pakai angsunga akoitaove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Joshua le aumpi Israel pumpin Zarah chapa Achan dangka, von, sana lhon, achapate le achanute, abongchalho, asanganho le akelngoiho, aponbuh chule aneijouse ahintolun Achor phaicham ahinlhut taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Joshua'n ibola neisuh lunggimu ham? Pakaiyin tunia nangjong nasuh lunggim ding ahitai, ati. Chuin Israel mipin amale aumpi jousen songin asepmun, asejou phatnun meijin ahalvam taove.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amahon achunga chun songlhuh lentah atungdoh-un, hichu tunigei hin aumjing nalaije. Hitichun alungset tijat umtah-a konin Pakai akileheitai. Hijeh chun hiche munchu tunigeijin Achor phaicham akisahtai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Joshua jah-a, kicha hih-in, lungjong lunglha hih-in, galmi jouse puijin kipat inlang Ai kho-a chetouvin, ven, Ai lengpa le amite chule akhopile agam nakhutna kapeh nahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Jericho le alengpa chunga nabol banga Ai le alengpa chunga jong nabolding ahi. Chule thilkichomhole ganchaho chu nangho ding ahin, khopi nunglama chu achanglhi nakoiding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutichun Joshua le galmiho jouse Ai satna chedin akipat doh-un ahi. Chuin Joshua'n mihat, mihang sangsomthum alhengdoh-in, jannin asoldohtan, ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amaho chu thu apen, veuvin, khopi nunglama nachanlhih diu ahi. Khopi-a kona chegamla behseh louva, kigosa dema naum johdiu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keimale kaumpi chengse chun khopi chu hinnai lutnung kating, chule hung hitiding ahi. Keiho doudinga ahungdoh tengule, amasa bangchun keiho amasanguvah jamung ting,
  </para>
  <para style="p">
    <verse number="6" style="v" />(ajehchu amaho keiho nunga hungdoh ding,) amaho khopisunga kapuidoh kahseovin, ajehchu amahon amasa-a bangin, amaho amasanguvah ajamtaove atidiu ahin, hijeh-a chu amasanguva kajamdiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuteng nanghon nachanlhih naova kona nakipat doh uva, khopi chu nalahdiu ahi. Ajehchu Pakai Pathen'in nakhut uva apehding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hitiding ahi, nanghon khopi chu nalah tengule nahal dingu ahi. Pakai thupeh dungjuija nabol dingu ahi. Veovin, thu kapeh nahiuve, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichun Joshua chun amaho chu asoldoh-in, chule amaho changpang dingin acheuvin, Ai khole Bethel kikah Ai lhumlama chun aga umun, Joshua vang hiche janchun mipi lah-a agehtan, ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Joshua jingpitah-in athouvin, mihochu asimin, amale Israel upaho mipi masanga chun Ai kho jonin akitoltou taove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin mipi jouse ahenga amatoh umkhom galmiho jouse chu chetouvun, chule ahin naijun khopi masanga ahunglhung uvin, Ai khopi sahlama chun ponbuh asonguve. Tun amahole Ai kikah-a chu phaicham khat umah ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman mi sangnga tobang apuijin, khopi lhumlam sang Bethel le Ai kikah-a chun changlhi-a kisel dingin akoitan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amahon khopi sahlama um mipi janel, chule khopi lhumlama changpangho geija agontohsoh phatnin, hiche janchun Joshua phaicham lailunga achetan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ahitin ahi, Ai lengpan hichu amuphat chun, kinotah-in ama athouvin, khopi miho, amale amite jouse chu phaichama chun Israelte satdingin ahung kondoh taove. Ahinla khopi nunglama asat ding achanglhi aume tichu ahepouvin, ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Joshua le Israel mijouse chu gallel bangin amaho masanga chun gamthip lama chun ajamtaove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Ai kho-a um mijouse chu amaho nungdel dingin akikoukhomun, Joshua nung adelun khopi-a konin akitolmang taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Ai khole Bethel kho-a chun Israelte nungdela chelou khatchabeh aumpouve. Chule khopi kot chu honsan adalhaovin Israelte chu adeltaove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pakaiyin Joshua jah-a, Ai kholam ngan nakhutna tengcha chu gah lhandoh-in, ajehchu hichu nakhutna kapeh ding ahi, ati. Chuin Joshua'n akhutna um tengcha chu khopi lam ngan alhang dohtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin changpangho chu aumna mun uva konin akipatdoh loijun, akhut alhandoh doh chun alhaijun, khopi-a chun alutnun hichun alauvin gangtah-in ahallha taove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Ai kho miho chu akiheijun anung lamu agah vetnule, veuvin, khopi meikhu van'a akitungdoh amuvin, hoilampena jamding ham ahetapouve. Chuin gamthip lama jam mipi ho chu ahung kilekitnun, anungdelhou chunga chun achutaove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Joshua le Israel pumpi, achanglhi hon khopi alah-u chule khopi meikhu kitungdoh chu amuphatnun akiheijun Ai kho miho chu athatgam taove.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin adangho chu amaho satdin khopi-a konin ahung kitoldoh-un, hitichun amaho alang alanga Israelte lailung tah-a aumtaove. Chuin akihinghoile ajamdoh khatcha aumsah tapouve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Ai khopi lengpa chu ahingin amanun, Joshua henga ahinkai taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ahitin ahi, Israel ten gamlah le anungdel nao gamthipma Ai kho mijouse chemjam'a akitha-a akisuh gamhel phatchun, Israelte jouse Ai kho-a akileuvin chemjamin asumang taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule hiche nikho-a Ai khopi-a thijouse chu anumei apasal'in sangsom le sangni ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joshua'n ateng alhandoh chu Ai kho-a miho athajou tokahseochun akhut alha lhapon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pakaiyin Joshua henga athupeh bangin hiche khopi-a ganchaho le thil kichomho bou chu Israel ten ama ama chanding dola akilah-u ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Joshua Ai kho chu ahalin, a-itih-a dingin alhuh-in asemin, tunichan hin ahomkeo ahijinge.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Ai kho lengpa chu nilhah geijin thingleh-a akhaijin, chule nilhum ding konin Joshua'n thu apen, thilong chu thingleh-a konin alalhauvin khopi lamlen lutna bulla apaijun achunga song atungdoh-un tunichanhin aum nalaije.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chujouvin Joshua'n Ebal lhanga Israel Pakai Pathen dingin maicham asemin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosi dan lekhabua kisun bangin Pakai soh Mosi'n Israel chilhah ho thu anapeh bangchun, hiche maicham chu songa kisem ahin, koiman achunga thih alhahkhum loulaiju ahi. Hichea chun Pakai dingin govam thilto le chamna thiltoho atoh-in ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin aman hiche songa chun Mosi danho chu Israel chate mitmun asunin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule Israelte jouse, a-upahou, thutan vaihomho, Levi te thempuho chu Pakai thingkhong jongho masanga, thulhun thingkhong sihtoa chun phung chomho le chuche gama pengho jouse jongchu ading khom sohkeijun, akehkhat Gerezim molpangah adingun, Pakai soh Mosi'n Israelte chu vang aboh tahdi ding ahi tia thu anapeh bangchun, akeh khat chu Ebal jonna aumun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule chujouchun danthua thujouse danthu bu-a kisun jouse dungjuijin vangbohna le sapsetna thuho chu asimdoh-in ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mosi thupeh jouse chu Israelte houkhom ho jousele, numei ho le chapang neocha cha hole amaho lah-a chidang namdang chengho hetnin Joshua'n simlou khatchabeh aneipon ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Jordan hilamsang thinglhang, phaicham chule twipilen Lebanon geija cheng jouse Hit mi, Amor mi, Kanaan mi, Perizz mi, Hiv mi chule Jebus mi lengho jouse chun ajah phatnun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Amaho Joshua le Israel satdingin lungkhat tah-in akikhom khomtaove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Gibeon na chengho chun Joshua'n Jericho le Ai kho abolnaho chu ajah phatnun,
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon doha abolun palaija kisol bangin acheuvin, asanganhou chunga khaodip pon luiho aphaovin, jupenglui asesaho le akikanchomho apouvin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule kengchotlui abehbeh a pol akiseovin, vonlui akivonun, anehdiuva changlhah ahinkipoh hou jong agon, a-ap gamtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amaho Gilgal gebuh-a Joshua henga acheuvin, amale Israel mite henga, keiho kholgam latah-a kona hung kahiuvin, hijeh chun tun neikicham piuvin, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Israel miten Hit mite jah-a, nangho kalah uva cheng hikhatnun nate. Achutile nang hotoh thulhunna iti kasem dinguham? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amahon Joshua jah-a nasohte kahiuhi atiuve, chuin Joshua'n ajah uva, nangho koi nahiuva hoijakona hung nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amahon ajah-a, Pakai na Pathen min jala nasohte hi kholgam latah a kona hunga kahiuve. Ajehchu keihon aminthangjele Egypt gama athilbol jouse kaja taove,
  </para>
  <para style="p">
    <verse number="10" style="v" />chule Jordan galla um Amor mite lengni Heshbon lengpa Sihon le Ashtaroth na cheng Bashan lengpa Og chunga athilbol jouse phatah-in kajaovin, ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun ka-upahou le kagamsunga cheng mijousen kajah uvah, nanehdiu kipoh unlang, amaho kimupi dingin cheovin, chule alah uva keihohi nasohte kahiuve. Hijeh chun tun nanghon neikichampiuvin gatiuvin tin eihilun ahi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Naheng uva hungdinga kakigot uva pat kanehdiuva kahinpoh-u hiche changlhah hohi sapeh-ah ahi. Ahinla tun veuvin, agopmin a-ap tai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule ju kahin kikhum nao penghohi athahleh ahin, veuvin tun, asegamtai. Hiche kavon houleh ka kengchot-u jonghi lamsaotah kahinjot jeh uva luigama ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin mihochun Pakai chu dong louvin an anehkhompi taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Joshua'n amahochu hinghoi dingin chamna asemin, akitep pitan ahi. Chule mipi kikhomho lamkaiho jong ahenguva akitep taovin, ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amato akitep nungu nithum jouvin ahitin ahi. Amahochu alah uva chengah akhovelhou ahiuchu ahedoh taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Israel chate akitolun, anithum chanin akhopihou alhung taovin ahi. Tun akhopihou chu Gibeon, Chephirah, Beeroth chule Kirjath-jearim ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin mipi kikhomho pipuiho Pakai Israel Pathen minna akihahsel tahjeh-un, Israel chaten amaho chu asumang tapouve. Chuin houkhom ho jouse chu pipuiho chunga chun aphuntaove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla pipuiho jousen houkhom hojouse henga, tonsot Pakai Pathen minna ahenguva kihahsela akihitai. Hijeh chun tun eihon amaho itohkhah theilou diu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Eihon amaho chunga hitihin boluhite, eiho amaho chunga ina kihahsel taovin, amahohi ihinghoi teidiu ahi. Achutiloule ichunguva lunghana hunglhung getninte.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin pipuiho chun amaho chu hinghoijun atiuvin, ahin pipuiho kitepna bangin mipi kikhomho dingin thingpo twikhaijin panguhen atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Joshua'n amaho chu akouvin, ajah uva, kalah uva cheng hiuva, ipidia nangho-a kona gamlatah-a chenga kahiuve tia neijoulhep muham? ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun tun nangho gaosap changa nahitaove. Soh nahinaole Pathen in dinga thingpole, twikhailea napan naova kona khatcha jong ongthol naum lou dingu ahi, tin aseitan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amahon Joshua chu adonbutnun, Pakai na Pathen'in asoh Mosi henga hiche gam jouse nangma pehdinga thu napeh chule acheng jousehi namasanga nasuhgam ding ahi ti soh hohin kichentah-in eina hilui. Nangho jeh-in kahinkhouhi suhmanga aumdinghi kakicha behsetnun, hiti ahi kana bollu ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule tun vetan, keihohi nakhutna um kahiuvin, kachunguva boldingin aphai, adih-e, natichu boljengin, atiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin hitichun aman amaho chu abolin Israel chate khutna konin ahuhdoh un, amaho chu athat tapouve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Joshua'n hiche nikho chun amaho chu houkhom ho Pakai maichama dinga thingpole twikhaija alhendohna mun'a chun tuni geijin, apansahtan ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun ahitin ahi, Jerusalem lengpa Adonizedek'in Joshua'n Ai kho alah a asuhmanghela Jericho khopi le alengpa asuhmang banga Ai khole alengpa abol chule Gibeon'a chenghon Israel toh kichamna asemuva alah uva aum ajah phatchun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Akichalheh jengun, ajehchu Gibeon hi lengte khopiho khat banga khopi lenkhat ahin, hichu Ai kho sangin jong alenjon asunga chengjouse hattah ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun Jerusalem lengpa Adonizedek chun Hebron lengpa Hoham le Jarmuth lengpa Piram chule Lachish lengpa Japhia chule Eglon lengpa Debir henga mi asolin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hungun lang eihung kithopiuvin, Gibeon sumangu hite. Ajehchu Joshua le Israel chatetoh kichamna asemtaove, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun, Amor te leng ngaho: Jerusalem leng, Hebron leng, Jarmuth leng, Lachish leng chule Eglon leng akikhom khomun, amahole asepai janel jouse akontouvun, Gibeon koma gebuh asemun, akisatpi taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Gibeon mihochun Gilgal gebuh-a Joshua henga mi asolun, nasohte-a dingin nakhut lhang thase hih-in. Kahenguva hungtou loijinglang nei hung kithopiuvin, neihuhhing jengun ati. Ajehchu thinglhanga cheng Amor te lengho jouse keiho doudin akikhom taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutichun Joshua Gilgal'a konchun amale agalsatmi jouse, mihat mihangho jouse chu akontou taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Joshua henga amaho chu kicha hihbeh-in, amaho chu nakhutna kapehdoh nahitai, namasanga miho khatcha dingjou louding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun hetman louvin Joshua Gilgal'a konin ahenguva jankhovah in achetouvin, ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin amaho chu Israelte masanga chun amaimoh sah-in, chule Gibeon'a chun mitamtah athatnun ahi. Bethhoron jottouna lampi lhungkeijin adeltaovin, Azekah le Makkedah geijin agathatnun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, Israelte masanga ajammuva Beth-horon lama achesuh petnun, Pakaiyin Azekah geijin van'a konin achunguva gel len tahtah alhahsah in athiuvin ahi. Israel chaten chemjam'a atha sangun gel selih chu atamjon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Pakaiyin Amor mite chu Israelte khutna apehdoh nichun Joshua'n Pakai jah-a, hitin aseijin, Israel chate mitmun; Nisa nangma Gibeon chunga dingdenin, chule lha jong Aijalon damjola dingdenin, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin mipi chun amelmateu chunga phu alahjou masang seochun nisa chu adingden tan, chule lhajong chu aumden tai, hiche hi Jasher lekhabua kisuna hilouham? Hitichun vantham jola nisa ading denin, nikhat lhumkei tobang lhumvah louvin aumin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule chuche masang ahiloule chuche nungin jong chutabong nikho, Pakaiyin mihem khat aw angaipehna aumkhapoi. Ajehchu Pakaiyin Israelte dinga gal anasat ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Joshua le aumkhompi Israel jouse Gilgal gebuh a akilekit taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin chuche leng ngaho chu ajamun Makkedah songkoa akisel taove.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Joshua henga hiche leng ngaho chu Mekkedah songko khatna akiseluve, tin ahungseipeh taove.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Joshua'n songko kotna chun song len tahtah tanglut unlang amaho ngahtup din mi koijun ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nangho umden louvin, nagalmiteo nungdelun, chule amaho lah-a anungthop ho geijin thatnun amaho akhopi houva lutsah hih-un. Ajehchu Pakai na Pathen'in amaho chu nakhut uva apehdoh ahitai, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin ahitin ahi, Joshua le Israel chaten amaho chu asuhmanghel nadiuvin hathan athatnun, amoh chengchu kul kikai khum khopiho-a chun aluttaovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin mijouse chu Mekkedah gebuh a Joshua henga lung mongtah-in akileuvin ahi. Koiman Israel chate chung kitimong monga akam akeh tapouve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche jouchun Joshua'n songkotkhah chu hongunlang leng ngaho chu kahenga hinpuijun, atin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin chutichun abolun songkoa konchun leng ngaho Jerusalem lengpa, Hebron lengpa, Jarmuth lengpa, Lachish lengpa chule Eglon lengpa chu ahenga ahinpui taove.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ahitin ahi, hiche lengho chu Joshua henga ahinpui phatnun, Joshua'n Israel mipi jouse chu akouvin, amatoh kilhon galmi lamkaiho jouse jah-achun hung naijun lang hiche lengho ngong nakengun chonun ati. Chuin amaho ahung naijun amaho ngong chu akenguva achon taove.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Joshua'n ajah uva, kicha hih-un, lungjong lunglha hih-un, hatnunlang hangsan uvin ati. Ajehchu Pakaiyin nakisatpiu namelma teu jouse chu hitia chu abolding ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule hiche jouchun Joshua'n amahochu asatnin, athatnin thingphung nga chunga akhaijin ahi. Chule amahochu thingchunga nilhah geijin akhaijun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin nilhum dingkonin ahitin ahi, Joshua'n thu apen, amahochu thingleh-a konchun alalhauvin, akiselnao songkoa chun alehlutnun ahi. Songho chu song lenpipin asingun, hichu tunigeijin jong aumnalaije.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin chuche nichun Joshua'n Makkedah chu alan, hichu chemjamin asumangin, mihing jouse asugamhelin khatcha jong ahinghoipoi. Chule Jericho lengpa chunga anabol bangchun Makkedah lengpa chunga jong aboltai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chujouvin Joshua'n aumpi Israel chate jousetoh Makkedah'a patnin Libnah lama acheuvin, Libnah chu asat taove.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Pakaiyin Libnah le alengpa chu Israelte khutna apedoh-in, asunga cheng miho jouse chemjamin athat gamin, khatcha jong ahinghoipoi. Chutichun Jericho lengpa abolna bang chun chuche lengpa jong chu aboltan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Joshua'n Libnah'a konin aumpi Israel jousetoh Lachish'a acheuvin, chuin gebuh asongun asattaove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Pakaiyin Lachish chu Israelte khutna apedoh-in, hichu nini channin alan ahi. Libnah anabolna jouse bangchun akhopile asunga cheng mihing jouse chu chemjamin asumangtai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chujouchun Gezer leng Horam chu Lachish kithopi dingchun ahung touvin ahile, Joshua'n amale amite chu khatcha khen neilou helin athatgamtai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Lachish'a konin aumpi Israel jousetoh Joshua chu Eglon'a acheuvin, gebuh asongun asat taove.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin chuche nichun amahon alauvin, chule asunga mihing umjouse chu chemjamin asatnun, hiche nikho mama chun Lachish abolna bangun athatgam heltai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Joshua chu aumpi Israel jousetoh Eglon'a konin acheuvin Hebron ho chu asat taove.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule amahon hichu alauvin, Eglon anabolna jouse bang chun, Hebron le alengpa aumpi jousele, asunga cheng mihing jouse chu chemjamin athatgam heltan ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin aumpi Israel jousetoh Joshua Debir lama acheuvin, asatnun,
  </para>
  <para style="p">
    <verse number="39" style="v" />Aman Debir le alengpa chule khopi jouse chu alan, chule amahon amahochu chemjamin asatnun, asunga cheng mihing jouse chu athatnun, khatcha ahinghoi pouve. Hebron abolna bangle Libnah le alengpa abolna bangchun Debir le alengpa jongchu aboltan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hitichun Joshua'n lhanglam gam hihen agam pumpin, sim gamho phaigam chule twiputna chana lengte jouse chu asugam sohkeijin, Pakai Israel Pathen thupeh bangin khatcha khenlouvin, ahaithei jouse athat gamheltan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule Joshua'n Kadesh-barne'a pat Gazah channin, Goshen gam jouse toh Gibeon channin asumang heltan ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Pakai Israel Pathen'in Israel dinga gal asat jeh-in, Joshua'n hiche lenghole agam jouseu chu khatvei lah-in alatai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Joshua aumpi Israel jousetoh Gilgal gebuh-a chun ahung kilekit taove.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Hezor lengpa Jabin'in hicheho chu ajah phatnin, Madon lengpa Jobab, Shimrom lengpa chule Achshaph henga,
  </para>
  <para style="p">
    <verse number="2" style="v" />chule sahlang thinglhang gamle Chinnereth lhanglam phaichamle dam chule lhumlam Dor gamgi-a cheng lengho henga,
  </para>
  <para style="p">
    <verse number="3" style="v" />chule solamle lhumlama Kanaan mi, Amor mi, Hit mi, Perizz mi chule thinglhanga um Jebus mi chule Mizpeh gam Hermon noilam Hiv mite henga mi asoltan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule asepai jouseu toh mitampi atama tam, atam dannu chu luikama nel simsenlou jatjen sakol kangtalai tamtah toh akondoh taove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin hiche lengho jouse chu akisuhkhom phatnun Israel doudingin Merom twipanga gebuh asongkhom taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin Joshua henga, amaho jehchun kicha hih-in, ajehchu jing nikho tuphat donle amaho Israel masanga thagam dinga kapehdoh ding nahi. Nangman asakolu aja nabana akangtalaihou meija nahalvam ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun Joshua'n agalsat miho jousetoh amaho satdingin phulou helouvin Merom twilah-a chun ahungun, amaho chu anokhom taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin amahochu Israelte khutna apedoh-in, amahon amaho chu athatnun Zidon gei, Misrephoth-maim gei chule solam Mizpeh phaicham geijin adelun, khatcha khenlou helin athat gamtaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Pakai thupeh bangchun Joshua'n amaho chunga abolin, asakolhou ja abanin, asakol kangtalai hou meijin ahalvamtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Joshua hichepet chun akinunglen, Hazor chu alan, alengpa chu chemjamin athat tai. Ajehchu chuche masang chun Hazor chu chuche lenggam jouse chunga alenpen anahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin chuche sunga um mihing jouse chu chemjamin athatnun, amaho chu asugam helun, khatcha ahinghoi pouve. Chule aman Hazor chu meijin ahal lhatai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin chugama lengho khopi jousele alengteu jouse chu Joshua'n amanin chemjamin athat tai. Chule Pakai soh Mosi'n athupeh bangin amaho chu asumang heltai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla Joshua'n anahallhah Hazor seh tilouvin molvum'a dingjing khopiho chu Israel ten khatcha anahal lhapouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin chuche khopiho-a thilkichom jousele ganchaho chu Israel chaten galla kichom thilin akilah-un ahi. Ahivangin amahon amitakip asuhmang tokahseovin chemjamin athatnun khatcha jong ahinghoi pouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakaiyin asoh Mosi henga thu anapeh bangin Mosi'n Joshua koma thu anapen, chutobangma chun Joshua'n abolin Pakaiyin Mosi thu anapeh jouse chu bolouva akhen khatcha aumpoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutichun Joshua'n chuche gam jouse thinglhang gamho, lhanglam gamkai jousele Goshen gam jouse, phaichamle phaitong jouse chule Israel molle chuche molsanga damjol jouse alan,
  </para>
  <para style="p">
    <verse number="17" style="v" />Seir lhang geija kikhotou Halak molsanga pat Hermon mol noilam Lebanon phaichama um Baalgad chan geijin alahpeh-in, alengho jouse amanin asatnin athatgamtan, ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joshua'n chuche lengho chu phat sottah anakidoupin, ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gibeon'a cheng Hiv miteho tailou Israel chate toh kichamna sema khopi khatcha jong aumpoi. Adang jouse galla chu alah ngenchangu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajehchu Pakaiyin Mosi anathupeh bangin aman amahochu lungsetna beihela asuhmanghel theina dinga, amahon Israel ahung kidoupina dinguva alungu kitahsah chu Pakaiya kon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin chuphat chun Joshua ahungin molsang ho-a konchun Hebron, Debir le Anaba konin Judah molsangho jouse-a konle Israel moljouse-a konin Anakim te chu athatnin, Joshua'n amaho chu akhopihou pumin asumang heltan, ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israelte gamsunga chun Anakim te khatcha thalouva kihinghoi aumtapoi. Gaza, Gath, chule Ashdod nabou aumtaove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutichun Pakaiyin Mosi henga anasei jouse dungjuijin Joshua'n gampumpi chu alan ahi. Chuin Joshua'n amaho aphungu kikhen dungjuijin hichu alodiuvin Israelte apetan ahi. Chule agamchu galla konin akicholdotai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun nisolam Jordan gal langkhat Arnon vapidunga kipat Hermon lhang gei, chule solam phaicham jouse Israel ten asuh manguva atouphao gama lengho chu hitehohi ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Heshbon'a cheng Amor mite lengpa Sihon, Arnon vapidung panga um Aroer'a pat, chule vapidung lailunga pat, Gilead gamsung kehkhatna pat, Ammon chate gamgia um Jabbok vapidung chan geipeh-a anavaihom,
  </para>
  <para style="p">
    <verse number="3" style="v" />chule phaichama pat solama Chinnereth twipi geile Phaicham twipi gei Beth-jeshimoth jotna lampia solam chi twipi geipeh chule Ashdoth-pisgah noi lhanglama pat,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ashtaroth le Edrei'a cheng amoh ho lah-a Amoth Bashan lengpa Og gamsung,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Hermon lhanga Salcah a Bashan gam jouse, Geshur mitele Maachath mite chule Gilead gamgi kehkhat Heshbon lengpa Sihon Gamgi geijin vai anahome.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahochu Pakai soh Mosi le Israel chatehon anatha gamuva, chule Pakai soh Mosi'n Reuben te le Gad te chule Manasseh phung kehkhat-ho lodinga anapeh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Joshua to Israel chaten Jordan gal hilam lhumlamsanga atha gamu chuche lengho chu ahiuvin, agammu chu Lebanon phaicham Baalgad'apat Halak lhang, Seir geija kikhotou ahi. Hichehi Joshua'n kihop khen dungjuija alodiuva Israelte phungho anapeh gamhochu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Molsangho le damphai, phaichamle twinah ho-a chule gamthip gamle lhanglam gama Hit miho, Amor miho chule Kanaan miho, Perizz miho, Hiv miho chule Jebus miho gamchu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jericho lengpa, khat; Bethel koma um Ai kho lengpa, khat;
  </para>
  <para style="p">
    <verse number="10" style="v" />Jerusalem lengpa, khat; Hebron lengpa, khat;
  </para>
  <para style="p">
    <verse number="11" style="v" />Jarmuth lengpa, khat; Lachish lengpa, khat;
  </para>
  <para style="p">
    <verse number="12" style="v" />Eglon lengpa, khat; Gezer lengpa, khat;
  </para>
  <para style="p">
    <verse number="13" style="v" />Debir lengpa, khat; Geder lengpa, khat;
  </para>
  <para style="p">
    <verse number="14" style="v" />Hormah lengpa, khat; Arad lengpa, khat;
  </para>
  <para style="p">
    <verse number="15" style="v" />Libnah lengpa, khat; Adullam lengpa, khat;
  </para>
  <para style="p">
    <verse number="16" style="v" />Makkedah lengpa, khat; Bethel lengpa, khat;
  </para>
  <para style="p">
    <verse number="17" style="v" />Tappuah lengpa, khat; Hapher lengpa, khat;
  </para>
  <para style="p">
    <verse number="18" style="v" />Aphek lengpa, khat; Lasharon lengpa, khat;
  </para>
  <para style="p">
    <verse number="19" style="v" />Madon lengpa, khat; Hazor lengpa, khat;
  </para>
  <para style="p">
    <verse number="20" style="v" />Shimronmeron lengpa, khat; Achshaph lengpa, khat;
  </para>
  <para style="p">
    <verse number="21" style="v" />Taanach lengpa, khat; Megiddo lengpa, khat;
  </para>
  <para style="p">
    <verse number="22" style="v" />Kadesh lengpa, khat; Karmel gam Jokneam lengpa, khat;
  </para>
  <para style="p">
    <verse number="23" style="v" />Dor panga Dor lengpa, khat; Gilgal nam miho lengpa, khat;
  </para>
  <para style="p">
    <verse number="24" style="v" />Tirzah lengpa, khat; Lengho jouse abonchauvin somthumle khat ahiuve.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Joshua chu ateh-in, akumjong atamlheh tan, chule Pakaiyin ajah-a nangla natehkem tan, nakum atamlhehtan, gamtamtah lahding aumnalaijin ahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lahmoh chu hiche gamhohi ahi. Philistine le Geshur gamgichin jouse,
  </para>
  <para style="p">
    <verse number="3" style="v" />Egypt masanga um Shihora pat sahlam Kanaan mihon atouphao Ekron gamgidung geija umho, Philistine te leng ngaho, Gazeth te Ashdod te, Eshkalon ho, Gitt ho, Ekron ho chule Avi te jong ahiuve,
  </para>
  <para style="p">
    <verse number="4" style="v" />Lhanglama Kanaan miho gam jouse chule Sidon miho koma um Meareh apat Aphek lama Amor miho gamgi changei,
  </para>
  <para style="p">
    <verse number="5" style="v" />chule Gibli miho gamle Lebanon pumpi, nisolam sanga, Hermon lhangnoija Baal-gad'apat Hamath lutna changei ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lebanon'apat Misrephoth-maim changei, thinglhang gam cheng jousele amaho chu Israel chate masanga kona kadeldoh ding ahi. Sidon miho jouse, nangma kathupeh bangchun vangvet na-a konin Israel chate henga achenna diuvin ahoppeh poupouvin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun tun hiche gamhi phung ko hole Manasseh phung kehkhat ho henga agoulo diuvin hoppeh-in ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho chutoh Reuben te le Gad te chun Jordan sahlama achan dinguva Mosi'n anapeh chu anakisan taovin, Pakai soh Mosi amatah-in anapeh bang ngeichu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Arnon vapidung panga um, Aroer le vadung lailunga um khopi medeba phaicham jouse-a pat Dibon changei,
  </para>
  <para style="p">
    <verse number="10" style="v" />chule Heshbon'a lengchang Sihon, Amor mite lengpa khopi jouse Ammon chate gamgi gei,
  </para>
  <para style="p">
    <verse number="11" style="v" />chule Gilead le Geshur mite chule Maachath'te gamgisungho leh Hermon lhang pumpi chule Bashan pumpi Salcah changei,
  </para>
  <para style="p">
    <verse number="12" style="v" />Milen mihat amoh umnalai, Ashtaroth le Edrei leng Bashan na Og lenggam jouse, hicheho jeh-a hi Mosi'n amaho ana douva anadeldoh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahijeng vangin Israel chatehon anadeldoh pouve. Geshur mite ahilou jongle Maachath mite, Geshur mitele Maachath mitechu tuni geijin Israelte lah-a acheng nalai juve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman amaho koma ana seibang chun, Levi phunga miho vangchu chenna ding gam ana kipepoi. Israel Pakai Pathen'a dinga meija kigou ganlhainaho bouchu amaho gou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Mosi'n Reuben chateho chu a-insungu dungjui cheh in chenna ding gam anapei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule amaho gamding chu Arnon luipanga um Aroer'apat chule alailunga um khopilen Medeba phaicham jouse jong ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Heshbon chule phaichama um akhopilen hochu Dibon le Bamoth-baal chule Beth-baal-meon,
  </para>
  <para style="p">
    <verse number="18" style="v" />chule Jahezah le Kedemoth chule Mephaath,
  </para>
  <para style="p">
    <verse number="19" style="v" />chule damjolla um lhang chunga Kirjathaim le Sibnah chule Zareth-shahar,
  </para>
  <para style="p">
    <verse number="20" style="v" />chule Beth-peor le Ashdoth-pisgah chule Beth-jeshimoth,
  </para>
  <para style="p">
    <verse number="21" style="v" />chule phaichama um khopilen jouse Heshbonna leng Amor mite lengpa Sihon lenggam jouse Mosi'n Midia ho leng chapa jousetoh anathakhom, Evi, Rekan, Zur chule Reba chuche gama cheng Sihon leng noidouho chu ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Beor chapa Balaam doithempa jong chu Israel chaten midang atha nalah uva chun chemjamin anatha thaovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Reuben chateho gamgi chu Jordan le anaivelse chu ahi. Hiche khopihole khohohi Reuben chate a-insungu dungjuija achenna dinguva alou gam chu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Mosi'n Gad phunga Gad chateho ngeichu, a-insungu dungjuijin achenna dingu gam anapen, ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule agamsunga chu Jazer le Gilead khopilenho jouse, Ammon chateho gam akehkhat Aroer geile masanga Rabbah changei ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Heshbon'a pat Ramath-mizpeh le Betonim chule Mahanaim apat Dabir gamgi gei ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule damjol Beth-aram, Beth-nimrah, Succoth chule Zephon, Heshbon lengpa Sihon lenggam sunga amoh jouse Jordan le agamsung, Chinnereth twikhanglen pamchin geija gal langkhat Jordan solam chan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichehi Gad chate a-insung dungjuija agoulo dinguva kigotpeh khopilen hole akhoneoho chu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi'n Manasseh phung kehkhat chu alodiu gam anapei. Chule hichehi Manasseh chate phung kehkhatnin a-insungu dungjui cheh a analo chu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule hiche Mahanaim apat, Bashan pumpi gamsung Bashan leng Og gam jousele Bashan gama Jair khopi jousetoh, hichu khopilen somgup ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Gilead gam kehkhat le Ashtaroth chule Edrei Bashan Og lenggam khopi lenho Manasseh chapa Machir chateho-a ahin, Machir chatedia a-insungu dungjui cheh a kigotpeh ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichehohi Moab phaicham ho-a, Jordan gal langkhatna Jericho solam sanga Mosi'n achenna diuva ana hoppeh gamho chu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahinla Mosi'n Levi phung chu goulo gam khatcha anapepoi. Ahenguva ana seibangin, Israel Pakai Pathen chu agoulou ahijenge.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule hiche gamhohi Israel chaten Kanaan gam alonao gamho chu ahin, Eleazar thempule Nun chapa Joshua, chule Israel phungho pate lamkaihon alo diuva anahoppeh-u ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakaiyin Mosi khutna thu anapeh banga, phung ko le akehkhat dinga vang asanuva analou ahi
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Mosi'n Jordan gal langkhatna chu phung nile phung kehkhat ho chu achen nadiu anapeh ahitai. Levi te goulo ding khatcha anapepon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Joseph chate chu phungni, Manasseh le Ephraim ahin, hijeh chun Levi ho chu achen nadiu khopilen hole khopamvel ganlhat lena ding munle anachenau inmun tilou chu anape pouve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakaiyin Mosi thu anapeh bangchun Israel chateho jong hiti chun anaboluvin gamchu ana kihom uve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Gilgal'a Joshua henga chun Judah chate ahungun, chule Kenimi Jephunneh chapa Kaleb chun ahenga, Pathen mi Mosi henga Pakaiyin keimale nangma chungchang Kadesh-barnea'a aseichu nahenai, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai soh Mosi'n Kadesh-barnea'a kona gam velhi dinga eisol chun kum somlia upa kahitan, kalung ngaito bangin ahenga thu kalhut kitne.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahijeng vangin, kalhonpi kasopiho chun mipilung ajunlhah sah-un, kenvang Pakai ka Pathen chu kajuilhum keije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hicheni chun Mosi akihahselin, nangin Pakai ka Pathen najui lhumkei jeh-in, nakengin achotphah gamchu a-itih a nangmale nachate goulo gam hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule tun vetan, Israel chate gamthipma avavei laijuva Mosi henga Pakaiyin hiche thuhi Mosi henga anaseija patchun hiche kum somli le kum nga hi aseibangin Pakai chun eina hinghoijin chule tun vetan, tunin keima kum somget le kum nga kahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosi'n eina solni-a bangchun tuni geijin kahat jing nalaije. Galkon nale lhunkit theina jenga jong chupetna kathahatna bang ngeichun tunjong katha ahat jing nalaije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun tun chuche ni-a Pakaiyin anasei bangin, hiche molsangho neipetan ati. Ajehchu nangman chuche laichun Anakim miho chutobanga akhopilen nasatah tahho kulpi kiget khum ahiuchu najatai. Chutia Pakaiyin ei umpile Pakai seibanga keiman amaho chu kadeldoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Joshua'n amachu phatthei aboh-in, chule Hebron chu Jephunneh chapa Kaleb chu alodingin apetai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun Aman Pakai Israel Pathen chu ajuilhumkei jeh-in, Hebron chu tunigeijin Kenizz mi Jephunneh chapa Kaleb goulo gam ahunghitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Hebron minhi masangin Kirjath-arba anahin, hiche Arba chu Anakim miho lah-a milentah anahi. Chule agam chu galla konin akicholnga tai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin hichehi Judah phungmi chateho insungho vangsan na-a kona achanu chu ahi. Lhanglam sanga atonungpen Zin gamthip gamgi Edom gamsung geichu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule noilama agamgi chu chituipi pamchina pat ahin, twipama kona gah suhvetna lhanglam sang chu ahin,
  </para>
  <para style="p">
    <verse number="3" style="v" />chule lhanglam ngan Mealeh-acrabbin jonnin akikhosuh-in, Zin lam ajuipeh-in, lhanglam panga Kadesh-barnea geijin akikhotouvin, Hezron jonna achen, Adar geijin achen chule Karkea vella akiheitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chua konin Azmon lam ajonin, Egypt luipi lama akikhotouvin, hichu vapidunga akikholutnin, hichu lhanglam sanga nagamgi ngahna hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule solam gamgi chu chi twipi gei ahin, Jordan kichaina gei, chule sahlama gamgi chu twininglut Jordan sodohna chu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule gamgi chu Beth-hoglah'a achetoupeh-in, Beth-arabah sahlama achepeh-in, chule gamgi chu Reuben chapa Bohan songphung geijin akikhotou peh-in,
  </para>
  <para style="p">
    <verse number="7" style="v" />chule gamgi chu Achor damjolla patna Debir lama akikho toupeh-in, chutimachun sahlama Gilgal lam gahvetna vapidung lhanglam sanga um Adummin jottouna masang chu ahi. Chule gamgi ngahna chu Enshemesh twiho lamsanga akikhopeh-in, chua kona kikhodoh chu Enrogel geipeh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule gamgi chu Hinnom chapa gom'ah akikho touvin, Jabush miho lhanglam gamgi geipehchu agasun, hichu Jerusalem ahi. Chule gamgi chu Hinnom lhumlam gom masanga molvum geipeh chun akikhotouvin, hichu mihat ho umna chunglama damjol monglha sahlama uma ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule gamgi chu lhangvuma kona Nephtoah twinah geijah achesah-in Kirjath-jearim kiti Baalah lama chu kikaipeh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule gamgi chun Baalah lhumlam sanga patna Seir lhang geija chu agah kolkhum peh-a, Jearim lhang panglam ahopeh, hichu sahlama Chesalon ahin Beth-shemesh'a chesuh-a Timnah geija ajotpeh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule gamgi chu Ekron pang sahlam sanga kikho-a, chule gamgi chu Shicron geija kikhanga, Baalah mollam ajotpeh-a, Jabneel geija kikho-a, chule akondohna gamgi chu twikhanglen chu hija ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule lhumlam gamgi chu twipilen le apangchingei ahin, hichehi Judah chate insung dungjuija agam hopmu chu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Jephunneh chapa Kaleb henga chun, Joshua henga Pakai thupeh dungjuijin Judah chate lah-a chan khat Anak pa khopi Arba Hebron kiti khopi jengjong chu apen ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Kaleb'in Anak chapa thum Sheshai, Ahiman, chule Talmai, Anak chate chu adeldoh-in,
  </para>
  <para style="p">
    <verse number="15" style="v" />chuin ama chua konchun Debir'a chengho henga achetouvin, chule Debir hi masang laijin Kirjath-sepher anakitin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Kaleb'in Kirjath-espher sumanga, agajou theija chu kachanu Achsah hi ajidinga kapeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Kaleb sopipa Kenaz chapa Othniel'in hichu alatan, aman achanu Achsah chu ajidingin apetan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, aheng agalhun chun apa henga lou thumdingin ajolin ahi. Chuin amanu a-sangan chunga akumlhan, Kaleb'in amanu jah-a, ipi nadeijem? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman adonbutnin vang neiboh-in, ajehchu nangman lhanglam gam neipetan, twinah neiho neipehthan ati. Chuin aman sahlama twinahhole lhanglam twinahho chu apetai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichehi Judah chate phung a-insung dungjuija goulo gam ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Judah chate phung khopilenho Edom gamgi lamsanga lhanglam sanga gam monglha penho chu Kabzeel, Eder, Jagur,
  </para>
  <para style="p">
    <verse number="22" style="v" />chule Kinah, Dimonah chule Adadah,
  </para>
  <para style="p">
    <verse number="23" style="v" />chule Kadesh, Hazorle Ithnan,
  </para>
  <para style="p">
    <verse number="24" style="v" />Ziph, Telam, Bealot,
  </para>
  <para style="p">
    <verse number="25" style="v" />chule Hazor, Hadattah, Kerioth, Hezron, hichu Hazor,
  </para>
  <para style="p">
    <verse number="26" style="v" />Amam, Shema le Moladah,
  </para>
  <para style="p">
    <verse number="27" style="v" />chule Hazargaddah, Hashmonle Bethpelet,
  </para>
  <para style="p">
    <verse number="28" style="v" />chule Hazar-shual, Beer-sheba le Bizjothjah,
  </para>
  <para style="p">
    <verse number="29" style="v" />Baalah le Ijim le Azem,
  </para>
  <para style="p">
    <verse number="30" style="v" />chule Eltolad le Chesil le Hormah,
  </para>
  <para style="p">
    <verse number="31" style="v" />chule Ziklag le Madmannaah le Sansannah,
  </para>
  <para style="p">
    <verse number="32" style="v" />chule Lebaoth le Shilhim, A-in le Rimmon khopi lenho jouse chu somni le kole akhodang danghotoh,
  </para>
  <para style="p">
    <verse number="33" style="v" />chule phaichama chun Eshtaol, Zorah le Ashnah,
  </para>
  <para style="p">
    <verse number="34" style="v" />chule Zanoah, Engannim, Tappuah le Enam,
  </para>
  <para style="p">
    <verse number="35" style="v" />Jarmuth, Adullam, Sokoh le Azekah,
  </para>
  <para style="p">
    <verse number="36" style="v" />chule Sharaim chule Adithaim, Gederah chule Gederothaim, khopilen somleli le akho dangdang hotoh,
  </para>
  <para style="p">
    <verse number="37" style="v" />Senan, Hasashah le Migdalgad,
  </para>
  <para style="p">
    <verse number="38" style="v" />chule Dilean le Mizpeh le Joktheel,
  </para>
  <para style="p">
    <verse number="39" style="v" />Lachish, Bozkath le Eglon,
  </para>
  <para style="p">
    <verse number="40" style="v" />chule Kabbon, Lahmam le Kithlish,
  </para>
  <para style="p">
    <verse number="41" style="v" />chule Gederoth, Bethdagon, Naamah, Makkedah, khopilen somlegup le akho dang dang hotoh,
  </para>
  <para style="p">
    <verse number="42" style="v" />Libnah, Ether le Ashan,
  </para>
  <para style="p">
    <verse number="43" style="v" />chule Jiphtah le Ashnah le Nezib,
  </para>
  <para style="p">
    <verse number="44" style="v" />chule Keilah, Achzib le Mareshah khopilen ko le akho dang dang hotoh,
  </para>
  <para style="p">
    <verse number="45" style="v" />Ekron khopilen le akhodang dang hotoh,
  </para>
  <para style="p">
    <verse number="46" style="v" />Ekron'a pat twikhanglen chanpeh Ashdod naija umjouse, akhodang dang hotoh,
  </para>
  <para style="p">
    <verse number="47" style="v" />Ashdod le akhopi hole akhodang danghou, chule akhodang dangho Egypt vapidung le twipilen chule chuche gamgi ngahna changei.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule thinglhang gama Shamir le Jattir le Sokoh,
  </para>
  <para style="p">
    <verse number="49" style="v" />chule Dannah le Kirjath-sannah, Debir kiti jongchu ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule Anab le Eshtemoh le Anim,
  </para>
  <para style="p">
    <verse number="51" style="v" />chule Goshen, Holon chule Giloh, khopilen somlekhat le akhodang dang hotoh,
  </para>
  <para style="p">
    <verse number="52" style="v" />Arab, Dumah le Eshean,
  </para>
  <para style="p">
    <verse number="53" style="v" />chule Janum, Beth-tappuah le Aphekah,
  </para>
  <para style="p">
    <verse number="54" style="v" />chule Humtah, Kirjath-arba hichu Hebron kiti ahin chule Zior khopi len ko hole akho dang dangho,
  </para>
  <para style="p">
    <verse number="55" style="v" />Maon, Karmel, Ziph le Juttah,
  </para>
  <para style="p">
    <verse number="56" style="v" />chule Jezreel le Jokdeam le Zanoah,
  </para>
  <para style="p">
    <verse number="57" style="v" />Kain, Gibeah, Timnah, khopi somle kho dang dangho,
  </para>
  <para style="p">
    <verse number="58" style="v" />Halhul, Beth-zur le Gedor,
  </para>
  <para style="p">
    <verse number="59" style="v" />chule Maarath le Beth-anoth le Eltekon khopilen gupleh khodang dang hotoh,
  </para>
  <para style="p">
    <verse number="60" style="v" />Kirjath-jearim kiti Kirjath-baal le Rabbah khopilen nile akhodang danghotoh,
  </para>
  <para style="p">
    <verse number="61" style="v" />Gamthip machun Beth-arabah, Middin le Secacah,
  </para>
  <para style="p">
    <verse number="62" style="v" />chule Nibshan chule chi khopi Engedi khopilen gup leh khoneo hotoh ahiuve.
  </para>
  <para style="p">
    <verse number="63" style="v" />Jerusalem'a cheng Jebus mite vangchu Judah chaten adeldoh joupouvin, hijeh chun Jebus mite chu tuni geijin Jerusalem'a Judah chate lah-a achenghal jinguvin ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Joseph chate vang chuhna chu, Jericho koma Jordan'a pat solama Jericho twi umnagei, Jericho a kipatna gamthip geija kikhotou Bethel mol pumpi chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Bethel'a pat Luz geija akikhodoh in, Archi gamsung Ataroth geijin akikhopeh in, ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule lhumlam panga Japhleti mite gamgi Beth-horon lhang nemjo gamsung Gezer channin akikhosuh in, hichu twikhanglen'a alutnin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hitichun Joseph chate Manasseh le Ephraim'in agam chu alotaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule a-insungu dungjuijin Ephraim chate gamgi chu hitihi ahi. Solam sanga agoulou gamgi Ataroth-addar a pat Beth-horon sahlam gei ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule gamgi chu twikhanglen sahlam sanga Michmethah geijin akikhodoh-in, chule solama Taanath-shiloh geijin ahung kikhodoh-in, hichu ajotpeh-in, solama Janoah chan akikho lhungpeh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin hiche Janohah'a pat Ataroth le Naarah changei akikhosuh-in, Jericho ahopan chule Jordan'a akikholutne.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gampumpi chu Tappuah konin lhumlam sanga Kanah vapidung geijin akilhungdoh-in, hichu twikhanglen'a akikholutne. Hichehi Ephraim chate phung a-insung dungjuijuva agoulou gamchu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Manasseh chate goulah-a Ephraim chate goulo ding khopilen kikhendohho chu akhopilen jouseule akhodang dangho chu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amahon Gezer'a cheng Kanaan miho chu ananodoh pouve. Hijeh chun Kanaan miho chu Ephraim mite lah-a tuni geijin achengun kai apeovin, ajenun ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manasseh phung dingin chan khat ana umin ahi, ajehchu ama Joseph cha masapen ahi. Gilead pa Manasseh chapa masapen Machir chu ahi. Hijeh chun ama galhat ahijeh-in Gilead le Bashan gama achenge, ajehchu amaho gal hat ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A-insungu dungjuija Manasseh chilhah dangho Abiezer chate, Helek chate, Asriel chate, Shechem chate, Hepher chate chule Shemida chate dingin jong chan khat anaume. Amahohi a-insungu dungjuija Joseph chapa Manasseh chapate ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla Manasseh chapa Machir, Machir chapa Gilead chapa Hepher, Hepher chapa Zelophehad'in achanute tilou chapa aneipon, achanuteu minho chu Mahlah, Noah, Hoglah, Milkah le Tirzah ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amahon Eliazer thempu, Nun chapa Joshua chule pipuiho ang ahin naijun kasopihou lah-a goulo eipehna dingun Pakaiyin Mosi thu anapeh ahi, agatiuve. Hijeh chun Pakai thupeh dungjuijin Joshua'n apateo sopiho lah-a agoulo dingu anapetan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Jordan gal langkhatna um Gilead le Bashan tilouvin Manasseh chu chan som achange.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu Manasseh chanuten achapate lah-a gou alo khomun, chule Manasseh chapa dangho chu Gilead achang taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Manasseh gamchu Ashera pat Michmethah changei ahin, Shechem masanga um agamgi chu lhanglam En-tappuah mite chenna gam geijin akikhosuh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun Tappuah gam Manasseh achangin, ahinla Manasseh gamgi chinna um Tappuah kho chu Ephraim chate-a ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin agamgi chu Kanah vapidung lhanglama chun akilhungsuh-in, hiche Ephriam khopiho chu Manasseh khopiho lah-a aumin, chule Manasseh gamgi ngahna jongchu vapidung sahlam pang ahin, chule twikhanglen changei ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lhanglam sang chu Ephraim ahin, sahlam gam chu Manasseh'a ahin, chule twikhanglen chu agamgi ahi. Chule sahlama Asher chule niso lama Issachar gamchan chu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Manasseh chu Issachar le Asher gama Beth-shean le akhopiho, Ibleam le akhopiho Dor'a chenghole akhopiho, Endorra chenghole akhopiho, Taanach a chenghole akhopiho, Negiddo'a chenghole akhopiho, agamhou thum geijin achangin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahijeng vangin Manasseh chapate chun chuche khopi lenho-a chengho chu anodoh joupouve. Hitichun Kanaan mite chu hiche gama chun achengden taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahijeng vangin ahitin ahi. Israel chate chu ahung hatdoh phatnun, amahon Kanaan mite chu kai apehsah-un, ahinla agama konin anodoh theng theipouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Joseph chaten Joshua jah-a, tunigeija Pakaiyin phatthei eiboh jeh uva mipi hijatpi kahiu henasa-a ibola kalodiu vang khat, chan khatsehbou neipeh uham, atiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Joshua'n amaho chu adonbutnin, nangho natamlheh uva Ephraim lhanga chu natehbehseh tah uva ahile, Perizz mitele milen mihat ho gamsunga gammang lama nangho chetouvun lang gakituhchai taovin, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Joseph chate chun thinglhang gamchu keiho-a dingin alhingpoi. Jangcham gama cheng Kanaan mite jousele Bethshean le khopiho chengse chule Jezreel damjola chenghon thih kangtalai anei cheh uve atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Joshua'n Joseph insung mite Ephraim le Manasseh henga, nangho mitamle thahat tahte nahiuvin chankhat sehbou chang pouvin nate,
  </para>
  <para style="p">
    <verse number="18" style="v" />ahinla molsang hi nangho ding ahi, gammang ahijeh-in kivatchaijun lang, agamgijui chan chu nangho ding ahi. Kanaan mite chun thih kangtalai neijuhen hatlheh jongleu nanodoh dingu ahi tin aseipeh-e.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israel chate kikhom pumpi chu Shiloh a akikhom khomun, chua chun houkhom ho houbuh atungdoh-un ahi. Chule amasanguva gamchu athunoijuva aumtai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Israel chate lah-a agou chanding muloulai phung sagi aum nalaijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Joshua'n Israel chate jah-a, Pakai napateu Pathen'in napeh-u gam galo ding chu itihchan nahsah louva na-umsahdiu ham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nalah uva phungkhat cheh-a konin mi thum lhengdoh-un, chule keiman amaho kasola amaho kipat uva gamchu agachotnuva, alodiu dungjuija agasuh chetnuva kahenga hungkilekit dingu ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahon hichu hop sagi-a ahopdiu, Judah lhanglam gamsunga umding, Joseph insungin sahlam gamsung alodiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun gam umchan chu hopsagi-a photchetna nanei uva, Pakai i-Pathen'u anga nangho dinga vang kavetpeh theina dinga hiche photchetna chu kahenga nahin lhut dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla Levi miten nalah uva chan aneipouve, ajehchu Pakai thempu natoh chu amaho chan ahijenge. Chule Gad le Reuben chule Manasseh phung kehkhat vang chun Pakai lhacha Mosi'n apehnao gam Jordan gal solam chu alodiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin mihochu akipat doh-un, achetauve ahi. Gam phochenna cheho chu Joshua'n thu apen, cheovin, gamchu gachonun, gapho chenun lang hiche Shiloh-a hi nangho dinga Pakai anga vang kavet theina dingin kahenga hung kile kitnun, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin mihochu acheuvin, gamchu agachon sohkeijun, khopilen hochu lekhabua asunlutnun, mun sagin akhenun ahi. Chule Shiloh lama chun alhonpiuvin Joshua henga ahungkile kitnun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Joshua'n Shiloh-a Pakai masanga amaho dingin vang asantan ahi. Chule chuachun Joshua'n gamchu Israel chate kihop khen dungjuijin ahoppehtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Benjamin phung chilhah ho chan chu a-insung dungjuijin ahungdohtan, achandiu gamsung Judah chatele Joseph chate gam kikah chu ahung hikhatan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Sahlama agamgiu chu Jordan'a pat sahlam sanga Jericho lhang panga akikho touvin, Lhumlam molla chun akikho lutnin, Beth-aven gamthipma akilhung lutnin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule gamgi chu chu-a konchun Luz lam, lhanglama Luz kiti Bethel lhang panga akikhon, hichu Beth-horon noilam lhanglam sanga Ataroth-adar lama achesuh-in,
  </para>
  <para style="p">
    <verse number="14" style="v" />chuin agamgi chu chua konin akikhon Beth-horon toh akigalsai lhanglam sanga um molsanga pat twipilen ning chu lhum-lhanglam sanga akikho kimvelin, Judah chate khopi khat Kirjath-baal, Kirjath-jearim kiti chu ahi. Hichu nilhumlama agamgiu chu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule lhanglama agammu chu Kirjath-kearim monga kipat in agamgiu chu lhumlama akikhon Nephtoah twikulho-a akikholutnin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule agamgiu chu sahlama milen mihat ho damjola um Hinnom chapa jangcham masanga um molsanga akikho doh-in, lhanglam Jebus lhangpang Hinnom gom geijin akikhon Enrogel'a akikholutne.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule sahlama konin akikho kimvelin, Enshemesh-a akilhung lutnin, Adummin gam kentoh kigalsai Gelioth lama akilhungin chule Reuben chapa Bohan songphu-a akikholutne.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Arabah sah lamsang toh kigalsaijin akilhungpeh in, chule Arabah'a ahung kilhunglhan,
  </para>
  <para style="p">
    <verse number="19" style="v" />chuin agamgi chu Bethhoglah sahlam panga ahung kilhungin, chule gamgi akilhung doh hochu Jordan mong lhanglam chi twipi pang sahlama aumin, hichu lhanglam gamgi ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Jordan chu solam sanga gamgi ahi. A-insung dung juijin hiche gamgi jousehi Benjamin chate goulo ding chu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tun a-insungu dungjuija Benjamin chate phunga khopi lenho chu Jericho, Beth-hoglah, Keziz phaicham,
  </para>
  <para style="p">
    <verse number="22" style="v" />chule Beth-arabah, Zemaraim le Bethel,
  </para>
  <para style="p">
    <verse number="23" style="v" />chule Avim, Parah le Ophrah,
  </para>
  <para style="p">
    <verse number="24" style="v" />chule Chephar-haammonai, Ophi le Geba khopilen somlenile akhoneo hotoh,
  </para>
  <para style="p">
    <verse number="25" style="v" />Gibeon, Ramah le Beeroth,
  </para>
  <para style="p">
    <verse number="26" style="v" />chule Mizpeh, Chephirah le Mozah,
  </para>
  <para style="p">
    <verse number="27" style="v" />chule Rekem, Irpeel le Taralah,
  </para>
  <para style="p">
    <verse number="28" style="v" />chule Zelah, Eleph chule Jebus hichu Jerusalem Gibeath le Kirjath ahin khopilen somleli le akhoneo hotoh ahi. A-insung dung juija Benjamin chaten alodingu chu ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin anivei channa vangvetna chu Simeon henga, a-insungu dungjuijin Simeon chate phung dingngei chun ahungdoh-in ahi. Chule agoulo chu Judah chate goulo sunga uma ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amahon agoulo naova aneiju chu Beersheba ahiloule Sheba le Moladah,
  </para>
  <para style="p">
    <verse number="3" style="v" />chule Hazashul, Balah le Azem,
  </para>
  <para style="p">
    <verse number="4" style="v" />chule Eltolad, Bethul le Hormah,
  </para>
  <para style="p">
    <verse number="5" style="v" />chule Siklag, Beth-marcaboth le Hazar-susah,
  </para>
  <para style="p">
    <verse number="6" style="v" />chule Beth-lebaoth, Sharuhen khopilen somlethum le akhoneoho,
  </para>
  <para style="p">
    <verse number="7" style="v" />Ain, Remmon, Ether le Ashan, khopilen lile khoneoho,
  </para>
  <para style="p">
    <verse number="8" style="v" />chule lhanglama Baalath-beer, Ramath geijin hiche khopi lenho kimvela khoneoho jouse chu ahi. Hichehi a-insung dungjuija Simeon chate phungho gam lo chu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah chateho chanding lah-a chu Simeon chate goulo uma ahin, ajehchu Judah chate chanchu amaho dinga lenbehseh ahin, hijeh-a chu Simeon chate goulo chu amaho goulo sunga chu aneiju ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin a-insungu dungjuijin vangvet thumna chu Zebulun chate chunga achutai. Chule agoulo gamgi chu Sarid chan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule agamgiu chu twipia Meralah lama akilhung touvin, Dabbashath alhungin, chule Jokneam masanga vapidung chu alhungin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Sarid na konin Chisloth-tabor gamsung geijin nisolam sanga akiheijin, chuin Cabarathna achedoh-in Japhia geijin achetouvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule chua konin solam juijin Gittah-hepher le Ittah-kazin ajotpeh in, chule Remmon-mathoar'a Neah geijin achen,
  </para>
  <para style="p">
    <verse number="14" style="v" />chule agamgi chun Hannathon sahlam akhokhelin, chule akilhungdoh hochu Jiphtah-el phaicham ageijin,
  </para>
  <para style="p">
    <verse number="15" style="v" />chule Kattath, Nahalal, Shimron le Idalah chule Bethlehem khopilen somlenitoh khopineoho ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche khopilenle akhoneo hohi a-insungu dungjuija Zebulun chate goulo chu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin vangvet alina chu Issachar chunga, a-insungu dungjuijin Issachar chate dingin achutan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule agamsung chu Jezreel lamsanga Chesulloth le Shunem,
  </para>
  <para style="p">
    <verse number="19" style="v" />chule Hapharaim, Shihon le Anaharath,
  </para>
  <para style="p">
    <verse number="20" style="v" />chule Rabbith, Kishon le Abez,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Remeth, Engannim, En-haddah le Beth-Pazzez,
  </para>
  <para style="p">
    <verse number="22" style="v" />chule agamgi chu Tabor, Shahazimah le Beth-shemesh alhungin, chule agamgi ngahha kilhungdohho chu Jordan ageijin ahi. Khopilen somlegup le akhoneoho chu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khopihole akhoneoho, a-insungu dungjuija Issachar chate goulo chu hichehi ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin vangvet a-nga channa chu a-insungu dungjuija Asher chate phung dingin ahungdoh tan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule agamgi ngahna chu Helkath, Hali, Reten le Achshaph,
  </para>
  <para style="p">
    <verse number="26" style="v" />chule Allammalech, Amad, Mishal, lhumlama Karmel le Shihor-libnahth gei ahin,
  </para>
  <para style="p">
    <verse number="27" style="v" />chule nisolam sanga Beth-dago na akiheijin, Zebulun alhungin, Jiphthah-el gom Beth-emek le Neiel sahlama achen, veilamsang Cabulla achedoh-in,
  </para>
  <para style="p">
    <verse number="28" style="v" />chule Hebron, Rehod, Hammon le Kanah, Zidon len geijin jong,
  </para>
  <para style="p">
    <verse number="29" style="v" />chujouvin agamgi chu Ramah-a akiheijin, khopidet Tyre le Hosah'a akiheijin, chule akilhungdoh ho chu Achzib geija konin twikhanglen chan alhunge.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ummah jong, Aphek, Rehob, khopilen somnileni toh akhoneoho,
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiche khopihole akhohohi a-insung dungjuija Asher chate phungin alouchu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Vangvet gupvei channa chu a-insunga dungjuijin Naphtali chate dingin ahungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin agamgiu chu Heleph-a kon, Allon, Zaanannim, Adammi-nekeb, Jabneel, Lakum gei ahin, chule akilhungdoh ho chu Jordan geijin aumin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chukitnin agamgiu chu lhumlama Aznoth-tabor lama akiheijin, chua konin Hukkok alhungin, Zebulun lhanglam sang alhungin, chuin Asher lhumlam sanga achen, nisolam Jordan chunga Judah alhungin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule kul kikhokhum khopiho chu Ziddim, Zer, Hammath, Rakkath Chinnereth,
  </para>
  <para style="p">
    <verse number="36" style="v" />chule Adamah, Ramah le Hezor,
  </para>
  <para style="p">
    <verse number="37" style="v" />chule Kedesh, Edrei le Enhazor,
  </para>
  <para style="p">
    <verse number="38" style="v" />chule Iron le Migdalel, Horam, Beth-anath le Beth-shemesh khopilen somleko le khoneoho,
  </para>
  <para style="p">
    <verse number="39" style="v" />hiche khopihole khoneoho a-insung dungjuija Naphtali chate phung goulo chu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin a-insung dungjuijin vangvetna sagina chu Dan chate dingin ahungdohtan,
  </para>
  <para style="p">
    <verse number="41" style="v" />chule alodingu agamsungu chu Zorah, Eshtaol le Ir-shemesh,
  </para>
  <para style="p">
    <verse number="42" style="v" />chule Shaalabbin, Aijalon le Ithlah,
  </para>
  <para style="p">
    <verse number="43" style="v" />chule Elon le Thimnathah le Ekron,
  </para>
  <para style="p">
    <verse number="44" style="v" />chule Eltekeh le Gibbethhon le Baalath,
  </para>
  <para style="p">
    <verse number="45" style="v" />chule Jehud le Bene-berak le Gathrimmon,
  </para>
  <para style="p">
    <verse number="46" style="v" />chule Me-jarkon le Rakkon Japho naija gamgi ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule Dan chate gamsung amaho dingin aneobehseh-in hijeh chun Dan chateho Leshem chate sat dingin akonun, chule ajouvun chemjamin athat gamun, chule gamchu alotaovin, achengun, Leshem chu apao min Dan alauvin Dan asah un ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hichehi akhopihole khoneohotoh a-insung dungjuijin Dan chate phungin gouva alodingu chu ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Amahon gampumpi achanding dolcheh gamgi asekhennuva akihop jouphat un, Israel chaten alah uva Nun chapa Joshua chu agam loding apetaovin, ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Pakai thu dungjuijin aman athum Ephraim molla Timnath-serah geichun apeovin ahi. Chule aman khopilen chu asadoh-in chua chun achengtan ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hiche hohi agamlo dinguva Eleazar thempu le Nun Chapa Joshua, chule Israel chate aphunguva apa teovin, mipi ho houbuh kotpi phung, Pakai masang Siloh mun'a vangvet na-a agamlo dinguva ana hoppeh-u chu ahi. Hitihin amaho gamchu akihom jou taovin ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin Joshua jah-a aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga hitihin seijin, nanghon Mosi jah-a kasei bangin kiselna khopi lenho semmun ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mikhatnin dihloutah a koiham khat atha-a ahile kiselna dinga hicheho chu nangho-a dinga thisan so-a phulading pa-a kona hoidohna hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hitia chu ama chutobang khopilenho khatna chu jamlutna, khopi kotpiphunga adina chule chuche khopi-a um upaho jah-a ajeh aseiphongleh, amahon amachu khopi sunga alah lutnuva mun apeh dingu, hiti achu amahotoh chengding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule thisan phulading pachun, ahin nungdela ahile amahon mithatpa chu ama khutna apehdoh loudingu ahi. Ajehchu aman aheng akom chu hotna nei masalouva tosoija atha ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amachu mipi angsunga athu tandinga adin kahse-a chule hiche laija thempu chungnung thikahsea hiche khopi-a chu chengding ahi. Chutengle mithatpa chu ama khopilen ajamdohna khopi a-in'a chu kilekit ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amahon Naphtali molla um Galilee'a Kadesh, Ephraim molla Schechem chule Hebron kiti Judah molla um Kirjath-arba chu alhengun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Jericho solam Jordan gal langkhatna chun Reuben phungho lah-a phaicham gamthipma Bezer, Gad phungho lah-a Gilead'a Ramoth chule Manasseh phungho lah-a Bashan gama Golan apeovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichehohi Israel chate jousele alah uva khopem tosoija mithatchan chulama ajama thisan phulapa khutna kona athilouna dinga mipi ho masanga adin kahse-a akiselna dinga kilhengdoh khopiho chu ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Levi pateho luchangho chu Eleazar thempu heng, Nun chapa Joshua heng, Israel chate phung luchangho henga ahungun,
  </para>
  <para style="p">
    <verse number="2" style="v" />chule amahon Kanaan gamsunga um Shiloh a amaho henga kachena dingun khopi lenho chule kagancha ho dingun akhovelho eipehtha dinguva Mosi henga Pakaiyin thu anapehsa ahitai atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakai thupeh bangchun akhopilen houle akhoveluva ho jouse chu Israel chaten agoulouva konin Levi mite chandingin apeovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Kohath te insung midingin vangvetna ahungdoh in, chule Aaron thempu chate amaho chu Levi mite ahiuvin, Judah phunga konle Simeon phunga konin chule Benjamin phunga konin khopilen somlethum vangvet na-a konin achangun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Kohath chate amoh chengse chun Ephraim phung insungho-a konle, Dan phunga konin chule Manasseh phung kehkhatna konin khopilen som vangvet na-a konin achang taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Gershon chateho chun vangvet na-a konin Issachar phung insungho-a kon, Asher phunga kon, Naphtali phunga kon, chule Bashan'a um Manasseh phung akehkhatna konin khopilen somlethum achangun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Merari chaten a-insungu dungjuijin Reuben phunga kon, Gad phunga kon chule Zebulun phunga konin khopi somleni achangun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Pakaiyin Mosi athupeh dungjuijin khopilen hole akhovelho chu Israel chaten vangvet na-a konin Levi mite apetaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amahon hichea amin kisei khopilenho hi Judah chate phunga konin Simeon chate phunga konin apedoh-un;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichu Levi chate lah-a, Kohath Insunga kon Aaron chate chan chu ahi. Ajeh chu amaho chu vangvetna masapen changa ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule amahon Judah thinglhang gama akhopi Hebron chu akimvela akhovelho pumin Anak pa Arba chu apetaovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin khopilen loujaohole khoho vangchu Jephunneh chapa Kaleb lodingin apetaovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hitichun amahon Aaron thempupa chate chu mithat ho kisellutna khopilen hidingin, Hebron le akhovelho chule Libnah le akhovelho pumin,
  </para>
  <para style="p">
    <verse number="14" style="v" />chule Jattir le akhovelho pumin Eshtemoa le akhoheng pumin,
  </para>
  <para style="p">
    <verse number="15" style="v" />chule Holon le akhovelho pumin, Debir le akhovelho pumin,
  </para>
  <para style="p">
    <verse number="16" style="v" />chule a-in le akhovelho pumin, Juttah le akhovelho pumin, Beth-shemesh le akhovelho pumin, phungnia konchun khopilen ko apetaovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Benjamin phunga konin Gibeon le akhovelho, Geba le akhovel ho,
  </para>
  <para style="p">
    <verse number="18" style="v" />Anathoth le akhovelho chule Almon le akhovel hotoh khopilen li ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aaron thempu chate khopilen abonin akhovelho pumin somlethum ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Kohath chate insungho, Kohath chate amoh Levi ho chun, Ephraim phunga kona avang vetnuva kon amu-u khopilenho chu aneijun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu amahon Ephraim lhanga Shechem le akhovelho pumpin, mitha-a kona hoidohna khopilen hidingin Gezer jong akhovelho pumin,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Kibzaim le akhovelho pumin, Beth-horon le akhovelho pumin, khopilen li amaho apeovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Dan phunga kon Eltekeh le akhovelho pumin, Gibethon le akhovelho pumin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Aijalon le akhovelho pumin, Gathrimmon le akhovel ho pumin khopilen li ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Manasseh phung kehkhatna kon Tanach le akhovel ho, chule Gathrimmon le akhovel ho pumin khopilen ni ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche kho jousele akhovelho jouse-a chenghi Kohath chate insung miho amohho dingchu khosom ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Gershon chateho Levi phungho chu Manasseh phung kehkhat ho channa-a kon, mithat ho kisellutna khopi Bashan gama Golan chu akhovel hotoh Beesh-terah khole akhovel hotoh, khopilen ni apetaovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Issachar phunga konin Kishon le akhovel hotoh, Dabareth le akhovel hotoh,
  </para>
  <para style="p">
    <verse number="29" style="v" />Jarmuth le akhovel hotoh, Engannim le akhovel hotoh, khopi li ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Asher phunga kon Mishal le akhovel hotoh, Abdon le akhovel hotoh,
  </para>
  <para style="p">
    <verse number="31" style="v" />Helkath le akhovel hotoh, Rahob le akhovel hotoh khopilen li ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Naphtali phunga konin Galilee sunga um Kedesh le akhovelho pumin, mithat ho kisellutna khopilen hidingin; chule Hammoth-dor le akhovelho pumin, Kartan le akhovelho pumin khopilen thum ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Gershon mite insungho khopilen jousele akhovelho pumin, khopilen somlethum ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Zebulun phunga kon, Levi mite amohse Merari chate insungho henga Jokneam le akhovel hotoh, Kartah le akhovel hotoh,
  </para>
  <para style="p">
    <verse number="35" style="v" />Dimnah le akhovelho pumin, Nahalal le akhovelho pumin khopilen li ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Reuben phunga konin Bezer le akhovel hotoh, Zehazag le akhovel hotoh,
  </para>
  <para style="p">
    <verse number="37" style="v" />Kedemoth le akhovel hotoh, Mephaath le akhovel hotoh khopilen lima ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Gad phunga kon mithat ho hoidohna khopi Gilead gama Ramoth le akhovelho toh Mahanaim khole akhovel hotoh,
  </para>
  <para style="p">
    <verse number="39" style="v" />Heshbon le akhovel hotoh, Jazer akhovel hotoh abona khopilen li ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chutichun Levi insungmi amohse Merari chate insung mihon vangvet na-a kona amu khopilen jouse chu somleni ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Israel chaten alo sunga um Levi mite khopilen jouse chu akhovelho hop pummin somlileget ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hiche khopilenho hin akimvel aneisoh keijun; hiche khopi jouse chu chutabanga chu umcheh ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Pakaiyin apateo henga ana kihahsel nasa gamjouse chu Israel henga apetan, chuin amahon alovin chua acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule Pakaiyin apateo henga akihahsel dungjuijin, amaho akicholdosah tai. Chule amaho masanga amelmateu jouse apedohtai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Pakaiyin Israel insung henga thupha aseichan chu athonna um umlouvin, aguilhung sohkeijin ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichun Joshua'n Reuben mite, Gad mite Manasseh phung akehkhat akouvin,
  </para>
  <para style="p">
    <verse number="2" style="v" />chule ahenguva, nanghon Pakai lhacha Mosi thupeh jouse nanit sohkeijun, chule kathupeh ka aw gin jouse chu nanit un ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon nasopi ho ni hijatpihi, tuni geijin nadalha pouve. Amavang Pakai na Pathen'u thupeh chu nachingtup jingun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amaho henga akitepna bangin tun Pakai na Pathen'un nasopi hou cholngahna apetan ahi. Hichejeh chun tun, nangho Jordan gal langkhat lama Pakaiyin asoh Mosi anapeh gama chun kile taovin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla Pakai na Pathen'u ngailu dingle, alampi jouse jot dingle, athupeh ho juidingle, ama-a behjing dingle, nalhagao pumpiule nalungthimu pumpi-a jen dinga Pakai lhacha Mosi'n nathupeh-u danho tongdoh dingin chingtheijun, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun Joshua'n amaho phatthei aboh-in, asoldohtai. Chule amaho aponbuh uva akile taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tun Manasseh phung kehkhat chu Mosi in Bashan alodiuvin, anapen, ahivangin Joshua'n Jordan panga lhumlam sangchu asopite henga akehkhat chu apen ahi. Chuin Joshua'n amaho jongchu phatthei aboh-in aponbuh cheh uva asoldoh tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amaho henga, von tamtah toh thih sum-eng, sana, dangka, gancha tamtah toh gou tamtah pumin naponbuh uva kileovin, nagalteova nalah-u thilkichom nasopi houtoh kihom uvin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Reuben chate Gad chate chule Manasseh phung akehkhat akileuvin, Mosi khutna Pakaiyin athupeh banga amahon alodingu gamchu, Gilead gama chenna dinga Shiloh kiti Kanaan gama Israel chate-a konin apotdoh-un ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amahon Kanaan gamsunga um Jordan gamgi chin alhun phatnun, Reuben chate, Gad chatele Manasseh phung akeh in, Jordan pama vet dinga maicham khat asemun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Israel chaten ajah phatnun, veuvin, Reuben chate, Gad chatele Manasseh phung keh khatnin Israel lampi laija Kanaan gamtoh kigalsaija Jordan pama chun maicham khat asemuvin ahi, ti thu ajaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichu Israel chaten ajah phatnun, Israel chate abonchauvin amahotoh kidouva chedingin Shiloh a chun mipi akikhom taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Israel chate chun Eleazar thempupa chapa Phinehas chu Gilead gamsunga um Reuben chate, Gad chate le Manasseh phung akehkhat henga chun asolun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amaho chu Israel phung jouse lah-a inpi ngah cheh leng chapa som chule Israel asang asang lah-a apateo insunga a-upapen cheh ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule amaho Gilead gama um Reuben chate Gad chatele Manasseh phung akeh khat henga ahungun amahotoh akihouvun aseijuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai Mipi kikhomte chun hitin atiuve, Israel Pakai Pathen chunga ipi nasuhkhelu hitam, Pakai nung najuinaova kona nakihei mang jenguva, Pakai douna-a maicham nakitundoh jenguhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Peor'a chonsetna chu eiho dinga lhing loulai ham? Hiche-a kona chu eiho tuni geija thengloulai ihiuvin, hicheni chun Pakai mipite lah-a natset ana lengin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amavang nangho tunia Pakai nung juina-a kona hi nakihei mang got teiteiju hitam? Tunia nanghon Pakai nadou ule jing nikhole Israel mipi chunga ama lunghana hung chuding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hitajengjongle, nalonao gamchu athenlouva ahile, Pakai lona gam Pakai houbuh umna keiholah-a hungcheng jengun, amavang Pakai dounale keiho douna-in Pakai i-Pathen'u maicham tilou maicham dang semhih-un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zarah chapa Achan'in sapset thil le suhkhel aneija kona, Israel mipikikhom chunga lunghana anachu-a hilouham? Chule hiche mipa chu ama khangitlou jeh-a achangseh-a thilouva hilou ham? atiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Reuben chate, Gad chate, chule Manasseh phung akeh khatnin adonbutnun, chule Israel asang asang luchangho henga aseijun
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakai, Pathen ho Pathen, Pakai Pathenho Pathen chun ahei, chule Israel honjong ahetdingu ahi, hichehi douna ahia, ahiloule Pakai douna-a suhkhel ahile, (tunin neihinghoi hih-un),
  </para>
  <para style="p">
    <verse number="23" style="v" />Keihon Pakai nungjui na-a kona kihei mangna dinga maicham kasemuva, ahiloule achunga govam thilto katouva, chuche-a chu chamna thilto katouva ahileh Pakaiyin eiphulah-u hen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hiche kichatnajeh-a hiche chu kabollou-uleh, phat ahunglhun phatleh nachateovin kachateu henga, Israel Pakai Pathen chu ilonge nati uham? tia ahinsei theiju ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Reuben chate, Gad chate, nanghole keiho kikah-a Pakaiyin Jordan hi gamgia asem ahin, nanghon Pakaiya chan naneipouve, atiuva, nachateovin, kachateu Pakai ginna asuhtang theidiu ginna-a kabolu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichejeh chun keihon tun eiho govam thilto tona ding hilou, chule ganlhai thilto tona ding hilouvin maicham khat semdingin kigongu hite, katiuvin,
  </para>
  <para style="p">
    <verse number="27" style="v" />ahinla keihon govam thilto le, kilhaina thilto chuleh chamna thilto hotoh Pakai anga kilhaina kaboluhi khonunga hungding ichateu dinga hettohsahna hung hiding ahi. Khonungle nachateovin kachateu henga nangho Pakaiya chan naneipouve, atilounadiu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche jeh-a chu keihon hung hitiding ahi katiuve, amahon keiho koma ahiloule khonungle kasonho koma aseitengule; Veovin kapu kapa teovin Pakai maicham lim kigong abollu chu govam thiltona ding ahipon, ganlhaina ding jong ahipoi. Amavang keihole nangho kikah-a hettohsahna ahi, tia keihon kaseipeh dingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Keihon tunia Pakai kadou uva, ama-a kon kiheimanga, ahoubuh masanga um Pakai i-Pathen'u maicham tilouva govam thiltoho, nehding thilto ahilouleh ganlhaina ding dang kasem louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Phinehas thempupa aumpihon Israel asang asang luchangho le mipi kikhomho vaipohon Reuben chate, Gad chate, Manasseh chaten aseiju chu ajah phatnun, alungu alhaitan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Eliazar thempupa chapa Phinehas chun Reuben chate, Gad chate, Manasseh chate henga, tuni hin keihon ilah uva Pakai aume ti kaheuve; ajeh chu Pakai douna-in suhkhel nabol pouvin ahi. Tun nanghon Pakai khutna konin Israel chate chu nahuhdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Eliazar thempu chapa Phinehas chun vaipoho Reuben chate, Gad chate umna Gilead gama konin Kanaan gam Israel chate henga, thu ahinpo taovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule hicheho chun Israel asulunglhai lheh in, chule Israel chate chun Pathen avahchoi taovin ahi. Chule Reuben chate chenna gam suhmangna dinga galsatna cheding agotapouvin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Reuben chate, Gad chaten, maicham chu hettohsah asah-un ahi. Ajehchu hichehi eiho kah-a Pakai chu Pathen ahi ti melchihna hiding ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Israelte avelluva adou miho-a kona Pakaiyin choldona apehjou nungpeh-in, Joshua chu ateh lhehtan, chule akum atamin avoilhatan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Joshua'n Israel jouse, a-upahou, aluchanghou, avaipohou, akouvin amaho henga keima katehtan, kakum jong atamtan ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pakai na Pathen'un nangho jeh-a hiche namho jouse chunga abol hojouse hi namuvin ahi. Ajehchu Pakai na Pathen'u chu gal nasatpehpao chu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Veovin, keiman twipilen lhumlam gei jenga jong Jordan'a kona naphung houvin alotheina dinguva, keiman nam jouse kasuhmanga, hiche nam amoh ho chu vangvet na-a kahop peh-u nahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pakai na Pathen'un na masang uva kona amaho anomanga, namitmuva kona akaidoh-a; Pakai na Pathen'u naheng uva akitepna banga chu nanghon agamu chu nalo dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche jeh-a chu nangho jetlam ahiloule veilama nakiheile louna dinguva, lekha-a kisun Mosi danthu jouse jui dingle tongdoh dingin hangsanun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho lah-a umden namho lah-a chehih-un, a-pathen'u minjong pan hih-un; amaho mina kihahsel hih-un, jen jong jen hih-un, a-angsung uva jong bohkhup hih-un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla tuni chana nabol bangun Pakai na Pathen'u chu kolchah jingun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Pakaiyin namlenle namhat ho namasanguva adeldohtai. Ahin nangho dingin tunigeijin namasanguva koimacha adingjou pon,
  </para>
  <para style="p">
    <verse number="10" style="v" />nalah uva mikhatnin mi sangkhat adelthei ahi. Ajehchu Pakai na Pathen'un, nangho dinga ama kitepna banga gal nabolpeh-u ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai na Pathen'u nangailut nadingun nangho nasatah-in kigingphaovin lang hiuvin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahiloule nangho nakinung leuva, akidalha namho nalah uva cheng nalaiho hi nakivop piuva, amahotoh jilecha-a nakilah taouva, amahotoh nakiloi uva, amahon jong nakivop piuva ahile,
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai na Pathen'un leiset phatah napeh-u, hiche munna hi namanthah tokah seova amahochu nangho dinga thangle pel hiding, chule napangteni-a dinga kivohna mol, chule namit dinguva ling hunghijo ding ahi. Hijeh chun kihetchen uvin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule veuvin, tunia keima leiset mijouse lampia chemang ding kahi, chule nalungsungu le nalhagao uvin naheuve. Pakai na-Pathen'un nangho chunga asei thilho chu thil khatjong athon aumpon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeh-a chu hung hitiding ahi, Pakai na Pathen'un nateppeh dungjui uva, thil jouse chu nangho dinga apha ahunglhun banga, Pakai na Pathen'un leiset phatah napehna uva kona nasuh manghel kahseuva Pakai na Pathen'un thilphalou jouse nachunga ahinlhun sah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman nahenga nathupeh Pakai na Pathen thulhun, chu chonval tah-a nasuhkeh uva, nacheuva pathen dang naga jenuva, chule amaho anga nagabokhup-uleh, Pakai lunghanna chu hungkong jalintin, aman napeh-u gampha-a chu mangang tah-a namanthah dingu ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Joshua'n Israel phung jouse Shechem'a akhomin, Israel upaho jouse phung bulpiho athutanhou, avaipohou jouse akouvin chule amaho Pathen anga akipelut taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Joshua'n mipi ho henga hitin aseije, Israelte Pakai Pathen'in hitin aseije, nidang laijin napateu chu vadunglen gal langkhatna ana chengun, Abraham pa le, Nahor pa Terah tah-in jong, abonun pathen dang ana jenun, ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin keiman napau Abraham chu vadunglen gal langkhatna kapuidoh-in, Kanaan gamsung pumpi-a kapuijin, achilhah kapunsah-in chule Isaac kapen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keiman Isaac chu Jacob le Esau kapen, chule alodingin Esau chu Seir mol kapen ahinla Jacob le achate vang Egypt'a achesuh taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman Mosi le Aaron kasollin, Egypt gama chun alah uva thil kidang kabolin hise kalansah in chule hiche jouchun kapuidoh in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman napateu chu Egypt'a konin kahin puidoh-in, chule nangho twipi lama nahungun, chule Egypt miho chun twipisan geijin napateu chu kangtalai le sakol in ahin nungdelun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amaho Pakai henga akau le nangho le Egypt miho kikah-a aman muthim ajinsah-in, twipi chu achunguva alonsah-in, amaho akhukhumin, chule Egypt mite chunga ipi katoh ham tichu namitnun naveovin ahi. Chule nangho phat sottah gamthipma naum taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Jordan gal langa um Amor mite gama kapuilutnun, amahon nangho nakisat piuvin, chuin agamu chu nalotheina dingun amahochu nakhut uva kapen, chuin nangho masanga kasumangin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichun Moab lengpa Zippor chapa Balak akipatnin Israel asatnin, chuin Beor chapa Balaam chu nagaosap dingun akousah-in,
  </para>
  <para style="p">
    <verse number="10" style="v" />ahivangin ken Balaam thu kangaipon, hichejeh chun aman nang phatthei naboh jingin, hitia chu ama-a kona kahuhdoh nahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin nangho Jordan galla nacheovin, Jericho'a nahungun, Amor mi Perizz mi, Kanaan mi, Hit mi, Girgash mi, Hiv mi, Jebus miho chule Jericho hon nasatnun, ahin ken amaho, nangho khutna kapen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin nangho masanga amaho delmang dingin khoingal ho kasolin; Amor lengteni chunga jong, hichu nangho chemjamle thal'a kon ahipon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nangho ngaito hilouhelin ken nangho gam kapen, chule nasah louhelu khopi-a nacheng uvin, chule naphu louhelu lengpi theile Olive thei naneovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche jehchun tun, Pakai ginguvin, lunglut tahle dihtah-in jen'uvin, napa teovin vadunglen gal langkhat le Egypt gama anahouvu pathen dangho chu paimangun chule Pakai jen'uvin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangho dinga Pakai jen chu aphalou abahle, tunin najen ding chu nangman lhengdoh-in, Vadunglen gal lama napateovin anajen a-pathen hou chu najendingu ham? Ahiloule agama nana chennu Amor miho pathen chu najen dingu ham? Amavang keile ka-insung mite vangin Pakai kajen dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin mihochun adonbutnun, Pakai Pathen'in ajahda keihon pathen dang iti nama jongle jenpou vinge atiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Egypt gama keiho le kapateu soh in'a kona eipuidoh uva chu Pakai Ka Pathen'u ahin, kamit mutah uva melchihna loupitah tah abolin, chuleh kachena chanule kajotpanao miho-a konin eihuhdoh-uve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Pakaiyin mijouse, agama cheng Amor mite jengjong, kama sang uva adeldoh-in; hiche jeh-a chun keihon Pakai kajen dingu ahi, ajehchu Amachu ka Pathen'u ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Joshua'n miho henga chun Pakai chu najen theilou dingu ahi, ajehchu ama Pathen theng ahin, thangthip Pathen ahin, nagolkeh naole nachonset nahou angaidam louding ahi ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nanghon Pakai chu nadalhah uva gamdang pathen najen uva ahile, nangho dinga thilpha abolnunga, nachunga khansetna ahinlhun sah jeng ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin mipihon Joshua henga, ahipoi, keihon Pakai bou kajendingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Joshua'n mipi ho henga, nanghon Pakai jending joh tunin nakilhen taovin ahi, ti hettohsah chu nanghotah nahiuve atile amahon keihotah ahettohsah kahitaove, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichejeh chun tun nalah uva um gamdang pathenho chu paidoh-un, chule Pakai Israel Pathen henga nalungu koijun, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin mipihon Joshua henga, Pakai ka Pathen'u chu jenung kating, ama thu jengbou kangai dingu ahi atiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hicheni chun Joshua'n mipitoh thulhun asemin, chule kitepnadan kisun khatle chondan khat Shechem'a aphutdoh-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Joshua'n hiche thuho chu Pathen dan lekhabua ajihlutnin, chuin song lenpitah khat alan, gangpi phungnoi khatna atungin, hiche chu Pakai muntheng kom ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Joshua'n mipi ho henga, veuvin, hiche songhi eiho kah-a hettohsah chu ahi. Pakaiyin ihenguva aseijouse chu hiche hin ajatan ahi; hijeh-a chu hichehi nangho dinga hettohsah hiding, achutiloule na Pathen chu nuse khagetnun nate, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitichun Joshua'n mipi ho chu a-inuva kilecheh dingin akikhensahtan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule ahung hitin ahi, hiche jouchun Nun chapa Joshua Pakai soh chu kum jakhat le kumsom ahin athitan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Gaash lhang sahlam sanga, Ephraim molla um Timnath-serah sunga ama chandinga kisem gamgi chinna chun avuitaovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Joshua hinsungsen chule upaho, Joshua sanga upajoho Pakaiyin Israelte dinga anatoh jouse anaheho adam sungu chun Israel mipi ho chun Pakai anajui sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Israel chaten Egypt'a kona Joseph guho apoh touvu chu, Shechem pa Hamor chate-a kona Jacob'in dangka jakhatna anachoh achun avuijun, chule hichu Joseph chate lonamun ahitan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Aaron chapa Eleazar athitan, chuin amahon Ephraim lhanga achapa Phinehas anapehnao agamsung lhanga chun avuitaovin ahi.
  </para>
</usx>
