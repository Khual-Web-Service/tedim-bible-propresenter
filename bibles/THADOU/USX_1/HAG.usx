<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="HAG" style="id">Haggai</book>
  <para style="h">Haggai</para>
  <para style="toc1">Haggai</para>
  <para style="toc2">Haggai</para>
  <para style="mt">Haggai</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Darius lengchan kal kum nina, alhagup channa, nimasa nin Judah gamvaipo Shealtiel chapa Jerubbabel hengle, Josedech chapa thempu chungnung Joshua henga, Haggai themgaova konin Pakai thu ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Janel Pakaiyin hitin aseije, Hiche mite hin, Pakai houin sahna ding phat chu ahung lhunghih laije, atiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Haggai themgaova konin Pakai thu chu ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo nangho, Hiche houin ahomkeova auma, nangho siling in'a nachenu chu, nangho dinga aphat hinam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun tun janel Pakaiyin hitin aseije; nalampi hou ngaito temun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon tamtah natu uvin, themcha nahin polutnun; naneovin, ahinla na oiva pouvin; nadonun, ahinla nadang nou pouve; pon nakisilun, ahinla lum nasa dehpouve; atha paija lopan sumdip tovanga khum dinga alo ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Janel Pakaiyin hitin aseije; nalampi hou ngaito temun.
  </para>
  <para style="p">
    <verse number="8" style="v" />Molsang chunga kaldoh-unlang thing hinpuvin, chule houin chu saovin; chutile hichea chun lunglhai jing ting, choisanga kaumding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanghon tamtahdin nakinem un, ahinla veuvin, themchan bou ahunge; nanghon in nahinlhut tenguleh achung chu kamutji ahi. Ipi din-em? tin janel Pakaiyin aseije. Ajehchu ka-in agohkeova uma, nangho amitakipmin na-in lamcheh nadel jeh-u ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh-a chu nachung uva van chun daitwi atuhtanga, chule leiset chun aga atuhtang ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman gamsung chunga, molsang ho chunga, changle min chunga, lengpigui thah ho chunga, thao chunga, chule aga sodohji leiset chunga, mihem chunga, gancha chunga, chule khutna tonggim ho jouse chunga gamna kakou ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Shealtiel chapa Jerubbabel le Josedech chapa thempu chungnung Joshua, chule mipi amoh chengse chun Pakai a-Pathen'u aw le, Pakai a-Pathen'un ahinsol Haggai themgao thuho chu angaijun, chule mipi chu Pakai angsunga akicha lheh-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakai thupole Haggai chun miho henga Pakai thulhah chu aseijin, Keiman nangho kaumpi naove tin Pakaiyin aseije, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Judah vaipo Shealtiel chapa Jerubbabel lungthim le, Josedech chapa thempu chungnung Joshua lungthim, chule miho lah-a amoh umho jouse lungthim chu asuthouvin; chule amaho ahungun a-Pathen'u, janel Pakai in'a chun na ahung tongun ahi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichu Darius lengchan kal kum nina, lhagup channa, nisomni le nili ni ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lha sagina, chuche lha nisomni le ni khatnin, Haggai themgaova konin Pakai thu ahung lhungin, hitin aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Tun Judah gamvaipo, Shealtiel chapa Jerubbabel, Josedech chapa thempu chungnung Joshua, chule mipi amoh aumsun henga seijin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Masang laija hiche houin loupina masa mukha-a nalah uva koi umem? chule tu-a hi itobanga namu uvem? Hichu akitekah-a ahile namitmuva dinga imachalou hilouham?
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijongle tun Vo Jerubbabel, hatnin, tin Pakaiyin aseije; chule Josedech chapa, Vo thempu chungnung Joshua, hatnin; chuleh gamsunga mi jousen jong hatnunlang na tongun, tin Pakaiyin aseije; ajehchu keiman kaumpi naove tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Egypt gama kona nahungdoh laijuva kakitepna thu dungjuijin, nalah uva kalhagao acheng jinge, nangho kicha hih-un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu janel Pakaiyin hitin ati; Khatvei, chomkah louva, keiman van le leiset, chule twipi le gamgo hi kaholing ding ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nam jouse kaholinga, nam jouse ngaichat chu hunglhung ding; chule keiman hiche inhi loupi na-a kadip ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dangka chu keija ahin, sana jong keija ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche in nunung hi amasa sanga lujo ding ahi, tin janel Pakaiyin aseije: chuleh hiche mun'a hi chamna kapeh ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Darius lengchan kal kum nina, alha ko channa, nisomni le nili nin Pakai thu chu Haggai themgao heng ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="11" style="v" />Janel Pakaiyin hitin aseije; Tun thempuho chu danthupeh thudol dongin lang, seijin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi khattouvin asangkhol chola satheng chun henlang, asangkholchol chun changlhah ham, meham, lengpitwi ham, thao ham, nehthei poupou ham tongkha taleh, hiche atohkhah thilho chu atheng hintem? tin ati. Chuin thempuho chun adonbutnun, Thengponte, atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Haggai'in, Khattou thilonga kisuhboh hen, hicheho khat hi tongkha taleh, hichu boh intem? ati. Chuin thempuho chun adondutnun, Boh ding ahi atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Haggai'in adonbutnin aseije, Hiche mite leh hiche namhi kamasanga chuto bang chu ahiuve, tin Pakaiyin aseije; chule chutobang machu akhutnuva atoh jouseu, chule chua athilto hou chu thenglou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule tun, naheng uva katao ahi, Pakai houin'a song khat chunga song khat akiset thop masangin, tunia kipat khonung changei ding ngaitouvin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuche nikho laija patchun, mikhat thil tena somni kite dinga ahungleh, sombou anaumin; mikhat lengpithei chilna-a bel somnga thaldoh dinga ahungleh, somni bou anaumin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nakhut soh natoh gimna jouseova lungle nget chule gelchangin kabol gimmun, ahinla keima lama nahung kile deh pouve tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuni hiche lhako chana, nisomni le nili ni-a kipat khonung geiding ngaitouvin, houin bul kiphudoh ni-a pat jengjong hin ngaitouvin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Changsalla chu changchi um nalaijem? Lengpigui le theichang phung chule kolbu theiphung galou hiuva, chule olive thingin aga asodoh loulai ham? Tunia pat nangma phatthei kabohding nahi ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule chuche lha nisomni le nili nin, Haggai henga Pakai thu chu ahunglhung kitnin, aseije.
  </para>
  <para style="p">
    <verse number="21" style="v" />Judah gam vaipo Jerubbabel henga hitin seijin, Keiman vanle lei kaholing ding ahi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule keiman lenggam ho laltouna chu kalekhup ding, chule keiman Pathen hephalou lenggam thahatna hochu kasuhmang ding; akangtalai hou le achunga touho kale khupding; chule sakol holeh achunga touho hungkum lhadiu, mitin asopiho chemjam'a lou dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Janel Pakaiyin hitin aseije, Hiche ni chule, Vo Shealtiel chapa Kasoh Jerubbabel, keiman kalahding nahi tin Pakaiyin aseije; chule mahor banga kasem ding nahi, ajehchu kalhen nahi, tin janel Pakaiyin aseije.
  </para>
</usx>
