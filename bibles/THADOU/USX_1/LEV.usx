<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LEV" style="id">Thempudan</book>
  <para style="h">Thempudan</para>
  <para style="toc1">Thempudan</para>
  <para style="toc2">Thempudan</para>
  <para style="mt">Thempudan</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi chu akouvin, houkhom ho houbuh-a kona chun ahenga thu ahin seijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate ho henga seijin lang, ajah uva, Nalah uva khattouvin Pakai henga thilpeh ahin choija ahile, athilpeh hinchoi houchu gancha lah uva kon, bonghon lah-a kon, chule kel hon lah-a kon hitei ding.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amapa thilpeh chu bonghon lah-a kona govam thilto ahile, achal nolna beihel pehen: aman houkhom ho houbuh kotkhah phunga hing jing Pakai anga ama lungcham tah-a apehding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman hiche govam thilto luchang chunga chu akhut angap ding, chuteng hichu ama dinga longlhena bolpehna dinga kisanpeh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman bongchal chu Pakai anga atha ding: chule thempu, Aaron chapate chun thisan ahinchoi dingu, chule houkhom ho houbuh kotkhah phunga um maicham chung kimvela chu thisan chu athe chansoh dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman govam thilto chu avun alipma, hal hala achenbong ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Aaron thempu chapate chun maicham chunga mei akoidingu, chule chuche mei chunga chu thing gol kitoh chetna aset dingu,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Thempu Aaron chapateho chun akichen bong ho, aluchang, chule athao chu maicham mei kikoi chunga kise thing chunga chu kitohchetna aset dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla asungho le akengho vang chu aman twija asoptheng ding: chule thempu chun govam thilto, meija kisem thilpeh, Pakai henga gimnamtui hidinga maicham chunga chu aboncha keija ahalding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama thilpeh chu kelngoi hon ahilou leh keltah hon lah-a kona govam ganlhaina ding ahile; aman nolna beihel, achal ahin kaiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman hichu maicham sahlam panga chu Pakai angsunga atha ding; chule thempuho, Aaron chapate chun maicham chung kimvela chu thisan chu athe chansoh dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman hichu aluchang le athao toh puma achen bonga; chule thempu chun hicheho chu maicham chunga mei kihalna chunga thing kigoltoh chunga chu akoitoh chet ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla aman asungho le akengho chu twija asopding; chule thempu chun hichu aboncha ahinchoija maicham chunga ahalding ahi: hichu govam thilto, meija kisem thilpeh, Pakai henga gimnamtui chu hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai henga govam thilto-a dinga athilto chu vachaho ahitah-a ahileh, aman vakhu ahiloule vapal nou ahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thempu chun hichu maichama ahinchoija, alu ahetana, maicham chunga ahal ding ahi. Chule athisan chu maicham panga alhoh lhahding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman achang oi le amul ho chu aloidoh ding, chule maicham solam sanga vut ho umna-a chu apaiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman alha teni chu aloikeh ding, ahivanga aloikhen pai louding; thempu chun hichu maicham chung, mei chunga um thing chunga chu ahal ding: hichu govam thilto, meija kisem thilto, Pakai henga gimnamtui chu hiding ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule khat touvin Pakai henga anneh thilto atoa ahile, ama thilpeh chu changbong neljet hiding; achunga chu thao alheija, chule bego akoiding:
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman hichu Aaron chapate thempuho henga ahinchoi ding: aman hichea kona chu changbong nel chu thao toh, bego jouse toh akhut dimkhat alahdoh ding; chule thempu chun hetjingna hidinga meija kisem thilto, Pakai henga gimnamtui hidinga maicham chunga chu ahalding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule a-anneh thilpeh amoh chu Aaron le achapatea hiding ahi: hichu meija kisem Pakaiya thiltoho lah-a athengpen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman thuhkhuh-a kihonmin anneh thilto nahin choija ahileh, hichu changbong neljetna kisem cholsolou changlhah thao kihal hiding, ahilouleh cholsolou changlhah paset thao kinu hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nathilto chu bela kikang anneh thilto ahile, hichu thao toh kihal cholsolou changbong neljet hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman hichu ahal hala nakhenna, chule achunga thao nalhei ding, hichu anneh thilto hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na thilto chu thil kanna bela kikang ahile, hichu thao toh changbong neljet na kibol hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangman hiche ho-a kisem anneh thilto chu Pakai henga nahinchoi ding; hichu thempu henga akipeh tengle, aman maicham phung ahinchoilut ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thempu chun hiche anneh thilto-a kona chu hetjingna dinga phabep alahdoh-a, maicham chunga chu ahalding: hichu meija kisem thilto, Pakai henga gimnamtui chu hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche anneh thilto amoh chu Aaron le achapatea hiding ahi: hichu meija kisem Pakaiya thiltoho lah-a athengpen hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakai henga nahinpoh anneh thilto nahinchoi chanchu chola kisem hilou ding ahi: ajehchu nangman meija kisem Pakaiya thilto tapou lah-a chu chol ahiloule khoiju nahal louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin ga masaho thilto-a vang chun, hiho chu Pakai henga napeh dingu ahi: hijongle hiho chu gimnamtui hidinga maichama kihal louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anneh thilto napeh chan chu nangman chi naso cheh ding; na anneh thilto-a chu na Pakai toh nakitepna chi chu na lhahsam sah louding ahi: nathilto jouse chu chito natotha cheh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Pakai henga anneh thilto-a ga masaho nato-a ahileh, na gamasa anneh thilto nato ding chu changvui hing meija kisang go, akunga kona ki-atlha avui lhingset hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule achunga chu thao nasuna, chule chuche chunga chu thao namtui nakoi ding: hichu anneh thilto hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule thempu chun hetjingna dinga changvuija kona phabep, thao phabep le bego jouse chu ahal ding: hichu Pakai henga meija kisem thilto hiding ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule ama thilto chu chamna thilto ganlhaina ahia, ganhon lah-a kona ato-a ahile: hichu achal hihen lang anu hijongle, Pakai anga atodoh ding chu nolnabei ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman athilto luchanga akhut angapma, houkhom ho houbuh kot phunga atha ding; chule Aaron chapate thempuho chun athisan chu maicham chung kimvela chu athekhum diu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule aman chamna thilto ganlhaina chu Pakai henga meija kisem thilto-a apehding; asungho toma athao le asungho chunga athaova kaijouse,
  </para>
  <para style="p">
    <verse number="4" style="v" />Akal teni leh akong vel lah-a kai athao, chule athin chunga kai athao chu akal teni puma alahdoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Aaron chapaten hichu maicham meichunga um thing chunga govam ganlhaina chunga chu ahal dingu ahi: hichu meija kisem thilto Pakai henga gimnamtui chu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chamna thilto ganlhaina-a Pakai henga ato chu kelngoihon lah-a kona ahile; hichu achal hihen anu hijongle nolna beihel ato ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman athilto dinga chu kelngoi nou ato-a ahile, aman hichu Pakai anga atoding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman athilto doh luchang chunga chu akhut angapma, chule houkhom ho houbuh masanga hichu athading: chule Aaron chapaten chuche thisan chu maicham chung kimvel athinkhum dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman chamna thilto ganlhaina-a kona chu Pakai henga meija kisem thilto atoding; chua um athao le amei geija athao jouse chu ating juija lahdoh ding; chule asunga kai athao le asungho toma pang athao jouse,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule akalteni leh akong vel lah-a kai athao, chule athin chunga kai athao chu akal teni puma alahdoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thempu chun hichu maicham chunga ahalding: hichu Pakai henga meija kisem anneh thilto chu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule athilto chu kelcha ahia ahile, aman hichu Pakai anga atoding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman chuche luchang chunga chu akhut angapma, houkhom ho houbuh masanga athading; chule Aaron chapaten chuche thisan chu maicham kimvela athekhum dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman hiche athilto-a kona chu Pakai henga meija kisem thilto atoding; asungho toma athao le asung chunga kai athao jouse,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule akalteni leh akong vel lah-a kai athao, chule athin chunga kai athao chu akal teni puma alahdoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule thempu chun hichu maicham chunga ahalding: hichu gimnamtui hidinga meija kisem anneh ahi: athao jouse chu Pakaiya ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nanghon thao hileh thisan hileh naneh louhel dingu ahi tihi nachennao mun jouse-a akum kho-a nakhang uva chondan hijing ding ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pakaiyin Mosi henga aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga seipeh-in, Mihem khattouvin Pakaiyin bollou dinga athupehho khattou abola, hettoh lou jeh-a bollou dingho lah-a khat penpen chu anabola achonset tah-a:
  </para>
  <para style="p">
    <verse number="3" style="v" />Thao kinu thempu chu mipi ho chonset dungjuija achonset tah-a ahileh; ama chun anabolna chonset jehchun chonset thilto dingin Pakai henga nolna beihel bongchalnou khat hinkaihen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman bongchal chu Pakai anga houkhom ho houbuh kot phunga ahin kaiding, chule chuche bongchal luchang chunga chu akhut angapma, chule Pakai anga abongchal chu atha ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thao kinu thempu chun chuche bongchal thisan chu alah-a, chule hichu houkhom ho houbuh-a ahin choiding:
  </para>
  <para style="p">
    <verse number="6" style="v" />Thempu chun chuche thisanna chu akhut jung adelut ding, chule thisan chu muntheng pondal masang, Pakai angsunga chu sagivei athe ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thempu chun thisan phabep houkhom ho houbuh sunga um, Pakai anga gimnamtui maicham sakiho chunga chu akoiding; chule bongchal thisan jouse chu houkhom ho houbuh kotkhah phunga govam thilto maicham bula chu asunlhah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman chuche-a kona chu bongchal thao jouse chu chonset thilto dinga alahdoh ding; asungho toma athao le asungho chunga kai athao jouse,
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule akalteni leh akong vel lah-a kai athao, chule athin chunga kai athao chu akal teni puma alahdoh ding,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chamna thilto ganlhaina bongchala kona akilahdoh banga chu alahdoh ding: chule thempu chun hiche ho chu govam thilto maicham chunga ahal ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule bongchal vun le aphe jouse, aluchangl e akengho, chule asungho le a-eh,
  </para>
  <para style="p">
    <verse number="12" style="v" />Abongchal pumpi chu aman gebuh pam vut ho kiboh lhahna munthenga chu apohdoh-a, hichu thingchunga meija ahal ding: vut ho kisun lhah na-a chu ahal ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Israel houkhom ho chu apumpiuva hettohlou jeh-a achonset tah uva, chule athil chu houkhom mipi ho mitna kona akisela, chule amahon bol louding dol thilho chungchanga Pakai thupeh ho lah-a khatpen chu anaboluva, chule athemmo tah uva ahile;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chonset abolnao chonsetna chu akihetdoh teng, houkhom ho chun chuche chonsetna jeh-a chu houkhom ho houbuh masanga bongchal nou khat ahinkai dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Houkhom upaho chun akhutnu chu bongchal luchang chunga Pakai angsunga angap diu: chule bongchal chu Pakai angsunga kithat ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule thao kinu thempu chun bongchal thisan chu houkhom ho houbuh-a ahin choiding:
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule thempu chun chuche thisan phabep lah-a chu akhutjung adelutna, pondal masanga Pakai angsunga chu sagivei athinlhah ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule aman thisan phabep houkhom ho houbuh sunga um, Pakai anga gimnamtui maicham sakiho chunga chu akoiding; chule bongchal thisan jouse chu abona houkhom ho houbuh kotkhah phunga govam thilto maicham bula chu asunlhah ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman hichea kona chu athao jouse alahdoh sohding, chule hichu maicham chunga ahalding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman hiche bongchal chu chonset thilto bongchal abolna bang banga abolding, hitobanga chu hiche chunga hi abolding ahi: chule thempu chun amaho dinga longlhenna abolpeh-a, chule amaho kingaidam ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule aman bongchal chu gebuh pama apohdoh-a, bongchal masajo ahal banga chu ahalding ahi: hichehi houkhom ho dinga chonset thilto ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vaihom khat achonsetna, chule aman bol louding dol thilho chungchanga Pakai thupeh ho lah-a khatpen chu anabola, chule athemmo tah-a ahile;
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahilouleh, chonsetna anabol achonsetna chu ahin kihetdoh-a ahile; aman athilto-a dinga nolna beihel kelcha nou achal khat ahinkai ding;
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hiche kelcha luchanga chu akhut angapma, chule amahon Pakai angsunga govam thilto athanao mun'a athading ahi; hichu chonset thilto ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule thempu chun hiche chonset thilto thisan chu akhutjunga alah-a, govam thilto maicham sakiho chunga chu akoiding, chule athisan chu abona govam thilto maicham bula chu asunlhah ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule aman chamna thilto ganlhaina thao ahal banga, hiche thao jouse chu maicham chunga ahalding: chule thempu chun ama-a dinga achonsetna chungchanga longlhen abolpeh ding, chule ama ngaidam hiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule milham ho lah-a khattou achonsetna, chule aman bol louding dol thilho chungchanga Pakai thupeh ho lah-a khatpen chu anabola, chule athemmo tah-a ahile:
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahilouleh, chonsetna anabol achonsetna chu ahin kihetdoh-a ahile; aman chonsetna anabol achonsetna jeh-a chu, athilto-a dinga nolna beihel kelcha nou anu khat ahinkai ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule aman chonset thilto luchang chunga chu akhut angapma, chonset thilto chu govam thiltona munna chu athading ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule thempu chun chuche thisan phabep chu akhut junga alah-a, govam thilto maicham kiho chunga akoiding, chule chuche thisan jouse chu abona maicham bula asunlhah ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman chuche thao ho jouse chu chamna thilto ganlhai thao akilahdoh banga alahdoh ding, chule thempu chun hichu Pakai henga gimnamtui dinga maicham chunga ahalding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman chonset thilto dinga kelngoi nou khat ahinpohle, aman nolna beihel anu khat ahinpoh ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman chuche chonset thilto luchunga chu akhut angapma chule chonset thilpeh dinga amahon govam thilto abolnao munna chu hichu atha dingu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thempu chun chonset thilto thisan chu akhut junga alah-a chule govam thilpeh maicham kiho chunga chu anuding, chule maicham bulla chu chuche thisan jouse chu asunlhah sohding:
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman chuche-a kona athao jouse chu, chamna thilto ganlhaina-a kona kelngoinou thao akilahdoh banga alahdoh-a; chule thempu chun Pakai henga meija kisem thilto ho kibol dungjuija maicham chunga ahalding ahi: chule thempu chun amapan anabol achonsetna jeh-a chu longlhena abolpeh-a, chule ama chu kingaidam ding ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi khattou amu ahiloule ahet thilkhat chunga hettohsah-a apana, kihahselna aw ajah-a jong phongdoh louva a-ima kona achonset tah-a ahile; amatah-in themona akipoh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahiloule mi khattouvin thilthenglou khattou, sathenglou thilong hihen, ahiloule ganthenglou thilong hihen, ahiloule athenglou tolla kithol thoho thilong hijongle atoh khah-a, chule hichu aman ahetdohlou ahileh; amajong athenglou hiding, chule themmo chang hiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahiloule aman mihem khat thenlouna atoh khah-a, itobang thenlouna hijongle mihem khat suhboh theija chu atohkhah-a, chule hichu aman ahetdohlou ahileh; aman hichu ahetdoh teng, ama themmo chang hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahiloule mi khattou aphalou hihen, apha hijongle bolding akama akihahsela, itobang kihahselna hijongle akama aphondoh-a, hichu aman ahetdohlou ahileh; hichu aman ahetdoh teng, hicheho khatpen pena themo changding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hitiding ahi, ama hiche thilho khatpen pena themo achanteng, aman chuche thilla chun kachonse tai tia aphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule aman chonsetna abol achonsetna jeh-a chu Pakai henga athemona thilto, chonset thilto-a dinga ahonlah-a kona anu, kelngoinou ahiloule kelcha nou khat ahinkai ding; chule thempu chun ama-a dinga achonsetna chungchanga chu longlhenna abolpeh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule ijemtia aman kelngoinou chu ahinpoh theilou tah-a ahileh, aman anabol chonsetna jeh-a chu vakhu ni ahiloule vapal nou ni, khat chu chonset thilto dinga, chule adang khat chu govam thilto dinga Pakai henga ahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman hiche ho chu thempu koma ahinchoi ding, thempu chun chonset thilto ding joh chu atodoh masatna, chule angonga kona alu ahepela ahetan pai louding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman chonset thilto thisan chu maicham chung apanga athinlhah ding; chule thisan umnalai jouse dangho jouse chu maicham bula athin lhah ding ahi: hichehi chonset thilto chu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule aman anina chu govam thilto-a dinga akibolji ngaibanga atoding: chule thempu chun chonset anabol chonsetna jeh-a chu ama dinga longlhenna abolpeh ding, chule ama kingaidam ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla aman vakhu ni ahiloule vapal nou ni chu ahinchoi jou tah louva ahileh, achonsepa chun athilto dinga changbong neljet ephah dimkhat hopsom-a hopkhat chu chonset thilto-a dinga ahinchoi ding; hiche chunga chu thao asunlou ding, chule bego jong akoilou ding ahi; ajehchu hichu chonset thilto ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujou tengle aman hichu thempu henga ahinchoi ding, chule thempu chun melchihna dinga hichea kona chu akhut dimkhat alah-a, Pakai henga meija kisem thiltoho kibol banga, maicham chunga ahalding ahi: hichu chonset thilpeh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thempu chun hiche thilho lah-a achonsetna penpen jeh-a chu longlhena abolpeh ding, chule ama chu kingaidam ding ahi: chuleh amohcheng chu anneh thilpeh banga thempu-a ding hiding ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi khattouvin suhkhel ana neija, chule hettohlou jeh-a Pakai thil thengho chunga ana chonset tah-a ahile; chuteng aman Pakai henga asuhkhel jeh-a kelngoihon ho lah-a kona nolna beihel achal khat ahinkai ding, aman chu nangman muntheng thil tena dungjuija dangka shekel nateppeh ding: hichu suhkhel thilto hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman thiltheng chunga anasuhkhel na chu adit ding, chule nga-a khat abe-a hichu thempu henga apehding: chule thempu chun ama dinga suhkhel thilto kelngoichala chu longlhenna abolpeh ding, chule ama chu kingaidam ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule mi khattou achonsetna, chule Pakai thupeh-in boldinga aphal lou thilho lah-a khattou anabol tah-a ahileh; aman kihet hih jongle themmo chang ahin, chule akhangit louna chu akipoh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule aman kelngoihon lah-a kona nolna beihel achal khat, aman chu nangman kilom nasah dungjuija natanpeh-a, suhkhel thilto dinga thempu henga ahinkai ding: chule thempu chun ama dinga akihetdoh lou asuhkhelna chungchanga chu longlhena abolpeh ding, chule ama chu kingaidam ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichu suhkhel thilto ahi: aman tahbeh-a Pakai douna-a asuhkhel ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi khattou achonsetna, Pakai douna-a suhkhel khat aneija, chule aheng akoma thil le lo avop dinga kikoisah chungham, ahiloule kiloikhomna chungham, ahiloule pum hatna kiladoh thil kila chunghama jou abola, ahiloule aheng akom adoha bola ahile;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahiloule thil mangkhat amudoh-a, hiche chungchanga chu jou aseija, chule jouva kihahsela ahile, hitiho jouse lah-a khatpenpen abola, achonsetna ahile:
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuteng hitiding ahi, ama achonset, athemo tah jeh-a chu aman pumhatna alah ham, ahiloule doha-a kona amu ham, ahilouleh aman avop dinga kikoisah ham, ahiloule amang akimu chu hijongle alepeh ding,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahiloule ajouva ana kihahselna jouse chu hijongle; abonchang keija alhingsetna alepeh ding, chule hichea chu nga-a khat abe ding, chule suhkhel thilto ato nikho le hichu aneipa alepeh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule aman Pakai henga asuhkhel thilto-a dinga kelngoihon lah-a kona nolna beihel achal khat, aman chu nangman kilom nasah dungjuija natanpeh ding, thempu henga suhkhel thilto dinga ahinkai ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule thempu chun Pakai angsunga amapa dinga chu longlhena abolpeh ding: chule aman suhkhela anaboldoh hicheho khatpenpen jeh-a chu ngaidam changding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="9" style="v" />Aaron le achapate thu penlang, hitin seijin, Hichehi govam thilto thudola dan kipe chu ahi: maicham chunga jan khovah kei jingkah geija akihala, chule maicham meikong chu hiche sunga chu koujing jengding ahi jeh-a chu govam thilto kiti ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule thempu chun atupatpon von chu akivon ding, chule tupat pon delchen chu akichen ding, chule maicham chunga govam thilto meikouvin akahvam vut hochu alodoh-a, hicheho chu maicham panga akoiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman avonho chu asutlhah-a, chule von dangho akivon ding, chule avutho chu gebuh pam muntheng khatna apohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule maicham chunga meichu asunga chu koujing ding; hichu kisumit louding ahi: chule thempu chun jingkah sehleh hiche chunga chu thing atiding, hiche chunga chu govam thilto chu akoitoh ding; chule hiche chunga chu chamna thiltoho thao chu ahal ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mei chu maicham chunga chu a-itih-a koujing ding; hichu mitlouhel ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hichehi anneh thilto chunga danthu ahi; Aaron chapaten Pakai angsung maicham masanga chu atodoh dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman anneh thilto changbong le athao chu anneh thilto chunga kikoi bego jouse puma akhutna ahamdoh ding, hichu Pakai henga gimnamtui dinga maicham chunga hetjingna dinga ahal ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hichea kona amohse chu Aaron le achapaten aneh dingu: hichu muntheng phunga cholsolou changlhah toh amediu, houkhom ho houbuh hongsunga chu aneh dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichu chol toh kikantha louding ahi. Keiman hichehi eikipe meija kisem thilto lah-a kona amaho chan dinga amaho kapeh ahitai; hichehi chonset thilto le suhkhel thilto banga atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichu Aaron chapate lah-a pasal jousen aneh dingu ahi. Hichehi meija kisem Pakaiya thiltoho chungchanga nakhang khanguva a-itih-a dinga chondan kipe chu ahi: hicheho tongkha tapou chu atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche thilto hi thao akinu nikhouva patna Aaron le achapaten Pakai henga ato dingu thilto chu ahi; anneh thilto-a niseh-a atojing dingu chu changbong neljet ephah khat hopsom-a hopkhat hiding, akehkhat chu jingkah lamle atouva, chule akehkhat chu janle ato dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichu khangbela thao toh kibol ding; chule hichu akikan joutengleh nangman nahin choilut ding: chule anneh thilto apheng penga kikang jousaho chu nangman Pakai henga gimnamtui hidinga nato ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule ama khela thao kinu achapate lah-a kona thempupa chun ato ding ahi: hichehi Pakai henga a-itih-a dinga chondan kisem chu ahi; hichu aboncha halchai helding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu thempu-a ding anneh thilto tapou chu aboncha halchai ding ahi: hichu nehlou ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Pakaiyin hichu Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="25" style="v" />Aaron le achapateho henga hitihin seijin, Hichehi chonset thilto thudola dan kipe chu ahi; Govam thilto akithana mun tah-a chu chonset thilto chu Pakai angsunga kithat ding ahi: hichehi atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chonset thilto toh-a pang thempu chun hichu anehding ahi: hichu houkhom ho houbuh hongsung munthenga kineding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ipi hitale chuche saphe tongkha tapou chu atheng hiding ahi: chule hiche thisan chu von khattou chunga akithekhum teng, nangman ana kithekhum von chu munthenga nasopding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla chuche kihona leibel chu kisukeh ding ahi: ijemtia hichu sumsan bela kihon ahile, abel chu not thenga chule twija lhaotheng ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thempuho lah-a pasal jouse chun hichu aneh diu ahi: hichu atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule munthenga kichamna bolna dinga houkhom ho houbuh sunga thisan kipolut chonset thilto tapou chu nehlouhel ding ahi: hichu meija govam ding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chutobangma chun, hichehi suhkhel thilto thudola dan kipe chu ahi: hichehi atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amahon govam thilto athanao muntah-a chu suhkhel thilto chu atha dingu ahi: chule athi chu maicham chung kimvela athe dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule aman chuche thao jouse chu atodoh ding, amei thao le asung toma athao jouse,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule akalteni leh akong vel lah-a kai athao, chule athin chunga kai athao chu akal teni puma alahdoh ding:
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule thempu chun hicheho chu Pakai henga meija kisem thilto hidinga ahalding ahi: hichehi suhkhel thilto ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thempuho lah-a Pasal tapouvin hiche chu anehdingu: hichu munthenga kineding ahi. Hichu atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Suhkhel thilto jong hi chonset thilto kibol banga kibol ding ahi: hiche teni-a dinga hi dan khatbou uma ahi: chumuna longlhena bol thempupa chun hichu akilah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule mi koija hijongle agovam thilto tohdoh peh-a pang thempupa chun, aman atodoh govam thilto vun chu akilah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule thuh-a kikang anneh thilto jouse le thil kana bel ahiloule khangbela kisem jouse chu, apehdoh-a pang thempupa changding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule anneh thilto thao toh kihala kigotsah tapou chu, Aaron chapate jouse chang dingu, khat le khat kibang cheh-a changding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hichehi aman Pakai henga atoding chamna thilto ganlhaina thudola dan kipe chu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman hichu thangvah na-a ato ahile, aman thangvahna ganlhai chutoh thao toh kihal chol solou changlhah lumho, chule thao kinu changlhah phengho, chule changbong neljet na kisem le kikang changlhah lum thao toh kihal apehtha ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche changlhah lumho tailouva chu, achamna thilto thangvahna ganlhaina-a dinga chu chol kiso changlhah atotha ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hiche thilto jouse lah-a kona chu changlhah khatcheh Pakai henga jap thilto hidinga atoding; hichu chamna thilto ho thisan the-a pang thempupa changding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule thangvah na-a dinga chamna thilto ganlhaina saphe chu akitodoh nikho mama-a chu nehding ahi; chule aman hichu jingkah geija akhen louhel ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla aganlhaina thilto chu kihahselna, ahiloule lungcham thilto ahile, aman aganlhaina thilto atodoh nikho mama-a chu kineding: chule amoh chu ajing geija jong kineding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla ganlhaina sa amoh chengse chu anithum channi le meija halding ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ijemtia achamna thilto ganlhaina sa chu themkhat tou nithum chan ni-a ana kineh khah tah-a ahile, hichu kisanpeh louding, atohdoh pa-a dinga jong kitaipeh louding: hichu thilthet umtah hiding; chule chuche ana nepa chun akhangit louna akipoh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule thilthenglou khattou tongkha tapou sa chu nehlou ding; hichu meija halding ahi, chule satheng vangchu atheng jousen aneh dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla mihem khattou athenlouna achunga umpuma Pakaiya dinga kipedoh chamna thilto ganlhaina sa ne-a chu, hiche mipa ngeichu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujongle mihem khattou thilthenglou, mithenglou ham, ahiloule sathenglou ham, ahiloule thet umtah thilthenglou ham tongkha-a, ahia Pakaiya dinga kipedoh chamna thilto ganlhaina sa ne-a chu, hiche mipa ngeichu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="23" style="v" />Israel chate henga hitin seijin, Nanghon athao kitipou chu, bongchala hihen, kelngoija hihen, ahiloule kelcha-a hijongleh naneh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule gamsa thikam thao le gamsa hon atha sathao chu thildang danga manthei ahi; ahinla iti nama jongle hichu nanghon naneh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ijeh inem itile koihileh mihon Pakai henga meija kisem thilto-a dinga atou sa athao nechan chu,hiche mipa ngeichu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chujongle nanghon nachenna mun jouseuva thisan kiti pou pou, vacha-a hihen, ahiloule sa-a hijongle naneh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Koitobang mi hijongle thisan kiti netapou chu, hiche mipa ngeichu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="29" style="v" />Israel chateho henga hitin seijin, Koi hile Pakai henga chamna thiltoh ganlhaina pechan chun, achamna thiltoh ganlhaina-a kona chu athilto chu Pakai henga apohlut ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Akhut tah-a meija kisem Pakaiya thiltoho chu ahin choiding, a-om chu Pakai angsunga jap thilto-a jap dinga, a-om chu athaotoh ahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule thempu chun athao chu maicham chunga ahalding; amavang a-om chu Aaron le achapate chang dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule nanghon adah jetlam chu nachamna thilto hou longlhen belap thilto dinga thempu chu napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aaron chateho lah-a chamna thilto thisan le thao pe-a pang amachun adah jetlam chu ama channa changding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ijeh inem itile Israel chateho chamna thilto ganlhaina ho-a kona keiman jap thilto-a kon a-om le dop thilto-a kon adah chu kalah-a, Israel chate lah-a kona atonsotna chondan hidinga Aaron thempu leh achapate chu kapeh ahitai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichehi thempu natong dinga Pakai henga apehlut nikho-a kona Pakai henga meija kisem thiltoho lah-a kona, thao kinu-a Aaron le thao kinu-a achapate chanding chu ahin;
  </para>
  <para style="p">
    <verse number="36" style="v" />Hichu Israel chateho-a kona pehding ahi tia Pakaiyin amaho thao anu nikho-a chu akhang khanguva chondan khatna aneidiuva athupeh ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hichehi govam thilto, anneh thilto, chonset thilto, suhkhel thilto, kipeh thengna le chamna thilto ganlhainaho-a dinga dan chu ahin;
  </para>
  <para style="p">
    <verse number="38" style="v" />Hichu Pakaiyin Sinai molsanga Mosi henga, Israel chatehon Pakai henga athilto hou ato dingu ahi tia Sinai gamthipma thu apeh chunga athupeh chu ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aaron le achapate chu puijin lang, chule vonho, kinuding thao, chule chonset thilto dingin bongchal khat chule kelngoichal ni le cholsolou changlhah ephah khat kengin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule mipi ho jouse chu houkhom ho Houbuh kotphunga chun khom khomin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi'n Pakaiyin athupeh bangchun anabolin; chule mipi ho chu houkhom ho Houbuh kotphunga akikhom khom taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Mosi'n houkhom ho henga, Hichehi Pakaiyin boldinga athupeh chu ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Mosi'n Aaron le achapate chu ahinpuijin, amaho chu twijin asilin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman sangkhol chu a-ah peh-in, konggah chu akonga agahsah-in, sangkhol cho chu a-ah peh-in, thempu sangkhol chu a-ah peh-in, phatah-a kikhong thempu sangkhola gahna-a chun agah-in, chule hiche-a chun thempu sangkhol chu achunga akhitnin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman a-ompho chu a-ah peh-in; chule aman ompho-a chun Urim le Thummim akoijin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman alua thempu lukhuh akhuhpeh-in: chule Pakaiyin Mosi athupeh bangin alukhuh achalpang lama chun sana lheng, lallukhuh theng chu akoijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Mosi'n nuding thao chu alan, chule Houbuh leh asunga umjouse chu thao anun, abonin asuthengin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman hichea chun maicham chung chu sagivei athin khumin, maicham le akongle bel, atwi luina kongle akeng geijin asuthenna dingin thao anun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman kinuding thao chu Aaron lujanga asunglha-in, suhthengna dingin thao anutan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Mosi'n Aaron chapate chu ahinpuijin, Pakaiyin Mosi athupeh bangin sangkhol hochu a-ah peh-in, konggah-in akongu agah-in, chule alu uva lukop akop peh-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin chonset thilto dingin bongchal chu ahin kaijin; chule Aaron le achapate chun chonset thilto-a dingin chuche bongchal luchanga chun akhutnu angam mun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman hichu athatnin; chule Mosi'n thisan chu alan, maicham sakiho chunga chun akhut jungin akoikimvelin, maicham chu asuthengin, chule thisan chu maicham bula asunglhan, achunga kichamna bolna dingin asuthengin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman asunga athao beh jouse le athin chunga athao aumho, chule akal teni le athao chu alan, chule hichu Mosi'n maicham chunga ahaltan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla bong chal le avun, aphe leh a-eh chu, Pakaiyin Mosi athupeh bangchun gebuh pama meijin ahaltan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule aman govam thilto-a dingin kelngoi chal chu ahinkaijin: chule Aaron le achapaten hiche kelngoi chal luchanga chun akhutnu angamun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman hichu athatnin, chuleh Mosi'n thisan chu maicham chung kimvel athekhumin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman kelngoichal chu a-at tel telin, chuin Mosi'n aluchang, ahal holeh athao chu ahaltai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule aman asunglam ho le akengho chu twijin asopthengin; chuin Mosi'n kelngoi chal chu apumpin maicham chunga ahaltai. Hichu Pakaiyin Mosi athupeh banga, Pakai henga dinga meija kisem thilto, gimnamtui hidinga govam thilto chu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin aman kelngoichal dang khat, kipeh thengna kelngoichal chu ahin kaijin: chule Aaron le achapate chun hichu kelngoichal luchanga akhutnu angamun
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman hiche chu athatnin; chule Mosi'n chuche-a konchun thisan chu alan, Aaron bilkol mong jetlam le akhut jetlam khutpi chunga, chule akeng jetlam khopi chungah anun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujouvin aman Aaron chapate chu ahinpui doh-in, chule Mosi'n thisan chu abilkol mong jetlamu le akhut jetlamu khutpi chunga, chule akeng jetlamu khopi chungah anun ahi: chuin Mosi'n thisan chu maicham chung kimvela athin khumin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman thao, amei thao le asunga kai athao jouse, athin chunga athao lom, chule akal teni le athao chule adah jetlam chu alan:
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Pakai angsunga um cholsolou changlhah kikoina Pocha-a konchun, cholsolou changlhah lumkhat, chuleh thao kinu changlhah lumkhat, chule changlhah paset khat alan, hicheho chu athao le adah jetlam chunga chun akoijin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule aman abonchan Aaron khut chung le achate khutchunga akoijin, Pakai angsunga jap thilto hi dingin hicheho chu ajapmin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Mosi'n hicheho chu amaho khutna konin alan, chule maicham chungah govam thiltoho chunga chun ahaltan ahi. Hicheho hi gimnamtui hidinga kipetheng ho chu ahi. Hichehi Pakai henga dinga meija kisem thilto chu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi'n a-om chu alan, Pakai anga jap thilto dingin ajapmin ahi: ajehchu Pakaiyin Mosi athupeh banga, kipeh thengna kelngoichala kona chu Mosi chan ding uma ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Mosi'n kinuding thaova kon phabep leh maicham chunga um thisan phabep alan, chule hichu Aaron le avon chung, achapate chung le achapate avonhou chunga athin khumin, chule Aaron le avonho, chule achapate le achapate aumpiho von chu asuthengin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Mosi'n Aaron le achapate henga, Houkhom ho houbuh kotkhah phunga chun asa chu honun; chule keiman Aaron le achapaten anehdiu ahi tia kathupeh bangchun, chua chun kipehthenga pocha sunga um changlhah chutoh neuvin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule asa-a kon le changlhah-a kona akinemoh chengse chu nanghon meija nahal dingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule nangho ni sagi sung nakipeh theng nao nikho akichai tokahse-a houkhom ho houbuh kotphunga kona napotdoh louhel dingu ahi: ajehchu nangho ni sagi nakisuh theng dingu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman tunia abol banga hi, chutobanga chu nangho-a dinga longlhen bolna dinga Pakaiyin bol dinga ana thupeh ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hijeh-a chu nangho nisagi sung sun le jana houkhom ho houbuh kotphunga naum uva, Pakaiyin nanganse nao chu nathilouna dinguva nanit dingu ahi: ajehchu chutia chu keima eina kithupeh-a ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hitichun Aaron le achapate chun Pakaiyin Mosi khutna athupehho jouse bangchun abol taovin ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aniget lhinin ahitin, Mosi'n Aaron le achapate chule Israel lamkaiho akoukhomin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Aaron henga, Nangman chonset thilto dingin bongnou khat chule govam thilto dingin kelngoichal khat, nolna beihel lanlang, hicheho chu Pakai anga tohdoh-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangman Israel chate henga, Nanghon chonset thilto dingin kelchaho nou khat; chule govam thilto dingin bongnou khat le kelngoinou khat, ania kumkhat lhingbep chule nolna beihel cheh kilah-un;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Pakai anga ganlhaina le chamna thilto dingin bongchal khat le kelngoichal khat jong; chule thao toh kihal anneh thilto jong hinlaovin: ijeh inem itile tunia hi nangho henga Pakai hungkilah ding ahi, tin seipeh-in ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahon Mosi'n athupeh jouse chu houkhom ho houbuh maija ahinkai taovin: chule houkhom ho jouse chu ahung naijun Pakai anga ading taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n, Hichehi Pakaiyin nanghon nabol diuva nathupeh-u chu ahi: chutile Pakai loupina chu nangho henga hungkilah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mosi'n Aaron henga, Maicham phunglama chen, chule nachonsetna thilto le nagovam thilto gatoh-in, chule nangma dingle mipi ho dingin longlhena gabolin: chule mipi ho thilto chu toh-in lang, Pakai thupeh bangin amaho dingin longlhena gabolpeh-in, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun Aaron maicham phung lama achen, chule ama chang dingin chonset thilto bongnou chu athat tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Aaron chapaten ama henga thisan chu ahinchoijun: chule aman thisana chun akhutjung adelutnin, chule hichu maicham sakiho chunga akoijin, chule thisan chu maicham bula asunglhan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla chonset thilto thao leh akal teni, chule athin chunga thao umchu, Pakaiyin Mosi athupeh dungjuijin maicham chunga ahaltai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aphe le avun chu aman gebuh pamlamah meijin ahallin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman govam thilto chu athatnin, chule Aaron chapaten thisan chu ama henga ahinpeuvin, aman hichu maicham chung kimvela chun athen ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman govam thilto chu ahal ho le alutoh pumin ama apeovin: chule aman hicheho chu maicham chunga ahalin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman asung ho le akeng ho chu asopthengin, chule hicheho chu maicham chunga govam thilto chunga chun ahaltai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman mipite thilto chu ahin choijin, chule mipi ho dinga chonset thilto kelcha chu amanin, chule athatnin, hichu amasa-a bangin chonset thilton atoh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman govam thilto chu ahin choijin, akibol ding dungjuijin atoh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman anneh thilto chu ahin choijin, chuche-a konchun khut dimkhat alan, chule jingkah govam ganlhaina koma chun hichu maicham chunga ahalin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman mipi ho chamna ganlhai thilto dingin bongchal le kelngoichal jong chu athatnin: Aaron chapaten thisan chu ama ahin peovin, hichu aman maicham chung kimvela chun athen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule chuche bongchal le kelngoichal thao, amei thao le asunga kai athaoho, akal teni le athin chunga athao;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amahon athao chu a-om chunga akoijun, aman athao chu maicham chunga ahalin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Mosi'n athupeh bangin, a-om le adah jetlam chu Pakai anga jap thilto dingin Aaron'in ajapmin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Aaron'in mipi lam ngan akhut adomsangin, amaho chu phatthei aboh-in, chuin chonset thilto, govam thilto chule chamna thilto atona-a konin ahung kumlhatan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Mosi le Aaron chu houkhom ho houbuh sunga alut lhonin, chuin ahungdoh lhonin, mipi ho chu phatthei aboh lhonin ahi: chuin Pakai loupina chu mipi ho jouse henga ahung kilahtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Pakai anga konin meikou khat ahung doh-in, maicham chunga govam thilto le athao chu akavam tai. Mipi ho jousen hichu amu phatnun apengun, amaiju asulutnun abohkhup taove.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Aaron chapate Nadab le Abihu'in alheng cheh ala lhonin, asunga mei akoi lhonin, chuin asunga chun gimnamtui akoi lhonin, aman athupeh-u hilou Pakai angsunga mei kidangtah atohdoh lhontan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiya konin meikou ahungdoh-in, amani chu akan, Pakai angsunga chun athi lhontan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun Mosi'n Aaron henga, Hichehi Pakaiyin anasei, Keima eihin naiho-a chu suhthenga kaum ding, chule mipi ho jouse angsunga loupisah-a kaum ding ahi, tia aseichu ahi, ati. Chuin Aaron athipbeh tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi'n Aaron paneopa Uzziel chapateni Mishael le Elzaphan chu akouvin, ajah lhona, Hungnai lhonin, munthenga konin nasopite niu hi gemun pamlama podoh lhonin atin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun amani achenai lhonin, Mosi'n aseibang chun asangkhol lhona aman lhonin, apumin gebuh pama apodoh lhontai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n Aaron le achapateni Eleazar le Ithamar henga, Naluchungu hohdoh hih-un, naponu jong botkeh hih-un; achuti loule thi khaovin natin, chule mipi ho jouse chunga lunghanna hunglhung khante: ahinla nasopiteu, Israel insung pumpi hin Pakaiyin achokou meikong hi lhasetpi joh-u hen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho houkhom ho houbuh kotna kona nachedoh louhel dingu ahi, achuti loule thikhaovin nate: ijeh inem itile nachung uva Pakai thaonu chu uma ahi, ati. Chule amahon Mosi thusei bangchun abolcheh-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Aaron henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangma nahin, naumpi nachate ahiuvin, houkhom ho houbuh sunga nachelut tenguleh ju ahiloule khamnathei nadonlou dingu ahi, achuti loule nathi dingu ahi: hichehi nakhang khanguva a-itih-a dinga chonna dan hiding,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutia chu nanghon atheng le athenglou, chule angim le angimlou nase khen theijuva,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nanghon Israel chateho chu Pakaiyin Mosi khutna amaho aseipeh chondan jouse nahil theina dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mosi'n Aaron le akidalha achapateni Eleazar le Ithamar henga, Meija kisem Pakai henga thilto lah-a aval anneh thilto chu laovin lang, hichu chol beijin maicham panga chun neovin: ajehchu hichu atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nanghon hichu muntheng mun'a chu naneh dingu ahi: ajehchu hichu meija kisem Pakai henga ganlhaina ho lah-a nangma chan chule nachapate chan hija ahi: hitia hi keima eina kithupeh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule jap thilto a-op le dop thilto adahbul chu nangma le nachapaten, chule nangma toh umkhom nachanuten muntheng khatna naneh diu ahi: ajehchu hicheho chu Israel chate chamna thilto ganlhainaho-a kona kipedoh nangma chan chule nachapate chan chu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dop thilto adahbul le jap thilto a-op chu amahon Pakai anga jap thilto-a ajap dinga meija kisem athao thilto chutoh ahin choitha dingu; chule hichu Pakai athupeh dungjuija a-itih-a chondan hidinga, nangma le naumpi nachapate chanding hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Mosi'n chonset thilto kelcha chu hoitah-in akholin ahile, veuvin, hichu akahvam tan ahi: hichun ahing nalai Aaron chapateni Eleazar le Ithamar chunga chun alung ahangin, hitihin aseitai,
  </para>
  <para style="p">
    <verse number="17" style="v" />Ipiding jeh penna nanghon chonset thilto chu theng chungnung ahi ti henasa le Pathen'in hichu houkhom ho chonkhelna poding le Pakai anga amaho dinga longlhenna bolna dinga nangho napeh-u ahi ti henasa-a munthenga naneh lou uham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Veovin, athisan chu muntheng sunga ahin kichoilut poi: keiman kathupeh banga, tahbeh-a nanghon hichu munthenga nananeh ding dolu ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Aaron'in Mosi henga, Ven, tuni kho-a hi amahon achonset thiltou leh agovam thiltou Pakai anga atou ahin chule hitobang thil hohin eilhun khumtai. Chule keiman tuni hin chonset thilto chu ana netaleng, hichu Pathen mitmun san hinantem? ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Mosi'n hichu ajah phatnin, alunglhai tan ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi le Aaron henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga hitihin seipeh lhonin, Hiche hohi leiset chunga sa ho jouse lah-a naneh diu saho chu ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sa jouse lah-a kon akengtin kikhena, atin ni-a kika, chule anehsa ihdoh kitna lhaikit tapou chu naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeng jongle hiche hohin anehsa ihdoh kitna lhaikitnu henglang, atinnu kika jong le naneh lou dingu ahi: Sangongsang hin anehsa a-ihdoh kitnin alhainan, ahin akengtin akikah loujeh-in; ama chu nangho dinga athenglou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule jupi khun anehsa a-ihdoh kitnin alhainan, ahin atin akikah loujeh-in, ama chu nangho dinga athenglou ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule telep khun anehsa a-ihdoh kitnin alhainan, atin akikah loujeh-in, ama chu nangho dinga athenglou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule vohcha khu akengtin akikhena atin akikah jeng vangin, anehsa a-ihdoh-a alhailou jeh-in, ama chu nangho dinga thenglou ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho sa naneh lou dingu, chuleh athilong jong natohkhah lou dingu ahi. Amaho nangho dinga athenglou ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichehohi twilah-a um naneh dingu jouse chu ahi: twilah-a um alha le alip neitapou, twikhanglen ho-a um hihen, vadung ho-a um hijongle, hicheho chu naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule alha le alip neilou ho jouse, twikhanglen ho-a um hihen, chule vadung ho-a um hijongle, twi lah-a chatle thei jouse le twilah-a um ahingthei jouse chu, nangho-a dinga thet umtah hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amachu nangho dinga thet umtah hiding ahin; nanghon asa-u chu naneh loudiu, athilong hou chu thet uma nahet joh dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Twilah-a um alha le alip neilou tapou hu nangho dinga thet umtah hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche hohi vachaho lah-a nanghon thil thet uma nahet dingu chu ahi; nanghon hicheho chu nanehlou dingu ahin, amaho thet umtah ahiuve: mulaopi, muvanlai chule mungagal.
  </para>
  <para style="p">
    <verse number="14" style="v" />Muthong le, mu chilhah jouse:
  </para>
  <para style="p">
    <verse number="15" style="v" />Va-ah tincheng le achilhah jouse;
  </para>
  <para style="p">
    <verse number="16" style="v" />sumbupi, lhang simbu le kakhut, chule muthi le achilhah jouse,
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuleh sumbu neo, twivatot vom, chule sumbupi,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule twivatot, twilen vamuhsao, chule chammu,
  </para>
  <para style="p">
    <verse number="19" style="v" />Twiva, Vakengsang chule achilhah jouse, chule Vashonglhu chule bah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tolla vah vacha jouse, akeng li-a che ho jouse chu nangho dinga thet umtah hiding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijongle nanghon nanehthei tolla vah kengli nei ahia lengle thei hochu, lei chunga chople nathei ding akengphang chunguva kengho neichan chu;
  </para>
  <para style="p">
    <verse number="22" style="v" />Amaho lah-a kona hicheho hi naneh thei dingu ahi; khaokho leh achilhah, khaonam leh achilhah, lhenglhe le achilhah, chule khaokhopi le achilhah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla adang tolla vah kengli nei ahia lengthei jouse chu nangho dinga thet umtah hiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hicheho jeh-a hi nangho athenglou nahi dingu ahi: koi hile amaho thilong tongkha chu nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule koi hileh amaho thilong pokha chun apon akisop ding ahin, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sa akeng tin kikah-a ahia ni kisolou leh anehsa ihdoh-a lhailou taphot thilong chu nangho dinga aboh ahin; atongkha tapou chu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule akeng li-a che gamsa jouse lah-a, akhophanga chetapou chu nangho dinga aboh ahi; koi hileh amaho thilong tongkha chan chu nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule amaho thilong pokha chanchun aponho akisop ding, chule nilhah tokah-a aboh hiding ahi; amaho chu nangho dinga aboh ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hicheho jong hi leichunga vah ganhingho lah-a nangho dinga aboh hiding ahiuve; kongkoi, jucha, sumkong le achilhah,
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule khoili, thangkip, tangnam, dahdeng chule bui,
  </para>
  <para style="p">
    <verse number="31" style="v" />Hicheho hi avathoho jouse lah-a nangho dinga aboh hochu ahiuve: koi hileh amaho athi nunguva tongkha chan chu nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule ipi hitaleh hicheho hin athi nungule alhah khum pennu chu aboh hiding ahi: thinga kisem umle bel hihen, von hihen, vun hihen, dip hihen, chule itobang umle bel hihen ipi tobang bolna-a kimangcha hijongle, hichu twija delut ding ahin, chule hichu nilhah tokah-a aboh hiding ahi; chutengle atheng hibep ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule hicheho chun akheh khum leibel tapou chu, asunga chu ipi uma hijongle aboh hiding; chuleh nanghon leibel chu nasukeh dingu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nehthei anneh jouse lah-a chutobang twijin ajotkhum tapou chu aboh hiding: chule chutobang lhenga kona kidon tapou jongchu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule hicheho thilong halkhat nin alhahkhum thil tapou chu aboh hiding ahin; tapkong hihen, bel kitunggol hijongle, hicheho chu suhset hiding ahi: ajehchu hicheho chu aboh ahin, chule nangho dinga aboh hiding ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hijeng jongle twinah ahiloule komtong twi nengtah-a aumna mun chu atheng hiding ahi: ahinla ipi hijongle hicheho thilong tongkha chan chu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule hicheho thilong halkhat chun tuding muchi khattou akheh khuma ahile, hiche chu atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahinla amuchi chunga chun twi themkhat akikoija, chule hicheho thilong halkhat chu hiche chunga chu achuh-a ahile, hichu nangho dinga aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule naneh theiju saho lah-a kona khattou athia ahile; athilong tongkha chanchu nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule chuche thilong nekha chun aponho akisop ding, nilhah tokah-a aboh hiding ahi. Chule chuche thilong popa jongchun aponho akisop ding, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule leichunga kitholtho ganhing tapou chu thet um hiding ahi; hichu nehlou helding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ipi hitaleh a-oija kithol, kenglia chetho, ahilouleh leichunga kithol tho ganhingho lah-a keng tampi neija kitholtho ho, hicheho chu nanehlou dingu ahi; ajehchu hicheho chu nangho dinga thet um ahiuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangho akitholtho ganhing tapouva naki suhboh louhel dingu, chule naboh louna dinguva amaho-a kona jong nakisuhnet lou dingu ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ijeh inem itile keima Pakai na Pathen'u kahi. Hijeh-a chu nangho nakisuh thenguva, atheng nahi dingu ahi; ajehchu Keima atheng kahi. Chule leichunga kitholtho ganhing tapouva nangho le nangho naki suhboh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ijeh inem itile keima na-Pathen'u hidinga Egypt gama kona nahin puidoh uva Pakai chu kahi; Hiche jeh-a chu nangho nathen dingu ahi; ajehchu keima atheng kahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hichehi saho, vachaho, twilah-a vahle ahingthei jouse, chule leichunga kitholthoho chung changa dan chu ahi;
  </para>
  <para style="p">
    <verse number="47" style="v" />Aboh le atheng khenna dingle, sa nehthei le nehtheilou kisekhen theina dinga ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga hitihin seijin, Numei khatnin nao avopma cha pasal ahina ahile, amanu chu ni sagi aboh hiding; anumei hina-a athenlou nikhoho dungjuija aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule niget chan nileh naosen chep chu kitanding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amanu chun athisan kisuhtheng na-a nisomthum le nithum gei ajomding; akisuh thengna nikho alhin kahse-a munthenga jong lut louding chule thiltheng tapou jong atoh khah thei lou ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahinla amanun numei ahina ahile, anumei hina athenlouna nikho dungjuija hapta ni aboh hiding ahi. Chule amanu chun thisana akisuh thengna chu ni somgup le nigup ajompeh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amanu kisuhthengna nikhoho alhin tengle, amanun chapa-a ding, ahiloule chanua dinga govam thilto dinga kelngoinou kumkhat lhingbep khat; chule chonset thilto dinga vakhu nou ahiloule vapal khat houkhom ho Houbuh phunga chu thempupa henga ahinchoi ding:
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman hichu Pakai anga ato-a, amanu dinga longlhena abolpeh ding: chule amanu chu athilonna-a kona chu suhtheng hiding ahi. Hiche cha pasal ahilouleh cha numei hingnu-a dinga dan chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ijemtia amanun kelngoinou ahinchoi joutah louva ahileh, amanun vapal ni ahiloule vakhu nou ni; khat govam thilto ding chule adang khat chu chonsetna thilto dinga ahinchoi ding: thempu chun amanu dinga longlhena abolpeh-a, chule amanu chu theng ding ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pakaiyin Mosi le Aaron henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mikhatnin atahsa chung avuna abohdoh khat, akhih khat, ahiloule akangdoh laikhat ahin neija, chule hichu atahsa vunna phah natna tobang ahia ahile, chuteng ama chu Aaron thempupa ahilouleh achapate thempupaho henga nahin pui dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule thempupa chun tahsa vuna hise chu avetding; chule natna laija timul chu ahung kana, chule natna kimuchu atahsa vun sanga athuh johle, hiche chu phahna hise ahi: chule thempupan ama chu avetna, chule amachu aboh ahi tia aphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ijemtia atahsa vuna ahung ngoudoh lai chu ahung kana, chule mutheija avun sanga athuhjoh louva, chule atimul chu ahung kan louva ahile, thempupa chun chuche hise neipa chu ni sagi akhatup ding:
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule ni sagi lhin nileh thempupa chun amachu avetna, chule veuvin, anatna chu amitmua atan dena, chule hise chu avuna chal louva amule, thempupa chun amachu ni sagi akhatup beding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule ni sagi lhin nileh thempupa chun amachu avetkitna, chule veuvin, hise chu avomthima, chule hise chu avuna chal louva amule, thempupa chun ama chu atheng ahi tia aphondoh ding ahi: akhihbou ahi; amachun aponho akisopma, atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla akisuhtheng nadinga thempupa akimupi jouva, akhih chu avuna achallheh jenga ahile, amachu thempupan avetkit ding:
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule thempupa chun avetna, akhih chu avuna challa amuleh, chutengle thempupan amachu aboh ahi tia aphondoh ding ahi: hichu phahnat ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Phahna hise chu mikhat chunga aumteng, amachu thempupa henga kipuiding ahin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule thempupan amachu avetna, veuvin, avuna apomdoh lai vun chu akana, hichun amul chu akansah-a, chule apomdoh laija chu vouthah-a amua ahile,
  </para>
  <para style="p">
    <verse number="11" style="v" />Amapa vuna chu phahna lui uma ahin, thempupan amachu aboh ahi tia aphondoh-a, akhatup louding ahi: ajehchu ama phah-a ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule phahna chu avuna ahung jaldoh-a, chule phahna chun hise neipa vun chu thempupan avetna lam jouse aluchanga patna akeng phang geija atomsoh hela ahile,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutengle thempupan angaito ding: chule veuvin, phahna chun amapa tahsa pumpi chu atoma ahile, thempupan hise veipa chu atheng ahi tia aphondoh ding ahi. Aboncha keija hung kang soh-a ahitan, amachu atheng hiding ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla ama-a chu vouthah ahungdoh-a ahile, amachu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule thempupan hiche vouthah chu avetna, amachu aboh ahi tia aphondoh ding ahi: ajehchu vouthah chu aboh-a ahin, hichu phahnat ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahiloule vouthah chu ahung kikhel kitna, chule akang ahung kiso kitna ahile, amachu thempupa henga hung ding;
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule thempupan ama avetding; chuleh veuvin, hise chu akanga ahung kikhel kitna ahile, thempupan hise veipa chu atheng ahitai tia aphondoh ding ahi: amachu thenga ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Atahsa ativuna chu uilut ahungdoh-a, chule hichu adam tah-a,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule uilut umna mun'a chu ahung pomdoh akang, ahiloule ahung ngoudoh laikhat auma, chule iti hama santhim dana auma ahileh, hichu thempupa henga vetsah ding ahi:
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule hichu thempupan avetna, avun sanga thuhjoa amua, chulai mun'a amulchu akanga kikhela ahile, thempupan amachu aboh ahi tia aphondoh ding ahi: hichu uilutna kona hung sohdoh phahna hise chu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla, thempupan hichu avetna, chule veuvin, hia chu amul akang aumlouva, chule hichu avun sanga athuhjoh louva, avomthima ahile, chuteng chule thempupan amachu ni sagi akhatup ding:
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hichu avuna akithe jala ahile, thempupan amachu aboh ahi tia aphondoh ding ahi: hichu hise ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla ahung ngoudoh laichu angai ngai ahijinga, achal louva ahile, hichu uilut ahibouvin; chule thempupan amachu atheng ahi tia aphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahiloule mihem khat meijin atahsa akah-a, meijin akahna aphelai laijachu ahung vamdoh, asanthim ahiloule akang auma ahile,
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutengle hichu thempupan avetding, chule veuvin, ahung vamdohdoh laija amulchu ahung kana, chule avun sanga agathuh lutna ahileh, hichu meikah-a kona hung potdoh phahnat ahi. Hiteng chule thempupan amachu athenglou ahi tia aphondoh ding ahi: hichu phah hise ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla thempupan hichu avetna, chuleh ahung vamdoh laija chu amulkang umlouva, chule hichu avun dangho sanga athuhjoh louva, avomthima ahile, thempupan amachu ni sagi akhatup ding:
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule ni sagi lhin nile thempupan amachu avetding, chule veuvin, avun sunga chu hichu nasatah-a akithejala ahile, thempupan amachu aboh ahi tia aphondoh ding ahi: hichu phahna hise ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule ahung vamdoh laichu angai ahijinga, chule avuna akithejal louva, ahia hichu avom thima ahile, hichu meikah-a kona hung duldoh ahin: thempupan amachu atheng ahi tia aphondoh ding ahi; ajehchu meikah jeh-a hung khidoh ahibouve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pasal ham numei ham aluchang ham ahilouleh akhamul hama chu hise aneija ahile,
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuteng thempupan hise chu avetding, chule veuvin, hichu avun sanga agathuhlut joh-a, chule chua chu ai-eng ena eng mulngat khat auma ahile; chuteng thempupan amachu aboh ahi tia aphondoh ding ahi: hichu tithah luchunga ahilouleh khamula um phahna ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule thempupan tithah hise chu avetna, chule veuvin, hichu avun sanga agathuh lutjoh louva, chule chuche-a chu mulvom aumlouva ahile, thempupan tithah hise neipa chu ni sagi akhatup ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule ni sagi lhin nileh thempupan hise chu avetding, chule veuvin, tithah chu kithejal louva, chule hichea chu ai-eng enna eng amul jong aumlouva, chule tithah chu avun sanga agathuh lutjoh louva ahile;
  </para>
  <para style="p">
    <verse number="33" style="v" />Amachu amul hetngima umding, amavang tithah laichu ahetngim louding ahi; chule thempupan tithah neipa chu nisagi akhatup beding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule ni sagi alhin nile thempupan tithah chu avetding, chule veuvin, tithah chu avuna akithejal louva, ahiloule avun sanga jong agathuh lutlouva ahile, thempupan amachu atheng ahi tia aphondoh ding; chule amachun aponho akisopma, chule atheng hiding ahitai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahinla akisuhngim jouva tithah chu avuna akithejala ahileh;
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuteng thempu pan ama avet ding, chule veuvin, tithah chu avuna akithejala ahile, thempu pan ai-eng eng mul aholkhoh louding ahi: ama athenglou ahitai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ahinla tithah chu aumdenna, chule chuche mun'a chu mulvom ahung kedoh-a, chule tithah chu adam tah-a ahile, amachu atheng ahitai: thempupan amachu atheng ahi tia aphondoh ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pasal ham ahiloule numei hamin atahsa vuna chu ahung vamdoh, akang hung vamdoh aneija ahile;
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuteng thempupan avetding ahi: chule ativun ahung vamdoh hochu akangdup leh, hichu avuna tikang hung umdoh-a ahin; ama atheng ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule pasal alua kona asam pullha-a chu luchai ahin, atheng ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule pasal alujang mailam panga asam pullha-a chu dehchai ahin; ama atheng ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule ijemtia aluchai ahiloule adehchai laija chu tina sandang khat ahung bohdoh-a ahile, hichu aluchai ahiloule adehchai laija phahnat hung pongdoh chu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuteng thempupan hichu avetding, chule veuvin, aluchai ahiloule dehchai laija tina hung bohdoh chu tivun danga phahna hung pongdoh tobanga asandang ahile;
  </para>
  <para style="p">
    <verse number="44" style="v" />Amachu miphah ahin, aboh ahitai: thempupan amachu aboh tahbeh ahi tia aphondoh ding ahi; hise chu alujanga uma ahitai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule hise neija miphah chun aponho abokeh ding, chule alu tol puma ane chunglam akhu ding, chuleh athenglou, athenglou, tia asapding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ama-a hise chu aum laisung nikhoho lhungkeija amachu suhboh hiding ahi; ama athenglou ahin; achanga chengding ahi: gebuh pamlam chu ama chenna ding ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Phahna hise umna von jong chu, samul von hihen, tupat ponnel von, hijongleh,
  </para>
  <para style="p">
    <verse number="48" style="v" />Akikhonto hihen akisahtho hihen, tupatpon hihen, samul pon hijongleh, savun hihen ahilouleh savuna kisem thilkhat pou pou hijongleh,
  </para>
  <para style="p">
    <verse number="49" style="v" />Hise chu von akikhontho ham, akisahtho ham, savun ham, savun thil itobang khat pou pouva eng danga ahilouleh sandanga abe-a ahile, hichu phahna hise ahin; chule thempupa henga vetsah ding ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule thempupan hise chu avetding, chule hise po-a von chu ni sagi akhatup ding ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chule hise chu ni sagi lhin nileh avetding; hise chu von akikhontho ahiloule akisahtho chung, samul chung, savun chung, ahiloule savuna kisem ipi chung hijongle, hise chu akithe jala ahile; hise chu tijat umtah phahnat ahi: hichu aboh ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hijeh-a chu aman chuche von chu akikhontho hihen, akisahtho hile, samula hihen, tupatna hile, ahilouleh savun thil ipi hitaleh ahallhah ding ahi; ajehchu tijat umtah phahnat ahin; hichu meija hallhah ding ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chule thempupan avetna, chule hise chu von akikhongtho hihen, akisahtho hileh, ahilouleh savun thil kiti pou pouva chu kithejal louva ahile;
  </para>
  <para style="p">
    <verse number="54" style="v" />Chutengle thempupa chun hise umna thil chu asop dinguva amaho athupeh ding, chule ni sagima hichu akhatup beding:
  </para>
  <para style="p">
    <verse number="55" style="v" />Chule hichu akisop jouteng thempupan hise chu avetding, chule veuvin, hise chu avouso akikhelchom louva, chule hise chu akithejal louva ahile; hichu aboh ahin; nangman hichu meija nahalding ahi: hichu asunglama tijat umtah ahin; asung hihen apolam hijongle aneh ahitai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Chule thempupan avetna, chule veuvin, hise chu akisop jouva avom thima ahile, chuteng hichu vona kona, savuna kona, ahilouleh akikhontho le akisahtho-a kona asalhah ding ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chule hichu von chunga akikhontho hihen, akisahtho hijongleh, chule savun pon pou pou chunga chu akilah nahlaija ahile, hichu akithejal hise ahin; nangman hise chu meija nahalding ahi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Chule von, akikhontho hihen, akisahtho hileh, ahilouleh savuna kisem itobang von hitaleh nasop ding, chule hichea kona chu hise chu apotdoh-a ahile, ani veina nasop kitding; chutengle atheng hiding ahitai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Hiche hohi von samula hihen, tupatna hile, akikhontho hihen, akisahtho hijongleh, ahilouleh savun thilkhat pou pouva phahna hise umchu atheng ahi, ahilouleh athenglou ahi tia phondohna ding dan chu ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichehi miphah kisuhtheng nikho-a juiding dan chu ahi. Amachu thempupa henga ahinpui dingu;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule thempupa chun gebuh-a kona potdoh ding; chule thempupa chun avetding, chule veuvin miphahpa chunga hise chu adam tah-a ahile;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuteng thempupan akisuhtheng dingpa henga kona chu vacha theng ahing ni, chuleh Cedar thing, ponsanthip le Hyssop lah dinga athupeh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule thempupa chun vacha ho lah-a khat chu leibel sunga twi lona chunga nathadiu ahi, tia athupeh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vacha ahingpa chu ahile, cedar thing, Ponsandup chule Hyssop chu alah-a, hicheho chu vacha hing chutoh twi long chunga kithat vacha thisana chu adelut ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule aman aphahna akona kisutheng dingpa chunga sagi vei athin ding, chule amapa chu atheng ahitai tia aphondoh ding, chule vacha hing chu gam onga alha mang ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule akisutheng dingpa chun aponho asopma, chule asam jouse ahet tolla, ama athen theina dinga twija gakisil ding ahi. Chujou teng chule ama gebuh sunga hunglut ding, aponbuh pama ni sagi khongai nalai ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla ni sagi lhin ni-a chu aman aluchanga asam jouse, akhamul chuleh amitchung mul jouse, amulho jouse ahet ngima, chule aman aponho asopma, ama tahsa jeng jong twija asil ding ahi, chule ama theng ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule niget lhin nileh aman nolna beihel kelngoinou chal ni leh, nolna beihel kelngoinou anu kumkhat lhingbep khat, chule anneh thilto ding changbong nel thao toh kihal ephah hopsom-a hopthum, chule thao log khat ahin choiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ama suthenga pang thempupa chun akisutheng dingpa le chuche thil ho chu houkhom ho houbuh kotphunga apehlut ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule thempupa chun kelngoinou khat chule thao log khat chu alah-a, suhkhel thilto dinga ato-a, chule Pakai angsunga jap thilto-a ajap ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman kelngoinou chu chonset thilto chule govam thilto athana ding munthenga mun'a chu athading ahi; ajehchu chonset thilto thempupa-a ahibanga, suhkhel thilto jong chutobangma chu hija ahin; hichu atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule thempupa chun suhkhel thilto thisan chu phabep alah-a, thempupan hichu akisutheng dingpa jetlam bilmong, akhut jetlam khutpi chung, le akeng jetlam kengpi chunga anuding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule thempupan thao log khatna kona chu phabep alah-a, aveilam khutphang chunga alheilhah ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule thempupan akhut veilama um thaova chu akhut jetlam khut jung adelutna, akhut junga thao chu Pakai anga sagivei athe ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule akhutna umnalai thao amohse chu thempupa chun akisutheng dingpa jetlam bilmong, ajetlam khutpi, ajetlam kengpi chunga, chule suhkhel thilto thisan chunga chu anuding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule thempupa khutna thao umnalai amohchu aman akisutheng dingpa lujanga asunlhah ding, chule thempupan ama dinga chu Pakai anga longlhena abolpeh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule thempupa chun chonset thilto chu ato-a, athen louna-a kona kisutheng dingpa-a dinga longlhenna abolpeh ding; chule aman govam thilto chu athading ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule thempupan maicham chunga um govam thilto le anneh thilto chu atoding, chule thempupan ama dinga longlhena abolpeh ding: chuteng ama atheng hiding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla ama chu mivaicha ahia, chuchengpi chu atojou louva ahile, aman alonglhena kibolna dinga suhkhel thilto-a jap dinga kelngoinou khat ahin kaiding; chule anneh thilto-a dinga changbong neljet thao toh kihal ephah hopsom-a hopkhat le thao log khat,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule aman amujou dandana vapal ni ahiloule vakhu nou ni; khat chu chonset thilto ding le adang khat chu govam thilto dinga ahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hicheho chu aman niget lhin nileh akisuhtheng nadinga thempupa henga, houkhom ho Houbuh kotphunga Pakai angsunga chu ahin choiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule thempupa chun suhkhel thilto kelngoinou leh thao log dimkhat chu alah ding, chule thempupa chun hichu Pakai anga jap thilto ato ding;
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuteng aman suhkhel thilto kelngoinou chu athading, chule thempupa chun chuche suhkhel thilto thisan phabep chu alah-a, akisutheng dingpa jetlam bilmong chunga, ajetlam khutpi chunga, chule ajetlam kengpi chunga anuding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule thempupa chun thao chu ama khutphang veilam chunga alheilhah ding,
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule thempupa chun akhut veilama um thao chu ajetlam khutjunga sagi vei Pakai angsunga athe ding,
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule thempupa chun akhutna thao chu akisutheng dingpa jetlam bilmong chunga, ajetlam akhutpi chung, ajetlam kengpi chunga, chule suhkhel thilto thisan chunga chu anuding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule thempupa khutna aum nalaiho sechu, aman akisutheng dingpa lujanga anua, amapa-a dinga chu Pakai anga longlhena abolpeh ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule aman amapan amujou dungjuija ahinchoi vakhu teni ahilou leh vapal nou teni chu lah-a, khat chu atoding,
  </para>
  <para style="p">
    <verse number="31" style="v" />Amapan amujou dungjuija khat chonset thilto dinga, chule adang khat chu anneh thilto le govam thilto dinga ahinchoi ding, chule thempupa chun Pakai anga akisutheng dingpa chu longlhena abolpeh ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichehi koi hileh phah hise veija, akhutna akisuhtheng nadinga kimujou louho chunga kimang ding dan chu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Pakaiyin Mosi le Aaron henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="34" style="v" />Keiman nalodiuva kapeh-u Canaan gam nahung lutnuva, chule keiman nalonao gamsunga chu insung khatna phah hise kachuhsah tengleh;
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuche inneipa chu thempupa henga hunga, Insunga hin hise khat um bangin kahe-e, tia aseiding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chutengle thempupa chun chuche insunga umjouse chu abona aboh ahilouna dinga, ama hise phochen dinga insunga asunglhah masanga, a-in chu amahon asuh-ong nadiuva thupeh apehding ahi. Chujou tengle thempupa chu insung vedinga sunglha ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule aman hise avetna, chule veuvin, hise chu in-bang dunga auma, engdang ahilouleh sandang banga akilah-a, bang sanga athuhlut joh-a ahile,
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuteng thempupa chu insunga kona kotphunga hungdoh-a, a-in chu nisagi akhatup ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule thempupa chu nisagi nile hungkitna, avetding, chule hise chu chuche inbang ho-a ana challa ahile;
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuteng thempupa chun hise umna in'a song ho chu alahdoh diuva athupeh ding, chule amahon song ho chu khopi pam muntheng lou khatna aselut dingu;
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule aman a-insung kimvel chu ahet theng sah ding, chule amahon ahet lhah-u vutvai chu khopi pam muntheng lou mun khatna agasun lhah dingu ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule amahon song chombeh alah uva, chuche songho umna-a chu akoikhel dingu, chule aman leingan dang alah-a, in chu aloithah ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule ijemtia aman songho alahdoh-a, a-in chu ahet ngima, chule aloithah kit jouva, hise chu ahungkitna chuche insunga chu ahung sokitna ahile;
  </para>
  <para style="p">
    <verse number="44" style="v" />Chutengle thempupa chu hunga avetding, chule hise chu insunga kithe jalsoh-a ahile; insunga chu tijat umtah hise chua ahitan; chule hichu athenglou ahitai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule aman a-in, asongho, athing ho, chule aloina jouse asuhsetna, chule khopi polam muntheng lou laija apohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chujongle chuche in khachah-a aum laisungse-a chu koitobang agalutna aumle, amachu nilhah tokah-a atheng louva umding ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule chuche insunga galum kha-a chun aponho akisopma, chule chuche insunga gane kha-a chun aponho akisop ding ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule a-in kiloithah jouva chu thempupa ahung lutna, ahungvetna, chuleh a-insunga hise chu kithejal soh louva ahile; thempupa chun in chu atheng ahi tia aphonding ahi: ajehchu hise chu dama ahitai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule aman in suhtheng nadinga vacha ni, Cedar thing le Ponsanthip, chuleh Hyssop alah ding,
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule vacha teni lah-a khat chu leibel sunga twilong chunga athading,
  </para>
  <para style="p">
    <verse number="51" style="v" />Chule aman cedar thing, hyssop, ponsanthip, chule vahing chu alah-a, vacha kithat thisan sungle twi longa adelut ding, chule in chu sagi vei athekhum ding;
  </para>
  <para style="p">
    <verse number="52" style="v" />Chule aman vacha thisana, twilonga, Cedar thinga, hyssopma, chule ponsanthipma in chu asuhtheng ding ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ahin aman vacha hing vangchu khopi pampeh gam onga agalha doh ding; chule chuche insung dinga chu longlhena abolding; chule hichu atheng hiding ahitai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hiche hi phah hise jouse le tithah jouse,
  </para>
  <para style="p">
    <verse number="55" style="v" />Chule vonphah, inphah,
  </para>
  <para style="p">
    <verse number="56" style="v" />Apomdoh, akhihdoh, chule avamdoh-a dinga dan chu ahin,
  </para>
  <para style="p">
    <verse number="57" style="v" />Athenlou pet le athen pet kihetna dinga kihilna chu ahi: hiche hi phah chung changa dan chu ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi le Aaron henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga thu seilhonin lang, ajah uva hitin seilhonin, Pasal khattou atahsa-a kona longdoh thi neija ahile, hiche athi lonjeh-a chu amachu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche hi athilong doh-a kona abohna hiding ahi: athi longdoh atahsa-a kona ahung londoh jenga, ahiloule atahsa-a kona alondohsah da-a ahijongle, amachu athenglou ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thilongdoh neipa galupna jalkhun tapou chu aboh ahin, chule ama toupha thil jouse jongchu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule thilongdohpa lupna tongkha tapou chun aponho asop ding, amatah twija kisil ding, chule nilhah kah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule thilongdoh pa toupha thil tapou chunga gatouva chun aponho asop ding, amatah twija kisil ding, chule nilhah kah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule thilongdoh neipa tahsa tongkha tapou chun aponho akisop ding, amatah twija kisil ding, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule thilongdohpa chun mi atheng khattou achil aset khum khah-a ahileh, amapan aponho asopding, amatah twija kisil, chule nilhah kah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule thilongdohpa touna tapou chu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule koi hile ama delpha thil tapou gatongkha chan chu nilhah kahse-a aboh hiding; chutobang thilho tapou pole-a chun aponho akisop ding, amatah twija kisil, chule nilhah kah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Koihileh thilongdohpa tongkha-a twija akhut teni soplou chun, aponho akisop ding, amatah twija kisil, chule nilhah kah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule thilongdoh pan atohkhah leija kisem umle bel tapou chu suhkeh ding, chule thinga kisem umle bel tapou chu twija silding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule thilong neipa chu athilon na-a kona suhthenga aumteng, aman akisuhtheng nading nisagi akisimdoh ding, aponho asopma, chule atahsa chu twilonga asil ding, chule atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aniget chan nileh aman vapal nou ni ahiloule vakhu ni akilah-a Pakai anga houkhom ho Houbuh kotphunga hunga chule hichu thempu apeh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule thempu chun khat chu chonset thilto-a, chule adangkhat chu govam thilto-a atoding; chule thempupa chun Pakai anga athilondoh jeh-a chu ama dinga longlhena abolpeh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule pasal khattou abotwi achedoh tah-a ahile, aman atahsa twija asilding, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule chuche abotwi chuhna pon le savunho jouse chu twija sopding, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujongle numei chu pasal to alupkhoma, amapa botwi chu apotdoh-a ahile, anilhona twija kisilding, chule nilhah kahse-a aboh hilhon ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule numei jin ama-a kona thil longdoh aneija, chule atahsa-a kona longdoh chu thisan ahia ahile; amanu chu ni sagi chom koidoh ding ahi: chule koi hileh amanu tongkha-a chu nilhah kahse-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amanun aga chom um sunga agalup pha chule aga toupha thil tapou ho chu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koi hileh amanu jalkhun gatongkha tapou chun aponho asopding, amatah twija kisil ding, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Koihileh amanun atoupha thil tapou gatongkha chun, aponho asopding, amatah twija kisil ding, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amanu jalkhun chunga um hihen, atoupha thil khattou hileh, amapan agatoh khah leh, amapa chu nilhah kahse-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule pasal'in amanu aluppi jengtah-a, amanu thi chu amapa chunga abeleh, amapa chu ni sagi aboh hiding; chule alupna jalkhun jouse chu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule numei khatnin angaina banglouva nitamtah thi aneija, ahiloule achoma aumna phat valsetna thi aneija ahile; athilon na-a athenlouna nikhosung sese chu amanu achoma aumna nikho hiding ahi; amanu chu aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thilonga aumsung se-a alupna jalkhun tapou chu amanu dinga chom koidoh-a aumna jalkhun tobang ding ahi. Chuleh amanun atoupha thil tapou chu, achoma aum sunga aboh banga aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule koihile chuche thilho tongkha-a chu aboh hiding ahin, aponho akisopma, amatah jong twija kisila, chule nilhah tokah-a aboh hiding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla athilonna-a kona chu athen tah-a ahile, amanun ama-a dinga nisagi akisimdoh ding, chujouteng amanu atheng hiding ahitai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule aniget chanileh amanun vapal ni ahilouleh vapal nou ni akilah-a, houkhom ho houbuh kotkhah phunga thempupa henga ahin choiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuteng thempupa chun khat chu chonset thilto-a, chule khat chu govam thilto-a ato ding, amanu thenlouna thilongdoh jeh-a chu amanu-a dinga Pakai angsunga longlhena abolpeh ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutia chu amahon alah uva um houkhom ho houbuh chu asuhboh tenguleh, athenlou naova athilouna dinguva, nanghon Israel chate chu thenlouna-a kona nakhendoh dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichehi ama-a kona thilondoh jeh le, abotwi chedoh jeh-a thenglouho,
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule athilon jeh-a dammo-a numei, chuleh athi longa pasal le numei, chule thinei numei lupia pasal ho-a dinga danthu chu ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aaron chapaten Pakai angsunga thilto aneipet lhona athilhon jouvin, Pakaiyin Mosi henga aseijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />nasopi Aaron henga, athilouna dingin thingkhong chunga hepi touna masanga ponjal sunga um muntheng sunga aphat jouse-a ahunglut louna dingin seipeh-in; ajehchu hepi touna chunga chu keima meiloma kahung kilah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aaron chu muntheng sunga hitia hi hunglut ding ahi: chonset thilto dinga bongchalnou khat, govam thilto dinga kelngoichal khat.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman tupat sangkhol theng chu aki-ah-a, atahsa chunga chu tupat pon chu akichen ding, tupat konggah akigah-a, chule tupat lukhuh chu akikhuh ding ahi: hichehohi vontheng ahin, hijeh-a chu aman atahsa twija akisila, chuleh akivon ding bou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Israel chate houkhom ho-a kona chu chonset thilto-a dinga kelnou ni leh govam thilto-a dinga kelngoichal khat alahding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Aaron'in ama chonset thilto bongchal chu ama dinga atoa, ama-a dingle a-insung dinga longlhena abolding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuteng aman kelcha ni chu alah-a, houkhom ho Houbuh kotkhah phunga Pakai angsunga apehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Aaron'in kelcha ni chunga chu, khatchu Pakaiya dinga, chule adangkhat chu keldai dinga vangvetna aneiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Aaron'in Pakaiya dinga vang chuhna kelcha chu ahinkaija, chonset thilto-a atoding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla keldai dinga achunga vang chuhna kelcha chu, longlhenna bolna-a mandinga ahinga Pakaiya apehlut ding, chule keldai dinga gamthipma agalhadoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Aaron'in ama chonset thilto-a ding bongchal chu ahin kaija, ama le a-insung dinga longlhenna abolding, chule ama chonset thilto-a ding bongchal chu athading:
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule aman Pakai angsung maichama kona chu mei-am lhengkhat dim leh akhut dimsetna gimnamtui dimset kisubong chu alah ding, chule pondal sunga achoilut ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuteng aman hiche gimnamtui khu chun hettohsahna thingkhong chunga um hepi touna chu akhu-a chutia chu ama athi louna dinga, Pakai angsunga gimnamtui chu meisunga akoilutding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman bongchal thisan chu alah-a, hichu akhutjunga hepi touna chung solam sanga atheding; chule hepi touna maija chu thisan chu akhut junga sagivei atheding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouteng aman chonset thilto kelcha chu mipi ho-a dinga atha-a, athisan chu ponbuh sunga ahin choilutna, bongchal thisan abol banga chu abolding, chule hepi touna chung le hepi touna maija chu atheding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman Israel chateho chu athenlou jeh-u le asuhkhel uva achonset jeh uva, munthenga dinga chu longlhenna abolpeh ding ahi: chule hitia chu athenlou nalah uva um houkhom ho houbuh-a dinga chu abolding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule ama muntheng sunga ama le a-insung ding, chule Israel houkhom ho jouse dinga longlhenna boldinga agalutna chule ahungdoh kahse-a, koimacha houkhom ho Houbuh sunga chu umlou ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Pakai angsunga um maicham mun'a chu che-a, hiche dinga chu longlhenna aga bolding; chule bongchal thisan le kelcha thisan chu phabep alah-a, maicham sakiho chunga chu akoi kimvel ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule aman hiche chunga chu akhutjunga thisan sagivei athea, asuhthenga, Israel chate athenlou naova kona asuhtheng ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule aman muntheng le houkhom ho Houbuh chule maicham chu kichamna aboljou tengleh, kelcha hing chu ahin kaiding:
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Aaron'in akhut teni chu kelcha lujanga angapma, achunga chu Israel chateho khangitlouna jouse, asuhkhel nao jouse leh achonsetnao jouse aphondoh-a, kelcha lujanga akoija, chule mihem aboldinga kilom khat khutna gamthipma aga lhadohsah ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kelcha chun amaho khangitlouna jouse chu achunga apoh-a, koima chen louna gama apohlut ding; chule mipa chun kelcha chu gamthipma agalha ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouteng Aaron chu houkhom ho houbuh sunga hunga, munthenga agalut petna avonho, tupat vonho chu asuhlhah-a, chua chu adalhah ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule aman munthenga um twija atahsa akisila, avonho akivona, chule hungdoh-a govam thilto, mipi ho govam thilto chu atoding, chule ama-a ding le mipi ho-a dinga longlhenna abolding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule chonset thilto thao chu maicham chunga agoding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keldai dinga kelcha galhadohpa chun aponho akisop ding, chule atahsa twija asila, chujouteng gebuh sunga hunglut ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule thisan munthenga longlhen bolna-a kipolut chonset thilto-a ding bongchal le chonset thilto-a ding kelcha chu khatnin gebuh pama apohdoh ding; chule amahon avunho, apheho le a-eh ho chu meija agodiu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hitiho meija gagoupa chun aponho asopding, ama chu twija atahsa akisil ding, chujouteng leh gebuh sunga hunglut ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule hichehi nangho dinga a-itih-a chondan hiding ahi: lhasagi chana nisom lhin nikhole nanghon nahinnao nakisuh gim dingu, nagamsung miu hihen lang, gamdangmi nalah uva khopen hijongle natoh kiti him him natohlou dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ijeh inem itileh Pakai angsunga nachonset nahou jouse-a kona nathen theina dinguva, chuche nikho teng chuleh nangho suhthengna dinga thempun nangho dinga longlhenna nabolpeh dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiche nikho chu nangho dinga choldona dinga cholngah ni hiding, chule a-itih-a chondan hidinga nahinnao nasuh gim dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule aman apa khela thempu tohmuna natong dinga thao anua, akatdoh thempupa chun longlhenna chu abolding, chule tupat ponho le vontheng ho jeng jong chu akivon ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule aman munthenga dinga longlhenna abolding, maicham leh houkhom ho houbuh-a dinga longlhenna abolding, chule thempuho leh houkhom mipi ho-a dinga longlhenna abolding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hichehi Israel chatea dinga kumkhatna khatvei achonset nahou jouse jeh-a longlhenna bolna dinga, nangho-a kipe a-itih-a chondan hiding chu ahi. Chuin aman Pakaiyin Mosi athupeh bangin aboltan ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aaron, achapate, chule Israel chate jouse henga hitin seijin; Hichehi Pakaiyin athupeh hochu ahi,
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel insung mi koihileh gebuh sung ahiloule gebuh pama bongchal ham, kelngoi ham, ahilouleh kelcha ham thatna auma,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai Houbuh masanga Pakai henga thilto-a to dinga houkhom ho houbuh kotphunga ahinchoi louva ahileh; thisan kiso mona chu aman akipoh ding ahi; aman thisan aso ahin; hiche mipa chu amite lah-a kona paidoh-a umding:
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichu Israel chaten gam onga ganlhainaho abol hou chu ahin choijuva, Pakai henga, houkhom ho houbuh kotphung, thempupa henga ahin choijuva, Pakai henga chamna thilto-a dinga ato theina dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule thempu chun thisan chu houkhom ho houbuh kot phunga Pakai maicham chunga athea, chule athao chu Pakai henga gimnamtui hidinga ahalding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amahon anajonpiu thilhaho henga chu ganlhaina abolkit loudiu ahitai. Hichehi amaho dinga akhang akhanga a-itih-a chondanu hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangham amaho henga chu, Israel insungmi hihen ahiloule gamdang mi nangho lah-a hung khopem hijongle, koitobang govam thilto ganlhaina toh-a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai henga todoh dinga houkhom ho houbuh kotphunga hinchoilou auma ahile; hiche mipa ngei chu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule koitobang Israel insung mi hihen,ahilouleh gamdang mi nangho lah-a khopem hijongle thisan ne aumleh; thisan ne mi chu keiman kamaingat ding, chule amite lah-a kona kapaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ijehnem itile tahsa hinna hi thisana um ahin: chule hichu nahinna uva dinga longlhen bolna dinga maicham chunga nangho kapeh nahiuve: ijeh inem itile hinna-a dinga longlhen bola chu thisan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu, Nangho koimachan thisan nanehlou dingu, chule nalah uva khopem gamdangmi koimachan jong thisan anehlou ding ahi, tia Israel chate henga kasei ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Israel chate lah-a kon hihen, ahiloule nalah uva khopem gamdangmi koihile gam galenga nehthei sa ahilouleh vacha gamana chun: athisan chu avatlhah sah-a, leivui avuhkhum ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu hichu tahsa jouse hinna ahi; athisan chu ahinna ahi. Hijeh-a chu, Nanghon tahsa jouse hinna hi athisanu ahijeh-a, itobang tahsa thisan hileh naneh louhel dingu ahi: koihileh anea aumle amachu paidoh hiding ahi, tia Israelte henga keiman kasei ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nagam miteo hihen, ahilouleh gamdangmi hijongle, koitobang athikam ahilouleh gamsan athasa ne-a chun, aponho asopding, ama chu twija kisil ding, chule nilhah tokah-a athenglou hiding: chujou tengleh atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla aman aponho soplouva, atahsa akisil louva ahileh; akhangit louna akipoh ding ahi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga thu seijin lang, ajah uva hitin seijin, Keima Pakai na Pathen'u kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nana chenao Egypt gam chonna banga nangho nachon loudiu, chule keiman nangho kahin lhutna Canaan gam chonna banga jong nachon louhel dingu: chule amaho chona dan jong najuilou dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangho kathulhah ho-a nachon uva, chule hicheho-a chu nalam lhah theina dinguva kachona danho nanit dingu ahi; Keima Pakai na Pathen nu kahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh-a chu nanghon ka chondan kisun hole keima thutanna ho nanitdiu: hichu mikhatnin anitleh ama hicheho-a chu hing ding ahi; keima Pakai kahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangho koimachan akinaipi a-insungmi sagohkeo hodohpeh dinga najot lou dingu ahi: Keima Pakai kahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman napa sagohkeo hina ahilouleh nanu sagohkeo hina chu naho dohpeh louding ahi: amanu nanu ahin, amanu sagohkeo hina chu nangman naho dohpeh louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman napa jinu sagohkeo hina naho dohpeh louding ahi: Hichu napa sagohkeo hina ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman nasopi, napa chanu hihen, nanu chanu hijongle, in'a peng hihen mun danga peng hijongleh, asagohkeo hina chu naho dohpeh louding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangman nachapa chanu hihen, nachanu chanu hijongle, asagohkeo hina chu naho dohpeh louding ahi. Ajehchu amaho sagohkeo hina chu nangma sagohkeo hina ahibouve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Napa jinu chanu, napan ahinchu nasopinu ahi, nangman amanu sagohkeo hina naho dohpeh louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman napa sopinu sagohkeo hina chu naho dohpeh louding ahi. Amanu chu napa kinaipi asopinu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangman nanu sopinu sagohkeo hina naho dohpeh louding ahi. Ajehchu amanu chu nanu kinaipi asopinu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman napa sopipa sagohkeo hina naho dohpeh louding, nangman ama jinu jong nagajot lutlou ding ahi: amanu chu nanungah ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman namounu sagohkeo hina naho dohpeh louding ahi: amanu chu nachapa jinu ahin; nangman amanu sagohkeo hina naho dohpeh louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangman nasopipa jinu sagohkeo hina naho dohpeh louding ahi: nasopipa sagohkeo hina ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman numei khatleh achanu sagohkeo hina naho dohpeh louding, chule achapa chanu ahilouleh achanu chanu jeng jong asagohkeo hinao hodohpeh dinga nakipui louding ahi: ajehchu amanu kiguijoppi numei ho ahiuve: hichehi gitlouna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangman numei khatchu asopinu hinlai sungse-a, amanu suhgentheina ding le ama sagohkeo hina hodoh peh dinga asopinu chu nakipuithei louhel ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujoule athenlou jeh-a chomkoija aumlai sungse-a, nangman amanu sagohkeo hina hodoh peh dinga najot louhel ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chukalvala jong nangman nakisuhboh na dinga naheng nakom inneipi chu aluppi louding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangman nachilhah lah-a khatcha jong Molech houna dinga meija govam dinga naphal doh louhel ding, na Pathen min jong nasuh minset louding ahi: keima Pakai kahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangman numei toh nalupkhom banga pasal toh nalupkhom louding ahi: hiche chu thet umtah ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nangma nakisuhboh nadinga ganhing kiti tapou toh nalupkhom louding ahi. Numei tapou jongchu ganhing khat anga aluppi dinga gaum lou ding ahi: hichehi jon chungnung ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche thil ho kiti tapouva hin nangho kisuboh hih-un: ajehchu nangho masanga kana paidoh namho chu hicheho jouse-a hi kisuboh ahiuvin:
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule gam chu suhboh-in aumtan: hijeh-a chu keiman akhangitlou naochu talen kamat sah-a, gamsung amatah-in achengho chu ahin lohdoh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijeh-a chu nanghon keima chondanho le kathu tan naho nanit tei dingu, chule nanam mite ahiuva, gamdang mi nalah uva khopemho ahiuva jong, hiche kidah umho hi khatcha jong nabol lou dingu ahi:
  </para>
  <para style="p">
    <verse number="27" style="v" />(Ijeh inem itile nangho masanga agama um miho chun hiche kidah umhohi ana bolu ahin, chule gamsunghi suhboh-a anaum ahi;)
  </para>
  <para style="p">
    <verse number="28" style="v" />Agam min nangho masanga anaumho analodoh banga, nanghon jong nasuhboh tengule nalohdoh louna diuvin.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ajehchu koihile hiche kidah umho lah-a khat bolla chu, hiche tobang bola mihem chu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh-a chu namasanguva ana kibol hitobang thet umtah chonnaho hi nabol louna dingule, hitiho-a hi suhboh-a naum louna dinguva, ka thupeh hohi nanit dingu ahi: keima Pakai na Pathen'u kahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pakaiyin Mosi henga aseije, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate houkhom ho jouse henga hitihin seijin, Nangho nathen dingu ahi: ajehchu keima Pakai na Pathen'u hi atheng kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho amitakipmin nanu le napa naginuva, chule kacholngah nikho ho nanit dingu ahi, keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Milimho lama kihei hih-un lang, alim semthu pathen ho jong kisem hih-un: keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon Pakai henga chamna thilto longlhenna nato uva ahile, nanghon hichu nalungcham tah uva nato dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichu natodoh nikhou le ajing nikho-a nanehjou tei dingu ahi: ijemtia ani thum ni geija um nalaija ahile, hichu meija goding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hichu anithum ni-a akineh poupouva ahile, kidah umtah ahin; hichu kisang louding ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu ane jouse chun Pakai thiltheng asuh minset jeh uva, akhangit lounao akipoh cheh dingu: chule hiche mihem chu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman nagam ga na-at teng le, nangman nalou ningho jouse chu na-at sohkei louding, chule na-at na-a alhajah ho chu nakichom ngim louding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangman nalengpi thei gaho nachom ngimsel louding, nalengpi thei gaho jong aboncha nalotheng louding; hitiho chu vaichate le gamdang mi dinga nakhenpeh ding ahi: keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangma naguchat louding, dihlou tah-a jong nabol louding, chule khat le khat kah-a jong jou nasei louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangma kamin panna jouva nakihahsel louding, na-Pathen minjong nasuh minset louding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangman naheng nakom najoulhep louding, chomjong nachom louding ahi. Akigoipa lo chu jan khovah-a jingkah geija nakoma naumsah louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman na-ngong nagaosap louding, mitcho masanga jong kipal lhuh theina nakoi louding ahi, na-Pathen joh nagin ding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nathu tan na-a chonphat louna nabol louding ahi: nangman mivaichate chu nakhohsah chom louding, ahiloule mithaneite jong najabol chom louding: amavang chonphatah-a naheng nakom thu natan ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangma namite lah-a thuse seija nachesuh nachetouna louding: chule naheng nakom thisan thua jong jouthu-a napan louding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman nalungsunga nasopipa nahotbol louding: iti nama jongle nangman naheng nakom naphosal louding, chule chonset nabolsah louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangman phu nalah louding, namite chateho chunga thangthipna jong nanei louding ahi, amavang nangman naheng nakom chu nangma naki ngailut banga nangailut ding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanghon kachondan ho nanit diu ahi. Nanghon nagancha hou chu gancha dangto nakimatsah lou dingu ahi: nanghon nalou uva muchi natu hal lou dingu ahi. Chule tupat le samul kihal von jong nachunga nakaisah louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule soh numei, pasal khat dinga khao khisa, lhadoh loulai le chamlhatna peh loulai khat chu tahsa ngaichatna jeh-a khattouvin aluppia ahile, amanu chu kijepding ahi: amanu chamlhat ahiloujeh-a anilhona vang kithat louding ahi
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amapa chun asuhkhelna thilto chu Pakai henga houkhom ho houbuh kotkhah bula chu ahinchoi ding, suhkhkelna thilto dinga kelngoi chal khat ahinkai ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuteng thempupa chun amapan anabol chonsetna jeh-a chu, amapa dinga suhkhel thilto kelngoi chal chu Pakai anga atodoh-a, amapa dinga longlhenna abolpeh ding ahi: chutengle amapan anabol chonsetna chu kingaidam ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nangho chuche gama nalut uva, chule nanghon nehdinga thing namkim naphu tengule, aga chu cheptan louva nasim dingu: hichu nangho dinga kum thum cheptan lou hiding; hichu nanehlou dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla akum li na-a vang chuche gaho jouse chu, Pakai vahchoina dinga atheng hiding ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule akum nga na vang, nangho-a dinga aga asodoh thei nadinga aga naneh dingu ahi: keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nanghon imacha athisan puma nanehtha lou dingu: chule mitpheldoi le ailhim namanchah lou dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nanghon nasamu nahet tol kimvel lou dingu, chule nabeng mul hou jong aning navoset lou dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nanghon mithiho jeh-a natahsao na-at pop lou dingu, chule nati chunguva jong imacha lim nasemlou dingu ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangman jonthanhoi sahna dinga nachanu noti'a napansah louding ahi; achuti loule gamsung hi jonthanhoina-a hunglhun tin, gamsunghi gitlouna-a dim ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nanghon kacholngah ho nanit diu; chule kamun theng naja dingu ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nanghon amaho-a kona nakisuhboh louna dingun lhakou mangchaho ngaisang hih-un, chule doithemho jong hol hih-un: keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangma lukangho masanga nadin doh ding, tehse mai najading, chule na Pathen nagin ding ahi: keima Pakai kahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule namdang khat nagam sunga nangho toh akhopem khoma ahile, ama chu dihlou tah-a nabol lou dingu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Amavang gamdang mi nangho toh chengkhoma chu nangho-a dinga nalah uva peng tobang hiding, nangho naki ngailut banguva nangailut dingu ahi: ajehchu nangho jong Egypt gama gamdang mi nana hiu ahi: keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nanghon thutanna lam, asaotena ahin, agih tena ahin, ahiloule asan tena hijongle chonphat louna nabol lou dingu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Khaikot dih, gihtum dih, Ephah dih, chule hin dih nanei diu ahi: keima Egypt gama kona nahin puidoh uva Pakai na Pathen'u kahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hijeh-a chu nanghon kachondan ho le kathutan jouse najuidiu, chule naboldiu ahi: keima Pakai chu kahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chateho henga hitihin seikitnin, Israel chate lah-a kona ahin, Israel gama khopem gamdang mi lah-a kon hijongle, koitobang Molech henga acha pe-a chu; ama chu thatei teiding ahi: agam mite chun ama chu songa asediu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keiman amapa douna-a kamaingat ding, chule amite lah-a kona kapaidoh ding ahi; ajeh chu aman keima muntheng suhbohna ding le keima mintheng suhminset nadingin acha Molech henga apen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule itiham khatna agam mite chun amapan acha Molech henga apeh chu akimumo sah uva, chule amapa chu atha lou uva ahileh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuteng chule keiman amapa le a-insung mite douna-a kamaingat ding, chule Molech to jonthanhoi dinga amatoh jong jouse chu amite lah-a kona kapaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule koi hile amaho to jong dinga lhakou ho le doithemho lama kihei tapou chu, amapa douna-a kamaingat ding, chule amite lah-a kona kapaidoh ding ahi
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun nangho kisuthengun lang atheng hiuvin: ajeh chu keima Pakai na-Pathen'u kahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nanghon keima chondan ho nanit uva, natohdoh dingu ahi: ajehchu keima nangho suthengpa Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koi hile apa ahiloule anu gaosapma chu thonlouva thatei ding ahi: aman apa ahiloule anu agaosap ahin; athisan chu ama chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule pasal khat pasal dang ji to jonga, aheng akompa jinu to jonga chu, ajongpa le ajongnu anilhona thatei ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule pasal khat apa jinu to lumkhoma, apa sagohkeo hina hodohpeh-a chu, amani chu anilhona thatei ding ahi; amani thisan chu amani chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule pasal khat amounu to alupkhoma ahile, amani chu anilhona thatei ding ahi; amanin kidah umtah aboldoh lhon ahitai; amani thisan chu amani chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pasal khat apasal chanpi khattoh numei to lupkhom banga alup khoma ahile, amani chun kidah umtah abol lhon ahitan; amani chu thatei ding ahi: amani thisan amani chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule pasal khatnin ajinu le ajinu nu ji-a anei kopma ahile, hichu gitlouna ahi: nalah uva gitlouna aumlouna dinga amapa le amani chu meija hala umdingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule pasal khat gancha khattoh alupkhoma ahile, amapa chu thatei ding: chule nanghon agancha jong chu atha dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule numei khatnin gancha khat ajotlutna, chuche tochun alupkhoma ahile, nangman numeinu le gancha chu nathatei ding ahi: amani chu thitei ding ahilhone; amani thisan chu amani chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule pasal khatnin asopinu, apa chanu hihen anu chanu hile akichenpi-a, aman amanu sagohkeo amua, amanun amapa sagohkeo amua ahile; hichu gilouna ahi; amani chu amiteu mitmu-a paidoh-a umlhon ding ahi: amapan asopinu sagohkeo hina chu ahodoh peh ahitan; amapan akhangit louna chu akipoh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule pasal khatnin numei anatna neipet khat alupia, amanu sagoh hina ahodoh peh-a ahile; amapan amanu twinah ahodoh peh ahin, amanun athisan twinah chu ahodoh ahitai: chule amani chu anilhona amiteu lah-a kona paidoh-a umlhon ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangman nanu sopinu ahin, napa sopinu hile asagokeo hina naho dohpeh louding ahi: ajeh chu amapan akinaipi a-insungmi ahodoh ahi: amanin achonset nalhon akipoh lhonding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule pasal khatnin apa-ngahpa jinu alupkhom pia ahile, aman apa-ngahpa sagohkeo hina chu ahodohpeh ahitan: amanin achonset nalhon akipoh lhonding, chabeija thilhon ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule pasal khatnin asopipa jinu akipuija ahile, hichu thilthenglou ahin: aman asopipa sagohkeo hina ahodohpeh ahi; amani chabeija umlhon ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeh-a chu keiman nangho kahin puilut nadingu gam chun nangho nalohdoh louna dingun; nanghon kachondan ho le kathutana ho nitnun lang chule bolun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule nangho masanga keiman kakaidoh nam chondan bangin chonhih-un: ajeh chu amahon hitiho jouse hi anabolun, hijeh-a chu keiman amaho chu kahot ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla keiman nangho henga, Nanghon amaho gam chu nalo diu, chule hiche bongnoi le khoiju lona gam chu nalo diuva kapeh ding nahiuve, kati ahi. Keima nangho namdang ho-a kona khendoh-a Pakai Pathen chu kahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh-a chu nanghon satheng le saboh, vacha boh le atheng nakhen dingu ahi: chule sa hile vacha hile chule tolla kitholtho ho hijongle keiman nangho-a kona athenglou ahi tia kakhendoh ho-a kona chu nahinnao thet umtah nasolou dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule nangho keima dinga atheng nahi dingu ahi: ijeh-inem itile Pakai keima hi atheng kahin, chule keima-a tum hidinga nanghohi midang ho-a kona kakhen doh nahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pasal hihen numei hile, lhakou ahiloule doithem hia chu thonlouva thading ahi: amahon amaho chu songa asediu ahi: amaho thisan chu amaho chung mama-a chuding ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga, Aaron chapate thempuho henga hitihin seijin, Koimacha amite lah-a mithiho jeh-a kisuboh louding ahi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahin a-insungmi amato kinai, anu-a ding, apa-a ding, achapa-a ding, achanu-a ding, chule asopipa-a ding,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule asopinu nungah theng, ama to kinaija um, jinei loulaija ding; hichenga dinga vanghi kisuboh thei ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla amite lah-a aluchangpen ahi jeh-in, athenlou nadinga ama le ama kisuboh louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon aluchangu avotol loudingu, abengmulu mongjong avoset lou dingu, chule atahsao jong a-atpop loudiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho chu a-Pathen'uva ding atheng hidiu, chule a-Pathen'u min jong asuhboh loudiu ahi. Ajeh amahon meija kisem Pakai henga thilto le a-Pathen'u changlhah chu atojiu ahi: hijeh-a chu amaho atheng hidingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon ji dinga noti ahiloule athenglou chu akipui loudiu; chule ajipan adasa numei jong akipui lou dingu ahi: ajehchu amapa chu a-Pathen'a dinga atheng hija ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangman hijeh-a chu amachu nasuhtheng ding ahi; ajehchu aman nangma Pathen changlhah chu atodoh ahi: amapa chu nangma dinga atheng hiding ahi: ijeh inem itile nangma suthenga Pakai keima atheng kahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule thempu khat penpen chanu chu noti'a apana amale ama akisuhboh-a ahile, apa asuhboh ahin: amanu chu meija halding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule asopite lah-a thempu chungnunga pang, alua thao kinu, thempu vonho von dinga kisuthenga chun, alu ahodoh louding, aponho jong abokeh louding;
  </para>
  <para style="p">
    <verse number="11" style="v" />Thilong kiti tapou anailut louding, apa-a ding le anu-a dinga jong kisuboh louding;
  </para>
  <para style="p">
    <verse number="12" style="v" />Munthenga kona jong potdoh louding, a-Pathen muntheng jong asuhboh louding ahi; ijeh inem itile a-Pathen thao kinu lallukhuh chu achunga um ahi: Keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman ajinu chu nungah theng ahi petna akipui ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meithai, akidasa numei, akisubohsa, ahiloule noti, hicheho hi akipui louding ahi; amavang amite lah-a kona nungah theng khat akipui ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amite lah-a jong achilhah asuhboh louding ahi; ajehchu Pakai keiman ama kasuhtheng ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="17" style="v" />Aaron henga hitin seijin, Nakhang sunguva nachilhah hou lah-a nolna nei poupou chun, a-Pathen changlhah toh dingin galut dahen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Koi hile nolna neichan chu lut louding ahi: amitcho, a-elbai, anahkui soi, ahiloule atichunga aval nei,
  </para>
  <para style="p">
    <verse number="19" style="v" />Pasal akengbong, ahilouleh akhutbong,
  </para>
  <para style="p">
    <verse number="20" style="v" />Atingbong, mineo, ahiloule amitna nolna um, tipat, tibol, ahiloule atilchangkeh hijongle;
  </para>
  <para style="p">
    <verse number="21" style="v" />Aaron chilhah ho nolna nei koimachan Pakai henga dinga meija kisem thilto toh dinga hungnailut lou dingu ahi: aman achunga nolna anei ahi: a-Pathen changlhah tohdinga hungnailut lou ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman a-Pathen changlhah athengpen le atheng chu ania anehthei ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman nolna khat aneijeh-a chu keima muntheng aman asuhboh louna dinga, ama pondal sunga chu lutlou ding, maicham naija jong hunglut lou ding ahi: ajehchu Pakai keiman amaho kasuhtheng ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Mosi'n hichehi Aaron le achapate chule Israel chate jouse henga aseipeh tan ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aaron le achapate henga chun amaho Israel chate thil thengho-a kona akikang seova, chule keima henga amahon athensosao hiche thilho-a chu keima mintheng asuhboh louna dingun seipeh-in: Keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho henga hitihin seijin, Koi hijongle nakhanggui jouseuva nachilhah jouse lah-a kon achunga thenlouna aumpetna Israel chaten Pakai henga akatdoh-u thilthengho henga galutna chu, amachu keima angsunga kona kipaidoh ding ahi: Keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aaron chilhahte lah-a kon koitobang miphah hihen lang, ahiloule thilong hijongle, akisuhtheng kahse-a thil thengho lah-a kona imacha aneh louding ahi. Chule koi hile thilonga kona kisuboh thilkhat tongkha-a, ahiloule ama-a kona abotwi chedoh-a chu,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahiloule akisuhbohna thei ding akitholtho, ahiloule thenlouna akilahson nathei mi, itobang thenlouna nei hijongle;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutobang khattou tongkha tapou chu nilhah tokah-a thenglouva umding, chule aman atahsa twija asop masangse-a thil thengho lah-a kona imacha aneh louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nisa ahung lhumteng, ama theng ding ahitan, chujou tengle thiltheng lah-a kona chu anehding ahitai: ajehchu hichu ama an ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akisuhboh nadinga achama thia ham, san apelih ham chu aneh louding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh-a chu amahon kachondanho anit dingu ahi, achuti louva ahile hiche chonsetna chu apoh uva, hichu asuhboh uva ahile thi dingu ahi: keima Pakai amaho suthenga chu kahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gamdang mi kiti tapouvin thiltheng chu aneh louding ahi: thempute henga khopem hihen, soh thalah hijongle thiltheng chu aneh theilou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla thempu chun asuma mikhat achoh-a ahile, amapa chun hichu anehding, chule a-insunga penga jong chun: amahon ama anneh chu anehthei dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thempu chanu khattou gamdang mi toh akichena ahile, amanun thiltheng kitoh ho lah-a kona chu ima anehthei louding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla thempu chanu chu meithai ahiloule akida ahia, chabei ahia, chule anungah lai banga apa insunga umdinga ahung nungkih ahile, amanun apa anneh chu aneh teiding ahi: amavang gamdang min hichu aneh louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule pasal khattouvin hetlouva thiltheng lah-a kona ima aneh-a ahile, aman thiltheng chu thempu henga aledit kitding, hopnga-a hopkhat apehbe ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule amahon, Israel chateho thiltheng ho, Pakai anga ato houchu asuhboh lou dingu;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahiloule athiltheng houchu aneh tengule suhkhelna khangitlouna chu apohsah lou dingu ahi: ajehchu keiman amaho suthenga Pakai chu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="18" style="v" />Aaron heng le achapate heng, chule Israel chate jouse henga hitihin seijin, Israel insunga kona hihen, Israel lah-a um gamdang mi hijongle, koitobang akitepna khattouva dinga ganlhaina, ahiloule lungcham thilto-a dinga Pakai henga govam thilto tohding auma ahile,
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanghon nalungcham tah uva bongho, kelngoiho, ahiloule kelcha ho-a kona nolna beihel achal napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla nolna neitapou chu natolou dingu ahi: ajehchu hichu nangho-a dinga kisanpeh louding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Koi hijongle akitepna suhbulhit nading ham, ahiloule lungcham thilto dinga bong ham, ahiloule kelngoi hama Pakai henga chamna thilto ganlhaina toh chan chun, athilto chu sanpeh ahina dinga ahoi chamkim atoding ahi: achunga chu nolna imacha umlou ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mitcho, kengbong, atipat, tahsa-a apomdoh nei, tina-a kon anai long, ahiloule tipat tapou chu nanghon Pakai henga nato lou diu, chule Pakaiya dinga maicham chunga meija kisem thilto-a nato lou dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bongchal ahiloule kelngoinou atahsa tibah-a aval, ahiloule alhasam auma ahile, nangman hichu lungcham thilto-a nato thei ahi: ahinla kitepna-a dinga vang hichu kisang louding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangman gancha atilchang kisuhchip, kitatkeh, kisukeh, le ki-atkeh kiti tapou chu Pakai henga nato louding ahi; chule hitobang ho-a chu nagamsunga jong thilto imacha nabol lou dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gamdang mi khutna kona hicheho chu na-Pathen changlhah hidinga nato louding ahi: ajeh chu amaho-a bohna aumin, chule amaho-a nolna aumin ahi: hicheho chu nangho dinga kisanpeh louding ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="27" style="v" />Bongchal ham, kelngoi ham, ahiloule kelcha ham ahung so tengle amachu ni sagi api toh umkhom ding ahi: chule niget channi-a patna Pakai henga meija kisem thilto-a dinga kisang ding ahitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule bongpi hihen kelngoipi hile, anouho toh nikhat sunga nathalou diu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule nanghon Pakai henga thangvahna ganlhaina nato tengule, nalungcham tah uva nato dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anikho mama-a chu hiche chu nehjou keiding ahi: ajing geija dinga imacha khenlou ding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeh chun nanghon kathupeh ho nanit uva, chule hicheho chu nabol dingu ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule nanghon ka mintheng jong nasuhboh loudiu; amavang Israel chate lah-a keima suhthenga kaumding ahi: keima nangho suthenga Pakai chu kahin,
  </para>
  <para style="p">
    <verse number="33" style="v" />Egypt gama kona na-Pathen'u hidinga hinpui dohpa chu kahi: Keima Pakai chu kahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga thu seijin lang, ajah uva hitin seijin, Pakai kut ho thudola, nanghon kikhoppi theng ahi tia naphondoh dinghou chu, hichehohi keima kut ho chu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nigup sunga na kitong ding ahin: nisagi ni vang chu cholngah ni ahin, kikhoppi theng ahi; hiche nikho-a hi natoh imacha natoh lou dingu ahi: hiche hi nachen namun jouseuva Pakai cholngah ni ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche hohi aphat ahunglhun dungjuija nanghon naphon lediu Pakai Kut ho, kikhoppi thengho chu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lha masapen nisom le nili nilhah chu Pakai kalchuh Kut ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuche lha mama nisom le ninga ni chu Pakai dinga cholsolou changlhah Kut ahi. Nisagi cholsolou changlhah naneh diu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nimasa pen nile nanghon kikhoppi theng khat nanei diu, chule hiche sunga chu natoh imacha natohlou dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla nisagi sunga chu Pakai henga meija kisem thilto nato dingu ahi: nisagi ni chu kikhoppi theng ahin, nanghon hiche sunga chu natoh imacha natohlou dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel chate henga hitin seijin, Keiman nangho kapehnao gamsunga nahung lutnuva, chule aga na-at tengule, nanghon nachang-at doh-u aga masapen ho phalkhat chu thempu henga nahin choi dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman nangho dinga santhei ahina dinga aphal chu Pakai anga ajap ding: cholngahni jou ajing le thempu chun ajap ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nanghon aphal najap niu chule, Pakai henga govam thilto-a dinga kumkhat lhingset nolnabei kelngoi nou achal khat nahin kai dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuche-a dinga anneh thilto chu thao toh kihal changbong neljet ephah hopsom-a hopni, Pakai henga gimnamtui hidinga meija kisem thilto hiding: chule adonding thilto chu lengpitwi hin khat hoplia khat hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nanghon na-Pathen'u henga thilto nahinchoi nikhou mamachu ahunglhun masanga, changlhah hile, kanpoh hile, changvui hile naneh loudiu ahi. Hichehi nachen namun jouseova a-itih-a nakhang khanguva chondana naman diu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nanghon cholngah ni jou ajinga pat, jap thilto-a dinga changhal nahinchoi niuva pat nasim dingu; choldoni sagi nasuhlhing diu ahi:
  </para>
  <para style="p">
    <verse number="16" style="v" />Cholngah sagina jou ajinga pat nisom nga-a nasim uva; Pakai henga anneh thilto thah nato diu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nanghon nachen namun houva kona ephah hopsom-a hopni-a kisem japtho changlhah lumni nahin choidiu; hichu changbong neljetna kon hiding, chol toh kikantha ding; hichu Pakai henga dinga ga masaho ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nanghon changlhah chutoh kumkhat lhingbep nolnabei kelngoinou sagi, bongchalnou khat, chule kelngoichal ni natotha diu; hicheho chu Pakai henga govam thilto le a-anneh thiltoho, adon thilto ho, Pakai henga gimnamtui hidinga meija kisem thito ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouteng nanghon chonset thilto-a dinga kelchaho noukhat natodiu, chule chamna thilto-a dinga kumkhat lhingbep kelngoinou ni natodiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule thempupa chun hicheho chu gamasaho changlhah le kelngoinou ni chutoh Pakai henga jap thilto hiding ajapding: hichu Pakaiya dinga atheng thempupa kipe chu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nanghon chuche nikho mama chule, hichu nangho dinga kikhoppi theng ahi tia naphondoh diu: hiche sunga chu nanghon natoh imacha natoh lou dingu ahi. Hichehi nachen namun jouseuva nakhang khanguva a-itih-a dinga chondan hiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nanghon nagam gao na-at tengule, na-atpet nuva chu naloulai ninghou na-at ngimsel loudiu, na-at naova alhajah jong nachom khom loudiu ahi: hicheho chu vaichate le gamdang mi dinga nakhenpeh dingu ahi: keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="24" style="v" />Israel chate henga hitihin seijin, lhasagi channa nikho masapen nileh nanghon choldona nanitdiu, sumkon mut hetjingna kikhoppi theng naman dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiche sunga chu nanghon natoh imacha natohlou dingu; amavang nanghon Pakai henga meija kisem thilto nato dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche lhasagi channa nisom lhin ni chu longlhenna nikho hiding: hichu nangho dinga kikhoppi theng hiding; chule nanghon nahinnao nasuh gimuva, Pakai henga meija kisem thilto nato dingu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche ni-a chu nanghon natoh kiti natohlou diu ahi: ajehchu hichu longlhenna nikho ahin, Pakai na-Pathen'u anga nangho ding longlhenna kibol nikho ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ijeh inem itile koihile hiche nikho-a ngeija ahinna suhgim lou chu, amachu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule koihile hiche nikho ngeija natoh khattou tonga chu, amachu amite lah-a kona keiman kasuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nanghon itobang natoh hile natoh louhel dingu ahi: hichehi nachen namun jouseova nakhang khanguva a-itih-a ding chondan hiding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichehi nangho dinga cholngahna choldoni hiding, chule nanghon nahinnao nasuh gim dingu ahi: hiche lha niko ni nilhah-a pat ajing nilhah geija nangho cholngahni nanitdiu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="34" style="v" />Israel chate henga hitihin seipeh-in, hiche lhasagi channa nisom le ni ngani hi Pakai henga nisagi sung Houbuh Kut hiding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ani masapen nikho-a chu kikhoppi theng umding: hiche sunga chu natoh imacha natoh loudiu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nanghon nisagi sung Pakai henga meija kisem thilto nato diu: nigetni chu nangho dinga kikhoppi theng hiding; Pakai henga meija kisem thilto nato diu ahi; hichehi kipun khomna loupitah ahin; chule hiche sunga hi nangho koimachan na natoh loudiu ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hichehohi Pakaiya ding kut ho, Pakai henga meija kisem thilto, govam thilto, anneh thilto, ganlhaina, don thilto anikho dungjuijuva tona dinga kikhoppi theng ahi tia naphondoh dinghou:
  </para>
  <para style="p">
    <verse number="38" style="v" />Pakai cholngah niho, na thiltohou, na kitepnahou jouse, chule na lungcham thiltohou, Pakai henga napeh hou simlouva mandingho chu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chujongle lhasagi channa nisom le ninga ni, nanghon nagam gahou nakhop khom tengule, nanghon Pakaiya dinga kut nisagi naman diu ahi; animasa pen ni chu cholngahni hiding, chule nigetni jong chu cholngahni hiding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule nimasa pen nile nanghon thingpha gaho, lusu doho, thingdo aboh phaho boh, vachadung panga keh huisum ho nalah diu, chule Pakai anga nisagi nakipa thanop diu ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule hiche hi Pakai dinga kut tia kum khat sunga nisagi naman diu ahi. Hichehi nakhang khanguva dinga a-itih-a chondan kipe-a chu ahi: hichehi nanghon lhasagi channa sunga nanit jingdiu ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nangho nisagi lhambuh sunga nachendiu; Israel chate apeng jouse lhambuh-a cheng dingu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chutia chu nakhang khanguva nanghon Israel chate Egypt gama kona kahinpuidoh chun amaho lhambuh-a kana chensah-e ti nahet themna diu ahi: keima Pakai na Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Mosi'n Israel chate henga Pakai kut ho chu aphongdoh tan ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati;
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga meivah ho avah jomjing theina dingin, vahding monga kiheh Olive thao thengseh chu nahenga ahin choina diuvin thupeh neijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichu Aaron nin Pakai anga nilhah-a pat jingkah geija tanglouva hettohsahna pondal pamlam, houkhom ho houbuh sunga agoltoh ding ahi; hiche hi nakhang khanguva a-itih-a dinga nachondanu hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman Pakai angsunga meivah khom theng chunga meivah ho chu tanglouva agoltoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nangman changbong neljet nalah-a, hichea kona chu changlhah lum somleni nasemding, lumkhat khatna ephah hopsom-a hopni nalutsah cheh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hicheho chu Pakai angsung dokhang theng chunga nangman golkhatna gup cheh-a golnia nagol ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hetjingna changlhah, Pakai henga meija kisem thilto hidinga nangman agolni chunga chu bego thengsel nakoi ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Atonsot kitepna-a dinga Israel chate-a kona kila ahito lhona, cholngahni sehle aman hiche chu tanglouva Pakai anga phatecha agontup jing ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche chu Aaron le achapatea hiding, amahon hichu munthenga aneh diu ahi; ajeh chu a-itih-a chondan hijing dinga Pakaiya dinga meija kisem thilto chu ama dinga thengtah hija ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Israel numei khat chapa, apa chu Egypt mi ahin, ama chu Israel chate lah-a achedoh-in: hiche Israel numeinu chapa leh Israel mi khat gebuh sunga akidel lhonin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Israel numeinu chapa chun Pakai min chu ataitomin, agaosap tan ahi. Chuin amahon amapa chu Mosi henga ahin puijuvin: (anu min chu Shelomith, Debri chanu, Dan phunga kon ahi).
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon Pakai lunggel amaho henga vetsah-a aum theina din, amapa chu vetsuijin akoijuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="14" style="v" />Agaosap mipa chu gebuh pama puidoh-in; chule athusei jaho jouse chun alujang chunga chun akhutnu ngamuhen, chule houkhom ho jouse chun songin sepmuhen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Israel chate henga chu, Koi hile a-Pathen gaosap chan chun achonset akipoh ding ahi, tia naseipeh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Pakai min taitompa chu thonlouva thatei ding ahin, chule houkhom ho jousen amachu songa ase dingu ahi: gamdangmi jong chu agam sunga pengpa banga Pakai min ataitoma ahile thading ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule koi hile mithat tapou chu thonlouva thatei ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule koihile gancha thatna chun, gan chu gan'a aditding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule khattouvin aheng akom chunga nolna khat achuhsah-a ahile, aman abol tobang banga chu ama chunga kibol ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gubong chu gubonga, mit chu mitna, ha chu ha-a; aman mikhat chunga nolna asosah banga ama chunga jong kisosah kitding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule gancha thatna chun, adit ding; chule mihem thatna vang chu, ama thatei ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanghon gamdang mi-a ding ahin, nagam mihou khatna ding ahin, dan khatbou naneidiu ahi. Ajehchu keima Pakai na-Pathen'u chu kahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Mosi'n Israel chate henga, amahon agaosap pa chu gebuh pama ahinpuidoh uva, chule ama chu songa ase diuvin aseipehtai. Chule Israel chaten Pakaiyin Mosi athupeh bang chun abol taovin ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Sinai molsanga Mosi henga thu aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga thu seijin lang, ajah uva hitin seijin, Nangho keiman kapeh-u gam nahunglut tengule, agam pumpin Pakai henga cholngahni anitding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangman kumgup nalouva muchi natuding, chule kum gup nalengpilei nalhongim ding ahi, chule aga naki chopkhom ding,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla kum sagi lhinkum chu agam pumpi dinga cholngahna, Pakaiya dinga cholngah hiding ahi. Nangman nalouva muchi natulou ding, nalengpilei nalhongim louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangman nachang atna nunga changson chu na-at louding, nalengpigui malngim lou ga jong nalokhom louding ahi; ajehchu agam pumpi dinga cholngah kum ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule gam pumpi cholngah kum-a achama hung kehdohho chu nangho dinga anneh hiding; nangma-a ding, nasohnu-a ding, nasoh thalah-a ding, chule nangma toh khopem khom gamdangmi-a ding,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nagancha-a ding, chule nagamsunguva um saho-a dinga, chua kona hung gadoh jouse chu nangho anneh hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangman cholngah kum sagi nakisim ding, kum sagi sagivei; chule cholngah kumho kikah sungse chu nangma dinga kum somli le kumko hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuteng lhasagi channa nisom lhinni le nangman Jubilee sumkon namutging sah ding, longlhenna nikhoteng sumkon chu nagam pumpiu sunga namut ging sah ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nanghon kum somnga kum chu nathenso diu, chule gamsung pumpi sunga chengho jouse henga chamlhatna naphondoh dingu ahi. Hichu nangho dinga Jubilee hiding; mitinin ama ama neilegou akinungmu kitding, chule mitin a-insung mite henga kile kitding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kum somnga channa chu nangho dinga Jubilee hiding: nanghon natuloudiu, chua kona achama hung khangdoh jong na-at loudiu, chom ngimlou nalengpi leija kona lengpi ga hojong nalokhom louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu Jubilee ahin; nangho dinga atheng hiding ahi: nanghon gamsunga kona achama hung kehdoh hochu naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche Jubilee kum-a hi mitin ama ama neilegou nalepeh dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nangman naheng nakom henga thilkhat tou najoh-a, ahiloule naheng nakom khutna kona thilkhat tou nachoh-a ahile, nangho khatle khat naki suhgentheito lou dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jubilee jou kum jat dungjuija nangman naheng nakoma kona nachoh ding, chule aga kum jat dungjuija nangman ama henga ajoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akumho atam dungjuija nangman chuche man chu nakalsah ding, chule akum alhom dungjuija chuche man chu nasuhlhom ding; ajehchu aga na kumho dungjuija aman nangma henga ajoh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh-a chu nangho khat le khat nakisuh gentheito loudiu; amavang Pathen nagin joh dingu ahi: ajehchu keima Pakai na Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche jeh-a chu nanghon kachondan ho najuijuva, kathu tanho nanit uva, natoh dingu ahi; chutile nangho gamsunga bitkeija nachen dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuteng gamchun aga ahinso sah-a, nanghon vasetna nanehdiu, chule asunga chu bitkeija nachen dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nanghon, Veuvin, keihon tujong katu daova, agaho jong kalokhom daova ahile, Kum sagi lhinna-a chu ipi kanehdiu ham? nati uva ahile,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuteng keiman kum gup channa-a chu kavangbohna nachung uva kathupeh ding, chule hichun kumthum sung ding ga asodoh ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutia chu nanghon kum get channa le muchi natu dingu, ahivanga kumko channa geija aga lui chu naneh dingu; aga ahung lhun kahse-a nanghon alui kikhola kona chu naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gam chu a-itih-a dinga johdoh louding ahi: ajehchu gamchu keija ahibouve; chule nangho hi keima koma gamdangmi le hungkhopem nahibou uve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule nanghon nalonao gamsung jouse-a chu, gam kilhatdoh hi naphal dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nasopipa chu hung vaicha lheh tah-a, chule aman aneilegou phabep chu ajohdoh-a, akinaipi a-insungmi khat chuche lhatdoh dinga ahunga ahile, ama chun asopipan ajoh chu alhatdoh ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule mipa chun koimacha alhatdoh ding nei hih-a, chule ama tah-in alhatdoh jouding ahi tahle,
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuteng aman anei alahkit theina dingin, ajoh dohna kumho kisim henlang, aval chu ajoh napa henga lepehkit hen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla aman amapa henga chu alepeh joulou tah-a ahile, athil kijohdoh chu amapa khutna Jubilee kum ahikahsea umden ding ahi: chule Jubilee teng hiche lahdohna hung umding, chule amapa chun anei ahinle neikit ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule mikhatnin kulbang kikai khum khopi sunga um chenna in khat ajoh-a ahile, aman hichu ajohdoh jou kumkhat guilhungset sunga akilhatdoh thei ding; kum khat lhingset sunga aman alhatdoh thei ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla hichu kum khat lhingset sunga akilhatdoh tahlouva ahile, kulbang kikai khum khopi sunga in chu akhang khanga achopa-a dinga kiphutdet ding: chule Jubilee teng jongle pehdoh louding ahitai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahinla kulbangin akolkhumlou khoneo ho-a um inho vangchu gamsunga um louho dana kisimding: hicheho chu lhatdoh thei hiding, chule Jubilee tengle pehdoh hiding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeng jongle Levi mite khopiho le agoulou khopiho-a inho vangchu, Levi miten itih phat hijongle alhatdoh theiju ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule mikhatnin Levi miho-a kona thilkhat achoh-a ahile, agou lona khopi-a akijohdoh in chu Jubilee kum tengle pehdoh hiding ahi. Ijeh inem itile Levi phungho khopi ho-a in ho chu Israel chate lah-a amahon aneiju chu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahinla akhopiu pamho-a um louho chu kijoh theilou ding ahi; ajeh chu hichu a-itih-a dinga amaho gouchan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule nasopipa chu ahung vaicha tah-a, chule nalah uva chu vaichatna alhuhlhah tah-a ahile, nangman amachu nakithopi ding ahi: henge, gamdangmi le khopem banga nangma koma nachen sah ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ama-a konin nangman akan ahiloule apung lahih-in: nasopipa chu nangma toh achenkhom theina dingin, na Pathen gingin.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangman nasum chu akan dinga napeh louding; naneh nachah jong apung dinga napeh louding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Canaan gam peh dingle na-Pathen'u hidinga, Egypt gama kona nahin puidohpao Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule nakoma cheng nasopi khat chu ahung vaichatna, nangma henga ahung kijoh-a ahile; nangman ama chu soh banga na natohsah louding:
  </para>
  <para style="p">
    <verse number="40" style="v" />Amavang soh thalah bang le khopem banga nahenga umding, Jubilee kum geija nangma najen ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chujouteng aman nanga kona potdoh ding, ama le aumpi achate abonuva, chule a-insung mite henga kinungle kitnuva, apu apate goulona gama chu kile kitding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ijeh inem itile amahohi Egypt gama kona kahin puidoh keima sohte ahiuve: amaho soh-a kijoh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangma ama chunga hunam tah-a navaihom louding; amavang na-Pathen nagin johding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Soh pasal le soh numei nanghon naneikop dinghou chu, nakimvel uva um Pathen houlou ho hidiu ahi: amaho lah-a kona nanghon soh pasal le soh numei nakichoh dingu ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chujongle nalah uva khopem gamdangmi chateho-a kona le, nagam sunguva peng nangho toh umkhom amaho insung mite chu nachoh theiju ahi: chule amaho chu nangho neilegou hiding ahiuve.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule amaho chu nangho nunga nachateo goulo dinga, nei le gou alo diuva nalah dingu ahi; amaho chu a-itih-a nangho soh hiding ahiuve: ahinla nasopiten Israel chate chunga vang, nangho khatnin khat chunga hunam tah-a navai homlou dingu ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule nakoma khopemho le gamdangmi khat chu ahung haodoh-a, chule ama koma cheng nasopipa chu ahung vaichatna, chule nakoma um gamdangmi ahiloule khopempa heng, ahiloule gamsungmi khat henga ahung kijoh tah-a ahile;
  </para>
  <para style="p">
    <verse number="48" style="v" />Ama chu akijoh jouteng lhatdoh kit thei hiding ahi; asopite ho lah-a khatnin ama alhatdoh thei ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Apa-ngahpa ahiloule apa-ngahpa chapa chun ama alhatdoh theiding ahin, ahiloule ama insungmi akinaipi khatnin alhatdoh thei; ahiloule ajo lhangle ama le ama akilhatdoh thei ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chule aman ama chapa chu ama akichohna kum-apat Jubilee kum gei dinga chu akihoupi ding ahi: chule ama akijohdohna manchu akum kisim dungjuija, amatoh ana umkhom soh thalah khat phat dungjuija kitepding ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Kum tamtah aum nahlaija ahile, hicheho dungjuija chu akilhatdohna man chu akichohna suma kona apehding ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chule Jubilee kum lhinna ding chu kum phabep bou avatna ahile, ama amapa toh asimding, akumho dungjuija chu akilhatdohna man chu apeh ding ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Akum kum-a soh thalah banga amapa chuto umding: chule akhatpa chun nangma angsunga ama chunga chu hunam tah-a vai ahomlou ding ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chule hiche kumho sunga hi ama lhatdoh-a aumlouva ahile, Jubilee kum tengle potdoh ding, ama le aumpi achate chu potdoh ding ahiuve.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ajeh chu Israel chate chu keima dingin kasohte ahiuvin; Egypt gama kona kahin puidoh kasohte ahiuve: keima Pakai na Pathen'u chu kahi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nanghon nangho semthu lim, ahiloule khenthu lim nakisem loudiu, lim kituntho jong natundoh loudiu, songa kisem limpou pou jong a-anga kun nadinga naphudoh lou dingu ahi: ajehchu keima Pakai na-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanghon kacholngah nikhoho nanit uva, kamun theng najaboldiu ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nanghon kachondan ho-a nachon uva, kathupeh ho nanit uva, chule nabol uva ahile;
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman nangho aphatcha gotwi kapeh diu, chule gamsung chun aga ahinsodoh ding, loujaova thingphung hon jong agau ahin sepdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nachang voh-u chu lengpigui lokhomto kikaimatna, nalengpiga lokhomu chu muchi lhah phattoh kikaimat ding: nanghon na annu vasetna naneh uva, chule nagam sunguva bitkeija nachen diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman gamsunga chamna kalensah-a, chule nalup uva, koimachan nasuh kichat lou dingu ahi: chule gamsunga kona gamsa gilouho chu kano manga, chemjam minjong na gamsungu apal louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nanghon namelma teo nadel uva, amaho nangho masanga chemjam'a loudingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nalah uva mi nga-in jakhat nadel uva, mi jakhat nin sangsom nadel jamdiu: namelma teu chu namasanguva chemjam'a loudingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu keiman nangho kajabol uva, kaphat theisah dingu, chule kapunsah uva, nangho to kakitepna naphudoh ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nanghon akikhol chu naneh uva, athah jeh-a aluichu nahin pohdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman ka houbuh nalah uva katundoh ding: kahinnan nangho ahot louding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keima nalah uva kache le-a, na Pathen'u kahiding, chule nangho kamite nahi dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanghon amaho soh nahilou na dinguva, Egypt gama kona nangho hinpui dohpa Pakai na-Pathen'u chu kahi; chule keiman nanamkol jon khaovu kasuhtana, dingjanga kachesah nahitaove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla, nanghon kathu nangailou uva, chule hiche thupeh ho jouse nabol lou uva;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule kachondan ho nanah sahmo uva, nahinnaovin kathutan naho ahotbola, chutia chu kathupeh ho jouse nabol daova, kakitepna nasuhkeh uva ahile;
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichehi keiman jong nangho chunga kabolding ahi; namit teniu kamang ding le nalungsungu sugenthei dinga, nachung uva tijatna, khutsao le khosihpi kachuhsah ding ahi. Chule mohseh-a muchi nalhah dingu ahi, ajehchu namelmate nehding bep ahibouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule keiman nangho douna-a kamai kangat ding, chule nangho namelma teu masanga naloudiu: nangho hinmuda hochun nachung uva vai ahomdiu; chule nangho koima del louva najam dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hicheho jouse jeh-a jong kathu nangailou nahlai uva ahile, nachonset jeh uva sagi vei kasuh gentheibe ding nahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nakiletsah piu nathanei nao chu kasuhkeh ding; chule navan-u chu thih, chule na leiset nu chu sum-eng kaso ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuteng nathahat naochu mohjen seh-a kisumang ding ahi; ajehchu naleiset un aga asolou ding, gamsunga thingphung honjong aga aseplou dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangho keito kikala nacheova, kathu nangailou uva ahile; nachonset nahou dungjuija chan sagi-a tam hise nachung uva kalensah ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Keiman nachateo chom mang ding, nagancha hou sumang ding, chule lhomcha naso dinguva gamsaho jong kahinsol ding; chule nalam lhongpiu hou chu agohkeo hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule hiche ho-a jonghi nangho nakisem thah lou nahlai juva, chule keima toh kikala nachon nahlai uva ahile;
  </para>
  <para style="p">
    <verse number="24" style="v" />Keima jong nangho to kikala kacheding, chule nachonset nahou jeh-a sagivei kasuhgimbe ding nahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule keiman kakitepna nelkalna phula dinga, nachung uva chemjam kachuh sah ding ahi: chule nakhopi hou sunga nangho nakikhop khom tengule, nalah uva natset kalensah ding; chule nangho namelma teu khutna kipedoh ding nahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule keiman na-an neh-u hungkon dohna kasuhtan tengle, numei somin thuh khatna nachang lhah-u akandiu, chule amahon nachang lhah-u chu agih dungjuija napehdiu; nanghon naneh uva, ahivanga nava loudiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule hicheho jouse jenga jonghi nanghon kathu nangailou uva, chule keima toh kikala nache nahlai juva ahile;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuteng keima nangho toh kikala lungsa tah-a kacheding; chule keima, keimatah-in nachonset nahou jeh-a sagivei kagimbol ding nahiuve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuteng nanghon nachapateo tahsa naneh dingu, chule nachanuteu tahsa jong naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule keima namun sanghou kasuhsetna, nalimsem hou kasuh boh-a, nalongu chu namilim hou long chunga kaselhah ding, chule kahinnan nangho ahotding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Keiman nakhopi hou agoh-a kakoija, namun theng hou chu agohkeova kakoiding, chule nathil namtui hou nam chu kanahpeh louding nahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule keiman gamsung chu agohkeova kakoiding: chule namelma teu asunga chengho chun hichu kidang asahdiu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule keiman Pathen helouho lah-a nangho kathecheh ding, nanung uva chemjam'a kalap ding ahi: chule nagamu chu agohkeova uma, nakhopi hou chu ahomkeo hiding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuteng gamsung chu agohkeova aumsungse-a acholngah nikhoho amanding, chule nangho namelma teu gamsunga naum dingu ahi; chutengle gamsung chu kicholdo ding, acholngah nikhoho aman ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Agohkeova aumlai sungse-a kicholdo ding ahi; ajehchu nangho asunga nachen laijun, cholngah nikho hon akicholdo pon ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule nangho lah-a ahingdoh amoh chasun chunga chu, aumnao amelmateu gamsunga chu alungsunga kichatna kachuh sah ding; thingdo kilin ginin jong amaho adel ding; chule chemjam masanga jam banga jam dingu; chule koiman adellou tengu jongle amaho lhuding ahiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule koiman adellou tengu jongle amaho chemjam masanga jam banga, khat chu khat chunga lhuding ahiuve: chule nanghon namelma teu masanga dinjou nathei tha nanei loudiu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nangho Pathen helouho lah-a namanthah heldiu, chule namelma teu gamin nangho naneh jouhel dingu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule nangho lah-a ahoidoh hochun namelma teu gamsunga ana khangitlou naho anguipi diu; chule apu apateu khangitlou naho jong chu angui mangpi dingu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Iti hama amahon akhangit lounao le apu apateu khangitlouna, asuhkhel nao keima douna-a asuhkhelna hou, chule keima toh kikala alamlhah nahou aphondoh uva ahile;
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule keima jong amaho toh kikalin kanachen, chule amelmateu gamsunga kana puilut tan; ijemtia alungsung cheptan louho chu asuhnemuva, chule akhangit lounao talen chu akisanuva ahile;
  </para>
  <para style="p">
    <verse number="42" style="v" />Keiman Jacob to kakitepna, Isaac to kakitepna, chule Abraham to kakitepna chu kageldoh kitding; chule gamsung chu kahin geldoh ding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Gamsung jong amahon adalhah uva, gamsung chun amaho beija agohkeova aum sunga chu acholngah nikhoho aman ding: chule amahon akhangitlou naova atalen matnu chu asandiu ahi: ajehchu amahon kathu tanho anahsah loujeh uva, chule amahon keima chondan ho ahotbol jeh-u ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule hiche ho jouse jeh-a hi amelmateu gamsunga aumtengule, keiman amaho kapaidoh louding, suhmanghel ding le kakitepna suhkeh nadinga kahot loudingu ahi: ajehchu keima Pakai a-Pathen'u chu kahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hijongle keiman amaho jala hi, a-Pathen'u kahi theina dinga Pathen helouho mitmu-a Egypt gama kona kahungpuidoh aputeo apateu to kakitepna chu kageldohkit ding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hicheho hi chondanho, thutan naho, danthuho, Pakaiyin amale Israel chate kah-a Sinai molsanga Mosi khutna asemchu ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga thu seijin lang, ajah uva hitin seijin, Mikhatnin mihem khat chu Pakaiya katdoh nadinga kitepna aneija ahile, nangman nahisah sah chu hiding ahi
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangman nahisah ding dan chu pasal kum somni apat kum somgup upa ahile, amachu munthenga shekel dungjuija dangka somnga hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Numei ahile nangman nahisah ding chu shekel somthum hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule kum nga-a pat akum somni sung ahile, nangman pasal la chu shekel somni, chule numeija chu shekel som nahisah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule lhakhat napat kum nga gei ahile, pasal ho dinga natepeh dingchu shekel nga hiding, numei hoding chu shekel thum hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule kum somgup mapat chunglam ahia, pasal ahile, shekel somlenga nahisah ding, numei ahile shekel som nahisah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla nangman nahisah sanga ama anavaichat johle, amachu amale ama thempu henga hung kipelut ding, chule thempun aman atepding ahi. Akihahselpa hijouna dungjuija, thempun aman atepding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Pakaiya thilto dinga ahin kaiju chu gancha ahia ahile, mitinin Pakaiya dinga ahin to jouseu chu atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman hichu akhel louding, aphalou chu apha-a jong alheh louding ahi: chule ijemtia gan chu gana alheh tah-a ahile, hiche chule alhetna chu ania atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hichu Pakai henga ganlhaina atoji louvu sathenglou ahia ahile, aman gan chu thempu anga ahin pehlut ding:
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hichu thempun hichu apha hile ase hile aman atepding; thempu nangman aman natep jat jat chu aman hijeng ding ahi
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahinla aman hichu alhatdoh dinga ahile, nangman aman natep chunga chu nga-a khat abelap ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule mikhatnin a-in chu Pakaiya atheng hidinga asuhtheng tengle, thempun hichu apha hile ase hile aman atepding: thempun atep jatjat chu hijeng ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule a-in suthengpa chun a-in chu alhatdoh dinga ahile, nangman aman natep chunga chu nga-a khat abelap ding, chule hichu ama-a hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule mikhatnin agoulo loumun behkhat chu Pakai henga asuhtheng tah-a ahile, aman dingchu chuche-a muchi kilhah dungjuija nangman natepding ahi; sakolchang chi homer khat chu dangka shekel som nga-a kitepding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman alou chu Jubilee kum-a pat asuhthenga ahile, nangman aman natep jatchu hijing ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahinla aman alou chu Jubilee jouva asuhtheng ahile, thempun apehding sum avat chu Jubilee hunglhun nading kum avatho dungjuija asimdoh pehding, chule hichu nangman nateppeh jatna kona kisulhom ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule lou suthengpa chun ipijeh hama alhatdoh dinga ahile, nangman aman natep chunga chu nga-a khat abelap ding, chuteng hichu ama-a dinga kisuhdet pehding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule aman alou chu alhatdoh louding ahia, ahiloule alou chu midang khat henga ajohdoh-a ahile, kilhatdoh kit louding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla louchu Jubilee sunga pehdoh ahia ahile, akikatdoh lou banga hichu Pakaiya atheng hiding ahi; hichu thempu gouchan hiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule khattouvin ama neilegou hilou, amavang achohtho loumun chu Pakai henga asuhthenga ahile;
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuteng thempun Jubilee kum geija dinga nangman natep chu ama dinga asimpeh-a, chule hiche nikho mama chule amapan nangman natep jat chu thiltheng banga Pakai henga apeh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jubilee kum tengle alou chu akichohna pa henga kile kitding, masanga agam neipa heng ngeija chu kile kitding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nangman natep ho jouse chu munthenga shekel dungjui hicheh ding, gerah somni chu shekel hiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Gancha peng masapen, Pakaiya dinga apeng masapen hidingho bouchu koimachan asuhtheng louding ahi; bongchal hihen, ahiloule kelngoiho hijongle; hichu Pakaiya ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahinla hichu gantheng louva kon ahile, natep dungjuija amapan alhatding, chule achunga nga-a khat abelap ding; ahiloule hichu akilhat lou dinga ahile, nangman aman natep dungjuija kijohdoh ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeng jongle thil kikatdoh tapou, mikhatnin aneiho jouse lah-a kon mihem le gancha lah-a kon hihen, agouchan alouva kon hijongle Pakaiya dinga akatdoh chan chu kijoh louding, lhatjong kilhatdoh louding ahi: thil kikatdoh jouse chu Pakaiya ding atheng chungnung hia ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mihem lah-a kona suhmang dinga kikatdohsa mihem vangchu koiman alhatdoh louding, amavang kithat teiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule gamsunga somma khat jouse, gamsung muchi-a kon hihen, ahiloule agam theiga lah-a kon hijongle, Pakaiya ahi: Pakaiya dinga atheng ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule mikhatnin asoma khat hochu lhatdoh ding agotna ahile, aman hiche chunga chu nga-a khat abelap ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule bonghon, ahiloule kelngoi hon thudola somakhat chu, moljol noija lut tapou asom lhina jouse chu Pakai henga dinga atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman hichu aphaham ahiloule aseham akholkhoh louding, chule khel jong akhel louding ahi: chule iham tia aman akhel khah tah-a ahile, hiche chu le akhelpa chu ania atheng hiding ahi; hichu kilhatdoh louding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hicheho hi Sinai molsanga Israel chatea dinga Pakaiyin Mosi henga athupeh chu ahi.
  </para>
</usx>
