<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="AMO" style="id">Amos</book>
  <para style="h">Amos</para>
  <para style="toc1">Amos</para>
  <para style="toc2">Amos</para>
  <para style="mt">Amos</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ling kiho kumni masang, Israel leng Joash chapa Jeroboam nikholai, chule Judah leng Uzziah nikho laija Israel chungchang thu; Tekoa mi, kelngoi ching holah-a pang Amos'in anamu thuho chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman aseije, Pakai chu Zion'a kona hung kitumding, Jerusalem'a kona aw ginga thu aseiding; kelngoi chingho chenna chu lunghem ding, chule Carmel molvum chu golha ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin hitin aseije; Damascus suhkhelna thumle liho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu amahon Gilead chu changchilna thih manchah-in achilun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla keiman Hazael insunga meikong kahinsol ding, hichun Ben-hadad leng inpiho ahalvam ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keiman Damascus jol jong kaheboh ding, Aven phaichama chengho le, Eden insunga kon leng tenggol tuhpa chu kasat lhah ding ahi. Chule Syria mite chu Kir chana gal hinga kikaidiu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin hitin aseije; Gaza suhkhelna thumle liho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu amahon Edom mite pehdoh dingin, sohchangho chun abonun gal hingin akaijun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin keiman Gaza bang chunga meikong kahinlelhah ding, hichun leng inpiho chu ahalvam ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman Ashdoh kho-a chengho le Ashkolon'a kon leng tenggol choipa chu kakaidoh ding, chule keiman Ekron chunga kakhut kalhah ding ahi: chule Philistine mite ahingdoh amoh chengse chu mangthah ding ahiuve, tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakaiyin hitin aseije; Tyre suhkhelna thumle liho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu amahon gal hinga kimanho jouse chu Edom apetan; hiti chun sopi hina-a kitepna chu ageldoh tapouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla keiman Tyre bang chungna meikong kahin lelhah ding, hichun leng inpi chu ahalvam ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakaiyin hitihin aseije; Edom suhkhelna thumle liho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu aman asopipa chu chemjamin adelin, khotona kiti himhim adontapoi, hitichun alunghana-a chun suhset aneijingin, chule alungsatna chu a-itih in avopjingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla keiman Taman chunga meikong kahinlelhah ding, hichun Edom sunga um Bozrah leng inpi chu akahvam ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakaiyin hitin aseije; Ammon chate suhkhelna thumle liho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu amahon gamsung kehlet ding deinan Gilead'a um numei ho naovop lai ho chu akhe jalun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin keiman Rabbah bang chunga mei kakonsah ding, galsat nikho-a kisen awgin toh, chimpei kipei nikho-a huipi toh tho-a, aleng inpi hou ahalvam ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule alengpau chu gal hinga kikai mangding, ama le apipuihou puma kaimanga umding ahiuve, tin Pakaiyin aseije.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin hitin aseije; Moab suhkhelna thumle liho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu aman Edom lengpa guho chu lungngou vin ahal vamin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijongle keiman Moab chunga meikong kahin sollhah ding, hichun Kerioth leng inpiho ahalvam ding, chule Moab chu boina le kisen awgin chule sumkon ginna thiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keiman chua kona thutanpa chu kasatlhah ding, chule pipuiho jouse ama puma kathading ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin hitin aseije; Judah suhkhelna thumle liho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu amahon Pakai dan thu anahsah pouvin, adan thupeh anit pouve, chule apu apateu dung asunnun, ajouseinao chun atohkhel sah-un ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijongle keiman Judah chunga meikong kalelhah ding, chule Jerusalem'a leng inpiho chu ahalvam ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiyin hitin aseije; Israel suhkhelnaho thumle li ho jeh-a, Keiman achunguva chuding talen chu kalahdoh lou ding ahi; ajehchu amahon chonphat chu dangka manin ajoh-un, chule vaichat kengchot to khatnin ajoh un ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahon vaichaho luchanga leivui chu amutnun, milungneng lampi akihei mang sanun ahi: chule keima mintheng asubohna dingin, pale chapa numei khat akikopmun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho maicham takipma kitepna-a kipha ponho chunga chun nomtah in alumlhaovin, chule themmo channa ju chu a-pathen'u insunga adonun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin Cedar thingphung banga sangtah, gangpi phung banga dettah Amor mite chu amaho maikoh-a kasumangin; aga chu chunglama konin kasumangin, ajung chu noilama patnin kasumangin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chujongle keiman nangho Egypt gama konin kapuidoh-un, chule Amor mite gam nalo theina dingun, gamthip laija kum somli kahin puileu vin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman nachapateo chu themgao dingin, chule nakhang dong hou chu Nazir mi hidingin kakhou khah-in ahi. Vo Israel chate, hichehi dih hina louham? tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahivangin nanghon Nazir miho don dingin lengpitwi napeuvin, chule themgaoho chu gaothu seihih-un tin thu napeuvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Veovin, changphal dimsetnin bongkang adelpha bangin, keima nangho noija delphan kaume.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh-a chu ajama chu akikinsah-a kona mangthah ding, chule athahatnin jong athaneina asuhhat louding, chule mihat tah jong ama kihuhdoh joulou ding;
  </para>
  <para style="p">
    <verse number="15" style="v" />Thalpi choipa jong chu dingjou dehlou ding, mikaljang jong amale ama kihuhdoh jou louding; chule sakol chunga touva jong ama le ama kihuhdoh joudeh louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hiche nikho chule hatchung nungho lah-a ahangsan pa jong sagoh-a jam mangding ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo, Israel chate, Egypt gama kona kapuidoh insung pumpi, Pakaiyin nangho douna-a thu aseihi ngaijun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Leiset chunga um insung jouse lah-a hi keiman nangho sehbou kahet nahiuve; hijeh-a chu nakhan gitlounao jouse jeh-a keiman nangho talen kamatsah ding nahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kinopto louva mini chekhomthei lhonem?
  </para>
  <para style="p">
    <verse number="4" style="v" />Keipi bahkai khun sa nehding aneilouteng, gammang sunga akitumdem? Keipi bahkai donglai khun nehding aneiloule, akulsunga kona hungham ji-em?
  </para>
  <para style="p">
    <verse number="5" style="v" />Tolla thang anchah umlouva, vacha thanga oh theijem? Thang chu asupel beija, tolla kona kipel theijem?
  </para>
  <para style="p">
    <verse number="6" style="v" />Khopisunga sumkon akimutle, miho kichalou ding ham? Khopi sunga thilse alhuna ahile, hichu Pakaiyin abollou hilou dingham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Tahbeh-in Pakai Pathen'in athuguh asoh themgaoho koma phongdoh masalouvin ima abolpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keipi bahkai akitum tai, koiham akichalou ding? Pakaiyin thu aseitai, koijin aphondoh da thei dingham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ashdoh leng inpiho le Egypt gamsung leng inpiho-a chun phongle uvin, chule nangho Samaria molsang ho chunga kikhomun lang, alailunga mipi linglaoho le suhgentheija umho khu veuvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aleng inpihou sunga hunamle gucha michom akholkhom jeh-un, amahon thildih bolje ahetapouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun Pakai Pathen'in aseije; gamsungle akimvel chu melmaten aumkimvel ding, aman nahatna chu nanga kona aloilhah ding, chule naleng inpihou chu suhchatvaija umding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kelngoi chingpan keipibahkai kamsunga kona akelngoi kengni ahiloule abil hal beh hijongle asalhah tei banga, Samaria gamsunga cheng Israel chate, jalkhun ningchonga umho le, Damascus'a umho chu alupnaova kona kiladoh ding ahiuve, tin Pakaiyin ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pakai Pathen, janel Pathen chun, nanghon ngaijunlang hichehi Jacob insunga hettohsah un, tin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel chunga asuhkhelna hou jala gotna kapeh nikho chuleh Bethel maicham ho jong gotna kapeh ding, chule maicham ki hochu kisatlha ding, tolla lhading ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman phalbi in le nipi lai in chu kavoh lhuh-a, sai mola kisa inho chu mangthah ding, chule inloupiho chun kichai dingu ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vaichate bolse-a, panpi ngaite sugentheija, a-pakai teo henga hinchoijun donu hite tijia, Samaria molsanga um Bashan bongpi hi, hiche thuhi ngaijun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai Pathen chu athenna-a kitep ahitai, Veovin, aman nangho thihkoija, chule nason napah hou ngakoija akaimang diu nikho chu nachung uva hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho ahomlai ho-a kona napotdoh diu, mijouse ama ama mailam cheh-a cheding, chule nanghon amaho chu leng inpi sunga nalelut dingu ahi, tin Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bethel'a hungun, chule sukhelun; Gilgal'a hungun lang suhkhelna punsah-un; na ganlhaina houchu jingkah sehle hinchoijunlang, nahopsom ho kum thum jou sehle hinchoijun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chol panna-in thangvahna ganlhaina peuvin, chule manbei thilpehho phongdoh unlang samphong leuvin: ajehchu chutia bolding chu vo Israel chate, nangho deilam ahi, tin Pakai Pathen'in aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Keiman nakhopi jouseuva kel kalhahsah ding, na-umnao jouse-a changlhah kalhah samsah-in, Ahivangin kahenga nahung kiledeh pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule keiman chang atding phat lha thum masangin, nangho-a konin gotwi katuh tangin; khopi khat chunga go kajuhsah-in, khopi danghoa kajuh sahpon; gambih khat chunga go ajun, chule gojuh louna munho chu agojin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun khopi ni ahiloule thumho chu khopi khatna twi dondin acheleuvin, ahinla adang chah-u achimdeh pon; ahivangin kahenga nahung kiledeh pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman nangho huise le daitwi jin jepna kape-in, nahon leihou, nalengpi leihou, natheichang phung hou, chule na olive phung hou apun laitah-in, lungmul lenhon anechaijun; ahivangin kahenga nahung kile deh pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman Egypt'a kabolna bangin nalah uva hise kalansah-in; nakhang donghou chemjamin kasatlih-in, nasakol hou katolmangin; chule nagebuh sungu namse chu kanah sah-un; ahivang kahenga nahung kiledeh pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen'in Sodom le Gomorrah anasuhmang bangin, keiman nangho lah-a phabep kasumangin; chule nangho meikong lah-a meisel kiladoh kongnalai nabangun; ahivangin kahenga nahung kiledeh pouve, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh-a chu, Vo Israel, keiman hitia hi kabolding ahi: chule hitia kabol ding jehchun, Vo Israel, na Pathen toh kimutodin kigon.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu, ven, mol le lhangho ana tungdoh-a, chule hui sempa, mihemte henga alunggel phongdoh-a, jingkah jong muthim sosahji chule leiset chung munsang ho chunga dingpa, Pakai, janelho Pathen, kiti chu amin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Israel insung, nangma douna-a kathusei, kacham hela nachung chang thu kaseihi ngaiphan.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel nungah theng chu alhutan, thoudoh joulou ding ahitai: amanu agamsunga kidalha ahitan, chule amanu kaithou ding koimacha aumtapoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pakai Pathen'in hitin aseije; Israel insunga dinga, khopi mi sangkhat kitoldoh lah-a chu jakhat bou kida lhah pehding; chule mi jakhat kitoldoh nalah-a som bou kida lhah pehding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun Pakaiyin Israel insung mite jah-a hitin aseije, Keima neiholun chutile nahin dingu ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin Bethel hol hih-un, Gilgal'a jong lut hih-un, chule Beersheba hopa hih un; ajehchu thonlouva Gilgal chu sohchang teiding, chule Bethel chu imalou hungsoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakai chu holun, chutile nahin dungu ahi; achuti loule Joseph insung chunga ama meikong banga hungchu ding, akahvam ding, Bethel'a aphelmit ding umlou ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangho thutanna gamsai sosah-a, chule chonphatna leisetna dalha jenghon,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahsi sagi hole bombel sempa, thina le-lim jingkah sosah-a, sunlai jengjong jan banga thimsahpa: huipi twiho kou khoma, chule leiset chunga sunglha pa Pakai chu holun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman kulpidet chunga gamna achuhsah nadingin, ahat chunga manthah na achuhsah-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amahon kotpi phunga miphohho athet bolun, chule dihtah-a thusei ho chu ahot bolun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanghon vaicha chu nachotpha jeh-u le, ama-a kona suhlou chang pohgih nalahpeh jeh-un; nanghon songa kikhengin in sajong leuchun, asunga nachenlou diu, lengpilei hoitah neijuna tin, hijongle lengpitwiho chu nadonlou dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu keiman nasuhkhelnao tamtah le na chonsetnao aletje chu kahei: amahon mikitah ho asugentheijun, sum nehguh abolun, chule kotpi phunga vaichate chu achanvou-u aheimang peh-un ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh-a chu milungchingho chu chuche nikho chule thipding ahiuve: ajehchu hichu phat phalou hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nahin theina dingun, thilse hilouvin thilpha holun; chutile nanghon nasei banguva, Pakai Pathen chun naumpi dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Janel Pakai Pathen'in Joseph insung amohho chunga lungsetna anei theinadin; thilse chu hotbolun, thilpha chu ngailuvin, chule kotpi phunga thutana dih phutdoh-un.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun Pakai, janel ho Pathen, Pakai chun hitihin aseije; khopi lamlen jouse-a kalemao umding; lamlhongpi jouse-a Ohe! Ohe! atidingu, amahon loulhoupa chu lunghem dinga, chule kapthemho chu kapdinga akoudiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule lengpilei jouse-a kana umding ahi: ajehchu naheng kahin jotpa ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai nikho ngaicha-a nangho ada nahiuve! hiche nikho chu ipiding natiu ham? Pakai nikho chu muthim ahin, vah ahipoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihem chu keipi bahkai kicha-a ajamle, vompi toh kitoh ding; insunga lutna, akhut banga angaile, gul'in achuh ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakai nikho chu khovah hilouva muthim joh hilouham? hichu hathima thim asunga vah beihel hilou ham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Keiman nakut nikho hou chu kakidah-in, kahoi, chule nakhoppi len houva jong kakipa louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanghon govam thilto le neh thiltoho neipe jongleu chun, keiman hicheho chu kasan lou ding: chule chamna thilto-a dinga gancha thaotah tah nato houjong, nahsah-a kanei louding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kakoma nalasah-u awginho jong chu chon mangun, ajehchu keiman natumging ngeitah hou jong chu kangailou ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahinla dihtah-a thutanna chu twiho bangin longlhahen, chule chonphatna chu luidung hattahto banghen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vo Israel insung mite, nanghon gamthip gama kum somli sunga chu ganlhainaho le thiltoho neinapeh uvem?
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla nanghon nangho dinga nakisemu na pathen hou ahsi, Moloch ponbuh le namilim semthu-u Chiun chu napo leuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun Pakai, amin janelho Pathen chun, keiman nangho Damascus khellam peh-a, gal hinga kache sah ding nahiuve, tin aseije.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zion'a nomsa tah-a umho, chule Samaria molsanga atahsan ngamho, namtinho lah-a pipua kiminvo, Israel insung mite hungkon dohna, ohe ada-a ahiuve!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho Calneh-a cheovin lang veuvin; chule chua kon chun Hamath loupi-a chun cheovin; chujoule Philistinte khopi Gath'a chun chesuh-un; amaho chu hiche lenggam ho sanga phajonam? ahiloule agamgiu chu nangho gamgi sanga lenjonam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho nikho phalou gamlatah-a koidoh-a, chule hunama thuneina naicha-a loilut ho;
  </para>
  <para style="p">
    <verse number="4" style="v" />Saiha-a kisem jalkhun chunga luma, chule atouna nomtah chunga kithaljam ho, kelngoi nou ahonlah-a kon mandoh-a, chule bongnou ho akula alah uva kona mandoh-a nejia nangho;
  </para>
  <para style="p">
    <verse number="5" style="v" />Selangdah-a la manthei louva sa-a, chule David tumging banga tumgingthei kisemthu-a nangho;
  </para>
  <para style="p">
    <verse number="6" style="v" />Lhengkonga judon ji-a, amaho le amaho thao hoipen pen kinuji; ahivanga Joseph kisuh gentheina-a lunghempi louho.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh-a chu tu-a hi amaho gal-hinga kikai masa hotoh gal hinga chekhom diu, chule nomsa tah-a kithaljamho golvah jong kisubei ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai Pathen amatah akihahselin, janel Pakai Pathen'in hitin aseije; Jacob kiletsahna chu kakidah-in, aleng inpiho chu kathe-e: hijeh-a chu akhopi chu asunga umho jouse puma kapehdoh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hung hitiding ahi, insung khatna mi som auma ahileh, amaho chu thiding ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule agu chu haldinga apa-ngah pa leh athiho hal pa chun alah-a, insunga kona ahinpoh doh ding, chule insunga um mikhat henga chu, khattou nangma toh umkhoma umnalai em? tia aseiding; chule ama chun, koima aumtapoi, atiding ahi. Chutengle aman, nakam kihupmin; ajehchu eihon Pakai minchu iphahpoh theilou diu ahi, tia asei ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu veuvin, Pakai chun thu apeh ahi: chule aman inpi chu avohsetna asuhchip ding, chule inneoho chu ahal hala asoding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sakol ho chu songpi chunga lhainao vin tem? Mihon chumun chu bongchalin kainao vin tem? Ajehchu nanghon thutandih chu thinkha naso-un, chule chonphatna ga chu thing gunei nasosah taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho imacha hilou thil khatna kipah jia, chule sakiho chu ithahat naova ikilah-u hilou ham? tia seijiho.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijongle, veuvin, vo Israel insung, keiman nangho douva nam khat katun dohding ahi, tin janel Pakai Pathen'in aseije; chule amahon Hamath lutna-a pat, gamthip vapidung geija nangho nasuhgenthei dingu ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai Pathen'in keima hitihin eina musah-e: veuvin, aman hamhing kehdoh nunung ho ahung kedoh kipat tilin khaokho tamtah asemin, veuvin, hichu lengpa-a hamhing at dan dungjuija akehdoh nunung ho ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, amahon gamsunga hampaho anehchai phatnun, keiman, Vo Pakai Pathen nahenga katao ahi, ngaidamin, Koi jala Jacob chu dingdoh kit ding ham? Ajehchu ama neocha ahi, tin kaseijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh hin Pakaiyin alung aheijin; chuti taponte, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai Pathen'in keima hitihin eimu sah-e: veuvin, Pakai Pathen'in engbolna din mei akouvin, hichun twipi lentah akagon, chule tolgo phabep jong akavamin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin keiman, Vo Pakai Pathen, khongaijin tia nahenga katao ahi; Koi jala Jacob chu dingdoh kit ding ham? Ajehchu, ama neocha ahi, tin kaseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichun Pakai lung akisihsah tan, hiche jonghi chuti taponte, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitihin aman eimusah-e, chule veuvin, Pakai chu tetohna khao akhutna achoijin, tetohna-a kisem bang chung khatna adingin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin kajah-a, Amos, nangin ipi namu em? eiti. Chuin keiman, tetohna khao kamui katin ahi. Chuin Pakaiyin hitin aseije; Ven, keiman kami Israelte lah-a tetohna khao kakoiding, keiman amaho lah kapal kit tahlou ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Isaac munsang ho chu kamhel ding, Israel muntheng ho chu kisumang ding; chule keiman Jeroboam insung douna-a chemjam kapat ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Bethel'a thempu Amaziah chu Israel leng Jeroboam henga thu athotnin, hitin aseije; Israel insung mite lah-a nangma dounan Amos'in guhthim thilgon aneije. Athusei jouse chu gamsung mite pohjou ahipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Amos'in hitin ati, Jeroboam chemjam'a thiding, chule Israelte hi agam sunguva kona sohchang dinga kitolmang ding ahiuve, tin aseijin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaziah jong chun Amos jah-a, vo nangma mitvahnei, chenlang Judah gama jamlut-in, chumuna chun changlhah nenlang gaothu seijin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin Bethel'a hin gaothu seikit tahih-in: ajehchu hikom hi lengpa houin le lengpa leitol ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Amos'in adonbutnin, Amaziah jah-a, keima themgao kahipoi, themgao chapa jong kahipoi; ahinla keima kelngoi vah-a le theiba ga lohkhom bou kahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule kelngoi hon nung kajui petnin, Pakaiyin eipuijin, kajah-a, Chen, kami Israelte lah-a gao thu gaseijin eitin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun, tun nangin Pakai thusei hi ngaijin; nangman kajah-a, Israel dounan gaothu seihih-in, chule Isaac insung dounan thu seihih-in tin naseije.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun Pakaiyin hitin aseije; najinu chu khopi sunga noti'a pangding, nachapate le nachanute chu chemjam'a lou dingu, nagam leiset chu tena khaova kihomtel ding; chule nangma gam thenglou mun'a nathi ding ahi: chule thonlouva Israel chu agamsunga kona munchoma sohchanga cheding ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakai Pathen'in hitihin eimusah-e; veuvin, nipilai thei paipeh khat aumin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman, Amos ipi namu em? eiti. Chuin keiman, nipilai thei paipeh khat kamui kati. Chuin Pakai chun kajah-a, Kami Israelte chunga achaina chu ahunglhung tai; Keiman amaho lah kajotpa kit tahlou ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule chuche nikhole houin'a laho chu kale maon'a hiding ahi, tin Pakai Pathen'in aseije. Muntina thilong tamtah umding; amahon amaho chu thipbeh-a apaidoh dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichehi ngaijun, Vo nangho, panpi ngaite vallhumjia, gamsunga vaichate losamsah jiho,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon, Itihle lhathah akichaijin, chang le mim ijohthei diuvem? chule cholngah ni akichaijin, ephah isuneovun, shekel iletsah-un, chule jouvin khaikot ilepmun, sakolchang joh din ikipanthei diuvem?
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti chun vaicha chu dangka khatnin, panpi ngaichu kengchot tokhatnin icho uvin; chule sakolchang vaiho jengjong ijoh thei diuvem? nati uve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai chu Jacob chungnunna-a chun akihahselin aseije, keiman, anatohhou khatcha jong kasuhmil louhel ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche jeh-ahi, gamsung kihotling louding hija, chua cheng amitakip chu lunghem louding ham? Hichu twisoh banga apumchanga hungsoh doh ding; Egypt'a twiso banga chu, paidoh le lhohsah-a umding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuche nikho chule hung hiti ding ahi, tin Pakai Pathen'in aseije, keiman sunlaile nisa kalhum sah ding, chule khovah laitahle thim kajin sah ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule keiman na kut hou lunghemna kasosah ding, chule nala hou jouse kala kaso ding; taijol jouse chunga khaodip pon kahin lhun sah ding, chule luchang jouse kachaisah ding; chapa changkhat chunga lunghemna tobang chu kalhun sah-a, chule achaina chu lungnatna nikho hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Veovin, nikhoho chu ahung lhunge, tin Pakai Pathen'in aseije, hitia chu keiman gamsunga kel kahin lansah ding, changlhah ngaichatna jeh-a kel hilou, twi ngaichatna jeh-a dangchah jong hilou ding, amavang Pakai thujah nomna kel hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amaho twilen khatna kona twilen khat, chule sahlama pat solam gei, amaho Pakai thu holna suhle tunga lhaile diu, ahivanga amujoulou dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche nikho chule nungah theng hoitahho le gollhang ho chu dangchah jeh-a lhalhop diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Samaria chonset na-a kihahsela, Vo Dan, na Pathen ahinge; Chule Beersheba umdan ahingin; tia seiho jengjong chu lhu uva, thoudoh kit talouhel dingu ahitai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keiman Pakai chu maicham chunga adin kanamui; chule hitin aseije, akhom ho chu akilon theina din kotbeng chu jepmin; chule alu-u chu ban sattanin, alah uva anukhahpen chu Keiman chemjam'a kasatlhuh ding; alah uva jam-a chu jammang theilou ding, chule ahoidoh-a kihuhdoh louding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amahon thikhol khul'a leiko laijongleu, hia kona chu kakhutna kaloidoh ding; amaho van'a kaltou jongleu, hia kona chu kapuilhah kit ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amaho chu Carmel molvum'a kisel jongleu, kahol doh-a hia kona chu kakaidoh ding; chule amaho kamitmu-a konin twikhanglen todopma kisel jongleu, chumuna chu keiman gul thu kapeh-a, aman amaho chu achuh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amaho amelmateu masanga gal hingin kitol jongleu, chumuna chu Keiman chemjam thu kapeh-a, hichun amaho athagam ding; Chule Keiman amaho thilpha-a ding hilouva, thilse-a dinga kavetlhih jing dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule gamsung sukha jia chu janel ho Pakai Pathen ahin, hichu junlha-a, chua chengho jousen alung hempi diu: Hichu twisoh banga apumchanga hungsoh doh ding; Egypt'a twiso banga chu, paidoh le lhohsah-a umding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vanchunga indanho kisah-a, leisetna galmihon kisemdoh-a chu ama ahin; twipia twiho kou khoma, hihochu leiset chunga hinsung lha-a chu ama ahi. Pakai kiti chu amin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo Israel chate, nangho Keima dinga Ethopia chateho tobang nahiu hilou ham? tin Pakaiyin aseije. Keiman Israel chu Egypt gama kona kapuidoh hilou ham? Philistine te chu Caphtor-a kona, chule Syria techu Kir'a kona kapuidoh hilou ham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Veovin, Pakai Pathen mit teni chu chonsetna dim lenggam chunga achujin, chule keiman hiche leiset chunga kona kasuhmang helding; Jacob insung vang kasuhmang hel louding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu, veuvin, Keiman thu kapeh ding, godalla chang akisep banga, Keiman namtinho lah-a Israel chu kasep chil ding ahin, achang neopen jeng jong tolla lhalou ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Setna-in eiphapou vintin, mai jong eikimaitopi pouvinte tia sei Kami chonseteho jouse chu abonuva chemjam'a louding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche nikho teng chule keiman David houbuh lhusa chu kaphoh ding kitna, aselai ho kasemphat kitding; chule achimsa chu katundoh kitna, gollui laija banga kasah doh kit ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutiachu Edom mite amoh chengse le, Pathen hephaloute kamina kikou chengse chun alo theidiu ahi, tin hiche tongdoh-a Pakai chun aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Veovin, nikhoho chu ahung lhunge, tin Pakaiyin aseije, loukaija pangpan chang atpa ahinphah ding, lengpithei chilpan muchi tupa ahinphah ding; molsang hon lengpitwi lhumtah ahinvat lhahsah-a, chule lhangho jouse junlha dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule keiman kami Israelte chu asohchan naova kona kahin lepui kit ding, amahon akamhelsa khopiho asahdoh kitnuva, hiho chu chenna-a aneidiu; chule lengpitheiho aphu uva, chuche-a lengpitwi chu adondiu; chule honho jong abolluva, chuche-a agaho chu anehdiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman amaho chu agamuva kaphulut dingu, keiman kapehsao gamsunga kona chu amaho kibotdoh kit louding ahitaove, tin Pakai na Pathen'un aseije.
  </para>
</usx>
