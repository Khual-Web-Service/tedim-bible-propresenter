<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NUM" style="id">Minbu</book>
  <para style="h">Minbu</para>
  <para style="toc1">Minbu</para>
  <para style="toc2">Minbu</para>
  <para style="mt">Minbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Egypt gama kona ahungdoh kalu kumni channa, alhani lhinna nimasa pen nin Sinai gamthipma kikhopna houbuh sunga chun Pakaiyin Mosi jah-a thu ahin seijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate houkhom ho jouse chu a-in ko kon, aphung phunga apate kailhah cheh-in, amin jatnu dungjui cheh-in pasal jouse abonchan simsoh keijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel sunga galsat dinga manthei jouse kum somni-a pat achunglam sechu nangma toh Aaron'in aloi loija sim sohkei lhonin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule aphung phunga apate kailhah-a insung luchang pentah mikhat cheh nakithopi lhon dinga nalhen doh lhon ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hicheng jouse hi nangni kithopi ding miho minchu ahi: Reuben phunga kon; Shedeur chapa Elizur.
  </para>
  <para style="p">
    <verse number="6" style="v" />Simeon phunga kon, Zurishaddai chapa Shelumiel.
  </para>
  <para style="p">
    <verse number="7" style="v" />Judah phunga kon, Amminadab chapa Nahshon.
  </para>
  <para style="p">
    <verse number="8" style="v" />Issachar phunga kon, Zuar chapa Nethaneel.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zebulun phunga kon, Helon chapa Eliab.
  </para>
  <para style="p">
    <verse number="10" style="v" />Joseph chate holah-a kon: Ephraim phunga kon, Amihud chapa Elishama: Manesseh phung kon, Pedahzur chapa Gamaliel.
  </para>
  <para style="p">
    <verse number="11" style="v" />Benjamin phunga kon Gideoni chapa Abidan.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan phunga kon, Ammishaddai chapa Ahiezar.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher phunga kon, Ocran chapa Pegiel.
  </para>
  <para style="p">
    <verse number="14" style="v" />Gad phunga kon, Deuel chapa Eliasaph.
  </para>
  <para style="p">
    <verse number="15" style="v" />Naphtali phunga kon, Enan chapa Ahira hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichenghi houkhom na lah-a kona aminche cheh ahiuvin, apu apateu phung kaija pipu cheh, Israel asang sang luchang ho ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Mosi le Aaron chun hiche amin kisimdoh chengse hi apuidoh lhonin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule houkhom ho jouse chu lhani lhinna nimasa pen nichun akhom khomun, amahon apu apaova a-inko dungjui cheh-in, kum somni-a lhah chunglamse chu asimun, amin jatnu dungjui cheh-in aphung guiju chu aphongdoh taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakaiyin Mosi athupeh bangin, aman jong Sinai gamthipma chun aminu asimtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel chapa alenpen Reuben chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkei tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Reuben phunga kon akisimdoh amaho chengse chu; sangsomli le sanggup toh janga ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simeon chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="23" style="v" />Simeon phunga kon akisimdoh amaho chengse chu sangsomnga le sangko toh jathum ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gad chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="25" style="v" />Gad phunga kon akisimdoh amaho chengse chu sangsomli le sangnga toh jagup le somnga ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="27" style="v" />Judah phunga kon akisimdoh amaho chengse chu sangsomsagi le sangli toh jagup ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Issachar chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="29" style="v" />Issachar phunga kon akisimdoh amaho chengse chu sangsomnga le sangli toh jali ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulun chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="31" style="v" />Zebulun phunga kon akisimdoh amaho chengse chu sangsomnga le sagi toh jali ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Joseph chate, aminso dinga Ephraim chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="33" style="v" />Ephraim phunga kon akisimdoh chengse chu sangsomli toh janga ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Manasseh chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="35" style="v" />Manasseh phunga kon akisimdoh chengse chu sangsomthum le sangni toh jani ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Benjamin chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="37" style="v" />Benjamin phunga kon akisimdoh chengse chu sangsomthum le sangnga toh jali ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dan chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="39" style="v" />Dan phunga kon akisimdoh chengse chu sangsomgup le sangni toh jasagi ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Asher chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="41" style="v" />Asher phunga kon akisimdoh chengse chu sangsomli le sangkhat toh janga ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Naphtali chate chu akhangu dungjui, a-insungu dungjui, apu apateu insung kailhah dungjui cheh le, aminu kisim dungjui cheh-in pasal takip kum somni-a lhah chunglam sese galla konthei cheh chu asimtoh sohkeijun ahile;
  </para>
  <para style="p">
    <verse number="43" style="v" />Naphtali phunga kon akisimdoh chengse chu sangsomnga le sangthum toh jali ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hichenghi Mosi le Aaron nin asimdoh lhon chu ahin, Israel pipuho chu mi som le mini ahin; mikhat cheh chu phung khat cheh-a ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hijeh chun hichengho jouse hi Israel chate ho, apu apateu insung dungjui cheh-a kumsom ni-a lhah chunglamse, Israel sunga gal konthei cheh akisimdoh hochu ahiuvin;
  </para>
  <para style="p">
    <verse number="46" style="v" />Aboncha akisimdoh jouse chu, sangjagup toh sangthum toh janga le somnga ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ahivangin Levi ho chu apu apateu kailhah phung lah ahin akisimtha pon ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ajehchu Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="49" style="v" />Levi phung bou chu nasimtha louding, Israel chate kisim na-a jong nasimtha louding ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahivangin nangman Levi ho chu hettohsahna houbuh chung le asunga um sumlheng ho chung, chule thildang aum jouse vetupma napansah ding ahi; amahon houbuh le asunga sumlheng ho jouse apoh dingu; chule hicheho chunga chu lhacha-a pangdiu, chujongle houbuh kimvela chu gebuh akison dingu ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Houbuh chu malama akichon ding tengle, Levi miten aphetlhah dingu: chule houbuh chu sonding ahitengle, Levi mihon atundoh dingu ahi: chule hetkhahlou mi anaija hunga aumle thajeng ding ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chule Israel chate chun ama ama ponbuh cheh chu abung abunga akisah diu, amitakipmin ajanelu dungjuija aponlap kom cheh uva akisah dingu ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Amavang Levi ho chun Israel houkhom ho chunga lungsatna aumlouna dinga, hettohsahna houbuh vela chu akisah dingu ahi. Chule Levi ho chun hettohsahna houbuh chunga mopohna anei dingu ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin hitichun Israel chate chun Pakaiyin Mosi athupeh jouse dungjui chun abol taovin ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi le Aaron jah-a thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate jouse chun apu apateu insung melchihna kom, aponlap kom cheh uva pon in akison cheh dingu; amahon houkhom ho houbuh-a kona gamlatah-a pon in chu akison dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nisa hung sodoh na solam sanga chu ajanelu kihop khen dungjuija Judah le ajanel hon gebuh ason dingu ahi: chule Amminadab chapa Nahshon chu Judah chate chunga gal lamkai hiding ahin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomsagi le sangli toh jagup ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule ama banna gebuh kison dinga chu Issachar phung hiding: chule Zuar chapa Nethanel chu Issachar chate chunga gal lamkaija pangding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomnga le sangli toh jali ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujoule Zebulun phung hintin: chule Helon chapa Eliab chu Zebulun chate chunga gal lamkaija pang ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ami janel, jatnu kisimdoh chengse chu sangsomsagi le sangli toh jali ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Judah gebuh-a kisimdoh chengse chu, sangjakhat le sangsomget le sanggup toh jali ahi. Amahohi kipatdoh masadiu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule noilam sanga chu ajanelu kihop khen dungjuija Reuben le ajanel hon gebuh ason dingu ahi: chule Shedeur chapa Elizur chu Reuben chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomli le sanggup toh janga ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ama koma gebuh kisonho chu Simeon phung hiding ahi: chule Zurishaddai chapa Shelumiel chu Simeon chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomnga le sangko toh jathum ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chubanna chu Gad phung hiding: chule Deuel chapa Eliasaph chu Gad chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomli le sanga toh jagup le somnga ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Reuben gebuh sunga kisimdoh chengse chu sangjakhat le sangsomnga le sangkhat toh jali le somnga ahi, chule amaho chu agolni chana kipatdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuteng houkhom ho houbuh chu gebuh lailunga Levi ho gebuh chutoh kitoldoh thading; amitakip amun cheh-a aponlap-u dungjuija, aponbuh-u ason bang banguva chu kitol dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule lhumlam sanga chu ajanelu kihop khen dungjuija Reuben le ajanel hon gebuh ason dingu ahi: chule Ephraim chate chunga gal lamkai ding chu Ammihud chapa Elishama hiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomli le janga ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule akoma chu Manasseh phung hiding: chule Pedahzur chapa Gamaliel chu Manasseh chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomthum le sangni toh jani ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chubanna chun Benjamin phung hintin: chule Gedeoni chapa Abidan chu Benjamin chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomthum le sangnga toh jali ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Ephraim gebuh sunga kisimdoh chengse chu sangjakhat toh sangget toh jakhat ahi. Chule amaho chu malam no-a agolthum channa-a chedingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Dan le ajanel ho gebuh chu ajanelu kihop khen dungjuija sahlam sanga umding ahi: chule Ammishaddai chapa Ahiezer chu Dan chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomgup le sangni toh jasagi ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule akoma gebuh kison dinga chu Asher phung hiding: chule Ocran chapa Pagiel chu Asher chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomli le sangkhat toh janga ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chubanna chun Naphtali phung hintin: Enan chapa Ahira chu Naphtali chate chunga gal lamkai hiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule ami janel, ajatnu kisimdoh chengse chu sangsomnga le sangthum toh jali ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Dan gebuh-a kisimdoh jouse chu sangjakhat le sangsomnga le sangsagi toh jagup ahi. Chule amaho chu aponlap utoh anunung pena cheding ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule hichengse hi Israel chate lah-a apu apateu insung dungjuija kisimdoh chu ahi: agebuh uva ajanel pumpiu akisimdoh chengse chu abonchang keijin sangjagup leh sangthum to janga le somnga ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahivangin Pakaiyin Mosi athupeh bangin, Levi ho chu Israel chate lah-a chun akisimtha pon ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chutichun Israel chaten Pakaiyin Mosi athupeh bang chun abol taovin; aponlap kom cheh uva pon in akisonun, amaho insung kailhah dungjui cheh le apu apateu insung dungjui cheh-in malama akitolun ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichehohi Pakaiyin Sinai molsanga Mosi henga thu anasei nikho-a Mosi le Aaron chilhah ho chu ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hicheho hi Aaron chapate min chu ahi: apeng masapen Nadab, chule Abihu, Eleazer chule Ithamar ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichehohi thempu natohna-a lhacha natoh tong dinga aman akatdoh, thempu dinga thao kinu Aaron chapate ho min chu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Nadab le Abihu chu Sinai gamthipma Pakai masanga dan ngailouva gimnamtui ahalpet lhonin, Pakai angsunga athi lhontan, chule amanin cha aneilhon pon ahi: chule Eleazer le Ithamar chun apao Aaron mitmun thempu natohna lhachana chu atong lhontan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="6" style="v" />Levi phung chu hinpui naijin lang, amahon ama henga lhacha na atohtheina diuvin Aaron thempu masanga hinpui lutnin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amahon houbuh lhacha natoh nadinga, houkhom ho houbuh maija chu ama le houkhom pumpiho kin aboldingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amahon houbuh lhacha natohna dinga, houkhom ho houbuh manchah jouse achin uva, Israel chate jouse tohding kin chanchu atoh dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nangman Levi mite chu Aaron le achapate henga napehdoh ding ahi: amaho chu Israel chate lah-a kona apumpiuva ahenga dinga pehdoh ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangman Aaron le achapate chu thempu-a napan sah-a, chule amahon thempu tohmun chu angatup diu: chule hetkhahlou mi ahung naija aumle kithat ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule keima, ven, keiman Israel chate lah-a naobu phukeh-a apeng masaho jouse khela Levi mitehi Israel lah-a kona kalahdoh ahitai: hijeh chun Levi mite chu keija hidingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu apengmasa jouse chu keija ahi; ijeh inem itile keiman Egypt gama apengmasa jouse katha nikho-a chu, Israelte lah-a apengmasa jouse mihem hihen gancha hijongle keima-a dinga kana suhtheng ahitai: amaho keija hiding ahiuve: keima Pakai chu kahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Sinai gamthipma chun Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="15" style="v" />Levi chateho jouse a-inko kou-a, apu apateu insung kailhah dungjuija, pasal takip lhakhatna pat chunglamse nasim ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Mosi'n Pakaiyin athupeh bangin amaho chu asimtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hicheho hi aminu dungjuija Levi chapate chu ahiuvin; Gershon, Kohath, chule Merari ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiche hohi a-inkou dungjuijin Gershon chapate ahiuve; Libni chule Shimei ahilhone.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule a-insungu dungjuija Kohath chapate chu; Amram, Izehar, Hebron, chule Uzziel ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule a-inkou dungjuija Merari chapate chu; Mahli chule Mushi ahiuve. Apu pateu insung kailhah dungjuija hiche hohi Levi insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gershon'a kon hochu Libni insung mite le Shim insung mite ahiuvin; amaho hi Gershon insung miho chu ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amaho-a kon kisimdoh, pasal jouse kisim dungjuija lhakhat napat achunglam akisimdoh ho chu sangsagi le janga ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gershon insung mite chun houbuh tomlam, lhumlam sanga houbuh akisondiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Gershon insung mite pipuding chu Lael chapa Eliasaph hiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Gershon le achapaten houkhom ho houbuh sunga atohdiu chu houbuh, ponbuh, chule achung khuna, houkhom ho houbuh kotna khai ding ponjal,
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule inhong sunga kikhai pondal ho, houbuh koma umle maicham kimvella um inhong kotna ding pondal, chule akhaoho jouse le hichea pangthei jouse chu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Kohath insungmiho chu Amram insungmi, Izehar insungmi, Hebron insungmi, chule Uzziel insungmi ahiuve: hichenghi Kohath insungmi ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Muntheng vetup ding mi pasal lhakhat napat achunglamse akisim doh sangget le jagup ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kohath chapateho insungmi chun houbuh pang lhanglam sanga chu pon in akisondiu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kohath chilhah insung mite pipupen ding chu Uzziel chapa Elizaphan hiding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule amopoh diu chu Pathen thingkhong, dokhang, meivah khom, maicham ho, akin bolnadiu munthenga sumlheng ho, pondal, chule chua kin kibolding jouse chu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Aaron thempupa chapa Eleazar chu Levi ho pipuiho chunga pipui pen hiding, chule muntheng vetupma pangho vesuile hiding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Merari'a kon hochu Mahli insungmite le Mushi insungmite ahiuvin; hichengse hi Merari insungmi ho ahiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule amaho-a kon kisimdoh, pasal jouse kisim dungjuija lhakhat napat achunglam akisimdoh ho chu sang gupto jani ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Merari chilhahte insung pipupen chu Abihail chapa Zuriel ahi; hicheho hin houbuh pang sahlam sanga chu pon in akison dingu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Merari chapate vetup dinga kinganse chu houbuh thingpeh ho, chua kimang banggol ho, akhomho, akhom tunnaho, sumlheng ho, chule hicheho to kisai thil jouse,
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule ahongsung kimvella akhomho, akhom tunnaho, akilbeh naho leh akhaojangho chu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahinla solam sanga Houbuh maija, houkhom ho houbuh mai tah-a solam sanga ponbuh song ding chu Mosi le Aaron chule achapateho hiding, Israel chatehoa dinga muntheng mopohna chu atohdiu ahi; chule midang akom naija hung aumleh thajeng ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Pakai thupeh-a Mosi le Aaron'in asimdoh lhon Levi mite akisimdoh jouse chu, a-inko pumpiuva, pasal lhakhatna pat chunglam jouse chu sangsomni le sangni ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Pakaiyin Mosi henga, Israel chate apengmasa pasal jouse lhakhat napat chunglam jouse simdoh inlang, aminhou jatchu simdoh-in.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule nangman Levi mite chu keija dinga Israel chate apeng masaho jouse khella nalahding, (keima Pakai kahi); chule Israel chate gancha apengmasa jouse khela Levi mite gancha chu nalah ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Mosi'n Pakai thupeh bangin Israel achate lah-a apengmasa ho jouse chu asimdohtan ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule apengmasa pasal jouse min kisim dungjuijin lhakhatna pat achunglam jouse chu sangsomni le sangni toh jani le somsagi le thum ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="45" style="v" />Israel chate lah-a apengmasa jouse khelin Levi mite, aganchaho khellin Levi mite ganchaho lan; chule Levi mite chu keija hidingu ahi: Keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule lhatdoh-a umding Israel chate apengmasa Levi miho sanga jani le somsagi le thuma tamho chu;
  </para>
  <para style="p">
    <verse number="47" style="v" />Nangman mikhat na Shekel nga cheh, munthenga shekel kila dungjuija nalahding ahin; (Shekel khat chu gerah somni ahi.)
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule nangman sum chu avalho lhatdohna dinga Aaron le achapate napehding ahi, ati.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin Levi mite sanga tamjoho kilhatdohna ding sum chu Mosi'n alatan ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Munthenga shekel dungjuijin Israel chate apengmasa ho-a konin aman sum shekel sangkhat le jathum le somgup le nga alatan ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin Pakaiyin Mosi athupeh bangin, Mosi'n lhatdamna sum chu Pakai thu dungjuijin Aaron le chapate apetan ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi le Aaron henga asejin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kohath chapate mijat chu Levi chapaho lah-a kon le a-insung chule apu apateo insung dungjuijin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Kum somthuma lhah chunglam kum somnga gei houkhom ho houbuh sunga natohna tongdinga pangthei nalai jouse chu simdoh lhonnin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichehi houkhom ho houbuh sunga Kohath chapaten thiltheng chungnung penho chungchanga atohdiu kin chu hiding ahi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Houbuh chu akichondoh ding tengle, Aaron le achapate chu hunguva muntheng chungnunga kikhai pondal chu aloilhah uva, hettohsahna thingkhong chu akhukhum dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hichu satwilut vuna akhu khumuva, chule apumpia chu pondum khat akhukhum diu, chutengle ajolho chu athollut dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule vetsahna changlhah dokhang chunga chu pondum khat apha uva, chule hiche achunga chu kongho, thihkheho, sum lhengho, chule asinna ding asinho akoi dingu: chule tanglouhela kikoijing changlhah chu chuche chunga umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amahon hicheho chunga chu ponsanthip khat aphadiu, chule hichemama chu satuilut vunho-a akhukhum muva, chule ajolho chu athollut dingu ahi..
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amahon pondum khat alah uva alhacha natoh naova kimangcha meivah khom le athaomei, avutloho, akongho, chule chua um athaobelho jouse chu akhukhum diu:
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amahon hiche chu le umle belho jouse chu satuilut vunho-a akhukhum uva, ajol chunga chu akoidiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule sana maicham chung chu pondum khat na akhu khumuva, hichu satuilut vun khuna-a akhudiu, chule ajolho chu avodiu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amahon munthenga akin bolnaova kinbolna manchaho jouse chu pondum khatna akoijuva, satuilut vun khuna akhudiu, chule moljol chunga akoidiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule amahon maichama kona vut hochu alahdoh uva, chule achunga ponsandup khat apha diu:
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hiche chunga chu amahon kinbolna-a amanchah-u umle belho jouse, gimnamtui halnaho, sathuhna thihkhe kaho, vutloho, twibel ho, chule maichama um thiljouse chu satuilut vun khuna ho-a akhuva, moljol ho avodiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule houbuh chu akichondohna dinga, Aaron le achapaten muntheng le asunga um le bel jouse akhukhum jou tengule; Kohath chapate chu apudinga hungdiu: amavang amahon athilouna dinguva thiltheng tapou chu atohkhah loudiu ahi. Hichehohi houkhom ho houbuh-a Kohath chapate pohding chu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Aaron thempupa chapa Eleazar tohding chu; meija vahding thao, gimnamtui, nitin anneh thilto, nuding thao, chule houbuh pumpi leh asunga um jouse, munthenga thil umjouse le chua um le bel ho jouse vetsui ding chu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakaiyin Mosi le Aaron henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="18" style="v" />Levi miho lah-a konin Kohath phung insungmite chu paidoh lhon hih-in;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla amahon thiltheng chung nungho anaitengule thilouva ahinthei nadinguva hitia hi nabolpeh lhon ding ahi. Aaron le achapate chu lutnuntin, atohdiu kin le apohdiu cheh agotpeh diu:
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang thilthengho akikhukhum pet teng, athilouna diuva avedinga lutlou diu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="22" style="v" />Gershon chapate mijat chu apu apateo insung pumpi le a-insungu dungjuijin simdoh-in;
  </para>
  <para style="p">
    <verse number="23" style="v" />Lhacha kin bola lutna, houkhom ho houbuh sunga natohna tongthei jouse chu kum somthuma lhah chunglam kum somnga gei jouse chu nasimdoh ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kinbol le pohgih pohna lam hi Gershon insung mite tohding kin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amahon houbuh pondal ho, houkhom ho houbuh, achung khuna, achunga um satuilut vun chung khuna, chule houkhom ho houbuh kotna kikhai pondal,
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule inhong sunga pondal ho, houbuh kom le maicham kimvela um inhongsung kotpi kotkhah-a pondal kikhaiho, akhaoho, chule akinbol naova manchah jouse le amaho dinga kisem jouse chu apohdiu ahi. Hitia chu amahon kin chu aboldiu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gershon chapate natoh jouse, apohdiu jouse le akinboldiu jouse chu Aaron le achapate thupeh-a kona aboldingu ahi: chule nangman apohdiu jouse-a dinga thuneina napehding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche hi Gershon insung chapatehon houbuh sunga atohdiu kin chu ahi. Chule amaho natoh jouse chu Aaron thempupa chapa Ithamar mopohna noija umding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari chapate chu ahile, a-insung hou le apu apateo insung kailhah dungjuija nasimding;
  </para>
  <para style="p">
    <verse number="30" style="v" />Kum somthuma pat chunglam kum somnga gei, houkhom ho houbuh sunga natong dinga, kinbolna-a lutsese chu nasimding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule amaho mopohna chu hichehi hiding ahi; houkhom ho houbuh sunga anatohnao dungjuija, houbuh thingpehho, chua um banggol ho, akhompiho, akhom tunnaho,
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule ahongsung kimvela khompiho, akhom tunnaho, akilnaho leh akhaoho, amanchahho jouse pum leh anatohna hou jouse toh pohding ahin; amin cheh uva apoh diu manchah cheh chu nagonpeh ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hichehi Aaron thempu chapa Ithamar khut noija houkhom ho houbuh sunga akin jouseu dungjuija Merari chapate insung tohding kin chu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Mosi le Aaron chule houkhom pipuihon Kohath chapate chu a-insungu dungjui le apu apateo insung kailhah dungjuijin asimtaovin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Kum somthuma pat chunglam kum somnga gei houkhom ho houbuh sunga natong dinga, kinbolna-a lutsese chu,
  </para>
  <para style="p">
    <verse number="36" style="v" />Amaho insung kailhah cheh-a kisimdoh-a chu sangni le jasagi toh somnga ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hiche hohi Pakaiyin Mosi khutna kona athupeh dungjuija Mosi le Aaron'in Kohath insungmi teho jouse houkhom ho houbuh sunga kin natong dinga asimdoh lhon chu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Gershon chapateho a-insung pumpiu, apu apateu insung kailhah dungjuija kisimdoh ho,
  </para>
  <para style="p">
    <verse number="39" style="v" />Kum somthuma pat chunglam kum somnga gei, houkhom ho houbuh sunga natong dinga kinbolna-a lutsese chu,
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuti chun a-insungu pumpi le apu apateu insung kailhah-a kona kisimdoh chu sangni le jagup toh somthum ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hichengse hi Gershon chapate insungho-a houkhom ho houbuh sunga kinbolna jouse-a natongthei cheh dinga Mosi le Aaron'in Pakai thupeh dungjuija asimdoh lhon chu ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule Merari chapate insung, apu apateu insung kailhah dungjuija a-insung pumpiu kisimdoh ho chu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kum somthuma pat chunglam kum somnga gei houkhom ho houbuh sunga natong dinga, kinbolna-a lutsese chu,
  </para>
  <para style="p">
    <verse number="44" style="v" />Hitichun a-insungu dungjuija kisimdoh chengse chu sangthum le jani ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hichengse hi Pakaiyin Mosi khutna kona athupeh dungjuija Mosi le Aaron'in Merari chapate insung anasimdoh lhon chengse chu ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mosi, Aaron chule Israel lamkai pipuihon a-insungu dungjui, apu apateu insung kailhah dungjui cheh-a anasimdoh hou chengse chu,
  </para>
  <para style="p">
    <verse number="47" style="v" />Kum somthuma lhah chunglam kum somnga gei, kinbolna lhacha natohna le houkhom ho houbuh sunga lhacha kinbona dinga hungchan chu,
  </para>
  <para style="p">
    <verse number="48" style="v" />Hitia amahoa kona kisimdoh jouse chu sang get le janga toh somget ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Pakai thupeh dungjuijin Mosi khutna konin amitakip chu atohdiu kin dungjui cheh leh apohdiu dungjui cheh-in asimdoh un, hitichun Pakaiyin Mosi anathupeh bangin amaho chu asimdoh tan ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Miphah takip, athilong takip le, thilonga suboh chan chu ponbuh polama anodoh nadiuvin Israel chate thu pen:
  </para>
  <para style="p">
    <verse number="3" style="v" />Alaitah-a ka chenna aponbuh hou asuhboh louna diuva, nangma pasal le numei agoma nanodoh-a, ponbuh polama nakoidoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Israel chaten chutichun abolun, amaho chu ponbuh polama akoitaove. Pakaiyin Mosi jah-a anasei bang chun Israel chaten aboltauvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin Mosi jah-a thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel chate jah-a seipeh in, Pasal ahiloule numei khattouvin Pakai douna-a mihemin abolji chonset itobang hijongle abol tengle, hitobang mi chu themmo changa ahin,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chutengle amahon achonset bolu chu aphondoh dingu, chule aman asuhkhelna chu lhingsetna aledit ding, hichea chu hopnga-a hopkhat abe-a, anasuhkhelna pa chu apehding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla asuhkhel ditdohna ding mipa chu inko neilou ahile, asuhkhelna chu Pakai hengle thempu heng ngeija ledit hen; longlhenna kelngoichal simlouva, ama dinga longlhenna khat semding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Israel chatehon thempu henga ahinchoi ju ahintou thiltheng hou jouse chu ama-a hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amitakip thilto kisuthengho chu ama-a hiding; itobang hile mi khattouvin thempupa apeh tapou chu, ama-a hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel chate jah-a seipeh in lang hitihin tin, Pasal khattou aji ajammanga, amapa douna-a suhkhel abola,
  </para>
  <para style="p">
    <verse number="13" style="v" />Pasal khattou amanutoh alup khoma, hichu ajipa mitmu-a kona akisel manga, aki-imchah-a, chule amanu akisuhboh-a, amanu chunga ahetoh aumlouva, chule amanu matdoh ahilouva;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amapa chunga thangthipna lhagao achuh-a, akisuboh-a a-inneipi chu athang thippi khah tah-a; ahiloule amapa chunga thangthipna lhagao achuh-a, ana kisubohlou a-inneipi chu athang thippi khah tah-a ahile;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuteng mipa chun a-inneipi chu thempupa henga apuiding, amanu dinga thilpeh suhlou chang anneh ephah hopsom ma hopkhat ahinchoi ding; amapan achunga thao asunlou ding, bego jong akoilou ding ahi; ajehchu hichehi thangthip thilpeh, hetjingna thilpeh le, khanset geldoh jingna thilpeh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule thempupa chun amanu chu akom naija apuilutna, Pakai masanga adinsah ding:
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule thempupa chun twitheng leibela ahindopma; houbuh lhonga leivui chu alah-a, twilah-a chu alhahlut ding;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule thempupa chun numeinu chu Pakai anga adinsah-a, asam alhaplhah peh-a, akhutna chu thangthipna thilpeh, hetjingna thilto chu akoi ding: chule thempupa chun akhutna sapset konsah twikha chu akidop ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle thempun amanu kihahsel sah-a, amanu jah-a chu, Koimachan naluppi louva, na-inneipu khela midangtoh thanhoi na-a navamang lou ahile, hiche sapset konsah twikha-a konhin ongtholin:
  </para>
  <para style="p">
    <verse number="20" style="v" />Amavang na-inneipu khela midang henga vahmanga, nakisuh boh-a, chule na inneipu tailou midang khattouvin naluppi-a ahileh:
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutengle thempupa chun numeinu chu sapsetna kitepna khatna akitepsah-a, chule thempu chun numeinu jah-a, Pakaiyin napheipi amonsah-a, chule na-oipi apohsah tengle, Pakaiyin namite lah-a nangma gaosap le hahselna nachansah hen;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hiche sapset kona twihin na-oipi pohsah ding le napheipi monsah dinga na-oipi sunga lutding ahi, atiding; chule numeinu chun Amen, Amen, atiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule thempupa chun hiche sapsetna hochu lekhabu khatna ajihlutna, chule aman hicheho chu twikha-a chu asoplhah ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule aman numeinu chu sapset konsah twikha chu adonsah ding, chule sapset konsah twi chu amanu sunga lutna hungkha ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujouteng thempu chun thangthipna thilpeh chu numeinu khutna kona alah-a, thilto chu Pakai masanga ajapma, maicham chunga ato ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule thempu chun thil kitohdoh, hetjingna ngeitah chu khutdim khat achoija, maicham chunga ahalvam ding, chujou tengle aman numeinu chu adonsah ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule aman amanu chu twi adonsah tengle hitiding ahi, hichu, amanu kisuboh ahia, a-inneipu douna-a suhkhel nei ahile, sapset konsah twi chu asunga lutna, hungkha-a, a-oipi hungpoma, chuleh apheipi hungmon lhading: chuleh numeinu chu amite lah-a sapset chang hitading ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahinla numeinu chu akisuhboh lou ahi-a, athensel ahivangle; amanu chu ongthola, son le pah aneiding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichehi inneipi khat a-inneipu khela michom henga achea akisuboh tenga dinga thangthipna dan ahin,
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahiloule ama chunga thangthipna lhagao ahung uma, ajinu chunga thangthipna nei ahile, numeinu chu Pakai masanga adinsah ding, thempupa chun amanu chunga hiche dan jousehi atoh bulhit ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chutengle mipa chu khangitlouna-a kona ongthola, numeinu chun ama khangitlouna chu akipoh ding ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate lah-a seipeh-in lang, ajah uva, Pasal ahiloule numei Pakaiya dinga atumbeh hiding, Nazir mikhat hina dinga kitepna-a kitep dinga akichomkhen tengule;
  </para>
  <para style="p">
    <verse number="3" style="v" />Amachu ju le khamna theija kona kikangse ding, juthuh ahiloule khamnathei juthuh adonlou ding, lengpiga ju tapou hijongle adonlou ding, chule lengpiga athah hihen alui hijongle anehlou ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Akichom khenna nikhoho jouse-a chu lengpiguija kona kisem, amuho-a patna ahoh changeija kisem ipi hijongle anehlou ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Akichom khenna akitepna nikhoho jouse-a chu aluchanga samchem chulouding ahi. Chule Pakaiya dinga akipehdohna nikhoho abulhit masangse-a ama chu atheng hiding, chule alua asamlom jong akhansah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakaiya dinga akichom khenna nikhoho sungse-a chu aman mithilong anailou ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman apa ham, anuham, asopipa ham ahiloule asopinu ham athi tengle, amale ama kisuboh louding ahi; ajehchu a-Pathen suhthengna chu aluchanga uma ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akichom khenna nikhoho sungse-a chu ama Pakaiya dinga atheng ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin mikhattou akoma photlotna athi jeng tah-a, Pathen'a akipeh thengna aluchu abohtah-a ahile, akisuhtheng nikho nile alu ahettol ding, anisagi nile ahettol ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule aniget lhin nile aman houkhom ho houbuh kotbula thempu henga chu vakhu nou ni ahiloule vapal nou ni ahinchoi ding;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule thempupa chun khatchu chonset thilto-a ato-a, chule khat chu govam thilto-a atoding, chule amadinga chu longlhena abolding ahi; ajehchu mithilong jeh-a achonsea ahin, chule hiche nima ma-a chu aman alu akisuhtheng ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule akichomkhena nikho hochu Pakai henga suhthengna dinga, kumkhat lhingsa kelngoinou chal khat suhkhel thilto-a dinga ahinkai ding ahi. Amavang akichom khenna abohtah jeh-a chu amasanga nikhoho chu moh hiding ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hichehi Nazir mikhatnin akichom khenna nikhoho alhin teng abolding dan chu ahi: amachu kimutona houkhom ho houbuh kotna chu hung kipui ding:
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule aman Pakai henga govam thilto-a todinga kumkhat lhingsa nolnabei kelngoinou chal khat, chonset thilto-a dinga kumkhat lhingsa nolnabei kelngoinou chal khat, chule chamna thilto-a dinga kumkhat lhingsa nolnabei kelngoinou chal khat apehding,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule cholsolou changlhah pocha khat, thao toh kihal changbong neljet changlhah phengkhat, thao kinu-a pasetna kisem cholsolou changlhah khat toh, anneh thilto le donding thilto apehding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule thempu pan hicheho chu Pakai masanga ahinchoi ding, chule aman chonset thilto le govam thilto chu atoding:
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman kelngoichal chu Pakai anga chamna ganlhaina thilto-a dinga cholsolou changlhah pocha khattoh atoding: Thempu pa chun a-anneh thilto le adon thilto jong atoding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Nazir mi chun houkhom ho houbuh kotna chu akichom khenna lu chu akivoding, chule akichom khenna melchihna asam chu alah-a, hichu gan lhaina chamna thilto ho noija um meisunga aselut ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule thempu pa chun akihonminsa kelngoichal chu adah khatle pocha-a cholsolou changlhah lum khat, chule cholsolou changlhah paset khat alah-a, hicheho chu akichom khenna sam avojou tengle Nazir pa khutna apehding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule thempu pa chun hicheho chu Pakai anga jap thilto-a dinga ajapding ahi: hiche hi le jap thilto-a dinga kitoh a-om le amal chu thempu-a dinga atheng ahi. Chujouteng lehin Nazir mi chun lengpitwi adonthei ding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichehi akitepma Nazir mi-a dinga dan le, akhutnin aphal dungjuija apeh ho simlouva, akichom khenna-a dinga Pakai henga athilpeh ding chu ahi: kitepna-a akitep banga chu akichom khenna dan dungjuija aboltei ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="23" style="v" />Aaron le achapate jah-a chun hin seijin, Hiche dungjuija hi Israel chate chu phatthei naboh uva, ahenguva hitia nasei dingu ahi,
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakaiyin nangma phatthei naboh henlang, naching jinghen,
  </para>
  <para style="p">
    <verse number="25" style="v" />Pakaiyin nachunga amai vahsah henlang, nachunga lungsetna neijinghen,
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakaiyin nachunga amai hinlah henlang, chamna napejing hen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutia chu amahon Israel chate chunga kamin akoidiu; chule keiman amaho phatthei kabohding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi'n Houbuh lhingsetna atundoh-a, thao anua, chule asuh thenga, asunga um amanchah jouse, maicham le um le bel ho jouse toh agoma thao anua asuhtheng phatnin, ahitin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phungho pipui, akisimdoh saho chunga lamkai, Israel pipui ho, apu apateu insunga aluchangho chun thilpeh aneijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amahon athilto hou; kangtalai innei gup le bongchal somleni hochu Pakai anga ahinchoijun; kangtalai khat chu pipui ni-a ding, chule bongchal khat chu mikhat cheh-a ding ahin: chule amahon hichu houbuh maija ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiche hohi houkhom ho houbuh kinbol na-a manchah dingin amaho-a konin lanlang, amitakip ama ama tohding kin dungjui cheh-in Levi ho chu pen, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n kangtalai hole bongchal ho chu alan Levi ho apetan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kangtalai ni le bongchal li chu Gershon chapateho atohdiu kin dungjui cheh-in apen:
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule kangtalai li le bongchal get chu Aaron thempupa chapa Ithamar khut noija um Marari chapateho chu atohdiu kin dungjui cheh-in apen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahin aman Kohath chapateho chu imacha apepon ahi; ajehchu amahon alengkou uva aput tho uchu munthenga atohdingu kin chu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin pipui hon thao kinu nikho chun maicham katdohna-a dingin thilto aneijun; hitichun pipuiho jengin jong maicham maija chun thilto aneijun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Mosi henga, maicham katdohna-a dinga chu pipui khat cheh-in ama ama nikho-a athilto dingu chu apeh cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anikho masapen ni-a thilpeh pe-a chu Juda phunga Aminadab chapa Nahshon ahin:
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama thilpeh chu muntheng shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin; aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="15" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="16" style="v" />Chonset thilto-a ding kelchaho nou khat:
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Aminadab chapa Nahshon thilto ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anini lhin nin Issachar pipu Zuar chapa Nathaneel chun thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman athilto-a dingin munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat atoh-in: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="21" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="22" style="v" />Chonset thilto-a ding kelchaho nou khat,
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Zuar chapa Nathaneel thilto ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anithum lhin nin Zebulun chate pipu Helon chapa Elia'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="27" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="28" style="v" />Chonset thilto-a ding kelchaho nou khat,
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Helon chapa Elia thilto ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anili lhin nin Reuben chate pipui Shedeur chapa Elizur'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="33" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="34" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Shedeur chapa Elizur thilto ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ani nga lhin nin Simeon chate pipu Zurishaddai chapa Shelumiel'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="39" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="40" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Zurishaddai chapa Shelumiel thilto ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Anigup lhin nin Gad chate pipu Deuel chapa Eliasaph'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="45" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="46" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Deuel chapa Eliasaph thilto ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Anisagi lhin nin Ephraim chate pipu Amihud chapa Elishama'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="51" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="52" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="53" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Amihud chapa Elishama thilto ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Niget lhin nin Manasseh chate pipu Pedahzur chapa Gamaliel'in thilto abolin ahi:
  </para>
  <para style="p">
    <verse number="55" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi:
  </para>
  <para style="p">
    <verse number="56" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="57" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="58" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="59" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichengpi hi Pedahzur chapa Gamaliel thilto ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Aniko lhin nin Benjamin chate pipu Gideoni chapa Abidan'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="63" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="64" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="65" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Gideoni chapa Abidan thilpeh ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Anisom lhin nin Dan chate pipu Amishaddai chapa Ahiezer'in thilto apen ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="69" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="70" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="71" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Amishaddai chapa Ahiezer thilto ahi.
  </para>
  <para style="p">
    <verse number="72" style="v" />Nisom le khat lhin nin Aser chate pipu Ocran chapa Pagiel'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="73" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="74" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="75" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="76" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="77" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hichenghi Ocran chapa Pagiel thilto ahi.
  </para>
  <para style="p">
    <verse number="78" style="v" />Anisom le ni lhin nin Naphtali chate pipu Enan chapa Ahira'in thilto abolin ahi.
  </para>
  <para style="p">
    <verse number="79" style="v" />Ama thilto chu munthenga shekel dungjuija shekel jakhat le somthuma gih dangka kongtong khat, shekel somsagi-a gih dangka sumlheng khat ahin: aninia chu anneh thilpeh-a ding changbong neljet thao toh kihal dimset cheh ahi.
  </para>
  <para style="p">
    <verse number="80" style="v" />Gimnamtui dimset shekel soma gih sana thihkhe khat:
  </para>
  <para style="p">
    <verse number="81" style="v" />Govam thilto-a ding bongchal nou khat, kelngoichal khat, kumkhat lhingbep kelngoinou khat:
  </para>
  <para style="p">
    <verse number="82" style="v" />Chonset thilto-a ding kelchaho nou khat;
  </para>
  <para style="p">
    <verse number="83" style="v" />Chule chamna ganlhaina thilto-a ding bongchal ni, kelngoichal nga, kelchal nga, kumkhat lhingbep kelngoinou nga ahi: hicheng hi Enan chapa Ahira thilto ahi.
  </para>
  <para style="p">
    <verse number="84" style="v" />Hichehi Israel pipuhon thao anu nikhouva maicham kithensona chu ahi: dangka kongtong somleni, dangka sumlheng somleni toh, sana thihkhe somleni ahi.
  </para>
  <para style="p">
    <verse number="85" style="v" />Dangka kongtong ho chu shekel jakhat le somthum cheh-a gih ahin, sumlheng ho chu shekel somsagi cheh-a gih ahi. Dangka um le bel jouse chu muntheng shekel dungjuia shekel sangni le jali gih ahi.
  </para>
  <para style="p">
    <verse number="86" style="v" />Gimnamtui dimset sana thihkhe chu somleni ahin, munthenga shekel dungjuijin shekel som gih cheh ahi. Thihkhe-a sana ho jouse gihdan chu shekel jakhat le somni ahi.
  </para>
  <para style="p">
    <verse number="87" style="v" />Govam thilto dinga bongchal jouse chu bongchal somnileli, kelngoichal somgup, kumkhat lhingbep kelngoinou somgup, an neh thilpeh jouse toh; chule chonset thilto-a ding kelchaho nou chu somleni ahi.
  </para>
  <para style="p">
    <verse number="88" style="v" />Chule chamna ganlhai thilto-a ding bongchal jouse chu bongchal somnileli, kelngoichal somgup, kelchal somgup, kumkhat lhingbep kelngoinou somgup ahi. Hichehi thao akinu jouva maicham thensona chu ahi.
  </para>
  <para style="p">
    <verse number="89" style="v" />Chuin Mosi Ama toh kihou dinga houkhom ho houbuh sunga alutphatnin, Cherub teni kikah-a, hettohsahna thingkhong chunga hepi touna-a kon ahenga thu kisei aw khat ajan, chuin ama koma chun thu aseitan ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aaron jah-a thu seijin lang, Nangman meivah navah tengle, meivah sagi chun meivah khom masangtah chu asalvah ding ahi, tin seijin ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Aaron'in hitichun abolin, Pakaiyin Mosi athupeh bangchun meivah ho chu meivah khom masanga avahtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche meivah khom kisem dan chu sana kikheng ahin, akhom topala pat apah geichu akikheng ahi: Pakaiyin Mosi anavetsah dan bang bang chun, aman meivah khom chu asemin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel chate lah-a konin Levi ho chu lhengdoh inlang amaho chu suthengin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amaho suhthenga aumna diuva hitia hi nabolding ahi: achunguva suhthengna twi chu thekhumin lang, amahon atipum piuva amul jouseu chu avolhah diu, chule aponsilu akisop uva, hitia chu amaho kisuhtheng dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutengle amaho chun bongchalgol khat le anneh thilto, thao toh kihal changbong neljet ngei chu kilah-uhen, chule nangman bongchalgol dang khat chonset thilto dinga nalah ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nangman Levi ho chu houkhom ho houbuh maija nahinpui ding: chule Israel chate khoppi pumpi chu nakhop khom sohkei ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangman Levi ho chu Pakai anga nahin puija, chule Israel chaten amaho chunga chu akhut angap dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pakai lhacha na atoh doh theina dinguva, Aaron'in Levi ho chu Israel chate-a kon thilto khat banga Pakai angsunga atodoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Levi hon akhutnu chu bongchal teni luchunga angapdiu; chule nangman Levi ho longlhenna dinga bongchal khat chu chonset thilto-a dinga nato-a, chule khatpa chu govam thilto-a dinga nato ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nangman Levi ho chu Aaron le achapate masanga natousah-a, amaho chu Pakai henga thilto banga natodoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hitia chu Levi hochu Israel chate lah-a kona nakhendoh ding: chule Levi ho chu keija hiding ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujou tengle Levi ho chu houkhom ho houbuh lhacha natong dinga lutdiu: chule nangin amaho chu nasuh thenga, thilto khat banga natodoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu amaho apumpiuva Israel chate lah-a kona keima eikipe ahitan; naobu takip phukeh ho jouse khel, apeng masa jouse khela keiman amaho keija dinga kana kilah ahitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu Israel chate lah-a kon apeng masa jouse mihem hihen lang, gancha hile keija ahi. Keiman Egypt gama apeng masa jouse kathagam nikho-a chu amahohi keija dinga kasuhtheng ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule keiman Levi hohi Israel chate apeng masa ho jouse khela kalah ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Israel chaten muntheng ahinnai tengule, Israel chate lah-a hise umlouna dinga; keiman Levi ho hi Israel chate lah-a kona Aaron le achapate henga houkhom ho houbuh-a Israel chate lhacha natong ding le Israel chate-a dinga longlhenna boldinga thilpeh banga kapeh ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosi le Aaron chule Israel chate houkhom ho jouse chun Levi mite chungchanga Pakaiyin Mosi athupeh jouse bangin Levi ho chunga chun abolun, Israel chate chun amaho chunga chutichun abol taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Levi miho akisuthengun, avonhou akisop thengun; Aaron'in amaho chu Pakai angsunga thilto bangin atoh doh-in; chule Aaron'in amaho suhtheng nadingin longlhenna abolpeh tan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin hiche jou chun Levi miho chu houkhom ho houbuh sunga Aaron le achapate masanga lhacha natong dingin alut taovin ahi: Pakaiyin Levi ho chung changa Mosi athupeh bangin, amahon hitichun achunguva abol taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche hi Levi mite thudol ahi: kum somni le nga-a lhah chunglamse houkhom ho houbuh-a sunga lhacha natong dinga lutdiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule kumsom nga alhin tengule lhacha natohna-a kona kicholdodiu, atohbe loudiu ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijongle houkhom ho houbuh-a chu asopi hotoh ngaichat ahinaova lhachana atoh khomdiu, amavang lhacha kin abol loudiu ahi. Hitia chu Levi miho chu atohdiu nagonpeh ding ahi, ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Egypt gama kona ahung potdoh nungu kumni lhinna, lha masapen-in Pakaiyin Sinai gamthipma Mosi henga aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chaten akitep phat dungjuijin kalchuh kut mang jingu hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche lha nisom le nili ni, nilhah lam, akitep phat tah-a hi naman dingu; chondan kisun jouse le akibolding dan jouse dunjuija naman dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi'n Israel chate chu kalchuh kut aman nadingun aseipeh tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amahon lhamasa nisom le nili ni nilhah-in Sinai gamthipma chun kalchuh kut chu amangun, Pakaiyin Mosi athupeh jouse dungjuijin, Israel ten hitichun abol taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule mi phabep mithilong jeh-a kisuboh aumun, hicheni chun kalchuhkut anitthei tapouvin ahi. Chuin amaho hicheni chun Mosi le Aaron masanga ahungun;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hiche miho chun ajah-a, Mithilong jeh-a suhboh-a um kahiuvin; ibola Israel chate lah-a akitep phat sunga Pakaiya thilpeh kapediu kijahda ham? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Mosi'n ajah uva, Khongaita diuvin, keiman nangho chung changa Pakaiyin thupeh aneijam ngaijing kate, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel chate jah-a seipeh inlang, hitin seijin, Nalah uva ahiloule nachilhah hou lah-a mikhattou thilong khat jeh-a athenlouva, ahiloule kholgamla tah-a um hijongle, amachun Pakaiya kalchuhkut aman thouthou ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lhani lhinna nisom le nili nilhah lamle aman dingu, cholsolou changlhah le anche kha toh amediu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amahon hichu khatcha jong jingkah geija akhenlou diu, agujong khatcha asuhboh loudiu: kalchuhkut kiman dingdan jouse dungjuija aman diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin mikhat chu atheng ahia, chule kholgama che jong ahilouva, ahia kalchuhkut mangding anoplouva ahile: amatah chu amite lah-a kona paidoh-a umding ahi; ajeh chu aman akitep phat sungin Pakaiya dingin thilpeh ahinchoipon, hichepa chun achonset akipoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nalah uva namdang mi ahung kholjin auma, ama chun Pakaiya kalchuhkut manding anople, kalchuhkut kiman dingdan dungjuija le chonna ngai dungjuija amanding ahi: nanghon namdang mi ding le agama peng denpa-a dinga dan khatseh naneidiu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin houbuh kitundoh ni chun ponbuh, hettohsahna ponbuh chu meilom'in atomin ahi. Chule nilhah lamin houbuh chung chu meikong bangin, jingkah geijin aumin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutobang chun aumjing jengin ahi: sunle meilom'in atomin chule jan le meikongin akilangjin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule meilom chu houbuh akona lahtouva aum tengle, Israel chate chu akitol jiuvin, chutengle meilom kingahna mun'a chun Israel chaten ponbuh akison jiuvin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai thupeh dungjuijin Israel chate akitol jiuvin, chule Pakai thupeh dungjuijin gehbuh akison jiuvin; meilom chu houbuh chunga aum laisen apon in houva akicholnga jiuvin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule houbuh chunga meilom chu nitampi aumteng le, Israel chaten Pakai thupeh anitnun, akitoldohji pouvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Meilom chu houbuh chunga chu ni lhomcha aum kom jongle chutobang chun abolun ahi; Pakai thupeh dungjuijin amaho aponbuh uva aumun, chule Pakai thupeh dungjuijin akitol jiuvin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichu ahin, meilom chu nilhah-a pat jingkah gei auma, hiche meilom chu jingkah-a akilah-a ahile amaho akitol jiuvin ahi. Sun hihen jan hijong le meilom chu akilahdoh tihtih le amaho akitol jiuvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahiloule nini hihen, lhakhat hihen, ahiloule kumkhat hijongle, meilom chu houbuh chunga auma, aumdena ahile, Israel chate chu aponbuh houva aumun, akitol ji pouve: ahin hichu akilah doh tengle, akitol jiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakai thupeh dungjuijin amaho ponbuh-a akicholdo jiuvin, Pakai thupeh dungjuijin akitol jiuvin ahi; Pakaiyin Mosi khutna athupeh dungjuijun, amahon Pakai thu chu anitjiuvin ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipi ho koukhom nading le ngahmun ho kitoldoh na-a naman theina dingin dangka sumkon ni semin, hichu sehcha-a nakhetna nasem ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichu ania amahon amut tengule mipi ho jouse chu nahenga houkhom ho houbuh kotna chu hung kikhom diu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahon sumkon khatbou amutnuva ahile, Israel asang asang luchang ho, pipuiho chu nakoma hung kikhom diu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon kigina khatvei namut tengule, solam sanga um gebuh hochu kitolmasa diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon kigina aniveina namut tengule, lhanglam sanga gebuhho kitoldiu ahi; amahon akitol nadiuva kigina amutdiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla houkhom ho chu akikhop khom ding tengule nanghon namut diu, amavang kigina namut banguva naginsah lou dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Aaron thempu chapate chun sumkon chu amut dingu; chule nakhang lhumkei uva a-itih-a dinga chonna dan hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nagamsunguva nasugenthei uva namelma teu satdinga nacheuva ahile, nanghon sumkona chu kigina namut diu; chutile Pakai Pathen angsunga goldoh-a naum diu, chule namelma teova kona huhdohna-a naum diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chujongle nakipa nikhou le, naniloupi nikho hou, chule lha kipatseh le napumgo thiltou le nachamna thiltou ganlhaina chunga chu, hicheho chu nangho dinga Pathen angsunga geldoh ahitheina dinga sumkon ho namut dingu ahi. Keima na Pakai Pathen'u kahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin akum nina, alhani lhina, nisomni channi chun ahitin ahi, meilom chu hettohsahna houbuh-a konin akiladoh tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Sinai gamthipma konin Israel chate akitolun; Paran gamthipma chun meilom chu akingatan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi khutna Pakai thupeh dungjuijin amahon akholjinu masapen chu apan taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amasa penin agalsat miteo dungjuijin Judah chate houbuh ponlap chu achen; chule janel ho chunga lamkaija chu Amminadab chapa Nashon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Issachar chate phunga janel ho chunga lamkai chu Zuar chapa Nathaneel ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Zebulun chate phunga janel ho chunga lamkai chu Helon chapa Eliab ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin houbuh chu aphelhauvin; Gershon chapate le Merari chapaten houbuh chu apouvin malam ajon taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin agalsat miteu dungjuijin Reuben ponbuh ponlap chu akitolin, chule Shedeur chapa Elizur chu janel chunga lamkai ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Simeon chate phunga janel ho chunga lamkai chu Zurishaddai chapa Shelumiel ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Gad chate phunga janel ho chunga lamkai chu Deuel chapa Eliasaph ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Kohath miho chun muntheng chu apouvin akitolun ahi. Chule adangho chun amaho hunglhun masangin houbuh chu anatung doh masaovin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin agalsat miteu dungjuijin Ephraim chate ponbuh ponlap chu akitolin; chule Ammihud chapa Elishama chu ajanel hou chunga lamkai ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Manasseh chate phunga janel ho chunga lamkai chu Pedahzur chapa Gamaliel ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Benjamin chate phunga janel ho chunga lamkai chu Gideoni chapa Abidan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Dan chate gebuh ponlap chu akitolin, hichu ami janel hou sunga gebuh nunungpen ahin ahi: chule Amishaddai chapa Ahiezer chu janel chunga lamkai ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Asher chate phunga janel ho chunga lamkai Ocran chapa Pagiel ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Naphtali chate phunga janel chunga lamkai chu Enan chapa Ahira ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiche hi akitol laijuva agalsat miteu dungjuija Israel chate kitoldan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi'n anupapa, Midian mi Raguel chapa Hobab jah-a, Pakaiyin nangho kapeh ding nahiuve tia aseina mun jona che kahiuve; hungin kilhonnute, keihon na bolpha naovinge, ajeh chu Pakaiyin Israelte thudola thilpha aseije, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman ajah-a, Kahung louding ahi; ahin keima kagam le ka-inkote koma kache johding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman, Katao ahi, neidalha hih-un; ajehchu nangman keihon gamthipma gebuh iti kason diu nahen, nangma keiho mitna napan ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule hitiding ahi, nangma keihotoh nalhon khomma ahile, henge, hitiding ahi, Pakaiyin keiho chunga phatna abolding chanchu keihon jong nangma chunga kaboldiu ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin amaho Pakai molsanga kon chun nithum lampia chun akipat doh-un: chule Pakai kitepna thingkhong chu nithum lampia chun amaho kingahna ding mun hol dingin amasanguva achen ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule amaho ngahmuna kona achedoh tengule Pakai meilom chu sun le achunguva aumjin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule ahitin ahi, thingkhong chu akitol tengle Mosi'n, Pakai, kipatdoh-in, chule namelmaho chu kithecheh-u henlang; nangma nahotbolte chu na angsung jamuhen, atijin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule hichu akingah tengle, aman, O Pakai, Israel sangtamtah henga hung kile kitnin atijin, ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin mipi chu aphun phatnun, Pakai alunglhai tapon: chule hichu Pakaiyin ajan, alung akoujah jengtai; chuin Pakai lunghanna chu amaho lah-a akoudoh tan, gebuh pammong penna umho chu aka mangtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin mipi chu Mosi hengah apengjah taovin ahile, Mosi Pakai henga ataovin, hichun meichu amit tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mipi lah uva chu Pakai meija ahung kou jehchun, aman hiche munchu Taberah asahtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin choplop mihonpi lah-a chun sa ducha-a aumtan; chule Israel chate jong chu akapkit taovin; Kon eiho nehding sa eipeh dingu ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Egypt gama manbeija ineh-u nga ho, changmai ho, donkho ho, louthul ho, louthul tilnei ho, louthul chang neiho chu igel doh-un ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla tun ihinnao agolhatan; chule imitmu uva manna tilou imacha aumpon ahi, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule manna chu pathikhomu toh abangin, chule avoupoh chu thingnaidol toh abangin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule miho chu cheova, alokhomuva, sumheija agoibongu, ahiloule songlhenga avoh bonguva, khangbela akanuva, chutengle hiche-a chu changlhah asemjiu ahi: hichu atuidan thaothah kikang changlhah toh abangin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule jana gebuh chunga daitwi ahunglhah tengle, manna chu alhahtha jin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Mosi'n mipi ho jouse a-inko ko-a, ami takip ponbuh kotna akau ajatan; Pakai lunghanna chu nasatah-in ahung kong dohtan, Mosi jong chu alung nommo lheh tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Mosi'n Pakai henga, Ipi dinga nasoh hi nagimbol ham? Ipi jeh-a kachunga mipi jouse pohgih hi nangapma, nangma mitmu-a nalungsetna kachan leltam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman hiche miho jouse hi kanavop ham? Keima hinbeh hiuva Nangma kahenga, Mipan naosen noichep lai apom bangin nangman amahohi na-angsunga pomin lang, apu apateu kateppeh gamma puilutnin neitiham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman mipi jouse pehdinga sa hoija kalah ding ham? Ajehchu amaho kahenga akapmun, Kaneh diuvin sa neipeuvin, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipi hijatpi hi kachang seh-in pojou ponge, ajehchu keidingin agihsa behseh-e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hitia hi neibolding ahile, katao ahi, namit mu-a lungsetna kachana ahile, hilai munahin tule tun neithat jengin; kamanthahna muda jenginge, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin Mosi henga, Nangman mipi ho chunga lamkai le upa ahi tia nahet Israel upaho mi somsagi kahenga hinkhomin; chule amaho chun nangma to adinkhom theina diuvin houkhom ho houbuh-a hinpuijin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule keima kahung kumlhah-a hikoma chu nangma kakihoupi ding: chule nachunga um lhagao chu kalah-a amaho chunga kakoiding; chule nangman mipi ho pohgih chu nachang seh-a napoh louna dinga amahon napoh hu dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangman mipi ho jah-a, Jing nikho-a dingin nangma cheh kisutheng uvin, nanghon sa naneh dingu ahitai. Ajehchu nangho Pakai nakhanga nakapmun, kon keiho nehding sa eipeh diu ham? Egypt gama kaumu chun nom kasajouve, nati uve: hijeh-a chu Pakaiyin nangho sa napeh uva naneh diu ahitai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanghon nikhat jong hilou, nini jong hilou, ninga jong hilou, nisom jong hilou, chule nisomni hilou;
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla lha lungkeija nanah hom sunguva ahungdoh-a, naloh-u asotokah seuva ding ahi. Ajeh chu nanghon nalah uva um Pakai chu nanotthap uvin, a-angsunga nakamun, Ipidinga Egypt gama kona ihung doh uham? nati uve, tin seipeh-in, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Mosi'n, Alah uva kaumna mipi, kenga lamjotthei cheh sangjagup hiuva; nangman, Amahon lhakhat lhungkeija aneh diuva sa kapeh ding ahi, tin naseije.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anehkhop nadiuva kelngoihon le gancha honho chu kithapeh ding hiuvem? ahiloule anehkhop nadiuva twikhanglen'a nga jouse kimatkhom peh ding hiuvem? ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakaiyin Mosi jah-a, Pakai khut chu kisuchoma hitam? tu-a hi nangman kathusei nachunga aguilhun aguilhun lou namu ding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Mosi apotdoh-in, mipi ho chu Pakai thu chu aseipeh-in, chule mipi lah-a upa somsagi ho chu akhomin, houbuh kimvella chun adinsah tai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pakai meilom'in ahung kumlhan, ajah-a thu aseijin, chule achunga um lhagao chu aladoh-in, upa somsagi ho apetan ahi. Chuin ahitin ahi, lhagao achunguva achuh phatnin, gaothu aseijun, atang tapouvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahin mi ni chu gebuh-a umden ahin, khatpa minchu Eldan ahin, khat chu Medad ahi: chuin Lhagao chu achung lhona achun; amanihi amin kilakhom lah-a chu jao ahilhonin, houbuh-a potdoh lou ahilhone. Chuin amanin gebuh sunga gaothu aseilhon tan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin gollhang khat ahunglhaijin, Mosi jah-a, Eldad le Medad-in gebuh sunga gaothu aseilhone, ahungtin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin agollhangho lah-a khat, Mosi lhacha Nun chapa Joshua'n adonbutnin, kapu Mosi, amani khu phohthipmin, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi'n ajah-a, Keima jala namit thip ham? Pakai mite jouse themgao hiuhenlang, Pakaiyin achunguva alhagao koi tavele kati, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Mosi le Israel upa hochu gebuh sunga aluttaovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Pakaiya konin hui ahung nungin, twikhanglen'a konin vamim ahinlhoh-in, gebuh kom, hilama kona nikhat lampi, khulama kona nikhat lampi tobang gei, gebuh kimvela, chule hichu leiset chunga kon tongni geija sangin alhahsah-in ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin mipi ho chu adingdoh-un, nilhum keile jan khovah-in, chule ajing nilhum keijin, vamim hochu aloh-un: alohlhom pen pan pocha som alohdoh-in; chule hicheho chu ama ama ding cheh-in gebuh kimvela chun thejaovun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin ahakah uva sa chu aumnalaija, alhaigoi masangun, Pakai lunghanna chu mipi dounan ahung kongdoh tan, Pakaiyin mipi chunga chun hise nasatah achuhsah tan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule hiche mun'a chu sa-a lop miho avuitah jeh-un, hiche mun chu Kibroth-hatta-avah asahtai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin mipi chu Kibroth-hatta-avah'a konin Hazeroth jonin akitolun, Hazeroth'a gebuh asemtaovin ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi'n Ethiopia numei khat akichenpi jeh-in Miriam le Aaron'in ama douna thu aseilhontan ahi: ajehchu aman Ethiopia numei khat ana kichenpin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amanin, Tahbeh monga Pakaiyin Mosi'a kona bou thu aseiham? eini-a kona jong asei hilouham? atilhone. Chule hichu Pakaiyin ajatan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />(Tuhin Mosi kiti mipahi leiset chunga mijouse lah-a alungneng pen ahi).
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin phulou helouvin Pakaiyin Mosi, Aaron, chule Miriam henga thu ahin seijin, Nangho thum houkhom ho houbuh lama hungun, ati. Chuin amaho ahung taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakai chu meilhang khompin ahung kumlhan, houbuh kotna chun adingin, Aaron le Miriam chu ahin kouvin: chuin amani ahung potdoh lhonin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman, Tun kathu ngailhonin: nalah uva themgao auma ahile, keima Pakaiyin amachu gaova kakihetsah-a, chule manga akoma thu kasei ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka-insung pumpi-a tahsan umtah, kalhacha Mosi chunga vang chutobang ahipoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama hitoh kikam sanna, kicheh tah-a, thu ki-im beija kakihoupiji ahi; chule aman Pakai melso jong amu ahi; chuti ahile ibola kalhacha Mosi douna-a thusei ding kichalou nahi lhonham? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakai lunghanna chu amani dounan ahung koudoh-in; chuin adalhatan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin meilhang chu houbuh-a konin akihohdoh tan; veuvin, Miriam chu ahung phah-in, buhbang bangin abangtan: chuin Aaron'in Miriam chu aven, chuin veuvin, amanu aphah ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Aaron'in Mosi jah-a, Ohe, ka Pakai, nahenga katao ahi, ngolhoi tah-a kanachon lhona, kaboldoh lhon chonsetna, hiche chonsetna hi kachung lhona ngam loujenin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi anu sunga atipum akehkhat beisa-a hungpenga bangin, amanu hi athisa bangin umsah hih-in, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi Pakai henga ataovin, Vo Pakai, nahenga katao ahi, amanu hi tun damsah-in, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Mosi jah-a, Amanuhi apan amaichanga achil asetkhuma ahile amanu nisagi sung jahchalou ding ham? gebuh-a konin nisagi kaidoh-unlang, hiche jou chule puilut hikit hen, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Miriam chu nisagi gebuh pama akoijun; Miriam ahung kipui lut kit kahsen mipi chu akitol tapouve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichejou mipi chu Hazeroth'a konin akichonun, Paran gamthipma chun ponbuh asong taove.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate kanapeh, Canaan gam kholtoh dingin, apu apateu kailhah cheh-a mi khatcheh, alah uva vaipo khatcheh chu solin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi'n Pakai thupeh bang chun amaho chu Paran gamthipma konin asoltai. Hiche miho chu Israel chate aluchang ho ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hichengsehi amaho min ahi: Reuben phunga Zaccur chapa Shammua.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon phunga, Hori chapa Shaphat.
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah phunga Jephunneh chapa Caleb.
  </para>
  <para style="p">
    <verse number="7" style="v" />Issachar phunga, Joseph chapa Igal.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ephraim phunga, Nun chapa Oshea.
  </para>
  <para style="p">
    <verse number="9" style="v" />Benjamin phunga, Raphu chapa Palti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebulun phunga, Sodi chapa Gaddiel.
  </para>
  <para style="p">
    <verse number="11" style="v" />Joseph phunga, tichu Manesseh phunga Susi chapa Gaddi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan phunga, Gemalli chapa Ammiel.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher phunga, Michael chapa Sethur.
  </para>
  <para style="p">
    <verse number="14" style="v" />Naphtali phunga, Vophsi chapa Nahbi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad phunga, Michi chapa Geuel ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche hohi Mosi'n gam velhi dinga asol miho min chu ahi. Chuin Mosi'n Nun chapa Oshea chu Jehoshua tin asah-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Mosi'n amaho chu Canaan gam velhi dingin asolin, ahenguva hitin aseije, Lhanglam sanga kon khun chetouvun lang, molchunga khun kaldoh-un;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule gavechenun agam chu itobang ham, chule asunga chengho chu hatnaovem ahiloule hatmovem, lhomuvem ahiloule tamuvem;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule achennao gamchu itobang ham, pha-am ahiloule se-ham, achennao khopiho-a chu itobang khopi ho-a chenguva, pon in'a cheng hiuvem ahiloule kulpi-a cheng hiuvem;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule agam chu itobang gam ham, leipha ham ahiloule leiphalou ham, hichea chu thing umam ahiloule umhih-am gaveovin. Nangho hangsanun lang agamga hinpouvin. Hichelai phat tah chu lengpithei ga masapen minphat tah ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutichun amaho achetouvun, agam chu Zin gamthipma pat Hamath lutna Rehob geijin akhol taovin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amaho lhanglama konin achetouvun, Anak chate ho Ahinam, Sheshai, chule Talmai umna mun Hebron ahung lhungun ahi. (Tun Hebron chu Egypt gama Zoan kisahdoh ma kum sagi masanga kisadoh ahitai.)
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amaho Eshcol vachadung ahung lhungun, hichea konchun amahon lengpi theiboh khat aboh pumin asat lhaovin, minin moljolin ahinjong lhonin; chule kolbuthei ho le thei changho ahin pouvin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche munna kona chu Israel chaten lengpiga boh asatlhah jeh-un, hiche mun chu Eshcol vachadung akisahtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amahon gam chu agakhol toh-u nisomli jouvin ahung kilekit taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amaho acheuvin Mosi le Aaron henga, chule Kadesh mun'a um Paran gamthipma Israel chate houkhom ho jouse henga ahungun; chule amaho hengle houkhom ho jouse henga thu ahin pouvin, agamga jong chu amaho avetsah-un ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule amahon ama henga, Keiho nangman neisolnao gama chu kacheuvin, tahbeh mongin agam chu khoiju le bongnoi lonna gam ahi; chule hiche hi agamga chu ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahijeng vangin agama chengho chu mihat ahiuvin, akhopihou chu kulpi kikai khum ahin, chule aletna lenthei ahi; chukalvalin keihon chukoma chun Anak chateho kamuvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amalek miho chu lhanglama achengun; Hit miho, Jebus miho, chule Amor miho chu molsang ho-a achengun; chule Canaan miho chu twikhanglen pang le Jordan panga achengun ahi, atiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Caleb min mipi ho chu Mosi angsunga chun aphoh thipmin, Eiho mangang tah-in cheu hitin, galo jengu hite; ajehchu eihon ijo teitei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahivangin ama chekhom piho chun, Eiho amaho igajo lou dingu ahi; ajehchu amaho eiho sanga hatjo ahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaho chun agakhol tohnao gamchung chang thudola chun Israel chate henga thulhut phalou ahin pouvin, Keiho kacheuva kaga kholtoh nao gam chu agama chengho negamhel thei gam ahin; chule chua kaga mu-u mijouse chu milen ngen ahiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule keihon chumuna chun milen tahtah ho, Anak chapate, milen tahtah ho chilhah-a kon hungpengho chu kagamuve: chule keiho mitmun keihochu khaokhopi bangbep kahiuvin, amaho mitmu-a jong chutobangma chu kahiuve, atiuvin ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin houkhom ho jouse chun aw sangtah-in asamun, apengun; hiche janchun mipi chu akaptaovin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Israel chate jouse chu Mosi le Aaron chunga aphun taovin: houkhom pumpi chun ajah lhona, Pathen'in Egypt gama eina thisah-u hitavele! Ahiloule Pathen'in hiche gamthipma hi eina thisah-u hitavele!
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ipi dinga Pakaiyin hiche gamahi chemjam'a lougam ding le, kaji kachateu hi gal anchah hiding bepma eipuilutnu hitam? eiho dinga Egypt gama kilekit phajo louding ham? atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amaho khatle khat akihouvun, Eihon lamkai khat kilhenu hitin, Egypt gam lama kilekit tao hite, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichun Mosi le Aaron chu Israel chate houkhom kikhomho jouse angsunga chun abohkhup lhontan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin gam kholtoh-a cheloi lah-a pang Nun chapa Joshua le Jephunneh chapa Caleb chun aponsil lhon abot-eh lhonin:
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel chate houkhom ho jouse henga chun, Kholtoh dinga kachot lenao gamchu gampha tah mongmong ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pakai ichunguva alunglhaina ahile hiche gama chu eipuilut nuva, khoiju le bongnoi lonna gam chu eipeh diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pakai dounan kiphinda poupou vunlang, chuche gam mite jong kicha hih-un; ajehchu amaho i-anchah dingu ahiuve: akihon bitnao chu amaho-a kona chedoh ahitan, chule eihovang Pakaiyin eiumpiuve: amaho chu kicha hih-un, tin aseilhonin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahinla houkhom ho jouse chun songa sedingin agaotaovin ahi. Chuin Pakai loupina Israel chate jouse angsung, houkhom ho houbuh-a chun ahung kilahtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Mosi jah-a, Itihchan hiche mipi ho hin eilung hansah diuham? Chule alah uva melchihna hijatpi kamusah nunguva jong, itihchan eitahsan da diuham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman amaho chu natsetna kajepma, kasuhmang ding; chule keiman nangma amaho sanga lenjole hatjo nam khatna kasemding nahi ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi'n Pakai henga, Chuteng Egypt mihon hichehi ajah diu, (ajehchu nangman hiche mihohi nathahatna amaho lah-a kona nahinpuidoh ahi;)
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amahon hiche gama cheng miho henga aseidiu ahi. Ajeh chu amahon, Pakai nangma hiche miho lah-a naum, Pakai nangma chu kimaito-a akimupiu, nameiloma achungu na-opkhum, chule amasanguva sunle meiloma nache-a, janle meikonga nacheji chu ajataovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun nangman hiche mite jousehi mikhat bangin that talechun, nangma minthan ja-a namho chun,
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakaiyin hiche mihohi ahahselna gama apuilut jou tahlou jeh-a, gamthipma athagam ahi atudiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule tun, nahenga katao ahi, ka Pakai thilboltheina chu loupi hen, nangman hitia nasei bangin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakai chu thoh hattah, hepina lentah nei, khangitlouna le suhkhelna ngaidam ji, chule themona chu donlouva koilou, pate khangitlouna chate chunga khangthum khangli geija viljing nahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Katao ahi, hiche mipi ho Egypt'a pat tuni geija nangaidam bangin, nahepina lentah dungjuijin hiche mipite khangitlouna hi ngaidamtan, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin, nangma thu dungjuijin amaho hi kangaidam tai;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla keima tahbeh-a kahinjing bangin, leiset pumpihi Pakai loupina-a dimset ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ajehchu hiche mite Egypt gam le gamthip laija kaloupina le kathilbol kidang bolho mujouse, chule tu-a som veijen eipatepma, ka aw ngailou jouse hin;
  </para>
  <para style="p">
    <verse number="23" style="v" />Thonlou hela amahon apu apateo kahahselna gam chu amu louhel diu, chule eilung hansah jousen jong amulou diu ahi:
  </para>
  <para style="p">
    <verse number="24" style="v" />Kalhacha Caleb vangin lunggel chom neija, eijui lhingset jeh-a, agachena gama chu kapuilutding, chule achilhah ten alodiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />(Tun Amalek miho le Canaan miho chu phaichama chun achengun ahi.) Jingle kiheijun lang, twipisan jotna lampia konin gamthipma lut taovin, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakaiyin Mosi le Aaron henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche houkhom gilouho keima douna aphun phun uhi itihchan kathoh ding ham? keima chunga Israel chate phunna hohi kajatan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho chu seipeh-in, keima tahbeh-a kahinjing bangin tin Pakaiyin aseije, Nanghon kana benga nasei jouseu banga hi, nachung uva keiman kabolding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nalongu hiche gamthipma hi lhukam ding ahi: keima douna phunna, kum somni-a lhah chunglam, nami jatnu dungjuija nalah uva kona kisim doh jouse chu,
  </para>
  <para style="p">
    <verse number="30" style="v" />Jephunneh chapa Caleb le Nun chapa Joshua tailou, nangho chensahna dinga kahahselna gama chu khatcha nalutlou dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahinla mi anchah ding bep natiu nachasen hou, amaho chu kapuilutna, nanghon nanot thapmu gam chu ahetdiu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangho thudol vang, nalongu hiche gamthipma hi lhuchap ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule nachateo chu gamthipma kum somli vahle leova, nalongu gamthipma hi abeihel kahse-a najon thanhoi naochu athoh diu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gam nagakhol nao nikhojat dungjuija, nisomli ngeichu, nikho khat nakhangitlou naochu kumkhat nakipoh diu, kum somli sunga, chutengle keima hi aki pampai teng iti ji-am nahetdiu ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pakai Keima kaseidoh ahin, douna-a kikhom khom hiche houkhom gilouho jouse chunga hi katohdoh tahbeh ding ahi: hiche gamthipma hi mangthah uva, thigam ding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Mosi'n gamkholtoh dinga asol miho, ahung kile kitnuva gamthudol akaleh-a thu ahinpoh jeh uva, houkhom ho jouse phunchel sahho,
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule gam chunga thudola thulhut phalou hinpoho ngei chu, Pakai angsunga hisen athigam taovin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahinla gamkhol dinga cheho lah-a pang, Nun chapa Joshua le Jephunneh chapa Caleb vang ahing lhon nalaije.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Mosi'n hiche thukisei hohi Israel chate chu aseipeh tai: chuin mipi chu alung hem cheh taovin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin jingpitah-in athoudoh un, molsang vuma akaldoh-un, Veuvin, eiho hikoma i-umuve, Pakaiyin eitep pehnao mun'a ichetou dingu ahi: ajehchu eiho ichonse taove, atiuve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Mosi'n ipi dinga Pakai thupeh napalkeh-u ham? Hiche nathil gonuhi lolhing louding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Namelma teu masanga tha-a naum louna dingun, chetou hih-un; ajehchu nalah uva Pakai aumtapoi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ajehchu Amalek mihole Canaan miho namasanguva aumun, achemjam muva nalou gamdiu ahi: ajehchu nangho Pakaiya kona kiheimang nahitaovin, hijeh-a chu Pakaiyin naumpi lou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ahin amaho lhangvuma kaltou dingin akigotei teijun: ahivangin Pakai kitepna thingkhong le Mosi la gebuh-a konin akipatdoh pon ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuphatnin Amalek miho le chucheng lhangvuma cheng Canaan miho chu ahungkum lhaovin, amaho chu athagtnun, Hormah geijin asatpeh-un ahi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate chu seipeh in lang, ajah uva hitin seijin, Keiman nangho kapeh, nachenna diu gam nalhun tengule,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ganhon ahiloule kelngoi honna kona Pakai henga gimnamtui dinga, Pakaiya dinga meija kitohdoh thilto govam thilto ham, kitepna guilhunsah ganlhaina ham, lungcham thilto ham, ahiloule nakut loupiho ham napeh tengule,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutengleh Pakai henga thilto pedingpa chun anneh thilto-a dinga changbong neljet ephah hopsom-a hopkhat toh kihal thaotwi hin khat hoplia hopkhat ahinchoi ding;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule donding thilto lah-a lengpitwi hin khat hoplia hopkhat chu govam thilto ham, ganlhaina ham toh kelngoinou khatna dinga nagon ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahiloule kelngoichal khat dinga, nangman changbon neljet hopsom-a hopni, thaotwi hin khat hopthum-a hopkhat toh kihal anneh thilto nagon ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule donding thilto dinga chu lengpitwi hin khat hopthum-a hopkhat Pakaiya henga gimnamtui tah hidinga nato ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule govam thilto dinga bongchal nagon tengle, ahiloule kitepna suhbulhit na dinga ganlhaina ham, ahiloule Pakai henga chamna thilto ham nagon tengle;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutengle nangman thaotwi hin keh khat toh kihal changbong nelsel hopsom-a hopthum, bongchal tochun anneh thilto ding nahin kaiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule donding thilto-a lengpitwi hin keh khat, Pakai henga gimnamtui tah hidinga meija kitohdoh thilto nahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitia chu bongchal khat ham, ahiloule kelngoichal khat ham, kelngoinou khat ham, ahiloule kelnou khat hama dinga nabol ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nagondiu jat dungjuija, amitakip henga ajatnu dungjuija naboldiu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule agama peng jouse chun, Pakai henga gamnamtui tah hidinga meija thilto apeh tengule hitia hi aboldiu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule namdang mi nangho toh akholjin khoma, ahiloule nakhang khanguva nalah uva khosaden chan chun, Pakai henga dinga gimnamtui thilto meija kitohdoh thilto apeh noma ahile, nangho bolbang banga aman jong abolding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangho houkhom ho le namdang mi nalah uva khopem hon pomding chondan khat naneidiu, nakhang khanguva a-itih-a chondan khatbou nanei dingu ahi: namdang miho chu Pakai anga nangho bang bang hidingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho le nalah uva khopem namdang miho-a dinga dan khatseh le chonna dan khatseh umding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel chate henga thu seijin lang, ajah uva seipeh-in, Nangho keiman kapuilut na ding gama chu nalhun tengule,
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutengle hitiding ahi, nanghon agam changlhah naneh tengule, Pakai henga jap thilto nato dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nachanglhah meh masapenu chu jap thilto-a natodiu: changphola jap thilto nabol banguva chutia chu nabol dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nakhang khanguva nachanglhah mehmasa penu chu Pakai henga jap thilto-a nato dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Pakaiyin Mosi henga anasei hiche thupeh jouse hi nasuhkhel uva, nanit lou uva ahile,
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakaiyin Mosi ana thupeh ni-a kipat amasanglam nakhang lhungkeijuva Pakaiyin Mosi khutna kona nangho nathupeh jouse geija chu;
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutengle hung hitiding ahi, houkhom ho hetlouva hetlou jeh-a suhkhel ahile, houkhom ho jousen bongchal golkhat Pakai henga gam namtuitah hidinga govam thilto-a ding, a-anneh thilto le adonding thilto toh dan dungjuija atotha diu, chule chonset thilto-a dinga kelnou khat atodiu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule thempupa chun Israel chate houkhom ho jouse dinga longlhenna abolding, hetlouva kibol ahijeh-a kingaidam ding ahiuve. Chule ahetlou jeh uva Pakai henga meija kitohdoh ganlhaina thilto ahinchoi uva, Pakai henga achonsetnao thilto ahinchoi dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Israel chate houkhom ho jouse le amaho lah-a khopem namdang mipi jouse chu kingaidam ding ahiuve; ajehchu mijouse chun ahetlouvu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule mikhat tou hetlou jeh-a achonsetna ahile, amachun kelcha anu kumkhat lhingbep khat chonset thilto-a dinga ahinchoi ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutengle thempupa chun hetlou jeh-a chonsepa dinga chu longlhenna abolding ahi, chule aman Pakai anga hetlou jeh-a chonset abola alonglhena abol tengle amachu kingaidam ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nanghon Israel chate lah-a peng hihen, nalah uva hung khopem namdang mi hijongle, hetlou jeh-a chonset bolpa dinga dan khat nanei dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin henasa-a bolpa chu, gamsunga penga hihen lang, namdang mi hijongle, amachun Pakai i-sah louva abol ahin; amachu amite lah-a kona kipaimang ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ajehchu aman Pakai thu chu anot thapma, athupeh apalkeh ahin, hichepa chu paimanga umding ahi; akhangit louna chu ama chunga chuding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Israel chate gamthipma aumpetnun, choldo ni-a thingkang chom mikhat amutaovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin thingkang chom muho chun amachu Mosi le Aaron chule houkhom ho jouse henga ahin puitaovin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin iloding akiphondoh loulai jeh-in, amachu mihen na-a akoi taove.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Pakaiyin Mosi jah-a, Mipa chu thatei ding ahi: houkhom ho jousen gebuh polama songa asediu ahi, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin mipi chun Pakaiyin Mosi athupeh bangin amachu gebuh pama ahin puidoh-un, songa aseplih taovin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="38" style="v" />Israel chate jah-a chun akhang khanguva apon geihou ajeppah nadiu le, agei ajep pahnao chunga chu adumpol aba diuvin seipeh-in,
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule nanghon najeppah nao chu nangho dinga, hichu navet nuva, Pakai thupeh jouse chu nageldoh uva nabol nadiu hidin: chule jonthanhoi boldinga anung najuijiu nalung ngaichatnu le namit vetnu chu najuilou nadiu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chutia chu kathupeh jouse nageldoh uva, nabol uva, na Pathen'u dinga atheng nahinadiu ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Keima Pakai na Pathen'u kahin, na Pathen'u hidinga Egypt gama kona nahin puidohpao chu kahi: keima Pakai na Pathen'u kahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Izhar chapa, Kohath chapa, Levi chapa Korah le Reuben chapate Eliab chapa teni Dathan le Abiram, chule Peleth chapa On chun miho apuijun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin houkhom ho sunga um loupileh, minche cheh akikhom khomho pipui jani le somnga le Israel chate phabep toh Mosi maija adingdoh-un,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amaho Mosi le Aaron dounan akikhomun, aheng lhona, Houkhom ho jouse, amitakip athengun alah uva Pakai aume ti hena sasan nakibolthei sah behseh lhone. Ibola Pakai houkhom ho chung vuma kidomsang jeng nahi lhonham? atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi'n hichu ajah phatnin, tolla aboh khupmin:
  </para>
  <para style="p">
    <verse number="5" style="v" />Korah le aloiho jouse jah-a chun aseijin, hitin ati, Jingkah le Pakaiyin koi chu ama-a hija, koi chu atheng hijaham avetsah-a; chule amachu aheng anailut sah ding ahi: chule ama alhenpa tah ngeichu akinailut sah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche hi bolun: Korah le aloiho jousen gimnamtui lheng ho kilah-un;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Asunga chun mei hallun lang, jingteng Pakai angsunga asunga chun gimnamtui koijun; chule hitiding ahi, Pakaiyin alhen amapa chu atheng hiding ahi. Nangho Levi chate, nakibolthei sah behseh taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Mosi'n Korah jah-a, Ngaijun, katao ahi, nangho Levi chapate;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama henga puinaja, Pakai houbuh lhachana tongding le, houkhom ho masanga akinthengu bol dinga ding dinga Israelte Pathen'in Israel houkhom ho-a kona nachomkhenu hi nangho dinga thil neocha bou hia nagelu ham?
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule aman nangma le nasopi ho Levi chapate jouse ama henga napuinai taove: achutile nanghon themputna jong nahol nahlaiju ham?
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun nangma le naloiho jouse Pakai dounan nakikhom khomun: ahi. Aaron chu ipi hija ama douna-a naphunu ham? ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mosi'n Eliah chatehi Dathan le Abiram koudin mi asolin ahile, amanin, hungtou lhon ponge:
  </para>
  <para style="p">
    <verse number="13" style="v" />Khoiju le bongnoi lonna gama kona gamthipma thadinga neihin puidoh-u hi thilneocha hija, kachunguva naki piput sah ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chukal vallin nangman khoiju le bongnoi lonna gama neipuilut pouvin, ahiloule lou le lengpilei la neilosah deh pouve: hicheng miho jouse mit hi kaldoh nagot ham? kahung tou lhon louding ahi, ati lhontan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mosi alung ahang lheh jengtan, Pakai henga, Athil toujong sanghih-in; keiman amaho-a konin sangan khatjong kalapon, amaho khatcha jong kasuna pon ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Mosi'n Korah jah-a, Nangma le naloiho jouse, nangma le amahose chu Aaron toh jingle Pakai angsunga naum diu ahi:
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule amitakipmin nagimnamtui lheng cheh kilah unlang, asunga gimnamtui koijun, chule amitakipmin nagimnamtui lheng cheh-u gimnamtui lhengcheh-u, jani le somnga chu Pakai anga hinchoijun; nangma le Aaron'in jong nagimnamtui lheng cheh nakichoi lhonding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amitakip min agimnamtui lheng cheh akilah-un, asunga mei akoijun, achunga gimnamtui akoijun, houkhom ho houbuh kotphunga chun Mosi le Aaron toh ading khom taovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Korah chun amaho dounan houkhom ho jouse houkhom na ponbuh kotphunga akhomin ahi: chuin Pakai loupina chu houkhom ho jouse henga ahung kilah tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin Mosi le Aaron jah-a thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hetmanlouva amaho kasuhmang theina dingin, hiche houkhom ho-a konin kikhindal lhonin ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amani abohkhup lhonin, Vo Pathen, tahsa jouse lhagao ho Pathen, mikhat chonset jeh-a houkhom ho jouse chunga lunghang ding nahi hitam? atilhon tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakaiyin Mosi jah-a aseijin,
  </para>
  <para style="p">
    <verse number="24" style="v" />Houkhom ho jah-a chun, Korah, Dathan chule Abiram houbuh-a konin kikhin doh-un tin seijin ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Mosi akipatdoh-in Dathan le Abiram henga achen; chule Israel upahon anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman houkhom ho jah-a, Naheng uva katao ahi, hiche miphalou ho ponbuh ho-a konin kikhin doh-un, chule a-imachao tongkha hih-un, achuti loule achonsetnao jouse-a mangthah getnun nate, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutichun amaho Korah, Dathan chule Abiram houbuh ningtina konin akipat doh-un ahi. Chuin Dathan le Abiram ahungdoh lhonin, aponbuh-u kotphunga chun ajiteu, achateu, chule achasen houtoh ading taovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Mosi'n hichea kona hi Pakaiyin keima hicheng na jouse tong dinga eisol ahi nahet dingu ahi; ajeh chu keiman hiche hohi kalung chama kabol ahipoi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiche miho hi mijouse thi ngaija athiuva, ahiloule miho kivil banga akiviluva ahile, Pakaiyin eihin sol hilou ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla Pakaiyin thilthah abola, leiset akam katna, amaho hi aneijouseu toh aval lhuma, chule kotong sunga gangtah-a alhah lhumuva ahile; hiche miho hin Pakai alung hansah uve ti nahet chet dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin ahitin ahi, aman hicheng thuhi aseijou jouvin, anoijuva leiset chu ahung keh-in akikhen totan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Leisetnin akam ahin kathom sah-in, amaho le a-inhou, chule Korah loiho jouse le athilkeo jouseu chu aval lhumtan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amahole aneijouseu ahingin kokhuh sunga chun alhalutnun, chule achunguva leiset akichin; amaho houkhom ho lah-a konin amangthah taovin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin avela um Israel ho chu amaho pen gin chun ajam gamtaovin ahi. Ajehchu amahon, Eiho jong leijin eival lhum getnunte atiu ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Pakaiya konin meikong ahungdoh-in, gimnamtui hal mi jani le somnga chu akavamtan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="37" style="v" />Aaron thempu pa chapa Eleazar jah-a, gimnamtui lhengho chu meikong lah-a kona ladoh nadin seipeh-in, ajehchu hicheho chu atheng ahi; chule meichu gamlha thim tah-a thaijah-in.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amaho hinna douna-a chonseteho gimnamtui lheng ho chu maicham khuna kongdalin semuhen; ajehchu amahon Pakai anga ato-u ahin, hijeh-a chu hicheho chu thenga ahi. Chule hicheho chu Israel chate dinga melchhihna hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Eleazar thempupan meikavam hon thiltona amanu sum-eng gimnamtui lheng ho chu alan, hiche ho chu maicham khuna kongdalin asemin;
  </para>
  <para style="p">
    <verse number="40" style="v" />Hichu Aaron chilhah hilou namdang mi koimachan Pakai angsunga gimnamtui hal dinga ahung nai louna diu; Pakaiyin Mosi khutna kona ahenga aseibanga, Korah le aloiho abah louna diuva, Israel chate dinga hetjingna hiding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahivangin ajingin Israel chate houkhom ho jouse chu Mosi douna le Aaron dounan aphunuvin, Nangman Pakai miho nathatne atiuvin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin ahitin ahi, houkhom ho chu Mosi le Aaron douna-a akikhop petnun, houkhom ho houbuh lam chu aveovin ahile: veuvin, hichu meilom'in atomin, chule Pakai loupi chu ahung kilah-in ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Mosi le Aaron chu houkhom ho houbuh maija chun ahung lhonin ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Pakaiyin Mosi jah-a thu aseijin,
  </para>
  <para style="p">
    <verse number="45" style="v" />Amaho chu hetmanlouva kasuhmang thei nadin, hiche houkhom ho lah-a konhin hung doh-in, ati, chuin amaho chu abohkhup gam taovin ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Mosi'n Aaron jah-a, Gimnamtui lheng kilah-inlang, asunga chun maichama kon mei koilutnin, chule gimnamtui hal loijin lang, mangang tah-in houkhom ho henga chenlang, amaho dingin longlhenna gabolin: ajehchu Pakaiya konin lunghanna ahungdoh tan, hise akipantan ahi, ati.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin Aaron'in Mosi'n athupeh bangchun alan, houkhom ho lah-a alhailuttai; chule veuvin, mipi ho lah-a chun hise chu anakipantan ahi. Chuin aman gimnamtui ahalin, mipi ho dinga chun longlhenna aboltan ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin ama athiho le ahingho kikah achun adingin ahile, hise chu atangtan ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tun Korah chungchang thua thiho tilouvin, hise-a thichu sangsom le sangli le jasagi ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin Aaron chu houkhom ho houbuh kotphung lama Mosi henga akiletan: chule hise chu atangtan ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi jah-a thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate jah-a seijin lang, apu apateu insung kailhah mikhat cheh-a kon tenggol khatcheh, apipuhou jouse apu apateo insung kailhah cheh-a kon tenggol somleni lan lang; chule nangman amitakip min chu atenggol chung cheh uva chun sunnin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangman Aaron min chu Levi tenggol chunga nasutding ahi; ajeh chu tenggol khat cheh chu apateo insung luchang cheh-a ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nangman hiche ho chu nangma kakimupina houkhom ho houbuh sung hettohsahna maija chu nakoi ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hung hitiding ahi, keiman kalhen pen tenggol chu hungpah ding ahi: chutengle Israel chate aphun nao, nangni douna-a aphunao chu keija kona kasuh tang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n Israel chate henga chun aseijin ahile, pipuho chu aman tenggol khatcheh apeuvin, apu apateo insung dungjuijin tenggol somleni apeuvin ahi. Chule Aaron tenggol chu amaho-a tenggol lah-a chun aumin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mosi'n hettohsahna houkhom ho houbuh sunga Pakai anga chun tenggol ho chu akoitan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi, ajingin Mosi hettohsahna houbuh sunga chun alutnin ahile, veuvin, Levi insung dinga Aaron tenggol chu anadonin, amumdoh-in, chule ahungpah-in, jonmot anagan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n tenggol ho chu Pakai angsunga konin Israel chate henga ahinpodoh-in; chule amahon aveovin, amitakipmin atenggol cheh akilah taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Mosi jah-a, Aaron tenggol chu akiphinho hetna-a hettohsahna maija koidin hinlechoi kitnin; chutengle amaho keima douna-a aphunchel naova athilou nadinguva nasuhthip ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Mosi'n hiti chun abolin, Pakaiyin thu apeh bang chun aboltan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Israel chaten Mosi jah-a, Ven, keiho kathigamun, kamang thah-un, kamanthah gamhelu ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Koi hijongle Pakai houbuh hinnai jouse chu thiding ahi: thina-a chu imanthah dingu hitam? atiuve.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakaiyin Aaron jah-a, Nangma le nachapa, chule napu napateu insungin munthenga khangitlouna chu napohdiu, chule nangma le nachapate nangma toh na themputnao khangitlouna chu napohdiu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Nangma le nachapaten hettohsahna houbuh maija lhachana natoh naova nakithopi theina dinguvin, Levi phunga nasopi ho, napa phungmi hochu hin kipuijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amahon nangma natoh ding le houbuh natohding jouse chu avetup dingu ahi: amaho ahia nangma nahi-a jong nathilou na dinguva munthenga bel hole maicham bou chu ahin nailou dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahon nangma nakitho piuva, houkhom ho houbuh natoh le houbuh lhacha natoh jouse atohdiu: chule namdang min vang nahinnai louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutia chu Israel chate chunga lunghanna aumbe louna dinga, nangman muntheng natoh le maicham natoh chu natoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keima, ven, keiman nasopi ho Levi chate chu Israel chate lah-a konin kalheng doh-in; houkhom ho houbuh-a natong dingin Pakai dinga thilpeh khat bangin nangma nakipe taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun nangma le nangma to umkhom nachapaten maicham le pondal sunglam thua thempu tohmuna na natoh diu ahi: nathempu tohmun natohhi nalhacha natohdiu thilpeh-a kapeh-u nahiuve: namdang mi ahin naija chu thiding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Aaron jah-a, Ven, keiman jap thilto, Israel chaten thiltheng jouse chu nangma mopohna jong kapen; hicheho jouse chu thaokinu ahijeh-a nangma le nachapate a-itih-a chondan khat hidinga kapeh nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche hi meija kona amoh, nanga dinga thiltheng chungnung ho chu ahi: athil tohou jouse anneh thilto jouse, achonset thiltou jouse, asuhkhel thiltou jouse-a keima eipehdiu jouse chu nangma le nachapate dinga theng chungnung hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Muntheng chungnunga chu nangman nanehding; pasal takipmin anehdingu ahi: hichu nangma dinga atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichehi nanga ding ahi; Israel chaten dopkhang thilto dinga athilto hou, ajap thilto hou jouse toh, nangma le nangma toh umkhom nachapate le nachanute henga a-itih-a chondan hidinga kapeh nahiuve: na-insunga atheng tapouvin hichu aneh dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thao apha pentah le, lengpitwi apha pentah, chule suhlou chang, aga masapen ho Pakai henga apehdingu hou jouse chu nangma kapeh nahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Pakai henga ahin choi dingu gamsunga amin masapen chan chu nanga ding ahin; na-insunga atheng takipmin hichu aneh dingu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel gamsunga thilto jouse nanga hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakai henga apeh-u, tipum jouse-a naobu phukeh masa chan chu mihem hihen gancha hile nanga hiding ahi: ahivanga cha masapen chu nalhatdoh teiding ahin, chule gancha thenglou apeng masapen ho chu nalhat doh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule lhakhat ahia patna alhatdohna ding ho chu nalhatdoh ding, alhatna man nangma gon dungjuija, muntheng shekel dungjuija shekel chu gerah somni ahin, shekel nga-a nalhat ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin bongnou masapen, kelngoi masapen le kelcha masapen chu nalhatdoh louding ahi; amaho atheng ahiuve: athisanu chu maicham chunga nathe-a, athao chu Pakai henga gimnamtui tah hidinga meija kitoh thilto dinga nagoding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule a-om kijap le adah jetlam nanga ahibanga, atipum chu nangma ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel chaten Pakai henga lhuh thilto apeh-u thil thengho jouse chu, nangma le nangma toh umkhom nachapate le nachanute henga a-itih-a chondan hidinga kapeh nahiuve. Hiche hi Pakai anga a-imatih chana dinga nangma le nachilhahte henga chi-a kitepna hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin Aaron henga thu aseijin, ajah-a, Nangman amaho gamsunga gou naneilou ding, chule alah uva chan jong naneilou ding ahi: Keimahi Israel chate lah-a nagou le nachan chu kahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ven, keiman Levi chate chu Israel gamsunga hopsom jouse chu, atoh-u lhacha natoh, houkhom ho houbuh-a alhacha natoh-u jehtah chun agoulo diuvin kapen ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tua patna Israel chaten chonset apoh uva athilouna dinguva, houkhom ho houbuh aga nailou dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amavang Levi ho chun houkhom ho houbuh lhachana atoh uva, athemo nao chu apohdiu ahi. Hichehi a-itih-a nakhang lhum keijuva dinga chondan hiding, chutia chu Israel chate lah-a goulo naneilou diu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amavang Israel chaten Pakai henga lhuh thilpeh-a apeh-u ahopsom hou chu Levi hon gouva alodiuva kapeh ahitai; hijeh-a chu keiman ajah uva, Israel chate lah-a amahon goulo aneilou diu ahi, kati ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangman Levi ho kihoupin lang, ajah uva, Nanghon Israel chate hopsom, keiman nagoulo diuva kapeh chu amaho-a kon nalah tengule, hopsom-a hop khat ngeichu Pakai dinga lhuh thilto-a napehdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule hiche nalhuh thilto hou chu pholla chang leh lengpi chilhahna-a pum dimset banga kisimding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hita chu Israel chate hopsom nalah jouse chu Pakai henga lhuh thilto-a nato diu; chule chuche Pakaiya lhuh thilto chu Aaron thempupa napeh diu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nathilto hou jouse lah-a kon aphapen le, atheng chengse chu Pakai henga lhuh thilto-a nato teidiu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche jeh-a chu nangman amaho jah-a hitia nasei ding ahi, Nanghon aphapen ho nalhuhdoh tenguleh Levi ho dinga hiche hi changphol le lengpitwi kiheh na-a kona agasoh-a kisim ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule hiche hi nangma le na-insung miten mun jouse-a naneh thei dingu ahi: ajeh chu hichehi houkhom houbuh-a nalhacha natoh manuva kipe tohman ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule hichea kona aphapen nalhuh tengule, hiche jeh-a chu nanghon chonset napoh loudiu: chule nathi louna dinguva Israel chateho thiltheng jouse chu nasuhboh theilou dingu ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi le Aaron jah-a aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichehi Pakai thupeh chona danthu ahin, Israel chate henga chun bongla asan, pol lou, achunga nolna beihel, achunga namkoljon kibut khalou, nahin kaipeh nadiuvin seijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hiche chu Eleazar thempupan gebuh pama ahin kaidoh dinga napeh ding, chule mikhatnin a-angsung laitah-a atha ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutengle Eleazar thempupa chun athisan chu akhutjunga alah-a, houkhom ho houbuh masanga sagivei atheding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule khatnin ama mitmu-a bongla chu agoding; avunjong, atipum jong, athijong chule a-eh jong ahalding;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutengle thempu chun Cedar thing le hyssop chule asandup alah-a, bongla kigona meikong lah-a chu aselut ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule thempu chun aponho akisopma, atahsa twija akisil ding, chujoule gebuh-a hunglut ding, chule thempupa chu nilhah geija thenglou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitia bongla gou penpen chu twija avon asopma, amajong twija kisilding, chule nilhah geija thenglou ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule mitheng khatnin bongla kigona vutvam chu alokhoma, gebuh pam muntheng lai khatna akoiding, chule Israel chate houkhom ho-a dinga kisekhena twija mandinga koiding ahi: hichu chonset suhtheng na hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule bongla kigona vutvam lohkhompa chun avon asopma, nilhah geija atheng louva umding ahi: chule hichu Israel chate le alah uva namdang akholjin khompiu ho-a dinga a-itih-a dinga dan hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Koi hile thilong tongkha-a chu nisagi thenglouva umding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hiche twija chu anithum nile kisuthenga, anisagi nile amachu thengding ahi; ahin ama anithum nile akisuhtheng louva ahile, anisagi lhinni jongle thenglou ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi khattou mithi long tongkha-a, chule kisutheng louchun, Pakai houbuh asuhboh ahin; amachu Israel chate lah-a kona kipaimang ding ahi. Ajeh chu achunga kise khenna twi akithe khumpon, ama chu athenglou hiding; athenlouna chu achunga umnalai ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichehi mikhat pon in'a athi tenga dan ding chu ahi: pon in sunga hunglutho jouse le, pon in sunga um jouse chu nisagi thenglou diu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule asunga um kong le bel asin umlouva kihong jouse chu athenglou hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule koi hijongle tol lhanga chemjam'a kithat, ahiloule mithilong, ahiloule mithigu, ahiloule lhankhuh tongkha-a chu nisagi athenglou hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hiche athengloupa dinga chu amahon chonset thensona bongla kigona vutvam hochu alahdiu, chule twi longlai toh kongsunga ahaldiu,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutengle mitheng khatnin hyssop alah-a, twija chu adelutna, ponbuh chung le kongho chung jouse le mi aumho chung jouse-a, migu, ahiloule akithat, ahiloule mithi, ahiloule lhankhuh tongkhapa chu athinkhum ding:
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule mithengpa chun athengloupa chu anithum channi, chule anisagi channile athin khum ding ahi: chule anisagi channi le amajong kisuthenga, avon asopma, atahsa twija kisilngim ding, chule nilhah lam lebou thengding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin mi athenglou, ama le ama kisutheng lou chu, houkhom ho lah-a kona kipaimang ding ahi; ajehchu mipa chu Pakai muntheng asuhboh ahi: achunga kisekhena twi akithin khumlou ahin; amachu athenglou ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hichu amaho dinga a-imatih channa dinga chondan hiding ahi. Chule kisekhena twi chapma pangpen pen chun apon akisop ding; chule kisekhena twi tongkha penpen chu anilhah geija aboh-a umding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule ipi hijongle atheng loupan athamkhah tapou chu aboh hiding ahin; chule chuche thil tongkha pa chu nilhah geija bohding ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Israel chate, houkhom ho pumpi ngei chu lha masa sungin Zin gamthip ahung lhungun ahi. Chuin mipi ho chu Kadesh'a gebuh akisonun; chule hia chun Miriam athin, hia chun avuitaovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hia chun houkhom ho ding twi aumtapon; chuin amaho Mosi le Aaron dounan akikhom khom taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin mipin Mosi akinah piuvin, hitin atiuve, Isopihou Pakai angsunga anathi laijuva chu Pathen'in eina thisah-u hitavele!
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ipidinga keiho le kagancha hou hi hikoma thi dinga, nangman Pakai houkhom ho hi hiche gamthima neipuidoh-u ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule ipi dinga keiho hiche gitlouna muna hi puilut dinga Egypt gama kona neihung doh sah-u ham? Hiche hi muchi, thei changho, lengpitheiho, kolbuthei ho mun jong ahipon; twidon ding jeng jong aumpoi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi le Aaron chu mipi kikhom mitmu tah-a chun houkhom ho houbuh kot lama chun achelhon tan, amai tolla asulut lhonin ahi: chuin Pakai loupina chu ahenguva ahung kilahtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tenggol chu kilah-in, chule nangma le nasopipa Aaron'in mipi chu khomkhom lhoninlang, amitmu tah-un songpi jah-a chun thu seilhonin; hichun atwi ahin putdoh sah-a, chutia chu nangman songpi-a kona chu twi naputdoh sah ding ahi. Chutengle nangman houkhom ho le aganchahou twi napeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ama thupeh bangin Mosi'n tenggol chu Pakai angsunga konin akilahtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Mosi le Aaron'in houkhom ho chu songpi masanga chun akhom lhonin; chule ajah uva, Tun doumah bolho nanghon ngaijun; hiche songpi-a kona hi twi kalon dohsah teitei lhonding ham? ati lhone.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Mosi'n akhut chu adomsangin, atenggolin songpi chu nivei avon ahi. Chuin twi chu neng jengjungin ahung longdoh tan, hitichun houkhom ho le agancha houvin jong adonun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin Mosi le Aaron jah-a, Nangnin Israel chate mitmu-a suhtheng dinga neitahsan lhonlou jehchun; hiche mihohi keiman kapeh gamsunga chu napuilut lhon louding ahitai, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche hi Meribah twi ahi; ajehchu Israel chaten Pakai chu akidou piuvin, chuin Ama amaho-a chun suhthengin aumin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Mosi'n thupole ho chu Kadesh'a konin Edom lengpa koma asolin, ahenga, Nasopipa Israel'in hitin aseije, nangman kachunguva lhung hahsatna ho jouse nahesoh keijin:
  </para>
  <para style="p">
    <verse number="15" style="v" />Itobanga kapu kapateu chu Egypt gama anachesuh uva, chule keiho Egypt gama phat sottah kana chennuva; chule Egypt mihon keiho le kapu kapateu einabol genthei danhou;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keihon Pakai henga kapen phatnun, aman ka aw-u ajatan, vantil khat ahin solin, Egypt gama konin eipuidoh-un ahi. Chule ven, keiho Kadesh mun, nagamgi china um khopi khatna kaumuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Katao ahi, Nagamsung neijot galkaisah-un: keihon loulai ahiloule lengpithei leiho lah kajot loudiu, twikul ho-a twi jong kadon loudiu ahi: lengpa lamlena bou kacheuva, nagamgi sung kagalkai kahseuva jetle veija jong kakihei loudingu ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Edom'in ahenga, nahung galkai theilou dingu ahi, achutiloule nangdouna-a chemjam toh kahung konding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Israel chate chun ajah-a, Keiho lamlena chu kache dingu ahi: chule ijemtia kei le kagancha hon natwi kadon uva ahile, aman kapeh dingu ahi: imacha dang bollouva kenga bou kache galkai dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman, Nagalkai theilou ding ahi, ati. Chuin Edom chu amaho dou dingin mi tamtah le galsatmi hat tahho toh ahung kon taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitichun Israel gamgi galkaisah ding Edom anomtapon; hijeh chun Israel chu ama-a konin achoma akihei mangtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Israel chate, houkhom ho jouse ngei chu Kadesh'a konin ahung kitolun, Hor molsang ahung lhung taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Edom gamgia Hor molsanga chun Pakaiyin Mosi le Aaron henga chun aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aaron amitetoh kigom khom ding ahitai; ajehchu ama Israel chate kana peh gama chu lutlou ding ahi, ajehchu Meribah twija chun kathu dounan nakiphin lhonin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aaron le Achapa Eleazar chu kouvun lang, Hor molsanga hinpui touvin:
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Aaron vonho chu sutlhan lang, achapa Eleazar vonpeh-in: chule Aaron amitetoh kigoma khoma, hia chu thiden ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Mosi'n Pakai thupeh bangin abolin: houkhom ho jouse mitmu-a chun amaho Hor molsang lama akaltou taovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Mosi'n Aaron vonho chu asutlhan, achapa Eleazar chu avonpeh-in; chule hiche molsang chunga chun Aaron athitan ahi: Chuin Mosi le Eleazar chu molchunga kon chun ahung kumsuh lhontan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin houkhom ho chun Aaron thi chu amu phatnun, amaho Israel insung pumpi ngei chun Aaron chu nisomthum alunghem piuvin ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin lhanglama cheng Canaan mi Arad lengpa chun gam velhi lampia ahunguve tia kisei ajah phatnin; Israel chu akisatpin, amaho lah-a phabep jong gal hingin ahinkaijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Israel chu Pakai henga kihahsel in, Tahbeh-a nangman hiche mihohi kakhutna neipeh doh-a ahile, keiman akhopihou kasuhmang hel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakaiyin Israel aw chu angaipeh-in, Canaan miho chu akhutna apedoh tan; chuin amahon amaho le akhopi hou chu asumang hel taovin ahi. Chule aman hiche munchu Hormah tin asahtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amaho Hor molsanga konin Edom gam velkolna dingin twipisan jotna lampi lamchu ajonkit taovin; chule mipi ho chu lampi jeh-in alungu alha lheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin mipi ho chun Pathen le Mosi dounan thu aseitaovin, Ipi dinga nangnin Egypt gama kon hiche gamthipma thiding gunsetna neipuidoh uham? Ajehchu changlhah jong aumpon, chule twi jongla aumhih-in, kahinna-un hiche changlhah jangthet thut hi akidah tan ahi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin mipi lah-a chun gulgu khohtah ahin lansahtan ahileh, hicheho chun mipi ho achu-in: Israel mi tamtah athitan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hijeh chun mipi ho chu Mosi henga ahungun, Keihon Pakai le nangma dounan thu kaseijun kachonse taovin ahi; Aman gul hohi keiho lah-a kona alahmang nadingin Pakai henga taovin, atiuve. Chuin Mosi mipi dingin ataotan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Mosi jah-a, Gulse khohtah khat lim seminlang, hichu mol lhon leh-a tahdoh-in, chule hitiding ahi, gul'in achuh tapou chun sum-eng gul chu avetna ahile hingding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n sum-eng in gullim khat asemin, hichu mol lhon leh-a atah-in, chuin ahitin ahi, gul chun khat tou achuh-a, achuhpa chun sum-eng gullim chu avetteng ahingjin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Israel chate chu akitollun, Oboth munna pon-in akison taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho Oboth'a konin akitolun, Moab toh kigalsai nisolam Ije-abarim gamthipma pon-in akisonun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichea konchun amaho akichonun, Zared phaichama pon-in akisonun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichea konchun amaho akichonun, gamthipma um, Amor mite gamsunga kona hungdoh Arnon gal langkhat lama chun pon-in akisonun ahi. Ajeh chu Arnon hi Moab le Amor kikah-a um Moab gamgi ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun Pakai galsatnaho lekhabu sunga, Aman twipisan le Arnon vachaho-a athilbol,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Moab gamgia um Ar chenna mun'a lunglha vachaho-a athilbol, tin akisunin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin hichea konchun amaho Beer'a achetouvun ahi: hichemun chu Pakaiyin Mosi jah-a, Miho chu khom khomin, chule keiman amaho chu twi kapeh ding ahi, tia aseina twikhuh chu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuphatnin Israel ten hiche la hi asaovin; Vo twikul, twiput sah-in, nanghon ahenga la saovin:
  </para>
  <para style="p">
    <verse number="18" style="v" />Danthu pepa thupeh dungjuijin, atenggolun pipuihon twikhuh alaijun, miloupi hon twikhuh alaijun ahi. Chuin amaho gamthipma konin Mattahan'a achetauve ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Mattanah'a konin Nahaliel: chule Nahaliel'a konin Bamoth:
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Moab gamsunga phaichama um Bamoth'a konin Jeshimon kimu phahna Pisgah molvum alhungun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Israel ten Amor mite lengpa Sihon koma thupo ho asolun, ajah-a,
  </para>
  <para style="p">
    <verse number="22" style="v" />Nagamsung neijot galkai sah-un; keiho loulai le lengpilei laija kakiheilut loudiu; twikhuh-a twiho jong kadon loudiu: gamgi kakhelto kahseuva lengpa lamlen bou kajot dingu ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Sihon'in Israelte chu gamsung agalkai diu chu aphaltapon; ahin Sihon'in amite jouse akhom khomin, gamthipma Israel sat dingin akontan ahi. Chuin ama Jahaz'a ahungin, Israelte toh akisattai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Israel ten amachu chemjamin athat uvin; agam chu Arnon'a pat Jabbok gei, Ammon chate gam geijin alotaovin ahi. Ajeh chu Ammon chate gamgi chu hat tah ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Israel ten hiche khopi ho chu alauvin; chule Israelte chu Amor miho khopi jouse, chule Heshbon le akhoneo jouseuva acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Heshbon hi Moab leng masapa galla anasatna, agam jouse Arnon geija akhutna kona analahpeh-a Amor mite lengpa Sihon khopi ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijeh chun amahon thuchih-in aseijun, Heshbon'a hungun, Sihon khopi kigong henlang kisahen:
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu Heshbon'a konin mei ahungkan, Sihon khopi-a konin meikou ahung kongdoh-in; hichun Moab gama um Ar, chule Arnon munsanga pakaiho chu akavamtan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Moab, nangma ada nahi! Vo Chemosh mite amangthah nahitaove: aman asohcha achapateho le achanute chu Amor mite lengpa Sihon henga gal hinga kaidin apetan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Keihon amaho kakapmun; Heshbon chu Dibon geijin amangthah tan, chule keihon Medeba lhunna Nophah geijin kamhellin kalha taove, tin aseijun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hitichun Israelte chu Amor miho gama acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Mosi'n Jaazer velhiding mi asoldoh-in, chule amahon hiche khoho chu alauvin, chua cheng Amor miho chu anodoh taovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin amaho ahung kile kitnun Bashan jotna lampia akaltouvun ahi. Chuin Bashan lengpa Og chu amaho satdin, amale amite jousetoh Edrei galmuna galsatdin ahung kondoh taovin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Pakaiyin Mosi jah-a, Amakhu kicha hih-in: ajehchu keiman amale amite jouse, chule agam khu nakhutna kapeh doh ahitai; nangman amakhu Heshbon'a um Amor mite lengpa Sihon nabolna bang banga nabolding ahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hijeh chun amahon amale achapate chule amiteho jouse chu khatcha jong ahing doh abeihel kahsen athatgamun ahi: chuin amahon agam chu alotaovin ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israel chaten malam anouvin, Jericho kom Jordan gal Moab phaichama chun gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Zipper chapa Balak chun Israel ten Amor miho chunga anabol jouse chu amusoh keijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Moab chun miho chu atamjeh-un akicha lheh jengtan: chule Moab miho chu Israel chate jeh-in alungu athoilheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Moab'in Midian upaho henga chun, Tu-a hi bongchalin loujaova hampa aneh jouhel banga, hiche mihonpi hin iveluva umjouse hi aneh jouhel dingu ahi, ati. Chule chuphat laija chu Zippor chapa Balak hi Moab mite lengpa hija ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun aman ama miho chate gam, vapi panga um Pethor kho-a Boer chapa Balaam koudin sotol ho asolin, ahenga, Vetan Egypt gama kon hungpot doh mihon khat aume: ven, amahon leiset chung alodimun, chule amaho keimatoh kimaito tah-in aumuve;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun tun, katao ahi, keiman amahohi kajo-a, katha gamuva, hiche gama kona kadelmang thei nadingun, hungin lang hiche mihohi hung gaosapmin; ajehchu amahohi keima dingin ahatbeh seh-un ahi: ijeh inem itile nangman phatthei naboh mi chu phatthei achangin, koihile nagaosap mi chu gaosap achange ti kahei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Moab upaho le Midian upaho chun aisan kipa manding hochu achoijun, akipat doh-un, Balaam henga ahungun, Balak thusei chu ajah-a asei taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman amaho koma, Tujan hikoma hin geh-un lang, Pakaiyin keima koma aseibang bangin keiman nangho koma thu hinpokit nange ati. Hitichun Moab puiho chu Balaam toh agehkhom taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pathen chu Balaam henga ahungin, ajah-a, Naum khompi miho khu koi hiuvem? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Balaam'in Pathen henga, Moab lengpa Zippor chapa Balak-in kahenga ahinsola,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ven, Egypt gama kona hungpot doh-a leiset chung lodima mihon khat aumuve: Tun hungin lang amahohi eihung gaosap peh-in, keiman amaho kajo-a, kadeldoh jou thei khat le gatin tia ahinsol ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin Balaam jah-a, Nangma amaho hitoh nakilhon louding; chule nangman hiche mihohi nagaosap louding ahi; ajehchu amaho phattheiboh chang ahiuve, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin jingkah-in Balaam athoudoh-in, Balak pipuiho jah-a, Nagam lamuva kilekit taovin; ajehchu nangho toh lhonkhoma chedingin Pakaiyin eija nompoi, tin aseitan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Moab pipuiho chu akipat doh-un, Balak henglama acheuvin, Balaam keihotoh hungding anompoi, agatiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Balak in pipuiho amaho sanga ja-umtah cheh asolkit nalaijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amaho Balaam henga ahungun, ahengah, Zippor chapa Balak'in hitin aseije, Katao ahi, kahenga nahung nadingin imacha kidal tansah hih-in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu keiman nangma jana lentah kapeh-a kachoi sang ding, chule nangman kahenga nasei chan chu kabolding ahi: hijeh chun hungin lang hiche mitehi neihung gaosap peh-in, atie atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Balaam'in Balak sohte henga chun adonbutnin ajah uva, Balak'in a-in dimset sana dangka eipeh ding hijongle, keima Pakai ka Pathen thu kalvalin tamtah bolding hihen, lhomcha bolding hijongle che ponge;
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun tun, naheng uva katao ahi, Pakaiyin kahenga ipi aseibe-am kahet theina dingin, tujan jong hi-ah geh kitnun, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin jan-in Pathen chu Balaam henga ahungin, ajah-a, Miho chu nangma kou-a hung ahiule kipat in lang amahotoh kilhonin, amavang keiman nahenga kasei thubou chu nabol ding ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Balaam jingkah-in athoudoh in, asangan pho asepdoh in, Moab pipuiho chutoh alhontai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ama ache jehchun Pathen lungsat asoujahtan: Pakai Vantil chu ama douna-a kimaitopi din lampia chun anadingtan ahi. Hichepet nahi ama sangan chunga touva, asoh minin akilhonpi ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin sangan chun Pakai Vantil khatnin akhutna chemjam achoija lampia adin amutan ahi; chuin sangan chu lamsih lama akiheidoh-in, loulai langa achetan ahi. Chuin Balaam'in sangan chu lampia heilutna din avon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahin Pakai Vantil chu alang teni-a bang umgel lengpilei lampia chun ana dingin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin sangan nin Pakai Vantil chu amuphatnin bang suhnan akineijin, Balaam kengchu bang toh atat cheptan ahile, aman avokitnin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakai Vantil chu ache gamla jepmin, jetle vei akiheina ding lampi umlou munneo laitah khatna anading tan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin sangan chun Pakai Vantil chu amuphatnin, Balaam noija a-optan ahi. Chuin Balaam lungsat chu akoujah tan, aman sangan chu tenggolin avon ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Pakaiyin sangan chu ahin paosah-in, aman Balaam jah-a, Keiman nangma chunga ipi kabola hitia hi thumveijen neivoh ham? ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Balaam'in sangan jah-achun, Nangin neidai chatvai jeh ahi, kakhutna chemjam umlebon kathading nahi, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin sangan chun Balaam henga, Keima nasangan kahilou hija, nanga kahia patna tuni chan geija kachunga nahung tou jing hilouham? hitobanga hi masanga nachunga kanabol khah-em? ati. Chuin aman, Nabolkhapoi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Pakaiyin Balaam mit ahadohsah-in ahile, aman Pakai Vantil lampia adina akhutna chemjam adopchu amutan ahi. Chuin ama akunin, tolla aboh khupmin chibai aboh tan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Pakai Vantil chun ajah-a, Ipi dinga nangman sangan chu thumvei jen navoh ham? Ven, nalampi hi kamitmu-a akaleh lam ahi jeh-a, nangma lamtin dinga hungkon doh-a kahi;
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahin sangan chun keima eimu-a, keija kona thumveijen kihei doh ahin, ama kiheidoh lou hile tu-a hi thonlouva nangma katha-a ama kahinghoi ding ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Balaam'in Pakai Vantil hengah, Keima kachonse tai: ajehchu keiman douna-a lampia nadinna nei lamtin chu kahetlou ahi. Hijeh chun tun, hiche nangma lunglhai louna ahile, keima kilekit tange, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Pakai Vantil chun Balaam henga, Miho khutoh lhonin, amavang keiman kaseipeh ding thubou chu nasei ding ahi, ati. Hitichun Balaam chu Balak pipuiho chutoh alhontan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Balak in Balaam hungchu ajah phatnin, Arnon gamgi mong lhapeh-a um Moab khopi khatna ana kimutopi dingin ahungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Balak'in Balaam henga, Keiman nangma kou dinga lungnem tah-a mi kahinsol hilouham? Ipi dinga kahenga hunglou nahim? Keiman nangmahi ja-um tah-a katunmo-a nabol ham? ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Balaam'in Balak henga, Ven, keima nahenga kahungtai; keiman tu-a hi ipi hijongle seina ding tha kaneibeh-em? Pathen'in kakama akhum thu bou chu kaseiding ahi, ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Balaam chu Balak toh akilhonin, Kirjath-huzoth'a ahunglhon tan ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Balak'in bongchal ho le kelngoi ho atohdoh-in, Balaam le aumpi pipuiho henga chun athot tan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin ajingin ahitin ahi, Balak'in Balaam chu apuijin, mipi ho jouse amutheina dingin, Baal munsang ho-a chun apuitou tan ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Balaam'in Balak henga, Hikomahin keima dingin maicham sagi seminlang, chule bongchal sagi le kelngoichal sagi neigot peh-in, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Balaam'in aseibang chun Balak'in aboltan: Balak le Balaam chun maicham chung tinna chun bongchal khat le kelngoichal khat atohdoh lhontan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Balaam'in Balak henga, Nagovam thilpeh koma hin ding jingin, keima kimupi dinga Pakai ahung khattoule, keima gacheng ting, chule aman eimusah tapou chu seipeh nange, ati. Chuin ama munsang khatna achetan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pathen'in Balaam akimupin ahi. Chuin aman ahenga, Keiman maicham sagi kagongin, maicham jouse chunga chun bongchal khatle kelngoichal khat cheh katoh-in ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin Balaam kamsunga thu akoipeh-in, ajah-a, Balak henga kilekit ninlang, gaseipeh in, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ama ahenga akile kitnin ahile, veuvin ama le Moab pipuiho jouse chu govam ganlhaina koma chun anadingun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman athulemin thu aseipaijin, hitin ati, Moab lengpa Balak'in Aram gam solamsang molsang ho-a konin eihin puijin, kajah-a, Hungin lang Jacob neihung gaosappeh-in, hungin lang Israel hung chouvin, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen'in agaosap louho chu ken iti kagaosap dingham? ahiloule Pakaiyin achoulou chu ken iti kachou ding ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu keiman songpiho chungvuma konin ama kamun, chule lhang ho-a konin ama chu kaven ahi: veuvin, mipichu achanguva chengdio, namtin lah-a kisim thei louding ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Koiham Jacob leivui simjou ding le Israelte hoplia hopkhat simjou dinga? michonpha thin neithisah inlang, kahinkho bei danjong ama-a tobang hihen, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Balak'in Balaam jah-a, Kachunga hi ipi nabol hitam? Keiman kamelmate gaosap dinga kapui nahin, ahin, vetan, nangman amaho phatthei naboh jotan ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman adonbutnin, Pakaiyin kakama eikhumpeh hohi kaseidoh nadinga kachihthei ngailou dingham? ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Balak'in ajah-a, Katao ahi, hungin, chukoma kona chu amaho namuthei nadin, keimatoh munchom khatna che hite; chua kona chu nangman apamnung pen hobou namu ding, abonchauva namulou ding ahin, amaho chu keima-a dingin neigaosap peh-in, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman ama chu Sophim loulai, Pisgah molsang vuma chun apuijin; chule maicham sagi asemin, chule bongchal khat le kelngoichal khatcheh maicham takip chunga atoh-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman Balak henga, Keima Pakai to gallanga kakimuto laisen, nangma govam thilto phunga ding jingin, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin Balaam akimupin, akama thu akhumpeh-in, ajah-a, Balak henga chekitnin lang, hitin seijin ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ama ahenga ahunga ahile, veuvin, ama thilto phunga chun Moab pipui hotoh anadingun ahi. Chuin Balak'in ahenga, Pakaiyin ipi aseijem? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman thulem aseipanin, hitin ati, Kipatdoh-in Balak, ngaijin; nangma Zippor chapa, kathusei hi ngaijin:
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathen chu jou seiji-a mihem ahipon; chule lungheiji-a mihem chapa jong ahipoi; Aman aseisa chu abolda dingham? ahiloule aseidohsa chu abolphat lou dingham?
  </para>
  <para style="p">
    <verse number="20" style="v" />Vetan, keiman phatthei bohna ding thupeh kamutan' chule aman phatthei aboh ahitan, keiman lehei thei ponge.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman Jacob khangitlouna, chule Israel'a jong chonvalna amupoi: Pakai a-Pathen chun aumpin, chule lengpa khosap awgin chu alah uva aumin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathen'in amaho chu Egypt'a kona ahin puidoh ahin; aman sakol kinei thahat tobang aneijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jacob douna ding themthu aumpon, chule Israel douna dingin aisan theina jong aumpoi: Tu-a hi Jacob le Israel thudola Pathen'in ipi abol hitam! kiti ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vetan, hiche mite hi keipi bahkai lentah banga thoudoh dingu, keipi bahkai khangdong banga dingdoh ding ahi: aman a-anchah aneh masangse le asatha thisan adon masangse-a kol louding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Balak'in Balaam henga, Amaho hi gaosap jong gaosap hih-in, phatthei jong phatthei boh hih-in, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahivangin Balaam'in Balak adonbutnin, Pakaiyin asei jouse chu kaboltei ding ahi, tia kaseipeh nahilou ham? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Balak'in Balaam henga, Hungin, katao ahi, munchom khatna napui jing kate; chua konchun amaho neigaosap peh lechun Pathen lunglhai maithei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Balak'in Balaam chu Jeshimon lam kimuna Peor molsang vuma apuijin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Balaam'in Balak henga, Hikoma hin maicham sagi neigon peh-in lang, kelngoichal sagi gotsan neikoi peh-in, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Balak'in Balaam seibang chun abolin, maicham takip chunga chun bongchal khat cheh le kelngoichal khat cheh atohtan ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Balaam'in Israel chapate phatthei abohding chu Pakai lungdei ahi, ti ahet phatnin, phatdang bangin themthu holin achedoh tapon, gamthip lam johchu amaingat tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Balaam akhodah-in ahile, Israel chu aphung dungjui cheh-a agebuh uva aumu amun ahi, chuin Pathen lhagao chu achunga ahung chutan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman athulem aseipanin, hitin ati, Boer chapa Balaam thuseidoh; amit kihadoh sahpa thuseidoh:
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen thuho ja-a, hat chungnungpa gaothilmu-a mupa, kipal lhu-a ahivanga amit hahjingpa thuseidoh ho:
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Jacob, naponbuh ho iti hoi hitam! Chule vo Israel, nahoubuh ho iti hoi hitam!
  </para>
  <para style="p">
    <verse number="6" style="v" />Phaicham bangin akiphajal deh-in, vadung panga honleiho abangin; Pakai phudoh Aloes thingphung hole, twipanga Cedar thingphung ho toh abangin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman atwibel ho-a konin twi hinbung lhantin, achilhahte chu twi tampi lah-a umdiu; alengpa jong Agag sanga sangjo ding, chule alenggam chu kichoisang ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen'in ama Egypt gama kona ahin puidoh ahin, aman sakol kinei thahat tobang aneijin ahi: akidoupi namtin vaipiho anehjou ding, aguhou ahe ngema, athalchanga athilpai dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama aboh-in, keipi bahkai bangin, chule keipi bahkai lentah bangin akole: kon ama asuhthou ngam ding ham? Nangman phatthei naboh chan phatthei changhen lang, nagaosap chan chu gaosap changhen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Balaam chunga chun Balak lungsat akoujahtan, akhut teni abengton ahi: chuin Balak'in Balaam jah-a, Kamelmate gaosap dinga kakou nahin; ahin, vetan, nangman amaho thumvei jen hi phatthei nabohtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun tun naumna lama jamtan: keiman jana lentah chang dinga tundoh kagot nahin; ahivangin, vetan Pakaiyin nangma jabola naumna dinga konin natingtan tan ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Balaam'in Balak henga, Kahenga nahinsol miho henga jong kaseisa hitalou ham?
  </para>
  <para style="p">
    <verse number="13" style="v" />Balak'in keima sana dangka a-in dimsetna eipeh ding hijongle, Pakai thupeh kalvala kachama aphabolna hihen, asebolna ding hijongle kabollou ding ahi; amavang Pakaiyin aseiho bouchu kaseiding ahi, kati hilou ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule tun, vetan keima kamite henga kache ding ahitai; hijeh chun hungin, hiche miho hin ni nunung nile namite henga ahin thilbol dinghou chu seipeh-inge, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman athulem aseipanin, hitin ati, Beor chapa Balaam thusei ho, chule amit kihadoh sahpan thusei ho:
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathen thupeh ho japa le chungnung pen hetna thudol hepa, hat chungnung pen gaothilmu-a mupa, kipal lhu-a ahivanga hahjingpa thuseidoh ho:
  </para>
  <para style="p">
    <verse number="17" style="v" />Keiman ama chu kamuding ahin, tuvang hilouding; keiman amachu kavet ding ahin, naicha vang ahipoi: Jacob'a kona Ahsi khat hungdoh-a, Israel lah-a kona leng tenggol khat hung kitungdoh ding; hichun Moab ningkoi ho avoh-a, chule Seth chateho jouse asuhmang ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Edom chu chanvou hung hiding, Seir jong amelmateuva dinga chanvou hung hiding ahi: chule Israel ten hangsan tah-a aboldingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lengvai podingpa chu Jacob'a kona hungdoh-a, khopi-a umdenpa chu asuhmang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman Amalek lam aven athulem aseipanin, hitin ati, Amalek hi chitin namtin bulpi ahinan, amavang akichaina ding chu tonsotna manthah na hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman Ken miteho aven, athulem aseipanin, hitin ati, Nachenna mun chu dettah ahin, nabuh chu songpi chunga nakiset in ahi:
  </para>
  <para style="p">
    <verse number="22" style="v" />Hijeng jongle Asshur'in gal hinga nakaimang kahse-a, Ken chu suhsetna umding ahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman athulem aseikitnin, Ohe! Pathen'in hitia hi ahinbol tengle, koi hingjou tantem!
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Chittim gamkaija konin kong inneiho hunguntin, Asshur le Eber chu asuh gentheidiu, chule amajong a-itih-a dinga mangthah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Balaam akipatdoh-in, aumna lama akile kit tai. Chule Balak jong alampia achetan ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israelte chu Shittima achengun, chule miho chun Moab chanute toh jonthanhoi abolpan taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amaho chun Israelte chu a-pathen hou ganlhaina-a akoutaovin; chule miho chun aneovin, a-pathenhou anga abohkhup taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Israel chun Baal-Peor chu ajoptan ahile, Pakai lungsat chu Israel chunga akongjah tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakaiyin Mosi henga, Mipi lamkaiho jouse chu puijin lang, tijat umtah Pakai lungsatna chu Israel te-a kona akichon mangtheina dingin, Pakai masang nisanoi tah-a khailih-in ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Mosi'n Israel thutan ho henga, Nangho amitakipmin Baal-Peor jopma amite jousechu that cheh hen, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin veuvin, Israel chate lah-a mi khat ahungin, Mosi mitmule Israel chate houkhom ho houbuh kot maija kapma-um miteho mitmu-a chun Midian mi numei khat asopiho henga ahin puijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Aaron thempu chapa, Eleazar chapa Phinehas in hichu amuphatnin, houkhom ho lah-a konchun akipatdoh-in, akhutna tengcha khat akichoijin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Israel mipa chu pon in sunga ajuilutnin, anilhonin Israel mipale numeinu chu a-oipi laitah chu asunpai tan ahi. Chutichun Israel lah-a konin hise chu atangtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche hise-a thi chu sangsomni toh sangli ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aaron thempupa chapa Eleazar chapa Phinehas'in kalung hanna chu Israel te-a konin aheimangin ahi; ajehchu kathangthipna-a Israel chate kasuhmang lounadin, amaho lah-a keiding jal-in athang thipmin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun hitin seijin, Ven kachamna kakitepna chu ama kapetan ahi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hichu ama le ama nunga achilhah hon anei dingu, a-itih-a thempu hina dinga kitepna ahi; ajehchu ama a-Pathen'a dingin athang thipmin, Israel chate-a dingin longlhenna chu abolin ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tun akithatna Israel mipa, Midian numei nutoh kithat koppa min chu, Zimri ahin, Salu chapa Simeon miho lah-a insungmi upa khat ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Midian numei akithatnu minchu Cozbi ahin, apa Zur chu mipi chunga lamkai, Midian miho insunga mi upa khat ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Midian ho chu sunohphah inlang, chule sugammin:
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu amahon Peor chungchang le, Peor jeh-a hise lan mikho-a kithat Median pipupa chanu Cozbi le asopinu chungchanga alungthim gilouvun nasunoh phah-un ahi, ati.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hise umjou chun ahitin ahi, Pakaiyin Mosi le Aaron thempupa chapa Eleazar henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate houkhom ho lah-a konin apu apateo insung kailhah-a, Israelte galsatna konthei cheh kum somni-a pat chunglam sese simdoh lhonin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi le Eleazar thempupan amaho chu Moab phaicham Jordan pang Jericho naija chun akihoupi lhonin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin Mosi le Egypt gama kona hung potdoh Israel chateho thu apeh bangin, mipi ho kum somni apat chunglamse chu simdoh-un, atilhone.
  </para>
  <para style="p">
    <verse number="5" style="v" />Reuben, Israel chapa lenpen: Reuben chateho chu: Hanoch'a kon Hanoch insung mite ahung kondoh-un: Pallu'a kon Pallu insung mite ahung kondoh-un ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezron'a kon Hezron insung mite: Karmi'a kon Karmi insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichengse hi Reuben inko ahiuvin: chule amaho akisimdoh sese chu sangsomli le sangthum toh jasagi le somthum ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Pallu chapa chu Eliab ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Eliab chapate chu Nemuel, Dathan, chule Abiram ahiuve. Hiche Dathan le Abiram hi ahi houkhom ho lah-a minthang tah Korah le akiloipihon Pakai anelkal laijuva amahoto ana kiloija Mosi le Aaron ana nelkala teni chu.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hicheho loi athiu chun leisetnin akam akan, amaho chu Korah toh avallhum than, meijin mi janitoh somnga akalih-in, amaho chu melchihna khatnin ahung pangtaove.
  </para>
  <para style="p">
    <verse number="11" style="v" />Achuti jeng vang chun Korah chate chu athipon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Simeon chapate chu insungu dungjuijin: Nemuel'a kon Nemuel insung mite: Jamin'a kon Jamin insung mite: Jachin'a kon Jachin insung mite:
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerah'a kon Zerah insung mite: Shaul'a kon Shaul insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichehohi Simeon insungmiho ahiuvin, Sangsomni le sangni toh jani ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad chateho chu a-insungu dungjuijin: Zephon'a kon Zephon insung mite: Haggi'a kon Haggi insung mite: Shuni'a kon Shuni insung mite:
  </para>
  <para style="p">
    <verse number="16" style="v" />Ozni'a kon Ozni insung mite: Eri'a kon Eri insung mite:
  </para>
  <para style="p">
    <verse number="17" style="v" />Arod'a kon Arod insung mite: Arali'a kon Areli insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiche hohi Gad chate insungmihi akisimdoh dungjuija ahiuvin, Sangsomli toh janga ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Juda chapate chu Er le Onan ahilhonin; chuin Er le Onan chu Canaan gama athilhon tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Juda chapate chu a-insungu dungjuijin: Shelah'a kon Shelah insung mite: Pharez'a kon Pharez insung mite: Zerah'a kon Zerah insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuleh Pharez chapate chu: Hezron'a kon Hezron insung mite: Hamul'a kon Hamul insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche hohi amaho akisim doh dungjuija Juda insung mite ahiuvin, sangsomsagi le sanggup toh janga ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Issachar chapate chu a-insungu dungjuijin: Tola'a kon Tolla insung mite: Pua'a kon Pua insung mite:
  </para>
  <para style="p">
    <verse number="24" style="v" />Jashub'a kon Jashub insung mite: Shimron'a kon Shimron insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichehohi Issachar insung mite akisimdoh-u dungjuija amijat-u chu ahin, sangsomgup le sangli toh jathum ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zebulun chapate chu a-insungu dungjuijin: Sered'a kon Sered insung mite: Elon'a kon Elon insung mite: Jahleel'a kon Jahleel insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hicheho hi Zebulun insung miho akisimdoh-u dungjuija amijatnu chu ahin, sangsomgup toh janga ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Joseph chapate chu a-insungu dungjuijin, Manasseh le Ephraim ahilhone.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasseh chapate chu: Machir'a kon Machir insung mite: Machir'in Gilead ahingin, Gilead'a konin Gilead insung miho ahungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichehohi Gilead chapate ahi: Jeezer'a kon Jeezer insung mite: Helek'a kon Helek insung mite:
  </para>
  <para style="p">
    <verse number="31" style="v" />Asriel'a kon Asriel insung mite: Shechem'a kon Shechem insung mite:
  </para>
  <para style="p">
    <verse number="32" style="v" />Shemida'a kon Shemida insung mite: Hepher'a kon Hepher insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Hepher chapa Zelophehad chun chapa aneitapon, chanu ho bou aneijin ahi. Chule Zelophehad chanute min chu Mahlah, Noah, Hoglah, Milcah chule Tirzah ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hichehohi Manasseh insung miho ahin, chule akisimdoh amaho chengse chu, sangsomnga le sangni toh jasagi ahiuve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hiche hohi Ephraim chapate chu a-insungu dungjuijin, Shuthelah'a kon Shuthelah insung mite: Becher'a kon Becher insung mite: Tahan'a kon Tahan insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule hichehohi Shuthelah chapateho ahi: Eran'a kon Eran insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hichehohi amaho akisim doh-u dungjuija Ephraim chapate insung miho ahiuvin, sangsomthum le sangni toh janga ahi. Hichehohi a-insungu kailhah cheh-a Joseph chapate ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Benjamin chapate chu a-insungu dungjuijin: Bela'a kon Bela insung mite: Ashbel'a kon Ashbel insung mite: Ahiram'a kon Ahiram insung mite:
  </para>
  <para style="p">
    <verse number="39" style="v" />Shupham'a kon Shupham insung mite: Hupham'a kon Hupham insung mite: Naaman'a kon Naaman insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Bela chapateni chu Ard le Naaman ahilhone: Ard'a kon Ard insung mite: Naaman'a kon Naaman insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hicheho hi a-insungu kailhah cheh-a Benjamin chapate ahiuvin, chule akisimdoh-u dungjuijin amaho chu sangsomli le sangnga toh jagup ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hicheho hi Dan chapate a-insungu dungjuija ahiuve: Shuham'a kon Shuham insung mite ahiuve. Hiche hohi a-insungu kailhah cheh-a Dan insung miho ahiuve.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shuham insung mite jouse, akisimdoh dungjuijin amaho chu sangsomgup le sangli toh jali ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Asher chateho chu a-insungu dungjuijin; Jimna'a kon Jimna insung mite: Jesui'a kon Jesui insung mite: Beriah'a kon Beriah insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="45" style="v" />Beriah chapateho chu; Heber'a kon Heber insung mite: Malchiel'a kon Malchiel insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule Asher chanu min chu Sarah ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hichehohi Asher chapate insung miho ahiuvin, akisimdoh-u dungjuijin, sangsomnga le sangthum toh jali ahiuve.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chule Naphtali chapate chu a-insungu dungjuijin; Jahzeel'a kon Jahzeel insung mite: Guni'a kon Guni insung mite:
  </para>
  <para style="p">
    <verse number="49" style="v" />Jazer'a kon Jezer insung mite: Shillem'a kon Shillem insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hichehohi a-insungu dungjuija Naphtali insung miho ahiuvin, amaho akisim doh hochu sangsomli le sangnga toh jali ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hiche hohi Israel chateho jat ahin, sangjagup toh sangkhat toh jasagi le somthum ahiuve.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin Pakaiyin Mosi jah-a thu aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="53" style="v" />Hicheho henga hi gam chu alodinguva aminu kisimdoh dungjuija kihoppeh ding ahiuve.
  </para>
  <para style="p">
    <verse number="54" style="v" />Atamho henga chu nangman alodiu lentah napehding, chule alhomho henga alodiu neocha napeh ding ahi. Amitakip henga chu amijat kisimdoh dungjuija alodiu kipeding ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Hijeng jongle gam chu vang sanna kihomding ahin, apu apateu phungmin kailhah dungjuija amahon alodingu ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Vang kisan dungjuija gam chu atam le alhom kikah-a kihom khen ding ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chule hiche hohi Levi ho a-insungu dungjuija kisimdoh hochu ahiuve; Gershon'a kon Gershon insung mite: Kohath'a kon Kohath insung mite: Merari'a kon Merari insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hiche hohi Levi mite insung miho ahiuvin, Libni mite insung, Hebron insung mite, Mahli insung mite, Mushi insung mite, Kohath insung mite ahiuve. Chule Kohath'in Amram ahingin ahi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chule Amram jinu minchu Jochebed ahin, Levi chanu, anun Egypt gama Levi'a dinga ahinpeh ahi: chule amanun Amram chu Aaron le Mosi chule asopinu lhon Miriam ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Chule Aaron'in Nadab, Abihu, Eleazar le Ithmar ahingin ahi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Ahin Nadab le Abihu chu Pakai anga mei thenglou ato pet lhonin athilhon tan ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chule amaho Pasal lha khatna pat chunglamse akisimdoh hochu sangsomni le sangthum ahiuve. Ajehchu amaho chu Israel chate lah-a goulo ding akipeh lou jeh-un, Israel chate lah-a akisimtha pouvin ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Hichehohi Mosi le Eleazar thempupan, Moab phaicham, Jordan pang, Jericho naija asimdoh lhon Israel chate chu ahiuve.
  </para>
  <para style="p">
    <verse number="64" style="v" />Ahivangin Mosi le Aaron thempupan Sinai gamthipma Israel chate anasim lhon miho chu amaho lah-a hin khatcha beh jong aumtapon ahi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Ajehchu Pakaiyin amaho thudola chun, Amaho thonlouva gamthipma thiding ahiuve, anati ahi. Chutia chu Jephunneh chapa Caleb leh Nun chapa Joshua tilou adang khatcha jong kikhenlou anahitan ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Joseph chapa Manasseh insunga Manasseh chapa, Machir chapa, Hepher chapa, Gilead chapa, Zelophehad chapa ahungun: chule achanute min chu Mahlah, Noah, Hoglah, Milcah chule Tirzah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amaho Mosi le Eleazar thempupa masang, pipui hole houkhom ho jouse masang-ah, houkhom ho houbuh kotbula chun adingun, hitin aseijuve,
  </para>
  <para style="p">
    <verse number="3" style="v" />Kapao chu gamthipma athin, chule Korah loiho lah-a Pakai douna-a kichom khomho loi lah-a chun ana pangpoi; amavang ama chonset na-a thi anahin, chapaho ana neipon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chapa neilou jeh-a kapamin chu ipi dinga a-insung mite lah-a kona paidoh-a umding ham? Hijeh chun kapao sopi holah-a chankhat neipeuvin atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Mosi'n athu chu Pakai henga alhuttan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin Mosi henga thu seijin, hitin ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zelophehad chanute sei chun adih aseiju ahi: apao sopiho lah-a gou chanding napeh tei dingu ahi; chule apao gou chanding chu amaho napeh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangman Israel chate jah-a hitia naseiding ahi; Pasal khat chu chapa beija athia ahile, apa gouchu achanu teo napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla amachun chanu aneilouva ahile, nanghon ama gouchu asopiho napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule aman sopi aneilouva ahile, ama gouchu apa sopiho napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule apao chun sopi aneilouva ahile, nanghon agouchu a-insunguva akinaipi pa henga napeh diu, ama chun aloding ahi. Hichu Pakaiyin Mosi athueh banga Israel chate dinga thutanna chondan hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin Mosi jah-a, Nangma hiche Abarim molsanga hin kaldoh-in lang, Israel chate kanapeh gam khu gaven.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nangman hichu navetjou tengle, nasopipa Aaron kagop khom banga nangma jong namite toh kagop khom ding nahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu Zin nelgama houkhom ho phunchel laijun, twiphunga amitmu uva suhthenga kaumna dinga kathupeh napalkeh lhonin ahi. Hichu Zin gamthipma um Kadesh mun'a Meribah twi chu ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mosi'n Pakai henga thu aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai tipum jouse-a um lhagao Pathen chun houkhom ho chunga mikhat tunghen,
  </para>
  <para style="p">
    <verse number="17" style="v" />Chutia chu Pakai houkhom ho hi achingbei kelngoi abah louna dinguva amasanguva potdoh-a, amasanguva chelut ding, chule amaho puidoh dingle amaho puilut dingin, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pakaiyin Mosi jah-a, Asunga lhagao um mipa, Nun chapa Joshua chu kipuijin lang achunga nakhut ngamin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amachu Eleazar thempupa le houkhom ho jouse masanga dinsah inlang, amitmuva chun mopohna pen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel chate houkhom ho jouse seingai ahina diuva, ja naumna phabep chu achunga nakoiding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule ama Eleazar thempupa anga ding ding, chule amachun Pakai angsunga Urim thutanna dungjuija ama-a dinga thumop athumpeh ding ahi. Ama le Israel chate jouse, houkhom ho jouse ngeichu ama thusah-a potnuva, chule ama thusah-a lut ding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Mosi'n Pakaiyin athupeh bangchun abolin; Joshua chu Eleazar thempupa le houkhom ho jouse masanga adinsah tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman achunga chun akhut angamin, Pakaiyin Mosi khutna athupeh bangin amachu mopohna apetan ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi jah-a thu aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate chu thu penlang, hitin seijin, Keima-a dinga thil kitoh ho, keima henga gimnamtui tah hidinga meija kisem kaganlhaina ka changlhah hochu, kahenga akitep phat dungjuija natona dingun chingtheijun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangman ajah uva, Hiche hi Pakai henga dinga meija kisem thilto nato dingu chu ahi; jomjing govam thilto-a ding chu, nolnabei kelngoinou kumkhat lhingbep ni hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kelngoi nou khat chu jingkah lamle nato dingu, chule kelngoi nou adang khatma chu nilhah lamleh nato dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule a-anneh thilto ding chu thao kimehdoh hin khat hopli-a hopkhat toh kihal changbong nel Ephah khat hopsom-a hopkhat hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche hi Pakai henga gimnamtui tah hidinga meija kisem kilhaina, Sinai molsanga kisudetsa jomjing govam thilto chu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule donding thilto ding chu kelngoinou khatna dinga hin khat hoplia hopkhat hiding; munthenga chu lengpitwi chihtah chu Pakai henga donding thito hidinga nasunlhah dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule kelngoi dang chu nilhah lamleh natodiu ahin; jingkah lama anneh thilto bangle donding thilto banga chu Pakai henga gimnamtui hidinga meija kisem kilhaina nato dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule cholngahni leh kumkhat lhingbep nolna beihel kelngoinou ni, chule anneh thilto dinga thao toh kihal changbong nel hopsom-a hopni, chule adonding thilto toh nato tha dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche hi jomjing govam thilto le adonding thilto tilouva jong, hiche hi cholngah niseh-a govam thilto ding chu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nangho lha kipat sehleh Pakaiya govam thilto natodiu; bongchal gol ni, kelngoi chal khat, nolna beihel kumkhat lhingbep kelngoinou sagi nato dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule bongchal khatna dinga, a-anneh thilto ding chu thao toh kihal changbongnel ephah hopsom ma hopthum; chule kelngoichal khatna dinga a-anneh thilpe ding chu, thao to kihal changbongnel ephah khat hopsom-a hopni hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule kelngoinou khatna dinga a-anneh thilto dingachu thao to kihal changbongnel ephah hopsom-a hopkhat hiding ahi; hiche hi Pakaiya dinga meija kisem kilhaina govam thilto gimnamtui chu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule adonding thilto houchu bongchal khatna dinga lengpitwi hin keh khat, kelngoichal khatna dinga hin khat hopthum-a hopkhat, chule kelngoinou khatna dinga hin khat hoplia hopkhat hiding ahi. Hichehi lhaseh-a pumgo thilto, kumlhung keija lhaseh-a bolding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule jomjing govam thilto le adongding thilto tilouva jong, kelchanou khat chu chonset thilto-a dinga Pakaiya nato dingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule lhamasa pen nisomle nili ni chu Pakai dinga kalchuh kut ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hiche lha nisom le ninga nichu kut ahin; nisagi chol solou changlhah nehdingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nikho masapen nile kikhoppi theng umding; hiche sunga chu natoh imacha natoh lou dingu ahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Amavang Pakai henga govam thilto-a dinga meija kisem kilhaina naboldiu, bongchal gol ni le kelngoichal khat, chule kum khatbep kelngoinou sagi nato diu, hiche hochu nolna beihel hidingu ahi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule a-anneh thilto-u chu changbongnel thao toh kihal hiding, bongchal khatna dinga ephah hopsom ma hopthum, kelngoichal khatna dinga ephah hopsom ma hopni hiding ahi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Kelngoinou sagiho jouse dinga chu kelngoinou khat cheh dinga ephah hopsom-a hopkhat hiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nangma longlhen bolna-a kelcha khat chonset thilto dinga nato dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jomjing govam thilto, jingkah-a govam thilto tilouva jong hichengho jonghi nato dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pakai henga gamnamtui hidinga meija kisem kilhaina sa chu hiche banga hi aniseh-a, nisagi lhumkeija nato dingu ahi: hichehi jomjing govam thilto le adonding thilto tilouva jong pehtei dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nisagi nile kikhoppi theng khat nanei uva, natoh imacha natohlou dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ga masa nikho, hapta kut sunga Pakai henga anneh thilto thah nahin to tengu jongleh, nanghon kikhoppi theng nanei diu, natoh imacha natoh lou dingu ahi;
  </para>
  <para style="p">
    <verse number="27" style="v" />Amavang Pakai henga gimnamtui hidinga govam thilto natodiu; bongchal gol ni, kelngoichal khat, kumkhat lhingbep kelngoinou sagi nato dingu ahi;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule a-anneh thilto diu chu changbongnel thao toh kihal hiding, bongchal khatna dinga ephah hopsom-a hopthum, kelngoichal khatna dinga ephah hopsom-a hopni,
  </para>
  <para style="p">
    <verse number="29" style="v" />Kelngoi sagiho jouse dinga chu kelngoinou khatna dinga ephah hopsom-a hopkhat hiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule nangma longlhen bolna dinga kelchaho nou khat nato dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jomjing govam thilto le, a-anneh thilto-u (hicheho chu nolna beihel hidiu,) chule adonding thilto hou tilouva jong hicheho chu nato diu ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule lhasagi channa, hiche lha nimasa nileh nanghon kikhoppi theng khat nanei diu; natoh imacha natohlou diu ahi; hichu nangho dinga sumkon ho mut nikho ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nanghon Pakai henga gimnamtui tah hidinga govam thilto nato dingu; bongchal golkhat, Kelngoichal khat, Chule kum khat lhingbep nolna beihel kelngoinou sagi nato dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule a-anneh thilto-u chu thao toh kihal changbongnel hiding; bongchal khatna dinga ephah hopsom-a hopthum, chule kelngoichal khatna dinga ephah hopsom-a hopni hiding,
  </para>
  <para style="p">
    <verse number="4" style="v" />Kelngoinou sagi ho jouse-a dinga chu kelngoi khat cheh dinga ephah hopsom-a hopkhat khat hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nangma longlhen bolna dinga kelcha nou khat chu chonset thilto-a nato ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lhaseh-a govam thilto le a-anneh thilto, niseh govam thilto le adonding thilto, chule ajatnu dungjuija Pakai henga gimnamtui tah hidinga meija kisem kilhaina tilouva jong, hicheho hi nato dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nanghon hiche lhasagi channa nisom channi le kikhoppi theng khat nanei diu; chule nanghon nahinnao nasuhgim diu; chule hiche sunga natoh imacha natoh loudiu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla nanghon Pakai henga gimnamtui tah hidinga pumgo thilto natodiu, bongchal golkhat ,kelngoichal khat, kumkhat lhingbep kelngoinou sagi nato dingu ahi. Hicheho chu nolna beihel hidingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule a-anneh thilto-u chu thao toh kihal changbongnel hiding, bongchal khatna dinga ephah hopsom-a hopthum, chule kelngoichal khatna dinga ephah hopsom-a hopni hiding;
  </para>
  <para style="p">
    <verse number="10" style="v" />Kelngoi sagi ho jouse-a dinga chu kelngoinou khatna dinga ephah hopsom-a hopkhat khat hiding ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Longlhenna chonset thilto leh jomjing pumgo thilto, chule a-anneh thilto le adonding thilto hou tilouva jong, kelchanou khat jong chonset thilto-a nato dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule lhasagi channa nisom le ninga nile kikhoppi theng khat naneidiu; natoh imacha natoh loudiu, Pakai henga ni sagi kut nabol diu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nanghon Pakai henga gimnamtui tah hidinga meija kisem kilhaina pumgo thilto natodiu, bongchal gol somlethum, kelngoichal ni, kum khatbep kelngoi somleli: hicheho chu nolna beihel cheh hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule a-anneh thilto-u chu thao toh kihal changbongnel hiding, bongchal somle thuma dinga chu, bongchal takipma dinga ephah hopsom-a hopthum, kelngoichal ni-a dinga chu kelngoichal khatna dinga ephah hopsom-a hopni hiding,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule kelngoi somleli ho jouse-a dinga chu kelngoinou khat dinga ephah hopsom-a hopkhat cheh hidingu ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule jomjing pumgo thilto, a-anneh thilto-u le adonding thilto-u tilouva jong, kelngoiho noukhat chonset thilto-a nato dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule anini lhin nile nanghon bongchal gol somleni, kelngoi chal ni, kumkhat bep nolna beihel kelngoi nou somleli nato diu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule bongchal ho-a ding, kelngoichal ho-a ding, kelngoichal hole kelngoinou ho-a ding, ajatnu dungjuija angaina dungjuija, a-anneh thilto-u le adonding thilto-u nato dingu ahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule jomjing pumgo thilto le a-anneh thilto-u, chule adonding athilto-u tilouva jong, kelcha ho nou khat chu chonset thilto-a nato dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule anithum nile bongchal somlekhat, kelngoichal ni, chule nolna beihel kumkhat lhingbep kelngoinou somleli nato dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule bongchal ho-a ding, kelngoi chalho-a ding, chule kelngoiho-a dinga ajatnu dungjuija, angaina dungjuija, a-anneh thilto-u le adonding thilto-u nato dingu;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule jomjing pumgo thilto le a-anneh thilto-u, chule adonding athilto-u tilouva jong, chonset thilto-a dinga kelcha khat hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule anili nile bongchal som, kelngoi chal ni, chule nolna beihel kumkhat lhingbep kelngoinou somleli nato dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule bongchal ho-a ding, kelchal ho-a ding, chule kelngoiho-a dinga ajatnu dungjuija angaina banga, a-anneh thilto-u le adonding athilto-u nato dingu;
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule jomjing pumgo thilto le a-anneh thilto-u chule adonding athilto-u tilouva jong, kelchaho nou khat chonset thilto-a apehdingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule ani nga nile bongchal ko, kelngoichal ni, chule apolkom beihel kum khat lhingbep kelngoinou somleli nato dingu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule bongchal ho-a ding, kelngoi chal ho-a ding, chule kelngoi nou ho-a dinga chu, amaho ajatnu dungjui le angaina banga a-anneh thilto-u le adonding athilto-u nato dingu;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule jomjing pumgo thilto le a-anneh thilto-u, chuleh adonding athilto-u tilouva jong, chonset thilto dinga kelcha khat nato dingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule anigup nile bongchal get, kelngoichal ni, chule nolna bei kumkhat lhingbep kelngoinou somleli nato dingu;
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule bongchal ho-a ding, kelngoichal ho-a ding, chule kelngoinou ho-a dinga chu amaho jat dungjui le angaina banga a-anneh thilto-u leh adonding thilto-u nato dingu ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule jomjing pumgo thilto le a-anneh thilto-u, chule adonding athilto-u tilouva jong, chonset thilto dinga kelngoi khat nato dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule ani sagi lhin nile bongchal sagi, kelngoichal ni, chule nolna beihel kumkhat lhingbep kelngoinou sagi nato dingu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule bongchal ho-a ding, kelngoichal ho-a ding, chule kelngoinou ho-a ding, ajatnu dungjuija leh angaina banga, a-anneh-u thilto-u le adonding thilto-u nato dingu;
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule jomjing pumgo thilto le a-anneh thilto-u chule adonding athilto-u tilouva jong, chonset thilto dinga kelcha khat nato dingu ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aniget nile kikhoppi loupitah khat naneidiu; hiche sunga nanghon natoh imacha natoh loudiu ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahin Pakai henga gimnamtui tah hidinga, meija kisem kilhaina govam thilto natodiu; bongchal khat, kelngoichal khat, nolna beihel kelngoi sagi kumkhat lhingbep nato dingu ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule bongchal ho-a ding, kelngoichal ho-a ding, chule kelngoinou ho-a dinga amaho jat dungjuile angaina banga a-anneh thilto-u leh donding athilto-u nato dingu;
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule jomjing pumgo thilto le a-anneh thilto-u, chule adonding thilto-u tilouva jong, chonset thilto dinga kelcha khat nato dingu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule nakitep nahou, nalung cham thilto hou, napumgo thilto houding, na anneh thilto hou ding, nadon ding nathilto hou ding, nachamna thilto hou ding tilouva jong, hicheng hi Pakaiya dinga na kut houva chu nabol dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Mosi'n Pakaiyin athupeh jouse dungjuijin Israel chate henga aseitan ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi'n phung lamkai ho jah-a, Israel chate chungchang thudol aseijin, hitin ati; Hichehi Pakai thupeh ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mikhattou Pakai henga kitepna khatna akitepma, ahiloule ahinna kikanna dinga kihahselna khatna akihahsela ahile, athusei chu apalkeh louding, akama aseidoh dungjuija atohding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Numei khattou Pakai henga kitepna khatna akitepma, anungah laija apa in'a ana umlaija, kikanna khatna amanu akikana;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule apan akitepna le ahinna kikan nadinga akikan nachu ajah-a, apan amanu athipsan jeng ahile; akitepna jouse chu ding jing ding ahin, chule ahinna anakanna akihahselna jouse jong chu ding jing ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amavang apachun ajah nikho-a chu ajahda-a ahile; amanu kitepna ho, ahiloule ahinna kikan nadinga akikannaho chu dinglou ding ahi; chule apan ajahda jeh-a, Pakaiyin amanu chu angaidam ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amanu akitepet ahiloule amanun ahina akana dia akamsunga thu hungpotdoh laija chu jinei ahitah-a;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule hichu ajipan ajah-a, chule ajah nikho-a chu amanu ana thipsanna ahile; amanu kitepnaho chu ding jing ding; chule ahinna kikana dinga akihahsel naho chu ding ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla ajipan hichu ajahdoh nikho-a ajahda-a ahile, amanu kitepna khatna anakitepna, chule ahinna akikana akamsunga kona thu hungpot doh ho chu asuhmang pehding; Pakaiyin amanu chu angaidam ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amavang meithai le akidasa numei jin ahinna kikan nadinga akitepna tapou chu amanu chunga ding jing ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amanu chu ajipa in'a kitep ahia, ahiloule ahinna chu kihahsel na-a akan ahi-a,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ajipan hichu ajah-a, amanu athip sana, ajahda louva ahile, akitepna jouse chu dingjing ding, ahinna kikan nadinga akihahselna takip chu ding jing ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahinla ajipan hiho chu ajahdoh nikho-a ajah da-a ahile; akitepna thudola akama kona potchan, ahiloule ahinna kikana thudol chu dinglou ding ahi. A-inneipun ajahda ahin, Pakaiyin amanu angaidam ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kitepna tapou le ahinna sugentheina dinga kikana tapou chu ajipan aphudet thei, ahiloule asuhmang thei ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amavang a-inneipun ani ania amanu henga chu imacha seilouva auma ahile; amanu akitepnaho le amanu chunga akikana jouse chu aphudet peh ahi. Amapan hicheho chu ajahdoh nikho-a athipsan jeh-a chu, hicheho chu anamdet ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla amapan hicheho ajahdoh nunga asuhmanga ahile; amapan amanu chonsetna chu akipoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hicheho hi Pakaiyin Mosi ana thupeh, pasal le a-inneipi kikah-a, chule amanu khangdong ahilai, apa in'a aumlaija amanu le apa kikah-a dinga chondan apeh chu ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,.
  </para>
  <para style="p">
    <verse number="2" style="v" />Midia mite chunga Israel chate phu lanlang, chujouteng na mite toh gopkhoma naum ding ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi'n mipi ho henga chun aseijin, hitin ati; Nangho lah-a mi phabep galsat dingin galvon kivonu henlang, Midia mite doudin cheohen, chule Midia mite chungah Pakai phuba galao hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel phung jouse-a kon, phung khatna kon sangkhat cheh chu galkon dinga nasol dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hitichun Israel sangtamtah ho lah-a konin phung khatna kon sangkhat cheh, galkon dinga galvon kivon mi sangsom le sangni alhengdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n amaho chu manchah thengtah hole mutding sumkon ho chu akhutnuva akichoisah-in, chule Israelte phungtina sangkhat cheh le Eleazar thempu chapa Phinehas chu galsat din asoltan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin Mosi athupeh bang chun, amahon Midia mite asat taovin; chule pasal jouse athat taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin adang athahou tilouvin jong amahon Midia leng ngaho athatnun, amaho chu: Evi, Rekem, Zur, Hur chule Reba ahiuve. Beor chapa Balaam jong chu chemjamin athatnun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Israel chate chun Midia numei ho le achasen hou jouse gal hingin ahin kaijun ahi, chule agancha hou jouse, akelngoi hou jouse, chule athilkeo jouseu ahin chomun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amahon achennao khopi jouse le akulpiu phatah ho jouse chu meijin ahal lha uvin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon galthil achom jouseu, mihem le ganhing agomin apui taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon gal hinga kiman jouse le thil achomdoh hou jouse chu Mosi le Eleazar thempupa, chule Israel chate houkhom ho henga Jericho naija um, Jordan pang Moab phaichama gebuh-ah ahinpui taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi le Eleazar thempupa, chule houkhom ho lah-a lamkai pipuiho chu amaho kimupi din gebuh pama apotdoh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin galmuna kona hung janel lamkaiho, sepai asang sang lamkai ho, chule aja aja chunga lamkai ho chunga chun Mosi alunghang tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mosi'n amaho henga, Nanghon numei ho jouse hi hinghoi nahiuvem?
  </para>
  <para style="p">
    <verse number="16" style="v" />Veovin, hiche numei ho hin Balaam thumopma kona Israel chate hi Peor chungchanga Pakai douna asuhkhel sah-u ahin, chule Pakai houkhom ho lah-a chu hise analanga ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun tun chapangho lah-a pasal takip chu thatnun lang, chule numei takip pasal toh lupkhom kha jouse chu thatnun,
  </para>
  <para style="p">
    <verse number="18" style="v" />Amavang numei chapang jouse, pasal toh lumkhom khalou jouse chu nangho-a dingin hinghoijun;
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule nangho gebuh pama ni sagi naum dingu: koi hijongleh mi that tapou, chule koi hijongle mithilong tongkha tapou chu, nangho le nami mat hou agoma nithum ni leh ni sagi ni-a naki suhtheng dingu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule navon jouseu, savuna kisem jouse, kelmulla kisem jouse, chule thinga kisem jouse chu sutheng uvin, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Eleazar thempupan galsatna che galsat miho henga chun, Hichehi Pakaiyin Mosi henga athupeh danthua chondan ahi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Sana, dangka, sum-eng, thih, tin chule ngen hobou,
  </para>
  <para style="p">
    <verse number="23" style="v" />Meija katheilou thil jouse chu nanghon meija nahal diu, chuteng hichu atheng hiding ahi. Hijeng jongle kisekhena twija suhtheng hiding ahi. Chule mei kahthei jouse chu twija nadediu ahi,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule nanghon napon hou chu ani sagi nile nasop theng diu, chuteng atheng nahi dingu ahitai. Chujou tengle nangho gebuh-a nahung lut dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmale Eleazar thempupa, chule houkhom ho lah-a lamkai pipuihon, galla kichom doh chu mihem hihen sa hijongle ajat simtoh-un.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule galsat dinga galmuna konho le houkhom ho jouse kah-ah galthil chu hopnin hoppeh-un:
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule galsat dinga galmuna konho-a konin Pakaiya dingin kai dongun; mihem'a kon, bongchal ho-a kon, sangan ho-a kon, chule kelngoi ho-a konin agomun janga lah-a khatcheh laovin;
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakaiya lhuh thilto dingin, akehkhat chu lanlang, Eleazar thempupa chu pen.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Israel chate chan akeh khatna konin, somnga lah-a konin khat ladoh-un lang, mihem'a kon, bongchal ho-a kon, sangan ho-a kon, kelngoiho-a kon, gamsa jouse-a konin laovin lang, chule Pakai houbuh chingtup-a pang Levi ho henga peuvin.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Mosi le Eleazar thempupan Pakaiyin Mosi athupeh bangchun abol lhontan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule galsat mihon ahinlah-u galthil kichomho simlouvin, kelngoi chu sangjagup toh sangsomsagi le sangnga ahin,
  </para>
  <para style="p">
    <verse number="33" style="v" />Bong sangsomsagi le sangni,
  </para>
  <para style="p">
    <verse number="34" style="v" />Sangan sangsomgup le sangkhat,
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule pasal to kitimat khalou numei chu sangsomthum le sangni ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule akeh khat, galsatna konho chan chu: kelngoi sangjathum le sangsomthum le sangsagi le janga ahin;
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule Pakaiya dinga kelngoi kai kipe chu jagup le somsagi le nga ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule bongchal ho chu sangsomthum le sanggup ahin; hicheho lah-a kona Pakaiya dinga kai kipe chu somsagi le ni ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule sangan ho chu sangsomthum le janga ahin; Pakaiya dinga kai kipe chu somgup le khat ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule mihem chu sangsom le sanggup ahin; hicheng lah-a Pakaiya dinga kai kipe chu mi somthum le ni ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Pakaiyin Mosi athupeh bangchun, Pakaiya lhuh thilpeh kai chu Mosi'n Eleazar thempupa apetan ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule Israel chate chan akehkhat, galsatna konho lah-a kona Mosi'n ahopkhenho chu;
  </para>
  <para style="p">
    <verse number="43" style="v" />(Tun houkhom ho chan akeh khatna chu: kelngoi sangjathum le sangsomthum le sangsagi to janga ahin,
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule bongchal sangsomthum le gup,
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule sangan sangsomthum le janga,
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule mihem sangsom le sang gup ahi.)
  </para>
  <para style="p">
    <verse number="47" style="v" />Israel chate-a chan akeh khatna konin, Mosi'n mihem le gancha agomin somnga-a khat alan, chule Pakaiyin Mosi athupeh bangchun Pakai houbuh ngahtup Levi miho chu apen ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin janel asang sangho chunga lamkai, asang sang lamkaiho le, ajaja lamkaihon, Mosi ahin naijun,
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin amahon Mosi henga, Nasoh keihon mi keiho mopohna noija um galsat miho sese kasimun ahile, mi khatcha akisam aumpoi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hijeh chun amitakip min Pakai henga thilpeh dingin kanei hou, sana-a kisem kijepna ho, sumguiho, chaoho, khutjemho, bilbaho, chule khiho Pakai anga kahinna uva dinga longlhenna bolna dingin kahin choijun ahi, atiuve.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin Mosi le Eleazar thempupa chun amaho-a konin sana jouse, sana-a kisem kijepna jouse ala lhontan ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chule Pakaiya dinga asangsang lamkaiho le ajaja lamkaihon apehdoh-u thilpeh sanaho jouse chu, shekel sangsom le sanggup toh jasagi le somnga ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />(Ajehchu galkon miho amitakip min ama ding cheh-a thil ahin kichomu ahi.)
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin Mosi le Eleazar thempupan asangsang lamkai ho le jalamkai ho sana chu ala lhonin, Pakai angsunga Israel chate-a dinga melchihna khat hidingin, houkhom ho houbuh sunga achoilut lhontan ahi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Reuben chate le Gad chate chun gancha atama tam aneijun: chule amahon Jazer gam le Gilead gam amuphatnun, veuvin, amun chu gancha vahna dinga mun phatah ahijeh-in,
  </para>
  <para style="p">
    <verse number="2" style="v" />Gad chate chule Reuben chate chu ahungun, Mosi le Eleazer thempupa, chule houkhom lamkai pipuiho henga aseijun, hitin atiuve,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ataroth, Dibon, Jezer, Nimrah, Heshbon, Elealeh, Shebam, Nebo chule Beon,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin Israel houkhom ho masang tah-a anasuhmang gamhi gancha vahna dinga phatah ahin; nasoh houhin gancha kaneijun ahi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun amahon, Keiho namitmu-a lungsetna kachan uva ahile, hiche gam hi nasohte lo dingin nei pedoh jengun, chule keiho Jordan gal lama neipuilut da taovin, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n Gad chate le Reuben chate jah-a chun, Nasopi ho gal kona cheova, nangho hilaija hi natou thim dingu ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule ibola nanghon Israel chate chu Pakaiyin apehnao gam agalkai diuva kona nalung lhahsah uham?
  </para>
  <para style="p">
    <verse number="8" style="v" />Kadesh-bernea'a kona agam vedinga kasolai chun napateu vin hitihin anabolun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu amaho Eshcol phaichama acheuva, agam agamu-u chun, amahon Israel chate chu Pakaiyin apehnao gama alut louna diuvin alunglhah sah-un ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakai lunghanna chu hiche pet chun ahung koudohtan, chule ama akihah sellin, hitin ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thonlouva Egypt gama kona hungdoh miho kumsom ni-a lhah chunglamse koimachan keiman Abraham, Isaac chule Jacob henga kanatep gam chu amutheilou dingu ahi, ajehchu amahon eijui bulhing pouve;
  </para>
  <para style="p">
    <verse number="12" style="v" />Kenez mi Jephunneh chapa Caleb le Nun chapa Joshua tilou; ajehchu amanin Pakai ajui bukim lhonin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakai lunghanna chu Israel chate chunga akoudoh tan, Pakai mitmu-a thilse bolho khang jouse chu abeisoh kahsen amaho chu gamthipma kum somli avavai sah-in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule veuvin, chonset punna mite, Israel chunga Pakai lunghan punbesah nadingin, nangho napateu khelin nahung kisepdoh-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu nangho ama najuinaova kona nakihei manguva ahile, aman amaho hi gamthipma adalhah kit ding, chule nanghon hiche miho jouse hi nasuh mangdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amahon ama ahin naijun, Keihon hilaija hi kagancha ho hongding le kachateu ho-a ding khopiho chu kasahdiu:
  </para>
  <para style="p">
    <verse number="17" style="v" />Amavang keiho tah hi Israel chate cheng achen nadiu gamsunga kapuilut kahseuva amasanguva manchah puma kigosa kachediu ahi: chule agama cheng miho jeh-a hi kachateu kul kikai khum khopiho-a kachen sahdiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel chate amichang cheh-in aloding cheh-u alo kahseuva keiho ka in'uva kahung kile loudiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ijeh inem itile keihon amaho toh Jordan gallang, ahiloule akal lam chu kalokhom loudiu ahi; ajeh chu keiho gamloding chu hilam Jordan solamsang ahi, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Mosi'n amaho henga, Hitobang thil hi nabol uva, Pakai angsunga galsatna nakon uva,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Pakaiyin amelmate a-angsung kona adelmang kahse-a, nangho galvon kivon jouse Pakai angsunga Jordan nagal kaijuva,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Pakai angsung tah-a agam chu suhnema auma ahile; chujouteng chule nangho nakinungle uva, chule nangho Pakai angle Israelte anga themona bei nahi dingu; chule agam chu Pakai angsunga nangho loding hiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla nanghon hitia chu nabol lou uva ahile, veuvin, nangho Pakai douna-a chonse nahiuvin, thonlouva nachonset nao chun nahin holdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nachasen teo dingin khopi saovin lang, nakelngoi houva din kelngoi hong saovin, hitichun nakam muva thupot dungjui chun bollun, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Gad chate le Reuben chate chun Mosi henga, ka Pakai thupeh banga nasohten kabol dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kachasen hou, ka-inneipiteu, kakelngoi hon hou, chule kagancha hou, hiche Gilead khopiho sunga umdingu ahin,
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahin ka pakai pa seibanga, nasohte amitakip galsat dinga galvon kivon chengse, galsatna Pakai angsunga kache dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hijeh chun amaho chung thua hin Mosi'n Eleazar thempupa le Nun chapa Joshua, chule Israel chate phung lamkai ho thu apen:
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Mosi'n amaho jah-a, Gad chate le Reuben chate hi nangho toh Pakai angsunga amitakip galvon akivon uva, Jordan agalkaijuva, gamchu namasanguva suhnema auma ahileh; chuteng nanghon Gilead gam chu amaho lodinga napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin amaho galvon puma nangho toh agalkai khom lou uva ahile, amahon Canaan gama nangho lah-a loding anei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Gad chatele Reuben chate chun adonbutnun, Pakaiyin nasohte henga asei banga chu keihon kabol dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kachan dingu kagoulo diu chu Jordan hilamsang ahitheina dinga keiho galvon kivon puma Pakai angsunga Canaan gamsunga kagalkai dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Mosi'n Amor mite lengpa Sihon gam le Bashan lengpa Og gam, agamgi sunga khopi ho, gamsung kimvella khopiho chu Gad chate, Reuben chate chule Joseph chapa Manasseh phung akehkhat hochu apetai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Gad chate chun Dibon, Ataroth le Aroer,
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Atroth, Shophan, Jazer le Jogbehah,
  </para>
  <para style="p">
    <verse number="36" style="v" />Beth-nimrah chule Beth-haran, kul kikai khum khopiho, chule kelngoi hongho asadoh-un ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule Reuben chaten Heshbon, Elealeh le Kirjathaim,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nebo, Baal-meon (amin ho kikhela ahitai,) chule Shibmah khopiho asadoh-un, chule amahon asahdoh-u khopiho chu minchom asah-un ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Manasseh chapa Machir chate hochu Gilead'a acheuvin, agalaovin, chule asunga um Amor miho chu anodoh-un ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chuin Mosi'n Gilead chu Manasseh chapa Michir apen, ama chua achengtan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Manasseh chapa Jair chu achen, chua khopi neoho chu alan, chule hicheho chu Havoth-Jair asahtai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule Nobah achen Kenath le chua kho neoho chu alan, ama min aputsah-in, Nobah asahtan ahi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheng hi Mosi le Aaron khut noija Israel chate asepai ho toh Egypt gama kona akholjin nao chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Mosi'n Pakai thupeh-a konin akholjin nao dungjuijin achedoh nao asunne: chule hicheng hi achedoh nau dungjuija akholjinu chu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Ramases'a konin alha masapen nisomle ninga channa lha masapen, kalchuh kut ni ajingin Israel chate chu Egypt miho jouse mitmun khut thahat tah-in ahung kitoldoh taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajehchu Egypt miho chun achateu apeng masapen jouse Pakaiyin athaho chu avuijun, a-pathenhou chunga jong Pakaiyin thu atan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Israel chate chu Ramseses'a konin ahung kitoldoh-un, Succoth'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amaho Succoth'a konin akipat doh-un gamthip monglha Ethama gebuh akisonuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amaho Etham'a konin akipat doh-un, Baal-Zephon maija um Pi-hahiroth lamma akile heijun, Migdol'a gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amaho Pi-hahiroth maija chun akipat doh-un, dillen lah-a achepeh-un, gamthipma chun alutnun, hitichun amaho Etham gamthipma chun nithum akitolun, chuin Marah'a gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Marah'a konin akipat doh-un, Elim'a ahung lutnun, Elim'a chun twinah somleni le lusu phung somsagi aumin, hia chun amahon gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amaho Elima konin ahung kipatdoh-un, twipisan panga gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amaho twipisan panga konin akipat doh-un, Sin gamthipma gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amaho Sin gamthipma konin akitolun, Dophkah'a gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amaho Dophkah'a konin akipat doh-un, Alush'a gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amaho Alush'a konin akichonun, mipi ho donding twi umlouna mun Rephidim'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amaho Rephidim'a konin akipat doh-un, Sinai gamthipma chun gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Sinai nelphaija konin akichonun, Kibroth-hatta-avah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amaho Kibroth-hatta-avah'a konin akipat doh-un, Hezeroth'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amaho Hazeroth na konin akipat doh-un, Rithmah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amaho Rithmah'a konin akipat doh-un, Rimmon-parez'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Rimmon-parez'a konin akipat doh-un, Libnah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Libnah'a konin akichonun, Rissah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Rissah'a konin akitollun, Kehelathah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Kehelathah'a konin achekitnun, Shapher molsanga gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Shapher molsanga konin akitolun, Haradah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Haradah'a konin akitolun, Makheloth'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Makheloth'a konin akitolun, Tahath'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Tahath'a konin akipat doh-un, Tarah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Tarah'a konin akipat doh-un, Mithkah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mithkah'a konin acheuvin, Hashmonah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Hashmonah'a konin akipat doh-un, Mosiroth'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Mosiroth'a konin akipat doh-un, Bene-ja-akan'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Bene-ja-akan'a konin akichonun, Hor-hagidgad'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Hor-hagidgad'a konin acheuvin, Jotbathah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jotbathah'a konin akitolun, Ebronah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Ebronah'a konin akipatdoh-in, Ezion-gaber'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Ezion-gaber'a konin akichonun, Kadesh kiti Zin gamthipma chun gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Kadesh'a konin akichonun, Edom gam monga um Hor molsanga gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Aaron thempupa chu Pakai thupeh dungjuijin Hor molsang chunga akaltouvin, chuin hia chun Israel chate Egypt gama kona ahungdoh-u kum somli lhinni, lha-nga channa nimasani chun athitan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule Aaron Hor molsang athi chun kum jakhat le somni le thum ahitai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Canaan lengpa Arad chu Canaan gam lhanglama cheng ahin, Israel chate hung chu ajatan ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin amaho Hor molsanga konin akipat doh-un, Zalmonah'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Zalmonah'a konin akipat doh-un, Punon'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Punon'a konin akipat doh-un, Oboth'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Oboth'a konin akipat doh-un, Moab gamgia Ije-abarim'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin Iim'a konin akipat doh-un, Dibongad mun'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Dibongad'a konin akichon kitnun, Almon-diblath-aim mun'a gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin Almon-diblath-aim'a konin akichonun, Nebo masanga Abarim molsang ho-a chun gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin Abarim molsang ho-a kon chun Moab phaicham Jordan gal Jericho naijah gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin Jordan gal Moab phaichama um Beth-jesimoth apat Abel-shittim geichun gebuh akisonun ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin Moab phaicham, Jordan gal, Jericho naija chun Pakaiyin Mosi henga thu aseijin, hitin ati,.
  </para>
  <para style="p">
    <verse number="51" style="v" />Israel chate henga chun seipeh inlang, hitihin seijin, Nangho Jordan nagalkaijuva Canaan gamsung nalhun tenguleh;
  </para>
  <para style="p">
    <verse number="52" style="v" />Nanghon namasanguva um agam neiho chu nadeldoh uva, chule amilim hou nasuhmang peh dingu, alim semthu a-pathen hou nasuhmanguva, chule amun thenghou nasuhlhuh diu ahi:
  </para>
  <para style="p">
    <verse number="53" style="v" />Chule agama cheng miho chu nadeldoh uva, hia chu nachendiu ahi: ajehchu keiman gam chu nalo dinguva kapeh-u nahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chule nanghon agam chu vang nasan uva na-insung kailhah dungjui cheh-a nakihop dingu ahi. Chule atamte chu natam peh uva, chule alhomte chu nalhom pehdiu: amitakip min avang san dungjui cheh-a mun chu aloding, napu napateu phung dungjuija nalo dingu ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ahinla nanghon agama cheng miho na masang uva kona nadeldoh louvule, hung hiti ding ahi: nanghon na-umden sahhou chun namit uva dinga moljuma panguva, napang peh uva dinga linga pangdingu, chule nachen nao gama chu nasunoh phah uva hungpang diu ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Chukalvalla jong hung hitiding ahi, amaho chunga boldinga kanagel banga chu nangho chunga kabolding ahi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi jah-a aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate thu penlang, chule ajah uva hitin seijin, Nangho Canaan gamsunga nalut tengule, (hichehi nangho lodinga hunglha ding gam chu ahin, Canaan gam agamgi chin hotoh hitha ding ahi).
  </para>
  <para style="p">
    <verse number="3" style="v" />Lhanglama nagamgi dingu chu Zin gamthipma pat Edom gamgi chin gei hiding, chule lhanglam sang gamgi chu Chi dil solam among gei hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nagamgiu chu lhanglama Akrabbim kaltouna-a patna hung kiheidoh-a, Zina galkai ding; chule Kadesh-barnea lhanglama chepeh ding, chule Hazar-addar'a cheding, chule Azmon galkai ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule agamu ngahna chu Azmon'a patna Egypt vadung geija akolding, ahung kikhodoh ho chu twipia kinga ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule lhumlam gamgi ding chu, agamgi-a dinga twipilen naman diu; hichehi lhumlama nagamgiu hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho sahlam gamgi ding chu, twipilen'a kona Hor molsang chan hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hor molsanga kona nanghon Hamath lutna geichu namelchih peh dingu; nangho gamgi kilhungdoh chu Zedad'a kilhung lutding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule agamgi chu Ziphron geija kilhunga, Hazarenan'a kilhunglut ding; hichu sahlama nagamgiu hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangho solam gamgi chu Hazarenan'a patna Shepham geija namelchih diu,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule gamgi chu Shepham'a pat A-in solam sanga Riblah'a kilhunglha ding, chule agamgi chu kilhungsuh-a, Chinnereth solam dil gei lhungding,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule agamgi chu Jordan geija kilhung lha-a, chule akilhungdoh ho Chi twipia kilhunglut ding; hichu nangma gam kimvela nagamgi hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi'n Israel chate thu apen, Hiche gamhi nanghon vang sanna nalodiuva Pakaiyin phung ko hole phung kehkhat ho anapeh chu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Reuben chate aphung kailhah le apu apateu insung dungjuija, chule Gad chate aphung kailhah le apu apateu insung dungjuija, amahon alodingu gou chu amu-u ahitai, chule Manasseh phung keh khat jong aloding dolu chu changa ahitaove:
  </para>
  <para style="p">
    <verse number="15" style="v" />Phung nile phung keh khat hochun achandingu chu Jordan hilamsang, Jericho nai solamsang, nisa sona lamsang amutaovin ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichehohi nanghon nalodingu gam nahop khenpeh dinghou min chu: Eleazar thempupa le Nun chapa Joshua ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangman nalodiu gam hopkhen peh dinga aphung takipma kona pipui khat cheh nalhendoh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho min chu hiche hi ahi: Judah phunga Jephunneh chapa Caleb;
  </para>
  <para style="p">
    <verse number="20" style="v" />Simeon chate phunga, Ammihud chapa Shemuel;
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin phunga kona Chislon chapa Elidad;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Dan chate phung lamkai Jogli chapa Bukki;
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph chate phung lamkai, Manasseh chate phunga dingin, Ephod chapa Hanniel;
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Ephraim chate aphung lamkai, Shiphtan chapa Kemuel;
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Zebulun chate phung lamkai, Parnach chapa Elizaphan;
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Issachar chate phung lamkai, Azzan chapa Paltiel;
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Asher chate phung lamkai, Shelomi chapa Ahihud;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Naphtali chate phung lamkai, Ammihud chapa Pedahel ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichehohi Pakaiyin Canaan gama Israel chate gouchan hoppeh dinga athupeh hochu ahi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Moab phaicham Jordan gal Jericho naija chun Mosi henga thu aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate chu agou chanhou lah-a kona Levi miho chen nading khopi apeh nadingun thu pen, chule nanghon Levi miho chu khopiho kimvela gam op-ho chu napeh dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule khopiho chu achenna dingu hintin, chule agam op-hou chu agancha hou, athilkeu hou, aganhing hou jouse-a ding hiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nanghon Levi miho napeh dingu gam op-ho chu, khopi kulbanga pat polam tong sangkhat kimvel hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule khopiho pamlam chu nate dingu, solam sanga tong sangni, lhanglam sanga tong sangni, lhumlam sanga tong sangni, chule chunglam sanga tong sangni hiding, akhopi chu alailunga umding, hichehohi amaho dinga khopiho gam-op hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangman Levi miho napehding khopiho lah-a chu hoidohna khopi gup, tolthatpa jamlutna dinga nalhendoh ding; chule amaho dinga khopi somlileni nabedingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chitia chu Levi miho napeh dingu khopiho jouse chu khopi somlileget hiding, amaho chu agam op-toh napehtha diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nanghon napeh diu khopiho chu Israel chate losa ho-a kon hiding; atam neiho-a kona natampeh diu, alhom neiho-a kona nalhom pehdiu: amitakip min Levi miho chu analo akhopihou dungjui cheh-a apeh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel chate henga thu seijin lang, ajah uva, Nangho Jordan gal Canaan gamsung nahung galkai tengule,
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanghon nangho dinga hoidohna khopi dinga khopiho na kilhendoh diu; chutia chu kiningman louva khattou tolthatna chu chulama jamthei ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hicheho chu nangho-a dinga phula dingho-a kona nahoidohna diu hiding; houkhom ho thutanna anga adin tokahse-a mithat chu athi louna ding hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nanghon napehdiu khopi holah-a kona gup chu nangho dinga hoidohna hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanghon Jordan hilam sanga khopi thum napeh uva, Canaan gamsunga khopi thum napeh diu; hichu hoidohna khopi ho hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hicheng khopi gup chu, Israel chate le namdang hoding, chule alah uva khopemdenho agomuva dinga hoidohna hiding, kiningman louva tolthat chan chulama jamthei ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman thih manchah khatna amachu avoh-a, athitah-a ahile, ama chu tolthat ahitan; tolthat chu thatei teiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule athina theija, aman songa asekhah-a, athitah-a ahile, ama chu tolthat ahitan; tolthat chu thatei tei ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahiloule aman thina khopma thing manchah khutchoi khatna avoh-a, ama athi tah-a ahile, ama chu tolthat ahintan; tolthat chu thatei teiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thisan phulapa amatah chun tolthatpa athading; aman ama chu amu mule atha ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahinla muda mana asotlhuh ham, ahiloule achanlhih-a thilkhat touva asea, athitah-a ahile,
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahiloule kidouna jeh-a akhutna avoh-a, ama athitah le; ama vopenpa chu thatei teiding ahi. Ajehchu ama tolthat ahitan: thisan phulapa chun amuteng le atha ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahinla aman amachu kidouna beija hetman louva asotlhuh ham, ahiloule changlhi louva ama chunga thil khattou asekhuma ahile,
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahiloule mikhat thinathei khop song khat touva amapa chu mulouva asekhah-a, ama athitah-a; ahia ama chu akidoupi jong hilou chule suhgenthei dia jong ahol hilou ahile,
  </para>
  <para style="p">
    <verse number="24" style="v" />Houkhom ho chun mithat pale thisan phulapa kikah-a thutanna dan dungjuija thu atan dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule houkhom ho chun mi thatpa chu thisan phulapa khutna kona ahuhdoh uva, houkhom ho chun ama chu ajamna hoidohna khopi-a chu agathah diu; chule ama chukoma chu thaotheng kinu thempu chungnungpa thi kahse-a umjing ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahinla tolthat pa chu ajamna lam, ahoidohna khopi gamgi pam polama, ahungpotdoh khah-a;
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule thisan phulapa chun hoidohna khopi polama amapa chu amua, thisan phulapan mithatpa chu atha-a ahile; amachu thisana themmo chang louding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ajehchu ama hoidohna khopi sunga chu thempu chungnung thi tokahse-a umthim behding ahin, thempu chungnung thi nung teng vangle mithatpa chu alosa agam sunga hung kinung lekit ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutichun hicheng jousehi nangho dinga nakhang khanguva, nachena mun jouseuva chondan hiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Koi hijongle mi khattou thatna aumle tolthatpa chu ahetoh ho kama kona thajeng ding ahi. Ahinla mikhattou thana dinga achunga hettohsah khatnin photchena aneilou ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chukal vallin nanghon thinakhop hella mochang tolthat chu lhatdohna dinga kilhatdohna nalah lou dingu ahi, ajehchu ama chu thatei teiding joh ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule hoidohna kulpi-a jampa chu thempupa thikah-a, gamsunga chengdia ahung kile theina dinga, ama dinga kilhatdohna nalah theilou diu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hitia chu nanghon nachen nao gam chu nasuh boh loudiu, thisan jeh-a gam chu boh-a ahin; thisan lonna gam chu kisutheng joulou ahin; amavang thisan sopa thisana bou kisutheng thei ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hijeh chun nachena diu gam, keima chenna chu suboh hih-un: ajehchu keima Pakai Israel chate lah-a cheng jinga chu kahi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Gilead chate insung mi upaho, Machir chapa Manasseh chapa Joseph chapate insung miho chun, Mosi angle lamkai ho anga, Israel chate upaho masang ahin naijun, aseitaovin ahi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amahon, Chaten vang sanna alodiu gam chu pedingin Pakaiyin ka pakai thu anapen; chule kasopipa Zelophehad gouchan chu achanute pehdingin ka pakai hi Pakaiyin ana thupeh tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun amaho chu Israel chate phung dangho chatetoh kicheng tale, agou loding hou chu kapa tehouva kona kiladoh-a amaho kichenpi phungho gouchan chuto kigoppeh ding ahin; chutia chu vang dungjuija kagou chanuva kona kiladoh ding ahitai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Israel chate Jubilee ahunghi tengle, amaho gouchu amahon akichenpiu phungho gou chutoh kigop thading ahitan; chutia chu amaho gou chu kapu kapatehou phungho goulah-a kona kiladoh ding ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Mosi'n Israel chate chu Pakai thupeh dungjuijin thu apen, hitin ati, Joseph chapateho phungin aseiju chu adih lheh-e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zelophehad chanuho chungchanga Pakaiyin thu apeh chu hitihi ahi, Amaho pha asah penpenu chutoh kichengu hen, ahinla apu apateu phung sunga ho kichen piu hen:
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti chu Israel chate gouchan chu phung khatna kona phung khatna kichon lele louding ahi; ajehchu Israel chate tapou chun amatah-in apu apatehou gou chu anga dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule chanu tapou, Israel chate sung koiphung hitale gouloa chun, hiche apa phung insung khatna chu inneipi hiding, hitia chu Israel chate takip min apu apateu gou chu alothei dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gou chu phung khatna kona phung khatna kichon lele louding; amavang Israel chate phung khat cheh chun ama ama gou akinga dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Mosi athupeh bangchun Zelophehad chanute chun abol taove;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu Zelophehad chanute Mahlah, Tirzah, Hoglah, Milkah, Noah chu apateo sopiho chapate toh akicheng taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amaho Joseph chapa Manasseh chapate insung miho toh akicheng taovin, agouhou chu apateu insung phunga chun aumdentan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hicheho hi Jericho naija Jordan pang Moab phaija Israel chate henga Mosi khutna Pakai thupeh, thupeh ho le thutannaho chu ahi.
  </para>
</usx>
