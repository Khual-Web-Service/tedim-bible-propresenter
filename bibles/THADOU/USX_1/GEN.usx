<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Semtilbu</book>
  <para style="h">Semtilbu</para>
  <para style="toc1">Semtilbu</para>
  <para style="toc2">Semtilbu</para>
  <para style="mt">Semtilbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atilin Pathen'in van le leiset aseme.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuleh leiset chu agong umlou le agohkeo ahin; twi thuhtah chunga chun muthim akikhange. Chule Pathen lhagao chu twiho chunga chun alenglen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pathen'in, Vah umhen atile, vah chu aumtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pathen'in vah chu amun, hichu pha asan: hichun Pathen'in vah chu muthima konin akhen tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pathen'in vah chu sun asah in, muthim chu jan asah tai. Hitichun nilhah le jingkah chu ni masa ni ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin Pathen'in, Twilah-a chun vanlaijol hung umhen, chule hichun twiho chu twiho-a konin homkhenhen, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hitichun Pathen'in vanlaijol chu asemin, vanlaijol noija um twiho chu vanlaijol chunga um twiho-a kon chun ahomkhenin ahi. Chuin chuti chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pathen'in vanlaijol chu van asah tai. Hitichun nilhah le jingkah chu ni nina ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pathen'in, Vannoi'a twi ho chu mun khatna kigom khom henlang, gamgo hung kisepdoh hen, ati. Chuin chuti chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pathen'in gamgo chu leiset asah-in, chule twi kigom khom hochu twikhanglen asah tai. Chuin Pathen'in hichu amun, pha asan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pathen'in, leisetnin hampa, achi nei hamkung, chule ama ama chi dungjuija aganei theiphung, aga sunga achi um leisetna hin hinsepdoh hen, ati. Chuin chuti chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin leiset nin hampa, chule ama ama chi dung juija ga, aga sunga achi um thingphung ganei ahin sodoh tan ahi. Chuin Pathen'in hichu amun pha asan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiti chun nilhah le jingkah chu nithum ni ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pathen'in, Sun chu jana kona chomkhen dingin van'a vanlaijola vah ho umhen; chule hiho chu melchihna ho, phat bihho, chule nikhoho hetna dingin pangu hen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hiho chu leiset chunga vah pedingin van'a vanlaijola vahho hiuhen ati. Chuin chuti chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche chun Pathen'in vah lentah ni asemin; vah lenjo chu sun vaipo dingin, chule vah neojo chu jan vaipo dingin apansahtan ahi. Aman ahsi ho jong aseme.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen'in hiho chu leiset chunga vah peding van'a vanlaijola chu akoijin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule sun le jan chunga vaipo ding le muthima kona vah khendingin akoitan ahi. Chuin Pathen'in hichu amun pha asan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiti chun nilhah le jingkah chu nili ni ahitai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pathen'in, Twiho chun achat loh thei hinna nei ganhing tamtah hinsepdoh henlang, vachate jong leiset chung van'a vanlaijol onghom-ah leng leuhen, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiti chun Pathen'in ngapi lentah ho asemin, chule twijin ama ama chi dungjuija ninglhing setna ahinsepdoh achatloh thei hinna nei ganhing namkim le lhaving nei vacha namkim chu ama ama chi dungjui jin asemin ahi. Chuin Pathen'in hichu amun pha asan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Pathen'in amaho chu phatthei aboh-in, Chiphaovin lang pung theijun, twikhanglen twiho lo dimun, chule vachate jong leiset chunga punguhen, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun nilhah le jingkah chu ni ngani ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pathen'in, leisetnin ama ama chi dungjui cheh in hinna nei ganhing, gancha hon, akithol tho ganhing, chule leisetna gamsaho ama ama chi dungjui jin hin sepdoh hen ati. Chuin chuti chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pathen'in leisetna gamsa ama ama chi dung juijin, ganchaho ama ama achi dung jui cheh-un, leiset chunga akithol tho ganhing namkim ama ama chi dung jui cheh-in asemtan ahi. Chuin Pathen'in hichu amun pha asai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pathen'in, Eihon eiho lim bangin, eiho bangtah-in mihem semu hitin; chule amahon twikhanglen na ngaho, vanlaijola vachate, ganchaho, chule leiset pumpi chung le leichunga akitholtho ganhing namkim chungah vaihomu hen, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuti chun Pathen'in ama lim bangin mihem asemin, aman amapa chu Pathen lim bangin asemin ahi; aman amani chu pasal le numei jin aseme.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chujou phatnin Pathen'in amani chu phatthei aboh-in, chule Pathen'in amani jah-a chun, Chipha lhonin, pung lhonin, vannoi leiset lodimsoh lhonin lang, nathun nunsah lhonin; chule twikhanglen na ngaho, vanlaijola vachate, chule leiset chunga vahle hinna nei ganhing jouse chungah thuneina neilhonin, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Pathen'in, Ven, vannoi leiset pumpi chunga amunei hampa jouse le, asunga amu um thingphung gathei jouse kapeh lhon ahin; hichu nangni dinga na an lhon hiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule leiset na gamsa namkim, vanlaijola vacha namkim, leiset chunga a-opma kithol ganhing namkim, hinna nei jouse dinga hampa louhing eng jouse a-an diuva kapeh ahitai, ati. Chuin chuti chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuti chun athilsem namkim chu aven, chule veuvin, hichu aphalheh jengin ahi. Chuin nilhah le jingkah chu nigup ni ahitai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuti chun vanho le leiset, chule asunga um jouse chu akisem chaitan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ani sagi nin Pathen'in athilsem anatoh chu achaijin; chule ni sagi nin athilsem anatoh jouse-a konin akicholdon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pathen'in nisagi ni chu phatthei aboh-in, asuthengtan ahi. Ajeh chu chuche nikho-a chu Pathen athilsem le athilbol anatoh jouse-a kicholdo-a ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiche hohi akisem laijuva van le leiset khanggui chu ahi; Pakai Pathen'in leiset le vanho asem nikho,
  </para>
  <para style="p">
    <verse number="5" style="v" />Alei laija thingphung namkim leiset chunga aum masang, chule aleija hampa louhing namkim akedoh masang, (akisem laijuva van le leiset khanggui chu ahi.) Ajeh chu Pakai Pathen'in leisetna go ajuhsah hihlaijin, alei lhouding jong mi khatcha anaum hih laijin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin leisetna konin twimei ahungdohjin, chule leiset chung jouse achapkot jin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakai Pathen'in tolla leivuija konin mihem asemin, anahhom sunga chun hinna hu alhakhumin ahile, hichun mipa chu hinna nei mihing ahung hitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakai Pathen'in solama Eden'a chun honkhat asemin; aman sem mipa chu hikoma chun akoi tai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakai Pathen'in leisetna konin vetdinga hoitah, chule nehdinga tuitah theiphung namkim akedoh sah-in; chule honsung lailunga chun hinthing le ase apha hetna thing jong akedoh sah-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule hon chu chapkot dingin Eden'a kon chun vadunglen khat along doh-in; chule chua kon chun akikhenin vadung ka-li akiso tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amasa pen chu amin Pishon ahin; hichu sana umna Havilah gam kolkhumin alongin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule chuche Gama Sana chu aphan; chukoma chu bdellium le songgel jong aumin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vadung nina chu Gihon ahin; Ethiopia gam kolkhuma longa chu hiche hi ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Athumna vadung minchu Hiddekel ahin; Assyria gam solama longa chu ahi. Chule vadung lina chu Euphrates ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chujouvin Pakai Pathen'in mipa chu aleilhou natong dingle angah dingin Eden hona chun akoitai
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakai Pathen'in mipa chu thupeh apen, Nangman honsunga thingga jouse chamlhat tah-a naneh thei ahi:
  </para>
  <para style="p">
    <verse number="17" style="v" />Amavang ase apha hetna thingga vang chu naneh louding ahi; ajeh chu hichu naneh ninileh thonlouva nangma nathi tei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Pakai Pathen'in, Mipa hi achanga aum ding aphapoi, keiman ama dingin akithopi ding akilompi khat sempeh-ing kate, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakai Pathen'in leisetna konin gamsa jouse, chunga leng vachate jouse asemin; hicheng chu Adam'in amin asah dingin ahengah chun ahinpuijin ahi. Chuin Adam'in ganhing namkim amin asahbang cheh-in, aminu chu akisah dentai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiti chun Adam'in ganchaho, vanlaijola vachate, chule gamsaho jouse chu amin asahsoh keijin; ahivangin ama kithopi ding akilompi aumpon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakai Pathen'in Adam chu a-imutmil sah-in ahile, ama a-imutan ahi. Chuin aman anahgu holah-a khat aladoh-in, hilaimun chu aphe-in ahuh bitnin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujouvin Pakai Pathen'in mihempa-a kona alahdoh anahgu chun, numei khat asemin, amanu chu mihempa henga chun ahinpuijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Adam'in, Tuvangin hichehi keima gua kona gu, chule kaphe-a kona phe ahi. Amanuhi numei kisah ding ahi, ajehchu ama pasal'a kona kiladoh ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh-a chu pasal'in anu le apa adalhah-a, ajia beh ding ahi; chule amani chu tikhat hilhon ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule mipa le a-inneipi chu ani lhonin sagoh keo ahilhonin, ahin ajahcha lhonpon ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Pakai Pathen thilsem gamsaho jouse lah-a chun gul ajonchih penin ahi. Chuin aman numeinu jah-a, Pathen'in honsunga thingga khatcha jong naneh lhon lou ding ahi, tia aseijem? ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichun numei nun gul jah-a, Keinin honsunga theiga ho kanethei lhonai;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahivangin hon lailunga um theiga vangkhu, Pathen'in, naneh lhon lou ding, tohjong natohkhah lhon louding ahi, achuti loule nathi lhonding ahi, tin aseije ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin gul chun numei nu jah-a, Nathi tahbeh lhon louding ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu hichu naneh lhon ni nileh namitlhon hahdoh ding, Pathen toh nabah lhona, apha ase nahet lhon ding ahi chu Pathen'in ahet ahi, tin aseitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin numei nu chun theiphung chu neh dinga aphat le, mitna dinga vetnom aum, chule mikhat chihsah nadinga dei umtah ahichu amuphatnin, amanun aga chu alouvin, anetan; chule a-inneipu jong chu apen ahile, amapan jong anetai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amani amitlhon ahung hahdoh tan, chule sagohkeu ahilhon ahelhon tai; chuin amanin theichang naho akilmat lhonin, vonin akivon lhontan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ni ahung daijin amanin hona chun Pakai Pathen kholhah husa gin aja lhontan; chuin Adam le a-inneipi chu Pakai Pathen umna-a kon chun honsunga thinglah-a chun akisel lhontan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakai Pathen'in Adam chu ahin kouvin, ajah-a, Hoija um nahim? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, Keiman honsunga nahusagin kajan, kasagoh keo kahijeh-in kakichan, kakisel ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman, Sagohkeo nahi kon naseipeh ham? Nehih-in tia kathupeh thingga chu naneh hitam? ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hichun mihem pan, Nangman kaumpi dinga neipeh numeinu hin thingga chu eipeh-a, kana neh ahitai, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakai Pathen'in numeinu jah-a, Nangman nabolhi ipi hitam ati. Chuin numeinu chun, gul'in eilhepma, kana neh ahitai, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakai Pathen'in gul jah-a chun, Nangman hitobanghi nabol jeh hin, ganchaho jouse chungle, jaova gamsa jouse chungvuma gaosap changa nahitai; Nangman na-oija lam najot ding, chule nahinlai sungse-a leivui naneh ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangma le numei nu kikah-a, chule nachilhah le amanu chilhah kah-a kidouna kakoi ding; chule aman nalu asuh chipma, nangman ama khotaljum nasuhchip ding ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman numei nu jah-a chun, Keiman nalung gentheina le nanaovopna chu nasatah-a kapunsah ding; nangman nat thoh gim tah-a cha nahin ding; nalung ngaichat chu na inneipu-a ding hiding, chule aman nachunga vai ahomding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman Adam jah-a, Nangman na inneipi thu nangaija, nangman nanehlou ding ahi, tia kathupeh thingga chu naneh tah jehchun: Nangma jala leiset kigaosapmah ahitai; nangman nahin laisungse-a, gimtah-a na natoh-a aga naneh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangma-a dinga ling le meithai seltholing ahin kedohsah ding; chule nangman loujaova hampa louhing naneh ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangma leisetna kona kiladoh nahin, leisetna nakilekit kahse-a namaija ulsa soh-a kona anneh naneh ding ahi. Ajehchu nangma leivui nahin, leivuija nakile kitding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Adam'in a-inneipi min chu Eve asahtai; ajeh chu amanu mihing jouse Nu ahi
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakai Pathen'in Adam le a-inneipi chu savunin sangkhol asempeh-in, avon pehtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakai Pathen'in, Vetan, mihem khu eiho lah-a khat bangin ase apha ahetthei tai. Chule tun, ijemtin akhut hinlhang dohhen lang, hing thingga jongkhu hinlou henlang, netaleh, tonsotna hingding ahitai, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun akilahdohna leiset chu laibot-a natong dingin, Pakai Pathen'in ama chu Eden hona konin asoldoh tan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuti chun mipa chu anodoh-in; chule hinthing lampi chu ngahdingin Cherubim le akipei lele meikou chemjam chu Eden hon solama akoitan ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Adam chun a-inneipi Eve chu akitimat pin ahile, amanun nao avopmin, Cain ahingin, chule amanun, Pakaiya konin pasal khat kaneitai, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amanun anaopa Abel ahing kitnin ahi. Chuin Abel chu kelngoi vah-in apangin, ahin Cain vang chu loulhou natongin apangin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin khonung phasah-in, Cain'in alhosoh alouga chu ahin choijin, Pakai henga atohtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Abel jong chun akelngoihon asoh masapen lah-a athaopen chu ahin choijin ahi. Chuin Pakai chu Abel le athilto-a chun alung lhaijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin Cain le athilto chunga vang alung lhai tapon ahi. Chuphat nin Cain chu alungsa talheh jengin, chule amai athim jengtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin Cain jah-a, Ibola nalungsat ham? Chule ibola namai thima ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman phatah-a nabola ahile, nangma sanlouva naum dehding ham? Ahin phatah-a nabol lou vangle, chonsetnin kot bula nachang jinge. Chule angaichat chu nangma-a ding ahin, hijongle nangman ama chunga vai nahom ding ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Cain'in anaopa Abel chu akihoulimpin; chuin ahitin ahi, amani gamlah-a aumpet lhonin, Cain chu anaopa Abel chunga achun, athat tai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin Cain jah-a, nanaopa Abel hoija umham? ati. Chuin aman, kahepoi; keima kanaopa ching beh kahim? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, Ipi nabol hitam? Nanaopa thisan aw chu leisetna konin kahengah ahung pengdoh-e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule tun nakhutna kona nanaopa thisan choplutna leisetna kona nangma kigaosap ma nahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman lei nalaija na natoh tengle, nangma-a dinga ahina banga ga ahinsepdoh tahlou ding; nangma leiset chunga jamlele leh vahlele mi nahiding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Cain'in Pakai jah-a, Ka talen mat hi kathoh jou kal val ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vetan, nangman tunin leiset chunga konin neinodoh tan; chule nangma maikoh-a kona selmanga umding kahitai; chule keima leiset chunga ajamlele leh vahle-le kahiding ahitan; chule hung hiti ding ahi, keima eimu mu-a chun eithading ahitai, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakaiyin ajah-a, Hijeh chun koihile Cain that chan chu, ajat sagi-a achunga phu kilading ahi, ati. Chuin koiman ama amua atha louna dingin, Pakaiyin Cain chunga chun melchihna akoitan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Cain Pakai angsunga konin apotdoh-in, Eden solama Nod Gama achengtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Cain'in a-inneipi akitimatpin ahile, amanu agaijin Enoch ahingin ahi. Chuin aman khopi khat asemin, achapa min dungjuijin khopi chu Enoch asahtai
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Enoch chun Irad ahingin; Irad chun Mehujael ahingin; Mehujael'in Methushael ahingin; chule Methushael'in Lamech ahingin, ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Lamech chun jini akipuijin: khatnu min chu Adah ahin, khat joh nu min chu Zillah ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Adah chun Jabal ahingin; ama chu pon in'a chenghole gancha vulteho bulpipa ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule anaopa min chu Jubal ahin; amachu saiging le gosem mut teho jouse bulpipa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Zillah'in jong Tubal-Cain ahingin; ama chu sum-eng le thih manchah semho hila pang ahi.Chule Tubal-Cain sopinu chu Naamah ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Lamech chun ajiteni jah-a chun, Adah le Zillah ka-aw ngai lhonin, nangni Lamech inneipi teni, kathusei ngailhonin. Ajehchu mikhat eimavo jeh-in kathatnin, chule gollhang khat eisuhkhah jeh-in kathatnin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cain chunga ajat sagi-a phu kilading ahile, tahbeh-a Lamech chunga sagi mun somsagi vei kilading ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Adam'in a-inneipi chu akitimatpi kitnin ahile, amanun chapa khat ahingin, amin Seth asahtai. Ajehchu amanun, Cain'in atha Abel khel chun, Pathen'in chikhai ding khat eipetai, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Seth amatah jong chun chapa khat ahingin, amin Enosh asah tai. Hiche-a pat chun mihem ten Pakai min akoupan taovin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichehi Adam khangguiho lekhabu ahi. Pathen'in mihem asemni chun, aman Pathen tobangin amachu asemin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman amani chu Pasal le numei jin asemin; chuin phatthei aboh-in, chule amani asem nikho chun aminlhon chu Adam asah tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Adam kum jakhat le kum somthum alhinin, ama tobang le ama lim bangin chapa khat ahingin; amin Seth asahtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Seth ahin nungin Adam kum jaget ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Adam damsung hinkho chu abonchan kum jako le kum somthum ahi. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Seth kum jakhatle kum nga alhinin, Enosh ahingin ahi
  </para>
  <para style="p">
    <verse number="7" style="v" />Enosh ahin nungin Seth kum jagetle kum sagi ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Seth damsung hinkho chu abonchan kum jako le kum somleni ahin. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Enosh kum somko alhinin, Cainan ahinge.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Cainan ahin nungin, Enosh kum jaget leh kum somlenga ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Enosh damsung hinkho chu abonchan kum jakole kumnga ahi. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Cainan kum somsagi alhinin, Mahalalel ahinge.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mahalalel ahin nungin Cainan kum jaget le kum somli ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Cainan damsung hinkho chu abonchan kum jakole som ahi. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mahalalel kum somgup le kum nga alhinin, Jared ahinge.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Jared ahin nungin Mahalalel kum jaget le kum somthum ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Mahalalel damsung hinkho chu abonchan kum jaget le kum somko le kum nga ahi. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jared kum jakhat le kum somgup le kumni alhinin, Enoch ahingin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Enoch ahin nungin, Jared kum jaget ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jared damsung hinkho abonchan kum jakole kum somgup le kumni ahi. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Enoch kum somgup le kumnga alhinin, Methuselah ahinge.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Methuselah ahin nungin, Enoch kum jathum Pathen toh alhonlen, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Enoch hinkho damsung chu abonchan kum jathum le kum somgup le kum nga ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Enoch chu Pathen toh analhon len; chuin ama aum tapoi: ajehchu Pathen'in ama alamang ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Methuselah kum jakhat le kum somget le kum sagi alhinin, Lamech ahingin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Lamech ahin nungin Methuselah kum jasagi le kum somget le kumni ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Methuselah hinkho damsung chu abonchan kum jako le kum somgup toh kum ko ahi. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Lamech chu kum jakhatle kum somget le kumni alhinin, chapa khat ahinge.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman, Amahin Pakaiyin leiset agaosapma kona ikhutnuva inatoh le itohgim naova kona eilung monsah dingu ahi atin, amin Noah asahtai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Noah ahin nungin Lamech kum janga le kum somko le kum nga ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Lamech hinkho damsung chu abonchan kum jasagi le kum somsagi le kum sagi ahi. Chuin ama athitai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Noah kum janga alhinin, Shem, Ham chule Japheth ahingin ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, leiset chunga mihemho ahung pun patnuva, amaho-a dinga chanute ahungpen phatnin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen chapate chun mihem chanute amel hoithei lheh-u chu amuvin; chuin amahon adei deiju chu ji dingin akilah taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakaiyin, Kalhagao a-itih-in mihemte toh boijing ponte, ajeh chu ama tahsa phe ahin; hijongle ahinkho chu kum jakhatle kum somni hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuche nikho laichun leiset chunga mihat ho aumun; chule hiche nung jong chun, Pathen chapate mihem chanute koma ahung tengule, amahon amaho dingchun chate ahinpeh jiuvin; amaho chu gollui laija mihat ho, chule mi minthangho ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pathen'in leiset chunga mihem khan gitlouna anasalheh jenge ti le, tantih neilouva alunggil sunga athil ngaito jouse gitlouna jeng ahi chu amutan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin hichun Pathen'in leisetna mihem asem chu akisih sahtan; chule lungsung asuna lheh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin, Keiman leiset chunga konhin kasemsa mihemhi sumanghel tange; mihem ahin, gamsa ahin, akithol tho ganhing ahin, chule vanlaijola leng vacha ahin; ajehchu amaho kanasem hi kakisih tai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin Pakai mitmun Noah chu lunglhaina ana changin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichehohi Noah khangguiho chu ahi: Noah chu michondih tah le khanga miho lah-a nolnabei ahin, chule Noah Pathen toh analhon len ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Noah'in chapa thum, Shem, Ham chule Japheth ahingin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Leiset chu Pathen mitmun asedehtan, leiset chu hunamna-in adimset jeng tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pathen'in leiset chu aven ahile, veuvin, hichu asedeh tan ahi; ajehchu tahsa jousen leiset chunga alampiu asuboh taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pathen'in Noah jah-a, Tahsaphe jouse kichaina chu ka-angsung ahung lhung tai; ajehchu amaho jeh-in leiset chunghi hunam adimtan; chule ven, keiman amahohi leiset toh kasuhmang thading ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman Gopher thingin Kong innei khat kisemin, kong sunga chun indanho semin, chule asung apo thingnaijin loijin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hichehi nangman nasem dingdan agong chu ahi: Kong innei chu adung, tong jathum, avai tong somnga chule atun tong somthum hiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangman kong innei ja chu bangkot khat nasem ding, chule hichu achung lama kon tong khatna najoding; chule kong innei kot pi chu apanga nahon ding; chule dan noinung, dan nina, chule dan thumna nasem ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule ven, Keima, keimatah ngeijin vannoi'a hinna hunei tahsaphe jouse sumang dinga leiset chunga twisang kahin letsah ding; chule leisetna um jouse thigam ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahivangin nangma toh kakitepna kaphudoh ding; chule nangma nachapate, na inneipi, chule nachapate inneipite toh Kong'a nalut dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule tahsaphe-a hing jouse-a kona ganhing namkim lah-a akoptocheh nangma toh hing khom dinga, Kong innei sunga chu anu khat le achal khatcheh nahinpuilut ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vachate amaho jat dungjuija, ganchaho ama ama jat dungjui cheh-a, chule leisetna vah ganhing ama jat dungjui cheh-a, ajat jouse akopto cheh-a vah hing dinga nahenga hung diu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangman nangma dinga nehthei an jouse nalah-a, chule nakoma nakhol khom ding; chule hichu nangma le amaho dinga an hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutichun Noah'in Pathen'in athu apeh jouse bangtah-in aboltan ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Noah jah-a, Nangma le na-insung mite nabonchaovin Kong innei sunga hunglut nun; ajehchu hiche khangmite lah-a hin kamitmun nangma michonpha nahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sa theng jouse lah-a kona anu le achal to-sagi; chule sathenglou jouse lah-a kona anule achal to-ni cheh nangma toh umkhom dinga nalah ding;
  </para>
  <para style="p">
    <verse number="3" style="v" />Vanlaijola leng vachate jong leiset chung pumpi-a achilhah-u aumjing nadinga, anu le achal to-sagi nalah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ni sagi joule keiman leiset chunga nisomli le jan somli go kajuhsah ding; chule keiman kasemsa ahingthei jouse leisetna kona kasuhmang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Noah'in Pakaiyin thu apeh jouse bangtah chun aboltan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule leiset chunga twisanglet chun Noah kum jagup alhingtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Noah chu achapate toh, a-inneipi toh, chule achapate inneipiho toh twisang letding jeh chun kong innei sunga alut taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Satheng lah-a kon, sathenglou lah-a kon, vachate lah-a kon, chule leiset na akitholtho ganhing jouse lah-a konin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen'in Noah koma athupeh bangtah chun, anu le achal akopto cheh-in Noah koma kong innei sunga chun alut taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, ni sagi jouchun leiset chunga chun twi chu ahung lentan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noah hinkho kum jagup alhinna, alhani channa, nisom le nisagi ni, chuche nitah chun twipi thuhtah nah ho jouse-a ajaltan, chule van bangkot ho akihongtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule vannoi leiset chunga chun nisomli le jan somli go aju tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuche nitah chun Noah le Noah chapate Shem, Ham chule Japheth, chule Noah inneipi le achapate inneipi thum chu kong innei sunga chun alut taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaho, chule gamsa jouse ama ama jat dungjui cheh-in, gancha jouse ama ama jat dungjui cheh-in, leiset na a-opma kitholtho ganhing jouse ama ama jat dungjui cheh, chule vacha namkim ama ama jat dung jui cheh-in alutsoh keijun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin hinnahu nei tahsaphe chengse chu akopto cheh-in, Noah henga kong innei sunga chun alut taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pathen'in ama thu apeh bangtah-in, alut chasun chu tahsaphe pojouse anu le apa akopcheh-in alutnun ahi. Chuin Pakaiyin kot chu akhah tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin leiset chunga chun nisomli twisang alenin; chuin twi akhang cheh cheh-in, kong innei chu aletdoh-in, chule tolla konin akikhang doh tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule twi chu akhangin, chule leiset chunga chun hatah-in akhang tan; chuin kong innei chu twi chungah akitol len ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule leiset chunga twi chu nasatah-in akhang jengtan; chuin van noija lhangsang ho jouse chu achuptan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mol jouse chupmin, tong som le tong nga geijin twi chu akikhang tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichun leiset chunga vahle tahsaphe po jouse, vachate jong, ganchaho jong, gamsa hojong, tolla a-opma kithol ganhing hojong, mihem jouse jong athigam heltan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anah hom sunga hinna hunei, tolgoa umjouse athigam tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun leiset na cheng ahingthei jouse, mihem, gancha, a-opma kithol jouse, chule vanlaijola vachate abonchan leisetna konin akisumang tan ahi. Noah le kong innei sunga umho bouchu ahingin aumun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuti chun ni jakhat le nisomnga geijin, leiset chunga twi avei denin ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pathen'in Noah le Kong innei sunga aumpi hinna nei ganhing chengse le ganchaho abonchan ageldoh-in ahi. Hichun Pathen'in vannoi leiset na hui anunsah in ahile, twi chu akemsuh tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Twipi thuhtah nah-ho leh van bangkot hochu akikhahtan, chule van'a kona go hungju chu atang tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin twiho chu leisetna konin tanglouvin akemsuh-in: chule ni jakhat le nisomnga jouvin twi chu akang tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lhasagi channa, nisom le nisagi nin kong innei chu Ararat molchunga chun akingatan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lhasom channa geijin twi chu tanglouvin akemsuh suh-in; lhasom channa nimasa ni chun molvum chu akimutan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin ahitin ahi, nisomli jouvin Noah'in asem kong innei bangkot chu ahongin;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule va-ah khat alendoh sah-in ahile, leiset na kona twi chu akan kahsen alengle len ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin leiset na twi chu kangtam ti hetna dingin ama-a konin vakhu khat alendoh sah kitnin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin leiset pumpi chunga twi aum nahlai jeh-in, vakhu chun akenga chuh-a kingah na ding mun amujoupon, ama heng lam Kong inneija chun ahung kile kittan ahi. Chuin aman akhut alhangdoh in vakhu chu Kong innei sunga chun alalut tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ama ni sagi akhongai kitnin; chuin vakhu chu kong innei sunga konin alhadoh kitnin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin nilhah lamin vakhu chu ahenga ahung kile kitnin; chule veuvin, amuh-a Olive na kiloulha thah aumin ahi. Hichun Noah'in leiset na konin twi akangtai ti ahetan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ni sagima akhongai be kitnin; chuin vakhu chu alendohsah kitnin ahile, ahengah ahung kilekit tapon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, kum jagup le kum khat na, lhamasa, chule ni masapen nichun leiset na konin twi chu akangtan ahi. Chuin Noah'in akong innei khuna chu ahohlhan, aven ahile, veuvin, leiset chunga twi chu akang tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin alhani channa, nisomni le ni sagi ni chun tol chu agotan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pathen'in Noah jah-a hitin thu aseije,
  </para>
  <para style="p">
    <verse number="16" style="v" />Kong innei sunga konin nangma, na inneipi, nachapate, chule nachapate inneipi te toh potdoh taovin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Naumpi hinna nei jouse, ganhing namkim, vacha ho, gancha ho, chule tolla vah jouse chu leiset chunga chilhah tamtah neiding, hinpha ding, chule pungjal dingin kong'a konin hinpuidoh tan, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichun Noah chu achapate, a-inneipi, chule achapate inneipite toh apotdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gamsa jouse, a-opma kithol ganhing jouse, vachate jouse, chule leiset na akithol jouse chu, ama ama jat dung jui cheh-in kong innei ja konin apotdoh taove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Noah'in Pakaiya dingin maicham khat asemin; satheng jouse-a konle vacha theng jouse-a konin alan, maicham chunga govam thilton atoh tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin agimnam tuitah chu ajan, Pakaiyin alungthimin, keiman mihem jeh-in leiset gaosap kit taponge; ajehchu mihem lungsunga angaitona jouse hi achapana pat phaloupan ahitai; chule keiman kanabol banghin avelin hinna nei ganhing ho sumang taponge.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vannoi leiset aumlai chansea, muchi tu phat le chang-at phat, dap le sat, phalbi le nipi, sun le jan tang talou ding ahi, ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pathen'in Noah le achapate chu phatthei aboh-in, ajah uvah, Hin phaovin lang pungthei jun, chule leiset lodim soh-un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule leiset chunga gamsa jouse, vanlaijola leng vachate jouse, chule tolla vah ganhing jouse, twikhanglen na nga jouse chunga nangho ginna le kichatna umcheh ding ahi; amaho khu nangho khutna kapehdoh ahitai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Achatloh thei ganhing jouse nangho an ding ahi, anche louhing kapeh banga thil jouse kapeh nahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amavang sa chu ahinna puma, hichu athisan ahin, naneh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule thonlouva nahinnao thisan phu chu kalah ding; gamsa jouse khutna kon le, mihem khutna kona kalah ding; mitin sopi jouse khutna kona keiman mihem hinna phu chu kalah ding ahi
  </para>
  <para style="p">
    <verse number="6" style="v" />Koi hile mihem thisan so-a chu ama thisan jong mihemin asoding ahi. Ajehchu aman Pathen lim banga mihem asem ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho, hinpha uvin, chule punguvin; leiset chunga hin chilhah tamtah hinguvin, chule asunga hin hapunin pungun, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pathen'in Noah le aumpi achapate jah-a thu aseijin,
  </para>
  <para style="p">
    <verse number="9" style="v" />Veuvin, keiman nangho le nangho nunga nachilhah teo toh kakitepna kaphutdetne;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangma toh uma hinna nei ganhing jouse, vachate, ganchate, chule leisetna naumpi gamsa chengse; Kong innei sunga kona hung potdoh jouse-a kona leiset chunga gamsa jouse toh kakitepna kaphutdetnin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman nangma toh kakitepna kaphudet ding; tahsaphe pojouse twisang letna avela kisumang kit talou ding; chule leiset sumang dinga jong twisang lenkit talou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pathen'in, Hichehi keima le nangma chule nangma toh umkhom hinna nei ganhing jouse toh akhang akhanga dinga kakitepna melchihna ahi:
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman ka lhagui meilah-a kakoije, hichehi keima le leiset kah-a kitepna melchihna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hitiding ahi, Keiman leiset chunga meibol kahin kaisah teng, meilah-a chu lhagui kimuding ahin;
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule keiman nangho le tahsaphe po hinna nei ganhing jouse toh kakitepna chu kageldoh ding; twi chu tahsaphe pojouse sumang dinga lenkit talou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule lhagui chu meilah-a umding, Pathen le leiset chunga tahsaphe po hinna nei ganhing jouse toh tonsotna dinga kakitepna chu kageldohna dinga, hichu kahin vetding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pathen'in Noah jah-a, hichehi keima le leiset chunga tahsaphe po jouse kikah-a kaphudoh kakitepna melchihna ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kong innei sunga kona potdoh Noah chapate chu Shem, Ham chule Japheth ahiuve: chule Ham chu Canaan pa ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiche hohi Noah chapate thumho chu ahiuvin; chule amaho-a kona hi leiset pumpi losoh-a uma ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Noah'in loulhou mi ahunghi panin, chule lengpilei abolin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman lengpitwi adonin ahile akhamtan; apon in sunga chun pon sillouvin aumtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Canaan pa Ham chun apa sagohkeu chu amun, inpo-a um asopiteni jah-a chun aseijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Shem le Japheth'in pon alalhonin, alengkou gela abang lhonin, anungtoi lhonin, apao sagohkeu chu pon aga khu lhonin; chule amailhon anung ngat lhonin, apao sagohkeu chu amulhon pon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Noah alengpitwi khama konin ahung limdoh-in, achapa neojon abolna chu ahetan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman, Canaan chungah gaosap lhunghen, asopi teni henga soh ho soh hihen, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman, Shem Pakai Pathen chu nunnom hen, chule Canaan chu asoh-in panghen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathen'in Japheth khantousah hen, chule ama Shem pon in ho-a chengding; chule Canaan chu asoh hiding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin twisanglet nungin Noah kum jathum le kum somnga ahing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Noah hinkho abonchan kum jakole kum somnga ahi. Chuin ama athitan ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichehi Noah chapate Shem, Ham chule Japheth akhanggui lhah-u ahi: Twisanglet nung chun amahon chapate ahingun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Japheth achapate chu, Gomer, Magog, Madai, Javan, Tubal, Meshech chule Tiras ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Gomer chapate chu, Ashkenaz, Riphath, chule Togarmah ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Javan chapate chu, Elishah, Tarshish, Kittim chuleh Dodanim ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiteho-a kon chun twikol gama cheng chidang namdangho chu apao dungjui cheh le ama inko dungjui cheh, chule anam dung jui cheh-un ahung kikhen jal taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Ham chapate chu, Cush, Mizraim, Put chule Canaan ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Cush chapate chu, Seba, Havilah, Sabtah, Raamah, chuleh Sabtecha ahiuve. Chule Raamah chapateni chu, Sheba le Dedan ahilhone.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Cush'in Nimrod ahingin; ama chu leiset chunga mi thahat tahkhat ahung hitan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama chu Pakai mitmun gamleng hattah ahin; hijeh chun, Pakai mitmu-a gamleng hattah Nimrod bangin, tin akiseijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule alenggam kipatna chu Shinar gamsunga um Babel, Erech, Accad, chule Calneh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuche gama kon chun Assyria gama alutnin, Nineveh, Rehoboth, chule Calah khopi asadoh-in,
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Nineveh le Calah kikah-a chun Resen atungdoh-e; hichu khopi lentah ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mizraim'in Ludim, Anamin, Lehabim, chule Naphtuhim,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathrusim chule Casluhim, (ama-a kona chu Philistine te hungdoh ahi,) chule Caphtorim ahingin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Canaan'in apeng masa pen Sidon ahingin, chuin Heth;
  </para>
  <para style="p">
    <verse number="16" style="v" />Jebus miho, Amor miho, Girgas miho,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiv miho, Ark miho, Sin miho,
  </para>
  <para style="p">
    <verse number="18" style="v" />Arvad miho, Zemar miho, chule Hamath miho ahingin ahi. Chule khonungin Canaan mite insungmi ho gamtinnah akithejal taovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Canaan mite gamgi chu Sidon'a pat Gerar lang jonin Gaza geijin akilhunglut peh-in, Sodom lam jonin akilhungin, Gomorrah aphan, Admah ahinphan, chule Zeboiim ahopan, Lasha geijin akilhunglut peh-e.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hite hohi aphung aphung cheh, apao apao cheh, agam agam cheh, chule anam dol cheh-a Ham son ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Japheth upa, Eber chate pubulpi Shem jong chun chanute chapate ahingin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem chapate chu, Elam, Asshur, Arphaxad, Lud, chule Aram ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Aram chate chu, Uz, Hul, Gether chule Mash ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Arphaxad'in Shelah ahingin, chule Shelah'in Eber ahinge.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Eber'in chapa ni ahingin: khatpa min chu Peleg ahi, ajehchu ama khanga vannoi leiset kikhen ahi; chule asopipa min chu Joktan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Joktan'in Almodad, Shaleph, Hazarmaveth, Jerah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadoram, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="28" style="v" />Obal, Abimael, Sheba,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ophir, Havilah, chule Jobab ahinge: hichengse hi Joktan chapate ahiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule achennao gam chu Mesha'a patna Sephar lam jotna solam molsang chan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hichenghi hi aphung dung jui cheh-u, apao dung jui cheh-u, agamkai dung jui cheh-u, chule anam dung jui cheh uva Shem chapate chu ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hicheng hi Noah chate insungmi, akhang dung juile anam dung juija ahiuve: chule amaho-a kona hi twisanglet nunga vannoi leiset na namtin hi kihom khena ahi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule vannoi leiset pumpi chun paokhat hamkhat athouvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, amaho solama acheuvin ahile, Shinar gama phaicham khat amuvin; hia chun amaho acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahole ama ho akihouvun, Hungun, eihon cheh dengu hitin, phatah in goutah-u hite, akitiuve. Chuin amahon song khelin cheh amangun, athoimatna khelin vahaibon amangun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amahon, Hungun, eihon eiho dingin khopi khat le insang tah khat, aleh van ho sunphan sao hitin; chule iminu thansah-u hite, achuti louleh eiho vannoi leiset pumpi-ah kithecheh getnu hite, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin mihem chate khopi leh insang sah chu ve dingin Pakai chu ahung kum lhan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin, Veuvin, mihohi pumkhat le paokhat ahiuvin; chule hichehi amahon abol patnu ahitai: chule tu-a amahon boldinga alunggotnu chu imachan asuhtang loudiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hungun, eiho kumsuh-u hitin, khatnin khat thusei ahetmo na diuvin, khu kom akhun apaovu gasucheh uhite, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuti chun Pakaiyin amaho chu chua kon chun vannoi leiset pumpi chungah akhenchehtan ahi. Chuin amahon akhopi sah-u chu adalha taove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun chukom mun chu Babel asah taove; ajehchu chukom munna Pakaiyin vannoi pumpi pao asuhcheh-a; chule chukoma kona chu Pakaiyin amaho chu vannoi leiset pumpi-a athecheh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche hohi Shem khanggui hochu ahiuve: Shem kum jakhat alhinin, twisanglet nung kumni jouvin Arphaxad ahingin ahi
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Arphaxad ahin nungin Shem kum janga ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Arphaxad kum jathum le somthum le nga alhinin, Shelah ahingin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Shelah ahin nungin Arphaxad kum jali le kum thum ahingin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Shelah kum somthum alhinin, Eber ahingin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Eber ahin nungin Shelah kum jali le kum somthum ahing nalaijin, chanute le chapate ahingin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Eber kum somthum le kum li alhinin, Peleg ahingin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Peleg ahin nungin, Eber kum jali le kum somthum ahing nalaijin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Peleg kum somthum alhinin, Reu ahingin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Reu ahin nungin Peleg kum jani le kum ko ahing nalaijin, chapate le chanute ahingin ahi
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Reu kum somthum le kum ni alhinin, Serug ahingin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Serug ahin nungin Reu kum jani le kum sagi ahing nalaijin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Serug kum somthum alhinin, Nahor ahingin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Nahor ahin nungin Serug kum jani ahing nalaijin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Nahor kum somni le kum ko alhinin, Terah ahingin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Terah ahin nungin, Nahor kum jakhat le kum somleko ahing nalaijin, chapate le chanute ahingin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Terah kum somsagi alhinin Abram, Nahor, chule Haran ahingin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tun hicheng hi Terah khanggui ahi: Terah in Abram, Nahor chule Haran ahingin, chule Haran-in Lot ahingin, ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Haran chu apa Terah athi masangin apenna Chaldea gama Ur kho-a chun athitan.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abram le Nahor vang chun ji anei gel lhonin: Abram jinu chu amin Sarai ahin, Nahor jinu min chu Milkah ahin, Haran chanu ahi; amahi Milkah le Iscah hingah apalhon ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin Sarai chu aching ahin, cha neilou ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Terah chun achapa Abram, atupa Haran chapa Lot, chule amounu Sarai, Abram inneipi chu apuijin, amaho chu Chaldea gama Ur'a konchun Canaan gama dingin ache taovin ahi. Chuin Amaho Haran alhungun, chukoma chun acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Terah hinkho chu kum jani le kum nga ahin; Terah Haran mun'a athitan ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Pakaiyin Abram jah-a, Nagama kon, naphung chanpi ho-a kon, chule napa insunga konin potdoh inlang, keiman nangma kavetsah ding gama chun chen;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule keiman nangma nam lentah khatna kasemding, chule keiman nangma phatthei kaboh-a, namin kaloupisah ding; chule nangma phatthei boh chang nahiding, ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangma phatthei naboh ho chu keiman phatthei kabohding, chule na gaosap hochu kagaosap ding ahi; chule nangma-a kona leisetna insung jouse phatthei chang diu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuti chun Pakaiyin ajah-a aseibang chun Abram akipatdoh tan; chule Lot jong amatoh akilhonin ahi. Chule Haran'a kona akipatdoh chun Abram kum somsagi le kum nga ahitai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Abram'in a-inneipi Sarai, asopipa chapa Lot, alamdoh thil jouse, chule Haran'a peng amite jouse chu akipuijin; Canaan gam jonin akipat doh-un; chule Canaan gam chu ahung lhung taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Abram'in gamsung chu Shechem gei, gangpi thing kena Moreh gei achonsoh-in ahi. Chuche laichun agama chun Canaan miho achengun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakai chu Abram henga akilah-in, ajah-a, Hiche gamhi nachilhah te henga kapeh ding ahi, ati. Chuin aman ahenga hung kilah Pakai ding chun chukoma chun maicham khat asemin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ama chukoma konchun Bethel solama Molsang khat na akichonin, Bethel lhumlam le Ai solam kah-a apon in asongin ahi; chukoma chun Pakai dingin maicham asemin, Pakai min akouvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Abram chu lhanglam jonin achepeh nalaijin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin gamsunga chun kel alhan: chule Abram Egypt gama cham dingin achesuh tan ahi; ajehchu gam sunga chun kel akhoh lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, Egypt gam alutding konin, a-inneipi Sarai jah-a, Tun vetan, nangma vetdinga numei melhoitah nahi ti kahei.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuti ahijeh-a chu hung hiti ding ahi, Egypt mihon namu tenguleh, hiche hi a-inneipi ahi, atidiu; chule amahon keima eitha uva, nangma vang nahinghoi dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangma vanga phatah-a kaum theina dingle, nangma jala kahinthei na dingin, anaonu kahi tin seijin, tia katao ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ahitin ahi, Abram Egypt gam alhun phatnin, Egypt mihon numei chu amuvin, amel chu hoi asalheh jengun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharoah semanghon jong amanu chu amuvin, chule Pharoah jah-a aseiphaovin ahi. Chuin numeinu chu Pharoah insunga apuilut taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman Abram chu amanu jal chun abol pha lheh-in ahi. Chule aman kelngoi, bongchal, sanganchal, soh pasal, soh numei, sangan nu, chule sangongsao aneitan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin Abram inneipi Sarai jeh chun Pakai chun Pharoah leh a-insung mite chu hise nasatah-in asugenthei tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pharoah'in Abram chu akouvin, ajah-a, Kachunga nathil bol hi ipi hitam? Na-inneipi ahichu ipi dinga neisei peh lou ham?
  </para>
  <para style="p">
    <verse number="19" style="v" />Ipi dinga kanaonu ahi nati ham? Hijehchu ahi ka-inneipi dinga kana kipui lona chu; hijeh chun tun na inneipi hi ven, kipuijin lang chemang tan, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pharoah'in ama chung changa chun amite chu thu apen; amahon amachu a-inneipi toh, anei chengse toh asolmang taovin ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Abram Egypt gama konin apotnin, a-inneipi, anei chengse, chuleh Lot toh lhanglam ajon taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Abram chu gancha, dangka chule sana in ahao lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ama lhanglama kon chun Bethel geijin achepeh-in, Bethel le Ai kah-a atilla apon in sonna mun geichun achen;
  </para>
  <para style="p">
    <verse number="4" style="v" />Amasa-a maicham asem na mun chu ahung lhun tan ahi. Chukoma chun Abram Pakai minin ataovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Abram toh lhonle Lot jong chun kelngoi hon, bonghon, chule pon in aneitan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amani chenkhom lhona dingin, agam chun adoltapon ahi: ajehchu aneilhon atam behseh jeh-in, amani achengkhom theilhon tapon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Abram gancha ching hole Lot gancha chingho kah-a kinah na aumtan ahi. Chule chuche laichun gam sunga chun Canaan miho le Perizz miho achengun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Abram'in Lot jah-a, Nahenga katao ahi, nangle kei kah-a, chule kagan ching te le nangma gan ching te kah-a kinah na umdahen, ajehchu eini sopikhat ihi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gam apumpia namasanga um hilouham? Katao ahi, keima-a konin achomin umdoh tan; nangman veilam nakilhen leh, keima jetlama chengting; achuti louva nangma jetlama nache le, keima veilama cheng kate, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lot akhodah-in, Jordan phaicham chengse chu aven ahile muntin chu twi anengin, (Pakaiyin Sodom le Gomorrah asuhmang masang ahin,) Zoar jotna geichun Egypt gam toh abangin, Pakai hon toh abangin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin Lot'in Jordan phaicham pumpi chu akilhenin, solam ngan achetan ahi. Chule amani khat chu khatna konin akikhen lhontan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram chu Canaan gama chun achengin, Lot chu phaichama khopi ho-a chun achengin, chuin apon in chu Sodom lam ngan asongin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin Sodom miho chu Pakai mitmu-a khang giloutah leh chonsetah ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Abram'a kona Lot akikhendoh jouvin, Pakaiyin Abram jah-a, Tun khodah inlang, naum namun na kon chun sahlam, lhanglam, solam, chule lhumlam vetemin,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu nangman namu gam chengse apumpia nangma le nachilhahte tonsotna dinga kapeh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keiman nachilhah te leisetna leivuijat kahisah ding; chule mikhatnin leiset chunga leivui asimjouva ahileh nangma chilhahte jong kisimjou ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kipat doh-in, hiche gam hi adung avai chonchan len, ajehchu keiman hichehi nangma kapeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin Abram'in apon in chu achonin, ache achen Hebron gama Mamre gangpi phaicham koma chun achengin, chule chukoma chun Pakai dingin maicham khat asemin ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Shinar lengpa Amraphel, Ellasar lengpa Arioch, Elam lengpa Chedorlaomer, chule namho lengpa Tidal alal laijuvin ahitin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hicheho hin Sodom lengpa Bera, Gomorrah lengpa Birsha, Admah lengpa Shinab, Zeboiim lengpa Shenaber, chule Zoar kiti Bela lengpa akisat piuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho abonun chi dillen pang Shiddim phaichama chun akikhomun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon kum somle kum ni Chedorlaomer anajenu ahin, kum som le kum thum channa-in akiphin taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin kum som le kum li alhin kum-in Chedorlaomer lengpan aumpi leng dang ho toh ahung konun, Ashteroth Karnaim gama Rephaim mite, Ham gama Juzim mite, Shaveh Kiriathaim gama Emim mite athat uvin,
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Hor mite chu aum nau Seir Molsang gei le, gamthip gamgia um El Paran changei jin athat taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amaho ahung kileuvin En-mishpat (hichu Kadesh ahi,) 'ah ahungun, Amalek mite gam pumpi le Hazezon-tamar-a cheng Amor mite chu athat kitnun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuphat nin Sodom lengpa, Gomorrah lengpa, Admah lengpa, Zeboiim lengpa, chule Bela lengpa (Bela chu Zoar ahi;) chu akipat doh-un, amaho chutoh kisat dingin Siddim phaichama apangkhomun,
  </para>
  <para style="p">
    <verse number="9" style="v" />Elam lengpa Chedorlaomer, namtin lengpa Tidal, Shinar lengpa Amraphel, chule Ellasar lengpa Arioch dounan, lengli chu leng nga chutoh akisat taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Siddim phaichama chu vahaibon dimset ahin; hia chun Sodom lengpa le Gomorrah lengpa ajam nalam lhonna alhalut lhontan; chuleh amoh chengse chu molsang lamah ajam taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon Sodom le Gomorrah neile gou jouse, chule aneh achah jouse apouvin, achemang taove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon Sodom'a cheng Abram sopipa chapa Lot jong chu anei chengse toh apuimang taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin asohcha khatnin Hebrew mi Abram jah-a chun thu ahung lhutnin ahi; hichepetna chu ama Eshcol le Aner sopipa, Amor mi hotoh Mamre gangpi phaicham koma chun achengun ahi. Chule amaho chu Abram toh thukhat kisa-a ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Abram'in asopipa gal hinga akaiju ajah phatnin, ama insunga pengcheh, hilthemsa cheh asohte jathum le somleget akipuijin, Dan geijin anung deltan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin jan-in amaho nokhum dingin amale asohte chu akihom khenun, chuin amaho chu athatnun, Damascus sahlama um Hobah chan geijin adelun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman neile gou jouse, asopipa Lot jong chu aneile gou chengse toh, chule numei hole miho jong chu ahin lepuikit tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman Chedorlaomer le aumpi lengho chu atha jouva ahung kile kit phatnin, Sodom lengpa chu Abram lamto dingin Shaveh phaichama achen ahi (hichu leng phaicham ahi).
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Shalem lengpa Melchizedec'in changlhah le lengpitwi ahin choijin ahi; ama chu chungnung pen Pathen Thempu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Aman Abram chu phatthei aboh-in, Van le lei neipa chungnung pen Pathen'a konin Abram phatthei changhen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nagal mite nakhutna pedoh-a chungnung pen Pathen nunnom hen, ati. Chuin Abram'in amachu aneijouse hopsom-a hopkhat apen ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Sodom lengpan Abram jah-a, Miho chu keima neipen lang, thilkeo hochu nangma changtan, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Abram'in Sodom lengpa jah-a chun, Keima van le leiset neipa, chungnung pen Pakai Pathen henga kakhut kadop sang ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Keiman pat jang kengchot khao te jeng jong, nanga pou pou chu kalah louding ahi, atiloule, Keiman Abram kahao sahtai, tiget nin nate.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gollhang hon aneh mangu chule kalhonpi Aner, Eshcol, chule Mamre hiteho chu achan ding dol changu hen, ati.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hicheho nunghin Pakai thu chu Abram henga gaovin ahungin, ajah-a, Kicha hih-in, Abram, keima nalumdal le nakipa man lentah chu kahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Abram'in, Pakai Pathen, chabeija kaum dending namu nunga nangman keima ipi neipeh ding ham? Chule ka-insunga goulo dingla hiche Damascus mi Eliezar ahibouvin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Abram'in, Vetan, nangman keima chi neikhaisah pon; chule Ven, ka-insunga penga chu kagou loding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuphatnin veuvin, Pakai thu chu ahenga ahung lhungin, ajah-a, Amachu nagoulo hilouding; amavang nangma taiguija penga bou chun nagou alo ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ama chu inpolama apuidoh-in, ajah-a, Vanlam khu vetemin, ahsi khu nasimjou dingle simtemin, ati. Chuin aman ajah-a, Nachilhah jong hijat khu hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman Pakai chu atahsan nin; chule aman hichu ama dingin chonphat na-in asimpeh tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin ajah-a, Keima hiche gamhi gouva nalo dinga Chaldea gam Ur khopi-a kona nahin puidohpa Pakai chu kahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman, Pakai Pathen hiche kaloding chu iti kahet dingham? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman ajah-a, Nangman kumthum lhingsa bongla khat toh, kumthum lhingsa kel-la khat toh, kumthum lhingsa kelngoichal khat toh, vakhu khat toh, vapal noukhat kahenga hinchoijin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman hicheng jouse chu ahin choijin, hiho chu ahapsatnin, hap langkhat le hap langkhat kingatton akoijin, ahin vachaho vang chu ahapsatpon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule muthong ho chu ahung len uva sathilong chunga chu achuh ji tengule, Abram'in adel mangjin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin nisa alhum konin, Abram chunga imut milna achutan; chule veuvin, kichat umtah muthim nasatah-in ahinkhutan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin Abram jah-a, Nachilhah te chu amaho gam hilou gamkhatna maljinna gaum diu; chule amahon amaho chu ajendiu; chule amahon amaho chu kum jali abolgenthei diu ahi tihi kichentah-in hen, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule keiman aga jenu nam jong chu athu-u katan ding; chule amaho chu khonungle neile gou ninglhing setna hung potdoh diu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangma napu napa te henga lhamonga nache ding; chule nangma natehkem kei teng vuija naum ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amavang khang li lhin nale amaho chu hikoma hung kile kit diu ahi: ajeh chu Amor mite khangitlouna abulhing hih laije, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, Nisa alhumma, mu ahung thim phatnin, veuvin, lhummei khucheichoi le meisel al lenglung chu sahap sat ho kahlah-a kitolin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuche nichun Pakaiyin Abram toh kitepna khat asemin, hitin aseije, Keiman nachilhahte henga hiche gamhi Egypt vadunga pat luilen, Euphrates vadunglen gei;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ken mite, Keniz mite, Kadmon mite,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hit mite, Perizz mite, Rephaim mite,
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Amor mite, Canaan mite, chule Jebus mite abonchauva kapeh ahitai, ati.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Abram inneipi Sarai'in amachu cha ahin peh pon ahi. Chule amanun Egypt mi amin Hagar kiti soh numei khat aneijin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Sarai'in Abram jah-a, Tun vetan, Pakaiyin keima chahing dingin eiphaltapoi: nahenga katao ahi, amanu-a kona chapang kaneithei khatle, kasohnu koma galut nin ati. Chuin Abram'in Sarai thu chu angaitan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Abram Canaan gama kumsom achen jouvin, Abram inneipi Sarai'in asohnu Egypt mi Hagar chu apuijin, a-inneipu Abram jidingin agapetan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ama Hagar henga chun alutnin ahile, amanun nao avoptan ahi. Chuin amanun anaovop akihet phatnin, apinu chu anoisetan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Sarai'in Abram jah-a, Kabolkhel hi nangma mopohna ahi: Kasohnu na-angsunga dingin kapein; chule aman anaovop akihet phatnin einoisetai. Pakaiyin nang le kei kah-a thu tanhen, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin Abram 'in Sarai jah-a, Ven nasohnu nakhut na um ahi; nangman pha nasah bang chun achunga boltan, ati. Chuin Sarai'in amanu chu abolgenthei lhehjeng phatnin, amanu ama angsunga konin ajamtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakai vantil'in amanu chu Shur jotna lampi pam, gamthipma twikhuh khat koma amudoh tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman, Sarai sohnu Hagar, hoija hungkon nahi-a, chule hoija cheding nahim? ati. Chuin amanun, keima kapi nu Sarai angsunga kona jam-a kahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakai vantil chun amanu jah-a, napinu henga kilekitnin, chule akhut noija kipelutnin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakai vantil chun amanu ajah-a, Keiman nachilhah hapuna kapunsah ding; atam behseh jeh uva simseng hilou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakai vantil chun amanu jah-a, Ven, nangma naovop nahin, chule chapa khat nahin ding ahi: Nangman amin Ishmael nasahding ahi, ajehchu Pakaiyin nakibol hesohna najahpeh tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule amachu miphamo tah hiding; aman mijouse douna akhut alapding, chule ama douna-a mijousen akhut alapdiu ahi. Chule ama asopite jouse angsunga chengding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amanun akihoupi Pakai minchu, nangma eimu-a Pathen tin asah tai. Ajehchu amanun, keima eimu-a amachu keiman jong kamu hitam? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuche jeh chun chukom twikhuh minchu Beer-Lahai-Roi akisah tai. Veuvin, hichu Kadesh le Bered kah-a um ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Hagar'in Abram chapa khat ahinpehtan; chule Abram'in Hagar toh ahin achapa min chu Ishmael asahtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Hagar'in Abram dinga Ishmael ahinpeh chun, Abram kum somget le kum gup alhingtai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Abram kum somko le kumko alhinin, ahenga Pakai ahung kilah-in, ajah-a, Keima hat chungnung Pathen kahi, kamasanga kitah tah-in lamlhan lang, nangma chamkimin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule keiman keimale nangma kah-a kakitepna kasemdoh ding, chule nangma hapuna kapunsah ding nahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Abram'in tolla amai asulut tan ahi. Chuin Pathen'in amachu akihoupin, ajah-a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Keima thudol vang, ven, kakitepna chu nakoma aume, chule nangma nam tamtah pa nahi ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Namin jong Abram tia kikou talou ding, amavang namin Abraham tia kikou ding ahitai; ajehchu nangma namtin pa-a kasem nahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule keiman nangma hapuna kapunsah ding, chule nangma-a kona nam ho kasemdoh-a, chule nangma-a kona lengho hungdoh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Keima nangma le nanunga nachilhah te-a dinga Pathen kahina dingin, keima le nangma kah-a, chule khonunga nachilhah te akhang akhanguva tonsot kitepna-a dinga kakitepna kaphudoh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman nakholjinna Kanaan gam pumpi hi, nangma le khonunga nachilhahte henga tonsotna nalo diuva kapeh ding; chule keima amaho Pathen kahiding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pathen'in Abraham jah-a, Nangman kakitepna hi nanitding, nangma le khonunga nachilhah ten akhang akhanguva anit diu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keima le nangma chule nanunga nachilhahte kah-a nanitdiu kakitepna chu hiche hi ahi: Nalah uva pasal tapou chun chep atan cheh ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nanghon natahsao nachep vunnu chu natan dingu; hichu keima le nangho kah-a kitepna melchihna hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nalah uva mi niget lhing tapou, nason nachilhah-a pasal tapou, na-in'a peng hihen, nachilhah hilou gamdang mi nasuma nachoh hijongle, pasal tapou chu chep kitan cheh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na-in'a peng hihen lang, nasuma nachoh hijong leh chep kitan teiding ahi; chule kakitepna chu tonsot kitepna-a dinga natahsaova umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Koi hijongle cheptan lou pasal chapang atahsa-a achepvun cheptan lou chu, chuche mipa chu amite lah-a kona paidoh-a umding ahi; amachun kakitepna asuhkeh ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pathen'in Abraham jah-a, Na-inneipi Sarai thudol vang, Nangman amin Sarai nati tahlou ding; amavang amin Sarah hijoding ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule keiman amanu chu phatthei kabohding, chule tahbeh-a keiman nangma amanu-a kona chapa khat jong kapeh ding nahi. Keiman amanu phatthei kabohding, chule amanu namtin nu hung hiding; chule amanu-a kona mihemte lengho hungdoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Abraham'in tolla amai asulutnin, anuijin ahi, chule alungthimin, kum jakhat mi-a dinga cha peng ding ham? Chule kum somko mi Sarah'in cha ahin nahlai ding ham? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Abraham'in Pathen henga, aw! Ishmael chu namitmu-a hingding hingta vele, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pathen'in, Na-inneipi Sarah'in tahbeh-a nangma chapa khat nahin peh ding, chule nangman amin Isaac nasah ding ahi. Chule kakitepna chu amale ama nunga achilhahte dinga tonsot kitepna hidinga kasuhdet ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Ishmael thudol vang, keiman nathu kangaipeh ahitai: Ven keiman ama phatthei kaboh ahitan; chule achilhah tamtah kahisah-a, hapuna kapunsah ding ahi. Aman vaipi somleni ahin ding, chule keiman ama nam lentah-a kasemding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahin kakitepna vang chu Sarah'in khovei tuphat teng ahinding Isaac toh kasuhdet ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amatoh akihou chai phatnin, Abraham koma konin Pathen achetoutan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Abraham'in achapa Ishmael, chule a-insung peng jouse, chule suma achohtho jouse, Abraham'in a-insunga pasal tapou chu apuijin, Pathen'in ahenga aseibangin chuche ni lele chun atahsao achep vunu atanpeh tan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Abraham chu atahsa achepvun akitan chun kum somko le ko alhingtai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule achapa Ishmael chu atahsa achepvun akitan chun kum somlethum ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuche nilele chun Abraham le achapa Ishmael'in chep atan lhon tan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule a-insunga pasal jouse, a-in'a pengho le gamdang mi suma kichoho jong chun amatoh chep atan cheh-un ahi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ama Mamre gangpi kom aponbuh kotbul-ah sun nisat petna atoupet nin Pakai chu ahengah ahung kilah-in;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama akhodah-in avetna ahile, Veovin, akomtah-a chun mi thum ana dingun; chuin aman amaho chu amuphatnin, apon-inna konchun amaho lemdingin alhaijelin, tolla aboh khupmin, chibai aboh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman, Ka Pakai, tu-a hi namitmu-a lunglhaina kachana ahile; katao ahi, nasoh-a konin chepai hih-in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nahenga katao ahi, twi themkhat beh hin kidomintin, chule nakengu kisilun lang, thingphung noija hin kicholdouvin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nalungthimu akitha-ol theina dingin, changlhah themkhat beh nagalah peh uvinge; chujouteng nangho chepan naovin nate: ajehchu nasoh henga hunga nahi tangalun, ati. Chuin amahon, nasei bangin boltan, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Abraham pon insunga Sarah henga alhailut jel-in, ajah-a, Changbong phatah atena dimthum tenlang, hichu mehin lang, gangtah-in thuh chunga changlhah semin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Abraham bonghon lama alhai jel-in, bongnou nouchet hoitah khat alan, hichu gollhang khat apen, aman hichu gangtah-in agasemin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman bongnoi ha le bongnoi chule bongnou sa asem chu achoijin, a-angsung uva aluipeh-in chule amahon anehpetnu chun, ama akomuva thingphung noija chun adingin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amahon ajah-a, Na-inneipi Sarah hoija umam? atiuve. Chuin aman, Pon insunga khun aume, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, Keima nahenga hinkho phat chedung juija thonlouva kahung kile kitding ahi; chule ven, Sarah na-inneipin chapa khat ahinding ahi, ati. Chule Sarah'in anunglama pon in kotna konchun hichu anajan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun Abraham le Sarah chu upatah le kum tamtah ahilhontan; chule numei hina ngaidol chu sarah chunga tanga ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuti ahijeh chun Sarah chu alungthimin anuijin, katehset jounung sanga hi thanopna kanei ding ham? Ka pakai jongla tehse ahitan, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin Abraham jah-a, ibola na-inneipi Sarah'in, kitehta-a chapa kanei mongding ham? atia nuija ham?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai dinga thil ahahsa behseh umam? Hinkho phat che dungjuija akitepsa phat tahle keima naheng-ah kahung kilekit ding, chule Sarah'in chapakhat ahinding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Sarah akichat jeh chun, akilepmin, keima kanuipoi, ati. Ahin aman, ahipoi, nanui naije, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin miho chu chua konchun akipatdoh uvin, chule Sodom lam agahveuvin; chule Abraham'in amaho achenadiu lampia lhadoh dingin akilhonpin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakaiyin, kathil bol ding hi Abraham koma kona ka-im dingham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham hi nam lentah le thahat tah hung hiding, chule vannoi leiset namjouse ama-a phattheiboh changdiu ahingalin?
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu achate le ama nunga a-insung mite chu thu apeh-a, Pakaiyin Abraham chungchanga athusei chu atohdoh nadinga, chonphatah le chondih tah-a na atoh uva, Pakai lamlhah ajui diu ahi ti keiman kahen ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin, Sodom le Gomorrah pen awgin anasat behset jeh le, achonsetnao anasat behset jeh-in;
  </para>
  <para style="p">
    <verse number="21" style="v" />Tun keima chesuh ingting, chule apen awginu kaheng ahunglhun banga hi chonuvam, chonhih uvam gave inge; chuti ahilou jongle gahe-ing kate, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin miho chu chua kon chun akiheijun, Sodom lam jonin achetauve. Ahivangin Abraham chu Pakai masanga ading jing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Abraham'in agah naijin, ahenga, michonpha ho chu migilou toh nasuhmang tha ding ham?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ijem tin khopi sunga chun michonpha somnga umtale, hiche asunga um michonpha somnga jal chun hiche munchu khenlouvin nasumang jeng dem?
  </para>
  <para style="p">
    <verse number="25" style="v" />Hitobanga bolding chu nangma-a konin gamla hen; michonpha hochu migilou hotoh suhmangtha-a, michonpha hon migilou ho banga athohdiu nanga konin gamlahen; vannoi pumpi thutanpa chun adih-a thu atanlou ding ham? ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakai chun, keiman Sodom khopi sunga michonpha somnga kamuleh, amaho jalchun khopi chu hoidohsah nange, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Abraham'in adonbutnin, Tun vetan, keima leivui le meivambou kahin, Pakai henga thusei dingin kana kipantai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ijem tin michonpha somnga lah-a chun nga lhasam taleh, mi nga alhahsam jehchun nangman khopi chu nasumang jeng dem? ati. Chuin aman, keiman chua chu michonpha somli le nga kamule, sumang ponge, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman ama jah-a, aseikitnin, Ijem tin chua chun somli kimu tale la, ati. Chuin aman, keiman somli ho jalchun sumang ponge, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman ajah-a, Ka Pakai lunghang loujenin, keiman seikit inge, Ijemtin chua chun somthum bou kimu talela, ati. Chuin aman, keiman chua chu somthum kamule sumang ponge, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman, Tun vetan, keima Pakai henga thuseidin kana kipantai; Ijemtin chua chun somni bou kimu talela, ati. Chuin aman, somni jalchun keiman sumang pongkate, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin aman, aw! Pakai lunghang loujenin, khatvei seikit inge, chua chun somkhat sehbou kimu talela, ati. Chuin aman, Keiman somkhat jalchun sumang ponge, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Pakai chu Abraham toh akihouchai phatnin achena dinga achetan; chule Abraham a-in lama ahung kile tai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin nilhah lamin vantil ni Sodom ahunglhung lhonin; chule Lot chu Sodom khopi kotpi bula chun anatouvin ahi. Chuin Lot'in amani chu amuphat nin alemdingin akipatdoh-in, chule tolla aboh khupmin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman, Veuvin tun, ka Pakai teni, katao ahi, nasoh in'a hunglut lhonin lang, jan khovah geijin gehlhonin, chule nakeng kisil lhonin lang, jingkah teng le matah-in thoulhonin natin, chekit lhon tan nate, ati. Chuin amanin, Ahipoi, keini jan khovah keija lamlena kaum lhon ding ahi, atilhone.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman aha ngeh behseh jeh-in, amani akihei lhonin, a-insunga alut lhontai. Chuin aman amani golvah abolpin, cholsolou changlhah akangin, aneuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin amaho alup masangun, khopi sunga miho, Sodom miho tah chu alen aneo, vengtinna kona mihem jousen in chu ahin umtaovin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahon Lot chu ahin kouvun, ajah-a, Tujana nahenga hung miteni chu hoija umlhon tam? Kahenguva hinpui doh-un, amani chu jonpiuvinge, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Lot kotna konchun amaho henga apotdoh-in, kot chu anungkha-in,
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajah uva, Sopite, naheng uva katao ahi, chuti lomin khanggilou hih-un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun veuvin, pasal heloulaihel chanu ni kaneije; katao ahi, namit mu uva pha nasah bangtah uva naboldiuvin amani chu naheng uva hin puidoh peh uvinge; hiche teni chunga vanghin imacha bolhih-un; ajehchu amani ka-in lhalim noija hunglut ahilhone, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amahon, Kinung khinin, atiuve. Chuin amahon aseikitnun, Hiche mipa hi ahung pemlutnin, thutan din akigoi; tunvang amani chunga kabol sang uva nangma chunga phalou cheh-a kaboldiu ahi, atiuve. Chuin amahon mipa, Lot chu hatah-in ahin sonnun, kotkhah chu suhhong dingin ahin naitaove.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahivangin miteni chun akhut ahin lhangdoh lhonin, Lot chu amani henga dingin insunga akailut lhonin, kot chu akhah taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin kot bula um miho chu alen aneo abonun amitnu achotsah lhonin; chutichun amahon kotkhah chu aholdoh jou tapouvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin miteni chun Lot jah-a, Nangman hikoma hi insungmi dang naneijem? Namahpate, nachapate, nachanute, chule khopi sunga koihileh naneichan chu hiche mun'a konhin puidoh-in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu Pakai anga apen awgin chu anasa behseh jengtan, hijeh-a chu hiche munhi kasuhmang lhonding ahi; Pakaiyin hiche sumang dinga eihinsol lhon ahi, ati lhonne.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Lot apotdoh-in, achanute kichenpi amah-pate henga achen, ajah uva, Kipat un, hiche mun'a konhin potdoh-un, Ajehchu Pakaiyin hiche khopi hi asuhmang ding ahi, ati. Ahivangin amachu amah-pate koma totna thusei abangbep tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin jingkho ahung vah phatnin, Vantil teni chun Lot chu akinosah-in, ajah-a, Kipatdoh-in, hikoma um na-inneipi le nachanu teni kipuijin; achuti loule hiche khopi khangitlouna-a hin mantha tha getnin nate, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ama akhongai nalaijin, Pakaiyin ahepi jehchun miteni chun amakhut, a-inneipi khut chule achanu teni khut aman lhonin; apuidoh lhonin, khopi pamlama chun akoilhonin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, amanin amaho polama ahin puidoh honchun, ajah uva, Nakihinso nadiuvin jamun; nanung lamu vehih-un, chujongle phaicham mun khatcha ajong kingapa hih-un; molsang lama jamun, ajole mangthah getnun nate, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Lot'in amani jah-a, Ka Pakai, chuti chu hida hen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vetan, namitmun nasoh hin namitmun lungsetna kachangin, chule nangman kahinkho neihuhdoh peh-in, nami khotona chu nadomsang tai; ahivangin molsang lama chun hoidohna din jamjou ponge, ajo thil gilou khatnin eihin phantin thilo getninge.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tun ven, hiche khopi khu jamlutna dingin anaijin, chule neocha jong ahi; hilama khun neijam sah-in, (hikhu neocha hilou ham?) chutile kahinna hinghoija umding ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman ajah-a, Vetan, hiche thudola jonghin na-ngehna kaphal peh-in, nangman nasei hiche khopi chu sumang ponge.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangma kinonlang, khulama khun jamlut-in; ajeh chu khuchemun nalhun kahse-a imacha kabol theilou ahi, ati. Hijeh chun chuche khopi min chu Zoar akisah tai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lot chu Zoar alut chun nisa leiset chunga asohdoh tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chujouvin Pakaiyin Sodom le Gomorrah chunga Kaat le meikong van'a Pakaiya konin ajuhsah tan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman chuche khopi teni, phaicham jouse, khopi sunga cheng jouse, chule leiset chunga kehdoh ho jouse abonchan asumangsoh keitan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahivangin inneipi chun Lot nunga konin anunglam aven ahileh, chi khompi asohtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Abraham jingpi tah-in athouvin, Pakai angsunga adinna mun'a chun achen;
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Sodom le Gomorrah lam, chule phaicham gamlam jouse chu aven; chule veuvin, hiche gam meikhu chu thih kisou jolna munna meikhu bangin akitung veng vung jengin ahi
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, Pathen'in phaicham khopi ho asuhmang chun, Pathen'in Abraham chu ageldoh in, Lot chenna khopiho asuhmang chun Lot chu akisuhmang ho lah-a konchun asoldoh-in ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Lot chu Zoar kho-a kon chun molsang lama achetouvin, achanu teni toh achengtai; ajehchu ama Zoar kho-a chending chu kicha-a ahi. Chuin ama achanu teni toh song ko-a acheng taovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin apeng masa nuchun aneojonu jah-a, Ipahi atehtan, vannoi leiset dan ngaija ihenguva hung ding leisetna pasal khatcha jong aumtapoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hungin, ipahi lengpitwi donsah hitin, chuleh ipa chilhah manglouva i-umsah theina dingin luppi hite, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin amanin chuche jan chun apalhon chu lengpitwi adonsah lhonin ahi. Chuin apeng masa nuchu ache lutnin, apa chu aluppin; ahin aman amanu itih-a ahunglup, chule itih-a athodoh ahepon ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin ajingin ahitin ahi, apeng masa nuchun aneojonu jah-a, Vetan janhi jan chun kapa kaluppi tai. Tujanin jong einin lengpitwi donsah hitin; chule ipa chilhah manglouva i-umsah theina dingin, nangma lutnin lang galuppin, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin amanin chuche jan chun apahon chu lengpitwi adonsah lhontan ahi. Chuin aneojonu chu akipatdoh-in, aga luppin; ahin aman amanu itih-a ahunglup, chule itih-a athodoh ahepon ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuti chun Lot chanu teni chun apalhona konin nao avopgel lhontai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin apeng masa jonu chun chapa khat ahingin, amin Moab asahtai. Amachu tunikho geija Moab mite pa chu ahitai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin aneojonu jong chun chapa khat ahingin, amin Ben-Ammi asahtai. Amachu tunikho geija Ammon miho pa chu ahitai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Abraham chua kon chun lhanglam gamah achesuh-in, Kadesh le Shur kikah-a achengin, chujouvin Gerar gama apemlutnin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Abraham'in a-inneipi Sarah chu kanaonu ahi atin ahi. Chuin Gerar lengpa Abimelech chun mi asolin, Sarah chu agapui sah tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin Abimelech henga chun ajan amangin Pathen ahungin, ajah-a, Vetan nangman nakipui numeinu jehchun nangma mithisa tobang nahitai; ajehchu amanu mikhat ji ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahivangin Abimelech chun amanu chu anailut loulai ahin; chuin aman, Pakai nangman nam chonpha hojong nathajeng ding ham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman kahenga, amanu hi kanaonu ahi, ati hilouham? Chule amanu jengin jong, amahi kasopipa ahi, ati ahi. Chule lung thengsel le khuttheng tah-a hichehi kanabol ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pathen'in ahenga amangin, Ahinai, hichehi lungdihtah pu-a nanabol ahi ti kahei. Ajehchu keima douna chonset nabol louna dinga keiman jong nangma kasuh tang nahi; hiche jeh-a chu keiman amanu chu katoh khah sah lou nahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuti ahijeh chun tun mipa chu a-inneipi lepeh kittan; ajehchu ama themgao ahin, chule aman nangma taopeh-in natin, nangma nahinding ahi. Nangman amanu chu nalepeh kitlou vangleh, nangma thonlouva nathi teiding ahi, ti kihetnin, nangma le nenei chengse jong, atin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche jehchun Abimelech jingpitah-in athouvin, asohte jouse hiche thilho jouse hi aseipeh tan ahi. Chuin miho chu akichalheh jengun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Abimelech'in Abraham chu akouvin, ajah-a, Kachunguva hi ipi bola nahi hitam? Chule nangma chunga ipi kasuhkhel uma, keima chungle kalenggam chunga chonsetna lentah hi nahin lhut lut hitam? Nangman kachunga bol louhel ding thil chu naboltai, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Abimelech'in Abraham henga, Ipi namu-a hiche thil hi nabol hitam? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Abraham'in, Hiche mun'a hin Pathen ginna him him umpontin, ka-inneipi jeh hin eithat nun nate tia kagel ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujongleh atahbeh-in amanu hi kasopinu ahi ngutnai; amanu hi kapa chanu ahin, hinla kanu chanu vang ahipoi; chua amanu ka-inneipi hung hia ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, Pathen'in kapa in'a kona eiva lesah chun, keiman amanu henga, hichehi kadinga khotona namusahna ding chu ahi; ichena muntina, amahi kasopipa ahi neiti ding ahi, tia kanasei ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Abimelech'in Kelngoi, bongchal, chule soh pasal ho leh soh numei ho apuijin, Abraham chu apen, chule a-inneipi Sarah chu alepeh kittan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Abimelech'in, Vetan, kagam hi namasanga aume; nadeina mun mun'a chengin, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman Sarah henga, Ven, keiman nasopipa dangka sangkhat kapen ahi; vetan, nakoma umho jouse le midang jouse lah-a amapa hi nangma dinga mitkhuna ahi, ati. Chuti chun amanu chu themchan sah-in aumtai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti chun Abraham Pathen henga ataovin ahile, Pathen'in Abimelech, a-inneipi, chule asoh numei ho chu adamsahtan ahi. Chuin amahon chate ahing taovin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu Abraham inneipi Sarah jala chu Pakaiyin Abimelech insunga naobu jouse anakha ahitai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin aseibang chun Sarah avilin, phatthei aboh-in, chule aseibang chun Pakaiyin Sarah chunga amolsotan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hitichun Sarah'in nao avoptan, Chule Pathen'in ahenga asei phattah chun Abraham ateh nungin chapa khat ahinpehtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Abraham'in adinga hung peng, Sarah'in ahinpeh achapa min chu Isaac asah tan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pathen'in athupeh bangin Abraham'in achapa Isaac chu niget alhinin chep atan peh tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule achapa Isaac ahungpen chun Abraham kum jakhat alhingtan ahi..
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Sarah'in, Pathen'in einui sahtan, chule koihileh aja jousen einuihu dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amanun, Sarah'in naonoi hinchepsah inte, tin Abraham henga kon ana seithei jintem? Ahin ama ateh nungin keiman chapa khat kahin pehtai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin chapang chu ahung khang khangin anoichep abang tan ahi. Chuin Abraham'in Isaac noichep ban nikho chun golvah loupitah abolin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Sarah'in Egypt mi Hagar'in Abraham ahinpeh achapa chun anuisat chu amun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun amanun Abraham henga, Hiche soh numeinu le achapa hi nodohtan; ajehchu hiche soh numeinu chapa hin kachapa Isaac toh gou alokhom theilou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule achapa jalchun hichu Abraham mitmun lungnopmona tah ahitan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pathen'in Abraham jah-a, Chapang jal le soh numeinu jal chun lung nomotah-in umhih-in; ajehchu Isaac'a kona bou nachilhah kasim ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keiman nasoh numeinu chapa-a kona jong namkhat kasem doh ding ahi, ajehchu ama nangma chilhah ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Abraham jingpitah-in athouvin, changlhah le twipai khat alan, Hagar chu apen, hichu alengkouva akhaipeh-in, chapang chutoh amanu asoldohtai. Chuin amanu apotdoh-in, Beersheba gamthipma avahle letan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin twipai'a twi chu ahung beitan ahile, amanun chapang chu hambohnoi khatna akoitan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amanu achen, gamla thim tah thalpi kap phahna bepma chun agatoutan ahi: ajehchu amanun, chapang thi chu muda inge ati ahi. Chuin amanu amajonna chun atouvin, hakan akaptan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pathen'in chapang aw chu ajan; van'a konin Pathen vantil chun Hagar chu ahin kouvin, ajah-a, Ipi nathoh lel ham, Hagar? Kicha hih-in, ajehchu chapangpa aumna-a kon a-awgin chu Pathen'in ajatai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kipat doh-in, chapang chu kaithouvin, chule nakhutna tuh-in, ajehchu keiman amachu nam lentah khatna kasem ding ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pathen'in amanu mit avahsah-in ahile, amanun twikhuh khat amutan ahi. Chuin amanu achen, twipai'a chun twi athaldim-in, chapang chu adonsah tai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pathen'in chapang chu aumpin; chule ama ahung khang khangin, gamthipma chun achengin, thalkap themtah ahung hitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ama Paran gamthipma achengin; chule anun Egypt gama konin ajiding apui peh tan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuche laichun ahitin ahi, Abimelech le asepai hon lamkai Phicol chun Abraham henga, Natohna jouse-a Pathen'in nang naumpi jinge.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hijeh chun tun, nangman keima le kachapate, chule kachapate chapate chunga dihlou tah-a na natoh louna ding le, keiman nangma kalungset bangahi keima chule nahung pemlutna gamhi lungsetna naneina dingin, hikoma hin Pathen minin kahenga kihahsel in, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Abraham'in, Kaki hahsel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Abimelech sohten twikhuh khat hunama alahpeh jeh uvin, Abraham'in Abimelech chu aphohtan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Abimelech'in, Keiman hiche thil bola hi koi ahi kahepoi; nangman jong neiseipeh khah pon, chule tunia kajah tilou, kajakha hihbeh-e, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Abraham'in Kelngoile bongchal akaijin, Abimelech chu apen; anigel lhonin kitepna asemlhontai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Abraham'in kelngoihon lah-a konchun kelngoinou anu sagi atumin akoidoh-in ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Abimelech'in Abraham henga, Kelngoinou anu sagi atuma nakoidoh hi ipi tina ham? Ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman, Hiche twikhuh hi keima lai ahi ti hettohsah nadinga hiche kelngoinou anu sagi hi kakhutna kona nakilah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiche jeh chun aman chuche munchu chu Beersheba asahtai; ajehchu hikoma chun amani akihahsel gel lhona ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chutichun amanin Beersheba mun'a chun kitepna asemlhontan ahi. Chujouvin Abimelech le asepaihon gal lamkai Phicol akipatdoh lhonin, Philistine gam lama akile lhontai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Abraham'in Beersheba'a chun thingphung khat aphutnin, chua chun Pakai tonsot Pathen min chu akoutan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chutichun Abraham Philistine gama nikho sottah akhopemin ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin chucheng nung chun ahitin ahi, Pathen'in Abraham chu apatepmin, ahenga, Abraham, tin akouvin ahile; aman, Ven, hikoma kaume, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman, Nachapa, nachapa changkhatseh, nangailut tah Isaac chu puijin lang, Moriah gama chen; chule chukom achun keiman kahilding molsang khatna amachu govam thilton gatoh-in, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Abraham jingpi matah-in athouvin, asangan chu agongin, aumpi gollhang ho mi nile achapa Isaac chu apuijin, chule govam thiltona ding thing a-eh-in, chuin akipatdoh-in, Pathen'in ahilna munlam jonchun achetan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin, anithum chanin Abraham akhodah-in ahile, amun chu gamla tah-a agahmun ahi
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Abraham'in agollhang teni henga, hikoma hin nangni sangan toh ana um lhonin, keimale chapang hi khukoma khun gache lhoningting, Pathen kagahou lhonding, chuteng naheng lhona kahungkit lhonding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Abraham'in govam thilto ding thingchu alan, achapa Isaac aputsah-in; chule aman meile chemcha akhutna achoijin, chuin amani thakhat nin akilhon khom lhontai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Isaac'in apa Abraham henga, Hepa, atile, aman, Chapa hikoma kaume, ati. Chuin aman, Ven, mei le thing la aumnan, govam thilto ding kelngoi hoiba ham? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Abraham'in, Kachapa, govam thilto ding kelngoinou chu Pathen amatah-in hinpenante, ati. Chutichun amani thakhat nin achekhom lhonin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pathen'in ama ahilna mun chu alhung lhontan; Abraham'in maicham khat atungdoh-in, chule thing chu asetoh-in, chuin achapa Isaac chu akanin, maicham chunga chun alupsahtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Abraham'in akhut alhangin, achapa thana ding chun chemcha chu alatan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakai Vantil'in van'a konin ahin samin, Abraham, Abraham, atin ahi. Chuin aman, Hikoma kaume, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman, Chapang chunga chun nakhut lha hih-in, chujong le ama chu imacha lohih-in: ajehchu nangman nacha changkhat seh jong keima dinga itlouhela neipeh chu kamun, Pathen naginge ti tun kahetai, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Abraham akhodah-in aven ahile, anunglama chun kelngoichal khat nang lah-a aki-a oh amun ahi. Chuin Abraham achen, kelngoi chal chu agamanin, hichu achapa khelin govam thilto ding chun atohtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Abraham'in chumun chu Jehovah Jireh asahtai: chule tuni chan geihin, Pakai molsanga hichu kipeding ahi, tin akiseijing nalaijin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakai Vantil'in aniveina-in van'a konin Abraham chu ahinkou kitnin,
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajah-a, Keima le keima-a kihahsel kahi, tin Pakaiyin aseije; Ajehchu nangman hiche hi nabola, chule nachapa, nachapa changkhat na-it louhel jeh-a;
  </para>
  <para style="p">
    <verse number="17" style="v" />Keiman phattheiboh na-a nangma phatthei kaboh ding, chule hapuna punsah na-a nachilhahte van'a ahsijat, twikhanglen kama neldi jat na kapunsah ding; chule nachilhahte chun amelmateu kotpiho alodingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangman kathu nangai tah jeh-a, nachilhahte akona vannoi leiset chitin namtin jouse phatthei boh changding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuti chun Abraham gollhang teni henga ahung kilen; chuin amaho akipat doh-un Beersheba lam jonin thakhatnin acheuvin; chule Abraham Beersheba'a achengtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thil hicheng jouchun ahitin ahi, Abraham henga, Vetan, Milkah'in jong nasopipa Nahor dingin chate ahinpehtai, tin thu aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Achapa peng masa chu Huz ahin, anaopa Buz ahin, chule Aram pa Kemuel,
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Chessad, Hazo, Pildash, Jidlaph chule Bethuel ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Bethuel'in Rebekah ahingin ahi. Hicheng get hi Milkah'in Abraham sopipa Nahor ahinpeh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin athaikemnu Reumah chun Tebah, Gaham, Thahash chule Maachah ahingin ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Sarah chu kum jakhat le kum somni le kum sagi alhingtan ahi; hicheng hi Sarah hinkho kumho chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Sarah chu Kirjath-Arba'a chun athitan; hichu Canaan gama Hebron chu ahi. Chuin Abraham chu Sarah op ding le ka dingin ahungin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Abraham amithilong masanga chun adingdoh-in, Heth chapate henga chun thu aseijin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Keimahi nalah uva um maljin le khopem bou kahi: kami thi hi kamit mu-a kona kavui doh theina dingin, gouva kanei dingin kivuina ding mun phabep khat neipeuvin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Heth chapate chun Abraham adonbutnun, ajah-a,
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka pakai, nei ngaipeh temun: nangma kalah uva leng chapa loupitah nahi: kalhan hou nadei nalai tah-a namithi chu vuijengtan; namithi navuina dingin kalah uva hin koimachan kalhan nu pehdoh ding itpou vinge, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Abraham ading doh-in, chuche gam mite, Heth chapate anga chun akuntan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amaho chutoh akihouvin, ajah uva, Kami thi kamitmu-a kona kavuiding nalungu ahile, neingaipeh-un, chule keima dingin Zohar chapa Ephron henga neithum peh-un,
  </para>
  <para style="p">
    <verse number="9" style="v" />Nalah uva kivuina munna gouva kanei dingin, aman lhingset pedingin, aman anei alou bantah-a um Machpelah songko chu eipehen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Ephron chu Heth chapate lah-a cheng ahi: chuin Hit mi Ephron chun Heth chate jahdingle khopi kul kotpi sunga lut jouse jahding chun Abraham chu adonbutnin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahipoi ka pakai, ngaitemin; louchu kapeh nahitan, chule asunga um songko jong chu kapeh tha nahitai; kamite chapate masanga hi nangma kapeh nahitai: namithi chu kivuitan, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Abraham chuche gam mite angsunga chun aboh khupmin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman chuche gam mite jah ding chun Ephron henga, Nangman neipeh ahile katao ahi, neingaipeh-in: keiman gamman ding chun nangma sum peng kate; hichu keija konin kilah-in, chule keiman chukoma chun kami thi chu vuijing kate, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Ephron'in Abraham chu adonbutnin, ajah-a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka pakai, kasei neingaipeh-in: gam chu dangka shekel jali man bep ahin, hichu nangle kei kah-a itah ham? Hiche jehchun namithi chu kivuitan, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Abraham'in Ephron thusei chu angaipeh-in; chule Abraham'in Heth chapate hetnin Ephron'in aseijat dangka shekel jali chu, chuche laija sumkol veihon amanjiu dungjui chun Ephron chu atepeh tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Mamre kom Machpelah gamsunga um Ephron loumun chu, alou le asunga um songko, chule louva um thing jouse, chule alou kimvela um thing jouse chu,
  </para>
  <para style="p">
    <verse number="18" style="v" />Heth chate angsung le khopi kul kotpi sunga lut jouse mitmun Abraham nei dingin pehdoh-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin Abraham'in a-inneipi Sarah chu Canaan gama Mamre (hichu Hebron ahi) jona um Machpelah lou munna songkoa chun avuitan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuche lou munle asunga songko chu kivuina mun'a anei dingin, Abraham henga Heth chapate chun apedoh taovin ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Abraham chu a-upa lhehtan, akumjong atamlheh jengtan; chule Abraham chu Pakaiyin thil jouse-a phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Abraham'in a-insunga asoh upapen, anei jouse chunga vaihompa henga chun, Nahenga katao ahi, nakhut chu kaphei noija koijin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Pakai, Van Pathen le lei Pathen min paning ting, kachenna Canaan mite chanute lah-ahi kachapa jiding napuipeh louna dingin nangma kihahsel sah inge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin kagam lama, ka-inkote lah-a nache-a kachapa Isaac jiding nagapuijoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin sohpa chun ahenga, Ijemtin numei chun hiche gamlama hin eihin juinom tahih le, nachapa hi nahungdoh na gamlama chu kalepuikit ngai jin tem? ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Abraham'in amapa henga, Kachapa hi chulama nalepui louna dingin nangma chingthei jin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakai van Pathen, kapa in'a konle ka sopite gama kona eipuidohpa, chule kahenga, Hiche gamhi nachilhahte kapeh ding ahi; tia kihahsel pachun avantil namasanga solintin, chua kona chu kachapa jiding napuipeh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ijemtia numei chun najui nomlou tah-a ahile, hiche kihahsel na-a kona hi ongdoh-a nahi; kachapa vanghi chulama chu nalepui lou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin asohpa chun apu Abraham phei noija chun akhut akoijin, chule chuche thudola chun ahenga akihahseltan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin asohpa chun sangongsao ho lah-a chun sangongsao som akipuijin akipatdoh tai; ajehchu apupa neile gou jouse chu akhutna uma ahi. Chuin akipatdoh-in, Mesopotamia gam, Nahor khopi jonin achetan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin nilhah lam, numei ho twi thal dinga apotdoh phat dontah chun, khopi pama twikhuh koma asangongsao hochu akolsah-in ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ama, Vo Pakai, kapu Abraham Pathen, nahenga katao ahi, tunin lolhinna neihinpen, chule kapu Abraham lungsetna musah-in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vetan, twikhuh koma hin kadingin, chule hiche khopi miho chanute twithal dingin ahungdoh-ui;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hiti hi hisah-in, nungah koikom hijongleh, Katao ahi, kadon dingin atwibel hin nemsah-in, kati-a, chule amanun, Donin, chule keiman nasangongsao hojong adondiu penange, tia seipen pen chu nasoh Isaac dinga nami got chu hijenghen. Chule nangman hichea kona chu kapu chunga hepina namusah-e ti kahet ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahitin ahi, chuche aseijou masang chun, veuvin, Abraham naopa, Nahor inneipi Milkah chapa Bethuel chanu Rebekah chun alengkouva twibel ahinpun, ahung potdoh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nungah nu chu amel ahoilheh jengin, nungah theng ahin, pasal koimachan akihetpi loulai ahi. Chuin amanu twikhuh-a chun akumlhan, atwibel chu athaldim-in ahung potdoh-in ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin sohpa chu amanu chutoh kimuto ding chun alhaijelin, ajah-a, Katao ahi, natwi bela twi chu themkhat neidonsah-in, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amanun, Donin, ka pakai, ati. Chuin amanun gangtah-in atwibel chu akhutnin adomlhan, amapa chu adonsah tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amapa chu twi adonsah jou phatnin, amanun, Nasangongsao hon jong adonkhop kahseovin, keiman twi thalpeh nange, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuti chun amanun atwibel chu gankonga chun asunglha loijin, twi thal dingin twikhuh lama chun alhaijel kitnin, asangongsao ho jouse ding chun athal pehtan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin mipa chun Pakaiyin ajina chu alolhinsah ding le alolhinsah lou ding hetna din, kidangsa tah-in amanu chu thipbeh chan avejing tan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ahitin ahi, Sangongsao ho chun adonkhop phatnun, mipa chun sana bilba shekel keh gih le, amanun akhutna abu ding sana chao shekel som gih aladoh-in,
  </para>
  <para style="p">
    <verse number="23" style="v" />Amanu henga, Koi chanu nahim? katao ahi, neisei peh-in; napa in'a keiho din gena ding mun umin tem? ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amanun ajah-a, Keima Milcah'in Nahor dinga ahinpeh achapa Bethuel chanu kahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amanu chun ahenga aseiben, Changpol le gancha a-an ding anneh nengtah-in kaneijui, chule genading mun jong kaneijuve, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin mipa chu akunin, Pakai chu ahou tan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman, Kapu chunga hepina le akitahna nungsun loupa Pakai kapu Abraham Pathen chu nunnom hen: keijeng jong hi Pakai chun lamdunga eipuijin, kapu sopite in geijin eipuilutai, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin nungah nuchu alhaijelin, hiche ho chu anu insung mite agahiltai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Rebekah chun sopi khat aneijin, chule amin Laban ahin; chuin Laban chu twikhuh lama mipa henga chun alhaijelin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ahitin ahi, aman bilba le asopinu khutna chaochu amu-a, chule asopinu Rebekah'in, Mipa chun kakoma hitihin thu aseije, tia asei ajah phatnin; mipa koma chun ahungin ahile; veuvin, amapa chu twikhuh koma sangongsao holah-a chun adingin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman, Hunglutnin, nangma Pakai phatthei boh changpa, iti dana pama nadin ham? Ajehchu keiman in le sangongsao ho ding mun kagotsa ahitai, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin mipa chu in'a chun ahung luttan ahi. Chuin Laban'in sangongsao thilho chu alhamlhan, sangongsao hoding changpol le gan an chu apen, chule ama keng le anungjui ho keng silna ding twi apen ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin a-anga chun nehding an aluipeh-un; ahin amapan, Kaseiding dol kasei masangin neponge, ati. Chuin aman, Seitang em, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin aman, Keima Abraham sohpa kahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Pakaiyin kapu Abraham chu nasatah-in phatthei aboh-in, ama milentah ahung hitai. Chule Pakaiyin amachu kelngoi hon le bong hon, dangka le Sana, soh pasal le soh numei ho, sangongsao ho le Sangan ho apen ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule kapu inneipi Sarah chun ateh nungin kapu dingin chapa khat ahinpeh-in; ama koma chun aman anei jouse apesoh keijin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule kapun keima eikihahsel sah-in, Kachenna Canaan mite chanute lah-a kona hi kachapa jiding napui lou ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amavang nangma kapa in lama, kasopite lah-a naga chea, kachapa jiding nagapui ding ahi, atin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin keiman kapu henga, Ijemtin numei chun eihin juinom tahih le, katin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahin aman kahenga, amasanga kalamlhah jing Pakai chun avantil nalhonpi sah intin, nalampi chu alolhinsah ding; chule nangman kasopite le kapa insunga kona kachapa jiding napuiding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nangma kasopite heng nalhun teng le, hiche kihahsel na-a kona hi na-ondoh ding; chule amahon amanu nangma henga apehlou uva ahile, hiche kahahsel na-a kona hi na-ondoh ding ahi, atin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule tuni luikhuh kahung lhunin keiman, Vo Pakai kapu Abraham Pathen, nangma tu-a hi kachena lampi hi nalolhinsah dinga ahile,
  </para>
  <para style="p">
    <verse number="43" style="v" />Vetan, keima twikhuh kom ahin kading-e; chule hung hiti ding ahi, nungah theng chu twi thaldinga ahunga, chule keiman ahenga, Katao ahi, natwi bela twi donding themkhat neipen, kati-a,
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule amanun kahenga, Donin, keiman na sangongsao ho ding jong gathal nange, tia seija amanu chu kapu chapa dinga Pakaiyin agon numei chu hihen katin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin hichu kalung sunga kaseijou masangin, veuvin, Rebekah hin alengkouva twibel ahinpun, ahung doh-in; chule amanu twikhuh-a chun akumlhan, twi chu agathal tai. Chuin keiman ahenga, Katao ahi, twi neidon sah-in kati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin aman gangtah-in alengkouva twibel chu adomlhan, Donin, keiman na sangongsao ho jong donsah inge, atin ahi. Chuti chun keiman twi chu kadonin, chule aman sangongsao ho jong adonsah tai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin keiman ama chu kadongin, ajah-a, Koi chanu nahim? kati. Chuin amanun, Milcah'in Nahor'a dinga ahinpeh chapa Bethuel chanu kahi, ati. Chuin keiman amaija bilba kabapeh in, akhutna chao kabupeh-in ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin kakunin, Pakai chu kahouvin, kapu sopipa chanu kapu chapa ji-a puipeh dinga lamdih-a eipuija Pakai kapu Abraham Pathen chu phatthei kabohtan ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule tun, jetlam ham, veilam hama kakihei thei na dingin, kapu chu lungsettah le dihtah-a naboldiu le neisei peh-un: nabol loudiu jongle neisei peh-un, ati.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin Laban le Bethuel'in adonbut lhonin, Hiche thil hi Pakaiya kon ahin; keihon ase, apha nahenga kaseithei pouve.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ven, Rebekah na-angsunga aume, kipuijin lang chen, chuleh Pakaiyin aseibang chun, napu chapa jiding hitahen, atilhone.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin ahitin ahi, Abraham sohpa chun athuseiju ajah phatnin, tolla aboh khupmin Pakai chu ahoutan ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin Sohpa chun dangka kijep na, sana-a kijepna, chule ponsil ho aladoh-in, Rebekah chu apetan ahi. Aman asopipa leh anujong thil lutahtah apen ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chuin amale aumpiho chun aneovin chule adonun, jankhovah keijin aumtaovin ahi. Chuin amaho jingkah-in athouvun, chule aman, Kapu henglama neisol taovin, ati.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin asopi pa le anun, Boinu hi ni chomkhat, nisombeh kaheng uvah umtadi hen; chujouteng leh che nante, atilhonne.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ahivangin amapan ahenguva, Pakaiyin kachena alolhinsah namu nungun, neikho ngaisah tahih-un; kapu henglama kache theina dingin neisoldoh taovin, ati.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin amahon, Keihon boinu kou ungting, ama dongnao vinge, atiuve.
  </para>
  <para style="p">
    <verse number="58" style="v" />Chuin amahon Rebekah chu akouvun, ajah-a, Hichepa toh nalhonna nache ding ham? atiuve. Chuin amanun, Kache ding ahi, ati.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chuin amahon anaonu Rebekah le ajenlenu, chule Abraham sohpa le aloite chu alhadoh taove.
  </para>
  <para style="p">
    <verse number="60" style="v" />Chuin amahon Rebekah chu phatthei aboh-un, ahenga, Nangma kasopinu-u nahi, nangma nelsang tamtah nu hunghin lang, chule nachilhahte chun amelmateu kotpi hinlouhen, atiuve.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chuin Rebekah chu asoh nungah hotoh akipat doh-un, sangongsao ho chunga chun atouvun, mipa chu ajuitaove. Chutichun sohpa chun Rebekah chu akipuijin, achetan ahi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Chuin Isaac chu Beer-lahai-roi twikhuh lampia konchun ahungin ahi; ajehchu ama lhanglam gama chu chenga ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chuin Isaac chu nilhah lamin loujaova lunggel dingin ahung potdoh-in; chuin ama akhodah-in aven ahile, veuvin, sangongsao ho ahung kijotnun ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Chuin Rebekah akhodah-in, chuin Isaac chu amuphatnin, sangongsao chunga konin akumlhan ahi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Ajehchu amanun sohpa henga chu, loujaova eilamdot diuva hung khu koi ham? tia anadoh-a; chule sohpa chun, Kapu ahi, anati ahi. Hijeh chun aman ponlukhuh alan, akikhuh tan ahi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chuin sohpa chun athilbol jouse chu Isaac aseipeh tan ahi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Chuin Isaac'in ama chu anu Sarah pon insunga chun apuilutnin, chule Rebekah chu akipuijin, chuin amanu a-inneipi ahitan; chule aman amanu chu angailu lheh-in ahi. Chuin Isaac chu anu thi nungin lhamongin aumtan ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Abraham'in ji khat akipui kitnin, amin Keturah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule amanun amachu Zimran, Jokshan, Medan, Midian, Ishbak chule Shuah ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jokshan'in Sheba le Dedan ahingin, chule Dedan chapate chu Asshurim, Lethushim chule Leummim ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Midian chapate chu, Ephah, Epher Hanoch, Abidah chule Eldaah ahiuve. Hichengse hi Keturah chate ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Abraham'in anei jouse chu Isaac apetan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule ahin laijin Abraham'in athaikem chapate hojong thilpeh apen, chuin amaho chu achapa Isaac koma konin solamsang, solam gama asolmang tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Abraham hinkho kum nikho ho chu kum jakhat le kum somsagi le nga ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Abraham'in alhagao alhadoh-in, ateh kemset, tehsetah, chule kum lhingsetnin athin; amite toh gopkhomin aumtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin achapateni Isaac le Ishmael chun Hit mi Zohar chapa Ephron loumuna, Mamre koma Machpelah songkoa chun amachu avui lhontan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuche loumun chu Abraham'in Heth chapate-a kona anachohdoh ahi. Chua chun Abraham chu a-inneipi Sarah toh akivuitan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Abraham athi nungin ahitin ahi, Pathen'in achapa, Isaac chu phatthei aboh-in; chule Isaac chu Beer-lahai-roi twikhuh koma chun achengin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tun hiche hohi Abraham chapa, Ishmael Sarah sohnu, Egypt mi Hagar'in Abraham ahinpeh chilhah ho akhanggui chu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche ho hi akhanggui dungjui cheh uva Ishmael chapate min chu ahi. Ishmael cha apeng masa pen Nebaioth ahin, Abana Kedar, Adbeel, Mibsam,
  </para>
  <para style="p">
    <verse number="14" style="v" />Mishma, Dumah, Nassa,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadar, Tema, Jetur, Naphish chule Kedemah ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichengse hi Ishmael chapate min chu ahin, chule hichengse hi akhopiu dungjui le akulpiu dungjuija amin; chule avaipiu dungjuijin leng som le leng ni chu ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Ishmael hinkho kumho chu kum jakhat le kum somthum le sagi ahi. Chuin aman alhagao alhadoh-in athitan; chule amite toh gopkhomin aumtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule amaho chu Havilah'a patnin Shur geijin achengun, hichu Egypt solam Assyria jotna-a um ahi. Chuin ama asopite jouse mitmun athitan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule hicheng hi Abraham chapa, Isaac khanggui hochu ahiuve: Abraham'in Isaac ahingin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Isaac'in Padan Aram gama Syria mi Bethuel chanu, Syria mi Laban sopinu Rebekah aji dinga akipui chun, kum somli alhing tai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule a-inneipi chin jehchun Isaac'in Pakai henga ataopeh-in ahi. Chuin Pakaiyin ataona asanpeh-in, a-inneipi Rebekah chun nao avoptan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin chapang teni chu asunga chun ahung kidel lhonin ahile, amanun, Hitiding ahi-a ahile, ibola hiti kahim? ati. Chuin amanu Pakai dong dingin achetai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pakaiyin amanu henga, Nanaobu sunga hi nam ni uma ahin; chule na-oisunga kona hi hina chomcheh nei mini khendoh-a umding ahi; chule khatjo chu khatjoh sanga chu hatjo ding, chule a-upa johchun anaopa ajending ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin amanu asophat alhin phatnin, veuvin anaobu sunga chun naosen ni anaumin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule ahungpot masa chu asanin, samul pon bangin amulin; chule amin Esau asah-un ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuche jouchun anaopa ahungpotnin, akhutnin Esau khotal jum ahintuh-in; chule amin Jacob asah-un ahi. Rebekah'in amani ahinpeh chun Isaac kum somgup alhingtan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutichun chapang teni chu ahung khangdoh lhonin; chule Esau chu sakap themtah mi gamlah mi ahin, Jacob vang chu mi-ummong pon in'a cheng ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin asakap sa anehji jeh-in, Isaac chun Esau angailun, Rebekah'in vang Jacob angailun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khatvei hi Jacob'in annoi ahonin; chule Esau gama konin ahungin, agilkel lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Esau'in Jacob henga, Katao ahi, na annoi hon san peh chu neineh sah-in, ajehchu keima kel lih paiding kahitai, ati. Hijeh-a chu amin Edom kisah ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Jacob'in, Na-upat chu tunin neichoh sah-in, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Esau'in, Athipai ding kahitai, keima dinga upat hi ija phachom dingham? ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Jacob'in, Tunin kahenga kihahsel in ati: chuin ama ahenga akihahselin, a-upat chu Jacob henga akijoh tai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chujouvin Jacob'in Esau chu changlhah le bechimnoi chu apen; chuin aman anen adonin, chuin akipatdoh-in, achemang tan ahi. Hitichun Esau'in a-upat na chu iman ageltapoi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin chuche gama chun Abraham nikho laija kellhah masa chu hilouvin, kel ahung lhatan ahi. Chuin Isaac chu Philistine lengpa Abimelech henga Gerar mun'a agachen ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakai ahenga ahung kilah-in, ajah-a, Egypt gama chesuh hih-in, keiman kaseipeh ding gama chun chengin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiche gama hin khopemin, chule keiman nangma umping ting, phatthei kaboh ding nahi; ajehchu nangma le nachilhahte henga hiche gamjouse hi kapeh ding; chutia chu keiman napa Abraham henga kaki hahsel na chu kasuh bulhit ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keiman nachilhahte van'a ahsi jatnin punsah ingting, chule hiche gam jouse hi nachilhahte kapeh ding; chule nachilhahte-a kona vannoi namtin jouse phatthei boh chang ding ahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Abraham'in kathu angaijin chule kathuhil ho, kathupeh ho, kachondan ho, chule kadanthu ho anitnin ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuti chun Isaac Gerar mun'a chun achengtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin chuche mun'a cheng ho chun a-inneipi thudol adongun ahile, aman, Kanaonu ahi, ati. Ajehchu amanu ahoijeh chun chuche munna miho chun Rebekah jal chun eithat getnunte, tia ageljeh-a, Ka-inneipi ahi, ati ngamlou ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi, ama chukoma sottah aumjouvin, Philistine lengpa Abimelech'in bangkotna konin ahinven ahile, Isaac'in Rebekah anoupet amun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Abimelech'in Isaac chu akouvin, ahenga, Vetan, amanuhi na-inneipi ahimonge; achutile itidana, Kanaonu ahi, nati ham? ati. Chuin Isaac'in ahenga, Ajehchu keiman ajole amanu jal hin thilo getninge, tia kagel jeh ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Abimelech'in, Kachunguva nathil bol hi ipi hitam? Miho lah-a khattou hin na-inneipi hi bailam tah-a aluppi jeng thei ahin, chutia chu kachunguva hi themona nahin lhunsah jengthei ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Abimelech'in amite jouse chu agih-in ahenguva, Koi hile mipa ahilou le, a-inneipi tongkha chan chu kithat teiding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Isaac'in chuche gama chun muchi athen ahile, chuche kum chun ajat ja a-atdoh-in ahi; chule Pakaiyin amachu phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin mipa chu ahung haolheh jengtan mihao nasatah ahung hi kahsen ahao tultul jengin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu aman kelngoihon, bonghon, chule soh tamtah aneitan ahi. Chuin Philistine mihon amitthip taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu apa Abraham hinlaija apa sohten analaiju twikhuh jouse chu Philistine mihon asuhtanguva, chule leija adipdim gamu ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Abimelech'in Isaac henga, Keiho-a konin chemang taovin, ajehchu nangma keiho sangin gamchengin nahat tai, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Isaac chua kon chun akichonin, Gerar phaichama pon in asongin chua chun achengtai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Isaac'in apa Abraham hinlaija atuikhuh laiho chu alai kittan ahi; ajehchu Philistine miten Abraham thinunga anasuh tang gamu ahitai. Chule apan ana minsah bang cheh chun, amin sah cheh kittan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Isaac sohten phaicham chu alaijun ahile, twinah put khat amutaove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Gerar mun'a ganchingho chun, Twi hi keiho-a ahi atiuvin, Isaac ganching ho chu akinah pi taovin ahi. Chuin amahon akinahpi jeh-u chun twikhuh minchu Esek asahtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin amahon twikhuh chomkhat alaikitnun ahile, hiche chunga jong chun akina kit taove. Hijeh chun aman chuche minchu Sitnah asahtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ama chua konchun akichon kitnin, twikhuh khat alaikitnin ahile hiche chunga vang chun akina tapouve. Hijeh chun hiche mun chu Rehoboth asahtai; ajehchu tunvang Pakaiyin eihodin mun eipe taovin, chule hiche gamahi hatah-a ipundiu ahitai, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin hichea kon chun ama Beersheba'a achetou tan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin chuche janchun ahenga Pakai ahung akilah-in, Keima hi napa Abraham Pathen chu kahi; kicha hih-in, ajehchu keiman nangma kaumpinai; chule kasoh Abraham jala nangma phatthei kaboh ding, chule nachilhah kapunsah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hijeh chun aman chua chun maicham khat asemin, Pakai minchu akouvin, chule chua chun apon in asongin ahi. Chuin chua chun Isaac sohte chun twikhuh khat alaijun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chujouvin Abimelech Gerar'a konin agolho lah-a khat Ahuzzath le, asepai lamkai Phicol toh ahenga agacheuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Isaac'in amaho henga, Neivetda jeh uva naheng uva kona neisol doh-u ahitan, ipi dinga kahenga hung nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin amahon, Pakaiyin, naumpi-e ti kichentah-in kamuve. Hijeh-a chu keihon, Tun eiho kah-a, keihole nangma kah ngeija kihahselna umhen lang, nangma toh kitepna neileuhen katiu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chutia chu keihon nangma katohkhah daova, chule apha tailou imacha dang kabol daova, chule lungmong tah-a kasolmang bangu chu, nangman jong neisuhset louna dingu ahi. Tun nangma Pakai phatthei boh chang nahitai, atiuve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin aman amaho ding chun golvah abolin, chuin amahon aneuvin, adonnuvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin jingkah matah in athouvun, amaho khat le khat akihahsel uvin ahi. Chuin Isaac'in amaho chu asoldoh-in, chule amaho ama-a konin lung mongin achedoh taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin chuche ni mama chun ahitin ahi, Isaac sohte ahungun, atuikhuh laiju chungchang thu chu ahung seijun, ahenga, Twi kamutaove, ahung tiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin aman hichu Shebah asahtai. Hijeh chun chuche khopi minchu tu nikho geijin Beersheba ahung hitai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Esau kum somli alhinin, Hit mi Beeri chanu Judith, chule Hit mi Elon chanu Bashemath jin aneijin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule amani chu Isaac le Rebekah dingin lungnatna ahi lhonin ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Isaac chu ateh-a khomutheilou khopma amit athim phatnin, achapa lenjo Esau chu akouvin, ahenga, Kachapa, atin ahile, aman adonbutnin, Ven, hikoma kaume, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman, Tun vetan, keima katehtan, itih nikho-a kathi dingham kahepon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun katao ahi, tun nagalvonho, nalivathei le nathalpi kikenin lang, gamlah-a chen, chule keimadin sa gakaptan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule kathi masanga kahinnan phatthei nabohthei nadingin, kadulamtah-in, tuitah-in neihon peh-in lang, kaneh dingin kahenga hinchoijin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Isaac'in achapa Esau henga athusei chu Rebekah'in ajatan ahi. Chuin Esau sakap ding le ahinpo dingin gamlah-a achetan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Rebekah'in achapa Jacob henga, Ven, napa keiman na-upa henga,
  </para>
  <para style="p">
    <verse number="7" style="v" />Sa gakap minlang, chule me tuitah-in neihon peh-in, chule hichu nengting, kathi masangin Pakai masanga phathei naboh inge, tia asei kajai, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun tun, kachapa, nangman kathupeh dungjuijin kathu ngaijin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tun gan hon lah-a chenlang, alah-a kelnou phatahtah ni hinchoijin; chule keiman hichu adulam tah-in, napa dingin me tuitah honpeh-ing kate.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule aman aneh-a, athi masanga phatthei naboh nadinga, hichu napa henga nachoipeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jacob'in anu Rebekah henga, Ven, ka-upa Esau hi mimul ahin, keimala minam kahi ngalin,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ijemtin kapan eihin tham tale, ama dinga keima hi milhemtoh kabah ding ahin, phatthei boh hijolouvin, gaosap najoh kaki buh khum ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin anun ahenga, Kachapa nakigaosap nachu keima chunga chumaihen; kathuhi ngaipou pouvin, chenlang neigalah pehtan, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin ama achen, agalan, hichu anu henga ahinchoitan ahi. Chuin anun apa dulamtah in me chu ahontan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Rebekah'in achapa lenjo Esau von phaho in'a akoma umho chu alan, achapa neojo Jacob chu avonpehtan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amanun kelnou vunho chu akhut teni le angong nam laija chun atom pehtan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amanun ame hon tuitah le changlhah chu achapa Jacob khutna apetan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ama apa henga ahungin, ajah-a, Hepa, atin ahile; aman, Hikoma kaume, koi nahim kachapa, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Jacob'in apa henga, Keima nachapa apeng masa Esau chu kahi; nangman neithupeh bangin kagaboltai. Katao ahi, thouvin, chule touvin lang, phatthei neibohnadin kasakap hi netan, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Isaac'in achapa henga chun, kachapa, chubang loma gangtah-a nagamu jeng chu iti danham? ati. Chuin aman, Pakai na Pathen'in kahenga ahinchoijeh ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Isaac'in Jacob henga, Katao ahi, kachapa Esau mong mong nahi nahilou katham theina dingin, hungnai temin, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Jacob'in apa Isaac ahin naijin, chuin aman amachu achulin, A-aw hila Jacob aw ahin, ahin akhut ho hila Esau khut ahingalin, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Akhut hochu a-upa Esau khut banga amuljeh chun, koi ahi ahekhen thei tapon ahi. Hijeh chun aman amachu phatthei aboh tan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman, Nangma kachapa Esau nahi mong mong hinam? ati. Chuin aman adonbutnin, Kahimonge ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin aman, Kahenga hinchoi naijin, kahinnan phatthei kaboh thei nadingin, kachapa sakap nenge, ati. Chuin aman ahinchoi naipeh-in, anetan; chuin lengpitwi jong ahin choipeh-in, adontan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin apa Isaac'in ahenga, Kachapa, tun hung naijin lang, neichopmin, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ama ahung naijin, achopmin; chuin aman avonho namchu anah-in, amachu phatthei aboh-in, hitin ati, Ven kachapa gimnam hi Pakai phatthei boh gam gimnam ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuti ahijeh chun Pathen'in nangma van daitwi le leipha, chule chang le lengpitwi ninglhing setnin napehen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mitinin nangma najenu hen, chule namtin nangma anga kuncheh-u hen. Nasopite chunga a-pakaiyun uminlang, nanu chapate na anga kun uhen. Nangma nagaosap chanchu gaosap chang hen lang, nangma phatthei naboh chanchu phatthei boh changhen, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ahitin ahi, Isaac'in Jacob phatthei aboh jou chun, Jacob apa Isaac henga konin anapotdoh man hamhamin, a-upa Esau asadela konin ahung lhung paitan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman jong me tuitah in ahonin, apa henga ahin domin; chule apa henga, Kapa, thouvin lang nahinnan phatthei neiboh nadingin, nachapa sakap hi netan, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin apa Isaac'in ahenga, Nangma koi nahim? ati. Chuin aman, Keima nachapa apeng masa Esau kahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Isaac nasatah in ati akithing jengtan, koiham? Sa gakapma kahenga asa hinchoija, nahung lhun masanga kana nehjou hella, phatthei kana bohchaisa chu hoilamba hitam? Tahbeh-a amachu phattheiboh changding ahitai, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Esau'in apa thusei ajah phatnin, nasatah le lhasetah in akaplutlut jengtan, apa henga, Vo hepa, phatthei neiboh-in, keimatah ngeijong hi phatthei neibohteijin, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin aman, nanaopa kahenga doha themtah-in ahungin, na phatthei chanding chu akilahdoh tai, ati.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin aman Jacob kisah chu dih lheh hilou ham? Ajehchu aman niveijen ei dohabol ahitai. Aman ka-upat eilah peh-in, chule ven tun kaphatthei chanding eilahmang peh kit tai, ati. Chuin aman, Phattheina neikhen peh louhel hitam? ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Isaac'in Esau chu adonbutnin, ahenga, Vetan, amachu napakai din kasemtan, chule asopite jouse asohdin kapetan; chule ama chang le lengpitwi jin kavangboh tai. Achutile kachapa nangdinga ipi kabolpeh ding hitam? ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Esau'in apa henga, Phattheina khatseh bou nanei hija ham? Vo hepa, keimahi, keima ngeijong hi phatthei neiboh teijin, ati. Chuin Esau chu hatah-in akaptan ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin apa Isaac'in adonbutnin, ahenga, Vetan, nachenna ding chu leiphatna le chunga kona van daitwi umna mun hiding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule nangma nachem jama nahina, chule nanaopa najending; chule hung hitiding ahi: nangma vaihom na nahin nei teng le, nangonga kona anamkoljon chu nasuhboh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin apan phatthei aboh jeh chun, Esau'in Jacob ahotan ahi. Chuin Esau'in alungsunga, Kapa chunga lunghemna nikho anaitan; chujoule kanaopa Jacob hi that ning kate, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin achapa lenjo Esau thusei chu Rebekah chu aseipeh taovin ahi. Hichun aman achapa neojo Jacob chu akouvin, ahenga, Vetan, na-upa Esau'in nangma thading nagon, amale ama akilhamonin ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hijeh chun tun, kachapa kathu ngaijin, kipat ninlang Haran'a kasopipa Laban heng lama jamtan.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule na-upa lungsat nahi abei kahsen, ama chutoh nichom khat ga umtan.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nachunga na-upa lunghan nahi abeija achunga nathilbol hi asuhmil tengleh, mi hinsoling ting, chua kon chun hung puidoh sah nange. Ipi dinga hi nikhat tah-a nani lhonna kachan ding ham? ati.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Rebekah'in Isaac henga, Heth chanute jal hin kahinkho ahesoh lheh jenge, Jacob hin hiche gama Heth chanute lah-a hi ji aneikit dingle, kahin hi keidinga ipi phatna ding umem? ati.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Isaac'in Jacob akouvin, phatthei aboh-in, thu apen ahenga, Nangman Canaan mite chanuho naji dinga nakipui theilou ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kipat in, Padan Aram lama nanu pa Bethuel in'a chen; chua kon chun nanu sopipa Laban chanute khat naji ding gakipuijin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangma vaipi khat nahi thei nadingin, hat chungnung Pathen'in phatthei naboh hen, nachi phatsah henlang, hapunin napunsah hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hiche nakholjinna gam, Pathen'in Abraham henga anapehsa gamhi nalotheina din, Abraham phatthei kiboh na chu nangma le nachilhahte napeu hen, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Isaac'in Jacob asolmang tan ahi. Chuin ama Jacob le Esau nu Rebekah sopipa, Syria mi Bethuel chapa Laban henglam Padan Aram lama achetan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Esau'in, Isaac'in Jacob phatthei aboh-a Padan-Aram'a ji kipui dingin asol le, aman amachu phatthei aboh-a, Canaan chanute nakichenpi louding ahi, tia thu apeh chu amun,
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Jacob in anule apa thu angaija, Padan Aram-a ache chu amun;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Esau'in Canaan chanute chun apa Isaac alung lhaisah pouve, ti amu phatnin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Esau Ishmael henga achen, Abraham chapa, Ishmael chanu Mahalath, Nebojoth sopinu chu ji aneisaho chung chon chun akichenpi kitnin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jacob Beersheba'a konin akipat doh-in, Haran lam jonin achetai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ama munkhat alhun phatnin, nisa alhumtah jehchun ageh khovahtan ahi. Chuin aman chuche munna songkhat chu alan, lukhapmin aneijin, chukoma ihmuding chun alumtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman mang aneijin, Vetan, leiset chunga kalbilei akidon, chule hiche mong chun van aphan, chule Pathen vantil ho akumsuh akaltou chu amun ahi
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin vetan, chuche vuma chun Pakai adingin, Keima hi Pakai, napu Abraham Pathen, chule Isaac Pathen chu kahi; nalupna gamhi nangma le na chilhahte henga kapeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nachilhahte chu leisetna leivuijat hung hintin, chule nangma lhumlam le solama, chule sahlam leh lhanglama naki thejao ding ahi. Chule nangma le nachilhahte-a kona vannoi'a namtin phattheiboh chang dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule vetan, Keiman nangma kaumpinai, chule nachena chana kachintupma, hiche gama hi kahin nungpui kitding nahi; ajehchu nahenga kasei hi kamolso masangsen nangma dalhapong kate.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Jacob a-ihmutna konin ahung khangdoh-in; chule aman, Hiche mun'a hin Pakai aum monge; hichu keiman kana hetlou ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ama akichatan, Hiche mun hi tijat iti umtam! hikom hi Pathen in tailou adang ima ahipoi, hiche hi van kotpi phung ahi, atitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jacob jingpitah-in athouvin, lukhapma akoi song chu alan, song khom-in aphutnin, achungvuma chun thao asungin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman chumun chu Bethel asah tai. Ahin atila chu chuche khopi chu Luz anakisah ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jacob'in kitepna aneijin, Pathen'in eiumpia, kachena lampia hi eichintupma, nehding changlhah le kivon nading sil le chen eipeh-a,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitia chu kapa in'a lungmong tah-a kahung kilekitna ahile, Pakai chu ka Pathen hiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hiche song khoma katun hi Pathen In hiding; chule nangman neipeh jouse-a kona hi somakhat thonlou hela kapeh ding nahi, ati.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Jacob akholche achepeh-in, chule solam mite gam agalhungtai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman agahven ahile, gamlah-a twikhuh khat amun, chule veuvin, akoma chun kelngoi honthum akolun ahi; ajehchu twikhuh-a kona chu amahon kelngoi honchu twi adonsah jiu ahi. Chule song lentah khat twikhuh kama chun akikoijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule chua chu kelngoi hon jouse kikhom khom jiuva, chule achinghon twikhuh kama kona chu song chu atahdoh jiuva, kelngoi ho chu twi adonsah jiu ahin; chujouteng, song chu twikhuh kama aum na-a chu akoikit jiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jacob'in amaho jah-a, Kasopite, nangho hoilamkon mi nahiuvem? ati. Chuin amahon, Haran'a kon kahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman ahenguva, Nahor chapa, Laban chu nahet uvem? ati. Chuin amahon, Kaheuve, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman ahenguva, Amachu damnam? ati. Chuin amahon, Adamnai, chule ven, achanu Rachel'in kelngoi ahinpuijin ahunge, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman, Veuvin, nisa khu asang lheh nalaijin, gancha puikhom phatjong ahihihlaije. Kelngoi hohi twi chipsah unlang, an ganehsah kit taovin, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amahon, kelngoihon jouse hung kikhop khom soh-a, twikhuh kama song akilahdoh masangsen, keiho chedoh thei pouvinge. Hiche jouteng chulebou keihon ka kelngoihou twi kadonsahjiu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ama amaho chutoh akihou nalaijin, Rachel apa kelngoi ho chutoh lhonin ahungin ahi; ajehchu aman kelngoiho chu achinji ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, Jacob'in anu sopipa Laban chanu Rachel le, anu sopipa Laban kelngoi hochu amuphatnin, Jacob chu agache naijin, song chu twikhuh kama konin atangdoh-in, anu sopipa Laban kelngoihon chu twi achip sah-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Jacob in Rachel chu achopmin hatah in akaptan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Jacob'in ama amanu pa sopipa ahi le, Rebekah chapa ahichu Rachel aseipeh tan ahi. Chuin amanu alhaijelin apa agahiltan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, Laban'in asopinu chapa Jacob thu ajah phatnin, ama kimupi ding chun alhaijelin, amachu apomin, achopmin, a-in'a ahinpuitai. Chuin aman Laban chu thu jouse ahiltan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Laban'in ahenga, tahbeh-in nangma kagu le kaphe mong nahi, ati. Chuin ama akoma chun lhakhat aumtan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Laban'in Jacob henga, Nangma katupa nahimana keima mohseh-a neijen ding ham? Natoh man ipi hiding ham, neisei peh-in? ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun Laban'in chanu ni aneijin, alen jonu minchu Leah ahin, aneo jonu minchu Rachel ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Leah chu amit agelin, Rachel vang chu mel hoitah le dei umtah ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jacob'in Rachel chu angailun, hijeh chun aman, Keiman nachanu neojo Rachel lonan kum sagi nangma jen inge ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Laban'in, Keiman amanu midang kapeh sangin, nangma kapeh ding aphajoi. Kakoma umtan ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jacob'in Rachel dingin kum sagi ajenin, ahin amanu angailut jehchun hiho chu amadin ni chomkhat to abang bepmin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Jacob'in Laban henga, Ahenga kalut theina dingin, ka-inneipi chu neipetan; ajehchu kanikho ho abulhing tai, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Laban'in chuche munna mijouse akhomin golvah abolin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin nilhah ahiphat nin ahitin ahi, aman achanu Leah chu apuijin, Jacob henga apuilut tan; chule amapa jong amanu henga aluttan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Laban'in asohnu Zilpah chu achanu Leah sohnu din apetai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin ahitin ahi, jingkah ahunghi phatnin, Veuvin, Leah ana hitai. Chuin aman Laban henga, kachunga nabol hi ipi ham? Rachel dinga nangma kajen hilou ham? Achuti le ipi dinga nei dohabol ham? ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Laban'in, kagam uva hi apeng masa masanga aneojo pehdoh chu kibol jilou hel ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amanu hapta hi subulhitnin, chule kum sagi dang neijen kitding manin amanu jonghi nangma pekit naovinge, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Jacob'in chuti chun abolin, amanu hapta chu asubulhit tai. Chuin aman achanu Rachel chu aji dingin apetan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Laban'in asohnu Bilhah chu achanu Rachel sohdin apetan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hitichun ama Rachel henga jong alutnin, aman Rachel chu Leah sangin angailu jon, chule amachu kum sagi dang ajenbe kitnin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Leah hotbola aumchu Pakaiyin amuphatnin, anaobu ahonpehtai. Ahin Rachel vangchu achingin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Leah'in nao avopmin chapa khat ahingin, amin Reuben asah tai. Ajehchu amanun, tahbeh-in Pakaiyin kahesohna amutan; tunvang ka-inneipun eingailu tante, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin amanun nao avop kitnin chapa khat ahingin, Pakaiyin hotna kaum ahetjeh-a, hiche chapa jong hi eipeh ahi, ati. Chuin aman amin Simeon asahtai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin amanun nao avop kitnin chapa khat ahingin, Tunvang chapa thum kahin pehtah jeh-in ka-inneipu keija beh tante, ati. Hijeh chun amin Levi asahtai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin amanun nao avopkit leuvin chapa khat ahing kitnin, chuin amanun, Tunvang keiman Pakai chu vahchoi tange, atin ahi. Hijeh chun amanun amin Judah asahtai: chujouvin amanun acha hin abangtai.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Rachel'in Jacob cha ahinpeh lou chu amuphatnin, Rachel'in a-unu athangset tan ahi. Chuin amanun Jacob henga, Cha neipen, achuti louleh kathi ding ahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jacob Rachel chunga alunghan akoujah jengin, ajah-a, Keima nanaobu khahtang-a, Pathen thalhenga uma kahim? ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amanun, Ven, hikoma hin kasohnu Bilhah aume, amanu henga galut tan, chutia chu keiman jong amanu-a kona chate kaneija, chule amanun kaphei chunga cha ahinding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amanun asohnu Bilhah chu a-inneipi dingin apetan, chule Jacob jong amanu henga agalut tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Bilhah'in nao avopmin, Jacob chu chapa khat ahinpeh tai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Rachel'in, Pathen'in kathu atantan, chule ka aw jong ajan, chapa khat eipetai, ati. Hijeh chun amanun amin Dan asahtai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Rachel sohnu Bilhah'in nao avop kitnin, Jacob chu chapa nina ahinpehtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Rachel'in, Kibotna nasatah-in ka-unu kabon-in, kajoutai, ati. Chuin amin Naphtali asah tai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leah'in cha ahintah louding ahet phatnin, asohnu Zilpah chu Jacob henga apuijin, ajidin apetan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Leah sohnu Zilpah chun Jacob chapa khat ahin peh-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Leah'in, Kavang phalheh-e, ati. Chuin amanun amin Gad asahtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Leah sohnu Zilpah chun Jacob chu chapa nina ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Leah'in, Keima kakipah lheh jenge, ajehchu numei hon anunnom eitidiu ahitai, ati. Chuin amanun amin Asher asahtai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin suhlou chang at laijin Reuben avah len ahile, hamlah-a joldei-ai ahinmun, anu Leah henga ahin choijin ahi. Chujouvin Rachel'in Leah henga, Katao ahi, nachapa joldei-ai chu neipen, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin amanun ahenga, Ka-inneipu neichudoh peh jong hi thil neocha nahisah-a, kachapa joldei-ai kisan jonghi chudoh ding neigot kit ham? ati. Chuin Rachel'in, Hijeh chun nachapa joldei-ai manin aman tujan nangman luppi nan nate, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin nilhah lamin, Jacob louva kona ahungphatnin, Leah alamdot dingin apotdoh-in, ahenga, Keima henga nahunglut teiding ahi; ajehchu kachapa joldei-ai ja kalodoh nahitai, ati. Chuin aman chuche jan chun amanu aluppitan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pathen'in Leah taona chu asangin, chule amanun nao avopmin, Jacob chu chapa nga channa ahinpeh tai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Leah'in, Kasohnu chu ka-inneipu kapeh jeh-a, Pathen'in kalo eipeh ahitai, ati. Chuin amin chu Issachar asahtai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Leah'in nao avop kitnin, Jacob chu chapa gupna ahinpeh tai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Leah'in, Pathen'in keima thilken phatah eipetai; keiman chapa gup kahin peh tah jeh-in, tunvang ka-inneipun eichen khompi tante, ati. Chuin amin Zebulun asahtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin khonungin amanun chanu khat ahingin, amin Dinah asahtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pathen'in Rachel ageldoh-in, ataona asanpeh-in, anaobu ahonpeh tai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amanun nao avopmin, chapa khat ahingtai. Chuin amanun, Pathen'in noise-a kaumna aladohtai, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hijeh chun amin Joseph asahtai, chule amanun, Pakaiyin chapa khat eipeh beding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin ahitin ahi, Rachel'in Joseph ahin nungin, Jacob'in Laban henga, keima kho mong le kagam lama kache theina din neisol dohtan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangma kajena kalodoh kajite le kachate neipenlang, neichesah tan. Ajehchu nangma dinga kanatoh ho chu nahenai, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Laban'in ahenga, katao ahi, namitmu-a lungsetna kachana ahile, umtadin; ajehchu nangma jal-in Pakaiyin phatthei eiboh-e ti kahe doh-in ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman, Nalo ding chu neisei peh-in, keiman penange, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman ahenga, Nangma iti kajena, chule nagancha te kakoma iti umam, ti nangma tah-in nahet ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ajehchu keima hung masanga chu lhomcha bou nanei ahin, tunvang tamtah-in apung taove; chule kahunga patnin Pakaiyin nangma phatthei naboh-in ahi. Ahin tun, itih leba keima insung tum ding kakingaito ding ham? ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman, Nangma ipi kapeh ding ham? ati. Chuin Jacob in, Nangman imacha neipeh louding ahi. Hichehi neibolpeh dinga ahileh, keiman nagancha hon vah ingting, chingkit nange.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tunin nagancha hon jouse gachonsoh ingting, kengoi lah-a avompol chit chet leh apol phet phut jouse le kelngoinou asan gao jouse, chule kelcha lah-a akang polphet phut le apol chitchet jouse lhengdoh ingting, hichu katohman ding hihen.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuti chun khonungle katohman chu namai koh-a ahung kilah teng leh, kachon phatnan keima dinga donbutna apehding ahi. Kelcha ho lah-a apol chitchet le apol phetphut lou jouse le kelngoi lah-a asan gao loujouse chu kaguh-a nalah jeng ding ahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Laban'in, vetan nasei bangchun hihen, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin chuche nichun aman kelchal akihalpol, apoltan le apol phet phut chule kelnu apolchit chet le apolphet phut jouse le achunga akang umjouse, chule kelngoi asan gao jouse chu alhengdoh in, achapate vettupdin apedoh tai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin aman nithum lam gamlan Jacob chu akikhenpin, chule Jacob chun Laban gancha hon dang jouse chu avah-in ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Jacob'in navolthing, bulthing, chule thalthing a-eng tenggol hing asatnin, ahoh chu akhoh kangin, tenggol ho-a chun akangchu akido sah-in ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chutichun ganchaho chu twichipma ahung tengule agaipa nadiuvin, aman ahoh akho tenggol hochu gancha honnin achipnajiu twi donna ho-a chun, gancha hon twi chipma ahung tengule amasanguva chun akoijin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin gancha hon chu tenggol masanga chun nou anei jiuvin, chule ganchaho chun ajinlha-a pol, apoltan, apol chitchet chule apol phetphut ahing jiuvin ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Jacob'in Kelngoinou hochu atumin akhendoh-in, chule gancha hon chu Laban ganchahon ajinglha, apoltan ho le asan gao jouse lamchu angatsah jin ahi. Chule aman ama ganchahon chu atumin akoijin, Laban gancha hontoh akoitha pon ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin ahitin ahi, ganchahon lah-a ahatdom hochu agai tengle tenggol ho lah-a agai theina diuvin, Jacob'in tenggol hochu twilonna-a chun ganchaho mitmun akoijin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahivangin gancha hatmodom ho ding chun hichu akoi jipoi. Chutichun ahatmo ho chu Laban'a ahijin, ahatho chu Jacob'a ahijitai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin mipa chu nasatah-in ahung haodoh tan, ganchahon tamtah, soh numei tamtah, soh pasal tamtah, chule sangongsao le sangan tamtah aneitan ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Laban chapaten, Jacob'in i-pau thil jouse akilahdoh tan; chule ipauva kona hiche loupina nasatah hi akimudoh ahi, tia aseiju chu Jacob'in ajatan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jacob'in Laban maiso chu aven ahile, veuvin, masanga toh abang tapon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakaiyin Jacob henga, Napu napate gamle nasopite henga kiletan, chule keiman nangma umpi nange, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijeh chun Jacob'in gamlah-a agancha hon umna-a chun Rachel le Leah chu agakou sah-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman aheng lhona, Napau maiso kaven ahile, masanga bangin kachunga ahoi tapon ahi; ahivangin kapa Pathen chun eiumpi jingnai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule katha neina jouse-a napau kajen chu nahe lhon nai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahivangin napau vin dohan eihabolin, katohman chu somvei jen eina khelpeh-e; ahivangin aman eisuhset ding chu Pathen'in ana phalpoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman, Apol chit chet ho chu natohman ding ahi atile, ganchahon jouse chun apol chit chet ahing jitauvin; chule aman apoltan ho chu natohman ding ahi atile, ganchaho chun apoltan jeng ahing jitauve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutichun Pathen'in napau ganchaho chu alamangin, hiho chu keima eipetai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahung hitin ahi, Ganchaho gai phat laichun, kamangin ka khodah-in ahile, veuvin, ganchahon matna kelngoi chal hochu apoltan, apoltan chit chet chule ajem chom choma pol ngenin kamun ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pathen vantil chun kamangin kahenga, Jacob, atin; chuin keiman, Hikoma kaume, kati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman, Tun nangma khodah inlang ven, ganchahon matna kelngoi chal jouse khu apoltan, apol chit chet chule ajem chom choma polngen ahiuve. Ajehchu Laban'in nachunga abol jouse kamutai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima hi nangman songphu chunga thao nanu-a, chule ahenga kitepna naneina Bethel Pathen chu kahi. Tun kipatdoh-in, hiche gama konhin nangma potnin lang, nasopite gamlama kiletan, eitin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuphatnin Rachel le Leah'in adonbut lhonin, ahenga, Kapao insunga keini chanding ahiloule kagoulo lhon ding ipi umnalai beh-em?
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman keini maljin bangbepma eigelhon hilouham? Ajehchu aman eikijoh honin, chule kasum hon jong anemang sohtai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu Pathen'in kapauva kona alahmang gou jouse chu keini le kachateuva ahi. Achuti le tun, Pathen'in nahenga aseichan chu boltan, ati lhone.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin Jacob akipatnin, achapate le a-inneipi hochu sangongsao chunga atousah-in;
  </para>
  <para style="p">
    <verse number="18" style="v" />Canaan gama apa Isaac henga chedingin agancha jouse, alamdoh anei jouse, chule Padan Aram gama alamdoh agancha neiho chu akitolmang soh keitan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Laban akelngoiho mulvou dingin achedoh-in; chuin Rachel'in apa milim ho chu agutan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jacob Syria mi Laban hetlouvin akigodoh-in, aman ajam chu anasei peh pon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuti chun ama aneijouse toh ajam than; chule akipatnin vadung chu agalkaijin, Gilead molsang lama akiheitan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin anithum channin Jacob ajamtai, ti chu Laban aseipeh taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman asopite akipuijin, amachu ni sagi lama anungdelin: chuin amahon ama chu Gilead molsang chun aphapa taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pathen'in Syria mi Laban henga chun ajan mangin ahungin, ajah-a, Jacob henga ase apha imacha nasei louna din kichih theijin, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Laban'in Jacob chu aphapatan ahi. Tun Jacob chun apon in chu chuche molsanga chun asongin; chule Laban le asopite chun Gilead molsanga chun asongun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Laban'in Jacob henga, Ipi bola nahi-a, kahetlouva nakiguh doh-a, kachanute chu chemjam'a gal hinga kiman banga puimanga nahim? ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Iti dana guhthim cha najam manga, keija kona nakiguh doh-a; kipana la, khongcha, chule tumgintheito tho-a kilhahdoh nadinga neihetsah louham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule katute le kachanu te kachop ding naphal lou ham? Nangman tun ngol hoitah in thil naboltai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangma suhset thei na dingin tha kaneije; ahivangin napa Pathen chun janhi jan chun kahenga, nangman Jacob henga ase apha nasei lounadin kichih theijin, eitin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule tun nangman napa in nangai behseh jeh-a chu che tahbeh-a nahitan, ipi dinga ka pathenho chu neiguh peh ham? ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Jacob'in Laban chu adonbutnin, ahengah, Kakichat jeh ahi; ajehchu keiman, Nachanute hi acham louvin keija konin neilah peh getnin nate kati ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na pathen ho namuna penpen chu koi hijongle kihinghoi louding ahi. Kasopiteu mitmu hin nathil kakoma umchu holdoh inlang kilah jengin, ati. Ajehchu Rachel'in chuche ho aguh chu Jacob'in ahetlou ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Laban Jacob pon in'a alutnin, Leah pon in'a, chule asohnu teni pon in'a alutnin; ahin aman hiho chu amupon ahi. Chujouvin ama Leah pon in'a konin apotdoh in, Rachel pon in'a aluttan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tun Rachel'in milim hochu analan, sangongsao pho lah-a chun akoijin, achunga chun atouvin ahi. Chuin Laban'in pon insung jouse chu amailen, ahivangin amupon ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin amanun apa henga, namasanga kakipatdoh theilou jeh hin, ka Pakaiyin nopmo sahihbeh hen; ajehchu numei hina ngai chu kachunga auma ahi, ati. Chuin aman ahol len, ahin limho chu amujou pon ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Jacob alunghangin, Laban chu ahousen; chule Jacob'in adonbutnin, Laban henga, Kasuhkhel ipi ham? Kachonsetna ipi hija, Lungsa tah-a neihin nung del jengham?
  </para>
  <para style="p">
    <verse number="37" style="v" />Kathil jouse namaichai soh helin, na insung thil ipi namu em? Eini kahlah thuhi atan theina dingun, hikoma hin kasopite le nasopite anga podoh-in.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hiche kum somni jenhi nakoma kaumtan, nakelngoipi hole nakelpi hon anou anei chavai khapouvin, chule nakelngoi hon lah-a achal hojong kanekhapoi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Gamsa loitel ho jong nahenga kahinlhut khapon; keima tah-in amang chu kamo poh-in; suna kigumang hihen, jana kigumang hijongle, hichu keima neidit sah-in ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hiti hin kaumin; sun teng nisatnin, chule janteng dapmin eisugim lheh jengjin, chule ihjong ka-ihmuji pon ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuti chun kum somni na in'a kahung umin; nachanu teni lonan kum som le kum li nangma kana jenin, chule naganchaho lona-in nangma kumgup kajenin; chuleh nangman katoh man chu somveijen neikhel peh-in ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kapa Pathen, Abraham Pathen, chule Isaac gina chu kakoma umlou hile, thonlouva tu-a jong hi khutgoh keova neisol mang teiding ahi. Pathen'in kahesohna le kakhutna katoh gimna chu amua, janhi janna chu napho ahitai, ati.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Laban'in adonbutnin, Jacob henga, Hiche chanute hohi keima chanute ahin, hiche chate hi keima chate ahiuvin, hiche gancha ho jonghi keima gancha ho ahiuvin, chule namu jouse hi keima-a ahi. Ahin tuni hin hiche kachanu te chung le, ahinnu achateu chunga hin ipi kabolthei dingham? ati.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hijeh chun tun hungin, nangma le keiman kitepna khat sem hite; hichu nangma le keima kah-a hettohsahna hihen, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin Jacob'in song khat alan, khommin aphuttan ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chuin Jacob'in asopite henga, song lhoh khomun, ati. Chuin amahon song alhoh khomun, alhuh-in aseuvin, chule songlhuh chunga chun an aneuvin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin Laban'in hichu Jegar-Sahadutha asah-in; ahivangin Jacob'in hichu Gilead asah-in ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin Laban'in, Tunikhoa hi hiche kisekhom hohi nangle keima kikah-a hettohsahna ahitai, ati. Hijeh chun hiche min chun Gilead akisahtan;
  </para>
  <para style="p">
    <verse number="49" style="v" />Chule Mizpah jong akisah-in ahi; ajehchu Laban'in, Eini khat le khat ikikhen tengleh, Pakaiyin nangle kei eivetup jing lhonhen.
  </para>
  <para style="p">
    <verse number="50" style="v" />Nangman kachanu te hi nasuh genthei ja, ahilouleh kachanu te tailou jidang naneija ahile, koimacha eini koma aumhih nai; ven, Pathen chu nangle kei kah-a ahetoh ahi, atin ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin Laban'in Jacob henga, Hiche song kisekhom hi venlang, nangma le keima kah-a hiche song kaphu jong hi ven.
  </para>
  <para style="p">
    <verse number="52" style="v" />Suhset nadinga keiman hiche songlhuh le song kiphut khela nangma henglam kahinkhel louding, chuleh nangman jong hiche songlhuh le songkiphut khela keima henglam nahin khellouna dingin, hiche songlhuh hi hettohsah hihen, chule song kiphut hi hettohsah hihen.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham Pathen, Nahor Pathen, chule apatehou Pathen chun ikah hona thu tanhen, ati. Chuin apa Isaac ginna-a chun Jacob akihah seltan ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chujouvin Jacob'in molsang chunga chun ganlhaina atoh-in, asopite chu changlhah nedingin akouvin ahi. Chuin amahon changlhah aneuvin, molsang chunga chun ageh khovah taovin ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin jingpi matah-in Laban athouvin, achapate le achanute achopmin, chule phatthei aboh-in ahi. Chuin Laban akipatnin agam lama akiletan ahi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jacob achepeh-in ahile, Pathen vantil ten ana kitopiuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jacob'in amaho chu amu phat nin, Hiche hi Pathen ngahmun ahi, ati. Chuin aman chuche munchu Mahanaim asahtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jacob'in Edom gamkai sunga Seir gama a-upa Esau henga chun, amasanga sottol ho asolin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman amaho chu thu apen, ahenguva, Hitia hi nanghon ka pakai Esau henga nasei dingu ahi; nasohpa Jacob'in hitin aseije, keima Laban koma kagathamin, chumuna chun tugeihin kaume.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman bongchal ho, sangan ho, kelngoi ho, soh pasal ho, chule soh numei ho kaneijin; chule namit mu-a hi lungsetna kamu theina dinga ka pakai hetsah dinga kahinsol ahi, tin gaseijun, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin sottol hochu Jacob henga ahung kileuvin, ajah-a, Na-upa Esau heng kaga phaovin, chujongle ama nangma toh kimuto dingin mi jali toh kilhonin ahunge, atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuphatnin Jacob hatah-in akichan chule alung gimlhehtan ahi. Chuin aman aum khompi miho, kelngoihon, bonghon, chule sangongsao ho chu loinin ahom khenin;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman, Esau chu loikhat koma ahunga, atha tah-a ahijongle, adalhah loikhat chu hoidoh theijinte, atin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jacob'in, Vo kapa Abraham Pathen, chule Kapa Isaac Pathen, nagam lam le nasopite henglama kiletan, keiman nangma bolpha nange tia kahenga seija Pakai;
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangman nasoh chunga namusah hepina jouse le thutah jouse lah-a hi aneopen changdinga kilom kahipoi; ajehchu hiche Jordan hi ka tenggol sehtoh hung galkai ja kahin, tunvang loini hel kahung hitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Katao ahi, ka-upa khutna kon, Esau khut ngeija konin neihuh-in: ajehchu ajole ama hungintin, nunao chapang ho pumin eihung that get nunte, ti kakichan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman, Tahbeh-in keima nabol phang ting, chule nachilhahte atambehseh jeh-a simjoulou twikhanglen kama neldi jat banga kasem ding nahi, tin naseijin ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ama chuche jan chun chukoma chun agehtan; chule akhutna um aneiho lah-a konin a-upa Esau thilpeh-a pehding aladoh-in;
  </para>
  <para style="p">
    <verse number="14" style="v" />Kelpi jani le kelchal somni, kelngoipi jani le kelngoichal somni,
  </para>
  <para style="p">
    <verse number="15" style="v" />Anoi kilhoh lai sangongsao somthum le anoute, bongpi somli le bongchal som, sanganpi somni le sangan chal som akhendoh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman hiche ho chu loitum cheh-in asoh ho khutna apedoh-in, chuin asoh ho henga, Kamasanga ana chepeh unlang, gancha loitum cheh kikah-a chun mun ong umsahcheh-un, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman amasapen chu thu apen ahenga, ka-upa Esau'in nakimupia, nahenga, Koija nahim, hoija cheding nahim? Chule namasanga um hiche hohi koija ham? tia nadoh tengle;
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangman, Hiche hohi nasoh Jacob'a ahiuvin, ka pakaiyu Esau dinga thilpeh-a ahinthot ahi; chule Ven, amajong kanunguva ahunge, tia nasei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman chutobang machun anina, athumna, chule gancha hon loitum juiho henga chun, Esau namu tengule chutobangma cheh-a chu nasei dingu ahi, tin thu apei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nanghon chuche chungchon chun, Ven, nasoh Jacob jong kanunguva khun ahunge, nati dingu ahi, tin ahilcheh in ahi. Ajehchu aman, Kamasanga kisol thilpeh hin keiman alung sudamthei khat ning ting, chujouteng le amai mu nange; ijem atile aman eisangkhat nante, atin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuti chun thilpeh ho chu amasanga asol masan; amatah vangchu chuche jan chun mihon lah-a chun agehtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin chuche jan chun ama athouvin, a-inneipi teni, asoh numei teni, chule achapate somlekhat chu akipuijin, Jabbok vadung agalkai taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman amaho chu apuijin, vadunga chun asol galkaijin, chule anei chengse jong agalkaisah tai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Jacob achang seh-in aumtan; chuin mikhatnin amachu khovahlhah masangsen akibotpin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amapa chun Jacob athatlel ding amuphatnin, apheipi gu kisuhtona akhoipeh in ahile, akibotlhon phatnin Jacob pheipigu kisuhtona chu akikhentan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman, Neichesah tan, ajehchu khovahlha ding ahitai, ati. Chuin aman, Phatthei neiboh louleh lhaponge ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman ahenga, Namin ipiham? ati. Hichun aman, Jacob kahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman, Namin Jacob kiti louding, Israel joh nakiti ding ahitai: ajehchu nangma Pathen toh mihem toh nakibonin najoutai, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Jacob'in amachu adongin, Katao ahi, namin neisepeh-in, tin angehtan ahi. Chuin aman ipidinga kamin neidoh ham? ati. Chuin chua chun amachu phatthei aboh tan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Jacob'in chuche munchu Peniel asahtai: ajehchu keiman Pathen chu kimaito-in kamun, chule kahinkho hing hoijin aume, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman Penuel agalkaijin nisa achunga ahung sohtan, chule ama apheipi jehchun akibaipeh-in ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuti ahijeh chun tuni geihin Israel chaten pheipi gu kisuhtona thajung achomho, pheipi homa umho chu anengai pouve. Ajehchu aman Jacob pheija thagui chomho chu akhoipeh ahi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jacob akhodah-in agahven ahile, veuvin, Esau mi jali toh kilhonin ahungin ahi. Hijeh chun aman achate chu Leah le Rachel chule sohnu teni henga ahomkhen tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman sohnu teni le achateu chu amasa penin akoijin, chuin Leah le achate chu abana, chule Rachel le Joseph chu anunung penin akoijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ama amasanguva achen, a-upa kom aphah kahsen, tolla sagivei aboh khupmin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ama kimupi ding chun Esau ahung lhaijelin, apomin, chuin angong koijin achopmin; chuin amani akaplhon tai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ama akhodah-in ahile, numei ho le chapang ho chu amun, Nalhonpi hohi koi hiuvam? ati. Chuin aman, Pathen'in lungset tah-a nasoh apeh chapang ho chu ahiuve, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chujouvin sohnu teni chu achateu toh ahung naijun, amani le achateu chu aboh khupmun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Leah jong chu achate toh ahung naijun aboh khupmun ahi. Chujouvin Joseph le Rachel ahungnai lhonin, abohkhup lhonin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman, Gancha hon kakitopi ho jouse chu ipi nangaitona ham? ati. Chuin aman, Hiho chu ka Pakai mitmu-a lungsetna kachan nadinga ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Esau'in, Kanao, keiman kagotkhop kaneinai; nangman nanei chu nangma din kikoijin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jacob'in, Ahipoi, nahenga katao ahi, tu-a hi namitmu-a lungsetna changa kahile, kakhut na konin kathilpeh hi kisanin. Ajehchu namai kamu hi Pathen mai kamu toh abang jengin, nangma kachunga nakipah-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nahenga hinkichoi vangbohna hi kisanin, tia katao ahi; ajehchu Pathen'in eilungsetnin, kagotkhop jong kaneinai, ati. Chuin aman amachu angeh khoh-in ahile, akilah tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Esau'in aseijin, Ilamjotnu jong jomu hitin, chetao hite, chule keima namasanguva lamkai jinge, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman ahenga, Chapang hohi neocha cha ahiuvin, chule kelngoi hon kakoma umho jonghi anoukai ahiuve ti ka pakaiyin nahei; chule nikhat jengcha jong kahoi valleh ganchahon jouse hi thigam diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Katao ahi, ka Pakai, nasoh masanga anache masatan; keiman Seir munna ka Pakai heng kahung lhun masangsen, kamasanga um gancha ho le chapang ho kalson dungjui jin hung taovinge.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Esau'in, Tun keiman kalhonpi mi phabep nangma dalhahpeh inge, ati. Chuin aman, Ipi ngaikhoh ding ham? Ka pakai mitmun lungsetna neimusah tan, ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuti chun Esau chuche nichun Seir lam jonin akiletai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Jacob Succoth lama achen, ama dingin in khat asan, chule ganchahon dingin buh asahpeh-in ahi. Hijeh chun chukom munchu Succoth akisah tai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Jacob Padan Aram-a konin Canaan gama Shechem khopi Shalem chu ahung lhung tan; chule aman khopi maija chun apon in asongin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman Shechem pa Hamor chate khutna konin gam behkhat dangka jakhat-in acho-in, hia chun apon in asongin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman chukoma chun maicham khat asemin, hichu El-Elohe-Israel asahtai.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Leah'in Jacob ahinpeh achanu Dinah chu chuche gam chanute ve dingin agapotdoh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Hiv mi Hamor chapa Shechem, chuche gam leng chapa chun amanu amuphatnin, apuijin, aluppin, asubohtan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin alungthim chu Jacob chanu Dinah chunga chun aumtan, chule aman nungahnu chu angailutan, amanu chu kamdam awnemin ahoupitan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Shechem'in apa Hamor akihoupin, Hiche nungah nu khu kajidin neipui peh-in, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jacob'in achanu Dinah Shechem'in asuhboh chu ahetai. Tun achapate gamlah-a aganchate toh uma ahiuvin, chule amaho ahung lhunkah seuchun, Jacob'in alung adejingin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Shechem pa Hamor chu Jacob toh kihou dingin ahung potdoh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jacob chapate chun hichu ajah phatnun, gamlah-a konin ahung lhung taove. Chule aman Jacob chanu aluppia, Israel lah-a ngolhoi tah-a achona, bollou hel ding thil abol jehchun, pasal ho chu alung phamo uvin, alunghang lheh jeng taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Hamor'in amaho chu akihoupin, Kachapa Shechem lungin nachanu alha ngaitai. Amanu hi ajidingin petaovin, tia katao ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keihotoh kichengto uhitin, nachanu teo keiho neipeuvin lang, chule keiho chanute nangho din kilah uvin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangho keiho lah-a chenguvin natin, chule gamchu namasanguva umding ahi. Nangho chengunlang, hia chun kiveijun, chule nanghon gou kikholun, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Shechem'in numeinu pa le asopite henga chun, Namit muva lungsetna neimusah-un, chule kahenga nasei chanu pengkate.
  </para>
  <para style="p">
    <verse number="12" style="v" />Man le thilpeh neiha ngeh behseh hih-un, kahenga nasei dungjuijun penge. Ahinla nungah chu jidingin neipeuvin, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin asopinu Dinah chu asuhboh jehchun, Jacob chapate chun Shechem le apa Hamor chu dohan adonbut uvin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amahon amani henga, Kasopinu cheptan lou khat henga pehdoh ding, hitobang thil hi keihon kabolthei pouve; ijeh inem itile hichu keiho dinga kisuhjum na ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin hiche hi nabol ule vang kanop dingu ahi: nalah uva pasal jousen chep atanuva, keiho banga hi naum uva ahile;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuteng le kachanuteu nangho peuvingting, chule nachanuteu keihon kakipui diu, chuleh nangho toh kachengkhom uva, namkhat ihung hidiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahinla kathuseiju nangailou uva, chep natan lou vangule; kachanu kakipui uva, kache diu ahitai, tin adonbutnuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin athuseiju chun Hamor le Hamor chapa Shechem chu alung lhaisah lhontan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Jacob chanu adeijeh-in gollhangpa chun chuche thilbol ding chu ageisang sahpon ahi. Chule amachu apa insung jouse lah-a ja-um pentah hija ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Hamor le achapa Shechem chu akhopiu kotpibul lah ahung lhonin, akhopiu miho chutoh akihouvun, ajah uvah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Khuche miho khu eihotoh kicham tah-in aumuve; hijeh chun hiche gama khun chengu henlang, kiveiju hen; ajehchu veuvin, gam khu amaho dingin alen khopnai; achanuteu ji dingin kipuiju hitin, chule eiho chanute amaho peuhite.
  </para>
  <para style="p">
    <verse number="22" style="v" />Namkhat ihung hina dingule eihoto achenkhomna dinguva, eihon hiche bouhi ibolu ngai ahi: Hichu amaho cheptan banga, eiho lah-a pasal jousen chep atan cheh ding hi ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chutile aganchahou, anei agouhou, chule asa jouseu khu eihoa hisoh keilou ding ham? Athuseiju ngaipou pouvu hite, chutile amaho ilah uva hungcheng taovinte, atilhone.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin akhopi kotpi phunga hungpotdoh jouse chun Hamor leh achapa Shechem thu ajoptaovin; chuin akhopiu kotpi phunga hunglut jouse pasal tapou achep atanpeh taovin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin anithum chanin ahitin ahi, amaho anat laitah-un, Jacob chapate lah-a ni, Dinah sopiteni, Simeon le Levi chun achemjam cheh akilah lhonin, khopi chu hangtah-in anokhum lhonin, pasal jouse athatgam lhontan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amanin Hamor le achapa Shechem chu chemjam hemin athatlhonin, chuin Shechem in'a konin Dinah chu apuidoh lhonin, achemang lhontai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jacob chapate chun thilong chunga chun lam ajotnun, asopinu asuhboh jeh-u chun, akhopiu chu achomun ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amahon akelngoi hou, abongchal hou, asangan hou, chule khopi sungle gamlah-a umjouse chu akilah taovin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule agou jouseu, achasen hou jouse, ajite hou jouse chu sohchangin akaijun, chule insunga um jouse chu achomun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Jacob in Simeon le Levi henga, Nangnin hiche gama cheng Canaan mite leh Perizz mite lah-a hin hotnin neiumsah lhonin, neisugim lheh lhontai; keima lhomcha kahijeh-in, amaho eidoudin hung kikhom khom untin, keima eitha diu; keima le ka-insung mite hi suhmanga kaum dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin amahon, Kasopinu chu aman mijong banga abolding ham? atiuve.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pathen'in Jacob henga, Kipat doh-in, Bethel'a chetou vinlang, chua chun gachengin; chule na-upa Esau'a kona najam mang laija nahenga hung kilah Pathen dingin chua chun maicham khat semin, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chujouvin Jacob'in a-insung mite le aumpiho jouse henga chun, Nalah uva gamdang Pathen umho chu koidoh-un, kisuthengun, chule navonu kikhelun,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule eiho kipatnu hitin, Bethel'a chetouvu hite; chua chu kahesoh laija eina donbutna, kachena lam chana eiumpi jinga Pathen dingin maicham khat kasem ding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amahon akhutnuva um gamdang pathen jouse le abiluva bilba jouse Jacob apetaovin; chuin Jacob'in hiho chu Shechem koma gangpi phung noija chun aselin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amaho acheuvin ahile, aveluva um khopi ho jouse chunga chun Pathen'a kona tijatna achutan, chule amahon Jacob chapate chu anungdel tapouvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichun Jacob chu ama le aumpi miho jouse chutoh Canaan gama Luz, hichu Bethel ahin, ahunglhung taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman chukoma chun maicham khat asemin, hichu El-Bethel asahtai. Ajehchu a-upa-a kona ajammang laija chumuna chu Pathen ahenga hung kilah-a ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin Rebekah jennu Deborah athitan, chule amanu chu Bethel mun'a gangpi phung noija chun akivuitan ahi. Chule chuche minchu Allon-bacuth akisah tai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Padan-Aram'a kona ahung potdoh chun, Pathen Jacob henga ahung kilah kitnin, amachu phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pathen'in ama henga, Namin hi Jacob ahin: namin hi Jacob kiti kit lou ding, amavang namin Israel kiti joding ahitai, ati. Chuin aman amin chu Israel asahtai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pathen'in ahenga, Keimahi hat chungnung Pathen kahi, chi tamtah lhah inlang, hapunin pungin; nampikhat chule nam chom chom loijong nanga konin hung doh intin, chule lengho jong nanga kona hung pengdoh dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Abraham le Isaac henga kanapeh gamchu nangma pengting, chule nangma nungsanga nachilhahte jong hiche gamhi kapeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin akihoulimpi na mun'a chun Pathen ama-a konin akaltou tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin akihoulimpi na mun'a chun Jacob'in khompi khat, songkhompi chu aphutnin; hiche chunga chun donding thilpeh alheilhan, chuin aman chuche chunga chun thao asungin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Jacob'in Pathen'in ahoulim pina mun chu Bethel asah tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amaho Bethel'a konin achetauvun, chuin Ephrath lhunna ding chu phabep aum nalaijin ahi. Chuin Rachel naosonat nin anatan, nasatah-in athohgim tan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, amanu athohgim behseh phatnin, nao domnu chun ahenga, Kicha hih-in, nangman hiche chapa jonghi naneiding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, alha achedoh to lhonin, (ajehchu amanu thia ahitai) amanun amin Ben-oni asah-in ahi. Ahivangin apan Benjamin asah-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Rachel athitan, Bethlehem kiti Ephrath jotna lampia chun avuitaovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Jacob'in alhan chunga chun songkhom aphutnin; hichu tuni geihin Rachel lhansongphu akiti jingin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Israel achepeh-in, Edar insang kala chun apon in chu asongin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ahitin ahi, Israel chuche gama achenlai chun Reuben achen, apa thaikemnu Bilhah chu aga luppitan; chuin Israel'in hichu ahetan ahi. Tun Jacob chapate chu somleni ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leah chapate chu, Jacob chapa masapen Reuben, Simeon, Levi, Judah, Issachar chule Zebulun ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rachel chapate chu, Joseph le Benjamin ahilhone.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Rachel sohnu Bilhah chapate chu, Dan le Naphtali ahilhone.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Leah sohnu Zilpah chapate chu, Gad le Asher ahilhone. Hichenghi Jacob chapate Padan-Aram gama pengho chu ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Jacob Arba khopi, hichu Hebron ahin, Abraham le Isaac pemna mun Mamre'a chun apa Isaac kom ahunglhun tan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Isaac damsung chu kum jakhat le kum somget ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Isaac'in alhagao alhan, upatah le teh bongsetnin athitan, amite toh gopkhomin aumtan ahi. Chuin achapa teni Esau le Jacob chun avuilhon tan ahi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichengho hi Edom kiti, Esau chilhah teho chu ahiuve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esau'in Canaan chanute jin akipuijin, amaho chu: Hit mi Elon chanu Adah, chule Hiv mi Zibeon chanu, Anah chanu Aholibamah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Nebojoth sopinu, Ishmael chanu Bashemath ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Adah'in Esau Eliphaz ahinpeh-in, chule Bashemath'in Reuel ahingin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Aholibamah'in Jeush, Jaalam chule Korah ahingin ahi. Hichenghi Esau chapate Canaan gama pengho chu ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Esau'in a-inneipite, achapate, achanute, chule a-insung mite jouse, aganchaho leh agamsa jouse, chule Canaan gama alamdoh aneijouse akitolin, anaopa Jacob'a konin gamchoma achemang tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu amaho munkhatna achenkhom nadiuvin aneiho chu atambehseh tan, chule agancha hou jehchun apemnao gamchun adol tapouvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutichun Esau Seir molsanga achengtan ahi. Esau chu Edom ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hichenghi Seir molsang mun'a Edom mite pa Esau chilhahte chu ahiuvin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichenghi Esau chapate minho chu ahi; Esau inneipi Adah chapa Eliphaz, Esau inneipi Bashemath chapa Reuel ahilhone.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Eliphaz chapate chu Teman, Omar, Zepho, Gatam chule Kenaz ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Timna chu Esau chapa Eliphaz thaikemnu ahin; amanun Eliphaz dingin Amalek ahinpeh-in ahi. Hichenghi Esau inneipi Adah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hichenghi Reuel chapate ahiuve; Nahath, Zerah, Shammah chule Mizzah ahiuve. Hichenghi Esau inneipi Bashemath chapate ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hichenghi Zibeon chanu, Anah chanu, Esau inneipi Aholibamah chapate ahiuve. Amanun Esau chu Jeush, Jaalam chule Korah ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichenghi Esau chapate lah-a apipu ho chu ahiuve: Esau chapa masapen Eliphaz chapate chu, pipu Teman, pipu Omar, pipu Zepho, pipu Kenaz,
  </para>
  <para style="p">
    <verse number="16" style="v" />Pipu Korah, pipu Gatam, chule pipu Amalek ahiuve. Hicheng hi Edom gama Eliphaz'a kona pengdoh pipu hochu ahiuvin, hichenghi Adah chapate ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichenghi Esau chapa Reuel chapate ahiuve: Pipu Nahath, pipu Zerah, pipu Shammah, chule pipu Mizzah ahiuve. Hichenghi Edom gama Reuel'a kona pengdoh pipuho chu ahiuvin; hichenghi Esau inneipi Bashemath chapate ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hicheng hi Esau inneipi Aholibamah chapate chu ahiuve: Pipu Jeush, pipu Jaalam, pipu Korah ahiuve. Hicheng ho hi Anah chanu, Esau inneipi Aholibama'a kona pengdoh pipu hochu ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichenghi Edon kiti Esau chapate ahiuvin, chule hichenghi apipuhou chu ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichenghi chuche gama cheng, Hor mi Seir chapate ahiuve: Lotan, Shobal, Zibeon, Anah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Dishon, Ezer, chule Dishan ahiuve. Hichengho hi Edom gama Seir chapate, Hor mite pipuho chu ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Lotan chapate chu Hori le Heman ahilhonin; chuleh Lotan sopinu chu Timna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Shobal chapate chu hicheho ahiuve: Alvan, Manahath, Ebal, Shepho, chule Onam ahiuve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hichenghi Zibeon chate chu ahiuve; Ajah chule Anah ahilhone. Hiche Anah hi ahi apa Zibeon sanganho gamthipma achinna-a sanganpi ho mudohpa chu.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Anah chate chu hichenghi ahiuve; Dishon le, Anah chanu Aholibamah ahilhone.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule hichenghi Dishon chate chu ahiuve; Hemdan, Eshban, Ithran, chule Cheran ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ezer chate chu hichenghi ahiuve; Bilhan, Zaavan, chule Akan ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dishan chate chu hichenghi ahiuve; Uz le, Aran ahilhone.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hicheng hi Hor mite-a kona hungpeng doh pipu hochu ahiuve: Pipu Lotan, pipu Shobal, pipu Zibeon, pipu Anah,
  </para>
  <para style="p">
    <verse number="30" style="v" />Pipu Dishon, pipu Ezer, chule pipu Dishan ahiuve. Hichengho hi Seir gama pipu holah-a Hor mite hung dohna pipuho chu ahiuve.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule hichengho hi Israel chate chunga koimacha ana lengchan masanga, Edom gama analeng changa lengho chu ahiuve.
  </para>
  <para style="p">
    <verse number="32" style="v" />Beor chapa Bela chu Edom'ah ana leng changin; chule akhopi min chu Dinhabah anahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Bela chu athitan, Bozra gama Zerah chapa, Jobab chu akhelin analeng changin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jobab chu athitan, Temani gama Husham chu amakhelin analeng changin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Husham chu athitan, Moab gamlah-a Midian thatpa Bedad chapa Hadad chu ama khelin aleng changin ahi. Chule akhopi min chu Avith ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Hadad chu athitan, Mashrekah mi Samlah chu akhelin analeng change.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Samlah athitan, luipi panga Rehoboth kho-a Shaul chu ama khelin analeng changin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Shaul chu athitan, Achbor chapa Baal-hanan chu ama khelin analeng changin ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Akchbor chapa Baal-hanan chu athitan, ama khelin Hadar analeng change. Chuleh akhopi min chu Pau ahin; chule a-inneipi chu Matred chanu, Mezahab chanu Mehetabel ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hichengho hi a-insung dungjuiju, achennao munho dungjuile, aminu dungjuija Esau'a kon hungdoh pipu hochu ahiuve; Pipu Timnah, pipu Alvah, pipu Jetheth,
  </para>
  <para style="p">
    <verse number="41" style="v" />Pipu Aholibamah, pipu Elah, pipu Pinon,
  </para>
  <para style="p">
    <verse number="42" style="v" />Pipu Kenaz, pipu Teman, pipu Mibzar,
  </para>
  <para style="p">
    <verse number="43" style="v" />Pipu Magdiel, chule pipu Iram ahiuve. Hichengho hi agoulona gama achennao dungjuija Edom pipuho chu ahiuve. Amachu Edom mite pa Esau ahi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jacob apa kholjina gam, Canaan gama chun achengtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichenghi Jacob achilhah ho chu ahiuve. Joseph chu kum som le kum sagi alhinin, asopite toh ganchahon achingun; chule chapang chu apa inneipi teni Bilhah chapate le Zilpah chapate toh aumin ahi. Chuin Joseph'in agitlounau thuthang chu apa henga alhutjin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun Israel'in Joseph chu atehnunga ahin achapa ahijeh chun, achapa dang jouse sangin angailun ahi. Chuin aman amachu sangkhol chol jemchom choma pol asempeh-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amachu asopiho jouse sangin apauvin angailujoi ti a-ute chun amuphatnun, amahon amachu aho taovin, kam ngeijin ahouthei tapouvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Joseph'in mang aneijin, hichu asopite henga aseipeh-in ahi. Chuin amahon amachu anahot locheh taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman ahenguva, Katao ahi, keiman kamangmat hiche mang hi ngaitemun,
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu veuvin, eihon louva changphal inakanun, chule veuvin, keima changphal chu ahung kipatdoh-in, adingjang petnin; chuin veuvin, nangho changphal hochu ahung ding kimvelun, keima changphal chu chibai aboh-un ahi, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin a-ute chun ahenga, Nangma kachunguva nalengchan mongding ham? Ahilouleh nangma kachunguva vaihoma napan mongding ham? atiuve. Chuin amahon amachu ahotbecheh jeng taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman mang chomkhat amat kitnin, chule hichu a-ute henga ahilin, ajah uvah, Veuvin keiman mang khat kanei kitnin ahi; chule veuvin, nisa, lhathah chule ahsi somlekhat nin chibai eina boh-e, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman hichu apa leh a-ute aseipehtan ahi. Chuin apan amachu aphoh-in, ajah-a, Namang neihi ipi mang ham? Keima le nanu chule nasopite hi nangma henga tolla bohkhupma chibai boh dinga kahung mong diuham? ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin a-uten amachu amitthip taovin; ahin apa vangin thu kiseichu aching jingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin a-ute chu apao ganchahon vah dingin Shechem'a achetauvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Israel'in Joseph henga, Na-uten gancha hon Shechem'a avah-u hilouham? Hungin, keiman nangma amaho henga solinge, ati. Chuin aman ahenga, Hikoma ka ume, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman ahenga, Katao ahi, chenlang na-ute ho dam naovem, chule ganchahon jong dam naovem gavenlang, chule kahenga thu hinpo kitnin, ati. Chutichun aman amachu Hebron phaichama konin asolin, chuin ama Shechem aga lhungtai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin mi koiham khatnin amachu amun, chule veuvin, ama gamlah-a avahlen ahi. Chuin mipa chun ahenga, Ipi nahol ham? tin adongin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman, ka-ute kahol ahi. Nahenga katao ahi, hoija aganchahon nu avah-um neisei peh-in, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin mipa chun, Amaho hia konin achetauve; ajehchu amahon Dothan'a cheohite atiu kajai, ati. Chuin Joseph'in a-ute chu anungdelin, Dothan'a chun agamutan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amahon amachu gamlatah-a agahmu phatnun, amaho lam ahungnai masangin, amahon ama tha ding thu ana kihousom taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin khatnin khat henga aseijin, Veuvin, mang neipa chu ahunge.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun tun hunguvin, amahi thatnu hitin, kokhuh khat touva seplutnu hitin, chule eihon, Gamsa hang khat touvin atha ahitai tiu hite: chule amang chu ipi ahungso ivet dingu ahi, akitiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Reuben'in hichu ajan, akhut nuva konchun ahuhdoh-in; chule, Eihon amahi that pou hite, atin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Reuben'in akhutnuva kona chudoh-a, apa henga anungsolpeh theina dingin, ajah uva, Thisan sohih beh-un, amavang gamthip laija hiche kokhuh-a khun galeh lutnuvin lang achunga vang khut lhahih-un ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin ahitin ahi, Joseph chu a-ute heng ahung lhun phatnin, amahon Joseph'in aki-ah sangkhol chol, ajemchom choma pol chu asutlhah peh-un;
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule amahon amachu apuijun, kokhuh sunga alehlut taove. Hiche kokhuh chu akeo ahin, asunga twi umlou ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amaho an nedingin atou taovin ahi. Chuin amaho akhodah-un ahile, veuvin, Ishmael honkhat Gilead gama kona asangongsao houtoh thil namtui, thingnailou, chule Myrrh hinpo-a, Egypt gama posuh dinga cheho chu amuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Judah'in asopite henga, Eihon inaopao ithaova, athisan isouva ipi phachom ding ham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hungun, Ishmael mite henga johdoh-u hitin, achunga ikhutnu lhapouhite; ajehchu ama inaopao ahin, itahsa mongu ahibouve, ati. Chuin asopiten athu angai taovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Midian sumkol veiho chun ahinho pauvin ahile, amahon Joseph chu kokhuh-a konin akaidoh-un, Ishmael miho henga chun dangka somni dingin ajoh taovin ahi. Chuin amahon Joseph chu Egypt gama apuitaove.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Reuben kokhuh-a ahung kitnin ahile; veuvin, Joseph chu kokhuh-a ana umtapon; aman apon asattel jengin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ama asopite henga ahung kilen, ahenguva, Chapang chu aumtapoi; keima hi hoilama chetang katem? ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin amahon Joseph sangkhol chol chu alauvin, kelcha khat athatnun, athisan lah-a chun sangkhol chol chu adeuvin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin amahon sangkhol chol jemchom choma kisem chu apau athotnun, chule amahon ahenga ahin choijun, ajah-a, Hichehi keihon kamu-u ahi: nachapa sangkhol chol ahi ahilou nahet em? atiuve.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin aman hichu ahetan, Hichehi kachapa sangkhol chol ahi; gamsa hangin anehjou hiding hitahi; Joseph hi thonlouva ahal hala asatel hitahi, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Jacob'in aponsil ho asat telin, akonga khaodip pon akichenin, nitampi achapa pul adouvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin achapate jouse le achanute jouse ama lhamon dingin akipatnun; ahivangin ama lhamon ding anompon; Ajehchu chu keima lhankhuh-a lunghem puma kachapa henga cheding kahi, ati. Chutichun apa chu ama dingin akap akapmin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Midian mihon amachu Egypt gama Pharoah noija pipu, ngahtup ho lah-a lamkai Potipher henga ajoh taovin ahi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche laichun ahitin ahi, Judah chu asopite lah-a konin achesuh-in, Adulam mikhat amin Hirah chu agabeltan ahi
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin hia chun Judah chun amin Shua kiti Canaan mikhat chanu amutan; chule aman amanu chu akichenpin, ahenga aluttan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amanun nao avopmin, chapa khat ahingin; chule aman amin Er asah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amanun nao avoppai kitnin, chapa khat ahingin; aman amin Onan asah-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amanun nao avopkitnin, chapa khat ahingin; amin Shelah asah-in ahi. Amanun ama ahinna chun amapa Cherib'a aumin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Judah'in achapa masa Er ding chun ji apuipeh-in, amin Tamar ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Judah cha masapen Er chu Pakai mitmun akhang gilou lheh-in ahile, Pakaiyin amachu athat tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Judah'in Onan henga, Na-upa inneipi henga galutnin lang, amachu kichenpin, chule na-upa dingin chi khaipeh-in, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Onan'in achikhai chu ama-a ahilouding chu ahen; chuin ahitin ahi, ama a-upa inneipi henga alut phatnin, a-upa dinga chi akhai pehlouna din, tolla alhi lhajin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin athilbol chun Pakai alung lhaitapon; hijeh chun amajong athattan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin Judah'in amounu Tamar henga, Kachapa Shelah ahung khandoh kahsen, napa in'a meithaijin ana umtan, ati. Ajehchu aman, Ama jonghi a-uteni bangin thiget inte ati ahi. Chuin Tamar achen, apa in'a agachengtan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin phat chomkhat jouvin Shua chanu Judah inneipi chu athitan ahi; chuin Judah chu lhep lung mongin aumtan, ama le agolpa Adullam mi Hira chu Timnah'a kelngoimul vouho henga agachetou lhonin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Tamar henga chun, Ven natehpu akelngoi mul voudingin Timnah'a achetouve, tin aseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman ameithai vonho ahohlhan, pon lukhuh akikhuh in, akitomchah-in, Timnah jotna lampi mun onglai khatna atouvin ahi; ajehchu Shelah chu kikhan lhitna ahitan, akichenpi dinga apehlou chu amanun ahet ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Judah'in amanu chu amuphatnin, amai akhujeh chun noti hinte tin angaiton ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ama lampama amanu henglama chun akiheijin, ajah-a, Katao ahi, hungin, keima nahenga hunglut inge, ati (Ajehchu aman amounu ahilam chu ahetlou ahi.) Chuin amanun, Kahenga nahunglut dinga ahile, ipi neipeh ding ham, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman, Keiman ganhon lah-a konin kelnou khat hinthot nange, ati. Chuin amanun, Nangman hichu nahinthot masanga, kitepna khat neipeh ding hinam? ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman, Ipi kitepna kapeh ding ham? ati. Chuin amanun, Na mahor, na chao, chule nakhutna um natenggol chu neipen, ati. Chuin aman hichu amanu apen, chule amanu henga aluttan, chule amanun amapa-a konin nao avoptan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amanu akipatdoh-in, achemangin, aponkhu chu ahohlhan, chule ameithai von chu akivon kittan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Judah chun numeinu khutna kona akitepna thilho ladingin, agolpa Adullam mi khutna chun kelnou khat chu athotnin ahi. Ahinla aman amanu chu amujou tapon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman chuche munna miho chu adongin, Lam pama mun ong laija notinu chu hoija umtam? ati. Chuin amahon, Hiche mun'a noti koima aumpoi, atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ama Judah henga ahung kilen, ajah-a, Amanu chu kaga mujoupoi; chule chuche mun'a mihon jong, Hiche mun'a koima noti aumpoi, atiuve, tin aseijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Judah'in thil chu amanu changden tahen, achuti loule kijumso get hite;ven, hiche kelnou hi kathotnin, amanula nagamu joupoi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ahitin ahi, lha thum jouvin, Judah henga, Namounu Tamar noti'n apangin, chukal valin jong, ven, ajon na-a konin nao avoptai, tin aseipeh-un ahi. Chuin Judah'in, Amanu chu hinpui doh-un, chule kihal lihhen, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amanu ahinpuidoh phatnun, Hiche thilho neipa-a kona hi naovopma kahi, tin atehpu henga chun thu agathot tan ahi. Chuin amanun, Katao ahi, hiche mahor, chao, chule tenggol hi koija ham? vechenin, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Judah'in chuche thilho chu ama-a ahi chu ahetan, Amanu keisangin achonphajon ahi; ajehchu kachapa Shelah amanu dinga kapehlou jeh ahi, ati. Chuin amanu chu akal akitimatpi kittapon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin amanu naosonat phat ahunglhin phatnin ahitin ahi, veuvin, naobu sunga chun apengkop ding ni anaumin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule ahitin ahi, amanu anaovin ahinheh phatnin, khatnin akhut ahinsoh doh-in ahile, naodom nun, Hichehi ahung sohdoh masajo ahi tin akhut chu alan, pat sandup abupeh-in ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, aman akhut aloilut kit phatnin, veuvin asopipa ahungdohtan ahi. Chuin amanun, Iti nahin phut vang ham? hiche phutkeh nahi nachunga umhen, ati: hijeh chun amin Pharez asah taove.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin chuche jouchun akhutna pat sandup kibua asopipa chu ahung pengtan ahi. Chuin amin Zarah asah taovin ahi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Joseph chu Egypt gama apuisuh-un; chule Pharoah noija pipu khat, ngahtup loilah-a lamkai Egypt mi Potipher chun hinpui suh-a Ishmael miho khutna konin achotan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin Joseph chu aumpin, amachu milolhing tah ahung hita; chule apu Egypt mipa in'a chun aumin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakaiyin ama aumpia, atoh jouse chu Pakaiyin akhut na alolhinsah chu apupa chun amutai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Joseph apu mitmun lungsetna achangtan, amachu ajen letan ahi. Chuin ama insung vetup ding chun akoijin, aneijouse chu akhutna akoitan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ahitin ahi, a-insung le anei jouse chunga avetup dinga akoi nikho-a pat chun Pakaiyin Joseph jal-in Egypt mipa insung chu phatthei aboh tan; chule Pakai phatthei bohchu a-insung alouma chule aneijouse chunga chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman aneijouse Joseph khutna akoisohtan, chule anehding an tailou ahetding dol thiljong ahetapon ahi. Chule Joseph chu migong hoitah le melhoitah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin hiche nungchun ahitin ahi, apu inneipi chun Joseph chu deichat mitnin avetan, chule amanun Neiluppin, atin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin ama anompon, apu inneipi henga chun, Vetan kapun hiche insunga hi kakhutna ipipi um ahi ahepon, chule aman aneijouse kakhutna akoi ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche insunga hi keima sanga lenjo koima aumpon; chujongle nangma a-inneipi nahi jeh-in nangma tailou hiche insunga aman keima khutna apehdoh lou imacha umlou ahi. Chuti ahile keiman hitobang khangitlouna lentah hi iti kabola, Pathen douna-a kachonset thei ding ham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, amanun Joseph luppi ding ahiloule aumpi dinga niseh-a aseivangin, aman amanu chu lungna changin angai pehpon ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin chuche laiphat chun ahitin ahi, Joseph chu insunga kinbol dingin agalutnin ahile, insunga chun koimacha aumpon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amanun, Neiluppin, atin amachu aponsilin amanin ahi. Chuin aman aponsil chu amanu khutna chun adalhan, ajamin, insunga kon chun apotdoh tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, amanun akhutna apon adalhan, insunga konin ajamdoh tai, ti ahet phatnin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Amanun a-insunga miho chu akouvin, ajah uvah, Vetaovin eiho jum sahdin aman Hebrew mikhat ihenguva ahin puilutnin; eiluppi dingin amapa kahenga ahung lutnin, chuin keima hapenin kapeng jah jengin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin ahitin ahi, Aman aw sangtah-a kapenjah jengchu ahet phatnin, aponsil kakoma adalhan ajamin, insunga konin ajamdoh tan ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amanun a-pakaipa in ahunglhun kahsen, aponsil chu akoma akoi jingin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amanun chuche thu mama chu ahenga aseijin, Ihenguva nahin puilut Hebrew mi sohpa chu eisujum dingin kahenga ahung lutnin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ahitin ahi, aw sangtah-a kapenjah phatnin, aman aponsil kakoma adalhan, ajamdoh tai, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ahitin ahi, Joseph pakaipa chun a-inneipin ahenga, Nasohpan hitihin eibole, tia aseichu ajah phatnin, alunghan akoujah jengin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin a-pakaipa chun Joseph chu akaijin, lengte soh changho kihenna mun songkul'a chun akoitan; chule ama songkul'a chun aumtan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahivangin Pakaiyin Joseph aumpin, hepina amusah-in, chule songkul ngahpa mitmu-a lungsetna achansahtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin songkul ngahpa chun songkul'a um sohchangho jouse chu Joseph khutna achinsahtan; chule chumuna kibol jouse chu, Joseph mopohna ahitai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakaiyin aumpi jeh le atoh tapou chu Pakaiyin alolhinsah jeh-in, akhut noija thil umpou pou chu songkul ngahpan adonkhoh tapon ahi.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin chucheng thil jouse nungin ahitin ahi, Egypt lengpa jukhon dompa le changlhah sempa chun a-pakaiyu, Egypt lengpa chu alung phatmosah lhontan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pharoah noija pipu teni, jukhon dom pipu le changlhah sem pipu chunga alunghang tan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman Joseph kihenna songkul ngah ho lamkaipa in, kihenna mun'a chun amani chu akhumtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ngahtup ho lamkaipa chun amani vetup dingin Joseph chu akoijin, chule aman amani chu ajenletan ahi. Chule kihenna munna chun amani phat chomkhat a-umlhontan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin songkul'a um Egypt lengpa jukhon dompa le changlhah kangpa mang amat lhonin, anilhona jan khatna aneicheh lhon ahin, chule anilhonin aledohna to amangmat tha cheh lhonin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Joseph chu jingkah-in amani henga ahungin, amani chu aven ahile, veuvin amani anguichet jeng lhonin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman a-pakaipa indan khatna aumpi Pharaoh vaipo teni chu adongin, Ibola nangni tunia hi hiti nguichet jeng nahi lhonham? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin amanin ahengah, Keinin mang kamat lhonin, ahinla hichu aledohding koima aumpoi, atilhone. Chuin Joseph'in amani hengah, Aledoh nachu Pathen'a um hilouham? Kahenga neiseipeh lhonin tia katao ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin juhai dom pipu chun amang chu ahilin, ajah-a, Kamangin, veuvin, kamasanga lengpigui khat anaumin;
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule lengpiguija chun abah thum aumin; chule hichu amum hung kisem bangin aumin, apah ho ahung sohdoh-in, chule apahboh hochun lengpiga minho chu ahinsodoh tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pharaoh khon chu kakhutna hin anaumin; chule keiman lengpiga chu kanalan, Pharaoh khonsunga kana mehlhan, chuin keiman khon chu Pharaoh khutna kanapen ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Joseph'in ahenga, Hiche hi aledohna chu ahi: Abah thum hochu nithum ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nithum sunga Pharaoh'in nangma nalhadoh-a, natoh mun'a napansah kitding ahi. Chule masanga nangma ajukhon doma napan laija banga, Pharaoh khonchu akhutna napeh kitding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin nangma dinga thil aphatsoh phatle keima neihin geldoh inlang, kachunga hin lungsetna neihin musah-in, chule Pharaoh henga kaumchan hinseijin lang, hiche in'a konhin neihung puidoh teijin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu tahbeh-a keima hi Hebrew mite gamsunga kona eikigudoh ahin; chule hikom jenga jong hi hiche gimbolna mun'a eikikhum nathei khopma ima katohset umlou ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin changlhah sem pipu chun aledohna chu aphalam ahi ti amuphatnin, Joseph henga, Keiman jong mangkhat kana matnin, chule veuvin, changlhah lothum kalu chunga kathopton ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin achung nungpen lo-a chun Pharaoh dinga kihon nehthei namkim aumin; chuin kalu chunga lo-a konchun vachaten hichu aneuvin ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Joseph'in adonbutnin, ahenga, Hiche hi aledoh nachu ahi: Lo thum chu nithum ahin;
  </para>
  <para style="p">
    <verse number="19" style="v" />Nithum sunga Pharaoh'in nangma nalhadoh-a thingchunga nakhai ding; chule vachaten nasa anehdiu ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin nithum chanin ahitin ahi, hichu Pharaoh pen nikho ahin, aman asohte jouse din golvah abolin ahi. Chuin aman jukhon dom pipu le changlhah sem pipu chu asohte lah-a apuidoh tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin aman jukhon dom pipu chu ajukhon dopna mun'a apansah kitnin; chuin aman khon chu Pharaoh khutna apekit tan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahivangin aman changlhah sem pipu chu Joseph'in aheng lhona aledoh bangchun, akhailih tan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahinla jukhon dom pipu chun Joseph ageldoh tapon, amachu asumiltan ahi.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, kumni kichaina lamin Pharaoh'in mang aneijin; chule veuvin, ama vadung panga ana dingin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin veuvin, bongpi sagi hoitah cheh le thaochet cheh vadunga konin ahung doh-un; hampa lah-a chun alhaovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin veuvin, bongpi dang sagi melse tah le gongtah tah vadunga kon mama chun ahungdoh kitnun; vadung pam twi china-a chun bongpi dangho koma adingun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin bongpi melse tah le gongtah tah ho chun, bongpi hoitah le thaotah tah hochu anejou hel taovin ahi. Chuin Pharaoh ahung khangdoh tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pharaoh a-ihmulhu kitnin, anivei channa-in mang aneikit: chule veuvin, changkung khat nahin changvui sagi lentah le phatah ahung doh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin chuche jouchun, veuvin, solam huijin asem gopsa changvui geositset sagi ahungdoh-in ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin geositset sagi chun changvui lentah le phatah sagiho chu avallhumtan ahi. Chuin Pharaoh ahung khangin ahile, veuvin, hichu amang anahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi, jingkah ahung hi phatnin ama alungkham lheh jengtan, chuin aman mi asolin, Egypt gama mitphel doithem jouse le miching jouse akoutan ahi. Chuin Pharaoh'in amaho henga amang chu aseijin; ahivangin Pharaoh henga chun hiche ledohthei koimacha aumtapon ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin jukhon dom pipu chun Pharaoh henga, Tunin kathemona khat kagel doh-e:
  </para>
  <para style="p">
    <verse number="10" style="v" />Pharaoh chu asohte ni chunga alung hana, keima le changlhah sem pipu chu ngahtup ho lamkai in'a songkul'a akoi laijin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Keima le ama chun jan khat mang kanei gel lhonin; keinin atumcheh-in aledohna um mang kanei gel lhonin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin chukoma chun ngahtup lama lamkaipa sohpa Hebrew khangdong khat keini toh aumkhomin ahi; chuin amachu kaseipeh lhonin ahile, aman kamanglhon chu aledoh-in; kamanglhon dungjui chun aledohna chu eiseipeh gel lhonin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, aman kaheng lhona aledoh bang chun, chutichun ahung guilhungin; aman keima katoh na mun'a eipansah kitnin, chule amavang chu akhailih tan ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin Pharaoh'in Joseph koudingin mi asolin, chuin amahon songkul'a konin gangtah-in ahin puidoh-un ahi. Chuin ama akivou ngimin, aponsil akikhelin, Pharaoh henga chun ahunglut tan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pharaoh'in Joseph henga, Keiman mangkhat kaneijin, hichu aledohthei ja koimacha aumtapoi. Chule keiman nangma chungchang thu, nangman mang ledohthem theina naneije ti mi seinan kajan ahi, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Joseph'in Pharaoh chu adonbutnin, ahenga, Hichu keima-a uma ahipoi; Pathen joh-in lungmon umtah donbutna chu Pharaoh apehding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pharaoh'in Joseph henga, Kamangin, veovin, keima vadung panga kana dingin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin, veovin, bongpi sagi thaotah le hoitahcheh vadunga konin ahungdoh-un; hamhing lah-a chun alhaovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule veovin, bongpi sagi dang phamotah le melsetah chule gongtah tah, chutobang tah-a melse Egypt gam jouse-a jong kanamukhah louhel chu anunguva chun ahungdoh-un ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin bongpi gongtah le melsetah hochun bongpi sagi thaotah tah masaho chu anejouhel taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin hiho chu anehjouhel vangun, anehjouvu chu hetdoh thei ahidehpoi; ajehchu amaho chu atila bang chun amelse jing jenguvin ahi. Chuti chun keima kahung khangdohtai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin keiman kamangin, veuvin, changkung khatna changvui sagi dimset set le phatah tah ahungdoh kamun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin veuvin, hiho nunga chun changvui sagi asisa le gaositset chule solam huijin asemgopsa ahungsoh kitnin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin changvui geositset hochun changvui phatah tah sagiho chu avaljouhel tan ahi. Chule keiman hichu mitphel doithemho henga kaseijin; ahivangin eihilchen thei koimacha aumpon ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Joseph'in Pharaoh henga, Pharaoh manghi thakhat ahi, Pathen'in athil hinbol dingho chu Pharaoh henga amusah ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bongpi phatah sagiho chu kum sagi ahin; chule changvui pha sagi chu kum sagima ahi. Mang chu thakhat ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule anunga bongpi gongtahle melsetah sagi hungsoh doh hochu kum sagi ahin; chule changvui sagi asikeu, solam huijin asemgopsa chu kum sagi kel lhah ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Keiman Pharaoh henga kaseisa chu hiche thilhi ahi. Pathen'in athil hinbolding chu Pharaoh amusah ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Veovin, Egypt gam pumpi-a hi kum sagi neh nasatah-a ninglhingsetna hung lhung ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule hiche jou chule kum sagi kel lhah hung lhungding; chule Egypt gama neh ning lhinna kum jouse chu suhmila hung umding; chule kel lhah chun gam chu anehchai ding;
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule kel hung lhunding jeh-a chu ninglhinna chu gamsunga hetphah louhela umding ahi; ajeh chu hichu nasalheh ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Pharaoh'in mang nivei nanei kopna jehchu hichehi ahi: Pathen'in thilchu asuhdet ahitan; chule hichu Pathen'in chomlouva aguilhunsah ding jeh ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh chun tun Pharaoh'in lungelthem le miching khat holdoh henlang, amachu Egypt gam chunga vaipon tungdoh hen.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hijeh chun Pharaoh'in tun hichehi bolhen, chule gamsunga hin vaipoho lhengdoh henlang, amaho chun neh ninglhinna kum sagi sungchun Egypt gama nehsoh hopnga-a hopkhat lakhom uhen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule amahon ahung lhung ding kum phaho sunga chang jouse chu khom khomu henlang, changho chu Pharaoh khutnoija kholuhen, chule amahon khopiho-a chun chang kholuhen.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule keljeh-a gamhi amanthah louna dinga, Egypt gama hung chuding kelhah kum sagi sunga dinga kigina-a, chang chu hiche gama dinga hi kholkhom ding ahi, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin hiche thuchu Pharaoh leh asohte mitmun aphalheh jengin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin Pharaoh'in asohte henga, Ama tobanga Pathen Lhagao asunga aumna mihem hi imu joumong diu hinam? ati.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chuin Pharaoh'in Joseph henga, Pathen'in hicheho jousehi nangma namusah jeh hin, nangma banga lungelthem le miching dang aumpoi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nangma ka-insung chunga vaipo-a napanding, chule nangma thupeh dungjuija kamite hi kivaipo diu ahi; Laltouna chungchanga hibou keima nangma sanga lenjo kahiding ahi, ati.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin Pharaoh'in Joseph henga, Ven, keiman nangma Egypt gam jouse chunga vaipo-a katun nahitai, ati.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chuin Pharaoh'in akhutna konin khutjem chu aladoh-in, Joseph khutna abupeh-in, chule tupat ponsil hoitah-in ajemin, sana ngong'o angonga a-o peh-in;
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule amachu akangtalai nei nilhina-a chun atousah-in; chule amasanga, Dilsuvin, tin asamun ahi. Chutichun aman Egypt gam pumpi chunga vaipon atungtan ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuin Pharaoh'in Joseph henga, Keimahi Pharaoh kahin, chule nangma thulouvin Egypt gam pumpi-a hin koimachan akhut hile akeng hileh lamthei ponte, ati.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chuin Pharaoh'in Joseph min chu Zaphnath-Paaneah asah in; On thempu Potiphera chanu Asenath chu aji dingin apen ahi. Chuin Joseph'in Egypt gam jouse agachonle tan ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Joseph Egypt lengpa Pharaoh angsunga adin chun kum somthum alhingtan ahi. Chuin Joseph Pharaoh henga konin apotnin, Egypt gam pumpi agachonsoh tan ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chuin kum sagi neh ninglhin sung chun leijin nengtah-in an asosah-in ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuin aman Egypt gamsunga kum sagi sungin chang jouse akhom khomin, khopi ho-a chun akholin ahi. Chule akimvela louho-a kona changho chu khopitina chun akhol khomin ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chuin Joseph'in chang chu twikhanglen'a neldi jat banghela tamin akhomin, simjouhoi ahitahlou jeh in, asimjong abang heltan ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chuin kel lhah kum ahunglhun masangin Joseph'in chapa ni aneijin, hichu On thempu Potiphera chanu Asenath'in ahinpeh ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin Joseph'in apeng masa chu Manasseh asah-in ahi. Ajehchu Pathen'in kahahsatna jouse le kapa insung jouse eisuhmil sahtai, ati.
  </para>
  <para style="p">
    <verse number="52" style="v" />Chuin ani lhinna chu amin Ephraim asahtai. Ajehchu Pathen'in kathoh gimna gamahin eipunsahtai, ati.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chuin Egypt gama neh lhinna kum sagi chu ahung kichaitai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chule Joseph'in aseibangin kellhah kum sagi chu ahung lhungtan; ahivangin Egypt gam pumpi-a chun neh aumin ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chuin Egypt gam jouse-a kel ahunglhah phatnin, miho chu Pharaoh lengpa henga neh thumin ahung tao taovin ahi. Chuin Pharaoh'in Egypt mite jouse henga chun, Joseph koma cheovin, aman naheng uva aseichu bolun, atitai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Chule kel chu leiset pumpi chunga alhatan ahi. Chuin Joseph'in chang kikhol khomna in jouse chu ahong doh-in, Egypt mite henga chun ajoh in; chule kel chu Egypt gama chun akhohlheh jengin ahi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Chuin kel chu gam jouse-a alhah nasat behset jeh in, gam jouse-a mihemte Egypt gama Joseph henga chun chang cho dingin ahungun ahi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Jacob'in Egypt gama chang aume, ti amuphat nin, Jacob'in achapate henga, Ipi dinga nakimoh vetto jengu ham? ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman, Veuvin, Egypt gama chang aume, ti kajai; thilouva ihindoh theina diuvin chua chun gachesuh unlang, eiho dingin chang gacho taovin, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Joseph sopi somho chu Egypt gama chang cho dingin achesuh taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahin Joseph naopa Benjamin vang chu Jacob'in asopiho chutoh asolthapoi; ajehchu aman, Ijemtin toset khat achunga chukhante, atin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Israel chapate chu adang ahungho chutoh lhonin chang cho dingin ahungtaove. Ajehchu Canaan gama chun kel alhatan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Joseph chu chuche gama chu gamvaipo-a panga ahitan, chule ama chuche gam mijouse henga chu chang joh-a panga ahitai. Chuin Joseph sopite chu ahungun, chule a-angsunga tolla chun aboh khupmun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Joseph'in asopite chu amun, chule amaho chu ahen; ahivangin aman amaho chu ahetlou bangin abolin, i-sah loutah-in ahouvin; chuin aman amaho henga, Hoija kona hung nahiuvem? ati. Chuin amahon, Canaan gama kona chang cho dinga hunga kahiuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Joseph'in asopite chu ahenan, ahivangin amahon amachu ahepouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Joseph'in amaho chungchang thua mang anamat chu ageldoh-in, chuin ahenguva, Nangho hi gam velhi nahiuve, gam agohkeova aumhi velhi dinga hung nahiuve, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amahon ahenga, Ahipoi, ka pakai, nasohte hi changcho dinga bou hunga kahi bouvui, atiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Keiho kabon chaovin mikhat chapate kahiuve; mi kitah kahiuvin, nasohte gamvelhi kahipouve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman amaho henga, Ahipoi, hiche agoh keova aum hi velhi dinga hunga nahiuve, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin amahon, Nasohte hi sopi somleni kahiuvin, Canaan gama mikhat chapate kahiuve; chule vetan, alhumpen chu tupet hin kapau toh aumin, khatvang aumtapoi, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Joseph'in ahenguva, Gamvelhi nahiuve, katichu nahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichea hi nangho kipatep ding nahiuve: Nasopi pao alhumpen chu hikoma hi ahung louleh, Pharaoh mina kahahsel nahiuve, nangho hikoma kona hi napotdoh loudingu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangho-a thutah aum aumlou nathusei uva kona photchet ahina dingin, nalah uva mikhat solunlang nanaopao chu hinpuihen, nangho vang songkul'a naum dingu ahi. Achuti louleh Pharaoh mina kahahsel nahiuve, nangho hi gam velhi nahi mongui, atitai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman amaho chu abonchauvin thakhatnin nithum ahentan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Joseph'in anithum chanin ahenguvah, Hichehi bolun lang hinnan neijun; ajehchu keiman Pathen kaginge, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangho hi mikitah nahiuleh, na-uchahou lah-a khatpen hitihin songkul'a umden hen: Nangho adangse na-in sunguva kelthohho ding chang kipoh unlang chetaovin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin nanao-u alhumpen chu kahenga hinpuijun; hitichun nathusei houchu photchetnin umintin, nangho nathiloudiu ahi, ati. Chuin amahon chutichun aboltauve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amaho khatnin khat henga, Tahbeh-in eiho inaopao thudol, aman eiho eingeh tun tun pettah uva alungsung hesoh je kimu khel khela, ingaipeh louvu chu ithemo lheh-ui, Hiche jeh-a chu hiche gentheina hi ichunguva chua ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Reuben'in amaho chu adonbutnin, Chapang chunga chun chonset bolhih-un tia kaseipehsa nahilouvu ham? Ahin nanghon kathusei nangai pouve; hiche jeh-a chu veuvin, athisan phu chu kingeh-a ahitai, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule akah uva Pao le aum jehchun, Joseph'in amaho thusei ahet chu amahon ahepouve.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ama amaho-a konin akihei mangin, akaptai; chuin ama ahenguva ahung kitnin, amaho chutoh akihouvin, chuin Simeon chu ahenguva konin akaijin, chuin amitmuva chun akantai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chujouvin Joseph'in adipmu chu chang sundimpeh dingle asum cheh-u chu adipcheh uva lekhum pehcheh dingin, chule lampi-a aneh dingu an agonpeh dingun thu apetan; chutichun amaho ding chun abolpeh tan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin achang houchu asangan hou apohsah-un, akipatdoh taove.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin alah uva khatnin agenau inna asangan an pedinga adipchu agah honleh, asumchu amutai; ajehchu, veovin, hichu adip kama chun ana umin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin aman asopite henga, Kasum ana kilekoi kit tai; Chule veuvin, kadipsung ahin ana ume, ati. Chuin amaho alungling laovun, akicha gamtaovin, Pathen'in ichunguva abolhi ipi ahitadem? akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin amaho Canaan gama apau Jacob heng ahung lhung taovin, chule achunguva thusoh jouse chu ama chu ahilun; ahenga hitin aseijun ahi,
  </para>
  <para style="p">
    <verse number="30" style="v" />Mipa, agam pakaipa chun huham tah-in eina houvun, chuche gam velhi danin einalaovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin keihon ahenga, Keiho mikitah tah te kahiuvin; gam velhi kahipouve,
  </para>
  <para style="p">
    <verse number="32" style="v" />Keiho sopi somleni kahiuvin, pakhat hinbou kahiuve; khatpa aumtapoi, alhumpen vang tupetnin Canaan gama kapau toh aume, katiuvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin chuche mipa, agam pakaipa chun kahenguva, Hichea hin nangho milungdih nahiu chu hethei jinge; nasopiteu lah-a khat kahenga dalhao vin, chule na-in sunguva kelthoh ho dingin chang kipoh unlang chetaovin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule nanao-u alhumpen chu kahenga hinpuijun: chutengle nangho gam velhi nahipouvin, ahin mikitah tah te nahiuve tichu heng kate. Chuteng nasopi pao lhadohpeh ungting, chule hiche gamahi nakivei dingu ahi, eitiuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin amahon adip mu alheilhah phatnun, ahitin ahi, veuvin, amitakip sum chun chu adip cheh-a ana umtan ahi. Chuin amaho leh apau chun asumchun hou amuphat nun, akicha lheh taovin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin apau Jacob chun ahenguva, Nangho hin kachate neichan sah-u ahitai; Joseph aumtapon, Simeon jong aumtapon, chule nanghon Benjamin jong puimang nagouve. Hicheng thil jousehin eilhunkhum ahitai, ati.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Reuben'in apa henga, Keiman amachu nakoma kahin puilutkit louleh kachapa teni hi that jengin; amachu kakhutna neipedoh-in, keiman ama chu nahenga hinle puikit nange, ati.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chuin aman, Kachapa hi nangho toh kilhona chesuh louhel ding ahi; ajehchu a-upa thia ahitan, ama changsehbou uma ahitai. Nachenao lamdunga achungah toset chutale, kasam kangsa hi lhankhuh-a lunghem puma napuisuh dingu ahi, ati.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hiche gama chun kel alha nasalheh jengtan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ahitin ahi, amahon Egypt gama kona ahinpoh-u chang chu anehjou phatnun, apauvin ahenguva, Chekitnun lang eihodin chang phabep gachouvin ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Judah'in ahenga, Mipa chun, Nanaopao chu nahin kilhonpi lou uleh kamai namu louhel dingu ahi, tin nasatah-in eigih-un ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman kanaopao hi keihotoh lhondinga nasolding vangle, keiho chesuh ungting, chang gachohpeh unge.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin amachu nasol louding vangleh, keiho chesuh pouvinge. Ajehchu mipa chun kahenguva, Nanaopao chu nahin kilhonpi lou uleh, kamai namu louheldiu ahi, ati ahi, tin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Israel'in, Ipidinga naokhat nanei nah laiju thu chu mipa chu nahin seipehkhel kheluva, hitobanga phalou tah-a hi neibolu ham? ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon, Mipa chun, napau damna laijam? Sopidang naneijum? tin keiho thudol le insung thudol eidoh doh jeng jeh uva, hiche akam chengho dungjuija chu ama kaseipeh-u ahi. Nanaopao hinpui suh-un, ati ding chu keihon ija kahet diu ham? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Judah'in apa Israel henga, Keiho le nangma, chule chapang sen hohi thilouva ahintheina diuvin chapang chu keimatoh neilhon sah-in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keima ama dingin kitung-ing kating, keima khut ngeija amachu ngeh-in: keiman ama nahenga kahin lepui louva, namasanga hi kadinsahkit louva ahileh mona chu kumkhon pojeng ing kate.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu keiho khongaisot louva hileuveng, tu-a hi nivei kile kitding kahiu ahitai, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin apau Israel'in ahenguva, Tun hichu hiding mong ahi tah le, hiche hi bolun; nadip uva hichegam thingga phapen phabepho, thingnailou phabep, khoiju phabep, thilnamtui, myrrh, beleilut, chule jonmot posuh unlang, chule mipa chu thilpeh-in peuvin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nakhut un dangka ajatnia tamin kenbeuvin, chule nadip uva dangka nahinlepoh kitnu jongchu kiken kitnuvin, mukhel jong hithei ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanaopao jong chu kipuijun, kipat doh-un lang, chuche mipa henga chun chekit taovin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule amapan nasopipa le Benjamin ahinlhadoh kit nadin, imajouse bolthei hat chungnung Pathen'in mipa masanga chun lungsetna napeu hen. Kachate chu kachantah jong leh kachan himaitante, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin miho chun thilpeh chu apouvin, dangka jatni apoh beuvin, chule Benjamin jong akipuijun; akipatnun, Egypt gama achesuh-un, Joseph anga chun ading kit taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Joseph'in Benjamin chu amaho chutoh amuphatnin, a-insung vetuppa henga, Hiche miho hi in'a puijin, sa thatnin lang, gotsan koijin; ajehchu miho khun sun le keima toh ankong a-umkhom dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin mipa chun Joseph thupeh bangchun abolin; miho chu Joseph in'a apuilut tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Joseph in'a apuilut jehchun, miho chu akicha taovin; chule amahon iche masah uva idipmuva dangka ana kikoijeh-a chu ichunguva agomkom ahola, ichunguva chua, eiho le isangan hou hi soh-a neiding eigotnuva eipuilutnu ahi, akitiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahon Joseph insung vetuppa chu ahin naijun, kotkhah bula chun amachu akihoulim piuvin,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amahon, Vo hepu, kahung masah chungu chun keiho chang choding monga hunga kahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ahitin ahi, keiho jinlhun in kalhun phatnun, kadipmuchu kahongun ahile, ka dangka cheh uchu kadipkam cheh uva chun ana umtan, ka dangkao chu agih lhingsetnin ana umtan ahi. Chule keihon hichu kahinpo kitnun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule chang choh nading dangka jong kahinpouvin, ahi. Kadip sunguva kadangkau chu kon anakoiham Kahepouve, atiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman, Lungmong tah-in umun, kicha hih-un; na Pathen'u chule napau Pathen chun nangho dinga nadip uva gou nakoipeh-u ahi; keiman nangho dangka kamunai, ati. Chuin Simeon chu ahenguva ahinpui doh-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin mipa chun amaho chu Joseph in'a apuilutnin, chuin amaho chu twi apen, amahon akengu akisilun; chule aman asangongsao hou jong an apen ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amahon chua changlhah anehdiu chu ajataovin, sunna Joseph ahung tengle peh ding chun thilpeh hochu agongtup mun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Joseph in'a ahung phatnin, akhutnuva um thilpeh chu insunga ahin choilutnun, chuin amaho tolla aboh khupmun, ama chu chibai aboh-un ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman amaho umchan chu adongin, Nanghon aumchan naseiju napau tehse chu damnam? amachu hing nalaijam? ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin amahon adonbut un, Nasohpa kapau chu adampet ahin, chule ahing nalainai, atiuve. Chuin amaho akunun, chibai abohkitnun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ama akhodah-in ahile, anaopa Benjamin, anu chapa chu amun; hichun aman, Hiche hi nanao-u alhumpen, aumchan kahenga naseipao chu ham? ati. Chuin aman, Kachapa, Pathen'in nalungset hen, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Joseph'in anaopa chu alung ase behseh-in, kikin notah-in kana ding mun aholtan; Chuin ama a-indan sunga alutnin, chua chun agakaptan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman amai akiphetnin, apotdoh kitnin, chuin ama akikham nahnah-in, Ankong semun, ati.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin amahon amading atumin, chule amahoding atumin, chule amatoh neh khompi Egypt miho ding chun atumin asemtaove. Ajehchu Egypt miho chun Hebrew miho toh an aneh khom ngailouvu ahi; ajehchu Egypt mite dinga hichu thet umtah ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin amaho apeng masapen chu a-upat hina dungjuijin, chule alhumpen chu achapan dungjuijin Joseph anga chun atousah taovin ahi. Chuin amaho chun kidang asalheh jengun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin ama-a konchun chanho chu alan ahenguva chun ahomin; ahin Benjamin chan chu amaho khat chan sangin chan nga in atamjon ahi. Chuin amahon adonun, amato akipahkhom taovin ahi.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman a-insung vetuppa chu thu apen, ajah-a, Amahon ajo chanuva apoh diuvin adip-u khu chang sundim peh-in, chule adangka cheh-u chu adip kamuva koipeh cheh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule kakhon, kadangka khon chu alhumpenpa dipkama achang man dangka chutoh koithan, ati. Chuin aman Joseph'in aseibang chun aboltan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin jing kho ahungvah vah-in, miho chu asangan hou toh asoldoh taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin amaho khopi-a kona achedoh uva gamlatah agei masangun, Joseph'in neichingpa henga chun, Kipat in lang miho chu delin, chule nangman amaho chu naphah tengle, ahenguva, Ipi dinga phatna chu setna-a nalethuh uham?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichea hi ka pakai pan adonji hilou hija, chule tahbeh-a hichehi agaochan naji chu hilouham? Hiche nabolu hi nangho nasuhkhelu ahitai, tin ahenguva gaseijin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman amaho chu adelpha tan, chule hiche thu mama chu ahenguva aseitan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin amahon ahenga, Ipi dinga ka pakaiyin hitobang thuhi naseiham? Nasohten chutobang aboldiu chu Pathen'in jada jenghen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vetan, kadip kamuva kamudoh-u dangka chu Canaan gama konin nahenga kahinlepoh kitnuve; achutile napakai pa in'a kona sana le dangka keihon iti kaguh diu ham?
  </para>
  <para style="p">
    <verse number="9" style="v" />Nasohte lah-a hin koihile namuna penpen chu, ama chu thijeng hen, chule keiho jeng jong ka pakai soh-in um jenguvinge, atiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, Tun nasei bangu chu himaihen: hiche kimuna penpa chu kasoh himai ding ahin; chule adangho vang themo chanda jenghen ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin amaho amitakipmin adipmu chu gangtah-in tolla akoilhauvin, amitakip chun adip cheh uchu ahong taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman alenpena apanin, alhumpen geijin akholtan ahile, khon chu Benjamin dipma chun amudohtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutah-in amahon avonhou chu asattelun, chule amitakip chun apotnu asangnu apohsah kitnun, khopi lama akilekit taove.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Judah le asopite chu Joseph'in ahung lhung taove; ajehchu ama chua chu umnalai ahi. Chuin amaho a-angsunga chun tolla abohkhup taove.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Joseph'in amaho henga, Hiche nathilbol uhi ipi nabolnao hitam? Keitobang mihin phun asan theije ti nahet lou uham? ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Judah'in ka pakai henga ipi kaseidingu hitam? keihon ipi seitaoving em? Ahilouleh keiho le keihon iti kaki seitheng diu hitam? Pathen'in nasohte khangitlouna hi amudoh ahitai. Vetan, keiho hi ka pakai sohte kahiu ahitai, keiho le khon kimudoh napa jonghi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman, chutobanga kaboldiu chu Pathen jahda hihen. Ahin khon akhutna kimudohna pa bouchu kasoh hiding ahin; nangho vang, lungmong tah-in kipat un lang napau henga chetaovin, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Judah'in akom ahin naijin, Vo ka pakai, nahenga katao ahi, nasoh hin ka pakai nahenga thucheng khat seijing ting, chule nalunghanna chu nasoh chunga hinkou dohsah hih-in; ajehchu nangma Pharaoh masap nahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka pakaiyin nasohte henga, Nanghon pa ahiloule nasopiu nanei nalai uvem? tin neina dongun;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin keihon ka pakai henga, Kapau tehse khat le ateh nunga ahin chapang sopi khat kaneijuve; chule a-upa vang athitan, chule anu chate lah-a amabou uma ahitan, apan amachu angailu lheh-e, kanatiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin nangman nasohte henga, Amachu kamitna kamunadin kahenga hinpui suh-un natin, ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin keihon ka pakai henga, Chapang chun apa dalhathei ponte, ajehchu aman apa dalha taleh, apa thijeng ding ahi, kanatiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin nangman nasohte henga, Nanao lhumpenu chu nang hotoh lhona ahungsuh louva ahile, nanghon kamai namukit loudiu ahi, nati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin nasoh kapau henga kakiletou kitphatnun ahitin ahi, Keihon ka pakai thusei jouse chu kaseipeh-un ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin kapau vin, Chekitnun lang eihoding chang phabep gachokitnun atin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin keihon, Keiho chesuhthei pouvinge, kanaopao alhumpen chutoh neilhonsah dinguleh keiho kachesuh dingu ahi: ajehchu kanaopao alhumpen chutoh kalhon lou uleh, mipa maichu kamu kitthei loudiu ahi, kanatiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin nasoh kapau chun kahenguva, Ka-inneipin chapa ni eihinpeh nanghon naheuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin khatpa chun eidalhatan, chule keiman thonlouva ahal hala kimaltel hitante, kanatin; chule keiman amachu chuche-a patchun kamutapon ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule nanghon ama jonghi keija konin puidoh unlang, achunga toset chutale, nanghon kasam kangsahi lunghem puma lhankhuh-a napuilut dingu ahi, atin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hijeh chun tun, keima hi nasoh kapau kom kalhunteng, chapang chu keihotoh umtahih leh, ahinkho chu chapangpa hinkho toh kikan khom ahijeh chun,
  </para>
  <para style="p">
    <verse number="31" style="v" />Hung hitiding ahi, aman chapang chu keihotoh kalhonkhom louvu chu amuteng, thitei ding ahitai. Chule nasohte hin, nasoh kapau sam kangsa chu lunghem puma lhankhuh-a kapuilut dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ajehchu nasoh hi kapau henga chapang dinga hungkitung kahin, ahenga, Nahenga kahin lepuikit louleh, kapa henga kumkhon themona pong kate, kanati ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hijeh chun tun, nahenga katao ahi, chapang khelchun keimahi ka pakai dingin nasoh-in umingting, chule chapanghi asopite toh chetaohen.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ajehchu chapang chu kalhonpi louleh, kapa koma iti kakiletou thei ding ham? Ajehchu kapa chunga hung chuding setna chu muget inge, ati.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Joseph akoma dingho angsunga chun ama le ama akikhamtang joutapon; chuin aman, Mijouse kakoma konin potdoh sah-un, tin asamtan ahi. Chuin Joseph ama le ama asopite henga akiphondoh chun, koimacha akoma aumpon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin ama hatah-in akaptan; chule Egypt mite le Pharaoh insung mite chun ajauvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Joseph'in asopite henga, keima Joseph kahi; kapa dam nalai nam? ati. Chuin asopite chun amachu adonbut thei pouvin; ajehchu amasanga chu lungdong gamu ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Joseph'in asopite henga, Katao ahi, kakom hinaijun ati. Chuin amahon ahin naijun ahi. Chuin aman keima nanaopao Joseph, Egypt gama najohdoh pao chu kahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun tun nanghon hikoma neinajoh jeh-uchun lungkham hih-un, ahilouleh nangho le nangho kilunghan hih un; ajehchu Pathen'in hinkho venbitna aumna dinga nangho masanga einasol ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu hiche kumni sunghin hiche gamahin kel alhatai: chule kumnga aum nalaijin, hiche sunga hi lou tuh le chang-at himhim umlou ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule leichunga hi nachilhah teo hongbit dingle, lhatdohna loupitah-a nahinkhou hoidoh sah dinga Pathen'in nama sang uva einasol ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun tun hikoma einasola chu nangho nahipouvin, Pathen joh ahibouve. Chule aman Pharaoh pa le a-insung jouse pakai ding, chule Egypt gam pumpi-a vaihom dingin eisemtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kino uvin, kapa koma cheovin lang, ahenga, Nachapa Joseph'in, Pathen'in Egypt gam pumpi-a pakaiyin eitung tai; kahenga hin hungsuh-in, hung geisang hih-in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nangma Goshen gama nachen ding, nangma le nachate, chateho, nakelngoi hon, nabonghon, chule nanei chengse puma keima kom naija naum ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman nangma chua chun vah-ing kate; ajehchu kumnga kel lhanalai ding ahi; achuti loule nangma le na-insung mite, chule nanei chengse vaichat na-a chugetnun nate, tin aseije gatiuvin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule, veuvin, keiman kakamtah-a naheng uva kasei ahi ti namit tah-u le kanao Benjamin mittah-in amutai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Egypt gama kaloupina jouse le nathil mu jouseu hi kapa naseipeh dingu; chule nanghon gangtah-a kapa chu hilama nahin puisuh diu ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman anau Benjamin chu angong koijin, akaptan; chule Benjamin'in jong angong koijin akaptan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuche chung chon chun asopite jouse chu achopmin, akakhumin ahi. Chujou chun asopite chun ama akihou limpi taovin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Joseph sopite ahunguve, ti thuthang chu Pharaoh'in ajah phatnin, Pharaoh le asohte chu akipah lheh-un ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pharaoh'in Joseph henga, Nasopite henga hitin seijin, Nanghon hitin bolun: nanghon nasangan houchu chang pohsah unlang, cheovin, Canaan gama kileuvin;
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule napau le na-insung miho hinpui junlang, kahenga hunguvin; keiman nangho Egypt gam phapen chu kapeh uva, chule nanghon chuche gamphapen ga chu naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tun nangma thu kapeh nahin, hichehi bolun: nachasenhou dingle, na-inneipite diuvin, Egypt gama konin kangtalai ho kilah-un, chule napau hinpuijun lang, hunguvin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chujongleh nathilkeo hou gelkhoh hih-un; ajehchu Egypt gam pumpi-a aphapen chu nangho-a ahi, tin aseijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Israel chaten chutichun aboltauvin; chule Pharaoh kamsoh dungjuijin, Joseph'in amaho chu kangtalai ho apen, lampi-a aneh dingu an jong apen ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman aboncha diuvin kikhelna ding ponsil apesoh keijin; ahin aman Benjamin vang chu dangka jathum le kikhelna ponsil to nga apen ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman apa henga hiche hohi athotnin ahi; Egypt gam thilphaho sangan som poh dimset le,lamjotna-a apan aneh ding chang, changlhah chule nehding sanganpi poh som dimset athotnin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutichun aman asopite chu asoltan, chule amaho akipatdoh taove. Chuin aman ahenguva, Lampia nakiboipa louna dingun kichih theijun, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amaho Egypt gama konin achetouvun, Canaan gama apau Jacob heng ahung lhung taove,
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin amahon ahenga, Joseph chu ahing nalaijin, chule Egypt gam pumpi-a gamvaipon apange, atiuve. Chuin Jacob lungphut akhongaijin ahi; ajehchu amaho chu atahsan lou ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin amahon Joseph'in ahenguva aseithu jouse chu aseipeh taovin ahi. Chuin ama akitolna dinga Joseph'in ahinthot kangtalai ho chu amuphatnin, apau Jacob lungthim ahung haldoh kittan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Israel'in, Aphaset tai; kachapa Joseph adam nalaije. Kathi-kah in cheng ting amachu gamunge, ati.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israel anei chengsetoh akipatnin, Beersheba ahung lhungin, chuin apa Isaac Pathen henga chun kilhaina gantha ho atoh-in ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin jana mu aneina-a Pathen'in Israel chu ahin houvin, ajah-a, Jacob, Jacob, atin ahi. Chuin aman, hikoma kaume, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman keimahi Pathen, napa Pathen chu kahi; Egypt gama chesuhding kicha hih-in: ajehchu chukoma chu keiman nangma nam lentah-a kasemding nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman nangma Egypt gamah kilhonsuh pingting, chule nangma kahin lepuikit teiding nahi; chule Joseph'in akhut tah-a namit ahin sinsah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Jacob Beersheba'a konin akipatdoh tai. Chuin Israel chapate chun apau Jacob chu achasen hou, chule a-inneipi teochu Pharaoh'in ama kitol nadinga ahinsol kangtalai ho-a chun atousah taovin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Jacob le achilhahte chun Canaan gama alamdoh-u aganchahou leh athilkeu hou chu akipoh-un, Egypt gam ahung lhung taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Achapate le atupate, Achanute le atunute, chule achilhahte chengse akipuijin, Egypt gam alutpitan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hicheng hi Egypt gama lut, Israel chate, Jacob le achapate minho chu ahiuve; Reuben, Jacob chapa lenpen ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Reuben chapate chu; Hanoch, Phallu, Hezron, chule Carmi ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Simeon chapate chu; Jemuel, Jamin, Ohad, Jachin, Johar, chule Canaan numei khat chapa Shaul ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Levi chapate chu; Gershom, Kohath chule Merari ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Judah chapate chu; Er, Onan, Shelah, Pharez chule Zerah ahiuvin; ahivangin Er le Onan chu Canaan gama athilhontan ahi. Chule Pharez chapate chu Hezron le Hamul ahilhone.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Issachar chapate chu; Tolla, Phuvah, Job, chule Shimron ahiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Zebulun chapate chu; Serad, Elon, chule Jahleel ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichenghi Leah chapate, achanu Dinah toh Padan-Aram gama Jacob ahinpehho chu ahiuve. Achapate le achanute agomin somthum le thum ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule Gad chapate chu; Ziphion chule Haggi, Shuni, Ezphon, Eri, Arodi, chule Areli ahiuve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Asher chapate chu; Jimnah, Ishuah, Ishui, Beriah, chule asopinu Sarah toh ahiuve. Chule Beriah chapateni chu Heber, Malchiel ahilhone.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichenghi Laban'in achanu Leah dinga apeh Zilpah chapate ahiuvin, hicheng ho hi amanun Jacob ahinpeh ahi; agoma mi somlegup ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jacob inneipi Rachel chapate chu; Joseph le Benjamin ahilhone.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Joseph chun Egypt gama achapa Manasseh le Ephraim ahingin, hichu On kho-a thempu, Potiphera chanu Asenath'in ahinpeh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Benjamin chapate chu; Belah, Becher, Ashbel, Gera, Naaman, Ehi, Rosh, Muppim, Huppim chule Ard ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hicheng hi Rachel'in Jacob dinga ahinpeh chapateho chu ahiuvin, abonchauvin mi somleli ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Dan chapa chu; Hushim ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Naphtali chapate chu; Jahzeel, Guni, Jezer, chule Shillem ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichengho hi Laban'in achanu Rachel dinga apeh Bilhah chapate chu ahiuvin, amanun hicheng hohi Jacob ahinpeh ahi; abonchauvin mi sagi ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jacob achapate inneipi teho tilouvin, Egypt gama Jacob toh lhonlut, ataiguija kondoh ho chu abonchauva mi somgup le gup ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Egypt gama penga Joseph chapa chu mini ahilhonin, Egypt gama pemlut insung mite jouse chu somsagi hiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Jacob'in Goshen gam lampi chu gahetoh dingin, Judah chu Joseph henga asolmasan; chuin amaho Goshen gam ahung lhung taovin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Joseph'in akangtalai akigotnin, Goshen gama apa Israel kimutopi dingin achetoutan, chuin ama le ama ahenga akiphongin ahi; chuin amachu angong koijin, angongkoi pumin sot thimtah akaptan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Israel'in Joseph henga, Tunvang dama nana umma, namai kamukit tahjeh-in, thi jong leng khoh kasatapoi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Joseph'in asopite le apa insung mite ho henga, Keima chetou vingting, Pharaoh kimuping ting, chule ahenga, Canaan gama cheng kasopite le kapa insungmite ho kaheng ahung lhung taove;
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule amaho natoh chu ganchavah ahin, chule kelngoi ching mi ahiuve; chule amahon akelngoihon uleh agancha honnu, chule anei jouseu ahinposoh keijun ahi, tin gasei ing kate.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule hung hiti ding ahi, Pharaoh'in nangho nakou uva, ipi natong mi nahiuvem? tia ahin dohteng leh,
  </para>
  <para style="p">
    <verse number="34" style="v" />Goshen gama nachen theina dinguva, nanghon, Nasohte hi kachapan nuva pat tuni geijahi keiho le kapateho ganchavah mi kahiuve, nati dingu, ahi. Ajehchu kelngoiching tapou chu Egypt mite dinga thet umtah ahi, tin aseije.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Joseph chu ahungin Pharaoh henga, Kapa le kasopite ho akelngoi hon nutoh, agancha hon nutoh, chule anei chengseutoh Canaan gama konin ahunguvin; chule, vetan, amaho Goshen gama aumuve, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin aman asopite lah-a konin mi nga apuijin, Pharaoh henga, aphongdoh-in ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pharaoh'in asopite henga chun, Nangho ipi natong mi nahiuvem? ati. Chuin amahon Pharaoh henga, Nasohte hi, keiho le kapu kapateu jong kelngoi ching mi kahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hicheng chungchon chun amahon Pharaoh henga, Hiche gama pemdinga hunga kahiuve; ajehchu Canaan gam kel akhoh behset jeh-in, nasohte kelngoihon nehding hampa aumtapoi: hijeh chun tun nasohte hi Goshen Gama neichen sah-un, tia nahenga kataovu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pharaoh'in Joseph henga, Napa le nasopite nahenga ahunguvin;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Egypt gam hi namasanga aume; napa le nasopite hi gampha pentah-a chensah in; Goshen gama chun chenguhen. Chule alah uva mi natong theitah nahet le, kagancha ho chunga thuneidin koijin, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Joseph'in apa Jacob ahin puilutnin, Pharaoh anga adinsah-in ahi. Chuin Jacob'in Pharaoh chu phatthei aboh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pharaoh'in Jacob henga, Kum ijat nahitah em? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Jacob'in Pharaoh henga, Kahinkho kakholjinna nikho hohi kum jakhat le kum somthum ahitai. Kadamsung kumhi lhomcha le hahsatah ahin, kapu kapate hinkho kholjin laisung kum ho jong aphajoupoi, atin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jacob'in Pharaoh phatthei aboh-in, Pharaoh angsunga konin achedohtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Joseph'in apa le asopite chu achensah-in, Pharaoh thupeh dungjuijin Egypt gamsunga, Rameses gam sunga mun phapen chu alodiuvin apetan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Joseph'in apa le asopite, chule apa insung mite jouse chu a-inko pumpiuvin changlhah in avahtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin gamsung pumpi-a chun nehding him him aumtapoi; ajehchu kelhah chu akhoh behseh jengtan, Egypt gam le Canaan gam pumpi-a chu keljeh chun alhasam lheh tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Joseph'in achang chohnao man chun Egypt gam le Canaan gama um sum jouse chu akhomsoh heltan ahi. Chuin Joseph'in sum chu Pharaoh in'a achoi luttan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Egypt gam le Canaan gama sum jouse chu akiman chaisoh phatnin, Egypt mite jouse chu Joseph henga ahungun, ajah-a, Nehding neipeuvin, ajehchu namitmu-a hi ipidinga kathi jeng dingu ham? ajehchu ka sum jouseu abeisoh heltai, atiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Joseph'in, nasum'u abeitah-a ahile na gancha hou neipeuvin, chule keiman nangho na gancha hou khelin nehding napenao vinge, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amahon agancha hou Joseph henga ahinpuijun: Joseph'in amaho chu sakol ho, kelngoiho, bongho chule sangan ho khel chun nehding apen ahi. Chuche kum chun agancha hou jouse man chun nehding apen avahtan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin chuche kum chu akichai phatnin, ama henga chun akum nina-in ahungun, ajah-a, Ka sum hou iti kaman chaiju ahi ka-pakaiya konin impou vinge; chule kagancha hou jouse jong ka-pakaiya ahitai. Katahsao leh kagam'u tilouvin, ka pakai mitmun imacha khen aumtapoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ipidinga namitmu-a keiho le kagam uhi kamantha jeng dingu ham? Nangman nehman dingin keiho le kagam'u hi neicho taovin, chule keiho le kagam uhi Pharaoh soh-in pang taovinge. Keiho thilouva kahin theina dingu le gamhi agohkeova aumlouna dingin muchi neipeuvin, ahungtiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Joseph'in Egypt gam pumpi chu Pharaoh dingin achotan ahi; ajehchu achunguva kel khohbeh seh tahjeh chun, Egypt mite jousen aloucheh-u ajohdoh taovin ahi. Chutichun gam chu Pharaoh'a ahisoh tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule miho vangchu, aman amaho chu Egypt gam ningkhat lama konin ning langkhat na um khopi ho-a chun akichon lutsah tan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aman thempuho gam chubou achopon ahi; ajehchu thempuho chun Pharaoh'a konin chantum aneijun, chule Pharaoh'in apeh-u chan chu aneh-u ahi. Hijeh chun amahon agamu chu akijoh pouvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chujouvin Joseph'in miho henga chun, Veuvin, tunia hi keiman nangho le nagamu hi Pharaoh dinga kachohdoh ahitai. Veovin, hikomahin nangho ding muchi aumin, chule nanghon hichu leija natu dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule chang atphat teng hitiding ahi, hopnga-a hopkhat chu Pharaoh napeh uva, hopnga-a hopli chu nangho nachan diu, hichu louva muchiding, nangho le na-insung miteu nehding le, nachasen hou dinga nehding hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin amahon, Nangman kahinkhou nahuhhing ahitai; ka pakai mitmun lungsetna neimusah-un, chule keiho Pharaoh soh hitaovinge, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Joseph'in, Pharaoh'in hopnga-a hopkhat achandinga dan asem chu Egypt gama dingin tunichan geihin chona danin aumtan ahi. Thempuho gam bouchu Pharaoh'a ahipon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Israel chu Egypt gamsung, Goshen gama chun achengtan; chule hia chun amahon gou akholdoh-un, chi tamtah akhaijun, nasatah-in apung taovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Jacob Egypt gama chun kum som le kum sagi ahingin ahi. Chuti chun Jacob damsung hinkho chu kum jakhat le kum somli le kum sagi ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Israel thina ding phat ahung naitan ahi. Chuin aman achapa Joseph chu akouvin, ajah-a, Tuahi namitmu-a lungsetna kachana ahile, nahenga katao ahi, nakhut chu kapheipi noija hinkoijin lang, lungset le thutah-in kachunga natongin; katao ahi, Egypt gama hin neihin vuihih-in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahin kapu kapate toh neilupkhom sah-in; Egypt gama kona hin neipuidoh inlang, akivuinao mun'a chun neivuijin, ati. Chuin aman, Nasei banga kabol ding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman, Kahenga kihahsel in, ati. Chuin ama ahenga akihahseltai. Chuin Israel ajalkhun lulhunna chun akunin ahi.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin hicheng jouse nunghin ahitin ahi, Joseph henga, Vetan, napa anai atipeh-un ahi. Chuin aman achapa teni Manasseh le Ephraim akipuijin achetan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Jacob henga, Vetan, nachapa Joseph nahenga ahunge, atipeh-un ahi. Chuin Israel ama le ama akiha bolin, jalkhun chunga chun atouvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Jacob'in Joseph henga, Imajouse bolthei Pathen hat chungnung chu Canaan gama Luz mun'a chun kahenga ahung kilah in, phatthei eiboh-in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule kahenga, Vetan, keiman nangma chi tamtah khaisah ingting, kapunsah ding, chule keiman nangma vaipi tamtah kahisah ding; chule hiche gamhi nanunga nachilhahte dinga tonsotna agou dinguva kapeh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule tun Egypt gama nahenga kahung masanga Egypt gama nanei, nachapa teni Ephraim le Manasseh hi keija ahilhone. Reuben le Simeon keija ahibanga, amani hi keija hiding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amani nunga cha le nao nanei vang chu nangma mi hitantin, amaho chu asopite gou le minlah-a kisimtha nante.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule keima vang, Padan-Aram'a kona kahung chun Rachel chu Canaan gama Ephrath phah nading gamla thim avat nalaijin, lamdunga ka-angsunga athitan ahi. Chuin keiman Ephrath lamdunga chun kavuitan ahi; Hichu Bethlehem chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Israel chun Joseph chapateni chu aven, Amani hi koi hilhon ham? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Joseph'in apa henga, Amani hi hiche mun'a Pathen'in eipeh kachapa teni ahilhone, ati. Chuin aman nahenga katao ahi, kahenga hinpuijin, chule keiman amani vangboh ingkate, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun Israel chu atehjeh-in amit athimtan, kho amuthei tapon ahi. Chuin Joseph'in amani chu ahenga ahinpui naijin; chuin aman amani chu achopmin, apomtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Israel'in Joseph henga, Namel muding kana gelphah lou ahitan; ahin vetan, Pathen'in nachilhah kisan eimusahtai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Joseph'in amani chu apa pheichunga konin apuidoh'in, amatah chu tolla aboh khupmin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Joseph'in anilhon chun akaijin, Ephraim chu akhut jetlamin Israel khut veilam, chule Manasseh chu akhut veilamin Israel khut jetlama ahin kaijin, ahenga ahinpui naijin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Israel'in akhut jetlam ahin lhang doh-in, aneojopa Ephraim lu chunga chun angamin ahi, chule akhut veilama chu Manasseh lu chunga angamin, akhut chu henasan ajam pelin ahi; ajehchu Manasseh chu apeng masa ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman Joseph chu phatthei aboh-in, kapute kapa, Abraham le Isaac namasanga anavale nalhon Pathen, kahinkho lhumkeija, tuni nikho geija eihin ching jinga Pathen,
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil gilou tinchenga kona eina huhdoh jing vantil chun, chapang teni hi phatthei hinboh hen; chule amani chunga hin keima min, kapu kapa Abraham le kapa Isaac min hinpu lhonhen; chujong le amani hi leiset vaipi jalah-a mipi atama tamin hung punglhon hen ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Joseph'in apan akhut jetlam Ephraim luchunga angap chu amuphatnin, alung phamotan ahi. Chuin aman apa khut chu Ephraim lu-a kona Manasseh lu-a chon dingin atuh-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Joseph'in apa henga, Chutiponte, kapa; ajehchu hiche pahi apeng masa ahin, nakhut jetlam chu alu chunga koijin, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin apa chu anom pon, Keiman kahenai, chapa, keiman kahenai; amajong namkhat hunghi ding, chule amajong lending ahinai. Amavang tahbeh-a anaopa johhi ama sanga hunglen joding, achilhahte chu nam tamtah hung hiding ahiuve, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman chuche nichun amani chu phatthei aboh-in, Nangni min pana Israel'in Phatthei abohding, Pathen'in nangma Ephraim le Manasseh bangin nasem hen, ati dingu ahi, atin; aman Ephraim chu Manasseh masanga akoitan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Israel'in Joseph henga, vetan, keima kathiding ahitai. Hijongle Pathen'in nangma naumpi jing ding, chule aman nangma napu napate gamsunga nahin lepui kitding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuche chung chon chun Amor mite-a kona kachemjam le kathalpi-a kona kaladoh chu, keiman nangma nasopite chan sangin tamin chan khat kapehben ahi ati.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Jacob'in achapate chu akouvin, ahenguva, Ninunung nile nachung uva ipi hung chuding ham tichu kaseipeh theina dingun, hung kikhom khomun, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho Jacob chapate, hung kikhom khomun lang ngaijun; napau Israel thusei hi ngai phaovin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Reuben nangma kachapa lenpen nahin, kathilbol theina, chule kathahat kipatna, kichoisang na chungnung pen le thahatna chungnung pen chu nahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Twisih banga dingdetlou nahin, nangma achung nungpen nahilou ding ahi, ajehchu nangma napa jalkhuna nakaldoh-in, nasuboh-in ahi: ama kalupna-a akaldoh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon le Levi ucha ahilhonin; hunam galvon ho chu amani chena-a aumin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo kalhagao, nangma amani thuguh-a chun hunglut hih-in; vo kaloupina, amani kiloikhomna-a chun lha hih-in. Ijeh inem itile alunghan nalam lhonin mi athat lhonin, chule a-engset nalam lhonin bongchal ho asatbai lhonin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Alunghana lhon chu kichat umtah ahijeh le, alungsatna lhon chu phaloutah ahijehchun gaosap hihen. Keiman amani Jacob sunga homkhen ningting, Israel lah-a kathecheh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah nangma nasopiten avahchoi dingu chu nahi; nakhut chu namelmate ngonga umding; napa chate chu na angsunga kundiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah hi keipi bahkai nou ahi; kachapa nasamat na-a konin nakaltou tan ahi. Ama abohmat depmin, keipi bahkai bangle keipi bahkai teh bangin akolin ahi; koiham asuthou dinga?
  </para>
  <para style="p">
    <verse number="10" style="v" />Lal tenggol chu Judah'a konin kichon mang pontin, chule danpe- jong akeng kah-a konin kichon mang ponte, Shiloh ahung masangsen; chule ama henga namtin kikhop khomna umding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Asangan lengpi guija ahenin, asangan nou chu lengpigui phatah-a ahenin, aman avonho chu lengpitwija asopmin, chule apon chu lengpitwi thisanin asopmin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amit chu lengpitwi sangin asan jon, chule aha chu bongnoi sangin abang jon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zebulun chu twikhanglen kama chengding; chule amachu kongho dinga ngahmun hung hiding; chule agamgi chu Sidon toh kijopmat ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Issachar hi sangan hattah, pohgih tah ni kah-a boh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman acholngah namun chu aphan, chule gamchu anome, ti amun; hijeh chun aman thilgih pudingin alengkou anemsah-in, hunama natohna mun'a soh ahung hitan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dan hin Israel phung ho lah-a khat banga amite chu vai ahom ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan hi lampi pama gul, lampi laija gulse, achunga toupa akinung lelhahna khopma sakol nungkeng chua hiding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vo Pakai, nami huhhingna chu kangah jinge.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gad hi gal mihon ajoding ahin; ahivangin akhon nale aman ale joding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asher'a kona aneh phading ahin, chule aman lengho anneh tuitah tahho aso sah ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naphtali hi sajuhpi kilhaso ahin; aman thupha tah ho aseijin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph hi aga phatah thingbah chu ahin, twikhuh panga aga phatah thingbah ngei chu ahi; abahho chun bang ajamkhup mun ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thalpi kap ho chun ama nasatah-in asugentheijun, akap uvin, chule ahotbolun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahivangin athalpi chu long louvin athahat jingin, chule akhut banthaho chu imajouse bolthei Jacob Pathen'in ahatsah-in, (Chua kon chun Kelngoi ching, Israel songpi chu hung uma ahi:)
  </para>
  <para style="p">
    <verse number="25" style="v" />Nakithopi dinga napa Pathen, chule phatthei naboh ding imajouse bolthei hat chungnung chun, chung van'a kona phattheina ho-a, noilanga thutah-a um phattheina ho, chule ang le naobu phattheina ho-a nahatsah ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Napa phattheina ho hin kapu kapate phatthei naho chu tonsot lhangho khodong geijin akhupjon ahi. Hiho chu Joseph luchunga umding, chule asopite-a kona kikhendohpa lujanga chu umding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Benjamin ngei banga nehpap ahin: jingkah le asamat chu aneh-a, chule nilhah le athilchom chu ahopkhen ding ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hicheng jouse hi Israel phung som le phung ni chu ahiuve. Chule hiche hi apauvin amaho phatthei aboh-a, ahenguva aseichu ahin; amatoh kitoh phatthei bohna-a khatcheh-a phatthei aboh ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin aman amaho chu athulhah-in ahenguva, Kamite toh puikhoma umding kahitai. Hit mi Ephron louva songkoa chun kapu kapate lah-a neivuijun;
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiche songko chu Canaan gama Mamre koma Machpelah louva um ahin, alou muntoh goma Abraham'in Hit mi Ephron'a kona kivuina mun'a neidinga ana choh ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chukoma chun amahon Abraham le a-inneipi Sarah chu anavuijun, Isaac le a-inneipi Rebekah jong avuijun; chule chua chun keiman Leah kana vuijin ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aloumun le asunga um songko chu Heth chate ho-a kona ana kichoa ahi, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Jacob'in achapate chu athupeh jouvin, akeng jalkhuna asep doh in, alhagao alhan, chule amite toh gopkhomin aumtan ahi.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Joseph'in apa mai le amai asuton, akapmin, achopmin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Joseph'in apa long chu monthei louva asemna diuvin asohte louthem ho chu thu apen ahi. Chuin louthem ho chun Israel chu Amon theilou dingin asemtaovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin ama chunga chun nisomli alutnun ahi; ajehchu amon louna dinga kisem miho ding chun ni chujatchu lutji-a ahi. Chuin Egypt mite chun amachu ni somsagi a-opmuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin ama a-opnau nikho ho chu akichai phatnin, Joseph Pharaoh insung mite henga chun, Tu-a hi namit muva lungsetna kachana ahile, lungset tah-in Pharaoh henga hitin neisei peh-un;
  </para>
  <para style="p">
    <verse number="5" style="v" />Kapan eikihahsel sah-in, kahenga, Vetan, keima athiding kon kahitan; Canaan gama keiman keimatah dinga kasemsa lhana chu neivuiding ahi, ati. Hijeh chun tun nahenga katao ahi, kapa vuidingin neiche tousah-in, chujouleh hungkit tange, ati, tin neisei peh-un, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pharaoh'in, Aman nangma nakihahsel sah bang chun chetouvin lang, napa chu gavuitan, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Joseph apa vuidingin achetoutan; chule Pharaoh sohte jouse, a-insunga upaho, chule Egypt gamsunga upaho jouse ama toh alhonun,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Joseph insung mite jouse, asopiteho, chule apa insung miho chu amatoh achetou khomun ahi. Achasen hou, akelngoihon hou, chule abonghon ho bou Goshen gama adalhauvin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin amachu sakol kangtalai ho leh sakol chunga tou mihon akilhon piuvin, chule amaho chu tamtah ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amaho Jordan luigala Atad chang chilna pholmun alhung taovin, chule amaho chua chun lhasetah-in akapmun ahi. Chuin aman nisagi sungin apa puldouna abolin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin chuche gama cheng Canaan miho chun Atad chang chilna phola thi-opna chu amuphatnun, Hiche hi Egypt mite dinga lunghemna nasatah ahi, atiuvin; hiche jehchun chuche munchu Abel-mizraim asahtaove; hichu Jordan luigala um ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin achapate chun ama thulhah bangtah-in abolpeh taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajehchu achapaten ama chu Canaan gama apolutnun, Abraham'in kivuina dinga Hit mi Ephron koma aloumun toh achohtha, Mamre koma Machpela louva songkoa chun avuitaovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Joseph'in apa avuijou chun asopite toh, apa vuidinga akilhonpi chengse toh, Egypt gama akilekit taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Joseph asopite chun apau thichu amuphatnun, Joseph hin ijemtin eivetdao vintin, thil gilouho achunga inabolu chu lethuhding hin ngaito theijinte, akitiuvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin amahon Joseph henga thupokhat asolun, hitin aseijuve, Napan athi masangin hiche thulhah hi anadalhan ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Hitia hi Joseph henga nasei dingu ahi, Nahenga katao ahi, nasopite suhkhelna le achonsetnao ngaidamin; ajehchu amahon nachunga thilgilou anaboltaove, tin aseije. Chule tun nahenga kataovu ahi, Napa Pathen sohteho suhkhelna chu ngaidamtan, atiuvin ahi. Chuin amahon ahenga hichu aseiphatnun Joseph akaptan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin asopite jong chu ahungun, a-angsunga abohkhup jengun; ajah-a, Vetan, keiho hi nasohte kahiuve, atiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Joseph'in ahenguva, Kicha hih-un: ajehchu keima Pathen khela kitung kahi mongem?
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin nangho vangin kachunga hi thilgilou bol nagotnu anahin; ahinla hichu Pathen'in tunikho-a bang ngeija hi mitamtah hinkho huhdoh-a aumna dinga apha dinga anagot ahijoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hijeh chun tun, kicha hih-un; keiman nangho le nachasenhou vahnang kate, ati. Chuin aman amaho chu alhamonin, damheochan ahouvin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Joseph chu ama le apa inkote toh Egypt gama chun achengun ahi. Chule Joseph chu kum jakhat le kum som ahingin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Joseph chun Ephraim chate akhang thum lhinna tuson thum chan amu manin ahi. Chule Manasseh chapa Machir chateho jong Joseph pheichunga aseilenun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Joseph'in asopite henga, Kathiding ahitai; ahin Pathen'in nahungvil tei dingu ahin, hiche gama kona hi napui doh uva, Abraham, Isaac chule Jacob henga ana kihahselna gama chu napui tei dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Joseph'in Israel chate chu akihahsel sah-in, Pathen'in thonlouva nahung vil dingu ahin, chutengle kagu hohi hia konahi napoh tou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitichun Joseph chu kum jakhat le kum som alhinin athitan ahi. Chuin amahon along chu amonthei louna din asemun, Egypt gamsunga thikong sunga akoitaove.
  </para>
</usx>
