<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1JN" style="id">1 John</book>
  <para style="h">1 John</para>
  <para style="toc1">1 John</para>
  <para style="toc2">1 John</para>
  <para style="mt">1 John</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atil abula patna umsa jing, kana-a kajah-u, kamittah uva kanamu-u, kanavetnu, chule kakhut tah uva kathamu, hinna thu chu;
  </para>
  <para style="p">
    <verse number="2" style="v" />(Ajehchu hiche hinna chu hung kiphonga ahin, chule keihon kamuvin, kahettohsah-un, chule chuche tonsot hin kemlou, Pa koma um, keiho henga hung kiphonga chu nangho kamusah nahiuve);
  </para>
  <para style="p">
    <verse number="3" style="v" />Henge, keihon kamusa chengseole kajahsa chengseu chu, nangho jong keihotoh ikiloi theina dinguva nangho henga kaphondoh-u ahi; chule tahbeh-a keiho kiloikhomna hi Pa toh, chule Achapa Jesu Christa toh kiloikhomna hija ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nakipanao achamkim theina dinga hicheng hi kahinsut ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Keihon ama-a kona kajah-u nangho kahilsonu chu hiche hi ahi, Pathen chu vah ahi, ama-a chu muthim himhim um louhel ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amatoh kiloi kahi itiuva muthima ivaleu vangle, thujou sei ihiu ahin, chule thutah chu nit lou ihiuve;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama vah-a aum banga eiho jong vah-a chu ivaleu vangle, khat le khat kiloikhom ihiu ahin, chule Achapa Jesu Christa thisan chun chonsetna jouse-a kona eisilngimu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Eihon chonsetna kaneipoi itiuva ahile, eimale eima kilhem lha-a ihiu ahi, chule thutah chu isunguva umlou ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eihon ichonsetnao iphon vangule, ama chu eiho chonsetna chengse ngaidam dingle chonphat louna jouse siltheng dinga tahsan umtah chule chonphatah ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Eihon chonsetna kaneipoi itiuva ahile, ama chu ijousah-u ahin, chule athu chu isunguva umlou ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kachateho, nachonset louna dinguva hicheng hi naheng uva kahinsut ahi. Chule khattou chonse jeng tajongle, Pa anga eihuva eisei champeh chonphatah Jesu Christa chu ineinaove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama chu eiho chonset thoidamna ahi; eihoa ding jengseh hilouva, vannoi chonset jouse-a ding jong ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule eiho ama thu nit ihiule, hichu ama ihetaove ti hetna ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman ama chu kahetaila tia athupeh nit lou chu mijou ahin, asunga thutah umlou ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama thu nit vang chu Pathen ngailutna chu asunga tahbeh-a chamkima ahitan: hichea kon chun ama-a um kahi ti iheuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keima ama-a um kahi tia chu, ama chon bang banga ama jong chon ding dol ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sopiteho, keiman nangho henga thupeh thah kahinsut ahipoi, atil abula nanghon najahsao thupeh lui chu kahinsut joh ahibouve; atil abula kona najah-u chu hiche thupeh lui hi ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule thupeh thah jong kahinsune, hiche hi ama-a chule nangho-a jong thutah ahi; ajeh chu muthim abeikon ahitai; khovah dihtah chu hung vah pan ahitai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keima khovah-a uma kahi tia asopi ho-a chu muthima umnalai ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Asopi ngailu-a chu khovah-a uma ahi, ama sunga chu kipal lhuhna imacha umlou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Asopi ho-a vang chu muthima uma ahin, muthima vahlea ahin, chule achena ding hoilam ahi ahepoi; ajeh chu muthim chun amitchohsah ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kachateho, ama min vanga chu nachonset nao ngaidama uma ahitai; hiche jeh-a chu naheng uva kahinsut ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo Pateho, nanghon atil abula patna anaumpa chu nahet jeh uva naheng uva kahinsut ahi. Khangdongho, nangho agilouva chu nanehjou jeh uva kahinsut ahi. Chapangho, nanghon Pa chu nahet tah jeh uva naheng uva kahinsut ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pateho, nanghon atil abula patna anaumpa chu nahet jeh uva naheng uva kahinsut ahi. Khangdongho, nangho athahat nahiuvin, nasunguva Pathen thu chu chenga ahin, chule nanghon agilou chu nanehjou tah jeh uva naheng uva kahinsut ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nanghon vannoi leiset le vannoi leiset lam dol thil chengse ngailu hihhelun. Koi hile vannoi leiset ngailu-a chu alung sunga Pa ngailutna cheng lou ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajeh chu vannoi'a umho jouse: tahsa lam ngaichat, mitvet deichat, hinkho kiletsah, hicheng hi Pa-a kona ahipoi, vannoi'a kona ahibouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vannoi leiset le athil ngaichat mangthah ding kon ahitai; ahin Pathen lung lama chonpa chu imatih chana umjing ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chapangneoho, ni nunung lam ahitai; Christa dou hung dingkon ahitai tia kisei najah bangu chun, tutah jeng jong hin Christa dou tamtah asohdohtai; hichea kon hin ni nunung ahitai ti iheuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amaho chu eiho lah-a konin apotdoh taove, ahin eihotoh ikimatnao aumpoi; eihotoh kimatna neija hileu eiho koma umding ahiuve: ahinla eihotoh kimatna anei louvu chu kiphon dohna dinga, amaho chu potdoh ahitaove.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahin nangho vang Athengpa thao nu chu nahiuvin, ijakai hesohkei nahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nanghon thutah chu nahepouve tia naheng uva kahinsut ahipoi; thutah nahet jeh uva, thujou chu thutah-a kon ahipoi tina-a kahinsut joh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Jesu chu Christa ahi ti janom louva seilep kalvala jou seija koiham? Pa le Chapa janom louva chu Christa dou ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chapa jada-a chun Pa chu anei loulai ahi; Chapa janoma vang chun Pa jong chu anei ahitai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Atil abula nanghon thu najahsa chengseu chu nalung sunguvah chenghen. Atil abula patna nathu jahsa chengseu chu nalung sunguva achena ahile, nangho jong Pa leh Chapa-a chu um jinga nahi dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichu amatah-in eiho eithu tepnao athutep tonsot hin kemlou chu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangho nalhem lhaji hou thudola keiman hicheng hi kahinsut ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangho vang ama-a kona thao nu nachanu chu nasunguva achengin; min nahil dingu nangai pouve: ahin hiche thaonu mama chun imalam jouse thudol, thujou hilouva thutah nahil jeh-u chun, aman nahil dungjuijun, nangho ama-ah umdet jingun.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule tun, kachateho, ama ahung kilah teng kisonna ineijuva, chule ama ahung tengle amasanga ijachat louna dingun, ama-a um jingun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ama chonphatah ahi chu nahetnuva ahile, koi hile chonphatna lama chonpa chu ama-a kona pengdoh ahi ti naheuve.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veuvin, Pan eingailutjeu hi itobang hitam, Pathen chapate tia kikou dinga i-um jenguhi! hiche jeh-a chu vannoi'in eiho eihet louvu ahi, hichu ama ahetlou jeh-u ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngaiteho, tun eiho Pathen chate ihiuve; chule ipi ihung hi dingu tun akiphongdoh hih laije. Ama ahung kilah tengle, eiho ama bangbang ihi dingu ahi ti chu eihon iheuve; ajeh chu ama aum bangbanga chu imu dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule koi hile ama-a kinem chu ama athen banga ama jong chu kisuthenga ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Koi hile achonsea chu danthu sukeh ahi; ajehchu danthu suhkeh chu chonset ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule chonset pomang dinga ama hung kilahdoh ahi ti nanghon naheuve; chule ama-a chu chonset beihel ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Koi hile ama-a uma chun chonset abolji poi: koi hile achonsejia chu ama mu loulai, chule he loulai ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kachateho, koima dohan lha hihhelun; ama chonpha ahibanga koi hile chonphat bola chu chonpha ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chonset bola chu diabol'a ahi; ajeh chu diabol chun atil abula pat chonset abol ahi. Diabol natohho jouse sumang dinga Pathen Chapa hung kilah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koi hile Pathen'a kona penga chun chonset abolji poi, ajehchu amuchi asunga uma ahi: chujongle ama chu Pathen'a kona peng ahi jeh chun achonse thei poi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichea kon hin Pathen chate le diabol chate akilangdoh jin ahi: koi hile chonphat bollou chu Pathen'a kon ahipon, chule asopi ngailulou jongchu Pathen'a kon ahipoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu atil abula nathu jahsao chu hiche hi ahi, Eiho khatle khat ikingailutto cheh dingdolu ahi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Agiloupa-a kon hungkondoh asopipa thatna Cain tobanga chu hilouvin. Ama chu ipi jeh-a athaham? Ama thilbol chengse aphalou jeng ahia, asopipa thilbol chengse chonphatna ahi jeh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sopiteho, vannoi'in nahot uva ahile hichu kidang sahih-un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ijeh inem itile isopi teu ingailut jeh-uva thina-a kona hinna-a galkaija ihitaove ti iheuve. Asopi ngailu lou chu thina-a umjing nalai ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koi hile asopi ho-a chu tolthat ahi; tolthat lungsunga tonsot hin kemlou achengpoi ti naheuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman eiho dinga ahinna apeh jenga kona hi eihon Pathen ngailutna ihetnu ahi; chule eihon jong isopiho dinga ihinnao ipeh dingdolu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahin mi khattou leiset thilin ninglhing hen, ama chun asopi lhahsam muhen, khoto louvin umle, ama lung sunga chu Pathen ngailutna iti umding ham?
  </para>
  <para style="p">
    <verse number="18" style="v" />Kachateho, khaije, eihon thu jengle kamsung keo jenga hilouvin, natohle thutah-in ngailu uhite.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichea kona chu eiho thutah-a kon iheu ihet dingu ahin, chujongle ama angsunga ilungu kinem jinga umding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ajeh chu ilungun eiho eithemmo sah uva ahi jongle, Pathen chu eiho lung sanga chungnungjo ahin, chule ijakai ahesoh-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngaiteho, ilungun eiho eithemmosah lou uva ahile, eihon Pathen lama lung ngamna ineiju ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule eihon athupeh initnuva, amitmua alung deilam jeng ibol jeh uve, ipi hijongle ithumu chu ama-a kona imu-u ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Athupeh chu hiche hi ahi, eiho Achapa Jesu Christa min itahsan uva, chule aman eiho eithupeh banguva khatle khat ikingailut dingu hi ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule koi hile ama thupeh nit chu ama-a uma, chule ama jong ama-a chu uma ahi. Chule aman eipeh-u Lhagaova chun ama eiho-a aume ti iheuve.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngaiteho, nanghon lhagao tapou tahsan hih-un; ahin amaho chu Pathen'a kon ahi ahilou hettohna dingin, lhagaoho chu kholtoh-in patep jiuvin; ajeh chu vannoi leiset chungah themgao lhem tamtah asohdoh tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichea hi nanghon Pathen Lhagao chu nahet dingu ahi; Jesu Christa chu tahsa-a hunga ahi ti janoma lhagao chu Pathen'a kon ahi:
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Jesu chu tahsa-a hunga ahi ti janomlou jouse chu Pathen'a kon hilou ahi: hichu hungding ahi tia najahsao Christa dou lhagao ahi; chule tu-a jonghi vannoi'a uma ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kachateho, nangho Pathen'a kon nahiu ahin, chule hitiho chu nanehjouvu ahitai; ajeh chu nangho-a umpa chu vannoi'a umpa sanga chungnungjo ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho chu vannoi'a kon ahiuve: hijeh-a chu vannoi thu aseiju ahin, chule vannoi'in amaho thu chu angaiju ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Eiho Pathen'a kon ihiuve: Pathen he-a chun eiho thu angai ahi; Pathen'a kon hilou chun eiho thu angailou ahi. Hichea konahi eihon lhagao dihle lhagao dihlou ihet khen theiju ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngaiteho, eiho khatle khat kingailutou hite: ijeh inem itile ngailut chu Pathen'a kon ahi; koi hile ngailutna neichan chu Pathen'a kona peng ahin, chule Pathen ahet ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngailutna neilou chun Pathen ahetlou ahi; ajeh iham itile Pathen chu ngailut ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichea konahi Pathen mingailut eihoa kiphonga ahi, ama vanga eiho ihin theina dinguva, Pathen'in Achapa changkhat chu vannoi'a ahinsol ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichea hi ngailut uma ahi, eihon Pathen chu ingailutnu ahipon, ama joh-in eingailut uva, chule Achapa chu eiho chonset thoidamna dinga ahinsol ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngaiteho, Pathen'in chutia chu eingailut uva ahile, eiho jong khatle khat ikingailut ding dolu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen chu koiman imatih chanin amukhapoi. Eiho khatle khat ikingailut touva ahile, Pathen eihoa uma ahin, chule angailutna chu eihoa chamkima ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichea kona hi eihon eiho ama-a um ihiu, chule ama eihoa um ahi chu ihetnu ahi; Aman ama Lhagao eipeh tah jeh-u chun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Pa chun Chapa chu vannoi huhhing-a ahinsol ahi ti keihon kamuva kahettoh sah-u ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koi hijongle Jesu chu Pathen Chapa ahi ti phongdoh-a chu, Pathen ama-a chu uma, ama Pathen'a uma ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathen'in eiho-a ngailutna anei hi eihon ihetnuva chule itahsanu ahitai. Pathen chu ngailut ahi; chule ngailutna-a uma chu Pathen'a uma ahin, chule Pathen ama-a chu uma ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thupi tan nile eiho ihakat theina dinguva, hichea kona hi ingailutnao kisuchamkim ahi: ajeh chu ama um banga, eiho hiche vannoi'a hi i-umu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngailutna-a kichatna aumpoi; amavang ngailut chamkim chun kichat anodohjin ahi: ajehchu kichatna chun talen matding anei ahi. Akicha-a chu ngailutna-a chamkim lou ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman eingailut masah jeh uva eihon ama ingailutnu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khattouvin, Keiman Pathen kangailui tihen asopi hotale, ama chu mijou ahi: ajeh chu amusa jing asopi bon ngailu lou chun, amukhah louhel Pathen chu iti angailut dingham?
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule hiche thupeh hi ama-a kona ineiju ahi, Pathen ngailu-a chun asopi jong ngailuhen.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Koi hile Jesu chu Christa ahi tia tahsan chu Pathen'a kona penga ahi; chule koi hile ahinga ngailu-a chun ahin jong chu angailut ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Eihon Pathen ingailut uva, athupeh init tengule, hichea kona hi Pathen chate ingailutnu ihet dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ijeh inem itile athupeh initnu chu Pathen ingailutnao ahi; chule athupeh chengse jong chu pohgihsa ahipoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu koi hile Pathen'a kona penga chun vannoi hi ajo ahitai. Chule vannoi jouva chu itahsanu hi ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu chu Pathen Chapa ahi tia tahsan kala vannoi jouva koiham?
  </para>
  <para style="p">
    <verse number="6" style="v" />Twisih le thisana hunga chu Jesu Christa tahchu ahi; twi sehseh hilouva, twisih le thisana kon ahi. Chule Lhagao chu hettohsah ahi; ajeh iham itile Lhagao chu thutah ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu van'a ahettohsah thum aumin ahi, Pa, Thu, chule Lhagao Theng: chule hicheng thum chu pumkhat ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule leisetna ahettohsah thum aumin ahi, Lhagao, twisih, chule thisan: chule hicheng thum chu khatna akitoh-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eihon mihemte thu hettohsah ilah uva ahile, Pathen hettohsah chu chusanga chungnungjo ahi; Aman Achapa thudol chu ahettohsah chu Pathen thu hettohsah ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen Chapa tahsana chu alung sunga hiche hettohsahna chu chenga ahi: Pathen tahsan loupa chun ama chu ajousah ahitai; ajeh iham itile aman Pathen'in Achapa thudol ahettohsah chu atahsanpoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hiche hettohsahna chu hiche ahi, Pathen'in eiho hin kemlou eipetaove, chule hiche hinna chu Achapa-a um ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chapa neija chun hinna anei ahitai; chule Pathen Chapa nei lou chun hinna anei lou ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanghon hin kemlou naneiju nahet nadingule, Pathen chapa mina natahsan theina dinguva, thu hicheng hi Pathen Chapa mina tahsan nangho henga kahinsut ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule ama-a kisonna ineiju chu hiche hi ahi, ipi ipi hijongle ama lung deilam dola ithumuva ahile, aman eingaipeh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule eihon ithum chanu eingaipeh jiuve ti ihetnuva ahile, eihon ama henga ingaichatnu chu imu-u ahitai ti iheuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi khattouvin asopi chonsea amua achonset chu thina khop chonset ahi louva ahile, ama chun thumhen, chutile aman thina khop hilouva chonseho chu hinna apeh ding ahi. Thina khop chonset aume; hiche chu thumhen tia kasei ahipoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chonphat louna jouse chu chonset ahi: chule thina khop hilou chonset aume.
  </para>
  <para style="p">
    <verse number="18" style="v" />Koi hile Pathen'a kona penga chu achonseji poi ti iheuve; ahin Pathen'a kona penga chu ama akihongdohjin, chule agilou chun atongkhajipoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Eiho Pathen'a kon ihiu le, vannoi pumpi hi gitlouna-a uma ahi ti iheuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Pathen Chapa chu ahungin, hiche adihtah pa chu ihet theina dingun lungthim eihung petaovin, chule eiho adihtah pa, Achapa Jesu Christa-a chun i-umuve ti iheuve. Ama chu Pathen dihtah le tonsot hinna ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kachateho, milimho lah-a konin kihong phaovin. Amen.
  </para>
</usx>
