<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="TIT" style="id">Titus</book>
  <para style="h">Titus</para>
  <para style="toc1">Titus</para>
  <para style="toc2">Titus</para>
  <para style="mt">Titus</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Paul, Pathen soh, Pathen milhen tahsana dungjui le Pathen ngaisahna tolhona thutah hetna lama Jesu Christa solchah;
  </para>
  <para style="p">
    <verse number="2" style="v" />Tonsot hinna kinepna-a chu jou sei theilou Pathen chun tonsot tonsot masanga atepsa ahitai;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahinla aphatcha athu chu kihil lhanga kiphongdoh ahi; Eihuh hinguva Pathen thupeh dungjuija chuche hillhangna chu eikichinsah ahitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tahsan lhangpi thudola kacha tahtah Titus henga: Pa Pathen le Eihuh hinguva Pakai Jesu Christa-a konin lungset, khoto chule lungmon lhunghen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thil kibol bulhing lou chengse chu naboltup sohkeija chule khopi tinchenga upaho napansah ding, hiche dinga chu Crete'a kadalhah nahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi chu koi hile nolna bei, numei khatseh ji-a neija, chule achate chu Pathen tahsan hia chon chatvaina lamle thua nun louna lama seiset changlou hi ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu iham itile houbung lamkai chu Pathen gou chinga ahi jeh-a chu nolna bei hi dingdol ahi; kichamsah, lungsabai, ju-a lop, mideng-ah, alam louva phatchomna ding ngaito-a kilose mi hilou ding;
  </para>
  <para style="p">
    <verse number="8" style="v" />Amavang jindot them, phat ngailu-a, lung limgeh, chondih, atheng, ama chang kitimthei mibou hi ding ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule thuhilpha kicheh-a chu mi thuhil athepma, mi nelkal hat teho chu athemo nao ahetsah theina dinga, akihil dungjuija tahsan umtah thu chu tuhchah mi hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thua nung louva thumot seile dohapan mi tamtah aume, ahideh-a chu cheptanho lah-a mi ahiuve;
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho chu akamu huhbing ding ahi; alam louva phatchomna ding gutnan ahildol louhelu thu ahilun, mi kimkhat insung achoh chavaitaove.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaho thudol mi themgao khatnin ahiti seije, Crete miho chu a-imatih chana jou jing sahang ahiuvin, thasea annehhat ahiuve, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiche het tohsahna hi adihtah mong ahi. Chuti ahi jeh chun amaho tahsan kicheh mi ahina dingun nasatah-in phohsalin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Thutah-a kona mi heimanga Juda miho moh thusimle miho thupeh-a lunglut daohen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Atheng dinga imajouse thengsoh ahi, ahin akisuboh atahsan louho ding vanga athenga khatcha umlou ahi, thentah sanga alungule ase apha hetnau agoma bohjia ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathen kahei, tin akam sungun aseidoh naovin, anatoh lama ajanom pouve; amaho chu thet umtah, thu ngailou ahiuvin, thilpha bolna lama pannabei ahiuve.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangma vangin thuhilpha kicheh chutoh kitoh thu seijin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Upaho chu kitim thei, ja umtah, lunglimtah, chule ngailutna le ginchat, chule lungdehat kichehtah mi ahi theina dingun, hilin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutima chun nupi tehse ho jong chu mi ja um gingkhen hiuhen, mi hehsehat le lengpitwi tamtah sohnu hilouva, thilpha lama mihil hiuhen;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutia chu amaho chun nutil khangdongho chu a-inneipute chengu ngailutle achateu ngailutje kisinsah uhen;
  </para>
  <para style="p">
    <verse number="5" style="v" />Alung limgeh, chon thengtah, inmun natong mi ahiuva, mihepi them ahiuva, a-inneipute chengu thu amanuva, chutia chu Pathen thu chu taitoma aum louna dingin, hilin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutobangma chun gollhangho chu lunglim gehcha aumna dingun tilkhouvin;
  </para>
  <para style="p">
    <verse number="7" style="v" />Imalam jouse-a amahon thilpha bolna lama avettoh-a ajui dingun umin; nathuhila chun bohbehlou nahidan, nabukim dan, nakitahje dan musah-in,
  </para>
  <para style="p">
    <verse number="8" style="v" />Seiset oimo-a aum louna dingin, chutia chu akaleh lama panga chu ichunguva thuse sei ding nei louva ajachat theina dingin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Soh ho chu a-pakai ho chengu thu noija aumna dingule imalam jouse-a amaho lunglhaina lama aumna dingun tilkhouvin; nelkal louhel hiuhen;
  </para>
  <para style="p">
    <verse number="10" style="v" />Imacha kiseldoh nei louvin tahsanpha kichehtah musah hiuhen; chutia chu imalam jouse-a Eihuh hinguva Pathen thuhil chu ajephoi theina dingun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajeh chu Pathen milungset hung kilah-a mi jouse huhhingna chu ahinlhut ahitai;
  </para>
  <para style="p">
    <verse number="12" style="v" />Hitia chu eiho, Pathen ngaisah lounale vannoi leiset lung ngaichat jouse pumpaija, lunglima chondih-a chule Pathen ngaisahna neija tu khanga hi ikhosah dingu ahi,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule kinepna thanop um tah chule Pathen loupi chungnungle Eihuh hinguva Jesu Christa loupina hung kilah dinga chu kat jinga i-um dingu ahi chu, eihilu ahitai;
  </para>
  <para style="p">
    <verse number="14" style="v" />Chonphat louna jouse-a kona aman apeh-a eiho eilhatdoh theina dingule, ama-a hi dinga thilpha bola tompan mi vai khat ama dinga akisuhtheng theina dinga, ama chu eiho dinga kipedoh ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman thu hicheng hi seijin, thunei kimkei tah-in tilkhouvin, phohsalin; koimacha kinahsahmosah hihhelin.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangman amaho chu vaipoho le thunei ho thu noija umdingin, sei ngaija thua nung dingin, thilpha bol lam jouse-a kigosa dema umdingin,
  </para>
  <para style="p">
    <verse number="2" style="v" />chule mi koima seise louhela, mi koima setna hol louva, chonnema, mi jouse chunga nunnema chon dingin jong hilphan.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajeh chu eiho jong masanga chu lungthimbei, sei ngailou, thua nunglou, lheplhah, lungngai chatle nomsahna tamtah soh anahia, kimitthiple kithangset to-a uma, hot hattah-a khatle khat kihoto-a inahiu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla Eihuh hinguva Pathen mihepile mihem angailutna ahung kilahdoh phat hin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Eihon eiho chama ibolu chonphat thilbol vanga hilouva, aman amilungset dungjuija eihuhdoh uva, penthahna-a asila, lhagao thenga athah sema;
  </para>
  <para style="p">
    <verse number="6" style="v" />Eihuh hinguva Jesu Christa-a kona ichunguva letset tah-a asunlhah-a eihuhhingu ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichu amilungset vanga themchanga i-um uva, tonsot hin kemlou kinepna dungjuija gouloa eikisem theina dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche thu kiseija hi ginchat umtah ahi; chule nangman hiti thu dola hin thu akichetje chu seijin; Pathen tahsan ho chun thilpha bol jing leu kalung ahi. Hitiho hi miho dinga aphale phatchomna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amavang ngolhoi thudohhole khanggui thu kinel baotam, danthu dola kinah, hichenga kon chun nangma kiheimangin; hicheng chu phatchomna ahipoi, mohseh ahibouve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Loitumbol mi chu khatvei nivei nahilchah kalin lata hih-in;
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitobang mi chu lamvaija chule chonsejia ahi ti nahei, amale ama themlou kichan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keiman naheng lama Artimas ahiloule Tychicus kahinsola ahile, Nicopolis'a kahenga hung dingin hung kihabolin; chukoma chu phalbi sungse-a umding kagel lhuh ahitai;
  </para>
  <para style="p">
    <verse number="13" style="v" />Dan thusun Zenas le Apollos ima alhahsam lhon louna dingin, lungthim themtah-in hinlha doh-in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Imiteu jong chu aboithei louna dingle thil ngaichat lhahsam louna dinga, thilpha bolna-a amakai theina dingun kisin uhen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaumpi chengsen abonchauvin nasalamui. Tahsan na-a eingailuho chengse salam'in. Nabon chaova chunga lungsetna umhen, Amen.
  </para>
</usx>
