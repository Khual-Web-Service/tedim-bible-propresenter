<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PHM" style="id">Philemon</book>
  <para style="h">Philemon</para>
  <para style="toc1">Philemon</para>
  <para style="toc2">Philemon</para>
  <para style="mt">Philemon</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Christa Jesu jala sohchang Paul le sopi Timothy'n katoh khompiu kadeitah Philemon,
  </para>
  <para style="p">
    <verse number="2" style="v" />chule ingailutnu Appia chule kasepai chanpi Arkhippa, chule na ina kikhom houbung hichengse henga chun;
  </para>
  <para style="p">
    <verse number="3" style="v" />i-Pau Pathen le Pakai Jesu Christa-a konin nachung uva lungsetle lungmon umhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman kataona-a namin kaphan ka Pathen kathangvah jingin ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu Pakai Jesu le mithengho jouse nangailut le tahsan thu chu kanajan ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangma-a um chule Christa Jesu'a um thilpha jouse hetsahna hin natahsan chu thilpha bolthei asona din katao jinge.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu nangma ngailut chu hapan kakipapin kalungmonge; ajeh chu, sopi, nangma vangin mithengho alunghalui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu angai doltah-a bol dinga nangma thu peh ding Christa-a kangam jeng vangin,
  </para>
  <para style="p">
    <verse number="9" style="v" />ngailutna jala, tehse keima Paul Christa Jesu jala sohchang hi kahung taothojoh ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Kakihen na sunga kahin kachapa Onesimus dinga kahung tao ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama hi khatvei chu nadinga phachom lou ahin, tu vangin nangma dinga jong, keima dinga jong, phachom ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amatah chu kalungtohtah ahin, nangma henga kahin solkit tai; hijeh chun ama anasangin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kipana Thupha jala kakihenna-a hi nangma thakhela eijenlea apantheina dinga keima kina dinga lhoden kagot ahin;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahivangin nangma lung hina louvin ima kabol nompoi; naphatna chu khoh bola kon hilouva, nangma chamchama ahinajoh dinga kati ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amapa hi tonsot geija nanei theina dinga, chomkhat dinga nakoidoh hikhat hinte;
  </para>
  <para style="p">
    <verse number="16" style="v" />Soh bang hita louva, soh sanga chungnungjo, sopi deitah bang hijohen, kei dingtah-a bon ahile, nangma dinga tahsa-a le Pakaiya gamchenga ha hicheh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti chu ahile nangman keima hi tohkhompi tia neigela ahile, ama hi keima neilem ding khelin analemin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ama nangma chunga suhkhel nei ahi jongle, ahilouva nabat aum jongle, hichu keijan simjengin,
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima Paul'in kakhut tah-a kasut ahi, keiman sanange: hichu, nangma tah-in keima neibat chu neisan, tia kasei ahipoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahi, sopi, nanga konin keima Pakaiyah phatchomna neineisah-in; nangman keima Christa-a neisulung halin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naseingai gingcha tah-a kahinsut ahi, kathusei chu akalvala phajon bolinate, ti kahei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chujongle kalhunna ding mun gotsan anakoijin; ajeh chu nangho taona vangin nangho henga peh-in uminge ti kakineme.
  </para>
  <para style="p">
    <verse number="23" style="v" />Christa Jesu'a kasohchanpi Epaphras'in nasalame;
  </para>
  <para style="p">
    <verse number="24" style="v" />Marcus, Aristarchus, Demas chule Luke, kakithopiho hicheng hin nasalamui.
  </para>
  <para style="p">
    <verse number="25" style="v" />I-Pakaiyu Jesu Christa milungsetna chun nalhagaovu umpihen. Amen.
  </para>
</usx>
