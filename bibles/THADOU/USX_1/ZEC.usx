<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ZEC" style="id">Zechariah</book>
  <para style="h">Zechariah</para>
  <para style="toc1">Zechariah</para>
  <para style="toc2">Zechariah</para>
  <para style="mt">Zechariah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Darius lengchan kal kum nina, lhaget lhina-in, Iddo themgao chapa Berechiah chapa Zechariah themgao henga Pakai thu ahung lhungin, aseije:
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai chu napu napateu chunga chun alungnom mo lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hijeh chun nangman ahenguva, Janel Pakaiyin hitin aseije; keima lam hin ngauvin tin janel Pakaiyin aseije, chutileh kenjong nangho lam kahin ngat ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="4" style="v" />Napu napateu toh banghih-un, amaho henga chun themgao masahon anasamuvin, Janel Pakaiyin hitin aseije; lamdih louva kon le natoh phalouva konin hung kiheijun, tin aseijun ahi: ahinla amahon angai pouvin, kathu jong alapouve tin, Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="5" style="v" />Napu napateu hoiba hitam? chule themgaoho chu tonsotna hinguvam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla kasoh themgaoho kana thupeh, kathule kadan kisunho chun napu napateu chu atuhtang louham? Chule amaho ahung kileuvin, janel Pakaiyin ichunguva bolding agot bangin, ilampiu dungjuile, itoh-u dungjuijin ichunguva atong chaitai atiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Darius lengchan kal kum nina, lha somlekhat channa, hichu Sebat lha ahin, nisomni le nili nin, Iddo chapa Berechiah chapa Zechariah themgao henga, Pakai thu ahung lhungin, aseije:
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman jan-in, sakol san chunga mikhat touva, amachu noilama huisum thing lah-a adina; anunga sakol sanho, apolchetchut, chule akang aum kamun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin keiman, Vo Ka Pakai, hichehohi ipiham? kati. Hichun vantil eikihoupi chun kahenga, hichehohi ipi ahiu vetsah inge, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin huisum thing lah-a ding mipa chun adonbutnin aseije, hicheho hi leiset pumpi suhle tunga chonle dinga Pakaiyin ahinsol ho ahiuve ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon thingphung lah-a ding Pakai vantil chun adonbutnun, keihon leiset hi suhle tungin kachonun, veuvin, lei pumpi chu atouthip beh-in, akicholdon ahi, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Pakai vantil chun adonbutnin aseije, Vo janel Pakai, kum somsagi jen adouna-a nalunghan khum Jerusalem le Judah khopiho chunga itihchan hepina beija naum ding hitam?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin eikihoupi vantil chu thupha le lhamona thun adonbutnin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuti chun kajah-a thusei vantil chun kahenga, hitihin samphongin, janel Pakaiyin hitin aseije; keima Jerusalem le Zion din thangthipna lentah in kathang thipmin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nomtah-a uma Pathen hephalou ho chunga kalung phamolheh jengin ahi: ajehchu keima themkhat bou kalung phamo ahin, ahinla amahon suhgimna chu amasot uvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh chun Pakaiyin hitin aseije; keima Jerusalem henga hepina toh kahungkile kit tai: asunga chu ka-in kisading ahi, tin janel Pakaiyin aseije, chule Jerusalem chunga tetohna khao kijan ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Samphong nalaijin, Janel Pakaiyin hitin aseije tin aseijin; kakhopiho phattheina vanga kikehbe nalai ding; Pakaiyin Zion alhamon nalaiding, chule Jerusalem adeilhen nahlai ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujouvin kakhodah-in ahile, veuvin saki li kamun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin keima eikihoupi vantil jah-a chun, hihohi ipi tina ham? kati. Hichun aman, hichehohi Judah, Israel chule Jerusalem thecheh-ah aki li neiho chu ahi tin eidonbutne.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin thingthem bol mili eimusah-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin keiman, hichehohi ipi bol dinga hung hiuvam? kati. Hichun aman, hiche ki li hohi Judah thecheh-a, koimacha alu dahdoh ngamlou hela lhaho chu ahiuve: ahinla hiche thingthem bol hohi amaho jamsah dingle, akithecheh na dinguva Judah gam chunga aki-u domsanga chidang namdangho ki hochu suhlhahpeh dinga hunga ahiuve, tin aseije.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Keima kakhodah kitnin, kaven, chule akhutna tena khao kichoi khat kamun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin kenjong, hoija che nahim? kati. Hichun aman kahenga, Jerusalem avai ite hija, adung ite ahi hetna dinga ate dinga che kahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin veuvin, eikihoupi vantil chu achedoh-in, chule vantil chom khat ama kimupi dingin apotdoh-in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ahenga hitin aseije, lhaijin, hiche gollhangpa henga khun, Jerusalem chu asunga mihemle gancha atamval jeh-a kulbang neilou khopiho banga chenna hiding ahi, tin gaseijin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu keima ama dinga akimvela mei kulbang banga kauma, chule asunga loupina kahi ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hei, hung doh-un, chule sahlam gama konin jamdoh uvin tin Pakaiyin aseije. Ajehchu kol ningli-a hui bangin kathejao taove tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Babylon chanutoh chengkhom Vo Zion, nangma kihuh doh-in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu, janel Pakaiyin hitin aseije; loupina jou chun, nachom gamuva namho henga chun keima eisolin ahi. Ajehchu nangho tongkha-a chun amit laivom atohkhah ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu veuvin, keiman achunguva kakhut kathin ding, chule amaho asohteu dinga galthil kichom hidiu ahi: chutengle nanghon keimahi janel Pakai hinsol kahi nahetna dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vo Zion chanute, la saovin lang kipah-un: ajehchu veuvin, kahunge, chule nalah uva kachen ding ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche ni chule nam tamtah-in Pakai chu jop untin, kamite hidiu: chule keima nalah uva kachen ding, chutengle keimahi janel Pakaiyin naheng uva eihinsol ahi nahet dingu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Pakaiyin gamtheng sunga achanvou dinga Juda chu alo ding, chule Jerusalem adeilhen kitding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vo tahsa hing jouse, Pakai anga thipchetnun: ajehchu ama amunthenga konin akithou doh-in ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman, Pakai vantil anga ding thempu chungnung Joshua chule ama doudal ding go-a ajetlama Satan adin chu eivetsah-e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin Satan henga, Vo Satan, Pakaiyin naphoh-e; Pakai Jerusalem kilhenpa tahchun naphoh-e: hichehi meija kona meikho kiloidoh hilou ham? atin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun Joshua chu ponsil nentah kivonin, vantil anga chun adinge.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman amasanga dingho chu adonbutnin, ajah uva chun, ponsil nen chu ama-a konin ladoh-un, tin aseije. Chule ama jah-a chun, ven, nakhan gitlouna nanga kona kabeisah tan, chule keiman ponsil hoitah kavonpeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin keiman, aluchunga lukhuh hoitah khuhpeh uhen, kati. Chutichun alua lukhuh hoitah akhuh peh-un, ponsil avonpeh taove. Chule Pakai vantil chu akoma adinge.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakai vantil chun Joshua henga aphongdoh-in, aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Janel Pakaiyin hitin aseije; kalampi najotna, kathupeh nanit leh, ka-in sunga vai nahom ding, kahong sung jong navetsui ding, chule hikoma dingho lah-a hi vahle theina mun kapeh ding nahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vo Joshua thempu chungnung, nangma le na-anga touhon, tun ngaijun; ajehchu amaho datmo umtah miho ahiuve: ajehchu veuvin, keiman kalhacha ABAH chu kahin puidoh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu Joshua masanga kasong set chu veuvin, song khat chunga mit sagi umding ahi: veuvin, keiman hia chu thucheng kajih ding ahi, tin janel Pakaiyin aseije, chule keiman nikhat tengle chuche gam khangitlouna chu katolmang ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche nikho chule mitinin alengpigui le atheichang phung noija, aheng akomcheh akou dingu ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin vantil eina kihoupi chu ahungkitnin, mi khat a-ihmutna kona kisuthou bangin eisuthouvin,
  </para>
  <para style="p">
    <verse number="2" style="v" />kajah-a, ipi namu em? eiti. Hichun keiman kadonbutnin, kavei, chule vetan, achungvuma sumlheng um, chule akhoma thaomei sagi nei, chuche thaomei sagi-a chu akam sagi um, sana jenga kisem meivah khom:
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule akoma Olive thingphung ni, sumlheng jetlama khat chule aveilama khat um kamui, kati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuti chun, kadonbut nin, eina kihoupi vantil jah-a chun, ka pakai hichehohi ipi ham? katin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin eina kihoupi vantil chun eidonbutnin, hichehohi ipi ahi nahetlou ham? ati. Hichun keiman kahepoi ka Pakai, katin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman eidonbutnin kahenga aseije, Hichehi Zerubbabel henga Pakai thusei ahi: thahat jeh hilou, thilboltheina jeh jong hilou, kalhagao vang jeh ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo molsang lenpitah, nangma koi nahim? Zerubbabel masanga phaicham naso jeng ding ahi: chule aman a-aw puma songpi athupipen chu lungsetna, lungsetna tia sampuma ahintoldoh ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chukal valin Pakai thu chu kahenga ahungin, aseije,
  </para>
  <para style="p">
    <verse number="9" style="v" />Zerubbabel khutnin hiche in bul hi ana phudoh ahin, ama khut maman ajoding ahi: chutengle nanghon keimahi janel Pakaiyin naheng uva eisol ahi nahetdingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu koijin thilneocha nikho i-sah louva akoijem? ajehchu amaho kipah-un tin, Zerubbabel khutna ngentum chu hiche sagiho chutoh amuthadiu ahi; hiche sagiho chu leiset pumpi-a suhle tunga lhaile Pakai mit ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule keiman kadonbut nin, ajah-a, hiche meivah khom jetle veija olive thingphung teni hi ipi hetna ham? katin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin keiman kadonbut kitnin, ahenga kaseijin, sana long tenin amani le amani-a kon sana thaotwi alhitkang lhona olive thingbah teni khu ipi hetna ham? kati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman eidonbut nin, kajah-a, hichehohi ipi hetna ahi nahetlou ham? eiti. Chuin keiman, kahepoi ka pakai kati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman aseijin, hitenihi thao kinusa, leiset pumpi Pakai koma ding teni ahi lhone ati.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin kakiheijin, kakhodah-in, chule kaven ahile, lekhajol leng lele khat kamun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman kahenga, ipi namu em? eiti. Chuin keiman, lekhajol khat kamun, adung chu tong somni ahin, chule avai chu tong som ahi, tin kadonbutne.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman kajah-a, hichehi leiset pumpi chunga dinga potdoh-a gaosapna chu ahi: ajehchu gucha tapou chu lekhajol hiche lampang dungjuija kisumanga, chule akihahsel tapou chu lekhajol khuche lampang dungjuija kisumang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiman kahin puidoh ding ahi tin Janel Pakaiyin aseije, chule hiche guchapa insung le jouva kamina kihahselpa insunga chu lutding; hichu a-insunga chu umdena, chua uma thingpeh le songho puma chu asuhmanghel ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chujouvin keima eina houpi vantil chu ahung potdoh-in, kajah-a, tun khodah inlang apotdoh khu ipiham vetemin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin keiman, ipiham? kati. Chuin aman aseijin, hiche hi apotdoh-a ephah chu ahi. Aman aseibe kitnin, hiche hi leiset pumpi-a akhan gitlounao chu ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin veuvin, ngen talen khat akidom sangin; chule hichehi numei khat ephah sunga tou chu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin aman aseijin, hichehi khan gitlouna ahi. Chuin aman ephah sunga aseplutnin, chule aman ngen gih-a chun chuche kam chu asingtan ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin keiman kakhodah-in, kaven ahileh, veuvin, numei ni ahungdoh in, alhaving hona chun hui aumin ahi; ajehchu amanin twilungva bangin lhaving aneilhonin ahi. Chuin amanin ephah chu leile van kikah-a adomsang lhonin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chujouvin keiman einaki houpi-a vantil jah-a chun, hiche ephah hi hoilama adoplhon dingham kati?
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman kahenga, Shinar gama a-in sahpeh nading lama: chule hichu kisadoh intin, amanu mun ngeija kitungdoh ding ahi, ati.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule keima kakiheijin, kakhodah-in, kaven ahileh, veuvin, molsang ni kikah-a sakol kangtalai li ahungdoh-in; chule hiche molsang teni chu sum-eng molsang ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sakol kangtalai masa-a sakol ho chu asan ahin, sakol kangtalai nina-a sakol ho chu avom ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule sakol kangtalai thum na-a sakol ho chu akangin, chule sakol kangtalai lina-a sakol ho chu abongpol jeng ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chujouvin keiman kadonbut nin eihoupi-a vantil jah-a chun, ka pakai, hichehohi ipiham? kati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin vantil chun kajah-a, hichehohi van lhagao liho, leiset pumpi Pakai anga adin naova kona chedohho ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chua um sakol vomho chu sahlam gama akitolun; akangho chun amaho chu ajuijun; abongpol ho chu lhang lam gama akitolui.
  </para>
  <para style="p">
    <verse number="7" style="v" />Asan pengho jong apotdoh-un, leiset pumpi-a suhle tunga vale ding agouvin ahi: chuin aman ajah uva, nangho hia konin cheovinlang, leipumpi suhle tungin gakhol taovin, ati. Hitichun amaho leiset pumpi-a suhle tunga avahle taove.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin aman kachunga apeng jah-in, chule kahenga aseije, ven, hiche sahlang gama cheho khun sahlang gama kalhagao acholdo sah uve, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakai thu chu kahenga ahung lhungin, aseije;
  </para>
  <para style="p">
    <verse number="10" style="v" />Sohchang Babylon'a kona hungho lah-a, Heldai, Tobijah, chule Jedaiah'a kon thilpeh chu la inlang, chuche ni mama chule hungin lang, Zephaniah chapa Josiah ina chun lutnin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouteng dangkale sana lanlang lallukhuh khat semin, chule hichu thempu chungnung Josedech chapa Joshua luchunga khuhpeh-in;
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ajah-a hitin seijin, Janel Pakaiyin aseijin, hitin aseije, ven Mi amin ABAH kitipa chu: Ama aumna mun'a konin khangtouvin tin, chule aman Pakai houin asahdoh ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman Pakai houin geija asahdoh-a, loupina chu chang ding, chule ama touva alaltouna chunga vai ahomding; alaltouna chunga chu thempu'a pang ding ahi: chule chamna thumopna chu akikah lhona umding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule lallukhuh ho chu Helem, Tobijah, Jedaiah, chule Zephaniah chapa hetna dinga Pakai houin sunga umding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule gamlatah-a umho hunguva Pakai houin chu asahdiu, chutengle nanghon keimahi janel Pakaiyin naheng uva eisol ahichu nahetdiu ahi. Hichehi nanghon genngai tah-a Pakai na Pathen'u aw chu nangai ule bou hung guilhung ding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule ahitin ahi, Darius lengchan kal kum lina, Chisleu kiti alhakoh chana, ni li chanin, Zekeriah henga Pakai thu chu ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichu amahon Pathen in'a Sherezer le Regem-Melek le amiteu chu Pakai anga taodingin asol uvin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule janel Pakai in'a um thempuho le themgaoho henga, kum tamtah kahin bolngai banga, kachom uma, lha nga channa-a chu kaka ding ham? tia aga dohsah petnu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin janel Pakai thu chu kahenga ahung lhungin, aseije,
  </para>
  <para style="p">
    <verse number="5" style="v" />Gamsunga um miho jousele, thempuho jouse jah-a chun seijin, nanghon lha nga nale lha sagina-a an nangol uva chule nalunghem tengule, chuche kum somsagi sung jenga jongchu kahenga, keima henga an ngolla nahibeh um?
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nanghon naneh uva nadon tengu jongleh, nangho dinga bou naneh uva nadonu hilou ham?
  </para>
  <para style="p">
    <verse number="7" style="v" />Jerusalem le akimvel khopiho mihon alo dimsetnuva aphattou laile, mihon lhanglam le phaicham alodimlai juva themgao masaho-a Pakai thusei ho chu nangaidiu hilou ham? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakai thu chu Zekeriah henga ahung lhungin, aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Janel Pakaiyin hitin aseije; Thutan dih mangun lang, mitinin asopi henga hepina le khotona musah hen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule meithai le pa neilou, kholjin mi le migenthei ho chu bolgim hih-un, koima chan asopi dounan alungthimin aphalou ngaito hihhen, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla amahon angainom pouvin, chule alengkouvu aheimangun, ajahlouna dingun akol asimuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Henge, amahon janel Pakaiyin themgao masaho lhagaova ahin thuseidoh ho le adan thupeh ho chu kijakhante tin alungu song bangin atahsah-un ahi. Hijeh chun janel Pakaiya konin alunghana nasatah ahung lhungin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun, ahitin ahi, aman akouva, amahon angailou banguvin; amahon eikouvu keiman kangai lou ding ahi tin, janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla keiman amaho ahetkhah louvu namtin lah-a chimpeijin kathecheh taove. Hijeh chun amaho nungin agamu chu akamheltan, koima ajotpa le akinungle aumpoi: ajehchu gam nomtah chu kamhela akoiju ahitai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Janel Pakai thu kahenga ahunglhung kitnin, aseije;
  </para>
  <para style="p">
    <verse number="2" style="v" />Janel Pakaiyin hitin aseije; Keima Zion din thangthipna nasatah-in kathangthipmin, amadin lunghan chungnungin kathangthipme.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakaiyin hitin aseije; Keima Zion henga kahung kilekitna, Jerusalem lailunga kachen ding ahi. Chule Jerusalem chu thutah khopi kitiding, janel ho Pakai molsang chu molsang theng kitiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Janel Pakaiyin hitin aseije; Jerusalem lamlena chu tehse numei le tehse pasal cheng nalai ding ahin, chule akum tambehseh jeh-a mitinin akhutna tenggol akiphu dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule khopi lamlena chu pasal chapang le numei chapang dimset ding, akhopi lamlena chu kichem dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Janel Pakaiyin hitin aseije; hiche nikho-a hiche mite amohho mitmu-a hichu datmo aumin, chule keima mitmu-a jong datmo aumdem? tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="7" style="v" />Janel Pakaiyin hitin aseije; veuvin, keiman kamite chu solam le lhumlam gama kona kahuhdoh ding;
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amaho chu kahin puija, Jerusalem lailunga cheng ding ahiuve. Chule amaho kamite hiuva, thutah le chonphatna-a keima a-Pathen'u kahiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Janel Pakaiyin hitin aseije; Houin kisahdoh theina ding, janel Pakai houin bul kiphudoh nikho-a themgaoho kama thu kisei cheng, tukhanga anakola jajousen naban thau hatsah-un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajehchu tumasangin mihem kithalah manle, gancha kigoi man jong akipepoi; hesohna jeh-in alutle apotle dingin jong chamna aumpoi: ajehchu mijouse aheng akomtoh kana kidou sah-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahinla tunvang, hiche miho amoh cheng henga hin, masang laija chutoh bang taponge tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu muchi chu pha theijin tin, lengpiguijin aga pentin, leijin aga sepdoh intin, vanhon adaitwi hou apehdingu ahi; chule keiman hiche mite amohho chu hicheho jousehi kalosah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hung hitiding ahi, Pathen helouho lah-a sapsetna nachan jeh uvin, Vo Judah le Israel insung miteho; hijeh-a chu kahuhdoh uva phatthei channa nahidiu ahi. Kicha hih-un, ahin nabantha hatsah jouvin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu janel Pakaiyin hitin aseije; napateu vin eilung hansah uva, nangho engbol dinga kana gotlai bangin, kalung kaheipoi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuti chun tulai nikhon vang Jerusalem le Judah insung mite chunga thipha bolding kangaito kit tai: nangho kicha hih-un.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichehi nanghon naboldiu chu ahi; mitinin aheng akom jah-a thutah jeng seijun; nakotpi phunguva thutah le chamna-in thu tanun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koimachan aheng akom chunga lungse ngaito hihhen, jouva kihahselna ngailu hih-un. Ajehchu hicheho jousehi keiman kahot ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule janel Pakai thu chu kahenga hungin, aseije;
  </para>
  <para style="p">
    <verse number="19" style="v" />Janel Pakaiyin hitin aseije; lha lina an ngol, lha ngana an ngol, lha sagina an ngol, chule lhasom na-an ngol chu Judah insung mite dinga akipanale thanopna, chule nopsahna kut hiding ahi; hijeh chun thutah le chamna ngailuvin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Janel Pakaiyin hitin aseije; hung hiti ding ahi, mipi ho, khopi tamtah-a chengho chu hungding ahiuve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khopi khatna chenga miho chu achom khatna cheovintin, ajah uva, Pakai henga tao dingle, janel Pakai holdingin cheloiju hite: keijong kache ding ahi, ati dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Henge, mi tamtah le nam hat ho chu Jerusalem'a janel Pakai holding le Pakai henga taodinga hung diu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Janel Pakaiyin hitin aseije; hiche nikho chule hung hitiding ahi, namtinle paotin jouse-a kona misomin Judah mi khat pon atuh uva, keiho jong nangtoh kilhona kachediu ahi; ajehchu Pathen'in na-umpiuve ti kajauve, atidingu ahi ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel phungho jouse banga mihemte mit ho chun Pakai lam ahin ngat tengle; Hadrach gamsunga Pakai thua pohgih, chule Damascus chu akicholdona hiding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Tyrus le Zidon chu chinglheh jongle, Hamath'in jong hichu agamgit ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule Tyrus'in ama dingin kuldet akisemin, dangka chu leivui bangin asevumin, sana thengsel jong khopi lamlena bonlhoh bangin asevume.
  </para>
  <para style="p">
    <verse number="4" style="v" />Veovin, Pakaiyin amanu apaidoh ding, chule athahatna chu twipia alehlut ding; chule meijin akahvam ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ashkelon'in hichu amua kicha ding; Gaza'n jong amua lunggim lheh ding, chule Ekron'in jong; ajehchu akinepna chu kijumso ding; lengpa chu Gaza-a kona mangthah ding, Ashkelon chu chenna lou hiding ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Ashdod'a chu jaocha khat cheng ding; keiman Philistine hoithona chu kasuhtan ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule akamsunga kon athisan kalahmanga, chule aha kah-a kona thet umtah ahina chu kalahmang ding ahi. Ahinla aumdenpa, ama tah jengjong chu i-Pathen uva ding hintin, Judah gamsunga chu vaipipo banga umding ahin, Ekron chu Jebus mite tobang hiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Galmiho jehle, ajotpa jeh le ahung kilepa jeh-a, ka-in hi kaum kimvel ding; chule misugenthei koiman ahin jotpa lou ding ahitai; ajehchu tun kamit tah-in kamutai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vo Zion chanu, hapan kipah-in; Jerusalem chanu, aovin: ven nalengpa nahenga ahunge: ama chondihtah ahin, chule huhhingna aneije; kineosah tah-in sangan chunga, sangan nou chunga atouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule keiman Ephraim'a kona sakol kangtalai kasuhmanga, Jerusalem'a kona sakol ho chu kasuh mangding, chule gal thalpi jong kisat bongding ahi. Chule aman Pathen hephalou ho jah-a chamna thu aseiding, alenggam chu twipia pat twipi gei, chule vadunga pat kolmong gei hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangma dingin jong, nathisana kitepna vangin, twi beina kokhuh-a konin nasohchangho chu kasoldohtai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kinepna nei sohchang nangho kuldet lama kileuvin; tuni tah-a hi ajatnia kapehdiu ahi tia kaphondoh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keiman kathalpi Judah kajebongin, Ephraim chu thalchang bangin thal'a kadipme, nachapate chu thoudoh-in, vo Zion, nachapate doudingin, vo Greek, nangma mihat ho chemjam bangin kaseme.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakai chu achunguva kimuntin; athalchang ho chu kolphe banga leng ding ahi: Pakai Pathen'in sumkon mut intin, lhanglam chimpeitoh kilhonding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Janel Pakaiyin amaho ahonbit dingu; chule amahon abahgamuva, ah songse songa ajodiu ahi, amahon adondiu, chule lengpitwi kham banga pohchei choidiu; amaho sumlheng ho banga dimuva, maicham ningho bang dimdiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hiche nikho chule a-Pathen'un amite ganchahon banga ahuhdoh ding ahi: ajehchu amaho alua lallukhuh chunga songho bang dingu, agamsunga ponlap banga choisanga umdiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ajehchu aphatna hi ichana lenna, ahoina hi ichana len hitam? changin gollhangho athanopsah ding, lengpitwi thah-in nungah ho akipasah ding ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Goju nunung laihin nanghon Pakai henga go thumin; chutile Pakaiyin meilom vahsah intin, loulaija hampa tin cheng chu gotwi apehding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu semthu milimhon pannabei thu aseijun, doi-aithem hon jouthu amuvin, mang dihlou aseijuvin; amahon ahomkeovin alhamonun ahi. Hijeh chun kelngoihon bangin ama ama lampia acheuvin, kelngoi chingpa umlou jeh-in, amaho alungkham taove.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kelngoi chingho chunga chun kalung hang behsehnin, kelchaho chu ka-engbol tai. Ajehchu janel Pakaiyin akelngoihon Judah insung avilin, galbolna sakol phatah bangin aseme.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama-a konin inning songpi ahungdoh-in, ama-a konin thihkil, ama-a konin galkapna thalpi, ama-a konin misuh gentheina ho jouse chu ahungdoh-e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho chu gal kisatna-a amelmate lamlena bonlhoh toh chotbeh-a mihat tah tobang hunghidiu ahi. Chule Pakaiyin aumpi jeh uva gal asatnuva, sakol chung chongho chu kijumso diu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Keiman Judah insung kahatsah-a, Joseph insung kahuhhing ding: keiman amaho chensah dinga kahin lepui kitding ahi; ajehchu keiman amaho kakhoto-in ahi. Amaho kanapai manglou tobang hidiu ah; ajehchu keima Pakai a-Pathen'u kahin, chule kangaipeh dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ephraim miho chu mi hattah banguntin, alungu chu lengpitwi kham tobanga thanom ding: achateu vin hichu amuva, kipah dingu; Pakaiya alungu kipah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Keiman amaho dinga huisatding, chule kakhop khomding ahi; ajehchu keiman amaho kalhatdoh ahitan: anapunthei banguva chu pungthei diu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule keiman amaho chu mite lah-a katulut ding: amahon gamlatah-a eihin geldoh dingu ahi; chule achateutoh cheng khomuva, hung kilekit dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keiman amaho Egypt gama konin jong hinle puidoh kitning ting, Assyria'a kona kakhop khom ding; Chule Gilead le Lebanon gama kona kapuilutna, amaho dinga mun akimulou geija kapuilut ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule ama gimbolna pumin twipi chu galkaijin tin, twipi kinong chu avoh ding, luipi thuhtah jouse kanggam helding ahi: Chule Assyria hoithona kisunema, Egypt te leng tenggol jong kitolmang ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ken amaho chu Pakaiya hatsah ingting, ama minna chesuh chetoudiu ahi, tin Pakaiyin aseije.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vo Lebanon, meijin na Cedar thingho akahvam theina ding, nakot ho hongin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vo chahthing, pengin; ajehchu cedar thingho alhugamtai; ajehchu thing thupi tahtah ho akisuse gamtai: Vo Bashan gangpiho, nangho pengun; ajehchu gammang thingho alhugamtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kelngoi chingho pen awgin akijai, ajehchu aloupinao akisuhmang tai: keipi bahkai donglai kitumgin akijai, ajehchu Jordan kiletsahna suhsetnin aumtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakai ka Pathen'in hitin aseije; tha ding kelngoihon ho chu vah-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aneiho tah-in amaho athatjiuvin, themmo akisaji pouve: chule amaho joh-a panghon, Pakai chu nunnom hen; ajehchu keima kahao tai, atijiuve. Amaho achinga pangho tah-in jong akhotoji pouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu gamsunga chengho chu khoto taponge, tin Pakaiyin aseije. Ahinla veuvin, keiman mitin chu aheng akom khut le alengpau khutna kapehdoh ding ahi. Amahon gamsung chu asat dingu, akhutnuva kona kahuh dohlou ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule thading kelngoihon ho chu kavahding, vo kelngoihon lah-a genthei, nangma tahjong kavah ding nahi. Chuin keiman keima dingin tenggol ni kalan, khat chu Ahoi kasah-in, khat chu Kikan khom kasah-in; chuin kelngoihon chu kavahtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lha khat sungin kelngoi ching thum jong kasumangin; chule kahinna-in amaho athetnin, amaho hinna-in jong keima eihouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin ken kaseijin, ken nangho vahponge, athi ding chu thi hen; akisumang ding chu kisumang hen; adang chu amahole amaho sa kinetohen, katitai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin katengol Ahoi kiti chu kalan, mijousetoh kitepna kananei chu kasuhkeh nadingin, katan bonghel tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hiche ni chun hichu abongtai: chule ganhon lah-a agenthei keima eina ngahho chun, hichu Pakai thu ahi, ti ahetauve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin keiman ahenguva, pha nasah ule, kalo neipeu vinlang; pha nasah lou uleh neipeh daovin, kati. Hichun amahon kalo dingin dangka somthum eitedoh peh taove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin kahenga, kaman dinga manpha tah amahon eipeh-u chu, beldengpa henga petan eiti. Chuin dangka somthum chu kalan, Pakai in'a beldengpa chu kapetai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin Judah le Israel kah-a kisopitna chu kasuhkehthei nadingin, katengol dang Kikan khom kiti chu kalan, kasu bongheltai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakaiyin kahenga, kelngoiching mingolpa manchah chu lakit nalai jin eiti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu vetan, keiman gamsunga kelngoiching khat kahin tundoh ding, amachun akisumang dingho avil lou ding, anouho jong ahol lou ding, agu bongho jong aboldam lou ding, adinglaiho jong avahlou ding ahi. Ahivanga aman athaoho phe chu anehding, chule atinho chu ahal hala asat telding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Phatchomna bei kelngoiching kelngoihon dalha-a chu ohe ada ahi! aban le amit jetlama chemjam chuding: abanchu gotheng hela, chule amit jetlam jong thimdel ding ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel dinga Pakai thu pohgih chu, vanho jahdoh-a leiset bulpi phutdeh-a, mihem sunga lhagao umsah-a Pakai chun aseije,
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah le Jerusalem agoma douna dinga aki-um tengle, veovin, Jerusalem chu akimvela mijouse dinga lungvaina khonna kasem ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hiche nikho chule Jerusalem chu mijouse dinga pohgih tah songa kasem ding; chuche douna-in leiset mijouse kikhom jongleh, chuche pohgih domkang dinga kigo jouse chu ahal hala kisat telding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakaiyin aseije, hiche nikho chule sakol jouse kidangsah na-a, chule achunga touho chu ngolna-a kajep ding; chule Judah insung chunga kamit kaha sah-a, miho sakol jouse mit chotna-a kajep ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Judah vaipoho chun alungthim uva, Jerusalem'a chengho chu janel Pakai a-Pathen'u jala kathahatnao ahi, atidiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuche nikho chule Judah vaipoho chu thing lah-a meithuh bangle, changphal lah-a meisel banga kasem ding; amahon akimvela mijouse jetle veija akahvam ding ahi. Jerusalem vang chu ama mun Jerusalem ngeija chu chenna kinei kitding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />David insung loupina le Jerusalem'a chengho loupina chu Judah chunga akichoisang louna dinga, Pakaiyin Judah ponbuh ho chu ahuhdoh masah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuche nikho chule Jerusalem'a chengho chu Pakaiyin hongin tin, alah uva chuche nikho-a alhasampen jong chu David bang ding; chule David insung chu Pathen tobang hiding, a-angsung uva Pakai vantil um banghel hidiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hiche nikho chule hunghiti ding ahi, Jerusalem douva hungkon nam jouse chu suhmang dinga kahol ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule David insung chungle Jerusalem'a chengte ho chunga lungsetna lhagao le taona lhagao kahin buhlhah ding ahi. Chule amahon tenga anasutpao keima eivet diu, chule mi achapa changkhat jeh-a alunghem banga amaho lunghemdiu, mikhat acha pengmasa pen chunga lhasetah-a aka banga ama jala kana nasatah umding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche nikho teng chule Megiddo phaichama Hadad-rimmon pul kidou banga, Jerusalem'a puldouna lentah umding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule gamsungin pul adouding, insung jousen atuma; David insungin mitin atuma, ajiteuvin atuma; Nathan insunga miten atuma, chule ajiteuvin atuma;
  </para>
  <para style="p">
    <verse number="13" style="v" />Levi insunga mite atuma, chule ajiteuvin atuma; Shimei insungin atuma, chule ajiteuvin atuma;
  </para>
  <para style="p">
    <verse number="14" style="v" />Amoh umnalai insung jousen, insung jousen atuma, chule ajiteuvin atuma pul adou chehdiu ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuche nikho teng chule chonsetna le thenlouna jeh-a David insung dingle Jerusalem'a chengteho-a dinga twinah khat hung putdoh ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche nikho chule hunghiti ding ahi, gamsunga kona alim semthuho min chu kasuhbeija, geldoh-a umkit talouhel ding ahi. Chule athemgao houle lhagao bohho chu gamsunga kona kapotdoh sah ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule hung hitiding ahi, mi khattou gao thusei aumle, ama hinga anule apa chun ahenga, Pakai mina jou nasei jeh-a nahinlou ding ahi, atilhon ding ahi. Chule ahinga anule apan agao thusei petna chu paihela asutlhon ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hiche nikho chule hunghiti ding ahi, themgaoho chu gaothu aseitengule agaothilmu jeh uva jahcha dingu; mi lheplhahna dinga ponham jong akisil tahloudiu;
  </para>
  <para style="p">
    <verse number="5" style="v" />Amavang, Keima themgao kahipoi, loubol mi kahi; ajehchu kakhangdon apatna gancha chinje min einahil ahitai, atijoh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule khat touvin, nakhut ho-a maha hohi ipi itiham? atile, aman, kagol ho in'a kona machang kahi, atiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vo chemjam, kakelngoi chingpa dounan, kakiloipi pa dounan hung thouvin, tin janel Pakaiyin aseije. Kelngoiho jamchehna dingin, achingpa chu volhun: chule keiman anoute chunga kakhut kalhah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hung hiti ding ahi, gamsung jouse-a hopthum-a hopni kisumanga thidiu, hopthum-a hopkhat bou kikhen ding ahi, tin janel Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hopthum na chu meija kahin pui galkai ding, dangka kilhatheng banga kalhahthenga, sana kipatep banga kapatep ding ahi. Amahon kamin kou untin, ken kadonbut ding ahi. Keiman, hichehi kamite ahi, katiding, amahon, Pakai chu ka Pathen ahi, atidiu ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Veovin, Pakai nikho chu hunglhung ding ahitai, chule nathil chomdoh chu nalah uva kihomjal ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu Jerusalem galla dou dinga kigo nam jouse kakhop ding; khopi chu kila-a, inho chu kichoma, numei ho kisuse ding; khopi kehkhat chu sohchanga potdoh diu, mipi amohho chu khopi-a kona kisumang louding ahiuve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutengle Pakai chu potdoh intin, galsat nikho-a gal asat banga, chuche namho douna-a gal asatding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule chuche nikho chule Jerusalem mai solama um Olive molsanga chu akenga hung ding ding, chule Olive molsang chu solam le lhumlama alaitah-a kehlha-a phaicham lentah hungsoh ding; mol kehkhat chu sahlama, chule kehkhat chu lhanglama kichondoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nangho molsang phaicham lama najam diu ahi; ajehchu molsang Phaicham chun Azal gei aphah ding ahi. Henge, Judah lengpa Uzziah nikho laija inling kihot masanga najam banguva najam diu ahi: chule Pakai ka Pathen chu hungding, chule mitheng jouse chu nangma toh hungdingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule hiche nikho chule hunghiti ding ahi, vah chu thenglou ding, thimjong thimlou ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla hichehi Pakai kihetna nikho khat chu hiding, sunjong hilou janjong hilouding ahi: ahinla hunghiti ding ahi, nilhah phatle vah umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hiche nikho chule hiti ding ahi, Jerusalem'a konin hintwi longdoh ding; akeh khat chu solam twipi lama longa, akeh khat lhumlam twipi lama longding, hichu chuhle khala long ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule leiset pumpi chunga Pakai chu leng chang ding ahi. Hiche nikho chule Pakai khat hintin, amin chu khat hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gam jouse Geba'a pat Jerusalem lhanglam Rimmon gei chu phaicham tobang hungsoh ding ahi. Jerusalem chu kidom sanga, Benjamin kotpi-a pat kotpi masagei le kotpi ningchong gei; chule Hananeel insanga pat lengpa lengpitwi chilna geija chenna hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule asunga chu miho chenga; avela suhmang hela umkit talou ding, Jerusalem chu bitkeija chenna joh hiding ahitai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule hichehi Jerusalem douna-a gal hinbol mipi jouse chunga Pakaiyin hise alansah chu hiding ahi; Akenga adin laijule apheu junmang ding, amitko sunguva amitnu junmang ding, chule aleiju akam sunguva junmang ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule hiche nikho chule hung hitiding ahi, Pakaiya kona thunoh lentah alah uva umding; amaho mitinin aheng akom khut amatna, chule akhut chu aheng akom khut douna alap ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Judah ten jong Jerusalem asatdiu; chule akimveluva Pathen helouho haona sana, dangka, chule ponsil nengtah-a kichom khom ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule chutobang ma chu sakol natna hise, sangan hise, sangongsang hise, sanganchal hise, chule ponbuh ho sunga ganchaho jouse chunga, hitobanga chu natna hise umding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hung hiti ding ahi, nam jouse Jerusalem doudinga hungho lah-a panglouse chu, kumseh-a lengpa, janel Pakai houdinga cheova, chule houbuh kut mang dinga chejidiu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule hitiding ahi, leiset chunga inko jouse, lengpa Janel Pakai hou dinga Jerusalem'a hungtou lou chan chunga chu go julou ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Egypt gam inko achetou lou uva, ahung daoleh, amahon go amu loudingu; houbuh kut mang dinga chetoulou Pathen houlou ho kijepna ding hise chu chang dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichu Egypt mite engbolnale, houbuh kut manga hunglou nam jouse engbolna hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiche nikho chule sakol ho ki-o long chunga chu PAKAIYA DINGA ATHENG tia kijih ding; chule Pakai houin sunga bel ho jong maicham angsunga um sumlheng ho tobang hidiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Henge, Jerusalem le Judah gama bel ho jouse chu janel Pakai dinga atheng hiding ahitai. Chule ganlhaina neijouse chun hung laovintin, an hona-a aman diu ahi. Chule hicheni chule janel Pakai in'a chu Canaan mi himhim umtalou ding ahi.
  </para>
</usx>
