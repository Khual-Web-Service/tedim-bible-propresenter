<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JOL" style="id">Joel</book>
  <para style="h">Joel</para>
  <para style="toc1">Joel</para>
  <para style="toc2">Joel</para>
  <para style="mt">Joel</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathuel chapa Joel henga Pakai thu hung lhung chu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangho tehse hon hichehi ngaijun, chule gamsunga cheng miten nabonun nanakol sungun. Hichehi nangho nikholai, ahiloule napu napateu nikho laijenga jong anasoh khamong nam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichehi nachateo seipeh unlang, nacha teovin jong amaho chate seipehson uhen; chule amaho chun khangkitna achateu chu seipehson kit uhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lusu lung hon anehmoh-u chu khaokhohon anen, khaokho ho nehmoh chu thinglungin anen, thinglung nehmoh chu lungmulin aneh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jukham nangho thouvun lang kapmun, chule lengpitwi thah jeh-in, lengpitwi don jouse pengun, ajehchu hichu nakam uva kona kisatlha ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ajehchu thahat tah namkhat, amijat simjoulou, kagamsunga ahung umdoh-in; ahaho keipi bahkai ha tobang ahin, chule keipi bahkai lentah khalhang aneijin ahi
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman kalengpigui asumangin, kathei chang phung thinghoh akhoh doh-e, aman hichu akhohtheng selin, chule apaimange, hitichun abahho jong agotsahtai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akhang donlai a-inneipu dinga khaodip pon kisila nungah theng bangin kapmin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Neh thilpeh le don thilpeh chu Pakai ina konin akipaidoh tan, Pakai lhachaho, thempuho alunghemuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Loujao manlou ahitan, gamsungin pul adou tan ahi; ajehchu chang agamtai, lengpitwi thah akangin, chule thaotwi alhasam tai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo loulhouho, nangho jahchaovin; vo lengpilei malngim ho, suhlou changle sakolchang jehchun maovun; ajehchu louva chang atding chu abeiheltan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lengpigui chu agoptan, theichang phung chu agatapoi; kolbuthei phung, lusuphung, theithup phung, chule loulaija thingphung jouse geijin agop gamtai; ajeh chu mihem chate-a konin kipana kitichu abeitan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangho thempuho, nakong kigah-un chule kapmun; maicham phunga natongho maovun; hungun, Pathen natong nangho khaodip pon kisilun lang jan khovah in lumun; ajehchu nehledon thilpeh chu na Pathen in'a kona kiladoh ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangho, an ngolin kisuthengun, khoppi theng khat kouvun, Pakai na Pathen insunga upaho chule gamsung mi abonchan khomun lang Pakai henga taovun.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ohe, chuche nikho chu da aume! ajehchu Pakai nikho chu ahung naitai, chule Hat chungnung Pakaiya kona suhmangna khat hunglhung ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Imaikoh laitah uva anneh kisatlha hitalou ham, henge, kipa thanopna chu Pakai i-Pathen'u insunga kona kiladoh-a hitalou ham?
  </para>
  <para style="p">
    <verse number="17" style="v" />Muchi chu leilhang noija amontan, chang kholna ahomkeo ahitan,chule changsal ho asegamtai; ajehchu changchu goplha-a ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gamsaho chu iti penpen jeng hitaovam! ganchaho le ganhonho hamhing umlou jeh-in alung dongun; henge, kelngoi honho jong kinepna bei ahitaove.
  </para>
  <para style="p">
    <verse number="19" style="v" />O Pakai, nahenga katao ahi; ajehchu gamthipma hamhing jong meijin akan, chule loujaova thingphung jouse jong meikongin akachai tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vadung twiho akan gamtah jehle, gamthipma hamhingho meijin akahgam tahjeh-un, loulaija gamsaho jengjong nangma kounan apengun ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nanghon Zion'a sumkon chu mut un, chule keima moltheng chunga kiginan hasapmin samleuvin, gamsung mite jouse kihot hen, ajehchu Pakai nikho chu anaitai, hichu hung lhung ding ahitai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Muthim nikhole lungjina nikho, meibol kai nikhole satah-a thimjina nikho chu, jingkho vah-in molchung ho ahinsal banga hunglhung ding ahi; tumasanga ana umlou, tunungteng jongle akhang akhanga hungum kit louhel ding, mipi nasatah le hattah khat hung kisepdoh ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho masang chu meijin ahalvam peh-in, anunguva mei akongin; amasanguva gamsung chu Eden hon abangin, anunguva manthah na neldi gam abange; amaho-a kona chu koimacha jamdoh theilou ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amelu chu sakol ho melso tobang ding, chule sakol chung toumi bangin alhaijun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaho chu molsang chunga sakol kangtalai lhaigin banga kichom dingu, changpol mei kahgin banga gingthethu le, mihat tah galvon kivona galsat dingkon bangding ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amaho masanga mite chu thohgim lheh dingu; chule mihem maijouse thimlha ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho chu mihattah ho banga lhaidingu, galsat miho banga kul chunga jong kaldoh dingu; chule amaho ama ama lampi cheh-a chediu, adinmunhou asuhkhel lou diu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho khatle khat kisatto lou dingu, ama lamlhongpi cheh-a chediu; chule chemjam achunguva achuh tengle, amaho kisukhalou dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amaho khopisunga suhlhai toulhai juntin, kulbang chunga lhaidiu, amaho in chung ho-a kaldoh uva, bangkot ho-a gucha banga lutdingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho masanga leiset kihotling ding; vanho kithing ding, nile lha thim ding; chule ahsi ho vahdoh talou ding ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Pakai chun agalmite anga thu aseiding ahi: ajehchu agebuh chu loupitah ahin, athu tong molsoji ama jong hattah ahi; ajehchu Pakai nikho chu loupitah le tijat umtah ahin chule koi ham ading jou dinga?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun tun, nangho nalungthim pumpiuvin, an ngol pumin, kaple lhasepum in keima henglama hung kiheijun, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="13" style="v" />Navonhou hilouvin nalung sungu botkeh unlang, Pakai na Pathen'u henga kileuvin, ajehchu ama khotonale hepina-a dimset, lunghang vahjilou, lungsetna lentah nei ahin, chule thilphalou aboldinga kona alung aheiji ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama ahung kileheija alung ahinhei kitna, Pakai Pathen dinga an neh thilto le don thilto, itobang phattheiboh nadalhah pehding kon ija ahetnem?
  </para>
  <para style="p">
    <verse number="15" style="v" />Zion sumkon chu mut un, an ngolin kisuthengun, khoppi loupi khat kouvun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mipi khomuvin lang, houkhom ho suthengun, upaho khom khomuvin lang, chapanghole naosen noichep nalaiho geijin khomun; moulang chu a-indan sunga konin chedohhen, chule mounu jong alupna dana konin hungpotdoh hen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thempuho, Pakai lhachaho chu maicham phungle hongcha kah-a kapmuhen, chule amahon, Vo Pakai namite hinghoijin, chule Pathen hephalouten nagoulo mite chunga i-sah louvin vai hom daohen, ipi jeh-a amaho chun miho lah-a a-Pathen'u hoija uma ham ati dingu ham; tin seiju hen
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutengle Pakai chu agamsung dinga hung thang thipma, chule amite chu alungset ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Henge, Pakai chun adonbutna amite jah-a, veuvin, keiman nangho dinga chang, lengpitwi chule thaotwi kahinsol ding, chule nangho hicheho-a chu nalunglhai diu, chule keiman nangho Pathen heloute lah-a i-sah louva kabolkit louding nahiuve, tin aseije.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinla keiman sahlam galmiho chu nangho-a kona gamlatah-a kachondoh ding, gam galou le manthah na gama kanolut ding, amai chu solam twipi lama, chule anunga hochu lhumlam twipi lama kanolut ding, chule auile anamset hung kikhodoh ding ahi; ajeh chu aman thil lentah anaboltan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kicha hih in, vo leiset, kipah inlang thanomin, ajeh chu Pakai in thil loupitah abolding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangho gama um gamsaho kicha hih-un, ajehchu gamthip gama hampaho chu hungdon doh ding, thingphungin aga ahin sepding, lengpi guile theichang phung jong agathei chana hung gading ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuti ahile, nangho Zion chate kipah-un, chule Pakai na Pathen'a thanomun, ajehchu aman nangho dinga gomasa chu ahin juhlhah sah ding, aphabep seuva napeh diu; go nunung jong lhamasa sunga ahin juhlhah sah ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu changphol chu sakolchang dimset ding, chule bel jouse jong lengpitwi le thaotwi letsoh ding ahi
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule keiman ka sepai nasatah chu nalah uva kahin sole, thinglung, lungmul chule tum lungle khaokhohon, kum tamtah-a ananeh jouse-a chu kakile dohsah kitding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule nanghon ninglhing tah-a naneh uva, nalungu lhaisel ding, chule kidangtah-a nanabol pau Pakai na Pathen'u min navahchoi diu ahi: chutia chu kamiten jachatna tohtalou helding ahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule nanghon keima Israelte lah-a um, koima dang hilou Pakai na Pathen'u kahi nahet diu, chutia chu kamite jachatna-a chuta louhel ding ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule khonungle hung hiti ding ahi, Keiman tahsa hing jouse chunga kalhagao kabuh lhah ding, nachapateo le nachanu teovin gaothu aseidoh dingu, na-upa houvin mang amatdiu, chule nakhang dong houvin mu aneidingu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule hiche niteng chule soh pasalhole, soh numei ho chunga jong kalhagao kabuh lhah ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule keiman vanho le leiset chung, thisan, mei chule meikhu khompiho chunga thil kidang kavetsah ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Loupitahle tijat umtah Pakai nikho hunglhun masanga chu, nisa thimsoh-a, lha thisan sohding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule hung hiti ding ahi, Pakai min pana tao chan chu koi hijongle huhhing-a umding ahi. Ajeh chu Zion molsang le Jerusalem'a huhdohna umding, Pakaiyin asei banga, akou amoh moh ho lah-a hoidohna lhung ding ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ajehchu, veuvin, chuche nikhole, hiche phat sung, keiman Judah le Jerusalem sohchana-a kon kahin lepui teng,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ken jong nam jouse kakhopma, Jehoshaphat phaichama kapuisuh ding, chule kagou, kami Israelte vannoi namtin holah-a athecheh uva, kagam asuhkeh jeh uva athu-u katan ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amahon kamite-a dingin vang ave-un, pasal chapang chu noti mandin apedoh-un, judon nadin numei chapang chu ajoh-un ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahi, keima dinga ipi nabol dingu ham, Vo Tyre, Zidon chule Palestine gamkol sunga umho, nanghon keima neilethuh dingu ham? neilethuh ule, neilethuh naochu, kintah-a naluchung cheh uva kalethuh kitding nahiuve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu nanghon keima dangkale sana nakilah-un, chule kathil manluho chu nahouin sunguva napolutnun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanghon agamgiuva kona gamlatah-a natolmang thei nadiuvin, Judah chatele Jerusalem chate chu Greek mite henga najoh doh-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Veovin, keiman najohdohnao mun laitah-a chu amaho kadindohsah ding, chule achunga nachonnao chu keiman nalu chunguva kalethuh ding nahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule keiman nachapateo le nachanuteu chu Judah chate khutna kajoh ding, chule amahon gamlatah-a Shebea mite henga ajohson diu ahi, tin Pakaiyin aseije.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chidang namdangho lah-a hichehi phongjalun, gal din kigouvin, mihat hochu thou uhen, galsat mi jouse hungnai juhen lang, hungdoh-u hen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nalangkon hou chu chemjamin khengun, nahampa chetannao chu tengchan semun, hatmohon keima kahatne tiuhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangho Pathen hephalouho, kikhomun lang, hungun, chule hungkikhom kimvelun, Vo Pakai, chua chun nangman namihat ho chu hungsuh sah-in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathen hephalouho thou uhen lang Jehoshaphat phaichama hungdoh uhen, ajehchu chua chu keima katouva akimvela um Pathen hephalouho thu katanding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nakoiteu pannun, ajehchu chang amintan; hungin, hungkum lhan; lengpitwi hehna chu adimtan, athaoho alonglet tai; gitlouna chu alenlheh tai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipi tamtah, kigel lhuhna phaichama chun mipi tamtah aumtaove; ajehchu kigel lhuhna phaichama chun Pakai nikho ahung naitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nisale lhathah thimsoh intin, chule ahsi ho vahlou ding ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakai chu Zion'a kon hung kitumintin, chule Jerusalem'a kona aw hunging ding; chule vanho le leiset kihot ding; ahivanga Pakai chu amite kinepna hintin chule Israel chate thahat kona hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiti achu keimahi Pakai na Pathen'u, kamolsang theng Zion'a chengpa kahichu neihet dingu ahi: chutengle Jerusalem chu athenga uma, chule amaho lah-a chu jindangho vahle louding ahitai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule hiche nikho chule hung hiti ding ahi, molsang dunga lengpitwi thah hunglong lhading, chule lhang dunga kona jong bongnoi hunglong ding; Judah gamsunga vadung long jouse-a twi longdima, Pakai insunga kona twinah khat hunglong doh-a, hichun Shittim phaicham dung twi achapnou ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Juda chate chunga akhanset jeh ule, agamsung uva monabei thisan asosahjeh uva, Egypt chu hakamna mun hiding, chule Edom chu hakamna gamthip sohding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijongle Judah chu a-imatih-a chenna mun hiding, chule Jerusalem chu akhang akhanga chendenna mun hiding ahitai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ajehchu keiman kana suhtheng loulai athisan chu kasuhtheng ding ahi: ajehchu Pakai chu Zion'a chengah ahi.
  </para>
</usx>
