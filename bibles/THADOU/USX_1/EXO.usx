<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EXO" style="id">Potdohbu</book>
  <para style="h">Potdohbu</para>
  <para style="toc1">Potdohbu</para>
  <para style="toc2">Potdohbu</para>
  <para style="mt">Potdohbu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichehi Egypt gama hunglutna Israel chateho min chu ahi; amitakip le a-insung miteu Jacob toh ahungun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Reuben, Simeon, Levi, chule Judah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Issachar, Zebulun, chule Benjamin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Dan le Naphtali, Gad le Asher,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Jacob taiguija kona pengdoh mihing chu aboncha mi somsagi ahiuve. Joseph vang chu Egypt gama ana umsa ahitai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Joseph le asopite chule chuche khanga miho jouse chu athigam taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujouvin Israel chate chu achipha lheh jengun, apungtul tullun, atamlheh jeng taovin, chule hattah ahitaovin; gamsung chu alosoh taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tun Egypt gama chun Joseph hephalou lengthah khat ahung lengchang tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman amite jah-a, Veuvin, Israel chate mipi hi eiho sangin atamjouvin, chule ahatjouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hungun, eihon amaho hi chingthei tah-in bolu hite: achuti louleh amaho pungcheh cheh-untin, hung hitiding ahi, gal kisatna khattou ahung umteng, amaho imelmateu lama hung pangun tin, eiho eisat untin, hitichun gamsunga konin potdoh getnunte, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hijeh chun amahon apohgih houva amaho gimbol dingin achunguva tohvai homho apansah taove. Chule amahon Pharaoh dingin gou kholna khopiho Pithom le Rameses asauvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahivangin amahon amaho chu abolgim chanun apung cheh-un, akhangcheh cheh-un ahi. Chuin amahon Israel chate jehchun alunggim taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Egypt miten Israel chate chu gimtah-in ana-u atohsah-un ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amahon natoh hahsatah ho bon nganin, cheh-in, chule loujaova natoh jat tintangin ahinkhou chu asugenthei lheh jengun: ana-u atohsahna jouseuva genthei tah-in atohsah-un ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Egypt lengpan Hebrew mi naososah teni, khatnu min Shiphrah le khatnu min Pu-ah chu akihoupin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajah lhona, Nangnin Hebrew numei ho nao nasosah lhonteng, naososahna touna chunga chun amaho chu velhonin; iti hama hichu pasal ahile natha lhonding ahi: ahin numei ahivangle hinghoi lhonin, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin naososah teni chun Pathen aging lhonin, Egypt Lengpa thupeh bangchun abol lhonpon, ahin naosen pasal ho chu ahinghoiji lhonin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuphatnin Egypt lengpan naososah teni chu akouvin, ajah lhona, Ipi dinga hicheho hi nabol lhona, naosen pasal ho chu nahing hoi lhon ham? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin nao sosah teni chun Pharaoh jah-a, Hebrew numei hohi Egypt numei ho tobang ahilou jeh-u ahi; ajehchu amaho adamtheijun, nao sosah ho ahengu alhun masangle anasoh lhaji taovin ahi, atilhone.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutichun Pathen'in nao sosah teni chung chun aphalam tah-in na atongin ahi: chuin miho chu apung tul tul jengun, nasatah-in ahatdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin ahitin ahi, nao sosah teni chun Pathen aginjeh lhonin, a-insungmi lhonding apen ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pharaoh'in amite chu athupeh-in, Pasal chapang pengtapou chu vadunga seplutnun, numei chapang tapou chu hing hoijun, atitai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Levi phunga peng pasal khat achen Levi chanu khat ji dingin akipuitan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin amanu chun nao avopmin, chapa khat ahingtai. Amanun ama chu naosen hoitah ahichu amu phatnin, lhathum aselin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amanun ama chu aselbe joulou phatnin, pumpenga kisa sinkhup khat alan, thingnai man le vahaibonin aloibitnin, asunga chun naosen chu akhumin; vadung kama peng lah-a chun agakoitai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule achunga ipi ahung sohdem ti ve dingin asopinu chu gamlatah-a adingin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pharaoh chanu chu kisil dingin vadunga chun ahung suh-in; chule asoh numei ho chu lui panga chun avah leovin ahi: chuin amanun peng lah-a sinkhup chu amuphatnin, hichu galadin asohnu chu asolin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amanun hichu ahon phatnin naosen chu amutai: chule, veuvin, naosen chu ahung kapmin ahi. Chuin amanun amapa chu alung asen, Hichehi Hebrew chate lah-a khat ahi, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chujouvin a-unu chun Pharaoh chanu jah-a chun, Keima kache-a hiche naosen hi nadonpeh dinga Hebrew naodon numei kaga koupeh ding ham? ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pharaoh chanun amanu jah-a, Chen, ati. Chuin nungahnu chu achen, naosen nuchu agakoupeh tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pharaoh chanu chun amanu henga, Hiche naocha hi kipuijin lang keima dingin neihin vah peh-in, chule keiman natohman kapeh ding nahi ati. Chuin numei chun chapang chu akipuijin, avahtan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin chapang chu ahung khandoh phatnin, naodonnu chun Pharaoh chanu henga ahinpuijin, ama amanu chapa ahitan; chule amanun amin Mosi asah tai: Ajehchu keiman twilah-a kona kalahdoh ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin hiche laichun ahitin ahi, Mosi akikhanlhit phatnin, asopite henga agachen, apohgih-u chu agaven ahile, Egypt mikhatnin asopi Hebrew mi khat aden chu amulhi tan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman akimvel dung avelen, koimacha amulou phatnin Egypt mipa chu athatnin, neldi lah-a aselin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule ani ni channia apotdohkit phatnin, veuvin, Hebrew mi ni akidel lhonin: aman athemo jopa henga, Ipidinga nasopi naden ham? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amapan, Keiho chunga pipui le thutan dinga kon natunham? Egypt mipa natha banga chu keijong thading neigot ham? ati. Chuin Mosi akichatan, Tahbeh-a hiche thilhi kihedoh-a ahitai, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tun Pharaoh'in hichehi ajah phatnin, Mosi chu thadingin aholtan ahi. Ahin Mosi Pharaoh maikoh-a konin ajam mangin, Midian gama achengin: chule ama twikul panga atouvin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tun Midian thempupa chun chanu sagi aneijin ahi. Chuin maho chu twi thalin ahungun, apa kelngoihon chip dingin kongho chu athal dimun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin kelngoi chingho chu ahungun amaho chu anodoh-un ahi: ahivangin Mosi adingdoh-in amaho chu akithopin, akelngoi honu chu twi achipsah-in ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amaho apau Reuel henga ahung phatnun, aman ahenguva, Iti dana tunia nahiti hungvah uham? ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahon, Egypt mikhatnin kelngoi chingho khutna konin eihuhdoh-un, chule keiho dingin lhingsetnin twi jong eithal peh-un, kelngoihon jong twi achipsah-in ahi, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman achanute jah-a, Ama chu hoija umtam? ipidinga mipa chu nahin dalhah-u ham? an nedingin gakouvun, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Mosi chuche pa toh chending chu anomtan: chule aman achanu Zipporah chu Mosi apetan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin amanun chapa khat ahinpeh-in, amin Gershom asahtai: ajehchu aman, Keima mi gama khopema kahi, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin phat chomkhat jouvin ahitin ahi, Egypt lengpa chu athitan ahi. Chuin Israel chate chu asohchan jeh-un akhoisauvin, akapmun, chule asohchan jeh uva akanao chu Pathen kom alhungtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pathen'in akhoisat nao chu ajahpeh tan, Abraham, Isaac, chule Jacob toh akitepna chu ageldoh tan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pathen'in Israel chate chu ahinven, amaho chu akhohsah tan ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun Mosi'n Midian thempu anupa pa Jethro kelngoihon achingin ahi. Chuin kelngoihon chu neldi gam nunglam panga chun apuijin, Pathen molsang Horeb ahunglhung tan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakai Vantil chu hamboh lah-a konin meikongin ahung kilah-in ahi. Chuin aman aven ahile, veuvin, hamboh chu meikongin akouvin, ahinla hamboh chu akavampon ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi'n, Tun keima kiheijing ting, i-atile hamboh khu kalouham, hiche melchihna nasatah hi gavenge, atin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin avedinga akihei chu Pakaiyin amu phatnin, hamboh lah-a konchun Pathen'in ahin kouvin, Mosi, Mosi, ati. Chuin aman, Hikoma kaume, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman, Hilam hin nai hih-in: nakenga konin nakeng chot sutlhan, ajehchu nadinna chu muntheng ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chukalvallin aman, Keima napu napate Pathen, Abraham Pathen, Isaac Pathen, Jacob Pathen kahi, ati. Chuin Mosi'n amai aseltai: ajehchu aman Pathen avet ngamlou ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin, Keiman Egypt gama kamite kisuh genthei kichen tah-in kamutan, chule tohvai homho jala akanao kajatai; ajehchu keiman agenthei nao kahetai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Egypt miho khutna kona huhdoh dingle amaho chuche gama kona chu puidoh-a, gamphatah le gamlentah khoiju le bongnoi lonna gam, Canaan mite, Hit mite, Amor mite, Perizz mite, Hiv mite, chule Jebus mite gama puitou dinga hung kumlha kahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeh chun tun, ven, Israel chate kana chu kakom ahung lhung tai: chule Egypt miten amaho abolgenthei nao jong kamudoh tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun tun hungin, kami Israel chate Egypt gama kona napuidoh theina dingin Pharaoh henga nasol ing kate, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Mosi'n Pathen henga, Keima koi kahia, Pharaoh henga kache-a, Egypt gama kona Israel chate chu kagapui doh ding ham? ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin aman, Tahbeh-a keiman nangma kaumpi ding nahi; chule hichehi keiman kasol nahi amelchihna hiding ahi: nangman miho chu Egypt ma kona nahin puidoh teng, hiche molsanga hi Pathen najen dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi'n Pathen henga, Vetan, keima Israel chate heng kagalhuna, amaho jah-a, Napu napateu Pathen'in naheng uva eihinsol ahi, kati tengle; amahon, Amin ipiham? tia ahinsei tei dingu ahin, ahenguva ipi kasei ding ham? ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pathen'in Mosi henga, KEIMA CHU KEIMA KAHI: chule Israel chate jah-a chu KEIMA kitipan nangho henga eihinsol ahi tia nasei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chukal valin Pathen'in Mosi jah-a, Israel chate henga chun, Napu napateu Pakai Pathen, Abraham Pathen, Isaac Pathen, chule Jacob Pathen'in naheng uva eihinsol ahi: hichehi tonsotna kamin, chule nakhang khanguva neihet jingna dingu ahi tin seipeh-in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chen, Israel upaho chu gakhom khomin lang, ahenguva, Napu napateu Pakai Pathen, Abraham Pathen, Isaac Pathen, chule Jacob Pathen chu kahenga ahung kilah-in, kajah-a, Keiman nangho tahbeh-in kahung vilun, chule Egypt gama nachung uva kibol chu kamutan:
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin keiman, Nangho Egypt suhgentheina-a kona kapuidoh uva, Canaan mite, Hit mite, Amor mite, Perizz mite, Hiv mite, chule Jebus mite gam, bongnoi le khoiju lonna gama chu kapuilut dingu nahiuve, tin kaseije, gatin.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutengle amahon nathusei angai dingu ahi. Chutengle nangma le Israel upa ho Egypt lengpa koma nahung diu, ajah-a, Hebrew mite Pakai Pathen'in keiho eikimu piuvin ahi: tun Pakai ka Pathen'u henga ganlhaina kaganei nadingun, gamthipma nithum lampi neiche sah-un tia nahenga kataovu ahi, tia nasei dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahin Egypt lengpa chun khut thahat tah tilouva nasoldoh louheldiu ahi ti kichen tah-in kahei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule keiman kakhut kahin lhandoh ding, alah uva kabolding thil kidanga chu Egypt kajepding: chujouteng aman nangho nasoldoh dingu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule keiman Egypt mite mitmu-a hiche mitehi khotona kapeh ding, chule hung hiti ding ahi, nangho nache tengule agoh-a nache lou dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin numei takipmin a-inheng le a-in'a pemho henga dangka le sana-a kijepna ho, ponsil nihchen ho apa-a alah dingu: hicheho chu nachapa teo le nachanu teo najepnadiu; hitia chu nanghon Egypt mite chu nachom dingu ahi, ati.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi'n adonbutnin ajah-a, Hijongle ven, amahon eitahsan lou dingu, kathujong angailou dingu ahi: ajehchu amahon, Nahenga Pakai akilahpoi ati dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pakaiyin ahenga, Nakhutna umchu ipiham? ati. Chuin aman, Tenggol ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman, Tolla seplhan ati. Chuin aman hichu tolla aseplhan ahile gul asohtan; chuin Mosi chuche masanga konchun ajamtan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Pakaiyin Mosi jah-a, Nakhut lhangin lang hichu ameijin manin; (Chuin aman akhut alhangin, amanin ahile, akhutna tenggol asoh kit tai:)
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahon apu apateu Pakai Pathen, Abraham Pathen, Isaac Pathen, chule Jacob Pathen chu nahenga ahung kilahnai ti atahsan theina dingun, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin ahenga asei kitnin, Tun nakhut chu na-opma koijin, atin ahi. Chuin aman akhut a-opma akoitan ahi: chuin hichu alahdoh phatnin, veuvin, akhutchu aphah-in buhbang bangin abangtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun aman, Nakhut chu na-opma koikitnin, ati. Aman akhut chu a-opma akoikitnin ahile, a-opma akhut chu atidang bang bang ahi kit tai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hung hiti ding ahi, amahon nangma natahsan lou uva, chule melchihna masajong chu angai louvule, amahon melchihna nunung joh chu atahsan dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule hung hiti ding ahi, Amahon hiche melchihna ni teni jonghi atahsan lou uva, chule na thusei jong angai lou uva ahileh, nangman vadung twi nalah-a, tolgo chunga nasunlhah ding ahi. Chule nangman vadunga kona nalahdoh twi chu tolgo chunga chu thisan hungsoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Mosi'n Pakai henga, Vo ka Pakai, keima tumasangin jong, chule nangman nasoh henga thu nahinseija patnin jong mi kamnal kahipoi: ahin keima thusei ngongkai le lei kipehlou kahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin ama henga, Mihem kam sema koiham? Ahiloule paomo le na-ngong, chule kho muthei le mitcho sema chu koiham? Pakai keima kahi hilouham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hijeh chun tun chen, keiman nakam kaumpi jinga, nasei ding kahil ding ahi ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman, Vo ka Pakai, nahenga katao ahi, nangman nasolnom dang khat solmaijin ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakai lunghanna chu Mosi chunga akoujahtan, ahenga, Levi mi nasopipa Aaron uma hilouham? aman thu phatah-in aseitheije ti kahei. Chujongle ven, ama nangma kimupi din ahungdoh-e: aman nangma namuteng alungsung kipahding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangman ama henga thu nasei ding, akamsunga thuho nakoipeh ding ahi: chule keiman nangma kam le ama kam kaumpi ding, chule nabol lhonding kahil ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule amachu nangma dinga mipi ho henga thuseija pangding: ama chu nangma dinga nakam khela panga, chule nangma ama dinga Pathen khela napan ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nangman hiche tenggol hi nakhutna nakichoi ding, hichea hi melchihna ho nabolding ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Mosi anupa pa Jethro henga ahung kilen, ajah-a, Nahenga katao ahi, Egypt gama kasopite henga kinungle kit dingin neisolin, hingnalai naovem gavenge, ati. Chuin Jethro'n Mosi jah-a, Lung mongin chetan, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakaiyin Midian gama Mosi henga, Chen, Egypt gama kilekit tan, ajehchu nangma thadinga nahol ho jouse chu athigam taove, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Mosi'n a-inneipi le achapate chu apuijin, sangan chunga atousah-in, Egypt gama akiletan ahi. Chule Mosi'n Pathen tenggol chu akhutna akichoijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin Mosi jah-a, Ven, Egypt gama nakile teng nakhutna kakoi thil kidang ho jouse chu Pharaoh angsunga nabol ding ahi: hijongle aman miho chu asoldoh louna dinga Pharaoh lung chu katahsah ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nangman Pharaoh jah-a, Pakaiyin hitihin aseije, Israel chu kachapa, apeng masapen ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule keiman najah-a kasei ahi, Aman keima eijen theina dingin kachapa chu soldoh tan: chule nangman ama soldoh ding nanop louva ahile, ven, keiman nachapa katha ding, apeng masapentah chu kathading ahi, tia nasei ding ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule lampia jinlhun in'a chun ahitin ahi, Pakaiyin ama chu akimupin, thadin aholtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichun Zipporah'in meituh songhem khat alan, achapa chep atanpeh-in, hichu akengbula aseplhan, Tahbeh-in nangma hi keima dinga thisanso inneipu nahi, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitichun amachu alhadoh tan ahi. Chuin amanun, Cheptan jeh-a chu nangma keima dinga thisanso inneipu nahi ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Pakaiyin Aaron henga, Gamthipma Mosi kimupi din chen, ati. Chuin ama achen, Pathen molsanga chun ama akimupin, achopmin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Mosi'n Aaron henga chun asolpa Pakai thusei jouse le athupeh melchihna jouse chu aseipehtan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi le Aaron achelhonin, Israel upaho jouse akhom khom lhontai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Aaron'in Pakaiyin Mosi henga asei thu jouse chu aseijin, miho mitmun melchihna ho chu aboltan ahi:
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin mipi chun atahsan taove. Chuin Pakaiyin Israel chate avila, athohgimnao ahinvet pehchu ajah phatnun, amaho akunun Pathen ahou taovin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuche jouchun Mosi le Aaron alut lhonin, Pharaoh henga, Israel Pakai Pathen'in hitin aseije, gamthipma keima dinga Kut aboltheina diuvin kamite solin ati, tin asei lhonin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahinla Pharaoh'in, Pakai chu koi hija, keiman athu kangaija Israelte kasoldoh ding ham? Keiman Pakai chu kahepon, Israelte jong kasoldoh louding ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun amanin, Hebrew mite Pathen'in eikimupi lhon ahi. Nahenga kataolhon ahi, Pakai ka Pathen'u henga ganlhaina gabol dingin nithum lampia neisolun: achutiloule aman ichunguva gamna hise ahiloule chemjam achuhsah ding ahi, atilhone.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Egypt lengpan amani henga, Nangni Mosi le Aaron'in ipidinga mipi hohi anatoh-u nangahsah lhonham? napohgih hou gakipoh thim thimun, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pharaoh'in, Veuvin, hiche gam mihohi tun tamtah ahiuvin, nangnin amaho chu apohgih houva konin nakicholdo sah lhontan ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin chuche nile le chun Pharaoh'in tohvai poho le alamkai ho athupeh-in, ajah uva,
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanghon masanga banga chu miho chu cheh aden nadingu changpol napehkit lou dingu ahitai: amaho cheohen lang amaho ding cheh pol gakihol khomu hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule tumasanga acheh denjiu jatjat chu nadensah jing dingu: hichea kona chu nalhomsah loudiu ahi: ajehchu amaho thaseuva ahi; hijeh-a, Ka-Pathen'u henga ganlhaina gabol dingin neisolun tia pengu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hahsa tah-a atoh diuvin chuche miho chunga chun natoh hahsacheh koibe peh-un; amahon thumanlou ngaisah daohen, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin mipi tohvai poho le toh lamkai chu achedoh-un, mipi ho henga chun, Pharaoh'in hitihin aseije, Keiman nangho changpol kapehlou dingu ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangho cheovin lang namu nathei theijuva pol gakiholun; hijongle nanatoh-u chu kilhomsah deh louding ahi, agatiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutichun mipi chu changpol khela manding changkung gakhom khom dingin Egypt gam pumpi-a akithecheh taovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin tohlamkai ho chun amaho chu anouvin, nanitin natoh houchu changpol aumlai bang chun tong bukimun, atiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pharaoh toh lamkaiho chun mipi ho chunga apansah Israel chate lamkaiho chu avouvin, Ipi dinga nacheh dennu natoh chu masanga banga janhi le tunia nabol bulhit lou uham? tin aphohsal taovin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichun Israel chate lamkaiho chu ahungun Pharaoh henga agakapmun, Ibola nangman nasohte hi neihiti bolu hitam?
  </para>
  <para style="p">
    <verse number="16" style="v" />Nasohte hi changpol la eikipe pouvin, chule amahon kahenguva, Cheh denguvin eitiuvin ahi. Chule ven, nasohte hi eivouvin, ahivangin athemmo chu namite ahiuve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahivangin aman, Nangho thase nahiuve, nangho thase nahiuve: hijeh-a chu nanghon, Cheohitin Pakai henga ganlhaina gabolu hite natiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hijeh chun tun cheovin lang na gatongun: ajehchu nangho changpol kipelou ding nahiuve, hijongle nacheh dendiu jat chu nabulhit dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanghon niseh-a nanatoh naova na cheh dendiujat chu nalhomsah loudiu ahi tia akiseipeh phatnu chun, Israel chate lamkaihon achunguva thilphalou chua ahitai ti amudoh taovin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amaho Pharaoh koma kona ahungpot doh-u toh kilhonin, lampia anading Mosi le Aaron chu akimutopi taovin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin amahon amani henga, Pakaiyin nave lhonhen lang nachung thu lhon tanhen; ajehchu nangnin keiho thana dinga akhutnuva chemjam koina dingin Pharaoh mitmu le asohte mitmun thet umtah in neisem taovin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Mosi Pakai henga akinungle kitnin, Pakai, ipi dinga hiche mite chungahi phalou tah-a na natoh ham? Ipi dinga neisol ham?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Pharaoh henga namina thusei dinga kahunga pat hin, aman hiche mite chunga thilse abol jingin; chule nangman jong namite nahuhdoh hihhelin ahi, ati.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Pakaiyin Mosi henga, Keiman Pharaoh chunga ipi kabol ding tu-a hi nangman namu ding ahi. Ajehchu khut thahat hin amaho chu asol ding, chule khut thahat hin amaho chu agamsunga kona adeldoh tho sah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Pathen'in Mosi henga thu aseijin, ajah-a hitin aseije, keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keima Abraham, Isaac, chule Jacob hengah Pathen hat chungnung minin kana kilah-in; ahinla amahon kamin JEHOVAH hin eina hepouvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule gamdangmi ahinao akholjina gamu Canaan gam chu amaho pehdingin keiman amahotoh kakitepna kaphut doh-in ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Egypt miten sohchanga ahennaova Israel chate akhoisatnao jong chu kajan; chule kakitepna chu kageldoh tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hijeh chun Israel chate henga hitin seijin, Keima Pakai kahin, chule Egypt mite pohgih ho noija kona kapui diu, apohgih houva kona kalhadoh uva, chule keiman ban jahdoh le thutanna nasatah puma kahuhdoh ding nahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule nangho kamite hidinga kalah uva, chule keima na-Pathen'u kahi ding: chule Egypt mite pohgih ho-a kona napuidoh uva Pakai na-Pathen'u kahichu nahetdingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham, Isaac, chule Jacob henga pehdinga kana kihahselna gamachu kapuilut ding nahiuvin; chule hichu nagoulo diuva kapeh ding nahiuve: keima Pakai chu kahi, tin, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n Israel chate hengah thu aseijin; ahivangin alhagaovu ahesoh jehle asoh channu akhoh behseh jehchun Mosi thusei chu angaipeh pouvin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chenlang Egypt lengpa Pharaoh chun agama kona Israel chate asoldoh nadingin gaseijin, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mosi'n Pakai henga, Vetan, Israel chaten bon kathu angailou uva ahile; Pharaoh'in keima kam chepkitanlou thuhi iti angaiding ham? ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin Mosi le Aaron henga thu aseijin, Egypt gama kona Israel chate puidoh nadingin, Israel chate le Egypt lengpa Pharaoh'a henga seiding thu apen ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichenghi apu apateo insung aluchangho chu ahiuve; Israel'a kona apeng masapen Reuben chapate chu Hanoch, Pallu, Hezron le Carmi ahiuve. Hichenghi Reuben insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule Simeon chapate chu Jemuel, Jamin, Ohad, Jachin le Zoher, chule Canaan numeinu chapa Shaul ahiuve. Hichenghi Simeon insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hicheng hi amaho khanggui dungjuija Levi chapate min chu ahi; Gershon, Kohath, chule Merari ahiuve. Chule Levi damsung kumkho chu kum jakhat le somthum le sagi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gershon chapate chu, a-insungu dungjuijin Libni le Shimei ahilhone.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Kohath chapate chu, Amran, Izhar, Hebron, chule Uzziel ahiuve. Chule Kohath damsung kumkho chu kum jakhat le somthum le thum ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Merari chapate chu, Mahli le Mushi ahilhone. Hichenghi akhangguiju dungjuija Levi insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Amram'in apa sopinu chanu Jochebed chu aji dingin akipuijin; amanun Aaron le Mosi ahinpeh-in ahi. Chule Amram damsung kumho chu kum jakhat le somthum le sagi ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Izhar chapate chu, Korah, Napheg, chule Zichri ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Uzziel chapate chu Mishael, Elzaphan, chule Zithri ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Aaron'in Amminadab chanu Nahshon sopinu Elisheba chu aji dingin akipuijin; chule amanun Nadab, Abihu, Eleazar, chule Ithamar ahinpeh-in ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Korah chapate chu, Assir, Elkanah, chule Abiasaph ahiuve. Hichenghi Korah insung mite ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Aaron chapa Eleazar chun Putiel chanute lah-a khat aji dingin akipuijin; chule amanun Phinehas ahinpeh-in ahi. Hichenghi a-insungu dungjui cheh-a Levi ho pate bulpiho ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiche teni hi Pakaiyin, Egypt gama konin Israel chate chu galsat miho dungjuijin puidoh lhonin tia asei na Aaron le Mosi chu ahillhone.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiche teni hi ahi Egypt gama kona Israel chate puidohna dinga Egypt lengpa Pharaoh henga thusei teni chu: Hiche teni hi chuche Mosi le Aaron chu ahilhone.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Egypt gama Pakaiyin Mosi henga thu aseini chun ahitin ahi,
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakaiyin Mosi henga thu aseijin, Keima Pakai chu kahi: keiman nahenga kasei jouse chu Egypt lengpa Pharaoh henga seijin, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Mosi'n Pakai angsunga chun, Vetan, keima kam cheptanlou kahin, chule Pharaoh'in iti kasei angaiding ham, ati.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga, Ven, keiman nangma Pharaoh henga dingin pathen'in kasemtai; chule nasopipa chu nangma themgao hiding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangman kathupeh jouse chu aboncha naseidoh ding; chule nasopipa Aaron'in agamma kona Israel chate chu asoldohna dinga Pharaoh henga aseiding ahi
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule keiman Pharaoh lungchang kasuhtah ding, Egypt gamsunga chu kamelchih naho le kathil kidangho kapunsah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hijongleh Egypt gamsunga kakhut kalhah nading le, kagalsat miho le kami Israel chate chu thutanna nasatah-a Egypt gamsunga kona kapuidoh nadinga Pharaoh'in nasei angaideh louding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule keiman Egypt chunga kakhut kajah-a, amaho lah-a kona Israel chate kapuidoh teng, keima Pakai kahi chu Egypt miten ahet dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichun Mosi le Aaron'in Pakaiyin athupeh bang bangin abol lhonin, chuti chun abol lhon tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amanin Pharaoh henga thu aseilhon chun Mosi kum somget alhingtan, chule Aaron chu kum somget le kum thum alhingtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Mosi le Aaron henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pharaoh'in najah lhona, Nangnin thilkidang vetsah lhonin atiteng; nangman Aaron hengah, Natenggol chu lanlang Pharaoh angsunga seplhan, natiding ahi. Chuteng hichu gul hungsoh ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Mosi le Aaron Pharaoh henga alutlhonin, Pakai thupeh bangchun abol lhontan ahi. Chuin Aaron'in atenggol chu Pharaoh masang le asohte masanga aseplhan ahile, hichu gul asohtan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuphatnin Pharaoh'in jong miching ho le doi themho akoukhom tai. Tun Egypt mitpheldoi themho, amaho jong chun adoijuva konin chutobang bang chun aboltheijun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu amaho amitakipmin atenggol cheh-u chu aseplhaovin ahile hicheho chu gul asohtan ahi: ahivangin Aaron tenggol chun atenggol hou chu avallhum gamtan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pharaoh lungsung chu Pakaiyin aseibang chun amani thusei angailouna dingin, Aman atahsah tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Mosi henga, Pharaoh lungsung akisuh tah jeh-a aman miho chu achesah nomlou ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma jingkah le Pharaoh henga gachen: ven, ama twikhuh lama chun achei; chule nangma amato kimuto dinga vadung panga chu nanading ding; chule gul naso sahna tenggol chu nakhutna nakichoi ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutengle nangman ama henga, Hebrew mite Pakai Pathen'in nangma henga, Amahon keima gamthipma eijen theina diuvin kamite chesah-in, tia seidinga eihinsol ahi: ahinla ven, tugeihin hichu nangman nangaipoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakaiyin hitin aseije, Hichea konahi Pakai kahi chu neihet ding ahi. Ven, kakhut na tenggola hi vadunga twi chu kajepding ahin, chule hichu thisan sohding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule vadunga um nga hochu thiding, vadung chu uiding ahin; chule Egypt miten vadunga twi chu donding akidah diu ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakaiyin Mosi henga, Aaron jah-a, Natenggol chu lanlang Egypt twiho chunga, aluidung hou chunga, vadung ho chunga, atuikul hou chunga, chule atuikul hou jouse chunga aboncha thisan asotheina ding le Egypt gam pumpi-a thing kongho le song kongho-a jong thisan aumna dingin nakhut jahdoh-in tin seijin, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakai thupeh bang chun Mosi le Aaron'in abol lhontan ahi; chuin aman atenggol chu alamin, Pharaoh mitmu le asohte mitmun vadunga um twi chu ajeptan ahi; chuin vadunga um twi jouse chu thisan asohtai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin vadunga um nga ho chu athin; vadung chu a-uitan, Egypt miten vadung twi chu adonthei tapouvin; chule Egypt gamsung pumpi-a chun thisan aumtan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Egypt mitpheldoi themho chun adoi uva konin chutobangma chun abolun ahi. Chule Pharaoh lung chu tahsah-in aumin, Pakaiyin aseibang chun aman amani thusei angai dehpon ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Pharaoh chu akiheijin a-insunga aluttan, hiche thuhi alungsunga angaito pon ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Egypt miten donding twi holna-in vadung vel chu alaitauvin ahi; ajehchu amahon vadung twi chu adonthei louvu ahitai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule Pakaiyin vadung chu avoh-a pat nisagi alhingtan ahi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi jah-a, Pharaoh henga gachen lang, ajah-a hitin gaseijin, Pakaiyin hitin aseije, Eijen theina diuvin kamite soldoh tan.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nangman amaho chu nasol nomlouva ahile, ven, keiman nagamsung pumpi uphoh-a kajep ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule vadung chun uphoh atama tam ahinsepdoh ding, hicheho chu na-in sung, na-indan sung, najalkhun chung, nasohte insung, namite chung, nathuh khuh sung, chule nachang bong mehnao kong houva hunglut ding ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule uphoh ho chu nangma chungle namite chung, chule nasohte jouse chunga hung kaltou diu ahi, tin seijin ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin Mosi henga, Aaron henga seijin, Vachadung ho chule vadung hole twikul ho chunga natenggol pumin nakhut chu jahdoh inlang uphoh hochu Egypt gam chunga hungdoh sah-in, tin, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiti chun Aaron'in Egypt twi chunga chun akhut ajahdoh-in ahile uphoh ho chu ahungdoh-un, Egypt gam chu alodim taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin mitphel doithem ho jong chun adoiju chu mangchan chutobangma chun abolun, Egypt gam chunga chun uphoh hochu ahungdoh sah-un ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichun Pharaoh'in Mosi le Aaron akouvin, ajah lhona, Keima le kamite-a kona uphoh hohi alahmang nadingin Pakai henga ngeh lhonin; chutengle Pakai henga ganlhaina boldinga mipi chu kasol ding ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n Pharaoh jah-a, Lunglhai selin neithu peh-in, itih phatle nangma le na-insunga kona uphoh ho suhmanga auma vadunga bou aumna dinga nangma-a ding, nasohte-a ding, chule namite dinga katao dingham? ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, Jingle ati. Chuin aman, Pakai ka Pathen'u bang hi koimacha dang aumpoi ti nahet nadingin: nathusei dungjuijin hitahen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule uphoh hochu nangma-a kon, na-insung ho-a kon, nasohte-a kon, chule namite-a kona chemanguva, vadunga bou umdingu ahitai, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mosi le Aaron chu Pharaoh koma konin apotdoh lhontai. Chuin Mosi'n Pharaoh douna-a uphoh ho asosah jehchun Pakai henga ataotan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin Mosi thu dungjuijin ahinboltan: chuin uphoh ho chu inho, kho ho, chule louho-a konchun athigam taovin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin amahon hiho chu alhuh lhuh-in asekhom mun: gamsung chu apumpin a-uitan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahivangin Pharaoh'in chomkhat akicholdona amuphatnin, Pakaiyin anasei bangin alung atahsah-in; amani thusei chu angaipeh tapon ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakaiyin Mosi henga, Aaron jah-a, Egypt gam pumpi-a leivuichu kha ahung so nadin natenggol lamin lang gamsunga leivui chu jepmin, tin seijin, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin amanin chutichun abol lhontan ahi: ajehchu Aaron'in atenggol chu akhut toh alamin, leisetna leivui chu ajepmin ahile sa le mihem chunga chun kha ahung langtan; chuin Egypt gam pumpi-a chun tolla leivui jouse chu kha ahungsoh tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule mitphel doithem hochun adoiju chu amang chaovin kha asosah gouvin, ahivangin amahon abolthei tapouvin ahi. Chutichun sa le mihem chunga chun kha alangtan ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chujouvin mitpheldoi themho chun Pharaoh henga, Hichehi Pathen khutjung ahi atiuvin ahi. Chuin Pakaiyin anaseisa bang chun Pharaoh lungsung chu tahsah-in aumin; aseilhon angaipeh tapon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakaiyin Mosi henga, Jingpi matah-in thouvin lang Pharaoh anga gadingin: ven, ama twikhuh lama ahunge; chule nangman ajah-a, Pakaiyin hitin aseije, Amahon eijen theina dingun kamite soldoh-in ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chutilouva, nangman kamite nasoldoh louva ahile, ven, nangma chung, nasohte chung, namite chung, chule na-insung chunga thousivaibong kahin lansah ding; Egypt mite insungho le adinnau leiset chunga chu thousivaibong dimset ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuche nikho chule kamite chenna Goshen gamchu kakhendoh ding, chukoma chu thousivaibong himhim umlou ding; chuteng keima leiset lailung Pakai kahi nahetdoh ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule keiman kamite le namite kah-a kikhenna kakoi ding: jingle hiche melchihna chu hung umding ahi, gatin, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pakaiyin chutichun aboltan; Pharaoh insung le asohte insunga, chule Egypt gam pumpi-a chun genthei umtah thousivaibong ahung lhungtan: thousivaibong jehchun gam chu suhboh-in aumtan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pharaoh'in Mosi le Aaron chu akouvin, ahenglhona, Nangho cheovin lang hiche gamahin na-Pathen'u henga ganlhaina ganei taovin, ati.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Mosi'n, Chutobanga bolding chu thildih ahipoi; ajehchu keihon Egypt mite-a dinga thet umtah hochu Pakai ka-Pathen'u henga ganlhaina-a kaneidiu ahi: ven, Egypt mite dinga thet umtah hochu amitmu tah uva ganlhaina-a kaneijuva ahile, amahon songa eiselou dingu ham?
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman eithupeh banguva gamthip nithum lama kacheuva, Pakai ka-Pathen'u henga ganlhaina kanei dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Pharaoh'in, Pakai na Pathen'u henga gamthipma ganlhaina nanei theina dingun nasolu vinge; ahin gamlatah-a vang nachelou dingu ahi: keima dingin neitao peh-un, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi'n, Ven, keima nakoma kona kachedoh-a, Pharaoh le asohte, chule amite-a kona thousivaibong hohi jinga patna achemang nadiuvin Pakai koma kagatao ding ahi: ahin mipi ho chu Pakai henga ganlhaina neidinga chesah louna dingin, Pharaoh'in dohan neibolkit tahih-un, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Mosi Pharaoh anga konin apotdoh-in, Pakai henga ataotan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Pakaiyin Mosi thusei bangchun abolin; chule thousivaibong hochu Pharaoh'a kon le asohtea kon, chule amite-a konin aladoh-in; khatcha jong aumdena aumpon ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Pharaoh'in hiche chunga jong hi alung atahsah-in, miho chu asoldoh dehpon ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Pakaiyin Mosi henga, Pharaoh koma lutnin lang ajah-a, Hebrew mite Pakai Pathen'in hitin aseije, Keima eihou theina diuvin kamite chu soldoh tan.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangman amaho soldoh ding nada-a, nahen jing nahlaija ahile,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ven, loujaova um naganchaho chung, sakol ho, sanganho, sangongsang ho, bongchalho, kelngoiho chungah Pakai khut chuding: gancha pul khohtah langding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Pakaiyin Israel mite gancha honle Egypt mite gancha hon chu achomkhen ding: chule Israel chate-a poupou chu khatcha jong thilou ding ahi, tin gaseijin, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin phatbih khat atepmin, Pakaiyin jing nikhole hiche thilhi gamsunga abolding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chutichun ajing nikhon Pakaiyin chuche thil chu aboltan, Egypt gamsunga gancha jouse chu athitai: ahinla Israel chate gancha ho chu khatcha jong athipon ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pharaoh'in mi asolin, chule veuvin, Israel mite gancha khatcha jong athi aumpon ahi. Chuin Pharaoh lungthim chu akisutah-in; chule miho chu alhadoh dehpon ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Mosi le Aaron henga, Nangnin thuh sunga konin vut khutdim la lhonin lang, hichu Mosi'n Pharaoh mitmu tah-in van lama thehen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichu Egypt gamsung jouse-a leivuinel soh ding, Egypt gamsung pumpi-a mihem chungle gancha chunga uilut le mase nasatah chaljal ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amanin thuh sunga vut chu ahamlhonin, Pharaoh angsunga ading lhonin; chuin Mosi'n hichu van lama athen ahile, mihemle gancha chunga chun uilut ahungsoh tan, mase khohtah achaljal tan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin chuche uilut jehchun mitpheldoi themho chu Mosi masanga adingthei tapouvin ahi; ajehchu uilut chu mitphel doithemho le Egypt mite jouse chunga chu-ah ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin Pharaoh lungthim chu atahsah-in, Pakaiyin Mosi henga aseibang chun athu seilhon chu angai pehpon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Pakaiyin Mosi henga, Jingpitah-in thouvin lang, Pharaoh henga gadingin, chule ahenga, Hebrew mite Pakai Pathen'in hitin aseije, Keima eihou theina diuvin kamite soldoh tan.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ajehchu leiset chung jouse-a hin keima tobang koimacha aumpoi ti nahet nadinga, tuchunga hi nangma lungsung chung le nasohte chung, chule namite chunga ka hise jouse kahin chuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu nangma le namite chu hise-a kajep theina dinguva, tu-a hi keiman kakhut kalhandoh ding: chule nangma leisetna kona paidoh-a naum ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule kathahat nahi nangma vetsah nading le kamin hi vannoi leiset pumpi-a phondoh-a aumna dinga, hiche jeh tah-a hi nangma katundoh nahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tugeihin nangman amaho nasoldoh louva konhin, kamite douna-in nangle nang naki choisangin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ven, jing nikho tuphat tah hile Egypt gam kiphudoh-a pat tuchan geija anaumkha louhel, gel nasatah chu kahin juhsah ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijeh chun tun mi solinlang, loujaova um nagancha jouse gakhop khom sah-in; ajehchu in'a kipuilut louva loujaova um mihemle gancha chung jouse-a chu gel hunglha ding, amaho chu thiding ahiuve, gatin, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pharaoh sohte lah-a Pakai thu gingho chun asohteu le aganchahou chu insunga ajamlut sah loijun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule Pakai thu ngaisah louho chun asohteu le aganchahou chu louva adalha denun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakaiyin Mosi henga, Egypt gam jouse mihem chung le gancha chung, chule Egypt gamsung jouse-a louva hampaho jouse chunga gel ahunglhah nadingin, van lama nakhut jahdoh-in, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Mosi'n atenggol chu van lama ajahdoh tan ahi. Chuin Pakaiyin van ginle gel ahinsoltan; mei chu leichunga avahmat jengin; hitichun Pakaiyin Egypt gam chunga chun gel alhah sahtan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutichun gel, meito kihal gel alhan, akhohset danchu namkhat ahung hiuvapat Egypt gamsunga hitobang hi aumkha khapon ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Egypt gam jouse-a loujaova thil um jouse, mihem le gancha jong gel chun aseplih gamin; chule gel chun loujaova hampa louhing jouse aseplih-in, gama thing jouse jong asepbong gamtan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel chate umna Goshen gama chun bou gel alhapon ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Pharaoh'in mi asolin, Mosi le Aaron chu agakou sah-in, aheng lhona chun, Tuchung hin keima kachonse tai; Pakai chu achonpha ahin, keima le kamite vang gilou kahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Van gin nasatah le gel hi abeina dingin, Pakai henga ngeh lhonin, (ajehchu phasetna ahitai;) keiman nangho kasoldoh uva, nangho na-umsot tahlou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi'n ahenga, Keima khopi sunga kona kapotdoh dohle Pakai henga kakhut kajahdoh ding: leiset hi Pakaiya ahi nahetdoh nadinga van gin chu thipding, geljong lhahbe louding ahitai, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahivangin nangma le nasohte thudol vang, nanghon Pakai Pathen chu nagindeh lou dingu ahi kahei, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule tupat phungle sakol chang chu suhmangin aumtan ahi. Ajehchu sakol chang chu avui ahungdoh tan, tupat phung vang chu apahlaitah ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahin suhlou chang le butun vang akedoh loulai jeh-in suhmangin aumpon ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Mosi Pharaoh koma konin khopi chu adalhan, Pakai henga akhut ajahdoh-in ahi; chuin van ginle gel chu atangtan, lei chunga go ajutapon ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Pharaoh'in go le gel chule van gin ho atan amuphatnin, chonset abolbe nalaijin, amale asohte chun alungthimu atahsah kit taovin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Pharaoh lungthim chu suhtah-in aumin, Pakaiyin Mosi henga anasei bang chun, Israel chate chu alhadoh dehpon ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga, Pharaoh koma galutnin: ajehchu hiche kamelchihna hohi amasanga kamusah theina dinga, amale asohte lungsung chu katahsah ahi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutia chu nangman nachapate le natupate nabenga Egypt gamsunga kathilbol ho leh alah uva kamelchihna bolho naseipeh uva; chule keima Pakai kahi nahetna dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi le Aaron Pharaoh hengah ahunglut lhonin, ajah-a, Hebrew mite Pakai Pathen'in hiti hin ati, Nangma itihchan ka-angsunga kineosah ding nada nahlai ding ham? Keima eihou theina dingun kamite soldoh tan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutilouva, kamite nasoldoh nomlouva ahile, ven, jingle nagam pumpi-a khaokho kahin lhalut ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule koiman tol amu theilou leuva amahon leiset chung alosoh dingu ahi: chule gel suhset moh, nahenga umnalai jouse chu anehjou hel diu, chule nangma-a dinga keh loujaova thingphung jouse jong chu aneh jouhel dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amahon na-insung le nasohte jouse insung, chule Egypt mite jouse insung chu alodim sohdiu; hichu napateu le naputeuvin jong leiset chunga achenuva pat tuni geija amukhah lou dingu ahi, ati. Chuin ama akiheijin, Pharaoh henga konin apotdoh tai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pharaoh sohte chun ahenga, Hiche mipahi itih chan eiho dinga thanga pang dingham? Pakai a-Pathen'u chu ajen theina diuvin miho chu soldoh tan: Egypt gamhi suhmangin aumtai ti nahet loulai ham? atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Mosi le Aaron chu Pharaoh henga ahinpui kitnun ahi. Chuin aman aheng lhonna, Cheovin, Pakai na-Pathen'u chu gajen taovin: ahin koi koi cheding nahiuvem? ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n, Keiho kakhangdong hou le katehse hou toh, kachapateu le kachanuteu toh, kabong honhou le kakelngoi honhou toh kache dingu ahi; ajehchu keihon Pakai henga Kut kabol dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman ajah lhona, Keiman nachasen houtoh kasoldoh uva ahile, Pakaiyin na-umpiu hen: chingtheijun, ajehchu namasanguva thilphalou aume.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutiponte: tun nangho pasal chengchu cheovin lang Pakai chu gajen taovin: ajehchu hichu nangaichatnu ahi, ati. Chuin Pharaoh angsunga konin amani chu anodoh taovin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin Mosi henga, Khaokhote Egypt gamsung chunga ahungchuh uva, hiche gama gel seset moh hampa louhing jouse anehthei nadiuvin, khaokhote-a dingin Egypt gamsung chunga hin nakhut jahdoh-in ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi'n Egypt gam chunga atenggol chu ajahdoh-in ahile, Pakaiyin sun nilhum jankhovah-in gamchunga chun solam hui anunsah tan, chuin jingkah ahung hi phatnin solam hui chun khaokho hochu ahin polut tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin khaokho ho chu Egypt gam jouse chunga ahung taovin, Egypt gam pumpi jouse-a chun acholnga taovin ahi. Hiho chu akhohse lheh jengun; amaho masanga hin amaho tobang khaokho ana umkhapon, amaho nunga jong chutobang umkit louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajehchu hicheho chun leiset pumpi chu atomchah jeng taovin, chutichun gamsung chu athim jengtan; chule gelin asuhset moh gama hamhing tincheng le thingna jouse chu anegam hel taovin ahi. Chutichun Egypt gamsung jouse-a chun thingphung ho-a thing hing le loujaoa hampa louhing a-eng him him khatcha jong aumtapon ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pharaoh'in Mosi le Aaron chu gangtah-in akouvin, ajahlhona, Keima Pakai na Pathen lhonle nangni douna-in kachonse tai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hijeh chun tun, katao ahi, Kachonset hi khatveiseh neingaidam kit lhonin, hiche thina hi keija kona alahmang theina din Pakai na Pathen henga neitaopeh lhonin, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin ama Pharaoh koma konin apotdoh in, Pakai henga atao tai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Pakaiyin lhumlam hui hattah anunsah-in ahile, hichun khaokho ho chu alhoh mangin, twipi sana alhoh lutsoh keijin; Egypt gam pumpi-a chun khaokho khatcha jong aumtapon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin Pakaiyin Pharaoh lung chu atahsah-in, chuti chun aman Israel chate chu asoldoh dehpon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin Mosi henga, Egypt gam chunga tohkhah thei hel khopma muthim ahung umtheina dingin van lama nakhut jahdoh-in, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Mosi'n van lama akhut ajahdoh tan ahile, nithum Egypt gam pumpi chunga chun nasatah-in mu athimtan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaho khatle khat akimuto thei tapouvin, nithum sung chun koimacha aumna munna kona kipatdoh aumpon ahi. Ahivangin Israel chate jouse chennaho-a chun vah aneicheh-un ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pharaoh'in Mosi chu akouvin, ajah-a, Nangho cheovin lang, Pakai chu gajen taovin; nabonghon houle na kelngoihon hou bouchu umhen: nachasen hou jong chu nangho toh lhonuhen, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Mosi'n, Nangman Pakai ka-Pathen'u henga ganlhaina-a kato dinguva ganlhaina thilto dingle govam thilto ding jong neipeh dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kagancha hou jong keiho toh lhonding ahi: gancha kengtin khatjong dalhah-a umlou ding ahi: ajehchu Pakai ka-Pathen'u kajen nadinguva phabep kalhendoh dingu ahin; amun kalhun masang seova hoichepena hi Pakai kajen dingu kihet louvu ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahivangin Pakaiyin Pharaoh lung chu atahsah tan, amaho chu asoldoh nompon ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Pharaoh'in ahenga, Kakoma konin chemangtan, kichih theijin, kamai mukit tahih-in; ajehchu kamai namukit ninileh nathi ding ahi, ati.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin Mosi'n, Nangman nasei dih-e, keiman namai kamukit louding ahitai ati.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga, Pharaoh chung le Egypt gam chunga hise khat kalhunsah be nahlai ding ahin; chujouteng leh hikoma kona hi nasoldoh diu ahitai: aman nasoldoh tengule, thonlouva nanodoh tho sohkei jeng dingu ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tun mipi ho henga seipeh-in, chule pasal jouse le numei jousen aheng akoma konin dangka le sana-a kisem kijepnaho kithum cheh uhen, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Pakaiyin Egypt mitmu-a chun Israel miho chu khohsahna apetan ahi. Chukal valin mipa Mosi chu mipi mitmu le Pharaoh sohte mitmun Egypt gam sunga mi minthang tah ahitan ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi'n, Pakaiyin hitin aseije, Jan khangkim donle Egypt gamsung lailung tah-a kalut ding:
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Egypt gamsunga chapa peng masapen jouse, laltouna-a tou Pharaoh chapa lenpena pat, sumheija sohnu chapa lenpen changeija thisoh hel dingu; chule gancha asoh masapen ho jong thisoh hel dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule Egypt gamsung jouse-a chu kana nasatah umding, hitobang hi anaum khalou ahin, umjong umkit louhel ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahin Israel chate douna-a vang, mihem douna hihen le gancha douna hijongle, uichan jong alei achalohsah louding ahi; chutia chu nanghon Egypt mite le Israel kah-a Pakaiyin ichana kikhena akoiham ti nahet ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuteng hiche nasohte jouse hi kahenga hung suh uva, ka-angsunga bohkhup diu, Chedohtan, nanungjui mipi jouse toh: ahung tidingu; chujou teng keima kachedoh ding ahi, ati. Chuin ama Pharaoh koma konchun lunghang tah-in apotdohtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin Mosi henga, Egypt gamsunga hi kathilbol kidang apun chehcheh theina dinga Pharaoh'in nathu angailou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Mosi le Aaron'in Pharaoh angsunga hiche thilkidang hojouse hi abol lhonin: chule Israel chate chu agama kona asoldohlou nadingin, Pakaiyin Pharaoh lung chu atahsah-in ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Egypt gama Mosi le Aaron henga chun aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiche lhahi nangho dinga lha kipatna hiding: nangho dinga kumsunga lha masapen chu hiding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel mipi kikhom ho jouse henga chun thu seilhonin lang, hitin seilhonin, Hiche lha nisom chan ni hile mitinin ama-a dingin kelngoinou khatcheh kilah-u hen, apu apateu insung dungjuija in khatna dinga kelngoinou khatcheh hiding ahi:
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ijemtia insung khat chu kelngoinou khat dinga alhom behseh-a ahile, amale a-inhengpa chun kelngoinou khat chu amijatnu dungjuijin kilah-u hen; mitinin ava khamcheh-a aneh dingjat dungjuija kelngoinouva dinga chu mi nasimtoh dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na kelngoinouvu chu nolna beihel, achal kum khat lhingbep hiding: nanghon hichu kelngoi ham, ahiloule kelcha hama kona nalah dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nanghon chuche lha ni somle nili chan ni geija nakoi dingu: chule Israel mipi kikhom khomho jouse chun nilhah teng atha dingu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amahon athisan chu alah uva, aneh nadiu inho kotchung teni le achung jolla chu anu dingu ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amaho chuche jan chule aphe chu meija agouva, cholsolou changlhah toh an-che kha toh ame dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Asela naneh loudiu, chule twija kihon jong naneh lou dingu, amavang alu jong akeng jong chule asung jouse puma meija nasahmin tho dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nanghon jingkah geija khatcha nakoilou dingu ahi; jingkah geija anaumden tapouchu meija nagovam dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule hitia hi naneh dingu ahi; tai kigah pum le kengchot kise pum, chule nakhut uva natenggolu kichoi puma kinotah-a naneh dingu ahi: hichehi Pakai kalchuh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ajehchu tujan tengle keiman Egypt gamsung kahin jotpa ding, Egypt gamsunga mihem le gancha apeng masa jouse kathagam ding; chule Egypt pathen jouse chunga jong thutanna kalhunsah ding ahi: keima Pakai chu kahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule thisan chu nangho dinga na-umnao inho chunga melchih na-a pangding; chule thisan chu kamu teng, nangho chu kakalchuh ding; Egypt gam kahin got teng, hise chu nangho sumang dinga nachung uva chulou ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hiche nikho hi nangho dinga hetjingna hiding; chule nanghon hichehi nakhang lhumkei uva Pakaiya dinga kutna nanit dingu; nanghon hiche kut hi a-itih-a chonna dan kisuna nanit dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nanghon ni sagi cholsolou changlhah naneh diu; ni masa ni-a patna na-in houva kona chol nakoidoh diu ahi. Ajehchu koihile nimasa ni-a patna ni sagi changeija chola kisem changlhah netapou chu, hiche mipa chu Israel lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nimasani chule nangho dinga kikhoppi theng umding; chule ani sagi ni jongleh kikhoppi theng umkit ding ahi; chule hiche nikho ho-a chu natoh imacha natohlou dingu; amitinin anehsohkei dingu ahin, nehding bou chu nakibol thei dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nanghon cholsolou changlhah kut chu nanit dingu ahi; ajehchu chuche nilele-a chu nagalsat hou Egypt gama kona kapuidoh ahiuve. Hijeh-a chu hiche nikho hi a-itih-a akhang akhanga chonna dan kisuna nanit dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nanghon lha masapen chuche lha nisomle nili nilhah-a pat, chuche lha mama nisomni le nikhat nilhah changeija cholsolou changlhah naneh dingu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni sagi sunga chu chol him him na-inhouva kimulouhel ding ahi: ajehchu koi hijongle chol kiso netapou chu, maljin hihen, gamsunga peng hijongle, chutobang michu Israel mipi kikhomho lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chol kiso tapou imacha nanehlou dingu ahi; nachenna mun jouseuva cholsolou changlhah bou naneh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin Mosi'n Israel upaho jouse akouvin, ajah uva, Kelngoinou chu kikaijun lang, na insungmi cheh-u dungjuijin kalchuh sa chu that taovin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nanghon hyssop bohkhat nalah uva, lheng sunga um thisan lah-a chu nadelut dingu, chuche lheng sunga um thisana chu kotbeng teni le kotchungjol chu nanu dingu: chule jingkah ahunghi kahse-a koimacha a-inkot khah-a kona potdoh louding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu Egypt mite sugam dinga Pakaiyin ahin jotpa ding ahin; chule aman kotchin teni le kotchungvuma thisan chu amutengle, Pakaiyin hiche kot chu akalchuh ding, nangho sugam dinga suhmangna chu na-insungu ahin lutsah louding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hiche thil hi nangho le nachapa teovin a-itih-a chonna danna nanit jing dingu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule hung hitiding ahi, athutep banga Pakaiyin napeh dingu gamsung chu nalhun phat tengu jongle, hiche natoh hi nanit jomjing dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule hung hitiding ahi, nachateovin naheng uva, Hiche natoh hi ipi vetsahna ham? ati phat tengule;
  </para>
  <para style="p">
    <verse number="27" style="v" />Nanghon, Aman Egypt mite asuhgama eiho eihuhdoh laijuva, Egypt gama Israel chate inho kalchuhpa Pakai kalchuh ganlhaina chu ahi nati dingu ahi, ati. Chuin mipi chu akunun Pathen ahou taovin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Israel chate chu achemangun, Pakaiyin Mosi le Aaron athupeh bangchun aboltaove.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, Pakaiyin khangkimin alaltouna-a tou Pharaoh cha masapena pat gal hing kikaija songkul'a kihen cha masapen geijin, Egypt gamsunga apeng masapen jouse athat gamin; chule gancha masapen ho jouse jong athat gam tan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Pharaoh chu jan-in athouvin, asohho jouse le Egypt mite jouse chu athoudoh uvin; chule Egypt gama chun kana nasatah aumtan ahi; ajehchu mithi louna in khatcha jong umlou ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman jan-in Mosi le Aaron chu akouvin, aheng lhona, Kipatdoh-un, nangni le Israel chate chu kamite-a konin chedoh taovin; chule cheovin lang nasei bangin Pakai chu gajen taovin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule naseilhon bangin nabonghou le nagancha hou jouse jong kipuijun lang chetaovin; chule keijong phatthei neiboh-un, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Egypt mite chun chuche miho chu gamsunga kona gangtah-a soldoh loina ding chun akinotaove; ajehchu amahon, Eiho mithi ihisoh diu ahitai, atiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin miho chun achangbong amehsao chu chol kiso masangin akichoijun, achanglhah mehnao kongho pona kijel chu alengkou uva akiput taovin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Israel chate chun Mosi seibang chun abolun; amahon Egypt mite-a konin sana le dangka-a kisem kijepnaho le vonho chu akithumun ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuin Pakaiyin Israel mite chu Egypt mite mitmun khotona amusah-in, hiti chun amahon athum chanu chu apeuvin ahi. Chutichun amahon Egypt mite chu achom gamun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chuin Israel chate chu Rameses'a konin Succoth lama ajin taovin, amaho chu nunao chapang simlouvin, kenga lamjot cheh pasal sangjagup ahiuve.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule choplop mihonpi chu amaho toh achetou khomun; chule kelngoihon, bonghon, chule gancha tamtah toh alhon khomun ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule amahon Egypt gama kona ahinkipoh-u changbong mehsa-a chun cholsolou changlhah akangun ahi, ajehchu chol kiso louva ahi; ijeh inem itile Egypt gama kona asotdoh tho jengu ahijeh-a, amaho akhongai sot thei louvu, nehding imacha akigotman louvu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tun Egypt gama cheng Israel chate akhopemnao phatsung chu kum jali le kum somthum ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chuin kum jali le kum somthum kichaijin ahitin ahi, chuche nile le chun ahitin ahi, Pakai janel jouse chu Egypt gama konin apotdoh taovin ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hiche hi Egypt gama kona ahinpuidoh jeh uva Pakai geldohna dinga anitdiu jan chu ahi. Hiche hi Israel chate jousen akhanguva anitdiu Pakai jan chu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Pakaiyin Mosi le Aaron henga, Kalchuh kut kiman dingdan chu hichehi ahi; maljin koimachan hichu aneh louding ahi:
  </para>
  <para style="p">
    <verse number="44" style="v" />Ahin suma kicho soh vangchu, nangman achep natanjou tengle, hichu aneh theiding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Gamchom mi le soh sum thalo vang chun hichu aneh theilou ding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hichu inkhat sunga nehding ahin; nanghon aphe khatjeng jong inpolama nachoidoh lou dingu; chule agujong nasuhboh lou dingu ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Israel mipi ho chun hiche hi anit dingu ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Maljin khat nakoma pema auma, Pakai dinga kalchuh kut anit dinga ahile, apasal jousen chep tanu henlang, chujou tengle hinnai hen, chule hichu nit hen; chutengle ama chuche gama penga mikhat tobang hiding ahi. Ajehchu chep tanlou tapou chun hichu anehlou dingu ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Agam sunga peng hihen, nalah uva hung khopem gamdangmi hijongle, dan khat bou hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chutichun Israel chate jousen abol taovin; Pakaiyin Mosi le Aaron athupeh bangchun abol taovin ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chuin chuche nilele chun ahitin ahi, Pakaiyin Israel chate chu aloi loijin Egypt gama konin apuidohtan ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate lah-a naobu hinphukeh-a apeng masa jouse chu mihem hihen gancha hijongle kahenga thenso soh keijun: hichu keija ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi'n mipi ho henga aseijin, Nanghon Egypt gamsung sohchana in'a kona nahungdoh nao hiche nikhohi hejingun; ajeh chu Pakaiyin khut thahatna hiche mun'a kona chu nahin puidoh-u ahi. Chol kiso changlhah naneh loudingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abib lha hiche nikho-a hi nahung potdoh-u ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Pakaiyin Canaan miho, Hit miho, Amon miho, Hiv miho, chule Jebus miho gam, napu napateu pehdinga akihahselna khoiju le bangnoi lona gama chu napuilut phat tengule, hiche lha ngeija hi hiche kin kibol hi nanit jing dingu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nisagi cholsolou changlhah naneh dingu, chule ani sagi ni chu Pakaiya dinga kut hiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nisagi chol solou changlhah nehding ahin; nakom him himuva chol kiso changlhah kimulou ding, nachennao mun jouse vellah-a jong chol him him kimulou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule chuche nikho chule nachapa nahetsah-a, ajah-a, Egypt gama kona kahung potdoh-a Pakaiyin kachunga anatohho jeh-a hichehi kibola ahi, tia naseipeh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Pakai danthu chu nakama aumtheina dinga, hiche hi nakhut chunga melchihna hiding, chule namit teni kikah-a hetjingna hiding ahi. Ajehchu Pakaiyin khut thahat tah-a Egypt gama kona napuidoh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun kumseh le hiche dan kisem hi aphatseh-a nanit jingding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule napu napate le nangma henga ana kihahselna banga, Pakaiyin Canaan miho gama napuilutna, hiche gam chu napeh tengle hitiding ahi,
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman naobu hinphukeh masa jouse le nagancha apeng masa chengse chu Pakai dinga nachom khen ding ahi; pasal ho chu Pakaiya ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule sangan asoh masa chengse chu kelngoinouva nalhatdoh ding; nalhatdoh louding ahile angong chu naheboh ding ahi. Nachate lah-a apeng masapen pasal jouse chu nalhatdoh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule hitiding ahi, phat ahung lhung ding ho-a chu nachapan, Hichehi ipi tina ham? tia nahindoh tengle, nangman ahenga, Pakaiyin akhut thahat chun Egypt gam sohchana in'a kona eina lhatdoh ahi:
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ahitin ahi, Pharaoh chun eisoldoh nomlou phatnun, Pakaiyin Egypt gama mihem le gancha apeng masa jouse chu atha gam jeh-a keiman naobu hinphukeh-a apeng masa pasal jouse chu Pakai koma kalhandoh ahi; ahivangin kachate lah-a apeng masa jouse chu kalhatdoh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule hiche hi nakhut chunga melchihna le namit teni kikah-a hetjingna hiding ahi: ajehchu khut thahatna Pakaiyin Egypt gama kona eipuidoh-u ahi, nati ding ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, Pharaoh'in mipi ho chu asoldoh phatnin, alampi chu anai vangin Pathen'in Philistine mite gam jotna lampia chun amaho apuipon ahi: ajehchu Pathen'in, Achuti loule mipi ho chun galkisat amutengule kisih untin, Egypt lama kilekit getnunte, ati ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin Pathen'in mipi chu twipi san jotna gamthip lampia chun apuijin;chule Israel chate chu Egypt gama kon chun galsat dinga kigosan akitol tou taovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Mosi'n Joseph guho chu apon ahi: ajehchu aman Israel chate chu ana kihahsel sah-a, ajah uva, Pathen'in nangho thonlouva nahungvil dingu ahin; chule nanghon kagu hi hikoma kona napohtou dingu ahi, anati ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amaho Succoth'a konin akipat doh-un, gamthip chin Etham'a agebuh-u asongun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin sun le jana achetheina diuvin Pakai chu sun le meibang khompin amasanguva achen, chule jan le meikong khompin amaho chu vah pedingin amasanguva achepeh-in ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hitichun sun na meibang khompi le jana meikong khompi chu mipi ho masanga konchun alamangpon ahi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga, amaho kiheijuva Baal-zephon maijona um Migdol le twikhanglen kah-a Pi-hahiroth mun'a gebuh akison nadiuvin seipeh-in: hiche masanga chu twikhanglen panga gebuh nason dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajehchu Pharaoh'in Israel chate thudola, Amaho gamsunga chun a-ohden taovin, gamthip chun amaho akhakhum den ahitaove, atiding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule keiman Pharaoh lungsung chu kasuh tah ding, aman amaho ahin nungdel ding ahin; chule Egypt miten keima Pakai kahi ahetna dinguva, keima Pharaoh le asepaiho jouse chunga jabola kaum ding ahi. Chuin amahon hiti chun abol taovin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Egypt lengpa henga mipi chu ajam taove ti aseipeh taovin ahi. Chuin Pharaoh le asohte lungsung chu mipi ho douna chun akiheitan, chule amahon, Ipi dinga hiche hi inaboluva, eiho eijen naova kona Israel chu isoldoh-u hitam? atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman asakol kangtalai chu akigotnin, amite chu akipuijin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman lhentum sakol kangtalai jagup le Egypt sakol kangtalai jouse, chule khatcheh chunga sepai lamkaiho chu akipuijin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Pakaiyin Egypt lengpa Pharaoh lungsung chu atahsahtan, aman Israel chate chu anungdel tai; chule Israel chate chu hangtah-a chedoh-a ahitaove.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahivangin Egypt mite chun Pharaoh sakol kangtalai ho le sakol jouse, asakol chung tou miho, chule asepaihon chutoh amaho chu anungdel taovin, chuin amaho chu Baal-zephon phah masang Pi-hahiroth kom, twikhanglen panga agebuh ason naova chun apha taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pharaoh ahung nai phatnin, Israel chate akhodah uvin ahile, veuvin, Egypt mite chu anunguva ahung kijot jot jenguvin; chuin amaho akicha talheh jengun ahi. Chuin Israel chate chu Pakai henga atao taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin amahon Mosi henga, Egypt gama lhankhuh umlou hija gamthipma thidinga neipuidoh-u ham? Nangman ibola Egypt gama kona neipuidoh uva, hitia hi neibolu ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Egypt mite kajen theina diuvin neilimsah hih-un tia Egypt gama kanaseiju chu hiche thuhi hilou ham? ajehchu gamthipma kathigam sang uva Egypt mite kajenu chu keiho dinga phajo ahi, atiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi'n mipi henga, Nangho kicha hih-un, ding thimbeh-un lang, Aman nangho tunia namusah dingu Pakai mi huhhingna chu veuvin: ajehchu tunia namu-u Egypt mite hi a-imatih chana avela namu kitlou dingu ahitai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pakaiyin nangho dinga gal asatding, chule nangho na-umthim beh dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Pakaiyin Mosi henga, Ipi dinga kahenga naka uham? Israel chate chu amalamuva ache nadiuvin ahenguva seipeh-in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin nangman natenggol chu domsangin lang, twikhanglen chunga chun nakhut jahdoh-in, hichu hom khenin: chule Israel chaten tolgoa twikhanglen lailung chu ajotdingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule keima, ven, keimatah-in Egypt mite lungsung kasuhtah ding, chule amahon amaho nung chu ajui dingu ahi. Chule Pharaoh le ajanelho jouse, asakol kangtalai ho, chule asakol chunga tou miho chunga keiman jabolna kamuding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Pharaoh chung le asakol kangtalai chung, chule asakol chungtou miho chunga jabola kaum tengle, Egypt miten keima Pakai kahi chu ahet dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Israel gebuh masanga che Pathen vantil chu akichonin, anunguva achen; chule meilhang khompi chu amasanguva kon chun akichonin, anunguva adingtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin hichu Israel miho gebuh le Egypt miho gebuh kikah-a chun ahungin; hichu amaho ding chun meilhang le muthim ahin, khat ho ding vang chun janle vah apen ahi. Chutichun jankhovah keijin khatnin khat chu anailutpon ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Mosi'n twipi chunga chun akhut ajahdoh tan ahi; chuin Pakaiyin hiche jan chun solam hui hattah mangchan twipi chu alelon sah-in, twipi chu tolgo asosahtan, twiho chu akikhentan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Israel chate chu twipi lailung tolgoa chun alut taovin; chule twiho chu jetle veija bang bangin akisungin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Egypt miho chun anung delun, Pharaoh sakol ho, akangtalai ho, asakol chunga tou miho jouse chu amaho nunga chun twipi lailunga chun alut taovin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin ahitin ahi, jingkah ahiphatnin Pakaiyin Egypt mite chu meilhang le meikong khompia konin ahinven, Egypt mite janel chu asunohphah tan,
  </para>
  <para style="p">
    <verse number="25" style="v" />Asakol kangtalaiju kangho chu alahdoh peh-in ahile amahon gihsatah in atolun ahi. Hijeh chun Egypt miten, Eiho Israel maikoh-a konhin jamtao hite; ajehchu Pakaiyin amaho dinga Egypt mitehi asat ahitai, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin Pakaiyin Mosi henga, Egypt mite sakol ho, akangtalaihou, chule asakol chunga touhou chunga twiho chu ahung lonkhom kitna dingin, twipi chunga chun nakhut jahdoh-in, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Mosi'n twipi chunga chun akhut ajahdoh-in ahile, jingkah ahunghi phatnin twipi chu angaija alonhat bangin ahunglong kit tai; chuin Egypt hiche lama chun ajamun; Pakaiyin Egypt mite chu twipi lailunga chun alehlut gamtan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin twiho chu ahung long gom kitnin, sakol ho, kangtalai ho, sakol chunga touho, chule amaho hin nungdel twipi sunga lut ho Pharaoh janelho jouse chu achuptan; khatcha jong asohcha aum pouvin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahivangin Israel chaten twipi lailunga chun tolgo laija lam ajotnun; chule twiho chu amaho dingin ajetlam le aveilam uva bang bangin akisungin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutichun Pakaiyin chuche nikho chun Israel chate chu Egypt mite khutna konin ahuhhingtan; chule twipanga konin Israelte chun Egypt mite athiu chu amuvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Israel ten Egypt mite chunga Pakai natoh loupi chu amutaovin ahi: chule mipichun Pakai chu aging taovin, Pakai le asoh Mosi chu atahsan taove.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chujouvin Mosi le Israel chate chun Pakai henga hiche la hi asaovin, hitihin aseijuve: Loupitah-a gal ajotah jeh-in, keiman Pakai henga la sange; aman sakol le achunga toupa chu twipi sunga alehlut tai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakai chu kahatna le ka la ahin, chule eihuhinga jong ahung hitai. Ama ka Pathen ahin, keiman ama kavahchoi ding; Ama kapa Pathen ahin, keiman kachoi sang ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakai chu gal hatmi ahi. Pakai chu amin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pharaoh sakol kangtalai ho le asepai janel chu aman twipi sunga alehlutnin; asepai lamkai lhenchom ho jongchu twipi sana alhalut gam tan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Twi thuh-in achupsoh taovin; twi thuhtah noija chun song bangin alhalut taove.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vo Pakai nakhut jetlam chu thanei na-in aloupin: vo Pakai nakhut jetlam chun melma chu asuchip tan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Naletna chungnunga chun nangma douna-a kipanho chu najoutan; nalunghanna chu nahin soldoh-in, amaho chu changpol bangin akavam taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanah hai chun twiho chu akhom khomin, twisoh chu alhuh-in adingden tan, chule twithuh chu twipi lailunga adingchah dentan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Melma chun, Keiman kanungdel ding, kaphah pa-a thil kichomdohho chu kahop khending; kangaichat chu achunguva kasuh bulhit ding; kachemjam kasa doh-a, kakhutnin amaho asuhmang ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangman nahui chun namutnin ahile, twipi chun amaho chu akhukhum tan: twi thuh sunga chun amaho chu ngen bangin alhalut taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai, pathen ho lah-a hi nangma tobang koi umam? nangma tobanga thenna-a loupi, pachat naho-a gin um, chule thil kidang ho bolla koi umam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman nakhut jetlam najah doh-in, leisetnin amaho chu aval lhumtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangman nami hepina-in nalhatdohsa namite chu napui doh-in, nangman nathahatna-in amaho chu nachenna munthenga chun napui lhungtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipi chun jaovintin, chule kichadiu: Philistine mite chenna munchu lungkham na-a dimding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuteng Edom lenghon hichu kidang asahdiu; Moab mihat ho chu kihot hotdiu; Canaan gama cheng ho jouse chu junmang diu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangman nachohdohsa namite chu agalkai kahseovin, Vo Pakai, namite chu agalkai kahseuva kichat le tijat na chu amaho chunga chuding; naban thahat nasatah-a chu amaho song banga umthimbeh dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vo Pakai nangman nachenna dinga nasemna mun, Vo Pakai nakhut tah-a naphudet muntheng, nagoulo molsanga chu amaho chu napuilutna nachensah ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pakaiyin atonsot atonsotna lengvai apohding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu Pharaoh sakol ho, akangtalai ho leh, asakol chunga touho toh twipi sunga alutnuvin, chuin Pakaiyin twipi chu achunguva alonsah kittan ahi; ahivangin Israel chate chu twipi lailung tolgo chunga chun acheuvin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Aaron sopinu Miriam themgaonu chun akhutna thih khutbeh khat akilah-in; chule numei jouse chun thih khutbeh choipum le lampumin anung ajuijun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Miriam'in amaho chu adonbutnin, Nanghon Pakai henga la saovin, ajehchu aman loupitah-a gal ajou tan ahi; aman sakol le achunga toupa chu twipi sunga aleh lutan ahi, ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuti chun Mosi'n Israel chu twipi sana konchun ahin puijin, Shur gamthipma alut taovin ahi; chuin amaho gamthipma chun nithum acheuvin ahile twi amu tapouvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Marah ahung lhun phatnun, Marah mun'a twiho chu akhat jeh-in adonthei tapouvin ahi. Hiche jeh-a chu hiche mun chu Marah kisah-a ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin mipi ho chu Mosi chunga aphun taovin, Ipi kadondiu ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin ama Pakai henga akaptan ahileh, Pakaiyin thingphung khat amusah-in, hichu twiho lah-a chun akholutnin ahile, twiho chu atwi tan ahi. Chua chun aman amaho dingin chonadan le thupeh asemin, chule chuachun amaho chu apatepmin,
  </para>
  <para style="p">
    <verse number="26" style="v" />Ajah uva, Nanghon Pakai na Pathen'u aw hi chingthei tah-a nangai uva, amitmu-a adih chu nabol uva, chule achondan thu jouse nanit uva ahile, keiman Egypt mite chunga kachuhsah hiche natho hi khatcha jong nachung uva kachuhsah louding ahi; ajehchu keima nangma damsah-a Pakai chu kahi ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin amaho Elim ahung lhungun, chukoma chun twikhuh somleni le lusuphung somsagi aumin ahi. Chuin amahon twipanga chun gebuh asongun ahi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin amaho Elim'a konin akholjin kitnun, Egypt gam adalhahnao lhanina ni somle ninga ni tah chun Israel chate mipi kikhomho jouse chu Sinai le Elim kikah-a um Sin gamthip ahunglhung taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin gamthipma chun Israel chate mipi kikhomho jouse chu Mosi le Aaron dounan aphun taovin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel chate chun aheng lhona, Pathen'in Egypt gama sabel ho koma katou uva, nengtah-a changlhah kaneh laijuva Pakai khutna eina thisah joh-u hitavele; ajehchu nangnin hichea mipi ho hi kella thisah dinga hiche gamthipma hi neihin puilutnu ahi, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichun Pakaiyin Mosi henga, Ven, keiman nangho dinga van'a kona changlhah kahinjuhsah ding ahin; amaho kadan thua achonuleh achonlouvu kapatep theina dinga, mipi ho chu potdoh uva niseh-a anehkham cheh diu aga kilokhom dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule hung hiti ding ahi, anigup nile ahin lokhom hou chu akigontup dingu; hichu niseh-a alokhomu jatni hiding ahi, ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi le Aaron'in Israel chate jouse henga, Nilhah tengleh Egypt gama kona nahinpui doh uva chu Pakai ahi nahet dingu:
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule jingkah tengleh Pakai loupi namu dingu ahi; ajehchu Pakai douna-a naphunchel nao chu aman ajatai: keini ipi kahi lhona keini chunga naphunu ham? atilhone.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Mosi'n, Hiche hi nilhah teng Pakaiyin nanehdiu sa napeh uva, jingkah teng changlhah nengtah-a napeh tengule namu dingu ahi; ajehchu Pakaiyin naphun nao, ama douna-a naphun chelnao chu ajatan ahi. Keini koi kahilhon ham? keini douna-a phun nahipouvin, Pakai douna-a phun nahijo bouvui, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n Aaron henga, Israel chate mipi kikhomho henga, Pakai angsunghi hinaijun; ajehchu aman naphun nahou chu ajatai, tin seipeh-in ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ahitin ahi, Aaron'in Israel chate mipi kikhomho henga thu aseipat patnin, amahon gamthiplam chu aveovin ahile, veuvin, Pakai loupi nachu meilhang lah-a ahung kilah-in ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel chate phunchel nachu keiman kajatan ahi. Amaho henga chun, Nilhah teng sa naneh dingu, chule jingkah tengle changlhah-a navaset dingu; chutengle keima Pakai na-Pathen'u kahi nahet dingu ahi, tin seijin, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ahitin ahi, nilhah-in vengkeho chu ahungdoh-un, agebuh uchu atomchah tan ahi. Chule jingkah-in janelho kimvela chun daitwi analhan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin daitwi lha chu ahul phatnin, veuvin, gamthip tol chunga chun thil lumpilpel neocha cha, buhbang neocha cha tobangin amuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Israel chate chun hichu amuphatnun khatle khat akihouvun, Hiche hi manna ahi atiuve: ajehchu ipi ahi ahetlouvu ahi. Chuin Mosi'n ahenguva, Hichehi Pakaiyin naneh dinguva napeh-u changlhah chu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche thil hi Pakaiyin ana thupeh chu ahi: Mitinin ama nehkhop cheh, na-insung mijat dungjuijun mikhat cheh-a dingin omer khatcheh; amitakipmin aponbuh sunga umho jouse-a dingin kilokhom cheh hen, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Israel chaten hitichun abolun, abangin atamjep chule abangin alhomjep akilo khomun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin amahon omer-a ate phatnun, atam lodoh panjong imacha amoh aneipon, chule alhom lodoh pajong chu alhinglel dehpon; amitinin anehkhop cheh ding akilo khomun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin Mosi'n, Koimachan jingkah changeijin khenhih hen, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin amahon Mosi thusei chu angaipouvin; alah uva mi phabepmin jingkah geija dingin akhenun, ahin hichu ana thanin, a-uitan ahi. Chuin Mosi achunguva alunghang tan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuti chun jingkah seh le amitakipmin anehkhop cheh ding akilokhom jiuvin; nisa ahung sat tengleh hichu ajunmang jitan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin ahitin ahi, anigup ni chule changlhah chu ajatni, mikhat dingin omer nicheh alohkhom jiuvin ahi. Chuin mipi kikhom vaipoho jouse chu ahungun, Mosi ahung hetsah taovin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman amaho henga chun, Hiche hi Pakaiyin asei chu ahi, Jingkhu Pakaiya dinga kicholdo ni cholngah nitheng ahi. Nahon dingu chu tunin honunlang, nakan dingu chu kanguvin, chua amoh umchu jingkah lama dingin kikoijun, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Mosi'n aseibang chun jingkah changei chun akoijuvin ahile, hichu anengpon, thanjong athan pon ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Mosi'n, Hichu tunin neovin; ajehchu tuni hi Pakaiya dinga cholngah ni ahi: tunia hichu loujaova namu lou dingu ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichu nigup sunga nalokhom dingu; ajing nisagi ni chu cholngah ni ahin, chuche nikho chule khatcha jong umlou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin ahitin ahi, mi phabep nisagi ni chun aloh khomdin apotdoh un, ahin khatcha amupouve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Pakaiyin Mosi henga, Kathupeh ho le kadan thuho hi itihchan nitnom louva naum dingu ham?
  </para>
  <para style="p">
    <verse number="29" style="v" />Veovin, Pakaiyin cholngah ni napeh jeh uvin, nigup chan nileh nini-a ding changlhah napeh-u ahi; amitakip namun cheh-a umun lang, nisagi nileh aumna mun'a konin koimacha potdoh hihhen, ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutichun mipi chu nisagi nin acholdo taovin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Israel insung chun hichu amin manna asah-un ahi. Hichu pathikhom mu tobanga bangleh ahin, atuidan chu khoijutoh kihala kisem changlhah tobang ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuin Mosi'n, Hiche thilhi Pakai thupeh chu ahi, Egypt gama kona kapuidoh laijuva gamthipma kavahnao changlhah chu amutheina diuvin; nakhang khanguva umjing dingin omer dimkhat koijun, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Mosi'n Aaron henga, Bel khat lan lang asunga chun manna omer dimkhat koijin; hichu nakhang khanguva umjing dingin Pakai angsunga koijin, ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuin Pakaiyin Mosi thu apehbang chun chin jing dingin hettohsahna angsunga chun akoitan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hitichun Israel chaten alo dingu gamsung ahung lhun kahseovin, kum somli sung chun manna chu aneovin; Canaan gam gamgiho ahunglhun kahseovin manna chu aneuvin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tun omer khat chu ephah hop soma hopkhat ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Israel chate kikhom khom pumpi chu Sin gamthipma konchun akipatdoh kitnun, Pakai thupeh dungjuijin Rephidim'a chun gebuh asongun ahi. Chuin chukoma chun mipi ho donding twi aumtapon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun mipi chun Mosi akinah piuvin ajah-a, Kadon dinguvin twi neipeovin atiuvin ahi. Chuin Mosi'n ahenguva, Ipi dinga kei neiki nahpiu ham? Ipi dinga Pakai chu napatep uham? ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chumuna chun mipi chu twi ngaichan adangchah taovin; chule mipichu Mosi chunga chun aphun uvin, ajah-a, Ipi dinga keiho le kachateu chule kagancha hou hi dangchah-a thigamsah dinga Egypt gama kona neipuidoh-u ham? atiuvin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi Pakai henga akapmin, Hiche mipi hohi i-kaloding hitam? amahon keima songa selih ding eigo taove, ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakaiyin Mosi henga, Mipi masanga chun chen, chule Israel upaho chu kipuijin; chule vadung navohna tenggol chu nakhutna kichoijin lang, chen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ven, keima namasanga um Horeb songpi chunga khu kadin ding; chule nangman songpi chu navoh ding, hichea kona chu twi hungput doh-a, hichu mipin adonthei dingu ahi, ati. Hitichun Mosi'n Israel upaho mitmu tahchun hitichun aboltan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel chaten Mosi akinahpi jeh-u le Pakai chu ilah uva umam umhih-em, tia Pakai chu apatep jeh uvin, aman chuche mun chu Massah le Meribah asah tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chujouvin Amalek mite chu ahungun, Rephidim mun'a chun Israelte chu ahungsat taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Mosi'n Joshua jah-a, Ilah uva mi lhengdoh-in, chule cheovinlang Amalek mite khu gakisat piuvin: jingtengle kakhutna Pathen tenggol choipuma lhang chungvuma kadin ding ahi, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutichun Mosi'n ahenga aseibang chun Joshua'n abolin, Amalek mite akisatpi taovin: chuin Mosi, Aaron le Hur chu lhangvuma chun akaltou taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin ahitin ahi, Mosi'n akhut adopsang phatle Israelte chun ajou jiuvin; aman akhut adoplhah phat phatle Amalek mite chun ajou jiuvin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin Mosi khut chu ahung khamtan; chuin amanin song alalhonin, anoija akoilhonin, ama achunga atouvin; chule Aaron le Hur chu asih langkhat gela apang lhonin, akhut teni chu adomsang jing lhonin; chutichun akhut chu nisalhum kahsen det tah-in apang tan ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutah chun Joshua'n Amalek le amite chu chemjamin ajoutan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin Mosi henga, Hichehi hetjinga aumna dingin lekhabua suninlang, Joshua nabenga jong jahsah kitnin; ajehchu keiman vannoi'a hi Amalek het jingna chu kasuh manghel ding ahi, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mosi'n maicham khat asemin, hichu Jehovah-nissi asah-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ijeh inem itile aman, Ajehchu Pakaiyin akhang khanga Amalek douna-a gal asatding ahi tin Pakai akihahselin ahi, ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi nupapa Midian gam thempu Jethro'n Pathen'in Mosi le ami Israelte athil bolpeh jouse le Egypt gama kona Pakaiyin Israel ahin puidoh chu ajah phatnin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosi nupapa Jethro chun Mosi'n anungsol kit inneipi Zipporah chu apuijin;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule achapa teni, khatpa min chu Gershom ahi; ajehchu aman, Hetlouna gama maljin kahi, ati:
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule khatjopa min chu Eliazar ahi; ajehchu aman, Kapa Pathen chu eikithopia ahin, Pharaoh chemjam'a konin eihuhdoh-e, ati:
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Mosi nupapa Jethro'n Mosi achapa teni le a-inneipi ahinpuijin, gamthip Pathen molsang mun'a agebuh sahna mun'a chun ahenga ahungun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman Mosi jah-a, Keima nanupapa Jethro, na-inneipi toh achapa teni toh kahunguve, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mosi anupapa lamto dingin apotdoh-in, jana apen, achopmin; chule amani khatle khat aumchan akidongto lhonin; pon insunga ahunglut lhontan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Mosi'n anupapa Jethro henga Pakaiyin Israelte akhohsahna jala Pharaoh le Egypt miho chunga athilbol jouse, lamdunga achunguva gentheina hungchu ho jouse, chuleh Pakaiyin amaho alhatdoh jeo chu aseipehtan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin Israel chu Egypt mite khutna kona ahin huhdoh-a, achunga athilpha abol hojouse jehchun Jethro akipah lheh jengin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Jethro'n, Egypt mite khutna kon le Pharaoh khutna kona nahuhdohpa, Egypt mite khutnoija kona mipi ho chu huhdohpa Pakai chu nunnom hen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tun Pakai chu pathen jouse sangin aloupi joi ti kahetai; ajehchu amahon kiletsah tah-a thil abolnao jenga jong chun, amachu amaho sangin achung nungjon ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mosi nupapa Jethro'n govam thilto alan Pathen'a dingin ganlhaina abolin ahi. Chuin Aaron le Israel upa ho jouse chu Pathen angsunga Mosi nupapa Jethro toh an nedingin ahunguvin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ajingin ahitin ahi, Mosi chu mipi ho thutan dingin atoutan: chule mipi ho chu jingkah-a patnin nilhah geijin Mosi koma chun adingun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Mosi nupapa chun mipi ho chunga athilbol jouse chu amuphatnin, ajah-a, Mipi ho chunga nathilbol hi ipiham? Ipidinga nangma nachang seh-a natouva, mipi ho chu jingkah-a pat nilhah geija nakimvela dinguva ham? ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mosi'n anupapa henga, Mipi hi Pathen lunglam dong dinga kahenga ahung jeh-u ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amahon thu aneitengule kahenga hung jiuva; chule keiman khatle khat kah-a thu katanji-a, chule Pathen chondan thuhou le adanthu ho kahetsah ji ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Mosi nupapan ahenga, Hiche nathilbol hi aphapoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangma nahin nakoma um mipi ho ahiuvin nachol val dingu ahi. Ajehchu hiche thil hi nangma dingin agihsa behseh-in ahi; nangma changin nabol jouhoi ahipoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tun kaseihi ngaijin, keiman nangma thumopming kating, Pathen'in nangma naumpi ding ahi: thunoh ho chu Pathen henga napohlut theina dingin, nangma Pathen masanga mipi ho-a dingin thalheng hi-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule nangman amaho chu chondan thuho le danthu ho nahilding, chule amahon ajot teidiu lampi le abol teidiu natoh chu nahil ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuche chungchona chun mipi ho jouse lah-a kona thil bolthei, Pathen ging mi, mi thudih, kiloset thetbol mi lhengdoh-in lang; amaho chu sangkhat chunga vaihom, jakhat chunga vaihom, somnga chunga vaihom, chule som chunga vaihom dingin pansah-in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule amaho chun mipi ho chunga phatseh-in vaihomu hen; chule hichehi hiding ahi, thulen ho chu nahenga ahinlhut diu, amavang thu neo neo ho chu amahon atandingu ahi. Chuti henlang hile nangma dinga olna hiding, chule amahon pohgih chu napoh hu dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangman hiche thilhi nabola, chule Pathen'in jong chutia chu nathupeh-a ahile nangman nadoujou ding, chule hiche mipi ho jouse jonghi mongtah-a aumna mun uva kile dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuti chun Mosi'n anupapa seichu angaijin, asei jouse chu aboltan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Mosi'n Israel pumpi lah-a konin thilbolthei mi alheng doh-in, amaho chu mipi luchang hidingin sangkhat chunga vaihom, jakhat chunga vaihom, somnga chunga vaihom, chule somkhat chunga vaihom dingin akoitan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitichun amaho chun phat tinin mipi ho thu atan taovin: thu hahsa ho chu Mosi henga ahinlhut nun, ahin thuneo jouse chu amaho tah-in atanjiuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Mosi'n anupapa chu asoldohtan; hitichun ama aumna gam lama achetai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israelte Egypt gama kona apotdoh uva pat lha thumna, chuche nitah chun amaho Sinai gamthip ahunglhung taove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu amaho Rephidim'a kona hung kipatdoh uva, Sinai neldi gam hung lhunguva, hiche gamthipma chu ponbuh akison ahi; hitichun Israel ten molsang bula chun gebuh akison taovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi chu Pathen henga achetouvin, chule molsanga konchun Pakaiyin ahin kouvin, Jacob insung henga hitia hi naseija, chule Israel chate henga nasei ding ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanghon Egypt mite chunga ipi kana bola, chule iti nangho muvanlai lhaving chunga kapoh-a, keimatah henga kapuilut ham namutaove.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hijeh chun tun, nanghon kathu nangai tahbeh uva, kakitepna hi nanit tahbeh uva ahile, namdang jouse chungvuma nangho hi kagou tumbeh nahi dingu ahi; ajehchu leiset pumpi hi keija ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangho keima dingin lenggam thempuho le namtheng nahi dingu ahi. Hiche thuho hi ahi nangman Israel chate henga nasei ding chu, ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mosi ahungin, mipi lah-a upaho chu akou khomin, Pakaiyin athupeh hiche thuho jouse chu a-angsung uva atahlangtan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin mipi jouse chun thakhat tah-in adonbutnun, ahenga, Pakaiyin asei jouse chu kabol dingu ahi, atiuve. Chuin Mosi'n mipi thusei ho chu Pakai henga alhuttan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Pakaiyin Mosi henga, Ven, nangma toh ikihou teng mipin ajahtheina dingu leh tonsotna nangma natahsan theina diuva, nahenga meilhang satah-a kahung ding ahi, ati. Chuin Mosi'n mipi ho thusei ho chu Pakai ahetsah tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Pakaiyin Mosi henga, Mipi henga chenlang amaho chu tuni le jingle suthengin, chule amahon avonhou kisop thengu henlang,
  </para>
  <para style="p">
    <verse number="11" style="v" />Anithum ni-a dingin kigosa demin umuhen: ajehchu anithum nileh mijouse mitmu-a Sinai molsang chunga chu Pakai hungkumlha ding ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman mipi dinga akimveluva gamgi nasempeh ding, chule ajah uva, Nangho molsang chunga nakaltou louna dingu le agamgi natohkhah louna dingun chingtheijun; koihileh molsang tongkha chan chu kithat tei ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khut khatchan jong atohkhah louding, amavang ama chu songa selih ding ham, ahiloule thalpi-a kaplih ding ham hitei ding ahi; gancha hihen mihem hijongleh hichu hinglou ding ahi. Sumkon chu sottah agin tengleh amaho molsang lama hungtou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Mosi molsanga konchun mipi ho henga akumsuh-in, mipi ho chu asuthengin; chule amahon avonhou asopmun ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule aman mipi ho henga chun, Anithum channia dingin kigosa demin umun: na-inneipiteu koma jong luthih-un, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin anithum ni jingkah-in ahitin ahi, van ahung gingin kol aphen, molchunga chun meilhang satah aumin, chule sumkon thongje jun ahung gingin; chutichun gebuh-a mipi umho chu akihot lhul gam taovin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Mosi'n mipi ho chu Pathen toh kimuto dingin gebuh-a kon ahinpui doh-in; chule amaho molsang bula chun adingun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Pakai chu meikonga ahung kumlhah jehchun, Sinai molsang pumpi chu mei akhu jengin: chule akhu chu lhum meikhu bangin akitung doh-in, molsang pumpi chu nasatah-in akihotnin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin sumkon chu sottah agina, ahagin cheh cheh phatnin, Mosi'n thu aseijin ahile Pathen'in aw gingin ahindonbut nin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Pakai chu Sinai molchunga, amolsang chungvuma chun ahungkum suhtan ahi. Chuin Pakaiyin Mosi chu molchung vuma chun akoutouvin; chule Mosi akaltoutan ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin Mosi henga, Kumsuh inlang mipi chu gagih-in, ajole mipi khu avedingin Pakai henglam hinphukeh untin, mi tamtah manthah lo getnunte.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Pakai kom hinaija thempuho jong chu kisuthengu hen, ajole Pakai chu achunguva hetman louvin chuget ninte, ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin Mosi'n Pakai henga, Mipi chu Sinai molsanga hungkaltou thei pouvinte; ajehchu nangman, Molsang kimvela chun gamgi semun lang, hichu suthengun, tia neithu peh-u ahi, ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin Pakaiyin ajah-a, Chen, kumsuh tan, chule Aaron toh nahung kaltou lhonding ahi: ahivangin thempuho le mipi chu Pakai henga hung dingin hinphukeh hih-uhen, ajole ama achunguva chuget ninte, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuti chun Mosi chu mipi ho henga achesuh-in, ahenguva thu jouse chu aseitan ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pathen'in hiche thuho jouse aseijin, hitin ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Keima Egypt gama kon le nasohchana in'a kona napui dohpa Pakai na-Pathen chu kahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Keima angsunga nangman Pathen dangho nanei louding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman imacha alim semthu, van chunga um hihen, lei noija um hihen, leinoi'a twisunga um hijongleh akibahpi imalim nasemthu louding ahi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma hicheho masanga chu nakun louding, jen jong najen louding ahi: ajehchu Pakai na-Pathen keima hi thangthip Pathen kahin, keima eithet bola pate khansetna chu khangthum akhangli chan geija chate chunga phulajia;
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule eingailua chule kadan thupeh nit ho sang tamtah chunga hepina musah-a chu kahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangman Pakai na-Pathen min chu mohseh-a napat louding ahi; ajehchu mohseh-a amin pana chu Pakaiyin themona beija alha louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cholngah nikho thengtah-a nitding ahi geldoh jingin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nigup sung na natoh-a, natoh ding jouse natoh chaiding ahi:
  </para>
  <para style="p">
    <verse number="10" style="v" />Amavang nisagi nichu Pakai na-Pathen cholngah ni ahi: hiche nikho chule na kiti natoh louding, nangma nahin, nachapa ahin, nachanu ahin, nasohpa ahin, nasohnu ahin, nagancha hon ahin, chule nakotpi sunga um namaljin ho ahiuva jong atoh louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ajehchu nigup sunga Pakaiyin van le leiset, twikhanglen, chuleh asunga um jouse chu asema, nisagi ni kicholdo ahi. Hijeh-a chu Pakaiyin choldo nichu phatthei aboh-a asuhtheng ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakai na-Pathen'in nangma napehna leichunga nahinkho asot theina dingin: nanu napa jabolin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tol natha louding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na jon louding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na guchat louding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Naheng nakom douna-a jouthu-a hettohsah-a napan louding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangman naheng nakom in nathangset louding, naheng nakom inneipi jong nathangset louding, asohpa ahin, asohnu ahin, abongchal ahin, asangan hijongle, naheng nakom thil kiti tapou chu nathangset louding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin mipi jouse chun van ginho, kolphet ho, sumkon gin, chule molsang meikhut chu amuvin ahi. Chuin mipi chun hichu amuphatnun, akichonun, gamlatah-a ading taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin amahon Mosi henga, Nangman kahenguva thu seijin, keihon ngainao vinge: Ahin Pathen'in vang kahenguva thu seidahen, ajole kathilo dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin Mosi'n mipi ho henga, Kicha hih-un: ajehchu ama kichatna chu namasang uva auma, nachonset louna dinguva, nangho patep dinga Pathen chu hunga ahibouve, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin mipi chu gamlatah-a adingun; Mosi'n Pathen umna muthim satah lamchu anailutnin ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Pakaiyin Mosi henga, Hitia hi Israel chate henga naseiding ahi, Nanghon van'a kona nangho kahoupiu chu namu taove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nanghon kakoma dangka pathenho nasem loudingu, chule nangho dinga jong sana pathenho nasem lou dingu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Keima dinga leisetna maicham khat nasem uva, chule hiche chunga chu nagovam thiltohou, nachamna thiltohou, chule nakelngoi hou le nabongchal hou nato dingu ahi. Kamin kigeldohna dinga kalhen namun jouse-a chu naheng uva kahunga, phatthei kaboh ding nahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nangman keima song maicham neisem peh-a ahile, song kikhenga nasem louding ahi: ajehchu nangman hiche chunga chu namanchah chu nalapma ahile, hichu nasuhboh ahitai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na sagohkeo chu akimulouna dinga, ka-maicham'a kalbia chu nakal lou ding ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun nangman amaho masanga nakoi ding thutanna ho chu hiche hohi ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangman Hebrew mi soh-a nachoh-a ahileh, kumgup sung aman najending: akum sagi channa leh imacha ngailouva chamlhat dinga chedoh jeng ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama achanga hung lut ahile, achanga potdoh ding: ama jinei ahileh, a-inneipi toh pottha ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A-pakai pan ama chu ji apuipeh ahia, amanun chanu chapa ahinpeh-a ahileh; a-inneipi leh achate chu a-pakai pa-a hiding, chule amachu achanga potdoh ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amavang sohpa chun kichentah-a, Keiman ka pakaipa, ka-inneipi, chule kachate chu kangailui; chamlhatdin potdoh ponge atia ahile:
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuteng a-pakaipa chun amachu thutan ho henga ahin puiding; chujongle amachu kotkhah ham, kotbeng hama apui ding; a-pakaipa chun thil kijumhem khatna abil avupeh ding; chule amachu tonsotna ajending ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule pasal khatnin achanu chu sohnu dinga ajoh-a ahile, soh pasal ho bangin amanu chu potdoh louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amanu chun a-pakaipa, ama kichenpi dinga jihol pa chu alunglhaisah joulouva ahile, akilhatdoh sah kitding ahi. Amapan amanu chu doha-a aboljeh-a, gamdangmi koma johna ding tha anei louding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule amapan achapa dinga anahol ahileh, amapa chun chanuho bangtah-a abolding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amapan jichom dang akipuija ahileh; amanu neh le chah, ponsil, chule nupa hina-a athaneina chu asuhlhompeh louding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule aman hicheng thilthumhi amanu chunga abol louva ahileh; amanu dangka ngailouva potdoh jeng ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Min mikhat avoh-a, amachu athitah-a ahile, amajong thonlouva thatei ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahin mikhatnin achanlhih hilouva, Pathen'in amachu akhutna apehdohjoh ahileh; keiman ajamlut nading munkhat kagonpeh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla mikhat chu ahenasa-a a-inheng chunga achuh-a, doha bola tha agotna ahile; amachu athi teina dinga, ka-maicham'a kona nakaidoh dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koihileh anuham, apaham vo-a chu tha teiding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Koihile mihem khat gua, kijoh, ahilouleh akhutna aum petna kimudoh aumle; amachu thonlouva thatei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Koihile anuham, apaham gaosapma chu thonlouva thatei ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule mi akinah-a, khat chun khatjoh chu songtum ahiloule akhut tuma asuh-a, amachu athilouva, ajalkhuna alupma:
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama chu ahung thodoh kitna, atenggol akiphu-a avahle theileh, mivopa chun aphat suhmang man apeh ding, ajendam selding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khattouvin asohpa ahilouleh asohnu mola avoh-a, akhut luma alouva ahile; amachun thonlouva talen amat ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amavang nikhat ham, nini ham ahinna ahile, amachun talen amatlou ding ahi; ajehchu amachu adangka man ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule pasal le pasal akinah-a, numei naovop asuhkhah lhona, agai ajula, ahia la amanu chu ima atilouva ahile; numeinu inneipun achunga chu adeljat dungjuija talen amatding; chule thutan hon aphatsah dungjuija aditding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amavang setna-in ajuikhah tah-a ahileh, nangman hikho khela hikho napehding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mit khela mit, ha khela ha, khut khela khut keng khela keng,
  </para>
  <para style="p">
    <verse number="25" style="v" />Meija kihal meija, maha khela maha, kijep khela kijep napeh ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mikhatnin asohpa mit ahim, asohnu mit ahim abehpeh-a, hichu achot tah-a ahile; amitjeh-a chu ama chamlhat dinga alhadoh ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule asohpa ha ahim, asohnu ha ahim avohlhoh-a ahile; aha jeh-a ama chu chamlhat dinga alhadoh ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bongchal khatnin pasal ham, numei khat apih-a, amachu athia ahile; bongchal chu thonlouva songa selih teiding ahin, chule asa chu nehlou ding; ahinla bongchal neipa vang chu lha-ong ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahin chuche bongchal chu masanga jong mipih ngai ahia, aneipa chu kihetsah sa ahitah-a, aman in'a achintup loujeh-a pasal ham numei ham khat atha-a ahileh; bongchal chu songa selih ding, chule aneipa jong tha ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sum joh-a leosah ding chu achunga achuh tah-a ahile; ahinna akichoh dohna dinga chu akitep jat chu apeh ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Apih chu chapa hihen chanu hijongleh, hiche thutanna banga hi achunga kibol ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bongchal chun soh pasal ham, soh numei hamkhat apih-a ahileh; bong neipa chun apihpa pakaipa chu dangka shekel somthum apehding, chule bongchal chu selih ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mi khattouvin kotong ahon ham, ahiloule kotong alaija, kotong sinlouva akoija, bongchal ham, Sangan ham khat alhahlut na ahile;
  </para>
  <para style="p">
    <verse number="34" style="v" />Kotong neipa chun aman chu aditding, gancha neipa chu sum apeh-a, gancha thi chu ama changding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule mikhat bongchal'in midang khat bongchal asuh khah-a, athia ahile; bongchal ahing nalai chu ajoh lhonding, aman kihom lhonding ahi; chule bongchal thisa jong chu asa kihom lhonding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahilouva chuche bongchal chun masangin jong gancha apihji ti kihesa ahia, aneipan achintup lou ahile; aman thonlouva bongchal khela bongchal apehding; chule athipa vangchu ama chang ding ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khattouvin bongchal ham, kelngoi ham khat aguh-a, hichu atha ham, ahiloule akijohdoh ham ahile; aman bongchal khat chu bongchal nga-a asahding, chule kelngoi khat chu kelngoi li-a asah ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gucha khatnin in aphet vangpet akimudoh-a, akivohna-a athitah-a ahile, amajeh-a thisan kiso louding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nisan asokhum tah-a ahile, ama-a dinga thisan kiso ding; aman alhingsetna aditding ahi; itihama imacha aneilouva ahileh, athilguh mana chu ama kijoh ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule athilguh chu bongchal hihen, sangan hihen, ahiloule kelngoi hihjongle, hichu ahinga akhutna akimudoh-a ahivangle; ajat ni-a aledit ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi khattouvin louham, lengpilei ham khat anehsah-a, agancha chu alhatlutna, midang lou chu aneh sah-a ahile; alou aphapen tah leh alengpilei phapena chu aditding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mei ahung kah-a, linglah akahmatna, changphal setlomsa ham, chang atlhuh loulai ham, ahiloule louham akah mangsoh jeng tah-a ahile; meihal pa chun thonlouva adit teiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mikhatnin a-inhengpa koma dangka ham, nehding ham chin dinga apeh-a, chuche mipa in'a kona chu akiguhmang tah-a; gucha chu akimat doh-a ahile ajatnia asah ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule gucha chu akimatdoh louva ahile, a-inneipa chu a-inhengpa thilho chunga chu akhut anat anatlou hetna dinga thutan ho henga puiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Suhkhelna jouse, bongchal thu hihen, sangan hihen, kelngoi hihen, ponsil hihen, itobang thil mang hijongle, hichu midang khatnin keija ahi tia aseija ahile, alang teni chu thutan ho anga hunglhon ding; chule thutan hon themo achan penpen chun a-inhengpa chu jatni-a asahding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mikhatnin a-inhengpa koma asangan ahim, bongchal ahim, kelngoi ahim, gancha poupou achin dinga apehdoh-a; hichu koima mulouva athi ham, akitongkha-a ham, akinomanga ham ahile;
  </para>
  <para style="p">
    <verse number="11" style="v" />A-inheng thilkeo chunga kakhut anatpoi ti hetna-a, Pakaiya kihahselna chu akahlah lhona umding; hichu agan neipa jong noma, aman jong hichu aditlou ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahin hichu akoipa koma kona kigumanga ahivangle, aman aneipa chu aditding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichu akimal tel soh ahi tah-a ahile, aman hichu hettohsahna dingin hinchoi hen, aman akimaltelsa chu aditlou ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mikhatnin a-inhengpa gancha khat chu man dinga alah-a, hichu athi ham, akisukha ham ahile; aman adit teiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin aneipa chu akoma um ahivangle, aman adit louding ahi: hichu apa kila ahile, aman peh dinga kithalah ahi-a ahile, akithalah man chutoh kitoh ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mikhatnin nungah mi jihol hiloulai khat alheplhah-a, aluppi-a ahile; amapan amanu chu ajiman ding apeh-a akichenpi teiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amavang nungahnu pa chun ama chutoh akichensah nomlouva ahile, aman nungah theng man dungjuija hichu apeh ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangman mitphel doi choi chu nahinghoi louding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Koi hileh ganchatoh lumkhoma chu thatei ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Koihile Pakai khatseh heng tilouva, pathen dang pou pou henga ganlhaina bol tapou chu suhmang hel ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangman kholjin mi na-engbol louding, boljong nabol genthei lou helding ahi: ajehchu nangho jong Egypt gama kholjin nanahiu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanghon meithai tapou le paneilou chapang chu nasuh genthei loudiu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nanghon iti ham khatna amaho chu nasuh genthei juva, kahenga ahung ka poupou uva ahileh, keiman akanao chu kangaipeh tei teiding;
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule kalung hanna hung soudoh-a, chemjam'a kathagam dingu; chuteng na-inneipi teo chu meithai soh uva, nachateo chu pabei sohgam ding ahiuve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nakoma um kamite mivaicha khattou chu sumpa napeh-a ahile, ama-a dinga chu sumthoi lami nabahlou ding, chuleh achunga athoi jong nakoi louding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangman na-inheng ponsil chu abat mana nalah tah-a ahile, nangman nisalhum masanga nalepeh teiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ajehchu hiche bou chu akitomna aneisun ahin, avun dinga ponsil ahi. Ama hoilaija lumding hitam? chule hung hiti ding ahi, kahenga ahung ka teng, keiman kajahpeh ding ahi; ajehchu keima lungset themtah kahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangman Pathen nahouset louding, namite lah-a vaihomho jong nagaosap louding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangma natheiga min masa holeh nalengpi twiho tohdinga nageisang louding ahi. Nachapa te lah-a apeng masapen chu keima neipeh ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chutobang ma-a chu bongchal ho le nakelngoi ho nabolding: ni sagi apitoh uma; niget nileh keima neipeh ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule nangho keima dinga mitheng nahidiu ahi: nanghon gamsa hon gama amaltel sao sapou pou naneh louhel dingu; uicha ho naselhah peh dingu ahi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangman jouthu nalhut louding ahi: chonphalou hettohsah hidinga migilouho toh naki khutjop louding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thilse bolna dinga mipi chu najui louding; chuleh mipi chun thudih tah chu adihlou sosahna ding agot naova jongchu thu nasei louding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahiloule mivaicha jong achungthu kitan na-a langneina namusah ding ahipoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangman namelma bongchal ham, sangan ham ava mang namu-a ahileh, thonlouhela ama koma nahin puikit ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangma vetda mikhat sangan chu apohgih noija opden namu-a, kithopi ding nada-a ahijongle, thonlouva nakithopi ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangman nami vaicha kiheh na-a adihna chu nahei mangpeh louding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jouthu-a konin nangma gamlatah in kikangsen; chule themona neilou le mi kitah chu that hih-in: ajehchu keiman migilou chu them kachansah louding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule nangman nehguh nabol louding ahi: ajehchu nehguh chun michingho mit achot sah-in, michonpha ho thuseidoh chu aheimangjin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujongle nangman kholjin mi nasuh genthei louding ahi: ajehchu nangma Egypt gama kholjin nahi jeh-in, kholjin mi lungthim nahen ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kumgup sunga nangman nagamsunga muchi natu ding, chule muchi gaho chu nalo khomding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin kum sagi chana leh, namite lah-a mivaicha hon aneh theina diule, amahon adalhah hou chu gamsa hon aneh theina diuva, nangman gam chu nakicholdo sah-a nakoithim ding ahi. Chutobang ma-a chu nalengpilei le Olive lei jong nabolding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nigup sunga nana nakitoh ding, ni sagi channi leh nabongchal leh na sangan acholdo theina dingleh, nasohnu chapa le kholjin jong akitha-ol theina diuva, nacholdo ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nahenga kaseisa thil jouse-a hin nangma chingthei tah-in umin; chule pathen dangho min him him chu phapoh hih-in, nakama konin jong kijadoh hihhen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangman kum khat sunga keima dinga kut thumvei nanit ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangman cholsolou changlhah kut nanit ding ahi: (Keiman nangman kathupeh banga phat kitepna Abib lha sunga chu cholsolou changlhah nisagi naneh ding ahi; ajehchu chuche lha sung chu Egypt gama kona nahungdoh ahi. Chule koimacha kamasanga khutgoh keova hungkilah louding ahi).
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule louva natuho natoh gimna ga masapen lholhun kut nanit ding: chule kumlhun na louva kona natoh gimna ga jouse khopkhomna lhosoh khoptup kut nanit ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kumkhat sunga napasal hou jouse Pakai Pathen angsunga thumvei kilahsoh keidiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahenga kilhaina nabolnao thisan chu chol kiso changlhah toh natotha louding; chule ganna eikilhaina sathao chu jingkah geija umden louding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nagamga masaho lah-a aga masapen chu Pakai na-Pathen in'a nahinchoi ding ahi. Nangman kelnou chu api noitwija nahon louding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ven, lampia naching dingle keiman kagotpehna munna napuilut dingin namasanga vantil khat kasole.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama chunga chingthei jinlang athu ngaijin, chule lunghansah hih-in; ajehchu aman nasuhkhel naho angaidam louding ahi. Ajehchu ama-a chu kamin uma ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahin nangman ama thu nangai tahbeh-a, kasei jousehi nabola ahile; namelmaho dinga melma kahiding, nadouho dinga akidoupiu kahiding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu ka vantil na masanga che-a, Ammon miho, Amor miho, Hit miho, Perizz miho, Canaan miho, Hiv miho chule Jebus miho henga chun napuilut ding: chule keiman amaho chu kasatgam ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A-pathen hou henga nakun louding, jen jong najen louding, chule athilbol banguva jong nabol louding ahi. Amavang hicheho chu nasuhmang hel ding, chule amilim hou chu nasuhchip sohkei ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nanghon Pakai na Pathen'u chu najendiu; aman nachanglhah le natwi phatthei abohding; chule nalah-a kona natna kalahmang ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nagam sunga koimacha ajula leh achinga umloulou ding; keiman nahin nikho hou chu kasuh bulhing peh ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kichat ka umna chu namasanga kasol ding, akomuva nahung nading mi jouse chu kasuh mang ding, chule namelma te ho jouse kanung ngat sah ding nahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule keiman namasanga khoingal ho kasol ding, hiho chun Hiv mite, Canaan mite, chule Hit mite na-angsunga kona adelmang diu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Namasanga kona kumkhat sunga kadel mangsoh louding ahi; achuti louleh gamsung chu kamhelin tin, nangma doudinga gamsaho hungpung dingu ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangma nahung punna, gam chu nalosoh kahse-a, amaho chu lhomcha cha-a namasanga kona kadelmang ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule nagamgi chu twipi sana kona Philistine twipi chan, nelphaija kona vadung chana kasem ding ahi: ajehchu keiman chugama chengho chu nakhutna kapehdoh ding; chule nangman amaho chu namasanga kona nadel mang ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangman amaho le a-pathenhou toh kitepna imacha nasem louding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amaho nagam sunga chenglouhel diu ahi; achuti loule amahon keima dounan nachonset sah dingu ahi. Ajehchu nangman a-pathen hou najenna ahile, hichu nangma dinga thang hitei ding ahi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin aman Mosi henga, Nangma Aaron toh, Nadab toh, Abihu toh, chule upa somsagi toh Pakai hengah hung kaltouvun; chule gamlatah-a konin neihin houvun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule Mosi changseh bouvin Pakai kom ahin nai ding ahi: ahin amahon vang ahin nailou dingu; chule mipi chu amatoh chetou loudiu ahi, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin Mosi ahungin, Pakai thu jouse le thutanna jouse chu mipi aseipeh tan ahi. Chuin mipi chun aw khat tah-in adonbutnun, ajah-a, Pakaiyin thusei ho jouse chu kabol dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi'n Pakai thusei ho jouse chu asunin, jingpi matah in athouvin, lhang noija chun maicham khat le Israel phung somle phung ni dungjuijin khompi somleni aphutnin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman Israel chate lah-a gollhang ho asolin, amahon Pakai henga pumgo thilto atoh-un, chule bongchal khatna chamna thilto ganlhaina abolun ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n thisan akehkhat chu alan, twikong ho-a chun akoijin; chule thisan akehkhat chu maicham chung chu athe khumin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman kitepna lekhabu chu alan, mipi ho jahdin asimdoh-in ahi. Chuin amahon, Pakaiyin asei jouse chu kabol dingu, chule asei kangai dingu ahi, atiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Mosi'n thisan chu alan mipi ho chu athe khumin, ajah uva, Veuvin, hicheng thuho jouse thudola Pakaiyin thisan kitepna asem hi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chujouvin Mosi toh, Aron toh, Nadab toh, Abihu toh, chule Israel upa somsagi toh achetou taovin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin amahon Israel Pathen chu amuvin: Akengto chotpha chu khi-eng song lhong kisem bangleh, athendan chu van then bangin athengin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman Israel milen milal ho chunga akhut angampon ahi: chujongle amahon Pathen chu amuvin, chule aneovin, adonun ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin Mosi henga, Molsang chunga hin kahenga hungkaltou vinlang, chua chun umin: chule keiman nangma danthu le songpheng hochunga kasut kathupeh chu amaho nahil dinga kapeh ding nahi, ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin Mosi le alhacha Joshua chu akipatdoh lhonin; chule Mosi chu Pathen molsanga chun akaltou tan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman upa ho henga, Naheng uva kahung kile kahseovin hikoma hin keini eina ngah jingun: chule veuvin, Aaron le Hur nakom uva aumlhone: koihile thunoh nei na-umuleh, amani henga chehen, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mosi molsang chunga akaltouvin, chuin molsang chu meilom'in atomchah tan ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin Pakai loupina chu Sinai molsanga chun aumjingin, nigup sung chu meilom'in atomchah-in ahi. Chuin nisagi chanin aman Mosi chu meilom lah-a konchun ahinkouvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin molsang chung vuma Pakai loupina chu Israel chate mitmun kavamthei meikong abangin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Mosi chu meilom lah-a chun alutnin, molsanga chun akaltou tai. Chuin Mosi chu nisomli le jan somli molsanga chun aumtan ahi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga thu aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel chate henga chun keima dingin thilto ahin choina dingun seijin: mitin alungcham tah-a peho-a kona keima dinga thilto chu nalahding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangman amaho-a kona thilto nalahding chu hichehi ahi; sana, dangka, sum-eng,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pat adumloi, asandup loi, asanthip loi, patngat, kelmul,
  </para>
  <para style="p">
    <verse number="5" style="v" />Kelngoichal vun kidesan, satuilut vun, thinggi thing,
  </para>
  <para style="p">
    <verse number="6" style="v" />Vahding thao le gimnamtui thaova nuding thil namtui,
  </para>
  <para style="p">
    <verse number="7" style="v" />Boitong sangkhol le a-ompho chunga behding khisonggel le songho ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule amaho lah-a kachenthei nadingin, amahon keima dingin muntheng eisempeh uhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Houbuh kigon limleh amanchah ho jouse chu kigon lim kavetsah sa jouse bangtah-a nasah dingu ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amahon thinggi thinga kitepna thingkhong asemdiu: adung tong ni le akeh, avai tong khat le akeh, chule atun chu tong khat le akeh hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nangman hichu sana thengtah-a asungleh apo nalonkhum ding, chule achung kimvela chu sana lallukhuh lim nasem ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman hiche dinga chu sana chaokol li nalhah ding, chule chuche ningli-a chu hicheho chu nabuding ahin; chaokol ni chu asih lang khat na, chule chaokol ni ma chu asih langkhat na nabuding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nangman thinggi thing mol lhon ni nalah-a, hichu sana-a nalonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule thingkhong chu amahon ajontheina diuva, kitepna thingkhong sih-a chaokol ho sunga chu mol lhon teni chu nagol lutding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mol lhon ho chu kitepna thingkhong chaokol ho sunga chu chuti umden ding; hiche teni chu kiladoh louhel ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule kitepna thingkhong sunga chu kapeh ding hettohsahna chu nakoilut ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule nangman sana thenga hepi touna nasemding, asao tong ni le akeh, chule avai tongkhat le akeh hiding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangman hepi touna mong teni-a chu thih kikhetna-a kikheng sana-a kisem Cherub ni nasem ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule Cherub khat chu alangkhat monga nasemding, khat chu achom langkhat monga nasemding; hepi touna chunga chu among langto-a Cherub ni nasem ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Cherub teni chun sangtah-in alha ajal lhonding, alhaho chun hepi touna chu akhuding, chuleh amailhon chu kingatto gelding; Cherub teni mai chun hepi touna lam chu angat lhon ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule nangman thingkhong chunga chu hepi touna chu nakoiding; chule thingkhong sunga chu keiman kapeh ding hettohsahna chu nakoiding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule chukoma chu nangma kimutopi ding, Israel chate henga kathupeh ding jouse chu hettohsahna thingkhong chunga um hepi touna chunga Cherub teni kikah-a kona chu kaki houpi ding nahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangman thinggi thinga dokhang khat nasemding: adung tongni, avai tong khat, atun tong khat le akeh hiding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hichu sana thenga nalonkhum ding, chule agei kimvela sana lallukhuh lim nasemding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nangman akimvela chu khutpeh te agei nasemin ding, agei kimvela sana lallukhuh lim nasem ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule sana chaokol li nasema, akeng li kimvel aning li ho-a chu chaokol hochu nabu ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dokhang jon nading mol lhon khumlutna dinga chaokol ho chu ageichin na nabuding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule thinggi thinga mol lhon nasem ding, hiche teni-a chu dokhang chu akijon theina dinga, sana-a nalonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule hiche-a dinga chu akongho, akheho, asinho, chule twikongho nasem ding; chuleh hicheho chu sana thengsela nalonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule vetsahna changlhah chu kamasanga dokhang chunga nakoijing ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule sana thengtah-a thaomei khom khat nasem ding: thaomei khom chu akhetna-a kikhenga nasem ding ahi. Atunna atopal, abahho, alhengho, amumho, chule apahcha ho chengse chu pumkhatna nasemding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule chuche asih langto-a kona chu abah gup hungdoh ding; asih khatna kona thaomei khom abah thumna umding, asih khatna kona chu thaomei khom bah thum ma umding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule abah khatna chun jonmot ga banga kisem lheng thum, apah mun le apah pahlhah umding, chule abah dang khatna jong chu jonmot ga banga kisem lheng thum, apah mun le apah pahlhah umding; chutia chu thaomei khoma kona hungdoh abah gup ho-a chu umcheh ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule thaomei khoma chu jonmot ga banga kisem lheng li, amum hole apah ho puma umding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule abah chungnung pen teni noija chu aboh khat umding, anina abah teni noija jong chu aboh khat, chule athumna abah ni noija chu aboh khat umding, hitia chu thaomeija kona hungdoh abah gup dungjuija chu umcheh ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Akhom ho le abahho chu sana pumkhatna kona kisem, sana thengtah-a kikheng hiding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule hiche-a dinga chu thaomei sagi nasem ding; chule meivah chun amasang chu asalvah theina dinga amahon thaomei chu ahal dingu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule chuche-a achaiche ho le ameivam dolna kongho chu sana thengsela kikheng hiding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hicheng um le bel ho jouse hi sana thengsel talent khat toh kikotna agih-a kona semding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule molsang chunga alim kigondan kavetsah bang banga chu nasem nadin chingtheijin.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuche kalvala jong nangman houbuh chu tupat ngatsel kilhuh cheh adum, asandup chule asanthip pondal soma nasemding: hicheng chunga chu khut them tah-a Cherub ho lim nasemding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pondal khat chu atun tong somni le tong get, chule pondal khatchu avai tong li hiding; chule pondal jouse chu kibang chehdiu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pondal nga chu khat le khat kijopmat sah ding; chule pondal dang ngajong chu chutima chu kijop matsah ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Akimatna sunga agola kona chu pondal khat geija a-enga abil nasemding, chutobanga chu anina gola aponung pen geija jong nasem ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pondal khatna geija chun abil somnga nasemding, chule pondal ani chana gola aponungpen pondal geija chun abil somnga nasemding, abilho chu khat le khat kikoimat ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule sana-a ponche chahna somnga nasema, chule pon chechah na ho-a chu pondal ho chu achemat toding: chutengleh houbuh khat hung hiding ahitai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule houbuh chung khuna dinga chu kelmula kisem pondal ho nasemding: pondal somlekhat nasemding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pondal khat chu tong somthum cheh saoding; chule pondal khat avaichu tong li cheh hiding: chule pondal somlekhat chu kibang chehdiu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule pondal ngaho chu khatle khat kikoimat ding: chule pondal gupho jongchu khatle khat kikoimat ding: chule houbuh mailam pondal gupna chu thoni hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule akil matna ponungpen pondal geija chu abil somnga nasema, chule akoimatna ani channa pondal geija jong abil somnga ma nasemding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule sum-enga ponche chahna somnga nasema, ponche chahna hochu abil ho-a chu nathilding: pon in ahithei na dinga nakoimat sohkei ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pon in'a pondal ho aval chengse, pondal akeh valdoh chengse chu houbuh tomlama kikhaiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule alang khatna tongkhat, alang chom khatna tong khat, pon in pondal ho adungjuija avaldoh chu, houbuh hilam pang le khulam panga akhudinga kikhai lhato gelding ahilhone.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule chuche pon in chung khuna ding chun kelngoichal vunho akide san nasemding, hiche chungvuma achung khuna ding chun satuilut vunho nasemding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule houbuh thingpeh ho chu thinggi thing ading jang keija nasemding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thingpeh khat chu adung tong som, chule thingpeh khat chu availam tong khat le akeh hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thingpeh khat cheh-a chu butonako dinga aki-at kot ni cheh umding: chutia chu houbuh thingpeh jouse chu nasemding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule nangman thingpeh somni chu lhanglama pangdinga, houbuh thingpeh ho nasemding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule thingpeh somni ho noija chun dangka khombul butona ding ko somli nasemding; thingpeh khat noija butonako ni dingin khombul kigeitong ni, chule thingpeh chom dang noija butona ko hidingin khombul kigeitong ni ma nasem kitding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Houbuh pang ani chana sahlam panga chu thingpeh somni hiding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule dangka khombul kigeitong somli ho, thingpeh khat noija khombul butona ko ni, chule thingpeh chomdang khat noija khombul butonako ni cheh nasem ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule houbuh tomlama, lhumlam sanga chu thingpeh gup nasem ding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule houbuh tomlam aning ni-a dinga thingpeh ni nasemding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule hiteni chu anoilama chu kithokop lhonding, chule achunglama chu achina thih chaokol khatna tuhmat hiding ahi. Chutia chu anigel lhona dinga chu chutiding; hiteni chu aning teni-a ding hiding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hitia chu thingpeh getna chu sana butonako ho, thingpeh khat noija chu abutona ko ni, adang thingpeh noija jong chu nima abona somlegup umding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule thinggi thinga banggol ho nasem ding; houbuh pang langkhatna thingpeh ho-a ding chu banggol nga,
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule houbuh pang langkhatna thingpehho dinga chu banggol ngama; chule lhanglam houbuh tomlama thingpeh ho dingin banggol ngama nasemding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule thingpeh ho lah-a akima banggol chu among khatna pat among langkhat geija kigolpai ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule thingpeh ho chu sana-a nalonkhum ding, abangolho thunlutna dinga chu chaokol nasemding: chule abanggol jong chu sana-a nalonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule houbuh chu molsang chunga nakimusah lim bang banga chu nasah ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule pondala dinga pat adum, asandup, asanthip, chule tupat ngatsel akilhuh-a kikhong nasemding: chule Cherub limho chu khut them tah-a nasemding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule sana kilonkhum dangka khombul ho-a kiphut thinggi thing khom li chunga chu nakhai ding; koikaho chu sana hiding, dangka-a kisem butonako li chunga chu kibut ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule hettohsahna thingkhong chu pondal sunga napohlut theina dinga, pondal chu pon chechahna ho noija chu nakhai ding, chule pondal chun munthengle muntheng chungnung chu nahopkhen pehding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule muntheng chungnung sunga chu hepi touna chu hettohsahna thingkhong chunga nakoiding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule pondal polama chu dokhang chu nakoiding, chule meivah khom chu dokhang jon, houbuh pang lhanglam sanga nakoiding: chule dokhang chu sahlam sanga nakoiding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule houbuh kotna dinga chu ponjal adumloi, asandup, asanthip, chule tupat ngatsel kilhuh-a kikhong, heova kijemhoiho chu kikhai ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule akikhai nading chu thinggi thinga khom nga nasemding, chule sana nalonkhum ding, akoika hojong chu sana kisem hiding ahi. Chule hicheho dinga chu sum-enga khombul butonako nga nalhah ding ahi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule thinggi thinga kisem maicham khat nasemding, hichu adung tong nga, avai tong nga hiding; chule maicham chu aningli kibang hiding: chule asan tong thum hiding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aning li ho chunga chu akiho nasemding, akiho chu kithakhat ding; chule hichu sum-enga nalonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule avutvam ho dona ding kongho nasemding, vut lona kheho, akongtong, asakoika ho, chule achaiche ho jong, hiche um le bel ho jouse chu sum-enga nasemding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hicheng ding chu sum-eng kiphan len nasemding; chule len chunga aning liho-a chu sum-eng chaokol nabuding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Len chun maicham noilam gei ahin phahna dinga, len chun maicham kim aphah ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule maicham putna dinga chu mol lhon, thinggi thing mol lhon nasemding; chule hiho chu sum-enga nalonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule mol lhon hochu chaokol hom sunga chu nathil lut ding, chule aputna dinga maicham langto-a mol lhon chu umding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thingpeh hochu alai homa nasemding: molsang chunga nakimusah banga chu asem dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule houbuh hong sung nasemding: lhanglam panga hongsung dinga chu tupat ngatsel kilhuhkop, langkhat pang dinga tong jakhat sao ponjal kikhai ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule akhom somni chule khom butona koho somni chu sum-eng hiding: akhom koikaho le agol laiho chu dangka kilonkhumsah hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutobang machu sahlamsanga dinga adung tong jakhat sao kikhai pondal le khom somni, chule sum-eng khom butona koho somni umding ahi. Akhom koikaho le agol laiho chu dangka kilonkhum hiding ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule lhumlam sang hongsung availam ding akikhai pondal kikhai tong somnga hiding: akhom som le khom bul butona ko som hiding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule solama um hongsung availam solamsang chu tong somnga hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kotpi sihlang khatna pondal kikhai chu tong somlenga hiding, chule akhom thumtoh akhombul butona ko thum toh hiding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule asih chomlang khatna chu pondal kikhai tong somlenga umding: akhomho thumtoh akhombul butona ko thumtoh umdiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule ahongsung kotpi dinga chu pondal kikhai tong somni, adum, asandup, asanthip, tupat ngatsela kilhuh khutthem tah-a kijemho chu kidah ding ahi. Akhomho chu li hiding, akhombul butona ko chu li ma hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahongsung kimvela khomho jouse chu dangka kilonkhum hicheh ding, akoikaho chu dangka-a kisem hiding; chule akhombul butonaho chu sum-eng hidiu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahongsung chu adung tong jakhat, availam chu tong somnga, chule asan ngatsela kikhuh kopma kikhong tupat pon chu tong nga hiding; chule akhombul butonako hochu sum-eng hiding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Houbuh kinbolna jouse-a kongle bel ho jouse le athil kilnaho jouse, chule hongsung kilna ho jouse chu sum-eng hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule thaomei chu avahjing theina dinga, Israel chate chun olive thaochim kiheh lha nahenga ahinchoi jingna dinguva nathupeh ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mipi kikhopna houbuh hettohsahna masanga pondal polama chu Aaron le achapate chun Pakai angsunga nilhah-a pat jingkah changeija avet tup dingu ahi. Israel chate thalhenga akhang lhumkei juva chona dan hiding ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Israel chate lah-a konin nasopipa Aaron le akoma um achapate chun thempu tohmuna eijen theina dingun, Aaron le chapate Nadab, Abihu, Eleazar chule Ithamar chu nakoma lhengdoh-in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule nasopipa Aaron loupina le vet hoina dinga vontheng nagon pehding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule alungthim them le chihna lhagaova kadip dimho jouse henga chun nangman thu seijin lang, Aaron chun thempu tohmuna chu keima eijen theina dinga suhthenga aum theina dingin avonho chu sempeh uhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amahon asemdiu vonho chu: ompho, boitong sangkhol, sangkhol len, akijempah delkop, konggah hiding; hitia chu amahon thempu tohmuna keima eijentheina diuva, amahon Aaron le achapatea dinga vontheng ho asempeh dingu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amahon sana, pondum, ponsandup, ponsanthip, chule tupat naljet amandiu ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule amahon sana le pondum, ponsandup, ponsanthip, chule tupat naljetna boitong sangkhol chu khut themtah-a asemdiu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Akijopmat theina dinga chu alengkou teni chunga agenhon kikilmatna aneiding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule boitong sangkhol chunga um akijempah konggah jong chu thakhat hiding; sana, pondum, ponsandup, ponsanthip, chule tupat naljetna akisem hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule khisonggel ni nalah-a achunga chu Israel chate min nasutding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aminu gup chu songkhat chunga chu nasutna, adang minchom gup chu apendolu dungjuija songchom chunga chu nasutding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Min kitana mohor chunga songkheng themin akhenji banga, songpheng teni-a chu Israel chate minho nakhet ding: hiho chu sana jemho-a nasemdoh ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Israel chate dinga hetjingna songho hidinga, chuche song teni chu boitong sangkhol lengkoupeh teni-a chu nakoiding; chule Aaron'in hetjingna dinga alengkou teni chunga minho chu Pakai masanga apohjing ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nangman sana jemkoho semin,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nangman sana chaokol thengtah jangni pahvui kithil banga nasema, jemkoho-a chu nahenchah ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule thutana ompho khut themtah-a nasem ding: boitong sangkhol kisem bang banga sana, pondum, ponsandup, ponsanthip, chule tupat naljetna nasem ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aning li kibanga atho-a kilhep ding; adung khapkhat, avai khapkhat ma hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule chua chu song buding ho chu nabuding; song chu gol li-a nabuding ahi. Agol masa chu songsan, song-eng, chule song santhip hiding: hichu agol masa hiding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule agol nina chu song engsel, song dumjet, chule song mantam hidiu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule agolthum na chu song sandang, song vom, chule song sandup hiding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule agol lina chu song engdum, khisonggel, chule khi song pol hiding ahi. Hiho chu akiphunao muncheh-a sana lonkhumcheh ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule song ho chu Israel chate dungjuija, amin dungjui cheh uva somleni hiding: mohor kikheng ho banga phung som le phungni dungjuija khatcheh chu amintoh umcheh ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule ompho chunga chu sana chaokol thengtah pahvui kithil banga sana sumgui nasemding ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule ompho chunga chu sana chaokol ni nasema, chaokol teni chu ompho ning teni-a chu nabuding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule pahvui banga kisem sana sumgui teni chu ompho ning gela um thih chaokol sunga chu thillut ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule pahvui banga kisem thih chaokol mong teni chu jemko ni-a chu nahetlut ding, boitong sangkhol lengkou anglam sanga chu nakhichah ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule sana chaokol ni nasema, hichu boitong sangkhol bantah-a, asungnung geija ompho ning teni-a chu nabuding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule sana chaokol chomdang ni nasemding, boitong sangkhol lengkou teni noilamsang, amasanglam, atho-a kilhepna noi, boitong sangkhol khut kijempah-a konggah chung laitah-a chu nabuding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule amahon ompho chaokol ho le boitong sangkhol chaokol ho chu amahon patdum kipheh khatna akan matdiu, hiche chu phatah-a kipheh boitong sangkhol konggah chunga aumtheina ding le boitong sangkhola kona chu akikan louna dinga ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Aaron chun Pakai masanga hetjingna dinga munthenga chu achelut seh a-op phang dontah-a Israel chate min kijihna thutana ompho chu tantih neilouva apoh jingding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule nangman Urim le Thummim chu thutana ompho sunga chu nakoilut ding, chule Aaron Pakai anga ache tengle hichu alungchang dontah-a umding ahi. Hitia chu Aaron'in Israel chate thutana chu alung chung dontah-a imatih chana Pakai anga apohding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule nanghon chuche boitong sangkhol chol chu adum jenga nasem dingu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule hichu achung le alai dona ahom khat umding; chule ahom kimvela chu a-eh louna dinga akhichahna tupat sangkhol ponung ngong khina khaokipheh detchet umding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule chuche geiho-a chu adum, asandup, asanthipma kolbuthei ho nasemding: chule akahho kimvela sana changeng ho nakhai ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sangkhol len gei kimvela chu sana changeng le kolbutheiga, sana changeng le kolbutheiga nasem ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichu kinbolna dinga Aaron'in akivon ding; chule athi louna dinga, Pakai anga munthenga alutle apotle tengle agin kija ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule sana thengsela kong khat nasemding, achunga chun mohor kikhen banga PAKAIYA DINGA ATHENG tia nakhet ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule hichu delkop chunga aumtheina dinga patkhao dum khatna nabuding: hichu delkop masang jontah-a chu umding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule Aaron'in Israel chaten athiltheng tohouva athensona diu akhan gitlouna hou chu apoh nadinga hichu Aaron chalpanga umding ahi. Chule amaho chu Pakai anga san ahitheina dinguva hichu achalpanga apoh jingding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule tupat ngatsela sangkhol chol chungnung chu khut themtah-a najep hoi ding, tupat ngatsela delkop nasemding, chule konggah chu hoitah-a nakhui ding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule Aaron chapate dinga loupina ding le hoina dinga sangkhol sungnung nasema, amaho dinga konggah ho nasemding, chule delkop ho jong nasem ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule hicheho chu nasopipa Aaron le aumpi achapate navonpeh ding; chule amaho chun kamasanga thempu tohmuna keima eijentheina diuva thao nanu-a nasuhtheng ding, chule nachom khending ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule asagoh-u khukhumna dingin amaho chu tupat pon tokaho nasempeh ding; hichu akonga pat apheigei lhungding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule hichu Aaron le achapaten houbuh ahunglut phatnu ham, ahiloule munthenga lhacha dinga maicham ahinnai phatnu ham tengule, khangit louna apoh uva athi louna dinguva achen chehdiu ahi. Hichu amale anunga achilhah channa jong a-itih-a dinga chonna dan kisun hiding ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thempu tohmuna eijen theina diuva suhtheng ahina diuva amaho chunga nabolding chu hiche hi ahi: nolna beihel bongchalgol khat le kelngoichal ni nalah ding,
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule cholsolou changlhah, thao toh kihal cholsolou changlhah le changlhah lum, chule thao toh kihal changlhah pheng nalah ding; hicheho chu suhlou changbong nelsela nasemding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hicheng chu nangman pocha sung khatna nakhol khoma, pocha puma nahin todoh ding; chule bongchal le kelngoichal teni jong chu nahin kailut paipai ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule Aaron le achapate chu houbuh mun'a chu nahinpuija, twija nakisil sah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuteng le vonho chu nalah-a, Aaron chu boitong sangkhol leh pon sangkholen, boitong sangkhol le ompho chu navonpeh ding: chule khut themtah-a kijempah boitong sangkhol khaigahna-a chu akong nagehpeh ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule aluchanga chun delkop nakop peh-a, lukhuh theng chu delkop chunga chu nakhuhsah ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuteng nuding thao chu nalah ding, alu chunga nalhei lhah-a, amachu thao nanuding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule achapate chu hinpuilut nahin puilut ding, sangkhol chol chungnung na-ah peh ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Aaron le achapate chu konggah ho nageh peh-a, delkop nakoppeh ding: chule thempu tohmun chu amahoa dinga a-itih-a chonna dan khatna umding ahitai. Chule nangman Aaron le achapate chu nathenso ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule bongchal chu houkhom ho houbuh masanga nahin kailut sah ding; chule Aaron le achapaten bongchal luchunga chu akhutnu angapdiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule houkhom ho houbuh kotphung Pakai angsunga chu bongchal chu nathading ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule bongchal thisan chu nalah-a, nakhut junga maicham sakiho chunga chu nakoiding; chule thisan jouse chu maicham bula chu nasunlhah ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule asunga beh athao jouse nalah-a, athin chunga athaolom, akalteni chule achunga thao ho chu maicham chunga nahalding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin chuche bongchal saphe le avun, chule a-eh chu gebuh polama meija nagovam ding ahi. Hichu chonset thilto ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule kelngoichal chu nalah-a, Aaron le achapate chun kelngoichal luchanga chu akhutnu angapdiu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule kelngoichal chu nathading, chule athisan chu nalah-a maicham chung kimvel chu nathekhum ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule kelngoichal chu ahal ahalla nasem nonga, asung ho le akeng ho chu nasopding, ahal hala asa semnong sa le alu chutoh nakoitha ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule kelngoichal chu apumpia maicham chunga nagoding ahi. Hichu Pakai dinga govam thilto ahin; hichu Pakaiya dinga meija kisem thilto, gimnamtui tah chu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule kelngoichal dang khat chu nalah-a, Aaron le achapate chun kelngoichal luchanga chu akhutnu angapdiu ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuteng nangman kelngoichal chu natha ding, chule athi chu nalah-a Aaron jetlam bilkol monga, achate jetlam bilkol monga, akhut jetlamu khutpi chung, chule akeng jetlamu kengpi chunga chun nanuding, chule athisan chu maicham kimvela nathe ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule maicham chunga um thisan le kinuding thao chu nalah-a, Aaron chung, avon chung, achate chung, aumpi achate von chunga nathekhum ding; chuteng amajong, avonjong, achate jong, chule aumpi achate von jong chu thengding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangman Kelngoichal thao le ameithao, asunga kai athaoho, ala kimvela athao le akalteni tom athao, chule alengkou jetlama chu nalah ding ahi; ajehchu kelngoichal chu ganlhaina dia kipesa ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule Pakai angsunga um changlhah lum khat, thaova kikang changlhah khat, pocha sunga kon cholsolou changlhah kikang peh khat nalah ding:
  </para>
  <para style="p">
    <verse number="24" style="v" />Aaron le achate khutna aboncha nakoiding; chule Pakai angsunga jap thilto-a dinga najap ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule hichu nangman amaho khutna kona chu nalah-a, Pakai angsunga gimnamtui tah hidinga maicham chunga chu nago ding ahi: hichu Pakaiya dinga meija kisem thilto ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Aaron'in kipehthenga atodohsa kelngoi om chu nalah-a, Pakai angsunga jap thilto-a dinga najap ding ahi: chule hiche chu nang chan hiding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Aaron'a ding le achate-a dinga kithensona kelngoija kona chu jap thilto a-om le, thilto adah bul chu nathenso ding; hichu jap thilto le dop thilto ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichu Israel chate-a kona tonsot chondan dinga Aaron le achapate chan hiding ahi. Ajehchu dop thilto ahin: chule hichu Israel chaten Pakaiya dinga adop thiltou, achamna thiltou ganlhaina-a kona dop thilto dingu chu ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule hichea chu thao akinu uva chule akipehtheng nadinguva, Aaron vontheng hochu ama nungteng achate-a hiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule acha ama khela thempu-a pangpa chun muntheng mun'a natong dinga houkhom na houbuh-a mun'a chu ahung tengleh, vonho chu nisagi akivon ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule kipeh thengna kelngoi chu nangin nalah-a, chule apheho chu munthenga chu nahon ding ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Aaron le achapaten kelngoi sa chu pocha sunga kikoi changlhah chutoh, houbuhho houbuh kot koma chu anehdiu ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule amahon longlhenna kibolho chu akipehtheng nadiu le akisuhtheng nadiuva anehdiu: amavang thiltheng ahijeh-a, gamdang mi vang anehsah loudiu ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ijemtia kipeh thengna saphe le changlhah chu jingkah geija aval aumle, nangman hicheho chu meija nahalvam ding ahi: ajehchu atheng ahi jeh-a nehlou ding ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule keiman kathupeh banga nangman Aaron le achapate chunga nabol ding ahi: nisagi sung amaho dinga kipeh thengna nabolpeh ding ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule nangnam niseh le longlhen na-a dinga chonset thilto-a bongchal khat natoding: chule nangman hiche-a dinga chu longlhena naboljou tengle maicham chu nasop thengding; chule suhthengna dinga thao nanu ding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangman ni sagi sunga maichama dinga longlhenna nabola chule nasuhtheng ding; chutengle maicham thengchung nung hiding ahitai: ipi hijongle maicham tongkha chanchu thengjeng ding ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tun maichama natoding chu hiche hi ahi: kum khat lhingbep kelngoi ni niseh-a nato ding ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kelngoi khat chu jingkah lamleh natoding; chule kelngoi dang khat chu nilhah lamle natoding ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chule kelngoi khat dinga chu changbong neljet ephah hopsom-a hopkhat le thao kihehdoh hin khat hopli hopkhat hiding; chule don thilto-a dinga lengpitwi hin hopli-a hopkhat hiding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule kelngoi khat jopa chu nilhah lamle natoding, chule jingkah-a anneh thilto kitoh bang le don thilto kitoh banga Pakaiya dinga meija kisem thilto, gimnamtui tah hidinga nato ding ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hiche hi nangma kihoupi dinga kakimuto pina ding mun Pakai angsunga houkhom ho houbuh kotphunga nakhang khanguva dinga tanglouva govam thilto kiboljing chu hiding ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chule hiche mun'a chu Israel chatetoh kakimuto ding, chule houbuh chu kaloupi na-a suhthenga umding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule keiman houkhom ho houbuh le maicham chu kasuhtheng ding: chujongle Aaron le achapate chu thempu natohna mun'a keima lhacha natong dinga kasuhtheng ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule keima Israel chate lah-a kachena, chule a-Pathen'u kahiding ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chule amahon amaho lah-a kachen theina dinga, Egypt gama kona amaho hinpui dohpa, Pakai a-Pathen'u kahi ahet dingu ahi: keima Pakai a-Pathen'u chu kahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule nangman gimnamtui halna maicham nasem ding: hichu nangman thinggi thinga nasemding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichu adung tongkhat chule avai tong khat hiding; aningli hiding, chule atun tongni hiding, akijong hitobangma chu sangding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule nangman achungvum, avel pumpi-a, chule akiho chu sana-a natomding; chule nangman akimvel chu sana lallukhuh-a nasemding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule nangman sana chaokol ni lallukhuh lim noija chun nasemding, aningtenia jong, apangtenia jong, chule hicheho chu amoljolho kithilna hiding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nangman amoljolho chu thinggi thinga nasema, sana-a nalonkhum ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule nangman hichu kakimutopi nading mun, hettohsahna thingkhong kom, hepi touna maija, hiche pondal maija chu nakoiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Aaron'in hikoma chu jingkah sehleh gimnamtui ahalding; thaomei avahjou tengle, achunga gimnamtui ahalding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Aaron'in nilhah lama thaomei avahteng le gimnamtui chu ahalding, nakhang lhumkei uva Pakai masanga gimnamtui kihal hiding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangman hiche chunga chu gimnamtui chomdang khat nahal lou ding, govam thilto, anneh thilto jong nato louding, chule achunga don thilto jong nasunlhah louding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule longlhena chonset thilto-a chu Aaron'in kumkhat le saki chunga chu longlhenna khatvei abolding; akhang akhanga chu kumkhatna khatvei hiche chunga chu longlhenna abolding ahi: hichu Pakaiya dinga atheng chungnung ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangman Israel chate chu ajatnu hetna dinga aminu nasim tengle, nangman nasim tengu le alah uva hise aumlouna dinga; ajatnu nasim dungjuija amitakipmin amading cheh-a Pakai henga ahinna man dingu apeh cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Apeh dingu chu hichehi ahi, akisim sahho lah-a lutding jouse chun muntheng shekel dungjuija shekel kehkhat cheh apehdiu ahi: (shekel khat chu gerah somni ahi:) Shekel keh chu Pakaiya thilto hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Akisim saho lah-a lutding jouse, kum somni apat chunglang sechun Pakaiya dinga thilto apeh cheh dingu ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nahinna longlhenna dinga Pakai koma thilto abol tengule, ahaovin jong shekel kehval apehlou ding, chule avaijin jong shekel keh lhinglou apehlou ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangman Israelte longlhenna sum chu nalahding, hichu houkhomna houbuh natohna-a naman ding ahi; hichu nahinnao longlhenna bolna dinga, Pakai angsung Israel chatea dinga melchihna hiding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangman kisilnading sum-enga kisem, akeng jongchu sum-eng hiding, twidol khat nasem ding ahi: chule hichu houkhom ho houbuh le maicham kah-a nakoija, chule asunga twi nakoi ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ajehchu hichea chu Aaron le achapaten akhut akeng akisilngim ji dingu ahi:
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaho mipi houkhom na houbuh sunga alut tengule, ahiloule Pakaiya dinga meija kisem thilto hal dinga maichama ahung tengule; athilouna dinguva chu akhut akeng akisildiu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitia chu athi louna dinguva akhut akengu akisildiu: chule hichu akhang khanguva a-itih-a dinga ama le achate-a dinga tonsot chondan hijing ding ahitai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chukalvalin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangman gimnamtui loupiho, myrrh thengtah-a kisem shekel janga, chule thingthal namtui tah-a kisem shekel jani leh somnga, chule kolchu lhum shekel jani le somnga jong,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule munthenga shekel dungjuijin halnamtui shekel janga, chule olive thao hin khat nahenga lan.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule nangman hicheho-a chu lou sem themho sem banga thaotheng nasem ding; hichu kinuding thao theng hiding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule nangman hichea chu houkhom ho houbuh le hettohsahna thingkhong chu thao nanu ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule dokhang le akong le bel jouse, athaomei khomle avahna lhengho, chule gimnamtui halna maicham,
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule govam thiltona maicham le akong le bel jouse, chule sum-eng twidol le akhomjong hiche thao chu nanu ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule theng chungnung ahina dinguva nangman nasuhtheng ding; chule hicheho atongkha jouse atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule amaho thempu mun'a kalhacha na atoh theina dinguva, Aaron le achapate jong chu thao nanu-a nasuh theng ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule nangman Israel chate koma hitia naseiding ahi, Hichehi nakhang khanguva keima-a dinga kinu ding thao theng ahitai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichehi mihem tahsaphe chunga nasunlhah loudiu, ahiloule hitobanga kihal thao tobang hi adang jong nasemlou dingu ahi: atheng ahin, nangho-a dinga atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Koi hijongle hiche tobanga kihal thao sema, ahiloule hetlou mi chunga sunglha-a aumleh, amachu amite lah-a kona kipaidoh ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule Pakaiyin Mosi henga aseijin, Nangman gimnamtui ho, thingnai, ngavun namtui, ankam namtui; hicheho tohin bego thengtah agih danu kibang chetnin lan.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule nangman lou semhon phatah-a asem bangun, phatechan ngimsel le thengselin gimnamtui semin.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule nangman phabep chu navoh bongselin lang, nangma kakimutopi nading mun, houkhom ho houbuh sunga hettohsahna masanga chun koijin: hichu nangma dinga theng chungnung hiding ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule hiche gimnamtui nasem banga chu, nangman nangma-a dinga hitobanga kihal gimnamtui nasem louding ahi: hichu nangma-a dinga Pakaiya atheng ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Koi hijongleh manchah dinga hitobang thao chu asema aumle, amite lah-a kona paidoh-a umding ahi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ven Keiman Judah phunga kon Uri chapa, Hur chapa, Bezalel chu aminin kakouve;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amachu chihna-in, hetna-in, lungthimin, chule tohna dan jouse-a Pathen lhagaova kadimsah-in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Khut them natoh ho hichu sana, dangka, chule sum-eng,
  </para>
  <para style="p">
    <verse number="5" style="v" />Song tanboh le settoh, thingpeh vutoh, chule khut them natoh jouse tongdingin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule ven, Dan phunga kon Ahisamach chapa Aholiab chu ahenga kapetai. Chule keiman nangma kapeh thupeh jouse chu amahon aboltheina dingun miching jouse lungsunga chihna kakoipehtan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Houkhom ho houbuh le hettohsahna thingkhong, chule hiche chunga um hepi touna le houbuh manchah jouse chu,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule dokhang le amanchah jouse, thaomei khom tuna theng le amanchah jouse, chule gimnamtui halna maicham,
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule govam thiltona maicham le amanchah jouse, twidol le akeng,
  </para>
  <para style="p">
    <verse number="10" style="v" />Lhacha natohna ponho, Aaron thempu von thengho, thempuho natohna mun'a akivondiu achate von,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nuding thao le munthenga dinga gimnamtui: hicheho jouse hi keiman thu kapeh jouse dungjuija amahon aboldingu ahi, ati.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Pakaiyin Mosi henga aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangman Israel chate jah-a jong hitihin seijin, Tahbeh-a nanghon kacholngah nikhoho nanit dingu ahi: ajehchu nanghon keimahi nasutheng uva Pakai kahi ti nahettheina dinguva; hichu nakhangu lhumkeija keima le nangho kikah-a melchihna hiding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh-a chu nanghon Sabbath nanitdiu ahi; ajehchu hichu nangho dinga atheng ahi. Koi hijongleh asuboh chanchu kithat ding ahi: ajehchu chuche nikho-a natonga tapou chu, hiche hinna chu amite lah-a kona paidoh-a umding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nigup sunga na natohdiu ahin, ni sagi ni vang chu choldo nadinga cholngahni, Pakaiya dinga atheng ahi: koi hijongle cholngah nikho-a natoh kiti tapou tonga chu thatei ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hijeh-a chu Israel chaten kumkho-a kitepna hidinga akhang khanguva cholngah nikho chu anit theina dinguva, cholngahni chu anit dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichu a-itih-a dinga keima le Israelte kikah-a melchihna hiding ahi: ajehchu nigup sungin Pakaiyin van le lei asemin, chule nisagi nin akicholdon, akitha-olin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin Sinai molsang chunga akihoupi jou phatchun, aman Mosi henga hettohsahna songpheng ni, Pathen khutna kisun songpheng chu apetan ahi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin mipi chun Mosi molsanga kona ahung kumlhah vahlou amu phatnun, mipi chu Aaron koma ahung kikhom khomun, ahenga, Kipatdoh-in, keiho masanga che dingin pathenho neisem peh-un: ajehchu Egypt gama kona eihin puidoh uva hiche Mosi hi iti hitam kahe tapouve, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Aaron'in amaho jah-a, Nanghon na inneipi teo, nachapa teo, nachanu teo sana bilba chu abonchan ladoh-un lang, hicheho chu kahenga hinchoijun, ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin mipi jouse chun abiluva um sana bilba jouse chu aladoh-un, Aaron henga ahinchoi taove.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman amaho khutna konchun hicheho chu alan, asemna manchah mangin asemin, bongnou lim khat asemin ahi. Chuin amahon, Vo Israel, hichehi Egypt gama kona nahin puidoh uva na pathen hou chu hihen ati.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Aaron'in hichu amuphatnin, amasanga maicham khat asemin; chule Aaron'in, Jing nikho khu Pakaiya dinga kut ahi, tin aphongdoh tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin amaho ajingin matah-in athoudoh-un, govam thilto atoh-un, chule chamna thilto ahinchoijun; chuin mipi ho chu adon dingle ane dingin atouvun, chule alam dingin akipat doh-un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Pakaiyin Mosi jah-a, Chen, kumlhan: ajehchu Egypt gama kona nahin puidoh namite khu akisuboh gam taovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaho gangtah-in keiman kathupeh-a konchun lamchom beh-a akihei taovin: amahon bongnou kilhajol asemun, hichu ahouvun, chule ahenga kilhaina abolun, Vo Israel, hichehi Egypt gama kona nahin puidoh uva na pathen hou chu hihen atiuvin ahi, ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Pakaiyin Mosi jah-a, Hiche miho hi ken kamutan, chule ven, amaho hi milouchal tah te ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hijeh chun tun achunguva kalunghan na asoudoh-a, amaho kasuh manghel nadingin, keima neichang lhan: chule keiman nanga kona nam lentah khat kasem ding ahi, ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Mosi Pakai a-Pathen henga ataovin, Pakai, thilboltheina nasatah le khut thahat tah-a Egypt gama kona nahin puidoh namite chunga ibola nalunghanna soudoh jenga ham?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ipi dinga Egypt miten, Molsang ho-a thagam dingle, leiset chunga kona suhmang dinga aman dihlou tah-a amaho khu apuidoh ahi, ati dingu ham? Nalunghan na nasatah-a konin kile heijinlang, namite douna-a thil gilou na ngaitona-a konhin nalung hinheijin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule keiman nachilhah kapunsah-a, van'a ahsijat kaphahsah ding, chule keiman kasei hiche gam jouse hi nachilhahte kapeh ding, amahon atonsotna alo dingu ahi tia Abraham, Isaac, chule Jacob henga nangma le nangma nana kihahsela nasei chu geldoh-in, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin Pakaiyin amite chunga thilphalou bol ding angaitona-a konin alung aheitan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin Mosi akiheijin, molsanga konchun achesuh-in, hettohsahna songpheng teni chu akhutna achoijin ahi. Songpheng chu ani lang to-a kisun ahin; langkhat le akileh lang panga chu akisuna ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule songpheng chu Pathen khutsoh ahin, akisun chu Pathen khutsut, songpheng chunga chu kisuna ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Joshua'n mipi awgin thong chu ajah phatnin, Mosi jah-a, Gebuh-a gal husa aume, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahin aman, Galjona-a kisam awgin ahipon, chule gal lelna-a kisam awgin jong ahipoi, amavang keiman kajah hi la kisa awgin ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ahitin ahi, ama gebuh ahungnai phatnin, bongnou lim kisem le alamu chu amutai. Chuin Mosi alunghana asoudoh tan, akhutna songpheng ni chu aseplhan, chule mol bula chun asukehtan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman asemu bongnou lim chu alan, meija agouvin, chule asubong selin, twi chunga athen, Israel chate chu adonsah-in ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Mosi'n Aaron jah-a, Mipi hohin nachunga ipi aboluva, nangman hitobang chonset nasatah hi achunguva nalhunsah ham? ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin Aaron'in, Ka pakai lunghanna hi soudoh hih hen: nangman hiche mite hi thilphalou bolnom mi ahiu nahen ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu amahon kahenga, Keiho masanga che dingin pathenho neisem peh-un: ajehchu Egypt gama kona eihin puidoh uva hiche Mosi hi iti hitam kihe tapouve, atiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichun keiman amaho koma, Koi hijongle sana neijousen hinsut lhaohen, kati. Hitichun amahon keima eipeovin: chule keiman hichu meija kalelut le hiche bongnou hi hungsoh doh-a ahi, ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Mosi'n mipi ho chu sagoh keuva aumu amu phatnin; (ajehchu Aaron'in amaho chu agalmite lah-a ajachat na dinguva von beija akoi ahi.)
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichun Mosi gebuh kotpi phunga adingin, Pakai lama panga umem? amaho chu kahenga hunghen, ati. Chuin Levi chapate jouse chu ahenga akikhom khom taovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman ajah uva, Israel Pakai Pathen'in hitin ati, Amitakipmin apanga chemjam kikocheh henlang, gebuh sung jouse-a kotpi khatna konin kotpi khatna lutle potleu hen, chule amitakipmin asopi, amitakipmin akivop piho, chule amitakipmin aheng akom that hen, tin aseije, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin Levi chapate chun Mosi thu seibangin abol taovin: hiche nikho-a chun mi sangthum tobang athin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hitichun Mosi'n, Tunia hi aman nangho phatthei naboh theina dingun, tunikho hin nangho amitakip achapa chungle asopipa chunga Pakaiya dingin kithensouvin ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin ajingin ahitin ahi, Mosi'n mipi ho jah-a chun, Nangho nasatah-in nachonse taove: chule tu-a hi keima Pakai henga kache touva; ahitheile nachonset nao longlhenna kagabol ding ahi, ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Mosi Pakai henglama ahung kilen, ahenga, Ohe, hiche miho hin chonset nasatah abol taovin, chule sana-in bongnou pathenho akisem taove.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijongle tun, nangman achonsetnao nangaidam dinga ahile -; chule nangaidam louding ahile, katao ahi, nangman nasutsa lekhabua konin kamin ladohtan, ati.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin Pakaiyin Mosi jah-a, Koi hijongle keima douna-a chonse chan chu, kalekhabua kona kalahdoh ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hijeh chun tun chen, mipi ho chu keiman nahenga kaseipehna mun'a chun puitan: ven, kavantil namasanga cheding ahi: hijeng jongle keiman kavil nikho leh achunguva chonset naho chu kavil ding ahi, ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Aaron'in asempeh-u bongnou chunga athilbol jeh-u chun, Pakaiyin mipi ho chu hise-in agot tan ahi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi jah-a, Kipatdoh-in, keiman Abraham, Isaac, chule Jacob henga kana kihahsela, Keiman nachilhahte kapeh ding ahi, tia kaseina gama chun, nangma le Egypt gama kona nahin puidoh mipi ho chu hikoma konhin chetou taovin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule keiman namasanguva vantil kasolding; chule keiman Canaan mite, Amor mite, Hit mite, Perizz mite, Hiv mite, chule Jebus mite chu kadeldoh ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khoiju le bongnoi lona gama chun chetouvun; keiman nalah uva nangho to kachetou louding ahi; ajehchu nangho milouchal tahte nahiu ahi: achuti loule lampia sumangpa getnung kate, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule mipi chun hitobang thugilou ajah phatnun, amaho alunghemun; koimacha akijema aum tapouvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajehchu Pakaiyin Mosi jah-a, Israel chateho koma hitihin seijin, Nangho milouchal te nahiuve: chomlouva nalahtah uva kahungtouva, kasuhmang ding nahiuve. Hijeh chun tun nachung uva ipi kabolding kahet theina dingin, nakijepnao jouse chu nangho-a konin sutlhaovin, ati ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Israel chate ho chun Horeb molsanga chun akijepnao jouseu asutlhagam taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Mosi'n houbuh chu alan, gebuh pam lam gebuh-a kona gam latah in asongin; hichu houkhom ho houbuh tin aminvo tan ahi. Chuin ahung hitin ahi, amitakip Pakai holchan chu gebuh pama um houkhom ho houbuh-a chun acheuvin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin ahitin ahi, Mosi houbuh-a dinga ahungdoh chun, mipi chu akipat doh-un, amitakip amaho gena ponbuh kotbul cheh-a adingun, Mosi chu houbuh-a alutkahsen avetaovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin ahitin ahi, Mosi houbuh-a alut tolhonin, meilom khompi khat ahung kumlhan, houbuh kotphunga chun ading denin; chuin Pakai chu Mosi to akihoulim lhontan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule mipi chun houbuh kotphunga meilom khompi akitun chu amuvin ahi. Chuin mijouse akipat doh-un, amaho ponbuh kotpi cheh-a konchun Pakai chu ahou taovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin Pakaiyin Mosi chu mikhatnin agolpa akihoupi bangin kimaiton akihoupin ahi. Chuin ama gebuh mun lama chun ahungtai: ahinla asohpa Nun chapa Joshua, golhangpa vang chu houbuh-a konin ahung doh tapon ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin Mosi'n Pakai henga, Ven nangman kahenga, Hiche mipi ho hinpui touvin natin, chule kakilhonpi dinga koi neisolpeh got ham neihetsah pon; ahinla nangman, Keiman nangma naminin kahei, chule kamitmu-a lungsetna nachange, natin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun tun katao ahi, namitmu-a lungsetna kachana ahile, nangma kahetna ding le nangma mitmu-a lungsetna kachan nadingin nalampi neihilin; chule hiche nam mite hi namite ahi tin gelin, ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman, kaumpinan nalhonpiu vintin, chule cholngahna kapeh ding nahiuve, ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman ajah-a aseijin, Na-umpinan eilhonpi louleh hia konhin neipuitou datao vin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ajehchu nangman neilhonpi lou uva ahile keima le namitehin namitmu-a lungsetna kachang-uve tihi iti kahetthei ding ham? Chutile keiho, keima le namite hi leiset chunga um miho-a kona sepkhena kaum dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin Pakaiyin Mosi jah-a, Nangman nasei thilho jonghi kabol ding ahi: ajehchu kamitmun lungsetna nachangin, chule keiman nangma naminin kahen ahi, ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule aman, Nahenga katao ahi, naloupi na chu neimusah-in, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin aman, Keiman kaphatna jouse namasanga kichesah ding, na-angsunga Pakai minchu kaphonjal ding ahi. Chule keiman kalungset ding chu kalungsetna, chule hepina kamusah ding pa chu hepina kamusah ding ahi, ati.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman, Nangman kamai namuthei louding ahi: ajehchu eimu-a chu koima ahinga umlou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chuin Pakaiyin, Ven, kakoma mun khat aume, chule nangma songpi chunga nadin ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule hung hiti ding ahi, kaloupinan nahin jotpa tengle, nangma songpi khikeh kah khatna kakoiding, nangma kapal galkai kahse-a kakhutna kakhuding:
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule keiman kakhut kalah doh-a, nangman kanunglam namu ding ahi: kamai vang namu louding ahi, ati.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Pakaiyin Mosi henga, Nangman amasa bang bang chun songpheng ni khengin; chule nangman nasuhchip songpheng chunga kisun thu tobang bang chu hiche songpheng teni chunga chu kasut ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuleh jingkah leh kigonlang Sinai molsanga hungin, chule molsang vuma khun kakoma hung kilah-in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule koimacha nangma toh hunglhon tou louding, chule molsang pumpi-a jong koimacha kimulou ding; chule kelngoi hon ho le ganchahon jong hiche molsang panga chu an nanehsah lou dingu ahi, ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman amasa bangin songpheng ni akhengin ahi. Chuin Mosi jingpitah-in athouvin, Pakaiyin athupeh bangin Sinai molsanga chun akaltouvin, songpheng ni chu akhutna achoijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Pakai chu meibol lah-a ahung kumlhah, amatoh chua ading khomin, chule Pakai minchu aphongjal tan ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Pakaiyin amasang ahin jotpan, Pakai, Pakai Pathen, lungset le hepina-a dim, chule phatna le thutah-a bulhingset,
  </para>
  <para style="p">
    <verse number="7" style="v" />Sang tamtah chunga hepina nei, khangilouna, suhkhelna le chonsete ngaidam, themona mohseh-a subeilou; pate khangit louna chate chung le achate chateho chunga khangthum khangli changeija viljing, tin aphongjalin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin Mosi mangang tah-in tollah akunin, ama chu ahoutan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin aman, Vo Pakai, tu-a hi namitmu-a lungsetna kachana ahile, nahenga katao ahi, ka pakai chu keihotoh lhonkhom hen; ajehchu milouchal tahte ahiuve; chule kakhangit lounao le kachonsetnao ngaidamin lang, nagou lodin neilaovin, ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman, Ven, keiman kitepna kaseme: keima namite jouse masanga leiset chung jouse-a koima nam lah-a jong ana kibol khalou thil kidang kabol ding: chule naumna namite jousen Pakai natoh chu amudingu ahi. Ajehchu nangtoh katoh ding chu tijat umtah thil hiding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tunia nahenga kathupeh hi nitnin: ven, keiman Amor mite, Canaan mite, Hit mite, Perizz mite, Hiv mite chule Jebus mite chu nangho masanga kadelmang ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kichih theijin, achutiloule nachena gama miho toh kitepna semun natin, ajole hichu nalah uva thang hung hikha ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amavang nanghon amaichamu nasuh mangdiu, amilim hou navoh bohdiu, chule adoikhom hou chu naphuh lhuh diu ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule pathen dangho nahou loudiu ahi: ajehchu Pakai amin thangthip kitipa chu, thangthip Pathen ahi:
  </para>
  <para style="p">
    <verse number="15" style="v" />Achuti loule agama cheng hotoh kitepna neijin natin, amahon a-pathenhou toh jonthanhoi aboluva, a-pathenhou henga ganlhaina aboldingu, chule khat touvin nahin kou-a, aganlhaina sachu naganeh khah dingu;
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule nangman nachapate dinga achanu teo nalah-a, chule achanuteu chu a-pathenhou henga jonthanhoi boldinga chediu, chuteng nachapateo jong a-pathenhou henga ajonthanhoi sah dingu ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangho-a dinga semthu pathen nakisem lou dingu ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nanghon cholsolou changlhah kut nabol jing dingu ahi. Abib lha phat sunga keiman kathupeh dungjuija, nisagi cholsolou changlhah naneh dingu ahi: ajehchu nangho Egypt gama kona Abib lha-a nahung doh-u ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Naobu hinphukeh tapou chu keija ahin; chule gancha lah-a apeng masapen jouse, bong hihen, kelngoi hijongleh achal jouse chu keija ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahivangin sangan apeng masapen jouse chu kelngoija nalhatdoh dingu ahi: ijemtia nalhatdoh lou dinga ahileh, angong naheboh dingu ahi. Nachateo asoh masa jouse chu nalhatdoh dingu ahi. Chule koimacha akhutgoh-a ka-angsunga kilah louding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nigup sunga na natoh ding ahin, amavang nisagi chan nileh nacholdo ding: loukai laile chang-at laija jong nacholdo dingu ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule nanghon suhlou chang gamasapen ahunglhun tengle hapta kut nanit dingu, chule kum kichai tengle lhoga khoptup kut nanit dingu ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nachapateo jouse chu kumkhat sunga thumvei Pakai Pathen, Israel Pathen masanga hungkilah chehdiu ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ajehchu namasanga kona namtinho chu kadeldoh ding, nagamgiho kakehlet ding ahi. Chuche kumkhat sunga Pakai na-Pathen angsunga kilah dinga thumvei nachetou kah-a chu, koimachan jong nagam avetlel louding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangman keima dinga ganlhaina kibol thisan chu chol toh natotha louhel ding; chule kalchuh kut ganlhaina ho jong chu jingkah geija nakoi louding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nagam ga masaho lah-a aga masapen chu Pakai na-Pathen in'a nahinchoi ding ahi. Nangman kelnou sa chu api noitwija nahonlou ding ahi, ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin Pakaiyin Mosi henga, Nangman hiche thuho hi sunin: ajehchu hiche thuho banga hi nangma le Israelte toh kitepna kasem ahi, ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chuin ama chua chun Pakai toh nisomli le jan somli aumin; aman changlhah jong anepon twi jong adonpon ahi. Chule aman songpheng chunga chun kitepna thu, thupeh som chu asuntan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chuin ahitin ahi, Mosi Sinai molsang kona kitepna songpheng teni akhutna ahinchoija ahungsuh phatnin, molsang chunga kona ahung kumsuh chun, amatoh akihoupetna amai vah chu Mosi'n ahepon ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Aaron le Israel chate jousen Mosi amuphatnuvin, veuvin, amaiso chu avah-in, amahon ama kom naiding akichauvin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin Mosi'n amaho akouvin ahile, Aaron le mipi kikhomho lah-a lamkaiho jouse chu ahenga ahung kinungleu vin; Mosi'n amaho akihoupitan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuchejouvin Israel chate jouse chu ahung naijun: chuin aman Sinai molsanga Pakaiyin asei jouse chu amaho koma thupeh-in apetan ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule Mosi'n athusei ajo kahsen, amai chu maikhu akhun ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahivangin Mosi Pakai kihoupi dinga a-angsunga achelut tengle ahungdoh kit kahsen amai ahohdohjin ahi. Chule ahungdohjin ama thu kipe chu Israel chate aseipeh jin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule Israel chate chun Mosi maiso chu amu phat uvin, Mosi maiso chu avah-in ahi: chuin Mosi amatoh kihou dinga alutkit kahsen, amaija maikhu akhukit tan ahi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin Mosi'n Israel chate houkhom ho jouse akoukhomin, ajah uva, Nanghon nabol dinguva Pakaiyin nathupeh-u thuho chu hicheho hi ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nigup sunga na natoh dingu ahin, ni sagini vang chu nangho dinga nitheng ni hiding, Pakai dinga kicholdona cholngahna ni hiding ahi. Chuche ni-a natong chanchu thading ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangho nachennao gam pumpiuva cholngahni le mei nati louhel dingu ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Mosi'n Israel chate mipi houkhom ho jouse jah-a hitin ati, Hichehi Pakai thupeh ahi,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanghon nalah uva konin Pakai henga toding thilpeh khat choicheh-un: koi hijongleh alungsunga penom channin Pakai henga thilpeh hinchoi hen; sana, dangka, sum-eng,
  </para>
  <para style="p">
    <verse number="6" style="v" />Pon dum, ponsandup, ponsanthip, ponnem, chule kelmul,
  </para>
  <para style="p">
    <verse number="7" style="v" />Kelngoichal vun kidesan, satuilut vun, chule thinggi thing,
  </para>
  <para style="p">
    <verse number="8" style="v" />Vahding thaotwi, nuding thao namtui, chule gimnamtui,
  </para>
  <para style="p">
    <verse number="9" style="v" />Khisonggel ho, boitong sangkhol le ompho-a behding songho.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule nalah uva mi lungching chengse hunguntin, chule Pakai thupeh jouse hi aboldingu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Houbuh le achungkhu chule athingpehho, abanggol ho, akhom ho, achechah naho,
  </para>
  <para style="p">
    <verse number="12" style="v" />Thingkhong, mol lhon ho, hepi tounamun, chule achung khuna pon,
  </para>
  <para style="p">
    <verse number="13" style="v" />Dokhang le mol lhon ho, akong ho jouse, chule vetsahna changlhah,
  </para>
  <para style="p">
    <verse number="14" style="v" />Avah dinga khoilu thaomei jong, athil le lo, athaomeiho, vahding thaotwi ho toh,
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule gimnamtui halna maicham mol lhonho, akinu ding thao, gimnamtui ho, chule houbuh lutna kotna kikhai ding pondal,
  </para>
  <para style="p">
    <verse number="16" style="v" />Govam thiltona maicham, asum-eng ho, amol lhon ho, chule aum le abelho jouse le twiluina kong le akeng,
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahong sunga pondal kikhainaho le, akhomho akibutona ho, ahong kotpi pondal ho,
  </para>
  <para style="p">
    <verse number="18" style="v" />Houbuh kilnaho, ahong kilna, chule akhaoho,
  </para>
  <para style="p">
    <verse number="19" style="v" />Munthenga kinbolna ding, kinbolna ponho, thempu dinga vontheng ho le achapate vonho, thempu natohna mun'a kinbol nading, tin aseijin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Israel chate houkhom ho jouse chu Mosi angsunga konin apotdoh taove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule alung kisuhthou le alhagaovin peh nomna apehchu ahungun, akinbolna ngaicha ding jouse le von thengho jouse din, mipi houkhom ho houbuh natohna-a Pakaiya thilto chu ahinchoijun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin pasal ahin numei ahin alungsunga peh nomna nei jouse ahunguvin, chaojangho, bilbaho, khutjemho, khiho, chule sana kijepnaho jouse chu ahinchoijun: thilpeh pejouse chun Pakai henga thilto dingin sana atoh uvin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin amijouse chun, koihile pon dum, ponsandup, ponsanthip, tupat ponnem, kelchavun, kelngoichal vun san theng, satuilut vunho neijousen ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amitakip dangka le sum-eng thilto pechan chun Pakaiya thilpeh ahin choijun: chule amitakip thinggi thing neijouse chun lhacha kinbolna din ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule numei lungching jouse chun akhutnuva akheh-un pon dum, ponsandup, ponsanthip, tupat ponnem hochu ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule chihna-a alungthimu kisuthou numei ho chun kelcha mul akheh-un ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule vaipoho chun khi songgel hole songdang dangho chu boitong sangkhol le ompho-a beh dingin ahin choijun;
  </para>
  <para style="p">
    <verse number="28" style="v" />Lou namtui, vah-a ding thao, kinuding thao, chule gimnamtuija ding ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israel chaten Pakai henga lungcham thilto hochu ahinchoijun; numei ahin pasal ahin, alungin peh nomna aneisah jouse chun Pakaiyin Mosi khutna boldinga athupeh jouse bolna dingin ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chuin Mosi'n Israel chate koma, Veuvin, Pakaiyin Judah phunga, Hur chapa, Uri chapa Belzalel aminin akouvin;
  </para>
  <para style="p">
    <verse number="31" style="v" />Chuin aman amachu chihna-in, hethemna-in, lungthim themna-in, chule natoh dan jouse-a dingin Pathen lhagaovin adimsah-in;
  </para>
  <para style="p">
    <verse number="32" style="v" />Sana, dangka, chule sum-eng natoh kidangho gongtoh dingin,
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule songho at-tan dingdan, asettoh dingdan, thing-at dan, chule khutthem natoh jouse-a dingin Pathen lhagaovin adipmin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman ama le Dan phungmi Ahisamach chapa Aholiab chu mihil thei ahilhona dingin alungsung lhona chihna akhumpeh tan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman amanichu natohna jouse tohtheina, khutthem nale natoh themnalna, thil jih themna, pon dum, ponsandup, ponsanthip chule tupat ponnem jepthemna, ponkhom themna, mihemin abolthei jouse boltheina le, khutthem jouse thepna-in alungsunghon chihnan adipmin ahi, ati.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichun Pakaiyin athupeh dungjuijin, Pakaiyin muntheng natohna-a natoh dingdan jouse hetthemna dinga chihna le hetna apeh miching jouse, chule Belzalel le Aholiab'in natoh chu apan taovin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Mosi'n Belzalel le Aholiab, chule Pakaiyin alungthim uva chihna apeh michingho, chule natohna-a hunga na hungtong dinga alungthim kisuthou chan chu akouvin:
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amahon muntheng sahna dingle asunga natoh thilbol na-a dinga Israel chaten ahin tokhom houchu Mosi khutna konin alauvin ahi. Chule amahon jingkah seh le ama henga lungcham thilpeh ahin choijing nalaijun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin munthenga natohho jouse tonga miching jouse amitakip anatohna-a konin ahungun;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin amahon Mosi henga, Miho hin natohna-a dinga Pakai thupeh sanga tamjo ahinchoi taovin ahi, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Mosi'n thupeh apen, hichu amahon gebuh jouse, Nangho pasal hihen numei hijongle koimachan muntheng natohna-a dinga ima natobe lou dingu ahitai, tin aphongjal leuvin ahi. Hitichun mipi chu athilto naova konchun asutang taovin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajehchu athilnei houchu natohna dinga lhingset ahin, chule avalset ahitai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin alah uva milungching takip houbuh-a natong ho chun tupat pon hoile mantam tah-in ponjal som adum, asanthip le asandup asemun; khutthem tah-in Cherub ho pumin hiho chu asemun ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ponjal khatchu asao tong somni le get, ponjal khatchu avai tongli ahin, ponjal jouse chu akibangsoh-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin ponjal nga ho chu akhuimat nin, chule adang ponjal nga jong chu akhuimat nin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman ni kisuhmatna ageilom laija konchun ponjal khat geija chun adum ajolkhat abil hom asemin ahi. Hibang chun aman anina kisuhtona sunga chun adang ponjal pamnung pena chun abollin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman ponjal khatna chun abil somnga asemin, chule aman ani lhina ponjal patoh akisuhtona-a jong chun ponjal geilaijah abil somnga asemin, ponjal liho chu khatle khat akimatnin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin aman chechahna somnga sana-in asemin achechah sah-in ahi. Chule ponjal chu hiche achechahna mun'a chun akikolmat tan ahile hitichun houbuh khat asohtan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuin aman houbuh chunglama chun pon in dingin kelmullin ponjal asemin ahi. Aman ponjal somlekhat asemin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ponjal asaodan chu tong somthum ahin, chule aponjal aletdan chu tong li ahi, ponjal somlekhat chu akibangsoh-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin aman ponjal nga chu akhuimat nin, chule adang gup jong chu akhuimat nin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin aman ponjal kikilmatho mongpena chun abilhom somnga asemin chujongle ani lhina ponjal kikil monga jong chun abil hom somnga asemin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin aman khatseh ahitheina dingin chechahna somnga sum-eng in asemin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule aman pon-in khukhumna dingin kelngoivun kinusan asemin, chule achunga chun satuilut vun akhun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule aman houbuh-a din thinggi thingpeh asemin, atungin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thingpeh saodan chu tong som ahin, chule avai chu tong khatle akeh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thingpeh khat chun ako le abil kibangchet ni aneijin, hitobang chun aman houbuh thingpeh jouse chu asemin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule aman houbuh-a din thingpeh asemin; chule thingpeh somni chu noilam sanga noilam panga din aseme.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule aman hichu thingpeh somni noijachun dangka-a kisem kibutona somli asemin; akibuto naho ni-a ding chun thingpeh khat noija chun akibutona kohomni asemin; chule bulutna muh ni chu adang thingpeh-a bulutna muh ni ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule houbuh pang langkhat sahlang ninga chun thingpeh somni asemin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule dangka-a abil somli kisem achun akibutona ko ni chu thingpeh khat ding ahin, chule adang akibutona ko ni chu thingpeh adang ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule lhumlang sang houbuh panga chun aman thingpeh gup asemin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule aman thingpeh ni chu houbuh apang teni aning ni-a dingin asemin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule amaho chu anoija akimatnin, chule achung chu chaokollin akimatnin; hitichun aning jouse-a chun abollin ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule hichun thingpeh get asemin, chule akibuto naho chu dangka-a kisem akisuhto naho somlegup ahi, thingpeh khat khat noija chun akibutona ko ni ni aumin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule aman thinggi thingpeh in banggol ho asemin; houbuh pang lang khatna din thingpeh nga,
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule adang thingpeh banggol nga chu houbuh alangkhat nading ahin, chukit le adang thing banggol nga chu houbuh lhumlang sanga ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule aman akima che banggol jong abollin, hichun thingpeh jouse chu akima avut vangin among geijin aumin ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule thingpeh ho chu sanatwi jin aloijin, chule banggol jouse matchahna din sana chaokol akisemin, chule banggol ho chu sanatwi jin aloijin ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule aman ponjal hochu pondum, ponsandup, ponsanthip, chule tupat ponnemin asemin, thilbol kidang tah-in Cherubim limin ajemin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule hichea chun aman thinggi thingin khom li asemin, hicheho chu sana twijin aloijin; akoika ho chu sana-a kisem ahin, chule aman dangka-in akibutona ko li akoipeh-in ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule aman houbuh kotna din pondal adum, asandup, asanthip chule tupat ponnema kisem phatah-a kikhui akhaijin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule khom nga ho-a chun koika aumcheh-in, chule aman alupal jouse le agolho jouse sana twijun aloi jolin ahi. Ahivangin akibutona ko nga ho vang chu sum-enga kisem ahi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Belzalel'in thinggi thingin thingkhong chu asemin; adung tongni le akeh avai tong khatle akeh, chule atun tong khatle akeh ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman asung le apose chu sana thengselin aloijin; chujongle agei kimvel chu sana lallukhuh limin ajemin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule aman sana chaokol li akoijin, amaho chu aning li-a koiding ahi. Chaokol ni chu alangkhat na chule adang chaokol ni chu khatna akoijin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman thinggi thingin mol lhon asemin, chule sana twijin aloijin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman thingkhong chu aputna dingin thingkhong panga agollutnin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin aman sana thenga kisem hepi touna chu asemin; chule adung chu tong ni le akeh chule avai tong khat le akeh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin aman sana hal khatna kona kikheng Cherub ni hepi touna mong teni-a chun asemin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cherub khat chu among langkhatna, chule Cherub khat chu alang khat mongah hepi touna mong teni-a chun Cherubim asemin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Cherubim teni chun alha sangtah-in ajal lhonnin, chule alha teni chun hepi touna chu akhukhum lhonnin, amani akimaingat to lhonnin, hepi touna lamchu anga lhonnin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule aman thinggi thingin dokhang asemin, adung tong ni ahin, avai tongkhat, atun tong khat le akeh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin aman hichu sana thengin aloijin, chujongle avelchu sana lallukhuh limin ajemin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujongleh hiche chunga chun khutpheng tebep akol kimvel asemin, chule agei kimvel chu sana lallukhuh limin ajemin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule aman hiho ding chun sana thih chaokol li alhan, akeng liho umna aning li-a chun abupeh in ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Akimvela chun Dokhang putna mol lhon thilna ding chaokol ho chu aumin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin aman dokhang putna dingin thinggi thingin mol lhon asemin, hiche chu sana twijin aloijin ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule aman dokhang chunga kongle bel hochu asemin, akongho, asumkheho, asum lhengho, asinho abona sana thenga kisem ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule aman sana theng thaomei khom asemin, atopal khoilu thaomei khom chu asemin, alhongpi le abahho, alheng ho, abohdoh ho chule apah ho chu kibang cheh ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule abah gup chu asih-a konin ajamdoh-in, thaomei khom apang langkhat chun abah thum aneijin, chujongle apang lang khat chun abah thum aneijin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Alang khatna chun abo khat le apah khattoh almond limin khonthum aumin, chule aleng langkhatna abo khat le apah khattoh almond jih bangin alheng thum aumin, hitichun alhung lhonin, thaomei khom abah gup ajamdoh-in ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule thaomei khoma chun almond limin alheng lile abo chule apah ho aumin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amasa abah ni noija chun aboh khatma aumin, chule abanna ni noija aboh khatma aumin, chule athumna abah ni noima-a chun aboh khat ma aumkitnin, hicheho hi abah gup jamdoh dungjui ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abo hole abahho chu tikhat ahiuvin, hicheho jouse chu sana thenga kikheng ngen ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule aman thaomei sagi, achena manchah ho, meivah koina kongho jouse sana thengin asemin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiche hole kong le bel ho jouse semna dingchun sana thengsel talent khat amangin ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule aman thinggi thingin gimnamtui halna maicham asemin adung tong khat, avai tong khat ahin aningli kibangcheh tong ni ahin akiho jong akibangin ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chuin aman achung teni le akimvel ki hochu sanan aloijin; chule akimvel chu lallukhuh limin ajemin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuin aman aputna mol lhon thilna dingin apangteni chunga aning teni-a lallukhuh noija chun sana chaokol ni asemin ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule aman amol lhon jongchu thinggi thingin asemin, chule sana twijin aloijin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule aman gimnamtui thengsel jong halnam dingin asemin, thaosempa thilsem bangtah-in asemdohtan ahi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule aman thinggi thingin govam thiltona maicham chu asemin, adung tong nga, avai tong nga atun tong thum ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aning li-a aki asemin, akiho chu akibangin, achung sum-eng in aloijin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule aman maicham kongho, abelho, akheho, vutlonaho, meitina belho, kong dang jouse sum-eng in asemin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin aman maicham lailung tah-a asandan vetna noitah-a chun sum-enga kisem thihvang khat maicham ding chun asemin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin aman mol lhonho thilnading sum-eng thihvang mongli-a chun chaokol li asemin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule aman mol lhonho chu thinggi thingin asemin, sum-eng in alutnin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule aman thingpeh aputna din maicham sih-a chaokol ho-a chun agolho chu athilin alaihomin asemin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman houbuh maija mipi ahung kikhop tengleh numei ho dingin twikholna kong le akengho chu sum-eng val leh phatvetnin asemin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule aman lhang lama chun ahongsung asemin, hiche tupat ponnem tong jakhat-in hong chu akai kullin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Akhomho chu somni, akibutona koho jong somni asemin chule akhomho akoikahou le agolho chu sum-enga kisem ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sahlang sanga kikhailha ding chun tupat ponnem tong jakhat-in akisemuvin, akhom jong somni chule sum-enga kisem akibuto naho jong somni ahicheh in, chule akhomho akoikaho le agolho dangka-a kisem ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule lhumlang sanga akikhai ponchu tong somnga ahin, akhomle akibutona koho chu som cheh ahi, akhomho akoikaho le agolho chu dangka-a kisem ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule solama chu tong somnga ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Akotpi panga kikhai ponho chu tong somnga ahin, akhom thum ahin chule akibutona kothum ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ahongsung mun langkhat kotna ponjal chu tong somlenga akikhaijin chule akibutona ko-hole khomho chu thum thum ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahongsung kimvella kikhai pon jouse chu tupat kilhuh pona kisem cheh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule akhom kibutonaho jouse chu sum-eng in asemin, sutkhom bille agolho jouse dangkan asemin, amuhhal jouse chu dangkan aloijin ahi. Chule ahongsung sutkhom ho jouse chu dangkan akitomin ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule ahongsung kotpi-a kikhai pondal hochu akikhontho ahin, adum, asandup, asanthip chule tupat kilhuh pon ahin; chule adung tong somni, availam le asan tong nga ahin, hiho chu ahongsung mun'a pon kikhai ho toh kitoh ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule akhomho chu li ahin, asunga kisem butona koho chu li, akoika chu dangka-a kisem ahin, chule achungho jouse le agolho chu dangka-a kilonkhum ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule houbuh kilnaho jouse le ahongsung kimvel kikilna jouse chu sum-enga kisem ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiche hi houbuh thudol chu ahi, hettohsahna houbuh ngei jong chu Mosi thupeh dungjuija Aaron thempupa chapa Ithamar khutna chu Levi ho kinbolna dinga kisema ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule Pakaiyin Mosi koma athupeh jouse chu Juda phunga um, Hur chapa Uri chapa Bezalel'in abolsoh keijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule aman akilhonpi chu Dan phunga Ahisamach chapa Aholiab, song geithem natong khutthem chule pondum, ponsandup, ponsanthip chule tupat ponnem hoitah jempahthei ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Munthenga natohna-a dinga kisulut sana jouse, thilto sanaho geijin, munthenga kimang shekel dungjuijin, abonin talent somni le ko leh shekel jasagi le somthum ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule mipi kikhom simsaho lah-a kisundoh dangka ho jouse chu talent jakhat ahin, chule munthenga ding chu shekel sangkhat le jasagi le somsagi le nga ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Munthenga shekel kitena dungjui chun mikhat dingin bekah khat hichu shekel keh ahi. Koi hijongle kum somni-a pat chunglama kisim ho chu khat khatnin abonun mi sangjagup le sangthum le janga le somnga ahiuvin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ponjal butona koho le muntheng butona koho sunga chun dangka talent jakhat akileh lutnin, butonako khat khat dinga talent khat ahijehchun butonako jakhatna chun talent jakhat ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule akhomho, koikaho, alupal chule apehkhat akikhukhum asemin, hiho-a chun shekel sangkhat le jasagi le somsagi le nga alutnin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule sum-eng kitohdoh ho chu talent somsagi le shekel sangni le jali ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule hikoma chun mipi houkhom ho houbuh mun nachun butona koho le sum-eng maicham, sum-eng thihvang chule maicham kong dangho,
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule ahongsung kimvella akibutonako, ahongsung kotpi-a koho, chule houbuh kihena akilho chule hongsung avel pumpi-a akihena thihkil hochu asemin ahi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pakaiyin Mosi athupeh dungjuijin, Aaron din vontheng ho asemun, chule munthenga natohna din, kinbolna pon adum, asandup, chule asanthip min asemin ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule aman sana adum, asandup, asanthip chule tupat ponnemin boitong sangkhol ho asemin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahon pondum, ponsandup, ponsanthip chule tupat ponnem khutthem tah-a kikhongho chunga kaidin sana chu pasetnin akhengun, ajangin alheh-un ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amahon hiche ding chun lengkou tomho asemun, akimatsah un, aguiteni chu akilmatnun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule boitong sangkhol chunga konggah kidangtah chu Pakaiyin Mosi athupeh dungjuija kisem pon adum, asandup, asanthip, tupat kilhuh pon kisem chuto thakhat ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel chate minho jouse chu mutheitah in sana jemkoa Mohor namna bangin songgel chunga anamin ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Pakaiyin Mosi athupeh bangin, Israel chate geldoh jingna song dingin boitong sangkhol lengkouva chun abeh-in ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule aman boitong sangkhol ompho jong chu sana-in pondum, ponsandup, ponsanthip, chule tupat kilhuh ponnem bang chun khutthem tah-in ompho chu asemin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche chu aning li ahin, Ompho chu akithop ahin adung khap khat chule avai khap khat ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amahon song gol li-in akoijun; golphei masa chu; songsan, song-eng, chule song santhip ahin: hiche hi gol masa ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule golphei nina chu; song engsel, song dumjet, chule song mantam ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule golphei thumna chu; song sandang, song vom, chule song sandup ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule golphei alina chu; song engdum, khisonggel, chule khi song pol ahi. Hicheho hi abonchan sana khaoguija akanbeh sohkeijun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule songho chu Israel chate dungjuijin, aminu somleni dungjuijin mohor'a amin kitat bangin amitakip amin cheh-in phung somleni dungjuijin aumin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule amahon sana-a kisem pahvui bangin ompho mongteni-a chun sana chaokol theng asemun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule amahon sana jemko ni le thih chaokol ni asemin, chule ompho mong teni-a chun thih chaokol ni chu abut touvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule amahon ompho mong teni geija sana pahvui banga kisem sana chaokol akoijun ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule thih chaokol mong teni-a jemko teni-a chun pahvui ahenbeh-un, chule boitong sangkhol lengkou tom chunga amalama chun akoijun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule amahon boitong sangkhol sungnung langa agei chunga um ompho mongteni chunga chun sana chaokol ni asemun akoijun ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule amahon sana in chaokol ni asemuvin, hichu boitong sangkhol anoilanga chun abutnun ahi. Hichu amai langa mutheija kikhui boitong sangkhol konggah kijemhoi chunga akoijun ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule amahon boitong sangkhol chunga chun thih chaokol kil aumin, thih chaokol maman ompho-a chun akilbeh un; hiche boitong sangkhol chunga konggah phatah ahi. Hiche hi Pakaiyin Mosi athupeh dungjuija boitong sangkhola kona chu ompho chu kikangdoh louding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule aman adumngen na kikhong boitong sangkhol akon sangkhol len asemin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chule sangkhol len laija chun alai khat aumin, akikhen louna dingin sangkhol ngong hom bangin ahom kimvela chun akanchahna aum me.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule amahon sangkhol len mongchep chunga chun, kolbuthei limin pondum, ponsandup, ponsanthip, chule tupat kilhuh ponnemin asemun ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amahon sanatheng changengho asemun, sangkhol len mong jouse kolbuthei limho chun asemsao changeng chu akoijun ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pakaiyin Mosi athupeh dungjuija kintheng bolna din sangkhol len pamchep kimvella chun changengin kolbuthei chu kikahhalchet nin aumin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule amahon Aaron le achate dingin sangkhol chol tupat ponnemin khonthon asempeh un ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule thempu delkop tupat ponnem, ponnema kisem sangkhol sungnung, chule tupat ponnema kisem lukhuh hoiho chule tupat lhuhsa ponnem thempu delchen,
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule Pakaiyin Mosi athupeh dungjui jin tupat lhuhsa patjang le patdum, patsandup, chule patsanthipmin konggah asemun ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule amahon sana thenga kisem lallukhuh theng chunga chun melchihna mohor chunga kisun bangin, PAKAIYA ATHENG tin asunun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule amahon Pakaiyin Mosi athupeh dungjuijin, hichu thempu delkop chunga sangtah-a kandetna dingin patdum kipheh-in akanun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hitichun houkhom na houbuh-a natohho jouse chu akijoutan; Pakaiyin Mosi athupeh bangchun Israel chaten abol taovin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule amahon houbuh pon in, amanchah le achechah naho, thingpeh banggolho, akhomho chule akibutona koho,
  </para>
  <para style="p">
    <verse number="34" style="v" />Chule akhuna kelngoichal vuna kidesan, akhuna satuilut vunho chule pondal kikhai,
  </para>
  <para style="p">
    <verse number="35" style="v" />Hettohsahna thingkhong le mol lhon ho, chule hepi touna,
  </para>
  <para style="p">
    <verse number="36" style="v" />Dokhang kongle belho chule vetsahna changlhah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Khoilu thaomei khom theng, athaomeiho le thaomei ho geichu asemtoh un, chule kongle belho chule vahding thaotwi,
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule sana maicham, le nuding thao namtui le houbuh kotna kikhaiho,
  </para>
  <para style="p">
    <verse number="39" style="v" />Sum-eng maicham le sum-eng tengsa, amollhon ho le abelho jouse, twidolna le akitunna akengho,
  </para>
  <para style="p">
    <verse number="40" style="v" />Hongsunga kikhaiho le khomho chule akibutonakoho chule houkhom ho houbuh kinbolna ding kongle belho jouse,
  </para>
  <para style="p">
    <verse number="41" style="v" />Muntheng sunga natohna ding vonho, kintheng tohna dinga thempupa vontheng ho Aaron le achapate vonho Pathen na atohna diuva kipe hochu Mosi henga ahin choijun ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Pakaiyin Mosi athupeh jouse dungjuijin Israel chaten aboldoh sohkeitaove.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chuin Mosi'n akitongho jouse chu amun, aman, veuvin Pakai thupeh bang bangin nanghon natongun ahi tin Mosi'n amaho chu phatthei aboh tan ahi.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule Pakaiyin Mosi jah-a aseijin, hitin ati,
  </para>
  <para style="p">
    <verse number="2" style="v" />Lha masapen, nikho masapen ni chule houkhom ho houbuh chu natundoh dingu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule asunga chu hettohsahna thingkhong chu nakoi ding, chule thingkhong chu pondal nakhu khum ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule dokhang chu nahin putlut ding, achunga goltoh ding thilho chu nagoltoh ding; chule thaomei khom chu nahin pohlutna, thaomei ho chu navah ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule nangman hettohsahna thingkhong masanga chu gimnamtui halna sana maicham chu nakoiding; chule houbuh kotpi-a chu pondal nakhai ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chule houkhom ho houbuh kotphung masanga chu govam thiltona maicham nakoiding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule twikholna kong chu houkhom ho houbuh le maicham kikah-a nakoija, asunga chu twi nasunding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule akimvela chu ahongsung nasem ding, chule hong sung kimvel kotpi-a chu pondal hochu nakhai ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule nangman nuding thao chu nalah-a, houbuh le asunga umho jouse nanu-a, nasuhtheng ding, chule asunga kong le belho jouse toh: chuteng atheng hiding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule govam thiltona maicham le akongho jong chu thao nanu-a nasuhtheng ding: chutengle maicham thengpen hiding ahitai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule nangman twikholna kong le akeng chu thao nanu-a nasuhtheng ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule nangman Aaron le achapate chu houkhom ho houbuh kotphunga nahinpui ding, chule amahochu twija nasil ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule nangman Aaron chu vontheng navonpeh ding; thempu natohna mun'a atoh theina dinga thao nanu-a, nasuhtheng ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nangman achapate chu nahinpui ding, sangkhol chol na-ahpeh ding:
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule nangman apao nabol banga amahon thempu natohna munthenga na atoh theina dinguva, amaho jong thao nanu ding ahi: hiche athao kinu-u chu akhang khanguva atonsotna thempu ahi nadingu ahitai, ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun Pakaiyin athupeh bangchun Mosi'n atongsoh keijin, chutobang chun aboltan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin ahitin ahi, akum nina lhamasa penna nikho masapen nin houbuh chu akitungdoh tan ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chule Mosi'n houbuh chu atungdoh-in, akibutona koho akanchah-in, athingpehho, abanggol ho, chule akhomho chu atundoh-in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule aman houbuh chunga chun ponjal chu ajalin, chule ponjal chu achungvuma akhun, Pakaiyin Mosi koma athupeh bang chun aboltanin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin aman hettohsahna chu alan, thingkhong sunga akhumin, amol lhonho chu thingkhonga abutona ding kisem chaokol sunga chun ahenglutnin, chule hepi touna chu thingkhong chunga chun akoijin ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chule aman thingkhong chu houbuh sunga ahin polutnin, chule akhuna pondal chu akhaijin, hettohsahna thingkhong chu akhun; Pakaiyin Mosi athupeh bangchun aboltan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule houkhom ho ponbuh in sung, houbuh sahlam sang, pondal polama chun dokhang chu akoijin ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chuin aman Pakaiyin Mosi henga athupeh dungjuijin, Pakai angsunga chun changlhah chu agoltan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuin aman houkhom ho ponbuh lhanglam sang, dokhang maijona chun thaomei khom chu akoitan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuin Pakaiyin Mosi henga athupeh bangin aman thaomei chu Pakai masanga chun avahtan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule aman houkhom ho pon in sunga pondal masanga chun sana maicham chu akoitan ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pakaiyin Mosi henga athupeh dungjujin aman gimnamtui chu ahaltan ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule aman houbuh kot maija chun pondal chu akhaitan ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule aman houkhom ho houbuh kot koma chun govam thiltona maicham chu akoijin, chule hia chun Pakaiyin Mosi athupeh dungjuijin aman govam thilto le anneh thilto atohtan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule aman kisuhthengna ding twikholna chu mipi houkhom ho pon-in le maicham kikah-a chun akoijin, kisil thengna din hia chun twi akoijin ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Mosi, Aaron, chule achapate chun hichea chun akhut akeng akisilun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaho houkhom ho pon-in sunga alut tengu, chule maicham anai tengule, Pakaiyin Mosi athupeh dungjuijin akisil jiuvin ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chuin aman houbuh le maicham vela chun ahongsung asemin, kotpi chungjola chun pondal akhaitai. Hitichun Mosi'n anatoh ajoutan ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hichun houkhom ho pon-in chu meilom'in ahinkhun, Pakai loupina chun houbuh chu adiptan ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chuin Mosi chu houkhom ho pon in'a chun alut thei tapon ahi; ajehchu meilom chu aumdentan, Pakai loupina chun houbuh chu adiptan ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Houbuh chunga kona meilom chu akilahdoh phatnin, Israel chate chun akholjina ajomtaovin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amavang meilom chu akitoldoh louva ahile, akitoldoh kahsen amaho akholjinji pouvin ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ajehchu Israel insung pumpi mitmun akholjina sung seuvin Houbuh chunga chun sunle Pakai meilom chu aumjin, chule jan le meikongin aumjin ahi.
  </para>
</usx>
