<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1TI" style="id">1 Timothy</book>
  <para style="h">1 Timothy</para>
  <para style="toc1">1 Timothy</para>
  <para style="toc2">1 Timothy</para>
  <para style="mt">1 Timothy</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eihuh hinguva Pathen le kinepna Pakai Christa Jesu thupeh dungjuija, Christa Jesu solchah, Paul'in,
  </para>
  <para style="p">
    <verse number="2" style="v" />tahsana kachapa tahbeh Timothy hengah, i-Pau Pathen le Christa Jesu'a konin lungsetle khotona chule lungmon nachunga umhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Macedonia gama kache kona, mi abang khatnin thuhil lamdang ahil louna dingule, moh thusim chule tan thei lou khanggui thu, hichun tahsanna Pathen gou chinna lama phatchomsah tahsih-a kinelna akonsahjoh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angaisah louna dinguva, nahilchah theina dinga, Ephesus kho-a umin, tia kangeh banga chu, tu-a jong kati ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahivangin thu kipeh lona pen chu lungthengle ase apha hetna pha chule tahsan kichen tah-a kon ngailut chu anei theina dinguva ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichenga kon chun mi kimkhat akihei mangin moh houlimna lama avah koitaove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Athuseijula adih ahimonge tia atahtinao jong chu he louhelin, danthuhil ahi nomui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahin dan hi adoltah-a nitpa ding chun aphai ti iheuve;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla dan hi michonpha dinga hilouva, dan sukeh thua nunglou, Pathen ngaisahlou chonseho, abohho athenglou, pathat, nuthat, mithat;
  </para>
  <para style="p">
    <verse number="10" style="v" />mijong, palepa kikoi, mihem gu, mijou, chule jouva kihahsel; hiteho chengse dinga chule adang thuhilpha kicheh kaleh-a chon aumle, amaho chengse dinga chu kiphut ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiche hi pachat umtah Pathen loupina Kipana Thupha keima eikivopsah dungjuija ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keima thahat eipe-a I-Pakaiyu Jesu Christa chu kathangvah jinge, ajeh chu Aman keima ginchat uma eingaitoa, alhacha-a eipansah ahitai;
  </para>
  <para style="p">
    <verse number="13" style="v" />Tu masanga hou taitom kanahia, abolsea kanapana, susehat kanahi ahin: hinla tahsanlou jeh-a hettoh louva kanabol ahi jeh chun hepina kamutan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Christa Jesu'a tahsanna le ngailuttoh kitho-a I-Pakaiyu milungset chu hadima dimlet ahitai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Michonseho huhhing-a Jesu Christa vannoi leisetna hunga ahi, ti tahsan umtah hi mi jousen san cheh ding doltah ahi; hicheho lah-a chu keima apipen kahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahin tonsotna hinna dinga Ama hintahsan dingho chun avettoh-a ajom dinguva, Jesu Christa'n athohhatna chengse chu apipen keija hi alahdoh theina dinga eihepi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tun tonsot Leng kem theilou, mu theilou, chule Pathen chingtah khatseh, ginnale jana chule aloupina chu atonsot atonsot khangin umjinghen. Amen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kachapa Timothy, nangma tahsan neitahle ase apha hetna phatah neija, nangma umchan ding thudol masanga kiseisa chengse chu, hiche dungjuija chu phatah-a gal nasat theina dinga, hiche thupeh chu nangma kapeh nahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Abang bangin chuche tahsan leh ase apha hetna chu apailhah jeh-un atahsan kong-u akehgamtai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaho lah-a Hymenaeus le Alexander chu taitomna akisin lhon louna dinga, keiman Satan khutna kapehdoh ahitai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hijeh-a chu amasapena katilkhou nahiuve, mijouse-a dingin taona, thumna, chule taopehna toh thon thangvah jingin umu hite;
  </para>
  <para style="p">
    <verse number="2" style="v" />Lengho dingin, chule panmun len tuhho dingin; chutia chu eiho Pathen ngaisahna le jabolna lam jouse-a chamdel le lungmong ikhosah theina dingun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichu eihuh hinguva Pathen mitmu-a phatah le lahthei ahi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman mijouse huhhing-a aumding le thutah hetna lama ahungcheh diu adei ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen khatsehbou ahin, chule Pathen le mihem kah-a palai jong khatsehbou ahi; ama chu mihem, Christa Jesu chu ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama chu aphat cha-a hettohsah hidinga, mi jouse lhatdoh na-a hung kipe-a ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiche dinga chu aseiphongle dingle solchah, (Christa-a thutah kasei ahi; jou kaseipoi); tahsa le thutah-a chidang namdangho hil dinga eikipansah ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh chun pasal hon lunghang louhel le kinel baotam beihelin, muntin-ah khut theng domuhen lang taovuhen, hichu kalunggot ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chutobangma chun numei ho adol bepchan kijem uhen, kiphalam khenchan ging gehchan umuhen; sampheh jeppah, sana twikohchanga chule thil man tama kijem louvin,
  </para>
  <para style="p">
    <verse number="10" style="v" />thilpha bolin kijemleu kati; hichu Pathen gin phonga numei chonna doltah ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Imalam jouse-a numei chu thu noija umhen, gingkhen chan thu kihiljohen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi hil dingle pasal chunga thunei dingin numei thu kapepoi; thipkhenin umthim ngetnget johen katibouve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu amasa Adam kisema, chujouva bou Eve kisema ahi;
  </para>
  <para style="p">
    <verse number="14" style="v" />chule Adam chu lheplhah-a um hilouva, numeinu johchu bou lheplhah-a uma, suhkhelna-a lhalhut ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hijeng jongle tahsana, ngailutna, thenna, chule umchan phatah-a aum jom jinguva ahile, amanu chu acha neina-a sohcha ding ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Koi hile houbung lam kaija pan nom chun natoh pha alunggot ahi, tia kisei hi thudih tah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh-a chu houbung lamkai chu nolna bei, numei khat ji-a nei, kitimthei, lunglimtah, kituptah, jindot them, mi hil them,
  </para>
  <para style="p">
    <verse number="3" style="v" />Juheh lou, miden mang lou; alamlouva phatchomna ding ngaito-a kilose mi hilou, mi nunnem hi ding, dou hollou, sum ngailu lou;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama insung phatecha potup thei, jana neitah-a achate athua nunsah thei mi hi ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />(Ama insung chunga vaipohje he lou chun Pathen houbung ho chu iti avetsuija akaitup thei dingham?)
  </para>
  <para style="p">
    <verse number="6" style="v" />Atahsan thah hilou ding ahi, ajole kiletsah hoithontin Diabol themmo sahna-a chu getninte;
  </para>
  <para style="p">
    <verse number="7" style="v" />Chulou jong chu, polama mite seiphat jong hiding ahi; achuti loule seisetnin umintin Diabol thangah oh khante.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutobangma chu houbung lhacha-a pang ding jong chu migun ja-umtah hiding, mi kamtam hilou ding, ju-a lop hilou ding, alam louva sum veikan lung go mi hilou ding;
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule sele pha hetna thenga tahsanna thuguh tuh mi hi ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaho chu kipatep masahen, chujoule nolna bei ahiu lebou, lhacha na tonguhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chutobangma chu aji teo jong migun ja umtah, mihehse hatlou, kitim them, chule ijakaija tahsan um hiding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lhachaho chu numei khatseh ji hicheh hen, achate chengule a-insungu phatecha potup them cheh hiuhen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ajeh chu houbung lhacha na phatecha tongho chun amaho dinga Christa Jesu'a um tahsan na-a chun dinmun pha le hansana nasatah akilodoh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chomkhat joule naheng lama hung ding kinema, hiche hi kahinsut ahi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahinla kahung gei khatle, thutah khom le abul Pathen hing houbung, Pathen insunga chu mi itobanga iti umchan dingdol ahi nahetna dinga kahin sut ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathen ngaisahna thuguh chu nelkalna beihela lena ahi; Pathen chu tahsa-a ahung kiphongin, Lhagaova them changin, Vantil ten amuvin, Chidang namdang lah-a seiphongin aumin, Vannoi'a tahsanin aumin, Loupia lahtouvin aumtan ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahin Lhagao Thengin kichentah-in aseije, ni nunung lamle mi kimkhat tahsana kona pul lha-a, lhagaoho misuh lamvaina doha leh thilhaho thuhila hung lunglut diu;
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichu ama sele pha hetna thisa kidep tobang miphalhem thujou seiho-a kona sohdoh ding ahi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Amaho chun kichen akhamun; atahsanale thutah hetohhon thangvah puma aneh dingu, tia Pathen thilsemho chu neh ding ajadauve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ajeh chu Pathen thilsem jouse chu phasoh keija ahin, pai ding imacha umlou ahi, thangvah puma ikisanle;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajeh chu Pathen thua konle taona-a kisuthenga ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hicheng thu chu sopiho lunga nakhuma ahile, Christa Jesu lhacha phatah nahi-a, tu geija nahinjuipeh tahsanna thu le thuhilpha-a chu kivah khang ding nahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Amavang hou seisetnale nupi tehse ho houlimna moh thusim chu la hih-in, Pathen ngaisahna lama them kiha sinin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ajehchu tahsa lam thil kisin hi phatchomna themcha khatcha ahin; Pathen ngaisahna lama kisin hi imajousea phatna ahi; ajeh chu hichu tu hinkho-a dinga jong, khonunga hinkho dinga jong thutep uma ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiche thu kiseihi tahsan umtahle jop sohkei ding doltah ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu eiho tu chana hi Pathen hinga ikinep jeh uva tonggima kiseh ihiuve; ama chu mi jouse huhhing-a ahin, ahideh-a chu atahsanho huhhing-a ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangman hicheho hi thupeh-in lang chule hilin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nakum lhom nachapan chu koima nahsahmon umsah hih-in; ahin nangman thu lamin, houlim na lamin, mikhoto lamin, lhagao lamin, tahsanna lamin chule thenna lamin atahsanho vetjui dingin umin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keima kahung kahsen, nangma lekha simin, mi suhhalin, mi hilin anaponthon.
  </para>
  <para style="p">
    <verse number="14" style="v" />Upahon akhut angapma kiphongdoh dungjuija nakipeh thilpeh nanga um chu lhadoh loujenin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma hichenga hin gen ngaijin ponthon, chule hichenga chun umjing jengin; mi jouse henga nakhantou akiphondoh theinan.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmale nathuhila chun kigingphan chingtheijin; chule hichenga chun umin; hiti chun bolle chun nangmale nathuhil ngaiho agoma nahuhhing ding ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Upa tehse phohsal hih-in, napa tobangin jolthon; khangdongho nasopi bangin;
  </para>
  <para style="p">
    <verse number="2" style="v" />Nupi tehse ho nanu tobangin, chule numei khangdongho chu nanaonu teho tobangin lung thengselin ngaiton.
  </para>
  <para style="p">
    <verse number="3" style="v" />Meithai kichehtah ho chu jabolin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amavang meithai achate ahiloule atute uma chu amaho chun amasan a-insunguva ngailut vetsahje heuhen, chule ahinguva nule pate phatna-a lethuhje kisinu hen; hichu Pathen anga aphale lah theitah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahin meithai kichehtah achanga uma vang chu Pathen'a kinema, sunle jana thumle taona jenga beh jingji ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amavang atahsa nomsahna lam jenga kipenu vangchu ahinpet jenga jong athisa ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho chu seiset achan louna dingun thupeh hicheng hi pen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahivangin koi hijongle ama mite ding ngaito lou, ahideh chu ama insung mite ding ngaito lou chun, tahsan chu aledoh ahitai, atahsanlou sanga chonsejo ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kum somgup noija mi hilou, pasal khat ji hisa,
  </para>
  <para style="p">
    <verse number="10" style="v" />thilpha bolnatina seiphat changsa, chate khoukhahsa, jindot themsa, mithengte keng silpehsa, ahesoh gentheiho phatna bolsa, chonphatna jouse nungjuisa hitobang louse chu meithaijin sun hih-in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin nutil meithai vang chu meithaijin sun hih-in; amaho chun Christa douna-in atahsa nomsahna dingu angaito jeh-un jinei ding agojiuve;
  </para>
  <para style="p">
    <verse number="12" style="v" />chule akipehnao masa apailhah jeh-un themmo achangjiuve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule chuche tailou jong chun, intina alengleuvin, thaset apanjiuve; chutigoh jong hilouvin, amuhthem akamjaovun, minatoh taimon, seilou ding ding aseijiuve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hijeh chun, chutobang nutil meithai chun ji neihen, cha hinghen, inneinu na tonghen, melma chun aseisetna dingu kom beihelin umleu kati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ajeh chu tu jengin jong mi kimkhat Satan nungjui jin akihei mangtaove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Atahsana pasal ahiloule numei khattou meithai neija aumle, ama chun kithopi hen; houbung pohgihsah hihhen; houbung chun meithai kichentah chu akithoipi theina dingin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Upa vaihom themho, thusei lamle mihil lama ponpana gunchuho chu, ajat ni-a ginle jan umuhen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajeh chu Pathen lekhabun, bongchal chang chil pet amuh som hih-un; chule Natongan athaman asanding chu adol ahi, ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Upadol hehna chu ahetoh nile thum ahi loule, la hih-in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adangin kichatna anei theina dingin, achonseho chu japi angsung tah-a sosalin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathen toh, Pakai Jesu Christa, chule vantil kilhengho mitmu-a hiche thuhi kapeh nahi, kichentah-a hetoh loule jachen louva thu tan louvin kathupeh cheng hi mangin; langneijin imacha bol hihhelin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Koima chunga nakhut ngampai jeng hih-in; chule midang chonset chan khompi hih-in; chule kisutheng jingin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na-oisung jehle nadammo jing jeh chun twisihkeo jeng don louvin, lengpitwi themkhat khat anamangjitan.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khattou chonsetna kilangtah ahin, thutan na-a lhung masa jengji ahi; chule abang khattou setna vangin amaho nung ajuijon ahi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Chonphat najong chutobangma chu kilangtah ahi; chule chutobang dang dang chu im thei imacha aumpoi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen min chule athuhil chu taitoma aum louna dingin, namkoljon poh noija um soh ho chengsen a-pakaite chengu chu jabolna changdinga lom ahiubang tah-in bulhing setnin jaboluhen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule atahsana pakai neihon amaho chu sopi ahi jeh chun nahsahmon boldao hen; chusangin hajen chehjohen, ajeh chu anatoh naova kon phatchomna muho chu atahsana le amaho dinga dei umtah ho ahiuve. Hitiho thuhi hil inlang tilkhouvin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi khattou thuhil chomdang hila auma, thupha kicheh, I-Pakaiyu Jesu Christa thu leh Pathen ngaisahna lam thuhilpha chu asan louleh;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama chu ahoithojin, imachala ahejipoi; hettah sangin kinelna, thu nelkalna hivei aveijin, hia kon chun kithangset, kinah, kiseisetto, kiginmo, nelhatna asohjin ahi;
  </para>
  <para style="p">
    <verse number="5" style="v" />chutobang miho lung chu sesohjia ahin, thutah neilou ahiuvin, Pathen ngaisahna hi sumlam phatchomnan angaito jiuve, hitobanga kon chun kikangsen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahin lunglhaisela Pathen ngaisah hi phatchomna tah chu ahi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ajeh chu eihon vannoi'a hin imacha ihinpo lutpouve, chule atahbeh-in hichea kona jong imacha ipohdoh thei dingu ahipoi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahinla eihon anneh chule nihchen ponsil ineijule hichea chu ilunglhai jeng dingu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hao lung goho vang chu lhepna-a leh thangkola chule ngolna tintangle suhset nomna lam tamtah-a alha lutjiuvin, miho suhgamnale manthah na-a alhah lhumsah jiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ajeh chu sum ngailut hi setna jouse bul ahi; hichu mu ding akihabolna lama mi kimkhat tahsana-a konin avah mangun, amahole amaho lunghemna tamtah-in akisun jiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahin, Pathen mi, nangma vang hichenga kon chun jamin; chule chonphatna, Pathen ngaisahna, tahsan, ngailutna, thohhatna, nunnem na, hicheng chu delin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tahsan kisehna pha-a kihaseh-in ponpanin, tonsot hin kemlou chu tuh jingin; hiche dinga chu kikou nahi; chule ahetoh tamtah ang sunga phondohna phatah chu naphondoh ahitai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Imajouse hinsah Pathen leh Pontius Pilate ang sunga phondoh phatah phongdoh-ah Christa Jesu mitmu-a, hiche thupeh hi kapeh nahi,
  </para>
  <para style="p">
    <verse number="14" style="v" />I-Pakaiyu Jesu Christa hung kilah kahsen, nangman thupeh hi boh beh louhelle seisetna um louhelin chingin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thunei khatseh, lengho Leng leh pakaiho Pakai, pachat umtah chu aphatcha hung kilah ding ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama changsehbou chu thilouna neija ahin, nailut theihoi hilou vah-a chenga ahi; ama chu koiman mukha lou chule mu jong mu thei lou ahi, ama jenga chun choi-at le tonsot thilbol thei thahat chu umjing hen. Amen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tu hinkho-a vannoi leiset thila haoho chu ahoitho louna dingun hilchah-in, kichetna bei suma kingai louvin, thil jouse imanchah dinga eipeuva Pathen joh-a kingaijuhen;
  </para>
  <para style="p">
    <verse number="18" style="v" />Amahon thilpha boluhen, thilpha bola chun hao uhen; hop ding jong phaluhen, mi tonan jong thanomuhen;
  </para>
  <para style="p">
    <verse number="19" style="v" />Tonsot hinna chu atuhchah theina dingun, khonung hinkho-a dinga bulpha neija akikhol theina dingun hilin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vo Timothy, nangma nakichin sah chengse hi hongphan; chule hou seisetna thumotsei amahon chihna atiu, alam loutah-a kinelna-a kon chun kihei mangin;
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi kimkhat hiche chihna chu ahoitho piuvin, tahsan nalama abidoiju akheltaove. Lungsetna chu nachunga umhen, Amen.
  </para>
</usx>
