<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NEH" style="id">NEHEMIAH</book>
  <para style="h">NEHEMIAH</para>
  <para style="toc1">NEHEMIAH</para>
  <para style="toc2">NEHEMIAH</para>
  <para style="mt">NEHEMIAH</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hachaliah chapa Nehemiah thuho chu ahi. Chuin ahitin ahi. Kum somni lhinkum Chislev lhasunga keima Shushan leng ina kaum laijin,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasopite lah-a mikhat Hanani chule Judah'a konin mi phabep ahungun, chule keiman Judah te sohchan na-a kona hoidohho chule Jerusalem khopi thu kadonglen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin amahon kajah-a, sohchan na-a kidalha amohho chun gamsunga gentheinale seisetna athoh thoh jengun, Jerusalem kul bang jong achimlha gamtan, chule akotpiho jouse jong meijin akalhatan ahi atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule ahitin ahi, hiche thuho kajah phatnin katouvin kakapmin, chule ni ijat-ham lunghemin kaumin, chule an kangol-in van Pathen henga kataovin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Vo Pakai van Pathen, Pathen loupitahle tijat um, ama ngailu-a athupeh nit ho chunga thulhun chingtupma lungsetji nahenga katao ahi,
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun nasohte Israel chate dinga asun ajana namasanga nasohpa kataonahi ngaipeh dingin namit hin hasah inlang, nanakhang hinsungin; nangma douna-a kachonse taovin, Israel chate chonset naho kahin phonge, keimale kapa insung mite kachonse taove.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangma dounan thilphalouhel kanabol taovin, nalhachapa Mosi henga nanapeh thupeh ho, tepna danho, vaihomnaho jouse chu kana nit tapouve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kangeh nahi, geldoh temin, nalhacha Mosi henga kathupeh chu nasuhkhel uva ahile, keiman nangho namtin lah-a kathejal ding nahiuve nati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahinla keima lama nahung kiheijuva, kathupeh nachintup uva nabol uva ahile, van mong geija nomanga um hijongleu chun chua kona chu kapuidoh khomding, chule kamin umna dinga kalhena mun'a chu amaho kapuikhom ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tun hiteho hi nasohte le namite, nathilbol theina loupitahleh nakhut thahat tah-a nalhatdohsate chu ahiuve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vo Pakai kangeh nahi, tun nasoh taona lama hin nanakhang hindon, chule nasohho taona namin janachu lolhinsah-in katao nahi, tunin nasoh keima hiche mipa mitmuhin lungset tah-in hepina neipen, ajehchu keima lengpa khondoma panga kahi, ati.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin ahitin ahi, Artaxerxes lengchan kal kum somni lhin kum, Nisan lha sungin a-anga lengpitwi aumin, keiman lengpitwi chu kalan lengpa chu kapetai. Tuma sangin amasanga lungkham mel kamusah khapon ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hijeh chun lengpan kajah-a, anala nahipon, namaiso anguinave itidan ham? imachadang hiponte, lungdonna nanei ahi, ati, chuphatnin kakicha behset jengtai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin keiman lengpa jah-a, lengpa hingsotnin, ipidia kamaiso nguida dingham? kapu kapate khopi, lhankhuh ho umna chu mang thah-in aum gamtai, kotpiho jouse meijin akagam tan, ahomkeo ahitai, kati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin lengpan kajah-a ipi nathum nomham? eitin, hiti chun keima van Pathen henga kataotai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin lengpa henga Lengpa lunglhai nading ahia, nasohpa nangma mitmu-a hi lungset theidol kahile, Judah gama kapu kapate lhankhuh ho umna khopi-a chun neisolin lang gasaphange, kati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin lengpan kajah-a (lengnu jong akoma atoupet ahi) itih changei nagatham ding ham? itih phatleh nahung kilekit ding ham? atin, hiti chun lengpan soldingin pha eisan, chuin keiman aphat kateptai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Achung chonin lengpa henga chun, Lengpa lunglhaina ahileh Judah gam kalhun kahse-a eichesah uva, eihen-oh louna diuvin vadunglen lama gamvaipoho mudin lekhathot neisutpeh inlang,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule Lengpa gam ngahpa Asaph dingin jong, inpitoh kimat kotpi-a pangding, khopi kul-a ding, chule kagachenna inding thing, eipehtheina dingin lekha neisut peh-in katin ahi. Chule ka Pathen khut thahat kachunga aumdung juijin, imajouse chu lengpan eiphatsah pehtai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin keijong vadung len gal lama gamvaipo ho henga kahungin, lengpa lekhathot ho chu kapen ahi. Chuin lengpan sepai lamkaiholeh, sakol chungtou galsatho chu eikilhonpi din ahin solin ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Horon mi Sanballat le sottola pang Ammon mi Tobiah sohpan anajahtah uchun, Israel chate khantouna ding ngaito din mi ahunguve tin, analung himolheh-un ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun Jerusalem'a kahungin nithum kanichong tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin jan-in kathouvin, keimatoh kaumpi mi phabep kahiuvin, Jerusalem dinga katohgot ka Pathen'in kalungthima eikoipeh chu, koima kahilpon, katouna gancha tilou chu kahenga gamchadang aumpoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule jan laijin kapotdoh-in, phaicham lama kotpi lampi chu kajuijin, dragon twikul mai lampileh ehbohna kotpi phung geijin kachepeh-in, Jerusalem kulbang chimsa leh akotpi meijin akahvamsaho chu kavetohsoh keije.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chujouvin twinah kotpi phung gei, lengpa twikul geijin kachen, ahin che-apat hin katouna gancha chu achepai theina ding mun aumtapoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuin jan-in vachadung kajottouvin, kulbang chu kavelen, chuin kakinungle kitnin, phaicham kotpi-a chun kalutnin hitichun kakinungle kit tai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vaihomte chun hoija kache, ipikabol jong eihedoh pouvin, chule Judah te thempuho, milen milalhole vaihomho chule hiche natonga pangdingho henga jong kasei pon ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuin keiman amaho jah-a, igen theinao nasatje hi namuvin, Jerusalem agohkeova aumle, akotpi phungho jouse meijin akasetai tijong namuve: hungtemun, mi i-sah louva i-um louna dingun, Jerusalem kulpi chu saphakitnu hite, kati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuin keiman amaho chu kadinga phatah ka Pathen khutleh lengpan kajah-a anasei thu jouse chu kaseipehtai. Chuin amahon kipatdoh-u hitin, saote, atiuve. Hitichun napha tongding chun abanthau ahatsah taove.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahinla Horon mi Sanballat le Ammon mi sottollea pang Tobiah leh Aram mi Geshem, amahohin ajahdoh phatnu chun, eidai chavaijun, nahsahmotah-in eibolun, nathil boluhi ipi hitam? lengpa douna-a kiphin ding nahiuvem? atiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuin amaho chu keiman kadonbut nin, van Pathen'in eilolhinsah untin, hijeh chun keiho ama lhacha hohi kipat ungting kasahdoh dingu ahi. Nangho vangin Jerusalem'a chanle thuneina chule hetjingna naneipouve, katin ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin thempu chungnung Eliashib chu asopi thempu dang hotoh akipat doh-un, kelngoi hongkot chu asemphaovin, asuthengun, chule akotkhah ho asutouvin Meah insangle Hananeel insang geijin asuthengun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule hiche bana hin Jericho miten asauvin ahi. Chule amaho bankitna chun Imri chapa Zaccur chun asan ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahin Hasseneaah chapaten ngakul kotpi laichu asemun, ajol chengsetoh ajamun, chule akot jousetoh atouvin, akamnading holeh athihlhon jong atouve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule amaho banin Koz chapa Uriah chapa Meremoth in asemphan ahi. Chule amaho bana hin Meshezabeel chapa Berechiah chapa Meshullam'in asemphan ahi. Chule amaho bana hin Baana chapa Zadok'in asemphan ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule amaho bana hin Tekoa miten asemphaovin, amilen amilalteu chu hiche a-pakaiyu natohna-a hin athunoija akunpouve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiche chungchon hin akotpi luichu Paseah chapa Jehoiada le Besodeiah chapa Meshullam'in asemphaovin, ajolpi ajamun akot jouse atouvin, akamnading hole athihjol jong atouve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho bana hin Gibeon mi Melatiah le Meronoth mi Jadon le vadunglen gallama gamvaipo Gibeon mite Mizpeh mihon asemphaovin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abana hin sana khengho lah-a pang Harhaiah chapa Uzziel'in asemphan ahi. Abankitna chun thao namtui semho chapa khat Hananiah in asemphan, chule Jerusalem kulbang satah geijin kul akhokhum taovin ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amaho bana hin Jerusalem khopi kehkhat vaipo-a pang Hur chapa Rephaiah in asemphan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule amaho bana hin Harumaph chapa Jedaiah'in ama inmai dontah chu asemphan chule ama bana hin Hashabnah chapa Hattush'in asemphan ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Harim chapa Malchijah le Pahath-moab chapa Hashub'in amaho semnaban alangkhat chu asemphan, meilum insang chan geijin asemphan ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule abana chun Jerusalem kehkhat chunga vaihom Hallohesh chapa Shallum'in achanu tetoh asemphaovin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Phaicham kotpichu Hanun le Zanoah chenghon asemphaovin, amahon asaovin kotkhah ho atovin akamnading holeh athihlhon hojong atovin, chule Ehbohna kotpi changeijin akulbang tong sangkhat asemun ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahinla ehbohna kotpi lamchu Beth-haccerem gamkaikhat vaipopa Rechab chapa Malchiah in asemphan, asan, akotkhahho atungdoh-in akamnading hole athih lhonho jong aton ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin Mizpah gamkaikhat vaipopa Col-hozeh chapa Shallun'in twinah kotpi chu asemin, asan, chule aloijolsoh-in, chule akotkhah ho atung doh-in akamnading holeh athihgol hojong asemin, chule lengpa hon pama Siloah twikul chu David khopi lam jotsuhna kalbi chanin asemphai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule abanin Azbuk Beth-zur gam kehkhat vaipopa chapa Nehemiah chun David lhankhuh toh kigalsaile twikul kisem nalam le mihangsan ho in changeijin, asemphan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama jouvin Levi holeh Bani chapa Rehum'in asaphan ahi. Abanin Keilah gam kehkhat vaihoma pang Hashabiah chun ama gamchan chu thalhengin asemphai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama banin Keilah gam kehkhat vaipopa Henadad chapa Bavaile asopihon asemphaovin ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule ama banin Mizpeh gam vaipo Jeshua chapa Ezer chun gal manchah kholna kul ningkoi jottouna jonchu asemphan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama jouvin Zabbai chapa Baruch chun phatchom ngaitah-in mun behkhat, kul ningkoi apat thempu chungnung Eliashib in kotpi phung geijin asemphai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Abanin Koz cha Uriah chapa Meremoth'in, mun behkat Eliashib in kotkhah apat Eliashib in monglam chanin asemphan ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chule ama banin phaicham miho le thempuhon asemphaove.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amaho bana hin Benjamin mitele Hashub miten amani in donchu asempha lhonin ahi. Chujouvin Ananiah cha Maaseiah chapa Zariah'in ama in kom chu asemphan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abanin Hanadad chapa Binnui'in mun behkhat Azeriah in-apat kulbang ningkoi chan asemphan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Uzai chapa Palal'in kulbang in ningkoito kigalsai le lengpa insanga kona hung sangdoh, songkul tangho, thukitana vela insang chungnung chu asemphan ahi. Aban chu Parosh chapa Pedaiah'in asemphan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chukal valin Ophel'a cheng Nethinim ho chun niso lampanga twikul kotpi kigalsai, in kisa sangdoh geijin asaphaovin ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aban chu Tekoa hon mun behkhat insang lenpi kisajumdoh jonleh Ophel kulbang chanin asaphauve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amaho banin thempuhon sakol kotpi chunglama pat, ama ama injoncheh asemphaovin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Immer chapa Zadok'in amaho bana hin, ama injon asemphan ahi. Abanchu niso lam kotpi ngah-a pang Shechaniah chapa Shemaiah'in asemphan ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Abana hin Shelemiah chapa Hananiah le Zalaph chapa agupna Hanun'in mun behkhat asemphaove. Abana hin Berechiah chapa Meshullam'in ama indanjon chu asemphan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama bana hin sana kheng chapa Malchiah'in, Nethinim ho umna mun Miphkad kotpi chanleh kivei miho inchan asemphan ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aning jottouna lampile kelngoihong kotpitoh kikah chu, kivei miho leh sana khenghon asemphaove.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahinla ahung hitin ahi, Sanballat'in kulbang kasemphatnu ajahtah-in, alung ahanglheh jengin Judah te chu ataitomin, i-sah loutah-in aboltan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule asopiholeh Samaria sepaiho masanga chun hitin thu aseijin, hiche milhachom Judah hohin ipiham abolu? amahole amaho kisadoh joudingu hinam? ganlhaina abolmong dingu hinam, nikhat na asahdoh mong dingu hinam? meijin akahsetsa, bohnen lah-a kilhukhom songho chu akaldoh uva asemphat joumong dingu hinam? ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichun akoma um Ammon mi Tobiah chun, ahinai cheho insah hi iti sahjongleu achunga sial khattou gakaldohleh, asongbang hohi chimlha talou ding ham? ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vo, ka Pathen'u ngaijin, i-sah louvin kaumun, eihou setnao jousehi amaho chunga lhunsah inlang, amaho jong hoilai gam hama sohchang dingin michomgamte khutna pedoh-in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule akhangit lounao immangpeh hih in, chule achonsetnao chu nangma-a konin thaimangin umdahen, ajehchu kulbang semho masanga nangma naphinseuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitichun kulbang chu kasauvin, chule kulbangho chu akimlai gei kajopmatsoh taove. Ajehchu mipi honjong natoh thanopna lung apucheh un ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahinla ahung hiti, Sanballat, Tobiah le Arabia mite, Ammon mite, chule Ashdod miten, Jerusalem kulbang sahphat ahia, chule akehlai jouse akisemphatai ti ajahtah-un, alunghang lheh taovin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin abonchauvin akihougu sohkeijun, chule Jerusalem chu kisatpi-a suhtang agotauve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hijeng jongle ka Pathen'u henga kataovun, asun ajanin amaho ngah-a velhiding kakoijingun ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin Judah chun, thilpoho athachol gamtaovin, ahin bohnenla tampi aumnalaijin, hijeh-a chu kulbanghi i-sah joulou dingu hitante ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Imelma teovinla, amaho lah-a igalut uva, igathaova, anatoh-u igasuh tangpeh tokah seuva ahet loudingu ahi, mujong eimu pouvinte tin aseijui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ahitin ahi, akenguva cheng Judah te chu ahungun, kajah uvah amaho muntina kona hunguva eihung delkhum dingu ahi, tin somveijen ahungseijui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh chun kenjong kulbang polam pang anem nalai le asanglai munho chun mipi ho chu, a-in kokon achemjamu, atengchao chule thalpi hotoh thon panmun kasemsah-e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule kathoudoh-in kagavelen, milen milal, vaihomhole mipi ho jah-a, amaho khu kichahih beh-un, Pakai loupi kidang le thahat tah neipa chu sumil louvin, nasopi hou, nachapateo, najiteule na-inko huhnadin satnun kati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule ahitin ahi, kamelma teovin athil gonnu kahetdoh uva, chule Pathen'in athilgonu asuh chatvai pehtah-in, keiho jong ama ama natoh cheh tong dingin kakinungle kit taove.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chule ahitin ahi, hiche nikho-a pat hin, keima lhachate mi akeh khatnin na atongun, chule akehkhat hochu tengcha, lumle thalpi chule ompho aki-ah un, chule vaihomte chu Judah te insung mite nunglama apanguve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kulbang seho, chule pohgih pohon apohgih-u pumin akhut langkhat nun na atongun langkhatna manchah akichoicheh un ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hitichun insaho chun achemjamu apanguva akikocheh-un, insah chuto akopmun, chule sumkon mutna pangpa chu keima koma aume.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chule keiman milen milal holeh vaihomho chule mipi henga chun, inatoh-u hi anasan alenlheh-in, kulbang isahnaova hin ikigamlat thei lheh-un,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hijeh chun sumkon gin najah nalamcheh uvah keiholam hindelluvin, i-Pathen'un eiho dia gal eisatpeh diu ahi, kati.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hitobang tah hin na ka tongun, mi akeh khatnin jingkah khovah lhah-a pat nilhah jan ahsi sophat geijin tengcha akidopmun ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiche bangma hin chepettah hin mipi jah-a chun, jana eingah dingule suna natonga pang ding koihileh alhacha hotoh Jerusalem'a gehsoh keijuhen tin kaseije.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hitichun keima jong, kasopite hojong, kasottol houjong, kanungjuija eingah uva pangho kisilpet tailouvin koimachan kavonnu sop dingin jong kasutlha pouvin ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chule mipi holeh ajiteu chu asopihou Judah te douna-in nasatah-in akapmun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajeh chu amaho abang khatnin, keiho kachapa teoleh kachanu teotoh tampi kahiuvin hijeh chun kaneh uva kahintheina dingun anneh kilah unge atiuvin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abang khatnin kel jeh-in keihon kalou mun jouseu, kalengpilei jouseu le ka-inu neh chohna din katungjou taove, atiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abangkhat kitnin, keihon kalou munnu kalengpileiju lengpa kai pehdin sum pa lahnan katungdoh soh taove atiuvin, ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuchanin katahsao hi kasopihou tahsavou bang ahin, kachateu jong amaho chate tobang ahiuve. Chule ven, kachapateu hi sohchanga um gamdingu ahitai. Kachanuteu phabep jong sohchanga um ahitaovin, huhdohna je kaheta pouve, ajehchu kagam houleh lengpilei ho midang achang taove, atiuvin ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin hicheng thuho kajah-a, akao-aw kajahtah-in, keima kalung ahangbehseh jengtan,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichun keiman kalung kanageltoh masan, milen milal tele vaihoma pangho chu kahousen, nangho amitakipmin nasopi hou batman apung nakilahcheh uve, kati, chule amaho thu gelkhom dingin mi tamtah kakoukhomin ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuin keiman ajah uva Pathen hephalou lah-a kijohdohsa isopihou chu ijochanun ilhatdoh-un, nanghon nasopi hou Judah te chu joh nagotjingu ham? eihole eiho lah-a jong ikijoh dingu ham? katin, chutah-in adailhahel taovin, donbut nading ahetapouve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kasei kitnin, nathilbolu hi aphahih beh-e, imelmateu Pathen helouhon eihouset jeh uva Pathen kicha jinga naum dingu hilouham? kati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hitobang chun keimale kasopite chule kalhachaho jong sum chule changle mim kana palahsah jiuve, Kangeh nahiuve, apung uma palah sahhi haitaohite.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kangeh nahiuve, tuni tah hin, alouhou alengpilei hou, a olive honhou, a-inhou, chujongle hop jakhat chunga hopkhat nalahjiu sum hihen, chang hihen, lengpitwi hihen chule thao hijongle lepehsoh kitnun, katin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin amahon, keihon lepehkit nunge, chule amaho-a konin imacha ngehpou vinge, hitichun nasei bangtah-in boluvinge, atiuve. Chujouvin, keiman thempuho kakouvin, thutep bangtah-a abolsohkei nadiuvin kaki hahsel sahtai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chujongle kaponchol chen chu kathingin, hitin kati, hiche thutep banga molsolou jouse chu Pathen'in ama insung le anatoh na-a konin hitobang hin thinglha hen, chule agoh keuseh-in umuhen, chuin mipi kikhomho jouse chun, atisoh keijun, Pakai avahchoi taove. Chule mipi ho chun hiche kitepna banghin aboltauve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiche kalval hin amaho chungle Judah ho chunga gam vaipodia eikipansah-a pat leng Artaxerxes kum somni alengchan kum-a pat kum somthumle kumni alengchan gei; hichu kum somle kumni sunga hin, keile kasopi hon gamvaipo anneh chu kanepouve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahin, keima masanga gamvaipoa anapangho chun mipi hodinga pohgih tampi anapeuvin, dangka shekel somli simtha louvin changlhah le lengpitwi analahpeh jiuvin, ahi. Alhachaho jengin jong mipi chunga vai ahomun, ahinla kenvang, ka Pathen kakichat jeh-in hitobanghin kabolpoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahi, hiche kulbang bolna-a hi kapan jing ahin, gam himhim kachopouve, kalhachate jouse jong natongin aumkhom jingun ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiche chungchonin, ikimvel uva namtina konle Pathen helouhole ahung kikhom khomho simlouvin, Judah teleh vaihomlete lah-a keima dokhanga an ananejing mi jakhat le somnga aumjinguve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nikhat sunga kei nehdinga kigong chu bongchal khatleh deilhencheh kelngoi gup, chule ahcha hojong keidingin asemun, nisom alhinsehle lengpitwi akimin akhol khomun, hichan geihin eikigonpeh jongle mipi ho asohchannao anasatjeh-in, keiman gam vaipo kahina-a, kipe changlhah chu kanejipoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka Pathen hiche mite dinga kathilbol jouse dungjui hin, nangin keima phatnading neigelpeh jingin.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun ahung hitin ahi, Sanballat le Tobiah le Arab mi Geshem chule kamelmaho adangsen bang kisahdoh le aphalou akidalha abeitai ti ajah phatnun, (kotpi kotho kabuto loulai vangin,)
  </para>
  <para style="p">
    <verse number="2" style="v" />Sanballat le Geshem'in, hungin lang Ono phaicham khoho khatna kimutou hite, tin thu ahinthot lhonin ahi. Ahinla amahon kachunga engkhanna thilphalou abol gotnu ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin keiman ahenguva thupole ho kasolin, na loupitah katoh jeh-in kahungsuh theipoi. Kahungsuh-a kadalhah kah-a, natoh ibola tangding ham? katin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahinla hitobang hin mi liveijen ahinsolun, keiman kadonbut ngaiman kadonbut jin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuphatnin chutobangma chun angavei channa-in, Sanballat'in kahenga lekhathot kihongsa khat asohpa ahinchoi sah-in,
  </para>
  <para style="p">
    <verse number="6" style="v" />Asunga chun hiti hin akisune: Pathen heloulaiho henga akiseijin, Geshem injong aseijin ahi, hichu nangle Judah ten kiphin nagotnu ahi. Hiche dinga chu kulpi bang hi nasem phatnu ahi, akisei dungjuija nangma amaho leng nahi theina dinga ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Judah gama lengkhat aume tia nathu phong jalle ding themgao tamtah Jerusalem'a napansah tai. Chule tun hiche thuho dungjui jahi lengpa henga thu alhut dingu ahitai. Hijeh chun, tun hungin lang kihou khomu hite, ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chuphatnin keiman thu kathotnin, nasei banga thil kibol khatcha aumpoi, nangma lungchama nasemthu ahibouve, kati.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ajehchu amaho jousen eikichatjeh uva, kanatoh-u pilhin louna dinga kakhutnu hatmosah ding eitiu ahi. Hijeh chun tun vo, Pathen kakhutnu hatsah in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche jouhin Mehetabeel cha Delaiah chapa Shemaiah henga kachen, ama a-in'a kot kikha khum ahin, chule aman aseije, Pathen'in a-houin sungeija kimuto hitin, houin kotkhah ho ikhadiu ahi, ajehchu nangma thatdinga hungding ahiuve; henge, janteng nangma thatdinga hungdiu ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuin keiman hitin kati, kei tobang mikhat chu jam intem? keitobanga ahinna huhdoh go-a houin sunga lutding koi umam? lut louhel ding kahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule ven, ama Pathen sol ahipoi ti kahethemtai. Hiche gaothuhi keima douna-a asei ahi, ajehchu Tobiah le Sanballat'in athalah lhon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hijeh-a chu keima katijatna, ati bangu kabola, chule thil engkhanna nei ahi tia eisuhminset nuva, eihouset theina dinguva, athalah-u ahibouve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka Pathen, Tobiah le Sanballat hi, anatoh dungjui cheh leh Naodiah themgaonu, chule themgao dang dangho kichatsah eigohohi hetpeh jingin.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nisomnga le nini lutnin Elul lha nisomni le ninga lhinin kulbang chu jo ahitai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuin ahitin ahi, Pathen helouho leh kamelma teovin, nakitong jouse amutah un, amaho alungthoi lheh-un, hiche nakitonghi Pathen natoh ngei ahi ti ahetauve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chukalvalin hiche laichun Judah milen milal hon Tobiah chu lekha tamtah athotnuvin, chujongle Tobiah lekhathot jong amujiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ajehchu Judah mitamtah ama koma kihahselji ahiuvin, ajehchu amachu Arah chapa Sehchaniah tupa ahin, achapa Johanan chun Berechiah chapa Meshullam chanu ji-a anei ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima jahdin anatohphat aseijiuvin chule kathuseiho jong ama koma alhutjiuve. Chule Tobiah hin kei kichatsah nadinga lekha ahinthotji ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun ahitin ahi, kulbangho kasemuva kotkhah ho katundoh uva, kotngah ho, lasa loile Levi ho kapansah jouvun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasopi Hanani leh leng ina vaihom Hananiah, amani hi Jerusalem vaipo din kathupeh-in, amahi mi kitah tahsan umtah ahin, chule midang sanga Pathen ging ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule ajah uvah, Jerusalem kotpihi nisa asatdoh kahsen kihonda henlang, kotngah ho dinpetin, kotjouse khah-u henlang, kamsoh keijuhen, chule kotngah-a pangdin Jerusalem'a chengho lhengdoh unlang, ama ama ngana munchehle, ama ama injoncheh akingadiu ahi, kati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tun khopi chu alenin, chule ajaolheh-in, ahin amihem alhom nalaijin chule inho jong sahjou loulai ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin ka Pathen'in kalung gila milen milal ho, vaihomho chule mipi ho kou khomsoh keija, aphungkhai khaija aminu simdin kalunggil ahetsah-in ahi. Chule anachetou masaho phung kaija minbu sutna chu kamudoh-in, hia chun hitia kisunhi kamun, ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hitehohi agamsung chate chu ahiuve amaho gal hinga kikaina mun'a kona hungkitol tou ahiuvin, Babylon lengpa Nebuchadnezzar chun anatolmanga, Jerusalemle Judah a hungkile kitnuva, ama khopi cheh ahinkijot kitnu, ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaho chu Zerubbabel toh hungkhom; Jeshua, Nehemiah, Azariah, Raamiah, Nahamani, Mordecai, Bilshan, Mispereth, Bigvai, Nehum, Baanah ahiuve. Israel mipi lah-a amijatmong chu hichehi ahi, kati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Parosh chate sangni le jakhat le somsagi le ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shephatiah chate jathum le somsagi le ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Arah chate jagup le somnga le ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jeshua le Joab sonho Pahath-moab chate sangni le jaget le somleget ahiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Elam chate sangkhat le jani le somnga le li.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zattu chate jaget le somli le nga.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zaccai chate jasagi le somgup.
  </para>
  <para style="p">
    <verse number="15" style="v" />Binnui chate jagup le somlileget.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bebai chate jagup le somni le get.
  </para>
  <para style="p">
    <verse number="17" style="v" />Azgad chate sangni le jathum le somnileni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Adonikam chate jagup le somgup le sagi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bigvai chate sangni le somgup le sagi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adin chate jagup le somnga le nga.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ater, Hezekiah tia jong kikou, chate somko le get.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hashum chate jathum le somni le get.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bezai chate jathum le somnileli.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hariph chate jakhat le somleni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gibeon chate somko le nga.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bethlehem le Netophah mi jakhat le somget le get.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anathoth'a mi jakhat le somni le get.
  </para>
  <para style="p">
    <verse number="28" style="v" />Beth-azmaveth'a mi somlileni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kirjath-jearim, Chephirahle Beeroth mi jasagi le somli le thum.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ramah le Geba a mi jagup le somni le khat.
  </para>
  <para style="p">
    <verse number="31" style="v" />Michmas mi jakhat le somnileni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bethel le Ai'a mi jakhat le somni le thum.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nebo khatjopa'a mi somnga le ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Elam chomkhat chate sangkhat le jani le somnga le li.
  </para>
  <para style="p">
    <verse number="35" style="v" />Harim chate jathum le somni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jericho chate jathum le somli le nga.
  </para>
  <para style="p">
    <verse number="37" style="v" />Lod, Hadid le Ono chate jasagi le somni le khat.
  </para>
  <para style="p">
    <verse number="38" style="v" />Senaah chate sangthum le jako le somthum.
  </para>
  <para style="p">
    <verse number="39" style="v" />Thempuho: Jeshua insung kon Jedaiah chate jako le somsagi le thum.
  </para>
  <para style="p">
    <verse number="40" style="v" />Immer chate sangkhat le somnga le ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Pashhur chate sangkhat le jani le somli le sagi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Harim chate sangkhat le somlesagi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Levi ho: Hodevah chate akon Jeshua le Kadmiel chate somsagi le li.
  </para>
  <para style="p">
    <verse number="44" style="v" />La saho: Asaph chate jakhat le somlileget.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kotngah ho: Shallum chate, Ater chate, Telex Talmon chate, Akkub chate, Hatita chate, Shobai chate jakhat le somthum le get.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nethinim ho: Ziha chate, Hashupha chate, Tabbaoth chate.
  </para>
  <para style="p">
    <verse number="47" style="v" />Keros chate, Sia chate, Padon chate.
  </para>
  <para style="p">
    <verse number="48" style="v" />Lebanah chate, Hagaba chate, Shalmai chate.
  </para>
  <para style="p">
    <verse number="49" style="v" />Hanan chate, Giddel chate, Gahar chate.
  </para>
  <para style="p">
    <verse number="50" style="v" />Reaiah chate, Rezin chate, Nekoda chate.
  </para>
  <para style="p">
    <verse number="51" style="v" />Gazzam chate, Uzza chate, Phaseah chate.
  </para>
  <para style="p">
    <verse number="52" style="v" />Besai chate, Meunim chate, Nephushesim chate.
  </para>
  <para style="p">
    <verse number="53" style="v" />Bakbuk chate, Hakupha chate, Harhur chate.
  </para>
  <para style="p">
    <verse number="54" style="v" />Bazlith, Mahida chate, Harsha chate.
  </para>
  <para style="p">
    <verse number="55" style="v" />Barkos chate, Sisera chate, Thamah chate.
  </para>
  <para style="p">
    <verse number="56" style="v" />Neziah chate, Hatipha chate.
  </para>
  <para style="p">
    <verse number="57" style="v" />Solomon soh ho chate sotai chate. Sophereth chate, Perida chate.
  </para>
  <para style="p">
    <verse number="58" style="v" />Jaala chate, Darkon chate, Giddel chate.
  </para>
  <para style="p">
    <verse number="59" style="v" />Shephatiah chate, Hattil chate, Zebaim mi Pochereth chate, Amon chate ahiuve.
  </para>
  <para style="p">
    <verse number="60" style="v" />Nethinim jouse toh Solomon soh ho chilhah chu jathum le somko le ni ahiuve.
  </para>
  <para style="p">
    <verse number="61" style="v" />Chule Temalah, Talharesha, Cherub, Addon le Immera kona hungtou hochu hichehohi ahiuve, ahinla apu apa sonholah-a achilhah ho chu Israel mi ahiule ahilouvu chu asutthei tapouve.
  </para>
  <para style="p">
    <verse number="62" style="v" />Delaiah chate, Tobiah chate, Nekoda chate sechu jaguple somlileni ahiuve.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chule thempuho lah-a, Habaiah chate Barxillai chate Gilead mi Barzillai chanute lah-a khat akichenpia, aminu dungjuija kisah ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Mi hichenghin phungmin kisutna lah-a, aminu aholun, ahinla amujou tapouve. Akisuhboh jeh-un, a thempu hinaova konin akihaisahtaove.
  </para>
  <para style="p">
    <verse number="65" style="v" />Chule Tirshatha'in amaho jah-a, thempu chun Urim le Thummim akibeha adin kahse-a, thiltheng chungnung chu anehthei loudiu ahi, ati.
  </para>
  <para style="p">
    <verse number="66" style="v" />Mipi kikhomho jouse chu abonchauvin, sangsomli le sangni le jathum le somgup ahiuve.
  </para>
  <para style="p">
    <verse number="67" style="v" />Asohho numei le Pasal sangsagi le jathum le somthum le sagi simtha louvin la saloi numei le Pasal jani le somli le nga ahiuvin,
  </para>
  <para style="p">
    <verse number="68" style="v" />A sakol houchu ja sagi le somthum le gup, sanganho chu jani le somli le nga ahiuve.
  </para>
  <para style="p">
    <verse number="69" style="v" />A sangongsao vuchu jali le somthum le nga ahi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Chule Pa te lah-a lamkai phabepmin natohna dingin atoh doh un ahi. Tirshatha gam vaipopan sana tena sangkhat, twikong somnga, thempu von janga le somthum, sumkhol na-a atohdohe.
  </para>
  <para style="p">
    <verse number="71" style="v" />Chule insung luboh mi phabep honjong sumkhol na-a din sana tena sangsomni chule dangka tena sangni le jani atohdoh-un, ahi.
  </para>
  <para style="p">
    <verse number="72" style="v" />Chule midang jousen apeh uchu sana tena sangsomni le dangka tena sangni, chule thempu von somgup le sagi ahi.
  </para>
  <para style="p">
    <verse number="73" style="v" />Hitihin thempuho, Levi ho, kotngah ho, lasaho mi phabep le Nethinim ho, chule Israel jouse chu ama ama khopi cheh-a achengcheh un, ahi. Lhasagi ahunglhin phatnin Israel chate chu akhopicheh uvah aumtaove.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chuin mipi jouse chu mihem khat bang jengin twikul kotpi masang lamlena chun akikhom khommun, chule amahon Pakaiyin Israelte dan thupeh Mosi dan lekhabu chu hinpodoh dingin, lekhasunpa Ezra henga aseitaove.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin thempu Ezra chun, anumei apasal houkhom ho henga leh ahekhen themthei ho jah ding chun, amasanguva lhasagi na, ani masa nin danthupeh chu ahinpodoh tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chuin aman twi kotpi phunga um khopi lamlen masanga chun numei pasal leh ahethei dingdol jouse masanga chun jingkah-a pat nin sunkim geijin asimdoh peh in: chule dan thupeh chu mijousen anakhang uva lunglut tah-in angaisoh keijun, ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin danthusun Ezra chu thuseina dinga lhongpeh kidosang chunga chun adingin, akoma chun Mattithiah, Shema, Anaiah, Uriah, Hilkiah le Maaseiah adinguvin; chule ajet le veija chun Pedaiah, Mishael, Malchijah, Hashum, Hashbaddanah, Zekeriah, le Meshullam adinguvin ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Ezra'in mipi jouse mitmun lekhabu chu aphongin; (ajeh chu mipi jouse chungvuma dinga ahin) chuin aphohdoh phatnin mipi jouse chu adingun:
  </para>
  <para style="p">
    <verse number="6" style="v" />Chuin Ezra'in Pakai Pathen len chu athangvah-in ahi. Chuin mipi jousen adonbut un; “Amen, Amen” tin akhut hou adomsangun: chule alu akunsah-un, amaiju tolla asulut nun Pakai chu ahou taovin, ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule Jeshua, Bani, Sherebiah, Jamin, Akkub, Shabbethai, Hodiah, Maaseiah, Kelita, Azariah, Jozabad, Hanan, Pelaiah, le Levi hojong chun mipi hochu danthu peh ahetchet sah-un: chule mipi hochu adinnau munna chun ading jingun ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hitichun amahon Pathen dan thupeh lekhabu chu kichentah-in asimun, chule athuchu ahilchet peh in, asimdoh hochu ahetkhenthem sah-un ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin Tirshatha Nehemiah le dan thusun thempu Ezra, chule mipi hille-a pang Levi hochun, mipi jouse henga chun; tuni nikho hi Pakai na Pathen dinguva nikho theng ahin, lunghem hih-un, kapjong kap hih-un, atiuvin ahi, Ajeh chu amahon danthupeh thu cheng hochu ajah phatnuva mipi jouse chu kapma ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin aman ahenguva, cheovin lang, athao thao neuvin lang, alhum lhum donun: imacha kigon louho dingin chan thotpeh-un: ajeh chu tunihi i-Pakai dinguva nikho theng ahin, lung jong lungdong hih-un; ajeh chu Pakai kipana chu na thahat nau ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hitichun Levi hochun mipi hochu athipsah-un, tunihi nikho theng ahin, chule lungjong lungkham hih un, atiuve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuin ahenguva kiphongdoh thuho chu ahetcheh tah jeh-un, aneh dingle adonding chule chanho thotdoh dingle kipah tah-a umdingin akikhen dohtaove.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin ani ni lhinnin, Mipi jouse lah-a apateu insung luchang holeh Levi holeh thempu hochu, dan thusun Ezra henga; dan thupeh ho hetchet theina dingin akikhomun, ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule Pakaiyin Mosi anapeh, Israel chate chu lhasagi channa kut sunga lhambuh sunga chengdio ahi: tia dan thupeh lekhabua kisun chu amahon amuvin ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule hitia chu amahon akhopi jouseule Jerusalem khopi sunga alhangsap leuva, lhangvum lama potdoh unlang Olive thingbah ho, chah thing bah ho, lenmui bah ho, tumkao ho, chule lhambuh ho-a sem dinga akijih banga, aphonjal lediu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hitichun mipi hochu acheuvin, hitiho chu ahinpouvin; ama ama in chung dingle ahonsung dinghou, chule Pathen in hongsung ho-a, twi kotpi khopi lamlen; chule Ephraim kotpi khopi lamlen sunga lhambuh in akisemun, ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule gal hinga kikai hungkile kit mipi ho jouse chun, lhambuh ho akisonun, lhambuh ho noija chun atouvun Nun chapa Joshua nikholaija pat hiche nikho geija hi Israel chaten hitia hi anabolkhah loulaiju ahi. Hitichun kipa na lentah anaumin, ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chujongle ani anin ni masa ni-a pat achaini geijin, Pathen danthupeh lekhabu chu asimin ahi. Chule amahon nisagi kut abollun, chule aumdan dungjui jin, aniget nichu thupeh dungjuija kikhoppi theng nikho ahi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hiche lha nisomni le nili nin, Israel chaten khaopon akisilun, achunguva leivui akinuvin an ngollin kikhopna aneijun ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuin Israel chilhah phung chu gamdangmi ho lah-a konin, akisepdoh un adingun, chule achonset nau leh apu apateu khangitlouna jouseu aphongun, ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chule amaho aumnacheh uva ading doh-un, chuche nikho hopli-a hopkhat sung chun Pakai a-Pathen'u danthupeh lekhabu chu asimun; chule hopli-a hopkhat danga chun a-Pathen'u ahouvun ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Levi ho thuseina dinga kisepsang chunga chun Jeshua, Bani, Kadmiel, Shebaniah, Bunni, Sherebia, Bani le Chenani hohi adingun, awsangtah in Pakai a-Pathen'u asamun ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuin Levi ho, Jeshua, Kadmiel, Bani, Hashabnah, Sherebiah, Hodijah, Shebaniah le Pethahiah chun dingun lang na Pathen chu atonsotnin choi-anun, chule pachatna leh vahchoina tincheng chunga namin loupichamkim chu nunnom hen, atiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangma bou Pakai nahi, nangman van nasemin, vanle vanho ngeisunga umjouse, leisetle asunga aumjouse twipiho chule asunga umjouse, chu Nangin nachingtup'in, chule van janelin nahouvun, ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangin Abram chu Chaldea gam Ur kho-a kona nahinpuidoh-a, amindinga Abraham hinsah-a Pakai Pathen chu nangma nahin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule namasanga ama milungkitah ahina namudoh a, chule Kanaan mite, Hit mite, Ammor mite, Perizz mite, Jebus mite chule Girgas mite gam pehdinga amatoh thulhuna nanasem achilhahte kapeh ding ahi, natin chule nangin nathuho chu nasubu lhit jie, ajehchu nangma chondihtah nahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Egypt gama kapateu thohgimna namujingin, chule twipi sana akanao najahpeh-e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Pharaoh le asohte jouse le agamsung mihem jouse chunga melchihna le thil kidangho namusah-in ahi. Ajehchu amahon amaho dounan kiletsahtah -in thil anaboluve, ti nahedoh-in ahi. Hitichun tuni banghin min khat nana neije.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaho twikhanglen lailunga tolgoa achetheina dingun, nangin amasanguva twikhanglen chu nasukhenin, song twihat lah-a kiseplut bangin, abolgenthei hochu twithuh lah-a naseplutnin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chukal valin amaho achenau lampia vah pehdin, sunle meilhang khompin chule janleh meikong khompin amaho chu nanapuijin ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule Sinai lhang chunga konin jong nahung kumlhan, van'a konin amaho nakihoupin, amaho thutanlhah dihna dan dihtahho, tepnadan phaho le thupeh ho napen,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule nacholdo nitheng chu amaho nahetsah-in, chule nasoh Mosi khutna konin danho, tepna danho, danho, amaho thu napen ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chule agilkel tengule van'a konin changlhah napen, chule adangchah tengule songpi-a konin twi naputdoh sah-in, amaho pehdinga nana thutepna gama acheuva, agalo nadingun amaho nathutep-in ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahinla amaho leh kapateu chun kiletsah tah-in anabollun, alouchalun, nathupeh hochu angainom pouve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule thu amangnom pouvin, alah uva nathil kidang bolhojong anahsah pouvin, ahinla alouchalun akiphinun, asoh hinao mun'a kilekitdin gal lamkai ding akilhenun, ahivangin nangin ngaidam dinga kigosa jingpa Pathen milungset themle hepina-a dim, lunghang vahlou khotona-a dim nahin, amaho namoh dalhah ngaipon ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahi, amahon akilhajol bongnou lim anasemuvin, hichehi ahi, na Pathen'u, Egypt gama kona nahinpuidoh uva chu, atiuvin, chule lunghana nasatah-in naphin seuve;
  </para>
  <para style="p">
    <verse number="19" style="v" />Hijongle hepina dimset chun gamthipmah amaho nadalha pon, lampia sunle amaho puidingin meilhang khompin chule amaho salvah dingle achenao lampi hildingin janleh meikong khompin, nadalha jipon ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaho hil dingin nalhagao pha chu napen, na manna chu akam sunguva lutding na-itpon, chule adang chah naova amaho twi napen ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahi, gamthipma chun kum somli sung nanavah-in, hitichun imacha alhasam pouvin, asil le achenu achulpon, akeng houjong apompon, ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chukal valin lenggam holeh nampi hochu napen, gam ningkoi tina amaho nahom khennin, hitichun amahon Sihon gam Heshbon lenggam leh, Bashan lengpa Og gamchu alotauve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Achateu jongchu van'a ahsi jatnin napunsah-in, chule amahon alodinguva apateu henga nana tepsa gamsunga chun napuilut tan ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hitichun achateu chu alutnun gamchu alotaovin, chule nangman gamsunga chun Kanaan miho chu amaho masanga nasunemin, anop aninguva aboldiuvin alenghouleh chugama miho chu akhutnuvah napedoh tai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule amahon khopi det holeh leiset phaho chu alauvin, chule thilkeu dimset inhole, twikul kilaiho, lengpilei ho, Olive honho, theiphung tamtah jong alotaovin, ahi. Hitichun aneuvin, avasetnun, ahung thaovun, chule naphatna lentah achun akipah un, ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hijengjongle sei angaipouvin, nangma dounan akiphinun, chule nadan thupeh thuchu anung angatnun, nangma lama ahung kiheikit nadinguva, amaho douna-a nathu hettohsahna themgao hou chu athatnun, chule amahon nasatah-in aphinseuvin, ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hijehhin amaho sugenthei amelmateu khutna chun napedoh in, alungdon laijuva nangma nakou phatnu chun, van'a konin nanangai peh-in, chule namihepi nadimset chun amelmateuva konin ahuhdoh dingu nanapei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahin amaho akicholdo jouvun, amahon namasanga engkhan abolkit taovin, hijeh chun amelmateu khutna dingin nadalha jitan; hitichun amelma teovin, achunguva vai ahomin, ahinla ahung kihei juva nangma nasap tenguleh, van'a konin nahin ngaijin, chule nami hepina dungjuijin amahochu vel tamtah na huhdohjin ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule nadan thupeh thua amaho nahinpui kit theina dingin, amaho dounan nahet tohsahjin ahi. Hijongle amaho kiletsah tah-in aumun, nathu peh ho angaipouvin, nathu tanlhah ho dounan achonseuvin, (min abola ahile, ama hina-a chu hingding ahi) chule alengkouvu ahih leuvin, angong avaiputnun chule angainom pouve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahinla kum tamtah amaho nanathoh ham hamin, chule na themgaoho mangchan nalhagaovin amaho dounan nana hettohsah jin ahi. Hijongle anakhangu asung pouvin, hijeh chun nangman gamsunga cheng miho khutna napedoh-in ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hijeng jongle nahepina lentah jalchun, amaho nasumang hel jipoi, notjong nanot thap pon, ajehchu nangma khotonale hepina-a dim Pathen nahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hijeh chun tun, ka Pathen, akitepna le akhotona chingjing, loupitahle thilbol thei chule tijat umtah Pathen, Assyria lengho phat laija pat tuni nikho geija, keihole kaleng teho, kapipui hou, kathempu hou, kathemgao hou, kapatehou chule nampite jouse chunga hahsatna hung lhung jousehi thilneo maimai jin anasandan.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ipi hitajongle kachunguva thil nalhunsah jousehin nadih-e, ajehchu nangman adih nabolin, keihovang giloutah-in kachon jiuve.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangma amaho douna-a nana photchen sahna dan thupeh, nathupeh ho leh nathu photchen sahna ho chu, kalenghou, kapipui hou, kathem puhou, kapu kapa tehouvin anitpouvin, ngaijong angainom pouve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ajehchu naphatna lentah chule amasanguva gam lentahle phatah amaho napehjing vangin, amahon aleng gamuva nangma naja nompouvin, a-engkhan bolnaova konin jong ahung kilehei pouvin ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Vetan, tun misoh kahitao vin, gamle asunga theiga le thilpha, kapu kapateu nehdinga nanapeh chu ven, chemunna chun keiho soh in kapangun ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kachonset jeh uva kachung uva leng dinga neisem peh houvinla gamga soh ho anetam valun, kati chungule kagancha teo chunga jong nopsahnan vai ahomun, chule keiho kahesoh behset taove.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule hitiho jouse jeh hin thulhun dettah kasemun, chule kasunun, kapipui hou, Levi ho, chule kathempu hou vin hichu namdet anam khumun ahi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun, Namdet kinamkhum hochu Nehemiah, Tirshatha, Hachaliah chapa chule Zidkiah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Seraihah, Azeriah, Jeremiah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pashhur, Amariah, Malchijah,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hattush, Shebaniah, Malluch,
  </para>
  <para style="p">
    <verse number="5" style="v" />Harim, Meremoth, Obadiah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Daniel, Ginnethon, Baruch,
  </para>
  <para style="p">
    <verse number="7" style="v" />Meshullam, Abijah, Mijamin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Maaziah, Beilgai, Shemaiah; hichenghi thempu ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Levi techu: Azariah chapa Jeshua, Henadad, Kadmiel chapa Binnui ahiuve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule asopiho Shebaniah, Hodijah, Kelita, Pelaiah, Hanan,
  </para>
  <para style="p">
    <verse number="11" style="v" />Micha, Rehob, Hashabiah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Zaccur, Sherebiah, Shebaniah,
  </para>
  <para style="p">
    <verse number="13" style="v" />Hodijah, Bani, Beninu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipi ho luchang Parosh, Pahath-moab, Elam, Zatthu, Bani,
  </para>
  <para style="p">
    <verse number="15" style="v" />Bunni, Azgad, Bebai,
  </para>
  <para style="p">
    <verse number="16" style="v" />Adonijah, Bigvai, Adin,
  </para>
  <para style="p">
    <verse number="17" style="v" />Ater, Hizkijah, Azzur,
  </para>
  <para style="p">
    <verse number="18" style="v" />Hodijah, Hashum, Bezai,
  </para>
  <para style="p">
    <verse number="19" style="v" />Hariph, Anathoth, Nebai,
  </para>
  <para style="p">
    <verse number="20" style="v" />Magpiash, Meshullam, Hezir,
  </para>
  <para style="p">
    <verse number="21" style="v" />Meshezabel, Zadok, Jaddua,
  </para>
  <para style="p">
    <verse number="22" style="v" />Pelatiah, Hanan, Anaiah,
  </para>
  <para style="p">
    <verse number="23" style="v" />Hoshea, Hananiah, Hashub,
  </para>
  <para style="p">
    <verse number="24" style="v" />Hallohesh, Pileha, Shobek,
  </para>
  <para style="p">
    <verse number="25" style="v" />Rehum, Hashabnah, Maaseiah,
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Ahijah, Hanan, Anan,
  </para>
  <para style="p">
    <verse number="27" style="v" />Malluch, Harim, Baanah, ahiuve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule mipi dangho chu thempuho, Levi ho, kotngah ho, la saho, Nethinim mitele Pathen dan thupehna gamsung miho a konle amahole amaho kisepkhena, ajiteu achateu le achanuteu, hetna neiho jouse chule hetkhenthem theina neiho jouse.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathen soh Mosi in apeh, I-Pakaiyu Pakai athutanlhah hole adan kisemho, bolla nitding chule Pathen danthu peh jouse-a chon dingin amaho asopite, amilen amilal teova abeh un, gaosapnale kihahsel na-a alutnun,
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule keihon chugama miho ding chun, kachanu tehou pepou vingting, kachapa teo jiding achanuteu jong lapouvinge.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule agamsung miten choldoni-a johding thil, ahiloule nehlechah johding hinpojongleu, keihon choldonin ahilouleh nithengnin amaho-a konin imacha chopouvinge, chule hia chun kum sagi lhinkumle achamlou louva bat kilaho chu kangaidam diu ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka Pathen ina natoh nadingin, sekel hopthum-a hopkhat kumseh-a peh dingin houdan khatjong kasemun,
  </para>
  <para style="p">
    <verse number="33" style="v" />Vetsahna changlhah, tantih neilou anneh thilto, tantih neilou govam thilto, choldoniho, lhathah ni, kutho bolnading, chule thiltheng ho-a dingin, Israelte dia longlhen kisempeh nadinga chonset thiltoho, chule ka Pathen in'a natoh naho-a dingin houdan thupeh hojong kakisemun, ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dan thupeh-a kisun dungjuijin, kumtina kitepsa phatho-a Pakai ka Pathen maicham chunga haldingin, kapateu insungho dungjuijin thing thilto ka Pathen insunga polut ding, thempuho le Levi ho chule mipi ho lah-a chun vang kasangun ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule kumseh-a kaleiset lhosoh-u ga masapenle thing jouse ga masapen Pakai in'a pohlutdin,
  </para>
  <para style="p">
    <verse number="36" style="v" />Chujongle dan thupeh-a kisun dungjuijin kachateu apengdoh masapen le gancha apeng masapen, chule gan honle kelngoihon apeng masapen hochu, ka Pathen houin'a lhacha natong thempu koma puicheh din,
  </para>
  <para style="p">
    <verse number="37" style="v" />Chule keihon gam ga masapen changbong, kathilpeh hou chule theiga jat namkim lengpitwi le, thao jat namkim thempuho komle ka Pathen indan sungnunga kapoh lutnuva, chule kagam gao hopsom-a hopkhat hochu Levi ho anga kapohlut uva, hiche Levi ho chun khopi jouse-a kalousoh uchu aneitheina dingu ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Levi ten somakhat alahding tengule, Aron chapa thempu chu Levi hotoh umkhom ding, chule Levi hon somakhat alah uva kona somakhat chu ka Pathen indan sunga thil kholkhom na-a ahinpohlut dingu ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ajehchu Israel chate le Lei chaten, changle lengpitwi le thao, thilpeh-a kipechu houin dansung munthenga manchah kikoina, alhachale thempuho, kotngah ho, lasaloi umna indan-a chu ahinpohlut dingu ahin, keiho ka Pathen in chu donlouva koilou ding kahiuve.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mipi vaihomho chu Jerusalem'a achengun, mipi adangho jongchun somakhat lah-a khat khopitheng Jerusalem'a chengding somkhat lah-a ko chu khopi danga chengdingin vang aveovin, ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chule mipin jong ama ama lung chama Jerusalem'a cheng dinga hungkipeho chu phatthei abohsoh keijun ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun hitehohi agamkai dola gamsung lamkai Jerusalem'a chengho chu ahiuve. Ahinla Judah gamsung khopiho-a chun, ama ama chanding dolcheh khopiho-a chun achengun, Israelte ahin, thempuho ahin, chule Levi te leh Nethinim ho le Solomon soh ho chate ahiuve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chuin Jerusalem'a chun Judah mileh Benjamin mi phabep achengun ahi. Judah chate lah-a chun Uzziah chapa Athaiah ahin, Zakariah chapa Amariah chapa Shephatiah chapa Perez chate lah-a Mahalalel ahiuvin;
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Baruch chapa Maaseiah Col-hozeh chapa, Hazaiah chapa Asaiah chapa Joiarib chapa Zekeriah chapa Shiloni chapa ahiuve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Perez chate Jerusalem khopi-a chengho jouse chu abonchauvin gal hangcheh jali le somgup le get ahiuve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chule amahohi Benjamin chapate ahiuvin, Meshullam chapa Sallu Joab chapa Pedaiah chapa, Kolaiah chapa, Maaseiah chapa, Ithiel chapa, Jesaiah chapa ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule ama nunga hin Gabbai, Sallai mi jakole somni leh get ahiuve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chule Zichri chapa Joel chu amaho vetup ahin; chule Senuah chapa Judah chu Jerusalem khopi chunga lamkai anina-a panga ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thempu hochu: Joiarib chapa Jedaiah, Jachin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hilkiah chapa Seraiah, Meshullam chapa, Zadok chapa Meraioth chapa, Ahitub chapa chu Pathen insunga vaihoma panga ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule asopite in'a natonga pangho chu mihem jagetle somnileni ahiuve; chule Jeroham chapa Adaiah, Pelaliah chapa, Amzi chapa, Zekeriah chapa, Pashhur chapa, Malchiah chapa,
  </para>
  <para style="p">
    <verse number="13" style="v" />Chule asopitele apateo lamkaiho chu mi jani leh somlileni ahiuvin: chule Azareel chapa Amashai, Ahasai chapa, Meshillemoth chapa, Immer chapa,
  </para>
  <para style="p">
    <verse number="14" style="v" />Chule asopiteu mihat mihangho chu jakhatle somni le get ahiuvin: chule milen khat chapa Zabdiel chu vaipole-a pang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Levi ho jong: Hashub chapa Shemaiah, Azrikam chapa, Hashabiah chapa, Bunni chapa ahiuvin;
  </para>
  <para style="p">
    <verse number="16" style="v" />Levi ho pipui Shabbethai le Jozabad chun Pathen in polama nakitong jouse chu avettuplhonin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chule Micha chapa Maataniah, Zabdi chapa, Asaph chapa chu vahchoi taona kin akibolteng alamkai pipenin apangin, asopite lah-a ni chana Bakkukiah, Shammua chapa Abda, Galal chapa, Jeduthun chapa ahiuve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khopi thenga Levi ho jouse chu jani leh somget le li ahiuve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chukal vallin kotpi ngahho, Akkub, Talmon le asopite kotho ngah-a chu mihem jakhatle somsagi le ni ahiuve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chule Israel amoh chengse le thempuho Levi ho chu Judah khopiho-a ama ama loding muncheh-a aumtaove.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahinla Nethinim ho chu Ophel'a achengun, chule Ziha le Gispa chu Nethinim mite chunga lamkai ahiuve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jerusalem khopi-a Levi ho vaipo-a pangpa jong chu Vani chapa Uzzi, Hashabiah chapa, Mattaniah chapa, Micha chapa, ahiuve. Asaph chapate lasaho chu Pathen insunga natong lamkai ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ajehchu amaho chungchanga lengpa thulhahna chu hichehi ahin, niseh-a lasaho dinga chan phabep umding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Judah chapa Zerah chate son lah-a Meshezabeel chapa Pethahiah chu mipi ho chungthu dola ijakaija lengpa thalhenga panga ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule khoholeh alouhou diuvin, Judah chate phabep chu Kirjath-arba le hiche khoho-a achengun, chule Dibon le asunga khohole, Jekabzeel le asunga khoho-a chun.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chule Jeshua le Moladah chule Beth-phelet,
  </para>
  <para style="p">
    <verse number="27" style="v" />Chule Hazar-shual, Beer-sheba le kho ho-achun,
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule Ziklag, Mekonah'a chule kho ho-a,
  </para>
  <para style="p">
    <verse number="29" style="v" />Chule En-rimmon le Zovah ah chule Jarmuth'a,
  </para>
  <para style="p">
    <verse number="30" style="v" />Nanoah, Adullam chule akho houva Lachish le aloumun houva, Azekah le khoho-a chun achengun ahi. Chuin amaho Beersheba apatnin Hinnom gamgeijin achengun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chule Benjamin chate jongchu Geba apat, Michmash a achengun chule Aija, Bethel chule akhohouva,
  </para>
  <para style="p">
    <verse number="32" style="v" />Chule Anathoth, Nob, Ananiah,
  </para>
  <para style="p">
    <verse number="33" style="v" />Hazor, Ramah, Gittaim,
  </para>
  <para style="p">
    <verse number="34" style="v" />Hadid, Zeboiim, Neballat,
  </para>
  <para style="p">
    <verse number="35" style="v" />Lod le Ona khut themho phaichama achenguve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Levi ho chu Judah le Benjamin gama ahomkhen taovin, ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tun hichehohi Shealtiel chapa Zerubbabel le Jeshua toh kilhona chetouva thempuho le Levi hochu ahiuvin, Seraiah, Jeremiah, Ezra.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amariah, Malluch, Hattush,
  </para>
  <para style="p">
    <verse number="3" style="v" />Shechaniah, Rehum, Meremoth,
  </para>
  <para style="p">
    <verse number="4" style="v" />Iddo, Ginnethoi, Abijah,
  </para>
  <para style="p">
    <verse number="5" style="v" />Miamin, Maadiah, Bilgah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Shemaiahle Jolarib, Jedaiah,
  </para>
  <para style="p">
    <verse number="7" style="v" />Sallu, Amok, Hilkiah, Jedaiah. Hichehohi Jeshua nikho laija thempuho leh asopiho lah-a lamkai pipen ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiche chungchon chun Levi ho, Jeshua, Binnui, Kadmiel, Sherebiah, Judah le Mattaniah hi amale asopiho thangvah na-a lamkaijin apangun, ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bakbukiah le Unni chule asopite jong chu amaho vetupmin apanguve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chule Jeshua'n Joiakim ahingin, Joiakim'in Eliashib ahinge, Chule Eliashib'in Joiada ahingin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Chule Joiada'n Jonathan ahingin, Jonathan'in Jaddua ahingin ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chule Joiakim nikho laija thempuho apateo luchangho chu: Seraiah, Meraiah; Jeremiah, Hananiah;
  </para>
  <para style="p">
    <verse number="13" style="v" />Ezra, Meshullam, Amarian, Jehohanan:
  </para>
  <para style="p">
    <verse number="14" style="v" />Melicut, Jonathan, Shebaniah te, Joseph,
  </para>
  <para style="p">
    <verse number="15" style="v" />Harim te, Adna; Meraioth, Helkai,
  </para>
  <para style="p">
    <verse number="16" style="v" />Iddo te, Zekeriah, Ginnethon, Meshullam,
  </para>
  <para style="p">
    <verse number="17" style="v" />Abiah, Zilchri, Miniamin, Moadiah, Piltai,
  </para>
  <para style="p">
    <verse number="18" style="v" />Bilgah te, Shammua, Shemaiah, Jehonathan,
  </para>
  <para style="p">
    <verse number="19" style="v" />chule Joiarib, Mattenai, Jedaiah, Uzzi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Sallai, Kallai, Amok te, Eber,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hilkiah, Hashabiah, Jedaiah, Nethaneel.
  </para>
  <para style="p">
    <verse number="22" style="v" />Eliashib, Joiada, Johanan chule Jaddua nikho laija Levi ho chu apateu pipuija ana kisunlut ahiuvin, Persia mi Darius in vaihom lah-a thempuho jong ahiuve.
  </para>
  <para style="p">
    <verse number="23" style="v" />Levi chapate le apateu pipuiho chu Eliashib chapa Johanan nikho geijin thusimbua akijihlutsoh keijin ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Levi ho lamkai pipuiho chu, Hashabiah, Sherebiah, chule Kadmiel chapa Jashua le asopihotoh, Pathen mipa David thulhahna dungjuija vahchoina le thangvahna pedingin aloiloijin akilhauve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mattaniah, Bakbukiah, Obadiah, Meshullam, Talmon, Akkub hohi kotbula thilkeu koikhom nahole kotpi ngaho ahiuve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hitehohi Jozadak chapa Jeshua chapa Joiakim nikho lai leh gam vaipo Nahemiah le Ezra thempu leh lekhasunpa nikholaija um anahiuve.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jerusalem kulbang thensona-a Jerusalem'a hung dingin Levi te chu kulbang chu kipahtah-a thenso ahina dingin selangdah, tumging, khutbeh, lasah le thuseidin aumnao munjouse-a konin aholdoh-un ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chule lasa themho chapate chu Jerusalem le akimvel phaicham Netophah mi khoho-a konin ahung khomun.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chujongle Gilgal ina konle, Geba le Azmavath gama konin ahung kikhomun ahi. Ajehchu lasa hochun Jerusalem kimvella chun khoho anatungdoh-un ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chule Thempuho le Levi ho chu akisuthengun, chule mipihole kotpiho chule akul bangho chu asuthengun ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chujouvin keiman Judah milenho chu kulbang chunga kapuidoh in, chule thangvahna pedingin loilentahtah nin kahom khenin, loikhat chu kulbang chunga ehkotpi jetlama chun acheuvin,
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaho nunga hin Hoshaiah le Judah pipuiho akehkhat jen akitolun ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chule Azariah, Ezra le Meshullam,
  </para>
  <para style="p">
    <verse number="34" style="v" />Judah, Benjamin, Shemaiah chule Jeremiah,
  </para>
  <para style="p">
    <verse number="35" style="v" />Chule sumkon choi thempu chate loikhat aminu chu Jonathan chapa Zekeriah, Mattaniah chapa, Michaiah chapa, Zaccur chapa, Asaph chapa,
  </para>
  <para style="p">
    <verse number="36" style="v" />Chule Pathen mipa David tumging manchah chu asopiho Shemaiah, Azarel, Milalai, Gilalai, Maai, Nethanel, Judah, Hanani in akengun, chule lekhajihpa Ezra chu alamkaijin ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amaho jonna um twinah kotpi phungle, kulbang jottouna David insahlam solamsang twi kotpi geile David khopi kalbia chun akaltouvun ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chule loichom dang thangvahna peho chu, amaho jong chu acheuvin, keima anunguva kachen, chule mipi akehkhat chu meilhum insang khella pat kulbang satah gei, bang chunga chun acheuvin,
  </para>
  <para style="p">
    <verse number="39" style="v" />Chule Ephraim kotpi chunga kotpilen chungah, chule Hananeel insanglen Maah insanga pat kelngoi kotkhah geijin acheuvin, chuin amaho songkul kotpi-a chun adingdenun ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hitichun keimale Pathen ina thangvahna peho loini hole, kaum khompi vaihomho akehkhat chu kadingun,
  </para>
  <para style="p">
    <verse number="41" style="v" />Chule sumkon choija thempuho chu Eliakim, Maaseiah, Miniamin, Micaiah, Elioenai, Zekeriah, chule Hananiah,
  </para>
  <para style="p">
    <verse number="42" style="v" />Chule Maaseiah, Shemaiah, Eleazar, Uzzi, Jehohanan, Malchijah, Elam chule Ezer ahiuve. Chule la saho chun avaipopao Jezrahiah toh hatah-in asaove.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chujongle hicheni chun ganlhaina loupitah ho atoh un, akipah thanomun ahi. Ajehchu Pathen'in amaho chu kipana lentah in akipa sah-in ajite houle achateu hojong akipah thanom mun, hitichun Jerusalem kipana chu gamlatah in jong akijan ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chule hichepet laichun, loujaoho lah-a le khopiho-a danthupeh dungjuija thempuho le Levi ho chan ga masaho, thiltoho, hopsom ho thil kholna indan ho-a, kholkhom din mi phabep akipansah-e. Ajehchu thempuho leh Levi ho kinboljeh chun Judah akipah thanomin ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chule David le achapa Solomon thulhahna dungjuijin, a-Pathen dinguva natoh peh dandingle kisuh thengna dan chu lasaloile kotngah hon jong ajopmun ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ajehchu malai David le Asaph nikho laijin, lasaloi lamkaile Pathen vahchoina le pachatna lasa ana umin ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chule Zerubbabel le Nehemiah nikho laijin Israel jouse lasa holeh kotngah hochu niseh-in achan dolu ana pejiuvin ahi. Chule thiltheng hochu Levi hodin asuthengun, chule Levi hon hicheho chu Aaron chate dingin asuthengun ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiche nikho chun mipi hetdin Mosi lekhabu asimun, chule chuachun Ammon miteleh Moab mite chu Pathen houkhom ho lah-a a-itih-a pangthei loudiu ahi tia kisun asimdoh uve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ajehchu amahon Israel chate chu changlhah leh twisih-in analamto pouvin, ahinla amaho douna-a gaosapdin Balaam athalah-un ahijeng vangin ka Pathen'un gaosapna chu phattheina in aheidoh tai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun ahitin ahi, amahon danthupeh chu ajah phatnun, Israel te-a konin mipi choplopho jouse chu asepkhen taovin ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chule hiche masanghin, ka Pathen'u indan sungnung vetupjing, Eliaship thempupa chu Tobiah toh akithujop lhonin,
  </para>
  <para style="p">
    <verse number="5" style="v" />Chule Levi ho, lasaho chule kotngah ho peh dinga kithu lhahna thao, lengpitwi thah, mimle chang hopsom ho, um le bel, begole nehding thilpehho, chule thempuho dinga thiltoho, tumasanga anakoinau indan lentah chu amadin agonpeh-in ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahinla hiche phatlai hin keima Jerusalem'a kana umpoi. Babylon leng Artaxerxes kum somthumle kum ni alengchan kum-in lengpa henga kachen, chule ni ijat-ham jouvin lengpa-a konin phalna kamun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuin Jerusalem'a kahungin, chule Pathen in hongsung ho-a amadinga indan khat agonpeh-a, Eliashib min Tobiah'a dinga thildih lou abolchu kahechen tan ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chule hichun eisulungna behsetnin, hijeh chun keiman indan sunga konin Tobiah insang thilkeu jouse chu kapaidoh tan ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuin gihna thu kapen, amahon indan chu asutheng taove. Chule keiman hia chun Pathen in'a um le bel holeh anneh thiltoho chule bego chu kahinpolut kit tai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuin keiman Levi ho chandingdol hochu akipe pouve ti kahedohtan ahi. Hijeh chun Levi ho le lasaloi chu ama ama honlam cheh-a anajamtaovin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chujouvin keiman vaihomho chu kanelkalin, ipidinga Pathen in hi kimoh dalhahthip jingaham? chuin amaho chu kakou khomin, ama ama panmun cheh-a kapansah kit tai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chujouvin Judah jousen changle mim chule lengpitwi thah le thao hopsom chu thilkholna-a ahinpolut nun ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chuin keiman thilkholna ho chunga thilkhol ding kasemin, Shelemiah thempu, danthusun Zadok, Levi ho le Pedaiah, chule amaho bana chu Mattaniah chapa, Zaccur chapa Hanan ahi. Ajehchu amaho chu tahsan detna kisima, chule amaho natohna munchu asopiteu kihoppeh ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vo, ka Pathen hiche chungchanga hin neihe jingin, chule ka Pathen in'a dingle hiche tohmun ho-a dinga thilpha kanabol hochu noimang hih-in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichelai hin Judah gamsunga choldo nikho-a lengpiga achiluva, changphal ahinpoh uva, sangan apohsah-u, lengpitwi le lengpiga hihen, theichang ga hihen, pohgih tincheng apohsah uva, choldoni-a Jerusalem sunga ahinpoh lutjiu kamun ahi. Chuin hiche nikho-a nehle chah ajohjeh-un amaho dounan kaphoh sal-in, ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiche mun'a cheng Tyre mihojong chun, nga leh johthei thil namkim ahinpouvin, Judah le Jerusalem chate henga choldonin ahungjoh jiuvin ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chujouvin keiman Judah milen milal hochu kanelkalin, ajah uvah, ipidinga hitobang thilphalou nabol uva, choldoni hi asuhboh-u ham? kati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Napateu vin hitobanghi anaboluva, i Pathen'un hiche thilphalou jousehi eihole hiche khopi chunga analhunsah hilou? hijongle choldoni nasuhboh naova konin Israel chunga lunghanna nahin pohlutbe nalaijun ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chuin ahitin ahi, choldoni masanga Jerusalem kotpiho-a muthim ahungkipat jouseh le khachah-a, chule choldoni kichai kahse-a honlouna dingin gihna thu kapen ahi. Chule choldoni-a thilpoh kiti apohlut louna dingun kasohho phabep khat kotpiho-a kakoijin ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hitichun akivei holeh thil jatchom chom joh hochu khatveiham? nivei ham? Jerusalem polama chun ageh khovah dentauve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chujouvin, keiman amaho dounan kahettohsah-in, ajah uvah, ipidinga nanghohi kulbang vela geh nahiuvem? Hitobanga nabolkit ule, nachung uva khut kalhahding ahi, katipeh-e. Hichea patchun amahon choldonin ahungkit tapouve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chuin keiman Levi ho chu amaho akisuh thenguva, chule hunguva kotpiho chu anga uva, choldoni sutheng dingin thupeh kapen, ahi. O ka Pathen, hiche chungchanga jonghin neihejingin lang, nahepina lentah dungjuijin neihing hoijin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiche nikholai jong chun Judah mite chun, Ashdod mite, Ammon mite Moab miho ji-a aneiju kamun ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chule Judah te pao ahekhenthem pouvin, ahinla mipi ho pao dungjui cheh-in, achateu apaodoh tengule akeh khatnin Ashdod pao amangun, ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chule ken amaho chu kakinelpi, kasamsen, abang bangjong kadengin, asamu kabopeh-in, nachanu teochu achapa teodinga napehloudiu, ahiloule nachapateo dinga achanuteu napuipeh loudiu, nangho tah-in jong nabol loudiu ahi, tin Pathen'a kaki hahsel sah-in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel leng Solomon jongchu hiche thil ho-a hi anachonsea hilouham? Pathen'in Israelte chunga Leng din anapansah-in, ama tobanga Pathen'in angailut lengdang namtin vaipi lah-a anaum khapoi: Hitajeng jongleh namdang numei hon amajeng jong chonsetnan alhahsah-un ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gamchom numei ho kichenpia ka Pathen douna-a suhkhel dinga, hiche thil phalouho boldinga nathu-u kangai dingu ham?
  </para>
  <para style="p">
    <verse number="28" style="v" />Thempu chungnung Eliashib chapa Joiada chapate khat chu Horon mi Sanballat tupa ahin, hijeh chun keiman amahi keija konin kanomangtai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Vo, ka Pathen amahohi hejing temin, ajehchu amahon themputna kin chule thempu hina-a kitepna le Levi kitepna asubohtauve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hitichun keiman gamdang mite akonin amaho kasuthengin, thempuho leh Levi dinga anatoh ding dolcheh-u leh anatoh ding danu kagot peh-in ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Akitepsa phatho-a thing toh dingle, aga masapen peding kagot toh peh-in ahi. Vo ka Pathen aphalam thila dingin nelheng jingin.
  </para>
</usx>
