<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="3JN" style="id">3 John</book>
  <para style="h">3 John</para>
  <para style="toc1">3 John</para>
  <para style="toc2">3 John</para>
  <para style="mt">3 John</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Upa keiman thutah-a kangailut, kangai Gaius hengah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai, thildang jouse sangin, nalhagao akhantou banga nakhantouva chule nadam nadingin kataovin ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sopiteho ahunguva nanga um thutah ahung hettohsah-u chun nasatah-in kakipah-in ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kachate thutah-a achon thu kajah-a kakipa sanga chungnungjo kakipana dang aumpoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai, nangman sopiho le hetphahlou maljin chunga nabol jouse chu kitah tah-in nabolin ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amahon nangma ngailutna thudol chu houbung-ah ahetsah-un ahi. Nangman amaho chu akholjin naova Pathen'a doltah-a nanathah ji-a ahile, nabol phat lheh ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ijeh-inem itile amaho chidang namdang ho-a kona imacha kilah louva, ama min jala chu kalsongdoh ahiuve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hijeh-a chu thutah-a dinga kithopi ho ihi theina dinguva, hiteho tobang mi chu eihotah-in ilhunsah dingu thu ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keiman houbung henga kahin sutsa ahitai: ahinla alah uva piput ngailu-a Diotrephes chun kaseiju alapon ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiche jeh-a chu keima kahunga ahile, thu gilou tamtah kachunguva aseija eiseisetnao athilbol achonna chengse kageldohsah ding ahi: chua jong chu lunglhai loulaijin, sopiho chu amanla alhunsahpon, lhunsah dinga goho jong ajahdan, houbung'a konin anodoh jengin ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai, nangma vangin ase chu jom louvin, apha chu jomin. Apha bola chu Pathen'a kon ahi; ase bola vang chun Pathen amu loulai ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Demetrius chu mijousen aseiphan, thutah-a konin hettohsahna pha achangin, henge, keihon jong kahettohsah uvin; chule keiho hettohsah chu thutah ahi ti nangman nahei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangma henga hinsut ding thil tamtah kaneije, ahinla lekha twi le lekha mola hinsut ding kanompoi:
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahin chomkhat joule nangma kamua chule kimaito-a ikihoulim ding kakineme.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nachungah lungmon umhen. Golle paihon nasalamui. Golle paiho chu amin cheh phan salam'in.
  </para>
</usx>
